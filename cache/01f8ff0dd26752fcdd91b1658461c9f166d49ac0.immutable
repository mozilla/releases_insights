1326a0d23eabac5c7811bf4f8ab1", "299146082fda536dd49f3d8991ea7fc481bec2de", "69a5ddaab296ff5e64bff477cdcaf5050ff230e8", "e93a2ee116d4472535c1f0f3f091e0d9f5858dc2", "a7d7bb568183fbbdaf3a08cb09e949f93be896f1", "17db2d197af70e3e7bcf46dddaf5b1d22578d34d", "774fa0cf68ccf50e8da30f50e71714abdc4686b5"], "user": "nfay@mozilla.com"}, "45642": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2084340 - Enable cross document view transitions on Nightly, r=webidl,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335765\n", "files": ["dom/events/test/test_all_synthetic_events.html", "dom/tests/mochitest/general/test_interfaces.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "11a3d44f6a94ce1d8e8c2c3e486d9f6757b3a6bc", "git_parents": ["774fa0cf68ccf50e8da30f50e71714abdc4686b5"], "node": "547164150433248c44e083d319a62df935c74cb2", "parents": ["77b91418e2026a5efdb8c93913ce06dc4b9ae43a"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2084794 - Keep the content sink alive while render-blocking defers the start of layout, r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336132\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h"], "git_node": "eddb40c27959b7f27019c9c21732eb61a5bec448", "git_parents": ["11a3d44f6a94ce1d8e8c2c3e486d9f6757b3a6bc"], "node": "128f1e173e27b9954384820c524e904348e210f4", "parents": ["547164150433248c44e083d319a62df935c74cb2"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2084709 - Keep painting the previous document until the first frame of an inbound cross-document view transition has been composited, r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336133\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/shistory/nsSHistory.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/base/nsFrameLoaderOwner.cpp", "dom/base/nsFrameLoaderOwner.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/ContentChild.cpp", "dom/ipc/PBrowser.ipdl", "dom/ipc/PContent.ipdl", "dom/view-transitions/ViewTransition.cpp", "layout/base/PresShell.cpp", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h"], "git_node": "82f4dd8c423cb92c259c01833451baf33fff872e", "git_parents": ["eddb40c27959b7f27019c9c21732eb61a5bec448"], "node": "cdfc005736e2a377faa917af3ac2c26f6917e338", "parents": ["128f1e173e27b9954384820c524e904348e210f4"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085026 - Part 1. Apply bitrate changes to MediaCodec encoders in ffvpx. r=media-playback-reviewers,padenot\n\nmediacodecenc only read the bitrate when configuring the codec. Send a\nvideo-bitrate parameter update when the context's bit_rate changes, in\nthe same setParameters call as key frame requests. This merges\nmediacodec_force_key_frames.patch into\nmediacodec_encoder_parameters.patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336194\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/libavcodec/mediacodecenc.c", "media/ffvpx/mediacodec_encoder_parameters.patch", "media/ffvpx/mediacodec_force_key_frames.patch"], "git_node": "5641e71d9ef52e6a2a33b4860b3a50c97cbc2392", "git_parents": ["82f4dd8c423cb92c259c01833451baf33fff872e"], "node": "33511b324f327236268bc20dbaf8bba5141d25c3", "parents": ["cdfc005736e2a377faa917af3ac2c26f6917e338"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085026 - Part 2. Support changing the bitrate of FFmpeg MediaCodec encoders. r=media-playback-reviewers,padenot\n\nSetBitrate was unimplemented, so WebRTC on the NDK path stayed at its\nstart bitrate, and WebCodecs had to recreate the encoder to change it.\nThe Java path supports this via PARAMETER_KEY_VIDEO_BITRATE.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336195\n", "files": ["dom/media/platforms/ffmpeg/FFmpegDataEncoder.cpp", "dom/media/platforms/ffmpeg/FFmpegDataEncoder.h"], "git_node": "e2a4804bacc01124ee897771c49919835c0fb58a", "git_parents": ["5641e71d9ef52e6a2a33b4860b3a50c97cbc2392"], "node": "fcf9d3efcea88b6b2a35f55ded1d6f5080c2fbed", "parents": ["33511b324f327236268bc20dbaf8bba5141d25c3"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085026 - Part 3. Don't use MediaCodec encoders for SVC in the FFmpeg encoder. r=media-playback-reviewers,padenot\n\nSVC is configured through libvpx/libaom specific options, which ffvpx's\nmediacodecenc doesn't recognize, so they are dropped while we still tag\nthe output with temporal layer ids that aren't in the bitstream.\nmediacodecenc doesn't expose MediaCodec temporal layering, and even then\nper-frame layer ids are only available on Android 17+ for some encoders.\nThe Java AndroidEncoderModule already rejects SVC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336196\n", "files": ["dom/media/platforms/ffmpeg/FFmpegEncoderModule.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoEncoder.cpp"], "git_node": "d137cf4a425532adaa0ca9b1fa927fe92331e7e1", "git_parents": ["e2a4804bacc01124ee897771c49919835c0fb58a"], "node": "97e66b4fcf33d4db08f81e76211b2516b40f0b7e", "parents": ["fcf9d3efcea88b6b2a35f55ded1d6f5080c2fbed"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2084813 - Upgrade rust toolchain used to build toolchains to 1.95. r=firefox-build-system-reviewers,ahochheiden\n\nSome toolchains were using the same rustc as Firefox to use something\nnewer. They can now use the rust-toolchain one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336081\n", "files": ["taskcluster/kinds/toolchain/misc.yml", "taskcluster/kinds/toolchain/rust.yml", "taskcluster/kinds/toolchain/samply.yml"], "git_node": "b6548aabb54e67e5dfef7862b5c8d2fd5e0a1d95", "git_parents": ["d137cf4a425532adaa0ca9b1fa927fe92331e7e1"], "node": "6448984a23f797335bcf25e0cfbe666bdae51e7c", "parents": ["97e66b4fcf33d4db08f81e76211b2516b40f0b7e"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085189 - Give remote video decoders a process-wide TextureFactoryIdentifier. r=gfx-reviewers,lsalzman\n\nDecoders created while the GPU process is being recreated asked the\ncompositor for the identifier of a compositor used by their content\nprocess, which did not exist yet. Without an identifier, the decoder\nhad no video bridge, and could not decode at all if it needed one, e.g.\nfor video with alpha. Build the identifier from the state of the\nprocess instead, which does not depend on any particular widget.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336311\n", "files": ["dom/media/ipc/RemoteVideoDecoder.cpp", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/PVideoBridge.ipdl", "gfx/layers/ipc/VideoBridgeParent.cpp", "gfx/layers/ipc/VideoBridgeParent.h"], "git_node": "3ed2c1395615b658deba3492161bfe42902abefb", "git_parents": ["b6548aabb54e67e5dfef7862b5c8d2fd5e0a1d95"], "node": "1f3f1ca41dad7cb53f0623b5c31c72b51aa2b6b4", "parents": ["6448984a23f797335bcf25e0cfbe666bdae51e7c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1928469 - Part 1 - Support running individual crates with `./mach rusttests` r=nalexander,firefox-build-system-reviewers\n\nPreviously, `./mach rusttests` ran tests for all `RUST_TESTS` crates.\nNow, `./mach rusttests \u003ccrate1\u003e \u003ccrate2\u003e ...` can run tests for any\nsubset of crates. Which crates can be tested depends on the platform\nand build configuration, because whether or not they're in `RUST_TESTS`\nis conditional in `moz.build`.\n\nThe backend records the available crates in `rust-tests.json`, allowing\n`./mach rusttests` to reject unknown crate names. We then use\n`MOZ_RUST_TEST_SELECTION` to select what tests to run in `run_cargo`, so\n`./mach rusttests` can continue using the existing `rusttests` target,\nwhich builds the required `USE_LIBS` before running the tests.\n\nWhen running all of the `RUST_TESTS` crates, we also pass\n`RUST_TEST_FEATURES`, which has all the features for all the crates. The\nproblem is that when we run a subset of the crates, Cargo rejects any\nfeatures that don't belong to the subset or their direct dependencies, so we\nneed to narrow that set to just the features Cargo will accept. `gkrust` has no\ntests, but we keep it selected whenever a crate from its directory is, so\nthat Cargo still accepts `gkrust_features`. We only pass\n`mozilla-central-workspace-hack` when a selected crate declares it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331842\n", "files": ["docs/testing-rust-code/index.md", "python/mozbuild/mozbuild/action/run_cargo.py", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/build_commands.py", "python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/action/data/rust_test_selection/metadata.json", "python/mozbuild/mozbuild/test/action/test_run_cargo.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/test_rust_commands.py", "testing/mach_commands.py", "testing/test/python.toml", "testing/test/test_rusttests.py"], "git_node": "50c04275b191c2ea516a5bafcee4b3580ae4cc6b", "git_parents": ["3ed2c1395615b658deba3492161bfe42902abefb"], "node": "8d1106e17221d3ef952b841ff576fe534f3c290a", "parents": ["1f3f1ca41dad7cb53f0623b5c31c72b51aa2b6b4"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1928469 - Part 2 - Link the Windows Rust test binaries with `-FORCE:UNRESOLVED` r=nalexander,firefox-build-system-reviewers\n\nSome Rust crates call C++ functions from libxul or breakpad, which Rust test\nbinaries do not link. The tests never reach those calls, but unlike the Linux\nand macOS linkers, the Windows linker still requires the functions to exist,\nso `crash_helper_server`, `style`, `dom_fragmentdirectives`,\n`dom_speculationrules` and `lockstore_rs` could not run their tests on\nWindows. `-FORCE:UNRESOLVED` lets their test binaries link.\n\nA test that calls a missing function still fails, because it crashes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331843\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "toolkit/library/rust/moz.build"], "git_node": "c911755e2ab5ed257ea86c0016bf99b9307f52a7", "git_parents": ["50c04275b191c2ea516a5bafcee4b3580ae4cc6b"], "node": "be97081d1c25b71ef15a56d0c59940a280a0df95", "parents": ["8d1106e17221d3ef952b841ff576fe534f3c290a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084847 - FFmpegEncoderModule should advertise both software/hardware for H264/HEVC on Android. r=media-playback-reviewers,azebrowski\n\nPreviously, when hardware encoding was not enabled for H264/HEVC via\ngfxVars, we always advertised software support, regardless of whether\nMediaCodec reported a software encoder. Now software support is only\nadvertised if MediaCodec reports a software encoder, and hardware support\nis advertised separately. A device with only hardware encoders and\nhardware encoding disabled now reports no support, rather than claiming a\nsoftware encoder that doesn't exist.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336095\n", "files": ["dom/media/platforms/ffmpeg/FFmpegEncoderModule.cpp"], "git_node": "fceaea44bb92dc9b33901bb1d7cd158dcc990b57", "git_parents": ["c911755e2ab5ed257ea86c0016bf99b9307f52a7"], "node": "aa47a3f79279e5a3594df6f21e50d9431d595308", "parents": ["be97081d1c25b71ef15a56d0c59940a280a0df95"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Remove the executable bit from gfx/cairo/cairo/src/moz.build. r=gfx-reviewers,aosmond\n\nIt has been executable since bug 1394002, which looks accidental.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336370\n", "files": ["gfx/cairo/cairo/src/moz.build"], "git_node": "3542f149963c082317e76621ce31a7ab5249b8eb", "git_parents": ["fceaea44bb92dc9b33901bb1d7cd158dcc990b57"], "node": "6783bf6534eef9998427c2a014521836b32b05ed", "parents": ["aa47a3f79279e5a3594df6f21e50d9431d595308"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Remove cairo patches that are in upstream 1.18.6. r=gfx-reviewers,aosmond\n\nUpstream has these as-is:\n\n0021 https://gitlab.freedesktop.org/cairo/cairo/-/commit/ef42ed0ec8567f5b353f99cd03ea2275305ed06a\n0023 https://gitlab.freedesktop.org/cairo/cairo/-/commit/86ae4233bf40945b0640349ff3a9db6ffc172600\n0024 https://gitlab.freedesktop.org/cairo/cairo/-/commit/899e6a89f7efd34e190938a3822caa55f67c086e\n0025 https://gitlab.freedesktop.org/cairo/cairo/-/commit/d80b44afa46aa23b47331819b77d55ea5c59f570\n0037 https://gitlab.freedesktop.org/cairo/cairo/-/commit/b1bf71663dda5f3c90f2f017b665ed157b721e25\n0039 https://gitlab.freedesktop.org/cairo/cairo/-/commit/205785c8430df34aced5d9e14ffaa9278473a4ef\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336371\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0021-Fix-cairo-build-bustage-with-Windows-SDK-26100.patch", "gfx/cairo/patches/0023-Catch-potential-failure-during-add_polygon.patch", "gfx/cairo/patches/0024-Check-subroutine-offset-in-private-dict.patch", "gfx/cairo/patches/0025-Range-check-FDSelect-value-during-CFF-subsetting.patch", "gfx/cairo/patches/0037-type1-decode-integer.patch", "gfx/cairo/patches/0039-cff-fdselect-bounds.patch"], "git_node": "28484b782f4a59816cf0acb255ce2c83523aad3d", "git_parents": ["3542f149963c082317e76621ce31a7ab5249b8eb"], "node": "2d38c2c46e9ffe62cbb80d253a9b77e85855d0d0", "parents": ["6783bf6534eef9998427c2a014521836b32b05ed"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Remove cairo CFF offset check patches that are in upstream 1.18.6. r=gfx-reviewers,aosmond\n\nUpstream has 0034 and 0035 as-is:\n\n0034 https://gitlab.freedesktop.org/cairo/cairo/-/commit/055e92a867d8658449d8ccaea86fd2465b41cbef\n0035 https://gitlab.freedesktop.org/cairo/cairo/-/commit/24f40ad7b206919879c624ce9cde0cceb2fe43cc\n\nand later replaced 0035's size + offset check in cairo_cff_font_read_cid_fontdict\nwith one that checks for overflow:\n\nhttps://gitlab.freedesktop.org/cairo/cairo/-/commit/ccf06659b5160467a5891540eb5d82caed4946bf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336372\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0034-Bug-2037290-cff-subset-offset-checks.patch", "gfx/cairo/patches/0035-cff-dict-validation.patch"], "git_node": "57ced4cea8ba4fa4cbbc4f35b156bdf9e644343d", "git_parents": ["28484b782f4a59816cf0acb255ce2c83523aad3d"], "node": "7f982bd1b4cd90624b8eeffc097dd4e5c1b84deb", "parents": ["2d38c2c46e9ffe62cbb80d253a9b77e85855d0d0"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Remove cairo CFF dict operator bounds patch that is in upstream 1.18.6. r=gfx-reviewers,aosmond\n\nUpstream has the same fix, except that it keeps decode_operator and passes it the\nend pointer instead of inlining it:\n\nhttps://gitlab.freedesktop.org/cairo/cairo/-/commit/3eff4dcece11f9f243660e1d800083d876bcfabc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336373\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0036-cff-operator-bounds.patch"], "git_node": "9bce3d629f72c7259405cd82a93c10b018266de8", "git_parents": ["57ced4cea8ba4fa4cbbc4f35b156bdf9e644343d"], "node": "e9f3a6fd5a18c1d6d454e4482579a7e4c925c28a", "parents": ["7f982bd1b4cd90624b8eeffc097dd4e5c1b84deb"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Remove cairo FreeType glyph size overflow patch that upstream fixed differently in 1.18.6. r=gfx-reviewers,aosmond\n\nUpstream checks ftbit-\u003ewidth and ftbit-\u003erows before converting them to int, and\nuses _cairo_mul_size_t_overflow for pitch * height:\n\nhttps://gitlab.freedesktop.org/cairo/cairo/-/commit/842bd70cdfaf87d4e284685ecd5995622da38301\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336374\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0031-Bug-2029910-Cairo-avoid-overflow-rendering-FreeType-.patch"], "git_node": "e6706521aa4758b184d4002e9e68e11a2ff8d3ee", "git_parents": ["9bce3d629f72c7259405cd82a93c10b018266de8"], "node": "2c8ba61cf29337e03013b150b6073929e7ef458b", "parents": ["e9f3a6fd5a18c1d6d454e4482579a7e4c925c28a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Remove cairo patches that are in upstream 1.18.6 apart from a comment and whitespace. r=gfx-reviewers,aosmond\n\nUpstream took 0022 with a longer comment, and 0032 without the blank line:\n\n0022 https://gitlab.freedesktop.org/cairo/cairo/-/commit/503505666f9a322b23f1d53f9dafed0083c9eb7a\n0032 https://gitlab.freedesktop.org/cairo/cairo/-/commit/4af2d15cd5883aa10d92140a2ae11fa4bbee73f1\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336375\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0022-Invert-sign-of-delta-y-when-computing-glyph-advances.patch", "gfx/cairo/patches/0032-Bug-2033610-Check-cairo-image-surface-for-error.patch"], "git_node": "d9654ce3bbecccf2b123791a89336c3cdcf6f8d2", "git_parents": ["e6706521aa4758b184d4002e9e68e11a2ff8d3ee"], "node": "c2c73f7d43edc354f87a103de7e2249976d93c35", "parents": ["2c8ba61cf29337e03013b150b6073929e7ef458b"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Remove cairo __CRT_UUID_DECL guard patch. r=gfx-reviewers,aosmond\n\nUpstream added #ifdef __CRT_UUID_DECL guards to win32/d2d1-extra.h, then renamed\nit to win32/d2d1-extra.hpp:\n\nhttps://gitlab.freedesktop.org/cairo/cairo/-/commit/6ec91df76ee6bfe0a9b91c89ff19cbc140c782f4\nhttps://gitlab.freedesktop.org/cairo/cairo/-/commit/27411659d8ef69ba5b31ad3f5e14c98c8308369f\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336376\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0018-Add-ifdef-guards-around-mingw-specific-__CRT_UUID_DE.patch"], "git_node": "be3c3b2222206d18a5df1dd81138cb6eb1a750a0", "git_parents": ["d9654ce3bbecccf2b123791a89336c3cdcf6f8d2"], "node": "9ac75d7445565e93e5470acdc841fbe274f54cdc", "parents": ["c2c73f7d43edc354f87a103de7e2249976d93c35"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Reduce cairo dwrite component alpha patch to the part not in upstream 1.18.6. r=gfx-reviewers,aosmond\n\nUpstream stopped setting component alpha in init_glyph_surface_fallback_a8 and\nadded the missing breaks to the hint style switch, but\n_cairo_dwrite_scaled_font_init_glyph_surface still sets it:\n\nhttps://gitlab.freedesktop.org/cairo/cairo/-/commit/b1bc5a73f6da824c05bf9c81f05712989c5731f2\nhttps://gitlab.freedesktop.org/cairo/cairo/-/commit/ee554c8610cb1f89ce18f8635f7ccb4d610314b4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336377\n", "files": ["gfx/cairo/patches/0033-Bug-2036587-No-component-alpha-for-dwrite-glyph-surfaces.patch"], "git_node": "1ab539464485db8a2bbf45ca00b8c44ae6ad431b", "git_parents": ["be3c3b2222206d18a5df1dd81138cb6eb1a750a0"], "node": "a0e266a98fe17aa38eb0f3fe949bfc18cfe75400", "parents": ["9ac75d7445565e93e5470acdc841fbe274f54cdc"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Update context of cairo register keyword patch for 1.18.6. r=gfx-reviewers,aosmond\n\nUpstream changed the #if around __builtin_popcount to #if defined (__GNUC__),\nso the patch only applied with fuzz.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336378\n", "files": ["gfx/cairo/patches/0003-Avoid-register-keyword-for-C-compatibility.patch"], "git_node": "1e2b1b13404a9be1f19d4d673f0fb062d1562b7a", "git_parents": ["1ab539464485db8a2bbf45ca00b8c44ae6ad431b"], "node": "df1db326d7f77f2a993da99e1493cf03da28b6ce", "parents": ["a0e266a98fe17aa38eb0f3fe949bfc18cfe75400"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Keep cairo's Mozilla-only headers in the tree instead of creating them with a patch. r=gfx-reviewers,aosmond\n\nPatch 0029 created cairo-features.h, cairo-platform.h, cairo-rename.h, config.h\nand pixman-rename.h. Updatebot runs mach vendor with --patch-mode none and\napplies the patches afterwards, so at the point mach updates moz.build these\nfiles look deleted and it removes them from EXPORTS. Listing them under keep:\nleaves them in place.\n\nThat leaves 0029 with only its .gitignore change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336379\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0029-Add-configuration-files-needed-for-Firefox-s-mozbuil.patch", "gfx/cairo/patches/0029-Stop-ignoring-cairo-features.h.patch"], "git_node": "57dc963992aff527b76e554655394310862a580e", "git_parents": ["1e2b1b13404a9be1f19d4d673f0fb062d1562b7a"], "node": "3255265d0903a5c6607ee19dc98bfb46512a5ace", "parents": ["df1db326d7f77f2a993da99e1493cf03da28b6ce"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Detect IDWriteFactory8 from the SDK headers when building cairo. r=gfx-reviewers,aosmond\n\ncairo 1.18.6's win32/dwrite-extra.hpp declares IDWriteFactory8 and\nDWRITE_PAINT_FEATURE_LEVEL itself unless HAVE_IDWRITEFACTORY8 is defined.\nUpstream's Meson build defines HAVE_IDWRITEFACTORY8 after a compile test; we\ndon't have such a check. So with headers that already declare them (a new\nenough Windows SDK or mingw-w64), the build fails because of redefinitions.\n\nThe headers that declare them are Windows SDK 10.0.22621.2428 and later\n(behind NTDDI_WIN10_NI in 22621, NTDDI_WIN10_CU from 26100) and mingw-w64 13\nand later. They all define DWRITE_GLYPH_IMAGE_FORMATS_COLR_PAINT_TREE_DEFINED\nin dcommon.h along with them, and earlier versions define neither. 22621.755\nand 22621.2428 have identical NTDDI macros, so the marker is what tells them\napart.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336380\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0053-Detect-IDWriteFactory8-from-the-SDK-headers.patch"], "git_node": "37fcfe0a939763d28c4d1e6c0b41b879b3489c3d", "git_parents": ["57dc963992aff527b76e554655394310862a580e"], "node": "151a4db48ec6fe3c074ca2eebf55a3cf828dcad6", "parents": ["3255265d0903a5c6607ee19dc98bfb46512a5ace"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Update cairo to 1.18.6. r=gfx-reviewers,aosmond\n\n./mach vendor gfx/cairo/moz.yaml -r 1.18.6 --patch-mode none\n./mach vendor gfx/cairo/moz.yaml --patch-mode only --ignore-modified\n\nplus the version in gfx/cairo/README.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336381\n", "files": ["gfx/cairo/README", "gfx/cairo/cairo/NEWS", "gfx/cairo/cairo/README.md", "gfx/cairo/cairo/src/cairo-atomic-private.h", "gfx/cairo/cairo/src/cairo-cff-subset.c", "gfx/cairo/cairo/src/cairo-clip.c", "gfx/cairo/cairo/src/cairo-colr-glyph-render.c", "gfx/cairo/cairo/src/cairo-compiler-private.h", "gfx/cairo/cairo/src/cairo-default-context.c", "gfx/cairo/cairo/src/cairo-ft-font.c", "gfx/cairo/cairo/src/cairo-image-source.c", "gfx/cairo/cairo/src/cairo-matrix.c", "gfx/cairo/cairo/src/cairo-mutex-list-private.h", "gfx/cairo/cairo/src/cairo-pdf-surface.c", "gfx/cairo/cairo/src/cairo-recording-surface.c", "gfx/cairo/cairo/src/cairo-rectangle.c", "gfx/cairo/cairo/src/cairo-scaled-font-private.h", "gfx/cairo/cairo/src/cairo-scaled-font.c", "gfx/cairo/cairo/src/cairo-version.h", "gfx/cairo/cairo/src/cairo-xcb-connection-shm.c", "gfx/cairo/cairo/src/cairo.h", "gfx/cairo/cairo/src/cairoint.h", "gfx/cairo/cairo/src/moz.build", "gfx/cairo/cairo/src/win32/cairo-dwrite-font.cpp", "gfx/cairo/cairo/src/win32/cairo-dwrite-private.hpp", "gfx/cairo/cairo/src/win32/cairo-win32-font.c", "gfx/cairo/cairo/src/win32/cairo-win32-printing-surface.c", "gfx/cairo/cairo/src/win32/cairo-win32-private.h", "gfx/cairo/cairo/src/win32/cairo-win32-surface.c", "gfx/cairo/cairo/src/win32/cairo-win32-system.c", "gfx/cairo/cairo/src/win32/cairo-win32-thread-data.c", "gfx/cairo/cairo/src/win32/d2d1-extra.h", "gfx/cairo/cairo/src/win32/d2d1-extra.hpp", "gfx/cairo/cairo/src/win32/dw-extra.h", "gfx/cairo/cairo/src/win32/dwrite-extra.hpp", "gfx/cairo/moz.yaml"], "git_node": "04bfd26704a6ba49a6b003e374628725eaf099a2", "git_parents": ["37fcfe0a939763d28c4d1e6c0b41b879b3489c3d"], "node": "0866cc86e265fdd1c234dec45a74e6a61666e382", "parents": ["151a4db48ec6fe3c074ca2eebf55a3cf828dcad6"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2074827. Renumber cairo's local patches to close the gaps. r=gfx-reviewers,aosmond\n\nEarlier patches in this bug removed 13 of them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336382\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0018-Add-cairo_win32_surface-APIs-wanted-for-gecko.patch", "gfx/cairo/patches/0019-Add-cairo_win32_surface-APIs-wanted-for-gecko.patch",