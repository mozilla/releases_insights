-components/components/ui/tabcounter/src/main/res/values-brh/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-brh/strings.xml", "mobile/android/fenix/app/src/main/res/values-be/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-da/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rCA/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-eo/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rMX/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fa/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-hr/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-is/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-iw/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-ka/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-kmr/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pa-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ro/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-skr/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sq/strings.xml", "mobile/android/fenix/app/src/main/res/values-sr/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-th/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "1c0274319144b12b2ca248d8931a262b3413df75", "git_parents": ["64a0f13ed45a7d31d1d6e0e109d50170869531f5"], "node": "5ee19990d205c7ae8ca45119dc1a373feeecdaab", "parents": ["5e9db947677a5b3f7354e99540e594e13805e490"], "tags": []}, {"author": "Matt Cleinman \u003c9295855+mcleinman@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086176 - Update icon for inclusion rules - r=ip-protection-reviewers,rking\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337288\n", "files": ["browser/components/ipprotection/assets/vpn-website-rules-icon.svg", "browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_content_site_rules.js"], "git_node": "8946302f9d2a6683fcc99469302b1b8775e45a72", "git_parents": ["1c0274319144b12b2ca248d8931a262b3413df75"], "node": "072c8a1eeb5380f1e8a32c18b7ac5772395188ed", "parents": ["5ee19990d205c7ae8ca45119dc1a373feeecdaab"], "tags": []}, {"author": "ndokutovich \u003cndokutovich@gmail.com\u003e", "branch": "default", "desc": "Bug 2080608 - Restore tabs that reference an unknown tab group. r=sessionstore-reviewers,tabbrowser-reviewers,sthompson\n\ncreateTabsForSessionRestore() creates tabs with insertTab: false, so a tab is\ninserted only when it is appended to a DOM fragment. A tab whose groupId is not\npresent in the window's groups list skipped that append - the \"skip any group\nprocessing\" comment also skipped insertion - leaving the tab uninserted and\nwithout a position.\n\nSessionStore's #restoreTab() then threw \"Shouldn't be trying to restore a tab\nthat has no position\" on that tab, which aborted the restore of the entire\nwindow and silently dropped every remaining tab in it. Measured against 157.0.1\nwith a 40-tab state, one tab carrying an unresolvable groupId at index 35\nrestored 35 tabs; with the group defined, all 40 restored.\n\nAppend such a tab to the top-level fragment so it is restored ungrouped, and\nkeep a single bad tab from discarding the rest of the window.\n\n#restoreTab() marks the window busy before it touches the tab and clears that\nstate on its last line, so the check for a missing position now runs before the\nwindow is marked busy. Without that, a caller that swallows the error leaves the\nwindow busy forever and SSWindowStateReady is never dispatched for it. The\nselected tab, restored ahead of the loop, is guarded like the rest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332744\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_tab_groups_restore_unknown_group_id.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "64795d82be0b71a77a33629b0c17b3320b1d9cd2", "git_parents": ["8946302f9d2a6683fcc99469302b1b8775e45a72"], "node": "f44aa5eb3b72713ffcebb9893798bbe72b8e0beb", "parents": ["072c8a1eeb5380f1e8a32c18b7ac5772395188ed"], "tags": []}, {"author": "Francesco Lodolo \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 2086504 - Migrate process hang and unsigned add-ons notification strings from browser.properties to Fluent. r=firefox-desktop-core-reviewers ,fluent-reviewers,Gijs,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337497\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/chrome/browser/browser.properties", "browser/modules/ProcessHangMonitor.sys.mjs", "python/l10n/fluent_migrations/bug_2086504_process_hang_properties.py"], "git_node": "390be3cadddebdc7baf1c7e01195a3834fd6043b", "git_parents": ["64795d82be0b71a77a33629b0c17b3320b1d9cd2"], "node": "209a66c02675e50e60737d4c02ef9e87bfbd5a4c", "parents": ["f44aa5eb3b72713ffcebb9893798bbe72b8e0beb"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086229 - Add telemetry for security codes added, edited or cleared in Settings. r=mtigley,credential-management-reviewers\n\nAdd `formautofill.creditcards.cvv_manage_action`. `EditCreditCardDialog.handleSubmit()` records\nit after a successful save if `cc-csc` differs from the stored record: no old code -\u003e \"add\",\nno new code -\u003e \"clear\", otherwise \"edit\".\n\n`creditcard.edit_manage` fires on every save, so it can't tell us whether the security code changed.\n\nThe event is skipped if the code is unchanged, the dialog is cancelled, or the security code field\nis off. It records the action only, not the code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337643\n", "files": ["browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "toolkit/components/formautofill/metrics.yaml"], "git_node": "6595b4b0491e690cd65f03dba11ce49736cafd6a", "git_parents": ["390be3cadddebdc7baf1c7e01195a3834fd6043b"], "node": "82a71602680fff83fbbbd5f8b0f3ae199dfabb5f", "parents": ["209a66c02675e50e60737d4c02ef9e87bfbd5a4c"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086289 - Part 1: Move Ion's pre-barrier call out of line. r=spidermonkey-reviewers,jonco\n\nThe barrier is only needed while incremental marking is in progress. Emit just\nthe check inline and branch to an out-of-line call. This shrinks the inline code\nfrom 12 to 4 instructions on x64.\n\nThis moves `emitPreBarrier` from `CodeGeneratorShared` to `CodeGenerator` so that\nwe don't need explicit template instantiations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337330\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/CodeGenerator.h", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/CodeGenerator-shared.h"], "git_node": "50514837ced2286c3ecc75a77685e11f06ff7f43", "git_parents": ["6595b4b0491e690cd65f03dba11ce49736cafd6a"], "node": "8fa762f8fef3aa6ba5204d02f3c06d6988ee71a8", "parents": ["82a71602680fff83fbbbd5f8b0f3ae199dfabb5f"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086289 - Part 2: Support passing multiple addresses to emitPreBarrier. r=spidermonkey-reviewers,jonco\n\nThis lets us use a single branch for the Map iterator key and value barriers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337331\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/CodeGenerator.h"], "git_node": "3cfe158be50f3457562801f2b23c47c3dc66b740", "git_parents": ["50514837ced2286c3ecc75a77685e11f06ff7f43"], "node": "c4747d8e5d6cb9a9fa97d29c6c008a974542b990", "parents": ["8fa762f8fef3aa6ba5204d02f3c06d6988ee71a8"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086289 - Part 3: Use a single needs-barrier check for RegExpStatics pre-barriers. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337333\n", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": "420d51915b43095dc94c0661c8cb434755d52f9c", "git_parents": ["3cfe158be50f3457562801f2b23c47c3dc66b740"], "node": "389cc29ff3b691a048b5728522c018bcea5292c9", "parents": ["c4747d8e5d6cb9a9fa97d29c6c008a974542b990"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084454 - Add bounds-checking on mIndex in LoadEntry. r=dom-core-reviewers,vhilla\n\nThe fix for bug 1892551 unintentionally removed a bounds-check on\nmIndex when fetching the previous entry in nsSHistory::LoadEntry.\nThis reintroduces that check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336090\n", "files": ["docshell/shistory/nsSHistory.cpp"], "git_node": "e141c2475adca3e829fe8ecfa8616ff3d11aa00b", "git_parents": ["420d51915b43095dc94c0661c8cb434755d52f9c"], "node": "7e86859d736a26813405ca918322c6cd94fc9879", "parents": ["389cc29ff3b691a048b5728522c018bcea5292c9"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086634 - Update the card save and update doorhanger strings to the new design. r=credential-management-reviewers,fluent-reviewers,bolsson,kalenlu\n\nThe save doorhanger for a new card and the \"Save security code?\" doorhanger\nnow both use \"{ -brand-short-name } encrypts and autofills your payment\ndetails for faster checkout.\", so the\ncredit-card-save-payment-method-doorhanger-description-security-code and\ncredit-card-save-security-code-doorhanger-description strings are removed.\n\nThe update doorhanger header becomes \"Update saved payment method?\" under a\nnew ID.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337626\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "11041f7b6b28734c3ee2f631012ef48b6e2ed0c8", "git_parents": ["e141c2475adca3e829fe8ecfa8616ff3d11aa00b"], "node": "49ed7b677256208392a00637a7cc2abdf559f649", "parents": ["7e86859d736a26813405ca918322c6cd94fc9879"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086634 - Drop the hidden digits from the security code in the card doorhanger details. r=credential-management-reviewers,fluent-reviewers,bolsson,kalenlu\n\nThe card details on the card doorhangers name the security code without\n\"\u2022\u2022\u2022\", for example \"Name | 08/31 | CVV\".\n\nDepends on D337626\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337627\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "d8b477f149704a97182987d70e3e9ae2adb71d57", "git_parents": ["11041f7b6b28734c3ee2f631012ef48b6e2ed0c8"], "node": "e3b8d8e503f89e92c44c29761943408023d0422c", "parents": ["49ed7b677256208392a00637a7cc2abdf559f649"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086634 - Rename the update doorhanger's save new button to \"Save as new\". r=credential-management-reviewers,fluent-reviewers,bolsson,kalenlu\n\nThe button that saves the submitted details as a new card on the update\ndoorhanger now reads \"Save as new\", as in the design, under a new ID.\n\nDepends on D337627\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337647\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "a0d6d63816de5c7082f78663b68713df6bf92c40", "git_parents": ["d8b477f149704a97182987d70e3e9ae2adb71d57"], "node": "0ebf814369b0c4d3151a8b88eb1e00ca8a6f1060", "parents": ["e3b8d8e503f89e92c44c29761943408023d0422c"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086254 - Set cancel content JS Epoch only when BrowserChild exists r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337606\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "a274700a0da7cbe35f81703b8b81610ee5ebfcfc", "git_parents": ["a0d6d63816de5c7082f78663b68713df6bf92c40"], "node": "6882ac1818594124037f955ebb9210824c99f607", "parents": ["0ebf814369b0c4d3151a8b88eb1e00ca8a6f1060"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2086308 - Map aria \"alert\" to ATK_ROLE_NOTIFICATION. r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337673\n", "files": ["accessible/base/RoleMap.inc", "testing/web-platform/meta/core-aam/aamtests/role/alert.py.ini"], "git_node": "5102a388428c134a184f955874b8cfcc6574af27", "git_parents": ["a274700a0da7cbe35f81703b8b81610ee5ebfcfc"], "node": "4e33b7622dce8ba37f8a3db3d6dc712c1b20b3ee", "parents": ["6882ac1818594124037f955ebb9210824c99f607"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2086310 - Map aria \"alertdialog\" to ATK_ROLE_ALERT. r=accessibility-platform-reviewers,morgan\n\nWe have a similar check in mac to map to the correct subrole. This might\nwarrant a new gecko role, but that is rather disruptive so I just went\nwith this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337674\n", "files": ["accessible/atk/AccessibleWrap.cpp", "testing/web-platform/meta/core-aam/aamtests/role/alertdialog.py.ini"], "git_node": "24ff6e4bde8a98d6f004cf2688bf5ed59492ff11", "git_parents": ["5102a388428c134a184f955874b8cfcc6574af27"], "node": "778b4d2bc5252ea56745369e3e89547864b81b53", "parents": ["4e33b7622dce8ba37f8a3db3d6dc712c1b20b3ee"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2086311 - Map aria \"definition\" to ATK_ROLE_DESCRIPTION_VALUE. r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337675\n", "files": ["accessible/base/RoleMap.inc", "testing/web-platform/meta/core-aam/aamtests/role/definition.py.ini"], "git_node": "f6273dbcbaac5487815d1ada77c12e57324467b8", "git_parents": ["24ff6e4bde8a98d6f004cf2688bf5ed59492ff11"], "node": "6d8b601dccbfd7bd84438c4a03a2ac77face0702", "parents": ["778b4d2bc5252ea56745369e3e89547864b81b53"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2086614 - Map aria \"form\" with label to a FORM_LANDMARK\". r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337676\n", "files": ["accessible/basetypes/Accessible.cpp", "accessible/mac/mozAccessible.mm", "accessible/tests/browser/role/browser_roles_generic.js", "accessible/tests/mochitest/role/test_aria.html", "accessible/tests/mochitest/tree/test_aria_owns.html", "testing/web-platform/meta/core-aam/aamtests/role/form.py.ini", "testing/web-platform/tests/core-aam/aamtests/role/form.py"], "git_node": "aafadc4b45fe5b63eae443af49a7620dd09694bc", "git_parents": ["f6273dbcbaac5487815d1ada77c12e57324467b8"], "node": "8408f74261c0824255ccf412aa9912500db66a92", "parents": ["6d8b601dccbfd7bd84438c4a03a2ac77face0702"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2086631 - aria img/image accessibles should have ATK image interface. r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337677\n", "files": ["accessible/atk/AccessibleWrap.cpp", "testing/web-platform/meta/core-aam/aamtests/role/image.py.ini", "testing/web-platform/meta/core-aam/aamtests/role/img.py.ini"], "git_node": "336e177d4497abe3625fc3882af16a1879a02d6e", "git_parents": ["aafadc4b45fe5b63eae443af49a7620dd09694bc"], "node": "faead3b452dea5d4899ef092fd9aea11acd14fc0", "parents": ["8408f74261c0824255ccf412aa9912500db66a92"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2086639 - Map aria \"math\" role to ATK_ROLE_MATH. r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337678\n", "files": ["accessible/base/RoleMap.inc", "testing/web-platform/meta/core-aam/aamtests/role/math-role.py.ini"], "git_node": "edf31bb553f7acab82c28011a6f9f2cae011b4dc", "git_parents": ["336e177d4497abe3625fc3882af16a1879a02d6e"], "node": "f9915eaed60fb3d46f7c6f3f7084043216dda265", "parents": ["faead3b452dea5d4899ef092fd9aea11acd14fc0"], "tags": []}], "date": 1793246302, "git_changesets": ["0010b096c0518f93792894bcfb37908296c3f715", "1084f59d2f3026315c1ff1151efcf680301e24a8", "8e412b7465171031051fb9bfbc0713486b82e009", "5e250471de439386578aa581c86bdee49bc53aec", "cacfe6147f9b9a4a29e5b2e537fad7e34e0079d2", "a54ae4a3606abea098cb1c828320c73002273c8a", "56341d9f314fb7f9da634a7125f686f63c906086", "30a6895226ff00ce66d13219c48b82cf04a8c32a", "8c619f2f598f264c2a16ccc9baebc9a138fe6b7f", "61ec5138984e42a2de2985707dc43113217e0c8a", "9db117d146c775f69a93bf4a6d2ae0a7a438745a", "ad4747687452903d326bf69a8c20021395bd1686", "7646e6a5ad5bec69d4b49666344aa2dec0be4bfb", "67faf1e49caf27f9aad957ee640dcf1b3a0774f6", "8b1c8234ebcb35f184a04228015c9204094f9e3e", "c82de29361989d2216581b0c539f4578769f3c17", "1446df3b02bf139663ed57060ec003a66abc653b", "359bdd6a53fbf566de94577bc2ef1a5e1de66b59", "cefe3000ae1024e3c7c6e6a4ccf8f0c71de8b990", "4da01eb466c8fcc1020c168706f70f4d81ccd6a9", "40f91ed7ce5e14610ae633036b8ce361f2e51f60", "f00f580efb290b87aad76f999a9dd8cf2cfe5846", "60840653952e76c5162e1f55fb539ece863f5715", "9fcb2321bc16ad74ebca595c5ce2ab165fe35b31", "cd25cf7a117ec0b27f7ae9751b872f80ec9db52f", "0c675df45654ba040526c3d0541221055431dfd9", "6b96e521252911df0618f8fb1e4a2af848a386e9", "bb82ad6f97b1cdb2e289e88d0011f91781cc1921", "2fe39bb8b03138c7b61a19a61555f9cf93562b9f", "aa89118bf7ea07f7135a3ea3ed321d25bcfab4e6", "85054bceace4520774e594edac817fe099ec7e01", "388229ff49110b571ed16e33f1f9215df62bb497", "d2a4bf91bd3de62a42a94d74324b3b6386658ebe", "add77735c5d31553bbfd7dc4207004f035ac7ffa", "0b36f0f2066f2c6d7b3dd972eb70c01a2af24fca", "2c609dc43aa7834b19538f3c494763822e49c194", "fc56fa7ec18fa3a78c9708151406f2f0efe0f827", "5005781dfdd23fe407c17104ef2f136b98d8e8c5", "310d07532b1f95329ccc64caec4c78b51f4685e4", "fc8df1175d23a89e6297cf576f247642b3e43fa0", "893697f7d379a366e27709c22819598a967b1109", "2e9d30e9a2d67fc553d3bff4696676702e0f16d4", "7069d106af32c452789061509ad66e99bbeddb87", "727a861e11a1e7216e6fa4747fe1caaed87e7a8f", "67c20d9ebb69f9e2a3b72f383bbd4f56c590beab", "184690874704f77399e1acc91eb3d7811f098800", "06148ec3eb4310c75b66a51041b6150867a80e3f", "d86769ec0b09c4de9bc485190e70b58abe31abbd", "afa26250f7ab72efcddf5257e982dae1a7a1787b", "6405399ec29d1afe74409e4202147a6819d0c434", "fe120fc5eb43fa8a01f46ab331a2174515cd7fb6", "c0bdd911219d47cdd383a8b23586491fedc3d9f3", "f0397de5962e919b7e4885b5be610680fc6a1cc6", "3b790c670a6d7c0f28fbfb39d2030a5d0044256e", "479c34a9b79424fbe5de1f81823031162ff16560", "4d4a7c3c8d3e07be37a48a1f5cc2ecf9ad3aeb5f", "cdad7ebd8da30297679b7d3ebc74aaa471d04619", "da8bab669bcb4d8aa3a8f817e46288fb1f752cff", "2fc4c81399775b7dd8f0d7a23356da0fb432745b", "ea2f27d751c1997293a9b1a016c7e4a5343ce3d7", "6fab544fb9f230d4be05a72a6b324c535fb6f2ea", "1b8f1cb0df61738319b8cc09172dadf14f7832a1", "d3e35205ae7f2ad09b151ed6f30accd7c8725626", "890aef34fbd9b7be155fc3917fdd3014bbc72928", "f1c9c8b97e0e162b7b78d6c9d2b1aa38c29e3443", "64a0f13ed45a7d31d1d6e0e109d50170869531f5", "1c0274319144b12b2ca248d8931a262b3413df75", "8946302f9d2a6683fcc99469302b1b8775e45a72", "64795d82be0b71a77a33629b0c17b3320b1d9cd2", "390be3cadddebdc7baf1c7e01195a3834fd6043b", "6595b4b0491e690cd65f03dba11ce49736cafd6a", "50514837ced2286c3ecc75a77685e11f06ff7f43", "3cfe158be50f3457562801f2b23c47c3dc66b740", "420d51915b43095dc94c0661c8cb434755d52f9c", "e141c2475adca3e829fe8ecfa8616ff3d11aa00b", "11041f7b6b28734c3ee2f631012ef48b6e2ed0c8", "d8b477f149704a97182987d70e3e9ae2adb71d57", "a0d6d63816de5c7082f78663b68713df6bf92c40", "a274700a0da7cbe35f81703b8b81610ee5ebfcfc", "5102a388428c134a184f955874b8cfcc6574af27", "24ff6e4bde8a98d6f004cf2688bf5ed59492ff11", "f6273dbcbaac5487815d1ada77c12e57324467b8", "aafadc4b45fe5b63eae443af49a7620dd09694bc", "336e177d4497abe3625fc3882af16a1879a02d6e", "edf31bb553f7acab82c28011a6f9f2cae011b4dc"], "user": "nfay@mozilla.com"}, "45672": {"changesets": [{"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086198 - Bail out of APZCCallbackHelper::UpdateRootFrame when the root scroll container is gone. r=layout-reviewers,tnikkel\n\nThe root element can lose its frames, e.g. by display:none, while the\nPresShell and the root content APZC stay alive, so a repaint request with\nan async zoom can arrive without a root scroll container.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337312\n", "files": ["gfx/layers/apz/util/APZCCallbackHelper.cpp", "gfx/tests/crashtests/2086198.html", "gfx/tests/crashtests/crashtests.list"], "git_node": "970947d891c69e24beae17b81fdbd5c0fbe1a50e", "git_parents": ["edf31bb553f7acab82c28011a6f9f2cae011b4dc"], "node": "0b597526a2ba8ebb0b528309189210c88a3a10df", "parents": ["f9915eaed60fb3d46f7c6f3f7084043216dda265"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086290 - Sample every pageload event on Dev Edition instead of using EARLY_BETA_OR_EARLIER. r=denispal\n\nEARLY_BETA_OR_EARLIER is now equivalent to NIGHTLY_BUILD, and reduced sampling on the small Dev Edition population makes the pageload event unusable in experiments.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337742\n", "files": ["tools/performance/PageloadEvent.cpp"], "git_node": "6c4d3cb576dd03f7de2fd44ad6b5c156e86b4954", "git_parents": ["970947d891c69e24beae17b81fdbd5c0fbe1a50e"], "node": "56314f7e11b7a684aed7f9c9a2e29612a3005508", "parents": ["0b597526a2ba8ebb0b528309189210c88a3a10df"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082904 - Remove browser.nova.enabled=false coverage from profiles tests. r=niklas\n\nbrowser.nova.enabled is about to be locked to true, so the legacy manifest\nand the tests for the legacy theme picker are removed.\nbrowser_edit_profile_test.js only ran in the legacy manifest, so its tasks\nthat don't involve the theme picker move to browser.toml.\nTheme selection telemetry is now checked through theme_picker.change,\nwhich the shared picker records.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336334\n", "files": ["browser/components/profiles/moz.build", "browser/components/profiles/tests/browser/browser-legacy.toml", "browser/components/profiles/tests/browser/browser.toml", "browser/components/profiles/tests/browser/browser_create_profile_page_test.js", "browser/components/profiles/tests/browser/browser_edit_profile_test.js", "browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_test.js", "browser/components/profiles/tests/browser/browser_test_current_theme_from_amo.js", "browser/components/profiles/tests/browser/head.js"], "git_node": "85ae6d508e15eb5f1b10180460641d13c0061a8c", "git_parents": ["6c4d3cb576dd03f7de2fd44ad6b5c156e86b4954"], "node": "98c7116c05b9dcb00ec64f83dc29ff647e540189", "parents": ["56314f7e11b7a684aed7f9c9a2e29612a3005508"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2086285 - Show 'Skip this menu...' item only when the context menu is opened from the result menu r=urlbar-reviewers,daleharvey\n\nThe checkbox is shown when the result menu button is activated after reaching it\nwith the Tab key. While the pref is false, the Tab key skips the button, so the\ncheckbox is shown whenever the menu is opened from the button; otherwise it\nwould never be shown again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337424\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/components/urlbar/tests/browser-results/browser_result_menu.js"], "git_node": "cb6448b704e02d0532681e57f04ccf786c11de46", "git_parents": ["85ae6d508e15eb5f1b10180460641d13c0061a8c"], "node": "812af9908eacdb00361cc8bffc8e2f9539ae1f67", "parents": ["98c7116c05b9dcb00ec64f83dc29ff647e540189"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086770 - Vendor xz-embedded from its GitHub repository. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337736\n", "files": ["modules/xz-embedded/moz.yaml"], "git_node": "a68d299052471ee02613486ec026ce5419f61de0", "git_parents": ["cb6448b704e02d0532681e57f04ccf786c11de46"], "node": "ce1019802a1ce53314bc54382a4b7d59e94eb24f", "parents": ["812af9908eacdb00361cc8bffc8e2f9539ae1f67"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086729 - Only request Mozilla groups from maven.mozilla.org r=RyanVM,android-build-system-reviewers\n\nGradle tries each repository in order and maven.mozilla.org comes first, so the\ndependencies toolchain made about 3,500 requests per run that returned 404 there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337672\n", "files": ["mobile/android/gradle/mozconfig.gradle"], "git_node": "12212c39255edcedc3da683e137e52dfbd6a5995", "git_parents": ["a68d299052471ee02613486ec026ce5419f61de0"], "node": "e6c5fc3049fcd052a887babd9bc1990d39e0e105", "parents": ["ce1019802a1ce53314bc54382a4b7d59e94eb24f"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086584 - Fix building for i686 without SSE. r=spidermonkey-reviewers,yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337566\n", "files": ["js/src/util/Denormals.h", "js/src/wasm/WasmInstance.cpp"], "git_node": "a84050aa0b831927d75f1a15beb57124bbf2da26", "git_parents": ["12212c39255edcedc3da683e137e52dfbd6a5995"], "node": "6032426956ea8fd817f0e781224b271466a32e1f", "parents": ["e6c5fc3049fcd052a887babd9bc1990d39e0e105"], "tags": []}, {"author": "Jonathan Mendez \u003cjmendez@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085034 - Make PolicyChecks.h report a missing MOZ_APP_BASENAME define. r=firefox-desktop-core-reviewers ,Gijs,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337196\n", "files": ["toolkit/xre/PolicyChecks.h"], "git_node": "a1e938a941721eec19dbb672c00f896c422821a5", "git_parents": ["a84050aa0b831927d75f1a15beb57124bbf2da26"], "node": "1bf8f0fcfee8e2821d07636c28f174013356e9a2", "parents": ["6032426956ea8fd817f0e781224b271466a32e1f"], "tags": []}, {"author": "Wyatt Verchere \u003cwverchere@gmail.com\u003e", "branch": "default", "desc": "Bug 2085173 - Replace requestSpocAds with requestSpocOrImageAds. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336302\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/DiscoveryStreamFeed.test.js"], "git_node": "1248a1a12e45ffe9e62ba88463e997ef55b25c2f", "git_parents": ["a1e938a941721eec19dbb672c00f896c422821a5"], "node": "c90ab5fd0fb8ccb0f8a820c22472a80a4e13ddbb", "parents": ["1bf8f0fcfee8e2821d07636c28f174013356e9a2"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082632 - Show the IPP toolbar error and inclusion state only on tabs a connection carries. r=rking,ip-protection-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336175\n", "files": ["browser/components/ipprotection/IPProtectionToolbarButton.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_toolbar.js"], "git_node": "3948cae0a53cbbfdbe1843a19424f447c363d090", "git_parents": ["1248a1a12e45ffe9e62ba88463e997ef55b25c2f"], "node": "320b63514d0923e663c040cc56b6f767b786afa0", "parents": ["c90ab5fd0fb8ccb0f8a820c22472a80a4e13ddbb"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082632 - Show the IPP error alert only in windows whose tab the failed connection carries. r=ip-protection-reviewers,mcleinman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336176\n", "files": ["browser/components/ipprotection/IPProtectionAlertManager.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_alert_manager.js"], "git_node": "9e620062d103b2be6dcc52e09a476c2ca00af700", "git_parents": ["3948cae0a53cbbfdbe1843a19424f447c363d090"], "node": "819fde23593f8797013038e90852dfc5c03e172d", "parents": ["320b63514d0923e663c040cc56b6f767b786afa0"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2050480 - Add gtests that NVImage conversion preserves its input backing store r=gfx-reviewers,bradwerth\n\nBuildSurfaceDescriptorBuffer (NV12 and NV21 branches) and\nGetAsSourceSurface both convert the interleaved chroma to I420; neither\nmay write the deinterleaved planes back into the image's own backing\nstore. Also covers BuildSurfaceDescriptorBuffer's cached-surface path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311438\n", "files": ["gfx/tests/gtest/TestNVImage.cpp", "gfx/tests/gtest/moz.build"], "git_node": "b667ee35d20484ea408a734590c5abc15bfdbe74", "git_parents": ["9e620062d103b2be6dcc52e09a476c2ca00af700"], "node": "e7ba089013d3bb5c97bc9a9179a42bb3cf6375ba", "parents": ["819fde23593f8797013038e90852dfc5c03e172d"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2050480 - Add WebCodecs tests that encoding a VideoFrame preserves its input r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311224\n", "files": ["testing/web-platform/meta/webcodecs/videoFrame-encode-preserves-input.crossOrigin.https.html.ini", "testing/web-platform/meta/webcodecs/videoFrame-encode-preserves-input.https.any.js.ini", "testing/web-platform/tests/webcodecs/videoFrame-encode-preserves-input-utils.js", "testing/web-platform/tests/webcodecs/videoFrame-encode-preserves-input.crossOrigin.helper.html", "testing/web-platform/tests/webcodecs/videoFrame-encode-preserves-input.crossOrigin.https.html", "testing/web-platform/tests/webcodecs/videoFrame-encode-preserves-input.https.any.js"], "git_node": "9bb4ba0f9bad1eed33a49922d238df0beff7b699", "git_parents": ["b667ee35d20484ea408a734590c5abc15bfdbe74"], "node": "931db6748780914090a45bd6bcdee91a0c2a4e55", "parents": ["e7ba089013d3bb5c97bc9a9179a42bb3cf6375ba"], "tags": []}, {"author": "Jonathan Mendez \u003cjmendez@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086796 - Upstream the AppConstants.MOZ_ENTERPRISE constant. r=firefox-build-system-reviewers,enterprise-reviewers,nalexander,mkaply\n\nEnterprise features being upstreamed from enterprise-firefox check\nAppConstants.MOZ_ENTERPRISE in JS. This defines it from the MOZ_ENTERPRISE\nconfig value, the same way as in enterprise-firefox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337757\n", "files": ["toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build"], "git_node": "df77073903dfa09b353aa8ab3251d6ab1dfc4c23", "git_parents": ["9bb4ba0f9bad1eed33a49922d238df0beff7b699"], "node": "a07dbfde37d6eb0d80fa6047f887cb0b115474a0", "parents": ["931db6748780914090a45bd6bcdee91a0c2a4e55"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085884 - Support bitrate and framerate changes in GMPVideoEncoder::Reconfigure. r=media-playback-reviewers,azebrowski\n\nPreviously any reconfiguration was rejected, forcing the encoder to be\nrecreated, and SetBitrate always reapplied the initial framerate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337257\n", "files": ["dom/media/platforms/agnostic/gmp/GMPVideoEncoder.cpp", "dom/media/platforms/agnostic/gmp/GMPVideoEncoder.h"], "git_node": "3a9e56292be9406f980e110df353c4044d68981b", "git_parents": ["df77073903dfa09b353aa8ab3251d6ab1dfc4c23"], "node": "0cf00362bcb98907b8131e38efb631b6223554b1", "parents": ["a07dbfde37d6eb0d80fa6047f887cb0b115474a0"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085173 - Replace requestSpocAds with requestSpocOrImageAds. r=mconley\" for causing newtab failures.\n\nThis reverts commit 1248a1a12e45ffe9e62ba88463e997ef55b25c2f.\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/DiscoveryStreamFeed.test.js"], "git_node": "237df3b7751f18044f9caa4dc5865eaf1a79a341", "git_parents": ["3a9e56292be9406f980e110df353c4044d68981b"], "node": "0df3e13bb08be02305ebd6ab344315d117856152", "parents": ["0cf00362bcb98907b8131e38efb631b6223554b1"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086198 - Bail out of APZCCallbackHelper::UpdateRootFrame when the root scroll container is gone. r=layout-reviewers,tnikkel\" for causing reftest failures\n\nThis reverts commit 970947d891c69e24beae17b81fdbd5c0fbe1a50e.\n", "files": ["gfx/layers/apz/util/APZCCallbackHelper.cpp", "gfx/tests/crashtests/2086198.html", "gfx/tests/crashtests/crashtests.list"], "git_node": "e11d6dd7763495acd419b3856562745beb8ccada", "git_parents": ["237df3b7751f18044f9caa4dc5865eaf1a79a341"], "node": "296e83492a61c134adde864b12ee0ebbb1366f8c", "parents": ["0df3e13bb08be02305ebd6ab344315d117856152"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086452 - Generalize existing valgrind suppressions to also match new rust v0 mangling. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337446\n", "files": ["build/valgrind/cross-architecture.sup"], "git_node": "bad18dedcb17fd5298e8d16c6b6be282b534047f", "git_parents": ["e11d6dd7763495acd419b3856562745beb8ccada"], "node": "52b819b17a95ef98baf6e9448698861a6cf4eb05", "parents": ["296e83492a61c134adde864b12ee0ebbb1366f8c"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086457 - Fix rustc 1.99 deprecation warnings in wrench. r=gfx-reviewers,wsmind\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337443\n", "files": ["gfx/wr/wrench/src/reftest.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs", "gfx/wr/wrench/src/yaml_helper.rs"], "git_node": "eaca62a85b604493b22d59fd7002b9282cb52d4f", "git_parents": ["bad18dedcb17fd5298e8d16c6b6be282b534047f"], "node": "2ef8c5c591bcc5d8ad07b440e54ac61c0c7b0ab9", "parents": ["52b819b17a95ef98baf6e9448698861a6cf4eb05"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086445 - Explicitly specify the literals passed to Stroke::new are f32. r=gfx-reviewers,wsmind\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337441\n", "files": ["gfx/wr/wrshell/src/gui/composite_view.rs", "gfx/wr/wrshell/src/gui/scene_tree.rs", "gfx/wr/wrshell/src/gui/shaders.rs", "gfx/wr/wrshell/src/gui/textures.rs"], "git_node": "6961791f944d90d43b53ea4a68a376329aa53ff8", "git_parents": ["eaca62a85b604493b22d59fd7002b9282cb52d4f"], "node": "d17019fd9fa6ec8bc6a35eeba13891923c124bce", "parents": ["2ef8c5c591bcc5d8ad07b440e54ac61c0c7b0ab9"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086461 - Replace use of Atomic::\u003c_\u003e::fetch_update with try_update. r=crashreporting-reviewers,gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337445\n", "files": ["toolkit/crashreporter/client/app/src/ui/test.rs"], "git_node": "c3652c3f36bd8227272f0cb3f0ed9dbcfb3f0214", "git_parents": ["6961791f944d90d43b53ea4a68a376329aa53ff8"], "node": "e80b8c02c4ee08f680a9f8a4f6cab9e0df94385c", "parents": ["d17019fd9fa6ec8bc6a35eeba13891923c124bce"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2084865 - Force a pip upgrade in updatebot docker images by pinning to the latest version. r=tjr\n\nThat version comes with an up-to-date certifi.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336105\n", "files": ["taskcluster/docker/updatebot/privileged-setup.sh", "taskcluster/docker/updatebot/windows-setup.sh"], "git_node": "8c78d7de8c746ea80f7b29d205bcbd64a1803075", "git_parents": ["c3652c3f36bd8227272f0cb3f0ed9dbcfb3f0214"], "node": "16fa9c71e7c593e996d89b8f999a952655e6ec43", "parents": ["e80b8c02c4ee08f680a9f8a4f6cab9e0df94385c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086785 - Declare androidx.activity in AC ui-colors and ui-animation r=android-build-system-reviewers,ahochheiden,android-reviewers,adhingra\n\nDeclaring the artifact aligns the group to the catalog version, so lint no longer loads the 1.7 and 1.8\nactivity lint checks that lint 32.6 rejects.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337748\n", "files": ["mobile/android/android-components/components/ui/animation/build.gradle", "mobile/android/android-components/components/ui/colors/build.gradle"], "git_node": "b55dd2e6e857f9e9ce3e0174f6e295ba87706e9e", "git_parents": ["8c78d7de8c746ea80f7b29d205bcbd64a1803075"], "node": "3a93f43a858165c4b9d09c0a8c2ff50fe2e19027", "parents": ["16fa9c71e7c593e996d89b8f999a952655e6ec43"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086459 - Replace std::u32::MAX with u32::MAX. r=geckodriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337444\n", "files": ["testing/geckodriver/marionette/src/message.rs"], "git_node": "4dd51cf65497638de6e6624624cc9c4698580488", "git_parents": ["b55dd2e6e857f9e9ce3e0174f6e295ba87706e9e"], "node": "b7c7d710c062c4b9018c4fe54bd1b564f68cd4ec", "parents": ["3a93f43a858165c4b9d09c0a8c2ff50fe2e19027"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085806 - P1. Fail an autofill migration into the Rust store when the JSON store is written to during the copy. r=theidkamp,credential-management-reviewers\n\nThe JSON store keeps serving while it is copied, and the unlock that starts a\ndeferred credit card copy is usually a fill, whose use count update lands\nafter the export. The copy then switched to Rust without it. The migrator now\nfails such a run like any other, so it is retried on a later launch.\n\nWrites are not held back during the copy, as the password migration does by\nrunning before its store is handed out: the credit card copy usually starts\nmid-session, on the OS key store's first unlock, so every write path would\nhave to wait on it. Detecting the write leaves callers unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337526\n", "files": ["browser/extensions/formautofill/test/unit/test_rust_autofill_address_migration.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_parity.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/AutofillStorageMigrator.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "700c85484d9a0ac49a208412787f14ce0186f4ed", "git_parents": ["4dd51cf65497638de6e6624624cc9c4698580488"], "node": "7c5f759c29bbb51762d1b6fce1317ccf94c25e65", "parents": ["b7c7d710c062c4b9018c4fe54bd1b564f68cd4ec"], "tags": []}, {"author": "Dimi Lee \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085806 - P2. Start a deferred credit card migration at a safe point instead of at the OS key store unlock. r=theidkamp,credential-management-reviewers\n\nThe unlock lands in the middle of the action that caused it: a submission's\nduplicate check, a save's encryption, or opening a card for editing. That\naction's own write then fell inside the copy, or after the switch into a store\nthat no longer serves.\n\nA copy waiting for the key store now starts at the first of these safe points\nreached with the key store unlocked, each of which has left nothing pending:\n\n- the end of a fill (FormAutofillParent.autofillFields);\n- the end of a form submission, once any doorhanger it showed is done with,\n  its save included (FormAutofillParent.onFormSubmit; promptToSave now awaits\n  the save);\n- the closing of the card editor in settings (EditCreditCardDialog).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337527\n", "files": ["browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/test/browser/browser_creditCard_migration.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_credit_card_migration.js", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs"], "git_node": "c230f2cbe5715780b7debf3ce696a68718a95bf6", "git_parents": ["700c85484d9a0ac49a208412787f14ce0186f4ed"], "node": "50c1d3349b17e193dd4b26b7acf92e871c2df4f8", "parents": ["7c5f759c29bbb51762d1b6fce1317ccf94c25e65"], "tags": []}, {"author": "Dimi Lee \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085806 - P3. Remove OSKeyStore.UNLOCKED_TOPIC. r=theidkamp\n\nThe deferred credit card migration was its only listener, and now waits for a\nsafe point instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337528\n", "files": ["toolkit/modules/OSKeyStore.sys.mjs", "toolkit/modules/tests/xpcshell/test_osKeyStore.js"], "git_node": "d9f2b0dab7dcea452cc1341aa4dc8efcf1ef49bc", "git_parents": ["c230f2cbe5715780b7debf3ce696a68718a95bf6"], "node": "4edabeda72e6f9ff706ea7dcc41d1b8514f0f0ba", "parents": ["50c1d3349b17e193dd4b26b7acf92e871c2df4f8"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2086499 - Add branchTestNullOrUndefined and test both tags at once on arm64 and x64. r=iain\n\nNull and undefined differ in a single tag bit and the other two type codes\nwith the same upper bits are unused, so one comparison of the Value's bits\nabove that one tells whether it is either of them. The JITs test the pair\nat a dozen sites (loose equality with null, the Coalesce and\nIsNullOrUndefined ops, CheckObjCoercible, the guards for optional chains\nand the truthiness tests) as two tag compares with two branches.\n\nThis adds branchTestNullOrUndefined to the MacroAssembler and uses it at\nthose sites. The ValueOperand form shifts the Value and compares once on\narm64 and x64; the Register form, for callers that have extracted the tag\nfor further tests, uses ccmn on arm64 to keep a single branch. The other\nbackends emit the two compares as before.\n\nThe test of the Coalesce operand in Ion was, on arm64,\n\n  asr x16, x0, #47\n  cmn w16, #12\n  b.eq nullOrUndefined\n  cmn w16, #10\n  b.eq nullOrUndefined\n\nand becomes\n\n  asr x16, x0, #49\n  cmn w16, #3\n  b.eq nullOrUndefined\n\nand on x64 it was\n\n  movq %rax, %r11\n  shrq $47, %r11\n  cmpl $0x1fff4, %r11d\n  je nullOrUndefined\n  cmpl $0x1fff6, %r11d\n  je nullOrUndefined\n\nand becomes\n\n  movq %rax, %r11\n  shrq $49, %r11\n  cmpl $0x7ffd, %r11d\n  je nullOrUndefined\n\nThe CacheIR stub for loose equality with null goes on to test for an\nobject, so it keeps the extracted tag; on arm64 it was\n\n  asr x16, x0, #47\n  cmn w16, #12\n  b.eq equal\n  cmn w16, #10\n  b.eq equal\n  cmn w16, #4\n  b.ne notEqual\n\nand becomes\n\n  asr x16, x0, #47\n  cmn w16, #12\n  ccmn w16, #10, #4, ne\n  b.eq equal\n  cmn w16, #4\n  b.ne notEqual\n\nwhile x64 keeps the two compares there.\n\nIn the code compiled during a JetStream 3 run on arm64, the ValueOperand\nform replaces the pair of tests at 5,501 Ion and 2,157 Baseline sites, two\ninstructions fewer each with one of them a branch, and the ccmn form at\n10,462 Ion and 26 Baseline sites, a branch fewer each. Ion still tests null\nand then undefined at 2,491 sites, all in loadAtomOrSymbolAndHash, which\nmaps the two to different atoms.\n\nValue.h documents the layout constraint and asserts it, and\nValue::isNullOrUndefined uses the same test: the compiler turns its two\ncompares into a mask and a compare against a 64-bit constant, where the\nshift and compare against a small constant save an instruction on arm64\nand two 10-byte immediates on x64.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337469\n", "files": ["js/public/Value.h", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm-inl.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared-inl.h", "js/src/jit/mips64/MacroAssembler-mips64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/wasm32/MacroAssembler-wasm32-inl.h", "js/src/jit/x64/MacroAssembler-x64-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h", "js/src/jit/x86/MacroAssembler-x86-inl.h"], "git_node": "1a642409a20fdf6e1588e66f6b2a89de59361698", "git_parents": ["d9f2b0dab7dcea452cc1341aa4dc8efcf1ef49bc"], "node": "0624f5aa4d7986bf20c86e4dc10cd6a803faf464", "parents": ["4edabeda72e6f9ff706ea7dcc41d1b8514f0f0ba"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962340 - Use a resize event instead of a timeout to tell renderi\u2026 r=mustaqahmed,emilio\n\n\u2026ng updates apart in new-scroll-event-dispatched-at-next-updating-rendering-time.html. r?#layout-reviewers\n\nTimer callbacks are queued on the timer task source and rendering updates on the rendering task source, and the event loop picks among task queues in an implementation-defined manner, so a timeout set in a requestAnimationFrame callback may run after the next rendering update. The resize event fired by the next rendering update's resize steps, right before its scroll steps, marks the start of that update instead.\n\nhttps://html.spec.whatwg.org/#event-loop-processing-model\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/416\n", "files": ["testing/web-platform/meta/html/webappapis/scripting/event-loops/new-scroll-event-dispatched-at-next-updating-rendering-time.html.ini", "testing/web-platform/tests/html/webappapis/scripting/event-loops/new-scroll-event-dispatched-at-next-updating-rendering-time.html"], "git_node": "b0161d1bb26359aa1c169dbf79d740ba01aeee5c", "git_parents": ["1a642409a20fdf6e1588e66f6b2a89de59361698"], "node": "6c7305b6aedf862c5d3ec82b4196c68911305423", "parents": ["0624f5aa4d7986bf20c86e4dc10cd6a803faf464"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2084401 - Intern box shadows in the display list builder r=gfx-reviewers,lsalzman\n\nThe key is the PrimKey\u003cBoxShadow\u003e the scene builder used to intern, all of\nwhich push_box_shadow already derived. Box shadows cast no shadow copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335850\n", "files": ["gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/scene_debug.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/interned_prims.rs", "gfx/wr/webrender_api/src/interning.rs"], "git_node": "17c8c11336605109384c14c72ce8cb3d45be0cb4", "git_parents": ["b0161d1bb26359aa1c169dbf79d740ba01aeee5c"], "node": "74eb3bacc994b3d0ee8b3b791ff169cf92623241", "parents": ["6c7305b6aedf862c5d3ec82b4196c68911305423"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2084402 - Intern line decorations in the display list builder r=gfx-reviewers,lsalzman\n\nShadow copies are interned from a CapturedKey::Line. A transparent line is\ndropped at record time unless a shadow scope is open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335851\n", "files": ["gfx/wr/webrender/src/dl_interner.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/interned.rs", "gfx/wr/webrender/src/prim_store/line_dec.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/interning.rs"], "git_node": "cb30fcefd77049fb4953e240f5542fa9180c4667", "git_parents": ["17c8c11336605109384c14c72ce8cb3d45be0cb4"], "node": "a73d4707b4f7990effff53fe0b9e45f1201c09d1", "parents": ["74eb3bacc994b3d0ee8b3b791ff169cf92623241"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085851 - Use a prebuilt cargo-audit in the lint task and for local runs r=linter-reviewers,marco\n\nThe lint task ran `cargo install cargo-audit` on every run, which took\nabout 74 seconds before an audit of about 3 seconds. A toolchain task now\nbuilds the pinned version once, and the lint task puts it on `PATH`, so\nthe setup finds the version it wants and skips the install. Local `mach\nlint` runs bootstrap the same toolchain, and fall back to `cargo install`\non hosts without one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336629\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/source-test/mozlint.yml", "taskcluster/kinds/toolchain/cargo-audit.yml", "taskcluster/kinds/toolchain/kind.yml", "tools/lint/cargo-audit/__init__.py"], "git_node": "f28c504f68067ac759afbc53eeeba839ae7940ce", "git_parents": ["cb30fcefd77049fb4953e240f5542fa9180c4667"], "node": "30f686d6f4bf64d71f73f0dcbf828c7311aa8cbc", "parents": ["a73d4707b4f7990effff53fe0b9e45f1201c09d1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085852 - Part 1 - Match `support-files` against paths relative to the root r=linter-reviewers,marco\n\n`should_lint_entire_tree` matched each changed file's absolute path\nagainst the `support-files` patterns. Most patterns are relative to the\nroot, so only those starting with `**/` matched, along with the absolute\npath of the linter's own definition. Changing a file like\n`tools/lint/eslint/__init__.py` or `tools/lint/python/ruff.py` under\n`--outgoing` or `--workdir` linted only the changed files instead of the\nwhole tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336630\n", "files": ["python/mozlint/mozlint/roller.py", "python/mozlint/test/test_roller.py"], "git_node": "c21df9d11f5472b72d0da66dcb926d2e00f641e4", "git_parents": ["f28c504f68067ac759afbc53eeeba839ae7940ce"], "node": "8c8129488358fd5c1c3e07ac931f19ee0010a67f", "parents": ["30f686d6f4bf64d71f73f0dcbf828c7311aa8cbc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085852 - Part 2 - List the eslint and stylelint configs in their `support-files` r=linter-reviewers,sergesanspaille\n\nThe rules live in `eslint.config.mjs`, the `eslint-*.config.mjs` files\nit imports and the `.eslintrc.mjs` file in each directory, and stylelint\nreads `stylelint-rollouts.config.js`, but the `support-files` only\nlisted the older `.eslintrc.js` and `.stylelintrc.js`.\nChanging a rule under `--outgoing` or `--workdir` linted only the changed\nfiles instead of the whole tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336631\n", "files": ["tools/lint/eslint.yml", "tools/lint/stylelint.yml"], "git_node": "42ae4f630663694522ab5208e8934ab97e3ae5b3", "git_parents": ["c21df9d11f5472b72d0da66dcb926d2e00f641e4"], "node": "baf0ee9519c658908a0ed151866282320264d5d0", "parents": ["8c8129488358fd5c1c3e07ac931f19ee0010a67f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085855 - Only set up the linters that have files to lint r=linter-reviewers,sergesanspaille\n\nSetup ran for every linter before the paths were filtered, so a run on\nPython files still set up typescript, pnpm-audit and the other node\nlinters, which can take several seconds each. `roll` now sets up the\nlinters it generated jobs for. Setup failures also stay in the result\nnow, since `roll` used to reset them after `setup` recorded them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336635\n", "files": ["python/mozlint/mozlint/cli.py", "python/mozlint/mozlint/roller.py", "python/mozlint/test/test_cli.py", "python/mozlint/test/test_roller.py"], "git_node": "6c56a9a7ebbb789ed0b10906cdc25d201c181589", "git_parents": ["42ae4f630663694522ab5208e8934ab97e3ae5b3"], "node": "f008209c75846787d0186e55e40e8975fcdb27ef", "parents": ["baf0ee9519c658908a0ed151866282320264d5d0"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085857 - Run yamllint in process r=linter-reviewers,sergesanspaille\n\nEvery yamllint job started a second mach through `mach python` to run the\nvendored yamllint, which took about a second before yamllint ran. The\nlinter now calls the yamllint API the way its command line does. The\nresults also no longer collect in a module global, which reported the\nissues of an earlier job again when a worker ran more than one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336638\n", "files": ["tools/lint/test/files/yaml/locale/.yamllint", "tools/lint/test/files/yaml/locale/good.yml", "tools/lint/test/test_yaml.py", "tools/lint/yamllint_/__init__.py"], "git_node": "daf09d52f5d39420cd853afe9a7b68b1f018e69f", "git_parents": ["6c56a9a7ebbb789ed0b10906cdc25d201c181589"], "node": "241c4b049569f8b582d51c8c33e9f97117d55d68", "parents": ["f008209c75846787d0186e55e40e8975fcdb27ef"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2083629 - Pop the change index before performing block I/O in FileBlockCache. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336984\n", "files": ["dom/media/FileBlockCache.cpp"], "git_node": "e696700fc1a892d1cc9f3a694cf8d34ca720c5f9", "git_parents": ["daf09d52f5d39420cd853afe9a7b68b1f018e69f"], "node": "e3a16ca329a4caebd1463cfcdd20069c6ae8585b", "parents": ["241c4b049569f8b582d51c8c33e9f97117d55d68"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2085478 - Update opus to a8b2545eec71e0f53ecead2d583e7b6baa42684d r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336978\n", "files": ["media/libopus/celt/arch.h", "media/libopus/celt/celt.c", "media/libopus/celt/celt.h", "media/libopus/celt/celt_decoder.c", "media/libopus/celt/celt_encoder.c", "media/libopus/celt/mips/celt_mipsr1.h", "media/libopus/celt/mips/kiss_fft_mipsr1.h", "media/libopus/celt/mips/mdct_mipsr1.h", "media/libopus/celt/modes.c", "media/libopus/celt/modes.h", "media/libopus/moz.build", "media/libopus/moz.yaml", "media/libopus/silk/dec_API.c", "media/libopus/silk/init_decoder.c", "media/libopus/src/opus_decoder.c", "media/libopus/src/opus_encoder.c"], "git_node": "e2bf1ef187e0d9f98f9d5d4b19366e6e5098b918", "git_parents": ["e696700fc1a892d1cc9f3a694cf8d34ca720c5f9"], "node": "eaf013337fc9aabd34041afdbf04c7a840a48796", "parents": ["e3a16ca329a4caebd1463cfcdd20069c6ae8585b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084734 - Tweak first-letter heuristics to detect this case. r=jfkthame,layout-reviewers\n\nSome sites (Hearst publications) compensate a negative block-end margin on a\nfloating first-letter with an equal block-start margin only in Gecko, to\ncounteract our legacy tight-bounds behavior. Detect that before the\nreduced-line-height heuristic, which would otherwise pick the webkit/blink\nbehavior and double-shift the letter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337648\n", "files": ["layout/generic/nsFirstLetterFrame.cpp", "layout/reftests/first-letter/2084734.html", "layout/reftests/first-letter/reftest.list"], "git_node": "a280584eac8f594be24e283031922876a1bab8d4", "git_parents": ["e2bf1ef187e0d9f98f9d5d4b19366e6e5098b918"], "node": "a2d9ef9774c53568e4822fd64316c98a15d3ed5c", "parents": ["eaf013337fc9aabd34041afdbf04c7a840a48796"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2086691 - Invoke the ReportingObserver callback with the observer as its this value r=smaug\n\nSpec specifically mentions that the callback `this` value needs to be\nthe observer:\nhttps://w3c.github.io/reporting/#invLoke-observers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337645\n", "files": ["dom/reporting/ReportingObserver.cpp", "testing/web-platform/tests/reporting/callback-this.html"], "git_node": "06dcf89831ae5dd45eb94221787ccfe5eaf6c1ff", "git_parents": ["a280584eac8f594be24e283031922876a1bab8d4"], "node": "4d0c12d022543163be97a99435a3ce5dffb6a01a", "parents": ["a2d9ef9774c53568e4822fd64316c98a15d3ed5c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086363 - Update Brotli to upstream revision 089e71983611a42643d75194fedfde086c5e58af. r=jesup\n\nThe v1.2.1 release tag branches from v1.2.0 and is older than the revision we already ship, so this takes\nupstream master instead, which also has the cleanup the tag carries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337400\n", "files": ["modules/brotli/common/platform.h", "modules/brotli/dec/decode.c", "modules/brotli/dec/state.h", "modules/brotli/enc/backward_references.c", "modules/brotli/enc/backward_references_hq.c", "modules/brotli/enc/backward_references_inc.h", "modules/brotli/enc/backward_references_opt_inc.h", "modules/brotli/enc/block_encoder_inc.h", "modules/brotli/enc/brotli_bit_stream.c", "modules/brotli/enc/compound_dictionary.c", "modules/brotli/enc/compound_dictionary.h", "modules/brotli/enc/encode.c", "modules/brotli/enc/hash.h", "modules/brotli/enc/hash_forgetful_chain_inc.h", "modules/brotli/enc/hash_longest_match64_inc.h", "modules/brotli/enc/hash_longest_match64_simd_inc.h", "modules/brotli/enc/hash_longest_match_inc.h", "modules/brotli/enc/hash_longest_match_quickly_inc.h", "modules/brotli/enc/hash_longest_match_simd_inc.h", "modules/brotli/enc/hash_longest_match_simd_opt_inc.h", "modules/brotli/enc/metablock.c", "modules/brotli/enc/metablock.h", "modules/brotli/enc/params.h", "modules/brotli/enc/quality.h", "modules/brotli/enc/ringbuffer.h", "modules/brotli/include/brotli/encode.h", "modules/brotli/include/brotli/shared_dictionary.h", "modules/brotli/include/brotli/types.h", "modules/brotli/moz.yaml"], "git_node": "8addf82b9d5ff855c8f0bf69d02882b3b41d0428", "git_parents": ["06dcf89831ae5dd45eb94221787ccfe5eaf6c1ff"], "node": "ff14264ff52b0d8cd730a94ea533596df0a05397", "parents": ["4d0c12d022543163be97a99435a3ce5dffb6a01a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086363 - Enable weekly Updatebot vendoring for Brotli. r=jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337401\n", "files": ["modules/brotli/moz.yaml"], "git_node": "4aefc42b2bb9de6d271c9c655f431e3fe7f25227", "git_parents": ["8addf82b9d5ff855c8f0bf69d02882b3b41d0428"], "node": "02cd2d4b77373e89bcbcb27e40d83ccac867cdad", "parents": ["ff14264ff52b0d8cd730a94ea533596df0a05397"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082653 - Add responsive background handling to the HNT card stack r=nbarrett,fterdal,omc-reviewers,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336069\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "d9f5c3cdb2ba7488da7a767738360ddc66b303a1", "git_parents": ["4aefc42b2bb9de6d271c9c655f431e3fe7f25227"], "node": "815fbe12c3b171beca780bc4bfb6746862e026b7", "parents": ["02cd2d4b77373e89bcbcb27e40d83ccac867cdad"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1115874 - Make the OpenH264 plugin link timestamp, PDB path and zip packaging deterministic. r=firefox-build-system-reviewers,glandium\n\nWindows builds now take their PE timestamp from the OpenH264 commit time via\nSOURCE_DATE_EPOCH and record only the PDB basename, matching what Firefox\nshippable builds do. The plugin zip is created with mozbuild.action.zip so\nentry timestamps no longer depend on build time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337607\n", "files": ["taskcluster/scripts/openh264/build.sh"], "git_node": "dd16065537815a3f45ee9db963a1eed255455512", "git_parents": ["d9f5c3cdb2ba7488da7a767738360ddc66b303a1"], "node": "c41ec17b48106dc90dcf850bff3bb840152f36ae", "parents": ["815fbe12c3b171beca780bc4bfb6746862e026b7"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086630 - Stop packaging binaries in the OpenH264 symbols archive. r=releng-reviewers,bhearsum\n\nOnly the .sym files are needed to symbolicate crashes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337739\n", "files": ["taskcluster/scripts/openh264/build.sh"], "git_node": "a5a2fe441861963519b9414c0354fe8da95f7324", "git_parents": ["dd16065537815a3f45ee9db963a1eed255455512"], "node": "6f8e7fa7d7883a0b83366cd85a7397ccb6024f8c", "parents": ["c41ec17b48106dc90dcf850bff3bb840152f36ae"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086499 - Add branchTestNullOrUndefined and test both tags at once on arm64 and x64. r=iain\" for causing lint failures on MacroAssembler.h.\n\nThis reverts commit 1a642409a20fdf6e1588e66f6b2a89de59361698.\n", "files": ["js/public/Value.h", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm-inl.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared-inl.h", "js/src/jit/mips64/MacroAssembler-mips64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/wasm32/MacroAssembler-wasm32-inl.h", "js/src/jit/x64/MacroAssembler-x64-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h", "js/src/jit/x86/MacroAssembler-x86-inl.h"], "git_node": "6e830f7e77b151de2f649402a3d5c6df8fe388c5", "git_parents": ["a5a2fe441861963519b9414c0354fe8da95f7324"], "node": "e65dee01f60d808d6c4bda570d99670ef27797ce", "parents": ["6f8e7fa7d7883a0b83366cd85a7397ccb6024f8c"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2082653 - Add responsive background handling to the HNT card stack r=nbarrett,fterdal,omc-reviewers,jprickett\" for causing lint failures.\n\nThis reverts commit d9f5c3cdb2ba7488da7a767738360ddc66b303a1.\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "23a55fe2ee14f7d06e5a0a03fef56390a9d66e89", "git_parents": ["6e830f7e77b151de2f649402a3d5c6df8fe388c5"], "node": "49b9f0bf0f47121a24058701b53c52512c48af9f", "parents": ["e65dee01f60d808d6c4bda570d99670ef27797ce"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2074508 - Part 1: Add a homepage search position setting to Customize settings screen r=android-reviewers,android-l10n-reviewers,devota,parker\n\n- The middle search bar already existed behind pref_key_enable_homepage_searchbar2 but had no settings UI. \"Middle\" binds to that pref directly.\n- Figma: https://www.figma.com/design/hBfKusHhCaTfERowKh1yYP/HNT-Handoff?node-id=3257-5761&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333329\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/CustomizationFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/RadioButtonInfoPreference.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/RadioButtonPreference.kt", "mobile/android/fenix/app/src/main/res/layout/preference_widget_radiobutton_with_info.xml", "mobile/android/fenix/app/src/main/res/values/attrs.xml", "mobile/android/fenix/app/src/main/res/values/dimens.xml", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/customization_preferences.xml"], "git_node": "b5b4002f6bff1d05241cb3eef22406c70409a418", "git_parents": ["23a55fe2ee14f7d06e5a0a03fef56390a9d66e89"], "node": "893145cdb6897351553f10f2873b4ff09f14e990", "parents": ["49b9f0bf0f47121a24058701b53c52512c48af9f"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2074508 - Part 2: Show the search bar on the homepage when the homepage search position is Middle r=android-reviewers,devota\n\n- isHomepageMiddleSearchEnabled pairs the pref with a top address bar, which HomepageState and TabPreview already did but HomeFragment and HomeToolbarComposable did not.\n- The toolbar address bar is hidden while the search bar is shown and returns when search is active.\n- In private mode, the search bar sits between the private browsing icon and description, so PrivateBrowsingDescription now only contains the text.\n- Figma: https://www.figma.com/design/hBfKusHhCaTfERowKh1yYP/HNT-Handoff?node-id=3519-2067&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333850\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomepageState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/PrivateBrowsingDescription.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt"], "git_node": "619a069db61b3952b57c13bb5a99003a1e141af2", "git_parents": ["b5b4002f6bff1d05241cb3eef22406c70409a418"], "node": "a8302020eafae3f9152497b08be9a1728031a42c", "parents": ["893145cdb6897351553f10f2873b4ff09f14e990"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2074508 - Part 3: Add the stories and private browsing actions to the homepage toolbar r=android-reviewers,devota\n\n- BrowserSimpleToolbar renders start actions so the stories button can sit at the start of the toolbar.\n- Both actions are gated on the middle search bar replacing the address bar.\n- The stories action is hidden in private mode and the private browsing action is always shown.\n- Figma: https://www.figma.com/design/hBfKusHhCaTfERowKh1yYP/HNT-Handoff?node-id=3257-1877&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333330\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomeToolbarStoreBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/BrowserSimpleToolbar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddlewareTest.kt"], "git_node": "76442f8934d54940e04b1921661446831364c28e", "git_parents": ["619a069db61b3952b57c13bb5a99003a1e141af2"], "node": "84aa309831c10e74ff0cc6815d642412d832677b", "parents": ["a8302020eafae3f9152497b08be9a1728031a42c"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2074508 - Part 4: Hide the homepage header entry points when middle search is enabled r=android-reviewers,devota\n\n- The stories and private browsing buttons are shown in the toolbar instead.\n- Applies to both normal and private mode.\n- Figma: https://www.figma.com/design/hBfKusHhCaTfERowKh1yYP/HNT-Handoff?node-id=3257-1877&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333331\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomepageState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/HomepageHeader.kt"], "git_node": "c72f1d198de97824f3df94f9d3c99820d043f973", "git_parents": ["76442f8934d54940e04b1921661446831364c28e"], "node": "1f6c099f4f16d5474787ae431b9f27ced9998bc2", "parents": ["84aa309831c10e74ff0cc6815d642412d832677b"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2082071 - Always show the Jump back in, Bookmarks and Recently visited toggles in the Homepage settings r=android-reviewers,devota\n\n- Removes the showHomepage*SectionToggle getters that hid these toggles when the homepage middle search bar was enabled\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333893\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/HomeSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/HomeSettingsFragmentTest.kt"], "git_node": "ff1b2fd2fc78f1cea7d774bd73262a202d892f55", "git_parents": ["c72f1d198de97824f3df94f9d3c99820d043f973"], "node": "02719f53dbadb230b3e434a6b3ec7032f3883718", "parents": ["1f6c099f4f16d5474787ae431b9f27ced9998bc2"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2059164 - Add a Web Audio test for resampling a low-rate media element r=media-playback-reviewers,padenot\n\nCapture a low-rate stereo FLAC into a high-rate context, where the resampler\ncannot represent the output length and the chunk is rejected, and check that\nevery channel stays silent.\n\nUse a zero-output AudioWorklet probe driven by a playback marker and a\ngraph-time budget rather than a timeout, and share the ASan fill helper with\nbug 2038465.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315519\n", "files": ["dom/media/webaudio/test/bug2059164_1hz_stereo.flac", "dom/media/webaudio/test/mochitest.toml", "dom/media/webaudio/test/test_bug2038465.html", "dom/media/webaudio/test/test_bug2059164.html", "dom/media/webaudio/test/webaudio_asan_fill.js", "dom/media/webaudio/test/webaudio_channel_fill_probe_processor.js"], "git_node": "f28bd043e396b8396382065c84c8cf4b06a5d5e1", "git_parents": ["ff1b2fd2fc78f1cea7d774bd73262a202d892f55"], "node": "180eb3b416dfca6fde7ab2f19a876b475b6f6cef", "parents": ["02719f53dbadb230b3e434a6b3ec7032f3883718"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2059164 - Test AudioSegment resample size rejection r=media-playback-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315701\n", "files": ["dom/media/gtest/TestAudioSegment.cpp"], "git_node": "87b3839d04a4c835a44441e54a953a6a2daaaa77", "git_parents": ["f28bd043e396b8396382065c84c8cf4b06a5d5e1"], "node": "54001d5c446eef4c3ba8590a6ec957502f610a66", "parents": ["180eb3b416dfca6fde7ab2f19a876b475b6f6cef"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086821 - Update Adjust SDK to version 5.8.1. r=android-reviewers,android-build-system-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337792\n", "files": ["gradle/libs.versions.toml"], "git_node": "ca871c93d1c874b1e54cc6182cd2415bf1b200a9", "git_parents": ["87b3839d04a4c835a44441e54a953a6a2daaaa77"], "node": "d6916d1beccd279a5f45d2eb6f9fbaa2d5296509", "parents": ["54001d5c446eef4c3ba8590a6ec957502f610a66"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1978851 - Make setting CanvasRenderingContext2D.filter cheap. r=gfx-reviewers,lsalzman\n\nAvoid resolving a full ComputedStyle and creating observers for simple\nfilters. Update the FilterDescription lazily since we already have code\nfor that (for tainting).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336561\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "servo/components/style/values/specified/length.rs", "servo/ports/geckolib/glue.rs"], "git_node": "999cbfbddb41aed27a19fae44e74706a2cfe3302", "git_parents": ["ca871c93d1c874b1e54cc6182cd2415bf1b200a9"], "node": "249d9fa7a1a4676cb5c5c88c247742f45b6414f4", "parents": ["d6916d1beccd279a5f45d2eb6f9fbaa2d5296509"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086764 - Vendor libaom to a01bb1dddef8acf39a330dfc21b313518ad47576. r=media-playback-reviewers,chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337794\n", "files": ["media/libaom/config/generic/config/av1_rtcd.h", "media/libaom/config/linux/arm/config/av1_rtcd.h", "media/libaom/config/linux/ia32/config/av1_rtcd.h", "media/libaom/config/linux/x64/config/av1_rtcd.h", "media/libaom/config/mac/arm64/config/av1_rtcd.h", "media/libaom/config/mac/x64/config/av1_rtcd.h", "media/libaom/config/win/ia32/config/av1_rtcd.h", "media/libaom/config/win/x64/config/av1_rtcd.h", "media/libaom/moz.yaml", "third_party/aom/CHANGELOG", "third_party/aom/CMakeLists.txt", "third_party/aom/aom/aom_image.h", "third_party/aom/aom/aomcx.h", "third_party/aom/aom/src/aom_image.c", "third_party/aom/av1/av1_cx_iface.c", "third_party/aom/av1/common/av1_rtcd_defs.pl", "third_party/aom/av1/encoder/aq_cyclicrefresh.c", "third_party/aom/av1/encoder/aq_cyclicrefresh.h", "third_party/aom/av1/encoder/arm/av1_k_means_neon.c", "third_party/aom/av1/encoder/bitstream.c", "third_party/aom/av1/encoder/block.h", "third_party/aom/av1/encoder/encode_strategy.c", "third_party/aom/av1/encoder/encodeframe.c", "third_party/aom/av1/encoder/encoder.c", "third_party/aom/av1/encoder/k_means_template.h", "third_party/aom/av1/encoder/motion_search_facade.c", "third_party/aom/av1/encoder/nonrd_opt.c", "third_party/aom/av1/encoder/nonrd_pickmode.c", "third_party/aom/av1/encoder/partition_search.c", "third_party/aom/av1/encoder/pass2_strategy.c", "third_party/aom/av1/encoder/pickcdef.c", "third_party/aom/av1/encoder/picklpf.c", "third_party/aom/av1/encoder/pickrst.c", "third_party/aom/av1/encoder/rdopt.c", "third_party/aom/av1/encoder/rdopt.h", "third_party/aom/av1/encoder/speed_features.c", "third_party/aom/av1/encoder/speed_features.h", "third_party/aom/av1/encoder/svc_layercontext.c", "third_party/aom/av1/encoder/tpl_model.c", "third_party/aom/av1/encoder/tpl_model.h", "third_party/aom/av1/encoder/txb_rdopt.c", "third_party/aom/av1/encoder/var_based_part.c", "third_party/aom/av1/encoder/x86/av1_k_means_avx2.c", "third_party/aom/av1/encoder/x86/av1_k_means_sse2.c", "third_party/aom/test/active_map_test.cc", "third_party/aom/test/aom_image_test.cc", "third_party/aom/test/av1_k_means_test.cc", "third_party/aom/test/encode_api_test.cc", "third_party/aom/test/encode_internal_test.cc", "third_party/aom/test/encode_small_width_height_test.cc", "third_party/aom/test/frame_size_tests.cc", "third_party/aom/test/rt_end_to_end_test.cc", "third_party/aom/test/test.cmake"], "git_node": "7fe267a5352264b26c56e2c34bf0593af40c359e", "git_parents": ["999cbfbddb41aed27a19fae44e74706a2cfe3302"], "node": "6b82d1e57c4e0fef0de3c9706690f5b5f448af90", "parents": ["249d9fa7a1a4676cb5c5c88c247742f45b6414f4"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2086867 - Update the Firefox Profiler toolchain to the October 22, 2026 deploy r=mstange,profiler-reviewers\n\nThis revision includes profiler-cli 0.12.0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337805\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "459b3fa768a64f049dbeb5ca017c36d4bf9a0705", "git_parents": ["7fe267a5352264b26c56e2c34bf0593af40c359e"], "node": "8b29b62ee8b671a600813412067e43c040f592e4", "parents": ["6b82d1e57c4e0fef0de3c9706690f5b5f448af90"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086675: Unset fixed containing blocks explicitly for repeating table headers only. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337717\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/css-position/crashtests/top-layer-dialog-crash.html"], "git_node": "a27c3a89f3c9b58d28ca9081915706305889307f", "git_parents": ["459b3fa768a64f049dbeb5ca017c36d4bf9a0705"], "node": "e34439b8dba6e98e602b24c4a5558934d7dcafa3", "parents": ["8b29b62ee8b671a600813412067e43c040f592e4"], "tags": []}, {"author": "Alex Klemenchuk \u003calex@alextech.cc\u003e", "branch": "default", "desc": "Bug 2082728 - Report a hovering Android stylus as pen input. r=geckoview-reviewers,m_kato\n\nStylus hover events reach Gecko through NPZCSupport::HandleMouseEvent, which\nalways used MOZ_SOURCE_MOUSE, so a hovering pen reported pointerType \"mouse\"\nand switched to \"pen\" only once the tip touched the screen.\n\nPass the tool type through and use MOZ_SOURCE_PEN for TOOL_TYPE_STYLUS, so\nhover and contact both have pointerType \"pen\". Gecko already treats pen as\nan input source that supports hover.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334380\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PanZoomControllerTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/PanZoomController.java", "widget/android/nsWindow.cpp"], "git_node": "f385b1b73c0af2fdadf9c604aa8cd8a0769cb856", "git_parents": ["a27c3a89f3c9b58d28ca9081915706305889307f"], "node": "f9e29f19b0b933fa6a2eb5b2161f3d47f7720369", "parents": ["e34439b8dba6e98e602b24c4a5558934d7dcafa3"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083871 - Add \"Powered by Kayak\" to the Travel widget context menu. r=fluent-reviewers,reemhamz,bolsson\n\nA \"Powered by Kayak\" item has been added to the top of the Travel\nwidget context menu. It uses the shared `WidgetMenuPoweredBy`\ncomponent, like Horoscopes, so it opens kayak.com in a new tab and\nrecords a `powered_by_kayak` user action.\n\nThe `WidgetMenuFooter` divider is now on for Travel, so it separates\nthe new item from the standard context menu items, as HNT-3665 asks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337433\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Travel/Travel.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Travel.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "a828e088392d9c351bcaa2a49d3645165fe90770", "git_parents": ["f385b1b73c0af2fdadf9c604aa8cd8a0769cb856"], "node": "4af2a2109bdc9b8f79b902e0c4cd37be1cb43d6e", "parents": ["f9e29f19b0b933fa6a2eb5b2161f3d47f7720369"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086822 - Update ML Kit GenAI Prompt API to version 1.0.0-beta5. r=android-reviewers,android-build-system-reviewers,adhingra\n\nGenerativeModel gained getAvailableFeatures() and deprecated the per-feature availability checks, so update\nthe test fake to match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337785\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/components/lib/llm-gemininano/src/test/java/mozilla/components/lib/llm/gemini/nano/fakes/FakeGenerativeModel.kt"], "git_node": "f2b870d082e66e6a5e09fc1a3727409492babec6", "git_parents": ["a828e088392d9c351bcaa2a49d3645165fe90770"], "node": "970a93c1ad89909fd352d15433fee2d59af10992", "parents": ["4af2a2109bdc9b8f79b902e0c4cd37be1cb43d6e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086843 - Update DAGP to version 3.20.0. r=android-reviewers,android-build-system-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337811\n", "files": ["gradle/libs.versions.toml"], "git_node": "9d8edd0b0b93dc4d5afbb59550f075c5ab901bf3", "git_parents": ["f2b870d082e66e6a5e09fc1a3727409492babec6"], "node": "fcb67c1daed89c0b303818eeb390066d2b8a1aa5", "parents": ["970a93c1ad89909fd352d15433fee2d59af10992"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086843 - Update JaCoCo to version 0.8.16. r=android-reviewers,android-build-system-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337812\n", "files": ["gradle/libs.versions.toml"], "git_node": "af71b4f7a3f6c76cedbff971e383fcce12d7ee38", "git_parents": ["9d8edd0b0b93dc4d5afbb59550f075c5ab901bf3"], "node": "052ca2216a9729e3427def0011c7f4d345f4c5ba", "parents": ["fcb67c1daed89c0b303818eeb390066d2b8a1aa5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086843 - Update intellij-markdown to version 0.7.18. r=android-reviewers,android-build-system-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337813\n", "files": ["gradle/libs.versions.toml"], "git_node": "3bf2ecb6b391bc1c1a49233e47cec5dc4e4f1409", "git_parents": ["af71b4f7a3f6c76cedbff971e383fcce12d7ee38"], "node": "2cd64be3e8eb537ff6467209d3852c69e430716a", "parents": ["052ca2216a9729e3427def0011c7f4d345f4c5ba"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086843 - Update OkHttp to version 5.5.1. r=android-reviewers,android-build-system-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337814\n", "files": ["gradle/libs.versions.toml"], "git_node": "29f6ac5fa43eee28012440fae13feb3a5ac8d01d", "git_parents": ["3bf2ecb6b391bc1c1a49233e47cec5dc4e4f1409"], "node": "618c0abe9b89f3041a84f167f319e3a91f784a34", "parents": ["2cd64be3e8eb537ff6467209d3852c69e430716a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086843 - Update Google Play Services Base to version 18.11.1. r=android-reviewers,android-build-system-reviewers,adhingra\n\nIts POM now declares play-services-basement 18.12.0, which provides the methods whose absence caused the bug\n2081123 crash.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337815\n", "files": ["gradle/libs.versions.toml"], "git_node": "b7ec379e98794d638b5a1b496bbc6a1274df5ee1", "git_parents": ["29f6ac5fa43eee28012440fae13feb3a5ac8d01d"], "node": "ace871df175fb40db19d657531e55f2c7f9417ed", "parents": ["618c0abe9b89f3041a84f167f319e3a91f784a34"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086807: Remove dead maybeMatches path from RegExpSearcher r=spidermonkey-reviewers,dminor\n\nThere are no failure paths in the RegExpSearcher stub [after calling PrepareAndExecuteRegExp](https://searchfox.org/firefox-main/rev/be3847db4e2bcc52fa3f078b8b4a1ff167ad158f/js/src/jit/CodeGenerator.cpp#3461-3485), so this never does anything. ([Code coverage agrees that this path is never reached](https://searchfox.org/firefox-main/rev/be3847db4e2bcc52fa3f078b8b4a1ff167ad158f/js/src/builtin/RegExp.cpp#1764-1765).)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337759\n", "files": ["js/src/builtin/RegExp.cpp", "js/src/builtin/RegExp.h", "js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "bf75471716c53f2d8e94284f3d37ad6f209459d6", "git_parents": ["b7ec379e98794d638b5a1b496bbc6a1274df5ee1"], "node": "eef421b1b07dcef283eed7104fec4fe49b6bf736", "parents": ["ace871df175fb40db19d657531e55f2c7f9417ed"], "tags": []}], "date": 1793266800, "git_changesets": ["970947d891c69e24beae17b81fdbd5c0fbe1a50e", "6c4d3cb576dd03f7de2fd44ad6b5c156e86b4954", "85ae6d508e15eb5f1b10180460641d13c0061a8c", "cb6448b704e02d0532681e57f04ccf786c11de46", "a68d299052471ee02613486ec026ce5419f61de0", "12212c39255edcedc3da683e137e52dfbd6a5995", "a84050aa0b831927d75f1a15beb57124bbf2da26", "a1e938a941721eec19dbb672c00f896c422821a5", "1248a1a12e45ffe9e62ba88463e997ef55b25c2f", "3948cae0a53cbbfdbe1843a19424f447c363d090", "9e620062d103b2be6dcc52e09a476c2ca00af700", "b667ee35d20484ea408a734590c5abc15bfdbe74", "9bb4ba0f9bad1eed33a49922d238df0beff7b699", "df77073903dfa09b353aa8ab3251d6ab1dfc4c23", "3a9e56292be9406f980e110df353c4044d68981b", "237df3b7751f18044f9caa4dc5865eaf1a79a341", "e11d6dd7763495acd419b3856562745beb8ccada", "bad18dedcb17fd5298e8d16c6b6be282b534047f", "eaca62a85b604493b22d59fd7002b9282cb52d4f", "6961791f944d90d43b53ea4a68a376329aa53ff8", "c3652c3f36bd8227272f0cb3f0ed9dbcfb3f0214", "8c78d7de8c746ea80f7b29d205bcbd64a1803075", "b55dd2e6e857f9e9ce3e0174f6e295ba87706e9e", "4dd51cf65497638de6e6624624cc9c4698580488", "700c85484d9a0ac49a208412787f14ce0186f4ed", "c230f2cbe5715780b7debf3ce696a68718a95bf6", "d9f2b0dab7dcea452cc1341aa4dc8efcf1ef49bc", "1a642409a2