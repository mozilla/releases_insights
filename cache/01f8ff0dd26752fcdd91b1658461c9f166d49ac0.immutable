web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-textarea-003.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-textarea-004.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-button-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-button-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-button-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-button-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-fieldset-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-fieldset-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-fieldset-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-fieldset-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-input-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-input-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-input-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-input-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-005-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-select-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-select-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-select-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-select-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-textarea-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-textarea-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-textarea-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-textarea-004-ref.html"], "git_node": "baec7767d1fb47c6d98f73c25f008123b5a54e7e", "git_parents": ["f852d1e2ffdfcddfbb4900d8f026a0f90a50049f"], "node": "a71f25bec40a9fa7ff109e965d72b552d37b2c3c", "parents": ["c0628f23371aba9d22a12c2189324ca3e5e5ef2c"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069166 - Turn the text selection menu off when every action is turned off. r=fluent-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,nsharpley,emilio,bolsson\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nTurning off the last action in the three-dot menu now shows a notice, and the menu turns off when the three-dot menu closes. While it is off, a \"Turn On Actions Menu\" item in the context menu of a selection turns it back on with every action and shows it over the selection.\n\nTo try it manually: flip `browser.highlightToSearch.featureGate` on, select text on a page, open the three-dot menu and turn off every action. A notice appears. Click outside the three-dot menu and the menu goes away. Then select text again and right-click it to find \"Turn On Actions Menu\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335857\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/browser-context.js", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/nsContextMenu.sys.mjs", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/tests/browser/browser_chat_contextmenu.js", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/locales/en-US/browser/browserContext.ftl", "browser/locales/en-US/browser/genai.ftl", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "5da54dae22635fec4af31812f0a7d6fc6fee734d", "git_parents": ["baec7767d1fb47c6d98f73c25f008123b5a54e7e"], "node": "18b05923f61fcf783ff71bb3b97f4c9b63284e4e", "parents": ["a71f25bec40a9fa7ff109e965d72b552d37b2c3c"], "tags": []}, {"author": "Jonathan Mendez \u003cjmendez@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085036 - Include Carbon in SafeMode.h for its macOS key press check. r=mac-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336266\n", "files": ["toolkit/xre/SafeMode.h"], "git_node": "cf7dd2e9662799e24d0628ebb4efc3696f990dab", "git_parents": ["5da54dae22635fec4af31812f0a7d6fc6fee734d"], "node": "01f109ee952d9d3a23a8a6dcdc61cab79fd1ea5c", "parents": ["18b05923f61fcf783ff71bb3b97f4c9b63284e4e"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085898 - Update irregexp to 313f3ab0d6063f3e5af9eaf88fa1e1c66c94e222 r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336879\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h", "js/src/irregexp/moz.yaml"], "git_node": "d59f95074f7a01a70938719b3846930c40b43865", "git_parents": ["cf7dd2e9662799e24d0628ebb4efc3696f990dab"], "node": "91593d758020b081bf3d10f85e6756552b53ec14", "parents": ["01f109ee952d9d3a23a8a6dcdc61cab79fd1ea5c"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085898 - Apply mozilla patches for irregexp r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336880\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h"], "git_node": "2720001bbe17409bd5c02c65760409a11d5ca3f6", "git_parents": ["d59f95074f7a01a70938719b3846930c40b43865"], "node": "fcf5af2a6f73d8ebfba2e2ab30a2d57125d218ff", "parents": ["91593d758020b081bf3d10f85e6756552b53ec14"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085938 - Remove non-Firefox tp6 desktop tests. r=perftest-reviewers,sparky,taskgraph-reviewers,bhearsum\n\nNobody is actively tracking tp6 chrom* tests and they don't give us much\nvalue. Lots of them also record black screens intermittently, so they\njust burn CI time. This patch removes it with an estimated savings of\n~150 to 180 hours / month of hardware time\n\nAdditionally, dead safari tp6 config is also removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337265\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/tp6/desktop/browsertime-tp6.toml", "testing/raptor/raptor/tests/tp6/live/browsertime-live.toml", "testing/raptor/test/test_manifest.py"], "git_node": "6097d1e24893e8b81a1e2f879700c4a2949a91f2", "git_parents": ["2720001bbe17409bd5c02c65760409a11d5ca3f6"], "node": "6fa3c2cffe120a4cf38231bc960e3d5b31c20641", "parents": ["fcf5af2a6f73d8ebfba2e2ab30a2d57125d218ff"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084796 - Name the card security code after the card network. r=credential-management-reviewers,fluent-reviewers,dimi,bolsson\n\nCreditCard.getSecurityCodeL10nId() and formatSecurityCodeName() name the code\nthe way the card's network does (CVV for Visa, CVC for Mastercard, CID for\nAmerican Express, and \"Security code\" otherwise). The doorhanger card\ndetails, the autocomplete entry, the payment methods list and dialogs, and the\nedit dialog's field use it instead of a fixed abbreviation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336187\n", "files": ["browser/extensions/formautofill/content/autofillEditForms.mjs", "browser/extensions/formautofill/content/editCreditCard.xhtml", "browser/extensions/formautofill/content/manageDialog.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_editCreditCardDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_manageCreditCardsDialog_cvv.js", "browser/extensions/formautofill/test/browser/creditCard/browser_paymentsList_cvv.js", "browser/extensions/formautofill/test/unit/test_profileAutocompleteResult.js", "browser/locales/en-US/browser/preferences/formAutofill.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "python/l10n/fluent_migrations/bug_2084796_card_details.py", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl", "toolkit/locales/en-US/toolkit/payments/payments.ftl", "toolkit/modules/CreditCard.sys.mjs", "toolkit/modules/tests/xpcshell/test_CreditCard.js"], "git_node": "89dd9e24dd51adf7eca8d7777fbaf0992b96b018", "git_parents": ["6097d1e24893e8b81a1e2f879700c4a2949a91f2"], "node": "76293ba962abef886f4d2255c82736ec64363416", "parents": ["6fa3c2cffe120a4cf38231bc960e3d5b31c20641"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084803 - Update the card save doorhanger to the new security code design. r=credential-management-reviewers,fluent-reviewers,desktop-theme-reviewers,akulyk,flod,dimi\n\nWhen security codes are supported, the save doorhanger offers a toggle for\nsaving them in place of the checkbox. The description and card details follow\nthe toggle, so they only mention the security code when it will be saved. The\nupdate doorhanger keeps the checkbox for now. The lock icon of the card\ndoorhangers is now filled with the success color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336294\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "browser/themes/shared/formautofill-notification.css", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "5510b0632cccf585418abdb6e6e12540b0c0b19d", "git_parents": ["89dd9e24dd51adf7eca8d7777fbaf0992b96b018"], "node": "3cf420fb0aef37bfa91e2f517fa71184d33dbe98", "parents": ["76293ba962abef886f4d2255c82736ec64363416"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084805 - Update the card update doorhanger for updates that keep the security code. r=credential-management-reviewers,fluent-reviewers,flod,dimi\n\nWhen security codes are supported, the update doorhanger shows the plain\n\"Update payment method?\" content, without the security codes checkbox, and\nnotes the stored security code in the card details. A form submitted with an\nempty security code no longer clears the stored one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336295\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "500bde4130a1685a055c787b778d9a4660a4e076", "git_parents": ["5510b0632cccf585418abdb6e6e12540b0c0b19d"], "node": "8db4a1028c52c7cd1d196c29a25e822cf5979849", "parents": ["3cf420fb0aef37bfa91e2f517fa71184d33dbe98"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084804 - Update the card update doorhanger for a new or changed security code. r=credential-management-reviewers,fluent-reviewers,flod,dimi\n\nA saved card submitted with a new or changed security code gets a \"Save\nsecurity code?\" doorhanger with the security codes toggle. Turning the toggle\noff switches it to the plain update content in place, and updating then keeps\nthe stored security code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336296\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "git_node": "e7bc33cedec1d31f8a754aefef5be89be4c6ce88", "git_parents": ["500bde4130a1685a055c787b778d9a4660a4e076"], "node": "d84229ce4d2f691a9db9b0e844befa6022003253", "parents": ["8db4a1028c52c7cd1d196c29a25e822cf5979849"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084594 - Convert translation related regression UI tests and create new ones within the efficiency framework r=aaronmt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335966\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/TranslationsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/TranslationsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TranslationsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/BrowserRobot.kt"], "git_node": "f9dda0753e721b3189b43ac08fcf16a0eac49176", "git_parents": ["e7bc33cedec1d31f8a754aefef5be89be4c6ce88"], "node": "56d4320c48843f9c933f42cbdb7ef9b080238f48", "parents": ["d84229ce4d2f691a9db9b0e844befa6022003253"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082506: Fix ariaNotify on elements in shadow DOM. r=accessibility-platform-reviewers,eeejay\n\nPreviously, we used GetUncomposedDoc, which returns null for shadow DOM nodes.\nTo fix this, simply use GetComposedDoc instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336321\n", "files": ["accessible/base/nsAccessibilityService.cpp", "accessible/tests/browser/events/browser_announcement.js"], "git_node": "be3847db4e2bcc52fa3f078b8b4a1ff167ad158f", "git_parents": ["f9dda0753e721b3189b43ac08fcf16a0eac49176"], "node": "1edf73f82a27cbcb0f8fce36d3c6765c2d7c5f7d", "parents": ["56d4320c48843f9c933f42cbdb7ef9b080238f48"], "tags": []}], "date": 1793180938, "git_changesets": ["85e60c0aca4f0775711773b42349ced21fa99738", "c3f1372de02847d33a344689e33a70128b9e634a", "aba36eeda23862776ef38639539d8a9c5f57a5f2", "e141adc070277444f0d8131c75e43e77e8101f32", "81b3307b50923020ebdce062ca5b185f59c2c934", "68d4839b23c20e92211e0d5e5624b95ab677a106", "2747f1441ea197a2f5bed6eb9878b7d84e6b1dc8", "77a07c868b499605b25d5ac20f91ac42d2b69e4a", "730aa227a4f9f27cf1a32d4c235a1fb7ac395b02", "eeba0041cdb47d4b1bf8a37e5b18928b5f22681b", "900dcf2786947a5c252675e263e63f8c61c9e5d0", "d9aba54df3cb0aba6be0fe506ff4f5f89069f698", "2c85560ab00ae77d81e0a9abca93ed2077270861", "e65d6df4d50adb4aab28038039ac5bd425323c99", "a4eb1a57031a2133402ec2f11f0ffaea9691fc8c", "cd88671b01a16405f02fbd851ceb2c4bfd3bc6a5", "6f1be2eb72871a58ea82b2c0564c13f810ef71b6", "5bc1f0a1e7726a689a6ec91dcc97bfc3755d9b77", "e71b5f9f3dd3ebbf9c5ed88dc46d9ecb20258850", "dd26be37525d29ea82e6e2d7b32e6c2c6d13ee7c", "9b7c49f35d5249cb2154f34ac3c98652917c804c", "61a4da24aeead7a25d5e070cd58f46d70ee882a8", "ce1499c4cda027d29f1c0fcbec320a094b5a79eb", "e7b62ba98297e15a36a463ca69572dabed50afb7", "a9f26a0686e8e7d87c4067683d7dc79f96233605", "c23b742eb7b6846dece83d2147406b27b484a6c7", "1dedf71fd2b5d922d39998f27807728a8d5c3d87", "12b6441acc57d85dd9fe7646639341a299d1b8d2", "d9fddf1e36113d7c0f19a8fae9acd5a1cfa88178", "49e1e30165794495507745034a4d69885a64227e", "b4f138b2849ff8e8c24d1f5cf3cf861848f03322", "9342426be2939245e9bc072e2cb9d3b0afbdd055", "35a34962e86812702e0b7e19098f98e81f1b39ac", "f433b448e8251f3e707ba48d9b3947b20ad5d79f", "f39abf3f8ecafab4e6e7263eff38f02d4ea6199e", "e16a53883576f2f6c7cbf2bd37e1b84093d816d1", "7b75939485a14a9ddd698beefa46185f4b0dbdc2", "32d91c7937fb3d0c789dd909e81778445f65a44c", "13f9a166d2bec490ab2df56913d4d5219b