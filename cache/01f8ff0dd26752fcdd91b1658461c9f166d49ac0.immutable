129 - Cleanup additional preferences test that relies on SRD pref being false r=akulyk,settings-reviewers\"\n\nThis reverts commit afe8545a2c15608e3fc098f6af418a081af0f4e1.\n", "files": ["accessible/tests/browser/telemetry/browser_HCM_telemetry.js", "browser/base/content/test/browser-alerts/browser_notification_open_settings.js", "browser/base/content/test/browser-framebusting/browser_framebusting_notification.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_open_preferences.js", "browser/base/content/test/browser-sanitize/browser_sanitizeDialog_v2.js", "browser/base/content/test/browser-sanitize/head.js", "browser/components/aboutlogins/tests/browser/browser_osAuthDialog.js", "browser/components/asrouter/tests/browser/browser_trigger_listeners.js", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_app_auto_update.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_background_app_update.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_buttons.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_masterpassword.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_popup_blocker.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_popup_blocker_locked.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_profile_import.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_downloads.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_masterpassword.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_privatebrowsingmodeavailability.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_privatebrowsingmodeavailability_srd.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_sanitize_on_shutdown.js", "bro