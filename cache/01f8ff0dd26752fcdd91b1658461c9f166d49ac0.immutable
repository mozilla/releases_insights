itableClient.cpp", "gfx/layers/client/ImageClient.cpp", "gfx/layers/client/TextureClient.cpp", "gfx/layers/client/TextureClient.h", "gfx/layers/client/TextureClientRecycleAllocator.cpp", "gfx/layers/client/TextureRecorded.cpp"], "git_node": "e11c558e4f31208bf28d0110cea33590592adcdc", "git_parents": ["42d816565fcf410ef80392dbb614211b2e4d164d"], "node": "1d734b4f2eb57be5902a26d692efe16f116c8717", "parents": ["4d62be0fb3909a3f102ecdc853adc49305d4799f"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2081780 - Upgrade layers/composite assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333757\n", "files": ["gfx/layers/composite/GPUVideoTextureHost.cpp", "gfx/layers/composite/ImageComposite.cpp", "gfx/layers/composite/RemoteTextureHostWrapper.cpp", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/composite/TextureHost.h"], "git_node": "336321c3eb678390c7af587b24eed509db442818", "git_parents": ["e11c558e4f31208bf28d0110cea33590592adcdc"], "node": "f1f7f81f585e759fa5b3710dadca05db0460825c", "parents": ["1d734b4f2eb57be5902a26d692efe16f116c8717"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2081780: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/layers/apz/src/AsyncPanZoomController.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp"], "git_node": "c6fddb63e3cdbabd13f978b91d55ee9b6d096bda", "git_parents": ["336321c3eb678390c7af587b24eed509db442818"], "node": "651c5d4873f11854270c8f482d48d702ec35a599", "parents": ["f1f7f81f585e759fa5b3710dadca05db0460825c"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2066975. Make ComputeStickyOffsets() use GetScrollContainerForStickyFrame(). r=layout-scroll-driven-animation-reviewers,layout-reviewers,dshin\n\nBug 2018678 part 2 added GetScrollContainerForStickyFrame(), which\nGetOrCreateForFrame() and GetForFrame() use to find the scroll container\nfor a sticky frame, but left ComputeStickyOffsets() making its own\nGetNearestScrollContainerFrame() call. The only difference is that the\nhelper also passes SCROLLABLE_STOP_AT_PAGE, so this changes behaviour\nonly in print preview, where the lookup now stops at the page frame\ninstead of continuing up past it (which is what bug 1633045 added the\nflag for).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321764\n", "files": ["layout/generic/StickyScrollContainer.cpp"], "git_node": "06989e9d27452c23d3ea750a3314d4557ea10b87", "git_parents": ["c6fddb63e3cdbabd13f978b91d55ee9b6d096bda"], "node": "e4f2e0a9fdbdd0bd9a8c4d7259e78c95eabdb033", "parents": ["651c5d4873f11854270c8f482d48d702ec35a599"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081939: Avoid duplicating frames that escape repeating headers. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336318\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "6ee822ddd28e6e1c81e2b170743e63e3b5b08143", "git_parents": ["06989e9d27452c23d3ea750a3314d4557ea10b87"], "node": "e0f5d4917c72136199f663c253abf639e544768b", "parents": ["e4f2e0a9fdbdd0bd9a8c4d7259e78c95eabdb033"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081780: apply code formatting via Lando\" for causing bustage @ TextureClient.h\n\nThis reverts commit c6fddb63e3cdbabd13f978b91d55ee9b6d096bda.\n\nRevert \"Bug 2081780 - Upgrade layers/composite assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 336321c3eb678390c7af587b24eed509db442818.\n\nRevert \"Bug 2081780 - Upgrade layers/client assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit e11c558e4f31208bf28d0110cea33590592adcdc.\n\nRevert \"Bug 2081780 - Upgrade remaining gfx thread and process assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 42d816565fcf410ef80392dbb614211b2e4d164d.\n\nRevert \"Bug 2081780 - Upgrade gfx/ipc thread and process assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 6099c3f67c3208cd3eced671bbdd95ec8ab8af50.\n\nRevert \"Bug 2081780 - Upgrade thebes thread and process assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 96772a8c796e88d258b0e921b6448c9643200a62.\n\nRevert \"Bug 2081780 - Upgrade WebRender thread assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 239b013c44c045da7b3851d44a886f6c02ea780d.\n\nRevert \"Bug 2081780 - Upgrade remaining gfx/vr assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 6de0355ce40cd4e776357ca41f3d8e2aed037330.\n\nRevert \"Bug 2081780 - Upgrade more gfx/vr assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit f226e0ce1a48550e2842127ce66d4dd3e9149c82.\n\nRevert \"Bug 2081780 - Upgrade some gfx/vr assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 46d5b7d4b47d0a3a8930bc76facf860d62edb6e5.\n\nRevert \"Bug 2081780 - Upgrade VRManager assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit b3120b9942ec8d074e3b976a00df96b3f121f391.\n\nRevert \"Bug 2081780 - Fix contradictory assertion and upgrade shared memory checks to MOZ_RELEASE_ASSERT. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit 4ed68a8945f9d98ae0562aa7f8af04cba8d76e7b.\n\nRevert \"Bug 2081780 - Convert some resource assertions to MOZ_RELEASE_ASSERT (part 2). r=gfx-reviewers,bradwerth\"\n\nThis reverts commit d8cecc70e6066b78dadc0847de9d85f574eecbcb.\n\nRevert \"Bug 2081780 - Convert some  assertions to MOZ_RELEASE_ASSERT (part 1). r=gfx-reviewers,bradwerth\"\n\nThis reverts commit c0a1ae242007d6546c91a7e9c9e7c1a8fe7113b1.\n\nRevert \"Bug 2081780 - Upgrade layers/ipc thread and process assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\"\n\nThis reverts commit b83ccb49dc67ac65c799ee98ac4ccdf3c9c20fe8.\n\nRevert \"Bug 2081780 - Upgrade APZ thread assertions to MOZ_RELEASE_ASSERT. r=gfx-reviewers,hiro,bradwerth\"\n\nThis reverts commit 9d07f650bba6035a764e404efd11134fe52922a0.\n", "files": ["gfx/2d/ScaledFontDWrite.cpp", "gfx/config/gfxConfigManager.cpp", "gfx/config/gfxVars.cpp", "gfx/config/gfxVars.h", "gfx/ipc/CanvasManagerChild.cpp", "gfx/ipc/CanvasManagerParent.cpp", "gfx/ipc/CanvasRenderThread.cpp", "gfx/ipc/CanvasShutdownManager.cpp", "gfx/ipc/CompositorWidgetVsyncObserver.cpp", "gfx/ipc/GPUChild.cpp", "gfx/ipc/GPUParent.cpp", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/VsyncBridgeChild.cpp", "gfx/layers/AndroidHardwareBuffer.cpp", "gfx/layers/AndroidImageConsumer.cpp", "gfx/layers/AndroidImageReader.cpp", "gfx/layers/AnimationInfo.cpp", "gfx/layers/CompositeProcessFencesHolderMap.cpp", "gfx/layers/CompositorAnimationStorage.cpp", "gfx/layers/D3D11ZeroCopyTextureImage.cpp", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageContainer.h", "gfx/layers/NativeLayerRemoteMac.mm", "gfx/layers/RemoteTextureMap.cpp", "gfx/layers/SurfacePoolWayland.cpp", "gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/src/APZPublicUtils.cpp", "gfx/layers/apz/src/APZSampler.cpp", "gfx/layers/apz/src/APZUpdater.cpp", "gfx/layers/apz/src/AsyncPanZoomController.cpp", "gfx/layers/apz/src/FocusTarget.cpp", "gfx/layers/apz/util/APZCCallbackHelper.cpp", "gfx/layers/apz/util/APZThreadUtils.cpp", "gfx/layers/apz/util/CheckerboardReportService.cpp", "gfx/layers/apz/util/ChromeProcessController.cpp", "gfx/layers/apz/util/ScrollLinkedEffectDetector.cpp", "gfx/layers/client/CanvasClient.cpp", "gfx/layers/client/CompositableClient.cpp", "gfx/layers/client/ImageClient.cpp", "gfx/layers/client/TextureClient.cpp", "gfx/layers/client/TextureClient.h", "gfx/layers/client/TextureClientRecycleAllocator.