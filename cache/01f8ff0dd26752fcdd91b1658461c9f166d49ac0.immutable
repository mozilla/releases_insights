unified", "desc": "No bug - Tagging 579b0acf3f0ad29a689eae3dc55b0027797fc6b3 with FIREFOX-ANDROID_160_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a298262cb002fa4b4b281d098126ddbd09fc5882", "git_parents": ["b9b4f56f63d9ce8a5e47732a0e86b0ee43ce0591"], "node": "7747c6b0bd1d33131da5fab5cf6b319ba3bf5ac7", "parents": ["4a329ebb9ecbdb7c8fb8c5c3e6a92443ae4dbb8e"], "tags": []}], "date": 1793626369, "git_changesets": ["a298262cb002fa4b4b281d098126ddbd09fc5882"], "user": "ffxbld@lando.moz.tools"}, "45695": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 579b0acf3f0ad29a689eae3dc55b0027797fc6b3 with DEVEDITION_160_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9fcfea654bcf4a2bf1d0eb1c6e90782debf17498", "git_parents": ["a298262cb002fa4b4b281d098126ddbd09fc5882"], "node": "342a21d5ba27816495e6f13a7dd0b8fceb870a61", "parents": ["7747c6b0bd1d33131da5fab5cf6b319ba3bf5ac7"], "tags": []}], "date": 1793632990, "git_changesets": ["9fcfea654bcf4a2bf1d0eb1c6e90782debf17498"], "user": "ffxbld@lando.moz.tools"}, "45696": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 579b0acf3f0ad29a689eae3dc55b0027797fc6b3 with FIREFOX_160_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "fe17f7fac7269b2c43a28984866fced8f55efa00", "git_parents": ["9fcfea654bcf4a2bf1d0eb1c6e90782debf17498"], "node": "149b3a3b3b38c3334c1d731db1634047fbfbe3b6", "parents": ["342a21d5ba27816495e6f13a7dd0b8fceb870a61"], "tags": []}], "date": 1793637001, "git_changesets": ["fe17f7fac7269b2c43a28984866fced8f55efa00"], "user": "ffxbld@lando.moz.tools"}, "45697": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2087180: Adjust WPT select-appearance-hover.html to use a sans-serif font to avoid fuzzy mismatch. r=TYLin\n\nThis avoids a 1px fuzzy mismatch in some antialiasing fringe on the edge of a\nglyph's serif (presumably caused by the serif-antialiasing barely protruding\nbeyond the glyph's declared bounds -- that sort of protruding fringe might\nrender or not in different situations, depending on the exact painting path).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338489\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-appearance-hover-ref.html", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/select-appearance-hover.html"], "git_node": "970e600f7929d597f7301b2d123aaf4a9e08d7ff", "git_parents": ["28b7a7bffb5f82828143d9ad63839ad263b598be"], "node": "7da7108bd6eac1a21d512103b0d57997081dd56c", "parents": ["61d640c1e032fc5806189da57fa5a56c722bbdb3"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2087180: Use Ahem font in WPT exit-fullscreen-scroll-to-unscrollable-area-overflow-x-hidden.html, to avoid fuzzy mismatches in antialiased text. r=TYLin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338490\n", "files": ["testing/web-platform/meta/fullscreen/rendering/exit-fullscreen-scroll-to-unscrollable-area-overflow-x-hidden.html.ini", "testing/web-platform/tests/fullscreen/rendering/exit-fullscreen-scroll-to-unscrollable-area-overflow-x-hidden-ref.html", "testing/web-platform/tests/fullscreen/rendering/exit-fullscreen-scroll-to-unscrollable-area-overflow-x-hidden.html"], "git_node": "d77a26e6b6bd84589bbc3f652647e4982623dda0", "git_parents": ["970e600f7929d597f7301b2d123aaf4a9e08d7ff"], "node": "5dd2c14c6006562c3a53212adfaf38b513130056", "parents": ["7da7108bd6eac1a21d512103b0d57997081dd56c"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077760 - Don't transfer APZTestData to the new APZCTreeManager on layer tree adoption. r=tnikkel\n\nThe transfer was only kept to preserve the behavior from before bug 1441916,\nwhen the test data was stored per layers id in the compositor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330638\n", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp"], "git_node": "313edf711aa72c7e9b1c197e922a4b2eb6dd66d0", "git_parents": ["d77a26e6b6bd84589bbc3f652647e4982623dda0"], "node": "93cfcfa1e952ae21f432110977dae70137591512", "parents": ["5dd2c14c6006562c3a53212adfaf38b513130056"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087151 - Null mGroupInfo on replaced OriginInfo in LockedAddOriginInfo. r=dom-storage-reviewers,hsingh\n\nAlso fix the lookup to compare by origin string instead of pointer,\nconsistent with LockedGetOriginInfo and LockedRemoveOriginInfo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338088\n", "files": ["dom/quota/GroupInfo.cpp", "dom/quota/GroupInfo.h", "dom/quota/QuotaManager.h", "dom/quota/test/gtest/TestGroupInfo.cpp", "dom/quota/test/gtest/moz.build"], "git_node": "ba07a0d042d43d7d20edfa2eda509b4915b25bd4", "git_parents": ["313edf711aa72c7e9b1c197e922a4b2eb6dd66d0"], "node": "524bb68e46a162f9d6eb6339a85bdf4186671d31", "parents": ["93cfcfa1e952ae21f432110977dae70137591512"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034086: Make fileIds unknown on failed removals. r=dom-storage-reviewers,hsingh\n\nForeign key enforcement is enabled for every connection; the data\nmanager's connection already had it from InitializeConnection, but the\nquota client connections did not, so no cascade fired there.\n\nWhen the on-disk blob cannot be removed, the FileIds row is removed and\nthe usage released all the same, instead of keeping the row for an idle\nmaintenance which does not exist. Rows left behind by earlier versions,\nand temporary files of writable streams which a crash prevented from\nclosing, are removed when FileSystemDataManager opens the database;\nnothing can reference them at that point. The sweep is not done from\nFileSystemQuotaClient::InitOrigin because the quota manager skips client\ninitialization for origins restored from its cache, so InitOrigin does\nnot run on a normal startup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296312\n", "files": ["dom/fs/parent/datamodel/FileSystemDataManager.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManager.h", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion001.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion001.h", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.cpp", "dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.h", "dom/fs/test/gtest/parent/FileSystemParentTest.cpp", "dom/fs/test/gtest/parent/FileSystemParentTest.h", "dom/fs/test/gtest/parent/TestFileSystemOrphanCleanup.cpp", "dom/fs/test/gtest/parent/moz.build", "dom/fs/test/xpcshell/test_fileIdCarry.js", "dom/fs/test/xpcshell/test_orphanUsageCleanup.js", "dom/fs/test/xpcshell/xpcshell.toml"], "git_node": "5644d1997104574a66af6f62f3429c3a38981f6c", "git_parents": ["ba07a0d042d43d7d20edfa2eda509b4915b25bd4"], "node": "40f30ae08b468d693516899fc801a4f2d3f8037d", "parents": ["524bb68e46a162f9d6eb6339a85bdf4186671d31"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034086: Remove usage rows whose file id no longer exists. r=dom-storage-reviewers,hsingh\n\nUsages rows with no FileIds parent from the time before foreign key\nenforcement was enabled are removed in RemoveFileIdsWithoutMainFile\nwhich runs once per DataManager open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335192\n", "files": ["dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.cpp", "dom/fs/test/xpcshell/test_orphanUsageCleanup.js"], "git_node": "f1622f45913ff0a17101df144d6d188d031ac57f", "git_parents": ["5644d1997104574a66af6f62f3429c3a38981f6c"], "node": "addfa34472cfe57f07339e1dd3895a0fcb7be053", "parents": ["40f30ae08b468d693516899fc801a4f2d3f8037d"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034086 - Clean up orphan OPFS files during quota rescan and database open. r=dom-storage-reviewers,hsingh\n\nRemove orphan blobs before counting their usage so stale records cannot\ntrigger quota eviction. Share this cleanup with database open for origins\nwhose quota initialization used cached usage.\n\nDelete metadata only after successful blob removal, and retain failed\ncandidates and their usage for retry while continuing through the list.\nUpdate live quota accounting after committing each successful cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338089\n", "files": ["dom/fs/parent/datamodel/FileSystemDatabaseManagerVersion002.cpp", "dom/fs/test/xpcshell/test_orphanUsageCleanup.js", "dom/fs/test/xpcshell/xpcshell.toml"], "git_node": "e2fb7e45c72cea6e8ac9561106f10ae882da0fd2", "git_parents": ["f1622f45913ff0a17101df144d6d188d031ac57f"], "node": "6042d2d55e07a44e63d29a894e842e4efd81e603", "parents": ["addfa34472cfe57f07339e1dd3895a0fcb7be053"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078992 - Hold pending request-pacing events by strong reference. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332687\n", "files": ["netwerk/base/EventTokenBucket.cpp", "netwerk/base/EventTokenBucket.h", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": "e811450e7a58bd0bd6c4194acba96d57b4d1ad63", "git_parents": ["e2fb7e45c72cea6e8ac9561106f10ae882da0fd2"], "node": "5f987b8270cdda71c212eee8602fc5b159d61465", "parents": ["6042d2d55e07a44e63d29a894e842e4efd81e603"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2087151 - Null mGroupInfo on replaced OriginInfo in LockedAddOriginInfo. r=dom-storage-reviewers,hsingh\" for causing build bustages in TestGroupInfo.cpp.\n\nThis reverts commit ba07a0d042d43d7d20edfa2eda509b4915b25bd4.\n", "files": ["dom/quota/GroupInfo.cpp", "dom/quota/GroupInfo.h", "dom/quota/QuotaManager.h", "dom/quota/test/gtest/TestGroupInfo.cpp", "dom/quota/test/gtest/moz.build"], "git_node": "e8b5bdc1382386443222ff25b314effcd26428a8", "git_parents": ["e811450e7a58bd0bd6c4194acba96d57b4d1ad63"], "node": "d90173491feca6287069201b37068b84909eec61", "parents": ["5f987b8270cdda71c212eee8602fc5b159d61465"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 1: Use https in the importmap test with the navigation cache. r=allstarschh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334424\n", "files": ["dom/base/test/jsmodules/importmaps/mochitest.toml", "dom/base/test/jsmodules/mochitest.toml"], "git_node": "f399d7edf6d4f24b85d27d6ff3b4fc705ba131cf", "git_parents": ["e8b5bdc1382386443222ff25b314effcd26428a8"], "node": "34e5444d63e0e47012bd1f7ead069a462657d6f8", "parents": ["d90173491feca6287069201b37068b84909eec61"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2072077 - Part 3: Use HTTPS in the navigation-cache-related tests. r=bthrall,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334426\n", "files": ["dom/base/test/browser_script_loader_js_cache_module_preload.js", "dom/base/test/head.js", "netwerk/test/browser/browser_103_assets.js"], "git_node": "d8b2011c0eb0ccfad1619f44207557641e2c1141", "git_parents": ["f399d7edf6d4f24b85d27d6ff3b4fc705ba131cf"], "node": "7d0c5c692fa2c0924b480f0dfd84d5d4a3c12091", "parents": ["34e5444d63e0e47012bd1f7ead069a462657d