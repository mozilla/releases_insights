dccf77e0dc35d416148d6e55c708"], "node": "295131fdc599172132f19a780127182f2eb803ee", "parents": ["d25aa1fbeeb6a5bf7940932ca3375d42cde20da4"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072077 - Part 6: Add testcasw with HTTP. r=bthrall\" for causing bc failures @ browser_script_loader_js_cache_basic.js\n\nThis reverts commit 0c6cf3dc2b34a8b9f3533059494e777a118f1cf4.\n\nRevert \"Bug 2072077 - Part 5: Use the navigation cache only for HTTPS. r=bthrall\"\n\nThis reverts commit 2ddb5f7f88a5082cbd2f53b86f2e1a8cacc38e82.\n\nRevert \"Bug 2072077 - Part 4: Use HTTPS in the navigation-cache-related WebExtensions tests. r=robwu\"\n\nThis reverts commit 0318fd12a8a0761d1185350cf5c179419a8208f9.\n\nRevert \"Bug 2072077 - Part 3: Use HTTPS in the navigation-cache-related tests. r=bthrall,necko-reviewers,valentin\"\n\nThis reverts commit d8b2011c0eb0ccfad1619f44207557641e2c1141.\n\nRevert \"Bug 2072077 - Part 1: Use https in the importmap test with the navigation cache. r=allstarschh\"\n\nThis reverts commit f399d7edf6d4f24b85d27d6ff3b4fc705ba131cf.\n", "files": ["dom/base/test/browser_script_loader_js_cache_basic.js", "dom/base/test/browser_script_loader_js_cache_module_preload.js", "dom/base/test/head.js", "dom/base/test/jsmodules/importmaps/mochitest.toml", "dom/base/test/jsmodules/mochitest.toml", "dom/script/ScriptLoader.cpp", "netwerk/test/browser/browser_103_assets.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_cache.js", "toolkit/components/extensions/test/xpcshell/text_ext_webRequest_js_cache.js"], "git_node": "4262c1800630acc5d591ba8dd466c710d29b266d", "git_parents": ["1f4100eca4081c0e335047c83397023aab78eb9b"], "node": "f3d906516ae4bc4a22600de3c0525d8f9901eb51", "parents": ["295131fdc599172132f19a780127182f2eb803ee"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2087615 [Wayland] Align allocated wl_shm pool to page size r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338433\n", "files": ["widget/gtk/SHMBufSurface.cpp"], "git_node": "46b72140a33df474e32b8df00c2ccc12873c32bd", "git_parents": ["4262c1800630acc5d591ba8dd466c710d29b266d"], "node": "fb94d335c65594e2ada72997a5cf01c729fc7315", "parents": ["f3d906516ae4bc4a22600de3c0525d8f9901eb51"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082683 - Update the excluded dirs in path_performance r=firefox-build-system-reviewers,sergesanspaille\n\n`src` is no longer excluded, `firefox` matches any suffix, and\n`mozsrc`, `.mozbuild`, `.gradle` and `mozilla-build` are added.\nOnly `firefox*`, `mozilla-source` and `mozsrc` are suggested as\ncheckout locations.\n\nOn Linux, `firefox*` is excluded only in the home directory or at `/`,\nso `~/work/firefox` now gets the warning. On macOS, `/firefox*` is now\nexcluded too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334341\n", "files": ["python/mozbuild/mozbuild/path_performance.py", "python/mozbuild/mozbuild/test/test_path_performance.py"], "git_node": "f232be84797551aa19e1caf717bc9e6bc1078493", "git_parents": ["46b72140a33df474e32b8df00c2ccc12873c32bd"], "node": "c7d467f504471a4f35d72b4824b71da590bb0cca", "parents": ["fb94d335c65594e2ada72997a5cf01c729fc7315"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082683 - Check the state dir, objdir and MozillaBuild locations in path_performance r=firefox-build-system-reviewers,sergesanspaille\n\nEach location is suggested its own excluded dirs. The objdir is checked\nonly when `MOZ_OBJDIR` points outside the checkout. It is read through\nthe cached mozconfig every mach command loads, so the check adds no\noverhead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334342\n", "files": ["python/mozbuild/mozbuild/path_performance.py", "python/mozbuild/mozbuild/test/test_path_performance.py"], "git_node": "06cb0092193197c707fac71d3df68b0ab344c502", "git_parents": ["f232be84797551aa19e1caf717bc9e6bc1078493"], "node": "bb6c97aab762ef6612fa992f1fcf689d6831e681", "parents": ["c7d467f504471a4f35d72b4824b71da590bb0cca"], "tags": []}, {"author": "Vitaliy \u003cvitalij@gmx.com\u003e", "branch": "default", "desc": "Bug 2077169 - [devtools] Guard build-debugger.js against null match. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338065\n", "files": ["devtools/client/shared/build/build-debugger.js"], "git_node": "9802167109c82a68df86bded0c2b141208d761fd", "git_parents": ["06cb0092193197c707fac71d3df68b0ab344c502"], "node": "ac698bbb140f04a6cf11f96d6e79d311d329251d", "parents": ["bb6c97aab762ef6612fa992f1fcf689d6831e681"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2063652 - [devtools] Add test coverage for listing file with html entity in Local Mode. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319950\n", "files": ["devtools/shared/network-observer/test/browser/browser_networkobserver_localMode.js"], "git_node": "bee6ecf980b36de30641371c5e92b024d1460eee", "git_parents": ["9802167109c82a68df86bded0c2b141208d761fd"], "node": "aa8c38617324c8ad793f8a6458e241025dc75cf9", "parents": ["ac698bbb140f04a6cf11f96d6e79d311d329251d"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086505 - Only expose web custom formats to readers that are same-origin with the clipboard data unless clipboard.readCrossOriginCustomFormats.enabled is set. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337635\n", "files": ["dom/events/test/clipboard/browser.toml", "dom/events/test/clipboard/browser_navigator_clipboard_read_custom_format_origin.js", "modules/libpref/init/StaticPrefList.yaml", 