a/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/listentopage/ListenToPageTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/listentopage/ListenToPageTelemetryMiddlewareTest.kt"], "git_node": "1744250c7ab2c778288edd3d95588e546deabdd2", "git_parents": ["8744e29bad79970df1f1537fe9aae807bbb87fac"], "node": "23300d75f0de9045718896d39542b30c48b0b18c", "parents": ["90d1be04e1ba5b08d6f0ca8707e79d8a3b5202b9"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2086662 - continue showing reader mode even if L2P is disabled r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338168\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ListenSheetIntegration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ReaderModePanel.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/listentopage/ListenSheetIntegrationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/listentopage/ReaderModePanelTest.kt"], "git_node": "6c1c1228993b4afc607a806ef4e4275a4a25e318", "git_parents": ["1744250c7ab2c778288edd3d95588e546deabdd2"], "node": "d1e814fb8a9c9dc2b38b1c48273d462d74f0ec58", "parents": ["23300d75f0de9045718896d39542b30c48b0b18c"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2088146 - Update and re-enable media control focus tests in accessible/tests/mochitest/actions/test_media.html r=accessibility-platform-reviewers,morgan\" for causing failure @ test_media.html\n\nThis reverts commit 3d20e13447e995d9127067a17480b549d91464bd.\n", "files": ["accessible/tests/mochitest/actions/test_media.html"], "git_node": "81bddd92b987d7a3f02891ae8a48f749ffd4b9bc", "git_parents": ["6c1c1228993b4afc607a806ef4e4275a4a25e318"], "node": "f5d45e97c5985f1b43d9e5015b10c7077cf975b3", "parents": ["d1e814fb8a9c9dc2b38b1c48273d462d74f0ec58"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051240 - Add reflow plumbing for trimming block-axis margins r=layout-reviewers,dshin\n\nTrim requests come from the parent formatting context, so they must be passed explicitly when constructing a child's reflow input.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326878\n", "files": ["layout/generic/ReflowInput.cpp", "layout/generic/ReflowInput.h"], "git_node": "7578c118d608d0efce1a969442c2fc36126cc577", "git_parents": ["81bddd92b987d7a3f02891ae8a48f749ffd4b9bc"], "node": "39544c878c4dd929e5b648f0e4dccefe23a43a59", "parents": ["f5d45e97c5985f1b43d9e5015b10c7077cf975b3"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051240 - Implement basic margin-trim for block containers r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326879\n", "files": ["layout/generic/BlockReflowState.cpp", "layout/generic/BlockReflowState.h", "layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h", "layout/style/nsComputedDOMStyle.cpp", "layout/style/nsComputedDOMStyle.h", "layout/style/nsStyleStruct.cpp", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-001.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-002.html.ini", "testing/web-platform/meta/css