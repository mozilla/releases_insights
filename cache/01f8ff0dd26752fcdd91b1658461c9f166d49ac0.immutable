-platform/tests/css/css-box/margin-trim/block-container-block-end-propagation-boundaries.html"], "git_node": "e8a0be3071607266abdaf5ff829e2478c435a463", "git_parents": ["1d735ad37075959d8b5c021e55df24910040ba33"], "node": "ca04c2897b12e119a9d12456715192211d822c7a", "parents": ["38d5a3cb4d8a15f854b1200cc9ca4b5d261a6e94"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051240 - Enable layout.css.margin-trim.enabled by default on nightly. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336750\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "4efa94612117c21416a4d60a29cce925bb522dc0", "git_parents": ["e8a0be3071607266abdaf5ff829e2478c435a463"], "node": "5f73c21f819a399c1dbaa7b74e074dcc5f62f95f", "parents": ["ca04c2897b12e119a9d12456715192211d822c7a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975505 - Part 1 - Let `read_manifest` evaluate a `components.conf` against a given build config r=xpcom-reviewers,nika\n\nPart 4 evaluates every `components.conf` against a Windows, a macOS and\na Linux stand in config, so that the TypeScript services typelib does\nnot depend on the platform it is generated on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334776\n", "files": ["xpcom/components/gen_static_components.py", "xpcom/components/test/test_gen_static_components.py"], "git_node": "b49f335abacead8297b851dd4a1fda762052c1cd", "git_parents": ["4efa94612117c21416a4d60a29cce925bb522dc0"], "node": "82f8621e4273f144046a9ca213f7423b65e89993", "parents": ["5f73c21f819a399c1dbaa7b74e074dcc5f62f95f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975505 - Part 2 - Add `Repository.get_tracked_files` to list tracked files by pattern r=ahal\n\nFiltering the output of `get_tracked_files_finder` in Python is slow, so\n`get_tracked_files` passes the patterns to git, Mercurial or jj and lets\nthem filter. Patterns can only use `*` and `**` and can't contain `\\` or\n`\"`, since those are all the three pattern syntaxes read the same way.\nFiles deleted from the working directory are left out, as a jj listing\nalready does, because a caller would fail to read them. Part 6 uses it\nfor the TypeScript typelib inputs.\n\n`HgRepository._run` now honors `return_codes` while the command server is\nrunning, so a pattern that matches nothing returns an empty list there too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334777\n", "files": ["python/mozversioncontrol/mozversioncontrol/repo/base.py", "python/mozversioncontrol/mozversioncontrol/repo/git.py", "python/mozversioncontrol/mozversioncontrol/repo/jj.py", "python/mozversioncontrol/mozversioncontrol/repo/mercurial.py", "python/mozversioncontrol/test/python.toml", "python/mozversioncontrol/test/test_get_tracked_files.py"], "git_node": "4d97a1fab46463fe3ed5bc4ed99f6602558346d9", "git_parents": ["b49f335abacead8297b851dd4a1fda762052c1cd"], "node": "2e61787c2b63f69eda4cbb394b22ccee2891c128", "parents": ["82f8621e4273f144046a9ca213f7423b65e89993"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2085988 - Add X1/X2 buttons to MouseInput. r=masayuki\n\n`MouseInput` doesn't have X1 and X2 button defines yet. This will be\nnecessary for Android. Android's mouse widget event is generated from\n`MouseInput`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336974\n", "files": ["widget/InputData.cpp", "widget/InputData.h"], "git_node": "60d2d5d05de6adb753ddc3d11b245a16b3d7c826", "git_parents": ["4d97a1fab46463fe3ed5bc4ed99f6602558346d9"], "node": "db78d619d741daceab1337260c5291a249f7c8f3", "parents": ["2e61787c2b63f69eda4cbb394b22ccee2891c128"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082975 - Remove unused static-analysis mozconfigs r=glandium\n\nThe reference were removed in Bug 1486554\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334606\n", "files": ["browser/config/mozconfigs/linux64/debug-static-analysis-clang", "browser/config/mozconfigs/macosx64/debug-static-analysis", "browser/config/mozconfigs/macosx64/opt-static-analysis", "browser/config/mozconfigs/win32/debug-static-analysis"], "git_node": "c2b6d5940ba3779a0337ec51afd378a8faa2f32b", "git_parents": ["60d2d5d05de6adb753ddc3d11b245a16b3d7c826"], "node": "940c4511b583ed26f39623083558dea1f016b6c5", "parents": ["db78d619d741daceab1337260c5291a249f7c8f3"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1332891 - Replace misuse of std::forward by std::move in image/ r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335949\n", "files": ["image/DecoderFactory.cpp"], "git_node": "79d72bb377aeae0cafe223ff64f5453fda4d3d57", "git_parents": ["c2b6d5940ba3779a0337ec51afd378a8faa2f32b"], "node": "a0b47a1f3322309605717838916c0a6d535375f0", "parents": ["940c4511b583ed26f39623083558dea1f016b6c5"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2051240 - Enable layout.css.margin-trim.enabled by default on nightly. r=layout-reviewers,dshin\" for causing failures complaining about margin-trim.\n\nThis reverts commit 4efa94612117c21416a4d60a29cce925bb522dc0.\n\nRevert \"Bug 2051240 - Trim margins from nested blocks at the block-end edge. r=layout-reviewers,dshin\"\n\nThis reverts commit e8a0be3071607266abdaf5ff829e2478c435a463.\n\nRevert \"Bug 2051240 - Trim both margins of empty blocks at the trimmed edge. r=layout-reviewers,dshin\"\n\nThis reverts commit 1d735ad37075959d8b5c021e55df24910040ba33.\n\nRevert \"Bug 2051240 - Account for margin-trim from nested blocks that merge with the first child's margin. r=layout-reviewers,dshin\"\n\nThis reverts commit 154ddf6302dfa8d0cd7ac6368a0c68462a18e894.\n\nRevert \"Bug 2051240 - Implement basic margin-trim for block containers r=layout-reviewers,firefox-style-system-reviewers,dshin\"\n\nThis reverts commit ee55152ad1fb33c75faaaab6b8632a0a97bc3467.\n\nRevert \"Bug 2051240 - Add reflow plumbing for trimming block-axis margins r=layout-reviewers,dshin\"\n\nThis reverts commit f66c63e377ae3d1c4296f8a7d611aba6918d0d00.\n", "files": ["layout/generic/BlockReflowState.cpp", "layout/generic/BlockReflowState.h", "layout/generic/ReflowInput.cpp", "layout/generic/ReflowInput.h", "layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h", "layout/generic/nsBlockReflowContext.cpp", "layout/generic/nsBlockReflowContext.h", "layout/generic/test/mochitest.toml", "layout/generic/test/test_margin_trim_interrupt.html", "layout/style/nsComputedDOMStyle.cpp", "layout/style/nsComputedDOMStyle.h", "layout/style/nsStyleStruct.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-001.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-002.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-001.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-002.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-collapsed-margins.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-last-child-with-border.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-nested-last-child-with-border.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-self-collapsing-and-border.html.ini", "testing/web-platform/meta/css/css-box/margin-trim/block-container-block-end-self-collapsing-block-start-margin-nested.html.ini", "testing/web-platform/meta/css/css-box/ma