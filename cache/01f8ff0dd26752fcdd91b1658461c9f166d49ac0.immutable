t/java/org/mozilla/fenix/print/PrintMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/SettingsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/deletebrowsingdata/QuitMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/logins/PasswordsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/shortcut/AddToHomeScreenMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/summarization/SummarizePageMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/translations/TranslationsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/ReportBrokenSiteMenuItemProviderTest.kt"], "git_node": "85d4f7fc16f7bbe556ba1260e67abafb9fb4b1d5", "git_parents": ["09705d376141680f67a0f75df5aa1b95d571d975"], "node": "34b6575d52deea730a969f1687a0d90ec6617c06", "parents": ["0d11d9920c14e962cb722a80794d96cc59ff2838"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070583 - part 2 - Show the custom tab menu items added by apps in the customizable menu r=android-reviewers,giorga\n\nThe legacy custom tab menu shows them so the customizable menu needs to as well before replacing it.\nSee https://developer.chrome.com/docs/android/custom-tabs/guide-interactivity#add_custom_menu_items.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337476\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuConfigurations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactory.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/customtabs/CustomTabAppMenuItemProvider.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactoryTest.kt"], "git_node": "8b8d69f17d52f34366af8c6e2deb801b53a424a8", "git_parents": ["85d4f7fc16f7bbe556ba1260e67abafb9fb4b1d5"], "node": "88f3c681955ef5403b19dd33630e5fd1edd29e8f", "parents": ["34b6575d52deea730a969f1687a0d90ec6617c06"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086153 - part 1 - Keep the menu header out of its scrolling list r=android-reviewers,giorga\n\nA focused item in a LazyColumn sticky header could keep Compose busy indefinitely.\nOpening the menu focuses its first enabled header item so UI tests could have\ntimed out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337477\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/Menu.kt"], "git_node": "d487cb7d52f014d100ed054ffd52606a176de532", "git_parents": ["8b8d69f17d52f34366af8c6e2deb801b53a424a8"], "node": "c2d7ad4d14cafb67a06f87488ae131ccedfa5006", "parents": ["88f3c681955ef5403b19dd33630e5fd1edd29e8f"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086153 - part 2 - Let the customizable menu ride the trains r=android-reviewers,giorga\n\nThis is the same main menu built on a different API.\nMenu section or menu items customization support will be added later.\nCleaning up the legacy menu code will happen separately, later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337164\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "033d5bca23e33d9a9079616047335d884dfecca4", "git_parents": ["d487cb7d52f014d100ed054ffd52606a176de532"], "node": "ecaa24b3fa0cb2dd393f5070f87c120702cf46df", "parents": ["c2d7ad4d14cafb67a06f87488ae131ccedfa5006"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086153 - part 3 - Adapt legacy UI tests r=android-reviewers,mobiletest-reviewers,giorga,aaronmt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337224\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/ExpandableHeaderItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItemCommon.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/CustomTabRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuAddonsManagerRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/ThreeDotMenuMainRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuTestTag.kt"], "git_node": "4be23b2d7bf7433720f1427ac11c2881c33177b7", "git_parents": ["033d5bca23e33d9a9079616047335d884dfecca4"], "node": "a26a2f1e8dfb13be79420cb661c9fdb6b47e37d8", "parents": ["ecaa24b3fa0cb2dd393f5070f87c120702cf46df"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2086153 - part 4 - Adapt efficiency UI tests r=android-reviewers,mobiletest-reviewers,jajohnson,giorga\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337225\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Locator.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Resolvers.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/Selector.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/MainMenuPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAddonsManagerPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/CustomTabsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsAddonsTest.kt"], "git_node": "e3b8b34c6731f5e6da72a23756462564b129f315", "git_parents": ["4be23b2d7bf7433720f1427ac11c2881c33177b7"], "node": "e9e4b846e2b44f281c18e48201458950375c5cfd", "parents": ["a26a2f1e8dfb13be79420cb661c9fdb6b47e37d8"], "tags": []}, {"author": "Jonathan Leritte \u003cjleritte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086220 - Only show a focus ring on the clear browsing data dialog's initial focus when it was opened with the keyboard. r=manuel,accessibility-platform-reviewers,morgan\n\nThe dialog starts with focus on the time range dropdown, whose focus ring made the space below it look smaller than in the design. Its focus handler now follows SubDialog's focusVisible, so the ring only shows when the dialog was opened with the keyboard (and as soon as the user moves focus with it).\n\nSanitizer.showUI takes a triggeringEvent option, which it passes on to gDialogBox. The Clear recent history command passes its event. So does the fire button: the command event of its Choose\u2026 link, or in the direct flow the event that activated the button, kept from onBeforeCommand since ViewShowing doesn't carry it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335816\n", "files": ["browser/base/content/browser-sets.js", "browser/base/content/sanitizeDialog.js", "browser/base/content/test/browser-sanitize/browser_sanitizeDialog_v2.js", "browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/test/browserFireButton.toml", "browser/components/customizableui/test/browser_fireButton.js", "browser/components/customizableui/test/browser_fireButton_focusRing.js", "browser/modules/Sanitizer.sys.mjs"], "git_node": "b3d339ed6ea42185fbb7e2816f08de8db0480535", "git_parents": ["e3b8b34c6731f5e6da72a23756462564b129f315"], "node": "b277716fe868bdd68b0cc33f7884fa34a1b887f3", "parents": ["e9e4b846e2b44f281c18e48201458950375c5cfd"], "tags": []}, {"author": "Nora Liu \u003cnliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083977 - Inline negative number literal class field initializers r=spidermonkey-reviewers,mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335795\n", "files": ["js/src/frontend/Parser.cpp", "js/src/frontend/Parser.h"], "git_node": "6371575d3e174dd574216df8c8be295b0f764e24", "git_parents": ["b3d339ed6ea42185fbb7e2816f08de8db0480535"], "node": "6d4ab008a6ec98d4e355729bccf2cfbd034b9be2", "parents": ["b277716fe868bdd68b0cc33f7884fa34a1b887f3"], "tags": []}, {"author": "Kalen Lu \u003cklu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086210 - Add telemetry to count the number of saved cards and saved cards with a security code on every metrics ping. r=dimi,mtigley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337280\n", "files": ["browser/components/BrowserComponents.manifest", "browser/extensions/formautofill/test/unit/test_savedCreditCardCounts.js", "browser/extensions/formautofill/test/unit/xpcshell.toml", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/formautofill/FormAutofillStorageBase.sys.mjs", "toolkit/components/formautofill/RustAutofillCreditCardStorage.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "d59cd927b186e29ce7588a8553ff023bb12d8674", "git_parents": ["6371575d3e174dd574216df8c8be295b0f764e24"], "node": "25a183b06a0c9c49348e3d0d91b5f447b21b7372", "parents": ["6d4ab008a6ec98d4e355729bccf2cfbd034b9be2"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087048 - Create a new verifyTheExpandedToolbarNavigationThroughThePagesInTheSameTabTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337968\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsCustomizeExpandedToolbarTest.kt"], "git_node": "f274aa6d2cc4f2478ee628683d56f1756ce519a2", "git_parents": ["d59cd927b186e29ce7588a8553ff023bb12d8674"], "node": "7231cd382ffecefad6728e5edba17270c7b44382", "parents": ["25a183b06a0c9c49348e3d0d91b5f447b21b7372"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2081830 - Adding an android automotive OS specific biometric/pin setup prompt r=camilapedraza,sfamisa\n\nAdds AutomotiveAuthenticationSetupPrompt, a blocking dialog shown on Android Automotive OS when the user has no device lock and tries to access sensitive data (saved passwords, payment methods, account sign-in).\n\nUnlike the existing device lock warnings, it has no \"Later\" option and stores no \"already shown\" state. The user can't continue without a lock, and the prompt can appear every time.\n\n- Set up now opens the device security settings. When the user comes back, the prompt checks KeyguardManager.isKeyguardSecure. It calls onSetUp only if a lock was actually set up, and onCancel otherwise.\n- Cancel, dismissing the dialog, or the security settings failing to open all call onCancel.\n- The prompt detects the return from Settings by watching the activity's lifecycle (a pause followed by a resume). It doesn't use an activity result because some Settings activities return a result immediately.\n\nThis patch adds the prompt, its strings and unit tests. Nothing calls it yet.\n\nTry: https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=109953\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/410\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/biometric/AutomotiveAuthenticationSetupPrompt.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/biometric/AutomotiveAuthenticationSetupPromptTest.kt"], "git_node": "f3841e35ccc6ef9c06dde9566273cd5ab9ee026e", "git_parents": ["f274aa6d2cc4f2478ee628683d56f1756ce519a2"], "node": "a758bde0c7d21d46710c19b160a3b42226f64cdb", "parents": ["7231cd382ffecefad6728e5edba17270c7b44382"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085828 - Part 1: Store the selections of an nsFrameSelection in a mozilla::Array. r=dom-core-reviewers,layout-reviewers,emilio,avandolder\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336821\n", "files": ["layout/generic/nsFrameSelection.h"], "git_node": "4386b5eddf44e3640e90867f15724d3d73de9b3d", "git_parents": ["f3841e35ccc6ef9c06dde9566273cd5ab9ee026e"], "node": "be8efe3ec2faa947476df0f9dbdc9d015e8af997", "parents": ["a758bde0c7d21d46710c19b160a3b42226f64cdb"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085828 - Part 2: Create the non-normal selections of an nsFrameSelection lazily. r=dom-core-reviewers,layout-reviewers,emilio,avandolder\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336822\n", "files": ["accessible/base/TextLeafRange.cpp", "dom/base/nsISelectionController.idl", "dom/html/TextControlState.cpp", "editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditor.cpp", "layout/base/PresShell.cpp", "layout/base/PresShell.h", "layout/generic/nsFrameSelection.cpp", "layout/generic/nsFrameSelection.h", "layout/generic/nsTextPaintStyle.cpp"], "git_node": "61bcd8dce8278e9fc2742c1ab3a68a326afdb423", "git_parents": ["4386b5eddf44e3640e90867f15724d3d73de9b3d"], "node": "d2b4bbe8fdac320ad16544dc3af6ef394a39df25", "parents": ["be8efe3ec2faa947476df0f9dbdc9d015e8af997"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085043 - Make LightweightThemeConsumer pref getters global r=Gijs,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336210\n", "files": ["toolkit/modules/LightweightThemeConsumer.sys.mjs"], "git_node": "ffce8f675f29d390df88635c502e3f09ac11975f", "git_parents": ["61bcd8dce8278e9fc2742c1ab3a68a326afdb423"], "node": "4e8cd1183a85e7615bf3cb5d98600fb41bfe7786", "parents": ["d2b4bbe8fdac320ad16544dc3af6ef394a39df25"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083889 - Do not show the text selection menu on sites that show their own selection menu. r=search-reviewers,flozia,daleharvey\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nAdds `browser.highlightToSearch.ignoredSites`, a list of sites where the menu is not shown, which Nimbus can set through the `search` feature. A site also matches its subdomains, and the list only applies while `browser.highlightToSearch.featureGate` is on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335405\n", "files": ["browser/app/profile/firefox.js", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIParent.sys.mjs", "browser/components/genai/tests/browser/browser_chat_nimbus.js", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "5d92fc77d137b6bca2826e7ffc79e0eb7f09a6cb", "git_parents": ["ffce8f675f29d390df88635c502e3f09ac11975f"], "node": "36469ccf9513756fe84bbd77491cce1501bbb13e", "parents": ["4e8cd1183a85e7615bf3cb5d98600fb41bfe7786"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083734 - Only install visual metrics packages in the raptor virtualenv when visual metrics run. r=perftest-reviewers,kshampur\n\nMost browsertime tasks don't compute visual metrics, but every run installed\nnumpy, Pillow, scipy, opencv-python and pyssim, which Android hardware\ndownloads each time.\n\nRaptor's geometric mean used scipy, so it now uses the statistics module,\nkeeping scipy's results for empty, negative and zero input.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335141\n", "files": ["testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/mozharness/test/test_mozilla_raptor.py", "testing/raptor/raptor/filters.py", "testing/raptor/test/python.toml", "testing/raptor/test/test_filters.py"], "git_node": "d5936f36003a6537506ff3e506eef012d6d92d7f", "git_parents": ["5d92fc77d137b6bca2826e7ffc79e0eb7f09a6cb"], "node": "dcdaed87a50244e5d567f6e7a3c884c690c85266", "parents": ["36469ccf9513756fe84bbd77491cce1501bbb13e"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086710 - Stop sending widgets container telemetry for the automatic widgets collapse. r=fchasen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337657\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx"], "git_node": "f84004143704064c714c23dfe417d3aca8d4acf8", "git_parents": ["d5936f36003a6537506ff3e506eef012d6d92d7f"], "node": "ea78a0913fa983a9064fef83dd2db97140b47c85", "parents": ["dcdaed87a50244e5d567f6e7a3c884c690c85266"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991959 - Implement NavigationTransition.to. r=sfarre,webidl,edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338002\n", "files": ["dom/base/UseCounters.conf", "dom/base/use_counter_metrics.yaml", "dom/navigation/Navigation.cpp", "dom/navigation/NavigationTransition.cpp", "dom/navigation/NavigationTransition.h", "dom/webidl/NavigationTransition.webidl", "testing/web-platform/meta/html/dom/idlharness.https.html.ini", "testing/web-platform/meta/navigation-api/ordering-and-transition/transition-to.html.ini"], "git_node": "822d00b41f3bbebbcf11f32d1ddc6d69bf2a16d5", "git_parents": ["f84004143704064c714c23dfe417d3aca8d4acf8"], "node": "153b5e3b910261553318a2e3761ab659b17f3420", "parents": ["ea78a0913fa983a9064fef83dd2db97140b47c85"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087078 - Remove the fission variant from the perf selector. r=perftest-reviewers,sparky\n\nSince we removed the no-fission Android perf tasks, the perf selector's default 'nofis negation left some Android Fenix/GeckoView categories empty, fails to push tasks, fails and exits.\n\nFission is now the only Android configuration, so the variant and all no-fission mentions are removed from mach try perf, its tests and its docs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338000\n", "files": ["testing/perfdocs/generated/mach-try-perf.md", "testing/performance/mach-try-perf/perfdocs/index.md", "tools/tryselect/selectors/perfselector/classification.py", "tools/tryselect/test/full-task-graph-perf-test.json", "tools/tryselect/test/test_perf.py"], "git_node": "ba23266aed46dc1d7ebdbe75c11807a952ce4b19", "git_parents": ["822d00b41f3bbebbcf11f32d1ddc6d69bf2a16d5"], "node": "7e3e47adcda3fe421897abb04d6a9ba7d6b6d741", "parents": ["153b5e3b910261553318a2e3761ab659b17f3420"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083889 - Do not show the text selection menu when the page shows its own menu next to the selection. r=search-reviewers,flozia,daleharvey\n\nFor background on the Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo manually experiment with this feature, here is [[ https://searchux.netlify.app/highlight-to-search/ | the UX prototype ]].\n\nWatches for a floating element the page shows next to the selection from shortly before the mouse is released, and does not show the menu, or hides it, when it finds one. It is controlled by `browser.highlightToSearch.detectPageMenus`, which Nimbus can set through the `search` feature, and it records `selection_menu.suppressed` with the reason, as the site list does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335446\n", "files": ["browser/app/profile/firefox.js", "browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/metrics.yaml", "browser/components/genai/tests/browser/browser.toml", "browser/components/genai/tests/browser/browser_chat_nimbus.js", "browser/components/genai/tests/browser/browser_chat_page_menus.js", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/components/genai/tests/browser/head.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "d58776bab0f1a6c5f7ee890b450ffd611bc41d78", "git_parents": ["ba23266aed46dc1d7ebdbe75c11807a952ce4b19"], "node": "8373eb545f08938a5a03fe9f16f9a6cef017db01", "parents": ["7e3e47adcda3fe421897abb04d6a9ba7d6b6d741"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2087050 - Create a new verifyTheSimpleToolbarLayoutSummarizePageShortcutOptionTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337972\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsCustomizeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsCustomizeSimpleToolbarTest.kt"], "git_node": "3fd6003807e41692a67cf8ea15f2f1dd50e22f62", "git_parents": ["d58776bab0f1a6c5f7ee890b450ffd611bc41d78"], "node": "5a71b360c0acb7280742a0c38e8b8d3d4f32b529", "parents": ["8373eb545f08938a5a03fe9f16f9a6cef017db01"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2084923 - Get CE Registry from scope if Doc had default view r=dom-core-reviewers,vhilla\n\nCurrently we use `GetInnerWindow()` to get the documents CustomElementRegistry,\nbut this returns `null` for disconnected documents, so we should use\n`GetScopeObject()` instead. However for `document.implementation` we need to\nreturn `null`, so we guard this against `mHasHadDefaultView` to ensure only\ndocuments that were once connected return a registry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336259\n", "files": ["dom/base/CustomElementRegistry.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/base/DocumentOrShadowRoot.cpp", "testing/web-platform/meta/custom-elements/registries/Document-customElementRegistry.html.ini", "testing/web-platform/tests/custom-elements/registries/initial-about-blank.window.js"], "git_node": "94a40a33c609dac49d5f996a064cf4fccc55898b", "git_parents": ["3fd6003807e41692a67cf8ea15f2f1dd50e22f62"], "node": "f3db91cfec776d88d8c038f2ff8d2f1e457f1a41", "parents": ["5a71b360c0acb7280742a0c38e8b8d3d4f32b529"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082653 - Add responsive background handling to the HNT card stack r=nbarrett,fterdal,omc-reviewers,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336069\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "aac040bc0db9cebd56e3dd1a4c43b004e68e9399", "git_parents": ["94a40a33c609dac49d5f996a064cf4fccc55898b"], "node": "e49d0d633bb983e486e3418fe12c0304c973515f", "parents": ["f3db91cfec776d88d8c038f2ff8d2f1e457f1a41"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068340 - Test XML custom element construction timing r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327442\n", "files": ["testing/web-platform/tests/custom-elements/parser/xml-fragment-parser-does-not-construct-synchronously.xhtml"], "git_node": "edc415c9335d0a415854f9336a2644196e3b8062", "git_parents": ["aac040bc0db9cebd56e3dd1a4c43b004e68e9399"], "node": "c2855466ca2c37532c4028c678788ed9284148d0", "parents": ["e49d0d633bb983e486e3418fe12c0304c973515f"], "tags": []}, {"author": "Jim Thomas \u003cjithomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084247 - Add a sticky option to location-based inferred interests. r=mconley,rrando\n\n[HNT-3535]\n\nAdds `sticky` to the locationInitInferred trainhop config. With sticky on,\na client that starts on location-based interests (no content clicks at the\nfirst interest vector update) keeps using them after it starts clicking,\ninstead of switching to its engagement-based interests. Clients that already\nhad clicks never start on location. Off unless the experiment sets it, so\nthe existing location_init behavior is unchanged.\n\nThis lets the location_init_inferred experiment compare location-only\nranking against inferred personalization over the full experiment window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335661\n", "files": ["browser/extensions/newtab/lib/InferredPersonalizationFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_InferredPersonalizationFeed.js"], "git_node": "26de587878fa908a5a4dd8a9e26410f151933eac", "git_parents": ["edc415c9335d0a415854f9336a2644196e3b8062"], "node": "43f6078a9a5d799ba920e754cc1f1f843f04107e", "parents": ["c2855466ca2c37532c4028c678788ed9284148d0"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076862 - Lock the SRD pref to prepare for cleanup r=settings-reviewers,hjones\n\nThe old settings page will start being non-functional as we remove more\nof the previous settings. Lock the pref so users get the new settings\ninstead of a reducing set of settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330017\n", "files": ["browser/app/profile/firefox.js"], "git_node": "4dd42af565a0e956d28cabc3b4536db893b8f0ef", "git_parents": ["26de587878fa908a5a4dd8a9e26410f151933eac"], "node": "18f64a6a5f02c2f68d3f23cbd67cd2d1e3baa078", "parents": ["43f6078a9a5d799ba920e754cc1f1f843f04107e"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2049270 - [wdspec] Update expectation of test_move_to_position_in_viewport[default value] on Android. r=webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337609\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/pointer_mouse.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse.py.ini"], "git_node": "5ab5bfae9f795a3d3eec6cefc087591c61b2306c", "git_parents": ["4dd42af565a0e956d28cabc3b4536db893b8f0ef"], "node": "58eed63a7fb8bc0408f77cb30eb065b190362802", "parents": ["18f64a6a5f02c2f68d3f23cbd67cd2d1e3baa078"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2087087 - Wait for the tab to be painted before touching it in browser_bug2044829.js, r=tnikkel,gfx-reviewers.\n\nIf the new tab's displayport has not been painted yet when touchstart\narrives, content defers the SetTargetAPZC notification to its next\nrefresh, which the test's 3s touchmove busy-wait blocks, so APZ cannot\nscroll during it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338024\n", "files": ["gfx/layers/apz/test/mochitest/browser_bug2044829.js"], "git_node": "d802541095f2b81e4029e54b54d3c53d01c496ff", "git_parents": ["5ab5bfae9f795a3d3eec6cefc087591c61b2306c"], "node": "067cfb39d819898e9751b2bc875871facd1fd97d", "parents": ["58eed63a7fb8bc0408f77cb30eb065b190362802"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068351 - Test setting form controls after parse r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323268\n", "files": ["dom/html/test/forms/mochitest.toml", "dom/html/test/forms/test_bug2068351.html"], "git_node": "94b0e2dc36cf8a01397b0a30334c2391be8e8928", "git_parents": ["d802541095f2b81e4029e54b54d3c53d01c496ff"], "node": "39cc46ee835e8a97d39513ac6afc024b79b913bb", "parents": ["067cfb39d819898e9751b2bc875871facd1fd97d"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086288 - Part 1: Add dom/media/AGENTS.md with media guidance for AI agents. r=padenot,ai4dev-reviewers\n\nAdd scoped agent guidance for dom/media: the design docs and review\nchecklists to read, the rule to fix the cause and follow the spec, the\nmedia rules for threads, async shutdown, process boundaries, platform\ncode, logging and prefs, and where each kind of test goes. List the\nfolder in the root AGENTS.md so agents open it.\n\nThis media knowledge is now copied in agent setups outside the tree,\nwhere it drifts from the code. In the tree, the media team owns one copy\nthat every agent reads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337363\n", "files": ["AGENTS.md", "dom/media/AGENTS.md", "dom/media/CLAUDE.md"], "git_node": "f5d7bee2ee0da9cded5e35271ba58ccf292a8398", "git_parents": ["94b0e2dc36cf8a01397b0a30334c2391be8e8928"], "node": "abe3b7ff26d3be0bc659148b4ddfc7319b5aad34", "parents": ["39cc46ee835e8a97d39513ac6afc024b79b913bb"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086288 - Part 2: Add a media bug diagnostics page to the dom/media docs. r=padenot,media-playback-reviewers,ai4dev-reviewers\n\nAdd a docs page that tells which data in a media bug report shows the\ncause: the about:support sections and prefs that matter, the signals in\na media log and a media profile, the hardware decode failure pattern on\nWindows, and the data that a useful report has for each kind of media\nbug. It also gives the about:logging steps to capture a media profile\nand log, on desktop and on Android. The media AGENTS.md points to it.\n\nThese facts are now only in agent setups outside the tree, and some of\nthem no longer match the code. A docs page keeps one copy that the media\nteam owns and that people and agents can both read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337364\n", "files": ["dom/media/AGENTS.md", "dom/media/docs/Diagnostics.md", "dom/media/docs/index.md"], "git_node": "4b234a57160e246e482d926a6e6fb5bb8279955b", "git_parents": ["f5d7bee2ee0da9cded5e35271ba58ccf292a8398"], "node": "a64c770eb77ddca53ce775706b6b0715c2688282", "parents": ["abe3b7ff26d3be0bc659148b4ddfc7319b5aad34"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086288 - Part 3: Move the media spec list out of the review checklist into its own page. r=padenot,media-playback-reviewers,ai4dev-reviewers\n\nAdd a docs page that tells which spec covers each media area, and how to\nread the normative text of web platform and codec specs. It also adds\nthe Web Speech API and the media registries, such as the MSE byte\nstream formats and the WebCodecs codec strings. The spec correctness\nchecklist now keeps only the review checks and points to the new page.\nThe media AGENTS.md also points to it.\n\nThe spec list is useful to write a fix, to triage and to investigate a\nbug, not only to review a change. In a review checklist, people and\nagents that do not review do not find it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337365\n", "files": ["dom/media/AGENTS.md", "dom/media/docs/Specs.md", "dom/media/docs/index.md", "dom/media/docs/review/spec-correctness.md"], "git_node": "78ef7e967b0a766e4686ff77039509e14970d815", "git_parents": ["4b234a57160e246e482d926a6e6fb5bb8279955b"], "node": "ab713fbfb41ae883ee676309afcb10583077dcec", "parents": ["a64c770eb77ddca53ce775706b6b0715c2688282"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084915 - Make GeckoViewOutputStream::Flush() not return an error. r=geckoview-reviewers,m_kato\n\nThere's nothing to flush, the data is written to the java side directly.\n\nThis got me backed out in bug 2083386 because I made the print stream\nhandle flush errors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336119\n", "files": ["mobile/android/components/geckoview/GeckoViewOutputStream.cpp"], "git_node": "3d690b6d4d93cc9d133e05c6d0144152a0340c97", "git_parents": ["78ef7e967b0a766e4686ff77039509e14970d815"], "node": "af1d0e473e60b4759d83f32ea2da4ca2ecbbd8b8", "parents": ["ab713fbfb41ae883ee676309afcb10583077dcec"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081980. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337511\n", "files": ["layout/style/CSSImportRule.cpp", "layout/style/Rule.h", "layout/style/StyleSheet.h"], "git_node": "86033e8fdd9c0f731fcf4d82d161958e934f1531", "git_parents": ["3d690b6d4d93cc9d133e05c6d0144152a0340c97"], "node": "7d00b048cacdb561ae63592a06312572a30ef0ef", "parents": ["af1d0e473e60b4759d83f32ea2da4ca2ecbbd8b8"], "tags": []}, {"author": "lottiehope \u003clottie_hope@hotmail.co.uk\u003e", "branch": "default", "desc": "Bug 2082525 - add secret setting for QWAC ui r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335186\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "b6e5c4a90fa067ab2c4017db8aca03d8460727cf", "git_parents": ["86033e8fdd9c0f731fcf4d82d161958e934f1531"], "node": "26c43fa2cd0c52bbdb9398ca97ed09c701d9043e", "parents": ["7d00b048cacdb561ae63592a06312572a30ef0ef"], "tags": []}, {"author": "Mayank Bansal \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1889510 - Intercept AtomRef strings in promoteString and forward to tenured atom. r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326395\n", "files": ["js/src/gc/Tenuring.cpp", "js/src/jit-test/tests/basic/stringbuffer-1.js", "js/src/jit-test/tests/gc/atomref-promotion.js"], "git_node": "e1a50b05921c88e521f2ee1539d0ea05d2e38be3", "git_parents": ["b6e5c4a90fa067ab2c4017db8aca03d8460727cf"], "node": "51e29ef92b6e7c9bac47826776a6d4a62d269d44", "parents": ["26c43fa2cd0c52bbdb9398ca97ed09c701d9043e"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084086 - Pass ListenSheetUiState instead of whole state r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336045\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/ListenSheetUiState.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/ListenSheetUiStateTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ListenSheetIntegration.kt"], "git_node": "21006b94d742ea430ae4e7503eca232a25053079", "git_parents": ["e1a50b05921c88e521f2ee1539d0ea05d2e38be3"], "node": "35849af757a02ae65edadea34da94ca756bbfc12", "parents": ["51e29ef92b6e7c9bac47826776a6d4a62d269d44"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2081980. r=firefox-style-system-reviewers,dshin\" for causing mochitest failures @test_stylesheet_clone_import_rule.html.\n\nThis reverts commit 86033e8fdd9c0f731fcf4d82d161958e934f1531.\n", "files": ["layout/style/CSSImportRule.cpp", "layout/style/Rule.h", "layout/style/StyleSheet.h"], "git_node": "ae3486b15d958a05516143ab99aa0c6356b657a4", "git_parents": ["21006b94d742ea430ae4e7503eca232a25053079"], "node": "faf8e658c6135aac007cfadaf688c21690e7c961", "parents": ["35849af757a02ae65edadea34da94ca756bbfc12"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083095 - Check for invalid column numbers in JSStructuredCloneReader::readSavedFrameHeader. r=spidermonkey-reviewers,sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337976\n", "files": ["js/public/ColumnNumber.h", "js/src/jit-test/tests/structured-clone/saved-frame-bad-column.js", "js/src/vm/StructuredClone.cpp"], "git_node": "3b62fcdffff2d9da60fb7b7a1150f85209e2d38c", "git_parents": ["ae3486b15d958a05516143ab99aa0c6356b657a4"], "node": "a63ef1b21094dea61609668370f3e4110a7044a6", "parents": ["faf8e658c6135aac007cfadaf688c21690e7c961"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080763 - Only advertise device capabilities when the account has the sync keys/scope r=android-reviewers,tthibaud\n\nBefore sync & accounts are decoupled, every successful authentication forced the creation of sync keys, and that meant that every authentication attempt resulted in the ability to have send_tab & close_tab device capabilities because they both require sync keys.\n\nAfter sync & accounts are decoupled, we need to ensure that we advertise the send_tab & close_tab device capabilities to fxa-client only when we have the correct sync keys (and sync scope).\n\nThis patch adds the following:\n\n1. A function to ensure that the device capabilities are advertised only when the sync scope is present.\n2. An `initializeDevice()` API to be called at app startup\n3. Simplify the the `finalizeDevice()` API, and call it only when an authentication that could have changed the keys has happened.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336243\n", "files": ["mobile/android/android-components/components/concept/sync/src/main/java/mozilla/components/concept/sync/Devices.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FxaDeviceConstellation.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaDeviceConstellationTest.kt"], "git_node": "86136a5faf970e59063cd07b822717f6fd03a958", "git_parents": ["3b62fcdffff2d9da60fb7b7a1150f85209e2d38c"], "node": "0d3cae2fecc47097a51629b29675099ceed72c5f", "parents": ["a63ef1b21094dea61609668370f3e4110a7044a6"], "tags": []}], "date": 1793309038, "git_changesets": ["e65fd19f7d44f636e417ecef60eff744a172e403", "c8e1217419b1d6b36ab55fa7bb3a780dfc6de153", "59c9442f39c160e4bc3fcacd7b10da0c91721ab5", "97416095f9fcebc6266420c09cb31de31dac8723", "5179db59154a4288624c4abfb56943d9f7a78be5", "e305b62666da350e0966d807fbea753a5687f4a4", "110073679eb66ad0e0f09e5f4d48ed99d1c84475", "ebbb7328f5890a82edff3daec71c52c10ac750c2", "f83a1d9ff5a5c3c0e132c34564623fb7364535d7", "dfd8e43de80cbbd6478514736557a529ea453f19", "3e918b26bb10d39f3e0e0bc4451b1ee79821e177", "0db20cae4b5bad918b4b7a5cb9671ce7e7b6f300", "8e46df64fbff761b757f4b405820896af1b81d67", "7c04977c0654ac2ecafbbf4002454a35892736ed", "a6a3883eaac6a5a57e3b3ab5619e9fa602cf3f22", "6966702f3d66e74c40a828daf