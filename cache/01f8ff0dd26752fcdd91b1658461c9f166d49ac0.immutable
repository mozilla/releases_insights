s:4215218:"{
"lastpushid": 45767,
"pushes": {"45624": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 385ef201eb590c60e35180d18583a52a15e3626d with FIREFOX_BETA_159_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "bc4ff84be4e1c8419771037747f4c3189c804b21", "git_parents": ["3789f7d751039722c5ab4724cf9b0e6e5666a2df"], "node": "516fe4b6c3858fafdef54016e00868c3bc83f559", "parents": ["51d234d29e0512337e2ee5abce013f4a2203682f"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 006163118837775b4ae627815acf6b8d32938271 with FIREFOX_BETA_160_BASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "368e610a77193eae7191b7892d6e7ccd0aeffff0", "git_parents": ["bc4ff84be4e1c8419771037747f4c3189c804b21"], "node": "119bc224294b9cfa890e756c0795f7169fe9916f", "parents": ["516fe4b6c3858fafdef54016e00868c3bc83f559"], "tags": []}], "date": 1792674161, "git_changesets": ["bc4ff84be4e1c8419771037747f4c3189c804b21", "368e610a77193eae7191b7892d6e7ccd0aeffff0"], "user": "ffxbld@lando.moz.tools"}, "45625": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt", "mobile/android/version.txt"], "git_node": "d5004ad35492716cfddf427497bcb97d037681d4", "git_parents": ["d6fd7a4e69b3c2d4550582eb38d2cdbd9cbad79a"], "node": "b2e7ca6b210694a3692ddbee0a16cd78e8aa9cae", "parents": ["006163118837775b4ae627815acf6b8d32938271"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER", "browser/extensions/newtab/manifest.json", "browser/extensions/webcompat/manifest.json", "mobile/android/android-components/docs/changelog.md", "services/sync/modules/constants.sys.mjs"], "git_node": "304e288e34efabaf13ad0a8ff4b98dfffcc6a8eb", "git_parents": ["d5004ad35492716cfddf427497bcb97d037681d4"], "node": "d998beea977ef1fcc42c6c189b0056b7f95ef98b", "parents": ["b2e7ca6b210694a3692ddbee0a16cd78e8aa9cae"], "tags": []}], "date": 1792674633, "git_changesets": ["d5004ad35492716cfddf427497bcb97d037681d4", "304e288e34efabaf13ad0a8ff4b98dfffcc6a8eb"], "user": "ffxbld@lando.moz.tools"}, "45626": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 006163118837775b4ae627815acf6b8d32938271 with FIREFOX_NIGHTLY_160_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "996da5728dae25cc909d308a2d15ef69f034cc2f", "git_parents": ["368e610a77193eae7191b7892d6e7ccd0aeffff0"], "node": "07a17c1afab53ed5cb9d8e6f316b9d69363b8e64", "parents": ["119bc224294b9cfa890e756c0795f7169fe9916f"], "tags": []}], "date": 1792674651, "git_changesets": ["996da5728dae25cc909d308a2d15ef69f034cc2f"], "user": "ffxbld@lando.moz.tools"}, "45627": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - updated default_config_env for v157\n", "files": ["dom/media/webrtc/third_party_build/default_config_env"], "git_node": "b6ae92144d906647cd30e4572fb5840745fc9288", "git_parents": ["304e288e34efabaf13ad0a8ff4b98dfffcc6a8eb"], "node": "941520a54de2abeb0b794c4a67f8214fe32faf4e", "parents": ["d998beea977ef1fcc42c6c189b0056b7f95ef98b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - updated libwebrtc patch stack\n", "files": ["third_party/libwebrtc/moz-patch-stack/32e8bb9eed.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/7a25e1c85a.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/fc6666263e.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch", "third_party/libwebrtc/moz-patch-stack/p0003.patch"], "git_node": "bcfbe2d7416f78a8d8b917020d22173603c5ede7", "git_parents": ["b6ae92144d906647cd30e4572fb5840745fc9288"], "node": "cd2c7e246ff0f7b6964aa1666d86e15550f3fd88", "parents": ["941520a54de2abeb0b794c4a67f8214fe32faf4e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 31957526b2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/31957526b2008c7bcefc12f8d7c394251acfc5e4\n    Revert \"Report parsed key id on SFrame unknown-key decrypt failures\"\n\n    This reverts commit 43f5a1c963381978d29a2f2b85633bb9ad7303f5.\n\n    Reason for revert: Breaks downstream build\n\n    Original change's description:\n    \u003e Report parsed key id on SFrame unknown-key decrypt failures\n    \u003e\n    \u003e `ToSframeDecryptFailure` previously mapped `invalid_parameter_error` to\n    \u003e a `kKeyId` failure with an empty key id, because the Cisco Sframe\n    \u003e library did not surface the key id parsed from the SFrame header.\n    \u003e\n    \u003e The library now returns a dedicated\n    \u003e `SFrameErrorType::unknown_key_id_error` carrying the parsed key id, so\n    \u003e the mapping is switched over to it and the key id is propagated into\n    \u003e `SframeDecryptFailure::KeyId`. Applications listening for\n    \u003e `SframeDecryptErrorCallback` can now tell *which* key is missing,\n    \u003e matching\n    \u003e [SFrameTransformErrorEvent.keyID](https://w3c.github.io/webrtc-encoded-transform/#dom-sframetransformerrorevent-keyid).\n    \u003e\n    \u003e `invalid_parameter_error` now falls through to the `kSyntax` default,\n    \u003e which is the correct classification for a malformed header.\n    \u003e\n    \u003e Additional changes:\n    \u003e - Re-enabled `SframeEncryptorDecryptorTest.DISABLED_DecryptReportsKeyIdErrorForUnknownKey`\n    \u003e   and tightened it to assert the reported key id equals the encryption key id.\n    \u003e\n    \u003e Bug: webrtc:479862368\n    \u003e Change-Id: I5af6c6b42f1fe46acbdeba6168d4a20f1f8a0869\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506020\n    \u003e Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    \u003e Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48732}\n\n    Bug: webrtc:479862368\n    No-Presubmit: true\n    No-Tree-Checks: true\n    No-Try: true\n    Change-Id: I8d7a55bf4b80a8027853178664e88732ca3f2915\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506120\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48738}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/sframe/sframe_decryptor.cc", "third_party/libwebrtc/modules/sframe/sframe_encryptor_decryptor_unittest.cc"], "git_node": "d1af3e7721814fc8b76e04dbff87cbf3a709f2c0", "git_parents": ["bcfbe2d7416f78a8d8b917020d22173603c5ede7"], "node": "2b2ab06ac59bb3774b2a978e0192708506f82fa8", "parents": ["cd2c7e246ff0f7b6964aa1666d86e15550f3fd88"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f5c91ed290\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f5c91ed290f439cbb02e6b32a5e7d81dd8583918\n    [agc2] Differentiate low-activity segments and background speakers\n\n    Refactor SpeechLevelEstimator to query IsTargetSpeakerActive() rather\n    than IsBackgroundSpeaker(). This separates the two distinct scenarios\n    where target speech probability is suppressed:\n    1. Background speaker: detected via level drop against the tracked level.\n    2. Low-activity segment: triggered when speech frame accumulation times\n       out before reaching kFramesPerUpdate.\n\n    Additional changes:\n    - In SpeechLevelEstimatorExperimentalImpl, introduce low_activity_segment_\n      and clear it upon reaching kFramesPerUpdate.\n    - Reset num_adjacent_speech_frames_ to 0 upon timeout reset.\n    - Add RTC_DCHECK_GT in constructor verifying max_frames_to_update_ \u003e\n      kFramesPerUpdate.\n    - Update GainController2 and unit tests accordingly.\n\n    Bug: webrtc:42232605\n    Change-Id: I375ae258451ff6c58561e9a5f1ee16bf1af9fcd0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506080\n    Reviewed-by: Lionel Koenig \u003clionelk@webrtc.org\u003e\n    Commit-Queue: Jesus de Vicente Pena \u003cdevicentepena@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48739}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator.h", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator_experimental_impl.cc", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator_experimental_impl.h", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator_experimental_unittest.cc", "third_party/libwebrtc/modules/audio_processing/agc2/speech_level_estimator_impl.h", "third_party/libwebrtc/modules/audio_processing/gain_controller2.cc"], "git_node": "109a4db297f7d7a5b2286f5168b635262759b216", "git_parents": ["d1af3e7721814fc8b76e04dbff87cbf3a709f2c0"], "node": "fbae2cea09e819c44dd4f9454ac54253ca111c61", "parents": ["2b2ab06ac59bb3774b2a978e0192708506f82fa8"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from e5ba1946fc\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e5ba1946fcdd64940ae15710df6eed4adf2088d9\n    Turn rtc_unittests into a rtc_test_suite\n\n    Change-Id: Id22b88f13487aeb377db636ccd535c4fa43f6ba4\n    Bug: None\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505900\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48740}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/BUILD.gn", "third_party/libwebrtc/api/audio/BUILD.gn", "third_party/libwebrtc/api/audio/test/BUILD.gn", "third_party/libwebrtc/api/audio_codecs/opus/BUILD.gn", "third_party/libwebrtc/api/audio_codecs/test/BUILD.gn", "third_party/libwebrtc/api/crypto/BUILD.gn", "third_party/libwebrtc/api/environment/BUILD.gn", "third_party/libwebrtc/api/numerics/BUILD.gn", "third_party/libwebrtc/api/task_queue/BUILD.gn", "third_party/libwebrtc/api/test/metrics/BUILD.gn", "third_party/libwebrtc/api/test/network_emulation/BUILD.gn", "third_party/libwebrtc/api/transport/BUILD.gn", "third_party/libwebrtc/api/transport/rtp/BUILD.gn", "third_party/libwebrtc/api/units/BUILD.gn", "third_party/libwebrtc/api/video/BUILD.gn", "third_party/libwebrtc/api/video/corruption_detection/BUILD.gn", "third_party/libwebrtc/api/video/test/BUILD.gn", "third_party/libwebrtc/api/video_codecs/BUILD.gn", "third_party/libwebrtc/api/video_codecs/test/BUILD.gn", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/logging/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0052.patch", "third_party/libwebrtc/moz-patch-stack/s0054.patch", "third_party/libwebrtc/moz-patch-stack/s0068.patch", "third_party/libwebrtc/moz-patch-stack/s0081.patch", "third_party/libwebrtc/moz-patch-stack/s0083.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0086.patch", "third_party/libwebrtc/moz-patch-stack/s0087.patch", "third_party/libwebrtc/moz-patch-stack/s0091.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0097.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/moz-patch-stack/s0105.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/resources/BUILD.gn", "third_party/libwebrtc/rtc_base/BUILD.gn", "third_party/libwebrtc/rtc_base/containers/BUILD.gn", "third_party/libwebrtc/rtc_base/experiments/BUILD.gn", "third_party/libwebrtc/rtc_base/memory/BUILD.gn", "third_party/libwebrtc/rtc_base/synchronization/BUILD.gn", "third_party/libwebrtc/rtc_base/system/BUILD.gn", "third_party/libwebrtc/rtc_base/task_utils/BUILD.gn", "third_party/libwebrtc/rtc_base/units/BUILD.gn", "third_party/libwebrtc/rtc_base/win/BUILD.gn", "third_party/libwebrtc/sdk/BUILD.gn", "third_party/libwebrtc/test/network/BUILD.gn", "third_party/libwebrtc/webrtc.gni"], "git_node": "38deb42238c44e202de70646c88a7d0b3e27dc56", "git_parents": ["109a4db297f7d7a5b2286f5168b635262759b216"], "node": "ae70ba16c748b0f6ad60df897cb7684a5b7005b0", "parents": ["fbae2cea09e819c44dd4f9454ac54253ca111c61"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 17022fdaee\n\nUpstream commit: https://webrtc.googlesource.com/src/+/17022fdaeee39029f0399d12cb8d0a0ceaec2f2a\n    Update WebRTC code version (2026-09-29T04:08:07).\n\n    Bug: None\n    Change-Id: I61f8acae22baf423cb6eec874a7794ff1cd163db\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506240\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48741}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "6f347db668ba093a33d31a16fef22cb132495baf", "git_parents": ["38deb42238c44e202de70646c88a7d0b3e27dc56"], "node": "01ced14a49ccfdda017d6b962ab17b214df96807", "parents": ["ae70ba16c748b0f6ad60df897cb7684a5b7005b0"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b30c6d86da\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b30c6d86da3f3c9c1e0ae1df835c780c18840c74\n    p2p: avoid duplicate UDP allocations during gathering\n\n    Like TCP, a running sequence that has not reached its UDP phase yet\n    covers UDP even before its port exists.\n\n    Bug: webrtc:566467875\n    Change-Id: I6b01f21a219fa26ce509ab9dda6cc180443c3562\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506060\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48742}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/client/basic_port_allocator.cc", "third_party/libwebrtc/p2p/client/basic_port_allocator_unittest.cc"], "git_node": "ebd37c49fbb120f44c965e0e4bae831ba71800fe", "git_parents": ["6f347db668ba093a33d31a16fef22cb132495baf"], "node": "30843ef4c0f08c048d7f0ac9016b2c2b9f02abf4", "parents": ["01ced14a49ccfdda017d6b962ab17b214df96807"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 32e8bb9eed\n\nWe already cherry-picked this when we vendored 3987dfb7b9.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/32e8bb9eed5d58488cecbfb79a01b62f4d9d015f\n    Reland \"Reject corrupted frames in the VP8 video decoder.\"\n\n    This is a reland of commit ba511622a24945fdd2b5b26b5a9275f0c6daff5e. The\n    original CL was reverted due to a downstream test which has now been\n    updated.\n\n    Original change's description:\n    \u003e Reject corrupted frames in the VP8 video decoder.\n    \u003e\n    \u003e The libvpx VP8 decoder has always returned error on malformed keyframes\n    \u003e but it turns out that corrupted delta frames may actually decode with\n    \u003e error, upon which the decoder still returns `VPX_CODEC_OK`. It is then\n    \u003e up to the user to poll the `VP8D_GET_FRAME_CORRUPTED` flag to see if it\n    \u003e was indeed OK.\n    \u003e\n    \u003e This CL adds a unit test the demonstrated this condition and shows that\n    \u003e we now reject the corrupted frame instead of continuing with error.\n    \u003e\n    \u003e Bug: chromium:561396583\n    \u003e Change-Id: I1e5c65225fc389be8b37d4c7da9a2cbf9a0c6ec2\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505800\n    \u003e Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48727}\n\n    Bug: chromium:561396583\n    Change-Id: I823057c845b262a4efbcdb022d44b95f6bf8b147\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506140\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48743}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/32e8bb9eed.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0003.patch"], "git_node": "cc9edadc5a5847bc140da9740a626a0a7391bd7d", "git_parents": ["ebd37c49fbb120f44c965e0e4bae831ba71800fe"], "node": "92f4e505c4a2d1a1d2d22c64efcd85c8878a42c0", "parents": ["30843ef4c0f08c048d7f0ac9016b2c2b9f02abf4"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 8e4eb9d8d2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8e4eb9d8d218cf54f53ff3389832bd86a68d3c6e\n    Don't truncate frame diffs in RtpGenericFrameDescriptor\n\n    RtpGenericFrameDescriptor::AddFrameDependencyDiff() took a uint16_t, so\n    frame diffs computed from 64-bit frame ids were silently truncated. A\n    diff that truncated into the valid range, e.g. 2^16 + 5, was accepted\n    and written as a dependency on the wrong frame.\n\n    Take the diff as int64_t and reject values that the descriptor can't\n    represent. RTPSenderVideo ignores the result, so it now leaves such a\n    dependency out rather than misrepresenting it. Leaving out the whole\n    descriptor instead would make the stream inconsistent, while the missing\n    dependency only matters to receivers that lost the referenced frame.\n    RtpDescriptorAuthentication calls the same method, so the authenticated\n    data still matches the descriptor that is sent.\n\n    Bug: webrtc:566342228\n    Change-Id: I344a641a1b0956984ed69fc44d439d8adba021df\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505901\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48744}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_generic_frame_descriptor.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_generic_frame_descriptor.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_generic_frame_descriptor_extension_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "6e7901e2b75d7a9b62c959ddebbf4a06d46715fe", "git_parents": ["cc9edadc5a5847bc140da9740a626a0a7391bd7d"], "node": "3dbb282794958f4fbb9182bc9546f8f64193ad5c", "parents": ["92f4e505c4a2d1a1d2d22c64efcd85c8878a42c0"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 420f4d165a\n\nUpstream commit: https://webrtc.googlesource.com/src/+/420f4d165a937b8d2141e7e7f700ad3144bec9e1\n    Fix memory leak and use-after-free in CallPerfTest::TestAudioVideoSync.\n\n    - Move `observer` into the cleanup `PostTask` lambda instead of calling\n      `observer.release()`, so `VideoRtcpAndSyncObserver` is still destroyed\n      if `task_queue_` shuts down before the task runs.\n\n    - Reset `DirectTransport` instances before calling `DestroyCalls()`\n      (reverting https://webrtc-review.git.corp.google.com/c/src/+/199962,\n      as `Call` no longer uses a separate `ProcessThread` and\n      `DirectTransport` now processes packets on `network_thread()`) so\n      in-flight packet delivery stops before the `Call` objects are\n      destroyed.\n\n    Change-Id: I2e3834c1c16e90d164655f0d566bf01ebd5b6475\n    Bug: None\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506280\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48745}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/call_perf_tests.cc"], "git_node": "44bbe7844af85b9eab7eee1c19c0104cbff4cab0", "git_parents": ["6e7901e2b75d7a9b62c959ddebbf4a06d46715fe"], "node": "2fc3f6f0d5920e3616fca28ada103d008c8009a3", "parents": ["3dbb282794958f4fbb9182bc9546f8f64193ad5c"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 2d38c77376\n\nUpstream commit: https://webrtc.googlesource.com/src/+/2d38c77376f2b4aad03206e23fd2cca369f6162d\n    Fix android_peer_connection_factory_unittest missing dependency\n\n    No-Try: True\n    Change-Id: I9b482a01c509279b7b9d88803bc30c9172803734\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506300\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48746}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "d94d94f24746e0e4fbd206f6e50ad566f433a7c1", "git_parents": ["44bbe7844af85b9eab7eee1c19c0104cbff4cab0"], "node": "5980170c6b74e856d94712cadf30c45f3a9f936f", "parents": ["2fc3f6f0d5920e3616fca28ada103d008c8009a3"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 038a6b172d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/038a6b172d17c2e99337f2d78d43422f8f5df554\n    Reland \"[[deprecated]] PeerConnectionFactoryDependencies::worker_thread\"\n\n    This is a reland of commit d387b14b6e90861565fc8bc064110877d5ae7f95\n\n    Ready to land once nearby in chromium has been updated.\n\n    Original change's description:\n    \u003e [[deprecated]] PeerConnectionFactoryDependencies::worker_thread\n    \u003e\n    \u003e Marks PeerConnectionFactoryDependencies::worker_thread as [[deprecated]]\n    \u003e so that applications that still supply a worker thread get a compile\n    \u003e time warning before the dedicated worker_thread configuration becomes a\n    \u003e fatal error.\n    \u003e\n    \u003e Internal readers of the member (the ConnectionContext constructor and\n    \u003e the legacy CreatePeerConnectionFactory overload) suppress the warning\n    \u003e with a new RTC_PUSH/POP_IGNORING_WDEPRECATED_DECLARATIONS macro pair,\n    \u003e and the remaining in-tree tests that assigned the member (always to the\n    \u003e same thread as the network thread) no longer do so.\n    \u003e\n    \u003e See https://groups.google.com/g/discuss-webrtc/c/Fs_Hd5XNJh0 for more\n    \u003e details.\n    \u003e\n    \u003e Bug: webrtc:558821261\n    \u003e Change-Id: Iab47a93adf760e17f0224b17b731613e49c92913\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/502940\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48701}\n\n    Bug: webrtc:558821261\n    Change-Id: I4cb4c7cb1a5bf76b90cf1cccf3018432811c3873\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505340\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48747}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/BUILD.gn", "third_party/libwebrtc/api/create_peerconnection_factory.cc", "third_party/libwebrtc/api/peer_connection_interface.h", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/connection_context.cc", "third_party/libwebrtc/pc/peer_connection_bundle_unittest.cc", "third_party/libwebrtc/pc/peer_connection_data_channel_unittest.cc", "third_party/libwebrtc/pc/peer_connection_factory_unittest.cc", "third_party/libwebrtc/pc/peer_connection_header_extension_unittest.cc", "third_party/libwebrtc/pc/peer_connection_histogram_unittest.cc", "third_party/libwebrtc/pc/peer_connection_media_unittest.cc", "third_party/libwebrtc/pc/peer_connection_tracer_unittest.cc", "third_party/libwebrtc/pc/rtp_transceiver_unittest.cc", "third_party/libwebrtc/pc/test/fake_peer_connection_for_stats.h", "third_party/libwebrtc/rtc_base/system/ignore_warnings.h"], "git_node": "0ddc77a44c7ec5f2a1a08a9ac21c7732a51ff70d", "git_parents": ["d94d94f24746e0e4fbd206f6e50ad566f433a7c1"], "node": "2975714beb845084a6eac80cdaa876d3dfdbd24e", "parents": ["5980170c6b74e856d94712cadf30c45f3a9f936f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from d6b8db5e0e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d6b8db5e0e24832b562bf5fd9611ac8133f54f31\n    Let RtpPayloadParams see frames dropped by RtpVideoSender\n\n    RtpPayloadParams tracks the encoder's reference buffers to describe\n    frame dependencies, but RtpVideoSender only passed it frames that passed\n    the OnSendingRtpFrame() check. The key frame of a re-enabled simulcast\n    layer can be encoded before the layer's RTP module is re-activated, in\n    which case that check drops it. The layer's next frame was then\n    described as depending on the last frame the layer sent before it was\n    disabled. Since simulcast layers share frame ids, that frame could be\n    over 4096 frames back, which hit a DCHECK in\n    RtpDependencyDescriptorWriter.\n\n    Create the RTP video header before the check, so that RtpPayloadParams\n    observes all frames. Also return early rather than index out of bounds\n    if the simulcast index is invalid.\n\n    Bug: webrtc:566342228\n    Change-Id: If810056b42788e3be09ab05407493250f42ee86c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505902\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48748}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "3e2b487f2c0978752fcd6d0e190ce72656e9affb", "git_parents": ["0ddc77a44c7ec5f2a1a08a9ac21c7732a51ff70d"], "node": "10c58e235944ebd543fd16d88e720338d32dfd78", "parents": ["2975714beb845084a6eac80cdaa876d3dfdbd24e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 520484914d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/520484914d62c8b80412c6a4b705d75ffce3642b\n    Add guidance to prefer braced initialization over static_cast\n\n    Document preference for Type{value} (e.g. int{kConstant}) over\n    static_cast\u003cType\u003e(value) when casting constants or values where narrowing\n    is not intended in g3doc style guide and pre-reviewer skill.\n\n    Bug: none\n    Change-Id: Ieec26b7f5b2d26900c680e1fc5f8854c105753f2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506040\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48749}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/agents/skills/pre-reviewer/SKILL.md", "third_party/libwebrtc/g3doc/style-guide.md"], "git_node": "7a1d1f1c28e22706703b5878f0035b1ec454c8fd", "git_parents": ["3e2b487f2c0978752fcd6d0e190ce72656e9affb"], "node": "34d3dc12cd92e2e4208b26c59398cf94dc39e689", "parents": ["10c58e235944ebd543fd16d88e720338d32dfd78"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from fc6666263e\n\nWe already cherry-picked this when we vendored 8c12eb54fe.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/fc6666263eafa63878d02102189e3dabe9c90455\n    Harden payload capacity and reduction checks in RTP packetizers\n\n    Ensure packet reduction lengths cannot be negative when computing\n    payload limits in RTPSenderVideo and when determining needed payload\n    sizes during aggregation. Additionally, add a bounds check against\n    available payload capacity before copying aggregated fragments in\n    RtpPacketizerH265.\n\n    Bug: chromium:567088927\n    Change-Id: Ibd57aacce9ef79379fa627903d4aed89c9fbf489\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506260\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48750}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/fc6666263e.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch"], "git_node": "744d7bb61dc2cc624339b89fe4b6cfbed357a87a", "git_parents": ["7a1d1f1c28e22706703b5878f0035b1ec454c8fd"], "node": "21cbb4c13f92e4815f329aa14978635be302cf59", "parents": ["34d3dc12cd92e2e4208b26c59398cf94dc39e689"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 6f2034eabb\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6f2034eabb8b13e220e41ecb0173ef941ae3afcd\n    Enable WebRTC-ClockAligner by default\n\n    Make ClockAligner default to non-monotonic clock alignment, allowing\n    it to handle backward clock jumps and clock drift unless explicitly\n    disabled via the field trial 'WebRTC-ClockAligner'.\n\n    Rename fix_non_monotonic_clock_ to disable_non_monotonic_clock_fix_\n    and initialize it using field_trials().IsDisabled(\"WebRTC-ClockAligner\").\n\n    Bug: webrtc:555794212\n    Change-Id: I530cf4e22194c195fde5d6ab5e78b38f1f2c82da\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506340\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48751}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0052.patch", "third_party/libwebrtc/moz-patch-stack/s0083.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0086.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/rtc_base/BUILD.gn", "third_party/libwebrtc/rtc_base/async_udp_socket_unittest.cc", "third_party/libwebrtc/rtc_base/clock_aligner.cc", "third_party/libwebrtc/rtc_base/clock_aligner.h"], "git_node": "51a4dbf1bcb1c9110156a2b910e17313b8b255ef", "git_parents": ["744d7bb61dc2cc624339b89fe4b6cfbed357a87a"], "node": "47d243c8519c3dbe86a370f6d2c24281e0e82315", "parents": ["21cbb4c13f92e4815f329aa14978635be302cf59"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 0973d9300c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0973d9300cda37904b6631ccb3256f80e531f259\n    Skip network transmission in RtpSenderEgress for untransmitted packets.\n\n    When packet-\u003eallow_sending() is false, skip adding send-time header\n    extensions and skip transmitting to the network transport, but still\n    store the packet in RtpPacketHistory if it is marked as retransmittable.\n\n    Bug: webrtc:564720400\n    Change-Id: Ie627f5b44d34b6eb44b481212e4c95094928f2f4\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505760\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48752}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/BUILD.gn", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packet_history.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packet_history.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packet_history_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_egress.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_egress_unittest.cc"], "git_node": "6c4df45185cffe1e9e062d415d2b45011b927427", "git_parents": ["51a4dbf1bcb1c9110156a2b910e17313b8b255ef"], "node": "7ae26a42979125d1e6a1320bed6d7ea68752d23d", "parents": ["47d243c8519c3dbe86a370f6d2c24281e0e82315"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 0973d9300c - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/moz.build", "third_party/libwebrtc/rtc_base/experiments/retransmit_flushed_packets_settings_gn/moz.build"], "git_node": "f03c7447fa4758508a4272e76255e78ecb60d2aa", "git_parents": ["6c4df45185cffe1e9e062d415d2b45011b927427"], "node": "04f977bc9c145863f53c0531280d1969442a0864", "parents": ["7ae26a42979125d1e6a1320bed6d7ea68752d23d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 8bd8f66cf6\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8bd8f66cf6094b9b2c1fdfacf5c9a9f06db1949b\n    Fix out-of-range dependency descriptor frame diffs\n\n    The dependency descriptor can't represent frame diffs over 4096 or chain\n    diffs over 255. RtpDependencyDescriptorWriter only DCHECKed them, and\n    release builds wrote them truncated, so the descriptor referenced the\n    wrong frame.\n\n    - Reject unrepresentable diffs in RtpDependencyDescriptorWriter.\n    - In RTPSenderVideo, send chain diffs over 255 as 0, as RtpPayloadParams\n      does for VP9, and drop delta frames that the dependency descriptor\n      can't describe instead of disabling the descriptor.\n\n    Fixed: webrtc:566342228\n    Change-Id: Icdb1c36d3e6684bab7d1253e5c06265274ce670c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505920\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48753}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_dependency_descriptor_extension_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_dependency_descriptor_writer.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_dependency_descriptor_writer.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc"], "git_node": "79dbfdd35112043a8907fb788e7b93ca444d9b44", "git_parents": ["f03c7447fa4758508a4272e76255e78ecb60d2aa"], "node": "94ed64a81a23e4a0cae47b6daa33ba89fa8bda21", "parents": ["04f977bc9c145863f53c0531280d1969442a0864"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from deed5afaab\n\nUpstream commit: https://webrtc.googlesource.com/src/+/deed5afaab92c15587051852cc814ee44105cdaa\n    Don't drop key frame of re-enabled simulcast layer\n\n    RtpVideoSender activates RTP modules in a task on the transport queue,\n    so the encoder could produce the key frame of a re-enabled layer while\n    the module wasn't sending yet. The key frame was then dropped, and the\n    layer was unusable until the receiver requested a new key frame.\n\n    Enable media synchronously in OnVideoLayersAllocationUpdated(). The rest\n    of the activation, including the pacer registration, still runs on the\n    transport queue, before the frame's packets reach the pacer.\n\n    Fixed: webrtc:566494723\n    Change-Id: I5e4260a99f53c86fcdc798a6279d416ca6d50ac4\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505681\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48754}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "5c5b863e08e8fdad18471a4675ed87cc3a6e59ad", "git_parents": ["79dbfdd35112043a8907fb788e7b93ca444d9b44"], "node": "a1160ffc2447deafeea28bf31d89f864cea0275c", "parents": ["94ed64a81a23e4a0cae47b6daa33ba89fa8bda21"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b40266019c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b40266019caebdeb8e9e213436c4833f73e2b84b\n    Fix temporal index overflow in RtpPayloadParams\n\n    H264ToGeneric() and Vp8ToGeneric() accepted temporal indices up to 7 but\n    sized the decode target indications for kMaxTemporalStreams (4) temporal\n    layers, so indices 4-7 hit a DCHECK or wrote past the end of the vector.\n    Reject them like larger indices.\n\n    Fixed: webrtc:566486041\n    Change-Id: Ifdb3f6554a6aabbcec79f0f866aa5ced578b655a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505682\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48755}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_payload_params.cc", "third_party/libwebrtc/call/rtp_payload_params_unittest.cc"], "git_node": "06283401f136ae4b25c4d66c0de8ee956fb90896", "git_parents": ["5c5b863e08e8fdad18471a4675ed87cc3a6e59ad"], "node": "569d05c4cb753e211194d104509b74cf49aa496a", "parents": ["a1160ffc2447deafeea28bf31d89f864cea0275c"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from df54c0214f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/df54c0214fd994115afe3d0b54d0c2ef2d0fcf94\n    Honor SetSharedMemoryFactory() in ScreenCapturerX11\n\n    ScreenCapturerX11 ignored the shared memory factory and always allocated\n    BasicDesktopFrame, which breaks callers that require shared memory\n    frames, such as Chrome Remote Desktop's multi-process host.\n\n    Store the factory and allocate SharedMemoryDesktopFrame when it is set.\n    If the allocation fails, return ERROR_TEMPORARY instead of falling back\n    to a non-shared frame. Setting the factory also resets the frame queue\n    so that previously allocated frames are replaced.\n\n    Bug: chromium:493980875\n    Change-Id: Icd283dd909d1d30eea24b168ab8a227bd2743fcd\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505820\n    Reviewed-by: Johannes Kron \u003ckron@webrtc.org\u003e\n    Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Commit-Queue: Yuwei Huang \u003cyuweih@chromium.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48756}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/desktop_capture/linux/x11/screen_capturer_x11.cc", "third_party/libwebrtc/modules/desktop_capture/linux/x11/screen_capturer_x11.h", "third_party/libwebrtc/moz-patch-stack/s0001.patch"], "git_node": "59bf082b91045fb068e22da267741dedce106f9e", "git_parents": ["06283401f136ae4b25c4d66c0de8ee956fb90896"], "node": "80a00a685daf2f8b9fb2aa55a453662a616f6261", "parents": ["569d05c4cb753e211194d104509b74cf49aa496a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 7b205d14ba\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7b205d14ba7b2727df28971debbde37cdfd7318e\n    Make RtpVideoSender's SSRC-to-module map const\n\n    ConfigureSsrcs() filled in the map after construction, so it couldn't be\n    const even though it never changes afterwards. Build it in the\n    initializer list instead. Use a flat_map, since the map is small, built\n    once and only used for lookups.\n\n    Bug: webrtc:42223727\n    Change-Id: Ib306aaca6cfd81415c7ced7aaf02c4af4539a9e3\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506160\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48757}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "021864deb92d33495c99e9b9659377c4badb7b78", "git_parents": ["59bf082b91045fb068e22da267741dedce106f9e"], "node": "b946d5f2880400e3ba88298d3093a1b6d239b1ba", "parents": ["80a00a685daf2f8b9fb2aa55a453662a616f6261"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b1cc7a291e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b1cc7a291e3869a2c8c271567ab3f526ca264411\n    Update WebRTC code version (2026-09-30T04:07:46).\n\n    Bug: None\n    Change-Id: Id13faa84226d601827615f2e16d79c82c95d4863\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506480\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48758}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "6b43096ffc39089a8e7e31a466f954da04690981", "git_parents": ["021864deb92d33495c99e9b9659377c4badb7b78"], "node": "fb61666444ffcb691df4282601bdc044398b368e", "parents": ["b946d5f2880400e3ba88298d3093a1b6d239b1ba"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 5c1e7fe157\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5c1e7fe15703f978a8db4e4d55b6f5c437b67133\n    Cap feedback interval to max_time_between_feedback if send BWE is zero\n\n    When send bandwidth estimate is zero and feedback is bandwidth limited,\n    set the next possible feedback send time to last_feedback_sent_time +\n    max_time_between_feedback. This avoids dividing by zero in debt pacing\n    while still respecting the maximum time between feedbacks.\n\n    Bug: webrtc:519655843\n    Change-Id: Id28188dd6e480636cbf15cea5ca150263791b8bc\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506360\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48759}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/remote_bitrate_estimator/congestion_control_feedback_generator.cc", "third_party/libwebrtc/modules/remote_bitrate_estimator/congestion_control_feedback_generator_unittest.cc"], "git_node": "82fee5adb3976ca6296b16476b8fc4a993f7dce2", "git_parents": ["6b43096ffc39089a8e7e31a466f954da04690981"], "node": "e6db35f49b299694d5c2f2dfbd4a9798145d57e9", "parents": ["fb61666444ffcb691df4282601bdc044398b368e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 29dcd43d32\n\nUpstream commit: https://webrtc.googlesource.com/src/+/29dcd43d32f217243ae92e9b437e59c767ccb3a5\n    Skip transport seq# and BWE callback for untransmitted packets.\n\n    When packet-\u003eallow_sending() is false in PacketRouter::SendPacket, skip\n    assigning a transport sequence number and skip invoking the BWE callback,\n    while still assigning the RTP sequence number and forwarding the packet\n    to the RTP module.\n\n    Bug: webrtc:564720400\n    Change-Id: I4c6b2f122f78b36865ce58c3c659146ee5a249b1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506320\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48760}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/pacing/packet_router.cc", "third_party/libwebrtc/modules/pacing/packet_router_unittest.cc"], "git_node": "87d64898f0a0ad78c729646387c9c2a8ed4e5d53", "git_parents": ["82fee5adb3976ca6296b16476b8fc4a993f7dce2"], "node": "34ec06364dc8bd81c89a5a8c04c44fff2adb1242", "parents": ["e6db35f49b299694d5c2f2dfbd4a9798145d57e9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 1b623e52e3\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1b623e52e3e7fbbc3c75e6b78b15108a13bd475c\n    PipeWire capturer: keep the persist mode with the restore token\n\n    BaseCapturerPipeWire always asks the ScreenCast portal for\n    persist_mode \"transient\" and remembers the token it gets back in\n    RestoreTokenManager under the capturer's SourceId, so that a second\n    capturer selecting that SourceId reopens the session without another\n    portal dialog. The persist mode is not remembered, so a token that was\n    issued as \"persistent\" is restored with \"transient\". xdg-desktop-portal\n    drops the stored grant when a token is used and saves it again with\n    the persist mode of that request, so the grant moves from the\n    permission store into memory and no longer survives a restart of the\n    application. An embedder that wants to keep the user's choice across\n    launches, which ScreenCast version 4 supports, has no way to get or\n    keep a persistent token through this capturer.\n\n    Store the persist mode next to the token in RestoreTokenManager and\n    have Start() request the stored mode when it restores an entry, so a\n    persistent token stays persistent. AddToken() defaults to kTransient,\n    which is what the capturer records for tokens it obtained itself, so\n    current callers behave as before. AddToken() also now replaces an\n    existing entry instead of insert()ing, which kept the first token for\n    a SourceId. The ScreenCast documentation makes restore tokens single\n    use and says to continue with the one Start returns.\n    xdg-desktop-portal 1.18 returns the same string, so keeping the first\n    one has not mattered there.\n\n    The enum moves from ScreenCastPortal to\n    modules/portal/screencast_persist_mode.h, with\n    ScreenCastPortal::PersistMode kept as an alias, so that\n    restore_token_manager.h does not have to include screencast_portal.h.\n\n    An embedder can seed an entry with kPersistent (and a token saved from\n    an earlier run, if it has one) under a SourceId, either a new one from\n    GetUnusedId() or the one a capturer reports in GetSourceList(), call\n    SelectSource() with it before Start(), and read the token back with\n    GetEntry() once the capture has started.\n\n    Tested on GNOME 46 with xdg-desktop-portal 1.18.4 (ScreenCast version\n    5). With a kPersistent entry the portal dialog is shown on the first\n    launch only, the token lands in the permission store, and later\n    launches restore the session without a dialog. Restoring that token\n    with kTransient instead, which is what the capturer did before this\n    change, returns the same token but removes it from the permission\n    store, and the next launch shows the dialog again. With no entry the\n    dialog is shown on every launch, as before.\n\n    Bug: webrtc:566241633\n    Change-Id: I2562a7b92f11a01f655c51f5d5b546a83ee98819\n\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505860\n    Reviewed-by: Jan Grulich \u003cjgrulich@redhat.com\u003e\n    Reviewed-by: Johannes Kron \u003ckron@webrtc.org\u003e\n    Commit-Queue: Shelley Vohr \u003cshelley.vohr@gmail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48761}\n", "files": ["third_party/libwebrtc/AUTHORS", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/desktop_capture/BUILD.gn", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/base_capturer_pipewire.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/restore_token_manager.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/restore_token_manager.h", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/restore_token_manager_unittest.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/screencast_portal.h", "third_party/libwebrtc/modules/portal/BUILD.gn", "third_party/libwebrtc/modules/portal/screencast_persist_mode.h", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0073.patch", "third_party/libwebrtc/moz-patch-stack/s0091.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0103.patch", "third_party/libwebrtc/moz-patch-stack/s0108.patch"], "git_node": "fd4c12943aaf825cca104d015ced6a1635643f0f", "git_parents": ["87d64898f0a0ad78c729646387c9c2a8ed4e5d53"], "node": "83b75ccb39436c72bdd08bc198b374489c145429", "parents": ["34ec06364dc8bd81c89a5a8c04c44fff2adb1242"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 3256978944\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3256978944de550e38945644510f150803f58307\n    Reland \"Report parsed key id on SFrame unknown-key decrypt failures\"\n\n    This reverts commit 31957526b2008c7bcefc12f8d7c394251acfc5e4.\n\n    Reason for revert: downstream sframe version is updated\n\n    Original change's description:\n    \u003e Revert \"Report parsed key id on SFrame unknown-key decrypt failures\"\n    \u003e\n    \u003e This reverts commit 43f5a1c963381978d29a2f2b85633bb9ad7303f5.\n    \u003e\n    \u003e Reason for revert: Breaks downstream build\n    \u003e\n    \u003e\n    \u003e Original change's description:\n    \u003e \u003e Report parsed key id on SFrame unknown-key decrypt failures\n    \u003e \u003e\n    \u003e \u003e `ToSframeDecryptFailure` previously mapped `invalid_parameter_error` to\n    \u003e \u003e a `kKeyId` failure with an empty key id, because the Cisco Sframe\n    \u003e \u003e library did not surface the key id parsed from the SFrame header.\n    \u003e \u003e\n    \u003e \u003e The library now returns a dedicated\n    \u003e \u003e `SFrameErrorType::unknown_key_id_error` carrying the parsed key id, so\n    \u003e \u003e the mapping is switched over to it and the key id is propagated into\n    \u003e \u003e `SframeDecryptFailure::KeyId`. Applications listening for\n    \u003e \u003e `SframeDecryptErrorCallback` can now tell *which* key is missing,\n    \u003e \u003e matching\n    \u003e \u003e [SFrameTransformErrorEvent.keyID](https://w3c.github.io/webrtc-encoded-transform/#dom-sframetransformerrorevent-keyid).\n    \u003e \u003e\n    \u003e \u003e `invalid_parameter_error` now falls through to the `kSyntax` default,\n    \u003e \u003e which is the correct classification for a malformed header.\n    \u003e \u003e\n    \u003e \u003e Additional changes:\n    \u003e \u003e - Re-enabled `SframeEncryptorDecryptorTest.DISABLED_DecryptReportsKeyIdErrorForUnknownKey`\n    \u003e \u003e   and tightened it to assert the reported key id equals the encryption key id.\n    \u003e \u003e\n    \u003e \u003e Bug: webrtc:479862368\n    \u003e \u003e Change-Id: I5af6c6b42f1fe46acbdeba6168d4a20f1f8a0869\n    \u003e \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506020\n    \u003e \u003e Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    \u003e \u003e Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e \u003e Cr-Commit-Position: refs/heads/main@{#48732}\n    \u003e\n    \u003e Bug: webrtc:479862368\n    \u003e No-Presubmit: true\n    \u003e No-Tree-Checks: true\n    \u003e No-Try: true\n    \u003e Change-Id: I8d7a55bf4b80a8027853178664e88732ca3f2915\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506120\n    \u003e Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    \u003e Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    \u003e Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48738}\n\n    Bug: webrtc:479862368\n    Change-Id: Ic444f567a0fd54bfbc1dd311dfe5fdf97b49486b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506660\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48762}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/sframe/sframe_decryptor.cc", "third_party/libwebrtc/modules/sframe/sframe_encryptor_decryptor_unittest.cc"], "git_node": "8495f6b26e887ee8213c22a6a37a97b76229d87b", "git_parents": ["fd4c12943aaf825cca104d015ced6a1635643f0f"], "node": "f6ef0e1d48595b55125d9f97cee9a6dcbf823560", "parents": ["83b75ccb39436c72bdd08bc198b374489c145429"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 2137391437\n\nUpstream commit: https://webrtc.googlesource.com/src/+/21373914377a9c6f7394949455d75b65baa80288\n    Allow retransmission of packets flushed on keyframe\n\n    Currently, when a keyframe arrives and packet queues are flushed in\n    PacingController, queued media packets are silently discarded. This\n    prevents receivers that want all frames (even with delay) from\n    requesting retransmissions for those frames.\n\n    This change modifies queue flushing so that instead of deleting packets:\n    1. PrioritizedPacketQueue::RemovePacketsForSsrc returns the dequeued\n    packets.\n\n    2. PacingController marks these flushed packets with a new do_not_send\n    flag and forwards them to the packet sender.\n\n    3. RtpSenderEgress drops transmission to the network and skips send-time\n    header extensions for do_not_send packets, but still stores them in\n    RtpPacketHistory. 4. RtpPacketHistory calculates the earliest allowed\n    retransmission time as now + 2*RTT (or a default of 200ms RTT if not yet\n    set), flips do_not_send back to false so retransmissions can be sent,\n    and enforces the delayed retransmission window.\n\n    Bug: webrtc:564720400\n    Change-Id: I640e773f79c38e3855400b584666fd9dcf82fdf1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/503740\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48763}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/pacing/BUILD.gn", "third_party/libwebrtc/modules/pacing/pacing_controller.cc", "third_party/libwebrtc/modules/pacing/pacing_controller.h", "third_party/libwebrtc/modules/pacing/pacing_controller_unittest.cc"], "git_node": "897a7b9afd37eb64b5117c14cd68d2f93cb71ebe", "git_parents": ["8495f6b26e887ee8213c22a6a37a97b76229d87b"], "node": "a0e8587427364eacc698e61d08625babd9842f91", "parents": ["f6ef0e1d48595b55125d9f97cee9a6dcbf823560"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b3a6f9baee\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b3a6f9baeed72d4766676176f2f4c9a9594d3a3c\n    Update WebRTC code version (2026-10-01T04:10:54).\n\n    Bug: None\n    Change-Id: I37dd4e5c5040a39f3f6b9ddd1d506fbf13706009\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506800\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48764}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "21ab59b9651e6f4bab6f79b5892f05ee595caf53", "git_parents": ["897a7b9afd37eb64b5117c14cd68d2f93cb71ebe"], "node": "3aef5b4d4b7507e06bdeabb7c915ffdf6020d635", "parents": ["a0e8587427364eacc698e61d08625babd9842f91"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 85189b1e77\n\nUpstream commit: https://webrtc.googlesource.com/src/+/85189b1e776697afdd40532ad8c7129f8486f8f8\n    Reduce per-event overhead in video timing simulator\n\n    This change reduces the number of copies of various objects in the video\n    timing simulator. Rough profiling shows speedups by around 10%.\n\n    Bug: b/423646186\n    Change-Id: I1e44a945e91ad54525fdf136de875ddcb068f3ea\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506720\n    Commit-Queue: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48765}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/video/timing/simulator/decodability_simulator.cc", "third_party/libwebrtc/video/timing/simulator/rendering_simulator.cc", "third_party/libwebrtc/video/timing/simulator/rtc_event_log_driver.cc", "third_party/libwebrtc/video/timing/simulator/rtp_packet_simulator.cc"], "git_node": "fa36f4dd654011bad060df892a12e5298231bddd", "git_parents": ["21ab59b9651e6f4bab6f79b5892f05ee595caf53"], "node": "3f217b031c7cec5709ee173c1aa7513c47543360", "parents": ["3aef5b4d4b7507e06bdeabb7c915ffdf6020d635"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b753a9ab31\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b753a9ab31c500fe76f1fd75a53f9cd11f80e4c9\n    convert rtc_test to rtc_test_suite\n\n    Change-Id: Iec2b2a2909e8763947b7e3155c50816f2ee42efd\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506460\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48766}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/common_audio/BUILD.gn", "third_party/libwebrtc/common_video/BUILD.gn", "third_party/libwebrtc/media/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0054.patch", "third_party/libwebrtc/moz-patch-stack/s0081.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0097.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/net/dcsctp/BUILD.gn", "third_party/libwebrtc/net/dcsctp/common/BUILD.gn", "third_party/libwebrtc/net/dcsctp/fuzzers/BUILD.gn", "third_party/libwebrtc/net/dcsctp/packet/BUILD.gn", "third_party/libwebrtc/net/dcsctp/public/BUILD.gn", "third_party/libwebrtc/net/dcsctp/rx/BUILD.gn", "third_party/libwebrtc/net/dcsctp/socket/BUILD.gn", "third_party/libwebrtc/net/dcsctp/timer/BUILD.gn", "third_party/libwebrtc/net/dcsctp/tx/BUILD.gn"], "git_node": "703a1204ddab431003653a30497c769c78ab5907", "git_parents": ["fa36f4dd654011bad060df892a12e5298231bddd"], "node": "92e0642b3620e51b2b8e12c47b549e6298335455", "parents": ["3f217b031c7cec5709ee173c1aa7513c47543360"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f05bb80d55\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f05bb80d55b6ba6a90d37f2ecc37917a34317f1f\n    cryptex: do not allow changes to the policy\n\n    changed in\n      https://github.com/w3c/webrtc-extensions/pull/256\n\n    Bug: webrtc:455813732\n    Change-Id: Ie5266a788709e1d4bc05d99724a8f222b2b8b67b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506760\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48767}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/peer_connection_interface_unittest.cc"], "git_node": "933b2ca8014ee5d7aa387b63dfd137ade4654876", "git_parents": ["703a1204ddab431003653a30497c769c78ab5907"], "node": "8a41e6810a6890eb55ec40ad1fe8852de100bae7", "parents": ["92e0642b3620e51b2b8e12c47b549e6298335455"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 7a25e1c85a\n\nWe already cherry-picked this when we vendored 6306c66dfc.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7a25e1c85a0af15cae8a2d55bf02e5610bf1af53\n    Keep transceiver MID in sync with its channel\n\n    When applying a local description, a transceiver could be matched to an\n    m= section by its index even if it was already associated with a\n    different MID. The channel of the transceiver keeps using the MID it was\n    created for, so the two could get out of sync.\n\n    - Only match transceivers that are not yet associated by m= section\n      index.\n    - Route transport changes to a transceiver based on the MID of its\n      channel.\n\n    Bug: chromium:567160162\n    Change-Id: Ic9f29b66a8f9f181fd414009f5c1e5cebfa9ca54\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506421\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48768}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/7a25e1c85a.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "17cecab5f764ec00ffaed59bdbf9a5252b7d4744", "git_parents": ["933b2ca8014ee5d7aa387b63dfd137ade4654876"], "node": "6d38431ae56fac7b88f70b132c463836748ef677", "parents": ["8a41e6810a6890eb55ec40ad1fe8852de100bae7"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from cce2f149ea\n\nUpstream commit: https://webrtc.googlesource.com/src/+/cce2f149ea7dd912ea0e81eae2973aea8c89cdb9\n    Reland \"RtpSender: Create the Sframe encryptor and hand out a worker proxy\"\n\n    This reverts commit 348e5ff7247ceffe58d8fa3daf8fb917d74f68c9.\n\n    Reason for revert: Sframe library updated to support std::span\n\n    Original change's description:\n    \u003e Revert \"RtpSender: Create the Sframe encryptor and hand out a worker proxy\"\n    \u003e\n    \u003e This reverts commit 8354b7c19d32a3dbe7268319af6085e6ec9ec099.\n    \u003e\n    \u003e Reason for revert: breaks webrtc-internal bot. Compile error in sframe\n    \u003e\n    \u003e Failure Link: https://fusion2.corp.google.com/invocations/e9a2a344-3234-4d69-a6e9-b95f8700b396/targets/%2F%2Fthird_party%2Fwebrtc:webrtc_all_cc/log?q=label:session_id%3Dbtbs-224212c0-8627-4ddc-9137-60e85c0d9b6c\n    \u003e\n    \u003e Original change's description:\n    \u003e \u003e RtpSender: Create the Sframe encryptor and hand out a worker proxy\n    \u003e \u003e\n    \u003e \u003e Implements `RtpSenderBase::CreateSframeEncryptorOrError`\n    \u003e \u003e\n    \u003e \u003e When called, it creates a `SframeEncryptor` on the worker thread and \u2014\n    \u003e \u003e if an SSRC is already assigned \u2014 immediately pushes it to the media\n    \u003e \u003e channel via `SetSframeEncryptor`. If the SSRC is not yet known,\n    \u003e \u003e `SetSsrc` is updated to push the encryptor to the channel once an SSRC\n    \u003e \u003e is assigned.\n    \u003e \u003e\n    \u003e \u003e The returned `SframeEncryptorInterface` is wrapped in a new\n    \u003e \u003e `SframeEncryptorProxy` that marshals `SetEncryptionKey` calls to the\n    \u003e \u003e worker thread, so callers can safely invoke it from any other thread.\n    \u003e \u003e\n    \u003e \u003e Bug: webrtc:479862368\n    \u003e \u003e Change-Id: Ic647c4658fa672c820d09a13c34ee0b158f3ae89\n    \u003e \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493780\n    \u003e \u003e Commit-Queue: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    \u003e \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e \u003e Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    \u003e \u003e Cr-Commit-Position: refs/heads/main@{#48542}\n    \u003e\n    \u003e Bug: webrtc:479862368\n    \u003e No-Presubmit: true\n    \u003e No-Tree-Checks: true\n    \u003e No-Try: true\n    \u003e Change-Id: I7e24587bf67f8f4a5f85a29c672fbccc22a566b8\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/501520\n    \u003e Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    \u003e Owners-Override: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    \u003e Commit-Queue: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48544}\n\n    Bug: webrtc:479862368\n    Change-Id: Ie82d63b86651fc55703e38f5017f02c97c286b7b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506100\n    Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48769}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/BUILD.gn", "third_party/libwebrtc/media/DEPS", "third_party/libwebrtc/media/base/fake_media_engine.h", "third_party/libwebrtc/media/base/media_channel.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.h", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/DEPS", "third_party/libwebrtc/pc/rtp_sender.cc", "third_party/libwebrtc/pc/rtp_sender.h", "third_party/libwebrtc/pc/rtp_sender_receiver_unittest.cc"], "git_node": "e2dc4cf508721883c5ba705affaea2f5f837314d", "git_parents": ["17cecab5f764ec00ffaed59bdbf9a5252b7d4744"], "node": "ca6f4885517369899ba337273e9bab70f636c129", "parents": ["6d38431ae56fac7b88f70b132c463836748ef677"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from cce2f149ea - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/api/sframe_encryptor_interface_gn/moz.build", "third_party/libwebrtc/api/sframe_types_gn/moz.build", "third_party/libwebrtc/modules/sframe/sframe_media_encryptor_interface_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": "2baf70d1debf15089b8a4dbb2aaa78ba82aa6689", "git_parents": ["e2dc4cf508721883c5ba705affaea2f5f837314d"], "node": "ff74cf86af592c8f6d2032b05e201c0e3951a797", "parents": ["ca6f4885517369899ba337273e9bab70f636c129"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 1019e87d33\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1019e87d33f5875f00a520afdaab6a52e0fdddc1\n    Wait for frame delivery to stop in Android codec release\n\n    release() of AndroidVideoDecoder and HardwareVideoEncoder now returns\n    only after the output thread has stopped delivering frames. Only the\n    release of the MediaCodec itself remains subject to a timeout. Each\n    output thread now releases the codec instance it was created for.\n\n    The callbacks that the native video decoder and encoder wrappers pass to\n    the Java codecs are now invalidated on release, reconfiguration and\n    destruction. Frames delivered after invalidation are dropped.\n\n    Bug: chromium:558966896\n    Change-Id: I300664aad56bbc9e98bdbde72a54c7a641a51ccd\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506620\n    Reviewed-by: Zo\u00e9 Lepaul \u003czlep@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48770}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/AndroidVideoDecoder.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/HardwareVideoEncoder.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/VideoDecoderWrapper.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/VideoEncoderWrapper.java"], "git_node": "49b3ce011104bef529ec49a6c864b416c93bf5fe", "git_parents": ["2baf70d1debf15089b8a4dbb2aaa78ba82aa6689"], "node": "351ae5fc1c138c31d00d49cc2139dabecdff10fa", "parents": ["ff74cf86af592c8f6d2032b05e201c0e3951a797"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 66fe413129\n\nUpstream commit: https://webrtc.googlesource.com/src/+/66fe413129336b18eb0f329e40a9fabc9b867ec6\n    PipeWire capturer: forget a restore token the portal did not renew\n\n    ScreenCastPortal only updates restore_token_ when the Start response\n    has a \"restore_token\". When the response has none, the token that was\n    passed in stays, and BaseCapturerPipeWire stores it in\n    RestoreTokenManager again. That token is already dead:\n    xdg-desktop-portal deletes a token as soon as it is used, so the next\n    capturer for that SourceId sends it for nothing.\n\n    Clear restore_token_ before reading the Start response, and always\n    record the result, so an empty token replaces the stale one. The entry\n    keeps its persist mode. A capturer that finds no token gets the portal\n    dialog, as it did when it sent the dead one.\n\n    Tested against a mock ScreenCast portal with a real PipeWire daemon.\n    With no token in the Start response the entry is now empty and a second\n    capturer sends none. A successful restore behaves as before.\n\n    Bug: webrtc:566241633\n    Change-Id: I95ce2fe2bc45a693fd45285ac7d6a2e384ae0422\n\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506700\n    Reviewed-by: Jan Grulich \u003cjgrulich@redhat.com\u003e\n    Commit-Queue: Shelley Vohr \u003cshelley.vohr@gmail.com\u003e\n    Reviewed-by: Johannes Kron \u003ckron@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48771}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/base_capturer_pipewire.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/restore_token_manager.h", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/screencast_portal.cc"], "git_node": "84aec61ab17386ba8b0d287c0fc08ffef0b9a7fe", "git_parents": ["49b3ce011104bef529ec49a6c864b416c93bf5fe"], "node": "9735c7d10529911336d987f1694157f88fe99dae", "parents": ["351ae5fc1c138c31d00d49cc2139dabecdff10fa"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from a5c2980e06\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a5c2980e061f305e18180118f2edf4936ee9da3b\n    Set RtpVideoSender payload state in init list\n\n    The constructor default-initialized params_ and shared_frame_id_ and\n    then filled them in with a loop in its body. Compute both with helpers\n    in the initializer list instead. No behavior change.\n\n    Using `No-try` since the win_x86_more_configs bot keeps timing out.\n\n    Bug: webrtc:42223727\n    No-try: true\n    Change-Id: Id05861d0598acf54075d1235888255c54ac058b0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506180\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48772}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "99e2371825e36b87958b41da41c681b3409b30e1", "git_parents": ["84aec61ab17386ba8b0d287c0fc08ffef0b9a7fe"], "node": "87e4fac33392b3ac856b1e18b49e16a7db0d9b47", "parents": ["9735c7d10529911336d987f1694157f88fe99dae"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 1a29be5e63\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1a29be5e6348e68cac08449d5f0fc5fd3ab666a3\n    Configure RtpVideoSender modules at creation\n\n    The constructor body and ConfigureSsrcs() configured the RTP modules in\n    several passes after rtp_streams_ had been constructed. Configure each\n    module right after creating it instead, with the same per-module call\n    order, so that rtp_streams_ is fully set up once it's constructed. This\n    removes ConfigureSsrcs() and most of the constructor body.\n\n    Bug: webrtc:42223727\n    Change-Id: I91f9329584d07fc07a9b3d1e471183387bc1cd67\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506200\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48773}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "114cc4162dc1f059fdb7073b3af0df4cbd05315d", "git_parents": ["99e2371825e36b87958b41da41c681b3409b30e1"], "node": "35fcbcb113edfc8c6998bb5dec058f71c3cbf785", "parents": ["87e4fac33392b3ac856b1e18b49e16a7db0d9b47"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b9d2649d7e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b9d2649d7eaf03f013b07cd9b93db73b1e4921af\n    Update WebRTC code version (2026-10-02T04:10:39).\n\n    Bug: None\n    Change-Id: Iffd4c05243ec5cc49fa1cd28737627f4547c8d1e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506960\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48774}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "88837f9659b4fcf2cfb7df91f3b29bbfa5087d1a", "git_parents": ["114cc4162dc1f059fdb7073b3af0df4cbd05315d"], "node": "a519066ca6270f9d8de2dc480da77009431dd1e3", "parents": ["35fcbcb113edfc8c6998bb5dec058f71c3cbf785"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from a4a13a6690\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a4a13a6690591c017b5ad2ae6649fa2437ba8bff\n    dcsctp: Defer all streams when resetting with empty stream list\n\n    Per RFC 6525 Section 5.2.2 (E3), an Outgoing SSN Reset Request parameter\n    with an empty list of stream numbers indicates that all incoming streams\n    shall be reset. When entering deferred reset processing with an empty\n    stream list, ReassemblyQueue::Add must defer incoming data for all\n    streams with a higher TSN than the last assigned.\n\n    Bug: webrtc:568271571\n    Change-Id: I150e54f852ae3f35e9a61a1134bdf0f917c7e2e0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506921\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48775}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/net/dcsctp/rx/reassembly_queue.cc", "third_party/libwebrtc/net/dcsctp/socket/stream_reset_handler_test.cc"], "git_node": "74cffec6998d0d2b66032784a44ec401bed84fd4", "git_parents": ["88837f9659b4fcf2cfb7df91f3b29bbfa5087d1a"], "node": "28dd6af8507120f622f36c368c04ccd96da45563", "parents": ["a519066ca6270f9d8de2dc480da77009431dd1e3"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 92ca2b48d6\n\nUpstream commit: https://webrtc.googlesource.com/src/+/92ca2b48d607703a9847acbdd58c421c944e902a\n    Add bidirectional audio test and improve SCReAM test coverage\n\n    1. Refactor SendMediaInOneDirection to SendMedia to support bidirectional\n       media and optional adaptive ptime.\n    2. Add CreateNetworkPathWithVaryingCapacity helper.\n    3. Add AvailableSendBitrateIsZeroOrBetween matcher.\n    4. Add AudioOnlyBothDirectionsLinkCapacity40To90KbpsRtt200ms test.\n    5. Increase accepted BWE upper bound in LowBweOnLinkWith5PercentUniformLoss\n       to avoid test flakiness.\n    6. Update SendVideoOnlyReturnLinkWithBurstLoss to handle temporary zero\n       BWE when feedback packets are lost and encoder pauses.\n\n    Bug: webrtc:447037083\n    Change-Id: I4c9613f83212422c6f012ea4eadf5a4e7b170669\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506920\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48776}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/test/peer_scenario/bwe_integration_tests/scream_test.cc"], "git_node": "70e8dfa040c27b978d94ce49f529407f27e2d7c0", "git_parents": ["74cffec6998d0d2b66032784a44ec401bed84fd4"], "node": "d48bc3e65cc60472599477b982868c2eeae4147c", "parents": ["28dd6af8507120f622f36c368c04ccd96da45563"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 6214048b9d\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in 85c85734ee.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6214048b9dccb3abf7e1ab858396c4cfb0849703\n    SCReAM: Scale backoff by feedback interval and reset ref window on congestion\n\n    This CL:\n    1. Tracks feedback interval in ScreamV2 and scales backoff relative\n       to effective virtual RTT (max of virtual RTT and feedback interval)\n       to account for how often feedback actually arrives. This avoids\n       stalled backoff during low bitrate audio with large feedback intervals.\n    2. Clamps the reference window to data in flight on first congestion\n       in delay-based congestion control to eliminate initial rampup overshoot.\n    3. Adds 'FeedbackIntervalAvgG' and 'UseFeedbackIntervalForVirtualRtt'\n       parameters to ScreamV2Parameters.\n    4. Tightens expectations in AudioOnlyBothDirectionsLinkCapacity40To90KbpsRtt200ms\n       to reflect lower RTT and tighter BWE.\n\n    Bug: webrtc:447037083\n    Change-Id: I79d8cfff9e4ac034d8192a3668ea3342812ce141\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506900\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48777}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/85c85734ee.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "902386cc2307e522762b1ca9f6f7e9c3efb8eb5c", "git_parents": ["70e8dfa040c27b978d94ce49f529407f27e2d7c0"], "node": "916f8625fef6a0ef77c6e7d2a120a98d56050c86", "parents": ["d48bc3e65cc60472599477b982868c2eeae4147c"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f74d53d8a6\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f74d53d8a6f789d9df904b1e5edf788af690406e\n    Pass initial video CSRCs via RtpConfig\n\n    WebRtcVideoSendStream called SetCsrcs() right after creating the\n    VideoSendStream to apply the CSRCs from the RTP parameters. Add a csrcs\n    field to RtpConfig, like AudioSendStream::Config::Rtp::csrcs, and pass\n    them at creation instead, so that RtpVideoSender is initialized with\n    them. SetCsrcs() is still used for updates from setParameters().\n\n    Bug: webrtc:42223727\n    Change-Id: Id34d8c8d46b6ad63fa0150c7892b029f5fc6a30d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506220\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48778}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/rtp_config.cc", "third_party/libwebrtc/call/rtp_config.h", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0102.patch"], "git_node": "5f90adb909538e1f3834686024fd66d37d03bba1", "git_parents": ["902386cc2307e522762b1ca9f6f7e9c3efb8eb5c"], "node": "912353300b8f07fc51172ddda7ca9193679bfd34", "parents": ["916f8625fef6a0ef77c6e7d2a120a98d56050c86"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 85c85734ee\n\nWe already cherry-picked this when we vendored 6214048b9d.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/85c85734ee3001ca7304237c6b7a0003ecfe1d29\n    Revert \"SCReAM: Scale backoff by feedback interval and reset ref window on congestion\"\n\n    This reverts commit 6214048b9dccb3abf7e1ab858396c4cfb0849703.\n\n    Reason for revert: Downstream failures\n\n    Failure Link: Link shared over chat\n\n    Original change's description:\n    \u003e SCReAM: Scale backoff by feedback interval and reset ref window on congestion\n    \u003e\n    \u003e This CL:\n    \u003e 1. Tracks feedback interval in ScreamV2 and scales backoff relative\n    \u003e    to effective virtual RTT (max of virtual RTT and feedback interval)\n    \u003e    to account for how often feedback actually arrives. This avoids\n    \u003e    stalled backoff during low bitrate audio with large feedback intervals.\n    \u003e 2. Clamps the reference window to data in flight on first congestion\n    \u003e    in delay-based congestion control to eliminate initial rampup overshoot.\n    \u003e 3. Adds 'FeedbackIntervalAvgG' and 'UseFeedbackIntervalForVirtualRtt'\n    \u003e    parameters to ScreamV2Parameters.\n    \u003e 4. Tightens expectations in AudioOnlyBothDirectionsLinkCapacity40To90KbpsRtt200ms\n    \u003e    to reflect lower RTT and tighter BWE.\n    \u003e\n    \u003e Bug: webrtc:447037083\n    \u003e Change-Id: I79d8cfff9e4ac034d8192a3668ea3342812ce141\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506900\n    \u003e Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    \u003e Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48777}\n\n    Bug: webrtc:447037083\n    No-Presubmit: true\n    No-Tree-Checks: true\n    No-Try: true\n    Change-Id: Id9bcc80855c272e447938b99708d6565b379857c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507060\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48779}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/85c85734ee.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "2fa2550441b1e0b49141d4258489b625b3b1275d", "git_parents": ["5f90adb909538e1f3834686024fd66d37d03bba1"], "node": "5a534642eb411d1aad7d59c8fd2a944a6415d203", "parents": ["912353300b8f07fc51172ddda7ca9193679bfd34"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 177b9424bf\n\nUpstream commit: https://webrtc.googlesource.com/src/+/177b9424bf7ce9d1dfb788f5600f667976ed1f58\n    Tidy up RtpVideoSender member initialization\n\n    protection_bitrate_bps_ wasn't initialized until the first\n    OnBitrateUpdated() call. Initialize it to 0, and move the other constant\n    initial values from the initializer list to default member initializers.\n    Also remove two private methods that were declared but never defined.\n\n    Bug: webrtc:42223727\n    Change-Id: I2150cf6b0df7b5ef47ed57fb9f1e4d1e3a3606fd\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506181\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48780}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "105789af65d4967f952eccfd2e3d84d96bfc5b6b", "git_parents": ["2fa2550441b1e0b49141d4258489b625b3b1275d"], "node": "3d0f96d348b75a3668d76003bf672343a5e6f592", "parents": ["5a534642eb411d1aad7d59c8fd2a944a6415d203"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 8417cc7cb9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8417cc7cb9ec2893619d89533ec9064d7f09c802\n    Make RTPSender's max packet size thread safe\n\n    SetMaxRtpPacketSize() writes the max packet size under send_mutex_ on\n    the worker thread, but SendVideoFrame() read it on the encoder's thread\n    via MaxRtpPacketSize() without the lock, and then allocated the packet\n    in a separate step. RtpVideoSender only avoids a race by holding its own\n    mutex around both calls.\n\n    Derive the packetization limits from the capacity of the allocated\n    packet, which AllocatePacket() sets from the max packet size under the\n    lock, so that the two always agree. Also take the lock in\n    MaxRtpPacketSize(). This allows RtpVideoSender to update the max packet\n    size without holding its mutex.\n\n    Bug: webrtc:42223727\n    Change-Id: Ie14899c8e48877883d6339c3f2a03af7fb8a1671\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506161\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48781}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0048.patch"], "git_node": "117c472d7b1a487e00934cce08c379e936e7ec87", "git_parents": ["105789af65d4967f952eccfd2e3d84d96bfc5b6b"], "node": "c18eedc6b90b301adfe454fe909245d7287dabe1", "parents": ["3d0f96d348b75a3668d76003bf672343a5e6f592"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from d5736b9f5f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d5736b9f5fa0a76d9d487fb3fad5435d79999122\n    Propagate Sframe options from media channels to the Video RTP send path\n\n    WebRtcVideoSendChannel::EnableSframe() and\n    WebRtcVideoReceiveChannel::EnableSframe() previously only flipped a\n    local flag with a TODO; nothing below the media channel could observe\n    it. This CL plumbs the Sframe options from the media channels down to\n    the video RTP senders.\n\n    Changes:\n\n    - VideoSendStream::Config gains an SframeSendOptions field and\n      VideoReceiveStreamInterface::Config gains an SframeReceiveOptions field.\n      Both are populated from the media channel when a stream is created, and\n      the receive config copies the field in Config::Copy().\n    - RtpTransportControllerSendInterface::CreateRtpVideoSender() takes the send\n      options and forwards them through RtpVideoSender into\n      RTPSenderVideo::Config::sframe_required.\n    - RTPSenderVideo::SendEncodedImage() fails closed: when Sframe is required\n      the frame is dropped instead of being sent in the clear. The encryptor is\n      not wired up yet, so today this drops every frame on an Sframe-enabled\n      stream.\n    - WebRtcVideoSendChannel::EnableSframe() pushes the new options to already\n      created send streams via WebRtcVideoSendStream::UpdateSframeOptions(),\n      which recreates the underlying VideoSendStream. Receive streams still only\n      pick the options up at construction; pushing to live receive streams needs\n      a setter on VideoReceiveStreamInterface and is left as a TODO.\n\n    The audio path is intentionally untouched and will be handled\n    separately.\n\n    Tests: new unit tests cover that Sframe is off by default, that enabling\n    it before AddSendStream()/AddRecvStream() reaches the stream config, and\n    that RTPSenderVideo drops encoded images when Sframe is required but no\n    encryptor is present.\n\n    Bug: webrtc:479862368\n    Change-Id: I40d8298f7a4e4054ef3306dc05d13867a6bf3772\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506321\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48782}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/rtp_config.cc", "third_party/libwebrtc/call/rtp_config.h", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0102.patch"], "git_node": "7ae048c820c85715d1d82a11ea95920ec980ca23", "git_parents": ["117c472d7b1a487e00934cce08c379e936e7ec87"], "node": "a108fdc3ae4eea9e2059ba47d58ac7d81f162b44", "parents": ["c18eedc6b90b301adfe454fe909245d7287dabe1"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 79009acc2e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/79009acc2e8b2fa28f7ee914fade0117b616cf10\n    Remove match-any sink in RtpDemuxer::RemoveSink()\n\n    RemoveSink() removes a sink from all criteria maps but not from\n    match_any_sink_. A sink registered with RtpDemuxerCriteria::MatchAny()\n    therefore stays registered: RemoveSink() returns false, IsEmpty() stays\n    false, later AddSink() calls are rejected as conflicting, and packets\n    are still routed to the removed sink.\n\n    The only current user, DatagramConnectionInternal, unregisters its\n    match-any sink in Terminate(). Today that fails and logs an error, but\n    is otherwise harmless because the connection ignores packets after\n    termination.\n\n    Clear match_any_sink_ in RemoveSink() as well, consistent with\n    RemoveAllSinks().\n\n    Bug: none\n    Change-Id: I9d927a1daa86fce902920727829dcfc0d7d01278\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507021\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48783}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_demuxer.cc", "third_party/libwebrtc/call/rtp_demuxer_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0002.patch"], "git_node": "486fa7105b8e5be8e9a990ebcc402bbc86a6801b", "git_parents": ["7ae048c820c85715d1d82a11ea95920ec980ca23"], "node": "0340e61ddd1c680c39e6881afb3a292221b24def", "parents": ["a108fdc3ae4eea9e2059ba47d58ac7d81f162b44"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 538442a75d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/538442a75d7ed04c962f288f9aedc21562d22e6d\n    Move RtpVideoSender's worker-only state off mutex_\n\n    transport_overhead_bytes_per_packet_ and loss_mask_vector_ were guarded\n    by mutex_, and the bitrate members weren't annotated, even though all of\n    them are only accessed on the transport queue. Guard them with\n    transport_checker_ instead, and DCHECK that the methods called on the\n    transport queue run there.\n\n    OnPacketFeedbackVector() no longer takes mutex_. OnBitrateUpdated()\n    still does, for fec_allowed_, which is set on the encoder queue.\n\n    Bug: webrtc:42223727\n    Change-Id: Id24ed32d25e960fe1bcdadd0fe2f47278884d760\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506162\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48784}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "5bb2109103368e0ada2fef3905b12d87bba0dbf1", "git_parents": ["486fa7105b8e5be8e9a990ebcc402bbc86a6801b"], "node": "dce451ca4b893aff5a688c0945ee961d246b9770", "parents": ["0340e61ddd1c680c39e6881afb3a292221b24def"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b58dcf8fec\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b58dcf8fec3ad5291fb99c7e29650737ae7db953\n    Update WebRTC code version (2026-10-03T04:05:33).\n\n    Bug: None\n    Change-Id: Ib9d60117eb86b83c93966e22d9a43ad1e66fe8a8\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507080\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48785}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "f917dec1c191aac72639725caaed6b8c80a51162", "git_parents": ["5bb2109103368e0ada2fef3905b12d87bba0dbf1"], "node": "5ce1e4adc416808053263655c96980370ae56ed7", "parents": ["dce451ca4b893aff5a688c0945ee961d246b9770"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 7c6b661c15\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7c6b661c155102d160ab77af556b4a7d719da330\n    Update WebRTC code version (2026-10-05T04:08:09).\n\n    Bug: None\n    Change-Id: I786f645827010a096d1b1b104726e9b5d4f73891\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507420\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48786}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "3c60ebcaa9e5f1957e74d158e16a21a24c37e10b", "git_parents": ["f917dec1c191aac72639725caaed6b8c80a51162"], "node": "f348e576a6972bed4ae0841a0da5998ae01c2af7", "parents": ["5ce1e4adc416808053263655c96980370ae56ed7"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 1a16b16a89\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1a16b16a8993cd7a9ab2cd880dc8902d935a50c0\n    Move RTPSender's worker-only state off send_mutex_\n\n    supports_bwe_extension_ was guarded by send_mutex_, even though it is\n    only accessed on the worker thread. Guard it with a new worker_checker_\n    instead, and DCHECK that the methods that access it run there.\n    worker_checker_ is detached at construction and binds to the sequence of\n    the first such call, so RTPSender may still be constructed on another\n    thread. Methods that only access state shared with the media threads are\n    not restricted. SupportsPadding() now only takes the lock when a header\n    extension usable for bandwidth estimation is registered.\n\n    Code that uses RTPSender directly must now register header extensions\n    and generate padding on the same sequence.\n\n    Also document the threading model, and remove random_ (only used in the\n    constructor), unused declarations, obsolete TODOs and meaningless lock\n    annotations. The GeneratePadding() comment claimed that the lock is held\n    for the whole method, which is not the case. The RTX payload type map is\n    now a flat_map.\n\n    Bug: webrtc:42223727\n    Change-Id: I38e51349681ca54f2e4283d001fcae6c48004661\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507260\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48787}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.h", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0048.patch"], "git_node": "bed826a53a7937099eb0aea163bef8422123c32f", "git_parents": ["3c60ebcaa9e5f1957e74d158e16a21a24c37e10b"], "node": "38255e8d0e1a03d167fe5f7b1f38ef019f0664e1", "parents": ["f348e576a6972bed4ae0841a0da5998ae01c2af7"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 6c4d1eec22\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6c4d1eec2266a28ccb01b7493afad961baf0824e\n    Reland \"SCReAM: Scale backoff by feedback interval and reset ref window on congestion\"\n\n    This is a reland of commit 6214048b9dccb3abf7e1ab858396c4cfb0849703\n    Internal tests are fixed.\n\n    Original change's description:\n    \u003e SCReAM: Scale backoff by feedback interval and reset ref window on congestion\n    \u003e\n    \u003e This CL:\n    \u003e 1. Tracks feedback interval in ScreamV2 and scales backoff relative\n    \u003e    to effective virtual RTT (max of virtual RTT and feedback interval)\n    \u003e    to account for how often feedback actually arrives. This avoids\n    \u003e    stalled backoff during low bitrate audio with large feedback intervals.\n    \u003e 2. Clamps the reference window to data in flight on first congestion\n    \u003e    in delay-based congestion control to eliminate initial rampup overshoot.\n    \u003e 3. Adds 'FeedbackIntervalAvgG' and 'UseFeedbackIntervalForVirtualRtt'\n    \u003e    parameters to ScreamV2Parameters.\n    \u003e 4. Tightens expectations in AudioOnlyBothDirectionsLinkCapacity40To90KbpsRtt200ms\n    \u003e    to reflect lower RTT and tighter BWE.\n    \u003e\n    \u003e Bug: webrtc:447037083\n    \u003e Change-Id: I79d8cfff9e4ac034d8192a3668ea3342812ce141\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506900\n    \u003e Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    \u003e Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48777}\n\n    Bug: webrtc:447037083\n    Change-Id: I2c09879692744a39720a52b5916757a4797e1f05\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507460\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48788}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller_unittest.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.h", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_parameters.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_parameters.h", "third_party/libwebrtc/test/peer_scenario/bwe_integration_tests/scream_test.cc"], "git_node": "aa73524e66dbb18be044c32de076a39ff5b5cbab", "git_parents": ["bed826a53a7937099eb0aea163bef8422123c32f"], "node": "7614a2c5fcde01ad7e1f69a73be6924ee43ab0c5", "parents": ["38255e8d0e1a03d167fe5f7b1f38ef019f0664e1"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from cec66010cf\n\nUpstream commit: https://webrtc.googlesource.com/src/+/cec66010cf80ac39e06e3a04ddeb187339a2b82a\n    Make RtpVideoSender::OnBitrateUpdated lock-free\n\n    SetFecAllowed() is called by the encoder, and OnBitrateUpdated() reads\n    the value on the transport queue. This was the last reason for\n    OnBitrateUpdated() to take mutex_, which blocked the worker thread\n    whenever a bitrate update coincided with packetization of an encoded\n    frame.\n\n    Post the value to the transport queue instead and guard it with\n    transport_checker_. FecControllerOverride is public API, so this works\n    for calls from any thread.\n\n    Bug: webrtc:42223727\n    Change-Id: Iad4757cfd3092f39fda1086fcb942c3d56c5b8bf\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506163\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48789}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "e51a3bf54145bf186b72f02e3d44263b57edc162", "git_parents": ["aa73524e66dbb18be044c32de076a39ff5b5cbab"], "node": "83c1530b478bae254fd575aa896bea1e9398b9bb", "parents": ["7614a2c5fcde01ad7e1f69a73be6924ee43ab0c5"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from e5e2f8ce27\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e5e2f8ce27ce1d0f97ce145bf1d2410b7dc9aaff\n    Drop stale payload types in SetReceiveCodecs()\n\n    ChannelReceive::SetReceiveCodecs() adds entries to\n    payload_type_frequencies_ but never removes any, while payload_type_map_\n    and the NetEq decoders are replaced. After a renegotiation removes a\n    payload type, packets with that payload type still pass the filter in\n    OnRtpPacket(). They update the NACK tracker and the receive statistics,\n    and are only rejected later by NetEq.\n\n    Rebuild the map on every call so that it matches the negotiated codecs.\n\n    Bug: none\n    Change-Id: I1443aa2ce88efbd91eb10b5aef36f49d290755d1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506981\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Commit-Queue: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48790}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch"], "git_node": "45308897f68c8b0d3a7cf6ac706c4db2bf11f0d9", "git_parents": ["e51a3bf54145bf186b72f02e3d44263b57edc162"], "node": "4160c19a6c2bbe4921ee7669f8a23ffb36cb9b34", "parents": ["83c1530b478bae254fd575aa896bea1e9398b9bb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from aeb9b3750c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/aeb9b3750c30bd1189448138b6431b73116b1f56\n    Delete legacy FrameInstrumentationGenerator factory\n\n    Bug: webrtc:358039777\n    Change-Id: I505954049ba89417d4340f27e1552b4ad3ac75d5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507480\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48791}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video/corruption_detection/BUILD.gn", "third_party/libwebrtc/api/video/corruption_detection/frame_instrumentation_generator.cc", "third_party/libwebrtc/api/video/corruption_detection/frame_instrumentation_generator.h", "third_party/libwebrtc/api/video/corruption_detection/frame_instrumentation_generator_factory.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/video/BUILD.gn", "third_party/libwebrtc/video/corruption_detection/BUILD.gn", "third_party/libwebrtc/video/corruption_detection/frame_instrumentation_generator_impl.cc", "third_party/libwebrtc/video/corruption_detection/frame_instrumentation_generator_impl.h", "third_party/libwebrtc/video/corruption_detection/frame_instrumentation_generator_unittest.cc"], "git_node": "200f7556eca8865ded5842d3b952c546676efc2e", "git_parents": ["45308897f68c8b0d3a7cf6ac706c4db2bf11f0d9"], "node": "8b1dd98aaaa895044076577f5c370ee2c7027002", "parents": ["4160c19a6c2bbe4921ee7669f8a23ffb36cb9b34"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from aeb9b3750c - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/api/video/corruption_detection/frame_instrumentation_generator_gn/moz.build", "third_party/libwebrtc/api/video/corruption_detection/frame_instrumentation_generator_header_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": "4f83347ce55500141ff1471a394a0e1d8e2275dd", "git_parents": ["200f7556eca8865ded5842d3b952c546676efc2e"], "node": "60ab972b4442891f153ca14381ec0d9dd8faa7cd", "parents": ["8b1dd98aaaa895044076577f5c370ee2c7027002"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 5127540970\n\nUpstream commit: https://webrtc.googlesource.com/src/+/51275409707b65ed93598e76678b608881167165\n    Recognize all spellings of remote mDNS hostnames\n\n    Remote candidates with mDNS (.local) hostnames are not paired with relay\n    candidates, so that their resolved address isn't sent to the TURN\n    server, and their resolved address is concealed in stats. Both checks\n    compared the end of the hostname with \".local\" byte by byte. However,\n    DNS names are case-insensitive and may be written in fully qualified\n    form with a trailing dot. Names such as \"name.local.\" or \"NAME.LOCAL\"\n    are resolved using mDNS as well, so such candidates bypassed both\n    checks.\n\n    Add IsMdnsHostname(), which strips a trailing dot and compares the\n    .local suffix case-insensitively, and use it for both checks.\n\n    Bug: chromium:504576161\n    Change-Id: I3b3f30fbd0d10680e928a759c61755e4f0b07f57\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507180\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48792}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/BUILD.gn", "third_party/libwebrtc/p2p/base/p2p_constants.cc", "third_party/libwebrtc/p2p/base/p2p_constants.h", "third_party/libwebrtc/p2p/base/p2p_constants_unittest.cc", "third_party/libwebrtc/p2p/base/p2p_transport_channel.cc", "third_party/libwebrtc/p2p/base/p2p_transport_channel_unittest.cc", "third_party/libwebrtc/p2p/base/turn_port.cc"], "git_node": "ab20c25a66250a61fed022d600b5a402f89f1418", "git_parents": ["4f83347ce55500141ff1471a394a0e1d8e2275dd"], "node": "2c73d51226d51573c641e07123144672f9bebb8f", "parents": ["60ab972b4442891f153ca14381ec0d9dd8faa7cd"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from c54bdff86b\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c54bdff86bd44376a138ca14516ab7b5198a2e11\n    Remove VCMProtectionCallback::SetRetransmissionMode()\n\n    The method has no callers. Its only implementation, in RtpVideoSender,\n    forwarded the mode to RTPSenderVideo::SetRetransmissionSetting() under\n    mutex_ to serialize it with packetization of encoded frames, so removing\n    it also removes one of the remaining reasons for the mutex.\n\n    VCMProtectionCallback is public API, but there are no known callers or\n    implementations outside of WebRTC, and the header asks other users not\n    to use the API yet. Downstream implementations of VCMProtectionCallback\n    need to drop their SetRetransmissionMode() override.\n\n    Bug: webrtc:42223727\n    Change-Id: Ibef15509dd7d6317155a781a91c07d8deabeb117\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506201\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48793}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/fec_controller.h", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/rtp_video_sender.h", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/modules/video_coding/fec_controller_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0079.patch"], "git_node": "0e2da7c462853c44f5d76fcc506fde20f3a08078", "git_parents": ["ab20c25a66250a61fed022d600b5a402f89f1418"], "node": "86fdfadab05aff7456e4633a83ddefabe11fafb1", "parents": ["2c73d51226d51573c641e07123144672f9bebb8f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from fc2f362ace\n\nUpstream commit: https://webrtc.googlesource.com/src/+/fc2f362ace87de851287c64d94be27f6764796ab\n    Add thread annotations to ChannelReceive members\n\n    payload_type_frequencies_ and payload_type_map_ are only accessed on the\n    worker thread, and rtp_ts_wraparound_handler_ and\n    capture_start_rtp_time_stamp_ only on the audio thread, but they are not\n    annotated. Annotate them so that the compiler checks the access rules.\n\n    Bug: webrtc:11993\n    Change-Id: I6ad5c753138891261ca6729d31e6904b1634ff5c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506982\n    Reviewed-by: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Commit-Queue: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48794}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch"], "git_node": "d25c4aef99aacda04c70b10ac715f5841145439f", "git_parents": ["0e2da7c462853c44f5d76fcc506fde20f3a08078"], "node": "710354bf0c0c64e6569dd36d7df5108cdfab7a7b", "parents": ["86fdfadab05aff7456e4633a83ddefabe11fafb1"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 4cec5358c9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4cec5358c97e7eeec65e4512e843c3065e22f36c\n    Update WebRTC code version (2026-10-06T04:08:36).\n\n    Bug: None\n    Change-Id: Ic92f8feaf7f4cedbfbcacdc7ee4b612f942823a9\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507580\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48795}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "65885bc0ca5e4f4565b4eee61b0384bb0a404a4a", "git_parents": ["d25c4aef99aacda04c70b10ac715f5841145439f"], "node": "7e81ab10c3258889fe5899ea5d68388a09b76a0a", "parents": ["710354bf0c0c64e6569dd36d7df5108cdfab7a7b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 039b040f0d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/039b040f0dfbc631f6d533750d75737fb62e1bc8\n    Add ChannelReceive test for transformed frames\n\n    The frame transformer tests only check that Transform() is called. Add a\n    test that hands the transformed frame back through the registered\n    callback, and verifies that the audio reaches the output together with\n    the packet info of the received packet.\n\n    Bug: webrtc:11993\n    Change-Id: Ibe9bcb66b16a0c771ffe17598d4e1b8b72ab09ec\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507020\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48796}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/BUILD.gn", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0094.patch"], "git_node": "f6ccbef690d463b39a2110e868b499496b99bd61", "git_parents": ["65885bc0ca5e4f4565b4eee61b0384bb0a404a4a"], "node": "13c2b53ae2c1d4dd44acd1c29e666e103b02d033", "parents": ["7e81ab10c3258889fe5899ea5d68388a09b76a0a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 32f1c74f24\n\nUpstream commit: https://webrtc.googlesource.com/src/+/32f1c74f24cca82575607fa8718c0174d80204f8\n    Add audio capture processing time stats piping\n\n    Change-Id: I57662a33cc8065bcf84103521d8465cef6f65e00\n\n    Bug: b/560044202\n    Change-Id: I57662a33cc8065bcf84103521d8465cef6f65e00\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507520\n    Commit-Queue: Tore Rudberg \u003ctrudberg@google.com\u003e\n    Reviewed-by: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Reviewed-by: Henrik Andreassson \u003chenrika@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48797}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/audio/audio_device.h", "third_party/libwebrtc/modules/audio_device/include/mock_audio_device.h"], "git_node": "90e4e5fb65db7e677b0b097c3e735ea00f013b8e", "git_parents": ["f6ccbef690d463b39a2110e868b499496b99bd61"], "node": "a8ecf26c21c470b4594c4b77e2b775d124cb4121", "parents": ["13c2b53ae2c1d4dd44acd1c29e666e103b02d033"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 784067dba2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/784067dba2bedeb753cd05ea8a6ccdb94160cc23\n    Block TURN redirects to the unspecified address\n\n    A TURN server can redirect an allocation to another server with a 300\n    (Try Alternate) response. Redirects to loopback addresses are already\n    rejected, but the unspecified address (0.0.0.0 or ::) was not, even\n    though some platforms deliver packets sent to it to the local host.\n\n    Treat redirects to the unspecified address as errors, like redirects to\n    loopback. The loopback redirect test helper is generalized to cover both\n    cases, and the TLS variants now listen on the redirect address so that a\n    connection attempt would actually be detected.\n\n    Bug: chromium:502821327\n    Change-Id: I8937e1047917f03c5891c3d117785ff222621a58\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507160\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48798}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/base/turn_port.cc", "third_party/libwebrtc/p2p/base/turn_port_unittest.cc"], "git_node": "718d6ace206768a1c20c2129109afec3b6f4b51d", "git_parents": ["90e4e5fb65db7e677b0b097c3e735ea00f013b8e"], "node": "b6749740e028b445ab6432e3a8e9e56a5fd2b418", "parents": ["a8ecf26c21c470b4594c4b77e2b775d124cb4121"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from bd5625b05c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bd5625b05cacc2b49fb26bf3974914b4956ef9c3\n    Restore bit depth check in LibvpxVp9Decoder\n\n    ReturnFrame() used to reject decoded images with bit depths other than 8\n    and 10. The check was lost when it started to switch on img-\u003efmt instead\n    of img-\u003ebit_depth in\n    https://webrtc-review.googlesource.com/c/src/+/266180. Since then,\n    12-bit frames (VP9 profile 2 and 3) are wrapped in 10-bit buffers and,\n    for BT.2020 content, hit RTC_DCHECK_NOTREACHED() in\n    ExtractVP9ColorSpace().\n\n    Return WEBRTC_VIDEO_CODEC_NO_OUTPUT for such frames again, since no\n    frame buffer type can represent 12-bit content.\n\n    Fixed: chromium:569701823\n    Change-Id: I7ba5437dfeffc581c2dbc516ab492252928cdc67\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507600\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48799}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/vp9/libvpx_vp9_decoder.cc", "third_party/libwebrtc/modules/video_coding/codecs/vp9/test/vp9_impl_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0140.patch"], "git_node": "11dfdfa8feba10a57ff4c0a9a0e25376fe046a1c", "git_parents": ["718d6ace206768a1c20c2129109afec3b6f4b51d"], "node": "1685a757e1ddb4e47fff45ef9ca1a2824596cbe9", "parents": ["b6749740e028b445ab6432e3a8e9e56a5fd2b418"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 57438bf3b5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/57438bf3b520fef77ed94af77f9d244a5c4f07f3\n    Refresh h-cc-pairs document\n\n    No content changes, but document is automatically reformatted.\n\n    Bug: b/569859970\n    No-Try: True\n    Change-Id: Id796b2c21c8ae7b7743baa80d7314d2fb4a5f287\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507720\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48800}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/g3doc/style-guide/h-cc-pairs.md"], "git_node": "80a0fed46a16749a65b4347a6c5de4d443f1e3cb", "git_parents": ["11dfdfa8feba10a57ff4c0a9a0e25376fe046a1c"], "node": "f6162715503e1d06736dc2e84a529ac19902fdcf", "parents": ["1685a757e1ddb4e47fff45ef9ca1a2824596cbe9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 74551e7438\n\nUpstream commit: https://webrtc.googlesource.com/src/+/74551e74388884b03626b00bc2054bf267a36571\n    Propagate the Sframe encryptor to the video RTP send path\n\n    Carries the Sframe encryptor created by RtpSenderBase down through the\n    media channel and call/ layers until it reaches RTPSenderVideo, which\n    now holds it as a member. Frames are still not encrypted; this CL only\n    makes the encryptor reachable from the place that will use it.\n\n    Flow:\n    - RtpSenderBase::CreateSframeEncryptorOrError() posts the encryptor to\n      the worker thread and hands it to the media channel.\n    - WebRtcVideoSendChannel::SetSframeEncryptor() stores it in the\n      channel's sframe_options_ and pushes the updated options to every\n      existing send stream.\n    - Streams created later pick the encryptor up on their own, because\n      AddSendStream copies sframe_options_ into config.rtp.\n    - RtpVideoSender forwards rtp_config.sframe_options.encryptor into\n      RTPSenderVideo::Config, which stores it in sframe_encryptor_.\n\n    Details:\n    - SframeSendOptions gains the `encryptor` handle that was left as a\n      TODO when the struct was introduced.\n    - call/DEPS gets a specific_include_rules entry allowing\n      sframe_options.h to include modules/sframe/, which checkdeps\n      otherwise rejects for the call/ target.\n\n    SetSframeEncryptor no longer takes an ssrc:\n\n    - Sframe is Unified Plan only, so a send channel has a single send\n      stream and the ssrc carried no routing information - the channel\n      never used it to look anything up.\n    - Storing the encryptor in the channel's sframe_options_ removes that\n      ordering dependency entirely: streams that already exist are updated\n      through UpdateSframeOptions(), and streams created afterwards read\n      the options when they are built. Neither direction needs to know an\n      ssrc.\n\n    The fail-closed drop in SendEncodedImage() is left unconditional on\n    purpose. The encryptor is now reachable but unused, so enabling the\n    `!sframe_encryptor_` half of the check would let plaintext onto the wire\n    for a stream that negotiated Sframe. The condition stays commented out,\n    with a TODO, until the following CL adds the encryption itself.\n\n    Bug: webrtc:479862368\n    Change-Id: I6e34c89d086199023dee407edb82641ec95de0f2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507440\n    Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48801}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/DEPS", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/sframe_options.h", "third_party/libwebrtc/media/base/fake_media_engine.h", "third_party/libwebrtc/media/base/media_channel.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.h", "third_party/libwebrtc/modules/rtp_rtcp/BUILD.gn", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.h", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/pc/rtp_sender.cc", "third_party/libwebrtc/pc/rtp_sender_receiver_unittest.cc"], "git_node": "01e5cb9e5324f5fca12ad54dca416cb5db4c68b0", "git_parents": ["80a0fed46a16749a65b4347a6c5de4d443f1e3cb"], "node": "746c108a674d8bc01969ada5d4cee730855958f8", "parents": ["f6162715503e1d06736dc2e84a529ac19902fdcf"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 74551e7438 - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/call/sframe_options_gn/moz.build"], "git_node": "89d1aa96080984c92bd236b934f2fdf3a3328345", "git_parents": ["01e5cb9e5324f5fca12ad54dca416cb5db4c68b0"], "node": "4647798f049a3c167032c64da1c5f90d3bf4f78c", "parents": ["746c108a674d8bc01969ada5d4cee730855958f8"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 82b9f73de3\n\nUpstream commit: https://webrtc.googlesource.com/src/+/82b9f73de3245aa7ad3009b3c75cec89d44fa277\n    Refresh abseil-in-webrtc document\n\n    Bug: b/569859242\n    Change-Id: Iec2dcb9f30d4b0f4dbe1065ad7107f51a0910a9e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507740\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48802}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/g3doc/abseil-in-webrtc.md", "third_party/libwebrtc/sdk/objc/native/src/objc_video_encoder_factory.mm"], "git_node": "73d498adf2e67d04e9353a79eae29f47045b6876", "git_parents": ["89d1aa96080984c92bd236b934f2fdf3a3328345"], "node": "065e3ca20d6c9cc7531c88974bc5255c6ed57449", "parents": ["4647798f049a3c167032c64da1c5f90d3bf4f78c"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 55f39a3f17\n\nUpstream commit: https://webrtc.googlesource.com/src/+/55f39a3f17df18158afd21fde55c74296621d2d9\n    Use a keyed hash for ICE candidate foundations\n\n    The foundation of a candidate was the CRC32 of the candidate type, the\n    base address, the protocols and the ICE tie-breaker. The tie-breaker is\n    sent to the remote peer in connectivity checks, so the remote peer could\n    recover the base address of a candidate from its foundation by brute\n    force, also when the address is hidden behind an mDNS name. Adding a\n    secret to the CRC32 input would not be enough, since CRC32 is linear and\n    foundations with known inputs, such as those of relay candidates, could\n    be used to cancel it out.\n\n    Compute the foundation as a truncated HMAC-SHA256 instead, keyed with a\n    random key that is generated once per process and never sent anywhere.\n    Equal inputs still produce equal foundations within a process and the\n    format (a decimal 32-bit number) is unchanged, but foundations are no\n    longer comparable across processes.\n\n    Bug: chromium:504578795\n    Change-Id: If07aee5410d5d29d3a74412b44f9704725e73788\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507200\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48803}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/BUILD.gn", "third_party/libwebrtc/api/candidate.cc", "third_party/libwebrtc/api/candidate.h", "third_party/libwebrtc/api/candidate_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch"], "git_node": "aec8bfbae6550117458cfe1ec430592a270914a1", "git_parents": ["73d498adf2e67d04e9353a79eae29f47045b6876"], "node": "9bf4778842357812d55b60be87d2f2f99c705f5d", "parents": ["065e3ca20d6c9cc7531c88974bc5255c6ed57449"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 84f4318ae7\n\nUpstream commit: https://webrtc.googlesource.com/src/+/84f4318ae74235f9b46c12991ab54d8d1e3eec5b\n    Don't redeliver received keyframes after seq num discontinuity\n\n    RtpVideoStreamReceiver2 ends a large sequence number discontinuity at a\n    keyframe with an RTP timestamp newer than the newest received media, but\n    took that timestamp from the packet with the newest sequence number. A\n    packet with a high sequence number and an old timestamp could thus make\n    an already received keyframe look new. A copy of that keyframe far\n    behind in sequence numbers then reset the receiver and was decoded a\n    second time under a new frame id. Track the newest media RTP timestamp\n    independently of the sequence number instead.\n\n    Decoding two frames with the same RTP timestamp before either is\n    rendered also hit a DCHECK in VideoQualityObserver::OnDecodedFrame. The\n    timestamp is set by the remote sender, so this is reachable without the\n    recovery logic too, e.g. with two keyframes that share a timestamp.\n    Remove the DCHECK; caching a blocky timestamp twice is harmless.\n\n    Bug: chromium:568946767\n    Change-Id: I905de47bd32806ad792e381b1139592fed9477f7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507641\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48804}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch", "third_party/libwebrtc/video/receive_statistics_proxy_unittest.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h", "third_party/libwebrtc/video/rtp_video_stream_receiver2_unittest.cc", "third_party/libwebrtc/video/video_quality_observer2.cc"], "git_node": "fc3479c0fc22aa067850912c61139c76f4281a34", "git_parents": ["aec8bfbae6550117458cfe1ec430592a270914a1"], "node": "883f296a4512ac16503084aead9f2254c3eab9af", "parents": ["9bf4778842357812d55b60be87d2f2f99c705f5d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 7eb6ce0d90\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7eb6ce0d9041d142f48bd64a52f536a9d6522764\n    Avoid needless container and scoped_refptr copies\n\n    Several call sites deep-copy Codec, Candidate and logged RTP stream\n    objects, or whole vectors of them, that they only read. A few\n    constructors also copy by-value scoped_refptr parameters instead of\n    moving them.\n\n    - Bind getter results and loop elements by const reference: the codec\n      lists in the SDP munging detector and in CodecList's AbslStringify,\n      the port candidates in GetCandidateStatsFromReadyPorts, and the logged\n      RTP streams in the NetEq event log input.\n    - Move by-value scoped_refptr parameters into their members in the\n      PeerConnection, BroadcastResourceListener and\n      ResourceVideoSendStreamForwarder constructors.\n\n    Bug: webrtc:374845009\n    Change-Id: I7f213313c894252896ccd3f39c03f455d5e84566\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498621\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48805}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/adaptation/broadcast_resource_listener.cc", "third_party/libwebrtc/call/call.cc", "third_party/libwebrtc/media/base/codec_list.h", "third_party/libwebrtc/modules/audio_coding/neteq/tools/neteq_event_log_input.cc", "third_party/libwebrtc/p2p/client/basic_port_allocator.cc", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/sdp_munging_detector.cc"], "git_node": "8934a3f60fa675a7602ea0e9a33118eb70f2e01b", "git_parents": ["fc3479c0fc22aa067850912c61139c76f4281a34"], "node": "5437617502c51a104c6ae480463b215c8dc4270a", "parents": ["883f296a4512ac16503084aead9f2254c3eab9af"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 4cc19488b0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4cc19488b01618ae0194e1dc2af54516c7af8419\n    Require strictly increasing spatial ids in VideoEncoderInterface::Encode\n\n    Documents the requirement and adds functional tests for out of order and\n    duplicate spatial ids.\n\n    Bug: webrtc:496266459\n    Change-Id: I3ad866fb1347e9cb6f4e115ecdad6f018a9321a5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506680\n    Commit-Queue: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48806}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/g3doc/video_encoder_api_v2.md", "third_party/libwebrtc/api/video_codecs/test/video_encoder_functional_unittest.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc"], "git_node": "06daee053bd8dc00b31492f8663516d0745de112", "git_parents": ["8934a3f60fa675a7602ea0e9a33118eb70f2e01b"], "node": "fc4c16634b7c369e7d651b0e8b5e28f8e99a1147", "parents": ["5437617502c51a104c6ae480463b215c8dc4270a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 920bbd6250\n\nUpstream commit: https://webrtc.googlesource.com/src/+/920bbd6250d6127b0cf958ceac0aa99a56817f9e\n    Apply TURN server checks to UDP redirects\n\n    A 300 (Try Alternate) response to a TURN allocation over UDP makes the\n    port reuse its socket and send a new Allocate request to the alternate\n    server directly, without going through PrepareAddress(). That skipped\n    two checks that apply to every other way of connecting to a TURN server:\n    the check for disallowed ports and the Local Network Access permission\n    request.\n\n    - Reject redirects to disallowed ports in SetAlternateServer(), next to\n      the loopback and unspecified address checks, so that all protocols are\n      covered. Redirects over TCP and TLS to such ports were already blocked\n      by PrepareAddress(), but are now rejected before reconnecting.\n    - Request Local Network Access permission for the alternate server\n      before sending the Allocate request over UDP, using a helper shared\n      with PrepareAddress().\n\n    Bug: chromium:502821327\n    Change-Id: Ib2f06c9bfc51fbf6dadddbd701774e33d4c77ce8\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507220\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48807}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/BUILD.gn", "third_party/libwebrtc/p2p/base/turn_port.cc", "third_party/libwebrtc/p2p/base/turn_port.h", "third_party/libwebrtc/p2p/base/turn_port_unittest.cc"], "git_node": "98c9da6d4042dcb96ae51e71d9ca2f7d7cab080d", "git_parents": ["06daee053bd8dc00b31492f8663516d0745de112"], "node": "c4dc736f5935083dbbc02d544f51eebe332699ef", "parents": ["fc4c16634b7c369e7d651b0e8b5e28f8e99a1147"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 0c0fea51df\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0c0fea51df271c52cc7ead43ad3a8280a784f75a\n    dtls-in-stun: actually wire up behavior to ice-option\n\n    which means that we no longer speculative start without an indication\n    that the peer supports this. Peer support is discovered by two triggers:\n    * an offer/answer with the ice-option\n    * a STUN packet with embedded DTLS which is passed to the DTLS transport\n      as piggybacked\n\n    If the peer does not support SPED this no longer configures the 24h\n    timeout and behaves like the existing non-sped path. If the peer does\n    support SPED then it is also assumed to support the API for adjusting\n    the timeout mid-session. The timeout could be set lower though, e.g. to\n    the signaling RTT.\n\n    Bug: webrtc:367395350\n    Change-Id: Ia77106dabf3268c007649ef5bc3d9aac7033d330\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/476202\n    Reviewed-by: Jonas Oreland \u003cjonaso@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48808}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/dtls/dtls_ice_integration_fixture.h", "third_party/libwebrtc/p2p/dtls/dtls_transport.cc", "third_party/libwebrtc/p2p/dtls/dtls_transport.h", "third_party/libwebrtc/p2p/dtls/dtls_transport_internal.h", "third_party/libwebrtc/p2p/dtls/dtls_transport_unittest.cc", "third_party/libwebrtc/p2p/dtls/fake_dtls_transport.h", "third_party/libwebrtc/pc/jsep_transport.cc", "third_party/libwebrtc/pc/peer_connection_integrationtest.cc"], "git_node": "caa3c8026e38a29205a0c665af5de9c86785ef46", "git_parents": ["98c9da6d4042dcb96ae51e71d9ca2f7d7cab080d"], "node": "85e847530c974bbe58e0905555af72c6a29e298d", "parents": ["c4dc736f5935083dbbc02d544f51eebe332699ef"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f3ca303aec\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f3ca303aecb315605c466f15a4962d6c4c506de6\n    Split RTPSender packet building into helpers\n\n    The code that attaches the MID and RID header extensions was duplicated\n    in AllocatePacket(), BuildRtxPacket() and both padding paths of\n    GeneratePadding(), and GeneratePadding() had grown long and hard to\n    read.\n\n    - Move the MID and RID logic into AttachMidAndRid().\n    - Build media and padding packets in BuildMediaPacket() and\n      BuildPaddingPacket(), and track the maximum CSRC count in\n      UpdateMaxNumCsrcs().\n    - Split GeneratePadding() with AppendPayloadPadding() and\n      PaddingBytesInPacket(). Checks that cannot change inside the padding\n      loop now return before the loop instead of breaking out of it.\n\n    The helpers still run under send_mutex_. This prepares\n    https://webrtc-review.googlesource.com/c/src/+/507280, which builds\n    packets after releasing the lock and then only needs to change which\n    state the helpers read. BuildMediaPacket() and UpdateMaxNumCsrcs() will\n    also be used by a per-frame variant of AllocatePacket().\n\n    No change in behavior.\n\n    Bug: webrtc:42223727\n    Change-Id: I22b7682a65fb7c56d1c92b8cd07af3ef998b0b44\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507642\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48809}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.h", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0048.patch"], "git_node": "6e85275f2aed0cf8b961853527dce3be5a80f19d", "git_parents": ["caa3c8026e38a29205a0c665af5de9c86785ef46"], "node": "e5703f87e5554ba7f689d731c936cb12ac709cff", "parents": ["85e847530c974bbe58e0905555af72c6a29e298d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 081b0fe0b8\n\nUpstream commit: https://webrtc.googlesource.com/src/+/081b0fe0b8b55fae6a7dfe0aefef2f44fd32b0e1\n    Roll third_party/sframe from db604c8f1960 to 6a37f061f4ed\n\n    Bug: webrtc:479862368\n    Change-Id: I6760e5bba55448355c90804644c0c5c95a862881\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507542\n    Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48810}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "06b442bf9a734dcc895e1ba2922ba5b1983082f4", "git_parents": ["6e85275f2aed0cf8b961853527dce3be5a80f19d"], "node": "c1b6e2a3ace746ab6c05dfc3e306fdb5d5bd85ce", "parents": ["e5703f87e5554ba7f689d731c936cb12ac709cff"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 6d243c3c23\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6d243c3c238d5e18b9a57a9417b5b0ad70fbd43f\n    Avoid unnecessary copying in media engine and base\n\n    Code in media/engine and media/base copies codec lists, codecs and other\n    objects that it only reads, on paths such as codec negotiation,\n    SetParameters and GetStats, often once per element inside find_if\n    lambdas. Some by-value parameters and locals are also copied at their\n    last use instead of being moved.\n\n    - Use const references for read-only values: VideoCodecSettings vectors,\n      the elements visited by find_if lambdas, StreamParams and the audio\n      track id. Compare codec names as absl::string_view instead of\n      constructing std::string temporaries.\n    - Move by-value parameters and locals at their last use, such as\n      send_codec in the RTP parameter checks and the frame encryptor,\n      decryptor and transformer scoped_refptrs. Use emplace instead of\n      insert for decoder_map to avoid constructing a temporary pair.\n\n    Bug: webrtc:374845009\n    Change-Id: I254fb9bd79340929a233544a4d626e636bc44530\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498960\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48811}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/base/codec_comparators.cc", "third_party/libwebrtc/media/base/media_engine.cc", "third_party/libwebrtc/media/base/media_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc"], "git_node": "03590ff86f546238686c7ab975ee87f06acec51d", "git_parents": ["06b442bf9a734dcc895e1ba2922ba5b1983082f4"], "node": "5d032193007f8248e868078702da91b07975f100", "parents": ["c1b6e2a3ace746ab6c05dfc3e306fdb5d5bd85ce"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 85b4247024\n\nUpstream commit: https://webrtc.googlesource.com/src/+/85b4247024c3cc83b9cd06d7be2f53e66917a30d\n    Generalize TemporalLayerRateTracker into CbrLayerRateTracker.\n\n    The tracker now covers spatial as well as temporal layers and produces\n    an encoder agnostic CumulativeCbrAllocation: per spatial layer bitrates\n    that are cumulative over the temporal layers, together with the temporal\n    layer frame rate factors. Encoder wrappers only translate it to their\n    own types and decide themselves when to apply it.\n\n    - The tracker is fed once per temporal unit with the FrameEncodeSettings passed to Encode, instead of once per frame. Temporal unit boundaries are therefore known rather than guessed from the spatial ids.\n    - Spatial layers without a frame in a temporal unit keep their last   bitrate. Some rate controllers otherwise set the bitrate to zero,  disabling the layer with unintended side effects.\n    - The priming after a keyframe now applies to all spatial layers of the temporal unit that follows it, not only to single spatial layer   streams.\n    - The libaom wrapper only hands the encoder config and the SVC parameters to libaom when they differ from what was last applied. Both paths recompute the per layer rate control state from the frame rate of the most recently encoded frame, and reset the buffer of any layer whose per frame budget then appears to have changed by more than a factor of two. With spatial layers running at different frame rates this reset the lower layers before each of their frames, which made them overshoot their targets severalfold.\n\n    Bug: webrtc:496266459\n    Change-Id: I260b348328ce9dfc2595a080b719e20b37b6890d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506562\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48812}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.h", "third_party/libwebrtc/modules/video_coding/utility/cbr_layer_rate_tracker.cc", "third_party/libwebrtc/modules/video_coding/utility/cbr_layer_rate_tracker.h", "third_party/libwebrtc/modules/video_coding/utility/cbr_layer_rate_tracker_unittest.cc", "third_party/libwebrtc/modules/video_coding/utility/temporal_layer_rate_tracker.cc", "third_party/libwebrtc/modules/video_coding/utility/temporal_layer_rate_tracker.h", "third_party/libwebrtc/modules/video_coding/utility/temporal_layer_rate_tracker_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0140.patch"], "git_node": "ae013c58d815ff6d3cb36e88023fbca75c4514f7", "git_parents": ["03590ff86f546238686c7ab975ee87f06acec51d"], "node": "f36f327bd0a8ee3e7298f814dff3cf68d0e7d769", "parents": ["5d032193007f8248e868078702da91b07975f100"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 85b4247024 - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/api/video_codecs/video_encoder_interface_gn/moz.build", "third_party/libwebrtc/modules/video_coding/video_coding_utility_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": "6a7969b324e185f1a6dcbf62dc6d10ba30e72f60", "git_parents": ["ae013c58d815ff6d3cb36e88023fbca75c4514f7"], "node": "4fd8fbe8901d8bcd6b5d0b9fc2a24fa9cfbae652", "parents": ["f36f327bd0a8ee3e7298f814dff3cf68d0e7d769"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 39fc579220\n\nUpstream commit: https://webrtc.googlesource.com/src/+/39fc57922059b685d0ea29f85d494287d69cd6a1\n    Update WebRTC code version (2026-10-07T04:09:45).\n\n    Bug: None\n    Change-Id: Ia6bcfb2dfc91d07d2aebac40373432216e45d4c3\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507800\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48813}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "452e9ad2b6a97a758a8dd2ac0b09999dcb671140", "git_parents": ["6a7969b324e185f1a6dcbf62dc6d10ba30e72f60"], "node": "8d4a2a5b731137abb6b8ad462a5c8f196781fa0d", "parents": ["4fd8fbe8901d8bcd6b5d0b9fc2a24fa9cfbae652"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 94ff623f34\n\nUpstream commit: https://webrtc.googlesource.com/src/+/94ff623f348b8606b09a15b1a82f495d85d3b709\n    Do not normalize input resolution for scale_resolution_down_to in simulcast.\n\n    When scale_resolution_down_by is unset, NormalizeResolution rounds the\n    input resolution down to a multiple of 2^(max_num_layers - 1) assuming\n    default 1/2 simulcast scaling. Passing that normalized resolution into\n    GetLayerResolutionFromScaleResolutionDownTo truncates stream dimensions\n    even when scale_resolution_down_to is used, causing VideoStreamEncoder\n    to crop incoming frames.\n\n    Pass the original unnormalized frame dimensions to\n    GetLayerResolutionFromScaleResolutionDownTo, matching\n    CreateDefaultVideoStreams.\n\n    Bug: b/567616289\n    Change-Id: Ie73a346ba4f09e9a4e58d9a60de58019c2ab8974\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507760\n    Commit-Queue: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48814}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/video/config/encoder_stream_factory.cc", "third_party/libwebrtc/video/config/encoder_stream_factory_unittest.cc"], "git_node": "ea12e332ef415ab7e5d808205b9a8b69fa05515c", "git_parents": ["452e9ad2b6a97a758a8dd2ac0b09999dcb671140"], "node": "0d7c1f3c84ef904eeaae6b3f6f870d553a4053a8", "parents": ["8d4a2a5b731137abb6b8ad462a5c8f196781fa0d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 4248d04039\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4248d04039fd19077864e3cc3a57a3c68faf0cf5\n    Changed auto_correlation.c to be .cc\n\n    Bug: webrtc:505072868\n    Change-Id: I49118a569b9076669da3697d85cfc1b6f6e05955\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507680\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48815}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/common_audio/BUILD.gn", "third_party/libwebrtc/common_audio/signal_processing/auto_correlation.c", "third_party/libwebrtc/common_audio/signal_processing/auto_correlation.cc", "third_party/libwebrtc/modules/audio_coding/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0091.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/unsafe_buffers_paths.txt"], "git_node": "eff8d7f65bd9b7c1a1bd953fe21afc708819ef7f", "git_parents": ["ea12e332ef415ab7e5d808205b9a8b69fa05515c"], "node": "f87725ca0de8b89c4177229054ecbbcee6dc695d", "parents": ["0d7c1f3c84ef904eeaae6b3f6f870d553a4053a8"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 4248d04039 - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/common_audio/common_audio_c_gn/moz.build", "third_party/libwebrtc/common_audio/common_audio_cc_gn/moz.build"], "git_node": "18b5d8f8e94169d176ffd3a395e0b0c930a52e48", "git_parents": ["eff8d7f65bd9b7c1a1bd953fe21afc708819ef7f"], "node": "e724509e3101d855d59afd1618ee59ffd632ae37", "parents": ["f87725ca0de8b89c4177229054ecbbcee6dc695d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 71b521e4af\n\nUpstream commit: https://webrtc.googlesource.com/src/+/71b521e4af0744f21ff63513141b0377f4754e8d\n    Add move operations to VideoEncoder::EncoderInfo\n\n    EncoderInfo declares a copy constructor and a destructor, so it has no\n    implicit move operations, and std::move on an EncoderInfo copies it.\n    For example, the EncoderContext constructor in SimulcastEncoderAdapter\n    and the EncoderSettings constructor take EncoderInfo by value and move\n    it into a member, which made a copy.\n\n    Add a defaulted move constructor and move assignment operator, and\n    declare the copy assignment operator, which declaring a move\n    constructor would otherwise delete. Like the existing copy constructor\n    and destructor, they are defaulted out of line.\n\n    Also move the primary and fallback infos into the new EncoderContext in\n    SimulcastEncoderAdapter::FetchOrCreateEncoderContext, as they are not\n    used afterwards. Creating an encoder context now copies EncoderInfo\n    once instead of six times.\n\n    Bug: webrtc:374845009\n    Change-Id: I77cd7211314a62fd12a871e4b88d081ab858bbb7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507722\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48816}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/video_encoder.cc", "third_party/libwebrtc/api/video_codecs/video_encoder.h", "third_party/libwebrtc/media/engine/simulcast_encoder_adapter.cc", "third_party/libwebrtc/moz-patch-stack/s0045.patch"], "git_node": "ab73ed35e7eecb9aee392435e502ed4dfb09aa93", "git_parents": ["18b5d8f8e94169d176ffd3a395e0b0c930a52e48"], "node": "a2969280cba31dac019ee2fc843402705b72201a", "parents": ["e724509e3101d855d59afd1618ee59ffd632ae37"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from a19f7bd12d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a19f7bd12d16b5c43281d02185ebda8e639cc599\n    Deprecate the worker_thread factory overload\n\n    Marks the CreatePeerConnectionFactory overload that takes a worker\n    thread as [[deprecated]] and migrates the remaining in-tree callers to\n    the overload without worker_thread.\n\n    The overload keeps forwarding the caller's worker thread, so\n    applications that supply a thread that is distinct from the network\n    thread still get the runtime diagnostics in addition to the compile time\n    warning.\n\n    See https://groups.google.com/g/discuss-webrtc/c/Fs_Hd5XNJh0\n\n    Bug: webrtc:558821261\n    Change-Id: I3677d4cf659337f072ecb676c33d683b05a71add\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/502960\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48817}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/create_peerconnection_factory.h", "third_party/libwebrtc/pc/peer_connection_crypto_unittest.cc", "third_party/libwebrtc/pc/peer_connection_factory_unittest.cc", "third_party/libwebrtc/pc/peer_connection_ice_unittest.cc", "third_party/libwebrtc/pc/peer_connection_rtp_unittest.cc", "third_party/libwebrtc/pc/peer_connection_signaling_unittest.cc", "third_party/libwebrtc/pc/peer_connection_simulcast_unittest.cc", "third_party/libwebrtc/pc/sdp_munging_detector_unittest.cc", "third_party/libwebrtc/pc/sdp_offer_answer_unittest.cc", "third_party/libwebrtc/rtc_tools/data_channel_benchmark/peer_connection_client.cc", "third_party/libwebrtc/webrtc_lib_link_test.cc"], "git_node": "67dc977f30820a210a5569a27cf73ada020d0a41", "git_parents": ["ab73ed35e7eecb9aee392435e502ed4dfb09aa93"], "node": "0e576be253a1e07f0e01393c28c0d166c87d52aa", "parents": ["a2969280cba31dac019ee2fc843402705b72201a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from d1cdf84758\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d1cdf84758aeefc2854968f4c299eaecd593cb6f\n    Report intra-only frames as kStartFrame in LibaomAv1EncoderV2.\n\n    Previously, LibaomAv1EncoderV2::Encode only checked AOM_FRAME_IS_KEY and\n    reported intra-only start frames (AOM_FRAME_IS_INTRAONLY) as\n    FrameType::kDeltaFrame in EncodedData::frame_type.\n\n    Bug: webrtc:496266459\n    Change-Id: I3fd381c00b38250682e3adc3a4b61a34cb7f698c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507880\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48818}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/test/video_encoder_functional_unittest.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc"], "git_node": "ce5aa013dbb2d6a35eb9bb20afa3e272deb263a2", "git_parents": ["67dc977f30820a210a5569a27cf73ada020d0a41"], "node": "5c7400d1ea29228f87cf74837bd2c14cdf88e393", "parents": ["0e576be253a1e07f0e01393c28c0d166c87d52aa"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f18608fb69\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f18608fb694e40881c36cf8236141d423cb0607a\n    Move Sframe mode from encryptor to SframeEncryptionConfig\n\n    Sframe mode determines how the send pipeline applies encryption, not how\n    the encryptor performs cryptographic operations. Introduce\n    SframeEncryptionConfig to carry the mode and encryptor together through\n    the send pipeline.\n\n    Keep mode in SframeEncryptorInit as the application-facing input, but\n    construct SframeEncryptor using only the cipher suite. Remove its stored\n    mode and the mode() accessor from the media encryptor interface.\n\n    Store an optional SframeEncryptionConfig in RtpSenderBase and\n    SframeSendOptions. Rename the media-channel setter to\n    SetSframeEncryptionConfig and propagate the configuration during\n    installation, SSRC binding, and video send-stream creation or\n    recreation. RtpVideoSender forwards it to each RTPSenderVideo, including\n    simulcast streams.\n\n    Keep the requirement for Sframe protection independent of the encryption\n    configuration. Rename the RTP-level flag to\n    sframe_required_by_negotiation to clarify that it reflects applied SDP.\n    Preserve the existing frame-dropping behavior while Sframe encryption is\n    not yet wired into the RTP sender; audio propagation remains a TODO.\n\n    Bug: webrtc:479862368\n    Change-Id: I7e0ffbf1843dd0231354460a25ee052f26552ae1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507741\n    Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48819}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/call/sframe_options.h", "third_party/libwebrtc/media/BUILD.gn", "third_party/libwebrtc/media/base/fake_media_engine.h", "third_party/libwebrtc/media/base/media_channel.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.h", "third_party/libwebrtc/modules/rtp_rtcp/BUILD.gn", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc", "third_party/libwebrtc/modules/sframe/BUILD.gn", "third_party/libwebrtc/modules/sframe/sframe_encryption_config.h", "third_party/libwebrtc/modules/sframe/sframe_encryptor.cc", "third_party/libwebrtc/modules/sframe/sframe_encryptor.h", "third_party/libwebrtc/modules/sframe/sframe_encryptor_decryptor_unittest.cc", "third_party/libwebrtc/modules/sframe/sframe_media_encryptor_interface.h", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/rtp_sender.cc", "third_party/libwebrtc/pc/rtp_sender.h", "third_party/libwebrtc/pc/rtp_sender_receiver_unittest.cc"], "git_node": "8a885f8849b27a5fce5e2faa4d2ce95629f5305d", "git_parents": ["ce5aa013dbb2d6a35eb9bb20afa3e272deb263a2"], "node": "cd8b34dc972832542580c1b9a8bd209e53035be4", "parents": ["5c7400d1ea29228f87cf74837bd2c14cdf88e393"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f18608fb69 - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/modules/sframe/sframe_encryption_config_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": "b4093c2d8b57b32fb73557a257a785e41832d9b6", "git_parents": ["8a885f8849b27a5fce5e2faa4d2ce95629f5305d"], "node": "7a0f3029127526b9d98814fb43561dac11cad5c9", "parents": ["cd8b34dc972832542580c1b9a8bd209e53035be4"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b8f0e986d0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b8f0e986d08b71ed2185349428beb58adc1f361d\n    Keep SVC spatial layer count and scaling factors across partial TUs\n\n    Previously, GetSvcParams derived number_spatial_layers and scaling\n    factors solely from the current temporal unit's frame_settings. When a\n    temporal unit omitted the top spatial layer(s), number_spatial_layers\n    shrunk for that TU and grew again on the next full TU, causing libaom\n    to reset SVC state and force a keyframe.\n\n    Track the high-water mark of spatial layers and scaling factors across\n    Encode() calls since InitEncode() so partial TUs preserve the full SVC\n    configuration.\n\n    Bug: webrtc:496266459\n    Change-Id: I86982578de18c3915e01bb70e8753a2f57810ba6\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507842\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48820}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/test/video_encoder_functional_unittest.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.h"], "git_node": "3f90b4313dbc57c29674d76cc6f62bec41c0bd11", "git_parents": ["b4093c2d8b57b32fb73557a257a785e41832d9b6"], "node": "df73af4167dccda7993ab31fd9bf09b19b8fce72", "parents": ["7a0f3029127526b9d98814fb43561dac11cad5c9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from ae24a13fa4\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ae24a13fa4188268e5dba8c850fe92473023bdd8\n    Add move operations to EncoderSettings\n\n    EncoderSettings declares a copy constructor and a copy assignment\n    operator, so it has no implicit move operations, and std::move on an\n    EncoderSettings copies it, including its VideoEncoderConfig and\n    EncoderInfo. For example, SetEncoderSettings() in\n    VideoStreamEncoderResourceManager and OnEncoderSettingsUpdated() in\n    BitrateConstraint take the settings by value and move them into a\n    member, which made a copy.\n\n    Add a defaulted move constructor and move assignment operator. Like the\n    existing copy operations, they are defined out of line.\n\n    Also avoid the two copies made in\n    VideoStreamEncoder::OnEncoderSettingsChanged():\n    VideoStreamInputStateProvider only reads the settings, so take them by\n    const reference in its OnEncoderSettingsChanged(). Call that before\n    SetEncoderSettings(), which neither reads from nor writes to the input\n    state provider, so that the settings can be moved into\n    SetEncoderSettings(). Read the screenshare and zero-hertz flags from\n    `encoder_config_`, which the settings' config is a copy of.\n\n    An encoder settings change now copies EncoderSettings once, into\n    BitrateConstraint, instead of five times.\n\n    Bug: webrtc:374845009\n    Change-Id: I06419eda299836ae282ef88b95a1a1c6c8a4bb1f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507860\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48821}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/adaptation/encoder_settings.cc", "third_party/libwebrtc/call/adaptation/encoder_settings.h", "third_party/libwebrtc/call/adaptation/video_stream_input_state_provider.cc", "third_party/libwebrtc/call/adaptation/video_stream_input_state_provider.h", "third_party/libwebrtc/moz-patch-stack/s0067.patch", "third_party/libwebrtc/moz-patch-stack/s0101.patch", "third_party/libwebrtc/moz-patch-stack/s0130.patch", "third_party/libwebrtc/video/video_stream_encoder.cc"], "git_node": "910bf2866073519e434800ab99e6832ae092f125", "git_parents": ["3f90b4313dbc57c29674d76cc6f62bec41c0bd11"], "node": "a0e303a81e0ee68b959f202ff15b8596abc6bb43", "parents": ["df73af4167dccda7993ab31fd9bf09b19b8fce72"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 0a4e15369b\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in 39976fe4f9.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0a4e15369bad2a99fdf784ab19f949b30346dfe9\n    Add AES-256-CTR-HMAC-SHA512 Sframe cipher suites\n\n    Expose the three AES-256-CTR-HMAC-SHA512 cipher suites from\n    draft-barnes-sframe-iana-256 (registry values 6, 7 and 8), already\n    implemented by third_party/sframe, through SframeCipherSuite and map\n    them in ToSframeCipherSuite. This brings the WebRTC enum in line with\n    the eight suites listed in the WebRTC Encoded Transform\n    SFrameCipherSuite IDL, which gained these suites in\n    https://github.com/w3c/webrtc-encoded-transform/pull/303.\n\n    Bug: webrtc:479862368\n    Change-Id: Ie5f0bbcccfeee9ea7dd69b253c75c8c47082fbc7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507780\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48822}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/39976fe4f9.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "12c4f8013c44ef8693ef0b1ee05d5111e6ab55cd", "git_parents": ["910bf2866073519e434800ab99e6832ae092f125"], "node": "5a540f403f54857ab801b234cc2c915bd1178ace", "parents": ["a0e303a81e0ee68b959f202ff15b8596abc6bb43"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 39976fe4f9\n\nWe already cherry-picked this when we vendored 0a4e15369b.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/39976fe4f9bd686d705c179cd4b13b0e273c1395\n    Revert \"Add AES-256-CTR-HMAC-SHA512 Sframe cipher suites\"\n\n    This reverts commit 0a4e15369bad2a99fdf784ab19f949b30346dfe9.\n\n    Reason for revert: conflicts with a change committed a bit earlier\n\n    Original change's description:\n    \u003e Add AES-256-CTR-HMAC-SHA512 Sframe cipher suites\n    \u003e\n    \u003e Expose the three AES-256-CTR-HMAC-SHA512 cipher suites from\n    \u003e draft-barnes-sframe-iana-256 (registry values 6, 7 and 8), already\n    \u003e implemented by third_party/sframe, through SframeCipherSuite and map\n    \u003e them in ToSframeCipherSuite. This brings the WebRTC enum in line with\n    \u003e the eight suites listed in the WebRTC Encoded Transform\n    \u003e SFrameCipherSuite IDL, which gained these suites in\n    \u003e https://github.com/w3c/webrtc-encoded-transform/pull/303.\n    \u003e\n    \u003e Bug: webrtc:479862368\n    \u003e Change-Id: Ie5f0bbcccfeee9ea7dd69b253c75c8c47082fbc7\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507780\n    \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48822}\n\n    Bug: webrtc:479862368\n    No-Presubmit: true\n    No-Tree-Checks: true\n    No-Try: true\n    Change-Id: Ibac7b22070dff6034ce80a65ee2ff039814e6467\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507940\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48823}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/39976fe4f9.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "7a01b7bcf0e3391ce84caf6fbd80b0c02f813b2a", "git_parents": ["12c4f8013c44ef8693ef0b1ee05d5111e6ab55cd"], "node": "740cbd6f61130db33d0be7a2aa91d88a3abea452", "parents": ["5a540f403f54857ab801b234cc2c915bd1178ace"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f56234a4ec\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f56234a4ec41ffc30f8a6063703be224519d09d4\n    SCReAM: Scale l4s_alpha update with steps_per_rtt and set g_down to 1/16\n\n    Previously, ScreamV2::UpdateL4SAlpha updated l4s_alpha on every feedback\n    packet using fixed EWMA gain factors (l4s_avg_g_up = 1/8,\n    l4s_avg_g_down = 1/128) regardless of the RTT. Because feedback arrives\n    approximately every reaction_interval (25 ms) while ECN-CE marking and\n    window adjustments occur over an RTT, updating l4s_alpha with unscaled\n    gains caused l4s_alpha to react multiple times per RTT on longer-RTT\n    paths, and the slow decay factor (1/128) kept l4s_alpha elevated well\n    above the actual CE marking fraction between marking events.\n\n    This change:\n    1. Updates the default value of l4s_avg_g_down from 1/128 to 1/16 so\n       l4s_alpha decays faster when CE marking subsides.\n    2. Scales both l4s_avg_g_up and l4s_avg_g_down by\n       steps_per_rtt = max(1.0, rtt / reaction_interval) in UpdateL4SAlpha\n       (gated behind default-enabled field trial parameter\n       ScaleL4sAlphaWithRtt).\n\n    Scaling the EWMA gain factors by steps_per_rtt ensures that l4s_alpha\n    converges over max(reaction_interval, rtt) rather than per feedback\n    packet, better matching TCP Prague which updates alpha once per RTT\n    (with a minimum interval of 25 ms) using g = 1/16.\n\n    Bug: webrtc:447037083\n    Change-Id: Ie9c81e26a4932117c3d5a673d1f9c962e9533bb5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507841\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48824}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.h", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_parameters.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_parameters.h", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_unittest.cc"], "git_node": "d0be3d92ac1755a76d8f258e26b018623a0486cb", "git_parents": ["7a01b7bcf0e3391ce84caf6fbd80b0c02f813b2a"], "node": "a9cd85e0802c584bc6c8dabb7c7241a01fed99d6", "parents": ["740cbd6f61130db33d0be7a2aa91d88a3abea452"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from df21b0a554\n\nUpstream commit: https://webrtc.googlesource.com/src/+/df21b0a5548fd4631d39fb723d16ead30144c4b2\n    Update WebRTC code version (2026-10-08T04:05:26).\n\n    Bug: None\n    Change-Id: Ie13fa67cdc24c1ac4f3e224ca3d4f36bfaa957bc\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508020\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48825}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "ee322ca26462b17b906fe52e7b6bbebde4a4ea8a", "git_parents": ["d0be3d92ac1755a76d8f258e26b018623a0486cb"], "node": "d5ab72233f359e75f87a954fad4152cbc618fb54", "parents": ["a9cd85e0802c584bc6c8dabb7c7241a01fed99d6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 52022620d7\n\nUpstream commit: https://webrtc.googlesource.com/src/+/52022620d7f1f97eed6bcfbfcb2744fb26acc86f\n    Avoid some unnecessary copies in p2p/ production code\n\n    Bug: webrtc:374845009\n    Change-Id: Ib7a2ed49cad076ce12db1db859e6fdfaff9e0bac\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/499220\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48826}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/base/connection.cc", "third_party/libwebrtc/p2p/base/p2p_transport_channel.cc", "third_party/libwebrtc/p2p/base/turn_port.cc", "third_party/libwebrtc/p2p/client/basic_port_allocator.cc", "third_party/libwebrtc/p2p/dtls/dtls_stun_piggyback_callbacks.h", "third_party/libwebrtc/p2p/dtls/dtls_transport.cc"], "git_node": "9a28fbfb150bf7076942e02562a3428ac6dbab87", "git_parents": ["ee322ca26462b17b906fe52e7b6bbebde4a4ea8a"], "node": "197c778dff884308ae35b6aa18b95036e88636e7", "parents": ["d5ab72233f359e75f87a954fad4152cbc618fb54"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 92d011ec2e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/92d011ec2e8fbf27348ca078057f2e75cf77514c\n    Keep muted audio frames muted when resampling\n\n    ResamplerHelper resampled muted frames as well and wrote the output\n    through mutable_data(), which clears the muted flag. When resampling,\n    ChannelReceive therefore returned muted NetEq output as kNormal, so the\n    mixer mixed silence instead of skipping the source, and the frames\n    weren't counted in decoded_muted_output.\n\n    - ResamplerHelper keeps a muted frame that follows a muted frame muted\n      and doesn't resample it. The first muted frame after audio is still\n      resampled and comes out unmuted, since it holds the resampler's tail\n      of that audio. After muted frames, the resampler is primed with\n      silence.\n    - ChannelReceive counts decoded_muted_output from NetEq's muted state\n      before resampling.\n\n    Bug: none\n    Change-Id: I8bb8c5572911c172239005038554feacbb8f87cb\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506980\n    Reviewed-by: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48827}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/modules/audio_coding/acm2/acm_resampler.cc", "third_party/libwebrtc/modules/audio_coding/acm2/acm_resampler.h", "third_party/libwebrtc/modules/audio_coding/acm2/acm_resampler_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch"], "git_node": "48dfb63d1531b8e2b74c745d0cd507400f224920", "git_parents": ["9a28fbfb150bf7076942e02562a3428ac6dbab87"], "node": "59194e7bd311d5319fab6f78b09616e62add90f1", "parents": ["197c778dff884308ae35b6aa18b95036e88636e7"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 8521506867\n\nUpstream commit: https://webrtc.googlesource.com/src/+/852150686748f5cce0c1c96f4fde50e6be43ef73\n    Avoid EncoderInfo copies in VideoStreamEncoder\n\n    GetEncoderInfoWithBitrateLimitUpdate() took the EncoderInfo by const\n    reference and always returned a copy of it, possibly with updated\n    bitrate limits. Take it by value instead and return it, so that it is\n    moved rather than copied. All callers pass the result of\n    GetEncoderInfo() directly, so no copy is made for the parameter either.\n    This removes one EncoderInfo copy on each call: in ReconfigureEncoder(),\n    in OnEncoderSettingsChanged() and in DropDueToSize() while initial\n    frames may be dropped.\n\n    EncodeVideoFrame() copy-assigned the EncoderInfo fetched for each frame\n    to `encoder_info_`. Move it instead, and read supports_native_handle\n    from `encoder_info_` after that. Put the encoder metadata update in its\n    own scope, so that the moved-from local EncoderInfo cannot be used by\n    mistake in the rest of the function.\n\n    Both changes rely on the move operations that were added to EncoderInfo\n    in https://webrtc-review.googlesource.com/c/src/+/507722.\n\n    Bug: webrtc:374845009\n    Change-Id: I8fe5997f7fdde0ce38e75c1da935557735b06742\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507840\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48828}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0067.patch", "third_party/libwebrtc/moz-patch-stack/s0101.patch", "third_party/libwebrtc/moz-patch-stack/s0130.patch", "third_party/libwebrtc/video/video_stream_encoder.cc"], "git_node": "36a367e39ba7c6b4d429128b4f1805443438e11c", "git_parents": ["48dfb63d1531b8e2b74c745d0cd507400f224920"], "node": "0f277567ce7718582b454ec588ada69b268a6b9d", "parents": ["59194e7bd311d5319fab6f78b09616e62add90f1"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 5e1d0ea3c5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5e1d0ea3c5c356250efa50139bf791f96cf33b1d\n    stats: remove totalEncodedBytesTarget\n\n    which has been 0 for a while and broke even earlier.\n\n    Removed from the spec by\n      https://github.com/w3c/webrtc-stats/pull/824\n\n    Bug: webrtc:42223582\n    Change-Id: I32b6eeef130f8bb9dfd95dc6ce1b7fb75a2c9aa5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505441\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48829}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/stats/rtcstats_objects.cc", "third_party/libwebrtc/api/stats/rtcstats_objects.h", "third_party/libwebrtc/call/video_send_stream.h", "third_party/libwebrtc/media/base/media_channel.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/pc/rtc_stats_collector.cc", "third_party/libwebrtc/pc/rtc_stats_collector_unittest.cc", "third_party/libwebrtc/pc/rtc_stats_integrationtest.cc", "third_party/libwebrtc/video/g3doc/stats.md", "third_party/libwebrtc/video/send_statistics_proxy.cc", "third_party/libwebrtc/video/send_statistics_proxy_unittest.cc"], "git_node": "bf46749b5867e548a00ff81396fb853a7b367967", "git_parents": ["36a367e39ba7c6b4d429128b4f1805443438e11c"], "node": "6a237e3007557e61d21674c56ac0bcf48d48ec02", "parents": ["0f277567ce7718582b454ec588ada69b268a6b9d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 5a076f110e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5a076f110ee1c60a62567175b8f231a4489efc23\n    Remove two expired audio receive delay histograms\n\n    Once per second, ChannelReceive posts a task from the audio thread to\n    the worker thread. The task takes the NetEq lock again, queries the ADM\n    playout delay and records four histograms. Three of them have expired in\n    Chromium, which discards their samples:\n\n      WebRTC.Audio.TargetJitterBufferDelayMs\n      WebRTC.Audio.ReceiverDelayEstimateMs\n      WebRTC.Audio.ReceiverDeviceDelayMs\n\n    Example:\n    https://source.chromium.org/chromium/chromium/src/+/main:tools/metrics/histograms/metadata/web_rtc/histograms.xml?q=TargetJitterBufferDelayMs&ss=chromium\n\n    Remove the two that need the ADM playout delay, ReceiverDelayEstimateMs\n    and ReceiverDeviceDelayMs. Keep TargetJitterBufferDelayMs, which is\n    going to be reactivated in Chromium, and record it together with\n    WebRTC.Audio.ReceiverJitterBufferDelayMs directly on the audio thread,\n    from values read while the NetEq lock is already held for GetAudio().\n    This removes one cross-thread task per stream per second, a NetEq lock\n    acquisition and the ADM call, and with them the only use of\n    worker_safety_.\n\n    The ADM playout delay is deliberately not queried on the audio thread,\n    since some ADM implementations (e.g. ObjCAudioDeviceModule) require\n    PlayoutDelay() to be called on a specific thread.\n\n    Bug: webrtc:11993\n    Change-Id: I637e51ab931a62347f88d1f7a9f9159f5c878d46\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507000\n    Reviewed-by: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48830}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/BUILD.gn", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch"], "git_node": "6380c1880f8683b0e8c12d53c3e59787ab94d258", "git_parents": ["bf46749b5867e548a00ff81396fb853a7b367967"], "node": "981440a0ac8c92b675c4fa12022054828e836361", "parents": ["6a237e3007557e61d21674c56ac0bcf48d48ec02"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from e40a408898\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e40a408898b7ea16e59ebc8ea96c6d42c8f8753d\n    Provide RtpState at construction when restoring an RTP module\n\n    When a suspended stream was recreated, its previous state was applied\n    with SetRtpState() and SetRtxState() right after construction. This\n    required state to be mutable that otherwise could be const, which in\n    turn required a lock for every read on the encoder queue.\n\n    * Add rtp_state and rtx_rtp_state to RtpRtcpInterface::Configuration.\n    * Apply it when constructing RTPSender and ModuleRtpRtcpImpl2.\n    * RtpVideoSender and AudioSendStream, via ChannelSend, now pass the\n      suspended states at creation.\n    * Remove SetStartTimestamp(), SetRtpState() and SetRtxState() from\n      RtpRtcpInterface, ModuleRtpRtcpImpl2, as well as\n      RTPSender::SetRtxRtpState().\n    * Deprecate RTPSender::SetTimestampOffset() and SetRtpState(). Once\n      direct users of RTPSender have migrated, they can be removed and the\n      timestamp offset made const.\n\n    Bug: webrtc:42223727\n    Change-Id: Idad26fe1205c1288a3455865dfb79027ed7f83da\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507320\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48831}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/audio_send_stream.cc", "third_party/libwebrtc/audio/audio_send_stream.h", "third_party/libwebrtc/audio/audio_send_stream_unittest.cc", "third_party/libwebrtc/audio/channel_send.cc", "third_party/libwebrtc/audio/channel_send.h", "third_party/libwebrtc/audio/channel_send_unittest.cc", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/mocks/mock_rtp_rtcp.h", "third_party/libwebrtc/modules/rtp_rtcp/source/nack_rtx_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_impl2.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_impl2.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_impl2_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_interface.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0029.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0048.patch", "third_party/libwebrtc/moz-patch-stack/s0069.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch"], "git_node": "42608ae3190bafa597f085d15eff66ab4547b9e6", "git_parents": ["6380c1880f8683b0e8c12d53c3e59787ab94d258"], "node": "861258609c4e6537df5f8b71050da28329934a96", "parents": ["981440a0ac8c92b675c4fa12022054828e836361"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from d3a924adc6\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d3a924adc64313101f1d7b083472c7ed98ab5a22\n    Update WebRTC code version (2026-10-09T04:06:43).\n\n    Bug: None\n    Change-Id: Iea42574e1e159b881278ac3b05b2be33e455701d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508260\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48832}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "86e14c4d00cbd8d234372a9f705733dc3fe30d4b", "git_parents": ["42608ae3190bafa597f085d15eff66ab4547b9e6"], "node": "26b62e3c16894ca53582a3291f37d8aa32636451", "parents": ["861258609c4e6537df5f8b71050da28329934a96"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 51f254266d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/51f254266d8e244b3ec344a1868030d9361f0714\n    Track effort_level_ encoder-wide in LibaomAv1EncoderV2.\n\n    AOME_SET_CPUUSED is an encoder-wide setting in libaom, not per spatial\n    layer. Caching effort_level_by_spatial_id_ per spatial layer left\n    AOME_SET_CPUUSED stuck at the top spatial layer's speed after the first\n    multi-layer temporal unit when layers differed in effort level.\n\n    Track effort_level_ encoder-wide so AOME_SET_CPUUSED is reapplied\n    whenever a frame's effort_level differs from the previous layer frame.\n\n    Bug: webrtc:496266459\n    Change-Id: Ifa48f9923dea30fb82b3e576d5cf14516048b724\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508120\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48833}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/test/video_encoder_functional_unittest.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.h"], "git_node": "8eded9e44bc98881b50264718e9dffa9c9b89820", "git_parents": ["86e14c4d00cbd8d234372a9f705733dc3fe30d4b"], "node": "37edb58eb954d06dacd793bae685233fef92545b", "parents": ["26b62e3c16894ca53582a3291f37d8aa32636451"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from c5329b2208\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c5329b220812a16f5fb54036b2204b8d01f46b34\n    Introduce safer variants of CopyOnWriteBuffer functions\n\n    CopyOnWriteBuffer often forces its users to pass raw pointers. This\n    change introduces alternative variants that prefer std::span arguments.\n\n    On the other hand, new variants force users to use uint8_t type to\n    represent an octet dropping support for other single-byte types.\n\n    Bug: webrtc:42225170 webrtc:42226010\n    Change-Id: I608b88da24cac5e902230649638077298f515dd8\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508220\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48834}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0052.patch", "third_party/libwebrtc/moz-patch-stack/s0083.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0086.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/moz-patch-stack/s0129.patch", "third_party/libwebrtc/rtc_base/BUILD.gn", "third_party/libwebrtc/rtc_base/copy_on_write_buffer.cc", "third_party/libwebrtc/rtc_base/copy_on_write_buffer.h", "third_party/libwebrtc/rtc_base/copy_on_write_buffer_unittest.cc"], "git_node": "2af0f1c4d6d2a11417cbebf095c856d028ee604b", "git_parents": ["8eded9e44bc98881b50264718e9dffa9c9b89820"], "node": "cd3830dfdfbefafcd6d27157cd6b33a2bf5508ad", "parents": ["37edb58eb954d06dacd793bae685233fef92545b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 6f79786c97\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6f79786c977363aafe706c20c25b2037b28ab9ee\n    Add error callback parameter to CreateSframeDecryptorOrError\n\n    The callback is intentionally unused for now. This prepares the API for\n    Sframe decryption error reporting without adding a reporter or changing\n    the existing decryptor creation stub's behavior.\n\n    Update existing call sites and add a test exercising a move-only\n    callback through the public proxy, verifying that it is not invoked and\n    that the stub still returns UNSUPPORTED_OPERATION.\n\n    Bug: webrtc:479862368\n    Change-Id: I6ea7a872a460edde2f23eb8cf9e103424f8669ee\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507820\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Kacper Wasniowski \u003ckwasniow@cisco.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48835}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/rtp_receiver_interface.h", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/rtp_receiver.cc", "third_party/libwebrtc/pc/rtp_receiver.h", "third_party/libwebrtc/pc/rtp_receiver_proxy.h", "third_party/libwebrtc/pc/rtp_sender_receiver_unittest.cc"], "git_node": "dfcdcbef2f5769374fa943d20db990f465e9df01", "git_parents": ["2af0f1c4d6d2a11417cbebf095c856d028ee604b"], "node": "7968cf9310badf8e49f85c55d9f3e12be1482160", "parents": ["cd3830dfdfbefafcd6d27157cd6b33a2bf5508ad"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from ddd3e1dc17\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ddd3e1dc172f322356ca91cb764d57c7b81ed282\n    Configure RTX at construction of the RTP module\n\n    The RTX mode and payload types were being set right after the RTP module\n    had been created. That kept RTPSender's RTX state mutable, which\n    requires a lock for every read of the RTX mode.\n\n    * Add rtx mode and payload types to RtpRtcpInterface::Configuration\n    * Apply them when constructing RTPSender.\n    * RtpVideoSender now passes the RTX configuration at creation.\n    * Remove SetRtxSendStatus() and SetRtxSendPayloadType() from\n      RtpRtcpInterface and ModuleRtpRtcpImpl2.\n    * Deprecate RTPSender::SetRtxStatus() and SetRtxPayloadType(). Once\n      direct users of RTPSender have migrated, they can be removed and the\n      RTX state made const.\n\n    Invalid configurations still log an error and leave RTX off. Since all\n    RTX payload types are now applied at once, a single invalid one drops\n    the whole mapping. This keeps RTX off for a simulcast layer whose codec\n    has no RTX payload type, as before. Keeping just the RED mapping would\n    enable RTX without a way to retransmit media packets.\n\n    Bug: webrtc:42223727\n    Change-Id: I34be4f765293599fc2358c4ab52cebe1fcdb98d0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507340\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48836}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/mocks/mock_rtp_rtcp.h", "third_party/libwebrtc/modules/rtp_rtcp/source/nack_rtx_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_impl2.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_impl2.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_impl2_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_interface.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0048.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch"], "git_node": "8585e361e48640132ca35a82b82256f689841b9a", "git_parents": ["dfcdcbef2f5769374fa943d20db990f465e9df01"], "node": "edb69e252cc352db07960914411ed8c4ea3e29d9", "parents": ["7968cf9310badf8e49f85c55d9f3e12be1482160"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 3f3b784c3c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3f3b784c3c28c5a25730234b7726e917f9e44533\n    Skip TCPConnection reconnect Destroy() after shutdown\n\n    Drive-by: reconnection_timeout is now a TimeDelta.\n\n    Bug: webrtc:568852317\n    Change-Id: I1dbe0f18ebddd280bb77b345647eea115fe64e4f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507980\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48837}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/p2p/base/port_unittest.cc", "third_party/libwebrtc/p2p/base/tcp_port.cc", "third_party/libwebrtc/p2p/base/tcp_port.h", "third_party/libwebrtc/p2p/base/tcp_port_unittest.cc"], "git_node": "fb0110692e1bb52c565ca80c7660a77cca8508ca", "git_parents": ["8585e361e48640132ca35a82b82256f689841b9a"], "node": "8762ced712e6bb0ddc4b86c8b1d561762738ba42", "parents": ["edb69e252cc352db07960914411ed8c4ea3e29d9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from e56b5e0e34\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e56b5e0e34f9ab28e18833d7eff865e5a26bb8a9\n    Use minimal_symbols on debug_bot in mb_config.pyl\n\n    debug_bot configs defaulted to symbol_level=2 (full PDBs on Windows),\n    causing severe disk I/O thrashing and multi-hour link phases on Windows\n    debug builders such as win_x86_more_configs.\n\n    Include minimal_symbols (symbol_level=1, matching debug_static_bot) in\n    the debug_bot mixin so crash backtraces still have function and line\n    info without generating full type/variable debug symbols on bots.\n\n    Symbols with internal linkage (static functions or those in anonymous\n    namespaces) may not appear when using this level.\n\n    Bug: webrtc:498394143\n    Change-Id: I8ff14b77375ac428d79a2c65a656d59e52e073fe\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508320\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48838}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/mb/mb_config.pyl"], "git_node": "83968a3c0391de6e50daceea0c18d9f109025dfc", "git_parents": ["fb0110692e1bb52c565ca80c7660a77cca8508ca"], "node": "40444f92ff71ded5e1b84b98b2b02acdfe775d7e", "parents": ["8762ced712e6bb0ddc4b86c8b1d561762738ba42"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 954036a194\n\nUpstream commit: https://webrtc.googlesource.com/src/+/954036a194e9276d0752bb49738ebb2014f162b5\n    Avoid some unnecessary string and container copies\n\n    Several functions copy strings and vectors that they only read or that\n    are about to go out of scope.\n\n    - Move by-value parameters into their destination: the SSRC vector in\n      TransportFeedbackDemuxer::RegisterStreamFeedbackObserver, the key and\n      value in MediaConstraints::Constraint, which now takes them by value.\n    - Take absl::string_view for read-only strings in CreateJavaIceCandidate\n      and in frame_analyzer's JoinFilename, which now builds the path with\n      StringBuilder.\n\n    MediaConstraints::Constraint in sdk/media_constraints.h is public API.\n    Taking the strings by value is source compatible for callers.\n\n    Bug: webrtc:374845009\n    Change-Id: Idff385530c0f7800d6bd90bdb4311a43001cf069\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498541\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48839}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/rtp/transport_feedback_demuxer.cc", "third_party/libwebrtc/rtc_tools/BUILD.gn", "third_party/libwebrtc/rtc_tools/frame_analyzer/frame_analyzer.cc", "third_party/libwebrtc/sdk/media_constraints.h"], "git_node": "f2cb77dc443faedde3eacdf8678807531fce2141", "git_parents": ["83968a3c0391de6e50daceea0c18d9f109025dfc"], "node": "c93a699848db56154b44141b3f5f1bbe5aebf884", "parents": ["40444f92ff71ded5e1b84b98b2b02acdfe775d7e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from cc9fb40977\n\nUpstream commit: https://webrtc.googlesource.com/src/+/cc9fb409777230d49bebd2452edc6f4da253dd4d\n    Disable rtc_cc_test _bin targets on win_x86_more_configs\n\n    rtc_cc_test unconditionally instantiated a standalone \u003ctarget\u003e_bin\n    executable in addition to the rtc_library linked into the aggregated\n    rtc_test_suite. Because gn analyze passes 'all' as an additional\n    compile target, every affected \u003ctarget\u003e_bin executable was being\n    linked in each phase of win_x86_more_configs (~180 redundant .exe +\n    .exe.pdb links per phase), causing multi-hour link bottlenecks.\n\n    Add rtc_build_cc_test_bins (defaulting to true) to gate the standalone\n    \u003ctarget\u003e_bin target, and set rtc_build_cc_test_bins=false for the\n    win_x86_more_configs phase configs in mb_config.pyl.\n\n    Bug: webrtc:498394143\n    Change-Id: I826891ddfc0e098d3ffccd7984acb5b02e787f72\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508161\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48840}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0068.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/moz-patch-stack/s0105.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/tools_webrtc/mb/mb_config.pyl", "third_party/libwebrtc/webrtc.gni"], "git_node": "663a4a3d4052e2caee0d3ad755b8dfc6c94625c0", "git_parents": ["f2cb77dc443faedde3eacdf8678807531fce2141"], "node": "3059544196e52d27e430543cfe56fefdf91e7aa2", "parents": ["c93a699848db56154b44141b3f5f1bbe5aebf884"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from bbd7e97c15\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bbd7e97c15e1d493ee10fc6d1d59ec05e9b6bfd6\n    DualPi2: Fix L4S double marking and backlog guard\n\n    Aligns DualPi2NetworkQueue marking and dropping behavior with RFC 9332\n    and Linux sch_dualpi2 (!drop_early):\n\n    1. Single L4S marking on dequeue: Previously, ShouldTakeAction() rolled\n       the random PI2 marking probability for ECT(1) packets in both\n       EnqueuePacket() and DequeuePacket(), resulting in an effective\n       marking probability of 2*p - p^2 instead of p. L4S packets are now\n       only evaluated for marking on dequeue.\n    2. Time-based step_threshold: Replaces the byte-based step_threshold_\n       (which required Config::link_rate to be set and dropped classic\n       packets on enqueue) with Config::step_threshold as a TimeDelta\n       (defaulting to PlusInfinity) checked against L4S packet sojourn time\n       on dequeue.\n    3. Standing-queue backlog guard: Adds Config::min_backlog_packets\n       (defaulting to 2) so that small 1-packet bursts are not marked or\n       dropped when there is no standing queue backlog.\n\n    Bug: webrtc:447037083, webrtc:42225697\n    Change-Id: I2f75a159f895c6b994e2665ce9f77d0fb6f6cb45\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508160\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48841}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/test/network_emulation/BUILD.gn", "third_party/libwebrtc/api/test/network_emulation/dual_pi2_network_queue.cc", "third_party/libwebrtc/api/test/network_emulation/dual_pi2_network_queue.h", "third_party/libwebrtc/api/test/network_emulation/dual_pi2_network_queue_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0087.patch", "third_party/libwebrtc/test/peer_scenario/bwe_integration_tests/scream_test.cc"], "git_node": "d06795bbf7aa5c859a35fb6322800d6069d02074", "git_parents": ["663a4a3d4052e2caee0d3ad755b8dfc6c94625c0"], "node": "88d5b3b2c68346f9bb31d2cd09a0a4dc867a7af8", "parents": ["3059544196e52d27e430543cfe56fefdf91e7aa2"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 505f76ab8a\n\nUpstream commit: https://webrtc.googlesource.com/src/+/505f76ab8a10dea13c88f736d87b2be4cabd2b69\n    DualPi2: Implement WRR credit scheduler\n\n    Implements the RFC 9332 / Linux sch_dualpi2 byte-weighted round-robin\n    (WRR) credit scheduler (Config::c_protection, defaulting to 10% weight\n    for the classic queue and 90% weight for the L4S queue):\n\n    1. Prevents classic queue starvation: Previously, l4s_queue_ had strict\n       priority over classic_queue_, allowing sustained L4S traffic to\n       starve non-ECT packets (such as ICE STUN pings) in classic_queue_\n       and inflate RTT measurements.\n    2. Coupled queue delay sampling: Updates UpdateBaseMarkingProbability()\n       to sample max(l4s_queue_delay, classic_queue_delay) per RFC 9332 so\n       alternating dequeues between classic and L4S queues do not cause\n       negative integral updates while both queues are backlogged.\n\n    Bug: webrtc:447037083, webrtc:42225697\n    Change-Id: Ie0cc4fb39ad9e5c9f412a2046f648381f94d5f13\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508180\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48842}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/test/network_emulation/BUILD.gn", "third_party/libwebrtc/api/test/network_emulation/dual_pi2_network_queue.cc", "third_party/libwebrtc/api/test/network_emulation/dual_pi2_network_queue.h", "third_party/libwebrtc/api/test/network_emulation/dual_pi2_network_queue_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0087.patch"], "git_node": "c9eb9acd1af4e44fa5bf5017722fbec458748b55", "git_parents": ["d06795bbf7aa5c859a35fb6322800d6069d02074"], "node": "8c3ef482bf458fa5be45f078d41d538167a345f4", "parents": ["88d5b3b2c68346f9bb31d2cd09a0a4dc867a7af8"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from a991a81549\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a991a81549ebb9a689297d3b90dbce2b9d1bddfd\n    Add src/third_party/android_deps/cipd DEPS entry\n\n    Chromium moved //third_party/android_deps/autorolled up into\n    //third_party/android_deps (https://crrev.com/c/8527206), so its\n    BUILD.gn now expects the chromium/third_party/android_deps/autorolled\n    CIPD package at third_party/android_deps/cipd. Chromium's DEPS has\n    fetched the package to both paths since https://crrev.com/c/8485271.\n\n    Fetch it to both paths here too, with the same version. The chromium\n    roller updates CIPD versions by path, so both entries stay in sync\n    until Chromium drops the old path. The old entry can then be removed\n    once chromium_revision is past the move.\n\n    Bug: chromium:562517138\n    Change-Id: I1ff22f941a6c49eb7dc94512dd3ea1a37a173fd9\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508200\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Peter Wen \u003cwnwen@google.com\u003e\n    Auto-Submit: Peter Wen \u003cwnwen@google.com\u003e\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48843}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "02d11766964bc83d6b3b006b8366d1caf99616b7", "git_parents": ["c9eb9acd1af4e44fa5bf5017722fbec458748b55"], "node": "4c037bf062e1065d3dd0d0653b0c58e76493e1e9", "parents": ["8c3ef482bf458fa5be45f078d41d538167a345f4"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from fba06dec2c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/fba06dec2cb11bb7325559c1163aeb4eb752aba7\n    Set the audio MID before creating send streams\n\n    The MID reached WebRtcVoiceSendChannel only with the send parameters. An\n    offerer applies those with the remote answer, but adds its send streams\n    with the local offer, so its audio send streams were created without a\n    MID. The MID was then set on the RTP module later, which is one of the\n    reasons why RTPSender's MID is mutable.\n\n    Add VoiceMediaSendChannelInterface::SetMid() and call it from\n    BaseChannel::SetLocalContent_w() before the send streams are added, so\n    that they're always created with the MID. A channel's MID never changes,\n    so this prepares for passing the MID to the RTP module at construction.\n\n    Video doesn't need this. It creates the underlying send stream once the\n    send parameters, including the MID, have been applied, and recreates it\n    when the MID changes.\n\n    Bug: webrtc:42223727\n    Change-Id: Iea1cbcd9b2bedd77b7cdd3673263f9491800eca9\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507360\n    Reviewed-by: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48844}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/base/fake_media_engine.cc", "third_party/libwebrtc/media/base/fake_media_engine.h", "third_party/libwebrtc/media/base/media_channel.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/pc/channel.cc", "third_party/libwebrtc/pc/channel_unittest.cc"], "git_node": "8b60251d561a96e87a1174636320631307bca083", "git_parents": ["02d11766964bc83d6b3b006b8366d1caf99616b7"], "node": "0bfc14e303b5d12ce4adbd27b32a7d2fb49013e6", "parents": ["4c037bf062e1065d3dd0d0653b0c58e76493e1e9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from d596672bf7\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d596672bf703089d988e0e90eebf45986983cd9d\n    SCReAM: Scale backoff per congestion episode using alpha delta and data_in_flight\n\n    Instead of scaling every individual feedback reaction linearly by\n    1/steps_per_rtt, reduce ref_window immediately according to alpha and\n    wait for data_in_flight to drain to ref_window plus one RTT before\n    starting a new full backoff cycle. If alpha increases further during\n    the current cycle, apply only the additional delta from the previous\n    reduction.\n\n    Bug: webrtc:447037083\n    Change-Id: I0760bc2bf402be70566a389fe7ca298a2f4cb048\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508060\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48845}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.h", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_parameters.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2_parameters.h", "third_party/libwebrtc/test/peer_scenario/bwe_integration_tests/scream_test.cc"], "git_node": "f8f16ed39e4d52126ded149bcdeaf6b1d58645bb", "git_parents": ["8b60251d561a96e87a1174636320631307bca083"], "node": "f0d0d3ba70907c3a8bb4765b0b6effcfe3e91be3", "parents": ["0bfc14e303b5d12ce4adbd27b32a7d2fb49013e6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from a05204958f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a05204958f9d94aaa4488313ace4086c52a075f4\n    Cleanup Hex(De|En)code functions to treat binary as span of uint8_t\n\n    Update all usages of HexDecode and some usages of HexEncode where\n    code become similar or simpler\n\n    Bug: webrtc:42226010\n    Change-Id: I7b8d785a81247a48c007b181ce43979863ebada6\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508321\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48846}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/webrtc_sdp.cc", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/examples/BUILD.gn", "third_party/libwebrtc/examples/turnserver/read_auth_file.cc", "third_party/libwebrtc/modules/audio_coding/acm2/audio_coding_module_unittest.cc", "third_party/libwebrtc/modules/audio_coding/neteq/test/result_sink.cc", "third_party/libwebrtc/modules/audio_coding/neteq/tools/audio_checksum.h", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0052.patch", "third_party/libwebrtc/moz-patch-stack/s0083.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0086.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/p2p/BUILD.gn", "third_party/libwebrtc/p2p/test/turn_server.cc", "third_party/libwebrtc/rtc_base/BUILD.gn", "third_party/libwebrtc/rtc_base/message_digest.cc", "third_party/libwebrtc/rtc_base/ssl_fingerprint.cc", "third_party/libwebrtc/rtc_base/string_encode.cc", "third_party/libwebrtc/rtc_base/string_encode.h", "third_party/libwebrtc/rtc_base/string_encode_unittest.cc", "third_party/libwebrtc/unsafe_buffers_paths.txt"], "git_node": "b5de72c9a8cd9405bcf981c756300bbbffdac4c7", "git_parents": ["f8f16ed39e4d52126ded149bcdeaf6b1d58645bb"], "node": "c8238fd39a8821055d6b025b55d7db2f87e66388", "parents": ["f0d0d3ba70907c3a8bb4765b0b6effcfe3e91be3"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from bd53d175d2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bd53d175d2d71ef91fe6ce22bf0a8d37c82db18e\n    Update WebRTC code version (2026-10-10T04:05:27).\n\n    Bug: None\n    Change-Id: I49ca9e9a5107ac7fd992dd483ae456cc2738b276\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508360\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48847}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "a09f31e3e2461f7dfe396e9ce3fa177774b37895", "git_parents": ["b5de72c9a8cd9405bcf981c756300bbbffdac4c7"], "node": "6d805730b699722ed1daa70a9c9f01c9fe62a039", "parents": ["c8238fd39a8821055d6b025b55d7db2f87e66388"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from aeea8ee2f0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/aeea8ee2f0827d6755259a3691e864371a1a06f3\n    Update WebRTC code version (2026-10-11T04:07:42).\n\n    Bug: None\n    Change-Id: I1a43160a6d55a19a021a53ef8e37cbd67c07adce\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508400\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48848}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "6ac49b66725464a3a9ef2e959194d2368875b01e", "git_parents": ["a09f31e3e2461f7dfe396e9ce3fa177774b37895"], "node": "48f5972e3b3ca266e798df00628b09679bd546fc", "parents": ["6d805730b699722ed1daa70a9c9f01c9fe62a039"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 7354db42ba\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7354db42baf0378bd140025c107c4d4a0e0925cf\n    Update WebRTC code version (2026-10-12T04:08:08).\n\n    Bug: None\n    Change-Id: I70b2d5f91923bbc2aa24ce8901ec08794591c520\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508500\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48849}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "69c0dd4fe0854ae7d7cb0a2b4e3ccb68ba35fc82", "git_parents": ["6ac49b66725464a3a9ef2e959194d2368875b01e"], "node": "8dabd8b9d2bbd8a050c166d22147ccd66e4931ce", "parents": ["48f5972e3b3ca266e798df00628b09679bd546fc"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 6c0dde2221\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6c0dde22214c5a26636f7581b476a03e03ccc2f7\n    Fix crash when SLD/SRD observers call Close()\n\n    SLD and SRD observers are called synchronously. If an observer closes\n    the PC from its completion callback, SdpOfferAnswerHandler would\n    continue with the rest of the operation and used state that Close() had\n    already released.\n\n    Return right after informing the observer if the PeerConnection is\n    closed. Close() already discards the candidate pool, and the remaining\n    steps (usage event, negotiation-needed check) don't apply to a closed\n    PeerConnection.\n\n    Fixed: webrtc:572454338\n    Change-Id: I372771319029aad7b2e0b9a24e59b8b5b62fd26f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508421\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48850}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/peer_connection_signaling_unittest.cc", "third_party/libwebrtc/pc/sdp_offer_answer.cc"], "git_node": "ec3035baba0b57233ad1ab036e38a6fae4f0320b", "git_parents": ["69c0dd4fe0854ae7d7cb0a2b4e3ccb68ba35fc82"], "node": "57453529ce85df73c1581919e4f8989f779a5977", "parents": ["8dabd8b9d2bbd8a050c166d22147ccd66e4931ce"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 87624bd4af\n\nUpstream commit: https://webrtc.googlesource.com/src/+/87624bd4afb7ff6fbc0b614bdb8d95d1eb64387d\n    Remove unused stream plumbing from FakePeerConnectionForStats\n\n    The fake kept local and remote StreamCollections, exposed through\n    PLAN_B_ONLY local_streams()/remote_streams() overrides and mutable\n    accessors. Neither RTCStatsCollector nor LegacyStatsCollector reads\n    streams, so the streams that rtc_stats_collector_unittest populated, as\n    well as the stream_ids()/streams() mock expectations, were dead state.\n\n    Remove the collections, their accessors and the test code that set them\n    up. This is a first step towards moving the fake to Unified Plan.\n\n    Bug: webrtc:470300031\n    Change-Id: If10d857dda3ebe2183d999e1591c016914eb8c87\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508441\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48851}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/rtc_stats_collector_unittest.cc", "third_party/libwebrtc/pc/test/fake_peer_connection_for_stats.h"], "git_node": "cc294d97b635466578c32349bc46137e54d66441", "git_parents": ["ec3035baba0b57233ad1ab036e38a6fae4f0320b"], "node": "f8497e4e80869aff48de3cd8aa68d0fd05475d4c", "parents": ["57453529ce85df73c1581919e4f8989f779a5977"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 5a6496ab82\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5a6496ab826f12407e59cc15d89aa67a4063adcd\n    Set up senders/receivers before channels in stats tests\n\n    In Unified Plan, a transceiver with its sender and receiver exists\n    before negotiation creates its channel. Many RTCStatsCollector and\n    LegacyStatsCollector tests did the reverse: they called\n    AddVoiceChannel()/AddVideoChannel() on FakePeerConnectionForStats first\n    and added senders and receivers afterwards. That only works with the\n    Plan B transceivers that the fake currently uses.\n\n    Reorder those tests so that senders and receivers are added first. The\n    channel still lands on the same transceiver. As a side effect, the mock\n    senders and receivers now receive the media channels, which no collector\n    reads. This keeps the upcoming switch of the fake to Unified Plan\n    transceivers free of test reordering.\n\n    Bug: webrtc:470300031\n    Change-Id: I5c08a50ac01223b2e57071f77923ff4a0a7e7b52\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508427\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48852}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/pc/legacy_stats_collector_unittest.cc", "third_party/libwebrtc/pc/rtc_stats_collector_unittest.cc"], "git_node": "f421f6962bf0f8e74a06ac6a218ff6218eabf818", "git_parents": ["cc294d97b635466578c32349bc46137e54d66441"], "node": "ee8eb16fa290702dc1cc7d52877dd4d0b479b8e3", "parents": ["f8497e4e80869aff48de3cd8aa68d0fd05475d4c"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 64e8deaa40\n\nUpstream commit: https://webrtc.googlesource.com/src/+/64e8deaa40d81260ea56864ae21c91909ca37301\n    Make GetAndResetCaptureProcessingTimeStats non-const.\n\n    This method was made const by mistake. It should not be as it resets the stat values.\n\n    Change-Id: Ie4c8fea675a3099dd89ea7bc59ec9c995a1eab75\n\n    Bug: b/560044202\n    Change-Id: Ie4c8fea675a3099dd89ea7bc59ec9c995a1eab75\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508340\n    Commit-Queue: Tore Rudberg \u003ctrudberg@google.com\u003e\n    Reviewed-by: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Reviewed-by: Henrik Andreassson \u003chenrika@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48853}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/audio/audio_device.h", "third_party/libwebrtc/modules/audio_device/include/mock_audio_device.h"], "git_node": "103e2e245756185266eda60e8f9efedbbc54aa6e", "git_parents": ["f421f6962bf0f8e74a06ac6a218ff6218eabf818"], "node": "2fb8fd2ee1c27571744f594bcf2578ca6cdcb904", "parents": ["ee8eb16fa290702dc1cc7d52877dd4d0b479b8e3"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 8669b30a03\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8669b30a03cb29a21267787e692ec81d4e6a28b6\n    Only update last_captured_timestamp_ for frames passed to encoding\n\n    VideoStreamEncoder::OnFrame updated last_captured_timestamp_ before\n    checking queue_overload and cwnd_frame_drop. When multiple frames\n    arrived in a batch (same millisecond), the first frame set\n    last_captured_timestamp_ and was then dropped due to queue_overload,\n    causing all subsequent frames in the batch to be dropped with\n    DropReason::kBadTimestamp.\n\n    Move the last_captured_timestamp_ update into the non-dropped branch so\n    the latest frame in a same-millisecond burst is encoded instead of\n    dropping the entire burst.\n\n    Caught by this failure:\n    https://ci.chromium.org/ui/p/webrtc/builders/ci/Mac64%20Release/40455/overview\n\n    Bug: none\n    Change-Id: I6186593809b4bb0bac5fec716336828a401602c6\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508520\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48854}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0067.patch", "third_party/libwebrtc/moz-patch-stack/s0101.patch", "third_party/libwebrtc/moz-patch-stack/s0130.patch", "third_party/libwebrtc/video/video_stream_encoder.cc", "third_party/libwebrtc/video/video_stream_encoder_unittest.cc"], "git_node": "62ab2064e98d0857ce7786cd27ca1cac59c01dcc", "git_parents": ["103e2e245756185266eda60e8f9efedbbc54aa6e"], "node": "9a8cd59ab91f517c90573e1f41523f2da8916a6b", "parents": ["2fb8fd2ee1c27571744f594bcf2578ca6cdcb904"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 08c3fae199\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in da5e1be076.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/08c3fae1991deeeda6880023d0d5b51ea19097a4\n    Enable compound prediction for 2+ reference frames in LibaomAv1EncoderV2\n\n    Configure AV1E_SET_SVC_REF_FRAME_COMP_PRED in InitEncode() with\n    use_comp_pred = {1, 0, 1} (GOLDEN_LAST and ALTREF_LAST). Libaom only\n    applies a compound pair when both underlying reference frame aliases are\n    marked as referenced in aom_svc_ref_frame_config_t, so this enables\n    compound prediction whenever a frame predicts from two or three\n    reference buffers (matching LibaomAv1Encoder V1) without per-frame\n    reconfiguration.\n\n    Add CompoundPredictionUsedForTwoAndThreeReferences in\n    LibaomAv1EncoderV2Test, parsing the encoded AV1 OBU frame headers with\n    libgav1::ObuParser to verify that reference_mode_select is false for\n    single-ref frames and true for both 2-reference (GOLDEN_LAST) and\n    3-reference (ALTREF_LAST) blended frames.\n\n    Bug: webrtc:496266459\n    Change-Id: Ic9fca08c1ed41588d99a3134211b41a28aff8775\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508140\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48855}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/da5e1be076.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "e804a3dba4c5340bf8fee217012a0213fe8cc016", "git_parents": ["62ab2064e98d0857ce7786cd27ca1cac59c01dcc"], "node": "6fdc4e09826130c8afe613f29fe485f87e29f692", "parents": ["9a8cd59ab91f517c90573e1f41523f2da8916a6b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 4e909fe722\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4e909fe722863a7a88a4401d3d682cc358783333\n    Avoid some unnecessary copies in video/ code\n\n    Several by-value parameters and locals in video/ are copied into their\n    destination at their last use, which costs a reference count round trip\n    or a container copy that a move avoids.\n\n    - Move frame_instrumentation_data into the CodecSpecificInfo copy in\n      VideoStreamEncoder::OnEncodedImage(). This saves copying the sample\n      vector per instrumented frame when corruption detection is enabled.\n    - Move sink arguments and last-use locals into members in\n      VideoStreamEncoderResourceManager::InitialFrameDropper,\n      QualityLimitationReasonTracker, DecodabilitySimulator and\n      RenderingSimulator. These run at setup or reconfiguration time, not\n      per frame.\n    - Move i420_frame_buffer in the deprecated GetSampleValuesForFrame()\n      overload.\n\n    Bug: webrtc:374845009\n    Change-Id: I537f2886e4446907e98291b4c5ce6080cf28a980\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/499480\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48856}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0067.patch", "third_party/libwebrtc/moz-patch-stack/s0101.patch", "third_party/libwebrtc/moz-patch-stack/s0130.patch", "third_party/libwebrtc/video/adaptation/video_stream_encoder_resource_manager.cc", "third_party/libwebrtc/video/corruption_detection/halton_frame_sampler.cc", "third_party/libwebrtc/video/quality_limitation_reason_tracker.cc", "third_party/libwebrtc/video/timing/simulator/decodability_simulator.cc", "third_party/libwebrtc/video/timing/simulator/rendering_simulator.cc", "third_party/libwebrtc/video/video_stream_encoder.cc"], "git_node": "2a00ea8edad7fdedc75db1cafe3c3ede44cbd6e5", "git_parents": ["e804a3dba4c5340bf8fee217012a0213fe8cc016"], "node": "ddec02a84b3c6c6bbd8272e7d36369ae3b8d9e8d", "parents": ["6fdc4e09826130c8afe613f29fe485f87e29f692"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 00fe7a7052\n\nUpstream commit: https://webrtc.googlesource.com/src/+/00fe7a705252acd96fda0719c1c356aa0bbd14d9\n    Ignore stale transport-state snapshots in JsepTransportController\n\n    JsepTransportController caches per-mid transport state (DTLS role,\n    needs-ICE-restart) on the signaling thread. The cache is updated after\n    SLD, SRD and rollback, and from a snapshot that OnDtlsRoleChange_n()\n    posts. That posted snapshot can be older than the cached one, e.g. when\n    the role changes while a description is being applied. GetDtlsRole()\n    then returns an outdated role until the next description is applied.\n\n    Snapshots now carry a version, and SetTransportStates() ignores a\n    snapshot that isn't newer than the cached one.\n\n    Fixed: webrtc:572437673\n    Change-Id: Ic468c3b0df866a44587f9a8ef1453ae426e1f75c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508420\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48857}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/jsep_transport_controller.cc", "third_party/libwebrtc/pc/jsep_transport_controller.h", "third_party/libwebrtc/pc/jsep_transport_controller_unittest.cc", "third_party/libwebrtc/pc/peer_connection.cc"], "git_node": "cb36cd2a386d2c5b94c2082a94a30c828307d5bb", "git_parents": ["2a00ea8edad7fdedc75db1cafe3c3ede44cbd6e5"], "node": "ee6e17be1ca988016397f00f7167bd3cb8c6fb6b", "parents": ["ddec02a84b3c6c6bbd8272e7d36369ae3b8d9e8d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f5f0d78143\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f5f0d781434c9c37300596982da143ce4edf1c10\n    Set AudioRtpReceiver volume without blocking\n\n    - Move the cached volume ownership to the signaling thread.\n    - Post RemoteAudioSource::SetVolume() calls made on other threads (as\n      the mobile SDK code) to the signaling thread where the observers live.\n\n    Bug: webrtc:42222804\n    Change-Id: I9f437fda29d6f11436b91e831ef6022c34e62779\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508142\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48858}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/audio_rtp_receiver.cc", "third_party/libwebrtc/pc/audio_rtp_receiver.h", "third_party/libwebrtc/pc/audio_rtp_receiver_unittest.cc", "third_party/libwebrtc/pc/remote_audio_source.cc", "third_party/libwebrtc/pc/remote_audio_source.h"], "git_node": "14661d98fd8fc645e05325eededf4d88bf286af5", "git_parents": ["cb36cd2a386d2c5b94c2082a94a30c828307d5bb"], "node": "7192ccb534d4b72e84205f00210d385c5839ecbb", "parents": ["ee6e17be1ca988016397f00f7167bd3cb8c6fb6b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from c50393086e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c50393086ecd443ddf456eef223d57f33384defe\n    Remove debug_static_bot config\n\n    This is a no-op, the config is a duplicate of debug_bot after https://webrtc-review.git.corp.google.com/c/src/+/508320.\n\n    Change-Id: I8dffaf32b61f7c026bebecb06cd9d3f4db393778\n    Bug: webrtc:568762264\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508102\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48859}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/mb/mb_config.pyl"], "git_node": "bf9e77aaf90a5e96bdf8e579cbf2c35b0bf29d21", "git_parents": ["14661d98fd8fc645e05325eededf4d88bf286af5"], "node": "78e4366c6e1b76345f1894347f26d59048114e08", "parents": ["7192ccb534d4b72e84205f00210d385c5839ecbb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from f10949a957\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f10949a957cb5ffd1fab26f63cb2e82141f30ad6\n    Cleanup RtpSenderVideo tests\n\n    Move object under test out of the fixtures; allow to create it with\n    different provided dependencies and options. Merge all fixtures into\n    one. Remove retransmission_rate_limiter - limit is never set, so not\n    setting it doesn't change the behavior. Note that\n    retransmission_rate_limiter is no longer used in production code.\n\n    Bug: None\n    Change-Id: If48061bfcd52e276b3cb46923963eae1c585e7c4\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507900\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48860}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/BUILD.gn", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc"], "git_node": "641942b9a82f36e47f32644a745a5ecb55bfee6f", "git_parents": ["bf9e77aaf90a5e96bdf8e579cbf2c35b0bf29d21"], "node": "b3cb7a65fdf7950a1b722cf5c102d84ab6f26150", "parents": ["78e4366c6e1b76345f1894347f26d59048114e08"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 7f4ac197a5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7f4ac197a52ee98fd64347462987136c93d731af\n    Optionally use a socket-capable worker thread as the network thread\n\n    Provide a migration path for integrations that set the network_thread to\n    nullptr while providing a thread object that is configured as a network\n    thread (can create sockets) for the worker thread configuration\n    variable.\n\n    This makes the next step of triggering a fatal error, less likely for\n    some downstream integrations.\n\n    - Add SocketServer::CanCreateSockets(). Returns false by default,\n    - When network_thread is not set and the socket server of the worker\n      thread can create sockets, ConnectionContext logs a warning and uses\n      the worker thread as the network thread.\n\n    Applications should still set network_thread instead of worker_thread.\n    See PSA: https://groups.google.com/g/discuss-webrtc/c/Fs_Hd5XNJh0\n\n    Bug: webrtc:558821261\n    Change-Id: Ic66938190d1083c3980c165d3fa405dc9ae4c588\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508141\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48861}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/p2p/test/nat_socket_factory.h", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/connection_context.cc", "third_party/libwebrtc/pc/peer_connection_factory_unittest.cc", "third_party/libwebrtc/rtc_base/firewall_socket_server.h", "third_party/libwebrtc/rtc_base/null_socket_server_unittest.cc", "third_party/libwebrtc/rtc_base/physical_socket_server.h", "third_party/libwebrtc/rtc_base/physical_socket_server_unittest.cc", "third_party/libwebrtc/rtc_base/socket_server.h", "third_party/libwebrtc/rtc_base/virtual_socket_server.h", "third_party/libwebrtc/test/network/fake_network_socket_server.h", "third_party/libwebrtc/test/run_loop.cc", "third_party/libwebrtc/test/run_loop.h"], "git_node": "7cb6c5abada2903938f09e6e2b16d22c1eb6e7e6", "git_parents": ["641942b9a82f36e47f32644a745a5ecb55bfee6f"], "node": "77bbcfcf66ef5e739381711ea63269f297c84cef", "parents": ["b3cb7a65fdf7950a1b722cf5c102d84ab6f26150"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 7bcf10230e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7bcf10230e8669d1d8978d262dce18558ec9a7e5\n    Fix sanitizer issue with StdoutMetricsExporter\n\n    Change-Id: I735ad5e51ef09c3e518b3ea68a2b146eb8c12d8b\n    Bug: b/571554184\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508101\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48862}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/test/metrics/BUILD.gn", "third_party/libwebrtc/api/test/metrics/DEPS", "third_party/libwebrtc/api/test/metrics/stdout_metrics_exporter.cc", "third_party/libwebrtc/api/test/metrics/stdout_metrics_exporter.h", "third_party/libwebrtc/api/test/metrics/stdout_metrics_exporter_test.cc"], "git_node": "2cd34fafa27fdd5bfef8fd45602f2b1b0f2b6256", "git_parents": ["7cb6c5abada2903938f09e6e2b16d22c1eb6e7e6"], "node": "560c391e89554145cd58b741e7f77948e569ca80", "parents": ["77bbcfcf66ef5e739381711ea63269f297c84cef"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 97c21f2e2d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/97c21f2e2ddb959b30146704d1800b946d8e9a58\n    Set the MID at construction of the RTP module\n\n    The MID was being set with SetMid() right after creation. That required\n    a lock for every read of the property, preventing it from being const.\n\n    * Add `mid` to RtpRtcpInterface::Configuration\n    * Apply it when constructing RTPSender\n    * RtpVideoSender and ChannelSend now pass the MID at creation\n    * Whether the MID header extension is registered still follows\n      negotiation.\n    * Remove SetMid() from RtpRtcpInterface and ModuleRtpRtcpImpl2\n    * Deprecate RTPSender::SetMid(). Once direct users of RTPSender have\n      migrated, it can be removed and the MID made const.\n\n    Audio send streams are already created with their MID. AudioSendStream\n    now DCHECKs that the MID doesn't change on reconfiguration, like the\n    SSRC, and WebRtcVoiceSendChannel::SetMid() no longer updates existing\n    send streams but DCHECKs that there are none when the MID changes.\n\n    Bug: webrtc:42223727\n    Change-Id: I36d66dff566c050d8db224fee93b553a66afc050\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507380\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48863}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/audio_send_stream.cc", "third_party/libwebrtc/audio/channel_send.cc", "third_party/libwebrtc/audio/channel_send.h", "third_party/libwebrtc/audio/channel_send_unittest.cc", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/media/base/media_channel.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/modules/rtp_rtcp/mocks/mock_rtp_rtcp.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_impl2.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_impl2.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_interface.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0029.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0048.patch", "third_party/libwebrtc/moz-patch-stack/s0069.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch"], "git_node": "97284f55da15cdd965b8300ff307e3d553eec67b", "git_parents": ["2cd34fafa27fdd5bfef8fd45602f2b1b0f2b6256"], "node": "5ca265ce1986f421fbb3b24f10216fa146c51504", "parents": ["560c391e89554145cd58b741e7f77948e569ca80"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 (MOZ) - Recreate the send stream instead of reconfiguring it when the MID changes. r=webrtc-reviewers,bwc\n\nAudioSendStream DCHECKs that the MID does not change on reconfiguration (added\nby upstream 97c21f2e2d, \"Set the MID at construction of the RTP module\"), so\na MID change on a live send stream must recreate it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335074\n", "files": ["dom/media/webrtc/libwebrtcglue/AudioConduit.cpp"], "git_node": "432da4f9057d332cfe6e4d45467bb4a1ec8da181", "git_parents": ["97284f55da15cdd965b8300ff307e3d553eec67b"], "node": "53d7c88215236f63074796070598fc31a5ef25bf", "parents": ["5ca265ce1986f421fbb3b24f10216fa146c51504"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 43636920df\n\nUpstream commit: https://webrtc.googlesource.com/src/+/43636920dfc60b15bd073dd2462c3aa2b59a9c4a\n    Move legacy stats test helpers to a shared test library\n\n    The Plan B parts of legacy_stats_collector_unittest.cc will move to a\n    separate file, so that they can be deleted together with Plan B. Both\n    files need the same fixture and helper functions.\n\n    Move the constants, the free helper functions, the\n    LegacyStatsCollectorTest fixture and\n    CreateMockSender()/CreateMockReceiver() to a new testonly library,\n    pc/test/legacy_stats_collector_test_helpers.{h,cc}. The code moves\n    verbatim except for adjustments that the new location requires:\n\n    - The constants are inline constexpr in the header.\n    - CreateMockSender() and CreateMockReceiver() are no longer static.\n    - The default argument of InitVoiceSenderInfo() is on the declaration.\n    - Function comments are on the declarations in the header.\n    - Includes, using-declarations and BUILD deps move with the code.\n\n    The tests themselves are unchanged.\n\n    Bug: webrtc:470300031\n    Change-Id: I053981c83137238b22a13254a7a3908fa4d61ac7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508147\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48864}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/legacy_stats_collector_unittest.cc", "third_party/libwebrtc/pc/test/legacy_stats_collector_test_helpers.cc", "third_party/libwebrtc/pc/test/legacy_stats_collector_test_helpers.h"], "git_node": "63430f7e9c54e2bbd89aa7899a28a1c1f999c848", "git_parents": ["432da4f9057d332cfe6e4d45467bb4a1ec8da181"], "node": "0d4a840358103e3a3ecd88e95ce930b6eefeb533", "parents": ["53d7c88215236f63074796070598fc31a5ef25bf"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from da5e1be076\n\nWe already cherry-picked this when we vendored 08c3fae199.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/da5e1be076e7807218c4d8c6bd5e532680fd0ee8\n    Revert \"Enable compound prediction for 2+ reference frames in LibaomAv1EncoderV2\"\n\n    This reverts commit 08c3fae1991deeeda6880023d0d5b51ea19097a4.\n\n    Reason for revert: Breaks borked broken downstream code\n\n    Failure Link: \u003cLINK TO FAILURE\u003e\n\n    Original change's description:\n    \u003e Enable compound prediction for 2+ reference frames in LibaomAv1EncoderV2\n    \u003e\n    \u003e Configure AV1E_SET_SVC_REF_FRAME_COMP_PRED in InitEncode() with\n    \u003e use_comp_pred = {1, 0, 1} (GOLDEN_LAST and ALTREF_LAST). Libaom only\n    \u003e applies a compound pair when both underlying reference frame aliases are\n    \u003e marked as referenced in aom_svc_ref_frame_config_t, so this enables\n    \u003e compound prediction whenever a frame predicts from two or three\n    \u003e reference buffers (matching LibaomAv1Encoder V1) without per-frame\n    \u003e reconfiguration.\n    \u003e\n    \u003e Add CompoundPredictionUsedForTwoAndThreeReferences in\n    \u003e LibaomAv1EncoderV2Test, parsing the encoded AV1 OBU frame headers with\n    \u003e libgav1::ObuParser to verify that reference_mode_select is false for\n    \u003e single-ref frames and true for both 2-reference (GOLDEN_LAST) and\n    \u003e 3-reference (ALTREF_LAST) blended frames.\n    \u003e\n    \u003e Bug: webrtc:496266459\n    \u003e Change-Id: Ic9fca08c1ed41588d99a3134211b41a28aff8775\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508140\n    \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48855}\n\n    Bug: webrtc:496266459\n    No-Presubmit: true\n    No-Tree-Checks: true\n    No-Try: true\n    Change-Id: I0b733afac5d34ed4b1b4503992fb5222cbbd9638\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508640\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48865}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/da5e1be076.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "d17deca750dc849d3e7e3251a3cdd139e09ceb82", "git_parents": ["63430f7e9c54e2bbd89aa7899a28a1c1f999c848"], "node": "a9a0120b1ccaa651858891551b094a5c52711496", "parents": ["0d4a840358103e3a3ecd88e95ce930b6eefeb533"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 5d25352d61\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5d25352d613f70ccbae6ba02592e9b1eef150403\n    Never compile _bin targets on bots.\n\n    Change-Id: Id9e2275252a32eb0ad3efb9f293b01b429dbdc41\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508581\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48866}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/mb/mb_config.pyl"], "git_node": "9368f1a285cfff0c7649c7b93825fb3e9544c438", "git_parents": ["d17deca750dc849d3e7e3251a3cdd139e09ceb82"], "node": "1e305e00ef3e8926573b11c93512706dba505bc6", "parents": ["a9a0120b1ccaa651858891551b094a5c52711496"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 6cfac08e33\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6cfac08e33542348b480c8d38353b7db38da1d74\n    SCReAM: Bound drain timer and scale burst backoff\n\n    1. Bound State 1 in ScreamV2::ScaleBackoff to at most 1 RTT after\n       last_ref_window_decrease_time_ when data_in_flight \u003e ref_window_.\n       Previously, if a new congestion episode started during a burst (or\n       if an encoder continuously overshot target_rate), State 1\n       unconditionally reset last_backoff_rtt_start_time_ to feedback_time\n       and skipped starting a new backoff cycle.\n    2. Scale down backoff proportionally by ref_window_ / data_in_flight\n       when data_in_flight exceeds ref_window_ * bytes_in_flight_head_room,\n       so transient in-flight bursts do not overly reduce ref_window_, while\n       keeping last_backoff_ tracking the unscaled backoff.\n    3. Apply allow_initial_ref_window_clamping_ after computing congestion\n       backoff in UpdateRefWindow, overriding backoff only if the initial\n       clamping backoff is larger.\n\n    Bug: webrtc:447037083\n    Change-Id: If63ab888953ccc8cf8a78c4bb66046e0d2008b46\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508600\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48867}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.cc"], "git_node": "75f67f51afa6bfe628028c5b8a2b8356c2387442", "git_parents": ["9368f1a285cfff0c7649c7b93825fb3e9544c438"], "node": "d662189f75e66d74667cb9f29f7638df9cca53dc", "parents": ["1e305e00ef3e8926573b11c93512706dba505bc6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 5e0a750143\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5e0a750143d94befeb1ddb1209a6571b8d84d58f\n    Reduce log spam in LibaomAv1EncoderV2::GetSvcParams\n\n    Every other diagnostic log in GetSvcParams and Encode uses LS_VERBOSE,\n    whereas the CQP quantizer trace was left at LS_WARNING, logging on\n    every frame encoded in CQP mode.\n\n    Bug: webrtc:496266459\n    Change-Id: Id3ea8dfef012725d19ce18cb0a5d630afb961874\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508601\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48868}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc"], "git_node": "c7bf63b1695725415a884d53c425ec2550ffbe32", "git_parents": ["75f67f51afa6bfe628028c5b8a2b8356c2387442"], "node": "dbf6c83dc938bf05bde982ba09a1343dd7cb620f", "parents": ["d662189f75e66d74667cb9f29f7638df9cca53dc"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from c743fa65f5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c743fa65f59479815d5715564d9caf6fca660cde\n    Group the Plan B-only legacy stats tests at the end of the file\n\n    Three StatsCollectorTrackTest tests depend on Plan B:\n    FilterOutNegativeInitialValues and TwoLocalTracksWithSameSsrc return\n    early unless they run in the MediaStream mode, and\n    TwoLocalSendersWithSameTrack adds two senders to one transceiver.\n\n    Move them unchanged to the end of legacy_stats_collector_unittest.cc.\n    This keeps the relocation out of the upcoming change that splits the\n    HasStream parameterization.\n\n    Bug: webrtc:470300031\n    Change-Id: I0d28704d3c2f8f24efb9fbcc8766cc3444a48a85\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508428\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Auto-Submit: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48869}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/pc/legacy_stats_collector_unittest.cc"], "git_node": "c8700267a900599ed143f6fa0aa7a4e15192f653", "git_parents": ["c7bf63b1695725415a884d53c425ec2550ffbe32"], "node": "3411153793d8efe5312a5480415bf9690a0c3f6b", "parents": ["dbf6c83dc938bf05bde982ba09a1343dd7cb620f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 8bf6fb4d98\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8bf6fb4d989e656e366613657b2a95b4b917bf15\n    dcsctp: Do not retransmit expired chunks\n\n    ExpireOutstandingChunks stops at the first non-expired chunk to avoid\n    scanning the entire queue when no FORWARD-TSN can be sent past that\n    point. However, chunks further back in the queue were not checked for\n    expiration before being scheduled for or extracted for retransmission,\n    causing expired messages to still be retransmitted while an earlier\n    message remained unacknowledged.\n\n    Fix this by checking chunk expiration when NACKing and when preparing\n    chunks to be retransmitted.\n\n    Bug: webrtc:572113603\n    Change-Id: I46cdbaf603e6bd997b994a4d25a014801362b58f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508540\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48870}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/net/dcsctp/socket/dcsctp_socket.cc", "third_party/libwebrtc/net/dcsctp/socket/dcsctp_socket_test.cc", "third_party/libwebrtc/net/dcsctp/socket/transmission_control_block.cc", "third_party/libwebrtc/net/dcsctp/socket/transmission_control_block.h", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data.cc", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data.h", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data_test.cc", "third_party/libwebrtc/net/dcsctp/tx/retransmission_queue.cc", "third_party/libwebrtc/net/dcsctp/tx/retransmission_queue.h", "third_party/libwebrtc/net/dcsctp/tx/retransmission_queue_test.cc"], "git_node": "214bbb87b5b6f22ff4847713f5312201badd84d2", "git_parents": ["c8700267a900599ed143f6fa0aa7a4e15192f653"], "node": "2c0437302b8d47aab242ec3b5fa895abf2fb992a", "parents": ["3411153793d8efe5312a5480415bf9690a0c3f6b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from acc4489589\n\nUpstream commit: https://webrtc.googlesource.com/src/+/acc448958995ea04e450ccf3ac220ba2c55c486e\n    Remove RTPSender's deprecated setters\n\n    RTPSender gets its timestamp offset, MID and RTX configuration from\n    RtpRtcpInterface::Configuration at construction. The setters that were\n    deprecated when those fields were added kept that state mutable, so\n    every read of it needed send_mutex_.\n\n    Remove SetTimestampOffset(), SetRtpState(), SetMid(), SetRtxStatus() and\n    SetRtxPayloadType(), and make the state const:\n\n    - TimestampOffset() and RtxStatus() no longer take the lock.\n      SupportsRtxPayloadPadding() only takes it when RTX payload padding is\n      possible.\n    - Packets are built with the MID directly instead of a copy taken under\n      the lock.\n    - The RTX payload type is looked up without the lock.\n\n    Bug: webrtc:42223727\n    Change-Id: Iecb8ec71d1ae11b6e5f2dfd8611fd696f8568a97\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507400\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48871}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender.h", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0048.patch"], "git_node": "111e9d85bb355ba3d2fd0f3dde0d8aff1c8d033f", "git_parents": ["214bbb87b5b6f22ff4847713f5312201badd84d2"], "node": "d45b9b8410c41d05d4a79389478c855e8da46227", "parents": ["2c0437302b8d47aab242ec3b5fa895abf2fb992a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from b321f63492\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b321f634929af0af61a8964487fbd7894a008f12\n    Reland \"Enable compound prediction for 2+ reference frames in LibaomAv1EncoderV2\"\n\n    This is a pure reland of commit 08c3fae1991deeeda6880023d0d5b51ea19097a4\n    The downstream build failure has been fixed.\n\n    Original change's description:\n    \u003e Enable compound prediction for 2+ reference frames in LibaomAv1EncoderV2\n    \u003e\n    \u003e Configure AV1E_SET_SVC_REF_FRAME_COMP_PRED in InitEncode() with\n    \u003e use_comp_pred = {1, 0, 1} (GOLDEN_LAST and ALTREF_LAST). Libaom only\n    \u003e applies a compound pair when both underlying reference frame aliases are\n    \u003e marked as referenced in aom_svc_ref_frame_config_t, so this enables\n    \u003e compound prediction whenever a frame predicts from two or three\n    \u003e reference buffers (matching LibaomAv1Encoder V1) without per-frame\n    \u003e reconfiguration.\n    \u003e\n    \u003e Add CompoundPredictionUsedForTwoAndThreeReferences in\n    \u003e LibaomAv1EncoderV2Test, parsing the encoded AV1 OBU frame headers with\n    \u003e libgav1::ObuParser to verify that reference_mode_select is false for\n    \u003e single-ref frames and true for both 2-reference (GOLDEN_LAST) and\n    \u003e 3-reference (ALTREF_LAST) blended frames.\n    \u003e\n    \u003e Bug: webrtc:496266459\n    \u003e Change-Id: Ic9fca08c1ed41588d99a3134211b41a28aff8775\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508140\n    \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48855}\n\n    Bug: webrtc:496266459\n    Change-Id: Ic530b9882b2de469ae2f7305c482f894f475a6a3\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508740\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48872}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/av1/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/av1/DEPS", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0140.patch"], "git_node": "16a08896179493d4a2105ab628a700c51b26fdae", "git_parents": ["111e9d85bb355ba3d2fd0f3dde0d8aff1c8d033f"], "node": "3a606a1288062b1c9d5a86e6e5d28c1d1a3d0cdb", "parents": ["d45b9b8410c41d05d4a79389478c855e8da46227"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from c9688bcc73\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c9688bcc73ba82398068753922b3e1c59abba8a3\n    [M157] Avoid reusing released decoders after SetDecoders()\n\n    Original change's description:\n    \u003e Avoid reusing released decoders after SetDecoders()\n    \u003e\n    \u003e SetDecoders() only deregistered decoders that were removed or changed,\n    \u003e but it also reset the decoder database's active payload type. The next\n    \u003e frame then released the active decoder and configured the same instance\n    \u003e again. Not all decoders support that: Chromium's hardware decoders fail\n    \u003e Configure() after Release() and permanently fall back to software\n    \u003e decoding. This happens e.g. when the receiving side creates a new offer,\n    \u003e since that typically changes the set of receive codecs.\n    \u003e\n    \u003e Deregister all of the previous decoders instead, so that the factory\n    \u003e creates new instances on demand. This matches how decoders were handled\n    \u003e before the receive stream stopped being recreated on decoder changes\n    \u003e (https://webrtc-review.googlesource.com/c/src/+/494540).\n    \u003e\n    \u003e Bug: chromium:572220780\n    \u003e Change-Id: Ibe646151c9803aab1e01665b8a70352f09e5c101\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508961\n    \u003e Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48904}\n\n    (cherry picked from commit 157bdfb63caa236d7bbdd0889f99ddba96a44fee)\n\n    Bug: chromium:573916493,chromium:572220780\n    Change-Id: Ibe646151c9803aab1e01665b8a70352f09e5c101\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/509962\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/branch-heads/8103@{#1}\n    Cr-Branched-From: b321f634929af0af61a8964487fbd7894a008f12-refs/heads/main@{#48872}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h", "third_party/libwebrtc/video/video_receive_stream2_unittest.cc"], "git_node": "93451353f231a3a50fae161b855416516b3df6ed", "git_parents": ["16a08896179493d4a2105ab628a700c51b26fdae"], "node": "b905657adba04689364a5322f75b1cab45e75904", "parents": ["3a606a1288062b1c9d5a86e6e5d28c1d1a3d0cdb"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 4fe3aece79\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4fe3aece79809e8de2dda21f8581bf980723ab54\n    [M157] Keep unchanged video decoders across SetDecoders()\n\n    Original change's description:\n    \u003e Keep unchanged video decoders across SetDecoders()\n    \u003e\n    \u003e Updating the receive codecs, e.g. when the receiving side creates a new\n    \u003e offer, deregistered all decoders and reset the decoder database. The\n    \u003e decoder in use was then recreated and needed a keyframe even if its\n    \u003e configuration hadn't changed, and a keyframe was always requested.\n    \u003e\n    \u003e Apply only the difference between the old and new decoders instead.\n    \u003e Removed or updated decoders are deregistered, added or updated ones are\n    \u003e registered and unchanged decoders, including the one in use, keep\n    \u003e running. A keyframe is now only requested if the decoder in use was\n    \u003e removed or replaced.\n    \u003e\n    \u003e Fixed: chromium:572220780\n    \u003e Change-Id: Ia4e6e4682c8ece42fc175f24d4b406345bd4a81d\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/508964\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48907}\n\n    (cherry picked from commit 6870f3a8aa1b1bfdc97f2b8e1dcab9461f533352)\n\n    Bug: chromium:572220780\n    Fixed: chromium:573916493\n    Change-Id: Ia4e6e4682c8ece42fc175f24d4b406345bd4a81d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/510021\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/branch-heads/8103@{#2}\n    Cr-Branched-From: b321f634929af0af61a8964487fbd7894a008f12-refs/heads/main@{#48872}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h", "third_party/libwebrtc/video/video_receive_stream2_unittest.cc"], "git_node": "3039d1c8b2fbe9a7adb939ceb3977898ac453e9f", "git_parents": ["93451353f231a3a50fae161b855416516b3df6ed"], "node": "73bb75cc4e77a893aa30578963f8c8c5297b350f", "parents": ["b905657adba04689364a5322f75b1cab45e75904"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 69d262980d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/69d262980d4763997023efa2396a550148bf9428\n    [M157] Fail EncodeFec when packets are passed radically out of order\n\n    Original change's description:\n    \u003e Fail EncodeFec when packets are passed radically out of order\n    \u003e\n    \u003e Bug: chromium:570927027\n    \u003e Change-Id: I9fd8d548e9e7935a4862dc95cb65548eba3b4c5f\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/509462\n    \u003e Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    \u003e Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48960}\n\n    (cherry picked from commit d86ac8ab5e04c7efb8f474985e1bec1f82443a34)\n\n    Bug: chromium:575705256,chromium:570927027\n    Change-Id: I9fd8d548e9e7935a4862dc95cb65548eba3b4c5f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/510540\n    Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n    Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/branch-heads/8103@{#3}\n    Cr-Branched-From: b321f634929af0af61a8964487fbd7894a008f12-refs/heads/main@{#48872}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/BUILD.gn", "third_party/libwebrtc/modules/rtp_rtcp/source/forward_error_correction.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_fec_unittest.cc"], "git_node": "821437e3e3ee7ddfa69ebba65ffe42e540f1c39d", "git_parents": ["3039d1c8b2fbe9a7adb939ceb3977898ac453e9f"], "node": "9156877aeab167c791cdc7d65cca66ce4c14d7e3", "parents": ["73bb75cc4e77a893aa30578963f8c8c5297b350f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081656 - Vendor libwebrtc from 95554e4a0c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/95554e4a0c5c343fdc989387d9d0ce18e2a2294b\n    [M157] ApplyEncoderSwitch() must not modify negotiated codecs list.\n\n    Original change's description:\n    \u003e ApplyEncoderSwitch() must not modify negotiated codecs list.\n    \u003e\n    \u003e Modifying the negotiated list was an easy way to keep track of which\n    \u003e codecs remain that have not been attempted yet. Unfortunately, this\n    \u003e causes setParameters() to fail when the application is asking to\n    \u003e reconfigure the same codec again (which is perfectly valid to try since\n    \u003e it is still negotiated). The app should be allowed to try again and a\n    \u003e simple get+setParameters() that doesn't change anything should never\n    \u003e fail.\n    \u003e\n    \u003e The fix is to introduce `available_negotiated_codecs_`, which is\n    \u003e simply a copy of `negotiated_codecs_` that ApplyEncoderSwitch() is\n    \u003e able to modify.\n    \u003e\n    \u003e Bug: chromium:575782118, b/486823390\n    \u003e Change-Id: I437d7ebee4ae7bda0d0619e601de5ac0bc78ff9e\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/510220\n    \u003e Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    \u003e Commit-Queue: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    \u003e Commit-Queue: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48987}\n\n    (cherry picked from commit 9d738557a2492104bcea32a183a7106aa2fbd547)\n\n    Bug: chromium:576141741,chromium:575782118,b/486823390\n    Change-Id: I437d7ebee4ae7bda0d0619e601de5ac0bc78ff9e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/510660\n    Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n    Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/branch-heads/8103@{#4}\n    Cr-Branched-From: b321f634929af0af61a8964487fbd7894a008f12-refs/heads/main@{#48872}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc"], "git_node": "2d5c2a4eb5d99a92249ec13370b1de9c1a77c0f8", "git_parents": ["821437e3e3ee7ddfa69ebba65ffe42e540f1c39d"], "node": "b16fcfc374e3e99f00a0c18c7fe8b31fd03df868", "parents": ["9156877aeab167c791cdc7d65cca66ce4c14d7e3"], "tags": []}], "date": 1792679432, "git_changesets": ["b6ae92144d906647cd30e4572fb5840745fc9288", "bcfbe2d7416f78a8d8b917020d22173603c5ede7", "d1af3e7721814fc8b76e04dbff87cbf3a709f2c0", "109a4db297f7d7a5b2286f5168b635262759b216", "38deb42238c44e202de70646c88a7d0b3e27dc56", "6f347db668ba093a33d31a16fef22cb132495baf", "ebd37c49fbb120f44c965e0e4bae831ba71800fe", "cc9edadc5a5847bc140da9740a626a0a7391bd7d", "6e7901e2b75d7a9b62c959ddebbf4a06d46715fe", "44bbe7844af85b9eab7eee1c19c0104cbff4cab0", "d94d94f24746e0e4fbd206f6e50ad566f433a7c1", "0ddc77a44c7ec5f2a1a08a9ac21c7732a51ff70d", "3e2b487f2c0978752fcd6d0e190ce72656e9affb", "7a1d1f1c28e22706703b5878f0035b1ec454c8fd", "744d7bb61dc2cc624339b89fe4b6cfbed357a87a", "51a4dbf1bcb1c9110156a2b910e17313b8b255ef", "6c4df45185cffe1e9e062d415d2b45011b927427", "f03c7447fa4758508a4272e76255e78ecb60d2aa", "79dbfdd35112043a8907fb788e7b93ca444d9b44", "5c5b863e08e8fdad1847