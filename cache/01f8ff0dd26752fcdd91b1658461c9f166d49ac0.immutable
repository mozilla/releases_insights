idgets/moz-radio-group/moz-radio.figma.ts", "toolkit/content/widgets/moz-select/moz-select-dropdown-desktop-v3.figma.ts", "toolkit/content/widgets/moz-select/moz-select-dropdown.figma.ts", "toolkit/content/widgets/moz-select/moz-select-menu-item-desktop-v3.figma.ts", "toolkit/content/widgets/moz-select/moz-select.figma.ts", "toolkit/content/widgets/moz-toggle/moz-toggle-desktop-v3.figma.ts", "toolkit/content/widgets/moz-toggle/moz-toggle.figma.ts", "toolkit/content/widgets/panel-list/panel-item-desktop-v3.figma.ts", "toolkit/content/widgets/panel-list/panel-item.figma.ts", "toolkit/content/widgets/panel-list/panel-list-desktop-v3.figma.ts", "toolkit/content/widgets/panel-list/panel-list.figma.ts", "toolkit/figma.config.json", "toolkit/moz.build"], "git_node": "0e9c7a6efbcf4495b3b48dc769bf2fdfc98f0953", "git_parents": ["8358ea1327a432dba2f74f47786db2ec47c7b2d5"], "node": "ced5632a74465613deb2c13daad7549bd30dd217", "parents": ["06cd3f61c5f11eb39b29355a466a7acd7875385f"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2085173 - Replace requestSpocAds with requestSpocOrImageAds. r=mconley,jonesetc\" for causing newtab failure\n\nThis reverts commit 2da42d0aa7f0bb7cd77742e84d89f7578bd2dd20.\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/DiscoveryStreamFeed.test.js"], "git_node": "0297c9a3993820a6925a15b2008b5af273aa48d1", "git_parents": ["0e9c7a6efbcf4495b3b48dc769bf2fdfc98f0953"], "node": "41e2e1d4f7d3eb4dffcc348fa2d52a3deb64b6e6", "parents": ["ced5632a74465613deb2c13daad7549bd30dd217"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072307 - Open the clicked tab on the tab group strip r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336756\n", "files": ["mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/TabDataCoordinator.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/main/java/mozilla/components/feature/tabdata/coordinator/repository/TabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/test/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabRepository.kt", "mobile/android/android-components/components/feature/tabdata-coordinator/src/testFixtures/java/mozilla/components/feature/tabdata/coordinator/fakes/FakeTabDataCoordinator.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/tabs/DefaultTabRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/TabGroupsStripContent.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripState.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/strip/redux/TabGroupsStripMiddlewareTest.kt"], "git_node": "aca952e00b04b2100198383a72e4801591f63bb5", "git_parents": ["0297c9a3993820a6925a15b2008b5af273aa48d1"], "node": "caa77871b82b1fe37e41dc6d4f324938085d6067", "parents": ["41e2e1d4f7d3eb4dffcc348fa2d52a3deb64b6e6"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2087778 - Move virtualenvs aside before deleting them when rebuilding. r=firefox-build-system-reviewers,ahochheiden\n\nLoaded DLLs can prevent deleting a virtualenv on Windows. Move it aside\nto allow rebuilding, and retry leftover cleanup on later rebuilds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338530\n", "files": ["python/mach/mach/site.py", "python/mach/mach/test/test_site.py"], "git_node": "73cac5fc060e04be47ad312ac1cb6b9a4cc07fe2", "git_parents": ["aca952e00b04b2100198383a72e4801591f63bb5"], "node": "ba7e0bbf67da8b97d6a1ca3ebef8494496b4b8ac", "parents": ["caa77871b82b1fe37e41dc6d4f324938085d6067"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2087817 - Fall through to the next block after Ion truthiness tests. r=iain\n\nvisitTestVAndBranch ends with an unconditional jump to the truthy block, so\nwhen that block comes next Ion emits a branch to the following\ninstruction. visitTestOAndBranch and visitIsNullOrLikeUndefinedAndBranchT\ndo the same while the object-emulates-undefined fuse is intact, where the\njump is all they emit. Use jumpToBlock, which leaves the jump out when the\ntarget is reached by falling through.\n\nFor `if (v) { ... }` where the last type tested is a string, arm64 goes from\n\n  ldr   w16, [x16, #4]\n  cmp   w16, #0\n  b.eq  \u003cfalsy\u003e\n  b     \u003cnext block\u003e\n\nto the same code without the final b, and x86-64 likewise loses the jmp in\n\n  cmpl  $0x0, 0x4(%r11)\n  je    \u003cfalsy\u003e\n  jmp   \u003cnext block\u003e\n\nOn a JetStream 3 run on arm64 this cuts the unconditional branches to the\nnext instruction in Ion code from 9,001 to 1,163.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338552\n", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": "378f6cee2b089a0e23b75876caafd61c76fc44ae", "git_parents": ["73cac5fc060e04be47ad312ac1cb6b9a4cc07fe2"], "node": "42441f3e03adae889de7a047f4f8daefe1450675", "parents": ["ba7e0bbf67da8b97d6a1ca3ebef8494496b4b8ac"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2087820 - Send every remaining GC thing to the slow path with one tag test in Ion ValueToString. r=iain\n\nAfter its fast paths for strings, numbers, undefined, null and booleans,\nvisitValueToString sends objects, symbols and BigInts to the same\nout-of-line ToStringSlow call with a separate tag test for each. Those are\nthe only GC things left at that point, so test the tag once with\nbranchTestGCThing. This adds the Register tag overload of\nbranchTestGCThing that the other tag tests already have.\n\narm64:\n\n  cmn   w5, #4\n  b.eq  \u003cool\u003e\n  cmn   w5, #1\n  b.eq  \u003cool\u003e\n  cmn   w5, #3\n  b.eq  \u003cool\u003e\n\nbecomes\n\n  cmn   w5, #5\n  b.hs  \u003cool\u003e\n\nx86-64:\n\n  cmpl  $0x1fffc, %edi\n  je    \u003cool\u003e\n  cmpl  $0x1ffff, %edi\n  je    \u003cool\u003e\n  cmpl  $0x1fffd, %edi\n  je    \u003cool\u003e\n\nbecomes\n\n  cmpl  $0x1fffb, %edi\n  jae   \u003cool\u003e\n\nWhen side effects are not supported, objects and symbols still bail out\nfirst, now through a single bailout label.\n\nOn a JetStream 3 run on arm64 this shortens all 1,141 of these sequences\nin Ion code by four instructions each.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338555\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm-inl.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/wasm32/MacroAssembler-wasm32-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h"], "git_node": "8fd886e747c45736c64afcd8fe03e336be77c331", "git_parents": ["378f6cee2b089a0e23b75876caafd61c76fc44ae"], "node": "b14c501874066fc5cf785d79ab1f38502bf0c967", "parents": ["42441f3e03adae889de7a047f4f8daefe1450675"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072422 - Trace an additional instance during continuation frame iteration. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332547\n", "files": ["js/src/jit-test/tests/wasm/stack-switching/bug2072422-01.js", "js/src/jit-test/tests/wasm/stack-switching/bug2072422-02.js", "js/src/jit-test/tests/wasm/stack-switching/bug2072422-03.js", "js/src/jit-test/tests/wasm/stack-switching/bug2072422-04.js", "js/src/jit/JitFrames.cpp", "js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmFrameIter.h", "js/src/wasm/WasmStacks.cpp"], "git_node": "a15b7b93c072a5d1567a28a5fee79037beee657c", "git_parents": ["8fd886e747c45736c64afcd8fe03e336be77c331"], "node": "55a8cbf69b6c4c497ecf781d385ab4e061c3553b", "parents": ["b14c501874066fc5cf785d79ab1f38502bf0c967"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061258 - Reset tile state count on dav1d frame init failure. r=media-playback-reviewers,chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338128\n", "files": ["media/libdav1d/moz.yaml", "media/libdav1d/reset_n_ts_on_frame_init_failure.patch", "third_party/dav1d/src/decode.c"], "git_node": "28354a23ff6092161bdf5a783cea68224a58aa2d", "git_parents": ["a15b7b93c072a5d1567a28a5fee79037beee657c"], "node": "b8b6ef4176e0ad017f13b4c1c3b5c521bd02288a", "parents": ["55a8cbf69b6c4c497ecf781d385ab4e061c3553b"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2086342: Install hg-evolve from PyPI instead of cloning it r=firefox-build-system-reviewers,glandium\n\nEvery docker-image-updatebot failure in the last few weeks was the evolve\nclone: repo.mercurial-scm.org often returns incomplete responses, and\nfoss.heptapod.net, which bug 2082468 switched to, has returned 504s and once\nhung for two hours. Install the extension from PyPI instead, pinned by hash.\nThe wheel's files match the 12.0.0 tag that the image was already using.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338498\n", "files": ["taskcluster/docker/updatebot/Dockerfile", "taskcluster/docker/updatebot/evolve-requirements.txt", "taskcluster/docker/updatebot/hgrc", "taskcluster/docker/updatebot/privileged-setup.sh", "taskcluster/docker/updatebot/setup.sh"], "git_node": "3869853ff158b16142d172377d3cb59bcbeac0b5", "git_parents": ["28354a23ff6092161bdf5a783cea68224a58aa2d"], "node": "af04bb789ee796d85ed9ce64a54b4a4ce4e14f29", "parents": ["b8b6ef4176e0ad017f13b4c1c3b5c521bd02288a"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2083975 - Wait for load before showing a universal infobar in a new window. r=omc-reviewers,mimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336938\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js"], "git_node": "6850376f392e2d7718517930de9f69e619932eb5", "git_parents": ["3869853ff158b16142d172377d3cb59bcbeac0b5"], "node": "81010ada3e05f32d14e0234d88d89ddbdfa66f9b", "parents": ["af04bb789ee796d85ed9ce64a54b4a4ce4e14f29"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087260 - Fix HandleBase allocation size accounting for move assignment r=ipc-reviewers,jld\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338130\n", "files": ["ipc/glue/SharedMemoryHandle.cpp"], "git_node": "dfe0ab8c916a0aa6fa90d9ef3439f9eb0b4d3df9", "git_parents": ["6850376f392e2d7718517930de9f69e619932eb5"], "node": "da405b9a5d03161360402741cb2ecab2563e5ba7", "parents": ["81010ada3e05f32d14e0234d88d89ddbdfa66f9b"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087260 - Test shmem-allocated and shmem-mapped reporting r=ipc-reviewers,jld\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338376\n", "files": ["ipc/gtest/TestSharedMemory.cpp"], "git_node": "79ad6140fc923e0752e77fa7aaea011bd96ff3d2", "git_parents": ["dfe0ab8c916a0aa6fa90d9ef3439f9eb0b4d3df9"], "node": "40657d4bb0154c7792e3fd4730109ed4493cf6a1", "parents": ["da405b9a5d03161360402741cb2ecab2563e5ba7"], "tags": []}, {"author": "Aleix Pol i Gonzalez \u003caleix.pol@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2046372 - Support background-clip: border-area r=emilio,layout-reviewers,gfx-reviewers,wsmind,gw\n\nClip backgrounds to the painted border shape for dashed, dotted, and\ndouble borders.\n\nIn particular, it makes it possible to have a border with\nbackground-clip with shapes like dashed, dotted and double borders.\n\nIt removes expected-failure annotations for tests that are now passing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332906\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/hit_test.rs", "gfx/wr/webrender/src/pattern/repeat.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/quad_clip.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrshell/src/wrench.rs", "layout/painting/nsCSSRenderingBorders.cpp", "layout/painting/nsCSSRenderingBorders.h", "layout/painting/nsDisplayList.cpp", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-complex.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-double.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-multiple-backgrounds.html.ini", "testing/web-platform/tests/css/css-backgrounds/background-clip/clip-border-area-complex-color-ref.html", "testing/web-platform/tests/css/css-backgrounds/background-clip/clip-border-area-complex-color.html", "testing/web-platform/tests/css/css-backgrounds/background-clip/clip-border-area-multiple-backgrounds.html"], "git_node": "471f8ce5243593d5812b95154c5a6ca6a975552d", "git_parents": ["79ad6140fc923e0752e77fa7aaea011bd96ff3d2"], "node": "c9cca831e6ff30ff46484f46e3613b7db222189a", "parents": ["40657d4bb0154c7792e3fd4730109ed4493cf6a1"], "tags": []}, {"author": "Charlie Humphreys \u003cchumphreys@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084744: Update about:glean based on UX feedback r=TravisLong,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336029\n", "files": ["toolkit/content/aboutGlean.css", "toolkit/content/aboutGlean.html", "toolkit/content/aboutGlean.js", "toolkit/content/tests/browser/browser_about_glean.js", "toolkit/locales/en-US/toolkit/about/aboutGlean.ftl"], "git_node": "e638d3cf4eb1aa613df6d3e45f67ddd449182a59", "git_parents": ["471f8ce5243593d5812b95154c5a6ca6a975552d"], "node": "6d21b3c0427152250163623823e991fea36dabbe", "parents": ["c9cca831e6ff30ff46484f46e3613b7db222189a"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088053 - Ignore RUSTSEC-2026-0429 zip crate advisory r=supply-chain-reviewers,nika\n\nThis advisory is about `ZipArchive::extract()`, which we do not use in\ntree. Remove this waiver with the zip 9 upgrade in bug 2084951.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338740\n", "files": [".cargo/audit.toml"], "git_node": "4a86ff32b4ca7ff34879ef620d36d9983c96c4c3", "git_parents": ["e638d3cf4eb1aa613df6d3e45f67ddd449182a59"], "node": "af5a8f0de3f358f72d776cad1ee6886e34422708", "parents": ["6d21b3c0427152250163623823e991fea36dabbe"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053088 - Use Happy Eyeballs for SOCKS proxies via by-name connection attempts, r=necko-reviewers,valentin,mxinden\" for causing bc tests failures at browser/components\n\nThis reverts commit 8358ea1327a432dba2f74f47786db2ec47c7b2d5.\n\nRevert \"Bug 2053088 - Establish the outer proxy connection via Happy Eyeballs, r=mxinden\"\n\nThis reverts commit b95879ca6b82875c6a357d3980dd7d89ee83bf25.\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/AlternateServices.h", "netwerk/protocol/http/ConnectionEstablisher.cpp", "netwerk/protocol/http/ConnectionEstablisher.h", "netwerk/protocol/http/HappyEyeballsConnMgrDelegate.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.h", "netwerk/protocol/http/HappyEyeballsTransaction.cpp", "netwerk/protocol/http/HappyEyeballsTransaction.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpConnectionBase.h", "netwerk/protocol/http/HttpConnectionUDP.cpp", "netwerk/protocol/http/happy_eyeballs_glue/HappyEyeballs.cpp", "netwerk/protocol/http/happy_eyeballs_glue/HappyEyeballs.h", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/nsAHttpTransaction.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/protocol/http/nsHttpConnectionMgr.h", "netwerk/test/gtest/TestHappyEyeballsConnectionAttempt.cpp", "netwerk/test/gtest/TestHappyEyeballsNetAddrArray.cpp", "netwerk/test/unit/test_altsvc_proxy_cert_origin.js", "netwerk/test/unit/test_http3_proxy.js", "netwerk/test/unit/test_http3_proxy_no_speculative.js", "netwerk/test/unit/test_https_proxy_h3_outer_via_https_rr.js", "netwerk/test/unit/test_https_proxy_with_https_rr.js", "netwerk/test/unit/test_proxy_forwarding_peer_port.js", "netwerk/test/unit/test_socks_proxy_fetch.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "9c74e3558383035d609bc056dc8e1cac7f423b4b", "git_parents": ["4a86ff32b4ca7ff34879ef620d36d9983c96c4c3"], "node": "f22ea4e05d434bd28b5fcb8cd6e13cef23959b18", "parents": ["af5a8f0de3f358f72d776cad1ee6886e34422708"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086760 - Skip the DWM resize hack for windows entering fullscreen before their first paint, r=win-reviewers,gstoll.\n\nWhen a window opened with sizemode=\"fullscreen\" is the session's first fullscreen entry on Windows 11, nsWindow::TryDwmResizeHack dereferences a null mWindowRenderer, crashing on a null deref in opt and on a MOZ_ASSERT in debug.\n\nThe hack targets maximized windows going fullscreen; such a window was never shown maximized. Returning before sIsFirstFullscreenEntry is consumed keeps the hack for the next fullscreen entry. The early return also applies when widget.windows.apply_dwm_resize_hack forces the hack.\n\nThis removes the Windows standalone skip of test_fullscreen.xhtml added in bug 2026600.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337711\n", "files": ["dom/base/test/fullscreen/chrome.toml", "widget/windows/nsWindow.cpp"], "git_node": "60ce1ea25c7e24613a2c2f63629ee743f9b46e7b", "git_parents": ["9c74e3558383035d609bc056dc8e1cac7f423b4b"], "node": "69a158a7e67cc49fe8109c12b0bd1ff947aec00a", "parents": ["f22ea4e05d434bd28b5fcb8cd6e13cef23959b18"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085167 - Add logging for saved groups. r=sessionstore-reviewers,tabbrowser-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338179\n", "files": ["browser/base/content/main-popupset.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "3e5d2a6fea29b666e90c6320869cb4a9b599425c", "git_parents": ["60ce1ea25c7e24613a2c2f63629ee743f9b46e7b"], "node": "051d65ad84941d2a37e5f8e283d5ea42e90bfc06", "parents": ["69a158a7e67cc49fe8109c12b0bd1ff947aec00a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087986 - Paint the skeleton UI's toolbox rows by copying one computed gradient row. r=emilio\n\nThe output is not pixel-identical: about 0.3% of the pixels differ from the exact gradient, by one level in one channel. Painting the rows takes about as long as the solid fill did before Nova, against several milliseconds for the per-pixel gradient.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338726\n", "files": ["mozglue/misc/PreXULSkeletonUI.cpp"], "git_node": "d2b5fada64930d176efdaadc8d4f5ea0082eb071", "git_parents": ["3e5d2a6fea29b666e90c6320869cb4a9b599425c"], "node": "3186522635b69874672a444b236386ef69bc26b4", "parents": ["051d65ad84941d2a37e5f8e283d5ea42e90bfc06"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2087952 - Remove the Private Mode and Stories Entry Point experiment r=android-reviewers,android-l10n-reviewers,mobiletest-reviewers,parker,aaronmt,devota\n\n- Remove the `private-mode-and-stories-entry-point` Nimbus feature, its Settings pref and Secret Settings toggle\n- Remove the experimental header\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338648\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelperDelegate.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/HomeActivityTestRule.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/LaunchConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/StoriesPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HomeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/StoriesSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HomeScreenRedesignedUITest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/PrivateBrowsingTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/PocketMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/pocket/StoriesFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/pocket/ui/StoriesScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomepageState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/ExperimentalHomepageHeader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/Homepage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/HomepagePillButton.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/MiddleSearchHomepage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "606e6e06b94de3521e372e08fba1301e6e0281b3", "git_parents": ["d2b5fada64930d176efdaadc8d4f5ea0082eb071"], "node": "255f877826d7b554630c4c59a13b544909811440", "parents": ["3186522635b69874672a444b236386ef69bc26b4"], "tags": []}, {"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088082 - Fix implementation-status typo for compute-pressure wpt. r=aryx\n\nwptrunner only matches 'not-implementing', so these tests ran in the main wpt jobs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338758\n", "files": ["testing/web-platform/meta/compute-pressure/__dir__.ini"], "git_node": "28806f616c246a51eda014358209fd6d12206457", "git_parents": ["606e6e06b94de3521e372e08fba1301e6e0281b3"], "node": "34dbc335ef920cfd56b3bc725a1eb35a997e4d32", "parents": ["255f877826d7b554630c4c59a13b544909811440"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080324 - Stop reading the device pipeline option. r=ai-platform-reviewers,nordzilla,fluent-reviewers,bolsson\n\nOnly the onnx backend read it. cpu mapped to wasm, the default. gpu mapped to\nWebGPU, which no feature uses. onnx-native ignores it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333362\n", "files": ["toolkit/components/aboutinference/content/aboutInference.ftl", "toolkit/components/aboutinference/content/aboutInference.html", "toolkit/components/aboutinference/content/aboutInference.js", "toolkit/components/aboutinference/tests/browser/browser_aboutinference.js", "toolkit/components/ml/content/backends/ONNXPipeline.mjs", "toolkit/components/ml/docs/api.md", "toolkit/components/ml/docs/extensions.md", "toolkit/components/ml/tests/browser/browser_ml_engine_multi_perf.js", "toolkit/components/ml/tests/browser/browser_ml_engine_pipeline_options.js"], "git_node": "8d693cf5e97950f9a9071f53bc8f823465275b6c", "git_parents": ["28806f616c246a51eda014358209fd6d12206457"], "node": "3eb55a05cc145460b1871f9e3024d0f9af135948", "parents": ["34dbc335ef920cfd56b3bc725a1eb35a997e4d32"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 1: List the inference devices of the HWInference process. r=ai-platform-reviewers,nordzilla\n\nDevices that fail a real initialisation are not listed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333363\n", "files": ["config/external/mozinference/mozinference.symbols", "dom/chrome-webidl/HWInference.webidl", "dom/chrome-webidl/moz.build", "toolkit/components/ml/MLProfilerMarkers.h", "toolkit/components/ml/backends/llama/LlamaBackend.cpp", "toolkit/components/ml/backends/llama/LlamaBackend.h", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h", "toolkit/components/ml/docs/HWInference.md", "toolkit/components/ml/ipc/HWInference.cpp", "toolkit/components/ml/ipc/HWInference.h", "toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceDeviceTypes.ipdlh", "toolkit/components/ml/ipc/HWInferenceTypes.h", "toolkit/components/ml/ipc/PHWInference.ipdl", "toolkit/components/ml/ipc/moz.build", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_hwinference_device_discovery.js", "tools/@types/generated/lib.gecko.dom.d.ts"], "git_node": "38008a3cb3955283cd50e0482450830e27e749ac", "git_parents": ["8d693cf5e97950f9a9071f53bc8f823465275b6c"], "node": "43ed38f581e66d1ba5a0da15a2fb4e153c052f2a", "parents": ["3eb55a05cc145460b1871f9e3024d0f9af135948"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 2: Let a TextGenerator choose its device through a placement. r=ai-platform-reviewers,webidl,smaug,nordzilla\n\nnGpuLayers, offloadKqv and opOffload are removed from LlamaRunner. The KV\ncache and host-side ops follow the loaded device. An empty placement loads on\nthe CPU.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333364\n", "files": ["config/external/mozinference/mozinference.symbols", "dom/chrome-webidl/HWInference.webidl", "dom/chrome-webidl/TextGenerator.webidl", "dom/webidl/LlamaRunner.webidl", "toolkit/components/ml/MLProfilerMarkers.h", "toolkit/components/ml/backends/llama/LlamaBackend.cpp", "toolkit/components/ml/backends/llama/LlamaBackend.h", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h", "toolkit/components/ml/docs/HWInference.md", "toolkit/components/ml/ipc/HWInferenceDeviceTypes.ipdlh", "toolkit/components/ml/tests/browser/browser_ml_hwinference_device_discovery.js", "toolkit/components/ml/tests/gtest/TestTextGeneration.cpp", "toolkit/components/ml/textgeneration/TextGenerationChild.cpp", "toolkit/components/ml/textgeneration/TextGenerationParent.cpp", "toolkit/components/ml/textgeneration/TextGenerationParent.h", "toolkit/components/ml/textgeneration/TextGenerationTypes.ipdlh", "toolkit/components/ml/textgeneration/TextGenerator.cpp", "toolkit/components/ml/textgeneration/TextGenerator.h", "tools/@types/generated/lib.gecko.dom.d.ts"], "git_node": "c10690d069b6541fdd51e5fd046d8e7ad619668d", "git_parents": ["38008a3cb3955283cd50e0482450830e27e749ac"], "node": "42d62613be3a61f9b33736968f1eb96ee478e08c", "parents": ["43ed38f581e66d1ba5a0da15a2fb4e153c052f2a"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 3: Let the device pipeline option place a text generation. r=ai-platform-reviewers,nordzilla\n\nThe option is an HWInferencePlacement, forwarded unchanged to\nTextGenerator.create().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333365\n", "files": ["toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/components/ml/docs/HWInference.md", "toolkit/components/ml/docs/api.md", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_engine_pipeline_options.js", "toolkit/components/ml/tests/browser/browser_ml_textgeneration_engine.js", "toolkit/components/ml/tests/browser/head.js", "toolkit/components/ml/textgeneration/TextGenerationEngine.sys.mjs"], "git_node": "9dd6d555b276290556c57b777329f1b073dde042", "git_parents": ["c10690d069b6541fdd51e5fd046d8e7ad619668d"], "node": "0006690f4e1178351d8a5d21bebad94df2863b79", "parents": ["42d62613be3a61f9b33736968f1eb96ee478e08c"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 4: Record the kind of device that loaded a text generation model. r=ai-platform-reviewers,nordzilla\n\nThe device_kind extra is cpu, gpu or npu. The device id stays out of\ntelemetry. The extra is null on backends that do not place models.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333366\n", "files": ["toolkit/components/ml/MLTelemetry.sys.mjs", "toolkit/components/ml/metrics.yaml", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_textgeneration_telemetry.js", "toolkit/components/ml/textgeneration/TextGenerationEngine.sys.mjs"], "git_node": "f97cf9a848965b0c369f713262893387f1aa400e", "git_parents": ["9dd6d555b276290556c57b777329f1b073dde042"], "node": "a674077e952b856e2bcc01a8b9229d64483a0c9c", "parents": ["0006690f4e1178351d8a5d21bebad94df2863b79"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058478 - Part 5: Test llama.cpp on the Metal GPU of the macOS CI machines. r=ai-platform-reviewers,taskgraph-reviewers,jcristau,nordzilla\n\nMOZ_ML_EXPECT_ACCELERATOR makes a missing accelerator a test failure. It also\nadds a SmolLM2 chat run placed on a GPU, with no CPU fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333367\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/test-sets.yml", "toolkit/components/ml/tests/browser/browser_ml_hwinference_device_discovery.js", "toolkit/components/ml/tests/browser_models/browser_ml_smollm2_chat.js"], "git_node": "4e2e01bc5cd3b3a57f34a0b95ea2fbc50b194756", "git_parents": ["f97cf9a848965b0c369f713262893387f1aa400e"], "node": "bec672284e1f5e2c1b45b27a6315bf53e99f42f0", "parents": ["a674077e952b856e2bcc01a8b9229d64483a0c9c"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080323 - Part 1: about:inference fixes for HWInference engines. r=ai-platform-reviewers,nordzilla\n\n- Terminate HWInference engines from the page, their only owner.\n- Only query an inference process that is already running.\n- Read metrics in the shape every backend returns.\n- Pass flashAttn with a quantized KV cache.\n- Clear the polls on unload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333368\n", "files": ["toolkit/components/aboutinference/content/aboutInference.js"], "git_node": "812ae8c34e53871b235350f36ad416a1e03bf7e1", "git_parents": ["4e2e01bc5cd3b3a57f34a0b95ea2fbc50b194756"], "node": "e4a8b1ae298f4a3e530e67e0b1fd65ba9a7a6762", "parents": ["bec672284e1f5e2c1b45b27a6315bf53e99f42f0"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080323 - Part 2: Sub-tabs and a devices panel in about:inference. r=ai-platform-reviewers,fluent-reviewers,bolsson,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333369\n", "files": ["toolkit/components/aboutinference/content/aboutInference.css", "toolkit/components/aboutinference/content/aboutInference.ftl", "toolkit/components/aboutinference/content/aboutInference.html", "toolkit/components/aboutinference/content/aboutInference.js", "toolkit/components/aboutinference/tests/browser/browser_aboutinference.js"], "git_node": "878dbd795c39d0bdbdbe15aa417cd090cc6ca8a9", "git_parents": ["812ae8c34e53871b235350f36ad416a1e03bf7e1"], "node": "1f1740060e9da9e8061f626bc61516d497534e57", "parents": ["e4a8b1ae298f4a3e530e67e0b1fd65ba9a7a6762"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080323 - Part 3: Text generation panel in about:inference. r=ai-platform-reviewers,fluent-reviewers,bolsson,nordzilla\n\nQuantized KV cache types require flash attention.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333370\n", "files": ["toolkit/components/aboutinference/content/aboutInference.css", "toolkit/components/aboutinference/content/aboutInference.ftl", "toolkit/components/aboutinference/content/aboutInference.html", "toolkit/components/aboutinference/content/aboutInference.js", "toolkit/components/aboutinference/tests/browser/browser_aboutinference.js"], "git_node": "67fef1ce2acab21fbb556fa592f70a0dba547ebc", "git_parents": ["878dbd795c39d0bdbdbe15aa417cd090cc6ca8a9"], "node": "b83c59a201b7bfca0e618a2c9d09717515177a24", "parents": ["1f1740060e9da9e8061f626bc61516d497534e57"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088153 - Remove the CJK fallback warm-up workaround from crashtest 1871755-1.html r=gfx-reviewers,lsalzman\n\nBug 1962172 moved the CJK fallback order into the cached FontPrefs, so workers can use it off the main thread. The test no longer needs a main-thread measureText() call first to load it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338836\n", "files": ["gfx/tests/crashtests/1871755-1.html"], "git_node": "a221d82a896e27232b56e1fae0fea234c68c051c", "git_parents": ["67fef1ce2acab21fbb556fa592f70a0dba547ebc"], "node": "331d884d0580b4f140b6570de001f1db74ee7447", "parents": ["b83c59a201b7bfca0e618a2c9d09717515177a24"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088202 - Check for a decoder before querying hardware acceleration after a decode error. r=media-playback-reviewers,azebrowski\n\nA decoder creation or initialization failure reports its error with no decoder\nset, so the Linux and Android hardware fallback must not assume one exists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338834\n", "files": ["dom/media/MediaFormatReader.cpp"], "git_node": "7017f5b1336844f8292ee7848388a4985cab988f", "git_parents": ["a221d82a896e27232b56e1fae0fea234c68c051c"], "node": "5e3467b692aa6a111a4ae287ed77f49969d3f7e7", "parents": ["331d884d0580b4f140b6570de001f1db74ee7447"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088152 - Remove the dom.fs.writable_file_stream.enabled pref r=dom-storage-reviewers,jari\n\nBug 1798513 has long been fixed and the pref defaults to true. Drop the NS_ERROR_NOT_IMPLEMENTED check in FileSystemRequestHandler::GetWritable (and the now-unused StaticPrefs_dom.h include), the pref definition in StaticPrefList.yaml, and the test overrides (xpcshell/mochitest heads, crashtests.list, WPT __dir__.ini files).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338864\n", "files": ["dom/fs/child/FileSystemRequestHandler.cpp", "dom/fs/test/crashtests/crashtests.list", "dom/fs/test/mochitest/head.js", "dom/fs/test/xpcshell/head.js", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/file-system-access/__dir__.ini", "testing/web-platform/meta/fs/__dir__.ini"], "git_node": "9c2c7eddcb8888b9547712c3b764e2ec7d897ae9", "git_parents": ["7017f5b1336844f8292ee7848388a4985cab988f"], "node": "921ed76b2a60ca1f833f11ec87343d4aeac69db7", "parents": ["5e3467b692aa6a111a4ae287ed77f49969d3f7e7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2046372 - Annotate some tier 2 failures.\n", "files": ["testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-complex-color.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-complex.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-double.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip/clip-border-area-multiple-backgrounds.html.ini"], "git_node": "713be4e6b406a3db6538e07db3f2e5c2747fd50a", "git_parents": ["9c2c7eddcb8888b9547712c3b764e2ec7d897ae9"], "node": "fee9fef233b831a280a2e56ac86393103b4f1ce1", "parents": ["921ed76b2a60ca1f833f11ec87343d4aeac69db7"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2081437 - Update the APZ touch count when dropping touch events. r=hiro\n\n1. Bug and Cause\n\nContext menu appears after lifting a finger when touchmove is\nprevented on a different APZC.\n\nWhen a touch block is prevented, `InputQueue::ProcessQueue()`\ndrops its events without updating `mTouchCounter`.\nhttps://searchfox.org/firefox-main/rev/2ef09bbf347cd5c182552fdafb6d3e3da1864760/gfx/layers/apz/src/InputQueue.cpp#1167-1169\n\nSo, dropping `touchend` leaves the count nonzero. As a result,\na subsequent gesture on a different APZC enters the reset path\nfor the previous APZC.\nhttps://searchfox.org/firefox-main/rev/2ef09bbf347cd5c182552fdafb6d3e3da1864760/gfx/layers/apz/src/InputQueue.cpp#1163-1166\n\nThis can incorrectly mark the new touch block as already reset.\nhttps://searchfox.org/firefox-main/rev/2ef09bbf347cd5c182552fdafb6d3e3da1864760/gfx/layers/apz/src/AsyncPanZoomController.cpp#6698\n\nWhen the new touch block is canceled, its long-press timer\nshould be canceled by the call of `ResetTouchInputState`.\nhttps://searchfox.org/firefox-main/rev/2ef09bbf347cd5c182552fdafb6d3e3da1864760/gfx/layers/apz/src/InputQueue.cpp#1169\n\nBut, because the block is already marked as reset,\n`ResetTouchInputState` returns early and the timer is not reset.\nhttps://searchfox.org/firefox-main/rev/2ef09bbf347cd5c182552fdafb6d3e3da1864760/gfx/layers/apz/src/AsyncPanZoomController.cpp#6681-6685\n\n2. Solution\n\nUpdate mTouchCounter for dropped touch events so touchend returns the\ncount to zero. This prevents the unnecessary reset of the previous APZC\nwhen the next gesture starts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336894\n", "files": ["gfx/layers/apz/src/InputBlockState.cpp", "gfx/layers/apz/src/InputBlockState.h", "gfx/layers/apz/src/InputQueue.cpp", "gfx/layers/apz/test/mochitest/browser.toml", "gfx/layers/apz/test/mochitest/browser_test_prevent_default_touchmove.js", "gfx/layers/apz/test/mochitest/helper_prevent_default_touchmove.html"], "git_node": "4f964cbdaef0c6069768db5dec76e0adacfdbe01", "git_parents": ["713be4e6b406a3db6538e07db3f2e5c2747fd50a"], "node": "3354825b5e2f34be1997a5c37d4d4389ee84ae03", "parents": ["fee9fef233b831a280a2e56ac86393103b4f1ce1"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2085126 - swipe-to-nav on touchscreen: Implement happy-path on Windows. r=hiro\n\n1. Scope\n\nThis patch implements the basic single-finger swipe navigation flow on Windows.\nThe following items are addressed in subsequent patches.\n\n- considering related CSS props (i.e. touch-action and overscroll-behavior)\n- excluding two-finger gesture\n- handling diagonal swipe\n- considering widget.disable-swipe-tracker and pip\n- handling dispatch-to-content (e.g. preventDefault)\n- supporting linux\n\nNote that this patch adopts a new pref,\n\"widget.swipe.touchscreen.enabled\", which is enabled by default on Nightly.\n\n2. Summary\n\nReuse the existing SwipeTracker to recognize touchscreen swipes and drive\nthe browser's swipe navigation UI.\n\nAPZ determines which horizontal directions are available for swipe\nnavigation by checking whether any scroll target in the overscroll\nhandoff chain can scroll in those directions. It returns this information\nto the widget at the start of the touch block.\n\nThe widget tracks each touch input through four phases.\n\nEnding or canceling the touch block resets the widget's touch swipe state.\nCancellation also removes SwipeTracker, because only resetting the touch\nstate would keep the shared tracker consuming subsequent touchpad inputs.\n\n3. Difference between swipe-to-nav by pan gesture\n\nAPZ and UI/Content process continues to receive events even during\nswipe-to-nav. That is different from swipe-to-nav by pan gesture.\n\nAPZ receives every touch event before the widget processes it as a swipe,\nso it can maintain the touch block's lifecycle. Once the browser accepts\nthe swipe, SetBrowserGestureResponse tells APZ to drop the block's events\ninstead of scrolling the page.\n\nWhile the widget is Pending, mMayTriggerSwipe tells APZ to queue the first\nnon-suppressed touchmove until SetBrowserGestureResponse arrives. This\nprevents APZ from scrolling before the widget makes its swipe decision.\nConsumed drops the queued events; NotConsumed releases them for normal\ntouch handling. Later moves no longer request a browser response.\n\nTouchstart must remain unblocked so APZ can begin tap and long-press\nrecognition. Moves within slop must also remain unblocked, because the\nwidget does not make a swipe decision or send a response for those events.\n\nUI/Content process receives every touch event, because they have to maintain\ntouch event lifecycle. Because touchmove event should be kept emitted during\nswipe-to-nav and touchend event should be emitted at the end of swipe-to-nav,\nUI/Content process has to receive every touch event even after swipe-to-nav\nstarted.\n\n4. Test\n\nMochitest cases cover navigation, scrolling, slop, direction changes,\nrejection, cancellation, and recovery in subsequent gestures. Also, there are\ncases for touch/pointer event firing.\n\nGtests verify that the first swipe-candidate move does not scroll before\nthe browser response, that Consumed keeps the page stationary, and that\nNotConsumed releases the queued move and allows subsequent scrolling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336895\n", "files": ["gfx/layers/apz/public/APZBridge.h", "gfx/layers/apz/src/InputBlockState.cpp", "gfx/layers/apz/src/InputBlockState.h", "gfx/layers/apz/src/InputQueue.cpp", "gfx/layers/apz/src/OverscrollHandoffState.cpp", "gfx/layers/apz/src/OverscrollHandoffState.h", "gfx/layers/apz/test/gtest/TestBasic.cpp", "gfx/layers/ipc/LayersMessageUtils.h", "modules/libpref/init/StaticPrefList.yaml", "widget/InputData.h", "widget/nsGUIEventIPC.h", "widget/nsIWidget.cpp", "widget/nsIWidget.h", "widget/tests/browser/browser.toml", "widget/tests/browser/browser_test_touchscreen_swipe_gesture.js", "widget/tests/browser/browser_test_touchscreen_swipe_gesture_events.js", "widget/tests/browser/browser_test_touchscreen_swipe_gesture_with_pan_gesture.js", "widget/tests/browser/helper_touchscreen_swipe_navigation.html"], "git_node": "a7ce9a58b3d3c5cadf066ac46b0fbb6f5cb94f0c", "git_parents": ["4f964cbdaef0c6069768db5dec76e0adacfdbe01"], "node": "eea5a3340120792ea3b82f829135433273c278e1", "parents": ["3354825b5e2f34be1997a5c37d4d4389ee84ae03"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2085126 - swipe-to-nav on touchscreen: Prevent touchpad input from interfering with touchscreen swipes. r=hiro,mac-reviewers,bradwerth\n\nRecord the input source in SwipeTracker and consume events from the other\nsource while a swipe is active.\n\nAdd tests verifying that a touchscreen swipe can complete navigation or\nbe canceled after intervening touchpad input.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336896\n", "files": ["widget/SwipeTracker.cpp", "widget/SwipeTracker.h", "widget/cocoa/nsCocoaWindow.mm", "widget/gtk/nsWindow.cpp", "widget/nsIWidget.cpp", "widget/nsIWidget.h", "widget/tests/browser/browser_test_touchscreen_swipe_gesture_with_pan_gesture.js", "widget/windows/nsWindow.cpp"], "git_node": "3a4686cfb973bd37e19f48ce568c79db073202be", "git_parents": ["a7ce9a58b3d3c5cadf066ac46b0fbb6f5cb94f0c"], "node": "11e385cb5285420de3299c33427ed78fc302e33d", "parents": ["eea5a3340120792ea3b82f829135433273c278e1"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2085126 - swipe-to-nav on touchscreen: Reject multi-finger touch gesture. r=hiro\n\nTouchscreen swipe navigation supports single-finger gestures. But multiple\nfingers may be present in the initial MULTITOUCH_START, or another finger\nmay be added before movement (MULTITOUCH_START -\u003e MULTITOUCH_START) or\nduring an active swipe (MULTITOUCH_START -\u003e MULTITOUCH_MOVE -\u003e MULTITOUCH_START).\nAlso multiple fingers can be removed subsequently (MULTITOUCH_END -\u003e MULTITOUCH_END).\nThis patch rejects swipe navigation once more than one finger is on the\nscreen, and resets the touch swipe state when the last finger is lifted.\n\nThe widget counts the fingers with a TouchCounter before passing each\ntouch input to APZ. APZ may consume some events of a gesture with\nnsEventStatus_eConsumeNoDefault (e.g. a touchstart during a fast fling),\nand such events never reach the code after ReceiveInputEvent(). If the\nwidget counted the fingers there, a missed touchstart or touchend would\nleave the count and the phase inconsistent for the rest of the gesture\nand the subsequent ones.\n\nBasically, the part after receiving a result from APZ (i.e., HandleTouchInputAsSwipe()\nand MayStartSwipeForTouchInput()) assumes it receives all the inputs. But\nthis assumptions is not true, because APZ can consume inputs. So,\nChangePhaseForConsumedTouchInput() plays a role to maintain the consistency\nof the phase and the finger count.\n\nAlternatives considered:\n\nA. Using APZ's TouchCounter in APZCTreeManager.\n   It is not a count of the fingers on the screen. It counts the input after\n   APZ has filtered out the touches APZ decides to ignore (ref:\n   APZCTreeManager::ProcessTouchInput)\n\nB. Tracking only the first finger and ignoring the others, instead of rejecting\n   a multi-finger gesture.\n   APZ starts a new touch block for each touchstart, so it's required to send\n   a browser gesture response for every new block, and decide which block to\n   track when a finger is added before the swipe decision. Deciding which\n   finger to track would still require knowing how many fingers are on the screen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336897\n", "files": ["widget/nsIWidget.cpp", "widget/nsIWidget.h", "widget/tests/browser/browser.toml", "widget/tests/browser/browser_test_touchscreen_swipe_gesture_with_multitouch.js"], "git_node": "a05ec9f9be7a5edfb71c40d421c87b89d0b71087", "git_parents": ["3a4686cfb973bd37e19f48ce568c79db073202be"], "node": "64937b3aab8d842539ad31841fb46d1224f99c0f", "parents": ["11e385cb5285420de3299c33427ed78fc302e33d"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2085126 - swipe-to-nav on touchscreen: Respect touch-action & overscroll-behavior. r=hiro\n\nOnly report swipeable directions when touch-action does not prevent the\ntouch block from panning horizontally. Also, while checking the overscroll\nhandoff chain, reject swipe navigation if the target or an ancestor\ndisallows it through overscroll-behavior.\n\nNote that touch-action confirmed on the main thread is out-of-scope of\nthis patch. That is addressed once after mechanics for dispatch-to-content\nis established.\n\nAdd browser tests covering touch-action: pan-y and horizontal\noverscroll-behavior values auto, chain, contain, and none, including\nnested scrollers and restrictions on ancestors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336898\n", "files": ["gfx/layers/apz/src/InputQueue.cpp", "gfx/layers/apz/src/OverscrollHandoffState.cpp", "widget/tests/browser/browser.toml", "widget/tests/browser/browser_test_touchscreen_swipe_gesture_with_css.js", "widget/tests/browser/helper_touchscreen_swipe_overscroll.html"], "git_node": "cd3e562c53f76d753ef26ec07b71c58d3c2028f0", "git_parents": ["a05ec9f9be7a5edfb71c40d421c87b89d0b71087"], "node": "515f4f1abe6bdab1b092684ca5a1b094796fe5d0", "parents": ["64937b3aab8d842539ad31841fb46d1224f99c0f"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2085126 - swipe-to-nav on touchscreen: Exclude PiP windows. r=hiro,kpatenio\n\nmMayTriggerSwipe now includes if the window is PiP in order to\nprevent APZ from doing any swipe-related calculation for a PiP window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336899\n", "files": ["toolkit/components/pictureinpicture/tests/browser_disableSwipeGestures.js", "widget/nsIWidget.cpp"], "git_node": "9de4456f92de026e0abf619c99da480461001bf3", "git_parents": ["cd3e562c53f76d753ef26ec07b71c58d3c2028f0"], "node": "af6101b53548e9e135e6605b630b06b3c5d455a5", "parents": ["515f4f1abe6bdab1b092684ca5a1b094796fe5d0"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2085126 - swipe-to-nav on touchscreen: Respect swipe degree threshold and pref. r=hiro\n\nUse SwipeTracker::CanTriggerSwipe() to apply the degree threshold\nand widget.disable-swipe-tracker pref, like swipe-to-nav by pan gesture.\nWhile the threshold for pan swipe is '8', it was too tight for touch swipe.\nSo this patch adopts a new one for touch swipe, that is '3.7'.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336900\n", "files": ["widget/InputData.cpp", "widget/SwipeTracker.cpp", "widget/SwipeTracker.h", "widget/nsIWidget.cpp", "widget/tests/browser/browser_test_touchscreen_swipe_gesture.js"], "git_node": "b03d376f19b2c831f6eb9984a34ac868fda27660", "git_parents": ["9de4456f92de026e0abf619c99da480461001bf3"], "node": "3c5ae84f006eb43a9adfa67a2cac6aec63e09033", "parents": ["af6101b53548e9e135e6605b630b06b3c5d455a5"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2050884 - Split ContentPermissionRequestBase and ContentPermissionRequestParentOnlyBase r=emz,media-webspeech-reviewers,padenot,webmidi-reviewers,webserial-reviewers,gstoll,gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309398\n", "files": ["dom/base/StorageAccessPermissionRequest.cpp", "dom/base/StorageAccessPermissionRequest.h", "dom/base/nsContentPermissionHelper.cpp", "dom/base/nsContentPermissionHelper.h", "dom/geolocation/Geolocation.cpp", "dom/media/webspeech/recognition/SpeechModelDownloadPermissionRequest.cpp", "dom/midi/MIDIPermissionRequest.cpp", "dom/midi/MIDIPermissionRequest.h", "dom/webserial/SerialPermissionRequest.cpp", "dom/webserial/SerialPermissionRequest.h"], "git_node": "eb1d4d629498bc773c8a9859abf3b36c0f23e198", "git_parents": ["b03d376f19b2c831f6eb9984a34ac868fda27660"], "node": "0970f6e56a386b1f283f3782681e4b2d189749c8", "parents": ["3c5ae84f006eb43a9adfa67a2cac6aec63e09033"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Add Layer surfaces to the visual tree back to front. r=gfx-reviewers,gw\n\nNative compositor surfaces are added back to front, while Layer surfaces\nwere added front to back, with DirectComposition and CoreAnimation\ncompensating on their side. Use back to front for both.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336666\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/renderer/composite.rs"], "git_node": "cbfa53932ac4a3e657ca1ba0858e95918b45d7e5", "git_parents": ["eb1d4d629498bc773c8a9859abf3b36c0f23e198"], "node": "b19308cb9705609a5cdeebe6fdc8823720b41c73", "parents": ["0970f6e56a386b1f283f3782681e4b2d189749c8"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Name the frame building compositor kind divergences. r=gfx-reviewers,gw\n\nReplace the matches on CompositorKind in frame building with named\npredicates on CompositorKind, so that the places where the compositor\nkind changes frame building are explicit and easy to find. No behavior\nchange.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336667\n", "files": ["gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/wrench/src/composite.cpp"], "git_node": "0adbb171f3cd31545357259f37fcfe9286f9c236", "git_parents": ["cbfa53932ac4a3e657ca1ba0858e95918b45d7e5"], "node": "93326f6df0e2ac4faba7f97c8d2c1631ca50e80f", "parents": ["b19308cb9705609a5cdeebe6fdc8823720b41c73"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Let Layer compositors use the window framebuffer as their only swapchain. r=gfx-reviewers,gw\n\nA Layer compositor reports its SwapchainMode. With WindowFramebuffer,\nWebRender composites the same way as with the Draw configuration, using\nthe buffer age for partial present, but drives the compositor's swapchain\nmethods. This lets an embedder use the Layer configuration for windows\nthat have no OS layers. The behaviors that depended on the Layer kind now\ndepend on whether the compositor provides OS layers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336668\n", "files": ["gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/layer_tree.rs"], "git_node": "f07f6a829b94395104b63fbf29066b7f16e8b39f", "git_parents": ["0adbb171f3cd31545357259f37fcfe9286f9c236"], "node": "ece3d7ba2707f60bd38c906f1799eafa64b971f6", "parents": ["93326f6df0e2ac4faba7f97c8d2c1631ca50e80f"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Use the Layer configuration for Gecko's window framebuffer compositors. r=gfx-reviewers,gw\n\nGecko compositors without OS layers (EGL, OGL, ANGLE without the layer\ncompositor, and the macOS native compositor fallback) now go through\nWrCompositor and CompositorConfig::Layer like the layer compositors, and\nreport their swapchain mode over FFI. The base RenderCompositor swapchain\nmethods implement the window framebuffer case, and BindSwapChain sets the\nbuffer damage region. ANGLE and RenderCompositorNative fall back to them\nwhen they don't use OS layers.\n\nThis removes the partial present parameters of wr_window_new and\nWrPartialPresentCompositor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336669\n", "files": ["gfx/webrender_bindings/RenderCompositor.cpp", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/src/bindings.rs"], "git_node": "8ba7d3099c0bcff491020c336b6f4485a13a1bd7", "git_parents": ["f07f6a829b94395104b63fbf29066b7f16e8b39f"], "node": "d818ca0b9ef050fd9e9eb168b4930528083f7b59", "parents": ["ece3d7ba2707f60bd38c906f1799eafa64b971f6"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Add max_partial_present_rects to SwapchainMode::OsLayers. r=gfx-reviewers,gw\n\nOS layer compositors had no way to opt out of partial present, and the\nsingle dirty rect they accept was an implicit contract. Zero now disables\npartial present for OS layers. Existing compositors report one rect, so\ntheir behavior is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336670\n", "files": ["gfx/webrender_bindings/RenderCompositor.cpp", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/init.rs"], "git_node": "04b8a73ea4db0b1fc93517c014c17e6b018554fb", "git_parents": ["8ba7d3099c0bcff491020c336b6f4485a13a1bd7"], "node": "0a7c2005d6ff3f7c9997b69a0128723d9732894b", "parents": ["d818ca0b9ef050fd9e9eb168b4930528083f7b59"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Rename the partial present names that only cover the window. r=gfx-reviewers,gw\n\nPartial present applies to OS layer swapchains as well as the window, so\nnames that only cover the window or buffer age now say so:\n- RenderCompositor::UsePartialPresent becomes UseWindowPartialPresent.\n- RenderCompositor::ShouldDrawPreviousPartialPresentRegions and WebRender's\n  draw_previous_partial_present_regions become ShouldUseBufferAge and\n  uses_buffer_age.\n- WebRender's PartialPresentCompositor becomes BufferDamageCompositor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336671\n", "files": ["gfx/webrender_bindings/RenderCompositor.cpp", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderCompositorANGLE.h", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/RenderCompositorEGL.h", "gfx/webrender_bindings/RenderCompositorOGL.cpp", "gfx/webrender_bindings/RenderCompositorOGL.h", "gfx/webrender_bindings/RenderCompositorOGLSWGL.h", "gfx/webrender_bindings/RenderCompositorSWGL.h", "gfx/webrender_bindings/RendererOGL.cpp", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/layer_tree.rs"], "git_node": "c1d43edd144898fc85eaeee2fd6776e0240cdb45", "git_parents": ["04b8a73ea4db0b1fc93517c014c17e6b018554fb"], "node": "b7ad4a67f40c2ddd0a751106c9ee6e8d55e27550", "parents": ["0a7c2005d6ff3f7c9997b69a0128723d9732894b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Apply gfx.webrender.max-partial-present-rects to OS layer swapchains. r=gfx-reviewers,gw\n\nGetMaxPartialPresentRects() and the max-partial-present-rects pref now\ncover OS layer swapchains too, instead of the FFI layer assuming one rect\nfor them. ANGLE in layer mode and RenderCompositorLayerNative return the\npref value. The pref defaults to 1 on macOS, like the other platforms, so\nCoreAnimation layers keep using partial present. macOS has no window\ncompositor that reads the pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336672\n", "files": ["gfx/config/gfxConfigManager.cpp", "gfx/webrender_bindings/RenderCompositor.cpp", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a184bbca8bba7e2c89926f2b096dea9bb86a1d32", "git_parents": ["c1d43edd144898fc85eaeee2fd6776e0240cdb45"], "node": "779852f58c210ae935c70960b45446d01c95ccd3", "parents": ["b7ad4a67f40c2ddd0a751106c9ee6e8d55e27550"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084955 - Use the buffer age alone to find the back buffer's missing regions. r=jnicol\n\nA buffer age of 1 already means that the back buffer holds the previous\nframe, so the uses_buffer_age flag and ShouldUseBufferAge() added nothing.\nWebRender now always tracks dirty rects and redraws the damage implied by the\nbuffer age. Compositors that keep their back buffer return an age of 1 (ANGLE),\nand configurations that don't support partial presentation pass a buffer age of\n0 to force a full render.\nThe buffer age only applies to compositor configurations that render into a\nwindow. For native compositors, a buffer age of zero is passed but it is ignored\nsince each surface tracks its own invalid region independently.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336725\n", "files": ["gfx/webrender_bindings/RenderCompositor.cpp", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderCompositorANGLE.h", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/RenderCompositorEGL.h", "gfx/webrender_bindings/RenderCompositorOGL.cpp", "gfx/webrender_bindings/RenderCompositorOGL.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "8ebbc43ae4755dacab41e3eae0c6df53119f943c", "git_parents": ["a184bbca8bba7e2c89926f2b096dea9bb86a1d32"], "node": "77f0e80c07f93434fcd2a01fb3b183c271fc4fc3", "parents": ["779852f58c210ae935c70960b45446d01c95ccd3"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086965 - Remove the mobile app store badges from the onboarding mobile downloads tile r=omc-reviewers,firefox-build-system-reviewers,fluent-reviewers,desktop-theme-reviewers,hjones,flod,emcminn,sergesanspaille,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337877\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_mobile_downloads.js", "browser/components/asrouter/content-src/components/MobileDownloads.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/docs/about-welcome.md", "browser/components/asrouter/t