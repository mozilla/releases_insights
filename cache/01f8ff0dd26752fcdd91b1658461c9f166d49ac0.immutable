ss-overflow/line-clamp/line-clamp-form-textarea-002.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-textarea-003.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-form-textarea-004.tentative.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-button-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-button-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-button-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-button-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-fieldset-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-fieldset-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-fieldset-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-fieldset-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-input-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-input-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-input-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-input-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-output-005-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-select-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-select-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-select-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-select-004-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-textarea-001-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-textarea-002-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-textarea-003-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-form-textarea-004-ref.html"], "git_node": "72517d9d1e9adc4e87fb47978520282220ec42d5", "git_parents": ["22c1239592476f0914d0f41f4eaac734fc358aad"], "node": "c463540e0aa24de123ea6b9f676fd2c326371b28", "parents": ["f7ef57f98cb0ce7494c298462d8158fa7364482d"], "tags": []}, {"author": "Danielle Graham \u003cdgraham@mozilla.com\u003e", "branch": "default", "desc": "Bug 1953333 - Expose the all tabs menu sections as labelled groups. r=tabbrowser-reviewers,desktop-theme-reviewers,nsharpley,emilio\n\nThis also fixes an issue I ran into while testing with VoiceOver: if there were no tab groups when the browser first started, the \"Recent tab groups\" section was never picked up as a group in the accessibility tree, even after a tab group was added, so it was never announced. I believe this is due to the container being display:none at startup, so it never got processed as an accessible. We should be able to remove this line since an empty vbox has no size or focusable content, as long as the separator is still hidden when it's not needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337718\n", "files": ["browser/components/tabbrowser/GroupsList.sys.mjs", "browser/components/tabbrowser/content/browser-allTabsMenu.inc.xhtml", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "af4e0e8bbd54f80b65adc3dcd468afa3b12c8673", "git_parents": ["72517d9d1e9adc4e87fb47978520282220ec42d5"], "node": "03756c9277eea77896011b81e8d48371c49008f4", "parents": ["c463540e0aa24de123ea6b9f676fd2c326371b28"], "tags": []}, {"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077576 - Update CWTS dialog engine tooltips for per-device syncing r=settings-reviewers,fluent-reviewers,mstriemer,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330538\n", "files": ["browser/components/preferences/dialogs/syncChooseWhatToSync.xhtml", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "dca78af5ac244fb02a696b4d905f2d9e868544a6", "git_parents": ["af4e0e8bbd54f80b65adc3dcd468afa3b12c8673"], "node": "859a53cda28b33812ac1d4b054c3f5924236e898", "parents": ["03756c9277eea77896011b81e8d48371c49008f4"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082823 - Part 1. Only cancel the video skip when MediaFormatReader::ResetDecode resets video. r=media-playback-reviewers,azebrowski\n\nResetDecode has taken a track set since bug 1276570, but still disconnected\nthe skip-to-next-keyframe request for any reset. An audio-only reset, as\nseamless looping does when audio ends, left a video request whose skip was\nin flight with nothing to settle it, stalling video.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338139\n", "files": ["dom/media/MediaFormatReader.cpp", "dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "9047180de794b693eff7861c6e239ef9e0bf9f48", "git_parents": ["dca78af5ac244fb02a696b4d905f2d9e868544a6"], "node": "7f0e1b5e8ed6ddf29946fd3d6246363231cf8283", "parents": ["859a53cda28b33812ac1d4b054c3f5924236e898"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082823 - Part 2. Cancel the other track's demuxer seek when MediaFormatReader::ResetDecode abandons a seek. r=media-playback-reviewers,azebrowski\n\nResetDecode rejects the seek in progress for all tracks, but only\ndisconnected the demuxer seeks of the tracks it reset. When seamless looping\nor a video-only seek resets a single track, the other track's demuxer seek\ncould then complete against the next seek: it started a second audio seek,\nfailing MOZ_DIAGNOSTIC_ASSERT(!mAudio.mSeekRequest.Exists()) in DoAudioSeek,\nresolved the new seek before its track had been sought, or was still in\nflight when that track was next read, failing an assert in RequestVideoData.\n\nDisconnect the seek's demuxer seeks when rejecting it, including on tracks\nthat are not reset. Internal seeks are left to complete on those tracks,\nsince they serve the track's own data requests rather than belong to the\nabandoned seek.\n\nThe StaleSeekTest tests cover each of these failures. The\nFlushErrorAfterResetTest test checks that a recovery seek of a track the\nreset does not cover is left to complete; part 3 adds more tests to that\nfixture.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338140\n", "files": ["dom/media/MediaFormatReader.cpp", "dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "81fe31a1d7cacaaf7da901a066b6c03bacf4fe9b", "git_parents": ["9047180de794b693eff7861c6e239ef9e0bf9f48"], "node": "074d9ba0f37ad99530125dce8a0f5630d1e30fbb", "parents": ["7f0e1b5e8ed6ddf29946fd3d6246363231cf8283"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082823 - Part 3. Don't let error recovery seek a track that a pending or retried seek will position. r=media-playback-reviewers,azebrowski\n\nA non-fatal decoder error after ResetDecode, such as a flush failing when the\nremote decoder process crashes, made Update start an internal seek to the\nfirst frame time. That collided with the seek that the reset was made for:\nwith the video demuxer seek of an all-tracks seek in flight, DoAudioSeek\nfound an audio seek in progress, and when the seek had been rejected while\nwaiting for data, the retried Seek found an internal seek threshold. Bug\n2078225 exposed this for audio by resetting its first frame time correctly.\n\nLeave a track that the seek in progress covers to that seek, flushing it\ninstead, and have AccurateSeekingState reset the sought tracks again before\nit retries, as it does before its first attempt.\n\nA track that a single-track seek does not cover could be in an internal\nseek of its own when the seek fails, and is still left to recover that way,\nso OnSeekFailed's assert now permits that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338141\n", "files": ["dom/media/MediaDecoderStateMachine.cpp", "dom/media/MediaFormatReader.cpp", "dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "879e3a19688b687789049f42bfdf72c5eb13b7d1", "git_parents": ["81fe31a1d7cacaaf7da901a066b6c03bacf4fe9b"], "node": "428b7f65f9c70c5463bf41b279f32735f9780d00", "parents": ["074d9ba0f37ad99530125dce8a0f5630d1e30fbb"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085227 - Add general popover support to moz-button. r=reusable-components-reviewers,mkennedy\n\nRefactor `MenuController` into `PopoverController` and make `MenuController` a\nsubclass. Add a `popoverTarget` property to `moz-button`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336322\n", "files": ["toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/widgets/moz-button/moz-button.mjs"], "git_node": "e61ebf3bd6fcc8e94929769ee7ab37505d49e246", "git_parents": ["879e3a19688b687789049f42bfdf72c5eb13b7d1"], "node": "28cafa66dd82cb8418dacf2d0ea6351bc347c0c8", "parents": ["428b7f65f9c70c5463bf41b279f32735f9780d00"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2087653: Remove the ./mach bootstrap step r=mjf DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338459\n", "files": ["dom/media/webrtc/third_party_build/elm_rebase.sh"], "git_node": "f437713b628f6ac8a08ee65125c434d402354343", "git_parents": ["e61ebf3bd6fcc8e94929769ee7ab37505d49e246"], "node": "6e75c9ca18bd579c6058f9f1117c7f41ab5957e7", "parents": ["28cafa66dd82cb8418dacf2d0ea6351bc347c0c8"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082455 - remote pkcs#11 modules: find and cache remote certificates outside of NSS r=jschanck\n\nWhen we know we're going to call an NSS function that will result in a search\nfor certificates over IPC, do the search before the NSS call and cache the\nresults. This avoids holding any locks in NSS that could potentially result in\na deadlock if the main thread is also calling into NSS at the same time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336076\n", "files": ["browser/app/profile/firefox.js", "modules/libpref/init/StaticPrefList.yaml", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/nsNSSIOLayer.cpp", "security/manager/ssl/nsNSSIOLayer.h", "security/manager/ssl/tests/unit/test_pkcs11_remote_process.js"], "git_node": "e3e23f9f674f9375b917e60be858332ca1457be5", "git_parents": ["f437713b628f6ac8a08ee65125c434d402354343"], "node": "6247827d42dab533290d49ac6b9b2c64aaff58c1", "parents": ["6e75c9ca18bd579c6058f9f1117c7f41ab5957e7"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087632 - Complete ICE gathering when it fails to start, so end-of-candidates is still signaled. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338435\n", "files": ["dom/media/webrtc/transport/nricectx.cpp", "dom/media/webrtc/transport/nricemediastream.cpp", "dom/media/webrtc/transport/nricemediastream.h", "dom/media/webrtc/transport/test/ice_unittest.cpp", "dom/media/webrtc/transport/test_nr_socket.cpp"], "git_node": "cf9464544a23018e4d0c4772a48d3a47d4acea19", "git_parents": ["e3e23f9f674f9375b917e60be858332ca1457be5"], "node": "c2415fcee6aa4ac5207589b9f11383d1e5e7be9e", "parents": ["6247827d42dab533290d49ac6b9b2c64aaff58c1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2085878 - Report windows leaked in content processes in browser chrome tests, with their retention paths, r=mccr8.\n\nBug 2019756 reports windows leaked in the parent process as test failures with their retention path, and bug 2083302 uploads a profile for them; windows leaked in content processes only get \"leaked until shutdown\" from leaks.py.\n\nIn debug builds, the content ShutdownLeaksCollector now tracks the windows created during each test, using the current test that browser-test.js shares through sharedData. After its collections, it finds the retention path of those still alive and sends the resulting failures to the parent. Each content process with a collector registers with the parent when it starts; at shutdown the parent waits, for at most 120 seconds, until each of them has reported or exited, then reports each leaked window as a failure of the test that created it, and includes those tests in the leak profile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336930\n", "files": ["testing/mochitest/ShutdownLeaksCollector.sys.mjs", "testing/mochitest/browser-test.js"], "git_node": "24e201644a1faa1548595b27c58f026d2eda4fcd", "git_parents": ["cf9464544a23018e4d0c4772a48d3a47d4acea19"], "node": "fec85017be9cbc6d310ce914e45923d94382bebf", "parents": ["c2415fcee6aa4ac5207589b9f11383d1e5e7be9e"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Use external imports when validating wasm ESM imports; r=rhunt\n\nThis adds a new GetExternalImports operation and uses it when validating\nthe imports of a wasm module compiled for use as an EcmaScript module.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334944\n", "files": ["js/src/wasm/WasmJS.cpp"], "git_node": "dd694d7acc1828ed86d4961d72234db3ffa49d28", "git_parents": ["24e201644a1faa1548595b27c58f026d2eda4fcd"], "node": "aeb3c1a86462d2376a80bd46f9282431279204ac", "parents": ["fec85017be9cbc6d310ce914e45923d94382bebf"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Don't fetch dependencies for source-phase imports; r=arai,dom-worker-reviewers,edenchuang\n\nThis also removes the unnecessary JSContext parameter for\nIsSourcePhaseRequest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334945\n", "files": ["dom/script/ModuleLoader.cpp", "dom/script/ScriptLoader.cpp", "dom/workers/loader/WorkerModuleLoader.cpp", "dom/worklet/loader/WorkletModuleLoader.cpp", "js/loader/ModuleLoadRequest.cpp", "js/loader/ModuleLoadRequest.h", "js/loader/ModuleLoaderBase.cpp", "js/public/Modules.h", "js/src/vm/Modules.cpp"], "git_node": "858ab3eb2c23b854f371a355456c7c80f4a8259c", "git_parents": ["dd694d7acc1828ed86d4961d72234db3ffa49d28"], "node": "06895c054fc538aab90fab6bde70b0808355bd55", "parents": ["aeb3c1a86462d2376a80bd46f9282431279204ac"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Add wasm::GetModuleImports; r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334951\n", "files": ["js/src/wasm/WasmJS.cpp", "js/src/wasm/WasmJS.h"], "git_node": "7f08ff8b6e1a076cfa544bcc738704463b6defcb", "git_parents": ["858ab3eb2c23b854f371a355456c7c80f4a8259c"], "node": "b283d199b4954018d202fe44f1f2bd00f69ed434", "parents": ["06895c054fc538aab90fab6bde70b0808355bd55"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Store requested modules on wasm module records; r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334946\n", "files": ["js/src/builtin/ModuleObject.h", "js/src/vm/Modules.cpp"], "git_node": "0948e64f91486b562f0fb5bdb143e85ace2d093c", "git_parents": ["7f08ff8b6e1a076cfa544bcc738704463b6defcb"], "node": "298ecf8c6de9aec770ef58221bd1c621c8e54f7e", "parents": ["b283d199b4954018d202fe44f1f2bd00f69ed434"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Add wasm::GetModuleExportNames; r=rhunt\n\nThis will be used in the following commit to store requested\nmodules in the module record.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334947\n", "files": ["js/src/wasm/WasmJS.cpp", "js/src/wasm/WasmJS.h"], "git_node": "764f05af26b5bd3083eb9d213f6f855963f5215d", "git_parents": ["0948e64f91486b562f0fb5bdb143e85ace2d093c"], "node": "2db35a356633319608bb53e85eb8a9b7422e7c3a", "parents": ["298ecf8c6de9aec770ef58221bd1c621c8e54f7e"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Use export names when creating wasm module environment; r=arai\n\nThis changes the wasm module environment creation to use the export names\nfrom the wasm module, and adds a new\njs::CreateEnvironmentShapeForWasmModule function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334948\n", "files": ["js/src/builtin/ModuleObject.cpp", "js/src/builtin/ModuleObject.h", "js/src/vm/EnvironmentObject.cpp", "js/src/vm/EnvironmentObject.h", "js/src/vm/Modules.cpp", "js/src/vm/Scope.cpp", "js/src/vm/Scope.h"], "git_node": "603586052cd53ccfad4755dce2fc828f0b162820", "git_parents": ["764f05af26b5bd3083eb9d213f6f855963f5215d"], "node": "1d254b2793c80643ccef13b327adb4cddbd55f18", "parents": ["2db35a356633319608bb53e85eb8a9b7422e7c3a"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Replace isSourcePhaseModule with isWasmModule in ModuleObject; r=arai\n\nIt's likely that source phase will also be defined for JavaScript modules\nin the future. Checking for WebAssembly here explicitly is better.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334949\n", "files": ["js/src/builtin/ModuleObject.cpp", "js/src/builtin/ModuleObject.h", "js/src/vm/Modules.cpp"], "git_node": "8cb19a8f9adf940ca1c78102d4034b1775612b0d", "git_parents": ["603586052cd53ccfad4755dce2fc828f0b162820"], "node": "6ca04eeca0e04f9362bacdeec110e56d61f66dd5", "parents": ["1d254b2793c80643ccef13b327adb4cddbd55f18"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Support wasm modules in ModuleGetExportedNames; r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334950\n", "files": ["js/src/vm/Modules.cpp"], "git_node": "eb3219a7338a436293dbe6735716a2b054f8ab68", "git_parents": ["8cb19a8f9adf940ca1c78102d4034b1775612b0d"], "node": "8dd30a3defdbb9bd0345dc612b285c62ed80378a", "parents": ["6ca04eeca0e04f9362bacdeec110e56d61f66dd5"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Add WasmModuleResolveExport to Modules.cpp; r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334952\n", "files": ["js/src/vm/Modules.cpp"], "git_node": "5ccc39c362277ef8474bb08ae669766366d7e0ca", "git_parents": ["eb3219a7338a436293dbe6735716a2b054f8ab68"], "node": "87331ea021c333a2847eaa8e026dfb11a6528e84", "parents": ["8dd30a3defdbb9bd0345dc612b285c62ed80378a"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030454 - Add WasmModuleInitializeEnvironment; r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334953\n", "files": ["