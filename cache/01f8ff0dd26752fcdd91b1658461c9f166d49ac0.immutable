/protocol/unknown-media-types-negotiation.html"], "git_node": "429abd467b9f0d1f12fc6e5cffff7a5732bfba66", "git_parents": ["dd549f61e6df458b51775a195ac3781104d9bda8"], "node": "45a981fa45dee214050d7fd88345305d33128421", "parents": ["59684bf6a5a4fcf4d9723a0f48226db6c932e327"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072767 - compare unknown types deeply;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334309\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepTransceiver.h", "testing/web-platform/tests/webrtc/protocol/unknown-media-types-negotiation.html"], "git_node": "ed266111838497b06dc7ec383709d0425bde0425", "git_parents": ["429abd467b9f0d1f12fc6e5cffff7a5732bfba66"], "node": "b131640b099633057cb23c6f65ef83ce536c0a39", "parents": ["45a981fa45dee214050d7fd88345305d33128421"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072767 - add reconnection test;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337730\n", "files": ["testing/web-platform/tests/webrtc/protocol/unknown-media-types-negotiation.html"], "git_node": "9e2b9c888693185dfdd9600d5c6baac2dc6f9b4d", "git_parents": ["ed266111838497b06dc7ec383709d0425bde0425"], "node": "d7f7d4c00a1af211ba16104706964fac4adafe7d", "parents": ["b131640b099633057cb23c6f65ef83ce536c0a39"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1617035 - use webrtc-sdp in nightly;r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321333\n", "files": ["modules/libpref/init/all.js"], "git_node": "fe3b47e57c8bc1bf8b941b26fd0e79d65cec1be8", "git_parents": ["9e2b9c888693185dfdd9600d5c6baac2dc6f9b4d"], "node": "f332288a8f4d34c8cd9f2044e1b7afa29de93c23", "parents": ["d7f7d4c00a1af211ba16104706964fac4adafe7d"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1617035 - make webrtc-sdp exclusive in nightly;r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321336\n", "files": ["modules/libpref/init/all.js"], "git_node": "c4d7028b36ff1f25a18966d2ba8be01eb376e536", "git_parents": ["fe3b47e57c8bc1bf8b941b26fd0e79d65cec1be8"], "node": "c332a7520b2cd1e11b95829e2e4e8547b7a3e541", "parents": ["f332288a8f4d34c8cd9f2044e1b7afa29de93c23"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086627: Wait for fullscreen and warning animations in the domain test. r=firefox-desktop-core-reviewers ,Gijs\n\nThe warning can appear without an entrance transition, leaving the test waiting for `FullscreenWarningOnScreen`. Wait for completed fullscreen transitions and any warning animations instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338169\n", "files": ["browser/base/content/test/browser-fullscreen/browser_fullscreen_toplevel_warning.js"], "git_node": "59d5e16fa5aa642d2e8aa0d0409004a309aafe84", "git_parents": ["c4d7028b36ff1f25a18966d2ba8be01eb376e536"], "node": "1beee1a770f313fb266c23d4ea73b085d7de9aad", "parents": ["c332a7520b2cd1e11b95829e2e4e8547b7a3e541"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2084359 - Make `BrowserParent::RecvReplyKeyEvent` stop dispatching event if it's destroyed by an access key handling r=edgar\n\nHandling an access key may occur anything, i.e., the browser may be\nclosed. In that case, the event should be treated as consumed and the\nevent shouldn't be dispatched due to no target.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337817\n", "files": ["dom/ipc/BrowserParent.cpp"], "git_node": "04cc3390c3625945ec7338b32bf24206dc797097", "git_parents": ["59d5e16fa5aa642d2e8aa0d0409004a309aafe84"], "node": "5f1fe9d31836b024102572f41600e4fdbb1bb00e", "parents": ["1beee1a770f313fb266c23d4ea73b085d7de9aad"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2082075 - Make `SelectionMovementUtils::PeekOffsetForCaretMove` adjust the result of `GetPrimaryFrameForCaret` outside generated content r=layout-reviewers,emilio\n\n`SelectionMovementUtils::GetPrimaryFrameForCaret` may dive into\ngenerate content nodes because its callers may require generated text\naround the selection to show caret or some other UI. However,\n`SelectionMovementUtils::PeekOffsetForCaretMove` shouldn't return\ngenerated content nodes because the result may be used for new selection\nrange boundary. Therefore, after calling `GetPrimaryFrameForCaret`, it\nneeds to ensure the point is outside any generated content and peeks\noffset from there.\n\nNote that the new code does not handle the position in\n`TreeKind::FlatForSelection` intentionally because\n`nsFrameSelection::MoveCaret` which is the primary caller of\n`SelectionMovementUtils::PeekOffsetForCaretMove` handles `TreeKind::DOM`\ntree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336965\n", "files": ["layout/generic/SelectionMovementUtils.cpp", "layout/generic/SelectionMovementUtils.h", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h"], "git_node": "1ec0dd902d911727039ecb88b2afc1cc618036b1", "git_parents": ["04cc3390c3625945ec7338b32bf24206dc797097"], "node": "e5c87fb04ebdac5407300d30b3bee0c6d28aab0c", "parents": ["5f1fe9d31836b024102572f41600e4fdbb1bb00e"], "tags": []}, {"author": "Ed Lee \u003celee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082228 - Extend expiry of genai.linkpreview.* metrics to 180 r=gcardieri\n\nExtend the expiry of the 13 genai.linkpreview metrics listed in the expiry alert from 162 to 180. genai.linkpreview.smoke_test (expires 170) is not part of the alert and is left unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336053\n", "files": ["browser/components/genai/metrics.yaml"], "git_node": "0ab73686c7a2dd23fadcd5f907131b66277a2fb3", "git_parents": ["1ec0dd902d911727039ecb88b2afc1cc618036b1"], "node": "5949f939df361bf080ca14417ce916e9e60fe813", "parents": ["e5c87fb04ebdac5407300d30b3bee0c6d28aab0c"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2084276 - Fetch per-architecture crashreporter symbols for macOS tests of universal builds. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335702\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py"], "git_node": "ad04bdb66f88b02a849f2132964e8645e6805a54", "git_parents": ["0ab73686c7a2dd23fadcd5f907131b66277a2fb3"], "node": "8cd99e38018b5cce9f35165cafe9203a672cd110", "parents": ["5949f939df361bf080ca14417ce916e9e60fe813"], "tags": []}], "date": 1793336355, "git_changesets": ["673144f7a5d7c0f157915424ee6e9647df0fdcd1", "334f7cfa82b31bebb3727135e0faded27e1ae5d5", "971830b72b3f666f53c9d9d67443b4ebc8fa0da4", "6b6bbcdef9007d0d4166ce08bf6723b0476aa905", "deba32c0ee3e3cd2954e2e13aefbc8e709babf58", "9756c6a371b04abf76afae446536b3aa8e04f111", "f4d2d4cb760982eed5128566a77c4200250780d3", "9d1fae9b60437277ea1419ebe24b0cafda8a437c", "5f0734705807cc990673aa9253c607012fb99191", "bd6a8bbceb23def7a44dfe275f604524d6b2b96a", "8b6401fe42dcf6e1290d0cecbb1a2c147df114f7", "3ccafb6fd432fcbd1453e6f6a349ed13531facd2", "ed82f11f55225390a496288931f326809babf5f0", "5783fecc3bff2de7dff3a51e76f1d5803a92f277", "249ace21720d628838dc02c93d06a3b1f87debdc", "7a0a9f76ef295cbc84464bedc77330f019b99c95", "8cfb486aeaff8fda57baee1e496b05d395ca675a", "e042ab3d1e07f4126196c0328dbcc9d82b328758", "75c09106949e7ef7a3e9aa17d934f86e345e2390", "ec6bd913043e52c05ad065250bcc82173c3edb34", "f52b67e07a134313dbcf29cfc1ac7b4e274712e1", "3bb62c321017415a64584243392736765512bcec", "bb080ae3ebb7185e05a4d3777228cd2bd6beb8b1", "cb58cb11d639cf84a5cb75f0d14d9511eb2e25cf", "2fb