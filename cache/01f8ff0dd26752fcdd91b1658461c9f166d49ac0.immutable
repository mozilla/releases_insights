/bug_2044354_container_nova_colors.py", "python/l10n/fluent_migrations/bug_2044507_firefox_logo_setting.py", "python/l10n/fluent_migrations/bug_2047983_settings_pane_header_message_refs.py", "python/l10n/fluent_migrations/bug_2048020_containers_new_tab_check.py", "python/l10n/fluent_migrations/bug_2048035_ip_protection_get_started_title.py", "python/l10n/fluent_migrations/bug_2048544_sidebar_title.py", "python/l10n/fluent_migrations/bug_2049709_edit_profile_nova.py", "python/l10n/fluent_migrations/bug_2051333_newtab_personalized_stories_checkbox.py", "python/l10n/fluent_migrations/bug_2051641_remove_onboarding_checklist.py", "python/l10n/fluent_migrations/bug_2054136_ip_protection_summer_promo_offramp_buttons.py", "python/l10n/fluent_migrations/bug_2054175_topsites_use_custom_image.py"], "git_node": "89250193369659802caba29b8c234c97243c1f57", "git_parents": ["0777d5419057374944d5a441ad56b88774f3b06d"], "node": "ebf6979750017b1cf53f43ab054feeb56040f430", "parents": ["a42d1984198d66ef04c5cc2df3ca13ecec5d367b"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085871 - Treat positive return values from AHardwareBuffer_lock() as failure. r=gfx-reviewers,geckoview-reviewers,aosmond,m_kato\n\nPreviously we treated a negative return value as failure, and zero or\npositive as success. If AHardwareBuffer_lock() returns a positive value\nin the failure case, then this would result in attempting to copy from\nthe uninitialised pointer srcBuf, potentially explaining the crashes.\n\nInstead, treat any non-zero return value as failure.\n\nTo make future crash reports more obvious, additionally initialise\nsrcBuf to nullptr, and assert that it is non-null in the success\ncase. This should never assert, but if it does this will indicate that\nthe address can be incorrectly returned in the \"success\" case, and we\nwill need to handle that too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337113\n", "files": ["gfx/webrender_bindings/RenderCompositorOGLSWGL.cpp", "widget/android/nsWindow.cpp"], "git_node": "b3b9b117bb8dfbfe149c20f1e673d541270fd601", "git_parents": ["89250193369659802caba29b8c234c97243c1f57"], "node": "8842fb8980014d1aec13595ec5d2dd516d1a77a1", "parents": ["ebf6979750017b1cf53f43ab054feeb56040f430"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085871 - Avoid closing file descriptor after calling AHardwareBuffer_lock(). r=gfx-reviewers,aosmond\n\nThough not documented either way in the NDK docs, Android source code\ninspection shows that AHardwareBuffer_lock() assumes ownership of the\npassed fence file descriptor. Passing UniqueFileHandle::get() meant\nthat the UniqueFileHandle destructor would close the file descriptor\nafter calling AHardwareBuffer_lock(), which could in theory close a\nfile descriptor opened in the meantime by another thread.\n\nUse UniqueFileHandle::release() instead, ensuring that the destructor\ndoes not subsequently close the descriptor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337114\n", "files": ["gfx/layers/AndroidHardwareBuffer.cpp"], "git_node": "1fdc3b5c09e2b01a8bc735af10014f1f0d664647", "git_parents": ["b3b9b117bb8dfbfe149c20f1e673d541270fd601"], "node": "4ec97550a38f99879ac2c792bd5047b8a4c1611e", "parents": ["8842fb8980014d1aec13595ec5d2dd516d1a77a1"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2060742 - Package ANGLE libraries on Android r=glandium\n\nIt adds the ANGLE libraries to the Android package manifes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316523\n", "files": ["mobile/android/installer/package-manifest.in"], "git_node": "e6f432c17d990b994dff3f92572b827c1245c42b", "git_parents": ["1fdc3b5c09e2b01a8bc735af10014f1f0d664647"], "node": "c76689ccae8dc067b1b8e3217aa936a1f92ac9ab", "parents": ["4ec97550a38f99879ac2c792bd5047b8a4c1611e"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085748 - Record the file and line a category consumer's error was created at in browser_utils.category_dispatch_error. r=Gijs\n\nThe error often comes from code the consumer calls into rather than its\nregistered module. Add fileName and lineNumber extras from the thrown value.\nfileName is recorded only as a single moz-src://, resource:// or chrome://\nURI with no whitespace, which rules out local paths, moz-extension:// URIs\nand chained script names; anything else is \"other\" with no line. module now\nuses the same check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336661\n", "files": ["browser/docs/CategoryManagerIndirection.md", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/gecko_metrics.yaml", "toolkit/modules/tests/xpcshell/test_BrowserUtils_callModulesFromCategory.js"], "git_node": "cb8f2d2a164b6ae78883540c9a6a15e12b01ebc8", "git_parents": ["e6f432c17d990b994dff3f92572b827c1245c42b"], "node": "28115aad91d65efdfc374dad8257be4827ce8f28", "parents": ["c76689ccae8dc067b1b8e3217aa936a1f92ac9ab"], "tags": []}, {"author": "Bryan Olsson \u003cbolsson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086301 - Add accesskey generation examples to the Fluent migration docs. r=flod DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337334\n", "files": ["intl/l10n/docs/migrations/fluent.md", "intl/l10n/docs/migrations/legacy.md"], "git_node": "32c873bd32aa68fe5fefb349fa0eabdb2cf0877c", "git_parents": ["cb8f2d2a164b6ae78883540c9a6a15e12b01ebc8"], "node": "26d82f4f42afbda427f85c62d33cccb0f23f9da5", "parents": ["28115aad91d65efdfc374dad8257be4827ce8f28"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084863: Preserve visibility until the native fullscreen overlay clears. r=mac-reviewers,bradwerth\n\nAppKit can report fullscreen completion before the window becomes visible again. Keep the transition visibility override until visibility returns or the window loses focus, so popup requests are not discarded in that interval.\n\nThe fullscreen notification test checks that content is active without requiring a temporary visibility change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336097\n", "files": ["browser/components/customizableui/test/browser_panelUINotifications_fullscreen_noAutoHideToolbar.js", "widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "e77423cadcf852718b76cfc4951e26addad0af5c", "git_parents": ["32c873bd32aa68fe5fefb349fa0eabdb2cf0877c"], "node": "baa12dc71bbe3818bac4beaca5ad0df7d17f4e44", "parents": ["26d82f4f42afbda427f85c62d33cccb0f23f9da5"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085689 - Use canUnwrapAs\u003cSavedFrame\u003e for the stack check in CopyErrorObject. r=spidermonkey-reviewers,jonco\n\n`CopyErrorObject` now checks what we assert in `ErrorObject::create`. This just\nfixes a JS shell release assertion failure involving the debugger. I recently\nadded the `\"securityWrappers\"` option to `newGlobal` and it makes it possible\nto trigger this in the shell.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337033\n", "files": ["js/src/jit-test/tests/debug/error-copied-security-wrapper-stack.js", "js/src/vm/ErrorObject.cpp"], "git_node": "ac18217d27a211c71adf2295c08956b50b269817", "git_parents": ["e77423cadcf852718b76cfc4951e26addad0af5c"], "node": "f9dfcb58b7d7ed7870bfd79c4fced4e537fdc095", "parents": ["baa12dc71bbe3818bac4beaca5ad0df7d17f4e44"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085886 - Part 1: Add lazily allocated TestingFunctionData to JSContext. r=spidermonkey-reviewers,jonco\n\nWhen a testing function needs to store some per-context data, we've used either\nthread-locals or `JSContext`/`JSRuntime` fields to store this. This patch adds a\n`TestingFunctionData` struct to make it easier to do this.\n\nThis patch moves the `makeSerializable` activity log there. The next patch will add\nanother use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337020\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/builtin/TestingFunctions.h", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h", "js/src/vm/Runtime.cpp", "js/src/vm/Runtime.h"], "git_node": "da95fc4675571fda8dcd8701aa561c594d918e9a", "git_parents": ["ac18217d27a211c71adf2295c08956b50b269817"], "node": "b2e39f511762f5e43a5b15146b22062510344f3e", "parents": ["f9dfcb58b7d7ed7870bfd79c4fced4e537fdc095"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085886 - Part 2: Add shell functions for JS::EnableRecordingAllocations. r=spidermonkey-reviewers,jonco\n\nThe runtime-wide allocation recording API used by the Gecko profiler had no\nJS shell coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337021\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/builtin/TestingFunctions.h", "js/src/fuzz-tests/util/sanitize.js", "js/src/jit-test/tests/profiler/record-allocations-new-global.js", "js/src/jit-test/tests/profiler/record-allocations.js", "js/src/vm/JSContext.h"], "git_node": "059e890a790a6d1ec51bccdbb07c11273ed17870", "git_parents": ["da95fc4675571fda8dcd8701aa561c594d918e9a"], "node": "a376635753d36e9eefc0ce31cd54141d3937050b", "parents": ["b2e39f511762f5e43a5b15146b22062510344f3e"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085886 - Part 3: Remove ShellAllocationMetadataBuilder. r=spidermonkey-reviewers,jonco\n\nThe shell builder ran much more code at allocation time (creating objects and\narrays, defining properties) than the SavedStacks builder we actually use in\nFirefox.\n\nThe SavedStacks builder is also available in the JS shell so there's no reason\nto keep both. A later patch will remove the builder interface from the JSAPI.\n\nThis patch removes `enableShellAllocationMetadataBuilder` and changes jit-tests\nto call `enableTrackAllocations` instead. Tests that checked the shell builder's\nmetadata now check the `SavedFrame` instead.\n\nInstalling a different builder was the only way to make Debugger allocation\ntracking fail, so the tests for that are removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337022\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/fuzz-tests/util/sanitize.js", "js/src/jit-test/tests/baseline/metadata-hook-on-stack.js", "js/src/jit-test/tests/basic/bug1833517.js", "js/src/jit-test/tests/basic/bug1892300.js", "js/src/jit-test/tests/basic/bug951213.js", "js/src/jit-test/tests/basic/bug951346.js", "js/src/jit-test/tests/basic/bug951632.js", "js/src/jit-test/tests/basic/metadata-hook-regexp-result.js", "js/src/jit-test/tests/basic/metadata-hook.js", "js/src/jit-test/tests/debug/Memory-trackingAllocationSites-03.js", "js/src/jit-test/tests/debug/bug-2012589.js", "js/src/jit-test/tests/debug/bug1221378.js", "js/src/jit-test/tests/errors/overrecursed-double-fault-1.js", "js/src/jit-test/tests/gc/allocation-metadata-builder-over-recursion.js", "js/src/jit-test/tests/gc/bug-1148383.js", "js/src/jit-test/tests/gc/bug-1215678.js", "js/src/jit-test/tests/gc/bug-1338383.js", "js/src/jit-test/tests/gc/bug-1399889.js", "js/src/jit-test/tests/gc/bug-1597970.js", "js/src/jit-test/tests/gc/bug-1608355.js", "js/src/jit-test/tests/gc/bug-1648901.js", "js/src/jit-test/tests/gc/bug-1651001-1.js", "js/src/jit-test/tests/gc/bug-1651001-2.js", "js/src/jit-test/tests/gc/bug-1691901.js", "js/src/jit-test/tests/gc/bug-1739972.js", "js/src/jit-test/tests/gc/bug-1802308.js", "js/src/jit-test/tests/gc/bug-1804629-2.js", "js/src/jit-test/tests/gc/bug-1851619.js", "js/src/jit-test/tests/gc/bug-1941876.js", "js/src/jit-test/tests/gc/bug-886560.js", "js/src/jit-test/tests/gc/bug-935022.js", "js/src/jit-test/tests/gc/bug-945280.js", "js/src/jit-test/tests/gc/bug-945285.js", "js/src/jit-test/tests/gc/bug-961741.js", "js/src/jit-test/tests/gc/bug1511412.js", "js/src/jit-test/tests/gc/bug1704451.js", "js/src/jit-test/tests/gc/bug2077384.js", "js/src/jit-test/tests/gc/finalizationRegistry-records-not-initialized.js", "js/src/jit-test/tests/gc/regress-1711413.js", "js/src/jit-test/tests/gc/weakmark-remap.js", "js/src/jit-test/tests/gc/weakmark-remap2.js", "js/src/jit-test/tests/ion/bug1054241.js", "js/src/jit-test/tests/ion/bug1057598.js", "js/src/jit-test/tests/ion/recover-lambdas-bug1113940.js", "js/src/jit-test/tests/modules/bug-1795845.js", "js/src/jit-test/tests/modules/bug-1978873.js", "js/src/jit-test/tests/typedarray/subarray-ensure-buffer-metadata.js", "js/src/jit-test/tests/wasm/bug1962631.js", "js/src/jit-test/tests/wasm/gc/allocation-metadata.js", "js/src/jit-test/tests/wasm/ref-types/fuzz-gc-while-allocating-global.js"], "git_node": "548366028aaed1e9631954e8a2e20dee38d5e862", "git_parents": ["059e890a790a6d1ec51bccdbb07c11273ed17870"], "node": "af11e790d4dd0ffb5807a6e1de5af3fb027f88c1", "parents": ["a376635753d36e9eefc0ce31cd54141d3937050b"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085886 - Part 4: Record allocation metadata in Wasm instances created while tracking allocations. r=spidermonkey-reviewers,rhunt\n\nThis is a drive-by fix for a minor pre-existing issue.\n\n`Realm::setAllocationMetadataBuilder` updates existing wasm instances, but new\ninstances always started without a builder, so their inline struct and array\nallocations didn't get metadata.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337023\n", "files": ["js/src/jit-test/tests/wasm/gc/allocation-metadata-new-instance.js", "js/src/wasm/WasmInstance.cpp"], "git_node": "2400ec8d86a7ad08726c0e857b8f909d11768028", "git_parents": ["548366028aaed1e9631954e8a2e20dee38d5e862"], "node": "eeabebba5fc698fc3db46f4a0c4bc8a29515e917", "parents": ["af11e790d4dd0ffb5807a6e1de5af3fb027f88c1"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085886 - Part 5: Remove the AllocationMetadataBuilder API. r=spidermonkey-reviewers,jonco\n\n`SavedStacks` is now the only allocation metadata builder, so we can replace the\nbuilder pointer in `Realm` and `wasm::Instance` with a `uint32_t` flag and call\n`SavedStacks::buildAllocationMetadata` directly.\n\n`js::SetAllocationMetadataBuilder` had no users outside SpiderMonkey, and\n`js::GetAllocationMetadata` is now an internal function.\n\nDebugger allocation tracking can no longer fail because of a different builder,\nso remove that check and `JSMSG_OBJECT_METADATA_CALLBACK_ALREADY_SET`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337024\n", "files": ["js/public/friend/ErrorNumbers.msg", "js/src/builtin/TestingFunctions.cpp", "js/src/debugger/Debugger.cpp", "js/src/debugger/Debugger.h", "js/src/debugger/DebuggerMemory.cpp", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIROps.yaml", "js/src/jit/MacroAssembler.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/jsapi-tests/testSavedStacks.cpp", "js/src/jsfriendapi.cpp", "js/src/jsfriendapi.h", "js/src/vm/PortableBaselineInterpret.cpp", "js/src/vm/Realm.cpp", "js/src/vm/Realm.h", "js/src/vm/Runtime.cpp", "js/src/vm/SavedStacks.cpp", "js/src/vm/SavedStacks.h", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmInstance.h"], "git_node": "19f29f5e4c924d7b1bcc8309c0dc96bb6f2b74cb", "git_parents": ["2400ec8d86a7ad08726c0e857b8f909d11768028"], "node": "b6610e7d558eda7ef8107675a2603662368edd85", "parents": ["eeabebba5fc698fc3db46f4a0c4bc8a29515e917"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085886 - Part 6: Store SavedFrames in the allocation metadata table. r=spidermonkey-reviewers,jonco\n\nBecause `SavedStacks` is now the only allocation metadata builder, the metadata\nis always a `SavedFrame`. Store `SavedFrame*` in the table and return `SavedFrame*`\nfrom `js::GetAllocationMetadata`, which simplifies `Debugger::getObjectAllocationSite`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337025\n", "files": ["js/src/debugger/Object.cpp", "js/src/vm/Realm.cpp", "js/src/vm/Realm.h", "js/src/vm/SavedStacks.cpp", "js/src/vm/SavedStacks.h"], "git_node": "deaafbe4ca6d34ad6c50261fc8bc722b6d8c8b75", "git_parents": ["19f29f5e4c924d7b1bcc8309c0dc96bb6f2b74cb"], "node": "ae4cc6ab705cd6b14a01b08570f0b9ab9d202c9e", "parents": ["b6610e7d558eda7ef8107675a2603662368edd85"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086469 - Re-enable BOLT for taskcluster-built clang binaries r=glandium\n\nDisable use-gnu-stack which made the library not dlopen-able.\n\nThe same patch has been applied by https://github.com/astral-sh/python-build-standalone\nand they now just pass fine-grain options to BOLT, while still not using\nthat flag. Given their audience, it's probably a good sign that it's now\ncompatible with dlopen.\n\nConcerning performance, I've run the following micro-benchmark:\n\n    $ hyperfine -r30 --parameter-list clang $PWD/bin/clang,/home/ssp/.mozbuild/clang/bin/clang '{clang} -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w'\n    Benchmark 1: /tmp/clang/bin/clang -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w\n      Time (mean \u00b1 \u03c3):     11.371 s \u00b1  0.066 s    [User: 11.238 s, System: 0.063 s]\n      Range (min \u2026 max):   11.115 s \u2026 11.425 s    30 runs\n\n    Benchmark 2: /home/ssp/.mozbuild/clang/bin/clang -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w\n      Time (mean \u00b1 \u03c3):     12.192 s \u00b1  0.082 s    [User: 12.049 s, System: 0.067 s]\n      Range (min \u2026 max):   11.925 s \u2026 12.283 s    30 runs\n\n    Summary\n      /tmp/clang/bin/clang -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w ran\n        1.07 \u00b1 0.01 times faster than /home/ssp/.mozbuild/clang/bin/clang -O3 ~/sources/sqlite-bench/sqlite3.c -c -o /dev/null -w\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337101\n", "files": ["build/build-clang/bolt-no-use-gnu-stack.patch", "build/build-clang/clang-22.json", "build/build-clang/clang-23.json", "build/build-clang/clang-trunk.json", "taskcluster/kinds/toolchain/clang.yml"], "git_node": "cd699a9c80c9d4d51466076f92e86c5e65bf06b0", "git_parents": ["deaafbe4ca6d34ad6c50261fc8bc722b6d8c8b75"], "node": "a7767e66860dd253a712f7b6e7b7559dec54b494", "parents": ["ae4cc6ab705cd6b14a01b08570f0b9ab9d202c9e"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082390 - Modify all MenuItemProviders to support CustomizeMenu. r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337034\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItemsGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarkMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarksScreenMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BackMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/DesktopSiteMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/ForwardMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/RefreshMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/ShareMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/OpenInAppMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/OpenInFirefoxMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/menu/MoveToNormalTabsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/readermode/ReaderViewMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/collections/SaveToCollectionMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/FindInPageMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/accounts/MozillaAccountMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/FenixCustomizeMenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuConfigurations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvidersFactory.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuTarget.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/customize/FenixCustomizeMenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/DownloadsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/CustomizeHomepageMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ShortcutMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/VpnMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/SaveAsPdfMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/print/PrintMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/deletebrowsingdata/QuitMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/logins/PasswordsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/shortcut/AddToHomeScreenMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizePageMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ReportBrokenSiteMenuItemProvider.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bookmarks/BookmarksScreenMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/BackMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/DesktopSiteMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/ForwardMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/RefreshMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/ShareMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/applinks/OpenInFirefoxMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/collections/SaveToCollectionMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/FindInPageMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/accounts/MozillaAccountMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuConfigurationsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/downloads/DownloadsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/CustomizeHomepageMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/VpnMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/history/HistoryMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/SettingsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/deletebrowsingdata/QuitMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/logins/PasswordsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/shortcut/AddToHomeScreenMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/summarization/SummarizePageMenuItemProviderTest.kt"], "git_node": "a617ba769c5e2d480db896551ebfb3ed55b4ca81", "git_parents": ["cd699a9c80c9d4d51466076f92e86c5e65bf06b0"], "node": "a5c3a7eab2cb9eb02fe26c27faa13f60d3b9a468", "parents": ["a7767e66860dd253a712f7b6e7b7559dec54b494"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086222 - Add a sm-perf try preset. r=spidermonkey-reviewers,iain\n\nThis runs Speedometer 3, Speedometer experimental, and JetStream 3 on the three\ndesktop platforms with `--rebuild 10`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337258\n", "files": ["tools/tryselect/try_presets.yml"], "git_node": "0d27127bfb2a75441018ed64a138e5eb15c42b54", "git_parents": ["a617ba769c5e2d480db896551ebfb3ed55b4ca81"], "node": "cf10c765802e0bfafbd2a9c64e6ee703d7c92439", "parents": ["a5c3a7eab2cb9eb02fe26c27faa13f60d3b9a468"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2082905 - Remove browser.nova.enabled=false coverage from browser-performance tests. r=firefox-desktop-core-reviewers ,Gijs\n\nbrowser.nova.enabled is about to be locked to true.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335613\n", "files": ["browser/base/content/test/browser-performance/browser_startup_flicker.js", "browser/base/content/test/browser-performance/browser_tabclose.js", "browser/base/content/test/browser-performance/browser_tabopen.js", "browser/base/content/test/browser-performance/head.js"], "git_node": "1f6bcc135217e77de176164cc11718e124943540", "git_parents": ["0d27127bfb2a75441018ed64a138e5eb15c42b54"], "node": "ce1a99005ea0f3ecbf9ad3e1d40417aff99cf82e", "parents": ["cf10c765802e0bfafbd2a9c64e6ee703d7c92439"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Let resource monitors forward their data to a monitor in a parent process. r=releng-reviewers,ahal\n\nWhen MOZ_RESOURCE_MONITOR_FORWARD is set, monitors don't collect resource\nusage themselves, and append their events, markers and phases to the file\nit points to instead, for a monitor in a parent process to merge into its\nown profile. They can also ask that monitor to report Perfherder data for\nthe time they ran.\n\nArtifacts a child finds in its upload directory are only recorded by the\nparent if its own scan of its upload directory doesn't find the same file,\nand sccache.log is only parsed once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330470\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "b4fb01c2acbc38b7617a8ceadebccaa65b372c88", "git_parents": ["1f6bcc135217e77de176164cc11718e124943540"], "node": "21e8c4347c126c6d29ff22f0648c631c440cd1ab", "parents": ["ce1a99005ea0f3ecbf9ad3e1d40417aff99cf82e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Don't write separate resource usage profiles when forwarding to a parent monitor. r=releng-reviewers,ahal\n\nmach commands and mozharness leave the profile to the parent monitor, and\nmozharness has it report its Perfherder data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330471\n", "files": ["python/mozbuild/mozbuild/code_analysis/mach_commands.py", "python/mozbuild/mozbuild/controller/building.py", "taskcluster/mach_commands.py", "testing/mach_commands.py", "testing/mozbase/mozlog/mozlog/handlers/resourcehandler.py", "testing/mozharness/mozharness/base/python.py", "tools/lint/mach_commands.py"], "git_node": "e83c369b5a6f4de36eacab33abda256af488fa44", "git_parents": ["b4fb01c2acbc38b7617a8ceadebccaa65b372c88"], "node": "f820e79c2b466989b442c347de53ac9869b50541", "parents": ["21e8c4347c126c6d29ff22f0648c631c440cd1ab"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Add fetch tasks for psutil wheels. r=releng-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337077\n", "files": ["taskcluster/kinds/fetch/python-wheels.yml"], "git_node": "a63dc4ce5a16fe567983fb09d069de1c014343fc", "git_parents": ["e83c369b5a6f4de36eacab33abda256af488fa44"], "node": "0cbe9a98b9adb85e361e7207d7f158bf0e9375d2", "parents": ["f820e79c2b466989b442c347de53ac9869b50541"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1425785 - Monitor resource usage from the hg run-task. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nrun-task records a profile of the whole task, including the checkout and\nfetches. Resource monitors in processes it spawns forward their events,\nmarkers and phases to it instead of collecting resource usage themselves,\nand run-task reports the Perfherder data mozharness asks for.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330472\n", "files": ["taskcluster/docker/fetch/Dockerfile", "taskcluster/gecko_taskgraph/__init__.py", "taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/test/test_transforms_job.py", "taskcluster/gecko_taskgraph/transforms/job/run_task.py", "taskcluster/kinds/source-test/clang-tidy.yml", "taskcluster/kinds/source-test/clang.yml", "taskcluster/kinds/source-test/mozlint.yml", "taskcluster/scripts/run-task", "taskcluster/scripts/run_task_resource_monitor.py"], "git_node": "fa4ce6442fcbf3dadb069e1a919a099f1082bcb7", "git_parents": ["a63dc4ce5a16fe567983fb09d069de1c014343fc"], "node": "f0b3b220da9e1a6dbcb91a1e52611feb8cb702a5", "parents": ["0cbe9a98b9adb85e361e7207d7f158bf0e9375d2"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2064034 - [devtools] Add coverage for invalid URL used in Local Mode. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319928\n", "files": ["devtools/shared/network-observer/test/browser/browser_networkobserver_localMode.js", "devtools/shared/network-observer/test/browser/local-mode/%"], "git_node": "b43770fa1891638a514a84f8ddb2bd3b76ba9d30", "git_parents": ["fa4ce6442fcbf3dadb069e1a919a099f1082bcb7"], "node": "6aa42cb470bb247f4a6fec154b6157b5381877ce", "parents": ["f0b3b220da9e1a6dbcb91a1e52611feb8cb702a5"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1831048 - Part 12: Fix 166 'misc-unused-parameters' warnings under /docshell r=dom-core-reviewers,vhilla\n\nhttps://clang.llvm.org/extra/clang-tidy/checks/misc/unused-parameters.html\n\nEverything found by ./mach static-analysis was manually inspected and changed if needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335682\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContextWebProgress.cpp", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/LoadContext.cpp", "docshell/base/WindowContext.cpp", "docshell/base/nsAboutRedirector.cpp", "docshell/base/nsDSURIContentListener.cpp", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellTreeOwner.cpp", "docshell/base/nsPingListener.cpp", "docshell/shistory/ChildSHistory.cpp", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "docshell/shistory/nsSHistory.cpp"], "git_node": "e82041388d83016c3e57c18c3888865249fad00d", "git_parents": ["b43770fa1891638a514a84f8ddb2bd3b76ba9d30"], "node": "49cae74263d239371aa8d35d36e82334098880b2", "parents": ["6aa42cb470bb247f4a6fec154b6157b5381877ce"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2086469 - Re-enable BOLT for taskcluster-built clang binaries r=glandium\" for causing toolchains bustages.\n\nThis reverts commit cd699a9c80c9d4d51466076f92e86c5e65bf06b0.\n", "files": ["build/build-clang/bolt-no-use-gnu-stack.patch", "build/build-clang/clang-22.json", "build/build-clang/clang-23.json", "build/build-clang/clang-trunk.json", "taskcluster/kinds/toolchain/clang.yml"], "git_node": "f41d030b3594f176af817b33774447ce3853e784", "git_parents": ["e82041388d83016c3e57c18c3888865249fad00d"], "node": "9d2181b2c5f8940a2493b0e3c183580cbcc7f155", "parents": ["49cae74263d239371aa8d35d36e82334098880b2"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2028789 - [devtools] Bounce and throttle ressources. r=devtools-reviewers,nchevobbe,jdescottes\n\nThis help aggregate the first ressources which may have dispatched\nright away whereas some others could be delivered synchronously right after.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291790\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-unselected-pause.