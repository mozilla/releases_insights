4755d73ede8e1e745d3f53b", "0537e231a1d37dd12b6a2c1a5056c68e7b2374a4", "4c196ecbfff887a88532bb7cdd79bd8cc55f7304", "e5e046c9194b50adebb0d98cb17a9746c992326b", "69cf8a54c30f1b6f418d46e751e0e9e29212e894", "69cb0bffd0ff109051f7be033fb054df8bf42a33", "eaa67c5f12c3af06891ad055a98f26e46b7bbdf0", "9407148b01202846f7cbc1dd584c21ecb7d49069", "e728d826999dede71eef29aed8a79a374c3e588e", "3f153c9d78e812bd6ae0c3914b90a8f3b9806b29", "0838e83b25c1a7805d78a341b9c8b99b75098874", "30643005b51974cf747cf8f518031a2941bef51c", "ee30bd8e8ffe18887a2e9f3453fea121814bffb4", "98e5bbbf2574795bdb634ac82ac17c8fd1c03ddb", "05d280a484451f68a4015db2f38aef1f8df7868f", "59fb033c7ad22cee6335a02db41e5adb59fc7a4a", "df8a18129858a77528a76c3fa75013f1e073b950", "1bc6b654b0e132bb99fc194aa9d379d479f24738", "38b3f2fe9a7dc8bc9ce0ce407f8d0364a5fbcb51", "a029bd9a24b3647687f67c89d6eb971f2094257f", "4ff10eba0dd90fb2f1c1d55e4cb268be0e17602c", "5e1ae849d8c704c04f5b238d9469b7e818315f3a", "08533c6b26eef5bba0c00d101f10b76b0727818c", "804f6e8302ea88d815f477f061232fecf2ed78e1", "3547015f390dafe09075532175da6d02450a8275", "c2bc110db6b4a1f2dd504e0e9b7a9d108e4af96c", "f9b0e312b2837e6f1af3149ed16b9d99d090a1ce"], "user": "agoloman@mozilla.com"}, "45674": {"changesets": [{"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083734 - Only install visual metrics packages in the raptor virtualenv when visual metrics run. r=perftest-reviewers,kshampur\n\nMost browsertime tasks don't compute visual metrics, but every run installed\nnumpy, Pillow, scipy, opencv-python and pyssim, which Android hardware\ndownloads each time.\n\nRaptor's geometric mean used scipy, so it now uses the statistics module,\nkeeping scipy's results for empty, negative and zero input.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335141\n", "files": ["testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/raptor/raptor/filters.py", "testing/raptor/test/python.toml", "testing/raptor/test/test_filters.py"], "git_node": "e65fd19f7d44f636e417ecef60eff744a172e403", "git_parents": ["f9b0e312b2837e6f1af3149ed16b9d99d090a1ce"], "node": "645d6102dd4c00df52c04ede0633bcd738336bff", "parents": ["7e11c39232abe0f46f1a267613a8aedf440e36b9"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083140 - Animate panels with the panel motion tokens. r=kcochrane,emilio,desktop-theme-reviewers,reusable-components-reviewers,jules\n\nPanels now drop 4px and scale out of the corner they hang from, rather than\nsliding 70px. macOS animates the -moz-window-* properties as before, so the\nnative window shadow comes along and the system is not asked to recompute the\nwindow's shape mid-animation; since bug 2080204 those honour transform-origin,\nso a single declaration pivots both paths on the same corner. There the panel\nonly scales, with no drop.\n\nThe durations, the curve and the distances they animate over live in the design\nsystem as panel tokens, with --panel-motion-easing referencing\n--motion-easing-emphasized from bug 2083138 so the curve is named in one place.\nThe subview durations land alongside them for the panel subview animations that\nfollow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328873\n", "files": ["toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/panel.tokens.json", "toolkit/themes/shared/design-system/storybook/tokens-table.css", "toolkit/themes/shared/design-system/storybook/tokens-table.stories.mjs", "toolkit/themes/shared/popup.css"], "git_node": "c8e1217419b1d6b36ab55fa7bb3a780dfc6de153", "git_parents": ["e65fd19f7d44f636e417ecef60eff744a172e403"], "node": "fe0077d3f3db20d989da6be4de705e26850e0e68", "parents": ["645d6102dd4c00df52c04ede0633bcd738336bff"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086999 - Run test_android_audio.html for isolated process. r=ipc-reviewers,mccr8\n\nThis was fixed by bug 2009876 fixing the test itself for the NDK\ndecoder, and bug 1988531 enabling the NDK decoder for isolated process\ntests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337907\n", "files": ["ipc/glue/test/browser/mochitest_audio.toml"], "git_node": "59c9442f39c160e4bc3fcacd7b10da0c91721ab5", "git_parents": ["c8e1217419b1d6b36ab55fa7bb3a780dfc6de153"], "node": "d4972e0a6433455ca9c48e28e1af7bde0b31d3ad", "parents": ["fe0077d3f3db20d989da6be4de705e26850e0e68"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083734 - Only install visual metrics packages in the raptor virtualenv when visual metrics run. r=perftest-reviewers,kshampur\" for causing python failures.\n\nThis reverts commit e65fd19f7d44f636e417ecef60eff744a172e403.\n", "files": ["testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/raptor/raptor/filters.py", "testing/raptor/test/python.toml", "testing/raptor/test/test_filters.py"], "git_node": "97416095f9fcebc6266420c09cb31de31dac8723", "git_parents": ["59c9442f39c160e4bc3fcacd7b10da0c91721ab5"], "node": "95c1e8e840ef78ccc6a223aa76cb3b03a72c1911", "parents": ["d4972e0a6433455ca9c48e28e1af7bde0b31d3ad"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086630 - Upload only symbol files and the PDB for the OpenH264 plugin. r=taskgraph-reviewers,releng-reviewers,bhearsum\n\npackagesymbols.py stored the input binary in the symbols archive under the\ndebug file name reported by dump_syms. Package only the .sym files instead,\nplus on Windows the real PDB written next to the DLL, which was previously\ndiscarded. Binaries are no longer packaged at all.\n\nThe symbol server only serves PDBs in the CAB-compressed form that\nupload_symbols.py produces, and it only converts files from .tar.zst archives,\nso package the symbols as a .tar.zst like Firefox builds do and provide\nmakecab to the symbol upload task, as the upload-symbols kind does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337628\n", "files": ["python/mozbuild/mozbuild/action/packagesymbols.py", "taskcluster/gecko_taskgraph/transforms/openh264_symbol_upload.py", "taskcluster/kinds/openh264-symbol-upload/kind.yml", "taskcluster/scripts/openh264/build.sh"], "git_node": "5179db59154a4288624c4abfb56943d9f7a78be5", "git_parents": ["97416095f9fcebc6266420c09cb31de31dac8723"], "node": "11fbba6484791f27cf2bb03d7c4d41e3e44e0553", "parents": ["95c1e8e840ef78ccc6a223aa76cb3b03a72c1911"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082960 - Stop building the deprecated Expat XML_SetHashSalt. r=mccr8\n\nxmlSetHashSalt is disabled with it because it would otherwise be an unused static function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337821\n", "files": ["parser/expat/11_unused.patch", "parser/expat/expat/lib/xmlparse.c"], "git_node": "e305b62666da350e0966d807fbea753a5687f4a4", "git_parents": ["5179db59154a4288624c4abfb56943d9f7a78be5"], "node": "cf893b8c183394d5eb896d9fdfbb5129315ece10", "parents": ["11fbba6484791f27cf2bb03d7c4d41e3e44e0553"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1982206 - Start the tagging service on Places initialization, so it always removes the tags of unbookmarked URLs. r=places-reviewers,jteow\n\nThe tagging service removes the tags of a URL once it's no longer bookmarked,\nbut it was only created on first use of tagging, so earlier removals, for\nexample by Sync, left its tags behind and the URL still looked bookmarked.\n\nStart the service on Places initialization, and skip the removal work when\nthere are no tags. A new maintenance task removes tag entries of unbookmarked\nURLs from existing profiles; since maintenance changes tags without\nnotifications, the service now drops its cache on purge-caches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336717\n", "files": ["toolkit/components/places/PlacesDBUtils.sys.mjs", "toolkit/components/places/TaggingService.sys.mjs", "toolkit/components/places/components.conf", "toolkit/components/places/tests/maintenance/test_preventive_maintenance.js", "toolkit/components/places/tests/sync/test_bookmark_deletion.js", "toolkit/components/places/tests/unit/test_tagging.js"], "git_node": "110073679eb66ad0e0f09e5f4d48ed99d1c84475", "git_parents": ["e305b62666da350e0966d807fbea753a5687f4a4"], "node": "5c55a7c3c7f9cd929c7d61bfb8bd6b19da7719c8", "parents": ["cf893b8c183394d5eb896d9fdfbb5129315ece10"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084078 - Clean up GMP origin matching. r=aosmond,media-playback-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337745\n", "files": ["dom/media/gmp/GMPServiceParent.cpp"], "git_node": "ebbb7328f5890a82edff3daec71c52c10ac750c2", "git_parents": ["110073679eb66ad0e0f09e5f4d48ed99d1c84475"], "node": "ff3c7f4536d0fc5c4694046bd0f758b129b8716e", "parents": ["5c55a7c3c7f9cd929c7d61bfb8bd6b19da7719c8"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086608 - Add perf tasks to the mocked bugbug known tasks. r=taskgraph-reviewers,bhearsum\n\nThe real bugbug knows about these tasks, but they are missing from the\nstale known_tasks list in the test data, so in the test they would be\nappear to be scheduled by mach try auto once perf tasks are optimized\nwith bugbug on try.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337878\n", "files": ["taskcluster/test/data/bugbug-push-schedules.json"], "git_node": "f83a1d9ff5a5c3c0e132c34564623fb7364535d7", "git_parents": ["ebbb7328f5890a82edff3daec71c52c10ac750c2"], "node": "f74ced8be0674ff1eea24a91f377eabde6469bdd", "parents": ["ff3c7f4536d0fc5c4694046bd0f758b129b8716e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086608 - Apply the try overrides for backstop and expanded pushes to the perf-cadence aliases. r=taskgraph-reviewers,bhearsum\n\nPerf tasks reference the perf-cadence-* aliases rather than the\nunderlying strategies, so the tryselect overrides keyed on\nskip-unless-backstop and skip-unless-expanded no longer matched them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337594\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py"], "git_node": "dfd8e43de80cbbd6478514736557a529ea453f19", "git_parents": ["f83a1d9ff5a5c3c0e132c34564623fb7364535d7"], "node": "2463f5c40ec5a0c5d8f09cfffcff7134129f4297", "parents": ["f74ced8be0674ff1eea24a91f377eabde6469bdd"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086608 - Test mach try auto on a push that would be expanded on autoland. r=taskgraph-reviewers,bhearsum\n\nThe tests set up a non-backstop push, which hid perf tasks being\nscheduled on try on every 10th push. Since bug 1660506 the backstop is\nno longer computed during optimization, so the pushlog mock it needed is\nunused. The files changed mock never matched the json-pushchangedfiles\nendpoint, so remove it too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337879\n", "files": ["taskcluster/test/conftest.py", "taskcluster/test/data/pushes.json", "taskcluster/test/data/pushfileschanged.json", "taskcluster/test/test_autoland.py", "taskcluster/test/test_mach_try_auto.py", "taskcluster/test/test_new_config.py"], "git_node": "3e918b26bb10d39f3e0e0bc4451b1ee79821e177", "git_parents": ["dfd8e43de80cbbd6478514736557a529ea453f19"], "node": "14c0272a40aa34156f1ffd1162bf2d61dd59e4fd", "parents": ["2463f5c40ec5a0c5d8f09cfffcff7134129f4297"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087010 - Move the GeckoClipboardContentProvider declaration from AndroidManifest_overlay.jinja to AndroidManifest.xml. r=geckoview-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337917\n", "files": ["mobile/android/geckoview/src/main/AndroidManifest.xml", "mobile/android/geckoview/src/main/AndroidManifest_overlay.jinja"], "git_node": "0db20cae4b5bad918b4b7a5cb9671ce7e7b6f300", "git_parents": ["3e918b26bb10d39f3e0e0bc4451b1ee79821e177"], "node": "09913d486cb73db95d26510e22d9eb47e7e3a3d9", "parents": ["14c0272a40aa34156f1ffd1162bf2d61dd59e4fd"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044104 - Create an android version of the navigation benchmark r=perftest-reviewers,acreskey,aglavic\n\nThis patch adds a Fenix version of the navigation benchmark. One browser\ncycle loads amazon, wikipedia, duckduckgo, and bbc in a sequence, with a\nsub-navigation on amazon, wikipedia, and duckduckgo.\n\n* This test will start off as tier 3 for now but shortly be bumped to tier\n2 in ~2 weeks\n* Direct mitmproxy playback is enabled. (So fenix ignores the device\nsystem proxy)\n* Also runs on Fenix nightly-as-release variant\n* Video annotations are enabled (only for this task and not tp6m)\n* Capable of being gecko-profiled\n\nOverall this is similar to the desktop variant (uses same scoring\nmethod)\n\nNoise on Try was overall ~3% on Fenix and Fenix NaR. 5 browser cycles is\nused here (similar to Desktop) as there wasn't much change in variance\nbetween 4 to 9 browser cycles. This helps reduce task execution time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324708\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/raptor.py", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "testing/mozbase/mozproxy/mozproxy/backends/mitm/mitm.py", "testing/perfdocs/generated/raptor-metrics.md", "testing/perfdocs/generated/raptor.md", "testing/performance/nav_sites.json", "testing/raptor/raptor/browsertime/android.py", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/perftest.py", "testing/raptor/raptor/raptor.toml", "testing/raptor/raptor/tests/nav-bench/browsertime-nav-bench-m.toml", "testing/raptor/raptor/tooltool-manifests/nav-bench/mitm12-android-gve-amazon-nav.manifest", "testing/raptor/raptor/tooltool-manifests/nav-bench/mitm12-android-gve-bbc-nav.manifest", "testing/raptor/raptor/tooltool-manifests/nav-bench/mitm12-android-gve-duckduckgo-nav.manifest", "testing/raptor/raptor/tooltool-manifests/nav-bench/mitm12-android-gve-wikipedia-nav.manifest", "testing/raptor/test/test_raptor.py"], "git_node": "8e46df64fbff761b757f4b405820896af1b81d67", "git_parents": ["0db20cae4b5bad918b4b7a5cb9671ce7e7b6f300"], "node": "171bf5b9c34e66bed819bc9bf1cdfc2f4e2e8990", "parents": ["09913d486cb73db95d26510e22d9eb47e7e3a3d9"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2083140 - Animate panels with the panel motion tokens. r=kcochrane,emilio,desktop-theme-reviewers,reusable-components-reviewers,jules\" for causing bc failures @browser_parsable_css.js.\n\nThis reverts commit c8e1217419b1d6b36ab55fa7bb3a780dfc6de153.\n", "files": ["toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/panel.tokens.json", "toolkit/themes/shared/design-system/storybook/tokens-table.css", "toolkit/themes/shared/design-system/storybook/tokens-table.stories.mjs", "toolkit/themes/shared/popup.css"], "git_node": "7c04977c0654ac2ecafbbf4002454a35892736ed", "git_parents": ["8e46df64fbff761b757f4b405820896af1b81d67"], "node": "1b5933c47cccc5113d494ed5d571e8e5ffb827e6", "parents": ["171bf5b9c34e66bed819bc9bf1cdfc2f4e2e8990"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085078 - Make prefetch pageload telemetry tests deterministic. r=acreskey\n\nForce normal pageload events instead of retrying sampled-out navigations. Wait for the source event before resetting telemetry and retain events across ping submission so each assertion observes only the target navigation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336731\n", "files": ["dom/base/test/browser_page_load_event_prefetch.js"], "git_node": "a6a3883eaac6a5a57e3b3ab5619e9fa602cf3f22", "git_parents": ["7c04977c0654ac2ecafbbf4002454a35892736ed"], "node": "302d6a8fe44b4bf0f57505256d91525d73883942", "parents": ["1b5933c47cccc5113d494ed5d571e8e5ffb827e6"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 1738302 - fix(angle): pass `--forward` to `patch` so already-applied patches fail instead of being reverted r=gfx-reviewers,tnikkel\n\nCurrently, our ANGLE revendoring scripting uses the `--batch` option for\n`patch` to apply the local patch stack. This has a problematic\nheuristic; according to `man patch`:\n\n\u003e ```\n\u003e `-t`  or  `--batch`\n\u003e   \u2026 assume that patches are reversed if they look like they are.\n\u003e ```\n\n\ud83d\ude2c  If we have a patch, it could get //reversed// if it seems like it's already applied??? What if we have, say, a critical security bug that's only implemented as a patch? No thanks! Luckily, we can used `--forward` to solve this:\n\n\u003e ```\n\u003e `-N`  or  `--forward`\n\u003e    When a patch does not apply, patch usually checks if the patch\n\u003e    looks like it has been applied already by trying to reverse-apply\n\u003e    the first hunk. The `--forward` option prevents that. \u2026\n\u003e ```\n\nSo, use `--forward` to stop that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337681\n", "files": ["gfx/angle/update-angle.py"], "git_node": "6966702f3d66e74c40a828dafdf55a34276268f6", "git_parents": ["a6a3883eaac6a5a57e3b3ab5619e9fa602cf3f22"], "node": "a6977ce05023a00d5f9bb1afb79600b3bb86a442", "parents": ["302d6a8fe44b4bf0f57505256d91525d73883942"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 1738302 - chore(updatebot): fetch `linux64-gn` for the `cron` task r=taskgraph-reviewers,bhearsum\n\nANGLE's vendoring (`mach vendor gfx/angle/moz.yaml`) uses `gn` for `gn_processor.py`, and we'd like to start running that vendoring process on a schedule via Updatebot. Updatebot uses the `cron` environment; add `linux64-gn` to its toolchain fetches, so it's available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337682\n", "files": ["taskcluster/kinds/updatebot/kind.yml"], "git_node": "419b4634da1d81b86dca87cf073c237ad3a99a30", "git_parents": ["6966702f3d66e74c40a828dafdf55a34276268f6"], "node": "a0ec225a1d8b853c39877e917697ba63f2763121", "parents": ["a6977ce05023a00d5f9bb1afb79600b3bb86a442"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 1738302 - chore(angle): fix Updatebot configuration r=gfx-reviewers,bradwerth\n\nSwitch the ANGLE Updatebot task from `commit-alert` on the stale `chromium/7778` branch to `vendoring`. Since bug 2035541, `mach vendor gfx/angle/moz.yaml` follows the ANGLE revision pinned by Chromium Beta, so Updatebot can now produce revendor patches itself.\n\n`release` frequency was ruled out: an open Updatebot bug suppresses new jobs until it's closed, leaving its patch targeting a progressively older Beta.\n\nUse the `webgl` try preset for Updatebot's try pushes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337683\n", "files": ["gfx/angle/moz.yaml"], "git_node": "2b8c505740a9aff62065ca376d452e05c035f1dc", "git_parents": ["419b4634da1d81b86dca87cf073c237ad3a99a30"], "node": "4b8cf43c4aadcd7f238dd9e01da22f8b4a88b624", "parents": ["a0ec225a1d8b853c39877e917697ba63f2763121"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084943 - Run mochitest-browser-chrome on the macOS tart VMs. r=aryx,media-webspeech-reviewers,azebrowski,credential-management-reviewers,urlbar-reviewers,daisuke,mtigley\n\nThe tester image is now 1920x1080 (macos-vms PR 52), which fixed most of the\nVM-only browser-chrome failures. Skip the tests that still fail only on the\nVMs, and keep debug off like the other suites on this platform.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336138\n", "files": ["browser/base/content/test/browser-fullscreen/browser.toml", "browser/base/content/test/browser-webrtc/browser.toml", "browser/extensions/formautofill/test/browser/address/browser.toml", "dom/base/test/browser.toml", "dom/media/webspeech/recognition/test/browser.toml", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/test-sets.yml", "uriloader/exthandler/tests/mochitest/browser.toml"], "git_node": "be5d5e5f6a58a1725e342923b961da5d298df45e", "git_parents": ["2b8c505740a9aff62065ca376d452e05c035f1dc"], "node": "df38f66093cf2c71c725d86eb5a85cc76a4f8701", "parents": ["4b8cf43c4aadcd7f238dd9e01da22f8b4a88b624"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2086623 - Update rust-analyzer to version 2026-10-26. r=glandium\n\nThis pulls in https://github.com/rust-lang/rust-analyzer/pull/23173,\nwhich fixes some symbol ambiguities in crates with multiple targets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337605\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "48ca6c1ead12f6c913b53a292ff23b82e6193c38", "git_parents": ["be5d5e5f6a58a1725e342923b961da5d298df45e"], "node": "3c8440789c2fad6e0fdf65a36e5776755381a12b", "parents": ["df38f66093cf2c71c725d86eb5a85cc76a4f8701"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2086752 - Restore the browser window before measuring it in test_bug517396.xhtml and remove the skip-if added in bug 2026600, r=win-reviewers,gstoll.\n\nNew profiles open the browser window maximized on small screens, which is the case on Windows CI and made the test fail in the standalone variant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337703\n", "files": ["widget/tests/chrome.toml", "widget/tests/test_bug517396.xhtml"], "git_node": "09705d376141680f67a0f75df5aa1b95d571d975", "git_parents": ["48ca6c1ead12f6c913b53a292ff23b82e6193c38"], "node": "0d11d9920c14e962cb722a80794d96cc59ff2838", "parents": ["3c8440789c2fad6e0fdf65a36e5776755381a12b"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070583 - part 1 - Allow a menu item provider to offer any number of menu items r=android-reviewers,giorga\n\nNeeded for the custom tab menu items added by apps - which can ask for multiple\nmenu items to be shown.\nSee https://developer.chrome.com/docs/android/custom-tabs/guide-interactivity#add_custom_menu_items.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337475\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarkMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarksScreenMenuItemProvider.kt", "mobile