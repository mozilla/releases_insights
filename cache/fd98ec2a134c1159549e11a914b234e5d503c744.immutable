ests.h", "dom/quota/QuotaResults.cpp", "dom/quota/QuotaResults.h", "dom/quota/nsIQuotaManagerService.idl", "dom/quota/nsIQuotaRequests.idl", "dom/quota/nsIQuotaResults.idl"], "git_node": null, "git_parents": [null], "node": "5e07bd37ac6162f218dfe03ed83b5dcca9653b68", "parents": ["28934912eede9e14895baf4af7575ca9639f59ee"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1348660 - Part 6: Rename QuotaManager::IsOriginWhitelistedForPersistentStorage() to QuotaManager::IsOriginInternal(). r=btseng, a=lizzard", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/quota/ActorsParent.cpp", "dom/quota/QuotaManager.h"], "git_node": null, "git_parents": [null], "node": "556ff3bfb9fcb3adde1eb7ef81ed92ecfe3b444b", "parents": ["5e07bd37ac6162f218dfe03ed83b5dcca9653b68"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1350564 - Don't try to addref a null mResult in UsageRequest::GetResult (mResult can be null when mHaveResultOrErrorCode is true). r=btseng, a=lizzard", "files": ["dom/quota/QuotaRequests.cpp"], "git_node": null, "git_parents": [null], "node": "2abf26abb2a20d07a431fccfa97f19285bf5bac4", "parents": ["556ff3bfb9fcb3adde1eb7ef81ed92ecfe3b444b"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1047098 - \"Clear Recent History\" must always clean up QuotaManager data. r=janv, a=lizzard", "files": ["browser/base/content/sanitize.js"], "git_node": null, "git_parents": [null], "node": "0de6bb4377d816eca40b1e7f191cddfbb1a018de", "parents": ["2abf26abb2a20d07a431fccfa97f19285bf5bac4"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1047098 - \"Clear Recent History\" must clean up all the ServiceWorkers. r=bkelly, a=lizzard\n\nThis includes minor shutdown fixes by :asuth as discussed on\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1047098#c56 and c57.\n***\nBug 1047098 - Release branch fix for ServiceWorkerRegistrar shutdown. r=bkelly, a=lizzard\n\nMy fix for the ServiceWorkerRegistrar shutdown case was not uplift-safe due to\na change in how ServiceWorkerRegistrar handled shutdown.  On release it spins\nits own nested event loop rather than using the AsyncShutdown mechanism.  The\ntest failures were due to not initializing the mShutdownCompleteFlag to\npoint at something.  xpcshell tests experiencing the testing edge case running\nunder optimized builds would end up writing to the null memory address.  Debug\nbuilds would end up asserting that the pointer had no value.\n\nI've reordered the ProfileStopped method so the pointer is initialized earlier.\nI also added a death-grip in the observer call.  I initially added it because\nof a hasty analysis of the problem, but the use of ClearOnShutdown() with its\ndefault shutdown phase should happen strictly after the profile-before-change\nnotification should keep things safe.  I left it there because of the nested\nevent loop spinning and not wanting to have to think about that.", "files": ["browser/base/content/sanitize.js", "dom/workers/ServiceWorkerRegistrar.cpp", "toolkit/components/places/tests/head_common.js"], "git_node": null, "git_parents": [null], "node": "810f4346fd0587fd7a1bb65c3df8d3f78dc23fef", "parents": ["0de6bb4377d816eca40b1e7f191cddfbb1a018de"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1404105 - Sanitize.js must check if QuotaManager returns an error before continuing with cleaning data. r=janv, a=lizzard", "files": ["browser/base/content/sanitize.js"], "git_node": null, "git_parents": [null], "node": "679425f89cbd691a33ab9e206a4950c057a6c662", "parents": ["810f4346fd0587fd7a1bb65c3df8d3f78dc23fef"], "tags": []}], "date": 1509404054, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7399": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1047098 - Use yield instead of await to fix ESLint complaints. a=bustage", "files": ["browser/base/content/sanitize.js"], "git_node": null, "git_parents": [null], "node": "0eb83ade9ad361f7d31c6f5e6910e31513262a8a", "parents": ["679425f89cbd691a33ab9e206a4950c057a6c662"], "tags": []}], "date": 1509406119, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7400": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out 4 changesets (bug 1404105, bug 1047098) for various test failures.\n\nBacked out changeset 0eb83ade9ad3 (bug 1047098)\nBacked out changeset 679425f89cbd (bug 1404105)\nBacked out changeset 810f4346fd05 (bug 1047098)\nBacked out changeset 0de6bb4377d8 (bug 1047098)", "files": ["browser/base/content/sanitize.js", "dom/workers/ServiceWorkerRegistrar.cpp", "toolkit/components/places/tests/head_common.js"], "git_node": null, "git_parents": [null], "node": "7ff9ed370d89bf180fd9801219cf2d5cfdb007a1", "parents": ["0eb83ade9ad361f7d31c6f5e6910e31513262a8a"], "tags": []}], "date": 1509411232, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7401": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-033 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "00c6716aad94e8f43f19777c14f41156e675cdc2", "parents": ["7ff9ed370d89bf180fd9801219cf2d5cfdb007a1"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-033 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "98fd4aac4227c7bffda210a001782eae34089aab", "parents": ["00c6716aad94e8f43f19777c14f41156e67