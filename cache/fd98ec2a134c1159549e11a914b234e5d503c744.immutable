t_node": null, "git_parents": [null], "node": "9e4b8b227613a18635ddaac911a41097a9ffb92e", "parents": ["ef7e0b702472fec8623bc47ba71ef4d2bd911546"], "tags": []}], "date": 1509819574, "git_changesets": [null, null], "user": "ffxbld"}, "7408": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-032 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "390f34cd7bdd37d9e6a6f424434da23e9204e0cc", "parents": ["9e4b8b227613a18635ddaac911a41097a9ffb92e"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-032 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "a20b9aa59e82f4777c12f8c132c66535ad32a26d", "parents": ["390f34cd7bdd37d9e6a6f424434da23e9204e0cc"], "tags": []}], "date": 1509909207, "git_changesets": [null, null], "user": "ffxbld"}, "7409": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1400763 - Remove display: contents pseudo frames. r=mats, a=lizzard\n\nThe content insertion frame may be tagged instead of the primary frame.\n\nMozReview-Commit-ID: 9x5apL0sv1y", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": null, "git_parents": [null], "node": "de336078d36b0f6f88b0fc566a1e4132f54a78e1", "parents": ["a20b9aa59e82f4777c12f8c132c66535ad32a26d"], "tags": []}], "date": 1509983982, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7410": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-031 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "0c3b0090f5706a4cd650f0e910f8fefa0af64999", "parents": ["de336078d36b0f6f88b0fc566a1e4132f54a78e1"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-031 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "ea110ab80ef8d6d80d4f3e6be9773880c4500950", "parents": ["0c3b0090f5706a4cd650f0e910f8fefa0af64999"], "tags": []}], "date": 1509996154, "git_changesets": [null, null], "user": "ffxbld"}, "7411": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1047098 - \"Clear Recent History\" must always clean up QuotaManager data. r=janv, a=lizzard", "files": ["browser/base/content/sanitize.js"], "git_node": null, "git_parents": [null], "node": "088577f0c46eb1350a1f9ff212fb1439d9b64d98", "parents": ["ea110ab80ef8d6d80d4f3e6be9773880c4500950"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1047098 - \"Clear Recent History\" must clean up all the ServiceWorkers. r=bkelly, a=lizzard\n\nThis includes minor shutdown fixes by :asuth as discussed on\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1047098#c56 and c57.", "files": ["browser/base/content/sanitize.js", "dom/workers/ServiceWorkerRegistrar.cpp", "toolkit/components/places/tests/head_common.js"], "git_node": null, "git_parents": [null], "node": "c7e3abf74023c696ad9b8648f8280b7aad30b690", "parents": ["088577f0c46eb1350a1f9ff212fb1439d9b64d98"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1047098 - Release branch fix for ServiceWorkerRegistrar shutdown. r=bkelly, a=lizzard\n\nMy fix for the ServiceWorkerRegistrar shutdown case was not uplift-safe due to\na change in how ServiceWorkerRegistrar handled shutdown.  On release it spins\nits own nested event loop rather than using the AsyncShutdown mechanism.  The\ntest failures were due to not initializing the mShutdownCompleteFlag to\npoint at something.  xpcshell tests experiencing the testing edge case running\nunder optimized builds would end up writing to the null memory address.  Debug\nbuilds would end up asserting that the pointer had no value.\n\nI've reordered the ProfileStopped method so the pointer is initialized earlier.\nI also added a death-grip in the observer call.  I initially added it because\nof a hasty analysis of the problem, but the use of ClearOnShutdown() with its\ndefault shutdown phase should happen strictly after the profile-before-change\nnotification should keep things safe.  I left it there because of the nested\nevent loop spinning and not wanting to have to think about that.", "files": ["dom/workers/ServiceWorkerRegistrar.cpp"], "git_node": null, "git_parents": [null], "node": "36bd15d14c5ac51f4c369e102cd7ac123962b2fe", "parents": ["c7e3abf74023c696ad9b8648f8280b7aad30b690"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1404105 - Sanitize.js must check if QuotaManager returns an error before continuing with cleaning data. r=janv, a=lizzard", "files": ["browser/base/content/sanitize.js"], "git_node": null, "git_parents": [null], "node": "2909ba991f3134f9fbf4859cf08582f1c9845594", "parents": ["36bd15d14c5ac51f4c369e102cd7ac123962b2fe"], "tags": []}], "date": 1510018083, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "7412": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1415133 - Downgrades from 55+ to ESR lose bookmarks. r=past a=lizzard\n\nMozReview-Commit-ID: 44Rw7m1FP4h", "files": ["toolkit/components/places/Database.cpp"], "git_node": null, "git_parents": [null], "node": "22fe3ff3f92358596521f7155ddc512006022207", "parents": ["2909ba991f3134f9fbf4859cf08582f1c9845594"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1355576 - Add ability to clear all localStorage; r=janv, a=lizzard", "files": ["dom/storage/DOMStorageManager.cpp", "dom/storage/DOMStorageObserver.cpp"], "git_node": null, "git_parents": [null], "node": "cf34a0574e585fab44fbec1718aca5375790cd97", "parents": ["22fe3ff3f92358596521f7155ddc512006022207"], "tags": ["FIREFOX_52_5_0esr_BUILD2", "FIREFOX_52_5_0esr_RELEASE"]}], "date": 1510074592, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}}
}";