, "files": [".hgtags"], "git_node": "3789f7d751039722c5ab4724cf9b0e6e5666a2df", "git_parents": ["9e6e3797814bbdbcb475c8f8db38848cdceaffc0"], "node": "51d234d29e0512337e2ee5abce013f4a2203682f", "parents": ["9b2dd8dbdeac71528268e34c5cfd6568818ee169"], "tags": []}], "date": 1792603327, "git_changesets": ["3789f7d751039722c5ab4724cf9b0e6e5666a2df"], "user": "ffxbld@lando.moz.tools"}, "6375": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084311 - ensure OneCRL bundle is loaded at init  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335790\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335835\n", "files": ["security/manager/ssl/RemoteSecuritySettings.sys.mjs", "security/manager/ssl/tests/unit/test_onecrl_loads_bundle.js", "security/manager/ssl/tests/unit/xpcshell.toml"], "git_node": "d620e31d26f98e54d1771ad764b7bf37dba76f6c", "git_parents": ["6a356de77ef018decf901d848f7f95312d242869"], "node": "e6e771d01d2b9b756607b265b0485e38d685cdfe", "parents": ["bc9f84e1b34ddd8af3670e1fa4f900bd046d975f"], "tags": []}], "date": 1792605035, "git_changesets": ["d620e31d26f98e54d1771ad764b7bf37dba76f6c"], "user": "rvandermeulen@mozilla.com"}, "6376": {"changesets": [{"author": "Vijay Budhram \u003cvbudhram@gmail.com\u003e", "branch": "default", "desc": "Bug 2084297 - Refresh the FxA profile only on an explicit full sync.  a=RyanVM\n\nBug 2031498 made FxaAccountManager.syncNow() refresh the profile with\nignoreCache = true. SyncedTabsStorage calls syncNow() for the tabs engine\neach time the open tabs change, so each tab change sent a GET /v1/profile\nand a POST /v1/verify to FxA.\n\nThis patch refreshes the profile only for a full sync that the user asks\nfor, which is when the reason is SyncReason.User and customEngineSubset is\nempty. WorkManagerSyncManager uses the same check for a user full sync.\nA startup sync no longer skips the profile cache, because the account\nstart already fetches the profile.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336004\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt"], "git_node": "0368301a5a731f11d42e86e4d6adf0c046ae5a08", "git_parents": ["d620e31d26f98e54d1771ad764b7bf37dba76f6c"], "node": "86c2054fb98706180a4ff0e8d1584a606c257f69", "parents": ["e6e771d01d2b9b756607b265b0485e38d685cdfe"], "tags": []}], "date": 1792607157, "git_changesets": ["0368301a5a731f11d42e86e4d6adf0c046ae5a08"], "user": "rvandermeulen@mozilla.com"}, "6377": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084321 - Disable webgl.out-of-process.enable-ahardwarebuffer on Android.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336023\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336026\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "a729abbafa65dd231be7c78a7b3fffcd61237679", "git_parents": ["0368301a5a731f11d42e86e4d6adf0c046ae5a08"], "node": "f2fc3dc815a0daa6a0dbbb6887e4f99c0917ff13", "parents": ["86c2054fb98706180a4ff0e8d1584a606c257f69"], "tags": []}], "date": 1792608093, "git_changesets": ["a729abbafa65dd231be7c78a7b3fffcd61237679"], "user": "dmeehan@mozilla.com"}, "6378": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084297 - Add the missing SyncEngine import to FxaAccountManagerTest. a=bustage\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt"], "git_node": "216e2045945842ac7781cf5d32e2e7ad3803495a", "git_parents": ["a729abbafa65dd231be7c78a7b3fffcd61237679"], "node": "3af6857939073fc1657fa5d347613130a571ff10", "parents": ["f2fc3dc815a0daa6a0dbbb6887e4f99c0917ff13"], "tags": []}], "date": 1792610299, "git_changesets": ["216e2045945842ac7781cf5d32e2e7ad3803495a"], "user": "rvandermeulen@mozilla.com"}, "6379": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 385ef201eb590c60e35180d18583a52a15e3626d with FIREFOX_BETA_159_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "bc4ff84be4e1c8419771037747f4c3189c804b21", "git_parents": ["3789f7d751039722c5ab4724cf9b0e6e5666a2df"], "node": "516fe4b6c3858fafdef54016e00868c3bc83f559", "parents": ["51d234d29e0512337e2ee5abce013f4a2203682f"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 006163118837775b4ae627815acf6b8d32938271 with FIREFOX_BETA_160_BASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "368e610a77193eae7191b7892d6e7ccd0aeffff0", "git_parents": ["bc4ff84be4e1c8419771037747f4c3189c804b21"], "node": "119bc224294b9cfa890e756c0795f7169fe9916f", "parents": ["516fe4b6c3858fafdef54016e00868c3bc83f559"], "tags": []}], "date": 1792674185, "git_changesets": ["bc4ff84be4e1c8419771037747f4c3189c804b21", "368e610a77193eae7191b7892d6e7ccd0aeffff0"], "user": "ffxbld@lando.moz.tools"}, "6380": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-release repo-update remote-settings - a=RyanVM\n", "files": ["services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "89eb647117ffb313dcbe3fcb4cbdb37aadbf24a4", "git_parents": ["216e2045945842ac7781cf5d32e2e7ad3803495a"], "node": "fccf20df1e72b73c6a6232e89e7f8c746a2f8755", "parents": ["3af6857939073fc1657fa5d347613130a571ff10"], "tags": []}], "date": 1792674521, "git_changesets": ["89eb647117ffb313dcbe3fcb4cbdb37aadbf24a4"], "user": "rvandermeulen@mozilla.com"}, "6381": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 006163118837775b4ae627815acf6b8d32938271 with FIREFOX_NIGHTLY_160_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "996da5728dae25cc909d308a2d15ef69f034cc2f", "git_parents": ["368e610a77193eae7191b7892d6e7ccd0aeffff0"], "node": "07a17c1afab53ed5cb9d8e6f316b9d69363b8e64", "parents": ["119bc224294b9cfa890e756c0795f7169fe9916f"], "tags": []}], "date": 1792674695, "git_changesets": ["996da5728dae25cc909d308a2d15ef69f034cc2f"], "user": "ffxbld@lando.moz.tools"}, "6382": {"changesets": [{"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2080264 - Hide text labels for browser menu navigation items in Focus.  a=RyanVM\n\n- Update `MenuGridItem` to center icons vertically and hide the title text and spacer when the title is empty.\n- Add a `showText` flag to menu item construction in `BrowserMenu` and `CustomTabMenu`.\n- Hide text titles for toolbar navigation items (Back, Forward, Share, Stop, Reload) while preserving accessibility content descriptions.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332475\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336112\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuGridItem.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/BrowserMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/CustomTabMenu.kt"], "git_node": "93e8a3a573e68aa62630b5809410a466f8456402", "git_parents": ["89eb647117ffb313dcbe3fcb4cbdb37aadbf24a4"], "node": "97921c129de51f6dfd596fb792682d65ba26e97b", "parents": ["fccf20df1e72b73c6a6232e89e7f8c746a2f8755"], "tags": []}], "date": 1792676025, "git_changesets": ["93e8a3a573e68aa62630b5809410a466f8456402"], "user": "rvandermeulen@mozilla.com"}, "6383": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046558 - Rework active session history entry updates from content.  a=RyanVM\n\nSet/ReplaceActiveSessionHistoryEntry now require the sender's WindowContext\nas an argument and the parent creates shared state using the\nWindowGlobalParent instead of the content's copy.\n\nEach WindowGlobalParent now records the session history load that produced it,\nif any.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D306114\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336158\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "docshell/shistory/nsSHEntryShared.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/ipc/ParentProcessChannelHandle.cpp", "dom/ipc/ParentProcessChannelHandle.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "9a2dc53c369c7ae5172018b35988e1d2ffeff402", "git_parents": ["93e8a3a573e68aa62630b5809410a466f8456402"], "node": "5add844c26613d7e4d84c799d6e23cf987b1240d", "parents": ["97921c129de51f6dfd596fb792682d65ba26e97b"], "tags": ["FIREFOX-ANDROID_159_0_BUILD1", "FIREFOX-ANDROID_159_0_RELEASE", "FIREFOX_159_0_BUILD1", "FIREFOX_159_0_RELEASE"]}], "date": 1792681525, "git_changesets": ["9a2dc53c369c7ae5172018b35988e1d2ffeff402"], "user": "rvandermeulen@mozilla.com"}}
}";