ASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "5be826c462f6496c23cbd9c0f6b74b9cb867d505", "git_parents": ["537ec6a88f3c78a7bb84a552a565367b50654463"], "node": "183aea2022483de58e63903b8b36a42d15b8f2a7", "parents": ["2c39fc65c7aa69ac95db61225c65f687ed9078d3"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging c0c03f3f899017ae4b7e56c0713f1ada51173c41 with DEVEDITION_159_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "175d1491ecd125bc92af561abd64382950f71376", "git_parents": ["5be826c462f6496c23cbd9c0f6b74b9cb867d505"], "node": "fe2a99f3bc9e363942935ca68806da4a1daa8bc9", "parents": ["183aea2022483de58e63903b8b36a42d15b8f2a7"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging c0c03f3f899017ae4b7e56c0713f1ada51173c41 with FIREFOX_159_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "b6c8aca3a9e8ca4abb55a6f016e17417d43bd53b", "git_parents": ["175d1491ecd125bc92af561abd64382950f71376"], "node": "f9d3bee3f71c847be0402dbb2b3e6a8ed99856c1", "parents": ["fe2a99f3bc9e363942935ca68806da4a1daa8bc9"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eb9a6e3a736802c8e080a76c44dc81f409d99d54 with FIREFOX_158_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ed3c342bf463f471bb31108e664a64e425c284cd", "git_parents": ["b6c8aca3a9e8ca4abb55a6f016e17417d43bd53b"], "node": "95216f553d31699c67e93d4069300b1f3ea1c756", "parents": ["f9d3bee3f71c847be0402dbb2b3e6a8ed99856c1"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging dedb41ddf85d96319e7d6d5f45dd5a61986163b3 with FIREFOX_115_43_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "27a9b4d7a21a17f6a9b01e58a1710464eafa88bc", "git_parents": ["ed3c342bf463f471bb31108e664a64e425c284cd"], "node": "1fa780c46964db224fc2fb964b74ff7fde6d5507", "parents": ["95216f553d31699c67e93d4069300b1f3ea1c756"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fd5558cd1123da4b6a35348a386ac8319bb3a144 with FIREFOX_153_5_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "edc00968cc98b41b48c66bb3b00331fcc0213957", "git_parents": ["27a9b4d7a21a17f6a9b01e58a1710464eafa88bc"], "node": "efc7aa16e0a4b9b8bf41b78454c2d3dd0d09aaa5", "parents": ["1fa780c46964db224fc2fb964b74ff7fde6d5507"], "tags": []}], "date": 1791895589, "git_changesets": ["b8736b846c953c0aeaa97c9ef6aa0c385b233519", "48171890c657b12978fac40d90346a7c31792fdf", "f54be2126a86b6999d0f69c4a1b947f74c519fab", "af6d7c361534ad930b97c34746224ca80acc3fa6", "9ee12a9c242741f86eef5590eb9f64348d9d9bb6", "81324164c0f1e93775bf941bc44567416870cdcf", "8dc459c4585fc306bd1af6db78b3722bf10c8407", "41bc521362c56eeb2ea9e16ed93f28f1ceacab34", "c9aef24e3daf16c5ff8bdc0bbab3bc94e2b296f8", "47280f2e729c4d321a973fd18067cf4d63f68f2e", "f06b3d84e3877416559e1abd88767ea235d3d95b", "71b253cbe497927fc265f44624319a634e536da1", "998d8e0612a4818789e9a6068fb1caabaaa9c8ab", "cfbd67df01382823aba4f8e4c8baedb96295fe73", "e19cfbd1682bb5a3886e8c6d8999e8f4515ca739", "ad9241b356d83e2dbc33aebf01c61766e001d38f", "031c489c41faffa6cf06d3195b299de066c7fa77", "5051aa1a06c1f206f6a1dfb80bc37f9371708d71", "1693f237df4f8597270f2dff31b2eee0dc56864b", "4dd2ece39fa16b622429347540ada382f5eaea59", "537ec6a88f3c78a7bb84a552a565367b50654463", "5be826c462f6496c23cbd9c0f6b74b9cb867d505", "175d1491ecd125bc92af561abd64382950f71376", "b6c8aca3a9e8ca4abb55a6f016e17417d43bd53b", "ed3c342bf463f471bb31108e664a64e425c284cd", "27a9b4d7a21a17f6a9b01e58a1710464eafa88bc", "edc00968cc98b41b48c66bb3b00331fcc0213957"], "user": "ffxbld@lando.moz.tools"}, "863": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010071 - Fix undefined vcs references in get_lando_api_config() on ESR153. a=NPOTB DONTBUILD\n", "files": ["tools/tryselect/lando.py"], "git_node": "025d3146d909e9108c6f4bdfd7221ce2ede00a9e", "git_parents": ["f617beaded31d3de1cd5704e47c92811bda116b2"], "node": "3682700438bd8b2c4fe52c9d176e1f24c72a29eb", "parents": ["fd5558cd1123da4b6a35348a386ac8319bb3a144"], "tags": []}], "date": 1791928128, "git_changesets": ["025d3146d909e9108c6f4bdfd7221ce2ede00a9e"], "user": "rvandermeulen@mozilla.com"}, "864": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081227 - update cron-bouncer-check config for esr153 as current ESR. r=releng-reviewers,bhearsum a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333228\n", "files": ["taskcluster/kinds/cron-bouncer-check/kind.yml"], "git_node": "9125c5c8672c4bc46bbea761787d2936976ac76b", "git_parents": ["025d3146d909e9108c6f4bdfd7221ce2ede00a9e"], "node": "5d28834df755d3b3945cca4fa81923f46ddb83f1", "parents": ["3682700438bd8b2c4fe52c9d176e1f24c72a29eb"], "tags": []}], "date": 1791933691, "git_changesets": ["9125c5c8672c4bc46bbea761787d2936976ac76b"], "user": "rvandermeulen@mozilla.com"}, "865": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2066702 - Key a history row on its page, and on the day for the date sorts, rather than on the visit time, .  a=RyanVM DONTBUILD\n\nHistoryController.#normalizeVisit mutates each cached visit in place, and the\ncached visits are normalized again on every refresh (updateCache reuses them\nwhen the Places observer hands it a history map), so the visit time kept being\nappended: `guid` grew from `pageGuid` to `pageGuid|t` to `pageGuid|t|t`, and\n`pageGuid` was left holding the previous, already suffixed value.\n\nThat broke deleting pages, because sidebar-history passes those page guids to\nPlacesUtils.history.remove, which rejects a corrupted guid as neither a valid\nguid nor a URL and throws synchronously, so the `.catch` attached to the call\nnever runs and \"Delete Pages\" silently did nothing after the first background\nrefresh.\n\nThe remaining time suffix was unstable by design: visiting a page again changed\nits row's guid, so the sidebar's multiselection, which is tracked by guid, was\nsilently emptied by any background refresh. A row identifies a page, and for\nthe date sorts a page per day, since that is how the query groups visits, so\nderive the guid from the page guid captured on the first pass and the start of\nthe day rather than from the visit time.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321493\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333320\n", "files": ["browser/components/firefoxview/HistoryController.sys.mjs", "browser/components/sidebar/tests/browser/browser_history_multiselect.js"], "git_node": "f1e87cf08dd302733126d8c95ad5db9d99dee835", "git_parents": ["9125c5c8672c4bc46bbea761787d2936976ac76b"], "node": "841143f221a21c9529b889b8295d637501515028", "parents": ["5d28834df755d3b3945cca4fa81923f46ddb83f1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2032569 - Stop browser_history_multiselect.js from racing background history refreshes, .  a=RyanVM DONTBUILD\n\nA history refresh rebuilds the sidebar's cards, so the `sidebar-tab-list`\nelements and their rows are replaced. The test captured the lists once in\nadd_setup, then waited for mutations on elements that could by then be detached,\nso the waits never resolved and the task timed out. While the cards were being\nrebuilt there was no list at that index at all, which is the\n`firstList is undefined` failure seen in test-verify. It also counted rows the\nprevious task had left `selected`, because `resetSelection` clears the tracked\nselection but only requests the re-render that drops the attribute.\n\n- Look the lists up right before using them, and wait for a rebuilt list to\n  render its rows.\n- Wait for the selection to be cleared in the DOM after resetting it, and for\n  the focused row through the list rather than for an event on a captured row.\n- Wait for the tabs opened by test_open_all_in_tabs to load and flush the\n  pending Places writes, so the visits they record are settled there. Every\n  waitForNewTab listener resolves on the first TabOpen, so poll for the tabs\n  instead of registering one listener per tab.\n- Settle the rebuild that removing a page triggers, and assert the selection\n  test_open_all_in_tabs_warn depends on, so a missing warning dialog fails on\n  that assertion instead of timing out.\n- Run the tasks that mutate history after the ones that need a stable row set,\n  so their churn cannot land in an unrelated task.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321494\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333321\n", "files": ["browser/components/sidebar/tests/browser/browser_history_multiselect.js"], "git_node": "5daae8ad6e85a4828fe9f83fc14f33fdd8abc5de", "git_parents": ["f1e87cf08dd302733126d8c95ad5db9d99dee835"], "node": "c7d6c3ea7fe6224cd8422df2f06871a8ff86d2ec", "parents": ["841143f221a21c9529b889b8295d637501515028"], "tags": []}], "date": 1791933869, "git_changesets": ["f1e87cf08dd302733126d8c95ad5db9d99dee835", "5daae8ad6e85a4828fe9f83fc14f33fdd8abc5de"], "user": "rvandermeulen@mozilla.com"}, "866": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080120 - Clear the promise holder before resolving in TestOfflineClockDriver.TimeAdvance.  a=RyanVM DONTBUILD\n\nMozPromiseHolder::Resolve() clears the holder after resolving, so the main\nthread could see the resolution and destroy the holder while the driver\nthread was still using it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332351\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333151\n", "files": ["dom/media/gtest/TestOfflineClockDriver.cpp"], "git_node": "26db9276faa1cfc8e28a61148e99584670298068", "git_parents": ["5daae8ad6e85a4828fe9f83fc14f33fdd8abc5de"], "node": "737a6436894affb701f690233a2ab2297d6ef443", "parents": ["c7d6c3ea7fe6224cd8422df2f06871a8ff86d2ec"], "tags": []}], "date": 1791933891, "git_changesets": ["26db9276faa1cfc8e28a61148e99584670298068"], "user": "rvandermeulen@mozilla.com"}, "867": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020133 - [devtools] Properly cancel auth prompts when the related channel closes  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325063\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333241\n", "files": ["devtools/shared/network-observer/NetworkAuthListener.sys.mjs", "devtools/shared/network-observer/NetworkResponseListener.sys.mjs", "devtools/shared/network-observer/test/browser/browser_networkobserver_auth_listener.js"], "git_node": "0df49125ae2fb90946f77643f0fac7ffdb3163be", "git_parents": ["26db9276faa1cfc8e28a61148e99584670298068"], "node": "7af637b8becce54bc80c3857ce11051d3e54a197", "parents": ["737a6436894affb701f690233a2ab2297d6ef443"], "tags": []}], "date": 1791933917, "git_changesets": ["0df49125ae2fb90946f77643f0fac7ffdb3163be"], "user": "rvandermeulen@mozilla.com"}, "868": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2064802 - Observe the \u003ckey\u003e element from nsMenuItemX so shortcut changes update the native key equivalent.  a=RyanVM DONTBUILD\n\nnsMenuItemX registered for content changes on mContent, mCommandElement and\nmImageElement, but never on the \u003ckey\u003e element SetKeyEquiv() resolves. Edits\nmade from about:keyboard therefore never reached the NSMenuItem, so when Gecko\nleft a key unhandled and nsCocoaWindow::PostHandleKeyEvent offered it to the\nmenu bar, the stale key equivalent still matched and ran the old shortcut.\n\nTrack the resolved \u003ckey\u003e element as mKeyElement, keep its registration in sync\nas the menu item's key attribute changes, and recompute the key equivalent when\nits key/keycode/modifiers attributes change. Also clear the modifier mask on the\nno-key path so a cleared shortcut doesn't leave a stale mask behind.\n\nAdd nsIDOMWindowUtils.getNativeMenuItemKeyEquivalent so this is testable. An\nNSMenuItem's key equivalent is otherwise not observable from script. The getter\nwalks the window's own nsMenuBarX rather than [NSApp mainMenu], which may\nbelong to a different window such as the hidden window's menu bar.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320573\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333372\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/interfaces/base/nsIDOMWindowUtils.idl", "widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsMenuItemX.h", "widget/cocoa/nsMenuItemX.mm", "widget/nsIWidget.h", "widget/tests/browser/browser.toml", "widget/tests/browser/browser_test_menu_key_equivalent_update.js"], "git_node": "083a00d1e55143c38addc8c534ac171a72986545", "git_parents": ["0df49125ae2fb90946f77643f0fac7ffdb3163be"], "node": "f73b9c2de6125a31297971bcc10e57d4634f2dec", "parents": ["7af637b8becce54bc80c3857ce11051d3e54a197"], "tags": []}], "date": 1791934001, "git_changesets": ["083a00d1e55143c38addc8c534ac171a72986545"], "user": "rvandermeulen@mozilla.com"}, "869": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2042021 - Part 1: Adjust tests  a=RyanVM DONTBUILD\n\nAdds test_driver.bless to provide the required user interaction. Doing this also reveals existing misbehavior where the permission was only rejected because of no user interaction.\n\nAnd made the helper to wait for subscription, otherwise the next permission request auto-cancels the previous request.\n\nset_permission does no real work for gecko as it does not support setting permission for partitioned storage, but such thing would only ever happen in testing environment for notifications (as we always block them), so we can keep it as-is.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321941\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333208\n", "files": ["testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini", "testing/web-platform/meta/push-api/cross-origin-same-site-request.tentative.https.sub.window.js.ini", "testing/web-platform/tests/push-api/resources/cross-origin-nested-child.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-nested-parent.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-serviceworker-iframe.sub.html", "testing/web-platform/tests/push-api/resources/permission-helper.js"], "git_node": "151a9488519b4b921794f7d3b100a8a06bfc6ed8", "git_parents": ["083a00d1e55143c38addc8c534ac171a72986545"], "node": "30febc7135af87607e7f40a320650abec2835108", "parents": ["f73b9c2de6125a31297971bcc10e57d4634f2dec"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2042021 - Part 2: Use IsNotificationForbiddenFor for Push  a=RyanVM DONTBUILD\n\nThe principal check is not part of IsNotificationForbiddenFor and thus is repeated here.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322392\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333209\n", "files": ["dom/notification/NotificationUtils.cpp", "dom/notification/NotificationUtils.h", "dom/notification/metrics.yaml", "dom/push/Push.sys.mjs", "dom/push/PushManager.cpp", "dom/push/test/mochitest.toml", "testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini", "testing/web-platform/meta/push-api/cross-origin-same-site-request.tentative.https.sub.window.js.ini"], "git_node": "51e587e7590e3b7f152b4997e094554467c2051c", "git_parents": ["151a9488519b4b921794f7d3b100a8a06bfc6ed8"], "node": "4ac806f1a23510fc648ef715e0c22d362116fd76", "parents": ["30febc7135af87607e7f40a320650abec2835108"], "tags": []}], "date": 1791934044, "git_changesets": ["151a9488519b4b921794f7d3b100a8a06bfc6ed8", "51e587e7590e3b7f152b4997e094554467c2051c"], "user": "rvandermeulen@mozilla.com"}, "870": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067292 - Validate the inherited controller PrincipalInfo in ClientSourceParent::RecvInheritController  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326841\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333198\n", "files": ["dom/clients/manager/ClientSourceParent.cpp"], "git_node": "34bac9fabbb0bdb644022ee3e37ce22ea73b9a2a", "git_parents": ["51e587e7590e3b7f152b4997e094554467c2051c"], "node": "f9975e896e8335c3bdc5562a5c47e1ee369c2499", "parents": ["4ac806f1a23510fc648ef715e0c22d362116fd76"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067292 - Verify a controlled client and its registration are same-origin in GetClientRegistration  a=RyanVM\n\nmControlledClients is keyed on the client id alone, so this is defense in\ndepth behind the RecvInheritController validation in the parent revision.\n\nThis is the same predicate ClientHandle::Control() already enforces with a\nMOZ_RELEASE_ASSERT for every controlled client, and nsGlobalWindowInner\nbuilds the client principal from eForeignPartitionedPrincipal and requires\nit to Equals() that principal, so the origin attributes agree including\npartitionKey.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326975\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333199\n", "files": ["dom/clients/manager/moz.build", "dom/serviceworkers/ServiceWorkerManager.cpp"], "git_node": "47a0098a8d38ba84a8877b8addfac3e39ebd7789", "git_parents": ["34bac9fabbb0bdb644022ee3e37ce22ea73b9a2a"], "node": "d78fb161bbacb7e37d97dfbeeb8f79014e1d4268", "parents": ["f9975e896e8335c3bdc5562a5c47e1ee369c2499"], "tags": []}], "date": 1791934082, "git_changesets": ["34bac9fabbb0bdb644022ee3e37ce22ea73b9a2a", "47a0098a8d38ba84a8877b8addfac3e39ebd7789"], "user": "rvandermeulen@mozilla.com"}, "871": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067647 - Show correct origin for pointerlock warning  a=RyanVM DONTBUILD\n\nLike previous changes for Fullscreen warning, the pointer lock warning must also use the top-most origin.\n\nThis patch also removes the use of the deprecated .fullscreen attribute in one place.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329581\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333161\n", "files": ["browser/actors/PointerLockParent.sys.mjs", "dom/tests/browser/browser_pointerlock_warning.js"], "git_node": "72509b69ce8021bf8a2ee0199a664289b4574c35", "git_parents": ["47a0098a8d38ba84a8877b8addfac3e39ebd7789"], "node": "1b23abeb8f8a3deb04c412d94d4c52ee795dc9ef", "parents": ["d78fb161bbacb7e37d97dfbeeb8f79014e1d4268"], "tags": []}], "date": 1791940947, "git_changesets": ["72509b69ce8021bf8a2ee0199a664289b4574c35"], "user": "rvandermeulen@mozilla.com"}, "872": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2073584 - Keep NTLM per-channel auth state in the continuation state.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331521\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333143\n", "files": ["netwerk/protocol/http/nsHttpNTLMAuth.cpp", "netwerk/protocol/http/nsHttpNTLMAuth.h"], "git_node": "3fed634