.com/D334460\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335494\n", "files": ["js/src/jit-test/tests/ion/bug2082047-1.js", "js/src/jit/Bailouts.cpp", "js/src/jit/BaselineBailouts.cpp", "js/src/vm/JitActivation.cpp"], "git_node": "c3765c15bc0879891946d9b0b357e19fbb8c6288", "git_parents": ["581fc329a8734b727bbc1a1753594edfd0db2564"], "node": "27ae7b1cbca9b9a08f8b90e4acf6967ec4da1545", "parents": ["7d889ae20389c7e64f111072b1ae639bf72ccdf3"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082047 - Preserve exception state when recover instruction execution fails.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334461\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335495\n", "files": ["js/src/jit-test/tests/ion/bug2082047-2.js", "js/src/jit/JSJitFrameIter.h", "js/src/jit/JitFrames.cpp", "js/src/jsapi-tests/moz.build", "js/src/jsapi-tests/testJitRInstructionResults.cpp", "js/src/jsapi.cpp", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h"], "git_node": "910a6f65f3b8862eb20c3c53b22e6efa4203f490", "git_parents": ["c3765c15bc0879891946d9b0b357e19fbb8c6288"], "node": "ea012d9820fc3a5ecf6a5758e5c713e42a72286f", "parents": ["27ae7b1cbca9b9a08f8b90e4acf6967ec4da1545"], "tags": []}], "date": 1792508972, "git_changesets": ["581fc329a8734b727bbc1a1753594edfd0db2564", "c3765c15bc0879891946d9b0b357e19fbb8c6288", "910a6f65f3b8862eb20c3c53b22e6efa4203f490"], "user": "rvandermeulen@mozilla.com"}, "1034": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Expose arguments passed to host finalization registry cleanup callback  a=RyanVM DONTBUILD\n\nCurrently we expose these when we are about to do the cleanup but this needs to\nhappen as soon as we queue the cleanup otherwise the cycle collector could free\nit before it is run.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332423\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335534\n", "files": ["js/src/gc/FinalizationObservers.cpp", "xpcom/base/CycleCollectedJSContext.cpp"], "git_node": "718f6e1de375ff109eefe8cac708cda34e1390aa", "git_parents": ["910a6f65f3b8862eb20c3c53b22e6efa4203f490"], "node": "f98c2eb227ee76090bf5ea419d674a74538a3c3e", "parents": ["ea012d9820fc3a5ecf6a5758e5c713e42a72286f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Add testcase  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332424\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335535\n", "files": ["xpcom/tests/crashtests/bug-2079059.html", "xpcom/tests/crashtests/crashtests.list"], "git_node": "de1d21ac3af87b17fbbf7962c073c1a551245cc3", "git_parents": ["718f6e1de375ff109eefe8cac708cda34e1390aa"], "node": "04668882f2f25c04473d8c0c7422b6c20d083897", "parents": ["f98c2eb227ee76090bf5ea419d674a74538a3c3e"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Add testcase from related bug  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334020\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335536\n", "files": ["js/src/jit-test/tests/gc/bug-2081988.js"], "git_node": "d37ce355c73997a5e669c0e3d1ab1fe7e2c52367", "git_parents": ["de1d21ac3af87b17fbbf7962c073c1a551245cc3"], "node": "1b87d6f0d05688aff0b2e82292d4c260cc457223", "parents": ["04668882f2f25c04473d8c0c7422b6c20d083897"], "tags": []}], "date": 1792510574, "git_changesets": ["718f6e1de375ff109eefe8cac708cda34e1390aa", "de1d21ac3af87b17fbbf7962c073c1a551245cc3", "d37ce355c73997a5e669c0e3d1ab1fe7e2c52367"], "user": "rvandermeulen@mozilla.com"}, "1035": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080787 - Don't hold on to store buffer entry unnecessarily when tenuring strings  a=RyanVM\n\nSemispace nursery sets a flag |promotedToNursery| when a cell is promoted but\nstays in the nursery. This is used to detect when we need to keep a store\nbuffer entry around rather than discarding it after it's been traced.\n\nThe code in question performs a recursive tenuring operation on a dependent\nstring's base, which overwrites this flag. This can cause the store buffer\nentry to be kept after the pointer it contains is tenured. Subsequent post\nbarrier operations won't remove it for this reason and the memory holding it\ncan be freed, leading to UAF on the next nursery collection.\n\nThe fix is to preserve the flag over the recursive promotion call.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334074\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335539\n", "files": ["js/src/gc/Tenuring.cpp", "js/src/jit-test/tests/gc/bug-2080787.js"], "git_node": "1bf67f2b2056cf6fcf34e13adaa6108caa91c6f9", "git_parents": ["d37ce355c73997a5e669c0e3d1ab1fe7e2c52367"], "node": "b32818b6742c647e5a28dcb9a5582e0320a5bc1a", "parents": ["1b87d6f0d05688aff0b2e82292d4c260cc457223"], "tags": []}], "date": 1792510600, "git_changesets": ["1bf67f2b2056cf6fcf34e13adaa6108caa91c6f9"], "user": "rvandermeulen@mozilla.com"}, "1036": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066417 - Pass for_smil_animation in Servo_ParseAndComputeViewTimelineInset. a=bustage\n", "files": ["servo/ports/geckolib/glue.rs"], "git_node": "7205084093fe5991e6ab5b54cbdd27e7695f6830", "git_parents": ["1bf67f2b2056cf6fcf34e13adaa6108caa91c6f9"], "node": "926fc87c4a67201bf406c2664340184c9746e330", "parents": ["b32818b6742c647e5a28dcb9a5582e0320a5bc1a"], "tags": []}], "date": 1792510854, "git_changesets": ["7205084093fe5991e6ab5b54cbdd27e7695f6830"], "user": "rvandermeulen@mozilla.com"}, "1037": {"changesets": [{"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 2077162 [esr] - Apply 'glyf' component limit in OTS.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335560\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335563\n", "files": ["gfx/ots/src/glyf.cc"], "git_node": "e6eeafb7693186315da8dcf530423192932c0f11", "git_parents": ["7205084093fe5991e6ab5b54cbdd27e7695f6830"], "node": "303e0e1d0cf0056392c2ea91b7ad15ba2042fa65", "parents": ["926fc87c4a67201bf406c2664340184c9746e330"], "tags": []}], "date": 1792516466, "git_changesets": ["e6eeafb7693186315da8dcf530423192932c0f11"], "user": "rvandermeulen@mozilla.com"}, "1038": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074209 - Attach color-font palette cache to the individual gfxFontEntry for color fonts.  a=RyanVM DONTBUILD\n\nThis is instead of having a shared cache attached to the presContext, and means the\nlifetime of the cache is directly tied to the font entry that owns it.\n\nCache lookups and modifications are guarded by the gfxFontEntry's RWLock.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334249\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335614\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "gfx/src/nsFontMetrics.cpp", "gfx/thebes/FontPaletteCache.cpp", "gfx/thebes/FontPaletteCache.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "layout/generic/TextOverflow.cpp", "layout/generic/nsTextFrame.cpp", "layout/mathml/nsMathMLChar.cpp"], "git_node": "4db2350be786406c9ef4add6435206323710aa4b", "git_parents": ["e6eeafb7693186315da8dcf530423192932c0f11"], "node": "d3c6e4f32a6afdc7eb6740b1faca7cef856bea51", "parents": ["303e0e1d0cf0056392c2ea91b7ad15ba2042fa65"], "tags": []}], "date": 1792516488, "git_changesets": ["4db2350be786406c9ef4add6435206323710aa4b"], "user": "rvandermeulen@mozilla.com"}, "1039": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082000 - Clean up wrapper properly when the initialization fails;  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334911\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335654\n", "files": ["dom/bindings/BindingUtils.h", "dom/bindings/Codegen.py", "dom/bindings/DOMJSProxyHandler.cpp", "dom/bindings/DOMJSProxyHandler.h"], "git_node": "ba09190680a22565061e12c7f96c7819b8489991", "git_parents": ["4db2350be786406c9ef4add6435206323710aa4b"], "node": "4d8d94beff9621d52c91d8acc08289237b9afb0d", "parents": ["d3c6e4f32a6afdc7eb6740b1faca7cef856bea51"], "tags": []}], "date": 1792516512, "git_changesets": ["ba09190680a22565061e12c7f96c7819b8489991"], "user": "rvandermeulen@mozilla.com"}, "1040": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081280.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334807\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335544\n", "files": ["layout/style/Loader.cpp", "testing/web-platform/tests/svg/as-image/external-resource-data-url-import-helper.sub.svg", "testing/web-platform/tests/svg/as-image/external-resource-data-url-import.sub.html"], "git_node": "30d3141aabda520c4378aab4697c473661eca136", "git_parents": ["ba09190680a22565061e12c7f96c7819b8489991"], "node": "2ff843a1411832529432b14d39fbc581ddb7c2bc", "parents": ["4d8d94beff9621d52c91d8acc08289237b9afb0d"], "tags": []}], "date": 1792516536, "git_changesets": ["30d3141aabda520c4378aab4697c473661eca136"], "user": "rvandermeulen@mozilla.com"}, "1041": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082040.  a=RyanVM DONTBUILD\n\nMake sure we're consistent about which state we call\nUpdateEmbeddedBrowsingContextDependentData in.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334853\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335541\n", "files": ["layout/generic/nsSubDocumentFrame.cpp"], "git_node": "4b9a8c32c3f65febebbdb4d83f16fc26da8e4c31", "git_parents": ["30d3141aabda520c4378aab4697c473661eca136"], "node": "e345c31ea4ba2bcd09a90150a80ba8b95db02f80", "parents": ["2ff843a1411832529432b14d39fbc581ddb7c2bc"], "tags": []}], "date": 1792516560, "git_changesets": ["4b9a8c32c3f65febebbdb4d83f16fc26da8e4c31"], "user": "rvandermeulen@mozilla.com"}, "1042": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083514 - Deal with reframes of ancestors of replicated fixed-pos frames.  a=RyanVM DONTBUILD\n\nSo the issue is that esr153 reframes the ::before and that means really\nreframing the originating element entirely, which is _not_ in the\nfixed-pos subtree. The WPT triggers the issue pre-patch on nightly and\ndoesn't depend on us eventually allowing reframing of individual pseudos\n(which is on file).\n\nMove the paginated bail-out sooner since it's the most aggressive one.\nOtherwise I'm guessing that if you hit the multicol case you might still\nbe able to trigger the original issue.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335133\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335547\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "testing/web-platform/meta/css/printing/fixed-generated-content-whitespace-crash-print.html.ini", "testing/web-platform/tests/css/printing/fixed-generated-content-reconstruct-crash-print.html"], "git_node": "f420bd4c35a8131567be82ddee06a5307033b138", "git_parents": ["4b9a8c32c3f65febebbdb4d83f16fc26da8e4c31"], "node": "33ba92423752066eb82be6c04f4ef2891a241978", "parents": ["e345c31ea4ba2bcd09a90150a80ba8b95db02f80"], "tags": []}], "date": 1792516837, "git_changesets": ["f420bd4c35a8131567be82ddee06a5307033b138"], "user": "rvandermeulen@mozilla.com"}, "1043": {"changesets": [{"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082211 - Patch ICU windows zone data for updated time zones  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334748\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335681\n", "files": ["config/external/icu/data/icudt78l.dat", "intl/icu-patches/bug-2082211-CLDR-19827-windows-zones.diff", "intl/icu/source/data/misc/windowsZones.txt", "intl/tzdata/source/be/windowsZones.res", "intl/tzdata/source/le/windowsZones.res", "intl/update-icu.sh"], "git_node": "f2e9a35def104df79c9b6f3cf9858463497c3593", "git_parents": ["f420bd4c35a8131567be82ddee06a5307033b138"], "node": "cbdbe234ad072ada22b5044d6b811538e0376c5c", "parents": ["33ba92423752066eb82be6c04f4ef2891a241978"], "tags": []}], "date": 1792516864, "git_changesets": ["f2e9a35def104df79c9b6f3cf9858463497c3593"], "user": "rvandermeulen@mozilla.com"}, "1044": {"changesets": [{"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Update Lit patches to lit@3.3.3  a=RyanVM\n\nThe bundle-lit.sh script stopped working when we moved to git since it\nused `git patch`, this was now making the paths relative to the firefox\nsource root. It now moves the clone into a temp directory, makes that a\ngit repository and patches it. We could probably do this inline, but\nrunning `git init` in your firefox directory seemed like it could cause\nunwanted side effects if something goes wrong.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D192008\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335645\n", "files": ["toolkit/content/vendor/lit/0001-disable-terser-step.patch", "toolkit/content/vendor/lit/0002-use-DOMParser-not-innerHTML.patch", "toolkit/content/vendor/lit/0003-Disable-source-maps.patch", "toolkit/content/vendor/lit/0004-Remove-the-bundled-warning.patch", "toolkit/content/vendor/lit/0005-Bug-1808741-Do-not-set-style-attributes-when-using-s.patch", "toolkit/content/vendor/lit/0006-Don-t-modify-Symbol-for-Symbol.metadata-polyfill.patch", "toolkit/content/vendor/lit/README.md", "toolkit/content/vendor/lit/bundle-lit.sh"], "git_node": "41ef2d37423e8abe158c2185528f998d8dc8da9b", "git_parents": ["f2e9a35def104df79c9b6f3cf9858463497c3593"], "node": "fd975cf630d6af0faca5335fd99da349663ac3f6", "parents": ["cbdbe234ad072ada22b5044d6b811538e0376c5c"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Update Lit to lit@3.3.3  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D192009\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335646\n", "files": ["package-lock.json", "package.json", "toolkit/content/vendor/lit/moz.yaml", "toolkit/content/widgets/vendor/lit.all.mjs"], "git_node": "8960764e4a222a52b85b2b2116b63077e49e3239", "git_parents": ["41ef2d37423e8abe158c2185528f998d8dc8da9b"], "node": "2be64328a685f7414980affe5cd07720a538acd3", "parents": ["fd975cf630d6af0faca5335fd99da349663ac3f6"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1861496 - Fixes for Lit upgrade  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319226\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335647\n", "files": ["browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multistage_mr.js", "browser/components/preferences/tests/search/browser_searchChangedEngine.js", "browser/components/preferences/tests/search/browser_search_userEngineDialog.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_tab_interactions_telemetry.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_about_opentabs.js"], "git_node": "44d45980bcb80ea415a7f230155265a38acea75f", "git_parents": ["8960764e4a222a52b85b2b2116b63077e49e3239"], "node": "3c4c27d24db474145f72a0d6da0c01c33f06a589", "parents": ["2be64328a685f7414980affe5cd07720a538acd3"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058614 - Part 1: Update Lit patches  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333413\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335648\n", "files": ["toolkit/content/vendor/lit/0001-disable-terser-step.patch", "toolkit/content/vendor/lit/0002-use-DOMParser-not-innerHTML.patch", "toolkit/content/vendor/lit/0003-Disable-source-maps.patch", "toolkit/content/vendor/lit/0004-Remove-the-bundled-warning.patch", "toolkit/content/vendor/lit/0005-Bug-1808741-Do-not-set-style-attributes-when-using-s.patch", "toolkit/content/vendor/lit/0006-Don-t-modify-Symbol-for-Symbol.metadata-polyfill.patch", "toolkit/content/vendor/lit/0007-Freeze-template-literals-to-match-the-spec.patch"], "git_node": "f5e6587465eddea7278b12892ed2effa112bbc0e", "git_parents": ["44d45980bcb80ea415a7f230155265a38acea75f"], "node": "06f5a395c796b84f90399e0b9efb498407ae040f", "parents": ["3c4c27d24db474145f72a0d6da0c01c33f06a589"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058614 - Part 2: Build Lit  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333414\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335649\n", "files": ["toolkit/content/widgets/vendor/lit.all.mjs"], "git_node": "b418ac05cb17a810bd5aaa772a1f577d315534f0", "git_parents": ["f5e6587465eddea7278b12892ed2effa112bbc0e"], "node": "538f94fa52509c2157e66dfaef1a6a619603c34e", "parents": ["06f5a395c796b84f90399e0b9efb498407ae040f"], "tags": []}], "date": 1792528617, "git_changesets": ["41ef2d37423e8abe158c2185528f998d8dc8da9b", "8960764e4a222a52b85b2b2116b63077e49e3239", "44d45980bcb80ea415a7f230155265a38acea75f", "f5e6587465eddea7278b12892ed2effa112bbc0e", "b418ac05cb17a810bd5aaa772a1f577d315534f0"], "user": "rvandermeulen@mozilla.com"}, "1045": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Cherry-pick upstream libwebrtc commit 5a7e0ff57a  a=RyanVM DONTBUILD\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5a7e0ff57a52e12f834d64c57d040d1105ea17f2\n       [M149] Cap RTCConfiguration certificates and enforce 32-bit overflow checks\n\n       1. Bounded the maximum number of certificates in RTCConfiguration to\n          1000 to prevent reference counter overflow while maintaining ample\n          headroom for legitimate multi-algorithm DTLS interoperability.\n       2. Updated webrtc_impl::RefCounter to declare IncRef() out-of-line\n          unconditionally across all architectures.\n       3. Implemented RefCounter::IncRef() out-of-line in ref_counter.cc with\n          an explicit RTC_CHECK_LT(prev, INT_MAX) guard on all architectures,\n          preventing 32-bit integer overflow and Use-After-Free vulnerabilities\n          unconditionally without causing inlined binary bloat.\n\n       (cherry picked from commit 34505048c030ee72ad6ee99f46534861ebb0e365)\n\n       Bug: chromium:513154132\n       Fixed: chromium:513154132, chromium:514928807\n       Change-Id: I9894ef08519423b24139b0250cc9da0f9737827a\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/472722\n       Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n       Cr-Original-Commit-Position: refs/heads/main@{#47722}\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/475720\n       Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n       Cr-Commit-Position: refs/branch-heads/7827@{#4}\n       Cr-Branched-From: d606bc991592fbf4dcbe85e9d05db5e501a5ad42-refs/heads/main@{#47595}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335522\n", "files": ["third_party/libwebrtc/api/peer_connection_interface.h", "third_party/libwebrtc/moz-patch-stack/5a7e0ff57a.no-op-cherry-pick-msg", "third_party/libwebrtc/pc/peer_connection_factory.cc", "third_party/libwebrtc/rtc_base/BUILD.gn", "third_party/libwebrtc/rtc_base/ref_counter.cc", "third_party/libwebrtc/rtc_base/ref_counter.h"], "git_node": "cf71546a792b6988a89e241b479e7eb1ab75023a", "git_parents": ["b418ac05cb17a810bd5aaa772a1f577d315534f0"], "node": "9f360f84ec2f317191459b8748c76090dcaaceb0", "parents": ["538f94fa52509c2157e66dfaef1a6a619603c34e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Cherry-pick upstream libwebrtc commit 5a7e0ff57a - moz.build file updates.  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335523\n", "files": ["third_party/libwebrtc/rtc_base/refcount_gn/moz.build"], "git_node": "26508d8b5ed6f1b6d416e459f338f14b8f454713", "git_parents": ["cf71546a792b6988a89e241b479e7eb1ab75023a"], "node": "d835f05932b5303ee37277483764687ced93f092", "parents": ["9f360f84ec2f317191459b8748c76090dcaaceb0"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Cherry-pick upstream libwebrtc commit e8b4d4c595  a=RyanVM DONTBUILD\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e8b4d4c5952a8fb7b35c2a6cba4e8c3de2ea2e1e\n       [M149] Add better checks for temporal/spatial bounds in EncoderBitrateAdjuster.\n\n       Original change's description:\n       \u003e Add better checks for temporal/spatial bounds in EncoderBitrateAdjuster.\n       \u003e\n       \u003e Bug: webrtc:514671098\n       \u003e Change-Id: If3cfb55bdc03d57760a5d30fc63ca63ed321fad1\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/474681\n       \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       \u003e Reviewed-by: Philip Eliasson \u003cphilipel@webrtc.org\u003e\n       \u003e Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       \u003e Commit-Queue: Philip Eliasson \u003cphilipel@webrtc.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#47775}\n\n       (cherry picked from commit 1ad94cdd43c06cbf1cfcdec665b83671fd287a5b)\n\n       Bug: chromium:516658686,webrtc:514671098\n       Change-Id: If3cfb55bdc03d57760a5d30fc63ca63ed321fad1\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/476800\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n       Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Cr-Commit-Position: refs/branch-heads/7827@{#5}\n       Cr-Branched-From: d606bc991592fbf4dcbe85e9d05db5e501a5ad42-refs/heads/main@{#47595}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335524\n", "files": ["third_party/libwebrtc/moz-patch-stack/e8b4d4c595.no-op-cherry-pick-msg", "third_party/libwebrtc/video/encoder_bitrate_adjuster.cc", "third_party/libwebrtc/video/encoder_bitrate_adjuster_unittest.cc"], "git_node": "2f027d4427699e7521e1002cd23225cb9c4e5f8e", "git_parents": ["26508d8b5ed6f1b6d416e459f338f14b8f454713"], "node": "365a7774ef6b07e1a4290dfcb099ae647d6cd1db", "parents": ["d835f05932b5303ee37277483764687ced93f092"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Cherry-pick upstream libwebrtc commit 6987eb721b  a=RyanVM DONTBUILD\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6987eb721b340bbddbb9bdf53682483f03a08598\n       [M149] [WGC] Fix frame size synchronization\n\n       Original change's description:\n       \u003e [WGC] Fix frame size synchronization\n       \u003e\n       \u003e Fixes a scenario where the mapped_texture_ and frame_pool_ sizes of the\n       \u003e WGC capturer could get out of sync and potentially bypass their\n       \u003e reconciliation on the following frame.\n       \u003e\n       \u003e Fixed: chromium:517727318\n       \u003e Change-Id: Ie4e951bbdf41491200b7ba1289f85e4c02bc22d1\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/476860\n       \u003e Commit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\n       \u003e Auto-Submit: Alexander Cooper \u003calcooper@chromium.org\u003e\n       \u003e Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#47898}\n\n       (cherry picked from commit b5cf1fa607113788cf894d5b6895c72fba1d9254)\n\n       Bug: chromium:520653469,chromium:517727318\n       Change-Id: Ie4e951bbdf41491200b7ba1289f85e4c02bc22d1\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/479900\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n       Cr-Commit-Position: refs/branch-heads/7827@{#6}\n       Cr-Branched-From: d606bc991592fbf4dcbe85e9d05db5e501a5ad42-refs/heads/main@{#47595}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335525\n", "files": ["third_party/libwebrtc/modules/desktop_capture/win/wgc_capture_session.cc", "third_party/libwebrtc/moz-patch-stack/6987eb721b.no-op-cherry-pick-msg"], "git_node": "5deb4e437396907ab47719122624d35b7a7f115a", "git_parents": ["2f027d4427699e7521e1002cd23225cb9c4e5f8e"], "node": "f5fe711a671233efcc151fd41df903bf3ced47d0", "parents": ["365a7774ef6b07e1a4290dfcb099ae647d6cd1db"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Cherry-pick upstream libwebrtc commit 28311abc14  a=RyanVM DONTBUILD\n\nUpstream commit: https://webrtc.googlesource.com/src/+/28311abc149a9bb7e6761a3d54f362a8d77e6793\n       [M149] Fix OOB write in RotateDesktopFrame and DXGI size mismatch\n\n       Original change's description:\n       \u003e Fix OOB write in RotateDesktopFrame and DXGI size mismatch\n       \u003e\n       \u003e Upgrade RTC_DCHECK to RTC_CHECK in RotateDesktopFrame to enforce\n       \u003e bounds checks in release builds. Validate captured frame size against\n       \u003e expected unrotated size in DxgiOutputDuplicator::Duplicate to fail\n       \u003e gracefully on resolution changes.\n       \u003e\n       \u003e Fixed: chromium:520199394\n       \u003e Change-Id: Iad22c89cf3ef900b0ac58a72ec3a9f8d2e96123b\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/479000\n       \u003e Auto-Submit: Alexander Cooper \u003calcooper@chromium.org\u003e\n       \u003e Commit-Queue: Alexander Cooper \u003calcooper@chromium.org\u003e\n       \u003e Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#47937}\n\n       (cherry picked from commit 15644107234aa9bc7a4bf7e9f9a2157a8a9415b4)\n\n       Bug: chromium:522134600,chromium:520199394\n       Change-Id: Iad22c89cf3ef900b0ac58a72ec3a9f8d2e96123b\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/480600\n       Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Auto-Submit: Chrome Cherry Picker \u003cchrome-cherry-picker@chops-service-accounts.iam.gserviceaccount.com\u003e\n       Cr-Commit-Position: refs/branch-heads/7827@{#7}\n       Cr-Branched-From: d606bc991592fbf4dcbe85e9d05db5e501a5ad42-refs/heads/main@{#47595}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335526\n", "files": ["third_party/libwebrtc/modules/desktop_capture/desktop_frame_rotation.cc", "third_party/libwebrtc/modules/desktop_capture/win/dxgi_output_duplicator.cc", "third_party/libwebrtc/moz-patch-stack/28311abc14.no-op-cherry-pick-msg"], "git_node": "571a76e10944b1ce92dd7dbf450ca233362e4e5a", "git_parents": ["5deb4e437396907ab47719122624d35b7a7f115a"], "node": "9db36498b9dbee2e2043db0739cd7662ab567390", "parents": ["f5fe711a671233efcc151fd41df903bf3ced47d0"], "tags": []}], "date": 1792530878, "git_changesets": ["cf71546a792b6988a89e241b479e7eb1ab75023a", "26508d8b5ed6f1b6d416e459f338f14b8f454713", "2f027d4427699e7521e1002cd23225cb9c4e5f8e", "5deb4e437396907ab47719122624d35b7a7f115a", "571a76e10944b1ce92dd7dbf450ca233362e4e5a"], "user": "rvandermeulen@mozilla.com"}, "1046": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078398 - Release the Glean store in the crash reporter client once its crash ping is sent.  a=RyanVM DONTBUILD\n\nThe client held the Glean store lock until it exited, so a crash ping sent by\nthe restarted Firefox waited for the crash reporter UI to close and the report\nto be submitted, and could hang shutdown in the meantime.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331126\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335783\n", "files": ["toolkit/crashreporter/client/app/src/logic.rs", "toolkit/crashreporter/client/app/src/main.rs"], "git_node": "58b3a1e1f63be0129fd243f83e9d3cee3437112d", "git_parents": ["571a76e10944b1ce92dd7dbf450ca233362e4e5a"], "node": "70d93d5fcb2fdf1a65cb4808fb393b8ac541ba15", "parents": ["9db36498b9dbee2e2043db0739cd7662ab567390"], "tags": []}], "date": 1792530904, "git_changesets": ["58b3a1e1f63be0129fd243f83e9d3cee3437112d"], "user": "rvandermeulen@mozilla.com"}, "1047": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059961: Re-dispatch stale WebTransportSessionProxy callbacks after RetargetTo.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327151\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335786\n", "files": ["dom/webtransport/parent/WebTransportParent.cpp", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp"], "git_node": "4e5d7eb2820d28bfd7336c11a4d1235984e66e5b", "git_parents": ["58b3a1e1f63be0129fd243f83e9d3cee3437112d"], "node": "cddce8bd6b49c1e9424a00b280613fc9ff05eca9", "parents": ["70d93d5fcb2fdf1a65cb4808fb393b8ac541ba15"], "tags": []}], "date": 1792530927, "git_changesets": ["4e5d7eb2820d28bfd7336c11a4d1235984e66e5b"], "user": "rvandermeulen@mozilla.com"}, "1048": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082044.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335387\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335810\n", "files": ["layout/style/nsDOMCSSAttrDeclaration.cpp", "layout/style/test/mochitest.toml", "layout/style/test/test_inline_style_cc.html"], "git_node": "2eb91d754b135d4f8c74e1602a76191af9dcf840", "git_parents": ["4e5d7eb2820d28bfd7336c11a4d1235984e66e5b"], "node": "bb3573440f45849bd415b831cc754bc518f5af42", "parents": ["cddce8bd6b49c1e9424a00b280613fc9ff05eca9"], "tags": []}], "date": 1792538756, "git_changesets": ["2eb91d754b135d4f8c74e1602a76191af9dcf840"], "user": "rvandermeulen@mozilla.com"}, "1049": {"changesets": [{"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082868 - Disable the Suggest Merino backend when \"Suggestions from Firefox\" is unchecked.  a=RyanVM\n\nGate the Merino backend on `suggest.quicksuggest.all`.\n\nWhile I'm here, I added the same gate to the ML backend and added a comment to\nthe Rust backend about why it shouldn't be gated.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335303\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335823\n", "files": ["browser/components/urlbar/private/SuggestBackendMerino.sys.mjs", "browser/components/urlbar/private/SuggestBackendMl.sys.mjs", "browser/components/urlbar/private/SuggestBackendRust.sys.mjs", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_merino.js", "browser/components/urlbar/tests/quicksuggest/unit/test_suggestBackendMl.js"], "git_node": "4484e62e742bf7be57f0267189a82e24bc0fc1ac", "git_parents": ["2eb91d754b135d4f8c74e1602a76191af9dcf840"], "node": "1b2f44afb1555fb119a27c92b2c479777575700d", "parents": ["bb3573440f45849bd415b831cc754bc518f5af42"], "tags": ["FIREFOX_153_6_0esr_BUILD1"]}], "date": 1792538781, "git_changesets": ["4484e62e742bf7be57f0267189a82e24bc0fc1ac"], "user": "rvandermeulen@mozilla.com"}, "1050": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 1b2f44afb1555fb119a27c92b2c479777575700d with FIREFOX_153_6_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ded217e51993fb5e132038d95b552fe8c3fbc34d", "git_parents": ["9dd7a51abddd1e2dd34d82490318e914f2b18121"], "node": "507e5bf0bca6a78b8f4423cc754e3660e8dd7caf", "parents": ["3c559d110a9ddec32bd099ab7ce557cdc83b9748"], "tags": []}], "date": 1792548300, "git_changesets": ["ded217e51993fb5e132038d95b552fe8c3fbc34d"], "user": "ffxbld@lando.moz.tools"}, "1051": {"changesets": [{"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2083267 - Ignore the zip extraction advisories in cargo-audit until zip is upgraded r=supply-chain-reviewers,afranchuk a=NPOTB DONTBUILD\n\nRUSTSEC-2026-0367, RUSTSEC-2026-0368 and RUSTSEC-2026-0369 are about\nZipArchive::extract() and ZipStreamReader::extract(). Neither geckodriver\nnor the crash reporter client calls them. Drop these waivers with the\nzip 9 upgrade in this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335970\n", "files": [".cargo/audit.toml"], "git_node": "c0306f435e18d8f22b5aea114b27d96938d3238f", "git_parents": ["4484e62e742bf7be57f0267189a82e24bc0fc1ac"], "node": "401e60c9419ebef1bd2456d8076e1b5959dfeac2", "parents": ["1b2f44afb1555fb119a27c92b2c479777575700d"], "tags": []}], "date": 1792674298, "git_changesets": ["c0306f435e18d8f22b5aea114b27d96938d3238f"], "user": "rvandermeulen@mozilla.com"}, "1052": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update remote-settings tld-suffixes ct-logs - a=RyanVM\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "48ef913b04179aa9f01a8312ec1f1b28f9772e43", "git_parents": ["c0306f435e18d8f22b5aea114b27d96938d3238f"], "node": "41c9e30c12a2e3b3724d968a5d3d1ffc27bb5435", "parents": ["401e60c9419ebef1bd2456d8076e1b5959dfeac2"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084311 - ensure OneCRL bundle is loaded at init a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335790\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335837\n", "files": ["security/manager/ssl/RemoteSecuritySettings.sys.mjs", "security/manager/ssl/tests/unit/test_onecrl_loads_bundle.js", "security/manager/ssl/tests/unit/xpcshell.toml"], "git_node": "848b0ae1c82c929c8a5ed5747455df8659deb364", "git_parents": ["48ef913b04179aa9f01a8312ec1f1b28f9772e43"], "node": "6959450fc062303dc290e6bdaf9d31942246bb45", "parents": ["41c9e30c12a2e3b3724d968a5d3d1ffc27bb5435"], "tags": []}], "date": 1792675031, "git_changesets": ["48ef913b04179aa9f01a8312ec1f1b28f9772e43", "848b0ae1c82c929c8a5ed5747455df8659deb364"], "user": "rvandermeulen@mozilla.com"}, "1053": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046558 - Rework active session history entry updates from content. r=asuth,smaug a=RyanVM\n\nSet/ReplaceActiveSessionHistoryEntry now require the sender's WindowContext\nas an argument and the parent creates shared state using the\nWindowGlobalParent instead of the content's copy.\n\nEach WindowGlobalParent now records the session history load that produced it,\nif any.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D306114\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336238\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "docshell/shistory/SessionHistoryEntry.cpp", "docshell/shistory/SessionHistoryEntry.h", "docshell/shistory/nsSHEntryShared.h", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/ipc/ParentProcessChannelHandle.cpp", "dom/ipc/ParentProcessChannelHandle.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "a34c4160e3f75ab9918fbe4669ff7ae56f1977c8", "git_parents": ["848b0ae1c82c929c8a5ed5747455df8659deb364"], "node": "d63de7b9609253a860fbb0050f678700f4cdc492", "parents": ["6959450fc062303dc290e6bdaf9d31942246bb45"], "tags": ["FIREFOX_153_6_0esr_BUILD2", "FIREFOX_153_6_0esr_RELEASE"]}], "date": 1792703807,