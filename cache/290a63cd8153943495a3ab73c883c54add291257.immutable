"files": ["dom/webidl/CSSRule.webidl", "dom/webidl/CSSStyleDeclaration.webidl", "layout/style/Rule.cpp", "layout/style/Rule.h", "layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h", "layout/style/nsICSSDeclaration.cpp", "layout/style/nsICSSDeclaration.h"], "git_node": "52b8272ca66420d5cfa00f5adc062b1908abbf12", "git_parents": ["3e69459d0ccb3e3089cd9ceafba1822cab7306b1"], "node": "aee9089a6d8247714462b9a1a3ebf7470ea68613", "parents": ["e6b07d23d0fcf887e4bba12571a89e6312dffd9f"], "tags": []}], "date": 1791654939, "git_changesets": ["52b8272ca66420d5cfa00f5adc062b1908abbf12"], "user": "rvandermeulen@mozilla.com"}, "830": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2078981.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332254\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332514\n", "files": ["layout/generic/TextOverflow.cpp", "testing/web-platform/tests/css/css-overflow/text-overflow-root-textarea-crash.xhtml"], "git_node": "3a13f28ca8856e768d6f37f079cc268d42ea4611", "git_parents": ["52b8272ca66420d5cfa00f5adc062b1908abbf12"], "node": "1e3e1b00e75a535325d31d2ceacd93124df02ce1", "parents": ["aee9089a6d8247714462b9a1a3ebf7470ea68613"], "tags": []}], "date": 1791654961, "git_changesets": ["3a13f28ca8856e768d6f37f079cc268d42ea4611"], "user": "rvandermeulen@mozilla.com"}, "831": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079032 - Use RefPtrs for submit elements.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332169\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332504\n", "files": ["dom/html/HTMLFormElement.cpp", "dom/html/HTMLFormElement.h"], "git_node": "85814f8c5761b5f6322a1d40c78b356da48c9fb6", "git_parents": ["3a13f28ca8856e768d6f37f079cc268d42ea4611"], "node": "e52501a196993d9ea69d14529660c138761178ef", "parents": ["1e3e1b00e75a535325d31d2ceacd93124df02ce1"], "tags": []}], "date": 1791654994, "git_changesets": ["85814f8c5761b5f6322a1d40c78b356da48c9fb6"], "user": "rvandermeulen@mozilla.com"}, "832": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2079709  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332265\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332599\n", "files": ["dom/base/Document.h", "dom/base/nsDataDocumentContentPolicy.cpp"], "git_node": "da6e0acae18e8ed2fc928775c25b4c40eab9ddd6", "git_parents": ["85814f8c5761b5f6322a1d40c78b356da48c9fb6"], "node": "c7901ce017e4578db1ad78ed0fd9b36717b99210", "parents": ["e52501a196993d9ea69d14529660c138761178ef"], "tags": []}], "date": 1791655015, "git_changesets": ["da6e0acae18e8ed2fc928775c25b4c40eab9ddd6"], "user": "rvandermeulen@mozilla.com"}, "833": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2079924 - Check for NS_STATE_SVG_TEXT_CORRESPONDENCE_DIRTY too  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332190\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332597\n", "files": ["layout/generic/nsIFrame.cpp", "layout/svg/SVGObserverUtils.cpp", "testing/web-platform/tests/svg/text/crashtests/unicode-bidi-crash.html"], "git_node": "751db545a61c61029f908e219ad53aed69303230", "git_parents": ["da6e0acae18e8ed2fc928775c25b4c40eab9ddd6"], "node": "a8686f9342246614050f909b6b3bf8bd2a5869db", "parents": ["c7901ce017e4578db1ad78ed0fd9b36717b99210"], "tags": []}], "date": 1791655039, "git_changesets": ["751db545a61c61029f908e219ad53aed69303230"], "user": "rvandermeulen@mozilla.com"}, "834": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079155 - Add FinalizationRegistry registration after unwrapping the target.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332326\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332668\n", "files": ["js/src/builtin/FinalizationRegistryObject.cpp"], "git_node": "c5f138d1eb4812a420f53189704222dc5aa2b1d2", "git_parents": ["751db545a61c61029f908e219ad53aed69303230"], "node": "0c3a030d757336e940acc9ddf3ca7c2f77c62948", "parents": ["a8686f9342246614050f909b6b3bf8bd2a5869db"], "tags": []}], "date": 1791655062, "git_changesets": ["c5f138d1eb4812a420f53189704222dc5aa2b1d2"], "user": "rvandermeulen@mozilla.com"}, "835": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076875 - Serialize requests to the shared fix-stacks process.  a=RyanVM\n\nTest harnesses call fixSymbols from several threads, e.g. parallel xpcshell\ntests and self-tests. Unserialized, a thread can read another thread's answer\nor none at all, which garbles or hangs stack fixing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330900\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332702\n", "files": ["taskcluster/kinds/source-test/python.yml", "tools/moz.build", "tools/rb/fix_stacks.py", "tools/rb/test/python.toml", "tools/rb/test/test_fix_stacks_threads.py"], "git_node": "025ba05b79b887a642f1a8e2e0e375aa0eacea8f", "git_parents": ["c5f138d1eb4812a420f53189704222dc5aa2b1d2"], "node": "2545fd9fcb4e524535ea733e21ed7ac93c909d3d", "parents": ["0c3a030d757336e940acc9ddf3ca7c2f77c62948"], "tags": []}], "date": 1791666914, "git_changesets": ["025ba05b79b887a642f1a8e2e0e375aa0eacea8f"], "user": "rvandermeulen@mozilla.com"}, "836": {"changesets": [{"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019860 - Make `mach coverage-report` use the latest mozilla-central push with finished coverage tasks a=test-only\n\nWhen no --branch/--revision is passed, `mach coverage-report` used the very latest mozilla-central decision task. On that push the ccov test tasks are almost always still unscheduled or running, so the command polled every 60s waiting for them. That makes test_coverage_report_latest_push_gtest hit its 600s subprocess timeout. For example, on the current latest push (pushlog-id 45525), test-linux2404-64-ccov/opt-gtest-1proc is `unscheduled`, as are 458 of the 467 ccov tasks.\n\nThe command now walks back through the most recent mozilla-central pushes, using the `gecko.v2.mozilla-central.pushlog-id.\u003cN\u003e.decision` index and checking at most 30 pushes. It uses the first push whose matching ccov tasks have all finished. Explicit --branch/--revision keeps the old behaviour of waiting for the tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332216\n", "files": ["tools/code-coverage/mach_commands.py"], "git_node": "d7a323f908a46cf09ba2ce3f29f3260d3573e24a", "git_parents": ["025ba05b79b887a642f1a8e2e0e375aa0eacea8f"], "node": "d342f96387a6b70f9206bcc2fd30da5c25d3b1ac", "parents": ["2545fd9fcb4e524535ea733e21ed7ac93c909d3d"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079994 - Make mach coverage-report recognize the Android platform. a=test-only\n\n`_get_platform` in tools/code-coverage/mach_commands.py didn't recognize Android task names. So `mach coverage-report --suite gtest` raised \"Unknown platform for test-android-em-14-x86_64-ccov/opt-geckoview-gtest-1proc\".\n\nThe fix checks for \"android\" before the other platform substring checks. It also lists the accepted values in the `--platform` help text, and adds an offline unit test for `_get_platform`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332248\n", "files": ["tools/code-coverage/mach_commands.py", "tools/code-coverage/tests/python/test_mach_commands.py"], "git_node": "cccbf9e4bc68caaedbbe30623f004f2e09f6b142", "git_parents": ["d7a323f908a46cf09ba2ce3f29f3260d3573e24a"], "node": "4cdfb82e132466713065b01b82005e6a3a859c5a", "parents": ["d342f96387a6b70f9206bcc2fd30da5c25d3b1ac"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2001799 - Make the cargo-audit lint test resilient to advisory database changes. a=test-only\n\nThe test runs against the live RustSec advisory database, so the exact\nnumber of advisories matching the checked-in .lock fixtures changes over\ntime as new advisories are published. Assert only that the known set of\nadvisories is present instead of an exact count, and surface guidance to\nfile a new bug blocking bug 1747536 rather than treating the failure as a\nbackout-able regression.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313013\n", "files": ["tools/lint/test/test_cargo-audit.py"], "git_node": "0788163125cb8082c67f49870e8359f6830627bd", "git_parents": ["cccbf9e4bc68caaedbbe30623f004f2e09f6b142"], "node": "fda04d4e3211df6fc27753e9cabe4d970757cc3d", "parents": ["4cdfb82e132466713065b01b82005e6a3a859c5a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2001799 - Improve the cargo-audit linter error message when the advisory database can't be loaded. a=test-only\n\nA non-zero exit code with no output usually means cargo-audit could not\nload the RustSec advisory database (for example because it contains an\nadvisory in a format the pinned cargo-audit version cannot parse). Make\nthe failure readable and point at bug 1747536 so it isn't mistaken for a\nregression caused by a specific push.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313014\n", "files": ["tools/lint/cargo-audit/__init__.py"], "git_node": "5ccc6456bd568f450127c4bd2b8e0ee1fed7e863", "git_parents": ["0788163125cb8082c67f49870e8359f6830627bd"], "node": "606a300f513f725e6cf31eefb2d5a0262cb9746d", "parents": ["fda04d4e3211df6fc27753e9cabe4d970757cc3d"], "tags": []}], "date": 1791673880, "git_changesets": ["d7a323f908a46cf09ba2ce3f29f3260d3573e24a", "cccbf9e4bc68caaedbbe30623f004f2e09f6b142", "0788163125cb8082c67f49870e8359f6830627bd", "5ccc6456bd568f450127c4bd2b8e0ee1fed7e863"], "user": "rvandermeulen@mozilla.com"}, "837": {"changesets": [{"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2074018 - Ignore RUSTSEC-2026-0293 for ringbuf. a=RyanVM\n\nThe advisory reports a double free in Consumer::skip and Consumer::clear\nwhen an element's Drop panics. Gecko vendors ringbuf 0.2.8, where the\nequivalent entry point is Consumer::discard: it drops the elements inside\nthe pop_access closure, and pop_access only stores the new head after the\nclosure returns, so a panic leaves the read index on already-dropped slots.\n\nThe bug is not reachable here. The only callers of discard are in\ncubeb-coreaudio's buffer_manager, on Consumer\u003ci16\u003e and Consumer\u003cf32\u003e;\ncubeb-pulse instantiates the same two element types and never calls\ndiscard. Primitive elements have no destructor, so no Drop can panic.\n\nFixing this for real means moving to ringbuf 0.5, an API break that has to\nland upstream in cubeb-coreaudio-rs and cubeb-pulse-rs first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327856\n", "files": [".cargo/audit.toml"], "git_node": "fbebcb07afee664dc0b463db3c933cf2b41fa7a0", "git_parents": ["5ccc6456bd568f450127c4bd2b8e0ee1fed7e863"], "node": "b8b648caa58b4861f7d47fa61555dc75b41512a8", "parents": ["606a300f513f725e6cf31eefb2d5a0262cb9746d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1777028 - Fix intermittent test_upgrade_insecure.html a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306710\n", "files": ["dom/security/test/csp/file_upgrade_insecure_server.sjs", "dom/security/test/csp/mochitest.toml"], "git_node": "5df6e72fa4c7f36f1959d2e7cb601de266999f74", "git_parents": ["fbebcb07afee664dc0b463db3c933cf2b41fa7a0"], "node": "b194692c1c69ecd1c7368833a28c22b113ce13ee", "parents": ["b8b648caa58b4861f7d47fa61555dc75b41512a8"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1777028 - Skip test_upgrade_insecure.html for h2 and h3 tests a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306959\n", "files": ["dom/security/test/csp/mochitest.toml"], "git_node": "67dd1ea37f8fc623684bbafa7274ab332d3deed9", "git_parents": ["5df6e72fa4c7f36f1959d2e7cb601de266999f74"], "node": "7bbd6a28d0f12de0dccf0dd6e002c9c198821169", "parents": ["b194692c1c69ecd1c7368833a28c22b113ce13ee"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1883976 - Disable browser_glean_first_frame_loaded_time.js on Windows asan for frequent failures. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310825\n", "files": ["dom/media/test/browser/browser.toml"], "git_node": "489b08278f0ae09e47a77f7ff27cffc7cc9094da", "git_parents": ["67dd1ea37f8fc623684bbafa7274ab332d3deed9"], "node": "68d22bd6de4a9d0a885ba5e23c41f8189b9aec3f", "parents": ["7bbd6a28d0f12de0dccf0dd6e002c9c198821169"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037298 - [devtools] Wait for debug-target-info in browser_about-devtools-toolbox_reload.js a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314165\n", "files": ["devtools/client/framework/test/browser_about-devtools-toolbox_reload.js"], "git_node": "30befa666b5a568e87d916b5609f3281813aeb10", "git_parents": ["489b08278f0ae09e47a77f7ff27cffc7cc9094da"], "node": "afecc0818af311e44fc80d97d862a9c7b7658736", "parents": ["68d22bd6de4a9d0a885ba5e23c41f8189b9aec3f"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012360 - Allow some leeway in framerate measurements and improve accuracy. a=test-only\n\nSince everything is async we can sometimes end up with slightly more than the\nrequested number of frames in a second. Also the precision of setTimeout is not\nguaranteed, so measure the period during which we counted frames, for improved\naccuracy.\n\nThis also fixes a destructuring/nesting issue that resulted in us skipping the framerate\nchecks in one test case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316484\n", "files": ["testing/web-platform/mozilla/tests/mediacapture-streams/video-test-helper.js", "testing/web-platform/mozilla/tests/screen-capture/MediaStreamTrack-independent-clones.https.html"], "git_node": "a9f124df2e5a4914f1fd3dcd97077273cdbee49b", "git_parents": ["30befa666b5a568e87d916b5609f3281813aeb10"], "node": "bc117fc6902752d09dacad674d34e1a856caf828", "parents": ["afecc0818af311e44fc80d97d862a9c7b7658736"], "tags": []}, {"author": "hanna.alemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1930141 - Fix feature callout intermittent failure a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317083\n", "files": ["browser/components/asrouter/tests/browser/browser_feature_callout_in_chrome.js"], "git_node": "9c17b5f0d507ddabc98fb5255e80e27fedd54520", "git_parents": ["a9f124df2e5a4914f1fd3dcd97077273cdbee49b"], "node": "4c20ce8c38a19cc0d52ed45befcd966cf720e6a5", "parents": ["bc117fc6902752d09dacad674d34e1a856caf828"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2062273 - XPCshell tests for MSIX must also target Windows 25H2. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317538\n", "files": ["taskcluster/kinds/test/xpcshell.yml"], "git_node": "ae59e82794cfa7ade9dae3390b12627cde05e86e", "git_parents": ["9c17b5f0d507ddabc98fb5255e80e27fedd54520"], "node": "09bd820b173fc0f2ebd9ff0d20ffff43bb73ebaf", "parents": ["4c20ce8c38a19cc0d52ed45befcd966cf720e6a5"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062273 - Skip the happy eyeballs 0-RTT xpcshell tests on Windows MSIX. a=test-only\n\ntest_happy_eyeballs_h1_0rtt.js and test_happy_eyeballs_h2_0rtt.js hang in their\nsetup under MSIX: asyncStartTLSTestServer launches ZeroRttAcceptServer, which has\nto connect back into the xpcshell process's own loopback listener, and that\ninbound callback never arrives. The setup stays blocked on the serverReady promise\nuntil the harness kills the process, so the tests time out without running a task.\n\nThese two tests started running on Windows MSIX when the xpcshell msix variant\nmoved to Windows 25H2, and have never passed there. Widen the existing\nThunderbird-only skip to all MSIX builds, matching the other tests that use\nasyncStartTLSTestServer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318894\n", "files": ["netwerk/test/unit/xpcshell.toml"], "git_node": "133d68ed15a09535262c44270a6f5b73eedbc592", "git_parents": ["ae59e82794cfa7ade9dae3390b12627cde05e86e"], "node": "31b9793e59d3884ccd5af227fa5d8cba067cac5c", "parents": ["09bd820b173fc0f2ebd9ff0d20ffff43bb73ebaf"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054163 - [devtools] Wait for scroll to stabilize in browser_webconsole_console_group_open_no_scroll.js a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320034\n", "files": ["devtools/client/webconsole/test/browser/browser_webconsole_console_group_open_no_scroll.js"], "git_node": "22844ee8a0b30c34a69d30c61ce2da65b0eb66f8", "git_parents": ["133d68ed15a09535262c44270a6f5b73eedbc592"], "node": "b2f40fe753cc109f292aec71d2c05da246fafab1", "parents": ["31b9793e59d3884ccd5af227fa5d8cba067cac5c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2032977 - Use synthesizeClickOnSelectedTreeCell to open the context menu in browser_forgetthissite.js a=test-only\n\nThe hand-rolled coordinates are computed before the freshly opened Library\nwindow's tree has a non-zero width, so the right-click misses the tree and the\ncontext menu never opens. Bug 2029541 added that wait to the shared helper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320348\n", "files": ["browser/components/places/tests/browser/browser_forgetthissite.js"], "git_node": "f508db63c8554945a09b0a15d9d8a9caec0bec09", "git_parents": ["22844ee8a0b30c34a69d30c61ce2da65b0eb66f8"], "node": "b9692e45015696cd3887c7360e3058f7d3d2b5e7", "parents": ["b2f40fe753cc109f292aec71d2c05da246fafab1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2002142 - Fix a race in browser_ext_pageAction_contextMenu.js that could make it wait forever for the page action popup a=test-only\n\nopenContextMenuInPopup calls awaitExtensionPanel, which waits for\nWebExtPopupLoaded. That event is dispatched from the panel's popupshowing\nhandler, so a test that awaits clickPageAction first can reach\nawaitExtensionPanel after the event and then wait until the test times out.\n\nStart the click without awaiting it, so that the listener is registered before\nanything can show the popup, and await the click promise afterwards so that a\nrejection is not left unobserved.\n\nAlso document why closePageAction resolves as soon as hidePopup has been called\nrather than once the popup is hidden.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317514\n", "files": ["browser/components/extensions/test/AppUiTestDelegate.sys.mjs", "browser/components/extensions/test/browser/browser_ext_pageAction_contextMenu.js"], "git_node": "04aca09f92b22a50c2a5a54ec3034506c0acd845", "git_parents": ["f508db63c8554945a09b0a15d9d8a9caec0bec09"], "node": "ff936fe974d3d23fa7880cb7a166e6bcfec626ff", "parents": ["b9692e45015696cd3887c7360e3058f7d3d2b5e7"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2035383 - Wait for pref-driven styles in waitForTabstripOrientation a=test-only\n\nThe helper returns as soon as the tabstrip's orient attribute is set, which a JS\npref observer does synchronously with the pref write; CSS keyed on the same pref\nthrough -moz-pref() only lands a refresh tick later, and no style flush brings\nthat forward. Callers could therefore assert on pref-driven layout before it\nexisted.\n\nbrowser_launcher_splitter_visibility.js is where this shows up: the launcher\nsplitter is display:none behind @media not -moz-pref(\"sidebar.verticalTabs\"),\nand its setup asserts the splitter is visible as soon as the helper returns. The\ntest has had that shape since bug 2016966 created it, a week before this bug was\nfiled. Fix the helper rather than the one assertion, because its ~20 callers all\nhave the same gap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321916\n", "files": ["browser/components/sidebar/tests/SidebarTestUtils.sys.mjs"], "git_node": "c6f3702e9ce0bbfcaa09328bc0c150e5dce01dfa", "git_parents": ["04aca09f92b22a50c2a5a54ec3034506c0acd845"], "node": "f176ef40a7dd7603f54c30b041269a5bb0c9800a", "parents": ["ff936fe974d3d23fa7880cb7a166e6bcfec626ff"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1829935 - Serve an image document in browser_103_cleanup.js so the early hint is never connected back a=test-only\n\nThe test asserts that the preload is cancelled with parent-connect-timeout,\nwhich requires the 1ms timer started by EarlyHintPreloader::Register() to beat\nthe content process connecting back for the hint. On a machine that completes\nthe connect-back in under a millisecond the timer loses, the channel is adopted\nrather than cancelled, and canceledReason is empty. That is most macOS runs and\noccasionally Windows.\n\nAn image document has no nsContentSink, so ProcessHTTPHeaders never runs and\nthe hint is never processed in the content process. The connect-back then\ncannot happen and the timer is the only thing that can cancel the preload.\nThe test now also asserts that earlyhints-connectback never fires, so that\nreintroducing the race fails loudly instead of silently going back to\nmeasuring it.\n\nThis replaces the 500ms delay added in D294363, which could not help: Register()\nstarts the timer at the 200 response, so delaying the 200 delays the timer too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321913\n", "files": ["netwerk/test/browser/103_cleanup.sjs", "netwerk/test/browser/browser_103_cleanup.js"], "git_node": "0e79822ed72dbccc8d0b59b8b2c4fafc29df3d32", "git_parents": ["c6f3702e9ce0bbfcaa09328bc0c150e5dce01dfa"], "node": "cee1eac3d2ae2432d5705cb16e6056819d4bd8d8", "parents": ["f176ef40a7dd7603f54c30b041269a5bb0c9800a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063730 - Don't load the user's desktop folder in browser_switchTabPermissionPrompt.js a=test-only\n\nThe test only needs a readable file:// URI. On part of the macOS test fleet the\ndesktop folder is not readable, and loading it throws\nNS_ERROR_FILE_ACCESS_DENIED.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321924\n", "files": ["browser/base/content/test/tabPrompts/browser_switchTabPermissionPrompt.js"], "git_node": "33e4165ee94f4b38a8b3f6dc65dc0b7a21439053", "git_parents": ["0e79822ed72dbccc8d0b59b8b2c4fafc29df3d32"], "node": "d59d55f5e45724ca48db6d664e979d2a6b582954", "parents": ["cee1eac3d2ae2432d5705cb16e6056819d4bd8d8"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2038933 - Observe the tab list's shadow root when waiting for synced tab rows a=test-only\n\nThe two context menu tasks waited for the rows while observing the page\ncomponent's shadow root. The rows are added to the sidebar-tab-list's own shadow\nroot, which that observer cannot see, so the wait only passed when they already\nhappened to exist at the initial check. Both now go through\nwaitForSyncedTabListInCard(), whose minRows argument keeps the \"at least two\nrows\" the inline waits required.\n\nThe waits for the cards had the same defect one level up, observing the host\nelement rather than the shadow root the cards render into. That one is latent \u2014\nthe cards are always present at the first synchronous check, which is why the\ncopy of the helper in browser_syncedtabs_sidebar_glean.js has never failed on it\n\u2014 but both are corrected here. Honouring cardIndex in that check is likewise\ninert today, since every caller wants the first card.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321909\n", "files": ["browser/components/sidebar/tests/browser/browser_syncedtabs_sidebar.js", "browser/components/sidebar/tests/browser/browser_syncedtabs_sidebar_glean.js"], "git_node": "c86ba5992c70f76c60e2e5a20d11698530c8cd12", "git_parents": ["33e4165ee94f4b38a8b3f6dc65dc0b7a21439053"], "node": "6bcf0eb5f984e0cfeadfc4c89b0455ec4e7f2eab", "parents": ["d59d55f5e45724ca48db6d664e979d2a6b582954"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2038933 - Confine a failing synced tabs sidebar task's sinon stubs to this file a=test-only\n\nA task that throws skips its own sandbox.restore(), so the stubs stay installed\nfor the rest of the browser session. browser_syncedtabs_sidebar_glean.js runs\nnext and dies in add_setup with \"Attempted to wrap getErrorType which is already\nwrapped\": 1273 failures over the last three weeks, tracking this file's\none-for-one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321910\n", "files": ["browser/components/sidebar/tests/browser/browser_syncedtabs_sidebar.js"], "git_node": "7e3fa0db113e557d084cd26adc729b316c057bba", "git_parents": ["c86ba5992c70f76c60e2e5a20d11698530c8cd12"], "node": "0855efb636b0101fbc206f80ad94419d7875e9c0", "parents": ["6bcf0eb5f984e0cfeadfc4c89b0455ec4e7f2eab"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994840 - Fix a race when accepting the cert exception in browser_mixed_content_cert_override a=test-only\n\n#exceptionDialogButton is enabled from load and only gets disabled once the\nadvanced panel starts revealing, so waiting on it returned before the panel\nexisted, and a lost click on #advancedButton left the test clicking into a\nhidden panel until timeout. Wait on the panel and the button together, and\nscroll each target into view and round-trip a mousemove through hit testing\nbefore clicking it.\n\nAlso share one closeIdentityPopup() that hides through gIdentityHandler, so a\npopup caught mid-open gets cancelled instead of staying up with no popuphidden\ncoming.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317245\n", "files": ["browser/base/content/test/siteIdentity/browser_deprecatedTLSVersions.js", "browser/base/content/test/siteIdentity/browser_mixed_content_cert_override.js", "browser/base/content/test/siteIdentity/head.js"], "git_node": "1a1b8a0825d58e9d8e2cd4145a730b81fd8c52b0", "git_parents": ["7e3fa0db113e557d084cd26adc729b316c057bba"], "node": "afcf35d92b606504ad975329843f120230aea126", "parents": ["0855efb636b0101fbc206f80ad94419d7875e9c0"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2019094 - Wait for the scroll marks update in browser_findbar_marks.js a=test-only\n\ngetMarks() sampled content.eventsCount immediately after the find was\nreported finished and asserted it had increased. FinderParent.doFind()\nnotifies onFindResult without waiting for updateHighlightAndMatchCount, and\nthe marks are only recomputed a findbar.iteratorTimeout hop after that, so\nthe read races the update. It usually wins because promiseFindFinished()\nspends five seconds waiting for a second find result that is never sent, but\nsince bug 1881627 changed how TimerThread waits on Windows, the iterator\ntimer regularly slips past even that.\n\nAlso drops the skip-if from bug 2028650: that config permafails on the same\nassertion, which is what an idle machine does to this race.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321911\n", "files": ["toolkit/content/tests/browser/browser.toml", "toolkit/content/tests/browser/browser_findbar_marks.js"], "git_node": "0f5a1f6a3004fa7f76341f94650a5cc2998fdbda", "git_parents": ["1a1b8a0825d58e9d8e2cd4145a730b81fd8c52b0"], "node": "c14c69d14ea23cc767155e28f3da73e63825c57b", "parents": ["afcf35d92b606504ad975329843f120230aea126"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994840 - Re-enable browser_mixed_content_cert_override.js on macOS 15.30 aarch64 a=test-only\n\nBug 1997430 tracked the same failure as this bug: the same test, the same bare\n\"Test timed out\" at 44 seconds with the first task passing and the second task\nproducing no output at all, and the same regressor in bug 1994309. It was never\nfixed, only skipped in bulk along with a batch of unrelated macOS failures in\nbug 2001881. Now that the underlying race in the legacy sub-run is fixed,\nre-enable the test on that configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317395\n", "files": ["browser/base/content/test/siteIdentity/browser.toml"], "git_node": "3d55e6712ea371fc8a14d65e0689ad12b6626c0b", "git_parents": ["0f5a1f6a3004fa7f76341f94650a5cc2998fdbda"], "node": "e76021bdc6eb588fa99746bda82d6091356afc73", "parents": ["c14c69d14ea23cc767155e28f3da73e63825c57b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937556 - Remove reftest-wait even when getDisplayMedia() rejects. a=test-only\n\nThese screen capture crashtests await navigator.mediaDevices.getDisplayMedia()\non a path where a rejected promise skips calling removeAttribute(\"class\").\nIn the rejection case, the reftest-wait is never cleared causing the test to hit\nthe 300s reftest timeout instead of completing.  Currently unknown is why\ngetDisplayMedia() seems to intermittently reject with NotAllowedError for an\nentire browser session when on macosx1500-aarch64 workers.  When that happens,\nit makes all three tests time out in the same run.\n\nWrap each test body in try/finally, as 1991492_1.html already does so a\nrejected getDisplayMedia() doesn't cause a timeout.\n\nAlso fixes bug 2055128 (1991492_2.html) and the same hang in 1991494.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326590\n", "files": ["dom/media/tests/crashtests/1920264.html", "dom/media/webrtc/tests/crashtests/1991492_2.html", "dom/media/webrtc/tests/crashtests/1991494.html"], "git_node": "6a5c23c9cc12f32036cb0de4cb4f104124ad7d78", "git_parents": ["3d55e6712ea371fc8a14d65e0689ad12b6626c0b"], "node": "9424559cb4d668529cc295f6cbd05e0dc8e5fb07", "parents": ["e76021bdc6eb588fa99746bda82d6091356afc73"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042672 - Wait for the HTML media tab to become audible before competing for audio focus in browser_uncontrollable_audio_focus.js. a=test-only\n\nA tab only claims audio focus once it becomes audible, but the HTML media\nsource only waited for the element to start playing. If the other tab became\naudible first, it never took focus from the HTML media tab, which then took\nfocus itself and was never paused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331205\n", "files": ["dom/media/mediacontrol/tests/browser/browser_uncontrollable_audio_focus.js"], "git_node": "38a664b2959c86880a17850813d46a821ba98892", "git_parents": ["6a5c23c9cc12f32036cb0de4cb4f104124ad7d78"], "node": "b323c9c77efa88ec11bb23fde435798f24c4043f", "parents": ["9424559cb4d668529cc295f6cbd05e0dc8e5fb07"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2050298 - Mark AudioContext.setSinkId tests as expected to fail. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308789\n", "files": ["testing/web-platform/meta/webaudio/the-audio-api/the-audiocontext-interface/audiocontext-sinkid-setsinkid.https.html.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-audiocontext-interface/audiocontext-sinkid-state-change.https.html.ini"], "git_node": "40b97d3ab51eb5c8eee862049ec1d5e1f0e3d880", "git_parents": ["38a664b2959c86880a17850813d46a821ba98892"], "node": "9006fb0b2c3e4600076022f5d2b0450d4ab4cf87", "parents": ["b323c9c77efa88ec11bb23fde435798f24c4043f"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2041288: Simplify WPT annotation for responsive-iframe-navigation.html. a=test-only\n\nThis test intermittently has either OK or ERROR status (from throwing an\nuncaught exception), likely due to a race condition or something else that's\nsemi-random.\n\nOur ini-updating-automation has built up an unnecessarily-complex and\nincomplete set of platform-specific annotations to encode this expectation.\n\nThis patch just collapses these annotations together, allowing the test to have\nOK or ERROR status regardless of platform/config.  This simplifies things and\nshould address unexpected test outcomes that have been quite frequent recently.\n\n(At some future point, it'd be good to investigate these intermittent issues\nand address them, whether they're test bugs or implementation bugs. But for\nnow, I'm just trying to make the automated annotation reflect reality and avoid\nthe tens of intermittent-failure-reports that we're getting per day.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312548\n", "files": ["testing/web-platform/meta/css/css-sizing/responsive-iframe/responsive-iframe-navigation.html.ini"], "git_node": "995a91a5232720ee796b88b50e7c60ef91b71c5d", "git_parents": ["40b97d3ab51eb5c8eee862049ec1d5e1f0e3d880"], "node": "ce3fb77aa4051c7ea8393476e716a1a48ecaa1de", "parents": ["9006fb0b2c3e4600076022f5d2b0450d4ab4cf87"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034727 - Update MediaStreamTrack-iframe-audio-transfer.https.html annotations for macOS (15.30). a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316530\n", "files": ["testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini"], "git_node": "69a79eb12ed6c335f5fb0146822d8ebd1e852291", "git_parents": ["995a91a5232720ee796b88b50e7c60ef91b71c5d"], "node": "b920c610ae28dbf1f0ff1c75389bba2bdae24ca2", "parents": ["ce3fb77aa4051c7ea8393476e716a1a48ecaa1de"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2063930 - Wait for about:pdf click targets to be laid out in tests. a=test-only\n\nUse MockFilePicker.showCallback to wait for the picker to open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319083\n", "files": ["toolkit/components/aboutpdf/tests/browser/browser_aboutPDF_actor.js", "toolkit/components/aboutpdf/tests/browser/head.js"], "git_node": "15af58b784f280eadebe371dccba5e36072046bf", "git_parents": ["69a79eb12ed6c335f5fb0146822d8ebd1e852291"], "node": "87e30036b4623464715a2f17726fa310b0c0d24c", "parents": ["b920c610ae28dbf1f0ff1c75389bba2bdae24ca2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2021221 - Wait for the real match count result in test_findbar.xhtml a=test-only\n\npromiseMatchesCountResult() resolved unconditionally after five times the find\niterator timeout, whether or not the result had arrived. When that escape hatch\nwins, testFindCountUI() asserts on the count the findbar is still displaying for\nthe previous find, which is what every recorded failure of this test looks like:\n\"got\" is the previous find's value.\n\nThere is no safe number to raise that deadline to: FinderIterator scales its own\nwait by the length of the search term, so the shortest terms have the least\nslack, and on Windows a timer that is due while the main thread is idle can slip\nfar past it. Bug 1881627 is the suspected regressor for that. So the wait is now\nunbounded, and a result that never arrives fails the test as a timeout instead\nof as a wrong count.\n\nAlso drop the mac aarch64 opt skip, since bug 2030058 is the same assertion in\nthe same function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321918\n", "files": ["toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/findbar_window.xhtml"], "git_node": "4c497fced6720f75d77acbb49925b5069cb0255f", "git_parents": ["15af58b784f280eadebe371dccba5e36072046bf"], "node": "25b60e420648814a7797922bef19b9aeec3bc415", "parents": ["87e30036b4623464715a2f17726fa310b0c0d24c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2021221 - Re-enable testFindCountUI() in debug builds a=test-only\n\nBug 1302110 put both testFindCountUI() calls behind !AppConstants.DEBUG in 2016\nto stop frequent intermittents. The guard covers those two calls and nothing\nelse, and the intermittent they produce is the fixed-timer race in\npromiseMatchesCountResult(), which now waits for the real match count result.\n\nRe-enabling them is the coverage that fix buys, and the debug runtime it adds\nstays well inside the test's requestLongerTimeout(2) budget.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321919\n", "files": ["toolkit/content/tests/chrome/findbar_window.xhtml"], "git_node": "4775856bf3524fd3d13b407dad017db0298c4867", "git_parents": ["4c497fced6720f75d77acbb49925b5069cb0255f"], "node": "0db39d1816d251735fb69a35fa29c4b1a463d59b", "parents": ["25b60e420648814a7797922bef19b9aeec3bc415"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2021221 - Drop the fixed sleeps in testFindCountUI() a=test-only\n\nEach iteration slept for the find iterator timeout scaled by the length of the\nsearch term before typing and before every onFindAgainCommand(). By the time\npromiseMatchesCountResult() resolves, FinderIterator has already run to\ncompletion and cached its result, so there is nothing left to wait out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321921\n", "files": ["toolkit/content/tests/chrome/findbar_window.xhtml"], "git_node": "83784cdc39f3c0ae54288c461d75b0c515a911d4", "git_parents": ["4775856bf3524fd3d13b407dad017db0298c4867"], "node": "87adcd99bd1fe54204f1fe92ce022a41c2bda316", "parents": ["0db39d1816d251735fb69a35fa29c4b1a463d59b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1767707 - Flush the pref file synchronously before launching the background task a=test-only\n\ndevtools.browsertoolbox.enable-test-server reaches the browser toolbox only\nthrough #initProfile copying this profile's prefs.js, so it took effect only\nwhen the write happened to win the race against the task's startup. Without it\ninstallTestingServer() is never called and initBrowserToolboxTask's connect\nloop spins until the test times out.\n\npreferences.allow.omt-write cannot serve here: Preferences.cpp caches it on\nfirst use, so flipping it in a test is a no-op.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325045\n", "files": ["devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/debugger/test/mochitest/browser_dbg-backgroundtask-debugging.js"], "git_node": "f94588b1cdf2ecb2a71be5220492b6917c04501d", "git_parents": ["83784cdc39f3c0ae54288c461d75b0c515a911d4"], "node": "280f72c3558d3c7a791775c20a0baf69af007272", "parents": ["87adcd99bd1fe54204f1fe92ce022a41c2bda316"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034727 - Allow both TIMEOUT and FAIL for MediaStreamTrack-iframe-audio-transfer.https.html on macOS. a=test-only\n\nOn macOS getDisplayMedia() either resolves with a stream lacking an audio\ntrack (harness ERROR, subtest TIMEOUT) or rejects with NotAllowedError\n(harness OK, subtest FAIL). wpt-sync has been flip-flopping the\nexpectation between the two, so accept both on all mac configurations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326338\n", "files": ["testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini"], "git_node": "8345748c9c0fe61e512f540fcaa0db3d488370d6", "git_parents": ["f94588b1cdf2ecb2a71be5220492b6917c04501d"], "node": "e7fecc13024848f2243a5efd37f60aaaf251b00a", "parents": ["280f72c3558d3c7a791775c20a0baf69af007272"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048634 - Update metadata for screen-capture/getdisplaymedia-framerate.https.html. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331526\n", "files": ["testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini"], "git_node": "f5197c47f4c051e6d0257957ab4ae89e30f87a84", "git_parents": ["8345748c9c0fe61e512f540fcaa0db3d488370d6"], "node": "6c6d5e1af7331fd4b468a5909e7f407ff56de225", "parents": ["e7fecc13024848f2243a5efd37f60aaaf251b00a"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048634 - Update metadata for screen-capture/getdisplaymedia-framerate.https.html. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331558\n", "files": ["testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini"], "git_node": "d87011454ac2b10c7369530b40f0a74953e456d2", "git_parents": ["f5197c47f4c051e6d0257957ab4ae89e30f87a84"], "node": "1521c7aa5110f3beda02a95d5420cef08238e96b", "parents": ["6c6d5e1af7331fd4b468a5909e7f407ff56de225"], "tags": []}], "date": 1791690549, "git_changesets": ["fbebcb07afee664dc0b463db3c933cf2b41fa7a0", "5df6e72fa4c7f36f1959d2e7cb601de266999f74", "67dd1ea37f8fc623684bbafa7274ab332d3deed9", "489b08278f0ae09e47a77f7ff27cffc7cc9094da", "30befa666b5a568e87d916b5609f3281813aeb10", "a9f124df2e5a4914f1fd3dcd97077273cdbee49b", "9c17b5f0d507ddabc98fb5255e80e27fedd54520", "ae59e82794cfa7ade9dae3390b12627cde05e86e", "133d68ed15a09535262c44270a6f5b73eedbc592", "22844ee8a0b30c34a69d30c61ce2da65b0eb66f8", "f508db63c8554945a09b0a15d9d8a9caec0bec09", "04aca09f92b22a50c2a5a54ec3034506c0acd845", "c6f3702e9ce0bbfcaa09328bc0c150e5dce01dfa", "0e79822ed72dbccc8d0b59b8b2c4fafc29df3d32", "33e4165ee94f4b38a8b3f6dc65dc0b7a21439053", "c86ba5992c70f76c60e2e5a20d11698530c8cd12", "7e3fa0db113e557d084cd26adc729b316c057bba", "1a1b8a0825d58e9d8e2cd4145a730b81fd8c52b0", "0f5a1f6a3004fa7f76341f94650a5cc2998fdbda", "3d55e6712ea371fc8a14d65e0689ad12b6626c0b", "6a5c23c9cc12f32036cb0de4cb4f104124ad7d78", "38a664b2959c86880a17850813d46a821ba98892", "40b97d3ab51eb5c8eee862049ec1d5e1f0e3d880", "995a91a5232720ee796b88b50e7c60ef91b71c5d", "69a79eb12ed6c335f5fb0146822d8ebd1e852291", "15af58b784f280eadebe371dccba5e36072046bf", "4c497fced6720f75d77acbb49925b5069cb0255f", "4775856bf3524fd3d13b407dad017db0298c4867", "83784cdc39f3c0ae54288c461d75b0c515a911d4", "f94588b1cdf2ecb2a71be5220492b6917c04501d", "8345748c9c0fe61e512f540fcaa0db3d488370d6", "f5197c47f4c051e6d0257957ab4ae89e30f87a84", "d87011454ac2b10c7369530b40f0a74953e456d2"], "user": "rvandermeulen@mozilla.com"}, "838": {"changesets": [{"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065750 - Update metadata for html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-invoke-in-sync-event.html. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320838\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/media-elements/loading-the-media-resource/resource-selection-invoke-in-sync-event.html.ini"], "git_node": "3434ec06d057219d08c2eee7f3c0e1c8fee3e263", "git_parents": ["d87011454ac2b10c7369530b40f0a74953e456d2"], "node": "8391004a735ac7756eef1879bef9157eea5c7235", "parents": ["1521c7aa5110f3beda02a95d5420cef08238e96b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073586 - Update metadata for script-url-blocked-report-contains-hash-service-worker.https.html. a=test-only\n", "files": ["testing/web-platform/meta/content-security-policy/script-src/tentative/script-url-blocked-report-contains-hash-service-worker.https.html.ini"], "git_node": "d1994a09bbd440bdde6a90a297670484d2945141", "git_parents": ["3434ec06d057219d08c2eee7f3c0e1c8fee3e263"], "node": "d1893d4dac74413105036fc13cd84fe7e79311d9", "parents": ["8391004a735ac7756eef1879bef9157eea5c7235"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062455 - Wait for painting to be unsuppressed before tests click on error pages a=test-only\n\nPresShell suppresses painting while a document is loading, to avoid showing a\npartially loaded page. It is unsuppressed by a timer armed for\nnglayout.initialpaint.delay (5ms), but that runnable is queued behind the rest\nof the page load work, so it typically runs several tens of milliseconds after\nPresShell::Initialize. On macOS this lands in the same window as the click the\ntest synthesizes, and hit testing ignores content while painting is suppressed,\nso the click resolved to the document root and fired no click event.\n\nBrowserTestUtils.waitForErrorPage now waits for painting to be unsuppressed\nbefore resolving, so that its callers don't need to know about this. Painting\nis suppressed per document, so the tests that load the error page in an iframe\ncan't rely on it, and use the new BrowserTestUtils.waitForPaintingUnsuppressed\ndirectly instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317968\n", "files": ["browser/base/content/test/about/head.js", "testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs", "testing/mochitest/BrowserTestUtils/BrowserTestUtilsChild.sys.mjs", "toolkit/components/certviewer/tests/browser/head.js"], "git_node": "2f196f9d87dfe17eeb667b6f381057f871283165", "git_parents": ["d1994a09bbd440bdde6a90a297670484d2945141"], "node": "4d1f3af7fd77504d3fbce067d613c3669b6c0f7c", "parents": ["d1893d4dac74413105036fc13cd84fe7e79311d9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062455 - Stop skipping browser_aboutCertError.js on mac a=test-only\n\nBug 1996741 was fixed while the test was skipped, and the annotation was forgotten.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317969\n", "files": ["browser/base/content/test/about/browser.toml"], "git_node": "33e9921ef3bd3a8e607ac602033f1dfe75cf6553", "git_parents": ["2f196f9d87dfe17eeb667b6f381057f871283165"], "node": "1c8bae4c1c8f75d713bccf257ffaaa01fa1b40ac", "parents": ["4d1f3af7fd77504d3fbce067d613c3669b6c0f7c"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058463 - Fix net-error-card tests using stale state to check exception button visibility a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314614\n", "files": ["browser/base/content/test/about/browser_aboutCertError_notYetValid.js", "browser/base/content/test/about/browser_aboutCertError_revoked.js", "browser/base/content/test/about/browser_aboutCertError_untrustedIssuer.js", "browser/base/content/test/about/browser_aboutNetError_invalid_cert_noUserFix.js"], "git_node": "8d5468c1fa09ab9f8d0cf22964ec04bba719a400", "git_parents": ["33e9921ef3bd3a8e607ac602033f1dfe75cf6553"], "node": "12846bc219ba36fb26eb5e3c5f39e6b9f75a7d9b", "parents": ["1c8bae4c1c8f75d713bccf257ffaaa01fa1b40ac"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915308 - [devtools] Update inspector onRootNodeAvailable to wait for #setupToolbar a=RyanVM\n\nSee https://bugzilla.mozilla.org/show_bug.cgi?id=1915308#c29 for more details.\nThe missing await leads to uncaught promise rejections in some tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322829\n", "files": ["devtools/client/inspector/inspector.js"], "git_node": "bd83660a10e48279e2a7274ff6c0fb9e8f3eb21f", "git_parents": ["8d5468c1fa09ab9f8d0cf22964ec04bba719a400"], "node": "26e3f1ab95c0574670e37ecd5f466df86b21f724", "parents": ["12846bc219ba36fb26eb5e3c5f39e6b9f75a7d9b"], "tags": []}], "date": 1791694630, "git_changesets": ["3434ec06d057219d08c2eee7f3c0e1c8fee3e263", "d1994a09bbd440bdde6a90a297670484d2945141", "2f196f9d87dfe17eeb667b6f381057f871283165", "33e9921ef3bd3a8e607ac602033f1dfe75cf6553", "8d5468c1fa09ab9f8d0cf22964ec04bba719a400", "bd83660a10e48279e2a7274ff6c0fb9e8f3eb21f"], "user": "rvandermeulen@mozilla.com"}, "839": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2042284 - Add 5ms tolerance for toolkit/profile/test/xpcshell/test_create_default.js. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306701\n", "files": ["toolkit/profile/test/xpcshell/test_create_default.js"], "git_node": "1e385d745960bb4e51e5387f890d6ab96e326abe", "git_parents": ["bd83660a10e48279e2a7274ff6c0fb9e8f3eb21f"], "node": "797a66099bf6b5fad30ca9a81b81e495d9bc54be", "parents": ["26e3f1ab95c0574670e37ecd5f466df86b21f724"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055990 - Wait for a frame before each subtest in test_animation_performance_warning.html. a=test-only\n\nHonestly I don't know what happened on the failing runs, and I haven't\ninvestigated it either. Given that the failures happen on shippable/opt\nbuilds, I suspect that with some optimizations, even after a paint has\nhappened, newly created compositor-runnable animations are sometimes not\nsent to the compositor. I guess it involves the catch-up tick [1]. So\nthis change is definitely a workaround, but it doesn't harm this test at\nall.\n\n[1] https://searchfox.org/firefox-main/rev/7fa9b602777418732e08b26d1ef6c9945c4bbd72/layout/base/nsRefreshDriver.cpp#1818-1836\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313140\n", "files": ["dom/animation/test/chrome/test_animation_performance_warning.html"], "git_node": "f89d2069d863e0e80dbd980b988c9f2fe04407f4", "git_parents": ["1e385d745960bb4e51e5387f890d6ab96e326abe"], "node": "c79e484ee36a083cec563676476aa0ae3d7b4f57", "parents": ["797a66099bf6b5fad30ca9a81b81e495d9bc54be"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057860 - Fix browser_drag_horizontal_overflow.js failures by waiting until scroll button is enabled. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323375\n", "files": ["browser/components/tabbrowser/test/browser/dragdrop/browser_drag_horizontal_overflow.js"], "git_node": "33362d78a82892465e0e6bc00b71d3dd552fdaeb", "git_parents": ["f89d2069d863e0e80dbd980b988c9f2fe04407f4"], "node": "bb0553db812da0e0ebe88f1e2c16dc3e748dcc1b", "parents": ["c79e484ee36a083cec563676476aa0ae3d7b4f57"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Release the mouse button after the container menu opens from the new tab button in browser_newtabButton.js a=test-only\n\nThe container menu opens on mousedown. On macOS it is a native menu activated with activateItem, so the test never sent a mouseup and left the mouse button pressed. Keep the press that opens the menu and release the button once it is shown, as a user does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329183\n", "files": ["browser/components/contextualidentity/test/browser/browser_newtabButton.js"], "git_node": "b4d4a783c670085da2e15c2ec387bea3380b6466", "git_parents": ["33362d78a82892465e0e6bc00b71d3dd552fdaeb"], "node": "8789af60a2c965b1a003b277578fb896bf7e00bc", "parents": ["bb0553db812da0e0ebe88f1e2c16dc3e748dcc1b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1775706 - Wait for the sidebar animation before right-clicking the vertical tabs new tab button in browser_newtabButton.js, and re-enable it on macOS opt a=test-only\n\nWhile the sidebar expand animation runs, the content area overlaps the button and the synthesized contextmenu opens the content context menu instead. This was the macOS opt failure, so the skip-if is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329184\n", "files": ["browser/components/contextualidentity/test/browser/browser.toml", "browser/components/contextualidentity/test/browser/browser_newtabButton.js"], "git_node": "4339159e8fb33af0ab436c6bb54ea47c2e98e534", "git_parents": ["b4d4a783c670085da2e15c2ec387bea3380b6466"], "node": "393751c880191ad651e9926291a5b4378fe75c4c", "parents": ["8789af60a2c965b1a003b277578fb896bf7e00bc"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in devtools/client/storage a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331135\n", "files": ["devtools/client/storage/test/head.js"], "git_node": "d8d606460