 Update tzdata to 2026e  a=RyanVM\n\nThis is a mechanical update done through `./update-tzdata.sh 2026e`\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334163\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335150\n", "files": ["config/external/icu/data/icudt78l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/timezoneTypes.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/timezoneTypes.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/timezoneTypes.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/zoneinfo64.txt"], "git_node": "8fe1b0fb1d57fae3d01c1587618c7f6fbc35339d", "git_parents": ["e9cc1fc2ec3c5f0543e96d0446b3867148816ae8"], "node": "5989f565e39cd9e760d7e98d2af734067fc0f9ab", "parents": ["9c402170ffb9ffb5cea15d3577ef790bd3d9d801"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - SpiderMonkey update tz_data  a=RyanVM\n\nThis is a mechanical update via `make_intl_data.py tzdata`\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334164\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335151\n", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "d23fb8c191d2857edc5443aa031bc80d56907978", "git_parents": ["8fe1b0fb1d57fae3d01c1587618c7f6fbc35339d"], "node": "9da0409e0e04885843ccc0a96e32869fa229a860", "parents": ["5989f565e39cd9e760d7e98d2af734067fc0f9ab"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Make the ICU data hash visible to the build system to avoid caching failures.  a=RyanVM\n\nI encountered failures with both sccache and buildcache beause the sccache and buildcache don't have semantic tracking through the .incbin inside the .S file, causing both tools to return out of date object files from the caches.\n\nTo fix this we add icu_dat_hashed.S to the sources list, and generate that from icu_data.S + the hash of the data file.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334165\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335152\n", "files": ["config/external/icu/data/icu_data.S", "config/external/icu/data/icu_data_hash.py", "config/external/icu/data/moz.build"], "git_node": "a7768573ff49f3470c80799aac498f5dc0d558fc", "git_parents": ["d23fb8c191d2857edc5443aa031bc80d56907978"], "node": "8cff62c7d2ba23ac74e91e367fabcbca724484bd", "parents": ["9da0409e0e04885843ccc0a96e32869fa229a860"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079869 - Ensure EST5EDT, CST6CDT, MST7MDT, and PST8PDT are not exposed as canonical time zone ids to the web  a=RyanVM\n\nSpecial case these in make_intl_data.py\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334166\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335153\n", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/builtin/intl/make_intl_data.py", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "62f2b28ff2d727976804860682ab8aff6ab29c22", "git_parents": ["a7768573ff49f3470c80799aac498f5dc0d558fc"], "node": "0156d645bbc3bc1275953dd62cf6750ebde4fce4", "parents": ["8cff62c7d2ba23ac74e91e367fabcbca724484bd"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Map legacy POSIX names to corresponding city zones  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334167\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335154\n", "files": ["js/src/vm/DateTime.cpp"], "git_node": "ef2dff218933aae521a8f90affc51e9092d502f8", "git_parents": ["62f2b28ff2d727976804860682ab8aff6ab29c22"], "node": "27c5c8e609553e240e7eee6fdde15748f48a7798", "parents": ["0156d645bbc3bc1275953dd62cf6750ebde4fce4"], "tags": []}], "date": 1792437944, "git_changesets": ["e9cc1fc2ec3c5f0543e96d0446b3867148816ae8", "8fe1b0fb1d57fae3d01c1587618c7f6fbc35339d", "d23fb8c191d2857edc5443aa031bc80d56907978", "a7768573ff49f3470c80799aac498f5dc0d558fc", "62f2b28ff2d727976804860682ab8aff6ab29c22", "ef2dff218933aae521a8f90affc51e9092d502f8"], "user": "rvandermeulen@mozilla.com"}, "1022": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051741: Run user-characteristics WebGL collection in the content process  a=RyanVM DONTBUILD\n\nInstead of using browser.ownerDocument use the remote browser's\ncontent document which is the about:fingerprintingprotection page\n\nCollected values are returned to the parent over IPC and populated\ninto Glean there. Typed-array parameters are copied across the\nprincipal boundary with structuredClone()\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310181\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335339\n", "files": ["toolkit/actors/UserCharacteristicsChild.sys.mjs", "toolkit/components/resistfingerprinting/UserCharacteristicsPageService.sys.mjs", "toolkit/components/resistfingerprinting/nsUserCharacteristics.cpp"], "git_node": "c547c33f13cdb509cab18c80e9114f70a4df6f5a", "git_parents": ["ef2dff218933aae521a8f90affc51e9092d502f8"], "node": "e1aeea24532c5b49c8ee3f7c411422b3f0196d5f", "parents": ["27c5c8e609553e240e7eee6fdde15748f48a7798"], "tags": []}], "date": 1792454667, "git_changesets": ["c547c33f13cdb509cab18c80e9114f70a4df6f5a"], "user": "rvandermeulen@mozilla.com"}, "1023": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 1 - Rename ModulePaths to ModuleIdentifiers  a=RyanVM\n\nRename-only, since ModuleIdentifiers will be used in later parts, instead of\njust paths.  No substantive changes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330459\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335390\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPPlatform.cpp", "dom/media/gmp/GMPPlatform.h", "dom/media/gmp/PGMP.ipdl", "dom/media/ipc/PRDD.ipdl", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "ipc/glue/PUtilityProcess.ipdl", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h"], "git_node": "8fa0913c3d0bfd4ae3c059bdd69b064c778ba5b5", "git_parents": ["c547c33f13cdb509cab18c80e9114f70a4df6f5a"], "node": "b28ffc0e0b0d71961e1bfd01593f8730ccfa140b", "parents": ["e1aeea24532c5b49c8ee3f7c411422b3f0196d5f"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 2 - Pass child process's module list by file handle  a=RyanVM\n\nChild processes now report loaded DLLs to the parent by file HANDLE instead\nof by filename.  In child processes, the DLL blocklist now hooks\nNtCreateSection and duplicates the file handle that the loader passes it.\nThat is the only point where the handle is available, since the loader closes\nit once the section is created.  The NtMapViewOfSection hook attaches it to\nthe ModuleLoadInfo for the load.  The parent identifies the module from the\nHANDLE with GetFinalPathNameByHandleW.  This is based on the abandoned\nrevision D321122.\n\nA handle cannot be forged into a reference to a different file and a child can\nonly send one it holds.  ValidateAndResolveModuleFile sanity checks:\n\n1. The handle must be for a file on a disk.\n2. The file must not be on a remote device.\n3. The file must not carry a mandatory integrity label below medium.\n\nThese checks replicate the checks of the MITIGATION_IMAGE_LOAD_NO_REMOTE and\nMITIGATION_IMAGE_LOAD_NO_LOW_LABEL child sandbox behaviors.  A child can open\na file without loading it, so what it hands us is not bounded by the\nimage-load policy.  The checks avoid considering such files at all.  This\ncurrently applies to all child processes: content, gpu, RDD, socket, utility\n(all kinds), and GMP.  All have these sandbox mitigations.\n\nA file handle cannot be duplicated with more access than the loader's handle\nhas, and that lacks READ_CONTROL, so the duplicate is given no access to the\nfile at all.  The parent reopens the file from the handle to read its label.\n\nHolding a file handle does not prevent the file's deletion, so a module that\nis quickly unloaded and then deleted, before the parent processes the batch,\nstill cannot be evaluated.  These patches do not fix that problem.\n\nAlso fixes a couple of ways that a version resource could misuse VerQueryValueW's\noutput in the parent: a zero length underflowing to SIZE_MAX in\nQueryStringValue and a too-short buffer dereference in GetFromImage.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330460\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335391\n", "files": ["browser/app/winlauncher/DllBlocklistInit.cpp", "browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/DllBlocklist.h", "browser/app/winlauncher/freestanding/ModuleLoadFrame.cpp", "browser/app/winlauncher/freestanding/ModuleLoadFrame.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/GMPPlatform.h", "mozglue/misc/NativeNt.h", "toolkit/xre/dllservices/ModuleVersionInfo.cpp", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/UntrustedModulesProcessor.h", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/WinDllServices.h", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h"], "git_node": "39adabfc091c6a20eb976f8d94437436bccb69be", "git_parents": ["8fa0913c3d0bfd4ae3c059bdd69b064c778ba5b5"], "node": "d54a670f4a9a567476f5e0cfd7dcdfcd592ea560", "parents": ["b28ffc0e0b0d71961e1bfd01593f8730ccfa140b"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 3 - Test that UntrustedModulesProcessor rejects invalid modules  a=RyanVM\n\nCheck that ValidateAndResolveModuleFile rejects descriptors that are not for\nfiles on a disk or are for below-medium-integrity modules.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330461\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335392\n", "files": ["toolkit/xre/dllservices/tests/gtest/TestModuleFileValidation.cpp", "toolkit/xre/dllservices/tests/gtest/moz.build"], "git_node": "6db024122f231d38a713513a95bbe1c9532e5d07", "git_parents": ["39adabfc091c6a20eb976f8d94437436bccb69be"], "node": "34d27da49d467e420c85dc1e1c54e594b098b73e", "parents": ["d54a670f4a9a567476f5e0cfd7dcdfcd592ea560"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057112: Part 4 - Add DLL-reporting failures to the third-party-modules ping  a=RyanVM\n\nNow that the parent identifies a child process's modules from the file handle\nthe child sends, and silently skips any handle it cannot identify, we will\nneed telemetry for how often that skipping happens. This patch adds a counter\nfor that.\n\nrejectedFiles: the number of module file handles a child process sent to the\nparent that it refused as invalid module file handles.\n\nThe counter is per-process and is only ever incremented for child processes,\nso the browser process reports zero. The counter is reported by the process\nusing the module, so its accuracy depends on trusting the process itself.\nThis is how the UntrustedModulesProcessor has always worked, and is by design\n(for performance reasons).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330462\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335393\n", "files": ["toolkit/components/telemetry/metrics.yaml", "toolkit/components/telemetry/other/UntrustedModules.cpp", "toolkit/components/telemetry/other/UntrustedModulesDataSerializer.cpp", "toolkit/xre/dllservices/UntrustedModulesData.cpp", "toolkit/xre/dllservices/UntrustedModulesData.h", "toolkit/xre/dllservices/UntrustedModulesProcessor.cpp", "toolkit/xre/dllservices/tests/gtest/TestUntrustedModules.cpp"], "git_node": "a2d63ae5e6891d858b82b5fa8a7697f6683003c3", "git_parents": ["6db024122f231d38a713513a95bbe1c9532e5d07"], "node": "25d4a105ce7cb4eca04249b739f0937faeb9a611", "parents": ["34d27da49d467e420c85dc1e1c54e594b098b73e"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078555: Part 1 - Version ModuleLoadInfo where it crosses binaries  a=RyanVM\n\nAn interrupted update can leave firefox.exe, mozglue.dll and xul.dll at\ndifferent versions, and a ModuleLoadInfo passes between all three.  The struct\nnow starts with a magic number and a layout version.  Each binary that\nreceives one checks them before reading and drops the record otherwise, leaving\nthe object to the binary that built it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331475\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335394\n", "files": ["browser/app/winlauncher/freestanding/LoaderPrivateAPI.cpp", "toolkit/xre/dllservices/mozglue/LoaderObserver.cpp", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h", "toolkit/xre/dllservices/mozglue/WindowsDllServices.h", "toolkit/xre/dllservices/tests/gtest/TestDLLServices.cpp"], "git_node": "756c27761d628804dea5ab005239b32505b6607e", "git_parents": ["a2d63ae5e6891d858b82b5fa8a7697f6683003c3"], "node": "893f38843aa02de6669ff91f38925084308f071c", "parents": ["25d4a105ce7cb4eca04249b739f0937faeb9a611"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078555: Part 2 - Don't send module load events if ModuleLoadInfo may have changed  a=RyanVM\n\nPart 1 lets a binary refuse a ModuleLoadInfo of another layout, but a binary\nwithout that check still accepts one.  So firefox.exe, mozglue.dll and xul.dll\nnow each export their layout version in a function, and a sender asks the\nreceiver for it before handing module load events across.  mozglue.dll also\nstops using an executable with a different layout to construct its\nModuleLoadInfos, since that happens by value and cannot be checked afterwards.\nA binary without the export is treated as having a different layout.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331476\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335395\n", "files": ["browser/app/winlauncher/NtLoaderAPI.cpp", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/mozglue/ModuleLoadFrame.cpp", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h", "toolkit/xre/dllservices/mozglue/WindowsDllBlocklist.cpp", "toolkit/xre/dllservices/tests/gtest/TestDLLServices.cpp"], "git_node": "7b32ef0c52b8072bebaf500f6eddf4bc510eb8a7", "git_parents": ["756c27761d628804dea5ab005239b32505b6607e"], "node": "197a401cf31ceb1b719f2650c3e451171dc65d1a", "parents": ["893f38843aa02de6669ff91f38925084308f071c"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078555: Part 3 - Fix conditional in LoaderObserver::OnForward  a=RyanVM\n\nTypo in copying from part 2 review.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331904\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335396\n", "files": ["toolkit/xre/dllservices/mozglue/LoaderObserver.cpp"], "git_node": "e613b46f9ab2c8fa242757e75856b188f0077cea", "git_parents": ["7b32ef0c52b8072bebaf500f6eddf4bc510eb8a7"], "node": "52b4b6a54cf79388d0f8b05aadf45959c5be6a31", "parents": ["197a401cf31ceb1b719f2650c3e451171dc65d1a"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078555: Part 4 - Bump ModuleLoadInfo version number  a=RyanVM\n\nModuleLoadInfo in mozilla-central is binary incompatible with ModuleLoadInfo\nin beta, so bump the version number.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331856\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335397\n", "files": ["toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h"], "git_node": "e66513d235c17c4bc2db8516a128cf5ebb34a60a", "git_parents": ["e613b46f9ab2c8fa242757e75856b188f0077cea"], "node": "4b7853229dc928be13c4fd7dbc4840891519a7f8", "parents": ["52b4b6a54cf79388d0f8b05aadf45959c5be6a31"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079522 - Improve SafeThreadLocal behavior for threads without TLS  a=RyanVM\n\nThreads created with THREAD_CREATE_FLAGS_SKIP_LOADER_INIT or as parallel\nloader workers never get a TLS vector.  SafeThreadLocal assumed every\nnon-main thread had one, causing NULL derefs in get() and set().  This\ncrashed in the addition of TakePendingFileHandle(), since every section\nmapping reads the slot, and it has long crashed in\nModuleLoadFrame::ExistsTopFrame and the ModuleLoadFrame constructor, when\ndealing with some AV-created threads.\n\nThis patch:\n\n1. Treats these threads as having no frame and no pending handle\n2. Does not improperly use the main thread's global slot for a second caller\n3. Closes a duplicate patched_NtCreateSection could not stash due to missing\n   TLS.\n\nA thread that has stored nothing now also reads nothing.  Previously, before\nany thread had used TLS, other threads read the main thread's live frame\npointer and kept it in their own slot after it went out of scope.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331831\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335398\n", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/SafeThreadLocal.h", "browser/app/winlauncher/test/TestSafeThreadLocal.cpp"], "git_node": "f314f50869abcf710e1da03a23cd1caab3203205", "git_parents": ["e66513d235c17c4bc2db8516a128cf5ebb34a60a"], "node": "d357b85e475b2455e26f3273e29f5d77c4fd6a64", "parents": ["4b7853229dc928be13c4fd7dbc4840891519a7f8"], "tags": []}], "date": 1792454883, "git_changesets": ["8fa0913c3d0bfd4ae3c059bdd69b064c778ba5b5", "39adabfc091c6a20eb976f8d94437436bccb69be", "6db024122f231d38a713513a95bbe1c9532e5d07", "a2d63ae5e6891d858b82b5fa8a7697f6683003c3", "756c27761d628804dea5ab005239b32505b6607e", "7b32ef0c52b8072bebaf500f6eddf4bc510eb8a7", "e613b46f9ab2c8fa242757e75856b188f0077cea", "e66513d235c17c4bc2db8516a128cf5ebb34a60a", "f314f50869abcf710e1da03a23cd1caab3203205"], "user": "rvandermeulen@mozilla.com"}, "1024": {"changesets": [{"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050422 - Give each xpcshell harness run its own `tempDir` r=ahal a=test-only\n\nWithout a `tempDir`, every `XPCShellTests` writes its prefs to the same\n`user.js` in the process wide temp dir. The self tests run in parallel, so\nthey interleave writes to it, and xpcshell either fails to parse the result\nor the main suite runs with a self test's prefs.\n\nThe self tests could pass their own `tempDir`, since each already owns one.\nInstead the harness creates a private directory whenever the caller gives\nnone and removes it once `runTests` returns, so any two runs that leave the\nchoice to the harness stay apart, not only the self tests. Cleanup has to\nwait for `runTests` because `--verify` calls `runTestList` several times on\nthe same instance.\n\nThe directory name is kept short because it sits between `$TMPDIR` and the\nper test `xpc-other-` directory. macOS unix domain socket paths are limited\nto 103 bytes and `test_unix_domain.js` was one byte over with a longer name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326019\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "5896ac3bf4fd600d0121132fc2eb86492f472956", "git_parents": ["f314f50869abcf710e1da03a23cd1caab3203205"], "node": "7467d934b0e083781e862aad1addc961901c5a91", "parents": ["d357b85e475b2455e26f3273e29f5d77c4fd6a64"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030601 - Speed-up test_URIFixup_info.js by resetting FOG only when necessary. r=Gijs a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307736\n", "files": ["docshell/test/unit/test_URIFixup_info.js"], "git_node": "ea09dfaeb0058afba56c466292e16ce6c62cb6c3", "git_parents": ["5896ac3bf4fd600d0121132fc2eb86492f472956"], "node": "2bc9409d3239ac0f968429eae65a0e93cb5c0591", "parents": ["7467d934b0e083781e862aad1addc961901c5a91"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034023 - Disable fullscreen keyboard-lock WPTs on macOS debug r=jgraham a=test-only\n\nThey hit the mFullscreenChangeState assertion in AppWindow::FullscreenWillChange\nmuch more often now that macOS aarch64 runs testharness with 3 processes\n(bug 2050488). Re-enable once the race is fixed.\n", "files": ["testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-change.window.js.ini", "testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-escape.window.js.ini", "testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-multiple-elements.window.js.ini", "testing/web-platform/meta/fullscreen/api/document-fullscreen-keyboard-lock-shadowdom.window.js.ini", "testing/web-platform/meta/fullscreen/api/keyboard-lock-cross-origin-iframe.sub.html.ini"], "git_node": "c3962f65fd3a4142c14ee6f8ad6dd0bfc56a6229", "git_parents": ["ea09dfaeb0058afba56c466292e16ce6c62cb6c3"], "node": "b2d1e6efcdbfc25011e9b4dd3e651770f1b73b82", "parents": ["2bc9409d3239ac0f968429eae65a0e93cb5c0591"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2045155 - Only recreate XUL label accessibles when the label itself was reported as inserted, r=accessibility-platform-reviewers,eeejay a=RyanVM\n\nPruneOrInsertSubtree removes and reschedules any XULLabelAccessible it walks\nover. That is correct for a label whose frame was just reconstructed, because\nthe anonymous content backing its `value` attribute is rebuilt with it, but the\nfunction also applies it while recursing through an ancestor's subtree, where\nnothing tells us the label needs recreating. Such a label is removed from the\ntree and only reinserted in a later notification controller pass, so assistive\ntechnology sees a spurious hide and reorder and the label is briefly absent.\n\nOnly apply the recreation to the node that was reported as inserted, not to\ndescendants reached by the subtree walk.\n\nThis is reachable whenever a popup finishes opening: RootAccessible handles\npopupshown by calling ContentInserted on the panel, whose subtree has already\nbeen built, and the walk reached every XUL label and description underneath it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315734\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h"], "git_node": "781cd53ff28c2cc6c9ebad91e0dd5ece7c426138", "git_parents": ["c3962f65fd3a4142c14ee6f8ad6dd0bfc56a6229"], "node": "5dc981589fe5e81792fc2a5f1e71d6db8684458c", "parents": ["b2d1e6efcdbfc25011e9b4dd3e651770f1b73b82"], "tags": []}], "date": 1792461727, "git_changesets": ["5896ac3bf4fd600d0121132fc2eb86492f472956", "ea09dfaeb0058afba56c466292e16ce6c62cb6c3", "c3962f65fd3a4142c14ee6f8ad6dd0bfc56a6229", "781cd53ff28c2cc6c9ebad91e0dd5ece7c426138"], "user": "rvandermeulen@mozilla.com"}, "1025": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 48a735cc74a7e6d730f9bf59c3de58f750287a23 with FIREFOX_158_0_1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "810be14f88eb1abc0bf57df1158014d3464f1ba0", "git_parents": ["067d0f10f7411d25981204d7d8f57552b5913de2"], "node": "b3825d811065e00eda132444618e824eb95670aa", "parents": ["1bc590d097102265126b43df46a5c73592ff1247"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 48a735cc74a7e6d730f9bf59c3de58f750287a23 with FIREFOX-ANDROID_158_0_1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "c4485f6da107f16515b24c791f71104056baa001", "git_parents": ["810be14f88eb1abc0bf57df1158014d3464f1ba0"], "node": "7dc2b9feb5c0ceb4818f8f615981573e8a971e0f", "parents": ["b3825d811065e00eda132444618e824eb95670aa"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 48a735cc74a7e6d730f9bf59c3de58f750287a23 with FIREFOX-ANDROID_158_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "1d76cde920e30954fc9e723aaf6ff4f43ef7c141", "git_parents": ["c4485f6da107f16515b24c791f71104056baa001"], "node": "15fbf6ba365ce6f84e03b26f33155d924f94b14e", "parents": ["7dc2b9feb5c0ceb4818f8f615981573e8a971e0f"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 48a735cc74a7e6d730f9bf59c3de58f750287a23 with FIREFOX_158_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "5a5aafa93651b737e7b7c55629ba497b464f2fa2", "git_parents": ["1d76cde920e30954fc9e723aaf6ff4f43ef7c141"], "node": "8cee5ed296e3d81de1fc271b44fdd6c02da65784", "parents": ["15fbf6ba365ce6f84e03b26f33155d924f94b14e"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4de1925a46a49f026e71c4c0460230e6f39f5d9d with FIREFOX_115_43_1esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "00dac068356ec31db76b158ce982f3327eb51f0e", "git_parents": ["5a5aafa93651b737e7b7c55629ba497b464f2fa2"], "node": "18592600bb91258fb6b7b7cd9ae4c8115bd4b89b", "parents": ["8cee5ed296e3d81de1fc271b44fdd6c02da65784"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 46f5f658a8fe6751cb4ef704999da57fb1bf1ea2 with FIREFOX_153_5_1esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9dd7a51abddd1e2dd34d82490318e914f2b18121", "git_parents": ["00dac068356ec31db76b158ce982f3327eb51f0e"], "node": "3c559d110a9ddec32bd099ab7ce557cdc83b9748", "parents": ["18592600bb91258fb6b7b7cd9ae4c8115bd4b89b"], "tags": []}], "date": 1792504204, "git_changesets": ["810be14f88eb1abc0bf57df1158014d3464f1ba0", "c4485f6da107f16515b24c791f71104056baa001", "1d76cde920e30954fc9e723aaf6ff4f43ef7c141", "5a5aafa93651b737e7b7c55629ba497b464f2fa2", "00dac068356ec31db76b158ce982f3327eb51f0e", "9dd7a51abddd1e2dd34d82490318e914f2b18121"], "user": "ffxbld@lando.moz.tools"}, "1026": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2083713 - Include CoreFoundation in CFTypeRefPtr.h.  a=RyanVM DONTBUILD\n\nThe templates call CFRelease and CFRetain, so the header failed to compile\nunless CoreFoundation had already been included.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335189\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335597\n", "files": ["xpcom/base/CFTypeRefPtr.h"], "git_node": "2e9aae46d81fc6edd1ad31af8a889c3d8f93957f", "git_parents": ["781cd53ff28c2cc6c9ebad91e0dd5ece7c426138"], "node": "af8993b26a4a87ad9860d5c46307a954b4932bbb", "parents": ["5dc981589fe5e81792fc2a5f1e71d6db8684458c"], "tags": []}], "date": 1792507998, "git_changesets": ["2e9aae46d81fc6edd1ad31af8a889c3d8f93957f"], "user": "rvandermeulen@mozilla.com"}, "1027": {"changesets": [{"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2069696 - Update quinn-udp to 0.6.2  a=RyanVM DONTBUILD\n\nhttps://github.com/quinn-rs/quinn/releases/tag/quinn-udp-0.6.2\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323901\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335567\n", "files": ["Cargo.lock", "supply-chain/audits.toml", "third_party/rust/quinn-udp/.cargo-checksum.json", "third_party/rust/quinn-udp/.cargo_vcs_info.json", "third_party/rust/quinn-udp/Cargo.lock", "third_party/rust/quinn-udp/Cargo.toml", "third_party/rust/quinn-udp/Cargo.toml.orig", "third_party/rust/quinn-udp/benches/throughput.rs", "third_party/rust/quinn-udp/src/apple_fast.rs", "third_party/rust/quinn-udp/src/cmsg/mod.rs", "third_party/rust/quinn-udp/src/cmsg/unix.rs", "third_party/rust/quinn-udp/src/cmsg/windows.rs", "third_party/rust/quinn-udp/src/fallback.rs", "third_party/rust/quinn-udp/src/lib.rs", "third_party/rust/quinn-udp/src/linux.rs", "third_party/rust/quinn-udp/src/unix.rs", "third_party/rust/quinn-udp/src/wasi.rs", "third_party/rust/quinn-udp/src/windows.rs", "third_party/rust/quinn-udp/tests/tests.rs"], "git_node": "b5d4d63324668c936f525a3be6a8dce8bcf6aec7", "git_parents": ["2e9aae46d81fc6edd1ad31af8a889c3d8f93957f"], "node": "5558b54df54b8a62607b6880cdd0793cf198149d", "parents": ["af8993b26a4a87ad9860d5c46307a954b4932bbb"], "tags": []}], "date": 1792508090, "git_changesets": ["b5d4d63324668c936f525a3be6a8dce8bcf6aec7"], "user": "rvandermeulen@mozilla.com"}, "1028": {"changesets": [{"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031817: Part 1 - Create a helper to install from DMGs  a=RyanVM DONTBUILD\n\nCreates an XPC based helper that is used when installing from DMG requires elevation.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300313\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335627\n", "files": ["python/mozbuild/mozbuild/artifacts.py", "toolkit/moz.build", "toolkit/mozapps/dmgInstallHelper/Info.plist.in", "toolkit/mozapps/dmgInstallHelper/Launchd.plist", "toolkit/mozapps/dmgInstallHelper/Makefile.in", "toolkit/mozapps/dmgInstallHelper/dmgInstallHelper.mm", "toolkit/mozapps/dmgInstallHelper/dmgInstallProtocol.h", "toolkit/mozapps/dmgInstallHelper/moz.build", "toolkit/mozapps/dmgInstallHelper/uninstall.sh"], "git_node": "a9fc75739b1db00ec1038d2161392c4518a911ed", "git_parents": ["b5d4d63324668c936f525a3be6a8dce8bcf6aec7"], "node": "13bc0285c6e0cde35d4f1693ccd21bbdaf8cae12", "parents": ["5558b54df54b8a62607b6880cdd0793cf198149d"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031817: Part 2 - Use the XPC based DMG install helper instead of the updater  a=RyanVM DONTBUILD\n\nThe updater no longer handles DMG installation, so use the dmg install helper instead\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300314\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335628\n", "files": ["toolkit/xre/MacLaunchHelper.h", "toolkit/xre/MacLaunchHelper.mm", "toolkit/xre/MacRunFromDmgUtils.mm"], "git_node": "8b8e8cff4cf64163c62beb234e1a896e046e85be", "git_parents": ["a9fc75739b1db00ec1038d2161392c4518a911ed"], "node": "8ef7a4eda3b86938364fe1b47851bcd600a56755", "parents": ["13bc0285c6e0cde35d4f1693ccd21bbdaf8cae12"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031817: Part 3 - Correctly set the SMPrivilegedExecutables key when there are multiple executables  a=RyanVM DONTBUILD\n\nGenerate the SMPrivilegedExecutables plist dictionary for multiple executables. Also copy the DMGInstallHelper into place and have it signed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335629\n", "files": ["browser/app/Makefile.in", "browser/app/macbuild/Contents/Info.plist.in", "build/moz.configure/update-programs.configure", "taskcluster/config.yml"], "git_node": "7511dd08db8c3e9d43b3efb908e79097f5f4d01e", "git_parents": ["8b8e8cff4cf64163c62beb234e1a896e046e85be"], "node": "16f3528e6cfbea17b3d2cb360b31aaf323f61b24", "parents": ["8ef7a4eda3b86938364fe1b47851bcd600a56755"], "tags": []}, {"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031817: Part 4 - Add a build time debug option to enable Install from DMG in debug builds  a=RyanVM DONTBUILD\n\nPreviously the install from DMG functionality was only available in release builds which complicates development and debugging. Add --enable-dmg-install-helper-debug to uncomplicate things.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300316\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335630\n", "files": ["build/moz.configure/update-programs.configure", "toolkit/xre/moz.build", "toolkit/xre/nsAppRunner.cpp"], "git_node": "ecb6a7450b01e5fe115f19b7c01961ec662f4e78", "git_parents": ["7511dd08db8c3e9d43b3efb908e79097f5f4d01e"], "node": "58799076fad9adf0f061776e621e447edc7084c1", "parents": ["16f3528e6cfbea17b3d2cb360b31aaf323f61b24"], "tags": []}, {"author": "iain holm