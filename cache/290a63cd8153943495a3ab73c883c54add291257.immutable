74ca6578b01da5c65e3"], "tags": []}], "date": 1791469054, "git_changesets": ["6f341fbdf9df7e659fb046546e65ad577aff4b65", "d07441a9058290e111be1aee1b23ded36c9aa47c"], "user": "ffxbld@lando.moz.tools"}, "757": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Remove unused AudioTrackListener direct listener methods  a=RyanVM DONTBUILD\n\nThe listener was not being added as a direct listener\nand had no NotifyRealtimeTrackData() method.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318657\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331382\n", "files": ["dom/media/encoder/MediaEncoder.cpp"], "git_node": "13848736ab6a472c49f6e6616c76b8b6b45322cd", "git_parents": ["d07441a9058290e111be1aee1b23ded36c9aa47c"], "node": "3b70e6d4e4f01606dbb0e9b790626cce647c1c7a", "parents": ["dd30e08dbaa33747e3e0decb65aa3c3f043876b6"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2034838 Delay track listener creation until they can be added to their track  a=RyanVM DONTBUILD\n\nThis means that the listener \u003c-\u003e encoder strong reference cycle is not created\nuntil the listener is registered for NotifyRemoved() to break the cycle and\nresolve mShutdownPromise.\n\nmAudioListener and mVideoListener are not reset because the lambda of\nVideoTrackListener::NotifyQueuedChanges() can later dereference\nmVideoListener.  That already implied that a single listener cannot be used on\nmore than one track (serially).  The same was also implied by NotifyRemoved()\nresolving a single shutdown promise for each listener.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318660\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331383\n", "files": ["dom/media/encoder/MediaEncoder.cpp", "dom/media/encoder/MediaEncoder.h"], "git_node": "038753403e2603eefde85f0d6598a52b5e834bf1", "git_parents": ["13848736ab6a472c49f6e6616c76b8b6b45322cd"], "node": "34bde7025652479a589996af77c3e75aae9e9ad0", "parents": ["3b70e6d4e4f01606dbb0e9b790626cce647c1c7a"], "tags": []}], "date": 1791488772, "git_changesets": ["13848736ab6a472c49f6e6616c76b8b6b45322cd", "038753403e2603eefde85f0d6598a52b5e834bf1"], "user": "rvandermeulen@mozilla.com"}, "758": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041479 - Let content tooltips use content's preferred color scheme.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D306594\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330994\n", "files": ["browser/base/content/browser-init.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "a3db02ed59d83f5df9a4ca18fa5d7193122e863c", "git_parents": ["038753403e2603eefde85f0d6598a52b5e834bf1"], "node": "8b62e46e7abbe7cb74ed508b579b5b1fc6abab3d", "parents": ["34bde7025652479a589996af77c3e75aae9e9ad0"], "tags": []}], "date": 1791488794, "git_changesets": ["a3db02ed59d83f5df9a4ca18fa5d7193122e863c"], "user": "rvandermeulen@mozilla.com"}, "759": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2071379 - Destroy PlatformPipeLink on the IO thread,  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329611\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331710\n", "files": ["xpcom/io/AsyncPlatformPipes.cpp"], "git_node": "4e2dea5e243d5531906fad84fa537655c3ec1e03", "git_parents": ["a3db02ed59d83f5df9a4ca18fa5d7193122e863c"], "node": "a3b945622d119d63a7d62e99ed344ecdef1a3936", "parents": ["8b62e46e7abbe7cb74ed508b579b5b1fc6abab3d"], "tags": []}], "date": 1791488816, "git_changesets": ["4e2dea5e243d5531906fad84fa537655c3ec1e03"], "user": "rvandermeulen@mozilla.com"}, "760": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998887 - Do navigation for form submission asynchronously.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302828\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331608\n", "files": ["devtools/client/webconsole/test/browser/browser_webconsole_message_categories.js", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/base/nsDocShellLoadState.h", "docshell/base/nsIDocShell.idl", "docshell/test/mochitest/test_double_submit.html", "dom/events/test/test_submitevent_on_form.html", "dom/html/HTMLFormElement.cpp", "dom/html/test/file_forms_submit_async_navigation_pref.html", "dom/html/test/forms/test_double_submit.html", "dom/html/test/mochitest.toml", "dom/html/test/test_forms_submit_async_navigation_pref.html", "modules/libpref/init/StaticPrefList.yaml", "netwerk/base/nsILoadGroup.idl", "netwerk/base/nsLoadGroup.cpp", "testing/web-platform/meta/html/browsers/browsing-the-web/navigating-across-documents/009.html.ini", "testing/web-platform/meta/html/semantics/forms/form-submission-0/form-double-submit-input-type-change.html.ini", "testing/web-platform/meta/html/semantics/forms/form-submission-0/reparent-form-during-planned-navigation-task.html.ini", "testing/web-platform/meta/html/semantics/links/links-created-by-a-and-area-elements/htmlanchorelement_noopener.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-form-reload.html.ini", "testing/web-platform/meta/navigation-api/navigate-event/navigate-form-requestSubmit.html.ini", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/009.html", "testing/web-platform/tests/html/browsers/browsing-the-web/navigating-across-documents/010.tentative.html", "testing/web-platform/tests/html/semantics/forms/form-submission-0/form-double-submit-requestsubmit.html", "testing/web-platform/tests/navigation-api/navigate-event/navigate-form-reload.html", "toolkit/components/passwordmgr/test/browser/head.js"], "git_node": "2bd68ecf5bb26e6a0b8a19a2aece1d7a67582d41", "git_parents": ["4e2dea5e243d5531906fad84fa537655c3ec1e03"], "node": "3d508162af6fde40bb8ae8bb67c596d15f19969a", "parents": ["a3b945622d119d63a7d62e99ed344ecdef1a3936"], "tags": []}], "date": 1791488890, "git_changesets": ["2bd68ecf5bb26e6a0b8a19a2aece1d7a67582d41"], "user": "rvandermeulen@mozilla.com"}, "761": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057436 - Deal with transparency not being available in nsMenuPopupFrame's sizing code.  a=RyanVM DONTBUILD\n\nThis is a regression from bug 1933181. Before that patch,\nCalcWidgetBounds would look at mWidget-\u003eGetTransparencyMode(), which GTK\noverrides to \"opaque\" on a non-composited screen:\n\nWe could look at nsMenuPopupFrame's widget instead, but that is finicky\nbecause it means the bounds that we pass to the widget creation code\nwould be wrong. I think it's better to compute the right bounds, and we\nalready expose the right bit via LookAndFeel, so use that.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322435\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331273\n", "files": ["layout/xul/nsMenuPopupFrame.cpp", "layout/xul/nsMenuPopupFrame.h"], "git_node": "e94b7b047046d8ca36a6b8d284e570819d8a214c", "git_parents": ["2bd68ecf5bb26e6a0b8a19a2aece1d7a67582d41"], "node": "cf1b38b0f42a4d3b47f5ef19fd109b04d9e06f5b", "parents": ["3d508162af6fde40bb8ae8bb67c596d15f19969a"], "tags": []}], "date": 1791489542, "git_changesets": ["e94b7b047046d8ca36a6b8d284e570819d8a214c"], "user": "rvandermeulen@mozilla.com"}, "762": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076917: Prevent unexpected magic values in ArgumentsObject  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330059\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330933\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/vm/ArgumentsObject-inl.h", "js/src/vm/ArgumentsObject.h", "js/src/vm/EnvironmentObject-inl.h", "js/src/vm/EnvironmentObject.h"], "git_node": "f7610604788975a72710d2027796027408acbef2", "git_parents": ["e94b7b047046d8ca36a6b8d284e570819d8a214c"], "node": "32ae609904cc832b43a3159b9d1aa0a08042d67e", "parents": ["cf1b38b0f42a4d3b47f5ef19fd109b04d9e06f5b"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076917: Use stronger assertions for some isMagic checks  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330060\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330934\n", "files": ["js/src/jit/BaselineJIT.cpp", "js/src/jit/Jit.cpp", "js/src/jit/TrampolineNatives.cpp", "js/src/jit/WarpOracle.cpp"], "git_node": "8e841ad942de47ae687a9ed8cac181d06ee36a3a", "git_parents": ["f7610604788975a72710d2027796027408acbef2"], "node": "e34220f33829104253ec605784100ab5b5699513", "parents": ["32ae609904cc832b43a3159b9d1aa0a08042d67e"], "tags": []}], "date": 1791489565, "git_changesets": ["f7610604788975a72710d2027796027408acbef2", "8e841ad942de47ae687a9ed8cac181d06ee36a3a"], "user": "rvandermeulen@mozilla.com"}, "763": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064957 - Dialogs aren't enabled if there's no viewer.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321798\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331023\n", "files": ["dom/base/nsGlobalWindowOuter.cpp"], "git_node": "383eccbe4b915d40d43e3f277de5399949a11bfe", "git_parents": ["8e841ad942de47ae687a9ed8cac181d06ee36a3a"], "node": "e69c33be4430b901792d2ef0774f25b27802f15e", "parents": ["e34220f33829104253ec605784100ab5b5699513"], "tags": []}], "date": 1791503141, "git_changesets": ["383eccbe4b915d40d43e3f277de5399949a11bfe"], "user": "rvandermeulen@mozilla.com"}, "764": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021375 - Skip initial about:blank for session history.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320395\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331931\n", "files": ["docshell/base/nsDocShell.cpp", "dom/serviceworkers/test/browser-common.toml", "dom/serviceworkers/test/browser_initial_about_blank_subframe_history.js", "dom/serviceworkers/test/subframe_container.html", "dom/serviceworkers/test/subframe_message_navigate.html"], "git_node": "4494ad1956e8ebca18a06cc072d2c12674ee4aca", "git_parents": ["383eccbe4b915d40d43e3f277de5399949a11bfe"], "node": "fee99e029c10e648ca1a577d109b288a1e9a72e0", "parents": ["e69c33be4430b901792d2ef0774f25b27802f15e"], "tags": []}], "date": 1791503162, "git_changesets": ["4494ad1956e8ebca18a06cc072d2c12674ee4aca"], "user": "rvandermeulen@mozilla.com"}, "765": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067649 - Don't assert on the cross-process blur combination in RecvBlurToParent.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322333\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331021\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "d224071dc81374ff8ff85aef2dc7c36908658abf", "git_parents": ["4494ad1956e8ebca18a06cc072d2c12674ee4aca"], "node": "115fbe47f7c4f55e3df41dd28c266364b124a571", "parents": ["fee99e029c10e648ca1a577d109b288a1e9a72e0"], "tags": []}], "date": 1791503184, "git_changesets": ["d224071dc81374ff8ff85aef2dc7c36908658abf"], "user": "rvandermeulen@mozilla.com"}, "766": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2065919 - Check shutdown again before async write on read fulfill  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322987\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331103\n", "files": ["dom/streams/ReadableStreamPipeTo.cpp", "testing/web-platform/tests/streams/piping/crashtests/shutdown.html"], "git_node": "f3e10d14eaf09a4e5d7efa34b902ff54a62ee91c", "git_parents": ["d224071dc81374ff8ff85aef2dc7c36908658abf"], "node": "da5297a9ff5f2e146eba19ea0a9b2de2282f4cbb", "parents": ["115fbe47f7c4f55e3df41dd28c266364b124a571"], "tags": []}], "date": 1791503205, "git_changesets": ["f3e10d14eaf09a4e5d7efa34b902ff54a62ee91c"], "user": "rvandermeulen@mozilla.com"}, "767": {"changesets": [{"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066051 - Part 1: Report the shutdown phase from the content classifier's blocker state  a=RyanVM\n\nGetState() returned nullptr, so every AsyncShutdownTimeout annotation for this\nblocker reads \"state\":\"(none)\" and says nothing about how far the teardown\ngot.\n\nReport the init phase and the live engine count, so the annotation says which\nhalf of BlockShutdown was still outstanding.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321356\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331094\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp"], "git_node": "948f4024224c17bea6bbcd34397b03e829f26544", "git_parents": ["f3e10d14eaf09a4e5d7efa34b902ff54a62ee91c"], "node": "d611998cede3346d2b3c96ebbbffbd7c2b5612c4", "parents": ["da5297a9ff5f2e146eba19ea0a9b2de2282f4cbb"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066051 - Part 2: Don't wait for the build queue to drain before lifting the shutdown blocker  a=RyanVM\n\nThis patch makes the ContentClassifierService::BlockShutdown() to clear\nthe blocker synchronizely, which resolves the shutdown hangs.\n\nNothing on the background queue needs to finish before shutdown proceeds.\nEvery closure re-checks mInitPhase under mLock before touching service state and\nbails once the phase leaves InitSucceeded. So we can drop the fence and lift\nthe blocker synchronously.\n\nAlso set mInitPhase before ShutdownRSClient() rather than after it.\nShutdownRSClient cleared the engine containers under its own lock and then\nreleased it, and the phase was only set under a second acquisition, so a build\nclosure already waiting on mLock could pass its gate in that window and\nrepopulate everything that had just been cleared.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321357\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331095\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/ContentClassifierService.h", "toolkit/components/content-classifier/moz.build", "toolkit/components/content-classifier/test/unit/test_shutdown_blocker.js", "toolkit/components/content-classifier/test/unit/xpcshell.toml"], "git_node": "078fb0ec8799318f22ce9dcae867639f9f0cbbd7", "git_parents": ["948f4024224c17bea6bbcd34397b03e829f26544"], "node": "e581f1fd19cb17875e0d2eb20426ba918bf36d64", "parents": ["d611998cede3346d2b3c96ebbbffbd7c2b5612c4"], "tags": []}], "date": 1791503229, "git_changesets": ["948f4024224c17bea6bbcd34397b03e829f26544", "078fb0ec8799318f22ce9dcae867639f9f0cbbd7"], "user": "rvandermeulen@mozilla.com"}, "768": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066051 - Add missing nsComponentManagerUtils.h include. a=bustage\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp"], "git_node": "b14265dabd4aced056cdf00485c6ce424eecbcff", "git_parents": ["078fb0ec8799318f22ce9dcae867639f9f0cbbd7"], "node": "d8234a286ec9224d0a1cff71f4d5648c8584147f", "parents": ["e581f1fd19cb17875e0d2eb20426ba918bf36d64"], "tags": []}], "date": 1791505481, "git_changesets": ["b14265dabd4aced056cdf00485c6ce424eecbcff"], "user": "rvandermeulen@mozilla.com"}, "769": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066051 - Register the ContentClassifierService XPCOM component. a=bustage\n\nTaken from bug 2039046 part 1; test_shutdown_blocker.js gets the service through this contract ID.\n", "files": ["toolkit/components/content-classifier/components.conf"], "git_node": "5754304a50685558cb008d6219da8b753492ff5b", "git_parents": ["b14265dabd4aced056cdf00485c6ce424eecbcff"], "node": "28c7feb25a3274cbaf10d1fe0411172efded701d", "parents": ["d8234a286ec9224d0a1cff71f4d5648c8584147f"], "tags": []}], "date": 1791513102, "git_changesets": ["5754304a50685558cb008d6219da8b753492ff5b"], "user": "rvandermeulen@mozilla.com"}, "770": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054565: Leave keystrokes that carry no Command modifier to native windows that have focus on macOS.  a=RyanVM DONTBUILD\n\nThe Edit \u003e Delete menu item carries the forward delete key as its shortcut, with no modifiers, because it is wired to the XUL key element with keycode=\"VK_DELETE\". Since bug 2036608 the item's action is delete: with no target, so it travels the macOS responder chain, and since bug 2040851 the item is always enabled. While a native window such as an NSSavePanel sheet has focus, AppKit therefore matches the forward delete key against our menu item and performs delete: instead of leaving the keystroke alone. The panel's filename field reads delete: as \"delete the current selection\", so with a collapsed caret nothing happens at all and the keystroke is spent.\n\nNative text fields read keys that arrive without a Command modifier as plain editing or navigation keys, so leave those keys to the window that has focus. Shortcuts that include Command are still handled here, which is what lets native fields respond to Command+C/V/X/Z/A.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316554\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330988\n", "files": ["widget/cocoa/nsMenuBarX.mm"], "git_node": "92b864b961d38011a30c3ff85b0cb02b8019b994", "git_parents": ["5754304a50685558cb008d6219da8b753492ff5b"], "node": "aa7a09f25df2e27cc2a12754decba80a7cb5469b", "parents": ["28c7feb25a3274cbaf10d1fe0411172efded701d"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060306: Skip menu-bar key-equivalent processing for keystrokes that carry no Command modifier on macOS.  a=RyanVM DONTBUILD\n\nSince bug 2040851 the standard Edit menu items are always enabled, so AppKit matches the Edit \u003e Delete item, whose shortcut is the forward delete key with no modifiers, on every forward delete keypress. While a Gecko window has focus the item does not run its command, because gMenuItemsExecuteCommands is NO, but AppKit still flashes the menu title on each match and that cost is paid per keystroke. A small standalone AppKit test app that mimics this setup drains forward delete events at roughly 53 ms each with the item enabled, against roughly 2 ms with it disabled or with the keystroke left alone, so holding forward delete deletes far more slowly than the keyboard repeat rate the OS is set to.\n\nHandle only shortcuts that include Command in the menu bar, whichever window has focus, and leave plain keys to that window. Menu items were already kept from running their commands while a Gecko window has focus, and a shortcut that Gecko does not handle still reaches the menu bar afterwards through nsCocoaWindow::PostHandleKeyEvent, so what goes away here is the menu flash for these keys.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316558\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330989\n", "files": ["widget/cocoa/nsMenuBarX.mm"], "git_node": "9d1abcaffdd0f825d02aeeeccf7f6bbe5fbf3c6d", "git_parents": ["92b864b961d38011a30c3ff85b0cb02b8019b994"], "node": "7744cb30c232bd208221c0663798ededa0ad9433", "parents": ["aa7a09f25df2e27cc2a12754decba80a7cb5469b"], "tags": []}], "date": 1791514032, "git_changesets": ["92b864b961d38011a30c3ff85b0cb02b8019b994", "9d1abcaffdd0f825d02aeeeccf7f6bbe5fbf3c6d"], "user": "rvandermeulen@mozilla.com"}, "771": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043963: Use the live cursor location for macOS mouseEntered/mouseExited events.  a=RyanVM DONTBUILD\n\nOn macOS 26 the locationInWindow reported on mouseEntered and mouseExited NSEvents appears, in the cases we have been able to capture, not to match where the cursor actually is. The reported point was offset from the live cursor position (most often down and to the right) by a variable amount, and did not seem to line up with any position the cursor had recently occupied. We have not been able to fully determine the cause. It does not look like event-processing latency, since the affected events were handled almost immediately and the cursor appeared to be stationary at the time, so our best guess is that the coordinate is computed incorrectly for these events on this OS version, but we have not been able to corroborate that from outside AppKit.\n\nScreenLocationForEvent already treats mouse-move event locations as untrustworthy and uses the live [NSEvent mouseLocation] instead (bug 443178). This change does the same for mouseEntered and mouseExited, which avoids relying on the suspect coordinate regardless of where it actually comes from.\n\nWithout this, the suspect enter coordinate appears to be recorded as the last known mouse location, and a subsequently synthesized mouse move then seems to re-apply :hover to an element offset from where the pointer actually left the window. The most visible result is a UI element such as a background tab that looks hovered after the cursor has moved out the top edge of the window, which is what this bug reports.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309202\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330972\n", "files": ["widget/cocoa/nsCocoaUtils.mm"], "git_node": "b59f32b7bbf7ec9dc8dc4e823478d65f93ff563e", "git_parents": ["9d1abcaffdd0f825d02aeeeccf7f6bbe5fbf3c6d"], "node": "9c594a96fc7d8873aac1a402478f2623e2ff4abd", "parents": ["7744cb30c232bd208221c0663798ededa0ad9433"], "tags": []}], "date": 1791514055, "git_changesets": ["b59f32b7bbf7ec9dc8dc4e823478d65f93ff563e"], "user": "rvandermeulen@mozilla.com"}, "772": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062172 - Propagate TLS errors through TLSTransportLayer,  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323506\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331058\n", "files": ["netwerk/protocol/http/TLSTransportLayer.cpp", "netwerk/protocol/http/TLSTransportLayer.h", "netwerk/test/httpserver/NodeServer.sys.mjs", "netwerk/test/unit/test_cert_verification_failure.js", "netwerk/test/unit/test_websocket_fails_2.js"], "git_node": "2ea6e9c06af25a7ffa4939fd3aa2a91129698d5d", "git_parents": ["b59f32b7bbf7ec9dc8dc4e823478d65f93ff563e"], "node": "778791590dac24a8a8964b709ddfdc71add40b06", "parents": ["9c594a96fc7d8873aac1a402478f2623e2ff4abd"], "tags": []}], "date": 1791514092, "git_changesets": ["2ea6e9c06af25a7ffa4939fd3aa2a91129698d5d"], "user": "rvandermeulen@mozilla.com"}, "773": {"changesets": [{"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2071499 [Linux] Don't crash when rendering to hidden X11 window   a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325823\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331016\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "fc71451ec66789