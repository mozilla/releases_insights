 "2cc1c2b3aeb9cd70ca23f97d0c44a3a67f08c932", "git_parents": ["6b66898a2c5177727ed9a8f9191f30fe444ee6c6"], "node": "452711d2e52cc01448677f5fc9d38ee89e6a11d1", "parents": ["ca971f482f8121d4b11f0e26419673ffed875c5b"], "tags": []}], "date": 1792262105, "git_changesets": ["2cc1c2b3aeb9cd70ca23f97d0c44a3a67f08c932"], "user": "rvandermeulen@mozilla.com"}, "989": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080118 - Make nsAuthSSPI refcounting thread-safe on esr153. a=bustage\n", "files": ["extensions/auth/nsAuthSSPI.h"], "git_node": "986f0f73a1c8a9e7de52ab992f3b96d33f98ad24", "git_parents": ["2cc1c2b3aeb9cd70ca23f97d0c44a3a67f08c932"], "node": "3eed83019ba8838a5d7436402c1557145c6832fc", "parents": ["452711d2e52cc01448677f5fc9d38ee89e6a11d1"], "tags": []}], "date": 1792266555, "git_changesets": ["986f0f73a1c8a9e7de52ab992f3b96d33f98ad24"], "user": "rvandermeulen@mozilla.com"}, "990": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052463 - [devtools] Skip 4 devtools tests on macos1500 a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310298\n", "files": ["devtools/client/shared/components/test/chrome/chrome.toml", "devtools/client/storage/test/browser.toml"], "git_node": "a26a57df6d5193a9d78025550be9e515fa365a1e", "git_parents": ["986f0f73a1c8a9e7de52ab992f3b96d33f98ad24"], "node": "383046608187d28180d93d173f4f768b90f09297", "parents": ["3eed83019ba8838a5d7436402c1557145c6832fc"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1780998 - Exit fullscreen in windows.update() when the widget already reports another state, and re-enable browser_ext_windows_update.js on mac Intel a=RyanVM\n\nBug 1780876 made Window.setState() clear window.fullScreen when the widget and the\nDOM disagree about being fullscreen, but that guard is unreachable for the request it\nwas written for: when the widget reports STATE_NORMAL while the DOM still has\nfullScreen set, the \"expectedState == initialState\" fast path above it returns first,\nso windows.update({state: \"normal\"}) did nothing and the window stayed fullscreen.\n\nThe fast path now also requires the DOM to agree about being fullscreen. Making the\ncondition simply \"&& !window.fullScreen\" would instead have sent an update to\n\"fullscreen\" on an already-fullscreen window through the guard below, exiting\nfullscreen and immediately re-entering it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318270\n", "files": ["browser/components/extensions/parent/ext-browser.js", "browser/components/extensions/test/browser/browser-windows.toml"], "git_node": "d50fa3f1e0d19b46a77686712fcea7e428dc824b", "git_parents": ["a26a57df6d5193a9d78025550be9e515fa365a1e"], "node": "c988b1569c17775bb40a75f663c4008dccf8b594", "parents": ["383046608187d28180d93d173f4f768b90f09297"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1780998 - Restore the browser window size in browser_ext_windows_create_hidpi.js, so that it does not leave a window wider than the screen for the rest of browser-windows.toml a=test-only\n\nSetting layout.css.devPixelsPerPx to 3 raises the window's minimum width to 1500\nand grows the window to it; popping the pref does not shrink it back. The later\ntests in the manifest then run with a window wider than the screen on the macOS\n10.15 pool, where macOS constrains it back and browser_ext_windows_update.js\nfails on the mismatch.\n\nFixed in the test that grows the window rather than the one that trips over it,\nsince it breaks testPositionBoundaryCheck too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317529\n", "files": ["browser/components/extensions/test/browser/browser_ext_windows_create_hidpi.js"], "git_node": "a49953782f7829b5f92d7211d18a784fa87e7f92", "git_parents": ["d50fa3f1e0d19b46a77686712fcea7e428dc824b"], "node": "2adadc5f31aef87ea441bb9e1d5f2b653e497867", "parents": ["c988b1569c17775bb40a75f663c4008dccf8b594"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2015004 - Don't hide bookmarks toolbar items using a stale visible-item count a=RyanVM\n\nAn item added to the bookmarks toolbar can be hidden although it fits, because\nthe visibility update applies a count measured before the item existed. A hidden\nitem is not hit-testable, so clicks aimed at it fall through to the toolbar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317524\n", "files": ["browser/components/places/content/browserPlacesViews.js"], "git_node": "352869eb6d7affb71d2cded57411c32af4373637", "git_parents": ["a49953782f7829b5f92d7211d18a784fa87e7f92"], "node": "de56bec48a3a987c9c1ca38e2d973e54042f83c1", "parents": ["2adadc5f31aef87ea441bb9e1d5f2b653e497867"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1760099 - Skip test_backgroundupdate_exitcodes.js on Windows opt builds on ESR153. a=test-only\n", "files": ["toolkit/mozapps/update/tests/unit_background_update/xpcshell.toml"], "git_node": "8e6f0d009ec61e35871ff59fd4a72bbf8c413ac9", "git_parents": ["352869eb6d7affb71d2cded57411c32af4373637"], "node": "5b4ffda7a62b3a88e3288e362c86d349141315b5", "parents": ["de56bec48a3a987c9c1ca38e2d973e54042f83c1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996306 - Annotate the storage-access-headers.tentative.https.sub.window.html retry subtests as intermittent on ESR153. a=test-only\n\nMatches the expectations main picked up from wpt-syncs.\n", "files": ["testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini"], "git_node": "83e1213dfac7def2625f265067eda1f6c28e0ef8", "git_parents": ["8e6f0d009ec61e35871ff59fd4a72bbf8c413ac9"], "node": "1a3667c2fccb75f219d67cc984f4cf40f07d8bde", "parents": ["5b4ffda7a62b3a88e3288e362c86d349141315b5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1862496 - Mark overscroll-behavior-root.html as intermittent on Windows debug on ESR153. a=test-only\n", "files": ["testing/web-platform/meta/css/css-overscroll-behavior/overscroll-behavior-root.html.ini"], "git_node": "fe16e7665b9c79c86d7c620bdf609b3f42834c4d", "git_parents": ["83e1213dfac7def2625f265067eda1f6c28e0ef8"], "node": "c71f779c0cffea2b68321a2a0e6d1142d89004c5", "parents": ["1a3667c2fccb75f219d67cc984f4cf40f07d8bde"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023385 - Mark the cookieStore_set_path.https.window.html empty path subtest as intermittent on Windows and Linux opt on ESR153. a=test-only\n", "files": ["testing/web-platform/meta/cookiestore/cookieStore_set_path.https.window.js.ini"], "git_node": "9bf5011493d56baf17282957a619558c46fe24f4", "git_parents": ["fe16e7665b9c79c86d7c620bdf609b3f42834c4d"], "node": "bbc2693f6d69fc2efeac1e9971f3ba73fd1480b4", "parents": ["c71f779c0cffea2b68321a2a0e6d1142d89004c5"], "tags": []}], "date": 1792271288, "git_changesets": ["a26a57df6d5193a9d78025550be9e515fa365a1e", "d50fa3f1e0d19b46a77686712fcea7e428dc824b", "a49953782f7829b5f92d7211d18a784fa87e7f92", "352869eb6d7affb71d2cded57411c32af4373637", "8e6f0d009ec61e35871ff59fd4a72bbf8c413ac9", "83e1213dfac7def2625f265067eda1f6c28e0ef8", "fe16e7665b9c79c86d7c620bdf609b3f42834c4d", "9bf5011493d56baf17282957a619558c46fe24f4"], "user": "rvandermeulen@mozilla.com"}, "991": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082311 - Make \u003ciframe\u003e and friends inert in \u003csvg:use\u003e.  a=RyanVM DONTBUILD\n\nLower risk fix.\n\nOriginal Revision: