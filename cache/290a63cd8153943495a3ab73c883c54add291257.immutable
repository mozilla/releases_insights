n system principal pages when devtools.chrome.enabled is locked to false.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328621\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333807\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/contextMenu/browser_contextmenu_inspect.js"], "git_node": "e68aa1ea02847580524d5347587094e9af09fd30", "git_parents": ["07adc614770743ff6cd774b9ea1ce98ae4d9a7b5"], "node": "a422061302961d6e7c7966d8cac44bfcbf5a70fe", "parents": ["0a8b12689aea98deeaef181b3c39a74a489f3804"], "tags": []}], "date": 1792092010, "git_changesets": ["2fcc9e7a84188f76cc422637934f7d26046787b6", "07adc614770743ff6cd774b9ea1ce98ae4d9a7b5", "e68aa1ea02847580524d5347587094e9af09fd30"], "user": "rvandermeulen@mozilla.com"}, "951": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078167.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332051\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333924\n", "files": ["toolkit/components/places/BookmarkHTMLUtils.sys.mjs", "toolkit/components/places/PlacesUtils.sys.mjs", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/browser/browser_BrowserUtils.js"], "git_node": "ce34cf186279411fa79a3bb412685fd0804e07c8", "git_parents": ["e68aa1ea02847580524d5347587094e9af09fd30"], "node": "126c3c3673a74bac3e1f3000dbd034a7363ea5f7", "parents": ["a422061302961d6e7c7966d8cac44bfcbf5a70fe"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075126.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332088\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333925\n", "files": ["browser/base/content/browser-siteIdentity.js", "browser/base/content/test/siteIdentity/browser.toml", "browser/base/content/test/siteIdentity/browser_identityBlock_drag.js"], "git_node": "95c3a7aace3cbe9ea21c7d9e05643b13653d3bb5", "git_parents": ["ce34cf186279411fa79a3bb412685fd0804e07c8"], "node": "f16e3d8fda3706e9e8490a90d02dbb50ad68ceb2", "parents": ["126c3c3673a74bac3e1f3000dbd034a7363ea5f7"], "tags": []}], "date": 1792092037, "git_changesets": ["ce34cf186279411fa79a3bb412685fd0804e07c8", "95c3a7aace3cbe9ea21c7d9e05643b13653d3bb5"], "user": "rvandermeulen@mozilla.com"}, "952": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081560: Keep APZ input bridges alive during synchronous calls (ESR153 uplift).  a=RyanVM DONTBUILD\n\nCombines D333501 and D333952 for ESR153 uplift.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333501\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334128\n", "files": ["gfx/layers/apz/public/APZInputBridge.h", "gfx/layers/apz/public/IAPZCTreeManager.h", "gfx/layers/apz/src/APZCTreeManager.h", "gfx/layers/apz/test/gtest/TestAPZInputBridge.cpp", "gfx/layers/apz/test/gtest/moz.build", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerChild.h", "gfx/layers/ipc/APZInputBridgeChild.cpp"], "git_node": "cdd031c6b8887e218699c879eb55887ab63fb4ab", "git_parents": ["95c3a7aace3cbe9ea21c7d9e05643b13653d3bb5"], "node": "7c9a578e898eb9153236536daf9544bdad52a718", "parents": ["f16e3d8fda3706e9e8490a90d02dbb50ad68ceb2"], "tags": []}], "date": 1792092064, "git_changesets": ["cdd031c6b8887e218699c879eb55887ab63fb4ab"], "user": "rvandermeulen@mozilla.com"}, "953": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082092: Limit length of regexp literals in CheckPatternSyntaxImpl  a=RyanVM\n\nI'm not including the test because the source file is 2GB, it needs at least 4GB more memory, and has a runtime measured in minutes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333940\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334161\n", "files": ["js/src/irregexp/RegExpAPI.cpp"], "git_node": "c9286836bea762ebd4b1497d2aaaae5954c3f0bf", "git_parents": ["cdd031c6b8887e218699c879eb55887ab63fb4ab"], "node": "ba7ef61fbfd5ebdb65de9f2064dc49330c03a7ad", "parents": ["7c9a578e898eb9153236536daf9544bdad52a718"], "tags": []}], "date": 1792092087, "git_changesets": ["c9286836bea762ebd4b1497d2aaaae5954c3f0bf"], "user": "rvandermeulen@mozilla.com"}, "954": {"changesets": [{"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074589 - Hide the Inspect context menu item on system principal pages when devtools.chrome.enabled is locked to false. a=RyanVM DONTBUILD\" for causing devtools failures @ browser_toolbox_chrome_debugging_disabled.js\n\nThis reverts commit e68aa1ea02847580524d5347587094e9af09fd30.\n\nRevert \"Bug 2074589 - Disable DevTools options checkboxes for locked prefs.  a=RyanVM DONTBUILD\"\n\nThis reverts commit 07adc614770743ff6cd774b9ea1ce98ae4d9a7b5.\n\nRevert \"Bug 2074589 - Don't debug system principal tabs when devtools.chrome.enabled is locked to false.  a=RyanVM DONTBUILD\"\n\nThis reverts commit 2fcc9e7a84188f76cc422637934f7d26046787b6.\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/contextMenu/browser_contextmenu_inspect.js", "devtools/client/framework/devtools-browser.js", "devtools/client/framework/devtools.js", "devtools/client/framework/local-tab-commands-factory.js", "devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_chrome_debugging_disabled.js", "devtools/client/framework/test/browser_toolbox_options_locked_pref.js", "devtools/client/framework/toolbox-options.js", "devtools/server/actors/watcher/browsing-context-helpers.sys.mjs", "devtools/server/actors/webbrowser.js", "devtools/shared/commands/commands-factory.js", "devtools/shared/commands/target/tests/browser_target_command_various_descriptors.js"], "git_node": "467b030d19952ae616abb3b841e3becc92de93b0", "git_parents": ["c9286836bea762ebd4b1497d2aaaae5954c3f0bf"], "node": "aa49d5526297ef1a8b6b1f627933204dad40dc10", "parents": ["ba7ef61fbfd5ebdb65de9f2064dc49330c03a7ad"], "tags": []}], "date": 1792096266, "git_changesets": ["467b030d19952ae616abb3b841e3becc92de93b0"], "user": "pstanciu@mozilla.com"}, "955": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068902 - Use __builtin_prefetch for absl::PrefetchToLocalCacheForWrite on x86-64.  a=diannaS DONTBUILD\n\nWithout PRFCHW, abseil emits a hard-coded prefetchw on the assumption that CPUs lacking it treat the opcode as\na no-op. 64-bit NetBurst CPUs (Pentium 4 / Xeon family 15) raise #UD instead, crashing protobuf at startup.\nLet the compiler pick the instruction: prefetcht0 by default, prefetchw when the target guarantees it. The\nnon-GNU SSE fallback gets the same treatment. Written in the shape intended for upstream.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330758\n\n(cherry picked from commit 0f49952df11d9d3b4452a01d48e6333bedc9ec2f)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334302\n", "files": ["third_party/abseil-cpp/absl/base/prefetch.h", "third_party/abseil-cpp/moz-patch-stack/0019.patch"], "git_node": "3e50860a175cde8229fa4199e0f830d5184aad8e", "git_parents": ["467b030d19952ae616abb3b841e3becc92de93b0"], "node": "911f6ed094484fe4821bdb6585c7b6079fab117d", "parents": ["aa49d5526297ef1a8b6b1f627933204dad40dc10"], "tags": []}], "date": 1792115967, "git_changesets": ["3e50860a175cde8229fa4199e0f830d5184aad8e"], "user": "rvandermeulen@mozilla.com"}, "956": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079036 - Clamp damage area in nsTableCellFrame::DidSetComputedStyle.  a=RyanVM\n\n(original patch provided by clauditor)\n\nThe col-span clamp in nsTableCellFrame::DidSetComputedStyle here is sufficient\nto fix the reported issue; but given the complexity of table and border-collapse\ncode in general, the precaution of clamping in nsTableFrame::ExpandBCDamageArea\nseems worthwhile for a little extra hardening.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332732\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334292\n", "files": ["layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableFrame.cpp", "testing/web-platform/tests/css/css-tables/crashtests/border-collapse-dynamic-crash.html"], "git_node": "1b903d7aaa6c1803e9a121179acc3a2b11f67acb", "git_parents": ["3e50860a175cde8229fa4199e0f830d5184aad8e"], "node": "6ecb80ba63abb52c6bd2da3474fee0f7358e2c8f", "parents": ["911f6ed094484fe4821bdb6585c7b6079fab117d"], "tags": []}], "date": 1792116055, "git_changesets": ["1b903d7aaa6c1803e9a121179acc3a2b11f67acb"], "user": "rvandermeulen@mozilla.com"}, "957": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Don't debug system principal tabs when devtools.chrome.enabled is locked to false.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328619\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333805\n", "files": ["devtools/client/framework/devtools-browser.js", "devtools/client/framework/devtools.js", "devtools/client/framework/local-tab-commands-factory.js", "devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_chrome_debugging_disabled.js", "devtools/client/framework/toolbox.js", "devtools/client/shared/test/shared-head.js", "devtools/server/actors/watcher/browsing-context-helpers.sys.mjs", "devtools/server/actors/webbrowser.js", "devtools/shared/commands/commands-factory.js", "devtools/shared/commands/target/tests/browser_target_command_various_descriptors.js"], "git_node": "093854e0ac079e3a418b93d7b676d4ee339138a7", "git_parents": ["1b903d7aaa6c1803e9a121179acc3a2b11f67acb"], "node": "aeed41ad732e6049ca3ce4e5bdaca09879d48ae9", "parents": ["6ecb80ba63abb52c6bd2da3474fee0f7358e2c8f"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Disable DevTools options checkboxes for locked prefs.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328620\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333806\n", "files": ["devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_options_locked_pref.js", "devtools/client/framework/toolbox-options.js"], "git_node": "8058ee59b084debaeae596e8d40c8af02e7bd5a2", "git_parents": ["093854e0ac079e3a418b93d7b676d4ee339138a7"], "node": "195bd583ea4ab1040c7c522a2d47e1aa42d3b8f1", "parents": ["aeed41ad732e6049ca3ce4e5bdaca09879d48ae9"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Hide the Inspect context menu item on system principal pages when devtools.chrome.enabled is locked to false.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328621\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333807\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/contextMenu/browser_contextmenu_inspect.js"], "git_node": "9029a3ab64aa0345d275a1e729ab7f62e2a48bbe", "git_parents": ["8058ee59b084debaeae596e8d40c8af02e7bd5a2"], "node": "da52f8ffc5eb82afa1223a86df8ddbf64daf1cae", "parents": ["195bd583ea4ab1040c7c522a2d47e1aa42d3b8f1"], "tags": []}], "date": 1792165655, "git_changesets": ["093854e0ac079e3a418b93d7b676d4ee339138a7", "8058ee59b084debaeae596e8d40c8af02e7bd5a2", "9029a3ab64aa0345d275a1e729ab7f62e2a48bbe"], "user": "rvandermeulen@mozilla.com"}, "958": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update HSTS HPKP -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334647\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "a50450023fa56fc8f38b50844d17c068b43c352a", "git_parents": ["9029a3ab64aa0345d275a1e729ab7f62e2a48bbe"], "node": "348eefe0a28c52dcb8b06b58070aeb9f94dcfae4", "parents": ["da52f8ffc5eb82afa1223a86df8ddbf64daf1cae"], "tags": []}], "date": 1792178706, "git_changesets": ["a50450023fa56fc8f38b50844d17c068b43c352a"], "user": "rvandermeulen@mozilla.com"}, "959": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081789 - Record max-age-too-low as its own result in the HSTS probe results artifact. a=NPOTB DONTBUILD\n\nHosts sending a max-age below the minimum, including an explicit max-age=0 opt-out, are recorded as no-header,\nindistinguishable from hosts that send no header at all. Failure streaks are unaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333708\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "ed5f5ee7db3631eba716d86601f5a821a15544f0", "git_parents": ["a50450023fa56fc8f38b50844d17c068b43c352a"], "node": "f9afc1c99afa165189310ef52ff2e4d3a745740f", "parents": ["348eefe0a28c52dcb8b06b58070aeb9f94dcfae4"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081789 - Load the preloaded intermediate certificates before probing hosts for the HSTS preload list. a=NPOTB DONTBUILD\n\nFirefox fills in intermediates a server leaves out of its chain from the security-state/intermediates Remote\nSettings collection, but the probe runs without them, so those hosts fail with SEC_ERROR_UNKNOWN_ISSUER and\nare recorded as connection failures. This patch syncs the collection into a profile in the script's working\ndirectory and imports the certificates before probing. Without a profile-before-change notification before\nexit, including when the script fails, xpcshell crashes at shutdown once the imported certificates are in use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333709\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "56a3a3b428c3e50c973ff94bc8bc5a35be23aa9c", "git_parents": ["ed5f5ee7db3631eba716d86601f5a821a15544f0"], "node": "1244119d9c5cc5722c368d1ea1c9388983b63d80", "parents": ["f9afc1c99afa165189310ef52ff2e4d3a745740f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082069 - Retry hosts that answered HEAD without an HSTS header with GET when updating the HSTS preload list. a=NPOTB DONTBUILD\n\nSome servers only send Strict-Transport-Security on GET responses, so they were recorded as no-header. After\nthe retry pass, hosts that answered without a header (other than 429) are probed again with GET, and a header\nfound that way replaces the HEAD result. Their records in the probe results artifact carry get: true. Both\nmethods now finish as soon as the headers arrive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333923\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "2942f8ecdf82f85c4d2c193cdb0013a5812dd27c", "git_parents": ["56a3a3b428c3e50c973ff94bc8bc5a35be23aa9c"], "node": "0584092c54ed7010c876e661da46e6406fa1e74c", "parents": ["1244119d9c5cc5722c368d1ea1c9388983b63d80"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081896 - Run the HSTS and HPKP updates in the weekly periodic-file-update task on ESR branches. a=NPOTB DONTBUILD\n\nThe pinning-update cron no longer runs on mozilla-esr153, so ESR branches get one repo-update revision a week,\nas on esr115. On ESR, periodic-file-update runs on b-linux with the pinning update's max-run-time. The HSTS\nupdate now reads the previous probe results from the index route of the task running it, so failure streaks\ncarry over in either task; esr153's start over once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333848\n", "files": [".cron.yml", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh", "taskcluster/gecko_taskgraph/transforms/repo_update.py", "taskcluster/kinds/repo-update/kind.yml"], "git_node": "be2cbdc4a662089271fce776ca0828824259c4d6", "git_parents": ["2942f8ecdf82f85c4d2c193cdb0013a5812dd27c"], "node": "4224f7ed3757d2dec1c0156b99bddab5fa050141", "parents": ["0584092c54ed7010c876e661da46e6406fa1e74c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081896 - Stop adding the repo-update approval tag to the generated repo-update commit messages. a=NPOTB DONTBUILD\n\nRelease managers review and approve the revision anyway, and Lando rewrites the message when it lands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334191\n", "files": ["taskcluster/docker/periodic-updates/runme.sh", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": "8861ba73a064e2336f882e6146284efe68c1a16c", "git_parents": ["be2cbdc4a662089271fce776ca0828824259c4d6"], "node": "1aea87136a9754e8abd0e554f06f6fa95b4f25f8", "parents": ["4224f7ed3757d2dec1c0156b99bddab5fa050141"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082223 - Log through console.createInstance instead of dump() when updating the HSTS preload list. a=NPOTB DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333953\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": "0efa1b47f56c4e1a45aa64acd15e3e5f5be72078", "git_parents": ["8861ba73a064e2336f882e6146284efe68c1a16c"], "node": "c1e39fc4f46f546c9ae541ceaff421d52b3a4494", "parents": ["1aea87136a9754e8abd0e554f06f6fa95b4f25f8"], "tags": []}], "date": 1792181105, "git_changesets": ["ed5f5ee7db3631eba716d86601f5a821a15544f0", "56a3a3b428c3e50c973ff94bc8bc5a35be23aa9c", "2942f8ecdf82f85c4d2c193cdb0013a5812dd27c", "be2cbdc4a662089271fce776ca0828824259c4d6", "8861ba73a064e2336f882e6146284efe68c1a16c", "0efa1b47f56c4e1a45aa64acd15e3e5f5be72078"], "user": "rvandermeulen@mozilla.com"}, "960": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054192 - [devtools] Ignore updates for network message which are not in the Message state. .  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320369\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334526\n", "files": ["devtools/client/webconsole/reducers/messages.js", "devtools/client/webconsole/test/node/store/messages.test.js"], "git_node": "3791137e390753fa97a2012c840299ed4b145fc2", "git_parents": ["0efa1b47f56c4e1a45aa64acd15e3e5f5be72078"], "node": "46740480bda1cb77ff43a779f8e7a15565b81024", "parents": ["c1e39fc4f46f546c9ae541ceaff421d52b3a4494"], "tags": []}], "date": 1792253733, "git_changesets": ["3791137e390753fa97a2012c840299ed4b145fc2"], "user": "rvandermeulen@mozilla.com"}, "961": {"changesets": [{"author": "Willem Kaufmann \u003cwillem.kaufmann@gmail.com\u003e", "branch": "default", "desc": "Bug 2079806 - Shut down `CookieStore` when its global is torn down.  a=RyanVM DONTBUILD\n\nWhile a window is in the `bfcache`, `CookieStoreNotifier` queues cookie\nchange events in `mDelayedDOMEvents`, and each event holds a strong\nreference to the window. When the `bfcache` entry was evicted, nothing\nreleased the queue. The notifier is not cycle collected, and\n`CookieStore::Shutdown()` only ran from unlink and the destructor, which\na page holding cookieStore never reached. As a result, the window leaked\nas a ghost window for the lifetime of its content process.\n\nShut the `CookieStore` down in `DisconnectFromOwner()` and clear the\nqueued events when the notifier is disentangled to prevent the leaks.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332068\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334494\n", "files": ["dom/cookiestore/CookieStore.cpp", "dom/cookiestore/CookieStore.h", "dom/cookiestore/CookieStoreNotifier.cpp", "netwerk/cookie/test/browser/browser.toml", "netwerk/cookie/test/browser/browser_cookieStore_bfcache_leak.js"], "git_node": "9c7338699312c6d8f9399f0feef809b1dceb7719", "git_parents": ["3791137e390753fa97a2012c840299ed4b145fc2"], "node": "9520fe9958aa7a8d6ef115c9372981bdfbfaf907", "parents": ["46740480bda1cb77ff43a779f8e7a15565b81024"], "tags": []}], "date": 1792253757, "git_changesets": ["9c7338699312c6d8f9399f0feef809b1dceb7719"], "user": "rvandermeulen@mozilla.com"}, "962": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081230: revert head_rev overriding from bug 2026291  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334563\n", "files": ["taskcluster/gecko_taskgraph/actions/release_promotion.py"], "git_node": "90b7dcbb6af47072f95b831e4cc33298b6a72e7f", "git_parents": ["9c7338699312c6d8f9399f0feef809b1dceb7719"], "node": "09fc1d55ee336034f043a832f0fee5eafcd5ff04", "parents": ["9520fe9958aa7a8d6ef115c9372981bdfbfaf907"], "tags": []}], "date": 1792253784, "git_changesets": ["90b7dcbb6af47072f95b831e4cc33298b6a72e7f"], "user": "rvandermeulen@mozilla.com"}, "963": {"changesets": [{"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2079809 - TriggerInitialTranslation should handle errors correctly.  a=RyanVM DONTBUILD\n\nAccording to crash data, it isn't enough to handle errors.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333069\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334375\n", "files": ["dom/l10n/DocumentL10n.cpp"], "git_node": "c1acbd0a7656558d1d6d04e3475000394b920433", "git_parents": ["90b7dcbb6af47072f95b831e4cc33298b6a72e7f"], "node": "de6907b22f81b88a6486c6343919b877702af223", "parents": ["09fc1d55ee336034f043a832f0fee5eafcd5ff04"], "tags": []}], "date": 1792254032, "git_changesets": ["c1acbd0a7656558d1d6d04e3475000394b920433"], "user": "rvandermeulen@mozilla.com"}, "964": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2081262. Null check the solid color item in PresShell::AddCanvasBackgroundColorItem.  a=RyanVM DONTBUILD\n\nMakeDisplayItem returns null when building an events-only list (eg inside an\nopacity: 0 stacking context), and we called SetIsCheckerboardBackground on it\nunconditionally.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333969\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334392\n", "files": ["layout/base/PresShell.cpp"], "git_node": "bb7079c8c339a67dd7b70e4c64be810b934f169d", "git_parents": ["c1acbd0a7656558d1d6d04e3475000394b920433"], "node": "f011b70b51135322661838aae7b93fedca0723fb", "parents": ["de6907b22f81b88a6486c6343919b877702af223"], "tags": []}], "date": 1792254056, "git_changesets": ["bb7079c8c339a67dd7b70e4c64be810b934f169d"], "user": "rvandermeulen@mozilla.com"}, "965": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068395 - Make densifySparseElements update the initialized length infallibly.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334009\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334524\n", "files": ["js/src/vm/NativeObject.cpp", "js/src/vm/NativeObject.h", "js/src/vm/Shape.cpp"], "git_node": "d2ecc935ca7ca4def2bec52a042af7b82abde87a", "git_parents": ["bb7079c8c339a67dd7b70e4c64be810b934f169d"], "node": "2a36e6928b4d4fabd7d89d52b5a3d11a69d32570", "parents": ["f011b70b51135322661838aae7b93fedca0723fb"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068395 - Call the add-property hook before densifying sparse elements.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334010\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334525\n", "files": ["js/src/jit-test/tests/arrays/densify-sparse-oom.js", "js/src/vm/NativeObject.cpp"], "git_node": "f70b69425a19018c37bf606bbc2e1a6e430c1bc6", "git_parents": ["d2ecc935ca7ca4def2bec52a042af7b82abde87a"], "node": "bff8c9bde1e9d824e54eee24168c74e3d4eed435", "parents": ["2a36e6928b4d4fabd7d89d52b5a3d11a69d32570"], "tags": []}], "date": 1792254091, "git_changesets": ["d2ecc935ca7ca4def2bec52a042af7b82abde87a", "f70b69425a19018c37bf606bbc2e1a6e430c1bc6"], "user": "rvandermeulen@mozilla.com"}, "966": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079054 - Use the current document in ScreenOrientation::MaybeChanged after firing mozorientationchange.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334050\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334559\n", "files": ["dom/base/ScreenOrientation.cpp"], "git_node": "7ef212825ff479e48b95c92f14338f1fc3e05991", "git_parents": ["f70b69425a19018c37bf606bbc2e1a6e430c1bc6"], "node": "bf40691138b3260b820bc6e3569deef802e6afdd", "parents": ["bff8c9bde1e9d824e54eee24168c74e3d4eed435"], "tags": []}], "date": 1792254119, "git_changesets": ["7ef212825ff479e48b95c92f14338f1fc3e05991"], "user": "rvandermeulen@mozilla.com"}, "967": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079255.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334059\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334464\n", "files": ["layout/generic/nsBlockFrame.cpp", "testing/web-platform/tests/css/css-multicol/crashtests/block-break-before.html"], "git_node": "2b29843b88842048c790bb38928016c0b7d194f5", "git_parents": ["7ef212825ff479e48b95c92f14338f1fc3e05991"], "node": "baeae68bc0ba2bcdc1917018909f13d55cea37a9", "parents": ["bf40691138b3260b820bc6e3569deef802e6afdd"], "tags": []}], "date": 1792254144, "git_changesets": ["2b29843b88842048c790bb38928016c0b7d194f5"], "user": "rvandermeulen@mozilla.com"}, "968": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081985 - Make sure @position-try inside scope doesn't allow more than it should.  a=RyanVM DONTBUILD\n\nEnsure that we're allowed in all the rules we're supposed to. Fix some\nplaces which allowed a rule in style but not in scope, which seems\nan oversight (see next patch for more reliable fix).\n\nThe test has one failure, which is for @page inside @scope, because\nthat's the only case where inner rules can be less restrictive than\nouter rules.\n\nThat failure will really go away when we ever make `size` a proper\nshorthand for width and height, but we can fix in a follow-up if\nneeded by splitting the bitflag check in two.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334116\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334500\n", "files": ["servo/components/style/parser.rs", "servo/components/style/properties/data.py", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/stylesheets/mod.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-cascade/declaration-context.html.ini", "testing/web-platform/tests/css/css-cascade/declaration-context.html"], "git_node": "12063b9e1740f16834dc61b4724639d310842de0", "git_parents": ["2b29843b88842048c790bb38928016c0b7d194f5"], "node": "738270633a63619ffb2821263cbf1c7fc3a55f3f", "parents": ["baeae68bc0ba2bcdc1917018909f13d55cea37a9"], "tags": []}], "date": 1792254171, "git_changesets": ["12063b9e1740f16834dc61b4724639d310842de0"], "user": "rvandermeulen@mozilla.com"}, "969": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068410 - Update the initialized length before the length in ArraySetLength.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334008\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334515\n", "files": ["js/src/builtin/Array.cpp", "js/src/jit-test/tests/arrays/set-length-oom.js", "js/src/vm/ArrayObject.h"], "git_node": "5c4edfa8a8967c1ab799bc749135929304896768", "git_parents": ["12063b9e1740f16834dc61b4724639d310842de0"], "node": "96e674dcefaeae2d17dbbe2ad6a46d704cf3cf56", "parents": ["738270633a63619ffb2821263cbf1c7fc3a55f3f"], "tags": []}], "date": 1792254198, "git_changesets": ["5c4edfa8a8967c1ab799bc749135929304896768"], "user": "rvandermeulen@mozilla.com"}, "970": {"changesets": [{"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2081998 - Flush before retriving body for scrollingElement in quirks mode.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333968\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334631\n", "files": ["dom/animation/ScrollTimeline.cpp", "dom/base/Document.cpp", "dom/base/Document.h"], "git_node": "d2ce2a313e229ba521b8bfce98ee5e368fd5b21e", "git_parents": ["5c4edfa8a8967c1ab799bc749135929304896768"], "node": "391ed0ce596fbab7cd6c67cd3768874a0f125a8f", "parents": ["96e674dcefaeae2d17dbbe2ad6a46d704cf3cf56"], "tags": []}], "date": 1792258043, "git_changesets": ["d2ce2a313e229ba521b8bfce98ee5e368fd5b21e"], "user": "rvandermeulen@mozilla.com"}, "971": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082005 - Initialize cx in FirstSubsumedFrame's move constructor.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333987\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334508\n", "files": ["js/public/Stack.h", "js/src/jsapi-tests/testSavedStacks.cpp"], "git_node": "4f3d4ec50d3a3b069724c97ebfdb446241c7cf4a", "git_parents": ["d2ce2a313e229ba521b8bfce98ee5e368fd5b21e"], "node": "32a6f6253d77face20cae7d0637ed9baa9459d7c", "parents": ["391ed0ce596fbab7cd6c67cd3768874a0f125a8f"], "tags": []}], "date": 1792258070, "git_changesets": ["4f3d4ec50d3a3b069724c97ebfdb446241c7cf4a"], "user": "rvandermeulen@mozilla.com"}, "972": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2082072 - Bring back the old annotation for window.screen,  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334052\n", "files": ["dom/webidl/Window.webidl"], "git_node": "0649b373c2638c9a859dd7790758a789c1c29ac8", "git_parents": ["4f3d4ec50d3a3b069724c97ebfdb446241c7cf4a"], "node": "2940b009d760daea0cbf319a9dc5a7966137aaf8", "parents": ["32a6f6253d77face20cae7d0637ed9baa9459d7c"], "tags": []}], "date": 1792258147, "git_changesets": ["0649b373c2638c9a859dd7790758a789c1c29ac8"], "user": "rvandermeulen@mozilla.com"}, "973": {"changesets": [{"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079560 - Avoid a quadratic slowdown in mbsdiff on long duplicated data.  a=RyanVM DONTBUILD\n\nThe macOS universal XUL holds its architecture-independent data twice. When\nthe copy mbsdiff is following is only 1-10 bytes worse than the other one,\nthe scan loop calls search() once per byte of the run, and the 156.x -\u003e 158.0\nXUL diffs took over 5 hours. Taking any exact match of at least 64 KiB ends\nthat crawl; the output only changes where the scan would otherwise get stuck.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332128\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334599\n", "files": ["other-licenses/bsdiff/bsdiff.c"], "git_node": "9129a8affc7c30120d869116d25b1c844884d6a1", "git_parents": ["0649b373c2638c9a859dd7790758a789c1c29ac8"], "node": "da0ecf06cdf620b17d4672d95afb0c36b61fe766", "parents": ["2940b009d760daea0cbf319a9dc5a7966137aaf8"], "tags": []}], "date": 1792258171, "git_changesets": ["9129a8affc7c30120d869116d25b1c844884d6a1"], "user": "rvandermeulen@mozilla.com"}, "974": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080718: Always remove progress listeners on rejected promise.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333543\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334616\n", "files": ["dom/clients/manager/ClientOpenWindowUtils.cpp"], "git_node": "53bc04aa517dff19d3b0f37c81104b762ac27b9e", "git_parents": ["9129a8affc7c30120d869116d25b1c844884d6a1"], "node": "83a46680e4db3f502010167e6ceae9d60f460011", "parents": ["da0ecf06cdf620b17d4672d95afb0c36b61fe766"], "tags": []}], "date": 1792258194, "git_changesets": ["53bc04aa517dff19d3b0f37c81104b762ac27b9e"], "user": "rvandermeulen@mozilla.com"}, "975": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2081184 - Make `BrowserParent` verify `WidgetKeyboardEvent::mAlternativeCharCodes`  a=RyanVM DONTBUILD\n\nTo avoid performing unintended shortcuts or access keys due to bogus\nreply event, let's check whether the reply event's\n`mAlternativeCharCodes` matches with the original data.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333978\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334798\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "7ee1bc8de6615ceada95ad8f5a09797cb50b4baa"