d2b79e3859bb7c29", "parents": ["4e1820d597eb40c7df578430dd86c2b470f2f7d8"], "tags": []}], "date": 1792038063, "git_changesets": ["04a8d3d4af2d595e0a566849813a102abd43990a"], "user": "abutkovits@mozilla.com"}, "934": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Backed out 5 changesets (bug 2074589) for causing devtools failures in browser_net_prefs-reload.js. a=backout\n\nBacked out changeset e49d663367b1 (bug 2074589)\nBacked out changeset adb38dfa5943 (bug 2074589)\nBacked out changeset 300d13446b63 (bug 2074589)\nBacked out changeset de2a8aeb4fa1 (bug 2074589)\nBacked out changeset 20777dfcf502 (bug 2074589)\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/contextMenu/browser_contextmenu_inspect.js", "devtools/client/framework/devtools-browser.js", "devtools/client/framework/devtools.js", "devtools/client/framework/local-tab-commands-factory.js", "devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_chrome_debugging_disabled.js", "devtools/client/framework/test/browser_toolbox_options_locked_pref.js", "devtools/client/framework/toolbox-options.js", "devtools/client/framework/toolbox.js", "devtools/client/fronts/descriptors/tab.js", "devtools/client/shared/test/shared-head.js", "devtools/server/actors/watcher/browsing-context-helpers.sys.mjs", "devtools/server/actors/webbrowser.js", "devtools/shared/commands/commands-factory.js", "devtools/shared/commands/target/tests/browser_target_command_various_descriptors.js"], "git_node": "96d08a9f954584d467f22e53f728df62073847e8", "git_parents": ["e49d663367b159386f459cc1e34a5b0077923f78"], "node": "1e21cd029148854dbd329969107d4efab54e33e9", "parents": ["1796e559174978660ba35d87821d08bdf16a9ea9"], "tags": []}], "date": 1792067758, "git_changesets": ["96d08a9f954584d467f22e53f728df62073847e8"], "user": "rvandermeulen@mozilla.com"}, "935": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046798 - Fix a/ b/ file paths in zucchini patch 0024.  a=RyanVM DONTBUILD\n\nThe a/ b/ paths in vendored patch 0024 were incorrectly prefixed\nwith third_party/zucchini/chromium/. Correct them to the\nupstream-relative paths.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310325\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334080\n", "files": ["third_party/zucchini/chromium-shim/patches/0024-Detect-OOM-when-memory-mapping-fails-in-MappedFileRe.patch"], "git_node": "fcd6a6f2ca54c2fb5420d98ba84a8910fea88566", "git_parents": ["96d08a9f954584d467f22e53f728df62073847e8"], "node": "c876de459fcd02542beb1170fcadafc6394c981d", "parents": ["1e21cd029148854dbd329969107d4efab54e33e9"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046798 - Wrap zucchini entry points to catch exceptions.  a=RyanVM DONTBUILD\n\nIn the previous exception handling design, our SEH __try/__except only\ncovered the bodies of MappedPatch::Load and MappedPatch::ApplyUnsafe,\nand only partially.\n\nThis patch instead splits exception handling into two layers, each\ncovering a different concern:\n\n1. BEGIN_ENTRY_POINT / END_ENTRY_POINT: Wraps every entry point from\n   updater.cpp, catching any potential std::bad_alloc exception. Ensures\n   wrapped zucchini code returns an OOM status code upon standard\n   library allocation failures instead of crashing the process.\n\n2. BEGIN_PAGE_ERROR_TRY_EXCEPT / END_PAGE_ERROR_TRY_EXCEPT: Mirrors the\n   exception catching present in upstream zucchini::ApplyCommon to catch\n   page errors from mapped file I/O.\n\nWith the follow-up patch covering crc32, this ensures that our exception\nhandling covers as much zucchini surface as possible. This two-layer\nstructure also helps implement the follow-up patch that transitions to\nC++ exceptions, where layer 1 gets a cross-platform implementation\nwhereas layer 2 stays Windows-only.\n\nIn the current patch, layer 1 also covers CHECK failures, but it gets\nrestricted to C++ exceptions in a later patch.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308183\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334081\n", "files": ["third_party/zucchini/moz_zucchini.cc", "third_party/zucchini/moz_zucchini.h", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "38dfe7e992dd86e457670691cca1d1c6b8272b7b", "git_parents": ["fcd6a6f2ca54c2fb5420d98ba84a8910fea88566"], "node": "5353351c692b92b625aa99854617c1ac0d5e950e", "parents": ["c876de459fcd02542beb1170fcadafc6394c981d"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046798 - Wrap zucchini crc32 computation to catch exceptions.  a=RyanVM DONTBUILD\n\nThis patch extends the entry-point wrapping from the previous patch to\nalso cover crc32 computation. This requires changing the abstract\ninterface used by the updater for crc32 computations, so that we can\npropagate updater status codes that match with the failures raised from\nzucchini.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308184\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334082\n", "files": ["third_party/zucchini/moz_zucchini.cc", "third_party/zucchini/moz_zucchini.h", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "2ad0d19dbe1f33bb88f3954eac8270c7fbbfff87", "git_parents": ["38dfe7e992dd86e457670691cca1d1c6b8272b7b"], "node": "ce044a1df33aa4daa526fe3de8d555143f3f5c86", "parents": ["5353351c692b92b625aa99854617c1ac0d5e950e"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043122 - Remove Windows-only zucchini crash recovery.  a=RyanVM DONTBUILD\n\nThe updater is now resilient to crashes that occur while drafting a\npatch. We can safely remove the zucchini workaround that previously\ntried to mitigate these crashes at the zucchini level on Windows.\n\nThis workaround was less reliable than it pretended to be anyway,\nbecause moving the failure location around (like we do further in the\npatch stack) would make the CheckDestructor test fail. The root cause\nbeing that SEH has weaker guarantees on calling destructors than C++\nexception handling.\n\nUpdate tests accordingly. Now, only recovering from C++ std::bad_alloc\nexceptions must ensure that destructors are called and that we fail\ngracefully. CHECK failures are now immediate crashes that bypass updater\nrollback, so they are expected to leave .moz-draft files behind in\nnon-staged updates. It is the updater's responsibility to clean stale\n.moz-draft files during the next update.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324342\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334083\n", "files": ["third_party/zucchini/moz_zucchini.cc", "toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAllocDestructor_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheckDestructor_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheck_win.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "1199c45ef03e10ba59597e3e022e4383f884031e", "git_parents": ["2ad0d19dbe1f33bb88f3954eac8270c7fbbfff87"], "node": "5d840fb114d45f0aa09c78c2fac7406d882ac0d9", "parents": ["ce044a1df33aa4daa526fe3de8d555143f3f5c86"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043122 - Cross-platform handling of std::bad_alloc in zucchini.  a=RyanVM DONTBUILD\n\nThis patch extends std::bad_alloc recovery to macOS and Linux platforms,\nby replacing the previous Windows-only SEH-based zucchini crash recovery\nwith one based on C++ exceptions instead. To this end, we enable C++\nexceptions when compiling the zucchini library on all platforms,\nincluding Windows.\n\nWe make the updater fail with an OOM status code when std::bad_alloc\nfailures occur, allowing the updater to correctly assess the reason\nzucchini failed -- the updater behaves differently upon OOM failures.\n\nThis makes Windows crash recovery more reliable as well, because the\nguarantees around calling the destructors of C++ objects when unwinding\nare stronger with C++ exceptions than with SEH.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324343\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334084\n", "files": ["third_party/zucchini/moz.build", "third_party/zucchini/moz_zucchini.cc", "third_party/zucchini/moz_zucchini.h", "toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAlloc.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAllocDestructor.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAllocDestructor_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniBadAlloc_win.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheck.js", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheck_win.js", "toolkit/mozapps/update/tests/unit_update_binary/xpcshell_base.toml", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "ae4feb7dbdaf939f9a712fee73618a22b7fca20e", "git_parents": ["1199c45ef03e10ba59597e3e022e4383f884031e"], "node": "34920bf9e42a9b3a51b8fc0e9bbfa72a5dbe8064", "parents": ["5d840fb114d45f0aa09c78c2fac7406d882ac0d9"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043122 - Simulate zucchini test failures mid-patch-application.  a=RyanVM DONTBUILD\n\nMove the zucchini failure simulation used by updater tests into the\npatch-application loop, so tests exercise failures while the new image\nis still open and mapped. This is the worst case for updater recovery,\nso this patch increases our confidence in the recovery mechanisms.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310327\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334085\n", "files": ["third_party/zucchini/moz_zucchini.cc", "toolkit/mozapps/update/tests/unit_update_binary/marFailurePartialZucchiniCheck.js"], "git_node": "21a66bf16ad4573c2450cb3b989ba3325c414c90", "git_parents": ["ae4feb7dbdaf939f9a712fee73618a22b7fca20e"], "node": "64d861e15d0af0e5cd39e456bebe820b9988844b", "parents": ["34920bf9e42a9b3a51b8fc0e9bbfa72a5dbe8064"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975960 - Regenerate zucchini shim patches that diverged.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324878\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334086\n", "files": ["third_party/zucchini/chromium-shim/patches/0006-Define-only-the-required-functions-from-file_util.h.patch", "third_party/zucchini/chromium-shim/patches/0009-Limit-dependencies-in-file_path.cc.patch", "third_party/zucchini/chromium-shim/patches/0020-Limit-dependencies-in-foundation_util.mm.patch"], "git_node": "5f0617c10aeb610b5159cf1090494f4802f3a23f", "git_parents": ["21a66bf16ad4573c2450cb3b989ba3325c414c90"], "node": "1869ee6d826ff84967edc57f34b3d9acb7a72886", "parents": ["64d861e15d0af0e5cd39e456bebe820b9988844b"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975960 - Update zucchini vendoring to prepare for mingwclang support.  a=RyanVM DONTBUILD\n\n- base/files/file_util_win.cc: OpenFile() uses _SH_DENYNO, which the MSVC CRT\n  headers happen to expose transitively but mingw-w64 only declares in\n  \u003cshare.h\u003e.\n\n- base/base_paths_win.cc: \u003cKnownFolders.h\u003e is not found when cross-compiling,\n  as mingw-w64 spells the header knownfolders.h and the build host can have a\n  case-sensitive filesystem. Its only user, FOLDERID_ApplicationShortcuts in\n  the DIR_APP_SHORTCUTS case is already excluded under MOZ_ZUCCHINI.\n\n- components/zucchini/suffix_array_unittest.cc: libc++ ships no\n  std::char_traits\u003cunsigned char\u003e specialization, so\n  std::basic_string\u003cunsigned char\u003e cannot be instantiated. The test only ever\n  uses the alias as a sized random-access container (construction from an\n  iterator pair, begin/end/size), so under MOZ_ZUCCHINI it becomes\n  std::vector\u003cunsigned char\u003e.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324879\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334087\n", "files": ["third_party/zucchini/chromium-shim/patches/0025-Prepare-zucchini-sources-for-mingwclang-builds.patch", "third_party/zucchini/chromium/base/base_paths_win.cc", "third_party/zucchini/chromium/base/files/file_util_win.cc", "third_party/zucchini/chromium/components/zucchini/suffix_array_unittest.cc"], "git_node": "d544da05cffec1a320a30b9cf23d2d94ab5fc4b4", "git_parents": ["5f0617c10aeb610b5159cf1090494f4802f3a23f"], "node": "40a161d1dd490981e510e370fd00bac3bc6795cc", "parents": ["1869ee6d826ff84967edc57f34b3d9acb7a72886"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975960 - Add zucchini support for mingwclang builds.  a=RyanVM DONTBUILD\n\nZucchini uses SEH to catch the EXCEPTION_IN_PAGE_ERROR exceptions that\nWindows raises when an I/O error occurs while accessing a memory-mapped\nfile. MinGW compilers do not support SEH, which is why we were disabling\nzucchini in mingwclang builds.\n\nWe now deal with this the same way as our sandbox code: mozilla-config.h\nreplaces __try with if (true) and __except with else when compiling\nzucchini code. In MinGW builds, an I/O error on the mapped files thus\ncrashes updater.exe rather than making zucchini return an error status.\nThis is acceptable now that the updater is resilient to crashes that\noccur while drafting a patch (bug 2060275).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324618\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334088\n", "files": ["browser/config/mozconfigs/win32/mingwclang", "browser/config/mozconfigs/win64/mingwclang", "mozilla-config.h.in", "security/sandbox/moz.build", "third_party/zucchini/README.md", "third_party/zucchini/moz.build", "third_party/zucchini/moz_zucchini.cc"], "git_node": "49aaaedcabfdaa54b9c27f19b6865338be5e67f3", "git_parents": ["d544da05cffec1a320a30b9cf23d2d94ab5fc4b4"], "node": "8ccf90de6d3fba8a6bea1fdd0d5569685dedb92a", "parents": ["40a161d1dd490981e510e370fd00bac3bc6795cc"], "tags": []}], "date": 1792070025, "git_changesets": ["fcd6a6f2ca54c2fb5420d98ba84a8910fea88566", "38dfe7e992dd86e457670691cca1d1c6b8272b7b", "2ad0d19dbe1f33bb88f3954eac8270c7fbbfff87", "1199c45ef03e10ba59597e3e022e4383f884031e", "ae4feb7dbdaf939f9a712fee73618a22b7fca20e", "21a66bf16ad4573c2450cb3b989ba3325c414c90", "5f0617c10aeb610b5159cf1090494f4802f3a23f", "d544da05cffec1a320a30b9cf23d2d94ab5fc4b4", "49aaaedcabfdaa54b9c27f19b6865338be5e67f3"], "user": "rvandermeulen@mozilla.com"}, "936": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2077031. Don't copy the whole spec of every image URI when collecting image memory reports.  a=RyanVM DONTBUILD\n\nhttps://searchfox.org/firefox-main/rev/66b70484481af2e01d4da8bb33f4a756aba77d74/image/Image.cpp#77\n\nWe copy the full spec into every ImageMemoryCounter and only truncate it to 256\ncharacters, or throw it away when anonymizing, after all the counters have been\ncreated. We don't need to keep them all around.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330262\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333950\n", "files": ["image/Image.cpp", "image/Image.h", "image/imgLoader.cpp"], "git_node": "4af51073031f3015c8011c2001bbd360c821b7ab", "git_parents": ["49aaaedcabfdaa54b9c27f19b6865338be5e67f3"], "node": "3ec1998a901391fa415a4a688b7c4b54430a511a", "parents": ["8ccf90de6d3fba8a6bea1fdd0d5569685dedb92a"], "tags": []}], "date": 1792070053, "git_changesets": ["4af51073031f3015c8011c2001bbd360c821b7ab"], "user": "rvandermeulen@mozilla.com"}, "937": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059011.  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333567\n", "files": ["gfx/2d/DrawTargetCairo.cpp", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetSkia.cpp", "gfx/2d/DrawTargetSkia.h"], "git_node": "34ac6710510704953e46228dbf91a16362c88630", "git_parents": ["4af51073031f3015c8011c2001bbd360c821b7ab"], "node": "38a50ec0fee40b3948367b9f1bcba070687a1a6c", "parents": ["3ec1998a901391fa415a4a688b7c4b54430a511a"], "tags": []}], "date": 1792070075, "git_changesets": ["34ac6710510704953e46228dbf91a16362c88630"], "user": "rvandermeulen@mozilla.com"}, "938": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2079301  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332286\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333576\n", "files": ["gfx/layers/BufferTexture.cpp"], "git_node": "50e0b0d16735e642992dfbe741ae1c22274212fd", "git_parents": ["34ac6710510704953e46228dbf91a16362c88630"], "node": "afcbb4002fd9c6de3ad43fe0cc8b7910614d5f58", "parents": ["38a50ec0fee40b3948367b9f1bcba070687a1a6c"], "tags": []}], "date": 1792070098, "git_changesets": ["50e0b0d16735e642992dfbe741ae1c22274212fd"], "user": "rvandermeulen@mozilla.com"}, "939": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2079053 - Make sure that `HTMLEditor::CreateAnonymousElement` and `HTMLEditor::GetPositionAndDimensions` won't handle different document's node  a=RyanVM DONTBUILD\n\nIf the target node of resizers etc was moved into another document\nwhile we're initializing the native anonymous nodes, we may start to\nput some anonymous nodes into the new target's owner document.\nTherefore, the methods should return error in the case to make the\ncaller abort the initialization.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332618\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333935\n", "files": ["editor/libeditor/HTMLAnonymousNodeEditor.cpp"], "git_node": "7bdb09bce42b413280df63d0d532dbc335e6c733", "git_parents": ["50e0b0d16735e642992dfbe741ae1c22274212fd"], "node": "a995ad3157b9df15740eaacae466943b039f8f9f", "parents": ["afcbb4002fd9c6de3ad43fe0cc8b7910614d5f58"], "tags": []}], "date": 1792070123, "git_changesets": ["7bdb09bce42b413280df63d0d532dbc335e6c733"], "user": "rvandermeulen@mozilla.com"}, "940": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080581.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333454\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333955\n", "files": ["gfx/thebes/gfxTextRun.cpp"], "git_node": "d9b3b9c281f4d64b4b0ad4ce9f7272e6d2d56a5d", "git_parents": ["7bdb09bce42b413280df63d0d532dbc335e6c733"], "node": "09cb6396fb8f8db1bd422efa761f2fd7a08d42d0", "parents": ["a995ad3157b9df15740eaacae466943b039f8f9f"], "tags": []}], "date": 1792070145, "git_changesets": ["d9b3b9c281f4d64b4b0ad4ce9f7272e6d2d56a5d"], "user": "rvandermeulen@mozilla.com"}, "941": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2081549 - ImageDocument should use the right token list,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333622\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333652\n", "files": ["dom/html/ImageDocument.cpp"], "git_node": "a6644694b917b77e03429f2250c48c1fd90404b3", "git_parents": ["d9b3b9c281f4d64b4b0ad4ce9f7272e6d2d56a5d"], "node": "95826a8cdaa34e23d7c2e4a9efd2334e0b318ab5", "parents": ["09cb6396fb8f8db1bd422efa761f2fd7a08d42d0"], "tags": []}], "date": 1792070887, "git_changesets": ["a6644694b917b77e03429f2250c48c1fd90404b3"], "user": "rvandermeulen@mozilla.com"}, "942": {"changesets": [{"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996306 - Storage-Access-API: Fix intermittent test timeout in headers on slow clients a=test-only\n\nThe event listener unregistered too early when the wrong message\narrived before the expected one. This happened primarely on slow clients.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328217\n", "files": ["testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/tests/storage-access-api/helpers.js"], "git_node": "1d6244e3e9852b44667a4e067ec426ca0e0b905d", "git_parents": ["a6644694b917b77e03429f2250c48c1fd90404b3"], "node": "c3cc62a095ada7ad03b03765c9f011414acbd836", "parents": ["95826a8cdaa34e23d7c2e4a9efd2334e0b318ab5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041704 - Mark the binaryType-wrong-value.any.html?wpt_flags=h2 subtest as intermittently NOTRUN on all platforms on ESR153. a=test-only\n", "files": ["testing/web-platform/meta/websockets/binaryType-wrong-value.any.js.ini"], "git_node": "fb932ca36051a5f6031b6a0385592051a8b3c872", "git_parents": ["1d6244e3e9852b44667a4e067ec426ca0e0b905d"], "node": "f8bfb18fc87f11f01ae4b428e8285d73a55a1385", "parents": ["c3cc62a095ada7ad03b03765c9f011414acbd836"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054836 - Skip test_new_tab_on_restore.py on Windows on ESR153. a=test-only\n", "files": ["browser/components/sessionstore/test/marionette/manifest.toml"], "git_node": "fa265c873b1859f8f06b369ce4085502db0fc83b", "git_parents": ["fb932ca36051a5f6031b6a0385592051a8b3c872"], "node": "ac78be7ff66eece3de38724757dadc8c1e017d89", "parents": ["f8bfb18fc87f11f01ae4b428e8285d73a55a1385"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030788 - Skip browser_smartwindow_request_response_telemetry.js on Windows opt builds on ESR153. a=test-only DONTBUILD\n", "files": ["browser/components/aiwindow/ui/test/browser/browser.toml"], "git_node": "be9ea5890b35d229ff17cfc3826b58232fc3897f", "git_parents": ["fa265c873b1859f8f06b369ce4085502db0fc83b"], "node": "0584cd52eb8b1a655acf25a447fc188247b24012", "parents": ["ac78be7ff66eece3de38724757dadc8c1e017d89"], "tags": []}], "date": 1792073725, "git_changesets": ["1d6244e3e9852b44667a4e067ec426ca0e0b905d", "fb932ca36051a5f6031b6a0385592051a8b3c872", "fa265c873b1859f8f06b369ce4085502db0fc83b", "be9ea5890b35d229ff17cfc3826b58232fc3897f"], "user": "rvandermeulen@mozilla.com"}, "943": {"changesets": [{"author": "Max Emig \u003cmozilla@emigm.ax\u003e", "branch": "default", "desc": "Bug 1869124 - Streamline Windows event sound playback to avoid shutdown hangs.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329821\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334113\n", "files": ["widget/windows/nsSound.cpp", "widget/windows/nsSound.h", "widget/windows/nsdefs.h"], "git_node": "364a82320c184e0f3c9286ca2ff645ab58ee048e", "git_parents": ["be9ea5890b35d229ff17cfc3826b58232fc3897f"], "node": "96354913e9fbfbae779db614b14e630c4976de49", "parents": ["0584cd52eb8b1a655acf25a447fc188247b24012"], "tags": []}], "date": 1792079662, "git_changesets": ["364a82320c184e0f3c9286ca2ff645ab58ee048e"], "user": "rvandermeulen@mozilla.com"}, "944": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075354 - Force-close the SharedWorker MessagePort through MessagePortService when WorkerManagerCreatedRunnable fails, .  a=RyanVM DONTBUILD\n\nWhen a SharedWorker's creating actor goes away before WorkerManagerCreatedRunnable runs, its UniqueMessagePortId was never released and got force-closed on the background thread. MessagePort::ForceClose then created a same-process PBackgroundChild on the background thread itself, which ParentImpl::ShutdownBackgroundThread waits for forever, hanging shutdown at XPCOMShutdownThreads.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328958\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334139\n", "files": ["dom/workers/sharedworkers/SharedWorkerService.cpp"], "git_node": "381d5de663906ab2cc388e000460fae79ee2e6cf", "git_parents": ["364a82320c184e0f3c9286ca2ff645ab58ee048e"], "node": "e848e6ebbe35d547d86fc2693396fd1385606f7e", "parents": ["96354913e9fbfbae779db614b14e630c4976de49"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075354 - Assert when creating a PBackground child on the PBackground thread, .  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328959\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334140\n", "files": ["ipc/glue/BackgroundImpl.cpp"], "git_node": "975153c1d06294aa8ae10eadc5e83dd90647431d", "git_parents": ["381d5de663906ab2cc388e000460fae79ee2e6cf"], "node": "5d3e328b8a5bf7dea6f0a895dd131dcab70dfcb5", "parents": ["e848e6ebbe35d547d86fc2693396fd1385606f7e"], "tags": []}], "date": 1792079724, "git_changesets": ["381d5de663906ab2cc388e000460fae79ee2e6cf", "975153c1d06294aa8ae10eadc5e83dd90647431d"], "user": "rvandermeulen@mozilla.com"}, "945": {"changese