2c0f9", "git_parents": ["9dec1f68e4d37b64e18fb82b26f0473106f0cb2d"], "node": "e8289888c72529409aff087495258cbda5f4c894", "parents": ["2374196efc82e1a63067ceb33b323b035c395856"], "tags": []}], "date": 1791750009, "git_changesets": ["d8660f030327246bb770042c4292d92b4a52c0f9"], "user": "rvandermeulen@mozilla.com"}, "846": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2068400  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330578\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332741\n", "files": ["gfx/2d/Swizzle.cpp", "testing/web-platform/tests/css/filter-effects/feTile-01.html"], "git_node": "99dea4503b0753200754774acf116257048fb22f", "git_parents": ["d8660f030327246bb770042c4292d92b4a52c0f9"], "node": "8050bed045525b1d0e06cee4676e4f28cfdf21da", "parents": ["e8289888c72529409aff087495258cbda5f4c894"], "tags": []}], "date": 1791750031, "git_changesets": ["99dea4503b0753200754774acf116257048fb22f"], "user": "rvandermeulen@mozilla.com"}, "847": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2079069.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331506\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331791\n", "files": ["image/ImageWrapper.cpp", "image/MultipartImage.cpp"], "git_node": "50d1798f7e4eeaefb4497e4444faee03c3c3eefa", "git_parents": ["99dea4503b0753200754774acf116257048fb22f"], "node": "2e363d97fd4eb5460d9bd871b2c4401a8c3eaeb0", "parents": ["8050bed045525b1d0e06cee4676e4f28cfdf21da"], "tags": []}], "date": 1791750054, "git_changesets": ["50d1798f7e4eeaefb4497e4444faee03c3c3eefa"], "user": "rvandermeulen@mozilla.com"}, "848": {"changesets": [{"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2064552 - turn off jittests on macOS hardware machines, only run on VMs. a=test-only\n\nAlso make the jittest tasks on the macOS VMs tier 1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319650\n", "files": ["taskcluster/kinds/test/compiled.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml"], "git_node": "49767ec2730f96c483a9b3e37807b636067bce0b", "git_parents": ["50d1798f7e4eeaefb4497e4444faee03c3c3eefa"], "node": "25ea8bd81aa49e68342687dd6f2ead0092fd31f9", "parents": ["2e363d97fd4eb5460d9bd871b2c4401a8c3eaeb0"], "tags": []}], "date": 1791816049, "git_changesets": ["49767ec2730f96c483a9b3e37807b636067bce0b"], "user": "rvandermeulen@mozilla.com"}, "849": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2080271 - Make sure that we paint after .ready in fontface-descriptor-updates. r=layout-reviewers,boris,dshin a=test-only DONTBUILD\n\nSeems the screenshot without this captures the blank paint.\n\nThis works locally but checking on try as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332522\n", "files": ["testing/web-platform/tests/css/css-font-loading/fontface-descriptor-updates.html"], "git_node": "a8f094cfc68ff78263c7e87555d9fdf5da73cd0e", "git_parents": ["49767ec2730f96c483a9b3e37807b636067bce0b"], "node": "1c4198154ae4d7bbc22c23aa3d87bab6cebb0e07", "parents": ["25ea8bd81aa49e68342687dd6f2ead0092fd31f9"], "tags": []}], "date": 1791832056, "git_changesets": ["a8f094cfc68ff78263c7e87555d9fdf5da73cd0e"], "user": "rvandermeulen@mozilla.com"}, "850": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update remote-settings ct-logs -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332793\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "e056defc4b8d4c19f2d361043d8569c65cff7231", "git_parents": ["a8f094cfc68ff78263c7e87555d9fdf5da73cd0e"], "node": "1c25cd9cef46bfa80dbbd6f7c7149292d41369f1", "parents": ["1c4198154ae4d7bbc22c23aa3d87bab6cebb0e07"], "tags": []}], "date": 1791835963, "git_changesets": ["e056defc4b8d4c19f2d361043d8569c65cff7231"], "user": "rvandermeulen@mozilla.com"}, "851": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2041626 - Drop canceled requests in ModuleLoaderBase::CancelFetchingModules so a synchronous importESModule doesn't hang shutdown, .  a=RyanVM DONTBUILD\n\nChromeUtils.importESModule({global: \"current\"}) waits for in-flight module\nloads in the target global by spinning the event loop until\nModuleLoaderBase::HasFetchingModules() (i.e. until mFetchingModules is empty).\n\nCancelFetchingModules() canceled the in-flight requests but deliberately left\nthem in mFetchingModules, relying on their fetch/compile completions to remove\nthe entries later. During shutdown those completions never arrive, so\nHasFetchingModules() stays true forever and the spinning importESModule never\nreturns, hanging shutdown until the terminator kills the process (\"Shutdown\nhanging at step AppShutdownConfirmed\"). Because the importESModule call is on\nthe stack, its global is also kept alive, which surfaces as a leaked\nabout:preferences#experimental window.\n\nClear mFetchingModules after canceling the requests so HasFetchingModules()\nbecomes false and the spin can exit. A late fetch/compile completion is handled\ngracefully by OnFetchComplete's \"key not found in mFetchingModules\" path.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310889\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332857\n", "files": ["js/loader/ModuleLoaderBase.cpp"], "git_node": "133f8fcae398f1df7ff9a1eb20772392bd874be4", "git_parents": ["e056defc4b8d4c19f2d361043d8569c65cff7231"], "node": "de0d1dd45d89710e3f5520afe6e36fd43b0395c8", "parents": ["1c25cd9cef46bfa80dbbd6f7c7149292d41369f1"], "tags": []}], "date": 1791849730, "git_changesets": ["133f8fcae398f1df7ff9a1eb20772392bd874be4"], "user": "rvandermeulen@mozilla.com"}, "852": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2049056 - Don't keep loading preferences modules after the window has closed, .  a=RyanVM DONTBUILD\n\nbrowser/components/urlbar/tests/browser-quickactions/browser_commands.js opens\nabout:preferences#experimental through the \"labs\" quick action and closes the tab\nbefore it has loaded, then fails with \"leaked 1 window(s) until shutdown\n[url = about:preferences#experimental]\".\n\nmain.js loads its pane modules with the synchronous ChromeUtils.importESModule\n({ global: \"current\" }), which spins the event loop until the module graph has\nbeen fetched, so the tab can be closed part way through. Evaluation then resumes\nagainst a torn down window, and the modules imported after that point run their\nown top level code against it: they register Settings whose setup() adds pref and\nobserver service observers long after onUnload removed the ones that existed, and\ntabs-browsing.mjs throws a TypeError reaching for\nwindow.browsingContext.topChromeWindow.\n\nPreferences.addSetting has to refuse after unload as well, because no check at an\nimport site can help the module whose load was the spin: languages.mjs was\nalready in flight when the window went away, so it finishes and registers its\nsettings regardless, as does the rest of main.js.\n\nBug 2041626 stopped this spin from hanging shutdown outright; this is the\npost-unload execution that fix left behind.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321912\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332866\n", "files": ["browser/components/preferences/config/SettingPaneManager.mjs", "browser/components/preferences/main.js", "toolkit/content/preferences/Preferences.mjs", "toolkit/content/tests/chrome/test_preferencesBindings_setting_setup_teardown.html"], "git_node": "5126e1598868f4eb4eb8b6fbddc7fb4b4a841b71", "git_parents": ["133f8fcae398f1df7ff9a1eb20772392bd874be4"], "node": "87f017b3ae1d1701353309f1461c1091c40b2f97", "parents": ["de0d1dd45d89710e3f5520afe6e36fd43b0395c8"], "tags": []}], "date": 1791849758, "git_changesets": ["5126e1598868f4eb4eb8b6fbddc7fb4b4a841b71"], "user": "rvandermeulen@mozilla.com"}, "853": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2001695 - Ignore tooltip mouseouts from nodes we aren't tracking, .  a=RyanVM DONTBUILD\n\nnsXULTooltipListener is a process-wide singleton, so a mouseout belonging to\none chrome document cancels the tooltip timer armed for a node in another\nwindow. On Windows the mouse exit of the window below a newly created window\narrives just after the new window has started hovering something, so the\ntooltip never appears and nothing re-arms the timer.\n\nKeying the listener's state per top-level chrome window is the general fix and\nis left to bug 2067142; this guards the one path where the cross-window\ncancellation is user-visible.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321922\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332865\n", "files": ["layout/xul/nsXULTooltipListener.cpp", "toolkit/content/tests/chrome/chrome.toml"], "git_node": "6e499555d43dbaf902d547daa739ea88fcc9edcd", "git_parents": ["5126e1598868f4eb4eb8b6fbddc7fb4b4a841b71"], "node": "f4200976afe6184f588665136b4e4b351853ccdf", "parents": ["87f017b3ae1d1701353309f1461c1091c40b2f97"], "tags": []}], "date": 1791849781, "git_changesets": ["6e499555d43dbaf902d547daa739ea88fcc9edcd"], "user": "rvandermeulen@mozilla.com"}, "854": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040442 - Shut nsHttpHandler down explicitly rather than from its destructor.  a=RyanVM DONTBUILD\n\nnsHttp::DestroyAtomTable() was only reached from ~nsHttpHandler, which does not\nrun while anything else still holds a reference to the handler. The atom table\nthen still has its entries when its own static destructor runs at exit(), and\nreleasing their string buffers that late goes through NS_LogRelease in debug\nbuilds, which locks gTraceLog after it has already been destroyed.\n\nCall an explicit Shutdown() from the shutdown hook that already cleared\ngHttpHandler, so the teardown no longer depends on the refcount reaching zero.\n\nThe bug suggests the smaller fix of never destroying sAtomTable at all. That\nwould hide the symptom along with the crash: entries left this late mean\nsomething did not get torn down, and they would still be alive when\nNS_LogTerm() closes leak accounting, trading the crash for leak reports.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322116\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332982\n", "files": ["netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpHandler.h"], "git_node": "9c7be1b54c45a435e69dc397c5b2da4894ad24a7", "git_parents": ["6e499555d43dbaf902d547daa739ea88fcc9edcd"], "node": "a0b67cceb0f509070b297b558943934f67eb142c", "parents": ["f4200976afe6184f588665136b4e4b351853ccdf"], "tags": []}], "date": 1791850230, "git_changesets": ["9c7be1b54c45a435e69dc397c5b2da4894ad24a7"], "user": "rvandermeulen@mozilla.com"}, "855": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076013 - Clamp MAX_UNIFORM_BLOCK_SIZE to 64 KiB.  a=RyanVM DONTBUILD\n\nThis avoids excessive memory usage on certain websites on Linux with AMD hardware.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331063\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332799\n", "files": ["dom/canvas/WebGL2ContextState.cpp", "dom/canvas/WebGLTypes.h", "dom/canvas/test/webgl-mochitest/test_webgl2_uniform_block.html"], "git_node": "0dd2f0a5782f533531f81014696e61fe27a5ca08", "git_parents": ["9c7be1b54c45a435e69dc397c5b2da4894ad24a7"], "node": "650af152804c824532b3857a53ace3a41aa97611", "parents": ["a0b67cceb0f509070b297b558943934f67eb142c"], "tags": []}], "date": 1791850639, "git_changesets": ["0dd2f0a5782f533531f81014696e61fe27a5ca08"], "user": "rvandermeulen@mozilla.com"}, "856": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058653 - Don't mark through ephemeron edges until their target's zone is in the required state  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330132\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332986\n", "files": ["js/src/gc/Marking.cpp", "js/src/jit-test/tests/gc/bug-2058653.js"], "git_node": "25a0d112c8fec8923e25b822bfe7e8bf1c4b649c", "git_parents": ["0dd2f0a5782f533531f81014696e61fe27a5ca08"], "node": "08307deee216721536dab9fa4d8bec3e7a20d412", "parents": ["650af152804c824532b3857a53ace3a41aa97611"], "tags": []}], "date": 1791850666, "git_changesets": ["25a0d112c8fec8923e25b822bfe7e8bf1c4b649c"], "user": "rvandermeulen@mozilla.com"}, "857": {"changesets": [{"author": "Daniel Darnell \u003cdaniel@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2010071 - Add Thunderbird support to 'mach try'. r=conduit-reviewers,shtrom a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D294872\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333079\n", "files": ["tools/tryselect/lando.py", "tools/tryselect/push.py"], "git_node": "0c1832e4dd592999b66ecd7ffebaf90452a8658b", "git_parents": ["25a0d112c8fec8923e25b822bfe7e8bf1c4b649c"], "node": "e01caa2971636a8f37f8a5727854f0efaed99c7a", "parents": ["08307deee216721536dab9fa4d8bec3e7a20d412"], "tags": []}], "date": 1791855238, "git_changesets": ["0c1832e4dd592999b66ecd7ffebaf90452a8658b"], "user": "rvandermeulen@mozilla.com"}, "858": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064785 - Don't set content *_WHITESPACE flags on generated-content nodes in FrameConstructionItem::IsWhitespace.  a=RyanVM DONTBUILD\n\nWe never expect the *_WHITESPACE flags to be set on generated content, per the assertion at\nhttps://searchfox.org/firefox-main/rev/3c6e9f0700b5a702c6d3fde4306554d364adb213/layout/base/nsCSSFrameConstructor.cpp#7134-7135\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323217\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332987\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "72ea6ced61dcc75cffb731380ac4732b5e635ef6", "git_parents": ["0c1832e4dd592999b66ecd7ffebaf90452a8658b"], "node": "95f285ce7f02d4795d54bc56748bd910afd39d7a", "parents": ["e01caa2971636a8f37f8a5727854f0efaed99c7a"], "tags": []}], "date": 1791855261, "git_changesets": ["72ea6ced61dcc75cffb731380ac4732b5e635ef6"], "user": "rvandermeulen@mozilla.com"}, "859": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079209 - Make \"loaded as image\" part of the stylesheet cache key.  a=RyanVM DONTBUILD\n\nSince it determines whether subresources should load.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332249\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332893\n", "files": ["layout/style/Loader.cpp", "layout/style/Loader.h", "testing/web-platform/tests/svg/as-image/external-resource-data-url-sheet-helper.sub.svg", "testing/web-platform/tests/svg/as-image/external-resource-data-url-sheet.sub.html"], "git_node": "6265fedab6a87ab7cd37e266a8dd087afaad6232", "git_parents": ["72ea6ced61dcc75cffb731380ac4732b5e635ef6"], "node": "8d1e5e5c969867f6f67f4fe5d4a65717aac64414", "parents": ["95f285ce7f02d4795d54bc56748bd910afd39d7a"], "tags": []}], "date": 17918552