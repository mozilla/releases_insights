"lastpushid": 1413,
"pushes": {"1000": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2076415  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333965\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335014\n", "files": ["gfx/layers/AtomicRefCountedWithFinalize.h", "gfx/layers/client/TextureClient.cpp"], "git_node": "dec64d5ec6083f82fcba857687b7b972c6d7494c", "git_parents": ["d0900e246b35315370a1d9de9d41133cde11e7ab"], "node": "c641ae7dfdd3181d002285b8be988470de8bb20c", "parents": ["1e69ec50206c782b391cc34e08bcff47fa8e912c"], "tags": []}], "date": 1792370617, "git_changesets": ["dec64d5ec6083f82fcba857687b7b972c6d7494c"], "user": "rvandermeulen@mozilla.com"}, "1001": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2079311  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333981\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335016\n", "files": ["gfx/layers/BufferTexture.cpp", "gfx/layers/BufferTexture.h", "gfx/layers/client/TextureClient.cpp", "gfx/layers/client/TextureClient.h", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.h"], "git_node": "c62264c59f1b48d158ba0ed1b37f8d1600b2018c", "git_parents": ["dec64d5ec6083f82fcba857687b7b972c6d7494c"], "node": "17d171ae0032002e773982986b59cb3e3a10ae44", "parents": ["c641ae7dfdd3181d002285b8be988470de8bb20c"], "tags": []}], "date": 1792370638, "git_changesets": ["c62264c59f1b48d158ba0ed1b37f8d1600b2018c"], "user": "rvandermeulen@mozilla.com"}, "1002": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2078982 for esr153  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335019\n", "files": ["gfx/layers/wr/WebRenderBridgeChild.cpp", "gfx/wr/webrender/src/scene_builder_thread.rs"], "git_node": "e01b9a9e7b43602a4832b0e77c6b29de2dac9687", "git_parents": ["c62264c59f1b48d158ba0ed1b37f8d1600b2018c"], "node": "2032a98f003608d10fb909569332eb867f22cb63", "parents": ["17d171ae0032002e773982986b59cb3e3a10ae44"], "tags": []}], "date": 1792370658, "git_changesets": ["e01b9a9e7b43602a4832b0e77c6b29de2dac9687"], "user": "rvandermeulen@mozilla.com"}, "1003": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048551 - Fuzz all wrench reftest configs except linux. a=test-only\n\nAt this point I am spending more time annotating reftests and waiting for CI than doing productive work.\nIn practice we always accept fuzzy differences under 20 or so, and the majority of our fuzzy annotations are 5 or under. This patch picks linux (which has the fastest CI turnaround time) as the authoritative source where we keep pixel-perfect tests and all other platforms are given a base fuzziness allowance of 5. With this, we'll still need to fiddle with fuzzy threshold for most shader changes (especially on android and different flavors of windows), but not nearly as much as we do now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307488\n", "files": ["gfx/wr/wrench/src/reftest.rs"], "git_node": "c82296686ac98a7c92bc5dc5296f680878b6c880", "git_parents": ["e01b9a9e7b43602a4832b0e77c6b29de2dac9687"], "node": "7b1614947ef82626f0642dbd4b0489ca30a3ac32", "parents": ["2032a98f003608d10fb909569332eb867f22cb63"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057509 - Add a way to run a wrench test case with different device pixel scales. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314014\n", "files": ["gfx/wr/wrench/reftests/aa/reftest.list", "gfx/wr/wrench/reftests/backface/reftest.list", "gfx/wr/wrench/reftests/blend/reftest.list", "gfx/wr/wrench/reftests/border/reftest.list", "gfx/wr/wrench/reftests/boxshadow/reftest.list", "gfx/wr/wrench/reftests/clip/reftest.list", "gfx/wr/wrench/reftests/compositor-surface/reftest.list", "gfx/wr/wrench/reftests/compositor/reftest.list", "gfx/wr/wrench/reftests/crash/reftest.list", "gfx/wr/wrench/reftests/filters/reftest.list", "gfx/wr/wrench/reftests/gradient/reftest.list", "gfx/wr/wrench/reftests/image/reftest.list", "gfx/wr/wrench/reftests/mask/reftest.list", "gfx/wr/wrench/reftests/performance/reftest.list", "gfx/wr/wrench/reftests/scrolling/reftest.list", "gfx/wr/wrench/reftests/snap/reftest.list", "gfx/wr/wrench/reftests/split/reftest.list", "gfx/wr/wrench/reftests/text/reftest.list", "gfx/wr/wrench/reftests/tiles/reftest.list", "gfx/wr/wrench/reftests/transforms/reftest.list", "gfx/wr/wrench/src/reftest.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "1841ef433e8afa7bc7073ba76c708c251d49bed6", "git_parents": ["c82296686ac98a7c92bc5dc5296f680878b6c880"], "node": "110eb460b8e0b2a85c5a62f7545d8ce5493852a1", "parents": ["7b1614947ef82626f0642dbd4b0489ca30a3ac32"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057509 - Allow per-scale wrench reference images. a=test-only\n\nWith this change, when wrench loads a reference for a test run a certain scale (say 0.5), it will first look for foo-scale:0.5.png and fall back to foo.png if the former does not exist.\nThis enables declaring reftest at multiple scales and png reference images in a single line for example scale(1, 2, 0.5) == foo.yaml foo.png.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314024\n", "files": ["gfx/wr/wrench/reftests/gradient/linear-aligned-border-radius-scale0.51.png", "gfx/wr/wrench/reftests/gradient/linear-aligned-border-radius-scale1.51.png", "gfx/wr/wrench/reftests/gradient/linear-aligned-border-radius-scale2.png", "gfx/wr/wrench/reftests/gradient/reftest.list", "gfx/wr/wrench/src/reftest.rs"], "git_node": "d93278b278ddacc4636bfe27f28b2c4973933440", "git_parents": ["1841ef433e8afa7bc7073ba76c708c251d49bed6"], "node": "f29e877dd6aa5a882868fe45df560fa9f7b5b7e3", "parents": ["110eb460b8e0b2a85c5a62f7545d8ce5493852a1"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2059680 - Fix wrench scroll offsets and fixed position content at emulated device pixel scales. a=test-only\n\nThis one turned out to be an issue with the test harness rather than WebRender.\n\nWrench emulates a device pixel ratio by wrapping the root pipeline's content in a\nscale reference frame, but that reference frame is a child of the pipeline's root\nscroll node, so the implicit root reference frame and root scroll node are above\nthe scale. So two kinds of content escaped it:\n\n - The root scroll node's scroll offset (the root `scroll-offset` yaml key, sent\n   as ExternalScrollId(0)). Scroll offsets accumulate in the scrolled node's own\n   coordinate space, which is unscaled for the root scroll node, so content was\n   displaced by exactly offset * (scale - 1) device pixels: 100 device pixels at\n   scale 2 for scrolling/root-scroll.yaml, 51 at 1.51, -49 at 0.51.\n\n - Items attached to `spatial-id: root-reference-frame` or `root-scroll-node`,\n   which is how wrench expresses fixed position content. Those resolved to the\n   real root nodes and so were rendered at scale 1 while their surroundings were\n   scaled.\n\nPush a second scale reference frame under the root reference frame and redirect\nthe two special yaml spatial ids to the scaled equivalents (the sibling for\nroot-reference-frame so fixed content is scaled without scrolling, the existing\none for root-scroll-node), and scale the root pipeline's scroll offset by the\ndevice pixel scale, which matches Gecko where APZ offsets are in device pixels.\nNothing changes at scale 1.0.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315583\n", "files": ["gfx/wr/wrench/reftests/scrolling/reftest.list", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "20806172367ab85611412aca5dbb57fae4aa0477", "git_parents": ["d93278b278ddacc4636bfe27f28b2c4973933440"], "node": "00b342284127c47061bf81b347f4c8dd5737b315", "parents": ["f29e877dd6aa5a882868fe45df560fa9f7b5b7e3"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2059680 - Restrict the blur clamping reftests to device pixel scales of 1 and above. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315586\n", "files": ["gfx/wr/wrench/reftests/filters/reftest.list"], "git_node": "dfd69869d9c54e123e5e7d55974b30753c60e6ec", "git_parents": ["20806172367ab85611412aca5dbb57fae4aa0477"], "node": "ca7f721d6ea58de39b55e4dd788dec683ac8aa2c", "parents": ["00b342284127c47061bf81b347f4c8dd5737b315"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2059680 - Don't scale wrench snapping reftests whose reference bakes a scale-1 snapped position. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315588\n", "files": ["gfx/wr/wrench/reftests/snap/reftest.list", "gfx/wr/wrench/reftests/text/reftest.list"], "git_node": "b90fc0a25f8456ba27b355747b08a255da6934f4", "git_parents": ["dfd69869d9c54e123e5e7d55974b30753c60e6ec"], "node": "dd9c9f1a0b8e2dfbbc9def4a80032d3e9a04bc8b", "parents": ["ca7f721d6ea58de39b55e4dd788dec683ac8aa2c"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2059680 - Restrict text/decorations.yaml to integral scales. a=test-only\n\nAt factional scales, the lines and rects snap differently.\n\nA decoration line snaps its thickness to a phase-independent whole device pixel\n(SnapRounding::Line: round the near edge, add max(round(thickness), 1)), so a\nsub-pixel line can neither vanish nor double with the sub-pixel position it\nlands at (bug 1783779). A rect rounds both of its edges independently\n(SnapRounding::Nearest), which is what makes adjacent rects share an edge and\ntile without seams, and is phase dependent by construction.\n\nThe two rules agree exactly when round(min) + round(t) == round(min + t), which\nalways holds when every edge is integral in device space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315589\n", "files": ["gfx/wr/wrench/reftests/text/reftest.list"], "git_node": "758b4b8d9e7a84726e3c0d65a2dcd7a0b1564660", "git_parents": ["b90fc0a25f8456ba27b355747b08a255da6934f4"], "node": "cfdaffc8deb7ec73b28d6691817873b5152586c7", "parents": ["dd9c9f1a0b8e2dfbbc9def4a80032d3e9a04bc8b"], "tags": []}], "date": 1792383019, "git_changesets": ["c82296686ac98a7c92bc5dc5296f680878b6c880", "1841ef433e8afa7bc7073ba76c708c251d49bed6", "d93278b278ddacc4636bfe27f28b2c4973933440", "20806172367ab85611412aca5dbb57fae4aa0477", "dfd69869d9c54e123e5e7d55974b30753c60e6ec", "b90fc0a25f8456ba27b355747b08a255da6934f4", "758b4b8d9e7a84726e3c0d65a2dcd7a0b1564660"], "user": "rvandermeulen@mozilla.com"}, "1004": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075726 - Validate the principal used to bind child-written alt-data,  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334509\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/CacheEntryWriteHandleParent.h", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/browser/alt_data_cross_origin.sjs", "netwerk/test/browser/browser.toml", "netwerk/test/browser/browser_alt_data_cross_origin.js", "netwerk/test/unit/test_cache-entry-write-handle.js", "netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "e3f77d7fa8153c0cd4706dfcc4554abae391a886", "git_parents": ["758b4b8d9e7a84726e3c0d65a2dcd7a0b1564660"], "node": "5636b32a51013d7a3f997b8bd2de428c380b2490", "parents": ["cfdaffc8deb7ec73b28d6691817873b5152586c7"], "tags": []}], "date": 1792383216, "git_changesets": ["e3f77d7fa8153c0cd4706dfcc4554abae391a886"], "user": "rvandermeulen@mozilla.com"}, "1005": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335036\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin.meta.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json", "toolkit/components/certviewer/content/components/logNameTable.mjs"], "git_node": "6b307fca4fc47deb8a5c126bdf24b895ac7093e6", "git_parents": ["e3f77d7fa8153c0cd4706dfcc4554abae391a886"], "node": "ddfd2b3eb9d794929dc6f7887c435c210c65ba67", "parents": ["5636b32a51013d7a3f997b8bd2de428c380b2490"], "tags": []}], "date": 1792406445, "git_changesets": ["6b307fca4fc47deb8a5c126bdf24b895ac7093e6"], "user": "pchevrel@mozilla.com"}, "1006": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "FIREFOX_ESR_153_5_X_RELBRANCH", "desc": "No bug - Bump version to 153.5.1 a=me\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "d