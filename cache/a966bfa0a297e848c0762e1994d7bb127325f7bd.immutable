s:61837:"{
"lastpushid": 1568,
"pushes": {"163": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 8a02a7c43f1eddfd18926f0266d188b4f359c0aa with FIREFOX_115_5_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "354ea46c5880fe884e41323db3aa20eb2319f258", "parents": ["8a02a7c43f1eddfd18926f0266d188b4f359c0aa"], "tags": []}], "date": 1699910004, "git_changesets": [null], "user": "ffxbld"}, "164": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "201385b12dbdace004453f80bb54422ad1ff0379", "parents": ["354ea46c5880fe884e41323db3aa20eb2319f258"], "tags": []}], "date": 1700498554, "git_changesets": [null], "user": "ffxbld-merge"}, "165": {"changesets": [{"author": "Malte Juergens \u003cmjurgens@mozilla.com\u003e", "branch": "default", "desc": "Bug 1855734 - Use innermost nested URI in `PopulateTopLevelInfoFromURI`  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D190468\n\nDifferential Revision: https://phabricator.services.mozilla.com/D193277", "files": ["build/pgo/server-locations.txt", "caps/OriginAttributes.cpp", "toolkit/components/httpsonlyerror/tests/browser/browser.ini", "toolkit/components/httpsonlyerror/tests/browser/browser_fpi_nested_uri.js"], "git_node": null, "git_parents": [null], "node": "6f850e14e9dcf41f576023e2e76b3ac40f4dc55b", "parents": ["201385b12dbdace004453f80bb54422ad1ff0379"], "tags": []}], "date": 1700528048, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "166": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 8a02a7c43f1eddfd18926f0266d188b4f359c0aa with FIREFOX_115_5_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "d173bed15048e25e45a713cb8bdd0a3a4da8fa2e", "parents": ["6f850e14e9dcf41f576023e2e76b3ac40f4dc55b"], "tags": []}], "date": 1700573872, "git_changesets": [null], "user": "ffxbld"}, "167": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194061", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "258ec73dc49025f8b8ec54526a9b4e5eda556939", "parents": ["d173bed15048e25e45a713cb8bdd0a3a4da8fa2e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1721612 - Fix AdjustAdvancesForSyntheticBold to reliably handle negative adjustments. r=gfx-reviewers,lsalzman a=RyanVM\n\nThis method (as its name suggests) was originally created to handle synthetic-bold,\nwhich only ever increases the advance, and so its use of an unsigned value for the\nadjustment worked ok.\n\nBut when applying tracking, the adjustment may be negative, and assigning this to\na uint32_t value takes us into undefined-behavior territory. It seems this worked\n\"as expected\" on x86_64 (using modulo arithmetic), but on arm64 the value just\nclamped to zero, and the intended negative tracking doesn't get applied.\n\nMaking it an int32_t results in consistent behavior across both architectures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D193288", "files": ["gfx/thebes/gfxFont.cpp"], "git_node": null, "git_parents": [null], "node": "b12746b922ba93213cd524a8686cb9ee09af7fde", "parents": ["258ec73dc49025f8b8ec54526a9b4e5eda556939"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1819882 - Fix crash in [@ nsBaseWidget::NotifyLiveResizeStarted] via nsWindow::ProcessMessageInternal. r=edgar, a=RyanVM\n\nDon't allow nullptr into mLiveResizeListeners\n\nDifferential Revision: https://phabricator.services.mozilla.com/D193358", "files": ["xpfe/appshell/AppWindow.cpp"], "git_node": null, "git_parents": [null], "node": "4bd601f903bb22edfef9ea2890d46337b55b382c", "parents": ["b12746b922ba93213cd524a8686cb9ee09af7fde"], "tags": []}], "date": 1700587369, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "168": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1825977 - Allow saving creds with an empty realm. r=credential-management-reviewers,mtigley, a=dmeehan\n\nPerhaps unusual, but an \"\" realm should work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D191383", "files": ["toolkit/components/passwordmgr/LoginHelper.sys.mjs", "toolkit/components/passwordmgr/LoginManager.sys.mjs", "toolkit/components/passwordmgr/test/LoginTestUtils.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_logins_change.js", "toolkit/components/passwordmgr/test/unit/test_logins_search.js", "toolkit/components/passwordmgr/test/unit/test_module_LoginExport.js"], "git_node": null, "git_parents": [null], "node": "768ec1031cb0bde384711ede28b30825151c78be", "parents": ["4bd601f903bb22edfef9ea2890d46337b55b382c"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194477", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0a9a3fbb9e435f10b6e969e6419b21cab5b442a7", "parents": ["768ec1031cb0bde384711ede28b30825151c78be"], "tags": []}], "date": 1700759979, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "169": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1863852 - Return early from Prompt:Open if the window isn't current.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D193153\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194418", "files": ["browser/actors/PromptParent.sys.mjs"], "git_node": null, "git_parents": [null], "node": "3646b4c941481c806d59baa67bed0a3553b6aaa8", "parents": ["0a9a3fbb9e435f10b6e969e6419b21cab5b442a7"], "tags": []}], "date": 1700839805, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "170": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1862777 - Lock the list in UpdateShmBlocks.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D194368\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194434", "files": ["gfx/thebes/SharedFontList-impl.h", "gfx/thebes/SharedFontList.cpp"], "git_node": null, "git_parents": [null], "node": "94a397b3882d6c288685eea3dbd6429ec99aac03", "parents": ["3646b4c941481c806d59baa67bed0a3553b6aaa8"], "tags": []}], "date": 1700841389, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "171": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 768ec1031cb0 (bug 1825977) for causing a perma test failure", "files": ["toolkit/components/passwordmgr/LoginHelper.sys.mjs", "toolkit/components/passwordmgr/LoginManager.sys.mjs", "toolkit/components/passwordmgr/test/LoginTestUtils.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_logins_change.js", "toolkit/components/passwordmgr/test/unit/test_logins_search.js", "toolkit/components/passwordmgr/test/unit/test_module_LoginExport.js"], "git_node": null, "git_parents": [null], "node": "1e0b56cc0d94ec8a303af95391f25806d8c3022e", "parents": ["94a397b3882d6c288685eea3dbd6429ec99aac03"], "tags": []}], "date": 1700846452, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "172": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194747", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "994c3a80aa58f012ca68acc2110b1936253f9d74", "parents": ["1e0b56cc0d94ec8a303af95391f25806d8c3022e"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1840500 - Make `HTMLEditor::ClearStyleAt()` remove `\u003cbr\u003e` for reuse before removing its parent from the tree. r=m_kato, a=RyanVM\n\nOnce a parent node is removed from the tree, the node may become not editable\nbecause editable state \"inherits\" from ancestor nodes.\n`HTMLEditor::ClearStyleAt` cleans up unnecessary parent inline elements first,\nbut if `\u003cbr\u003e` element which should be reused in the block parent is contained\nthe inline elements, `HTMLEditUtils::IsRemovableNode()` will start returning\n`false` for the `\u003cbr\u003e` element because of in a document fragment which do not\ncontain an element whose `contenteditable` is `true`.  Then,\n`MoveNodeWithTransaction` fails to move it because of unremovable.\n\nTherefore, this patch makes the method move `\u003cbr\u003e` element before removing\ninline elements and use `InsertNodeWithTransaction` instead if `\u003cbr\u003e` element\nis an orphan node.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182640", "files": ["editor/libeditor/HTMLStyleEditor.cpp", "editor/libeditor/tests/mochitest.ini", "editor/libeditor/tests/test_cmd_fontFace_with_empty_string.html"], "git_node": null, "git_parents": [null], "node": "87b7114c0d0b219f0ffcafef2c62c61d920039fe", "parents": ["994c3a80aa58f012ca68acc2110b1936253f9d74"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1848121 - [wptrunner] Increase timeout multiplier for TSAN builds from 4 to 8. r=jgraham a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185917", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py"], "git_node": null, "git_parents": [null], "node": "15b12fe4522e97f8eb854793af53a6537e70f452", "parents": ["87b7114c0d0b219f0ffcafef2c62c61d920039fe"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 1862089 - Delay I64 box creations in wasm::Instance::callImport. r=rhunt, a=RyanVM", "files": ["js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmValue.cpp", "js/src/wasm/WasmValue.h"], "git_node": null, "git_parents": [null], "node": "05a377830d0aa60726155b802c671e564963ee7b", "parents": ["15b12fe4522e97f8eb854793af53a6537e70f452"], "tags": []}], "date": 1701107290, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "173": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1736385 - Make sure thread is alive in CacheIOThread::ThreadFunc,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D193640\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194807", "files": ["netwerk/cache2/CacheIOThread.cpp"], "git_node": null, "git_parents": [null], "node": "3031dbee7baec281ae3a6344c7314e04b8bb8795", "parents": ["05a377830d0aa60726155b802c671e564963ee7b"], "tags": []}], "date": 1701124779, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "174": {"changesets": [{"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1856090 - Improve ServiceWorker state propagation.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D190245\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194843", "files": ["dom/workers/ScriptLoader.cpp", "dom/workers/loader/CacheLoadHandler.cpp", "dom/workers/loader/CacheLoadHandler.h", "dom/workers/loader/WorkerLoadContext.cpp", "dom/workers/loader/WorkerLoadContext.h", "dom/workers/loader/WorkerModuleLoader.cpp"], "git_node": null, "git_parents": [null], "node": "751d8526f0608a8af80cdbe9b355a991b4a7b6c2", "parents": ["3031dbee7baec281ae3a6344c7314e04b8bb8795"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1865302 [Linux] Don't resume compositor if we're missing mCompositorWidgetDelegate. r=emilio, a=RyanVM\n\nWe pause compositor for scale changes to avoid flickering during repaint.\nIf compositor is deleted during the pause, don't try to resume it.\nJust flip it back to enabled and let SetCompositorWidgetDelegate() or map event to resume it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194110", "files": ["widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "928491e697815b49beacc6ec5ba35b2781ecf9d9", "parents": ["751d8526f0608a8af80cdbe9b355a991b4a7b6c2"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1826791 - Always check against fragment length in nsTextFrame::GetContentEnd(). r=dholbert, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D193566", "files": ["layout/generic/nsTextFrame.cpp"], "git_node": null, "git_parents": [null], "node": "bae7132a82a8a2283bba0606205dd11d6a83c4ea", "parents": ["928491e697815b49beacc6ec5ba35b2781ecf9d9"], "tags": []}, {"author": "Ray Kraesig \u003crkraesig@mozilla.com\u003e", "branch": "default", "desc": "Bug 1864118 - deny attempts to open a Windows file picker in headless mode. r=win-reviewers,gstoll,cmartin a=RyanVM\n\nWe don't necessarily even have access to a user-accessible desktop in\nheadless mode. Opening a file dialog isn't going to work out.\n\nIn practice, file-dialog invocations will typically be intercepted by\nPuppeteer before they ever get here (see MockFilePicker.sys.mjs), but\nthat's configuration-dependent. Explicitly check whether we're in\nheadless mode before proceeding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D193332", "files": ["widget/windows/nsFilePicker.cpp"], "git_node": null, "git_parents": [null], "node": "056b65ce1087a6ff0090829393a1b64a831b7f78", "parents": ["bae7132a82a8a2283bba0606205dd11d6a83c4ea"], "tags": []}], "date": 1701180900, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "175": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1842936 - Make WindowGlobalParent::IsCurrentGlobal() consistent with nsPIDOMWindowInner::IsCurrentInnerWindow().  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D183311\n\nDifferential Revision: https://phabricator.services.mozilla.com/D194994", "files": ["dom/ipc/WindowGlobalParent.cpp"], "git_node": null, "git_parents": [null], "node": "18785059daf5739572dd094d05aba48254897011", "parents": ["056b65ce1087a6ff0090829393a1b64a831b7f78"], "tags": []}], "date": 1701281836, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "176": {"changesets": [{"author": "Jan Varga \u003cjvarga@mozilla.com\u003e", "branch": "default", "desc": "Bug 1864123 - Optimize flushing to base stream;  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D193286\n\nDifferential Revision: https://phabricator.services.mozilla.com/D195046", "files": ["dom/quota/EncryptingOutputStream.h", "dom/quota/EncryptingOutputStream_impl.h"], "git_node": null, "git_parents": [null], "node": "8cc3a3bb4ea04add5c469c2b32f47b8f7f34c988", "parents": ["18785059daf5739572dd094d05aba48254897011"], "tags": []}], "date": 1701299237, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "177": {"changesets": [{"author": "Iulian Moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 8cc3a3bb4ea0 (bug 1864123) for causing mass build bustages on EncryptingOutputStream_impl.h. a=backout", "files": ["dom/quota/EncryptingOutputStream.h", "dom/quota/EncryptingOutputStream_impl.h"], "git_node": null, "git_parents": [null], "node": "9504b353d4ad97d101cf0102acc47ab182877aca", "parents": ["8cc3a3bb4ea04add5c469c2b32f47b8f7f34c988"], "tags": []}], "date": 1701306535, "git_changesets": [null], "user": "imoraru@mozilla.com"}, "178": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D195086", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/url-classifier-skip-urls.json"], "git_node": null, "git_parents": [null], "node": "47d884cc5dfb7012bef7cc5427e4e7c4676dcd2a", "parents": ["9504b353d4ad97d101cf0102acc47ab182877aca"], "tags": []}, {"author": "Kag