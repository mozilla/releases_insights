s:50203:"{
"lastpushid": 632,
"pushes": {"285": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 68352da82b95d7114af99b268c179195fd2fead0 with FIREFOX_128_5_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "ac86577bf4bb2b20f860ada63856656e7270fc9a", "parents": ["68352da82b95d7114af99b268c179195fd2fead0"], "tags": []}], "date": 1731948453, "git_changesets": [null], "user": "ffxbld"}, "286": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "c38bfc9b63052538c37f6cad932930232c0982e0", "parents": ["ac86577bf4bb2b20f860ada63856656e7270fc9a"], "tags": []}], "date": 1732540681, "git_changesets": [null], "user": "ffxbld-merge"}, "287": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230090", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "ed950e62385461f98d8622adfe05e5ffd7e282db", "parents": ["c38bfc9b63052538c37f6cad932930232c0982e0"], "tags": []}], "date": 1732574656, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "288": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 68352da82b95d7114af99b268c179195fd2fead0 with FIREFOX_128_5_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "de20cdc4f8dad430d2bfa9314d637dd8200c05f5", "parents": ["ed950e62385461f98d8622adfe05e5ffd7e282db"], "tags": []}], "date": 1732629604, "git_changesets": [null], "user": "ffxbld"}, "289": {"changesets": [{"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1921759: Restart Windows Explorer at start of browser_bookmark_copy_folder_tree.js a=dmeehan\nIn a new Windows update, explorer.exe is grabs the clipboard mutex and holds\nit for a long time, which is causing test failures.  Killing explorer.exe\nrestarts it and forces it to give up the mutex, allowing the test to pass.", "files": ["browser/components/places/tests/browser/browser_bookmark_copy_folder_tree.js"], "git_node": null, "git_parents": [null], "node": "d216caf33faafb64dea7ca82440799d26c83ec52", "parents": ["de20cdc4f8dad430d2bfa9314d637dd8200c05f5"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921759: Log the process that holds the clipboard mutex on Windows a=dmeehan\nWhen Windows keeps us from getting access to the clipboard because another\napplication is using it, this will report the exe that currently holds the\nmutex.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227742", "files": ["widget/windows/WinUtils.cpp", "widget/windows/WinUtils.h", "widget/windows/nsClipboard.cpp"], "git_node": null, "git_parents": [null], "node": "9d48e0e99765af7020d870dd963724640921c2c8", "parents": ["d216caf33faafb64dea7ca82440799d26c83ec52"], "tags": []}], "date": 1732630394, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "290": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1922329 - Allow changing sync button dropdown from policy.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D228907\n\nDifferential Revision: https://phabricator.services.mozilla.com/D229372", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs"], "git_node": null, "git_parents": [null], "node": "7c43e7c2b2c84c972688b9823c300ae29c267d64", "parents": ["9d48e0e99765af7020d870dd963724640921c2c8"], "tags": []}], "date": 1732730499, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "291": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1930836 - Initialize returned values in GetSelection{Start,End}IgnoringType.  a=dmeehan\n\nReturning uninitialized values is undefined behavior, and while the API\nis such that the caller code wouldn't use the value in the case it's not\ninitialized, the C++ standard doesn't allow it and now clang 19 has a\nchange in an optimization pass that can end up miscompiling the code as\nresult.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D228769\n\nDifferential Revision: https://phabricator.services.mozilla.com/D229692", "files": ["dom/html/HTMLInputElement.cpp"], "git_node": null, "git_parents": [null], "node": "b6dde6561878ffa5ef295c13cca9a701824cd472", "parents": ["7c43e7c2b2c84c972688b9823c300ae29c267d64"], "tags": []}], "date": 1732730545, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "292": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230505", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "def620c0a3d7a10cc41b0e6bf65e0edbaeca64b8", "parents": ["b6dde6561878ffa5ef295c13cca9a701824cd472"], "tags": []}], "date": 1732802460, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "293": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1919750 - Don't send SETTINGS_TYPE_MAX_CONCURRENT when push is disabled  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222778\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230530", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Session.cpp"], "git_node": null, "git_parents": [null], "node": "bcf5fb91cd727d8dacbcd99a4bf4e5e9576a739b", "parents": ["def620c0a3d7a10cc41b0e6bf65e0edbaeca64b8"], "tags": []}], "date": 1732805159, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "294": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_5_X_RELBRANCH", "desc": "No bug - bump version to 128.5.1", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "e8cb1c02c9e0359df5be86f21830a991c31b4ed4", "parents": ["68352da82b95d7114af99b268c179195fd2fead0"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "FIREFOX_ESR_128_5_X_RELBRANCH", "desc": "Bug 1919750 - Don't send SETTINGS_TYPE_MAX_CONCURRENT when push is disabled  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222778\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230530", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Session.cpp"], "git_node": null, "git_parents": [null], "node": "a6cdcd2ed9ec3e256f358010672bafd1674b0b8b", "parents": ["e8cb1c02c9e0359df5be86f21830a991c31b4ed4"], "tags": ["FIREFOX_128_5_1esr_BUILD1", "FIREFOX_128_5_1esr_RELEASE"]}], "date": 1732807061, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"},