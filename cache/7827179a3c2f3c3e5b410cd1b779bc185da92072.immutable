we also have the option to set\n`$XDG_CONFIG_HOME`. At the moment this only affects linux, with\nwindows/macos slated to have a similar change soon with possibly\ndifferent setup.", "files": ["taskcluster/scripts/misc/build-custom-car.sh", "taskcluster/scripts/misc/build-custom-v8.sh"], "git_node": null, "git_parents": [null], "node": "7c6c583d4351671e637f65c223e793fae3cb7523", "parents": ["8bbb2b1fb24398128c39d13c61d88f1e69d156e5"], "tags": []}], "date": 1733944339, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "316": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1934258 - block chromesafe64.dll on ESR r=gerard-majax a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231833", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": null, "git_parents": [null], "node": "21def3e0518496b82c7b3da3f16de982ddcc31e2", "parents": ["7c6c583d4351671e637f65c223e793fae3cb7523"], "tags": []}], "date": 1733944488, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "317": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_5_X_RELBRANCH", "desc": "No bug - Bump milestone.txt to 128.5.2 a=release", "files": ["config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "df1220029dbb9fcb46c877d4fe2e2ed52e5186af", "parents": ["a1d6c811852a7509a6330fb3267bbba3ee326802"], "tags": []}], "date": 1733946695, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "318": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_5_X_RELBRANCH", "desc": "Bug 1934258 - block chromesafe64.dll on ESR r=gerard-majax a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231833", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": null, "git_parents": [null], "node": "f2cc51880bf4f49bfe087a2cc569388cab97242e", "parents": ["df1220029dbb9fcb46c877d4fe2e2ed52e5186af"], "tags": ["FIREFOX_128_5_2esr_BUILD1", "FIREFOX_128_5_2esr_RELEASE"]}], "date": 1733951158, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "319": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f2cc51880bf4f49bfe087a2cc569388cab97242e with FIREFOX_128_5_2esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "8f142b1250303a68293e4eaa03629c91aa0cbb76", "parents": ["21def3e0518496b82c7b3da3f16de982ddcc31e2"], "tags": []}], "date": 1733964643, "git_changesets": [null], "user": "ffxbld"}, "320": {"changesets": [{"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1896374 - Remove release-snap-repackage task r=releng-reviewers,taskgraph-reviewers,jcristau a=pascalc\n\nRemote execution of the task itself, removal of the docker image will\nhappen in a second time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210344", "files": ["taskcluster/docs/kinds.rst", "taskcluster/gecko_taskgraph/transforms/beetmover.py", "taskcluster/gecko_taskgraph/transforms/beetmover_snap.py", "taskcluster/kinds/release-snap-repackage/kind.yml"], "git_node": null, "git_parents": [null], "node": "3d46c21fb655e14d706fe7369f25c96938495df7", "parents": ["8f142b1250303a68293e4eaa03629c91aa0cbb76"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1896374 - Remove firefox-snap docker image r=releng-reviewers,bhearsum a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215600", "files": ["taskcluster/docker/firefox-snap/Dockerfile", "taskcluster/docker/firefox-snap/Makefile", "taskcluster/docker/firefox-snap/download_and_install_snap.sh", "taskcluster/docker/firefox-snap/extract_locales_from_l10n_json.py", "taskcluster/docker/firefox-snap/firefox.snapcraft.yaml.in", "taskcluster/docker/firefox-snap/policies.json", "taskcluster/docker/firefox-snap/runme.sh", "taskcluster/docker/firefox-snap/tmpdir", "taskcluster/kinds/docker-image/kind.yml"], "git_node": null, "git_parents": [null], "node": "602c6f89063fafcc4eee92615d42aabb83c27d18", "parents": ["3d46c21fb655e14d706fe7369f25c96938495df7"], "tags": []}], "date": 1733995831, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "321": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1935333 - Avoid trying to install dist toolchains when bootstrapping from a spidermonkey standalone tree.  a=pascalc\n\nThe auto-bootstrap code gracefully handles the lack of information as to\nwhat toolchains are available in spidermonkey standalone trees, but the\nfallback code path for when toolchains are not to be unpacked doesn't\nhandle the situation.\n\nBy making the toolchains themselves define whether they are to be\nunpacked, we can remove the fallback code path and use auto-bootstrap in\nall cases.\n\nThis makes `mach artifact toolchain --from-build` stop requiring a\nmanual `--no-unpack`, but `--from-task` still needs it because it\ncan't infer that information, as it doesn't have the task graph.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D231342\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231846", "files": ["build/moz.configure/bootstrap.configure", "python/mozboot/mozboot/base.py", "python/mozboot/mozboot/mozillabuild.py", "python/mozboot/mozboot/osx.py", "python/mozbuild/mozbuild/artifact_commands.py", "python/mozbuild/mozbuild/test/configure/test_bootstrap.py", "taskcluster/docs/attributes.rst", "taskcluster/gecko_taskgraph/transforms/job/__init__.py", "taskcluster/gecko_taskgraph/transforms/job/toolchain.py", "taskcluster/kinds/toolchain/dist-toolchains.yml"], "git_node": null, "git_parents": [null], "node": "556eaaffa903b57ed37e71f4cedb2af3e9f05ffa", "parents": ["602c6f89063fafcc4eee92615d42aabb83c27d18"], "tags": []}], "date": 1733998198, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "322": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1929623 - The result of evaluating a JSON module should be |undefined| r=jandem a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228663", "files": ["js/src/jit-test/tests/modules/bug-1929623.js", "js/src/jit-test/tests/modules/evaluation-result.js", "js/src/vm/Modules.cpp"], "git_node": null, "git_parents": [null], "node": "2697c92966e30678227529d26f18abd5e9ec7b0f", "parents": ["556eaaffa903b57ed37e71f4cedb2af3e9f05ffa"], "tags": []}], "date": 1734009274, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "323": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231923", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f3e755bf8386c10611e23e2963533d7cb8e7160d", "parents": ["2697c92966e30678227529d26f18abd5e9ec7b0f"], "tags": []}], "date": 1734011792, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "324": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f2cc51880bf4f49bfe087a2cc569388cab97242e with FIREFOX_128_5_2esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "87a454e068c437891c69c8e2f044f561f65d83f9", "parents": ["f3e755bf8386c10611e23e2963533d7cb8e7160d"], "tags": []}], "date": 1734012638, "git_changesets": [null], "user": "ffxbld"}, "325": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915535 - Ensure consistent cleanup in nsLineBreaker::FlushCurrentWord.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D230763\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231940", "files": ["dom/base/nsLineBreaker.cpp"], "git_node": null, "git_parents": [null], "node": "29000f5f707e6812d42711b3abba788147d880be", "parents": ["87a454e068c437891c69c8e2f044f561f65d83f9"], "tags": []}], "date": 1734083995, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "326": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1932482 - Add support for downloading GMP plugins from mirror URLs.  a=pascalc\n\nWe have found that some users are unable to download the GMP plugin from\nthe default URL because of their specific network\nconfiguration/circumstances. For example, some users cannot access the\n*.gvt1.com domain. This patch adds the ability for balrog to supply\nalternative mirror URLs to attempt to download the plugin, where we first\ntry the primary, and if supplied any secondaries, in the given order.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D229690\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230617", "files": ["dom/media/tools/generateGmpJson.py", "toolkit/content/gmp-sources/openh264.json", "toolkit/content/gmp-sources/widevinecdm.json", "toolkit/content/gmp-sources/widevinecdm_l1.json", "toolkit/modules/GMPInstallManager.sys.mjs", "toolkit/modules/tests/xpcshell/test_GMPInstallManager.js", "toolkit/mozapps/extensions/internal/ProductAddonChecker.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/good.xml", "toolkit/mozapps/extensions/test/xpcshell/test_ProductAddonChecker.js", "toolkit/mozapps/extensions/test/xpcshell/test_ProductAddonChecker_signatures.js"], "git_node": null, "git_parents": [null], "node": "1de76ef2e1461d0b2e29b0ca738cc91791346a14", "parents": ["29000f5f707e6812d42711b3abba788147d880be"], "tags": []}], "date": 1734084126, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "327": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1936853 - Remove permafailing bug-1929623.js. a=test-only", "files": ["js/src/jit-test/tests/modules/bug-1929623.js"], "git_node": null, "git_parents": [null], "node": "42f337dcd0809ff77b204811e7cfb38df45b6b6e", "parents": ["1de76ef2e1461d0b2e29b0ca738cc91791346a14"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1912093 - Skip browser_ui_telemetry.js on all platforms. a=test-only", "files": ["browser/components/shopping/tests/browser/browser.toml"], "git_node": null, "git_parents": [null], "node": "2de2e00d8cca08f9cfb6f088cdd32a3821711154", "parents": ["42f337dcd0809ff77b204811e7cfb38df45b6b6e"], "tags": []}], "date": 1734110309, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "328": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1275612 - Don't allow any origins to send objects over WebChannel.  a=RyanVM\n\nThe last actual Firefox user of this less-safe feature was removed in 2022.\nThunderbird's sync server still needs it, but apparently that is a prototype\nthat isn't really working, so they said it was okay to remove this.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220646\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232089", "files": ["browser/app/profile/firefox.js", "browse