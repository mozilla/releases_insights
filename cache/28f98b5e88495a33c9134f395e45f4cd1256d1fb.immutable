 ship-geckoview cron target on mozilla-esr68; r=aki a=tomprince DONTBUILD\n\nIt used a `android-release-type` option which is not supported by the generic\nbuild-decision cron parser. Given that it unused, it is easier to remove the\nstanza, than to add support for that option.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81613", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "209f1a6811222ddd26b296a949db5eb4833a7a0a", "parents": ["d1c81eb4215d3bc61890cac9bad56e70c3085b31"], "tags": []}], "date": 1593468847, "git_changesets": [null], "user": "mozilla@hocat.ca"}, "1069": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Merge esr68 default to THUNDERBIRD_68_VERBRANCH. a=merge", "files": [".hgtags", "browser/app/blocklist.xml", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt", "mobile/android/config/version-files/beta/version.txt", "mobile/android/config/version-files/beta/version_display.txt", "mobile/android/config/version-files/nightly/version.txt", "mobile/android/config/version-files/nightly/version_display.txt", "mobile/android/config/version-files/release/version.txt", "mobile/android/config/version-files/release/version_display.txt", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/blocklists/plugins.json", "services/settings/dumps/security-state/onecrl.json", "taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null, null], "node": "e1113625c6d21988a22dab4b08662befa20ed732", "parents": ["dd320264210fff9b65e4101b28a470dcf978d3d8", "9717af816e0dbfd32df334a2a921c124a517b06d"], "tags": []}], "date": 1593471840, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1070": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 84878756cd4f2d4b6371c1276ad7060a3536a6cd with FIREFOX_68_10_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "8f86cc3cc2efe395b3a678da9bf0b5398a74c20f", "parents": ["209f1a6811222ddd26b296a949db5eb4833a7a0a"], "tags": []}], "date": 1593522128, "git_changesets": [null], "user": "ffxbld"}, "1071": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging ac58213de5a0fb2d76ff3ce461bc250907bfdaaf with FENNEC_68_10_0_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "78c6ea76890d64c5e694bf5375873cd840ffdeba", "parents": ["8f86cc3cc2efe395b3a678da9bf0b5398a74c20f"], "tags": []}], "date": 1593522199, "git_changesets": [null], "user": "ffxbld"}, "1072": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82029", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "0a646cd5335068a1aed7c2a6a214532a95b1b71b", "parents": ["78c6ea76890d64c5e694bf5375873cd840ffdeba"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1638856 - Increase the stack space passed to the child process to accomodate for its usage. r=gbrown, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81372", "files": ["testing/gtest/gtest/src/gtest-death-test.cc", "testing/gtest/mozilla-changes.diff"], "git_node": null, "git_parents": [null], "node": "081aec52deb69ddc70a2c4c15449434306b174ba", "parents": ["0a646cd5335068a1aed7c2a6a214532a95b1b71b"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1646787 - Mask i32 wasm results. r=luke, a=RyanVM\n\nSee bug for more information\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80830", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/shared/LIR-shared.h", "js/src/wasm/WasmBaselineCompile.cpp", "js/src/wasm/WasmStubs.cpp"], "git_node": null, "git_parents": [null], "node": "80108a939b146428824fae0971eb74c561498791", "parents": ["081aec52deb69ddc70a2c4c15449434306b174ba"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1644528 - Allow DisabledCiphers policy to enable ciphers. r=keeler, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "6674321a43752f7dba3130042d81d907c415fba8", "parents": ["80108a939b146428824fae0971eb74c561498791"], "tags": []}], "date": 1593708051, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "1073": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_68_10_X_RELBRANCH", "desc": "Bump version number to 68.10.1. a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt", "mobile/android/config/version-files/release/version.txt", "mobile/android/config/version-files/release/version_display.txt"], "git_node": null, "git_parents": [null], "node": "d85f9c54893c8e5635d6d08ad49c3687b0b88486", "parents": ["9717af816e0dbfd32df334a2a921c124a517b06d"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "FIREFOX_ESR_68_10_X_RELBRANCH", "desc": "Bug 1647078 - Load content:// URIs from intents as file://. r=petru,esawin a=RyanVM\n\nThis change intercepts intents that try to load a content:// URI, copy the\ncontent to a file and then open that file:// in the browser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81253", "files": ["mobile/android/base/java/org/mozilla/gecko/GeckoApp.java", "mobile/android/base/java/org/mozilla/gecko/Tabs.java"], "git_node": null, "git_parents": [null], "node": "ad9ac638aa8f2105e9854169fe0de333e463beb6", "parents": ["d85f9c54893c8e5635d6d08ad49c3687b0b88486"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "FIREFOX_ESR_68_10_X_RELBRANCH", "desc": "Bug 1647078 - Never handle content:// channels from Web. r=petru,esawin a=RyanVM\n\nThis patch forbids loading content:// URIs coming from web content. If a web\npage tries to load a content:// url in a sub-resource (like an image, script or\niframe) the browser will return an unknown protocol error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81254", "files": ["mobile/android/base/java/org/mozilla/gecko/IntentHelper.java", "mobile/android/components/ContentDispatchChooser.js"], "git_node": null, "git_parents": [null], "node": "c87234a340c14826aabf41afc0da0f9df765392f", "parents": ["ad9ac638aa8f2105e9854169fe0de333e463beb6"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "FIREFOX_ESR_68_10_X_RELBRANCH", "desc": "Bug 1647078 - Use random file names when copying a content:// URI. r=petru,esawin a=RyanVM\n\nWhen copying a content:// URI to a temp file we will use a random file name\ninstead of the actual file name of the resource to avoid name clashing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81255", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/ContentUriUtils.java"], "git_node": null, "git_parents": [null], "node": "003ff248966ae98bddc028882e4c70e00b56ea10", "parents": ["c87234a340c14826aabf41afc0da0f9df765392f"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "FIREFOX_ESR_68_10_X_RELBRANCH", "desc": "Bug 1647078 - Always copy content:// files. r=petru,esawin a=RyanVM\n\nThis patch makes it so we never attempt to load a content:// URI by guessing\nit's file location, and instead always open a copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81256", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/FileUtils.java"], "git_node": null, "git_parents": [null], "node": "f5b74d48979155c082baf699716290d2f154b9c5", "parents": ["003ff248966ae98bddc028882e4c70e00b56ea10"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "FIREFOX_ESR_68_10_X_RELBRANCH", "desc": "Bug 1647078 - Restrict content:// paths to external storage. r=petru,esawin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81359", "files": ["mobile/android/app/src/main/res/xml/provider_paths.xml"], "git_node": null, "git_parents": [null], "node": "bb07a1c15096474bc00516258e5ec4d622ecc718", "parents": ["f5b74d48979155c082baf699716290d2f154b9c5"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "FIREFOX_ESR_68_10_X_RELBRANCH", "desc": "Bug 1647078 - Don't load Web-originated intents that open in the browser. r=petru,esawin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81410", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/IntentUtils.java"], "git_node": null, "git_parents": [null], "node": "7e2374db758b3cfcc74a9f26aea9911418ba711c", "parents": ["bb07a1c15096474bc00516258e5ec4d622ecc718"], "tags": []}], "date": 1594048039, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "1074": {"changesets": [{"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "FIREFOX_ESR_68_10_X_RELBRANCH", "desc": "Bug 1647078 - Fix unit tests and checkstyle. r=snorp,esawin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82397", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/FileUtils.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/util/IntentUtilsTest.java"], "git_node": null, "git_parents": [null], "node": "69fce10096d5ee43bd6f3a979631d62174d652a7", "parents": ["7e2374db758b3cfcc74a9f26aea9911418ba711c"], "tags": ["FENNEC_68_10_1_BUILD1", "FENNEC_68_10_1_RELEASE"]}], "date": 1594052474, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1075": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 69fce10096d5ee43bd6f3a979631d62174d652a7 with FENNEC_68_10_1_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "0b93156bacfa7ad9943caa0f55a3d655a0782ed5", "parents": ["6674321a43752f7dba3130042d81d907c415fba8"], "tags": []}], "date": 1594058222, "git_changesets": [null], "user": "ffxbld"}, "1076": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82373", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "86ad81ce5741f1562a11919a837941e75b19ac16", "parents": ["0b93156bacfa7ad9943caa0f55a3d655a0782ed5"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "default", "desc": "Bug 1647078 - Load content:// URIs from intents as file://. r=petru,esawin a=RyanVM\n\nThis change intercepts intents that try to load a content:// URI, copy the\ncontent to a file and then open that file:// in the browser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81253", "files": ["mobile/android/base/java/org/mozilla/gecko/GeckoApp.java", "mobile/android/base/java/org/mozilla/gecko/Tabs.java"], "git_node": null, "git_parents": [null], "node": "d2dba14d515116e556e6403263df12062fef49e3", "parents": ["86ad81ce5741f1562a11919a837941e75b19ac16"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "default", "desc": "Bug 1647078 - Never handle content:// channels from Web. r=petru,esawin a=RyanVM\n\nThis patch forbids loading content:// URIs coming from web content. If a web\npage tries to load a content:// url in a sub-resource (like an image, script or\niframe) the browser will return an unknown protocol error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81254", "files": ["mobile/android/base/java/org/mozilla/gecko/IntentHelper.java", "mobile/android/components/ContentDispatchChooser.js"], "git_node": null, "git_parents": [null], "node": "0c161b487485ec2f1a0248082e05e3e93b4c3317", "parents": ["d2dba14d515116e556e6403263df12062fef49e3"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "default", "desc": "Bug 1647078 - Use random file names when copying a content:// URI. r=petru,esawin a=RyanVM\n\nWhen copying a content:// URI to a temp file we will use a random file name\ninstead of the actual file name of the resource to avoid name clashing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81255", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/ContentUriUtils.java"], "git_node": null, "git_parents": [null], "node": "bfa52add2ca5094a9bc2485f6266d670f0412372", "parents": ["0c161b487485ec2f1a0248082e05e3e93b4c3317"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "default", "desc": "Bug 1647078 - Always copy content:// files. r=petru,esawin a=RyanVM\n\nThis patch makes it so we never attempt to load a content:// URI by guessing\nit's file location, and instead always open a copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81256", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/FileUtils.java"], "git_node": null, "git_parents": [null], "node": "04a1051357b379b59965d46c1a0266bda38288a3", "parents": ["bfa52add2ca5094a9bc2485f6266d670f0412372"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "default", "desc": "Bug 1647078 - Restrict content:// paths to external storage. r=petru,esawin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81359", "files": ["mobile/android/app/src/main/res/xml/provider_paths.xml"], "git_node": null, "git_parents": [null], "node": "97ae634f83d1d971384d6bf772cd49988ab20952", "parents": ["04a1051357b379b59965d46c1a0266bda38288a3"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "default", "desc": "Bug 1647078 - Don't load Web-originated intents that open in the browser. r=petru,esawin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D81410", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/IntentUtils.java"], "git_node": null, "git_parents": [null], "node": "f1ee7e600869cc5209278ba1851c2b515a4244be", "parents": ["97ae634f83d1d971384d6bf772cd49988ab20952"], "tags": []}, {"author": "Agi Sferro \u003cagi@sferro.dev\u003e", "branch": "default", "desc": "Bug 1647078 - Fix unit tests and checkstyle. r=snorp,esawin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82397", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/FileUtils.java", "mobile/android/geckoview/src/test/java/org/mozilla/gecko/util/IntentUtilsTest.java"], "git_node": null, "git_parents": [null], "node": "8fbc6afcebf60d4ddb81f8aa603f0961262355a5", "parents": ["f1ee7e600869cc5209278ba1851c2b515a4244be"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1645219: Repurpose DataChannelShutdown into DataChannelRegistry (which gives us some weak-pointer-like semantics) r=ng a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82409", "files": ["netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannel.h"], "git_node": null, "git_parents": [null], "node": "848f2565543bee84ad1bbed8331cb6492d079a3f", "parents": ["8fbc6afcebf60d4ddb81f8aa603f0961262355a5"], "tags": []}], "date": 1594066521, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "1077": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 69fce10096d5ee43bd6f3a979631d62174d652a7 with FENNEC_68_10_1_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "01db54946af071f8ead61a3cf5be7915800fa449", "parents": ["848f2565543bee84ad1bbed8331cb6492d079a3f"], "tags": []}], "date": 1594133219, "git_changesets": [null], "user": "ffxbld"}, "1078": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D82902", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "ffc6153e59de6d2efe3c6a79587e8cc19a7efbe6", "parents": ["01db54946af071f8ead61a3cf5be7915800fa449"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1635293 - Cherry-pick ANGLE fix: Update tex cache even if new type is InvalidEnum. r=lsalzman, a=RyanVM", "files": ["gfx/angle/checkout/out/gen/angle/id/commit.h", "gfx/angle/checkout/src/libANGL