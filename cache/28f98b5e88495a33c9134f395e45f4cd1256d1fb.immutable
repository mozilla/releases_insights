"pushes": {"1062": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 84878756cd4f2d4b6371c1276ad7060a3536a6cd with FENNEC_68_10_0_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "ba21af279eaaa9a0783d5d1f43d8d6c8e96f55bf", "parents": ["84878756cd4f2d4b6371c1276ad7060a3536a6cd"], "tags": []}], "date": 1592866786, "git_changesets": [null], "user": "ffxbld"}, "1063": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 84878756cd4f2d4b6371c1276ad7060a3536a6cd with FIREFOX_68_10_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "5861ae9e25147c3db1ae95f143b0c699150fc1df", "parents": ["ba21af279eaaa9a0783d5d1f43d8d6c8e96f55bf"], "tags": []}], "date": 1592867101, "git_changesets": [null], "user": "ffxbld"}, "1064": {"changesets": [{"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1643000 - Remove installation ping documentation. r=sarentz, a=RyanVM\n\nThis is a reverse patch of D74075.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78889", "files": ["toolkit/components/telemetry/docs/data/installation-ping.rst"], "git_node": null, "git_parents": [null], "node": "a4bdd4ce347d23e5fdeac9cf24503259685fe07b", "parents": ["5861ae9e25147c3db1ae95f143b0c699150fc1df"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1643000 - Remove the installation ping code. r=snorp, a=RyanVM\n\nThis is a reverse patch of D74073.\n\nDepends on D78889\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78890", "files": ["mobile/android/base/java/org/mozilla/gecko/BrowserApp.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryInstallationPingDelegate.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryInstallationPingBuilder.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/stores/TelemetryInstallationPingStore.java"], "git_node": null, "git_parents": [null], "node": "7b969c5abf2638b8139ed3a146bcb8927f645887", "parents": ["a4bdd4ce347d23e5fdeac9cf24503259685fe07b"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1643000 - AdjustHelper will only inform the core ping delegate. r=snorp, a=RyanVM\n\nThis is a reverse patch of D74072 that comes to simplify the code related to\nAdjustHelper and restore it to exactly how it was before the installation ping\npatches.\n\nDepends on D78890\n\nDifferential Revision: https://phabricator.services.mozilla.com/D78891", "files": ["mobile/android/base/java/org/mozilla/gecko/adjust/AdjustBrowserAppDelegate.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AdjustHelperInterface.java", "mobile/android/base/java/org/mozilla/gecko/adjust/AttributionHelperListener.java", "mobile/android/base/java/org/mozilla/gecko/adjust/StubAdjustHelper.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryCorePingDelegate.java"], "git_node": null, "git_parents": [null], "node": "ac58213de5a0fb2d76ff3ce461bc250907bfdaaf", "parents": ["7b969c5abf2638b8139ed3a146bcb8927f645887"], "tags": ["FENNEC_68_10_0_BUILD2", "FENNEC_68_10_0_RELEASE"]}], "date": 1593017111, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "1065": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging ac58213de5a0fb2d76ff3ce461bc250907bfdaaf with FENNEC_68_10_0_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [nu