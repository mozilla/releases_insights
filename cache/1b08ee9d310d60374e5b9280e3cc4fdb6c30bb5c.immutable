de": "d850eb0a4638df7791c23ba66b404ec305c65f60", "git_parents": ["efd8a4918b7a0a4d6904027751cdb17fc0de8a79"], "node": "b2861bbaa0900a957a2857efbed2033e981f9224", "parents": ["e33439d047f0d07db7340f79ca225844e9d492d7"], "tags": []}], "date": 1775535029, "git_changesets": ["d850eb0a4638df7791c23ba66b404ec305c65f60"], "user": "rvandermeulen@mozilla.com"}, "1056": {"changesets": [{"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025350 - Use CheckedInt to validate size when writing StructuredCloneBlob and ClonedErrorHolder.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290388\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292010\n", "files": ["dom/base/StructuredCloneBlob.cpp", "dom/ipc/ClonedErrorHolder.cpp"], "git_node": "eb68928df4f05e2dfcef7081593e9d7b50680cdc", "git_parents": ["d850eb0a4638df7791c23ba66b404ec305c65f60"], "node": "01d1c7fa35b0f00e5c9db5d633dfa50939fa63f1", "parents": ["b2861bbaa0900a957a2857efbed2033e981f9224"], "tags": []}], "date": 1775535072, "git_changesets": ["eb68928df4f05e2dfcef7081593e9d7b50680cdc"], "user": "rvandermeulen@mozilla.com"}, "1057": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028275.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291393\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292053\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "c67aad403f6e9292379be0ef83f2d718f2605fba", "git_parents": ["eb68928df4f05e2dfcef7081593e9d7b50680cdc"], "node": "e1095e14e03e0d23cdffd0d3ff41533b507ebe5e", "parents": ["01d1c7fa35b0f00e5c9db5d633dfa50939fa63f1"], "tags": []}], "date": 1775535135, "git_changesets": ["c67aad403f6e9292379be0ef83f2d718f2605fba"], "user": "rvandermeulen@mozilla.com"}, "1058": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 2025497.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290663\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292219\n", "files": ["dom/media/systemservices/MediaSystemResourceManager.cpp", "dom/media/systemservices/MediaSystemResourceManager.h", "dom/media/systemservices/MediaSystemResourceManagerChild.cpp", "dom/media/systemservices/MediaSystemResourceManagerParent.cpp", "dom/media/systemservices/MediaSystemResourceManagerParent.h", "dom/media/systemservices/PMediaSystemResourceManager.ipdl"], "git_node": "6a18eb7ed3bb2cc098bc38986480da50399e4dd4", "git_parents": ["c67aad403f6e9292379be0ef83f2d718f2605fba"], "node": "bf574dce948d009cfee71fc59a22e9ef5ccdd27c", "parents": ["e1095e14e03e0d23cdffd0d3ff41533b507ebe5e"], "tags": []}], "date": 1775563867, "git_changesets": ["6a18eb7ed3bb2cc098bc38986480da50399e4dd4"], "user": "rvandermeulen@mozilla.com"}, "1059": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025381 - Handle AbortSignal's reason more consistently.  a=diannaS,RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289576\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290409\n", "files": ["dom/abort/AbortSignal.cpp", "dom/fetch/Fetch.cpp", "testing/web-platform/meta/service-workers/cache-storage/cache-abort.https.any.js.ini"], "git_node": "90e4c050351c072494c14e96f545e80322497401", "git_parents": ["6a18eb7ed3bb2cc098bc38986480da50399e4dd4"], "node": "c0f6d7b48a7d66b8cc399c6347c2d0958f7b00a8", "parents": ["bf574dce948d009cfee71fc59a22e9ef5ccdd27c"], "tags": []}], "date": 1775563916, "git_changesets": ["90e4c050351c072494c14e96f545e80322497401"], "user": "rvandermeulen@mozilla.com"}, "1060": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 1 - Clean up some variable declarations and redundant #includes in thebes font code.  a=dmeehan\n\n(No behavior change, this is just some preparatory cleanup.)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288945\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290378\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "layout/base/nsPresContext.cpp", "layout/style/ServoStyleSet.cpp"], "git_node": "08ca18fe5ab120ccf3bf21526b7d2804d158ac86", "git_parents": ["90e4c050351c072494c14e96f545e80322497401"], "node": "d943ce1db3736a1443f2516051fb8230f4893fca", "parents": ["c0f6d7b48a7d66b8cc399c6347c2d0958f7b00a8"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 2 - Try to bypass font table cache in gfxFontconfigFontEntry.  a=dmeehan\n\nIf the FcPattern includes the pathname of the font file, we can use\nhb_face_create_from_file_or_fail to create an hb_face that directly\naccesses the memory-mapped file, rather than going through our GetFontTable\ncallback that relies on FreeType table access and the font table cache.\n\nThis means that such fonts will entirely bypass the table cache with its\ntricky management of blob ownership/lifetimes.\n\nThe old code is left in place as a fallback path for fonts where\nhb_face_create_from_file_or_fail fails. This should normally be limited\nto non-sfnt fonts such as legacy Type 1 resources, which are still found\non some Linux systems although they don't support modern font features.\nSuch fonts will still go via the table cache, etc. (although the tables\nbeing cached will be empty), but usage of it will be greatly reduced.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288946\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290380\n", "files": ["gfx/2d/2D.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "86e84cad3e6b8b66cd4f2d24c8a94b8f85a405bc", "git_parents": ["08ca18fe5ab120ccf3bf21526b7d2804d158ac86"], "node": "19b1f7aea5902455c1fb3d59a520e23202ac5099", "parents": ["d943ce1db3736a1443f2516051fb8230f4893fca"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 3 - Simplify FontTableCache to avoid potential race.  a=dmeehan\n\n(Based on Emilio's earlier patch here)\n\nThis simplifies the FontTableCache to avoid the weak-referencing scheme;\nnow once a table is cached, it will be retained indefinitely. Since most\nfonts bypass the cache, and non-sfnt fonts that still use it will have\nnull \"tables\", the memory footprint should be minimal.\n\nIn addition, the cache is removed entirely from gfxFontEntry on platforms\nthat don't use it, and only created if needed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288947\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290381\n", "files": ["gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxGDIFontList.cpp", "gfx/thebes/gfxGDIFontList.h", "gfx/thebes/gfxMacPlatformFontList.h", "gfx/thebes/gfxUserFontSet.h"], "git_node": "8b8b915cc3d421691dbec149448aca33d4cc3491", "git_parents": ["86e84cad3e6b8b66cd4f2d24c8a94b8f85a405bc"], "node": "08e04b4df3715b16629f5cb28019c78cb04ba68d", "parents": ["19b1f7aea5902455c1fb3d59a520e23202ac5099"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 4 - Cache hb-face in FT2FontEntry if it wraps a disk file.  a=dmeehan\n\nLike in the fontconfig backend, on Android we can also use\nhb_face_create_from_file_or_fail to efficiently create an hb_face\nfor installed fonts that are available as disk resources.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288951\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290382\n", "files": ["gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h"], "git_node": "c7d9c0fe1bbf0d6f3366f964e6c527777d5cc270", "git_parents": ["8b8b915cc3d421691dbec149448aca33d4cc3491"], "node": "7c1bba6ed948b3fd7ff1b5a4ca15db3823741b26", "parents": ["08e04b4df3715b16629f5cb28019c78cb04ba68d"], "tags": []}], "date": 1775563970, "git_changesets": ["08ca18fe5ab120ccf3bf21526b7d2804d158ac86", "86e84cad3e6b8b66cd4f2d24c8a94b8f85a405bc", "8b8b915cc3d421691dbec149448aca33d4cc3491", "c7d9c0fe1bbf0d6f3366f964e6c527777d5cc270"], "user": "rvandermeulen@mozilla.com"}, "1061": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 046c432275274758df774b9be4c18bf13f43af86 with FIREFOX-ANDROID_150_0b6_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "65d9d93fff84c193edf0f05f5b9067a3ffeddc52", "git_parents": ["774362fc22f0a329926095837bd3db4549571497"], "node": "77f6ec19a87da3b3e40e305b39a4708fe4322805", "parents": ["7dd5484a0abdba27a335151504be9339554207a2"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 046c432275274758df774b9be4c18bf13f43af86 with DEVEDITION_150_0b6_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "c26e661dc2fea0e2952cf416cf5868a140d89028", "git_parents": ["65d9d93fff84c193edf0f05f5b9067a3ffeddc52"], "node": "7673ada18af50f950532d045af9a378465d1dde1", "parents": ["77f6ec19a87da3b3e40e305b39a4708fe4322805"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 046c432275274758df774b9be4c18bf13f43af86 with FIREFOX_150_0b6_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "8d9ece7d9f