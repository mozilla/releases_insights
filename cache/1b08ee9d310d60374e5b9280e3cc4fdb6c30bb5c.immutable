"b952491af6fe8ffa4e22956a7cc31112bdc3b59c", "git_parents": ["7173159d88ed6f3704d26afab81047c5d9670406"], "node": "77032b05ef504279ed62beefb7b203c1090e074c", "parents": ["2eec99a4dcfab966baa17422270ed6413d223cd0"], "tags": []}], "date": 1775519433, "git_changesets": ["b952491af6fe8ffa4e22956a7cc31112bdc3b59c"], "user": "rvandermeulen@mozilla.com"}, "1048": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025948: Change IPCOpen assertion  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289704\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291447\n", "files": ["dom/network/TCPServerSocketParent.cpp", "dom/network/TCPSocketParent.cpp"], "git_node": "1532598cbb56e6e921cc5eab8205e630cd877dfc", "git_parents": ["b952491af6fe8ffa4e22956a7cc31112bdc3b59c"], "node": "94bff83af9102466a22f88883a6c37c382b370c8", "parents": ["77032b05ef504279ed62beefb7b203c1090e074c"], "tags": []}], "date": 1775519851, "git_changesets": ["1532598cbb56e6e921cc5eab8205e630cd877dfc"], "user": "rvandermeulen@mozilla.com"}, "1049": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2025360 - Avoid leaks in nsXMLPrettyPrinter, r=hsivonen, a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289365\n", "files": ["dom/xml/nsXMLPrettyPrinter.cpp"], "git_node": "2ba4ee36e3daf690ec0e5750abf2174c16d0b609", "git_parents": ["1532598cbb56e6e921cc5eab8205e630cd877dfc"], "node": "d4b90d78f3e4646f35ea77337fdb8185bf488078", "parents": ["94bff83af9102466a22f88883a6c37c382b370c8"], "tags": []}], "date": 1775519893, "git_changesets": ["2ba4ee36e3daf690ec0e5750abf2174c16d0b609"], "user": "rvandermeulen@mozilla.com"}, "1050": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2025363 - really IgnoreOpensDuringUnload, r=edgar a=RyanVM DONTBUILD\n\nDiffer