": ["servo/components/style/values/specified/calc.rs"], "git_node": "cf8ba2409155aaa1ace056bb94720984734f61f6", "git_parents": ["34acc06cee697e9298f77cc7a2313e2309b5169f"], "node": "daca411cc102f5ca8f2967f6312b489b6a4d8085", "parents": ["8064f4c599cd2bde548d4064c6074ead545d8608"], "tags": []}], "date": 1774460997, "git_changesets": ["cf8ba2409155aaa1ace056bb94720984734f61f6"], "user": "dsmith@mozilla.com"}, "930": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2024420.  a=backout\"\n\nThis reverts commit cf8ba2409155aaa1ace056bb94720984734f61f6.\n", "files": ["servo/components/style/values/specified/calc.rs"], "git_node": "ed946c29f8991922bcf58cf226f7b25bf02a1f17", "git_parents": ["cf8ba2409155aaa1ace056bb94720984734f61f6"], "node": "358f2ad030df86ee59f2397add77f6fab75ece43", "parents": ["daca411cc102f5ca8f2967f6312b489b6a4d8085"], "tags": []}], "date": 1774464720, "git_changesets": ["ed946c29f8991922bcf58cf226f7b25bf02a1f17"], "user": "dsmith@mozilla.com"}, "931": {"changesets": [{"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2022874.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D287561\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289475\n", "files": ["dom/media/ipc/RemoteDecoderManagerChild.cpp", "gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/KnowsCompositor.cpp"], "git_node": "fcd0226d1c5cbd5751a7e383360599e1e605d5e0", "git_parents": ["ed946c29f8991922bcf58cf226f7b25bf02a1f17"], "node": "c622cdde8652ef01a9815d30d9795b2f86e27116", "parents": ["358f2ad030df86ee59f2397add77f6fab75ece43"], "tags": []}], "date": 1774485049, "git_changesets": ["fcd0226d1c5cbd5751a7e383360599e1e605d5e0"], "user": "dsmith@mozilla.com"}, "932": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2024396 - Make CheckedInt::value() check use a release assert. r=sergesanspaille a=diannaS\n\nThis has been a diagnostic assert for many years now without causing\nstability problems on Nightly or early Beta, so let's finish shipping\nit to paper over potential security issues.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289308\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289794\n", "files": ["mfbt/CheckedInt.h"], "git_node": "d22621ab9ba8eb777db0b4880c59ec37917ab550", "git_parents": ["fcd0226d1c5cbd5751a7e383360599e1e605d5e0"], "node": "dd419614ffc971244bbcd93b01f1e4d3d5e7b988", "parents": ["c622cdde8652ef01a9815d30d9795b2f86e27116"], "tags": []}], "date": 1774485666, "git_changesets": ["d22621ab9ba8eb777db0b4880c59ec37917ab550"], "user": "dsmith@mozilla.com"}, "933": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1958299 - don't retry tasks on SIGKILL.  a=RyanVM\n\nretry-exit-status 137 was added during the migration from aws to gcp as it was\ngenerally a symptom of spot termination.  Since then, worker-runner has learned\nto detect when that happens and terminate the task as `worker-shutdown`, so\nthis should no longer be necessary when using a recent worker image.  It\nalso interacts badly with how d2g deals with exceeding maxRunTime.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246600\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289550\n", "files": ["taskcluster/gecko_taskgraph/transforms/source_test.py", "taskcluster/gecko_taskgraph/transforms/test/other.py"], "git_node": "c0a8de76f6c5a68574d83d24d5fa644fc64a7bbb", "git_parents": ["d22621ab9ba8eb777db0b4880c59ec37917ab550"], "node": "910f7f35b190d28339ba28bb62b741e2571d6921", "parents": ["dd419614ffc971244bbcd93b01f1e4d3d5e7b988"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918594 - use b-linux-kvm-gcp for android x86 pgo run.  a=RyanVM\n\nThis makes x86 pgo use the same workers as arm64; as a bonus they now have\nlocal storage so won't take an hour.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222327\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289783\n", "files": ["taskcluster/ci/config.yml", "taskcluster/ci/generate-profile/kind.yml"], "git_node": "94cb53f22092e2a679ff9bbdd053ccbe5af57223", "git_parents": ["c0a8de76f6c5a68574d83d24d5fa644fc64a7bbb"], "node": "9778c216a299585321af4f521e939b4ae1dcd46b", "parents": ["910f7f35b190d28339ba28bb62b741e2571d6921"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012869 - use image_builder:5.1.0 to build image_builder.  a=RyanVM\n\nkaniko on image_builder:5.0.0 is too old and fails to detect docker when\nrunning on a newer host.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D280716\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289788\n", "files": ["taskcluster/gecko_taskgraph/transforms/docker_image.py"], "git_node": "a81609bcedaf7e6a59be2c4fc639bf2eecec3c0a", "git_parents": ["94cb53f22092e2a679ff9bbdd053ccbe5af57223"], "node": "b982a5f49bdfc3416ac9dc9397d7915b4be94e8a", "parents": ["9778c216a299585321af4f521e939b4ae1dcd46b"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2002725 - Fix malformed-payload error caused by non-string values.  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289789\n", "files": ["taskcluster/gecko_taskgraph/morph.py", "taskcluster/gecko_taskgraph/test/test_morph.py"], "git_node": "dc53d000bb38310818707b95d12e19aa83333854", "git_parents": ["a81609bcedaf7e6a59be2c4fc639bf2eecec3c0a"], "node": "0b5d9355b7c5b6ab81f81e73124f73147f04650c", "parents": ["b982a5f49bdfc3416ac9dc9397d7915b4be94e8a"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019973 - [esr115] migrate linux tasks from docker-worker to d2g pools. r=releng-reviewers,bhearsum a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289784\n", "files": [".taskcluster.yml", "taskcluster/ci/config.yml", "taskcluster/gecko_taskgraph/test/test_transforms_job.py", "tools/tryselect/test/test_task_configs.py"], "git_node": "17603acbae37af039f46487410911a7434aeb2e5", "git_parents": ["dc53d000bb38310818707b95d12e19aa83333854"], "node": "71df323c3567aa179051c198e44e18cee82844f0", "parents": ["0b5d9355b7c5b6ab81f81e73124f73147f04650c"], "tags": []}], "date": 1774491392, "git_changesets": ["c0a8de76f6c5a68574d83d24d5fa644fc64a7bbb", "94cb53f22092e2a679ff9bbdd053ccbe5af57223", "a81609bcedaf7e6a59be2c4fc639bf2eecec3c0a", "dc53d000bb38310818707b95d12e19aa83333854", "17603acbae37af039f46487410911a7434aeb2e5"], "user": "rvandermeulen@mozilla.com"}, "934": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2000261 - remove retry config for funsize-update-generator docker image.  a=RyanVM\n\nThis reverts bug 1423058; generic-worker doesn't like negative values in\nonExitStatus, and enough has changed since 2018 that it seems worth\ntrying without it and revisiting if/when we see failures.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272673\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290040\n", "files": ["taskcluster/gecko_taskgraph/transforms/docker_image.py"], "git_node": "8c4db1941d81640625b04867940e42f3f6c73669", "git_parents": ["17603acbae37af039f46487410911a7434aeb2e5"], "node": "177006615ef925d72d8f5ac460246c163aa18be2", "parents": ["71df323c3567aa179051c198e44e18cee82844f0"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019973 - use prebuilt image_builder docker image.  a=RyanVM\n\nkaniko needs an update to be able to run on newer workers, and rather\nthan uplift bug 1901033 to esr115 