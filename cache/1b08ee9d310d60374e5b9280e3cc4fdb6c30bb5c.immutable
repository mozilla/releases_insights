32", "parents": ["2dff0bd6c5cee900862a98611524f3f1ed1c36f3"], "tags": []}], "date": 1775176351, "git_changesets": ["6438f781cb3e88a4839141e7e560a3122848653f"], "user": "dsmith@mozilla.com"}, "1014": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1999158.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272371\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290564\n", "files": ["dom/media/gmp/GMPStorageChild.cpp", "dom/media/gmp/GMPStorageChild.h", "dom/media/gmp/widevine-adapter/WidevineFileIO.cpp", "dom/media/gmp/widevine-adapter/WidevineFileIO.h"], "git_node": "6e61fbfd944b34f014e17dbbb17e9db88f11db7c", "git_parents": ["6438f781cb3e88a4839141e7e560a3122848653f"], "node": "d32b1992ca91bb256dd514536cd8fc4e05caf9a8", "parents": ["66f4d27da4839ad1435da878b886959aa5106432"], "tags": []}], "date": 1775210303, "git_changesets": ["6e61fbfd944b34f014e17dbbb17e9db88f11db7c"], "user": "dmeehan@mozilla.com"}, "1015": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2024463 - Part 1 Check list size  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289110\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290684\n", "files": ["dom/svg/DOMSVGLengthList.cpp", "dom/svg/DOMSVGNumberList.cpp", "dom/svg/DOMSVGPointList.cpp", "dom/svg/DOMSVGTransformList.cpp"], "git_node": "8ca5917a124e994c6226f5732e461d05bfaaf389", "git_parents": ["6e61fbfd944b34f014e17dbbb17e9db88f11db7c"], "node": "68dba60f08c3dd6faeea186eff100401faa2f9ac", "parents": ["d32b1992ca91bb256dd514536cd8fc4e05caf9a8"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2024463 - Part 2 Add more asserts  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289188\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290685\n", "files": ["dom/svg/DOMSVGLength.cpp", "dom/svg/DOMSVGLength.h", "dom/svg/DOMSVGNumber.h", "dom/svg/DOMSVGPoint.cpp", "dom/svg/DOMSVGPoint.h", "dom/svg/DOMSVGTransform.h"], "git_node": "c05d7b48520d251146347e5b9ddf147c2148b617", "git_parents": ["8ca5917a124e994c6226f5732e461d05bfaaf389"], "node": "97bc0d33e7a65e9ab312b868b15ce0cf6dc7dc05", "parents": ["68dba60f08c3dd6faeea186eff100401faa2f9ac"], "tags": []}], "date": 1775210343, "git_changesets": ["8ca5917a124e994c6226f5732e461d05bfaaf389", "c05d7b48520d251146347e5b9ddf147c2148b617"], "user": "dmeehan@mozilla.com"}, "1016": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 1 - Clean up some variable declarations and redundant #includes in thebes font code.  a=dmeehan DONTBUILD\n\n(No behavior change, this is just some preparatory cleanup.)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288945\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290378\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "layout/style/ServoStyleSet.cpp"], "git_node": "33fee722000ec759e8a9d83520b2137349fac32a", "git_parents": ["c05d7b48520d251146347e5b9ddf147c2148b617"], "node": "dc1b71028433cbf17500d2c593b2b967554e14a1", "parents": ["97bc0d33e7a65e9ab312b868b15ce0cf6dc7dc05"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 2 - Try to bypass font table cache in gfxFontconfigFontEntry.  a=dmeehan DONTBUILD\n\nIf the FcPattern includes the pathname of the font file, we can use\nhb_face_create_from_file_or_fail to create an hb_face that directly\naccesses the memory-mapped file, rather than going through our GetFontTable\ncallback that relies on FreeType table access and the font table cache.\n\nThis means that such fonts will entirely bypass the table cache with its\ntricky management of blob ownership/lifetimes.\n\nThe old code is left in place as a fallback path for fonts where\nhb_face_create_from_file_or_fail fails. This should normally be limited\nto non-sfnt fonts such as legacy Type 1 resources, which are still found\non some Linux systems although they don't support modern font features.\nSuch fonts will still go via the table cache, etc. (although the tables\nbeing cached will be empty), but usage of it will be greatly reduced.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288946\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290380\n", "files": ["gfx/2d/2D.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "849214c9e56efc83dd43a470e56e64d80968606a", "git_parents": ["33fee722000ec759e8a9d83520b2137349fac32a"], "node": "1c568e6702e3bcf9da1cf6cd775cfe678488cfb0", "parents": ["dc1b71028433cbf17500d2c593b2b967554e14a1"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 3 - Simplify FontTableCache to avoid potential race.  a=dmeehan DONTBUILD\n\n(Based on Emilio's earlier patch here)\n\nThis simplifies the FontTableCache to avoid the weak-referencing scheme;\nnow once a table is cached, it will be retained indefinitely. Since most\nfonts bypass the cache, and non-sfnt fonts that still use it will have\nnull \"tables\", the memory footprint should be minimal.\n\nIn addition, the cache is removed entirely from gfxFontEntry on platforms\nthat don't use it, and only created if needed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288947\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290381\n", "files": ["gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxGDIFontList.cpp", "gfx/thebes/gfxGDIFontList.h", "gfx/thebes/gfxMacPlatformFontList.h", "gfx/thebes/gfxUserFontSet.h"], "git_node": "945d6413edd3dd9e3d1db25b29bb1d37c2811c1b", "git_parents": ["849214c9e56efc83dd43a470e56e64d80968606a"], "node": "46cdba36d1b5a0e30010ec1c15b502111939c244", "parents": ["1c568e6702e3bcf9da1cf6cd775cfe678488cfb0"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 4 - Cache hb-face in FT2FontEntry if it wraps a disk file.  a=dmeehan DONTBUILD\n\nLike in the fontconfig backend, on Android we can also use\nhb_face_create_from_file_or_fail to efficiently create an hb_face\nfor installed fonts that are available as disk resources.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288951\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290382\n", "files": ["gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h"], "git_node": "d22cd3780f05da17739d71046aa46c294cfea9ab", "git_parents": ["945d6413edd3dd9e3d1db25b29bb1d37c2811c1b"], "node": "43d5faec195e0dae24bdbc9ffae53e6e7eef916f", "parents": ["46cdba36d1b5a0e30010ec1c15b502111939c244"], "tags": []}], "date": 1775210578, "git_changesets": ["33fee722000ec759e8a9d83520b2137349fac32a", "849214c9e56efc83dd43a470e56e64d80968606a", "945d6413edd3dd9e3d1db25b29bb1d37c2811c1b", "d22cd3780f05da17739d71046aa46c294cfea9ab"], "user": "dmeehan@mozilla.com"}, "1017": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 2022373.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288272\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291923\n", "files": ["dom/media/gmp/ChromiumCDMCallback.h", "dom/media/gmp/ChromiumCDMCallbackProxy.cpp", "dom/media/gmp/ChromiumCDMCallbackProxy.h", "dom/media/gmp/ChromiumCDMChild.cpp", "dom/media/gmp/ChromiumCDMChild.h", "dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/ChromiumCDMParent.h", "dom/media/gmp/GMPLog.h", "dom/media/gmp/GMPMessageUtils.h", "dom/media/gmp/GMPTypes.ipdlh", "dom/media/gmp/PChromiumCDM.ipdl", "dom/media/gtest/TestCDMStorage.cpp"], "git_node": "2e4062a901dadcec3f7e96f9451d4f4e1184ea38", "git_parents": ["d22cd3780f05da17739d71046aa46c294cfea9ab"], "node": "f47c10013048ceb9da5b55ab9036d4f24a49d34c", "parents": ["43d5faec195e0dae24bdbc9ffae53e6e7eef916f"], "tags": []}], "date": 1775210741, "git_changesets": ["2e4062a901dadcec3f7e96f9451d4f4e1184ea38"], "user": "dmeehan@mozilla.com"}, "1018": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026947 - Configure harfbuzz properly for mmap() support.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290534\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290705\n", "files": ["gfx/harfbuzz/src/moz.build"], "git_node": "34a982d97cfa25152ab6967f29a2cd061345a2b3", "git_parents": ["2e4062a901dadcec3f7e96f9451d4f4e1184ea38"], "node": "210a72f28dab4d777aa113f56e53d1203cccf8ca", "parents": ["f47c10013048ceb9da5b55ab9036d4f24a49d34c"], "tags": []}], "date": 1775210780, "git_changesets": ["34a982d97cfa25152ab6967f29a2cd061345a2b3"], "user": "dmeehan@mozilla.com"}, "1019": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025401: Fixing a bug in IDB blob files refcouting where stale count could carried over across savepoints..  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290463\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291759\n", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/indexedDB/FileInfoImpl.h"], "git_node": "2630bf45c8c8af0bb08697fb68c5140b14909840", "git_parents": ["34a982d97cfa25152ab6967f29a2cd061345a2b3"], "nod