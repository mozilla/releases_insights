g 2022373.  a=dmeehan,diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288272\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291923\n", "files": ["dom/media/gmp/ChromiumCDMCallback.h", "dom/media/gmp/ChromiumCDMCallbackProxy.cpp", "dom/media/gmp/ChromiumCDMCallbackProxy.h", "dom/media/gmp/ChromiumCDMChild.cpp", "dom/media/gmp/ChromiumCDMChild.h", "dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/ChromiumCDMParent.h", "dom/media/gmp/GMPLog.h", "dom/media/gmp/GMPMessageUtils.h", "dom/media/gmp/GMPTypes.ipdlh", "dom/media/gmp/PChromiumCDM.ipdl", "dom/media/gtest/TestCDMStorage.cpp"], "git_node": "57ad1ee28e4c3aac0a33c2cd1b1c0874baa6f35d", "git_parents": ["7218fb00383ea175f5f0b8a40e44b3d56b37500a"], "node": "af72265ef5efa48030368260b934ded00f6b54b7", "parents": ["2675c6ed60637cd8403fab5a0ffce93524e67a81"], "tags": []}], "date": 1775248165, "git_changesets": ["57ad1ee28e4c3aac0a33c2cd1b1c0874baa6f35d"], "user": "dsmith@mozilla.com"}, "1028": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2026293: Block scripts when initiating async scrollbar activity.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290343\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291115\n", "files": ["layout/generic/ScrollbarActivity.cpp"], "git_node": "cc8ad8e43f7bf20e37547ba38dd0c4589bcf81ed", "git_parents": ["57ad1ee28e4c3aac0a33c2cd1b1c0874baa6f35d"], "node": "94b66940e89de1d15c63ab8c234f28cdf9f610d3", "parents": ["af72265ef5efa48030368260b934ded00f6b54b7"], "tags": []}], "date": 1775439028, "git_changesets": ["cc8ad8e43f7bf20e37547ba38dd0c4589bcf81ed"], "user": "dsmith@mozilla.com"}, "1029": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027979 - Check fontlist block index.  a=diannaS DONTBUILD\n\n(based on patch from clauditor, comments revised)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291471\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291828\n", "files": ["gfx/thebes/SharedFontList.cpp", "gfx/thebes/SharedFontList.h"], "git_node": "30ee45435118b5a9b1484db3c7b0b5a8c45ec729", "git_parents": ["cc8ad8e43f7bf20e37547ba38dd0c4589bcf81ed"], "node": "de20262a8bc9669f668356b90ef47039ecde7fdd", "parents": ["94b66940e89de1d15c63ab8c234f28cdf9f610d3"], "tags": []}], "date": 1775439087, "git_changesets": ["30ee45435118b5a9b1484db3c7b0b5a8c45ec729"], "user": "dsmith@mozilla.com"}, "1030": {"changesets": [{"author": "Simon Farre \u003csimon.farre.cx@gmail.com\u003e", "branch": "default", "desc": "Bug 2025977 - Re-fetch index entry  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290053\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291243\n", "files": ["dom/xslt/xslt/txKeyFunctionCall.cpp"], "git_node": "05ddc7625d680cb95a74308292bf293294585f70", "git_parents": ["30ee45435118b5a9b1484db3c7b0b5a8c45ec729"], "node": "a1973efe53528995263587fe6919923b73d4d88d", "parents": ["de20262a8bc9669f668356b90ef47039ecde7fdd"], "tags": []}, {"author": "Simon Farre \u003csimon.farre.cx@gmail.com\u003e", "branch": "default", "desc": "Bug 2025970 - Prevent circular indexing  a=diannaS\n\nAdded additional flag to txIndexedKeyHashEntry to signal whether or not\nthis entry is already in the process of indexing.\n\nXSL specs 3.0 talk about recursion being fine but circularity not being\nok, which is the case when a key is already being looked up.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290412\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291244\n", "files": ["dom/xslt/xslt/txKey.h", "dom/xslt/xslt/txKeyFunctionCall.cpp"], "git_node": "8bf8f280b0967d2b1a6e8a364b06fda4bc844363", "git_parents": ["05ddc7625d680cb95a74308292bf293294585f70"], "node": "292020642d8aa357f8bb8cf9a13a065a4082c7f3", "parents": ["a1973efe53528995263587fe6919923b73d4d88d"], "tags": []}, {"author": "Simon Farre \u003csimon.farre.cx@gmail.com\u003e", "branch": "default", "desc": "Bug 2025969 - Copy txXPathNode as value  a=diannaS\n\nCopy a value of txXPathNode to member, as the type has value semantics.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290400\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291245\n", "files": ["dom/xslt/xpath/txForwardContext.h"], "git_node": "014cbfce7ec7710947446c6a13ca3c02cbaef11f", "git_parents": ["8bf8f280b0967d2b1a6e8a364b06fda4bc844363"], "node": "13f572c0ab3497fcd366c8eb2164324588f93080", "parents": ["292020642d8aa357f8bb8cf9a13a065a4082c7f3"], "tags": []}, {"author": "Simon Farre \u003csimon.farre.cx@gmail.com\u003e", "branch": "default", "desc": "Bug 2025971 - Use txSingleNodeContext getter of owned txXPathNode  a=diannaS\n\neContext gets a copy of aNode. The function should use that one's member\nas it's not a shared reference, which we can't know the life time of.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290389\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291246\n", "files": ["dom/xslt/xpath/txPathExpr.cpp"], "git_node": "d2103ed6680791eb666a87a99d3b16fc690d42e8", "git_parents": ["014cbfce7ec7710947446c6a13ca3c02cbaef11f"], "node": "afb60deefff2895af286625ba48e1521b702d78a", "parents": ["13f572c0ab3497fcd366c8eb2164324588f93080"], "tags": []}], "date": 1775439185, "git_changesets": ["05ddc7625d680cb95a74308292bf293294585f70", "8bf8f280b0967d2b1a6e8a364b06fda4bc844363", "014cbfce7ec7710947446c6a13ca3c02cbaef11f", "d2103ed6680791eb666a87a99d3b16fc690d42e8"], "user": "dsmith@mozilla.com"}, "1031": {"changesets": [{"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1957419 - Tag tasks with test suite, test platform, and test variant r=ahal a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D243774\n\nDifferential Revision: https://p