s/android_arm_config.py"], "git_node": null, "git_parents": [null], "node": "f881e6c91e1ebffa65f73e80dd2cc2060723dd5a", "parents": ["3590ef725e1d5aa2c214463ac113d21600978af5"], "tags": []}], "date": 1421183202, "git_changesets": [null], "user": "armenzg@mozilla.com"}, "164": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "No bug - Adjust some Android reftest expectations now that they're passing again. r=gbrown, a=test-only\n\nThese tests were originally marked as failing on 2.3 so that Android 2.3 could be enabled in production. Something today made them start passing again, so remove the failing annotations.", "files": ["image/test/reftest/generic/reftest.list", "layout/reftests/backgrounds/reftest.list", "layout/reftests/font-face/reftest.list"], "git_node": null, "git_parents": [null], "node": "f3bb687f75c0cb8c0fd8fc43b7ce6a57082670bd", "parents": ["f881e6c91e1ebffa65f73e80dd2cc2060723dd5a"], "tags": []}], "date": 1421267722, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "165": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1012480 - Do not treat star generator's iterator as legacy generator's iterator in for..in loop. r=jorendorff, a=bkerensa", "files": ["js/src/jit-test/tests/generators/star-generator-forin.js", "js/src/jsiter.cpp"], "git_node": null, "git_parents": [null], "node": "f0e283a4a325d108dd1da197f788304a1d8c874b", "parents": ["f3bb687f75c0cb8c0fd8fc43b7ce6a57082670bd"], "tags": []}], "date": 1421389856, "git_changesets": [null], "user": "arai_a@mac.com"}, "166": {"changesets": [{"author": "L. David Baron \u003cdbaron@dbaron.org\u003e", "branch": "default", "desc": "Bug 1083461 - Convert nsCSSValue{,Pair}List::operator== back to a static Equal method so that it can be validly called on null pointers.  r=bzbarsky  approval-mozilla-esr31=bkerensa", "files": ["layout/style/nsCSSValue.cpp", "layout/style/nsCSSValue.h", "layout/style/nsStyleAnimation.cpp"], "git_node": null, "git_parents": [null], "node": "db219b061ce240b0e38e84e08b031b21a7e7adbd", "parents": ["f0e283a4a325d108dd1da197f788304a1d8c874b"], "tags": []}], "date": 1421390400, "git_changesets": [null], "user": "dbaron@mozilla.com"}, "167": {"changesets": [{"author": "Giovanni Sferro \u003cagi.novanta@gmail.com\u003e", "branch": "default", "desc": "Bug 1059030 - Do not crash when an element has the same @id as a @name of a radiogroup. r=bz, a=bkerensa", "files": ["content/html/content/src/HTMLFormElement.cpp", "content/html/content/test/forms/test_input_radio_radiogroup.html"], "git_node": null, "git_parents": [null], "node": "766a8abd842fab2ae599f8499ae380e38f7ae6d6", "parents": ["db219b061ce240b0e38e84e08b031b21a7e7adbd"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1043310 - AutoCompletion doesn't take capitalization from address book entry, can leave angle brackets characters \u003e\u003e in field, when loosing focus by clicking outside (not enter/tab). r=mak, a=bkerensa\n\nThe fix has two aspects:\n - for onblur we need to complete to the actual suggestion not to leave addresses uncapitalized or having \" \u003e\u003e \" as value\n - once we have a valid selection that should not be changed to default because EnterMatch is called again (which it is with blur if the value was confirmed by enter, or mouse selection already)", "files": ["toolkit/components/autocomplete/nsAutoCompleteController.cpp", "toolkit/content/tests/chrome/test_autocomplete4.xul", "toolkit/content/widgets/autocomplete.xml"], "git_node": null, "git_parents": [null], "node": "7788753adc658a85336f6c03806d43d24d456240", "parents": ["766a8abd842fab2ae599f8499ae380e38f7ae6d6"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1108721 - HTMLMediaElement.textTracks needs to be nullable in Gecko for now. r=peterv, a=bkerensa", "files": ["content/html/content/public/HTMLMediaElement.h", "content/html/content/src/HTMLMediaElement.cpp", "content/html/content/src/HTMLTrackElement.cpp", "content/html/content/src/TextTrackManager.cpp", "content/html/content/src/TextTrackManager.h", "dom/webidl/HTMLMediaElement.webidl"], "git_node": null, "git_parents": [null], "node": "413dc6c6f4adf02b96ae2c8945200de171c9227c", "parents": ["7788753adc658a85336f6c03806d43d24d456240"], "tags": []}], "date": 1421419378, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "168": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1111137 - Disable test_user_agent_overrides.html on Android due to frequent failures. a=test-only", "files": ["netwerk/test/mochitests/mochitest.ini"], "git_node": null, "git_parents": [null], "node": "592a4d5f498ed8a14ebe9d42af8c2d0b96882571", "parents": ["413dc6c6f4adf02b96ae2c8945200de171c9227c"], "tags": []}], "date": 1421420584, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "169": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-1087 - a=hsts-update", "files": ["security/manager/boot/src/nsSTSPreloadList.errors", "security/manager/boot/src/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "d2cd00c3e84b009e27f2b72ad4562574c63cd9f6", "parents": ["592a4d5f498ed8a14ebe9d42af8c2d0b96882571"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-1087 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "23a9280bf89c065f35b069cec124418b4b1bee1d", "parents": ["d2cd00c3e84b009e27f2b72ad4562574c63cd9f6"], "tags": []}], "date": 1421493538, "git_changesets": [null, null], "user": "ffxbld"}, "170": {"changesets": [{"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default"