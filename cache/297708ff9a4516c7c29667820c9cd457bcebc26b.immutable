032c325e6be50b851a55", "git_parents": ["318e4a5a825fc5ad17789779b4d8813077a823a8"], "node": "ca3b36fab1e930a9973f0151c8f3a598e9cd0bd9", "parents": ["7aa31d1e9c4a63820396773fe90443993c4b33f2"], "tags": []}], "date": 1779194197, "git_changesets": ["097f485d153158663e19b5e70febc66c3756b989", "c616b3c9c90f5e4d26485ad956f96f652bc0a90b", "632681a4b6d32587e5d6a4401078435b1d8c9d3d", "d6e6b9dba349dc1ae83b9acd759a2e1b9da0d602", "9e776b11cb27ed684c68bb22f0725ff7c732b51f", "22f34ec3a4e466e67c7e5ae76addcdb66b55047a", "427dd5b046014eeeeb1a87105842a2501603962c", "318e4a5a825fc5ad17789779b4d8813077a823a8", "f607e35e50639d807806032c325e6be50b851a55"], "user": "ffxbld@lando.moz.tools"}, "1285": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040496 - Disable linux32 builds, tests, and release pipeline on esr115 r=taskgraph-reviewers,jcristau a=dmeehan DONTBUILD\n\nDelete the linux32 build job definitions and purge linux-shippable/opt,\nlinux-devedition/opt, and linux/opt from the release pipeline and\nper-platform configs.\n\nAfter this, an esr115 promote graph contains zero linux32 tasks while\nlinux64/win/mac shipping is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301218\n", "files": ["taskcluster/ci/beetmover-apt/kind.yml", "taskcluster/ci/beetmover-repackage/kind.yml", "taskcluster/ci/build/linux.yml", "taskcluster/ci/diffoscope/kind.yml", "taskcluster/ci/generate-profile/kind.yml", "taskcluster/ci/instrumented-build/kind.yml", "taskcluster/ci/l10n/kind.yml", "taskcluster/ci/mar-signing-l10n/kind.yml", "taskcluster/ci/mar-signing/kind.yml", "taskcluster/ci/partials/kind.yml", "taskcluster/ci/release-partner-repack-beetmover/kind.yml", "taskcluster/ci/release-partner-repack-chunking-dummy/kind.yml", "taskcluster/ci/release-partner-repack-repackage-signing/kind.yml", "taskcluster/ci/release-partner-repack/kind.yml", "taskcluster/ci/release-secondary-update-verify-config/kind.yml", "taskcluster/ci/release-secondary-update-verify/kind.yml", "taskcluster/ci/release-update-verify-config/kind.yml", "taskcluster/ci/release-update-verify/kind.yml", "taskcluster/ci/repackage-deb/kind.yml", "taskcluster/ci/repackage-l10n/kind.yml", "taskcluster/ci/repackage/kind.yml", "taskcluster/ci/shippable-l10n/kind.yml", "taskcluster/ci/startup-test/kind.yml", "taskcluster/gecko_taskgraph/transforms/release_beetmover_signed_addons.py"], "git_node": "2ddbc2bf75e6825cfc0e4b212a4273fd5b5fdb89", "git_parents": ["97bf5e3feb6d6af8ebe88ed981c17744836e9875"], "node": "9a2e05e8b224297ce65a451d7418eec2e4308c01", "parents": ["2e14803d08fda12c3a5ca22d8799478a32ddfdea"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040496 - Stop scheduling android-only toolchains and tasks on esr115 r=taskgraph-reviewers,jcristau a=dmeehan DONTBUILD\n\nAndroid isn't built on esr115, so none of the android-only toolchains\nand helper artifacts are actually consumed. Stop scheduling the AVD\nrepack toolchains, skip cargo-apk vendoring in wrench-deps (which\nremoves the recurring need to pin android-ndk-rs crates against\nesr115's bundled rustc), drop the android wrench/emulator/hardware\njobs from the webrender kind, and filter android-labeled tasks out of\nthe rebuild-cached-tasks action.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301219\n", "files": ["taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/toolchain/android.yml", "taskcluster/ci/toolchain/misc.yml", "taskcluster/ci/webrender/kind.yml", "taskcluster/gecko_taskgraph/actions/rebuild_cached_tasks.py", "taskcluster/scripts/misc/wrench-android-build.sh", "taskcluster/scripts/misc/wrench-deps-vendoring.sh"], "git_node": "aaadb7344fabd3e6ff1eb57a2c7512da099bce36", "git_parents": ["2ddbc2bf75e6825cfc0e4b212a4273fd5b5fdb89"], "node": "6dc591d61055ca6002d599baaa7ee774ad596da1", "parents": ["9a2e05e8b224297ce65a451d7418eec2e4308c01"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040496 - Disable win64-aarch64 builds and release pipeline on esr115 r=taskgraph-reviewers,jcristau a=dmeehan DONTBUILD\n\nDelete the win64-aarch64 build job definitions and purge\nwin64-aarch64-{shippable,devedition}/opt from the release pipeline\nand per-platform configs.\n\nAfter this, an esr115 promote graph contains zero win64-aarch64 tasks\nwhile linux64/win/mac shipping is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301220\n", "files": ["taskcluster/ci/attribution-l10n/kind.yml", "taskcluster/ci/attribution/kind.yml", "taskcluster/ci/beetmover-repackage/kind.yml", "taskcluster/ci/build/windows.yml", "taskcluster/ci/diffoscope/kind.yml", "taskcluster/ci/mar-signing-l10n/kind.yml", "taskcluster/ci/mar-signing/kind.yml", "taskcluster/ci/partials/kind.yml", "taskcluster/ci/release-partner-repack-beetmover/kind.yml", "taskcluster/ci/release-partner-repack-repackage-signing/kind.yml", "taskcluster/ci/release-partner-repack-repackage/kind.yml", "taskcluster/ci/release-partner-repack/kind.yml", "taskcluster/ci/release-secondary-update-verify-config/kind.yml", "taskcluster/ci/release-secondary-update-verify/kind.yml", "taskcluster/ci/release-update-verify-config/kind.yml", "taskcluster/ci/release-update-verify/kind.yml", "taskcluster/ci/repackage-l10n/kind.yml", "taskcluster/ci/repackage-signing-l10n/kind.yml", "taskcluster/ci/repackage-signing/kind.yml", "taskcluster/ci/repackage/kind.yml", "taskcluster/ci/shippable-l10n/kind.yml"], "git_node": "7bc3bc8b77035bb7f5898a596cda7db7bd0adbdd", "git_parents": ["aaadb7344fabd3e6ff1eb57a2c7512da099bce36"], "node": "d8f4b53d442604c80112d00f3a130941512855dc", "parents": ["6dc591d61055ca6002d599baaa7ee774ad596da1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040496 - Disable mingw builds and lint on esr115 r=taskgraph-reviewers,jcristau a=dmeehan DONTBUILD\n\nSet run-on-projects: [] on the four mingwclang build jobs in\nwindows-mingw.yml and on the mingw-cap mozlint check. Mingw tests\nfollow automatically via their upstream-build run-on-projects\ninheritance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301221\n", "files": ["taskcluster/ci/build/windows-mingw.yml", "taskcluster/ci/source-test/mozlint.yml"], "git_node": "7ec6da36b3b32a07e306cf1f35443c27eb11c79d", "git_parents": ["7bc3bc8b77035bb7f5898a596cda7db7bd0adbdd"], "node": "30c6ad4982c25df3f405efad51fe038e5cd02c6a", "parents": ["d8f4b53d442604c80112d00f3a130941512855dc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040496 - Disable fuzzing and base-toolchains builds on esr115 r=taskgraph-reviewers,bhearsum a=dmeehan DONTBUILD\n\nDelete the fuzzing and base-toolchains build job definitions and\nremove the toolchains that were exclusively used by them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301222\n", "files": ["taskcluster/ci/build/kind.yml", "taskcluster/ci/build/linux-base-toolchains.yml", "taskcluster/ci/build/linux.yml", "taskcluster/ci/build/macosx.yml", "taskcluster/ci/build/windows.yml", "taskcluster/ci/fuzzing/kind.yml", "taskcluster/ci/toolchain/clang.yml", "taskcluster/ci/toolchain/misc.yml", "taskcluster/ci/toolchain/nasm.yml", "taskcluster/ci/toolchain/rust.yml"], "git_node": "369dc1204d066b9ef25de406013f4abb895b17f2", "git_parents": ["7ec6da36b3b32a07e306cf1f35443c27eb11c79d"], "node": "4cbc67f192ad5b29ee5787827163a31f5f49b38a", "parents": ["30c6ad4982c25df3f405efad51fe038e5cd02c6a"], "tags": []}], "date": 1779203337, "git_changesets": ["2ddbc2bf75e6825cfc0e4b212a4273fd5b5fdb89", "aaadb7344fabd3e6ff1eb57a2c7512da099bce36", "7bc3bc8b77035bb7f5898a596cda7db7bd0adbdd", "7ec6da36b3b32a07e306cf1f35443c27eb11c79d", "369dc1204d066b9ef25de406013f4abb895b17f2"], "user": "rvandermeulen@mozilla.com"}, "1286": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040815 - Remove orphan toolchains and fetches with no esr115 consumers r=taskgraph-reviewers,jcristau a=diannaS DONTBUILD\n\nDelete toolchain definitions and fetch entries that have no remaining\ndependency graph consumers on esr115. Local-toolchain artifacts used\nby mach bootstrap on developer machines are preserved.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301437\n", "files": ["taskcluster/ci/fetch/kind.yml", "taskcluster/ci/fetch/resource-monitor.yml", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/toolchain/android.yml", "taskcluster/ci/toolchain/clang.yml", "taskcluster/ci/toolchain/kind.yml", "taskcluster/ci/toolchain/llvm-symbolizer.yml", "taskcluster/ci/toolchain/resourcemonitor.yml", "taskcluster/ci/toolchain/sysroot.yml"], "git_node": "e335a3f7564e76e33ffa28e4643a5968f62fbd98", "git_parents": ["369dc1204d066b9ef25de406013f4abb895b17f2"], "node": "f48af29a3812dbe2760108265e1bcdba09aa05de", "parents": ["4cbc67f192ad5b29ee5787827163a31f5f49b38a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040815 - Delete mingw build pipeline on esr115 r=taskgraph-reviewers,jcristau a=diannaS DONTBUILD\n\nRemove the win32/win64 mingwclang build jobs outright rather than\nleaving them with run-on-projects: []. Drop the mingw-only toolchains\n(linux64-mingw32-nsis, linux64-mingw-fxc2-x86, mingw32-rust-1.69,\nlinux64-clang-16-mingw-x86) and the mingw-cap mozlint check, along\nwith their orphaned build scripts. The cross-compile\nlinux64-clang-16-mingw-x64 toolchain is retained because win64-nasm\nstill uses it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301438\n", "files": ["taskcluster/ci/build/kind.yml", "taskcluster/ci/build/windows-mingw.yml", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/source-test/mozlint.yml", "taskcluster/ci/toolchain/clang.yml", "taskcluster/ci/toolchain/kind.yml", "taskcluster/ci/toolchain/mingw.yml", "taskcluster/ci/toolchain/rust.yml", "taskcluster/scripts/misc/build-mingw-fxc2-x86.sh", "taskcluster/scripts/misc/build-mingw32-nsis.sh"], "git_node": "13fd0c0c36f7f8e3e0f559f4f2debdb858400c03", "git_parents": ["e335a3f7564e76e33ffa28e4643a5968f62fbd98"], "node": "33cb82d5cd4c5c5b87fd06a69662cd9dec70a6ea", "parents": ["f48af29a3812dbe2760108265e1bcdba09aa05de"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040815 - Drop the Android build pipeline on esr115 r=taskgraph-reviewers,jcristau a=diannaS DONTBUILD\n\nRemove the android build/test/toolchain entries plus the supporting kinds,\nfetches, and docker image, along with the now-redundant android filters in\nmozilla_esr115_tasks and rebuild-cached-tasks. esr115 doesn't ship for\nAndroid, so all of this is dead config.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301439\n", "files": ["taskcluster/ci/beetmover-geckoview/kind.yml", "taskcluster/ci/build-fat-aar/kind.yml", "taskcluster/ci/build-signing/kind.yml", "taskcluster/ci/build/android-asan.yml", "taskcluster/ci/build/android-stuff.yml", "taskcluster/ci/build/android.yml", "taskcluster/ci/build/kind.yml", "taskcluster/ci/config.yml", "taskcluster/ci/docker-image/kind.yml", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/generate-profile/kind.yml", "taskcluster/ci/instrumented-build/kind.yml", "taskcluster/ci/perftest/android.yml", "taskcluster/ci/perftest/kind.yml", "taskcluster/ci/searchfox/kind.yml", "taskcluster/ci/source-test/kind.yml", "taskcluster/ci/source-test/mozlint-android.yml", "taskcluster/ci/test/browsertime-mobile.yml", "taskcluster/ci/test/kind.yml", "taskcluster/ci/test/test-platforms.yml", "taskcluster/ci/test/test-sets.yml", "taskcluster/ci/toolchain/android.yml", "taskcluster/ci/toolchain/clang.yml", "taskcluster/ci/toolchain/compiler-rt.yml", "taskcluster/ci/toolchain/kind.yml", "taskcluster/ci/toolchain/libunwind.yml", "taskcluster/ci/toolchain/rust.yml", "taskcluster/docker/android-build/Dockerfile", "taskcluster/docker/android-build/README.md", "taskcluster/docker/android-build/VERSION", "taskcluster/gecko_taskgraph/actions/rebuild_cached_tasks.py", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/transforms/beetmover_geckoview.py", "taskcluster/gecko_taskgraph/transforms/bootstrap.py", "taskcluster/gecko_taskgraph/transforms/build_fat_aar.py", "taskcluster/scripts/misc/android-gradle-dependencies-lite.sh", "taskcluster/scripts/misc/android-gradle-dependencies.sh", "taskcluster/scripts/misc/android-gradle-dependencies/after.sh", "taskcluster/scripts/misc/android-gradle-dependencies/before.sh", "taskcluster/scripts/misc/android-gradle-dependencies/nexus.xml", "taskcluster/scripts/misc/repack-android-avd-linux.sh", "taskcluster/scripts/misc/repack-android-emulator-linux.sh", "taskcluster/scripts/misc/repack-android-ndk-linux.sh", "taskcluster/scripts/misc/repack-android-sdk-linux.sh", "taskcluster/scripts/misc/repack-android-system-images-linux.sh", "taskcluster/scripts/misc/repack-jdk-linux.sh"], "git_node": "06bd5c299ea65409635027e80fa81b777be8245c", "git_parents": ["13fd0c0c36f7f8e3e0f559f4f2debdb858400c03"], "node": "762e4638d1383288faf6ebffbbae554fa32352fc", "parents": ["33cb82d5cd4c5c5b87fd06a69662cd9dec70a6ea"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040815 - Drop the clang-trunk toolchain pipeline on esr115 r=taskgraph-reviewers,jcristau a=diannaS DONTBUILD\n\nesr115 doesn't bootstrap clang from trunk: nothing in the task graph\nconsumes the trunk stage1/profile/raw/repack toolchains or their\nmatching compiler-rt-trunk variants. Remove the build-linux64-plain-\nclang-trunk job and the orphan linux32 sysroot that fell out with the\nlinux32 cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301440\n", "files": ["build/build-clang/clang-trunk.json", "taskcluster/ci/build/linux.yml", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/toolchain/clang.yml", "taskcluster/ci/toolchain/compiler-rt.yml", "taskcluster/ci/toolchain/sysroot.yml"], "git_node": "f12b90f8976286ca6f689867a839bd456f7415b5", "git_parents": ["06bd5c299ea65409635027e80fa81b777be8245c"], "node": "14dc5ca05ba228f60144b5c46ddc2738d16067af", "parents": ["762e4638d1383288faf6ebffbbae554fa32352fc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040815 - Drop the code-coverage pipeline on esr115 r=taskgraph-reviewers,jcristau a=diannaS DONTBUILD\n\nesr115 doesn't take code-coverage data; the ccov builds and tests only\nran on mozilla-central. Remove the ccov build/test/toolchain entries and\nthe win64 rust-size toolchain that only the ccov build consumed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301441\n", "files": ["taskcluster/ci/build/linux.yml", "taskcluster/ci/build/macosx.yml", "taskcluster/ci/build/windows.yml", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/test/test-platforms.yml", "taskcluster/ci/test/test-sets.yml", "taskcluster/ci/toolchain/grcov.yml", "taskcluster/ci/toolchain/kind.yml", "taskcluster/ci/toolchain/rust-size.yml"], "git_node": "d7c69200c181dbb1fdd0aa57afd1d28f3d94610b", "git_parents": ["f12b90f8976286ca6f689867a839bd456f7415b5"], "node": "da98de3afad162c72136f1d1831c32c1fcfb0f80", "parents": ["14dc5ca05ba228f60144b5c46ddc2738d16067af"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040815 - Drop the performance test pipeline on esr115 r=taskgraph-reviewers,jcristau a=diannaS DONTBUILD\n\nThe desktop browsertime tests, jsshell benchmarks, and the\ncustom-car/v8/browsertime toolchains they consumed only ran on\nmozilla-central/trunk; none of it lands on esr115. Remove the perf\ntests, their toolchains, and the nightlyasrelease builds that only\nexisted to host browsertime jobs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301442\n", "files": [".cron.yml", "taskcluster/ci/build/linux.yml", "taskcluster/ci/build/macosx.yml", "taskcluster/ci/build/windows.yml", "taskcluster/ci/docker-image/kind.yml", "taskcluster/ci/fetch/benchmarks.yml", "taskcluster/ci/fetch/browsertime.yml", "taskcluster/ci/fetch/chromium-fetch.yml", "taskcluster/ci/fetch/kind.yml", "taskcluster/ci/source-test/jsshell.yml", "taskcluster/ci/source-test/kind.yml", "taskcluster/ci/test/browsertime-desktop.yml", "taskcluster/ci/test/kind.yml", "taskcluster/ci/test/test-platforms.yml", "taskcluster/ci/test/test-sets.yml", "taskcluster/ci/toolchain/misc.yml", "taskcluster/docker/custom-car-linux/Dockerfile", "taskcluster/docker/custom-v8/Dockerfile", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/scripts/misc/browsertime.sh", "taskcluster/scripts/misc/build-custom-car-linux.sh", "taskcluster/scripts/misc/build-custom-car-win64.sh", "taskcluster/scripts/misc/build-custom-v8.sh"], "git_node": "8231ae621f20b624af8e347830e77c9a1fbd67d7", "git_parents": ["d7c69200c181dbb1fdd0aa57afd1d28f3d94610b"], "node": "fb155a530ce10b11e2c4fb0963b3ec9073601ac1", "parents": ["da98de3afad162c72136f1d1831c32c1fcfb0f80"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040815 - Remove the remaining trunk-only build pipelines on esr115 r=taskgraph-reviewers,jcristau a=diannaS DONTBUILD\n\nThe macos-native plain/rusttests, linux64-gcc, and aarch64 geckodriver\npipelines only run on mozilla-central. Delete them along with their\nsupporting toolchains and the leftover linux32/mingwclang test\nplatform/set entries that fell out as orphans.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301443\n", "files": ["taskcluster/ci/build/kind.yml", "taskcluster/ci/build/linux.yml", "taskcluster/ci/build/macosx-native.yml", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/test/test-platforms.yml", "taskcluster/ci/test/test-sets.yml", "taskcluster/ci/toolchain/gcc.yml", "taskcluster/ci/toolchain/geckodriver.yml", "taskcluster/ci/toolchain/rust.yml"], "git_node": "f1199a98d53ffd183e41599628b7b9221d05ee34", "git_parents": ["8231ae621f20b624af8e347830e77c9a1fbd67d7"], "node": "870871e90a5e4fbf4d9f79b0aeb14b36388388df", "parents": ["fb155a530ce10b11e2c4fb0963b3ec9073601ac1"], "tags": []}], "date": 1779284966, "git_changesets": ["e335a3f7564e76e33ffa28e4643a5968f62fbd98", "13fd0c0c36f7f8e3e0f559f4f2debdb858400c03", "06bd5c299ea65409635027e80fa81b777be8245c", "f12b90f8976286ca6f689867a839bd456f7415b5", "d7c69200c181dbb1fdd0aa57afd1d28f3d94610b", "8231ae621f20b624af8e347830e77c9a1fbd67d7", "f1199a98d53ffd183e41599628b7b9221d05ee34"], "user": "rvandermeulen@mozilla.com"}, "1287": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034489 - Align SharedWorker constructor with Worker.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D299973\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301803\n", "files": ["dom/workers/sharedworkers/SharedWorker.cpp"], "git_node": "d7e431cb632b9616b178c1de7358be7f80e38d5f", "git_parents": ["f1199a98d53ffd183e41599628b7b9221d05ee34"], "node": "5f0c82dd8acfd0806cb0c903a8cfd68668f00397", "parents": ["870871e90a5e4fbf4d9f79b0aeb14b36388388df"], "tags": []}], "date": 1779383886, "git_changesets": ["d7e431cb632b9616b178c1de7358be7f80e38d5f"], "user": "rvandermeulen@mozilla.com"}, "1288": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038477 ESR115: Ensure a top level doc can never be a child.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300511\n\nDifferential Revision: https://