 "1291": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043085 - Drop the MSIX pipeline on esr115 r=cdupuis,taskgraph-reviewers,bhearsum a=dmeehan\n\nRemove the MSIX repackage/signing/store-push kinds, the msix-packaging toolchain and its\nupstream fetch, the msix test variant and its test-runner/mozharness wiring, the\n./mach repackage msix subcommands, and all msix entries from release graph configs,\nbouncer, manifests, and the transform layer.\n\nAfter this, the full task graph contains zero MSIX tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302940\n", "files": ["python/moz.build", "python/mozbuild/mozbuild/mach_commands.py", "python/mozbuild/mozbuild/repackaging/msix.py", "python/mozbuild/mozbuild/repackaging/test/python.ini", "python/mozbuild/mozbuild/repackaging/test/test_msix.py", "taskcluster/ci/beetmover-repackage/kind.yml", "taskcluster/ci/config.yml", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/ci/release-bouncer-aliases/kind.yml", "taskcluster/ci/release-bouncer-sub/kind.yml", "taskcluster/ci/release-msix-push/kind.yml", "taskcluster/ci/repackage-msix/kind.yml", "taskcluster/ci/repackage-shippable-l10n-msix/kind.yml", "taskcluster/ci/repackage-signing-msix/kind.yml", "taskcluster/ci/repackage-signing-shippable-l10n-msix/kind.yml", "taskcluster/ci/test/kind.yml", "taskcluster/ci/test/mochitest.yml", "taskcluster/ci/test/test-platforms.yml", "taskcluster/ci/test/variants.yml", "taskcluster/ci/test/xpcshell.yml", "taskcluster/ci/toolchain/misc.yml", "taskcluster/ci/toolchain/sysroot.yml", "taskcluster/docs/kinds.rst", "taskcluster/gecko_taskgraph/manifests/firefox_candidates.yml", "taskcluster/gecko_taskgraph/manifests/firefox_nightly.yml", "taskcluster/gecko_taskgraph/transforms/beetmover_repackage.py", "taskcluster/gecko_taskgraph/transforms/bouncer_submission.py", "taskcluster/gecko_taskgraph/transforms/release_msix_push.py", "taskcluster/gecko_taskgraph/transforms/repackage.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/scripts/misc/build-msix-packaging.sh", "testing/mozharness/configs/releases/bouncer_firefox_beta.py", "testing/mozharness/configs/releases/bouncer_firefox_devedition.py", "testing/mozharness/configs/releases/bouncer_firefox_esr.py", "testing/mozharness/configs/releases/bouncer_firefox_release.py", "testing/mozharness/configs/unittests/win_unittest.py", "testing/mozharness/scripts/desktop_unittest.py"], "git_node": "b988a539d30914ba9eef22b2194a17888d3f93e2", "git_parents": ["5d4646d48e2fd5632ca1a9e80f0451f7f7a18b69"], "node": "599e5c1d068d299a13cb4a01450aa1b43c761d7d", "parents": ["87632c8067041a8713f5b7e95d779fc17a768570"], "tags": []}], "date": 1780000751, "git_changesets": ["b988a539d30914ba9eef22b2194a17888d3f93e2"], "user": "rvandermeulen@mozilla.com"}, "1292": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040496 - Realign taskgraph tests with the esr115 pipeline culling. a=bustage\n\nThe fuzzing, Android/geckoview, and signing pipeline removals left several\ntaskgraph unit tests asserting tasks that no longer exist on esr115. Drop the\nfuzzing build assertions, remove the now-incorrect build-signing xfail, and\ndelete the ship-geckoview parameter specs that now generate empty graphs. Also\nremove the orphaned win32-fuzzing/debug build that the fuzzing teardown missed.\n", "files": ["taskcluster/ci/build/windows.yml", "taskcluster/test/params/mb-ship-geckoview.yml", "taskcluster/test/params/mc-ship-geckoview.yml", "taskcluster/test/params/mr-ship-geckoview.yml", "taskcluster/test/test_autoland_backstop.py", "taskcluster/test/test_mach_try_auto.py", "taskcluster/test/test_mozilla_central.py"], "git_node": "84efd756a7d83aae3c1f3c942c4fc27a162df654", "git_parents": ["b988a539d30914ba9eef22b2194a17888d3f93e2"], "node": "27590e240e82