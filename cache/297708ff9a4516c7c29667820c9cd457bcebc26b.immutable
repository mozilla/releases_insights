rs.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "67eddfb0d9443a8383eeae0dc36e661838914373", "git_parents": ["b9c6967b3b3099644a07f2f6b49f3d53ddedb430"], "node": "4720ea5ee8494bb39973d985b23b544bacee1047", "parents": ["7455a4868b130ce3a2200695a8a65028bdc0efa3"], "tags": []}], "date": 1779118713, "git_changesets": ["67eddfb0d9443a8383eeae0dc36e661838914373"], "user": "rvandermeulen@mozilla.com"}, "1282": {"changesets": [{"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039070 - Emit pernosco notify pulse events for more state transitions,  a=RyanVM DONTBUILD\n\nPernosco folks indicated this would be helpful and make transitioning to\nthe new route simpler.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D300119\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300470\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/pernosco.py"], "git_node": "e1a1d147b1a0a951d5316f58341e3f28004a3a21", "git_parents": ["67eddfb0d9443a8383eeae0dc36e661838914373"], "node": "ff92e6a022dab671ca9cc5332511be5325f4b124", "parents": ["4720ea5ee8494bb39973d985b23b544bacee1047"], "tags": []}], "date": 1779121441, "git_changesets": ["e1a1d147b1a0a951d5316f58341e3f28004a3a21"], "user": "rvandermeulen@mozilla.com"}, "1283": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2039285 - Backport KVM capability support for android emulator tasks. r=jcristau a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300347\n", "files": ["taskcluster/ci/webrender/kind.yml", "taskcluster/gecko_taskgraph/transforms/job/mozharness_test.py", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "8637ffc1d269e125828ff980726c6483ca501176", "git_parents": ["e1a1d147b1a0a951d5316f58341e3f28004a3a21"], "node": "bba487981b9cde3f4faf82b171fc068d8bfc2d03", "parents": ["ff92e6a022dab671ca9cc5332511be5325f4b124"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2039285 - Fix Python 3.14 compat in taskcluster transforms: pipes.quote removed. r=jcristau a=RyanVM\n\nReplace `from pipes import quote` with `from shlex import quote` in four\ntaskcluster transform files. The `pipes` module was removed in Python 3.13.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300341\n", "files": ["taskcluster/gecko_taskgraph/transforms/bouncer_check.py", "taskcluster/gecko_taskgraph/transforms/cross_channel.py", "taskcluster/gecko_taskgraph/transforms/release_started.py", "taskcluster/gecko_taskgraph/transforms/scriptworker_canary.py"], "git_node": "cfef28a354e5ace969b9215f69d1c08e720812e8", "git_parents": ["8637ffc1d269e125828ff980726c6483ca501176"], "node": "b39cc115c22489f5d2812284d7207e1dedf150ac", "parents": ["bba487981b9cde3f4faf82b171fc068d8bfc2d03"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2039285 - Fix Python 3.12+ SyntaxWarning in preprocessor.py: use raw strings for regex patterns. r=jcristau a=RyanVM\n\nInvalid escape sequences like \\s, \\w, \\d in non-raw strings became\nSyntaxWarning in Python 3.12 and will be SyntaxError in a future version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300342\n", "files": ["python/mozbuild/mozbuild/preprocessor.py"], "git_node": "97bf5e3feb6d6af8ebe88ed981c17744836e9875", "git_parents": ["cfef28a354e5ace969b9215f69d1c08e720812e8"], "node": "2e14803d08fda12c3a5ca22d8799478a32ddfdea", "parents": ["b39cc115c22489f5d2812284d7207e1dedf150ac"], "tags": []}], "date": 1779124443, "git_changesets": ["8637ffc1d269e125828ff980726c6483ca501176", "cfef28a354e5ace969b9215f69d1c08e720812e8", "97bf5e3feb6d6af8ebe88ed981c17744836e9875"], "user": "rvandermeulen@mozilla.com"}, "1284": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e