ts": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_7_X_RELBRANCH", "desc": "No bug - Bump version to 140.7.1 a=me\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "7a239993a896d085d42843243a414389e20dc1c2", "git_parents": ["73462f0ff623648c49b17892d06fab955d6a6ee1"], "node": "87d0b840d533256de572770e64688d39ee60b39a", "parents": ["82e96a128bf5e3e7dd6e5180c9528f623ba5e0f7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "FIREFOX_ESR_140_7_X_RELBRANCH", "desc": "Bug 2014390 r=media-playback-reviewers,padenot a=RyanVM\n", "files": ["media/libvpx/libvpx/vp9/vp9_cx_iface.c"], "git_node": "1be74505011a99d24a1625526c36735b8db85fd0", "git_parents": ["7a239993a896d085d42843243a414389e20dc1c2"], "node": "b52fd675e52fc0313972c4d53bd33baa216c241d", "parents": ["87d0b840d533256de572770e64688d39ee60b39a"], "tags": ["FIREFOX_140_7_1esr_BUILD1", "FIREFOX_140_7_1esr_RELEASE"]}], "date": 1770923656, "git_changesets": ["7a239993a896d085d42843243a414389e20dc1c2", "1be74505011a99d24a1625526c36735b8db85fd0"], "user": "rvandermeulen@mozilla.com"}, "503": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013291 - Flush changes to memory-mapped files once zucchini is done updating them.  a=RyanVM DONTBUILD\n\nThis patch ensures proper flushing to disk and invalidation of metadata once\nthe zucchini algorithm is done updating a file. These memory-mapped files were\nbeing unmapped without first calling msync() or FlushViewOfFile(), causing\ndirty pages to not be properly flushed to disk and metadata not being\ninvalidated.\n\nOn all platforms, flushing to disk ensures better resilience against unexpected\nevents like system crashes or power cuts. On macOS, this also fixes a critical\nissue where the kernel skipped recomputing per-page code signatures for the\nmodified files. When code later tried to load these patched libraries, the\nkernel would detect signature mismatches and kill the process, causing Firefox\nto crash when launched after a zucchini-based update.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D281185\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282440\n", "files": ["third_party/zucchini/chromium-shim/patches/0023-Flush-changes-to-memory-mapped-files-once-zucchini-i.patch", "third_party/zucchini/chromium/base/files/memory_mapped_file.h", "third_party/zucchini/chromium/base/files/memory_mapped_file_posix.cc", "third_party/zucchini/chromium/base/files/memory_mapped_file_win.cc", "third_party/zucchini/chromium/components/zucchini/mapped_file.cc", "third_party/zucchini/chromium/components/zucchini/mapped_file.h", "third_party/zucchini/moz_zucchini.cc"], "git_node": "219c4903adea026fc81cc666cbf896d198ed2b3f", "git_parents": ["0ff2e3ccf230054966e56ffadaec3d608f343f2d"], "node": "8c197d91936bdad724d52571e22201385fd8695d", "parents": ["6c5de6e0c65c01e5fc7a5a5f75ba84f3717dd992"], "tags": []}], "date": 1770948345, "git_changesets": ["219c4903adea026fc81cc666cbf896d198ed2b3f"], "user": "rvandermeulen@mozilla.com"}, "504": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984095 - [devtools] Don't disable properties in Rule#_updateTextProperty.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D280971\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283035\n", "files": ["devtools/client/inspector/rules/models/rule.js", "devtools/client/inspector/rules/test/browser_part2.toml", "devtools/client/inspector/rules/test/browser_rules_mark_overridden_refresh.js"], "git_node": "6206d9513a657f94a45d706be00d4aebb901c0fe", "git_parents": ["219c4903adea026fc81cc666cbf896d198ed2b3f"], "node": "febc9764ef23d4fc8bcdff7bcce75c7ce7a40273", "parents": ["8c197d91936bdad724d52571e22201385fd8695d"], "tags": []}], "date": 1770948482, "git_changesets": ["6206d9513a657f94a45d706be00d4aebb901c0fe"], "user": "rvandermeulen@mozilla.com"}, "505": {"changesets": [{"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015305  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282533\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283143\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/about/AboutRedirector.cpp", "browser/components/messagepreview/actors/AboutMessagePreviewChild.sys.mjs", "browser/components/messagepreview/actors/AboutMessagePreviewParent.sys.mjs", "browser/components/messagepreview/messagepreview.css", "browser/components/messagepreview/messagepreview.js", "browser/components/messagepreview/tests/browser/browser_messagepreview_receivemessage.js", "browser/components/messagepreview/tests/browser/browser_messagepreview_show_bookmarks_bar.js", "browser/components/messagepreview/tests/browser/browser_messagepreview_show_cfr.js", "browser/components/messagepreview/tests/browser/browser_messagepreview_show_featurecallout.js", "browser/components/messagepreview/tests/browser/browser_messagepreview_show_infobar.js", "browser/components/messagepreview/tests/browser/browser_messagepreview_show_invalidmessage.js", "browser/components/messagepreview/tests/browser/browser_messagepreview_show_privatebrowsing.js", "browser/components/messagepreview/tests/browser/browser_messagepreview_show_spotlight.js", "browser/components/messagepreview/tests/browser/head.js"], "git_node": "2982a911e6cac91272d43948c426f989124860f4", "git_parents": ["6206d9513a657f94a45d706be00d4aebb901c0fe"], "node": "7971445ae1cf02433a9e40cabaef402da6ecfe94", "parents": ["febc9764ef23d4fc8bcdff7bcce75c7ce7a40273"], "tags": []}], "date": 1770948524, "git_changesets": ["2982a911e6cac91272d43948c426f989124860f4"], "user": "rvandermeulen@mozilla.com"}, "506": {"changesets": [{"