nager/ssl/tests/unit/test_signed_apps/app_mf-256_sf-256_p7-256.zip", "security/manager/ssl/tests/unit/test_signed_apps/big_manifest.zip", "security/manager/ssl/tests/unit/test_signed_apps/cose_int_signed_with_pkcs7.zip", "security/manager/ssl/tests/unit/test_signed_apps/cose_multiple_signed_with_pkcs7.zip", "security/manager/ssl/tests/unit/test_signed_apps/cose_signed_with_pkcs7.zip", "security/manager/ssl/tests/unit/test_signed_apps/cose_tampered_good_pkcs7.zip", "security/manager/ssl/tests/unit/test_signed_apps/empty_signerInfos.zip", "security/manager/ssl/tests/unit/test_signed_apps/huge_manifest.zip", "security/manager/ssl/tests/unit/test_signed_apps/only_cose_multiple_signed.zip", "security/manager/ssl/tests/unit/test_signed_apps/only_cose_signed.zip", "security/manager/ssl/tests/unit/test_signed_apps/unknown_issuer_app.zip", "security/manager/ssl/tests/unit/test_signed_apps/unsigned_app.zip", "security/manager/ssl/tests/unit/test_signed_apps/validity_expired.zip", "security/manager/ssl/tests/unit/test_signed_apps/validity_not_yet_valid.zip", "security/manager/ssl/tests/unit/test_trust_anchors/int.pem", "security/manager/ssl/tests/unit/test_validity/ev_ee_27_months-ev_int_60_months-evroot.pem", "security/manager/ssl/tests/unit/test_validity/ev_ee_28_months-ev_int_60_months-evroot.pem", "security/manager/ssl/tests/unit/test_validity/ev_int_60_months-evroot.pem", "services/settings/test/unit/test_remote_settings_signatures/collection_signing_ee.pem", "services/settings/test/unit/test_remote_settings_signatures/collection_signing_int.pem", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_aus_ee.pem", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/content_signing_int.pem"], "git_node": "97cbbc60429987e051a5b328d6c8cf73df42ef1d", "git_parents": ["f875edfcb7da06c82cbc03a69ff94fb4a1826696"], "node": "b3103f4f89b641cde51a5c431aae0a5cc21102f4", "parents": ["a0b4289d89ab468db03a7d85b9486e1f4fa9a042"], "tags": []}], "date": 1769697852, "git_changesets": ["97cbbc60429987e051a5b328d6c8cf73df42ef1d"], "user": "dmeehan@mozilla.com"}, "465": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280913\n", "files": ["security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json"], "git_node": "fd8b8585e688b396b9522892c161f1c70e1473a1", "git_parents": ["97cbbc60429987e051a5b328d6c8cf73df42ef1d"], "node": "e99481afbc401c0ca5776c25d74f8524abe4735c", "parents": ["b3103f4f89b641cde51a5c431aae0a5cc21102f4"], "tags": []}], "date": 1769698067, "git_changesets": ["fd8b8585e688b396b9522892c161f1c70e1473a1"], "user": "dmeehan@mozilla.com"}, "466": {"changesets": [{"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1910011 - Update partitionKey before minting Client principal.  a=dmeehan DONTBUILD\n\nThis patch addresses a partitionKey mismatch between a created Client\nprincipal and the intercepting ServiceWorker resulting from the case\nwhere an ABB iframe is created where the page load of the nested B is\nredirected back to be an ABA iframe.  The initial partition key for the\nB load lacks a foreign-bit, but the post-redirect A will (eventually)\nhave a foreign bit.\n\nCurrently, the partition key for cross-origin redirects is updated for\nCookieJarSettings by AntiTrackingUtils::UpdateAntiTrackingInfoForChannel\nin nsHttpChannel::AsyncOpen.  However, ClientChannelHelper samples the\nprincipal in its AsyncOnChannelRedirect listener which will happen\nstrictly before the AsyncOpen.  So it's essential for us to update the\ninfo before minting a partitioned principal for the channel in the CCH.\n\n(The InterceptedHttpChannel logic and redirect happens strictly after\nthe nsHttpChannel::AsyncOpen, which is how the ServiceWorker lookup\nis using a partitioned principal with the foreign bit set.)\n\nThis has been a longstanding problem since the introduction of the\nforeign bit that has been papered over by the logic in\nnsGlobalWindowInner::EnsureClientSource that checks if there is\nan existing mClientSource and then resets it silently if there is a\nmismatch in between the client principal and the foreign principal.\n(The initial mClientSource was from LoadInfo::TakeReservedClientSource\nand lacked a foreign bit in this case.)\n\nA related problem was solved in a similar way in bug 1736488 with\nhttps://phabricator.services.mozilla.com/D211148 where we manually\ncalled the UpdateAntiTrackingInfoForChannel method before adding the\nClientChannelHelper in DocumentLoadListener.  This does raise the\nquestion of whether that call should be in ClientChannelHelper, but\nbug 1970169 since moved that call up and added dependent logic, so\nI think the answer is DocumentLoadListener remains the right place\nfor that call, but ClientChannelHelper probably is the right place\nfor this new call since responsibility for the client info is handed\noff from the DocumentLoadListener once it calls\nAddClientChannelHelperInParent.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D280394\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280784\n", "files": ["dom/clients/manager/ClientChannelHelper.cpp", "toolkit/components/antitracking/test/browser/browser.toml", "toolkit/components/antitracking/test/browser/browser_partitionedABBredirectToABAServiceWorkers.js"], "git_node": "f4b50122b1e26d35771b9824d50b95e2e526572a", "git_parents": ["fd8b8585e688b396b9522892c161f1c70e1473a1"], "node": "3a672af77ae5542c29cc67e3db81636f6295e6aa", "parents": ["e99481afbc401c0ca5776c25d74f8524abe4735c"], "tags": []}], "date": 1770041719, "git_changesets": ["f4b50122b1e26d35771b9824d50b95e2e526572a"], "user": "dmeehan@mozilla.com"}, "467": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012018 - Simplify property lookup in SuppressDeletedProperty.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D280679\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281180\n", "files": ["js/src/vm/Iteration.cpp"], "git_node": "7777b729fc5bb28924a1b2df985a892e52ef5e6e", "git_parents": ["f4b50122b1e26d35771b9824d50b95e2e526572a"], "node": "835d3ec6cb8a0b733d41d9dbcca686b1d6f3466c", "parents": ["3a672af77ae5542c29cc67e3db81636f6295e6aa"], "tags": []}], "date": 1770041759, "git_changesets": ["7777b729fc5bb28924a1b2df985a892e52ef5e6e"], "user": "dmeehan@mozilla.com"}, "468": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281406\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json"], "git_node": "2c582acf071fc16c28f452c29372e9902c894cdf", "git_parents": ["7777b729fc5bb28924a1b2df985a892e52ef5e6e"], "node": "e89490d5c377cc8f9daa175d79c2913335d08583", "parents": ["835d3ec6cb8a0b733d41d9dbcca686b1d6f3466c"], "tags": []}], "date": 1770041906, "git_changesets": ["2c582acf071fc16c28f452c29372e9902c894cdf"], "user": "dmeehan@mozilla.com"}, "469": {"changesets": [{"author": "Cristina Horotan \u003cchorotan@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1989340 - Only set GSS_C_DELEG_FLAG flag when server supports delegation r=necko-reviewers,kershaw\" on request for causing bug 2013451\n\nThis reverts commit a7dfc5d5320a8c649fcc0a0e534b5d41226990ce.\n", "files": ["extensions/auth/nsAuthGSSAPI.cpp", "extensions/auth/nsAuthGSSAPI.h"], "git_node": "b5a31ca833c1d6065be430f83ac673f6b0f17cd3", "git_parents": ["2c582acf071fc16c28f452c29372e9902c894cdf"], "node": "9c4a0c4916fa21a574a8c3b6b9fa5bdf1440d1a8", "parents": ["e89490d5c377cc8f9daa175d79c2913335d08583"], "tags": []}], "date": 1770054411, "git_changesets": ["b5a31ca833c1d6065be430f83ac673f6b0f17cd3"], "user": "dmeehan@mozilla.com"}, "470": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2013337 - Fix missing-closing-characters checks in custom property parsing.  a=dmeehan DONTBUILD\n\nWhat is going on in this page is:\n\n * We have two nested references + fallback, both with missing closing\n   parens.\n * But the value actually ends with a closing paren, the rgb() function.\n\nSo we fail to detect that the closing parens are missing, and we mess up\nthe indices during substitution because we rely on the fallback end\nbeing the end of the var() reference minus 1.\n\nProperly tests for it by checking the block end against the\noutside-of-the-block start. If they're the same there was no closing\nparen. We could extend cssparser with this information maybe but for now\nthis seems ok. UnquotedUrl I think we can leave as-is.\n\nAdd two tests, once with a would be successful substitution that we get\nwrong right now, but this patch fixes, and the actually crashing test.\n\nI'm a bit surprised that no fuzzer has found this before tbh...\n\nOriginal Revision: https://phabricator.services.mozilla.com/D281506\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281758\n", "files": ["servo/components/style/custom_properties.rs", "testing/web-platform/tests/css/css-variables/missing-closing-nested-fallback-crash.html", "testing/web-platform/tests/css/css-variables/missing-closing-nested-fallback.html"], "git_node": "c4ecebe9616390b99f73a081fc368ab84301243d", "git_parents": ["b5a31ca833c1d6065be430f83ac673f6b0f17cd3"], "node": "33002d364da0ec950a77ffad5d4f20445f59cdcc", "parents": ["9c4a0c4916fa21a574a8c3b6b9fa5bdf1440d1a8"], "tags": []}], "date": 1770213395, "git_changesets": ["c4ecebe9616390b99f73a081fc368ab84301243d"], "user": "dmeehan@mozilla.com"}, "471": {"changesets": [{"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 2011063: Reject snapshots for unsupported formats. r=gfx-reviewers,jnicol a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280864\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "2767fd163a878f0bf8035dc42d51ba56dfe90735", "git_parents": ["c4ecebe9616390b99f73a081fc368ab84301243d"], "node": "19ae312302df2b86652bb1dc10d7a2a5b4b5c503", "parents": ["33002d364da0ec950a77ffad5d4f20445f59cdcc"], "tags": []}], "date": 1770213706, "git_changesets": ["2767fd163a878f0bf8035dc42d51ba56dfe90735"], "user": "dmeehan@mozilla.com"}, "472": {"changesets": [{"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013577 - Disallow meaningless scope/policy combination in deserialize() testing functions, and add a release assert  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D281276\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281827\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/structured-clone/sab-errMsg.js", "js/src/jit-test/tests/wasm/memory-cloning.js", "js/src/vm/StructuredClone.cpp"], "git_node": "ec4ba4f86708f1a0282e6c02ea2d28d05cc96308", "git_parents": ["2767fd163a878f0bf8035dc42d51ba56dfe90735"], "node": "a0d8506fdb9ee5687cabb40379a8fd9cb361b3d5", "parents": ["19ae312302df2b86652bb1dc10d7a2a5b4b5c503"], "tags": []}], "date": 1770296977, "git_changesets": ["ec4ba4f86708f1a0282e6c02ea2d28d05cc96308"], "user": "dmeehan@mozilla.com"}, "473": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.