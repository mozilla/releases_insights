003e", "branch": "default", "desc": "Bug 2015266  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282425\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282518\n", "files": ["toolkit/components/telemetry/other/CombinedStacks.cpp"], "git_node": "946b8b5d56841ce13be4addb01323c27f634c973", "git_parents": ["2fcaef772ff20f0cc463dc713318bde0c37c4694"], "node": "279ae19e48902568cfadd3dbb991a99d3bd0e98c", "parents": ["5457ad37593c0439cf85389b80956dd3bce77b20"], "tags": []}], "date": 1770806869, "git_changesets": ["946b8b5d56841ce13be4addb01323c27f634c973"], "user": "dmeehan@mozilla.com"}, "488": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013741: Clean up misleading comments in array.fill.  a=dmeehan\n\nThe comments were pulled from a different array method and were slightly\nmisleading about how the assembly was generated.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D281627\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282443\n", "files": ["js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "4d910cdf25cafdb0b721a6838b9ba6676af4702d", "git_parents": ["946b8b5d56841ce13be4addb01323c27f634c973"], "node": "c33894107b8eff45229e97791f99c297c4b421a7", "parents": ["279ae19e48902568cfadd3dbb991a99d3bd0e98c"], "tags": []}], "date": 1770820255, "git_changesets": ["4d910cdf25cafdb0b721a6838b9ba6676af4702d"], "user": "dmeehan@mozilla.com"}, "489": {"changesets": [{"author": "Bastien Orivel \u003cborivel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1890753 - Add a task to mark merge automation as complete in shipit.  a=dmeehan DONTBUILD\n\nThis is part of moving merge automation from an action task that has to\nbe run through treeherder to a fully supported shipit action.\n\nJust like shipping uses `mark-as-shipped` to tell shipit that a release\ngraph is done, this creates a `mark-as-merged` that runs after the merge\nautomation graph is done. This means that we're now requesting a merge\nautomation ID as part of the merge automation input, which shipit will\nprovide when triggering said automation.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D280400\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282667\n", "files": ["taskcluster/docs/kinds.rst", "taskcluster/gecko_taskgraph/actions/merge_automation.py", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/transforms/mark_as_merged.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/mark-as-merged/kind.yml"], "git_node": "11691d3e7407aa12c50b9ae1be17b48a6cc7a74b", "git_parents": ["4d910cdf25cafdb0b721a6838b9ba6676af4702d"], "node": "5e1a1df563672302dc97a1657a1837d820ad96b1", "parents": ["c33894107b8eff45229e97791f99c297c4b421a7"], "tags": []}], "date": 1770820795, "git_changesets": ["11691d3e7407aa12c50b9ae1be17b48a6cc7a74b"], "user": "dmeehan@mozilla.com"}, "490": {"changesets": [{"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2014616: Always create the Profile Groups folder in case it is missing.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282027\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282608\n", "files": ["browser/components/profiles/tests/unit/test_fail_recover_storeID.js", "toolkit/profile/ProfilesDatastoreService.sys.mjs"], "git_node": "a0609ef70e4514837149384e2be6ac0883bec31f", "git_parents": ["11691d3e7407aa12c50b9ae1be17b48a6cc7a74b"], "node": "0deb03ec7718c52c916a06a6c17f0f7914448f63", "parents": ["5e1a1df563672302dc97a1657a1837d820ad96b1"], "tags": []}], "date": 1770820839, "git_changesets": ["a0609ef70e4514837149384e2be6ac0883bec31f"], "user": "dmeehan@mozilla.com"}, "491": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013549 - Give synthetic module environments a *namespace* property the same as for cyclic modules  a=dmeehan DONTBUILD\n\nModule environments are given this special internal property that can hold a\nreference to the module's namespace object if needed. The property itself is\nused when module's namespace is imported and then that binding is exported. An\nimport of that uses the binding of the module namespace object in the original\nobject's environment.\n\nFor cyclic modules this happens by Parser::moduleBody adding a fake declaration\nfor this name, but this is not done for synthetic modules which don't come from\nparsed JS. The patch adds this name for synthetic modules.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D281434\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282669\n", "files": ["js/src/builtin/ModuleObject.cpp", "js/src/vm/EnvironmentObject.h", "js/src/vm/Modules.cpp", "js/src/vm/Scope.cpp"], "git_node": "88809d9c9b3a61684a377d0a5b9b01b83f6f9392", "git_parents": ["a0609ef70e4514837149384e2be6ac0883bec31f"], "node": "75fef9a15dcbc85cc72b851348e2e35c568570a9", "parents": ["0deb03ec7718c52c916a06a6c17f0f7914448f63"], "tags": []}], "date": 1770820881, "git_changesets": ["88809d9c9b3a61684a377d0a5b9b01b83f6f9392"], "user": "dmeehan@mozilla.com"}, "492": {"changesets": [{"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2001637 - Ensure valid image size.;  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282024\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282680\n", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp"], "git_node": "59208f5bac16004e6e39f7e164de7706c9730bae", "git_parents": ["88809d9c9b3a61684a377d0a5b9b01b83f6f9392"], "node": "99c5f6d74b0196527be522d646ede2cb437aa0be", "parents": ["75fef9a15dcbc85cc72b851348e2e35c568570a9"], "tags": []}], "date": 1770820923, "git_changesets": ["59208f5bac16004e6e39f7e164de7706c9730bae"