, "git_node": "3fccb0ec900b931a1a752b02eafab1fb9652d9b9", "git_parents": ["60e0fcccbaffb10c3ab0df42af959af0d3ffe8b4"], "node": "438cab3b2a017164f5e63fdfc6544ff5683d4307", "parents": ["5f19a3992745fa1e69416ce301c0dc790a15f9d8"], "tags": []}], "date": 1770430155, "git_changesets": ["3fccb0ec900b931a1a752b02eafab1fb9652d9b9"], "user": "rvandermeulen@mozilla.com"}, "478": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950282 - update our webcompat intervention for f1tv.formula1.com;  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282280\n", "files": ["browser/extensions/webcompat/injections/js/bug1950282-f1tv.formula1.com-unblock-firefox.js", "browser/extensions/webcompat/manifest.json", "testing/webcompat/interventions/tests/test_1950282_f1tv_formula1_com.py"], "git_node": "f0415f7d2d0cc41ad562f05b39af5cc11dc240e0", "git_parents": ["3fccb0ec900b931a1a752b02eafab1fb9652d9b9"], "node": "c7a6bdb6500488cdde6d7f0b02cc40476301a9d2", "parents": ["438cab3b2a017164f5e63fdfc6544ff5683d4307"], "tags": []}], "date": 1770658084, "git_changesets": ["f0415f7d2d0cc41ad562f05b39af5cc11dc240e0"], "user": "dmeehan@mozilla.com"}, "479": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013583 - Mark ICScripts as active when cloning stubs.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D281442\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282338\n", "files": ["js/src/jit/BaselineIC.h", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIR.h", "js/src/jit/CacheIRCloner.h", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIROps.yaml", "js/src/jit/CacheIRWriter.h", "js/src/jit/GenerateCacheIRFiles.py", "js/src/jit/JitScript.cpp", "js/src/jit/WarpOracle.cpp", "js/src/jit/WarpSnapshot.cpp"], "git_node": "3f78a4ff83b9c3a313c365b0ac4b991b438443d0", "git_parents": ["f0415f7d