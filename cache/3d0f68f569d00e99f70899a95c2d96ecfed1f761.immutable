c4467bb"], "tags": []}], "date": 1771071161, "git_changesets": ["53618d3e93d78d836456780de2f8a34553b5de84"], "user": "dmeehan@mozilla.com"}, "515": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2014832 -  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282171\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283306\n", "files": ["dom/media/webaudio/MediaBufferDecoder.cpp"], "git_node": "2186e660e2690ac1f63789f9892632b720601fe3", "git_parents": ["53618d3e93d78d836456780de2f8a34553b5de84"], "node": "1c5692b3746af0fbf962d2d44fb88e1c4ff16213", "parents": ["85c5abd29f5d283252770576f2c243d121cc77ed"], "tags": []}], "date": 1771071200, "git_changesets": ["2186e660e2690ac1f63789f9892632b720601fe3"], "user": "dmeehan@mozilla.com"}, "516": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2014883.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282414\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283303\n", "files": ["dom/media/webm/WebMDemuxer.cpp"], "git_node": "13d4f1ca423b15a380b752664be0d9a45b7bba37", "git_parents": ["2186e660e2690ac1f63789f9892632b720601fe3"], "node": "6653cb93063f0b47ba0994cf8602c614ea06a819", "parents": ["1c5692b3746af0fbf962d2d44fb88e1c4ff16213"], "tags": []}], "date": 1771071237, "git_changesets": ["13d4f1ca423b15a380b752664be0d9a45b7bba37"], "user": "dmeehan@mozilla.com"}, "517": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014550: Reset FileInfoEntry::mSavepointDelta after the rollback.  a=dmeehan DONTBUILD\n\nThis bug exposes an edge case with IDB blob file ref-counting. `FileInfo` manages the blob file at runtime and contains the logic for on-disk file management. It does so by maintaining both an in-memory ref-count and a DB ref-count. `FileInfoEntry` manages the DB ref-counting side of things during an active transaction and pushes the effective delta to the DB ref-count after the transaction commits (via `FileInfoEntry::MaybeUpdateDBRefs`), i.e., at the end of the transaction's lifetime.\n\nThe test case in question (as attached to the bug) opens an IDB database and stores 3 records that each reference the same blob, giving the underlying blob file a DB ref-count of 3. It then starts a new read-write transaction and attempts to add 3 more records that intentionally violate a unique index constraint. Each failed `add()` raises a `ConstraintError`, and the error handler calls `e.preventDefault()` to keep the transaction alive rather than allowing it to abort. Internally, each individual IDB operation runs inside a Auotsavepoint. When an operation fails, the savepoint is rolled back, but the transaction itself continues normally to the next operation.\n\n`FileInfoEntry` has two fields for tracking ref-count changes: `mDelta` and `mSavepointDelta`. `mDelta` accumulates the total ref-count change for the entire transaction and is the value that ultimately gets applied to `FileInfo`'s DB ref-count at commit time. `mSavepointDelta` tracks the ref-count changes made within the current savepoint, so that if the savepoint is rolled back, those changes can be subtracted from `mDelta` to restore it to its pre-savepoint value.\n\nThe issue is that even though we are calculating mDelta after every rollback but it's not correct as the mSavepointDelta was never reset after the rollback and on the next rollback attempt, it would still has the stale value from the last savepoint.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D282624\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283295\n", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": "80b1263869753bab492385bdd6b249aa83897123", "git_parents": ["13d4f1ca423b15a380b752664be0d9a45b7bba37"], "node": "b1106f8c200dbcd009d8e3f0d83a7215cf31f893", "parents": ["6653cb93063f0b47ba0994cf8602c614ea06a819"], "tags": []}], "date": 1771071276, "git_changesets": ["80b1263869753bab492385bdd6b249aa83897123"], "user": "dmeehan@mozilla.com"}, "518": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2016358 - Use Span in ReadStructuredCloneInternal.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283128\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283287\n", "files": ["dom/base/StructuredCloneBlob.cpp"], "git_node": "b66208edc8a4fb22362567671371dcf111f2260a", "git_parents": ["80b1263869753bab492385bdd6b249aa83897123"], "node": "a58215c1b79f7c0350fe0588f75b5322625f0747", "parents": ["b1106f8c200dbcd009d8e3f0d83a7215cf31f893"], "tags": []}], "date": 1771071314, "git_changesets": ["b66208edc8a4fb22362567671371dcf111f2260a"], "user": "dmeehan@mozilla.com"}, "519": {"changesets": [{"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016498 - Fix Span::Subspan assertion.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283118\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283193\n", "files": ["mfbt/Span.h"], "git_node": "44ed1ce4f93650971efdbe095cd2a367f6fa7119", "git_parents": ["b66208edc8a4fb22362567671371dcf111f2260a"], "node": "734a1a8ad34c147d3a50e14aac055b1a7ad8343b", "parents": ["a58215c1b79f7c0350fe0588f75b5322625f0747"], "tags": []}], "date": 1771071353, "git_changesets": ["44ed1ce4f93650971efdbe095cd2a367f6fa7119"], "user": "dmeehan@mozilla.com"}, "520": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012608: Create this after pushing arguments (esr140) r=jandem a=dmeehan DONTBUILD\n\nCompared to the beta/release patch, the difference here is that we still have rectifier frames. The most subtle change is in pushStandardArguments, where alignJitStackBasedOnNArgs can no longer pass a hardcoded value for countIncludesThis. (In more recent releases, alignment happens earlier and is not affected by the changes in this patch.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282687\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/BaselineCacheIRCompiler.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "12c49cacb48ca2e5e95e5f29d066901ff4114e8e", "git_parents": ["44ed1ce4f93650971efdbe095cd2a367f6fa7119"], "node": "0d48206f44841430ff729459d33812d164023e65", "parents": ["734a1a8ad34c147d3a50e14aac055b1a7ad8343b"], "tags": []}], "date": 1771071410, "git_changesets": ["12c49cacb48ca2e5e95e5f29d066901ff4114e8e"], "user": "dmeehan@mozilla.com"}, "521": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016423. r=ahale a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283207\n", "files": ["dom/canvas/TexUnpackBlob.cpp", "dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLTypes.h"], "git_node": "4ae24b905d79ea54c290569f86f3a71f2a13eccf", "git_parents": ["12c49cacb48ca2e5e95e5f29d066901ff4114e8e"], "node": "55001601f38c5725c98505afdd1b0f2d7dd2df02", "parents": ["0d48206f44841430ff729459d33812d164023e65"], "tags": []}], "date": 1771235646, "git_changesets": ["4ae24b905d79ea54c290569f86f3a71f2a13eccf"], "user": "dmeehan@mozilla.com"}, "522": {"changesets": [{"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016872 - Attempt to pin or check pin status even if unlocking the LAF fails on Windows 11.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D283395\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283399\n", "files": ["browser/components/shell/Windows11TaskbarPinning.cpp"], "git_node": "c92f2a6defc03abad56d9004c280ddba45a6711f