@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fa3a91ecc3749957626b94f3869257a4e40e2123 with FIREFOX_115_32_1esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "6fbd1119bdfaff2ca0eb07d4b83f1c3678df4036", "git_parents": ["ff9932dcf87fd135fdf3565c54e6595ba14329e9"], "node": "ca7131a8868825247b18b0d66dc6eecc5c819d6a", "parents": ["f5a77d3cfe2d948604d412a3d8ab02de554260a5"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 31751d804221a41c0fafc7669dde803ab6533210 with FIREFOX_RELEASE_147_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d241bf15b8000a075b2aa3f1090b738d98327d23", "git_parents": ["6fbd1119bdfaff2ca0eb07d4b83f1c3678df4036"], "node": "56995bc912490ab16627846a8dd1cba77c4e151d", "parents": ["ca7131a8868825247b18b0d66dc6eecc5c819d6a"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3b539c27a10348ad08e2486fcca740eeee895b2f with FIREFOX_RELEASE_148_BASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "354a1a7a41f86cde624bc362d41450686794b82e", "git_parents": ["d241bf15b8000a075b2aa3f1090b738d98327d23"], "node": "eb936b3ec330fcc06e6792e2c823f490ab14dc8b", "parents": ["56995bc912490ab16627846a8dd1cba77c4e151d"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 9c45afd1a6c51ba0610bd08b9edfe402dd433b71 with FIREFOX_140_8_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a03084a26b78e9a6a84bc5e8d0725dceb53f341b", "git_parents": ["354a1a7a41f86cde624bc362d41450686794b82e"], "node": "c8871dacf2043e2ebc781d26f7c73000ef87d9e7", "parents": ["eb936b3ec330fcc06e6792e2c823f490ab14dc8b"], "tags": []}], "date": 1771257242, "git_changesets": ["ff9932dcf87fd135fdf3565c54e6595ba14329e9", "6fbd1119bdfaff2ca0eb07d4b83f1c3678df4036", "d241bf15b8000a075b2aa3f1090b738d98327d23", "354a1a7a41f86cde624bc362d41450686794b82e", "a03084a26b78e9a6a84bc5e8d0725dceb53f341b"], "user": "ffxbld@lando.moz.tools"}, "526": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2017183: Adjust NumTraceableArgsForCreateThis for ESR r=spidermonkey-reviewers,arai a=dmeehan\n\nESR (both 115 and 140) don't contain bug 1983137. This means that we adjust for arguments underflow in the arguments rectifier, which happens after calling createThis, so NumTraceableArgsForCreateThis should always just use argc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283620\n", "files": ["js/src/jit/VMFunctions.cpp"], "git_node": "8e68786ea78b267da12a0b64999ea2573178cb7d", "git_parents": ["0e1da688705229f741d9f61a1140f7bed146f209"], "node": "b23aff4bbac16e44f2a9d3127c18616acfef6166", "parents": ["9c45afd1a6c51ba0610bd08b9edfe402dd433b71"], "tags": ["FIREFOX_140_8_0esr_BUILD2", "FIREFOX_140_8_0esr_RELEASE"]}], "date": 1771325705, "git_changesets": ["8e68786ea78b267da12a0b64999ea2573178cb7d"], "user": "dmeehan@mozilla.com"}}
}";