nts": ["0e6515b60e31e5af7971fab4343892c2cd9bc8c2"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 82e96a128bf5e3e7dd6e5180c9528f623ba5e0f7 with FIREFOX_140_7_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "02d5609aa0fbba2b3464829f449b4afb9f80efca", "git_parents": ["e67864dd806021afaa85e46cb10c987c8a6e22a6"], "node": "f359e6e723ae377adb67a3c2399ee3622a3eae60", "parents": ["325c97471a0daff5edf51e8fd276a5b48e6b7d5b"], "tags": []}], "date": 1768311003, "git_changesets": ["78bf1e6c799f5e8c3e7dd5d9f6ec0b8ab69d4146", "89ca257733f13c25c4211010693ad0c017936f18", "261ede55c48fb2b6a71f89cfd3dcdbe41cc4240f", "496d41ddb871550c38da461f43666a4402f92091", "1f3c8efd16aa5cd30820d4100c389cdecda0192c", "ccc6d8e2f8e29b515a210d8ad88320713774a120", "0276713a53a3158f27700f890c01c20ad528fbf0", "4f26fe4ffc25a20dc6c0776e2fc0b10fac78813b", "e67864dd806021afaa85e46cb10c987c8a6e22a6", "02d5609aa0fbba2b3464829f449b4afb9f80efca"], "user": "ffxbld@lando.moz.tools"}, "430": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 1976929 - Don't assume MediaChangeMonitor::mDecodePromise is set after dispatching.  a=dmeehan DONTBUILD\n\nSince the owner can call MediaChangeMonitor::Shutdown and reject any\noutstanding promises, we shouldn't assume mDecodePromise will still be\nset in any promise chains after dispatching. This will allow us to\nshutdown gracefully.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278127\n", "files": ["dom/media/platforms/wrappers/MediaChangeMonitor.cpp"], "git_node": "43d0b1c3713f06ce14a159dbd7540b3687306ee7", "git_parents": ["9942ac616e7906a69d5bb7e5ed288904183ec59e"], "node": "bc50d80d643620153527f181a3b9271d1345da5f", "parents": ["31ed162cf7fb28fc801182b34744a08a4cb8be5e"], "tags": []}], "date": 1768483603, "git_changesets": ["43d0b1c3713f06ce14a159dbd7540b3687306ee7"], "user": "dmeehan@mozilla.com"}, "431": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1950033 - Ignore pywebsocket3 intermediate files created by raptor command.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D276160\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278914\n", "files": [".gitignore", ".hgignore"], "git_node": "596eb9859f07cbf612ceb136bdf4d5dd4c655395", "git_parents": ["43d0b1c3713f06ce14a159dbd7540b3687306ee7"], "node": "04837eed4a288b0d11e81d236b04d2a854942364", "parents": ["bc50d80d643620153527f181a3b9271d1345da5f"], "tags": []}], "date": 1768483649, "git_changesets": ["596eb9859f07cbf612ceb136bdf4d5dd4c655395"], "user": "dmeehan@mozilla.com"}, "432": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2006233 - Accept partially initialized DNR store on browser startup  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D278132\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278775\n", "files": ["toolkit/components/extensions/ExtensionDNRStore.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_dynamic_rules.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_static_rules.js"], "git_node": "4e1b4115cfe98f0150daa3ef74d8c39bd8a1691c", "git_parents": ["596eb9859f07cbf612ceb136bdf4d5dd4c655395"], "node": "a431cde535abb2b474fecda2b211d8726784e854", "parents": ["04837eed4a288b0d11e81d236b04d2a854942364"], "tags": []}], "date": 1768483695, "git_changesets": ["4e1b4115cfe98f0150daa3ef74d8c39bd8a1691c"], "user": "dmeehan@mozilla.com"}, "433": {"changesets": [{"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1985140: Prevent OSXVsyncSource from creating a display link after it fails to register a reconfiguration callback.  a=dmeehan DONTBUILD\n\nThis also changes NS_WARNING to gfxWarning(), in the hope of making serious vysnc failures more\nvisible.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D262819\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277917\n", "files": ["gfx/thebes/gfxPlatformMac.cpp"], "git_node": "547386b135dcaa7d39bc022be366cb2df19d3f27", "git_parents": ["4e1b4115cfe98f0150daa3ef74d8c39bd8a1691c"], "node": "aafff8f0db7ec429b8338192d2f43036863cf9bb", "parents": ["a431cde535abb2b474fecda2b211d8726784e854"], "tags": []}, {"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1985140 Part 2: Make OSXVsyncSource safely retry vsync within display reconfiguration callback.  a=dmeehan DONTBUILD\n\nThis changes a few things:\n1) CreateDisplayLink loses its ability to reschedule itself. This is\nbecause the rescheduling is only useful within the display\nreconfiguration callback, and in such a case should be followed by a\ncall to EnableVsync.\n2) A new retry callback CreateDisplayLinkAndEnableVsync is created to\nhandle the one-time retry within the display reconfiguration callback.\n3) The OSXVsyncSource constructor no longer attempts to recreate the\ndisplay link if CreateDisplayLink fails. The only callsite for the\nconstructor will fallback to software vsync in such a case, and the\nrescheduled attempt wasn't preventing that from happening anyway.\n4) There are more gfxWarning messages, with more clarity on exactly\nwhich call has failed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269119\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277918\n", "files": ["gfx/thebes/gfxPlatformMac.cpp"], "git_node": "322245ef6ff68607f289a224649c90ef82c1a8db", "git_parents": ["547386b135dcaa7d39bc022be366cb2df19d3f27"], "node": "0184939db2ae98bb9fafd8cc89f204df617d21d5", "parents": ["aafff8f0db7ec429b8338192d2f43036863cf9bb"], "tags": []}, {"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1985140 Part 3: Make OSXVsyncSource give up when display reconfiguration fails.  a=dmeehan DONTBUILD\n\nThis adds a method gfxPlatform::ResetHardwareVsyncSource to allow a\nhardware vsync source to remove itself when needed. The OSXVsyncSource\nnow calls this method when display reconfiguration fails, and the\ntime-delayed retry *also* fails. This allows a software vsync method to\nbe used as a fallback, ensuring that some vsync source is active.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D273131\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277919\n", "files": ["gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "gfx/thebes/gfxPlatformMac.cpp"], "git_node": "1b751451aec7560dd186d204f5527c11a481c8bd", "git_parents": ["322245ef6ff68607f289a224649c90ef82c1a8db"], "node": "7f9db67729833bd79fbd877c910e9c3046e2bfab", "parents": ["0184939db2ae98bb9fafd8cc89f204df617d21d5"], "tags": []}], "date": 1768500807, "git_changesets": ["547386b135dcaa7d39bc022be366cb2df19d3f27", "322245ef6ff68607f289a224649c90ef82c1a8db", "1b751451aec7560dd186d204f5527c11a481c8bd"], "user": "dmeehan@mozilla.com"}, "434": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279182\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin.meta.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "cc881c999b80215ca6aa1861f97bbd0277462048", "git_parents": ["1b751451aec7560dd186d204f5527c11a481c8bd"], "node": "8602584abdd38e37dcc881b58ac5da2ba3afe924", "parents": ["7f9db67729833bd79fbd877c910e9c3046e2bfab"], "tags": []}], "date": 1768501180, "git_changesets": ["cc881c999b80215ca6aa1861f97bbd0277462048"], "user": "dmeehan@mozilla.com"}, "435": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 1985140 Part 3: Make OSXVsyncSource give up when display reconfiguration fails.  a=dmeehan\" for causing macOS build failures\n\nThis reverts commit 1b751451aec7560dd186d204f5527c11a481c8bd.\n", "files": ["gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "gfx/thebes/gfxPlatformMac.cpp"], "git_node": "556413f6c355ea8d7c5711319f0b4d46ab0737f0", "git_parents": ["cc881c999b80215ca6aa1861f97bbd0277462048"], "node": "d81f03d0a0799ff22343aba6d537921a82efdc95", "parents": ["8602584abdd38e37dcc881b58ac5da2ba3afe924"], "tags": []}, {"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 1985140 Part 2: Make OSXVsyncSource safely retry vsync within display reconfiguration callback.  a=dmeehan\" for causing macOS build failures\n\nThis reverts commit 322245ef6ff68607f289a224649c90ef82c1a8db.\n", "files": ["gfx/thebes/gfxPlatformMac.cpp"], "git_node": "3bb00f4e555641d723638ddcaa7dba231391b427", "git_parents": ["556413f6c355ea8d7c5711319f0b4d46ab0737f0"], "node": "9898e30663557fa1dc2fecbe1863ba46a8edcfba", "parents": ["d81f03d0a0799ff22343aba6d537921a82efdc95"], "tags": []}, {"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 1985140: Prevent OSXVsyncSource from creating a display link after it fails to register a reconfiguration callback.  a=dmeehan\" for causing macOS build failures\n\nThis reverts commit 547386b135dcaa7d39bc022be366cb2df19d3f27.\n", "files": ["gfx/thebes/gfxPlatformMac.cpp"], "git_node": "956eebd2db9d6d5053bf165a9fb02f61327f8f7f", "git_parents": ["3bb00f4e555641d723638ddcaa7dba231391b427"], "node": "655664f1accc7995c07c9fa9fadf281a9fb71016", "parents": ["9898e30663557fa1dc2fecbe1863ba46a8edcfba"], "tags": []}], "date": 1768505108, "git_changesets": ["556413f6c355ea8d7c5711319f0b4d46ab0737f0", "3bb00f4e555641d723638ddcaa7dba231391b427", "956eebd2db9d6d5053bf165a9fb02f61327f8f7f"], "user": "dmeehan@mozilla.com"}, "436": {"changesets": [{"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1972888 Part 1: Remove nsCocoaWindow::mClosedRetainedWindow.  a=dmeehan DONTBUILD\n\nThe macOS window manager seems to hold onto the native window until it\nis released, even after it is closed. Leaving it retained creates side\neffects with window cycling, and with \"ghost windows\" which might\ncapture mouse events or be displayed in Mission Control.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272526\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278724\n", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "94e7fc86b1bed73b99406ced2af3e0332c8b7edd", "git_parents": ["956eebd2db9d6d5053bf165a9fb02f61327f8f7f"], "node": "394c3df557f0fb0ec2ae3b41e3a8f8de38dee14c", "parents": ["655664f1accc7995c07c9fa9fadf281a9fb71016"], "tags": []}, {"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1972888 Part 2: Ensure that nsCocoaWindow::mWindow is never returned as an unretained reference.  a=dmeehan DONTBUILD\n\nThis will hopefully fix the original issue of Bug 1880582, where the\nnative window was being manipulated without it having been retained.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272527\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278725\n", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "9aa567ba244b0afd8c9accfcd0e04d6c41c5e21e", "git_parents": ["94e7fc86b1bed73b99406ced2af3e0332c8b7edd"], "node": "8df14bb259e5aeebc34848a418b0f8e8a47c8138", "parents": ["394c3df557f0fb0ec2ae3b41e3a8f8de38dee14c"], "tags": []}, {"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1972888 Part 3: Maintain the retain count of the nsCocoaWindow native window during runloops.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272538\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278726\n", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "5344c5d05850b17d9c6c6e0ae2fc43aa594881e6", "git_parents": ["9aa567ba244b0afd8c9accfcd0e04d6c41c5e21e"], "node": "cfcedd3e848dba0a0608bc9846121ee6df70cfd4", "parents": ["8df14bb259e5aeebc34848a418b0f8e8a47c8138"], "tags": []}], "date": 1768584259, "git_changesets": ["94e7fc86b1bed73b99406ced2af3e0332c8b7edd", "9aa567ba244b0afd8c9accfcd0e04d6c41c5e21e", "5344c5d05850b17d9c6c6e0ae2fc43aa594881e6"], "user": "dmeehan@mozilla.com"}, "437": {"changesets": [{"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1985140: Prevent OSXVsyncSource from creating a display link after it fails to register a reconfiguration callback.  a=dmeehan\n\nThis also changes NS_WARNING to gfxWarning(), in the hope of making serious vysnc failures more\nvisible.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D262819\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279219\n", "files": ["gfx/thebes/gfxPlatformMac.cpp"], "git_node": "15a8203c296f1efa2d34273b1b9a3ea878a61f85", "git_parents": ["5344c5d05850b17d9c6c6e0ae2fc43aa594881e6"], "node": "3ebab11b1cc9cf205c3794ca01c3c3d092e11bdc", "parents": ["cfcedd3e848dba0a0608bc9846121ee6df70cfd4"], "tags": []}, {"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1985140 Part 2: Make OSXVsyncSource safely retry vsync within display reconfiguration callback.  a=dmeehan\n\nThis changes a few things:\n1) CreateDisplayLink loses its ability to reschedule itself. This is\nbecause the rescheduling is only useful within the display\nreconfiguration callback, and in such a case should be followed by a\ncall to EnableVsync.\n2) A new retry callback CreateDisplayLinkAndEnableVsync is created to\nhandle the one-time retry within the display reconfiguration callback.\n3) The OSXVsyncSource constructor no longer attempts to recreate the\ndisplay link if CreateDisplayLink fails. The only callsite for the\nconstructor will fallback to software vsync in such a case, and the\nrescheduled attempt wasn't preventing that from happening anyway.\n4) There are more gfxWarning messages, with more clarity on exactly\nwhich call has failed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D269119\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279220\n", "files": ["gfx/thebes/gfxPlatformMac.cpp"], "git_node": "bed7b24e991466facb76aa2740c213b49772588b", "git_parents": ["15a8203c296f1efa2d34273b1b9a3ea878a61f85"], "node": "c25663d6f5e8f94c9fa24fca8895ba7d8654325d", "parents": ["3ebab11b1cc9cf205c3794ca01c3c3d092e11bdc"], "tags": []}, {"author": "Brad Werth \u003cwerth@efn.org\u003e", "branch": "default", "desc": "Bug 1985140 Part 3: Make OSXVsyncSource give up when display reconfiguration fails.  a=dmeehan\n\nThis adds a method gfxPlatform::ResetHardwareVsyncSource to allow a\nhardware vsync source to remove itself when needed. The OSXVsyncSource\nnow calls this method when display reconfiguration fails, and the\ntime-delayed retry *also* fails. This allows a software vsync method to\nbe used as a fallback, ensuring that some vsync source is active.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D273131\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279221\n", "files": ["gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "gfx/thebes/gfxPlatformMac.cpp"], "git_node": "8c69555d97c6ca3cf6ba7073ed4541ea0a2bbf05", "git_parents": ["bed7b24e991466facb76aa2740c213b49772588b"], "node": "ed585b68d6744ad9d6658f278efa26f6ac87aa82", "parents": ["c25663d6f5e8f94c9fa24fca8895ba7d8654325d"], "tags": []}], "date": 1768584871, "git_changesets": ["15a8203c296f1efa2d34273b1b9a3ea878a61f85", "bed7b24e991466facb76aa2740c213b49772588b", "8c69555d97c6ca3cf6ba7073ed4541ea0a2bbf05"], "user": "dmeehan@mozilla.com"}, "438": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279505\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "ddf721e1274176d16af2e29e29a5547d20acaebd", "git_parents": ["8c69555d97c6ca3cf6ba7073ed4541ea0a2bbf05"], "node": "c18e7639ea1f5b54180b9990484ed4cd2dc716a4", "parents": ["ed585b68d6744ad9d6658f278efa26f6ac87aa82"], "tags": []}], "date": 1768829402, "git_changesets": ["ddf721e1274176d16af2e29e29a5547d20acaebd"], "user": "dmeehan@mozilla.com"}, "439": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2008912 - (ESR140) New checks for synced contexts  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279771\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContextGroup.cpp", "docshell/base/BrowsingContextGroup.h", "docshell/base/WindowContext.cpp"], "git_node": "ce51bdd0712c5deda21594eccce8c6f326e9bf8a", "git_parents": ["ddf721e1274176d16af2e29e29a5547d20acaebd"], "node": "11e7d7f3bd2780ae4b843b977126b11f42de29ac", "parents": ["c18e7639ea1f5b54180b9990484ed4cd2dc716a4"], "tags": []}], "date": 1769007644, "git_changesets": ["ce51bdd0712c5deda21594eccce8c6f326e9bf8a"], "user": "dmeehan@mozilla.com"}, "440": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2010288 - Update the XML parser's error_verifier method.  a=dmeehan DONTBUILD\n\nThree new enum values have been added since this was last updated.\n\nAlso, add the second test case from bug 1192544.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D279091\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279703\n", "files": ["dom/xml/crashtests/1192544.xhtml", "dom/xml/crashtests/crashtests.list", "parser/htmlparser/nsExpatDriver.cpp"], "git_node": "0e035206eb8e639e223cc4988de92959716cd849", "git_parents": ["ce51bdd0712c5deda21594eccce8c6f326e9bf8a"], "node": "4f008cd35661f3e7f5848f86a0d795960f03094b", "parents": ["11e7d7f3bd2780ae4b843b977126b11f42de29ac"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2010275 - Pass XML_Status and XML_Error across the RLBox barrier as int.  a=dmeehan DONTBUILD\n\nFor functions where we don't use the return value, return void instead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D279192\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279704\n", "files": ["parser/expat/expat/lib/moz_expat.h", "parser/expat/expat/lib/moz_xmlparse.c", "parser/htmlparser/nsExpatDriver.cpp"], "git_node": "416c8b687d9f53ffefbfe9cf3c46ff61e1e318d4", "git_parents": ["0e035206eb8e639e223cc4988de92959716cd849"], "node": "0a625540d569a5d350c35a7490e631a08b3f3040", "parents": ["4f008cd35661f3e7f5848f86a0d795960f03094b"], "tags": []}], "date": 1769007719, "git_changesets": ["0e035206eb8e639e223cc4988de92959716cd849", "416c8b687d9f53ffefbfe9cf3c46ff61e1e318d4"], "user": "dmeehan@mozilla.com"}, "441": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009608 - Don't assign non-live hash table entry r=glandium a=dmeehan\n\nThe problem here is that we use move assignment on a hash table entry that is\nnot live. Although all entries are constructed by HashTable::createTable, they\nmay subsequently be destroyed by HashTableEntry::destroyStoredT(). Therefore it\nis not safe to call any methods on a non live entry.\n\nThis causes a problem for GC barrier wrappers which assume that the object\nstate is valid (and presumably anything that does more than just write the\nassigned data into memory).\n\nThe fix is to construct a new entry in place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278629\n", "files": ["mfbt/HashTable.h"], "git_node": "c0b9bad2e0c40417c5697d220f8de9d76c3e8515", "git_parents": ["416c8b687d9f53ffefbfe9cf3c46ff61e1e318d4"], "node": "548640de7c3f4985b97ee0b51eb7b9a2c45b830f", "parents": ["0a625540d569a5d350c35a7490e631a08b3f3040"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1992109 - Prevent NAC from showing up in CrossShadowBoundaryRange. r=smaug,jjaschke a=dmeehan\n\nSelection in NAC is generally only valid within the same anonymous\nsubtree, since NAC doesn't notify when unbinding. I don't think view\ntransitions are special here, I think you'd be able to hit it with other\nNAC (but we don't have much \"deep\" NAC).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D278163\n", "files": ["dom/base/nsRange.cpp"], "git_node": "3fb2acd07950e3265e82db7735166168480297dc", "git_parents": ["c0b9bad2e0c40417c5697d220f8de9d76c3e8515"], "node": "27f70ab1cb09b6e21907a5153efa418053629ba1", "parents": ["548640de7c3f4985b97ee0b51eb7b9a2c45b830f"], "tags": []}], "date": 1769008198, "git_changesets": ["c0b9bad2e0c40417c5697d220f8de9d76c3e8515", "3fb2acd07950e3265e82db7735166168480297dc"], "user": "dmeehan@mozilla.com"}, "442": {"changesets": [{"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008281, use a test year for some credit card tests, so that they don't fail in the future, r=credential-management-reviewers,dimi a=test-only\n\nOnly tests that are affected by this issue were modified.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277957\n", "files": ["browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/browser/heuristics/third_party/browser.toml", "browser/extensions/formautofill/test/browser/heuristics/third_party/browser_CDW.js", "browser/extensions/formautofill/test/browser/heuristics/third_party/browser_CostCo.js", "browser/extensions/formautofill/test/browser/heuristics/third_party/browser_GlobalDirectAsda.js", "browser/extensions/formautofill/test/browser/heuristics/third_party/browser_Lufthansa.js", "browser/extensions/formautofill/test/browser/heuristics/third_party/browser_Lush.js", "toolkit/components/formautofill/shared/FormAutofillHeuristics.sys.mjs"], "git_node": "e25fd3bf72175e75adf09415066c78623199ece0", "git_parents": ["3fb2acd07950e3265e82db7735166168480297dc"], "node": "5dd01e131e6ab151985c1e5dcf1e27d73e0905c2", "parents": ["27f70ab1cb09b6e21907a5153efa418053629ba1"], "tags": []}], "date": 1769054393, "git_changesets": ["e25fd3bf72175e75adf09415066c78623199ece0"], "user": "rvandermeulen@mozilla.com"}, "443": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998650 - Only favor system DLLs if we can guarantee compatibility.   a=dmeehan DONTBUILD\n\nFor compatibility reasons, we cannot rely on system-wide Visual C++\nruntime DLLs unless they are at least in the version we ship. This patch\nfixes this concern by letting the launcher process decide whether or not\nwe should favor system DLLs based on their version. In case the launcher\nprocess is disabled, the browser process will decide instead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D275822\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279916\n", "files": ["browser/app/winlauncher/LauncherProcessWin.cpp", "browser/app/winlauncher/moz.build", "mozglue/misc/WindowsProcessMitigations.cpp", "mozglue/misc/WindowsProcessMitigations.h", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "3c34b52c3d25362f9c7ec1540b51eca8be0e8a30", "git_parents": ["e25fd3bf72175e75adf09415066c78623199ece0"], "node": "e97018c4e0078e35fec61570eb29e152e577ed18", "parents": ["5dd01e131e6ab151985c1e5dcf1e27d73e0905c2"], "tags": []}], "date": 1769087964, "git_changesets": ["3c34b52c3d25362f9c7ec1540b51eca8be0e8a30"], "user": "dmeehan@mozilla.com"}, "444": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010943: Support reading int64 from int32 stack slot  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D279595\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279914\n", "files": ["js/src/jit/JitFrames.cpp", "js/src/jit/Snapshots.cpp", "js/src/jit/Snapshots.h", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jsapi-tests/testJitRValueAlloc.cpp"], "git_node": "d8ed7cb0b2bc7e0f4ea60025f037fc32b7405515", "git_parents": ["3c34b52c3d25362f9c7ec1540b51eca8be0e8a30"], "node": "52ac22adcf21552c7ddca17a8833ecd929433660", "parents": ["e97018c4e0078e35fec61570eb29e152e577ed18"], "tags": []}], "date": 1769088007, "git_changesets": ["d8ed7cb0b2bc7e0f4ea60025f037fc32b7405515"], "user": "dmeehan@mozilla.com"}, "445": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2008426 - No sniffing for JAR channels  a=dmeehan DONTBUILD\n\nWhen the content type is determined to be UNKNOWN_CONTENT_TYPE\nand the content is coming from a JAR file we shouldn't attempt\nto do content sniffing. JAR files should always have the correct\nfile extension.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D278098\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279874\n", "files": ["uriloader/base/nsURILoader.cpp"], "git_node": "7cb833e4d8e8b4d41e310c7850b60a6c0cbf1454", "git_parents": ["d8ed7cb0b2bc7e0f4ea60025f037fc32b7405515"], "node": "e8edbc9256a59ef29e0d26dcac1312b9c577d01c", "parents": ["52ac22adcf21552c7ddca17a8833ecd929433660"], "tags": []}], "date": 1769088048, "git_changesets": ["7cb833e4d8e8b4d41e310c7850b60a6c0cbf1454"], "user": "dmeehan@mozilla.com"}, "446": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280033\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json"], "git_node": "60a1f1ddc160198c8327b5184f40cd784164abe2", "git_parents": ["7cb833e4d8e8b4d41e310c7850b60a6c0cbf1454"], "node": "7c95f4dfbcfe96bb16f381a06056425abed9d39c", "parents": ["e8edbc9256a59ef29e0d26dcac1312b9c577d01c"], "tags": []}], "date": 1769088445, "git_changesets": ["60a1f1ddc160198c8327b5184f40cd784164abe2"], "user": "dmeehan@mozilla.com"}, "447": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 1998650 - Only favor system DLLs if we can guarantee compatibility.   a=dmeehan\" for causing build failures on ESR140\n\nThis reverts commit 3c34b52c3d25362f9c7ec1540b51eca8be0e8a30.\n", "files": ["browser/app/winlauncher/LauncherProcessWin.cpp", "browser/app/winlauncher/moz.build", "mozglue/misc/WindowsProcessMitigations.cpp", "mozglue/misc/WindowsProcessMitigations.h", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "b0d18c1b2e38c0dc000ebcd96cd5b0618a8c8a35", "git_parents": ["60a1f1ddc160198c8327b5184f40cd784164abe2"], "node": "fb9f09751ee7b394eca3ad86ecdb7554d35522ad", "parents": ["7c95f4dfbcfe96bb16f381a06056425abed9d39c"], "tags": []}], "date": 1769090554, "git_changesets": ["b0d18c1b2e38c0dc000ebcd96cd5b0618a8c8a35"], "user": "dmeehan@mozilla.com"}, "448": {"changesets": [{"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010919 - reject unsupported webauthn mediation requirements.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D279361\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279769\n", "files": ["dom/credentialmanagement/CredentialsContainer.cpp", "dom/webauthn/tests/test_webauthn_get_assertion.html", "dom/webauthn/tests/test_webauthn_make_credential.html", "dom/webidl/CredentialManagement.webidl"], "git_node": "5b8e70db62ea3364fa0c32e39aa31dad59a1dd5c", "git_parents": ["b0d18c1b2e38c0dc000ebcd96cd5b0618a8c8a35"], "node": "87c8c5bb8961f544b176b4ff4e9ad5410fd7d9fb", "parents": ["fb9f09751ee7b394eca3ad86ecdb7554d35522ad"], "tags": []}], "date": 1769197245, "git_changesets": ["5b8e70db62ea3364fa0c32e39aa31dad59a1dd5c"], "user": "dmeehan@mozilla.com"}, "449": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2010933. Do better error checking for AVIFDecoderStream.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279805\n", "files": ["image/decoders/nsAVIFDecoder.cpp"], "git_node": "8b48aacb195e1d2895e07a4a763552c00dc32a62", "git_parents": ["5b8e70db62ea3364fa0c32e39aa31dad59a1dd5c"], "node": "691fa89923cb3af1ce2f4183a5ccebbec8f3b2e8", "parents": ["87c8c5bb8961f544b176b4ff4e9ad5410fd7d9fb"], "tags": []}], "date": 1769197296, "git_changesets": ["8b48aacb195e1d2895e07a4a763552c00dc32a62"], "user": "dmeehan@mozilla.com"}, "450": {"changesets": [{"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2002458 - Disable GDI font table loading in gecko DirectWrite code.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D279669\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280090\n", "files": ["modules/libpref/init/all.js"], "git_node": "f61be30ac0e713846a57b5b188a1c346b9b82980", "git_parents": ["8b48aacb195e1d2895e07a4a763552c00dc32a62"], "node": "90f7fd8187c33f4dd53471ecc1894b7629640da9", "parents": ["691fa89923cb3af1ce2f4183a5ccebbec8f3b2e8"], "tags": []}], "date": 1769197337, "git_changesets": ["f61be30ac0e713846a57b5b188a1c346b9b82980"], "user": "dmeehan@mozilla.com"}, "451": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981883 - Add null check for mBgParent (ESR140),  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280219\n", "files": ["netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "30a21c692f9ebc7679587d02051b0933423c7e26", "git_parents": ["f61be30ac0e713846a57b5b188a1c346b9b82980"], "node": "433b72d11367475fe1d0412548f7c1e3230ebd1f", "parents": ["90f7fd8187c33f4dd53471ecc1894b7629640da9"], "tags": []}], "date": 1769197589, "git_changesets": ["30a21c692f9ebc7679587d02051b0933423c7e26"], "user": "dmeehan@mozilla.com"}, "452": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2011114 - Make `EditorBase` stop dispatching `input` event immediately before or after `compositionend` in domains specified by prefs  a=dmeehan DONTBUILD\n\nWe're intentionally dispatching `input` events before and after\n`compositionend` for the compatibility with the spec and the other\nbrowsers which are based on WebKit (i.e., including Blink) and for\nthe backward compatibility and better behavior for web apps.\n\nThe hacky behavior works in the most web apps. However, we got a bug\nreport in bug 2006599. Therefore, we need to disable either `input`\nevent for specific website.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D279488\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279990\n", "files": ["editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_selectable_input_event_dispatching_for_compositionend.html", "modules/libpref/init/all.js"], "git_node": "48e5408893549f2f03ed676b23351c68e30b5a4a", "git_parents": ["30a21c692f9ebc7679587d02051b0933423c7e26"], "node": "ce1d94f6b18c2c6736529ad30d5cca14f12e1ef3", "parents": ["433b72d11367475fe1d0412548f7c1e3230ebd1f"], "tags": []}], "date": 1769433923, "git_changesets": ["48e5408893549f2f03ed676b23351c68e30b5a4a"], "user": "dmeehan@mozilla.com"}, "453": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998650 - Only favor system DLLs if we can guarantee compatibility.   a=dmeehan\n\nFor compatibility reasons, we cannot rely on system-wide Visual C++\nruntime DLLs unless they are at least in the version we ship. This patch\nfixes this concern by letting the launcher process decide whether or not\nwe should favor system DLLs based on their version. In case the launcher\nprocess is disabled, the browser process will decide instead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D275822\n\nDifferential Revision: https://phabricator.services.mozilla.com/D279916\n", "files": ["browser/app/winlauncher/LauncherProcessWin.cpp", "browser/app/winlauncher/moz.build", "mozglue/misc/WindowsProcessMitigations.cpp", "mozglue/misc/WindowsProcessMitigations.h", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": "f0e210dcef1bd69e85912ff054fdb269a091f932", "git_parents": ["48e5408893549f2f03ed676b23351c68e30b5a4a"], "node": "fc4a6f9bbe1859f45cd7ff6762f8d5aa577205a1", "parents": ["ce1d94f6b18c2c6736529ad30d5cca14f12e1ef3"], "tags": []}], "date": 1769433964, "git_changesets": ["f0e210dcef1bd69e85912ff054fdb269a091f932"], "user": "dmeehan@mozilla.com"}, "454": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280405\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json"], "git_node": "2df23e6aae9786e500a235626997797ab5a79716", "git_parents": ["f0e210dcef1bd69e85912ff054fdb269a091f932"], "node": "effc7f5be53391fbbd5e2fb6706b8dd42b4e1bd0", "parents": ["fc4a6f9bbe1859f45cd7ff6762f8d5aa577205a1"], "tags": []}], "date": 1769434246, "git_changesets": ["2df23e6aae9786e500a235626997797ab5a79716"], "user": "dmeehan@mozilla.com"}, "455": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1984380 - Make the Ubuntu 24.04 docker images more reproducible.  a=RyanVM\n\nWe use the Ubuntu snapshot service to pick the packages that were\navailable the last time we generated those docker images.\n\nThis doesn't address the fact that newer versions of mesa in Ubuntu\n24.04 are having unexpected consequences on webgl tests, which will\nneed to be addressed at some point, but at least now we don't have to\nfigure that out before being able to make other changes to the docker\nimages.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D262757\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280607\n", "files": ["taskcluster/docker/debian-raw/Dockerfile", "taskcluster/docker/recipes/ubuntu2404-test-system-setup-base.sh", "taskcluster/docker/snap-coreXX-build/system-setup.sh", "taskcluster/kinds/docker-image/kind.yml"], "git_node": "14a538fc2e2ed77bd7a7e65193a5564a6663d006", "git_parents": ["2df23e6aae9786e500a235626997797ab5a79716"], "node": "a5e97d9b9b83fc4dac987598a9de9eb2db5162f5", "parents": ["effc7f5be53391fbbd5e2fb6706b8dd42b4e1bd0"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1993001 - update ubuntu library package names for time64 transition.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D267957\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280605\n", "files": ["taskcluster/docker/recipes/ubuntu2404-test-system-setup-base.sh"], "git_node": "058979456f0dab1b05c935bba4a7177830bc9d62", "git_parents": ["14a538fc2e2ed77bd7a7e65193a5564a6663d006"], "node": "6ac70b41f180ecac8188a029289f676ec135f49a", "parents": ["a5e97d9b9b83fc4dac987598a9de9eb2db5162f5"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1993001: allow package downgrade to the ubuntu snapshot version.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D267958\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280606\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "afea047ab7a84b71ea3f1b4e125ac321c6f260fd", "git_parents": ["058979456f0dab1b05c935bba4a7177830bc9d62"], "node": "5579ba636503aad0ce3a5b27b0aedfaa30e9550e", "parents": ["6ac70b41f180ecac8188a029289f676ec135f49a"], "tags": []}], "date": 1769531810, "git_changesets": ["14a538fc2e2ed77bd7a7e65193a5564a6663d006", "058979456f0dab1b05c935bba4a7177830bc9d62", "afea047ab7a84b71ea3f1b4e125ac321c6f260fd"], "user": "rvandermeulen@mozilla.com"}, "456": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2000261 - remove retry config for funsize-update-generator docker image.  DONTBUILD  a=dmeehan\n\nThis reverts bug 1423058; generic-worker doesn't like negative values in\nonExitStatus, and enough has changed since 2018 that it seems worth\ntrying without it and revisiting if/when we see failures.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272673\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280718\n", "files": ["taskcluster/gecko_taskgraph/transforms/docker_image.py"], "git_node": "6f5d6e17ec8eda301589313c411b802301da908b", "git_parents": ["afea047ab7a84b71ea3f1b4e125ac321c6f260fd"], "node": "d1d1720368cc0a43b5c8f0f72535aad8cd8ff6af", "parents": ["5579ba636503aad0ce3a5b27b0aedfaa30e9550e"], "tags": []}], "date": 1769607897, "git_changesets": ["6f5d6e17ec8eda301589313c411b802301da908b"], "user": "dmeehan@mozilla.com"}, "457": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012869 - use image_builder:5.1.0 to build image_builder  a=dmeehan\n\nkaniko on image_builder:5.0.0 is too old and fails to detect docker when\nrunning on a newer host.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280716\n", "files": ["taskcluster/gecko_taskgraph/transforms/docker_image.py"], "git_node": "9832d9c1e8abedd4bc5d30842a748336216ef676", "git_parents": ["6f5d6e17ec8eda301589313c411b802301da908b"], "node": "0d14276a4b8f62bad7380b434057cd3ab78acca6", "parents": ["d1d1720368cc0a43b5c8f0f72535aad8cd8ff6af"], "tags": []}], "date": 1769608353, "git_changesets": ["9832d9c1e8abedd4bc5d30842a748336216ef676"], "user": "dmeehan@mozilla.com"}, "458": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2002725 - Fix malformed-payload error caused by non-string values. a=release DONTBUILD\n", "files": ["taskcluster/gecko_taskgraph/morph.py", "taskcluster/gecko_taskgraph/test/test_morph.py"], "git_node": "ae3187dbfcf9b78577d