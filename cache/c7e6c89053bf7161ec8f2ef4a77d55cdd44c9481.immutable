"pushes": {"508": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 8e875e7de75c05112284e9f6e91927b7bbe36e79 with FIREFOX_128_10_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "9b1b65094cc4269202d4f5af2e200418e7edb1b5", "parents": ["8e875e7de75c05112284e9f6e91927b7bbe36e79"], "tags": []}], "date": 1745263139, "git_changesets": [null], "user": "ffxbld"}, "509": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "1d782062140bcbb183423c663beefadf0f78c656", "parents": ["9b1b65094cc4269202d4f5af2e200418e7edb1b5"], "tags": []}], "date": 1745847974, "git_changesets": [null], "user": "ffxbld-merge"}, "510": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 8e875e7de75c05112284e9f6e91927b7bbe36e79 with FIREFOX_128_10_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "7b2a3839f127f914f4757b1ba3d96ca707024d15", "parents": ["1d782062140bcbb183423c663beefadf0f78c656"], "tags": []}], "date": 1745930981, "git_changesets": [null], "user": "ffxbld"}, "511": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246916", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "4194522986c6ab8467328edb5ca448dba9f6f2f1", "parents": ["7b2a3839f127f914f4757b1ba3d96ca707024d15"], "tags": []}], "date": 1745936766, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "512": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962432 - Add an available locales record type for search-config-v2.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246629\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247093", "files": ["toolkit/components/search/docs/SearchConfigurationSchema.rst", "toolkit/components/search/schema/search-config-v2-schema.json"], "git_node": null, "git_parents": [null], "node": "7647c28ab63f8577866a23b13e8d0f527e0c2c71", "parents": ["4194522986c6ab8467328edb5ca448dba9f6f2f1"], "tags": []}], "date": 1745937205, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "513": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1958292 - Don't use the observer service for forget skippable cleanup.  a=RyanVM\n\nIt appears that calling UnmarkGrayStrongObservers while inside an observer can\ncause crashes. This will only happen for the forget skippable cleanup, so this\npatch splits out a separate cleanup method, adds a new static variable to hold\na pointer to the marker static instance, and adds a new static method to call\nthe cleanup method on the static instance.\n\nThere are no other uses of cycle-collector-forget-skippable so I get rid of it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246437\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246750", "files": ["dom/base/nsCCUncollectableMarker.cpp", "dom/base/nsCCUncollectableMarker.h", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": null, "git_parents": [null], "node": "05d38c2b9388315a49b6c1041785fded13984369", "parents": ["7647c28ab63f8577866a23b13e8d0f527e0c2c71"], "tags": []}], "date": 1745943920, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "514": {"changesets": [{"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1924108 [Linux] Delete nsWindow from mShell::destroy signal for esr128 r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246182", "files": ["widget/gtk/nsDragService.cpp", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "132f595d259b86b5ad486b9abe848a7ab7a52e72", "parents": ["05d38c2b9388315a49b6c1041785fded13984369"], "tags": []}], "date": 1745955771, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "515": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1960745 - Part 1: Do not perform side-effectful operations while converting muted errors into error reports.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246071\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246536", "files": ["js/src/jsexn.cpp"], "git_node": null, "git_parents": [null], "node": "fe8425305133415f9b0587be673171e124da7558", "parents": ["132f595d259b86b5ad486b9abe848a7ab7a52e72"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1960745 - Part 2: Add Debugger.Object.isMutedError.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246072\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246537", "files": ["js/src/debugger/Object.cpp", "js/src/debugger/Object.h", "js/src/doc/Debugger/Debugger.Object.md"], "git_node": null, "git_parents": [null], "node": "40cc7892ebcec648ab45fb8eaaa2728a38873f1d", "parents": ["fe8425305133415f9b0587be673171e124da7558"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1960745 - Part 3: Do not perform side-effectful operations while creating preview for muted errors.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246073\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246538", "files": ["devtools/server/actors/object/previewers.js"], "git_node": null, "git_parents": [null], "node": "e4912f29b11bcdf0589f479b4daf8b3dcdd49a52", "parents": ["40cc7892ebcec648ab45fb8eaaa2728a38873f1d"], "tags": []}], "date": 1745970222, "git_changesets": [null, null, null], "user": "rvandermeulen@mozilla.com"}, "516": {"changesets": [{"author": "Zeid \u003czeid@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963595: update .arcconfig to point to new repo r=shtrom a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247290\n", "files": [".arcconfig"], "git_node": "610ff1b8c8be28b192f731015a9eb033324b3985", "git_parents": [null], "node": "a079904d24ac28dfedca7f4abf11f9f8fff603f8", "parents": ["e4912f29b11bcdf0589f479b4daf8b3dcdd49a52"], "tags": []}], "date": 1746027716, "git_changesets": ["610ff1b8c8be28b192f731015a9eb033324b3985"], "user": "zzabaneh@mozilla.com"}, "517": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: rename `release_version_bump` transform to reflect reality  a=RyanVM\n\nThis transform may have been specific to `release_version_bump` at some point, but it's certainly not at this point, so rename it.\n\nIt almost seems silly for it to exist at all, but I was unable to replace it with `task-context`, so this rename will have to do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247392\n", "files": ["taskcluster/gecko_taskgraph/transforms/release_version_bump.py", "taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/kinds/l10n-bump/kind.yml", "taskcluster/kinds/release-early-tagging/kind.yml", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "777f2075245b3973b6e718fa3c1caa97b5362032", "git_parents": ["610ff1b8c8be28b192f731015a9eb033324b3985"], "node": "8703dd26cae35d6932b4dfffb4e10da941a7cf1f", "parents": ["a079904d24ac28dfedca7f4abf11f9f8fff603f8"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: add landoscript worker type and payload builder  a=RyanVM\n\nThe payload builder is created here, but fully stubbed out. Descendent revisions will implement it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247393\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "abd935fc0004a44f0287909270874accfc3855fb", "git_parents": ["777f2075245b3973b6e718fa3c1caa97b5362032"], "node": "2b9ff1be72d7bbfecebffc990060a740ee1143fb", "parents": ["8703dd26cae35d6932b4dfffb4e10da941a7cf1f"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch android-l10n tasks to landoscript  a=RyanVM\n\nAside from the obvious addition of scopes and `lando-repo` the only things of note are:\n* Dropping `ignore-closed-tree` for `import`. Because we always ignore the closed tree in it, the action in landoscript doesn't even support checking it.\n* `from-repo-url` being replaced with `from-branch` in `sync`. In the landoscript world, this is just a branch that we look up the concrete repository for in Lando.\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=android-l10n&revision=2ab614bee5807309146d40188ba8766838205e98\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247394\n", "files": ["taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/android-l10n/kind.yml"], "git_node": "e3ad3396f139716119fdcc1ea1303b635224bc76", "git_parents": ["abd935fc0004a44f0287909270874accfc3855fb"], "node": "cec4aed7350186a59ddba26d017d87fc9b87f34d", "parents": ["2b9ff1be72d7bbfecebffc990060a740ee1143fb"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch l10n-bump tasks to landoscript  a=RyanVM\n\nAside from the addition of scopes and `lando-repo`, most of the changes to the kind are dropping attributes that do not add to the payload (`bump`, `tags`, `push`, `version-path`). `push` theoretically could have been supported, but I don't see any need for it seeing as all `landoscript` actions support a `dry_run` mode. (We don't actually ever use it for `l10n-bump`, but it's there if we want to in the future...)\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=l10n-bump&revision=2ab614bee5807309146d40188ba8766838205e98\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247395\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/l10n-bump/kind.yml"], "git_node": "cabc1c4bbc2b7e04208bfc23ede0ff92507511a5", "git_parents": ["e3ad3396f139716119fdcc1ea1303b635224bc76"], "node": "75bf95ad887250cb178c65d7c3c2c960500d4cfb", "parents": ["cec4aed7350186a59ddba26d017d87fc9b87f34d"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch release-early-tagging to landoscript  a=RyanVM\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=early-tagging&revision=83b0a833fe77e0a01510e7178f5b912300541fe4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247396\n", "files": ["taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/release-early-tagging/kind.yml"], "git_node": "885f06c40c711e9bdfad94aac1f4a79356b91da0", "git_parents": ["cabc1c4bbc2b7e04208bfc23ede0ff92507511a5"], "node": "76a312cff298b4ca0d5595140d64132c380175ba", "parents": ["75bf95ad887250cb178c65d7c3c2c960500d4cfb"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch release-version-bump to landoscript  a=RyanVM\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=version-bump&revision=83b0a833fe77e0a01510e7178f5b912300541fe4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247397\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "e13954b69b8d4935c62105c21dc4c142ab7c7006", "git_parents": ["885f06c40c711e9bdfad94aac1f4a79356b91da0"], "node": "390bb071e4bc0481ffbf8a1983739aec2d76fd38", "parents": ["76a312cff298b4ca0d5595140d64132c380175ba"], "tags": []}], "date": 1746056788, "git_changesets": ["777f2075245b3973b6e718fa3c1caa97b5362032", "abd935fc0004a44f0287909270874accfc3855fb", "e3ad3396f139716119fdcc1ea1303b635224bc76", "cabc1c4bbc2b7e04208bfc23ede0ff92507511a5", "885f06c40c711e9bdfad94aac1f4a79356b91da0", "e13954b69b8d4935c62105c21dc4c142ab7c7006"], "user": "rvandermeulen@mozilla.com"}, "518": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1960499 - Make `PresShell::HandleEvent` handle event with `AutoWeakFrame` for the given frame r=smaug a=RyanVM\n\nBackport for ESR 128.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D245529\n\nDifferential Revision: https://phabricator.services.mozilla.com/D246826\n", "files": ["layout/base/PresShell.cpp", "layout/base/PresShell.h"], "git_node": "cb72cb43a828464daa459b90d3429599c12c9668", "git_parents": ["e13954b69b8d4935c62105c21dc4c142ab7c7006"], "node": "c67470e530ce575c1742abd31cee5c52cf644ff6", "parents": ["390bb071e4bc0481ffbf8a1983739aec2d76fd38"], "tags": []}], "date": 1746120679, "git_changesets": ["cb72cb43a828464daa459b90d3429599c12c9668"], "user": "rvandermeulen@mozilla.com"}, "519": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1964060: fallback to github when tags can't be found on hg.m.o in update verify config creator r=releng-reviewers,ahal a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247622\n", "files": ["testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": "2a449e8180befa2bed0ff84073b1698fd5749fbc", "git_parents": ["cb72cb43a828464daa459b90d3429599c12c9668"], "node": "bbebaa58a921fddd9e3bd3f035861cc9897167c1", "parents": ["c67470e530ce575c1742abd31cee5c52cf644ff6"], "tags": []}], "date": 1746483305, "git_changesets": ["2a449e8180befa2bed0ff84073b1698fd5749fbc"], "user": "rvandermeulen@mozilla.com"}, "520": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247741\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "8d29a8c9f148a94aa270aa82e535fd3eb7becc1b", "git_parents": ["2a449e8180befa2bed0ff84073b1698fd5749fbc"], "node": "69b303fd23478a1875a74402a1efd0ff9e451cda", "parents": ["bbebaa58a921fddd9e3bd3f035861cc9897167c1"], "tags": []}], "date": 1746548667, "git_changesets": ["8d29a8c9f148a94aa270aa82e535fd3eb7becc1b"], "user": "rvandermeulen@mozilla.com"}, "521": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1958121 - Use exchange to update the SpaceFeatures flags.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D245913\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247887\n", "files": ["gfx/thebes/gfxFont.cpp"], "git_node": "adcf2c640fe6245dd0e045c3d9212aab2a5a52b0", "git_parents": ["8d29a8c9f148a94aa270aa82e535fd3eb7becc1b"], "node": "5e9ebb5ba1f150901f586c67b49ee001e3fed207", "parents": ["69b303fd23478a1875a74402a1efd0ff9e451cda"], "tags": []}], "date": 1746548712, "git_changesets": ["adcf2c640fe6245dd0e045c3d9212aab2a5a52b0"], "user": "rvandermeulen@mozilla.com"}, "522": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962757 - For SERP telemetry, allow fields within cookies to be in any part of the field.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D246956\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248077\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/unit/test_urlTelemetry_generic.js"], "git_node": "ed23f258ad271aba1ba41ded4064c612d2026b59", "git_parents": ["adcf2c640fe6245dd0e045c3d9212aab2a5a52b0"], "node": "323f5b3458f9dd66650f10a0a820884744f90ae6", "parents": ["5e9ebb5ba1f150901f586c67b49ee001e3fed207"], "tags": []}], "date": 1746564993, "git_changesets": ["ed23f258ad271aba1ba41ded4064c612d2026b59"], "user": "rvandermeulen@mozilla.com"}, "523": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248402\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-icons.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "f981d8b7dd99e21d64c1a9176bb50421f27d92f8", "git_parents": ["ed23f258ad271aba1ba41ded4064c612d2026b59"], "node": "a02e7e2834cdef71d440262d1e9c0a328ec43246", "parents": ["323f5b3458f9dd66650f10a0a820884744f90ae6"], "tags": []}], "date": 1746705669, "git_changesets": ["f981d8b7dd99e21d64c1a9176bb50421f27d92f8"], "user": "dmeehan@mozilla.com"}, "524": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: switch merge-automation tasks to landoscript  a=dmeehan DONTBUILD\n\nSimilar to when other tasks were switched to landoscript, most of the changes to the kind (and some of the other files) are just dropping now-pointless attributes like `ssh-user-alias`.\n\nThere's two primary things of note here:\n* The change to the `bump-esr128` merge config to ensure the `esr` suffix is included in the display version. This fixes a bug that was present even in treescript.\n* The new logic in the payload builder to add the correct scopes. This should work for all `landoscript` tasks, and I will be removing the scopes in the other kinds in a descendent revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248296\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/actions/merge_automation.py", "taskcluster/gecko_taskgraph/config.py", "taskcluster/gecko_taskgraph/transforms/merge_automation.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/merge-automation/kind.yml"], "git_node": "5c21d517a719fa48191824852d153c97f802417c", "git_parents": ["f981d8b7dd99e21d64c1a9176bb50421f27d92f8"], "node": "7a56754c7f0a77b11770ec19bf3417cd5ee0e98f", "parents": ["a02e7e2834cdef71d440262d1e9c0a328ec43246"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: use correct `to-branch` in merge-automation on try  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248297\n", "files": ["taskcluster/kinds/merge-automation/kind.yml"], "git_node": "f60928ab0b6bb96821d7a85f14ef042978e5d18c", "git_parents": ["5c21d517a719fa48191824852d153c97f802417c"], "node": "4fc12920aed0cce80ed06b3f84ab033394aa5041", "parents": ["7a56754c7f0a77b11770ec19bf3417cd5ee0e98f"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: drop unnecessary scopes from landoscript tasks  a=dmeehan DONTBUILD\n\nAn earlier revision in this stack will automatically add them in the payload builder\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248298\n", "files": ["taskcluster/kinds/android-l10n/kind.yml", "taskcluster/kinds/l10n-bump/kind.yml", "taskcluster/kinds/release-early-tagging/kind.yml", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "a1aaa5af7f5092ac224620eb55c8ce15f5dbda8f", "git_parents": ["f60928ab0b6bb96821d7a85f14ef042978e5d18c"], "node": "6fa731f130800cfc8f4d2aa303d7d734c791b1e4", "parents": ["4fc12920aed0cce80ed06b3f84ab033394aa5041"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948315: change non-merge-automation landoscript tasks to use correct lando repo on try  a=dmeehan DONTBUILD\n\nThis is not technically related to the bug at hand, but the clean up may as well get done here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248299\n", "files": ["taskcluster/kinds/android-l10n/kind.yml", "taskcluster/kinds/l10n-bump/kind.yml", "taskcluster/kinds/release-early-tagging/kind.yml", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "13e4ed57ba4bbfa4c26f320c637b741e38056964", "git_parents": ["a1aaa5af7f5092ac224620eb55c8ce15f5dbda8f"], "node": "fee4aa6268cc1af4841d38cc30eff870213243c2", "parents": ["6fa731f130800cfc8f4d2aa303d7d734c791b1e4"], "tags": []}], "date": 1746887651, "git_changesets": ["5c21d517a719f