la.com/D246752\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249599\n", "files": ["js/src/jit-test/tests/wasm/gc/bug-1962634.js", "js/src/wasm/WasmBinary.h"], "git_node": "25e452aa570e62cc0e40993c735d0767048b81b9", "git_parents": ["90ee8fcd23ce520957dc168d1210bb6081f6f2f2"], "node": "36241c7e1b64d06d833b830ec8bf4edb9311c433", "parents": ["a017238be1bae0007e1251a6fa3b497291b0c877"], "tags": []}], "date": 1747353534, "git_changesets": ["25e452aa570e62cc0e40993c735d0767048b81b9"], "user": "rvandermeulen@mozilla.com"}, "537": {"changesets": [{"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1954281: Check that widget still exists when setting icons r=win-reviewers,gstoll a=RyanVM\n\nGetMainWidget can return null.  We don't return an error in that event, since\ncallers are not expecting this to throw a JS exception and clients wouldn't do\nanything in that case anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249002\n", "files": ["widget/windows/WindowsUIUtils.cpp"], "git_node": "93dc0dd7699cabf4230c3d79ec23269976305c92", "git_parents": ["25e452aa570e62cc0e40993c735d0767048b81b9"], "node": "66255625393e29849cd95f4510b5aa94a11aea72", "parents": ["36241c7e1b64d06d833b830ec8bf4edb9311c433"], "tags": []}], "date": 1747354631, "git_changesets": ["93dc0dd7699cabf4230c3d79ec23269976305c92"], "user": "rvandermeulen@mozilla.com"}, "538": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "No bug - Bump version to 128.10.1 a=me\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "ed5eb4c8b09c2a113962f27a8db797e1783d1544", "git_parents": [null], "node": "06ff7536ad64c6beefef1a4c06f26904ff957333", "parents": ["8e875e7de75c05112284e9f6e91927b7bbe36e79"], "tags": []}], "date": 1747401022, "git_changesets": ["ed5eb4c8b09c2a113962f27a8db797e1783d1544"], "user": "dsmith@mozilla.com"}, "539": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1966612 - Fix promise combinator function state.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D249782\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249828\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "7e00b032f1274265abe76c7783f903a6096aa638", "git_parents": ["93dc0dd7699cabf4230c3d79ec23269976305c92"], "node": "b5a272e9b063f29b1e599b8a3ca0c394b0437957", "parents": ["66255625393e29849cd95f4510b5aa94a11aea72"], "tags": []}], "date": 1747417200, "git_changesets": ["7e00b032f1274265abe76c7783f903a6096aa638"], "user": "rvandermeulen@mozilla.com"}, "540": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: rename `release_version_bump` transform to reflect reality  a=dsmith\n\nThis transform may have been specific to `release_version_bump` at some point, but it's certainly not at this point, so rename it.\n\nIt almost seems silly for it to exist at all, but I was unable to replace it with `task-context`, so this rename will have to do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247392\n", "files": ["taskcluster/gecko_taskgraph/transforms/release_version_bump.py", "taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/kinds/l10n-bump/kind.yml", "taskcluster/kinds/release-early-tagging/kind.yml", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "1d7d577967071fb7a9a454ba1059f499e67adaed", "git_parents": ["ed5eb4c8b09c2a113962f27a8db797e1783d1544"], "node": "cf2f1b9e8c2c34aa9e1eb1bb40b3966df86c763a", "parents": ["06ff7536ad64c6beefef1a4c06f26904ff957333"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: add landoscript worker type and payload builder  a=dsmith\n\nThe payload builder is created here, but fully stubbed out. Descendent revisions will implement it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247393\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "eab8de06c32f0db444f0fe2f40870fd2627c5947", "git_parents": ["1d7d577967071fb7a9a454ba1059f499e67adaed"], "node": "e5a380a1b3f1f9a18d4b98af798316197ae31969", "parents": ["cf2f1b9e8c2c34aa9e1eb1bb40b3966df86c763a"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: switch android-l10n tasks to landoscript  a=dsmith\n\nAside from the obvious addition of scopes and `lando-repo` the only things of note are:\n* Dropping `ignore-closed-tree` for `import`. Because we always ignore the closed tree in it, the action in landoscript doesn't even support checking it.\n* `from-repo-url` being replaced with `from-branch` in `sync`. In the landoscript world, this is just a branch that we look up the concrete repository for in Lando.\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=android-l10n&revision=2ab614bee5807309146d40188ba8766838205e98\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247394\n", "files": ["taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/android-l10n/kind.yml"], "git_node": "edda8a847b3e71588fd39b90d886859035552e6f", "git_parents": ["eab8de06c32f0db444f0fe2f40870fd2627c5947"], "node": "57a2c961cb25dae5be5e217573d0fd2ec5e4734d", "parents": ["e5a380a1b3f1f9a18d4b98af798316197ae31969"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: switch l10n-bump tasks to landoscript  a=dsmith\n\nAside from the addition of scopes and `lando-repo`, most of the changes to the kind are dropping attributes that do not add to the payload (`bump`, `tags`, `push`, `version-path`). `push` theoretically could have been supported, but I don't see any need for it seeing as all `landoscript` actions support a `dry_run` mode. (We don't actually ever use it for `l10n-bump`, but it's there if we want to in the future...)\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=l10n-bump&revision=2ab614bee5807309146d40188ba8766838205e98\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247395\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/l10n-bump/kind.yml"], "git_node": "5872022bec883b13a8c5dce46366a388ec1918c4", "git_parents": ["edda8a847b3e71588fd39b90d886859035552e6f"], "node": "c426ca3acef73249a11de130c4e8622f4a96ead0", "parents": ["57a2c961cb25dae5be5e217573d0fd2ec5e4734d"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: switch release-early-tagging to landoscript  a=dsmith\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=early-tagging&revision=83b0a833fe77e0a01510e7178f5b912300541fe4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247396\n", "files": ["taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/release-early-tagging/kind.yml"], "git_node": "1f2801350e91e1aa1bfbebcf89376ca81607a72e", "git_parents": ["5872022bec883b13a8c5dce46366a388ec1918c4"], "node": "060538772c622102f2df351da1d5da48ccdaca20", "parents": ["c426ca3acef73249a11de130c4e8622f4a96ead0"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: switch release-version-bump to landoscript  a=dsmith\n\nTested on try in: https://treeherder.mozilla.org/jobs?repo=try&searchStr=version-bump&revision=83b0a833fe77e0a01510e7178f5b912300541fe4\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247397\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "b0a2d224a9034602445df2b1ae357b392a4227c2", "git_parents": ["1f2801350e91e1aa1bfbebcf89376ca81607a72e"], "node": "2fa5b6e255f96e501a1af359a02fb282e80d5f4c", "parents": ["060538772c622102f2df351da1d5da48ccdaca20"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1964060: fallback to github when tags can't be found on hg.m.o in update verify config creator r=releng-reviewers,ahal a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D247622\n", "files": ["testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": "18c6591654a80376e021758512262b676d5f2423", "git_parents": ["b0a2d224a9034602445df2b1ae357b392a4227c2"], "node": "237633c118d20568fd6619028f7a5949c5ed88d3", "parents": ["2fa5b6e255f96e501a1af359a02fb282e80d5f4c"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: switch merge-automation tasks to landoscript  a=dsmith\n\nSimilar to when other tasks were switched to landoscript, most of the changes to the kind (and some of the other files) are just dropping now-pointless attributes like `ssh-user-alias`.\n\nThere's two primary things of note here:\n* The change to the `bump-esr128` merge config to ensure the `esr` suffix is included in the display version. This fixes a bug that was present even in treescript.\n* The new logic in the payload builder to add the correct scopes. This should work for all `landoscript` tasks, and I will be removing the scopes in the other kinds in a descendent revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248296\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/actions/merge_automation.py", "taskcluster/gecko_taskgraph/config.py", "taskcluster/gecko_taskgraph/transforms/merge_automation.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/merge-automation/kind.yml"], "git_node": "693d82f9358ee50e830abe6572c3fd162fbcb15f", "git_parents": ["18c6591654a80376e021758512262b676d5f2423"], "node": "638d166a420e053807216e8bae3c388e73e2e6cd", "parents": ["237633c118d20568fd6619028f7a5949c5ed88d3"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: use correct `to-branch` in merge-automation on try  a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248297\n", "files": ["taskcluster/kinds/merge-automation/kind.yml"], "git_node": "6ae530cf6a57239a21fa3627933e43a43ba687f2", "git_parents": ["693d82f9358ee50e830abe6572c3fd162fbcb15f"], "node": "4b9a04829b0dbcd0beec8e95710b5c3900a606a7", "parents": ["638d166a420e053807216e8bae3c388e73e2e6cd"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: drop unnecessary scopes from landoscript tasks  a=dsmith\n\nAn earlier revision in this stack will automatically add them in the payload builder\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248298\n", "files": ["taskcluster/kinds/android-l10n/kind.yml", "taskcluster/kinds/l10n-bump/kind.yml", "taskcluster/kinds/release-early-tagging/kind.yml", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "6cc2a70b02e70a525418f3baf9155b88fe143a9e", "git_parents": ["6ae530cf6a57239a21fa3627933e43a43ba687f2"], "node": "541fa9469aa2bba326ec7cd553680e062b1aa343", "parents": ["4b9a04829b0dbcd0beec8e95710b5c3900a606a7"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1948315: change non-merge-automation landoscript tasks to use correct lando repo on try  a=dsmith\n\nThis is not technically related to the bug at hand, but the clean up may as well get done here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D248299\n", "files": ["taskcluster/kinds/android-l10n/kind.yml", "taskcluster/kinds/l10n-bump/kind.yml", "taskcluster/kinds/release-early-tagging/kind.yml", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "72130e3f30e5026cd17f9904fd074b6db100d3d9", "git_parents": ["6cc2a70b02e70a525418f3baf9155b88fe143a9e"], "node": "bf9141eda40a8842ce36c8acdacbe3c8abafd02c", "parents": ["541fa9469aa2bba326ec7cd553680e062b1aa343"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1966612 - Fix promise combinator function state.  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D249782\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249828\n", "files": ["js/src/builtin/Promise.cpp"], "git_node": "1167da8bff38932cf616b540f50bd153b7fd504d", "git_parents": ["72130e3f30e5026cd17f9904fd074b6db100d3d9"], "node": "776b70c0793ce4f79cb0daaff065a67c530180d5", "parents": ["bf9141eda40a8842ce36c8acdacbe3c8abafd02c"], "tags": []}], "date": 1747428129, "git_changesets": ["1d7d577967071fb7a9a454ba1059f499e67adaed", "eab8de06c32f0db444f0fe2f40870fd2627c5947", "edda8a847b3e71588fd39b90d886859035552e6f", "5872022bec883b13a8c5dce46366a388ec1918c4", "1f2801350e91e1aa1bfbebcf89376ca81607a72e", "b0a2d224a9034602445df2b1ae357b392a4227c2", "18c6591654a80376e021758512262b676d5f2423", "693d82f9358ee50e830abe6572c3fd162fbcb15f", "6ae530cf6a57239a21fa3627933e43a43ba687f2", "6cc2a70b02e70a525418f3baf9155b88fe143a9e", "72130e3f30e5026cd17f9904fd074b6db100d3d9", "1167da8bff38932cf616b540f50bd153b7fd504d"], "user": "dsmith@mozilla.com"}, "541": {"changesets": [{"author": "Michael Kaply \u003c345868+mkaply@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1966113 - Allow setEnabled for policy installed extensions.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D247771\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249776\n", "files": ["toolkit/components/extensions/Extension.sys.mjs", "toolkit/components/extensions/parent/ext-management.js", "toolkit/components/extensions/test/xpcshell/test_ext_management_policy.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml", "toolkit/mozapps/extensions/internal/XPIDatabase.sys.mjs"], "git_node": "36ca1ad5d639144278e32bb0b8483f4399f6a95b", "git_parents": ["7e00b032f1274265abe76c7783f903a6096aa638"], "node": "6a906373815932a640467bcd3124a08bd20f93d6", "parents": ["b5a272e9b063f29b1e599b8a3ca0c394b0437957"], "tags": []}], "date": 1747434456, "git_changesets": ["36ca1ad5d639144278e32bb0b8483f4399f6a95b"], "user": "rvandermeulen@mozilla.com"}, "542": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1966614 - Don't support modulo math space in ExtractLinearSum. r=iain, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249878\n", "files": ["js/src/jit/IonAnalysis.cpp"], "git_node": "0a9f1b49e29cffc2781414788da1acdeb0bf54eb", "git_parents": ["36ca1ad5d639144278e32bb0b8483f4399f6a95b"], "node": "b5906e8547beace28219b512be813594b3791767", "parents": ["6a906373815932a640467bcd3124a08bd20f93d6"], "tags": []}], "date": 1747492600, "git_changesets": ["0a9f1b49e29cffc2781414788da1acdeb0bf54eb"], "user": "dsmith@mozilla.com"}, "543": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "FIREFOX_ESR_128_10_X_RELBRANCH", "desc": "Bug 1966614 - Don't support modulo math space in ExtractLinearSum. r=iain, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D249878\n", "files": ["js/src/jit/IonAnalysis.cpp"], "git_node": "0dabb9048df82a39245bbb7d152974d5748cf9e9", "git_parents": ["1167da8bff38932cf616b540f50bd153b7fd50