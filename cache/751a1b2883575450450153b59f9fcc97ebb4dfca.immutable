desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80181", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "bb8e48d86ba0049c95b67fdf45990b186f883517", "parents": ["701d20f4cfb68b411d2565388158ddd925db6940"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1308251 - Relax builtincert requirement if we require signed extensions. r=mossop,dveditz a=RyanVM\n\nThis changes the default for requiring builtin certs for extension install and update if we also\nrequire signed extensions.  For builds that allow unsigned extensions, the default still requires builtin certs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80301", "files": ["toolkit/mozapps/extensions/internal/AddonUpdateChecker.jsm", "toolkit/mozapps/extensions/internal/XPIInstall.jsm"], "git_node": null, "git_parents": [null], "node": "e73dd77bc3b404b7875e0cc3f2728aba89e86dbe", "parents": ["bb8e48d86ba0049c95b67fdf45990b186f883517"], "tags": []}], "date": 1592527113, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "1061": {"changesets": [{"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1308251 - Fix builtin cert testing for addon install and update. r=RyanVM, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D80330", "files": ["toolkit/mozapps/extensions/test/browser/browser_installssl.js", "toolkit/mozapps/extensions/test/browser/browser_updatessl.js"], "git_node": null, "git_parents": [null], "node": "d58f002e6dcf5d629351ad34aa40a1e01c110a34", "parents": ["e73dd77bc3b404b7875e0cc3f2728aba89e86dbe"], "ta