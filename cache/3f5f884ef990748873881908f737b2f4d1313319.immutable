s:47453:"{
"lastpushid": 632,
"pushes": {"464": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging d156a4452c9d41aa78724265e41c26b7ff76941a with FIREFOX_128_8_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "46a13f31e9f9d5b41bdff677323c1cc0e9f77ff9", "parents": ["3aaf665616b3c0f61839d40a02a9f7ae8778b04c"], "tags": []}], "date": 1743083082, "git_changesets": [null], "user": "ffxbld"}, "465": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 3aaf665616b3c0f61839d40a02a9f7ae8778b04c with FIREFOX_128_9_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "318b897128913b46a4d95c849cf19a200580609a", "parents": ["46a13f31e9f9d5b41bdff677323c1cc0e9f77ff9"], "tags": []}], "date": 1743086726, "git_changesets": [null], "user": "ffxbld"}, "466": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "a1bde13e9b3d9b5f631d0e679e393628efa0658f", "parents": ["318b897128913b46a4d95c849cf19a200580609a"], "tags": []}], "date": 1743425672, "git_changesets": [null], "user": "ffxbld-merge"}, "467": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921474 - send matrix notifications for merge-automation tasks. r=taskgraph-reviewers,releng-reviewers,ahal a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224141", "files": ["taskcluster/gecko_taskgraph/transforms/merge_automation.py", "taskcluster/kinds/merge-automation/kind.yml"], "git_node": null, "git_parents": [null], "node": "4a2560b106268452e128760cd40fa8bd9169716c", "parents": ["a1bde13e9b3d9b5f631d0e679e393628efa0658f"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1933469 - fix notification target for merge-automation prod tasks. r=releng-reviewers,taskgraph-reviewers,bhearsum a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230268", "files": ["taskcluster/gecko_taskgraph/transforms/merge_automation.py"], "git_node": null, "git_parents": [null], "node": "65ff610f9aa27843c19a80b5cde0ea08d8a56266", "parents": ["4a2560b106268452e128760cd40fa8bd9169716c"], "tags": []}], "date": 1743494574, "git_changesets": [null, null], "user": "jcristau@mozilla.com"}, "468": {"changesets": [{"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1921813 - Update verify_routes_notification_filters to align with Taskcluster \u003e 37.5.0. r=taskgraph-reviewers,ahal a=release DONTBUILD\n\nPR #3662 introduced `on-defined`, `on-pending` and `on-running`,\nand deprecated `on-any` in favor of `on-transition` or `on-resolved`.\n\n[jcristau: ported fix from https://github.com/taskcluster/taskgraph/pull/500]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224138", "files": ["taskcluster/gecko_taskgraph/util/verify.py"], "git_node": null, "git_parents": [null], "node": "62e47a000d6a7398575a3604dfeb4dd7a4f49b2c", "parents": ["65ff610f9aa27843c19a80b5cde0ea08d8a56266"], "tags": []}], "date": 1743495814, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "469": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 3aaf665616b3c0f61839d40a02a9f7ae8778b04c with FIREFOX_128_9_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "738de8699ae3932e14ded61984386315ce9e5983", "parents": ["62e47a000d6a7398575a3604dfeb4dd7a4f49b2c"], "tags": []}], "date": 1743511602, "git_changesets": [null], "user": "ffxbld"}, "470": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_128_8_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_128_8_X_RELBRANCH. a=release DONTBUILD", "files": [], "git_node": null, "git_parents": [null], "node": "af008876a41c61e3fd67715b6bff1aa7aeb94ded", "parents": ["d156a4452c9d41aa78724265e41c26b7ff76941a"], "tags": []}], "date": 1743523811, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "471": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950616 - In WebVTT use min(width, height) for more sensible font-size for portrait videos.  a=diannaS\n\nThis matches Chromium's behavior.\nSpec issue at https://github.com/w3c/webvtt/issues/529\n\nOriginal Revision: https://phabricator.services.mozilla.com/D239850\n\nDifferential Revision: https://phabricator.services.mozilla.com/D240930", "files": ["dom/media/webvtt/vtt.sys.mjs", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/portrait.tentative.html.ini", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/portrait-ref.tentative.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/portrait.tentative.html"], "git_node": null, "git_parents": [null], "node": "6b277fa5db93d5942f5bffcd549597eaa311c30f", "parents": ["738de8699ae3932e14ded61984386315ce9e5983"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950616 - In WebVTT use font-size 9px on the cue container.  a=diannaS\n\nA larger font-size on the cue container prevents a site properly styling ::cue\npseudo elements to anything smaller than that font-size since the container's\nline-height cannot be overriden. Per the spec issue we propose 0, but 9px is\nsmall enough that sites won't have a need to style cues to something\nsignificantly smaller, while still keeping WPT passing.\n\nThe spec issue is https://github.com/w3c/webvtt/issues/530\n\nOriginal Revision: https://phabricator.services.mozilla.com/D239851\n\nDifferential Revision: https://phabricator.services.mozilla.com/D240931", "files": ["dom/media/webvtt/vtt.sys.mjs", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/fontsize_smaller_than_container.tentative.html.ini", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue/fontsize_smaller_than_container-ref.tentative.html", "testing/web-platform/tests/webvtt/rendering/cues-with-video/processing-model/selectors/cue/fontsize_smaller_than_container.tentative.html"], "git_node": null, "git_parents": [null], "node": "2243df49200e91d6e54fff3574be4c37cac6afbf", "parents": ["6b277fa5db93d5942f5bffcd549597eaa311c30f"], "tags": []}], "date": 1743647772, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "472": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244315", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "5b8f463634093b059e74701cb974e78f96c02f5f", "parents": ["2243df49200e91d6e54fff3574be4c37cac6afbf"], "tags": []}], "date": 1743685519, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "473": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244604", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/password-rules.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "e2144965f6c9c82680e73153333ea1cce6e26e7b", "parents": ["5b8f463634093b059e74701cb974e78f96c02f5f"], "tags": []}], "date": 1744041654, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "474": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1942148 - Remove the talos-pdfs toolchain job from ESR128. r=sparky a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244764", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/test/talos.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/scripts/misc/fetch-talos-pdfs.py", "taskcluster/scripts/misc/run-fetch-talos-pdfs.sh", "testing/perfdocs/generated/raptor.rst", "testing/perfdocs/generated/talos.rst"], "git_node": null, "git_parents": [null], "node": "64e3a7654386ec16cdaa0dd2c1cad2e76abbef0f", "parents": ["e2144965f6c9c82680e73153333ea1cce6e26e7b"], "tags": []}], "date": 1744128816, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "475": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1952465 - Improve GetAttrNameAt API.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D241895\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244339", "files": ["dom/base/AttrArray.cpp", "dom/base/AttrArray.h", "dom/base/Element.h", "dom/base/nsDOMAttributeMap.cpp", "dom/base/nsINode.cpp", "dom/base/nsTreeSanitizer.cpp", "dom/xslt/xpath/txMozillaXPathTreeWalker.cpp"], "git_node": null, "git_parents": [null], "node": "d8034a31653e9efcacdec3aa1ef8994a6fbed6de", "parents": ["64e3a7654386ec16cdaa0dd2c1cad2e76abbef0f"], "tags": []}], "date": 1744129726, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "476": {"changesets": [{"author": "Fatih Kilic \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1952711 - Change PST8PDT to JST because it doesn't have DST.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244593", "files": ["browser/components/resistfingerprinting/test/browser/browser.toml", "browser/components/resistfingerprinting/test/browser/browser_exslt_timezone_load.js"], "git_node": null, "git_parents": [null], "node": "4ca07d6ea52cf6790ee33223386593ee85448047", "parents": ["d8034a31653e9efcacdec3aa1ef8994a6fbed6de"], "tags": []}], "date": 1744143880, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "477": {"changesets": [{"author": "Fatih Kilic \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1944211: Match PointerEvents's implementation for mozPressure.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D242931\n\nDifferential Revision: https://phabricator.services.mozilla.com/D243659", "files": ["dom/events/MouseEvent.cpp", "dom/events/MouseEvent.h"], "git_node": null, "git_parents": [null], "node": "000b05df62ce4f5bf530b706a6c9fca46d0fafbf", "parents": ["4ca07d6ea52cf6790ee33223386593ee85448047"], "tags": []}], "date": 1744146871, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "478": {"changesets": [{"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1894100 [Linux] Addref WaylandBuffer when it's attached to Wayland compositor r=emilio a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D243015", "files": ["widget/gtk/WaylandBuffer.cpp"], "git_node": null, "git_parents": [null], "node": "32d60b7b28236fe5bb73ff8dfe82a52544c0ee1c", "parents": ["000b05df62ce4f5bf530b706a6c9fca46d0fafbf"], "tags": []}], "date": 1744147021, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "479": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946084: detect updater command line arguments by inspecting usage message  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244912", "files": ["tools/update-verify/release/common/check_updates.sh"], "git_node": null, "git_parents": [null], "node": "4abc9e2fa4cecd6eb310100917fe1fed3f967f6b", "parents": ["32d60b7b28236fe5bb73ff8dfe82a52544c0ee1c"], "tags": []}], "date": 1744228191, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "480": {"changesets": [{"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949994 - [devtools] Properly escape the ampersand for Copy as cURL (POSIX) r=devtools-reviewers,ochameau, a=dsmith\n\nThe Copy as CuRL (POSIX) context menu is enabled for Windows, the historical reason was to allow\nWindows users who use other tools (like Cygwin etc) instead of the Win command prompt.\n\nThis patch escapes the ampersand which stops a generating a malicous curl command which can be run\non Windows CMD Prompt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242674", "files": ["devtools/client/netmonitor/test/browser_net_curl-utils.js", "devtools/client/shared/curl.js"], "git_node": null, "git_parents": [null], "node": "74c3306f6d4837fcf2328dee8a893ccb73d189e0", "parents": ["4abc9e2fa4cecd6eb310100917fe1fed3f967f6b"], "tags": []}, {"author": "Calixte \u003ccdenizet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1935076 - Add a pure js fallback for the openjpeg decoder when either WASM or SIMD are unavailable in ESR128, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D243478", "files": ["toolkit/components/pdfjs/content/build/pdf.worker.mjs"], "git_node": null, "git_parents": [null], "node": "426e719d4aa808b4ddb4f920e9cd2c616ac6a0bf", "parents": ["74c3306f6d4837fcf2328dee8a893ccb73d189e0"], "tags": []}], "date": 1744232153, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "481": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1953525 - Disable the XSLT document() function when called through the XSLTProcessor DOM API.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D241227\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244520", "files": ["dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "testing/web-platform/tests/dom/xslt/document-function.window.js"], "git_node": null, "git_parents": [null], "node": "c3665e01af3ef752c3c41f51252672e829c35498", "parents": ["426e719d4aa808b4ddb4f920e9cd2c616ac6a0bf"], "tags": []}], "date": 1744233527, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "482": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1959683: purge search-config-icons after running remote settings update r=Standard8,jcristau, a=dsmith\n\nThis will avoid `arc diff` hanging if untracked files are around. I've taken this approach rather than using `arc diff --allow-untracked` to avoid accidentally missing newly added files from other periodic updates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D245078", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "3659e2b568b510c9af3238509aad30a367fbc87e", "parents": ["c3665e01af3ef752c3c41f51252672e829c35498"], "tags": []}], "date": 1744308984, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "483": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "No bug - Make the perfdocs linter happy. r=me a=NPOTB DONTBUILD", "files": ["testing/perfdocs/generated/raptor.rst", "testing/perfdocs/generated/talos.rst"], "git_node": null, "git_parents": [null], "node": "65cf68c8ddd9a7d29bb3333d7ecc5855d4fbc894", "parents": ["3659e2b568b510c9af3238509aad30a367fbc87e"], "tags": []}], "date": 1744310048, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "484": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1959877: periodic file updates: run `hg purge` in the correct directory r=Eijebong a=diannaS\n\nOn esr128 we don't have `TOPSRCDIR`; we can use `REPODIR` instead.\n\nWe also don't have git support, so we can tear out the `USE_GIT` block.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D245242", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "cb6feb942eb181b7cdd793c210b6b8d3bc0b1754", "parents": ["65cf68c8ddd9a7d29bb3333d7ecc5855d4fbc894"], "tags": []}], "date": 1744381203, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "485": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1942364: switch signing to autograph gcp production  a=diannaS\n\nNote that this also moves us to a new Authenticode certificate out of necessity (see https://bugzilla.mozilla.org/show_bug.cgi?id=1942344)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244625", "files": ["taskcluster/android_taskgraph/transforms/signing.py", "taskcluster/gecko_taskgraph/transforms/geckodriver_signing.py", "taskcluster/gecko_taskgraph/transforms/mar_signing.py", "taskcluster/gecko_taskgraph/transforms/openh264_signing.py", "taskcluster/gecko_taskgraph/transforms/release_generate_checksums_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing_partner.py", "taskcluster/gecko_taskgraph/transforms/source_checksums_signing.py", "taskcluster/gecko_taskgraph/util/signed_artifacts.py", "taskcluster/kinds/signing-apk/kind.yml", "taskcluster/kinds/signing-bundle/kind.yml"], "git_node": null, "git_parents": [null], "node": "827919507b0f7e16c489baf97b82882f3a338485", "parents": ["cb6feb942eb181b7cdd793c210b6b8d3bc0b1754"], "tags": []}], "date": 1744390809, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "486": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1959877: periodic file updates: purge search-config-icons after they are recopied r=releng-reviewers,ahal a=diannaS\n\nThis is a special patch just for esr128, where the periodic updates script re-copies the remote settings contents from another directory after updating them. Because of them, we need to run `hg purge` to fix https://bugzilla.mozilla.org/show_bug.cgi?id=1959683 after that happens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D245307", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "cb5e1c706b55684072d8379dd1f9d786f1ecda6f", "parents": ["827919507b0f7e16c489baf97b82882f3a338485"], "tags": []}], "date": 1744404137, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "487": {"changesets": [{"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1917536 - Check for Admin and LocalSystem permissions in updater instead of inferring them from a lockfile. r=bytesized a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223223\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242447", "files": ["toolkit/mozapps/update/updater/updater-common.build", "toolkit/mozapps/update/updater/updater.cpp", "toolkit/xre/WinTokenUtils.cpp", "toolkit/xre/WinTokenUtils.h"], "git_node": null, "git_parents": [null], "node": "cf51dae8d242cab583a0501d33919a8094176159", "parents": ["cb5e1c706b55684072d8379dd1f9d786f1ecda6f"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Keep track of argument indices with variables r=bytesized a=diannaS\n\nWe need to add an argument to this executable, but it is made more difficult than it needs to be by the fact that we refer to arguments by number all over this code. Which, to be honest, also just makes the code harder to understand than necessary. This patch simply swaps out raw index values for variables in order to make this easier to understand.\n\nThere should only be one actual functionality change in this patch. [This](https://searchfox.org/mozilla-central/rev/080df48f04783f4dcdba83de687989ae33924f40/toolkit/mozapps/update/updater/updater.cpp#4123) particular invocation of `LaunchCallbackApp` inexplicably passes the path to the callback binary as the first argument instead of the path to the callback's working directory. Presumably this is a bug.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225420\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242448", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "0c57a047bf22d6b51661916a61a30be3b03d95a2", "parents": ["cf51dae8d242cab583a0501d33919a8094176159"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Add an argument to the updater to convey which updater instance it is r=bytesized a=diannaS\n\nNote that this patch does not implement the proper usage of the argument. It reads the argument but then does nothing with it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225421\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242449", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/updater/updater.cpp", "toolkit/xre/nsUpdateDriver.cpp"], "git_node": null, "git_parents": [null], "node": "7fc4ca2e979de8d0fbf4d20654c3927ea90a6573", "parents": ["0c57a047bf22d6b51661916a61a30be3b03d95a2"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Add MMS support for new updater args r=bytesized a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242450", "files": ["toolkit/components/maintenanceservice/moz.build", "toolkit/components/maintenanceservice/workmonitor.cpp"], "git_node": null, "git_parents": [null], "node": "8eec7c9bac05b4125e57e0074ff8dc79a8619b83", "parents": ["7fc4ca2e979de8d0fbf4d20654c3927ea90a6573"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Use argument value to determine which updater instance is running rather than elevation r=bytesized a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225422\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242451", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "e4b27a1ee73315ee0cf8b42864c77a3c05b19814", "parents": ["8eec7c9bac05b4125e57e0074ff8dc79a8619b83"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Fix \"force service fallback\" update test feature r=bytesized a=diannaS\n\nThis patch basically reimplements [this](https://searchfox.org/mozilla-central/rev/754074e05178e017ef6c3d8e30428ffa8f1b794d/toolkit/mozapps/update/updater/updater.cpp#3849-3859) functionality (removed in Bug 1917536), but using the mechanism introduced by Bug 1923376 to convey which invocation the updater should run as.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225743\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242452", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "9bf15fee3367fa1294c332edde16501a684cba72", "parents": ["e4b27a1ee73315ee0cf8b42864c77a3c05b19814"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937806 - Pass the second updater invocation args to the macOS elevated updater r=bytesized a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D236302\n\nDifferential Revision: https://phabricator.services.mozilla.com/D243230", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "1ef4faa40982d2db634669f7fba93ff0d50fa4ae", "parents": ["9bf15fee3367fa1294c332edde16501a684cba72"], "tags": []}], "date": 1744411455, "git_changesets": [null, null, null, null, null, null, null], "user": "dsmith@mozilla.com"}, "488": {"changesets": [{"author": "mcheang \u003cmcheang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1958084 - Remove tests for Amazon JP. r=Standard8, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244262", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_amazon.js"], "git_node": null, "git_parents": [null], "node": "f9f95bf6c7535517050abe3d8c2cd252872d9599", "parents": ["1ef4faa40982d2db634669f7fba93ff0d50fa4ae"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update\n\nDifferential Revision: https://phabricator.services.mozilla.com/D245337", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/d