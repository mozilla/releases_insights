editz\n\nMozReview-Commit-ID: DOb1qYb8Tz4", "files": ["dom/base/nsContentSink.cpp"], "git_node": null, "git_parents": [null], "node": "8fade3eebca24ee99a00ae94619eeecc9e384474", "parents": ["a4869a7f4b815c89687fa1e99ba4493a2cd7b41c"], "tags": []}], "date": 1491526015, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "516": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-368 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "812a5737169843433142a45ade01364387c8c9fb", "parents": ["8fade3eebca24ee99a00ae94619eeecc9e384474"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-368 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "b8ecb766911487a07deb85a7b0001619bdc89c46", "parents": ["812a5737169843433142a45ade01364387c8c9fb"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-368 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "bab269a4fd7acca830aa534b65e9d61b02c8cc47", "parents": ["b8ecb766911487a07deb85a7b0001619bdc89c46"], "tags": []}], "date": 1491579559, "git_changesets": [null, null, null], "user": "ffxbld"}, "517": {"changesets": [{"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1354625 - Use mozilla-unified for upstream for all Firefox builds. r=aki, a=NPOTB\n\nWithout the use of an upstream the first repo cloned on a machine will\nbe cached. If a subsequent job references a different repo, it may have\nto pull thousands of changesets because those changesets aren't part of\nthe initially-cloned repo. This is why the --upstream feature to\nrobustclone exists and is why it uses the mozilla-unified repo.\n\nThe mozilla-unified repo is a superset of central, aurora, beta, release,\netc. So by cloning it, you get changesets for all of the repos at the\ntime of the clone. When a subsequent job comes along and requests\na changeset from a different repo, you likely only need to fetch data\nfor a handful of changesets, not thousands.\n\nThis change adds the upstream url config for all fx_desktop_build jobs,\nensuring it is used. A redundant config entry for the try repo has been\nremoved as well.\n\nMozReview-Commit-ID: 3EL7aSXS4AG", "files": ["testing/mozharness/scripts/fx_desktop_build.py"], "git_node": null, "git_parents": [null], "node": "a876affcfc7ad3a4f2aab013e2cb19b0b288bde6", "parents": ["bab269a4fd7acca830aa534b65e9d61b02c8cc47"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1343642 - Ensure to grab nsFrameSelection before calling its methods unless calling only const methods. r=smaug, a=abillings", "files": ["dom/html/HTMLInputElement.cpp", "layout/base/nsPresShell.cpp", "layout/generic/nsSelection.cpp"], "git_node": null, "git_parents": [null], "node": "6172686bf59c0263ef1789d76bd563cc9a53f9a6", "parents": ["a876affcfc7ad3a4f2aab013e2cb19b0b288bde6"], "tags": []}, {"author": "Cervantes Yu \u003ccyu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1349340 - Don't allocate an unrealistically huge buffer in getting the surface data for DnD. r=nical, a=jcristau", "files": ["dom/base/nsContentUtils.cpp"], "git_node": null, "git_parents": [null], "node": "260b50fb6d39c8e958bf36dd99f03df6b566d27c", "parents": ["6172686bf59c0263ef1789d76bd563cc9a53f9a6"], "tags": []}], "date": 1491599347, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "518": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", 