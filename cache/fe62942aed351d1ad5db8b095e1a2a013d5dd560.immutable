dbf538b402bc0f0ba70c257c666994b4"], "tags": []}], "date": 1449574707, "git_changesets": [null], "user": "cbook@mozilla.com"}, "222": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1222809 - Don't try to allocate unreasonably large textures. r=Bas, a=sylvestre", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/layers/ImageDataSerializer.cpp", "gfx/layers/YCbCrImageDataSerializer.cpp", "gfx/layers/client/TextureClient.cpp", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPrefs.h"], "git_node": null, "git_parents": [null], "node": "0b8bf3bc0291cccb3d1faf827d65847a3fa146ff", "parents": ["008197b642e5b178023fd2145c907809b90fbc3d"], "tags": []}], "date": 1449583454, "git_changesets": [null], "user": "cbook@mozilla.com"}, "223": {"changesets": [{"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1206211 - P1. Ensure operation can't overflow. r=kentuckyfriedtakahe, a=sylvestre", "files": ["media/libstagefright/frameworks/av/media/libstagefright/MPEG4Extractor.cpp"], "git_node": null, "git_parents": [null], "node": "f710e2e351b9de3913077ee4c1e722fc6c00ef97", "parents": ["0b8bf3bc0291cccb3d1faf827d65847a3fa146ff"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1206211 - P2. Abort on OOM. r=kentuckyfriedtakahe, a=sylvestre", "files": ["media/libstagefright/frameworks/av/media/libstagefright/MPEG4Extractor.cpp"], "git_node": null, "git_parents": [null], "node": "75343b2f90f41a0ab549d8a44b757b505b9674c3", "parents": ["f710e2e351b9de3913077ee4c1e722fc6c00ef97"], "tags": []}], "date": 1449651335, "git_changesets": [null, null], "user": "cbook@mozilla.com"}, "224": {"changesets": [{"author": "Gerald Squelart \u003cgsquelart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1216748 - p2. Handle failed malloc in Metadata storage - r=rillian, a=sylvestre", "files": ["media/libstagefright/frameworks/av/include/media/stagefright/MetaData.h", "media/libstagefright/frameworks/av/media/libstagefright/MetaData.cpp"], "git_node": null, "git_parents": [null], "node": "b9286af98c12fefe430abee3e819915f892c18c1", "parents": ["75343b2f90f41a0ab549d8a44b757b505b9674c3"], "tags": []}, {"author": "Gerald Squelart \u003cgsquelart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1216748 - p3. Ensure 'covr' data size cannot create underflow - r=rillian, a=sylvestre", "files": ["media/libstagefright/frameworks/av/media/libstagefright/MPEG4Extractor.cpp"], "git_node": null, "git_parents": [null], "node": "212eb2d26bc87f374e0644ee353c1dd1ab11a33c", "parents": ["b9286af98c12fefe430abee3e819915f892c18c1"], "tags": []}, {"author": "Gerald Squelart \u003cgsquelart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1216748 - p4. Check other Metadata::setData uses - r=rillian, a=sylvestre\n\nFound only one other use that needed better checks: the size of the pssh\ndata was only checked after all items were added up; so it would be\npossible to create a set of big items such that they create an overflow,\nbut the final sum looks reasonable.\nInstead each item size should be checked, and the sum should also be\nchecked at each step.", "files": ["media/libstagefright/frameworks/av/media/libstagefright/MPEG4Extractor.cpp"], "git_node": null, "git_parents": [null], "node": "a8d9bd6ebef385539faf0a54aa0a4ea9dbcc4a46", "parents": ["212eb2d26bc87f374e0644ee353c1dd1ab11a33c"], "tags": []}], "date": 1449651655, "git_changesets": [null, null, null], "user": "cbook@mozilla.com"}, "225": {"changesets": [{"author": "Kyle Machulis \u003ckyle@nonpolynomial.com\u003e", "branch": "default", "desc": "Bug 1221448 - fix for Leak instead of crashing on off-main-thread NPAPI _releaseobject. r=bsmedberg, a=sylvestre", "files": ["dom/plugins/base/nsNPAPIPlugin.cpp"], "git_node": null, "git_parents": [null], "node": "b8244a3f55e14381f4387c7c99d7ce9b70bc2427", "parents": ["a8d9bd6ebef385539faf0a54aa0a4ea9dbcc4a46"