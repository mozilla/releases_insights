s:51429:"{
"lastpushid": 1111,
"pushes": {"1000": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D71562", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "28f1e4e9c8a4864db7d918584a2468afca48a4cc", "parents": ["8a69499311707d0f1b65be875217e7aed7dad2ae"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1611482: Prevent the existance of dangling pointers upon failure of FindDataStart. r=spohl,valentin a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D60997", "files": ["modules/libjar/nsZipArchive.cpp"], "git_node": null, "git_parents": [null], "node": "3394cb213d2dc60873c6181b50e66323a8e5e52b", "parents": ["28f1e4e9c8a4864db7d918584a2468afca48a4cc"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1545345 - Improve worker shutdown. r=baku,smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D71503", "files": ["dom/base/nsIGlobalObject.cpp", "dom/base/nsIGlobalObject.h", "dom/bindings/CallbackObject.cpp", "dom/events/DOMEventTargetHelper.cpp", "dom/events/DOMEventTargetHelper.h", "dom/messagechannel/MessagePort.cpp", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerScope.cpp", "dom/workers/WorkerScope.h"], "git_node": null, "git_parents": [null], "node": "45d7ff077528a63ae20590250e116d45581e9e1f", "parents": ["3394cb213d2dc60873c6181b50e66323a8e5e52b"], "tags": []}, {"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1615471 - Escape dollar sign for curl on windows. r=Honza, a=RyanVM\n\nEscape dollar sign for curl on windows,to fix a security issue\nwhere commands such as $(cmd.exe) can be executed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D69776", "files": ["devtools/client/shared/curl.js"], "git_node": null, "git_parents": [null], "node": "29e0f41feada2b66484d700d544503cb61c12f18", "parents": ["45d7ff077528a63ae20590250e116d45581e9e1f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1595886 - Use a temp string in readSegments. r=dragana, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D68204", "files": ["xpcom/io/nsStringStream.cpp"], "git_node": null, "git_parents": [null], "node": "a1f1348c253ce75ba99d4d1ca573b0de8ad9e94a", "parents": ["29e0f41feada2b66484d700d544503cb61c12f18"], "tags": []}], "date": 1587395135, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "1001": {"changesets": [{"author": "Micha\u0142 Sobkiewicz \u003cperceptron8@gmail.com\u003e", "branch": "default", "desc": "Bug 1007344 - Ignore inactive windows when moving alerts. r=MattN a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D66605", "files": ["toolkit/components/alerts/resources/content/alert.js"], "git_node": null, "git_parents": [null], "node": "4fe4bbbd59693f2635418eb879039e758ed65b01", "parents": ["a1f1348c253ce75ba99d4d1ca573b0de8ad9e94a"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1625749 - Make sure SlicedInputStream initializes all its members. r=nika a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D70919", "files": ["xpcom/io/SlicedInputStream.cpp"], "git_node": null, "git_parents": [null], "node": "b0fd38afeff7d0f7ac0e3c7b99ad5256ce3bb449", "parents": ["4fe4bbbd59693f2635418eb879039e758ed65b01"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1625749 - Make sure PartiallySeekableInputStream initializes all its members. r=kershaw a=RyanVM\n\nDepends on D70919\n\nDifferential Revision: https://phabricator.services.mozilla.com/D70926", "files": ["netwerk/base/PartiallySeekableInputStream.cpp"], "git_node": null, "git_parents": [null], "node": "5f9ff1280e366fdc53d2d51856f3362b9d168437", "parents": ["b0fd38afeff7d0f7ac0e3c7b99ad5256ce3bb449"], "tags": []}], "date": 1587414724, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "1002": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1631211 - In configure, pass extra compiler flags after source path. r=dmajor, a=RyanVM\n\nWhen running e.g. check_symbols with extra flags like when checking\nfor vpx_codec_dec_init_ver when building against system libvpx, in some\nconfigurations, the test can fail when the library flags (-l) appear\nbefore the source file path.\n\nThe reason is that in some configurations, the compiler passes\n--as-needed to the linker before both the flags and the object file\npath, and the object file path is in the same position as the source\nfile path was. With --as-needed, -l flags are dropped if the library\nwasn't needed for any of the linked code that appears *before* the flag.\nSo linking with `--as-needed -lfoo foo.o`, is equivalent to linking with\n`foo.o` only in practice, while `--as-needed foo.o -lfoo` is equivalent\nto `foo.o -lfoo`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D71456", "files": ["build/moz.configure/util.configure"], "git_node": null, "git_parents": [null], "node": "50d14d9d06ee4afd20795c56147a8cd0accb8d39", "parents": ["5f9ff1280e366fdc53d2d51856f3362b9d168437"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1623885 - Add \"subsystem\" to Mesa sandbox policy to fix libdrm-2.4.101+. r=gcp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D70579", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": null, "git_parents": [null], "node": "4885fec89bb0f2246ff71b84f96e1028f83893e9", "parents": ["50d14d9d06ee4afd20795c56147a8cd0accb8d39"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1492011 - Fix ConsoleWorkletRunnable thread shutdown incompatibility. r=baku, a=RyanVM\n\nconsolidate StoreProfileData and StoreConsoleData into a single method with arguments parameter r=baku\nstore raw JS arguments on Console separately from ConsoleCallData r=baku\nRemove Console::mCallDataStoragePending r=baku\nRemove now-unused Console::mStatus r=baku\nchange ShouldIncludeStackTrace from instance to class method r=baku\nreplace ArgumentsToValueList instance method with nsTArray::AppendElements() r=baku\nprovide group stack parameter to PopulateConsoleNotificationInTheTargetScope() r=baku\nchange ProcessArguments from instance method to nonmember function with internal linkage r=baku\nchange CreateCounterOrResetCounterValue from instance method to nonmember function with internal linkage r=baku\nchange CreateStartTimerValue and CreateLogOrEndTimerValue from instance to class method r=baku\nprovide ID and Prefix on ConsoleCallData r=baku\nintroduce a separate class to hold main-thread data associated with each Console r=baku\n\nMechanical conflict resolution was required to address conflicts with these changes not on esr68:\nhttps://hg.mozilla.org/mozilla-central/rev/11cda2e9615b\nhttps://hg.mozilla.org/mozilla-central/rev/9919570a9843\nhttps://hg.mozilla.org/mozilla-central/rev/c9c7f800aae6\nhttps://hg.mozilla.org/mozilla-central/diff/30100f2c612832dc74831e4b1b36bec636d5b396/dom/console/Console.cpp\n\nDifferential Revision: https://phabricator.services.mozilla.com/D71686", "files": ["dom/console/Console.cpp", "dom/console/Console.h"], "git_node": null, "git_parents": [null], "node": "e388563552d694596b996433cc90c6f5ab7d8154", "parents": ["4885fec89bb0f2246ff71b84f96e1028f83893e9"], "tags": []}], "date": 1587576402, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "1003": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1626384 - Turn off Fennec Beta builds and tests on ESR68. r=jlorenzo, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D69102", "files": ["taskcluster/ci/build/android.yml", "taskcluster/ci/test/test-platforms.yml"], "git_node": null, "git_parents": [null], "node": "356303da558e707f06eeedb5489962c3b72a5ac1", "parents": ["e388563552d694596b996433cc90c6f5ab7d8154"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1631508 - Fix LEffectiveAddress on ARM64. r=jandem, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D71567", "files": ["js/src/jit/arm64/CodeGenerator-arm64.cpp"], "git_node": null, "git_parents": [null], "node": "4a624d942e373b404f5a583028215762fda0891e", "parents": ["356303da558e707f06eeedb5489962c3b72a5ac1"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 50d14d9d06ee (bug 1631211) for suspicion of causing test_compile_checks.py failures. a=backout", "files": ["build/moz.configure/util.configure"], "git_node": null, "git_parents": [null], "node": "b1b3efd9259dd05908dd4f34b8907d5eb1a18bf6", "parents": ["4a624d942e373b404f5a583028215762fda0891e"], "tags": []}], "date": 1587581429, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "1004": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D72215", "files": ["browser/app/blocklist.xml", "security/mana