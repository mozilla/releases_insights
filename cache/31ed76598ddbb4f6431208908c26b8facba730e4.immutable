Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js", "browser/config/version.txt", "browser/config/version_display.txt", "browser/extensions/webcompat/injections/css/bug1432935-discordapp.com-webkit-scorllbar-white-line.css", "browser/extensions/webcompat/injections/css/bug1518781-twitch.tv-webkit-scrollbar.css", "browser/extensions/webcompat/injections/css/bug1526977-sreedharscce.in-login-fix.css", "browser/extensions/webcompat/injections/css/bug1574973-patch.com-dropdown-menu-fix.css", "browser/extensions/webcompat/injections/css/bug1575011-holiday-weather.com-scrolling-fix.css", "browser/extensions/webcompat/injections/css/bug1575017-dunkindonuts.com-flex-basis.css", "browser/extensions/webcompat/injections/js/bug1577245-salesforce-communities-hide-unsupported.js", "browser/extensions/webcompat/lib/google.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl", "config/milestone.txt", "mobile/android/config/version-files/beta/version.txt", "mobile/android/config/version-files/beta/version_display.txt", "mobile/android/config/version-files/nightly/version.txt", "mobile/android/config/version-files/nightly/version_display.txt", "mobile/android/config/version-files/release/version.txt", "mobile/android/config/version-files/release/version_display.txt", "mobile/android/extensions/webcompat/data/injections.js", "mobile/android/extensions/webcompat/data/ua_overrides.js", "mobile/android/extensions/webcompat/injections/css/bug1526977-sreedharscce.in-login-fix.css", "mobile/android/extensions/webcompat/injections/css/bug1574973-patch.com-dropdown-menu-fix.css", "mobile/android/extensions/webcompat/injections/css/bug1575011-holiday-weather.com-scrolling-fix.css", "mobile/android/extensions/webcompat/manifest.json", "mobile/android/extensions/webcompat/moz.build", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json", "taskcluster/ci/build/android.yml", "taskcluster/ci/test/test-platforms.yml"], "git_node": null, "git_parents": [null, null], "node": "b9129b6a65e220ed423056fbef75de009d0c3b0a", "parents": ["1762e9c5eaa25d1c82dcb955c5d56043d6c82ab0", "c9486eae1bad6ba297f8fddbea203577ae5cbaf0"], "tags": []}, {"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1609451 - Skip ShellExecuteByExplorer to open a uri in Thunderbird. r=froydnj a=mkmlin,wsmwk DONTBUILD\n\n\nWe use `ShellExecuteByExplorer` to open a uri because applications may not\nsupport the mitigation policies inherited from our process.\n\nUnlike Firefox, Thunderbird runs `ShellExecuteByExplorer` to launch a browser\nto open an HTTP/HTTPS uri.  If a uri includes credentials like\nhttp://user:password@domain.com/, `ShellExecuteByExplorer` succceds, but\nexplorer.exe refuses to open the uri by design.  In this case the fallback to\n`ShellExecuteExW` does not happen because the API is async and no error is\nreturned\n\nThe proposed fix is to skip `ShellExecuteByExplorer` if it's Thunderbird.\nBecause Thunderbird does not apply additional mitigation policies which may\ncause compat issues, we don't need to run `ShellExecuteByExplorer` in the\nfirst place.\n\nTo uplift the change to ESR68, this patch includes the patch of Bug 1615370\nas well as the small change not to use `Result::inspect()` which does not\nexist in ESR68.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D72856", "files": ["uriloader/exthandler/win/nsMIMEInfoWin.cpp"], "git_node": null, "git_parents": [null], "node": "de088581d1528bab485eaf443cac763927cd4703", "parents": ["b9129b6a65e220ed423056fbef75de009d0c3b0a"], "tags": []}], "date": 1588145856, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "1010": {"changesets": [{"author": "Ksenia Berezina \u003ckberezina@mozilla.com\u003e", "branch": "default", "desc": "Bug 1633838 - Remove Gmail Microphone intervention. r=miketaylr, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D73066", "files": ["browser/extensions/webcompat/data/injections.js", "browser/extensions/webcompat/injections/js/bug1629926-mail.google.com-hangouts-mic-fix.js", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/moz.build", "mobile/android/extensions/webcompat/data/injections.js", "mobile/android/extensions/webcompat/injections/js/bug1629926-mail.google.com-hangouts-mic-fix.js", "mobile/android/extensions/webcompat/manifest.json", "mobile/android/extensions/webcompat/moz.build"], "git_node": null, "git_parents": [null], "node": "021109e6df5de0564b36f86652ec8c596c06b86f", "parents": ["c9486eae1bad6ba297f8fddbea203577ae5cbaf0"], "tags": []}], "date": 1588174600, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "1011": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1580963 - Cherry-pick some servo changes from a rustc upgrade. a=RyanVM\n\nThis cherry-picks from Servo commit 98e4a53b724.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45738", "files": ["servo/components/style/stylesheets/viewport_rule.rs"], "git_node": null, "git_parents": [null], "node": "9e0c6ecc68659a3cd81f7e17cb6a5e621b607fec", "parents": ["021109e6df5de0564b36f86652ec8c596c06b86f"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1574139: Fix an issue that prevented updates from completing if usernames contained a dot at the end of the username and general hardening of our file path verification. r=mhowell a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D71607", "files": ["toolkit/mozapps/update/common/updatecommon.cpp", "toolkit/mozapps/update/common/updatedefines.h", "toolkit/mozapps/upda