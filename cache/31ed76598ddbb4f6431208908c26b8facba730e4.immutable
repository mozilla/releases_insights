"mobile/android/extensions/webcompat/injections/css/bug1526977-sreedharscce.in-login-fix.css", "mobile/android/extensions/webcompat/injections/css/bug1574973-patch.com-dropdown-menu-fix.css", "mobile/android/extensions/webcompat/injections/css/bug1575011-holiday-weather.com-scrolling-fix.css", "mobile/android/extensions/webcompat/injections/css/bug1631960-websube.ckbogazici.com.tr-table-row-fix.css", "mobile/android/extensions/webcompat/injections/css/bug1632019-everyman.co-gallery-width-fix.css", "mobile/android/extensions/webcompat/injections/js/bug1625224-sixt-neuwagen.de-window-netscape-shim.js", "mobile/android/extensions/webcompat/injections/js/bug1629926-mail.google.com-hangouts-mic-fix.js", "mobile/android/extensions/webcompat/manifest.json", "mobile/android/extensions/webcompat/moz.build"], "git_node": null, "git_parents": [null], "node": "86bb71ceb1817f00260874d6bc2038c4ac43c2a3", "parents": ["93d0094e36fc3a6c9d4008f72184e3cc72545ca8"], "tags": []}, {"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1632241: add SCTP auth token boundary check. r=ng, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D72053", "files": ["netwerk/sctp/src/netinet/sctp_input.c"], "git_node": null, "git_parents": [null], "node": "b43b8e87ef030400e631ffd46a48ec55228a21db", "parents": ["86bb71ceb1817f00260874d6bc2038c4ac43c2a3"], "tags": []}, {"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1632241: turn off SCTP auth and address reconfiguration. r=ng, a=RyanVM\n\nDepends on D72053\n\nDifferential Revision: https://phabricator.services.mozilla.com/D72057", "files": ["netwerk/sctp/datachannel/DataChannel.cpp"], "git_node": null, "git_parents": [null], "node": "3eafea41965b28931766091797cfd4cb2d4e1620", "parents": ["b43b8e87ef030400e631ffd46a48ec55228a21db"], "tags": []}], "date": 1587684399, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "1005": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1623740 - Add policy for setting and locking autoplay default. r=mconley, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "3cf737b05dd9d272bc804fa8cff875a78ac08af0", "parents": ["3eafea41965b28931766091797cfd4cb2d4e1620"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1631211 - In configure, pass extra compiler flags after source path. r=dmajor,rstewart a=RyanVM\n\nWhen running e.g. check_symbols with extra flags like when checking\nfor vpx_codec_dec_init_ver when building against system libvpx, in some\nconfigurations, the test can fail when the library flags (-l) appear\nbefore the source file path.\n\nThe reason is that in some configurations, the compiler passes\n--as-needed to the linker before both the flags and the object file\npath, and the object file path is in the same position as the source\nfile path was. With --as-needed, -l flags are dropped if the library\nwasn't needed for any of the linked code that appears *before* the flag.\nSo linking with `--as-needed -lfoo foo.o`, is equivalent to linking with\n`foo.o` only in practice, while `--as-needed foo.o -lfoo` is equivalent\nto `foo.o -lfoo`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D71456", "files": ["build/moz.configure/util.configure", "python/mozbuild/mozbuild/test/configure/test_compile_checks.py"], "git_node": null, "git_parents": [null], "node": "4e1fce6f6ed641cd2900550fcca94b2fe01a36f5", "parents": ["3cf737b05dd9d272bc804fa8cff875a78ac08af0"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1626382 - r=karlt a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D72281", "files": ["dom/media/webaudio/AudioBuffer.cpp"], "git_node": null, "git_parents": [null], "node": "d787223017e170e3d0431d5c5e6f96e57bbca8fd", "parents": ["4e1fce6f6ed641cd2900550fcca94b2fe01a36f5"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1557282 Part 1: Take chromium commit c1ce57ea5d31208af589b4839390a44ab20b0c8f. r=handyman,gcp a=RyanVM\n\nThis adds AddRestrictingRandomSid feature, which fixes our issues with\nSetLockdownDefaultDacl, apart from when we are running from a network drive.", "files": ["security/sandbox/chromium/sandbox/win/src/acl.cc", "security/sandbox/chromium/sandbox/win/src/restricted_token.cc", "security/sandbox/chromium/sandbox/win/src/restricted_token.h", "security/sandbox/chromium/sandbox/win/src/restricted_token_utils.cc", "security/sandbox/chromium/sandbox/win/src/restricted_token_utils.h", "security/sandbox/chromium/sandbox/win/src/sandbox_policy.h", "security/sandbox/chromium/sandbox/win/src/sandbox_policy_base.cc", "security/sandbox/chromium/sandbox/win/src/sandbox_policy_base.h", "security/sandbox/chromium/sandbox/win/src/sid.cc", "security/sandbox/chromium/sandbox/win/src/sid.h"], "git_node": null, "git_parents": [null], "node": "cbff4fd0c55148efea5405e659af9de7a5d366a2", "parents": ["d787223017e170e3d0431d5c5e6f96e57bbca8fd"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1557282 Part 2: Fix profiler issues when using SetLockdownDefaultDacl. r=dmajor a=RyanVM\n\nWhen we are running from a network drive the new feature in part 1 doesn't work.\nSo this uses DuplicateHandle instead of OpenThread to get the thread handle used\nby the profiler.\nIt also removes a DuplicateHandle THREAD_ALL_ACCESS call that also fails and a\nDuplicateHandle to get a real process handle, which only seems to have been to\nfix something on Windows XP.\nThe handle passed in is always the profiler one, so already has the necessary\npermissions. If no thread handle is passed then the pseudo handle is used.", "files": ["mozglue/misc/StackWalk.cpp", "tools/profiler/core/platform-win32.cpp"], "git_node": null, "git_parents": [null], "node": "f8296d3eee4b280338e7e60e4b3bd2a6d9276c9e", "parents": ["cbff4fd0c55148efea5405e659af9de7a5d366a2"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1557282 Part 3: Use SetLockdownDefaultDacl and AddRestrictingRandomSid in sandbox policies. r=handyman,gcp a=RyanVM", "files": ["browser/app/profile/firefox.js", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp"], "git_node": null, "git_parents": [null], "node": "f18c1874dc6633719e32b8889e905eec9cf657c3", "parents": ["f8296d3eee4b280338e7e60e4b3bd2a6d9276c9e"], "tags": []}], "date": 1587759692, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "1006": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D72678", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "62c7eace446b2cee9e4a91dc3d6ea365863749c0", "parents": ["f18c1874dc6633719e32b8889e905eec9cf657c3"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 1611520 - gcc-10: Include \u003ccstddef\u003e in FunctionTypeTraits.h r=gerald a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D61014", "files": ["mfbt/FunctionTypeTraits.h"], "git_node": null, "git_parents": [nul