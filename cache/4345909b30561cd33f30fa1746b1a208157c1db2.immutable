s:79768:"{
"lastpushid": 632,
"pushes": {"100": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908095 - [devtools] removeSessionDataEntry for webextension toolboxes and watcher targets  a=RyanVM\n\nFix removing breakpoints in webextension toolboxes and watcher targets, add tests to cover both scenarios\nImplementation update to fit 128 ESR\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219752", "files": ["devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_debugger.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakable-lines.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakable-positions.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakpoints.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-source-tree.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-uncompressed/v1/index.html", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-uncompressed/v1/log-worker.js", "devtools/client/debugger/test/mochitest/head.js", "devtools/server/connectors/js-process-actor/DevToolsProcessChild.sys.mjs", "devtools/server/connectors/js-process-actor/target-watchers/worker.sys.mjs"], "git_node": null, "git_parents": [null], "node": "7f2a28b89191249f8ce5e3bf3ab7c32ab4f6833a", "parents": ["9e33cae4ad555212d166e824c50300b8629bea8c"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908095 - [devtools] Regenerate debugger mochitest sourcemap resources  a=RyanVM\n\nDepends on D219752\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219753", "files": ["devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/package.json", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/index.html", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/log-worker.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/react-component-module.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/script.js"], "git_node": null, "git_parents": [null], "node": "abc9b44e67da850ccdf3c0c608856e4e68364fdb", "parents": ["7f2a28b89191249f8ce5e3bf3ab7c32ab4f6833a"], "tags": []}], "date": 1724257922, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "101": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914134 - Do not prime for voice unless Microphone has been requested.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219733\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219844", "files": ["dom/media/MediaManager.cpp"], "git_node": null, "git_parents": [null], "node": "18473970d0ce9fd59f99706acc5a07692270c7cf", "parents": ["abc9b44e67da850ccdf3c0c608856e4e68364fdb"], "tags": []}], "date": 1724333700, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "102": {"changesets": [{"author": "Yazan Al Macki \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1905512 - Modify regex to allow an optional trailing dot at the end of URLs in history removeByFilter function.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216355\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219874", "files": ["toolkit/components/places/History.sys.mjs", "toolkit/components/places/tests/history/test_removeByFilter.js"], "git_node": null, "git_parents": [null], "node": "90de0f4f8b9b1f5fd63bfbde21d62c543d1a80cd", "parents": ["18473970d0ce9fd59f99706acc5a07692270c7cf"], "tags": []}], "date": 1724339800, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "103": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902253 - When the compositing mode is not OVER, we must first render the color glyph to a temporary surface, then composite it with the appropriate operator. r=lsalzman a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215408\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219884", "files": ["gfx/thebes/COLRFonts.cpp", "gfx/thebes/gfxFont.cpp", "layout/reftests/text/reftest.list"], "git_node": null, "git_parents": [null], "node": "08b07c0569c65d1e1fdcb6f86c192bcf41bf412f", "parents": ["90de0f4f8b9b1f5fd63bfbde21d62c543d1a80cd"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902253 - Add a reftest for COLR-glyph compositing modes.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215475\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219885", "files": ["testing/web-platform/tests/html/canvas/element/compositing/colr-glyph-composition-ref.html", "testing/web-platform/tests/html/canvas/element/compositing/colr-glyph-composition.html"], "git_node": null, "git_parents": [null], "node": "674ae6003298fcdf65fceeafbd900b79f76ea6a9", "parents": ["08b07c0569c65d1e1fdcb6f86c192bcf41bf412f"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1912431 - Don't apply global alpha when creating a cached color glyph.  a=RyanVM\n\nThe reftest here currently fails on Android for what appears to be an\nunrelated reason: reftest-analyzer shows that in the *reference* case,\nall but the last line of text is completely missing.\n\nI'm not sure what's failing there (but it fails similarly without this\npatch, anyhow); we should investigate that as a separate bug.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219024\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219886", "files": ["gfx/tests/reftest/1912431-emoji-globalAlpha-ref.html", "gfx/tests/reftest/1912431-emoji-globalAlpha.html", "gfx/tests/reftest/reftest.list", "gfx/thebes/gfxFont.cpp"], "git_node": null, "git_parents": [null], "node": "bc9f4040eb4d587668cfca210ee2ef0de6508441", "parents": ["674ae6003298fcdf65fceeafbd900b79f76ea6a9"], "tags": []}], "date": 1724342845, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "104": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1910665 - Enable trending suggestions for all locales on ESR128. r=daleharvey,bolsson a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219712", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/search.inc.xhtml", "browser/components/preferences/search.js", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/UrlbarProviderSearchSuggestions.sys.mjs", "browser/components/urlbar/content/enUS-searchFeatures.ftl", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "4298182958afcf96c6ba2f16aa46db003e041f84", "parents": ["bc9f4040eb4d587668cfca210ee2ef0de6508441"], "tags": []}], "date": 1724343814, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "105": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219866", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "e969ccdae9a0e5d2d0166113d7d916ff1d161351", "parents": ["4298182958afcf96c6ba2f16aa46db003e041f84"], "tags": []}], "date": 1724344552, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "106": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1909163 - mark select dropdown as tabspecific,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217232\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219917", "files": ["browser/base/content/browser.js", "toolkit/actors/SelectParent.sys.mjs"], "git_node": null, "git_parents": [null], "node": "d223a49f06ef541c0ecaf7a4210363c860c89206", "parents": ["e969ccdae9a0e5d2d0166113d7d916ff1d161351"], "tags": []}], "date": 1724368555, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "107": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1909374 - Register BrowserParent with CPM before calling Bind, r=smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217577", "files": ["dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/ContentParent.cpp"], "git_node": null, "git_parents": [null], "node": "2798da164f0ec198fc89e77610f532ec34716c72", "parents": ["d223a49f06ef541c0ecaf7a4210363c860c89206"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907032 - Don't show the select picker in active tabs. r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216785", "files": ["dom/html/HTMLSelectElement.cpp"], "git_node": null, "git_parents": [null], "node": "f923b729ccbf8d3c939f9e3f9410fb484774ba9d", "parents": ["2798da164f0ec198fc89e77610f532ec34716c72"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1912715: Simplify with-env handling in FetchName r=jandem a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219198", "files": ["js/src/vm/Interpreter-inl.h"], "git_node": null, "git_parents": [null], "node": "4b1cec5599fcac4fa0218c9a2100bd30a820de4f", "parents": ["f923b729ccbf8d3c939f9e3f9410fb484774ba9d"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914009 - [wasm] Properly handle return_call_ref results in baseline. r=rhunt a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219693", "files": ["js/src/wasm/WasmBaselineCompile.cpp"], "git_node": null, "git_parents": [null], "node": "84ca255af9502a0d7a72b13b64de67bca1af6e27", "parents": ["4b1cec5599fcac4fa0218c9a2100bd30a820de4f"], "tags": []}], "date": 1724368619, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "108": {"changesets": [{"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909018 - Migrate gfx/vr off PlainOldDataSerializer. r=mccr8,nika a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217185", "files": ["dom/bindings/TypedArray.h", "dom/canvas/TiedFields.h", "dom/vr/VRDisplay.cpp", "dom/vr/VRServiceTest.cpp", "gfx/vr/VRDisplayClient.cpp", "gfx/vr/VRDisplayClient.h", "gfx/vr/VRManager.cpp", "gfx/vr/VRShMem.cpp", "gfx/vr/VRShMem.h", "gfx/vr/external_api/moz_external_vr.h", "gfx/vr/gfxVR.cpp", "gfx/vr/gfxVR.h", "gfx/vr/ipc/VRMessageUtils.h", "gfx/vr/moz.build", "gfx/vr/service/OSVRSession.cpp", "gfx/vr/service/OculusSession.cpp", "gfx/vr/service/OpenVRSession.cpp", "ipc/chromium/src/base/pickle.cc", "ipc/chromium/src/base/pickle.h", "ipc/chromium/src/chrome/common/ipc_message_utils.h"], "git_node": null, "git_parents": [null], "node": "a32f9eef2226a5cd7969b5551563885fed13ce13", "parents": ["84ca255af9502a0d7a72b13b64de67bca1af6e27"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1885245 - Remove PlainOldDataSerializer. r=mccr8 a=RyanVM\n\nThere's no sufficiently robust way to identify POD types in C++, such\nthat we could rely on this kind of thing for serialization.\n\nAs one example, `bool` must be carefully handled on deserialize, in case\nan attacker wants to exploit the UB of bool with value 2.\nAdditionally, generally it's not viable to tell whether all the members\nof a struct are PODs as well, and we need that level of assurance\nrecursively!\n\nSo we instead lean on e.g. ParamTraits_TiedFields/_IsEnumCase for our\nextreme robustness requirements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217518", "files": ["ipc/glue/IPCMessageUtils.h"], "git_node": null, "git_parents": [null], "node": "85e397e67f3e7e012b42cd6906b56e73f24341b1", "parents": ["a32f9eef2226a5cd7969b5551563885fed13ce13"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1906744 - Check if constructor is enabled before installing named property. r=mccr8,dom-storage-reviewers,janv,asuth,eemeli a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216671", "files": ["dom/bindings/BindingDeclarations.h", "dom/bindings/BindingUtils.cpp", "dom/bindings/BindingUtils.h", "dom/bindings/Codegen.py", "dom/bindings/WebIDLGlobalNameHash.cpp", "dom/cache/CacheStorage.cpp", "dom/cache/CacheStorage.h", "dom/indexedDB/IndexedDatabaseManager.cpp", "dom/webidl/DOMLocalization.webidl", "dom/webidl/Localization.webidl", "dom/workers/RegisterBindings.cpp", "extensions/pref/autoconfig/src/nsJSConfigTriggers.cpp", "intl/l10n/Localization.cpp", "intl/l10n/Localization.h", "js/xpconnect/src/Sandbox.cpp"], "git_node": null, "git_parents": [null], "node": "bb2dc425b68f306189c639f81468790c38297000", "parents": ["85e397e67f3e7e012b42cd6906b56e73f24341b1"], "tags": []}], "date": 1724522863, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "109": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1909018 - Fix rebase issues. a=bustage\n\nThis was created by reverting revs 5b6b822f52e6+9bac10b90db8 then\nre-grafting revs 5f911e4787cb+4e9fe79abfdf and folding the resulting\ncommits together.", "files": ["gfx/vr/external_api/moz_external_vr.h", "gfx/webrender_bindings/webrender_ffi.h"], "git_node": null, "git_parents": [null], "node": "47c0ce6ec28351a4847c061f00ae5b0240707708", "parents": ["bb2dc425b68f306189c639f81468790c38297000"], "tags": []}], "date": 1724532469, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "110": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220102", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/translations-models.json"], "git_node": null, "git_parents": [null], "node": "49e746f805bd2d0c6a18e9db2df6ccbac0242eae", "parents": ["47c0ce6ec28351a4847c061f00ae5b0240707708"], "tags": ["FIREFOX_128_2_0esr_BUILD1", "FIREFOX_128_2_0esr_RELEASE"]}], "date": 1724672863, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "69": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging b5f945290d0a97227a9de2c841b6695e40a9f7c2 with FIREFOX_128_1_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "294572f096a31b997e3fc1c9f40d50e77330d695", "parents": ["b5f945290d0a97227a9de2c841b6695e40a9f7c2"], "tags": []}], "date": 1722542733, "git_changesets": [null], "user": "ffxbld"}, "70": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "68eff2ee211d81950398953da1a326a222cede51", "parents": ["294572f096a31b997e3fc1c9f40d50e77330d695"], "tags": []}], "date": 1722869551, "git_changesets": [null], "user": "ffxbld-merge"}, "71": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging b5f945290d0a97227a9de2c841b6695e40a9f7c2 with FIREFOX_128_1_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "2991aee6dce0ddf924bf21d2a78fc74f8c2a212f", "parents": ["68eff2ee211d81950398953da1a326a222cede51"], "tags": []}], "date": 1722949316, "git_changesets": [null], "user": "ffxbld"}, "72": {"changesets": [{"author": "Jiaxun Yang \u003cjiaxun.yang@flygoat.com\u003e", "branch": "default", "desc": "Bug 1909587: Correct MoveEmitter switch case  a=dmeehan\n\nThis seems to be a accidental change made in D198105.\n\nSigned-off-by: Jiaxun Yang \u003cjiaxun.yang@flygoat.com\u003e\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217671\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218286", "files": ["js/src/jit/mips64/MoveEmitter-mips64.cpp"], "git_node": null, "git_parents": [null], "node": "3f5a6d063dd05747e1628cb99ecc2d3887830a19", "parents": ["2991aee6dce0ddf924bf21d2a78fc74f8c2a212f"], "tags": []}], "date": 1722954724, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "73": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1741469 part 1: Make some cleanups and readability edits to test_bug1261673.html.  a=dmeehan\n\nThe next patch in this series will extend this test a bit.  To make that change\neasier to understand (and make the test in general easier to follow), I'm doing\na bit of initial tweaks/cleanup.\n\nNotable changes:\n* Switched to \"is(a,b)\" instead of \"ok(a == b, 'expect a get b)\".\n* Renamed (and added brief documentation for) variables 'result',\n  'numberChange', and 'expectChange' to make their meanings/usage clearer.\n* Expanded out some one-liner ternary-logic expressions, both for readability\n  and because I'm going to be extending them with more cases in the next patch.\n* Removed unnecessary parseInt() (p.valueChanged is already an integer; no\n  parsing needed) but added another (wrapping input.value, so that is() doesn't\n  spuriously fail due to integer vs. string comparison).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D175971\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217521", "files": ["dom/html/test/test_bug1261673.html"], "git_node": null, "git_parents": [null], "node": "133d1557016e7609a402944c6e537e3a4620b5ec", "parents": ["3f5a6d063dd05747e1628cb99ecc2d3887830a19"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1741469 part 2: Make some cleanups and readability edits to test_bug1261674-1.html.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216497\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217522", "files": ["dom/html/test/test_bug1261674-1.html"], "git_node": null, "git_parents": [null], "node": "d526c54220a318ae09d1926b9162e226e4d06709", "parents": ["133d1557016e7609a402944c6e537e3a4620b5ec"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1741469 part 3: Add an off-by-default pref to control whether input type=\"number\"/\"range\" fields are modified when mousewheel-scrolled.  a=dmeehan\n\nThe C++ code change here is simply replacing an ifdef with a pref-check (and\nassociated reindentation for being placed in an \"if\"-block).\n\nThe pref is off-by-default for now, since no other browser seems to modify\nthese fields through mousewheel scrolling, and users seem to be surprised when\nthey encounter the behavior in Firefox.  See discussion on the bugzilla page.\n\nNote: now that this behavior is controlled by a pref, we don't need to have\nplatform-specific #ifdefs and \"skip-if\" test exemptions. If we decide to bring\nthis behavior back on certain platforms, we can do so by simply changing the\ndefault value of the pref on those platforms.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D175719\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217523", "files": ["dom/html/HTMLInputElement.cpp", "dom/html/test/mochitest.toml", "dom/html/test/test_bug1261673.html", "dom/html/test/test_bug1261674-1.html", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "7e3d2a20fa87daa0fdf984f5c2c5d6255a451f7f", "parents": ["d526c54220a318ae09d1926b9162e226e4d06709"], "tags": []}], "date": 1722954996, "git_changesets": [null, null, null], "user": "dmeehan@mozilla.com"}, "74": {"changesets": [{"author": "Barret Rennie \u003cbarret@brennie.ca\u003e", "branch": "default", "desc": "Bug 1896718 - Implement the prefFlips feature  a=dmeehan\n\nThis patch implements the prefFlips feature that was added as a placeholder in\nbug 1896720. The schema has been updated to fix a bug, as the accepted values\nfor the `branch` key were incorrect. Additionally, the schema now forbids pref\nflips that would clear the default branch, as that is something we cannot do.\n\nWhen a setPref experiment is currently enrolled and a prefFlips experiment\nwould enroll that touches the same prefs, the setPref experiment is unenrolled\nand vice versa (i.e., the old experiment will always unenroll). This is an edge\ncase, as we do not expect this to happen in practice (since if a pref is\ncovered by a feature with setPref, the prefFlips feature probably shouldn't be\nused to change it). Unenrollment telemetry has been updated to add a new\n\"prefFlips-conflict\" reason for this case, which also includes the slug of the\nexperiment that caused unenrollment (as `conflictingSlug` / `conflicting_slug`\nin legacy and Glean, respectively).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D213506\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217993", "files": ["toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/schemas/PrefFlipsFeature.schema.json", "toolkit/components/nimbus/test/unit/test_prefFlips.js", "toolkit/components/nimbus/test/unit/xpcshell.toml", "toolkit/components/telemetry/Events.yaml"], "git_node": null, "git_parents": [null], "node": "36c5835519cd23499a1f1ea21a46474a2b5e6b17", "parents": ["7e3d2a20fa87daa0fdf984f5c2c5d6255a451f7f"], "tags": []}, {"author": "Barret Rennie \u003cbarret@brennie.ca\u003e", "branch": "default", "desc": "Bug 1903584 - Remove invalid type from PrefFlipsFeature.schema.json  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214274\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217995", "files": ["toolkit/components/nimbus/schemas/PrefFlipsFeature.schema.json"], "git_node": null, "git_parents": [null], "node": "a8dca1a33e1cc610a2fb3e3b6a6e88014cce4189", "parents": ["36c5835519cd23499a1f1ea21a46474a2b5e6b17"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1907436 - Cache initial pref values for prefFlips feature on the enrollment  a=dmeehan\n\nThe prefFlips feature was not caching the original (pre-experiment) values for\nthe prefs it was setting anywhere that would survive a restart. We now store\nthese on the enrollment in the store under\n`enrollment.prefFlips.originalValues`.  This storage is similar, but not\nidentical, to the `prefs` storage, which is used to cache information about\n`setPref` experiments. That storage cannot be repurposed for this without\nintertwining the Nimbus-owned setPref support and the prefFlips feature.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216445\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217996", "files": ["toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/schemas/NimbusEnrollment.schema.json", "toolkit/components/nimbus/test/unit/test_prefFlips.js"], "git_node": null, "git_parents": [null], "node": "228232159973b627da9b6a2a58b0a11be51cb315", "parents": ["a8dca1a33e1cc610a2fb3e3b6a6e88014cce4189"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1907649 - Unenroll if prefFlips feature cannot set prefs  a=dmeehan\n\nIf the prefFlips feature receives a configuration that conflicts with the local\npref store (e.g., a pref has a default branch value of one type and the feature\nconfiguration contains that same pref with a value of a different type), then\nthe call to set the pref will throw. We now catch those errors and trigger\nunenrollment with reason `prefFlips-failed`.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217502\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217998", "files": ["toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/unit/test_prefFlips.js", "toolkit/components/telemetry/Events.yaml"], "git_node": null, "git_parents": [null], "node": "e7ae9446ca9761d25fa49d1a8353b9fcb72d057e", "parents": ["228232159973b627da9b6a2a58b0a11be51cb315"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1910410 - prefFlips fail to unenroll when re-enrolling in rollouts  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217967\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217991", "files": ["toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/test/unit/test_prefFlips.js"], "git_node": null, "git_parents": [null], "node": "a6651f4ae410ca741f89bc4eafe72463956d1702", "parents": ["e7ae9446ca9761d25fa49d1a8353b9fcb72d057e"], "tags": []}], "date": 1722964582, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "75": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1910243 - Add test coverage for ChannelWrapper + fix minor issues  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217899\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218304", "files": ["dom/chrome-webidl/ChannelWrapper.webidl", "toolkit/components/extensions/test/xpcshell/test_ChannelWrapper.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp", "toolkit/components/extensions/webrequest/ChannelWrapper.h"], "git_node": null, "git_parents": [null], "node": "885e9ef8760d11f80cd5cb0458b039fc2f2b904c", "parents": ["a6651f4ae410ca741f89bc4eafe72463956d1702"], "tags": []}], "date": 1722992062, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "76": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1911941 - Remove check with non-existent interface  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218715", "files": ["toolkit/components/extensions/test/xpcshell/test_ChannelWrapper.js"], "git_node": null, "git_parents": [null], "node": "19547aa562b2db11ee22ee2508da9a9a158ff072", "parents": ["885e9ef8760d11f80cd5cb0458b039fc2f2b904c"], "tags": []}], "date": 1723032578, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "77": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909211 - Bookmark dialogs suggests all already entered tags instead of just the new matching one.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217803\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218307", "files": ["toolkit/components/autocomplete/nsIAutoCompleteSimpleResult.idl", "toolkit/components/places/TaggingService.sys.mjs", "toolkit/components/places/tests/unit/test_tag_autocomplete_search.js"], "git_node": null, "git_parents": [null], "node": "bc1b261a7c07b7e4d67c70a7811b339074c9edee", "parents": ["19547aa562b2db11ee22ee2508da9a9a158ff072"], "tags": []}], "date": 1723050956, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "78": {"changesets": [{"author": "Francesco Lodolo (:flod) \u003cflod@lodolo.net\u003e", "branch": "default", "desc": "Bug 1911760 - Move skr from region to language set in mozIntl,  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218628\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218710", "files": ["toolkit/components/mozintl/mozIntl.sys.mjs"], "git_node": null, "git_parents": [null], "node": "9c9f0a6ebb4846edb7fb863fe6e4fe445ffb52fb", "parents": ["bc1b261a7c07b7e4d67c70a7811b339074c9edee"], "tags": []}], "date": 1723060362, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "79": {"changesets": [{"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907931, fix missing closing tags so that the downloads tests are properly run, r=Gijs, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217307", "files": ["uriloader/exthandler/tests/mochitest/browser_save_filenames.js", "uriloader/exthandler/tests/mochitest/save_filenames.html"], "git_node": null, "git_parents": [null], "node": "8812d00c0b1570b479cd91cb729525c4dffb80c3", "parents": ["9c9f0a6ebb4846edb7fb863fe6e4fe445ffb52fb"], "tags": []}, {"author": "fanc999 \u003cfanc999@yahoo.com.tw\u003e", "branch": "default", "desc": "Bug 1907001 - Add MOZ_HAS_CLANG_ATTRIBUTE r=glandium, a=dmeehan\n\nNote this patch was provided by a contributor to fix MSVC builds of a SpiderMonkey embedding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216843", "files": ["mfbt/Attributes.h"], "git_node": null, "git_parents": [null], "node": "87055016f93b90aee436440800b8e922363138d2", "parents": ["8812d00c0b1570b479cd91cb729525c4dffb80c3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1909752 - Allow intermediate ancestors between focused radiogroup and radio. r=desktop-theme-reviewers,dao, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217808", "files": ["toolkit/themes/shared/radio.css"], "git_node": null, "git_parents": [null], "node": "d95456aa9e771bb122aed752cd5349e0a6cfa070", "parents": ["87055016f93b90aee436440800b8e922363138d2"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218833", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f3c60ddb1640bd5c1df912c1716676c066d030a7", "parents": ["d95456aa9e771bb122aed752cd5349e0a6cfa070"], "tags": []}], "date": 1723125415, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "80": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219049", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/top-sites.json"], "git_node": null, "git_parents": [null], "node": "9eb8175cbb558146bbc53a4443128c9971a0f67d", "parents": ["f3c60ddb1640bd5c1df912c1716676c066d030a7"], "tags": []}], "date": 1723468626, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "81": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907367 - Update audioipc to 128/129 cherry-pick branch.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218924", "files": [".cargo/config.toml.in", "Cargo.lock", "third_party/rust/audioipc2-server/.cargo-checksum.json", "third_party/rust/audioipc2-server/src/server.rs", "toolkit/library/rust/shared/Cargo.toml"], "git_node": null, "git_parents": [null], "node": "9abc7163145d6b86673949a33fff721ec20673d4", "parents": ["9eb8175cbb558146bbc53a4443128c9971a0f67d"], "tags": []}], "date": 1723476477, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "82": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1907269 - Part 1: Allow pop-up windows to load external URIs for first load, r=Gijs a=pascalc\n\nPreviously this load would be allowed due to the \"web-controlled\" check\nfailing to reject the load. This patch instead bases it on the\ndocshell.newWindowTarget flag, which is set for the first load in a new\nDocShell due to a call to window.open or target=_blank.\n\nThis required making the external protocol channel be a property bag so\nthat the flag can be set on the channel. In the future we may want to\nswitch this flag to being set in a more generic way which is less\nspecific to the channel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217484", "files": ["docshell/base/nsDocShell.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/nsExternalHelperAppService.h", "uriloader/exthandler/nsExternalProtocolHandler.cpp", "uriloader/exthandler/nsIExternalProtocolService.idl"], "git_node": null, "git_parents": [null], "node": "cedfa3c0051a6eb9242e8ae44c30416644f21d9b", "parents": ["9abc7163145d6b86673949a33fff721ec20673d4"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1907269 - Part 2: Test that external URIs load in noopener pop-ups, r=smaug a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218011", "files": ["uriloader/exthandler/tests/mochitest/browser_protocol_ask_dialog.js"], "git_node": null, "git_parents": [null], "node": "9b2d619c3119c98884a0564e380b5489fb3d47b6", "parents": ["cedfa3c0051a6eb9242e8ae44c30416644f21d9b"], "tags": []}], "date": 1723624565, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "83": {"changesets": [{"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1911909 - wasm: Refactor structs and arrays to more closely match the spec.  a=dmeehan\n\nThe spec has the notion of a 'FieldType' which both struct fields\nand array types share. This commit refactors them to use the same\ntype.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218753\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218982", "files": ["js/src/wasm/WasmBaselineCompile.cpp", "js/src/wasm/WasmDump.cpp", "js/src/wasm/WasmGcObject-inl.h", "js/src/wasm/WasmGcObject.cpp", "js/src/wasm/WasmGcObject.h", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmIonCompile.cpp", "js/src/wasm/WasmOpIter.h", "js/src/wasm/WasmPI.cpp", "js/src/wasm/WasmSerialize.cpp", "js/src/wasm/WasmTypeDef.cpp", "js/src/wasm/WasmTypeDef.h", "js/src/wasm/WasmValidate.cpp"], "git_node": null, "git_parents": [null], "node": "49deaa4855a5a1a63847abaa164e044bdeb6f0ff", "parents": ["9b2d619c3119c98884a0564e380b5489fb3d47b6"], "tags": []}], "date": 1723706412, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "84": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1912663 - Fix some build issues with cbindgen 0.27. r=firefox-style-system-reviewers,zrhoffman, a=dmeehan\n\nIt updates serde and syn and they are more strict. In particular, syn 2\ndoesn't parse the rust 2015 syntax where try is not a keyword, and serde\nrejects duplicate keys.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219025", "files": ["servo/components/style_traits/values.rs", "servo/ports/geckolib/cbindgen.toml"], "git_node": null, "git_parents": [null], "node": "98e3a85fd936ce684fe45275edfa49b0ac91f542", "parents": ["49deaa4855a5a1a63847abaa164e044bdeb6f0ff"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 1909204 - Wrap Translations WebAssembly detection in a try/catch; r=translations-reviewers,nordzilla, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217840", "files": ["toolkit/components/translations/actors/TranslationsParent.sys.mjs"], "git_node": null, "git_parents": [null], "node": "bf6a25cd4b94f6ce789600f70a76f9ed3c8ffe27", "parents": ["98e3a85fd936ce684fe45275edfa49b0ac91f542"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908144 - Add support for extracting Widevine plugins from Chrome component update service CRX3 archives. r=media-playback-reviewers,alwu, a=dmeehan\n\nWe already landed the necessary support for CRX3 in bug 1860397. The\ndifference with the compontent update service is that the Widevine\narchives store the plugin files in a different folder within the archive\nthan before.\n\nThis patch makes it so that we extract all binaries/manifest files,\nflattening the archive structure in the process. This should continue to\nwork for our present Widevine update mechanism, as well as the Chrome\ncomponent update service in the future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216703", "files": ["toolkit/modules/GMPExtractor.worker.js"], "git_node": null, "git_parents": [null], "node": "8bec25fbb66fe4f87ca087af371a59b6bad03450", "parents": ["bf6a25cd4b94f6ce789600f70a76f9ed3c8ffe27"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1912328 - Permit stat for allowed files in GMP process sandbox. r=gcp,gerard-majax, a=dmeehan\n\nAfter updating the Widevine plugin to 4.10.2830.0, we would crash on\nstartup of the plugin because it attempted to use the stat syscall.\nAllow uses of stat for files that we have already opened / allowed\naccess to in the GMP sandbox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218855", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": null, "git_parents": [null], "node": "e0a8eac6ea21b90785d1c5c6f8625af2adf459ec", "parents": ["8bec25fbb66fe4f87ca087af371a59b6bad03450"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1912449 - Allow Widevine GMP process to access shell32. r=media-playback-reviewers,chunmin, a=dmeehan\n\nThe latest Widevine DLL added a dependency for APIs provided by\nshell32.dll which we did not previously allow the Widevine GMP process\nto access. This patch (thanks Bob Owen!) adds it to the list of DLLs to\npreload before enabling the sandbox.\n\nThe difference can be observed by using SystemInformer's peview to see\nthe list of imported DLLs and methods by the Widevine DLL. This allowed\nus to see that shell32 was a new dependency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219159", "files": ["dom/media/gmp/GMPChild.cpp", "dom/media/gmp/GMPParent.cpp"], "git_node": null, "git_parents": [null], "node": "d9e94290dc91911dfe6b382d59028c3242e6a41a", "parents": ["e0a8eac6ea21b90785d1c5c6f8625af2adf459ec"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219232", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "d261b663d2bcbd48b32eaadc5fda1f6c6975eb2b", "parents": ["d9e94290dc91911dfe6b382d59028c3242e6a41a"], "tags": []}], "date": 1723800021, "git_changesets": [null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "85": {"changesets": [{"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911890 - Future proof Translations actor test versioning  a=dmeehan\n\nEnsures that Translations actor test properly use our\nglobal major-version constants instead of assuming `1.*`.\n\nThis ensures that if we ever bump the major version,\nthen these tests will adapt as necessary.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218676\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219278", "files": ["toolkit/components/translations/tests/browser/browser_translations_actor_sync_models.js"], "git_node": null, "git_parents": [null], "node": "96bce20121af2a543e5a2864e60e95e185ffbe5a", "parents": ["d261b663d2bcbd48b32eaadc5fda1f6c6975eb2b"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911890 - Refactor Translations Remote Settings sync tests  a=dmeehan\n\nRefactors the Translations Remote Settings sync tests to\nproperly update the test Remote Settings databases before\nemitting a \"sync\" event to the client, rather than only\nemitting a \"sync\" event with no actual database changes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218677\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219279", "files": ["toolkit/components/translations/tests/browser/browser_translations_actor.js", "toolkit/components/translations/tests/browser/browser_translations_actor_sync_models.js", "toolkit/components/translations/tests/browser/shared-head.js"], "git_node": null, "git_parents": [null], "node": "5599bf930bb1435dfb00fdd7ed862f1adc8c94d0", "parents": ["96bce20121af2a543e5a2864e60e95e185ffbe5a"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911890 - Rework Translations Models Remote Settings sync  a=dmeehan\n\nReworks the way that the TranslationsParent handles \"sync\"\nevents from the Remote Settings Models collection to rebuild\nthe cache instead of attempting to modify the cached data in place.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218678\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219280", "files": ["toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/tests/browser/browser_translations_actor_sync_models.js"], "git_node": null, "git_parents": [null], "node": "35f6979799de640a906d2e476ea2164b33dd933b", "parents": ["5599bf930bb1435dfb00fdd7ed862f1adc8c94d0"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911890 - Rework Translations WASM Remote Settings sync  a=dmeehan\n\nReworks the way that the TranslationsParent handles \"sync\"\nevents from the Remote Settings WASM collection to work and\nbe tested the same way that the Models collection is handled.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218679\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219281", "files": ["toolkit/components/translations/actors/TranslationsParent.sys.mjs", "toolkit/components/translations/tests/browser/browser.toml", "toolkit/components/translations/tests/browser/browser_translations_actor_sync_models.js", "toolkit/components/translations/tests/browser/browser_translations_actor_sync_wasm.js", "toolkit/components/translations/tests/browser/browser_translations_remote_settings.js", "toolkit/components/translations/tests/browser/shared-head.js"], "git_node": null, "git_parents": [null], "node": "cc422232ca0ffe81137544c96e7f9cd82dcde4ee", "parents": ["35f6979799de640a906d2e476ea2164b33dd933b"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911896 - Rename TranslationsPanelShared.clearCache  a=dmeehan\n\nRenames the TranslationsPanelShared.clearCache function to\nclearLanguageListsCache to be more specific about what it does.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218680\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219282", "files": ["browser/components/translations/content/TranslationsPanelShared.sys.mjs", "toolkit/components/translations/tests/browser/shared-head.js"], "git_node": null, "git_parents": [null], "node": "591764d2630c6cc59b18d698cac137b408321dc7", "parents": ["cc422232ca0ffe81137544c96e7f9cd82dcde4ee"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911896 - Repopulate menulists when available lanaguges change  a=dmeehan\n\nEnsures that all FullPageTranslationsPanel and SelectTranslationsPanel\ninstances will repopulate their dropdown menulist elements if the\nlist of available languages changes, e.g. due to a Remote Settings sync.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218681\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219284", "files": ["browser/components/translations/content/TranslationsPanelShared.sys.mjs", "browser/components/translations/tests/browser/browser.toml", "browser/components/translations/tests/browser/browser_translations_full_page_panel_modify_available_language_models.js", "browser/components/translations/tests/browser/browser_translations_select_panel_modify_available_language_models.js", "toolkit/components/translations/actors/TranslationsParent.sys.mjs"], "git_node": null, "git_parents": [null], "node": "8c1d8e123c0caba2f55ac11e6cb590d106cbb574", "parents": ["591764d2630c6cc59b18d698cac137b408321dc7"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911897 - Repopulate menulists when application locale changes  a=dmeehan\n\nEnsures that all FullPageTranslationsPanel and SelectTranslationsPanel\ninstances will repopulate their dropdown menulist elements if the\napplication locale changes, to ensure that the language display names\nare correct for the current locale.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218682\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219285", "files": ["browser/components/translations/content/TranslationsPanelShared.sys.mjs", "browser/components/translations/tests/browser/browser.toml", "browser/components/translations/tests/browser/browser_translations_full_page_panel_change_app_locale.js", "browser/components/translations/tests/browser/browser_translations_select_panel_change_app_locale.js"], "git_node": null, "git_parents": [null], "node": "fd0975f8aad5b77bbb3192d1c9593900baaff945", "parents": ["8c1d8e123c0caba2f55ac11e6cb590d106cbb574"], "tags": []}], "date": 1723802056, "git_changesets": [null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "86": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911779 - Default to including the URL in crash reports  a=dmeehan\n\nThis default is used when the crash reporter has never been launched\nbefore. Notably, this is currently a user-global setting (as opposed to\nper-profile), so the defaults will typically only be used when someone\nhasn't ever had Firefox installed on their system.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218887\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219152", "files": ["toolkit/crashreporter/client/app/src/settings.rs", "toolkit/crashreporter/client/app/src/test.rs"], "git_node": null, "git_parents": [null], "node": "3812db8185a4418a701b34cc4abadaa0e3fb6939", "parents": ["fd0975f8aad5b77bbb3192d1c9593900baaff945"], "tags": []}], "date": 1723892729, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "87": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219430", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "2c1d2a38f3fb47e8f4625d7a2bfe015685926238", "parents": ["3812db8185a4418a701b34cc4abadaa0e3fb6939"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1898476 [Wayland] Move MozContainerSurfaceLock from MozContainerWayland to MozContainerSurfaceLock module r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D214883", "files": ["widget/gtk/MozContainerSurfaceLock.cpp", "widget/gtk/MozContainerSurfaceLock.h", "widget/gtk/MozContainerWayland.cpp", "widget/gtk/MozContainerWayland.h", "widget/gtk/moz.build"], "git_node": null, "git_parents": [null], "node": "8b028061cfc7131457dad7fe1dd6ba44a93fa042", "parents": ["2c1d2a38f3fb47e8f4625d7a2bfe015685926238"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1898476 [Wayland] Provide surface lock by GtkCompositorWidget r=emilio a=RyanVM\n\nDepends on D214883\n\nDifferential Revision: https://phabricator.services.mozilla.com/D214884", "files": ["widget/gtk/GtkCompositorWidget.cpp", "widget/gtk/GtkCompositorWidget.h", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "c254c181da3a8738f7a7dc1034dec1fb8e11ef81", "parents": ["8b028061cfc7131457dad7fe1dd6ba44a93fa042"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1898476 [Wayland] Lock Wayland surface before Swap buffers in RenderCompositorEGL r=emilio a=RyanVM\n\nDepends on D214884\n\nDifferential Revision: https://phabricator.services.mozilla.com/D214885", "files": ["gfx/webrender_bindings/RenderCompositorEGL.cpp"], "git_node": null, "git_parents": [null], "node": "6c8f74a5f58c24cee6319b031f48052ffa8a11d2", "parents": ["c254c181da3a8738f7a7dc1034dec1fb8e11ef81"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1907511 [Linux/X11] Check mWindow at GtkCompositorWidget::LockSurface() r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216380", "files": ["widget/gtk/GtkCompositorWidget.cpp"], "git_node": null, "git_parents": [null], "node": "01e6854115fed6d2c1c137cbe748c3facdb9594c", "parents": ["6c8f74a5f58c24cee6319b031f48052ffa8a11d2"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911858 - Improve code in BacktrackingAllocator::tryMergeBundles. r=iain a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218743", "files": ["js/src/jit/BacktrackingAllocator.cpp"], "git_node": null, "git_parents": [null], "node": "e9f774a165cf95aeecf8044c98832bd72bf0fec1", "parents": ["01e6854115fed6d2c1c137cbe748c3facdb9594c"], "tags": []}], "date": 1724105339, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "88": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1908496 - adjust defaults for news/snews/nntp protocols,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216938\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219572", "files": ["browser/app/profile/firefox.js"], "git_node": null, "git_parents": [null], "node": "78f71c49cfd2085aea9afc7f00401209f06e4e6e", "parents": ["e9f774a165cf95aeecf8044c98832bd72bf0fec1"], "tags": []}], "date": 1724105658, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "89": {"changesets": [{"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909019 - [esr128] Use ParamTraits_TiedFields/_IsEnumCase in WebRenderMessageUtils instead of PlainOldDataSerializer. (partial) r=gw a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218104", "files": ["dom/canvas/ClientWebGLContext.cpp", "dom/canvas/QueueParamTraits.h", "dom/canvas/TiedFields.h", "dom/canvas/WebGLIpdl.h", "dom/canvas/WebGLQueueParamTraits.h", "dom/canvas/WebGLTypes.h", "gfx/layers/wr/WebRenderMessageUtils.h", "gfx/webrender_bindings/WebRenderTypes.h"], "git_node": null, "git_parents": [null], "node": "5b6b822f52e6cac6f36368d2abe54167b30cd4f7", "parents": ["78f71c49cfd2085aea9afc7f00401209f06e4e6e"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909019 - [esr128] Use ParamTraits_TiedFields/_IsEnumCase in WebRenderMessageUtils instead of PlainOldDataSerializer. (complete) r=gw a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218105", "files": ["gfx/2d/ScaledFontDWrite.cpp", "gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/ScaledFontFreeType.cpp", "gfx/2d/ScaledFontMac.cpp", "gfx/layers/wr/WebRenderMessageUtils.h", "gfx/thebes/gfxPlatform.cpp", "gfx/webrender_bindings/webrender_ffi.h", "gfx/wr/webrender_api/src/font.rs", "gfx/wr/wr_glyph_rasterizer/src/rasterizer.rs"], "git_node": null, "git_parents": [null], "node": "9bac10b90db8fa87567ef50e01b268569732bc55", "parents": ["5b6b822f52e6cac6f36368d2abe54167b30cd4f7"], "tags": []}], "date": 1724105823, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "90": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1912804 - Don't warn in BasePrincipal::IsL10nAllowed if GetURI return null.  a=RyanVM\n\nGetURI can succeed, but still return null. In that case, BasePrincipal::IsL10nAllowed\nwill pass null into NS_URIChainHasFlags, causing it to fail, which will produce three\nseparate warnings, and then return NS_OK. A recent change caused this function to be\ncall much more frequently, so this is now the top source of log spam in debug builds.\n\nThis change should not affect the behavior, aside from the lack of warnings.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219065\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219575", "files": ["caps/BasePrincipal.cpp"], "git_node": null, "git_parents": [null], "node": "8ba1caaf75a1d4b8c4e64617663d3e96daa90b62", "parents": ["9bac10b90db8fa87567ef50e01b268569732bc55"], "tags": []}], "date": 1724107235, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "91": {"changesets": [{"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 1899943 - Show menupopup gutter on macOS only when an item is selected/checked.  a=RyanVM\n\nIn bug 1668119, I adjusted macOS menupopups to only show a gutter if the menu contains either items that are checkboxes or radios, or checked/selected items of any type. However, this was not quite correct. In native macOS menus, a gutter is only shown if there is a checked/selected item--even if there are checkbox items, there should not be a gutter if no item is checked/selected. This patch matches that behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D212217\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219586", "files": ["toolkit/content/widgets/menupopup.js"], "git_node": null, "git_parents": [null], "node": "ca7d3ed012ddb9836ed16d838d0565a92bea4ed8", "parents": ["8ba1caaf75a1d4b8c4e64617663d3e96daa90b62"], "tags": []}, {"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 1906034 - Show macOS titlebar if we are not drawing into it.  a=RyanVM\n\nRather than always hiding the titlebar for ToolbarWindows, conditionally show it if we are not drawing into it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215586\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219589", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": null, "git_parents": [null], "node": "2f3e4781e79723cd851c968439dfc2fdadb8ee32", "parents": ["ca7d3ed012ddb9836ed16d838d0565a92bea4ed8"], "tags": []}, {"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 1906037 - Restore macOS desktop tinting on dialog windows.  a=RyanVM\n\nAfter bug 1867854, dialog windows on macOS no longer show desktop tinting on the window background. Since this requires a transparent Gecko background, the `-moz-mac-unified-toolbar-window` appearance added in bug 1870481 should be applied to every window. It has been renamed to reflect this.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215596\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219588", "files": ["browser/themes/osx/browser.css", "browser/themes/osx/places/organizer.css", "browser/themes/shared/pageInfo.css", "servo/components/style/values/specified/box.rs", "toolkit/themes/osx/global/global.css", "widget/cocoa/nsNativeThemeCocoa.mm"], "git_node": null, "git_parents": [null], "node": "3639b5c0f841b25b43219ff89410968a15f4d34f", "parents": ["2f3e4781e79723cd851c968439dfc2fdadb8ee32"], "tags": []}, {"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 1905808 - Consolidate organizer info pane styles, use nesting.  a=RyanVM\n\nThe general layout of the info pane is the same across platforms, so share the styles. This fixes the missing spacing on macOS after bug 1881256. Due to the changes in that bug, Windows no longer needs its own input styling, as it achieves the same appearance as the base styles (except for colors, which have been carried over).\n\nApplied nesting to modified files.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215464\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219590", "files": ["browser/themes/linux/places/organizer.css", "browser/themes/osx/places/organizer.css", "browser/themes/shared/places/organizer-shared.css", "browser/themes/windows/places/organizer.css"], "git_node": null, "git_parents": [null], "node": "1533833f1578c9e3fab335c225bcabe5973a58a5", "parents": ["3639b5c0f841b25b43219ff89410968a15f4d34f"], "tags": []}], "date": 1724174633, "git_changesets": [null, null, null, null], "user": "rvandermeulen@mozilla.com"}, "92": {"changesets": [{"author": "Malte J\u00c3\u00bcrgens \u003cmaltejur@dismail.de\u003e", "branch": "default", "desc": "Bug 1910312 - Unbreak privacy and security settings when MOZ_DATA_REPORTING is disabled  a=RyanVM\n\nDisabling `MOZ_DATA_REPORTING` results in the `PREF_UPLOAD_ENABLED` pref not\nbeing loaded with `Preferences.add`. This means\n`Preferences.get(PREF_UPLOAD_ENABLED)` can possibly be `null`, which was\npreviously not handled and resulted in an error for the whole privacy.js file.\n\nSo only call `dataCollectionCheckboxHandler` for the `privateAttribution`\ncheckbox if `MOZ_DATA_REPORTING` is enabled (otherwise the `privateAttribution`\ncheckbox also just doesn't exist). Also move the call into separate\n`initPrivateAttributionCheckbox` function to be more consistent with previous\ncode.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218265\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219597", "files": ["browser/components/preferences/privacy.js"], "git_node": null, "git_parents": [null], "node": "327077da371277a145dabf656c98b05d9e7748c4", "parents": ["1533833f1578c9e3fab335c225bcabe5973a58a5"], "tags": []}], "date": 1724174693, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "93": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1874314 - Better anti-aliasing for subpixel rectangles. r=aosmond a=RyanVM\n\nThe existing distance-to-edge AA scheme breaks down somewhat when rectangles\nhave subpixel areas. We need to bias the AA to account for this situation when\nthe scales get to these subpixel sizes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215095", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": null, "git_parents": [null], "node": "dd27237cd034d581c6f094cbc794f7ace6a3bd1c", "parents": ["327077da371277a145dabf656c98b05d9e7748c4"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911019 - Use different anti-aliasing approximation for subpixel rectangles. r=aosmond a=RyanVM\n\nThe previous attempt at refining the subpixel anti-aliasing approximation modified the\ndistance-to-edge tracking, which can cause the AA to approach zero too soon.\n\nThis fixes this by reverting the distance-to-edge tracking back to the way it was, but\ninstead limiting the alpha to the area of the subpixel rectangle if necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218493", "files": ["dom/canvas/DrawTargetWebgl.cpp", "gfx/2d/DrawTargetSkia.cpp"], "git_node": null, "git_parents": [null], "node": "a2a21e812f68d021bc9834e7bff39c29cce00212", "parents": ["dd27237cd034d581c6f094cbc794f7ace6a3bd1c"], "tags": []}, {"author": "Sean Feng \u003csefeng@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909202 - Use NS_BINDING_ABORTED for ORB blocked errors r=kershaw,necko-reviewers a=RyanVM\n\nHttp2 uses a single connection for multiple requests. When ORB blocks a\nrequest with NS_ERROR_FAILURE, it's treated as a hard error in necko,\nthen the entire connection is closed.\n\nThis patches converts ORB to uses NS_BINDING_ABORTED.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218643", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/OpaqueResponseUtils.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/unit/test_orb_empty_header.js"], "git_node": null, "git_parents": [null], "node": "b9149fce62c3093482b2fac1d134041bb28073b9", "parents": ["a2a21e812f68d021bc9834e7bff39c29cce00212"], "tags": []}], "date": 1724181716, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "94": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908095 - [devtools] removeSessionDataEntry for webextension toolboxes and watcher targets r=ochameau,devtools-reviewers a=RyanVM\n\nFix removing breakpoints in webextension toolboxes and watcher targets, add tests to cover both scenarios\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218084", "files": ["devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_debugger.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakable-lines.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakable-positions.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakpoints.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-source-tree.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-uncompressed/v1/index.html", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-uncompressed/v1/log-worker.js", "devtools/client/debugger/test/mochitest/head.js", "devtools/server/connectors/js-process-actor/DevToolsProcessChild.sys.mjs", "devtools/server/connectors/js-process-actor/target-watchers/worker.sys.mjs"], "git_node": null, "git_parents": [null], "node": "85060db8ce994d36d233b2b00c5086231e995f13", "parents": ["b9149fce62c3093482b2fac1d134041bb28073b9"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908095 - [devtools] Regenerate debugger mochitest sourcemap resources r=devtools-reviewers,nchevobbe a=RyanVM\n\nDepends on D218084\n\nDifferential Revision: https://phabricator.services.mozilla.com/D218349", "files": ["devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/package.json", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/index.html", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/log-worker.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/react-component-module.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/script.js"], "git_node": null, "git_parents": [null], "node": "21bf8880f77238b69a49e67a8ac07729e1c4f18e", "parents": ["85060db8ce994d36d233b2b00c5086231e995f13"], "tags": []}, {"author": "Sean Feng \u003csefeng@mozilla.com\u003e", "branch": "default", "desc": "Bug 1863246 - Make the page that enters BFCache not asking the parent process to update the active browsing context r=peterv,dom-core a=RyanVM\n\nCurrently, when a page enters BFCache, it updates the parent process\nfor the active BC; however, the page that is about to show will do the\nsame. These two operations are triggered in different processes with\ndifferent active id, they are racy and problematic.\n\nThis patch fixes the above issue by not updating the parent process\nwhen a page enters BFCache.\n\nThis only applies to BFCacheInParent is enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215818", "files": ["docshell/test/navigation/browser.toml", "docshell/test/navigation/browser_bfcache_activebc.js", "dom/base/nsFocusManager.cpp", "dom/base/nsFocusManager.h", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h", "dom/base/nsGlobalWindowOuter.cpp", "dom/base/nsGlobalWindowOuter.h", "dom/base/nsPIDOMWindow.h", "dom/interfaces/base/nsIFocusManager.idl", "layout/base/nsDocumentViewer.cpp"], "git_node": null, "git_parents": [null], "node": "5c96a83fe7176d9d9980091cd07f90e2d176327e", "parents": ["21bf8880f77238b69a49e67a8ac07729e1c4f18e"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911531 - Forbid any WorkerRunnable execution in WorkerPrivate::RunLoopNeverRan. r=dom-worker-reviewers,asuth a=RyanVM\n\nThis is a patch for uplift PreStartRunnable cleaning on the Worker thread for ESR128.\nIt includes the following fixes\n[[ https://phabricator.services.mozilla.com/D213947 | bug 1894231 ]] introduces WorkerRunnable::mCleanPreStartDispatching instead of using WorkerPrivate raw pointer.\n[[ https://phabricator.services.mozilla.com/D215601 | bug 1905337 ]] keeps dispatched PreStartRunnables in WorkerPrivate::mPreStartRunnables.\n[[ https://phabricator.services.mozilla.com/D216379 | bug 1907383 ]] does not execute WorkerControlRunnable if Worker initialization fails\n[[ https://phabricator.services.mozilla.com/D218619 | bug 1911531 ]] Ensures all dispatched runnables in Pending status are appended in WorkerPrivate::mPreStartRunnables.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217546", "files": ["dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h", "dom/workers/WorkerRunnable.cpp", "dom/workers/WorkerRunnable.h", "dom/workers/WorkerThread.cpp", "dom/workers/WorkerThread.h"], "git_node": null, "git_parents": [null], "node": "5d69735a10801f60a8bba889837eb052087f6099", "parents": ["5c96a83fe7176d9d9980091cd07f90e2d176327e"], "tags": []}], "date": 1724188681, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "95": {"changesets": [{"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1892537 - Set mIsPrimary by pointer ID only for touch input  a=RyanVM\n\nIt only make sense for touch input, as touch pointer ID always restarts from 0 while pen pointer ID always increments.\n\nThis won't work if there are multiple active pens, but that's rare enough and not straightforward to fix as somehow sActivePointersIds gets pointerId=0 instead of actual pointer ID for pens.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D214978\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219698", "files": ["dom/events/PointerEventHandler.cpp"], "git_node": null, "git_parents": [null], "node": "560485f317f9b69aea96a766f35a2227b1e46462", "parents": ["5d69735a10801f60a8bba889837eb052087f6099"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1892537 - Add test with sendTouchEventAsPen  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219699", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/base/nsDOMWindowUtils.h", "dom/events/test/pointerevents/mochitest.toml", "dom/events/test/pointerevents/test_pointermove_isPrimary_subsequent_pens.html", "dom/interfaces/base/nsIDOMWindowUtils.idl", "testing/mochitest/tests/SimpleTest/EventUtils.js"], "git_node": null, "git_parents": [null], "node": "c045e853e0f4cd5f61ba6c0cc404d314fc25c995", "parents": ["560485f317f9b69aea96a766f35a2227b1e46462"], "tags": []}], "date": 1724194928, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "96": {"changesets": [{"author": "Butkovits Atila \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Backed out 2 changesets (bug 1908095) for causing failures at browser_dbg-features-breakpoints.js. a=backout\n\nBacked out changeset 21bf8880f772 (bug 1908095)\nBacked out changeset 85060db8ce99 (bug 1908095)", "files": ["devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_debugger.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakable-lines.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakable-positions.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-breakpoints.js", "devtools/client/debugger/test/mochitest/browser_dbg-features-source-tree.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/package.json", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/index.html", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/log-worker.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/react-component-module.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-compressed/v1/script.js", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-uncompressed/v1/index.html", "devtools/client/debugger/test/mochitest/examples/sourcemaps-reload-uncompressed/v1/log-worker.js", "devtools/client/debugger/test/mochitest/head.js", "devtools/server/connectors/js-process-actor/DevToolsProcessChild.sys.mjs", "devtools/server/connectors/js-process-actor/target-watchers/worker.sys.mjs"], "git_node": null, "git_parents": [null], "node": "b59270108b4e16f03a6272a47d3b819fdad66c4d", "parents": ["c045e853e0f4cd5f61ba6c0cc404d314fc25c995"], "tags": []}], "date": 1724201854, "git_changesets": [null], "user": "abutkovits@mozilla.com"}, "97": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1903780 - Support directory names again in downloads.download  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218719\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219740", "files": ["mobile/shared/components/extensions/ext-downloads.js", "netwerk/mime/nsIMIMEService.idl", "toolkit/components/downloads/DownloadPaths.sys.mjs", "toolkit/components/downloads/test/unit/test_DownloadPaths.js", "toolkit/components/extensions/parent/ext-downloads.js", "toolkit/components/extensions/test/mochitest/test_ext_downloads_download.html", "toolkit/components/extensions/test/xpcshell/test_ext_downloads_download.js", "uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/tests/unit/test_filename_sanitize.js"], "git_node": null, "git_parents": [null], "node": "f3bf1705bfa0f923e4541e6cc9f9aada80b733d9", "parents": ["b59270108b4e16f03a6272a47d3b819fdad66c4d"], "tags": []}], "date": 1724245832, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "98": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911288 - Mark cross compartment edges from uncollected zones during gray marking that have been marked black since black marking happened (ESR128)  a=RyanVM\n\nThe problem here is that currently we mark incoming cross compartment edges\nfrom uncollected compartments in two phases depending on the color of the\nwrapper, but that color can change in between due to gray unmarking.\n\nThe patch does the simple thing of rescanning the incoming edges for black\nwrappers after marking gray ones. This involves a little juggling of the\ncurrent mark color to ensure we can't mark black after marking gray.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219726", "files": ["js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp", "js/src/jit-test/tests/gc/bug-1911288.js", "js/src/vm/Compartment.cpp", "js/src/vm/Compartment.h"], "git_node": null, "git_parents": [null], "node": "7ee6dc774d926f02aee1345a8d33331a1a9c9559", "parents": ["f3bf1705bfa0f923e4541e6cc9f9aada80b733d9"], "tags": []}], "date": 1724245882, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "99": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1906132 - Explicitly set bresize bit when doing a measuring reflow. r=dholbert a=RyanVM\n\nThis doesn't change behavior, but it is more explicit.\n\nMake the two resize code-paths invalidate the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215841", "files": ["layout/base/PresShell.cpp", "layout/base/PresShell.h"], "git_node": null, "git_parents": [null], "node": "94b3460d45470d93922e5c6326fa7a246829dcc8", "parents": ["7ee6dc774d926f02aee1345a8d33331a1a9c9559"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1896901 - Don't use an \u003cinput\u003e for unknown content type file. r=dao,desktop-theme-reviewers a=RyanVM\n\nThis happens because the input minimum size doesn't depend on the value\ntext. There's an experimental CSS property to support something like\nthis, field-sizing:\n\n  https://developer.mozilla.org/en-US/docs/Web/CSS/field-sizing\n\nWhich is tracked on bug 1832409, but which we don't implement yet.\n\nThis makes the form minimum size account for the content, while keeping\ntext selectability. It's not ideal because there's no caret / Ctrl+A\netc, but it's probably an ok trade-off? Alternatively we can wontfix /\nmake this depend on implementing field-sizing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210513", "files": ["toolkit/mozapps/downloads/HelperAppDlg.sys.mjs", "toolkit/mozapps/downloads/content/unknownContentType.xhtml", "toolkit/themes/shared/downloads/unknownContentType.css"], "git_node": null, "git_parents": [null], "node": "945b673151f9cd02985eb947f0e7b8a4cc80eb9e", "parents": ["94b3460d45470d93922e5c6326fa7a246829dcc8"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1902227 [Linux/VA-API] Backport AV1/VA-API playback fix for AMD/mesa \u003e 24.0.7 r=padenot a=RyanVM\n\nBackport of https://gitlab.freedesktop.org/mesa/mesa/-/merge_requests/29400\nAllows to use multiple slices for AV1 VA-API decode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216919", "files": ["media/ffvpx/libavcodec/vaapi_av1.c", "media/ffvpx/libavcodec/vaapi_decode.c", "media/ffvpx/libavcodec/vaapi_decode.h", "media/ffvpx/libavcodec/vaapi_vp8.c", "media/ffvpx/libavcodec/vaapi_vp9.c"], "git_node": null, "git_parents": [null], "node": "2f01ee75380c0ca50244a633fc067dc697bbfee8", "parents": ["945b673151f9cd02985eb947f0e7b8a4cc80eb9e"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908393 - Only hold strong references to BounceTrackingState in BrowsingContextWebProgress. r=nika,anti-tracking-reviewers,timhuang a=RyanVM\n\nThis ensures that the lifetime of a BounceTrackingState is tied more closely to the lifetime of a tab.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216974", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingStorageObserver.cpp"], "git_node": null, "git_parents": [null], "node": "2595e9392227f3f16d497041a3df4cd986470bb6", "parents": ["2f01ee75380c0ca50244a633fc067dc697bbfee8"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1904424 [Linux/X11] Don't steal focus on X11 r=emilio a=RyanVM\n\nThe patch comes from https://gitlab.com/redhat/centos-stream/rpms/firefox/-/merge_requests/94\n\nFirefox isn't currently handling window focusing right on X11... There's a few problems:\n\nIf no startup id is provided, it tries to get user time from g_get_monotonic_time when there's no guarantee that timestamp is synchronized or even in a compatible unit. This merge request addressed that by dropping the code that uses g_get_monotonic_time entirely, and instead adding a heuristic to synthesize a startup id based on the time of the last user interaction on the display. This makes an assumption that firefox was started as a result of user interaction, which might not always hold true, but it's more likely than not, and is basically the same assumption firefox is already making by trying to use a timestamp of \"now\" (g_get_monotonic_time) when focusing the window.\n\nIf a startup id is provided, it fails to tell gtk to use it when focusing the window because it calls gtk_window_present_with_time with some other random timestamp instead of passing GDK_CURRENT_TIME (which is the magic value that means \"use startup id for timestamp\"). This commit tries to detect when a startup id is available, and the display is X11, and if so use a timestamp of GDK_CURRENT_TIME.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217174", "files": ["toolkit/components/remote/nsDBusRemoteServer.cpp", "toolkit/xre/nsAppRunner.cpp", "widget/gtk/WidgetUtilsGtk.cpp", "widget/gtk/WidgetUtilsGtk.h", "widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "9e33cae4ad555212d166e824c50300b8629bea8c", "parents": ["2595e9392227f3f16d497041a3df4cd986470bb6"], "tags": []}], "date": 1724254618, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}}
}";