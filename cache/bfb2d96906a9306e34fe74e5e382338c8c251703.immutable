"a734325cf934215db7730f4b334d9ae4d8919589", "git_parents": ["0f0d01fce346c6c0256f9bded5bfbb8de7f99660"], "node": "46e87fd04693611f76f088cc667758f02edbdfba", "parents": ["431916c6f027b65b1e5f9bab0825d4319fc56942"], "tags": []}], "date": 1775492122, "git_changesets": ["a734325cf934215db7730f4b334d9ae4d8919589"], "user": "rvandermeulen@mozilla.com"}, "811": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023407: Force WR pixel capture to use specific known directory.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289396\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291235\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/interfaces/base/nsIDOMWindowUtils.idl", "gfx/layers/ipc/PWebRenderBridge.ipdl", "gfx/layers/wr/WebRenderBridgeChild.cpp", "gfx/layers/wr/WebRenderBridgeChild.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.h", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs"], "git_node": "147d5f6d5152827447f64f49dc2c234f8ebec964", "git_parents": ["a734325cf934215db7730f4b334d9ae4d8919589"], "node": "5096a0539dd1e7af0da3e142a4b12c9e5c137244", "parents": ["46e87fd04693611f76f088cc667758f02edbdfba"], "tags": []}], "date": 1775492314, "git_changesets": ["147d5f6d5152827447f64f49dc2c234f8ebec964"], "user": "rvandermeulen@mozilla.com"}, "812": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028267.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291392\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292056\n", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": "cee25ea9cb801c1ec955036ba081e6868f63f653", "git_parents": ["147d5f6d5152827447f64f49dc2c234f8ebec964"], "node": "a3304a3f3f0c388ee5a14e139154975120a7e4f7", "parents": ["5096a0539dd1e7af0da3e142a4b12c9e5c137244"], "tags": []}], "date": 1775492488, "git_changesets": ["cee25ea9cb801c1ec955036ba081e6868f63f653"], "user": "rvandermeulen@mozilla.com"}, "813": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028551  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291535\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291964\n", "files": ["dom/media/platforms/ffmpeg/FFmpegAudioDecoder.cpp"], "git_node": "2608668ab2670fd3dec226827f4829f1cd9394ab", "git_parents": ["cee25ea9cb801c1ec955036ba081e6868f63f653"], "node": "744de82baad9b35a17befda778a26b4c108cc5aa", "parents": ["a3304a3f3f0c388ee5a14e139154975120a7e4f7"], "tags": []}], "date": 1775492541, "git_changesets": ["2608668ab2670fd3dec226827f4829f1cd9394ab"], "user": "rvandermeulen@mozilla.com"}, "814": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2027975.  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291948\n", "files": ["gfx/layers/SourceSurfaceSharedData.cpp"], "git_node": "50f8f4af01fef562a818e4b53ab3f1d6e08f0ae6", "git_parents": ["2608668ab2670fd3dec226827f4829f1cd9394ab"], "node": "edac976eaa7b790ef44c614b31f294bca12ab111", "parents": ["744de82baad9b35a17befda778a26b4c108cc5aa"], "tags": []}], "date": 1775492592, "git_changesets": ["50f8f4af01fef562a818e4b53ab3f1d6e08f0ae6"], "user": "rvandermeulen@mozilla.com"}, "815": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2025483 update mBeginProcessing even on speex_resampler_set_rate() error  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290769\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292113\n", "files": ["dom/media/webaudio/AudioBufferSourceNode.cpp"], "git_node": "57f4c93a0f1068f9bfa102015c5727d74f7a0a27", "git_parents": ["50f8f4af01fef562a818e4b53ab3f1d6e08f0ae6"], "node": "81716de1cf5769574d3758683ff5ec84ea9f932b", "parents": ["edac976eaa7b790ef44c614b31f294bca12ab111"], "tags": []}], "date": 1775505210, "git_changesets": ["57f4c93a0f1068f9bfa102015c5727d74f7a0a27"], "user": "dsmith@mozilla.com"}, "816": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 2027161 - Simplify GMP plugin and actor lifetimes.  a=diannaS DONTBUILD\n\nWith OpenH264, each GMP video decoder/encoder has its own worker thread\nto perform the actual decoding/encoding. It posts back to the main\nthread which the IPDL actors live on. Many of its callbacks are\nsynchronous, meaning it blocks the worker thread until the main thread\nruns the dispatched task. When we try to destroy the plugin, it attempts\nto join with the worker thread. That means we cannot attempt to join\nwhile there are any outstanding synchronous calls, otherwise the threads\nwill deadlock.\n\nPreviously we managed this by having an event queue just for the GMP\nplugin callbacks, and tracking how many outstanding synchronous\ncallbacks we are expecting to be dispatched in the future. This is\ncomplicated and somewhat brittle.\n\nThe refactoring in this patch takes advantage of bug 1942129 which\ndecoupled the Shmem lifetime from the IPDL actor lifetime. This means\nthe buffers backing the GMP encoded/decoded frames can now live beyond\nGMPVideoDecoder/EncoderChild::ActorDestroy being called. Taking\nadvantage of that, we can take strong references to the IPDL actor that\nimplements the callbacks whenever there is an outstanding call that may\ntrigger a synchronous callback. This keeps everything alive long enough\nfor the callbacks to finish, and when the last reference is released, we\ncan safely destroy the decoder/encoder, and join the worker thread.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291885\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292075\n", "files": ["dom/media/gmp-plugin-openh264/gmp-fake-openh264.cpp", "dom/media/gmp/GMPChild.cpp", "dom/media/gmp/GMPContentChild.cpp", "dom/media/gmp/GMPPlatform.cpp", "dom/media/gmp/GMPPlatform.h", "dom/media/gmp/GMPService.cpp", "dom/media/gmp/GMPSharedMemManager.cpp", "dom/media/gmp/GMPSharedMemManager.h", "dom/media/gmp/GMPVideoDecoderChild.cpp", "dom/media/gmp/GMPVideoDecoderChild.h", "dom/media/gmp/GMPVideoDecoderParent.cpp", "dom/media/gmp/GMPVideoDecoderParent.h", "dom/media/gmp/GMPVideoEncodedFrameImpl.cpp", "dom/media/gmp/GMPVideoEncodedFrameImpl.h", "dom/media/gmp/GMPVideoEncoderChild.cpp", "dom/media/gmp/GMPVideoEncoderChild.h", "dom/media/gmp/GMPVideoEncoderParent.cpp", "dom/media/gmp/GMPVideoEncoderParent.h", "dom/media/gmp/GMPVideoHost.cpp", "dom/media/gmp/GMPVideoHost.h", "dom/media/gmp/GMPVideoi420FrameImpl.cpp", "dom/media/gmp/GMPVideoi420FrameImpl.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "187357c8e9b8075e6ec2337fb885a06d400b6841", "git_parents": ["57f4c93a0f1068f9bfa102015c5727d74f7a0a27"], "node": "e16f8bcd491acf8e9a871608a8dbdaa26ba0170c", "parents": ["81716de1cf5769574d3758683ff5ec84ea9f932b"], "tags": []}], "date": 1775505292, "git_changesets": ["187357c8e9b8075e6ec2337fb885a06d400b6841"], "user": "dsmith@mozilla.com"}, "817": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027359. r=sotaro,gfx-reviewers, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291395\n", "files": ["gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderTextureHostSWGL.h", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.h"], "git_node": "b01f6f1cce484744edbdfb2821f9df8ad47ac5c9", "git_parents": ["187357c8e9b8075e6ec2337fb885a06d400b6841"], "node": "05d0c9e612452f7af394366fbc7c517c527ebba0", "parents": ["e16f8bcd491acf8e9a871608a8dbdaa26ba0170c"], "tags": []}]