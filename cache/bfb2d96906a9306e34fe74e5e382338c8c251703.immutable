gesets": ["7056ac7a4202202f315da7d179707ba67d8b6743"], "user": "dmeehan@mozilla.com"}, "732": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025445 - Fix redundant clear optimization to check if clip needs refresh.  a=dmeehan DONTBUILD\n\nDrawTargetWebgl's redundant clear optimization checks the current clip state to determine if\nthere is no effective clip. However, if drawing to Skia and not WebGL, there may be no current\nclip computed, or the clip state may be invalid.\n\nTo work around this, only use the current clip state if it is actually currently valid, and\notherwise compute a simple clip rectangle sufficient to validate if it contains the viewport\nwithout relying on cached clip state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290732\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebgl.h"], "git_node": "692710dc7b877763d6e7f39612bf5c794280074c", "git_parents": ["7056ac7a4202202f315da7d179707ba67d8b6743"], "node": "0307ede733eca02647b224be669e8db3923a5c62", "parents": ["4639a4965d300edb6af18cf661d5e1423ccf4061"], "tags": []}], "date": 1775031153, "git_changesets": ["692710dc7b877763d6e7f39612bf5c794280074c"], "user": "dmeehan@mozilla.com"}, "733": {"changesets": [{"author": "Andrew Osmond \u003caosmond@gmail.com\u003e", "branch": "default", "desc": "Bug 2025513.   a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290588\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290666\n", "files": ["dom/media/platforms/ffmpeg/VALibWrapper.cpp", "dom/media/platforms/ffmpeg/VALibWrapper.h"], "git_node": "ba03b378da1ab89c38c2dc2a020ec8f9c093e0cf", "git_parents": ["692710dc7b877763d6e7f39612bf5c794280074c"], "node": "3f23700490eb9d2fb0fb333e0f6a946c3fb60d3d", "parents": ["0307ede733eca02647b224be669e8db3923a5c62"], "tags": []}], "date": 1775031206, "git_changesets": ["ba03b378da1ab89c38c2dc2a020ec8f9c093e0cf"], "user": "dmeehan@mozilla.com"}, "734": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2024463 - Part 1 Check list size  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289110\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290661\n", "files": ["dom/svg/DOMSVGLengthList.cpp", "dom/svg/DOMSVGNumberList.cpp", "dom/svg/DOMSVGPointList.cpp", "dom/svg/DOMSVGTransformList.cpp"], "git_node": "09ba36978b2fb263cffae520b9e7dbcdadc3d735", "git_parents": ["ba03b378da1ab89c38c2dc2a020ec8f9c093e0cf"], "node": "12ff7a14aed12b694864d76a633b8d119385734e", "parents": ["3f23700490eb9d2fb0fb333e0f6a946c3fb60d3d"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2024463 - Part 2 Add more asserts  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289188\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290662\n", "files": ["dom/svg/DOMSVGLength.cpp", "dom/svg/DOMSVGLength.h", "dom/svg/DOMSVGNumber.h", "dom/svg/DOMSVGPoint.cpp", "dom/svg/DOMSVGPoint.h", "dom/svg/DOMSVGTransform.h"], "git_node": "c08bedf2f0d585947a69a865ea17c1872f07eada", "git_parents": ["09ba36978b2fb263cffae520b9e7dbcdadc3d735"], "node": "c973d1e1950e1e1c549795c8839256ddab2014e4", "parents": ["12ff7a14aed12b694864d76a633b8d119385734e"], "tags": []}], "date": 1775031303, "git_changesets": ["09ba36978b2fb263cffae520b9e7dbcdadc3d735", "c08bedf2f0d585947a69a865ea17c1872f07eada"], "user": "dmeehan@mozilla.com"}, "735": {"changesets": [{"author": "Simon Farre \u003csimon.farre.cx@gmail.com\u003e", "branch": "default", "desc": "Bug 2024433 - Notify of attribute change in BlastSubtree  a=dmeehan DONTBUILD\n\nBlastSubtreeToPieces is called during error recovery. It makes sense to\nnotify of attribute changes.\n\nThis effectively means extra work during error recovery, but the\nreasoning is that this should happen (very) rarely and when it does,\nit's fine to do the \"extra\" work.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289225\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290514\n", "files": ["dom/base/Document.cpp"], "git_node": "3ae50bc523be97235bf16d177f7bdcc9b03ce781", "git_parents": ["c08bedf2f0d585947a69a865ea17c1872f07eada"], "node": "6b778161d723f07d8196dab8c5cfe68b77cae644", "parents": ["c973d1e1950e1e1c549795c8839256ddab2014e4"], "tags": []}], "date": 1775031426, "git_changesets": ["3ae50bc523be97235bf16d177f7bdcc9b03ce781"], "user": "dmeehan@mozilla.com"}, "736": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025492.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289369\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290476\n", "files": ["dom/media/webcodecs/ImageDecoder.cpp"], "git_node": "9f356fd9e4125efbd226f7f54002a8fe220b3538", "git_parents": ["3ae50bc523be97235bf16d177f7bdcc9b03ce781"], "node": "61366cf6a51e8a18ffbadea74f940626d3be5b6a", "parents": ["6b778161d723f07d8196dab8c5cfe68b77cae644"], "tags": []}], "date": 1775031632, "git_changesets": ["9f356fd9e4125efbd226f7f54002a8fe220b3538"], "user": "dmeehan@mozilla.com"}, "737": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2022369 - [esr140] Fix CookieStorage::RemoveOlderCookiesUntilUnderLimit to use cookieKey  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289505\n", "files": ["netwerk/cookie/CookieStorage.cpp"], "git_node": "a4212c7b1eaf68d90223912aaa8bce32c82dd3d0", "git_parents": ["9f356fd9e4125efbd226f7f54002a8fe220b3538"], "node": "d0b7958ee4a8be8014620c972de44ac8766809f8", "parents": ["61366cf6a51e8a18ffbadea74f940626d3be5b6a"], "tags": []}], "date": 1775036258, "git_changesets": ["a4212c7b1eaf68d90223912aaa8bce32c82dd3d0"], "user": "dmeehan@mozilla.com"}, "738": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025468 - Enforce spec bounds in ParseStRefPicSet inter-predicted branch.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289394\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290224\n", "files": ["dom/media/platforms/agnostic/bytestreams/H265.cpp"], "git_node": "97f97a051f3a1cb4f149545d127287b6e9071e48", "git_parents": ["a4212c7b1eaf68d90223912aaa8bce32c82dd3d0"], "node": "86a7e98891f04b7f5471e8b2bd30d5ab9b86b090", "parents": ["d0b7958ee4a8be8014620c972de44ac8766809f8"], "tags": []}], "date": 1775036385, "git_changesets": ["97f97a051f3a1cb4f149545d127287b6e9071e48"], "user": "dmeehan@mozilla.com"}, "739": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025505 - Hold a strong reference in ImageDecoder::Close.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289679\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290313\n", "files": ["dom/media/webcodecs/ImageDecoder.cpp"], "git_node": "31fa365d67fa3711fdd1882d646b35d358a5f4cc", "git_parents": ["97f97a051f3a1cb4f149545d127287b6e9071e48"], "node": "b7bcbf0a8212c7d10b0e343d23b3a2b04771a900", "parents": ["86a7e98891f04b7f5471e8b2bd30d5ab9b86b090"], "tags": []}], "date": 1775036424, "git_changesets": ["31fa365d67fa3711fdd1882d646b35d358a5f4cc"], "user": "dmeehan@mozilla.com"}, "740": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025381 - Handle AbortSignal's reason more consistently.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289576\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290410\n", "files": ["dom/abort/AbortSignal.cpp", "dom/fetch/Fetch.cpp"], "git_node": "764c69b47f245f244a1e400464c12b3549a1b908", "git_parents": ["31fa365d67fa3711fdd1882d646b35d358a5f4cc"], "node": "bcb3fabcb3995d4f304a25828e1e7ec1d65bda67", "parents": ["b7bcbf0a8212c7d10b0e343d23b3a2b04771a900"], "tags": []}], "date": 1775036463, "git_changesets": ["764c69b47f245f244a1e400464c12b3549a1b908"], "user": "dmeehan@mozilla.com"}, "741": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 1 - Clean up some variable declarations and redundant #includes in thebes font code.  a=dmeehan\n\n(No behavior change, this is just some preparatory cleanup.)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288945\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290369\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "layout/style/ServoStyleSet.cpp"], "git_node": "ab9cef83bb2e02b479babaf7f80c59754a0b70c6", "git_parents": ["764c69b47f245f244a1e400464c12b3549a1b908"], "node": "e5d70e31767ca14d407f0b4bb4931d555b5c7c20", "parents": ["bcb3fabcb3995d4f304a25828e1e7ec1d65bda67"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 2 - Try to bypass font table cache in gfxFontconfigFontEntry.  a=dmeehan\n\nIf the FcPattern includes the pathname of the font file, we can use\nhb_face_create_from_file_or_fail to create an hb_face that directly\naccesses the memory-mapped file, rather than going through our GetFontTable\ncallback that relies on FreeType table access and the font table cache.\n\nThis means that such fonts will entirely bypass the table cache with its\ntricky management of blob ownership/lifetimes.\n\nThe old code is left in place as a fallback path for fonts where\nhb_face_create_from_file_or_fail fails. This should normally be limited\nto non-sfnt fonts such as legacy Type 1 resources, which are still found\non some Linux systems although they don't support modern font features.\nSuch fonts will still go via the table cache, etc. (although the tables\nbeing cached will be empty), but usage of it will be greatly reduced.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288946\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290370\n", "files": ["gfx/2d/2D.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "a7059e7c68147a4be73baabe95ee603448727289", "git_parents": ["ab9cef83bb2e02b479babaf7f80c59754a0b70c6"], "node": "f2b967d370c672bd0e3f307e6899d77645b85d34", "parents": ["e5d70e31767ca14d407f0b4bb4931d555b5c7c20"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 3 - Simplify FontTableCache to avoid potential race.  a=dmeehan\n\n(Based on Emilio's earlier patch here)\n\nThis simplifies the FontTableCache to avoid the weak-referencing scheme;\nnow once a table is cached, it will be retained indefinitely. Since most\nfonts bypass the cache, and non-sfnt fonts that still use it will have\nnull \"tables\", the memory footprint should be minimal.\n\nIn addition, the cache is removed entirely from gfxFontEntry on platforms\nthat don't use it, and only created if needed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288947\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290373\n", "files": ["gfx/thebes/CoreTextFontList.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxGDIFontList.cpp", "gfx/thebes/gfxGDIFontList.h", "gfx/thebes/gfxUserFontSet.h"], "git_node": "4b01534495987df4bb7dab05d97a0869754dad5b", "git_parents": ["a7059e7c68147a4be73baabe95ee603448727289"], "node": "2e47e1884d0db6cdd0347a6803d78aae0642ccb2", "parents": ["f2b967d370c672bd0e3f307e6899d77645b85d34"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015952 - patch 4 - Cache hb-face in FT2FontEntry if it wraps a disk file.  a=dmeehan\n\nLike in the fontconfig backend, on Android we can also use\nhb_face_create_from_file_or_fail to efficiently create an hb_face\nfor installed fonts that are available as disk resources.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D288951\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290374\n", "files": ["gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h"], "git_node": "9c4f044dadacab2eb25948f7904465092a564ddc", "git_parents": ["4b01534495987df4bb7dab05d97a0869754dad5b"], "node": "bd1b8f1946b5f8a89646bf8b5db1d19c67ba556a", "parents": ["2e47e1884d0db6cdd0347a6803d78aae0642ccb2"], "tags": []}], "date": 1775036684, "git_changesets": ["ab9cef83bb2e02b479babaf7f80c59754a0b70c6", "a7059e7c68147a4be73baabe95ee603448727289", "4b01534495987df4bb7dab05d97a0869754dad5b", "9c4f044dadacab2eb25948f7904465092a564ddc"], "user": "dmeehan@mozilla.com"}, "742": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290789\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "5d2d4374ec5a0e82f59b59975db7ed73c11e968e", "git_parents": ["9c4f044dadacab2eb25948f79044650