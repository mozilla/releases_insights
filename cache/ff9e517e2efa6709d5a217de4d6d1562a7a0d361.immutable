reloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "c10ef6260d75d37b59b74bfead7dc7282083ec6e", "parents": ["f07a340953ea75e0236f2fdc53504eed91057d34"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1831332 - Fix test_urlTelemetry.js to not use a code for the organic:other test that is likely to be an organic:none in the future. r=jteow, a=test-only", "files": ["browser/components/search/test/unit/test_urlTelemetry.js"], "git_node": null, "git_parents": [null], "node": "c84952630407cce038c0b5a20deb0b4aaca99917", "parents": ["c10ef6260d75d37b59b74bfead7dc7282083ec6e"], "tags": []}, {"author": "ahochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 1831691 - Use the vendored 'glean_parser' for all of `mach`. r=glandium, a=RyanVM", "files": ["python/sites/build.txt", "python/sites/mach.txt", "python/sites/python-test.txt"], "git_node": null, "git_parents": [null], "node": "75cfc11a9c1f646b47e31ac12a9fce6b27340286", "parents": ["c84952630407cce038c0b5a20deb0b4aaca99917"], "tags": []}], "date": 1683828578, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "251": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D178035", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "3afe2a0a2cc2155b78ed6d76f0acf3fa656e9c5c", "parents": ["75cfc11a9c1f646b47e31ac12a9fce6b27340286"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1807008 - Use enumerator directly to enumerate security devices. r=keeler, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "9827cc4b4b0f154f469d61ee7992dd3b37a1b8e3", "parents": ["3afe2a0a2cc2155b78ed6d76f0acf3fa656e9c5c"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1807790 - Allow JSON for WebsiteFilter policy. r=mstriemer, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D175914", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js"], "git_node": null, "git_parents": [null], "node": "92b4811eebc86acb83edced8a4cae54ca0881217", "parents": ["9827cc4b4b0f154f469d61ee7992dd3b37a1b8e3"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1829197 - Add support for deleting PKCS #11 modules via policy. r=keeler,fluent-reviewers,flod a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "656d54876405369eba969d43385aaca5511315a8", "parents": ["92b4811eebc86acb83edced8a4cae54ca0881217"], "tags": []}, {"author": "sotaro \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1806096 - Added check for front TextureClient lost by PersistentBufferProviderShared::SetKnowsCompositor(). r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D177870", "files": ["gfx/layers/PersistentBufferProvider.cpp", "gfx/layers/PersistentBufferProvider.h", "gfx/layers/ShareableCanvasRenderer.cpp"], "git_node": null, "git_parents": [null], "node": "b3af28b1059fa4bf8c4ace1cce59ac114d447966", "parents": ["656d54876405369eba969d43385aaca5511315a8"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1826875 - Dispatch using correct thread on UtilityProcessManager missing r=ipc-reviewers,nika a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D176618", "files": ["ipc/glue/BackgroundParentImpl.cpp"], "git_node": null, "git_parents": [null], "node": "e7f7b3381b7c49e8190bc258a2b444760bbae50a", "parents": ["b3af28b1059fa4bf8c4ace1cce59ac114d447966"], "tags": []}], "date": 1684180272, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "252": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1828968 - osclientcerts: make RSA-PSS support configurable via pref. r=jschanck, a=RyanVM\n\nDue to design constraints, it is difficult for osclientcerts to properly\nindicate whether or not each known key supports RSA-PSS. Ideally such a\ndetermination would be made close to when a particular key is going to be used,\nbut due to the design of PKCS#11 and NSS' tight coupling to it, osclientcerts\nwould have to make this determination when searching for all known keys, which\nhas been shown to be prohibitively slow on Windows and results in unexpected\ndialogs on macOS.\n\nThus, previously osclientcerts simply assumed all RSA keys supported RSA-PSS.\nThis has resulted in handshake failures when a server indicates that it accepts\nRSA-PSS signatures.\n\nThis patch instead makes RSA-PSS support configurable via a pref\n(security.osclientcerts.assume_rsa_pss_support). If the pref is true,\nosclientcerts assumes all RSA keys support RSA-PSS. If it is false, it assumes\nno RSA keys support RSA-PSS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D178241", "files": ["browser/components/enterprisepolicies/Policies.jsm", "modules/libpref/init/StaticPrefList.yaml", "security/certverifier/NSSCertDBTrustDomain.cpp", "security/manager/ssl/osclientcerts/src/lib.rs", "security/manager/ssl/tests/unit/test_osclientcerts_module.js"], "git_node": null, "git_parents": [null], "node": "67c31db53b310bd5ec90e9552dc3729e8f8dc96e", "parents": ["e7f7b3381b7c49e8190bc258a2b444760bbae50a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1828065 - cherry-pick upstream libwebrtc commit 6fc1ae58be. r=webrtc-reviewers,mjf a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6fc1ae58be7cbb61ad0431d90eb7a7dc333de2f2\n    In DeviceInfoDS check that out vars were set\n\n    Bug: chromium:1441804\n    Change-Id: Id07cb61519315d77c2d7cdab1053efaaf7473e1a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/304060\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Commit-Queue: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#39982}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D177236", "files": ["third_party/libwebrtc/modules/video_capture/windows/device_info_ds.cc", "third_party/libwebrtc/modules/video_capture/windows/help_functions_ds.cc"], "git_node": null, "git_parents": [null], "node": "3165cb0d89817fb2e7123a51b45cd3ec8108306a", "parents": ["67c31db53b310bd5ec90e9552dc3729e8f8dc96e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1828065 - cherry-pick upstream libwebrtc commit adf55790b6. r=webrtc-reviewers,mjf a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/adf55790b6ecf50c4bb2b2cf7d58441303b9d946\n    In DeviceInfoDS free the frame duration list after use\n\n    Per the docs, the caller is responsible for freeing the memory.\n\n    Bug: chromium:1441804\n    Change-Id: I9aaae493a1a86d8ab4f03930715a643a3c9fb61b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/304061\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Commit-Queue: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#39983}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D177237", "files": ["third_party/libwebrtc/modules/video_capture/windows/device_info_ds.cc"], "git_node": null, "git_parents": [null], "node": "69bb58b799def86b2ab3b367e7ce7194b6f9a733", "parents": ["3165cb0d89817fb2e7123a51b45cd3ec8108306a"], "tags": []}, {"author": "sunil mayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 1818394 - make nsHttpTransaction::mCaps and HttpTransactionParent::mCaps atomic. r=necko-reviewers,jesup a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D177279", "files": ["netwerk/protocol/http/ConnectionDiagnostics.cpp", "netwerk/protocol/http/HttpTransactionParent.h", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": null, "git_parents": [null], "node": "2e045f222cec70bf050f0e1e6e006a5e6f885225", "parents": ["69bb58b799def86b2ab3b367e7ce7194b6f9a733"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1695986 - Delay enabling exceptionDialogButton by pref security.dialog_enable_delay. r=Gijs, a=RyanVM\n\nAlso changes the conditions under which we send to telemetry via\nAboutNetErrorUIExpanded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D174497", "files": ["browser/base/content/certerror/aboutNetError.js", "toolkit/modules/RemotePageAccessManager.jsm"], "git_node": null, "git_parents": [null], "node": "34cb0157ca104e9cfe0992bcc6d8958a528799d6", "parents": ["2e045f222cec70bf050f0e1e6e006a5e6f885225"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1695986 - Also wait for 10x requestAnimationFrame to ensure warning is displayed to screen. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D174498\n\nDepends on D174497", "files": ["browser/base/content/certerror/aboutNetError.js"], "git_node": null, "git_parents": [null], "node": "4fe6f86004a5ddf10ad5e6f32bb7df1edbe5875f", "parents": ["34cb0157ca104e9cfe0992bcc6d8958a528799d6"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1695986 - Fix test to adapt to new behavior. r=Gijs, a=RyanVM\n\nFrustratingly, this test was previously silently malfunctioning. The\ntest attempts to test that clicking on add-exception causes navigation\nto the real page from the cert error page, but these pages have the same\nurl, so this was silently always passing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D176344\n\nDepends on D174498", "files": ["browser/base/content/test/captivePortal/browser_captivePortal_certErrorUI.js"], "git_node": null, "git_parents": [null], "node": "b908420f7f7d5586bd771cbd215133f94ef4f318", "parents": ["4fe6f86004a5ddf10ad5e6f32bb7df1edbe5875f"], "tags": []}], "date": 1684355045, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "253": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D178431", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0c2078515f50e9a92b0b2d9856d531b9c9dce7f