r": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1940994 - Simplify XUL tree image cache a bit. r=dholbert, a=RyanVM", "files": ["layout/xul/tree/nsTreeBodyFrame.cpp"], "git_node": null, "git_parents": [null], "node": "1fe92601aa3a84232d2133762631b9e7cb04eb23", "parents": ["b29b13c2247ac38f63c10eb7bc873984c44516d1"], "tags": []}], "date": 1737079142, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "366": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1936844.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D231955\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234037", "files": ["gfx/layers/SourceSurfaceSharedData.h", "gfx/layers/ipc/SharedSurfacesParent.cpp"], "git_node": null, "git_parents": [null], "node": "d10f0f36fd3b52bd1f58a5c452955cf0fc555798", "parents": ["1fe92601aa3a84232d2133762631b9e7cb04eb23"], "tags": []}], "date": 1737220280, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "367": {"changesets": [{"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1932555,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D231928\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234663", "files": ["dom/ipc/ContentParent.cpp"], "git_node": null, "git_parents": [null], "node": "24b0bae513f70517bf8a6b472bfbfc34cef8656d", "parents": ["d10f0f36fd3b52bd1f58a5c452955cf0fc555798"], "tags": []}], "date": 1737220407, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "368": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845152 - [devtools] Make sure the input is focused before triggering keyboard event in setProperty. r=devtools-reviewers,ochameau a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233821", "files": ["devtools/client/inspector/test/shared-head.js"], "git_node": null, "git_parents": [null], "node": "cd3fc7033df79b2c93ff8631778d150bff65b245", "parents": ["24b0bae513f70517bf8a6b472bfbfc34cef8656d"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1938927: Cyclic dependencies consisting only of non-computed custom properties should not mark any non-custom property as invalid-at-computed time. r=firefox-style-system-reviewers,emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232858", "files": ["servo/components/style/custom_properties.rs", "testing/web-platform/tests/css/css-properties-values-api/non-computed-unit-cycles.html"], "git_node": null, "git_parents": [null], "node": "581dd61bf1b43713b6f7628a207efb99f3f8ccc1", "parents": ["cd3fc7033df79b2c93ff8631778d150bff65b245"], "tags": []}], "date": 1737224334, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "369": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234822", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "166c12990cbedb1ad6221cd8862f98f62795ea6e", "parents": ["581dd61bf1b43713b6f7628a207efb99f3f8ccc1"], "tags": []}], "date": 1737379124, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "370": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794360 - Fail to clone ImageBitmap if no data surface available. r=gfx-reviewers,lsalzman a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D229927", "files": ["dom/canvas/ImageBitmap.cpp"], "git_node": null, "git_parents": [null], "node": "bf21588fb444820348905fb611e35b7020be13cf", "parents": ["166c12990cbedb1ad6221cd8862f98f62795ea6e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1919414 - Don't use Gecko's pages per sheet code in the native print dialog. r=dholbert, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232628", "files": ["widget/gtk/nsPrintDialogGTK.cpp"], "git_node": null, "git_parents": [null], "node": "2081421a876ea5418bded262692336640c3edb72", "parents": ["bf21588fb444820348905fb611e35b7020be13cf"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1940508 - Add null check to HandshakeDoneInternal before using mTransaction r=necko-reviewers,jesup a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233563", "files": ["netwerk/protocol/http/nsHttpConnection.cpp"], "git_node": null, "git_parents": [null], "node": "2647a6742e75488aa91d2586f9877f2fb9c63d3a", "parents": ["2081421a876ea5418bded262692336640c3edb72"], "tags": []}], "date": 1737469076, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "371": {"changesets": [{"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1939295 - Add OutputStreamHolder  a=RyanVM\n\nSimilar to InputStreamHolder, this adds OutputStreamHolder to FetchStreamReader:\n\n1. OutputStreamHolder is not part of the cycle collection but is freed when FetchStreamReader goes away\n2. nsIAsyncOutputStream holds OutputStreamHolder which only weakly hold FetchStreamReader, allowing FetchStreamReader to be cycle collected.\n3. GlobalTeardownObserver is not added here as we only accept JS ReadableStream here instead of nsIInputStream, which is part of the cycle collection unlike nsIInputStream.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D233553\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233934", "files": ["dom/fetch/FetchStreamReader.cpp", "dom/fetch/FetchStreamReader.h", "dom/fetch/tests/crashtests/1939295.html", "dom/fetch/tests/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "731c59b12de67a0fb7df27d828d931d0281e6bcf", "parents": ["2647a6742e75488aa91d2586f9877f2fb9c63d3a"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1941210 - Strongly grab FetchStreamReader while waiting for writing  a=RyanVM\n\nNothing strongly grabs ReadableStream nor FetchStreamReader while waiting for nsIAsyncOutputStream to respond. mAsyncWaitReader should now strongly grab the reader until the output stream responds.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D234031\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234838", "files": ["dom/fetch/FetchStreamReader.cpp", "dom/fetch/FetchStreamReader.h", "testing/web-platform/tests/fetch/api/basic/gc.any.js"], "git_node": null, "git_parents": [null], "node": "daf7073c4a54baa68b0c95789f944962da417f43", "parents": ["731c59b12de67a0fb7df27d828d931d0281e6bcf"], "tags": []}], "date": 1737469383, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "372": {"changesets": [{"author": "John Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1930028 - relax focus requirement for conditional WebAuthn get request.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D234570\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235032", "files": ["dom/credentialmanagement/CredentialsContainer.cpp"], "git_node": null, "git_parents": [null], "node": "52988190084cf0ce421f6ee0bf55ab57f5252d87", "parents": ["daf7073c4a54baa68b0c95789f944962da417f43"], "tags": []}], "date": 1737482167, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "373": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1936601. r=lsalzman a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D234803\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234973", "files": ["gfx/layers/SourceSurfaceSharedData.cpp", "gfx/layers/SourceSurfaceSharedData.h", "gfx/layers/ipc/SharedSurfacesParent.cpp"], "git_node": null, "git_parents": [null], "node": "e1015ef40500c4a37c29c7c70067fb7f9d45ca56", "parents": ["52988190084cf0ce421f6ee0bf55ab57f5252d87"], "tags": []}], "date": 1737482224, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "374": {"changesets": [{"author": "Sean Feng \u003csefeng@mozilla.com\u003e", "branch": "default", "desc": "Bug 1889406 - Notify the focus/active BC to content process for subframes when BrowserParent is first created r=dom-core,hsivonen a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221534", "files": ["docshell/base/BrowsingContextGroup.cpp", "docshell/base/BrowsingContextGroup.h", "dom/base/test/browser.toml", "dom/base/test/browser_set_focus_after_reuse_bcg.js", "dom/base/test/file_set_focus_after_reuse_bcg_1.html", "dom/base/test/file_set_focus_after_reuse_bcg_2.html", "dom/ipc/BrowserBridgeParent.cpp"], "git_node": null, "git_parents": [null], "node": "5f452a36976d6cd1dc2830b0db1a99f0a9e8e43d", "parents": ["e1015ef40500c4a37c29c7c70067fb7f9d45ca56"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1908196 [Linux] Drag&Drop - try to get text/uri-list first and convert it to text/x-moz-url r=emilio a=RyanVM\n\nTry to get  text/uri-list first and then fallback to text/x-moz-url.\ntext/x-moz-url MIME tends to be poorly supported by third party apps,\nwe got only one file instead of file list or nothing at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231160", "files": ["widget/gtk/nsDragService.cpp"], "git_node": null, "git_parents": [null], "node": "cef6df13213df9cc9f4eb62315faafa286111c60", "parents": ["5f452a36976d6cd1dc2830b0db1a99f0a9e8e43d"], "tags": []}], "date": 1737558952, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "375": {"changesets": [{"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1855346: Ensure that menu items added by macOS also don't execute commands when we expect all commands to be suppressed. Inspired by research by :chesterbr and :bintoro, and a patch by :chesterbr. r=mstange a=RyanVM", "files": ["toolkit/xre/MacApplicationDelegate.mm", "widget/cocoa/nsCocoaUtils.mm", "widget/cocoa/nsMenuBarX.h", "widget/cocoa/nsMenuBarX.mm", "widget/cocoa/nsMenuItemX.mm", "widget/cocoa/nsMenuUtilsX.mm", "widget/cocoa/nsMenuX.mm"], "git_node": null, "git_parents": [null], "node": "a154c99623facfc7c1bfa0bdee3c1ec1fb604dce", "parents": ["cef6df13213df9cc9f4eb62315faafa286111c60"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1833923: Start detecting when the Fn key is pressed on macOS, which allows for built-in macOS shortcuts (such as Fn+e for the emoji picker) to start working. r=masayuki, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235051", "files": ["dom/events/KeyEventHandler.h", "widget/TextEvents.h", "widget/cocoa/TextInputHandler.mm", "widget/cocoa/nsCocoaUtils.mm"], "git_node": null, "git_parents": [null], "node": "3c584e80b0c2198bf51240a9de63a7f606edd210", "parents": ["a154c99623facfc7c1bfa0bdee3c1ec1fb604dce"], "tags": []}], "date": 1737560814, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "376": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1889406 - Add needs-focus annotation to 1174332-1.html. r=sefeng, a=bustage", "files": ["layout/reftests/bugs/reftest.list"], "git_node": null, "git_parents": [null], "node": "99a5637caefcfeca4fa21c7c0278b714bd0c91a8", "parents": ["3c584e80b0c2198bf51240a9de63a7f606edd210"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1942738 - Move the .fpu neon directive around.  a=RyanVM\n\nclang's integrated assembler doesn't handle .fpu coming before .arch\nlike GNU as does.\n\nThe pixman patch was sent upstream: https://gitlab.freedesktop.org/pixman/pixman/-/issues/113#note_2746582\n\nOriginal Revision: https://phabricator.services.mozilla.com/D235087\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235100", "files": ["gfx/cairo/README", "gfx/cairo/libpixman/src/pixman-arm-neon-asm-bilinear.S", "gfx/cairo/libpixman/src/pixman-arm-neon-asm.S", "gfx/cairo/pixman-neon.patch", "gfx/ycbcr/yuv_convert_arm.cpp"], "git_node": null, "git_parents": [null], "node": "63779bf8f5ccac372a2f81dde6a71e400f6a111a", "parents": ["99a5637caefcfeca4fa21c7c0278b714bd0c91a8"], "tags": []}], "date": 1737576731, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "377": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937751 - Remember AAStroke mode when caching stroked path. r=jrmuizel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232781", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebglInternal.h", "dom/canvas/test/reftest/1937751-cached-stroked-paths-1-ref.html", "dom/canvas/test/reftest/1937751-cached-stroked-paths-1.html", "dom/canvas/test/reftest/reftest.list"], "git_node": null, "git_parents": [null], "node": "19051d942f901cfe98fc6bdb7fb653447d367c0b", "parents": ["63779bf8f5ccac372a2f81dde6a71e400f6a111a"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915589 - Allow co-existing entrypTypes and buffered options in PerformanceObserver.observe() method. r=sefeng, a=RyanVM\n\nIt's allowed, but the buffered option is ignored. This is what Blink\ndoes [1], what WebKit does [2]. (Both code blocks are inside the else\nbranch of if `has entryTypes`)\n\nThe web-platform-test in this change was originally copied from\nbuffered-flag-after-timeout.any.js and modified.\n\n[1] https://source.chromium.org/chromium/chromium/src/+/main:third_party/blink/renderer/core/timing/performance_observer.cc;l=264-273;drc=78780a188fe3c79fe815b170f4ea33e62ceb6e04\n[2] https://searchfox.org/wubkat/rev/6c800745251d53d6486443d63b35828504446c5d/Source/WebCore/page/PerformanceObserver.cpp#90-100\n[3] https://searchfox.org/mozilla-central/rev/e24277e20c492b4a785b4488af02cca062ec7c2c/testing/web-platform/tests/performance-timeline/buffered-flag-after-timeout.any.js\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233447", "files": ["dom/performance/PerformanceObserver.cpp", "testing/web-platform/tests/performance-timeline/buffered-flag-with-entryTypes-observer.tentative.any.js"], "git_node": null, "git_parents": [null], "node": "6006471e52ac03e06f6352fd7ab4baca5a04b36b", "parents": ["19051d942f901cfe98fc6bdb7fb653447d367c0b"], "tags": []}], "date": 1737593854, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "378": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235292", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "8716120ef069ad6a237b276470d7bc17d241f0ee", "parents": ["6006471e52ac03e06f6352fd7ab4baca5a04b36b"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1932923 - Add support for setting parameters on search engines based on enterprise usage. r=Standard8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233414", "files": ["toolkit/components/search/AppProvidedSearchEngine.sys.mjs", "toolkit/components/search/schema/search-config-v2-schema.json", "toolkit/components/search/tests/xpcshell/enterprise/search-config-v2.json", "toolkit/components/search/tests/xpcshell/head_search.js", "toolkit/components/search/tests/xpcshell/method-extensions/search-config-v2.json", "toolkit/components/search/tests/xpcshell/searchconfigs/test_google.js", "toolkit/components/search/tests/xpcshell/test_config_engine_params.js", "toolkit/components/search/tests/xpcshell/test_engine_ids.js", "toolkit/components/search/tests/xpcshell/test_getSubmission_params_pref.js", "toolkit/components/search/tests/xpcshell/test_policyEngine.js", "toolkit/components/search/tests/xpcshell/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "128064a519756d41c0773dc614e947e183f7f302", "parents": ["8716120ef069ad6a237b276470d7bc17d241f0ee"], "tags": []}], "date": 1737655275, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "379": {"changesets": [{"author": "Dennis Jackson \u003cdjackson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1936150 - land NSS NSS_3_101_3_RTM UPGRADE_NSS_RELEASE, r=nss-reviewers,jschanck a=RyanVM\n\n2025-01-23  Dennis Jackson  \u003cdjackson@mozilla.com\u003e\n\n\t* doc/rst/releases/index.rst:\n\tAdd release notes for 3.101.3\n\t[60be34d595b6] [NSS_3_101_3_RTM] \u003cNSS_3_101_BRANCH\u003e\n\n\t* lib/nss/nss.h, lib/softoken/softkver.h, lib/util/nssutil.h:\n\tSet verion numbers to 3.101.3\n\t[b799d486b567] \u003cNSS_3_101_BRANCH\u003e\n\n2024-12-09  Maurice Dauer  \u003cmdauer@mozilla.com\u003e\n\n\t* lib/pkcs7/certread.c:\n\tBug 1935984 - Ensure zero-initialization of collectArgs.cert,\n\tr=djackson,nss-reviewers\n\n\t[0c5bfd138fec] \u003cNSS_3_101_BRANCH\u003e\n\n2024-12-06  Dana Keeler  \u003cdkeeler@mozilla.com\u003e\n\n\t* lib/softoken/pkcs11.c, lib/util/utilmod.c:\n\tBug 1927953 - don't look for secmod.db in nssutil_ReadSecmodDB if\n\tNSS_DISABLE_DBM is set r=jschanck\n\n\t[2c13c7018b61] \u003cNSS_3_101_BRANCH\u003e\n\n2024-11-27  Anna Weine  \u003canna.weine@mozilla.com\u003e\n\n\t* lib/dev/devutil.c:\n\tBug 1926256 - fix build error from 9505f79d r=jschanck\n\n\t[4a2a05674aa3] \u003cNSS_3_101_BRANCH\u003e\n\n2024-11-26  John Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/dev/devutil.c:\n\tBug 1926256 - simplify error handling in\n\tget_token_objects_for_cache. r=rrelyea\n\n\t[72dc849de263] \u003cNSS_3_101_BRANCH\u003e\n\n2024-10-21  John Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* cmd/pk12util/pk12util.c:\n\tBug 1923767 - pk12util: improve error handling in\n\tp12U_ReadPKCS12File. r=nss-reviewers,nkulatova\n\n\t[23e5b96bfbdb] \u003cNSS_3_101_BRANCH\u003e\n\n2024-09-24  ISHIKAWA, Chiaki  \u003cishikawa@yk.rim.or.jp\u003e\n\n\t* lib/ssl/sslsnce.c:\n\tBug 1909768 - UBSAN fix: applying zero offset to null pointer in\n\tsslsnce.c. r=kaie\n\n\t[49a0f03dc97b] \u003cNSS_3_101_BRANCH\u003e\n\n2024-07-25  John Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/softoken/pkcs11u.c:\n\tBug 1908623 - move list size check after lock acquisition in\n\tsftk_PutObjectToList. r=rrelyea,nss-reviewers\n\n\t[b936ef0a883b] \u003cNSS_3_101_BRANCH\u003e\n\n2024-09-26  Kai Engert  \u003ckaie@kuix.de\u003e\n\n\t* lib/pkcs7/p7decode.c:\n\tBug 1899402 - Correctly destroy bulkkey in error scenario.\n\tr=jschanck\n\n\t[3200544b1a70] \u003cNSS_3_101_BRANCH\u003e\n\n2024-07-29  John Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/nss/nss.h, lib/softoken/softkver.h, lib/util/nssutil.h:\n\tSet version numbers to 3.101.2\n\t[f0fd00e7f8ee] \u003cNSS_3_101_BRANCH\u003e\n\n2024-07-24  John Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* .hgtags:\n\tAdded tag NSS_3_101_2_RTM for changeset 1204ed03458f\n\t[d7839c5f949e] \u003cNSS_3_101_BRANCH\u003e\n\nOriginal Revision: https://phabricator.services.mozilla.com/D235304\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235306", "files": ["security/nss/TAG-INFO", "security/nss/cmd/pk12util/pk12util.c", "security/nss/coreconf/coreconf.dep", "security/nss/doc/rst/releases/index.rst", "security/nss/lib/dev/devutil.c", "security/nss/lib/nss/nss.h", "security/nss/lib/pkcs7/certread.c", "security/nss/lib/pkcs7/p7decode.c", "security/nss/lib/softoken/pkcs11.c", "security/nss/lib/softoken/pkcs11u.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/sslsnce.c", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/utilmod.c"], "git_node": null, "git_parents": [null], "node": "7035f08a914efc2314e5818ecd857fbe6314567e", "parents": ["128064a519756d41c0773dc614e947e183f7f302"], "tags": []}], "date": 1737655322, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "380": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1932923 - Avoid external network requests in browser_google_behavior.js. a=test-only", "files": ["browser/components/search/test/browser/browser_google_behavior.js"], "git_node": null, "git_parents": [null], "node": "9f8f52c2e18777d7937bfc249f565e6cf64f2869", "parents": ["7035f08a914efc2314e5818ecd857fbe6314567e"], "tags": []}], "date": 1737663982, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "381": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1917177 - Remove image mime types from documment accept header  a=RyanVM\n\nThis aligns us with the fetch spec and Safari.\n\nThis patch also adds a pref to control whether supported image formats are also\npart of the document accept header - defaults to false.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221110\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235365", "files": ["devtools/client/netmonitor/test/browser_net_copy_headers.js", "modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/test/mochitests/test_accept_header.html"], "git_node": null, "git_parents": [null], "node": "a8ac30b797d5827a20d993c1460d3b404ef29304", "parents": ["9f8f52c2e18777d7937bfc249f565e6cf64f2869"], "tags": []}], "date": 1737681315, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "382": {"changesets": [{"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 1923208 - Store animation index into AnimationEventDispatcher.  a=RyanVM\n\nWe need this information when comparing the cancelled transitions/animations\nin the following patches.\n\nNote that we have to reorder the calling of `Animation::Cancel()` and\nthe update of `mAnimationIndex` to make sure we enqueue the cancel event\nwith the correct `mAnimationIndex`.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D227110\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235385", "files": ["dom/animation/AnimationEventDispatcher.h", "dom/animation/CSSAnimation.cpp", "dom/animation/CSSAnimation.h", "dom/animation/CSSTransition.cpp", "dom/animation/CSSTransition.h"], "git_node": null, "git_parents": [null], "node": "c0001ffdc69035e11146f4206263434e05e02cec", "parents": ["a8ac30b797d5827a20d993c1460d3b404ef29304"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 1923208 - Fallback to compare the order of event targets for CSSTransition if they have the same time.  a=RyanVM\n\nSince the cancelled transition has no owning element and its transition\ngeneration is out-of-date, so we have to compare the event targets and\nthe transition generations in `AnimationEventInfo`. We still follow the\ncomposite order defined in the spec but use the event target and transition\ngeneration before cancelling this transition, to get the correct event order\nif we have the same schedule time.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225117\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235386", "files": ["dom/animation/Animation.cpp", "dom/animation/Animation.h", "dom/animation/AnimationEventDispatcher.h", "dom/animation/CSSTransition.cpp", "dom/animation/CSSTransition.h", "testing/web-platform/tests/css/css-transitions/event-dispatch.tentative.html"], "git_node": null, "git_parents": [null], "node": "93f557e808d3d27c520e6bd60bb26cb776c6176e", "parents": ["c0001ffdc69035e11146f4206263434e05e02cec"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 1923208 - Set a proper schedule time for transitionrun.  a=RyanVM\n\nSee the testcase. If we replace a transition and flush it in the\nmeantime, after a timeout, we may fail to set a proper `mPendingReadyTime`\nfor the newly-created transition, because the refresh driver is not in\nrefresh when we call `Animation::EnsurePaintIsScheduled()` in\n`Animation::PlayNoUpdate()`. So we don't have a pending ready time and\nso we cannot trigger this transition at the current tick.\n\nTherefore, this newly-created transition would be triggered at the next tick.\nThe means it doesn't have `mStartTime` when we enqueued the transition event\ni.e. transitionrun, at the current tick. `zeroTimeStamp` would be null,\nand we fail to sort the events.\n\nIn this patch, we just assign a proper schedule time for transitionrun\nif `zeroTimeStamp` is null.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D226213\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235387", "files": ["dom/animation/CSSTransition.cpp", "testing/web-platform/tests/css/css-transitions/event-dispatch.tentative.html"], "git_node": null, "git_parents": [null], "node": "238c790933e4d94b7b9803829a4263ea56456d50", "parents": ["93f557e808d3d27c520e6bd60bb26cb776c6176e"], "tags": []}], "date": 1737681583, "git_changesets": [null, null, null], "user": "rvandermeulen@mozilla.com"}, "383": {"changesets": [{"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1895285 - Disable browser_check_identity_state.js on Windows MSIX. r=intermittent-reviewers,jmaher a=test-only DONTBUILD", "files": ["browser/base/content/test/siteIdentity/browser.toml"], "git_node": null, "git_parents": [null], "node": "7d9c770c2a0f24483e15a1d3a3500d53ee266b1a", "parents": ["238c790933e4d94b7b9803829a4263ea56456d50"], "tags": []}], "date": 1737682054, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "384": {"changesets": [{"author": "John Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1941994 - avoid deadlock in WinWebAuthnService GetAutoFillEntries.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D235082\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235348", "files": ["dom/webauthn/WinWebAuthnService.cpp"], "git_node": null, "git_parents": [null], "node": "531dfa2dbf1a93148c57af427c20e7eb2429471e", "parents": ["7d9c770c2a0f24483e15a1d3a3500d53ee266b1a"], "tags": []}], "date": 1737682308, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "385": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1943011 - If 'no-default-alpn' is not found, add 'http/1.1' to the list of records,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D235170\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235356", "files": ["netwerk/dns/HTTPSSVC.cpp", "netwerk/test/unit/test_http3_fast_fallback.js", "netwerk/test/unit/test_https_rr_ech_prefs.js", "netwerk/test/unit/test_trr_https_fallback.js"], "git_node": null, "git_parents": [null], "node": "0c6183497ae47025bb8d5753266f71584200957a", "parents": ["531dfa2dbf1a93148c57af427c20e7eb2429471e"], "tags": []}], "date": 1737682353, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "386": {"changesets": [{"author": "Narcis Beleuzu \u003cnbeleuzu@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 0c6183497ae4 (bug 1943011) for xpcshell failure on test_trr_https_fallback.js . a=backout", "files": ["netwerk/dns/HTTPSSVC.cpp", "netwerk/test/unit/test_http3_fast_fallback.js", "netwerk/test/unit/test_https_rr_ech_prefs.js", "netwerk/test/unit/test_trr_https_fallback.js"], "git_node": null, "git_parents": [null], "node": "7e212bad5834afd4d198a913be0fe6db9f5ab9ad", "parents": ["0c6183497ae47025bb8d5753266f71584200957a"], "tags": []}], "date": 1737688788, "git_changesets": [null], "user": "nbeleuzu@mozilla.com"}, "387": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1930514 - Go back to round inner sizes. r=dholbert, a=RyanVM\n\nTruncating them generally makes sense, but may be unexpected by some\nwebsites, and rounding consistently with other APIs like client* is\nprobably more important than showing useless scrollbars in some cases.\n\nI checked Chromium and it seems they round both client* / scroll* /\noffset* APIs, and inner{Width,Height} (though they seem to round exact\nhalf pixels down instead of up), so this should probably be safe.\n\nThis is tested already by\ntesting/web-platform/mozilla/tests/css/cssom/window_size_rounding.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228960", "files": ["dom/html/test/browser_ImageDocument_svg_zoom.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "3b34a180b51efae9851a66a9e2a8c02764cdc338", "parents": ["7e212bad5834afd4d198a913be0fe6db9f5ab9ad"], "tags": []}], "date": 1737724829, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "388": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1908682 - Exit early with success when decrypting an empty buffer with ClearKey.  a=RyanVM\n\nWithout the early exit, we allocate an empty std::vector which we may try to\naccess the first element on, leading to a crash.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D235309\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235406", "files": ["dom/media/eme/clearkey/ClearKeyDecryptionManager.cpp"], "git_node": null, "git_parents": [null], "node": "3ec8a758fbd44a462bf6a1f7ed43f0c36c89f86d", "parents": ["3b34a180b51efae9851a66a9e2a8c02764cdc338"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937978 - Exit early with success when decrypting an empty CBCS subsample buffer with ClearKey.  a=RyanVM\n\nWithout the early exit, DecryptCbcs() will try to get the address of the first\nelement in the subsample (Span), which with length 0 is forbidden.\n\nThis could also be solved by getting the address of the Span through data()\ninstead, to avoid dereferencing the first element. That seems more like a\nfootgun than the early exit however.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D235310\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235407", "files": ["dom/media/eme/clearkey/ClearKeyUtils.cpp"], "git_node": null, "git_parents": [null], "node": "6c46a2d745753c5ff496ca01f2e0c8b79f173880", "parents": ["3ec8a758fbd44a462bf6a1f7ed43f0c36c89f86d"], "tags": []}], "date": 1737724902, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "389": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1943011 - If 'no-default-alpn' is not found, add 'http/1.1' to the list of records,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D235170\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235356", "files": ["netwerk/dns/HTTPSSVC.cpp", "netwerk/test/unit/test_http3_fast_fallback.js", "netwerk/test/unit/test_https_rr_ech_prefs.js", "netwerk/test/unit/test_trr_https_fallback.js"], "git_node": null, "git_parents": [null], "node": "9238cfd153bc0b8e25c45fcbabd69a0b458b1f6f", "parents": ["6c46a2d745753c5ff496ca01f2e0c8b79f173880"], "tags": []}], "date": 1737733515, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "390": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1935471 - Make resolving image urls thread-safe. r=dshin, a=RyanVM\n\nWe can resolve them off the main thread now due to registered custom\nproperties (which requires the computed \u003curl\u003e serialization).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234959", "files": ["layout/style/ServoStyleConstsInlines.h", "layout/style/nsStyleStruct.cpp", "servo/ports/geckolib/cbindgen.toml"], "git_node": null, "git_parents": [null], "node": "141ec7cb351188fd2adca412efa970a60a6fd094", "parents": ["9238cfd153bc0b8e25c45fcbabd69a0b458b1f6f"], "tags": []}], "date": 1737737312, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "391": {"changesets": [{"author": "Micah Tigley \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937085 - Ensure about:logins is opened in non-popup browser window. r=credential-management-reviewers,issammani a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232145", "files": ["toolkit/components/passwordmgr/LoginHelper.sys.mjs"], "git_node": null, "git_parents": [null], "node": "34237f7f3a382361fa60cac3666df60c6f584aed", "parents": ["141ec7cb351188fd2adca412efa970a60a6fd094"], "tags": []}], "date": 1737753411, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "392": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 9238cfd153bc (bug 1943011) for causing bug 1943722.", "files": ["netwerk/dns/HTTPSSVC.cpp", "netwerk/test/unit/test_http3_fast_fallback.js", "netwerk/test/unit/test_https_rr_ech_prefs.js", "netwerk/test/unit/test_trr_https_fallback.js"], "git_node": null, "git_parents": [null], "node": "80030084f12fe66ec1ef6800ad552f71f0501596", "parents": ["34237f7f3a382361fa60cac3666df60c6f584aed"], "tags": []}], "date": 1737812341, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "393": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D235589", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "558fc9a8f44e8e16940eb2e0d680251aa64e3aa0", "parents": ["80030084f12fe66ec1ef6800ad552f71f0501596"], "tags": []}], "date": 1737982138, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "394": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1943650 - Command-line --help output misformatted after --dbus-service. r=emilio, a=RyanVM DONTBUILD", "files": ["toolkit/xre/nsAppRunner.cpp"], "git_node": null, "git_parents": [null], "node": "511bb195b833e379d8d534a90dc26e06b7b254e7", "parents": ["558fc9a8f44e8e16940eb2e0d680251aa64e3aa0"], "tags": []}], "date": 1737988031, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "395": {"changesets": [{"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907085 - Disable browser_pointerlock_popup.js on linux 18.04 !debug and macOS catalina for frequent failures. r=intermittent-reviewers,jmaher a=test-only", "files": ["dom/tests/browser/browser.toml"], "git_node": null, "git_parents": [null], "node": "b6dcac96f2ea4954b7d8d523967c8b3bff48e52c", "parents": ["511bb195b833e379d8d534a90dc26e06b7b254e7"], "tags": []}, {"author": "Goloman Adrian \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1890792 - disable browser_print_content_analysis.js for frequent failures on win11_2009. r=jmaher, a=test-only", "files": ["toolkit/components/contentanalysis/tests/browser/browser.toml"], "git_node": null, "git_parents": [null], "node": "f3783ad20bf40a11fb4b7ed088236c1a9f7be362", "parents": ["b6dcac96f2ea4954b7d8d523967c8b3bff48e52c"], "tags": ["FIREFOX_128_7_0esr_BUILD1", "FIREFOX_128_7_0esr_RELEASE"]}], "date": 1738005489, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}}
}";