"}, "351": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940804 - avoid some \"as\" casts in cert_storage  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D233775\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233880", "files": ["security/manager/ssl/cert_storage/src/lib.rs"], "git_node": null, "git_parents": [null], "node": "94b283c7793f6e4fac8a28e379c78a472fae83a2", "parents": ["eea825e9550cc6d6d95e1a130b4064eaf99c792a"], "tags": []}], "date": 1736561044, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "352": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1919344 - Add isEnterprise check to Services.policies.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222522\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233112", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_telemetry.js", "toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/nsIEnterprisePolicies.idl"], "git_node": null, "git_parents": [null], "node": "72d01708f497508e64af78809228d21b282d2295", "parents": ["94b283c7793f6e4fac8a28e379c78a472fae83a2"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1935003 - isEnterprise was supposed to be a boolean.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D231012\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233117", "files": ["toolkit/components/enterprisepolicies/nsIEnterprisePolicies.idl"], "git_node": null, "git_parents": [null], "node": "23b8e2c2818241818250ed73d8b20fe3ad5479fa", "parents": ["72d01708f497508e64af78809228d21b282d2295"], "tags": []}], "date": 1736561812, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "353": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1938548 - Handle CFF2 in UnscaledFontMac::GetFontFileData.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D232808\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232904", "files": ["gfx/2d/ScaledFontMac.cpp", "gfx/tests/crashtests/1938548.html", "gfx/tests/crashtests/WhiteOnBlack.otf", "gfx/tests/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "5f8c3b906b453f5cecab71b842bae653e42317f8", "parents": ["23b8e2c2818241818250ed73d8b20fe3ad5479fa"], "tags": []}], "date": 1736561897, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "354": {"changesets": [{"author": "Arkadiy Tetelman \u003carkadiyt@gmail.com\u003e", "branch": "default", "desc": "Bug 1939981 - Avoid skipping domains in DNR requestDomains/initiatorDomains.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D233223\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233484", "files": ["toolkit/components/extensions/ExtensionDNR.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_testMatchOutcome.js"], "git_node": null, "git_parents": [null], "node": "60cb647d82e87e7cab32068bce9e08952f46706d", "parents": ["5f8c3b906b453f5cecab71b842bae653e42317f8"], "tags": []}], "date": 1736562026, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "355": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1938389 - disable Content Analysis policies (for ESR) r=dlp-reviewers,handyman a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233557", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_content_analysis_policies.js"], "git_node": null, "git_parents": [null], "node": "8aa6f4b813e84717988fd2c4cded12bf488dbb1e", "parents": ["60cb647d82e87e7cab32068bce9e08952f46706d"], "tags": []}], "date": 1736562108, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "356": {"changesets": [{"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 94b283c7793f (bug 1940804) for causing build bustages a=backout", "files": ["security/manager/ssl/cert_storage/src/lib.rs"], "git_node": null, "git_parents": [null], "node": "9d507a026111de465ea2198b61e8e610cd64a6ae", "parents": ["8aa6f4b813e84717988fd2c4cded12bf488dbb1e"], "tags": []}], "date": 1736562339, "git_changesets": [null], "user": "amarc@mozilla.com"}, "357": {"changesets": [{"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940751 - [devtools] Adapt compatibility test for Safari update. r=devtools-reviewers,ochameau a=test-only\n\nSafari 18.2 added support for scrollbar-width and ruby-align,\nso we need to use other properties to make the test green.\nThis is a follow up for Bug 1940196, where we only fixed a single test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233672", "files": ["devtools/client/inspector/compatibility/test/browser/browser_compatibility_dynamic_js-attribute-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_dynamic_js-dom-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_dynamic_markup-dom-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_dynamic_ruleview-attribute-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_event_document-reload.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_event_rule-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_event_selected-node-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_event_top-level-target-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_issue-node.js"], "git_node": null, "git_parents": [null], "node": "9ae18a146984c0398f5a3d4813f96f4ef297e232", "parents": ["9d507a026111de465ea2198b61e8e610cd64a6ae"], "tags": []}], "date": 1736708833, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "358": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234004", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "c2fe3dd80e493387d1f266022f11b30a726f38d8", "parents": ["9ae18a146984c0398f5a3d4813f96f4ef297e232"], "tags": []}], "date": 1736824078, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "359": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940804 - avoid some \"as\" casts in cert_storage   a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D233775\n\nDifferential Revision: https://phabricator.services.mozilla.com/D233880", "files": ["security/manager/ssl/cert_storage/src/lib.rs"], "git_node": null, "git_parents": [null], "node": "ce91ea8a663d83b7d8ef34984b42d5261cbf36fd", "parents": ["c2fe3dd80e493387d1f266022f11b30a726f38d8"], "tags": []}], "date": 1736906401, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "360": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1873210 - Support langpacks in the crashreporter client  a=RyanVM\n\nThis passes the profile directory as a crash annotation (which is not\nsent in the crash report). The profile directory is already indirectly\npassed to the crash reporter through\n`MOZ_CRASHREPORTER_EVENTS_DIRECTORY`, however I don't think that's\nsomething to rely upon.\n\nThe pref parsing and langpack extension search are done on a best-effort\nbasis; there may be some odd configurations for which it does not\naccount. However, it should cover the vast majority of cases. While we\ndon't want to underserve niche populations that may have an odd\nconfiguration, we do always have fallback behaviors that are likely\nstill reasonable for most (like using the installation locale). We also\nfirst try the `useragent_locale` annotation before getting locales from\nthe prefs.\n\nThis only looks in the profile and the installation for langpack\nextensions. There are a few other system-wide locations that Firefox\nlooks in. However, the assumptions are:\n1) overwhelmingly users install langpacks using the UI rather than\n   manually downloading the file, and\n2) if installed with a package manager (mostly applicable to linux),\n   langpacks are put in the installation. This is the case for the few\n   major linux distros I checked.\n\nIf we think this is not enough, I can also add the system-wide\ndirectories.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222356\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234210", "files": ["Cargo.lock", "supply-chain/audits.toml", "third_party/rust/sys-locale/.cargo-checksum.json", "third_party/rust/sys-locale/CHANGELOG.md", "third_party/rust/sys-locale/Cargo.lock", "third_party/rust/sys-locale/Cargo.toml", "third_party/rust/sys-locale/LICENSE-APACHE", "third_party/rust/sys-locale/LICENSE-MIT", "third_party/rust/sys-locale/README.md", "third_party/rust/sys-locale/examples/get_locale.rs", "third_party/rust/sys-locale/src/android.rs", "third_party/rust/sys-locale/src/apple.rs", "third_party/rust/sys-locale/src/lib.rs", "third_party/rust/sys-locale/src/unix.rs", "third_party/rust/sys-locale/src/wasm.rs", "third_party/rust/sys-locale/src/windows.rs", "third_party/rust/sys-locale/src/windows_sys.rs", "third_party/rust/sys-locale/tests/wasm_worker.rs", "toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/client/app/Cargo.toml", "toolkit/crashreporter/client/app/src/config.rs", "toolkit/crashreporter/client/app/src/lang/langpack.rs", "toolkit/crashreporter/client/app/src/lang/mod.rs", "toolkit/crashreporter/client/app/src/lang/omnijar.rs", "toolkit/crashreporter/client/app/src/lang/zip.rs", "toolkit/crashreporter/client/app/src/logic.rs", "toolkit/crashreporter/client/app/src/main.rs", "toolkit/crashreporter/client/app/src/std/path.rs", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": null, "git_parents": [null], "node": "c56c9353b98a7131fa8b710f601047521acb2437", "parents": ["ce91ea8a663d83b7d8ef34984b42d5261cbf36fd"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1940763 - Load all available locales in the crash reporter client  a=RyanVM\n\nThis includes the embedded en-US locale. This way, no matter what\nhappens, we will only crash due to localization if we have a logic error\nlike not adding a localization string id to the fluent file.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D233760\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234211", "files": ["toolkit/crashreporter/client/app/src/config.rs", "toolkit/crashreporter/client/app/src/lang/language_info.rs", "toolkit/crashreporter/client/app/src/lang/mod.rs", "toolkit/crashreporter/client/app/src/lang/omnijar.rs", "toolkit/crashreporter/client/app/src/logic.rs", "toolkit/crashreporter/client/app/src/main.rs", "toolkit/crashreporter/client/app/src/test.rs"], "git_node": null, "git_parents": [null], "node": "615762c2e96c83037175b24858a7a08aff3298fd", "parents": ["c56c9353b98a7131fa8b710f601047521acb2437"], "tags": []}], "date": 1736910086, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "361": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914196 - Cherry-pick upstream libwebrtc commit d4a6c3f76f  a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d4a6c3f76fc3b187115d1cd65f4d1fffd7bebb7c\n       New macOS screen-capturer which uses ScreenCaptureKit.\n\n       This supports:\n       * Full-screen capture from any display, via SelectSource().\n       * Changing the display, via SelectSource(), while capture is running.\n       * Handling screen-resolution changes while capture is running.\n       * Capturing from high-DPI displays at their native resolution.\n       * Basic damage-tracking: the frame's updated-region is either set to\n         empty, or the full frame area.\n\n       It currently does not support:\n       * Window capture.\n       * Excluded windows.\n       * Full-desktop capture across all displays.\n       * More detailed damage-tracking.\n\n       The capturer is not yet enabled. Followup CLs will add a\n       DesktopCaptureOption to enable this capturer on supported versions of\n       macOS.\n\n       Bug: chromium:327458809\n       Change-Id: Ie619f6c6c1d6edf0fb9320d4fece578754a732dc\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/352544\n       Reviewed-by: Johannes Kron \u003ckron@webrtc.org\u003e\n       Reviewed-by: Alexander Cooper \u003calcooper@chromium.org\u003e\n       Commit-Queue: Lambros Lambrou \u003clambroslambrou@chromium.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#42510}\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219808\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232457", "files": ["third_party/libwebrtc/modules/desktop_capture/BUILD.gn", "third_party/libwebrtc/modules/desktop_capture/DEPS", "third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.h", "third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm", "third_party/libwebrtc/moz-patch-stack/d4a6c3f76f.no-op-cherry-pick-msg"], "git_node": null, "git_parents": [null], "node": "4d788f23380751169ace8ce4858462730a29a72e", "parents": ["615762c2e96c83037175b24858a7a08aff3298fd"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914196 - Cherry-pick upstream libwebrtc commit 3069c60ada  a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3069c60adafff3a40ec679c29f9e685f9ac59a45\n       Add desktop-capture option for ScreenCaptureKit on macOS.\n\n       This option will allow clients to control which ScreenCapturer is used,\n       for versions of macOS that support ScreenCaptureKit. The default is to\n       use the previous code, to avoid breaking current users of the module.\n\n       Bug: chromium:327458809\n       Change-Id: Ib0f9390c85d726016a39eea4fda9b8bd14a094c3\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/355020\n       Reviewed-by: Alexander Cooper \u003calcooper@chromium.org\u003e\n       Commit-Queue: Lambros Lambrou \u003clambroslambrou@chromium.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#42518}\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219809\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232458", "files": ["third_party/libwebrtc/modules/desktop_capture/desktop_capture_options.h", "third_party/libwebrtc/modules/desktop_capture/screen_capturer_darwin.mm", "third_party/libwebrtc/moz-patch-stack/3069c60ada.no-op-cherry-pick-msg"], "git_node": null, "git_parents": [null], "node": "bd8dc94f925adbdd628bf7b1587f6c78af6ec43b", "parents": ["4d788f23380751169ace8ce4858462730a29a72e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914196 - Cherry-pick upstream libwebrtc commit 2086ff5d33  a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/2086ff5d33facefe4624d65ad0d1e96c7b872f57\n       Mac SCK capturer: Set per-frame capture_time_ms and DPI values.\n\n       This sets the correct frame DPI according to the pixels/DIPs ratio.\n       It also sets the capture_time_ms for consistency with ScreenCapturerMac.\n\n       Bug: chromium:327458809\n       Change-Id: Ibb0074756e262dd1ce6f2897f60f0d939ddb7fd3\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/355442\n       Commit-Queue: Lambros Lambrou \u003clambroslambrou@chromium.org\u003e\n       Reviewed-by: Alexander Cooper \u003calcooper@chromium.org\u003e\n       Auto-Submit: Lambros Lambrou \u003clambroslambrou@chromium.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#42534}\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219810\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232459", "files": ["third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm", "third_party/libwebrtc/moz-patch-stack/2086ff5d33.no-op-cherry-pick-msg"], "git_node": null, "git_parents": [null], "node": "8f5c6a1f4c99cb0cb61e518b4613019b885dadbf", "parents": ["bd8dc94f925adbdd628bf7b1587f6c78af6ec43b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914196 - Cherry-pick upstream libwebrtc commit c2f0260894  a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c2f02608946e393367edf31bc7d4888c23002576\n       Restrict ScreenCaptureKit capturer to macOS 14+.\n\n       ScreenCapturerSCK uses some fields that were not available in macOS 13\n       but the code compiles with the older SDK because of missing annotations\n       that were added in the macOS 15 SDK.\n\n       Bug: chromium:351843815\n       Change-Id: Ic1a89b4cab43d6ee81d447ccc33ef94439752c45\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/356860\n       Reviewed-by: Alexander Cooper \u003calcooper@chromium.org\u003e\n       Commit-Queue: Lambros Lambrou \u003clambroslambrou@chromium.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#42624}\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219811\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232460", "files": ["third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm", "third_party/libwebrtc/moz-patch-stack/c2f0260894.no-op-cherry-pick-msg"], "git_node": null, "git_parents": [null], "node": "fc1c3cf40d9cad725cb3c76b058e314f11bc5990", "parents": ["8f5c6a1f4c99cb0cb61e518b4613019b885dadbf"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914196 - Generate webrtc moz.build files.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219812\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232461", "files": ["third_party/libwebrtc/modules/desktop_capture/desktop_capture_objc_gn/moz.build"], "git_node": null, "git_parents": [null], "node": "8026f28ce16f0ce7235ad9f8fc033d70be596e34", "parents": ["fc1c3cf40d9cad725cb3c76b058e314f11bc5990"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914196 - Build with ScreenCaptureKit on macOS.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219813\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232462", "files": ["toolkit/library/moz.build"], "git_node": null, "git_parents": [null], "node": "225bba7b2d79297cb4ddac3dba94563de3144ff0", "parents": ["8026f28ce16f0ce7235ad9f8fc033d70be596e34"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914196 - Simplify how prefs are set on DesktopCaptureOptions.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219814\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232463", "files": ["dom/media/systemservices/video_engine/desktop_capture_impl.cc"], "git_node": null, "git_parents": [null], "node": "3babf49d118282ba53bb43040c3fec11e7130374", "parents": ["225bba7b2d79297cb4ddac3dba94563de3144ff0"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914196 - Wire up a startup pref to enable the ScreenCaptureKit backend.  a=RyanVM\n\nIt is a startup pref since the source ids enumerated by a backend are usually\ntied to that backend, so we do not want to allow switching backend between\nenumeration and start of capture.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219815\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232464", "files": ["dom/media/systemservices/video_engine/desktop_capture_impl.cc", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "81f4756039b5e382831202f7747bae9965e32043", "parents": ["3babf49d118282ba53bb43040c3fec11e7130374"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914835 - With ScreenCaptureKit embed the mouse cursor directly.  a=RyanVM\n\nThe MouseCursorMonitor on macOS is rather expensive, as for every pulled frame\nit compares all pixels of the cursors used for the current and last frames.\nGetting to the pixels may also incur a conversion.\n\nNote that this comparison happens even if the backend reports it had embedded\nthe cursor already, as the embedding only affects composing the monitored cursor\ninto a captured frame.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220092\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232465", "files": ["dom/media/systemservices/video_engine/desktop_capture_impl.cc", "third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.h", "third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm"], "git_node": null, "git_parents": [null], "node": "571ecef0324ecf8c9403c3723f9fa905eac5f574", "parents": ["81f4756039b5e382831202f7747bae9965e32043"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915082 - From ScreenCapturerSck request frames in sRGB colorspace.  a=RyanVM\n\nThe desktop capture path has no colorspace handling for RGB, and libyuv assumes\nsRGB by default. ScreenCaptureKit returns frames in the display's colorspace\nunless told otherwise. On modern macs this is 'Display P3' and will render\ninaccurately when interpreted as sRGB.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220219\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232466", "files": ["third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm"], "git_node": null, "git_parents": [null], "node": "4f3a5790349463dc866f19927bf2312dcbb36e77", "parents": ["571ecef0324ecf8c9403c3723f9fa905eac5f574"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914837 - Simplify DesktopDeviceInfo and friends.  a=RyanVM\n\nThis removes a lot of duplicate code with some help from templates.\nIt also brings the code in DesktopDisplayDevice and DesktopTab into the realm of\nC++.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220264\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232467", "files": ["dom/media/systemservices/video_engine/desktop_capture_impl.cc", "dom/media/systemservices/video_engine/desktop_capture_impl.h", "dom/media/systemservices/video_engine/desktop_device_info.cc", "dom/media/systemservices/video_engine/desktop_device_info.h"], "git_node": null, "git_parents": [null], "node": "428e89f77864a17f99cd933e397721dbbe302f95", "parents": ["4f3a5790349463dc866f19927bf2312dcbb36e77"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914837 - Always initialize DesktopCapturer::pid.  a=RyanVM\n\nThis member is patched on top of libwebrtc. New backends could be added from\nunder us. It needs to be initialized.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220265\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232468", "files": ["third_party/libwebrtc/modules/desktop_capture/desktop_capturer.h"], "git_node": null, "git_parents": [null], "node": "8d958288c13b4c3e3c6fe54debb01d50f0274845", "parents": ["428e89f77864a17f99cd933e397721dbbe302f95"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915562 - For the SCK backend, Add a pref to allow enumerating displays with the CG backend.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220565\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232469", "files": ["dom/media/systemservices/video_engine/desktop_capture_impl.cc", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "22f8d7e70badbdd71571c86cc7f32e9292f5a613", "parents": ["8d958288c13b4c3e3c6fe54debb01d50f0274845"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915562 - Enable ScreenCaptureKit backend for screen sharing.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220566\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232470", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "7d125843601cb3ec847aef41aa8e53a1f44d2f38", "parents": ["22f8d7e70badbdd71571c86cc7f32e9292f5a613"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - Integrate SCContentSharingPicker into ScreenCapturerSck.  a=RyanVM\n\nThis works by creating ScreenCapturerSck with a sck_allow_system_picker\nDesktopCaptureOptions flag.\n\nThe flow is similar to the Pipewire capturer in that SelectSource has no effect.\nStart() brings up the system picker, and:\n- automatically starts capture on selection, also reconfigures on future\n  selection changes.\n- signals a stop by setting the permanent error flag on cancel or error.\n\nThe system picker is configured for both single display and multiple windows to\ngive users as much power over what they share as possible. There is an\napplication mode also, but other browsers are not allowing access to that as of\nnow.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221851\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232471", "files": ["third_party/libwebrtc/modules/desktop_capture/BUILD.gn", "third_party/libwebrtc/modules/desktop_capture/desktop_capture_options.h", "third_party/libwebrtc/modules/desktop_capture/desktop_capturer.cc", "third_party/libwebrtc/modules/desktop_capture/mac/sck_picker_handle.h", "third_party/libwebrtc/modules/desktop_capture/mac/sck_picker_handle.mm", "third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.h", "third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm"], "git_node": null, "git_parents": [null], "node": "763672311790a0955ceef52cc7694ce73ad8ada3", "parents": ["7d125843601cb3ec847aef41aa8e53a1f44d2f38"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - Generate libwebrtc moz.build files.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221852\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232472", "files": ["third_party/libwebrtc/modules/desktop_capture/desktop_capture_objc_gn/moz.build"], "git_node": null, "git_parents": [null], "node": "7137a430a3e21165be405c5d6407bf2d47cc2f0d", "parents": ["763672311790a0955ceef52cc7694ce73ad8ada3"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - Wire up SCContentSharingPicker using Pipewire desktop capture UX.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221853\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232473", "files": ["dom/media/systemservices/video_engine/desktop_capture_impl.cc", "dom/media/systemservices/video_engine/desktop_device_info.cc", "dom/media/webrtc/MediaEngineWebRTC.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "f3041571a5af866117d43b4672363fe71e066418", "parents": ["7137a430a3e21165be405c5d6407bf2d47cc2f0d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - Reject gUM/gDM request if video track ends before first frame.  a=RyanVM\n\nThis case gets hit if the SCContentSharingPicker is cancelled by the user.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221854\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232474", "files": ["dom/media/MediaManager.cpp", "dom/media/webrtc/MediaEngineRemoteVideoSource.cpp"], "git_node": null, "git_parents": [null], "node": "c363120c7250295fb047e3c2110e5785b0118dec", "parents": ["f3041571a5af866117d43b4672363fe71e066418"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - In ScreenCapturerSck improve dictionary ergonomics.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221940\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232476", "files": ["third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm"], "git_node": null, "git_parents": [null], "node": "627e494ce7d19fc5e5f356b2b08b1e46fa15ea6b", "parents": ["c363120c7250295fb047e3c2110e5785b0118dec"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - In ScreenCapturerSck adapt to sources that change resolution.  a=RyanVM\n\nIf the resolution is smaller than the allocated surface, we crop.\nIf the resolution is larger than the allocated surface, we reconfigure with a\nlarger surface.\n\nThe allocated surface has the size we told it to have in the\nSCStreamConfiguration, in pixels.\n\nIf the source is a screen, the size is pretty static. Changing display settings\n  could affect it.\nIf the source is a window, the size is initially the size of the window. The\n  user resizing the window affects the size.\nIf the source is multiple windows, the size initially seems to be that of the\n  display they're sitting on. Windows across multiple displays are not captured\n  into the same surface, as of macOS 14.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221941\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232477", "files": ["third_party/libwebrtc/modules/desktop_capture/mac/desktop_frame_iosurface.h", "third_party/libwebrtc/modules/desktop_capture/mac/desktop_frame_iosurface.mm", "third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm"], "git_node": null, "git_parents": [null], "node": "9dcc048d54bbca6aca789be1eb31fdff9bbacfb8", "parents": ["627e494ce7d19fc5e5f356b2b08b1e46fa15ea6b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - In ScreenCapturerSck skip some processing when possible.  a=RyanVM\n\nNo need to update the last frame unless it has changed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221942\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232478", "files": ["third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm"], "git_node": null, "git_parents": [null], "node": "19419915bd0c55d18fa4edce798e1224503e3ace", "parents": ["9dcc048d54bbca6aca789be1eb31fdff9bbacfb8"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - Make SckPickerHandle thread safe.  a=RyanVM\n\nWe cannot guarantee that the thread it is used on is static, as both the\nVideoCapture and DesktopCapture threads can come and go.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222082\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232479", "files": ["third_party/libwebrtc/modules/desktop_capture/mac/sck_picker_handle.mm"], "git_node": null, "git_parents": [null], "node": "438abd29c80131e82d038c9e6c1b99ad7bebd074", "parents": ["19419915bd0c55d18fa4edce798e1224503e3ace"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918096 - Enable SCContentSharingPicker by default (limited to macOS 15).  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221997\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232480", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "3aa7437729f572faf949b34e8b5dd59b6e349028", "parents": ["438abd29c80131e82d038c9e6c1b99ad7bebd074"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918996 - Use SCShareableContentStyleNone on macOS 15.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222270\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232481", "files": ["third_party/libwebrtc/modules/desktop_capture/mac/screen_capturer_sck.mm"], "git_node": null, "git_parents": [null], "node": "a4eccffe956962b4a644750862a2d5bac78f85ac", "parents": ["3aa7437729f572faf949b34e8b5dd59b6e349028"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918746 - Don't stop video capturers before reconfiguring them.  a=RyanVM\n\nAlready today we reconfigure capturers without stopping them in cases where they\nare shared between multiple gUM/gDM requests: We find the device capability\n(for cameras) that satisfies all the requested capabilities (downscaling, frame\ndropping allowed) and call StartCapture again with that.\n\nThus, there is no concern about camera backends not supporting this call\nsequence.\n\nDesktop capture backends have a simpler API (only Start, for Stop they have to\nbe destroyed) and are not actually re-started. Resolution is always captured in\nfull and frame rate is controlled by the timer that triggers CaptureFrame().\n\nThis patch makes content processes not request capture to be stopped when\nupdating their requested capability. This means the path described above will be\nexercised more. This also brings with it some invariants that no longer hold,\nbut are handled explicitly instead: capabilities for a captureId may now be\nupdated on the fly, without prior removal.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222242\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232482", "files": ["dom/media/systemservices/CamerasParent.cpp", "dom/media/systemservices/video_engine/desktop_capture_impl.cc", "dom/media/systemservices/video_engine/desktop_capture_impl.h", "dom/media/webrtc/MediaEngineRemoteVideoSource.cpp"], "git_node": null, "git_parents": [null], "node": "8ad6e7cb391cc1940aa38d2944f6bde1ada50831", "parents": ["a4eccffe956962b4a644750862a2d5bac78f85ac"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1920264 - Don't key CamerasChild callbacks on CaptureEngine.  a=RyanVM\n\nCapture id is already unique.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223970\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232483", "files": ["dom/media/systemservices/CamerasChild.cpp", "dom/media/systemservices/CamerasChild.h", "dom/media/systemservices/CamerasParent.cpp", "dom/media/systemservices/PCameras.ipdl"], "git_node": null, "git_parents": [null], "node": "9195ca2f9019c16411ea4d1477208d123f464e26", "parents": ["8ad6e7cb391cc1940aa38d2944f6bde1ada50831"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1920264 - Add crashtest. r=jmaher a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D224560\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232484", "files": ["dom/media/tests/crashtests/1920264.html", "dom/media/tests/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "83f0771183780ee89c353a853dd247ae0d8d5d19", "parents": ["9195ca2f9019c16411ea4d1477208d123f464e26"], "tags": []}], "date": 1736948527, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "rvandermeulen@mozilla.com"}, "362": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1932263 - Support persistent listeners in notifications API  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D232859\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232944", "files": ["toolkit/components/extensions/parent/ext-notifications.js", "toolkit/components/extensions/test/mochitest/test_ext_notifications.html"], "git_node": null, "git_parents": [null], "node": "b3cb8a82c80952be6371dba480bfa784d369cc20", "parents": ["83f0771183780ee89c353a853dd247ae0d8d5d19"], "tags": []}], "date": 1736957113, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "363": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D234482", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/St