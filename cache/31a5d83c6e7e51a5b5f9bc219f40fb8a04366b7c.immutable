e existing\none.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D93654", "files": ["xpcom/ds/nsTArray-inl.h"], "git_node": null, "git_parents": [null], "node": "8faa3462b5b16663766b876c5bfc5a4b3a1d7c56", "parents": ["d643964ea42f1f6c8fc3a0168c348128c34b11f4"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1670358 - Add test for shrinking nsTArrays of JS::Heap\u003cT\u003e. r=sg, a=tjr\n\nDepends on D93654\n\nDifferential Revision: https://phabricator.services.mozilla.com/D94270", "files": ["xpcom/tests/gtest/TestGCPostBarriers.cpp"], "git_node": null, "git_parents": [null], "node": "41b1626448a6b34b952fe4c27df58593ffe42843", "parents": ["8faa3462b5b16663766b876c5bfc5a4b3a1d7c56"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1607762 - Make the refcount of nsHtml5OwningUTF16Buffer atomic. r=mccr8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D92936", "files": ["parser/html/nsHtml5OwningUTF16Buffer.h"], "git_node": null, "git_parents": [null], "node": "5aa243a2fe9d77578dd95ce3ab3a2aa6c1e92604", "parents": ["41b1626448a6b34b952fe4c27df58593ffe42843"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1663715 - Update syn and proc-macro2 so that Firefox can build on Rust nightly again. r=froydnj, a=RyanVM\n\nGenerated with:\n\n  cargo update -p syn --precise 1.0.40\n  ./mach vendor rust\n\nRust issue: https://github.com/rust-lang/rust/issues/76482\n\nDifferential Revision: https://phabricator.services.mozilla.com/D89473", "files": ["Cargo.lock", "third_party/rust/proc-macro2/.cargo-checksum.json", "third_party/rust/proc-macro2/Cargo.toml", "third_party/rust/proc-macro2/README.md", "third_party/rust/proc-macro2/build.rs", "third_party/rust/proc-macro2/src/detection.rs", "third_party/rust/proc-macro2/src/fallback.rs", "third_party/rus