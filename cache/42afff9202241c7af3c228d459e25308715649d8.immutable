65418"], "user": "dsmith@mozilla.com"}, "738": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2067819 - Validate policy URLs with the URL parser.  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330830\n", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_PolicySchemaValidator.js", "toolkit/components/enterprisepolicies/PolicySchemaValidator.sys.mjs", "toolkit/modules/JsonSchema.sys.mjs", "toolkit/modules/tests/xpcshell/test_JsonSchema.js"], "git_node": "760d4b404a49bcf095e8128de85d9e84c6de5e64", "git_parents": ["41dfcc8534266cdef746b6edcd6232c4d8265418"], "node": "2edfe45b11b43e1f9fac6e597c09a855d81de5c4", "parents": ["053c1a3989a3f0dffb670959d2f48041f07d4030"], "tags": []}], "date": 1791225468, "git_changesets": ["760d4b404a49bcf095e8128de85d9e84c6de5e64"], "user": "dsmith@mozilla.com"}, "739": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073596 - Lock remote.policy.disabled with DisableDeveloperTools.  a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330809\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_developer_tools.js", "browser/components/enterprisepolicies/tests/browser/disable_developer_tools/browser.toml", "browser/components/enterprisepolicies/tests/browser/disable_developer_tools/browser_policy_disable_developer_tools.js", "browser/components/enterprisepolicies/tests/browser/disable_developer_tools/config_disable_developer_tools.json", "browser/components/enterprisepolicies/tests/moz.build", "remote/components/Marionette.sys.mjs", "remote/components/RemoteAgent.sys.mjs", "remote/components/moz.build", "remote/components/test/xpcshell/test_policy_disabled.js", "remote/components/test/xpcshell/xpcshell.toml"], "git_node": "b3fc4c740f16cd36e7ebf2c99b6d0c6b9cad342f", "git_parents": ["760d4b404a49bcf095e8128de85d9e84c6de5e64"], "node": "504ddf72e4a57a9329bd7c1397e78f76a538019f", "parents": ["2edfe45b11b43e1f9fac6e597c09a855d81de5c4"], "tags": []}], "date": 1791225490, "git_changesets": ["b3fc4c740f16cd36e7ebf2c99b6d0c6b9cad342f"], "user": "dsmith@mozilla.com"}, "740": {"changesets": [{"author": "Haik Aftandilian \u003chafta@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2057036 - hdiutil deprecation warnings break macOS 27 artifact builds  a=diannaS DONTBUILD\n\nOn macOS 27, \"hdiutil attach\" commands print deprecation warnings on\nstderr breaking artifact build scripting. Replace the use of the hdiutil attach\ncommand with the newer diskutil command.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313618\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330792\n", "files": ["testing/mozbase/mozinstall/mozinstall/mozinstall.py"], "git_node": "2a8ddf580b59246f8fbc43ae769a825c75ffca5a", "git_parents": ["b3fc4c740f16cd36e7ebf2c99b6d0c6b9cad342f"], "node": "7f66e6f7396886478cce6656e397f7a95fe83076", "parents": ["504ddf72e4a57a9329bd7c1397e78f76a538019f"], "tags": []}], "date": 1791225532, "git_changesets": ["2a8ddf580b59246f8fbc43ae769a825c75ffca5a"], "user": "dsmith@mozilla.com"}, "741": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2074193 - [esr153] HTMLOptionsCollection could use similar setup to SetAttr when it comes to script blockers, r=farre a=diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330612\n", "files": ["dom/html/HTMLOptionElement.cpp", "dom/html/HTMLOptionsCollection.cpp", "dom/html/HTMLSelectElement.cpp", "dom/prototype/PrototypeDocumentContentSink.cpp", "dom/xml/nsXMLContentSink.cpp", "dom/xslt/xslt/txMozillaXMLOutput.cpp", "layout/forms/nsListControlFrame.cpp"], "git_node": "715a420d7a80a1f507ca3420a0d8c03ac4277887", "git_parents": ["2a8ddf580b59246f8fbc43ae769a825c75ffca5a"], "node": "dda7a485422cc962421591369016e8df4ba09522", "parents": ["7f66e6f7396886478cce6656e397f7a95fe83076"], "tags": []}], "date": 1791225844, "git_changesets": ["715a420d7a80a1f507ca3420a0d8c03ac4277887"], "user": "dsmith@mozilla.com"}, "742": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074654 - Apply WebsiteFilter to object and embed loads.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328514\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330877\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js"], "git_node": "6e38da7938830edd3572cf6d9aa5703387fe7c49", "git_parents": ["715a420d7a80a1f507ca3420a0d8c03ac4277887"], "node": "86cf636b2a62ee050b61473c36a4f73b568eb3fc", "parents": ["dda7a485422cc962421591369016e8df4ba09522"], "tags": []}], "date": 1791230020, "git_changesets": ["6e38da7938830edd3572cf6d9aa5703387fe7c49"], "user": "dsmith@mozilla.com"}, "743": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1632281 - Read the AutoConfig input prefs from the installation, not the profile.  a=diannaS DONTBUILD\n\nThe AutoConfig inputs are administrator settings, so nsReadConfig clears their\nuser values before evaluating the .cfg: a profile's prefs.js or user.js no\nlonger decides which file nsAutoConfig fetches or whether the vendor check\npasses. The .cfg can still set them with pref().\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327889\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330894\n", "files": ["extensions/pref/autoconfig/src/nsReadConfig.cpp", "extensions/pref/autoconfig/test/unit/autoconfig-admin-pref.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-admin-url-pref.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-admin.cfg", "extensions/pref/autoconfig/test/unit/autoconfig-remote.jsc", "extensions/pref/autoconfig/test/unit/test_autoconfig_profile_prefs.js", "extensions/pref/autoconfig/test/unit/xpcshell.toml"], "git_node": "621f818eb37816d2c37dd140d9f8462038ec8f42", "git_parents": ["6e38da7938830edd3572cf6d9aa5703387fe7c49"], "node": "dd6af879244be27a2c36282d239886745e4b535d", "parents": ["86cf636b2a62ee050b61473c36a4f73b568eb3fc"], "tags": []}], "date": 1791232214, "git_changesets": ["621f818eb37816d2c37dd140d9f8462038ec8f42"], "user": "dsmith@mozilla.com"}, "744": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077980 - Don't throw an error when setting nsIFilePicker.displayDirectory to a non-readable directory;  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330619\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330749\n", "files": ["widget/nsBaseFilePicker.cpp"], "git_node": "99cb60dab74dd3722705abd6cfb5680d7f1811fe", "git_parents": ["621f818eb37816d2c37dd140d9f8462038ec8f42"], "node": "884a6ef56d8ca1d0e9c845410a0553d6ae99e984", "parents": ["dd6af879244be27a2c36282d239886745e4b535d"], "tags": []}], "date": 1791232647, "git_changesets": ["99cb60dab74dd3722705abd6cfb5680d7f1811fe"], "user": "dsmith@mozilla.com"}, "745": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074632: Invalidate Ion when a pure DOM call reallocates the global's slots  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329341\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330463\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/CodeGenerator.h", "js/src/jit/Ion.cpp", "js/src/jit/JitRuntime.h", "js/src/vm/Interpreter.cpp", "js/src/vm/NativeObject.cpp"], "git_node": "e3b346d28b33c97f3530001eac30fd80e5bdefb4", "git_parents": ["99cb60dab74dd3722705abd6cfb5680d7f1811fe"], "node": "3f059e15306859fa5964ffaae0f210e69f590e09", "parents": ["884a6ef56d8ca1d0e9c845410a0553d6ae99e984"], "tags": []}], "date": 1791235325, "git_changesets": ["e3b346d28b33c97f3530001eac30fd80e5bdefb4"], "user": "dsmith@mozilla.com"}, "746": {"changesets": [{"author": "Chris DuPuis \u003ccdupuis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037979 - Improve logging of updater invocation scenarios  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321713\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330927\n", "files": ["toolkit/components/maintenanceservice/workmonitor.cpp", "toolkit/mozapps/update/UpdateService.sys.mjs", "toolkit/mozapps/update/common/elevation_type.cpp", "toolkit/mozapps/update/common/elevation_type.h", "toolkit/mozapps/update/common/moz.build", "toolkit/mozapps/update/common/updatecommon.cpp", "toolkit/mozapps/update/common/updatecommon.h", "toolkit/mozapps/update/common/updater_invocation.cpp", "toolkit/mozapps/update/common/updater_invocation.h", "toolkit/mozapps/update/tests/gtest/ElevationTypeTests.cpp", "toolkit/mozapps/update/tests/gtest/README.md", "toolkit/mozapps/update/tests/gtest/moz.build", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "70f319b16a91d82835d1529606665c4b08d8899e", "git_parents": ["e3b346d28b33c97f3530001eac30fd80e5bdefb4"], "node": "d66a3094dacf96390ae4fe77f47232bfc1177cdd", "parents": ["3f059e15306859fa5964ffaae0f210e69f590e09"], "tags": []}], "date": 1791237363, "git_changesets": ["70f319b16a91d82835d1529606665c4b08d8899e"], "user": "dsmith@mozilla.com"}, "747": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069910: Have nsHttpTransaction read a clone of the upload stream  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329334\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": "84adae9e466f315e7a3c005d388ad4d2177d2db5", "git_parents": ["70f319b16a91d82835d1529606665c4b08d8899e"], "node": "019bd9e7a6e4fd7025fc6d529452a293674213a7", "parents": ["d66a3094dacf96390ae4fe77f47232bfc1177cdd"], "tags": []}], "date": 1791252065, "git_changesets": ["84adae9e466f315e7a3c005d388ad4d2177d2db5"], "user": "dsmith@mozilla.com"}, "748": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072852 - [ots] Reject CFF fonts where a charstring tries to execute an excessive number of operations.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327310\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331072\n", "files": ["gfx/ots/moz.yaml", "gfx/ots/ots-cff-charstring-ops-limit.patch", "gfx/ots/src/cff_charstring.cc", "gfx/ots/src/cff_charstring.h"], "git_node": "a0aaff19e55cce85f64ae9de5a1a9dd95ab30bcc", "git_parents": ["84adae9e466f315e7a3c005d388ad4d2177d2db5"], "node": "c0d76bc664edd4699c20c92d1c501f66c0113a9b", "parents": ["019bd9e7a6e4fd7025fc6d529452a293674213a7"], "tags": []}], "date": 1791288891, "git_changesets": ["a0aaff19e55cce85f64ae9de5a1a9dd95ab30bcc"], "user": "dsmith@mozilla.com"}, "749": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067761 - Disable custom select colors for color: transparent.  a=diannaS DONTBUILD\n\nMuch like for background images, if you're messing with the color\nproperty like that we can't guarantee contrast.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323228\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331163\n", "files": ["browser/base/content/test/forms/browser_selectpopup_colors.js", "toolkit/actors/SelectChild.sys.mjs"], "git_node": "d1bcecb8ff33397e5703c8b1cd927587010759ff", "git_parents": ["a0aaff19e55cce85f64ae9de5a1a9dd95ab30bcc"], "node": "d915fd9b6661bccd8b36642e0c61670aae58ea0a", "parents": ["c0d76bc664edd4699c20c92d1c501f66c0113a9b"], "tags": []}], "date": 1791293477, "git_changesets": ["d1bcecb8ff33397e5703c8b1cd927587010759ff"], "user": "dsmith@mozilla.com"}, "750": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063653 - Add a null check for mConnection in nsHttpTransaction::HandleContentStart  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324590\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331032\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": "3149ff85ae9c38f5721b04cd018c8d4e1928acfe", "git_parents": ["d1bcecb8ff33397e5703c8b1cd927587010759ff"], "node": "7aa02bb1ff50d46dffd009a627d7d1d6985c322c", "parents": ["d915fd9b6661bccd8b36642e0c61670aae58ea0a"], "tags": []}], "date": 1791296404, "git_changesets": ["3149ff85ae9c38f5721b04cd018c8d4e1928acfe"], "user": "dsmith@mozilla.com"}, "751": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061691: When validating ranges in DocAccessibleParent::SelectionRanges, check that the start and end accs are HyperTextAccessibles.  a=diannaS DONTBUILD\n\nAs noted in the comment in this method, tree and selection updates happen in separate IPDL calls, so it's possible for a client selection query to arrive between them.\nWe work around this by validating the Accessibles and offsets.\nPreviously, we null checked the Accessibles.\nHowever, it's possible (albeit rare) that the same id is reused immediately when an Accessible is destroyed and another one is created.\nIn this case, the id might now be associated with an Accessible that is not a HyperTextAccessible, thus causing a null deref in TextRange::Crop.\nTo fix this, we now check IsHyperText() as well when validating selection ranges.\n\nA cleaner fix would be to remove any selection range that contains an Accessible that is being removed from the RemoteAccessible cache.\nHowever, I worry iterating selection ranges on every single removal could get expensive, especially in the (admittedly rare) case that there are a lot of noncontiguous selection ranges.\nYet another alternative could be to somehow process selection range changes atomically with tree mutations, but I think this would be quite difficult to get right and would likely be plagued by obscure edge cases.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325785\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330973\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "44dd857cbc5458c1982619ab36b8b98edfce00e1", "git_parents": ["3149ff85ae9c38f5721b04cd018c8d4e1928acfe"], "node": "e6b65db1f0de9b528be11c8c313a3bc60904ceff", "parents": ["7aa02bb1ff50d46dffd009a627d7d1d6985c322c"], "tags": []}], "date": 1791296446, "git_changesets": ["44dd857cbc5458c1982619ab36b8b98edfce00e1"], "user": "dsmith@mozilla.com"}, "752": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073647;  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329143\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330899\n", "files": ["dom/media/webcodecs/AudioData.cpp", "dom/media/webcodecs/EncodedAudioChunk.cpp", "dom/media/webcodecs/ImageDecoder.cpp"], "git_node": "b47a42c460beb214e0dcdb337b9634ee67229da4", "git_parents": ["44dd857cbc5458c1982619ab36b8b98edfce00e1"], "node": "ede184bfc1b44f1a39f39bf5d8bc0bf4801ac084", "parents": ["e6b65db1f0de9b528be11c8c313a3bc60904ceff"], "tags": []}], "date": 1791296470, "git_changesets": ["b47a42c460beb214e0dcdb337b9634ee67229da4"], "user": "dsmith@mozilla.com"}, "753": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068854 - switch back from ftpmirror to ftp.gnu.org for toolchain fetches, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323163\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "223014c6b9299ac9b035b4c50ea481e5c6de282c", "git_parents": ["b47a42c460beb214e0dcdb337b9634ee67229da4"], "node": "3806652efdaccfd958d04803eddd3fdf131cd0cd", "parents": ["ede184bfc1b44f1a39f39bf5d8bc0bf4801ac084"], "tags": ["FIREFOX_153_5_0esr_BUILD1", "FIREFOX_153_5_0esr_RELEASE"]}], "date": 1791306269, "git_changesets": ["223014c6b9299ac9b035b4c50ea481e5c6de282c"], "user": "dsmith@mozilla.com"}}
}";