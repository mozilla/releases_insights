s:158690:"{
"lastpushid": 956,
"pushes": {"641": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 365ff2bc5b79267ca93cfdbbc1d07af5e2bbd120 with FIREFOX_115_42_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "0d5f523f35d0c9330c539ee57542aba1ba7263b9", "git_parents": ["158e5076b88609556edd6cbe5580a1d3062d7b01"], "node": "c73ed037d82565b4b9449f9272591256b0cd6d50", "parents": ["c852acf37d964d2bd28a222fbb9982ed0c600649"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging ec9c1cc8a5cb6fac9d4d17e4f141fb42a8089b4c with FIREFOX_153_4_0esr_BUILD3 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "3bf7af2a00ac114428623372176845e6e561bc93", "git_parents": ["0d5f523f35d0c9330c539ee57542aba1ba7263b9"], "node": "e9e0b5b3097fa799aff16b9a8aadfa2bfeb16918", "parents": ["c73ed037d82565b4b9449f9272591256b0cd6d50"], "tags": []}], "date": 1790156049, "git_changesets": ["0d5f523f35d0c9330c539ee57542aba1ba7263b9", "3bf7af2a00ac114428623372176845e6e561bc93"], "user": "ffxbld@lando.moz.tools"}, "642": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "03ddb419ef5dccd528c6418988997673d3f24a2f", "git_parents": ["508788b6f8314edb3c33905f6d56c3fe6b087670"], "node": "f1f6c6efd3a500c58bf16be3d6c871f21e1f8361", "parents": ["ec9c1cc8a5cb6fac9d4d17e4f141fb42a8089b4c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER"], "git_node": "effb626ff45cbaa0bd3a4bbabc66fe2eb2380338", "git_parents": ["03ddb419ef5dccd528c6418988997673d3f24a2f"], "node": "e17580f1f875cf8d6a54b1fdc2fa44f293e04d5f", "parents": ["f1f6c6efd3a500c58bf16be3d6c871f21e1f8361"], "tags": []}], "date": 1790262281, "git_changesets": ["03ddb419ef5dccd528c6418988997673d3f24a2f", "effb626ff45cbaa0bd3a4bbabc66fe2eb2380338"], "user": "ffxbld@lando.moz.tools"}, "643": {"changesets": [{"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075120 - Bump rumdl to 0.1.96 since 0.1.91 is no longer on PyPI r=dao, a=dsmith DONTBUILD\n\nrumdl 0.1.91 was removed from PyPI upstream, so the lint and python-test\nvirtualenvs can no longer be created. 0.1.96 is the nearest published\nrelease and reports no new errors in-tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328750\n", "files": ["python/sites/lint.txt", "python/sites/python-test.txt"], "git_node": "e51b0419aa86516fa38b2effcbd136afe033aa28", "git_parents": ["effb626ff45cbaa0bd3a4bbabc66fe2eb2380338"], "node": "55abaaa63c0a38daff53fc8f2b3db9191db14956", "parents": ["e17580f1f875cf8d6a54b1fdc2fa44f293e04d5f"], "tags": []}], "date": 1790273366, "git_changesets": ["e51b0419aa86516fa38b2effcbd136afe033aa28"], "user": "dsmith@mozilla.com"}, "644": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049748 - Include the InstallTime annotation in crash pings  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328027\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/src/lib.rs"], "git_node": "e387db936e2ca1b734b43c13f8973578524f0dbd", "git_parents": ["e51b0419aa86516fa38b2effcbd136afe033aa28"], "node": "428b2cb8db88b4af24560d3c070a9c7c55bbc668", "parents": ["55abaaa63c0a38daff53fc8f2b3db9191db14956"], "tags": []}], "date": 1790275092, "git_changesets": ["e387db936e2ca1b734b43c13f8973578524f0dbd"], "user": "dsmith@mozilla.com"}, "645": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049744 p1 - Add meta.annotations metric  a=diannaS DONTBUILD\n\nThis metric contains the source JSON document unaltered, aside from\nfiltering to only the ping-scoped annotations. We don't define the\nexpected schema within the Glean metric because the object property\nnames are altered in the generated Rust code (see bug 1929903).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313284\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328041\n", "files": ["toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/glean_metrics.py", "toolkit/crashreporter/crashping/static_metrics.yaml"], "git_node": "3249454b049afcbef670f83eeeccfa2dffadb89a", "git_parents": ["e387db936e2ca1b734b43c13f8973578524f0dbd"], "node": "126fe3f347946bf2c4563fe2391600acb2c76251", "parents": ["428b2cb8db88b4af24560d3c070a9c7c55bbc668"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049744 p2 - Set meta.annotations metric  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313286\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328042\n", "files": ["toolkit/crashreporter/crashping/src/lib.rs"], "git_node": "c0d2dc03daadf36db118c567ee4691d66e407bda", "git_parents": ["3249454b049afcbef670f83eeeccfa2dffadb89a"], "node": "fd4be31712075b47402729fd441d4a9c1fe66824", "parents": ["126fe3f347946bf2c4563fe2391600acb2c76251"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073234 - Remove the exception message from JavaException annotations in crash pings  a=diannaS DONTBUILD\n\nTo be honest, this feels a bit wrong (I'd prefer any annotations we send\nin a ping to be identical to their counterparts in a report), but we can\nrevisit that later (it would either involve splitting the annotation or\nmaking another which is almost the same, but without the exception\nmessages).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327154\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328043\n", "files": ["mobile/android/android-components/components/lib/crash/src/androidTest/java/mozilla/components/lib/crash/service/GleanCrashReporterServiceTest.kt", "toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/conversions.py", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/src/annotations.rs", "toolkit/crashreporter/crashping/src/lib.rs"], "git_node": "9c7dc00a3f73496b80d1a1dad9b54d51f3fc2940", "git_parents": ["c0d2dc03daadf36db118c567ee4691d66e407bda"], "node": "09e350e8b5da2a0e4e20e9bd1a4ea10902a40862", "parents": ["fd4be31712075b47402729fd441d4a9c1fe66824"], "tags": []}], "date": 1790275519, "git_changesets": ["3249454b049afcbef670f83eeeccfa2dffadb89a", "c0d2dc03daadf36db118c567ee4691d66e407bda", "9c7dc00a3f73496b80d1a1dad9b54d51f3fc2940"], "user": "dsmith@mozilla.com"}, "646": {"changesets": [{"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976766 - Stop assuming a buffer is still mapped in the GPU process.  a=diannaS DONTBUILD\n\n`MapCallback`, `BufferUnmap`, `ReadbackPresentCallback` and\n`ReadbackSnapshotCallback` all read a buffer's mapped range while\nassuming it is still mapped. `MapCallback` is not invoked by wgpu-core\ndirectly but from a task, so content can destroy or unmap the buffer, or\nits device, before it runs. And once a device is lost or destroyed\nwgpu-core destroys all of its buffers in `release_gpu_resources`, at the\nend of whichever poll drains the device's queue; that poll is driven by\nthe GPU process, with no content involvement and no ordering against\ncontent's messages.\n\nReturn a null ptr for `DestroyedResource` and `NotMapped` rather\nthan panicking, and handle that at each call site: send a map error to\ncontent, skip the write-back flush, or skip the readback. `MapCallback`\nalso has to tolerate the parent's `mapData` for the buffer being gone,\nwhich can be caused by content destroying or dropping the buffer.\n\nRelated fixes:\n\n- moved `MapCallback`'s `get_mapped_range` call out of the read-only\n  branch so every map is checked.\n\n- `Buffer::Unmap` previously cancelled a pending map without telling the\n  GPU process, so content saw the buffer as unmapped while wgpu-core\n  still\n  had it mapped. Forwarding that unmap is what makes the `NotMapped`\n  race\n  above reachable.\n\nIt also includes a few changes from the current central branch that were\nneeded to backport the patch to ESR153.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324946\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328138\n", "files": ["dom/webgpu/Buffer.cpp", "dom/webgpu/ipc/WebGPUParent.cpp", "dom/webgpu/ipc/WebGPUParent.h", "gfx/wgpu_bindings/src/server.rs"], "git_node": "9316796dc279d41bc2bd37db88d3324dfdac8f6f", "git_parents": ["9c7dc00a3f73496b80d1a1dad9b54d51f3fc2940"], "node": "1b12efdd3f4c1e773a89d1db4d8a907f8a57781d", "parents": ["09e350e8b5da2a0e4e20e9bd1a4ea10902a40862"], "tags": []}], "date": 1790276570, "git_changesets": ["9316796dc279d41bc2bd37db88d3324dfdac8f6f"], "user": "dsmith@mozilla.com"}, "647": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049749 p1 - Change existing public annotations to ping scope  a=diannaS DONTBUILD\n\nThese annotations are already designated as public within Socorro, so\nthere should be no reason they aren't included in pings.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315028\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328036\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/src/lib.rs"], "git_node": "845ac2f6f0c89e8134a0880420542e88a95ae989", "git_parents": ["9316796dc279d41bc2bd37db88d3324dfdac8f6f"], "node": "4dfb901713722bb0c8fbf7733598455a9a836469", "parents": ["1b12efdd3f4c1e773a89d1db4d8a907f8a57781d"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049749 p2 - Add OS, OSVersion, CPUArchitecture, CPUInfo, and LinuxLSBDescription annotations  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315029\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328037\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/nsDummyExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.cpp", "toolkit/crashreporter/nsExceptionHandler.h", "toolkit/crashreporter/test/browser/browser_required_annotations.js", "toolkit/xre/nsAppRunner.cpp", "xpcom/base/nsSystemInfo.cpp"], "git_node": "b0cacd91310f34024fded80b4c8c5805368c94e5", "git_parents": ["845ac2f6f0c89e8134a0880420542e88a95ae989"], "node": "8f33b536cad8d4e026d5845ef7cd6f155396fc60", "parents": ["4dfb901713722bb0c8fbf7733598455a9a836469"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049749 p3 - Populate OS, OSVersion, and CPUArchitecture annotations in lib-crash  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319599\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328038\n", "files": ["mobile/android/android-components/components/lib/crash/src/androidTest/java/mozilla/components/lib/crash/service/GleanCrashReporterServiceTest.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/Crash.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/GleanCrashReporterService.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/MozillaSocorroService.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/service/MozillaSocorroServiceTest.kt"], "git_node": "da30279ef20fba9707c9278db545e20d49d789c6", "git_parents": ["b0cacd91310f34024fded80b4c8c5805368c94e5"], "node": "bba9642a4df3db36be8aa193c6f123c6a1cef21c", "parents": ["8f33b536cad8d4e026d5845ef7cd6f155396fc60"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066920 - Record the OS version crash annotations without the system info service, .  a=diannaS DONTBUILD\n\nBug 2049749 reached OSVersion and LinuxLSBDescription through\n@mozilla.org/system-info;1, which loads that service during every startup, and\n@mozilla.org/windows-registry-key;1 behind it on Windows. Background tasks are\nmeant to load neither, and browser_xpcom_graph_wait.js has failed permanently\nsince. The values come from free functions nsSystemInfo itself uses, and since\nneither needs XPCOM they move to RecordPlatformAnnotations, which runs earlier.\n\nOn Android, where nsSystemInfo substitutes the SDK version for the release, Gecko\nnow leaves OSVersion to lib-crash, which sets Build.VERSION.SDK_INT when absent.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321714\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328039\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "f9a6b69d797a60055825c0e500925856a2cdc17a", "git_parents": ["da30279ef20fba9707c9278db545e20d49d789c6"], "node": "ef3df247bbc92ca973bda61e3fe235cb0ca38ed4", "parents": ["bba9642a4df3db36be8aa193c6f123c6a1cef21c"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071963 - Populate OS, OSVersion, CPUArchitecture, and CrashEventID annotations in socorro/MozillaSocorroService  a=diannaS DONTBUILD\n\nI noticed that CrashEventID was also missing here, so added it.\n\nThis moves some annotations into a separate method because detekt was\ncomplaining that the method was too long (and LongMethod can't be\nsuppressed in the a-c detekt rules(?), though the other impl does\nsuppress it).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325943\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328040\n", "files": ["mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/socorro/MozillaSocorroService.kt", "mobile/android/android-components/components/lib/crash/src/test/java/mozilla/components/lib/crash/service/socorro/MozillaSocorroServiceTest.kt"], "git_node": "84d1b951da3428a38b2433b67aefbeb975528abe", "git_parents": ["f9a6b69d797a60055825c0e500925856a2cdc17a"], "node": "b662a40036c0d89b4afc356574cfb42a90b4bf52", "parents": ["ef3df247bbc92ca973bda61e3fe235cb0ca38ed4"], "tags": []}], "date": 1790277437, "git_changesets": ["845ac2f6f0c89e8134a0880420542e88a95ae989", "b0cacd91310f34024fded80b4c8c5805368c94e5", "da30279ef20fba9707c9278db545e20d49d789c6", "f9a6b69d797a60055825c0e500925856a2cdc17a", "84d1b951da3428a38b2433b67aefbeb975528abe"], "user": "dsmith@mozilla.com"}, "648": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2069395 - Lock during nsComponentManager memory reports,  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326592\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327882\n", "files": ["xpcom/components/nsComponentManager.cpp", "xpcom/components/nsComponentManager.h"], "git_node": "729dd507fbb2cd73e6712498a69431a96270bebf", "git_parents": ["84d1b951da3428a38b2433b67aefbeb975528abe"], "node": "13bc8546027fdeef62d82a4cb302e324c2d60a8b", "parents": ["b662a40036c0d89b4afc356574cfb42a90b4bf52"], "tags": []}], "date": 1790277748, "git_changesets": ["729dd507fbb2cd73e6712498a69431a96270bebf"], "user": "dsmith@mozilla.com"}, "649": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2068747 - Honor toolkit.policies.perUserDir only in automation.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327477\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328208\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs"], "git_node": "ea01dff06daceecc7b94125bb2bb56bdd3ef0761", "git_parents": ["729dd507fbb2cd73e6712498a69431a96270bebf"], "node": "49c0ae8e1368613dcea61d39a5df99289fa08221", "parents": ["13bc8546027fdeef62d82a4cb302e324c2d60a8b"], "tags": []}], "date": 1790277807, "git_changesets": ["ea01dff06daceecc7b94125bb2bb56bdd3ef0761"], "user": "dsmith@mozilla.com"}, "650": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2056322 - Remove selectableProfiles Nimbus feature  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314541\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327843\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/tests/browser/browser.toml", "browser/components/profiles/tests/browser/browser_test_nimbus_feature.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "513b020f2b8ec64139883ca3b31c947d6ff3ad27", "git_parents": ["ea01dff06daceecc7b94125bb2bb56bdd3ef0761"], "node": "d4b66a494285aa30f6becdb54ea81a92ad94d700", "parents": ["49c0ae8e1368613dcea61d39a5df99289fa08221"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2063425 - Don't block shutdown with failed Nimbus updates  a=pascalc,diannaS\n\nPreviously, if `RemoteSettingsExperimentLoader.#updateImpl()` threw we\nwould end up not resetting the updating state, so `._updating` would\nalways be true (blocking futher updates) and `finishedUpdating()` would\nnever resolve.\n\nWe now reset this state in a finally clause and report exception\ninformation in a new Glean event.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321990\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327460\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js"], "git_node": "50aad8c4c751931d9d90e17989f7324f83ee5f60", "git_parents": ["513b020f2b8ec64139883ca3b31c947d6ff3ad27"], "node": "6535d6e52da2d5c4429ca7d416da44b7545069a8", "parents": ["d4b66a494285aa30f6becdb54ea81a92ad94d700"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2018640 - Attempt to abort Nimbus updates during shutdown before changing enrollment state  a=pascalc,diannaS\n\nWe now aggressively try to abort updateRecipes during shutdown at\nseveral point before we make changes to enrollment state. Additionally,\nwe race all IO-bound promises (i.e., `RemoteSettingsClient.get()` and\n`NimbusEnrollments.loadUnenrolledSlugsFromOtherProfiles`) with promises\nthat reject once shutdown begins.\n\nUnfortunately, there is a cut-off point after which we can no longer\nabort. As soona as we've made any enrollment changes, they must be\nflushed to the database to ensure that we do not corrupt profiles (e.g.,\nwith applied prefFlips or setPrefs that are not persisted to the\ndatabase).\n\nIn the case where we trigger shutdown during the initialization of\n`ExperimentAPI`, we will halt applying migrations and making enrollment\nchanges after attempting to enable the `RemoteSettingsExperimentLoader`.\n\nShutdown unit tests have been added to ensure that we correctly\nrace promises and bail out early.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312737\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327461\n", "files": ["browser/components/backup/resources/PreferencesBackupResource.sys.mjs", "toolkit/components/nimbus/ExperimentAPI.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/moz.build", "toolkit/components/nimbus/test/unit/head.js", "toolkit/components/nimbus/test/unit/shutdown/head.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_RemoteSettingsClient_get.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_before_update.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_load_unenrolled_slugs.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_timer.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_timer_lock_held.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_withUpdateLock.js", "toolkit/components/nimbus/test/unit/shutdown/xpcshell.toml"], "git_node": "e6d59455b728a42f9243de535de2aa02fcabb34a", "git_parents": ["50aad8c4c751931d9d90e17989f7324f83ee5f60"], "node": "d5adc24087e6b5ac95b4153e16364e29aa91a2f4", "parents": ["6535d6e52da2d5c4429ca7d416da44b7545069a8"], "tags": []}], "date": 1790277937, "git_changesets": ["513b020f2b8ec64139883ca3b31c947d6ff3ad27", "50aad8c4c751931d9d90e17989f7324f83ee5f60", "e6d59455b728a42f9243de535de2aa02fcabb34a"], "user": "dsmith@mozilla.com"}, "651": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2067202 - test offline sw bug  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323658\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327303\n", "files": ["dom/serviceworkers/test/mochitest-common.toml", "dom/serviceworkers/test/offline_worker_fetch/frame.html", "dom/serviceworkers/test/offline_worker_fetch/sw.js", "dom/serviceworkers/test/offline_worker_fetch/worker.js", "dom/serviceworkers/test/test_offline_worker_fetch.html"], "git_node": "ed662cbf02ab99c5d0c0a099e6f621a8938b8880", "git_parents": ["e6d59455b728a42f9243de535de2aa02fcabb34a"], "node": "0eace8c71350e7198117d566d18b6f71c62c7573", "parents": ["d5adc24087e6b5ac95b4153e16364e29aa91a2f4"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2067202 - Let a controlled client's fetch reach the service worker while offline.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323659\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327304\n", "files": ["dom/fetch/FetchService.cpp", "dom/fetch/FetchService.h"], "git_node": "0718c7896bf1581e9af2b111400e7b9493fb66a0", "git_parents": ["ed662cbf02ab99c5d0c0a099e6f621a8938b8880"], "node": "ae93c8ed7d23677a649f7b0a9cf718989382dd55", "parents": ["0eace8c71350e7198117d566d18b6f71c62c7573"], "tags": []}], "date": 1790280876, "git_changesets": ["ed662cbf02ab99c5d0c0a099e6f621a8938b8880", "0718c7896bf1581e9af2b111400e7b9493fb66a0"], "user": "dsmith@mozilla.com"}, "652": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045456: Emit overrecursed check for CloseIterCache  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326028\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327454\n", "files": ["js/src/jit-test/tests/ion/bug2045456.js", "js/src/jit/Lowering.cpp"], "git_node": "7e36d2472274fc9b60fdc368c6a2980a4dc72f89", "git_parents": ["0718c7896bf1581e9af2b111400e7b9493fb66a0"], "node": "3e6aa6a3f9ec98dad0a2bb2652b7848be890fa3f", "parents": ["ae93c8ed7d23677a649f7b0a9cf718989382dd55"], "tags": []}], "date": 1790280918, "git_changesets": ["7e36d2472274fc9b60fdc368c6a2980a4dc72f89"], "user": "dsmith@mozilla.com"}, "653": {"changesets": [{"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2070547 - Enforce guard sets for activeTab  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324717\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326712\n", "files": ["toolkit/components/extensions/WebExtensionPolicy.cpp", "toolkit/components/extensions/test/xpcshell/test_WebExtensionContentScript.js"], "git_node": "7b0b9c5bd1a51d0c3cf3c93e65d18665c26da251", "git_parents": ["7e36d2472274fc9b60fdc368c6a2980a4dc72f89"], "node": "c9a6bf1b109ee7fdc9563b1ca166ebb6443c6812", "parents": ["3e6aa6a3f9ec98dad0a2bb2652b7848be890fa3f"], "tags": []}], "date": 1790280956, "git_changesets": ["7b0b9c5bd1a51d0c3cf3c93e65d18665c26da251"], "user": "dsmith@mozilla.com"}, "654": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057113 - Part 1: Reject re-entrant native Windows clipboard mutations.  a=diannaS DONTBUILD\n\nNative clipboard writes can spin a nested event loop or pump the native message\nqueue. A clipboard write dispatched during that period re-enters the platform's\nbackend and mutates state the suspended commit is still using.  This exposed\na case where the clipboard cache gets out-of-sync due to re-entrant SetData.\nThe older write would win the cache but the native clipboard holds the newer\nwrite's contents.  Re-entrant requests are now rejected (neither interleaved\nnor queued).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326255\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328681\n", "files": ["widget/nsBaseClipboard.cpp", "widget/nsBaseClipboard.h"], "git_node": "a2ff05dfd3e13b04dfb4e14d0833fa9774210bce", "git_parents": ["7b0b9c5bd1a51d0c3cf3c93e65d18665c26da251"], "node": "ddc0cae0a0f64bb5a819577a0d88223b8a52b357", "parents": ["c9a6bf1b109ee7fdc9563b1ca166ebb6443c6812"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057113 - Part 2: Don't force a synchronous clipboard flush for file promises.  a=diannaS DONTBUILD\n\nSetNativeClipboardData flushes clipboard writes when text/plain is on the\ntransferable on Windows 11 22H2+. Flushing was added to clipboard write in\nbug 1774285, because delayed rendering makes Windows Suggested Actions walk\nthe a11y tree, and immediate rendering of data to the clipboard was the lesser\nevil.\n\nRendering a file promise maps to CF_HDROP, whose renderer is\nnsDataObj::DropTempFile (which is unintuitively _not_ used for drag and drop,\nonly clipboard).  It opens a channel to the promised URL and runs a nested\nevent loop in CStream::WaitForCompletion until it completes, so forcing the\nflush runs a network fetch in a nested event loop inside the clipboard commit.\nThe duration of the nest is unpredictable but can be as long as the device\nmaintains the connection (modulo any timeout limits).   This patch skips the\nflush if there is a file (or no text) in the payload, avoiding the nested loop\naltogether when this happens.\n\nWithout a pref flip (clipboard.imageAsFile.enabled = true), writing both\na file and text to clipboard should not be possible, so this case does not\noccur.  This is because only images can be written to the clipboard as files.\nSee [the MDN page for mandatory types](https://www.w3.org/TR/clipboard-apis/#mandatory-data-types)\nand the comment in ClipboardItem::Supports.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326256\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328682\n", "files": ["widget/windows/nsClipboard.cpp"], "git_node": "d56c3754abc48c7ca0b9ea13ef39242547962aef", "git_parents": ["a2ff05dfd3e13b04dfb4e14d0833fa9774210bce"], "node": "0e0d561e044954ceda23637955d74d8c02d0b088", "parents": ["ddc0cae0a0f64bb5a819577a0d88223b8a52b357"], "tags": []}], "date": 1790281000, "git_changesets": ["a2ff05dfd3e13b04dfb4e14d0833fa9774210bce", "d56c3754abc48c7ca0b9ea13ef39242547962aef"], "user": "dsmith@mozilla.com"}, "655": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2040977 - Add a ClearOnShutdown policy.  a=diannaS DONTBUILD\n\nSanitizeOnShutdown's object members were written against the old Clear History\ndialog. Shutdown only reads privacy.clearOnShutdown_v2.*, so Downloads, Sessions\nand OfflineApps now write prefs nothing looks at.\n\nClearOnShutdown has one member per category the dialog actually offers, mapped\n1:1 to the pref behind it. Naming a category enforces it and anything left out\nstays the user's, so the categories an admin does not care about remain\neditable. As a boolean it enforces all of them, or none of them for false.\n\nThere is no Locked. An unlocked pref loses to any user value, and Sanitizer's\nmigration gives every profile a user value for all five of these, so a default\nalone would be a policy that quietly does nothing. Chrome's\nClearBrowsingDataOnExitList is mandatory only for the same reason.\n\nSanitizeOnShutdown is unchanged, so existing configurations keep working. When\nboth are set ClearOnShutdown wins and the old one logs an error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328640\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_clear_on_shutdown.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": "83a02c48fde8643835d8f20363ffc313ec660a85", "git_parents": ["d56c3754abc48c7ca0b9ea13ef39242547962aef"], "node": "1269948254850bacd907bc5764e2f3e0cd62192c", "parents": ["0e0d561e044954ceda23637955d74d8c02d0b088"], "tags": []}], "date": 1790281023, "git_changesets": ["83a02c48fde8643835d8f20363ffc313ec660a85"], "user": "dsmith@mozilla.com"}, "656": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2072629 - Remove the URI_LOADABLE_BY_ANYONE flag from the jar: protocol  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326588\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328428\n", "files": ["modules/libjar/components.conf", "modules/libjar/test/unit/test_jar_protocol_flags.js", "modules/libjar/test/unit/xpcshell.toml"], "git_node": "bddba4d81ddda72d33ffc18ea1f073189e0fc04b", "git_parents": ["83a02c48fde8643835d8f20363ffc313ec660a85"], "node": "8b6a124e8abb140df5da91bc3e6808b1a54b95a9", "parents": ["1269948254850bacd907bc5764e2f3e0cd62192c"], "tags": []}], "date": 1790281489, "git_changesets": ["bddba4d81ddda72d33ffc18ea1f073189e0fc04b"], "user": "dsmith@mozilla.com"}, "657": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2070633 - Only allow setting nsIHttpChannel.allowSTS in parent process  a=diannaS DONTBUILD\n\nRemoves the flag from IPC arguments.\nIt is now only honored in the parent process. Currently used by\ncaptive portal service and OCSP checks.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326843\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328422\n", "files": ["netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpChannelChild.cpp", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h", "netwerk/protocol/http/nsIHttpChannel.idl"], "git_node": "3457b90195e530576eacb4f127d38b67da8b2dbf", "git_parents": ["bddba4d81ddda72d33ffc18ea1f073189e0fc04b"], "node": "804a1581a448adfce55ee3c9defa56e47983aa52", "parents": ["8b6a124e8abb140df5da91bc3e6808b1a54b95a9"], "tags": []}], "date": 1790281514, "git_changesets": ["3457b90195e530576eacb4f127d38b67da8b2dbf"], "user": "dsmith@mozilla.com"}, "658": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070252 - Check content policy types from PFetch.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324967\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326813\n", "files": ["dom/fetch/FetchParent.cpp", "dom/fetch/InternalRequest.h"], "git_node": "f00ebff74a0ba521fb552a3503a6157dd41b7a6d", "git_parents": ["3457b90195e530576eacb4f127d38b67da8b2dbf"], "node": "5bac69ba1ea050d868be4a5d0bcf09482f4c7c5c", "parents": ["804a1581a448adfce55ee3c9defa56e47983aa52"], "tags": []}], "date": 1790281599, "git_changesets": ["f00ebff74a0ba521fb552a3503a6157dd41b7a6d"], "user": "dsmith@mozilla.com"}, "659": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2047722 - Clamp the VP8 reference row await in ffvpx  a=diannaS\n\nCherry-pick of FFmpeg commit b772f5033c72, carried as\nvp8-reference-row-clamp.patch and listed in README_MOZILLA until ffvpx is\nupdated past it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315478\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328288\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/libavcodec/vp8.c", "media/ffvpx/vp8-reference-row-clamp.patch"], "git_node": "d224b0c43f9d1c11de88c2d44cc021b94abed9b4", "git_parents": ["f00ebff74a0ba521fb552a3503a6157dd41b7a6d"], "node": "4974975f57d133c2c58018cb6216292abace402f", "parents": ["5bac69ba1ea050d868be4a5d0bcf09482f4c7c5c"], "tags": []}], "date": 1790281630, "git_changesets": ["d224b0c43f9d1c11de88c2d44cc021b94abed9b4"], "user": "dsmith@mozilla.com"}, "660": {"changesets": [{"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059195 - Track each pipeline's embedder LayersId in CompositorBridgeParent::LayerTreeState.  a=diannaS DONTBUILD\n\nExtend NotifyChildCreated, MapAndNotifyChildCreated, and NotifyChildRecreated\nto carry the LayersId of the pipeline that embeds the newly (re)created one,\nand record it on LayerTreeState as mEmbedderLayersId. It is derived in\nRemoteLayerTreeOwner::Initialize(), once the embedding widget's WindowRenderer\nexists: from the embedding document's BrowserParent for a nested remote frame,\nand from the hosting chrome window's widget otherwise.\n\nAlso extend AdoptChild to carry a freshly-recomputed embedder id, rather than\npreserving whatever was previously recorded: adopting a child under a new\nCompositorBridgeParent can mean a tab was moved to a different top-level\nwindow, which does change who embeds it, so the old value would otherwise go\nstale.\n\nThis establishes a parent-process-trusted ground truth for which LayersId\nembeds which, to be used by a follow-up change to validate scroll-data\nreferent claims from content.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316408\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328390\n", "files": ["gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/layers/ipc/CompositorBridgeChild.cpp", "gfx/layers/ipc/CompositorBridgeChild.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.h", "gfx/layers/ipc/PCompositorBridge.ipdl", "layout/ipc/RemoteLayerTreeOwner.cpp"], "git_node": "9da13fca05906d3923022f234181dfe5db538359", "git_parents": ["d224b0c43f9d1c11de88c2d44cc021b94abed9b4"], "node": "4ba906a1a85964a578d957db526c8e5ad394ca1c", "parents": ["4974975f57d133c2c58018cb6216292abace402f"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059195 - Clear WebRenderScrollData referent ids that the sender doesn't actually embed.  a=diannaS DONTBUILD\n\nValidate every referent claim in WebRenderBridgeParent::ProcessDisplayListData\nagainst the parent process's own record of the frame tree (LayerTreeState's\nnew mEmbedderLayersId), and clear the claims it doesn't confirm.\n\nClearing rather than dropping the transaction, because a referent can\nlegitimately be gone by the time the claim is validated: DeallocateLayerTreeId\nerases the entry via a dispatched runnable while the embedder still has a\ntransaction in flight naming it.\n\nSkip the check for a root WebRenderBridgeParent, whose transactions come from\nthe parent process rather than from content. After the GPU process restarts\neach layer tree re-registers independently, driven from its own content\nprocess, while the root pipeline repaints straight away, so a root can name\nreferents that have no LayerTreeState yet.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316409\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328391\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.h", "gfx/layers/wr/WebRenderScrollData.cpp", "gfx/layers/wr/WebRenderScrollData.h"], "git_node": "ac1805880292525e8b8dba68a779493cd66a0015", "git_parents": ["9da13fca05906d3923022f234181dfe5db538359"], "node": "ec8e38b4b91d89ba6efee0779da66506da3190cb", "parents": ["4ba906a1a85964a578d957db526c8e5ad394ca1c"], "tags": []}], "date": 1790285372, "git_changesets": ["9da13fca05906d3923022f234181dfe5db538359", "ac1805880292525e8b8dba68a779493cd66a0015"], "user": "dsmith@mozilla.com"}, "661": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069400 - Add test for invalid remote drag invocation;  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322379\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328531\n", "files": ["dom/events/test/browser.toml", "dom/events/test/browser_dragdrop_invalid_remote_drag.js"], "git_node": "bfcfb11bff2caa8791484f5a918a6c8ac71a7df4", "git_parents": ["ac1805880292525e8b8dba68a779493cd66a0015"], "node": "12267369621320fea9420e085cb8d626285ca4aa", "parents": ["ec8e38b4b91d89ba6efee0779da66506da3190cb"], "tags": []}], "date": 1790285522, "git_changesets": ["bfcfb11bff2caa8791484f5a918a6c8ac71a7df4"], "user": "dsmith@mozilla.com"}, "662": {"changesets": [{"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2068459 - Eliminate the type confusion of AxisEndPoint.  a=diannaS DONTBUILD\n\nTo avoid the type confusion via IPC when using serde for shape commands,\nwe change the type of the computed value of `AxisEndPoint` to avoid\nusing `AxisPosition`, which could be a length percentage or a keyword.\ni.e.\nspecified value of `AxisEndPoint`: as of it is.\ncomputed value of `AxisEndPoint`: both enum arms, `ToPosition` and\n`ByCoordinate` use `LengthPercentage` instead.\n\nTherefore, we can make sure the receiver of IPC always gets\n`LengthPercentage`.\n\nThis is pretty similiar to what we do for `Position`. The only drawback is\nthat we need to add one more generics type parameter for all the shape\ntypes.\n\nFor `PathCommand`, we always use `AxisEndPoint\u003cCSSFloat, CSSFloat\u003e`\nbecause its specified value and computed value are the same and it always\nuses `CSSFloat` to represent the coordinate, for hline and vline.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324476\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328236\n", "files": ["dom/svg/SVGAnimatedPathSegList.cpp", "dom/svg/SVGPathData.cpp", "dom/svg/SVGPathSegUtils.h", "layout/style/ServoStyleConstsInlines.h", "servo/components/style/values/computed/basic_shape.rs", "servo/components/style/values/generics/basic_shape.rs", "servo/components/style/values/specified/basic_shape.rs", "servo/components/style/values/specified/svg_path.rs"], "git_node": "fa58236355f4d76ba3bbc184e34663012b034b0d", "git_parents": ["bfcfb11bff2caa8791484f5a918a6c8ac71a7df4"], "node": "350ba8c2a46206f479a72a3d286fd694d7d53284", "parents": ["12267369621320fea9420e085cb8d626285ca4aa"], "tags": []}], "date": 1790286199, "git_changesets": ["fa58236355f4d76ba3bbc184e34663012b034b0d"], "user": "dsmith@mozilla.com"}, "663": {"changesets": [{"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2061784  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323348\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327923\n", "files": ["dom/webserial/Win32SerialOverlappedIO.cpp", "dom/webserial/Win32SerialOverlappedIO.h", "dom/webserial/Win32SerialPlatformService.cpp", "dom/webserial/moz.build"], "git_node": "a397d6d269d28ede492022dca84f79d0c1484589", "git_parents": ["fa58236355f4d76ba3bbc184e34663012b034b0d"], "node": "dacebab22938a6618fe03dd203b5de9887320579", "parents": ["350ba8c2a46206f479a72a3d286fd694d7d53284"], "tags": []}], "date": 1790286221, "git_changesets": ["a397d6d269d28ede492022dca84f79d0c1484589"], "user": "dsmith@mozilla.com"}, "664": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2068372 - nsSimpleNestedURI::Deserialize should reparse the inner URI  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327278\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328421\n", "files": ["netwerk/base/nsSimpleNestedURI.cpp"], "git_node": "c5e99c50c7c01bb9eb269f2877f5089259b6668a", "git_parents": ["a397d6d269d28ede492022dca84f79d0c1484589"], "node": "115c30112e2e7e571ea3c289c522b690d82cc0c6", "parents": ["dacebab22938a6618fe03dd203b5de9887320579"], "tags": []}], "date": 1790286243, "git_changesets": ["c5e99c50c7c01bb9eb269f2877f5089259b6668a"], "user": "dsmith@mozilla.com"}, "665": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072438 - Rework bidi-engine management to allow nested use of nsBidiPresUtils::Resolve.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327605\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328159\n", "files": ["layout/base/nsBidiPresUtils.cpp", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h"], "git_node": "11af46e156bda89c17bee41942fe044e87739b4c", "git_parents": ["c5e99c50c7c01bb9eb269f2877f5089259b6668a"], "node": "4d7b110aee66b4cc9f675b3a20ec71451800b82f", "parents": ["115c30112e2e7e571ea3c289c522b690d82cc0c6"], "tags": []}], "date": 1790286263, "git_changesets": ["11af46e156bda89c17bee41942fe044e87739b4c"], "user": "dsmith@mozilla.com"}, "666": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073396 - Prevent potential data race in font instantiation.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327838\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328181\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxMacFont.cpp"], "git_node": "41e3b049da8a88d93d8b2c53e00ab7fc4af00fb4", "git_parents": ["11af46e156bda89c17bee41942fe044e87739b4c"], "node": "f04f6ef39dc13617d9ff7e940e86e7bd574873ff", "parents": ["4d7b110aee66b4cc9f675b3a20ec71451800b82f"], "tags": []}], "date": 1790286284, "git_changesets": ["41e3b049da8a88d93d8b2c53e00ab7fc4af00fb4"], "user": "dsmith@mozilla.com"}, "667": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068344: Make GetCurrentFontStyle destroy a stale fontGroup.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324763\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328256\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "c5ca79137d91af8f9e246095df89d1188d423cdd", "git_parents": ["41e3b049da8a88d93d8b2c53e00ab7fc4af00fb4"], "node": "c71c0b21c3781510418851b46ad8991d5b5bbaa5", "parents": ["f04f6ef39dc13617d9ff7e940e86e7bd574873ff"], "tags": []}], "date": 1790286303, "git_changesets": ["c5ca79137d91af8f9e246095df89d1188d423cdd"], "user": "dsmith@mozilla.com"}, "668": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044525 - Part 1: Set policy site list permissions on both trailing dot host forms.  a=diannaS\n\nA host and its trailing dot form are distinct permission origins. An\nadministrator lists one form, so the policy sets the permission for both.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328212\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_permissions.js", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs"], "git_node": "f6b54e096cc06ff4b304baeea0c53f1305054d59", "git_parents": ["c5ca79137d91af8f9e246095df89d1188d423cdd"], "node": "d941730252a1ffc1adf79d05c17c6dc937dc563d", "parents": ["c71c0b21c3781510418851b46ad8991d5b5bbaa5"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044525 - Part 2: List a site once in the permission exceptions dialogs.  a=diannaS\n\nPart 1 sets a policy permission for both trailing dot forms of a host, which\nare distinct permission origins. The dialogs list the site once, and still\nlist a trailing dot host that has a permission of its own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328213\n", "files": ["browser/components/preferences/dialogs/permissions.js", "browser/components/preferences/dialogs/sitePermissions.js"], "git_node": "dfc0fbea7f674dd5d25383d3f11fb2a50b623a69", "git_parents": ["f6b54e096cc06ff4b304baeea0c53f1305054d59"], "node": "77f7d73bc5dc1858e683c9be4cd820af17675b99", "parents": ["d941730252a1ffc1adf79d05c17c6dc937dc563d"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2044525 - Part 3: Test that the site permissions dialog lists a policy site once.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328214\n", "files": ["browser/components/preferences/tests/permissions/browser-srd.toml", "browser/components/preferences/tests/permissions/browser_permissions_policy_trailing_dot.js"], "git_node": "69ac649c6ed4ce2571e87761879e89bc6c048055", "git_parents": ["dfc0fbea7f674dd5d25383d3f11fb2a50b623a69"], "node": "ba92243cb9fc45a556abf5500ca3226316814e01", "parents": ["77f7d73bc5dc1858e683c9be4cd820af17675b99"], "tags": []}], "date": 1790286326, "git_changesets": ["f6b54e096cc06ff4b304baeea0c53f1305054d59", "dfc0fbea7f674dd5d25383d3f11fb2a50b623a69", "69ac649c6ed4ce2571e87761879e89bc6c048055"], "user": "dsmith@mozilla.com"}, "669": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068459 - Eliminate the type confusion of AxisEndPoint.\" a=backout for causing bustage\n\nThis reverts commit fa58236355f4d76ba3bbc184e34663012b034b0d.\n", "files": ["dom/svg/SVGAnimatedPathSegList.cpp", "dom/svg/SVGPathData.cpp", "dom/svg/SVGPathSegUtils.h", "layout/style/ServoStyleConstsInlines.h", "servo/components/style/values/computed/basic_shape.rs", "servo/components/style/values/generics/basic_shape.rs", "servo/components/style/values/specified/basic_shape.rs", "servo/components/style/values/specified/svg_path.rs"], "git_node": "8d6e8039f2d8514c87b3269dce7ab6d209ce83be", "git_parents": ["69ac649c6ed4ce2571e87761879e89bc6c048055"], "node": "1fd5f6405b666ff695f842b8018d42f6e19448c0", "parents": ["ba92243cb9fc45a556abf5500ca3226316814e01"], "tags": []}], "date": 1790289186, "git_changesets": ["8d6e8039f2d8514c87b3269dce7ab6d209ce83be"], "user": "dsmith@mozilla.com"}, "670": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072438 - fix bustage on esr153 a=bustage\n", "files": ["layout/base/nsBidiPresUtils.cpp"], "git_node": "2f89d7b971cc59f94c909f7e4cae45dc2a6b06df", "git_parents": ["8d6e8039f2d8514c87b3269dce7ab6d209ce83be"], "node": "a71b5283ed577ec2d630c9bd9eccbd06b43f5f0f", "parents": ["1fd5f6405b666ff695f842b8018d42f6e19448c0"], "tags": []}], "date": 1790290178, "git_changesets": ["2f89d7b971cc59f94c909f7e4cae45dc2a6b06df"], "user": "dsmith@mozilla.com"}, "671": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069638 - Keep SQLite temporary storage in memory for encrypted storage connections.  a=diannaS DONTBUILD\n\nEncrypted connections now set PRAGMA temp_store = 2 in\nConnection::initializeInternal so statement subjournals, sorter runs and\ntemp tables never go through the unencrypted temp-file path on builds that\ndo not default SQLITE_TEMP_STORE to memory.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326736\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328537\n", "files": ["storage/mozStorageConnection.cpp", "third_party/sqlite3/src/moz.build"], "git_node": "17a2cd19219492b34a28cbcec10ccdd033212711", "git_parents": ["2f89d7b971cc59f94c909f7e4cae45dc2a6b06df"], "node": "906ef5c4ad579c2dca6822aed9a1491ccb1cbd9f", "parents": ["a71b5283ed577ec2d630c9bd9eccbd06b43f5f0f"], "tags": []}], "date": 1790296094, "git_changesets": ["17a2cd19219492b34a28cbcec10ccdd033212711"], "user": "dsmith@mozilla.com"}, "672": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067976 - Clean up some unnecessary string copies in SandboxBroker.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326377\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328249\n", "files": ["security/sandbox/linux/broker/SandboxBroker.cpp", "security/sandbox/linux/broker/SandboxBroker.h"], "git_node": "3887812d50dda8e823a45482342e69d38183b3d7", "git_parents": ["17a2cd19219492b34a28cbcec10ccdd033212711"], "node": "724191bc8823724caa16f9c45383de5296984abc", "parents": ["906ef5c4ad579c2dca6822aed9a1491ccb1cbd9f"], "tags": []}], "date": 1790296114, "git_changesets": ["3887812d50dda8e823a45482342e69d38183b3d7"], "user": "dsmith@mozilla.com"}, "673": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074159 - Handle null values in policy objects.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327872\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328203\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/tests/xpcshell/test_null_policy_value.js", "toolkit/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "b7785a1ce30a83cdefeca85b6a1a70cabb195877", "git_parents": ["3887812d50dda8e823a45482342e69d38183b3d7"], "node": "432f8820cf79ecd83b8e628c6ca271886b902fab", "parents": ["724191bc8823724caa16f9c45383de5296984abc"], "tags": []}], "date": 1790296154, "git_changesets": ["b7785a1ce30a83cdefeca85b6a1a70cabb195877"], "user": "dsmith@mozilla.com"}, "674": {"changesets": [{"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2068459 - Eliminate the type confusion of AxisEndPoint.  a=diannaS DONTBUILD\n\nTo avoid the type confusion via IPC when using serde for shape commands,\nwe change the type of the computed value of `AxisEndPoint` to avoid\nusing `AxisPosition`, which could be a length percentage or a keyword.\ni.e.\nspecified value of `AxisEndPoint`: as of it is.\ncomputed value of `AxisEndPoint`: both enum arms, `ToPosition` and\n`ByCoordinate` use `LengthPercentage` instead.\n\nTherefore, we can make sure the receiver of IPC always gets\n`LengthPercentage`.\n\nThis is pretty similiar to what we do for `Position`. The only drawback is\nthat we need to add one more generics type parameter for all the shape\ntypes.\n\nFor `PathCommand`, we always use `AxisEndPoint\u003cCSSFloat, CSSFloat\u003e`\nbecause its specified value and computed value are the same and it always\nuses `CSSFloat` to represent the coordinate, for hline and vline.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324476\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328236\n", "files": ["dom/svg/SVGAnimatedPathSegList.cpp", "dom/svg/SVGPathData.cpp", "dom/svg/SVGPathSegUtils.h", "layout/style/ServoStyleConstsInlines.h", "servo/components/style/values/computed/basic_shape.rs", "servo/components/style/values/generics/basic_shape.rs", "servo/components/style/values/specified/basic_shape.rs", "servo/components/style/values/specified/svg_path.rs"], "git_node": "689bfbe9d9aa54ba4f86bbf21d0b1207844a8291", "git_parents": ["b7785a1ce30a83cdefeca85b6a1a70cabb195877"], "node": "22486b6ba1029cdd9446b53a335cf5477bbca27b", "parents": ["432f8820cf79ecd83b8e628c6ca271886b902fab"], "tags": []}], "date": 1790296605, "git_changesets": ["689bfbe9d9aa54ba4f86bbf21d0b1207844a8291"], "user": "dsmith@mozilla.com"}, "675": {"changesets": [{"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2059230  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323614\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326972\n", "files": ["dom/webserial/PSerialPort.ipdl", "dom/webserial/SerialPort.cpp", "dom/webserial/SerialPort.h", "dom/webserial/SerialPortParent.cpp", "dom/webserial/SerialPortParent.h", "dom/webserial/tests/browser/browser_webserial_permission_revoke.js", "dom/webserial/tests/browser/browser_webserial_sharing_icon.js"], "git_no