c25", "d5647c7f1a01fc4000cc8b084c54b1d0c6219dd0", "d910ff74e32c340e9daeb4cc907cf924208d9f88", "8d9afb3c74c2c80ff945661b30feff5248dd57fc", "500bb43d09af48219d6f91746b8026cf318e410b", "932b53f9f363adc21db9f35bbd00445f06d6fdef", "1cf6670c9a98263abbb05a250443ffabbb06f906"], "user": "ffxbld@lando.moz.tools"}, "712": {"changesets": [{"author": "Frederik Braun \u003cfbraun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069258 - Restrict about:reader's url parameter to schemes reader can load.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323524\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329606\n", "files": ["browser/modules/test/unit/test_E10SUtils_nested_URIs.js", "docshell/base/nsDocShellLoadState.cpp", "dom/ipc/ProcessIsolation.cpp", "dom/ipc/ProcessIsolation.h", "toolkit/components/reader/tests/browser/browser_localfile_readerMode.js"], "git_node": "4cec39ee7e131b55e1afa703e8d32628decff2d1", "git_parents": ["7afe8b4d28ba69148a60ddf1d8ba8cd7058c9046"], "node": "22e892e9f38b48b581c1767ae4a06fda2d272805", "parents": ["c45853c50f312cb424cf270fc7207937e0ca0c12"], "tags": []}], "date": 1790697711, "git_changesets": ["4cec39ee7e131b55e1afa703e8d32628decff2d1"], "user": "dsmith@mozilla.com"}, "713": {"changesets": [{"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073978 - Update permission tables before notifying observers of removals.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328879\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329588\n", "files": ["extensions/permissions/PermissionManager.cpp"], "git_node": "61e5ac4001a198d145a80649f47403dfd392a5fd", "git_parents": ["4cec39ee7e131b55e1afa703e8d32628decff2d1"], "node": "ea9e9310f38869674bf7c374def34f045d38e10e", "parents": ["22e892e9f38b48b581c1767ae4a06fda2d272805"], "tags": []}], "date": 1790697732, "git_changesets": ["61e5ac4001a198d145a80649f47403dfd392a5fd"], "user": "dsmith@mozilla.com"}, "714": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2068443 - Make `HTMLEditor` verify `Text` data after modifying it and abort for any errors  a=diannaS DONTBUILD\n\nThis patch makes `HandleInsertText` and `WhiteSpaceVisibilityKeeper`\nget `NS_ERROR_EDITOR_UNEXPECTED_DOM_TREE` once the target `Text` is\nmodified as unexpected data. Therefore, the callers of modifying a\n`Text` with transaction will abort handling it to avoid to keep handling\nit with unexpected DOM tree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323542\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329700\n", "files": ["dom/base/CharacterDataBuffer.cpp", "dom/base/CharacterDataBuffer.h", "dom/base/nsINode.h", "dom/base/test/gtest/TestCharacterDataBuffer.cpp", "dom/script/ScriptElement.cpp", "editor/libeditor/CompositionTransaction.cpp", "editor/libeditor/DeleteTextTransaction.cpp", "editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/InsertTextTransaction.cpp", "editor/libeditor/ReplaceTextTransaction.cpp"], "git_node": "275c83bad375a96d2df48025d6ae57adf8f0dfe0", "git_parents": ["61e5ac4001a198d145a80649f47403dfd392a5fd"], "node": "71266c59bf344e5945325956aa06aa20fe6a696e", "parents": ["ea9e9310f38869674bf7c374def34f045d38e10e"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2068443 - Follow up for fixing the points which were pointed at the last review  a=diannaS DONTBUILD\n\nI forgot to update D323542 before landing the patch due to the tight\nschedule before the vacation week in Japan. This patch fixes the points:\n1. The wrong warning message in `CompositionTransaction`\n2. Unnecessary early return for the error case before `NS_WARNING_ASSERTION` in `DeleteTextTransaction::UndoTransaction`\n3. Unnecessary editor reference in `AutoTextEditVerifier`\n4. Bad error handlings in `Do*Text` methods which may ignore `NS_ERROR_EDITOR_DESTROYED`\n5. Unsafe `Destroyed` check remove in `EditorBase::InsertTextIntoTextNodeWithTransaction`\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327721\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329702\n", "files": ["editor/libeditor/CompositionTransaction.cpp", "editor/libeditor/DeleteTextTransaction.cpp", "editor/libeditor/EditorBase.cpp"], "git_node": "961539d3bcab3c0ff8f7dd8abc23b422f7090468", "git_parents": ["275c83bad375a96d2df48025d6ae57adf8f0dfe0"], "node": "52701b6d6539838a3a1d54c2e3c7bab2937de0ab", "parents": ["71266c59bf344e5945325956aa06aa20fe6a696e"], "tags": []}], "date": 1790697758, "git_changesets": ["275c83bad375a96d2df48025d6ae57adf8f0dfe0", "961539d3bcab3c0ff8f7dd8abc23b422f7090468"], "user": "dsmith@mozilla.com"}, "715": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053649: Add error helper to IDB cursor.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312758\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329747\n", "files": ["dom/indexedDB/ActorsChild.cpp", "dom/indexedDB/IDBCursor.cpp", "dom/indexedDB/IDBCursor.h", "dom/indexedDB/Key.cpp"], "git_node": "302b2cff4da7372f20c6819052efc450fa5aa6e5", "git_parents": ["961539d3bcab3c0ff8f7dd8abc23b422f7090468"], "node": "4940e47db51ce6fe3e64b4e99dee6d6a8d26b02a", "parents": ["52701b6d6539838a3a1d54c2e3c7bab2937de0ab"], "tags": []}], "date": 1790697835, "git_changesets": ["302b2cff4da7372f20c6819052efc450fa5aa6e5"], "user": "dsmith@mozilla.com"}, "716": {"changesets": [{"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068443 - Follow up for fixing the points which were pointed at the last review a=diannaS\" for causing bustages in EditorBase.cpp.\n\nThis reverts commit 961539d3bcab3c0ff8f7dd8abc23b422f7090468.\n\nRevert \"Bug 2068443 - Make `HTMLEditor` verify `Text` data after modifying it and abort for any errors  a=diannaS\"\n\nThis reverts commit 275c83bad375a96d2df48025d6ae57adf8f0dfe0.\n", "files": ["dom/base/CharacterDataBuffer.cpp", "dom/base/CharacterDataBuffer.h", "dom/base/nsINode.h", "dom/base/test/gtest/TestCharacterDataBuffer.cpp", "dom/script/ScriptElement.cpp", "editor/libeditor/CompositionTransaction.cpp", "editor/libeditor/DeleteTextTransaction.cpp", "editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/InsertTextTransaction.cpp", "editor/libeditor/ReplaceTextTransaction.cpp"], "git_node": "7f7958160580068f62a6f673f3f4cd0be31618a6", "git_parents": ["302b2cff4da7372f20c6819052efc450fa5aa6e5"], "node": "3ff9e14fa6d2e3dc9d1bc0dc7ef4dcf385aa913a", "parents": ["4940e47db51ce6fe3e64b4e99dee6d6a8d26b02a"], "tags": []}], "date": 1790701265, "git_changesets": ["7f7958160580068f62a6f673f3f4cd0be31618a6"], "user": "abutkovits@mozilla.com"}, "717": {"changesets": [{"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029784: Ensure frame table is valid after adjusting selection  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327502\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329737\n", "files": ["layout/generic/nsFrameSelection.cpp", "testing/web-platform/tests/input-events/table-selection-crash.html"], "git_node": "8f4c27f6766aa3089f25c4c93ea9f0e56c574694", "git_parents": ["7f7958160580068f62a6f673f3f4cd0be31618a6"], "node": "f0ca3f1587b23c166193b242218d3d31fb7e962b", "parents": ["3ff9e14fa6d2e3dc9d1bc0dc7ef4dcf385aa913a"], "tags": []}], "date": 1790739304, "git_changesets": ["8f4c27f6766aa3089f25c4c93ea9f0e56c574694"], "user": "dsmith@mozilla.com"}, "718": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2069897 - Use encoding_rs 0.8.40 from crates.io.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324016\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329827\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "supply-chain/audits.toml", "supply-chain/config.toml", "supply-chain/imports.lock", "third_party/rust/encoding_rs/.cargo-checksum.json", "third_party/rust/encoding_rs/.cargo_vcs_info.json", "third_party/rust/encoding_rs/Cargo.lock", "third_party/rust/encoding_rs/Cargo.toml", "third_party/rust/encoding_rs/Cargo.toml.orig", "third_party/rust/encoding_rs/README.md", "third_party/rust/encoding_rs/build.rs", "third_party/rust/encoding_rs/src/lib.rs", "third_party/rust/encoding_rs/src/mem.rs", "third_party/rust/encoding_rs/src/simd_funcs.rs"], "git_node": "e1aafcad0076610b4a43363c7486995750fe752b", "git_parents": ["8f4c27f6766aa3089f25c4c93ea9f0e56c574694"], "node": "1f185513e4c52df6bb5a3193980249a0dc03a764", "parents": ["f0ca3f1587b23c166193b242218d3d31fb7e962b"], "tags": []}], "date": 1790739366, "git_changesets": ["e1aafcad0076610b4a43363c7486995750fe752b"], "user": "dsmith@mozilla.com"}, "719": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2068443 - Make `HTMLEditor` verify `Text` data after modifying it and abort for any errors  a=diannaS\n\nThis patch makes `HandleInsertText` and `WhiteSpaceVisibilityKeeper`\nget `NS_ERROR_EDITOR_UNEXPECTED_DOM_TREE` once the target `Text` is\nmodified as unexpected data. Therefore, the callers of modifying a\n`Text` with transaction will abort handling it to avoid to keep handling\nit with unexpected DOM tree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323542\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329700\n", "files": ["dom/base/CharacterDataBuffer.cpp", "dom/base/CharacterDataBuffer.h", "dom/base/nsINode.h", "dom/base/test/gtest/TestCharacterDataBuffer.cpp", "dom/script/ScriptElement.cpp", "editor/libeditor/CompositionTransaction.cpp", "editor/libeditor/DeleteTextTransaction.cpp", "editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/InsertTextTransaction.cpp", "editor/libeditor/ReplaceTextTransaction.cpp"], "git_node": "a84a85546d30f1ab24d61fef12174ffebfab9ac3", "git_parents": ["e1aafcad0076610b4a43363c7486995750fe752b"], "node": "575a6c0e31492c4e0f33cdc6cf81a494accb1dc9", "parents": ["1f185513e4c52df6bb5a3193980249a0dc03a764"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2068443 - Follow up for fixing the points which were pointed at the last review  a=diannaS\n\nI forgot to update D323542 before landing the patch due to the tight\nschedule before the vacation week in Japan. This patch fixes the points:\n1. The wrong warning message in `CompositionTransaction`\n2. Unnecessary early return for the error case before `NS_WARNING_ASSERTION` in `DeleteTextTransaction::UndoTransaction`\n3. Unnecessary editor reference in `AutoTextEditVerifier`\n4. Bad error handlings in `Do*Text` methods which may ignore `NS_ERROR_EDITOR_DESTROYED`\n5. Unsafe `Destroyed` check remove in `EditorBase::InsertTextIntoTextNodeWithTransaction`\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327721\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329702\n", "files": ["editor/libeditor/CompositionTransaction.cpp", "editor/libeditor/DeleteTextTransaction.cpp", "editor/libeditor/EditorBase.cpp"], "git_node": "b7325b27ee8ce15e9c7c8b0a4ca4ec4995aad021", "git_parents": ["a84a85546d30f1ab24d61fef12174ffebfab9ac3"], "node": "020ccbe428b4f84117f54feb7816a5b786be9807", "parents": ["575a6c0e31492c4e0f33cdc6cf81a494accb1dc9"], "tags": []}], "date": 1790739414, "git_changesets": ["a84a85546d30f1ab24d61fef12174ffebfab9ac3", "b7325b27ee8ce15e9c7c8b0a4ca4ec4995aad021"], "user": "dsmith@mozilla.com"}, "720": {"changesets": [{"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 1925691 - Remove stale mac x86_64 screen-capture expectations. r=webrtc-reviewers,mjf a=diannaS DONTBUILD\n\nThese were added by wpt-sync while the SIP-on M4 workers were missing the Screen Recording grant (bug 2073303). Those hosts are fixed and the tests now fail as unexpected passes. Already gone on main.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329767\n", "files": ["testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini"], "git_node": "aed8cbaf9d2f358ee4e39590b66c95b286468888", "git_parents": ["b7325b27ee8ce15e9c7c8b0a4ca4ec4995aad021"], "node": "16768a259f05051603449435ff6e8eb6708af711", "parents": ["020ccbe428b4f84117f54feb7816a5b786be9807"], "tags": []}], "date": 1790789751, "git_changesets": ["aed8cbaf9d2f358ee4e39590b66c95b286468888"], "user": "dsmith@mozilla.com"}, "721": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2075069 - Allow the crash reporter client to send annotations under their altname.  a=diannaS DONTBUILD\n\nThe .extra file uses an annotation's altname when it has one. The Addons annotation is\nwritten as \"Add-ons\". Build the allowlist from the altname when one is set, so it matches the\nnames in the .extra file.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329559\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329695\n", "files": ["toolkit/crashreporter/client/app/build.rs", "toolkit/crashreporter/client/app/src/test.rs"], "git_node": "aee492b6ef9aa8acb519646e4f2a5465020e234b", "git_parents": ["aed8cbaf9d2f358ee4e39590b66c95b286468888"], "node": "8a7ce444749e0d95a3cd574a81255c08f170bdfb", "parents": ["16768a259f05051603449435ff6e8eb6708af711"], "tags": []}], "date": 1790789771, "git_changesets": ["aee492b6ef9aa8acb519646e4f2a5465020e234b"], "user": "dsmith@mozilla.com"}, "722": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2067771 - Use single-handle *-shm locking on Windows network volumes.  a=diannaS\n\nUpstream commit: https://github.com/sqlite/sqlite/commit/28fe5623286bdb4eaf543e7be4dddee5762ee51b\n\nSQLite 3.50 split Windows WAL shared-memory locking across two file handles:\nwinShmNode.hSharedShm for the DMS lock, truncation and the MapViewOfFile\nmapping, plus a per-connection winShm.hShm for the eight WAL lock bytes. That\ndoes not work on network filesystems, so 3.51.0 added\nwinShmNode.bUseSharedLockHandle to restore the single-handle scheme -- but\nselects it with winIsUNCPath(), a string test for a leading \"\\\\\".\n\nA drive letter mapped to an SMB share is on a network filesystem and has no\n\"\\\\\" prefix, so the mitigation never engages and WAL locking fails with\nSQLITE_IOERR.\n\nImport the upstream fix as a local patch until we vendor a release that\ncontains it. It asks the OS rather than parsing the path:\nGetDriveTypeW() == DRIVE_REMOTE, for both \"X:\\...\" and \"\\\\?\\X:\\...\".\n\nOne deliberate divergence from upstream: the osGetDriveTypeW cast keeps\nWINAPI, since GetDriveTypeW is __stdcall and calling it through a __cdecl\npointer drifts ESP by 4 bytes per call on win32.\n\nBug 2016438 is preserved: \"\\\\?\\C:\\...\" on a local volume still takes the fast\npath. GetDriveTypeW() is called once per winShmNode, i.e. once per *-shm\nfile, not per lock.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326859\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329875\n", "files": ["third_party/sqlite3/patches/bug-2067771-win-remote-volume-shm-locking.patch", "third_party/sqlite3/src/sqlite3.c"], "git_node": "ceea7f839d89dcfe82ba20ebe20308c9be0d18da", "git_parents": ["aee492b6ef9aa8acb519646e4f2a5465020e234b"], "node": "30e69c0a42fe8fe9068fc2ae08d59694ef5c1111", "parents": ["8a7ce444749e0d95a3cd574a81255c08f170bdfb"], "tags": []}], "date": 1790790660, "git_changesets": ["ceea7f839d89dcfe82ba20ebe20308c9be0d18da"], "user": "dsmith@mozilla.com"}, "723": {"changesets": [{"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076298 - Update libpng to v1.6.59  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329676\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329745\n", "files": ["media/libpng/ANNOUNCE", "media/libpng/AUTHORS", "media/libpng/CHANGES", "media/libpng/README", "media/libpng/arm/arm_init.c", "media/libpng/arm/filter_neon.S", "media/libpng/libpng-manual.txt", "media/libpng/moz.yaml", "media/libpng/png.c", "media/libpng/png.h", "media/libpng/pngconf.h", "media/libpng/pngget.c", "media/libpng/pnginfo.h", "media/libpng/pngpread.c", "media/libpng/pngpriv.h", "media/libpng/pngread.c", "media/libpng/pngrtran.c", "media/libpng/pngrutil.c", "media/libpng/pngset.c", "media/libpng/pngstruct.h", "media/libpng/pngwrite.c", "media/libpng/pngwutil.c"], "git_node": "15949960ea487e2149a934150c42a0df71f3e859", "git_parents": ["ceea7f839d89dcfe82ba20ebe20308c9be0d18da"], "node": "3ed6cb2969fb1bfa13bd057ee1397f0547d080fe", "parents": ["30e69c0a42fe8fe9068fc2ae08d59694ef5c1111"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076298 - Apply mozilla patches for libpng  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329677\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329746\n", "files": ["media/libpng/arm/arm_init.c", "media/libpng/arm/filter_neon.S", "media/libpng/png.h", "media/libpng/pngget.c", "media/libpng/pnginfo.h", "media/libpng/pngpread.c", "media/libpng/pngpriv.h", "media/libpng/pngread.c", "media/libpng/pngrutil.c", "media/libpng/pngset.c", "media/libpng/pngstruct.h", "media/libpng/pngwrite.c", "media/libpng/pngwutil.c"], "git_node": "4a289f1e0fce4fbaf87affb649bb0bc35d1323c6", "git_parents": ["15949960ea487e2149a934150c42a0df71f3e859"], "node": "ebe25652022cb9c80024501c7adc3ed35bae9da1", "parents": ["3ed6cb2969fb1bfa13bd057ee1397f0547d080fe"], "tags": []}], "date": 1790870638, "git_changesets": ["15949960ea487e2149a934150c42a0df71f3e859", "4a289f1e0fce4fbaf87affb649bb0bc35d1323c6"], "user": "dsmith@mozilla.com"}, "724": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074160: Insert ref.cast for br_on_cast(_fail).  a=diannaS DONTBUILD\n\nInserting an MWasmRefCast along the relevant branch of a\nbr_on_cast(_fail) mirrors what you generally have to do if using\nref.test and ref.cast manually, and the presence of an explicit\nref.cast ensures that nothing gets LICM'd above the test. The cast\nitself ends up being a no-op because of our tests-dominating-casts\noptimizations.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D329255\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329932\n", "files": ["js/src/jit-test/tests/wasm/gc/ref-gvn.js", "js/src/wasm/WasmIonCompile.cpp"], "git_node": "d6821a785a417f94c04f7fc367672281966d8bbe", "git_parents": ["4a289f1e0fce4fbaf87affb649bb0bc35d1323c6"], "node": "e248b99ac120156abbd7fd9ced13735091070e95", "parents": ["ebe25652022cb9c80024501c7adc3ed35bae9da1"], "tags": []}], "date": 1790883157, "git_changesets": ["d6821a785a417f94c04f7fc367672281966d8bbe"], "user": "dsmith@mozilla.com"}, "725": {"changesets": [{"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068420 - Skip the head sentinel,  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328764\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329773\n", "files": ["gfx/cairo/cairo/src/cairo-boxes-intersect.c", "gfx/cairo/moz.yaml", "gfx/cairo/patches/0052-Bug-2068420-skip-head-sentinel.patch"], "git_node": "f30ea00fa9f9a7edd98e7e70960110f364fae308", "git_parents": ["d6821a785a417f94c04f7fc367672281966d8bbe"], "node": "56fa3b3642f1c9da6508c1715857d09ee5496482", "parents": ["e248b99ac120156abbd7fd9ced13735091070e95"], "tags": []}], "date": 1790883331, "git_changesets": ["f30ea00fa9f9a7edd98e7e70960110f364fae308"], "user": "dsmith@mozilla.com"}, "726": {"changesets": [{"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2058800 - Validate mlGuess IPC payloads  a=diannaS DONTBUILD\n\nThe all-frame Pdfjs actor previously forwarded `_mlGuess` requests unchanged to the ML image-to-text pipeline, where a `url` property selects `RawImage.fromURL()` instead of the viewer pixel buffer.\n\nAccept only `{data, width, height, channels}` with byte data, positive integer dimensions, one to four channels, and a matching data length. Malformed payloads return null.\n\nTests cover the validator and direct actor queries from a non-PDF page.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317738\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330236\n", "files": ["toolkit/components/pdfjs/content/PdfjsParent.sys.mjs", "toolkit/components/pdfjs/moz.build", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_mlguess_validation.js", "toolkit/components/pdfjs/test/unit/test_ml_guess_request.js", "toolkit/components/pdfjs/test/unit/xpcshell.toml"], "git_node": "5e63596f18dcefdabf1bda6176ebb015c50fda1c", "git_parents": ["f30ea00fa9f9a7edd98e7e70960110f364fae308"], "node": "33a9281df490bda907d0848fd814af47621715b3", "parents": ["56fa3b3642f1c9da6508c1715857d09ee5496482"], "tags": []}], "date": 1790883461, "git_changesets": ["5e63596f18dcefdabf1bda6176ebb015c50fda1c"], "user": "dsmith@mozilla.com"}, "727": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068338: Alias CurrentState in SetFontInternalDisconnected.  a=diannaS\n\nThis prepares future uplifts to map more cleanly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324734\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330170\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "79c174a2b1dc37594f18c8fa41f3bb1df4de667d", "git_parents": ["5e63596f18dcefdabf1bda6176ebb015c50fda1c"], "node": "916f7a51ed9995df812eb2a4b48e7e6fc74392ca", "parents": ["33a9281df490bda907d0848fd814af47621715b3"], "tags": []}], "date": 1790892268, "git_changesets": ["79c174a2b1dc37594f18c8fa41f3bb1df4de667d"], "user": "dsmith@mozilla.com"}, "728": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076269 part 1 - Ensure the default array shape exists for MIR ops depending on this.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330003\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330124\n", "files": ["js/src/jit/CacheIR.cpp", "js/src/jit/WarpOracle.cpp"], "git_node": "4f814157e04f69a9545d40cd9bc8612e919fde32", "git_parents": ["79c174a2b1dc37594f18c8fa41f3bb1df4de667d"], "node": "98b1c7d2b6a17cac6443af89567bba30ded7dceb", "parents": ["916f7a51ed9995df812eb2a4b48e7e6fc74392ca"], "tags": []}], "date": 1790944774, "git_changesets": ["4f814157e04f69a9545d40cd9bc8612e919fde32"], "user": "dmeehan@mozilla.com"}, "729": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068407 - Stop main-thread code from racing on ThreadSafeRequestHandle::mRequest  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326183\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330131\n", "files": ["dom/workers/ScriptLoader.cpp", "dom/workers/loader/CacheLoadHandler.cpp", "dom/workers/loader/NetworkLoadHandler.cpp", "dom/workers/loader/WorkerLoadContext.cpp", "dom/workers/loader/WorkerLoadContext.h"], "git_node": "48a0