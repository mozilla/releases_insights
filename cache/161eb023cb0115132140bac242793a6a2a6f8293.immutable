s:72409:"{
"lastpushid": 320,
"pushes": {"69": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1717917 - disable browser/components/preferences/tests/ for Windows 32-bit opt. r=Gijs a=test-only DONTBUILD\n\n\nThe tests frequently experienced out of memory issues and the fix won't be\nbackported to ESR91.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126700", "files": ["browser/components/preferences/tests/browser.ini"], "git_node": null, "git_parents": [null], "node": "31ebe7d7dbde0c579046cf07b4ac7f0c4868323f", "parents": ["5d4ad120b8d41af6d9452a0572e774865f110e0e"], "tags": []}], "date": 1632760055, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "70": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 5d4ad120b8d41af6d9452a0572e774865f110e0e with FIREFOX_91_2_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "aab57b70169f6789ea80c0136206ae920df9aedc", "parents": ["31ebe7d7dbde0c579046cf07b4ac7f0c4868323f"], "tags": []}], "date": 1632847720, "git_changesets": [null], "user": "ffxbld"}, "71": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127412", "files": ["netwerk/dns/effective_tld_names.dat", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "e113c613582834bd7460eba132a6f8df920b095b", "parents": ["aab57b70169f6789ea80c0136206ae920df9aedc"], "tags": []}], "date": 1633355832, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "72": {"changesets": [{"author": "Ben Hearsum \u003cbhearsum@mozilla.com\u003e", "branch": "default", "desc": "No bug: Disable periodic updates on esr78. r=jcristau, a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127433", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "1e0d20ad94c1993a337889d3fb045c0a204ef9da", "parents": ["e113c613582834bd7460eba132a6f8df920b095b"], "tags": []}], "date": 1633359771, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "73": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "9ee9c84c72a7116201300a2101210057a059fd71", "parents": ["1e0d20ad94c1993a337889d3fb045c0a204ef9da"], "tags": []}], "date": 1633378173, "git_changesets": [null], "user": "ffxbld-merge"}, "74": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 5d4ad120b8d41af6d9452a0572e774865f110e0e with FIREFOX_91_2_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "1e89fc0fab6eb0e82f500fc85416a730d90a97d3", "parents": ["9ee9c84c72a7116201300a2101210057a059fd71"], "tags": []}], "date": 1633437855, "git_changesets": [null], "user": "ffxbld"}, "75": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1727345 - Add test for fullscreen warning on display none iframe; r=Gijs a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123643", "files": ["browser/base/content/test/fullscreen/browser.ini", "browser/base/content/test/fullscreen/browser_fullscreen_warning.js"], "git_node": null, "git_parents": [null], "node": "5e0812568feff426db8011f259fa4c593af369a8", "parents": ["1e89fc0fab6eb0e82f500fc85416a730d90a97d3"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1731665 - tests, r=NeilDeakin a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124269", "files": ["browser/modules/test/browser/formValidation/browser.ini", "browser/modules/test/browser/formValidation/browser_validation_navigation.js"], "git_node": null, "git_parents": [null], "node": "ebfc9cc72d3963cfb2c4b56cc5ef60b5baf18285", "parents": ["5e0812568feff426db8011f259fa4c593af369a8"], "tags": []}, {"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1727565 - enforce microseconds value in timestamp even if value is 0 to match parser expectation in graph builder. r=pmoore, a=release\n\nBug 1690947 started to parse timestamp strings provided for task expiration and\ndeadline which lacked the milliseconds part if the microseconds including\nmilliseconds had a value of 0 (because Python's `isoformat()` method got used\nwithout enforcing the precision).\n\nThis caused the graph builder in the Gecko decision task to fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125958", "files": ["taskcluster/taskgraph/test/test_util_parameterization.py", "taskcluster/taskgraph/test/test_util_time.py", "taskcluster/taskgraph/util/time.py"], "git_node": null, "git_parents": [null], "node": "0124fa25f70ef34bf707455c4886cfe125600081", "parents": ["ebfc9cc72d3963cfb2c4b56cc5ef60b5baf18285"], "tags": []}], "date": 1633445040, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "76": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127794", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "cca568abd165953ca380acf1ba7c3e7b425b6133", "parents": ["0124fa25f70ef34bf707455c4886cfe125600081"], "tags": []}, {"author": "Matt Woodrow \u003cmwoodrow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1726663 - Don't restrict fallback painting to the building rect, since it can be incorrect and is going to be removed soon. r=miko a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125002", "files": ["layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/reftests/bugs/1726663-1-ref.html", "layout/reftests/bugs/1726663-1.html", "layout/reftests/bugs/reftest.list"], "git_node": null, "git_parents": [null], "node": "8d12483380d10931c4d1a9249669d04a1b0d0948", "parents": ["cca568abd165953ca380acf1ba7c3e7b425b6133"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1733053 - Part 1: Update tzdata in ICU data files to 2021a1. r=dminor, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126882", "files": ["config/external/icu/data/icudt69l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/timezoneTypes.res", "intl/tzdata/source/be/windowsZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/timezoneTypes.res", "intl/tzdata/source/ee/windowsZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/timezoneTypes.res", "intl/tzdata/source/le/windowsZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/windowsZones.txt", "intl/tzdata/source/zoneinfo64.txt"], "git_node": null, "git_parents": [null], "node": "877d5a2fd522fef5b5bc80e1ff7968a95a98d849", "parents": ["8d12483380d10931c4d1a9249669d04a1b0d0948"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1733053 - Part 2: Update tests for tzdata2021a1. r=dminor, a=RyanVM\n\n- Manually edited \"timeZone_version.js\" because \"tzdata2021a1\" is a non-standard\n  release. The official release is \"tzdata2021b\", but ICU decided to only backport\n  some changes and instead use the release number \"tzdata2021a1\". Because the\n  release \"tzdata2021a1\" is not an official IANA tzdata release, the python script\n  which generates \"timeZone_version.js\" couldn't be run.\n\n- Update \"time-zones-imported.js\" to match the new time zone information from\n  tzdata2021{b,a1}.\n\nDepends on D126882\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126883", "files": ["js/src/tests/non262/Date/time-zones-imported.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js"], "git_node": null, "git_parents": [null], "node": "01180352f058b8b357594fe9050befdc8aa90a80", "parents": ["877d5a2fd522fef5b5bc80e1ff7968a95a98d849"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1661869 - Fix screenshotting of WebGL canvases. r=lsalzman, a=RyanVM\n\nFor WebGL canvases with preserveDrawingBuffer:false, frontbuffer\nsnapshotting was not working properly.\nIf the frontbuffer had no user-fb associated with it,\nwas inexplicably calling BindDefaultFBForRead, which binds\n*webgl*'s default FB, not *gl*'s default FB 0.\nThis caused frontbuffer snappshotting to actually snapshot the (cleared)\nbackbuffer instead of the visible frontbuffer contents.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126024", "files": ["dom/canvas/WebGLContext.cpp"], "git_node": null, "git_parents": [null], "node": "2d2658a85cef449112b47a50e161999df563e81f", "parents": ["01180352f058b8b357594fe9050befdc8aa90a80"], "tags": []}, {"author": "Harry Twyford \u003chtwyford@mozilla.com\u003e", "branch": "default", "desc": "Bug 1724956 - Use system colors on :root on Windows 10 when compacttheme.css is active. r=dao, a=RyanVM\n\nThis bug was introduced with the Proton tab design. Since we no longer draw a background behind inactive tabs, tabs are not legible against some accent colors. This problem is especially bad in brighttext themes. This patch also fixes 1714507, since the tabs are now legible against the light gray inactive window color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125213", "files": ["browser/themes/windows/browser.css", "browser/themes/windows/compacttheme.css"], "git_node": null, "git_parents": [null], "node": "e5be4545d68eb363e8ee4a5140c85fbd088c44ca", "parents": ["2d2658a85cef449112b47a50e161999df563e81f"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1721458 - only guard the first sample on Windows10. r=bryce, a=RyanVM\n\nOnly enable guarding the first invalid sample on Windows 10 and add some debug info in logging.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123969", "files": ["dom/media/platforms/wmf/WMFMediaDataDecoder.cpp", "dom/media/platforms/wmf/WMFVideoMFTManager.cpp"], "git_node": null, "git_parents": [null], "node": "847824e719ff2bc57b9fccc497ba32b5c98c20d5", "parents": ["e5be4545d68eb363e8ee4a5140c85fbd088c44ca"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1729420 - part1 : compare the output to the inputs in order to determine if it's an invalid first sample or not. r=bryce, a=RyanVM\n\nThe old way to guard the first sample is incorrect because of following reasons.\n\n1. the demuxed samples for h264 are stored in DTS order\nThat mean the first sample we gave MFT decoder might not be the earliest (have latter PTS) So it would incorrectly discard some useful frames.\n\n2. it conflicts with the seek threashold set from the format reader\nWe will set a threshold to guard the first sample only if MFT manager doesn't have the seek threshold. If the MFT has set that before, the old mechanism would set the guard threshold based on the timestamp of non-first input sample, which also causes discarding wrong frames.\n\nTherefore, this patch use a new method to distinguish if the first output frame is invalid. If the FIRST output has zero timestamp and it doesn't belong to any input we gave to the decoder, then it's highly possible an invalid frame which should be discarded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124858", "files": ["dom/media/platforms/wmf/WMFMediaDataDecoder.cpp", "dom/media/platforms/wmf/WMFMediaDataDecoder.h"], "git_node": null, "git_parents": [null], "node": "41935c7e3418900e5336f2184d48770a9b8f8a56", "parents": ["847824e719ff2bc57b9fccc497ba32b5c98c20d5"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1729420 - part2 : add a ref-test to check frame order. r=bryce, a=RyanVM\n\nAdd a new reftest but still skip on Android because there are way more pixel color differences which would make the fuzzy range super large and might cause the incorrect pass.\n\nEnabling the pref for the test is because we want to prevent entering the dormant state which would release the decoder and then we would fail to reproduce the issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124882", "files": ["dom/media/test/reftest/frame_order.mp4", "dom/media/test/reftest/frame_order_mp4-ref.html", "dom/media/test/reftest/frame_order_mp4.html", "dom/media/test/reftest/reftest.list"], "git_node": null, "git_parents": [null], "node": "b5644469435492d7940893464600a625d1588f26", "parents": ["41935c7e3418900e5336f2184d48770a9b8f8a56"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1729420 - part3 : make generateREF.html easier to be used and fix the cross-origin error during capturing the video frame. r=bryce, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124953", "files": ["dom/media/test/reftest/generateREF.html"], "git_node": null, "git_parents": [null], "node": "23286eb22089a33caf64a07d962ea36d9996d233", "parents": ["b5644469435492d7940893464600a625d1588f26"], "tags": []}], "date": 1633633299, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "77": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128058", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "bbe2d2dfd724c3b1e072a6df171fe228bc8668d7", "parents": ["23286eb22089a33caf64a07d962ea36d9996d233"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1724553 - Fix include files in js/public/String.h. r=tcampbell, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D122185", "files": ["js/public/String.h"], "git_node": null, "git_parents": [null], "node": "4763c2bc0e1c7ec5f0772750b24ea5e2d7aeb701", "parents": ["bbe2d2dfd724c3b1e072a6df171fe228bc8668d7"], "tags": []}, {"author": "Kris Wright \u003ckwright@mozilla.com\u003e", "branch": "default", "desc": "Bug 1730958 - Fix some #ifdefs in static prefs. r=valentin, a=RyanVM\n\nIt looks like these were formatted wrong by mistake, and so the final `else` value in both instances was being used as the default value on all platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125753", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "337cf2eba87f94737589c2c67894f175f973992d", "parents": ["4763c2bc0e1c7ec5f0772750b24ea5e2d7aeb701"], "tags": []}, {"author": "Robert Mader \u003crobert.mader@posteo.de\u003e", "branch": "default", "desc": "Bug 1710400 - Blocklist HW-WR on Intel DDX driver, r=aosmond a=RyanVM\n\nThe Intel DDX driver is known to cause troubles with HW-WR and\nhas been deprecated by most distributions, in favor of the glamor\nbased \"modesetting\" driver.\n\nLets blocklist it. This will mostly affect older/legacy setups.\n\nNote: the xrandr boilerplate code in glxtest will be useful for\nbetter multi-screen detection in a follow up patch. The current\nlegacy X11 screen detection does not work in composited environments,\nalways reporting one single big screen with the combined size.\nXrandr allows for correct detection in such setups.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126221", "files": ["toolkit/xre/glxtest.cpp", "widget/gtk/GfxInfo.cpp", "widget/gtk/GfxInfo.h"], "git_node": null, "git_parents": [null], "node": "95c4aa0fd3dab04aec9981111cc3da2ad1d400b6", "parents": ["337cf2eba87f94737589c2c67894f175f973992d"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1732999 - Annotate intentional crash when testing buildid mismatch. r=mccr8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126905", "files": ["ipc/glue/MessageChannel.cpp"], "git_node": null, "git_parents": [null], "node": "8d3d5c21b721da3dc3572e60dcb891a706760265", "parents": ["95c4aa0fd3dab04aec9981111cc3da2ad1d400b6"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1733129 - browser_WebrtcGlobalInformation.js should call NoteIntentionalCrash in processes it is killing. r=kmag, a=RyanVM\n\nDoing so will prevent the leak checker from reporting an error when it\nfails to find a leak log.\n\nThis test was previously disabled on Windows due to the failures, so we\ncan re-enable it now, hopefully.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126954", "files": ["browser/base/content/test/webrtc/browser.ini", "browser/base/content/test/webrtc/browser_WebrtcGlobalInformation.js"], "git_node": null, "git_parents": [null], "node": "6015e8dd442ce4896e7ab3f9487eb72e40126a49", "parents": ["8d3d5c21b721da3dc3572e60dcb891a706760265"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1733660 - Keep finbar textbox focus ring within the textbox bounds so it doesn't overflow the findbar container. r=Itiel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127443", "files": ["toolkit/themes/shared/findbar.css"], "git_node": null, "git_parents": [null], "node": "d3d4309e8f95ebe5081f596bfbd840cf6f156ccf", "parents": ["6015e8dd442ce4896e7ab3f9487eb72e40126a49"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1733126 - Add an annotation for the leak checker in about:processes tests. r=kmag, a=RyanVM\n\nThis test kills a child process when Fission is enabled. Add an annotation\nto the leak log for the process so that the leak checker doesn't produce an\nerror.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126963", "files": ["toolkit/components/aboutprocesses/tests/browser/head.js"], "git_node": null, "git_parents": [null], "node": "32c499749b7d44f073f2c191432187dac8a9f560", "parents": ["d3d4309e8f95ebe5081f596bfbd840cf6f156ccf"], "tags": []}], "date": 1633959583, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "78": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out 2 changesets (bug 1715414)\n\nBacked out changeset 3324c4932248 (bug 1715414)\nBacked out changeset a068798ccdf5 (bug 1715414)", "files": ["taskcluster/ci/test/misc.yml", "toolkit/components/telemetry/tests/marionette/tests/client/manifest.ini"], "git_node": null, "git_parents": [null], "node": "e1a3b77fc5f3db4f0afdf8fb8f1a17b58ac0b0eb", "parents": ["32c499749b7d44f073f2c191432187dac8a9f560"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1715414 - Start PBackground earlier in content processes. r=nika, a=RyanVM\n\nPreviously we were staring `PBackground` in content processes in\nresponse to receiving the `SetXPCOMProcessAttributes` IPC message, which\nis sent immediately after the process is launched.  Meanwhile, the\nidle scheduler tries to use PBackground when the main thread considers\nitself idle.  But if thread scheduling is such that the content process\nmain thread becomes idle before the IPC I/O thread has received and\ndispatched that message, then we have a problem (signaled by an assertion\nfailure).\n\nThis patch moves content process `PBackground` startup earlier, to the\nend of `ContentProcess::Init`; that point is after enough of IPC and\nXPCOM is started for it to work, but before we start spinning the main\nthread event loop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126144", "files": ["dom/ipc/ContentChild.cpp", "dom/ipc/ContentProcess.cpp", "ipc/glue/BackgroundChild.h"], "git_node": null, "git_parents": [null], "node": "06a904f58de587fcc36a718aee6555f545368df9", "parents": ["e1a3b77fc5f3db4f0afdf8fb8f1a17b58ac0b0eb"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710731 - avoid unnecessary PKCS#11 module PIN prompts when looking for client certificates. r=rmf, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D122398", "files": ["security/manager/ssl/nsNSSComponent.cpp"], "git_node": null, "git_parents": [null], "node": "4c8b37c0072d87fd7b69cf15584b52d92934d432", "parents": ["06a904f58de587fcc36a718aee6555f545368df9"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1730625 - Walk the flat tree to search for links. r=smaug, a=RyanVM\n\nAlso make some other context-menu code a lot more straight-forward, and\nremove some enabledness checks now that shadow dom can't be disabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125487", "files": ["browser/actors/ContextMenuChild.jsm", "browser/base/content/test/contextMenu/browser_contextmenu.js", "browser/base/content/test/contextMenu/subtst_contextmenu.html"], "git_node": null, "git_parents": [null], "node": "641d04aa8bd0b708ce7079a0fb6e42f5c391084c", "parents": ["4c8b37c0072d87fd7b69cf15584b52d92934d432"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1731886 - Use release asserts for WebIDL union getters. r=peterv, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126293", "files": ["dom/bindings/Codegen.py"], "git_node": null, "git_parents": [null], "node": "7318e2afb63a6ee1788ff45238876927de261f91", "parents": ["641d04aa8bd0b708ce7079a0fb6e42f5c391084c"], "tags": []}, {"author": "Itiel \u003citiel_yn8@walla.com\u003e", "branch": "default", "desc": "Bug 1713133 - Don't apply borders on about:logins's menuitems. r=sfoster, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126584", "files": ["browser/components/aboutlogins/content/components/menu-button.css"], "git_node": null, "git_parents": [null], "node": "c6dc5f55a270767c746b055759b08d7ea0bd8d05", "parents": ["7318e2afb63a6ee1788ff45238876927de261f91"], "tags": []}], "date": 1634087825, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "79": {"changesets": [{"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1695645 - \"Sheets of paper\" does not update when selecting \"Print on both sides\" r=emilio, a=RyanVM\n\nAccount for duplex mode when calculating the number of sheets of paper for the print dialog and printing to a device (not file).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125336", "files": ["toolkit/components/printing/content/print.js", "toolkit/components/printing/tests/browser_sheet_count.js"], "git_node": null, "git_parents": [null], "node": "4a2d3f24552e80d50177701fc905b1cc8f58b6d7", "parents": ["c6dc5f55a270767c746b055759b08d7ea0bd8d05"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1726813: Ensure AppShutdown remains in sync with shutdown notifications in the parent process. r=nika,asuth a=RyanVM\n\nThe goal here is to ensure we can always rely on `AppShutdown::GetShutdownPhase` to be in sync with the \"real\" application status, mainly this was needed for xpcshell tests to not break if we add assertions on our shutdown state on some global singletons.\n\nWe keep the existing observer notification topics but force them (on the parent process) to be issued through the new `advanceShutdownPhase` function of the startup service using the `ShutdownPhase` enum. This way we can synchronize `AppShutdown`'s internal status accordingly.\n\nSome further notes:\n\n  # The `MOZ_ASSERT(AppShutdown::IsNoOrLegalShutdownTopic(aTopic));` in `NotifyObservers` helped a lot to identify missing cases. I think we should keep it in order to stay safe.\n  # Introducing the `cenum IDLShutdownPhase` helps to keep the knowledge about the mapping from shutdown phases to observer topics exclusively inside AppShutdown.cpp. Still callers must know what they do in order to choose a proper phase, of course.\n  # However we must be aware that `AppShutdown` this way can be kept in sync with the shutdown notifications only in the parent process and that `GetCurrentShutdownPhase` might not give the correct result in child processes. We might want to file a follow up bug that adds some asserts to avoid improper use of `AppShutdown` functions in child processes (but I do not want to make this patch bigger as needed to solve the blocking dependency for bug 1697972).\n  # The socket process is one example of a child process that \"overloads\" shutdown topics. I was wondering if it is the right call to use the very same topic names here to request shutdown to the socket process or if it should have its own topics. Those topics triggered the assert and thus I had to disable it for child processes, for now.\n  # This goes together with the more general approach to define process type specific shutdown phases (and hence mappings to topics) as drafted very roughly in bug 1697745.\n  # This patch seemed to trigger a known intermittent more often, thus the change here in `ServiceWorkerManager`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124350", "files": ["dom/serviceworkers/ServiceWorkerManager.cpp", "netwerk/test/unit/test_cookies_upgrade_10.js", "security/manager/ssl/tests/unit/test_sss_sanitizeOnShutdown.js", "testing/xpcshell/head.js", "toolkit/components/startup/nsAppStartup.cpp", "toolkit/components/startup/public/nsIAppStartup.idl", "toolkit/crashreporter/test/unit/test_crash_AsyncShutdown.js", "toolkit/mozapps/downloads/tests/unit/head_downloads.js", "toolkit/mozapps/extensions/test/xpcshell/test_shutdown_early.js", "tools/fuzzing/interface/harness/FuzzerTestHarness.h", "xpcom/base/AppShutdown.cpp", "xpcom/base/AppShutdown.h", "xpcom/ds/nsIObserverService.idl", "xpcom/ds/nsObserverService.cpp", "xpcom/tests/TestHarness.h"], "git_node": null, "git_parents": [null], "node": "fdd61e2fcc666cc63f8a42616f575b5ee9f9f357", "parents": ["4a2d3f24552e80d50177701fc905b1cc8f58b6d7"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1678896: Repair old typo in test_BHRObserver.js that recently caused intermittent failures. r=mossop, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125249", "files": ["toolkit/components/backgroundhangmonitor/tests/test_BHRObserver.js"], "git_node": null, "git_parents": [null], "node": "1196edcf79040907a98eadfcef6dbd90d9400e92", "parents": ["fdd61e2fcc666cc63f8a42616f575b5ee9f9f357"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1723468 - Disable shared font list on ESR91. r=jfkthame, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128306", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "6b6cd7f6837b2cef2937a735d48a610010032f70", "parents": ["1196edcf79040907a98eadfcef6dbd90d9400e92"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1719279 - Properly add $HOME/.cache/fontconfig allowance. r=gcp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D119178", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp", "security/sandbox/test/browser_content_sandbox_fs.js"], "git_node": null, "git_parents": [null], "node": "f55f3824491516f380bd1009176a042ace211186", "parents": ["6b6cd7f6837b2cef2937a735d48a610010032f70"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1718084 - Reorganize test for lower complexity. r=gcp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D119375", "files": ["security/sandbox/test/browser.ini", "security/sandbox/test/browser_content_sandbox_fs.js", "security/sandbox/test/browser_content_sandbox_fs_tests.js", "security/sandbox/test/browser_content_sandbox_utils.js"], "git_node": null, "git_parents": [null], "node": "cff20b995d569cf11eafd642b45ba91a08bef1e3", "parents": ["f55f3824491516f380bd1009176a042ace211186"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1718084 - Block access to $HOME/.config/mozilla/. r=gcp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D119180", "files": ["security/sandbox/linux/broker/SandboxBroker.cpp", "security/sandbox/linux/broker/SandboxBroker.h", "security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": null, "git_parents": [null], "node": "5f420e89059c72f64cf2ad6a646ecf55007a0aa1", "parents": ["cff20b995d569cf11eafd642b45ba91a08bef1e3"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1718084 - Test allow $HOME/.config and block $HOME/.config/mozilla/. r=gcp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D119179", "files": ["security/sandbox/moz.build", "security/sandbox/test/browser.ini", "security/sandbox/test/browser_content_sandbox_fs.js", "security/sandbox/test/browser_content_sandbox_fs_tests.js", "security/sandbox/test/browser_content_sandbox_fs_xdg.js", "security/sandbox/test/browser_content_sandbox_utils.js", "security/sandbox/test/browser_xdg.ini"], "git_node": null, "git_parents": [null], "node": "27c27a50b68fdf988ec2758a9ec8c05a31e5ba8f", "parents": ["5f420e89059c72f64cf2ad6a646ecf55007a0aa1"], "tags": []}, {"author": "Olivier Tilloy \u003colivier@tilloy.net\u003e", "branch": "default", "desc": "Bug 1732580 - Allow read access to files under $SNAP/ in the webcontent sandbox. r=gcp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127565", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp", "security/sandbox/moz.build", "security/sandbox/test/browser_content_sandbox_fs_snap.js", "security/sandbox/test/browser_content_sandbox_fs_tests.js", "security/sandbox/test/browser_snap.ini"], "git_node": null, "git_parents": [null], "node": "13c638762db714698435ee3b41763d66edab9bac", "parents": ["27c27a50b68fdf988ec2758a9ec8c05a31e5ba8f"], "tags": []}], "date": 1634139089, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "80": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1735588 - Pref off OMT font list on ESR91 to avoid macOS assertion failures. r=jfkthame, a=bustage", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "c6f05ffc58100f4b85a11d340a3f23ba5e35dce8", "parents": ["13c638762db714698435ee3b41763d66edab9bac"], "tags": []}], "date": 1634143744, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "81": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128467", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "fb134e765167c5111e995b54ab28301085e882fa", "parents": ["c6f05ffc58100f4b85a11d340a3f23ba5e35dce8"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1718571, r=mtigley,pbz a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127696", "files": ["browser/base/content/browser.js"], "git_node": null, "git_parents": [null], "node": "2d31bb84822b5ed97681dcde4be315b6b5f6d6b8", "parents": ["fb134e765167c5111e995b54ab28301085e882fa"], "tags": []}, {"author": "Dragana Damjanovic \u003cdd.mozilla@gmail.com\u003e", "branch": "default", "desc": "Bug 1730935 - Disable Opportunistic Encryption, the feature has a low usage. r=kershaw,valentin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127426", "files": ["modules/libpref/init/all.js", "netwerk/test/unit/test_http3.js"], "git_node": null, "git_parents": [null], "node": "821ded0b92ba2d08c5e25167332c61c6a35bec33", "parents": ["2d31bb84822b5ed97681dcde4be315b6b5f6d6b8"], "tags": []}], "date": 1634252862, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "82": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1735612 - Don't assert if CreateCGFontWithVariations is called with no variations; just return null and let the caller handle fallback. r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128489", "files": ["gfx/2d/ScaledFontMac.cpp"], "git_node": null, "git_parents": [null], "node": "eee06437fffbffe239a6807eb9d8aca0adb7ee64", "parents": ["821ded0b92ba2d08c5e25167332c61c6a35bec33"], "tags": []}, {"author": "Dragana Damjanovic \u003cdd.mozilla@gmail.com\u003e", "branch": "default", "desc": "Bug 1735309 - Use PK11_ImportDataKey for FIPS safety. r=valentin, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128185", "files": [".cargo/config.in", "Cargo.lock", "netwerk/socket/neqo_glue/Cargo.toml", "netwerk/test/http3server/Cargo.toml", "third_party/rust/neqo-crypto/.cargo-checksum.json", "third_party/rust/neqo-crypto/bindings/bindings.toml", "third_party/rust/neqo-crypto/src/hkdf.rs", "third_party/rust/neqo-crypto/src/selfencrypt.rs", "third_party/rust/neqo-crypto/tests/aead.rs", "third_party/rust/neqo-crypto/tests/hkdf.rs", "third_party/rust/neqo-crypto/tests/hp.rs", "third_party/rust/neqo-transport/.cargo-checksum.json", "third_party/rust/neqo-transport/src/crypto.rs", "third_party/rust/neqo-transport/src/packet/retry.rs", "third_party/rust/neqo-transport/tests/common/mod.rs"], "git_node": null, "git_parents": [null], "node": "c568ed428f7595513664589096f55a74c0735824", "parents": ["eee06437fffbffe239a6807eb9d8aca0adb7ee64"], "tags": []}, {"author": "Sergey Galich \u003csgalich@mozilla.com\u003e", "branch": "default", "desc": "Bug 1730194 - Prevent Copy button to send information to Cloud Clipboard and Clipboard History on Windows. r=dimi,johannh,cmartin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125831", "files": ["browser/components/aboutlogins/AboutLoginsChild.jsm", "modules/libpref/init/StaticPrefList.yaml", "widget/nsClipboardHelper.cpp", "widget/nsIClipboardHelper.idl", "widget/windows/nsClipboard.cpp"], "git_node": null, "git_parents": [null], "node": "8e2b9a337281d19bff5e1f16b835f84047c1aa0c", "parents": ["c568ed428f7595513664589096f55a74c0735824"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1366818, r=emilio, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D122785", "files": ["browser/actors/FormValidationParent.jsm", "layout/xul/nsMenuPopupFrame.cpp"], "git_node": null, "git_parents": [null], "node": "41aba950cd860998119646bc7becbc4995051794", "parents": ["8e2b9a337281d19bff5e1f16b835f84047c1aa0c"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1730156 - Do not create DispatchChangeEventCallback if associated HTMLInputElement has no scriptGlobalObject. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126095", "files": ["dom/html/HTMLInputElement.cpp"], "git_node": null, "git_parents": [null], "node": "1e024e57bb82cf8035e42807e658e95896cb64f8", "parents": ["41aba950cd860998119646bc7becbc4995051794"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1735152 - Avoid using NS_ADDREF in nsSocketTransport. r=dragana, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128088", "files": ["netwerk/base/nsSocketTransport2.cpp"], "git_node": null, "git_parents": [null], "node": "9e341f07e58d11e77cda828f0ac0275b8d1f2f75", "parents": ["1e024e57bb82cf8035e42807e658e95896cb64f8"], "tags": []}], "date": 1634315396, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "83": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1725573 - Add color profile remoting for GTK. r=aosmond,AlexandruIonescu a=RyanVM\n\nPreviously, content processes would try to contact the X server\ndirectly during startup to read color calibration information; with\n`dom.ipc.avoid-gtk` this doesn't work because the process is in headless\nmode.  This patch extends the color profile IPC facility added in bug\n1540776 for Windows sandboxing (win32k lockdown) to GTK under X11.\n(Currently there's no support for color management under Wayland, so\nthere's nothing for this patch to fix in that case.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124507", "files": ["browser/base/content/test/performance/browser_preferences_usage.js", "gfx/thebes/gfxPlatformGtk.cpp", "gfx/thebes/gfxPlatformGtk.h"], "git_node": null, "git_parents": [null], "node": "002d4a010c5a233d215616ed2b40672bfba1a620", "parents": ["9e341f07e58d11e77cda828f0ac0275b8d1f2f75"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1735266. Call GetExtantDoc instead of GetDoc in CollectFrameTreeData so we don't potentially create a doc where non existed before. r=farre, a=RyanVM\n\nSee https://bugzilla.mozilla.org/show_bug.cgi?id=1725569#c18 for how this causes a test to fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128155", "files": ["toolkit/components/sessionstore/SessionStoreUtils.cpp"], "git_node": null, "git_parents": [null], "node": "bc409de84a538b446b2b9a99da26ad9565e2054f", "parents": ["002d4a010c5a233d215616ed2b40672bfba1a620"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1725569. Send visualViewport resize events for iframes. r=botond, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127941", "files": ["layout/base/PresShell.h", "layout/generic/nsGfxScrollFrame.cpp", "testing/web-platform/meta/visual-viewport/viewport-resize-event-on-iframe-size-change.html.ini"], "git_node": null, "git_parents": [null], "node": "fc62b3eb0862bd1d86ccbf9b41f0026dfa07ffbe", "parents": ["bc409de84a538b446b2b9a99da26ad9565e2054f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1732961 - DNSOverHTTPS policy test should use https. r=mkaply, a=RyanVM\n\nWhile it doesn't make much of a difference for the prefs, setting them to a\nplain http:// scheme makes it be ignored by the TRR implementation and has\nno effect. I'd hate it to have other people copy paste this code and not\nunderstand why TRR isn't working.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126958", "files": ["browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "23063aec1b963c325957d38a16516f7245aba8e9", "parents": ["fc62b3eb0862bd1d86ccbf9b41f0026dfa07ffbe"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1732961 - Add test that setting DNSOverHTTPS policy is reflected in about:preferences. r=nhnt11, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126959", "files": ["browser/components/preferences/tests/browser_connection_dnsoverhttps.js"], "git_node": null, "git_parents": [null], "node": "8ffce744fa46d352e930c9cb77551c3b387b8440", "parents": ["23063aec1b963c325957d38a16516f7245aba8e9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1732961 - Add xpcshell-test for setting an enterprise policy for DNSOverHTTPS. r=nhnt11, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126960", "files": ["netwerk/test/unit/test_trr_enterprise_policy.js", "netwerk/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "7caff1c65d4f67c6bfb6a2cb0adf7d7b9a259aee", "parents": ["8ffce744fa46d352e930c9cb77551c3b387b8440"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1732961 - TRR should not be ignoring enterprise policy value of network.trr.uri/mode. r=nhnt11, a=RyanVM\n\nIn bug 1626057 we added support for steering. There we made the distinction\nbetween a default network.trr.uri pref, and a user-set one by using\n`Preferences::HasUserValue`. However, it seems that enterprise policies change\nthe default branch of the pref, so this would lead to it having a lower\npriority than DoHRollout or steering.\n\nIn bug 1713036 we introduced `network.trr.default_provider_uri` and made\n`network.trr.uri` an empty string, so checking hasUserValue isn't required\nanymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126961", "files": ["netwerk/dns/TRRService.cpp", "netwerk/dns/TRRServiceBase.cpp", "netwerk/dns/TRRServiceBase.h", "netwerk/dns/TRRServiceParent.cpp"], "git_node": null, "git_parents": [null], "node": "9506ff8bf895cec81d164a9bca7671680b937984", "parents": ["7caff1c65d4f67c6bfb6a2cb0adf7d7b9a259aee"], "tags": []}], "date": 1634325662, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "84": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128721", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "60fe21433518edaf415b1390dd5dc6fa78933ef9", "parents": ["9506ff8bf895cec81d164a9bca7671680b937984"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1730750 - Exit fullscreen when the inner window is no longer active; r=NeilDeakin, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127528", "files": ["browser/actors/DOMFullscreenChild.jsm"], "git_node": null, "git_parents": [null], "node": "81ac07c7378f3f316527ceb8b3800c1bf80f6f0f", "parents": ["60fe21433518edaf415b1390dd5dc6fa78933ef9"], "tags": []}, {"author": "William Durand \u003cwill+git@drnd.me\u003e", "branch": "default", "desc": "Bug 1735758 - Add proxy-failover system add-on. r=rpl, a=RyanVM\n\nThis patch contains the following changes:\n\n- Moved the files from https://github.com/mozilla-extensions/proxy-monitor (`extension/*`) to `browser/extensions/proxy-failover`.\n- In `api.js`:\n  - Added license at the top of the file\n  - Added a `globals` comment to tell ESLint about `ExtensionAPI`\n  - Added a comment to disable an ESLint rule on L289 (consistent-return)\n  - Added a comment to disable an ESLint rule on L422 (no-unused-vars)\n  - Reformatted some comment blocks to break ato break at ~80 chars\n- Added `moz.build` to build the `proxy-failover` extension\n- Added `proxy-failover` to the list of built-in system add-ons\n- Added a smoke test to make sure the add-on is loaded\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128466", "files": ["browser/extensions/moz.build", "browser/extensions/proxy-failover/api.js", "browser/extensions/proxy-failover/manifest.json", "browser/extensions/proxy-failover/moz.build", "browser/extensions/proxy-failover/schema.json", "browser/extensions/proxy-failover/tests/browser/browser.ini", "browser/extensions/proxy-failover/tests/browser/browser_extension_loaded.js"], "git_node": null, "git_parents": [null], "node": "04a4927d150f6f5383fe2d6ee2d553cf9110008c", "parents": ["81ac07c7378f3f316527ceb8b3800c1bf80f6f0f"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1729517 - Set up document correctly. r=freddyb,ckerschb a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127981", "files": ["dom/xslt/base/txURIUtils.cpp"], "git_node": null, "git_parents": [null], "node": "e4ea49cad3af3a337c4706ad8e41de379c973e50", "parents": ["04a4927d150f6f5383fe2d6ee2d553cf9110008c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1736545 - WindowGlobal.getExistingActor can return null. r=nika, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128870", "files": ["dom/chrome-webidl/WindowGlobalActors.webidl"], "git_node": null, "git_parents": [null], "node": "21d2ea282c177b0f728e6206ec14d1c012eb5db1", "parents": ["e4ea49cad3af3a337c4706ad8e41de379c973e50"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1724233 - Make sure to run ConvertUTF8toACE before ConvertToDisplayIDN. r=dragana, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128867", "files": ["dom/html/test/test_bug448166.html", "netwerk/base/nsStandardURL.cpp", "netwerk/base/nsStandardURL.h", "netwerk/dns/nsIDNService.cpp", "netwerk/test/unit/test_bug412457.js", "netwerk/test/unit/test_standardurl.js", "testing/web-platform/meta/url/a-element-xhtml.xhtml.ini", "testing/web-platform/meta/url/a-element.html.ini", "testing/web-platform/meta/url/failure.html.ini", "testing/web-platform/meta/url/toascii.window.js.ini", "testing/web-platform/meta/url/url-constructor.any.js.ini"], "git_node": null, "git_parents": [null], "node": "644f5746e3d260e45a6a23728a973ee3ee2b3843", "parents": ["21d2ea282c177b0f728e6206ec14d1c012eb5db1"], "tags": []}, {"author": "Andrew Creskey \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 1718404 - Fix high frequency browser_interactions_typing.js failure. r=Standard8, a=RyanVM\n\nFix a scenario where it was possible, in automation, for the typing interaction time to report 0ms due to rounding of fractional milliseconds.\n\nIn addition, now sending keystrokes individually as this is a better simulation of how users type.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125189", "files": ["browser/components/places/tests/browser/interactions/browser_interactions_typing.js", "dom/events/EventStateManager.cpp"], "git_node": null, "git_parents": [null], "node": "d44045148f21cbab4462f8f6ad0fbf6fd83b3718", "parents": ["644f5746e3d260e45a6a23728a973ee3ee2b3843"], "tags": []}], "date": 1634668442, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "85": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1729001 - Lock pocket new tab in preferences. r=thecount, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125275", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/tests/browser/browser_policy_firefoxhome.js"], "git_node": null, "git_parents": [null], "node": "7005debd8df78311359cb2f1e1020590a5e7f371", "parents": ["d44045148f21cbab4462f8f6ad0fbf6fd83b3718"], "tags": []}, {"author": "pestanoah \u003cpestanoa@msu.edu\u003e", "branch": "default", "desc": "Bug 1727075 - Updated download folder icon to be visible on hover in HCM. r=mhowell,mtigley,dao a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125911", "files": ["toolkit/themes/windows/global/button.css"], "git_node": null, "git_parents": [null], "node": "b8958955e73103b8b97028e774e82fd4625ceca8", "parents": ["7005debd8df78311359cb2f1e1020590a5e7f371"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1733257 - Show better errors when policy JSON fails. r=emalysz, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127001", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.jsm"], "git_node": null, "git_parents": [null], "node": "dcf1d74c2ec348b71a18c93cea3fcafbe023bb00", "parents": ["b8958955e73103b8b97028e774e82fd4625ceca8"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1731494 - fix margins on learn more link in popupnotifications for extension controlled new tab, homepage and tab hiding, r=dao a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127081", "files": ["browser/themes/shared/browser.inc.css"], "git_node": null, "git_parents": [null], "node": "941660be8263c1042b1db3b183230c3d97f8eb2d", "parents": ["dcf1d74c2ec348b71a18c93cea3fcafbe023bb00"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1733475 - Ensure to copy over the viewport/font units invalidation bits when reusing reset properties. r=jfkthame, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127262", "files": ["servo/components/style/properties/cascade.rs", "testing/web-platform/tests/css/css-values/dynamic-viewport-units-rule-cache.html"], "git_node": null, "git_parents": [null], "node": "6c072c3d7d9eb6ac30a2b5e95cda8853ffab3a6e", "parents": ["941660be8263c1042b1db3b183230c3d97f8eb2d"], "tags": []}], "date": 1634673326, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "86": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update,r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129140", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "c495f6f2e7ad83d95431db550aca4611fc18eedc", "parents": ["6c072c3d7d9eb6ac30a2b5e95cda8853ffab3a6e"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1667102 - Add some diagnostic assertions, r=necko-reviewers,dragana,a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124753", "files": ["netwerk/protocol/http/Http2Push.cpp", "netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Session.h", "netwerk/protocol/http/Http2Stream.cpp", "netwerk/protocol/http/Http2Stream.h"], "git_node": null, "git_parents": [null], "node": "fff749a15d5b83858d8f5e516952bf3fc615e5d3", "parents": ["c495f6f2e7ad83d95431db550aca4611fc18eedc"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1667102 - Make sure nsHttpTransaction::mConnection is released on socket thread, r=necko-reviewers,dragana,a=RyanVM\n\nSince `nsHttpTransaction::mConnection` could be `Http2Session` and `Http2Session` supports weak reference, we should make sure `Http2Session` to be always released on socket thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125510", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": null, "git_parents": [null], "node": "c1741d6eb4f0f72fec8d2a81bb730957de7969c3", "parents": ["fff749a15d5b83858d8f5e516952bf3fc615e5d3"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1730048, reorder the code in nsMenuFrame::PassMenuCommandEventToPopupManager a bit, r=mstange a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127596", "files": ["layout/xul/nsMenuFrame.cpp"], "git_node": null, "git_parents": [null], "node": "89303e627ad83afc81eb49e64c37d1218e5a69c1", "parents": ["c1741d6eb4f0f72fec8d2a81bb730957de7969c3"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1725148 - Fix how we find the Xauthority file for sandbox policies. r=gcp, a=RyanVM\n\nIf the `XAUTHORITY` env var is unset, libXau will fall back to\n`$HOME/.Xauthority`, but our content sandbox policy didn't handle that\ncase when it needs to allow access to that file; this patch corrects\nthat oversight.\n\nThis broke WebGL as of bug 1635451, because we no longer eagerly connect\nto the X server before sandbox startup, only as needed for WebGL.\n\nUsually the `XAUTHORITY` env var is set even if the file is in its\ndefault location, but some environments (including but not limited to\nthe Linux VMs on Chrome OS) do not set it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127984", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": null, "git_parents": [null], "node": "6e552c4837ef6da4fb7634195c64ef2f2b9c3e6b", "parents": ["89303e627ad83afc81eb49e64c37d1218e5a69c1"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1735587 - \"Sheets of paper\" incorrect when numCopies\u003e1 and sheetCount is odd. r=emilio, a=RyanVM\n\nMultiply the sheet count by numCopies after accounting for duplex printing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128430", "files": ["toolkit/components/printing/content/print.js", "toolkit/components/printing/tests/browser_sheet_count.js"], "git_node": null, "git_parents": [null], "node": "752116e998380770c7e076ee3b0abef2f5e170fb", "parents": ["6e552c4837ef6da4fb7634195c64ef2f2b9c3e6b"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 1736049 - Stop calling `[[NSCursor currentCursor] set]` on every mouse move. r=emilio, a=RyanVM\n\nThis was only necessary when we had binary plug-ins overriding the cursor from under us.\nWe no longer support plug-ins.\n\nCalling -[NSCursor set] has a performance cost on macOS Monterey when\ncursor accessibility coloring is enabled, so we want to avoid calling it\nunnecessarily. It also leaks memory in the current Monterey Beta (see\nbug 1735345), so calling it less often will leak less memory.\n\nI have checked the testcases of bug 496601 and of bug 1423275, they still\nwork as expected with this fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128612", "files": ["widget/cocoa/nsCursorManager.mm"], "git_node": null, "git_parents": [null], "node": "eb35ad1d25cbbaaa5ffcc243c7e188860bfe26ba", "parents": ["752116e998380770c7e076ee3b0abef2f5e170fb"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1713769 - Avoid null Skia image shader. r=gfx-reviewers,jgilbert,a=RyanVM\n\nIf makeShader() gets passed a non-invertible matrix, it can fail and return null.\nThis can then subsequently cause problems when this is passed to SkPaint which\nblindly tries to use it. For other pattern types, we gracefully handle this by\njust making the SkPaint transparent, so let's do likewise for surface patterns.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125852", "files": ["gfx/2d/DrawTargetSkia.cpp"], "git_node": null, "git_parents": [null], "node": "2e54c38b17632a0648dbae04b26d23aac96bbf3c", "parents": ["eb35ad1d25cbbaaa5ffcc243c7e188860bfe26ba"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1713769 - Ensure extracting SkImage subset is actually successful. r=jrmuizel, a=RyanVM\n\nIf ExtractSubset fails on an SkImage, we may accidentally call image-\u003emakeShader\nwith a null image below that. We need to bail out in that case so that we don't\ndo that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128667", "files": ["gfx/2d/DrawTargetSkia.cpp"], "git_node": null, "git_parents": [null], "node": "0339c44e4a79624851e8a9075cc1226694d219b6", "parents": ["2e54c38b17632a0648dbae04b26d23aac96bbf3c"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1712671 - Make nsSocketTransport2::m{Input/Output}StreamClosed atomic. r=kershaw,decoder a=RyanVM\n\nFixes race between nsSocketTransport::OnInputClosed and nsSocketTransport::OpenInputStream.\nSame for output streams.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128183", "files": ["mozglue/build/TsanOptions.cpp", "netwerk/base/nsSocketTransport2.h"], "git_node": null, "git_parents": [null], "node": "1d7485767799c3bf4436a75e2042a1dde0503ce7", "parents": ["0339c44e4a79624851e8a9075cc1226694d219b6"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1606864 - Make mDoNotRetryToConnect atomic. r=decoder,dragana a=RyanVM\n\nFixes race between nsSocketTransport::Close and\nnsSocketTransport::RecoverFromError called from OnSocketDetached.\n\nDepends on D128183\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128364", "files": ["mozglue/build/TsanOptions.cpp", "netwerk/base/nsSocketTransport2.h"], "git_node": null, "git_parents": [null], "node": "4a64d8b1e257665df1f3af86b61822bf2553fdc8", "parents": ["1d7485767799c3bf4436a75e2042a1dde0503ce7"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1731779 - r=dveditz,mtigley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128061", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/ApplicationReputation.h", "toolkit/components/reputationservice/test/gtest/TestExecutableLists.cpp", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h", "xpcom/io/nsLocalFileUnix.cpp"], "git_node": null, "git_parents": [null], "node": "7d4e4d060f57552b3d49edc5a9691a42c38fd865", "parents": ["4a64d8b1e257665df1f3af86b61822bf2553fdc8"], "tags": []}], "date": 1634844380, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null], "user": "dsmith@mozilla.com"}, "87": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1712506 - In the Linux CDM sandbox, don't log when denying access to certain files. r=gcp, a=RyanVM\n\nThe Widevine CDM tries to open certain procfs/sysfs files, as noted\nin the bug, but doesn't appear to need them; some of them are opened\nrepeatedly, causing log spam.  This patch suppresses logging for the\nfiles where this is known to happen, by adding \"opened file\" objects\nthat always silently fail.\n\nIt would also be possible to turn off all of this logging by default\nand make it conditional on MOZ_SANDBOX_LOGGING, but it's relatively\nlow-noise (compared to content process file access) and provides some\nvalue (see bug 1725828), so for now let's leave it enabled and just\nblocklist a few files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123562", "files": ["security/sandbox/linux/Sandbox.cpp", "security/sandbox/linux/SandboxOpenedFiles.cpp", "security/sandbox/linux/SandboxOpenedFiles.h"], "git_node": null, "git_parents": [null], "node": "cde8763d59b62f428c9fca51e2c80579d8e4581b", "parents": ["7d4e4d060f57552b3d49edc5a9691a42c38fd865"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1725828 - Preload dependencies for the Widevine CDM when sandboxing it on Linux. r=bryce, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123542", "files": ["dom/media/gmp/GMPChild.cpp", "dom/media/gmp/GMPParent.cpp"], "git_node": null, "git_parents": [null], "node": "f6e36e1fb791c2b965dc0527fd6eadf577f61092", "parents": ["cde8763d59b62f428c9fca51e2c80579d8e4581b"], "tags": []}], "date": 1635090988, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "88": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129376", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "933de60269be0c52855cd7a5d7dde5666204baf3", "parents": ["f6e36e1fb791c2b965dc0527fd6eadf577f61092"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1737533 - Part 1: Update tzdata in ICU data files to 2021a2. r=dminor, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129370", "files": ["config/external/icu/data/icudt69l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/timezoneTypes.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/timezoneTypes.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/timezoneTypes.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/zoneinfo64.txt"], "git_node": null, "git_parents": [null], "node": "d4ae91c9007b52a499e5ccc6982e615a80cc3fe4", "parents": ["933de60269be0c52855cd7a5d7dde5666204baf3"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1737533 - Part 2: Update tests for tzdata2021a2. r=dminor, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129372", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js"], "git_node": null, "git_parents": [null], "node": "ee3ea9e9ddb4f1201a84e1d0fef77f396983592e", "parents": ["d4ae91c9007b52a499e5ccc6982e615a80cc3fe4"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1737558 - make esr91 not next-esr. r=aki, a=RyanVM\n\nesr91 should now update the regular (non-next) ESR bouncer aliases, and\nupdate-verify should test updates from esr 68.x to 91.x.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129397", "files": ["taskcluster/ci/release-bouncer-aliases/kind.yml", "taskcluster/ci/release-update-verify-config/kind.yml"], "git_node": null, "git_parents": [null], "node": "251b39841188b46832c3c2b8da2b3ba21e29cf33", "parents": ["ee3ea9e9ddb4f1201a84e1d0fef77f396983592e"], "tags": []}], "date": 1635178783, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "89": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129800", "files": ["services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/pinning/pins.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "fe44c2062912fa3eb46e9ff9503ddc4adcc79dc6", "parents": ["251b39841188b46832c3c2b8da2b3ba21e29cf33"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1738277 - Remove packaged pinning/pins.json. r+a=ryanvm\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129822", "files": ["browser/installer/allowed-dupes.mn", "services/settings/dumps/moz.build", "services/settings/dumps/pinning/moz.build", "services/settings/dumps/pinning/pins.json"], "git_node": null, "git_parents": [null], "node": "b19c7010a36ba7e6cab46b12854fda0db65b0b69", "parents": ["fe44c2062912fa3eb46e9ff9503ddc4adcc79dc6"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1738277 - Clean up a couple more references to settings/pinning. r=leplatrem, a=RyanVM", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "browser/installer/package-manifest.in"], "git_node": null, "git_parents": [null], "node": "f100dcabc931a2980f2af7d37f9c6b3d6f452a17", "parents": ["b19c7010a36ba7e6cab46b12854fda0db65b0b69"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1736464 - Download leptonica from github. r=jmaher, a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128810", "files": ["taskcluster/docker/debian10-test-iris/install_iris_deps.sh"], "git_node": null, "git_parents": [null], "node": "723a4e8b5fbf896a480c538babacd72ca800b390", "parents": ["f100dcabc931a2980f2af7d37f9c6b3d6f452a17"], "tags": []}, {"author": "Connor Sheehan \u003csheehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1733180: add 2021/2022 hgmo SSL certificate fingerprint to `FALLBACK_FINGERPRINT` r=dhouse a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129071", "files": ["taskcluster/scripts/run-task"], "git_node": null, "git_parents": [null], "node": "a86e8062e2ca3fdf62a72cf6814ca50542b26603", "parents": ["723a4e8b5fbf896a480c538babacd72ca800b390"], "tags": []}, {"author": "Robert Mader \u003crobert.mader@posteo.de\u003e", "branch": "default", "desc": "Bug 1726211 - Add pw_context_connect_fd() to mozpipewire, r=stransky a=RyanVM\n\nIt is needed for restricted pipewire access. The FD is provided\nby xdg-desktop-portals such as the one for screen casting.\nNot using the portal provided FD means we need full Pipewire\naccess, even in a Flatpak sandbox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D122903", "files": ["third_party/pipewire/libpipewire/mozpipewire.cpp"], "git_node": null, "git_parents": [null], "node": "c3c931f318b01408af4f7e6044571d8cff395369", "parents": ["a86e8062e2ca3fdf62a72cf6814ca50542b26603"], "tags": []}, {"author": "Robert Mader \u003crobert.mader@posteo.de\u003e", "branch": "default", "desc": "Bug 1726211 - Use portal provided file descriptor for screen casting, r=stransky a=RyanVM\n\nWe already requested the FD from the portal but then just opened a\nnormal connection. The screen cast portal explicitly states that\nthe FD returned by `OpenPipeWireRemote()` should be used with\n`pw_remote_connect_fd()` - the later is Pipewire 0.2 API that got\nreplaced by `pw_context_connect_fd()`.\n\nDepends on D122903\n\nDifferential Revision: https://phabricator.services.mozilla.com/D122904", "files": ["third_party/libwebrtc/webrtc/modules/desktop_capture/linux/base_capturer_pipewire.cc"], "git_node": null, "git_parents": [null], "node": "00ff58c8656fb0e2111c6110747da155992bb048", "parents": ["c3c931f318b01408af4f7e6044571d8cff395369"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732629 - [gfx/2d] Get non-localized variation axis names from CoreGraphics in ScaledFontMac, so that we set up the CGFont correctly with variation values. r=jrmuizel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129576", "files": ["gfx/2d/ScaledFontMac.cpp", "gfx/2d/UnscaledFontMac.h", "gfx/thebes/gfxMacFont.cpp"], "git_node": null, "git_parents": [null], "node": "a2d58d88ad4718dcfb59cbd102d8ad97cc2e8e6e", "parents": ["00ff58c8656fb0e2111c6110747da155992bb048"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732629 - [gfx/wr] Fix new_ct_font_with_variations to use non-localized variation axis names from Core Graphics. r=jrmuizel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129636\n\nDepends on D129576", "files": ["Cargo.lock", "gfx/wr/Cargo.lock", "gfx/wr/webrender/Cargo.toml", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/platform/macos/font.rs"], "git_node": null, "git_parents": [null], "node": "6c16cf83f51f2273c7a370a2da2bc52c8ee3f7a8", "parents": ["a2d58d88ad4718dcfb59cbd102d8ad97cc2e8e6e"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1737765 - Part 1: Update tzdata in ICU data files to 2021a3. r=gregtatum, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129486", "files": ["config/external/icu/data/icudt69l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/zoneinfo64.txt"], "git_node": null, "git_parents": [null], "node": "1a158d36d33837724106b0ede16b7f14d3707fd4", "parents": ["6c16cf83f51f2273c7a370a2da2bc52c8ee3f7a8"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1737765 - Part 2: Update tests for tzdata2021a3. r=gregtatum, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129488", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js"], "git_node": null, "git_parents": [null], "node": "8802d620459d50ea648821a15497d06efd15732b", "parents": ["1a158d36d33837724106b0ede16b7f14d3707fd4"], "tags": ["FIREFOX_91_3_0esr_BUILD1", "FIREFOX_91_3_0esr_RELEASE"]}], "date": 1635440745, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}}
}";