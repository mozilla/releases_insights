or": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-1000 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "1f31f820da7385d2fb0803722f43a62a4b16a785", "parents": ["d925e2ba6594dd52afd9db311149c5d956cf070c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-1000 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "3b83a8ced9a350bccf763bca0c50009807312ebe", "parents": ["1f31f820da7385d2fb0803722f43a62a4b16a785"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-1000 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "198611600e43c2b4e50eceb67e35515b99c460bd", "parents": ["3b83a8ced9a350bccf763bca0c50009807312ebe"], "tags": []}], "date": 1476710532, "git_changesets": [null, null, null], "user": "ffxbld"}, "239": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1308048 - Ensure off-thread parse task's script is rooted correctly r=jandem a=sylvestre", "files": ["js/src/jit-test/tests/gc/bug-1308048.js", "js/src/vm/HelperThreads.cpp"], "git_node": null, "git_parents": [null], "node": "bb10104dc89ef873c508f737cead98bf354dd6d1", "parents": ["198611600e43c2b4e50eceb67e35515b99c460bd"], "tags": []}], "date": 1476784527, "git_changesets": [null], "user": "jcoppeard@mozilla.com"}, "240": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-226 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "2698aeb5cf433a0f8ed07769b66c3f37fa8992f3", "parents": ["bb10104dc89ef873c508f737cead98bf354dd6d1"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-226 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "4274684f917b2918fce575d54961a0084f2600b3", "parents": ["2698aeb5cf433a0f8ed07769b66c3f37fa8992f3"], "tags": []}], "date": 1476796358, "git_changesets": [null, null], "user": "ffxbld"}, "241": {"changesets": [{"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 1158489 - Upgrade to NSS 3.21.3, a=sylvestre", "files": ["configure.in", "security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/ssl3con.c", "security/nss/lib/util/dersubr.c", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/utf8.c"], "git_node": null, "git_parents": [null], "node": "3f5b37f887a1daf40aa2985a806469dc9a1ead2e", "parents": ["4274684f917b2918fce575d54961a0084f2600b3"], "tags": []}], "date": 1476800120, "git_changesets": [null], "user": "sledru@mozilla.com"}, "242": {"changesets": [{"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1246972 - Always require the update working directory to be within the installation path; r=rstrong a=sylvestre\n\nThis required fixing a few chrome tests which broke on Mac because they were assuming updater-settings.ini would be at the same location as the executables.\n\nAlso, this patch removes many dependencies on the current working directory from updater.cpp by changing it to use absolute paths instead. Otherwise this patch would have required adding yet more chdir() calls to avoid invalidating existing assumptions about what the current directory is.\n\nMozReview-Commit-ID: ASxfV4uVpmD", "files": ["toolkit/mozapps/update/common/errors.h", "toolkit/mozapps/update/tests/chrome/utils.js", "toolkit/mozapps/update/tests/data/sharedUpdateXML.js", "toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_base_updater/marWrongApplyToDirFailure_win.js", "toolkit/mozapps/update/tests/unit_base_updater/xpcshell.ini", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "aa1593ec5ccd027070daa190e433ed588eb2fdca", "parents": ["3f5b37f887a1daf40aa2985a806469dc9a1ead2e"], "tags": []}], "date": 1476804653, "git_changesets": [null], "user": "mhowell@mozilla.com"}, "243": {"changesets": [{"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1251184 - [quicktime] P1. Report video/quicktime mimetype when sniffing. r=cpearce, a=sledru\n\nMozReview-Commit-ID: 9EJQVYt76Mh", "files": ["netwerk/mime/nsMimeTypes.h", "toolkit/components/mediasniffer/nsMediaSniffer.cpp"], "git_node": null, "git_parents": [null], "node": "f35e2b9e316c8dc10ddd71228c4d0c8427bf24d1", "parents": ["aa1593ec5ccd027070daa190e433ed588eb2fdca"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1251184 - [quicktime] P2. Use external plugin if available over native playback. r=cpearce, a=sledru\n\nWhile almost identical to video/mp4, quicktime files often use codecs that we don't support: in particular MPEG4 part 2 and amr audio.\nIf a plugin exists and is enabled, prefer it to handle those files.\n\nWe only do so when opening the file directly. Media in \u003cvideo\u003e element will always play natively.\n\nMozReview-Commit-ID: 1yPpzfDaCfT", "files": ["dom/media/DecoderTraits.cpp"], "git_node": null, "git_parents": [null], "node": "60e52dff90815038ba376fa357f8e95871b91c89", "parents": ["f35e2b9e316c8dc10ddd71228c4d0c8427bf24d1"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1292159 - Be more careful about removing the inherit principal bit on base channel redirects. r=ckerschb, a=sledru", "files": ["netwerk/base/nsBaseChannel.cpp"], "git_node": null, "git_parents": [null], "node": "3ff0c89f3b2685948e9310d8f41fa69176532882", "parents": ["60e52dff90815038ba376fa357f8e95871b91c89"], "tags": []}, {"author": "Gerald Squelart \u003cgsquelart@mozilla.com\u003e", "branch": "default", "desc": "Bug 1263665 - Block libav \u003c 54.35.1. r=jya, a=sledru\n\nNote: Unlike in 50+, we cannot show a user notification, video playback will\njust fail with a (less-visible) Browser Console message.", "files": ["dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.cpp", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.h", "modules/libpref/init/all.js", "testing/profiles/prefs_general.js"], "git_node": null, "git_parents": [null], "node": "a79cafee93f40a0007547320e018fadd7c709e5c", "parents": ["3ff0c89f3b2685948e9310d8f41fa69176532882"], "tags": []}], "date": 1476804968, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "244": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 60e52dff9081 (bug 1251184) for bustage.", "files": ["dom/media/DecoderTraits.cpp"], "git_node": null, "git_parents": [null], "node": "6f82434fa6dcad0f5a00aaff29b7a58b52a57f5f", "parents": ["a79cafee93f40a0007547320e018fadd7c709e5c"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1251184 - [quicktime] P2. Use external plugin if available over native playback. r=cpearce, a=sledru\n\nWhile almost identical to video/mp4, quicktime files often use codecs that we don't support: in particular MPEG4 part 2 and amr audio.\nIf a plugin exists and is enabled, prefer it to handle those files.\n\nWe only do so when opening the file directly. Media in \u003cvideo\u003e element will always play natively.\n\nMozReview-Commit-ID: 1yPpzfDaCfT", "files": ["dom/media/DecoderTraits.cpp"], "git_node": null, "git_parents": [null], "node": "85733de5150fff5490a0433b6911344f1f680589", "parents": ["6f82434fa6dcad0f5a00aaff29b7a58b52a57f5f"], "tags": []}], "date": 1476808914, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "245": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-309 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "f53dc4a6c44d534c9a807cf2d16922df5b93fa3a", "parents": ["85733de5150fff5490a0433b6911344f1f680589"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-309 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "4c6d628507db975746e24b16dbe67597e059541f", "parents": ["f53dc4a6c44d534c9a807cf2d16922df5b93fa3a"], "tags": []}], "date": 1476883269, "git_changesets": [null, null], "user": "ffxbld"}, "246": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-576 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "c00cdc6fe3aa1d7a629bae5b66b66aa9bacb8a6f", "parents": ["4c6d628507db975746e24b16dbe67597e059541f"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-576 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "3087c56243b95b4a034b92c46405e339c15b3c05", "parents": ["c00cdc6fe3aa1d7a629bae5b66b66aa9bacb8a6f"], "tags": []}], "date": 1476968935, "git_changesets": [null, null], "user": "ffxbld"}, "247": {"changesets": [{"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1292443 a=dveditz", "files": ["gfx/cairo/libpixman/src/pixman-edge-imp.h"], "git_node": null, "git_parents": [null], "node": "5e39c1c2fded8a33099b0f0266a258b5673c79e0", "parents": ["3087c56243b95b4a034b92c46405e339c15b3c05"], "tags": []}], "date": 1476991779, "git_changesets": [null], "user": "kwierso@gmail.com"}, "248": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1308346 - Return new.target separately from readFrameArgsAndLocals. r=shu,efaust a=ritu", "files": ["js/src/jit/JitFrameIterator.h", "js/src/jit/RematerializedFrame.cpp", "js/src/jit/RematerializedFrame.h"], "git_node": null, "git_parents": [null], "node": "7006b275b8290cbf02b57d1f98e9d33857ccb9f3", "parents": ["5e39c1c2fded8a33099b0f0266a258b5673c79e0"], "tags": []}], "date": 1477380915, "git_changesets": [null], "user": "jandemooij@gmail.com"}, "249": {"changesets": [{"author": "Laszlo Ersek \u003clersek@redhat.com\u003e", "branch": "default", "desc": "Bug 1304962 - Fix argument processing in AARCH64 xptcall. r=froydnj, a=lizzard\n\nThe invoke_copy_to_stack() function passes incorrect \"stack_args\" and\n\"end\" arguments to the alloc_word() utility function, for parameter types\nT_I8..T_I64, T_U8..T_U64, T_BOOL, T_CHAR and T_WCHAR.\n\nNamely, the \"end\" input parameter of invoke_copy_to_stack(), which is\ncurrently incorrectly passed as \"end\" to alloc_word(), points to the very\nend of the entire exchange area between _NS_InvokeByIndex() and\ninvoke_copy_to_stack(). However, alloc_word()'s \"end\" parameter should\npoint to the end of the \"ireg\" (integer registers) sub-area of the\nexchange area. That is, \"ireg_end\" should be passed to alloc_word() as\n\"end\".\n\nBecause invoke_copy_to_stack()'s \"end\" input parameter is strictly greater\nthan \"ireg_end\", alloc_word() will happily trample over the \"freg\"\n(floating point registers) area, on the above-mentioned type branches,\ngiven a large enough \"paramCount\".\n\nSimilarly, as second argument, \"stack_args\" should be passed to\nalloc_word(), pointing to the next available stack slot, for spilled-over\narguments. Passing \"stk\", which initially points to the base of the entire\nexchange area (and hence the base of the \"ireg\" area) makes no sense.\n\nThe two other alloc_word() calls in the function are correct. So\ncentralize all calls to alloc_word() to a single location -- thereby\nending up with a sole call site per alloc_XXX() function --, and compute\nonly the last argument, \"word\", conditionally.\n\nThis fixes an obscure SIGSEGV in AARCH64 Firefox. Triggering the bug\nrequires a target function with seven integer-like parameters (not\ncounting the implicit \"this\" -- aka \"that\" -- parameter), followed by at\nleast one parameter of the above buggy types. nsIOService::NewChannel2()\nis such a target function, for example.", "files": ["xpcom/reflect/xptcall/md/unix/xptcinvoke_aarch64.cpp"], "git_node": null, "git_parents": [null], "node": "f61049d5f3737c2104cc79f973afd7746113603c", "parents": ["7006b275b8290cbf02b57d1f98e9d33857ccb9f3"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1280878 - Update safebrowing_notification test for changed Google URL. r=francois, a=test-only\n\nMozReview-Commit-ID: 7jkbKM9FLXg", "files": ["testing/firefox-ui/tests/firefox_ui_tests/functional/security/test_safe_browsing_notification.py"], "git_node": null, "git_parents": [null], "node": "794cabe7579d65aac53711c1685c25f0a566477b", "parents": ["f61049d5f3737c2104cc79f973afd7746113603c"], "tags": []}], "date": 1477532238, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "250": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-287 - a=hsts-updat