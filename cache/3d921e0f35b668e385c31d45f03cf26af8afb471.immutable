parents": [null], "node": "debff255c08e898be370e307e1e014f5601c20c6", "parents": ["f31d643afd4159b5422ae5aebcbbea0a088e018e"], "tags": []}], "date": 1452527227, "git_changesets": [null], "user": "cbook@mozilla.com"}, "245": {"changesets": [{"author": "Benjamin Bouvier \u003cbenj@benj.me\u003e", "branch": "default", "desc": "Bug 1234280: Handle oom in CodeGeneratorShared::allocateData; r=jandem, a=sledru", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/CodeGenerator-shared.h"], "git_node": null, "git_parents": [null], "node": "0f7224441f2089001f7934b46ac10cb72d267606", "parents": ["debff255c08e898be370e307e1e014f5601c20c6"], "tags": []}], "date": 1452528678, "git_changesets": [null], "user": "benj@benj.me"}, "246": {"changesets": [{"author": "L. David Baron \u003cdbaron@dbaron.org\u003e", "branch": "default", "desc": "Bug 1230668 - Don't use frame when not in composed document.  r=heycam a=sylvestre", "files": ["layout/style/nsComputedDOMStyle.cpp"], "git_node": null, "git_parents": [null], "node": "8c184c30caa6d16f5ec63cce9a77d16f25d2e57e", "parents": ["0f7224441f2089001f7934b46ac10cb72d267606"], "tags": []}], "date": 1452542088, "git_changesets": [null], "user": "kwierso@gmail.com"}, "247": {"changesets": [{"author": "Wes Kocher \u003cwkocher@mozilla.com\u003e", "branch": "default", "desc": "Fix up some rebase errors in bug 1230668 r=me a=bustage", "files": ["layout/style/nsComputedDOMStyle.cpp"], "git_node": null, "git_parents": [null], "node": "fceff80a84a32b68d02abc00486fe6c7b86d545b", "parents": ["8c184c30caa6d16f5ec63cce9a77d16f25d2e57e"], "tags": []}], "date": 1452542168, "git_changesets": [null], "user": "kwierso@gmail.com"}, "248": {"changesets": [{"author": "Kai Engert \u003ckaie@kuix.de\u003e", "branch": "default", "desc": "Bug 1158489, Upgrade to NSS 3.19.2.2, a=lmandel", "files": ["security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/ssl3con.c", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "9a92b504c10aedc853786c37cb83f276ba2d733a", "parents": ["fceff80a84a32b68d02abc00486fe6c7b86d545b"], "tags": []}], "date": 1452728426, "git_changesets": [null], "user": "kaie@kuix.de"}, "249": {"changesets": [{"author": "Jeff Gilbert \u003cjdashg@gmail.com\u003e", "branch": "default", "desc": "Bug 1220450 - Clear length on cache OOM. r=kamidphish, a=ritu\n\nClear length on cache OOM.\nFrom 805f71a86167d68223489797a97b0e40c6c9605c Mon Sep 17 00:00:00 2001\n---\n dom/canvas/WebGLContextBuffers.cpp | 7 ++++++-\n 1 file changed, 6 insertions(+), 1 deletion(-)", "files": ["dom/canvas/WebGLContextBuffers.cpp"], "git_node": null, "git_parents": [null], "node": "90b37013db55e2fd143fe1f905d7e7dd96f393b8", "parents": ["9a92b504c10aedc853786c37cb83f276ba2d733a"], "tags": []}], "date": 1452766765, "git_changesets": [null], "user": "cbook@mozilla.com"}, "250": {"changesets": [{"author": "Cykesiopka \u003ccykesiopka.bmo@gmail.com\u003e", "branch": "default", "desc": "Bug 1224968 - Support public key input to unbreak periodic HPKP updates. r=keeler, a=ritu\n\nhttps://chromium.googlesource.com/chromium/src/net/+/be448badb1982bfa13572d430774ff6f275aeb0c%5E!/#F0 switched SHA1 hashes to public keys for static pins. This broke genHPKPStaticPins.js and thus periodic HPKP updates, since the file doesn't handle public keys.\n\nThe changes here mostly mirror https://github.com/agl/transport-security-state-generate/commit/ba1f296240ceed7a84ee4a79a4eb23afea965621.", "files": ["security/manager/tools/genHPKPStaticPins.js"], "git_node": null, "git_parents": [null], "node": "25cdd180ee2e2c0e6cc895e19c34d5cf5bcd011e", "parents": ["90b37013db55e2fd143fe1f905d7e7dd96f393b8"], "tags": []}], "date": 1452768110, "git_changesets": [null], "user": "cbook@mozilla.com"}, "251": {"changesets": [{"author": "Carsten \"Tomcat\" Book \u003ccbook@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 90b37013db55 (bug 1220450) for problems with the patch", "files": ["dom/canvas/WebGLContextBuffers.cpp"], "git_node": null, "git_parents": [null], "node": "ff454133ccaf6eea13f002616a0412c0ea588444", "parents": ["25cdd180ee2e2c0e6cc895e19c34d5cf5bcd011e"], "tags": []}], "date": 1452781587, "git_changesets": [null], "user": "cbook@mozilla.com"}, "252": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-423 - a=hsts-update", "files": ["security/manager/boot/src/nsSTSPreloadList.errors", "security/manager/boot/src/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "7e836d022935a8ed6076af8574e16fab8c7c6a93", "parents": ["ff454133ccaf6eea13f002616a0412c0ea588444"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-423 - a=hpkp-update", "files": ["security/manager/boot/src/StaticHPKPins.errors", "security/manager/boot/src/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "1629aca4895445866c5c1a4a39c6d206fdbd2d19", "parents": ["7e836d022935a8ed6076af8574e16fab8c7c6a93"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-423 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "aaf922ae679685acb5d2b8ffa5f0bf22f1e6987a", "parents": ["1629aca4895445866c5c1a4a39c6d206fdbd2d19"], "tags": []}], "date": 1452945459, "git_changesets": [null, null, null], "user": "ffxbld"}, "253": {"changesets": [{"author": "Seth Fowler \u003cmark.seth.fowler@gmail.com\u003e", "branch": "default", "desc": "Bug 1146335 (Part 1) - Add assertions and fix style issues in image::Downscaler. r=tn a=lizzard", "files": ["image/src/Downscaler.cpp"], "git_node": null, "git_parents": [null], "node": "9d14787bd10e6f3013263a2cae0bcc7