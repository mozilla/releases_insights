rents": [null], "node": "0da9fe75c1115e07fb6835aa2df07f235849c962", "parents": ["928b0540e4214cc5e8cd80c85f471c98347b6007"], "tags": []}], "date": 1711125484, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "308": {"changesets": [{"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1886313 - Use a struct for MetricTimerTuple  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205447\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205452", "files": ["toolkit/components/glean/bindings/private/TimingDistribution.cpp", "toolkit/components/glean/build_scripts/glean_parser_ext/templates/gifft.jinja2"], "git_node": null, "git_parents": [null], "node": "b0065d1cf39f53f29b2670c57a1daefbb54a0820", "parents": ["0da9fe75c1115e07fb6835aa2df07f235849c962"], "tags": []}], "date": 1711125575, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "309": {"changesets": [{"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1886313 - Update FOG test expectations. a=test-only", "files": ["toolkit/components/glean/tests/pytest/gifft_output_Histogram", "toolkit/components/glean/tests/pytest/gifft_output_Scalar"], "git_node": null, "git_parents": [null], "node": "19d5c420e5a2c81fd83a96305cac47af25100d02", "parents": ["b0065d1cf39f53f29b2670c57a1daefbb54a0820"], "tags": []}], "date": 1711127334, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "310": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1885855.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205067\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205468", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/ApplicationReputation.h", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": null, "git_parents": [null], "node": "bc97b19fc3569bd0403c2e1bac77e7db5dff637b", "parents": ["19d5c420e5a2c81fd83a96305cac47af25100d02"], "tags": []}], "date": 1711128307, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "311": {"changesets": [{"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1883916 - Add nonAdsLinkQueryParamNames to search-telemetry-schema - r=Standard8 a=RyanVM\n\nAdds a new property that will be used to extract the intended href to load on SERPs\nthat contain the actual URL in a query param key not known until they click on the\nactual link.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204355", "files": ["browser/components/search/schema/search-telemetry-schema.json"], "git_node": null, "git_parents": [null], "node": "0b37219ad4ce9f209926ca7f08271c7c9a4cc30a", "parents": ["bc97b19fc3569bd0403c2e1bac77e7db5dff637b"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 1885169 - Make 'skipCount' in search-telemetry-schema a definition rather than a possible property on each element. r=jteow, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204793", "files": ["browser/components/search/schema/search-telemetry-schema.json"], "git_node": null, "git_parents": [null], "node": "452b25e8ccc91b8eb4fb900e97e9c575480bfb11", "parents": ["0b37219ad4ce9f209926ca7f08271c7c9a4cc30a"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880212 - Update search-telemetry-v2 schema as part of SERP categorization work. r=jteow, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205250", "files": ["browser/components/search/schema/search-telemetry-schema.json"], "git_node": null, "git_parents": [null], "node": "9c530d44f9294ffd1d58b77bdcbc84d127b2e784", "parents": ["452b25e8ccc91b8eb4fb900e97e9c575480bfb11"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205554", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "ccb308d7b0867f152c50d4ca65dd33722553cff3", "parents": ["9c530d44f9294ffd1d58b77bdcbc84d127b2e784"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1885349 - Replace addons-stage.crt with cas-cur r=jschanck a=RyanVM\n\naddons-stage.crt is the DER-encoded version of the\ncas-cur-root-2024-03-12.crt file from bug 1882192, generated with:\n\nopenssl x509 -inform PEM -in /tmp/cas-cur-root-2024-03-12.crt -outform DER -out security/manager/ssl/addons-stage.crt\n\nThe four zip files are from bug 1885457, and are the same file, but\nsigned with the new certificate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204706", "files": ["security/manager/ssl/addons-stage.crt", "security/manager/ssl/tests/unit/test_signed_apps.js", "security/manager/ssl/tests/unit/test_signed_apps/addons-stage-tomato-clock-sha1-es256-es384.zip", "security/manager/ssl/tests/unit/test_signed_apps/addons-stage-tomato-clock-sha1-es256-ps256.zip", "security/manager/ssl/tests/unit/test_signed_apps/addons-stage-tomato-clock-sha1-es256.zip", "security/manager/ssl/tests/unit/test_signed_apps/addons-stage-tomato-clock-sha1-ps256.zip", "security/manager/ssl/tests/unit/test_signed_apps/autograph-714ba248-stage-tomato-clock-PKCS7-SHA1-ES256-ES384.zip", "security/manager/ssl/tests/unit/test_signed_apps/autograph-714ba248-stage-tomato-clock-PKCS7-SHA1-ES256-PS256.zip", "security/manager/ssl/tests/unit/test_signed_apps/autograph-714ba248-stage-tomato-clock-PKCS7-SHA1-ES256.zip", "security/manager/ssl/tests/unit/test_signed_apps/autograph-714ba248-stage-tomato-clock-PKCS7-SHA1-PS256.zip"], "git_node": null, "git_parents": [null], "node": "b4418340ea668f38b60642fec42fbb9c64d1b0ea", "parents": ["ccb308d7b0867f152c50d4ca65dd33722553cff3"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1885354 - Hardcode intermediate addons-stage cert r=jschanck a=RyanVM\n\nGenerated from the crt file from bug 1882192 with:\n\nopenssl x509 -inform PEM -in /tmp/cas-cur-intermediate-amo-2024-03-12.crt -outform DER -out security/manager/ssl/addons-stage-intermediate.crt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204778", "files": ["security/manager/ssl/AppTrustDomain.cpp", "security/manager/ssl/addons-stage-intermediate.crt", "security/manager/ssl/gen_cert_header.py", "security/manager/ssl/moz.build"], "git_node": null, "git_parents": [null], "node": "4116956f10fad14b2bf8a7bc24a59ff3c2dd143d", "parents": ["b4418340ea668f38b60642fec42fbb9c64d1b0ea"], "tags": []}], "date": 1711405073, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "312": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1886830: update staging content signing root certificate to new cas_cur root certificate  a=RyanVM\n\nThis certificate is `cas-cur-root-2024-03-12.crt` from bug 1882192 (https://bugzilla.mozilla.org/attachment.cgi?id=9390858), and has been converted to DER with:\n\n$ openssl x509 -in cas-cur-root-2024-03-12.crt -inform PEM -outform DER\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205356\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205774", "files": ["security/manager/ssl/content-signature-stage.crt"], "git_node": null, "git_parents": [null], "node": "df1f262e9d3aa15ed9ab8ca0e594222ce5d9fbad", "parents": ["4116956f10fad14b2bf8a7bc24a59ff3c2dd143d"], "tags": []}], "date": 1711494535, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "313": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1771992 - Use stage cert depending on the configured GMP URL (ESR115) r=aosmond,bhearsum a=RyanVM\n\nRebased to resolve conflict with async/await refactor from bug 1862051.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205637\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205856", "files": ["toolkit/modules/GMPInstallManager.sys.mjs", "toolkit/modules/tests/xpcshell/test_GMPInstallManager.js", "toolkit/mozapps/extensions/internal/ProductAddonChecker.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_ProductAddonChecker_signatures.js"], "git_node": null, "git_parents": [null], "node": "928592a887c2f61066eae08148fe7f2cbbb0c982", "parents": ["df1f262e9d3aa15ed9ab8ca0e594222ce5d9fbad"], "tags": []}], "date": 1711646516, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "314": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1874489 - patch 1 - Don't check STAT designAxisSize if the designAxisCount is zero.  a=RyanVM\n\nThis is just https://github.com/khaledhosny/ots/pull/277 from upstream, not really part\nof this issue but touching the same code, so simplest to include it here.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D204916\n\nDifferential Revision: https://phabricator.services.mozilla.com/D206096", "files": ["gfx/ots/src/stat.cc"], "git_node": null, "git_parents": [null], "node": "59182ff3f684f20ed8441eceb50a5965240fb10d", "parents": ["928592a887c2f61066eae08148fe7f2cbbb0c982"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1874489 - patch 2 - Avoid potential arithmetic overflow during Buffer read operations.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D204917\n\nDifferential Revision: https://phabricator.services.mozilla.com/D206178", "files": ["gfx/ots/src/ots.h"], "git_node": null, "git_parents": [null], "node": "e281258703225ee8f12734cbc919d104ef0b2d22", "parents": ["59182ff3f684f20ed8441eceb50a5965240fb10d"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1874489 - patch 3 - More careful range checks in STAT parsing.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D204918\n\nDifferential Revision: https://phabricator.services.mozilla.com/D206179", "files": ["gfx/ots/src/stat.cc"], "git_node": null, "git_parents": [null], "node": "2cb4e79a2ac0a504653d14e46b1b9a5f16f6e269", "parents": ["e281258703225ee8f12734cbc919d104ef0b2d22"], "tags": []}], "date": 1711825529, "git_changesets": [null, null, null], "user": "rvandermeulen@mozilla.com"}, "315": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1677524 - Add policies for credit card and address autofill.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D202733\n\nDifferential Revision: https://phabricator.services.mozilla.com/D206133", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js", "browser/extensions/formautofill/content/manageDialog.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "3fc8d7913eb0fa7e3b39dc1fc3c88b936ecab3bb", "parents": ["2cb4e79a2ac0a504653d14e46b1b9a5f16f6e269"], "tags": []}], "date": 1711825577, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "316": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com