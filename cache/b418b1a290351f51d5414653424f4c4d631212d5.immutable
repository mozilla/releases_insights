"pushes": {"297": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 423e963b3d9b923e3c7fae8eae2f626f02c15cf2 with FIREFOX_115_9_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "2188c44cec22493b5fea515b0ad09b8af32ca5c1", "parents": ["423e963b3d9b923e3c7fae8eae2f626f02c15cf2"], "tags": []}], "date": 1710394154, "git_changesets": [null], "user": "ffxbld"}, "298": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "14018d6181f0c319c1ebd221f542d59d1f32519f", "parents": ["2188c44cec22493b5fea515b0ad09b8af32ca5c1"], "tags": []}], "date": 1710754376, "git_changesets": [null], "user": "ffxbld-merge"}, "299": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1881370 - Upgrade ahash to 0.7.8.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D202361\n\nDifferential Revision: https://phabricator.services.mozilla.com/D202763", "files": ["Cargo.lock", "supply-chain/audits.toml", "third_party/rust/ahash/.cargo-checksum.json", "third_party/rust/ahash/Cargo.toml", "third_party/rust/ahash/build.rs", "third_party/rust/ahash/src/aes_hash.rs", "third_party/rust/ahash/src/hash_quality_test.rs", "third_party/rust/ahash/src/random_state.rs"], "git_node": null, "git_parents": [null], "node": "81559b48bcb7832a5027a8f18813ebd63163263f", "parents": ["14018d6181f0c319c1ebd221f542d59d1f32519f"], "tags": []}], "date": 1710789481, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "300": {"changesets": [{"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1879855 - Test, r=Gijs a=test-only", "files": ["browser/base/content/test/popupNotifications/browser_popupNotification_security_delay.js"], "git_node": null, "git_parents": [null], "node": "0fbfaf7afbfd4eebb500c7ca592cdac68c2c0879", "parents": ["81559b48bcb7832a5027a8f18813ebd63163263f"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D204888", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "7899ec668592877473c46ad3b0819130d3f25fc6", "parents": ["0fbfaf7afbfd4eebb500c7ca592cdac68c2c0879"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1878428 - Prevent a deadlock while doing in-process minidump generation r=spohl a=RyanVM\n\nThis removes all the memory allocations which we were doing while writing a\nminidump of the crashed process from within the process itself. Under these\nconditions all threads are stopped save for the minidump writer; so if another\nthread owns a mutex guarding the memory allocator we could deadlock by doing\nallocations.\n\nThis patch avoids allocating strings entirely and uses Breakpad's alternative\nallocator to sidestep the issue where we cannot avoid allocations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D201960", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/minidump_generator.cc", "toolkit/crashreporter/breakpad-client/mac/handler/minidump_generator.h"], "git_node": null, "git_parents": [null], "node": "80f79466670fb1d55829a71ce97c47945555dcc1", "parents": ["7899ec668592877473c46ad3b0819130d3f25fc6"], "tags": []}], "date": 1710790881, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "301": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 423e963b3d9b923e3c7fae8eae2f626f02c15cf2 with FIREFOX_115_9_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "a96d1222a01f4f0cca806e63af02148a8021b013", "parents": ["80f79466670fb1d55829a71ce97c47945555dcc1"], "tags": []}], "date": 1710852404, "git_changesets": [null], "user": "ffxbld"}, "302": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1886852 - Avoid registering unnecessary MessageManager listeners when SHIP is enabled, r=smaug, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205377", "files": ["browser/components/sessionstore/SessionStore.sys.mjs"], "git_node": null, "git_parents": [null], "node": "c7ef8840e93fd4ca57e4d2163806abbe4b2b0009", "parents": ["a96d1222a01f4f0cca806e63af02148a8021b013"], "tags": []}], "date": 1711059100, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "303": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_9_X_RELBRANCH", "desc": "Set version to 115.9.1 a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "218a346e2c9c04bc2ce6ccdb7abf7e8cb67c3906", "parents": ["423e963b3d9b923e3c7fae8eae2f626f02c15cf2"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "FIREFOX_ESR_115_9_X_RELBRANCH", "desc": "Bug 1886852 - Avoid registering unnecessary MessageManager listeners when SHIP is enabled, r=smaug, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205377", "files": ["browser/components/sessionstore/SessionStore.sys.mjs"], "git_node": null, "git_parents": [null], "node": "f65068dc82bf6051f520551ba5497a5985877d47", "parents": ["218a346e2c9c04bc2ce6ccdb7abf7e8cb67c3906"], "tags": ["FIREFOX_115_9_1esr_BUILD1", "FIREFOX_115_9_1esr_RELEASE"]}], "date": 1711060457, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "304": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f65068dc82bf6051f520551ba5497a5985877d47 with FIREFOX_115_9_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "74eccc93aabd357044f606caa42a02944df8b7c1", "parents": ["c7ef8840e93fd4ca57e4d2163806abbe4b2b0009"], "tags": []}], "date": 1711076006, "git_changesets": [null], "user": "ffxbld"}, "305": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f65068dc82bf6051f520551ba5497a5985877d47 with FIREFOX_115_9_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "b808837f853dd0447f427a7f00ebc7833ec91bff", "parents": ["74eccc93aabd357044f606caa42a02944df8b7c1"], "tags": []}], "date": 1711115032, "git_changesets": [null], "user": "ffxbld"}, "306": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D205325", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomf