"pushes": {"100": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1084005 - Bump the minimum NSS version in configure.in. rs=kaie, a=me", "files": ["configure.in"], "git_node": null, "git_parents": [null], "node": "e70de1bbcf5fc7f1b1eeeaf2453d24a8916ed5ef", "parents": ["2aad0b4e9a8da18b4cf88007adb48b6fbfadfd8f"], "tags": []}, {"author": "Trevor Saunders \u003ctrev.saunders@gmail.com\u003e", "branch": "default", "desc": "Bug 743580 - Don't remove atk-bridge from GTK_MODULES during startup. r=ginn, r=karlt, a=bkerensa", "files": ["toolkit/xre/nsAppRunner.cpp"], "git_node": null, "git_parents": [null], "node": "245f6e3d3003f9126e3e497bab433fa1f3d8425b", "parents": ["e70de1bbcf5fc7f1b1eeeaf2453d24a8916ed5ef"], "tags": []}, {"author": "Martin Thomson \u003cmartin.thomson@gmail.com\u003e", "branch": "default", "desc": "Bug 1036737 - Adding fallback SCSV use. r=dkeeler, a=bkerensa", "files": ["security/manager/ssl/src/nsNSSIOLayer.cpp"], "git_node": null, "git_parents": [null], "node": "08a13694dde6d18286854d5c2bcd19cf0e3e12e4", "parents": ["245f6e3d3003f9126e3e497bab433fa1f3d8425b"], "tags": []}, {"author": "Markus Stange \u003cmstange@themasta.com\u003e", "branch": "default", "desc": "Bug 1074280 - Use AsContainerLayer() in order to avoid a bad cast. r=roc, a=bkerensa", "files": ["gfx/layers/basic/BasicLayerManager.cpp"], "git_node": null, "git_parents": [null], "node": "26ec6429b69b2485ff294c22ffcfe170121c11ab", "parents": ["08a13694dde6d18286854d5c2bcd19cf0e3e12e4"], "tags": []}, {"author": "Martin Thomson \u003cmartin.thomson@gmail.com\u003e", "branch": "default", "desc": "Bug 1076983 - Disable SSL 3.0 with pref. r=keeler, a=bkerensa", "files": ["netwerk/base/public/security-prefs.js", "security/manager/ssl/src/nsNSSComponent.cpp"], "git_node": null, "git_parents": [null], "node": "a0524e2a9b0687c492c7d349a0343be055e60f09", "parents": ["26ec6429b69b2485ff294c22ffcfe170121c11ab"], "tags": []}], "date": 1414448337, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "101": {"changesets": [{"author": "Randell Jesup \u003crjesup@jesup.org\u003e", "branch": "default", "desc": "Bug 1079729: Fix handling of increasing number of SCTP channels used by DataChannels r=tuexen a=lsblakk", "files": ["media/webrtc/signaling/src/sipcc/core/gsm/h/fsm.h", "netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannelProtocol.h"], "git_node": null, "git_parents": [null], "node": "3c5b07daee616456b5887d32d78ffbc608662682", "parents": ["a0524e2a9b0687c492c7d349a0343be055e60f09"], "tags": []}], "date": 1414564084, "git_changesets": [null], "user": "rjesup@wgate.com"}, "102": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 981363 - Don't automove when the DOCUMENT_LOAD_COMPLETE is emitted for the actual document. r=yzen, a=bkerensa", "files": ["accessible/src/jsat/EventManager.jsm"], "git_node": null, "git_parents": [null], "node": "0c67b20350d9862db2aceccc8018860ef37700f3", "parents": ["3c5b07daee616456b5887d32d78ffbc608662682"], "tags": []}, {"author": "Jason Orendorff \u003cjorendorff@mozilla.com\u003e", "branch": "default", "desc": "Bug 1065604 - Assert that JSPROP_SHARED is set on all properties defined with JSPROP_GETTER or JSPROP_SETTER. r=Waldo, a=bkerensa", "files": ["js/src/builtin/Intl.cpp", "js/src/jsapi-tests/testDefineGetterSetterNonEnumerable.cpp", "js/src/vm/Shape.cpp", "js/src/vm/Shape.h", "js/xpconnect/src/XPCWrappedNativeJSOps.cpp"], "git_node": null, "git_parents": [null], "node": "6519e957e6decb5f27729b7b504f77b8441122a5", "parents": ["0c67b20350d9862db2aceccc8018860ef37700f3"], "tags": []}, {"author": "Jason Orendorff \u003cjorendorff@mozilla.com\u003e", "branch": "default", "desc": "Bug 1042567 - Reflect JSPropertyOp properties more consistently as data properties. r=efaust, a=lmandel", "files": ["js/src/jsobj.cpp"], "git_node": null, "git_parents": [null], "node": "4bc71e296ce3f60b671ce2e792962e30ccec088d", "parents": ["6519e957e6decb5f27729b7b504f77b8441122a5"], "tags": []}], "date": 1414588538, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "103": {"changesets": [{"author": "Benjamin Smedberg \u003cbenjamin@smedbergs.us\u003e", "branch": "default", "desc": "Bug 1063052 - In case a user ends up with unpacked chrome, on update use omni.ja again by removing chrome.manifest. r=rstrong, r=glandium, sr=dbaron, a=lsblakk", "files": ["browser/installer/removed-files.in"], "git_node": null, "git_parents": [null], "node": "d071f8dfe4d6932d793b2eb1abf43982ba23c8de", "parents": ["4bc71e296ce3f60b671ce2e792962e30ccec088d"], "tags": []}], "date": 1414590319, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "104": {"changesets": [{"author": "Ian Stakenvicius \u003caxs@gentoo.org\u003e", "branch": "default", "desc": "Bug 1090405 - Ensure that 'samples' is not negative in WebMReader. r=rillian, a=lmandel", "files": ["content/media/webm/WebMReader.cpp"], "git_node": null, "git_parents": [null], "node": "f25796531bbb00c241ed5185b089896b13724dd9", "parents": ["d071f8dfe4d6932d793b2eb1abf43982ba23c8de"], "tags": []}], "date": 1414605527, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "105": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-1023 - a=hsts-update", "files": ["security/manager/boot/src/nsSTSPreloadList.errors", "security/manager/boot/src/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "29f5dc720de91b9248aa41285c827e90fa1426a3", "parents": ["f25796531bbb00c241ed5185b089896b13724dd9"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-1023 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "b2f23baf98631d2651a6d55778033a39725f1401", "parents": ["29f5dc720de91b9248aa41285c827e90fa1426a3"], "tags": []}], "date": 1414683437, "git_changesets": [null, null], "user": "ffxbld"}, "106": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1091118 - Part 1: Remove $topsrcdir/gcc/bin from PATH on android builds. r=gps, a=lmandel\n\n$topsrcdir/gcc/bin was mistakenly added in bug 971841, but is not provided by\nanything the tooltool manifest for android builds pulls. It however is a path\nthat /may/ exist in the source tree when the slave ran a linux build before.\nWhen it does exist, the meaning of non-path-prefixed commands change,\ninfluencing what particular compiler is used in some cases.", "files": ["mobile/android/config/mozconfigs/common"], "git_node": null, "git_parents": [null], "node": "066cc8c84f9a0b7aea18db739e6c8517a12e70ff", "parents": ["b2f23baf98631d2651a6d55778033a39725f1401"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1091118 - Part 2: Do not use the top-level cache file for freetype2 subconfigure. r=gps, a=lmandel\n\nWe modify the environment before running freetype2 configure. When it uses\nthe same cache file, it stores knowledge about that environment in the cache\nfile. The cache file is then reused to configure in js/src, with yet again a\ndifferent environment, which makes subconfigure.py clear the cache because\nof the differences.\n\nThe configure in js/src is however invoked with the same environment as the\nmain configure was invoked with (mostly), so without freetype2 on the way,\nreusing the cache for it works as expected. In fact, it works better with the\ncache because of things coming from mozconfig that are not exported.\n\nWith freetype2 on the way, as mentioned above, the cache is cleared. Without\nthe cache, js/src/configure does new detections with a possibly different\nenvironment, and stores that in the cache. Until the next build, which then\nuses that different cache for the top-level configure.\n\nThis results in subtle differences in the HOST_CC/HOST_CXX variables on\nandroid builds because those variables are not exported from mozconfig,\ndepending on PATH, what the builder was building before, and if the build\nis a clobber.\n\nAvoiding the freetype2 subconfigure writing its environment variables change\nto the top-level cache makes the cache never invalidate for js/src.", "files": ["configure.in"], "git_node": null, "git_parents": [null], "node": "5b46dd1553714e411a109d00e9a164cd1ecd3a22", "parents": ["066cc8c84f9a0b7aea18db739e6c8517a12e70ff"], "tags": []}], "date": 1414769575, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "107": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host b-linux64-ix-0004 - a=hsts-update", "files": ["security/manager/boot/src/nsSTSPreloadList.errors", "security/manager/boot/src/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "a022ab136399b0710df115ae6f966637232cbb04", "parents": ["5b46dd1553714e411a109d00e9a164cd1ecd3a22"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host b-linux64-ix-0004 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "a34e3739902581576a755d327ff7e7c6e3b42d40", "parents": ["a022ab136399b0710df115ae6f966637232cbb04"], "tags": []}], "date": 1414837067, "git_changesets": [null, null], "user": "ffxbld"}, "108": {"changesets": [{"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1072847 - Initialize mSurface. r=BenWa, a=bkerensa", "files": ["gfx/2d/DrawTargetCairo.cpp"], "git_node": null, "git_parents": [null], "node": "c5ffa5e63d9929a44508f88a219e976807dfb0cf", "parents": ["a34e3739902581576a755d327ff7e7c6e3b42d40"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1087633 - Filter out XPConnect wrapped input streams. r=bz, a=lmandel", "files": ["content/base/src/nsXMLHttpRequest.h"], "git_node": null, "git_parents": [null], "node": "d38075a0a0f6261395e62661c5a1650f15ce75b7", "parents": ["c5ffa5e63d9929a44508f88a219e976807dfb0cf"], "tags": []}], "date": 1415032065, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "109": {"changesets": [{"author": "ffxbld", "branch": "GECKO3121esr_2014110314_RELBRANCH", "desc": "Automated checkin: version bump for firefox 31.2.1esr release. DONTBUILD CLOSED TREE a=release", "files": ["browser/config/version.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "b7e8f382d7ac1bdffb1ce5a770af27ca0a00b3f5", "parents": ["d38075a0a0f6261395e62661c5a1650f15ce75b7"], "tags": ["FIREFOX_31_2_1esr_BUILD1", "FIREFOX_31_2_1esr_RELEASE"]}, {"author": "ffxbld", "branch": "GECKO3121esr_2014110314_RELBRANCH", "desc": "Added FIREFOX_31_2_1esr_RELEASE FIREFOX_31_2_1esr_BUILD1 tag(s) for changeset b7e8f382d7ac. DONTBUILD CLOSED TREE a=release", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "3eebc30ded7a3cb5f4a074752d8d84bf1cbb711f", "parents": ["b7e8f382d7ac1bdffb1ce5a770af27ca0a00b3f5"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "Automated checkin: version bump for firefox 31.2.1esr release. DONTBUILD CLOSED TREE a=release", "files": ["browser/config/version.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "dbeda9908c0548aa48b05c6a901eff248ffd653e", "parents": ["d38075a0a0f6261395e62661c5a1650f15ce75b7"], "tags": []}], "date": 1415042397, "git_changesets": [null, null, null], "user": "ffxbld"}, "110": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1045958 - Part 1: Add USE_ICU variable separated from ENABLE_INTL_API, and enable it on Mac OS X. r=josh, a=bkerensa", "files": ["build/autoconf/icu.m4", "configure.in", "intl/icu/Makefile.in", "toolkit/library/libxul.mk"], "git_node": null, "git_parents": [null], "node": "901e2b4daebf1f0fadc70d3222d386a4dfd900ad", "parents": ["dbeda9908c0548aa48b05c6a901eff248ffd653e"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1045958 - Part 2: Use raw ICU instead of CoreServices API in Unicode collation on Mac OS X, disabled by default. r=josh, a=bkerensa", "files": ["intl/build/moz.build", "intl/locale/src/mac/moz.build", "intl/locale/src/mac/nsCollationMacUC.cpp", "intl/locale/src/mac/nsCollationMacUC.h", "intl/locale/tests/unit/test_collation_mac_icu.js", "intl/locale/tests/unit/xpcshell.ini", "modules/libpref/src/init/all.js"], "git_node": null, "git_parents": [null], "node": "3bb63d3b9eeaf9a7116f1d7a48960c1107e8a42f", "parents": ["901e2b4daebf1f0fadc70d3222d386a4dfd900ad"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1088635. r=smaug, a=bkerensa", "files": ["content/base/src/nsDocument.cpp", "parser/html/nsHtml5Parser.cpp", "parser/html/nsHtml5Parser.h", "parser/html/nsHtml5StreamParser.cpp", "parser/html/nsHtml5StreamParser.h", "parser/html/nsHtml5TreeBuilderCppSupplement.h", "parser/html/nsHtml5TreeBuilderHSupplement.h", "parser/html/nsHtml5TreeOpExecutor.cpp", "parser/html/nsHtml5TreeOpExecutor.h", "parser/html/nsHtml5TreeOperation.cpp", "parser/html/nsHtml5TreeOperation.h"], "git_node": null, "git_parents": [null], "node": "46ae75f63ddc75cd6437176e2d5684b635503625", "parents": ["3bb63d3b9eeaf9a7116f1d7a48960c1107e8a42f"], "tags": []}], "date": 1415310545, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "111": {"changesets": [{"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1089207: fix parsing of invalid fmtp att r=drno,jesup a=lmandel", "files": ["media/webrtc/signaling/src/sipcc/core/sdp/sdp_attr.c", "media/webrtc/signaling/src/sipcc/core/sdp/