f9b90d9ebfd1f232787fc8b014f1482ede2"], "tags": []}], "date": 1416591353, "git_changesets": [null], "user": "armenzg@mozilla.com"}, "129": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-152 - a=hsts-update", "files": ["security/manager/boot/src/nsSTSPreloadList.errors", "security/manager/boot/src/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "5904767b9ed14e94f68cd4b0fc04a56ef05c58ec", "parents": ["0be79c17ef5921f2fa9afb0781e6ecc76067f382"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-152 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "ea150698d0b308a5bc0fce0a9581db903d61435a", "parents": ["5904767b9ed14e94f68cd4b0fc04a56ef05c58ec"], "tags": []}], "date": 1416655011, "git_changesets": [null, null], "user": "ffxbld"}, "130": {"changesets": [{"author": "Shu-yu Guo \u003cshu@rfrn.org\u003e", "branch": "default", "desc": "Bug 1005458 - Argument slot phis are always observable in non-strict scripts due to Function.arguments. r=nbp, a=bkerensa", "files": ["js/src/jit/CompileInfo.h", "js/src/jit/IonAnalysis.cpp", "js/src/jit/LIR.h"], "git_node": null, "git_parents": [null], "node": "251dfa40560fab9a0fd6cc3d27e78baa60e07868", "parents": ["ea150698d0b308a5bc0fce0a9581db903d61435a"], "tags": []}, {"author": "Steven Michaud \u003csmichaud@pobox.com\u003e", "branch": "default", "desc": "Bug 1044497 - Fix Yosemite build error (cannot initialize a parameter of type 'NSEventType' with an lvalue of type 'uint32_t'). r=spohl, a=lsblakk", "files": ["widget/cocoa/nsChildView.mm"], "git_node": null, "git_parents": [null], "node": "79aaf766cb1e702c0732905243305d034e10bd8f", "parents": ["251dfa40560fab9a0fd6cc3d27e78baa60e07868"], "tags": []}, {"author": "Ralph Giles \u003cgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1054043 - Remove wrapcommand. r=ted, a=bkerensa\n\nThis code was only needed on osx 10.5, and the version string compare\nfails on osx 10.10.", "files": ["build/automation.py.in", "build/automationutils.py"], "git_node": null, "git_parents": [null], "node": "a8f4bdfb0a8998bb6675a00da38eb509f56c79e7", "parents": ["79aaf766cb1e702c0732905243305d034e10bd8f"], "tags": []}, {"author": "Ralph Giles \u003cgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1054043 - Remove 32 bit cmd wapper from mozrunner. r=ted, a=bkerensa\n\nWe no longer support MacOS 10.5 and the version string compare\nfails on 10.10. Unbreaks running the mochitests there.", "files": ["testing/mozbase/mozrunner/mozrunner/local.py"], "git_node": null, "git_parents": [null], "node": "9fbebd701b4ff563e1f7e666284c516e6619c753", "parents": ["a8f4bdfb0a8998bb6675a00da38eb509f56c79e7"], "tags": []}, {"author": "Ralph Giles \u003cgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1045231 - Namespace nrAppKit's htonll. r=abr, a=bkerensa\n\nThis avoids conflicts with any system-provided versions, like\non Apple MacOS X 10.10.", "files": ["media/mtransport/third_party/nICEr/src/stun/stun_codec.c", "media/mtransport/third_party/nrappkit/src/util/byteorder.c", "media/mtransport/third_party/nrappkit/src/util/byteorder.h"], "git_node": null, "git_parents": [null], "node": "e7b6eb1f8484564419b0138abb70fd1d85c055c5", "parents": ["9fbebd701b4ff563e1f7e666284c516e6619c753"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1095128 - Make sure add-on updates remain disabled after each browser chrome test. r=Unfocused, a=test-only", "files": ["toolkit/mozapps/extensions/test/browser/head.js"], "git_node": null, "git_parents": [null], "node": "5457356eada00f86ad8298fc2853b51e127a72f0", "parents": ["e7b6eb1f8484564419b0138abb70fd1d85c055c5"], "tags": []}], "date": 1416844493, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "131": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 251dfa40560f (bug 1005458) for jit-test failures.", "files": ["js/src/jit/CompileInfo.h", "js/src/jit/IonAnalysis.cpp", "js/src/jit/LIR.h"], "git_node": null, "git_parents": [null], "node": "809a30c15b76fa7a85a0763caac648cd726bd96d", "parents": ["5457356eada00f86ad8298fc2853b51e127a72f0"], "tags": []}], "date": 1416850561, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "132": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1031132 - Refactor mach environment to use logic from MachCommandBase instead of its own. r=gps a=NPOTB\n\nAlso don't print section titles when there is nothing under them, and move\nmove the ObjdirMismatchException handling to MachCommandBase.", "files": ["python/mozbuild/mozbuild/base.py", "python/mozbuild/mozbuild/mach_commands.py"], "git_node": null, "git_parents": [null], "node": "18290cdb715222e870cd92be755b7b5f44c1b35a", "parents": ["809a30c15b76fa7a85a0763caac648cd726bd96d"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 762358 - Re-run configure when mozconfig changed in a significant way. r=gps a=NPOTB\n\nThis adds a format option to mach environment and uses it in client.mk to\ncreate a .mozconfig.json in the objdir, containing all the relevant data\nfrom mozconfig. If the mozconfig doesn't change in a way that alters that\ndata, we still skip configure.\n\nAt the same time, use mach environment in place of mozconfig2configure and\nmozconfig2client-mk, which makes us now have only one mozconfig reader.\n\nAlso, in the mozconfig reader, keep track of environment variables (as\nopposed to shell variables), so that changes such as a variable that was\nexported not being exported anymore is spotted. At the opposite, in order\nfor irrelevant environment variable changes not to incur in re-running\nconfigure, only a set of environment variables are stored when they are\nunmodified. Otherwise, changes such as using a different terminal window,\nor even rebooting, would trigger reconfigures.\n\nFinally, make mach environment emit both MOZ_OBJDIR and OBJDIR for\nclient.mk, and cleanup some objdir-related things in client.mk..\nAt the same time, make the mozconfig reader take MOZ_OBJDIR from the\nenvironment if it is defined there and not in the mozconfig.\n\nConflicts:\n\tclient.mk\n\tpython/mozbuild/mozbuild/base.py", "files": ["build/autoconf/altoptions.m4", "build/autoconf/mozconfig-find", "build/autoconf/mozconfig2client-mk", "build/autoconf/mozconfig2configure", "client.mk", "python/mozbuild/mozbuild/base.py", "python/mozbuild/mozbuild/mach_commands.py", "python/mozbuild/mozbuild/mozconfig.py", "python/mozbuild/mozbuild/mozconfig_loader", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/test/test_base.py", "python/mozbuild/mozbuild/test/test_mozconfig.py", "testing/xpcshell/selftest.py"], "git_node": null, "git_parents": [null], "node": "a9fc0ee99b7225d7622a1d403ca1258cd5ab0467", "parents": ["18290cdb715222e870cd92be755b7b5f44c1b35a"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 762358 - Fixup test_objdir_config_status to use config.guess output as base. r=gps a=NPOTB", "files": ["python/mozbuild/mozbuild/test/test_base.py"], "git_node": null, "git_parents": [null], "node": "0a98654ebabef4a064996b450bd30c0820fde3fe", "parents": ["a9fc0ee99b7225d7622a1d403ca1258cd5ab0467"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 762358 - Fixup the fixup not to break on windows. r=me a=NPOTB", "files": ["python/mozbuild/mozbuild/test/test_base.py"], "git_node": null, "git_parents": [null], "node": "1d25e9dbfa8966e1ce039d8f38e8b780c01540c8", "parents": ["0a98654ebabef4a064996b450bd30c0820fde3fe"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1031180 - Fallback to checking whether the directory mach lives in contains mach_bootstrap.py. r=gps a=NPOTB", "files": ["mach"], "git_node": null, "git_parents": [null], "node": "7e37a85a056d7f0aa2b9e291dc78c245bca60658", "parents": ["1d25e9dbfa8966e1ce039d8f38e8b780c01540c8"], "tags": []}], "date": 1416863383, "git_changesets": [null, null, null, null, null], "user": "mshal@mozilla.com"}, "133": {"changesets": [{"author": "ffxbld", "branch": "GECKO3130esr_2014112501_RELBRANCH", "desc": "Automated checkin: version bump for firefox 31.3.0esr release. DONTBUILD CLOSED TREE a=release", "files": ["browser/config/version.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "64b51e517f43eefcf8e3a753b9c16cffa332dc8c", "parents": ["7e37a85a056d7f0aa2b9e291dc78c245bca60658"], "tags": ["FIREFOX_31_3_0esr_BUILD1"]}, {"author": "ffxbld", "branch": "GECKO3130esr_2014112501_RELBRANCH", "desc": "Added FIREFOX_31_3_0esr_RELEASE FIREFOX_31_3_0esr_BUILD1 tag(s) for changeset 64b51e517f43. DONTBUILD CLOSED TREE a=release", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "c259165276476e32c2f1414ca72f3300c076daff", "parents": ["64b51e517f43eefcf8e3a753b9c16cffa332dc8c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "Automated checkin: version bump for firefox 31.3.0esr release. DONTBUILD CLOSED TREE a=release", "files": ["browser/config/version.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "eaca15101d8d56d7c991cf407da38520ac10bc44", "parents": ["7e37a85a056d7f0aa2b9e291dc78c245bca60658"], "tags": []}], "date": 1416896270, "git_changesets": [null, null, null], "user": "ffxbld"}, "134": {"changesets": [{"author": "ffxbld", "branch": "GECKO3130esr_2014112505_RELBRANCH", "desc": "Automated checkin: version