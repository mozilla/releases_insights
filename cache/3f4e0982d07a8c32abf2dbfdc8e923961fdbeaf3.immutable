pc/PContent.ipdl", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpBaseChannel.h"], "git_node": null, "git_parents": [null], "node": "f47ae81a0669a1210b364650d37013cef38e9b61", "parents": ["8639f9183f6f9b0115725cfef98766e2dea9d6b4"], "tags": []}], "date": 1664326101, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "94": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158320", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "d2eada294a1b9be95508984ad883108f226af734", "parents": ["f47ae81a0669a1210b364650d37013cef38e9b61"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1782523 - Update NodeJS to latest versions for the branches on ESR. r=nalexander, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158185", "files": ["python/mozbuild/mozbuild/nodeutil.py", "taskcluster/ci/fetch/toolchains.yml", "taskcluster/docker/recipes/install-node.sh"], "git_node": null, "git_parents": [null], "node": "fed1584c697b6ba351cd90c04388cb444a6a06ef", "parents": ["d2eada294a1b9be95508984ad883108f226af734"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1792227 - Update node to v16.17.1. r=firefox-build-system-reviewers,ahochheiden a=RyanVM", "files": ["taskcluster/ci/fetch/toolchains.yml"], "git_node": null, "git_parents": [null], "node": "4befcfc4491f5ceca16ae67b05d7602240436886", "parents": ["fed1584c697b6ba351cd90c04388cb444a6a06ef"], "tags": []}], "date": 1664589525, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "95": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1792882 - test_interfaces.js should not check pref values. r=smaug, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158359", "files": ["dom/tests/mochitest/general/test_interfaces.js"], "git_node": null, "git_parents": [null], "node": "95c63cae1e1b76b8fae152477c173b14b01023bb", "parents": ["4befcfc4491f5ceca16ae67b05d7602240436886"], "tags": []}], "date": 1664590822, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "96": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158498", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "5421654504cbb8a3c7cd5aa3d920408746aaa4b7", "parents": ["95c63cae1e1b76b8fae152477c173b14b01023bb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1786521 - Fix AppearanceValueAffectsFrames. r=TYLin, a=RyanVM\n\nWe had zero tests for this, and when I implemented the optimization to\navoid reframing in most cases I apparently swapped the arguments ;_;\n\nFix \u003cinput type=search\u003e which suffered from the same issue, but we don't\nship by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155394", "files": ["layout/reftests/forms/input/number/appearance-textfield-dynamic.html", "layout/reftests/forms/input/number/appearance-textfield.html", "layout/reftests/forms/input/number/reftest.list", "layout/reftests/forms/input/number/text.html", "layout/reftests/forms/input/search/appearance-textfield-dynamic.html", "layout/reftests/forms/input/search/appearance-textfield.html", "layout/reftests/forms/input/search/reftest.list", "layout/reftests/forms/input/search/text.html", "layout/style/nsStyleStruct.cpp"], "git_node": null, "git_parents": [null], "node": "be8c504bf505da40a57ca0594c190f19cd6cd43f", "parents": ["5421654504cbb8a3c7cd5aa3d920408746aaa4b7"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1791363 - Process newly added marking work after performing delayed marking r=sfink a=RyanVM\n\nDelayed marking may push more (normal, non-delayed) marking work. We need to do\nthis before switch mark color from black to gray since we cannot add gray\nmarking work while there is black marking work on the stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157733", "files": ["js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp", "js/src/jit-test/tests/gc/bug-1791363.js"], "git_node": null, "git_parents": [null], "node": "7d6ec2f15021add178b885dc2cb0914429fe04ba", "parents": ["be8c504bf505da40a57ca0594c190f19cd6cd43f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1791363 - Rename GCMarker::color to avoid confusion with local variables r=sfink a=RyanVM\n\nIt's pretty confusing that this name is sometimes used for local variables and\nsometimes refers to the current mark color.\n\nDepends on D157733\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157734", "files": ["js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp"], "git_node": null, "git_parents": [null], "node": "aed0e9bb26e0f02faf0f13e3de4a9de806b6d98e", "parents": ["7d6ec2f15021add178b885dc2cb0914429fe04ba"], "tags": []}], "date": 1664808663, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "97": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1771125 - Don't bother trying to start the font-info loader if we're already shutting down. r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153335", "files": ["gfx/thebes/gfxPlatformFontList.cpp"], "git_node": null, "git_parents": [null], "node": "b2ff4884dce71fe3240711a8bb16d767ec11eae2", "parents": ["aed0e9bb26e0f02faf0f13e3de4a9de806b6d98e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1786259 - Avoid potential deadlock via AddWithLegacyFamilyName when shared-fontlist is disabled (incl. safe mode). r=gfx-reviewers,aosmond a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157311", "files": ["gfx/thebes/gfxFontEntry.cpp"], "git_node": null, "git_parents": [null], "node": "5fbc2b5e30eb581e4bbb262a64c085413b2f1dd3", "parents": ["b2ff4884dce71fe3240711a8bb16d767ec11eae2"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1786910: Ignore 'align-content' when determining the aligned static position of abspos flex children. r=TYLin a=RyanVM\n\nBefore this patch, we honored `align-content` (in combination with\n`align-self`) for cross-axis alignment for abspos flex children **in cases\nwhere the flex container was multi-line**. This was a bit weird, but was\nrequired by the spec, and made some sense in the spirit of aligning the abspos\nbox as if it were the sole flex item in a flex container.\n\nNow the CSSWG has resolved in [1] to simplify things by just ignoring\n`align-content` for abspos flex children. So, this patch updates us in\naccordance with this change. Such items now only have to look at `align-self`\nfor cross-axis alignment to determine their static position in their flex\ncontainer.\n\nBefore this commit, we had a bunch of WPT tests to check the impact of every\nalign-content value, with all of the various flavors of directionality.  Now\nthat align-content has *no effect* in any of these cases, all of these tests\nbecome pretty trivial and redundant.  Rather than carrying them all forward\nwith trivial \"no impact\" expectations for each scenario, I've just updated the\nfirst/simplest such test to expect no-behavioral-impact and I've removed the\nrest.\n\n[1] https://github.com/w3c/csswg-drafts/issues/7596#issuecomment-1225952646\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157571", "files": ["layout/generic/nsFlexContainerFrame.cpp", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-001.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-002.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-003.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-004.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-005.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-006.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-007.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-008.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-rtl-001.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-rtl-002.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-vertWM-001.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-align-content-vertWM-002.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-fallback-align-content-001-ref.html", "testing/web-platform/tests/css/css-flexbox/abspos/flex-abspos-staticpos-fallback-align-content-001.html"], "git_node": null, "git_parents": [null], "node": "abc8ebe968f7a17536ef6fdf343b2e3f57b9206b", "parents": ["5fbc2b5e30eb581e4bbb262a64c085413b2f1dd3"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1773212 - Fix OS authentication checkbox for credit card autofill not wrapping its text. r=sgalich, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150426", "files": ["toolkit/components/formautofill/FormAutofillPreferences.jsm"], "git_node": null, "git_parents": [null], "node": "367500497c47b489593e81c700379022ab7b9409", "parents": ["abc8ebe968f7a17536ef6fdf343b2e3f57b9206b"], "tags": []}], "date": 1664819262, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "98": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1789874 - Fix colors used by nsListControlFrame::PaintFocus. r=mstange a=pascalc\n\nThe regressing bug accidentally swapped the foreground / bg colors in a\nway such that it doesn't look like there's an outline.\n\nDo some adjacent clean-up while at it, and add a test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156947", "files": ["layout/forms/nsListControlFrame.cpp", "layout/reftests/forms/select/listbox-focus-notref.html", "layout/reftests/forms/select/listbox-focus.html", "layout/reftests/forms/select/reftest.list"], "git_node": null, "git_parents": [null], "node": "4e0ce7e8454ce6f3ebaea6ad4540fa564bfa3494", "parents": ["367500497c47b489593e81c700379022ab7b9409"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1789439 - Don't allow reentrant programmatic print calls. r=smaug,peterv a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156682", "files": ["dom/base/nsGlobalWindowOuter.cpp"], "git_node": null, "git_parents": [null], "node": "a00311e3e4786688d8ae204fd23b1ecda56b0e30", "parents": ["4e0ce7e8454ce6f3ebaea6ad4540fa564bfa3494"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1789439 - Throw rather than logging an error when tab-modal print is already open. r=mstriemer a=pascalc\n\nIf we succeed but return null, we end up retargeting to a new window\nhere:\n\n  https://searchfox.org/mozilla-central/rev/3aaca0a12a2d1463da54933bdbdae2f06fead06f/dom/ipc/ContentParent.cpp#5462-5465\n\nWhich is bad.\n\nDepends on D156682\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156683", "files": ["toolkit/components/printing/content/printUtils.js"], "git_node": null, "git_parents": [null], "node": "885afd7b97c1d2f690dffc9630790e87dabf2c95", "parents": ["a00311e3e4786688d8ae204fd23b1ecda56b0e30"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1789439 - Fix browser_modal_print.js after previous patch. a=pascalc\n\nMANUAL PUSH: Orange fix CLOSED TREE", "files": ["toolkit/components/printing/tests/browser_modal_print.js"], "git_node": null, "git_parents": [null], "node": "a941a8b2101ad98d752fbae27e52404f42610457", "parents": ["885afd7b97c1d2f690dffc9630790e87dabf2c95"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158755", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6ca04de657e515f057fb740af104e6847bd67f00", "parents": ["a941a8b2101ad98d752fbae27e52404f42610457"], "tags": []}], "date": 1665056794, "git_changesets": [null, null, null, null, null], "user": "pchev