"pushes": {"100": {"changesets": [{"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1791520: Add some keep alive annotations. r=jandem a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157735", "files": ["js/src/jit/IonAnalysis.cpp"], "git_node": null, "git_parents": [null], "node": "52928ba6fd91414091326fe6339bc63e89b593a6", "parents": ["ffc2423e18a73de6a529fc36d7f3c921fe4f6be2"], "tags": ["FIREFOX_102_4_0esr_BUILD1", "FIREFOX_102_4_0esr_RELEASE"]}], "date": 1665402359, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "85": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging c2dd0f1c0adfb1fa1c5d9319fbe023d324c34db6 with FIREFOX_102_3_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "30bc108a0805731d97e1e332ae0ee9a6ac133939", "parents": ["c2dd0f1c0adfb1fa1c5d9319fbe023d324c34db6"], "tags": []}], "date": 1663001603, "git_changesets": [null], "user": "ffxbld"}, "86": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "70b2c12a5bc3e6c8976c8e8b15918b39355ad4b3", "parents": ["30bc108a0805731d97e1e332ae0ee9a6ac133939"], "tags": []}], "date": 1663581003, "git_changesets": [null], "user": "ffxbld-merge"}, "87": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157630", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6bf6a0fef5dd785dba7826805f723c2c622bd36f", "parents": ["70b2c12a5bc3e6c8976c8e8b15918b39355ad4b3"], "tags": []}], "date": 1663595955, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "88": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging c2dd0f1c0adfb1fa1c5d9319fbe023d324c34db6 with FIREFOX_102_3_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "c510b46eb51654c570036b15cf219bb240e421eb", "parents": ["6bf6a0fef5dd785dba7826805f723c2c622bd36f"], "tags": []}], "date": 1663678140, "git_changesets": [null], "user": "ffxbld"}, "89": {"changesets": [{"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1786292 - part 2: Switch cron-bouncer-check away from esr91 r=jcristau a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156973", "files": ["taskcluster/ci/cron-bouncer-check/kind.yml", "testing/mozharness/configs/releases/bouncer_firefox_esr.py"], "git_node": null, "git_parents": [null], "node": "97ecca46a31d293d6ba07c9b6230d66ea2cd2195", "parents": ["c510b46eb51654c570036b15cf219bb240e421eb"], "tags": []}], "date": 1663679277, "git_changesets": [null], "user": "jlorenzo@mozilla.com"}, "90": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1788684 - exclude asus.com from HSTS preload list. r=dveditz, a=RyanVM", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js"], "git_node": null, "git_parents": [null], "node": "1366bd42c7f2339469dfd908cc8908c4eae10c22", "parents": ["97ecca