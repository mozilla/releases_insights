r", "third_party/libwebrtc/call/version.cc"], "git_node": "04d610ce7ce22c0dfce933c8646499b93c314013", "git_parents": ["0804770d0fc63bceb677821cfb105e0a5097995e"], "node": "eac913b8fe59b45d5ccbad3940b0cc6da3364dd1", "parents": ["5303770646a5490917736349d4127c63d67e1aba"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 23b9b04979\n\nUpstream commit: https://webrtc.googlesource.com/src/+/23b9b049795d12f5b53976f75212b1207f84c865\n    Use StringBuilder::Release() instead of str() across codebase\n\n    Replace calls to rtc::StringBuilder::str() with Release() when assigning or returning std::string objects, moving the underlying buffer directly to eliminate unnecessary string copy allocations.\n\n    TAG=agy\n\n    Bug: webrtc:374845009\n    Change-Id: Ie0ed5cc575ff94fb93608f3b1b080b7d291a2a4a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493040\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48274}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/audio_coding/neteq/tools/neteq_rtpplay.cc", "third_party/libwebrtc/modules/audio_processing/agc2/cpu_features.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/test/test_screencast_stream_provider.cc", "third_party/libwebrtc/modules/desktop_capture/win/desktop_capture_utils.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0072.patch", "third_party/libwebrtc/moz-patch-stack/s0073.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch", "third_party/libwebrtc/net/dcsctp/socket/dcsctp_socket.cc", "third_party/libwebrtc/pc/channel.cc", "third_party/libwebrtc/pc/peer_connection_stability_integrationtest.cc", "third_party/libwebrtc/test/scenario/column_printer.cc", "third_party/libwebrtc/video/quality_scaling_tests.cc", "third_party/libwebrtc/video/send_statistics_proxy.cc", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_send_stream_tests.cc"], "git_node": "afebea2180e70334eeb604fde946bd87396f99d7", "git_parents": ["04d610ce7ce22c0dfce933c8646499b93c314013"], "node": "27bd0c91784185ceac3e2b6ffd22fceed9c0b23a", "parents": ["eac913b8fe59b45d5ccbad3940b0cc6da3364dd1"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 6af87f3957\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6af87f39573d28b521e2cdd31d82ccf0a1067ea1\n    Remove RtcEventLogEncoderLegacy from production build targets\n\n    This change removes the legacy RTC event log encoder (RtcEventLogEncoderLegacy)\n    and unlinks rtc_event_log.proto from the rtc_event_log_impl_encoder GN target.\n    The legacy proto definition remains in the codebase for offline log parsing,\n    but is excluded from production binary targets to reduce library size overhead.\n\n    TAG=agy\n    CONV=ac69de71-4eeb-4b00-b142-f66d9edf397b\n\n    Bug: b/144833892\n    Change-Id: I19dc889655c3c41b37f5e5bc6d876e21f09df14f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493000\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48275}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/logging/BUILD.gn", "third_party/libwebrtc/logging/rtc_event_log/encoder/rtc_event_log_encoder_legacy.cc", "third_party/libwebrtc/logging/rtc_event_log/encoder/rtc_event_log_encoder_legacy.h", "third_party/libwebrtc/logging/rtc_event_log/encoder/rtc_event_log_encoder_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/unsafe_buffers_paths.txt"], "git_node": "600d495650e23e70f9bb7e18914157d549e1db9c", "git_parents": ["afebea2180e70334eeb604fde946bd87396f99d7"], "node": "3a93702603151117d9dc380aa444df36fd95b394", "parents": ["27bd0c91784185ceac3e2b6ffd22fceed9c0b23a"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 15bd697f29\n\nUpstream commit: https://webrtc.googlesource.com/src/+/15bd697f2974e9dc046855f26ced5ee48cd1a563\n    In RTCPReceiver keep single stat object for non-sender RTT\n\n    RTCPReceiver expose non-sender RTT stats object only for single\n    remote_ssrc_. Discard other SSRCs when saving such object rather than\n    returning it. Though that may prevent returning such stats received\n    before remote ssrc is set, changing remote SSRC is rare enough event not\n    to worry about such edge case.\n\n    Bug: b/510362788\n    Change-Id: I17ff0427af54f3290eff181be92e5542196c7e58\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/492820\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48276}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0066.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch"], "git_node": "bbc99352bfb38462af909ff396d3e6dca57ab707", "git_parents": ["600d495650e23e70f9bb7e18914157d549e1db9c"], "node": "4aa91b6e686fd0fb120dc3e47bcaa3d12b131670", "parents": ["3a93702603151117d9dc380aa444df36fd95b394"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from cfa20d6668\n\nUpstream commit: https://webrtc.googlesource.com/src/+/cfa20d666849dd24e2f8d80dcd14c093fefe5c7f\n    Call: Consolidate OnSentPacket worker thread dispatch\n\n    By moving the worker thread PostTask for OnSentPacket up to Call, we\n    ensure that both SendDelayStats and RtpTransportControllerSend handle\n    OnSentPacket on the worker thread.\n\n    This also allows us to eliminate the internal Mutex in SendDelayStats\n    and clarifies the threading model by removing the redundant task posting\n    logic from RtpTransportControllerSend.\n\n    Bug: webrtc:42222117, webrtc:42222116\n    Change-Id: I977d3edfcce4bc230631d87a92af5ba74bc04ec3\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493180\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48277}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/call.cc", "third_party/libwebrtc/call/rtp_transport_controller_send.cc", "third_party/libwebrtc/moz-patch-stack/s0123.patch", "third_party/libwebrtc/video/send_delay_stats.cc", "third_party/libwebrtc/video/send_delay_stats.h"], "git_node": "d4d9935498aa964cb7a14c0368721e7ddba40295", "git_parents": ["bbc99352bfb38462af909ff396d3e6dca57ab707"], "node": "6e83df8e75885dc55b79f01bdc962405f2c7596c", "parents": ["4aa91b6e686fd0fb120dc3e47bcaa3d12b131670"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 8c33f35c41\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8c33f35c41b14ebd787ef9d9467f1a2cb99945c1\n    Update WebRTC code version (2026-08-04T04:07:39).\n\n    Bug: None\n    Change-Id: I5f80c3d535c59a8bcd56d1ec7dc92de5d4f74cd6\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493661\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48278}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "1ca8b8c02e4c6f1e0bf08917f1788b18674eef58", "git_parents": ["d4d9935498aa964cb7a14c0368721e7ddba40295"], "node": "dea36c8ad28e576b3f6a1a2fd3418535ee0505f0", "parents": ["6e83df8e75885dc55b79f01bdc962405f2c7596c"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from c71f5a2dcf\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c71f5a2dcfcbd5b27e7f532bdb26a755b430fcab\n    Remove PortAudio directory and license metadata\n\n    Remove remaining PortAudio license files (LICENSE, README.chromium)\n    and remove PortAudio from generate_licenses.py.\n\n    TAG=agy\n    CONV=2d0880c7-8a5b-4e46-938b-9382f073ace4\n\n    Bug: chromium:538007096\n    Change-Id: Ie53fc204c773a3f23ba472a3242d41a3ab898ee2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/492840\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48279}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/third_party/portaudio/BUILD.gn", "third_party/libwebrtc/modules/third_party/portaudio/LICENSE", "third_party/libwebrtc/modules/third_party/portaudio/README.chromium", "third_party/libwebrtc/tools_webrtc/libs/generate_licenses.py"], "git_node": "3d0b7291931697a3dac32198967bd61076a8089e", "git_parents": ["1ca8b8c02e4c6f1e0bf08917f1788b18674eef58"], "node": "c53ba6d1d80fc781de7c800777f969d3e05c52ce", "parents": ["dea36c8ad28e576b3f6a1a2fd3418535ee0505f0"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 3f30de47cc\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3f30de47ccadd80ed633ee2d877b997cac64a9eb\n    Refactor SendStats to use explicit ReportStats method\n\n    Move stats reporting in SendStats from the destructor to an explicit\n    ReportStats method called directly with the current timestamp and first\n    sent packet time. This is a part of allowing Call to be destructed on\n    the signaling thread eventually.\n\n    This allows removal of member variables such as first_sent_packet_time_\n    and destructor_sequence_checker_ which aren't strictly necessary. I'm\n    renaming the sequence_checker_ variable to worker_thread_checker_ to\n    better clarify execution scope.\n\n    Lastly, also removing the `send_transport_sequence_checker_` which was\n    the same as checking for the worker thread and simply check for the\n    worker thread instead. `send_transport_sequence_checker_` existed as\n    part of a previous refactoring effort but now just made the code harder\n    to reason about. With that additional clarity, we can also remove\n    unnecessary use of std::atomic.\n\n    Bug: webrtc:42222117, webrtc:42222116\n    Change-Id: I31fb6da9d7806276d05383d397c1d1a7a28a7749\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493200\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48280}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/call.cc"], "git_node": "b90720a70ed225042a3960c7431d1be5f35c3507", "git_parents": ["3d0b7291931697a3dac32198967bd61076a8089e"], "node": "6a3eef2c5ea947cabdec6e075f7b073b3fcffd1e", "parents": ["c53ba6d1d80fc781de7c800777f969d3e05c52ce"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from fcbecc1fd4\n\nUpstream commit: https://webrtc.googlesource.com/src/+/fcbecc1fd47deeb00e03cf79ff53e28a13da0396\n    Restrict total size of labels and protocol strings of data channels\n\n    Bug: b/510362665\n    Change-Id: I480927a6125283492fb3bae266856bd41f0fb1d3\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493600\n    Reviewed-by: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48281}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/pc/data_channel_controller.cc"], "git_node": "058d4e6461d20e6a1566fb4b6cd06627d5ab3ec8", "git_parents": ["b90720a70ed225042a3960c7431d1be5f35c3507"], "node": "f1f3f660d0de1b73f29016ee5eb55d573944b04f", "parents": ["6a3eef2c5ea947cabdec6e075f7b073b3fcffd1e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from a4ba998db1\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a4ba998db110aa0dfe73278e4158ac7472bdbe1d\n    Remove audio/red if it does not point to a primary codec\n\n    which can e.g. happen if opus is removed via SetCodecPreferences.\n\n    Bug: webrtc:42221750\n    Change-Id: I394d45c74b4eeb0b3a9eb8e846fa57ab8bc6a6b8\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/488085\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48282}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/codec_vendor.cc", "third_party/libwebrtc/pc/peer_connection_media_unittest.cc"], "git_node": "5db77b6b1e720d9dfc74ced9a4a6ff9f413b2ad7", "git_parents": ["058d4e6461d20e6a1566fb4b6cd06627d5ab3ec8"], "node": "5506c9f4abad525a653f1b6b0f25737024c4009b", "parents": ["f1f3f660d0de1b73f29016ee5eb55d573944b04f"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 8f81183fb9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8f81183fb9a4f41f3239ebaeae7655ec5888de02\n    Embed RtpPacketInfo into PacketBuffer::Packet\n\n    This allows to remove dedicated map for RtpPacketInfos, extra map lookup\n    to find packet info for matching packet, and avoids need for\n    an extra RtpPacketInfo lifetime tracking.\n\n    Bug: b/510363993, b/510363837\n    Change-Id: I17a3e58885d055de6dc4ba6fc1917f6cdab36a13\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493560\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48283}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/modules/video_coding/packet_buffer.cc", "third_party/libwebrtc/modules/video_coding/packet_buffer.h", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0060.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h"], "git_node": "85c6aaaa3d267057969f37b8e551ecc3538db3ae", "git_parents": ["5db77b6b1e720d9dfc74ced9a4a6ff9f413b2ad7"], "node": "e3b5a6b6713566324f506e85b170aa63e3bf315e", "parents": ["5506c9f4abad525a653f1b6b0f25737024c4009b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 52f57b3f15\n\nUpstream commit: https://webrtc.googlesource.com/src/+/52f57b3f15b89228b6965fdaf83fd10b057a579a\n    In NetEq, simplify DspHelper::PeakDetection and fix single-peak OOB read\n\n    PeakDetection was a single deeply-nested loop that was hard to follow and hid an out-of-bounds read: in single-peak mode data_length is incremented, so the data_length - 2 branch dereferenced data[peak + 1] one element past the real buffer.\n\n    Extract the per-peak sub-sample refinement into a file-local RefinePeak helper and drive it from a single loop parameterized by search_length and edge_index. The single-peak right neighbour is now an explicit 0 instead of an out-of-bounds read; the multi-peak path is unchanged.\n\n    Bug: webrtc:535475623\n    Change-Id: Iebed2750df7a97715fc99b3a6fee90d0ea513922\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/489560\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48284}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/audio_coding/neteq/dsp_helper.cc", "third_party/libwebrtc/modules/audio_coding/neteq/dsp_helper.h"], "git_node": "86dd4310ece6d85ef33767b826d404649735de17", "git_parents": ["85c6aaaa3d267057969f37b8e551ecc3538db3ae"], "node": "e6405a4b298683877984b77384ddf4f2ffee3c7e", "parents": ["e3b5a6b6713566324f506e85b170aa63e3bf315e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from f1165ea6e4\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f1165ea6e42dfdea6d181a84de81f6901bf8430c\n    In RTCPReceiver store single vector of received timber notifications\n\n    Only notifications where sender_ssrc() == remote_ssrc_ are used.\n    Discard other tmmbn items when they are received rather when they are\n    retrieved to save storage.\n\n    Bug: b/510362788\n    Change-Id: Ice3b11182d02a918b146a3c194f7aa8974ca0926\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/492861\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48285}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver.h", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0066.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch"], "git_node": "b5c497881fb691d697fdddcb0f97cde7ef25542e", "git_parents": ["86dd4310ece6d85ef33767b826d404649735de17"], "node": "2224c5e423bc07c7f6fcb114c6e049901d883b27", "parents": ["e6405a4b298683877984b77384ddf4f2ffee3c7e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from ce3d64be6a\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ce3d64be6a0d8f13453b6ecf177634e495e1b7b9\n    call: Pass AudioReceiveStreamInterface::Config by value\n\n    Changes AudioReceiveStreamInterface::Config to be passed by value\n    instead of const reference in Call::CreateAudioReceiveStream and\n    AudioReceiveStreamImpl constructors.\n\n    Bug: none\n    Change-Id: Ib64acc7ce5721ae3f144a036c12189d595c18d76\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493400\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48286}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/audio_receive_stream.cc", "third_party/libwebrtc/audio/audio_receive_stream.h", "third_party/libwebrtc/audio/audio_receive_stream_unittest.cc", "third_party/libwebrtc/call/audio_receive_stream.cc", "third_party/libwebrtc/call/audio_receive_stream.h", "third_party/libwebrtc/call/call.cc", "third_party/libwebrtc/call/call.h", "third_party/libwebrtc/call/call_perf_tests.cc", "third_party/libwebrtc/call/call_unittest.cc", "third_party/libwebrtc/media/engine/fake_webrtc_call.cc", "third_party/libwebrtc/media/engine/fake_webrtc_call.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0039.patch", "third_party/libwebrtc/moz-patch-stack/s0109.patch", "third_party/libwebrtc/moz-patch-stack/s0115.patch", "third_party/libwebrtc/moz-patch-stack/s0134.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/test/call_test.cc", "third_party/libwebrtc/test/scenario/audio_stream.cc"], "git_node": "a2741ae9c431e31dd7a6c2a3b67dd2cb8008ba5d", "git_parents": ["b5c497881fb691d697fdddcb0f97cde7ef25542e"], "node": "83cf566f9141b991bd7bf2306fe633e1478d486c", "parents": ["2224c5e423bc07c7f6fcb114c6e049901d883b27"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - (fix-ce3d64be6a) support AudioReceiveStreamInterface::Config.Copy()\n\nMirrors VideoReceiveStreamInterface::Config.Copy().\n", "files": ["third_party/libwebrtc/call/audio_receive_stream.cc", "third_party/libwebrtc/call/audio_receive_stream.h"], "git_node": "c671d12909148a3675800b57a2bf7f2d0b51885e", "git_parents": ["a2741ae9c431e31dd7a6c2a3b67dd2cb8008ba5d"], "node": "d333e2345db88075ea618503f6ebe573c6ed247e", "parents": ["83cf566f9141b991bd7bf2306fe633e1478d486c"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 (MOZ) - use AudioReceiveStreamInterface::Config.Copy() since we reuse our config\n", "files": ["dom/media/webrtc/libwebrtcglue/AudioConduit.cpp", "media/webrtc/signaling/gtest/MockCall.h"], "git_node": "2a42c06fd9c9293e0eceadd0f64268009d082426", "git_parents": ["c671d12909148a3675800b57a2bf7f2d0b51885e"], "node": "12546689b85976a24e584d80b7ccb20d5f6010e3", "parents": ["d333e2345db88075ea618503f6ebe573c6ed247e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - updated libwebrtc patch stack\n", "files": ["third_party/libwebrtc/moz-patch-stack/s0146.patch"], "git_node": "d40225f04adedb91384b25e66e112c4cb2bd6a8c", "git_parents": ["2a42c06fd9c9293e0eceadd0f64268009d082426"], "node": "aab6100435d6267ac845ffab0657d1a1b20be0e9", "parents": ["12546689b85976a24e584d80b7ccb20d5f6010e3"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 93173ec4f5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/93173ec4f5fdf71a9249e56e87707ccae750ad52\n    Restrict rtc_event_log.proto to offline tools + add documentation\n\n    1. Remove the legacy rtc_event_log_proto dependency from the production\n       libwebrtc static library GN target in root BUILD.gn.\n    2. Restrict proto_library(\"rtc_event_log_proto\") visibility in logging/BUILD.gn\n       exclusively to offline parsers, neteq tools, and test suites to prevent\n       accidental linking into production runtimes.\n    3. Add a deprecation banner and usage instruction to rtc_event_log.proto,\n       update doc comments in rtc_event_log.h, and add a dedicated section in\n       logging/g3doc/rtc_event_log.md guiding humans and AI agents on format rules.\n\n    CONV=ac69de71-4eeb-4b00-b142-f66d9edf397b\n\n    Bug: webrtc:144833892\n    Change-Id: I91f19d1f9664ecf17e38e0fa44a46b854361d6bd\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493540\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48287}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/rtc_event_log/rtc_event_log.h", "third_party/libwebrtc/logging/BUILD.gn", "third_party/libwebrtc/logging/g3doc/rtc_event_log.md", "third_party/libwebrtc/logging/rtc_event_log/rtc_event_log.proto", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0045.patch", "third_party/libwebrtc/moz-patch-stack/s0055.patch", "third_party/libwebrtc/moz-patch-stack/s0082.patch", "third_party/libwebrtc/moz-patch-stack/s0086.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0098.patch", "third_party/libwebrtc/moz-patch-stack/s0100.patch"], "git_node": "5b11b5bd6aeab42860541e1377f4ff958abcce71", "git_parents": ["d40225f04adedb91384b25e66e112c4cb2bd6a8c"], "node": "fc1c1417e44e69391f8d33d22e905c12d4ad14d2", "parents": ["aab6100435d6267ac845ffab0657d1a1b20be0e9"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from d722f444b7\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d722f444b73d3d7357bf85b678b17c7f64eeb5ba\n    Delete unused MediaSessionDescriptionFactory construction parameters\n\n    `media_engine` and `rtx_enabled` were already ignored.\n\n    Bug: webrtc:42225769\n    Change-Id: I8e88d8728243273d25846420c3354404b4874971\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493740\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48288}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/media_session.cc", "third_party/libwebrtc/pc/media_session.h", "third_party/libwebrtc/pc/media_session_unittest.cc", "third_party/libwebrtc/pc/webrtc_session_description_factory.cc", "third_party/libwebrtc/pc/webrtc_session_description_factory.h"], "git_node": "96656354dfa28effac7fdbdf3575f964e18af04e", "git_parents": ["5b11b5bd6aeab42860541e1377f4ff958abcce71"], "node": "85535406ae86ec7bd17b40035f55752eb395dfeb", "parents": ["fc1c1417e44e69391f8d33d22e905c12d4ad14d2"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from c2f67e5685\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c2f67e56855947b031c7c78929664203aa0843a5\n    In RTCPReceiver treat all FIRs as received from the same sender\n\n    Keep single entry for the latest requests when checking for duplicates.\n    This relax duplicate check a bit in favor of smaller state.\n\n    Use single timer for the latest key frame request, in particular reuse\n    the same timer when key frame is requested due to received PLI, thus\n    time throttling of key frame requests become tighter.\n\n    Bug: b/510362788\n    Change-Id: Icacfc1937ca48edec57280ffc789035f47227e69\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/492860\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48289}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver.h", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0066.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch"], "git_node": "0526fab9d15d13772c24f968a0424ade02f37ea4", "git_parents": ["96656354dfa28effac7fdbdf3575f964e18af04e"], "node": "9123899912d165888b00e6e432bd0dbb699e6007", "parents": ["85535406ae86ec7bd17b40035f55752eb395dfeb"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 35cec84caa\n\nUpstream commit: https://webrtc.googlesource.com/src/+/35cec84caaa75750c77e009fa4166e97b3dc81e1\n    Avoid accidental copies in lambda captures\n\n    When variables are captured by value or via move init-capture in\n    non-mutable lambdas, they are const within the lambda body. Consequently,\n    calling std::move on these captured members casts them to const rvalue\n    references, which silently invokes copy constructors instead of move\n    constructors.\n\n    This change adds mutable qualifiers and explicit std::move calls where\n    applicable, ensuring zero-cost move semantics.\n\n    Bug: webrtc:374845009\n    Change-Id: I640c055a65c5f016bf4032d2e6fb02998370ef23\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493700\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48290}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0068.patch", "third_party/libwebrtc/moz-patch-stack/s0102.patch", "third_party/libwebrtc/moz-patch-stack/s0131.patch", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/rtc_base/async_dns_resolver.cc", "third_party/libwebrtc/video/frame_cadence_adapter.cc", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_stream_encoder.cc"], "git_node": "227010e72b5e6eab822e722c73d1db9ceb7b5703", "git_parents": ["0526fab9d15d13772c24f968a0424ade02f37ea4"], "node": "7e29aac2b893e4b3a8fc2402bc55a635eb9ccdc9", "parents": ["9123899912d165888b00e6e432bd0dbb699e6007"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from fd3145f900\n\nUpstream commit: https://webrtc.googlesource.com/src/+/fd3145f9004c06745633d06d267b8887badff0e2\n    Pass VideoReceiveStreamInterface::Config by value\n\n    Changes VideoReceiveStreamInterface::Config to be passed by value\n    instead of const reference.\n\n    Passing by value was already being done in most cases so this change is\n    more about aligning the video and audio structs in terms of enforcing\n    move semantics. Two test frameworks are updated to use `std::move` in\n    this CL rather than creating copies.\n\n    Bug: none\n    Change-Id: Icb94a04c928b23136f1695c74038767ea6112197\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493420\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48291}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/video_receive_stream.cc", "third_party/libwebrtc/call/video_receive_stream.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0036.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/test/call_test.cc", "third_party/libwebrtc/video/video_quality_test.cc", "third_party/libwebrtc/video/video_receive_stream2_unittest.cc"], "git_node": "5516f6d84fa33c7f8a9fef5fa324dbc82b30ac3f", "git_parents": ["227010e72b5e6eab822e722c73d1db9ceb7b5703"], "node": "071784b6b91f7ccd9a4a8ce38301ffba37d3f6ac", "parents": ["7e29aac2b893e4b3a8fc2402bc55a635eb9ccdc9"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 96be92d05c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/96be92d05c8cb7f03c9d37f878410773673b3699\n    Update WebRTC code version (2026-08-05T04:06:16).\n\n    Bug: None\n    Change-Id: I44e805272823505199162248a5035027c3f87517\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493860\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48292}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "4538ba78a214c027d3bd61befdf636306c8fcae0", "git_parents": ["5516f6d84fa33c7f8a9fef5fa324dbc82b30ac3f"], "node": "21dbd6a40405230da2594297df4bac716f16cd8b", "parents": ["071784b6b91f7ccd9a4a8ce38301ffba37d3f6ac"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from e009e710a2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e009e710a242cb2036d93cc651fb56ce79f961f7\n    Remove departed committers (Xooglers) from OWNERS files\n\n    Remove denicija@webrtc.org, ivoc@webrtc.org, and minyue@webrtc.org from OWNERS files.\n\n    Bug: webrtc:483056241\n    Change-Id: Ibe375e45011a83e6f3bfb59707753aa0c192b82e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493880\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48293}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/neteq/OWNERS", "third_party/libwebrtc/common_audio/OWNERS", "third_party/libwebrtc/modules/audio_coding/OWNERS", "third_party/libwebrtc/sdk/objc/OWNERS"], "git_node": "0dcd7bafd51ab51f020a54113e625091d48d6f77", "git_parents": ["4538ba78a214c027d3bd61befdf636306c8fcae0"], "node": "d8cfb2f2a6656eeb7e1588b0e5de11010d00ddf9", "parents": ["21dbd6a40405230da2594297df4bac716f16cd8b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 29e38f3354\n\nUpstream commit: https://webrtc.googlesource.com/src/+/29e38f3354123ffaf8d6ea40c23482c0a41c776d\n    In RtcpReceiver limit number of stored timber requests\n\n    Bug: b/510362788\n    Change-Id: I8bd2a1555701c0b44c5ffb7cc7208400df76df95\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493820\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48294}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_receiver.h", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0066.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch"], "git_node": "3620b1dc31ca50ba1975d4577b04b6c39ce0df0c", "git_parents": ["0dcd7bafd51ab51f020a54113e625091d48d6f77"], "node": "f7f32013b7f5729731215e63c58379b701f44bc4", "parents": ["d8cfb2f2a6656eeb7e1588b0e5de11010d00ddf9"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 4678c8de76\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4678c8de766e779a678a9565f3885e115baf90a3\n    Fix out-of-bounds index check in SimulcastEncoderAdapter::Encode\n\n    When frame_types-\u003esize() == stream_idx, checking frame_types-\u003esize() \u003e= stream_idx causes an out-of-bounds read on (*frame_types)[stream_idx].\n    This changes the bounds check to frame_types-\u003esize() \u003e stream_idx so that shorter frame_types vectors do not cause out-of-bounds indexing.\n\n    Bug: b/527798266, webrtc:527515375\n    Change-Id: I41b971636c565bdb89bbdf7a616a3fe3de69df03\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493900\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48295}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/engine/simulcast_encoder_adapter.cc", "third_party/libwebrtc/media/engine/simulcast_encoder_adapter_unittest.cc"], "git_node": "7a564a4ebec169376d6e325d70fdf8fc19e546ae", "git_parents": ["3620b1dc31ca50ba1975d4577b04b6c39ce0df0c"], "node": "0774d3f5bc6b2e3d72660a9b6fa296bdaa1a2751", "parents": ["f7f32013b7f5729731215e63c58379b701f44bc4"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from e3ba770392\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e3ba7703926e4134a201b811159c365438957c17\n    Increase frame history size in VP9 references fuzzer\n\n    The previous history size of 32 is likely too small to track long-term\n    reference frames (such as the initial keyframe). This causes the\n    circular buffer to overwrite old frames that the encoder may still\n    reference, leading to an RTC_CHECK failure.\n\n    This CL speculatively increases the history size to 256 in an attempt to\n    prevent the fuzzer from crashing on valid long-term dependencies.\n\n    Fixed: chromium:538422136\n    Change-Id: I964ebaf78bad94176b1ff0068168219c3adf6da8\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494080\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Johannes Kron \u003ckron@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48296}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/test/fuzzers/vp9_encoder_references_fuzzer.cc"], "git_node": "7747e51763c5f6aeeac67bb1d8ec3c77b70fcc3e", "git_parents": ["7a564a4ebec169376d6e325d70fdf8fc19e546ae"], "node": "48d2ceb923c49fccd49849a22b7eef11e638d209", "parents": ["0774d3f5bc6b2e3d72660a9b6fa296bdaa1a2751"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 14bccf4cce\n\nUpstream commit: https://webrtc.googlesource.com/src/+/14bccf4cce5ae4d2193b5af14288c7e4e73c2b22\n    Remove WebRTC-AddPacingToCongestionWindowPushback field trial\n\n    This trial was introduced to include the pacing buffer size in the congestion window pushback. The codebase now assumes this behavior as default, so the field trial is no longer needed.\n\n    Also, add back unittests that were removed from the build in https://webrtc-review.git.corp.google.com/c/src/+/490780/13/modules/congestion_controller/BUILD.gn\n\n    Bug: webrtc:42221607\n    Change-Id: Ie04944122b595946ca5fbd33bf89f7fc8fa83082\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/458042\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48297}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/modules/congestion_controller/BUILD.gn", "third_party/libwebrtc/modules/congestion_controller/goog_cc/congestion_window_pushback_controller.cc", "third_party/libwebrtc/modules/congestion_controller/goog_cc/congestion_window_pushback_controller.h", "third_party/libwebrtc/modules/congestion_controller/goog_cc/goog_cc_network_control_unittest.cc"], "git_node": "cea74439fb9311e8f1a2b133033ddf7d8bdf88e5", "git_parents": ["7747e51763c5f6aeeac67bb1d8ec3c77b70fcc3e"], "node": "93fb1459e7210b12a764dc01b554c6496b05f653", "parents": ["48d2ceb923c49fccd49849a22b7eef11e638d209"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 437408bd42\n\nUpstream commit: https://webrtc.googlesource.com/src/+/437408bd428c915b11f44df4f35cf1834acd61c9\n    Use default strides in allocated buffer in h264 encoder wrapper\n\n    The explicit values were incorrect: u/v strides were half-width rounded\n    down, but it has to be rounded up: for odd resolutions there are supposed to be extra u/v samples for last odd pixels.\n\n    Bug: chromium:542449805\n    Change-Id: I06f85d4cba737f69699f056057ebf039094bbffe\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493940\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Auto-Submit: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48298}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/codecs/h264/h264_encoder_impl.cc"], "git_node": "56c2d3d4933fd11029537768683a9f104e5b4673", "git_parents": ["cea74439fb9311e8f1a2b133033ddf7d8bdf88e5"], "node": "702182653c5adcb50329deb3ec04794abf633489", "parents": ["93fb1459e7210b12a764dc01b554c6496b05f653"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 16e0e50463\n\nUpstream commit: https://webrtc.googlesource.com/src/+/16e0e504635ca5c38df1d1d53e0b1c624abae932\n    Update WebRTC code version (2026-08-06T04:05:02).\n\n    Bug: None\n    Change-Id: Ibad12bae8788282cad00488be11205ad8d98b671\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494180\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48299}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "659ca37a6c49fc0dda076cdfebafa518dfd8e807", "git_parents": ["56c2d3d4933fd11029537768683a9f104e5b4673"], "node": "788719cf8e709be532aba76de937c2bbdb3d9b26", "parents": ["702182653c5adcb50329deb3ec04794abf633489"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 424a6bd0b7\n\nUpstream commit: https://webrtc.googlesource.com/src/+/424a6bd0b7f93659204ecccff1d61d63c25937e2\n    Move oversized payload size check earlier in rtp packetizer\n\n    To protect more code from unrealistic video frames\n\n    Bug: chromium:502783118\n    Change-Id: I19cbbf84237e93346e515eb3670d561e1bdcefa9\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494100\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48300}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/BUILD.gn", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0121.patch"], "git_node": "aadca99f014de358518559bb396f310802c78cc5", "git_parents": ["659ca37a6c49fc0dda076cdfebafa518dfd8e807"], "node": "1d5058c3c6c18dc16eb06a00f435c54b4005c42f", "parents": ["788719cf8e709be532aba76de937c2bbdb3d9b26"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 4ee314fac0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4ee314fac0a3925e54c4dd3cf5bfc5dcd1c4a7b1\n    Delete deprecated functions taking int instead of RtpHeaderExtensionId\n\n    Bug: webrtc:514817938\n    Change-Id: I341fbe85844b4ca4247a06dafd9d36e18ab927c2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494120\n    Commit-Queue: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48301}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/include/rtp_header_extension_map.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_rtcp_interface.h", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0080.patch"], "git_node": "a1ec32cc71d8ca9ade9b694a942fc22d0de36997", "git_parents": ["aadca99f014de358518559bb396f310802c78cc5"], "node": "0e6cc42500c9ca81a1a996326f4271c859d21d25", "parents": ["1d5058c3c6c18dc16eb06a00f435c54b4005c42f"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 421df7faa5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/421df7faa585b9aff2b37a77a6d19f2693aa0689\n    Fix sync group configuration in CreateAudioReceiveStream\n\n    Use the sync_group() getter after std::move()-ing the `config` struct.\n\n    This is a recent regression from:\n    https://webrtc.googlesource.com/src/+/ce3d64be6a0d8f13453b6ecf177634e495e1b7b9\n\n    Also remove packet_sequence_checker_ from AudioReceiveStreamImpl and use\n    worker_thread_checker_ instead, allowing safe use of the sync_group()\n    getter from Call. Using the worker thread checker is clearer in the code\n    and the `packet_sequence_checker_` isn't useful at this point (artefact\n    of refactoring that was ongoing a few years ago).\n\n    Fixed: webrtc:542883661\n    Change-Id: I9ef7a3da88ff7698872affc180a5b9bb5db812aa\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494200\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48302}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/audio_receive_stream.cc", "third_party/libwebrtc/audio/audio_receive_stream.h", "third_party/libwebrtc/call/call.cc", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0039.patch", "third_party/libwebrtc/moz-patch-stack/s0115.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch"], "git_node": "88d1275dc8ac1a58014436d514d987e030382658", "git_parents": ["a1ec32cc71d8ca9ade9b694a942fc22d0de36997"], "node": "a46c915924d863aa30e166344490696bc3d5ba49", "parents": ["0e6cc42500c9ca81a1a996326f4271c859d21d25"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from fdf722e69d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/fdf722e69dbf97fb50a3b65fee42cbe6a88c0c6f\n    Fix style in SDP munging test\n\n    Replaces Not(IsNull()) with the NotNull() matcher and spells out\n    std::unique_ptr\u003cPeerConnectionWrapper\u003e instead of auto for the\n    CreatePeerConnection() results.\n\n    Split from\n      https://webrtc-review.googlesource.com/c/src/+/493800\n\n    Bug: None\n    Change-Id: Ic9ee40049ede9ab8fcb8f97143abb74b85698842\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494000\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48303}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/pc/sdp_munging_detector_unittest.cc"], "git_node": "3e22f0f26d5350dc35ca6ebef050efaff45d3201", "git_parents": ["88d1275dc8ac1a58014436d514d987e030382658"], "node": "814ec475c0ccef78be340efd1ba5d3e07de8b30f", "parents": ["a46c915924d863aa30e166344490696bc3d5ba49"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from edeb3387d3\n\nUpstream commit: https://webrtc.googlesource.com/src/+/edeb3387d37500f5d0cec0990ec5aca66bdc3fcf\n    Delete stats for number of ipv4 and ipv6 networks as unused\n\n    Chromium histogram this was collected for is deleted.\n\n    Bug: chromium:354713635\n    Change-Id: Ia1d29a9529e4089f3aee007d2f88437f1b37e30c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494140\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48304}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/rtc_base/network.cc", "third_party/libwebrtc/rtc_base/network.h", "third_party/libwebrtc/rtc_base/network_unittest.cc"], "git_node": "912c963d7ad838c07fec36738cd52d331651b4a9", "git_parents": ["3e22f0f26d5350dc35ca6ebef050efaff45d3201"], "node": "8ea1e559ca2b1fda71fa8cabd9f478e802966c2b", "parents": ["814ec475c0ccef78be340efd1ba5d3e07de8b30f"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 006c8acd7b\n\nUpstream commit: https://webrtc.googlesource.com/src/+/006c8acd7b2a83fcc5ce1ceab383fbe7ca67cdbc\n    Add CreateOutgoingVideoFrame.\n\n    A new API for creating EncodedVideoFrames that are not linked to any\n    particular sender.\n\n    Bug: chromium:524901718\n    Change-Id: Iaaf73c3dfaddafc326f19d29a8881ea162f5410f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/488340\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Leonardo Evi \u003cevil@chromium.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48305}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/BUILD.gn", "third_party/libwebrtc/api/frame_transformer_factory.cc", "third_party/libwebrtc/api/frame_transformer_factory.h", "third_party/libwebrtc/api/test/frame_transformer_factory_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_frame_transformer_delegate.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_frame_transformer_delegate.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video_frame_transformer_delegate_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0071.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch"], "git_node": "15303cb407929751eb78f094d09f03498f6ccfb7", "git_parents": ["912c963d7ad838c07fec36738cd52d331651b4a9"], "node": "add72415af03993f67a7e4eba5d243763b0c99cb", "parents": ["8ea1e559ca2b1fda71fa8cabd9f478e802966c2b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 9d33c204bd\n\nUpstream commit: https://webrtc.googlesource.com/src/+/9d33c204bdea09554469199f8e865563bf0dc175\n    Add hbos@webrtc.org to api/OWNERS.\n\n    Bug: webrtc:483056241\n    Change-Id: I00f81e364efc2885e99b82407e84a73ae45c7195\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494021\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48306}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/OWNERS"], "git_node": "6a0866bea7893556c5957bedc4eb4ea8d69a99d7", "git_parents": ["15303cb407929751eb78f094d09f03498f6ccfb7"], "node": "660b89a3340e373e3952209c84324fb6dd381195", "parents": ["add72415af03993f67a7e4eba5d243763b0c99cb"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 36338af30e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/36338af30ec0b69a823b537ce5c7ae6c0b709948\n    Support single-stream/SVC per-SSRC keyframe requests in VideoStreamEncoder\n\n    When WebRTC-Video-PerSsrcKeyframes is enabled, EncoderRtcpFeedback calls\n    SendKeyFrame with a layers vector sized to config_.rtp.ssrcs.size(). In\n    single-stream or SVC configurations, codec.numberOfSimulcastStreams is\n    1, so next_frame_types_.size() is 1, which caused\n    RTC_DCHECK_EQ(layers.size(), next_frame_types_.size()) to crash. This\n    removes the assertion and ensures any requested keyframe across RTP\n    layers triggers a keyframe on the single encoded stream when\n    next_frame_types_.size() == 1.\n\n    Bug: b/527798266, webrtc:527515375\n    Change-Id: I8970a563c4f12f85cdc55650a626faba1c4fb4ae\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493920\n    Commit-Queue: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48307}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0068.patch", "third_party/libwebrtc/moz-patch-stack/s0102.patch", "third_party/libwebrtc/moz-patch-stack/s0131.patch", "third_party/libwebrtc/video/video_stream_encoder.cc", "third_party/libwebrtc/video/video_stream_encoder_unittest.cc"], "git_node": "f93a9c27d6d9cbc3ed405812285210a5380ce7da", "git_parents": ["6a0866bea7893556c5957bedc4eb4ea8d69a99d7"], "node": "a51a93d98aa93d993bc36df21620654845eb1381", "parents": ["660b89a3340e373e3952209c84324fb6dd381195"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 5116470e21\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5116470e21ca6665830e9d6f717d15459bebba93\n    Add sprang@webrtc.org to modules/video_capture/OWNERS.\n\n    Bug: webrtc:483056241\n    Change-Id: I4dd177ac7d6ba4729e0564972d65483b87feb5d5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494060\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48308}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_capture/OWNERS"], "git_node": "66180b5e328b2c04c4733a0e07751826e10a7621", "git_parents": ["f93a9c27d6d9cbc3ed405812285210a5380ce7da"], "node": "fd66b2d87d26df1ee8bee9f190ae486c81f85277", "parents": ["a51a93d98aa93d993bc36df21620654845eb1381"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from c0f1eee28d\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c0f1eee28d50b4dc24a00f13b2a61bbaa178bb13\n    Remove packet_sequence_checker_ from VideoReceiveStream2\n\n    packet_sequence_checker_ was a relic of a refactoring to move packet\n    handling to the network thread that hasn't seen much activity for some\n    time, so the duplicate check isn't helpful at this point.\n\n    This CL removes packet_sequence_checker_ and replaces the sequence\n    checks and annotations in VideoReceiveStream2 with\n    worker_sequence_checker_.\n\n    Bug: webrtc:42233985, webrtc:42222117\n    Change-Id: I332433e0945cdda01adf330db58fdd04faaa043f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494560\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48309}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h"], "git_node": "86ddb91b883b56213d30213470c38fc85771479f", "git_parents": ["66180b5e328b2c04c4733a0e07751826e10a7621"], "node": "3e6cc8a403ed9c0cad6dc410e9340970e1d8672b", "parents": ["fd66b2d87d26df1ee8bee9f190ae486c81f85277"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 0fe5563f15\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0fe5563f15a46a1ad432ab119c66f40da248fdd3\n    Cap RtpVideoStreamReceiver2 history maps to prevent memory leaks\n\n    RtpVideoStreamReceiver2 maintains metadata maps\n    (last_seq_num_for_pic_id_ and last_timestamp_for_pic_id_) for frames to\n    support NACK clearing and reference finder cleanup. Under normal\n    conditions, these maps are pruned when FrameDecoded() is invoked.\n\n    However, if an external peer injects undecodable frames (e.g., delta\n    frames with unresolvable dependency chains), FrameDecoded() is never\n    called, causing these maps to grow indefinitely without bound.\n\n    This change introduces a capacity limit (kMaxFrameHistorySize = 2048) on\n    last_seq_num_for_pic_id_ and last_timestamp_for_pic_id_. When the maps\n    exceed this capacity, the oldest entries are pruned automatically.\n\n    Bug: b/510363226\n    Change-Id: I598da63fcd4f8c8fc7777b32323a3d91f529a0df\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493980\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48310}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0060.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h", "third_party/libwebrtc/video/rtp_video_stream_receiver2_unittest.cc"], "git_node": "a05f0cda6c90a10d5f49fdcaacd6386873898566", "git_parents": ["86ddb91b883b56213d30213470c38fc85771479f"], "node": "48da23825ab37b3ae40cd6ad804085ac53c2435a", "parents": ["3e6cc8a403ed9c0cad6dc410e9340970e1d8672b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 4fd2711b90\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4fd2711b90905c086f380e74e4c419990f995623\n    Update WebRTC code version (2026-08-07T04:07:52).\n\n    Bug: None\n    Change-Id: Ib6d09f78eca66269c91caea0273b640f1eba533a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494640\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48311}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "c3d83ea422b4aeeb5b91ede9eb67b1432bfeb3d7", "git_parents": ["a05f0cda6c90a10d5f49fdcaacd6386873898566"], "node": "6e0c99af299cd36fb9a82f774b360e9231a5888a", "parents": ["48da23825ab37b3ae40cd6ad804085ac53c2435a"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from a7400dd128\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a7400dd128233eeae05f217883c7dc640114a5b6\n    Remove packet_sequence_checker_ from RtpVideoStreamReceiver2\n\n    packet_sequence_checker_ was an old sequence checker from an abandoned\n    refactoring. This change removes packet_sequence_checker_ from\n    RtpVideoStreamReceiver2 and updates annotations and assertions to use\n    worker_queue_ instead.\n\n    Bug: none\n    Change-Id: I8bfd8f8973d3f1c0fb97e315da8a6cb357e65af8\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494442\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48312}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0060.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h"], "git_node": "db0e5370b2ded042e2422fa8016411a0ea396c90", "git_parents": ["c3d83ea422b4aeeb5b91ede9eb67b1432bfeb3d7"], "node": "1ddb8d3bafa7e3acfbbc2ac5d801386c719c1799", "parents": ["6e0c99af299cd36fb9a82f774b360e9231a5888a"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 6417a5fe41\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6417a5fe41686400eed64e15fea1a7d1fb5d785f\n    Improve H26xPacketBuffer management in RtpVideoStreamReceiver2\n\n    Address issues with the lifecycle and configuration of H26xPacketBuffer\n    when codecs are added, updated, or removed mid-stream. Previously, the\n    receiver could leak keyframe settings across codec changes, ignore\n    payload type parameter updates, or allocate unnecessary packet buffers.\n\n    - Reset the keyframe configuration state to false when removing codecs.\n    - Use insert_or_assign to ensure payload type and codec parameter\n      updates apply correctly on re-registration.\n    - Update the H.264 keyframe requirement setting on the existing buffer\n      in-place to avoid recreating it mid-stream and dropping packets.\n    - Only allocate the H26xPacketBuffer if an H26x codec is configured,\n      either on receive startup or when adding a codec while active.\n\n    Bug: webrtc:41480904\n    Change-Id: Ic3d4b54c6f8e6881f38ba37c784f186008355e24\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494740\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48313}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/h26x_packet_buffer.cc", "third_party/libwebrtc/modules/video_coding/h26x_packet_buffer.h", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0060.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2_unittest.cc"], "git_node": "e18ee5ec86b58d9250bc7dea42dc3ed3d4163083", "git_parents": ["db0e5370b2ded042e2422fa8016411a0ea396c90"], "node": "d2f6d8df078a20fb1dd65143599ea55223c4aac7", "parents": ["1ddb8d3bafa7e3acfbbc2ac5d801386c719c1799"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from cd5f3c19d8\n\nUpstream commit: https://webrtc.googlesource.com/src/+/cd5f3c19d89dce8189bde370f2141a76ca7fed80\n    [pipewire] Followups from CL 487880.\n\n    - Use RTC_CHECK when possible.\n    - Check that the global tracking boolean is correct in ctor/dtor.\n    - Explicitly delete move operators.\n\n    Bug: chromium:40236752\n    Change-Id: I4f3fc3a64ae442367a23c0f8312f836864bde3fb\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494800\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Auto-Submit: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48314}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/moz-patch-stack/s0072.patch", "third_party/libwebrtc/moz-patch-stack/s0073.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch"], "git_node": "51b040b255bf189b1bfca98f9e9031a70d524e20", "git_parents": ["e18ee5ec86b58d9250bc7dea42dc3ed3d4163083"], "node": "bccb60d52d6823f5c6075f22f6f3b26debe9090e", "parents": ["d2f6d8df078a20fb1dd65143599ea55223c4aac7"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 956083e9a9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/956083e9a9f487b9c2d0cdb96c64ba23cfc1ac76\n    Update WebRTC code version (2026-08-08T04:06:35).\n\n    Bug: None\n    Change-Id: I312c6844d17b52c70fde0755e501ba561fb84406\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494860\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48315}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "bce3b8373dbba18c1672cb11f9a60a16a43b750a", "git_parents": ["51b040b255bf189b1bfca98f9e9031a70d524e20"], "node": "6f8bb9a82224b6f0dc3f7b94f090a8efcbf5bdab", "parents": ["bccb60d52d6823f5c6075f22f6f3b26debe9090e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 0da6e8b965\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0da6e8b9658834a31ed9f9af399f0b4aeb344adf\n    Update WebRTC code version (2026-08-09T04:05:04).\n\n    Bug: None\n    Change-Id: Id226eabcca0809d6dac824d6903e143833fd09a7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495100\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48316}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "a0a23db01fa34cfdca8aa31c4c189b923857cd39", "git_parents": ["bce3b8373dbba18c1672cb11f9a60a16a43b750a"], "node": "b377151dfab341e990fe8fc86520ca2c9950fd93", "parents": ["6f8bb9a82224b6f0dc3f7b94f090a8efcbf5bdab"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 189741bb87\n\nUpstream commit: https://webrtc.googlesource.com/src/+/189741bb87a2a2284a2292749343eef80940add4\n    Fix race condition in TooManyDataChannelsOpenedBeforeConnecting\n\n    The test checked the caller's data channel states immediately after\n    callee received the data channels. However, the caller's data channel\n    state transitions happen asynchronously on the signaling thread. This CL\n    wraps the state assertions in WaitUntil to allow the caller to process\n    the state updates on slow bots.\n\n    Bug: none\n    Change-Id: Ia4ea97cbf40719fbb543710a53f2bd66eaef8f2f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494960\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48317}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/pc/peer_connection_end_to_end_unittest.cc"], "git_node": "cb84fd78acae7a8112b3c8f488e57733c2c4b6fa", "git_parents": ["a0a23db01fa34cfdca8aa31c4c189b923857cd39"], "node": "aa90db06ab75b13a6d2fc77e5af835da13c49484", "parents": ["b377151dfab341e990fe8fc86520ca2c9950fd93"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from d0e1922275\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d0e19222755e665c3669fcf5b07e9e309d095b9e\n    sdp: keep the legacy rrtr rtcp-fb separate from rtcp-xr:rcvr-rtt\n\n    Generating a=rtcp-fb:\u003cpt\u003e rrtr from receive_non_sender_rtt added around\n    500 bytes to every video m-section. Stop generating it and let the\n    parser keep it as a codec feedback param, which round-trips it as\n    before, so the flag is set only by a=rtcp-xr:rcvr-rtt. Either form\n    enables non-sender RTT from the remote description.\n\n    Munging the new attribute is rejected; the legacy form stays allowed and\n    is measured as kAudioCodecsRtcpFbRrtr again.\n\n    Bug: webrtc:516205747\n    Change-Id: I3ef8ce9fb82a0fade816446c625ebc3f2e35d3aa\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493800\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48318}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/uma_metrics.h", "third_party/libwebrtc/api/webrtc_sdp.cc", "third_party/libwebrtc/api/webrtc_sdp_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/channel.cc", "third_party/libwebrtc/pc/media_session_unittest.cc", "third_party/libwebrtc/pc/sdp_munging_detector.cc", "third_party/libwebrtc/pc/sdp_munging_detector_unittest.cc"], "git_node": "a597207a27331692bf32f54cb5fe21dc6fe31872", "git_parents": ["cb84fd78acae7a8112b3c8f488e57733c2c4b6fa"], "node": "eab09eec90959852105257a0cd2e3e81da85b5ba", "parents": ["aa90db06ab75b13a6d2fc77e5af835da13c49484"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from dcc51b7cb1\n\nUpstream commit: https://webrtc.googlesource.com/src/+/dcc51b7cb1f0352fe30e7acffa79a6f065b69a13\n    Avoid recreating receive stream on raw payload type changes\n\n    Before, updating raw payload types triggered a full tear-down and\n    recreation of the video receive stream.\n\n    This introduces the SetRawPayloadTypes method to the video receive\n    stream interface and RtpVideoStreamReceiver2. That allows the receiver\n    to dynamically update depacketizers for registered payload types in\n    place. When a payload type changes, the receiver swaps between a raw\n    depacketizer and a standard codec depacketizer without needing to\n    recreate the stream.\n\n    Bug: webrtc:510361625, webrtc:42233985, chromium:463591201\n    Change-Id: I8332226fa65ef83866d4b5d6810794f0cb7e3243\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494720\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48319}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/video_receive_stream.h", "third_party/libwebrtc/media/engine/fake_webrtc_call.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0003.patch", "third_party/libwebrtc/moz-patch-stack/s0004.patch", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0036.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0060.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h", "third_party/libwebrtc/video/rtp_video_stream_receiver2_unittest.cc", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h"], "git_node": "e4ae7690b00e48e5fddbbbcb56f6b27e89048d20", "git_parents": ["a597207a27331692bf32f54cb5fe21dc6fe31872"], "node": "1449cb73f64b179aed4ea37b4aea961ae4be0460", "parents": ["eab09eec90959852105257a0cd2e3e81da85b5ba"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 (MOZ) - upstream added a method to VideoReceiveStreamInterface\n", "files": ["media/webrtc/signaling/gtest/MockCall.h"], "git_node": "5e10c8e55afdb00e1561894563156442bed9999a", "git_parents": ["e4ae7690b00e48e5fddbbbcb56f6b27e89048d20"], "node": "e00c1b1bff7c8646621082ebeed579d7ae1c464b", "parents": ["1449cb73f64b179aed4ea37b4aea961ae4be0460"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 0eed0180f3\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0eed0180f3477fc96e21a1fb8ddd2dae0cb23a40\n    Avoid copies when passing heavy objects by value\n\n    - Introduced move constructors to SdpVideoFormat and Codec.\n    - Addressed a few stray places where objects were copied.\n\n    Bug: webrtc:374845009\n    Change-Id: Id8b558e49441f3e537ca385337bf1d0bb045975c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493760\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48320}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/sdp_video_format.cc", "third_party/libwebrtc/api/video_codecs/sdp_video_format.h", "third_party/libwebrtc/call/payload_type_picker.h", "third_party/libwebrtc/media/base/codec.cc", "third_party/libwebrtc/media/base/codec.h", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/egl_dmabuf.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/remote_estimate.cc", "third_party/libwebrtc/moz-patch-stack/s0063.patch", "third_party/libwebrtc/pc/channel.cc", "third_party/libwebrtc/pc/session_description.h", "third_party/libwebrtc/video/corruption_detection/frame_instrumentation_generator_impl.cc", "third_party/libwebrtc/video/frame_dumping_encoder.cc", "third_party/libwebrtc/video/video_send_stream_impl.cc"], "git_node": "cb9c97b869cf8d693e25977e5aa961fc9ad9d76c", "git_parents": ["5e10c8e55afdb00e1561894563156442bed9999a"], "node": "f773f2ca7fc57b6044fd2861efae028ea5e74c34", "parents": ["e00c1b1bff7c8646621082ebeed579d7ae1c464b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 79f84094cb\n\nUpstream commit: https://webrtc.googlesource.com/src/+/79f84094cbe77006c07e2035604f0c60528d7d01\n    Store all frame history in vp9_encoder_references_fuzzer\n\n    Dynamic layer deactivation and reactivation can cause a reactivated\n    spatial layer to reference a buffer from many pictures ago while\n    intervening spatial layers continued encoding. When that occurred, the\n    fixed-size circular buffer evicted the older referenced frame, leading\n    to false-positive dependency check crashes in FrameValidator.\n\n    Replace the circular buffer with std::vector\u003cLayerFrame\u003e. Because\n    LayerFrame is small (32 bytes) and the fuzzer caps actions at 1000,\n    retaining the full frame history uses negligible memory (\u003c130 KB) and\n    prevents eviction.\n\n    Bug: chromium:543493402\n    Change-Id: Id45e7eacd5928e0857fb7c6f0f40ce5ea94c558a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495260\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Johannes Kron \u003ckron@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48321}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/test/fuzzers/vp9_encoder_references_fuzzer.cc"], "git_node": "22ad5cca6d06e3a4f5d0de031041a41c14821ffb", "git_parents": ["cb9c97b869cf8d693e25977e5aa961fc9ad9d76c"], "node": "2a222fc890471f1bccb1a3fb98e76637e3006a56", "parents": ["f773f2ca7fc57b6044fd2861efae028ea5e74c34"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 6847423e34\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6847423e348bca7eb13b1099a7fe97a9cafdbd71\n    Spanify RtpVideoStreamReceiver2Test\n\n    Change AppendExpectedBitstream to take span instead pointer + size.\n    Use RtpPacket::SetPayload to hide memcpy\n\n    Bug: webrtc:42225170\n    Change-Id: If0823e43187f879c2025db97d87475decebf5ae6\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494780\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48322}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/video/BUILD.gn", "third_party/libwebrtc/video/rtp_video_stream_receiver2_unittest.cc"], "git_node": "c5c524709e559436e3c2ee05f350524a1479fa96", "git_parents": ["22ad5cca6d06e3a4f5d0de031041a41c14821ffb"], "node": "c274b0bfae75e0185b525b3b3094b4f5fe0caf10", "parents": ["2a222fc890471f1bccb1a3fb98e76637e3006a56"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from c37685b6db\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c37685b6db9fefb4f71f84e66e259f3e817f57d0\n    Revert \"Remove WebRTC-AddPacingToCongestionWindowPushback field trial\"\n\n    This reverts commit e03785e6c3b76a7c1a1874d4647b034a59419134.\n\n    Reason for revert: Causes regression\n\n    Failure Link: webrtc:543314348\n\n    Original change's description:\n    \u003e Remove WebRTC-AddPacingToCongestionWindowPushback field trial\n    \u003e\n    \u003e This trial was introduced to include the pacing buffer size in the congestion window pushback. The codebase now assumes this behavior as default, so the field trial is no longer needed.\n    \u003e\n    \u003e Also, add back unittests that were removed from the build in https://webrtc-review.git.corp.google.com/c/src/+/490780/13/modules/congestion_controller/BUILD.gn\n    \u003e\n    \u003e Bug: webrtc:42221607\n    \u003e Change-Id: Ie04944122b595946ca5fbd33bf89f7fc8fa83082\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/458042\n    \u003e Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    \u003e Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48297}\n\n    Bug: webrtc:42221607\n    Change-Id: Id01a8abdcfc9d2b0f7bcb61b92eb6f9664d7c260\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495320\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48323}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/modules/congestion_controller/BUILD.gn", "third_party/libwebrtc/modules/congestion_controller/goog_cc/congestion_window_pushback_controller.cc", "third_party/libwebrtc/modules/congestion_controller/goog_cc/congestion_window_pushback_controller.h", "third_party/libwebrtc/modules/congestion_controller/goog_cc/goog_cc_network_control_unittest.cc"], "git_node": "3261d7b8a6bd897100f94c5445715246f416c529", "git_parents": ["c5c524709e559436e3c2ee05f350524a1479fa96"], "node": "6c6e510277674f9c349e61023d9c87a81e2c9824", "parents": ["c274b0bfae75e0185b525b3b3094b4f5fe0caf10"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from e07e285f05\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e07e285f053d53cc775b5894b0314378579e490a\n    Remove deprecated implicit conversions RtpHeaderExtensionId\u003c-\u003eint\n\n    Bug: webrtc:514817938\n    Change-Id: I3d38f6170323a201c417d578c9e6f79992598772\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/493520\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48324}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/rtp_header_extension_id.h", "third_party/libwebrtc/api/rtp_header_extension_id_unittest.cc", "third_party/libwebrtc/api/rtp_parameters.h", "third_party/libwebrtc/moz-patch-stack/s0122.patch"], "git_node": "22a12954a16aad705517ce1ba8071fc31f3016e4", "git_parents": ["3261d7b8a6bd897100f94c5445715246f416c529"], "node": "bc2344c921d6882e9303db850c01499364a5e6b7", "parents": ["6c6e510277674f9c349e61023d9c87a81e2c9824"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 (MOZ) - upstream removed implicit conversion for RtpHeaderExtensionId\u003c-\u003eint\n", "files": ["dom/media/webrtc/jsapi/RTCRtpReceiver.cpp", "dom/media/webrtc/jsapi/RTCRtpSender.cpp"], "git_node": "ee4d092aee326b1b6de00d99d12ecaa44176d5b3", "git_parents": ["22a12954a16aad705517ce1ba8071fc31f3016e4"], "node": "88a4101bc276f8f8a47acca5ea49d27e66b7add2", "parents": ["bc2344c921d6882e9303db850c01499364a5e6b7"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 2be9a9e936\n\nUpstream commit: https://webrtc.googlesource.com/src/+/2be9a9e9367bf9ff70652dcf92956de23d0de6ce\n    Add back unittests that were removed from the build in https://webrtc-review.googlesource.com/c/src/+/490780/13/modules/congestion_controller/BUILD.gn\n\n    Bug: webrtc:498394143\n    Change-Id: Ie1bb2c5a17f69c29b1157d03330c46c5b28db2a1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495380\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48325}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/BUILD.gn"], "git_node": "cc69113953416bb609e8f5323459b7af8fdd0e1c", "git_parents": ["ee4d092aee326b1b6de00d99d12ecaa44176d5b3"], "node": "fbeb24f2210d29a5c8a5d01ce25b5167857e35c1", "parents": ["88a4101bc276f8f8a47acca5ea49d27e66b7add2"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from b3438d77de\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b3438d77de949e4c5719753a921aed5096c66906\n    Fix race condition in RtpStreamReceiverController teardown\n\n    A race condition exists during the teardown of RTP receive streams that\n    could leave a stale pointer in the RtpDemuxer. While ReceiveSinkRegistry\n    attempts to validate sink pointers before packet delivery, rapid stream\n    teardown and recreation can cause the validation to falsely succeed,\n    leading to packets being delivered to the wrong stream.\n\n    This CL introduces a ProxySink (managed as a std::unique_ptr) owned by\n    the Receiver. Instead of registering the raw sink pointer, the Receiver\n    registers the ProxySink* with both the RtpDemuxer and the\n    ReceiveSinkRegistry. Upon teardown, the ProxySink is moved into the\n    network thread removal task, extending its lifetime through the race\n    window. Because the ProxySink allocation is strictly unique per receiver\n    lifecycle, its pointer address will never match a subsequently created\n    stream, avoiding stale pointer reuse issue.\n\n    Fixed: webrtc:544560845\n    Change-Id: I0c3bd55fc9b2d3d2bd3779b71715ef13095763db\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495280\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48326}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/rtp_stream_receiver_controller.cc", "third_party/libwebrtc/call/rtp_stream_receiver_controller.h", "third_party/libwebrtc/call/rtp_stream_receiver_controller_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch"], "git_node": "5d300bb08e6ca3eb01382e92706caf3504010de5", "git_parents": ["cc69113953416bb609e8f5323459b7af8fdd0e1c"], "node": "68f2f61c0080994caba70eee2809b916c5a97d06", "parents": ["fbeb24f2210d29a5c8a5d01ce25b5167857e35c1"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 69d9758c1b\n\nUpstream commit: https://webrtc.googlesource.com/src/+/69d9758c1b1a70313b48c91afbdab3894222b5ee\n    Implement handover for queued messages in RRSendQueue.\n\n    This adds StreamMessage to the handover state and implements\n    AddHandoverState and RestoreFromState in RRSendQueue.\n\n    Bug: webrtc:477364365\n    Change-Id: I7c87973f4f5c9589fb6cc48fde46077449304d4b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/492360\n    Reviewed-by: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Priya Rajarathinam \u003crajarathinam@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48327}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/net/dcsctp/public/dcsctp_handover_state.h", "third_party/libwebrtc/net/dcsctp/public/dcsctp_options.h", "third_party/libwebrtc/net/dcsctp/socket/dcsctp_socket.cc", "third_party/libwebrtc/net/dcsctp/tx/BUILD.gn", "third_party/libwebrtc/net/dcsctp/tx/mock_send_queue.h", "third_party/libwebrtc/net/dcsctp/tx/rr_send_queue.cc", "third_party/libwebrtc/net/dcsctp/tx/rr_send_queue.h", "third_party/libwebrtc/net/dcsctp/tx/rr_send_queue_test.cc", "third_party/libwebrtc/net/dcsctp/tx/send_queue.h"], "git_node": "f759f0434c06d0b989585e9f0f785f0ac9eda5fb", "git_parents": ["5d300bb08e6ca3eb01382e92706caf3504010de5"], "node": "68a5b9cd6a3af623274f0d88d6ef655ad6be76bd", "parents": ["68f2f61c0080994caba70eee2809b916c5a97d06"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 9ef860c326\n\nUpstream commit: https://webrtc.googlesource.com/src/+/9ef860c326bb57f72f18771a5de6a0f1fb57121a\n    Update WebRTC code version (2026-08-11T04:05:41).\n\n    Bug: None\n    Change-Id: Ic6a57e2b283396ba2ed020c929be93835f6255b1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495460\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48328}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "436ba2b935bc9f09333142d83ce75bf387906670", "git_parents": ["f759f0434c06d0b989585e9f0f785f0ac9eda5fb"], "node": "442cf8a9a744c2299f730363efb2a9342dd083df", "parents": ["68a5b9cd6a3af623274f0d88d6ef655ad6be76bd"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 67becacf3c\n\nWe cherry-picked this in bug 2054299.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/67becacf3c88a16f7118766492439863406852cf\n    Video capture: fix division by zero when framerate is unset\n\n    SPA_FORMAT_VIDEO_framerate is optional in the PipeWire format pod. When\n    absent or zero, the unguarded division in OnFormatChanged() causes\n    a SIGFPE crash. Initialize format structs and fallback to max_framerate\n    or a default of 30 FPS.\n\n    Bug: webrtc:42225999\n    Change-Id: Ic1ee17b466658ad9457a52e2b50d437784069002\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495300\n    Reviewed-by: Andreas Pehrson \u003capehrson@mozilla.com\u003e\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Jan Grulich \u003cgrulja@gmail.com\u003e\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48329}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/67becacf3c.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/s0144.patch", "third_party/libwebrtc/moz-patch-stack/s0145.patch", "third_party/libwebrtc/moz-patch-stack/s0146.patch"], "git_node": "670ebdbceefbec1d424327336f20fef8abfe1f91", "git_parents": ["436ba2b935bc9f09333142d83ce75bf387906670"], "node": "b0e9d94671abe0d9f90bf72e2607f20e28253aba", "parents": ["442cf8a9a744c2299f730363efb2a9342dd083df"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 0fda16159e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0fda16159e33adf59c71a7ad1173dcbe5a632102\n    Extend expiration date for WebRTC-RFC8888CongestionControlFeedback\n\n    Attempts to launch the new feedback format were delayed, but are still\n    ongoing.\n\n    Bug: webrtc:42225697\n    No-True: true\n    Change-Id: I9295d173a195d8ba32c17c74b23238f3f5a592e5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495440\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48330}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/experiments/field_trials.py"], "git_node": "e391ca96eeabefb54b0180378855e91ac9101e34", "git