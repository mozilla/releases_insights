css/css-pseudo/first-line-font-relative-units-001-ref.html", "testing/web-platform/tests/css/css-pseudo/first-line-font-relative-units-001.html"], "git_node": "56d344ccf8fc73fc1007816c51e2df8f5625d19b", "git_parents": ["3b822eb0e2306c68c071fd32380cbabf9cae5893"], "node": "38b5bd63bb1fa656e0c8b30ebdf4b09cdb2efc02", "parents": ["ab15559b928232e55621cb05196f4becd3c6ea3f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068561 [wpt PR 62366] - Update wpt metadata, a=testonly\n\nwpt-pr: 62366\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-pseudo/first-line-font-relative-units-001.html.ini"], "git_node": "e80fa2cd4e26d96cd956082c4d04362875d8f6f0", "git_parents": ["56d344ccf8fc73fc1007816c51e2df8f5625d19b"], "node": "d94e21dad5e59dcd3916b60caaa0df1b75551f7d", "parents": ["38b5bd63bb1fa656e0c8b30ebdf4b09cdb2efc02"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2068562 [wpt PR 62360] - [gap-decorations] Fix padding offset with fragmentation, a=testonly\n\nAutomatic update from web-platform-tests\n[gap-decorations] Fix padding offset with fragmentation\n\nFixes a bug in gap decorations where the code didn't match the comment.\nIn this case, the comment is correct, but offset_in_stitched_container\nwill be zero in the first fragment, and the code was using this path for\nsubsequent fragments.\n\nThis change removes the condition by generalizing the computation and\nadds a WPT that was rendering incorrectly before the fix.\n\nBug: 357648037\nChange-Id: Ifffc9de06bd13f5bb87dc09c7675b8de4ec1881d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8291896\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1690011}\n\n--\n\nwpt-commits: 0d3d36837bfad11c70e14e292960050a9c4396c5\nwpt-pr: 62360\n", "files": ["testing/web-platform/tests/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-038-ref.html", "testing/web-platform/tests/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-038.html", "testing/web-platform/tests/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-039-ref.html", "testing/web-platform/tests/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-039.html", "testing/web-platform/tests/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-040-ref.html", "testing/web-platform/tests/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-040.html", "testing/web-platform/tests/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-041-ref.html", "testing/web-platform/tests/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-041.html"], "git_node": "fc1d62dca91c38c9d659b48211bc5acf11046321", "git_parents": ["e80fa2cd4e26d96cd956082c4d04362875d8f6f0"], "node": "93e167f88e71b995ed3888e0e080b95d3c470929", "parents": ["d94e21dad5e59dcd3916b60caaa0df1b75551f7d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068562 [wpt PR 62360] - Update wpt metadata, a=testonly\n\nwpt-pr: 62360\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-018-crash.html.ini", "testing/web-platform/meta/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-019-crash.html.ini", "testing/web-platform/meta/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-038.html.ini", "testing/web-platform/meta/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-039.html.ini", "testing/web-platform/meta/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-040.html.ini", "testing/web-platform/meta/css/css-gaps/grid/fragmentation/grid-gap-decorations-fragmentation-041.html.ini"], "git_node": "ade8e710e9afa3897f0056bd850be8fd3871e0b2", "git_parents": ["fc1d62dca91c38c9d659b48211bc5acf11046321"], "node": "b7dabcc11619d5d01bff3be717cd3ab9bdd1d578", "parents": ["93e167f88e71b995ed3888e0e080b95d3c470929"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2068564 [wpt PR 62361] - Ensure all CEReactions are called for streamHTML*, a=testonly\n\nAutomatic update from web-platform-tests\nEnsure all CEReactions are called for streamHTML*\n\n- disconnectedCallback() should be called synchronously if the streaming\n  method synchronously removes existing nodes (set/replaceWith)\n- Add more tests for CEReactions during write/close\n- Also add [NewObject] to stream* methods.\n\nBug: 491743369\nChange-Id: I345ec5119d9bd6e43fa1a3fc7e0c7624acbd81f7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8314109\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1690037}\n\n--\n\nwpt-commits: b969aa2798724da282b8cae3eb76a24868f41f4a\nwpt-pr: 62361\n", "files": ["testing/web-platform/tests/domparsing/tentative/stream-html-custom-element.html"], "git_node": "00ebdfd62ac89618480f32c6adb26a4f8f7abf60", "git_parents": ["ade8e710e9afa3897f0056bd850be8fd3871e0b2"], "node": "eca18d0226e308207d9c015652e9efc7c4fd75a7", "parents": ["b7dabcc11619d5d01bff3be717cd3ab9bdd1d578"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068564 [wpt PR 62361] - Update wpt metadata, a=testonly\n\nwpt-pr: 62361\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-html-custom-element.html.ini"], "git_node": "1fbbe883fdca4d5dec71834d8c833155377ad748", "git_parents": ["00ebdfd62ac89618480f32c6adb26a4f8f7abf60"], "node": "b3900b63e33027bcaf1bde0d40846a8088303f6f", "parents": ["eca18d0226e308207d9c015652e9efc7c4fd75a7"], "tags": []}, {"author": "Christopher Cameron \u003cccameron@google.com\u003e", "branch": "default", "desc": "Bug 2068568 [wpt PR 62367] - Canvas2D: Hook up toneMapping context creation attribute, a=testonly\n\nAutomatic update from web-platform-tests\nCanvas2D: Hook up toneMapping context creation attribute\n\nThe 2D, WebGL, and WebGPU tone mapping APIs are being unified.\n\nMove the parsing code from one-off WebGPU code to common\nParseCanvasToneMapping and CanvasToneMappingToV8 functions, and have\nWebGPU call them (mirroring what is already done for\nPredefinedColorSpace).\n\nUse this function (behind feature flag) in 2D canvas context creation\n(ToCanvasContextCreationAttributes) and context attributes querying\n(ToCanvasRenderingContext2DSettings).\n\nWith this in place 2D canvas and WebGPU will maintain HDR tone mapping\nfeatures in lock-step (like how the common PredefinedColorSpace has\nenabled adding linear spaces to all APIs in one move).\n\nAdd WPT tests, to be pointed at when I send out the HTML spec changes\nfor review.\n\nAdd TODOs to remove the very very old HTMLCanvasElement-based HDR APIs.\n\nTAG=agy\nCONV=9f2c857b-3ae8-4048-ab49-db1109f50272\n\nBug: 448552449\nChange-Id: I7e044fc7bf34d8f29a7ad94b901e9c028a140c45\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8327547\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: ccameron chromium \u003cccameron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690193}\n\n--\n\nwpt-commits: df77989abecd295d86579b1702fc321de9507c56\nwpt-pr: 62367\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/context-attributes/getContextAttributes.html", "testing/web-platform/tests/html/canvas/offscreen/manual/context-attributes/getContextAttributes.html"], "git_node": "5a4be21394e371ff115bb6c0f0e47a4951915080", "git_parents": ["1fbbe883fdca4d5dec71834d8c833155377ad748"], "node": "772419da981d005b7309c2c2847756144d4d1d5c", "parents": ["b3900b63e33027bcaf1bde0d40846a8088303f6f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068568 [wpt PR 62367] - Update wpt metadata, a=testonly\n\nwpt-pr: 62367\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/context-attributes/getContextAttributes.html.ini", "testing/web-platform/meta/html/canvas/offscreen/manual/context-attributes/getContextAttributes.html.ini"], "git_node": "404b46bb53ee4a5a99ac63e8b7c9e50302ba8052", "git_parents": ["5a4be21394e371ff115bb6c0f0e47a4951915080"], "node": "94a6460b69b66810495d2772f5e2911c2b1e831f", "parents": ["772419da981d005b7309c2c2847756144d4d1d5c"], "tags": []}, {"author": "Javier Contreras Tenorio \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2068571 [wpt PR 62371] - [masonry] Add missing WPTs for inset percentage and overlap-join cases, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Add missing WPTs for inset percentage and overlap-join cases\n\nBug: 343257585\nChange-Id: I038862a7650e47d41e3982baba6f0dba24cc6e58\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8334686\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1690234}\n\n--\n\nwpt-commits: 98a70a0c581153895f3dd9212850e4df18593c98\nwpt-pr: 62371\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-non-overlapping-gutter-percentage-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-non-overlapping-gutter-percentage.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-overlap-join-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-inset-overlap-join.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-inset-overlap-join-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-inset-overlap-join.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-inset-overlapping-gutters-percentage-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-inset-overlapping-gutters-percentage.html"], "git_node": "636f57adfb3cb79e4e0b114d74e9ad3622b46ac0", "git_parents": ["404b46bb53ee4a5a99ac63e8b7c9e50302ba8052"], "node": "29beeeb8d6d92796cff361c06958b9253612117d", "parents": ["94a6460b69b66810495d2772f5e2911c2b1e831f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068571 [wpt PR 62371] - Update wpt metadata, a=testonly\n\nwpt-pr: 62371\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-non-overlapping-gutter-percentage.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/column-gap-decorations-inset-overlap-join.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-inset-overlap-join.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-inset-overlapping-gutters-percentage.html.ini"], "git_node": "6126abab8e1c3dec9eb51656bb7ea62421189545", "git_parents": ["636f57adfb3cb79e4e0b114d74e9ad3622b46ac0"], "node": "4636a4ad956c7a1e99521a64bc6664494bb60450", "parents": ["29beeeb8d6d92796cff361c06958b9253612117d"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2068576 [wpt PR 62296] - [html-in-canvas] Rename DrawElementOptions to DrawElementImageOptions, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Rename DrawElementOptions to DrawElementImageOptions\n\nThis patch renames DrawElementOptions to DrawElementImageOptions, and\nalso updates the boolean member from updateGeometry to\npreserveElementGeometry (and flips the logic as needed).\n\nBug: 532229486\nChange-Id: I4974f2a8c425fb639c829fb718ff35f024a49069\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8309615\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1688529}\n\n--\n\nwpt-commits: 71dfe0c58ab25603342c6d00df8991972618e518\nwpt-pr: 62296\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/canvas-transform-update.tentative.html"], "git_node": "e139e995093b9fe7713f1f26aba8e20ef084ea93", "git_parents": ["6126abab8e1c3dec9eb51656bb7ea62421189545"], "node": "2fddf439423b570f2e23d5add3117cad25ba671b", "parents": ["4636a4ad956c7a1e99521a64bc6664494bb60450"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068576 [wpt PR 62296] - Update wpt metadata, a=testonly\n\nwpt-pr: 62296\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-update.tentative.html.ini"], "git_node": "415b49a9a6d152ac2de20be795d149cebf28f976", "git_parents": ["e139e995093b9fe7713f1f26aba8e20ef084ea93"], "node": "3de398a8c09786e495666524dd8513479e88d04b", "parents": ["2fddf439423b570f2e23d5add3117cad25ba671b"], "tags": []}, {"author": "Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e", "branch": "default", "desc": "Bug 2068582 [wpt PR 62310] - [css] Refresh media query flags after media mutations, a=testonly\n\nAutomatic update from web-platform-tests\n[css] Refresh media query flags after media mutations\n\nThis change fixes a media-query dependency update missed when\nCompareActiveStyleSheets() reports no active sheet changes. A sheet can\nremain non-matching\u2014and therefore have a null RuleSet\u2014while its\nmedia-query dependencies change. The fix is to determine aggregate media\nquery changes in ApplyRuleSetChanges, even when no style rules change.\n\nThis adds a new WPT that passes in Firefox and fails in Chromium without\nthis change with the message: [FAIL] Changing style media accounts for\nthe new viewport dependency\n  assert_equals: The media query is evaluated against the updated subframe viewport expected \"rgb(0, 128, 0)\" but got \"rgb(0, 0, 255)\"\n\nBug: 545636895\nChange-Id: I0972c0b6d2bbbc30cc6d825ec350bd7203b97451\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8255724\nCommit-Queue: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690079}\n\n--\n\nwpt-commits: b7c635bd548fa842c49c6a6f73095b893027b003\nwpt-pr: 62310\n", "files": ["testing/web-platform/tests/css/mediaqueries/style-media-attribute-change-in-iframe.html"], "git_node": "9dd56d36e19699f3718274e37073463f29b52d9f", "git_parents": ["415b49a9a6d152ac2de20be795d149cebf28f976"], "node": "695bed541817bcd0fd7151fa6995bb3e49700c34", "parents": ["3de398a8c09786e495666524dd8513479e88d04b"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2068583 [wpt PR 62334] - [html-in-canvas] Fix inline hit testing, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Fix inline hit testing\n\nWhen an inline element has a canvas element transform, the offset from\n`PhysicalLinesBoundingBox` needs to be removed so the inline's origin\ndoes not include the inline's offset from its containing block, see:\n`LayoutInline::QuadsForSelfInternal`. This patch applies the same\nadjustment for LayoutInline::NodeAtPoint.\n\nBug: 554586994\nChange-Id: I3cc68e70754e1fbac0b774426a8b26c3d9dafa54\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8324827\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690128}\n\n--\n\nwpt-commits: 480fdfcd85d043c23875665f464c35c0043dff52\nwpt-pr: 62334\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/hit-test/elementsFromPoint-update-element-geometry.tentative.html"], "git_node": "a615d9e67daad78de5acbf39bfe367025b9a69fe", "git_parents": ["9dd56d36e19699f3718274e37073463f29b52d9f"], "node": "75a54bcaaafcf6b3e2ecfff65a6804c51050f6f1", "parents": ["695bed541817bcd0fd7151fa6995bb3e49700c34"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068583 [wpt PR 62334] - Update wpt metadata, a=testonly\n\nwpt-pr: 62334\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/hit-test/elementsFromPoint-update-element-geometry.tentative.html.ini"], "git_node": "6b8d37b36889c15fa4a63a47bf948e5db6a1014b", "git_parents": ["a615d9e67daad78de5acbf39bfe367025b9a69fe"], "node": "d52e5a5ba6add0952b8124ed755e38fcca58a5ae", "parents": ["75a54bcaaafcf6b3e2ecfff65a6804c51050f6f1"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2056331 [wpt PR 61420] - VT: Ensure that scope qualifies for layout containment., a=testonly\n\nAutomatic update from web-platform-tests\nVT: Ensure that scope qualifies for layout containment.\n\nWe need layout containment for all the right reparenting later in the\npipeline, so if the scope doesn't qualify then we shouldn't run the\ntransition.\n\nSee https://github.com/w3c/csswg-drafts/issues/14179\n\nR=kevers@chromium.org\n\nBug: 532144043\nChange-Id: Ibc4478200db52a00e495e70623341adad7f37a68\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8099762\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1689216}\n\n--\n\nwpt-commits: 2e3a142b0ad49affa7147d508414cef390ed0ea3\nwpt-pr: 61420\n", "files": ["testing/web-platform/tests/css/css-view-transitions/scoped/crashtests/element-scoped-multicol-crash.html", "testing/web-platform/tests/css/css-view-transitions/scoped/element-scoped-containment-invalid-state.html", "testing/web-platform/tests/css/css-view-transitions/scoped/scope-containment-during-capture.html"], "git_node": "d239a6ec5d886c40a9794c76f37603e4f86c6841", "git_parents": ["6b8d37b36889c15fa4a63a47bf948e5db6a1014b"], "node": "58c73241a117eca798d19e658f85987411b15d7c", "parents": ["d52e5a5ba6add0952b8124ed755e38fcca58a5ae"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056331 [wpt PR 61420] - Update wpt metadata, a=testonly\n\nwpt-pr: 61420\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/scoped/element-scoped-containment-invalid-state.html.ini"], "git_node": "bbbf17fb5faafa4f6224f575cbc7babcd3ccbfe0", "git_parents": ["d239a6ec5d886c40a9794c76f37603e4f86c6841"], "node": "ab5603d5476d35a4943996cc351946b7cc026656", "parents": ["58c73241a117eca798d19e658f85987411b15d7c"], "tags": []}, {"author": "Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e", "branch": "default", "desc": "Bug 2068593 [wpt PR 62373] - Reduce page-background-image-print.html flakiness, a=testonly\n\nAutomatic update from web-platform-tests\nReduce page-background-image-print.html flakiness\n\nThis test is passing the vast majority of the time, but is still failing\nwith some regularity due to a race between the image being loaded and\nthe framework capturing the rendered pixels. This change eliminates that\nrace by adding a preload, which the test framework will wait for.\n\nVerified locally with private stress-case runs on Mac15 that were\nreliably failing ~50% of executions, and are passing 100% with this\nchange.\n\nBug: NoBug\nChange-Id: Id5464451aeb9a96fe4d80edbe116fb4f24cefb1c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8334591\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nCommit-Queue: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1690240}\n\n--\n\nwpt-commits: 77f2ae0e7f6585595d3ad5c91665018c182247d0\nwpt-pr: 62373\n", "files": ["testing/web-platform/tests/css/css-page/page-background-image-print.html"], "git_node": "3d2471a977fd120c4d962ab1a4b66b1cdf1620ab", "git_parents": ["bbbf17fb5faafa4f6224f575cbc7babcd3ccbfe0"], "node": "7752b0e285a5df303e8a6da99e597f6e5c865c21", "parents": ["ab5603d5476d35a4943996cc351946b7cc026656"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068593 [wpt PR 62373] - Update wpt metadata, a=testonly\n\nwpt-pr: 62373\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-page/crashtests/match-media-listener-relayout-contained-inline-subtree-print.html.ini", "testing/web-platform/meta/css/css-page/crashtests/match-media-listener-relayout-contained-subtree-print.html.ini"], "git_node": "8f262463898de50894f4c0df520b85257174e0d6", "git_parents": ["3d2471a977fd120c4d962ab1a4b66b1cdf1620ab"], "node": "a6cf6e77ff3c7993359eb0c75df4ad5537d48f5e", "parents": ["7752b0e285a5df303e8a6da99e597f6e5c865c21"], "tags": []}, {"author": "Christopher Cameron \u003cccameron@google.com\u003e", "branch": "default", "desc": "Bug 2068597 [wpt PR 62369] - Add parameterized getImageData color conversion WPT test, a=testonly\n\nAutomatic update from web-platform-tests\nAdd parameterized getImageData color conversion WPT test\n\nUnify and parameterize 2D canvas color space conversions for\ngetImageData in color_space.yaml across srgb, srgb-linear, display-p3,\nand display-p3-linear canvas spaces and destination ImageData color\nspaces.\n\nTest 4 pixels in a 2x2 grid: black and white on one diagonal, and\ngamut-specific colors on the other diagonal.\n\nRemove individual redundant tests superseded by this unified test.\n\nTAG=agy\nCONV=3da4bac4-8ad7-46e9-969f-5aa84b7a5620\n\nBug: 454152417\nChange-Id: I9ef57e595995b61e0edb492d111e8293de484761\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8313909\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: ccameron chromium \u003cccameron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1690325}\n\n--\n\nwpt-commits: 397d01d8ee6d3e5dd7084c2462051d7882294760\nwpt-pr: 62369\n", "files": ["testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.display-p3-linear.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.getImageData.convert.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.to.p3.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.to.srgb.html", "testing/web-platform/tests/html/canvas/element/wide-gamut-canvas/2d.color.space.srgb-linear.html", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.display-p3-linear.html", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.display-p3-linear.worker.js", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.getImageData.convert.html", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.getImageData.convert.worker.js", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.p3.to.p3.html", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.p3.to.p3.worker.js", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.p3.to.srgb.html", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.p3.to.srgb.worker.js", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.srgb-linear.html", "testing/web-platform/tests/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.srgb-linear.worker.js", "testing/web-platform/tests/html/canvas/tools/yaml/color_space.yaml"], "git_node": "6bbfed9c8f837e40fc990d1f573a1fdd7ab684e8", "git_parents": ["8f262463898de50894f4c0df520b85257174e0d6"], "node": "cff0d5e40b65b8f9a8603ae538c4cc1c9eb8312e", "parents": ["a6cf6e77ff3c7993359eb0c75df4ad5537d48f5e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068597 [wpt PR 62369] - Update wpt metadata, a=testonly\n\nwpt-pr: 62369\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.display-p3-linear.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.getImageData.convert.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.to.p3.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.p3.to.srgb.html.ini", "testing/web-platform/meta/html/canvas/element/wide-gamut-canvas/2d.color.space.srgb-linear.html.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.display-p3-linear.html.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.display-p3-linear.worker.js.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.getImageData.convert.html.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.getImageData.convert.worker.js.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.p3.to.p3.html.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.p3.to.p3.worker.js.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.srgb-linear.html.ini", "testing/web-platform/meta/html/canvas/offscreen/wide-gamut-canvas/2d.color.space.srgb-linear.worker.js.ini"], "git_node": "3c78bb874d06df809d8d2f50a50c857a32ca6294", "git_parents": ["6bbfed9c8f837e40fc990d1f573a1fdd7ab684e8"], "node": "36f3091e7c915627a9e1cc78214df2db3d8666bb", "parents": ["cff0d5e40b65b8f9a8603ae538c4cc1c9eb8312e"], "tags": []}, {"author": "Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2068599 [wpt PR 62375] - [css-mixins] Require values in @private, a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Require values in @private\n\nThe @private rule uses a declaration list, so private custom property\ndeclarations must include a colon and value. In CL:8228248, we\npreviously accepted bare names and typed names without values, however\nthe spec now specifies that this is not correct [0].\n\nReject these invalid declarations while retaining valid declarations in\nthe same block. Updated unit tests and WPT.\n\n[0] https://github.com/w3c/csswg-drafts/commit/27fd597de31a8c43234f99f58983e4af3d1f9282\n\nBug: 542651959\nLow-Coverage-Reason: COVERAGE_UNDERREPORTED\nChange-Id: I3fa65115e9bce9a3d51297b67563aa105d6d39b0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8337617\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nAuto-Submit: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1690357}\n\n--\n\nwpt-commits: ae6982b121c5636392e003d839fd0eecb943db74\nwpt-pr: 62375\n", "files": ["testing/web-platform/tests/css/css-mixins/private/private-cssom-serialization.tentative.html"], "git_node": "3271479ea230474b568299e1777b577886fc0bd1", "git_parents": ["3c78bb874d06df809d8d2f50a50c857a32ca6294"], "node": "9730739644b3d5b9d936959b4e07392d85005a36", "parents": ["36f3091e7c915627a9e1cc78214df2db3d8666bb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068599 [wpt PR 62375] - Update wpt metadata, a=testonly\n\nwpt-pr: 62375\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/private/private-cssom-serialization.tentative.html.ini"], "git_node": "372e5c81a71dd2c61c5b7d57907ce89205f04afd", "git_parents": ["3271479ea230474b568299e1777b577886fc0bd1"], "node": "cf8c3597d45d18be9b515441a3458982675a79e3", "parents": ["9730739644b3d5b9d936959b4e07392d85005a36"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068936 - [wpt-sync] Update web-platform-tests to ae6982b121c5636392e003d839fd0eecb943db74, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: ae6982b121c5636392e003d839fd0eecb943db74\nwpt-type: landing\n", "files": ["testing/web-platform/meta/clipboard-apis/clipboard-copy-selection-line-break.https.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini", "testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini", "testing/web-platform/meta/css/css-contain/content-visibility/content-visibility-with-top-layer-in-auto-subtree-removal.html.ini", "testing/web-platform/meta/css/css-mixins/private/private-cssom-serialization.tentative.html.ini", "testing/web-platform/meta/css/css-pseudo/first-letter-punctuation-and-space.html.ini", "testing/web-platform/meta/css/cssom-view/cssom-geometryutils-special-cases.html.ini", "testing/web-platform/meta/domparsing/tentative/stream-html-custom-element.html.ini", "testing/web-platform/meta/encoding/streams/decode-ignore-bom.any.js.ini", "testing/web-platform/meta/encoding/streams/decode-incomplete-input.any.js.ini", "testing/web-platform/meta/encoding/streams/decode-split-character.any.js.ini", "testing/web-platform/meta/encoding/streams/decode-utf8.any.js.ini", "testing/web-platform/meta/encoding/streams/encode-bad-chunks.any.js.ini", "testing/web-platform/meta/encoding/streams/encode-utf8.any.js.ini", "testing/web-platform/meta/fetch/api/cors/cors-cookies.any.js.ini", "testing/web-platform/meta/fetch/api/crashtests/huge-fetch.any.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-reuse-in-nested-browsing-contexts.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-get-bounding-client-rect.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-get-set.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/canvas-transform-update.tentative.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/draw-element-image-returned-matrix.tentative.html.ini", "testing/web-platform/meta/html/canvas/offscreen/manual/draw-element-image/drawElementImage-returned-matrix-worker.tentative.html.ini", "testing/web-platform/meta/html/canvas/offscreen/manual/draw-element-image/getElementTransform-worker.tentative.html.ini", "testing/web-platform/meta/html/semantics/forms/the-label-element/proxy-modifier-click-to-associated-element.tentative.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/menu-content-model-violation.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/menu-dialog-mode-focus.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/reparent-with-pending-dialog-microtask.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/valid-submenu-invalid-root.html.ini", "testing/web-platform/meta/html/semantics/the-button-element/command-and-commandfor/on-video-behavior.tentative.html.ini", "testing/web-platform/meta/html/user-activation/navigate-to-sameorigin.html.ini", "testing/web-platform/meta/loading/early-hints/early-hints-response-time.h2.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini", "testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-with-trustedtypes.tentative.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia-settings.https.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia.https.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-audio+video.https.sub.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-audio.https.sub.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-video.https.sub.html.ini", "testing/web-platform/meta/service-workers/service-worker/same-site-cookies.https.html.ini", "testing/web-platform/meta/speech-api/SpeechRecognition-onerror.https.html.ini", "testing/web-platform/meta/storage-access-api/requestStorageAccess-same-site-iframe.sub.https.window.js.ini", "testing/web-platform/meta/streams/piping/error-propagation-backward.any.js.ini", "testing/web-platform/meta/streams/piping/flow-control.any.js.ini", "testing/web-platform/meta/streams/piping/general.any.js.ini", "testing/web-platform/meta/streams/piping/pipe-through.any.js.ini", "testing/web-platform/meta/streams/piping/then-interception.any.js.ini", "testing/web-platform/meta/streams/transferable/readable-stream.html.ini", "testing/web-platform/meta/streams/transferable/service-worker.https.html.ini", "testing/web-platform/meta/streams/transferable/shared-worker.html.ini", "testing/web-platform/meta/streams/transferable/transform-stream.html.ini", "testing/web-platform/meta/streams/transferable/window.html.ini", "testing/web-platform/meta/streams/transferable/worker.html.ini", "testing/web-platform/meta/svg/idlharness.window.js.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-audiocontext-interface/callback-detached-buffer.html.ini", "testing/web-platform/meta/webtransport/datagrams-writable.https.any.js.ini", "testing/web-platform/meta/webtransport/headers.https.any.js.ini", "testing/web-platform/meta/workers/interfaces/SharedWorkerGlobalScope/onconnect.html.ini"], "git_node": "653efeb0882012167df681ec6ce6c66f4cbd379a", "git_parents": ["372e5c81a71dd2c61c5b7d57907ce89205f04afd"], "node": "0a633491f9ea838e5aebae14792327b0aacedf42", "parents": ["cf8c3597d45d18be9b515441a3458982675a79e3"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064819 - Implement changes from review r=android-reviewers,ltokhtamuradova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324078\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/AudioFileCache.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenPlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenPlayer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt"], "git_node": "8281ce5844d543879b9f284aafeb602f52efb288", "git_parents": ["653efeb0882012167df681ec6ce6c66f4cbd379a"], "node": "cbad81e3471c4630b579ca116cf6e68342f4f6a8", "parents": ["0a633491f9ea838e5aebae14792327b0aacedf42"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068351 - Add GetFormIfRegistered helper r=edgar\n\nThis adds a new helper which returns the form, guarded by the ADDED_TO_FORM flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323267\n", "files": ["dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h"], "git_node": "a369262f4ad63418b23f6c77f0918e49601ca743", "git_parents": ["8281ce5844d543879b9f284aafeb602f52efb288"], "node": "eb04c4f08e6427beb7aa98b5689178b0f4be1d44", "parents": ["cbad81e3471c4630b579ca116cf6e68342f4f6a8"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069199 - Fix for generate failures.\n", "files": ["docs/jsdoc-plugins/skip-unnamed-members.mjs"], "git_node": "fbc5557569912aa3e1062b9edefe5222d9f64bb3", "git_parents": ["a369262f4ad63418b23f6c77f0918e49601ca743"], "node": "9952fc274d5e21ca471b55771cf77b6251ad6f31", "parents": ["eb04c4f08e6427beb7aa98b5689178b0f4be1d44"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068936 - Update metadata for encoding/streams/decode-*.any.js.\n", "files": ["testing/web-platform/meta/encoding/streams/decode-incomplete-input.any.js.ini", "testing/web-platform/meta/encoding/streams/decode-split-character.any.js.ini"], "git_node": "03b5c27cdba4d4fbf00d6e0cc47d156f08435b71", "git_parents": ["fbc5557569912aa3e1062b9edefe5222d9f64bb3"], "node": "db1cb569b8092d7b48d1072279d9510ea8be1e95", "parents": ["9952fc274d5e21ca471b55771cf77b6251ad6f31"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068936 - Update metadata for css/css-borders/corner-shape/render-corner-shape.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324295\n", "files": ["testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini"], "git_node": "eeea388052d5329a7cb0678236b91a7adfabe24c", "git_parents": ["03b5c27cdba4d4fbf00d6e0cc47d156f08435b71"], "node": "f953963903d800e14b9092d3f9de66ff111dadc2", "parents": ["db1cb569b8092d7b48d1072279d9510ea8be1e95"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068160 - Part 11 - Cull tile cache content against the tile cache's own space. r=gw\n\nA snapping surface now performs its visibility, clipping and dirty-region\ncalculations relative to its own raster node instead of the root reference frame.\nFor a surface that rasterizes against the root the two are the same node, so in\npractice this moves tile caches: content drawn into one is culled against the\nregion of that cache's own space the screen covers, rather than against the\nscreen directly. The two differ by the cache node's scale and offset, which is\nwhere a pinch or page zoom above the cache used to enter the culling maths.\n\nNon-snapping raster roots (preserve-3d, perspective, RasterSpace::Local, huge\nscale) deliberately stay on the root for now. Their raster node can sit inside a\n3D context, where the screen has no axis-aligned pre-image and the culling rect\nwould have to degrade to covering everything.\n\nA tile cache's picture spatial node, raster node and dirty-region node are all\nits scroll root, so DirtyRegion::add_dirty_region's picture-to-visibility mapping\ncollapses to the identity and its .expect() becomes unreachable rather than\nmerely unreached.\n\nSurfaces can now disagree about which node their culling rect is expressed in, so\nupdate_culling_rect maps the parent's rect into this surface's vis space rather\nthan taking it verbatim - the two differ by the cache node's scroll offset and\nscale, which is exactly the correction this patch is about. It crosses via the\nscreen, since neither vis node need be an ancestor of the other but both always\nrelate to the root.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322979\n", "files": ["gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "4ec45e2182c8396496f070e4aa272500c5a00466", "git_parents": ["eeea388052d5329a7cb0678236b91a7adfabe24c"], "node": "734467c76fd1d98e487db2aaf58781dd5f0a0250", "parents": ["f953963903d800e14b9092d3f9de66ff111dadc2"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1927022 - Avoid materializing the parts array in EndsInANumber. r=necko-reviewers,valentin\n\nThe array is built on every URL parse with a non-empty host, and only its\nlength and last element are ever read. Scan back from the end of the host\nfor the final separator instead. In a parent-process profile of bug\n1965181 the allocator was ~75% of EndsInANumber: moz_xrealloc alone was\n253 of 389 samples, against 12 for the tokenizer itself.\n\nSplit() yields no tokens at all for an empty string, so the spec step that\nreturns false for a one-element parts list holding the empty string was\nalready unreachable, and a trailing \".\" is the only way for the last part\nto come back empty. Dropping one trailing separator therefore covers step\n2 exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324092\n", "files": ["netwerk/base/IPv4Parser.cpp"], "git_node": "c4c6b2bf7a699dc2c2cd7de159d9281d84b03f60", "git_parents": ["4ec45e2182c8396496f070e4aa272500c5a00466"], "node": "57df4cb7f749f724c7aabc371df72ca5df63b730", "parents": ["734467c76fd1d98e487db2aaf58781dd5f0a0250"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070136 - Correct and tighten the guidance on referring to code. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324263\n", "files": [".agents/skills/file-good-first-bug/SKILL.md", ".claude/skills/file-good-first-bug/SKILL.md", "AGENTS.md"], "git_node": "94b556c3793feb19ed8faf3addc86c2bcd0755d7", "git_parents": ["c4c6b2bf7a699dc2c2cd7de159d9281d84b03f60"], "node": "e736c74f754d43f1ad939e010228cf652583e300", "parents": ["57df4cb7f749f724c7aabc371df72ca5df63b730"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050381 - Make credit card doorhanger keyboard focusable on initial submission\" for breaking WebAuthn r=credential-management-reviewers,dimi\n\nThis reverts commit dab9d9770bdb2751045449f91dae92340da37928.\n\nWhile the commit intended to auto-focus credit card auto-fill prompts, it\nalso made password auto-fill prompts take focus away from the document.\n\nWebAuthn requests require focus to work correctly: Bug 2068858\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324164\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_keyboard.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/components/passwordmgr/LoginManagerPrompter.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_doorhanger_keyboard.js", "toolkit/modules/PopupNotifications.sys.mjs"], "git_node": "b11f760c563c75ae547151b4595b9e9859078383", "git_parents": ["94b556c3793feb19ed8faf3addc86c2bcd0755d7"], "node": "7659ae27baa68be05437ef80ee0235c2323d2f48", "parents": ["e736c74f754d43f1ad939e010228cf652583e300"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2068643 - [wpt] Document that profile default preferences are not visible to run info. r=jgraham,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323359\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py"], "git_node": "c1cce1577b52ffcb2fac487cb81c08b5f4548926", "git_parents": ["b11f760c563c75ae547151b4595b9e9859078383"], "node": "5c8e39d73affadb019f6c76bd7ebf158bdde0ec9", "parents": ["7659ae27baa68be05437ef80ee0235c2323d2f48"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2068643 - [wpt] Split the \"remoteAsyncEvents\" run info flag by input type. r=jgraham,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323360\n", "files": ["testing/web-platform/meta/input-events/input-events-spin-button-click-on-number-input-delete-document.html.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/navigation.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/pointer_mouse.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/wheel_events.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/wheel_frame.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/navigation.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_mouse.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel_events.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel_frame.py.ini", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py"], "git_node": "b73351eb90177ffd45b56630d8e8a0d3fe833701", "git_parents": ["c1cce1577b52ffcb2fac487cb81c08b5f4548926"], "node": "56ddba6563aa873bd4c1e1251dad0cad573f5aff", "parents": ["5c8e39d73affadb019f6c76bd7ebf158bdde0ec9"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068259 - Fetch the raptor benchmark repositories instead of cloning them. r=perftest-reviewers,releng-reviewers,bhearsum,kshampur\n\nThe raptor benchmark tests clone their benchmark repository from GitHub on\nevery task. A full clone of Speedometer alone costs 11-30s, this patch removes all\nfull clones:\n\n- JetStream3 (desktop and mobile) uses the existing `pgo-extended-corpus`\n  fetch. It is already pinned to 3967678fa8ab98d847ab33cf3728dba726fa854b,\n  the same revision the tomls check out, so no new artifact is needed.\n- MotionMark (desktop and mobile, both the standard and htmlsuite subtests)\n  gets a new `motionmark` fetch, pinned to the revision its tomls use.\n- speedometer-experimental gets a new `speedometer-experimental` fetch. The\n  speedometer2 and speedometer3 subtests are vendored in-tree and don't clone.\n- unity-webgl-mobile sparse-checks-out `benchmarks/unity-webgl` from the\n  perf-automation monorepo rather than full-cloning it, matching what\n  unity-webgl-desktop already does for the same repository and revision. A\n  tarball is a poor fit there since the test needs 91MB of a 587MB monorepo.\n\nBenchmarks say where their fetch lands with a new `fetch_path` setting. As\nMOZ_FETCHES_DIR is only set in CI, the clone path is kept as a local fallback\nand the `repository` settings stay in place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323032\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/kinds/fetch/benchmarks.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/benchmark.py", "testing/raptor/raptor/tests/benchmarks/jetstream3-desktop.toml", "testing/raptor/raptor/tests/benchmarks/jetstream3-mobile.toml", "testing/raptor/raptor/tests/benchmarks/motionmark-1-3-desktop.toml", "testing/raptor/raptor/tests/benchmarks/motionmark-1-3-mobile.toml", "testing/raptor/raptor/tests/benchmarks/speedometer-desktop.toml", "testing/raptor/raptor/tests/benchmarks/unity-webgl-mobile.toml", "testing/raptor/test/python.toml", "testing/raptor/test/test_benchmark.py"], "git_node": "48294db986c25364960e5239ba255cf061893aab", "git_parents": ["b73351eb90177ffd45b56630d8e8a0d3fe833701"], "node": "92e44c392dcf28d5c06cfa895a5db9b5743bcc34", "parents": ["56ddba6563aa873bd4c1e1251dad0cad573f5aff"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043713 - Crop, and remove chrome-m popup from the bottom. r=perftest-reviewers,sparky\n\nChrome introduced a new popup that is interfering with our startup metric gathering, this crops that out of the image analysis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303477\n", "files": ["testing/performance/mobile-startup/android_startup_videoapplink.py"], "git_node": "781a682acaafd8417438d7f026115575c1389089", "git_parents": ["48294db986c25364960e5239ba255cf061893aab"], "node": "145f9382c34238fb123996d90e636fa5442fcdd0", "parents": ["92e44c392dcf28d5c06cfa895a5db9b5743bcc34"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059094 - Ensure that failing layer on mozperftest properly bubbles up and displays error. r=perftest-reviewers,mozperftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315073\n", "files": ["python/mozperftest/mozperftest/test/shellscript.py", "python/mozperftest/mozperftest/tests/test_shellscript.py", "testing/performance/mobile-startup/cmff.sh", "testing/performance/mobile-startup/cvne-newssite.sh", "testing/performance/mobile-startup/cvne-shopify.sh", "testing/performance/mobile-startup/cvns.sh", "testing/performance/mobile-startup/homeview.sh", "testing/performance/mobile-startup/restore.sh"], "git_node": "af2b2cfab1930cb5867a2681e44c73f2bff500fb", "git_parents": ["781a682acaafd8417438d7f026115575c1389089"], "node": "c4f3f988e8b1a25df7ea38bf187b58e9fc55a94b", "parents": ["145f9382c34238fb123996d90e636fa5442fcdd0"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068128 - Improve generation of white-listed files for clang-tidy r=sylvestre\n\nCurrent algorithm for third party identification iterates over a list of\ndirectory and checks if any of them contains individual files.\n\nThis list is built from tools/rewriting/ThirdPartyPaths.txt, which also\ncontains many directories or files that do not contains any file that\nmatters for clang-tidy.\n\nRemoving those entries leads to much faster third party identification,\nsaving more than 200ms per file for some C++ sources. It saves 0.3% of\nbuild time on spidermonkey.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322642\n", "files": ["build/clang-plugin/ThirdPartyPaths.py", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "35c1b0f50f750bbcc6b5ac1b8ece435e760bb3e8", "git_parents": ["af2b2cfab1930cb5867a2681e44c73f2bff500fb"], "node": "e873eba8b0d6c664b09c3ff0342c4627489a2375", "parents": ["c4f3f988e8b1a25df7ea38bf187b58e9fc55a94b"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067350 - Add Settings action to location reset snackbar r=android-reviewers,android-l10n-reviewers,Roger,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322566\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/snackbar/SnackbarState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/snackbar/SnackbarStateReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionInfoPrompter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/ui/IPProtectionSnackbarBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/TrustPanelFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/snackbar/SnackbarBinding.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionInfoPrompterTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/ui/IPProtectionSnackbarBindingTest.kt"], "git_node": "22fec3e23ac13c50c80699b965d6019478c13ce4", "git_parents": ["35c1b0f50f750bbcc6b5ac1b8ece435e760bb3e8"], "node": "4a78a218f261823efc5811bfcd5b7d11f78e1647", "parents": ["e873eba8b0d6c664b09c3ff0342c4627489a2375"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066452 - Sort ip protection locations in alphabetical order r=android-reviewers,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322815\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/CountryTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/ipprotection/IPProtectionLocationTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocations.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsScreenTest.kt"], "git_node": "c06541755e6546301f784119730f0d662a32aae9", "git_parents": ["22fec3e23ac13c50c80699b965d6019478c13ce4"], "node": "67605549b993ca7e5f804341f288327abdc8d585", "parents": ["4a78a218f261823efc5811bfcd5b7d11f78e1647"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069454 - Fix conditional uninitialized read r=ltenenbaum\n\nOnly global variables are default zero-initialized. In the scenario\nbelow, if no messages matches the given `aActionName`, `navigate` is\ntested for nullity but may be uninitialized, that's UB.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323704\n", "files": ["dom/notification/NotificationHandler.cpp"], "git_node": "0568d82f674c41edee8a8bdd7fc2d05a14e91094", "git_parents": ["c06541755e6546301f784119730f0d662a32aae9"], "node": "d9528ce5a69795a9e6f7af86f1c9c41dcf5d251b", "parents": ["67605549b993ca7e5f804341f288327abdc8d585"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2069586: Bump User Characteristics schema r=tschuster\n\nBetter to be safe than confused; just in case this causes a user-visible change\nthis will potentially help us differentiate it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324290\n", "files": ["toolkit/components/resistfingerprinting/nsUserCharacteristics.cpp"], "git_node": "901cb4feb2d08ec3ff9f53092b396c8256be9e8a", "git_parents": ["0568d82f674c41edee8a8bdd7fc2d05a14e91094"], "node": "4e65fb4e98125a3cf4a5886b8ff4d17ae8e42d46", "parents": ["d9528ce5a69795a9e6f7af86f1c9c41dcf5d251b"], "tags": []}, {"author": "Christoph Moench-Tegeder \u003ccmt@burggraben.net\u003e", "branch": "default", "desc": "Bug 2069654 - enable WebSerial on FreeBSD r=gstoll\n\nThis add the pieces to enable WebSerial on FreeBSD.\nPatch originally submitted at\nhttps://bugs.freebsd.org/bugzilla/show_bug.cgi?id=297874 by\n\"pcc \u003cpcc@gmx.net\u003e\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323862\n", "files": ["dom/webserial/PosixSerialPlatformService.cpp", "dom/webserial/SerialPlatformService.cpp", "dom/webserial/moz.build"], "git_node": "9a7edb66738c696ae8b1ce799d278a3d8b023db2", "git_parents": ["901cb4feb2d08ec3ff9f53092b396c8256be9e8a"], "node": "2f673cd290410414ccb51a3109dad9949c854182", "parents": ["4e65fb4e98125a3cf4a5886b8ff4d17ae8e42d46"], "tags": []}, {"author": "Andreas Farre \u003