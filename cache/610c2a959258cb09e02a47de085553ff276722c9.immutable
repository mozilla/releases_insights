"e3119b83c16ca511c432cde7f6ed2d8d6ee72a2b", "4a0d9dfe68e0046b321e1eb058d2ae9563181c73", "230e079a1f7d111b3a2bfb4faedc4f1d14524f6e", "6c8c4a8e499474c0d870cfe94c240d9bb673db99", "bde88e0509310cea9d16d473d94d7d0f48632df2"], "user": "abutkovits@mozilla.com"}, "45208": {"changesets": [{"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 2004869 - Remove the media.rvfc.enable pref r=webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322117\n", "files": ["dom/canvas/test/webgl-conf/mochi-single.html", "dom/webidl/HTMLVideoElement.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/canvas/element/manual/imagebitmap/canvas-createImageBitmap-video-resize.html.ini", "testing/web-platform/meta/video-rvfc/__dir__.ini", "testing/web-platform/mozilla/meta/webgpu/__dir__.ini"], "git_node": "e49a1b2b27be5996f8c6e76771fff21ee7fe2263", "git_parents": ["bde88e0509310cea9d16d473d94d7d0f48632df2"], "node": "cf6e879bbf1c0e3e94367bcdcd88af267444f321", "parents": ["51cf5deab24ac7b902ce67dd38b485192dbdb371"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1610671 - Remove the media.eme.encrypted-media-encryption-scheme.enabled pref r=webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322126\n", "files": ["dom/media/eme/MediaKeySystemAccess.cpp", "dom/webidl/MediaKeySystemAccess.webidl", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "0b88bd09cfb9458cce8a7474d9047394315eeba9", "git_parents": ["e49a1b2b27be5996f8c6e76771fff21ee7fe2263"], "node": "bc8331d907ce4ce66c2f9508d67bdc96b4b78f44", "parents": ["cf6e879bbf1c0e3e94367bcdcd88af267444f321"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2004869 - Remove the media.rvfc.enable pref r=webidl,smaug\" for causing build bustages @ HTMLVideoElementBinding.cpp\n\nThis reverts commit e49a1b2b27be5996f8c6e76771fff21ee7fe2263.\n", "files": ["dom/canvas/test/webgl-conf/mochi-single.html", "dom/webidl/HTMLVideoElement.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/html/canvas/element/manual/imagebitmap/canvas-createImageBitmap-video-resize.html.ini", "testing/web-platform/meta/video-rvfc/__dir__.ini", "testing/web-platform/mozilla/meta/webgpu/__dir__.ini"], "git_node": "eed150072f77f3f705790f4ae9d5412ab903bd9e", "git_parents": ["0b88bd09cfb9458cce8a7474d9047394315eeba9"], "node": "fedcbac10f2000dfa25c7903bd84c67e5d3d60ba", "parents": ["bc8331d907ce4ce66c2f9508d67bdc96b4b78f44"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2065438: Simplify annotations for 446100-1* reftests to just depend on useDrawSnapshot.\n\nThese reftests fail under WebRender (and have failed since WebRender\nwas enabled by default), due to WebRender having different rounding behavior\nwhen sampling image-pixels with a fractional devicePixelRatio.\n\nIn other words: ever since WebRender was enabled, these tests have\nonly passed with the drawSnapshot backend.  This patch codifies that\nexpectation more clearly.  This addresses an unexpected-pass\nperma-fail that we were getting on one drawSnapshot test\nconfiguration, due to formerly having an unnecessarily-complex combination\nof annotations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322185\n", "files": ["layout/reftests/bugs/reftest.list"], "git_node": "690bf4bda3b19715059ea176583c32f19e670630", "git_parents": ["eed150072f77f3f705790f4ae9d5412ab903bd9e"], "node": "ca264e667aa2cc6b2fe9502a170d0985cf3ca6c8", "parents": ["fedcbac10f2000dfa25c7903bd84c67e5d3d60ba"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLO