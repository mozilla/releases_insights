ist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/package-lock.json", "toolkit/themes/shared/design-system/package.json", "toolkit/themes/shared/design-system/src/figma-import.mjs", "toolkit/themes/shared/design-system/src/tokens/base/focus.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/font.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/text.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/text.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/info-bar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/input.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/link.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/panel.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json", "toolkit/themes/shared/design-system/tests/try-runner.js"], "git_node": "37485631992462b38985345d3c58c2745b6c460b", "git_parents": ["e83a86a4244f662868a7b565c27e002d015e11ed"], "node": "ad8ac0a2efa7eacbdc79237441b65d8bb0dcbd6a", "parents": ["0420dba1d55eb5c3fffcb0e4b92fcde4161fad2e"], "tags": []}, {"author": "Sebastian Streich \u003cstreich.mobile@gmail.com\u003e", "branch": "default", "desc": "Bug 2052864 - Refresh the ServerList once per start r=rking,geckoview-reviewers,owlish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310644\n", "files": ["mobile/shared/modules/geckoview/GeckoViewIPProtection.sys.mjs", "toolkit/components/ipprotection/IPProtectionServerlist.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPProtectionServerlist.js"], "git_node": "5a5d15e81b1480262c8202324e7ffb9aa02546c8", "git_parents": ["37485631992462b38985345d3c58c2745b6c460b"], "node": "a068c866e123bef5454406706c5145bec7f89ea2", "parents": ["ad8ac0a2efa7eacbdc79237441b65d8bb0dcbd6a"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067149: Split out attr() URL parse error WPT tests from attr-all-types.html & attr-security.html. r=firefox-style-system-reviewers,emilio\n\nSee change proposal [1] and the corresponding spec issue [2].\n\n[1]: https://github.com/web-platform-tests/interop/issues/1303\n[2]: https://github.com/w3c/csswg-drafts/issues/13946\n\nTwo subtests merge into one, because they test the same thing; that is,\nset an unregistered variable with `attr(data-foo, \u003curl\u003e)` and verify\nthat it fails to parse.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321878\n", "files": ["testing/web-platform/meta/css/css-values/attr-all-types.html.ini", "testing/web-platform/meta/css/css-values/attr-parse-url.html.ini", "testing/web-platform/meta/css/css-values/attr-security.html.ini", "testing/web-platform/tests/css/css-values/attr-all-types.html", "testing/web-platform/tests/css/css-values/attr-parse-url.html", "testing/web-platform/tests/css/css-values/attr-security.html"], "git_node": "016e58dbe0734edfb98a251d634cb4cb5ab53aec", "git_parents": ["5a5d15e81b1480262c8202324e7ffb9aa02546c8"], "node": "96c3ed3a6b0935f4a9fe0c3a4950dc05a5dcf695", "parents": ["a068c866e123bef5454406706c5145bec7f89ea2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067158 - Enable skipTabStop in the newtab search mode switcher tab order test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321890\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js"], "git_node": "deae8b69e1ba0e28059be182be84cbb438a460c2", "git_parents": ["016e58dbe0734edfb98a251d634cb4cb5ab53aec"], "node": "f16ac94e28df610faf94d6c968006817dcdc9221", "parents": ["96c3ed3a6b0935f4a9fe0c3a4950dc05a5dcf695"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051648 - Add glean metric for user interaction with device submenu in FxA menu. r=nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321034\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js", "services/sync/modules/metrics.yaml"], "git_node": "0b0ec50f1033145d3a0cf446ef931377ed3c9bd1", "git_parents": ["deae8b69e1ba0e28059be182be84cbb438a460c2"], "node": "95f8eb079815e9e1b52ad35a0fb484537382998f", "parents": ["f16ac94e28df610faf94d6c968006817dcdc9221"], "tags": []}, {"author": "eagboola \u003cekerin.m.a@gmail.com\u003e", "branch": "default", "desc": "Bug 2064541 - Delete documentation related to the removed SEARCH_SUGGESTIONS_LATENCY_MS histogram. r=scunnane,search-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321411\n", "files": ["toolkit/components/search/docs/Telemetry.md"], "git_node": "9ad0a7a6743732993d91bdbcbc6a28166ac67b0f", "git_parents": ["0b0ec50f1033145d3a0cf446ef931377ed3c9bd1"], "node": "0cdce56b89485af7865b46e4bb051c95debd8d1b", "parents": ["95f8eb079815e9e1b52ad35a0fb484537382998f"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062741 - Migrate browser_protections_telemetry.js to Glean r=timhuang,TravisLong\n\nTest-only change, no probe definitions are touched. This is a prerequisite for\nremoving the security.ui.protections Legacy Telemetry mirrors: the test is the\nonly in-tree consumer of them, and it asserted exclusively through\nServices.telemetry.snapshotEvents.\n\nAll recording sites already went through Glean via RPMRecordGleanEvent, so the\nlegacy events only existed as telemetry_mirror side effects. Reading the Glean\nevents directly asserts the same behaviour against the probes Firefox actually\nrecords.\n\nThe awkward part of the old test was waitForTelemetryEventCount, which waited on\na running total of every security.ui.protections legacy event - show, close and\nclick combined. Those totals (4, 7, 10 ... 37) encoded how many tab loads each\nstep happened to perform, so dropping any single mirror shifted every subsequent\nnumber. Glean's testGetValue() is per-metric, so each assertion now waits only on\nthe event it cares about and the counts become local to that metric.\n\ntestFlushAllChildren() replaces the poll-until-visible loops, since these events\nare recorded in the content process and FOG can flush child data on demand\nrather than waiting for legacy's 2 second sync interval.\n\nThe two .skip()ed VPN tasks are migrated as well. They referenced vpn_card_link,\nvpn_banner_link and vpn_banner_close, whose legacy events bug 2062676 already\ndeleted, so they were asserting against probes that no longer exist.\n\naddArbitraryTimeout is kept as-is. It now only serves to let earlier tasks settle\nbefore the FOG reset, and removing it is a timing change better made separately.\n\nAll 26 telemetry assertions pass in the same order with unchanged messages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317924\n", "files": ["browser/components/protections/test/browser/browser_protections_telemetry.js"], "git_node": "91f478bad9587d747bd215fe789e335da0044286", "git_parents": ["9ad0a7a6743732993d91bdbcbc6a28166ac67b0f"], "node": "a73b2e158bc741cafb34e7e49f3eca45083de64f", "parents": ["0cdce56b89485af7865b46e4bb051c95debd8d1b"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062741 - Remove the Legacy Telemetry mirrors of the security.ui.protections protection_report events r=timhuang,TravisLong\n\nRemoves securityuiprotections_show_protectionreport and\nsecurityuiprotections_close_protectionreport. Only the Legacy Telemetry mirrors\ngo; the Glean events show_protection_report and close_protection_report stay, so\nwhat Firefox collects is unchanged.\n\nBoth sides of each mirror have to go in the same commit. test_mirrors.py asserts\nthat every telemetry_mirror resolves to an existing probe, and separately that\nevery event probe has a mirroring metric, so removing either side alone fails.\n\nprotection_report was the last object on security.ui.protections#show and on\n#close, so both legacy events are deleted outright rather than reduced.\n\nThe `value` extra_keys descriptions on both Glean events described themselves in\nterms of the legacy parameter they mirrored. They now describe what the key\nactually holds: the entrypoint for show, and nothing for close.\n\nbrowser_protections_telemetry.js asserted both of these events through\nServices.telemetry.snapshotEvents; the preceding commit moves it to Glean.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317925\n", "files": ["browser/components/protections/metrics.yaml", "toolkit/components/telemetry/Events.yaml"], "git_node": "14f4de791fc01fd4cad9df663016f516b1636bae", "git_parents": ["91f478bad9587d747bd215fe789e335da0044286"], "node": "ae84a3d0c5a5fa2e977b5cbf7b42669eca5beb99", "parents": ["a73b2e158bc741cafb34e7e49f3eca45083de64f"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062746 - Remove the Legacy Telemetry mirrors of five security.ui.protections click events r=timhuang,TravisLong\n\nRemoves the mirrors named in comment 0:\n\n  securityuiprotections_click_settingslink\n  securityuiprotections_click_lwopenbutton\n  securityuiprotections_click_lwaboutlink\n  securityuiprotections_click_trackersaboutlink\n  securityuiprotections_click_mobileapplink\n\nOnly the Legacy Telemetry mirrors go; the five Glean events stay, so what Firefox\ncollects is unchanged. Every recording site already went through Glean via\nRPMRecordGleanEvent, so nothing outside the probe definitions had to change.\n\nBoth sides of each mirror have to go in the same commit. test_mirrors.py asserts\nthat every telemetry_mirror resolves to an existing probe, and separately that\nevery event probe has a mirroring metric, so removing either side alone fails.\n\nsecurity.ui.protections#click survives with a reduced object list. Six objects\nstill mirror and are left for follow-up bugs: lw_sync_link, mtr_about_link,\nmtr_report_link, mtr_signup_button, vpn_app_link_android and vpn_app_link_ios.\n\nThe `value` extra_keys description changes too. It is a YAML anchor shared by all\nfourteen click events, and it described itself as mirroring the Legacy Telemetry\nevent's `value` parameter, which stopped being true for three of them in bug\n2062676 and is no longer true for the five here. It now describes what the key\nactually holds, which is accurate for all fourteen regardless of mirror status.\nBug 2062741 did the same to the `show` anchor and to close_protection_report.\n\nbrowser_protections_telemetry.js covered four of these five objects through\nServices.telemetry.snapshotEvents; bug 2062741 moves it to Glean first.\nmobile_app_link has no test coverage either way.\n\nbrowser/components/protections/test/browser/ passes, 182 checks, 0 failures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317926\n", "files": ["browser/components/protections/metrics.yaml", "toolkit/components/telemetry/Events.yaml"], "git_node": "0068da545456b7f13f98b0ceb47456a17152dbeb", "git_parents": ["14f4de791fc01fd4cad9df663016f516b1636bae"], "node": "c0c814dd6077a7e147cf5922a91705b45a4a51a9", "parents": ["ae84a3d0c5a5fa2e977b5cbf7b42669eca5beb99"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059515 - Print Preview \"scale\" textfield arrow buttons poke outside the textfield r=desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319188\n", "files": ["toolkit/components/printing/content/print.css"], "git_node": "29178b62d37bfe405fb3dc7421773421d82d3bd9", "git_parents": ["0068da545456b7f13f98b0ceb47456a17152dbeb"], "node": "fbd6d18420ac397ef3f396f935fb726c080a78b2", "parents": ["c0c814dd6077a7e147cf5922a91705b45a4a51a9"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064703 - Copy fontconfig charset to gfxCharacterMap to allow sharing the map for non-OpenType fonts. r=emilio\n\nInstead of directly using the fontconfig FcCharSet for legacy font formats,\ncopy the charset into a gfxCharacterMap so that it can be migrated to the\nshared font list and benefit from the lock-free lookups that supports.\n\n(This removes the only override of gfxFontEntry::TestCharacterMap, so that\nno longer needs to be a virtual method.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321841\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "ed7a0996b59d1c852e614919d225e11b0306618f", "git_parents": ["29178b62d37bfe405fb3dc7421773421d82d3bd9"], "node": "9788eee6bf43a9f39b05707e495885ec6e1fb170", "parents": ["fbd6d18420ac397ef3f396f935fb726c080a78b2"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060290 - moz-breadcrumb has inconsistent focus outline styles r=desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319553\n", "files": ["toolkit/content/widgets/moz-breadcrumb-group/moz-breadcrumb.css"], "git_node": "ee0b4b23b5e21a4838f691e7627b307e00c31c9d", "git_parents": ["ed7a0996b59d1c852e614919d225e11b0306618f"], "node": "d6edcc92209c5677183ec01feede0fb331eba58b", "parents": ["9788eee6bf43a9f39b05707e495885ec6e1fb170"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052310 - decomission x64 macOS 14.7 Nightly as Release performance tests r=perftest-reviewers,sparky\n\nNaR has been running fine on the aarch64 macOS machines so far, and we are moving\naway from the intel workers for perftesting. This patch just removes the\nNaR variant from running performance tests on the 14.x r8 machines now\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321880\n", "files": ["taskcluster/test_configs/test-platforms.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "3a9dc1f2679c633c6837d92f3504023d75809825", "git_parents": ["ee0b4b23b5e21a4838f691e7627b307e00c31c9d"], "node": "1384362b232be79fe1945cac51d00276fc884eb6", "parents": ["d6edcc92209c5677183ec01feede0fb331eba58b"], "tags": []}, {"author": "mr. m \u003cmr.m@tuta.com\u003e", "branch": "default", "desc": "Bug 1936468 - Add NSLocalNetworkUsageDescription to Info.plist.in r=spohl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317974\n", "files": ["browser/app/macbuild/Contents/Info.plist.in"], "git_node": "f99077c0c89702feb953dadca715b8742040da87", "git_parents": ["3a9dc1f2679c633c6837d92f3504023d75809825"], "node": "c2a121ea4657b089b6bab33ef626b23d340307ec", "parents": ["1384362b232be79fe1945cac51d00276fc884eb6"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067008: Add nsCocoaFeatures::OnGoldenGateOrLater() for macOS 27. r=mac-reviewers,mstange\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321777\n", "files": ["widget/cocoa/nsCocoaFeatures.h", "widget/cocoa/nsCocoaFeatures.mm"], "git_node": "262dedeaf3c210928b8662aa5e55d781247cc23c", "git_parents": ["f99077c0c89702feb953dadca715b8742040da87"], "node": "27716a0d589b90b89a8bedf69e57656f7de415e6", "parents": ["c2a121ea4657b089b6bab33ef626b23d340307ec"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065346 - Hold write lock around mCharacterMap update. r=gfx-reviewers,nical,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321840\n", "files": ["gfx/thebes/gfxFontEntry.h"], "git_node": "e8707eb4d1f4a2b2ca98ec4a1e5c3b81cc2b8e6c", "git_parents": ["262dedeaf3c210928b8662aa5e55d781247cc23c"], "node": "e31a802a73f3de9d737830bc7254271ec9c30f8c", "parents": ["27716a0d589b90b89a8bedf69e57656f7de415e6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066941 - Update AndroidX Navigation to version 2.10.0. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321734\n", "files": ["gradle/libs.versions.toml"], "git_node": "cb310806c298ea79e187d0a53fcbadb177a609c2", "git_parents": ["e8707eb4d1f4a2b2ca98ec4a1e5c3b81cc2b8e6c"], "node": "51303f15331e66ef2ffa247e6a799d50fffc0ae4", "parents": ["e31a802a73f3de9d737830bc7254271ec9c30f8c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066941 - Update AndroidX Navigation3 to version 1.1.7. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321735\n", "files": ["gradle/libs.versions.toml"], "git_node": "d1789ccc1f2673260bc34cb340c1adbab866b4cd", "git_parents": ["cb310806c298ea79e187d0a53fcbadb177a609c2"], "node": "cca38d38b21c4e27664adf310d87e5672afc852b", "parents": ["51303f15331e66ef2ffa247e6a799d50fffc0ae4"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066941 - Update AndroidX Transition to version 1.7.1. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321736\n", "files": ["gradle/libs.versions.toml"], "git_node": "da9745a5037ae4f60b2e483b44f72864c067e6d0", "git_parents": ["d1789ccc1f2673260bc34cb340c1adbab866b4cd"], "node": "74b1d55fad4cd87184dda3830e448d4ec5d67921", "parents": ["cca38d38b21c4e27664adf310d87e5672afc852b"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044550 - Fix verifyExternalLinksTest UI test r=aaronmt\n\nThe `verifyExternalLinksTest` was flaking/failing intermittently due to live network delays.  \u2028The test tried to find the \"DuckDuckGo\" text in the rendered page content, so it genuinely waited for page to load. If the network was slow, it timed out and crashed waiting for the text to appear. \u2028\u2028\n\nTo avoid the network flakiness I swapped the external link to example.com instead of testing against the live production website.\n\nThe UI test successfully passed 100x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=84541  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320929\n", "files": ["mobile/android/focus-android/app/src/androidTest/assets/htmlControls.html", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/WebControlsTest.kt"], "git_node": "d6545f45cba9265453ec024614721784978b408c", "git_parents": ["da9745a5037ae4f60b2e483b44f72864c067e6d0"], "node": "bd518ccab9c728032bd5802978c3df606e9e56de", "parents": ["74b1d55fad4cd87184dda3830e448d4ec5d67921"], "tags": []}, {"author": "Alan Liu \u003chaoping.liu@amd.com\u003e", "branch": "default", "desc": "Bug 2011821 - Avoid per-frame texture create/release during direct scanout by locking without a GL context r=gfx-reviewers,lsalzman\n\nRenderCompositorNativeOGL::AttachExternalImage() unconditionally called\nimage-\u003eLock(0, mGL), which forces RenderDMABUFTextureHost::Lock to import the\ndecoded buffer as an EGLImage (DMABufSurfaceYUV::CreateTexture) and map the BO\ninto GPU VA, then release it the next frame -- two operations per frame.\nUnder direct scanout the frame goes straight to an overlay plane and this\ntexture is never sampled, so the work is pure overhead.\n\nPass nullptr instead: RenderDMABUFTextureHost::Lock then returns size-only\nmetadata without creating a texture. If direct scanout falls back to GPU\ncomposition, draw_frame re-Locks the host with a real GL context, so the\ntexture is still created when it is actually needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319435\n", "files": ["gfx/webrender_bindings/RenderCompositorNative.cpp"], "git_node": "c1b1a22b5d621278f507ae4155584b1ca677f490", "git_parents": ["d6545f45cba9265453ec024614721784978b408c"], "node": "336bad72e2467afd4c33fd8e20d55cf019801e71", "parents": ["bd518ccab9c728032bd5802978c3df606e9e56de"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065865 - Clip modal overlay to prevent corners overflowing browser rounded window r=desktop-theme-reviewers,tabbrowser-reviewers,nsharpley,hjones,omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321042\n", "files": ["browser/components/asrouter/tests/browser/browser_multistage_spotlight.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "6be1f311e984c1f7d344b96ea31e8a16af090d90", "git_parents": ["c1b1a22b5d621278f507ae4155584b1ca677f490"], "node": "3d42ca1c054493687800e0dfe4539c313f879dbb", "parents": ["336bad72e2467afd4c33fd8e20d55cf019801e71"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063785 - Union IB-split sibling rects in GetCombinedFragmentRects(). r=layout-reviewers,emilio\n\nThis allows an anchor element that is IB-split to return a correct\nunion rect so that anchor functions resolve against the anchor's\nentire bounding rect, rather than only the first inline fragment.\n\nThis patch follows Chrome's and Safari's behavior of unioning the\n`MozBlockInsideInlineWrapper` rects. That is, we do *not* drill into\nthe wrapper to find the rects of the real block children.\n`anchor-position-inline-008.html` tests that by adding explicit\n`width` to the block child under `anchor`.\n\nNote that calling `getBoundingClientRect()` for inline element that\nhas IB-split will drill into the block wrapper. This internal\ninconsistency is tracked in Bug 2066179.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321765\n", "files": ["layout/base/AnchorPositioningUtils.cpp", "testing/web-platform/tests/css/css-anchor-position/anchor-position-inline-008-ref.html", "testing/web-platform/tests/css/css-anchor-position/anchor-position-inline-008.html"], "git_node": "61f357d29efbfc78e66f0c0df190cef61d1d61da", "git_parents": ["6be1f311e984c1f7d344b96ea31e8a16af090d90"], "node": "f9494577f9d6c0789a56eff41ce093ae826b80b5", "parents": ["3d42ca1c054493687800e0dfe4539c313f879dbb"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2060235 - Look up proxy contexts by childId and actor. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319821\n", "files": ["toolkit/components/extensions/ExtensionParent.sys.mjs"], "git_node": "0a819607c3b8e1f838b5541b5ed91656f21fba05", "git_parents": ["61f357d29efbfc78e66f0c0df190cef61d1d61da"], "node": "719958650bc9532d92207a3495b0dafa8adf7ac1", "parents": ["f9494577f9d6c0789a56eff41ce093ae826b80b5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061865 - Fuzz text-layout-09.svg on macOS a bit.\n\nIt seems the cover is not quite enough and I can't repro this.\n\nSigned-off-by: Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e\n", "files": ["layout/reftests/svg/reftest.list"], "git_node": "e77d78282edb09571d751d2eba0a060c5c806ce0", "git_parents": ["0a819607c3b8e1f838b554