ting/testinfo.py", "testing/web-platform/interop.py", "testing/wpt_path_utils.py", "toolkit/components/gecko-trace/scripts/schema_parser.py", "toolkit/components/glean/build_scripts/glean_parser_ext/util.py", "toolkit/components/glean/build_scripts/perf_data_review.py", "toolkit/components/glean/build_scripts/translate_events.py", "toolkit/components/ml/eval/evals.py", "toolkit/components/nimbus/test/python/test_targeting_context_metrics.py", "toolkit/components/translations/bergamot-translator/build-bergamot.py", "toolkit/components/translations/tests/scripts/download-translations-artifacts.py", "tools/lint/cargo-audit/__init__.py", "tools/lint/clippy/__init__.py", "tools/tryselect/util/taskcluster.py", "xpcom/ds/tools/incremental_dafsa.py"], "git_node": "0d97f3e479291358d4b87919a93799898a7022f0", "git_parents": ["64d922ed4622d1a71edf22cc4e37f145da3e258b"], "node": "13c3d99052d69e2b8353560220d0afd5c89eb402", "parents": ["0cde33b7228f54e5cdd73b3740ea32d779cf88ee"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069656 - Enable `ruff` `FA102` to flag type annotations newer than the `py38` target r=linter-reviewers,sylvestre\n\n`FA102` reports `PEP 585` collections and `PEP 604` unions in modules without\n`from __future__ import annotations`. Those annotations are evaluated at\nimport time and raise on the Python versions the target still covers.\n\n`taskgraph`'s `msgspec` based `Schema` evaluates annotations at runtime and\ncannot take the future import, so both `taskgraph` packages ignore the rule.\n\n`keep-runtime-typing` stops `pyupgrade` from rewriting `Optional` and `Union`\nto the `PEP 604` spelling in the modules that gain the future import.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323865\n", "files": ["pyproject.toml"], "git_node": "bf88c2ebf17f1a509ffa323d0438504c8839b85a", "git_parents": ["0d97f3e479291358d4b87919a93799898a7022f0"], "node": "7f830eb9631bc4b70aacf6b98628829918349568", "parents": ["13c3d99052d69e2b8353560220d0afd5c89eb402"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069660 - Fix the lint errors in `toolkit/components/protobuf` files that are no longer treated as third-party r=linter-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323868\n", "files": ["toolkit/components/protobuf/moz.yaml", "toolkit/components/protobuf/scripts/generate_files.py", "toolkit/components/protobuf/scripts/prost_build_wrapper.rs", "toolkit/components/protobuf/scripts/protoc_wrapper.py"], "git_node": "f2128d2b97820c1f81160caa20a29e6fab33e535", "git_parents": ["bf88c2ebf17f1a509ffa323d0438504c8839b85a"], "node": "8b915dc5bb34f32ccf3890ada9f55f6c795ac6c9", "parents": ["7f830eb9631bc4b70aacf6b98628829918349568"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069660 - Only treat the vendored parts of `toolkit/components/protobuf` as third-party r=linter-reviewers,sylvestre\n\nThe vendored `protobuf` sources live under `src/` and `third_party/`. The scripts\nthat drive the vendoring, `moz.build`, `moz.yaml` and the `README` are maintained in\ntree and should be linted like the rest of it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323867\n", "files": ["tools/rewriting/ThirdPartyPaths.txt"], "git_node": "9a967dac83bf8b0b99fed7be6319b1258776489b", "git_parents": ["f2128d2b97820c1f81160caa20a29e6fab33e535"], "node": "60603f8a84dd5948fb151eb8c4469e1b719059ff", "parents": ["8b915dc5bb34f32ccf3890ada9f55f6c795ac6c9"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069661 - Load mozlint payload modules from the linter directory instead of importing them by name r=linter-reviewers,sylvestre\n\nPayload modules have generic names such as `rust`, `cpp` and `typescript`, and\n`__import__` returns whatever module of that name is already in `sys.modules` or\nearlier on `sys.path`. The `glean-parser` linter inserts `glean_parser_ext` at the\nfront of `sys.path` when it is imported, and that directory ships `rust.py`,\n`cpp.py` and `typescript.py`, so a worker that has run `glean-parser` fails the\n`rustfmt`, `mingw-capitalization` and `typescript` linters with 'module rust has no\nattribute lint' and 'cpp is not a package'. Loading the payload from the file\nnext to its definition under a private module name removes the collision.\n\nTests that patched a linter through `importlib.import_module` now take the\nmodule from the new `linter_module` fixture, since a bare import yields a copy\nthe linter never runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323869\n", "files": ["docs/code-quality/lint/create.md", "python/mozlint/mozlint/pathutils.py", "python/mozlint/mozlint/roller.py", "python/mozlint/mozlint/types.py", "python/mozlint/test/test_pathutils.py", "python/mozlint/test/test_roller.py", "tools/lint/test/conftest.py", "tools/lint/test/test_agent_skills_sync.py", "tools/lint/test/test_condprof_addons.py"], "git_node": "d1cd48cd3ab49af6dd7bf5a0b3a7a724ab3deeb2", "git_parents": ["9a967dac83bf8b0b99fed7be6319b1258776489b"], "node": "b882eb2222cf06eaa5a4b3eaa519f156530f453a", "parents": ["60603f8a84dd5948fb151eb8c4469e1b719059ff"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069655 - Return an empty result when a global linter has no files to lint r=linter-reviewers,sylvestre\n\n`GlobalType._lint` returned `None` once `expand_exclusions` had filtered every path\naway, which the roller reports as 'Unexpected result type received' and counts\nas a failed linter. That happens whenever a global linter such as clang-format\nis handed a directory with no matching files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323870\n", "files": ["python/mozlint/mozlint/types.py", "python/mozlint/test/test_types.py"], "git_node": "a5431ba4a089dd0ca56f02fc676d0a08565cf59d", "git_parents": ["d1cd48cd3ab49af6dd7bf5a0b3a7a724ab3deeb2"], "node": "7ba9fe9b4ccafff1130d8f915bd0dbbf1df2a418", "parents": ["b882eb2222cf06eaa5a4b3eaa519f156530f453a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2069707. Put protobuf's generated_message_util.h back to what upstream ships. r=firefox-build-system-reviewers,sylvestre DONTBUILD\n\nTwo tree-wide sweeps changed this file when it should have been ignored as being listed in tools/rewriting/ThirdPartyPaths.txt (bug 2064119 and bug 2065399).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323905\n", "files": ["toolkit/components/protobuf/src/google/protobuf/generated_message_util.h"], "git_node": "60d5fa384e549eff9500244a7d3bd7553516738e", "git_parents": ["a5431ba4a089dd0ca56f02fc676d0a08565cf59d"], "node": "74382d91901855b8c88f406bb38c05d0481283cd", "parents": ["7ba9fe9b4ccafff1130d8f915bd0dbbf1df2a418"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2067195 - file-info reviewers: recognise reviewer groups without the \"#\" prefix. r=shtrom\n\n`parse_reviewers_from_subjects` treated the \"#\" prefix as the only group\nmarker. Phabricator uses it, but it is stripped when a revision lands, so a\nlanded commit message reads `r=necko-reviewers`, indistinguishable from a nick\nby that test: only 9 of the last 40007 `r=` commits carry a \"#\". `recent_groups`\nwas therefore always empty and groups were reported as individuals, e.g.\n`mach file-info reviewers mfbt` listed `media-playback-reviewers (15)` among\nreal people.\n\nClassify a name as a group when it carries \"#\" or matches a group known from\nthe Herald rules or from mots `meta.review_group`, both of which the command\nhas already loaded by that point. An unknown `-reviewers` name is still an\nindividual, since the suffix is a convention rather than a marker.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321887\n", "files": ["python/mozbuild/mozbuild/frontend/mach_commands.py", "python/mozbuild/mozbuild/frontend/reviewers.py", "python/mozbuild/mozbuild/test/frontend/test_file_info_reviewers.py"], "git_node": "88ea377fab582720cb6a45525bdf29ac4eeb0194", "git_parents": ["60d5fa384e549eff9500244a7d3bd7553516738e"], "node": "9a772c4cafa4395d2ada89cc3e373fe9f9612b4a", "parents": ["74382d91901855b8c88f406bb38c05d0481283cd"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068160 - Part 6 - Expand a surface's culling rect by what its filter samples. r=gw\n\nupdate_culling_rect only inflated for a blur. A drop shadow and an SVG filter\ngraph also read outside their own destination, so a primitive that is off-screen\nitself but whose shadow lands on screen sat outside the culling rect its surface\nis culled against - and get_clip_result_complex rejects a primitive whose rect\ndoes not intersect the culling rect, so a transformed clip could drop it.\n\nget_required_source_rect is the inverse of get_coverage: the region of a\nsurface's own space needed to produce a given region of its output. A blur that\ndoesn't inflate is left alone; it is a backdrop filter, whose source is the\ncaptured backdrop rather than primitives drawn into the surface.\n\nA mapping that can't be computed now falls back to culling nothing rather than\nleaving the un-expanded rect in place, which is the rect that culls the content\nthe expansion exists to keep.\n\nA wider culling rect keeps primitives that used to be culled before their clips\nwere looked at, which exposes a latent crash in prepare_tiles: it asks the\nspatial tree for the transform from each clip into the surface's raster space,\nand a clip sitting outside the 3D context that established that raster root has\nno such transform. Relative transforms are only built walking towards the root,\nso the spatial tree asserts instead of answering. can_get_relative_transform\nreports whether the transform exists, and a clip without one takes the same\nconservative path as a non-axis-aligned clip. reftests/filters/blend-clipped.yaml\nhits this, and its reference image is updated for the content the wider culling\nrect keeps.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322974\n", "files": ["gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/wrench/reftests/filters/blend-clipped.png"], "git_node": "c7a8b537a1af1f9132ac07751e52528a636ffc20", "git_parents": ["88ea377fab582720cb6a45525bdf29ac4eeb0194"], "node": "08f2f98a0d2a6ca72254c048e083bb40cfe94901", "parents": ["9a772c4cafa4395d2ada89cc3e373fe9f9612b4a"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066150 - Remove legacy security telemetry probes r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321206\n", "files": ["browser/components/metrics.yaml", "dom/security/metrics.yaml", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json", "toolkit/content/metrics.yaml"], "git_node": "df61c46d8f6e910568dae02bc5de37d5fbf660f5", "git_parents": ["c7a8b537a1af1f9132ac07751e52528a636ffc20"], "node": "9fddb575343645c6cbc361b0b022f4348ed354b9", "parents": ["08f2f98a0d2a6ca72254c048e083bb40cfe94901"], "tags": []}, {"author": "Chris Vander Linden \u003ccvanderl@uiowa.edu\u003e", "branch": "default", "desc": "Bug 1941575 - Reuse shared FileSearchBar in Netmonitor SourcePreview. r=bomsy,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310553\n", "files": ["devtools/client/locales/en-US/components.properties", "devtools/client/netmonitor/src/assets/styles/NetworkDetailsBar.css", "devtools/client/netmonitor/src/assets/styles/netmonitor.css", "devtools/client/netmonitor/src/components/previews/SourcePreview.js", "devtools/client/netmonitor/src/utils/build-query.js", "devtools/client/netmonitor/src/utils/moz.build", "devtools/client/netmonitor/src/workers/search/index.js", "devtools/client/netmonitor/src/workers/search/search.js", "devtools/client/netmonitor/src/workers/search/worker.js", "devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/netmonitor/test/browser_net_large-response.js", "devtools/client/netmonitor/test/browser_net_source-preview-search.js", "devtools/client/shared/components/SearchInput.css", "devtools/client/shared/components/SearchInput.js"], "git_node": "dc5ce43c496e3dd5b594934a3bd24bd52e3e0162", "git_parents": ["df61c46d8f6e910568dae02bc5de37d5fbf660f5"], "node": "aad0fb788196c7c7000d3d1502e4508074742640", "parents": ["9fddb575343645c6cbc361b0b022f4348ed354b9"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069707. Put protobuf's generated_message_util.h back to what upstream ships. r=firefox-build-system-reviewers,sylvestre DONTBUILD\" for causing bustages in generated_message_util.h\n\nThis reverts commit 60d5fa384e549eff9500244a7d3bd7553516738e.\n", "files": ["toolkit/components/protobuf/src/google/protobuf/generated_message_util.h"], "git_node": "8555be833514e7b48d82997e4682df69cf3e699c", "git_parents": ["dc5ce43c496e3dd5b594934a3bd24bd52e3e0162"], "node": "532e3c6e11e2e7d2b548225540a2e152d7699af9", "parents": ["aad0fb788196c7c7000d3d1502e4508074742640"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2069578 - Move the mel buffer into the 1-item MelBatch in vendored parakeet.cpp (Coverity CIDs 1700839, 1700842) r=media-playback-reviewers,padenot\n\ntranscribe_16k and transcribe_16k_with_timestamps both copied feats into\nmb1.data on the long-audio path, where feats is n_mels * T floats (tens of MB\nfor minutes of audio) and is dead after the assignment.\n\nCarried as parakeet-move-mel-batch.patch so it survives re-vendoring; it should\ngo upstream to mudler/parakeet.cpp and be dropped once it lands there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323831\n", "files": ["third_party/parakeet.cpp/moz.yaml", "third_party/parakeet.cpp/parakeet-move-mel-batch.patch", "third_party/parakeet.cpp/src/model.cpp"], "git_node": "8e67ec05999daa1885a85a9d9edae084b20f3811", "git_parents": ["8555be833514e7b48d82997e4682df69cf3e699c"], "node": "eae40bd23d4fbea6f062392a2b3d2b683782456b", "parents": ["532e3c6e11e2e7d2b548225540a2e152d7699af9"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066833 - New compose-menu module r=android-reviewers,giorga\n\nBasic configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322349\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/compose/menu/README.md", "mobile/android/android-components/components/compose/menu/build.gradle", "mobile/android/android-components/components/compose/menu/lint-baseline.xml", "mobile/android/android-components/components/compose/menu/src/main/AndroidManifest.xml", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/Menu.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/MenuTest.kt", "mobile/android/android-components/components/compose/menu/src/test/resources/robolectric.properties", "taskcluster/config.yml"], "git_node": "a3030db3f1a7e574dea0800d30179c8c54032adb", "git_parents": ["8e67ec05999daa1885a85a9d9edae084b20f3811"], "node": "e06db7d785bc0480fcf3933ffaea099c853c1702", "parents": ["eae40bd2