ce3e47d16", "parents": ["c7be216313ac5ab235c92b5515faa4438df4bb45"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067908 - Copy link should only be focused when the button is toggled via the keyboard. r=nbarrett,jprickett\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322421\n", "files": ["browser/components/sharing/SharePageAction.sys.mjs"], "git_node": "a471b581cca7ebdeb5a2d61e5d50334bc2a12c4a", "git_parents": ["4d31a600135def460d96d844c96b8b044a29e4c5"], "node": "350a2faa0314c83c7d17c5b15d17dcb600a7dd13", "parents": ["9773fd6e6b9be6992e22b1badfdcabece3e47d16"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066745 - Subtract the splitview wrapper padding when calculating the min-height for tabs. r=kcochrane,desktop-theme-reviewers,tabbrowser-reviewers\n\n- And restore some of the label-height fix from bug 2006018\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322434\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview_tab_height.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "175c04035337626df50c51334659b18d9f5c9dc8", "git_parents": ["a471b581cca7ebdeb5a2d61e5d50334bc2a12c4a"], "node": "3b2e4d6627dbf9ec636aceccecdd21132a2b6404", "parents": ["350a2faa0314c83c7d17c5b15d17dcb600a7dd13"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Make webcompat tasks clone with Git, r=taskgraph-reviewers,twisniewski,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322559\n", "files": ["taskcluster/kinds/source-test/webcompat.yml"], "git_node": "98f4625e27fc42adfce99ad325a8d8a51378546e", "git_parents": ["175c04035337626df50c51334659b18d9f5c9dc8"], "node": "af7232b9c7546d353bf4fc472215b23a7ccad62a", "parents": ["3b2e4d6627dbf9ec636aceccecdd21132a2b6404"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061701 - Only corner browserContainer in AI windows when there's chrome between it and the window edge. r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321741\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "8d3ed82c90e620a77eb3c3c844d498a058f8b065", "git_parents": ["98f4625e27fc42adfce99ad325a8d8a51378546e"], "node": "39439133bcc3a6db104b4b1d8d30eda0e86c1e05", "parents": ["af7232b9c7546d353bf4fc472215b23a7ccad62a"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068106 - Open the Organize Tabs panel when its button is in the overflow menu r=Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322643\n", "files": ["browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js"], "git_node": "91faa3ebf838da9e43a58ca00f7967dd3b88ff54", "git_parents": ["8d3ed82c90e620a77eb3c3c844d498a058f8b065"], "node": "7e888473655824b77486da4baf59dd22a8494526", "parents": ["39439133bcc3a6db104b4b1d8d30eda0e86c1e05"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050157 - Restore select-control container roles. r=hjones\n\nBug 2037052 stopped the host from supplying its child container role.\nNow we move that role to the inner fieldset and set the role\naccordingly.\n\nEven though role=\"listbox|tablist\" is technically not allowed on a\nfieldset element (WCAG spec), we allow that assignment because in Gecko\nthe role assignment gives functionally correct semantics and behavior.\nSee Bug 2050157 Comment 10 for more info.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319621\n", "files": ["toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/test_moz_radio_group.html", "toolkit/content/tests/widgets/test_moz_visual_picker.html", "toolkit/content/tests/widgets/test_segmented_control.html", "toolkit/content/widgets/lit-select-control.mjs", "toolkit/content/widgets/moz-fieldset/moz-fieldset.mjs", "toolkit/content/widgets/moz-segmented-control/moz-segmented-control.mjs"], "git_node": "567d5a448503b91f7cd87ed69046dfc48367e464", "git_parents": ["91faa3ebf838da9e43a58ca00f7967dd3b88ff54"], "node": "2f0c2e1af23842c961acc06c0c11a5d9a3c07d73", "parents": ["7e888473655824b77486da4baf59dd22a8494526"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050157 - Name about:preferences radio groups. r=accessibility-frontend-reviewers,fluent-reviewers,hjones,bolsson,morgan\n\nSettings config now passes each setting group's Fluent ID to\nmoz-radio-group. This allows the inner `radiogroup` to have a localized\nname, which is required by the ARIA spec. The migration reuses the\nexisting section labels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321098\n", "files": ["browser/components/preferences/config/about-firefox.mjs", "browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_selection.js", "browser/components/preferences/tests/browser_updates_managed_by_os.js", "browser/components/preferences/tests/etp/browser_etp_advanced.js", "browser/components/preferences/tests/head-common.js", "browser/components/preferences/tests/privacy/browser_privacy_dnsoverhttps_policy_srd.js", "browser/components/preferences/tests/privacy/browser_privacy_history_search_l10n_ids.js", "browser/locales/en-US/browser/aiFeatures.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "python/l10n/fluent_migrations/bug_2050157_preferences_radio_group_accessible_names.py"], "git_node": "abb5f5a6f02ecd82c1372d72f770284de73e0da8", "git_parents": ["567d5a448503b91f7cd87ed69046dfc48367e464"], "node": "570bbd4af00a73e27124d18a84d0fed5c9d3c594", "parents": ["2f0c2e1af23842c961acc06c0c11a5d9a3c07d73"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067315 - Use Widevine plugin with the web-platform-eme tests. r=taskgraph-reviewers,releng-reviewers,media-playback-reviewers,padenot,bhearsum\n\nThis patch stores the Widevine artifacts under the private prefix\nto avoid accidental distribution of the plugin. It adds a new fetch\nscript to handle the crx3 format, and flattening of the archive to\ncache it in a form immediately usable by Firefox. Similarly to the\nOpenH264 plugin, the harness will search for a Widevine artifact in\nits fetches paths, and if found, will substitute it for the fake\nCDM we use by default in CI.\n\nThis causes many WPT tests to pass across desktop. As part of this\neffort, it also enables WPT tests that were already passing on\nAndroid but were never enabled due to the inability to access the\nlicense server from CI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322143\n", "files": ["taskcluster/docker/fetch-more/Dockerfile", "taskcluster/gecko_taskgraph/transforms/fetch.py", "taskcluster/kinds/fetch/kind.yml", "taskcluster/kinds/fetch/widevine.yml", "taskcluster/kinds/web-platform-tests/kind.yml", "taskcluster/scripts/misc/fetch-crx3.py", "testing/mozharness/scripts/web_platform_tests.py", "testing/web-platform/meta/encrypted-media/clearkey-check-status-for-hdcp.https.html.ini", "testing/web-platform/meta/encrypted-media/clearkey-events-session-closed-event.https.html.ini", "testing/web-platform/meta/encrypted-media/clearkey-events.https.html.ini", "testing/web-platform/meta/encrypted-media/clearkey-generate-request-disallowed-input.https.html.ini", "testing/web-platform/meta/encrypted-media/clearkey-invalid-licens