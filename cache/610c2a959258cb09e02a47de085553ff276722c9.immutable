\"\n\nThis reverts commit 44655123d86d3af35e1cafc22c854e8bc9361169.\n\nRevert \"Bug 1945032 - Perform visibility checks on HTML elements with accesskeys in the chrome r=masayuki,mkennedy\"\n\nThis reverts commit cd003d027f70791eae25fea2e03babdf639cf976.\n", "files": ["browser/components/preferences/widgets/sync-device-name/sync-device-name.mjs", "dom/events/EventStateManager.cpp", "dom/events/test/chrome.toml", "dom/events/test/mochitest.toml", "dom/events/test/test_accesskey_visibility.html", "dom/events/test/test_accesskey_visibility_content.html", "toolkit/content/net-error-card.mjs", "toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/widgets/moz-button/moz-button.mjs", "toolkit/content/widgets/moz-button/moz-button.stories.mjs", "toolkit/content/widgets/moz-input-folder/moz-input-folder.mjs"], "git_node": "d247ce1c4d4becbf04171535c1d907a4b50fb0a6", "git_parents": ["22b699e37fe631d5085c0bd498771bce9addafed"], "node": "6b4d456bba797282501e69d40c15ac08088d8c0b", "parents": ["032fb5f20606b10a67a7eda663a2de800c509814"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067887: Always clear pending exception in regexp fuzzer r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322544\n", "files": ["js/src/fuzz-tests/testRegExp.cpp"], "git_node": "7bb52771751b09a9e2f1f306c02c89d90ac666b6", "git_parents": ["d247ce1c4d4becbf04171535c1d907a4b50fb0a6"], "node": "c4e6e81bd3b3e3a95b6894e9316ba33f8ab93b58", "parents": ["6b4d456bba797282501e69d40c15ac08088d8c0b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068166 - Stop reading the chrome-only composedTarget when handling mousedown. r=mbeier\n\n`composedTarget` is chrome-only, so it reads as undefined in the page's realm and the handler broke out before opening the view. The two reads differ only for a mousedown inside a descendant's shadow tree -- a `moz-button` -- which is neither of the nodes compared against, since `composedTarget` resolves the input's own anonymous content to the input itself.\n\nThis was leftover from the abandoned attempt to use shadow DOM in bug 1986130.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322683\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_mousedown.js"], "git_node": "5d8939058baefd25756ebbadb5f9b7b3b2cca72f", "git_parents": ["7bb52771751b09a9e2f1f306c02c89d90ac666b6"], "node": "c317c83e1401795fec3033aea2ad5582f224d392", "parents": ["c4e6e81bd3b3e3a95b6894e9316ba33f8ab93b58"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062795 - tweak checkbox and radio styles for Nova r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319284\n", "files": ["layout/reftests/box-shadow/1212823-2-ref.html", "layout/reftests/box-shadow/reftest.list", "layout/reftests/forms/input/checkbox/reftest.list", "layout/reftests/image-element/reftest.list", "widget/Theme.cpp"], "git_node": "3b09a9f7dc3c6cd0f0c25dcb058100fef4621c6f", "git_parents": ["5d8939058baefd25756ebbadb5f9b7b3b2cca72f"], "node": "d05f7f8ce6fabf8bb09affb966164dac74964f6c", "parents": ["c317c83e1401795fec3033aea2ad5582f224d392"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067890 - Enable ungrouping tab groups to default r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322648\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabManagementFeatureHelper.kt"], "git_node": "04de23b8f3fb83519ba61e41908a136f8fcc3ce8", "git_parents": ["3b09a9f7dc3c6cd0f0c25dcb058100fef4621c6f"], "node": "7ad704d3d32f8898c667269e6e03554204e007f6", "parents": ["d05f7f8ce6fabf8bb09affb966164dac74964f6c"], "tags": []}, {"author": "Jens Manuel Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066420 - Pass the untruncated update.status to pingStateAndStatusCodes() on the startup path. r=application-update-reviewers,cdupuis,yjuglaret\n\n`#asyncInit()` split `update.status` and reassigned `status = statusParts[0]`\nimmediately after `readStatusFile()`, so the truncated state (ex. `\"failed\"`\ninstead of `\"failed: 7\"`) was what reached `pingStateAndStatusCodes()`. There the\nerror-code ping was gated on `parts.length \u003e 1`, which is never true for a status\nread off disk, so `AUSTLMY.pingStatusErrorCode()` was unreachable and\n`update.status_error_code_{complete,partial,unknown}_startup` only ever recorded\nthe three codes UpdateService.sys.mjs synthesizes itself (90, 91, 92).\n\nBug 1928229 introduced this by moving the split from after the ping call to the\ntop of `#asyncInit`. The staged path was unaffected because\n`#refreshUpdateStatus()` still pings before splitting.\n\nKeep the untruncated string as `fullStatus` and pass that at the ping call site.\nAll the `switch (status)` / `status ==` comparisons and `statusParts[1]` uses are\nunchanged.\n\nAlso key the error-code ping on `parts[0] == STATE_FAILED` rather than\n`parts.length \u003e 1`, so a failed status carrying no code records\nINVALID_UPDATER_STATUS_CODE instead of recording nothing. That matches what\n`#refreshUpdateStatus()` already does for `update.errorCode`, and it means a\nfuture re-truncation shows up in the data instead of silently emptying the probe.\n\nAdds `statusErrorCodeTelemetry.js`, which asserts the recorded samples for a\npartial and a complete patch, for a `failed` status with no code, and for a\nnon-failed status. Nothing in the tree asserted these probes before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321460\n", "files": ["toolkit/mozapps/update/UpdateService.sys.mjs", "toolkit/mozapps/update/tests/data/sharedUpdateXML.js", "toolkit/mozapps/update/tests/unit_aus_update/statusErrorCodeTelemetry.js", "toolkit/mozapps/update/tests/unit_aus_update/xpcshell.toml"], "git_node": "c5b820ff2995317539c6c4c877084dd13dac4eef", "git_parents": ["04de23b8f3fb83519ba61e41908a136f8fcc3ce8"], "node": "46bf8c71ca4e4529af46680b7598e5455a19f232", "parents": ["7ad704d3d32f8898c667269e6e03554204e007f6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067353 - Use paired color tokens in the urlbar box and the Report Broken Site rows r=hjones,desktop-theme-reviewers\n\nThe urlbar box change is value-neutral: `--urlbar-box-text-color-active` resolves to the base text color outside Nova, and under Nova the ghost hover and active text tokens it borrows from are defined identically in both the prefers-contrast and the forced-colors branch.\n\nThe Report Broken Site rows do change: on Windows and macOS without a native theme and with Nova off, their light-mode text goes from #15141A to #000000, matching the menu rows around them, which set the same pair.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322045\n", "files": ["browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/identity-block/identity-block.css", "browser/themes/shared/urlbar.css", "browser/themes/shared/urlbar/urlbar.tokens.css", "browser/themes/shared/urlbar/urlbar.tokens.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs"], "git_node": "43a055e978922199976662939d30da3ac1957854", "git_parents": ["c5b820ff2995317539c6c4c877084dd13dac4eef"], "node": "97551e0d190cefd87fa8daf12512848d7dda30e0", "parents": ["46bf8c71ca4e4529af46680b7598e5455a19f232"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067353 - Stylelint: create the use-paired-color-tokens rule r=hjones,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322044\n", "files": [".stylelintrc.js", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-paired-color-tokens.md", "tools/lint/stylelint/stylelint-plugin-mozilla/helpers.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/index.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/no-base-design-tokens.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/use-paired-color-tokens.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.tests.mjs"], "git_node": "80d8aa0e89b56aca734b43cdbf37531222b2287d", "git_parents": ["43a055e978922199976662939d30da3ac1957854"], "node": "b7b39df537c1ddc907d4363aa73d8220b5bfba44", "parents": ["97551e0d190cefd87fa8daf12512848d7dda30e0"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "No bug - update vendoring documentation to indicate responsibilities when vendoring code, r=tjr,leggert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321517\n", "files": ["python/mozbuild/mozbuild/vendor/docs/index.md"], "git_node": "646eed10c2e4a81a20e68bf75a759fb29de42e8b", "git_parents": ["80d8aa0e89b56aca734b43cdbf37531222b2287d"], "node": "bd724c457347e6d9c41f8414240019591eb91c86", "parents": ["b7b39df537c1ddc907d4363aa73d8220b5bfba44"], "tags": []}, {"author": "Nishu Sheth \u003cnsheth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921535 - Implement ASWebAuthenticationSessionWebBrowserSessionHandling in Firefox for macOS r=sthompson,mac-reviewers,firefox-desktop-core-reviewers ,spohl,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297673\n", "files": ["browser/app/generate_info_plist.py", "browser/app/macbuild/Contents/Info.plist.in", "browser/base/content/browser-init.js", "browser/components/BrowserComponents.manifest", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/modules/ASWebAuthSessionService.sys.mjs", "browser/modules/URILoadingHelper.sys.mjs", "browser/modules/components.conf", "browser/modules/moz.build", "browser/modules/test/browser/browser.toml", "browser/modules/test/browser/browser_aswebauth_form.sjs", "browser/modules/test/browser/browser_aswebauth_session.js", "toolkit/xre/ASWebAuthSessionHandler.h", "toolkit/xre/ASWebAuthSessionHandler.mm", "toolkit/xre/MacApplicationDelegate.mm", "toolkit/xre/moz.build", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsIASWebAuthSessionRequest.idl"], "git_node": "3ee4c7d28b5ce41041f7bf854504921a7785ac30", "git_parents": ["646eed10c2e4a81a20e68bf75a759fb29de42e8b"], "node": "9b6100efbf3b94c691aebff9545f81a0208c5fa7", "parents": ["bd724c457347e6d9c41f8414240019591eb91c86"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2001695 - Ignore tooltip mouseouts from nodes we aren't tracking, r=layout-reviewers,emilio.\n\nnsXULTooltipListener is a process-wide singleton, so a mouseout belonging to\none chrome document cancels the tooltip timer armed for a node in another\nwindow. On Windows the mouse exit of the window below a newly created window\narrives just after the new window has started hovering something, so the\ntooltip never appears and nothing re-arms the timer.\n\nKeying the listener's state per top-level chrome window is the general fix and\nis left to bug 2067142; this guards the one path where the cross-window\ncancellation is user-visible.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321922\n", "files": ["layout/xul/nsXULTooltipListener.cpp", "toolkit/content/tests/chrome/chrome-nova.toml", "toolkit/content/tests/chrome/chrome.toml"], "git_node": "1201fa6527edc1057103e8ccf8796c6a061afee1", "git_parents": ["3ee4c7d28b5ce41041f7bf854504921a7785ac30"], "node": "3bfa78cb60f71f20cc401d227e0cdca8a27490ef", "parents": ["9b6100efbf3b94c691aebff9545f81a0208c5fa7"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2066477 - Update nss-rs to 0.14.6 r=necko-reviewers,leggert\n\nBump the vendored nss-rs (and its test-fixture crate) from 0.13.4 to\n0.14.6, which the neqo v0.31.0 update requires.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321287\n", "files": ["Cargo.lock", "netwerk/socket/neqo_glue/Cargo.toml", "security/lockstore/lockstore_rs/Cargo.toml", "security/mls/mls_gk/Cargo.toml", "third_party/rust/nss-rs/.cargo-checksum.json", "third_party/rust/nss-rs/Cargo.lock", "third_party/rust/nss-rs/Cargo.toml", "third_party/rust/nss-rs/README.md", "third_party/rust/nss-rs/build.rs", "third_party/rust/nss-rs/install-nss/action.yml", "third_party/rust/nss-rs/min_version.txt", "third_party/rust/nss-rs/src/constants.rs", "third_party/rust/nss-rs/src/ec.rs", "third_party/rust/nss-rs/src/ech.rs", "third_party/rust/nss-rs/src/hp/header_protection.rs", "third_party/rust/nss-rs/src/hp/header_protection_blapi.rs", "third_party/rust/nss-rs/src/lib.rs", "third_party/rust/nss-rs/src/min_version.rs", "third_party/rust/nss-rs/tests/ec.rs", "third_party/rust/nss-rs/tests/handshake.rs", "third_party/rust/test-fixture/.cargo-checksum.json", "third_party/rust/test-fixture/Cargo.toml"], "git_node": "c2f2ad954c989164fe4c2f8c9e9667066ffe4aae", "git_parents": ["1201fa6527edc1057103e8ccf8796c6a061afee1"], "node": "8c5b5e95f36d633450dc2cfc32d30ccd2558e5f9", "parents": ["3bfa78cb60f71f20cc401d227e0cdca8a27490ef"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2066480 - Update mls-platform-api to eb1c880 r=supply-chain-reviewers,leggert,afranchuk\n\nBump mls-platform-api so mls-rs-crypto-nss builds against nss-rs 0.14.\nAdd a git-delta audit for mls-rs-provider-sqlite.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321289\n", "files": [".cargo/config.toml.in", "Cargo.lock", "security/mls/mls_gk/Cargo.toml", "supply-chain/audits.toml", "third_party/rust/mls-rs-crypto-nss/.cargo-checksum.json", "third_party/rust/mls-rs-crypto-nss/Cargo.toml"], "git_node": "58debe32e9c26f104af9d1feb0f5bb3d0047313c", "git_parents": ["c2f2ad954c989164fe4c2f8c9e9667066ffe4aae"], "node": "9d876e1311cc7eaea8f53dbaf6b98418ef96fb2e", "parents": ["8c5b5e95f36d633450dc2cfc32d30ccd2558e5f9"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2065405 - Update neqo to v0.31.1 r=necko-reviewers,supply-chain-reviewers,leggert,kershaw,afranchuk\n\nBump the vendored neqo crates from v0.30.1 to v0.31.1 (mozilla/neqo#3880)\nand adapt neqo_glue: drop the HTTP/3 server-push handling neqo removed,\nmap the new TooManyPtos transport error, and read cwnd as a plain value.\nAdd a git-delta audit for mtu, a neqo workspace crate.\n\nAlso strip connection-specific header fields when http3server forwards a\nresponse over HTTP/3: neqo v0.31.1 (mozilla/neqo#3806) rejects them as\nmalformed per RFC 9114, Section 4.2, which otherwise breaks the h3\nxpcshell tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321290\n", "files": [".cargo/config.toml.in", "Cargo.lock", "netwerk/socket/neqo_glue/Cargo.toml", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/http3server/Cargo.toml", "netwerk/test/http3server/src/main.rs", "supply-chain/audits.toml", "third_party/rust/mtu/.cargo-checksum.json", "third_party/rust/mtu/Cargo.toml", "third_party/rust/mtu/build.rs", "third_party/rust/neqo-bin/.cargo-checksum.json", "third_party/rust/neqo-bin/Cargo.toml", "third_party/rust/neqo-bin/benches/main.rs", "third_party/rust/neqo-bin/build.rs", "third_party/rust/neqo-bin/src/client/http3.rs", "third_party/rust/neqo-bin/src/client/mod.rs", "third_party/rust/neqo-bin/src/server/mod.rs", "third_party/rust/neqo-common/.cargo-checksum.json", "third_party/rust/neqo-common/Cargo.toml", "third_party/rust/neqo-common/benches/decoder.rs", "third_party/rust/neqo-common/src/log.rs", "third_party/rust/neqo-http3/.cargo-checksum.json", "third_party/rust/neqo-http3/Cargo.toml", "third_party/rust/neqo-http3/benches/common.rs", "third_party/rust/neqo-http3/src/client_events.rs", "third_party/rust/neqo-http3/src/conn_params.rs", "third_party/rust/neqo-http3/src/connect_udp.rs", "third_party/rust/neqo-http3/src/connection.rs", "third_party/rust/neqo-http3/src/connection_client.rs", "third_party/rust/neqo-http3/src/connection_server.rs", "third_party/rust/neqo-http3/src/control_stream_local.rs", "third_party/rust/neqo-http3/src/features/extended_connect/mod.rs", "third_party/rust/neqo-http3/src/features/extended_connect/session.rs", "third_party/rust/neqo-http3/src/features/extended_connect/stats.rs", "third_party/rust/neqo-http3/src/features/extended_connect/tests/webtransport/datagrams.rs", "third_party/rust/neqo-http3/src/features/extended_connect/tests/webtransport/mod.rs", "third_party/rust/neqo-http3/src/features/extended_connect/tests/webtransport/negotiation.rs", "third_party/rust/neqo-http3/src/features/extended_connect/tests/webtransport/sessions.rs", "third_party/rust/neqo-http3/src/features/extended_connect/webtransport_session.rs", "third_party/rust/neqo-http3/src/features/mod.rs", "third_party/rust/neqo-http3/src/frames/hframe.rs", "third_party/rust/neqo-http3/src/frames/reader.rs", "third_party/rust/neqo-http3/src/frames/tests/hframe.rs", "third_party/rust/neqo-http3/src/frames/tests/mod.rs", "third_party/rust/neqo-http3/src/frames/tests/reader.rs", "third_party/rust/neqo-http3/src/headers_checks.rs", "third_party/rust/neqo-http3/src/lib.rs", "third_party/rust/neqo-http3/src/priority.rs", "third_party/rust/neqo-http3/src/push_controller.rs", "third_party/rust/neqo-http3/src/push_id.rs", "third_party/rust/neqo-http3/src/recv_message.rs", "third_party/rust/neqo-http3/src/server.rs", "third_party/rust/neqo-http3/src/settings.rs", "third_party/rust/neqo-http3/src/stream_type_reader.rs", "third_party/rust/neqo-http3/src/webtransport.rs", "third_party/rust/neqo-http3/tests/connect_udp.rs", "third_party/rust/neqo-http3/tests/httpconn.rs", "third_party/rust/neqo-http3/tests/webtransport.rs", "third_party/rust/neqo-qpack/.cargo-checksum.json", "third_party/rust/neqo-qpack/Cargo.toml", "third_party/rust/neqo-qpack/src/header_block.rs", "third_party/rust/neqo-transport/.cargo-checksum.json", "third_party/rust/neqo-transport/Cargo.toml", "third_party/rust/neqo-transport/benches/frame_decode.rs", "third_party/rust/neqo-transport/benches/pacer.rs", "third_party/rust/neqo-transport/benches/packet_codec.rs", "third_party/rust/neqo-transport/benches/range_tracker.rs", "third_party/rust/neqo-transport/benches/rx_stream_orderer.rs", "third_party/rust/neqo-transport/benches/send_streams.rs", "third_party/rust/neqo-transport/benches/sent_packets.rs", "third_party/rust/neqo-transport/benches/transfer_common.rs", "third_party/rust/neqo-transport/src/cc/classic_cc.rs", "third_party/rust/neqo-transport/src/connection/mod.rs", "third_party/rust/neqo-transport/src/connection/params.rs", "third_party/rust/neqo-transport/src/connection/tests/handshake.rs", "third_party/rust/neqo-transport/src/connection/tests/idle.rs", "third_party/rust/neqo-transport/src/connection/tests/keys.rs", "third_party/rust/neqo-transport/src/connection/tests/recovery.rs", "third_party/rust/neqo-transport/src/connection/tests/reset_stream_at.rs", "third_party/rust/neqo-transport/src/crypto.rs", "third_party/rust/neqo-transport/src/fc.rs", "third_party/rust/neqo-transport/src/lib.rs", "third_party/rust/neqo-transport/src/packet/mod.rs", "third_party/rust/neqo-transport/src/path.rs", "third_party/rust/neqo-transport/src/recovery/mod.rs", "third_party/rust/neqo-transport/src/recv_stream.rs", "third_party/rust/neqo-transport/src/sender.rs", "third_party/rust/neqo-transport/src/stats.rs", "third_party/rust/neqo-transport/src/tparams.rs", "third_party/rust/neqo-udp/.cargo-checksum.json", "third_party/rust/neqo-udp/Cargo.toml", "third_party/rust/neqo-udp/build.rs"], "git_node": "5e85ddf82ef88fb56819c91852e4956d70a21f1a", "git_parents": ["58debe32e9c26f104af9d1feb0f5bb3d0047313c"], "node": "2e863fd126292b0fd0c3b1c5ecc56c121590fca7", "parents": ["9d876e1311cc7eaea8f53dbaf6b98418ef96fb2e"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2067385 - Fix the LICENSE path in the pdf.js vendoring script r=tjr\n\n`gulp mozcentral` writes LICENSE to the pdf.js root, while the vendoring script looked in its `content/` subdirectory. This became a hard failure when bug 2064447 enabled `set -e`.\n\nAlso remove two workarounds that could hide vendoring failures: `|| true` on the .ftl copy and creation of the source directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322059\n", "files": ["toolkit/components/pdfjs/update.sh"], "git_node": "cf77bcf6f414ae15aec8d647e7eb01145dd77a00", "git_parents": ["5e85ddf82ef88fb56819c91852e4956d70a21f1a"], "node": "2c55d6483d4b2f5d1badb466227702c0617f6772", "parents": ["2e863fd126292b0fd0c3b1c5ecc56c121590fca7"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2067392 - Update Node to 24 LTS for pdf.js in the updatebot image r=tjr\n\nThe pdf.js dependencies now require `^22.18.0 || \u003e=24.11.0`, so the pinned\nv22.17.0 made every `mach vendor` run emit several hundred EBADENGINE\nwarnings. Move to the current 24 LTS, which pdf.js supports and which the\ntoolchain is already partly on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322060\n", "files": ["taskcluster/docker/updatebot/install-node-for-pdfjs.sh"], "git_node": "5c81053712407386d4a241302c100c34863b938a", "git_parents": ["cf77bcf6f414ae15aec8d647e7eb01145dd77a00"], "node": "4c8949defa6d92f97f1c047e31a0dc4e9633c22a", "parents": ["2c55d6483d4b2f5d1badb466227702c0617f6772"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "84e9c8aabdb872d56aa781fe5ea7d9217010ab80", "git_parents": ["5c81053712407386d4a241302c100c34863b938a", "8a99ef927ea16827f2089e2bdf6a1188ddf645e7"], "node": "a46a715953d3e016cd29a8aa9dd4899b76537855", "parents": ["4c8949defa6d92f97f1c047e31a0dc4e9633c22a", "e250d6adf4c0407181d42472837de3dd03b6ae8e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055093 - Cherry-pick upstream libwebrtc commit bb91915655 r=webrtc-reviewers,dbaker\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bb91915655ac409c482e0bf25304605a06435608\n       In VideoCaptureDS use Stop instead of StopWhenReady\n\n       As reported on Firefox an Insta360 Link 2 Pro camera has a driver bug\n       that leaves the camera light on until reboot when using StopWhenReady\n       during teardown of a capture session.\n\n       See https://bugzilla.mozilla.org/show_bug.cgi?id=2055093\n\n       Using Stop instead works around the driver bug, and better matches\n       Chromium's DirectShow backend.\n\n       Bug: none\n       Change-Id: I90862fb94907638394df476abf4fcca3b532f50c\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497541\n       Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n       Commit-Queue: Andreas Pehrson \u003capehrson@mozilla.com\u003e\n       Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#48444}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322705\n", "files": ["third_party/libwebrtc/modules/video_capture/windows/video_capture_ds.cc", "third_party/libwebrtc/moz-patch-stack/bb91915655.no-op-cherry-pick-msg"], "git_node": "59db3686ed2fe0c4824566be41becd5ceeef66ce", "git_parents": ["84e9c8aabdb872d56aa781fe5ea7d9217010ab80"], "node": "4c0b7d865d38ca779703c9b5883448d1cfb748c5", "parents": ["a46a715953d3e016cd29a8aa9dd4899b76537855"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050245 - update buttons in Nova native-theme mode r=desktop-theme-reviewers,hjones,fchasen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319291\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json"], "git_node": "433eada826fd6d2a3ce109791fe896264b1671a3", "git_parents": ["59db3686ed2fe0c4824566be41becd5ceeef66ce"], "node": "f7ab84af28ebbd5ef8b67668ff97fe3916d3f9f2", "parents": ["4c0b7d865d38ca779703c9b5883448d1cfb748c5"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066184 - Part 1: Add navigate property to Notification. r=saschanaz,webidl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320994\n", "files": ["dom/ipc/DOMTypes.ipdlh", "dom/notification/Notification.cpp", "dom/notification/Notification.h", "dom/notification/NotificationParent.cpp", "dom/webidl/Notification.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/notifications/idlharness.https.any.js.ini", "toolkit/components/alerts/AlertNotification.cpp", "toolkit/components/alerts/AlertNotification.h", "toolkit/components/alerts/nsIAlertsService.idl"], "git_node": "2121206065f29811b8d6562522ab666620c12bd7", "git_parents": ["433eada826fd6d2a3ce109791fe896264b1671a3"], "node": "91a67156d4f01c53903686b1403e2e2a76d0e7e9", "parents": ["f7ab84af28ebbd5ef8b67668ff97fe3916d3f9f2"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066184 - Part 2: Add navigate to NotificationStorage. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321317\n", "files": ["dom/interfaces/notification/nsINotificationStorage.idl", "dom/notification/NotificationUtils.cpp", "testing/web-platform/mozilla/meta/notifications/simulate-click-handler.sub.https.window.js.ini", "testing/web-platform/mozilla/tests/notifications/simulate-click-handler-sw.js", "testing/web-platform/mozilla/tests/notifications/simulate-click-handler.sub.https.window.js"], "git_node": "b74b032213a43a31f40d7cda905565c41112eeb0", "git_parents": ["2121206065f29811b8d6562522ab666620c12bd7"], "node": "42030fb4768f89e8cac7c72a8b94286bdda06bd2", "parents": ["91a67156d4f01c53903686b1403e2e2a76d0e7e9"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066184 - Part 3: Navigate to Notification or action's navigation URL on click. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320995\n", "files": ["dom/notification/NotificationHandler.cpp", "dom/notification/NotificationHandler.h", "dom/notification/NotificationParent.cpp", "testing/web-platform/mozilla/meta/notifications/navigate.https.window.js.ini", "testing/web-platform/mozilla/tests/notifications/navigate-sw.js", "testing/web-platform/mozilla/tests/notifications/navigate.https.window.js", "testing/web-platform/mozilla/tests/notifications/resources/broadcast-when-opened.html"], "git_node": "fa83b439c870b3ac9d57904e3f60c971f79afe31", "git_parents": ["b74b032213a43a31f40d7cda905565c41112eeb0"], "node": "7cc14cea3a85722557d87b15217797455f8dc8a4", "parents": ["42030fb4768f89e8cac7c72a8b94286bdda06bd2"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066184 - Part 4: Mark notification telemetry tests as intermittent on Android. r=saschana