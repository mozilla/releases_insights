/places/src/db/db.rs", "third_party/application-services/components/places/src/error.rs", "third_party/application-services/components/places/src/storage/mod.rs", "third_party/application-services/components/places/src/util.rs", "third_party/application-services/components/remote_settings/android/build.gradle", "third_party/application-services/components/remote_settings/dumps/main/search-config-v2.json", "third_party/application-services/components/remote_settings/dumps/main/search-config-v2.timestamp", "third_party/application-services/components/support/error/android/build.gradle", "third_party/application-services/components/support/sql/Cargo.toml", "third_party/application-services/components/support/sql/src/lib.rs", "third_party/application-services/components/support/sql/src/maintenance.rs", "third_party/application-services/components/support/sql/src/open_database.rs", "third_party/application-services/components/support/sql/src/path.rs", "third_party/application-services/components/support/types/src/lib.rs", "third_party/application-services/components/sync_manager/android/build.gradle", "third_party/application-services/components/webext-storage/src/db.rs", "third_party/application-services/components/webext-storage/src/error.rs", "third_party/application-services/megazords/fenix-dylib/megazord_stub.c", "third_party/application-services/megazords/full/src/lib.rs", "third_party/application-services/moz.yaml", "toolkit/components/uniffi-bindgen-gecko-js/android/components/ads-client/android/src/main/java/mozilla/appservices/adsclient/ads_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "08081cb1116c00a94d48b70145958d8e56b2e1a7", "git_parents": ["3a64319529d134ae2afc95f24c7563d0ab53765a"], "node": "18698ba5810a40ee217b5b0f284deda89c64aa01", "parents": ["42622004fdf9f5909f24ee2ef232af7229fc0b3f"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057279 - Add \"sponsored position\" Flag to topsites.impression Glean event r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324423\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/lib/NewTabContentPing.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_NewTabContentPing.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "d006aa420947cbebd0540ab2ff162e8a32b5968e", "git_parents": ["08081cb1116c00a94d48b70145958d8e56b2e1a7"], "node": "beea681fa949fa14cbfc558ec3d9026b597d6cb2", "parents": ["18698ba5810a40ee217b5b0f284deda89c64aa01"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067189 - Convert RustSyncManager from an interface to a simpler typealias of apps-service SyncManagerInterface r=android-reviewers,skhan\n\nWe previously created the RustSyncManager to enable us test, but later found out that application services provides us with a SyncManagerInterface.\n\nWe have decided to typealias that to `RustSyncManager` and get rid of our own interface definition.\n\nSo in effect, we are using the SyncManagerInterface, but we are calling it \"RustSyncManager\", because we have an overload of various sync managers, and SyncManagerInterface does not tell us which of the sync managers this interface defines.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324274\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/RustSyncManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/TestRustSyncManager.kt"], "git_node": "ceffe8104367b09f9dff2c248a42093c0f4bc08e", "git_parents": ["d006aa420947cbebd0540ab2ff162e8a32b5968e"], "node": "8338ba897f46b93e0efc8daa0c3f324ceb395dfe", "parents": ["beea681fa949fa14cbfc558ec3d9026b597d6cb2"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2064865 - handle late missing offline voice errors during speech synthesis r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324478\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SpeechSynthesizer.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/synthesis/AndroidTtsSpeechSynthesizerTest.kt"], "git_node": "1dceed97477a63fd8decaa2a21b7c8d0122e54a0", "git_parents": ["ceffe8104367b09f9dff2c248a42093c0f4bc08e"], "node": "442f2c923c4b2b0157173b25c64607410e367f62", "parents": ["8338ba897f46b93e0efc8daa0c3f324ceb395dfe"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2057685 - Part 2: Relax assertion to allow mobile to use this path for full page screenshots r=layout-reviewers,hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318614\n", "files": ["layout/base/PresShell.cpp"], "git_node": "0108dae47766e3b0976ebfbfc9cb7762ae2a48b9", "git_parents": ["1dceed97477a63fd8decaa2a21b7c8d0122e54a0"], "node": "e6244c4adbf5b4072ac76204e9c6951fcf411c6b", "parents": ["442f2c923c4b2b0157173b25c64607410e367f62"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2068262 - Handle null principal RemoteTypes in RemoteType.cpp, r=dom-core-reviewers,mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324417\n", "files": ["dom/ipc/RemoteType.cpp", "dom/ipc/RemoteType.h", "dom/ipc/tests/browser.toml", "dom/ipc/tests/browser_coop_coep_webext_data_frame.js"], "git_node": "d3736930bdeede291c832a86e5dfc9a568f3e64b", "git_parents": ["0108dae47766e3b0976ebfbfc9cb7762ae2a48b9"], "node": "b67acad16fff02c6b037addb34f6d00b8ca4eb37", "parents": ["e6244c4adbf5b4072ac76204e9c6951fcf411c6b"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066557 - Multi-Custom Wallpapers: Storage and migration r=mconley\n\nFirefox currently keeps only one custom wallpaper, so uploading another replaces it. This patch adds storage and migration for a wallpaper library while keeping the applied image available at the existing location for compatibility. That copy is a shim, marked @backward-compat { version 158 } with removal steps in bug 2068272. It stores a thumbnail when given one but does not make thumbnails; scaling happens in the picker patch. It also owns telling the page which wallpaper to show at startup, before the migration runs and again afterwards if the file was renamed. It is off by default behind newtabWallpapers.customWallpaper.library.enabled; the picker comes next.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322535\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperFileNames.mjs", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js", "browser/extensions/newtab/test/xpcshell/test_WallpaperFileNames.js", "browser/extensions/newtab/test/xpcshell/xpcshell.toml"], "git_node": "1de1aca9ca987e64d2662c34ef163489565807f7", "git_parents": ["d3736930bdeede291c832a86e5dfc9a568f3e64b"], "node": "eeaa6e81cd18eb380e9bd6ea25aecc128ab29b95", "parents": ["b67acad16fff02c6b037addb34f6d00b8ca4eb37"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066561 - Multi-Custom Wallpapers: Add a \"Your images\" folder to the wallpaper picker r=mconley\n\nThis patch adds a \"Your images\" folder to the picker that lists each saved image as a thumbnail and applies one on click, with arrow key navigation across the grid. Thumbnails are handed to the page as files rather than addresses, because nothing inside the library folder can be reached by address. Thumbnail scaling runs here, in the content process, and the parent stores the result it receives. Off by default behind newtabWallpapers.customWallpaper.library.enabled; deleting an image comes next.\n\nTwo gaps are deliberate. There is no remove button yet, that is the next patch. Everything in the folder will be an upload for now, because saving a Picture of the Day into it comes later in the stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322745\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/_WallpaperCategories.scss", "browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperLibraryPref.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperThemeUtils.mjs", "browser/extensions/newtab/test/jest/common/Reducers.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx", "browser/extensions/newtab/test/jest/lib/Wallpapers/WallpaperThemeUtils.test.js", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "aedcad5389af72752c5239075dab1b63c24d9764", "git_parents": ["1de1aca9ca987e64d2662c34ef163489565807f7"], "node": "9f779b5548477e14c93652691b1551798e50265c", "parents": ["eeaa6e81cd18eb380e9bd6ea25aecc128ab29b95"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066562 - Multi-Custom Wallpapers: Allow deleting a saved custom wallpaper r=mconley\n\nThe \"Your images\" folder has no way to remove anything, so a saved wallpaper is kept forever once it is added.\n\nThis patch gives each saved image its own remove button, revealed on hover or keyboard focus the same way the Stocks watchlist does it, plus a confirmation before anything goes. Removing takes the image, its thumbnail and its details file together. Removing the one currently applied also drops the copy in the wallpaper folder and clears the selection, so the page falls back rather than pointing at a file that is gone.\n\nNumbers are never reused. Removing image 2 leaves image 3 called image 3. The next image added is 5 rather than filling the gap, so what a screen reader reads for a picture does not change under someone.\n\nOff by default behind newtabWallpapers.customWallpaper.library.enabled, along with the folder itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322806\n", "files": ["browser/extensions/newtab/content-src/components/ConfirmDialog/ConfirmDialog.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/_WallpaperCategories.scss", "browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/ConfirmDialog.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "178590548f0d3052fad30949aa93edf24eb08854", "git_parents": ["aedcad5389af72752c5239075dab1b63c24d9764"], "node": "59b1349c3da28f852addb0143db5ae33d01fe0a8", "parents": ["9f779b5548477e14c93652691b1551798e50265c"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066565 - Multi-Custom Wallpapers: Preserve retired shipped wallpapers r=mconley\n\nWhen a shipped wallpaper is retired, it's completely removed. Anyone using it loses their wallpaper with no warning and nothing to put back. This patch keeps it. Firefox learns a wallpaper is gone when Remote Settings hands it an updated list. If the one that's gone is the wallpaper someone has applied, the image is downloaded and saved into their own folder before it disappears. The page does not change and nobody notices anything happened.\n\nIt saves under a builtin name rather than a custom one, so the folder can tell a Firefox wallpaper apart from a photo someone added. Beside it goes the photographer, the link and its name in the current locale, since a wallpaper can be retired years before its text is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322820\n", "files": ["browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "60d2d748257de48b9b58cdfb5c6f31713612e685", "git_parents": ["178590548f0d3052fad30949aa93edf24eb08854"], "node": "63183fee64e4291c29a0d8090ca621b809600b65", "parents": ["59b1349c3da28f852addb0143db5ae33d01fe0a8"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066566 - Multi-Custom Wallpapers: Back up every saved custom wallpaper r=mconley\n\nBackup keeps one custom wallpaper, the one currently on the page. Restore already puts the whole wallpaper folder back, so with a library of saved images the two no longer match: someone would restore and find everything except the picture they happened to be using had gone. This patch backs up the folder instead of a single file, which is one line rather than a lookup, since the copy is recursive and takes the library subfolder with it. It also reports the folder's size, so the backup interface shows what the wallpapers are actually costing rather than leaving them out of the total. One thing to think about, every saved image now goes into every backup, with no cap on how many someone can keep. A photo is usually one to three megabytes, so a profile with a dozen of them adds tens of megabytes to each archive. My own test profile with twelve real photos produced a 28 MB archive where the same profile without them was 387 KB, so it is almost entirely wallpapers.\n\nMy view is that it is the right trade, since it is the person's own data and the alternative is a restore that cannot reproduce what it restored. But it is your component and the number is larger than I expected. `getDirectorySize` already takes a `shouldExclude` hook if you would rather cap or exclude it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322985\n", "files": ["browser/components/backup/resources/PreferencesBackupResource.sys.mjs", "browser/components/backup/tests/xpcshell/test_PreferencesBackupResource.js"], "git_node": "8626557b85906a58fa7012a0f7c42a53e25f462b", "git_parents": ["60d2d748257de48b9b58cdfb5c6f31713612e685"], "node": "1c0a257a11406a976270592b3708c58ec5a8c150", "parents": ["63183fee64e4291c29a0d8090ca621b809600b65"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066567 - Multi-Custom Wallpapers: Save Picture of the Day images into \"Your images\" r=mconley\n\nSetting a Picture of the Day as wallpaper now saves its description and published date with the image. The description gives it a useful name in \u201cYour images\u201d; the title isn\u2019t used because it\u2019s generic and unreliable. Both details are captured before the download so a refresh can\u2019t mix up the image and its information.\n\nSetting the same picture again applies the saved copy instead of creating a duplicate. If it has no description, Firefox uses a number, just like an uploaded image.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323110\n", "files": ["browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PictureOfTheDayFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_PictureOfTheDayFeed.js", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "bfbbecd2ac2e3ec6316d2f5fe1eb642999377331", "git_parents": ["8626557b85906a58fa7012a0f7c42a53e25f462b"], "node": "180a3bdef5a666d08b45fd8c86466c3496f8ca0e", "parents": ["1c0a257a11406a976270592b3708c58ec5a8c150"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067845 - Multi-Custom Wallpapers: Add telemetry r=mconley\n\nNothing reports on the \"Your images\" folder, so there is no way to tell how many wallpapers people keep, which kind they pick, or whether they ever remove one. The existing wallpaper_click reports every saved image as \"custom\", so it cannot tell an upload apart from a kept Picture of the Day.\n\nThis patch adds three events: one when an image is saved, one when a saved image is applied, one when it is removed. Each carries where the image came from plus how many the person has saved. The removal also says whether the image was the one on the page.\n\nAll three are recorded in the parent process once the action has really happened, so an upload the parent refuses or a removal that fails is never counted. The tab that asked is passed through, so each event belongs to that page's session.\n\nNo names of any kind. An image someone added is known by a number and a kept picture by its own title. Neither is recorded.\n\nA Firefox wallpaper kept for someone when it was retired is saved during a background sync, with no page to attribute it to, so it is not counted here. That one is agreed as a follow-up rather than part of this patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323449\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PictureOfTheDayFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_PictureOfTheDayFeed.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "b1af1b85dc846f350fa03a48400a4a10a8e4e7d7", "git_parents": ["bfbbecd2ac2e3ec6316d2f5fe1eb642999377331"], "node": "3bb5232b3eb6eb8b549b3eb844ebe612adb84165", "parents": ["180a3bdef5a666d08b45fd8c86466c3496f8ca0e"], "tags": []}, {"author": "Juan Perdomo \u003cjcperdomo100@gmail.com\u003e", "branch": "default", "desc": "Bug 2069230 - Use smaps_rollup for resident-unique reporter. r=xpcom-reviewers,sandbox-reviewers,jld,emilio\n\nLinux resident-unique reporting currently parses the full smaps file for\neach process even though the kernel exposes the same private-memory totals\nin smaps_rollup. Read Private_Clean and Private_Dirty from that summary and\nconvert the result from kB to bytes, honoring both self and explicit PIDs.\n\nUse the existing smaps implementation when smaps_rollup cannot be opened,\nincluding on kernels predating Linux 4.14. Return failure for incomplete\nrollup data or read errors. The per-mapping reporter continues using smaps.\n\nAllow read-only access to the process's smaps_rollup in the Linux sandbox\nbroker's shared memory-reporting policy, alongside the existing smaps and\nstatm permissions, so sandboxed processes can use the new reporting path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323816\n", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp", "xpcom/base/nsMemoryReporterManager.cpp"], "git_node": "2537dfab8f3ffb2d143e866554d2d60052829c46", "git_parents": ["b1af1b85dc846f350fa03a48400a4a10a8e4e7d7"], "node": "33574b7c70b2327d3ea44aeaff02f8b6d3c320d0", "parents": ["3bb5232b3eb6eb8b549b3eb844ebe612adb84165"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069184 - Bump the minimum supported version of GCC to 11 and use libstdc++ 11 for the build r=firefox-build-system-reviewers,ahochheiden\" for causing build bustages in GemmologyEngineAVXVNNI.o\n\nThis reverts commit 8cb1b67a266324f2d3772ed97bcbe19d48e25438.\n\nRevert \"Bug 2069181 - Switch hazard builds to gcc 11. r=firefox-build-system-reviewers,ahochheiden\"\n\nThis reverts commit 9050004b251abb1937c7c680906cf676682447f5.\n", "files": ["build/moz.configure/toolchain.configure", "docs/code-quality/coding-style/using_cxx_in_firefox_code.md", "js/src/devtools/rootAnalysis/mach_commands.py", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/hazard/kind.yml", "taskcluster/kinds/packages/debian.yml", "taskcluster/kinds/toolchain/gcc.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/kinds/toolchain/node.yml", "taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "7f1020a4a088ab1c5723281f41d60f3740ac9209", "git_parents": ["2537dfab8f3ffb2d143e866554d2d60052829c46"], "node": "29041ea89ea333419bcebbd752f1236af758d725", "parents": ["33574b7c70b2327d3ea44aeaff02f8b6d3c320d0"], "tags": []}, {"author": "Jan Horak \u003cjhorak@redhat.com\u003e", "branch": "default", "desc": "Bug 1955255 Allow passing returned GUnixFDList to the DBusCallFDListPromise; r=emilio\n\nWe want to use the returned fds when g_dbus_proxy_call_with_unix_fd_list_finish is called.\nThis change passes the argument as a std::pair to the fulfillment handler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242322\n", "files": ["toolkit/system/gnome/nsGIOService.cpp", "widget/gtk/AsyncDBus.cpp", "widget/gtk/AsyncDBus.h", "widget/gtk/FileTransferPortal.cpp"], "git_node": "ed9ff2480512619e509ba1ccbc0ac0b7e15b637a", "git_parents": ["7f1020a4a088ab1c5723281f41d60f3740ac9209"], "node": "cc541589be42ba3324714317962c5b54c8b38803", "parents": ["29041ea89ea333419bcebbd752f1236af758d725"], "tags": []}, {"author": "Jan Horak \u003cjhorak@redhat.com\u003e", "branch": "default", "desc": "Bug 1955255 Implement native messaging using xdg-native-messaging-proxy; r=robwu,extension-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242328\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "testing/mozbase/manifestparser/manifestparser/token.py", "toolkit/components/extensions/NativeMessaging.sys.mjs", "toolkit/components/extensions/NativeMessagingProxy.cpp", "toolkit/components/extensions/NativeMessagingProxy.h", "toolkit/components/extensions/components.conf", "toolkit/components/extensions/docs/native-messaging-portal-design.md", "toolkit/components/extensions/moz.build", "toolkit/components/extensions/nsINativeMessagingProxy.idl", "toolkit/components/extensions/test/xpcshell/native_messaging.toml", "toolkit/components/extensions/test/xpcshell/test_ext_native_messaging_portal.js", "toolkit/components/extensions/test/xpcshell/test_ext_native_messaging_proxy_real.js", "tools/@types/generated/lib.gecko.xpcom.d.ts", "widget/gtk/WidgetUtilsGtk.cpp", "widget/gtk/WidgetUtilsGtk.h"], "git_node": "530615edb25371ef579befb4101c2c5a33d4b34c", "git_parents": ["ed9ff2480512619e509ba1ccbc0ac0b7e15b637a"], "node": "04544093c9dd9a756a0f89d16d41db672d8737cf", "parents": ["cc541589be42ba3324714317962c5b54c8b38803"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1955255: apply code formatting via Lando\n\n# ignore-this-changeset\n"