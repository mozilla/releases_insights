: ["9730adb51ba0e71a051f82a57d5916b242e83bcb"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068304 - Update AGP to version 9.4.0. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322796\n", "files": ["gradle/libs.versions.toml"], "git_node": "3986257e92a0eaf9bb102425a87ee2a34d2182ee", "git_parents": ["6f6851e96dba5d1e67a02fd0948726ae0aba8426"], "node": "adb1e743a730c5b4563bbfd526e850288dcdfc56", "parents": ["dd017b3af5799022e079783812900df1dc168d8f"], "tags": []}, {"author": "Nora Liu \u003cnliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1504900 - Add documentation comment explaining EitherParser's purpose r=arai DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322740\n", "files": ["js/src/frontend/EitherParser.h"], "git_node": "a05b5cb150f22fddce8d93489eb2e46f6c24ad0d", "git_parents": ["3986257e92a0eaf9bb102425a87ee2a34d2182ee"], "node": "db99e1a430d9ba29ef57c76a2be2321001700dcd", "parents": ["adb1e743a730c5b4563bbfd526e850288dcdfc56"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068213 - Add CanvasRenderingContext2D::Stroke fast-paths for lines and circles. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322709\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "gfx/2d/2D.h", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetRecording.h", "gfx/2d/PathRecording.cpp", "gfx/2d/PathRecording.h", "gfx/2d/RecordedEventImpl.h"], "git_node": "54314547710d64b6b2290a7ab572923b859065c6", "git_parents": ["a05b5cb150f22fddce8d93489eb2e46f6c24ad0d"], "node": "f5cdced3cac30e4b0826c4ba6532d6de50f7ad3c", "parents": ["db99e1a430d9ba29ef57c76a2be2321001700dcd"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2066718 - Recycle AndroidHardwareBufferTextureHost for WebGL/WebGPU on Android r=gfx-reviewers,lsalzman\n\nPreparation for  Bug 2066020.\n\nRecycle AndroidHardwareBufferTextureHost to prevent RenderAndroidHardwareBufferTextureHost recreation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322214\n", "files": ["gfx/layers/RemoteTextureMap.cpp"], "git_node": "22865964ba6bdcfbfe60c226de488990680b9dc1", "git_parents": ["54314547710d64b6b2290a7ab572923b859065c6"], "node": "fe31c880846b610c75398424800fbd3252c65008", "parents": ["f5cdced3cac30e4b0826c4ba6532d6de50f7ad3c"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2067795 - Fuzz anchor-scroll-update-004 on Android for the overlay scrollbar thumb cap. r=gfx-reviewers,tnikkel\n\nReplaces the blanket expected: [PASS, FAIL] added by the wpt-sync in bug\n2067231, which disabled the comparison entirely.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322428\n", "files": ["testing/web-platform/meta/css/css-anchor-position/anchor-scroll-update-004.html.ini"], "git_node": "385b4d7a46edd87dd951f8aa155bbd716bbdaea5", "git_parents": ["22865964ba6bdcfbfe60c226de488990680b9dc1"], "node": "6288672cac9b6a7693297c7f93c7ff2486711ff6", "parents": ["fe31c880846b610c75398424800fbd3252c65008"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1452337 - Restrict WebRender image sampling to the visible part of an image r=gfx-reviewers,nical\n\nA sprite sheet is pushed as the whole sheet clipped to one cell with nothing\nrestricting sampling, so filtering at fractional raster scales pulls in the\nneighbouring cells. Narrow the source rect with add_sub_rect, the way\nborder-image already does per nine-patch slice.\n\nThe visible part is what the item's clip rect leaves of its bounds, so scene\nbuilding derives it rather than Gecko sending it. It is kept as a fraction and\nresolved in prepare_image_quads, the first point that knows the size the image is\nreally rasterized at; resolving it against any other size scales the primitive\ninstead of merely restricting sampling. Floored at one texel, because the visible\npart can be a vanishingly small fraction of a huge destination. Skipped when the\npattern repeats, since each repetition samples the whole image.\n\nSnapped out to whole texels, because a sub-texel edge leaves the half-texel clamp\nin the shader inside a texel, pinning sampling part-way across it and shifting the\nimage against the pixels actually drawn. Round-tripping an edge through a fraction\ncosts a few ULP at the scale of the image, landing a whole-texel edge just off the\ninteger, so an edge within that of a boundary is snapped back to it before the\nexpansion; expanding it instead would take in a texel of the neighbouring cell,\nwhich is the bleed this is here to prevent. Layout cannot place a real edge that\nclose to a boundary, one app unit being 1/60 of a CSS pixel.\n\n403181-1 covers this bleed directly and now matches exactly, so its fuzz\nannotation goes with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318633\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/render_task_graph.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/interned_prims.rs", "gfx/wr/webrender_api/src/key_types.rs", "gfx/wr/wrench/reftests/image/reftest.list", "gfx/wr/wrench/reftests/image/sub-rect-clamp-ref.yaml", "gfx/wr/wrench/reftests/image/sub-rect-clamp.yaml", "layout/reftests/backgrounds/reftest.list", "layout/reftests/backgrounds/sprite-sampling-clamp-1-ref.html", "layout/reftests/backgrounds/sprite-sampling-clamp-1.html", "layout/reftests/backgrounds/sprite-sampling-clamp-ref.png", "layout/reftests/backgrounds/sprite-sampling-clamp.png", "layout/reftests/bugs/reftest.list"], "git_node": "dfcb1075510e95b2edb7e62a4c38239c4ee75407", "git_parents": ["385b4d7a46edd87dd951f8aa155bbd716bbdaea5"], "node": "77ffb133020e81905a727b3fadde9f2a9430a55e", "parents": ["6288672cac9b6a7693297c7f93c7ff2486711ff6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067366 - Restore the scrollbar in menulist popups. r=desktop-theme-reviewers,emilio\n\nA vertical arrowscrollbox hides its scrollbar, and the menulist rule set the scrollbox's overflow but not its scrollbar-width, so the popup kept scrolling with nothing to drag. Dropping the overflow declarations leaves overflow-x hidden, so a menuitem wider than the popup is cropped rather than scrolled sideways, and leaves the scrollbox a scroll container only while it overflows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322351\n", "files": ["browser/base/content/test/forms/browser_selectpopup_colors.js", "toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/test_menulist_scrollbar.xhtml", "toolkit/content/widgets/menupopup.css"], "git_node": "85e05f2d5045c05bce7cf2b477b7b7442012cf9e", "git_parents": ["dfcb1075510e95b2edb7e62a4c38239c4ee75407"], "node": "1ae032ceac3f41054b4ebdeeed2e4e904abfd9dd", "parents": ["77ffb133020e81905a727b3fadde9f2a9430a55e"], "tags": []}, {"author": "Masha Lifshin \u003cmlifshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066946 - Vendor application-services 5a011ab3 and update quicksuggest tests for the new required suggestion_id r=adw,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321421\n", "files": ["browser/components/urlbar/tests/quicksuggest/MerinoTestUtils.sys.mjs", "browser/components/urlbar/tests/quicksuggest/QuickSuggestTestUtils.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_block.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_ping_offline.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_amp.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_merino.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_relevanceRanking.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_scoreMap.js", "third_party/application-services/components/autofill/src/db/schema.rs", "third_party/application-services/components/suggest/src/db.rs", "third_party/application-services/components/suggest/src/rs.rs", "third_party/application-services/components/suggest/src/schema.rs", "third_party/application-services/components/suggest/src/store.rs", "third_party/application-services/components/suggest/src/suggestion.rs", "third_party/application-services/components/suggest/src/testing/data.rs", "third_party/application-services/moz.yaml", "toolkit/components/uniffi-bindgen-gecko-js/android/components/suggest/android/src/main/java/mozilla/appservices/suggest/suggest.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs"], "git_node": "97cc757125e43b2a7f1985b135d742374b06384d", "git_parents": ["85e05f2d5045c05bce7cf2b477b7b7442012cf9e"], "node": "2c353536474ad0cb22a06835adaa5d73fb798156", "parents": ["1ae032ceac3f41054b4ebdeeed2e4e904abfd9dd"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2067564 - remove bogus assertion in AtomicFetchOp in MacroAssembler-x86-shared.cpp.  r=bvisness.\n\nAtomicFetchOp in MacroAssembler-x86-shared.cpp contains an assertion\n`MOZ_ASSERT(before \u003c after)` that is intended to catch cases where `after` is\nmistakenly not set.  But this is also triggered when an OOM happens in between\ncaptures of `before` and `after`.\n\nIn the OOM case, the `FaultingCodeRange` that is constructed will be invalid,\nbut logic downstream should detect that the assembler has OOMd and hence will\nabandon the assembler and all its associated `FaultingCodeRange`s.  See block\ncomment on definition of `class FaultingCodeRange`.\n\nThe fix is simply to remove the assertion.\n\nAs a ridealong, the patch also removes a `mozilla::Atomic\u003cuint32_t\u003e ctr(0)`\nthat was introduced by previous work on stackmaps/traps, and should not have\nbeen committed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322246\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2067564.js", "js/src/jit/MacroAssembler.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp"], "git_node": "e25f9777eb48234f95e4b4e6b539501625006c27", "git_parents": ["97cc757125e43b2a7f1985b135d742374b06384d"], "node": "f14766b74b6209593a62832435745a0042c063da", "parents": ["2c353536474ad0cb22a06835adaa5d73fb798156"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2047317 - Setup logging when using mach gtest. r=ahal\n\nThis is a regression by bug 2017145. After landing it, `mach gtest`\nalways causes an error because log is None.\n\nWhen using `mach` command, `android_gtest` in `mach_commands.py` will\ncall `RemoteGTests.run_gtest` directly. So we need to consider this\ncase.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321136\n", "files": ["testing/gtest/remotegtests.py"], "git_node": "39f51b60f36ef9ee4c5781bc2fd3542903c372e9", "git_parents": ["e25f9777eb48234f95e4b4e6b539501625006c27"], "node": "fe7488a22f1530b593c816eb00e692f2e13744d4", "parents": ["f14766b74b6209593a62832435745a0042c063da"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\naf -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nan -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nar -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nast -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\naz -\u003e dff5d8641d4e07f5d03b56ae7a