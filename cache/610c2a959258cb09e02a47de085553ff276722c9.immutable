ebrtc/modules/sframe/sframe_context_factory.h", "third_party/libwebrtc/modules/sframe/sframe_decryptor.cc", "third_party/libwebrtc/modules/sframe/sframe_decryptor.h", "third_party/libwebrtc/modules/sframe/sframe_encryptor.cc", "third_party/libwebrtc/modules/sframe/sframe_encryptor.h", "third_party/libwebrtc/modules/sframe/sframe_encryptor_decryptor_unittest.cc", "third_party/libwebrtc/modules/sframe/sframe_media_decryptor_interface.h", "third_party/libwebrtc/moz-patch-stack/s0027.patch"], "git_node": "551a8b59e00955d8225ae9aafd3eff3c44af6130", "git_parents": ["6f046c21d81ca37a6b05239baaa0c8da098513ac"], "node": "d0b619684aa52af73684f8645a0a4b113f6a1854", "parents": ["59dbea54ce7610155d03024cce926b1fde77122a"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 (MOZ) - add shim for third_party/libwebrtc/third_party/sframe/BUILD.gn\n", "files": ["third_party/libwebrtc/third_party/sframe/BUILD.gn"], "git_node": "6c570e9a367f14b5901d7428b95745e013cfc587", "git_parents": ["551a8b59e00955d8225ae9aafd3eff3c44af6130"], "node": "05c2f6da4bf3d8c147fa653af373720b3d149a9d", "parents": ["d0b619684aa52af73684f8645a0a4b113f6a1854"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from cd632d19c2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/cd632d19c2514ae253a3ade167d5c94ac95d094f\n    Add handover state methods to OutstandingData.\n\n    This adds OutstandingData to the handover state and implements\n    AddHandoverState and RestoreFromState in OutstandingData.\n\n    Bug: webrtc:477364365\n    Change-Id: Ia8cfffbc46b1d26ced5eddd9abf0f533de0c3761\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/492361\n    Commit-Queue: Priya Rajarathinam \u003crajarathinam@google.com\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48352}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/net/dcsctp/public/dcsctp_handover_state.h", "third_party/libwebrtc/net/dcsctp/tx/BUILD.gn", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data.cc", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data.h", "third_party/libwebrtc/net/dcsctp/tx/outstanding_data_test.cc"], "git_node": "a3800c7d9e26d6895edc711f3ad4caba5af38983", "git_parents": ["6c570e9a367f14b5901d7428b95745e013cfc587"], "node": "9cad60f79e13a344020991936928e69c9d86aef2", "parents": ["05c2f6da4bf3d8c147fa653af373720b3d149a9d"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - updated libwebrtc patch stack\n", "files": ["third_party/libwebrtc/moz-patch-stack/s0145.patch", "third_party/libwebrtc/moz-patch-stack/s0146.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch", "third_party/libwebrtc/moz-patch-stack/s0149.patch", "third_party/libwebrtc/moz-patch-stack/s0150.patch", "third_party/libwebrtc/moz-patch-stack/s0151.patch"], "git_node": "e7ae46629071d89f006b91d2389952dc5211c43c", "git_parents": ["a3800c7d9e26d6895edc711f3ad4caba5af38983"], "node": "b2dd97200eb6d9268f20875eb5329804146a858e", "parents": ["9cad60f79e13a344020991936928e69c9d86aef2"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 5da5a6e4e0\n\nWe cherry-picked this in bug 2056029.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5da5a6e4e00c69ef60c7643e99ef34f65f7af51a\n    video_capture: Implement buffer stride support for Pipewire\n\n    Add optional buffer stride support to VideoCaptureImpl and use it in\n    VideoCaptureModulePipeWire, allowing us to drop the requirement for\n    unpadded buffers. This notably improves compatibility with libcamera,\n    which supports a wider range of devices than the V4L2 backend - some\n    having hardware requirements for stride-alignment.\n\n    Extending `ConvertToI420()` in libyuv was rejected on the grounds that there are various approaches to stride handling - using a single stride value for multiple planes, having explicit values for each one etc. - as well as the fact that we might well want to extend the helper further in the future - e.g. in order to better handle color spaces such as BT709 (instead of always assuming BT601).\n\n    Thus this patch now adds a local copy of `ConvertToI420()`, supporting implicit and a single explicit stride value for now.\n\n    libyuv CL for context:\n    https://chromium-review.googlesource.com/c/libyuv/libyuv/+/8146821\n\n    Bug: chromium:538875176\n    Change-Id: Ic5781709cf5f20e8c75b9ad09d7052a355fcbec7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/491680\n    Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n    Reviewed-by: Jan Grulich \u003cgrulja@gmail.com\u003e\n    Commit-Queue: Stefan Holmer \u003cstefan@webrtc.org\u003e\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48353}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_capture/video_capture.h", "third_party/libwebrtc/moz-patch-stack/5da5a6e4e0.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0008.patch", "third_party/libwebrtc/moz-patch-stack/s0012.patch", "third_party/libwebrtc/moz-patch-stack/s0032.patch", "third_party/libwebrtc/moz-patch-stack/s0047.patch", "third_party/libwebrtc/moz-patch-stack/s0052.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/moz-patch-stack/s0075.patch", "third_party/libwebrtc/moz-patch-stack/s0076.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0108.patch", "third_party/libwebrtc/moz-patch-stack/s0127.patch", "third_party/libwebrtc/moz-patch-stack/s0145.patch", "third_party/libwebrtc/moz-patch-stack/s0146.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch", "third_party/libwebrtc/moz-patch-stack/s0149.patch", "third_party/libwebrtc/moz-patch-stack/s0150.patch", "third_party/libwebrtc/moz-patch-stack/s0151.patch"], "git_node": "6d038c44c4cb6544d74e9fd55683d9a7988480a9", "git_parents": ["e7ae46629071d89f006b91d2389952dc5211c43c"], "node": "c636531c4a8715cceb78caedc6ce58ec873ce40a", "parents": ["b2dd97200eb6d9268f20875eb5329804146a858e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from 4d6a08b746\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4d6a08b746f2d3f317c89a6316a04ec541f6032f\n    Update WebRTC code version (2026-08-14T04:07:04).\n\n    Bug: None\n    Change-Id: I079ca41c412d5a89b89d0cf62e58ba29f63caee2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/496000\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48354}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "9be04ace169af06d3cf84b0a34ba486d5e209593", "git_parents": ["6d038c44c4cb6544d74e9fd55683d9a7988480a9"], "node": "7fe29889671347cab8493b23fc434bee00150235", "parents": ["c636531c4a8715cceb78caedc6ce58ec873ce40a"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064200 - Vendor libwebrtc from db4ad2056f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/db4ad2056ff13b363f28366e28