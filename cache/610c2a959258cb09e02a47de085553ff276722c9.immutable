e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\noc -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\npa-IN -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\npl -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\npt-BR -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\npt-PT -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nrm -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nro -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nru -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nsk -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nsl -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nson -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nsq -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nsr -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nsv-SE -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nta -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nte -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nth -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\ntl -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\ntr -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\ntrs -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nuk -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nur -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nuz -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nvi -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nwo -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nxh -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nzam -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nzh-CN -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\nzh-TW -\u003e dff5d8641d4e07f5d03b56ae7a2994e76571f34e\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "48d6dacd0d9c2a5f275db9e9387b5f696179c5cb", "git_parents": ["a6b8bdb415193561958ca2a88a92b8431ef38839"], "node": "eb53e11d07cc14400317c63048f84332c34ffd52", "parents": ["7613566a467272c9a8abaafa776ad3cf2709c6bf"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2067858 - Fix text-decoration on inline boxes when text-box-trim is applied. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322766\n", "files": ["layout/generic/nsLineLayout.cpp", "testing/web-platform/meta/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-002.html.ini", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-001-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-001.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-002-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-002.html"], "git_node": "9c41da3047b1942f2fc60ab74e1c6f243342d36e", "git_parents": ["48d6dacd0d9c2a5f275db9e9387b5f696179c5cb"], "node": "138de394cca8166a2b5616bbed39ce4ad968eeda", "parents": ["eb53e11d07cc14400317c63048f84332c34ffd52"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066294 - Offline Suggest EU expansion 2026 phases 2 and 3: Enable AMP and Wikipedia by default in AT, BE, CH, CZ, DK, ES, FI, HU, IE, LU, NL, NO, PL, PT, SE, SK r=daisuke,urlbar-reviewers\n\nManagement decided not to gate these new regions on locale. So I added a way to\nspecify that Suggest prefs should be enabled for a region regardless of locale.\n\nThis is all starting to get unwieldy, but fixing bug 2064578 will make most of\nit unnecessary, so we might want to prioritize it sooner rather than later.\n\nI added all the new regions to the test even though it makes it take a while. It\nseems important enough, especially as long as we do have the client-side prefs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322799\n", "files": ["browser/components/urlbar/QuickSuggest.sys.mjs", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_defaultPrefs.js", "browser/components/urlbar/tests/quicksuggest/unit/xpcshell.toml"], "git_node": "1a826a5cb2e162431cbedbfa5d2dfef7306a7256", "git_parents": ["9c41da3047b1942f2fc60ab74e1c6f243342d36e"], "node": "f8aa7aa83bbef13454060add00f11a3b807c8344", "parents": ["138de394cca8166a2b5616bbed39ce4ad968eeda"], "tags": []}, {"author": "Samuel Mbabhazi \u003csamuelmbabhazi@gmail.com\u003e", "branch": "default", "desc": "Bug 2054228 - Use the modern space-separated color syntax in DevTools stylesheets and themed SVGs. r=devtools-reviewers,bomsy\n\nConvert the legacy comma-separated rgb()/rgba()/hsl()/hsla() notation to the\nmodern space and slash separated syntax in DevTools CSS files and in the\nshipped themed SVG icons. Every converted value is numerically identical to\nthe original.\n\nDeliberately left unchanged: test fixtures and expectations (computed values\nstill serialize to the legacy syntax), the vendored CodeMirror stylesheets,\nand the contributor docs diagrams. The remaining occurrences in JS files can\nbe handled in a follow-up, since most of them are computed-value assertions\nin tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322271\n", "files": ["devtools/client/aboutdebugging/src/base.css", "devtools/client/accessibility/accessibility.css", "devtools/client/application/src/base.css", "devtools/client/debugger/src/components/Editor/Editor.css", "devtools/client/debugger/src/components/Editor/Preview/Popup.css", "devtools/client/debugger/src/components/PrimaryPanes/ProjectSearch.css", "devtools/client/debugger/src/components/shared/menu.css", "devtools/client/debugger/src/components/variables.css", "devtools/client/debugger/src/utils/editor/source-editor.css", "devtools/client/jsonview/css/search-box.css", "devtools/client/netmonitor/src/assets/styles/CustomRequestPanel.css", "devtools/client/netmonitor/src/assets/styles/HTTPCustomRequestPanel.css", "devtools/client/netmonitor/src/assets/styles/RequestList.css", "devtools/client/netmonitor/src/assets/styles/variables.css", "devtools/client/responsive/index.css", "devtools/client/responsive/responsive-browser.css", "devtools/client/shared/components/NotificationBox.css", "devtools/client/shared/components/tree/TreeView.css", "devtools/client/themes/animation.css", "devtools/client/themes/badge.css", "devtools/client/themes/boxmodel.css", "devtools/client/themes/changes.css", "devtools/client/themes/chart.css", "devtools/client/themes/common.css", "devtools/client/themes/components-frame.css", "devtools/client/themes/computed.css", "devtools/client/themes/dark-theme.css", "devtools/client/themes/images/angle-swatch.svg", "devtools/client/themes/images/browsers/chrome.svg", "devtools/client/themes/images/browsers/edge.svg", "devtools/client/themes/images/browsers/firefox.svg", "devtools/client/themes/images/browsers/ie.svg", "devtools/client/themes/images/browsers/opera.svg", "devtools/client/themes/images/browsers/safari.svg", "devtools/client/themes/layout.css", "devtools/client/themes/light-theme.css", "devtools/client/themes/markup.css", "devtools/client/themes/memory.css", "devtools/client/themes/rules.css", "devtools/client/themes/toolbars.css", "devtools/client/themes/toolbox.css", "devtools/client/themes/tooltips.css", "devtools/client/themes/variables.css", "devtools/client/themes/widgets.css", "devtools/server/actors/highlighters/css/highlighters.css"], "git_node": "7493f83176758f519e9898539ec3e32f56281235", "git_parents": ["1a826a5cb2e162431cbedbfa5d2dfef7306a7256"], "node": "fd35276941b94ce05f96de4b4b86d63c78ada1fc", "parents": ["f8aa7aa83bbef13454060add00f11a3b807c8344"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065079 - add test for unexpected PrP prompts r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321829\n", "files": ["toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_autofill_primary_password.js"], "git_node": "bf8202c831a95c561481a193dc008400da21a559", "git_parents": ["7493f83176758f519e9898539ec3e32f56281235"], "node": "49d0f78b5a7af40d4e441c2b5106226ccc1d0221", "parents": ["fd35276941b94ce05f96de4b4b86d63c78ada1fc"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065441 - filter autofill login candidates without decryption r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321830\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs"], "git_node": "75c2245d19fbf81babf6e73d7920966c24b61f6b", "git_parents": ["bf8202c831a95c561481a193dc008400da21a559"], "node": "e1434c3c76d1306c047f520ac1e4478fc3ee4960", "parents": ["49d0f78b5a7af40d4e441c2b5106226ccc1d0221"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065441 - stop racing the context menu login lookup r=dimi,firefox-desktop-core-reviewers ,mossop\n\nThe password manager items are filled into the content context menu after it is\nalready shown: initPasswordManagerItems() leaves \"fill-login\" hidden and\nupdatePasswordManagerSubMenuItems() reveals it once the login lookup resolved.\nA result arriving after the menu was dismissed is appended regardless, so its\nitems are still sitting in the popup when the menu is opened next.\n\nHand the lookup an AbortSignal and abort it from hiding().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322582\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_context_menu.js", "toolkit/components/passwordmgr/test/browser/head.js"], "git_node": "f849fa8e882d2e73f0f38c3916f855425262ae21", "git_parents": ["75c2245d19fbf81babf6e73d7920966c24b61f6b"], "node": "4b34f05c4c23c50b363a363555e2a3c4edd4c1c6", "parents": ["e1434c3c76d1306c047f520ac1e4478fc3ee4960"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2068313 - Use TextTransformCase in layout. r=firefox-style-system-reviewers,layout-reviewers,emilio\n\nUnlike the `TextTransform` bitflags, the `TextTransformCase` enum makes\nit obvious that the different cases aren't overlapping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322807\n", "files": ["layout/generic/nsTextRunTransformations.cpp", "servo/ports/geckolib/cbindgen.toml", "servo/ports/geckolib/glue.rs"], "git_node": "240cc9c61aec26ba27477fdc04dead12f55fcf82", "git_parents": ["f849fa8e882d2e73f0f38c3916f855425262ae21"], "node": "c3c245550bfaa1f86dd48d794f858b1469693fdc", "parents": ["4b34f05c4c23c50b363a363555e2a3c4edd4c1c6"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2065541 - Extract privacy report worker scheduling. r=android-reviewers,gmalekpour\n\nMove privacy report notification worker scheduling out of HomeActivity\n into a dedicated lifecycle-aware scheduler.\n\n Register PrivacyReportNotificationScheduler as a HomeActivity lifecycle\n observer and move its scheduling tests out of HomeActivityTest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322609\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationScheduler.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/HomeActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationSchedulerTest.kt"], "git_node": "14d7c99f9f7cdbbf6d95bc57ff7fce55591705fc", "git_parents": ["240cc9c61aec26ba27477fdc04dead12f55fcf82"], "node": "4260648bee56de1c169e2ef6f2247d5e40efc164", "parents": ["c3c245550bfaa1f86dd48d794f858b1469693fdc"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063327 - Test that picking a realtime Suggest row doesn't record input history. r=adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322254\n", "files": ["browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_realtime_market.js"], "git_node": "dcb391ec26bca17c7f4c65a1c127ff9d40f61190", "git_parents": ["14d7c99f9f7cdbbf6d95bc57ff7fce55591705fc"], "node": "1ea8b81d2f928310ac8e8b5e7aa4b498b39752f0", "parents": ["4260648bee56de1c169e2ef6f2247d5e40efc164"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066659 part 1 - Replace LiveRange::usesSpillWeight_ with numRegisterUses_ and numAnyUses_ counters. r=jseward\n\nThis is a small refactoring with no difference in behavior. The next patch will\nalso use these counters.\n\n`LiveRange` already had `numFixedUses_` so if we add `numRegisterUses_` and `numAnyUses_`\nwe can compute the uses spillweight from these three values.\n\nThis patch doesn't change `sizeof(LiveRange)` on 64-bit because it replaces a\n`size_t` with two `uint32_t` fields.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321465\n", "files": ["js/src/jit/BacktrackingAllocator.cpp", "js/src/jit/BacktrackingAllocator.h"], "git_node": "42406c4afdfb81b07fc5f2efa84dc6d56dec8ba7", "git_parents": ["dcb391ec26bca17c7f4c65a1c127ff9d40f61190"], "node": "6d8c0ec0b95c83d051bdb072d8d6eb352cc1000d", "parents": ["1ea8b81d2f928310ac8e8b5e7aa4b498b39752f0"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066659 part 2 - Avoid checking all uses in BacktrackingAllocator::computeRequirement for ranges with no fixed uses. r=jseward\n\n`computeRequirement` can be very hot for large JS functions with many variables, due\nto a very large number of keepalive uses for bailout snapshots. In Google Docs profiles,\n`computeRequirement` can be 25-40% of off-thread Ion compilation time.\n\nWe can use the `numRegisterUses`/`numAnyUses` counters added in the previous patch\nto optimize this in common cases (no fixed uses). This preserves behavior and eliminates\n98+% of use-checks in this function for JS workloads. For Wasm code the win is smaller\nbut still ~30-60% on x64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321466\n", "files": ["js/src/jit/BacktrackingAllocator.cpp"], "git_node": "3198f3add27625288986c2f3df1550938d794c71", "git_parents": ["42406c4afdfb81b07fc5f2efa84dc6d56dec8ba7"], "node": "fa1f30cce09c1e3458aa03e9cd484f5326517c4b", "parents": ["6d8c0ec0b95c83d051bdb072d8d6eb352cc1000d"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038575 - Add test. r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299996\n", "files": ["js/src/jit-test/tests/iterator/bug2038575.js"], "git_node": "31e3c7b1107a28e0579c1ddc745195e3204ba8a7", "git_parents": ["3198f3add27625288986c2f3df1550938d794c71"], "node": "3780b36f0e61ad2d7df1e145581dfc74140111c9", "parents": ["fa1f30cce09c1e3458aa03e9cd484f5326517c4b"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045572 - Add test. r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305120\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/cacheir/stub-fold-too-large.js", "js/src/vm/ShapeZone.h"], "git_node": "a87e426b319b87e88062d0cb7bf1230b4c3887fa", "git_parents": ["31e3c7b1107a28e0579c1ddc745195e3204ba8a7"], "node": "a7d19322e6cc5e4dc7100a0c89cae71c7b78674b", "parents": ["3780b36f0e61ad2d7df1e145581dfc74140111c9"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045454 - Add test. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305182\n", "files": ["js/src/jit-test/tests/regexp/replace-overridden-exec-many-captures.js"], "git_node": "582f254ab166412888c0ef21c8c78a8a018b5ddb", "git_parents": ["a87e426b319b87e88062d0cb7bf1230b4c3887fa"], "node": "d4b89b7ae97349678ca1c403c69b17b6f4c22c9b", "parents": ["a7d19322e6cc5e4dc7100a0c89cae71c7b78674b"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045307 - Add test. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305466\n", "files": ["js/src/jit-test/tests/gc/bug2045307.js"], "git_node": "6d3e311375183e6c6003054d4443ce930f16e1cd", "git_parents": ["582f254ab166412888c0ef21c8c78a8a018b5ddb"], "node": "e9823f80dc966a88c42eea16e0fe910adefc833c", "parents": ["d4b89b7ae97349678ca1c403c69b17b6f4c22c9b"], "tags": []}, {"author": "Smagin Ivan \u003csmag.vav@gmail.com\u003e", "branch": "default", "desc": "Bug 2061540 - Remove non-existent interface from QI list in SimpleURIUnknownSchemesRemoteObserver. r=valentin,necko-reviewers\n\nThe component only implements nsIObserver. The nsISimpleURIUnknownSchemesRemoteObserver\ninterface does not exist anywhere in the tree and appears to be leftover detritus\nfrom earlier review iterations. Cleaning up the QI list keeps the implementation accurate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322634\n", "files": ["netwerk/base/SimpleURIUnknownSchemesRemoteObserver.sys.mjs"], "git_node": "d995311fc1a1d103e6b97207f9418a6f3a90eb0f", "git_parents": ["6d3e311375183e6c6003054d4443ce930f16e1cd"], "node": "a0995a4dce7675b45479ba3f4424cb29b4d8a49d", "parents": ["e9823f80dc966a88c42eea16e0fe910adefc833c"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2065249 - Record modifier keys in engagement telemetry r=adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322208\n", "files": ["browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/metrics.yaml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser.toml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_modifiers.js"], "git_node": "0c9f3ccebd494d4a81ad26bd28e3a7a6c6e346fd", "git_parents": ["d995311fc1a1d103e6b97207f9418a6f3a90eb0f"], "node": "01610f0a89918dc7b530bde3a7135129f7f79e0f", "parents": ["a0995a4dce7675b45479ba3f4424cb29b4d8a49d"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065174 - Add syncEnabled to sync state storage layer to enable us track whether sync is enabled or not r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322578\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/SyncStateStorage.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/SharedPrefsSyncStateStorageTest.kt"], "git_node": "245989fd24883c583431aab3f73f9e6d5c80c814", "git_parents": ["0c9f3ccebd494d4a81ad26bd28e3a7a6c6e346fd"], "node": "e2d25ec2ca8ac86c0406e8a57caf87074308d1d1", "parents": ["01610f0a89918dc7b530bde3a7135129f7f79e0f"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067366 - Restore the scrollbar in menulist popups. r=desktop-theme-reviewers,emilio\" for causing mochitest failures @ test_menulist_scrollbar.xhtml\n\nThis reverts commit 85e05f2d5045c05bce7cf2b477b7b7442012cf9e.\n", "files": ["browser/base/content/test/forms/browser_selectpopup_colors.js", "toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/test_menulist_scrollbar.xhtml", "toolkit/content/widgets/menupopup.css"], "git_node": "edfc14d649dbdbe05934350335891511d62b2f06", "git_parents": ["245989fd24883c583431aab3f73f9e6d5c80c814"], "node": "7843c9f712497b2b1cc40a4839df0335b4996445", "parents": ["e2d25ec2ca8ac86c0406e8a57caf87074308d1d1"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068256 - Make editor/libeditor/tests/test_paste_command_data.html stable on Wayland; r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322741\n", "files": ["editor/libeditor/tests/test_paste_command_data.html"], "git_node": "3c6fe0d62e9cde1e172ca8e6cdd3f57339355718", "git_parents": ["edfc14d649dbdbe05934350335891511d62b2f06"], "node": "fe8261beb304088d15e088d4d8420bca65674140", "parents": ["7843c9f712497b2b1cc40a4839df0335b4996445"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2068139 - Make xml:lang work like a regular mapped attribute. r=dom-core-reviewers,hsivonen\n\nThis unblocks bug 2064900, and in general is more consistent.\n\nNo behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322654\n", "files": ["dom/base/Element.cpp", "dom/base/Element.h", "dom/html/nsGenericHTMLElement.cpp", "dom/mathml/MathMLElement.cpp", "dom/svg/SVGElement.cpp", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "layout/style/MappedDeclarationsBuilder.h", "servo/components/style/gecko/wrapper.rs"], "git_node": "1e063d804924a1a55f97a83e4461654080e7a5ed", "git_parents": ["3c6fe0d62e9cde1e172ca8e6cdd3f57339355718"], "node": "3b1f1b5121e81ea9b7ad0bab6dcf3616c623b9f1", "parents": ["fe8261beb304088d15e088d4d8420bca65674140"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067031 - Null-check mTransaction after OnMsgReclaimConnection in DnsAndConnectSocket::SetupConn, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321898\n", "files": ["netwerk/protocol/http/DnsAndConnectSocket.cpp"], "git_node": "32e0d528a0646b43c3acd4cc916219a0db940f9f", "git_parents": ["1e063d804924a1a55f97a83e4461654080e7a5ed"], "node": "5c92e903f83e8f3288b28168a3cc30371e657212", "parents": ["3b1f1b5121e81ea9b7ad0bab6dcf3616c623b9f1"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064808 - Don't snap a border's thickness across a perspective transform r=gw\n\nNormalBorderData::update snaps a border edge to a whole device pixel by\nrewriting the width in layout space as round(w * s) / s, where s comes from\nscale_factors() on the primitive to device transform. That helper reads only\nthe 2d linear block of the matrix and ignores the perspective row, so for\nperspective(d) * rotateX(theta) it returns (1.0, |cos theta|).\n\nThe snapped width is then fed to create_border_segments, so the border's\ngeometry grows into the content box as the element tilts: a 1px edge becomes\n1.41px at 45 degrees, 2px at 60, and 11.5px at 85, and the growth is unbounded.\nrotateY gives the mirror case on the vertical edges. The correction is\nmeaningless under perspective regardless of magnitude, because w varies across\nthe border box and no single device scale describes the edge.\n\nGate the snap on coplanar_scale_factors(), which returns None exactly when the\ntransform has a real perspective component and otherwise yields the affine\nscale divided through by m44. The cases the snap was written for (bug 1258112,\nbug 1950029) are pure 2d scales and stay coplanar, as do flattened 3d\nrotations, where a single scale does exist.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321862\n", "files": ["gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/wrench/reftests/snap/border-perspective-thickness-ref.yaml", "gfx/wr/wrench/reftests/snap/border-perspective-thickness.yaml", "gfx/wr/wrench/reftests/snap/reftest.list"], "git_node": "733ff738f7dd1e1be1b9061c3921c17ba16a3992", "git_parents": ["32e0d528a0646b43c3acd4cc916219a0db940f9f"], "node": "499474e632851d6381c293eea34e1a478b0c22cb", "parents": ["5c92e903f83e8f3288b28168a3cc30371e657212"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068487 - Always pass target arch to clang-cl when cross-building r=firefox-build-system-reviewers,glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322857\n", "files": ["build/moz.configure/toolchain.configure"], "git_node": "60abc00846decf1ad56a3973aba6b5b574d5b37a", "git_parents": ["733ff738f7dd1e1be1b9061c3921c17ba16a3992"], "node": "5aabf37c6b4281de2fb53d20b06e30568099ec0b", "parents": ["499474e632851d6381c293eea34e1a478b0c22cb"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2067216 - Document running wrench with SWGL when distrobox is unavailable. r=ai4dev-reviewers,padenot\n\nDistrobox isn't usable from inside a sandbox, but wrench can still be run headless with SWGL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321937\n", "files": ["gfx/wr/AGENTS.md"], "git_node": "e0a4d7dffe243b078510928b5d1290b663576d9f", "git_parents": ["60abc00846decf1ad56a3973aba6b5b574d5b37a"], "node": "0f40eb1041a900061a133f5574ad262cde18169f", "parents": ["5aabf37c6b4281de2fb53d20b06e30568099ec0b"], "tags": []}], "date": 1788365486, "git_changesets": ["6f6851e96dba5d1e67a02fd0948726ae0aba8426", "3986257e92a0eaf9bb102425a87ee2a34d2182ee", "a05b5cb150f22fddce8d93489eb2e46f6c24ad0d", "54314547710d64b6b2290a7ab572923b859065c6", "22865964ba6bdcfbfe60c226de488990680b9dc1", "385b4d7a46edd87dd951f8aa155bbd716bbdaea5", "dfcb1075510e95b2edb7e62a4c38239c4ee75407", "85e05f2d5045c05bce7cf2b477b7b7442012cf9e", "97cc757125e43b2a7f1985b135d742374b06384d", "e25f9777eb48234f95e4b4e6b539501625006c27", "39f51b60f36ef9ee4c5781bc2fd3542903c372e9", "a6b8bdb415193561958ca2a88a92b8431ef38839", "48d6dacd0d9c2a5f275db9e9387b5f696179c5cb", "9c41da3047b1942f2fc60ab74e1c6f243342d36e", "1a826a5cb2e162431cbedbfa5d2dfef7306a7256", "7493f83176758f519e9898539ec3e32f56281235", "bf8202c831a95c561481a