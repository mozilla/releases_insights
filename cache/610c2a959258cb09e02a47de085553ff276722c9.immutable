r past. r=alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323724\n", "files": ["dom/media/platforms/MediaCodecsSupport.cpp"], "git_node": "c955ed29d4bde6dfeefffde55b20deea238f1636", "git_parents": ["fc02de71f2a2c27a1770e4155f7223aa993fdd13"], "node": "707a1a13532a0286631f58e28114fc77a2de4fe2", "parents": ["05629f6c0ed9e2c991fb90107c6c85fe2a638404"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068355 - Recover the stack pointer after the call in the wasm continuation base frame stub. r=jpages\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323412\n", "files": ["js/src/jit-test/tests/wasm/stack-switching/bug2068355.js", "js/src/wasm/WasmStubs.cpp"], "git_node": "a58ebc2a5814089524936f44b04ee96ef88beb31", "git_parents": ["c955ed29d4bde6dfeefffde55b20deea238f1636"], "node": "9989e54a7daa915f9394aeea6b035565e7854271", "parents": ["707a1a13532a0286631f58e28114fc77a2de4fe2"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-hr/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/feature/protection-dashboard/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-hr/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml"], "git_node": "073456fd1195fea20223da5b269ea77dbe956d10", "git_parents": ["a58ebc2a5814089524936f44b04ee96ef88beb31"], "node": "c6b6b5bc8fe054ffcf63283e5c6bf7f625ba74ce", "parents": ["9989e54a7daa915f9394aeea6b035565e7854271"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068035 - Update mochitests to use the correct headers and WPT expectations for Permissions-Policy.\" for causing failures at serial-disabled-by-permissions-policy.https.sub.html.\n\nThis reverts commit e0a5a755cc0daeae55798c4f9616cc2b20f34ff3.\n\nRevert \"Bug 2068035 - Rename policy methods used for iframe allow attributes. r=simonf\"\n\nThis reverts commit c58d870636dc29a64c56938b1ac1bb953edb39fe.\n\nRevert \"Bug 2068035 - Renamed Feature-Policy to Permissions-Policy and switched to SFV parser r=simonf\"\n\nThis reverts commit 9b7e68aac74909fbd1343075e79d384c4a326bc2.\n", "files": ["dom/base/Document.cpp", "dom/html/HTMLIFrameElement.cpp", "dom/security/featurepolicy/FeaturePolicy.cpp", "dom/security/featurepolicy/FeaturePolicy.h", "dom/security/featurepolicy/FeaturePolicyParser.cpp", "dom/security/featurepolicy/FeaturePolicyParser.h", "dom/security/featurepolicy/fuzztest/fp_fuzzer.cpp", "dom/security/featurepolicy/test/gtest/TestFeaturePolicyParser.cpp", "dom/security/featurepolicy/test/mochitest/file_xslt.html^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt.xml^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt.xsl^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt_outer.html^headers^", "dom/security/featurepolicy/test/mochitest/test_parser.html^headers^", "testing/web-platform/meta/mediacapture-streams/MediaDevices-enumerateDevices-not-allowed-camera.https.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaDevices-enumerateDevices-not-allowed-mic.https.html.ini", "testing/web-platform/meta/serial/serial-disabled-by-permissions-policy.https.sub.html.ini"], "git_node": "16f554d36c85b1e701664728d3a310840e7abecb", "git_parents": ["073456fd1195fea20223da5b269ea77dbe956d10"], "node": "e0b4e4a38a25008561cef905a39e44caf578ecf6", "parents": ["c6b6b5bc8fe054ffcf63283e5c6bf7f625ba74ce"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2038810 - Resolve l10n merge tree paths relative to the app's locale top dir r=firefox-build-system-reviewers,ahochheiden\n\n`l10n_stage` derives merge tree paths from a context's topsrcdir-relative\n`relsrcdir`, so `comm/mail/locales` reads from `\u003cmerge\u003e/comm/mail`. comm-central\nlocalizes from `commtopsrcdir` and its `l10n.toml` is rooted there too, so\nl10n-central content actually lands at `\u003cmerge\u003e/mail` and every comm context\nfails with `MissingJarSource`.\n\nAdd a per-context `locale_relsrcdir` to `l10n-manifest.json`, re-rooted at\n`commtopsrcdir` when the context lives under it. This is what `config.mk`'s\n`LOCALE_TOPDIR` / `LOCALE_RELATIVEDIR` did for the legacy driver. en-US sources\nkeep resolving against `topsrcdir/relsrcdir`; only merge tree lookups use the\nnew value, so Firefox and Android builds are unaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323702\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py", "python/mozbuild/mozbuild/frontend/l10n_manifest.py", "python/mozbuild/mozbuild/test/action/test_l10n_stage.py", "python/mozbuild/mozbuild/test/frontend/test_l10n_manifest.py"], "git_node": "f63f76937210982ede2b9aa36020b518f0850078", "git_parents": ["16f554d36c85b1e701664728d3a310840e7abecb"], "node": "662e62026af75e3b2d0e437b7ac9a9e8428cea9c", "parents": ["e0b4e4a38a25008561cef905a39e44caf578ecf6"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2038810 - Build a repack's NSIS helper from the app's own installer dir r=firefox-build-system-reviewers,ahochheiden\n\n`repackage-zip-%` passes `--installer-dir='$(DEPTH)/browser/installer/windows'`,\nso a Thunderbird Windows repack compiles `helper.exe` out of Firefox's installer\ndirectory. The legacy recipe used `$(MAKE) -C ../installer/windows`, relative to\nthe including app's `locales` directory. Use `$(DEPTH)/$(MOZ_BUILD_APP)/installer/windows`\ninstead, which resolves to the same path for `browser/locales`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323703\n", "files": ["toolkit/locales/l10n.mk"], "git_node": "5b0d2408be59c18467669ed8d74453d21370cf68", "git_parents": ["f63f76937210982ede2b9aa36020b518f0850078"], "node": "0fe2d6e6b867788215426424ad2eaac393aac48d", "parents": ["662e62026af75e3b2d0e437b7ac9a9e8428cea9c"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067092 - Generate the mozbuild sandbox symbols reference as Markdown. r=firefox-build-system-reviewers,sergesanspaille\n\nThe `mozbuildsymbols` directive fed its generated reStructuredText back into the\nincluding document with `state_machine.insert_input()`, which MyST does not\nimplement, so the page could not be converted to Markdown.\n\nRather than reach into docutils to parse the generated text by hand, drop the\ndirective and write the page out as Markdown, next to the mots export. Sphinx\nthen reads it like any other page, which is what keeps the section nesting, the\n`mozbuild_subcontext_*` targets and the cross references working. The page is\nwritten to the staging directory rather than to `build/docs`, so nothing is\ngenerated in the source tree.\n\nThe docstrings the reference is built from move to Markdown as well: the\nindented literal blocks become `python` fenced code blocks, as moz.build is a\nPython dialect, the double backtick literals become single backtick code spans,\nthe `^^^` underlined headings become `####`, and the two `:ref:` roles become\n`{ref}`, pointing at the labels the pages they target actually define now (they\nhad been dangling, which the allowed warnings for `context.py` were hiding).\nDocstrings that `sphinx.ext.autodoc` renders as well stay reStructuredText and\nare embedded in an `eval-rst` fence, the same way D321834 keeps the Python API\ndocumentation working.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321833\n", "files": ["build/docs/mozbuild-symbols.rst", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/sphinx.py"], "git_node": "63d8c55fcfa46f751f93d514962e408e3cc18cfb", "git_parents": ["5b0d2408be59c18467669ed8d74453d21370cf68"], "node": "cd07e5e07f7cf586fdbdedcc39d11ef011297f6b", "parents": ["0fe2d6e6b867788215426424ad2eaac393aac48d"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067092 - Generate the Python API documentation as Markdown. r=firefox-source-docs-reviewers,jdescottes,ahal\n\n`sphinx.ext.apidoc` emits reStructuredText by default, which is the last thing\nin the build producing rst. Point it at Markdown templates and generate the\npages with a `.md` suffix. The `automodule` calls stay inside `eval-rst` fences\nso the Python docstrings, which are written in rst, keep being parsed as rst.\n\nThe marionette docstrings relied on named hyperlink targets, whose definitions\ndo not resolve across an `eval-rst` boundary; use embedded URIs instead. Also\nupdate the links pointing at the generated `marionette_driver` page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321834\n", "files": ["remote/doc/marionette/Intro.md", "remote/doc/marionette/PythonTests.md", "remote/doc/marionette/index.md", "testing/marionette/client/marionette_driver/addons.py", "testing/marionette/client/marionette_driver/localization.py", "tools/moztreedocs/__init__.py", "tools/moztreedocs/apidoc_templates/module.rst.jinja", "tools/moztreedocs/apidoc_templates/package.rst.jinja", "tools/moztreedocs/apidoc_templates/toc.rst.jinja"], "git_node": "6f15ec52a4f2dcce3eaadb96cc31ef1caa6f41e1", "git_parents": ["63d8c55fcfa46f751f93d514962e408e3cc18cfb"], "node": "d130c6e1368dbfbe975b393174951d0cc65fb38c", "parents": ["cd07e5e07f7cf586fdbdedcc39d11ef011297f6b"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2067092 - Stop building the documentation from reStructuredText. r=firefox-source-docs-reviewers,ahal\n\nEvery page is Markdown now, so drop `.rst` from `source_suffix` and clean up the\n`.rst` references left in the configuration, in `mach doc` itself, and in the\ndocumentation about the documentation.\n\n`eval-rst` blocks are unaffected: they are a MyST feature, independent of\n`source_suffix`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321835\n", "files": ["docs/conf.py", "docs/config.yml", "tools/moztreedocs/docs/architecture.md", "tools/moztreedocs/docs/jsdoc-support.md", "tools/moztreedocs/docs/mdn-import.md", "tools/moztreedocs/mach_commands.py"], "git_node": "e709bfa957c705adc4c35d23ed787f07d108594b", "git_parents": ["6f15ec52a4f2dcce3eaadb96cc31ef1caa6f41e1"], "node": "e308123a029eb00da2659a80388b85dbfe1b7198", "parents": ["d130c6e1368dbfbe975b393174951d0cc65fb38c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2067092 - Remove the leftover rstcheck comments. r=devtools-reviewers,geckoview-reviewers,chutten,ochameau,tcampbell\n\nThe rst linter was removed in bug 2038819, so these `% rstcheck:` comments no\nlonger configure anything.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321836\n", "files": ["build/docs/defining-xpcom-components.md", "build/docs/test_manifests.md", "devtools/docs/user/devtoolsapi/index.md", "mobile/android/docs/geckoview/contributor/geckoview-architecture.md", "python/mach/docs/commands.md", "testing/mozbase/docs/manifestparser.md", "testing/mozbase/docs/mozproxy.md", "toolkit/components/telemetry/docs/obsolete/collection/scalars.md"], "git_node": "ecb4c3c5c23cd1c3e1947e13016fbffcc96849e8", "git_parents": ["e709bfa957c705adc4c35d23ed787f07d108594b"], "node": "e1bfe88461f7e00f7bd28234addf6ca937cdbc86", "parents": ["e308123a029eb00da2659a80388b85dbfe1b7198"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2067092 - Document the perfdocs files with the extension they actually use. r=firefox-source-docs-reviewers,ahal\n\nThe perfdocs linter reads `index.md` and `metrics.md`; the page still described\nthem as rst files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321837\n", "files": ["docs/code-quality/lint/linters/perfdocs.md"], "git_node": "b125c966ee9ae22890338f901cde61c813911896", "git_parents": ["ecb4c3c5c23cd1c3e1947e13016fbffcc96849e8"], "node": "6b5dac01132682723050627a411d0528b86bd645", "parents": ["e1bfe88461f7e00f7bd28234addf6ca937cdbc86"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2067092 - Update the agent skills for the Markdown-only documentation. r=ai4dev-reviewers,suhaib\n\nDrop the rstcheck linter, removed in bug 2038819, from the mozlint skill, and\nthe mentions of `.rst` sources from the documentation skill.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321838\n", "files": [".agents/skills/documentation/SKILL.md", ".agents/skills/mozlint/SKILL.md", ".claude/skills/documentation/SKILL.md", ".claude/skills/mozlint/SKILL.md"], "git_node": "62f88e0aefea9f8b9a5889f67883285f3ac1e9b0", "git_parents": ["b125c966ee9ae22890338f901cde61c813911896"], "node": "8c960b512c39e89f4660f2817fda610dc137c976", "parents": ["6b5dac01132682723050627a411d0528b86bd645"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2067092 - Replace the dead MDN links in the Marionette and Remote Agent comments. r=jdescottes\n\nThe mzl.la shortlink and the Add-on Manager page on MDN are both gone.\nPoint at the in-tree localization docs and at the AddonManager.ERROR_*\nconstants instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321839\n", "files": ["remote/marionette/l10n.sys.mjs", "remote/shared/Addon.sys.mjs"], "git_node": "0ac7be08f030196b4eff175df90848a6ff757444", "git_parents": ["62f88e0aefea9f8b9a5889f67883285f3ac1e9b0"], "node": "894540a4bf25fc35650a32f1e0e81a24cfb6dff6", "parents": ["8c960b512c39e89f4660f2817fda610dc137c976"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2068055 - Add tests for newtab searches from switcher. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322725\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser_searchTelemetry.js"], "git_node": "afd538d44cc9a4cf66dd30a4d250adf8f04b6465", "git_parents": ["0ac7be08f030196b4eff175df90848a6ff757444"], "node": "4a39b94ba1679a94660a5c1691024880c54f8c84", "parents": ["894540a4bf25fc35650a32f1e0e81a24cfb6dff6"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063662 - Report card column in New Tab story card impression and click telemetry. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323043\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/DSCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamImpressionStats/ImpressionStats.jsx", "browser/extensions/newtab/content-src/lib/utils.jsx", "browser/extensions/newtab/lib/NewTabContentPing.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/unit/content-src/lib/utils.test.jsx", "browser/extensions/newtab/test/xpcshell/test_NewTabContentPing.js"], "git_node": "a6f2cd79fdd15362792930fda3334c17207edcc5", "git_parents": ["afd538d44cc9a4cf66dd30a4d250adf8f04b6465"], "node": "cd7016045dd6a8ff1dae6d4b1e0c9c4b2eeb41dd", "parents": ["4a39b94ba1679a94660a5c1691024880c54f8c84"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - CI/Toolchain updates for Python `3.10` r=firefox-build-system-reviewers,sergesanspaille,jcristau\n\nThe Python toolchain we build is now version `3.10.11`, the last `3.10` with\nan official Windows installer for `pack-cpython.sh` to extract.\n\nThe Debian 11 bootstrap task goes away because bullseye ships nothing newer\nthan Python 3.9. The supported build hosts are the current stable and testing\nreleases, Debian 13 and 14, which keep their tasks. Rocky Linux 9 installs\n`python3.11` and puts it first on `PATH` as `python3`, since its `python3`\npackage stays at 3.9.\n\nThe Linux test tasks run on the fetched CI Python, so the `dbus-python`, `pygobject`\nand `pycairo` wheel tasks now build against it and are named by Python version.\nThe distro keyed wheel tasks and images were unused and were removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322844\n", "files": ["build/wheel_requirements.txt", "python/sites/wpt.txt", "taskcluster/kinds/bootstrap/kind.yml", "taskcluster/kinds/docker-image/kind.yml", "taskcluster/kinds/fetch/python-wheels.yml", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/source-test/python.yml", "taskcluster/kinds/test/compiled.yml", "taskcluster/kinds/test/kind.yml", "taskcluster/kinds/test/misc.yml", "taskcluster/kinds/test/xpcshell.yml", "taskcluster/kinds/toolchain/python-wheels.yml", "taskcluster/kinds/toolchain/python.yml", "taskcluster/kinds/web-platform-tests/kind.yml"], "git_node": "f1709d5ed1b07b0df2fd99db7c3c3ebaa9ab8a5d", "git_parents": ["a6f2cd79fdd15362792930fda3334c17207edcc5"], "node": "e08e77eab9c9ccdd267a8c8e1ba397efb9e81e15", "parents": ["cd7016045dd6a8ff1dae6d4b1e0c9c4b2eeb41dd"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - Bump `mach` minimum `Python` version to `3.10` r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322845\n", "files": ["build/docs/python.md", "js/src/jit-test/README", "mach", "python/mach/docs/windows-usage-outside-mozillabuild.md", "python/mozboot/bin/bootstrap.py", "python/sites/bhr-aggregate.txt", "python/sites/build.txt", "python/sites/buildconfig.txt", "python/sites/common.txt", "python/sites/devtools-compat-test.txt", "python/sites/docs.txt", "python/sites/generate-test-certs.txt", "python/sites/ide.txt", "python/sites/ipython.txt", "python/sites/lint.txt", "python/sites/mach.txt", "python/sites/manifest.txt", "python/sites/newtab.txt", "python/sites/perftest-side-by-side.txt", "python/sites/perftest-test.txt", "python/sites/python-test.txt", "python/sites/repackage-deb.txt", "python/sites/repackage-desktop-file.txt", "python/sites/repackage-rpm.txt", "python/sites/repackage-snap.txt", "python/sites/taskgraph.txt", "python/sites/try.txt", "python/sites/update.txt", "python/sites/uv.txt", "python/sites/watch.txt", "python/sites/webcompat.txt", "python/sites/wpt-interop.txt", "python/sites/wpt.txt", "third_party/python/pyproject.toml"], "git_node": "07d0250f77cf200ed17d380bc2b84d0073ce5db1", "git_parents": ["f1709d5ed1b07b0df2fd99db7c3c3ebaa9ab8a5d"], "node": "822a530aedc08a0b2d52d62ac4d8418c91be4cd4", "parents": ["e08e77eab9c9ccdd267a8c8e1ba397efb9e81e15"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - Regenerate the `Python` lockfiles for the new minimum `3.10` r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahal\n\n`./mach vendor python` covers `third_party/python` and moves no package\nversion. `taskcluster/requirements.txt` is compiled by its own command and\nneeded a matching `--python-version`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322846\n", "files": ["taskcluster/requirements.txt", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "bc748b1035eb6900057027ff6e3b7bb8e2f88c03", "git_parents": ["07d0250f77cf200ed17d380bc2b84d0073ce5db1"], "node": "a83947ed2bcb014eb55654c66cbf63d6af663d1c", "parents": ["822a530aedc08a0b2d52d62ac4d8418c91be4cd4"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - Remove workarounds for `Python` versions below `3.10` r=firefox-build-system-reviewers,mozperftest-reviewers,sergesanspaille,sparky\n\nThe `mozperftest` numpy and scipy pins existed because `3.9` resolved\n`numpy\u003e=1.23` to a `2.x` source archive on the internal mirror (bug 2033807).\n\n`mozpack/archive.py` keeps reproducing the older tar behaviour, since docker\nimage hashes are keyed on that output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322847\n", "files": ["python/mozbuild/mozpack/archive.py", "python/mozbuild/mozpack/unify.py", "python/mozperftest/mozperftest/runner.py", "python/mozperftest/mozperftest/tests/test_mach_commands.py", "python/sites/docs.txt", "testing/gtest/reports.py"], "git_node": "8cb0b6acd2ff4f37f5ef0b2f42293770addc9115", "git_parents": ["bc748b1035eb6900057027ff6e3b7bb8e2f88c03"], "node": "9db606cd2b28f2ff7ade9a1cfdf7982b2645d606", "parents": ["a83947ed2bcb014eb55654c66cbf63d6af663d1c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - `wpt` related Python `3.9` to `3.10` compatibility changes r=jgraham\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322848\n", "files": ["taskcluster/kinds/source-test/wpt-unittest.yml"], "git_node": "3068ac98f43a7db22b75e4c32d0fae07f2b22406", "git_parents": ["8cb0b6acd2ff4f37f5ef0b2f42293770addc9115"], "node": "2b0bc3ef554dc7f5a11f420f9f679d5b5db726dd", "parents": ["9db606cd2b28f2ff7ade9a1cfdf7982b2645d606"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - Bump vendored `pip` and `setuptools` past their `3.8` pins r=ahal,mach-reviewers\n\nUpdated pip v25.0.1 -\u003e v25.2\nUpdated setuptools v75.3.1 -\u003e v82.0.1\n\nAlso updated the wheels of these vendored in `third_party/python/_venv/wheels/` to match.\n\npip can't go past `25.2` because `25.3` removes `--no-use-pep517`, which mozharness\nneeds to avoid a CI regression, see bug 1858663.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322849\n", "files": ["third_party/python/_venv/wheels/pip-25.0.1-py3-none-any.whl", "third_party/python/_venv/wheels/pip-25.2-py3-none-any.whl", "third_party/python/_venv/wheels/setuptools-75.3.1-py3-none-any.whl", "third_party/python/_venv/wheels/setuptools-82.0.1-py3-none-any.whl", "third_party/python/pip/pip-25.0.1.dist-info/AUTHORS.txt", "third_party/python/pip/pip-25.0.1.dist-info/LICENSE.txt", "third_party/python/pip/pip-25.0.1.dist-info/METADATA", "third_party/python/pip/pip-25.0.1.dist-info/RECORD", "third_party/python/pip/pip-25.0.1.dist-info/WHEEL", "third_party/python/pip/pip-25.0.1.dist-info/entry_points.txt", "third_party/python/pip/pip-25.0.1.dist-info/top_level.txt", "third_party/python/pip/pip-25.2.dist-info/METADATA", "third_party/python/pip/pip-25.2.dist-info/RECORD", "third_party/python/pip/pip-25.2.dist-info/WHEEL", "third_party/python/pip/pip-25.2.dist-info/entry_points.txt", "third_party/python/pip/pip-25.2.dist-info/licenses/AUTHORS.txt", "third_party/python/pip/pip-25.2.dist-info/licenses/LICENSE.txt", "third_party/python/pip/pip-25.2.dist-info/l