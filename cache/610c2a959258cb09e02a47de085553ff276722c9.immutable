t/row-auto-repeat-023.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-024.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-025.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-026.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-027.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/auto-repeat/row-auto-repeat-028.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/column-track-sizing-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/dynamic-grid-track-direction.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-flex-sizing-rows-min-max-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-fr-rows-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-percentage-rows-indefinite-height-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-check-grid-height-on-resize.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-explicit-block.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-span-row.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-within-flexbox-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini"], "git_node": "ebfb27e51d66ceaf7d88a36d2f43499440b1ca77", "git_parents": ["64be6beabb5ef2affc4d56136e25206683e57013"], "node": "9b2a1396644df8ce35bbf66d4f0cf61e53737d61", "parents": ["3e79a2e742aa238cf96a0beafb92e0668ccd2a9c"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068160 - Part 7 - Project the culling rect into visibility space. r=gw\n\nThe culling rect was the screen device rect reinterpreted as a vis rect by\ncast_unit, which is only sound because the visibility node is the root reference\nframe and the root carries no device scale of its own. Compute it by unmapping\nthe screen rect from the root into the visibility node's space instead. With\nthat node still the root the mapping is the identity, so the result is unchanged,\nbut the code no longer depends on the two spaces coinciding.\n\nThe failure direction matters more than the mapping: an empty culling rect culls\nthe entire surface, so a projection that cannot be computed falls back to\nmax_rect - cull nothing. A debug assertion catches the fallback being taken from\na vis node inside the root coordinate system, where the screen rect always has\nan exact axis-aligned pre-image and failure would mean a bug rather than a\ngenuinely unprojectable space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322975\n", "files": ["gfx/wr/webrender/src/surface.rs"], "git_node": "bae80389ba22439cbc58edba17913a6277c48522", "git_parents": ["ebfb27e51d66ceaf7d88a36d2f43499440b1ca77"], "node": "7b8860e8015b3440ea05f0306f87d8228316d1ec", "parents": ["9b2a1396644df8ce35bbf66d4f0cf61e53737d61"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068160 - Part 8 - Derive the visibility-space mappers from the surface. r=gw\n\nupdate_prim_visibility's map_surface_to_vis and the tile cache's\npic_to_vis_mapper both named the root reference frame explicitly, with a TODO to\nswitch to raster space. Take the node from the surface's\nvisibility_spatial_node_index instead, which resolves to the same node today.\n\nThe remaining root_spatial_node_index uses in tile_cache are compositing-path\nmappers that genuinely want the screen framebuffer's space, not visibility space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322976\n", "files": ["gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "ab826d5ec06930c58f64169691687a577f91b7dd", "git_parents": ["bae80389ba22439cbc58edba17913a6277c48522"], "node": "a8c9ecbccad339ad0618f8c97f7e20e3c42f0330", "parents": ["7b8860e8015b3440ea05f0306f87d8228316d1ec"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068160 - Part 9 - Instrument the visibility-space clip and culling decisions. r=gw\n\nMoving culling and clipping into raster space is mostly invisible when it works:\nculling that is too conservative costs performance and culling that is too\naggressive drops content, and neither shows up as a pixel difference in the\nconfigurations wrench exercises. Add the measurements before making the change.\n\nFour profiler counters, with what each is expected to do across the migration\ndocumented on the constant:\n - Vis clip projections: clips needing the projected path at all.\n - Vis clip projection fails: projections that produced no answer, each of which\n   forces an otherwise avoidable clip mask.\n - Vis clip rejects: primitives dropped by that path - the counter that says\n   content stopped being drawn.\n - Vis culling rect fallbacks: surfaces culling nothing because the screen had no\n   pre-image in their visibility space.\n\nPlus a debug assertion that a surface's culling rect, mapped back to the root,\nstill covers the screen rect it was derived from. That is the invariant which\nmakes per-primitive culling decisions safe, it holds trivially today, and unlike\nthe counters it is observable from a debug wrench run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322977\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "aba1e6b2507988f6411fd99d0588a11571894ee3", "git_parents": ["ab826d5ec06930c58f64169691687a577f91b7dd"], "node": "7a1d8327321243acf628daf00e45641ef013469e", "parents": ["a8c9ecbccad339ad0618f8c97f7e20e3c42f0330"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068160 - Part 10 - Flag a failed culling rect projection explicitly. r=gw\n\nThe fallback counter inferred a failed projection from the culling rect being\nmax_rect, which the snapshot surface also produces legitimately by passing an\nunbounded screen rect. Record whether the projection actually failed instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322978\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "de14c16b69efbc9bb89b17669a07500a5d0fa6d5", "git_parents": ["aba1e6b2507988f6411fd99d0588a11571894ee3"], "node": "613d728915a1330397b4d6d53d89c921b77c89cf", "parents": ["7a1d8327321243acf628daf00e45641ef013469e"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2067200 - Return an empty WebAssembly binary module if scripting is disabled. r=spidermonkey-reviewers,frontend-codestyle-reviewers,dminor\n\nImplement https://html.spec.whatwg.org/#creating-a-webassembly-module-script\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323657\n", "files": ["dom/base/test/jsmodules/exports-fun.wasm", "dom/base/test/jsmodules/mochitest.toml", "dom/base/test/jsmodules/scriptDisabled_frame.html", "dom/base/test/jsmodules/test_scriptDisabled_modules.html", "dom/script/ModuleLoader.cpp", "dom/script/ModuleLoader.h", "eslint-ignores.config.mjs", "testing/web-platform/tests/wasm/webapi/esm-integration/resources/scripting-disabled.html", "testing/web-platform/tests/wasm/webapi/esm-integration/scripting-disabled.tentative.html"], "git_node": "28e5b605facd681679e0600c7fe591c78e1c0e70", "git_parents": ["de14c16b69efbc9bb89b17669a07500a5d0fa6d5"], "node": "3e4da88d9579cb8b573b8fcc6622bed9c7508346", "parents": ["613d728915a1330397b4d6d53d89c921b77c89cf"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069905 - [devtools] Remove backward compatibility code for 154 r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324022\n", "files": ["devtools/client/aboutdebugging/test/browser/helper-backward-compat.js", "devtools/client/shared/thread-utils.js", "devtools/server/actors/thread-configuration.js"], "git_node": "7b9f80d79a1ed6ba416fdc2b590387ffbd068a41", "git_parents": ["28e5b605facd681679e0600c7fe591c78e1c0e70"], "node": "38ac428c4502961d033a974a2e954b2c7895a2da", "parents": ["3e4da88d9579cb8b573b8fcc6622bed9c7508346"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2069828 - Switch customkeys and aboutlogins to use moz-src. r=credential-management-reviewers,firefox-desktop-core-reviewers ,mossop,joschmidt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323996\n", "files": ["browser/actors/AboutProtectionsParent.sys.mjs", "browser/components/BrowserGlue.sys.mjs", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aboutlogins/AboutLoginsParent.sys.mjs", "browser/components/aboutlogins/moz.build", "browser/components/aboutlogins/tests/browser/head.js", "browser/components/aboutlogins/tests/unit/test_getPotentialBreachesByLoginGUID.js", "browser/components/customkeys/moz.build", "toolkit/components/satchel/megalist/aggregator/datasources/LoginDataSource.sys.mjs", "toolkit/components/satchel/megalist/aggregator/tests/unit/test_loginDataSourceOriginPrototype.js", "toolkit/components/satchel/megalist/aggregator/tests/unit/test_loginDataSourceSortLines.js", "toolkit/components/satchel/megalist/content/tests/browser/head.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "cd74d48a9d187e36e2a5f924bae5a1987dfdca96", "git_parents": ["7b9f80d79a1ed6ba416fdc2b590387ffbd068a41"], "node": "ed88721c5db04b97374e33af2b510f0b2b8dfa02", "parents": ["38ac428c4502961d033a974a2e954b2c7895a2da"], "tags": []}, {"author": "Florin Bilt \u003cfbilt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064814 - Limit speedometer3 critical alert severity to the score on shippable Windows. r=perftest-reviewers,sparky\n\nSets a RAPTOR_TASK_LABEL environment variable from the task transforms\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321520\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/raptor.py", "testing/raptor/browsertime/support-scripts/speedometer3.py", "testing/raptor/raptor/base_python_support.py"], "git_node": "37a5e73a3670500d8abc07e9bef2a2dfe94c74fe", "git_parents": ["cd74d48a9d187e36e2a5f924bae5a1987dfdca96"], "node": "3679d3ccd0f14823e06325e975f153fe3bb30119", "parents": ["ed88721c5db04b97374e33af2b510f0b2b8dfa02"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 1399396 - Remove leftover Java code coverage stuff. r=nalexander,taskgraph-reviewers,bhearsum\n\nJava code coverage was removed in bug 1536044 because it was broken. We\nstill want to have at least C++ coverage for Android so this removes\nthe Java leftovers to re-enable the C++ coverage in the next commit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315821\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py", "testing/mozharness/mozharness/mozilla/testing/codecoverage.py", "testing/mozharness/scripts/android_emulator_unittest.py"], "git_node": "9360841b52061c17ef5621da600ff86dadbf517b", "git_parents": ["37a5e73a3670500d8abc07e9bef2a2dfe94c74fe"], "node": "6606f60833f6b1f2c802dacd7fef42be778d65bc", "parents": ["3679d3ccd0f14823e06325e975f153fe3bb30119"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 1399396 - repack_rust.py: fix providing multiple targets. r=glandium\n\nx.py takes a single comma-separated --target argument\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316227\n", "files": ["taskcluster/scripts/misc/repack_rust.py"], "git_node": "5b146cdc4dbfb260518fa846d06a569f1b9b3848", "git_parents": ["9360841b52061c17ef5621da600ff86dadbf517b"], "node": "189e774578438104620ccba0029fa747cd2f430b", "parents": ["6606f60833f6b1f2c802dacd7fef42be778d65bc"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 1399396 - Add Android Rust dev toolchain. r=glandium\n\nInstrumenting Rust code to gather test coverage data currently requires\ncompiling with -Zprofile which requires building our own patched Rust\ntoolchain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316228\n", "files": ["taskcluster/kinds/toolchain/rust.yml", "taskcluster/scripts/misc/repack_rust.py"], "git_node": "cee547537311591a159f806f6181cde82d4dcb81", "git_parents": ["5b146cdc4dbfb260518fa846d06a569f1b9b3848"], "node": "260a6d4076899c18d22cac3a3d966e1ac9b7d2b2", "parents": ["189e774578438104620ccba0029fa747cd2f430b"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 1399396 - Run tests with code coverage on Android. r=nalexander,geckoview-reviewers,taskgraph-reviewers,bhearsum\n\nThis only enables code coverage for the C++ and Rust bits for now.\n\nFor Java we probably need something like JaCoCo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315822\n", "files": ["mobile/android/config/mozconfigs/android-x86_64/code-coverage", "mobile/android/config/mozconfigs/android-x86_64/code-coverage-opt", "taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/kinds/build/android.yml", "taskcluster/test_configs/test-platforms.yml", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_ccov.py", "testing/mozharness/mozharness/mozilla/building/buildbase.py"], "git_node": "bc709a8704109c2282c80289c99a9e464c352016", "git_parents": ["cee547537311591a159f806f6181cde82d4dcb81"], "node": "e5524d57176758c23c0a5c8b31c3bc3ae1e6509f", "parents": ["260a6d4076899c18d22cac3a3d966e1ac9b7d2b2"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2065611 - Part 1: Add pref and shell option for Export star default proposal. r=arai,allstarschh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322913\n", "files": ["js/src/shell/js.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a58cff11691d8145d6d77009b6f61ab32f71a5e8", "git_parents": ["bc709a8704109c2282c80289c99a9e464c352016"], "node": "c4923eae3af2ee30108c3df52d8f55a4c3c354b9", "parents": ["e5524d57176758c23c0a5c8b31c3bc3ae1e6509f"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2065611 - Part 2: Implement Export star default proposal behind pref. r=arai,allstarschh\n\nRight now export * from \"mod\" skips mod's default export; the spec\nblocks it. This patch lets it through when the pref is on, by skipping the\n\"default\" checks in GetExportedNames and ResolveExport so default is\ntreated like any other exported name (ambiguity checks included).\n\nWith the Pref off: There's no change in behavior.\n\nI've also added jit-tests covering the basic case, missing default, ambiguous\ndefault, and explicit re-export resolving the ambiguity.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322914\n", "files": ["js/src/builtin/ModuleObject.cpp", "js/src/builtin/ModuleObject.h", "js/src/frontend/Stencil.h", "js/src/jit-test/tests/modules/export-entries.js", "js/src/jit-test/tests/modules/export-star-default.js", "js/src/jit-test/tests/modules/shell-wrapper.js", "js/src/jit-test/tests/xdr/module-exports.js", "js/src/shell/ShellModuleObjectWrapper.cpp", "js/src/vm/CommonPropertyNames.h", "js/src/vm/Modules.cpp"], "git_node": "9cbb8d10c69a8e43065153daeefbe561e16baa5f", "git_parents": ["a58cff11691d8145d6d77009b6f61ab32f71a5e8"], "node": "40da41d07eb4bff69ee8984441ab720ae172eaf9", "parents": ["c4923eae3af2ee30108c3df52d8f55a4c3c354b9"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1995348 - Implement the \"grid-lanes\" value for the \"display\" property r=layout-reviewers,firefox-style-system-reviewers,dholbert,emilio\" for causing failures at row-flex-track-intrinsic-sizes.html.\n\nThis reverts commit ebfb27e51d66ceaf7d88a36d2f43499440b1ca77.\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsGridContainerFrame.cpp", "layout/inspector/tests/test_bug877690.html", "layout/style/test/property_database.js", "layout/style/test/test_position_float_display.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/values/specified/box.rs", "testing/web-platform/meta/css/css-anchor-position/__dir__.ini", "testing/web-platform/meta/css/css-anchor-position/grid-lanes-position-area-basic.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/__dir__.ini", "testing/web-platform/meta/