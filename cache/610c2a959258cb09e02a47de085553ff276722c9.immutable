s,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324777\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/figma-variables-all.json", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json"], "git_node": "0b8387ad2eddfcf4180b98b3f772d2df33bfe8d5", "git_parents": ["1e39d78f97a0531ebdd6f577b9fce2ab71be1941"], "node": "3fbeff3c87ddbeb9a444bcef76c1c2ff578e1da8", "parents": ["35702e6e567dee97f98cae861f3a4fa574b443d7"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067928 - Update moz-input-color background-color token in active state (dark mode) r=desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324778\n", "files": ["toolkit/content/widgets/moz-input-color/moz-input-color.nova.tokens.json", "toolkit/content/widgets/moz-input-color/moz-input-color.tokens.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/src/figma-variables-all.json", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json"], "git_node": "cb7af1710f115d8bd8d88d48e36ef992b0d5f8da", "git_parents": ["0b8387ad2eddfcf4180b98b3f772d2df33bfe8d5"], "node": "0a1bc9f8640b248f60faeb60a0818d6ed766a40d", "parents": ["3fbeff3c87ddbeb9a444bcef76c1c2ff578e1da8"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067893 - Update interactive border-color token (light mode) r=desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324780\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/figma-variables-all.json", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/base/border.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/border.tokens.json"], "git_node": "a21581710910070465dbbac30b1099bae1fcee5a", "git_parents": ["cb7af1710f115d8bd8d88d48e36ef992b0d5f8da"], "node": "15ba0c640870807493d5fb4e11e671d6caf32ef3", "parents": ["0a1bc9f8640b248f60faeb60a0818d6ed766a40d"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063178 - Differentiate default and disabled checkbox/radio more r=akulyk,emilio\n\nThere wasn't much difference between default and disabled checkbox and\nradio elements. Use some new colors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324738\n", "files": ["dom/canvas/test/test_bug232227.html", "widget/nsXPLookAndFeel.cpp"], "git_node": "926ffded1b617d3a84b7701c406d8a11d721a2c7", "git_parents": ["a21581710910070465dbbac30b1099bae1fcee5a"], "node": "d6f5dbb5e4f77e47401a431408270ccfe8f1e38f", "parents": ["15ba0c640870807493d5fb4e11e671d6caf32ef3"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Add a `pnpm` fetch task r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320320\n", "files": ["taskcluster/kinds/fetch/kind.yml", "taskcluster/kinds/fetch/pnpm.yml"], "git_node": "33b62710206c39127803b71129af9c7b620021f4", "git_parents": ["926ffded1b617d3a84b7701c406d8a11d721a2c7"], "node": "f2e7b69bf9edbb1d3cd95097a98c263dca5ee0ef", "parents": ["d6f5dbb5e4f77e47401a431408270ccfe8f1e38f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Update newtab's webpack and Babel past their published advisories r=mconley\n\nwebpack `5.109` no longer provides `terser-webpack-plugin`, so the minifier is\ndeclared and imported under its own name. The emitted bundles change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321399\n", "files": ["browser/extensions/newtab/package-lock.json", "browser/extensions/newtab/package.json", "browser/extensions/newtab/webpack.system-addon.config.js"], "git_node": "75867e16f887f77fe1e3caea3e8dcc29b27bac12", "git_parents": ["33b62710206c39127803b71129af9c7b620021f4"], "node": "91fec5ba39adf882f9cd34d99911b8dc55c90c5a", "parents": ["f2e7b69bf9edbb1d3cd95097a98c263dca5ee0ef"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Add `./mach vendor node` for node packages needed at build time r=mconley,firefox-build-system-reviewers,glandium\n\nThe newtab bundles are built with `webpack`, `Babel` and `sass` from `npm`, which a\nbuild must not fetch from the network. This follows `./mach vendor python`\n(`python/mozbuild/mozbuild/vendor/vendor_python.py`), with `pnpm` playing\nthe role that `uv` plays there.\n\n`pnpm` runs with scripts and pnpmfiles disabled, so nothing executes on the way\nin, and with a hoisted linker, which lays the packages out as one plain\ndirectory tree the way `npm` does instead of `pnpm`'s default (symlinks into a\nshared store), so the tree can be checked in. Every install starts from an empty\ntree so the result is a function of the lock file alone, and\n`vendor-inputs.hash` records the inputs the tree was produced from.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320321\n", "files": ["python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/vendor/test_vendor_node.py", "python/mozbuild/mozbuild/vendor/mach_commands.py", "python/mozbuild/mozbuild/vendor/vendor_node.py", "third_party/moz.build", "third_party/node/package.json", "third_party/node/pnpm-workspace.yaml"], "git_node": "fd238dcdaa3848f3987a846838e698ed23d69b86", "git_parents": ["75867e16f887f77fe1e3caea3e8dcc29b27bac12"], "node": "e3ac66486a4414f00a2ef4fe7b8f2d1d24767f8f", "parents": ["91fec5ba39adf882f9cd34d99911b8dc55c90c5a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Prune the vendored node tree to what the build reads r=firefox-build-system-reviewers,glandium\n\nDocumentation, tests, type declarations, source maps, bin shims and the\nbookkeeping `pnpm` keeps for itself are all pruned. License text stays, and a\n`README` stays only when a package has no license text of its own.\n\nPackages restricted by `os`, `cpu` or `libc` are pruned too, because whether\n`pnpm` installs them depends on the vendoring host. The executable bit is\ncleared because a Windows checkout cannot carry it. `./mach vendor node` should\nyield identical output on every host platform.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323827\n", "files": ["python/mozbuild/mozbuild/test/vendor/test_vendor_node.py", "python/mozbuild/mozbuild/vendor/mach_commands.py", "python/mozbuild/mozbuild/vendor/vendor_node.py"], "git_node": "d203e9e21b3b92a4f636fef221c2eea642e74e8a", "git_parents": ["fd238dcdaa3848f3987a846838e698ed23d69b86"], "node": "0afb735f0c5cb931202a5fce36c53b70b04f22ad", "parents": ["e3ac66486a4414f00a2ef4fe7b8f2d1d24767f8f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Refuse to vendor node packages when the manifests disagree r=firefox-build-system-reviewers,glandium\n\nA pnpm other than the one `package.json` names can resolve the same manifest\ndifferently, so its version is checked before anything runs. A consumer\nmanifest that pins another version of a vendored package would build against\nsomething other than it declares, so after any requested add or remove the\nversions have to agree before the lock file is resolved and the tree installed.\n\nConsumers are listed in `CONSUMER_MANIFESTS`, newtab alone for now. Two\nconsumers that want different versions of one package fail this check rather\nthan getting two copies. Once consumers keep their build dependencies apart\nfrom their test dependencies, `third_party/node` can become a pnpm workspace\nwith the consumers as its packages and the check can go.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323828\n", "files": ["python/mozbuild/mozbuild/test/vendor/test_vendor_node.py", "python/mozbuild/mozbuild/vendor/vendor_node.py"], "git_node": "1f1567bf6454faeead5e7d334f47a7384b2a3e33", "git_parents": ["d203e9e21b3b92a4f636fef221c2eea642e74e8a"], "node": "ea8218b9e9e9939543c9bcba30b71f1cccc04de8", "parents": ["0afb735f0c5cb931202a5fce36c53b70b04f22ad"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Vendor the node packages needed to build newtab r=firefox-build-system-reviewers,sylvestre\n\n`third_party/node/node_modules` is generated by `./mach vendor node`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320322\n", "files": ["third_party/node/node_modules/@babel/code-frame/LICENSE", "third_party/node/node_modules/@babel/code-frame/lib/index.js", "third_party/node/node_modules/@babel/code-frame/package.json", "third_party/node/node_modules/@babel/compat-data/LICENSE", "third_party/node/node_modules/@babel/compat-data/corejs2-built-ins.js", "third_party/node/node_modules/@babel/compat-data/corejs3-shipped-proposals.js", "third_party/node/node_modules/@babel/compat-data/data/corejs2-built-ins.json", "third_party/node/node_modules/@babel/compat-data/data/corejs3-shipped-proposals.json", "third_party/node/node_modules/@babel/compat-data/data