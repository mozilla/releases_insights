-abspos-in-inline-block-crash-001.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-ellipsis-hyphen.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-ellipsis-multiline-001.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-ellipsis-self-painting.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-ellipsis-width-001.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-002.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-003.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-005.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-008.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-009.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-010.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-011.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-012.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-013.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-016.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-017.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-018.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-019.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-020.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-021.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-022.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-023.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-with-selection.html.ini"], "git_node": "ff57c9e616c00e2c18cb4f366dc66e94def65fe2", "git_parents": ["0b875b25f93e3ddbb83d7eff93162e87e36d0623"], "node": "841cb795c4cbb823c32161985806956f9b2e35b9", "parents": ["72564eb07e8e00b361f5f53a6f5080b40de680c2"], "tags": []}, {"author": "Monica Chintala \u003cmonicach@microsoft.com\u003e", "branch": "default", "desc": "Bug 2067702 [wpt PR 62247] - Inherit and apply Document Policy for local-scheme dedicated workers, a=testonly\n\nAutomatic update from web-platform-tests\nInherit and apply Document Policy for local-scheme dedicated workers\n\nEnables Document Policy support for local-scheme dedicated workers\n(blob:, data:, about:) by inheriting the policy from the creator\ndocument.\n\nThese schemes do not deliver their own response headers, so\nDedicatedWorkerGlobalScope::Initialize() inherits the creator document's\nDocument Policy for them. This aligns with the inheritance rules HTML\ndefines for the policy container for Workers, which\nContent-Security-Policy already follows in this method: inherit from the\ncreator for local schemes, and apply response headers for network\nschemes.\n\nApplying Document Policy from response headers for network-scheme\nworkers is completed by:\nhttps://chromium-review.googlesource.com/c/chromium/src/+/7236250\n\nThis behavior is gated on the DocumentPolicyInDedicatedWorker runtime\nflag.\n\nDefine DP for Workers PR -\nhttps://github.com/WICG/document-policy/pull/46\n\nBug: 40168691\nChange-Id: Ia8c466bbad424e309d0498e5b28e492723dd85d2\nCo-authored-by: Copilot \u003c223556219+Copilot@users.noreply.github.com\u003e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7857031\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nCommit-Queue: Monica Chintala \u003cmonicach@microsoft.com\u003e\nReviewed-by: Diana Qu \u003cxiaqu@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1687686}\n\n--\n\nwpt-commits: b23fc2e97bd9f1736329920f0c72a179527819de\nwpt-pr: 62247\n", "files": ["testing/web-platform/tests/js-self-profiling/with-document-policy/dedicated-worker-nested-blob.https.html"], "git_node": "f8094b732e532f020f064de69370cf7ad5026e57", "git_parents": ["ff57c9e616c00e2c18cb4f366dc66e94def65fe2"], "node": "a6ec6809623ff914d68177836aff3bfdf85b6d5c", "parents": ["841cb795c4cbb823c32161985806956f9b2e35b9"], "tags": []}, {"author": "Paula Gomez \u003cpaugomez@google.com\u003e", "branch": "default", "desc": "Bug 2067706 [wpt PR 62256] - Built-In AI: Move Translator create user activation WPT to its own file, a=testonly\n\nAutomatic update from web-platform-tests\nBuilt-In AI: Move Translator create user activation WPT to its own file\n\nWhen running chrome_wpt_tests on bots with pre-installed or sideloaded\nmodels, Translator availability starts as available. This caused the\ndownloadable precondition assertion in\ntranslator.optional.https.window.js to fail, flakily failing the entire\ntest suite despite all translation functionality subtests passing.\n\nBug: 510552929\nChange-Id: I7987656d0a8eb8f24299277d927c2a8f1d9fb332\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8280374\nReviewed-by: Danilo Tedeschi \u003cdanft@google.com\u003e\nCommit-Queue: Danilo Tedeschi \u003cdanft@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1687658}\n\n--\n\nwpt-commits: 4aa0ab7cc6cb03b76ac531fa8fad168990c6dc16\nwpt-pr: 62256\n", "files": ["testing/web-platform/tests/ai/translator/translator-create-user-activation.optional.https.window.js", "testing/web-platform/tests/ai/translator/translator.optional.https.window.js"], "git_node": "857a2db704b448ed8084a0b1bb879e9a64b773b0", "git_parents": ["f8094b732e532f020f064de69370cf7ad5026e57"], "node": "d9648fda2f1ed11bf9bb8cf2a4d168e2b6561dc4", "parents": ["a6ec6809623ff914d68177836aff3bfdf85b6d5c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067706 [wpt PR 62256] - Update wpt metadata, a=testonly\n\nwpt-pr: 62256\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/ai/translator/translator-create-user-activation.optional.https.window.js.ini"], "git_node": "515e48b3d94f4e08ff0acc7313911b018c2a499b", "git_parents": ["857a2db704b448ed8084a0b1bb879e9a64b773b0"], "node": "34c5d557a33bd424eb33df6d4a85634