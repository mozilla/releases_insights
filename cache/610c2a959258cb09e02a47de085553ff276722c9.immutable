st/panel-item.css", "toolkit/content/widgets/panel-list/panel-item.tokens.css", "toolkit/content/widgets/panel-list/panel-item.tokens.json", "toolkit/themes/shared/design-system/src/figma-import.mjs"], "git_node": "90ab05217f8236b396327de650b8f90c7ecb5f87", "git_parents": ["a353b0ce65071cd5df2113a5d2d177c9ec650cfc"], "node": "b1ba81019570fc6820b8f570de2ea8e62dcd6c68", "parents": ["af360d4c9a762cfbd936e035eab78f09513a5c6e"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049439 - Part 3: Move Nova token definitions from figma-import.mjs into JSON files r=hjones,desktop-theme-reviewers,tabbrowser-reviewers,urlbar-reviewers,jswinarton,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318796\n", "files": ["browser/themes/addons/moz.build", "browser/themes/addons/process_tokens.py", "browser/themes/shared/tabbrowser/tab.nova.tokens.json", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/urlbar/urlbar.nova.tokens.json", "browser/themes/shared/urlbar/urlbar.tokens.css", "browser/themes/shared/urlbar/urlbar.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.nova.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.json", "toolkit/content/widgets/moz-page-nav/moz-page-nav.nova.tokens.json", "toolkit/content/widgets/moz-page-nav/moz-page-nav.tokens.json", "toolkit/themes/shared/design-system/src/figma-import.mjs", "toolkit/themes/shared/design-system/src/tokens/base/text.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/text.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.tokens.json"], "git_node": "d253217c20a704d843de56523f9a5dfc52f79323", "git_parents": ["90ab05217f8236b396327de650b8f90c7ecb5f87"], "node": "7b5631b35e41d1dc6d7bf5a5f6bf12379dfccc98", "parents": ["b1ba81019570fc6820b8f570de2ea8e62dcd6c68"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049439 - Part 4: Standardize Nova token overrides in JSON files r=hjones,desktop-theme-reviewers,tabbrowser-reviewers,urlbar-reviewers,jswinarton,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318797\n", "files": ["browser/themes/shared/tabbrowser/tabs-navbar.tokens.css", "browser/themes/shared/urlbar/urlbarview.tokens.css", "toolkit/content/widgets/moz-badge/moz-badge.tokens.json", "toolkit/content/widgets/moz-select/moz-select.tokens.css", "toolkit/content/widgets/moz-select/moz-select.tokens.json", "toolkit/content/widgets/panel-list/panel-item.tokens.json", "toolkit/content/widgets/panel-list/panel-list.tokens.css", "toolkit/content/widgets/panel-list/panel-list.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/base/font.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/info-bar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/input.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/link.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json"], "git_node": "7ff03e9150088c10f5c87897a3d624cc1640b6e5", "git_parents": ["d253217c20a704d843de56523f9a5dfc52f79323"], "node": "b8135a91a54d25491eb8786c83dc98decbb6b639", "parents": ["7b5631b35e41d1dc6d7bf5a5f6bf12379dfccc98"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046189 - Prevent Figma import from incorrectly updating tokens r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,hjones,fchasen\n\nRather than attempting a brittle, automated approach, this uses a more explicit case-by-case mechanism for indicating when tokens should ignore the values coming from Figma.\n\nFor tokens that should use the base values, the \"ignoreFigma\" property will prevent values from Figma being written to `*.nova.tokens.json` files. Tokens with \"nova\" overrides in base `*.tokens.json` files will also ignore values from Figma, and I've added comments for each explaining why they are ignored or added where they are (some just don't exist in Figma yet).\n\nWhen running `mach buildtokens`, all the tokens that are being ignored get printed to the console, so we can use that information to fix/add tokens in Figma to reduce the number of tokens that ignore Figma.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313896\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/urlbar/urlbar.tokens.json", "toolkit/content/widgets/moz-badge/moz-badge.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.nova.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.json", "toolkit/content/widgets/moz-page-nav/moz-page-nav.tokens.json", "toolkit/content/widgets/moz-promo/moz-promo.nova.tokens.json", "toolkit/content/widgets/moz-promo/moz-promo.tokens.css", "toolkit/content/widgets/moz-promo/moz-promo.tokens.json", "toolkit/content/widgets/panel-list/panel-item.tokens.json", "toolkit/content/widgets/panel-list/panel-list.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/figma-import.mjs", "toolkit/themes/shared/design-system/src/tokens/base/focus.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/text.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/info-bar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/panel.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json"], "git_node": "4aecf347b8b8fe539e89e87c4dbe6a3355307ee3", "git_parents": ["7ff03e9150088c10f5c87897a3d624cc1640b6e5"], "node": "df7c4d5980b1dfaf958c75f6136b9db3239af467", "parents": ["b8135a91a54d25491eb8786c83dc98decbb6b639"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067187 - [remote] Do not apply recommended prefereed preferences when starting WebDriver BiDi for tooling r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321895\n", "files": ["remote/webdriver-bidi/WebDriverBiDi.sys.mjs", "remote/webdriver-bidi/test/xpcshell/test_WebDriverBiDi_RecommendedPreferences.js", "remote/webdriver-bidi/test/xpcshell/xpcshell.toml"], "git_node": "7d14f6f37743844db658afe7a72666845af2488c", "git_parents": ["4aecf347b8b8fe539e89e87c4dbe6a3355307ee3"], "node": "7cfa60c0190edf8a40342a7568b3