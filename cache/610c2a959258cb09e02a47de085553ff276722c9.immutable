ator.services.mozilla.com/D321976\n", "files": ["tools/tryselect/docs/tasks.md", "tools/tryselect/tasks.py", "tools/tryselect/test/test_tasks.py"], "git_node": "4e0ae8f9c854722cd5cd691eed94f79a684eca6c", "git_parents": ["163105310c4d9e52d2468c853e0435990a506887"], "node": "173b81f0e6116f758a02446ca41e90979b7dd620", "parents": ["bd91f8042c7907fbbef9fc3b40ea123abb48e9d2"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061076 - Add the Acorn OLED colors in the XML colors r=android-reviewers,007\" for causing lint & fenix debug failures\n\nThis reverts commit a60447a83cc3c21fd705eeef54a1dbb4d2e2ed2b.\n", "files": ["mobile/android/fenix/app/src/main/res/values/colors.xml"], "git_node": "60c4798d125369b3fda32da2f2cf57880c829e79", "git_parents": ["4e0ae8f9c854722cd5cd691eed94f79a684eca6c"], "node": "f88818b8b87a29fa407119730ab1db042c3c7b29", "parents": ["173b81f0e6116f758a02446ca41e90979b7dd620"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066887 - Add OLED theme to FirefoxTheme r=android-reviewers,007\" for causing lint & fenix debug failures\n\nThis reverts commit 25b05b14ce83d65f5c173076bef8a395954f1feb.\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/Theme.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/FirefoxTheme.kt"], "git_node": "f6325ba33939a3e1a160d5e743ed9bac3d8d3907", "git_parents": ["60c4798d125369b3fda32da2f2cf57880c829e79"], "node": "1db23580c7d414a29540a05d0e92e144a8bfa2ce", "parents": ["f88818b8b87a29fa407119730ab1db042c3c7b29"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2041141 - Upstream PreviewThemeProvider and Theme from Fenix to compose-base r=android-reviewers,007\" for causing lint & fenix debug failures\n\nThis reverts commit 2acc1b0d9f