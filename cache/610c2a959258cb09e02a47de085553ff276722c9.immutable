orary-setMediaKeys-after-update.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-immediately.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-onencrypted.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-two-videos.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-waitingforkey.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-requestmediakeysystemaccess.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-reset-src-after-setmediakeys.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-again-after-playback.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-again-after-resetting-src.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-at-same-time.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-multiple-times-with-different-mediakeys.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-multiple-times-with-the-same-mediakeys.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-to-multiple-video-elements.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-syntax-mediakeys.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-syntax-mediakeysession.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-syntax-mediakeysystemaccess.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-unique-origin.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-waiting-for-a-key.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-not-callable-after-createsession.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-temporary-license-type.https.html.ini", "testing/web-platform/meta/encrypted-media/idlharness.https.html.ini"], "git_node": "f863ccb1bed143758af4778ba06ebd52c5ea5365", "git_parents": ["abb5f5a6f02ecd82c1372d72f770284de73e0da8"], "node": "d6404e7d1e688f6f17ea8f95371f78b2b1c0e3d0", "parents": ["570bbd4af00a73e27124d18a84d0fed5c9d3c594"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067734 - Fix profile asset size in app menu profile subpanel r=sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322718\n", "files": ["browser/base/content/browser-profiles.js"], "git_node": "1b4cb2c4d58bfd02fcfadf21f3b41bf86093f634", "git_parents": ["f863ccb1bed143758af4778ba06ebd52c5ea5365"], "node": "9e86dd674902f8ec59aa04f6cd611da82010cf03", "parents": ["d6404e7d1e688f6f17ea8f95371f78b2b1c0e3d0"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063708 - Remove version 154 train-hop shim for TOP_SITES_MAX_ROWS in newtab. r=ini\n\n`TOP_SITES_MAX_ROWS` landed in `resource:///modules/topsites/constants.mjs` in Firefox 154. Firefox 154 is now well past Release (tree is 157.0a1), so the train-hop shim can go.\n\nShim introduced in bug 2035622.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322513\n", "files": ["browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs"], "git_node": "b9b0b540f5e1e62d5098c2cb6daef2e349130c32", "git_parents": ["1b4cb2c4d58bfd02fcfadf21f3b41bf86093f634"], "node": "ec6e895a4a69ef25d829ebf6909d15dff8c1dbb9", "parents": ["9e86dd674902f8ec59aa04f6cd611da82010cf03"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061347 - Part 1: [HNT] Remain in tab manager after selecting close all tabs from tab manager r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316895\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bindings/HomepageTabBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/BrowserState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/TabsUseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/TabsCleanupFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/controller/TabManagerController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bindings/HomepageTabBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/BrowserStateTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ext/TabsUseCasesTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/controller/DefaultTabManagerControllerTest.kt"], "git_node": "5b5414798807b1c0099ccf2a980e5f101a223649", "git_parents": ["b9b0b540f5e1e62d5098c2cb6daef2e349130c32"], "node": "f7dad6596958783b0bb4120a2e81a9b739e922a9", "parents": ["ec6e895a4a69ef25d829ebf6909d15dff8c1dbb9"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061347 - Part 2: Use showUndoSnackbarForMultipleTabs in deleteMultipleTabs r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322006\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/controller/TabManagerController.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/controller/DefaultTabManagerControllerTest.kt"], "git_node": "a2e1dab4a3a7c38dc13a781b43a10c7490b4e3dd", "git_parents": ["5b5414798807b1c0099ccf2a980e5f101a223649"], "node": "750a1d5efd23984a20192cb3cc40b6c7c84d18e2", "parents": ["f7dad6596958783b0bb4120a2e81a9b739e922a9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cfqueze@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066746 - Recover try labels of tasks that dynamic chunking has since split into chunks, r=taskgraph-reviewers,ahal\n\nBug 2017946 made every test suite that goes through manifest loading use\ndynamic chunking, so a task's chunk count is only known once the decision task\nhas resolved it from the manifest runtime data.\n\n`mach try fuzzy` builds its task list with `taskgraph.fast` set\n(tools/tryselect/tasks.py), which skips manifest loading and falls back to the\nhardcoded `default-chunks` from YAML. For `android.*/opt` mochitest-media that\nis 1, so `add_chunk_patterns` offers the plain task label with no chunk suffix\nand no `-*` pattern. The decision task then resolves the real chunk count, gets\nmore than one, and the labels become `...-geckoview-mochitest-media-1`, `-2`.\n`_try_task_config` looked for the exact requested label, didn't find it, and\ndropped it, so nothing was scheduled. Adding the job by hand in Treeherder\nworked because that uses the decision task's own runnable-jobs list, which has\nthe real labels.\n\n`_renumbered_chunks` already exists to recover such labels, but it only ran when\nthe push restricted the tests (MOZHARNESS_TEST_PATHS / MOZHARNESS_TEST_TAG), and\nit only handled a label that already carried a numeric suffix.\n\nRun the recovery on every try push, and treat a label with no numeric suffix as\nthe unchunked name of a task that is now chunked. `_drop_redundant_chunks` stays\ngated on the restricted case: there the harness filters the whole suite down so\nevery chunk of an unrestricted task runs the same tests and only the first is\nwanted, whereas without a restriction each chunk runs its own share of the suite\nand they are all wanted.\n\nThis fixes the other producers of stale labels too (`mach try again` of an older\npush, `mach try coverage`, a checked-in try_task_config.json), not just fuzzy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321555\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/test/test_target_tasks.py"], "git_node": "fc631e369f8058d3b8f0b27abb6530b7e8f8da23", "git_parents": ["a2e1dab4a3a7c38dc13a781b43a10c7490b4e3dd"], "node": "de0d4f150911ea77233246a0ca4bd1788a576852", "parents": ["750a1d5efd23984a20192cb3cc40b6c7c84d18e2"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068196 - Avoid updating filter state if no filter chain has been set. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322692\n", "files": ["dom/canvas/CanvasRenderingContext2D.h"], "git_node": "29006a87737ccbe909bedbd380201d40cefd2293", "git_parents": ["fc631e369f8058d3b8f0b27abb6530b7e8f8da23"], "node": "acc006cfc47e5acc21d8266d09d15942fc307fe7", "parents": ["de0d4f150911ea77233246a0ca4bd1788a576852"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068203 - Cache NeedToDrawShadow and NeedToApplyFilter in AdjustedTarget. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322706\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "b988282f27b5e27e884d71cfeb69449f9ef23b8d", "git_parents": ["29006a87737ccbe909bedbd380201d40cefd2293"], "node": "5295f1e022c158b5f169da70cb9f3aff8ba8eff0", "parents": ["acc006cfc47e5acc21d8266d09d15942fc307fe7"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043963: Use the live cursor location for macOS mouseEntered/mouseExited events. r=mac-reviewers,haik\n\nOn macOS 26 the locationInWindow reported on mouseEntered and mouseExited NSEvents appears, in the cases we have been able to capture, not to match where the cursor actually is. The reported point was offset from the live cursor position (most often down and to the right) by a variable amount, and did not seem to line up with any position the cursor had recently occupied. We have not been able to fully determine the cause. It does not look like event-processing latency, since the affected events were handled almost immediately and the cursor appeared to be stationary at the time, so our best guess is that the coordinate is computed incorrectly for these events on this OS version, but we have not been able to corroborate that from outside AppKit.\n\nScreenLocationForEvent already treats mouse-move event locations as untrustworthy and uses the live [NSEvent mouseLocation] instead (bug 443178). This change does the same for mouseEntered and mouseExited, which avoids relying on the suspect coordinate regardless of where it actually comes from.\n\nWithout this, the suspect enter coordinate appears to be recorded as the last known mouse location, and a subsequently synthesized mouse move then seems to re-apply :hover to an element offset from where the pointer actually left the window. The most visible result is a UI element such as a background tab that looks hovered after the cursor has moved out the top edge of the window, which is what this bug reports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309202\n", "files": ["widget/cocoa/nsCocoaUtils.mm"], "git_node": "571e8671acb4068c6d60e4166bbf3bca94c3ea48", "git_parents": ["b988282f27b5e27e884d71cfeb69449f9ef23b8d"], "node": "064e277b15170ee95442a4380f9f26a91350eb6c", "parents": ["5295f1e022c158b5f169da70cb9f3aff8ba8eff0"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045231 - Add custom error states to the send to devices screen r=android-reviewers,android-l10n-reviewers,parker,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320996\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesUiMode.kt", "mobile/android/fenix/app/src/main/res/drawable/kit_devices_sync.xml", "mobile/android/fenix/app/src/main/res/drawable/kit_devices_sync_error.xml", "mobile/android/fenix/app/src/main/res/drawable/kit_plug_error.xml", "mobile/android/fenix/app/src/main/res/drawable/send_link_to_device_no_devices_available.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/share/SendToDevicesScreenTest.kt"], "git_node": "effbbcdd1532993c4cab4ece55ea0da73e8a2d1f", "git_parents": ["571e8671acb4068c6d60e4166bbf3bca94c3ea48"], "node": "301f0671344a0500996ca33f4873618998ec5da0", "parents": ["064e277b15170ee95442a4380f9f26a91350eb6c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2038933 - Observe the tab list's shadow root when waiting for synced tab rows, r=jsudiaman.\n\nThe two context menu tasks waited for the rows while observing the page\ncomponent's shadow root. The rows are added to the sidebar-tab-list's own shadow\nroot, which that observer cannot see, so the wait only passed when they already\nhappened to exist at the initial check. Both now go through\nwaitForSyncedTabListInCard(), whose minRows argument keeps the \"at least two\nrows\" the inline waits required.\n\nThe waits for the cards had the same defect one level up, observing the host\nelement rather than the shadow root the cards render into. That one is latent \u2014\nthe cards are always present at the first synchronous check, which is why the\ncopy of the helper in browser_syncedtabs_sidebar_glean.js has never failed on it\n\u2014 but both are corrected here. Honouring cardIndex in that check is likewise\ninert today, since every caller wants the first card.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321909\n", "files": ["browser/components/sidebar/tests/browser/browser_syncedtabs_sidebar.js", "browser/components/sidebar/tests/browser/browser_syncedtabs_sidebar_glean.js"], "git_node": "60bc6178e2298f27a3d00b2f5bf1f110180e9d5d", "git_parents": ["effbbcdd1532993c4cab4ece55ea0da73e8a2d1f"], "node": "955a7c07ac6b5ff91181466c78e6f880da8afb5e", "parents": ["301f0671344a0500996ca33f4873618998ec5da0"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2038933 - Confine a failing synced tabs sidebar task's sinon stubs to this file, r=jsudiaman.\n\nA task that throws skips its own sandbox.restore(), so the stubs stay installed\nfor the rest of the browser session. browser_syncedtabs_sidebar_glean.js runs\nnext and dies in add_setup with \"Attempted to wrap getErrorType which is already\nwrapped\": 1273 failures over the last three weeks, tracking this file's\none-for-one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321910\n", "files": ["browser/components/sidebar/tests/browser/browser_syncedtabs_sidebar.js"], "git_node": "eb9ead1235b49931a391768eae58c114913a5800", "git_parents": ["60bc6178e2298f27a3d00b2f5bf1f110180e9d5d"], "node": "e1bde1a7833c3dbec3afd810bc8cbf8a0d8343e7", "parents": ["955a7c07ac6b5ff91181466c78e6f880da8afb5e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1989539 - Skip the checks Wayland cannot satisfy in the extension window tests, r=extension-reviewers,robwu.\n\nWayland has no request to position a toplevel window, and no way to tell us that\none has been minimized (bug 2063202), so the position checks and the minimized\ntransitions cannot pass there. Only those checks are skipped: sizes are honoured\non Wayland, and are still checked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318762\n", "files": ["browser/components/extensions/test/browser/browser_ext_windows_create_hidpi.js", "browser/components/extensions/test/browser/browser_ext_windows_create_params.js", "browser/components/extensions/test/browser/browser_ext_windows_size.js", "browser/components/extensions/test/browser/browser_ext_windows_update.js"], "git_node": "86769d4478782b0fb3277b58d037347896350360", "git_parents": ["eb9ead1235b49931a391768eae58c114913a5800"], "node": "a5148429d69eb8a8d40c81cf2ffec976d59aea28", "parents": ["e1bde1a7833c3dbec3afd810bc8cbf8a0d8343e7"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2066633 - Mark a transform stacking context that wraps a backdrop-filter. r=layout-reviewers,emilio\n\nA transform does not form a Backdrop Root, but WebRender still gives its\nstacking context a surface when it inherits a complex clip from an ancestor.\nadd_backdrop_filter then chose that surface as the backdrop root, because it is\nthe innermost one on the stack, so the readback sourced a surface holding only\nthe filtered element itself and the filter had no visible effect.\n\nWRAPS_BACKDROP_FILTER already tells WebRender to skip a stacking context when it\npicks the backdrop root, so set it whenever a descendant has a backdrop-filter\nand we are not forcing isolation ourselves - in which case we are the backdrop\nroot that the descendant should be resolving from.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322212\n", "files": ["gfx/wr/wrench/reftests/filters/backdrop-filter-in-clip-surface-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-filter-in-clip-surface.yaml", "gfx/wr/wrench/reftests/filters/reftest.list", "layout/generic/nsIFrame.cpp", "testing/web-platform/meta/css/filter-effects/backdrop-filter-in-transform-clip-surface.html.ini", "testing/web-platform/tests/css/filter-effects/backdrop-filter-in-transform-clip-surface-ref.html", "testing/web-platform/tests/css/filter-effects/backdrop-filter-in-transform-clip-surface.html"], "git_node": "91ed56fafdb5ed82503719b05604cbed4108a0d0", "git_parents": ["86769d4478782b0fb3277b58d037347896350360"], "node": "58a2d408720a3a9a1f2bfcfeb6d1aab4feabbbb5", "parents": ["a5148429d69eb8a8d40c81cf2ffec976d59aea28"], "tags": []}, {"author": "Osmond Arnesto \u003coarnesto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057960 - Update moz-input-text and -search styles r=desktop-theme-reviewers,tgiles,jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317394\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/content/widgets/moz-input-text/moz-input-text.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/components/input.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/input.tokens.json"], "git_node": "abf9ed1580e0db9ce6e178b22fbad01b7169fe22", "git_parents": ["91ed56fafdb5ed82503719b05604cbed4108a0d0"], "node": "140c01306d371e03c4c1bb9967ee9a4e3d035532", "parents": ["58a2d408720a3a9a1f2bfcfeb6d1aab4feabbbb5"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067164 - Improve JavaCallbackDelegate Crash Stacks r=geckoview-reviewers,tcampbell\n\nAdds `type` to these crash stacks to improve crash diagnosis.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321951\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/EventDispatcherTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/EventDispatcher.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/CallbackResult.java"], "git_node": "80ff2abc1a8cd5bcaa608af1beb2d47c577e4bd2", "git_parents": ["abf9ed1580e0db9ce6e178b22fbad01b7169fe22"], "node": "0ebda92f7913107b975a299e1fe1b857805f7d28", "parents": ["140c01306d371e03c4c1bb9967ee9a4e3d035532"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061503 - Validate draw fetch limits for matrix attribute columns. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322729\n", "files": ["dom/canvas/WebGLProgram.cpp", "dom/canvas/test/webgl-mochitest/mochitest.toml", "dom/canvas/test/webgl-mochitest/test_draw_matrix_attrib_fetch_limits.html"], "git_node": "70183d718570dac968305e9374b6597d6265201c", "git_parents": ["80ff2abc1a8cd5bcaa608af1beb2d47c577e4bd2"], "node": "fa20af279231a78dd22884ee364962d5ec277215", "parents": ["0ebda92f7913107b975a299e1fe1b857805f7d28"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061677 - Remove the Legacy Telemetry mirror of downloads.user_action_on_blocked_download r=chumphreys,timhuang\n\nOnly the Legacy Telemetry mirror is removed. The Glean metric\ndownloads.user_action_on_blocked_download is left in place, so what Firefox\ncollects is unchanged, and DownloadIntegration already records exclusively\nthrough Glean.\n\nBoth sides of the mirror have to go in the same commit: test_mirrors.py asserts\nevery telemetry_mirror resolves to an existing probe, and also that every\nhistogram in Histograms.json has a mirroring metric, so removing either side\nalone fails.\n\ntest_DownloadBlockedTelemetry.js asserted on the legacy keyed histogram only, so\nthose assertions are converted to Glean rather than dropped. The keyed\nhistogram's keys become the labels of the labeled custom distribution, and the\nbucket each assertion checked becomes a check of the distribution's sum and\ncount, which pins the recorded value exactly rather than to a bucket.\ntoolkit.telemetry.testing.overrideProductsCheck only affects Legacy Telemetry's\nproducts gating, so it is no longer needed. FOG is initialized in add_setup\nbecause head.js only calls do_get_profile() once run_test() starts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317129\n", "files": ["toolkit/components/downloads/metrics.yaml", "toolkit/components/downloads/test/unit/test_DownloadBlockedTelemetry.js", "toolkit/components/telemetry/Histograms.json"], "git_node": "87789e19792c2e3a006e52b5831cceb6d9006fab", "git_parents": ["70183d718570dac968305e9374b6597d6265201c"], "node": "127c964b14ba090520cbeb831a974565bd121c04", "parents": ["fa20af279231a78dd22884ee364962d5ec277215"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-pt-rPT/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-pt-rPT/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml"], "git_node": "c7f7ba8e0995fd61bf428d6b28374bf2fc5bbf3a", "git_parents": ["87789e19792c2e3a006e52b5831cceb6d9006fab"], "node": "2f25bee450d88682177208a2bbbe742fcf35c092", "parents": ["127c964b14ba090520cbeb831a974565bd121c04"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1935242 - Scale the maximum surface size with the screen r=gfx-reviewers,nical\n\nSurfaces over MAX_SURFACE_SIZE are scaled down to fit, which blurs the whole\nsurface. With the limit fixed at 4096 device pixels, any surface covering the\ncontent area of a wider screen was permanently blurry.\n\nDerive it from global_screen_device_rect instead, rounded up to a power of two\nso a drag resize does not keep changing it, and floored at 4096 so smaller\nscreens and raster scales above one are unaffected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322518\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/tile_cache/mod.rs"], "git_node": "5db293d7b7ad68dc190922c2f9f96cbe812b5c72", "git_parents": ["c7f7ba8e0995fd61bf428d6b28374bf2fc5bbf3a"], "node": "640d0430843bbc57cf1572ab551adc2b6e96d775", "parents": ["2f25bee450d88682177208a2bbbe742fcf35c092"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065517 - Refactor Parent-\u003eChild urlbar messages and improve type info. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320444\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProviderCalculator.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/