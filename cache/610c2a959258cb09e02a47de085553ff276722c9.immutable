d", "7e1f232ae2d893d7423711c730fa2149c64c70b4", "4fdfb9b06af6e271815687e34545bbcebd6312e9", "03035e4a00e6c1659dd2c98507d97213f9d2387f", "b2d4d3ed20ee79fbef0a9c389fcc4b4a32253a41", "5240fbbc45bc0c4abccc2c331c8e42167ea3dd26", "f8679207d6a571299636e827a9fd0fc5e8b0403f", "efc45c133c218f4fbee4e7b44f366753d91b6a93", "87c7e4fb9fe62e8c6955a35ccf5ed8a5c0020c2d", "c74e397e7bac58b7ef954e6f96b7a78d82c4adb0", "accd78c26a5ea000328a924f090ec2635065558e", "2b0df47e9391c5ebb1fe16ad27895fd8e828eb4e", "5e3d17a2c5f7ca90b65a7a63d7d774462302fef1", "c88a20987ea11de9d93f61bbfe1d39e78261f859", "800d19001e59dcfeed5f0bba5460785bdcc73db9", "e493856d430d35feebb1766cdde042fc4a9c0253", "6f10d03d2256d607964e7ea9cf15b5807289c9c5", "e6fab792b2be222774303d7714ca94e21183e6b4", "e8dbddf8e0d65d4e836c702b5f574b66615ccfc1", "94dc188f9c710aa025ee35f51031253896182e23", "dd9114eba49859bf3d6aa5c63a3dbde52c94b22f", "49def41cd2cf24283feb0ba98f85ef1e1af0eaa1", "714b247775cf2ed626d6a3237614512b327d1808", "820c34a0605491bd791e56c216b06ada1ff5a0c1", "c4cf2127cd54a681d1cb3d6df9210b77446c0d5f", "fffaad0c2b590f6fd0066c5698b440c0ec59f47f", "da9d514d8e4599429aa913dc246064a530953b88"], "user": "ctuns@mozilla.com"}, "45294": {"changesets": [{"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052772 - Part 4: Wait for FOG init before reading Glean in the startup_about_home_paint talos addon r=perftest-reviewers,sparky\" for causing talos failures in startup_about_home_paint\n\nThis reverts commit efc45c133c218f4fbee4e7b44f366753d91b6a93.\n", "files": ["testing/talos/talos/startup_test/startup_about_home_paint/addon/api.js"], "git_node": "f290ea5c3a8791f96420f5cbaf672bfef5fa74e8", "git_parents": ["da9d514d8e4599429aa913dc246064a530953b88"], "node": "5a0d4f308be6f332bc391f7fffdb7bafb4f8bb18", "parents": ["645a0f2aeb383793f5a4e36fc36ff05db916c64b"], "tags": []}], "date": 1789015415, "git_changesets": ["f290ea5c3a8791f96420f5cbaf672bfef5fa74e8"], "user": "ctuns@mozilla.com"}, "45295": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2069082 - P1: Use AccessibilityNodeInfo.setLiveRegion(). r=Jamie,geckoview-reviewers,m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323395\n", "files": ["accessible/android/SessionAccessibility.cpp", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-descendant.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "1d34de8899058ea7c67c1ae5235bb9c3b2017db8", "git_parents": ["da9d514d8e4599429aa913dc246064a530953b88"], "node": "d66812ad76f52208842d739ffaacb8bd2862bc0a", "parents": ["645a0f2aeb383793f5a4e36fc36ff05db916c64b"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2069082 - P2: Reimplement Android live regions. r=Jamie,geckoview-reviewers,m_kato\n\nThis removes the old announcement based live regions and relies on a\nTYPE_WINDOW_CONTENT_CHANGED events.\n\nThere is an arbitrary event limiter in there\nso we don't saturate the platform with many events. There is anyway a\nlimit to how much of a live region any AT can reliably convey.\n\nI also removed the image labeled-by test since it uses a similar\ncodepath to a any name changed events and we already have non-OS\ncoverage for that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323396\n", "files": ["accessible/android/AccessibleWrap.cpp", "accessible/android/AccessibleWrap.h", "accessible/android/Platform.cpp", "accessible/android/SessionAccessibility.cpp", "accessible/android/SessionAccessibility.h", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-descendant.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-image-labeled-by.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-image.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-large.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "c461ce10a1fe7e39e832b46d236d0d67e93f3f77", "git_parents": ["1d34de8899058ea7c67c1ae5235bb9c3b2017db8"], "node": "df7e3941987fc96d38069616e2acfcbe4959d85b", "parents": ["d66812ad76f52208842d739ffaacb8bd2862bc0a"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1185617 - Implement alert live regions in Android. r=Jamie,geckoview-reviewers,m_kato\n\nI'm not 100% sure why this a live region in mac since we handle ALERT\nevents over there. Implicitly, I think this needs to be an assertive\nregion everywhere..\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323755\n", "files": ["accessible/base/ARIAMap.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "6f45be955203c19431fd6e4ab71067d230666bf0", "git_parents": ["c461ce10a1fe7e39e832b46d236d0d67e93f3f77"], "node": "9618ec0eb0177154ebda905dc27c8f22f3aa235b", "parents": ["df7e3941987fc96d38069616e2acfcbe4959d85b"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 908042 - Implement aria-busy in Android. r=Jamie,geckoview-reviewers,m_kato\n\nThis is ideally something the AT should do and not us. According to\nspec, once aria-busy is set to false the AT should announce any\nchanges it has tracked while it was busy. We don't do that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323754\n", "files": ["accessible/android/SessionAccessibility.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "983123ab6fe7bb71ac45e01a6509d67acc6eff74", "git_parents": ["6f45be955203c19431fd6e4ab71067d230666bf0"], "node": "06bc2d584dffcffd112f7608981799fbb0e6d3e5", "parents": ["9618ec0eb0177154ebda905dc27c8f22f3aa235b"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069119 - Remove dead partner attribution infrastructure from newtab. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323418\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/lib/PlacesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_PlacesFeed.js"], "git_node": "27bd5c55367635990abab3b1637f4a9680d409e1", "git_parents": ["983123ab6fe7bb71ac45e01a6509d67acc6eff74"], "node": "48f62c71724babbc1df3b4e218f57511cb4d911f", "parents": ["06bc2d584dffcffd112f7608981799fbb0e6d3e5"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068491 - Keep moz-visual-picker items from moving when hovered at fractional display scaling r=desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324521\n", "files": ["toolkit/content/tests/widgets/test_moz_visual_picker.html", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker-item.css", "toolkit/content/widgets/theme-picker/theme-picker.css"], "git_node": "93d4de02d8c13e9389b75e7b9368e7e3e09a3c3b", "git_parents": ["27bd5c55367635990abab3b1637f4a9680d409e1"], "node": "2683179c0e049d963d40326771e7a5a6b434f990", "parents": ["48f62c71724babbc1df3b4e218f57511cb4d911f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040802: Rename ENABLE_WASM_SIMD to ENABLE_JIT_SIMD r=yury\n\nBased on Element discussions with Ryan and Yury, I am removing the outdated wasm-no-experimental dependency. Wasm SIMD is no longer experimental.\n\nThis also changes ENABLE_WASM_AVX to ENABLE_JIT_AVX, and updates the two uses. I didn't change ENABLE_WASM_RELAXED_SIMD, because relaxing strict determinism is wasm-specific, and it isn't used outside of wasm code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301943\n", "files": ["js/moz.configure", "js/public/Initialization.h", "js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/wasm/simd/disabled.js", "js/src/jit/CodeGenerator.cpp", "js/src/jit/JitContext.cpp", "js/src/jit/LIR.cpp", "js/src/jit/LIR.h", "js/src/jit/Lowering.cpp", "js/src/jit/MIR-wasm.cpp", "js/src/jit/MIR-wasm.h", "js/src/jit/MacroAssembler.h", "js/src/jit/ShuffleAnalysis.cpp", "js/src/jit/ShuffleAnalysis.h", "js/src/jit/arm/Architecture-arm.cpp", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/arm/MacroAssembler-arm.cpp", "js/src/jit/arm/Trampoline-arm.cpp", "js/src/jit/arm64/Assembler-arm64.cpp", "js/src/jit/arm64/Assembler-arm64.h", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/arm64/Lowering-arm64.cpp", "js/src/jit/arm64/Lowering-arm64.h", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/mips-shared/Lowering-mips-shared.cpp", "js/src/jit/mips64/Architecture-mips64.cpp", "js/src/jit/mips64/MacroAssembler-mips64.cpp", "js/src/jit/riscv64/Architecture-riscv64.cpp", "js/src/jit/riscv64/Architecture-riscv64.h", "js/src/jit/riscv64/Lowering-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/Register-riscv64.h", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/Lowering-shared-inl.h", "js/src/jit/shared/Lowering-shared.h", "js/src/jit/x64/Lowering-x64.cpp", "js/src/jit/x64/Trampoline-x64.cpp", "js/src/jit/x86-shared/Architecture-x86-shared.cpp", "js/src/jit/x86-shared/Assembler-x86-shared.cpp", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp", "js/src/jit/x86/Lowering-x86.cpp", "js/src/jit/x86/Trampoline-x86.cpp", "js/src/shell/js.cpp", "js/src/vm/Initialization.cpp", "js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCCodegen-inl.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBCFrame.h", "js/src/wasm/WasmBCMemory.cpp", "js/src/wasm/WasmBCRegDefs-inl.h", "js/src/wasm/WasmBCRegDefs.h", "js/src/wasm/WasmBCRegMgmt-inl.h", "js/src/wasm/WasmBCStk.h", "js/src/wasm/WasmBCStkMgmt-inl.h", "js/src/wasm/WasmBaselineCompile.cpp", "js/src/wasm/WasmBinary.h", "js/src/wasm/WasmDebugFrame.cpp", "js/src/wasm/WasmDebugFrame.h", "js/src/wasm/WasmFeatures.h", "js/src/wasm/WasmInitExpr.cpp", "js/src/wasm/WasmIonCompile.cpp", "js/src/wasm/WasmOpIter.cpp", "js/src/wasm/WasmOpIter.h", "js/src/wasm/WasmStubs.cpp", "js/src/wasm/WasmStubs.h", "js/src/wasm/WasmValType.cpp", "js/src/wasm/WasmValType.h", "js/src/wasm/WasmValidate.cpp", "js/xpconnect/src/nsXPConnect.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "f785e771e7050dca044555ef4b70fb17c67ba98c", "git_parents": ["93d4de02d8c13e9389b75e7b9368e7e3e09a3c3b"], "node": "bd8c5c7d446ac6448085069cfdfce19c12152d9d", "parents": ["2683179c0e049d963d40326771e7a5a6b434f990"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1929128: Use SIMD for SkipUntilBitInTable r=jandem\n\nClaude wrote a prototype of this patch, then I rewrote it by hand and polished up a bunch of stuff.\n\nV8 has two other ops that it implements using SIMD (SkipUntilOneOfMasked and SkipUntilOneOfMasked3), but the latter was disabled because it regressed TodoMVC-jquery, and despite my best efforts, I can't write a single testcase that triggers the former in V8.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301944\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/irregexp/RegExpNativeMacroAssembler.h"], "git_node": "cbebf91f76a0995dbf2ac93bf16578b7817903fc", "git_parents": ["f785e771e7050dca044555ef4b70fb17c67ba98c"], "node": "1678df417c4da2d4d735b5b72b38cb15c9a96a04", "parents": ["bd8c5c7d446ac6448085069cfdfce19c12152d9d"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042565: Improve non-AVX support in simple three-operand SIMD operations r=yury\n\nThis patch adds new helpers to handle register shuffling when AVX is not available. The choice between commutative vs non-commutative for each op was copied from WasmIonCompile.cpp.\n\nThe FMA code uses ScratchSimd128Scope and then calls helpers that now need it themselves, so I rewrote it to use the underlying instructions directly. This is more consistent with other code that uses the scratch register in this file (eg reverseInt16x8).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303160\n", "files": ["js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared.h"], "git_node": "97f332ce432d11afb922cfef660a40b8a18a7324", "git_parents": ["cbebf91f76a0995dbf2ac93bf16578b7817903fc"], "node": "0de6f94a1655a39cd6186a480c739d47cff7566f", "parents": ["1678df417c4da2d4d735b5b72b38cb15c9a96a04"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042565: Enable SIMD for SkipUntilBitInTable without AVX r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303161\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp", "js/src/jit-test/tests/regexp/non-avx.js"], "git_node": "fe1a8df6cc30a1db1c8172b024492fcad5d060b7", "git_parents": ["97f332ce432d11afb922cfef660a40b8a18a7324"], "node": "f7e7fb0ec9a6ba82e46ecd49894f068e232fbbf9", "parents": ["0de6f94a1655a39cd6186a480c739d47cff7566f"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067175 - fixed OpenUrl trigger on page redirects/navigation. r=mcheang,omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323034\n", "files": ["browser/components/asrouter/modules/ASRouterTriggerListeners.sys.mjs", "browser/components/asrouter/tests/browser/browser_trigger_listeners.js", "browser/components/asrouter/tests/unit/ASRouterTriggerListeners.test.js", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/TriggerActionSchemas.json", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/index.md"], "git_node": "ebbabc37714ef8aecb1cba465ed94e0df34fc895", "git_parents": ["fe1a8df6cc30a1db1c8172b024492fcad5d060b7"], "node": "11d569096d51e9555a57e01990ad11a30462f1c5", "parents": ["f7e7fb0ec9a6ba82e46ecd49894f068e232fbbf9"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070128 - Update VPN settings screen title. r=android-reviewers,android-l10n-reviewers,mavduevskiy,cbect,parker DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324434\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "6ea1cf3aefc78d898e76a0d62a12df260080a559", "git_parents": ["ebbabc37714ef8aecb1cba465ed94e0df34fc895"], "node": "b135d094d76cbfbacc92182f1d069eebbb87fbd3", "parents": ["11d569096d51e9555a57e01990ad11a30462f1c5"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070125 - Show VPN post promo banner when promo date expires. r=android-reviewers,android-l10n-reviewers,mavduevskiy,parker DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324490\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/IPProtectionScreenTest.kt"], "git_node": "b8fbec1c6f89a049539856b775590470d81113c2", "git_parents": ["6ea1cf3aefc78d898e76a0d62a12df260080a559"], "node": "23e9a966236c2e067abd898a040d7ec6ac25196a", "parents": ["b135d094d76cbfbacc92182f1d069eebbb87fbd3"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2066575: Use CachedTableAccessible for XUL elements with table roles r=Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321409\n", "files": ["accessible/base/AccTypes.h", "accessible/base/CachedTableAccessible.cpp", "accessible/base/nsAccessibilityService.cpp", "accessible/basetypes/Accessible.h", "accessible/generic/LocalAccessible.cpp", "accessible/tests/browser/tree/browser.toml", "accessible/tests/browser/tree/browser_xul_aria_grid.js", "accessible/tests/browser/tree/doc_xul_grid.xhtml", "accessible/xul/XULListboxAccessible.cpp"], "git_node": "c940b181a68744d6987e51e8cc9da30abb05be31", "git_parents": ["b8fbec1c6f89a049539856b775590470d81113c2"], "node": "0f9c8241302281e7a1a010c17f8f5f8cb9f9153c", "parents": ["23e9a966236c2e067abd898a040d7ec6ac25196a"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2066575: Ensure table properties are exposed for XUL tables on mac r=eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321410\n", "files": ["accessible/tests/browser/mac/browser.toml", "accessible/tests/browser/mac/browser_xul_role_grid.js", "accessible/tests/browser/mac/doc_xul_grid.xhtml"], "git_node": "005fc4632cc754e29ff039c1579fdd17232b371e", "git_parents": ["c940b181a68744d6987e51e8cc9da30abb05be31"], "node": "c01d8dff3823690affe5e8957eda483461ebef44", "parents": ["0f9c8241302281e7a1a010c17f8f5f8cb9f9153c"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 908042, Bug 1185617, Bug 2069082 - Implement aria-busy in Android. r=Jamie,geckoview-reviewers,m_kato\" for causing build bustages\n\nThis reverts commit 983123ab6fe7bb71ac45e01a6509d67acc6eff74.\n\nRevert \"Bug 1185617 - Implement alert live regions in Android. r=Jamie,geckoview-reviewers,m_kato\"\n\nThis reverts commit 6f45be955203c19431fd6e4ab71067d230666bf0.\n\nRevert \"Bug 2069082 - P2: Reimplement Android live regions. r=Jamie,geckoview-reviewers,m_kato\"\n\nThis reverts commit c461ce10a1fe7e39e832b46d236d0d67e93f3f77.\n\nRevert \"Bug 2069082 - P1: Use AccessibilityNodeInfo.setLiveRegion(). r=Jamie,geckoview-reviewers,m_kato\"\n\nThis reverts commit 1d34de8899058ea7c67c1ae5235bb9c3b2017db8.\n", "files": ["accessible/android/AccessibleWrap.cpp", "accessible/android/AccessibleWrap.h", "accessible/android/Platform.cpp", "accessible/android/SessionAccessibility.cpp", "accessible/android/SessionAccessibility.h", "accessible/base/ARIAMap.cpp", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-descendant.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-image-labeled-by.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-image.html", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-live-region-large.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "d85d737809a9e271758108dd07918cc452f41c6b", "git_parents": ["005fc4632cc754e29ff039c1579fdd17232b371e"], "node": "a2ff18de5043917e20d78559b7a2c4fa66dff50c", "parents": ["c01d8dff3823690affe5e8957eda483461ebef44"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070372 - Land final strings for FRO refresh r=jprickett,fluent-reviewers,omc-reviewers,bolsson\n\nAdds final strings for the FRO onboarding refresh as per designs here:\nhttps://www.figma.com/design/MPYRmdy1F5sLL0cyhkmAAs/NPO-Experiments-2026?node-id=3855-135704&m=dev\n\nAlso contains a minor bugfix for the EmbeddedMigrationWizard, which was forcibly overriding the selection dropdown header with an unneeded empty string. Removing it shouldn't affect the existing Import screen of about:welcome, since we hide the header there; and the refreshed layout uses the default widget strings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324716\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/EmbeddedMigrationWizard.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/locales/en-US/browser/newtab/onboarding.ftl"], "git_node": "0204799f9706a8168c0a805b7dcfd24acd8784b7", "git_parents": ["d85d737809a9e271758108dd07918cc452f41c6b"], "node": "077b20bbb19a269eef30b2f1d1b3dde4799bc817", "parents": ["a2ff18de5043917e20d78559b7a2c4fa66dff50c"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069964 - [devtools] Reorder inspector init to avoid regressing markupview init r=devtools-reviewers,nchevobbe\n\nAlso break the coupling between ruleview/computedview and stylechangetracker.\nThis allows to instantiate the stylechangetracker later, which avoids firing too many concurrent RDP requests.\nIn any case this coupling was fragile, removing it is a step in the right direction.\n\nThe Browser Toolbox init path in particular might trigger some of the initialization logic twice,\nadding a guard to avoid this.\n\nFinally, the last UI initialization steps move back to the init() but after a promise which is going to be\nresolved on first node selection. Easier to follow that my previous patch I believe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324344\n", "files": ["devtools/client/inspector/computed/computed.js", "devtools/client/inspector/inspector.js", "devtools/client/inspector/rules/rules.js"], "git_node": "b92cbb7385f45892b5bea0a8247f873e53474770", "git_parents": ["0204799f9706a8168c0a805b7dcfd24acd8784b7"], "node": "841c602ece99465a449466c488a828ad1e8e842e", "parents": ["077b20bbb19a269eef30b2f1d1b3dde4799bc817"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068160 - Part 13 - Cull raster-root content against the raster root's own space. r=gw\n\nVisibility, clipping and dirty-region calculations now always happen relative to\na surface's raster node, including for a non-snapping raster root established for\na preserve-3d or perspective subtree. A primitive's relationship to that node is\nusually a plain 2D scale and offset even when its relationship to the screen is\nnot, because the raster root sits inside the transform that makes the\nscreen-relative mapping hard.\n\nThe cost is that vis space need not be axis-aligned with the screen any more, so\nthe screen rect need not have an exact pre-image in it. SpaceMapper::unmap\ninverse-projects with inverse_rect_footprint, the bounding box of the four\ninverse-projected corners. That is the exact pre-image for a 2D scale and offset,\nbut it is not a superset of it once the mapping rotates or has perspective: the\npre-image of an axis-aligned screen rect is then a general quadrilateral,\npossibly unbounded, and its corners do not bound it. Culling against the corner\nbox drops content that is on screen, and it crashed the round-trip debug\nassertion on gfx/tests/reftest/1687157-1.html, a preserve-3d torus under a\nperspective. So take the projected rect only when the mapping is a 2D scale and\noffset, and fall back to max_rect otherwise: tile caches and root-rasterizing\nsurfaces keep a real culling rect, and a raster root inside a 3D context culls\nnothing, which is the answer that cannot be wrong.\n\nThis makes snapshot-perspective-01 render. Its snapshot picture establishes a\nraster root inside the perspective, and culling its content against a\nscreen-relative projection discarded all of it, so the snapshot came out empty -\nthe symptom bug 1941577 tracks, which the reftest recorded by expecting a blank\nframe with a TODO to update the reference once it was fixed. The snapshot now\ndraws the rounded rect its area describes, in the image item's bounds, so replace\nthe blank expectation with a reference that describes that independently. The\nfuzz covers the snapshot's antialiased perimeter, which lands differently from a\ndirectly drawn rect because the snapshot is rasterized into a texture and then\ndrawn. Note the reference only pins down the snapshot: the source stacking\ncontext still contributes nothing on screen, and this patch does not establish\nwhether that part is correct.\n\nThe culling rect's max_rect fallback is reachable for the first time here, which\nshowed that the round-trip debug assertion cannot be applied to it: projecting a\nmax_rect forward clips against the near plane, so it comes back not covering the\nscreen even though a max_rect culling rect cannot over-cull by construction.\nCheck only rects that came from a real projection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322980\n", "files": ["gfx/wr/webrender/src/surface.rs", "gfx/wr/wrench/reftests/image/reftest.list", "gfx/wr/wrench/reftests/image/snapshot-perspective-01-ref.yaml", "testing/web-platform/meta/css/css-view-transitions/offscreen-element-modified-before-coming-onscreen.html.ini"], "git_node": "3c5d056fc2c3298d688d561204086e4c5d243f39", "git_parents": ["b92cbb7385f45892b5bea0a8247f873e53474770"], "node": "29169aee7e9505b3c681e7871a9aca83dcf3fa92", "parents": ["841c602ece99465a449466c488a828ad1e8e842e"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070367 - indicate that poll may sleep as close as possible to where it may actually happen r=florian,necko-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324464\n", "files": ["netwerk/base/nsSocketTransportService2.cpp", "security/manager/ssl/nsNSSIOLayer.cpp", "security/manager/ssl/tests/unit/test_pkcs11_module_client_auth.js"], "git_node": "a18b8fd36950bb90ffcf08e1ca55e637bde47cc6", "git_parents": ["3c5d056fc2c3298d688d561204086e4c5d243f39"], "node": "51894358c47879cbe89cbfa63c42caa073e6ec55", "parents": ["29169aee7e9505b3c681e7871a9aca83dcf3fa92"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2068448 - Call MaybeBecomeUntrusted in RedirectToRealChannel, r=mccr8,necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324426\n", "files": ["netwerk/ipc/DocumentChannelChild.cpp"], "git_node": "f8ae3ce8f8126d91a12e018149dc75ae452fccf4", "git_parents": ["a18b8fd36950bb90ffcf08e1ca55e637bde47cc6"], "node": "baee9c38f9477d3699ba52085a4c69a218983d5a", "parents": ["51894358c47879cbe89cbfa63c42caa073e6ec55"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070619 - Add border to the private browsing indicator icon on hover and active states r=sfoster,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324711\n", "files": ["browser/themes/shared/browser-shared.css", "browser/themes/shared/privatebrowsing/pbm-logo.svg"], "git_node": "78efc665c30978065228606024276af8ece501c9", "git_parents": ["f8ae3ce8f8126d91a12e018149dc75ae452fccf4"], "node": "e0ac105a4f2bc981c584af3a897b6934af1c80a1", "parents": ["baee9c38f9477d3699ba52085a4c69a218983d5a"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068374 - Restore the realm when unwinding a trapping wasm tail call. r=jpages\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323721\n", "files": ["js/src/vm/JitActivation.cpp"], "git_node": "d29cfe7c0c38e262057e2e0449f036362278bb78", "git_parents": ["78efc665c30978065228606024276af8ece501c9"], "node": "45ab23711294112dac9cf3a914b90656203b5eb8", "parents": ["e0ac105a4f2bc981c584af3a897b6934af1c80a1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070674 - Declare four transitive androidx dependencies in the Gecko-side examples. r=android-reviewers,geckoview-reviewers,tcampbell\n\nThey're currently resolved transitively, and not every build variant that resolves these projects sees\nGeckoView's own versions of them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324776\n", "files": ["mobile/android/examples/messaging_example/app/build.gradle", "mobile/android/geckoview_example/build.gradle", "mobile/android/test_runner/build.gradle"], "git_node": "01b977d1d019903fea8b181c6deedc2529d77241", "git_parents": ["d29cfe7c0c38e262057e2e0449f036362278bb78"], "node": "81c2e26ff91b484dc71ca9e1cdb65fd0c1fee69c", "parents": ["45ab23711294112dac9cf3a914b90656203b5eb8"], "tags": []}, {"author": "Wyatt Verchere \u003cwverchere@gmail.com\u003e", "branch": "default", "desc": "Bug 2064543 - Calls ads-client shutdown to safely drop uniffi callbacks on quitting newtab. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319889\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AdsClient.js"], "git_node": "1caf8be159a12fc5f15cb525bb7e7cef72d21ada", "git_parents": ["01b977d1d019903fea8b181c6deedc2529d77241"], "node": "589ffc2af249ec23fcfd249b7beaf2e66e65b361", "parents": ["81c2e26ff91b484dc71ca9e1cdb65fd0c1fee69c"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068448 - Call MaybeBecomeUntrusted in RedirectToRealChannel, r=mccr8,necko-reviewers,valentin\" for causing build bustages in DocumentChannelChild.cpp\n\nThis reverts commit f8ae3ce8f8126d91a12e018149dc75ae452fccf4.\n", "files": ["netwerk/ipc/DocumentChannelChild.cpp"], "git_node": "a918492dd0f0fb92fd14b16e63cfe02edcb10d09", "git_parents": ["1caf8be159a12fc5f15cb525bb7e7cef72d21ada"], "node": "63cda7192cb53cf72c61f133f289eda3d979eeb8", "parents": ["589ffc2af249ec23fcfd249b7beaf2e66e65b361"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067228: Add form fill outcomes test for SFF telemetry r=omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323739\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry.js"], "git_node": "0accc4119ad061f250b09551b2e6997a4e311c49", "git_parents": ["a918492dd0f0fb92fd14b16e63cfe02edcb10d09"], "node": "2f0b4d2b4cfb412bd74e069ef4e904aa73a0586f", "parents": ["63cda7192cb53cf72c61f133f289eda3d979eeb8"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2066435 - delete downloaded support files when download is blocked r=mak\n\nPass in the path to the `filesFolder` to the `nsITransfer` so it can\ndelete that folder if the download gets blocked or removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321684\n", "files": ["toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_save_page_complete_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/save_page_complete.css", "toolkit/components/contentanalysis/tests/browser/save_page_complete.html", "toolkit/components/downloads/DownloadCore.sys.mjs", "toolkit/components/downloads/DownloadLegacy.sys.mjs", "toolkit/components/downloads/test/unit/head.js", "toolkit/content/contentAreaUtils.js", "uriloader/base/nsITransfer.idl", "uriloader/exthandler/nsExternalHelperAppService.cpp"], "git_node": "0fd9b6ff4e4174f8e68a4102db8b84056b4ed80e", "git_parents": ["0accc4119ad061f250b09551b2e6997a4e311c49"], "node": "79e3cb01112bbef6ac9d7654b2cd110301d4d6c9", "parents": ["2f0b4d2b4cfb412bd74e069ef4e904aa73a0586f"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063528 - Use nsCString / UTF8String for InspectorUtils.getComputationSteps. r=emilio,firefox-style-system-reviewers,layout-reviewers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324613\n", "files": ["dom/chrome-webidl/InspectorUtils.webidl", "layout/inspector/InspectorUtils.cpp", "layout/inspector/InspectorUtils.h", "servo/ports/geckolib/glue.rs"], "git_node": "59fecf00c0745c36e9b386e1e1be3a489161e306", "git_parents": ["0fd9b6ff4e4174f8e68a4102db8b84056b4ed80e"], "node": "87893d5e1b10dd3ca5b8fcb2b0ecb9aeeafcf420", "parents": ["79e3cb01112bbef6ac9d7654b2cd110301d4d6c9"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066009: Fix aboutsync-log for long translations and tweak some UX r=sync-reviewers,fluent-reviewers,flod,LougeniaBailey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322025\n", "files": ["services/sync/content/aboutSyncLog.css", "services/sync/content/aboutSyncLog.html", "services/sync/content/aboutSyncLog.mjs", "services/sync/tests/browser/browser_aboutSyncLog.js", "toolkit/locales/en-US/services/aboutSyncLog.ftl"], "git_node": "f6242131346fdbd3b6c7ab32e7b7180f48d390f0", "git_parents": ["59fecf00c0745c36e9b386e1e1be3a489161e306"], "node": "8ee2f8eddaf70516e3baa732511c9a376565f7ee", "parents": ["87893d5e1b10dd3ca5b8fcb2b0ecb9aeeafcf420"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2067256 - Keep the computed keyframe offset unresolved for zero animation attachment range. r=layout-scroll-driven-animation-reviewers,dshin\n\nPer WebKit's update, https://github.com/WebKit/WebKit/pull/71850, I\nthink this makes more sense to make the computed offset be unresolved,\ninstead of +/-Infinity, given that we cannot find a specified point in\nthe timeline with zero animation attachment range.\n\nThis aligns the behavior of WebKit and Chromium.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324772\n", "files": ["dom/animation/KeyframeUtils.cpp", "testing/web-platform/meta/scroll-animations/css/timeline-offset-keyframes-zero-length-attachment-range.html.ini"], "git_node": "24230d91fdb3b497e7af651072bd5e2cbd2f28b4", "git_parents": ["f6242131346fdbd3b6c7ab32e7b7180f48d390f0"], "node": "dc395a463c48a19493c16b33b6b38c5a8558582c", "parents": ["8ee2f8eddaf70516e3baa732511c9a376565f7ee"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051632 - implement new profiles-related telemetry in Accounts menu r=sync-reviewers,jhirsch,LougeniaBailey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322744\n", "files": ["browser/base/content/browser-profiles.js", "browser/base/content/browser-sync.js", "browser/components/profiles/tests/browser/browser.toml", "browser/components/profiles/tests/browser/browser_fxa_menu_profiles_telemetry.js", "services/sync/modules/metrics.yaml"], "git_node": "5d087ada83d9b2fe1b635d4154011c2a4baca6ec", "git_parents": ["24230d91fdb3b497e7af651072bd5e2cbd2f28b4"], "node": "33c47cf2beb9b9c29e04db26de86818a297973c7", "parents": ["dc395a463c48a19493c16b33b6b38c5a8558582c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068398: Recheck regexp syntax when u/v flag is removed r=spidermonkey-reviewers,mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324765\n", "files": ["js/src/builtin/RegExp.cpp", "js/src/jit-test/tests/regexp/bug2068398.js"], "git_node"