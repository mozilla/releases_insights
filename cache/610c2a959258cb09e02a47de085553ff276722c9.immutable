6455721f5b6ca0\nzam -\u003e 8a04c5f258cd75850625306ccc6455721f5b6ca0\nzh-CN -\u003e 8a04c5f258cd75850625306ccc6455721f5b6ca0\nzh-TW -\u003e 8a04c5f258cd75850625306ccc6455721f5b6ca0\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "61150e67f00987148977be83e0597e787f9301b1", "git_parents": ["0b1395c9481fa0bb9b016fb5bfe8f8c440978ee0"], "node": "740a76092f391d9687847685538b0d8b3e7a4b1c", "parents": ["2dd575299aae4773c8342a7c059f89a2833288b7"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2067025 - Rework wasm::StackMapGenerator::createStackMap to be more tolerant of registers.  r=bvisness.\n\nStackMapGenerator::createStackMap (in WasmBCFrame.cpp) creates stackmaps for\nthe wasm baseline compiler.  Currently it always rejects eval stack entries\nthat are non-references but live in registers.  This is safe but is too\ninflexible to support recent work on stackmaps for traps.\n\nIn particular, it release-asserts unnecessarily when asked to create a stackmap\nfor a trap that might resume, and the eval stack contains a non-ref in a\nregister.  That register-residency is safe if we assume (reasonably) that\nresumable traps preserve register-resident values.\n\nAdditionally, the existing logic is split into a DEBUG case and a non-DEBUG\ncase, which makes it hard to read / reason about.\n\nThis patch:\n\n* clarifies the rules about when refs and non-refs may be resident in registers\n\n* redoes the eval-stack-scan loop accordingly\n\n* removes the DEBUG/non-DEBUG split.  It's now just one big switch statement\n  with a bunch of MOZ_ASSERTs; in the non-DEBUG case those will disappear and\n  the resulting loop-around-a-switch should optimize down to something close to\n  the previous non-DEBUG version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321788\n", "files": ["js/src/wasm/WasmBCFrame.cpp"], "git_node": "e79d70b9d220b45e1643efaac866a5158c9c78b1", "git_parents": ["61150e67f00987148977be83e0597e787f9301b1"], "node": "a10ccf66d1cc5b779b4e59a9fea95922a939d93a", "parents": ["740a76092f391d9687847685538b0d8b3e7a4b1c"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061360 - Add the Smart Form Fill form review component r=Mardak,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318022\n", "files": ["browser/components/aiwindow/ui/components/ai-sff-form-review/ai-sff-form-review.css", "browser/components/aiwindow/ui/components/ai-sff-form-review/ai-sff-form-review.mjs", "browser/components/aiwindow/ui/components/ai-sff-form-review/ai-sff-form-review.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillConstants.mjs", "browser/locales-preview/aiWindow.ftl"], "git_node": "1b653b9a7c3f392bd60170472cc6c71037d0d662", "git_parents": ["e79d70b9d220b45e1643efaac866a5158c9c78b1"], "node": "331f8b75c1120f4a3f5634559dc5a439fd54ca95", "parents": ["a10ccf66d1cc5b779b4e59a9fea95922a939d93a"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061360 - Add an isolated host for the Smart Form Fill review dialog r=desktop-theme-reviewers,Mardak,ai-security-reviewers,sfoster,gregtatum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318023\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "browser/components/aiwindow/ui/actors/SmartFormFillReviewChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillReviewParent.sys.mjs", "browser/components/aiwindow/ui/content/smartformfill-form-review-content.css", "browser/components/aiwindow/ui/content/smartformfill-form-review-content.html", "browser/components/aiwindow/ui/content/smartformfill-form-review.css", "browser/components/aiwindow/ui/content/smartformfill-form-review.html", "browser/components/aiwindow/ui/content/smartformfill-form-review.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/moz.build"], "git_node": "da4865ae28b62cc8bfa90b7d06e424a179d6e23e", "git_parents": ["1b653b9a7c3f392bd60170472cc6c71037d0d662"], "node": "17519a48e6e96b58445d337b026cc9fbc67263de", "parents": ["331f8b75c1120f4a3f5634559dc5a439fd54ca95"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061360 - Make Smart Form Fill field filling report operation results r=Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318024\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs"], "git_node": "9ffccc204f9aef26174ff1a5e127e130d0549265", "git_parents": ["da4865ae28b62cc8bfa90b7d06e424a179d6e23e"], "node": "30f0d90939a8d260ad497d4f2ab893d0ef3005d5", "parents": ["17519a48e6e96b58445d337b026cc9fbc67263de"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061360 - Integrate the form review dialog into Smart Form Fill r=Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318025\n", "files": ["browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillReviewSession.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_metadata_lifecycle.js"], "git_node": "0fbe15431d94592f1058cb9cda1b16d645581fd5", "git_parents": ["9ffccc204f9aef26174ff1a5e127e130d0549265"], "node": "9b147120356100bce899031fb901c4d9a47635cc", "parents": ["30f0d90939a8d260ad497d4f2ab893d0ef3005d5"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2061360 - Add browser tests for Smart Form Fill form review r=Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318026\n", "files": ["browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_editing.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_filling.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_form_review_generation.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_telemetry.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_form_review.js"], "git_node": "6d1840fcc614cb1b1b33301c83a9f7920c62d60c", "git_parents": ["0fbe15431d94592f1058cb9cda1b16d645581fd5"], "node": "0102d41e7e18070a444380f42edfe5efd943c0d9", "parents": ["9b147120356100bce899031fb901c4d9a47635cc"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2067205. Don't verify the app-services version bump moz.yaml, it perma fails on beta. r=taskgraph-reviewers,jcristau\n\nSince Fx156 went to beta and app-services switched to the release channel, the\nversion bump script stops with NotImplementedError, because it only handles\nnightly. The vendoring verification job runs it, so beta is perma orange.\n\nTo fix this orange we should just stop checking this moz.yaml. It isn't a useful\ncheck anyway, because there is no library being vendored into our tree here.\nmobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml says\nin its own header that application-services is not really vendored there. It skips\nevery vendoring step, and its one update-action bumps the app-services version in\nApplicationServices.kt to the newest build. Even on central the check isn't telling\nus anything, it just looks like it is: the script exits without doing anything as\nlong as no newer app-services build exists, and the first time one does it rewrites\nApplicationServices.kt and the job reports that as drift.\n\nWe create a new skip list just for this one, because neither of the existing states\nfits. Leaving it out of the expected-fail file means it has to pass, and on beta it\ncan't. Putting it in means it has to fail, and on central it mostly doesn't.\n\nWe want this list to stay at one ideally, so we strongly warn in the comments not\nto add to it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322021\n", "files": ["taskcluster/kinds/source-test/vendor-verify.yml", "taskcluster/scripts/misc/check-vendor-coverage.py"], "git_node": "a801f6e21cb1b8a5c576d758e4e3eb4c35bd8585", "git_parents": ["6d1840fcc614cb1b1b33301c83a9f7920c62d60c"], "node": "c829a22a2ddb5ec259384ec748e9a29188037157", "parents": ["0102d41e7e18070a444380f42edfe5efd943c0d9"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 1: Plumb nurseryOwned parameter through buffer allocator APIs r=sfink\n\nThis is just plumbing. The parameter will be used by future patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320979\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "a571e88e8833dabd77a05a9bd59afdadf893f1de", "git_parents": ["a801f6e21cb1b8a5c576d758e4e3eb4c35bd8585"], "node": "5c1b3dad83a180c2269f077b23ae56b35deb940c", "parents": ["c829a22a2ddb5ec259384ec748e9a29188037157"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 2: Add FreeLists predicates for whether they contain free regions in the spcified range r=sfink\n\nSmall refactoring to make assertions less verbose.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320980\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h"], "git_node": "49edd19cce3492cb0b79cf78c44ec9f74b9f662c", "git_parents": ["a571e88e8833dabd77a05a9bd59afdadf893f1de"], "node": "b9752cb1de000f487a2768a7ba2767ef216e31a1", "parents": ["5c1b3dad83a180c2269f077b23ae56b35deb940c"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 3: Add a total BufferChunk count r=sfink\n\nThis is used for a heuristic in the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320981\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h"], "git_node": "67569788876da165c04313f3d4a56e8796426009", "git_parents": ["49edd19cce3492cb0b79cf78c44ec9f74b9f662c"], "node": "a5a37f6c207e790317805807e207ce8287dd8e15", "parents": ["b9752cb1de000f487a2768a7ba2767ef216e31a1"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 4: Partition buffer allocator free lists by chunk kind r=sfink\n\nThe adds separate free lists for mixed / tenured chunks and uses them based on\nwhether the allocation is nursery or tenured owned.\n\nWe don't want to do this all the time. For small heaps we want to share chunks\nbetween nursery and tenured owned allocations. And to prevent reducing the heap\ndensity too much we probably don't want to allocate branch new chunks for both\ntenured and nursery owned allocations (although I'm less sure on this). Mainly\nwe want to do this when allocating into previously swept partially used chunks.\n\nThis is implemented by the flag |allocTenuredInMixedChunks|. This is set to\ntrue for small heaps (currently \u003c= 4 MB) and when we run out of available\nchunks and start allocating new ones.\n\nThis simplifies BufferAllocator::startMinorSweeping and removes scanning the\nfree lists. This also lets us skip moving tenured free lists to their chunk\nheader on minor GC which was there so that scanning free lists didn't take too\nlong.\n\nWe also now set the chunk's |hasNurseryOwnedAllocs| flag in useAvailableChunk\nso we don't need to change it later any more. Changing it would now involve\nmore work as we would have to move all its free regions from |tenuredFreeLists|\nto |mixedFreeLists| which is possible but inconvenient.\n\nThis all means that we'll allocate more memory rather than allocating a nursery\nowned allocation into a chunk we're currently using for tenured allocations.\nThis doesn't show much increase in max heap size in testing so this is probably\nfine, and we can come back later and change this if it becomes a problem.\n\nreview comments\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320982\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h"], "git_node": "5a6f4f3c48afa78533365fe1f8766d23790e9da7", "git_parents": ["67569788876da165c04313f3d4a56e8796426009"], "node": "4a136ced8da68476ac7457382f191be238ea92cd", "parents": ["a5a37f6c207e790317805807e207ce8287dd8e15"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 5: Refactor to move some methods to the relevant class r=sfink\n\nThis doesn't change any behaviour it just reorganises the following:\n - Make BufferAllocator::makeFreeRegion into FreeRegion::create\n - Make BufferAllocator::pushFreeRegionFront/Back into FreeLists::pushFront/back\n - Remove unnecessary BufferAllocator* parameter to sweep metonds\n - Move BufferAllocator::addSweptRegion methods to BufferChunk and SmallBufferRegion\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321310\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/BufferAllocatorInternals.h"], "git_node": "3b2a093e34f9c9374f366178af310351bfa9b390", "git_parents": ["5a6f4f3c48afa78533365fe1f8766d23790e9da7"], "node": "f9885d09247709172d182c1124f40e7279fed8ca", "parents": ["4a136ced8da68476ac7457382f191be238ea92cd"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 6: Rebuild free lists for swept chunks on demand r=sfink\n\nRather than moving free regions in tenured chunks back to the chunk header on\nmajor GC, just clear them and rebuild if necessary. The only time we need them\nis if we abort collection as they are rebuilt when we sweep.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321311\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/BufferAllocatorInternals.h"], "git_node": "00b23040d7a7837c27038c60c40327fa19f2cc34", "git_parents": ["3b2a093e34f9c9374f366178af310351bfa9b390"], "node": "1fb8e595661665e1dc902ef1d5253a4ff1f8bb65", "parents": ["f9885d09247709172d182c1124f40e7279fed8ca"], "tags": []}, {"author": "Kenneth Langga \u003cklangga@gmail.com\u003e", "branch": "default", "desc": "Bug 2059329 - Atomically replace and close portal notifications. r=saschanaz\n\nTrack active notifications by name; an empty name is a name like any\nother, just shared by many alerts. A named alert derives a stable id,\nso showing a same-name alert makes the portal update the existing\nnotification in place instead of Firefox closing and recreating it,\nwhich is the sequence that made field-identical replacements vanish on\nKDE Plasma. When a replaced alert's id differs (alerts with an empty\nname get a fresh id per show), the replaced notification is withdrawn,\nmatching how the libnotify backend closes the replaced listener. The\nreplaced alert's callbacks receive alertfinished before its\nsuccessor's alertshow.\n\nTeardown, like the libnotify backend, leaves the notifications up and\nonly drops the remaining callbacks without firing them, as dispatching\nalertfinished that late in shutdown races service worker teardown;\nresponding to notifications that outlived their session is bug\n2065932. CloseAlert withdraws through a fire-and-forget\nRemoveNotification whose failures go unobserved. A notification\ndismissed from the desktop shell still cannot be observed until signal\ndispatch arrives with action support in a later step.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317389\n", "files": ["toolkit/system/gnome/rust/src/portal_alerts_service.rs"], "git_node": "319e37f1f940e54e10a73ebfdfd6fd98593116eb", "git_parents": ["00b23040d7a7837c27038c60c40327fa19f2cc34"], "node": "25cdd8ad3fde5577ce72952709dc0958f88218af", "parents": ["1fb8e595661665e1dc902ef1d5253a4ff1f8bb65"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge Mozilla-central to autoland\n", "files": ["third_party/libwebrtc/g3doc/todo/byte_order_safety.md", "third_party/libwebrtc/logging/rtc_event_log/encoder/rtc_event_log_encoder_legacy.cc", "third_party/libwebrtc/logging/rtc_event_log/encoder/rtc_event_log_encoder_legacy.h", "third_party/libwebrtc/media/base/video_source_base.cc", "third_party/libwebrtc/media/base/video_source_base.h", "third_party/libwebrtc/media/video_source_base_gn/moz.build", "third_party/libwebrtc/modules/third_party/portaudio/BUILD.gn", "third_party/libwebrtc/modules/third_party/portaudio/LICENSE", "third_party/libwebrtc/modules/third_party/portaudio/README.chromium", "third_party/libwebrtc/modules/third_party/portaudio/pa_memorybarrier.h", "third_party/libwebrtc/modules/third_party/portaudio/pa_ringbuffer.c", "third_party/libwebrtc/modules/third_party/portaudio/pa_ringbuffer.h", "third_party/libwebrtc/moz-patch-stack/01455efea7.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/5da5a6e4e0.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/612430e826.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/67becacf3c.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/a0253ec15b.no-op-cherry-pick-msg"], "git_node": "734aa7e5f8b2a7a30dde36318d58b092e3bb54ab", "git_parents": ["319e37f1f940e54e10a73ebfdfd6fd98593116eb", "551ef4c6cd94ed3d9cf0334b20cde330c5672714"], "node": "eb7f2c586d5a3e30fe9be5737ab8e6851246908b", "parents": ["25cdd8ad3fde5577ce72952709dc0958f88218af", "5f3cef8be5dea26685b2c958cfce35af0934928a"], "tags": []}, {"author": "Abel Kalu \u003c59095867+BlessedOneKobo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066478 - Remove stale references to openUILinkIn in comments. r=urlbar-reviewers,devtools-reviewers,ochameau,dao DONTBUILD\n\nThere is no openUILinkIn function any more, but six comments still send the reader there\nfor the list of supported parameters. The function that takes those parameters today is\nURILoadingHelper.openLinkIn, exposed on a browser window as openLinkIn; openUILink is\nthe variant that derives where to open from an event's modifiers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321884\n", "files": ["browser/actors/ContentSearchParent.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "devtools/client/shared/link.js"], "git_node": "a8e25fc925a29bd6c46dcfb68a0a2693fd79c1e3", "git_parents": ["734aa7e5f8b2a7a30dde36318d58b092e3bb54ab"], "node": "45c0f30ef6795ee04787085a5d22b8198464a06c", "parents": ["eb7f2c586d5a3e30fe9be5737ab8e6851246908b"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2067338. Misc cleanups to preserve3d wrapping display list code. r=layout-reviewers,emilio\n\nFollow up to review comments in bug 2066084.\n\nWrapSeparatorTransform didn't convey that it only wraps the non-participants\naccumulated so far, and that it does nothing when there are none. Rename it to\nFlushNonParticipantsIntoSeparatorTransform and say the rest in a comment.\n\nThe index was passed by value and every caller incremented it, so an index was\nused up each time there was nothing to wrap. Pass it by reference and consume it\nonly when an item is actually created.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322031\n", "files": ["layout/generic/nsIFrame.cpp"], "git_node": "bc8429b28b30d1eb4c8ac9a9ba99d4725aeb256a", "git_parents": ["a8e25fc925a29bd6c46dcfb68a0a2693fd79c1e3"], "node": "ca1607ebdf07d95e7b4768e3f1e7e53704f1e3cf", "parents": ["45c0f30ef6795ee04787085a5d22b8198464a06c"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066149 - Part 6: Rebuild free lists for swept chunks on demand r=sfink\" for causing failures at BufferAllocator.cpp\n\nThis reverts commit 00b23040d7a7837c27038c60c40327fa19f2cc34.\n\nRevert \"Bug 2066149 - Part 5: Refactor to move some methods to the relevant class r=sfink\"\n\nThis reverts commit 3b2a093e34f9c9374f366178af310351bfa9b390.\n\nRevert \"Bug 2066149 - Part 4: Partition buffer allocator free lists by chunk kind r=sfink\"\n\nThis reverts commit 5a6f4f3c48afa78533365fe1f8766d23790e9da7.\n\nRevert \"Bug 2066149 - Part 3: Add a total BufferChunk count r=sfink\"\n\nThis reverts commit 67569788876da165c04313f3d4a56e8796426009.\n\nRevert \"Bug 2066149 - Part 2: Add FreeLists predicates for whether they contain free regions in the spcified range r=sfink\"\n\nThis reverts commit 49edd19cce3492cb0b79cf78c44ec9f74b9f662c.\n\nRevert \"Bug 2066149 - Part 1: Plumb nurseryOwned parameter through buffer allocator APIs r=sfink\"\n\nThis reverts commit a571e88e8833dabd77a05a9bd59afdadf893f1de.\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/BufferAllocatorInternals.h", "js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "ac9bc96e0569fb6ceecdaca919c944cf362db626", "git_parents": ["bc8429b28b30d1eb4c8ac9a9ba99d4725aeb256a"], "node": "5fb337ec063ad1bc8f487dd4795594fc0887940b", "parents": ["ca1607ebdf07d95e7b4768e3f1e7e53704f1e3cf"], "tags": []}], "date": 1787933795, "git_changesets": ["0b1395c9481fa0bb9b016fb5bfe8f8c440978ee0", "61150e67f00987148977be83e0597e787f9301b1", "e79d70b9d220b45e1643efaac866a5158c9c78b1", "1b653b9a7c3f392bd60170472cc6c71037d0d662", "da4865ae28b62cc8bfa90b7d06e424a179d6e23e", "9ffccc204f9aef26174ff1a5e127e130d0549265", "0fbe15431d94592f1058cb9cda1b16d645581fd5", "6d1840fcc614cb1b1b33301c83a9f7920c62d60c", "a801f6e21cb1b8a5c576d758e4e3eb4c35bd8585", "a571e88e8833dabd77a05a9bd59afdadf893f1de", "49edd19cce3492cb0b79cf78c44ec9f74b9f662c", "67569788876da165c04313f3d4a56e8796426009", "5a6f4f3c48afa78533365fe1f8766d23790e9da7", "3b2a093e34f9c9374f366178af310351bfa9b390", "00b23040d7a7837c27038c60c40327fa19f2cc34", "319e37f1f940e54e10a73ebfdfd6fd98593116eb", "734aa7e5f8b2a7a30dde36318d58b092e3bb54ab", "a8e25fc925a29bd6c46dcfb68a0a2693fd79c1e3", "bc8429b28b30d1eb4c8ac9a9ba99d4725aeb256a", "ac9bc96e0569fb6ceecdaca919c944cf362db626"], "user": "ctuns@mozilla.com"}, "45203": {"changesets": [{"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062778 - don't skip synchronous pref writes if an async pref write is already queued r=beth\" for causing failures at browser_savePrefFile_explicit_target.js.\n\nThis reverts commit c177a7da7586d9e41d66893c25b6c8bdbb236341.\n", "files": ["modules/libpref/Preferences.cpp", "modules/libpref/test/browser/browser.toml", "modules/libpref/test/browser/browser_savePrefFile_explicit_target.js"], "git_node": "60bcc63df5cc658032bdae00fbdfb6985145d65c", "git_parents": ["ac9bc96e0569fb6ceecdaca919c944cf362db626"], "node": "28c89741dbe9ed5086dbf97ff24e6c0aced4a0f4", "parents": ["5fb337ec063ad1bc8f487dd4795594fc0887940b"], "tags": []}], "date": 1787933865, "git_changesets": ["60bcc63df5cc658032bdae00fbdfb6985145d65c"], "user": "ctuns@mozilla.com"}, "45204": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2063870. Let `mach npm` run in a tree that has not been configured. r=firefox-build-system-reviewers,sergesanspaille\n\n`mach npm` sets FIREFOX_BIN for karma-firefox-launcher, and is written to cope with there\nbeing no binary: it passes validate_exists=False and then checks os.path.exists() before\nusing the path. But get_binary_path() itself raises BuildEnvironmentNotFoundException when\nthere is no config.status, before that check is reached, so the command fails outright:\n\n  BuildEnvironmentNotFoundException: config.status not available. Run configure.\n\nThat makes `mach npm` unusable in an unconfigured tree even for work that has nothing to do\nwith a built Firefox. It also means vendoring scripts that call it cannot run in automation:\nthird_party/js/cfworker/build.sh uses `mach npm install` and `mach node`, and source-test\ntasks have no objdir.\n\nCatch the exception and leave FIREFOX_BIN unset in that case, which is what the following\nos.path.exists() check already anticipates. `mach node` is unaffected, as it never asks for\nthe binary path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318917\n", "files": ["tools/mach_commands.py"], "git_node": "c7ef73fb502ec6f3bbcfbb632b4fcb019e962a3a", "git_parents": ["ac9bc96e0569fb6ceecdaca919c944cf362db626"], "node": "8378ccafa5ae89a0e027253b101f98ab5e88e526", "parents": ["5fb337ec063ad1bc8f487dd4795594fc0887940b"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059513 - Don't defer switcher icon init in newtab. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319456\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "549b72e2ad4afe1d235a83f4e8b654528669d0a6", "git_parents": ["c7ef73fb502ec6f3bbcfbb632b4fcb019e962a3a"], "node": "d7537930ca6bf4e54adf4cec8dee649cecd10938", "parents": ["8378ccafa5ae89a0e027253b101f98ab5e88e526"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066910 - The \"__Host-\" prefixes require an explicit Path attribute of \"/\" r=cookie-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322041\n", "files": ["netwerk/cookie/CookieParser.cpp", "netwerk/cookie/CookieValidation.cpp", "netwerk/test/gtest/TestCookie.cpp"], "git_node": "e01ca9802f4f5518a3780b50a79879312d4241b6", "git_parents": ["549b72e2ad4afe1d235a83f4e8b654528669d0a6"], "node": "8390f786553b5186e123ca47f037bf2be72109cb", "parents": ["d7537930ca6bf4e54adf4cec8dee649cecd10938"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062778 - don't skip synchronous pref writes if an async pref write is already queued r=beth\" for causing failures at browser_savePrefFile_explicit_target.js.\n\nThis reverts commit c177a7da7586d9e41d66893c25b6c8bdbb236341.\n", "files": ["modules/libpref/Preferences.cpp", "modules/libpref/test/browser/browser.toml", "modules/libpref/test/browser/browser_savePrefFile_explicit_target.js"], "git_node": "9a1f4eb1674b77f2327ae186fc86e061ba6d7058", "git_parents": ["e01ca9802f4f5518a3780b50a79879312d4241b6"], "node": "5cb234fc0fb56a9af82b3068aa297f50118ff00b", "parents": ["8390f786553b5186e123ca47f037bf2be72109cb"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067394 - Update android nightly application-services version bump to a1132398f27aba8a0480870444177671b15efb36 r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322061\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "ca7113a2eaf39971d471a4c02a058ac694c9519e", "git_parents": ["9a1f4eb1674b77f2327ae186fc86e061ba6d7058"], "node": "566d3bcc4256466b3abcdb477a9cc4e4187f41bb", "parents": ["5cb234fc0fb56a9af82b3068aa297f50118ff00b"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2060755 - Set layout.css.supports.at-rule.enabled for release. 