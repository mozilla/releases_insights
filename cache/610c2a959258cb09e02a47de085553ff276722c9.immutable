m/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-020.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-021.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-015.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-016.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-048.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-auto-048-ref.html"], "git_node": "56b246655ff3ded68c639beeff5ef5fe8cbc621b", "git_parents": ["425ba11154e2e8403137b07570dfa157c9372376"], "node": "8543d929ffe626306841f077d2f0ef75ad3c41cb", "parents": ["2f468c7c2400e4edf46abd0a15b92b9bef5955f7"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049792 - Sanity-check content-provided result and original URI. r=nika,dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319828\n", "files": ["docshell/base/nsDocShellLoadState.cpp"], "git_node": "1fd5ada457b50e8bb03c6ec51e7acad5e34a8c6c", "git_parents": ["56b246655ff3ded68c639beeff5ef5fe8cbc621b"], "node": "655d1b113bda03b01f6fc436d8c5b6a14fe3eb85", "parents": ["8543d929ffe626306841f077d2f0ef75ad3c41cb"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049792 - Don't allow content to set result or original URI on SH. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319829\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "dom/ipc/ContentParent.cpp"], "git_node": "9a3aa431e42dba4d8b57c56eb54a66b16efaa390", "git_parents": ["1fd5ada457b50e8bb03c6ec51e7acad5e34a8c6c"], "node": "acf83d9f5e31828905f7686153d904441261771c", "parents": ["655d1b113bda03b01f6fc436d8c5b6a14fe3eb85"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2068870 - Test that single record address gets retried after it gets reported as unusable r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323219\n", "files": ["netwerk/test/unit/test_happy_eyeballs_all_addrs_unusable.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "8bc6d6bebfc043dcd7fbbae9f28a3bc004010c4d", "git_parents": ["9a3aa431e42dba4d8b57c56eb54a66b16efaa390"], "node": "26be76551a3e5fce64fe72e710bffa4ebed85a36", "parents": ["acf83d9f5e31828905f7686153d904441261771c"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2068870 - nsIDNSRecord::GetAddresses should return all addresses, including unusable ones r=necko-reviewers,kershaw\n\nA failed connection attempt with UDP doesn't imply a the same address doesn't work with UDP.\nGetAddresses should return the entire set of IP addresses.\nA followup in bug 2005716 can extend this to getNextAddr/getScriptableNextAddr/getNextAddrAsString\nin a backwards compatible way (there might be code relying on that)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323233\n", "files": ["netwerk/dns/nsDNSService2.cpp", "netwerk/dns/nsIDNSRecord.idl"], "git_node": "5e98521cc7bd92d4162a4b183de788398f1419a2", "git_parents": ["8bc6d6bebfc043dcd7fbbae9f28a3bc004010c4d"], "node": "92990ca1e376e58e5708106aa8482d47c4737955", "parents": ["26be76551a3e5fce64fe72e710bffa4ebed85a36"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068635 - Fix for sign in promo text in HCM r=desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323066\n", "files": ["browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "bc291fb7ffb93f235fc3cb0ceae7fed908daaa50", "git_parents": ["5e98521cc7bd92d4162a4b183de788398f1419a2"], "node": "c2684f89b6aee4d7db80408c57f659c00fbc6b4a", "parents": ["92990ca1e376e58e5708106aa8482d47c4737955"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066103 - Stop mirroring securityuicerterror_load_aboutcerterror r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320905\n", "files": ["browser/base/content/test/about/browser.toml", "browser/base/content/test/about/browser_aboutCertError_cca_telemetry.js", "browser/base/content/test/about/browser_aboutCertError_telemetry.js", "toolkit/components/telemetry/Events.yaml", "toolkit/content/metrics.yaml"], "git_node": "cb971b545cf14ca6e8d7c20f46b858bb425e93a4", "git_parents": ["bc291fb7ffb93f235fc3cb0ceae7fed908daaa50"], "node": "bc60e4ec30709f5d6d24db5df7627e96e841eba7", "parents": ["c2684f89b6aee4d7db80408c57f659c00fbc6b4a"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069269 - Block TubeDigger DLLs up to version 1.8.2.0 in all processes. r=gstoll,win-reviewers\n\nWiden the existing content process block to all processes and to all\nknown affected versions. TubeDigger injects TbdgHook[64].dll into\nFirefox and patches xul.dll code using hardcoded byte patterns and stack\nframe offsets. These can break whenever Firefox is rebuilt, and now\ncrash the browser process within seconds of startup. A second failure\nmode crashes on remote thread injection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323599\n", "files": ["toolkit/xre/dllservices/mozglue/WindowsDllBlocklistDefs.in"], "git_node": "463493a047c19ec87f524cc80b300356c4a5892a", "git_parents": ["cb971b545cf14ca6e8d7c20f46b858bb425e93a4"], "node": "ae142363a3533cd6073c12253071635796211ba1", "parents": ["bc60e4ec30709f5d6d24db5df7627e96e841eba7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2066814 - Restrict the properties that highlight pseudos get at cascade time. r=dshin\n\nMatches Chrome and the spec in terms of em / lh units etc, and prevents\nborder-radius to set the border-background flag without extra tracking.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/357\n", "files": ["servo/components/style/gecko/pseudo_element.rs", "servo/components/style/gecko/pseudo_element_definition.mako.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/data.py", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/rule_cache.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-pseudo/highlight-cascade/highlight-cascade-007.html.ini", "testing/web-platform/meta/forced-colors-mode/forced-colors-mode-14.html.ini", "testing/web-platform/tests/css/css-pseudo/selection-background-color-non-applicable-properties-ref.html", "testing/web-platform/tests/css/css-pseudo/selection-background-color-non-applicable-properties.html"], "git_node": "b9c51f59c975365d9cd7799cb2f5d1027a4a8a64", "git_parents": ["463493a047c19ec87f524cc80b300356c4a5892a"], "node": "9de51bc60b4affba54a5ad608a58ba06029fd64a", "parents": ["ae142363a3533cd6073c12253071635796211ba1"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2069287 - Show the PDF.js version and viewer prefs in about:support. r=pdfjs-reviewers,fluent-reviewers,flod,calixte\n\nAdd a \"PDF Viewer\" section to about:support reporting the PDF.js version,\nwhether the viewer is enabled, whether the annotation editor is enabled\n(pdfjs.annotationEditorMode set to -1 disables all the editing tools: draw,\nimage, text, signature), pdfjs.enableXfa and\nbrowser.download.open_pdf_attachments_inline.\n\nThe version only appears inside the vendored content/build/pdf.mjs, which is\ntoo large to import in the parent process just to read a string, so record it\nin a small generated PdfJsVersion.sys.mjs that update.sh rewrites during\nmach vendor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323550\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/jar.mn", "toolkit/components/pdfjs/update.sh", "toolkit/content/aboutSupport.js", "toolkit/content/aboutSupport.xhtml", "toolkit/locales/en-US/toolkit/about/aboutSupport.ftl", "toolkit/modules/Troubleshoot.sys.mjs", "toolkit/modules/tests/browser/browser_Troubleshoot.js"], "git_node": "4025226f41101ab12527030d07db081786c7b886", "git_parents": ["b9c51f59c975365d9cd7799cb2f5d1027a4a8a64"], "node": "fc3c75958741353285ad988954237d0a208464dc", "parents": ["9de51bc60b4affba54a5ad608a58ba06029fd64a"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068813 - Extend probe expiration dates to Fx 171: search.counts.* and browser.searchinit.engine_invalid_webextension. r=search-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323347\n", "files": ["toolkit/components/search/metrics.yaml"], "git_node": "7424da5a341e91cc408619bd5ec0e6032834fd4d", "git_parents": ["4025226f41101ab12527030d07db081786c7b886"], "node": "c12eb912e9fe374a38261096acf924c6df47dff2", "parents": ["fc3c75958741353285ad988954237d0a208464dc"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2065176 - Retire detect-leaks-arm and enable leak detection on tae-arm r=isabel_rios\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323617\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/perf/FenixDetectLeaksAssert.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/test_infra/flank-configs/fenix/arm-tae-tests.yml", "mobile/android/test_infra/flank-configs/fenix/arm64-v8a-detect-leaks.yml", "taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "3d2858024e8112a04bf34b05abf0d2ed843e734a", "git_parents": ["7424da5a341e91cc408619bd5ec0e6032834fd4d"], "node": "23f4e5cc7e608de566eaf3bd6c7b4df7c069bad9", "parents": ["c12eb912e9fe374a38261096acf924c6df47dff2"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - CI/Toolchain updates for Python `3.10` r=firefox-build-system-reviewers,sergesanspaille,jcristau\n\nThe Python toolchain we build is now version `3.10.11`, the last `3.10` with\nan official Windows installer for `pack-cpython.sh` to extract.\n\nThe Debian 11 bootstrap task goes away because bullseye ships nothing newer\nthan Python 3.9. The supported build hosts are the current stable and testing\nreleases, Debian 13 and 14, which keep their tasks. Rocky Linux 9 installs\n`python3.11` and puts it first on `PATH` as `python3`, since its `python3`\npackage stays at 3.9.\n\nThe Linux test tasks run on the fetched CI Python, so the `dbus-python`, `pygobject`\nand `pycairo` wheel tasks now build against it and are named by Python version.\nThe distro keyed wheel tasks and images were unused and were removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322844\n", "files": ["build/wheel_requirements.txt", "python/sites/wpt.txt", "taskcluster/kinds/bootstrap/kind.yml", "taskcluster/kinds/docker-image/kind.yml", "taskcluster/kinds/fetch/python-wheels.yml", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/source-test/python.yml", "taskcluster/kinds/test/compiled.yml", "taskcluster/kinds/test/kind.yml", "taskcluster/kinds/test/misc.yml", "taskcluster/kinds/test/xpcshell.yml", "taskcluster/kinds/toolchain/python-wheels.yml", "taskcluster/kinds/toolchain/python.yml", "taskcluster/kinds/web-platform-tests/kind.yml"], "git_node": "2e8b4c4c23fffa1cb395eb32192cb6cb8dd12a0e", "git_parents": ["3d2858024e8112a04bf34b05abf0d2ed843e734a"], "node": "1f6f36c843c4fa0c1fdc9014e6b049384f4a6de7", "parents": ["23f4e5cc7e608de566eaf3bd6c7b4df7c069bad9"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - Bump `mach` minimum `Python` version to `3.10` r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322845\n", "files": ["build/docs/python.md", "js/src/jit-test/README", "mach", "python/mach/docs/windows-usage-outside-mozillabuild.md", "python/mozboot/bin/bootstrap.py", "python/sites/bhr-aggregate.txt", "python/sites/build.txt", "python/sites/buildconfig.txt", "python/sites/common.txt", "python/sites/devtools-compat-test.txt", "python/sites/docs.txt", "python/sites/generate-test-certs.txt", "python/sites/ide.txt", "python/sites/ipython.txt", "python/sites/lint.txt", "python/sites/mach.txt", "python/sites/manifest.txt", "python/sites/newtab.txt", "python/sites/perftest-side-by-side.txt", "python/sites/perftest-test.txt", "python/sites/python-test.txt", "python/sites/repackage-deb.txt", "python/sites/repackage-desktop-file.txt", "python/sites/repackage-rpm.txt", "python/sites/repackage-snap.txt", "python/sites/taskgraph.txt", "python/sites/try.txt", "python/sites/update.txt", "python/sites/uv.txt", "python/sites/watch.txt", "python/sites/webcompat.txt", "python/sites/wpt-interop.txt", "python/sites/wpt.txt", "third_party/python/pyproject.toml"], "git_node": "472a9893b236c767f196f42a8a99d2c3b76646ae", "git_parents": ["2e8b4c4c23fffa1cb395eb32192cb6cb8dd12a0e"], "node": "8f5ef0ae815b3d26125398881a51f9efcdc18b30", "parents": ["1f6f36c843c4fa0c1fdc9014e6b049384f4a6de7"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - Regenerate the `Python` lockfiles for the new minimum `3.10` r=firefox-build-system-reviewers,mach-reviewers,sergesanspaille,ahal\n\n`./mach vendor python` covers `third_party/python` and moves no package\nversion. `taskcluster/requirements.txt` is compiled by its own command and\nneeded a matching `--python-version`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322846\n", "files": ["taskcluster/requirements.txt", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "2be3c19e50930036b44926cf8f393f56e7995be5", "git_parents": ["472a9893b236c767f196f42a8a99d2c3b76646ae"], "node": "e849711332ab7091519d54870cd2d7dcadb95dcc", "parents": ["8f5ef0ae815b3d26125398881a51f9efcdc18b30"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - Remove workarounds for `Python` versions below `3.10` r=firefox-build-system-reviewers,mozperftest-reviewers,sergesanspaille,sparky\n\nThe `mozperftest` numpy and scipy pins existed because `3.9` resolved\n`numpy\u003e=1.23` to a `2.x` source archive on the internal mirror (bug 2033807).\n\n`mozpack/archive.py` keeps reproducing the older tar behaviour, since docker\nimage hashes are keyed on that output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322847\n", "files": ["python/mozbuild/mozpack/archive.py", "python/mozbuild/mozpack/unify.py", "python/mozperftest/mozperftest/runner.py", "python/mozperftest/mozperftest/tests/test_mach_commands.py", "python/sites/docs.txt", "testing/gtest/reports.py"], "git_node": "3db90ac5c44940e610cda3a212f11ce7116bba93", "git_parents": ["2be3c19e50930036b44926cf8f393f56e7995be5"], "node": "6e48722b269ba65a56f263ee11aa2acc3c664063", "parents": ["e849711332ab7091519d54870cd2d7dcadb95dcc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - `wpt` related Python `3.9` to `3.10` compatibility changes r=jgraham\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322848\n", "files": ["taskcluster/kinds/source-test/wpt-unittest.yml"], "git_node": "db6a578c993a193f9d2ff7e6bdae880add3defef", "git_parents": ["3db90ac5c44940e610cda3a212f11ce7116bba93"], "node": "9419b91f344d2ce1b6f810feecc93b7b179c4531", "parents": ["6e48722b269ba65a56f263ee11aa2acc3c664063"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014269 - Bump vendored `pip` and `setuptools` past their `3.8` pins r=ahal,mach-reviewers\n\nUpdated pip v25.0.1 -\u003e v25.2\nUpdated setuptools v75.3.1 -\u003e v82.0.1\n\nAlso updated the wheels of these vendored in `third_party/python/_venv/wheels/` to match.\n\npip can't go past `25.2` because `25.3` removes `--no-use-pep517`, which mozharness\nneeds to avoid a CI regression, see bug 1858663.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322849\n", "files": ["third_party/python/_venv/wheels/pip-25.0.1-py3-none-any.whl", "third_party/python/_venv/wheels/pip-25.2-py3-none-any.whl", "third_party/python/_venv/wheels/setuptools-75.3.1-py3-none-any.whl", "third_party/python/_venv/wheels/setuptools-82.0.1-py3-none-any.whl", "third_party/python/pip/pip-25.0.1.dist-info/AUTHORS.txt", "third_party/python/pip/pip-25.0.1.dist-info/LICENSE.txt", "third_party/python/pip/pip-25.0.1.dist-info/METADATA", "third_party/python/pip/pip-25.0.1.dist-info/RECORD", "third_party/python/pip/pip-25.0.1.dist-info/WHEEL", "third_party/python/pip/pip-25.0.1.dist-info/entry_points.txt", "third_party/python/pip/pip-25.0.1.dist-info/top_level.txt", "third_party/python/pip/pip-25.2.dist-info/METADATA", "third_party/python/pip/pip-25.2.dist-info/RECORD", "third_party/python/pip/pip-25.2.dist-info/WHEEL", "third_party/python/pip/pip-25.2.dist-info/entry_points.txt", "third_party/python/pip/pip-25.2.dist-info/licenses/AUTHORS.txt", "third_party/python/pip/pip-25.2.dist-info/licenses/LICENSE.txt", "third_party/python/pip/pip-25.2.dist-info/licenses/src/pip/_vendor/cachecontrol/LICENSE.txt", "third_party/python/pip/pip-25.2.dist-info/licenses/src/pip/_vendor/certifi/LICENSE", "third_party/python/pip/pip-25.