edia/ipc/RemoteImageHolder.cpp", "dom/media/ipc/RemoteVideoDecoder.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp"], "git_node": "37d56c6540e419ec741db376fc2d315a19abb3c8", "git_parents": ["01c45e1d0b918de783e9a40953a52d4e5ca76dcd"], "node": "4e1023a31f03d67270de1d53e9b03f12691612f9", "parents": ["a55bf6b191200ba185a2eb4f50ab2a1f260f2841"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Test FFmpeg decoded frame color metadata r=media-playback-reviewers,alwu\n\nGenerate av1-color-metadata.mp4 with:\n  ./generate_color_metadata_video.py av1-color-metadata.mp4\n      --codec libaom-av1 --pixel-format yuv420p10le\n      --color-primaries bt2020 --color-transfer smpte2084\n      --color-matrix bt2020nc --color-range tv --movflags +faststart\n      --encoder-option cpu-used=8 --encoder-option still-picture=1\n      --encoder-option crf=30\n\nThe checked-in fixture was generated with FFmpeg 6.1.1-3ubuntu5.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321982\n", "files": ["dom/media/gtest/TestMediaDataDecoder.cpp", "dom/media/gtest/av1-color-metadata.mp4", "dom/media/gtest/generate_color_metadata_video.py", "dom/media/gtest/moz.build"], "git_node": "4f269732387239afc2fffe3a30d7c19dcb01e74c", "git_parents": ["37d56c6540e419ec741db376fc2d315a19abb3c8"], "node": "0525781bc9211f8c6461aa6d2da9c10d0ce7f6f7", "parents": ["4e1023a31f03d67270de1d53e9b03f12691612f9"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Preserve FFmpeg decoded frame color metadata r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321681\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "8765bd0c42d3ede148e8825058dd72be79ca9d1f", "git_parents": ["4f269732387239afc2fffe3a30d7c19dcb01e74c"], "node": "6fc26ec48e187a06b20c4cdd342e6c110936224b", "parents": ["0525781bc9211f8c6461aa6d2da9c10d0ce7f6f7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Update draw-snapshot AV1 color-quads fuzziness r=media-playback-reviewers,alwu\n\nPreserving FFmpeg's decoded color metadata reduces the pixel differences for the full-range 8-bit and 10-bit AV1 cases. Update their draw-snapshot expectations to match the corrected output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322710\n", "files": ["dom/media/test/reftest/color_quads/reftest.list"], "git_node": "bb863e4e7ac21057b67c1623d3b7689ebc4dc037", "git_parents": ["8765bd0c42d3ede148e8825058dd72be79ca9d1f"], "node": "26ece526d91afc480b2106d66624d7dfa553e08c", "parents": ["6fc26ec48e187a06b20c4cdd342e6c110936224b"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066447 - Don't offer the dnsNotFound search CTA for private-use intranet TLDs - r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322082\n", "files": ["browser/base/content/test/about/browser_aboutNetError_searchCTA_derivation.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA_telemetry.js", "toolkit/modules/URLKeywordAnalyzer.sys.mjs", "toolkit/modules/tests/xpcshell/test_URLKeywordAnalyzer.js"], "git_node": "6ac255022371891b62effd359001b809a886608f", "git_parents": ["bb863e4e7ac21057b67c1623d3b7689ebc4dc037"], "node": "cee989029c31093cefad85771557c83f245331c6", "parents": ["26ece526d91afc480b2106d66624d7dfa553e08c"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2067858 - Fix text-decoration on inline boxes when text-box-trim is applied. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322766\n", "files": ["layout/generic/nsLineLayout.cpp", "testing/web-platform/meta/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-002.html.ini", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-001-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-001.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-002-ref.html", "testing/web-platform/tests/css/css-inline/text-box-trim/text-box-trim-inline-box-text-decoration-002.html"], "git_node": "9bbefdc724d45bbcb75e1ddc9705bbea726d0988", "git_parents": ["6ac255022371891b62effd359001b809a886608f"], "node": "51e42ab44444c3ce47463413e1b8f2b09e0c51ef", "parents": ["cee989029c31093cefad85771557c83f245331c6"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062903 - Don't allow system principal in ContentParent::RecvGetClipboardDataSnapshot; r=tschuster\" for causing crashes at ZwWaitForAlertByThreadId.\n\nThis reverts commit a55094c1cd9d7468221b0c50a491e54779f65d59.\n", "files": ["dom/ipc/ContentParent.cpp", "widget/tests/clipboard_helper.js", "widget/tests/file_test_clipboard_getDataSnapshot.js", "widget/tests/test_clipboard_getDataSnapshot.html", "widget/tests/test_clipboard_getDataSnapshotSync.html"], "git_node": "29a48ebb0ffc48121b6b00eed922c4dd89d6ba38", "git_parents": ["9bbefdc724d45bbcb75e1ddc9705bbea726d0988"], "node": "94b2433648877baca72b21c9d98914b016a322b2", "parents": ["51e42ab44444c3ce47463413e1b8f2b09e0c51ef"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050444 - Change sidebar width to 50x wide when vertical tabs are enabled in compact and standard UI densities to make room for scrollbar r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321983\n", "files": ["browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "f73dc6e8e0e5f5bd0f11a28f389fcfc10356c4bd", "git_parents": ["29a48ebb0ffc48121b6b00eed922c4dd89d6ba38"], "node": "895abe8f326acd56d94933088e51e48b262aa95f", "parents": ["94b2433648877baca72b21c9d98914b016a322b2"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068136 - Ensure sidebar icon colors have the right color across themes r=desktop-theme-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322742\n", "files": ["browser/themes/shared/browser-shared.css"], "git_node": "64d42aa41d46ad12b354cf16eb81875affca31c5", "git_parents": ["f73dc6e8e0e5f5bd0f11a28f389fcfc10356c4bd"], "node": "7ae9130241e5c6660949c0f987019e817bad3d04", "parents": ["895abe8f326acd56d94933088e51e48b262aa95f"], "tags": []}, {"author": "Abel Kalu \u003c59095867+BlessedOneKobo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2053553 Remove unused WebRender debug preferences. r=emilio,layout-reviewers\n\nThe following WebRender debug preferences are no longer in use. They are no longer in the GFX_WEBRENDER_DEBUG\nflag table in gfx/thebes/gfxPlatform.cpp.\n\nmodules/libpref/init/all.js:\n\t- gfx.webrender.debug.alpha-primitives\n\t- gfx.webrender.debug.slow-frame-indicator\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322553\n", "files": ["modules/libpref/init/all.js"], "git_node": "6707383f24d4f925250036927bef970612ffc7d1", "git_parents": ["64d42aa41d46ad12b354cf16eb81875affca31c5"], "node": "2046d5147021945b72158f71afae9be9fb029fd1", "parents": ["7ae9130241e5c6660949c0f987019e817bad3d04"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067366 - Restore the scrollbar in menulist popups. r=desktop-theme-reviewers,emilio\n\nA vertical arrowscrollbox hides its scrollbar, and the menulist rule set the scrollbox's overflow but not its scrollbar-width, so the popup kept scrolling with nothing to drag. Dropping the overflow declarations leaves overflow-x hidden, so a menuitem wider than the popup is cropped rather than scrolled sideways.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322351\n", "files": ["toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/test_menulist_scrollbar.xhtml", "toolkit/content/widgets/menupopup.css"], "git_node": "fbb53381e93064a29a72c5a48222d00ec615ac27", "git_parents": ["6707383f24d4f925250036927bef970612ffc7d1"], "node": "01419239f143db3df6f7c8a1658b5c0dc9082b54", "parents": ["2046d5147021945b72158f71afae9be9fb029fd1"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2067986 - Remove missed security perf test r=mozperftest-reviewers,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322665\n", "files": ["taskcluster/kinds/perftest/macosx-aarch64.yml"], "git_node": "e0c0417ae6bb4477bbf7806ee62aee22fdce3218", "git_parents": ["fbb53381e93064a29a72c5a48222d00ec615ac27"], "node": "5bed8dbe386c37846c977b1b26bb5a1e20509f8e", "parents": ["01419239f143db3df6f7c8a1658b5c0dc9082b54"], "tags": []}, {"author": "MoHan Zhang \u003cmzhang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064508 - AITab: pass per-tab og:image into page generation r=rrando,gazhibekova,ai-security-reviewers,gregtatum\n\nLook up each open tab's preview image / og:image\n(PlacesUtils.history.fetch{includeMeta}.previewImageURL) via a best-effort\nAITab.#getPageImage, and surface it to the model as an \"Image:\" line in the\nsource text and as imageUrl in urlsUsed, so image-bearing components (a cards\nitem's image, a table field with role \"image\") can be populated. Never blocks\ngeneration: any lookup failure yields no image.\n\nFavicons are omitted for now (per review); they can be attached to links as a\npost-processing step later.\n\nSecurity considerations:\n\n- New data reaching the model: the only addition to the prompt is the Places-\n  cached previewImageURL for each requested tab (page-author-controlled\n  og:image URL, read locally from the Places DB; no new network requests are\n  made to look it up).\n- Access control: the image lookup is gated on\n  GetPageContent.isContentAllowed, a predicate mirroring get_page_content's\n  own allow/deny decision (http/https only; allowed when the URL is an open\n  tab or user-mentioned; denied for headless fetches of unmentioned non-SERP\n  URLs when the conversation holds both untrusted input and private data).\n  A URL whose page text is refused therefore leaks no image either \u2014 the\n  denial path is covered by test_generateAITab_omits_image_for_denied_url.\n- Hallucination/grounding: the model may only echo Image: URLs provided in\n  the prompt (never invent or construct them); evals across three models\n  measured 0 invalid image URLs with image grounding 1.0.\n- Failure behavior: the lookup is best-effort; any error yields no Image:\n  line and imageUrl null, so it cannot block or alter generation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319608\n", "files": ["browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab_generation.js"], "git_node": "dfa76c37cbcfafdbded5460a06f46afdd9a79b2d", "git_parents": ["e0c0417ae6bb4477bbf7806ee62aee22fdce3218"], "node": "7dec3c8e8abe7631696ef34387956c67692b8778", "parents": ["5bed8dbe386c37846c977b1b26bb5a1e20509f8e"], "tags": []}, {"author": "Chris DuPuis \u003ccdupuis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034669 - Give extra time after waking for compulsory restart r=aborondo,gerard-majax\n\nAdd a parameter to ScheduledTask to allow a delay between waking from sleep and executing the scheduled task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296267\n", "files": ["browser/modules/UpdatePolicyEnforcer.sys.mjs", "browser/modules/test/browser/browser_UpdatePolicyEnforcer.js", "toolkit/modules/ScheduledTask.sys.mjs", "toolkit/modules/moz.build", "toolkit/modules/tests/modules/SystemDelay.sys.mjs", "toolkit/modules/tests/xpcshell/test_ScheduledTask.js", "toolkit/modules/tests/xpcshell/xpcshell.toml"], "git_node": "4d00af4a4ffc8b9129aaf0dbf53a745ef1cd297e", "git_parents": ["dfa76c37cbcfafdbded5460a06f46afdd9a79b2d"], "node": "d44d2f1218f0de9d05e3352b9a66a96ac6f03e0a", "parents": ["7dec3c8e8abe7631696ef34387956c67692b8778"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066811 - Give the dnsNotFound search button an access key the menu bar does not use - r=mconley,fluent-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322093\n", "files": ["browser/base/content/test/about/browser_aboutCertError_accesskey.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA.js", "browser/base/content/test/about/head.js", "toolkit/locales/en-US/toolkit/neterror/netError.ftl"], "git_node": "5d8780416c2bfa2eb5745bbb68310b71a91ce2a1", "git_parents": ["4d00af4a4ffc8b9129aaf0dbf53a745ef1cd297e"], "node": "63ed2af4b1d599495c9a0bef5d5df70de3901318", "parents": ["d44d2f1218f0de9d05e3352b9a66a96ac6f03e0a"], "tags": []}, {"author": "Abel Kalu \u003c59095867+BlessedOneKobo@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2053549 - Remove unused browser.tabs.remote.enforceRemoteTypeRestrictions preference. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322765\n", "files": ["browser/app/profile/firefox.js", "modules/libpref/init/all.js"], "git_node": "7fc21e2aa965ebf561e6e12d20ea2bf2fc77ffa8", "git_parents": ["5d8780416c2bfa2eb5745bbb68310b71a91ce2a1"], "node": "16ce12687fd876ae9686f2c542fc3dc990b58963", "parents": ["63ed2af4b1d599495c9a0bef5d5df70de3901318"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2043115 - fix modifier/middle clicks on nested links without an href attribute, r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321514\n", "files": ["browser/base/content/test/linkHandling/browser.toml", "browser/base/content/test/linkHandling/browser_nested_hrefless_links.js", "toolkit/modules/BrowserUtils.sys.mjs"], "git_node": "61fae682408e60ec42ea27eec26d536f6372fce0", "git_parents": ["7fc21e2aa965ebf561e6e12d20ea2bf2fc77ffa8"], "node": "d1199edf34b3f319724d9b038a6db21382711f38", "parents": ["16ce12687fd876ae9686f2c542fc3dc990b58963"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050444 - Change sidebar width to 50x wide when vertical tabs are enabled in compact and standard UI densities to make room for scrollbar r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,dao\" for causing failures at browser_uidensity_auto_compact.js.\n\nThis reverts commit f73dc6e8e0e5f5bd0f11a28f389fcfc10356c4bd.\n", "files": ["browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "fd2317bfc9e620785543976bd2d739b495828e03", "git_parents": ["61fae682408e60ec42ea27eec26d536f6372fce0"], "node": "0bbc9ace23246805dc2d9b0b8f2fa01cf69d761a", "parents": ["d1199edf34b3f319724d9b038a6db21382711f38"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2034669 - Give extra time after waking for compulsory restart r=aborondo,gerard-majax\" for causing xpcshell crashes on test_ScheduledTask.js.\n\nThis reverts commit 4d00af4a4ffc8b9129aaf0dbf53a745ef1cd297e.\n", "files": ["browser/modules/UpdatePolicyEnforcer.sys.mjs", "browser/modules/test/browser/browser_UpdatePolicyEnforcer.js", "toolkit/modules/ScheduledTask.sys.mjs", "toolkit/modules/moz.build", "toolkit/modules/tests/modules/SystemDelay.sys.mjs", "toolkit/modules/tests