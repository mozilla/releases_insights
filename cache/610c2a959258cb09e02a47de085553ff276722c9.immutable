nents/style/Cargo.toml", "servo/components/style/color/component.rs", "servo/components/style/counter_style/mod.rs", "servo/components/style/custom_properties.rs", "servo/components/style/data.rs", "servo/components/style/dom.rs", "servo/components/style/dom_apis.rs", "servo/components/style/gecko/arc_types.rs", "servo/components/style/gecko/data.rs", "servo/components/style/gecko/snapshot_helpers.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/gecko_bindings/mod.rs", "servo/components/style/gecko_bindings/sugar/refptr.rs", "servo/components/style/gecko_string_cache/mod.rs", "servo/components/style/gecko_string_cache/namespace.rs", "servo/components/style/invalidation/element/invalidation_map.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/helpers.mako.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties_and_values/syntax/mod.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/queries/condition.rs", "servo/components/style/queries/feature_expression.rs", "servo/components/style/rule_tree/core.rs", "servo/components/style/rule_tree/unsafe_box.rs", "servo/components/style/shared_lock.rs", "servo/components/style/sharing/checks.rs", "servo/components/style/stylesheets/layer_rule.rs", "servo/components/style/stylesheets/media_rule.rs", "servo/components/style/stylesheets/mod.rs", "servo/components/style/stylesheets/scope_rule.rs", "servo/components/style/traversal.rs", "servo/components/style/typed_om/numeric_type.rs", "servo/components/style/values/computed/basic_shape.rs", "servo/components/style/values/generics/calc.rs", "servo/components/style/values/generics/grid.rs", "servo/components/style/values/generics/rect.rs", "servo/components/style/values/generics/transform.rs", "servo/components/style/values/mod.rs", "servo/components/style/values/specified/basic_shape.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/corner_shape.rs", "servo/components/style/values/specified/font.rs", "servo/components/style/values/specified/grid.rs", "servo/components/style/values/specified/image.rs", "servo/components/style/values/specified/length.rs", "servo/components/style/values/specified/mod.rs", "servo/components/style/values/tagged_numeric.rs"], "git_node": "3848c12db1ffd3889c1b69c62674fe10876523a4", "git_parents": ["9f6a98bac11a18fdc35b32689bdabc830cfa7c5c"], "node": "dde7dd5afbb08bc04e182c10d654c540e3c8d0e0", "parents": ["7ad64993bf1d73eb1c69c339fcb1f748a064b812"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066527 - Add the auto-minimize-widgets newtab page layout variant. r=fluent-reviewers,thecount,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321998\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamAdmin/DiscoveryStreamAdmin.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "30e59ac0adb1525ea9d5e2384f0f324a759d92cd", "git_parents": ["3848c12db1ffd3889c1b69c62674fe10876523a4"], "node": "dc0bad1bcfed1a47e2d3dcec51213acd8d1faa12", "parents": ["dde7dd5afbb08bc04e182c10d654c540e3c8d0e0"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066920 - Record the OS version crash annotations without the system info service, r=gsvelto.\n\nBug 2049749 reached OSVersion and LinuxLSBDescription through\n@mozilla.org/system-info;1, which loads that service during every startup, and\n@mozilla.org/windows-registry-key;1 behind it on Windows. Background tasks are\nmeant to load neither, and browser_xpcom_graph_wait.js has failed permanently\nsince. The values come from free functions nsSystemInfo itself uses, and since\nneither needs XPCOM they move to RecordPlatformAnnotations, which runs earlier.\n\nOn Android, where nsSystemInfo substitutes the SDK version for the release, Gecko\nnow leaves OSVersion to lib-crash, which sets Build.VERSION.SDK_INT when absent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321714\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "74400c2bfcf01072be7c725c758c934f3c0931ef", "git_parents": ["30e59ac0adb1525ea9d5e2384f0f324a759d92cd"], "node": "1e01fc5214f6264b66126098d7bc6ef0716af28e", "parents": ["dc0bad1bcfed1a47e2d3dcec51213acd8d1faa12"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2062149 - [riscv64] Skip prefix checks in jit-test wasm/store-zero-riscv64-ion-codegen.js. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317416\n", "files": ["js/src/jit-test/tests/wasm/store-zero-riscv64-ion-codegen.js"], "git_node": "cc70c998d85db8d0dd2de2ce5261e9c14384625e", "git_parents": ["74400c2bfcf01072be7c725c758c934f3c0931ef"], "node": "855fd49478d522599cd9404d0fb4cc5641e6e71f", "parents": ["1e01fc5214f6264b66126098d7bc6ef0716af28e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067607 - Fix opt builds.\n", "files": ["servo/ports/geckolib/glue.rs"], "git_node": "7f1af823b54b0637deb2d79483fe2b86cbdfa157", "git_parents": ["cc70c998d85db8d0dd2de2ce5261e9c14384625e"], "node": "ae0876fd10eec7f5efa6c53dc5be9b2846da1f85", "parents": ["855fd49478d522599cd9404d0fb4cc5641e6e71f"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060516 - Website address label is placed too close to the URL field in about:settings - r=desktop-theme-reviewers,mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320036\n", "files": ["browser/themes/shared/preferences/preferences.css"], "git_node": "040c16c6467a4fb2da7da12a69db4090c0416e83", "git_parents": ["7f1af823b54b0637deb2d79483fe2b86cbdfa157"], "node": "7b3ab7f0641bc46a53abecbeff4999e315a6bd40", "parents": ["ae0876fd10eec7f5efa6c53dc5be9b2846da1f85"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Make shadow-scheduler tasks clone with Git, r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322327\n", "files": ["taskcluster/kinds/source-test/shadow-scheduler.yml"], "git_node": "fadc1465e3e6c5cff6e19b309d1ac393f4d37160", "git_parents": ["040c16c6467a4fb2da7da12a69db4090c0416e83"], "node": "d717a1d36434223a21c06c34fb12cc109ed7ad71", "parents": ["7b3ab7f0641bc46a53abecbeff4999e315a6bd40"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2029729 - Remove noop passthrough security layer in MLEngine r=thasan,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292243\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_engine_security.js", "toolkit/components/ml/tests/xpcshell/test_ml_engine_security.js", "toolkit/components/ml/tests/xpcshell/xpcshell.toml"], "git_node": "137fcf330e1b78fb47380fb88f77ffb7de309353", "git_parents": ["fadc1465e3e6c5cff6e19b309d1ac393f4d37160"], "node": "266554193c883938e64fc1a06126331d77c9d916", "parents": ["d717a1d36434223a21c06c34fb12cc109ed7ad71"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2029729 - Remove the unused AI runtime security layer r=thasan,ai-platform-reviewers,perftest-reviewers,mozperftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292244\n", "files": ["python/mozperftest/perfdocs/config.yml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx.yml", "taskcluster/kinds/perftest/windows11-24h2-ref.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "testing/perfdocs/generated/mozperftest.md", "toolkit/components/ml/jar.mn", "toolkit/components/ml/moz.build", "toolkit/components/ml/security/ConditionEvaluator.sys.mjs", "toolkit/components/ml/security/DecisionTypes.sys.mjs", "toolkit/components/ml/security/PolicyEvaluator.sys.mjs", "toolkit/components/ml/security/SecurityLogger.sys.mjs", "toolkit/components/ml/security/SecurityOrchestrator.sys.mjs", "toolkit/components/ml/security/SecurityUtils.sys.mjs", "toolkit/components/ml/security/moz.build", "toolkit/components/ml/security/policies/POLICY_AUTHORING.md", "toolkit/components/ml/security/policies/tool-execution-policies.json", "toolkit/components/ml/tests/browser/browser_ml_security_perf.js", "toolkit/components/ml/tests/browser/perftest.toml", "toolkit/components/ml/tests/browser/shared-head.js", "toolkit/components/ml/tests/xpcshell/test_condition_evaluator.js", "toolkit/components/ml/tests/xpcshell/test_decision_types.js", "toolkit/components/ml/tests/xpcshell/test_json_policy_system.js", "toolkit/components/ml/tests/xpcshell/test_policy_evaluator.js", "toolkit/components/ml/tests/xpcshell/test_security_logger.js", "toolkit/components/ml/tests/xpcshell/test_security_orchestrator.js", "toolkit/components/ml/tests/xpcshell/test_security_utils.js", "toolkit/components/ml/tests/xpcshell/xpcshell.toml", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "fee6c610891ef99260be3502f60d3100ba25f137", "git_parents": ["137fcf330e1b78fb47380fb88f77ffb7de309353"], "node": "c5947b7251cde48f8ba50e6b571550a55555fdba", "parents": ["266554193c883938e64fc1a06126331d77c9d916"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2029729 - Remove the dead browser.ml.security.enabled pref from the AI Window URL security test r=thasan,Mardak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312581\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_url_security.js"], "git_node": "a455982fbb511e269c1813b276cd6cc0426583b7", "git_parents": ["fee6c610891ef99260be3502f60d3100ba25f137"], "node": "a93a27111de1fabee6bb38f80f5eabf8d6c47a16", "parents": ["c5947b7251cde48f8ba50e6b571550a55555fdba"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2067330 - [loong64] Eliminate observable intermediate states on $sp in ma_and. r=jandem\n\nThis also fixes a latent bug in the original LI+AND path, where LI loads\ninto the destination register first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322026\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "3d58d0177800a9251b396452c2d98b2fa818d850", "git_parents": ["a455982fbb511e269c1813b276cd6cc0426583b7"], "node": "d6304bcddb4cff396a23acb4e2d981d4ef6f33a4", "parents": ["a93a27111de1fabee6bb38f80f5eabf8d6c47a16"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2067472 - [loong64] Part 1: Introduce pseudo-op move as ma_move(Register, Register). r=jandem\n\nThis operation is defined in LoongArch assembly guide as a standard\npseudo-op. Introducing it can simplify various locations where there are\nchances for no-op self moves.\n\nLink:\n https://github.com/loongson/la-asm-manual/blob/e706139e69868840ad33a72526ac072cc6a81510/adoc/CHAPTER-9.Pseudo_Instruction_Set/9.Pseudo_Instruction_Set.adoc#911-move\n (\"Assembly Language Programming Guide for the LoongArch(tm)\n Architecture, CHAPTER 9. Macro Instructions, 9.1 ALU Macro Instructions,\n 9.1.1 move\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322100\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "c47b688927d058daadb381c3cc47b2590d8da5d3", "git_parents": ["3d58d0177800a9251b396452c2d98b2fa818d850"], "node": "5867d13685de91388a5fc7b444fdf88269f7ba16", "parents": ["d6304bcddb4cff396a23acb4e2d981d4ef6f33a4"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2067472 - [loong64] Part 2: Switch to ma_move in ma_addPtrTestOverflow. r=jandem\n\nThis pattern is found by LoongLint and is commonly seen in JetStream 3\nWASM code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322098\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "4d04f9fc3d1d2ee68eb461662b0c9f3deb07b22c", "git_parents": ["c47b688927d058daadb381c3cc47b2590d8da5d3"], "node": "d99ef86ffaeeaa02a95760c5c7089c65c230c489", "parents": ["5867d13685de91388a5fc7b444fdf88269f7ba16"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2067472 - [loong64] Part 3: Switch to ma_move in movePtr(Register, Register). r=jandem\n\nThis pattern is found by LoongLint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322101\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "99fce22501e63e051e218e7197f7554c037fd37b", "git_parents": ["4d04f9fc3d1d2ee68eb461662b0c9f3deb07b22c"], "node": "9dee5ff58b4c34f56fde36fc202e9d35c715a226", "parents": ["d99ef86ffaeeaa02a95760c5c7089c65c230c489"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2067472 - [loong64] Part 4: Make wasmMarkCallAsSlow explicitly assemble desired instruction. r=jandem\n\nThis is needed for Part 5, where mov(Register, Register) would become\nelidable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322145\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "6c785af2aafb31673fb64029cfe538c6bede876a", "git_parents": ["99fce22501e63e051e218e7197f7554c037fd37b"], "node": "fca1ed12de743deac59b933e9671373c186febcb", "parents": ["9dee5ff58b4c34f56fde36fc202e9d35c715a226"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2067472 - [loong64] Part 5: Use ma_move instead of as_or(..., zero) and as_ori(..., 0) in other locations. r=jandem\n\nThese are not currently observed by the linter but are nice to have.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322102\n", "files": ["js/src/jit-test/tests/wasm/binop-divrem-with-constant-loong64-ion-codegen.js", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h", "js/src/jit/loong64/Trampoline-loong64.cpp"], "git_node": "d65433076c7b96786f6c74a5ba76e4ea7465a07e", "git_parents": ["6c785af2aafb31673fb64029cfe538c6bede876a"], "node": "c6fa3138b2774248ab16e38eb97639d426c93ac0", "parents": ["fca1ed12de743deac59b933e9671373c186febcb"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2067473 - [loong64] Part 1: Optimize BaseIndex-shaped ma_{load,store} with offset==0 and scale==1. r=jandem\n\nThese loads and stores can be optimized to use scratch-free {ST,LD}X.*.\nThis pattern is commonly seen when processing byte-sized typed arrays,\nLatin-1 strings, and CacheIR DataView {get,set}Uint8.\n\nLoad before:\n\n        ld.d    $a0, $a0, 48\n        add.d   $t6, $a0, $a1\n        ld.b    $a2, $t6, 0\n        lu32i.d $a2, -491520\n\nLoad after:\n\n        ld.d    $a0, $a0, 48\n        ldx.b   $a2, $a0, $a1\n        lu32i.d $a2, -491520\n\nStore before:\n\n        ld.d    $a0, $a0, 48\n        add.d   $t6, $a0, $a2\n        st.b    $a1, $t6, 0\n        lu12i.w $a2, 0\n\nStore after:\n\n        ld.d    $a0, $a0, 48\n        stx.b   $a1, $a0, $a2\n        lu12i.w $a2, 0\n\nFound by LoongLint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322099\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "d4acb40eb9b5152e18e7af3467e0c31f02909297", "git_parents": ["d65433076c7b96786f6c74a5ba76e4ea7465a07e"], "node": "7fb21d2e05d76ef9cb04c3c8b89b1bc131ab3d40", "parents": ["c6fa3138b2774248ab16e38eb97639d426c93ac0"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2067473 - [loong64] Part 2: Use BaseIndex-variant of loads in branch8. r=jandem\n\nThis helps the current sole-caller of branch8(..., BaseIndex, ...),\nvisitStringToLowerCase() and improves symmetry with branch8(...,\nAddress, ...).\n\nIn some cases this would acquire an extra scratch register, but\ncurrently no callers exercise such path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322147\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h"], "git_node": "3065f8415d043e8917e94ac19ffdcd77a45cd712", "git_parents": ["d4acb40eb9b5152e18e7af3467e0c31f02909297"], "node": "3dd66046dd9d7d7853b3036e76df3bd434d161a2", "parents": ["7fb21d2e05d76ef9cb04c3c8b89b1bc131ab3d40"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059513 - Don't defer switcher icon init in newtab. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319456\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "20d60fa20fdb4753fdb43fc8dfbb4d8dc64052b6", "git_parents": ["3065f8415d043e8917e94ac19ffdcd77a45cd712"], "node": "e48f9c6a14a0bd9dcadcd23e0d45acd2549ff068", "parents": ["3dd66046dd9d7d7853b3036e76df3bd434d161a2"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059513 - Ignore errors when the urlbar actor is already destroyed. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322296\n", "files": ["browser/components/urlbar/actors/UrlbarChild.sys.mjs"], "git_node": "2241863da3ca10618ccd652e4e3056235add1539", "git_parents": ["20d60fa20fdb4753fdb43fc8dfbb4d8dc64052b6"], "node": "b9505fe9bbd20dc3ada64dcf7c6a7c9a034b79b3", "parents": ["e48f9c6a14a0bd9dcadcd23e0d45acd2549ff068"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067117 - Add underlays() and overlays() assertions to wrench reftests. r=gfx-reviewers,gw\n\nA reftest that compares a promoted compositor surface against the same\ncontent drawn normally renders identically whether or not promotion\nhappened, so it cannot notice the promotion going away. Expose the\nexisting COMPOSITOR_SURFACE_OVERLAYS and COMPOSITOR_SURFACE_UNDERLAYS\nprofiler counters through RenderResults and let a reftest manifest pin\nthem with underlays(N) and overlays(N), alongside color_targets(N).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321856\n", "files": ["gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/wrench/src/reftest.rs"], "git_node": "caa90956d3dd2139fa79367cc03d6798ce5842d0", "git_parents": ["2241863da3ca10618ccd652e4e3056235add1539"], "node": "c8490ffda3ea3df1fc420d69e4463a390c637f5d", "parents": ["b9505fe9bbd20dc3ada64dcf7c6a7c9a034b79b3"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067117 - Add wrench reftests for the compositor underlay path. r=gfx-reviewers,gw\n\nNone of the existing \"underlay\" reftests promote a primitive to an\nunderlay. underlay.yaml and multiple-underlays-with-mask.yaml end up\nwith an overlay, and underlay-mask-on-translucent-slice.yaml fails\npromotion and falls back to a blit. They are also platform(linux) so\nthe swgl half of the Linux run skips them.\n\nAdd nine tests with yaml references, so they run at every scale on\nevery platform, covering: underlay promotion and the tile cutout,\ncontent ordering around an underlay, the transformed case, the\nmix-blend and backdrop-filter cancel paths in post_update, and the\nUnderlayAlphaBackdrop, UnderlayIntersectsOverlay, UnderlaySurfaceLimit\nand NotPremultipliedAlpha refusals. Each pins the resulting promotion\nwith underlays()/overlays() so it cannot silently stop covering the\npath.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321857\n", "files": ["gfx/wr/wrench/reftests/compositor-surface/overlay-non-premultiplied-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/overlay-non-premultiplied.yaml", "gfx/wr/wrench/reftests/compositor-surface/reftest.list", "gfx/wr/wrench/reftests/compositor-surface/underlay-backdrop-filter-cancel-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-backdrop-filter-cancel.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-basic-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-basic.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-intersects-overlay-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-intersects-overlay.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-mix-blend-cancel-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-mix-blend-cancel.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-no-opaque-backdrop-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-no-opaque-backdrop.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-surface-limit-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-surface-limit.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-transformed-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-transformed.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-z-order-ref.yaml", "gfx/wr/wrench/reftests/compositor-surface/underlay-z-order.yaml"], "git_node": "8f1814719fba24b5db15e420bdf04f571ccb3bfc", "git_parents": ["caa90956d3dd2139fa79367cc03d6798ce5842d0"], "node": "16373864786c998c63871d2161e1fb93bd46fd13", "parents": ["c8490ffda3ea3df1fc420d69e4463a390c637f5d"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015213 - Relax a debug-only worker principal assertion for a pref-gates configuration.r=dom-worker-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321705\n", "files": ["dom/workers/loader/NetworkLoadHandler.cpp"], "git_node": "e85b3d43e10875e6582bbdea69132328a81e4072", "git_parents": ["8f1814719fba24b5db15e420bdf04f571ccb3bfc"], "node": "c23ef026e8e6e288aae4629d6352e29b7776ae6e", "parents": ["16373864786c998c63871d2161e1fb93bd46fd13"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064930 - Add firefox share icon to Referral entrypoints r=desktop-theme-reviewers,emilio,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320283\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "browser/components/preferences/config/account-sync.mjs"], "git_node": "860a2b731c9e5e9f5cc86675f1c6c8a2a4172acc", "git_parents": ["e85b3d43e10875e6582bbdea69132328a81e4072"], "node": "6f9912b679c22e60cccc4d118f605256552138ca", "parents": ["c23ef026e8e6e288aae4629d6352e29b7776ae6e"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2065913 [wpt PR 62165] - Cookies: test Path attribute encoding and segment boundary matching, a=testonly\n\nAutomatic update from web-platform-tests\nCookies: test Path attribute encoding and segment boundary matching\n\nA cookie's path is compared against the request URL's path, which is\npercent-encoded, and matches only at a path segment boundary.\n\nmatch-percent-encoded: a byte written literally in a Path attribute does not\nmatch its percent-encoded form in a URL path, and a non-ASCII byte, which makes\nthe cookie fail to parse, is not reachable at any encoding of it. A service\nworker synthesizes a document at whichever path is probed, so paths with no file\nbehind them can be observed without adding specially named files to the tree.\n\nmatch-segment-boundaries: a cookie path longer than the request path never\nmatches, including when it is the request path followed by a slash.\n\nnon-ascii-path-attribute: the non-ASCII check applies to the Path attribute that\nwins, not to every one seen, matching how the rest of a cookie is validated once\nparsing has settled, and such a cookie does not fall back to the default path.\n\nSee https://github.com/whatwg/url/issues/814.\n--\n\nwpt-commits: 825a9cb80b36a30ad9b450b06d1ecaa84c0ec2d6\nwpt-pr: 62165\n", "files": ["testing/web-platform/tests/cookies/path/match-percent-encoded.https.window.js", "testing/web-platform/tests/cookies/path/match-segment-boundaries.https.window.js", "testing/web-platform/tests/cookies/path/non-ascii-path-attribute.https.window.js", "testing/web-platform/tests/cookies/path/resources/echo.py", "testing/web-platform/tests/cookies/path/resources/probe/sw.js"], "git_node": "116d1b8f5b4b0d9eb59faac3ba95f6319a9ca916", "git_parents": ["860a2b731c9e5e9f5cc86675f1c6c8a2a4172acc"], "node": "0349566e7a9c09ff004601d9bc5369b7427d1274", "parents": ["6f9912b679c22e60cccc4d118f605256552138ca"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2065931 [wpt PR 62167] - Cookies: test that \"__Host-\" requires an explicit Path attribute, a=testonly\n\nAutomatic update from web-platform-tests\nCookies: test that \"__Host-\" requires an explicit Path attribute\n\nA \"__Host-\" prefixed cookie has to have been set with a Path attribute whose\nvalue is \"/\". Ending up with a path of \"/\" is not enough: a cookie set without a\nPath attribute from a URL whose path has a single segment gets a default path of\n\"/\" as well, and has to be rejected all the same.\n\nReaching that case needs a document whose URL has a single path segment, so that\nits default cookie path is \"/\". \"/\" itself is the only such URL that wptserve does\nnot redirect, and a document there is same-origin, so cookies can be set and read\nthrough it.\n--\n\nwpt-commits: d5399a3127b39ff9de825c14975bfb01f3809b33\nwpt-pr: 62167\n", "files": ["testing/web-platform/tests/cookies/prefix/__host.explicit-path.https.window.js"], "git_node": "c5b9c4695f9b9b971c3eff1a10c773cda0101cb2", "git_parents": ["116d1b8f5b4b0d9eb59faac3ba95f6319a9ca916"], "node": "993f8fb84709a8a25a3d2c3a8b387cdc918cf21b", "parents": ["0349566e7a9c09ff004601d9bc5369b7427d1274"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065931 [wpt PR 62167] - Update wpt metadata, a=testonly\n\nwpt-pr: 62167\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/cookies/prefix/__host.explicit-path.https.window.js.ini"], "git_node": "bd56e067eef2689d246d94e2009c0a50c3d8d130", "git_parents": ["c5b9c4695f9b9b971c3eff1a10c773cda0101cb2"], "node": "bc8597ed09ffb901202f6427254879c0a63219c0", "parents": ["993f8fb84709a8a25a3d2c3a8b387cdc918cf21b"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2066879 [wpt PR 62220] - Properly tree-scope keyframe animated property values, a=testonly\n\nAutomatic update from web-platform-tests\nProperly tree-scope keyframe animated property values\n\nThe missing EnsureScopedValue() triggered a recently added CHECK() for\nIsScopedValue() in various ApplyValue() paths.\n\nThis also revealed an existing correctness issue when animating\ntree-scoped names where we would fall back to using the Document as the\ntree-scope also when lookup should start from a shadow tree.\n\nThe StyleCascade::Resolve() function for substitutions in style rule\ncascading already had an EnsureScopedValue(), but the one used by\nanimations did not.\n\nBug: 552026567, 552689401\nChange-Id: I2826c567e94288efae6d0ff9bcadbd68a54f0e6b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8295800\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1686541}\n\n--\n\nwpt-commits: 18b98672c7713dd0ad104874a444ed0cdcae13ce\nwpt-pr: 62220\n", "files": ["testing/web-platform/tests/css/css-animations/keyframes-tree-scoped-property-with-var.html"], "git_node": "3a9cc8483cf7674f1c9c7ad12f5e2d1de775908e", "git_parents": ["bd56e067eef2689d246d94e2009c0a50c3d8d130"], "node": "10bb32d3954e1b3735ed900b51767f983f704584", "parents": ["bc8597ed09ffb901202f6427254879c0a63219c0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066879 [wpt PR 62220] - Update wpt metadata, a=testonly\n\nwpt-pr: 62220\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-animations/CSSAnimation-getKeyframes-crash.html.ini"], "git_node": "3316784eda506edc5e80fd1fecde2a241e98926c", "git_parents": ["3a9cc8483cf7674f1c9c7ad12f5e2d1de775908e"], "node": "1c2dccf44aaa11d9e910c5f8be9646165eb9865b", "parents": ["10bb32d3954e1b3735ed900b51767f983f704584"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2066886 [wpt PR 62221] - sttf: Mark the security checks wpt as long timeout., a=testonly\n\nAutomatic update from web-platform-tests\nsttf: Mark the security checks wpt as long timeout.\n\nR=bokan@chromium.org\n\nBug: 552670127\nChange-Id: I38701b54a4157a543790ef90c2def1634e7c5bda\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8298139\nReviewed-by: David Bokan \u003cbokan@chromium.org\u003e\nCommit-Queue: David Bokan \u003cbokan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1686555}\n\n--\n\nwpt-commits: 5ce815a83b2601ce920e39f001cd7e77642ea860\nwpt-pr: 62221\n", "files": ["testing/web-platform/tests/scroll-to-text-fragment/scroll-to-text-fragment-security-replacestate.sub.html"], "git_node": "61610cdbf6bd848055ebc5b7a45d4541751b9d6c", "git_parents": ["3316784eda506edc5e80fd1fecde2a241e98926c"], "node": "6f35d8b20951be961e7896c62ed6295ab047bfe0", "parents": ["1c2dccf44aaa11d9e910c5f8be9646165eb9865b"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2066909 [wpt PR 62223] - Scroll anchor-positioned fixed boxes into view on focus, a=testonly\n\nAutomatic update from web-platform-tests\nScroll anchor-positioned fixed boxes into view on focus\n\nAnchor-positioned fixed boxes still need to move with the anchor when\nthe frame scrolls. scroll-into-view stopped bubbling as soon as it hit a\nposition:fixed box, so the frame never got scrolled. This CL excludes\nanchor-positioned fixed boxes from that check.\n\nBug: 469481151\nChange-Id: I01cc730bd029b58af43857b35749d39aba42ea6f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8123394\nReviewed-by: David Bokan \u003cbokan@chromium.org\u003e\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1686828}\n\n--\n\nwpt-commits: d220e42320812cb466cf61960ed058e7ef9cc19a\nwpt-pr: 62223\n", "files": ["testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-001.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-002.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-003.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-004.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-005.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-006.html"], "git_node": "516dd561d1c302ec602460803aa95f3b81f4d9ef", "git_parents": ["61610cdbf6bd848055ebc5b7a45d4541751b9d6c"], "node": "a730fa493bc0cf394a271d7b14bc6d9a3de0eaf0", "parents": ["6f35d8b20951be961e7896c62ed6295ab047bfe0"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066854 [wpt PR 62218] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322387, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=322387 (#62218)\n--\n\nwpt-commits: e0c592d51fc40595a7c3ce92af0443a35a343338\nwpt-pr: 62218\n", "files": ["testing/web-platform/tests/service-workers/cache-storage/cache-add.https.any.js"], "git_node": "69912ba0d506cb6f79aa69823b5b9fe272d70874", "git_parents": ["516dd561d1c302ec602460803aa95f3b81f4d9ef"], "node": "d60a2eb94435a00fd6d5cd716850bb13b3b335df", "parents": ["a730fa493bc0cf394a271d7b14bc6d9a3de0eaf0"], "tags": []}, {"author": "Eriko Kurimoto \u003celkurin@chromium.org\u003e", "branch": "default", "desc": "Bug 2067057 [wpt PR 62230] - Revert \"Scroll anchor-positioned fixed boxes into view on focus\", a=testonly\n\nAutomatic update from web-platform-tests\nRevert \"Scroll anchor-positioned fixed boxes into view on focus\"\n\nThis reverts commit a960d664cc91883da1ae77f1c27196cacc51c82b.\n\nReason for revert: Culprit of\nvirtual/fragmented-oof-in-cb/external/wpt/css/css-anchor-position/scroll-to-anchored-fixed* failure\n\nFailure Link: https://ci.chromium.org/ui/p/chromium/builders/ci/Linux%20Tests/185677/overview\n\nOriginal change's description:\n\u003e Scroll anchor-positioned fixed boxes into view on focus\n\u003e\n\u003e Anchor-positioned fixed boxes still need to move with the anchor when\n\u003e the frame scrolls. scroll-into-view stopped bubbling as soon as it hit a\n\u003e position:fixed box, so the frame never got scrolled. This CL excludes\n\u003e anchor-positioned fixed boxes from that check.\n\u003e\n\u003e Bug: 469481151\n\u003e Change-Id: I01cc730bd029b58af43857b35749d39aba42ea6f\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8123394\n\u003e Reviewed-by: David Bokan \u003cbokan@chromium.org\u003e\n\u003e Commit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1686828}\n\nBug: 469481151\nNo-Presubmit: true\nNo-Tree-Checks: true\nNo-Try: true\nChange-Id: I15cd8823f5b367a4539382299f9652005e6af4fa\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8303012\nAuto-Submit: Eriko Kurimoto \u003celkurin@chromium.org\u003e\nOwners-Override: Eriko Kurimoto \u003celkurin@chromium.org\u003e\nBot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\nCommit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\nCr-Commit-Position: refs/heads/main@{#1686948}\n\n--\n\nwpt-commits: b50952863b702c333457432b3524fd600482afaf\nwpt-pr: 62230\n", "files": ["testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-001.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-002.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-003.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-004.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-005.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-006.html"], "git_node": "75756e92fb49ccca9e0c81395e80cec3123adc86", "git_parents": ["69912ba0d506cb6f79aa69823b5b9fe272d70874"], "node": "a5b795621620794d48f0fa4404eed7d72c89aa78", "parents": ["d60a2eb94435a00fd6d5cd716850bb13b3b335df"], "tags": []}, {"author": "Brandon Walderman \u003cbrwalder@microsoft.com\u003e", "branch": "default", "desc": "Bug 2066772 [wpt PR 62212] - [css-mixins] Add !important test follow-ups, a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Add !important test follow-ups\n\nFollow up on post-submit review feedback by covering !important after a\nbrace-wrapped dashed-function argument. Also make the mixin result test\nuse green for the expected behavior and red for the fallback, so\nfailures are easier to interpret.\n\nBug: 542582974\nTest: external/wpt/css/css-mixins/functions/dashed-function-parsing.html\nTest: external/wpt/css/css-mixins/mixins/important.html\nChange-Id: I1da48f90e2083747b351b08dc3a7f312620fe259\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8290708\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCommit-Queue: Brandon Walderman \u003cbrwalder@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1686959}\n\n--\n\nwpt-commits: d83d36e34217e59440e121e5edcf6b90cdd37a99\nwpt-pr: 62212\n", "files": ["testing/web-platform/tests/css/css-mixins/functions/dashed-function-parsing.html", "testing/web-platform/tests/css/css-mixins/mixins/important.html"], "git_node": "67bdbd6bd00d257b3e2d605bb975399077d1975d", "git_parents": ["75756e92fb49ccca9e0c81395e80cec3123adc86"], "node": "5775469723148c4e35f177a81b97279a2bfcd57f", "parents": ["a5b795621620794d48f0fa4404eed7d72c89aa78"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067064 [wpt PR 62231] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320657, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320657 (#62231)\n--\n\nwpt-commits: 60587976a4622493c1e2298da21577d7f233b604\nwpt-pr: 62231\n", "files": ["testing/web-platform/tests/fetch/api/cors/cors-preflight-unterminated-body.any.js", "testing/web-platform/tests/fetch/api/resources/preflight-unterminated-body.py"], "git_node": "b7b7c6e7fd83e3a1f5064cca04475f2fc14ddb19"