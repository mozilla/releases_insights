b", "git_parents": ["08925a696af69fdd00cb4ab9c6f30ee0aa378f92"], "node": "ad9bc0c64cba2772bab67a6447884d90d3931737", "parents": ["df7a994a4192319b6b283c9f5d4777ccf06727e2"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066588 - add a pref to enable ML-DSA in TLS. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321682\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "python/sites/generate-test-certs.txt", "security/manager/ssl/EnabledSignatureSchemes.h", "security/manager/ssl/metrics.yaml", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/tests/unit/head_psm.js", "security/manager/ssl/tests/unit/test_mldsa.js", "security/manager/ssl/tests/unit/test_mldsa/default-ee.key", "security/manager/ssl/tests/unit/test_mldsa/default-ee.key.keyspec", "security/manager/ssl/tests/unit/test_mldsa/default-ee.pem", "security/manager/ssl/tests/unit/test_mldsa/default-ee.pem.certspec", "security/manager/ssl/tests/unit/test_mldsa/mldsa65-ee.key", "security/manager/ssl/tests/unit/test_mldsa/mldsa65-ee.key.keyspec", "security/manager/ssl/tests/unit/test_mldsa/mldsa65-ee.pem", "security/manager/ssl/tests/unit/test_mldsa/mldsa65-ee.pem.certspec", "security/manager/ssl/tests/unit/test_mldsa/mldsa87-ee.key", "security/manager/ssl/tests/unit/test_mldsa/mldsa87-ee.key.keyspec", "security/manager/ssl/tests/unit/test_mldsa/mldsa87-ee.pem", "security/manager/ssl/tests/unit/test_mldsa/mldsa87-ee.pem.certspec", "security/manager/ssl/tests/unit/test_mldsa/test-ca.pem", "security/manager/ssl/tests/unit/test_mldsa/test-ca.pem.certspec", "security/manager/ssl/tests/unit/tlsserver/lib/TLSServer.cpp", "security/manager/ssl/tests/unit/xpcshell.toml", "security/manager/tools/mach_commands.py", "security/manager/tools/pycert.py", "security/manager/tools/pykey.py"], "git_node": "ac08d32e76da2d8696e57c701e72be6f30a696ec", "git_parents": ["65e9ee60f3c86defe7f684290b78caa6cbb75a3b"], "node": "dfaa3e04f5e3a40217c1f6209ba9802d111d3ed1", "parents": ["ad9bc0c64cba2772bab67a6447884d90d3931737"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2067326 - Write the mach log for coding agents without a tty r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322024\n", "files": ["python/mozbuild/mozbuild/base.py", "python/mozbuild/mozbuild/test/test_base.py"], "git_node": "7914279bf05d15103c9ca1f8efa4b0e61655e49c", "git_parents": ["ac08d32e76da2d8696e57c701e72be6f30a696ec"], "node": "12dfb424100f62943bac9825ea155828507b9822", "parents": ["dfaa3e04f5e3a40217c1f6209ba9802d111d3ed1"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065783 - Add openh264 variant of the WPT webcodecs and webrtc tasks. r=jgraham,media-playback-reviewers,pehrsons,taskgraph-reviewers,releng-reviewers,bhearsum,padenot\n\nopenh264 will allow us to run these tests with the actual OpenH264\nplugin, which is much closer to the release configuration than the fake\nplugins. It forces OpenH264 to be preferred by default to maximize the\ntest coverage using the plugin.\n\nTo accomplish this, it adds the OpenH264 plugin build task as a\ndependency, and adds caching for it to prevent wasting CI time on\nsomething that rarely changes.\n\nIn a follow up bug, we can remove the fake OpenH264 plugin entirely\nand always run CI with the real plugin. There may need to be additional\nannotations there, and it affects a much larger scope of tasks, so we\nwill do that separately to minimize risk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320666\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/transforms/openh264.py", "taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/kinds/openh264-plugin/kind.yml", "taskcluster/kinds/web-platform-tests/kind.yml", "taskcluster/test_configs/variants.yml", "testing/mozharness/scripts/web_platform_tests.py", "testing/web-platform/mach_commands.py", "testing/web-platform/meta/webcodecs/full-cycle-test.https.any.js.ini", "testing/web-platform/meta/webcodecs/temporal-svc-encoding.https.any.js.ini", "testing/web-platform/meta/webcodecs/video-encoder-h26x-annexb.https.any.js.ini", "testing/web-platform/meta/webcodecs/videoDecoder-codec-specific.https.any.js.ini", "testing/web-platform/meta/webcodecs/videoDecoder-h264-sei.https.any.js.ini", "testing/web-platform/meta/webcodecs/videoDecoder-interlaced-h264.https.any.js.ini", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py"], "git_node": "fe6a6bc2d32e9df4c8171784020b4a645db288ab", "git_parents": ["7914279bf05d15103c9ca1f8efa4b0e61655e49c"], "node": "1b8731854dd31b48d685f15a6eb237936bca6828", "parents": ["12dfb424100f62943bac9825ea155828507b9822"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050401 - Support heading levels on setting controls r=akulyk\n\nSome configs allow a custom heading level to be set on their element. If the heading level is applied to a setting group, it works. But if applied to a setting control, like in the sub-headings on the Tabs and Browsing settings pane noted in the bug, it doesn't render any heading and screen reader users can't rely on them to navigate the pane.\n\nThis fixes the issue so custom heading levels added to setting controls render as proper headings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321261\n", "files": ["browser/components/preferences/tests/browser_tabs_browsing_pane.js", "browser/components/preferences/tests/chrome/test_setting_control.html", "browser/components/preferences/tests/chrome/test_setting_group.html", "browser/components/preferences/widgets/setting-element/setting-element.mjs", "browser/components/preferences/widgets/setting-group/setting-group.mjs"], "git_node": "9dc99cf458d5cfa8c055f7919e411bf6fbf62fd9", "git_parents": ["fe6a6bc2d32e9df4c8171784020b4a645db288ab"], "node": "af4a3404bec6b169e7904f244e5de08aa86f4442", "parents": ["1b8731854dd31b48d685f15a6eb237936bca6828"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050401 - Standardize how heading levels are set on setting controls r=akulyk\n\nSetting controls support a top-level `headingLevel` field to have a custom heading, but several existing configs still set the heading level via `controlAttrs`. This updates those configs to use the top-level field so that only one, canonical way is used to declare a heading level.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321278\n", "files": ["browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/config/moreFromMozilla.mjs", "browser/components/preferences/config/passwords-autofill.mjs", "browser/components/preferences/config/permissions-data.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/config/search.mjs"], "git_node": "525e748306457cb8e3e32083215fc15db55e7c5d", "git_parents": ["9dc99cf458d5cfa8c055f7919e411bf6fbf62fd9"], "node": "aba4e7b6538a113bbd70c6c0807a350bc45c72a7", "parents": ["af4a3404bec6b169e7904f244e5de08aa86f4442"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062826 - Update Content Analysis SDK to 0a0e7ea516249e786d5a8884552bbd6e163d89cb r=gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317987\n", "files": ["third_party/content_analysis_sdk/CMakeLists.txt", "third_party/content_analysis_sdk/agent/src/event_win.h", "third_party/content_analysis_sdk/browser/src/client_win.cc", "third_party/content_analysis_sdk/demo/agent.cc", "third_party/content_analysis_sdk/demo/client.cc", "third_party/content_analysis_sdk/demo/handler.h", "thi