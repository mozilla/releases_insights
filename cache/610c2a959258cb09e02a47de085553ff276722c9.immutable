aa02d839bdffb92c3f22"], "node": "5b7a24ad066ee25effa51595ebb893077a29db69", "parents": ["2cdbc69c6d239e6a406bf607f8d6fc1c0bd9af6c"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2065919 - Check shutdown again before async write on read fulfill r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322987\n", "files": ["dom/streams/ReadableStreamPipeTo.cpp", "testing/web-platform/tests/streams/piping/crashtests/shutdown.html"], "git_node": "c6f59b9c6d2b798355949c2c723b4caddd937180", "git_parents": ["4ad425da60b86c09c10069c7b472e62f90323e3b"], "node": "8ed296f5cd81395a8987b2b353093b7e7d215d39", "parents": ["5b7a24ad066ee25effa51595ebb893077a29db69"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066911 - Make shallow copy of VideoFrame to prevent caller from closing ImageDecoder's copies. r=media-playback-reviewers,padenot\n\nImageDecoder::Decode returns a promise with the same pointer to\nthe VideoFrame that it stores internally. This allows the caller to\nclose it, and if there is a subsequent decode on the same frame, we\nreturn the already closed VideoFrame in the promise result. We\nshould just make a shallow copy of the VideoFrame, so that it\npoints to the same data, but the caller cannot close the internal\ncopy until they close the ImageDecoder itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323417\n", "files": ["dom/media/webcodecs/ImageDecoder.cpp", "testing/web-platform/tests/webcodecs/image-decoder.https.any.js"], "git_node": "2a9a8fe2e3575f3aca493e4a195c201286d5748d", "git_parents": ["c6f59b9c6d2b798355949c2c723b4caddd937180"], "node": "e731e06a6b141748f608b017a39b65164823c658", "parents": ["8ed296f5cd81395a8987b2b353093b7e7d215d39"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069952 - [bidi] Make destinationFolder mandatory for browser.setDownloadBehavior with type=allowed r=whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324142\n", "files": ["remote/webdriver-bidi/modules/root/browser.sys.mjs"], "git_node": "84e51c90ab284dfd2344d170bf83ee03980486b9", "git_parents": ["2a9a8fe2e3575f3aca493e4a195c201286d5748d"], "node": "f7f781ee8ce986cefca0afc91e5b2c7963126213", "parents": ["e731e06a6b141748f608b017a39b65164823c658"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069952 - [wdspec] Add test to check that destinationFolder is mandatory for browser.setDownloadBehavior with type=allowed r=whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324143\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browser/set_download_behavior/invalid.py"], "git_node": "0e102eaccce3366d144f73aeadc3ce5d42796ebf", "git_parents": ["84e51c90ab284dfd2344d170bf83ee03980486b9"], "node": "0db517a31f44c8f0d06fa24cfba818f470507201", "parents": ["f7f781ee8ce986cefca0afc91e5b2c7963126213"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067063: Record data about other profiles as part of the new-profile ping. r=niklas\" for causing marionette failures.\n\nThis reverts commit 504c4d611551757082e3d2110fe67f153894a3d6.\n", "files": ["toolkit/profile/ProfileComponents.manifest", "toolkit/profile/ProfileMetrics.sys.mjs", "toolkit/profile/metrics.yaml", "toolkit/profile/moz.build", "toolkit/profile/nsToolkitProfileService.cpp", "toolkit/profile/nsToolkitProfileService.h", "toolkit/profile/test/xpcshell/test_new_profile_ping_sent.js", "toolkit/profile/test/xpcshell/test_new_profile_ping_skipped.js", "toolkit/profile/test/xpcshell/test_profile_metrics.js", "toolkit/profile/test/xpcshell/test_profile_metrics_after_submission.js", "toolkit/profile/test/xpcshell/test_profile_metrics_excludes_current.js", "toolkit/profile/test/xpcshell/test_profile_metrics_no_compat.js", "toolkit/profile/test/xpcshell/test_profile_metrics_no_prefs.js", "toolkit/profile/test/xpcshell/test_profile_metrics_other_install.js", "toolkit/profile/test/xpcshell/test_profile_metrics_store_id_match.js", "toolkit/profile/test/xpcshell/test_profile_metrics_store_id_mismatch.js", "toolkit/profile/test/xpcshell/xpcshell.toml"], "git_node": "9fd14b2821f6f693a64474ad93f1b4802d08009c", "git_parents": ["0e102eaccce3366d144f73aeadc3ce5d42796ebf"], "node": "9a01a8def60742490db31faee19729eb9c70cb7c", "parents": ["0db517a31f44c8f0d06fa24cfba818f470507201"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069134 - Record theme-picker shown telemetry for about:welcome r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323798\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_theme_picker.js", "browser/components/asrouter/content-src/components/EmbeddedThemePicker.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/tests/unit/content-src/components/EmbeddedThemePicker.test.jsx"], "git_node": "a29639c4cdceac49510268c1d42c2c122b70a7bf", "git_parents": ["9fd14b2821f6f693a64474ad93f1b4802d08009c"], "node": "622cf0c516fa3e0e8fa6d1218ea47a10fc5a25d0", "parents": ["9a01a8def60742490db31faee19729eb9c70cb7c"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2067327 - Test that AV1 encoding uses frame color metadata r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322018\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp"], "git_node": "bf962e56678f3bd82c68e33f93ba1739b1e1e86e", "git_parents": ["a29639c4cdceac49510268c1d42c2c122b70a7bf"], "node": "1b95e4d95d5c4736ca5a222552dab0cbb4b09c0f", "parents": ["622cf0c516fa3e0e8fa6d1218ea47a10fc5a25d0"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2067327 - Test that AV1 color changes force keyframes r=media-playback-reviewers,padenot\n\nEncode known-to-known and known-to-unspecified color transitions without caller keyframe requests, then verify that each transition produces a keyframe with the new sequence-header color. Cover SVC transitions on enhancement-layer inputs as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322541\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp"], "git_node": "eb36e5f8ac93a76b57a4f0ace7063f314ebb23d5", "git_parents": ["bf962e56678f3bd82c68e33f93ba1739b1e1e86e"], "node": "690f04e456de9a8a70db1c1bb768c251ec70737c", "parents": ["1b95e4d95d5c4736ca5a222552dab0cbb4b09c0f"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2067327 - Use input-frame color metadata in FFmpegVideoEncoder r=media-playback-reviewers,padenot\n\nPrefer planar or NV input metadata over the configure-time fallback when populating each AVFrame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322542\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoEncoder.cpp"], "git_node": "708a677cbba56dbf8156827a73a3b8c7a445c78f", "git_parents": ["eb36e5f8ac93a76b57a4f0ace7063f314ebb23d5"], "node": "ba083ec8608b337affc7e220b5af26119168b113", "parents": ["690f04e456de9a8a70db1c1bb768c251ec70737c"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2067327 - Apply AVFrame color metadata in libaom r=media-playback-reviewers,padenot\n\nStore the effective lookahead depth after initialization. The first submitted frame may override configured color; later changes are ignored with lookahead because libaom color controls are global.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322019\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/libaomenc-color-metadata.patch", "media/ffvpx/libavcodec/libaomenc.c"], "git_node": "b73a4051f1a9701a44a0815a4e2a103c6c1a4eac", "git_parents": ["708a677cbba56dbf8156827a73a3b8c7a445c78f"], "node": "ef54d4968443e6b0914a3c8f61533ef8d1277b3c", "parents": ["ba083ec8608b337affc7e220b5af26119168b113"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2067327 - Force AV1 keyframes when frame color changes r=media-playback-reviewers,padenot\n\nTrack each submitted libaom frame color in Gecko and turn changes into keyframe requests before assigning SVC metadata. Enable transition tracking only after zero lookahead is successfully selected because libaom color controls are global.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322543\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoEncoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoEncoder.h"], "git_node": "67e76ca956cb4bb5cfffc2e93229d81966172e3a", "git_parents": ["b73a4051f1a9701a44a0815a4e2a103c6c1a4eac"], "node": "772dcc360af3a3f1777b9587c3ed56b9cd22e270", "parents": ["ef54d4968443e6b0914a3c8f61533ef8d1277b3c"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2067327 - Organize AV1 color metadata test data r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322020\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp"], "git_node": "38bebc992861fb8b32813ace37147abe820286cb", "git_parents": ["67e76ca956cb4bb5cfffc2e93229d81966172e3a"], "node": "cd18011d2597a26747758d6d40585425a5dd7ebb", "parents": ["772dcc360af3a3f1777b9587c3ed56b9cd22e270"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068188 - Use a string-literal wrapper type for simple payload marker field names. r=bas,profiler-reviewers,canova\n\nThis avoids the need to create the `defined_name_##arg` constants which will\nlet us add support for named arguments using string literals. It's also\nsimpler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322682\n", "files": ["tools/profiler/public/ProfilerMarkers.h"], "git_node": "91b3a385edd8291ea5af6f2a7855dcc79aecdec0", "git_parents": ["38bebc992861fb8b32813ace37147abe820286cb"], "node": "6f49542b48d8d5842f93f38eedd7bbdb8e7ea46a", "parents": ["cd18011d2597a26747758d6d40585425a5dd7ebb"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 1: Port module initialization in _schedulePerWindowIdleTasks to use category-manager invocation r=Gijs,frontend-codestyle-reviewers,mossop\n\nMove the per-window idle inits in gBrowserInit._schedulePerWindowIdleTasks to a\nnew browser-window-idle-tasks category, continuing Bug 2036714, Bug 2039199 and\nBug 2045665. The category is invoked with idleDispatch: true.\n\ncallModulesFromCategory now drops a consumer when its jsGlobal is a window that\nhas closed by the time the idle task runs. Without this, a window that closes\nbefore its idle inits run gets re-initialized after its unload teardown and\nleaks (browser_windowclose.js / browser_tabdetach.js).\n\nTeardown moves to the browser-window-unload categories, and the download init\nmoves into DownloadsCommon.initializeForWindow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310625\n", "files": ["browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/base/content/test/general/browser_gestureSupport.js", "browser/components/BrowserComponents.manifest", "browser/components/downloads/DownloadsCommon.sys.mjs", "browser/docs/BrowserStartup.md", "browser/modules/test/browser/browser_taskbar_preview.js", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/xpcshell/test_BrowserUtils.js"], "git_node": "1e0acc370f0123cd643e157da6357f998414999d", "git_parents": ["91b3a385edd8291ea5af6f2a7855dcc79aecdec0"], "node": "391e0ed5631999175ce6cd7356a94e72efdcb5a3", "parents": ["6f49542b48d8d5842f93f38eedd7bbdb8e7ea46a"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 2: Allowlist the pre-existing urlbar focus-ring startup flicker exposed by the idle-task port r=Gijs\n\nInvoking browser-window-idle-tasks with idleDispatch changes when\nbrowser-startup-idle-tasks-finished fires, so the urlbar focus-ring settle now\nsometimes lands inside the window that browser_startup_flicker.js records. The\nflicker is pre-existing and intermittent (~15% on linux debug); add a targeted\nallowlist entry matching the urlbar box, and track removal in a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321518\n", "files": ["browser/base/content/test/performance/browser_startup_flicker.js"], "git_node": "f87042a7bece048794e986e4552c316bf152540b", "git_parents": ["1e0acc370f0123cd643e157da6357f998414999d"], "node": "ce61e0af9aac3ba5f6a9b60b7a979f3bded42a9b", "parents": ["391e0ed5631999175ce6cd7356a94e72efdcb5a3"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052772 - Part 3: Expose nsIFOG.initialized and wait for it before reading Glean in marionette tests r=search-reviewers,sclements,janerik,jteow\n\ntest_ping_submitted and test_new_tab_on_restore read Glean metrics as soon as\nthe browser reports itself started up. That signal\n(browser-idle-startup-tasks-finished, which is what Marionette waits on) says\nnothing about FOG, which is initialized from a startup idle task, so the read\ncan land while Glean is still pre-init.\n\nThat is not a slow read, it is an unrecoverable hang: block_on_dispatcher posts\nits barrier to the unbounded queue while the dispatcher worker is still parked\non the pre-init channel, and the queue is only flushed by initializeFOG, which\nneeds the main thread. So a blocking Glean read from the main thread in that\nwindow deadlocks the browser, with no crash and no stack.\n\nThe race itself is pre-existing: FOG is initialized by StartupTelemetry's\nbrowser-idle-startup consumer, behind awaits on UsageReporting and\nTelemetryReportingPolicy, so it could always finish after the notification.\nPart 1 is what makes it reproduce. Porting _schedulePerWindowIdleTasks to\ncategory-manager invocation replaces window.requestIdleCallback with\nChromeUtils.idleDispatch, so the per-window tasks and the notification that\nfollows them move off the window's idle callback list and onto the\nthread-level idle queue that browser-idle-startup already uses. That changes\nwhen the notification fires relative to initializeFOG, and the tests started\nhanging instead of racing benignly.\n\nExpose whether initializeFOG has been called, and wait for it before each read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323262\n", "files": ["browser/components/search/test/marionette/telemetry/test_ping_submitted.py", "browser/components/sessionstore/test/marionette/test_new_tab_on_restore.py", "toolkit/components/glean/xpcom/FOG.cpp", "toolkit/components/glean/xpcom/nsIFOG.idl"], "git_node": "addffbbb65471ee5041cd498527c4e8707662996", "git_parents": ["f87042a7bece048794e986e4552c316bf152540b"], "node": "e2a88c74d7f9d1f5600bb9f3b51b03e586af5f88", "parents": ["ce61e0af9aac3ba5f6a9b60b7a979f3bded42a9b"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2054710 - Build the portal-file spec from an explicit length in nsDragSessionWayland. r=gtk-reviewers,emilio\n\nnsDragSessionWayland::DragDataReceived() passed the received bytes to the\nconst char* overload of NS_NewURI(), which measures the spec itself. The data\ncomes from ClipboardData::SetData(), which stores the exact number of bytes\nreceived, so the spec should carry its own length instead. Build it as an\nnsDependentCSubstring over the received span.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323432\n", "files": ["widget/gtk/nsDragServiceWayland.cpp"], "git_node": "43aafb69092959724aabc02383b13f311b38d41b", "git_parents": ["addffbbb65471ee5041cd498527c4e8707662996"], "node": "923733616621f0edcc6317f226f3932f4aa0b463", "parents": ["e2a88c74d7f9d1f5600bb9f3b51b03e586af5f88"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 1340372 - Support Video Orientation RTP header extension: signaling and receive path. r=pehrsons,media-playback-reviewers,azebrowski\n\nNegotiates the urn:3gpp:video-orientation RTP header extension in SDP\noffer/answer. On receive, extracts the CVO rotation bits from incoming\nRTP packets and propagates them through VideoSegment, ImageContainer,\nand VideoFrameContainer, which applies it as a compositor layer\ntransform via ImageContainer::SetRotation() and swaps videoWidth/\nvideoHeight (firing resize on change) so HTMLVideoElement reflects the\nsender's reported orientation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D265731\n", "files": ["dom/media/MediaDecoderOwner.h", "dom/media/VideoFrameContainer.cpp", "dom/media/VideoFrameContainer.h", "dom/media/VideoOutput.h", "dom/media/VideoSegment.cpp", "dom/media/VideoSegment.h", "dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h", "dom/media/mediaelement/HTMLVideoElement.cpp", "dom/media/mediaelement/HTMLVideoElement.h", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/tests/mochitests/test_peerConnection_basicAudioVideoVerifyExtmap.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_basicAudioVideoVerifyExtmapSendonly.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_basicVideoVerifyRtpHeaderExtensions.html", "dom/media/webrtc/transportbridge/MediaPipeline.cpp", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageContainer.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "testing/web-platform/meta/webrtc/protocol/rtp-extension-support.html.ini", "testing/web-platform/meta/webrtc/protocol/rtp-headerextensions.html.ini"], "git_node": "7a76dbbff5b8daa1a2880e29d14510f55eb2e185", "git_parents": ["43aafb69092959724aabc02383b13f311b38d41b"], "node": "d63d11626beb0a25adcfccfacaa30bd86319c355", "parents": ["923733616621f0edcc6317f226f3932f4aa0b463"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 1340372 - Add media.getusermedia.camera.fake.rotation pref for testing. r=pehrsons\n\nTest-only: the fake video capture device always reports kVideoRotation_0,\nso mochitests have no way to exercise camera-tagged rotation without real\nhardware. This pref (values: 0/90/180/270) lets the fake camera tag\nframes like a real rotated camera would, purely so the receive-path\ntests in this stack can put a real, non-zero CVO byte on the wire. It\nhas no effect when a real camera is in use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315139\n", "files": ["dom/media/VideoSegment.cpp", "dom/media/VideoSegment.h", "dom/media/systemservices/FakeVideoSource.cpp", "dom/media/systemservices/FakeVideoSource.h", "dom/media/systemservices/fake_video_capture/video_capture_fake.cc", "dom/media/systemservices/fake_video_capture/video_capture_fake.h", "dom/media/webrtc/MediaEngineFake.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "0feaa5f8516e87b09e4e51ecc1560a57a3fa3b6f", "git_parents": ["7a76dbbff5b8daa1a2880e29d14510f55eb2e185"], "node": "002c698615eeddeae03c16283d5c511abe7dc245", "parents": ["d63d11626beb0a25adcfccfacaa30bd86319c355"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 1340372 - Add a fake-camera test pattern for pixel-level rotation tests. r=pehrsons\n\nTest-only: FakeVideoSource generates a static red-background/blue-\nbottom-right-quadrant frame when media.getusermedia.camera.fake.test-pattern\nis set, read directly from the StaticPrefs atomic in GenerateImage()\n(matching how the rotation pref is already read there). The quadrant\nscales with the requested frame size rather than using a fixed-size\nmarker, avoiding an out-of-bounds write for very small requested\ndimensions. Used by the receive-path mochitest to verify actual pixel\ncontent after rotation, not just dimensions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315141\n", "files": ["dom/media/systemservices/FakeVideoSource.cpp", "dom/media/webrtc/MediaEngineFake.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "0c55693a815a160f1c9b0ee4eb88879254436041", "git_parents": ["0feaa5f8516e87b09e4e51ecc1560a57a3fa3b6f"], "node": "2a83d4371105b23876d57a76793dc2416de259d4", "parents": ["002c698615eeddeae03c16283d5c511abe7dc245"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 1340372 - Propagate rotation through VideoFrameConverter. r=pehrsons\n\nVideoChunk::mRotation was dropped at every FrameToProcess construction\nsite in VideoFrameConverter, and none of the three\nwebrtc::VideoFrame::Builder() call sites in ProcessVideoFrame set\nrotation on the outgoing frame. No real camera backend tags\nVideoChunk::mRotation today, so this has no observable effect outside\ntests, but it lets the fake camera's rotation pref\n(media.getusermedia.camera.fake.rotation) reach the receive-path tests\nin this stack as a real signal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319384\n", "files": ["dom/media/VideoFrameConverter.h", "dom/media/gtest/TestVideoFrameConverter.cpp", "media/webrtc/signaling/gtest/videoconduit_unittests.cpp"], "git_node": "f98f486214f5580970fb330a9591c32d22d54171", "git_parents": ["0c55693a815a160f1c9b0ee4eb88879254436041"], "node": "d04b1bda3679454b1f28c5312040b81de527ac7a", "parents": ["2a83d4371105b23876d57a76793dc2416de259d4"], "tags": []}, {"author": "Daniel Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 1340372 - Add an interop mochitest for Video Orientation signaling and receive. r=pehrsons,media-playback-reviewers,azebrowski\n\ntest_peerConnection_videoOrientation.html exercises the full stack end\nto end: it uses the fake-camera rotation pref and test pattern to put a\nreal, known CVO byte on the wire, sniffs the negotiated SDP and the RTP\nextension value, checks that a mid-stream rotation change is reflected\non the receiving end, and samples the rendered pixels after\ncompositing. Lands last in this stack since it depends on the\nfake-camera rotation pref, test pattern, and outbound CVO propagation\nadded by the earlier patches here.\n\nPixel checks are skipped on Android, where the captured frame isn't\ndrawn to the video surface; the SDP/RTP and dimension checks still run\nthere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321703\n", "files": ["dom/media/webrtc/tests/mochitests/mochitest_peerconnection.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_videoOrientation.html"], "git_node": "842171e9bb3f33f29e4f95c6d96058141100d70f", "git_parents": ["f98f486214f5580970fb330a9591c32d22d54171"], "node": "71e62e3d43e3445bf0f6f23130d8792665f36b26", "parents": ["d04b1bda3679454b1f28c5312040b81de527ac7a"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069901 - Handle AV1 when checking for platform decoder. r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324020\n", "files": ["dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp"], "git_node": "43509a9b31939ba58391f16809339efbf3458cc1", "git_parents": ["842171e9bb3f33f29e4f95c6d96058141100d70f"], "node": "54b3df185f6ebe5120e9b78827ce07eefe94a106", "parents": ["71e62e3d43e3445bf0f6f23130d8792665f36b26"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066526 - Delete macOS 10.15 mozperftest config. r=perftest-reviewers,mozperftest-reviewers,aglavic\n\nNow that bug 2045109 aarch64 config has been running for ~2 weeks for\nthe regression detection transition period, remove the old macosx.yml\ncompletely.\n\nNow we no longer run perftests on any 10.15 (x64) hardware\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321392\n", "files": ["python/mozperftest/mozperftest/mach_commands.py", "taskcluster/kinds/perftest/kind.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/macosx.yml"], "git_node": "c929f8f0579c8d96c5df33067e38a424b17c77f0", "git_parents": ["43509a9b31939ba58391f16809339efbf3458cc1"], "node": "e83f05c1d055394c67dc12aa3ea75bfdd8f60f17", "parents": ["54b3df185f6ebe5120e9b78827ce07eefe94a106"], "tags": []}, {"author": "Dustin Whisman \u003cwhisman.dustin@gmail.com\u003e", "branch": "default", "desc": "Bug 2053916 - Use correct HCM styles for moz-toggle r=desktop-theme-reviewers,jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318232\n", "files": ["toolkit/content/widgets/moz-toggle/moz-toggle.nova.tokens.json", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.css", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-table.mjs"], "git_node": "2190cf12b9bb4caaffe750d6935ce6d713aa7485", "git_parents": ["c929f8f0579c8d96c5df33067e38a424b17c77f0"], "node": "28f571ec794c76a48781adb5d5e2d8e017fca646", "parents": ["e83f05c1d055394c67dc12aa3ea75bfdd8f60f17"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070184 - Reset a Ctrl+Tab preview's thumbnail when its tab changes. r=tabbrowser-reviewers,niklas\n\nPutting the placeholder back also takes every cached thumbnail out of the DOM before any pending update inserts one, so a cached node can no longer be moved out of the preview that is still showing it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324306\n", "files": ["browser/components/tabbrowser/content/browser-ctrlTab.js", "browser/components/tabbrowser/test/browser/tabs/browser_ctrlTab.js"], "git_node": "3344f250390f64c4927a1eac4de962a36fc73c34", "git_parents": ["2190cf12b9bb4caaffe750d6935ce6d713aa7485"], "node": "6e2279ad3ea98d0878f5e17efae24cd497e2fce0", "parents": ["28f571ec794c76a48781adb5d5e2d8e017fca646"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070184 - Stop waiting a second for a Ctrl+Tab thumbnail that failed to load. r=tabbrowser-reviewers,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324307\n", "files": ["browser/components/tabbrowser/content/browser-ctrlTab.js"], "git_node": "aa9c1ba8f0eed347077953d28a6c9fad1024dbcc", "git_parents": ["3344f250390f64c4927a1eac4de962a36fc73c34"], "node": "0f2838ec7335a2abc9d2e1176b50408418e7f340", "parents": ["6e2279ad3ea98d0878f5e17efae24cd497e2fce0"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068188 - Use a string-literal wrapper type for simple payload marker field names. r=bas,profiler-reviewers,canova\" for causing bustage @ ProfilerMarkers.h\n\nThis reverts commit 91b3a385edd8291ea5af6f2a7855dcc79aecdec0.\n", "files": ["tools/profiler/public/ProfilerMarkers.h"], "git_node": "b2a27a17c6865925b6441d2ee4d9b04b9701e4de", "git_parents": ["aa9c1ba8f0eed347077953d28a6c9fad1024dbcc"], "node": "3237a60486a3bb53b4202a067ed05a79174d9c2f", "parents": ["0f2838ec7335a2abc9d2e1176b50408418e7f340"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge firefox-main to firefox-autoland\n", "files": [], "git_node": "6147d46d202a3f7c505b9b1f374c95575410fc3d", "git_parents": ["b2a27a17c6865925b6441d2ee4d9b04b9701e4de", "93ba10a0a6e4ef012b47d033748f4b7bc317f541"], "node": "d39c509fda94a3325ce7b7f87f8cde58f42ec951", "parents": ["3237a60486a3bb53b4202a067ed05a79174d9c2f", "e33d547cac57bda94fe398f19dff28f21782ac07"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068385: Don't support sparse arrays in SpreadMathMinMax r=spidermonkey-reviewers,jandem\n\nMarking the testcase --slow because it takes 7+ minutes on my laptop in an opt-debug build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323120\n", "files": ["js/src/jit/BaselineIC.cpp", "js/src/jit/CacheIR.cpp"], "git_node": "5515f035ba84d4cfabe88fc0aea382595bd62624", "git_parents": ["6147d46d202a3f7c505b9b1f374c95575410fc3d"], "node": "d64c1b36b0584448f1e551111e3e2ce59b4ad368", "parents": ["d39c509fda94a3325ce7b7f87f8cde58f42ec951"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068385: Fix PBL r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323744\n", "files": ["js/src/jit/CacheIRWriter.h", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "5f869a345dd90537af15f65f7d39e2a6da6c7e41", "git_parents": ["5515f035ba84d4cfabe88fc0aea382595bd62624"], "node": "e5b504cdd82c19ebc7d64dbc66bd08324de5b782", "parents": ["d64c1b36b0584448f1e551111e3e2ce59b4ad368"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2068385: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "b724e1a00aea42dd16b10eb2fb88bd4d993fdc81", "git_parents": ["5f869a345dd90537af15f65f7d39e2a6da6c7e41"], "node": "70fa5f6f60a6f925325099103da2a087466132e6", "parents": ["e5b504cdd82c19ebc7d64dbc66bd08324de5b782"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2060389 - Preventing media from playing while the user is driving the car r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321384\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/automotive/build.gradle", "mobile/android/android-components/components/feature/automotive/src/main/AndroidManifest.xml", "mobile/android/android-components/components/feature/automotive/src/main/java/mozilla/components/feature/automotive/CarUxRestrictionsFeature.kt", "mobile/android/android-components/components/feature/automotive/src/test/java/mozilla/components/feature/automotive/CarUxRestrictionsFeatureTest.kt", "mobile/android/android-components/components/feature/automotive/src/test/resources/robolectric.properties", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt"], "git_node": "942a67a1cbda2dfefa01e1417764b7d330d5b2fd", "git_parents": ["b724e1a00aea42dd16b10eb2fb88bd4d993fdc81"], "node": "a580d47864774ff9136252edf29f612feace713d", "parents": ["70fa5f6f60a6f925325099103da2a087466132e6"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067017 - restore synced tabs loading state image r=fxview-reviewers,jsudiaman\n\nThis patch ensures that all Nova redesign empty state configurations define a specific image asset to display.\n\nBug 2047224 added Nova-specific strings for Firefox View's synced tabs empty states/error states and retained a fallback image for all of those states. Bug 2058059 removed the image fallback for Nova empty states, but the loading state was still missing an image asset URL. This caused the loading state to no longer show an image, but the loading state is supposed to show an image.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323923\n", "files": ["browser/components/firefoxview/SyncedTabsController.sys.mjs", "browser/components/firefoxview/tests/browser/browser_syncedtabs_firefoxview.js"], "git_node": "a71fa9a27ba485d9568f85b0b9a793b68278c35c", "git_parents": ["942a67a1cbda2dfefa01e1417764b7d330d5b2fd"], "node": "21abec6923a34976c47e897d77e96899e54bdb0a", "parents": ["a580d47864774ff9136252edf29f612feace713d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2049056 - Don't keep loading preferences modules after the window has closed, r=mstriemer.\n\nbrowser/components/urlbar/tests/browser-quickactions/browser_commands.js opens\nabout:preferences#experimental through the \"labs\" quick action and closes the tab\nbefore it has loaded, then fails with \"leaked 1 window(s) until shutdown\n[url = about:preferences#experimental]\".\n\nmain.js loads its pane modules with the synchronous ChromeUtils.importESModule\n({ global: \"current\" }), which spins the event loop until the module graph has\nbeen fetched, so the tab can be closed part way through. Evaluation then resumes\nagainst a torn down window, and the modules imported after that point run their\nown top level code against it: they register Settings whose setup() adds pref and\nobserver service observers long after onUnload removed the ones that existed, and\ntabs-browsing.mjs throws a TypeError reaching for\nwindow.browsingContext.topChromeWindow.\n\nPreferences.addSetting has to refuse after unload as well, because no check at an\nimport site can help the module whose load was the spin: languages.mjs was\nalready in flight when the window went away, so it finishes and registers its\nsettings regardless, as does the rest of main.js.\n\nBug 2041626 stopped this spin from hanging shutdown outright; this is the\npost-unload execution that fix left behind.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321912\n", "files": ["browser/components/preferences/config/SettingPaneManager.mjs", "browser/components/preferences/main.js", "toolkit/content/preferences/Preferences.mjs", "toolkit/content/tests/chrome/test_preferencesBindings_setting_setup_teardown.html"], "git_node": "61d65f3e83e2b7696e6d6cde3451d4b4c9357935", "git_parents": ["a71fa9a27ba485d9568f85b0b9a793b68278c35c"], "node": "5c38a62de9c3d7c4727b2f5c15aeeb85616c1872", "parents": ["21abec6923a34976c47e897d77e96899e54bdb0a"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066150 - Remove legacy security telemetry probes r=freddyb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321206\n", "files": ["browser/base/content/test/about/browser_aboutNetError.js", "browser/components/metrics.yaml", "dom/security/metrics.yaml", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json", "toolkit/content/metrics.yaml"], "git_node": "ee651ae9cfd4dff2ac6e7405a5398d1ff237c332", "git_parents": ["61d65f3e83e2b7696e6d6cde3451d4b4c9357935"], "node": "79f20cc410c695a7b9a905d0be02ac3b58c77238", "parents": ["5c38a62de9c3d7c4727b2f5c15aeeb85616c1872"], "tags": []}, {"author": "kevindoughty \u003ckvndy@protonmail.com\u003e", "branch": "default", "desc": "Bug 2066417 - [animation] Opacity clamping rollback r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323334\n", "files": ["servo/components/style/values/computed/mod.rs", "servo/components/style/values/specified/mod.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/web-animations/animation-model/animation-types/clamping-001.html.ini", "testing/web-platform/meta/web-animations/animation-model/animation-types/clamping-001.tentative.html.ini", "testing/web-platform/meta/web-animations/animation-model/combining-effects/clamping-001.tentative.html.ini", "testing/web-platform/tests/web-animations/animation-model/animation-types/clamping-001.html", "testing/web-platform/tests/web-animations/animation-model/animation-types/clamping-001.tentative.html", "testing/web-platform/tests/web-animations/animation-model/combining-effects/clamping-001.html", "testing/web-platform/tests/web-animations/animation-model/combining-effects/clamping-001.tentative.html"], "git_node": "b4f027ffe395c129063106a76fe845d1555838d2", "git_parents": ["ee651ae9cfd4dff2ac6e7405a5398d1ff237c332"], "node": "28a39d138f24049dbf65e1aefda1d92f91ce186e", "parents": ["79f20cc410c695a7b9a905d0be02ac3b58c77238"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070262 - Add telemetry reviewer group to docs r=sylvestre DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324363\n", "files": ["docs/contributing/reviews.md", "mots.yaml"], "git_node": "022d762cea4d3f465358353145a8a92bbdd02b67", "git_parents": ["b4f027ffe395c129063106a76fe845d1555838d2"], "node": "4fdfc73177dcb6c1506ddac6c66f7e9fb4ba4301", "parents": ["28a39d138f24049dbf65e1aefda1d92f91ce186e"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes mobile-merino-manifest ct-logs - r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324429\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": "601ef141aae6c825dfecbb9058a58d2a9665f573", "git_parents": ["022d762cea4d3f465358353145a8a92bbdd02b67"], "node": "f65d22e13dd43e99a193fb3a633dc89fa59ddf78", "parents": ["4fdfc73177dcb6c1506ddac6c66f7e9fb4ba4301"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2062112 - [Monitor Agent][FE] Create monitor component in tool bar panel r=ngrato,fluent-reviewers,desktop-theme-reviewers,sfoster,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321407\n", "files": ["browser/base/content/browser.js", "browser/components/aiwindow/ui/assets/agent-watch-empty.svg", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/monitors-display/monitor-status-chip.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/smartwindowMonitor.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "e99e81ed0a8b8d088f80670e19ace2fb4a2779a6", "git_parents": ["601ef141aae6c825dfecbb9058a58d2a9665f573"], "node": "9182886b078063f0eec8a050373464172a8b5bc6", "parents": ["f65d22e13dd43e99a193fb3a633dc89fa59ddf78"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070000 - Another pass at mostly straight-forward style clippy lints. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324341\n", "files": ["servo/components/style/color/color_function.rs", "servo/components/style/color/convert.rs", "servo/components/style/color/parsing.rs", "servo/components/style/custom_properties.rs", "servo/components/style/data.rs", "servo/components/style/dom.rs", "servo/components/style/dom_apis.rs", "servo/components/style/gecko/arc_types.rs", "servo/components/style/gecko/selector_parser.rs", "servo/components/style/gecko/wrapper.rs", "servo/components/style/gecko_string_cache/namespace.rs", "servo/components/style/invalidation/element/element_wrapper.rs", "servo/components/style/invalidation/element/invalidation_map.rs", "servo/components/style/invalidation/element/invalidator.rs", "servo/components/style/invalidation/element/relative_selector.rs", "servo/components/style/invalidation/element/state_and_attributes.rs", "servo/components/style/invalidation/stylesheets.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/queries/condition.rs", "servo/components/style/queries/feature_expression.rs", "servo/components/style/rule_cache.rs", "servo/components/style/rule_collector.rs", "servo/components/style/selector_map.rs", "servo/components/style/sharing/mod.rs", "servo/components/style/style_adjuster.rs", "servo/components/style/stylesheets/import_rule.rs", "servo/components/style/stylesheets/rule_list.rs", "servo/components/style/stylesheets/rule_parser.rs", "servo/components/style/stylesheets/scope_rule.rs", "servo/components/style/stylesheets/stylesheet.rs", "servo/components/style/stylist.rs", "servo/components/style/thread_state.rs", "servo/components/style/traversal.rs", "servo/components/style/url/gecko.rs", "servo/components/style/values/animated/transform.rs", "servo/components/style/values/computed/font.rs", "servo/components/style/values/generics/basic_shape.rs", "servo/components/style/values/generics/calc.rs", "servo/components/style/values/generics/grid.rs", "servo/components/style/values/specified/align.rs", "servo/components/style/values/specified/animation.rs", "servo/components/style/values/specified/box.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/counters.rs", "servo/components/style/values/specified/effects.rs", "servo/components/style/values/specified/grid.rs", "servo/components/style/values/specified/image.rs", "servo/components/style/values/specified/motion.rs", "servo/components/style/values/specified/position.rs", "servo/components/style/values/specified/text.rs"], "git_node": "e908a1bd9420404c9c5ae2e7fec3e7b549acfb43", "git_parents": ["e99e81ed0a8b8d088f80670e19ace2fb4a2779a6"], "node": "b7a48bf383b8ef0757ee39ba3bfaf4e73bbc544d", "parents": ["9182886b078063f0eec8a050373464172a8b5bc6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069885 - Remove some leftover chrome-block references. r=desktop-theme-reviewers,sfoster\n\nThe clipping seems to work fine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324028\n", "files": ["browser/base/content/browser-box.inc.xhtml", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/base/content/test/maximized/browser_maximized_decoration.js", "browser/themes/shared/browser-shared.css"], "git_node": "2c2a17f17b68cbb2e8d8b60187dad4930ad3849b", "git_parents": ["e908a1bd9420404c9c5ae2e7fec3e7b549acfb43"], "node": "f121e6079f5c8dc0f490f5cc727fbc70f149c254", "parents": ["b7a48bf383b8ef0757ee39ba3bfaf4e73bbc544d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069639 - Update bindgen to 0.73.1. r=firefox-build-system-reviewers,necko-reviewers,supply-chain-reviewers,profiler-reviewers,sylvestre,canova,valentin\n\nTurns out all the 0.69 dependencies were in-tree, so change the\n0.69-to-0.72 patch to be 0.72-to-0.73.\n\nPatch shlex 1 -\u003e 2, to prevent the duplicate dependency. See incoming\ncommit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323853\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "build/rust/bindgen/Cargo.toml", "build/rust/shlex/Cargo.toml", "build/rust/shlex/lib.rs", "build/workspace-hack/Cargo.toml", "netwerk/test/http3server/Cargo.toml", "security/manager/ssl/tests/unit/test_trust_anchors/Cargo.toml", "security/manager/ssl/trust_anchors/Cargo.toml", "servo/components/style/Cargo.toml", "supply-chain/audits.toml", "supply-chain/config.toml", "third_party/rust/bindgen/.cargo-checksum.json", "third_party/rust/bindgen/.cargo_vcs_info.json", "third_party/rust/bindgen/Cargo.lock", "third_party/rust/bindgen/Cargo.toml", "third_party/rust/bindgen/Cargo.toml.orig", "third_party/rust/bindgen/README.md", "third_party/rust/bindgen/callbacks.rs", "third_party/rust/bindgen/clang.rs", "third_party/rust/bindgen/codegen/bitfield_unit.rs", "third_party/rust/bindgen/codegen/bitfield_unit_tests.rs", "third_party/rust/bindgen/codegen/dyngen.rs", "third_party/rust/bindgen/codegen/helpers.rs", "third_party/rust/bindgen/codegen/mod.rs", "third_party/rust/bindgen/features.rs", "third_party/rust/bindgen/ir/analysis/derive.rs", "third_party/rust/bindgen/ir/analysis/template_params.rs", "third_party/rust/bindgen/ir/comp.rs", "third_party/rust/bindgen/ir/context.rs", "third_party/rust/bindgen/ir/enum_ty.rs", "third_party/rust/bindgen/ir/function.rs", "third_party/rust/bindgen/ir/int.rs", "third_party/rust/bindgen/ir/item.rs", "third_party/rust/bindgen/ir/objc.rs", "third_party/rust/bindgen/ir/var.rs", "third_party/rust/bindgen/lib.rs", "third_party/rust/bindgen/options/cli.rs", "third_party/rust/bindgen/options/mod.rs", "third_party/rust/shlex/.cargo-checksum.json", "third_party/rust/shlex/.cargo_vcs_info.json", "third_party/rust/shlex/.github/workflows/test.yml", "third_party/rust/shlex/CHANGELOG.md", "third_party/rust/shlex/Cargo.lock", "third_party/rust/shlex/Cargo.toml", "third_party/rust/shlex/Cargo.toml.orig", "third_party/rust/shlex/src/bytes.rs", "third_party/rust/shlex/src/lib.rs", "third_party/rust/shlex/src/quoting_warning.md", "toolkit/crashreporter/client/app/Cargo.toml", "toolkit/crashreporter/client/cocoabind/Cargo.toml", "toolkit/crashreporter/client/gtkbind/Cargo.toml", "tools/profiler/rust-api/Cargo.toml"], "git_node": "2edefe3c2d0c0ed44fa4b238e5c51d3bf7ebef9b", "git_parents": ["2c2a17f17b68cbb2e8d8b60187dad4930ad3849b"], "node": "d136d772ca73e01d6388f458d5e70703830e0356", "parents": ["f121e6079f5c8dc0f490f5cc727fbc70f149c254"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070274 - On nova, use default-theme.svg as light/dark previews as needed. r=extension-reviewers,rpl\n\nWith the right color-scheme of course.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324371\n", "files": ["toolkit/mozapps/extensions/content/aboutaddons-utils.mjs", "toolkit/mozapps/extensions/content/components/theme-preview.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js"], "git_node": "b223c09dc3db646c00fd82388ae7e00da06a1397", "git_parents": ["2edefe3c2d0c0ed44fa4b238e5c51d3bf7ebef9b"], "node": "671f26688501054c53b9750655f4d102205de50d", "parents": ["d136d772ca73e01d6388f458d5e70703830e0356"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2019094 - Wait for the scroll marks update in browser_findbar_marks.js, r=NeilDeakin.\n\ngetMarks() sampled content.eventsCount immediately after the find was\nreported finished and asserted it had increased. FinderParent.doFind()\nnotifies onFindResult without waiting for updateHighlightAndMatchCount, and\nthe marks are only recomputed a findbar.iteratorTimeout hop after that, so\nthe read races the update. It usually wins because promiseFindFinished()\nspends five seconds waiting for a second find result that is never sent, but\nsince bug 1881627 changed how TimerThread waits on Windows, the iterator\ntimer regularly slips past even that.\n\nAlso drops the skip-if from bug 2028650: that config permafails on the same\nassertion, which is what an idle machine does to this race.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321911\n", "files": ["toolkit/content/tests/browser/browser.toml", "toolkit/content/tests/browser/browser_findbar_marks.js"], "git_node": "a3fe8b142f9faa96da13b2f537f7963c740f1321", "git_parents": ["b223c09dc3db646c00fd82388ae7e00da06a1397"], "node": "c9356b005f3799166ab10d9460642c757ce45b9c", "parents": ["671f26688501054c53b9750655f4d102205de50d"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 1 of 11: Add a test guarding against GL use outside the WebRender device layer r=gfx-reviewers,nical\n\nThe device layer in webrender/src/device/ should be the only part of the\nrenderer that depends on gleam, so that other GPU backends can be added\nbehind the Device API. This test scans the crate for gleam or gl::\nreferences outside that directory. Files that still leak are listed in an\nallowlist that fails the test if an entry becomes stale, so the list can\nonly shrink as leaks are fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324130\n", "files": ["gfx/wr/webrender/tests/gl_leaks.rs"], "git_node": "70c5c9793ccee772499db37862e68353eb0724bb", "git_parents": ["a3fe8b142f9faa96da13b2f537f7963c740f1321"], "node": "2f41738ec9c43dfd643c9dc96cb30e110f2570c2", "parents": ["c9356b005f3799166ab10d9460642c757ce45b9c"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 2 of 11: Move shader target selection from GlType into WebRender device capabilities r=gfx-reviewers,nical\n\nThe shader loader used the raw GL context type to decide which texture\nsampling targets are available and which shading language dialect to\ncompile for. Express these as device capabilities (supports_texture_rect,\nsupports_texture_external, supports_texture_external_bt709) and a\nDevice::shader_feature_flags method, computed alongside the other\ncapabilities in the device layer.\n\nThis removes the gl_type parameter from Shaders::new and\nCompositorShaders::new, and the last direct GL access in shade.rs, so it\ndrops off the gl_leaks allowlist. No behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324131\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/webrender/tests/gl_leaks.rs"], "git_node": "b53e0137c8c07964747d499744cf3afcfbbff0c2", "git_parents": ["70c5c9793ccee772499db37862e68353eb0724bb"], "node": "1b03224c8b18dca14e3af643548bccbb4b2e4e10", "parents": ["2f41738ec9c43dfd643c9dc96cb30e110f2570c2"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 3 of 11: Express readback row order as a WebRender device capability r=gfx-reviewers,nical\n\nThe async screenshot grabber inspected the GL context type to decide\nwhether frames recorded for the composition recorder arrive top row first,\nwhich is the case on ANGLE. Move that decision into the device layer as\nCapabilities::readback_rows_top_down, computed with the same expression,\nand consume it in screen_capture.rs. This removes the last direct GL access\nfrom screen_capture.rs, so it drops off the gl_leaks allowlist. No\nbehaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324132\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/screen_capture.rs", "gfx/wr/webrender/tests/gl_leaks.rs"], "git_node": "1db7a9907b6359c55e96345b751dea2ddb6735f6", "git_parents": ["b53e0137c8c07964747d499744cf3afcfbbff0c2"], "node": "8c3a8cd3015c08f6c93e2c629aeea395f95d9503", "parents": ["1b03224c8b18dca14e3af643548bccbb4b2e4e10"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 4 of 11: Route WebRender API info, OOM detection and blend barriers through Device r=gfx-reviewers,nical\n\nThe renderer reached through Device::gl for three things: the driver and\nversion strings for GraphicsApiInfo, glGetError to detect out-of-memory,\nand glBlendBarrierKHR between advanced blend batches. Add Device::api_info,\nDevice::take_out_of_memory_error and Device::blend_barrier, and move the\nGraphicsApi and GraphicsApiInfo types into the device layer, re-exported\nfrom the crate root under the same names. No behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324133\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "70eb277320f936fe9d54d5cb2c436d2495b43c61", "git_parents": ["1db7a9907b6359c55e96345b751dea2ddb6735f6"], "node": "a55ea5c8f6df39005452c97f483d6f4c0f9ca97e", "parents": ["8c3a8cd3015c08f6c93e2c629aeea395f95d9503"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 5 of 11: Construct the WebRender GPU profiler through Device r=gfx-reviewers,nical\n\nThe renderer initialisation cloned the raw GL handle out of Device to build\nthe GpuProfiler. Add Device::create_gpu_profiler, which does that clone\ninternally, and remove Device::rc_gl now that it has no other callers. No\nbehaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324134\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/init.rs"], "git_node": "fd7cecc50fd76b6a1045d0f0ece2b24d562f835b", "git_parents": ["70eb277320f936fe9d54d5cb2c436d2495b43c61"], "node": "54edcf21bba2aa613aeaf4011841cdb24121aa64", "parents": ["a55ea5c8f6df39005452c97f483d6f4c0f9ca97e"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 6 of 11: Take the last GL extension queries out of the WebRender renderer r=gfx-reviewers,nical\n\nRenderer initialisation asked the device about two GL extensions by name:\nGL_KHR_blend_equation_advanced_coherent, to decide whether advanced blend\ndraws need a barrier between them, and GL_EXT_debug_marker, to pick how the\nGPU profiler annotates the command stream.\n\nExpress the first as Capabilities::supports_advanced_blend_equation_coherent,\nnext to the existing supports_advanced_blend_equation which is computed from\nthe non-coherent extension. Move the debug method selection into\nDevice::create_gpu_profiler, which now takes the enable_gpu_markers option\nand chooses between KHR_debug, EXT_debug_marker and no markers itself.\n\nDevice::supports_extension then has no callers outside the device layer, so\nit becomes private. The gl_leaks test cannot catch queries like these, since\nthey name no GL type or module, so the renderer could have kept asking for\nextensions by name without ever tripping it. No behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324135\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/init.rs"], "git_node": "44626a5ba99ac140db01ca5fe3b963de5d713532", "git_parents": ["fd7cecc50fd76b6a1045d0f0ece2b24d562f835b"], "node": "7f5a93148bb67249cba521b151263cfe6eebf03a", "parents": ["54edcf21bba2aa613aeaf4011841cdb24121aa64"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 7 of 11: Collapse WebRender blend and depth state toggles into single Device setters r=gfx-reviewers,nical\n\nReplace Device::set_blend plus the ten set_blend_mode_* methods with one\nDevice::set_blend_mode(BlendMode), and move BlendMode into the device layer\nwith two new variants for the modes the renderer set directly: Multiply for\nclip mask intersection and ShowOverdraw for the debug overlay. The renderer\nkeeps a single wrapper that substitutes ShowOverdraw on the main framebuffer\nwhen the overdraw debug flag is set. The renderer re-exports BlendMode so\nbatch code is unchanged, and the command buffer encoder rejects the two\nrenderer-only variants.\n\nSimilarly replace enable/disable_depth, enable/disable_depth_write and\nenable/disable_color_write with set_depth_test(Option\u003cDepthFunction\u003e),\nset_depth_write(bool) and set_color_write(bool).\n\nThis is the shape a pipeline state key takes in explicit graphics APIs.\nThe GL calls issued are the same, except that glEnable(GL_BLEND) is now\nissued on each blend mode change within an alpha pass rather than once per\npass, and the overdraw debug mode now sets its blend function on opaque\npasses too instead of relying on the previously set function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324136\n", "files": ["gfx/wr/webrender/src/command_buffer.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "1929f3c0d8df49c93d36d5d2c6e4dce3363c4d4c", "git_parents": ["44626a5ba99ac140db01ca5fe3b963de5d713532"], "node": "2488ace59cde29084f5251c458a55ae226f2e4ad", "parents": ["7f5a93148bb67249cba521b151263cfe6eebf03a"], "tags": []}, {"author": "Sarah Chung \u003csachung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067380 - fix ASRouterMultistageMessage small viewport responsiveness r=omc-reviewers,yazan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322644\n", "files": ["browser/components/asrouter/content-src/components/asrouter-newtab-multistage/asrouter-newtab-multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "5187badc35607ce794c1585335cb8cbac47c8285", "git_parents": ["1929f3c0d8df49c93d36d5d2c6e4dce3363c4d4c"], "node": "f29a789f6629c5f1b810fd0e0abeb66d97e6fc0d", "parents": ["2488ace59cde29084f5251c458a55ae226f2e4ad"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069043 - Implement GeckoView API wireframe to pass typed signature to PDF.js r=geckoview-reviewers,owlish\n\nThis patch establishes the public GeckoView API for passing a typed signature to PDF.js.\n\nThe connection to PDF.js is not ready yet, so the JS has a stub for connection in bug 2069045.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323722\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PdfSignatureTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/PdfViewerController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "toolkit/components/pdfjs/content/GeckoViewPdfJsParent.sys.mjs"], "git_node": "b0e116fbab5552ff63d48e08b7caaaa5e0eeab7b", "git_parents": ["5187badc35607ce794c1585335cb8cbac47c8285"], "node": "2d4067c936a74fd4a2fd20e64f31ca61d5114c08", "parents": ["f29a789f6629c5f1b810fd0e0abeb66d97e6fc0d"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069060 - [AC/Fenix] Wire through signature API for Fenix use r=android-reviewers,mcarare\n\nPatch connects the new PDF signature API to Fenix \"Add\" button. Note, the\nGV API is still a stub, so it doesn't pass the signature to PDF.js yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323761\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt", "mobile/android/android-components/components/browser/engine-system/src/main/java/mozilla/components/browser/engine/system/SystemEngineSession.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/engine/EngineObserverTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/EngineSession.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/EngineSessionTest.kt", "mobile/android/android-components/components/support/test-fakes/src/main/java/mozilla/components/support/test/fakes/engine/TestEngineSession.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/fake/FakeEngineSession.kt"], "git_node": "6423ab05b1dc0d789711a17f71074cccf413d9d2", "git_parents": ["b0e116fbab5552ff63d48e08b7caaaa5e0eeab7b"], "node": "f91e02bab7469ee52ad067b7ebd67b57e59cc583", "parents": ["2d4067c936a74fd4a2fd20e64f31ca61d5114c08"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070036 - Don't render a filter on an SVG element with invalid dimensions in the WebRender path r=longsonr\n\nThe SVG spec disables rendering of an element whose width or height computes to\nzero. SVGIntegrationUtils::PaintFilter enforces that for the software path, but\nnsDisplayFilters::CreateWebRenderCommands never did, so WebRender rendered the\nfilter anyway. A filter that does not read its input still paints: a zero-sized\nrect with a feFlood filter fills the whole filter region.\n\nThe reftest gives the rect a transform so the filter is not swallowed by the\nblob fallback, which would hide the output for an unrelated reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324166\n", "files": ["layout/painting/nsDisplayList.cpp", "layout/reftests/svg/filters/filter-zero-size-element-01.svg", "layout/reftests/svg/filters/reftest.list"], "git_node": "f37f01098b88f17dadf5954e1abb87fc733269bd", "git_parents": ["6423ab05b1dc0d789711a17f71074cccf413d9d2"], "node": "d7b585e6d6ced00ccc6414be83e94a9a21c141bb", "parents": ["f91e02bab7469ee52ad067b7ebd67b57e59cc583"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008057 - Enable Talos (chrome, damp-inspector, damp-webconsole) on Ubuntu 24.04 r=perftest-reviewers,devtools-reviewers,taskgraph-reviewers,bhearsum,ochameau,aglavic\n\nThe window resize hang that kept these suites pinned to Ubuntu 18.04 was\ndue to a frame clock sync issue in Mutter. A fix was deployed for\nautomation in Bug 1982990.\n\nThe three tests will run on both 18.04 and 24.04 during the transition\nperiod (~2 week) so alerting does not miss regressions while the tests\ngather enough data on the newer platform.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322797\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/transforms/test/linux_perf_platform_restrictions.py", "testing/perfdocs/generated/talos.md"], "git_node": "94903f9f551b6a75ec38b1445518b73125641a5b", "git_parents": ["f37f01098b88f17dadf5954e1abb87fc733269bd"], "node": "071cf391871f932b9c408a584b4e075fe9e562a3", "parents": ["d7b585e6d6ced00ccc6414be83e94a9a21c141bb"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2057685 - Part 1: Add a ProcessCrossPaint function for obtaining full page screenshots on mobile r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318613\n", "files": ["dom/ipc/WindowGlobalParent.cpp", "gfx/ipc/CrossProcessPaint.cpp", "gfx/ipc/CrossProcessPaint.h"], "git_node": "db51560737b22f43bf602c2c129540f12d4c78fc", "git_parents": ["94903f9f551b6a75ec38b1445518b73125641a5b"], "node": "cc67c5d42f6bde2923991e7108425fcbff30513e", "parents": ["071cf391871f932b9c408a584b4e075fe9e562a3"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068160 - Part 12 - Handle clips that can't be expressed in a surface's raster space. r=gw\n\nCulling against a surface's own space asks the spatial tree for transforms into\nthat space, but the spatial tree only builds transforms towards the root:\nget_relative_transform walks from the child's coordinate system up to the\nparent's, and asserts when the parent is not on that path. That assert is not an\noversight to route around - a transform away from the root is not always\ninvertible, so there is not always an answer to give.\n\nA clip attached outside the 3D context that established a surface's raster root\nis exactly that case. Part 6 already had to guard quad::prepare_tiles, which\nasks the spatial tree the same question; these are the remaining callers, and\nthey become reachable in the next patch, where a raster root inside a 3D context\nstarts supplying its own visibility space.\n\ncan_get_relative_transform reports whether the transform exists. Handle its\nabsence at the two places that need it:\n\n - ClipSpaceConversion gets an Indeterminate variant meaning \"can't tell whether\n   this clip affects the primitive\". build_clip_chain_instance treats it as\n   needing a mask, which is always the safe answer: the projected path only ever\n   makes a culling decision, and a mask that turns out to be unnecessary costs\n   performance rather than correctness.\n - add_split_plane, where the 3D context's containing block is normally inside\n   the surface but is an ancestor by name; a failed unmap there already falls\n   back to no lateral bounds.\n\nIndeterminate fires once in the whole wrench reftest suite, on blend-clipped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322982\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/tile_cache/mod.rs"], "git_node": "9f4fd4307025eedd1db4f3818c8267bb6ecd0569", "git_parents": ["db51560737b22f43bf602c2c129540f12d4c78fc"], "node": "3301689c61d35b1d05bdadb00bd2cc9b1b0718dd", "parents": ["cc67c5d42f6bde2923991e7108425fcbff30513e"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2070131 - Add a built scene inspector to the WebRender debugger and wrshell. r=gfx-reviewers,gw\n\nAdd a \"Scene\" panel to wrshell (and a get-scene CLI command) that shows the\npicture / primitive tree of the built scene held by the render backend.\nHovering a primitive highlights it in the rendered frame. Clicking a\nprimitive shows its details in a side panel. A checkbox next to each\nprimitive disables it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324251\n", "files": ["gfx/wr/webrender/src/debugger.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/scene_debug.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/webrender_api/src/debugger.rs", "gfx/wr/wrshell/README.md", "gfx/wr/wrshell/src/debug_commands.rs", "gfx/wr/wrshell/src/gui/mod.rs", "gfx/wr/wrshell/src/gui/scene_tree.rs"], "git_node": "c556ca6c731bc792697271be938ea3b4fc2a9918", "git_parents": ["9f4fd4307025eedd1db4f3818c8267bb6ecd0569"], "node": "8d1b3a9ef01a12adf6e422391d10a3437ba1dac9", "parents": ["3301689c61d35b1d05bdadb00bd2cc9b1b0718dd"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2070131 - Add a context menu to the wrshell scene tree. r=gfx-reviewers,bradwerth\n\nRight-clicking a node offers bulk actions on the disabled set: focus on the\nnode (disable everything except the node, its ancestors and its\ndescendants), disable or enable a picture's children, and enable all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324301\n", "files": ["gfx/wr/wrshell/README.md", "gfx/wr/wrshell/src/gui/scene_tree.rs"], "git_node": "3cfc84bdeb65adfed599f45b609252bc1deae016", "git_parents": ["c556ca6c731bc792697271be938ea3b4fc2a9918"], "node": "616eab2666b3bb56a1d898bd420cb936f9f5aafc", "parents": ["8d1b3a9ef01a12adf6e422391d10a3437ba1dac9"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069500 - Fetch GitLab snapshots through the API archive endpoint in `./mach vendor` r=tjr\n\n`GitLabHost.upstream_snapshot` downloads `\u003crepo\u003e/-/archive/\u003crev\u003e.tar.gz`, which\nis a web UI route. code.videolan.org now puts a bot check in front of that\nroute and answers HTTP 200 with an HTML page titled \"Making sure you're not a\nbot!\", so re-vendoring dav1d in CI dies in tarfile:\n\n    `tarfile.ReadError: file could not be opened successfully`\n\nBy then `fetch_and_unpack` has already emptied `third_party/dav1d`, so the\nvendor verification job reports 292 deleted files as a vendoring difference\ninstead of a failed download.\n\nThe REST API is the route meant for tools and is not behind the check.\n`upstream_commit` already goes through `/api/v4/` and worked in the same run,\nso build the snapshot URL the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323772\n", "files": ["python/mozbuild/mozbuild/vendor/host_gitlab.py"], "git_node": "d3720e3997d0e5ebed8bb1f137ff8896abddbd9d", "git_parents": ["3cfc84bdeb65adfed599f45b609252bc1deae016"], "node": "4afc8e65d6e0d3932edb283682713bced8c75d4e", "parents": ["616eab2666b3bb56a1d898bd420cb936f9f5aafc"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070290 -  Keep New Tab panel-list menus on the browser theme when a wallpaper is set. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324431\n", "files": ["browser/extensions/newtab/content-src/styles/_theme.scss"], "git_node": "984bb1989afc6382502a1ab31f6d61e153b37ce6", "git_parents": ["d3720e3997d0e5ebed8bb1f137ff8896abddbd9d"], "node": "b6f962f02a5384c719c0694749843991975ffb96", "parents": ["4afc8e65d6e0d3932edb283682713bced8c75d4e"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2061470 - Don't drop __proto__ from webRequest bodies r=rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323631\n", "files": ["toolkit/components/extensions/test/mochitest/test_ext_webrequest_upload.html", "toolkit/components/extensions/webrequest/WebRequestUpload.sys.mjs"], "git_node": "d41c3c599650552a2d426c486685d7e903d53d24", "git_parents": ["984bb1989afc6382502a1ab31f6d61e153b37ce6"], "node": "5e850dbb495d8e82b30869af99d36f3e64aee6c2", "parents": ["b6f962f02a5384c719c0694749843991975ffb96"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062112 - [Monitor Agent][FE] Create monitor component in tool bar panel r=ngrato,fluent-reviewers,desktop-theme-reviewers,sfoster,bolsson\" for causing bc failures.\n\nThis reverts commit e99e81ed0a8b8d088f80670e19ace2fb4a2779a6.\n", "files": ["browser/base/content/browser.js", "browser/components/aiwindow/ui/assets/agent-watch-empty.svg", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/monitors-display/monitor-status-chip.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/smartwindowMonitor.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "75f8c72c858bc8e6c4258d723a5e42900bcc96fa", "git_parents": ["d41c3c599650552a2d426c486685d7e903d53d24"], "node": "3c06d3b359639bfd249b913fcbb87575d89c910f", "parents": ["5e850dbb495d8e82b30869af99d36f3e64aee6c2"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043034 - Add test for cross-module cont.new lifetime. r=rhunt\n\nDepends on D303859\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303860\n", "files": ["js/src/jit-test/tests/wasm/spec/stack-switching/cross-module-cont-new.js"], "git_node": "fee426f702b21bbb10e6a99f9286d83968718e2f", "git_parents": ["75f8c72c858bc8e6c4258d723a5e42900bcc96fa"], "node": "9dc0d9d070a3fcd51cdd783596c655c3e273e212", "parents": ["3c06d3b359639bfd249b913fcbb87575d89c910f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069503 - Minor private window theme tweaks. r=desktop-theme-reviewers,sfoster\n\nThe new frame background matches figma (otherwise the black semi\ntransparency is too dark).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324349\n", "files": ["browser/themes/addons/privatewindow/manifest.in.json"], "git_node": "ad017ecbcb138785b747b3266bb389fc75573a06", "git_parents": ["fee426f702b21bbb10e6a99f9286d83968718e2f"], "node": "3a7d6c730a3cd9770b0c1f00b14d2aa3af8865a0", "parents": ["9dc0d9d070a3fcd51cdd783596c655c3e273e212"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068585 - Get rid of collections.OrderedDict r=perftest-reviewers,aglavic\n\ndict is ordered since 3.6\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322950\n", "files": ["tools/browsertime/mach_commands.py"], "git_node": "2bedf73b0b4179a29e79ab9436e656431b2402d5", "git_parents": ["ad017ecbcb138785b747b3266bb389fc75573a06"], "node": "cc10275a9e428872e80c1f39110557de5287a721", "parents": ["3a7d6c730a3cd9770b0c1f00b14d2aa3af8865a0"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067190 - Refactor instance tracing with imports. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322747\n", "files": ["js/src/jit/JitFrames.cpp", "js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmFrameIter.h", "js/src/wasm/WasmStacks.cpp"], "git_node": "25e770ca942fbb62cc7ec9c03c2c314bebd143db", "git_parents": ["2bedf73b0b4179a29e79ab9436e656431b2402d5"], "node": "44cc75de7fa5ef38d281ccf18bdeaa93e0a3ece2", "parents": ["cc10275a9e428872e80c1f39110557de5287a721"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067190 - Add test. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322748\n", "files": ["js/src/jit-test/tests/wasm/tail-calls/bug2067190.js"], "git_node": "dfcb4f16b1aaa7a4da143b3d2b4a23b26081bddc", "git_parents": ["25e770ca942fbb62cc7ec9c03c2c314bebd143db"], "node": "8367204114254243f146e233cb9097e8e3b27d34", "parents": ["44cc75de7fa5ef38d281ccf18bdeaa93e0a3ece2"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005061 - WebGPU: Add transient attachment support r=webgpu-reviewers,webidl,smaug,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322755\n", "files": ["dom/webgpu/CanvasContext.cpp", "dom/webidl/WebGPU.webidl", "gfx/wgpu_bindings/src/server.rs", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/createBindGroup/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/createTexture/cts.https.html.ini"], "git_node": "00ab5f28735a60dbd16622ce16307c48b357a1f0", "git_parents": ["dfcb4f16b1aaa7a4da143b3d2b4a23b26081bddc"], "node": "ed39aea60982f688b70933b118f7d5d8ca875cdd", "parents": ["8367204114254243f146e233cb9097e8e3b27d34"], "tags": []}, {"author": "Jesse \u003cjsegunoside@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066865: Retrieve STARfox test artifacts from GHA runs, r=benchatt,taskgraph-reviewers,bhearsum\n\nThe dte-test tasks dispatched a GHA workflow run and waited for it to\nfinish, but never collected anything from it, so the only record left in\nthe Nightly release graph was the task's own exit status.\n\nFetch the run's artifacts once it completes and unpack them into\nUPLOAD_DIR, which the kind now declares as a public/dte_tests artifact\ndirectory. The download happens before the conclusion is acted on, so a\nfailing run still leaves its reports behind.\n\nDerive POLL_TIMEOUT from the task's max-run-time in the transform, so the\npoll deadline and the worker deadline stay in step and only one value has\nto change when the task is given more or less time.\n\nAlso give the GHA calls the same retrying session already used for the\nTaskcluster secret, and drop the unused TOKEN_PATTERN and the deprecated\nrequests.packages urllib3 alias.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323010\n", "files": ["taskcluster/gecko_taskgraph/transforms/dte_test.py", "taskcluster/kinds/dte-test/kind.yml", "taskcluster/scripts/tests/run_dte_github_tests.py"], "git_node": "76b7de52f62af392d76684724556d4da11c64cdc", "git_parents": ["00ab5f28735a60dbd16622ce16307c48b357a1f0"], "node": "fbadceb1c4694de9b53b6241312dc93756595119", "parents": ["ed39aea60982f688b70933b118f7d5d8ca875cdd"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1839310 - Make `nsDoTestsForAutoCompleteWithComposition.prototype._doTests` restart test if the state is not \"searching\" r=sgalich\n\n`nsAutoCompleteController::mSearchStatus` may be `STATUS_NONE`,\n`STATUS_COMPLETE_NO_MATCH` or `STATUS_COMPLETE_MATCH` while it temporarily\nstops working due to active IME composition because it's not updated with\ncomposition state change.  From point of view of the test, the important\npoint is, it's not searching and won't popup the suggest list.  Therefore,\nit's enough to check whether the state is no `STATUS_SEARCHING`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181459\n", "files": ["toolkit/content/tests/chrome/file_autocomplete_with_composition.js"], "git_node": "1a04cf3a102da68ed1436cc6b14eeb72b1c9f7a0", "git_parents": ["76b7de52f62af392d76684724556d4da11c64cdc"], "node": "e18911a248bc412f919c8f336c570fffa0c202ae", "parents": ["fbadceb1c4694de9b53b6241312dc93756595119"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066685 - Emphasize the full host in the dnsNotFound search CTA intro - r=mconley,fluent-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322085\n", "files": ["browser/base/content/test/about/browser_aboutNetError_searchCTA.js", "python/l10n/fluent_migrations/bug_2066685_emphasize_dnsnotfound_host.py", "toolkit/actors/NetErrorParent.sys.mjs", "toolkit/content/net-error-card.mjs", "toolkit/locales/en-US/toolkit/neterror/netError.ftl"], "git_node": "7a46951b246a4c691a41dcd421b679b4434f5aef", "git_parents": ["1a04cf3a102da68ed1436cc6b14eeb72b1c9f7a0"], "node": "815ffc2af64221878a9473eae7f89ce787184887", "parents": ["e18911a248bc412f919c8f336c570fffa0c202ae"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067882 - Render the dnsNotFound search CTA page only once the CTA decision is made - r=desktop-theme-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323342\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA_connectivity.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA_derivation.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA_exit.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA_frame.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA_pbm.js", "browser/base/content/test/about/browser_aboutNetError_searchCTA_telemetry.js", "browser/