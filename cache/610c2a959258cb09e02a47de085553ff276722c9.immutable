"pushes": {"45192": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 42c433afa76841f4a3c77d8801ebcd5797494f89 with FIREFOX_BETA_155_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7e5d0d4c187b26f9a3ba932896792d40f0ffff11", "git_parents": ["54ac5c8413ecbb8b24536e353475a36d3fbb4ae1"], "node": "a750c1a1b595e1fb765ac2913247ef5db4af0f70", "parents": ["5404a09f108d626eb9b05018119409e5def2ee4e"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 7df084a21949a6bdca23391498b469fec52734d9 with FIREFOX_BETA_156_BASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "1e8f5f3e6d88a576ed45e6092a28fc727455bc10", "git_parents": ["7e5d0d4c187b26f9a3ba932896792d40f0ffff11"], "node": "e989fe14618e062c2b3f7cba1c36e240e3a0cfdc", "parents": ["a750c1a1b595e1fb765ac2913247ef5db4af0f70"], "tags": []}], "date": 1787837740, "git_changesets": ["7e5d0d4c187b26f9a3ba932896792d40f0ffff11", "1e8f5f3e6d88a576ed45e6092a28fc727455bc10"], "user": "ffxbld@lando.moz.tools"}, "45193": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt", "mobile/android/version.txt"], "git_node": "2c65a53ddadb03af2e364565fac3bd692b13b5ef", "git_parents": ["64e3d949f357db531c6deb0444ace3ba134d73e0"], "node": "f1d344cff2a9b09d2b10199e9f7e289025ba6ac4", "parents": ["7df084a21949a6bdca23391498b469fec52734d9"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER", "browser/extensions/newtab/manifest.json", "browser/extensions/webcompat/manifest.json", "services/sync/modules/constants.sys.mjs"], "git_node": "4d724fd3733a857f5e263a6fc4bf6dd68c1426c0", "git_parents": ["2c65a53ddadb03af2e364565fac3bd692b13b5ef"], "node": "882c77edba4269e05ac2e8ee0dea1629a4e67da6", "parents": ["f1d344cff2a9b09d2b10199e9f7e289025ba6ac4"], "tags": []}], "date": 1787839908, "git_changesets": ["2c65a53ddadb03af2e364565fac3bd692b13b5ef", "4d724fd3733a857f5e263a6fc4bf6dd68c1426c0"], "user": "ffxbld@lando.moz.tools"}, "45194": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 7df084a21949a6bdca23391498b469fec52734d9 with FIREFOX_NIGHTLY_156_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "20323b4e6070b55375484601410b2b3e25e233b9", "git_parents": ["1e8f5f3e6d88a576ed45e6092a28fc727455bc10"], "node": "e564edb3317721155299b4b4390864d65d529a6a", "parents": ["e989fe14618e062c2b3f7cba1c36e240e3a0cfdc"], "tags": []}], "date": 1787839923, "git_changesets": ["20323b4e6070b55375484601410b2b3e25e233b9"], "user": "ffxbld@lando.moz.tools"}, "45195": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging ad0c2ee9a5fe36f519f395b69fda38027066c8bb with FIREFOX_156_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "94aecff01db2fe86a14c3d13f034de1eccab3488", "git_parents": ["20323b4e6070b55375484601410b2b3e25e233b9"], "node": "17a00e00796f22e16b8b06804e8cfc4c3ce00323", "parents": ["e564edb3317721155299b4b4390864d65d529a6a"], "tags": []}], "date": 1787853169, "git_changesets": ["94aecff01db2fe86a14c3d13f034de1eccab3488"], "user": "ffxbld@lando.moz.tools"}, "45196": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging ad0c2ee9a5fe36f519f395b69fda38027066c8bb with DEVEDITION_156_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a871da9e212cd507b1961e733d2554926f6b501d", "git_parents": ["94aecff01db2fe86a14c3d13f034de1eccab3488"], "node": "87477ce99010d635ec31dfe56d976b00e282dc76", "parents": ["17a00e00796f22e16b8b06804e8cfc4c3ce00323"], "tags": []}], "date": 1787853779, "git_changesets": ["a871da9e212cd507b1961e733d2554926f6b501d"], "user": "ffxbld@lando.moz.tools"}, "45197": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging ad0c2ee9a5fe36f519f395b69fda38027066c8bb with FIREFOX-ANDROID_156_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "77f771c88354dec2f3fa457e1b049f17fe80cec2", "git_parents": ["a871da9e212cd507b1961e733d2554926f6b501d"], "node": "4b835b3377faa97550ec6f45da2a56d6b9ae3f15", "parents": ["87477ce99010d635ec31dfe56d976b00e282dc76"], "tags": []}], "date": 1787853908, "git_changesets": ["77f771c88354dec2f3fa457e1b049f17fe80cec2"], "user": "ffxbld@lando.moz.tools"}, "45198": {"changesets": [{"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2066505 - Clamp the opacity amount when compositing a picture. r=gw\n\nCSS opacity keyframes are computed unclamped so that additive animation can\ninterpolate out-of-range values, and nothing clamps the sampled value on its way\nto WebRender. The compositing quad's base color is multiplied by the source, so\nan amount above one scales the picture past the range of the target: hardware GL\nsaturates the fragment output, while SWGL wraps around and produces noise.\n\nbrush_opacity clamped the amount in its vertex shader. The port to the quad path\ndid not carry that over.\n\nAlso give wrench's opacity() filter an optional second argument that binds the\namount to a property, since a plain value above one is discarded as a no-op\nfilter and never reaches compositing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321547\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/wrench/reftests/filters/opacity-out-of-range-ref.yaml", "gfx/wr/wrench/reftests/filters/opacity-out-of-range.yaml", "gfx/wr/wrench/reftests/filters/reftest.list", "gfx/wr/wrench/src/yaml_helper.rs"], "git_node": "13e6f29ca6d8f5453eacaba3a75ddb842f2c5321", "git_parents": ["64e3d949f357db531c6deb0444ace3ba134d73e0"], "node": "b26ce305e45d384f73aa5f3b78adeb752a9cf919", "parents": ["7df084a21949a6bdca23391498b469fec52734d9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051688 - Support spaceship operator comparators in nsTArray. r=xpcom-reviewers,sergesanspaille,webrtc-reviewers,bwc,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309689\n", "files": ["media/webrtc/signaling/gtest/peer_connection_unittest.cpp", "mfbt/BinarySearch.h", "mfbt/tests/TestBinarySearch.cpp", "xpcom/ds/nsTArray.h", "xpcom/tests/gtest/TestTArray2.cpp"], "git_node": "188f6186e6b00189ff3b971714c41db26c2518d1", "git_parents": ["13e6f29ca6d8f5453eacaba3a75ddb842f2c5321"], "node": "f45825748965b9086e01c4226511e9930a11d2f5", "parents": ["b26ce305e45d384f73aa5f3b78adeb752a9cf919"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051711 - Add operator\u003c=\u003e to nsTStringRepr. r=xpcom-reviewers,webrtc-reviewers,bwc,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309690\n", "files": ["media/webrtc/signaling/gtest/peer_connection_unittest.cpp", "xpcom/string/nsTStringRepr.h", "xpcom/tests/gtest/TestStrings.cpp"], "git_node": "1edbfdef6588b0e81b4c545031ce0bb2e104534b", "git_parents": ["188f6186e6b00189ff3b971714c41db26c2518d1"], "node": "2fc7e8b624bac1560a5ae08f063643d82c32a69e", "parents": ["f45825748965b9086e01c4226511e9930a11d2f5"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054622 - WebRTC backport: PipeWire mmap improvements r=pehrsons\n\nPipeWire: encapsulate mmap in ScopedBuf and fix mapoffset handling\nMove mmap into ScopedBuf::initialize so callers no longer manage mmap\nflags and cleanup directly. Use MAP_PRIVATE for read-only MemFd\nconsumers and MAP_SHARED for DmaBuf and read-write consumers. Fix\nscreen capture's double mapoffset application by passing the offset\nto mmap directly. Add AccessMode and BufferType enums for clarity\nand delete copy/move to prevent double-munmap.\n\nPipeWire: validate fd backing size before mmap\nValidate that the fd actually backs the requested mapping range\nby calling fstat and checking mapoffset + maxsize \u003c= st_size\nbefore mmap, matching what PipeWire does in its own memory pool\n(src/pipewire/mem.c). Skip the check for DmaBuf fds where fstat\ndoes not reliably report the buffer size.\n\nThis is a simple backport of WebRTC upstream changes.\n\nUpstream commits:\nc84dbe590a5519bc1404a268dd8816088ffe8980\n5c10f93376c1e9f0ff339bd1facf5b6d7d978f25\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321791\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/test/test_egl_dmabuf.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/test/test_screencast_stream_provider.cc", "third_party/libwebrtc/modules/portal/pipewire_utils.cc", "third_party/libwebrtc/modules/portal/pipewire_utils.h", "third_party/libwebrtc/modules/video_capture/linux/video_capture_pipewire.cc", "third_party/libwebrtc/moz-patch-stack/5c10f93376.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/c84dbe590a.no-op-cherry-pick-msg"], "git_node": "7429bd5bf2d272c50d873660c48ac4e91435717a", "git_parents": ["1edbfdef6588b0e81b4c545031ce0bb2e104534b"], "node": "abff9e232490c530fa9693f3b6792966ab8a877b", "parents": ["2fc7e8b624bac1560a5ae08f063643d82c32a69e"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065403 - Setup automatic formatting of build/clang-plugin r=ahochheiden\n\nFollowing LLVM style, as stated in build/clang-plugin/.clang-format.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320351\n", "files": [".clang-format-ignore", "build/clang-plugin/ArithmeticArgChecker.cpp", "build/clang-plugin/CanRunScriptChecker.cpp", "build/clang-plugin/CustomAttributes.cpp", "build/clang-plugin/CustomAttributesAction.h", "build/clang-plugin/CustomMatchers.h", "build/clang-plugin/CustomTypeAnnotation.h", "build/clang-plugin/DanglingOnTemporaryChecker.cpp", "build/clang-plugin/EmptyBasesChecker.cpp", "build/clang-plugin/EnumSerializerChecker.cpp", "build/clang-plugin/FopenUsageChecker.cpp", "build/clang-plugin/GlobalVariableInitializationChecker.cpp", "build/clang-plugin/GlobalVariableInitializationChecker.h", "build/clang-plugin/IntToEnumCastChecker.cpp", "build/clang-plugin/JSHandleRootedTypedefChecker.cpp", "build/clang-plugin/KungFuDeathGripChecker.cpp", "build/clang-plugin/LoadLibraryUsageChecker.cpp", "build/clang-plugin/MemMoveAnnotation.h", "build/clang-plugin/MozCheckAction.cpp", "build/clang-plugin/MozCheckAction.h", "build/clang-plugin/NaNExprChecker.cpp", "build/clang-plugin/NeedsNoVTableTypeChecker.cpp", "build/clang-plugin/NoNewThreadsChecker.cpp", "build/clang-plugin/NoPrincipalGetURI.cpp", "build/clang-plugin/NonMemMovableTemplateArgChecker.cpp", "build/clang-plugin/NonParamInsideFunctionDeclChecker.cpp", "build/clang-plugin/NonTerminatedStringChecker.cpp", "build/clang-plugin/NonTrivialTypeInFfiChecker.cpp", "build/clang-plugin/ParamTraitsEnumChecker.cpp", "build/clang-plugin/RefCountedThisInsideConstructorChecker.h", "build/clang-plugin/SprintfLiteralChecker.cpp", "build/clang-plugin/SupportsWeakPtrCycleCollectionChecker.cpp", "build/clang-plugin/SupportsWeakPtrCycleCollectionChecker.h", "build/clang-plugin/Utils.h", "build/clang-plugin/alpha/NonStdMoveChecker.h", "build/clang-plugin/alpha/TempRefPtrChecker.cpp", "build/clang-plugin/alpha/tests/TestNonStdMove.cpp", "build/clang-plugin/alpha/tests/TestTempRefPtr.cpp", "build/clang-plugin/mozsearch-plugin/BindingOperations.h", "build/clang-plugin/mozsearch-plugin/MozsearchAction.h", "build/clang-plugin/mozsearch-plugin/MozsearchIndexer.cpp"], "git_node": "738a5492cd58b8f22caadb3bfcf6471a1e1f1737", "git_parents": ["7429bd5bf2d272c50d873660c48ac4e91435717a"], "node": "377d463a4ecd2f50ce1048751ebdadd2c1cb5df1", "parents": ["abff9e232490c530fa9693f3b6792966ab8a877b"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042697 - Fix uninitialized read of FindInflectionPoints out parameters r=mstange\n\nIn FindInflectionPoints, t2 is only set if count \u003e 1, and is uninitialized otherwise.\n\nExisting code is already checking for t2 not to be used unless count \u003e\n1, except in one specific location, during initialization of t2{min,max}.\n\nAlthough this has no visible impact on the code (t2{min,max} is only\never read under count \u003e 1), this is still UB.\n\nFixing the code by initializing t2 leads to an object size increase of\n1.9 kB, so conditionally initialize t2{min,max} instead: this prevents\nthe UB while keeping the size of the generated code identical, the\noptimizer is capable of optimizing the extra check away.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302733\n", "files": ["gfx/2d/Path.cpp"], "git_node": "03e862b1174cfa81064fc347b45e96915490af28", "git_parents": ["738a5492cd58b8f22caadb3bfcf6471a1e1f1737"], "node": "83ad786fe04cdaca0fe310289fd1c845256af4c9", "parents": ["377d463a4ecd2f50ce1048751ebdadd2c1cb5df1"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2066959 - Enable -fstack-clash-protection on riscv64 Clang\u003e=22.1.8. r=glandium\n\nThis feature was made usable since a codegen bugfix got merged into\nClang's release/22.x on Jun 12, 2026 and was released with Clang 22.1.8.\nIt was also shipped with the main branch.\n\nLink: https://github.com/llvm/llvm-project/pull/195456\n (\"[CodeGen][RISCV] Inline stack probes immediately after allocateStack\n in eliminateCallFramePseudoInstr\")\nLink: https://github.com/llvm/llvm-project/pull/202882 (\"release/22.x\n v2: [CodeGen][RISCV] Inline stack probes immediately after allocateStack\n in eliminateCallFramePseudoInstr (#195456)\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321753\n", "files": ["build/moz.configure/toolchain.configure"], "git_node": "520da1af89c27f27806398283b079326681527f5", "git_parents": ["03e862b1174cfa81064fc347b45e96915490af28"], "node": "778a9874acf1c7c9544c35fc02490f21257216ab", "parents": ["83ad786fe04cdaca0fe310289fd1c845256af4c9"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2066961 - Enable -fstack-clash-protection on loongarch64 Clang\u003e=23.1.0. r=glandium\n\nThis feature was merged into Clang's main tree on May 28, 2026 and was\nreleased with Clang 23.1.0.\n\nLink: https://github.com/llvm/llvm-project/pull/195595 (\"[LoongArch] Add\n -fstack-clash-protection support\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321754\n", "files": ["build/moz.configure/toolchain.configure"], "git_node": "693963b8b2c4f191bbf5893b177d61b056ee50bf", "git_parents": ["520da1af89c27f27806398283b079326681527f5"], "node": "d03b89cb26bf3afbd2cd5e84c5d24e6121e3e31f", "parents": ["778a9874acf1c7c9544c35fc02490f21257216ab"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066364 - vendor latest a-s r=dimi\n\nThis vendors logins with the `fixup_invalid_guids` feature enabled, so that\nthese get fixed during migration. Also, provide additional api functionality\nfor non-decrypting login candidate matching. A NSS key cache should improve\nperformance esp for bulk operations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321497\n", "files": ["docs/rust-components/api/js/logins.md", "third_party/application-services/components/ads-client/src/client.rs", "third_party/application-services/components/logins/src/db.rs", "third_party/application-services/components/logins/src/login.rs", "third_party/application-services/components/logins/src/logins.udl", "third_party/application-services/components/logins/src/store.rs", "third_party/application-services/components/nimbus/src/nimbus.udl", "third_party/application-services/components/nimbus/src/schema.rs", "third_party/application-services/components/nimbus/src/stateful/nimbus_client.rs", "third_party/application-services/components/nimbus/src/tests/stateful/test_persistence.rs", "third_party/application-services/components/support/nimbus-cli/src/cli.rs", "third_party/application-services/components/support/nimbus-cli/src/cmd.rs", "third_party/application-services/components/support/nimbus-cli/src/main.rs", "third_party/application-services/moz.yaml", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/nimbus/android/src/main/java/org/mozilla/experiments/nimbus/internal/nimbus.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "e14a25b77468395012b0c8bb8e1a928764a6a247", "git_parents": ["693963b8b2c4f191bbf5893b177d61b056ee50bf"], "node": "99c427dabcd7c6738a3a4bd257d2b4a32593d646", "parents": ["d03b89cb26bf3afbd2cd5e84c5d24e6121e3e31f"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066464 - Stop recording the main thread id r=jld\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321265\n", "files": ["toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "e8c3c44451c824856f271a2c6dae12cc07e29586", "git_parents": ["e14a25b77468395012b0c8bb8e1a928764a6a247"], "node": "33a206b73a7fff78c4530a4d7a67ad80d5f7d4e0", "parents": ["99c427dabcd7c6738a3a4bd257d2b4a32593d646"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066464 - Remove the thread id hack when initializing the crash reporter on macOS r=jld,necko-reviewers,ipc-reviewers,media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321266\n", "files": ["dom/ipc/NativeThreadId.h", "dom/ipc/PContent.ipdl", "dom/media/gmp/PGMP.ipdl", "dom/media/ipc/PRDD.ipdl", "gfx/ipc/PGPU.ipdl", "gfx/vr/ipc/PVR.ipdl", "ipc/glue/CrashReporterClient.cpp", "ipc/glue/CrashReporterHost.cpp", "ipc/glue/CrashReporterHost.h", "ipc/glue/PUtilityProcess.ipdl", "netwerk/ipc/PSocketProcess.ipdl", "toolkit/crashreporter/ipc/CrashReporterInitArgs.ipdlh", "toolkit/crashreporter/nsExceptionHandler.cpp"], "git_node": "881de96cacc2b62292f9ae957bde2075de15cba3", "git_parents": ["e8c3c44451c824856f271a2c6dae12cc07e29586"], "node": "98613e72d3b63835cd8cfce271d117c08213b91c", "parents": ["33a206b73a7fff78c4530a4d7a67ad80d5f7d4e0"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2033233 - Fix currentTranslate for inner svg elements r=dholbert,firefox-svg-reviewers\n\nSee https://github.com/w3c/svgwg/issues/1094\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295155\n", "files": ["dom/svg/DOMSVGPoint.cpp", "dom/svg/SVGSVGElement.cpp", "testing/web-platform/tests/svg/struct/scripted/SVGSVGElement-currentTranslate.html"], "git_node": "64af41fbca427762530ec450c1298d06590767f7", "git_parents": ["881de96cacc2b62292f9ae957bde2075de15cba3"], "node": "ea33f1d7b318d8233bed74df7e7ebf28864dc86f", "parents": ["98613e72d3b63835cd8cfce271d117c08213b91c"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2066982 - Remove unused GLBlitHelper::BlitImageToFramebuffer() r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321770\n", "files": ["gfx/gl/GLBlitHelper.cpp", "gfx/gl/GLBlitHelper.h", "gfx/gl/GLBlitHelperD3D.cpp", "gfx/layers/GLImages.cpp"], "git_node": "27acd175dc69507912bf7d969c7c3cd47afeeca6", "git_parents": ["64af41fbca427762530ec450c1298d06590767f7"], "node": "2b6ed302e57d8442dff1dd365d63caec3c426ed8", "parents": ["ea33f1d7b318d8233bed74df7e7ebf28864dc86f"], "tags": []}, {"author": "nhadji \u003cnhadji@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Make buildconfig tasks clone with Git, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319722\n", "files": ["taskcluster/kinds/source-test/buildconfig.yml"], "git_node": "fdb6b2e70526680fabf9fa1f424f505f44be7e0d", "git_parents": ["27acd175dc69507912bf7d969c7c3cd47afeeca6"], "node": "f60960f4fc2f753d2d17d7977e316854d0b348ab", "parents": ["2b6ed302e57d8442dff1dd365d63caec3c426ed8"], "tags": []}, {"author": "Gopalarathnam Venkatesan \u003cgopal@g13n.net\u003e", "branch": "default", "desc": "Bug 2042433 - fixes clippy warnings in netwerk/base/uritemplate_glue/src/lib.rs r=sylvestre,necko-reviewers,valentin,leggert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319870\n", "files": ["netwerk/base/uritemplate_glue/src/lib.rs"], "git_node": "0ab893f8494e14eb4366547e0fede2e947277ce0", "git_parents": ["fdb6b2e70526680fabf9fa1f424f505f44be7e0d"], "node": "70738e70b6ee52fe1a5bf1898340026620054d35", "parents": ["f60960f4fc2f753d2d17d7977e316854d0b348ab"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063823 - define MOZ_WINCONSOLE per directory when WINCONSOLE is set in moz.build r=ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320378\n", "files": ["python/mozbuild/mozbuild/frontend/emitter.py"], "git_node": "bc4f49de4ff01350c76f96566f92aaac0431fcf4", "git_parents": ["0ab893f8494e14eb4366547e0fede2e947277ce0"], "node": "fcd41da62e2c9bbae5bcc960f269f2cf38c2edd6", "parents": ["70738e70b6ee52fe1a5bf1898340026620054d35"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063823 - Obsolete MOZ_WINCONSOLE configure option r=ahochheiden\n\nIt's unused at taskcluster level and we already have per-directory\nconfiguration capability through WINCONSOLE.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320379\n", "files": ["toolkit/moz.configure"], "git_node": "9daeb74b2dc3b9879561e344d6069b6c4eeb9873", "git_parents": ["bc4f49de4ff01350c76f96566f92aaac0431fcf4"], "node": "7401fca914b80a16e4221ed8d6b51901c500cb21", "parents": ["fcd41da62e2c9bbae5bcc960f269f2cf38c2edd6"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1619966 - Collapse the macOS universal build into an artifact build on try. r=taskgraph-reviewers,bhearsum\n\n`mach try --artifact` can't produce a working macOS shippable build:\n\n- macosx64-x64-shippable/opt is never turned into an artifact build, because\n  its index job-name (macosx64-x64-opt) isn't one of mozbuild's JOB_CHOICES,\n  so it keeps doing a full build.\n- macosx64-shippable/opt hardcodes fetches for artifacts that artifact builds\n  don't produce (the gtest tarball, the langpack, the generated sources and\n  the mar tools), so it goes busted as soon as the aarch64 half becomes an\n  artifact build.\n\nThere is nothing to unify in artifact build mode: the universal build is\nalready indexed as macosx64-opt, and downloading it is exactly what a local\nmacOS artifact build does. Take over the x64 build's configuration for the\nuniversal task, and let the two per-architecture builds fall out of the graph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321473\n", "files": ["taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_transforms_build.py", "taskcluster/gecko_taskgraph/transforms/build.py"], "git_node": "58a9af8b9ad5a0a15208d9d8b1fc3424933e23e7", "git_parents": ["9daeb74b2dc3b9879561e344d6069b6c4eeb9873"], "node": "b54e3a4a94912c1c0aaf7d45a727b5d2982d0396", "parents": ["7401fca914b80a16e4221ed8d6b51901c500cb21"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2051466 - NTLM should always prompt for credentials if the host is not in trusted-uris r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321209\n", "files": ["netwerk/protocol/http/nsHttpChannelAuthProvider.cpp"], "git_node": "32e317d019d454ffce0639e85ca0f9264fcbac0d", "git_parents": ["58a9af8b9ad5a0a15208d9d8b1fc3424933e23e7"], "node": "fa62c6dc4436c038f786ff65747d55ae66cbdd14", "parents": ["b54e3a4a94912c1c0aaf7d45a727b5d2982d0396"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063282 - Let the color and date pickers follow the input's color scheme. r=emilio,desktop-theme-reviewers\n\nThis supersedes #DateTimePickerPanel's content-preferred-color-scheme rule, which resolved a global preference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321676\n", "files": ["browser/base/content/test/forms/browser_picker_blocked_background_tab.js", "browser/themes/shared/tabbrowser/content-area.css", "toolkit/actors/InputPickerChildCommon.sys.mjs", "toolkit/actors/InputPickerParentCommon.sys.mjs", "toolkit/content/tests/browser/browser.toml", "toolkit/content/tests/browser/browser_input_picker_color_scheme.js", "toolkit/content/tests/browser/datetime/head.js", "toolkit/modules/InputPickerPanelCommon.sys.mjs"], "git_node": "c658aafc0c25bb386fed45a06edc1e4e11b7b964", "git_parents": ["32e317d019d454ffce0639e85ca0f9264fcbac0d"], "node": "9c534404a9674344f4ecbbb3d3c78b4ba415a3e7", "parents": ["fa62c6dc4436c038f786ff65747d55ae66cbdd14"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066893 - Let the form autocomplete popup follow the input's color scheme. r=emilio,credential-management-reviewers,desktop-theme-reviewers,mtigley\n\nThe chrome-input path clears both inline properties, so the shared popup stops carrying a content field's scheme and direction into the save-password doorhanger. That and the per-element scheme together supersede #PopupAutoComplete's content-preferred-color-scheme rule.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321690\n", "files": ["browser/themes/shared/tabbrowser/content-area.css", "toolkit/actors/AutoCompleteChild.sys.mjs", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_doorhanger_autocomplete_color_scheme.js", "toolkit/components/satchel/test/browser/browser.toml", "toolkit/components/satchel/test/browser/browser_autocomplete_color_scheme.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "54c7c9f2760d45b9aef57d4158ed78f4eddacfe7", "git_parents": ["c658aafc0c25bb386fed45a06edc1e4e11b7b964"], "node": "ae2e6bcdcd397678ca2ec63610e07a5134faf95e", "parents": ["9c534404a9674344f4ecbbb3d3c78b4ba415a3e7"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062038 - Flag prefs where true means less protection in privacy matrix r=timhuang\n\nConsent Manager Skipping and Skip Anti-fraud Resources both have true\nmean \"skip blocking\", the inverse of every other row, so a reader\nscanning for \"more true = safer\" draws the opposite conclusion. Add an\ninline note on these two rows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320850\n", "files": ["docs/_addons/etp_matrix.py"], "git_node": "f8d4272ab6ec1ab70947605ee14991d39fdaebc1", "git_parents": ["54c7c9f2760d45b9aef57d4158ed78f4eddacfe7"], "node": "a5a0190e547efd80e7d15f50c154e1b05986dbdb", "parents": ["ae2e6bcdcd397678ca2ec63610e07a5134faf95e"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065074 - Update asset and align spacing with the specifications r=android-reviewers,pollymce\n\nUpdate the asset to match the latest design. Also adjust the vertical spacing between items to align with the Figma specifications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320123\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/startupCrash/StartupCrashScreen.kt", "mobile/android/fenix/app/src/main/res/drawable/fox_alert_crash_dark.xml", "mobile/android/fenix/app/src/main/res/drawable/fox_alert_crash_light.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_kit_plug_error.xml"], "git_node": "374633ca5fa9a3be09b0ccaff03b3647868f7006", "git_parents": ["f8d4272ab6ec1ab70947605ee14991d39fdaebc1"], "node": "d0ebc9a342c94b46dacebd3972a145d46aaae012", "parents": ["a5a0190e547efd80e7d15f50c154e1b05986dbdb"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063421 - Fix firefox-devtools .mcp.json definition for windows r=ai4dev-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321805\n", "files": [".mcp.json", "docs/ai-agent-tools/firefox-devtools-mcp.md"], "git_node": "5db39475c8d176647158330a572cd66b92059e8e", "git_parents": ["374633ca5fa9a3be09b0ccaff03b3647868f7006"], "node": "9288f01e5207f4098661ef740a113afa62137687", "parents": ["d0ebc9a342c94b46dacebd3972a145d46aaae012"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065074 - Update asset and align spacing with the specifications r=android-reviewers,pollymce\" for causing fenix failures\n\nThis reverts commit 374633ca5fa9a3be09b0ccaff03b3647868f7006.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/startupCrash/StartupCrashScreen.kt", "mobile/android/fenix/app/src/main/res/drawable/fox_alert_crash_dark.xml", "mobile/android/fenix/app/src/main/res/drawable/fox_alert_crash_light.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_kit_plug_error.xml"], "git_node": "50027650d0394949aa0c05c6b6fb0e2deffc0e63", "git_parents": ["5db39475c8d176647158330a572cd66b92059e8e"], "node": "83d126f009ac764e14519c4d21dc3903e63b330e", "parents": ["9288f01e5207f4098661ef740a113afa62137687"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1958060 - Widen SmartBlock Twitter/X embed shim to cover the widget iframe and direct server-side tweet embeds, and fix shim injection for sub_frame requests. r=webcompat-reviewers,timhuang,twisniewski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319423\n", "files": ["browser/extensions/webcompat/data/shims.js", "browser/extensions/webcompat/lib/shims.js", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/shims/empty-page.html", "browser/extensions/webcompat/shims/twitter-embed.js", "browser/extensions/webcompat/tests/browser/browser.toml", "browser/extensions/webcompat/tests/browser/browser_smartblockembeds_iframe.js", "browser/extensions/webcompat/tests/browser/embed_test_iframe.html", "browser/extensions/webcompat/tests/browser/head.js", "browser/extensions/webcompat/tests/browser/smartblock_embed_iframe_test.html"], "git_node": "0f5877a056486f38adb40f0a207aaba13d8a14be", "git_parents": ["50027650d0394949aa0c05c6b6fb0e2deffc0e63"], "node": "8887a16103701740c05c72876586e57a95cc56bd", "parents": ["83d126f009ac764e14519c4d21dc3903e63b330e"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064181 - [IPProtection] Announce the VPN menu item as a switch r=android-reviewers,twhite\n\nMoving the VPN menu row to Modifier.debouncedClickable dropped the accessibility role, so the control was no longer announced as a switch. debouncedClickable now takes an optional role and forwards it to the underlying Modifier.clickable.\n\nIPProtectionToggle passes:\n- Role.Button if the state is AuthRequired (navigation event)\n- Role.Switch otherwise (VPN state change)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320975\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/modifier/Modifier.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt"], "git_node": "bb5ada418102536a69be3a5d704560f45f0562df", "git_parents": ["0f5877a056486f38adb40f0a207aaba13d8a14be"], "node": "a8299bc74987161814e3a23e3f4fe902ab7f320c", "parents": ["8887a16103701740c05c72876586e57a95cc56bd"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063227 - Enforce both min and max dates in the date picker r=android-reviewers,twhite\n\nCalendarConstraints holds a single DateValidator, so building the constraints with two setValidator() calls silently discarded the first one. Whenever an input specified both min and max constraints, the min validator was overwritten by the max validator and dates before min stayed selectable.\n\nBoth bounds are now combined into a single DateValidator with CompositeDateValidator.allOf(). No validator is set when the input specifies no min nor max bound.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319825\n", "files": ["mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/dialog/TimePickerDialogFragment.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/dialog/TimePickerDialogFragmentTest.kt"], "git_node": "2ddbb37fe4c591752b3bfeff85669fe905e6e53c", "git_parents": ["bb5ada418102536a69be3a5d704560f45f0562df"], "node": "46ef6a163c33c587b7a03140c6ec60459d5cff74", "parents": ["a8299bc74987161814e3a23e3f4fe902ab7f320c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062205 - Bound ELF program header table by bytes actually read in ReadAheadLib (Coverity CID 1122041) r=glandium\n\nReadAheadLib walked the ELF program header table using the count in the\nheader rather than the number of bytes actually read, so a truncated or\nmalformed library could be read past the mapping.\n\nAlso drop four redundant std::move() calls on returned local strings in\nGetLibraryName() and GetLibraryFilePathname(). The locals are nsAuto*String\nwhile the return type is PathString (nsTString), so NRVO never applied and\nthe move is not pessimizing, but CWG 1579 already performs overload\nresolution on a returned automatic object as if it were an rvalue even when\nthe types differ. The explicit std::move() is therefore redundant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317468\n", "files": ["xpcom/glue/FileUtils.cpp"], "git_node": "942f6b63204d9217f0b458c9629a65e06082fc42", "git_parents": ["2ddbb37fe4c591752b3bfeff85669fe905e6e53c"], "node": "3c98b6a67601ad82e7adf2cf16e9c4a0ff547da3", "parents": ["46ef6a163c33c587b7a03140c6ec60459d5cff74"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062576 - [devtools] Add proper focus indicator on fonts panel sliders. r=devtools-reviewers,jdescottes.\n\nUse the same outline we have than for the other inputs in the toolbox.\nWe also take this as an opportunity to apply similar focus indicator\non the fonts panel text input and select, as well as fixing an alignment\nissue between the input and the select for the Size line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320177\n", "files": ["devtools/client/themes/fonts.css"], "git_node": "8e4d6106e74203f132e3f80a5decd69f3e6b3f35", "git_parents": ["942f6b63204d9217f0b458c9629a65e06082fc42"], "node": "cccb503f19a38fdd34e98433b801397b2396adf7", "parents": ["3c98b6a67601ad82e7adf2cf16e9c4a0ff547da3"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044285 - Reuse existing Settings tab from the credit card doorhanger options link. r=mtigley,credential-management-reviewers\n\nOpen the \"Form autofill options\" link through openPreferences() (like the\naddress doorhanger) instead of navigating an about:preferences href, so\nrepeated clicks focus the open Settings tab instead of opening a new one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313391\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_options_link.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "149fd5a987f3b23347d2daf1d165f4e2ee8b61f5", "git_parents": ["8e4d6106e74203f132e3f80a5decd69f3e6b3f35"], "node": "01b395f6c99725fc0cc240315b1147736cc29cee", "parents": ["cccb503f19a38fdd34e98433b801397b2396adf7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064930 - Make image icons work in native menubar. r=mac-reviewers,mkennedy,bradwerth,Jamie\n\nMove the native menubar items out of the \"tools\" menu, since they don't\nneed to be, and menus connect their menuitems lazily, which would\nprevent potential styling with e.g. context fill.\n\nIf we wanted to support that of course we'd need to load menu.css and co\nin the hidden window, but...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321011\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "browser/components/customkeys/CustomKeysParent.sys.mjs", "toolkit/content/widgets/menu.js", "widget/cocoa/nsMenuBarX.h", "widget/cocoa/nsMenuBarX.mm"], "git_node": "a4e2f62cdb9f6ecd55b4244fb88698b2c198552f", "git_parents": ["149fd5a987f3b23347d2daf1d165f4e2ee8b61f5"], "node": "ea200b2ddbb966c7babd3e2eb47588f3b08e19a4", "parents": ["01b395f6c99725fc0cc240315b1147736cc29cee"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066924: use 136.0 as the last-watershed for linux-aarch64 on the release channel r=releng-reviewers,jcristau\n\n136.0b6 is _technically_ the most correct version, I guess, because it's the first one we shipped, and updates could theoretically be done from that version to an RC. In practice this probably doesn't happen, and the `compare-directories.py` doesn't support the scenario. Additionally, it's probably better to test an old version on the release channel than on the beta channel, as there is a much greater chance of updates actually happening from 136.0 -\u003e latest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321727\n", "files": ["taskcluster/kinds/test-update-integrity/kind.yml"], "git_node": "a916bb384b579d21d8ca277046acd3efba715e71", "git_parents": ["a4e2f62cdb9f6ecd55b4244fb88698b2c198552f"], "node": "f02d663226d95b7123b7b7249426edf5a14a6155", "parents": ["ea200b2ddbb966c7babd3e2eb47588f3b08e19a4"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044285 - Reuse existing Settings tab from the credit card doorhanger options link. r=mtigley,credential-management-reviewers\" for causing bc and TV failure at creditCard_doorhanger_options_link.js\n\nThis reverts commit 149fd5a987f3b23347d2daf1d165f4e2ee8b61f5.\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_options_link.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "fc61bce7bd60eba5258a8078bb7bb3ebe5dafeaf", "git_parents": ["a916bb384b579d21d8ca277046acd3efba715e71"], "node": "7ae32714c46f11aa0b00137d28ea709e69034626", "parents": ["f02d663226d95b7123b7b7249426edf5a14a6155"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2064930 - Test fix that was dropped from the revision accidentally.\n\nThese weren't rendering before my change. The test now starts rendering\nthe accesskey which seems the desired behavior.\n", "files": ["layout/reftests/xul/menuitem-key-ref.xhtml"], "git_node": "bc1856c354e72e19c20e6d8348b18431e91c73cb", "git_parents": ["fc61bce7bd60eba5258a8078bb7bb3ebe5dafeaf"], "node": "671c7a7796f25d4c51a2320ae32ee166b82972fb", "parents": ["7ae32714c46f11aa0b00137d28ea709e69034626"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067088 - Indent browser-menubar.inc.xhtml. r=dao\n\nIt makes it easier to see what's going on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321826\n", "files": ["browser/base/content/browser-menubar.inc.xhtml"], "git_node": "4c51e408dc63a77a14459b84731942c5ac6a6dfc", "git_parents": ["bc1856c354e72e19c20e6d8348b18431e91c73cb"], "node": "c8e85315bea8fc02414231079712df31d7384ae3", "parents": ["671c7a7796f25d4c51a2320ae32ee166b82972fb"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065556 - Extract all marionette/remoteagent usage for remotecontrol UIs to RemoteControlServers r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319862\n", "files": ["browser/components/remotecontrol/RemoteControlBanner.sys.mjs", "browser/components/remotecontrol/RemoteControlPanel.sys.mjs", "browser/components/remotecontrol/RemoteControlServers.sys.mjs"], "git_node": "321c5421f86c5555b02d960c6bd1c5a6b13240b5", "git_parents": ["4c51e408dc63a77a14459b84731942c5ac6a6dfc"], "node": "25353b323397d45fb30876e6f2ebf6818bbbdb13", "parents": ["c8e85315bea8fc02414231079712df31d7384ae3"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065556 - Add tests for remote control banners and panel r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320467\n", "files": ["browser/components/remotecontrol/moz.build", "browser/components/remotecontrol/test/browser/browser.toml", "browser/components/remotecontrol/test/browser/browser_banner.js", "browser/components/remotecontrol/test/browser/browser_panel.js", "browser/components/remotecontrol/test/browser/head.js"], "git_node": "0ebe3112c6025daf365ff97bdf20c297058a6e81", "git_parents": ["321c5421f86c5555b02d960c6bd1c5a6b13240b5"], "node": "fb49011af1bfabce51761615b3e6c1d74a01d280", "parents": ["25353b323397d45fb30876e6f2ebf6818bbbdb13"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064975 - Extend glean metrics networking.cookie_c* to 168 r=necko-reviewers,cookie-reviewers,valentin,manuel\n\nThe cookie count and purge metrics expire at the end of Firefox 156. They are\nstill needed for the cookie jar size investigation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321700\n", "files": ["netwerk/metrics.yaml"], "git_node": "152bd98729a9c5d68dccb9e8fa27123be9b6f195", "git_parents": ["0ebe3112c6025daf365ff97bdf20c297058a6e81"], "node": "85a72b3a88ceaf21af5956e5d075bc8df7230028", "parents": ["fb49011af1bfabce51761615b3e6c1d74a01d280"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061865 - Fix text-layout-{09,10}.svg. r=longsonr\n\nThese two tests fail with the previous patch on automation, but I think\nthey're broken already, see the screenshot attached to the bug (which is\nfrom a build without the patch).\n\nI didn't have much time today so I gave Claude a shot for fixing them,\nsuggesting to use a fixed web font, and pointing it at the baseline\ncode in SVGTextFrame. The patch looks reasonable to me, but let me know\nif you can think of a better way of fixing them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321712\n", "files": ["layout/reftests/svg/text-layout-09.svg", "layout/reftests/svg/text-layout-10.svg"], "git_node": "5d9017e43fd432478fb1327adf5812cde8f51e64", "git_parents": ["152bd98729a9c5d68dccb9e8fa27123be9b6f195"], "node": "ee5c67c81dc9ade4d368472aaa519dcbfef4cbce", "parents": ["85a72b3a88ceaf21af5956e5d075bc8df7230028"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061865 - Drop support for legacy fonts from fontconfig back-end. r=jfkthame,lsalzman\n\nThis avoids various duplicate fonts in stock Ubuntu and seems to match\nChromium behavior, at least with regards to Type1 fonts.\n\nFactor out the similar TTF or OpenType font check.\n\nRemoved PCF fonts as well as per discussion with Jonathan.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317185\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "85c745df840922c77f1dae8b2a78b0517464c2ab", "git_parents": ["5d9017e43fd432478fb1327adf5812cde8f51e64"], "node": "7325841a4609aed29c7448c6151cc4e200b5456b", "parents": ["ee5c67c81dc9ade4d368472aaa519dcbfef4cbce"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066655 - Export mozilla::RLBoxSoundTouch::clear() from lgpllibs for MinGW builds. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321748\n", "files": ["config/external/lgpllibs/lgpllibs.symbols"], "git_node": "417c7f5a6e7b2f057abb71226b7d5962e208a651", "git_parents": ["85c745df840922c77f1dae8b2a78b0517464c2ab"], "node": "a8b72a047e253733481d29a65f567e0985085326", "parents": ["7325841a4609aed29c7448c6151cc4e200b5456b"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2046187 - Synthesize pdf.js test clicks in one content query. r=marco\n\nclickAt used separate content operations for mousedown and mouseup, and clickOn measured its target in a third operation.\nUse EventUtils' default mousedown/mouseup sequence and synthesizeMouseAtCenter so each helper needs one content query.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321175\n", "files": ["toolkit/components/pdfjs/test/head.js"], "git_node": "a824ea6db303003839fbc43765f606b178d2eddb", "git_parents": ["417c7f5a6e7b2f057abb71226b7d5962e208a651"], "node": "da11815ccae4ca51f2494c707671d126066bdc89", "parents": ["a8b72a047e253733481d29a65f567e0985085326"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061865 - Inflate cover rect by a pixel in text-layout-09.svg to prevent antialiasing issues on macOS.\n", "files": ["layout/reftests/svg/text-layout-09.svg"], "git_node": "718372440223508c26da5a3d319f2e29f5b0fa28", "git_parents": ["a824ea6db303003839fbc43765f606b178d2eddb"], "node": "0aee53dc05040a3f5be75aceb40e1fd22558c989", "parents": ["da11815ccae4ca51f2494c707671d126066bdc89"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2066412 - Switch SmartBar result menu to panel-list. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321809\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs"], "git_node": "4fc677c36cbdc4cd625065da553c9b80514828bc", "git_parents": ["718372440223508c26da5a3d319f2e29f5b0fa28"], "node": "0f8f229e93f795a244d2ffaf83cd82d9f35d029b", "parents": ["0aee53dc05040a3f5be75aceb40e1fd22558c989"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065074 - Update asset and align spacing with the specifications r=android-reviewers,pollymce\n\nUpdate the asset to match the latest design. Also adjust the vertical spacing between items to align with the Figma specifications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320123\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/startupCrash/StartupCrashScreen.kt", "mobile/android/fenix/app/src/main/res/drawable/fox_alert_crash_dark.xml", "mobile/android/fenix/app/src/main/res/drawable/fox_alert_crash_light.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_kit_plug_error.xml"], "git_node": "11b759275b3be98df18ffa6fcb2abf64c98d662c", "git_parents": ["4fc677c36cbdc4cd625065da553c9b80514828bc"], "node": "4923ef98a40f42105872a3014941019cb861ea19", "parents": ["0f8f229e93f795a244d2ffaf83cd82d9f35d029b"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2066921 - correct text dominant-after-edge baseline in vertical WM r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321831\n", "files": ["layout/reftests/svg/text-layout-10.svg", "layout/svg/SVGTextFrame.cpp"], "git_node": "44d5dd9be48abd611f5011e9e721eb9ce57464ac", "git_parents": ["11b759275b3be98df18ffa6fcb2abf64c98d662c"], "node": "92b94fe6de313850182323d8008849ee160ab5aa", "parents": ["4923ef98a40f42105872a3014941019cb861ea19"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1988655 - Handle OOM and uncatchable exception in FinishLoadingImportedModule. r=jonco\n\nCall mozalloc_handle_oom in case of OOM, and return false in case of uncatchable\nexception, and let caller to handle error accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321789\n", "files": ["js/loader/ModuleLoaderBase.cpp"], "git_node": "73d0052f66b83a8bafb35f259180551c438d341f", "git_parents": ["44d5dd9be48abd611f5011e9e721eb9ce57464ac"], "node": "5f1075f3a895f98d930212208979b9bc69da4b7a", "parents": ["92b94fe6de313850182323d8008849ee160ab5aa"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067088 - Add a blame ignore for this change. r=dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321844\n", "files": [".git-blame-ignore-revs", ".hg-annotate-ignore-revs"], "git_node": "a933f6dc3dbbe7118ab7dba9e3a64d23ccb5d1b8", "git_parents": ["73d0052f66b83a8bafb35f259180551c438d341f"], "node": "9472930047c3d0742705041fe5e1c4e0057c484e", "parents": ["5f1075f3a895f98d930212208979b9bc69da4b7a"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066297 - Fix waiting for iframe to load in test_remove_during_composition.html. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321575\n", "files": ["editor/libeditor/tests/test_remove_during_composition.html"], "git_node": "a8256ca390ccb2320f81cf11b721b83d724c6811", "git_parents": ["a933f6dc3dbbe7118ab7dba9e3a64d23ccb5d1b8"], "node": "e6ae167bc7502c7514e987c847b017c0ac1519d5", "parents": ["9472930047c3d0742705041fe5e1c4e0057c484e"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061366 - Remove legacy contentblocking probes r=timhuang,chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318127\n", "files": ["toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Scalars.yaml"], "git_node": "9bb2394d6668187ada1e5b9ee60d382e00529326", "git_parents": ["a8256ca390ccb2320f81cf11b721b83d724c6811"], "node": "3d88e0c580c43a60b68c221e68453e156cc88c35", "parents": ["e6ae167bc7502c7514e987c847b017c0ac1519d5"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065431 - Ensure sidebar visibility is restored after browser restart when 'Hide tabs and sidebar' option is enabled r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321688\n", "files": ["browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/tests/browser/browser_launcher_hidden_restore.js", "browser/components/sidebar/tests/marionette/test_default_launcher_visible.py"], "git_node": "c90d9e329aab51d33a78c411139fdd655ae098fd", "git_parents": ["9bb2394d6668187ada1e5b9ee60d382e00529326"], "node": "d835196a563935d155e12a406853641617fc329f", "parents": ["3d88e0c580c43a60b68c221e68453e156cc88c35"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067021 - Update android nightly application-services version bump to 524e5ac8ddd46a707e7391539f554dd70598b54b r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321783\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "168e842805cd64d81565ae573289b3991ca7a6e7", "git_parents": ["c90d9e329aab51d33a78c411139fdd655ae098fd"], "node": "fc2660fe020b3dd3b92d8d87add942c312fb66d1", "parents": ["d835196a563935d155e12a406853641617fc329f"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037013 - Don't hold Vulkan objects in `SharedTextureDMABuf`. r=webgpu-reviewers,aleiserson\n\n`SharedTextureDMABuf` is handed to the compositor and can be destroyed\non any thread long after the content process is done with the device,\nyet it held a `VkImage`, a `VkDeviceMemory`, `VkSemaphore`s and a raw\n`mDeviceId`. Teardown can attempt wgpu-core registry lookups on\nalready-dropped IDs, panicking with `Queue[Id(2,3)] does not exist`. The\n`IsDeviceActive()` guard \"fixed\" that by skipping destruction and\nleaking instead (`VUID-vkDestroyDevice-device-05137`). Holding onto the\nVulkan objects was not needed since the compositor only ever imports the\nFDs, which already hold the underlying resources alive. The WebGPU\nparent actor can do the same.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320959\n", "files": ["dom/webgpu/SharedTexture.h", "dom/webgpu/SharedTextureDMABuf.cpp", "dom/webgpu/SharedTextureDMABuf.h", "dom/webgpu/ipc/WebGPUParent.cpp", "dom/webgpu/ipc/WebGPUParent.h", "gfx/wgpu_bindings/src/server.rs"], "git_node": "b14e80842d849108bfccdf07f609c84bb798e1e8", "git_parents": ["168e842805cd64d81565ae573289b3991ca7a6e7"], "node": "6ce4e38a81c82db4d6cc35323ddcefca7da9f7e0", "parents": ["fc2660fe020b3dd3b92d8d87add942c312fb66d1"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 206679