it/components/antitracking/URLQueryStringStripper.cpp", "toolkit/components/antitracking/URLQueryStringStripper.h", "toolkit/components/antitracking/URLQueryStrippingListService.sys.mjs", "toolkit/components/antitracking/jar.mn", "toolkit/components/antitracking/nsIURLQueryStrippingListService.idl", "toolkit/components/antitracking/test/gtest/TestURLStripOnShare.cpp", "toolkit/components/antitracking/test/xpcshell/test_strip_on_share_list.js", "toolkit/components/antitracking/test/xpcshell/test_validate_strip_on_share_list.js"], "git_node": "018fbb59dab37c8b521d1dbd33279dedcebcab32", "git_parents": ["a08f09af018a1526d4f92698b5753df8c8d14e37"], "node": "e8ee97771af001d96659dbe9c24313adf7f4889a", "parents": ["e5cedded4e84e851eb979113c4b89e3714b633d6"], "tags": []}, {"author": "Javier Fern  ndez Garc  a-Boente \u003cjfernandez@igalia.com\u003e", "branch": "default", "desc": "Bug 2061233 - Add service worker resistFingerprinting tests for timer precision and navigator spoofing r=dom-worker-reviewers,timhuang,edenchuang\n\nAdds browser-chrome tests covering resistFingerprinting protections inside\nServiceWorkerGlobalScope, which has its own performance, Date and navigator.\nThe existing coverage reaches windows and dedicated and shared workers\n(browser_performanceAPIWorkers.js, browser_reduceTimePrecision_iframes.js),\nand for service workers only navigator.hardwareConcurrency\n(browser_fpiServiceWorkers_fingerprinting.js).\n\n- Timer precision reduction is applied to performance.now() and Date.now() in\n  the service worker, with the window scope measured as a control and a\n  reduction-disabled control proving the clamping comes from the prefs and not\n  from a coarse worker clock. That control also checks that unconditional\n  reduction is off, which a 100ms check cannot see.\n- The spoofed navigator identity (userAgent, appVersion, platform,\n  hardwareConcurrency) seen in the service worker matches the controlling\n  window, and with resistFingerprinting on the userAgent matches the value\n  nsIRFPService spoofs. The window values are read in page scope, since\n  userAgent, appVersion and platform are [NeedsCallerType] and a system caller\n  reads them unspoofed.\n- navigator.language and navigator.languages are spoofed through\n  privacy.spoof_english rather than by resistFingerprinting itself, so they are\n  checked against a non-English accept-language list with spoofing both off and\n  on.\n\nhead.js gains withServiceWorkerTab(), which tears down the tab, the site data\nit created and the pref environment unconditionally, isTimeValueRounded(),\nmirroring the helper the browser/components/resistfingerprinting tests share,\nand TEST_EMPTY_PAGE, next to the other test page constants.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316822\n", "files": ["toolkit/components/resistfingerprinting/tests/browser/browser.toml", "toolkit/components/resistfingerprinting/tests/browser/browser_service_worker_navigator_spoofing.js", "toolkit/components/resistfingerprinting/tests/browser/browser_service_worker_timer_precision.js", "toolkit/components/resistfingerprinting/tests/browser/head.js"], "git_node": "c436a178cb8f71de6f5e63a4e88c29c6ec63ed36", "git_parents": ["018fbb59dab37c8b521d1dbd33279dedcebcab32"], "node": "2ecbf664f980753eceaf873f2be2cf5dac548172", "parents": ["e8ee97771af001d96659dbe9c24313adf7f4889a"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2049325 - test(offscreen-canvas): assert `OffscreenCanvas.convertToBlob` with `NaN` quality is same as unspecified r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303384\n", "files": ["testing/web-platform/tests/html/canvas/offscreen/manual/convert-to-blob/offscreencanvas.convert.to.blob.html", "testing/web-platform/tests/html/canvas/offscreen/manual/convert-to-blob/offscreencanvas.convert.to.blob.w.html"], "git_node": "ce54a88ba1e2c2801265175e210dc7bf756debf9", "git_parents": ["c436a178cb8f71de6f5e63a4e88c29c6ec63ed36"], "node": "b8ec57c6a6973a0522d3e913c6dd1c4fdfe34abd", "parents": ["2ecbf664f980753eceaf873f2be2cf5dac548172"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2011543 - Group history items by exact date r=android-reviewers,android-l10n-reviewers,parker,calu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318438\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/HistoryTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HistorySelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HistoryRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryItemTimeGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/state/HistoryTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/history/HistoryItemTimeGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/history/state/HistoryTelemetryMiddlewareTest.kt"], "git_node": "381fc76e2a857e56c6f2d1862909021b63603558", "git_parents": ["ce54a88ba1e2c2801265175e210dc7bf756debf9"], "node": "ac732484cdc503c7f7e8e6ac7a9e3c57ee1bd96b", "parents": ["b8ec57c6a6973a0522d3e913c6dd1c4fdfe34abd"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067488 - Enable network.http.happy_eyeballs_enabled on nightly only, r=mxinden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322111\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "9e16b3bb2897d8467ce378ef2fde2c6e29e004fe", "git_parents": ["381fc76e2a857e56c6f2d1862909021b63603558"], "node": "0653740caed48783b68036abc73e7b3c76c01e95", "parents": ["ac732484cdc503c7f7e8e6ac7a9e3c57ee1bd96b"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058212 - part 1 - Group all AwesomeBar test tags in a separate class r=android-reviewers,jdelorenzo\n\nMore will be added and having a single place to use them from will ensure easier\ndiscoverability while also avoiding bugs from having to hardcode them in multiple places.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319554\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/AwesomeBarTestTags.kt", "mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/internal/Suggestion.kt", "mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/internal/Suggestions.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SearchBarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SearchRobot.kt"], "git_node": "5765665e126242c299f1e43a536da9ec27fad5fc", "git_parents": ["9e16b3bb2897d8467ce378ef2fde2c6e29e004fe"], "node": "7604cb0cb3675818e353cd5b7554d735ccbc77e1", "parents": ["0653740caed48783b68036abc73e7b3c76c01e95"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058212 - part 2 - Show the current tab data in the AwesomeBar r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319169\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/AwesomeBar.kt", "mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/AwesomeBarTestTags.kt",