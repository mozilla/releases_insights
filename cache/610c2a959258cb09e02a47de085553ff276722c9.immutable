/web-platform/meta/html-aam/accname-computation-by-element/input-image.html.ini", "testing/web-platform/meta/html-aam/accname-computation-by-element/inputs-with-placeholders.html.ini", "testing/web-platform/meta/html-aam/accname-computation-by-element/other-form-elements.html.ini", "testing/web-platform/meta/html-aam/accname-computation-by-element/phrasing-elements.html.ini", "testing/web-platform/meta/html-aam/accname-computation-by-element/section-and-grouping-elements.html.ini", "testing/web-platform/meta/html-aam/accname-computation-by-element/tr-td-th.tentative.html.ini", "testing/web-platform/meta/html-aam/hidden-names.html.ini"], "git_node": "bb49168fbee773aa29d700bb58950582f61bb4ea", "git_parents": ["b57343bc6d12ad0805128862e829969ff2de3f6e"], "node": "55b381cca7325a7260c4f127724de63d08e28f72", "parents": ["f9d485a6d423efac98d2a90256c48d5f342099a3"], "tags": []}, {"author": "Kiet Ho \u003ckiet.ho@apple.com\u003e", "branch": "default", "desc": "Bug 2066969 [wpt PR 62226] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321977, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321977\n\n--\n\nwpt-commits: 9de5319abeec7ab454853a755e5278d1c1c14395\nwpt-pr: 62226\n", "files": ["testing/web-platform/tests/css/css-conditional/at-media-matches-001.html", "testing/web-platform/tests/css/css-conditional/at-media-matches-002.html", "testing/web-platform/tests/css/css-conditional/support/at-media-matches-002-iframe.html"], "git_node": "e6b797c25c11aff924198ddd0931fe6bc2132e14", "git_parents": ["bb49168fbee773aa29d700bb58950582f61bb4ea"], "node": "d9d35b6c28ac803eb2934b6df314ce2229dd12c9", "parents": ["55b381cca7325a7260c4f127724de63d08e28f72"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066969 [wpt PR 62226] - Update wpt metadata, a=testonly\n\nwpt-pr: 62226\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/at-media-matches-001.html.ini", "testing/web-platform/meta/css/css-conditional/at-media-matches-002.html.ini", "testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini"], "git_node": "9a8504bc942ad93330aac4654d81a0e23c353ed8", "git_parents": ["e6b797c25c11aff924198ddd0931fe6bc2132e14"], "node": "f6f4dc856d478c83a838805179b2bc8ede5be7cf", "parents": ["d9d35b6c28ac803eb2934b6df314ce2229dd12c9"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2067662 [wpt PR 62241] - Use correct closing tag in `block-height-011.html`, a=testonly\n\nAutomatic update from web-platform-tests\nUse correct closing tag in `block-height-011.html`\n\n--\n\nwpt-commits: 3756238b8b7d6b36a5d911424859ea738b1d39ec\nwpt-pr: 62241\n", "files": ["testing/web-platform/tests/css/css-sizing/stretch/block-height-011.html"], "git_node": "3d42c87c24c71a4b77ae5553802b2647d3bfc22b", "git_parents": ["9a8504bc942ad93330aac4654d81a0e23c353ed8"], "node": "86e2326ba554244f06175ee282725710ebc808b4", "parents": ["f6f4dc856d478c83a838805179b2bc8ede5be7cf"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2067663 [wpt PR 62240] - sttf: defer scroll check by an extra 2 rafs., a=testonly\n\nAutomatic update from web-platform-tests\nsttf: defer scroll check by an extra 2 rafs.\n\nThis is a speculative fix to a flaky test, since we now definitely\nwait for related page sets to be ready. The previous fix updated some\ntests but not this one.\n\nR=bokan@chromium.org\n\nBug: 553338116\nChange-Id: I363ecd08c27696d0c470c1ad5c4ee7afc2925898\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8307012\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: David Bokan \u003cbokan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1687324}\n\n--\n\nwpt-commits: 6ae1cda56bd255ad5c18bdd86cbc71f2d46e765c\nwpt-pr: 62240\n", "files": ["testing/web-platform/tests/scroll-to-text-fragment/find-range-from-text-directive-target.html"], "git_node": "c469a63f4a708ddb6d1074ede6770fce1d458768", "git_parents": ["3d42c87c24c71a4b77ae5553802b2647d3bfc22b"], "node": "9ff50f2ad76db7767f03adaa60acbf50b6aedf85", "parents": ["86e2326ba554244f06175ee282725710ebc808b4"], "tags": []}, {"author": "Kristin Lee \u003ckristinlee@microsoft.com\u003e", "branch": "default", "desc": "Bug 2067664 [wpt PR 62234] - [WebInstall] Remove legacy install URL support from Web Install, a=testonly\n\nAutomatic update from web-platform-tests\n[WebInstall] Remove legacy install URL support from Web Install\n\n- Remove navigator.install(install_url[, manifest_id]) overloads and\n  WebInstallResult.manifestId.\n- Standard Web IDL dictionary semantics now ignore installurl when\n  manifest is present and reject calls missing the required manifest.\n- Remove \u003cinstall installurl\u003e IDL and reject any remaining uses in\n  Blink, so the retired attribute reports invalid data instead of\n  unexpectedly installing the current document.\n- Delete obsolete Mojo, browser service, command, scheduler, and UI\n  plumbing used only by install document URLs.\n- Preserve navigator and element installation for current documents\n  and explicit manifest URLs.\n- Port reusable permission, attribution, repair, dialog, and PWA-window\n  coverage to retained manifest URL paths.\n- Update Blink, browser, WPT, and web-exposed interface tests.\n\n- Internal design doc:\nhttps://docs.google.com/document/d/1rGvLhD4SR8Y9M1wVmqgyesPNkbZGU7HOqlttjEFJ5Vo/edit?tab=t.0\n- Test site:\nhttps://kbhlee2121.github.io/pwa/web-install-manifest-url/index.html\n\nBug: 520025525, 333795265\nChange-Id: I67aefeb897ff1490ad541d299cf62a4ab4f3eae6\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8265584\nReviewed-by: Lia Hiscock \u003cliahiscock@microsoft.com\u003e\nReviewed-by: Mike West \u003cmkwst@chromium.org\u003e\nReviewed-by: Daniel Murphy \u003cdmurph@chromium.org\u003e\nCommit-Queue: Kristin Lee \u003ckristinlee@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1687363}\n\n--\n\nwpt-commits: 4a269cb5be5a3b39703bdbb6d11a7f5dad46cbe9\nwpt-pr: 62234\n", "files": ["testing/web-platform/tests/web-install/navigator-install-bad-inputs.tentative.https.html", "testing/web-platform/tests/web-install/navigator-install-user-activation.tentative.https.html"], "git_node": "fc2ae316f01fbf75de7edf4795fe12f725352e82", "git_parents": ["c469a63f4a708ddb6d1074ede6770fce1d458768"], "node": "9f50795568a4aae7dc23deb1726570f53d34cfe6", "parents": ["9ff50f2ad76db7767f03adaa60acbf50b6aedf85"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067664 [wpt PR 62234] - Update wpt metadata, a=testonly\n\nwpt-pr: 62234\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/web-install/navigator-install-bad-inputs.tentative.https.html.ini", "testing/web-platform/meta/web-install/navigator-install-user-activation.tentative.https.html.ini"], "git_node": "978fcbf4a091fd3d218d3b6b537b06b9fd037edb", "git_parents": ["fc2ae316f01fbf75de7edf4795fe12f725352e82"], "node": "bb2807cbc2ed3f98bbc440e349ef2c13afcfcc59", "parents": ["9f50795568a4aae7dc23deb1726570f53d34cfe6"], "tags": []}, {"author": "Sam Sneddon \u003cgsnedders@apple.com\u003e", "branch": "default", "desc": "Bug 2055113 [wpt PR 59249] - Dynamically generate shards for GitHub Actions test workflows, a=testonly\n\nAutomatic update from web-platform-tests\nDynamically generate shards for GitHub Actions test workflows\n\nInstead of using eight shards, with no regard for test type, we\ninstead move to using sharding identical to Taskcluster.\n\nIn doing this, we fix #51399, because the Safari runs are now sharded\nby test type.\n\nBy running in a larger number of smaller shards, the risk of hitting\ntimeouts should be decreased, even with us reducing the timeout per\njob to 120 minutes, to match Taskcluster, though without the 240\nminute testharness special-case.\n\n--\n\nwpt-commits: 10a4cd69c69a080a4fc7c0049d36d1104313229a\nwpt-pr: 59249\n", "files": ["testing/web-platform/tests/.github/workflows/safari-wptrunner.yml", "testing/web-platform/tests/.github/workflows/safari_stable.yml", "testing/web-platform/tests/.github/workflows/safari_technology_preview.yml", "testing/web-platform/tests/tools/ci/chunks.yml", "testing/web-platform/tests/tools/ci/github/__init__.py", "testing/web-platform/tests/tools/ci/github/commands.json", "testing/web-platform/tests/tools/ci/github/generate_matrix.py", "testing/web-platform/tests/tools/ci/github/requirements_generate_matrix.txt", "testing/web-platform/tests/tools/ci/github/tests/__init__.py", "testing/web-platform/tests/tools/ci/github/tests/test_generate_matrix.py", "testing/web-platform/tests/tools/mypy.ini", "testing/web-platform/tests/tools/requirements_mypy.txt", "testing/web-platform/tests/tools/wpt/paths"], "git_node": "4548d93449aef8996bce653b4ceb95d719e49e2b", "git_parents": ["978fcbf4a091fd3d218d3b6b537b06b9fd037edb"], "node": "02f0000a66c24e58d7c854d8e89c699556eb86dc", "parents": ["bb2807cbc2ed3f98bbc440e349ef2c13afcfcc59"], "tags": []}, {"author": "Justin Lulejian \u003cjustinlulejian@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066913 [wpt PR 62224] - [Extensions] Support Windows paths in extension WPT runner, a=testonly\n\nAutomatic update from web-platform-tests\n[Extensions] Support Windows paths in extension WPT runner (#62224)\n\n* [Extensions] Support Windows paths in WPT runner\n\nBefore this CL, web-extension WPT tests (such as browser.alarms,\nbrowser.bookmarks, browser.browsingData, browser.idle, browser.runtime,\nand browser.storage) were marked as failing in TestExpectations. When\nrunning these tests on Windows, executorwebdriver._resolve_path failed\nbecause it split test_path on \"/\" while Windows paths use backslashes.\n\nThis caused invalid concatenated extension paths like\n\"web-extensions\\browser.alarms.extension.html/resources/alarms/\",\nleading to unhandled promise rejections during extension installation.\nAfter this CL, web-extension WPT tests resolve paths correctly across\nall platforms.\n--\n\nwpt-commits: fcfef65cd03e76a9ad27acc710167a03fd5e1520\nwpt-pr: 62224\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executorwebdriver.py"], "git_node": "b2bfca4acefed26a9aa0d5d9cefc86a6fcd0783a", "git_parents": ["4548d93449aef8996bce653b4ceb95d719e49e2b"], "node": "c4f1c91f0a38279565b5b8b7a7dfa3a0ec887f43", "parents": ["02f0000a66c24e58d7c854d8e89c699556eb86dc"], "tags": []}, {"author": "Koji Ishii \u003ckojii@chromium.org\u003e", "branch": "default", "desc": "Bug 2067665 [wpt PR 62243] - [iframe] Use `allow` instead of `allowed` in tests, a=testonly\n\nAutomatic update from web-platform-tests\n[iframe] Use `allow` instead of `allowed` in tests\n\nAs the spec has changed to use `allow` instead of `allowed`,\nthis patch changes wpt test to use `allow`.\n\nBug: 418397278\nChange-Id: I639213b3ad978e09ac57069efc82fea163df8a3b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8303172\nAuto-Submit: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: Koji Ishii \u003ckojii@chromium.org\u003e\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1686973}\n\n--\n\nwpt-commits: 92ba46c15dd83eca908987265c18d2166e837d4f\nwpt-pr: 62243\n", "files": ["testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-allow-origins-missing.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-allow-origins.sub.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/responsive-iframe-allow-origins.html"], "git_node": "1b64688567315172e40558b604e3067c121a616e", "git_parents": ["b2bfca4acefed26a9aa0d5d9cefc86a6fcd0783a"], "node": "15303bf5d3e09d8ceba665621e52c0341d2088bc", "parents": ["c4f1c91f0a38279565b5b8b7a7dfa3a0ec887f43"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067665 [wpt PR 62243] - Update wpt metadata, a=testonly\n\nwpt-pr: 62243\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-sizing/responsive-iframe/responsive-iframe-allow-origins.html.ini"], "git_node": "5b6220ee45658b2e988d5d450796c2b5bcc96b57", "git_parents": ["1b64688567315172e40558b604e3067c121a616e"], "node": "55756d6c0418986098444ce65a8fae1702da7315", "parents": ["15303bf5d3e09d8ceba665621e52c0341d2088bc"], "tags": []}, {"author": "Javier Contreras Tenorio \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2067667 [wpt PR 62245] - [masonry] Add missing grid-lanes gap WPTs, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Add missing grid-lanes gap WPTs\n\nAdd reftests for fill reversal, track reversal, the combined reverse\ndirections, integer repeat() restarting in each lane, explicit\ncolumn-over-row painting, and explicit rule-break: normal. Mark the four\nlist-assignment cases as expected failures while Chromium does not yet\nimplement the resolved assignment order.\n\nBug: 343257585\nChange-Id: I88d4ee66b6d5d836bf2290eab236b61bcea38812\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8298458\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1687449}\n\n--\n\nwpt-commits: 6ef761d290c2ab02aefd522fc0f094a273a21fdb\nwpt-pr: 62245\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-break-normal-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-break-normal.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-list-fill-track-reverse-ref.html", "testing