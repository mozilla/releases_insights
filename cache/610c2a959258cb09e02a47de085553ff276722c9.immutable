sts/async_fn.rs", "third_party/rust/multiversion/tests/attrs.rs", "third_party/rust/multiversion/tests/cfg.rs", "third_party/rust/multiversion/tests/choose_dispatcher.rs", "third_party/rust/multiversion/tests/clones.rs", "third_party/rust/multiversion/tests/destructure.rs", "third_party/rust/multiversion/tests/generics.rs", "third_party/rust/multiversion/tests/helpers.rs", "third_party/rust/multiversion/tests/impl_trait.rs", "third_party/rust/multiversion/tests/simd.rs", "third_party/rust/multiversion_no_op/.cargo-checksum.json", "third_party/rust/multiversion_no_op/.cargo_vcs_info.json", "third_party/rust/multiversion_no_op/COPYRIGHT", "third_party/rust/multiversion_no_op/Cargo.toml", "third_party/rust/multiversion_no_op/Cargo.toml.orig", "third_party/rust/multiversion_no_op/LICENSE-APACHE", "third_party/rust/multiversion_no_op/LICENSE-MIT", "third_party/rust/multiversion_no_op/README.md", "third_party/rust/multiversion_no_op/src/lib.rs", "third_party/rust/simdutf8/.cargo-checksum.json", "third_party/rust/simdutf8/.cargo_vcs_info.json", "third_party/rust/simdutf8/CHANGELOG.md", "third_party/rust/simdutf8/Cargo.lock", "third_party/rust/simdutf8/Cargo.toml", "third_party/rust/simdutf8/Cargo.toml.orig", "third_party/rust/simdutf8/LICENSE-Apache", "third_party/rust/simdutf8/LICENSE-MIT", "third_party/rust/simdutf8/README.md", "third_party/rust/simdutf8/examples/streaming.rs", "third_party/rust/simdutf8/release.toml", "third_party/rust/simdutf8/rustfmt.toml", "third_party/rust/simdutf8/src/basic.rs", "third_party/rust/simdutf8/src/compat.rs", "third_party/rust/simdutf8/src/implementation/aarch64/mod.rs", "third_party/rust/simdutf8/src/implementation/aarch64/neon.rs", "third_party/rust/simdutf8/src/implementation/algorithm.rs", "third_party/rust/simdutf8/src/implementation/helpers.rs", "third_party/rust/simdutf8/src/implementation/mod.rs", "third_party/rust/simdutf8/src/implementation/wasm32/mod.rs", "third_party/rust/simdutf8/src/implementation/wasm32/simd128.rs", "third_party/rust/simdutf8/src/implementation/x86/avx2.rs", "third_party/rust/simdutf8/src/implementation/x86/mod.rs", "third_party/rust/simdutf8/src/implementation/x86/sse42.rs", "third_party/rust/simdutf8/src/lib.rs", "third_party/rust/simdutf8/tests/tests.rs", "third_party/rust/simdutf8/wasm32-development.md", "third_party/rust/target-features/.cargo-checksum.json", "third_party/rust/target-features/.cargo_vcs_info.json", "third_party/rust/target-features/Cargo.lock", "third_party/rust/target-features/Cargo.toml", "third_party/rust/target-features/Cargo.toml.orig", "third_party/rust/target-features/LICENSE-APACHE", "third_party/rust/target-features/LICENSE-MIT", "third_party/rust/target-features/README.md", "third_party/rust/target-features/build.rs", "third_party/rust/target-features/examples/proof-token.rs", "third_party/rust/target-features/rustc-version.txt", "third_party/rust/target-features/src/lib.rs", "third_party/rust/target-features/src/simd.rs", "third_party/rust/target-features/target-cpus.txt", "third_party/rust/target-features/target-features.txt", "third_party/rust/target-features/tests/target.rs"], "git_node": "f5b3e3f51b2a775db6d4240248525a62d62ee7b1", "git_parents": ["a0618677128769eee435df59d03c5b09957c7aa3"], "node": "eb5fc34815c6d8634512be607ae63a6d339b4c39", "parents": ["5a4d28e75b42037ff0ff908221643eafb6bdf364"], "tags": []}, {"author": "giddeon \u003cs.giddeon.card@gmail.com\u003e", "branch": "default", "desc": "Bug 2067328 - Removed duplicate method from TestTreeManager.cpp. r=botond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322146\n", "files": ["gfx/layers/apz/test/gtest/TestTreeManager.cpp"], "git_node": "5c44cb6ca110b934ea6bb680a8c93b32e3d45ec9", "git_parents": ["f5b3e3f51b2a775db6d4240248525a62d62ee7b1"], "node": "f7577d05b753d2d289994bf25d05e5c1b85dd9a7", "parents": ["eb5fc34815c6d8634512be607ae63a6d339b4c39"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066996 part 1 - Fix a small bug in the debugger's IsInCatchScopeMatcher. r=arai\n\nThe old code didn't handle the `CatchA` =\u003e `CatchB` =\u003e `ForOf` case correctly, because\nit treated both catch blocks as synthetic for-of catch blocks instead of only `CatchB`.\n\nThis caused a debugger jit-test failure when we remove the `ForOfIterClose` try note\nin a later patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321785\n", "files": ["js/src/debugger/Script.cpp"], "git_node": "a7798ce75009294cd9e0a1052e9cf5d7d2764df2", "git_parents": ["5c44cb6ca110b934ea6bb680a8c93b32e3d45ec9"], "node": "bf70802f0b8b0c535cd946b2055134efbaffab5e", "parents": ["f7577d05b753d2d289994bf25d05e5c1b85dd9a7"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066996 part 2 - Emit for-of IteratorClose bytecode after the loop. r=arai\n\nThis changes for-of loops to match what `finally` blocks and (since bug 2063576)\narray destructuring do. The non-local exit bytecode jumps to shared code emitted\nafter the loop, where we close the iterator and continue the non-local exit.\n\nThe patch also simplifies `NonLocalExitControl::emitNonLocalJump` a bit. We no\nlonger need the `jumpingToCleanup` boolean and can instead return immediately.\n\nThis lets us remove `TryNoteKind::ForOfIterClose` in the next patch. It also lets us\nshare bytecode for similar non-local exits, which matters for `await` and `using` loops\nbecause in these cases we can emit a lot of bytecode.\n\nMicro-benchmarks show that some for-of loops with `break` statements are much faster\nbecause we now avoid some phis that prevented scalar replacement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321786\n", "files": ["js/src/frontend/BytecodeControlStructures.cpp", "js/src/frontend/EmitterScope.cpp", "js/src/frontend/ForOfEmitter.cpp", "js/src/frontend/ForOfLoopControl.cpp", "js/src/frontend/ForOfLoopControl.h"], "git_node": "1675a0b38e4f89ef4f0b6c72c9e228142dc09659", "git_parents": ["a7798ce75009294cd9e0a1052e9cf5d7d2764df2"], "node": "0d3e2334b0d1f5f91a8981e37e2f1bbbc965ed9f", "parents": ["bf70802f0b8b0c535cd946b2055134efbaffab5e"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066996 part 3 - Remove now unused TryNoteKind::ForOfIterClose. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321787\n", "files": ["js/src/frontend/ForOfEmitter.cpp", "js/src/frontend/ForOfLoopControl.cpp", "js/src/frontend/ForOfLoopControl.h", "js/src/jit/JitFrames.cpp", "js/src/vm/Interpreter.cpp", "js/src/vm/Interpreter.h", "js/src/vm/JSScript.cpp", "js/src/vm/SharedStencil.h", "js/src/vm/StencilEnums.h"], "git_node": "fd616354a1df22fa063338bd098a9b07332b8456", "git_parents": ["1675a0b38e4f89ef4f0b6c72c9e228142dc09659"], "node": "e4b7008841eea5f4bede5d27532a3dcea080c85c", "parents": ["0d3e2334b0d1f5f91a8981e37e2f1bbbc965ed9f"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2066679 [Wayland] Use layer compositor on Linux r=sotaro\n\nIf HDR mode is enabled on Linux/Wayland, use layer compositor for rendering.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321495\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "be8c90d990b25f8be9c0c86f35586bbd52108bf7", "git_parents": ["fd616354a1df22fa063338bd098a9b07332b8456"], "node": "bffee89a1f6610fb0262a2e234e3a3723cc4755c", "parents": ["e4b7008841eea5f4bede5d27532a3dcea080c85c"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2066693 - Move main wordmark resources to drawable-nodpi r=android-reviewers,twhite\n\nMove the main Firefox wordmark text drawables to drawable-nodpi so\nthey use the same resource qualifier as the build-type overrides.\n\nThis ensures the channel-specific wordmarks properly override the\nmain resources and prevents the \"Preview\" wordmark from appearing\nin shipped builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321863\n", "files": ["mobile/android/fenix/app/src/main/res/drawable-nodpi/ic_wordmark_text_normal.xml", "mobile/android/fenix/app/src/main/res/drawable-nodpi/ic_wordmark_text_private.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_wordmark_text_normal.xml", "mobile/android/fenix/app/src/main/res/drawable/ic_wordmark_text_private.xml"], "git_node": "0923fe276d168409e72367e16cea190f95dac9f7", "git_parents": ["be8c90d990b25f8be9c0c86f35586bbd52108bf7"], "node": "9db7b057e30113c6f472a44114c9ad2c2e8affca", "parents": ["bffee89a1f6610fb0262a2e234e3a3723cc4755c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\naf -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nan -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nar -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nast -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\naz -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nbe -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nbg -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nbn -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nbo -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nbqi -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nbr -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nbrx -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nbs -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nca -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nca-valencia -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\ncak -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\nckb -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\ncs -\u003e 8394db89b8947dffe5e1144ee865badd8cf09959\ncy -\u003e 8394db89b8947dffe5e1144e