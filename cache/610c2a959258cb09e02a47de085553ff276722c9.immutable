r.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322858\n", "files": ["netwerk/dns/TRRServiceBase.cpp", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/ProxyConfigLookup.cpp", "netwerk/ipc/ProxyConfigLookup.h", "netwerk/ipc/ProxyConfigLookupChild.cpp", "netwerk/ipc/ProxyConfigLookupChild.h", "netwerk/ipc/ProxyConfigLookupParent.cpp", "netwerk/ipc/ProxyConfigLookupParent.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "netwerk/protocol/http/TRRServiceChannel.cpp", "netwerk/test/unit/test_trr_proxy_channel_filter.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "8900b23290b928b081c273fc08297392e1d85faa", "git_parents": ["2a6671870c5c270e79f00691293ed014ee6e0e14"], "node": "0e2a0c139573e7d62e277aaa89c1f76e80002b26", "parents": ["4a43d14e55fe033cc77c670da2eaea5f7f4cb1d1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067184 - Remove ParserInput. r=firefox-style-system-reviewers,supply-chain-reviewers,dshin\n\nWe should do this even just for simplicity, IMHO, but this should also\navoid some indirection during parsing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321882\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "servo/components/selectors/parser.rs", "servo/components/style/color/parsing.rs", "servo/components/style/custom_properties.rs", "servo/components/style/gecko/selector_parser.rs", "servo/components/style/media_queries/media_list.rs", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties_and_values/rule.rs", "servo/components/style/properties_and_values/syntax/mod.rs", "servo/components/style/properties_and_values/value.rs", "servo/components/style/queries/condition.rs", "servo/components/style/queries/feature.rs", "servo/components/style/queries/feature_expression.rs", "servo/components/style/selector_parser.rs", "servo/components/style/stylesheets/font_feature_values_rule.rs", "servo/components/style/stylesheets/font_palette_values_rule.rs", "servo/components/style/stylesheets/keyframes_rule.rs", "servo/components/style/stylesheets/mod.rs", "servo/components/style/stylesheets/rule_parser.rs", "servo/components/style/stylesheets/stylesheet.rs", "servo/components/style/stylesheets/supports_rule.rs", "servo/components/style/stylist.rs", "servo/components/style/values/specified/font.rs", "servo/components/style_traits/values.rs", "servo/ports/geckolib/glue.rs", "servo/tests/unit/style/custom_properties.rs", "servo/tests/unit/style/parsing/mod.rs", "servo/tests/unit/style/parsing/selectors.rs", "servo/tests/unit/style/parsing/supports.rs", "servo/tests/unit/style/properties/mod.rs", "supply-chain/audits.toml", "supply-chain/imports.lock", "third_party/rust/cssparser-macros/.cargo-checksum.json", "third_party/rust/cssparser-macros/lib.rs", "third_party/rust/cssparser/.cargo-checksum.json", "third_party/rust/cssparser/Cargo.toml", "third_party/rust/cssparser/src/cow_rc_str.rs", "third_party/rust/cssparser/src/lib.rs", "third_party/rust/cssparser/src/nth.rs", "third_party/rust/cssparser/src/parser.rs", "third_party/rust/cssparser/src/rules_and_declarations.rs", "third_party/rust/cssparser/src/size_of_tests.rs", "third_party/rust/cssparser/src/tests.rs", "third_party/rust/cssparser/src/tokenizer.rs"], "git_node": "cf73335889848cddcee076e44c74cca27d97dc71", "git_parents": ["8900b23290b928b081c273fc08297392e1d85faa"], "node": "71307605562e125fde68b1b10fae77d5ec383bea", "parents": ["0e2a0c139573e7d62e277aaa89c1f76e80002b26"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068111 - Fix ruff UP031 and PLW2901 warnings in python/mozbuild/mozbuild/action r=firefox-build-system-reviewers,sergesanspaille\" for causing build bustages at libmozsqlite3.so.symbols.\n\nThis reverts commit 1360793aad4ebdbb25e75835dd4fc47f5d307762.\n", "files": ["python/mozbuild/mozbuild/action/fat_aar.py", "python/mozbuild/mozbuild/action/file_generate_wrapper.py", "python/mozbuild/mozbuild/action/generate_symbols_file.py", "python/mozbuild/mozbuild/action/langpack_manifest.py", "python/mozbuild/mozbuild/action/node.py", "python/mozbuild/mozbuild/action/package_generated_sources.py", "python/mozbuild/mozbuild/action/process_define_files.py", "python/mozbuild/mozbuild/action/symbols_archive.py", "python/mozbuild/mozbuild/action/test_archive.py", "python/mozbuild/mozbuild/action/wrap_rustc.py", "python/mozbuild/mozbuild/action/xpccheck.py", "python/mozbuild/mozbuild/action/xpidl-process.py"], "git_node": "c017707b1cf392356d3dba085b613c4e40b0941d", "git_parents": ["cf73335889848cddcee076e44c74cca27d97dc71"], "node": "17edf99ca40ae7de7148a62c6f4f9c7559d774aa", "parents": ["71307605562e125fde68b1b10fae77d5ec383bea"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2043115 - fix modifier/middle clicks on nested links without an href attribute, r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321514\n", "files": ["browser/base/content/test/linkHandling/browser.toml", "browser/base/content/test/linkHandling/browser_nested_hrefless_links.js", "toolkit/modules/BrowserUtils.sys.mjs"], "git_node": "dddac0f84bf4efe33c93343a29a8bb02a0074ed5", "git_parents": ["c017707b1cf392356d3dba085b613c4e40b0941d"], "node": "57e82a9f17d94c8fd6c2d1c7e46b4958c8d9584d", "parents": ["17edf99ca40ae7de7148a62c6f4f9c7559d774aa"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915308 - [devtools] Update inspector onRootNodeAvailable to wait for #setupToolbar r=devtools-reviewers,ochameau\n\nSee https://bugzilla.mozilla.org/show_bug.cgi?id=1915308#c29 for more details.\nThe missing await leads to uncaught promise rejections in some tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322829\n", "files": ["devtools/client/inspector/inspector.js"], "git_node": "d570c8176a4c66692f252fc4f7792efce0394d81", "git_parents": ["dddac0f84bf4efe33c93343a29a8bb02a0074ed5"], "node": "6cbdbb29c53fe554ec308c86edfcfa724615e29a", "parents": ["57e82a9f17d94c8fd6c2d1c7e46b4958c8d9584d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1970802 - Wait for the new tab to be reflowed in openNewForegroundTab, r=Gijs.\n\nA remote browser has a 0x0 viewport until we reflow it and send\nUpdateDimensions, so a caller that synthesizes input as soon as\nopenNewForegroundTab resolves can hit test against an empty area, and the event\nresolves to the document rather than to an element.\n\nThe wait runs alongside the load, so it only costs anything when nothing else\nalready waited for a tick.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322870\n", "files": ["testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "4529cc05b43a1c4cbb32da98fb1798fe29e00a21", "git_parents": ["d570c8176a4c66692f252fc4f7792efce0394d81"], "node": "719aaa9f5557c9f52a24265b61c425a3c909a981", "parents": ["6cbdbb29c53fe554ec308c86edfcfa724615e29a"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1851058 - Remove the image.exif-density-correction.sanity-check.enabled pref r=nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322731\n", "files": ["image/decoders/EXIF.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "158183beba713d35c86a8772fc5e35f988684741", "git_parents": ["4529cc05b43a1c4cbb32da98fb1798fe29e00a21"], "node": "08f5d929b54d3575cce71e449b029d0827fcfc99", "parents": ["719aaa9f5557c9f52a24265b61c425a3c909a981"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065239 - Implement more metrics within InitMetricsFromSkrifa, including those derived from glyph measurement. r=AlaskanEmily,firefox-style-system-reviewers\" for causing WR failures\n\nThis reverts commit 2a6671870c5c270e79f00691293ed014ee6e0e14.\n", "files": ["gfx/fontations_glue/lib.rs", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxMacFont.cpp", "gfx/thebes/gfxMacFont.h", "layout/style/ServoBindings.toml", "layout/style/nsStyleStruct.h"], "git_node": "635dbae8049b7f8da12e4ecfa8abaa7637b31107", "git_parents": ["158183beba713d35c86a8772fc5e35f988684741"], "node": "98a066b4dc70f1b04f35bf9356f152c72f097a60", "parents": ["08f5d929b54d3575cce71e449b029d0827fcfc99"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068457 - Update android nightly application-services version bump to a373d0feec51d92d1f56395a99f220bdf9279602 r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322830\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "703d9ba25680df8513456e2d285411f4de202c6d", "git_parents": ["635dbae8049b7f8da12e4ecfa8abaa7637b31107"], "node": "5fb8ce1f31659dd53a106c292610dd13ec923126", "parents": ["98a066b4dc70f1b04f35bf9356f152c72f097a60"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1885206 - Await validateDataSizes() in testUIWithDataSizesLoading. r=emz\n\nThe call was left unawaited, so its assertions raced the cancelDialog() on\nthe next line and were abandoned rather than reported.\n\nThe fake built a fresh unresolved promise on every invocation, so awaiting\nthe call deadlocked: validateDataSizes() fetches the quota usage itself to\ncompute the expected values, and that second call waited on a resolver\nnobody holds. Create the promise once so it can resolve again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317339\n", "files": ["browser/base/content/test/sanitize/browser_sanitizeDialog_v2_dataSizes.js"], "git_node": "54f814bb960241062cb447d322cfbe723ea3a187", "git_parents": ["703d9ba25680df8513456e2d285411f4de202c6d"], "node": "9c7969dbea57e7e1f873270166f7569af34986be", "parents": ["5fb8ce1f31659dd53a106c292610dd13ec923126"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1871561 - Stop setting unused taarId session cookies on AMO in all containers during startup r=extension-reviewers,firefox-desktop-core-reviewers ,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322874\n", "files": ["browser/app/profile/firefox.js", "browser/components/BrowserComponents.manifest", "browser/components/BrowserGlue.sys.mjs", "browser/modules/Discovery.sys.mjs", "browser/modules/moz.build", "browser/modules/test/unit/test_discovery.js", "browser/modules/test/unit/xpcshell.toml", "toolkit/mozapps/extensions/content/aboutaddons-utils.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_discover_view_clientid.js", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "e3e1bc2b9e5e88ae2f1ce330d35d28bba9f94c99", "git_parents": ["54f814bb960241062cb447d322cfbe723ea3a187"], "node": "d6e3ca4434e2fdda6a137d2a695f28b21babe2f8", "parents": ["9c7969dbea57e7e1f873270166f7569af34986be"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068532 - Document how source-comment API references render in the documentation skill. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322881\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "5dcb7d9e57fa1ebd2f369887e9e6d0becaec6a71", "git_parents": ["e3e1bc2b9e5e88ae2f1ce330d35d28bba9f94c99"], "node": "9737d29c1a89a0dd626aba7a28e806218ab51ce8", "parents": ["d6e3ca4434e2fdda6a137d2a695f28b21babe2f8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068546 - Document mermaid diagrams in the documentation skill. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322887\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "9d04bc308341f53a77577376726eee27e182e9d1", "git_parents": ["5dcb7d9e57fa1ebd2f369887e9e6d0becaec6a71"], "node": "9d37628b0aface7be01073cf0a2a6a99bcf9d54c", "parents": ["9737d29c1a89a0dd626aba7a28e806218ab51ce8"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064822 - Set alertSeverity for newssite-applink-startup on a55. r=perftest-reviewers,mozperftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320466\n", "files": ["python/mozperftest/mozperftest/metrics/perfherder.py", "python/mozperftest/mozperftest/metrics/utils.py", "python/mozperftest/mozperftest/schemas/intermediate-results-schema.json", "python/mozperftest/mozperftest/test/shellscript.py", "python/mozperftest/mozperftest/tests/test_perfherder.py", "python/mozperftest/mozperftest/tests/test_shellscript.py", "testing/performance/mobile-startup/android_startup_videoapplink.py"], "git_node": "7129059c9a5af41a67fb85cd6ae85d444a87d6b3", "git_parents": ["9d04bc308341f53a77577376726eee27e182e9d1"], "node": "8543a801c20e6a99ce63ab3237831606203c38d9", "parents": ["9d37628b0aface7be01073cf0a2a6a99bcf9d54c"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1852529 - [wdspec] Improve \"scroll\" tests for \"wheel\" input type for both WebDriver classic and BiDi. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311236\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/wheel_events.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/wheel_frame.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel_events.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/wheel_frame.py.ini", "testing/web-platform/mozilla/tests/webdriver/bidi/input/perform_actions/wheel.py", "testing/web-platform/mozilla/tests/webdriver/classic/perform_actions/conftest.py", "testing/web-platform/mozilla/tests/webdriver/classic/perform_actions/wheel.py", "testing/web-platform/mozilla/tests/webdriver/support/fixtures.py", "testing/web-platform/mozilla/tests/webdriver/support/helpers.py", "testing/web-platform/tests/webdriver/tests/bidi/input/conftest.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/__init__.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/wheel.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/wheel_events.py", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/wheel_frame.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/__init__.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/conftest.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/duration.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/wheel.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/wheel_events.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/wheel_frame.py", "testing/web-platform/tests/webdriver/tests/support/fixtures.py", "testing/web-platform/tests/webdriver/tests/support/html/test_actions_scroll.html", "testing/web-platform/tests/webdriver/tests/support/html/wheel/test_actions.css", "testing/web-platform/tests/webdriver/tests/support/html/wheel/test_actions.html", "testing/web-platform/tests/webdriver/tests/support/html/wheel/test_actions.js", "testing/web-platform/tests/webdriver/tests/support/html/wheel/test_actions_inner_frame.css", "testing/web-platform/tests/webdriver/tests/support/html/wheel/test_actions_inner_frame.html", "testing/web-platform/tests/webdriver/tests/support/html/wheel/test_actions_inner_frame.js"], "git_node": "86bd7bb8d0ef9288bc65958135caa5ceead8cf9f", "git_parents": ["7129059c9a5af41a67fb85cd6ae85d444a87d6b3"], "node": "edf57b758279580346532f01c95d16802f064b30", "parents": ["8543a801c20e6a99ce63ab3237831606203c38d9"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050444 - Change sidebar width to 50x wide when vertical tabs are enabled in compact and standard UI densities to make room for scrollbar r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321983\n", "files": ["browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "16044b7719229e1eb680227b5296b27c3e881635", "git_parents": ["86bd7bb8d0ef9288bc65958135caa5ceead8cf9f"], "node": "7f30d8816859d4ac3055878201fc8579d8c187d5", "parents": ["edf57b758279580346532f01c95d16802f064b30"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051973 - Vendor and compile the Metal backend for libggml. r=firefox-build-system-reviewers,glandium,sergesanspaille,valentinp\n\nThis includes the Metal shader source in asm and compiles it. Specific\nsymbols are then picked up by the implementation, and the byte range is\nfed to the Metal shader compiler. The resulting object file is\nsubsequently cached by the OS.\n\nFirst compilation is in the order of 4-5s, subsequent instantiation is\n10-15ms.\n\nThis backend will always ever run in a dedicated process, that has a\nsandbox very similar to the GPU process, but doesn't have access to the\ndisplay server, fonts, and other facilities related to rendering. It can\naccess one more folder than the GPU process (read/write) to cache the\ncompiled shaders.\n\nThis benefits llama.cpp, but also anything else that uses ggml such as\nparakeet.cpp, that is introduced in a later patch. This can multiply\nthe performance by multiple dozen times (depending on the hardware\nand use-case). More importantly, it completely offload inference\nto the GPU. While (e.g.) real-time local speech recognition is\nrunning with this backend, `about:processes` show all thread of\nthe HWInference process as \"idle\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268401\n", "files": ["third_party/llama.cpp/generate_metal_embed.py", "third_party/llama.cpp/ggml/include/ggml-metal.h", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal-impl.h", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal.m", "third_party/llama.cpp/ggml/src/ggml-metal/ggml-metal.metal", "third_party/llama.cpp/moz.build", "third_party/llama.cpp/moz.yaml", "third_party/llama.cpp/run_parser.py"], "git_node": "20d174c4e184cd9fcc7391c36c0dbc3be9bfc9a9", "git_parents": ["16044b7719229e1eb680227b5296b27c3e881635"], "node": "d6582396cb890dc12fea4f807a3e00c6a33ab002", "parents": ["7f30d8816859d4ac3055878201fc8579d8c187d5"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2051973 - Fall back to CPU when the GPU backend fails to initialize. r=valentinp,ai-platform-reviewers\n\nThe Metal libggml backend can register a GPU device that then fails during real\nbackend init (e.g. CI VMs or older Intel Macs, where the device exists but the\ncommand queue / shader library can't be created). Because the vendored library\nis built without exceptions, a failure inside llama_context would abort instead\nof falling back. Probe the GPU backend once and force CPU offload off when it is\nunusable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315685\n", "files": ["config/external/mozinference/mozinference.symbols", "toolkit/components/ml/backends/llama/LlamaBackend.cpp", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h"], "git_node": "c4618016af72b49ad070aa9f012f120e1ce4fbc8", "git_parents": ["20d174c4e184cd9fcc7391c36c0dbc3be9bfc9a9"], "node": "a8d279045916633ae7b9bf929e73219ecb2d0f86", "parents": ["d6582396cb890dc12fea4f807a3e00c6a33ab002"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Vendor mudler/parakeet.cpp for cache-aware streaming speech recognition. r=firefox-build-system-reviewers,glandium,media-playback-reviewers,alwu\n\nThis is mudler/parakeet.cpp, vendored for real-time, cache-aware streaming\nspeech recognition of a Parakeet-family (RNN-T/joint) model via a streaming\nC API (parakeet_capi.h). It uses libggml (that we already vendor in\nllama.cpp) as its backend for most computations.\n\nThis is compiled into `libmozinference`.\n\nTwo patches are applied on top:\n- parakeet-fd-loading.patch: load a speech recognition model from a `FILE*`\n  instead of a file path. This is passed down by the main process when\n  starting recognition, similarly to what we do for llama.cpp.\n- parakeet-no-drwav.patch: drop the vendored dr_wav.h dependency, which is\n  unused because Firefox only ever feeds PCM directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268402\n", "files": ["config/external/mozinference/mozinference.symbols", "dom/media/webspeech/recognition/moz.build", "third_party/parakeet.cpp/LICENSE", "third_party/parakeet.cpp/include/parakeet.h", "third_party/parakeet.cpp/include/parakeet_capi.h", "third_party/parakeet.cpp/moz-overrides.h", "third_party/parakeet.cpp/moz.build", "third_party/parakeet.cpp/moz.yaml", "third_party/parakeet.cpp/parakeet-fd-loading.patch", "third_party/parakeet.cpp/parakeet-no-drwav.patch", "third_party/parakeet.cpp/src/audio_io.cpp", "third_party/parakeet.cpp/src/audio_io.hpp", "third_party/parakeet.cpp/src/backend.cpp", "third_party/parakeet.cpp/src/backend.hpp", "third_party/parakeet.cpp/src/common.cpp", "third_party/parakeet.cpp/src/common.hpp", "third_party/parakeet.cpp/src/conformer.cpp", "third_party/parakeet.cpp/src/conformer.hpp", "third_party/parakeet.cpp/src/ctc_decoder.cpp", "third_party/parakeet.cpp/src/ctc_decoder.hpp", "third_party/parakeet.cpp/src/decode_common.hpp", "third_party/parakeet.cpp/src/decode_types.hpp", "third_party/parakeet.cpp/src/encoder.cpp", "third_party/parakeet.cpp/src/encoder.hpp", "third_party/parakeet.cpp/src/fft.cpp", "third_party/parakeet.cpp/src/fft.hpp", "third_party/parakeet.cpp/src/ggml_graph.cpp", "third_party/parakeet.cpp/src/ggml_graph.hpp", "third_party/parakeet.cpp/src/graph_builder.hpp", "third_party/parakeet.cpp/src/joint.cpp", "third_party/parakeet.cpp/src/joint.hpp", "third_party/parakeet.cpp/src/mel.cpp", "third_party/parakeet.cpp/src/mel.hpp", "third_party/parakeet.cpp/src/mel_gpu.cpp", "third_party/parakeet.cpp/src/mel_gpu.hpp", "third_party/parakeet.cpp/src/model.cpp", "third_party/parakeet.cpp/src/model.hpp", "third_party/parakeet.cpp/src/model_loader.cpp", "third_party/parakeet.cpp/src/model_loader.hpp", "third_party/parakeet.cpp/src/parakeet.cpp", "third_party/parakeet.cpp/src/parakeet_capi.cpp", "third_party/parakeet.cpp/src/pos_enc.cpp", "third_party/parakeet.cpp/src/pos_enc.hpp", "third_party/parakeet.cpp/src/prediction.cpp", "third_party/parakeet.cpp/src/prediction.hpp", "third_party/parakeet.cpp/src/prompt_kernel.cpp", "third_party/parakeet.cpp/src/prompt_kernel.hpp", "third_party/parakeet.cpp/src/relpos_attention.cpp", "third_party/parakeet.cpp/src/relpos_attention.hpp", "third_party/parakeet.cpp/src/rnnt.cpp", "third_party/parakeet.cpp/src/rnnt.hpp", "third_party/parakeet.cpp/src/search.cpp", "third_party/parakeet.cpp/src/search.hpp", "third_party/parakeet.cpp/src/streaming.cpp", "third_party/parakeet.cpp/src/streaming.hpp", "third_party/parakeet.cpp/src/streaming_encoder.cpp", "third_party/parakeet.cpp/src/streaming_encoder.hpp", "third_party/parakeet.cpp/src/subsampling.cpp", "third_party/parakeet.cpp/src/subsampling.hpp", "third_party/parakeet.cpp/src/tdt.cpp", "third_party/parakeet.cpp/src/tdt.hpp", "third_party/parakeet.cpp/src/tokenizer.cpp", "third_party/parakeet.cpp/src/tokenizer.hpp", "third_party/parakeet.cpp/src/transcription.cpp", "third_party/parakeet.cpp/src/transcription.hpp", "third_party/parakeet.cpp/src/transducer_batch.cpp", "third_party/parakeet.cpp/src/transducer_batch.hpp"], "git_node": "44a01fe93b3961b4f845656c104dc3cf4d5edef7", "git_parents": ["c4618016af72b49ad070aa9f012f120e1ce4fbc8"], "node": "ad20bb8144ee9d4f0be183c55eb70edda78d9b2b", "parents": ["a8d279045916633ae7b9bf929e73219ecb2d0f86"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Remove code related to online speech recognition, or generally the previous incarnation of Web Speech Recognition. r=pehrsons,frontend-codestyle-reviewers\n\nThis has never been shipped and the endpoints aren't functional anymore,\nwe can just remove everything. I don't think we'll want to ship\nnon-local speech recognition at this point.\n\nThis is mostly to ease review, we'll fill in the blanks in a later\npatch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268404\n", "files": [".clang-format-ignore", ".prettierignore", "dom/media/webspeech/recognition/OnlineSpeechRecognitionService.cpp", "dom/media/webspeech/recognition/OnlineSpeechRecognitionService.h", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechTrackListener.cpp", "dom/media/webspeech/recognition/SpeechTrackListener.h", "dom/media/webspeech/recognition/endpointer.cc", "dom/media/webspeech/recognition/endpointer.h", "dom/media/webspeech/recognition/energy_endpointer.cc", "dom/media/webspeech/recognition/energy_endpointer.h", "dom/media/webspeech/recognition/energy_endpointer_params.cc", "dom/media/webspeech/recognition/energy_endpointer_params.h", "dom/media/webspeech/recognition/moz.build", "dom/media/webspeech/recognition/nsISpeechRecognitionService.idl", "dom/media/webspeech/recognition/test/FakeSpeechRecognitionService.cpp", "dom/media/webspeech/recognition/test/FakeSpeechRecognitionService.h", "dom/media/webspeech/recognition/test/http_requesthandler.sjs", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_abort.html", "dom/media/webspeech/recognition/test/test_audio_capture_error.html", "dom/media/webspeech/recognition/test/test_call_start_from_end_handler.html", "dom/media/webspeech/recognition/test/test_nested_eventloop.html", "dom/media/webspeech/recognition/test/test_online_400_response.html", "dom/media/webspeech/recognition/test/test_online_empty_result_handling.html", "dom/media/webspeech/recognition/test/test_online_hangup.html", "dom/media/webspeech/recognition/test/test_online_http.html", "dom/media/webspeech/recognition/test/test_online_http_webkit.html", "dom/media/webspeech/recognition/test/test_online_malformed_result_handling.html", "dom/media/webspeech/recognition/test/test_recognition_service_error.html", "dom/media/webspeech/recognition/test/test_success_without_recognition_service.html", "dom/media/webspeech/recognition/test/test_timeout.html", "dom/media/webspeech/synth/moz.build", "layout/build/components.conf", "layout/build/nsLayoutModule.cpp", "modules/libpref/Preferences.cpp", "modules/libpref/init/StaticPrefList.yaml", "toolkit/moz.configure", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "0c67cb3c5f279ff5724b0bba64867d9da3c1c73c", "git_parents": ["44a01fe93b3961b4f845656c104dc3cf4d5edef7"], "node": "764ecdb8b327e063b2fe769d2ef6664917b97a04", "parents": ["ad20bb8144ee9d4f0be183c55eb70edda78d9b2b"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Allow AudioConverter to take nsTArray. r=media-playback-reviewers,alwu\n\nThis allows skipping unnecessary copies if the caller has the data in\nnsTArray.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268399\n", "files": ["dom/media/AudioConverter.h", "dom/media/MediaData.h"], "git_node": "bcce31929f3f31862111d680884a97c23a13c4e4", "git_parents": ["0c67cb3c5f279ff5724b0bba64867d9da3c1c73c"], "node": "723281f599faca5dda95a57fe42f2987bab3d1d2", "parents": ["764ecdb8b327e063b2fe769d2ef6664917b97a04"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Allow configuring the resampling quality in AudioConverter. r=media-playback-reviewers,alwu\n\nWe'll use it for speech recognition, and that doesn't need any quality\nat all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268400\n", "files": ["dom/media/AudioConverter.cpp", "dom/media/AudioConverter.h"], "git_node": "34192d6881b9d6aa0fa183ec9445c4cd135bdd0e", "git_parents": ["bcce31929f3f31862111d680884a97c23a13c4e4"], "node": "fc71997e19c035cc8e66a514e0725814a65f1c78", "parents": ["723281f599faca5dda95a57fe42f2987bab3d1d2"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Make the SpeechRecognition side of the Web Speech API mostly up-to-date in terms of spec. r=webidl,saschanaz,smaug,pehrsons,media-playback-reviewers,alwu\n\nhttps://webaudio.github.io/web-speech-api/#speechreco-section\n\nThe SpeechRecognitionBackend object introduced here (as a stub) will handle\nall the \"actual\" recognition; this object handles the DOM side. The backend\nis fleshed out in subsequent patches.\n\nAs noted in the code, a number of things are unclear in the standard, that\nwe're working on addressing.\n\nThis removes a little bit of the previous backend (online recognition) that\nwas left after the previous patch removed most of it, and implements:\n\n- available()\n- install()\n- SpeechRecognitionPhrase\n- the phrases-not-supported error code (bad-grammar is kept for web\n  compatibility even though grammars are not implemented and it never fires)\n- the final attribute of SpeechRecognitionResult\n- [SecureContext] on the SpeechRecognition interfaces, per spec\n\nmost of the WPTs are manual, and need work anyway, this will happen in\nanother patch as a followup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268405\n", "files": ["dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/SpeechRecognitionPhrase.cpp", "dom/media/webspeech/recognition/SpeechRecognitionPhrase.h", "dom/media/webspeech/recognition/SpeechRecognitionResult.cpp", "dom/media/webspeech/recognition/SpeechRecognitionResult.h", "dom/media/webspeech/recognition/SpeechTrackListener.cpp", "dom/media/webspeech/recognition/SpeechTrackListener.h", "dom/media/webspeech/recognition/moz.build", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_abort_end_async.html", "dom/media/webspeech/recognition/test/test_start_after_error.html", "dom/webidl/SpeechRecognition.webidl", "dom/webidl/SpeechRecognitionAlternative.webidl", "dom/webidl/SpeechRecognitionError.webidl", "dom/webidl/SpeechRecognitionEvent.webidl", "dom/webidl/SpeechRecognitionPhrase.webidl", "dom/webidl/SpeechRecognitionResult.webidl", "dom/webidl/SpeechRecognitionResultList.webidl", "dom/webidl/moz.build"], "git_node": "03048ad7e299993450791a8692ded9890449eb4d", "git_parents": ["34192d6881b9d6aa0fa183ec9445c4cd135bdd0e"], "node": "b9b16a80f38594ec1ac06dd31e22ba40d995438e", "parents": ["fc71997e19c035cc8e66a514e0725814a65f1c78"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Introduce PSpeechRecognition and the model-availability IPC path. r=nika,ai-platform-reviewers,valentinp,ipc-reviewers\n\nIntroduces the PSpeechRecognition protocol and wires up the availability\nround-trip that backs SpeechRecognition.available(): it starts in the\ncontent process, instantiates a SpeechRecognition actor, sends a request\nto the HWInference process, which then asks the parent process, at which\npoint the ModelHub can be queried (on the main thread). The DOM-facing\nSpeechRecognition.available() is implemented on top of this in a later\ncommit.\n\nPSpeechRecognition is toplevel rather than managed. A managed actor is\nbound to its manager's thread, so a process-wide PHWInferenceManager would\nhave let the first consumer to connect pick the thread for every other\none. PHWInferenceManager is therefore removed entirely: the content\nprocess creates each endpoint pair itself, sends the parent endpoint to\nContentParent over PContent, and binds the child endpoint on its dedicated\nSpeechIPC thread. ContentParent forwards the parent endpoint to the\nHWInference utility process over PHWInference, supplying the trusted\nContentParentId that SpeechRecognitionParent keeps and attaches to install\nrequests, so those stay attributed to their actual content process without\nrelying on a managed-actor relationship.\n\nProcess lifetime is owned separately from the per-session actors.\nAcquireHWInferenceProcess and ReleaseHWInferenceConnection have\nContentParent retain a UtilityProcessKeepAlive for as long as its content\nprocess has at least one user, so closing one speech actor cannot tear the\nprocess down while another user still needs it.\nbrowser.ml.hwinference.max_restarts bounds relaunches after crashes, and a\nclean shutdown resets that budget.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268409\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognitionChild.cpp", "dom/media/webspeech/recognition/SpeechRecognitionChild.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "dom/media/webspeech/recognition/moz.build", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/UtilityProcessManager.h", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceManagerChild.cpp", "toolkit/components/ml/ipc/HWInferenceManagerChild.h", "toolkit/components/ml/ipc/HWInferenceManagerParent.cpp", "toolkit/components/ml/ipc/HWInferenceManagerParent.h", "toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.h", "toolkit/components/ml/ipc/PHWInference.ipdl", "toolkit/components/ml/ipc/PHWInferenceManager.ipdl", "toolkit/components/ml/ipc/moz.build"], "git_node": "523f6050c2786d0a0665142f05383574e6f4b4c2", "git_parents": ["03048ad7e299993450791a8692ded9890449eb4d"], "node": "aaa52ccd2da0cbb0cd6accf3ec99c199df139e74", "parents": ["b9b16a80f38594ec1ac06dd31e22ba40d995438e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Implement the backend for downloading a model file, using ModelHub. r=ipc-reviewers,nika,ai-platform-reviewers\n\nThis is very similar to the previous patch (available()), but leverages\nthe ModelHub to download a model, with progress callback. The download\nprogress isn't relayed to content (intentionally, for fingerprinting\nreasons), but a completion callback is (error or success).\n\nAgain, this starts in the content process, uses a transient\nPSpeechRecognition actor to reach the HWInference process, that asks the\nmain process (on its main thread) to download a model (or resolve the\npromise immediately if already downloaded -- ModelHub implements a\ncache).\n\nSince the availability and download paths only differ in which\nHWInferenceChild message they send, the RecvIsModelAvailable body is\ngeneralized here into a shared RunHWInferenceBoolQuery helper that both\nreuse.\n\nRemove the undeclared MLModelHubService component event extra as this path\nstarts using downloadModel(); Glean rejects model_download events containing\nthat extra.\n\nGating the download on \"something\" (for Speech Recognition a consent prompt)\nis implemented in a later commit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268410\n", "files": ["dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "toolkit/components/ml/MLModelHubService.sys.mjs"], "git_node": "701d0551aae841732d0a55864dcf0633366b4508", "git_parents": ["523f6050c2786d0a0665142f05383574e6f4b4c2"], "node": "3fa5389d6adcd06cf1c6504083b24df0648e0523", "parents": ["aaa52ccd2da0cbb0cd6accf3ec99c199df139e74"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Fetch the function we need for speech recognition from the mozinference library. r=atossou,ai-platform-reviewers,valentinp\n\nWe could imagine renaming this LlamaRuntimeLinker but I didn't bother.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268413\n", "files": ["toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h"], "git_node": "86c8530595d3840aa6e1b8df84a1f43d6c98f5c8", "git_parents": ["701d0551aae841732d0a55864dcf0633366b4508"], "node": "c773092a2695e609b00290def961c760f504f9da", "parents": ["3fa5389d6adcd06cf1c6504083b24df0648e0523"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Get a model file fd in the HWInference process, initialize a Parakeet context with it. r=ipc-reviewers,nika\n\nThis is similar to what we do for llama.cpp in the Inference process,\nbut native-IPC style instead of JS style.\n\nThis requires bouncing through a couple threads, but we create a\ndedicated thread, that will then run the actual recognition process, in\nthis patch.\n\nAdds a testing-only pref, media.webspeech.recognition.testing.parakeet_init_delay_ms,\nthat delays context initialization on that thread so tests can deterministically\nrace abort()/ActorDestroy() against startup (used by a later test).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268414\n", "files": ["build/clang-plugin/ThreadAllows.txt", "dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "8522e6713a687971f931ee3b3b8924cdc12a3884", "git_parents": ["86c8530595d3840aa6e1b8df84a1f43d6c98f5c8"], "node": "352f6ac0a01fb73fbdd476403b2636d57deedd78", "parents": ["c773092a2695e609b00290def961c760f504f9da"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Perform speech recognition locally in the browser. r=media-playback-reviewers,alwu\n\nAudio received from content over IPC is enqueued into a lock-free SPSC\nqueue; a background thread on the utility process dequeues it and feeds it\nto the parakeet cache-aware streaming C-API. Since the model never revises\nalready-committed output, each newly committed chunk of text is emitted as\na final result once a word boundary is reached, with the trailing partial\nword held for the next feed; the tail is flushed at end-of-stream.\n\nAlso hardens session teardown: RecvStop() and ActorDestroy() now clear the\nactive-session slot so it cannot be leaked, ActorDestroy() uses\nAsyncShutdown() to avoid a reentrant event-loop pump while tearing down the\nrecognition thread, and the child side gains a DestroyedCallback so it can\ndrop its actor reference if the parent side goes away first.\n\nFor debugging, a MOZ_DUMP_AUDIO-gated WavDumper records the recognition\naudio input, and a profiler marker is emitted for each result. The Parakeet\nrecognition thread is added to the profiler on-device-ML thread presets, so\nthose markers and the thread samples are captured without hand-editing the\nThreads filter. An unrelated indentation fix to\nmedia.webspeech.synth.enabled in StaticPrefList.yaml rode along.\n\nThe recognition loop is still being tuned and will change, but this is the\ngeneral idea.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268415\n", "files": ["devtools/shared/performance-new/prefs-presets.sys.mjs", "dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognitionChild.cpp", "dom/media/webspeech/recognition/SpeechRecognitionChild.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "f1fee4ef28d14a8a3ffde5c075240fea460c04dc", "git_parents": ["8522e6713a687971f931ee3b3b8924cdc12a3884"], "node": "c8d2011bcfe3f406885d1bf0d98dff45a9205d8e", "parents": ["352f6ac0a01fb73fbdd476403b2636d57deedd78"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Select the speech recognition model per locale. r=media-playback-reviewers,ai-platform-reviewers,alwu,valentinp\n\nAdd a models.yaml manifest (gen_speech_models.py) so\nLanguagesToSpeechModel (SpeechRecognitionModelMapping.{h,cpp}) picks a model\nper locale prefix, overridable via media.webspeech.recognition.model.\u003cprefix\u003e\nprefs, instead of always using a single hardcoded parakeet model.\n\nModel size will be used in later patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311112\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionModelMapping.cpp", "dom/media/webspeech/recognition/SpeechRecognitionModelMapping.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "dom/media/webspeech/recognition/gen_speech_models.py", "dom/media/webspeech/recognition/models.yaml", "dom/media/webspeech/recognition/moz.build"], "git_node": "255db864eb17fcc7d21fb5cc9eec1cdd2057c2ba", "git_parents": ["f1fee4ef28d14a8a3ffde5c075240fea460c04dc"], "node": "fcdd2169fed0ed970cc6d374a8490b0f9bd7fd83", "parents": ["c8d2011bcfe3f406885d1bf0d98dff45a9205d8e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Add IsModelInstalled to the model install IPC. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315356\n", "files": ["dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h"], "git_node": "3031ea1b4b91ec16b213c180a19392a74dad4133", "git_parents": ["255db864eb17fcc7d21fb5cc9eec1cdd2057c2ba"], "node": "facbf30b71e60d3805d3d3823c15dcbc0802b2eb", "parents": ["fcdd2169fed0ed970cc6d374a8490b0f9bd7fd83"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Introduce SpeechRecognitionBackend - Part 1 - Static methods. r=nika,pehrsons\n\nThis patch starts filling in the blanks in SpeechRecognitionBackend. This\nobject sits behind the SpeechRecogntion DOM object, and implements some light\naudio processing, and IPC communication.\n\nAudio processing is left for the next patch. Beyond the static methods\n(`available` and `install`, which call the IPDL methods of the same name),\nthis patch also implements the threading architecture, the IPC-thread\nlifecycle, and the transient-vs-long-running session management described\nbelow.\n\nMore importantly this patch implement a threading architecture that works for\nreal-time audio, and DOM API, static and instance methods.\n\nThe constraints are the following:\n- We're going to send method calls (available, install, start, stop, etc.) to\nthe HWInference process, those come from the main thread (Web Speech API)\n- We're also going to need to send real-time audio to the same process (with a\ngraduingly lower and lower packet size, to reduce end-to-end latency). This come\nfrom a hard-real-time thread (from our MediaTrackGraph)\n- Our IPC system requires all method calls to be on a single thread\n- The real-time audio thread can't do any system calls or unbounded operations\n(can't do IPC, locking, allocations, etc.)\n- We really don't want to bounce the real-time audio via the main thread for IPC\nor make it more busy if we can avoid it (it's already a nightmare in a typical\nmedia processing web app)\n- We can't affort scheduling hazards associated with using a shared thread (e.g.\nthe shared background thread), because we want to have low and constant latency\n- There are both static and instance methods to implement\n\nThe design is therefore the following:\n- A dedicated SpeechIPC thread is created lazily and kept as a static member on\nthe class. It is a LazyIdleThread: its serial event target is stable for the\nprocess lifetime, so an actor is never handed a thread instance that later goes\naway underneath it, but its backing OS thread is released once idle. The OS\nthread is only ever idle while no connection is open (an active session streams\naudio continuously), so it is never reclaimed mid-session.\n- IPC only ever runs on this dedicated thread\n- Static method calls are dispatched to that thread, and the result is\ndispatched back to the main thread.\n- In the next patch, processed and packetized audio is dispatched to that\nthread as well\n- Whenever a Speech Recognition session is active, or while an available or\ninstall call is in flight, the HWInference connection is held open (refcounted)\n- Otherwise the connection is closed as soon as we can (session stop, result of\n`available` or `install`), so the utility process isn't kept alive by an idle\nconnection; the now-idle OS thread is then reclaimed by the LazyIdleThread\n\nThe logic to manage those transient sessions (vs. long running ones) is\nencapsulated in a dedicated class.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D275653\n", "files": ["build/clang-plugin/ThreadAllows.txt", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h"], "git_node": "bbdc696d59f7fcf75e41a43d71cbac789a1d65a1", "git_parents": ["3031ea1b4b91ec16b213c180a19392a74dad4133"], "node": "c98c596d6788d52bf03d8e7fead60ccd45f8d6eb", "parents": ["facbf30b71e60d3805d3d3823c15dcbc0802b2eb"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Introduce SpeechRecognitionBackend - Part 2 - Audio side. r=pehrsons\n\nThis patch adds:\n\n- Getting audio from a MediaTrackGraph, downmixing it, queuing it to a ring\nbuffer\n- Running a processing loop on a dedicated thread (called the resampling\nthread), that dequeues from the ring buffer, downsamples the audio to 16kHz\n(which is the rate at which the inference is running), and sends it over to the\nIPC thread, that will send it to the HWInference process in chunks of (by\ndefault) 500ms\n- Receive events from the HWInference process, and relay them to the main thread\n(notably speech recognition events, but also errors and such) object,\nSpeechRecognition\n\nIt also hardens session lifecycle handling: Init() now returns a Web Speech\nerror token instead of a bool so failures (e.g. \"concurrent-session\",\n\"network\") can be surfaced properly, the single-session slot is released when\ninit fails, Stop()/Abort() teardown is made idempotent and covers the case\nwhere Stop() races with an in-flight session init (avoiding a leaked session\nslot), and stale backend callbacks are dropped if a newer backend has since\nreplaced the current one.\n\nThe SpeechRecognitionChild destroyed callback takes the destroyed actor as an\nargument: capturing it by raw pointer for an identity comparison trips the\nclang-plugin refcounted-inside-lambda checker, and a strong capture would keep\nthe actor alive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D275657\n", "files": ["build/clang-plugin/ThreadAllows.txt", "dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "dom/media/webspeech/recognition/SpeechTrackListener.cpp"], "git_node": "2020fc4c3f3e8e3281b550834fb5104242a1d4c0", "git_parents": ["bbdc696d59f7fcf75e41a43d71cbac789a1d65a1"], "node": "17d6fb5e38b28661606e696881d34ae8f919d27b", "parents": ["c98c596d6788d52bf03d8e7fead60ccd45f8d6eb"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Hold the HWInference process while speech recognition needs it. r=media-playback-reviewers,alwu\n\nSpeech recognition decides how long the HWInference process lives, via the\ngeneric keep-alive introduced earlier in the stack. sIPCActorUsers counts\nIPCActorUserGuards, and one is held:\n\n    for the lifetime of every SpeechRecognition object, taken in its constructor via AcquireProcessKeepAlive() (which only counts, and does not establish the connection) and dropped in DisconnectFromOwner() as well as the destructor, so a torn-down window releases it without waiting for GC;\n    for each in-flight static available()/install()/IsModelInstalledNative() call, via RunWithTransientSession();\n    for an active recognition session, from EnsureIPC().\n\nReaching zero does not close the connection immediately: it arms a\nmedia.webspeech.recognition.idle_shutdown_grace_ms (5s) timer, cancelled by the\nnext Increment(), so a stop()/start() cycle or a burst of static calls reuses\nthe warm process instead of paying for a relaunch. 0 closes immediately, which\nis what tests use. The grace period is a speech recognition policy and lives\nhere rather than in UtilityProcessManager, which stays a plain refcount so\nother HWInference consumers can choose differently.\n\nIPCActorUserGuard moves out of SpeechRecognitionBackend to namespace scope so\nSpeechRecognition can hold one by forward declaration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315353\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "b72f55d6e7256b7f96a594f0aeb087272cc22f3e", "git_parents": ["2020fc4c3f3e8e3281b550834fb5104242a1d4c0"], "node": "af985efef11d5e65ee5e20d862dd14f1d9097b7a", "parents": ["17d6fb5e38b28661606e696881d34ae8f919d27b"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Architecture docs / review guide. r=media-playback-reviewers,aosmond\n\nI'll turn this into a real documentation for this module later, but lots\nof information here can help reviewing the code, so I'm pushing it now\nso it can be read by reviewers, as phabricator builds and renders the\ndocs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D268417\n", "files": ["dom/media/docs/SpeechRecognition.md", "dom/media/docs/index.md"], "git_node": "5abff8d3d975464142408d759e4150707f44e766", "git_parents": ["b72f55d6e7256b7f96a594f0aeb087272cc22f3e"], "node": "f4747bcbe2ee2b228742d003c11d082fda79052b", "parents": ["af985efef11d5e65ee5e20d862dd14f1d9097b7a"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Fix include guards in dom/media/webspeech. r=pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D275661\n", "files": ["dom/media/webspeech/recognition/SpeechGrammar.h", "dom/media/webspeech/recognition/SpeechGrammarList.h", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionAlternative.h", "dom/media/webspeech/recognition/SpeechRecognitionResult.h", "dom/media/webspeech/recognition/SpeechRecognitionResultList.h", "dom/media/webspeech/recognition/SpeechTrackListener.h", "dom/media/webspeech/synth/SpeechSynthesis.h", "dom/media/webspeech/synth/SpeechSynthesisUtterance.h", "dom/media/webspeech/synth/SpeechSynthesisVoice.h", "dom/media/webspeech/synth/android/SpeechSynthesisService.h", "dom/media/webspeech/synth/cocoa/OSXSpeechSynthesizerService.h", "dom/media/webspeech/synth/ipc/SpeechSynthesisChild.h", "dom/media/webspeech/synth/ipc/SpeechSynthesisParent.h", "dom/media/webspeech/synth/nsSpeechTask.h", "dom/media/webspeech/synth/nsSynthVoiceRegistry.h", "dom/media/webspeech/synth/speechd/SpeechDispatcherService.h", "dom/media/webspeech/synth/test/nsFakeSynthServices.h", "dom/media/webspeech/synth/windows/SapiService.h"], "git_node": "f3de09235598d4210725061f38153dec8ca1ac5c", "git_parents": ["5abff8d3d975464142408d759e4150707f44e766"], "node": "b161ee94e6833219366e5a6bb526f33889a1854d", "parents": ["f4747bcbe2ee2b228742d003c11d082fda79052b"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Rename SpeechRecognitionError to SpeechRecognitionErrorEvent. r=media-playback-reviewers,webidl,alwu,smaug\n\nThe interface was renamed to SpeechRecognitionErrorEvent in the Web Speech\nAPI spec; align the Gecko interface, its binding, and the (now non-nullable)\nmessage attribute / required init members accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311102\n", "files": ["dom/events/SpeechRecognitionError.cpp", "dom/events/SpeechRecognitionError.h", "dom/events/SpeechRecognitionErrorEvent.cpp", "dom/events/SpeechRecognitionErrorEvent.h", "dom/events/moz.build", "dom/events/test/test_all_synthetic_events.html", "dom/media/webspeech/moz.build", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/webidl/SpeechRecognitionError.webidl", "dom/webidl/SpeechRecognitionErrorEvent.webidl", "dom/webidl/moz.build"], "git_node": "aab659ce832a00c2d8e7cc8ed4ff6384b83e4b06", "git_parents": ["f3de09235598d4210725061f38153dec8ca1ac5c"], "node": "a5abe06b3bd9843f0492e2663bcfcecc97705f6f", "parents": ["b161ee94e6833219366e5a6bb526f33889a1854d"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Stream audio in smaller blocks; implement chunked downmixing. r=media-playback-reviewers,alwu\n\nSend audio to the inference process in ~40ms blocks instead of 0.5s, so\nend-to-end latency is bounded by the streaming model (~180ms) rather than IPC\nbatching. Implement the chunked downmixing path in DataCallback (slice-wise,\nRT-safe) instead of crashing, and stop clearing the graph-thread scratch\nbuffer from the main thread in Stop() (a data race the lower latency exposed).\n\nCount the amount of frame dropped, increase ringbuffer depth to smooth\nover load spike events.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311103\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h"], "git_node": "cede31e69cb933eabeac4412747f7e17dfed27b4", "git_parents": ["aab659ce832a00c2d8e7cc8ed4ff6384b83e4b06"], "node": "53e21fa3cccbbeb899516ceb098538f9aa91425f", "parents": ["a5abe06b3bd9843f0492e2663bcfcecc97705f6f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Add a Parakeet end-to-end speech recognition bench test. r=media-playback-reviewers,alwu\n\nA development bench that drives the full local recognition pipeline: it plays\na 60s clip through a MediaStreamTrack into SpeechRecognition and compares the\ntranscript against a reference. It relies on a local CORS model server\n(testing/tools/serve_model.py) and bundled audio, so it is not wired for CI yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311105\n", "files": ["dom/media/webspeech/recognition/test/head.js", "dom/media/webspeech/recognition/test/kennedy-appolo.opus", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_parakeet_e2e.html", "testing/tools/serve_model.py"], "git_node": "6d87a66f6ad91c501f5525ddf15bce07fbfb3d7e", "git_parents": ["cede31e69cb933eabeac4412747f7e17dfed27b4"], "node": "6650833ea34ce6cfed03161ecdc8569b93485c53", "parents": ["53e21fa3cccbbeb899516ceb098538f9aa91425f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Test the multilingual (nemotron) streaming backend. r=media-playback-reviewers,alwu\n\nFeeds audio with lang=\"auto\" to route to nvidia/nemotron-3.5-asr-streaming-0.6b\nand exercise the larger prompt-conditioned model end-to-end: fd load, cache-aware\nstreaming, language resolution and inline \u003clang\u003e-tag stripping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311106\n", "files": ["dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_parakeet_multilingual.html"], "git_node": "e0178a87ad22a843b77baf6e63c9983a8e52a06a", "git_parents": ["6d87a66f6ad91c501f5525ddf15bce07fbfb3d7e"], "node": "1c42c02def21e513cf360907e0dea94d5d702272", "parents": ["6650833ea34ce6cfed03161ecdc8569b93485c53"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Expose a typed per-word drain in vendored parakeet.cpp. r=valentinp,media-playback-reviewers,ai-platform-reviewers,alwu\n\nparakeet-stream-words.patch adds parakeet_capi_stream_drain_words, returning the\nwords finalized each streaming step as {text, start, end, conf} structs so the\nhost gets per-word timing + confidence without parsing the JSON feed. Exposed\nthrough the runtime linker wrapper and mozinference.symbols.\n\nThe patch also finalizes the words an \u003cEOU\u003e closes instead of always withholding\nthe trailing word, which otherwise makes each utterance's last word lag until\nthe next utterance starts. That closed-word count is remembered across chunks:\nregroup_words() recomputes words_finalized_ per chunk, so a caller that feeds\nseveral chunks before draining would otherwise withhold an already-closed word\nagain and wait for the next utterance to emit a token.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311107\n", "files": ["config/external/mozinference/mozinference.symbols", "third_party/parakeet.cpp/include/parakeet_capi.h", "third_party/parakeet.cpp/moz.yaml", "third_party/parakeet.cpp/parakeet-stream-words.patch", "third_party/parakeet.cpp/src/parakeet_capi.cpp", "third_party/parakeet.cpp/src/streaming.cpp", "third_party/parakeet.cpp/src/streaming.hpp", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h"], "git_node": "6dd4292914349fb93738c2cb333af3c64f7bab40", "git_parents": ["e0178a87ad22a843b77baf6e63c9983a8e52a06a"], "node": "22caefe37cf532be68ba3fc6ed562c0a1229f410", "parents": ["1c42c02def21e513cf360907e0dea94d5d702272"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Test that an utterance's last word is delivered at \u003cEOU\u003e. r=media-playback-reviewers,alwu\n\npangrams.opus is two sentences separated by ~4s of silence. The test snapshots\nthe transcript inside that silence and checks it already ends in the first\nsentence's last word, rather than that word only surfacing once the second\nsentence starts being decoded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316066\n", "files": ["dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/pangrams.opus", "dom/media/webspeech/recognition/test/test_parakeet_eou_flush.html", "dom/media/webspeech/recognition/test/test_stop_returns_result_or_nomatch.html"], "git_node": "97a79c163a196b887dedf06105e88b02a236718c", "git_parents": ["6dd4292914349fb93738c2cb333af3c64f7bab40"], "node": "5f1db0126254904fe254adc5cd96e20ead5788e0", "parents": ["22caefe37cf532be68ba3fc6ed562c0a1229f410"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Test that stop() followed by abort() reports nothing. r=pehrsons\n\nCovers the abort() half of what this file already covers for stop(): a session\nthat gets both reports nothing but \"end\", including once the flush the stop()\nasked for has finished.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319178\n", "files": ["dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_stop_returns_result_or_nomatch.html"], "git_node": "e417fa4346aebd5f527ec48007ac32a02d6a83e9", "git_parents": ["97a79c163a196b887dedf06105e88b02a236718c"], "node": "3452467e2c220f52501d416a719881dda8eb700f", "parents": ["5f1db0126254904fe254adc5cd96e20ead5788e0"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Surface streaming recognition confidence to the DOM. r=media-playback-reviewers,alwu\n\nThe streaming backend drains per-word confidences and emits each step's words\nas one final result with the mean confidence, plumbed through\nOnRecognitionResult(transcript, isFinal, confidence) to SpeechRecognitionResult\nPer-word timestamps are kept internal, but are logged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311108\n", "files": ["dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/SpeechRecognitionChild.cpp", "dom/media/webspeech/recognition/SpeechRecognitionChild.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp"], "git_node": "2bc4726e6093dde8a8e14de08441a1ab3e66d450", "git_parents": ["e417fa4346aebd5f527ec48007ac32a02d6a83e9"], "node": "06a79cfa8831f10e27afa00f8b253ca33b1534da", "parents": ["3452467e2c220f52501d416a719881dda8eb700f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Surface recognition-result, speech-change, and audiostart event timing to the DOM. r=media-playback-reviewers,alwu\n\nThis will allow synchronizing recognition and sound tightly, possibly\nby delaying the audio a little bit.\n\nTimestamps are estimated from the actual audio capture position rather\nthan stamped at dispatch/processing time, to avoid folding buffering\nand recognition latency into the reported time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311109\n", "files": ["dom/media/webspeech/recognition/AudioCaptureTiming.h", "dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/SpeechRecognitionChild.cpp", "dom/media/webspeech/recognition/SpeechRecognitionChild.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "dom/media/webspeech/recognition/moz.build"], "git_node": "fe31a5b3e66207c57109db4233acbb300c21b603", "git_parents": ["2bc4726e6093dde8a8e14de08441a1ab3e66d450"], "node": "818efb029e12360dc92d51f52b769fb40100c7ed", "parents": ["06a79cfa8831f10e27afa00f8b253ca33b1534da"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Run the speech-recognition mochitests on CI. r=media-playback-reviewers,alwu\n\nA fetch manifest (static-url from the moz-model-hub bucket, the same pattern\nas the onnxruntime/wllama fetches) downloads the two streaming GGUFs into\nMOZ_FETCHES_DIR so the tests never hit the network. The local model-hub\nserver (serve_model.py) now resolves model requests by basename against\nMOZ_FETCHES_DIR / MOZ_ML_LOCAL_DIR, falling back to the source tree for dev,\nso a flat directory of fetched .gguf files satisfies ModelHub's nested\n\u003cmodelName\u003e/\u003crevision\u003e/\u003cfile\u003e path.\n\nruntests.py starts serve_model.py (bundled into the harness via\nTEST_HARNESS_FILES) when a test tagged 'parakeet-asr' runs, mirroring the\nwebsocketprocessbridge pattern, and stops it afterwards.\n\nThe parakeet tests move to their own 'speech-recognition' subsuite so the\nlarge GGUF model artifacts are fetched (via the parakeet-models fetch tasks)\nonly for this task rather than the whole media suite. Registers the suite in\nthe test resolver, defines the taskcluster task (loopback-video, model\nfetches), and registers it in mozharness.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311110\n", "files": ["taskcluster/kinds/fetch/kind.yml", "taskcluster/kinds/fetch/parakeet-models-fetch.yml", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/test-sets.yml", "testing/mochitest/moz.build", "testing/mochitest/runtests.py", "testing/mozbase/moztest/moztest/resolve.py", "testing/mozharness/configs/unittests/linux_unittest.py", "testing/mozharness/configs/unittests/mac_unittest.py", "testing/mozharness/configs/unittests/win_unittest.py", "testing/tools/serve_model.py"], "git_node": "7e32a3857a482948e9da0e60bf1a7c4d6f187b2c", "git_parents": ["fe31a5b3e66207c57109db4233acbb300c21b603"], "node": "98f0f5557b59cd357c68f31a6a54f2fc71a3b93c", "parents": ["818efb029e12360dc92d51f52b769fb40100c7ed"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Register a speech-recognition nsIMLModelResolver. r=media-playback-reviewers,alwu\n\nSpeechModelResolver expands a model id (from LanguagesToSpeechModelId) to its\nconcrete ModelHub artifact for HWInferenceParent's generic model-resolution\nlookup (@mozilla.org/ml/model-resolver;1?task=speech-recognition). Needed\nstarting with the next patch's RecvIsModelInstalled, which resolves ids\nthrough that lookup and does nothing useful without a registered resolver.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315355\n", "files": ["dom/media/webspeech/recognition/SpeechModelResolver.cpp", "dom/media/webspeech/recognition/SpeechModelResolver.h", "dom/media/webspeech/recognition/components.conf", "dom/media/webspeech/recognition/moz.build"], "git_node": "6ae7ad81504b6b8d1010aa2938002e7f31cb7910", "git_parents": ["7e32a3857a482948e9da0e60bf1a7c4d6f187b2c"], "node": "0c2f411b465c08494b6dcd17d3f9197e7dbb2a0f", "parents": ["98f0f5557b59cd357c68f31a6a54f2fc71a3b93c"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Show a permission prompt before downloading the speech recognition model. r=jib,media-playback-reviewers,permissions-reviewers,ai-platform-reviewers,alwu,timhuang,fluent-reviewers,bolsson,valentinp\n\nAdd a SpeechRecognitionModelDownloadPermissionPrompt shown before\nSpeechRecognition.install() downloads the model, skipping it when the\nmodel is already cached, and guard the install flow against the window\ndetaching mid-flight.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311113\n", "files": ["browser/components/permissions/ContentPermissionPrompt.sys.mjs", "browser/locales/en-US/browser/permissions.ftl", "browser/modules/PermissionUI.sys.mjs", "dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechModelDownloadPermissionRequest.cpp", "dom/media/webspeech/recognition/SpeechModelDownloadPermissionRequest.h", "dom/media/webspeech/recognition/SpeechModelResolver.cpp", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "dom/media/webspeech/recognition/moz.build", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_install_overlap.html", "extensions/permissions/PermissionDelegateHandler.cpp", "extensions/permissions/PermissionDelegateHandler.h", "testing/web-platform/tests/speech-api/SpeechRecognition-installOnDevice.https.html"], "git_node": "3c2e35b8cc1931257e8f3f9c687be46792299b81", "git_parents": ["6ae7ad81504b6b8d1010aa2938002e7f31cb7910"], "node": "d675db79d04f8fcc07a3b2382805aedee8e1b772", "parents": ["0c2f411b465c08494b6dcd17d3f9197e7dbb2a0f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Show model download progress in the speech recognition permission prompt. r=fluent-reviewers,desktop-theme-reviewers,ai-platform-reviewers,hjones,bolsson,valentinp,firefox-desktop-core-reviewers ,mossop\n\nOn-device speech recognition needs a model that may not be installed yet, and\nthe download is large enough that the user has to both consent to it and then be\nable to watch and cancel it. The goal here is for all of that to happen in the\npermission doorhanger the page's request already opened, instead of in some\nseparate piece of UI the user has to go find.\n\nAccepting the consent prompt opens a second popup notification that shows\nprogress, replacing the first. The two are distinct notifications\n(\"speech-recognition-model-download\" and\n\"speech-recognition-model-download-progress\") with their own actions, so the\nprogress UI gets a disabled OK plus a Cancel that aborts the transfer through\nthe new nsIMLModelHub.cancelDownload(), and nothing has to mutate a live prompt\nin place. Progress arrives on the \"ml-model-download-progress\" observer topic,\nfiltered by the per-download token the request carries. A completed download\ndismisses itself after five seconds; a failed one stays up until the user\nacknowledges it, since that is the only place the failure is reported.\n\nAn earlier version kept the consent prompt open and turned it into the progress\nUI, using a generic keepOpen action on PopupNotifications (D315354). Review\nfeedback on that patch pointed out that it breaks the doorhanger several ways at\nonce - escape no longer dismisses it, repeated clicks re-run the grant flow,\nnavigation can cancel an already-granted request, and the clickjacking security\ndelay is unaware of the UI transition - and that transitioning to a second\nnotification is both simpler and existing practice, as the addon installation\nprompt already does it. That mechanism is gone; this is that approach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315357\n", "files": ["browser/base/content/browser.xhtml", "browser/base/content/popup-notifications.inc.xhtml", "browser/base/content/test/permissions/browser.toml", "browser/base/content/test/permissions/browser_speech_recognition_model_download_prompt.js", "browser/locales/en-US/browser/permissions.ftl", "browser/modules/PermissionUI.sys.mjs", "browser/modules/test/browser/browser_PermissionUI.js", "browser/themes/shared/browser-shared.css", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "toolkit/components/ml/MLModelHubService.sys.mjs", "toolkit/components/ml/nsIMLModelHub.idl"], "git_node": "f1ba36529eb993fabb54a25a00daf87cbe27d083", "git_parents": ["3c2e35b8cc1931257e8f3f9c687be46792299b81"], "node": "040efbb923051b371b8da0ebf5d1eb9d20e8ef3c", "parents": ["d675db79d04f8fcc07a3b2382805aedee8e1b772"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Gate SpeechRecognition behind AI controls; add the Preferences UI toggle and the on-device-speech-recognition permission policy. r=nordzilla,fluent-reviewers,hjones,bolsson,mkaply,omc-reviewers,ai-platform-reviewers,jprickett\n\nAdds the Firefox AI Controls entry for on-device speech recognition: the\nbrowser.ai.control.speechRecognition pref, the Preferences UI toggle, and the\non-device-speech-recognition Permissions-Policy feature.\n\nThe pref is the source of truth. SpeechRecognition::Available(), install() and\nstart() read it directly (falling back to browser.ai.control.default when the\nvalue is \"default\") and refuse when it resolves to \"blocked\": available()\nreports \"unavailable\", install() and start() throw NotAllowedError. The\nPreferences UI reflects and writes the same pref, through\nSpeechRecognitionFeature, an AIFeature implementation whose block() and\nmakeAvailable() also delete the downloaded model, like every other AI feature.\n\nThe AIControls enterprise policy grows a SpeechRecognition key, so admins can\nblock the feature specifically and so the Default value is applied and locked on\nthe new pref like it is on every other AI feature pref. A locked pref keeps the\nvalue the policy gave it, so the mutators throw rather than silently failing,\nlike TranslationsFeature does. The StartupTelemetry and UITour AI-controls\nfeature lists cover it too.\n\ntest_ai_controls_gate.html covers the blocked path for all three entry points\nand checks that an unblocked call is stopped only by the next gate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311114\n", "files": ["browser/components/StartupTelemetry.sys.mjs", "browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js", "browser/components/preferences/OnDeviceModelManager.mjs", "browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/main.js", "browser/components/preferences/tests/aiFeatures/browser-srd.toml", "browser/components/preferences/tests/aiFeatures/browser.toml", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_speech_recognition.js", "browser/components/tests/unit/test_startupTelemetry_aiControlBlocking.js", "browser/components/uitour/UITour.sys.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognitionFeature.sys.mjs", "dom/media/webspeech/recognition/moz.build", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_ai_controls_gate.html", "dom/security/featurepolicy/FeaturePolicyUtils.cpp", "modules/libpref/init/all.js", "toolkit/components/ml/content/EngineProcess.sys.mjs", "toolkit/locales/en-US/toolkit/about/aboutAddons.ftl"], "git_node": "9f4272c1afff6cb7a87d0b7db898cdd2b2977e14", "git_parents": ["f1ba36529eb993fabb54a25a00daf87cbe27d083"], "node": "fa7c2c36c18687c0ff9e2892ffee1207192c602e", "parents": ["040efbb923051b371b8da0ebf5d1eb9d20e8ef3c"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Make SpeechRecognitionEvent.results required, per spec. r=media-playback-reviewers,webidl,alwu,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311115\n", "files": ["dom/webidl/SpeechRecognitionEvent.webidl"], "git_node": "3cec9d4c915dd08df9608209c0b425540f11c650", "git_parents": ["9f4272c1afff6cb7a87d0b7db898cdd2b2977e14"], "node": "27eea798e9055fe00e1446666f84e98e844d740c", "parents": ["fa7c2c36c18687c0ff9e2892ffee1207192c602e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Test that the HWInference process goes away with speech recognition. r=media-playback-reviewers,alwu\n\nbrowser_speech_recognition_process_lifetime.js covers the original bug (run a\nsession, close the tab, the process is gone), a live-but-idle\nSpeechRecognition object holding the process up, a static call releasing it\nonce it settles, and grace-period reuse.\n\nIt sits here rather than with the keep-alive code because it needs\nbrowser.ml.modelHub.testing, which does nothing until the in-process mock\nbelow it: without that, available() would hit the real ModelHub and start()\nwould try to fetch a real model.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315358\n", "files": ["dom/media/webspeech/recognition/moz.build", "dom/media/webspeech/recognition/test/browser.toml", "dom/media/webspeech/recognition/test/browser_speech_recognition_process_lifetime.js", "dom/media/webspeech/recognition/test/empty.html"], "git_node": "5b827ab56d3aa75af854f844921d6573ea19dbef", "git_parents": ["3cec9d4c915dd08df9608209c0b425540f11c650"], "node": "2b956adb2fa6af5235d819d8db79484705b5a748", "parents": ["27eea798e9055fe00e1446666f84e98e844d740c"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Enable Web Speech recognition web-platform-tests. r=media-playback-reviewers,alwu\n\nEnable media.webspeech.recognition.enable (plus the testing/mock prefs)\nfor the speech-api WPT directory and update the expectation metadata for\nthe now-passing recognition tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311117\n", "files": ["testing/web-platform/meta/speech-api/SpeechRecognition-availableOnDevice.https.html.ini", "testing/web-platform/meta/speech-api/SpeechRecognition-basics.https.html.ini", "testing/web-platform/meta/speech-api/SpeechRecognition-installOnDevice.https.html.ini", "testing/web-platform/meta/speech-api/SpeechRecognition-onerror.https.html.ini", "testing/web-platform/meta/speech-api/SpeechRecognition-onstart-onend.https.html.ini", "testing/web-platform/meta/speech-api/__dir__.ini", "testing/web-platform/meta/speech-api/idlharness.https.window.js.ini"], "git_node": "cb4802610459d4c664903ce4d2b3063f2565efa4", "git_parents": ["5b827ab56d3aa75af854f844921d6573ea19dbef"], "node": "beb3938be317928e3c12f4fd68471c1ee03b1b94", "parents": ["2b956adb2fa6af5235d819d8db79484705b5a748"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Add the unspokenPunctuation attribute to SpeechRecognition. r=media-playback-reviewers,webidl,alwu,smaug\n\nPer spec, unspokenPunctuation defaults to false; the value is stored for\nround-tripping but does not change recognition behaviour, since Gecko's\nrecognizer is LLM-based and only infers punctuation that was not spoken.\n\nSpec: https://webaudio.github.io/web-speech-api/#dom-speechrecognition-unspokenpunctuation\nWPT: covered by interfaces/speech-api.idl via idlharness.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311119\n", "files": ["dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/webidl/SpeechRecognition.webidl", "testing/web-platform/meta/speech-api/idlharness.https.window.js.ini"], "git_node": "59fc8f953803a10c39abbbee99b4e8f671752cab", "git_parents": ["cb4802610459d4c664903ce4d2b3063f2565efa4"], "node": "403b90ae2bbdac78d44dc87b03781ab07e989283", "parents": ["beb3938be317928e3c12f4fd68471c1ee03b1b94"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Test that available() reports the model as installed after a real install(). r=media-playback-reviewers,alwu\n\nExercises the genuine ModelHub/MLModelHubService path against the local\nmodel hub (serve_model.py) rather than the in-process mock, so the\ndownload and the subsequent cache check both go through real code.\n\nserve_model.py also gets verbose diagnostic logging, useful when a test\nfails because the model server couldn't resolve a file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311120\n", "files": ["dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_model_available_after_install.html", "testing/tools/serve_model.py"], "git_node": "73138bbd6f924259c5a719e80f6305c3b07f6a3f", "git_parents": ["59fc8f953803a10c39abbbee99b4e8f671752cab"], "node": "91084438f8f048d926d0e93d42258c7e14b12cdc", "parents": ["403b90ae2bbdac78d44dc87b03781ab07e989283"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Test that an aborted recognition does not leak the session slot. r=media-playback-reviewers,alwu\n\nBug XXXXXX - Fix start() implicit model download, spec-correct available(), docs, test fixes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311121\n", "files": ["dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_concurrent_session.html"], "git_node": "18a1924e535361d9babe0b6a46f7dd5caa96fd44", "git_parents": ["73138bbd6f924259c5a719e80f6305c3b07f6a3f"], "node": "3aa7f36dc009e3c489256b1ae5c520e4fbe61b4a", "parents": ["91084438f8f048d926d0e93d42258c7e14b12cdc"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Add speech recognition fuzz/interleaving and init/abort-race mochitests. r=media-playback-reviewers,alwu\n\nStress tests that fire overlapping available()/install()/start()/stop()/abort()\ncalls, including from iframes torn down mid-flight, using the in-process mock\nbackend. These found the two crashes fixed in the previous commit; they are\nnets for concurrency bugs in the IPC/session lifecycle, not targeted\nregression tests for a single issue.\n\ntest_fuzz_iframe_teardown.html surfaces a known-but-unfixed issue: a promise\nfrom a detached frame's available()/install() call can fail to ever settle. It\nis disabled in the manifest for now (it hangs), pending a fix.\n\nAlso add test_stress_init_abort_race.html, a targeted, deterministic\nregression test for a deadlock in SpeechRecognitionParent::ActorDestroy():\nit used to hold mLock across a blocking mRecognitionThread-\u003eShutdown() while\nInitializeParakeetContext() (running on that same thread) also acquires\nmLock during startup. A new testing-only pref,\nmedia.webspeech.recognition.testing.parakeet_init_delay_ms, delays thread\ninit so abort() reliably races ActorDestroy() against it.\n\nUses the shared head.js helpers createResumedAudioContext() (bounded, fails\nfast if resume() itself doesn't settle), AudioStreamAnalyser, and\nwaitForAudioFlowing() (fails fast instead of hanging on a downstream event\nthat will never fire), shared with the parakeet e2e/multilingual tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311122\n", "files": ["dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_fuzz_availability_install.html", "dom/media/webspeech/recognition/test/test_fuzz_iframe_teardown.html", "dom/media/webspeech/recognition/test/test_fuzz_session_lifecycle.html", "dom/media/webspeech/recognition/test/test_stress_init_abort_race.html"], "git_node": "feb06a7f8a7ad389c13e8c51a43e38d184299232", "git_parents": ["18a1924e535361d9babe0b6a46f7dd5caa96fd44"], "node": "a7a500ba2acff3b19b2d0ca53ccba97aed4ccd46", "parents": ["3aa7f36dc009e3c489256b1ae5c520e4fbe61b4a"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Add the (unplumbed) quality option to SpeechRecognitionOptions. r=media-playback-reviewers,webidl,alwu,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311125\n", "files": ["dom/webidl/SpeechRecognition.webidl"], "git_node": "ad45d0a68771f159b9fdfd8f49ead37b60a24fe6", "git_parents": ["feb06a7f8a7ad389c13e8c51a43e38d184299232"], "node": "217bf069d487f0f1d0563ca53fe9e66a310a2de2", "parents": ["a7a500ba2acff3b19b2d0ca53ccba97aed4ccd46"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Warn in the console when AI Controls block speech recognition. r=media-playback-reviewers,alwu\n\nWhen on-device speech recognition is turned off in AI Controls, the three\nentry points already refuse, but silently as far as the page author is\nconcerned: start() throws a NotAllowedError that reads like a permission\nproblem, and available() just says \"unavailable\". Point at the actual cause\nonce per document, in the web console.\n\ninstall() resolved a NotAllowedError rejection for this case, which made the\nAI Controls state observable as a distinct failure and differed from\navailable(). It now resolves false, like every other reason a model cannot be\ninstalled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321360\n", "files": ["dom/base/nsDocumentWarningList.inc", "dom/locales/en-US/chrome/dom/dom.properties", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/test/test_ai_controls_gate.html"], "git_node": "a3092f2cc52e27c0dc8de05d3aafe03a2051598a", "git_parents": ["ad45d0a68771f159b9fdfd8f49ead37b60a24fe6"], "node": "07a9ee2d38aa57e13f99b8e6c6046f0c61355de7", "parents": ["217bf069d487f0f1d0563ca53fe9e66a310a2de2"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Allow looking up per-file display info for on-device models in about:addons. r=extension-reviewers,ai-platform-reviewers,rpl,valentinp\n\nCurrently, about:addons relies on a specific way to organize ModelHub\nand also how Hugging Face works: ModelHub slugs mirror HuggingFace slugs\n(same `org/model`, a bit like on github).\n\nFor SpeechRecognition, it's a little bit different: we take multiple\nmodels that come from different Hugging Face pages from one Hugging Face\nrepo (https://huggingface.co/mudler/parakeet-cpp-gguf/). They are\nconversions of models from Nvidia. We'd like to link to the original\nrepo (that has much more informative info), and we also want better\nnames, so we'll be in a position to say \"Speech Recognition model\n(multilingual)\" instead of the inscrutable model name (with a link to go\nfurther for the nerds / interested people).\n\nThis is a simple idirection layer that any developer of a feature that\nuses AI models can use to display things better. For Speech Recognition,\nthe information comes from a small js module generated from a yaml. This\nyaml also generates some C++ for other things, so we can't risk being\nout of sync here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316337\n", "files": ["toolkit/components/ml/content/Utils.sys.mjs", "toolkit/mozapps/extensions/internal/ModelHubProvider.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_ModelHubProvider.js"], "git_node": "f464aed28371f072df221dff4b9fcb713a6e0df2", "git_parents": ["a3092f2cc52e27c0dc8de05d3aafe03a2051598a"], "node": "4e54da63cad0b780061640476f0d0d396d95dbee", "parents": ["07a9ee2d38aa57e13f99b8e6c6046f0c61355de7"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1940906, 2051973: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp"], "git_node": "ac064bd849441820a4a49c0b70679418c231292a", "git_parents": ["f464aed28371f072df221dff4b9fcb713a6e0df2"], "node": "04671bba8e6911391c55e8cebf1adedb4b276710", "parents": ["4e54da63cad0b780061640476f0d0d396d95dbee"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067372 - Preserve border around content area when in fullscreen mode if sidebar/toolbar present r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,hjones,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322284\n", "files": ["browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "1c83246b869f0dfbd596e05b1b7c4a6b2eaa2873", "git_parents": ["ac064bd849441820a4a49c0b70679418c231292a"], "node": "a6dae6e43cc81b686673fc4d9fdad9760e55ae49", "parents": ["04671bba8e6911391c55e8cebf1adedb4b276710"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050444 - Change sidebar width to 50x wide when vertical tabs are enabled in compact and standard UI densities to make room for scrollbar r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,dao\" on devs request\n\nThis reverts commit 16044b7719229e1eb680227b5296b27c3e881635.\n", "files": ["browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "5be3f0a01f1dd5a3bb08fb9edf68a5e52fea040e", "git_parents": ["1c83246b869f0dfbd596e05b1b7c4a6b2eaa2873"], "node": "8afbc9f4391693395fc9f1d9bea2ac6c51102c10", "parents": ["a6dae6e43cc81b686673fc4d9fdad9760e55ae49"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1970802 - Wait for the new tab to be reflowed in openNewForegroundTab, r=Gijs.\" for causing bc failures @ browser_fpp_protections_matrix_1.js & browser_ext_themes_ntp_colors_perwindow.js\n\nThis reverts commit 4529cc05b43a1c4cbb32da98fb1798fe29e00a21.\n", "files": ["testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "6f6988fecf1b533f5dae2afe67f24e12456cd3f8", "git_parents": ["5be3f0a01f1dd5a3bb08fb9edf68a5e52fea040e"], "node": "fea10eb098361aacd5426de8d258f519e9670a4a", "parents": ["8afbc9f4391693395fc9f1d9bea2ac6c51102c10"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Make parakeet.cpp/llama.cpp reproduce when re-vendored, and add it to that job.\n\nThe metal backend had drifted a little bit, and we made a couple\nunconsequential mistakes while vendoring. Bug 2068580 is a followup to\nclean this up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322902\n", "files": ["taskcluster/kinds/source-test/vendor-verify.yml", "third_party/llama.cpp/moz.yaml", "third_party/llama.cpp/run_parser.py", "third_party/parakeet.cpp/moz.yaml", "third_party/parakeet.cpp/parakeet-no-exceptions.patch"], "git_node": "51cea4cf34af9054eb0dc7e33b52227ee2976dc1", "git_parents": ["6f6988fecf1b533f5dae2afe67f24e12456cd3f8"], "node": "062036d9cd4d621a1896bfe0132aacb149ab5f79", "parents": ["fea10eb098361aacd5426de8d258f519e9670a4a"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Fix missing SpeechRecognitionModelDisplayInfo.sys.mjs in moz.build, breaking a test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322915\n", "files": ["dom/media/webspeech/recognition/moz.build"], "git_node": "4c60e2b51feba1b56c6c64a04dfc5f1e5bb11463", "git_parents": ["51cea4cf34af9054eb0dc7e33b52227ee2976dc1"], "node": "7a169d5827c2b38436923fede5e497a29539171d", "parents": ["062036d9cd4d621a1896bfe0132aacb149ab5f79"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Fix missing include in SpeechRecognitionBackend.h, breaking non-unified builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322916\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionBackend.h"], "git_node": "edb3940659acb32df07e3de10280f3f55813b03d", "git_parents": ["4c60e2b51feba1b56c6c64a04dfc5f1e5bb11463"], "node": "e24aef9aa4e894c643de90143a5efaaff7142c51", "parents": ["7a169d5827c2b38436923fede5e497a29539171d"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Added on-device-speech-recognition to supportedFeatures in test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322917\n", "files": ["dom/security/featurepolicy/test/mochitest/test_featureList.html"], "git_node": "8cbaa435ad92b3fbe83f3270d64a6a4bf2ac3cd4", "git_parents": ["edb3940659acb32df07e3de10280f3f55813b03d"], "node": "f1996b83eecd4e5e659640d4e81232d4aa9417b4", "parents": ["e24aef9aa4e894c643de90143a5efaaff7142c51"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2059673 - Move the JSON Lines helpers to a shared module r=devtools-reviewers,jdescottes\n\nparseJsonl() was a private function inside json-viewer.mjs, a page\nentry-point that renders React and reads the JSONView content global at\nload time, so nothing else could import it. JsonlLineError lived in\njsonview/, and the JSON Lines content types were spelled out inline in\nthe sniffer and twice in fixSave().\n\nThe Netmonitor needs all three (bug 2059673), so move them to\ndevtools/client/shared/jsonl-utils.mjs and have jsonview import from\nthere. JsonlLineError also gains a Symbol.for() brand and an isInstance()\nhelper, so consumers loading the module through a different global still\nrecognise its instances.\n\nThe only behaviour change: a line which fails to parse is reparsed\npreceded by the blank lines it comes after in the document, so that its\nerror message points at the line in the document rather than at line 1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320918\n", "files": ["devtools/client/jsonview/Sniffer.sys.mjs", "devtools/client/jsonview/components/JsonPanel.mjs", "devtools/client/jsonview/converter-child.js", "devtools/client/jsonview/json-viewer.mjs", "devtools/client/jsonview/jsonl-utils.mjs", "devtools/client/jsonview/moz.build", "devtools/client/shared/jsonl-mime-types.mjs", "devtools/client/shared/jsonl-utils.mjs", "devtools/client/shared/moz.build"], "git_node": "6470e8361a25b8c286fb00cb17df17bd4604d7b9", "git_parents": ["8cbaa435ad92b3fbe83f3270d64a6a4bf2ac3cd4"], "node": "690fdf7cbd973008e56069b9e526061d24bb5098", "parents": ["f1996b83eecd4e5e659640d4e81232d4aa9417b4"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2059673 - Display JSON Lines responses as a tree in the Netmonitor r=devtools-reviewers,fluent-reviewers,jdescottes,bolsson\n\nhandleJSONResponse() gates on /\\bjson/, which matches application/jsonl,\ntext/jsonl and application/jsonlines, so those responses were handed to\nparseJSON(), JSON.parse() choked on the second line and the panel reported\na SyntaxError for a perfectly valid document. application/x-ndjson has no\nword boundary before \"json\" and fell through to raw text entirely.\n\nDetect JSON Lines the same way the JSON Viewer's sniffer does - from the\ncontent type, or from a .jsonl file extension when the served type doesn't\nsay so - and parse it with the shared parseJsonl(), which yields one entry\nper non-blank line. PropertiesView renders those as independently\ncollapsible roots already; a line which isn't valid JSON is displayed\ninline as an error rather than hiding the rest of the document.\n\nAlso decode base64 payloads for application/vnd.mozilla.jsonlines.view,\nwhich the existing JSON Viewer check missed, and leave the raw view\nunhighlighted, since CodeMirror's JSON mode flags every line but the first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320919\n", "files": ["devtools/client/locales/en-US/netmonitor.properties", "devtools/client/netmonitor/src/assets/styles/NetworkDetailsBar.css", "devtools/client/netmonitor/src/components/request-details/PropertiesView.js", "devtools/client/netmonitor/src/components/request-details/ResponsePanel.js", "devtools/client/netmonitor/src/utils/request-utils.js", "devtools/client/netmonitor/test/browser_al.toml", "devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/netmonitor/test/browser_net_jsonl.js", "devtools/client/netmonitor/test/head.js", "devtools/client/netmonitor/test/html_jsonl-test-page.html", "devtools/client/netmonitor/test/jsonl_text_plain.jsonl", "devtools/client/netmonitor/test/jsonl_text_plain.jsonl^headers^", "devtools/client/netmonitor/test/sjs_content-type-test-server.sjs", "devtools/client/netmonitor/test/xpcshell/test_request-utils-parseJSONL.js", "devtools/client/netmonitor/test/xpcshell/xpcshell.toml", "devtools/client/webconsole/test/browser/_webconsole_network.toml", "devtools/client/webconsole/test/browser/browser_webconsole_network_messages_jsonl.js"], "git_node": "fbeca9f2f90eca8938dc1b102f4c9380e687e5ac", "git_parents": ["6470e8361a25b8c286fb00cb17df17bd4604d7b9"], "node": "1d1782909343c017999d96601093831cf9f625c7", "parents": ["690fdf7cbd973008e56069b9e526061d24bb5098"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2059673 - Display JSON Lines request payloads as a tree in the Netmonitor r=devtools-reviewers,jdescottes\n\nThe Request panel detects JSON by parsing the payload, so a JSON Lines\nbody fell through to the raw view. Read the payload's own Content-Type\nheader - request.mimeType describes the response - and parse it with\nparseJsonl() when it is JSON Lines. Entries keep their document order,\nso unlike the JSON case they are not sorted.\n\nThe request headers are now fetched alongside the post data, so the\ncontent type is available on the first render rather than only once\nupdateFormDataSections() happens to have retrieved them.\n\nPayload parsing moves out of render() into parseStructuredPayload(),\nwhich keeps render() under the complexity limit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320920\n", "files": ["devtools/client/netmonitor/src/components/request-details/RequestPanel.js", "devtools/client/netmonitor/test/browser_al.toml", "devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/netmonitor/test/browser_net_jsonl-request.js", "devtools/client/netmonitor/test/head.js", "devtools/client/netmonitor/test/html_jsonl-post-test-page.html"], "git_node": "bb162087c4e43a6f67b62116ecd231bc547cc6ff", "git_parents": ["fbeca9f2f90eca8938dc1b102f4c9380e687e5ac"], "node": "b5d2b229d6bb0c78a340129a37bf15c2fecaeccc", "parents": ["1d1782909343c017999d96601093831cf9f625c7"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2059673 - Display JSON Lines message payloads as a tree in the Netmonitor r=devtools-reviewers,jdescottes\n\nWebSocket and server-sent-event frames carry no content type, so the\npayload has to be recognized from its shape - which is how every other\nformat in this file is detected. The check runs after the plain JSON one,\nso a pretty-printed JSON object is unaffected, and it requires every\nnon-blank line to parse as a JSON object or array. parseJSON rejects\nprimitives, so a frame such as \"1\\n2\\n3\" stays raw text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320921\n", "files": ["devtools/client/netmonitor/src/components/messages/MessagePayload.js", "devtools/client/netmonitor/test/websockets/browser.toml", "devtools/client/netmonitor/test/websockets/browser_net_ws-jsonl-payload.js"], "git_node": "9f5698bf59bcc60d2a6a9af0e7154c71da98f015", "git_parents": ["bb162087c4e43a6f67b62116ecd231bc547cc6ff"], "node": "15d2a89572e723b8e27f56f515754ef0d4a7acfc", "parents": ["b5d2b229d6bb0c78a340129a37bf15c2fecaeccc"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2059673 - Document JSON Lines support in the Netmonitor r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320923\n", "files": ["devtools/docs/user/network_monitor/inspecting_web_sockets/index.md", "devtools/docs/user/network_monitor/request_details/index.md"], "git_node": "6da384f313f3f9149c6aef3dc539aa552df9f3f8", "git_parents": ["9f5698bf59bcc60d2a6a9af0e7154c71da98f015"], "node": "86cd581cc72ecb9c4948f547e66f4f73d359ae82", "parents": ["15d2a89572e723b8e27f56f515754ef0d4a7acfc"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068240 - Make mForm a RefPtr. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322736\n", "files": ["dom/html/HTMLImageElement.cpp", "dom/html/HTMLImageElement.h", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h"], "git_node": "941f8dfa521676beb6e5c040795ccaea8222624e", "git_parents": ["6da384f313f3f9149c6aef3dc539aa552df9f3f8"], "node": "cc463b5af471b3b13100ecd84e258e69b9973da9", "parents": ["86cd581cc72ecb9c4948f547e66f4f73d359ae82"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068556 - Correct four things the documentation skill gets wrong about docs-only changes. r=ai4dev-reviewers,padenot DONTBUILD\n\nVerified in-tree rather than taken from the skill: `conf.py` passes the whole `js_source_paths` list to sphinx-js regardless of the build's scope, the categorization check compares tree indexes and only on a full build, and a bare `mach lint` over a docs directory exits non-zero with three linter failures and an assertion out of mozlint's roller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322888\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "4d0e4a9c547a4efee33bf194ec7f5b9f2f35b6c2", "git_parents": ["941f8dfa521676beb6e5c040795ccaea8222624e"], "node": "04ca9f30328d010b751d97f1944ffc443c2d6da3", "parents": ["cc463b5af471b3b13100ecd84e258e69b9973da9"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051869 - Add code comment to EncryptingOutputStream_impl.h to explain why this change was needed. r=jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309775\n", "files": ["dom/quota/EncryptingOutputStream_impl.h"], "git_node": "39ae34946d30a146dae88bb0a18cb180eac06892", "git_parents": ["4d0e4a9c547a4efee33bf194ec7f5b9f2f35b6c2"], "node": "c3242b1053f71518932a5f3422d31f70bb6a98f4", "parents": ["04ca9f30328d010b751d97f1944ffc443c2d6da3"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055283 - set EPP to performance for speedometer 3 tests on Linux. r=perftest-reviewers,sparky\n\nsp3 scores vary a lot right now on linux test machines, even with the\nsame code and configuration. (we found a lot of intermachine variance)\n\nThe default power profile sets the CPU's energy performance pref (EPP)\nto balance_performance, this causes to machine sustain different clock\nspeeds, and the likely culprit here.\n\nin this default state the hardware p states (HWP) seem to favour more\nvaried clock speeds. However by setting the EPP to perf, this informs\nthe HWP to bias towards the ceiling if possible.\n\nThis patch adds a --power-profile option that sets the\npower-profiles-daemon to performance for the duration of the sp3 run.\n\nThis seems to remove a significant amount of the variance without having\nto touch the CPU governor or frequency floor/ceilings. This allows the\nHWP to still downclock if needed rather than always operate at max\nperformance.\n\nA follow up bug will look at the impact on other linux performance\ntests. (bug 2067941)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322448\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/mozharness/mozharness/mozilla/testing/raptor.py"], "git_node": "20ef6f9fb34b74f96c80f8439cdab30e72d42239", "git_parents": ["39ae34946d30a146dae88bb0a18cb180eac06892"], "node": "0057d725bcc5e49f1c2508c93fac3f396286bb61", "parents": ["c3242b1053f71518932a5f3422d31f70bb6a98f4"], "tags": []}, {"author": "Alan Liu \u003chaoping.liu@amd.com\u003e", "branch": "default", "desc": "Bug 2011821 - Avoid per-frame texture create/release during direct scanout by locking without a GL context r=gfx-reviewers,lsalzman,stransky\n\nRenderCompositorNativeOGL::AttachExternalImage() unconditionally called\nimage-\u003eLock(0, mGL), which forces RenderDMABUFTextureHost::Lock to\nimport the decoded buffer as an EGLImage and map the BO into GPU VA,\nthen release it the next frame -- two operations per frame.  Under\ndirect scanout the frame goes straight to an overlay plane and this\ntexture is never sampled, so the work is pure overhead.\n\nLock without a context when the host is a RenderDMABUFTextureHost, which\nthen returns size-only metadata instead of creating a texture. Every\nother backend still needs a real context (e.g.\nRenderMacIOSurfaceTextureHost). RenderTextureHostWrapper already\nforwards the accessor, so remote-decoded video is covered.\n\nIf direct scanout falls back to GPU composition, draw_frame re-Locks the host\nwith a real GL context, so the texture is still created when it is needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319435\n", "files": ["gfx/webrender_bindings/RenderCompositorNative.cpp"], "git_node": "a3dd8a3a3d8a529e2c67ad63c7dac715fd21c189", "git_parents": ["20ef6f9fb34b74f96c80f8439cdab30e72d42239"], "node": "ce1788c8fea83bde9a95521154769554a903a79c", "parents": ["0057d725bcc5e49f1c2508c93fac3f396286bb61"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068109 - Follow-up: document the parent controller's type on its getter. r=mbeier,urlbar-reviewers\n\njsdoc drops the `#` from a private field, so documenting both the field and the same-named getter leaves two documented objects at `UrlbarChildController#parentController`, and sphinx-js aborts on that before any page renders -- taking down `./mach doc` for the whole tree, not just this component. The field's type comes back from the constructor assignment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322908\n", "files": ["browser/components/urlbar/content/UrlbarChildController.mjs"], "git_node": "b790041fcd94287739e1e8407ec61cc13ec6f6fd", "git_parents": ["a3dd8a3a3d8a529e2c67ad63c7dac715fd21c189"], "node": "f85e98a5e85cfd2abd22f69400c0a3f7b8e1b14f", "parents": ["ce1788c8fea83bde9a95521154769554a903a79c"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058062 - Don't use Mac native fullscreen for the Library window. r=Standard8,places-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321883\n", "files": ["browser/components/places/content/places.xhtml"], "git_node": "bcf64db49d6902fb4e467c488865797408c9d12f", "git_parents": ["b790041fcd94287739e1e8407ec61cc13ec6f6fd"], "node": "a62938eb1762e1e23e9bd120b74c113d9698ac5f", "parents": ["f85e98a5e85cfd2abd22f69400c0a3f7b8e1b14f"], "tags": []}, {"author": "Nora Liu \u003cnliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1934274 - Remove ParserSharedBase into ParserBase r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322697\n", "files": ["js/src/frontend/EitherParser.h", "js/src/frontend/ParseNode.h", "js/src/frontend/Parser.cpp", "js/src/frontend/Parser.h"], "git_node": "09ed653b2181fd10d601144ea1e5ecea66ce937f", "git_parents": ["bcf64db49d6902fb4e467c488865797408c9d12f"], "node": "bd39a5d0ce522f78f34bebaabf4c57e2dd5949d4", "parents": ["a62938eb1762e1e23e9bd120b74c113d9698ac5f"], "tags": []}, {"author": "Alexander Gankov \u003cgankovalexander@gmail.com\u003e", "branch": "default", "desc": "Bug 2033184 - Fix collapsed border painting on continuation pages. r=layout-reviewers,emilio\n\nThree separate defects made a border-collapsed table lose borders when printed across pages:\n\n- SetDamageArea() used nsTableRowFrame::GetNextRow(), which continues into the row group's next-in-flow, so the damage area was a row longer than the page and the iterator ended before the position where accumulated  block-direction segments are flushed.\n- IsAfterRepeatedHeader() could never fire, so those segments were not restarted below a repeated header and kept the header's border width.\n- BCInlineDirSeg::mAjaCell resolved to the repeated header cell, so the border below it was painted in that cell's style.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322236\n", "files": ["layout/tables/nsTableFrame.cpp", "testing/web-platform/tests/css/css-tables/collapsed-border-fragmentation-001-print-ref.html", "testing/web-platform/tests/css/css-tables/collapsed-border-fragmentation-001-print.html", "testing/web-platform/tests/css/css-tables/collapsed-border-fragmentation-002-print-ref.html", "testing/web-platform/tests/css/css-tables/collapsed-border-fragmentation-002-print.html"], "git_node": "aa2aaac5defa417312dfa80991872e531639fa10", "git_parents": ["09ed653b2181fd10d601144ea1e5ecea66ce937f"], "node": "4b3c7d84b228349f2625795aab3f1478bad528b6", "parents": ["bd39a5d0ce522f78f34bebaabf4c57e2dd5949d4"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058441 - P1. Support migrating addresses to the Rust store and serving them from it r=joschmidt,credential-management-reviewers,niklas\n\nWith the pref on, copy the profile's addresses into the Rust store, check field\nby field that they survived, and serve them from there. Off by default, so this\nchanges nothing yet.\n\nThe prefs:\n - rust.enabled is the intent, watched rather than only read at startup\n - rust.active is where the addresses actually are, set by Firefox once a copy\n   has completed. Sync reads it to choose between its two address engines\n - rust.runMigrationTest runs the copy only to measure it and then wipes it,\n   recorded on its own generation counter so it cannot be mistaken for the real\n   thing\n - rust.migrationAttempts bounds the retries\n\nFlipping rust.enabled copies the addresses out of the store that is serving them\ninto the one it now asks for, and hands the profile over once that copy is\ncomplete -- either direction, which is why the copy is written against a source\nand a target. The source wins, so the target also loses what the source no longer\nholds: a record deleted while the other store was serving must not reappear when\nthe profile switches. Switches queue behind each other and behind startup's own,\nand none of them empties what it finds, so a copy that fails leaves both stores\nas they were.\n\nTwo things it cannot do. It cannot close the window where a write lands in the\nstore still serving, after that store has been read. And it cannot carry the\ndeletions the Rust store has not yet uploaded, since nothing in its API\nenumerates tombstones -- the records are still gone from JSON afterwards, and\nJSON leaves its own tombstone for anything it had synced, so the exposure is a\ndelete-and-switch inside one session, which can come back on the next sync.\n\nThe copy already had to read every record back to count them, so it diffs them\ntoo, over the fields it carries: the canonical ones and the metadata. Fields a\nstore derives on read are left out, since a derivation can differ without the\ncopy having lost anything. What remains is reported and counted, and does not\nhold the profile back; enabling Rust is the decision to switch.\n\nProfilesParent sized the delete-profile summary from addresses._data.length, and\ngetAddresses() answers with the Rust adapter once a profile has migrated, which\nhas no _data. It counts through getAll() instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315622\n", "files": ["browser/components/profiles/ProfilesParent.sys.mjs", "modules/libpref/init/all.js", "toolkit/components/formautofill/AddressStorageMigrator.sys.mjs", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/RustAutofillAddressStorage.sys.mjs", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/components/formautofill/default/FormAutofillStorage.sys.mjs", "toolkit/components/formautofill/metrics.yaml"], "git_node": "cf238de472f551a5fdc1ef971da28294bee828dc", "git_parents": ["aa2aaac5defa417312dfa80991872e531639fa10"], "node": "6e822b59e0def41bf4fb4f759f4672528b594a9d", "parents": ["4b3c7d84b228349f2625795aab3f1478bad528b6"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058441 - P2. Test the address migration r=joschmidt,credential-management-reviewers\n\ntest/unit/test_rust_autofill_address_migration.js -- the migrator and the\nswitch:\n - the copy, both directions and both modes: guids, timestamps and sync\n   metadata carried across, an empty profile, records the target already holds,\n   records the source no longer has, tombstones\n - the verdict: records rejected, records missing afterwards, records the target\n   still holds that the source deleted. Each leaves the profile reading from the\n   store that still has everything\n - the retry budget: counted per failed launch, given up on, cleared by success\n - the dry run: measured, wiped, recorded on its own generation counter,\n   deferred while the other store is serving\n - the divergence reporting, and what is deliberately not compared: fields the\n   target derives on read or has no column for\n - the switch: the pref observer, one flip queued behind another, a failed\n   switch that must not disable the next, and startup settling all four\n   combinations of enabled and active\n\ntest/unit/test_rust_autofill_address_parity.js -- field-level parity over an\nawkward corpus (unicode, CJK, RTL, emoji, SQL metacharacters, newlines, long\nvalues, minimal records), copied once and compared field by field. The stores\nnormalise differently, and this is where they would part company.\n\ntest/browser/rust/browser_address_migration.js -- the read path, which xpcshell\ncannot reach: both stores go through the same AddressRecord.computeFields, so\nthey agree even when the recompute is wrong.\n - a real form filled from a record the migration copied\n - an address captured through the doorhanger straight after a switch\n - a profile taken the whole way round: saved and edited under JSON, switched\n   over, edited again, switched back, with the records and the telemetry checked\n   at each stop\n\nThe suite that last file lives in runs with the pref on, and its head.js asserts\nthe backend actually switched, since a migration that quietly fell back to JSON\nwould let everything below it pass while proving nothing.\n\nAddresses only: credit cards are not copied into Rust.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314681\n", "files": ["browser/extensions/formautofill/moz.build", "browser/extensions/formautofill/test/browser/rust/browser.toml", "browser/extensions/formautofill/test/browser/rust/browser_address_migration.js", "browser/extensions/formautofill/test/browser/rust/head.js", "browser/extensions/formautofill/test/browser/rust/head_address.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_migration.js", "browser/extensions/formautofill/test/unit/test_rust_autofill_address_parity.js", "browser/extensions/formautofill/test/unit/xpcshell.toml"], "git_node": "0b96f67b14ca42d8ab13b7eec1b3df964dc1c0b6", "git_parents": ["cf238de472f551a5fdc1ef971da28294bee828dc"], "node": "68b313991c5624cc064d8bdd92101e26b3f1cb23", "parents": ["6e822b59e0def41bf4fb4f759f4672528b594a9d"], "tags": []}, {"author": "@Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061059: Style SFF autocomplete row item r=omarg,fluent-reviewers,desktop-theme-reviewers,credential-management-reviewers,mkennedy,hjones,bolsson,mtigley\n\n- Update the SFF autocomplete with its Figma style\n- Make the summary pills (when we have more than 2 sources) and the edit button clickable and focusable via keyboard\n- Add a aria-label that changes depending on the status of the SFF trigger status (loading/fill/not able to find sources) - this is needed because the content from the richlistitem is not visible to screen readers (per my understanding)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318806\n", "files": ["browser/components/aiwindow/ui/assets/sff-autofill-icon.svg", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/extensions/formautofill/test/browser/browser_autocomplete_footer.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/autocomplete.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.mjs", "toolkit/components/satchel/test/browser/browser_autocomplete.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "df773d5dde4cedc3a1317851955c81af81dcd7ad", "git_parents": ["0b96f67b14ca42d8ab13b7eec1b3df964dc1c0b6"], "node": "282b9f83557f68ee172561f64479f3598f25c9cb", "parents": ["68b313991c5624cc064d8bdd92101e26b3f1cb23"], "tags": []}, {"author": "@Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061358: Update styling for edit sources dialog for SFF r=omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320505\n", "files": ["browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "toolkit/content/widgets/moz-box-item/moz-box-item.css"], "git_node": "4361a6c7d78a9816a7a70f9477df5c2101a9116a", "git_parents": ["df773d5dde4cedc3a1317851955c81af81dcd7ad"], "node": "81d1b8b4cb34cc6da0bffb39de48dfd1d7dee2ed", "parents": ["282b9f83557f68ee172561f64479f3598f25c9cb"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067531: Add two Windows App SDK DLLs to the Firefox packager r=glandium,win-reviewers,sylvestre,gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322798\n", "files": ["browser/installer/package-manifest.in", "taskcluster/scripts/misc/build-WindowsAppSDK.sh", "toolkit/content/license.html", "widget/windows/moz.build"], "git_node": "450c828452dd7b7c1a73eb2a69718634291680fc", "git_parents": ["4361a6c7d78a9816a7a70f9477df5c2101a9116a"], "node": "b12503b7ec7e315cf0d485c9f5c87d96c1a4d081", "parents": ["81d1b8b4cb34cc6da0bffb39de48dfd1d7dee2ed"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067490 - Ensure MFTEncoder::Destroy calls mFactory's Shutdown() when appropriate. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322115\n", "files": ["dom/media/platforms/wmf/MFTEncoder.cpp"], "git_node": "457afd8569287324851a1b297b79826931f48bdd", "git_parents": ["450c828452dd7b7c1a73eb2a69718634291680fc"], "node": "0fa69f9ff9187f4afdc0d5732a1226f16e2ddba7", "parents": ["b12503b7ec7e315cf0d485c9f5c87d96c1a4d081"], "tags": []}, {"author": "Louis-Philippe \u003clpmanette@omnicesoft.com\u003e", "branch": "default", "desc": "Bug 2066333 - [Wayland][HDR] 10bit SDR video are rendered with oversaturated colors in compositor HDR mode. r=stransky,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321447\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h", "widget/gtk/nsWaylandDisplay.cpp", "widget/gtk/nsWaylandDisplay.h"], "git_node": "c2527ae2ebb72d8c78b2161e3923453eeca32e2e", "git_parents": ["457afd8569287324851a1b297b79826931f48bdd"], "node": "0dc35f5450716c7e770b0bbd498ecdf832253e2e", "parents": ["0fa69f9ff9187f4afdc0d5732a1226f16e2ddba7"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068240 - Make mForm a RefPtr. r=dom-core-reviewers,smaug\" for causing assertion failures in crashtest/mochitest/reftests\n\nThis reverts commit 941f8dfa521676beb6e5c040795ccaea8222624e.\n", "files": ["dom/html/HTMLImageElement.cpp", "dom/html/HTMLImageElement.h", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h"], "git_node": "909e13f6dd17cfa9dfd217cc61a2269c64378579", "git_parents": ["c2527ae2ebb72d8c78b2161e3923453eeca32e2e"], "node": "9afc778e8e1cb4535a1fd7ccd315c2e1ded5feab", "parents": ["0dc35f5450716c7e770b0bbd498ecdf832253e2e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1940906 - Don't start the parakeet model server for junit tests.\n\nWe haven't enabled SpeechRecognition on mobile yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322949\n", "files": ["testing/mochitest/runjunit.py"], "git_node": "6b319d3a89ec1783f27a24e31e53877c30dd4e5d", "git_parents": ["909e13f6dd17cfa9dfd217cc61a2269c64378579"], "node": "960ac7f60e12fd0373ad8f7589bb9a7db53c8f51", "parents": ["9afc778e8e1cb4535a1fd7ccd315c2e1ded5feab"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067114 [wpt PR 62232] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=322009, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=322009 (#62232)\n--\n\nwpt-commits: 32e9879045d3231fb45d1ea479aeed00888f7117\nwpt-pr: 62232\n", "files": ["testing/web-platform/tests/scroll-animations/css/timeline-offset-keyframes-zero-length-attachment-range.html"], "git_node": "92a1cbd169806cdc7d82cedb8e8894dc18882c2f", "git_parents": ["6b319d3a89ec1783f27a24e31e53877c30dd4e5d"], "node": "0119cd42a61fa16a04fd93669e1fdf666b85cbea", "parents": ["960ac7f60e12fd0373ad8f7589bb9a7db53c8f51"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067114 [wpt PR 62232] - Update wpt metadata, a=testonly\n\nwpt-pr: 62232\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/scroll-animations/css/timeline-offset-keyframes-zero-length-attachment-range.html.ini"], "git_node": "0bf8b4f6d068e8a6acd99a2cf5b0507162ebb69d", "git_parents": ["92a1cbd169806cdc7d82cedb8e8894dc18882c2f"], "node": "150f093a2399da35180b517c898f0319c83f8fbf", "parents": ["0119cd42a61fa16a04fd93669e1fdf666b85cbea"], "tags": []}, {"author": "Michael Reeves \u003cmichael.reeves077@gmail.com\u003e", "branch": "default", "desc": "Bug 2062868 [wpt PR 61876] - Blink: Support FontFace width as a stretch alias, a=testonly\n\nAutomatic update from web-platform-tests\nBlink: Support FontFace width as a stretch alias\n\nCSS Font Loading defines width as the current FontFace descriptor and\nretains stretch as a legacy alias. Chromium ignores the width\nconstructor member, causing the width descriptor aliasing WPT to fail.\n\nExpose FontFace.width through the existing stretch implementation and\nprefer the width dictionary member when both aliases are supplied.\nRemove the test expectation now that the WPT passes.\n\nUpdate Blink and Android WebView WebExposed baselines for the new getter\nand setter.\n\nIntent to Ship: https://groups.google.com/a/chromium.org/g/blink-dev/c/g8p87CZDeIg\n\nSpec: https://github.com/w3c/csswg-drafts/pull/14197\nBug: 543938492\nChange-Id: Ide837b25f9a693d2dc50adb34b5b4b468c3ee8a2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8219972\nReviewed-by: Chris Harrelson \u003cchrishtr@chromium.org\u003e\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: Dominik R\u00f6ttsches \u003cdrott@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1687081}\n\n--\n\nwpt-commits: 2df10fc9404cfdaf0dc6d53bb9f481fccc135176\nwpt-pr: 61876\n", "files": ["testing/web-platform/tests/css/css-font-loading/fontface-css-connected-descriptors.html", "testing/web-platform/tests/css/css-font-loading/fontface-width.html", "testing/web-platform/tests/css/css-fonts/parsing/font-face-width.html"], "git_node": "9e9e8b5b192516f3819a5e8ea66b32233adef285", "git_parents": ["0bf8b4f6d068e8a6acd99a2cf5b0507162ebb69d"], "node": "166b711f58ee3eab556086907bfd21ab46481c3d", "parents": ["150f093a2399da35180b517c898f0319c83f8fbf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062868 [wpt PR 61876] - Update wpt metadata, a=testonly\n\nwpt-pr: 61876\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-font-loading/fontface-css-connected-descriptors.html.ini", "testing/web-platform/meta/css/css-font-loading/fontfaceset-loading-worker-crash.html.ini", "testing/web-platform/meta/css/css-fonts/parsing/font-face-width.html.ini"], "git_node": "0ec3ed8400620af185fd52f4ffc0ec5ab8c207f0", "git_parents": ["9e9e8b5b192516f3819a5e8ea66b32233adef285"], "node": "2bf8e6e67d176a4117fd39a2deb6f103d0c9d735", "parents": ["166b711f58ee3eab556086907bfd21ab46481c3d"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2064916 [wpt PR 62070] - [Interop 2026] Use auto as the default ViewTimeline inset, a=testonly\n\nAutomatic update from web-platform-tests\n[Interop 2026] Use auto as the default ViewTimeline inset (#62070)\n\nThe ViewTimelineOptions inset member defaults to auto, so a timeline\nconstructed without an explicit inset uses its source's scroll-padding\nvalues. Blink instead defaulted the member to an empty sequence,\nproducing zero insets.\n\nUse the specified default and reject explicitly empty inset sequences.\nThis makes view-timeline-snapport.html pass and adds coverage for the\nempty-sequence case.\n\nR=flackr@chromium.org, kevers@chromium.org\n\nBug: 536954612\nChange-Id: I168421ba439ee81905cc76e6bf1ef37a04a856ff\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8264235\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCommit-Queue: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683172}\n\nCo-authored-by: Michael Reeves \u003cmichael.reeves077@gmail.com\u003e\n--\n\nwpt-commits: 552e3e862f3f966bb44d0300261b8a746a7e1ec0\nwpt-pr: 62070\n", "files": ["testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-inset.html"], "git_node": "a3c1dc0286afb5b6c4d5c675e4aabf03309abd43", "git_parents": ["0ec3ed8400620af185fd52f4ffc0ec5ab8c207f0"], "node": "791db96c347d8f5c3e1e72d31ccc04f6b256ba85", "parents": ["2bf8e6e67d176a4117fd39a2deb6f103d0c9d735"], "tags": []}, {"author": "chicoxyzzy \u003cchi187@gmail.com\u003e", "branch": "default", "desc": "Bug 2065372 [wpt PR 62092] - [wasm] Await TestSandwich in js-promise-integration, a=testonly\n\nAutomatic update from web-platform-tests\n[wasm] Await TestSandwich in js-promise-integration\n\nThe sandwich promise_tests call async TestSandwich() and discard the\npromise. testharness can treat the test as done while JSPI is still\nsuspended; a later assertion or exception becomes an unhandled\nrejection instead of a test FAIL.\n\nAwait the helper so the tests wait for resume.\n\n--\n\nwpt-commits: c8cdfdcc20b0ec22cfde6dfa518d48eae384fa78\nwpt-pr: 62092\n", "files": ["testing/web-platform/tests/wasm/jsapi/jspi/js-promise-integration.any.js"], "git_node": "2a7d92ba6fce19917e363ec392ad338b30c17bc5", "git_parents": ["a3c1dc0286afb5b6c4d5c675e4aabf03309abd43"], "node": "c51c0c6009666e6283a4e1d1dab2939ef1334688", "parents": ["791db96c347d8f5c3e1e72d31ccc04f6b256ba85"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2065694 [wpt PR 62110] - Revert \"Fix rtp sender max bitrate\", a=testonly\n\nAutomatic update from web-platform-tests\nRevert \"Fix rtp sender max bitrate\" (#62110)\n\nThis reverts commit 5207e12e48669e9f2a924cc77d51bcaf57efbedf.\nwhich breaks Discord and Jitsi Meet\n\nBug: chromium:550232520\nChange-Id: I2b0e96dc7d87821985ba3f97285aaf5a3a685517\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8278929\nCommit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\nReviewed-by: Guido Urdaneta \u003cguidou@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1683804}\n\nCo-authored-by: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n--\n\nwpt-commits: 8b65e8a5e2f60cf9d8c730480565b6eb9d70ff63\nwpt-pr: 62110\n", "files": ["testing/web-platform/tests/webrtc/RTCPeerConnection-addTransceiver.https.html", "testing/web-platform/tests/webrtc/RTCRtpSender-setParameters.html"], "git_node": "0f810f1a44b7f74aee92399f59eadd6764a8f3ee", "git_parents": ["2a7d92ba6fce19917e363ec392ad338b30c17bc5"], "node": "cedead819b8164e3d75c94e870fc79d27d8e2997", "parents": ["c51c0c6009666e6283a4e1d1dab2939ef1334688"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2066221 [wpt PR 62178] - [Interop 2026] Gate relative animation range unit rejection, a=testonly\n\nAutomatic update from web-platform-tests\n[Interop 2026] Gate relative animation range unit rejection (#62178)\n\nWeb Animations does not define the element context or timing needed to\nresolve relative lengths in rangeStart or rangeEnd. CSSWG resolved that\nstring and Typed OM inputs accept only absolute lengths and percentages\nuntil an evaluation model is specified.\n\nBlink has accepted relative lengths for some time, so changing this\nbehavior directly could break sites. Gate standards-compliant rejection\nbehind an experimental runtime feature, preserve legacy behavior\notherwise, and record whether affected inputs are accepted or rejected.\nThis lets WPT exercise the new behavior while compatibility data is\ncollected before it is enabled by default.\n\nValidate both input forms consistently, accept absolute Typed OM lengths,\nremove obsolete WPT baselines, expand WPT coverage, and add unit coverage\nfor both runtime-feature states and histogram outcomes.\n\nCSSWG resolution:\nhttps://github.com/w3c/csswg-drafts/issues/13853\n\nBug: 546237331\nChange-Id: Ifa11dcb9977ea52c55e18c265a5b6c2b0f8ef8d4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8255374\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCommit-Queue: Nicol\u00e1s Pe\u00f1a \u003cnpm@chromium.org\u003e\nReviewed-by: Nicol\u00e1s Pe\u00f1a \u003cnpm@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1685690}\n\nCo-authored-by: Michael Reeves \u003cmichael.reeves077@gmail.com\u003e\n--\n\nwpt-commits: 9b76e02313b0078f2808cb3065a84c1b450b4f8f\nwpt-pr: 62178\n", "files": ["testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-range.html"], "git_node": "940f76010cbad168b2c5d31c2bacdaf359be82be", "git_parents": ["0f810f1a44b7f74aee92399f59eadd6764a8f3ee"], "node": "79cea9c45fbea0456255d27f947317c1528200db", "parents": ["cedead819b8164e3d75c94e870fc79d27d8e2997"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2067115 [wpt PR 62229] - [iframe] Require `allow-origins=` prefix, a=testonly\n\nAutomatic update from web-platform-tests\n[iframe] Require `allow-origins=` prefix (#62229)\n\nThis patch changes the `content` attribute of the `\u003cmeta\u003e`\nelement whose name is `responsive-embedded-sizing` to require\nthe `allow-origins=` prefix, as discussed at [1].\n\n[1]: https://github.com/whatwg/html/pull/12444#issuecomment-5426703071\n\nBug: 418397278\nChange-Id: I56c233c72ed8cdefad347cddc842d0e8904f3598\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8293941\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Kent Tamura \u003ctkent@chromium.org\u003e\nAuto-Submit: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1686940}\n\nCo-authored-by: Koji Ishii \u003ckojii@chromium.org\u003e\n--\n\nwpt-commits: 2beef90fd2b8d267ebed384b0edc7f59f309f991\nwpt-pr: 62229\n", "files": ["testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-400x200root.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-dom-content-loaded.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-icb.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-after-head.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-dynamic-append-after-body.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-dynamic-append-to-doc.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-dynamic-append.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-dynamic-name-change-after-body.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-dynamic-name-change.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-dynamic-remove.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-dynamic-write.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-meta-in-body.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-navigation.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-request-resize.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents-slow.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/resources/iframe-contents.html", "testing/web-platform/tests/css/css-sizing/responsive-iframe/responsive-iframe-allow-origins.html"], "git_node": "021206d2485a129e944eff6faa54f2be9b1b4e1c", "git_parents": ["940f76010cbad168b2c5d31c2bacdaf359be82be"], "node": "9cc68d200b629d9b8f21166d9aee2315eea46794", "parents": ["79cea9c45fbea0456255d27f947317c1528200db"], "tags": []}, {"author": "Adam Page \u003cadam@adampage.net\u003e", "branch": "default", "desc": "Bug 1884052 [wpt PR 44965] - Add tests for accnames from hidden labels, captions, and legends, a=testonly\n\nAutomatic update from web-platform-tests\nAdd tests for accnames from hidden labels, captions, and legends (#44965)\n\n* add tests for names from hidden elements\n* normalize class names\n* remove tentative test status\n* add accname tests by element\n* remove iframe src in case it\u2019s causing CI Firefox crash\n* replaces all static subtest markup with dynamic generation\n* replace sample image\n* flesh out interior table content\n* rename children/parents to descendants/ancestors\n* render an unnamed image for invisible empty subtests\n* make tr/td/th test tentative\n* add subtests for hidden+visible caption/legend\n* figure is no longer named by figcaption\n* add img named by ancestor figure figcaption\n* add name from aria-placeholder\n* add `from encapsulating label` name source\n* don\u2018t check `input[type=\"hidden\"]` for accname\n--\n\nwpt-commits: 6ac501ff05cc900f598bbc65435cce5df59ff162\nwpt-pr: 44965\n", "files": ["testing/web-platform/tests/accname/name/comp_hidden_not_referenced.html", "testing/web-platform/tests/html-aam/accname-computation-by-element/a.html", "testing/web-platform/tests/html-aam/accname-computation-by-element/area.html", "testing/web-platform/tests/html-aam/accname-computation-by-element/button.ht