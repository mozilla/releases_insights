ith-fixed-pos-015.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-016.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-048.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-auto-048-ref.html"], "git_node": "4bce60375c95fdb1da4033d78c2023a26bed80a3", "git_parents": ["6cba464774b15f063ce762c4441e63e2a517db60"], "node": "d25060c40d553b55af26715290c464e813d52180", "parents": ["14001f32a9eb9fc70be0c7dd75a9cc4d16240047"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1452337 - Restrict WebRender image sampling to the visible part of an image r=gfx-reviewers,nical\" at dev request for causing Bug 2068996.\n\nThis reverts commit dfcb1075510e95b2edb7e62a4c38239c4ee75407.\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/render_task_graph.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/interned_prims.rs", "gfx/wr/webrender_api/src/key_types.rs", "gfx/wr/wrench/reftests/image/reftest.list", "gfx/wr/wrench/reftests/image/sub-rect-clamp-ref.yaml", "gfx/wr/wrench/reftests/image/sub-rect-clamp.yaml", "layout/reftests/backgrounds/reftest.list", "layout/reftests/backgrounds/sprite-sampling-clamp-1-ref.html", "layout/reftests/backgrounds/sprite-sampling-clamp-1.html", "layout/reftests/backgrounds/sprite-sampling-clamp-ref.png", "layout/reftests/backgrounds/sprite-sampling-clamp.png", "layout/reftests/bugs/reftest.list"], "git_node": "8c05912e290d1dae55b45d8058049c7f7a84c1d8", "git_parents": ["4bce60375c95fdb1da4033d78c2023a26bed80a3"], "node": "695ce0ec08a305fc2b7f1ca526ab5d903382ff99", "parents": ["d25060c40d553b55af26715290c464e813d52180"], "tags": []}], "date": 1788472526, "git_changesets": ["d2f7c679438a461242399d46d59b6bf9ce046b6a", "40598deabf58b864a55a506849786671