r_thumbnails_fullViewport.js", "toolkit/components/thumbnails/test/browser_thumbnails_redirect.js", "toolkit/components/thumbnails/test/browser_thumbnails_update.js", "toolkit/components/viewsource/test/browser/browser_contextmenu.js", "toolkit/components/viewsource/test/browser/browser_gotoline.js", "toolkit/components/viewsource/test/browser/browser_viewsourceprefs.js", "toolkit/components/windowcreator/test/browser_persist.js", "toolkit/content/tests/browser/browser_about_glean.js", "toolkit/content/tests/browser/browser_about_logging.js", "toolkit/content/tests/browser/browser_about_networking.js", "toolkit/content/tests/browser/browser_keyevents_during_autoscrolling.js", "toolkit/modules/tests/browser/browser_Finder_hidden_textarea.js", "toolkit/mozapps/downloads/tests/browser/browser_unknownContentType_delayedbutton.js"], "git_node": "70265f1698173c1064f243641084b39b8609e239", "git_parents": ["756539df3d1dfe72726781b55dd658b359f43b18"], "node": "a99fdd1acccd96f99aa25db5e4edfcafec599a2f", "parents": ["9f7051e26a9cde7af2bfd12977b66be7d43d7770"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1868500 - Add support for Fangsong and Kai font families in CSS r=firefox-style-system-reviewers,layout-reviewers,emilio,jfkthame\" for causing failures at generic-family-prefs.html\n\nThis reverts commit 5da1ea67a156ab655619f9d73761690a98dcf93f.\n", "files": ["gfx/thebes/gfxPlatformFontList.cpp", "layout/base/StaticPresData.cpp", "layout/base/StaticPresData.h", "layout/style/GeckoBindings.cpp", "modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js", "servo/components/style/values/computed/font.rs", "testing/web-platform/meta/css/css-fonts/__dir__.ini", "testing/web-platform/meta/css/css-fonts/generic-family-keywords-003.html.ini", "testing/web-platform/mozilla/meta/css/generic-family-prefs.html.ini", "testing/web-platform/mozilla/tests/css/generic-family-prefs.html", "testing/web-platform/tests/css/css-fonts/parsing/font-family-computed.html", "testing/web-platform/tests/css/css-fonts/parsing/font-family-invalid.html", "testing/web-platform/tests/css/css-fonts/parsing/font-family-valid.html"], "git_node": "ce25f836cac67a30603462547b04049c52479410", "git_parents": ["70265f1698173c1064f243641084b39b8609e239"], "node": "e172b271b3d7baf866ef023f9d6e4939e8400aa6", "parents": ["a99fdd1acccd96f99aa25db5e4edfcafec599a2f"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2069517 - Share Stylo's Gecko-specific derives with Servo. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323762\n", "files": ["servo/components/style/properties/declaration_block.rs", "servo/components/style/stylist.rs", "servo/components/style/values/specified/color.rs", "servo/components/style/values/specified/font.rs"], "git_node": "4a111808e0bcb506c30e98f7a568b9e540f88a7b", "git_parents": ["ce25f836cac67a30603462547b04049c52479410"], "node": "2042e8bc6591b0a2d3a49de567f4ae42ed5f8687", "parents": ["e172b271b3d7baf866ef023f9d6e4939e8400aa6"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2065753. Decode JXL images on a dedicated thread pool. r=saschanaz,jstutte\n\njxl-rs 0.6 will decode one image on several threads if we hand it a\nJxlParallelRunner: it calls us back with a count and a closure, and expects us to\ncall that closure once per index, in parallel if we want to, and not return until\nthey have all finished. This implements that on a thread pool created in this\npatch, and hands it to process() and flush_pixels() in place of None.\n\nThe pool is a SharedThreadPool, which gets us three things without writing them. It\nis a singleton: one thread pool shared per-process. It is shut down at\nxpcom-shutdown-threads, so nothing here has to observe shutdown. And it reaps its\nidle threads after a few seconds.\n\nThe calling thread that blocks and the threads it waits on belong to different pools,\nso a blocked decode can never be holding a thread that a helper needs. AVIF already\nworks this way, fanning a decode out to dav1d's own threads. The calling thread\ntakes a share of the work as well as waiting, so the work still gets done if no\nhelper can be queued at all.\n\nnsIThreadPool has Rust bindings, but nsThreadPool is not a registered component, so\nthere is no way to construct one from Rust. JxlDecodePool.cpp constructs the thread\npool in C++ side. Everything else is in rust.\n\nThe part worth reviewing carefully is the lifetime. The closure jxl-rs hands us\nborrows its decode state, so it is only valid for the duration of the call, but a\nhelper is an nsIRunnable and has to be 'static. Both can't be true, so the lifetime\nis transmuted away and the closure travels behind a raw pointer, which switches off\nborrow checking for that data.\n\nWhat puts the guarantee back is that the call does not return until every helper it\nqueued has been accounted for. Each helper's payload decrements a count from its\ndestructor, which runs whether the helper ran or was thrown away without running,\nand a guard blocks until that count is zero. The guard does its waiting from a\ndestructor rather than from a statement after the work, so it also covers the\ncalling thread's own invocation of the closure panicking: a plain call sited after\nthe work would be skipped by the unwind while helpers were still holding the\npointer. Gecko builds Rust with panic=abort so that unwind does not arise in\nFirefox, but rusttests builds with unwinding.\n\nHelpers are dispatched with DISPATCH_FALLIBLE, so a dispatch the pool cannot accept\nreleases the helper rather than leaking it.\n\nI had Claude model the algorithm outside the tree and run it under Miri, including\nwith strict provenance since the design rests on a raw pointer, and under shuttle,\nwhich swaps in its own threading primitives so a test can walk the possible\ninterleavings instead of hoping to hit the bad one. Three of those searches\nenumerate every interleaving rather than sampling: that the wait covers a helper,\nthat a helper discarded without running still releases its count, and that a\ndispatch the pool refuses leaves the count balanced rather than one short. Two\nhelpers both claiming indices is too big a space to enumerate, so that case is\nsampled instead.\n\nTwo things that does not cover. The model substitutes its own dispatcher for\nmoz_task, because Miri will not execute foreign functions, so what it checks is the\nalgorithm and not the C++ side. And it assumes the pool honours DISPATCH_FALLIBLE,\nwhich comes from reading nsThreadPool rather than from the model.\n\nStarting the pool's threads costs about 0.2ms on my machine. My rough guess is that\nimages under about 4ms of decode time will stay on one thread and never touch the\npool at all, so the most this can cost is 0.2ms on a 5ms decode, or about 4%.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320649\n", "files": ["Cargo.lock", "image/build/nsImageModule.cpp", "image/decoders/JxlDecodePool.cpp", "image/decoders/moz.build", "image/rust/jxl/Cargo.toml", "image/rust/jxl/cbindgen.toml", "image/rust/jxl/src/decoder.rs", "image/rust/jxl/src/lib.rs", "image/rust/jxl/src/runner.rs", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "6af1ede335ea7e77db4fe538fa9cc053ba55133c", "git_parents": ["4a111808e0bcb506c30e98f7a568b9e540f88a7b"], "node": "6711a24d7e5bcbc4cad2f25e04d3de2e11ea2132", "parents": ["2042e8bc6591b0a2d3a49de567f4ae42ed5f8687"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2065753. Add gtests that parallel JXL decoding produces the same pixels as serial. r=saschanaz\n\nAdd tests that decoding jxl serially or in parallel produce the same result. Add a test that throwing much more work at the jxl decoding pool than it has threads works fine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320780\n", "files": ["image/test/gtest/Common.cpp", "image/test/gtest/Common.h", "image/test/gtest/TestDecoders.cpp", "image/test/gtest/large-jxl-reference.webp", "image/test/gtest/moz.build"], "git_node": "cdce7a837da92c6cb830e268b6d3ffd26763b848", "git_parents": ["6af1ede335ea7e77db4fe538fa9cc053ba55133c"], "node": "855eb7488c914128a07d2826a6c8bda29287787b", "parents": ["6711a24d7e5bcbc4cad2f25e04d3de2e11ea2132"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2069345 - Remove test.wait300msAfterTabSwitch from remaining tests that already pass without it. r=firefox-desktop-core-reviewers ,necko-reviewers,media-playback-reviewers,layout-reviewers,padenot,valentin,dshin,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323604\n", "files": ["accessible/tests/browser/bounds/browser_test_iframe_transform.js", "accessible/tests/browser/hittest/browser_test_APZ.js", "accessible/tests/browser/hittest/browser_test_general.js", "accessible/tests/browser/hittest/browser_test_scroll_hittest.js", "accessible/tests/browser/mac/browser_range.js", "docshell/test/browser/browser_browsingContext-webProgress.js", "docshell/test/browser/browser_bug422543.js", "docshell/test/browser/browser_bug503832.js", "docshell/test/browser/browser_replace_state_during_navigation.js", "docshell/test/browser/browser_replace_state_during_navigation_from_first_page.js", "dom/base/test/browser_bug1303838.js", "dom/base/test/browser_bug1691214.js", "dom/base/test/browser_bug1703472.js", "dom/base/test/fullscreen/browser_fullscreen-bug-1798219.js", "dom/base/test/fullscreen/browser_fullscreen-document-mutation-navigation.js", "dom/base/test/fullscreen/browser_fullscreen-document-mutation-race.js", "dom/base/test/fullscreen/browser_fullscreen-document-mutation.js", "dom/base/test/fullscreen/browser_fullscreen-form-validation.js", "do