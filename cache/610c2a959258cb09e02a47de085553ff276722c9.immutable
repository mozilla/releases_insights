/app/src/main/java/org/mozilla/fenix/search/awesomebar/AwesomeBarComposable.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/FenixSearchMiddlewareTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "6b55be3bd95a45dbd122016c95d17a94636e4e54", "git_parents": ["cf42d16228782302b58fa5df531bf304996bcb38"], "node": "ded26dc30579b0561b75874449899ac29d6d2f15", "parents": ["1acf4cdf70b82b06ea6cfaf19fbe3d93baec4a14"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058212 - part 7 - Support reloading the current website from the AwesomeBar r=android-reviewers,android-l10n-reviewers,parker,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319556\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/internal/CurrentTabDetails.kt", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/FenixSearchMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/SearchFragmentStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/AwesomeBarComposable.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/FenixSearchMiddlewareTest.kt"], "git_node": "b209de9e0ab5dabdf4034cf4b759a6c18451d8c3", "git_parents": ["6b55be3bd95a45dbd122016c95d17a94636e4e54"], "node": "1d126e0d2195374ca688169c129290eb257be9ab", "parents": ["ded26dc30579b0561b75874449899ac29d6d2f15"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058212 - part 8 - Cap the width of the AwesomeBar to 600dp r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319174\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/AwesomeBarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/ClipboardSuggestionBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/PrivateSuggestionsCard.kt"], "git_node": "6d54cb0739b2fbcff7fe9761e4c3185fd38f5f13", "git_parents": ["b209de9e0ab5dabdf4034cf4b759a6c18451d8c3"], "node": "2d26d06735f393905dfefc6ef1708bce8fcdfba0", "parents": ["1d126e0d2195374ca688169c129290eb257be9ab"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064605 - Reduce the spacing between AwesomeBar items r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319751\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/AwesomeBar.kt", "mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/internal/Suggestion.kt", "mobile/android/android-components/components/compose/awesomebar/src/main/java/mozilla/components/compose/browser/awesomebar/internal/SuggestionGroup.kt", "mobile/android/android-components/config/detekt-baseline.xml"], "git_node": "7c39c777651b8edaec0d2ab8b171dd45ed879d90", "git_parents": ["6d54cb0739b2fbcff7fe9761e4c3185fd38f5f13"], "node": "27d692caa47bf876967fd6df276eff4ba525c5da", "parents": ["2d26d06735f393905dfefc6ef1708bce8fcdfba0"], "tags": []}, {"author": "Christoph Moench-Tegeder \u003ccmt@burggraben.net\u003e", "branch": "default", "desc": "Bug 2067591 - Enable resolving of HTTPS RRs on FreeBSD r=valentin,necko-reviewers\n\nPull in the code we already have in FreeBSD builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322182\n", "files": ["netwerk/dns/moz.build", "netwerk/dns/nsHostResolver.cpp"], "git_node": "2a3aa78f2b1ac6b0eaaa94ed57b703b843a67919", "git_parents": ["7c39c777651b8edaec0d2ab8b171dd45ed879d90"], "node": "e6316be18886ce980776502bd34d20d824dcfe9b", "parents": ["27d692caa47bf876967fd6df276eff4ba525c5da"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063284 - Prevent doc element created notification for documents loaded as data r=dom-core-reviewers,smaug\n\nListeners for this event all require a window. So documents loaded as data\nwill effectively be pure overhead only. By returning early we skip that\noverhead if the principal is not of type SystemPrincipal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318718\n", "files": ["dom/base/nsContentSink.cpp"], "git_node": "af04d340f5a82143dbc93c0b65fdd89d8b7d854c", "git_parents": ["2a3aa78f2b1ac6b0eaaa94ed57b703b843a67919"], "node": "ebeff95ea396885288013c94e40478f03ba80af7", "parents": ["e6316be18886ce980776502bd34d20d824dcfe9b"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2067049 - Alert on test_trr_bench.js r=necko-reviewers,mozperftest-reviewers,perftest-reviewers,kershaw,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321811\n", "files": ["netwerk/test/unit/test_trr_bench.js", "taskcluster/kinds/perftest/linux.yml", "testing/perfdocs/generated/mozperftest.md"], "git_node": "330d4f24353a511ad6eeaacc937bdfb694cd5f41", "git_parents": ["af04d340f5a82143dbc93c0b65fdd89d8b7d854c"], "node": "8165fa4f2d3dfc622d607a783caaf84ea681ea78", "parents": ["ebeff95ea396885288013c94e40478f03ba80af7"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2067049 - fix perfdocs node error r=mozperftest-reviewers,sparky\n\nRunning ./mach perfdocs --generate failed with the following for test_trr_bench.js\n```\n  AppConstants.platform == \"android\" ? \"10.0.2.2\" : \"127.0.0.1\";\n               ^\n\nTypeError: Cannot read properties of undefined (reading 'platform')\n    at evalmachine.\u003canonymous\u003e:13:16\n    at Script.runInContext (node:vm:149:12)\n    at Object.runInContext (node:vm:301:6)\n    at [eval]:21:12\n    at runScriptInThisContext (node:internal/vm:219:10)\n    at node:internal/process/execution:451:12\n    at [eval]-wrapper:6:24\n    at runScriptInContext (node:internal/process/execution:449:60)\n    at evalFunction (node:internal/process/execution:283:30)\n    at evalTypeScript (node:internal/process/execution:295:3)\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321819\n", "files": ["python/mozperftest/mozperftest/script.py", "python/mozperftest/mozperftest/tests/data/samples/test_xpcshell_destructured.js", "python/mozperftest/mozperftest/tests/support.py", "python/mozperftest/mozperftest/tests/test_script.py"], "git_node": "ef95cdf41b3d030a1b974b5ca7ab4a964d7536f1", "git_parents": ["330d4f24353a511ad6eeaacc937bdfb694cd5f41"], "node": "3aab335ab8e62a04cf660ddd2532708211a0a9d5", "parents": ["8165fa4f2d3dfc622d607a783caaf84ea681ea78"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1984820 - Wait for FormProcessed after each navigation in browser_formless_submit_chrome.js, r=credential-management-reviewers,dimi.\n\nlistenForTestNotification installs a single global listener, so a FormProcessed that\nno task waited for resolves the next task's wait. That task then types into the form\nbefore LoginManagerChild has attached its input listeners, and no capture doorhanger\nis ever created.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321905\n", "files": ["toolkit/components/passwordmgr/test/browser/browser_formless_submit_chrome.js"], "git_node": "8940eefca7b4c2b4bee66cc2888e4f391193bb88", "git_parents": ["ef95cdf41b3d030a1b974b5ca7ab4a964d7536f1"], "node": "92cb353dfe2f9cb6b5c2899f16ec77a296b0e74a", "parents": ["3aab335ab8e62a04cf660ddd2532708211a0a9d5"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1984820 - Wait for FormProcessed after submitting in browser_doorhanger_dismissed_for_ccnumber.js, r=credential-management-reviewers,dimi.\n\nform_basic.html has no action, so submitting navigates to a page with a login form of\nits own. That FormProcessed outlives the task and resolves the next task's wait, which\nthen hangs waiting for a PasswordEditedOrGenerated that never comes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321906\n", "files": ["toolkit/components/passwordmgr/test/browser/browser_doorhanger_dismissed_for_ccnumber.js"], "git_node": "1fac3b4e887e522ad8d3dcba924faa5b08b21272", "git_parents": ["8940eefca7b4c2b4bee66cc2888e4f391193bb88"], "node": "9dc83d5cf650f5ed70405ab25c61ae3f503d3173", "parents": ["92cb353dfe2f9cb6b5c2899f16ec77a296b0e74a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1984820 - Report test notifications that arrive from a closed tab, r=credential-management-reviewers,dimi.\n\nSuch a notification belongs to a page nobody is waiting on any more, and resolving on\nit lets the caller run before its own page has been processed. Ignore those and fail\nthe file from cleanup, so a task that does not wait for the notification it causes is\nreported instead of silently corrupting a later task. No test in the tree trips it.\n\nLoginManagerParent passes the browsing context with all four notifications; three of\nthem sent an empty payload, which would have left the check covering FormProcessed\nonly. For ShowDoorhanger it has to be read before the await, because the actor can be\ndestroyed before the doorhanger is dealt with.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321907\n", "files": ["toolkit/components/passwordmgr/LoginManagerParent.sys.mjs", "toolkit/components/passwordmgr/test/browser/head.js"], "git_node": "a13410553b7b545ecfad8e4ffd330d556ec4dd1e", "git_parents": ["1fac3b4e887e522ad8d3dcba924faa5b08b21272"], "node": "59967b6abfdd07fc0d9d95ce127e9c700ccbe1b8", "parents": ["9dc83d5cf650f5ed70405ab25c61ae3f503d3173"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062458 - Re-enable browser_formless_submit_chrome.js on macOS 15 aarch64, r=credential-management-reviewers,dimi.\n\nThe permafail there is the bug 1984820 race.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321908\n", "files": ["toolkit/components/passwordmgr/test/browser/browser.toml"], "git_node": "eb094dd78c91a18c166ad62754ca8001c14350ad", "git_parents": ["a13410553b7b545ecfad8e4ffd330d556ec4dd1e"], "node": "7c7b4d468a95bdcdfed8191293a1e67f703108a9", "parents": ["59967b6abfdd07fc0d9d95ce127e9c700ccbe1b8"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040442 - Shut nsHttpHandler down explicitly rather than from its destructor. r=necko-reviewers,valentin\n\nnsHttp::DestroyAtomTable() was only reached from ~nsHttpHandler, which does not\nrun while anything else still holds a reference to the handler. The atom table\nthen still has its entries when its own static destructor runs at exit(), and\nreleasing their string buffers that late goes through NS_LogRelease in debug\nbuilds, which locks gTraceLog after it has already been destroyed.\n\nCall an explicit Shutdown() from the shutdown hook that already cleared\ngHttpHandler, so the teardown no longer depends on the refcount reaching zero.\n\nThe bug suggests the smaller fix of never destroying sAtomTable at all. That\nwould hide the symptom along with the crash: entries left this late mean\nsomething did not get torn down, and they would still be alive when\nNS_LogTerm() closes leak accounting, trading the crash for leak reports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322116\n", "files": ["netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpHandler.h"], "git_node": "accf295417cc38b50b1078d06ffe589a1123b8cd", "git_parents": ["eb094dd78c91a18c166ad62754ca8001c14350ad"], "node": "a355e3f91b821eb59f8fa276bb9b9515c08f2efd", "parents": ["7c7b4d468a95bdcdfed8191293a1e67f703108a9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1934436 - Flag the current session history entry as interacted with in the parent process, r=smaug.\n\nA load triggered by browser UI counts as user interaction for the entry\nbeing left, so that the back button stays enabled. nsDocShell::LoadURI\nrecords this from the content process hosting that entry, and the parent\napplies it to whichever entry is active when the message arrives. For a\nprocess switching load the entry this load adds is committed by a\ndifferent content process over a different channel, so it can win the\nrace and collect the flag instead, leaving the back button disabled.\n\nDoing it in the parent applies it synchronously, while the entry being\nleft is still the active one. DocumentLoadListener::Open already does\nthe same, but only for loads it cannot redirect into a content process;\nrelaxing that guard would still miss the loads that never reach\nDocumentLoadListener, so BrowsingContext::LoadURI covers them all\ninstead.\n\nSession history loads are excluded, as nsDocShell::LoadURI already does:\nback, forward and reload carry the target entry's original triggering\nprincipal, which is the system principal for anything loaded from\nbrowser UI, and must not mark the entry being left. The other early\nreturns in nsDocShell::LoadURI depend on docshell state the parent does\nnot have, so a load that is rejected later now flags the entry.\n\nAlso removes the Linux debug skip-if added in this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321904\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser.toml", "docshell/base/BrowsingContext.cpp", "docshell/base/nsDocShell.cpp", "docshell/test/browser/browser_backforward_userinteraction_systemprincipal.js"], "git_node": "53d52da7f2676780300976618b1c8c76b4c6ab6c", "git_parents": ["accf295417cc38b50b1078d06ffe589a1123b8cd"], "node": "ea9bf5f0c651fe33914aa5c396739d20d0b6cf46", "parents": ["a355e3f91b821eb59f8fa276bb9b9515c08f2efd"], "tags": []}, {"author": "Gopalarathnam Venkatesan \u003cgopal@g13n.net\u003e", "branch": "default", "desc": "Bug 2042432 - Fix clippy warnings in toolkit/crashreporter/mozannotation_client/src/lib.rs r=sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322180\n", "files": ["toolkit/crashreporter/mozannotation_client/src/lib.rs"], "git_node": "a747f976517eb34fe78d58dac2d40e16b44e3bdb", "git_parents": ["53d52da7f2676780300976618b1c8c76b4c6ab6c"], "node": "03ce5925f92612e783c2cd0d532e0feddec86398", "parents": ["ea9bf5f0c651fe33914aa5c396739d20d0b6cf46"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052621 - Convert ActionsResult from a class to a plain object and a typedef. r=daleharvey\n\nThe results are no longer frozen, and tsc enforces the required properties in place of the constructor's runtime check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322247\n", "files": ["browser/components/urlbar/ActionsProvider.sys.mjs", "browser/components/urlbar/ActionsProviderContextualSearch.sys.mjs", "browser/components/urlbar/ActionsProviderQuickActions.sys.mjs", "browser/components/urlbar/ActionsProviderTabGroups.sys.mjs"], "git_node": "d11234d499fc6e3c45510b5ac8f2d6d30c506fbc", "git_parents": ["a747f976517eb34fe78d58dac2d40e16b44e3bdb"], "node": "4e6cbffff583e69d755f390528b3f302ec552fb9", "parents": ["03ce5925f92612e783c2cd0d532e0feddec86398"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067637 - Change the view's scrollbar-width from auto to thin. r=daleharvey,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322242\n", "files": ["browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "8b31ac1f65f34e791bd6f3a805b1eb18aee575c2", "git_parents": ["d11234d499fc6e3c45510b5ac8f2d6d30c506fbc"], "node": "c52a9f0cf3de5915163e5780859f99de04464d04", "parents": ["4e6cbffff583e69d755f390528b3f302ec552fb9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066405 - Test dismissing a recent search in the newtab search bar. r=daleharvey,urlbar-reviewers\n\nThe reported defect does not reproduce, so this lands as coverage only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321889\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser_resultMenu.js"], "git_node": "7420de8186f81a94a3a95297c297df3dac7f8940", "git_parents": ["8b31ac1f65f34e791bd6f3a805b1eb18aee575c2"], "node": "e9e8500536f2be3ba7f4fc854a06863e134822cc", "parents": ["c52a9f0cf3de5915163e5780859f99de04464d04"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067607 - Allow cargo fix to run and fix particular crates. r=firefox-build-system-reviewers,sergesanspaille\n\nThis was used in the following commits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322197\n", "files": ["build/cargo/cargo-fix.yaml", "config/makefiles/rust.mk", "python/mozbuild/mozbuild/mach_commands.py"], "git_node": "0f740f387321b4af5906f934548525380ad3e086", "git_parents": ["7420de8186f81a94a3a95297c297df3dac7f8940"], "node": "97b628bc4305f3f8d1134a6366619c8a5e98f776", "parents": ["e9e8500536f2be3ba7f4fc854a06863e134822cc"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061777 - Reject parent-only Client ops received from content processes. r=asuth\n\nClientHandleOpParent::Init now rejects ClientControlledArgs and\nClientEvictBFCacheArgs when the sender is a content process. These op types\nare only ever produced by the parent-process ServiceWorkerManager (via\nClientHandle::Control and ClientHandle::EvictFromBFCache); a content process\nnever legitimately sends them.\n\nAccepting a forged ClientControlledArgs from content let a compromised\ncontent process install attacker-chosen ServiceWorker controller state on a\nclient living in another process. ClientManagerService::Navigate then trusted\nthat controller state as its sole authorization, allowing extension\nbackground pages to be navigated to attacker-controlled URLs and attacker\ncode to run in the extension process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321169\n", "files": ["dom/clients/manager/ClientHandleOpParent.cpp"], "git_node": "52c4c2c2dbba665d5a29208eb320f2f58f59ada3", "git_parents": ["0f740f387321b4af5906f934548525380ad3e086"], "node": "56365ae7a1595c5f237c8f09508b6d97257e7d7c", "parents": ["97b628bc4305f3f8d1134a6366619c8a5e98f776"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2058199 - Close trustpanel on navigation. r=emz,urlbar-reviewers,jteow\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321075\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js"], "git_node": "85caeb90a2847f9e058d1ee2002e97a910e9afad", "git_parents": ["52c4c2c2dbba665d5a29208eb320f2f58f59ada3"], "node": "6615e2ca92191c322bf8be75d7eb3e6a486651ce", "parents": ["56365ae7a1595c5f237c8f09508b6d97257e7d7c"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2065230 - Fix data corruption after filter.disconnect() r=necko-reviewers,valentin\n\nThis fixes two bugs in the implementation and adds test coverage that\nverifies both fixes. For details, see\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=2065230#c3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321950\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_webRequest_StreamFilter_disconnect_transitions.js", "toolkit/components/extensions/test/xpcshell/xpcshell-common-e10s.toml", "toolkit/components/extensions/webrequest/StreamFilterParent.cpp"], "git_node": "d3ccc05ae75710a44587fe748549e65d54930d12", "git_parents": ["85caeb90a2847f9e058d1ee2002e97a910e9afad"], "node": "8ddf205cdd0d8d99d7615bab6527bccb16fb5525", "parents": ["6615e2ca92191c322bf8be75d7eb3e6a486651ce"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057843 - Unskip browser_ext_browserAction_popup_resize_bottom.js on Nova builds while keeping skip-if restricted to linux22.04 wayland jobs. r=zombie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316894\n", "files": ["browser/components/extensions/test/browser/browser-action.toml"], "git_node": "e448d6504867b62e4275605c21dc562ba6b5ff27", "git_parents": ["d3ccc05ae75710a44587fe748549e65d54930d12"], "node": "30b64d733831de5a02f437c3166fb40842b7d8f1", "parents": ["8ddf205cdd0d8d99d7615bab6527bccb16fb5525"], "tags": []}, {"author": "Martin Stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2054811 [Linux] Blit only actual content of VA-API texures r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321799\n", "files": ["gfx/gl/GLBlitHelper.cpp", "widget/gtk/DMABufSurface.h"], "git_node": "e89bb99780c40f04525e37408be3550672904824", "git_parents": ["e448d6504867b62e4275605c21dc562ba6b5ff27"], "node": "f67539802c5d9d3d61ac1d1c97cb8d67597bb238", "parents": ["30b64d733831de5a02f437c3166fb40842b7d8f1"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063990 - Shutdown glean for storage gtests r=jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319045\n", "files": ["storage/test/gtest/storage_test_harness.h"], "git_node": "4e6a86deba1ebb24dfff3dd587ed7d9bd2543235", "git_parents": ["e89bb99780c40f04525e37408be3550672904824"], "node": "c9fe61e6f00580f2a73597cf1387bc552c39bab8", "parents": ["f67539802c5d9d3d61ac1d1c97cb8d67597bb238"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2065594 - Fix parser/html makefile for `make translate` r=hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320534\n", "files": ["parser/html/java/Makefile"], "git_node": "9e2cf5dde5dae302c63ad8432d5e7e312efcb9f3", "git_parents": ["4e6a86deba1ebb24dfff3dd587ed7d9bd2543235"], "node": "5149560184cb5a7322f7b598fe4b486b14a288d2", "parents": ["c9fe61e6f00580f2a73597cf1387bc552c39bab8"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1829935 - Serve an image document in browser_103_cleanup.js so the early hint is never connected back, r=valentin,necko-reviewers.\n\nThe test asserts that the preload is cancelled with parent-connect-timeout,\nwhich requires the 1ms timer started by EarlyHintPreloader::Register() to beat\nthe content process connecting back for the hint. On a machine that completes\nthe connect-back in under a millisecond the timer loses, the channel is adopted\nrather than cancelled, and canceledReason is empty. That is most macOS runs and\noccasionally Windows.\n\nAn image document has no nsContentSink, so ProcessHTTPHeaders never runs and\nthe hint is never processed in the content process. The connect-back then\ncannot happen and the timer is the only thing that can cancel the preload.\nThe test now also asserts that earlyhints-connectback never fires, so that\nreintroducing the race fails loudly instead of silently going back to\nmeasuring it.\n\nThis replaces the 500ms delay added in D294363, which could not help: Register()\nstarts the timer at the 200 response, so delaying the 200 delays the timer too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321913\n", "files": ["netwerk/test/browser/103_cleanup.sjs", "netwerk/test/browser/browser_103_cleanup.js"], "git_node": "2b6d35749dbe65f9b069d8494ff0ca9d31bdc385", "git_parents": ["9e2cf5dde5dae302c63ad8432d5e7e312efcb9f3"], "node": "b183a64fe2e25ecbcfb0be46ae3770a10e99bd67", "parents": ["5149560184cb5a7322f7b598fe4b486b14a288d2"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066087 - Fix ANR and layout issues in tabs popup r=android-reviewers,avirvara\n\nThis change defers the display of the tabs popup using `View.post` to avoid potential ANRs in `HardwareRenderer.nSetName` that can occur during window transitions, such as when the keyboard is hiding. It also improves lifecycle management by dismissing and nullifying the popup in `onDestroyView`.\n\nAdditionally:\n- Adds checks to prevent showing the popup if it is already visible or if the fragment is being removed.\n- Disables the `TabsPopup` animation style to prevent transition conflicts.\n- Fixes a layout issue in `TabViewHolder` where padding was not being correctly reset or calculated for different item types, leading to incorrect offsets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321549\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/session/ui/TabViewHolder.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/session/ui/TabsPopup.kt"], "git_node": "5cc395ac1e6702238799f74ce7da25a8119e1b28", "git_parents": ["2b6d35749dbe65f9b069d8494ff0ca9d31bdc385"], "node": "c22e3eba8f07caa1b3f0578bb3d1b2ebc35736de", "parents": ["b183a64fe2e25ecbcfb0be46ae3770a10e99bd67"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065079 - add test for unexpected PrP prompts r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321829\n", "files": ["toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_autofill_primary_password.js"], "git_node": "3c4ad8f1ad8f58557831678e819826a787914815", "git_parents": ["5cc395ac1e6702238799f74ce7da25a8119e1b28"], "node": "08065e1a4e542355db0a48133ecf16472278f377", "parents": ["c22e3eba8f07caa1b3f0578bb3d1b2ebc35736de"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065441 - filter autofill login candidates without decryption r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321830\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs"], "git_node": "562343eb3f13bd81cd65a1d17cc7bc0f9f915e0e", "git_parents": ["3c4ad8f1ad8f58557831678e819826a787914815"], "node": "3d860d1cfd38706cdca80ba78f93e7f46f7f281a", "parents": ["08065e1a4e542355db0a48133ecf16472278f377"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1990613 - Focus: Introduce a structured `applicationScope` to `FocusApplication` and `Components` to replace the use of `GlobalScope` and `lifecycleScope` for global background tasks. r=android-reviewers,pollymce\n\nKey changes:\n- Defined a `CoroutineScope` in `FocusApplication` using `Dispatchers.Main`, `SupervisorJob`, and a `CoroutineExceptionHandler`.\n- Updated `Components` to accept and provide `applicationScope` for dependency injection.\n- Refactored `StartupTypeTelemetry` to use the provided `applicationScope` instead of a `LifecycleOwner`'s scope, ensuring telemetry recording survives activity destruction.\n- Replaced `GlobalScope.launch` with `applicationScope.launch` in `BrowserFragment` for submitting crash reports.\n- Updated `MainActivity`, `CustomTabActivity`, and associated tests to support the new `applicationScope` requirement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297656\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/FocusApplication.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/activity/CustomTabActivity.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/activity/MainActivity.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/telemetry/startuptelemetry/StartupTypeTelemetry.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/TestFocusApplication.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/telemetry/StartupTypeTelemetryTest.kt"], "git_node": "17846938fd4bb43637c1ff6bc164c762c8e45ac3", "git_parents": ["562343eb3f13bd81cd65a1d17cc7bc0f9f915e0e"], "node": "b5bda03f0eddd052e4df5b189e25169416f7c6c2", "parents": ["3d860d1cfd38706cdca80ba78f93e7f46f7f281a"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1990613 - Fenix: Replace `GlobalScope` with a structured `applicationScope`. r=android-reviewers,pollymce\n\nKey changes:\n- Introduced a central `applicationScope` in `FenixApplication` tied to the application lifetime using `SupervisorJob` and a global `CoroutineExceptionHandler`.\n- Injected `applicationScope` into `Components` and `Core` to provide a managed scope for background tasks.\n- Refactored `SnackbarBinding`, `ShareController`, `StartupTypeTelemetry`, and `CrashReporterController` to use the provided `applicationScope` instead of `GlobalScope`.\n- Updated `StorageStatsMetrics` and `FileUploadsDirCleaner` to accept a `CoroutineScope` for asynchronous operations.\n- Updated various fragments (`SettingsFragment`, `BaseBrowserFragment`, `ShareFragment`, `WebExtensionActionPopupFragment`, `HomeFragment`, and `AddonInternalSettingsFragment`) to pass the application scope to their respective controllers/bindings.\n - Also fix queueEngineWarmup accidentally returning a lambda instead of\n   executing the runOnVisualCompleteness block, due to an erroneous `\\u003d {`\n   function body syntax. The engine warmup was silently never being\n   scheduled at visual completeness.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297657\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/AddonInternalSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/WebExtensionActionPopupFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/crashes/CrashReporterController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/StartupTypeTelemetry.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/StorageStatsMetrics.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/snackbar/SnackbarBinding.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/crashes/CrashReporterControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/perf/StartupTypeTelemetryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/share/ShareControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/snackbar/SnackbarBindingTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "046369af65bfe9dec9aa957923f75fff46d07dce", "git_parents": ["17846938fd4bb43637c1ff6bc164c762c8e45ac3"], "node": "b3717402bf7ce14a7fe12348c61a76e2853601d2", "parents": ["b5bda03f0eddd052e4df5b189e25169416f7c6c2"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1990613 - AC: Refactor multiple components to replace `GlobalScope` and `coroutineContext` with an explicit, application-provided `CoroutineScope`. r=android-reviewers,pollymce\n\nKey changes:\n- Refactored `TabIntentProcessor`, `RegionMiddleware`, `FileUploadsDirCleaner`, `AbstractAutofillService`, `GeckoAutocompleteStorageDelegate`, and `AutoSave` to accept a `CoroutineScope` (typically named `applicationScope`) in their constructors.\n- Replaced `GlobalScope.launch` and `GlobalScope.async` with operations on the provided internal scopes to ensure structured concurrency and better lifecycle management.\n- Updated `BundledSearchEnginesStorage` to use `coroutineScope` and `async` for loading search engines, removing the dependency on an external `coroutineContext`.\n- Refactored `FxaPushSupportFeature` and its internal observers (`AccountObserver`, `ConstellationObserver`, `AutoPushObserver`) to utilize a centralized `applicationScope` instead of mixing global and UI contexts.\n- Updated Fenix and sample browser `AutofillService` implementations to provide the `applicationScope` from the main components container.\n- Updated associated unit tests to pass the appropriate test scope or `runTest` scope to the refactored classes.\n- Removed several `@OptIn(DelicateCoroutinesApi::class)` annotations previously required for `GlobalScope` usage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297659\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/autofill/GeckoAutocompleteStorageDelegate.kt", "mobile/android/android-components/components/browser/icons/src/test/java/mozilla/components/browser/icons/extension/IconMessageHandlerTest.kt", "mobile/android/android-components/components/browser/session-storage/build.gradle", "mobile/android/android-components/components/browser/session-storage/src/androidTest/java/mozilla/components/browser/session/storage/FullRestoreTest.kt", "mobile/android/android-components/components/browser/session-storage/src/androidTest/java/mozilla/components/browser/session/storage/RestoringBrowsingSessionsTest.kt", "mobile/android/android-components/components/browser/session-storage/src/main/java/mozilla/components/browser/session/storage/AutoSave.kt", "mobile/android/android-components/components/browser/session-storage/src/main/java/mozilla/components/browser/session/storage/SessionStorage.kt", "mobile/android/android-components/components/browser/session-storage/src/test/java/mozilla/components/browser/session/storage/AutoSaveTest.kt", "mobile/android/android-components/components/browser/session-storage/src/test/java/mozilla/components/browser/session/storage/SessionStorageTest.kt", "mobile/android/android-components/components/feature/accounts-push/src/main/java/mozilla/components/feature/accounts/push/FxaPushSupportFeature.kt", "mobile/android/android-components/components/feature/accounts-push/src/main/java/mozilla/components/feature/accounts/push/cache/PushScopeProperty.kt", "mobile/android/android-components/components/feature/accounts-push/src/test/java/mozilla/components/feature/accounts/push/AccountObserverTest.kt", "mobile/android/android-components/components/feature/accounts-push/src/test/java/mozilla/components/feature/accounts/push/AutoPushObserverTest.kt", "mobile/android/android-components/components/feature/accounts-push/src/test/java/mozilla/components/feature/accounts/push/ConstellationObserverTest.kt", "mobile/android/android-components/components/feature/accounts-push/src/test/java/mozilla/components/feature/accounts/push/FxaPushSupportFeatureTest.kt", "mobile/android/android-components/components/feature/autofill/src/main/java/mozilla/components/feature/autofill/AbstractAutofillService.kt", "mobile/android/android-components/components/feature/intent/src/main/java/mozilla/components/feature/intent/processing/TabIntentProcessor.kt", "mobile/android/android-components/components/feature/intent/src/test/java/mozilla/components/feature/intent/processing/TabIntentProcessorTest.kt", "mobile/android/android-components/components/feature/prompts/build.gradle", "mobile/android/android-components/components/feature/prompts/src/androidTest/java/mozilla/components/feature/prompts/file/OnDeviceFilePickerTest.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FileUploadsDirCleaner.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/region/RegionMiddleware.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/storage/BundledSearchEnginesStorage.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/region/RegionMiddlewareTest.kt", "mobile/android/android-components/components/tooling/lint/src/test/java/mozilla/components/tooling/lint/ShowSnackbarDetectorTest.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/DefaultComponents.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/SampleApplication.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/autofill/AutofillService.kt", "mobile/android/android-components/samples/compose-browser/src/main/java/org/mozilla/samples/compose/browser/Components.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/gecko/CrashPullDelegateTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/autofill/AutofillService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/BackgroundServices.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/IntentProcessors.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/gecko/GeckoProvider.kt", "mobile/android/fenix/config/detekt-baseline.xml", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/session/IntentProcessor.kt"], "git_node": "c043f6bb6b48cd987c23421e772494de8005f14b", "git_parents": ["046369af65bfe9dec9aa957923f75fff46d07dce"], "node": "9ed5270d8cb217954bd216c9e1401bf23d6f924a", "parents": ["b3717402bf7ce14a7fe12348c61a76e2853601d2"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1990613 - AC samples: Refactor sample applications to use structured `CoroutineScope` instead of `GlobalScope`. r=android-reviewers,pollymce\n\nKey changes:\n- Replaced `GlobalScope` and `MainScope` usage across multiple sample modules (`browser`, `crash`, `toolbar`, `compose-browser`) with dedicated, lifecycle-aware `CoroutineScope` instances.\n- Introduced `applicationScope` in `SampleApplication`, `DefaultComponents`, and `CrashApplication` using `SupervisorJob` to manage app-level background tasks.\n- Updated `SampleApplication` to cancel its `applicationScope` in `onTerminate`.\n- Refactored `CrashService` to use a private `serviceScope`, ensuring all coroutines are cancelled in `onDestroy`.\n- Migrated various components, including `SessionStorage`, `FileUploadsDirCleaner`, and `RegionMiddleware`, to accept the shared `applicationScope`.\n- Removed `@OptIn(DelicateCoroutinesApi::class)` annotations previously required for `GlobalScope`.\n- Cleaned up helper methods in `CrashApplication` to be internal to the class and use the managed application scope.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297658\n", "files": ["mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/DefaultComponents.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/SampleApplication.kt", "mobile/android/android-components/samples/crash/src/main/java/org/mozilla/samples/crash/CrashApplication.kt", "mobile/android/android-components/samples/crash/src/main/java/org/mozilla/samples/crash/CrashService.kt", "mobile/android/android-components/samples/toolbar/src/main/java/org/mozilla/samples/toolbar/ToolbarActivity.kt"], "git_node": "c908c05669f3014e6b29bc0e626d7e3c8402c969", "git_parents": ["c043f6bb6b48cd987c23421e772494de8005f14b"], "node": "b36bb83c60797ab7a8238817a3df0993001e0112", "parents": ["9ed5270d8cb217954bd216c9e1401bf23d6f924a"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1578480 - Remove the unused --disable-wmf and --disable-ffmpeg flags on moz.configure r=firefox-build-system-reviewers,sergesanspaille\n\nThe bug also mentions the --disable-av1 and --disable-fmp4 flags, but it seems those have been removed already.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322052\n", "files": ["toolkit/moz.configure"], "git_node": "a8664303447293d52c61b505dbbc2735891c5d6a", "git_parents": ["c908c05669f3014e6b29bc0e626d7e3c8402c969"], "node": "95c0a042fc6ac121b227b8f6e7d96c04e97f1669", "parents": ["b36bb83c60797ab7a8238817a3df0993001e0112"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1578480 - Remove the unused --disable-wmf and --disable-ffmpeg flags on moz.configure r=firefox-build-system-reviewers,sergesanspaille\" for causing build bustagees @DecoderDoctorDiagnostics.cpp.\n\nThis reverts commit a8664303447293d52c61b505dbbc2735891c5d6a.\n", "files": ["toolkit/moz.configure"], "git_node": "61f87dcd7a9e614c364c70e03f9984da502f70b0", "git_parents": ["a8664303447293d52c61b505dbbc2735891c5d6a"], "node": "ab78dc066704f0698090480531f5c04c973b15da", "parents": ["95c0a042fc6ac121b227b8f6e7d96c04e97f1669"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1932948 - Remove outdated flash-block-lists page from source-docs r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321869\n", "files": ["toolkit/components/url-classifier/docs/flash-block-lists.md", "toolkit/components/url-classifier/docs/index.md", "toolkit/components/url-classifier/moz.build", "toolkit/docs/index.md"], "git_node": "f9442f708b484d83ca0f9e1d067a28e819f92e4b", "git_parents": ["61f87dcd7a9e614c364c70e03f9984da502f70b0"], "node": "fb5f960e6a2d8a33fc741bf5747d1a5a9e0975d2", "parents": ["ab78dc066704f0698090480531f5c04c973b15da"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2064552 - turn off jittests on macOS hardware machines, only run on VMs. r=rcurran,taskgraph-reviewers,ahal DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319650\n", "files": ["taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml"], "git_node": "369ab2e0408827b0d30b1e52f81cf9d52397363e", "git_parents": ["f9442f708b484d83ca0f9e1d067a28e819f92e4b"], "node": "6b8c71ce58094d16de5e168f21be1c5f27e4a24c", "parents": ["fb5f960e6a2d8a33fc741bf5747d1a5a9e0975d2"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067590 - Set the max dirty page modifier once per process priority. r=smaug\n\nAn #ifdef MOZ_MEMORY split the if/else chain, so the else that resets the\nmodifier hangs off the background test rather than the foreground one: a\nforeground content process sets 4 and zeroes it again in the next statement,\na no-op since Firefox 137. Decide the modifier once and apply it once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322240\n", "files": ["dom/ipc/ContentChild.cpp"], "git_node": "08f4f4f8df86cab5c2b4503ff457ff588f081196", "git_parents": ["369ab2e0408827b0d30b1e52f81cf9d52397363e"], "node": "b87aaf3bbbea3b137cd97d3e15e74e950fdd44ae", "parents": ["6b8c71ce58094d16de5e168f21be1c5f27e4a24c"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2067099 - Contain unresolvable Handlers entries so later entries are still processed. r=bsmth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321971\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_handlers.js", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs"], "git_node": "674ab89622d796e216e1d41b5a5ff7e4bfc62d51", "git_parents": ["08f4f4f8df86cab5c2b4503ff457ff588f081196"], "node": "1e4c5463439bca3273ffa31c7e5c6c4bab150a7c", "parents": ["b87aaf3bbbea3b137cd97d3e15e74e950fdd44ae"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2067413 - Update PDF.js to new version c3257df8db58845021faea9642b0237f7c2e5101 r=pdfjs-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322069\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "be2c1653f292494470ba369fd7559ffc9b9b78e6", "git_parents": ["674ab89622d796e216e1d41b5a5ff7e4bfc62d51"], "node": "24f9b4f9942e4f8ca11dad7c414d79e9298ad176", "parents": ["1e4c5463439bca3273ffa31c7e5c6c4bab150a7c"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066436 - Add block margin around about:addons global-warnings webcomponent. r=desktop-theme-reviewers,Itiel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321233\n", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css"], "git_node": "8c7161115522cbe1ec1126bf7bfd90b8ec3fe57f", "git_parents": ["be2c1653f292494470ba369fd7559ffc9b9b78e6"], "node": "16580a8668931bb64a66bc9dd0c648a4c731a37a", "parents": ["24f9b4f9942e4f8ca11dad7c414d79e9298ad176"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066436 - Add block margin between about:addons message-bar-stack and the aboutaddons-themes-mode. r=desktop-theme-reviewers,Itiel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321234\n", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css"], "git_node": "67dc6ac359b0881587df5f5ccccc5b3b14a1b294", "git_parents": ["8c7161115522cbe1ec1126bf7bfd90b8ec3fe57f"], "node": "7849f1decffe0043936f0b1c9737aff63eab9dbe", "parents": ["16580a8668931bb64a66bc9dd0c648a4c731a37a"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066087 - Fix ANR and layout issues in tabs popup r=android-reviewers,avirvara\" for causing bc failures @browser_context_menu_iframe.js.\n\nThis reverts commit 5cc395ac1e6702238799f74ce7da25a8119e1b28.\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/session/ui/TabViewHolder.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/session/ui/TabsPopup.kt"], "git_node": "f9d1d8f9edc85925694540411ea48b38315623ef", "git_parents": ["67dc6ac359b0881587df5f5ccccc5b3b14a1b294"], "node": "603caf1c600d87b6f0d6855c56af92d812567c57", "parents": ["7849f1decffe0043936f0b1c9737aff63eab9dbe"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066087 - Fix ANR and layout issues in tabs popup r=android-reviewers,avirvara\n\nThis change defers the display of the tabs popup using `View.post` to avoid potential ANRs in `HardwareRenderer.nSetName` that can occur during window transitions, such as when the keyboard is hiding. It also improves lifecycle management by dismissing and nullifying the popup in `onDestroyView`.\n\nAdditionally:\n- Adds checks to prevent showing the popup if it is already visible or if the fragment is being removed.\n- Disables the `TabsPopup` animation style to prevent transition conflicts.\n- Fixes a layout issue in `TabViewHolder` where padding was not being correctly reset or calculated for different item types, leading to incorrect offsets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321549\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/session/ui/TabViewHolder.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/session/ui/TabsPopup.kt"], "git_node": "53cfb5ed074ab5168b29c4e6f7504f5393d48ed8", "git_parents": ["f9d1d8f9edc85925694540411ea48b38315623ef"], "node": "e75b99b93ca7766f33fd87d3c8caa63735384e58", "parents": ["603caf1c600d87b6f0d6855c56af92d812567c57"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2065441, Bug 2065079 - filter autofill login candidates without decryption r=dimi\" for causing bc failures @browser_context_menu_iframe.js.\n\nThis reverts commit 562343eb3f13bd81cd65a1d17cc7bc0f9f915e0e.\n\nRevert \"Bug 2065079 - add test for unexpected PrP prompts r=dimi\"\n\nThis reverts commit 3c4ad8f1ad8f58557831678e819826a787914815.\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_autofill_primary_password.js"], "git_node": "02ab0cd0479ab4699bd27765869c68696b6a028c", "git_parents": ["53cfb5ed074ab5168b29c4e6f7504f5393d48ed8"], "node": "8980574f90e8e49a49a9f061dda4d306b5795de7", "parents": ["e75b99b93ca7766f33fd87d3c8caa63735384e58"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2066032 - Add aarch64 video decode support to ffvpx. r=padenot,stransky,media-playback-reviewers\n\nStop forcing MOZ_FFVPX_AUDIOONLY on Linux/BSD aarch64 so VP8/VP9/AV1\n(and VAAPI/Vulkan when enabled) build like other aarch64 targets, and\nenable CONFIG_LIBDAV1D in config_unix_aarch64.h to match unix64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322091\n", "files": ["media/ffvpx/config_unix_aarch64.h", "toolkit/moz.configure"], "git_node": "277eb5ff66bbffa04202d6e6166e9bbcb5709d0c", "git_parents": ["02ab0cd0479ab4699bd27765869c68696b6a028c"], "node": "f7433f0b5f85274ff51a75eb729999373d270ec2", "parents": ["8980574f90e8e49a49a9f061dda4d306b5795de7"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067405 - mark hal's sInitialized as maybe_unused. r=gsvelto\n\nEvery read of sInitialized happens inside a MOZ_ASSERT, so opt builds only ever write to it. clang 23\nflags that under -Wunused-but-set-global, which -Wall now enables transitively via\n-Wunused-but-set-variable, busting the plain clang-trunk build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322068\n", "files": ["hal/Hal.cpp"], "git_node": "0c383a8505dbe24fa5e178a7818eb149ca3f13a8", "git_parents": ["277eb5ff66bbffa04202d6e6166e9bbcb5709d0c"], "node": "fb9bbc020d3d39d664cdca554e6b776d07477108", "parents": ["f7433f0b5f85274ff51a75eb729999373d270ec2"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064957 - Dialogs aren't enabled if there's no viewer. r=dom-core-reviewers,vhilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321798\n", "files": ["dom/base/nsGlobalWindowOuter.cpp"], "git_node": "3aa51796e508426ba3f826430405700056e31dce", "git_parents": ["0c383a8505dbe24fa5e178a7818eb149ca3f13a8"], "node": "4c29d52a46b366e8d5600c8920b9d71f15b9a2f9", "parents": ["fb9bbc020d3d39d664cdca554e6b776d07477108"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067230 - Set white-space:pre on EditContext anonymous element. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321957\n", "files": ["dom/html/EditContext.cpp", "testing/web-platform/tests/editing/edit-context/edit-context-delete-whitespace.tentative.html"], "git_node": "980e89fdcb3cfe520f7bace6ec4db17f4b47c997", "git_parents": ["3aa51796e508426ba3f826430405700056e31dce"], "node": "1a8d11a3977491a326ba05239a04eb4664fa729a", "parents": ["4c29d52a46b366e8d5600c8920b9d71f15b9a2f9"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064408 - Add `keys_optional` fxa_status capability r=android-reviewers,gmalekpour\n\nAs part of 'sync decoupling' bug 1977876, we need to be able to communicate with firefox accounts so they can determine when to enforce generation of keys during authentication. `keys_optional=true` is the way we do this, and this commit adds that capability.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321894\n", "files": ["mobile/android/android-components/components/feature/accounts/src/main/java/mozilla/components/feature/accounts/FxaWebChannelFeature.kt", "mobile/android/android-components/components/feature/accounts/src/test/java/mozilla/components/feature/accounts/FxaWebChannelFeatureTest.kt"], "git_node": "576979d20bae230ff2d9bf492b491cc0963d056b", "git_parents": ["980e89fdcb3cfe520f7bace6ec4db17f4b47c997"], "node": "efa70c24c85774caa753a8e885a66edbfb8350d7", "parents": ["1a8d11a3977491a326ba05239a04eb4664fa729a"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065168 - Create SyncStateStorage that will contain information about the sync state r=android-reviewers,twhite\n\nWe previously had the sync states accessed directly via functions, so this commit unifies those accesses behind a storage API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321816\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/service/firefox-accounts/build.gradle", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/SyncStateStorage.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/SharedPrefsSyncStateStorageTest.kt"], "git_node": "ed368522dfe1e2f9a18ad96dd80f8de9439aa9ad", "git_parents": ["576979d20bae230ff2d9bf492b491cc0963d056b"], "node": "a89a85a2a19fcbe3597c9f4c8dbd81e7b35cc2c6", "parents": ["efa70c24c85774caa753a8e885a66edbfb8350d7"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065168 - Update direct access of syncPrefs to use the SyncStateStorage API r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321817\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/GlobalAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/TestRustSyncManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/WorkManagerSyncDispatcherTest.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/WorkManagerSyncManagerTest.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/WorkManagerSyncWorkerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountSettingsFragment.kt"], "git_node": "0b3b487c90f5f3452c4970bc23b6740cb6aae9b3", "git_parents": ["ed368522dfe1e2f9a18ad96dd80f8de9439aa9ad"], "node": "6f430f1a181292683176dec2e34813f80e1dbfcd", "parents": ["a89a85a2a19fcbe3597c9f4c8dbd81e7b35cc2c6"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056841: Eliminate race on OriginInfo changes by holding mutex continuously. r=dom-storage-reviewers,hsingh\n\nTo avoid deadlocks, the DirtyTrackingAutoLock had to be unlocked for IO\nthread operations. This allowed the weak reference it contained to\nexpire when the related in-memory OriginInfo was concurrently removed or\nreplaced, causing MaybeUpdateSize and GroupInfo failures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314958\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/CanonicalQuotaObject.cpp", "dom/quota/DirtyTrackingAutoLock.cpp", "dom/quota/DirtyTrackingAutoLock.h"], "git_node": "24efc699dee41ffd6bb0326016fec8ee594a5b79", "git_parents": ["0b3b487c90f5f3452c4970bc23b6740cb6aae9b3"], "node": "2d1cf11ff92120039f190b2472e41c2df39c2135", "parents": ["6f430f1a181292683176dec2e34813f80e1dbfcd"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055043 - Re-enable browser_test_position_sticky.js under Nova r=sthompson,hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316627\n", "files": ["gfx/layers/apz/test/mochitest/browser.toml"], "git_node": "1ad693ba2faa6a76599de9ed138c09b69902e0a2", "git_parents": ["24efc699dee41ffd6bb0326016fec8ee594a5b79"], "node": "a2ad7c8f0e6c9c61c86b4affb936b00415922996", "parents": ["2d1cf11ff92120039f190b2472e41c2df39c2135"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067364 - Part 1. Implement adapter match selection from the gfx blocklist. r=gfx-reviewers,nical\n\nThis allows us to match, via the downloadable blocklist, entries to\nthe secondary adapter, or a wildcard to match any adapter. This is\nuseful for situations like hardware encoding, where the primary\ndevice may be acceptable (e.g. NVIDIA) but the secondary device is\nnot (e.g. old Intel), and the platform encoder may end up using the\nsecondary for hardware encoding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322056\n", "files": ["toolkit/mozapps/extensions/Blocklist.sys.mjs", "widget/GfxDriverInfo.cpp", "widget/GfxDriverInfo.h", "widget/GfxInfoAdapterMatchDefs.inc", "widget/GfxInfoBase.cpp", "widget/moz.build", "widget/windows/GfxInfo.cpp"], "git_node": "158f247b4db1b3e11ace0177faf6cb5e136c8b66", "git_parents": ["1ad693ba2faa6a76599de9ed138c09b69902e0a2"], "node": "847953ce71ff05422ea698fedeca625aec383c9b", "parents": ["a2ad7c8f0e6c9c61c86b4affb936b00415922996"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067364 - Part 2. Add tests for gfx blocklist adapter matching. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322057\n", "files": ["toolkit/mozapps/extensions/test/xpcshell/data/test_gfxBlocklist_AdapterMatch.json", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_gfx.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_gfxBlocklist_AdapterMatch_Any.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_gfxBlocklist_AdapterMatch_Secondary.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/xpcshell.toml", "widget/GfxInfoBase.cpp", "widget/GfxInfoBase.h", "widget/nsIGfxInfoDebug.idl"], "git_node": "72b784813f5f33d79105a846e604f2c2b490f242", "git_parents": ["158f247b4db1b3e11ace0177faf6cb5e136c8b66"], "node": "198c3405abdf2d5301e39de6536fbeaf9dca1f91", "parents": ["847953ce71ff05422ea698fedeca625aec383c9b"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048390 - Block old Intel/AMD devices/drivers from hardware encoding distilled from crash reports. r=gfx-reviewers,media-playback-reviewers,nical,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322058\n", "files": ["widget/windows/GfxInfo.cpp"], "git_node": "d02caf81ab6ef0bbe70fcbe4e6388923d1744e96", "git_parents": ["72b784813f5f33d79105a846e604f2c2b490f242"], "node": "78b269c400a0406eaeb200f670c6199defde5e13", "parents": ["198c3405abdf2d5301e39de6536fbeaf9dca1f91"], "tags": []}], "date": 1788194000, "git_changesets": ["a0618677128769eee435df59d03c5b09957c7aa3", "f5b3e3f51b2a775db6d4240248525a62d62ee7b1", "5c44cb6ca110b934ea6bb680a8c93b32e3d45ec9", "a7798ce75009294cd9e0a1052e9cf5d7d2764df2", "1675a0b38e4f89ef4f0b6c72c9e228142dc09659", "fd616354a1df22fa063338bd098a9b07332b8456", "be8c90d990b25f8be9c0c86f35586bbd52108bf7", "0923fe276d168409e72367e16cea190f95da