n\nDifferential Revision: https://phabricator.services.mozilla.com/D316716\n", "files": ["browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_initialization.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_mutations.js", "browser/components/aiwindow/ui/test/browser/browser_smartformfill_shadow_dom.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartformfill_metadata_lifecycle.js", "browser/components/aiwindow/ui/test/browser/head_smartformfill_autocomplete.js", "browser/components/aiwindow/ui/test/browser/test_smartformfill.html", "browser/components/aiwindow/ui/test/browser/test_smartformfill_formless_fields.html", "browser/components/aiwindow/ui/test/browser/test_smartformfill_multiple_forms.html", "browser/components/aiwindow/ui/test/browser/test_smartformfill_populated_fields.html", "browser/components/aiwindow/ui/test/browser/test_smartformfill_shadow_dom.html", "browser/components/aiwindow/ui/test/browser/test_smartformfill_supported_fields.html"], "git_node": "11ea5f007ed5d8679cc241029802efd00fd43c45", "git_parents": ["f9525a8c3c64435a5430b6a3f1c6b72e076255c3"], "node": "cfca8ef14260835a0d21e3af47dba8bfcca4a073", "parents": ["179b0036bcaf99ce317c9ea0892c9fe81f5bf999"], "tags": []}, {"author": "alexical \u003cdothayer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005954 - Create Collector Log Analyzer UI in about:memory r=smaug,mccr8,desktop-theme-reviewers,frontend-codestyle-reviewers,mossop,emilio\n\nThis patch covers the frontend and backend of a CC/GC log analyzer tool.\nLet me know if you'd like me to split this patch into smaller pieces, but\nit's all interrelated enough that it felt right to put it into one. In either\ncase I would recommend pulling the patch and playing with the UI on some heavy\nCC/GC logs if you have time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282529\n", "files": ["dom/bindings/Bindings.conf", "dom/chrome-webidl/CollectorLogAnalyzer.webidl", "dom/chrome-webidl/moz.build", "toolkit/components/aboutmemory/content/aboutMemory.css", "toolkit/components/aboutmemory/content/aboutMemory.js", "toolkit/components/aboutmemory/content/aboutMemory.xhtml", "toolkit/components/aboutmemory/tests/chrome.toml", "toolkit/components/aboutmemory/tests/test_collectorLogAnalyzer.xhtml", "tools/lint/eslint/eslint-plugin-mozilla/lib/environments/privileged.mjs", "xpcom/base/CollectorLogAnalyzer.cpp", "xpcom/base/CollectorLogAnalyzer.h", "xpcom/base/CollectorLogAnalyzerBackground.h", "xpcom/base/moz.build", "xpcom/tests/gtest/TestCollectorLogLoading.cpp", "xpcom/tests/gtest/moz.build"], "git_node": "908042a0d257307df600e7f5bffeea4fd1cfaa5d", "git_parents": ["11ea5f007ed5d8679cc241029802efd00fd43c45"], "node": "a6cf81186fb11b1c8f09f5f9c9daac561f7b23c2", "parents": ["cfca8ef14260835a0d21e3af47dba8bfcca4a073"], "tags": []}, {"author": "alexical \u003cdothayer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005954 - Escape newlines in IDs in FragmentOrElement CC logging r=mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311631\n", "files": ["dom/base/FragmentOrElement.cpp"], "git_node": "fb30077f2d3b660a8238961a2caf4d337d905b90", "git_parents": ["908042a0d257307df600e7f5bffeea4fd1cfaa5d"], "node": "9fce54c79eb36876d2b8f069eab4f00609eac8f7", "parents": ["a6cf81186fb11b1c8f09f5f9c9daac561f7b23c2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066165 - Report the zero-prefix counters per SAP as urlbar.zeroprefix2. r=Standard8,janerik\n\n`urlbar.zeroprefix` becomes `urlbar.zeroprefix2` because the change to a labeled counter breaks continuity for the existing series. The counters record through the parent controller because `Glean` is not exposed in about:newtab's realm, where the newtab bar's view runs. Their label is the input's `sap-name`, which is coarser than the `sap` extra on the urlbar events: that one is derived in the parent from the search source.\n\nThe Legacy Telemetry scalars go in the same commit because a labeled counter can only mirror to a keyed scalar, and test_mirrors.py asserts both directions of the mapping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322251\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/docs/telemetry.md", "browser/components/urlbar/metrics.yaml", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_zeroPrefixTelemetry.js", "browser/components/urlbar/tests/browser-telemetry/browser_zeroPrefix.js", "toolkit/components/telemetry/Scalars.yaml", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "cdb88094b64e12653962c174b88d4e3780d6e97f", "git_parents": ["fb30077f2d3b660a8238961a2caf4d337d905b90"], "node": "c246c4d08a0c71cfd05bd04bda59f553092fe865", "parents": ["9fce54c79eb36876d2b8f069eab4f00609eac8f7"], "tags": []}, {"author": "Masha Lifshin \u003cmlifshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066944 - Update Android fxsuggest tests for the new required suggestion_id r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321422\n", "files": ["mobile/android/android-components/components/feature/fxsuggest/src/test/java/mozilla/components/feature/fxsuggest/FxSuggestSuggestionProviderTest.kt"], "git_node": "988b4fc66eee4ac3cca0b052f396472ddda9005b", "git_parents": ["cdb88094b64e12653962c174b88d4e3780d6e97f"], "node": "948965d653a969efa9cd8c9d45e8cc654aab72cb", "parents": ["c246c4d08a0c71cfd05bd04bda59f553092fe865"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005954 - Fully qualify mozilla::dom in TestCollectorLogLoading.cpp to fix non-unified builds. r=bustage\n", "files": ["xpcom/tests/gtest/TestCollectorLogLoading.cpp"], "git_node": "f44c9b16cd37d3a186fc1e231a3bf510f22cdfda", "git_parents": ["988b4fc66eee4ac3cca0b052f396472ddda9005b"], "node": "3331d793d2c1369afbc4b48c242acfb7e9df4ff0", "parents": ["948965d653a969efa9cd8c9d45e8cc654aab72cb"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063281 - Let content alert, confirm, and prompt dialogs use content's preferred color scheme. r=tabbrowser-reviewers,nsharpley\" for causing bc failure @ browser_ext_themes_pbm.js\n\nThis reverts commit f9525a8c3c64435a5430b6a3f1c6b72e076255c3.\n", "files": ["browser/base/content/test/tabdialogs/browser_tabdialogbox_content_prompts.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "62d98380b650366c5b0f2b389da95ddfb098249e", "git_parents": ["f44c9b16cd37d3a186fc1e231a3bf510f22cdfda"], "node": "9bddbc6ae4063bd552d8831a461ed7880399f6d9", "parents": ["3331d793d2c1369afbc4b48c242acfb7e9df4ff0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005954 - Update test_aboutmemory6.xhtml for the asynchronous CC/GC log list rendering. r=bustage\n\nThe parent-process dump is synchronous, so the test used to read the log\npaths right after clicking. The new onFinish handler clears the section and\nawaits process info before rendering per-process entries, so the test now\nwaits for those entries and reads the paths from them.\n", "files": ["toolkit/components/aboutmemory/tests/test_aboutmemory6.xhtml"], "git_node": "79b196eca26d23eb1db97100440398fc7a0d78e5", "git_parents": ["62d98380b650366c5b0f2b389da95ddfb098249e"], "node": "5881b024fa2e6ffc829ae5f2ad9a3053e11e9cde", "parents": ["9bddbc6ae4063bd552d8831a461ed7880399f6d9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005954 - Make the GC Log button in about:memory reveal the GC log rather than the CC log. r=RyanVM\n", "files": ["toolkit/components/aboutmemory/content/aboutMemory.js"], "git_node": "43df19707fd548311207cbdb27eadf9b2a17f236", "git_parents": ["79b196eca26d23eb1db97100440398fc7a0d78e5"], "node": "2ea416b87861edb9ec1f578d38b71b8ebc815811", "parents": ["5881b024fa2e6ffc829ae5f2ad9a3053e11e9cde"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2068445 - Detach canvas observer when we reassign the filter r=dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322926\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": "3323bdf55a0f06aa69e5872a55b37f3ee564755c", "git_parents": ["43df19707fd548311207cbdb27eadf9b2a17f236"], "node": "ea6028462fd847f6bb9063b588faedbdcb7f316a", "parents": ["2ea416b87861edb9ec1f578d38b71b8ebc815811"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066559 - Newtab stories unblock global Spanish and global English feeds client-side r=ini\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322323\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/docs/v2-system-addon/preferences.md", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/unit/lib/ActivityStream.test.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "006d4f16a55a07c002bd3404e36226b859263569", "git_parents": ["3323bdf55a0f06aa69e5872a55b37f3ee564755c"], "node": "20b54c7799ac4d20ebf4c382e23d9241b6cc595a", "parents": ["ea6028462fd847f6bb9063b588faedbdcb7f316a"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063216 - fix inconsistent bookmark folder node radius for Nova, improve folder icon alignment r=nsharpley\n\nDifferential Revision: 