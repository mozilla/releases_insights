"node": "0d372b889175839ea4c74bfe79caf4cb766f6dc5", "parents": ["752fbfab25bff4b0a3909ffb5316bd77c244ac4e"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2070281 - Avoid duplicate Discover extensions buttons r=rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324470\n", "files": ["browser/base/content/browser-addons.js", "browser/components/extensions/test/browser/browser_unified_extensions_empty_panel.js"], "git_node": "7baba728c5874c016a4d5d8f2a7f18528bdc1e43", "git_parents": ["73a7bc0a7aca965112392f563767decd9f85442d"], "node": "b100f58c3fdf150fc888e4d77dbc5c13907339cc", "parents": ["0d372b889175839ea4c74bfe79caf4cb766f6dc5"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067095 - [customizable-menu] Downstream the `MenuBanner` composable to AC r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324592\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuBanner.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/dimens.xml", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MenuBanner.kt"], "git_node": "8bbccaf84cba09698925bdf7e8d31e72538104eb", "git_parents": ["7baba728c5874c016a4d5d8f2a7f18528bdc1e43"], "node": "74cd3f81a719273050bc4812d4aabf95454656d7", "parents": ["b100f58c3fdf150fc888e4d77dbc5c13907339cc"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070285 - Fix CookieStore subscription restore path r=valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324610\n", "files": ["dom/cookiestore/CookieStoreSubscriptionService.cpp", "dom/cookiestore/moz.build", "dom/cookiestore/test/gtest/TestCookieStoreSubscriptionService.cpp", "dom/cookiestore/test/gtest/moz.build"], "git_node": "08c893c0eac8d8d07ab2bbbf941dba2b025287dd", "git_parents": ["8bbccaf84cba09698925bdf7e8d31e72538104eb"], "node": "c3fe45441f6549f04f5a1d07f6cf130b45766d92", "parents": ["74cd3f81a719273050bc4812d4aabf95454656d7"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067095 - [customizable-menu] Downstream the `MenuBanner` composable to AC r=android-reviewers,petru\" for causing lint failures\n\nThis reverts commit 8bbccaf84cba09698925bdf7e8d31e72538104eb.\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuBanner.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/dimens.xml", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MenuBanner.kt"], "git_node": "67cb7e2a67f798e66dcac787878dc87779d9fbe4", "git_parents": ["08c893c0eac8d8d07ab2bbbf941dba2b025287dd"], "node": "4e70b13f20b02f123c0f3316860eb2a1aab9268a", "parents": ["c3fe45441f6549f04f5a1d07f6cf130b45766d92"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1724931 - Catch SIGSYS on macOS r=afranchuk,crashreporting-reviewers\n\nSIGSYS crashes cannot be reliably caught as an exception, so we need to\nuse the signal mechanism. We simply generalize the mechanism used for\nSIGABRT. The rest of the patch is to actually get test coverage on the\nfeature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324347\n", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/exception_handler.cc", "toolkit/crashreporter/breakpad-client/mac/handler/exception_handler.h", "toolkit/crashreporter/test/CrashTestUtils.sys.mjs", "toolkit/crashreporter/test/nsTestCrasher.cpp", "toolkit/crashreporter/test/unit/test_crash_sigsys.js", "toolkit/crashreporter/test/unit/xpcshell.toml"], "git_node": "a52d3e6163b1e82d481601da7019a364b76f22a3", "git_parents": ["67cb7e2a67f798e66dcac787878dc87779d9fbe4"], "node": "6637de247f50d41640351f25fc3df04e8f3b0c2d", "parents": ["4e70b13f20b02f123c0f3316860eb2a1aab9268a"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2070447 - Add toolchains for clang 23.1.1. r=firefox-build-system-reviewers,sylvestre\n\nWhile here, apply filter-symbols.patch to clang-trunk too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324602\n", "files": ["build/build-clang/clang-23.json", "build/build-clang/clang-trunk.json", "build/build-clang/filter-symbols_clang_23.patch", "build/build-clang/llvmorg-24-init-7822-gcb180d50a8167.patch", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/compiler-rt.yml", "taskcluster/kinds/toolchain/libunwind.yml", "taskcluster/kinds/toolchain/llvm-symbolizer.yml", "taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "5646c3d3b6955b9592d5ddb76aa4b66e89074bfe", "git_parents": ["a52d3e6163b1e82d481601da7019a364b76f22a3"], "node": "1b767e29b6f3593faedf60dad07f4099ac29d2d7", "parents": ["6637de247f50d41640351f25fc3df04e8f3b0c2d"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064412 - Clone build-components tasks with Git, r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324400\n", "files": ["taskcluster/kinds/build-components/kind.yml"], "git_node": "9f2b52976a6172418fbba69b66a62902f1b3f227", "git_parents": ["5646c3d3b6955b9592d5ddb76aa4b66e89074bfe"], "node": "1ef6e219ce1bd6c96d585d8ea1bb948ef9121611", "parents": ["1b767e29b6f3593faedf60dad07f4099ac29d2d7"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069371 - Increase app menu width to fit sign in promo r=desktop-theme-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323607\n", "files": ["browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "841fffc3f2709b6b290067046db753c234c867bd", "git_parents": ["9f2b52976a6172418fbba69b66a62902f1b3f227"], "node": "122d86b1aedf3e057f71a4e2320da9bcba170e89", "parents": ["1ef6e219ce1bd6c96d585d8ea1bb948ef9121611"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070171 - Clear last fallback properly when don't fit after fitting. r=dshin\n\nIf a fallback used to fit, but after fallback none of the positions fit,\nwe end up in the base position, but we didn't clear the last index\nproperly, so the fallback reflow kept triggering.\n\nMove the clear to after the loop, and add a test that repros with or\nwithout overlay scrollbars. Add also the test as a crashtest.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/362\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp", "testing/web-platform/tests/css/css-anchor-position/fallback-no-fit-after-fit-crash.html", "testing/web-platform/tests/css/css-anchor-position/position-try-fallbacks-no-fit-after-fit.html"], "git_node": "c70773c3342a4e27f57a4ce8c05f49eecc9b8bf1", "git_parents": ["841fffc3f2709b6b290067046db753c234c867bd"], "node": "5868bfa1a7ba3fb5628c88e7767f5557284d6251", "parents": ["122d86b1aedf3e057f71a4e2320da9bcba170e89"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2062317, be more synchronous with DOMContentLoaded, r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321732\n", "files": ["docshell/base/nsDocShell.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/base/test/file_domcontentloaded_document_open.html", "dom/base/test/file_domcontentloaded_terminated_parse.html", "dom/base/test/mochitest.toml", "dom/base/test/test_domcontentloaded_document_open.html", "dom/base/test/test_domcontentloaded_terminated_parse.html", "dom/base/test/unit/test_blockParsing.js", "dom/prototype/PrototypeDocumentContentSink.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/xml/XMLDocument.cpp", "dom/xml/XMLDocument.h", "dom/xml/nsXMLContentSink.cpp", "modules/libpref/init/StaticPrefList.yaml", "parser/html/nsHtml5TreeOpExecutor.cpp", "testing/web-platform/meta/html/syntax/parsing/DOMContentLoaded-defer-task-order.tentative.html.ini", "testing/web-platform/meta/html/syntax/parsing/DOMContentLoaded-defer.html.ini", "testing/web-platform/tests/html/syntax/parsing/DOMContentLoaded-defer-task-order.tentative.html", "testing/web-platform/tests/svg/linking/scripted/a.rel-noreferrer-policy.html", "testing/web-platform/tests/svg/linking/scripted/resources/a.rel-noreferrer-policy-frame.html", "testing/web-platform/tests/svg/linking/scripted/resources/a.rel-noreferrer-policy-target.html", "widget/tests/test_dnd_ignoreNuls.html"], "git_node": "91972506c19efdd56cd1192901cea6d8e965485f", "git_parents": ["c70773c3342a4e27f57a4ce8c05f49eecc9b8bf1"], "node": "4e4323316e424e2bc35932b6c354e43f386b5ce1", "parents": ["5868bfa1a7ba3fb5628c88e7767f5557284d6251"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069800 - Buffer cookie database writes and flush them in batched transactions r=cookie-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324548\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/cookie/CookieDBWriteQueue.cpp", "netwerk/cookie/CookieDBWriteQueue.h", "netwerk/cookie/CookieDummyStorage.h", "netwerk/cookie/CookiePersistentStorage.cpp", "netwerk/cookie/CookiePersistentStorage.h", "netwerk/cookie/CookiePrivateStorage.h", "netwerk/cookie/CookieStorage.cpp", "netwerk/cookie/CookieStorage.h", "netwerk/cookie/moz.build", "netwerk/cookie/nsICookieService.idl", "netwerk/test/gtest/TestCookie.cpp", "netwerk/test/unit/test_remove_invalid_first_party_partitioned_cookie.js"], "git_node": "39c4518103985d600a5d8336490b401fc8a48467", "git_parents": ["91972506c19efdd56cd1192901cea6d8e965485f"], "node": "cd67488aca11a52f81a4f8013134af3098c15aee", "parents": ["4e4323316e424e2bc35932b6c354e43f386b5ce1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066396 - Let a caller force keyword fixup regardless of keyword.enabled. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321001\n", "files": ["docshell/base/URIFixup.sys.mjs", "docshell/base/nsIURIFixup.idl", "docshell/test/unit/test_URIFixup_search.js", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "5e6c2f434cfa233e8bf6886641fb8a284c2fe52e", "git_parents": ["39c4518103985d600a5d8336490b401fc8a48467"], "node": "4f6f049aac21ed38784d308ab06ee1bb2a4e4446", "parents": ["cd67488aca11a52f81a4f8013134af3098c15aee"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066396 - Force the keyword lookup for a search bar's fixup. r=mak,urlbar-reviewers\n\nWithout this, fixup hands the newtab search bar a visit result before the provider's gate is reached, so a search string it can't parse as a URL doesn't search while `keyword.enabled` is off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321184\n", "files": ["browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/unit/test_UrlbarProviderSearchSuggestions.js", "browser/components/urlbar/tests/unit/test_providerHeuristicFallback.js", "browser/components/urlbar/tests/unit/test_providerRecentSearches.js"], "git_node": "379a7a7823825e3c4ba19f9c15a29cc3e21c660a", "git_parents": ["5e6c2f434cfa233e8bf6886641fb8a284c2fe52e"], "node": "2f2892633ff8d35b4965cf70cc6cf23947f73034", "parents": ["4f6f049aac21ed38784d308ab06ee1bb2a4e4446"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070360 - Emit the cmff/cvns startup metric under its plain name. r=perftest-reviewers,sparky\n\nandroid_startup_cmff_cvns.py prints a perfMetrics line for the plain\n`\u003ctest\u003e` name alongside `\u003ctest\u003e.mean`, but run_tests only ever stored the\n`.mean` key, so the plain-name lookup raised KeyError at the end of every\nrun. The crash was invisible until Bug 2059094 made mozperftest check the\nscript's return code, which turned it into a perma-fail on\napplink-startup-first-frame and applink-startup-navigation-start.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324619\n", "files": ["testing/performance/mobile-startup/android_startup_cmff_cvns.py"], "git_node": "bdcd29a038cffaf23e3ad7a75c719f96156c4108", "git_parents": ["379a7a7823825e3c4ba19f9c15a29cc3e21c660a"], "node": "492bdcf8d581544fddc0fea688209e034ebc35f5", "parents": ["2f2892633ff8d35b4965cf70cc6cf23947f73034"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2069897 - Use encoding_rs 0.8.40 from crates.io. r=supply-chain-reviewers,glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324016\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "supply-chain/audits.toml", "supply-chain/config.toml", "supply-chain/imports.lock", "third_party/rust/encoding_rs/.cargo-checksum.json", "third_party/rust/encoding_rs/.cargo_vcs_info.json", "third_party/rust/encoding_rs/Cargo.lock", "third_party/rust/encoding_rs/Cargo.toml", "third_party/rust/encoding_rs/Cargo.toml.orig", "third_party/rust/encoding_rs/README.md", "third_party/rust/encoding_rs/build.rs", "third_party/rust/encoding_rs/src/lib.rs", "third_party/rust/encoding_rs/src/mem.rs", "third_party/rust/encoding_rs/src/simd_funcs.rs"], "git_node": "7519034a656c1caf553538fd3d36898773a60a66", "git_parents": ["bdcd29a038cffaf23e3ad7a75c719f96156c4108"], "node": "40d3ada3c1a3b7ae0dfa2ca10d806552cf080129", "parents": ["492bdcf8d581544fddc0fea688209e034ebc35f5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070503 - Use an empty atom to store the universal name of PtNameAndClassSelectors. r=dshin\n\nSince \"*\" is a real name if escaped.\n\nThis fixes the tests in https://github.com/web-platform-tests/wpt/pull/62480\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/361\n", "files": ["servo/components/style/gecko/pseudo_element.rs"], "git_node": "77a4943235d8c993228dba9bd4d4b92cb7f38b82", "git_parents": ["7519034a656c1caf553538fd3d36898773a60a66"], "node": "8f6dd4abc6f0f733f650b02c9fbc24c38c4b1e0b", "parents": ["40d3ada3c1a3b7ae0dfa2ca10d806552cf080129"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2069724 - Ensure elements with percentage units update on resize r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324101\n", "files": ["dom/svg/SVGContentUtils.cpp", "dom/svg/SVGContentUtils.h", "layout/svg/SVGContainerFrame.cpp", "layout/svg/SVGForeignObjectFrame.cpp", "layout/svg/SVGGeometryFrame.cpp", "layout/svg/SVGImageFrame.cpp", "layout/svg/SVGTextFrame.cpp", "testing/web-platform/tests/svg/styling/invalidation/pct-filter-ref.html", "testing/web-platform/tests/svg/styling/invalidation/pct-filter.html", "testing/web-platform/tests/svg/styling/invalidation/pct-marker-ref.html", "testing/web-platform/tests/svg/styling/invalidation/pct-marker.html", "testing/web-platform/tests/svg/styling/invalidation/pct-stroke-dasharray-01-ref.html", "testing/web-platform/tests/svg/styling/invalidation/pct-stroke-dasharray-01.html", "testing/web-platform/tests/svg/styling/invalidation/pct-stroke-dasharray-02-ref.html", "testing/web-platform/tests/svg/styling/invalidation/pct-stroke-dasharray-02.html"], "git_node": "c7ba2c819523d2df4b2305be3dbcf9f24d8eb693", "git_parents": ["77a4943235d8c993228dba9bd4d4b92cb7f38b82"], "node": "64dfaea69aa0e0a38b410352313a34d286e56bdf", "parents": ["8f6dd4abc6f0f733f650b02c9fbc24c38c4b1e0b"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008059 - Run translation perftests on Ubuntu 24.04 r=perftest-reviewers,mozperftest-reviewers,sparky\n\nThe tr8ns perftests were previously pinned to 18.04 due to the window\nmanager not applying window resize requests (now fixed by Bug 1982990)\n\nThe translation jobs run on both 18.04 and 24.04 for ~2 weeks until\nthere is enough time series data available on 24.04 for regression\ndetection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322076\n", "files": ["taskcluster/gecko_taskgraph/transforms/perftest.py", "taskcluster/gecko_taskgraph/transforms/test/linux_perf_platform_restrictions.py"], "git_node": "3fa2fe606c929f50375e6f22f857311004da0aac", "git_parents": ["c7ba2c819523d2df4b2305be3dbcf9f24d8eb693"], "node": "75f7ff9e5fe88411fd18b6fdc5a61487d5d9d9be", "parents": ["64dfaea69aa0e0a38b410352313a34d286e56bdf"], "tags": []}, {"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061276 - FRO: Support Configurable Animations for Corner Illustration Layout r=omc-reviewers,emcminn\n\nAdds support for corner illustrations to be animated, in various styles: fade,\nslide-block, slide-corner, etc. Respects reduced-motion at the OS-level\nby passing in relevant CSS properties (e.g. --corner-image-entrance-delay)\ninline, since undefined values default to the SCSS defaults.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324365\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "681e322cabf5bd2d5a5fbdab5a3c38971306fa8c", "git_parents": ["3fa2fe606c929f50375e6f22f857311004da0aac"], "node": "8f57603dd756bada40e7e7be2326d8b91e405e16", "parents": ["75f7ff9e5fe88411fd18b6fdc5a61487d5d9d9be"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070159 - Require matching credentials before resolving a stored login in the Rust storage backend. r=dimi\n\nfindLoginToUpdate() has dedupe semantics: having already matched on origin, it\npicks by username alone, ignoring the password, and falls back to an entry with\nan empty username. removeLoginAsync(), modifyLoginAsync() and\nrecordPasswordUseAsync() used it to resolve a login that callers pass by value,\nso they could act on a record that differs from the one the caller described.\n\nAdd a #findLoginWithSameCredentials() helper, shared by the three callers, that\nalso requires the username and password to agree.\n\nThe helper deliberately does not use nsILoginInfo.equals() the way the JSON\nbackend's _getIdForLogin() does. The Rust store normalizes origin and\nformActionOrigin on write, so a stored login is frequently not field-for-field\nidentical to the one the caller holds, and comparing every field rejects\nlegitimate callers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324285\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_logins_change.js"], "git_node": "a344d796a501c4cffa458bee2c4a3398324f765f", "git_parents": ["681e322cabf5bd2d5a5fbdab5a3c38971306fa8c"], "node": "d8aa64ae3e6f70c70a6401ea2ccdd8d2f9932baa", "parents": ["8f57603dd756bada40e7e7be2326d8b91e405e16"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067757 - Remove the version 155 train-hop shim for the trending.svg icon rename in newtab. r=jbrown,mstriemer\n\nBug 2050778 renamed `browser/themes/shared/icons/trending.svg` to\n`lightning-bolt.svg` in 155, keeping the old file only so a train-hopped\nnewtab would keep resolving `chrome://browser/skin/trending.svg`. 155 is on\nRelease now, so the shim can go.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322504\n", "files": ["browser/extensions/newtab/content-src/styles/_icons.scss", "browser/themes/shared/icons/trending.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "1bfa5ed5141d0dbabdfa87fc90ff06217e64c0c6", "git_parents": ["a344d796a501c4cffa458bee2c4a3398324f765f"], "node": "ce73be9a131acb766715b30443ef0c34e33ce999", "parents": ["d8aa64ae3e6f70c70a6401ea2ccdd8d2f9932baa"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064412 - Clone build-components tasks with Git, r=taskgraph-reviewers,bhearsum\" for causing toolchain failures\n\nThis reverts commit 9f2b52976a6172418fbba69b66a62902f1b3f227.\n", "files": ["taskcluster/kinds/build-components/kind.yml"], "git_node": "109b4c2da492cab1bfc61d52379be6797159b46f", "git_parents": ["1bfa5ed5141d0dbabdfa87fc90ff06217e64c0c6"], "node": "ca6f3d31a302112c19c405adfd3b390dbcde08d9", "parents": ["ce73be9a131acb766715b30443ef0c34e33ce999"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064412 - Clone build-components tasks with Git, r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324400\n", "files": ["taskcluster/kinds/build-components/kind.yml"], "git_node": "d0f5a8ec2230b893715a14cd924c61a4c3d047ff", "git_parents": ["109b4c2da492cab1bfc61d52379be6797159b46f"], "node": "e9d29faf37400e437a9f1dbf0be685b9407fa06a", "parents": ["ca6f3d31a302112c19c405adfd3b390dbcde08d9"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066396 - Force the keyword lookup for a search bar's fixup. r=mak,urlbar-reviewers\" for causing mochitest failures\n\nThis reverts commit 379a7a7823825e3c4ba19f9c15a29cc3e21c660a.\n\nRevert \"Bug 2066396 - Let a caller force keyword fixup regardless of keyword.enabled. r=mak\"\n\nThis reverts commit 5e6c2f434cfa233e8bf6886641fb8a284c2fe52e.\n", "files": ["browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/unit/test_UrlbarProviderSearchSuggestions.js", "browser/components/urlbar/tests/unit/test_providerHeuristicFallback.js", "browser/components/urlbar/tests/unit/test_providerRecentSearches.js", "docshell/base/URIFixup.sys.mjs", "docshell/base/nsIURIFixup.idl", "docshell/test/unit/test_URIFixup_search.js", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "56b727ffe2e6dde5b0f9e3fe2a69770520bf7191", "git_parents": ["d0f5a8ec2230b893715a14cd924c61a4c3d047ff"], "node": "b29098bf3ecca470fa0413d7411585e742af1f0a", "parents": ["e9d29faf37400e437a9f1dbf0be685b9407fa06a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069371 - Increase app menu width to fit sign in promo r=desktop-theme-reviewers,kcochrane\" for causing bc failures @ browser_learn_more_link.js\n\nThis reverts commit 841fffc3f2709b6b290067046db753c234c867bd.\n", "files": ["browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "82f505e5ea9ec96e63ad57a6ee4f07314312a144", "git_parents": ["56b727ffe2e6dde5b0f9e3fe2a69770520bf7191"], "node": "503884163b4793fb61648c20063590c23bf94cf9", "parents": ["b29098bf3ecca470fa0413d7411585e742af1f0a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062317, be more synchronous with DOMContentLoaded, r=farre\" for causing mochitest failures @ browser_about_restricted.js\n\nThis reverts commit 91972506c19efdd56cd1192901cea6d8e965485f.\n", "files": ["docshell/base/nsDocShell.cpp", "dom/base/Document.cpp", "dom/base/Document.h", "dom/base/test/file_domcontentloaded_document_open.html", "dom/base/test/file_domcontentloaded_terminated_parse.html", "dom/base/test/mochitest.toml", "dom/base/test/test_domcontentloaded_document_open.html", "dom/base/test/test_domcontentloaded_terminated_parse.html", "dom/base/test/unit/test_blockParsing.js", "dom/prototype/PrototypeDocumentContentSink.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/xml/XMLDocument.cpp", "dom/xml/XMLDocument.h", "dom/xml/nsXMLContentSink.cpp", "modules/libpref/init/StaticPrefList.yaml", "parser/html/nsHtml5TreeOpExecutor.cpp", "testing/web-platform/meta/html/syntax/parsing/DOMContentLoaded-defer-task-order.tentative.html.ini", "testing/web-platform/meta/html/syntax/parsing/DOMContentLoaded-defer.html.ini", "testing/web-platform/tests/html/syntax/parsing/DOMContentLoaded-defer-task-order.tentative.html", "testing/web-platform/tests/svg/linking/scripted/a.rel-noreferrer-policy.html", "testing/web-platform/tests/svg/linking/scripted/resources/a.rel-noreferrer-policy-frame.html", "testing/web-platform/tests/svg/linking/scripted/resources/a.rel-noreferrer-policy-target.html", "widget/tests/test_dnd_ignoreNuls.html"], "git_node": "5dfbbf94603e38e1b4b46921a6d319e6110ee138", "git_parents": ["82f505e5ea9ec96e63ad57a6ee4f07314312a144"], "node": "00289483bd3e53bb97f9799c2f9fc2e738daf10b", "parents": ["503884163b4793fb61648c20063590c23bf94cf9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070566 - Don't apply wasi-sdk-no-llvm-patches.patch to the clang 23 wasi sysroot. r=firefox-build-system-reviewers,ahochheiden\n\nWith clang 23's libc++, wasi-sdk's own libc++ patches are needed: without them locale_base_api/ibm.h redeclares\nstrtod_l and friends with _LIBCPP_HIDE_FROM_ABI on top of wasi-libc's declarations, and the sysroot build fails\nwith \"cannot add 'abi_tag' attribute in a redeclaration\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324673\n", "files": ["taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "0f27dab14776beb54f4f59666bc05adeb001ab68", "git_parents": ["5dfbbf94603e38e1b4b46921a6d319e6110ee138"], "node": "6236143ea853d7ac8d14142f1e707f6ccf5a82f8", "parents": ["00289483bd3e53bb97f9799c2f9fc2e738daf10b"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2064750 - Apply review feedback to the nimbus-prefs agent skill r=jlockhart,ai4dev-reviewers,suhaib DONTBUILD\n\nFollow-up to D314871, applying the inline corrections left on that revision\nafter it landed.\n\n - lead with the Nimbus feature rather than the pref: a pref is not required\n   and is not the recommended default, add one only for code you do not\n   control (C++, Rust),\n - link experimenter.info for Nimbus background and Pref Experiments for the\n   pref path,\n - rework the mechanism table around what an enrollment actually changes and\n   whether Nimbus writes the pref,\n - correct the type-mismatch failure mode: the enrollment is stored while its\n   prefs, observers and telemetry are skipped, so it looks absent rather than\n   wrong; document json/string and the absence of a float type,\n - document waiting for the experiment store before the first read, and that\n   installing the fallbackPref observer needs getAllVariables(), not\n   getVariable(),\n - add the setPref read path: watch the pref, never write it from the handler,\n - correct the mirror: once explanation (all once mirrors fill together on the\n   first read of any of them) and add the rust: true requirement,\n - correct the exposure claim: analysis still runs on the enrollment basis,\n   what is lost is the exposure basis, and note hasExposure is declarative\n   only,\n - note that Glean's JS metric identifiers are a runtime lookup, not codegen\n   checked,\n - add Nimbus Developer Tools, the optin_collection caveat, the browser and\n   python test suites, and an \"After it lands\" section on Experimenter's\n   manifest fetch and minimum-version validation.\n\nThe two files are identical copies, so both carry the same changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324638\n", "files": [".agents/skills/nimbus-prefs/SKILL.md", ".claude/skills/nimbus-prefs/SKILL.md"], "git_node": "4a875b4bf5196d50cf37b7cf92d3fab75ccbed5f", "git_parents": ["0f27dab14776beb54f4f59666bc05adeb001ab68"], "node": "c8e3603a2742bb7019b6f5f8fae1fa44896aa1d2", "parents": ["6236143ea853d7ac8d14142f1e707f6ccf5a82f8"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067095 - [customizable-menu] Downstream the `MenuBanner` composable to AC r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324592\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuBanner.kt", "mobile/android/android-components/components/compose/menu/src/main/res/values/dimens.xml", "mobile/android/fenix/.buildconfig.yml", "mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MenuBanner.kt"], "git_node": "f052455619779175711cf8c67b0b77b287dcbd46", "git_parents": ["4a875b4bf5196d50cf37b7cf92d3fab75ccbed5f"], "node": "ccd787bf09e0f7c5bc36229622f26fe072445903", "parents": ["c8e3603a2742bb7019b6f5f8fae1fa44896aa1d2"], "tags": []}], "date": 1788988252, "git_changesets": ["eca98b505f254ea1d3a6e1af8765bcaad59dc4f1", "73a7bc0a7aca965112392f563767decd9f85442d", "7baba728c5874c016a4d5d8f2a7f18528bdc1e43", "8bbccaf84cba09698925bdf7e8d31e72538104eb", "08c893c0eac8d8d07ab2bbbf941dba2b025287dd", "67cb7e2a67f798e66dcac787878dc87779d9fbe4", "a52d3e6163b1e82d481601da7019a364b76f22a3", "5646c3d3b6955b9592d5ddb76aa4b66e89074bfe", "9f2b52976a6172418fbba69b66a62902f1b3f227", "841fffc3f2709b6b290067046db753c234c867bd", "c70773c3342a4e27f57a4ce8c05f49eecc9b8bf1", "91972506c19efdd56cd1192901cea6d8e965485f", "39c4518103985d600a5d8336490b401fc8a48467", "5e6c2f434cfa233e8bf6886641fb8a284c2fe52e", "379a7a7823825e3c4ba19f9c15a29cc3e21c660a", "bdcd29a038cffaf23e3ad7a75c719f96156c4108", "7519034a656c1caf553538fd3d36898773a60a66", "77a4943235d8c993228dba9bd4d4b92cb7f38b82", "c7ba2c819523d2df4b2305be3dbcf9f24d8eb693", "3fa2fe606c929f50375e6f22f857311004da0aac", "681e322cabf5bd2d5a5fbdab5a3c38971306fa8c", "a344d796a501c4cffa458bee2c4a3398324f765f", "1bfa5ed5141d0dbabdfa87fc90ff06217e64c0c6", "109b4c2da492cab1bfc61d52379be6797159b46f", "d0f5a8ec2230b893715a14cd924c61a4c3d047ff", "56b727ffe2e6dde5b0f9e3fe2a69770520bf7191", "82f505e5ea9ec96e63ad57a6ee4f07314312a144", "5dfbbf94603e38e1b4b46921a6d319e6110ee138", "0f27dab14776beb54f4f59666bc05adeb001ab68", "4a875b4bf5196d50cf37b7cf92d3fab75ccbed5f", "f052455619779175711cf8c67b0b77b287dcbd46"], "user": "asilaghi@mozilla.com"}, "45292": {"changesets": [{"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064412 - Clone build-components tasks with Git, r=taskgraph-reviewers,bhearsum\" for causing signing failures\n\nThis reverts commit d0f5a8ec2230b893715a14cd924c61a4c3d047ff.\n", "files": ["taskcluster/kinds/build-components/kind.yml"], "git_node": "8db09b47689dcfc25671b178619b03ad214c6369", "git_parents": ["f052455619779175711cf8c67b0b77b287dcbd46"], "node": "920a52be5d43046ea3df130dea626f8ba9a04e97", "parents": ["ccd787bf09e0f7c5bc36229622f26fe072445903"], "tags": []}], "date": 1789000041, "git_changesets": ["8db09b47689dcfc25671b178619b03ad214c6369"], "user": "ctuns@mozilla.com"}, "45293": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069948 - Do not let cookieStore.delete() remove cookies set on a parent domain r=valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324620\n", "files": ["dom/cookiestore/CookieStoreParent.cpp", "testing/web-platform/tests/cookiestore/cookieStore_delete_domain.sub.https.html", "testing/web-platform/tests/cookiestore/resources/delete_domain-child.sub.https.html"], "git_node": "1e7525bb741410ca750befafd4af820b90561f1f", "git_parents": ["f052455619779175711cf8c67b0b77b287dcbd46"], "node": "61fabaf9895b4ef50bb9a2c412fd38df14b5c950", "parents": ["ccd787bf09e0f7c5bc36229622f26fe072445903"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2070311 - Fix interaction of rule cache reset reuse and visited optimization. r=dshin\n\nWe're hitting the \"used cached reset properties\" path, and thus we don't\nnotice that .item indeed sets border-color, which is a visited dependent\nproperty. So we end up incorrectly with `border-color: currentcolor` in\nthe computed style, and thus wrong rendering.\n\nTrack the \"used visited dependent properties\" with a style bit and carry\nthat around instead.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/360\n", "files": ["layout/reftests/css-visited/visited-rule-cache-1-ref.html", "layout/reftests/css-visited/visited-rule-cache-1.html", "layout/style/test/moz.build", "layout/style/test/test_visited_reftests.html", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/computed_value_flags.rs"], "git_node": "8c2245fa4a4bd72d7bb5259701af6654f6a3c4f8", "git_parents": ["1e7525bb741410ca750befafd4af820b90561f1f"], "node": "4f3cdf2c99e082843217975343c314e9c2df1c4f", "parents": ["61fabaf9895b4ef50bb9a2c412fd38df14b5c950"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070249: Prevent unsigned values in binary search. r=mfbt-reviewers,glandium\n\nIt is relatively easy for unsigned values to sneak into a binary search,\nin which case `result \u003c 0` will always return false. Statically\nasserting that the result is not unsigned prevents this.\n\nTechnically this condition is a little bit loose, in that things like\n`bool` still slip through. There are probably some nasty ways of getting\na very precise type assertion using concepts or something, but unsigned\nseems like the biggest and most obvious footgun.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324362\n", "files": ["mfbt/BinarySearch.h"], "git_node": "f16e730a7e8c63ad2fdf957179af987700ba69f1", "git_parents": ["8c2245fa4a4bd72d7bb5259701af6654f6a3c4f8"], "node": "5b6ee952c944a471cfedb9ab6c41d901c111112d", "parents": ["4f3cdf2c99e082843217975343c314e9c2df1c4f"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063653 - Add a null check for mConnection in nsHttpTransaction::HandleContentStart r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324590\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": "f236a0424afc891d5bb27dd31f58e4b7686093d6", "git_parents": ["f16e730a7e8c63ad2fdf957179af987700ba69f1"], "node": "68beb3d33b59004e6fcba90ee1b6cb066d98934f", "parents": ["5b6ee952c944a471cfedb9ab6c41d901c111112d"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066838 - Add telemetry for the resumption outcome r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321573\n", "files": ["netwerk/metrics.yaml", "netwerk/protocol/http/Http3Session.cpp", "security/manager/ssl/NSSSocketControl.cpp", "security/manager/ssl/NSSSocketControl.h"], "git_node": "0ea3bb6c3d88eb1fdfbc3c80fc08672f50e7f582", "git_parents": ["f236a0424afc891d5bb27dd31f58e4b7686093d6"], "node": "cbdf51a3906e78598b90c6236dea3bcc436a9325", "parents": ["68beb3d33b59004e6fcba90ee1b6cb066d98934f"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067215 - Use system AccentColor for LWT links, focus r=desktop-theme-reviewers,tabbrowser-reviewers,nsharpley,emilio\n\nPreviously we were forcing our brand blue/cyan color for some properties\nwhen a LWT was installed. This resulted in some elements getting the\nblue/cyan focus color and others getting the system AccentColor.\n\nThe system AccentColor is already used for primary buttons and\ncheckbox/radio fills, and it's technically configurable by the user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324404\n", "files": ["browser/themes/shared/browser-colors.css", "toolkit/themes/shared/design-system/src/toolbar.css"], "git_node": "f46e64f8f6353f1091917d636237fabbfd89448e", "git_parents": ["0ea3bb6c3d88eb1fdfbc3c80fc08672f50e7f582"], "node": "148e2f41b3de6fc488d113f58a819377d193505f", "parents": ["cbdf51a3906e78598b90c6236dea3bcc436a9325"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2057579 - Complete the CSSMatrixComponent and CSSTransformComponent implementations; r=emilio,firefox-style-system-reviewers\n\nComplete the remaining `CSSMatrixComponent` functionality by implementing the\nmissing `matrix` setter and `ToMatrix()`, including the required 2D flattening.\n\nThis completes `CSSTransformComponent::ToMatrix()` dispatch and enables the\nremaining WPT coverage for transform component objects.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314899\n", "files": ["layout/style/typedom/CSSMatrixComponent.cpp", "layout/style/typedom/CSSMatrixComponent.h", "layout/style/typedom/CSSTransformComponent.cpp", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssMatrixComponent.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-2d-flattening.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-toMatrix.html.ini"], "git_node": "88ab304cdd21dc27822b3e8da4e775ea92e00e51", "git_parents": ["f46e64f8f6353f1091917d636237fabbfd89448e"], "node": "16bd00cb18b5b1370286602702e197b146717a76", "parents": ["148e2f41b3de6fc488d113f58a819377d193505f"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070565 - Enable ORB on Android Nightly. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324648\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "e01339c1c48419b689873b1f858954d942bb78e5", "git_parents": ["88ab304cdd21dc27822b3e8da4e775ea92e00e51"], "node": "4dd9aabad392fcd942a5f2c8e85fc5a32b3d903a", "parents": ["16bd00cb18b5b1370286602702e197b146717a76"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062608 - Resolve the pending AwaitNextChunkManagerUpdate reply before the ProfilerChild channel is closed. r=profiler-reviewers,canova\n\nBug 2062608 - Resolve pending chunk update before ProfilerChild closes. r?canova\n\nWhile profiling, ProfilerParent keeps one AwaitNextChunkManagerUpdate\nrequest outstanding in every child process. ProfilerChild::Destroy()\nclosed the channel without touching the parked resolver, so every\ngraceful child shutdown while profiling dropped it and IPC emitted the\ntwo warnings from this bug. With the profiler now running during\nmochitests, this is the top warning pair in CI.\n\nDestroy() now processes a final chunk manager update before Close(),\nwhile the channel is still open. That is the same notification\nRecvStop() sends, and ProfilerParent handles it just like the rejection\nit used to get, so behaviour is unchanged. ActorDestroy() consumes the\nresolver as well for parent-initiated teardowns, where the reply can no\nlonger be sent.\n\nRecvWaitOnePeriodicSampling and RecvGatherProfile can drop their\nresolvers the same way; they are rarer and need separate handling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317841\n", "files": ["tools/profiler/gecko/ProfilerChild.cpp"], "git_node": "a2381a507d99238d907e9123162a0df04b6e3167", "git_parents": ["e01339c1c48419b689873b1f858954d942bb78e5"], "node": "b789bf33b107cbf0f2651a27547af6679cfda0bc", "parents": ["4dd9aabad392fcd942a5f2c8e85fc5a32b3d903a"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - doc: keep relative document links inside the staging tree r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nCaused by the Sphinx 7.4.7 -\u003e 9.0.4 upgrade earlier in this stack:\nBuildEnvironment.relfn2path used to normalise with path.normpath(), and\nnow uses Path.resolve(). Since the docs are built from a staging tree of\nsymlinks into the source tree, resolve() follows the symlink of the\ndocument being linked to and lands outside the Sphinx source directory,\nso myst-parser reports \"Unknown source document\" - 1339 warnings on a\nclean build.\n\nOverride relfn2path to normalise textually again, so \"..\" still collapses\nbut the path stays in the staging tree. Known failures drop from 1624 to\n298. The 13 newly reported ones are the already-allowlisted \"local id not\nfound in doc\": links reaching the right document but a stale anchor,\npreviously masked by the link failing outright.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324436\n", "files": ["docs/_addons/staging_paths.py", "docs/conf.py", "docs/config.yml"], "git_node": "21ec718ad5fe490f11ab0a8877d1969164805177", "git_parents": ["a2381a507d99238d907e9123162a0df04b6e3167"], "node": "defe56966f67f02ff4819100d2b5073562e3a08a", "parents": ["b789bf33b107cbf0f2651a27547af6679cfda0bc"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066740 - Update vertical New Tab button text color to match icon fill r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323632\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "8fb310698becbecce3af3cf6727dd1f6e4c90771", "git_parents": ["21ec718ad5fe490f11ab0a8877d1969164805177"], "node": "00eee4e6394fb66d1e4347867d5535021387f082", "parents": ["defe56966f67f02ff4819100d2b5073562e3a08a"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052468 - Treat an undeclared PayloadFields in a BaseMarkerType subclass as empty r=canova,profiler-reviewers\n\nBaseMarkerType now provides an empty default PayloadFields member, so marker\ntypes with no payload no longer need to declare PayloadFields (or an empty\nStreamJSONMarkerData). The PayloadFieldsTuple deduction reuses the existing\nMarkerHasPayloadFields trait to fall back to an empty argument list.\n\nMigrate nsThread.cpp's LongTaskMarker to BaseMarkerType as the first consumer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310299\n", "files": ["mozglue/baseprofiler/public/BaseProfilerMarkersPrerequisites.h", "xpcom/threads/nsThread.cpp"], "git_node": "5a96a6d6ebb276078e452585260a9c4fd451536b", "git_parents": ["8fb310698becbecce3af3cf6727dd1f6e4c90771"], "node": "836739953049e09585fbddfc5b400d389d599a44", "parents": ["00eee4e6394fb66d1e4347867d5535021387f082"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056391 - Update import_passwords secret setting to be visible in nightly to match debug builds. r=android-reviewers,sfamisa\n\nWe still keep the default same as debug while also adding a warning sign to indicate to users that enabling this setting is not recommended.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313146\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "bd855b9924dc8c016e086f5a078cffd277e6b11e", "git_parents": ["5a96a6d6ebb276078e452585260a9c4fd451536b"], "node": "8fce19e95f7a0b84ce7325d037f09c8535f5044e", "parents": ["836739953049e09585fbddfc5b400d389d599a44"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070514 - Update split view triage rotation to two weeks r=tabbrowser-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324601\n", "files": ["browser/components/tabbrowser/splitview/triage.json"], "git_node": "251047fa2f65df2120524a1ce014a13a3121961e", "git_parents": ["bd855b9924dc8c016e086f5a078cffd277e6b11e"], "node": "c4ad0f204230959ad34f94ca5cd74a7fddc6a467", "parents": ["8fce19e95f7a0b84ce7325d037f09c8535f5044e"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070590 - Add WPT tests for Notification.navigate getter. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324661\n", "files": ["testing/web-platform/meta/notifications/shownotification.https.window.js.ini", "testing/web-platform/tests/notifications/shownotification.https.window.js"], "git_node": "d15ed33983a43fdb16cac449b568640afefeedd9", "git_parents": ["251047fa2f65df2120524a1ce014a13a3121961e"], "node": "8bf85c949f0cf4756eca27897e10d74752da4c6c", "parents": ["c4ad0f204230959ad34f94ca5cd74a7fddc6a467"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066492 - Add reliability to the log-based startup tests. r=perftest-reviewers,mozperftest-reviewers,sparky\n\nWe have some intermittents that have been causing issues. We are addressing this by doing 3 things:\n- 1) We are adding a retry attempt to the log-based startup tests\n- 2) We are only installing the opencv dependancy only if the test needs it\n- 3) Increasing the timeout for the pip install from 15 seconds to 120 seconds\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321291\n", "files": ["python/mozperftest/mozperftest/runner.py", "python/mozperftest/mozperftest/test/shellscript.py", "python/mozperftest/mozperftest/tests/data/hooks_script_packages.py", "python/mozperftest/mozperftest/tests/test_mach_commands.py", "python/mozperftest/mozperftest/tests/test_shellscript.py", "python/mozperftest/perfdocs/writing.md", "testing/perfdocs/generated/writing.md", "testing/performance/mobile-startup/android_startup_cmff_cvns.py", "testing/performance/mobile-startup/cvne-newssite.sh", "testing/performance/mobile-startup/cvne-shopify.sh", "testing/performance/mobile-startup/homeview.sh", "testing/performance/mobile-startup/hooks_opencv.py", "testing/performance/mobile-startup/restore.sh"], "git_node": "ea1c209dd6c4d226ca64f5bec93f5617426e6558", "git_parents": ["d15ed33983a43fdb16cac449b568640afefeedd9"], "node": "0a13e2e08d8c009b049977a05161e52c905aa9c8", "parents": ["8bf85c949f0cf4756eca27897e10d74752da4c6c"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068287 - Create a new subpane for built-in VPN rules in settings - r=ip-protection-reviewers,fluent-reviewers,bolsson,akulyk,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323004\n", "files": ["browser/components/preferences/config/LegacyPaneMappings.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/preferences.js", "browser/components/preferences/tests/browser_legacy_pane_mappings.js", "browser/componen