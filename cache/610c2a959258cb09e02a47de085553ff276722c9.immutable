ngs. r=gfx-reviewers,firefox-style-system-reviewers,dshin\n\nThese modules are deprecated / replaced by associated constants, so we\ncan just stop using them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321818\n", "files": ["dom/media/webrtc/sdp/rsdparsa_capi/src/attribute.rs", "gfx/webrender_bindings/src/moz2d_renderer.rs", "gfx/wgpu_bindings/src/server.rs", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/freelist.rs", "gfx/wr/webrender/src/gpu_types.rs", "gfx/wr/webrender/src/image_tiling.rs", "gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/internal_types.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/prim_store/storage.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/render_task_cache.rs", "gfx/wr/webrender/src/render_task_graph.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/resource_cache.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/segment.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender/src/util.rs", "gfx/wr/webrender/src/visibility.rs", "modules/libpref/parser/src/lib.rs", "security/manager/ssl/abridged_certs/src/tls.rs", "servo/components/servo_arc/lib.rs", "servo/components/style/color/gamut/raytrace.rs", "servo/components/style/gecko_string_cache/mod.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/stylesheets/layer_rule.rs", "servo/components/style/values/animated/transform.rs", "servo/components/style/values/computed/angle.rs", "servo/components/style/values/computed/font.rs", "servo/components/style/values/computed/image.rs", "servo/components/style/values/generics/counters.rs", "servo/components/style/values/generics/grid.rs", "servo/components/style/values/generics/transform.rs", "servo/components/style/values/specified/counters.rs", "servo/components/style/values/specified/grid.rs", "servo/components/style/values/specified/image.rs", "servo/components/to_shmem/lib.rs", "servo/ports/geckolib/glue.rs"], "git_node": "5708a8ea6501664985a78c51b682faa32e689cb2", "git_parents": ["f6a8d47d980d16534cd4ca0a127d4b5b93f03fea"], "node": "1be513e5e5f5e834fb6c99735a329c096abebf81", "parents": ["1dac0b5d86d4fa6a6a85d07d500253f551a079a6"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049439 - Part 1: Refactor tokens-config for maintainability r=desktop-theme-reviewers,hjones,fchasen\n\n- Updates StyleDictionary to v5\n- Refactors tokens config for maintainability\n  - Uses ESM rather than CommonJS\n  - Splits functions out into their own files, organized by platform\n  - Supports nested \"nova\" keys for overrides\n- Incidental bug fixes:\n  - Fixes incorrect file name suggestions in `.tokens.css` file comments\n  - Fixes an issue where `calc` could be parsed into padding/margin shorthand\n  - Removes `.anonymous-content-host` from selectors that don't need it\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311175\n", "files": ["toolkit/themes/shared/design-system/config/figma-tokens-config.js", "toolkit/themes/shared/design-system/config/helpers/desktop-format/create-desktop-format.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/format-token.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-browser-theme-value.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-layer-string.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-token-css.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-token-sections.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-tokens-by-layer.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/group-and-sort-tokens.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/is-component-token.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/should-skip-token.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/should-transform-browser-theme-value.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/attempt-padding-margin-destructuring.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/attempt-shadow-destructuring.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/constants.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/create-figma-format.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/filters.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/get-nested-brand-color.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/get-nested-system-color.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/get-override-files.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/get-override-formats.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/get-token-collection.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/is-nested-default-object.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/parse-box-shadow.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/potentially-transform-value.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/replace-references.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/resolve-css-calc.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/transform-token-value.mjs", "toolkit/themes/shared/design-system/config/helpers/figma-format/transforms.mjs", "toolkit/themes/shared/design-system/config/hel