nru -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nsk -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nsl -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nson -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nsq -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nsr -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nsv-SE -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nta -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nte -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nth -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\ntl -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\ntr -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\ntrs -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nuk -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nur -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nuz -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nvi -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nwo -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nxh -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nzam -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nzh-CN -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nzh-TW -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "7386a62c9ef77edb4caf73eaca41f8367a272022", "git_parents": ["84af2f91b21450fdefde13e766bdfc06b0c35cc2"], "node": "b76fdf580e44334d1bb3e71e495e355f96795d0e", "parents": ["ad38ce42b4ebebba2cae510b6ffd5f1542d3574b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064747 - Combine a urlbar result's context menu and three-dot menu. r=daisuke,fluent-reviewers,urlbar-reviewers,bolsson\n\nWith contextMenu.featureGate off, the three-dot menu is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324402\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/components/urlbar/types/urlbar.ts", "browser/locales/en-US/browser/browser.ftl", "browser/themes/shared/urlbar/view-nova.css"], "git_node": "bd204a688747ce8a8677c3c41d344d943ecac0ea", "git_parents": ["7386a62c9ef77edb4caf73eaca41f8367a272022"], "node": "2950c71d6e5d89548662d8aea7b39de139140330", "parents": ["b76fdf580e44334d1bb3e71e495e355f96795d0e"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069288 - Make tests using XSLT flip the pref on. r=dom-core-reviewers,layout-reviewers,dom-worker-reviewers,emilio,smaug,edenchuang\" for causing mochitest failures\n\nThis reverts commit c0dfcea1caf03945435be3c4e1a6431693e87a17.\n", "files": ["browser/components/resistfingerprinting/test/browser/browser-xslt.toml", "browser/components/resistfingerprinting/test/browser/browser.toml", "docshell/test/chrome/chrome-xslt.toml", "docshell/test/chrome/chrome.toml", "dom/base/test/mochitest-bug1.toml", "dom/base/test/mochitest-bug2.toml", "dom/base/test/mochitest-xslt.toml", "dom/events/test/mochitest-xslt.toml", "dom/events/test/mochitest.toml", "dom/html/test/mochitest-bug1.toml", "dom/html/test/mochitest-xslt.toml", "dom/security/featurepolicy/test/mochitest/mochitest-xslt.toml", "dom/security/featurepolicy/test/mochitest/mochitest.toml", "dom/security/test/csp/mochitest-xslt.toml", "dom/security/test/csp/mochitest.toml", "dom/serviceworkers/test/mochitest-common.toml", "dom/serviceworkers/test/mochitest-xslt.toml", "dom/tests/mochitest/bugs/mochitest-xslt.toml", "dom/tests/mochitest/bugs/mochitest.toml", "dom/tests/mochitest/general/mochitest-xslt.toml", "dom/tests/mochitest/general/mochitest.toml", "dom/tests/reftest/reftest.list", "dom/tests/reftest/xml-stylesheet/reftest.list", "dom/xml/test/mochitest-xslt.toml", "dom/xml/test/mochitest.toml", "dom/xslt/crashtests/crashtests.list", "dom/xslt/tests/browser/browser.toml", "dom/xslt/tests/mochitest/mochitest.toml", "layout/reftests/bugs/reftest.list", "testing/web-platform/meta/content-security-policy/xslt/__dir__.ini", "testing/web-platform/meta/dom/idlharness.window.js.ini", "testing/web-platform/meta/service-workers/service-worker/xsl-base-url.https.html.ini", "testing/web-platform/meta/xml/xslt/__dir__.ini"], "git_node": "4d57fe8125c9a1b7e4e734ce981c3951bfb5b2e8", "git_parents": ["bd204a688747ce8a8677c3c41d344d943ecac0ea"], "node": "837c6750efae3d5a757da848bf7ccd9f6fa386f8", "parents": ["2950c71d6e5d89548662d8aea7b39de139140330"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057465 - Handle OOM correctly when removing a property from an object with an ObjectFuse. r=iain\n\nRemoving the property involves shape changes that can fail due to OOM, and marking the\nproperty `Untracked` is invalid in this case. Mark the property `NotConstant` instead\nand only after a successful removal change this to `Untracked`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324325\n", "files": ["js/src/jit-test/tests/fuses/objectfuse-property-remove-oom.js", "js/src/vm/ObjectFuse.cpp", "js/src/vm/ObjectFuse.h", "js/src/vm/Shape.cpp", "js/src/vm/Watchtower.cpp", "js/src/vm/Watchtower.h"], "git_node": "81626f8d9ef16fb17c76c7016009552ecbff278a", "git_parents": ["4d57fe8125c9a1b7e4e734ce981c3951bfb5b2e8"], "node": "552c85f1583f5ff5b9e0d63a4dbeab30ecf9db14", "parents": ["837c6750efae3d5a757da848bf7ccd9f6fa386f8"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2070355 - jit/arm64: fold address compare-zero bailouts into cbz/cbnz. r=jandem\n\nCodeGeneratorARM64::bailoutCmp32 hand-rolled a switch that folds a\ncomparison against zero into a register-test bailout (cbz/cbnz/tbz/tbnz),\nbut only when the left-hand side is a register. An Address operand fell\nthrough to a load, a compare, and a conditional branch:\n\n  ldur w16, [x3, #-0xc]\n  cmp  w16, #0\n  b.ne bailout\n\nbranch32 already performs this fold, and for every operand kind (register,\nAddress, BaseIndex) and zero-comparison condition. Route the bailout\nthrough it -- branch to a local label and hand that label to bailoutFrom,\nas the loong64 backend's bailoutCmp32 already does -- so the duplicated\nswitch and its register-only restriction go away and the Address case\nfolds too:\n\n  ldur w16, [x3, #-0xc]\n  cbnz w16, bailout\n\nCodeGenerator::visitGuardNoDenseElements emits this bailout (guarding\nObjectElements::initializedLength == 0) for every inlined dense-elements\nguard, so on a JetStream 3 run it is all 1,331 Ion findings in armlint's\n'compare-zero branch foldable into CBZ/CBNZ' category (of 53.6M JIT\ninstructions), which the patch drops to zero, removing roughly 5 KB of\nJIT code per run.\n\nThe removed cmp is an off-critical-path uop feeding a predicted branch,\nso a 12-run interleaved Octane A/B of the patch alone was flat on an M4\n(total-score medians within 0.1%); treat it as a code-size and\ninstruction-count win.\n\nFound via armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324440\n", "files": ["js/src/jit/arm64/CodeGenerator-arm64.h"], "git_node": "7fbf5a310129675f856f555a09ed3dd7c2826742", "git_parents": ["81626f8d9ef16fb17c76c7016009552ecbff278a"], "node": "3bd2bbeaafcc6030af81e0ebd27ca4fe1a9cf226", "parents": ["552c85f1583f5ff5b9e0d63a4dbeab30ecf9db14"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 1922677 - Rate limit every navigation. r=smaug,zcorpan,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300744\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/base/nsIDocShell.idl", "docshell/test/navigation/mochitest.toml", "docshell/test/navigation/test_rate_limit_location_change.html", "docshell/test/navigation/test_rate_limit_same_document_navigation.html", "dom/base/Location.cpp", "dom/base/nsHistory.cpp", "dom/base/test/mochitest-bug1.toml", "dom/base/test/mochitest-bug2.toml", "dom/html/test/mochitest-bug1.toml", "dom/html/test/mochitest-bug2.toml", "dom/locales/en-US/chrome/dom/dom.properties", "dom/tests/mochitest/dom-level1-core/mochitest-node.toml", "dom/tests/mochitest/dom-level1-core/mochitest.toml", "dom/tests/mochitest/dom-level2-core/mochitest.toml", "dom/tests/mochitest/dom-level2-html/mochitest-element.toml", "dom/tests/mochitest/dom-level2-html/mochitest-form.toml", "dom/tests/mochitest/dom-level2-html/mochitest-table.toml", "dom/tests/mochitest/dom-level2-html/mochitest.toml", "editor/libeditor/tests/mochitest.toml", "layout/style/test/mochitest.toml", "modules/libpref/init/StaticPrefList.yaml", "parser/htmlparser/tests/mochitest/mochitest.toml", "testing/web-platform/meta/html/browsers/browsing-the-web/navigating-across-documents/navigate_too_many_calls.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_go_too_many_calls.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_pushstate_too_many_calls.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_pushstate_too_many_calls_ordering.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_replacestate_too_many_calls.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_replacestate_too_many_calls_ordering.optional.html.ini"], "git_node": "cdf102b487df4a0d44d72c738d00003a52cca649", "git_parents": ["7fbf5a310129675f856f555a09ed3dd7c2826742"], "node": "e099cac708247b3d93eb738790d728db59d53d69", "parents": ["3bd2bbeaafcc6030af81e0ebd27ca4fe1a9cf226"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061461 - Remove the unreachable login-removal path from the autocomplete actor. r=credential-management-reviewers,dimi\n\nBug 1789298 made LoginAutoCompleteResult.isRemovableAt() return false and\nturned removeValueAt() into a no-op that no longer calls\nAutocompleteItem.removeFromStorage(). Since then nothing in the tree calls\nremoveFromStorage(), so the PasswordManager:removeLogin message it sends has\nno legitimate sender, while LoginManagerParent still handles it.\n\nRemove removeFromStorage() and its overrides, the #actor field of\nLoginAutocompleteItem that only existed to send that message, and the\nPasswordManager:removeLogin handler in LoginManagerParent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324271\n", "files": ["toolkit/components/passwordmgr/LoginAutoComplete.sys.mjs", "toolkit/components/passwordmgr/LoginManagerParent.sys.mjs"], "git_node": "5452c5f8428e7466656eb3b3f3db83ebefba2db8", "git_parents": ["cdf102b487df4a0d44d72c738d00003a52cca649"], "node": "d0675e5d71e00df544ad88b30135d2b96a9a9066", "parents": ["e099cac708247b3d93eb738790d728db59d53d69"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2060247 - Add a WPT for SpeechRecognition.available() with an invalid language tag. r=media-playback-reviewers,alwu\n\nThe availability algorithm rejects with a SyntaxError in its step 3, which so\nfar only install() had coverage for.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322686\n", "files": ["testing/web-platform/tests/speech-api/SpeechRecognition-availableOnDevice.https.html"], "git_node": "f3ebe3ce5be6741d2271aefc29fd127735d412bf", "git_parents": ["5452c5f8428e7466656eb3b3f3db83ebefba2db8"], "node": "d46b8143a34cb49b4f031c3a18363a484bb2491d", "parents": ["d0675e5d71e00df544ad88b30135d2b96a9a9066"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2060247 - Default SpeechRecognition.lang to the document's content language. r=dom-core-reviewers,smaug\n\nAn unset lang defaults to the language of the document root element, which is\nits lang attribute, else the pragma-set default language or the\nContent-Language header.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322687\n", "files": ["dom/media/webspeech/recognition/SpeechRecognition.cpp"], "git_node": "f591b64ffd5f5cb6d88671e3bd5219d800789c33", "git_parents": ["f3ebe3ce5be6741d2271aefc29fd127735d412bf"], "node": "09d864bd2a3065d38ea91fe46abcf8c0619d1f12", "parents": ["d46b8143a34cb49b4f031c3a18363a484bb2491d"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2060247 - Select the speech recognition model from the locales it declares. r=media-playback-reviewers,ai-platform-reviewers,valentinp,alwu\n\nEach models.yaml entry now lists the locales its artifact recognizes, taken from\nthe artifact itself, and a request picks the first entry that recognizes it,\nnegotiated with LocaleService::NegotiateLanguages. That replaces the locale\nprefixes and the multilingual catch-all, so a language no model recognizes no\nlonger reaches one that would transcribe it as another language.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322688\n", "files": ["dom/media/docs/SpeechRecognition.md", "dom/media/webspeech/recognition/SpeechRecognitionModelMapping.cpp", "dom/media/webspeech/recognition/SpeechRecognitionModelMapping.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "dom/media/webspeech/recognition/SpeechRecognitionParent.h", "dom/media/webspeech/recognition/gen_speech_models.py", "dom/media/webspeech/recognition/models.yaml", "dom/media/webspeech/recognition/test/test_parakeet_multilingual.html", "toolkit/components/ml/docs/HWInference.md"], "git_node": "f5c06603c292dbd314eb3eb6c0a49b93a31ac1fe", "git_parents": ["f591b64ffd5f5cb6d88671e3bd5219d800789c33"], "node": "7de42607af6a3904959702d3691ea1b76e580c4f", "parents": ["09d864bd2a3065d38ea91fe46abcf8c0619d1f12"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2060247 - Add a gtest for speech recognition locale negotiation. r=media-playback-reviewers,alwu\n\nIt walks every locale every model declares, and checks that the model answering\nfor one declares the locale it hands back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322689\n", "files": ["dom/media/gtest/TestSpeechModelMapping.cpp", "dom/media/gtest/moz.build"], "git_node": "3b5043bac860cf073b0cc8b225fb322e92d75a7d", "git_parents": ["f5c06603c292dbd314eb3eb6c0a49b93a31ac1fe"], "node": "4041051f725bc99cfa4010d13ce94d45c95a9c73", "parents": ["7de42607af6a3904959702d3691ea1b76e580c4f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2060247 - Refuse languages no speech recognition model recognizes. r=media-playback-reviewers,alwu\n\navailable() reports unavailable and install() resolves false without launching\nthe HWInference process or downloading anything, and start() fires\nservice-not-allowed, as its start session algorithm's step 4.1 requires.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322690\n", "files": ["dom/media/docs/SpeechRecognition.md", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_unsupported_language.html"], "git_node": "014cc8610ebf5b950041f2e59dbf2112a1519dda", "git_parents": ["3b5043bac860cf073b0cc8b225fb322e92d75a7d"], "node": "32edb838f649b686edfdfdfb5d99152dbdea4a03", "parents": ["4041051f725bc99cfa4010d13ce94d45c95a9c73"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2060247 - Fall back to the user's language when the document declares none. r=eemeli\n\nHTML leaves the language of a node unknown for a document with neither a lang\nattribute nor a Content-Language, which is most of them, and recognition has to\nrun in some language regardless. Chrome answers that with the first of the\nuser's accepted languages; do the same.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324277\n", "files": ["dom/base/nsDocumentWarningList.inc", "dom/locales/en-US/chrome/dom/dom.properties", "dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/test/test_abort_end_async.html", "dom/media/webspeech/recognition/test/test_fuzz_session_lifecycle.html", "dom/media/webspeech/recognition/test/test_start_after_error.html", "dom/media/webspeech/recognition/test/test_unsupported_language.html"], "git_node": "3d3c5e5909cacafc04296a3c5e79c76426133ed5", "git_parents": ["014cc8610ebf5b950041f2e59dbf2112a1519dda"], "node": "df7ebf4f047dd8dc00e3042ebc40adb6153e8a19", "parents": ["32edb838f649b686edfdfdfb5d99152dbdea4a03"], "tags": []}, {"author": "revoconner \u003coconnerrev@gmail.com\u003e", "branch": "default", "desc": "Bug 1594489 - Add a menu to control the Inspector split orientation. r=nchevobbe,fluent-reviewers,devtools-reviewers,bolsson\n\nAdds a meatball-style menu to the Inspector toolbar with three radio\noptions: Auto (the existing width-based behavior, default), Side by\nside, and Stacked. The choice is stored in the new\ndevtools.inspector.split-orientation pref (\"auto\", \"side\" or \"stacked\").\nA pref observer caches the value and keeps the layout and the menu in\nsync when the pref changes externally.\n\nAlso adds the menuitemradio role to the shared menu button styling in\ntooltips.css, since MenuItem supports it but the stylesheet only covered\nmenuitem and menuitemcheckbox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318610\n", "files": ["browser/app/profile/firefox.js", "devtools/client/inspector/index.xhtml", "devtools/client/inspector/inspector.js", "devtools/client/inspector/test/browser.toml", "devtools/client/inspector/test/browser_inspector_split-orientation.js", "devtools/client/jar.mn", "devtools/client/locales/en-US/inspector.ftl", "devtools/client/themes/images/dock-auto.svg", "devtools/client/themes/inspector.css", "devtools/client/themes/tooltips.css"], "git_node": "e4dad5ece2c34a448e9c5ecc2ffce9daa19cd526", "git_parents": ["3d3c5e5909cacafc04296a3c5e79c76426133ed5"], "node": "919a86959b916b5faaeb18ce3990fb40a49f41e0", "parents": ["df7ebf4f047dd8dc00e3042ebc40adb6153e8a19"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - Upgrade vendored markdown-it-py to 4.2.0 r=ahal,mach-reviewers,ahochheiden\n\nmyst-parser 5.x requires markdown-it-py ~=4.2, but the tree vendors 3.0.0\nand taskcluster/requirements.in caps it below 4. That cap was added in\n524c505b0b94 when the previous myst-parser 5.1.0 update was backed out,\nand is marked temporary: it only exists to keep myst-parser 2.0.0\nresolvable. Lift it so the sphinx 9 upgrade can proceed.\n\nrich is the only real consumer and requires markdown-it-py\u003e=2.2.0.\nNeither taskcluster-taskgraph nor mozilla-taskgraph depends on it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324270\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt", "third_party/python/markdown_it_py/markdown_it/__init__.py", "third_party/python/markdown_it_py/markdown_it/_compat.py", "third_party/python/markdown_it_py/markdown_it/_punycode.py", "third_party/python/markdown_it_py/markdown_it/cli/parse.py", "third_party/python/markdown_it_py/markdown_it/common/entities.py", "third_party/python/markdown_it_py/markdown_it/common/html_blocks.py", "third_party/python/markdown_it_py/markdown_it/common/html_re.py", "third_party/python/markdown_it_py/markdown_it/common/utils.py", "third_party/python/markdown_it_py/markdown_it/helpers/__init__.py", "third_party/python/markdown_it_py/markdown_it/helpers/parse_link_destination.py", "third_party/python/markdown_it_py/markdown_it/helpers/parse_link_label.py", "third_party/python/markdown_it_py/markdown_it/helpers/parse_link_title.py", "third_party/python/markdown_it_py/markdown_it/main.py", "third_party/python/markdown_it_py/markdown_it/parser_block.py", "third_party/python/markdown_it_py/markdown_it/parser_core.py", "third_party/python/markdown_it_py/markdown_it/parser_inline.py", "third_party/python/markdown_it_py/markdown_it/port.yaml", "third_party/python/markdown_it_py/markdown_it/presets/__init__.py", "third_party/python/markdown_it_py/markdown_it/presets/commonmark.py", "third_party/python/markdown_it_py/markdown_it/presets/default.py", "third_party/python/markdown_it_py/markdown_it/presets/zero.py", "third_party/python/markdown_it_py/markdown_it/renderer.py", "third_party/python/markdown_it_py/markdown_it/ruler.py", "third_party/python/markdown_it_py/markdown_it/rules_block/__init__.py", "third_party/python/markdown_it_py/markdown_it/rules_block/blockquote.py", "third_party/python/markdown_it_py/markdown_it/rules_block/code.py", "third_party/python/markdown_it_py/markdown_it/rules_block/fence.py", "third_party/python/markdown_it_py/markdown_it/rules_block/heading.py", "third_party/python/markdown_it_py/markdown_it/rules_block/hr.py", "third_party/python/markdown_it_py/markdown_it/rules_block/list.py", "third_party/python/markdown_it_py/markdown_it/rules_block/paragraph.py", "third_party/python/markdown_it_py/markdown_it/rules_block/reference.py", "third_party/python/markdown_it_py/markdown_it/rules_block/table.py", "third_party/python/markdown_it_py/markdown_it/rules_core/__init__.py", "third_party/python/markdown_it_py/markdown_it/rules_core/normalize.py", "third_party/python/markdown_it_py/markdown_it/rules_core/replacements.py", "third_party/python/markdown_it_py/markdown_it/rules_core/smartquotes.py", "third_party/python/markdown_it_py/markdown_it/rules_core/text_join.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/__init__.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/autolink.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/balance_pairs.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/escape.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/fragments_join.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/image.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/link.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/linkify.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/newline.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/state_inline.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/strikethrough.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/text.py", "third_party/python/markdown_it_py/markdown_it/token.py", "third_party/python/markdown_it_py/markdown_it/tree.py", "third_party/python/markdown_it_py/markdown_it/utils.py", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/LICENSE", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/LICENSE.markdown-it", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/METADATA", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/RECORD", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/WHEEL", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/entry_points.txt", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/METADATA", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/RECORD", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/WHEEL", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/entry_points.txt", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/licenses/LICENSE", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/licenses/LICENSE.markdown-it", "third_party/python/pyproject.toml", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "03636c5df8ea35722f99f366e99620431a4c283a", "git_parents": ["e4dad5ece2c34a448e9c5ecc2ffce9daa19cd526"], "node": "285917b427077d23e5dabc4f71924eef625407b0", "parents": ["919a86959b916b5faaeb18ce3990fb40a49f41e0"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - Upgrade sphinx to 9.0.4 and related dependencies r=firefox-source-docs-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277906\n", "files": ["docs/config.yml", "python/sites/docs.txt"], "git_node": "bec2739c10c635aa7a1a46325ebb152a3dee92eb", "git_parents": ["03636c5df8ea35722f99f366e99620431a4c283a"], "node": "0c30ba5d18fc37f53aa0b97f0343d775dab30c3a", "parents": ["285917b427077d23e5dabc4f71924eef625407b0"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - doc: make mermaid diagrams legible after the sphinxcontrib-mermaid upgrade r=firefox-source-docs-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316479\n", "files": ["docs/conf.py", "docs/contributing/how_to_submit_a_patch.md"], "git_node": "62268677ac71fbf7b06e3bf8679c56ebdfe98c10", "git_parents": ["bec2739c10c635aa7a1a46325ebb152a3dee92eb"], "node": "3a9ae208f3986930395fbe21f74fa7cedf337206", "parents": ["0c30ba5d18fc37f53aa0b97f0343d775dab30c3a"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - doc: fix JSDoc markup rejected by myst-parser 5 r=firefox-source-docs-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316480\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/PanelMultiView.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "testing/mochitest/tests/SimpleTest/EventUtils.js", "testing/modules/Assert.sys.mjs", "toolkit/actors/PopupAndRedirectBlockingParent.sys.mjs", "toolkit/components/extensions/ConduitsParent.sys.mjs", "toolkit/components/extensions/ExtensionCommon.sys.mjs", "toolkit/components/extensions/ExtensionStorage.sys.mjs", "toolkit/components/extensions/NativeMessaging.sys.mjs", "toolkit/components/extensions/Schemas.sys.mjs", "toolkit/components/extensions/parent/ext-tabs-base.js", "toolkit/components/ml/content/backends/ONNXPipeline.mjs"], "git_node": "c4d632c0ad8d6094105bd22e3c7c05206d27655a", "git_parents": ["62268677ac71fbf7b06e3bf8679c56ebdfe98c10"], "node": "2be8eac87ae0d46c1e992d2d2dcf137448432066", "parents": ["3a9ae208f3986930395fbe21f74fa7cedf337206"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044285 - Reuse existing Settings tab from the credit card doorhanger options link. r=mtigley,credential-management-reviewers\n\nOpen the \"Form autofill options\" link through openPreferences() (like the\naddress doorhanger) instead of navigating an about:preferences href, so\nrepeated clicks focus the open Settings tab instead of opening a new one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313391\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_options_link.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "be363812e1b23d32fd22e8875d8317cd4d031d02", "git_parents": ["c4d632c0ad8d6094105bd22e3c7c05206d27655a"], "node": "a8d731fead8d4b43c65e1203bef036f206a9314c", "parents": ["2be8eac87ae0d46c1e992d2d2dcf137448432066"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2070433 - Reuse cached monitor color spaces for startup telemetry r=bradwerth\n\nCollect the color-space bitfield alongside HDR monitor information and publish it under the same lock. Startup telemetry reuses that snapshot instead of enumerating DXGI adapters and outputs again. Display refresh updates both values together, and the first consumer still initializes the cache synchronously.\n\nSource and formatting checks only; no Firefox build or runtime tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324538\n", "files": ["gfx/thebes/DeviceManagerDx.cpp", "gfx/thebes/DeviceManagerDx.h", "gfx/thebes/gfxWindowsPlatform.cpp"], "git_node": "1ca87b4f6632980630436acd175ae7d2baae71bf", "git_parents": ["be363812e1b23d32fd22e8875d8317cd4d031d02"], "node": "22f9ed3216cc5278064286d30d7b759033a2612a", "parents": ["a8d731fead8d4b43c65e1203bef036f206a9314c"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068936 - metada update\n", "files": ["testing/web-platform/meta/streams/transferable/transform-stream.html.ini"], "git_node": "fb8d7cd39a4757cba2939f90248d7d40925cdd4c", "git_parents": ["1ca87b4f6632980630436acd175ae7d2baae71bf"], "node": "8bec94b3f6b9dc7574425aac58dcccf5e1c7f5bd", "parents": ["22f9ed3216cc5278064286d30d7b759033a2612a"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2067216 - Workaround claude code goofiness with nested configuration. r=gfx-reviewers,ai4dev-reviewers,padenot,bradwerth\n\nPresently, claude code lazily loads nested CLAUDE.md files and .claude folders that aren't at the root only when the builtin Read, Write or Edit tools are touching files, however it instructs the model to not use the Read/Write/Edit tools and reach for bash tools like cat, grep or sed instead in the system prompt when run in bypass permission mode.\n\nWork around it by instructing it to load gfx/wr/CLAUDE.md with the Read tool when working in the wr sub-directory, from the root AGENTS.md. Doing so also triggers loading skills in gfx/wr/.claude/skills as soon as the model starts doing something in gfx/wr.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321936\n", "files": ["AGENTS.md"], "git_node": "3ba9324ab2ad43b43407cd4319ba87e07dfc7e55", "git_parents": ["fb8d7cd39a4757cba2939f90248d7d40925cdd4c"], "node": "866884957ba7d5652dfd367e2f0341551798e512", "parents": ["8bec94b3f6b9dc7574425aac58dcccf5e1c7f5bd"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2008577 - doc: fix JSDoc markup rejected by myst-parser 5 r=firefox-source-docs-reviewers,ahal\" for causing ci failures\n\nThis reverts commit c4d632c0ad8d6094105bd22e3c7c05206d27655a.\n\nRevert \"Bug 2008577 - doc: make mermaid diagrams legible after the sphinxcontrib-mermaid upgrade r=firefox-source-docs-reviewers,ahal\"\n\nThis reverts commit 62268677ac71fbf7b06e3bf8679c56ebdfe98c10.\n\nRevert \"Bug 2008577 - Upgrade sphinx to 9.0.4 and related dependencies r=firefox-source-docs-reviewers,ahal\"\n\nThis reverts commit bec2739c10c635aa7a1a46325ebb152a3dee92eb.\n\nRevert \"Bug 2008577 - Upgrade vendored markdown-it-py to 4.2.0 r=ahal,mach-reviewers,ahochheiden\"\n\nThis reverts commit 03636c5df8ea35722f99f366e99620431a4c283a.\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/PanelMultiView.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "docs/conf.py", "docs/config.yml", "docs/contributing/how_to_submit_a_patch.md", "python/sites/docs.txt", "taskcluster/requirements.in", "taskcluster/requirements.txt", "testing/mochitest/tests/SimpleTest/EventUtils.js", "testing/modules/Assert.sys.mjs", "third_party/python/markdown_it_py/markdown_it/__init__.py", "third_party/python/markdown_it_py/markdown_it/_compat.py", "third_party/python/markdown_it_py/markdown_it/_punycode.py", "third_party/python/markdown_it_py/markdown_it/cli/parse.py", 