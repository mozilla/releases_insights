": "9da9fbed7382b28bb12fc4d9d714bdac5f6cf849", "parents": ["180ec0496b157d0b5569c9780af86f3b510dbdc3"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064739 - Add dismiss action to PUWYLO resume pills r=pdahiya,fluent-reviewers,bolsson\n\n- Added session-scoped PUWYLO dismissals shared across tabs and windows, preventing dismissed memories from resurfacing until restart\n- Added a hover/focus dismiss button to PUWYLO pills\n- Added quick_prompt_dismissed telemetry\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321683\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.mjs", "browser/components/aiwindow/ui/modules/ResumeActivityDismissals.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_telemetry.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/locales/en-US/browser/aiWindow.ftl"], "git_node": "b05fce8736492ad540f6496210f5c144f18830c8", "git_parents": ["0766840f0fdc96309d884bb1e2aa993346f30b99"], "node": "9c73d4f6f43928a23a2af9c5b282f5e561b74ef9", "parents": ["9da9fbed7382b28bb12fc4d9d714bdac5f6cf849"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065639 - Show 3 resume-activity pills from an undismissed candidate pool r=pdahiya,cdipersio\n\n- expand resume activity candidate pool to 6 while displaying up to 3 undismissed pills\n- increase starter prompt row cap to 6 total\n- skip resume activity loading when memories are unavailable or disabled\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322429\n", "file