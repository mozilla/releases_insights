014e6b29bc0e626d7e3c8402c969", "a8664303447293d52c61b505dbbc2735891c5d6a", "61f87dcd7a9e614c364c70e03f9984da502f70b0", "f9442f708b484d83ca0f9e1d067a28e819f92e4b", "369ab2e0408827b0d30b1e52f81cf9d52397363e", "08f4f4f8df86cab5c2b4503ff457ff588f081196", "674ab89622d796e216e1d41b5a5ff7e4bfc62d51", "be2c1653f292494470ba369fd7559ffc9b9b78e6", "8c7161115522cbe1ec1126bf7bfd90b8ec3fe57f", "67dc6ac359b0881587df5f5ccccc5b3b14a1b294", "f9d1d8f9edc85925694540411ea48b38315623ef", "53cfb5ed074ab5168b29c4e6f7504f5393d48ed8", "02ab0cd0479ab4699bd27765869c68696b6a028c", "277eb5ff66bbffa04202d6e6166e9bbcb5709d0c", "0c383a8505dbe24fa5e178a7818eb149ca3f13a8", "3aa51796e508426ba3f826430405700056e31dce", "980e89fdcb3cfe520f7bace6ec4db17f4b47c997", "576979d20bae230ff2d9bf492b491cc0963d056b", "ed368522dfe1e2f9a18ad96dd80f8de9439aa9ad", "0b3b487c90f5f3452c4970bc23b6740cb6aae9b3", "24efc699dee41ffd6bb0326016fec8ee594a5b79", "1ad693ba2faa6a76599de9ed138c09b69902e0a2", "158f247b4db1b3e11ace0177faf6cb5e136c8b66", "72b784813f5f33d79105a846e604f2c2b490f242", "d02caf81ab6ef0bbe70fcbe4e6388923d1744e96"], "user": "csabou@mozilla.com"}, "45214": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/extensions/newtab/manifest.json"], "git_node": "9b794146973d3e99d273c58f9f6a5cc1dcfc09cb", "git_parents": ["d02caf81ab6ef0bbe70fcbe4e6388923d1744e96"], "node": "fad8104a73e0b6b5cec1a2df7eda7408f22dc852", "parents": ["78b269c400a0406eaeb200f670c6199defde5e13"], "tags": []}], "date": 1788204604, "git_changesets": ["9b794146973d3e99d273c58f9f6a5cc1dcfc09cb"], "user": "ffxbld@lando.moz.tools"}, "45215": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a2e949393afd57efbc77b783d374552d5fa52d06 with FIREFOX_156_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "bc49288c185b52e0c61c09fe69ec6b65b38e8249", "git_parents": ["f2d3fabf804832351b5d3fab1002a220a0be4df7"], "node": "6d712e3df739128df927381350c9edebba8e79b0", "parents": ["e543f920f6776805c609b58fef354673dbca677f"], "tags": []}], "date": 1788212602, "git_changesets": ["bc49288c185b52e0c61c09fe69ec6b65b38e8249"], "user": "ffxbld@lando.moz.tools"}, "45216": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a2e949393afd57efbc77b783d374552d5fa52d06 with DEVEDITION_156_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "aa8f489b7e4d68c3ba8d75a885fb2a364f11f429", "git_parents": ["bc49288c185b52e0c61c09fe69ec6b65b38e8249"], "node": "50d25725e66570c8b59b3d3f00b093af22b296c6", "parents": ["6d712e3df739128df927381350c9edebba8e79b0"], "tags": []}], "date": 1788214006, "git_changesets": ["aa8f489b7e4d68c3ba8d75a885fb2a364f11f429"], "user": "ffxbld@lando.moz.tools"}, "45217": {"changesets": [{"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037258 - Convert the service worker script to UTF-8 fallibly in CompareManager::WriteToCache. r=dom-worker-reviewers,edenchuang\n\n`NS_ConvertUTF16toUTF8` uses the infallible `AppendUTF16toUTF8` overload, which\ncalls `nsTSubstring::AllocFailed()` -\u003e `NS_ABORT_OOM()` when the allocation\nfails. Service worker scripts are routinely megabytes (~5MB in the reports), so\nthis aborts the parent process under memory pressure.\n\nUse the fallible `CopyUTF16toUTF8` instead and return NS_ERROR_OUT_OF_MEMORY.\nThe existing `MakeScopeExit([&] { Fail(rv); })` guard in `ManageNewCache()`\nalready handles a failing `WriteToCache()` (this is the same path taken when\n`Cache::Put` fails), so the registration/update fails cleanly instead of\nkilling the process.\n\nTwo related improvements at the same site:\n\n- The converted string is now moved into the string stream rather than copied,\n  which drops one full copy of the script body from the peak (was: 2N for the\n  UTF-16 buffer + N for the UTF-8 temporary + N for the stream's copy).\n- `SetBody()` is passed the length of the UTF-8 body that was actually produced\n  instead of the UTF-16 code unit count of the buffer it was converted from.\n  These differ for any script containing non-ASCII characters.\n\nVerification: this is an OOM abort, not a logic error, and the reports are\ncrash-stats aggregates with no testcase \u2014 there is no way to force the\nallocation failure deterministically from content, so there is no regression\ntest to add. The mechanism is fully determined by the stack in comment 0 and\nthe fix is the standard fallible-conversion pattern used elsewhere in the tree\n(e.g. dom/localstorage/LSValue.cpp, dom/fetch/BodyExtractor.cpp). The patch was\ncompile-verified with a local opt build (no new warnings in dom/serviceworkers)\nand is clang-format clean; I was not able to exercise it at runtime in my\nenvironment, so please let the usual service worker test suites\n(dom/serviceworkers/test) cover the non-OOM path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319782\n", "files": ["dom/serviceworkers/ServiceWorkerScriptCache.cpp"], "git_node": "642e8c536d26a6e525d45e74ab2ce0dee9dd5001", "git_parents": ["d02caf81ab6ef0bbe70fcbe4e6388923d1744e96"], "node": "09f7f293ab52c31e709ccb09c2a2fc35bbd08dc2", "parents": ["78b269c400a0406eaeb200f670c6199defde5e13"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2067568 - jit: compute the BaselineFrame pointer with one effective-address op. r=jandem\n\nloadBaselineFramePtr spelled fp - BaselineFrame::Size() as a register\ncopy followed by an in-place subtract. computeEffectiveAddress is one\ninstruction on every platform -- sub on arm64, lea on x86, where it\nalso stops clobbering the flags -- and the helper runs before every\nBaseline VM call.\n\nFound by armlint pair mining of a JetStream 3 corpus, where the\ntwo-instruction spelling is the single largest actionable pattern:\n120,822 instances across 54.7M JIT instructions.\n\nAn x86-64 shell instrumented to count the emissions confirms the scale\non the same benchmark: JetStream 3 emits 115,690 to 115,888\nloadBaselineFramePtr sites per run, all but four of them with the\nregister copy, against a JIT corpus of 34.6M instructions. Every one of\nthose loses a three-byte mov, roughly 339 KB of JIT code per run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322159\n", "files": ["js/src/jit/MacroAssembler.cpp"], "git_node": "58065f45704279c84aef187c52249c96dfb05ec2", "git_parents": ["642e8c536d26a6e525d45e74ab2ce0dee9dd5001"], "node": "e2a85faf989d2c8c2ff47f3aee7347f09a886ecc", "parents": ["09f7f293ab52c31e709ccb09c2a2fc35bbd08dc2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067607 - Update style_derive crate to edition 2024. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322200\n", "files": ["servo/components/style_derive/Cargo.toml"], "git_node": "b021967a0c6d0fc08198ab8896bdfca830456cea", "git_parents": ["58065f45704279c84aef187c52249c96dfb05ec2"], "node": "e018240b1f98627aab316526fd1ff07133a8e5e9", "parents": ["e2a85faf989d2c8c2ff47f3aee7347f09a886ecc"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067607 - Update to_shmem_derive crate to edition 2024. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322201\n", "files": ["servo/components/to_shmem_derive/Cargo.toml"], "git_node": "462384441fb43e32a4aa22fbf02c726ca4f8cea8", "git_parents": ["b021967a0c6d0fc08198ab8896bdfca830456cea"], "node": "8de7074fcc7d2bd2d1da7f5e768a50dd7aa1820c", "parents": ["e018240b1f98627aab316526fd1ff07133a8e5e9"], "tags": []}