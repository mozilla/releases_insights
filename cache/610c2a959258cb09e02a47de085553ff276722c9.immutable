brtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-simulcast.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-video-frames.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-video.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-worker.https.html.ini", "testing/web-platform/tests/webrtc-encoded-transform/RTCEncodedFrame-copy-construction.https.html", "testing/web-platform/tests/webrtc-encoded-transform/RTCEncodedFrame-shared-buffer.https.html", "testing/web-platform/tests/webrtc-encoded-transform/RTCEncodedFrame-shared-buffer.https.html.headers", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-encoded-transform-flex-worker.js", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-encoded-transform.https.html", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-padding-worker.js", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-padding.https.html", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-write-rules-worker.js", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-write-rules.https.html", "testing/web-platform/tests/webrtc-encoded-transform/routines.js"], "git_node": "7e940ecf0e4f35d85f29f7e11be424fab4f3ed88", "git_parents": ["95e13be790010fc4b05ab21e1b7bd7ecb128d1a8"], "node": "dfdb23a223b1a3886f82ca2f192723f71ab4670f", "parents": ["e1d2bbdfc9d6ec35130df82e4775006cbaa54e87"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2049215: Fix various bugs, and cleanup, in frame handling. r=ng,sfink\n\nFixes a couple of nullptr crashes with frames that have been (or are\nbeing) cloned.\n\nFixes a deprecation warning for GetFrameDependencies.\n\nFixed bug where in-place buffer modifications weren't changing what\nwe fed back to libwebrtc, including transfer of the buffer.\n\nFixed bug where a failed memory allocation would result in a nullptr\ncrash, and other OOM handling improvements.\n\nFix release assert in copy c'tor for frames when a metadata member was\nnot set in the original.\n\nGet structuredClone with internal backrefs working.\n\nStop using struct initializer lists on stuff that has a base class, and\nuse real constructors instead.\n\nDepends on D318810\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318811\n", "files": ["dom/base/StructuredCloneHolder.cpp", "dom/media/webrtc/jsapi/RTCEncodedAudioFrame.cpp", "dom/media/webrtc/jsapi/RTCEncodedAudioFrame.h", "dom/media/webrtc/jsapi/RTCEncodedFrameBase.cpp", "dom/media/webrtc/jsapi/RTCEncodedFrameBase.h", "dom/media/webrtc/jsapi/RTCEncodedVideoFrame.cpp", "dom/media/webrtc/jsapi/RTCEncodedVideoFrame.h", "dom/media/webrtc/jsapi/RTCRtpScriptTransformer.cpp"], "git_node": "1fff40f016783aef75d0ae4e0caa678f8f9a4beb", "git_parents": ["7e940ecf0e4f35d85f29f7e11be424fab4f3ed88"], "node": "b184add1a82a00c335009d7b3c4304746086bc7a", "parents": ["dfdb23a223b1a3886f82ca2f192723f71ab4670f"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2049215: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/webrtc/jsapi/RTCEncodedFrameBase.cpp", "dom/media/webrtc/jsapi/RTCEncodedVideoFrame.cpp"], "git_node": "7eb30465570864bc4e1223d3c0634b7d3be27c34", "git_parents": ["1fff40f016783aef75d0ae4e0caa678f8f9a4beb"], "node": "cbdfb01c0fb23a95a725f47f3d1ddd428503a82c", "parents": ["b184add1a82a00c335009d7b3c4304746086bc7a"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063662 - Report card column in New Tab story card impression and click telemetry. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.co