4099d7b30"], "node": "d0702dcceb039b3d16ac784f6cb20e6f5811cd1a", "parents": ["6bdbf53d300e9069ef11cf92ba462951cecd6942"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067580 - Apply mozilla patches for irregexp r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322173\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h"], "git_node": "78d49ee2c181ee26a5aa8e449f0532cb96b88c31", "git_parents": ["4a82abdc83b9268dbf83ff9f27f3231ae9872259"], "node": "00f29f3be1bd956c2b871807d87141c71438980c", "parents": ["d0702dcceb039b3d16ac784f6cb20e6f5811cd1a"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067580: Reimplement IsPowerOfTwo r=dminor\n\nstd::has_single_bit is only defined for unsigned types, but V8 added a use for `int`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323381\n", "files": ["js/src/irregexp/RegExpShim.h"], "git_node": "62871c3f742420d512e1199f9b06be33dcb619dc", "git_parents": ["78d49ee2c181ee26a5aa8e449f0532cb96b88c31"], "node": "7bae376eb37182400a20451d607fee2e785e68a6", "parents": ["00f29f3be1bd956c2b871807d87141c71438980c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068432: Add testcase for bug fixed by irregexp update r=dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323382\n", "files": ["js/src/jit-test/tests/regexp/bug2068432.js"], "git_node": "9a5761f4018460a508b28d9661a6a67da0919d56", "git_parents": ["62871c3f742420d512e1199f9b06be33dcb619dc"], "node": "c7b5269914a3443e76aa934f03dee1e8151d185f", "parents": ["7bae376eb37182400a20451d607fee2e785e68a6"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067881 - Remove deprecated geckoview legacy telemetry mirrors. r=kaya,geckoview-reviewers,chutten\n\nRemove the mirrors while still leaving the Glean-based metrics in place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322398\n", "files": ["mobile/shared/modules/geckoview/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "9a27266e257d4ee708c1e01d704e70ed4a4c2cdc", "git_parents": ["9a5761f4018460a508b28d9661a6a67da0919d56"], "node": "76ef893b45d9587b524123883c01100bfd3526e7", "parents": ["c7b5269914a3443e76aa934f03dee1e8151d185f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067436: Don't allow the viewport cache for non-doc accessibles. r=accessibility-platform-reviewers,eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323141\n", "files": ["accessible/ipc/RemoteAccessible.cpp"], "git_node": "0443ee2e8600fb9744134765b6873446ac07d87e", "git_parents": ["9a27266e257d4ee708c1e01d704e70ed4a4c2cdc"], "node": "baf459b1a950da02bbf740e1d821e8dfa0b5e467", "parents": ["76ef893b45d9587b524123883c01100bfd3526e7"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067754 - Remove version 155 train-hop shims for the homepage/customHomepage fallback in AboutPreferences. r=nina-py,mkennedy,fluent-reviewers,bolsson\n\nBug 2048379 moved the `homepage` and `customHomepage` setting groups into\nbrowser/components/preferences (home-startup.mjs) as of Firefox 155. With 155 on\nRelease, the pre-155 fallback in the newtab add-on can go.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322340\n", "files": ["browser/components/preferences/config/home-startup.mjs", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/test/unit/lib/AboutPreferences.test.js", "browser/extensions/newtab/test/unit/stubs/AppConstants.sys.mjs", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "306c1c0e512f5fd8044838763f6f538c18d34cb2", "git_parents": ["0443ee2e8600fb9744134765b6873446ac07d87e"], "node": "5112deabdb137bbd62f89ca5d86dff2de6e5cb6f", "parents": ["baf459b1a950da02bbf740e1d821e8dfa0b5e467"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067755 - Remove the version 155 train-hop plumbing that re-injects preferences.ftl strings into the newtab XPI. r=nina-py\n\nBug 2048379 moved 13 homepage-settings strings from newtab.ftl into preferences.ftl, and added a build-time extract step that pulled them back out and appended them to every generated newtab.ftl, purely to feed the pre-155 fallback in AboutPreferences.sys.mjs. Nightly is now 157, so that fallback is unreachable and the extract can go.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322332\n", "files": ["browser/extensions/newtab/mach_commands.py", "browser/extensions/newtab/webext-glue/locales/gen_locales.py", "browser/extensions/newtab/webext-glue/moz.build"], "git_node": "b625877426e63190234c10d13c1d85cc4683bde4", "git_parents": ["306c1c0e512f5fd8044838763f6f538c18d34cb2"], "node": "451b7e3a917477eea480648dedaf27d1499b51d5", "parents": ["5112deabdb137bbd62f89ca5d86dff2de6e5cb6f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068390: Fire an accessibility focusable state change event when an EditContext is attached or detached. r=ltenenbaum,accessibility-platform-reviewers,eeejay\n\nWe already get notified via DocAccessible::ElementStateChanged when the DOM READWRITE state changes, which happens for both contentEditable and EditContext.\nREADWRITE is set on all descendants, not just the root.\nThat's great for the Accessible editable state, which should be exposed on the node and its descendants.\nIn contrast, the focusable state should only be exposed on the root of an editor.\nFor contentEditable, we handle the focusable change in LocalAccessible::AttributeChangesState (which utilises AttributeWillChanged and AttributeChanged), but there's currently no such abstraction for properties like editContext.\nThe EditContext has already been detached once DocAccessible::ElementStateChanged is called to notify us about the removal of the READWRITE state, so we can't handle it there, since we can't tell which element is the root of the EditContext.\nThus, we must add an nsAccessibilityService hook in nsGenericHTMLElement::SetEditContext.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322831\n", "files": ["accessible/base/nsAccessibilityService.cpp", "accessible/base/nsAccessibilityService.h", "accessible/tests/browser/e10s/browser_caching_states.js", "dom/html/nsGenericHTMLElement.cpp"], "git_node": "bf5224d95236d2502bf9a48a05469660cc6c0963", "git_parents": ["b625877426e63190234c10d13c1d85cc4683bde4"], "node": "f9c176057465ff1fb8a0630bc74abe1d44823eb7", "parents": ["451b7e3a917477eea480648dedaf27d1499b51d5"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1981648 - P1: Add IsHTMLRange and fix IsHTMLSpinner. r=Jamie\n\nHTMLSpinnerAccessible was never assigned an mType of eHTMLSpinnerType,\nso that didn't work. Added IsHTMLRange as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321717\n", "files": ["accessible/basetypes/Accessible.h", "accessible/html/HTMLFormControlAccessible.h"], "git_node": "56ec023597ada2e738b9f5dd1a09fa546d6f12aa", "git_parents": ["bf5224d95236d2502bf9a48a05469660cc6c0963"], "node": "3e52834ec28757d4d6e13e58d484dbf0c7bdc201", "parents": ["f9c176057465ff1fb8a0630bc74abe1d44823eb7"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1981648 - P2: Make ranges and spinners adjustable with scroll action. r=Jamie,geckoview-reviewers,m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321718\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/android/SessionAccessibility.h", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-range.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "867af286189a94dcc57f39c4565dfbcfaf56c465", "git_parents": ["56ec023597ada2e738b9f5dd1a09fa546d6f12aa"], "node": "92dbb591bd1d546ee4d0b95d7a19e4f6f882d233", "parents": ["3e52834ec28757d4d6e13e58d484dbf0c7bdc201"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1981648 - P3: Send value change events for numeric values. r=Jamie,geckoview-reviewers,m_kato\n\nA non focused accessible sends a TYPE_VIEW_SCROLLED and a focused one a\nTYPE_VIEW_SELECTED...\n\nAlso removed redundant role description for slider since TalkBack\nalready speaks this role correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321719\n", "files": ["accessible/android/Platform.cpp", "accessible/android/SessionAccessibility.cpp", "accessible/android/SessionAccessibility.h", "dom/locales/en-US/chrome/accessibility/AccessFu.properties", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "86f69a8d83434f9ba66ad28cc978a572eb84074f", "git_parents": ["867af286189a94dcc57f39c4565dfbcfaf56c465"], "node": "2229094d808fd9b05a4849a3133f14213aac9303", "parents": ["92dbb591bd1d546ee4d0b95d7a19e4f6f882d233"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2042743 - Check the baseline frame height before creating a stackmap. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320494\n", "files": ["js/src/jit-test/tests/wasm/regress/baseline-stack-height-during-stackmap.js", "js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "1a3cb5deadd0a4c6e16140082b994a2841f35a9a", "git_parents": ["86f69a8d83434f9ba66ad28cc978a572eb84074f"], "node": "e4bb925a0fafda97aafd37a4e7dd65ad51b5a614", "parents": ["2229094d808fd9b05a4849a3133f14213aac9303"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2060057 - Move ThreadSafeCodeBlockMap to WasmProcess.h. r=jseward\n\nPure code motion, so that a following patch can add an inlineable accessor for\nthe process-wide map. The method bodies move to WasmProcess.cpp to keep\nWasmProcess.h from needing the complete CodeBlock type.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320539\n", "files": ["js/src/wasm/WasmCode.h", "js/src/wasm/WasmProcess.cpp", "js/src/wasm/WasmProcess.h"], "git_node": "6127d8a61457e85487b3645db9a25a72d1db54a7", "git_parents": ["1a3cb5deadd0a4c6e16140082b994a2841f35a9a"], "node": "70ed8c02f72cbc6ac7436f741436df55338d85ff", "parents": ["e4bb925a0fafda97aafd37a4e7dd65ad51b5a614"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2060057 - Update wasm::CodeExists inside the code block map's critical section. r=jseward\n\nRegisterCodeBlock and UnregisterCodeBlock updated wasm::CodeExists after the\nmap's lock was released, so a concurrent register and unregister could leave the\nflag false while code blocks were still registered.\n\nReplace the global with an `empty_` member of ThreadSafeCodeBlockMap, maintained\nby insert() and remove() while mutatorsMutex_ is held, and make\nwasm::CodeExists() an inline accessor for the process-wide map.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320540\n", "files": ["js/src/jit/arm/Simulator-arm.cpp", "js/src/jit/arm/Simulator-arm.h", "js/src/jit/arm64/vixl/Simulator-vixl.h", "js/src/jit/loong64/Simulator-loong64.h", "js/src/jit/mips64/Simulator-mips64.h", "js/src/jit/riscv64/Simulator-riscv64.h", "js/src/wasm/WasmProcess.cpp", "js/src/wasm/WasmProcess.h", "js/src/wasm/WasmSerialize.cpp"], "git_node": "6a3341b7e2e953a6f0ae6c500a945f83533c30ae", "git_parents": ["6127d8a61457e85487b3645db9a25a72d1db54a7"], "node": "23819419289b9a8aedb35032cf3fd1e10705b8d3", "parents": ["70ed8c02f72cbc6ac7436f741436df55338d85ff"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051469 part 1: Extract nsAccUtils::ShouldFireValueChangeForDescendantChanges from MaybeNotifyOfValueChange. r=accessibility-platform-reviewers,eeejay\n\nThis is a pure refactor with no functional change.\nIt extracts the condition used to decide whether an Accessible should fire EVENT_TEXT_VALUE_CHANGE due to changes to its descendants into a reusable helper.\nWe will need this elsewhere in the next patch to decide when to walk up the tree looking for a value-dependent ancestor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323158\n", "files": ["accessible/base/nsAccUtils.cpp", "accessible/base/nsAccUtils.h", "accessible/generic/DocAccessible-inl.h"], "git_node": "2c3f48175f8d6ca8f82661158bc375313be5d8bb", "git_parents": ["6a3341b7e2e953a6f0ae6c500a945f83533c30ae"], "node": "2176fffce0c08c0d2f12a8027c3a3856a4c1279b", "parents": ["23819419289b9a8aedb35032cf3fd1e10705b8d3"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051469 part 2: Fire value change events for combobox values calculated from deeper descendants. r=accessibility-platform-reviewers,eeejay\n\nMaybeNotifyOfValueChange only checked whether the accessible it was given directly fired EVENT_TEXT_VALUE_CHANGE.\nThis accessible is usually the direct hypertext parent of the text that changed.\nThis meant that previously, we didn't fire the event for a combobox when there was an intervening generic between the changed text and the combobox; e.g. a block-level span.\nThis adds an eHasValueDependent context flag, propagated down from a value-notifying ancestor the same way eHasNameDependent and eHasDescriptionDependent already are.\nThis is then used to walk up from the changed accessible to the nearest ancestor whose value might depend on it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323159\n", "files": ["accessible/generic/DocAccessible-inl.h", "accessible/generic/DocAccessible.h", "accessible/generic/LocalAccessible.cpp", "accessible/generic/LocalAccessible.h", "accessible/tests/browser/e10s/browser_caching_value.js"], "git_node": "4fde8d52a1bb4c759f36fbab7a001e9812eb083d", "git_parents": ["2c3f48175f8d6ca8f82661158bc375313be5d8bb"], "node": "0c2950096398b9166bee821983f660b18811cb1a", "parents": ["2176fffce0c08c0d2f12a8027c3a3856a4c1279b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005954 - Remove the unreferenced --background-color-dead-row custom property from aboutMemory.css. r=bustage\n", "files": ["toolkit/components/aboutmemory/content/aboutMemory.css"], "git_node": "f0093428d71e3b3141e7e3c342ad533fd8418a39", "git_parents": ["4fde8d52a1bb4c759f36fbab7a001e9812eb083d"], "node": "ba855f91ae71924d0a1e9d3a95afd4015b98ab1d", "parents": ["0c2950096398b9166bee821983f660b18811cb1a"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066922 - Fix urlbar result explanation truncation/overflow and improve how space is distributed among the title, URL, and explanation. r=dao,desktop-theme-reviewers,urlbar-reviewers\n\nThis fixes the bug and makes two related changes:\n\nImprove the way that space is distributed among the no-wrap (e.g., title), URL,\nand explanation. I made sure this doesn't regress bug 2063457 D318639.\n\nIt's possible for the explanation to appear too close to the URL when the URL\ndoes not overflow and therefore the separator dot before the explanation doesn't\nappear. Fix that by always creating the separator, just make it transparent\nunless the URL does overflow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323144\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "5780b59cc2fcdd5f838a51b4cc64b207d7d04906", "git_parents": ["f0093428d71e3b3141e7e3c342ad533fd8418a39"], "node": "4b0fdddf9328b929fe0b0a5abb7d510d7618c4bd", "parents": ["ba855f91ae71924d0a1e9d3a95afd4015b98ab1d"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068836 - Fix exponential recursion in order_readers_after(). r=gfx-reviewers,lsalzman,ahale\n\nThis reimplements order_readers_after() as an iterative function and adds a set\nof visited nodes, guarding against multiple evaluations of the same node\n(including cycles).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323331\n", "files": ["gfx/wr/webrender/src/surface.rs"], "git_node": "cb6cfc336941742b8ca7cdcad12096260f91d2b8", "git_parents": ["5780b59cc2fcdd5f838a51b4cc64b207d7d04906"], "node": "033558cac62acd22f08a353faf22f28e923890ea", "parents": ["4b0fdddf9328b929fe0b0a5abb7d510d7618c4bd"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2068836 - Add a wrench reftest for many backdrop-filters under a blurred parent r=gfx-reviewers,ahale\n\nEach backdrop-filter resolve widens the graph that order_readers_after() walks,\nso walking it once per path is exponential in the number of siblings: 9 siblings\ntook 0.2s, 13 took 67s, 14 did not finish.\n\nSixteen siblings inside a blurred stacking context. Inverting the red backdrop\ngives cyan, so the reference draws cyan rects in their place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323411\n", "files": ["gfx/wr/wrench/reftests/filters/backdrop-filter-many-in-blurred-parent-ref.yaml", "gfx/wr/wrench/reftests/filters/backdrop-filter-many-in-blurred-parent.yaml", "gfx/wr/wrench/reftests/filters/reftest.list"], "git_node": "e431f9545093b298340c9acfe494514fd00b666d", "git_parents": ["cb6cfc336941742b8ca7cdcad12096260f91d2b8"], "node": "6160a8a7c54b9e23e4b3b2a6bd397d36f01760f7", "parents": ["033558cac62acd22f08a353faf22f28e923890ea"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052547 - Add theme_picker Glean metrics. r=chutten\n\nDefine `theme_picker.shown` and `theme_picker.change` in\n`browser/modules/metrics.yaml` so picker exposure and theme changes can\nbe segmented by hosting surface and compact/full layout. The schema\nreserves session linkage and appearance/native-theme fields for a\nfollow-up. The schema also documents the existing profile-theme metrics\nto help prevent double counting those clicks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321103\n", "files": ["browser/modules/metrics.yaml"], "git_node": "d206d47093fccdb290e6ebe85bde07e4cb6ee810", "git_parents": ["e431f9545093b298340c9acfe494514fd00b666d"], "node": "e0f8b63d2ee840db77f3dcd048707c608293df0a", "parents": ["6160a8a7c54b9e23e4b3b2a6bd397d36f01760f7"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052547 - Record theme selections in ThemesList.updateThemeState. r=desktop-theme-reviewers,kcochrane\n\nRecord `theme_picker.change` in `browser/themes/ThemesList.sys.mjs` at\n`ThemesList.updateThemeState`. We only record after `updateThemeState`\nsucceeds so that counts are consistent. Each event records the install\nsource, the caller's layout, and the selected theme ID.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321104\n", "files": ["browser/themes/ThemesList.sys.mjs", "browser/themes/test/unit/test_ThemesList.js"], "git_node": "b8f751624a91e51a06bcba6146f0c2c5a3ea6204", "git_parents": ["d206d47093fccdb290e6ebe85bde07e4cb6ee810"], "node": "f6d525ab404ae24e25a225edf53a73b6fd4dae43", "parents": ["e0f8b63d2ee840db77f3dcd048707c608293df0a"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052547 - Thread installsource and layout through theme-picker actor messages. r=mkennedy\n\nBy threading installsource and layout through the actor messages, remote\npickers can record their hosting surface and their layout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321105\n", "files": ["browser/actors/ThemePickerParent.sys.mjs", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs"], "git_node": "0a8ceab01c2b938925161f61e2aea94fa69fd229", "git_parents": ["b8f751624a91e51a06bcba6146f0c2c5a3ea6204"], "node": "c7e95c0b4dfabdb6f4b7bbb5b990d33ea9fcfe88", "parents": ["f6d525ab404ae24e25a225edf53a73b6fd4dae43"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052547 - Populate layout at the remaining updateThemeState callers. r=extension-reviewers,mkennedy,rpl\n\nThe direct theme controller sends its host's layout, while the addons\ntheme picker only sends \"full\" for the layout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321106\n", "files": ["toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-direct-controller.mjs", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-picker.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js"], "git_node": "93e0f429897c8854e497918a2dc94ed45c407d91", "git_parents": ["0a8ceab01c2b938925161f61e2aea94fa69fd229"], "node": "8e3d692ea4f487612b4d0f993d039591bc8b00a8", "parents": ["c7e95c0b4dfabdb6f4b7bbb5b990d33ea9fcfe88"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052547 - Record theme-picker shown telemetry. r=mkennedy,mstriemer,omc-reviewers,mimi\n\nEmit `theme_picker.shown`to unblock HNT in Bug 2066344.\n`ThemePicker.shown()` should be called from the consumer once a theme\npicker is visible.\n\nCurrently `ThemePickerChild.shown` records at most one event per actor.\nThis prevents repeated customize-panel openings from inflating the count\nwhile also allowing separate tabs and windows to record their own event.\nThis is because we currently want to know if a theme picker was\ninteracted with at all.\n\nWe handle the deduplication in the actor rather than a chrome theme\nmodule. This allows us to record the event per document instead of per\nbrowser window.\n\n`session` stays unpopulated and will be addressed in a follow up bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322484\n", "files": ["browser/actors/ThemePickerChild.sys.mjs", "browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_theme_picker.js", "browser/modules/metrics.yaml", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-direct-controller.mjs", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs", "toolkit/content/widgets/theme-picker/theme-picker.mjs"], "git_node": "f6ad4a23396bb5a9c19f2c5c602c278c0db4c38b", "git_parents": ["93e0f429897c8854e497918a2dc94ed45c407d91"], "node": "74b06e5c066bd57609c068bed23dbbd2cfe11911", "parents": ["8e3d692ea4f487612b4d0f993d039591bc8b00a8"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060057 - Update wasm::CodeExists inside the code block map's critical section. r=jseward\" for causing build bustages\n\nThis reverts commit 6a3341b7e2e953a6f0ae6c500a945f83533c30ae.\n\nRevert \"Bug 2060057 - Move ThreadSafeCodeBlockMap to WasmProcess.h. r=jseward\"\n\nThis reverts commit 6127d8a61457e85487b3645db9a25a72d1db54a7.\n", "files": ["js/src/jit/arm/Simulator-arm.cpp", "js/src/jit/arm/Simulator-arm.h", "js/src/jit/arm64/vixl/Simulator-vixl.h", "js/src/jit/loong64/Simulator-loong64.h", "js/src/jit/mips64/Simulator-mips64.h", "js/src/jit/riscv64/Simulator-riscv64.h", "js/src/wasm/WasmCode.h", "js/src/wasm/WasmProcess.cpp", "js/src/wasm/WasmProcess.h", "js/src/wasm/WasmSerialize.cpp"], "git_node": "08cda3e03e8a7adf13d07652090ff3739dca12a4", "git_parents": ["f6ad4a23396bb5a9c19f2c5c602c278c0db4c38b"], "node": "70bf799a5c46fbb55559550840ae83b952ae55f4", "parents": ["74b06e5c066bd57609c068bed23dbbd2cfe11911"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2043002: Implement the automatic, container size based line clamping for css line-clamp. r=layout-reviewers,dshin for causing wpt failures @ TEST-UNEXPECTED-FAIL | /css/css-overflow/line-clamp/line-clamp-balance-005.html\n\nThis reverts commit c5b375897eb7ac350b659e31cb656f7cd49297ca.\n", "files": ["layout/generic/ReflowInput.h", "layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h", "layout/generic/nsBlockReflowContext.cpp", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-037.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-041.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-001.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-002.tentative.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-003.tentative