ozilla/fenix/translations/preferences/downloadlanguages/DownloadLanguageFileDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/downloadlanguages/DownloadLanguagesPreference.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/nevertranslatesite/NeverTranslateSitesPreference.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/settings/TranslationSettings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/BrokenSiteReasonListItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/EditUrlConfirmationDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporterPreviewSheet.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/DownloadAddonDialogFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/GoogleLensOptOutBottomSheetTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItemTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/MainMenuTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/compose/navigation/BottomSheetSceneStrategyTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSiteStateTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSitesExpandToggleTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/ui/PdfToolsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/IPProtectionScreenTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/labs/ui/FirefoxLabsScreenTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/AddToTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/EditTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ExpandedTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/fab/TabManagerFloatingToolbarTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayoutTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/trackingprotection/TrackersBlockedCardTest.kt"], "git_node": "f989939edb58946c3cdd9bf8dc5d3d23fb2ba4a5", "git_parents": ["f6325ba33939a3e1a160d5e743ed9bac3d8d3907"], "node": "631fbe45f4635fff0030a4b94f3302f107f79f3c", "parents": ["1db23580c7d414a29540a05d0e92e144a8bfa2ce"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066948 - Update harfbuzz to 14.4.0 r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321743\n", "files": ["gfx/harfbuzz/NEWS", "gfx/harfbuzz/moz.yaml", "gfx/harfbuzz/src/OT/Color/CBDT/CBDT.hh", "gfx/harfbuzz/src/OT/Color/COLR/COLR.hh", "gfx/harfbuzz/src/OT/Color/sbix/sbix.hh", "gfx/harfbuzz/src/OT/Layout/Common/Coverage.hh", "gfx/harfbuzz/src/OT/Layout/Common/CoverageFormat2.hh", "gfx/harfbuzz/src/OT/Layout/GDEF/GDEF.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/CursivePosFormat1.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/GPOS.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/MarkArray.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/PairPosFormat2.hh", "gfx/harfbuzz/src/OT/Layout/GPOS/ValueFormat.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/Ligature.hh", "gfx/harfbuzz/src/OT/Layout/GSUB/SubstLookup.hh", "gfx/harfbuzz/src/OT/glyf/glyf.hh", "gfx/harfbuzz/src/gen-arabic-pua.py", "gfx/harfbuzz/src/gen-arabic-table.py", "gfx/harfbuzz/src/hb-aat-layout-common.hh", "gfx/harfbuzz/src/hb-aat-layout-kerx-table.hh", "gfx/harfbuzz/src/hb-aat-layout-morx-table.hh", "gfx/harfbuzz/src/hb-aat-layout-trak-table.hh", "gfx/harfbuzz/src/hb-algs.hh", "gfx/harfbuzz/src/hb-bit-page.hh", "gfx/harfbuzz/src/hb-bit-set-invertible.hh", "gfx/harfbuzz/src/hb-bit-set.hh", "gfx/harfbuzz/src/hb-buffer-serialize.cc", "gfx/harfbuzz/src/hb-buffer.cc", "gfx/harfbuzz/src/hb-cairo.cc", "gfx/harfbuzz/src/hb-depend-data.hh", "gfx/harfbuzz/src/hb-font.hh", "gfx/harfbuzz/src/hb-ft.cc", "gfx/harfbuzz/src/hb-graphite2.cc", "gfx/harfbuzz/src/hb-iter.hh", "gfx/harfbuzz/src/hb-kern.hh", "gfx/harfbuzz/src/hb-limits.hh", "gfx/harfbuzz/src/hb-map.hh", "gfx/harfbuzz/src/hb-ot-cff1-table.cc", "gfx/harfbuzz/src/hb-ot-cff1-table.hh", "gfx/harfbuzz/src/hb-ot-cff2-table.cc", "gfx/harfbuzz/src/hb-ot-layout-base-table.hh", "gfx/harfbuzz/src/hb-ot-layout-common.hh", "gfx/harfbuzz/src/hb-ot-layout-gsub-table.hh", "gfx/harfbuzz/src/hb-ot-layout-gsubgpos.hh", "gfx/harfbuzz/src/hb-ot-layout.cc", "gfx/harfbuzz/src/hb-ot-math-table.hh", "gfx/harfbuzz/src/hb-ot-metrics.cc", "gfx/harfbuzz/src/hb-ot-shape-fallback.cc", "gfx/harfbuzz/src/hb-ot-shape.cc", "gfx/harfbuzz/src/hb-ot-shaper-arabic-fallback.hh", "gfx/harfbuzz/src/hb-ot-shaper-arabic-pua.hh", "gfx/harfbuzz/src/hb-ot-shaper-arabic.cc", "gfx/harfbuzz/src/hb-ot-var-avar-table.hh", "gfx/harfbuzz/src/hb-ot-var-common.hh", "gfx/harfbuzz/src/hb-raster.hh", "gfx/harfbuzz/src/hb-set.cc", "gfx/harfbuzz/src/hb-set.h", "gfx/harfbuzz/src/hb-set.hh", "gfx/harfbuzz/src/hb-shape-plan.cc", "gfx/harfbuzz/src/hb-shape-plan.hh", "gfx/harfbuzz/src/hb-subset-cff-common.hh", "gfx/harfbuzz/src/hb-subset-cff1.cc", "gfx/harfbuzz/src/hb-subset-cff2.cc", "gfx/harfbuzz/src/hb-subset-input.cc", "gfx/harfbuzz/src/hb-subset-instancer-iup.cc", "gfx/harfbuzz/src/hb-subset-plan-member-list.hh", "gfx/harfbuzz/src/hb-subset-plan-var.cc", "gfx/harfbuzz/src/hb-subset-plan.cc", "gfx/harfbuzz/src/hb-subset-plan.hh", "gfx/harfbuzz/src/hb-uniscribe.cc", "gfx/harfbuzz/src/hb-vector-buf.hh", "gfx/harfbuzz/src/hb-vector-draw.hh", "gfx/harfbuzz/src/hb-vector-paint.hh", "gfx/harfbuzz/src/hb-vector-path.hh", "gfx/harfbuzz/src/hb-version.h", "gfx/harfbuzz/src/hb.hh", "gfx/harfbuzz/src/main.cc", "gfx/harfbuzz/src/meson.build", "gfx/harfbuzz/src/rust/Cargo.toml", "gfx/harfbuzz/src/rust/font.rs", "gfx/harfbuzz/src/rust/shape.rs", "gfx/harfbuzz/src/update-unicode-tables.make", "gfx/harfbuzz/src/wasm/graphite/shape.cc"], "git_node": "88b70ed622ac2e426079792f3a5a3e31e3b6ad8a", "git_parents": ["f989939edb58946c3cdd9bf8dc5d3d23fb2ba4a5"], "node": "1f07e651d676bdb1460b17fb287c8ea66d160de7", "parents": ["631fbe45f4635fff0030a4b94f3302f107f79f3c"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055560 - Block Mesa threading with nouveau devices due to crash volume. r=gfx-reviewers,lsalzman,ahale\n\nThis can be revisited/re-enabled in the future once stable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317096\n", "files": ["widget/gtk/GfxInfo.cpp"], "git_node": "4c1a8d2486896abb27862583ae4b82edfb3aff42", "git_parents": ["88b70ed622ac2e426079792f3a5a3e31e3b6ad8a"], "node": "75f15614ca134bf307d90d895cd27e1b60f925f0", "parents": ["1f07e651d676bdb1460b17fb287c8ea66d160de7"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056319 - Group checkboxes in the Migration Wizard r=migration-reviewers,omc-reviewers,morgan,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319923\n", "files": ["browser/components/migration/content/migration-wizard.mjs"], "git_node": "55155cd56189fed14a6eae6d8518e31e25400089", "git_parents": ["4c1a8d2486896abb27862583ae4b82edfb3aff42"], "node": "8169eec8a264ca889b8b31d61bf514d0cba10b53", "parents": ["75f15614ca134bf307d90d895cd27e1b60f925f0"], "tags": []}, {"author": "Andrey Zinovyev \u003cazinovyev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066141 - Add an Android probe for background media playback usage r=media-playback-reviewers,alwu\n\nThis adds the media.background_audio_playback Glean event to help the\nmobile product team answer how often users play media in the background\non Android (context: the bug 2060611 background audio playback\nintervention). It is recorded in HTMLMediaElement when an element\ntransitions to hidden while audibly playing (the app is backgrounded),\nonce per background episode, with Picture-in-Picture excluded. It is\nAndroid-only and generic (records no site or URL).\n\nThis probe will NOT accurately capture all background media playback\nsituations. It only fires on the foreground-to-background transition, so\nit misses cases such as media that starts or resumes playing while\nalready backgrounded, and it will under-count. It is a coarse, temporary\nsignal (expires in 6 months) meant only to give a directional answer to\nthe mobile product question above.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321331\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h", "dom/media/metrics.yaml"], "git_node": "da1dd39761b5016a283931fdbf6b616c4ec4758a", "git_parents": ["55155cd56189fed14a6eae6d8518e31e25400089"], "node": "51480744f8d30c36856153488b3d88686502bf7e", "parents": ["8169eec8a264ca889b8b31d61bf514d0cba10b53"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066836 - Remove Legacy Telemetry 'third-party-modules' ping r=gstoll\n\nLeaves the timer and notification stuff in-place in t/c/telemetry.\nFuture work: we should probably move this stuff to\ntoolkit/xre/dllservices or someplace closer to the team that uses the\ndata.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321572\n", "files": ["toolkit/components/telemetry/docs/data/third-party-modules-ping.md", "toolkit/components/telemetry/docs/obsolete/collection/third-party-modules-ping.md", "toolkit/components/telemetry/pings/UntrustedModulesPing.sys.mjs", "toolkit/components/telemetry/tests/unit/test_ThirdPartyModulesPing.js"], "git_node": "c5367415d23a75f1c9494b0482d1ce86164259cb", "git_parents": ["da1dd39761b5016a283931fdbf6b616c4ec4758a"], "node": "1187f23f1a4f9f9584f883b98c0247585acda3a3", "parents": ["51480744f8d30c36856153488b3d88686502bf7e"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2032628: Use 'visibility:collapse' instead of 'display:none' to show/hide tab-close-button on hovered/unhovered vertical tabs. r=tabbrowser-reviewers,desktop-theme-reviewers,sthompson,kcochrane\n\nAlso, this patch gives .tab-content 'contain: size layout' so that it can be a\ndynamic reflow root, so that hovered tabs can reflow in a more granular way.\n\nAnd then, to ensure that .tab-content still sizes to fit its anticipated\ncontent-height (despite now having 'contain:size'), this patch adds\n'contain-intrinsic-block-size' and 'line-height' declarations to match the\ntab-label's height (assuming it uses the same 'font' as .tab-content).\n\nI don't think this results in any user-facing behavior difference, but it\nshould be a performance win for tab-heavy situations, particularly in \"always\nshow scrollbars\" configurations.\n\nChanges to 'visibility:collapse' just trigger a reflow (not frame\nreconstruction), and with 'contain: size layout' on the .tab-content, that\nreflow can be done in a very targeted way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294825\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "7c31e6e18dc9d926c243fb015871df34d4c4456a", "git_parents": ["c5367415d23a75f1c9494b0482d1ce86164259cb"], "node": "582669709d2603cfc7fc39ba84916c66463c533b", "parents": ["1187f23f1a4f9f9584f883b98c0247585acda3a3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056051: Don't cancel the ImageDecoder read request from cycle-collection unlink r=dom-core-reviewers,media-playback-reviewers,smaug,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318221\n", "files": ["dom/base/NodeIterator.cpp", "dom/media/webcodecs/ImageDecoder.cpp", "dom/media/webcodecs/ImageDecoder.h"], "git_node": "0bc40eb0438ae275b765e0c15f58293f42136ec0", "git_parents": ["7c31e6e18dc9d926c243fb015871df34d4c4456a"], "node": "f5cb05d57f0c53f6bfb95e11bca267a9070d16c1", "parents": ["582669709d2603cfc7fc39ba84916c66463c533b"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067212: Release SourceBuffer waiting consumers outside of mMutex r=azebrowski\n\nDropping the last reference to a waiting IResumable can destroy an\nimage::Decoder, whose SourceBufferIterator member reacquires mMutex from\nits destructor. Hand the references to the caller so they are released\nonce mMutex has been dropped.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321935\n", "files": ["image/SourceBuffer.cpp", "image/SourceBuffer.h"], "git_node": "fe1fb0cd1377357ccd304433440a808d37e30e97", "git_parents": ["0bc40eb0438ae275b765e0c15f58293f42136ec0"], "node": "e625f9598f3d81c125fc215610118c64f78ebf30", "parents": ["f5cb05d57f0c53f6bfb95e11bca267a9070d16c1"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063064: Restructure ImageDecoderReadRequest teardown to remove its CAN_RUN_SCRIPT_BOUNDARY r=media-playback-reviewers,aosmond,jolin\n\nImageDecoderReadRequest::Cancel() was MOZ_CAN_RUN_SCRIPT_BOUNDARY, which let\nDestroy() call it without Destroy()'s own callers -- including cycle-collection\nUnlink and ~ImageDecoder -- needing MOZ_CAN_RUN_SCRIPT. That's the annotation\ngap the previous patch closed at runtime with a bool parameter; the analyzer\ncan't see through that bool, so it never actually verified the reentrancy is\ngone.\n\nSplit the teardown into textually distinct paths instead, so the analyzer can\nverify it directly:\n\n- ImageDecoderReadRequest: Destroy() (never cancels, plain) vs.\n  DestroyAndCancel() (MOZ_CAN_RUN_SCRIPT, calls the now unboundaried Cancel()).\n- ImageDecoder: CloseWithoutRef() (plain) vs. CloseAndCancelWithoutRef()\n  (MOZ_CAN_RUN_SCRIPT), sharing teardown via CloseCommon(). Unlink, ~ImageDecoder,\n  and OnShutdown() use the plain path; Close() uses the cancelling one.\n\nOnShutdown() moving to the plain path is a real behavior change, not just an\nannotation split: it goes through nsIObserver::Observe() (main-thread shutdown)\nor a WeakWorkerRef callback (worker shutdown), and Observe() is a fixed\ninterface method that can never be MOZ_CAN_RUN_SCRIPT. Global teardown isn't a\nsafe place to run page script either, so this puts it on the same footing as\nUnlink/~ImageDecoder rather than trying to thread script-safety through\nnsIObserver.\n\nCloseCommon() also now runs the read-request step last, after mTracks/\nmCompletePromise/mShutdownWatcher are already torn down and mClosed is set, so\nany reentrancy from the cancel callback sees a fully-closed decoder instead of\na half-torn-down one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318222\n", "files": ["dom/media/webcodecs/ImageDecoder.cpp", "dom/media/webcodecs/ImageDecoder.h", "dom/media/webcodecs/ImageDecoderReadRequest.cpp", "dom/media/webcodecs/ImageDecoderReadRequest.h", "dom/media/webcodecs/ImageTrack.cpp", "dom/media/webcodecs/ImageTrack.h", "dom/media/webcodecs/ImageTrackList.h"], "git_node": "8413e50c93108e097e86bcb79b915a8fbb4e8618", "git_parents": ["fe1fb0cd1377357ccd304433440a808d37e30e97"], "node": "cd162450fac3f19e77846bc5b9796e69b32ff1c4", "parents": ["e625f9598f3d81c125fc215610118c64f78ebf30"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066010 - media: Move MediaStreamSource::CloneResult destructor out-of-line. r=media-playback-reviewers,padenot,sergesanspaille,pehrsons\n\nCloneResult's destructor needs the complete class definition for\nMediaTrack when it calls the RefPtr destructor on mInputTrack. We don't\nhave the complete class definition in MediaStreamTrack.h because\nMediaTrack is simply forward-declared.\n\nIn file included from dom/media/bridge/MediaModule.cpp:5:\nIn file included from obj-macos/xpcom/components/Components.h:10:\nIn file included from xpcom/base/nsCOMPtr.h:26:\nmfbt/RefPtr.h:49:38: error: member access into incomplete type 'mozilla::MediaTrack'\n   49 |   static void Release(U* aPtr) { aPtr-\u003eRelease(); }\n      |                                      ^\nmfbt/RefPtr.h:409:62: note: in instantiation of member function 'mozilla::RefPtrTraits\u003cmozilla::MediaTrack\u003e::Release' requested here\n  409 |     static void Release(U* aPtr) { mozilla::RefPtrTraits\u003cU\u003e::Release(aPtr); }\n      |                                                              ^\nmfbt/RefPtr.h:80:37: note: in instantiation of member function 'RefPtr\u003cmozilla::MediaTrack\u003e::ConstRemovingRefPtrTraits\u003cmozilla::MediaTrack\u003e::Release' requested here\n   80 |       ConstRemovingRefPtrTraits\u003cT\u003e::Release(mRawPtr);\n      |                                     ^\ndom/media/MediaStreamTrack.h:130:10: note: in instantiation of member function 'RefPtr\u003cmozilla::MediaTrack\u003e::~RefPtr' requested here\n  130 |   struct CloneResult {\n      |          ^\ndom/media/MediaStreamTrack.h:27:7: note: forward declaration of 'mozilla::MediaTrack'\n   27 | class MediaTrack;\n      |       ^\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320830\n", "files": ["dom/media/MediaStreamTrack.cpp", "dom/media/MediaStreamTrack.h"], "git_node": "0176c2dbb4e270799b9876dae36f1b6745defec8", "git_parents": ["8413e50c93108e097e86bcb79b915a8fbb4e8618"], "node": "56c4731aa8f16396c2e2e67ba0cc4dec38f90af8", "parents": ["cd162450fac3f19e77846bc5b9796e69b32ff1c4"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066010 - media: Move OmxPromiseLayer destructor out of line for C++23 compatibility. r=media-playback-reviewers,padenot\n\nOmxPromiseLayer owns a UniquePtr\u003cOmxPlatformLayer\u003e. Its inline\nrefcounting code deletes the object, instantiating the defaulted\ndestructor when OmxPlatformLayer is still incomplete.\n\nDefine the destructor in OmxPromiseLayer.cpp, where OmxPlatformLayer is\ncomplete and libc++ can instantiate the UniquePtr destructor.\n\nMacOSX26.2.sdk/usr/include/c++/v1/__memory/unique_ptr.h:76:19: error: invalid application of 'sizeof' to an incomplete type 'mozilla::OmxPlatformLayer'\n   76 |     static_assert(sizeof(_Tp) \u003e= 0, \"cannot delete an incomplete type\");\n      |                   ^~~~~~~~~~~\ndom/media/platforms/omx/OmxPromiseLayer.h:42:11: note: in instantiation of member function 'std::unique_ptr\u003cmozilla::OmxPlatformLayer\u003e::~unique_ptr' requested here\n   42 |   virtual ~OmxPromiseLayer() = default;\n      |           ^\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320831\n", "files": ["dom/media/platforms/omx/OmxPromiseLayer.cpp", "dom/media/platforms/omx/OmxPromiseLayer.h"], "git_node": "753cca571ddf1f280f3a3d664da347f2482a5e3f", "git_parents": ["0176c2dbb4e270799b9876dae36f1b6745defec8"], "node": "93881e0967661904b80dff5e082e01f34c5e3a8e", "parents": ["56c4731aa8f16396c2e2e67ba0cc4dec38f90af8"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066010 - media: Move MediaFoundationInitializer's sInitializer definition out of line for C++23 compatibility. r=media-playback-reviewers,padenot\n\nMediaFoundationInitializer::sInitializer is an inline static\nUniquePtr\u003cMediaFoundationInitializer\u003e. Defining it inside the class\ninstantiates the UniquePtr destruction path when\nMediaFoundationInitializer is still incomplete. Define sInitializer in\nWMFUtils.cpp, after MediaFoundationInitializer is complete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320832\n", "files": ["dom/media/platforms/wmf/WMF.h", "dom/media/platforms/wmf/WMFUtils.cpp"], "git_node": "e1183a5821be2455e480a61d101ed1a982eda387", "git_parents": ["753cca571ddf1f280f3a3d664da347f2482a5e3f"], "node": "9a4754ce2302b7363473bfa8f6995119902e788c", "parents": ["93881e0967661904b80dff5e082e01f34c5e3a8e"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2041141 - Upstream PreviewThemeProvider and Theme from Fenix to compose-base r=android-reviewers,007\n\n- This allows us to use the PreviewThemeProvider in compose-base and provide Compose Previews of the Acorn Design components in all the various supported themes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321686\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/PreviewThemeProvider.kt", "mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/Theme.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabstray/ui/TabManagerThemeProviderTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabstray/ui/tabitems/TabGroupOnboardingItemTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/theme/ThemeProviderTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/DownloadAddonDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/AppLinksPromptFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/tabstrip/TabStrip.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/HomepageThumbnailIntegration.kt", "mobile/android/fenix/app/src/main/java/org/