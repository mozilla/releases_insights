droid/fenix/app/src/main/java/org/mozilla/fenix/settings/logins/ui/SavedLoginsScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/logins/ui/TrailingIcons.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/search/SearchEngineShortcuts.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelHeader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/wallpaper/WallpaperSettings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/AddToTabGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/CloseLastTabAndDeleteTabGroupConfirmationDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/DeleteTabGroupConfirmationDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/EditTabGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/UngroupTabGroupConfirmationDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/banner/TabsTrayBanner.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/TabGridTabItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/PrivateTabsPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayout.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/theme/TabManagerThemeProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/FirefoxTheme.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/PreviewThemeProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/TabGroupColors.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/Theme.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/ThemeProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/trackingprotection/ProtectionsDashboardContent.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/DownloadIndicator.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationOptionsDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationToolbar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationsDialogBottomSheet.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/automatic/AutomaticTranslationOptionsPreference.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/automatic/AutomaticTranslationPreference.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/downloadlanguages/DeleteLanguageFileDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/downloadlanguages/DownloadLanguageFileDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/downloadlanguages/DownloadLanguagesPreference.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/preferences/nevertranslatesite/NeverTranslateSitesPreference.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/settings/TranslationSettings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/BrokenSiteReasonListItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/EditUrlConfirmationDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporterPreviewSheet.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/addons/DownloadAddonDialogFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/GoogleLensOptOutBottomSheetTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItemTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/MainMenuTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/compose/navigation/BottomSheetSceneStrategyTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSiteStateTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSitesExpandToggleTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/ui/PdfToolsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/ui/SignatureDialogTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/IPProtectionScreenTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/labs/ui/FirefoxLabsScreenTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/ui/ProtectionPanelTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/AddToTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/EditTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ExpandedTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/fab/TabManagerFloatingToolbarTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayoutTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/trackingprotection/TrackersBlockedCardTest.kt"], "git_node": "8c5866445498f3f1e951cf8e47192ea74f7a37ed", "git_parents": ["e1183a5821be2455e480a61d101ed1a982eda387"], "node": "a6f4de3f14933184c6749157bc4354a7f321813e", "parents": ["9a4754ce2302b7363473bfa8f6995119902e788c"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2066887 - Add OLED theme to FirefoxTheme r=android-reviewers,007\n\n- Add OLED theme as an option to `Theme` and integrate it with `FirefoxTheme` to show the correct OLED colors in Compose Previews.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321687\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/Theme.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/FirefoxTheme.kt"], "git_node": "55213f688b69fd2c573463a54509c42c8292eada", "git_parents": ["8c5866445498f3f1e951cf8e47192ea74f7a37ed"], "node": "f2d6e4b636fc51ee11b09a6746d7bd4d25961095", "parents": ["a6f4de3f14933184c6749157bc4354a7f321813e"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2061076 - Add the Acorn OLED colors in the XML colors r=android-reviewers,007\n\n- The plan is to inherit from the dark theme for the OLED theme and change the color tokens where they differ.\n- This simplifies XML theming where we avoid duplicating style items in styles.xml similar to the standalone Private theme.\n\nFigma: https://www.figma.com/design/MjufE1X5fvkxZ0YneX4kRd/Android-Library--Nova-?node-id=64745-6585&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321931\n", "files": ["mobile/android/fenix/app/src/main/res/values/colors.xml"], "git_node": "f201871f3f8df9a784d580742c851e84e76f4cab", "git_parents": ["55213f688b69fd2c573463a54509c42c8292eada"], "node": "ab04353d24955e3fba5505bda70b3f82b08f0a91", "parents": ["f2d6e4b636fc51ee11b09a6746d7bd4d25961095"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 325891 - Dispatch `DOMContentLoaded` for XSLT result documents r=smaug\" for causing crashtests failures on 1205163.xml.\n\nThis reverts commit a76e6393486ac15b123e1b8b9598ff903de337cb.\n", "files": ["dom/html/test/test_bug347174_xsl.html", "dom/xml/nsXMLContentSink.cpp"], "git_node": "dee180f7d94a44364c613ac2816f041230148e9d", "git_parents": ["f201871f3f8df9a784d580742c851e84e76f4cab"], "node": "b5d42d2f460e455f7ca58680aa79bd7ca2f28f63", "parents": ["ab04353d24955e3fba5505bda70b3f82b08f0a91"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2057763 - Keep a suggestion the user picked when a load finishes behind the open view. r=adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320861\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser.toml", "browser/components/urlbar/tests/browser-UrlbarInput/browser_setURI_keepsSelectedResult.js"], "git_node": "b7032032c6e80725e07de87d76b92ab2be08f5e3", "git_parents": ["dee180f7d94a44364c613ac2816f041230148e9d"], "node": "13499d0a86f15b9652b5e57c0f367006cdae51db", "parents": ["b5d42d2f460e455f7ca58680aa79bd7ca2f28f63"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018625 - Add a wdspec test for touch pointers released in a single tick. r=whimboo\n\nThe Actions API divides time into ticks, and the actions of every input source\nwithin one tick happen at the same moment: the remote end \"will dispatch the\nfirst action of each source together, then the second actions together, and\nlastly, the final actions together\" (https://w3c.github.io/webdriver/#actions,\nexample 11).\n\nTouch Events makes that observable without measuring any timing, because\nchangedTouches is defined per moment rather than per event target.  Two touch\npointers released from different elements in one tick produce one touchend per\ntarget either way, so the number of events says nothing; what distinguishes a\nsimultaneous release is that both events report both removed touch points and\nan empty touches list.\n\nGecko passes.  Chrome 153.0.8010.0 reports one changed touch point per event\nand, in the first of the two events, a touches list that still contains the\nother finger, i.e. a state that cannot exist if the two releases happened at\nthe same moment.\n\nThe events are compared target-sorted because the order in which a user agent\ndispatches the events for the several targets of one moment is not defined.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319009\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_touch_simultaneous.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_touch_simultaneous.py"], "git_node": "9c99c20ed4a6792fd51a9fde06d97f5c21f846b8", "git_parents": ["b7032032c6e80725e07de87d76b92ab2be08f5e3"], "node": "6849bb4ae5cdb089937aefdcc13836dfaa1fe3bb", "parents": ["13499d0a86f15b9652b5e57c0f367006cdae51db"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018625 - Dispatch one touch event per distinct target rather than one per changed touch point. r=edgar\n\nPresShell::EventHandler::DispatchTouchEventToDOM() loops over every changed\ntouch point and dispatches a separate DOM event for each one.  When more than\none touch point changes in a single widget event -- which happens constantly\nwhile pinching -- the page therefore receives several touchmove events in a\nrow carrying identical touches and changedTouches lists, since both lists are\nderived from the full touch list of the widget event.\n\nDispatch at most one event per distinct target instead.  Both Blink and WebKit\ndo the same, collecting the targets of the changed touch points into a set and\ndispatching one TouchEvent per entry, so this follows them.\n\ntest_mouse_events_after_touchend.html and mouseevents-after-touchend.tentative.html\nreleased two touch points on the same target at once and expected two touchend\nevents, so they now expect the single touchend that carries both of them.  For\nthe latter that is also what the WebDriver actions it performs should produce:\nactions belonging to one tick happen at the same moment\n(https://w3c.github.io/webdriver/#actions, example 11), so the two touch points\nare removed at the same moment.  The test reports changedTouches and touches now\nso that a mismatch says which behaviour a browser has rather than only that the\nnumber of events differs.\n\nmulti-touch-interactions.html gains two subtests and loses one.  The one that\nstarts failing hits the same assertion that already fails for touchend #1, that\nthe previously received targetTouches for the target is not empty, so it is a\npre-existing problem now reached for a second target rather than a new one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319010\n", "files": ["dom/events/test/mochitest.toml", "dom/events/test/test_mouse_events_after_touchend.html", "dom/events/test/test_touchmove_once_per_target.html", "layout/base/PresShell.cpp", "testing/web-platform/meta/touch-events/multi-touch-interactions.html.ini", "testing/web-platform/tests/touch-events/mouseevents-after-touchend.tentative.html"], "git_node": "83fc5601a797a90d78babb1f2153ee4766ebc9f9", "git_parents": ["9c99c20ed4a6792fd51a9fde06d97f5c21f846b8"], "node": "6817e1b29dd4a83308bd9806f609f799720703f6", "parents": ["6849bb4ae5cdb089937aefdcc13836dfaa1fe3bb"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2065596 - Don't instantiate nimbus client in crash reporter r=android-reviewers,ohall\n\nThis updates the crash reporter to use the new API provided by Nimbus in\nbug 2065595.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321385\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Analytics.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/NimbusComponents.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/crashes/NimbusExperimentDataProvider.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/crashes/NimbusExperimentDataProviderTest.kt"], "git_node": "e308573b442d81c0ee3d19ff8928a7e8d2f9950f", "git_parents": ["83fc5601a797a90d78babb1f2153ee4766ebc9f9"], "node": "59589ec7e4b37167bd960200c24b3577e42ebe9b", "parents": ["6817e1b29dd4a83308bd9806f609f799720703f6"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066605 - show tls key logging warning in about:preferences r=hjones,fluent-reviewers,desktop-theme-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321402\n", "files": ["browser/components/preferences/preferences.js", "browser/components/preferences/preferences.xhtml", "browser/components/preferences/tests/browser.toml", "browser/components/preferences/tests/browser_tls_key_logging_warning.js", "browser/components/preferences/widgets/nav-notice/nav-notice.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/preferences/preferences.css"], "git_node": "14ac3d040df0d0f9d171d285c8170dbd8eaccb7c", "git_parents": ["e308573b442d81c0ee3d19ff8928a7e8d2f9950f"], "node": "502f65cae8fac536993cf2e5889d7025a83752d2", "parents": ["59589ec7e4b37167bd960200c24b3577e42ebe9b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063085 - Part 1: Keep zero-valued samples when collecting measurements. r=perftest-reviewers,sparky\n\nA guard meant to stop on empty input also matched zero, because zero is falsy, so\nany series that legitimately measures zero lost those samples. The remaining ones\nwere then averaged as though they were the whole run.\n\nNumbers are exempted from the guard explicitly rather than by comparing against\nzero, which is also true of False and would let a bool into a numeric series.\n\nflatten() is shared, so the effect is not confined to power. Speedometer 3's\ns3_internal metrics and any test using test_summary = \"flatten\" can gain\nreplicates, and a submetric that was all zeros will appear as a new subtest, so\nexpect a one-time step on those series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321065\n", "files": ["testing/raptor/raptor/utils.py", "testing/raptor/test/test_utils.py"], "git_node": "c9dc9388da1b8a85abed61a73feb2729325862be", "git_parents": ["14ac3d040df0d0f9d171d285c8170dbd8eaccb7c"], "node": "47e0dc51cf51c1b8ea2b501c39c408d9ca6d308d", "parents": ["502f65cae8fac536993cf2e5889d7025a83752d2"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063085 - Part 2: Add the Raptor power test definition for media playback. r=perftest-reviewers,frontend-codestyle-reviewers,sparky\n\nNothing in Raptor measures what watching a video costs in power. Add a suite that\ndoes, as two tracks that each force the decode path they are named for.\n\nForcing it is what lets a subtest name state what was measured. The software track\nis sound by construction, since disabling hardware decode is a UserDisable no\nfallback can undo, and it is Firefox-only because a manifest's preferences are not\napplied to other browsers. The hardware track is weaker: the preference only lifts\nthe gfxInfo blocklist, and H.264 falls back to software silently, so that path is\nassumed rather than asserted and the manifest says so.\n\nThe workload is not added here. It lives in the shared benchmark repository, which\nRaptor clones at a named revision, so the same page can be driven by other\nharnesses. The two are versioned separately, so the script feature-detects the\nentry points it needs and fails immediately when they are absent, rather than\nwaiting for a state that will never arrive.\n\nEnergy over the chip package is the only series that alerts, at five percent. The\npresented frame rate guards it, since playback that stops keeping up decodes less\nand would otherwise read as an improvement. The reported value is a median of the\nmeasurement windows rather than a mean, so a cycle disturbed by something other\nthan playback does not move it.\n\nFive percent because it is roughly four times the run-to-run scatter, measured\nover ten runs on ten machines and once Perfherder's averaging over a dozen\nrevisions is accounted for. Worth revisiting in either direction once there is\ntrunk history.\n\nThe generated documentation is included here rather than split out, because the\nperfdocs check verifies each commit independently and a manifest without its\ngenerated entry fails it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321062\n", "files": ["eslint-file-globals.config.mjs", "testing/perfdocs/generated/raptor-metrics.md", "testing/perfdocs/generated/raptor.md", "testing/raptor/browsertime/media_playback.js", "testing/raptor/browsertime/support-scripts/media_playback.py", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/raptor.toml", "testing/raptor/raptor/tests/custom/browsertime-media-playback-sw.toml", "testing/raptor/raptor/tests/custom/browsertime-media-playback.toml"], "git_node": "a6a4840e874dc090d231cdef02babba5c03d2514", "git_parents": ["c9dc9388da1b8a85abed61a73feb2729325862be"], "node": "344b0257767530b457c86771f933e7f8e52e90d2", "parents": ["47e0dc51cf51c1b8ea2b501c39c408d9ca6d308d"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063085 - Part 3: Schedule the media playback benchmark on Windows. r=perftest-reviewers,sparky\n\nRun the suite where desktop power measurement is available, which is Windows\nhardware workers.\n\nSchedule a deliberately small subset of the subtests the manifests define: one\nsoftware, one hardware, and the idle baseline they are read against. The suite is\nnew and its spread on trunk is not yet known, so it starts at the smallest set\nthat still covers both decode paths and widens once there is history to justify\nit. Adding a codec or a resolution back is a line in the subtest list.\n\n2160p is the hardware representative because more pixels make playback a larger\nshare of the energy being measured, which is the difficulty this suite works\naround: the browser costs most of the reading just by being open.\n\nThe hardware track runs both browsers so they can be compared; the software track\nis Firefox-only, since no preference can hold another browser to software decode.\nOnly Firefox runs on trunk, so adding a browser does not add scheduled load until\nit is asked for.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321063\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "taskcluster/test_configs/test-sets.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "dc1d4c288f0337f23f0c9e64adf5e715751f01fd", "git_parents": ["a6a4840e874dc090d231cdef02babba5c03d2514"], "node": "499eb8724d083474d73dd2b4206749e640d821ac", "parents": ["344b0257767530b457c86771f933e7f8e52e90d2"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065422 - Open the View Tab Groups list on hover and let the pointer take it over r=gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321044\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js"], "git_node": "9b6b2447a220e4459c7389327f7bbb04337c1b13", "git_parents": ["dc1d4c288f0337f23f0c9e64adf5e715751f01fd"], "node": "e8807b58ea4e70602dc46bf99a24fd136553ebc9", "parents": ["499eb8724d083474d73dd2b4206749e640d821ac"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064008 - Keep the Organize Tabs panel and its list of groups after a group is deleted r=gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321045\n", "files": ["browser/base/content/main-popupset.js", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js"], "git_node": "8d0929d1eb743c5be16d69811b5c95a5a152b4bb", "git_parents": ["9b6b2447a220e4459c7389327f7bbb04337c1b13"], "node": "37b4c1fcfe1a2f7c50c3e3c95ad6e8d64cbcd62c", "parents": ["e8807b58ea4e70602dc46bf99a24fd136553ebc9"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063555 - Make the Organize Tabs panel's \"Just created\" rows switch to the group they name r=desktop-theme-reviewers,mstriemer,gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321046\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "302e57c7c00e26f6fc743a8abf3f841f19f6567f", "git_parents": ["8d0929d1eb743c5be16d69811b5c95a5a152b4bb"], "node": "ccba1d65e1c2dda7959fa752f9b697fb7feb8c50", "parents": ["37b4c1fcfe1a2f7c50c3e3c95ad6e8d64cbcd62c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/feature/summarize/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-cs/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ia/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-be/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-es/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/focus-android/app/src/main/res/values-el/strings.xml"], "git_node": "abbfc4c47174ef944bdcd55303fadb392efb3ed9", "git_parents": ["302e57c7c00e26f6fc743a8abf3f841f19f6567f"], "node": "87fc6112d54b19f5032d604c82dcf4b8445c828d", "parents": ["ccba1d65e1c2dda7959fa752f9b697fb7feb8c50"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066926 - Harden WebRender display list building against a missing animation id for a sticky item. r=tnikkel,layout-reviewers\n\nAlso add some diagnostic asserts to try to narrow down the cause of\nthe missing animation id.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321739\n", "files": ["layout/painting/nsDisplayList.cpp"], "git_node": "ed19499f0360cab7dd982ed6665c17610866f061", "git_parents": ["abbfc4c47174ef944bdcd55303fadb392efb3ed9"], "node": "a0cf2fad443acbe5502a5a4c2a3229235a71d5f9", "parents": ["87fc6112d54b19f5032d604c82dcf4b8445c828d"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2047723 - Test SoundTouch destination limit through AudioDecoderInputTrack. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309931\n", "files": ["dom/media/gtest/TestAudioDecoderInputTrack.cpp", "dom/media/mediasink/AudioDecoderInputTrack.cpp", "dom/media/mediasink/AudioDecoderInputTrack.h"], "git_node": "b0e358901b4157c483776ab677623fe9448e4dbd", "git_parents": ["ed19499f0360cab7dd982ed6665c17610866f061"], "node": "2f753f46aa09430199f3c83a7c58d68c4d0d2dee", "parents": ["a0cf2fad443acbe5502a5a4c2a3229235a71d5f9"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2018625 - Dispatch one touch event per distinct target rather than one per changed touch point. r=edgar\" for causing bc assertion failures on MouseEvent.cpp.\n\nThis reverts commit 83fc5601a797a90d78babb1f2153ee4766ebc9f9.\n\nRevert \"Bug 2018625 - Add a wdspec test for touch pointers released in a single tick. r=whimboo\"\n\nThis reverts commit 9c99c20ed4a6792fd51a9fde06d97f5c21f846b8.\n", "files": ["dom/events/test/mochitest.toml", "dom/events/test/test_mouse_events_after_touchend.html", "dom/events/test/test_touchmove_once_per_target.html", "layout/base/PresShell.cpp", "testing/web-platform/meta/touch-events/multi-touch-interactions.html.ini", "testing/web-platform/tests/touch-events/mouseevents-after-touchend.tentative.html", "testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_touch_simultaneous.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_touch_simultaneous.py"], "git_node": "686599be10a48c89e3b3e92af6e8b7d70b8c945a", "git_parents": ["b0e358901b4157c483776ab677623fe9448e4dbd"], "node": "f6a4445d7786b20f2619f3b845fc13c5525b4935", "parents": ["2f753f46aa09430199f3c83a7c58d68c4d0d2dee"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2061081 - Properly handle line-height \u003cnumber\u003e calcs with percentages or lh-lengths. r=firefox-style-system-reviewers,emilio,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317242\n", "files": ["servo/components/style/values/generics/font.rs", "servo/components/style/values/specified/font.rs", "servo/components/style/values/specified/number.rs", "testing/web-platform/meta/css/css-values/typed_arithmetic.html.ini", "testing/web-platform/tests/css/css-values/crashtests/chrome-bug-508472243.html", "testing/web-platform/tests/css/css-values/typed_arithmetic.html"], "git_node": "48206dde565e0ba49bec178566510275f4515bb1", "git_parents": ["686599be10a48c89e3b3e92af6e8b7d70b8c945a"], "node": "8f2ccb660c4022fcc0fb45f9fbbf2294ea52a2df", "parents": ["f6a4445d7786b20f2619f3b845fc13c5525b4935"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2063555, Bug 2065422, Bug 2064008 - Make the Organize Tabs panel's \"Just created\" rows switch to the group they name r=desktop-theme-reviewers,mstriemer,gcardieri\" for causing bc assertion failures on MouseEvent.cpp.\n\nThis reverts commit 302e57c7c00e26f6fc743a8abf3f841f19f6567f.\n\nRevert \"Bug 2064008 - Keep the Organize Tabs panel and its list of groups after a group is deleted r=gcardieri\"\n\nThis reverts commit 8d0929d1eb743c5be16d69811b5c95a5a152b4bb.\n\nRevert \"Bug 2065422 - Open the View Tab Groups list on hover and let the pointer take it over r=gcardieri\"\n\nThis reverts commit 9b6b2447a220e4459c7389327f7bbb04337c1b13.\n", "files": ["browser/base/content/main-popupset.js", "browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "e83f7e393f20e7286a1bd1621159517d9eb4c376", "git_parents": ["48206dde565e0ba49bec178566510275f4515bb1"], "node": "23e78a64f64ff3c0be953845cc72201b1f1bbabc", "parents": ["8f2ccb660c4022fcc0fb45f9fbbf2294ea52a2df"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061081 - Properly handle line-height \u003cnumber\u003e calcs with percentages or lh-lengths. r=firefox-style-system-reviewers,emilio,dshin\" for causing mass build bustages.\n\nThis reverts commit 48206dde565e0ba49bec178566510275f4515bb1.\n", "files": ["servo/components/style/values/generics/font.rs", "servo/components/style/values/specified/font.rs", "servo/components/style/values/specified/number.rs", "testing/web-platform/meta/css/css-values/typed_arithmetic.html.ini", "testing/web-platform/tests/css/css-values/crashtests/chrome-bug-508472243.html", "testing/web-platform/tests/css/css-values/typed_arithmetic.html"], "git_node": "7a7cba55490b68061facb1beee6163fdf82b03f6", "git_parents": ["e83f7e393f20e7286a1bd1621159517d9eb4c376"], "node": "0534a06c76fe219ec2136da63f172bcd664d4ec0", "parents": ["23e78a64f64ff3c0be953845cc72201b1f1bbabc"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018625 - Add a wdspec test for touch pointers released in a single tick. r=whimboo\n\nThe Actions API divides time into ticks, and the actions of every input source\nwithin one tick happen at the same moment: the remote end \"will dispatch the\nfirst action of each source together, then the second actions together, and\nlastly, the final actions together\" (https://w3c.github.io/webdriver/#actions,\nexample 11).\n\nTouch Events makes that observable without measuring any timing, because\nchangedTouches is defined per moment rather than per event target.  Two touch\npointers released from different elements in one tick produce one touchend per\ntarget either way, so the number of events says nothing; what distinguishes a\nsimultaneous release is that both events report both removed touch points and\nan empty touches list.\n\nGecko passes.  Chrome 153.0.8010.0 reports one changed touch point per event\nand, in the first of the two events, a touches list that still contains the\nother finger, i.e. a state that cannot exist if the two releases happened at\nthe same moment.\n\nThe events are compared target-sorted because the order in which a user agent\ndispatches the events for the several targets of one moment is not defined.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319009\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/pointer_touch_simultaneous.py", "testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_touch_simultaneous.py"], "git_node": "9e431c392f17027d477351a9a8f13e6081f4e026", "git_parents": ["7a7cba55490b68061facb1beee6163fdf82b03f6"], "node": "d40928b676a99b04ac534a1b48321e05b83bf57d", "parents": ["0534a06c76fe219ec2136da63f172bcd664d4ec0"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2018625 - Dispatch one touch event per distinct target rather than one per changed touch point. r=edgar\n\nPresShell::EventHandler::DispatchTouchEventToDOM() loops over every changed\ntouch point and dispatches a separate DOM event for each one.  When more than\none touch point changes in a single widget event -- which happens constantly\nwhile pinching -- the page therefore receives several touchmove events in a\nrow carrying identical touches and changedTouches lists, since both lists are\nderived from the full touch list of the widget event.\n\nDispatch at most one event per distinct target instead.  Both Blink and WebKit\ndo the same, collecting the targets of the changed touch points into a set and\ndispatching one TouchEvent per entry, so this follows them.\n\ntest_mouse_events_after_touchend.html and mouseevents-after-touchend.tentative.html\nreleased two touch points on the same target at once and expected two touchend\nevents, so they now expect the single touchend that carries both of them.  For\nthe latter that is also what the WebDriver actions it performs should produce:\nactions belonging to one tick happen at the same moment\n(https://w3c.github.io/webdriver/#actions, example 11), so the two touch points\nare removed at the same moment.  The test reports changedTouches and touches now\nso that a mismatch says which behaviour a browser has rather than only that the\nnumber of events differs.\n\nmulti-touch-interactions.html gains two subtests and loses one.  The one that\nstarts failing hits the same assertion that already fails for touchend #1, that\nthe previously received targetTouches for the target is not empty, so it is a\npre-existing problem now reached for a second target rather than a new one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319010\n", "files": ["dom/events/test/mochitest.toml", "dom/events/test/test_mouse_events_after_touchend.html", "dom/events/test/test_touchmove_once_per_target.html", "layout/base/PresShell.cpp", "testing/web-platform/meta/touch-events/multi-touch-interactions.html.ini", "testing/web-platform/tests/touch-events/mouseevents-after-touchend.tentative.html"], "git_node": "b5c49ed2300f830adb76a44dd45683c1928229a5", "git_parents": ["9e431c392f17027d477351a9a8f13e6081f4e026"], "node": "c03d3fc66992f9ae0c981da793d350cb07ebb109", "parents": ["d40928b676a99b04ac534a1b48321e05b83bf57d"], "tags": []}, {"author": "Olivier Mehani \u003comehani@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063147 - workflows: automatically retarget PRs to autoland DOT_GITHUB_OVERRIDE DONTBUILD r=zeid\n\nThis is the most common use-case, so we make this the default.\n\nNote: due to the way the link to lando is then created based on the\ncurrent target ref, the repo must be configured with a LANDO_REPO\nActions variable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318376\n", "files": [".github/workflows/pr-handler.yml"], "git_node": "4ec167cb6a6534e924634c820867599e3b9abd52", "git_parents": ["b5c49ed2300f830adb76a44dd45683c1928229a5"], "node": "6b30592c457b154a7f52e1a28e330effd0389c2e", "parents": ["c03d3fc66992f9ae0c981da793d350cb07ebb109"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2038810 - Use the new Python `l10n` actions by default r=firefox-build-system-reviewers,sylvestre\" for causing android ship build bustages\n\nThis reverts commit 64bf121af2dcab51cab157198e2de18f07be56b1.\n\nRevert \"Bug 2038810 - Sort the langpack chrome resources r=firefox-build-system-reviewers,sylvestre\"\n\nThis reverts commit f0ed59b398aba7129d58b2c3bc4452477038a270.\n\nRevert \"Bug 2038810 - Ensure the Windows uninstaller is built for the repacked locale r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit ec4e3e4cd3ce5d39392162e2f2f4184bd3f887ce.\n", "files": ["moz.configure", "python/mozbuild/mozbuild/action/l10n_repackage.py", "python/mozbuild/mozbuild/action/langpack_manifest.py", "python/mozbuild/mozbuild/test/action/test_langpack_manifest.py"], "git_node": "0627cd2a94724040ceeaf07f0b92b4f14df36da9", "git_parents": ["4ec167cb6a6534e924634c820867599e3b9abd52"], "node": "1ca6f9c1349c9faa1966783de7996c1f2656dfb4", "parents": ["6b30592c457b154a7f52e1a28e330effd0389c2e"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065422 - Open the View Tab Groups list on hover and let the pointer take it over r=gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321044\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js"], "git_node": "655e80598076765c3f3c7fdd3b830f0178cef9ca", "git_parents": ["0627cd2a94724040ceeaf07f0b92b4f14df36da9"], "node": "e01f19b0860b4261fce7afc15bd7cbf74be7a943", "parents": ["1ca6f9c1349c9faa1966783de7996c1f2656dfb4"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064008 - Keep the Organize Tabs panel and its list of groups after a group is deleted r=gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321045\n", "files": ["browser/base/content/main-popupset.js", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js"], "git_node": "f5414439314d094c71c9e2cedfdfdb352744d4da", "git_parents": ["655e80598076765c3f3c7fdd3b830f0178cef9ca"], "node": "f534a892feb4f904e5cc361b4baef3ac70dba5d7", "parents": ["e01f19b0860b4261fce7afc15bd7cbf74be7a943"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063555 - Make the Organize Tabs panel's \"Just created\" rows switch to the group they name r=desktop-theme-reviewers,mstriemer,gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321046\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "9ccfc98a0be7e2221d508a5a086435eb1dd70ced", "git_parents": ["f5414439314d094c71c9e2cedfdfdb352744d4da"], "node": "19692aecc5ba06f0576d24acf6af4e529781dee2", "parents": ["f534a892feb4f904e5cc361b4baef3ac70dba5d7"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2061081 - Properly handle line-height \u003cnumber\u003e calcs with percentages or lh-lengths. r=firefox-style-system-reviewers,emilio,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317242\n", "files": ["servo/components/style/values/generics/font.rs", "servo/components/style/values/specified/font.rs", "servo/components/style/values/specified/number.rs", "testing/web-platform/meta/css/css-values/typed_arithmetic.html.ini", "testing/web-platform/tests/css/css-values/crashtests/chrome-bug-508472243.html", "testing/web-platform/tests/css/css-values/typed_arithmetic.html"], "git_node": "a4539520040893fd248c338bbca012e8a6644066", "git_parents": ["9ccfc98a0be7e2221d508a5a086435eb1dd70ced"], "node": "576a9f6a4d8632ffd76a6024e3804b584602ba5c", "parents": ["19692aecc5ba06f0576d24acf6af4e529781dee2"], "tags": []}, {"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065540 - Add additional logging to PrivacyReportNotificationWorker r=android-reviewers,joberhauser\n\nThis patch adds additional logging to make our lives easier when we need to debug this feature down the line. The debugging mostly follows the same pattern as `MessageNotificationWorker`. While doing so, I noticed that the `cancel` function was not in a try-catch block which I added so we can capture specific results from the outcome rather than a basic \"cancel() was called\" log which is not nearly as helpful.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321972\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorker.kt"], "git_node": "aeb3b8186a065c2440dc805ee0cd562ccc3b95a0", "git_parents": ["a4539520040893fd248c338bbca012e8a6644066"], "node": "302c980af9989bce9a5b5fd648bbee1b298a1198", "parents": ["576a9f6a4d8632ffd76a6024e3804b584602ba5c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033008 - Remove the primitive dimension design tokens. r=desktop-theme-reviewers,tabbrowser-reviewers,nsharpley,emilio\n\nEvery token keeps its resolved value. The panel promo gaps move onto the rem-based space scale, so they follow chrome's system-font root instead of a fixed 2px and 8px, dropping the stylelint suppressions they carried.\n\nThe Nova overrides for the item sizes and the medium icon size now repeat the brand literals, so `mach buildtokens` prunes them; about:newtab reads both from the ungated foundation layer.\n\nInlining the literals also exposes former dimension aliases to the stylelint autofix map, giving several raw pixel values a fix they lacked. One of them, 40px, lands on a component-specific token; bug 2067337 covers that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321801\n", "files": ["browser/base/content/test/static/browser_parsable_css.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.css", "browser/components/aiwindow/ui/components/ai-chat-grid/ai-chat-grid.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/components/aiwindow/ui/components/smartwindow-smartbar-glow/smartwindow-smartbar-glow.css", "browser/components/aiwindow/ui/content/ai-window-shared.css", "browser/components/asrouter/content-src/styles/_feature-callout.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/sharing/content/content-sharing-modal.css", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/_SportsWidget.scss", "browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/tabbrowser/tabs.css", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.css", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.json", "toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/themes/shared/design-system/config/helpers/general/token-categories.mjs", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/panel.css", "toolkit/themes/shared/design-system/src/tokens/base/dimension.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/size.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/size.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/space.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/icon.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/icon.tokens.json", "toolkit/themes/shared/design-system/storybook/tokens-table.stories.mjs", "toolkit/themes/shared/global-shared.css", "toolkit/themes/shared/in-content/info-pages.css", "tools/lint/stylelint/stylelint-plugin-mozilla/config.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.size.tests.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-design-tokens.space.tests.mjs"], "git_node": "20c431dfdf6e79b9b827987e52bc227255847ca8", "git_parents": ["aeb3b8186a065c2440dc805ee0cd562ccc3b95a0"], "node": "5d7fdbfbebb9f3ec4f59240cea1335df3c7637ea", "parents": ["302c980af9989bce9a5b5fd648bbee1b298a1198"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2066084. Give a preserve-3d participant with a hidden backface its own transform item so its descendants are culled with it. r=layout-reviewers,emilio\n\nA frame with backface-visibility: hidden inside a preserve-3d parent counts as\nparticipating in the 3D rendering context, but when it has no transform of its\nown it never gets a transform display item. ItemParticipatesIn3DContext only\nrecognizes transform and perspective items, so the participant's items end up in\nthe shared separator keyed on the 3D context root, whose backface is visible,\nand nothing culls them when the participant is turned away.\n\nbackface-visibility is not inherited, so this leaks the participant's whole\nsubtree rather than just its own items.\n\nLook for such a participant while sorting the 3D context root's items, and give\nthe item a transform item of its own keyed on the participant. Both the painting\nand the hit testing paths already cull on that item, so no other changes are\nneeded. The participant's own items were handled this way until bug 1097464\nreplaced WrapPreserve3DListInternal; the descendants were never covered.\n\nThe walk to find the participant follows the flattened tree, so an out of flow\ndescendant whose frame has been hoisted out of the participant's frame subtree\nis still culled with it. That is what makes\ncss/css-transforms/backface-visibility-hidden-004.html pass, without\nbackface-visibility having to establish a containing block.\n\npreserve3d-backface-hit-test-2.html asserted that a descendant of a backface\nhidden face is still hit. That was our behaviour when the test was added in bug\n1933521 by myself, but Chrome and Safari both hit the front face instead, and now\nso do we, so update the test to expect that. The testcases in bug 1933521 and in\nthe bugs linked from it still behave correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320886\n", "files": ["layout/generic/nsIFrame.cpp", "layout/reftests/transform-3d/reftest.list", "testing/web-platform/meta/css/css-transforms/backface-visibility-hidden-004.html.ini", "testing/web-platform/meta/css/css-transforms/transform3d-backface-visibility-006.html.ini", "testing/web-platform/tests/css/css-transforms/backface-visibility-hidden-subtree.html", "testing/web-platform/tests/css/css-transforms/preserve3d-backface-hit-test-2.html"], "git_node": "8d6a6899c74d3bf08af84ec4b42fd46e8c220f15", "git_parents": ["20c431dfdf6e79b9b827987e52bc227255847ca8"], "node": "51ae7e8eb7578ec7431f9d037b6bd32a03caf424", "parents": ["5d7fdbfbebb9f3ec4f59240cea1335df3c7637ea"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1877325 - Have TestAsyncPanZoomController automatically configure the default touch behaviors, unless told not to. r=ajakobi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321053\n", "files": ["gfx/layers/apz/test/gtest/APZTestCommon.h", "gfx/layers/apz/test/gtest/TestGestureDetector.cpp", "gfx/layers/apz/test/gtest/TestPanning.cpp", "gfx/layers/apz/test/gtest/TestPinching.cpp"], "git_node": "e2ed8b0e66de0d21c356b2c2c842922d5c41238a", "git_parents": ["8d6a6899c74d3bf08af84ec4b42fd46e8c220f15"], "node": "8815c87a4a566d3bfbf08036e55181a688d96391", "parents": ["51ae7e8eb7578ec7431f9d037b6bd32a03caf424"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1877325 - Remove explicit touch behavior configuration that was made redundant by the previous patch. r=ajakobi\n\nAlso simplify the signature of\nTestAsyncPanZoomController::ReceiveInputEvent now that no one used its\naTouchBehaviors parameter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321054\n", "files": ["gfx/layers/apz/test/gtest/APZTestCommon.h", "gfx/layers/apz/test/gtest/TestBasic.cpp", "gfx/layers/apz/test/gtest/TestFlingAcceleration.cpp", "gfx/layers/apz/test/gtest/TestGestureDetector.cpp", "gfx/layers/apz/test/gtest/TestOverscroll.cpp", "gfx/layers/apz/test/gtest/TestPanning.cpp", "gfx/layers/apz/test/gtest/TestPinching.cpp", "gfx/layers/apz/test/gtest/TestScrollHandoff.cpp"], "git_node": "5fe7c5421afd73ec0cebd5ea6676de235d3a62a8", "git_parents": ["e2ed8b0e66de0d21c356b2c2c842922d5c41238a"], "node": "f7e18bbf4aa3872b085ecb1bf5230dc79802f832", "parents": ["8815c87a4a566d3bfbf08036e55181a688d96391"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060565 - Part 1: Support pasteNoFormatting command on TextEditor; r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320857\n", "files": ["editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "editor/libeditor/EditorCommands.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLEditorDataTransfer.cpp", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_paste_command_data.html"], "git_node": "13e12dae1e0fb496d2d09c9c4be418e008e1afd6", "git_parents": ["5fe7c5421afd73ec0cebd5ea6676de235d3a62a8"], "node": "85d7e0d2c3e27c1f1c2f51be441e33517c4d81e4", "parents": ["f7e18bbf4aa3872b085ecb1bf5230dc79802f832"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060565 - Part 2: Allow access to or lazy fetching of raw data if the message type is ePasteNoFormatting in DataTransfer; r=masayuki\n\nThe `dataTransfer` of the `beforeinput` event for the pasteNoFormatting\ncommand is cloned from the one created for the paste event without remapping\nthe type to `ePaste`. We should also allow it to access the cloned raw data or\nlazily fetch the clipboard data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321810\n", "files": ["dom/events/DataTransferItem.cpp", "editor/libeditor/tests/test_paste_command_data.html"], "git_node": "7964438068db72ae45ceec382a87f52123019004", "git_parents": ["13e12dae1e0fb496d2d09c9c4be418e008e1afd6"], "node": "d7d2d425afc65a1a1c7ec5fa58c26db915442577", "parents": ["85d7e0d2c3e27c1f1c2f51be441e33517c4d81e4"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060565 - Part 3: Make Accel+Shift+V shortcut trigger cmd_pasteNoFormatting on \u003cinput\u003e and \u003ctextarea\u003e elements; r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321059\n", "files": ["dom/events/ShortcutKeyDefinitions.cpp", "dom/events/test/gtest/TestShortcutKeyDefinitions.cpp", "editor/libeditor/tests/test_paste_no_formatting.html", "testing/web-platform/tests/editing/other/paste-as-plaintext-data.tentative.https.html"], "git_node": "2c77e2e8f7575f2ae38cbfa5ea006c372197ddf8", "git_parents": ["7964438068db72ae45ceec382a87f52123019004"], "node": "391f5851825523c951a0ab2ddbf0e07eb4ef63af", "parents": ["d7d2d425afc65a1a1c7ec5fa58c26db915442577"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/PreviewThemeProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/theme/Theme.kt", "taskcluster/kinds/static-analysis-autotest/kind.yml", "testing/web-platform/meta/css/css-transforms/backface-visibility-hidden-004.html.ini", "testing/web-platform/meta/css/css-transforms/transform3d-backface-visibility-006.html.ini", "testing/web-platform/meta/css/css-values/typed_arithmetic.html.ini", "third_party/libwebrtc/moz-patch-stack/s0145.patch", "toolkit/components/telemetry/docs/data/third-party-modules-ping.md", "toolkit/themes/shared/design-system/config/figma-tokens-config.js", "toolkit/themes/shared/design-system/config/override-identifiers.js", "toolkit/themes/shared/design-system/config/tokens-config.js", "toolkit/themes/shared/design-system/src/tokens/base/dimension.tokens.json", "toolk