10n-changesets.json"], "git_node": "1271aa8c993c3c2597093790314bd6f34a267666", "git_parents": ["ae5658e84dea07be749e082c67abbc5a0d57fee1"], "node": "1d7dda3aab10b84cfae86ff59a693d22adfca446", "parents": ["5e9567debb9301343f63e3df33d3396cf5263590"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 1: Plumb nurseryOwned parameter through buffer allocator APIs r=sfink\n\nThis is just plumbing. The parameter will be used by future patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320979\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/jsapi-tests/testGCAllocator.cpp"], "git_node": "98bc8d415e3ba177cf04ad13e9fd4570cc9a5be1", "git_parents": ["1271aa8c993c3c2597093790314bd6f34a267666"], "node": "c969bc9b6af58fc2c9b1ebdecab4dc9c9891ccc8", "parents": ["1d7dda3aab10b84cfae86ff59a693d22adfca446"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 2: Add FreeLists predicates for whether they contain free regions in the spcified range r=sfink\n\nSmall refactoring to make assertions less verbose.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320980\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h"], "git_node": "f81e7dab38d6dfc76715da1d463264d262a3e9b4", "git_parents": ["98bc8d415e3ba177cf04ad13e9fd4570cc9a5be1"], "node": "f7b90a2710971e0477c264690fcde60152e278b5", "parents": ["c969bc9b6af58fc2c9b1ebdecab4dc9c9891ccc8"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 3: Add a total BufferChunk count r=sfink\n\nThis is used for a heuristic in the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320981\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h"], "git_node": "8fd3ce1ca94d556c6069aa7678711f8bcd5799ee", "git_parents": ["f81e7dab38d6dfc76715da1d463264d262a3e9b4"], "node": "c50bab3ac6790192bd15b6eae923b0a2d33d666f", "parents": ["f7b90a2710971e0477c264690fcde60152e278b5"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 4: Partition buffer allocator free lists by chunk kind r=sfink\n\nThe adds separate free lists for mixed / tenured chunks and uses them based on\nwhether the allocation is nursery or tenured owned.\n\nWe don't want to do this all the time. For small heaps we want to share chunks\nbetween nursery and tenured owned allocations. And to prevent reducing the heap\ndensity too much we probably don't want to allocate branch new chunks for both\ntenured and nursery owned allocations (although I'm less sure on this). Mainly\nwe want to do this when allocating into previously swept partially used chunks.\n\nThis is implemented by the flag |allocTenuredInMixedChunks|. This is set to\ntrue for small heaps (currently \u003c= 4 MB) and when we run out of available\nchunks and start allocating new ones.\n\nThis simplifies BufferAllocator::startMinorSweeping and removes scanning the\nfree lists. This also lets us skip moving tenured free lists to their chunk\nheader on minor GC which was there so that scanning free lists didn't take too\nlong.\n\nWe also now set the chunk's |hasNurseryOwnedAllocs| flag in useAvailableChunk\nso we don't need to change it later any more. Changing it would now involve\nmore work as we would have to move all its free regions from |tenuredFreeLists|\nto |mixedFreeLists| which is possible but inconvenient.\n\nThis all means that we'll allocate more memory rather than allocating a nursery\nowned allocation into a chunk we're currently using for tenured allocations.\nThis doesn't show much increase in max heap size in testing so this is probably\nfine, and we can come back later and change this if it becomes a problem.\n\nreview comments\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320982\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h"], "git_node": "e3119b83c16ca511c432cde7f6ed2d8d6ee72a2b", "git_parents": ["8fd3ce1ca94d556c6069aa7678711f8bcd5799ee"], "node": "faf6c319a8f6b1f7f4b80139057567fc235526fd", "parents": ["c50bab3ac6790192bd15b6eae923b0a2d33d666f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 5: Refactor to move some methods to the relevant class r=sfink\n\nThis doesn't change any behaviour it just reorganises the following:\n - Make BufferAllocator::makeFreeRegion into FreeRegion::create\n - Make BufferAllocator::pushFreeRegionFront/Back into FreeLists::pushFront/back\n - Remove unnecessary BufferAllocator* parameter to sweep metonds\n - Move BufferAllocator::addSweptRegion methods to BufferChunk and SmallBufferRegion\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321310\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/BufferAllocatorInternals.h"], "git_node": "4a0d9dfe68e0046b321e1eb058d2ae9563181c73", "git_parents": ["e3119b83c16ca511c432cde7f6ed2d8d6ee72a2b"], "node": "1cbdbb427e1833653004e183fe3515a97702657e", "parents": ["faf6c319a8f6b1f7f4b80139057567fc235526fd"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066149 - Part 6: Rebuild free lists for swept chunks on demand r=sfink\n\nRather than moving free regions in tenured chunks back to the chunk header on\nmajor GC, just clear them and rebuild if necessary. The only time we need them\nis if we abort collection as they are rebuilt when we sweep.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321311\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/BufferAllocatorInternals.h"], "git_node": "230e079a1f7d111b3a2bfb4faedc4f1d14524f6e", "git_p