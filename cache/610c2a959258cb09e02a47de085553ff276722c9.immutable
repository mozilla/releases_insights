grato,fluent-reviewers,desktop-theme-reviewers,sfoster,bolsson\" for causing bc and TV tests failures at browser_aiwindow_monitor_button.js\n\nThis reverts commit 87c7e4fb9fe62e8c6955a35ccf5ed8a5c0020c2d.\n", "files": ["browser/base/content/browser.js", "browser/components/aiwindow/ui/assets/agent-watch-empty.svg", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.css", "browser/components/aiwindow/ui/components/agent-monitor-panel/agent-monitor-panel.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/monitors-display/monitor-status-chip.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorPanel.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/smartwindowMonitor.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "dd9114eba49859bf3d6aa5c63a3dbde52c94b22f", "git_parents": ["94dc188f9c710aa025ee35f51031253896182e23"], "node": "b58ea51197140e05494bd6e599ca1b1577a8ce64", "parents": ["9c50d8bd94bf83160c608dbf2edb2c3e798692d5"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge Mozilla-central to autoland\n", "files": ["testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssMatrixComponent.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-2d-flattening.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-toMatrix.html.ini"], "git_node": "49def41cd2cf24283feb0ba98f85ef1e1af0eaa1", "git_parents": ["dd9114eba49859bf3d6aa5c63a3dbde52c94b22f", "8db09b47689dcfc25671b178619b03ad214c6369"], "node": "b5022f35d2a427aa688d7133b55775689072f876", "parents": ["b58ea51197140e05494bd6e599ca1b1577a8ce64", "920a52be5d43046ea3df130dea626f8ba9a04e97"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2037111 - Rename tab tokens for naming consistency r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,tgiles,kcochrane\" for causing bc test failures at /browser_resize_sidebar.js\n\nThis reverts commit 5240fbbc45bc0c4abccc2c331c8e42167ea3dd26.\n", "files": ["browser/components/sidebar/sidebar-main.css", "browser/themes/ThemeVariableMap.sys.mjs", "browser/themes/shared/tabbrowser/tab.nova.tokens.json", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/tabbrowser/tabs.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/figma-import.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/config.mjs"], "git_node": "714b247775cf2ed626d6a3237614512b327d1808", "git_parents": ["49def41cd2cf24283feb0ba98f85ef1e1af0eaa1"], "node": "0cd0c347fad21926ef623b2710fdf30cb3e7b23b", "parents": ["b5022f35d2a427aa688d7133b55775689072f876"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 8 of 11: Make WebRender render passes explicit in the Device API r=gfx-reviewers,nical\n\nAdd Device::begin_render_pass(RenderPassDescriptor) and\nDevice::end_render_pass(StoreOp), and route every place the renderer bound\na draw target through them: color and alpha render targets, picture cache\ntiles, the main framebuffer composite, external native surfaces, texture\ncache copies, staging upload copies, debug clears and the debug overlay.\nbind_draw_target becomes private to the device.\n\nThe descriptor carries the target, an optional render area, and a color\nLoadOp of Load or DontCare. In GL, begin binds the target and, on Adreno,\nstarts QCOM tiled rendering over the render area with the preserve mask\nderived from the load op; end invalidates the depth attachment when the\nStoreOp is Discard and ends tiling. This moves the QCOM extension calls\nand the depth invalidates out of the renderer.\n\nBlits into another target from inside a pass (the backdrop readback for\nmix-blend-mode) are handled by the device, which restores the pass target\nafterwards, so the renderer no longer rebinds by hand. Debug builds assert\nthat draws and clears only happen inside a pass, and that no pass is open\nat end of frame.\n\nPass-start clears stay as explicit clear_target calls rather than a\nLoadOp::Clear, because the GL clear-scissor heuristics (enable_clear_scissor,\nprefers_clear_scissor, requires_alpha_target_full_clear and the precise\nclears of cached targets) do not coincide with the render area. Folding\nthem in is a follow-up once those heuristics move into the GL device.\n\nGL calls are unchanged except that glEndTilingQCOM is no longer issued for\na target whose used rect was unknown and so never started tiling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324137\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/upload.rs"], "git_node": "820c34a0605491bd791e56c216b06ada1ff5a0c1", "git_parents": ["714b247775cf2ed626d6a3237614512b327d1808"], "node": "ba6c06bade6099bab0b314ee394dec94729f3ddb", "parents": ["0cd0c347fad21926ef623b2710fdf30cb3e7b23b"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 9 of 11: Replace raw GL ids in the WebRender embedder API with opaque handles r=gfx-reviewers,nical\n\nTextures and compositor surfaces provided by the embedder were identified\nby GL names typed as u32. Introduce two repr(C) newtypes over u64 whose\nmeaning is defined by the backend the renderer runs on:\n\n- webrender_api::ExternalTextureHandle, carried by\n  ExternalImageSource::NativeTexture and by ExternalTexture inside the\n  device. The Gecko WrExternalImage struct and its\n  NativeTextureToWrExternalImage helper widen the handle to 64 bits, and\n  wrench and the yuv example wrap the GL names they create.\n\n- NativeSurfaceHandle, replacing NativeSurfaceInfo::fbo_id, with a DEFAULT\n  value for compositors that bind the surface as the default target. The\n  wr_compositor_bind FFI and RenderCompositor::Bind take a uint64_t out\n  parameter; the SWGL compositor and Gecko implementations are updated.\n\nDrawTarget loses its raw texture id and target fields, and the unused\nExternal draw and read target variants are removed. The scratch\nframebuffer the renderer kept for reading back textures during capture and\ndebugging moves into the device: attach_read_texture binds it on demand\nand Device::deinit releases it, so create_fbo, delete_fbo and\nbind_read_target_impl become private.\n\nrenderer/mod.rs no longer references gleam and drops off the gl_leaks\nallowlist. The Windows and macOS compositor implementations are renamed\nconsistently but were only compile-checked on Linux.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324138\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/DCLayerTree.h", "gfx/webrender_bindings/RenderCompositor.cpp", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderCompositorANGLE.h", "gfx/webrender_bindings/RenderCompositorLayersSWGL.cpp", "gfx/webrender_bindings/RenderCompositorLayersSWGL.h", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.h", "gfx/webrender_bindings/WebRenderTypes.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/examples/yuv.rs", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/compositor/sw_compositor.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/external_image.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/tests/gl_leaks.rs", "gfx/wr/webrender_api/src/image.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "c4cf2127cd54a681d1cb3d6df9210b77446c0d5f", "git_parents": ["820c34a0605491bd791e56c216b06ada1ff5a0c1"], "node": "1f12ddee90442667271954e0d6f8c54b17d45801", "parents": ["ba6c06bade6099bab0b314ee394dec94729f3ddb"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 10 of 11: Remove the last GL accessors from the WebRender embedder surface r=gfx-reviewers,nical\n\nwrench created the GL textures for yaml external images through\nDevice::gl and the device's GL format table. It now uses the GL context it\nalready owns, with its own small format and target tables, so Device::gl,\ngl_describe_format and get_gl_target become private to the device and\nFormatDesc is no longer exported.\n\nThe Compositor and MappableCompositor traits passed &mut Device into every\nmethod, but no implementation used it: the Gecko and SWGL compositors only\nforwarded it. Drop the parameter from the traits, the implementations and\nthe renderer call sites, and from the debug overlay helpers and\ncomposite_native which only carried it through. No behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324139\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/compositor/sw_compositor.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/wrench/src/wrench.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "fffaad0c2b590f6fd0066c5698b440c0ec59f47f", "git_parents": ["c4cf2127cd54a681d1cb3d6df9210b77446c0d5f"], "node": "70d2ce9a3f8d9b03d5d5604eafde2bcbce3a3f0e", "parents": ["1f12ddee90442667271954e0d6f8c54b17d45801"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2069782 - Part 11 of 11: Rename PBO types, add DeviceOptions and tag program cache digests by API r=gfx-reviewers,nical\n\nRename the pixel buffer object names in the WebRender device API to\nAPI-neutral transfer buffer terms: PBO becomes TransferBuffer, BoundPBO\nbecomes MappedTransferBuffer, UploadPBOPool becomes UploadBufferPool, and\nthe create, map, read back, delete and stride methods follow. The renderer\nfield and the upload_buffer_default_size option are renamed to match.\n\nReplace the twelve positional arguments of Device::new with a DeviceOptions\nstruct, so that the two call sites in the renderer and the Gecko bindings\nname each setting.\n\nMake ProgramBinary::format a plain u32, which is what the serialized disk\ncache already stores, and mix an API tag into the program source digest so\nthat cached binaries from a future backend cannot be mistaken for GL\nprogram binaries. The tag changes every digest once, so existing shader\ndisk caches are rebuilt on first run, as they are after any shader change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324140\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/upload.rs", "gfx/wr/webrender/src/renderer/vertex.rs", "gfx/wr/webrender/src/screen_capture.rs"], "git_node": "da9d514d8e4599429aa913dc246064a530953b88", "git_parents": ["fffaad0c2b590f6fd0066c5698b440c0ec59f47f"], "node": "645a0f2aeb383793f5a4e36fc36ff05db916c64b", "parents": ["70d2ce9a3f8d9b03d5d5604eafde2bcbce3a3f0e"], "tags": []}], "date": 1789015338, "git_changesets": ["1e7525bb741410ca750befafd4af820b90561f1f", "8c2245fa4a4bd72d7bb5259701af6654f6a3c4f8", "f16e730a7e8c63ad2fdf957179af987700ba69f1", "f236a0424afc891d5bb27dd31f58e4b7686093d6", "0ea3bb6c3d88eb1fdfbc3c80fc08672f50e7f582", "f46e64f8f6353f1091917d636237fabbfd89448e", "88ab304cdd21dc27822b3e8da4e775ea92e00e51", "e01339c1c48419b689873b1f858954d942bb78e5", "a2381a507d99238d907e9123162a0df04b6e3167", "21ec718ad5fe490f11ab0a8877d1969164805177", "8fb310698becbecce3af3cf6727dd1f6e4c90771", "5a96a6d6ebb276078e452585260a9c4fd451536b", "bd855b9924dc8c016e086f5a078cffd277e6b11e", "251047fa2f65df2120524a1ce014a13a3121961e", "d15ed33983a43fdb16cac449b568640afefeedd9", "ea1c209dd6c4d226ca64f5bec93f5617426e6558", "7efed1acd44d476b83b2d09fc04af6fb07c216ce", "7a2b12bf2d4b2ba876f7c9fa29f39afb207eff64", "60287d767958a7358a8cfaedb884bde3dc4bcd2a", "0da8c8f05d610149846267f8753f480c38e77c02", "cf6bfa4ef203ef77c27