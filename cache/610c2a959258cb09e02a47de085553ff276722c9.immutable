 "eebdd9a10d99db30d3d3d196839a5e0a08348eeb", "parents": ["304550d4071f4e048f89e72aedc1d4a053ec347d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2067202 - Add test for cancelling SW connection when going offline r=dom-worker-reviewers,edenchuang\n\nI think the test was supposed to be added in D198374.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323660\n", "files": ["dom/tests/mochitest/fetch/frame_offline_cancel.html", "dom/tests/mochitest/fetch/mochitest.toml", "dom/tests/mochitest/fetch/stall.sjs", "dom/tests/mochitest/fetch/test_offline_cancel_inflight_fetch.html", "dom/tests/mochitest/fetch/worker_offline_cancel.js"], "git_node": "7db761105475385325d4923a5dd5bcd6c6275009", "git_parents": ["2434eb667b91675f63d9ca8f03326be9327b1a6e"], "node": "11b39603d86ccf5984c95a3b3b65c8c88ec7d4da", "parents": ["eebdd9a10d99db30d3d3d196839a5e0a08348eeb"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2067063: Record data about other profiles as part of the new-profile ping. r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322905\n", "files": ["toolkit/profile/ProfileComponents.manifest", "toolkit/profile/ProfileMetrics.sys.mjs", "toolkit/profile/metrics.yaml", "toolkit/profile/moz.build", "toolkit/profile/nsToolkitProfileService.cpp", "toolkit/profile/nsToolkitProfileService.h", "toolkit/profile/test/xpcshell/test_new_profile_ping_sent.js", "toolkit/profile/test/xpcshell/test_new_profile_ping_skipped.js", "toolkit/profile/test/xpcshell/test_profile_metrics.js", "toolkit/profile/test/xpcshell/test_profile_metrics_after_submission.js", "toolkit/profile/test/xpcshell/test_profile_metrics_excludes_current.js", "toolkit/profile/test/xpcshell/test_profile_metrics_no_compat.js", "toolkit/profile/test/xpcshell/test_profile_metrics_no_prefs.js", "toolkit/profile/test/xpcshell/test_profile_metrics_other_install.js", "toolkit/profile/test/xpcshell/test_profile_metrics_store_id_match.js", "toolkit/profile/test/xpcshell/test_profile_metrics_store_id_mismatch.js", "toolkit/profile/test/xpcshell/xpcshell.toml"], "git_node": "9316ca1456bd40a83805b253591dc97c6de36ff7", "git_parents": ["7db761105475385325d4923a5dd5bcd6c6275009"], "node": "3961c6f5febe9194b2f84fc83e38c3504f8b1b78", "parents": ["11b39603d86ccf5984c95a3b3b65c8c88ec7d4da"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068066 - Return null from *List.item() in Web Speech when the index is out of range. r=media-playback-reviewers,webidl,smaug,alwu\n\nitem() indexed straight into the array, so an out-of-range index crashed.\nBlink's item() returns nullptr there and its bindings hand that to JS as\nnull, so make the WebIDL return type nullable and do the same.\n\nhttps://github.com/WebAudio/web-speech-api/pull/212 aligns the spec.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324284\n", "files": ["dom/media/webspeech/recognition/SpeechGrammarList.cpp", "dom/media/webspeech/recognition/SpeechGrammarList.h", "dom/media/webspeech/recognition/SpeechRecognitionResult.cpp", "dom/media/webspeech/recognition/SpeechRecognitionResultList.cpp", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_result_item_out_of_range.html", "dom/webidl/SpeechGrammarList.webidl", "dom/webidl/SpeechRecognitionResult.webidl", "dom/webidl/SpeechRecognitionResultList.webidl", "testing/web-platform/tests/speech-api/SpeechGrammarList-item.https.html"], "git_node": "15e65f9002f4193a1eff321726ff8983d413f829", "git_parents": ["9316ca1456bd40a83805b253591dc97c6de36ff7"], "node": "7345f092b989ee703ac09898eb0ae04ee434a111", "parents": ["3961c6f5febe9194b2f84fc83e38c3504f8b1b78"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2068670 - Run selected wasm tests also with --setpref=wasm_baseline_debug=true.  r=bvisness.\n\nOngoing stackmap-for-debug-traps work needs to be able to generate all possible\ndebug traps so as to verify that they have stackmaps.  Running all wasm\njit-tests with the extra flag --setpref=wasm_baseline_debug=true works, but is\nexcessively expensive and also not necessary.\n\nInstead, a set of 20 tests have been picked, to provide (hopefully) equivalent\ncoverage. This has a negligable effect (more or less zero) on the run time of\nthe wasm jit-tests.\n\nThe set was derived by running an instrumented js shell on all wasm jit-tests.\nFor each call into MacroAssembler::verifyAndAdd (where new traps are\nannounced), a 6-element stack trace was obtained.\n\nFor each test, all such stack traces were collected into a set; this basically\ngives the set of creation points for traps for each test.\n\nThen, a greedy algorithm was used to select the minimum set of tests needed to\ncover each discovered allocation point at least once. This produced a set of\njust 20 tests.\n\nThe patch adds --setpref=wasm_baseline_debug=true as a run-configuration to\nthose 20 tests.\n\nAdditionally, it was discovered that stack overflows are handled around a\nthousand times more slowly with --setpref=wasm_baseline_debug=true, for as-yet\nunknown reasons. See bug 2068514. This made wasm/basic.js and wasm/errors.js\ntake a long time. For this reason, the stack overflow cases in those two files\nhas been disabled in the case where --setpref=wasm_baseline_debug=true is set.\n\nNote, this limited test set is an interim solution. Going forwards, it does\nnot provide coverage for new trap-creation sites in the compilers. We really\nshould plan to run new tests with --setpref=wasm_baseline_debug=true by\ndefault.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323200\n", "files": ["js/src/jit-test/tests/wasm/atomic.js", "js/src/jit-test/tests/wasm/basic.js", "js/src/jit-test/tests/wasm/builtin-modules/bug2019813.js", "js/src/jit-test/tests/wasm/custom-page-sizes/runtime.js", "js/src/jit-test/tests/wasm/errors.js", "js/src/jit-test/tests/wasm/exnref/try-table.js", "js/src/jit-test/tests/wasm/gc/arrays.js", "js/src/jit-test/tests/wasm/gc/cast-abstract.js", "js/src/jit-test/tests/wasm/gc/ref-gvn.js", "js/src/jit-test/tests/wasm/gc/signal-null-check.js", "js/src/jit-test/tests/wasm/gc/structs.js", "js/src/jit-test/tests/wasm/gc/structs2.js", "js/src/jit-test/tests/wasm/integer.js", "js/src/jit-test/tests/wasm/js-promise-integration/suspending-canonical-type.js", "js/src/jit-test/tests/wasm/large-memory-atomics-index-zero-extended.js", "js/src/jit-test/tests/wasm/memory-partial-oob-store.js", "js/src/jit-test/tests/wasm/memory64/basic.js", "js/src/jit-test/tests/wasm/regress/bug1684861.js", "js/src/jit-test/tests/wasm/simd/ad-hack-extra.js", "js/src/jit-test/tests/wasm/timeout/stack-overflow.js"], "git_node": "7f707be77c8758aa3254980a73901cff1d91a90e", "git_parents": ["15e65f9002f4193a1eff321726ff8983d413f829"], "node": "b0df6e884011fbb7f901c8a584d43d3dcdd8cd2a", "parents": ["7345f092b989ee703ac09898eb0ae04ee434a111"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069324 - Implement SpeechRecognition.continuous. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323665\n", "files": ["dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_parakeet_continuous.html"], "git_node": "2914b6eeb23159c3be9e9276b3b5ba35c83050aa", "git_parents": ["7f707be77c8758aa3254980a73901cff1d91a90e"], "node": "f936af4bf2bc113294ebda9b315108b626f57294", "parents": ["b0df6e884011fbb7f901c8a584d43d3dcdd8cd2a"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 1943614 - Enable using ML-KEM in WebCrypto r=webidl,smaug,crypto-reviewers,jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314864\n", "files": ["dom/base/SubtleCrypto.cpp", "dom/base/SubtleCrypto.h", "dom/crypto/CryptoKey.cpp", "dom/crypto/CryptoKey.h", "dom/crypto/KeyAlgorithmProxy.cpp", "dom/crypto/KeyAlgorithmProxy.h", "dom/crypto/WebCryptoCommon.h", "dom/crypto/WebCryptoTask.cpp", "dom/crypto/WebCryptoTask.h", "dom/crypto/test/mochitest.toml", "dom/crypto/test/test-vectors.js", "dom/crypto/test/test_WebCrypto_MLKEM.html", "dom/webidl/SubtleCrypto.webidl", "modules/libpref/init/StaticPrefList.yaml", "security/nss.symbols", "testing/web-platform/meta/WebCryptoAPI/__dir__.ini", "testing/web-platform/meta/WebCryptoAPI/encap_decap/encap_decap_bits.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/encap_decap/encap_decap_keys.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_AES-OCB.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_Ed448.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_ML-DSA.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_ML-KEM.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_X448.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_chacha20_poly1305.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/failures_kmac.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/generateKey/successes_ML-KEM.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/idlharness.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/import_export/ML-KEM_importKey.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/import_export/okp_importKey_failures_Ed448.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/import_export/okp_importKey_failures_X448.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/serialization/mlkem.tentative.https.any.js.ini"], "git_node": "5016c09816783c7369e6f5f9a22e1fe108f61a46", "git_parents": ["2914b6eeb23159c3be9e9276b3b5ba35c83050aa"], "node": "67a6346353f7679d5fb3049f8183d76c947f1ecb", "parents": ["f936af4bf2bc113294ebda9b315108b626f57294"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070420 - Set test as intermittent. r=smolnar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324589\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-appearance-active.html.ini"], "git_node": "b257b556c6d2398b84ace2f1518457f6aaa24377", "git_parents": ["5016c09816783c7369e6f5f9a22e1fe108f61a46"], "node": "872c98e589cf5d9437119790d6e4a2bbdda35b0e", "parents": ["67a6346353f7679d5fb3049f8183d76c947f1ecb"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070159 - Compare all login fields before resolving a stored login in the Rust storage backend. r=dimi\n\nfindLoginToUpdate() has dedupe semantics: it matches on origin and username\nonly, ignoring the password, and falls back to an entry with an empty username.\nremoveLoginAsync(), modifyLoginAsync() and recordPasswordUseAsync() used it to\nresolve a login that callers pass by value, so they could act on a record that\ndiffers from the one the caller described.\n\nThe JSON backend resolves the same lookup with nsILoginInfo.equals() in\n_getIdForLogin(), which compares every field. Mirror that in the Rust backend\nwith a #findStoredLogin() helper shared by the three callers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324285\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_logins_change.js"], "git_node": "c33da4381f565264c1615758d61fd908ecbc9c4d", "git_parents": ["b257b556c6d2398b84ace2f1518457f6aaa24377"], "node": "d95a9394688c4193599b3b14e3f498d85c959082", "parents": ["872c98e589cf5d9437119790d6e4a2bbdda35b0e"], "tags": []}, {"author": "Foofrix \u003cfoofrix@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056433: Update perfetto to v58. r=canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324366\n", "files": ["third_party/perfetto/moz.yaml", "third_party/perfetto/sdk/perfetto.cc", "third_party/perfetto/sdk/perfetto.h"], "git_node": "a70c6e573fe594a5002e4f1221c79791a960f72b", "git_parents": ["c33da4381f565264c1615758d61fd908ecbc9c4d"], "node": "2aca2d173dad97e3824cf09c4651bc9582fca323", "parents": ["d95a9394688c4193599b3b14e3f498d85c959082"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068480 - [devtools] Fix attr() tooltip content for inherited rules. r=devtools-reviewers,bomsy.\n\nFor inherited rules, we need to get the node front on which the rule applies to, not the selected\nnode in the markup view.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324261\n", "files": ["devtools/client/inspector/rules/test/browser_rules_attr.js", "devtools/client/inspector/rules/views/text-property-editor.js"], "git_node": "5623c1ac068a9b4eff7528f1209b2ef5719eec15", "git_parents": ["a70c6e573fe594a5002e4f1221c79791a960f72b"], "node": "28e9ccd891495524207385a100d3038b9ac1876c", "parents": ["2aca2d173dad97e3824cf09c4651bc9582fca323"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068479 - [devtools] Don't check for type mismatch in attr() when attribute value uses substitution functions. r=devtools-reviewers,bomsy.\n\nThis is just a quick fix to avoid false negative type mismatch\nwhen the attribute value uses var()/attr()/env().\nThis also mean we won't properly flag when the fallback value\nis being used, in case the attribute substituted value\ndoesn't match the expected syntax, but I guess it's less likely\nto happen.\nA proper fix will be done in Bug 2070443.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324549\n", "files": ["devtools/client/inspector/rules/test/browser_rules_attr.js", "devtools/client/shared/output-parser.js"], "git_node": "a006eddcd784ca90770b1dc594d43f361123422a", "git_parents": ["5623c1ac068a9b4eff7528f1209b2ef5719eec15"], "node": "ecdda0a77ad8e5a2fd54d5be3f5bdd28cfbaf52d", "parents": ["28e9ccd891495524207385a100d3038b9ac1876c"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068648 - Remove unneeded nsILoadInfo flag. r=dom-core-reviewers,necko-reviewers,valentin,smaug,ipc-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323977\n", "files": ["dom/fetch/FetchDriver.cpp", "ipc/glue/BackgroundUtils.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/nsILoadInfo.idl", "netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "cddc7ce5d382204bb6cc75788182b2fdc0bf784b", "git_parents": ["a006eddcd784ca90770b1dc594d43f361123422a"], "node": "0670857d5c6a184ea5d182758d25656726f354fa", "parents": ["ecdda0a77ad8e5a2fd54d5be3f5bdd28cfbaf52d"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066354 - Don't crash for illegal loads in release builds. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324568\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellLoadState.h"], "git_node": "a6e7f9741144f2bf58f53e22ac0ca94c24d21bb2", "git_parents": ["cddc7ce5d382204bb6cc75788182b2fdc0bf784b"], "node": "78931f39c70fd4ff1d833e6e1992490109cde4ff", "parents": ["0670857d5c6a184ea5d182758d25656726f354fa"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069324 - Implement SpeechRecognition.continuous. r=media-playback-reviewers,alwu\" for causing linux mochitest failures on test_parakeet_continuous.html.\n\nThis reverts commit 2914b6eeb23159c3be9e9276b3b5ba35c83050aa.\n", "files": ["dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_parakeet_continuous.html"], "git_node": "378cc7bac4d1c5cc7f0e6ea224838a39fe336c51", "git_parents": ["a6e7f9741144f2bf58f53e22ac0ca94c24d21bb2"], "node": "a5e0830276c06b70877fb25acaf62f8ae48eb384", "parents": ["78931f39c70fd4ff1d833e6e1992490109cde4ff"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068066 - Disable SpeechGrammarList-item.https.html on Android.\n\nSpeechGrammarList is not built there, so the test can only fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324595\n", "files": ["testing/web-platform/meta/speech-api/SpeechGrammarList-item.https.html.ini"], "git_node": "3c4c7764886e2e3a7a4fe7bc0be426073839549b", "git_parents": ["378cc7bac4d1c5cc7f0e6ea224838a39fe336c51"], "node": "ad7d6c889447ee5bda9588172bb0f50e03de8fe2", "parents": ["a5e0830276c06b70877fb25acaf62f8ae48eb384"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067202 - Add test for cancelling SW connection when going offline r=dom-worker-reviewers,edenchuang\" for causing mochitest failures @ test_offline_cancel_inflight_fetch.html\n\nThis reverts commit 7db761105475385325d4923a5dd5bcd6c6275009.\n\nRevert \"Bug 2067202 - Let a controlled client's fetch reach the service worker while offline. r=dom-worker-reviewers,edenchuang\"\n\nThis reverts commit 2434eb667b91675f63d9ca8f03326be9327b1a6e.\n\nRevert \"Bug 2067202 - test offline sw bug r=dom-worker-reviewers,edenchuang\"\n\nThis reverts commit ab3fff1af47905a4deb97dc7b80b9925b47a209d.\n", "files": ["dom/fetch/FetchService.cpp", "dom/fetch/FetchService.h", "dom/serviceworkers/test/mochitest-common.toml", "dom/serviceworkers/test/offline_worker_fetch/frame.html", "dom/serviceworkers/test/offline_worker_fetch/sw.js", "dom/serviceworkers/test/offline_worker_fetch/worker.js", "dom/serviceworkers/test/test_offline_worker_fetch.html", "dom/tests/mochitest/fetch/frame_offline_cancel.html", "dom/tests/mochitest/fetch/mochitest.toml", "dom/tests/mochitest/fetch/stall.sjs", "dom/tests/mochitest/fetch/test_offline_cancel_inflight_fetch.html", "dom/tests/mochitest/fetch/worker_offline_cancel.js"], "git_node": "0e02abbc81a9a76295219ab86ecf004794a4bf86", "git_parents": ["3c4c7764886e2e3a7a4fe7bc0be426073839549b"], "node": "9ed919897826a25e440a35f7638436567a579f20", "parents": ["ad7d6c889447ee5bda9588172bb0f50e03de8fe2"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070159 - Compare all login fields before resolving a stored login in the Rust storage backend. r=dimi\" for causing mochitest failures @ browser_glean_pwmgr_form_autofill_result & browser_protections_lockwise\n\nThis reverts commit c33da4381f565264c1615758d61fd908ecbc9c4d.\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_logins_change.js"], "git_node": "b589f3b1605da640e27657bbfa1b60140aec9b0a", "git_parents": ["0e02abbc81a9a76295219ab86ecf004794a4bf86"], "node": "ab25845e889a977627f787ca98f75c9e5500b746", "parents": ["9ed919897826a25e440a35f7638436567a579f20"], "tags": []}, {"author": "Artur Iunusov \u003caiunusov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059222 - Reject embedded NULs in SimpleDB database names r=dom-storage-reviewers,hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318261\n", "files": ["dom/simpledb/ActorsParent.cpp"], "git_node": "2452225f5a023dd81aa85f3af1b4eddc61ca14e0", "git_parents": ["b589f3b1605da640e27657bbfa1b60140aec9b0a"], "node": "eb595f52fd34f5dc80c1a748b9d584586e952aca", "parents": ["ab25845e889a977627f787ca98f75c9e5500b746"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1632517 - Validate every download in periodic_file_updates.sh before using it. r=releng-reviewers,jcristau\n\nThe compare_* functions are invoked as `if compare_foo`, and bash disables `set -e` for the entire body of\na function called in an `if` condition. A failed wget in those functions therefore never aborted the run:\n`wget -O` leaves a zero-byte file behind on an HTTP error, and the subsequent diff against the in-tree copy\nproduced a patch deleting the whole file. That is how D72155 came to remove effective_tld_names.dat, and\nthe suffix list and mobile experiments paths were still exposed to it. The remote settings path had a\nrelated hole, since `wget | jq \u003e file` without pipefail turns a failed fetch into an empty dump.\n\nRoute all downloads through a fetch_file helper that checks the wget exit status, rejects empty responses,\nand optionally requires a known marker to catch truncation. download_file wraps it and exits, so it works\nregardless of how the caller is invoked; download_json additionally validates the result as JSON. The ad\nhoc HSTS existence check is subsumed by the helper.\n\nRemote settings attachments are the one exception. A failed icon or bloomfilter download is not worth\nfailing the whole job over, since the task runs several times a week and will pick the file up next time.\nThose are downloaded to a temporary file first and only moved into place, together with their metadata,\nonce validated, so a failure leaves the in-tree copy untouched. The search-config-icons loop runs in a\npipeline subshell, so its exit status is now propagated explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324502\n", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": "d5cc6447aea818ebfc6217ad2fb3e5dfebba99b2", "git_parents": ["2452225f5a023dd81aa85f3af1b4eddc61ca14e0"], "node": "bdc165e072bd7ca15e7b2942a530cbceb704d904", "parents": ["eb595f52fd34f5dc80c1a748b9d584586e952aca"], "tags": []}, {"author": "Kyrylo Arshuk-Popov \u003csevenwithawp@gmail.com\u003e", "branch": "default", "desc": "Bug 2064575 - Handle non-existent lines in \"Go to line\". r=bomsy,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323049\n", "files": ["devtools/client/debugger/src/components/QuickOpenModal.js", "devtools/client/debugger/test/mochitest/browser_dbg-go-to-line.js"], "git_node": "4e28f3849ce8cac92a7f4b38586c3606c23ca7af", "git_parents": ["d5cc6447aea818ebfc6217ad2fb3e5dfebba99b2"], "node": "66ec91d11fd0e915f4bce7d9b2c45655ab512593", "parents": ["bdc165e072bd7ca15e7b2942a530cbceb704d904"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067914 - Share panel devices subview should match main view width. r=nbarrett,jprickett,desktop-theme-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322422\n", "files": ["browser/themes/shared/sharePanel.css"], "git_node": "6f63d1a64a286c937711fc160c3efffd55c8eabe", "git_parents": ["4e28f3849ce8cac92a7f4b38586c3606c23ca7af"], "node": "a9baa834a19657135a569e8a71c5ccda3db3a76d", "parents": ["66ec91d11fd0e915f4bce7d9b2c45655ab512593"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065025 - Give FaviconLoader's icon DeferredTask a bounded idle timeout. r=places-reviewers,daisuke\n\nFaviconLoader debounces icon parsing with a DeferredTask created without a\nthird argument, so `_idleTimeoutMs` is undefined and `#startTimer()` falls\nthrough to `ChromeUtils.idleDispatch(callback, {timeout: undefined})`, which\nwaits indefinitely for an idle slot. Content that keeps its process' main\nthread busy therefore never lets `loadIcons()` run. Because idle dispatch\nis per-process, this also withholds favicon updates for other tabs\nsharing the content process.\n\nPass an explicit 3s idle timeout so a busy main thread can delay favicon\nupdates but not suppress them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323235\n", "files": ["browser/base/content/test/favicons/browser.toml", "browser/base/content/test/favicons/browser_favicon_idle_starvation.js", "browser/base/content/test/favicons/file_favicon_idle_starvation.html", "browser/modules/FaviconLoader.sys.mjs"], "git_node": "c3e3135677742e8ea067ee0852ff4809d187a65e", "git_parents": ["6f63d1a64a286c937711fc160c3efffd55c8eabe"], "node": "3b525a58c45450e2719a2f055be316c3bc626fd5", "parents": ["a9baa834a19657135a569e8a71c5ccda3db3a76d"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067224 - [customizable-menu] Add a MenuGridContainer and MenuGridItem composables to compose-menu r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324223\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/Menu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuItemsGroup.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/PresentationMode.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuGridContainer.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuGridItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItem.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuListItemGroup.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/utils/MenuPreviewParameterProvider.kt"], "git_node": "90060b79d462115701f4e095a5c832b7a486469d", "git_parents": ["c3e3135677742e8ea067ee0852ff4809d187a65e"], "node": "151e0ac9a1ae5eddb4138c88141107711115d30c", "parents": ["3b525a58c45450e2719a2f055be316c3bc626fd5"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069460 - Fix QueryCharacterAtPoint handling when character bounds offset is not 0. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324330\n", "files": ["dom/events/ContentEventHandler.cpp", "dom/html/EditContext.cpp", "editor/libeditor/tests/edit-context/test_editcontext_query_characters.html"], "git_node": "61a14de77408d386cf8bf967aae072ca698d0981", "git_parents": ["90060b79d462115701f4e095a5c832b7a486469d"], "node": "b6e0ef73b0c5418c49a18b556a5f6c6682790cd2", "parents": ["151e0ac9a1ae5eddb4138c88141107711115d30c"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070416 - Fix HTML example in moz-label README r=akulyk\n\nThere's a new HTML snippet in the moz-label README that's parsed as JSX\nso should be using a JS style object but it's authored as CSS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324519\n", "files": ["toolkit/content/widgets/moz-label/README.stories.md"], "git_node": "987148ef83c02146c6cd564b78b8ee30ebbb11fe", "git_parents": ["61a14de77408d386cf8bf967aae072ca698d0981"], "node": "f051ce8a8b97bd44fdac07768d88450232ee6d41", "parents": ["b6e0ef73b0c5418c49a18b556a5f6c6682790cd2"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061364 - Remove the Legacy Telemetry mirrors of the tracking_protection probes r=emz,chutten\n\nRemoves the TRACKING_PROTECTION_ENABLED, TRACKING_PROTECTION_PBM_DISABLED and\nTRACKING_PROTECTION_SHIELD histograms together with the telemetry_mirror lines\nthat point at them. The Glean metrics stay in place with expires: never, and\nboth recording sites already go through Glean only, so collection is unchanged.\n\nbrowser_protectionsUI_telemetry.js asserted on the legacy histograms, so it\nnow reads the Glean metrics instead. The startup value it checks is wiped by\nthe testResetFOG() calls in the other tests sharing the browser instance, so\nit records that value itself rather than depending on test order.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322106\n", "files": ["browser/base/content/test/protectionsUI/browser_protectionsUI_telemetry.js", "toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "a4a550ddf01d6878805eaf2cd8ab0c4ba864e749", "git_parents": ["987148ef83c02146c6cd564b78b8ee30ebbb11fe"], "node": "91811f7f3a84a11b34ead928893eeb0c9594b8ce", "parents": ["f051ce8a8b97bd44fdac07768d88450232ee6d41"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067188 - Ensure the ordering of the prefs mirrored by ContentClassifierPrefMirror. r=emz\n\nThe patch changes the ordering of the prefs mirrored by\nContentClassifierPrefMirror to ensure them matching the order of\nUrlClassifierFeatureFactory. This ensures the blocking behavior aligns\nbetween UrlClassifier and ContentClassifier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321891\n", "files": ["toolkit/components/content-classifier/ContentClassifierPrefMirror.cpp", "toolkit/components/content-classifier/test/browser/browser_content_classifier_pref_mirror.js"], "git_node": "bc2d03a3868f0b7667c9f96ddd76a0e2f0090a79", "git_parents": ["a4a550ddf01d6878805eaf2cd8ab0c4ba864e749"], "node": "112405ca8b2442d7b58778ddc66e802ad82ae52c", "parents": ["91811f7f3a84a11b34ead928893eeb0c9594b8ce"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065180 - Run the New Tab search bar tests in debug builds. r=mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324082\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser.toml"], "git_node": "23d77249c2a2608550edf3d7b8f1f8e3e3f90c15", "git_parents": ["bc2d03a3868f0b7667c9f96ddd76a0e2f0090a79"], "node": "664539175de70508596be9d6900033a2aee7991f", "parents": ["112405ca8b2442d7b58778ddc66e802ad82ae52c"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067861 - Reject unsupported heading level usage on setting configs r=mstriemer,Standard8\n\nThe supported way to set a heading level on a setting is the top-level `headingLevel` field on the config. Setting it another way sort of works today but bypasses the canonical path and makes it harder to build features on top of the field (like the ones in Bug 2044348).\n\nThis adds an ESLint rule that flags any setting config using `controlAttrs` to set a heading level. When it fails, it shows build as red on a patch and gets blocked from landing.\n\nThe setting config type is also narrowed so `controlAttrs` can't carry a `headingLevel` key. Once typechecking is enforced on these paths, the eslint rule can be removed and the type-level check alone will catch this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322698\n", "files": ["browser/components/preferences/widgets/setting-element/setting-element.mjs", "eslint.config.mjs"], "git_node": "ca24a61ce641fbd02333bf5ac794e2b8adfde916", "git_parents": ["23d77249c2a2608550edf3d7b8f1f8e3e3f90c15"], "node": "81af00840b6bf131f6293e5bf61a10d6cf6aa9e3", "parents": ["664539175de70508596be9d6900033a2aee7991f"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061870 - Remove a tab from recent tabs list once closed remotely in accounts menu r=desktop-theme-reviewers,sync-reviewers,kcochrane,markh\n\nRemove a remotely closed tab from the account/app menu recent tabs panel UI after 5 seconds and update the \"View All {numberOfTabs} Tabs\" count\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322331\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js"], "git_node": "95b8372779aca17e1d24658e886eaf4644b53814", "git_parents": ["ca24a61ce641fbd02333bf5ac794e2b8adfde916"], "node": "a093d32a3d8b76ee7dc20fe7fe0891f2ec5b97c4", "parents": ["81af00840b6bf131f6293e5bf61a10d6cf6aa9e3"], "tags": []}], "date": 1788971395, "git_changesets": ["c0dfcea1caf03945435be3c4e1a6431693e87a17", "ad77ad3aee803b467e898e1f95582ef6b9122333", "0ba3ca74f301e3f94495f1cdedc27f15ea523e1b", "84af2f91b21450fdefde13e766bdfc06b0c35cc2", "7386a62c9ef77edb4caf73eaca41f8367a272022", "bd204a688747ce8a8677c3c41d344d943ecac0ea", "4d57fe8125c9a1b7e4e734ce981c3951bfb5b2e8", "81626f8d9ef16fb17c76c7016009552ecbff278a", "7fbf5a310129675f856f555a09ed3dd7c2826742", "cdf102b487df4a0d44d72c738d00003a52cca649", "5452c5f8428e7466656eb3b3f3db83ebefba2db8", "f3ebe3ce5be6741d2271aefc29fd127735d412bf", "f591b64ffd5f5cb6d88671e3bd5219d800789c33", "f5c06603c292dbd314eb3eb6c0a49b93a31ac1fe", "3b5043bac860cf073b0cc8b225fb322e92d75a7d", "014cc8610ebf5b950041f2e59dbf2112a1519dda", "3d3c5e5909cacafc04296a3c5e79c76426133ed5", "e4dad5ece2c34a448e9c5ecc2ffce9daa19cd526", "03636c5df8ea35722f99f366e99620431a4c283a", "bec2739c10c635aa7a1a46325ebb152a3dee92eb", "62268677ac71fbf7b06e3bf8679c56ebdfe98c10", "c4d632c0ad8d6094105bd22e3c7c05206d27655a", "be363812e1b23d32fd22e8875d8317cd4d031d02", "1ca87b4f6632980630436acd175ae7d2baae71bf", "fb8d7cd39a4757cba2939f90248d7d40925cdd4c", "3ba9324ab2ad43b43407cd4319ba87e07dfc7e55", "873894ed0edc454e28afb4bc4291cf2d6d32ad4d", "043ca485b40d8d4fbe8a96f3143dd0ec712e8f