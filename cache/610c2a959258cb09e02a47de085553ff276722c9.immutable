85da2212c9f84509e409564f38dac901", "f82a86d6fbfe05f527569deaf8ab304949898435", "0ca9f8d7c3e98064e055d88de9ced9d79007551a", "dcf57df707de8b15b13beee3bb330989fed7f5dd", "b727d270f576a6090d60f04a1ebd239784989552", "5695e9492be258b35eff92e87154c03804217ca9", "5f091da12bab3ab2000293c55e66774a53c2b638", "9a3820bb8bdc6e5aa41455972d01ba5b32ac79f0", "896ddc914b75bc203029c8ec17237a9d99665131", "7a2ca5901d206bb0db35d7abdb9fcb54375d30e4", "5ef9b74bf6fbb95daf746762312dc3a6fc64591b", "29a043c67b9d9a35e16fa1858bd984cdd7cd450e", "80681147a04fe942c7f49807a939d0e3b8c402c9", "54d524b326d028c0088a0301359e3df9813ec051", "68feb576611ca2f7aab1b1db1803497b9508cb6b", "51cdaf9752313b4bfdcb7a7bfbf9d855b2690bea", "caabaeffaab9d1e4e5984ed425f205c729cddcf2", "1bc8dc1d001233a879c0273521d734da535edb10", "76e71d8bf995053f8d27b6a2ee413e941336a272", "d4f406481750863c9d42e5ddbde097633c9ca3f4", "e8d0e0a95c96f680b25bb9570117729cfd6c7d4d", "7a31e3b542ba060db170e918fe902d68d71eb690", "2f6fcd0808e736765eb5758fbaadaecd82205d7e", "d04a0264bd679af2d9d2e3f234e7991649b97f4e", "559ee6c1707ab1f9af7ce5a0540ef8b44dfac057", "d44c96a3f96cf00021ee72809285f180c47ea39d", "e03fc8bd6bcb87ce5ba7674e63261b07c1596bde", "9bd452db341dba12b311ce73692ec96f04aca152", "73fdf5a16ea6cc94e139b9823e8a630015a1a80c", "b105d3438176f2cb4b812273854005f9509932a5", "03969a3ad6d04097c5018e32b1d06a915f181faa", "028ed73ab1c844ae238a15496b6646f98872ad91", "302f7a0287247043d9ad07b8e7a6a6b133f858b9", "facbc1161f52e635d38902d0572c255e6257b6c9", "28f0e573577ba2eebcb186c14e7114312537f0ff", "59c03f93a881a159608acfd5e8360e4ac274c313", "db45d8e9ad730e32557f3dc73907bfab04024837", "6cba464774b15f063ce762c4441e63e2a517db60", "4bce60375c95fdb1da4033d78c2023a26bed80a3", "8c05912e290d1dae55b45d8058049c7f7a84c1d8"], "user": "asilaghi@mozilla.com"}, "45243": {"changesets": [{"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068035 - Update mochitests to use the correct headers and WPT expectations for Permissions-Policy. r=simonf\" for causing wpt failures at MediaDevices\n\nThis reverts commit 028ed73ab1c844ae238a15496b6646f98872ad91.\n\nRevert \"Bug 2068035 - Rename policy methods used for iframe allow attributes. r=simonf\"\n\nThis reverts commit 03969a3ad6d04097c5018e32b1d06a915f181faa.\n\nRevert \"Bug 2068035 - Renamed Feature-Policy to Permissions-Policy and switched to SFV parser r=simonf\"\n\nThis reverts commit b105d3438176f2cb4b812273854005f9509932a5.\n", "files": ["dom/base/Document.cpp", "dom/html/HTMLIFrameElement.cpp", "dom/security/featurepolicy/FeaturePolicy.cpp", "dom/security/featurepolicy/FeaturePolicy.h", "dom/security/featurepolicy/FeaturePolicyParser.cpp", "dom/security/featurepolicy/FeaturePolicyParser.h", "dom/security/featurepolicy/fuzztest/fp_fuzzer.cpp", "dom/security/featurepolicy/test/gtest/TestFeaturePolicyParser.cpp", "dom/security/featurepolicy/test/mochitest/file_xslt.html^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt.xml^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt.xsl^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt_outer.html^headers^", "dom/security/featurepolicy/test/mochitest/test_parser.html^headers^", "testing/web-platform/meta/serial/serial-disabled-by-permissions-policy.https.sub.html.ini"], "git_node": "3c6e9f0700b5a702c6d3fde4306554d364adb213", "git_parents": ["8c05912e290d1dae55b45d8058049c7f7a84c1d8"], "node": "f4562ea5935cb3e7edd959b256844ce2febe737a", "parents": ["695ce0ec08a305fc2b7f1ca526ab5d903382ff99"], "tags": []}], "date": 1788472650, "git_changesets": ["3c6e9f0700b5a702c6d3fde4306554d364adb213"], "user": "asilaghi@mozilla.com"}, "45244": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5fdfd0092780e85643e2cddc0e1b590c8b9ef860 with FIREFOX_155_0_1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "63fcc43d4c8ffbd70bf688fe388e2dbf3f8b6dd4", "git_parents": ["2a8946839e4f9047c11b8e844bbf37d1d19f280c"], "node": "3817c7569c95b224e4382198c7f66522bc25b604", "parents": ["a751d511f8fd14585387de4ee15264d6e7b1265c"], "tags": []}], "date": 1788479993, "git_changesets": ["63fcc43d4c8ffbd70bf688fe388e2dbf3f8b6dd4"], "user": "ffxbld@lando.moz.tools"}, "45245": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5fdfd0092780e85643e2cddc0e1b590c8b9ef860 with FIREFOX-ANDROID_155_0_1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "1b15b59a4e16865ed0f90c7b17cdc57b16c0ec49", "git_parents": ["63fcc43d4c8ffbd70bf688fe388e2dbf3f8b6dd4"], "node": "3b306e98e0398edf4b975ef8c8bceedcb36fbbac", "parents": ["3817c7569c95b224e4382198c7f66522bc25b604"], "tags": []}], "date": 1788480077, "git_changesets": ["1b15b59a4e16865ed0f90c7b17cdc57b16c0ec49"], "user": "ffxbld@lando.moz.tools"}, "45246": {"changesets": [{"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062652 - Part 1 - Extract Sanitizer's per-element algorithms r=tschuster\n\nSanitizeChildren() had the spec's \"sanitize an Element\" inlined in its loop.\n\nThis change splits it into three pieces:\n\n- MatchElementInternal(), what the configuration does with an element of a\n  given name, plus the element's entry in the configuration's element list,\n  returned as a SanitizerElementMatch,\n\n- ShouldRemoveAttributeInternal(), whether a single attribute of a matched\n  element has to be removed,\n\n- SanitizeElementInternal(), both of the above applied to an existing element.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320638\n", "files": ["dom/security/sanitizer/Sanitizer.cpp", "dom/security/sanitizer/Sanitizer.h"], "git_node": "a7a3ef3ed347bb1eceeda4715324610f505b4696", "git_parents": ["8c05912e290d1dae55b45d8058049c7f7a84c1d8"], "node": "5d3300fb12b22477396fec74525cf3785221e51c", "parents": ["695ce0ec08a305fc2b7f1ca526ab5d903382ff99"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062652 - Part 2 - Add insert-before tree operations to the HTML parser r=dom-core-reviewers,hsivonen\n\nSanitizing while parsing needs to insert content at a position other than the\nend of a parent's child list, because content whose parent the sanitizer\nreplaced with its children keeps the position that parent would have had.\n\nThis change prepares for that, without any sanitizer-visible behaviour:\n\n- The node, text and comment insertion paths are factored into\n  PrepareForInsertion(), InsertNodeBefore(), InsertTextImpl() and\n  InsertCommentImpl(), and gain InsertBefore(), InsertTextBefore() and\n  InsertCommentBefore() variants that take the node to insert before,\n\n- GetFosterParent() is split so that GetFosterParentForInsertBefore() exposes\n  the foster parent to insert before the table in, without the stack parent\n  fallback,\n\n- IsElementOrTemplateContent() becomes IsPossibleFosterParent(): the spec says\n  \"if the adjusted insertion location's last table has a parent node\", and any\n  parent node qualifies, including the DocumentFragment that roots a fragment\n  parse,\n\n- nsHtml5HtmlAttributes gains entryAt() and removeAttributeAt(), so that a\n  start tag token's attributes can be filtered before they reach the element.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320669\n", "files": ["parser/html/nsHtml5HtmlAttributes.h", "parser/html/nsHtml5TreeOperation.cpp", "parser/html/nsHtml5TreeOperation.h", "testing/web-platform/meta/sanitizer-api/html5lib-basics.html.ini", "testing/web-platform/meta/sanitizer-api/sethtml-tree-construction.html.ini"], "git_node": "0a56fc263504dffa26ec540ec5d0f3e8bf360042", "git_parents": ["a7a3ef3ed347bb1eceeda4715324610f505b4696"], "node": "35213fb8ea71900429a496b72e32032da55293af", "parents": ["5d3300fb12b22477396fec74525cf3785221e51c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1971922 - Restore the sidebar tools height on the right element when disabling expand-on-hover. r=sfoster\n\nEnabling expand-on-hover sets the tools height to \"0\" on the buttons-wrapper.\nThe disable path restored it on the button-group instead, and assigned a bare\nnumber, which is only valid CSS for 0, so the wrapper kept its \"0\" and every\ntool button stayed out of view. updateToolsHeight() also clears the height when\nvertical tabs are disabled or no height was stored.\n\nA launcher drag disables expand-on-hover for its duration, so the tools now keep\ntheir height while dragging instead of staying collapsed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322550\n", "files": ["browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js"], "git_node": "2e051bd1405931fb84c67a12e824e4946e9d207e", "git_parents": ["0a56fc263504dffa26ec540ec5d0f3e8bf360042"], "node": "58dc2bbdc4826d32ded752ce112c44836ff329a8", "parents": ["35213fb8ea71900429a496b72e32032da55293af"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1971922 - Clear the sidebar tools overflow panel when switching to horizontal tabs. r=sfoster\n\nClearing the panel by matching the buttons rendered at that moment left a copy\nbehind for a tool removed while overflowing, which kept the overflow button\nshown after switching back to vertical tabs.\n\nThe tools height is persisted, so the test also restores it after each task that\nresizes the tools container, and re-enables browser_tools_overflow.js on Windows\nopt, disabled in this bug for frequency rather than for a distinct cause.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322551\n", "files": ["browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/SidebarTestUtils.sys.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_tools_overflow.js"], "git_node": "f495845ac24b78cc82b22dd92882bd7eb0d633f4", "git_parents": ["2e051bd1405931fb84c67a12e824e4946e9d207e"], "node": "3876bbf0f5dabbd334b66e8821b80143824d3eca", "parents": ["58dc2bbdc4826d32ded752ce112c44836ff329a8"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2067907 - Collapse the launcher before dragging the tools splitter in browser_tools_overflow.js. r=sfoster\n\nDepends on D322551\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322552\n", "files": ["browser/components/sidebar/tests/browser/browser_tools_overflow.js"], "git_node": "411426d8f6e17d7f3c700f8af2227d5de51aabac", "git_parents": ["f495845ac24b78cc82b22dd92882bd7eb0d633f4"], "node": "09176ba2bc7e8c276ab9fc0a2cfe6f74e62a328e", "parents": ["3876bbf0f5dabbd334b66e8821b80143824d3eca"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2068632 - Set mDefaultSelectionSet for non-parser-created selects r=emilio\n\nBug 2038588, replaced `TrySelectSomething`, so that option selectedness is only\ndirty via `OnSelectionChanged`. `OnSelectionChanged` returns early unless\n`mDefaultSelectionSet` is set, and only `DoneAddingChildren` sets it.\nThis means it never runs for a select built by script. Removing the last\nunselected option from such a combobox, or resetting its form, re-selects the\nfirst enabled option but leaves `selectedOptions` stale.\n\nThis change moves to initialise `mIsDoneAddingChildren` in the constructor. It's\nalready set when the select is not parser-created. The result is that the early\nreturn is skipped, allowing the selected option list to become dirty.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323244\n", "files": ["dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSelectElement.h", "testing/web-platform/tests/html/semantics/forms/the-select-element/select-selectedOptions.html"], "git_node": "36658b19bd4d5e4f4a44e02fe9050caa5085bc8c", "git_parents": ["411426d8f6e17d7f3c700f8af2227d5de51aabac"], "node": "48a3fb1cfc3c644dbc0ca689c976b8183502328f", "parents": ["09176ba2bc7e8c276ab9fc0a2cfe6f74e62a328e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Make the `l10n` chrome manifests independent of staging order r=firefox-build-system-reviewers,sergesanspaille\n\nLocales stage concurrently into the same `dist/bin`, so two of them can read and\nrewrite a shared manifest at once. The rewrites run under one lock, held beside\nthe destination rather than inside it, and the entries are sorted so the result\ndoes not depend on which locale got there first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322443\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py", "python/mozbuild/mozbuild/test/action/test_l10n_stage.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "ccb5c345fd3f4060f42911f8bced6296f76c8cfb", "git_parents": ["36658b19bd4d5e4f4a44e02fe9050caa5085bc8c"], "node": "9f8f324c2f685b900badf65567f610573fa134db", "parents": ["48a3fb1cfc3c644dbc0ca689c976b8183502328f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Raise a `MissingJarSource` error when a staged l10n source is missing r=firefox-build-system-reviewers,sergesanspaille\n\nA missing source surfaced as a bare `FileNotFoundError` from the copy, which\nnames the resolved path but not the locale, the manifest context or the\njar.mn entry that produced it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322444\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py", "python/mozbuild/mozbuild/test/action/test_l10n_stage.py"], "git_node": "cf0e01a9b8a59bcbdbe82a8b53624b987f91158b", "git_parents": ["ccb5c345fd3f4060f42911f8bced6296f76c8cfb"], "node": "49b05c52d9abf61d1b42c30c848cd35d2e44472f", "parents": ["9f8f324c2f685b900badf65567f610573fa134db"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Add `MOZ_L10N_CHROME_ROOTS` to scope the manifest's `jar.mn` content r=firefox-build-system-reviewers,sergesanspaille\n\nEvery `moz.build` directory with localized content lands in\n`l10n-manifest.json`, but Android localizes only its own and its branding\ndirectory and overrides the rest through\n`locale/\u003cab_cd\u003e/browser/overrides/`, so the merge tree that its `l10n.toml`\nbuilds has nothing under `netwerk`, `security` or the bulk of `toolkit`.\n\nOnly `jar.mn` content is scoped. Non chrome localized and generated entries\nkeep their existing behavior, so application metadata such as\n`toolkit/locales`' `default.locale` is still produced for repacks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322445\n", "files": ["mobile/android/moz.configure", "python/mozbuild/mozbuild/frontend/l10n_manifest.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/app/locales/en-US/app.ini", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/app/locales/moz.build", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/chrome/locales/jar.mn", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/chrome/locales/moz.build", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/moz.build", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/shared/locales/en-US/shared.ini", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/shared/locales/jar.mn", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest-roots/shared/locales/moz.build", "python/mozbuild/mozbuild/test/backend/test_l10n_manifest.py", "python/mozbuild/mozbuild/test/frontend/test_l10n_manifest.py"], "git_node": "baf62ccdb51711f6271493de2afd84311aa72e08", "git_parents": ["cf0e01a9b8a59bcbdbe82a8b53624b987f91158b"], "node": "57968fec4def64351174b0d780b9ce1791617872", "parents": ["49b05c52d9abf61d1b42c30c848cd35d2e44472f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Use the new Python `l10n` actions by default r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321376\n", "files": ["moz.configure"], "git_node": "bef2a720b53520d81f39e68c9c9297009776c23f", "git_parents": ["baf62ccdb51711f6271493de2afd84311aa72e08"], "node": "a36d55600eb5d201b37bbf4891ad32e648bf3b82", "parents": ["57968fec4def64351174b0d780b9ce1791617872"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2068793 - reduce dependencies for L2P module r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323121\n", "files": ["mobile/android/android-components/.buildconfig.yml", "mobile/android/android-components/components/feature/listentopage/build.gradle"], "git_node": "4c452e63da90197cb64c034c34b225733cbe4a22", "git_parents": ["bef2a720b53520d81f39e68c9c9297009776c23f"], "node": "aca18566882cd37f5e5b11b64614d52c07be735b", "parents": ["a36d55600eb5d201b37bbf4891ad32e648bf3b82"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2061327 - Uncache subtree of hidden accessible when it is coalesced. r=Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319920\n", "files": ["accessible/base/NotificationController.cpp", "accessible/generic/DocAccessible.cpp"], "git_node": "053f0d31f95b76896d83d0de54edbb0911483992", "git_parents": ["4c452e63da90197cb64c034c34b225733cbe4a22"], "node": "e3179e07e3f74f3a3f9ecbcd99bf49a449cdca16", "parents": ["aca18566882cd37f5e5b11b64614d52c07be735b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067694 - Make clippy lint first-party non-workspace dependencies. r=firefox-build-system-reviewers,ahochheiden\n\nAdd a simple wrapper to forward the WORKSPACE_WRAPPER even if we're\noutside of our workspace. This works because third-party rust has\n--cap-lints allow so clippy is disabled there anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322619\n", "files": ["build/cargo-clippy-wrapper", "build/cargo-clippy-wrapper.bat", "build/cargo-linker", "build/moz.configure/rust.configure", "config/makefiles/rust.mk"], "git_node": "e4261435c78a22b68c174442ec0f3ef89400f68b", "git_parents": ["053f0d31f95b76896d83d0de54edbb0911483992"], "node": "bb555eed229843ac2d1492d7a9741894bbd60948", "parents": ["e3179e07e3f74f3a3f9ecbcd99bf49a449cdca16"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068748 - Don't run mach newtab bundle on buildtokens r=jules\n\nThe newtab bundle is now generated when it's needed so we don't need to\nrun the bundle in buildtokens to apply the changes. The _tokens.scss\nfile is still being updated by the regular buildtokens command.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323048\n", "files": ["toolkit/content/widgets/mach_commands.py"], "git_node": "f1d8187f490dc6532df1ba1aee47875188ec9f3f", "git_parents": ["e4261435c78a22b68c174442ec0f3ef89400f68b"], "node": "6b525f0857fc17ec9ab039514a5b53a188be4953", "parents": ["bb555eed229843ac2d1492d7a9741894bbd60948"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065711 - Part 1: Stop a seek longer than the macOS callback queue from freezing the clock. r=padenot,media-playback-reviewers\n\nOn macOS a seek longer than the callback queue strands callback items on the\naudio thread, and they reach the frame history after the rebase has moved past\nthe frames they describe, freezing the clock for the length of the stranded\nsilence. Counting the frames of every item the reader takes off the queue, and\nrecording that count at each rebase, lets those late items be recognised and\ndropped.\n\n  frames:   0 ......... 48,000 ......... 72,000 ......... 96,000\n            |\u003c-- queued --\u003e|\u003c-- stranded --\u003e|\u003c-- post-seek --\u003e|\n                                            ^\n                                      rebase anchor\n\nThe clock should count up from the anchor. Instead the stranded silence was\nappended after it, so the span beyond the anchor read as the seek target and\nthe position stayed there for as long as the stranded silence lasted, then\ntrailed the audio by that much for the rest of playback. Dropping any item\nwhose frames end at or before the anchor covers the queued and the stranded\nones alike, which discarding only what the rebase can see cannot do: the items\nthat matter have not arrived yet.\n\nEvery other platform appends to the history synchronously and has no queue, so\nnone of this can arise there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322808\n", "files": ["dom/media/AudioStream.cpp", "dom/media/AudioStream.h", "dom/media/gtest/TestAudioClock.cpp"], "git_node": "b8ce582c58e776ef3a5fe74632d31ba4efe34a58", "git_parents": ["f1d8187f490dc6532df1ba1aee47875188ec9f3f"], "node": "0555f07cd7800896c95011c7ca72937f4137e1f6", "parents": ["6b525f0857fc17ec9ab039514a5b53a188be4953"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065711 - Part 2: Keep the unplayed audio when rebasing a reused stream's clock. r=padenot,media-playback-reviewers\n\nRebasing a reused stream anchored the clock at what the device had played,\ndiscarding the audio already handed to the backend but not yet heard. Carrying\nthat span across as a chunk worth no media time holds the position at the seek\ntarget until the device plays it out.\n\n  frames:   0 ......... played ......... handed over\n            |\u003c-- heard --\u003e|\u003c-- unplayed --\u003e|\n                          ^\n                    rebase anchor\n\nDiscarded, the position left the anchor as soon as the device moved, so video\nslaved to it was held and then rushed. The span is taken from the handed-over\ncount, not the frame history, which trails during a seek.\n\nCarry nothing when that audio will never play: a pause before the seek stops\nthe backend and discards its queue, and a failed position query leaves no play\ncursor. A cursor pair that makes no sense is logged rather than trusted, since\nthe backend position is an estimate.\n\nThe rebase must run before the audio path is re-armed, or post-seek audio loses\nits media time. No test can interleave a callback there, so an assertion\nenforces the ordering.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322487\n", "files": ["dom/media/AudioStream.cpp", "dom/media/AudioStream.h", "dom/media/gtest/TestAudioClock.cpp", "dom/media/mediasink/AudioSink.cpp"], "git_node": "9480e6363450ba4d6396ed1b3bf26bcf81aac078", "git_parents": ["b8ce582c58e776ef3a5fe74632d31ba4efe34a58"], "node": "098877fcdfe051e26790de4ac4906ede29869a66", "parents": ["0555f07cd7800896c95011c7ca72937f4137e1f6"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065711 - Part 3: Test the clock of a stream reused across a seek. r=padenot,media-playback-reviewers\n\nCover what a reuse creates and the existing cases cannot: the device still\ntrails by unplayed audio when the clock is rebased. Further cases pin the\npieces around it, a window of underrun silence, a second seek over an\noutstanding carried chunk, a history left behind by a full callback queue, a\nplay cursor reported above the write cursor, and a rebase that carries nothing.\n\nThe existing cases only query the position where the device has played\neverything handed to it, which a reuse never is, so every piece of the rebase\ncould have been removed with all of them still passing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322488\n", "files": ["dom/media/gtest/TestAudioClock.cpp"], "git_node": "861e45d29b9068d8ebec8c7d2bad4421d5620980", "git_parents": ["9480e6363450ba4d6396ed1b3bf26bcf81aac078"], "node": "3cd1d61b3487fd2ec25dc2ae1e553b687f010913", "parents": ["098877fcdfe051e26790de4ac4906ede29869a66"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065711 - Part 4: Bound the sink-level clock tests by the audio the device has played. r=padenot,media-playback-reviewers\n\nTwo unrelated changes to the sink-level reuse tests:\n\n- Add a case for the reuse a pause before the seek produces, which restarts the\n  backend so its queued audio is discarded rather than played, leaving nothing\n  to hold the position back.\n\n- Bound the existing cases by the audible position rather than by everything\n  written, and reach a full output-latency window of unplayed audio before\n  seeking rather than seeking after a single callback.\n\nThe second is needed because the existing cases are not strict enough to catch a\nclock reporting audio the device has not played, in two independent ways: their\nceiling is everything written, which is exactly what such a clock reports, so it\nsits on the bound and passes; and a single pre-seek callback leaves so little\nunplayed audio that the whole error falls under the tolerance, so correcting the\nceiling alone would still miss it.\n\nA further assertion pins the exact position while the carried window drains,\nwhere post-seek audio has been handed over but none is audible yet. The\nsteady-state bounds alone tolerate a carry wrong by about three callbacks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322489\n", "files": ["dom/media/gtest/TestAudioSinkWrapper.cpp"], "git_node": "aba91554c3ad5f7c445e5a0543c036aa725b1cae", "git_parents": ["861e45d29b9068d8ebec8c7d2bad4421d5620980"], "node": "50c6693c3ce09e6f339c17af4bd3683c590b06e7", "parents": ["3cd1d61b3487fd2ec25dc2ae1e553b687f010913"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065711 - Part 5: Document AudioStream, its two frame cursors and the unplayed audio between them. r=padenot,media-playback-reviewers\n\nGive AudioStream its own page: the two frame cursors a backend exposes, the\nunplayed audio between them, what the frame history holds, why a rebase across\na seek carries that gap and when it must not, and which thread may touch what.\nThe AudioSinkWrapper page now refers to it rather than restating the cursors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322490\n", "files": ["dom/media/docs/AudioSinkWrapper.md", "dom/media/docs/AudioStream.md", "dom/media/docs/index.md"], "git_node": "2aa0fcafa4f43d1747d0ee9b3149c67bd74d45bc", "git_parents": ["aba91554c3ad5f7c445e5a0543c036aa725b1cae"], "node": "c99d07837cb3cad5241b53de843dc560ec7d8fa3", "parents": ["50c6693c3ce09e6f339c17af4bd3683c590b06e7"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053923 - Update tab HCM styling r=desktop-theme-reviewers,tabbrowser-reviewers,sthompson,hjones,nsharpley,ini\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320311\n", "files": ["browser/components/sidebar/sidebar-opentabs.css", "browser/components/sidebar/sidebar-tab-row.css", "browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/ThemeVariableMap.sys.mjs", "browser/themes/shared/tabbrowser/tab.nova.tokens.json", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/tabbrowser/tabs.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/figma-variables-all.json", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json"], "git_node": "53232bb70af26cfa9d796ff1c890843176cf13b1", "git_parents": ["2aa0fcafa4f43d1747d0ee9b3149c67bd74d45bc"], "node": "c4729e535c6239da68f7977cee17df6e8736f275", "parents": ["c99d07837cb3cad5241b53de843dc560ec7d8fa3"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068035 - Update mochitests to use the correct headers and WPT expectations for Permissions-Policy. r=simonf\" for causing wpt failures at MediaDevices\n\nThis reverts commit 028ed73ab1c844ae238a15496b6646f98872ad91.\n\nRevert \"Bug 2068035 - Rename policy methods used for iframe allow attributes. r=simonf\"\n\nThis reverts commit 03969a3ad6d04097c5018e32b1d06a915f181faa.\n\nRevert \"Bug 2068035 - Renamed Feature-Policy to Permissions-Policy and switched to SFV parser r=simonf\"\n\nThis reverts commit b105d3438176f2cb4b812273854005f9509932a5.\n", "files": ["dom/base/Document.cpp", "dom/html/HTMLIFrameElement.cpp", "dom/security/featurepolicy/FeaturePolicy.cpp", "dom/security/featurepolicy/FeaturePolicy.h", "dom/security/featurepolicy/FeaturePolicyParser.cpp", "dom/security/featurepolicy/FeaturePolicyParser.h", "dom/security/featurepolicy/fuzztest/fp_fuzzer.cpp", "dom/security/featurepolicy/test/gtest/TestFeaturePolicyParser.cpp", "dom/security/featurepolicy/test/mochitest/file_xslt.html^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt.xml^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt.xsl^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt_outer.html^headers^", "dom/security/featurepolicy/test/mochitest/test_parser.html^headers^", "testing/web-platform/meta/serial/serial-disabled-by-permissions-policy.https.sub.html.ini"], "git_node": "8bccb6b79ad65c0ffe10403dcd495af4dd9c922d", "git_parents": ["53232bb70af26cfa9d796ff1c890843176cf13b1"], "node": "b200058a1de573298284ba8342aeef9a65e46301", "parents": ["c4729e535c6239da68f7977cee17df6e8736f275"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "364ab8c2d95c27450ed59388956ce10840088fc4", "git_parents": ["8bccb6b79ad65c0ffe10403dcd495af4dd9c922d", "3c6e9f0700b5a702c6d3fde4306554d364adb213"], "node": "2f706e6dc38747a7a869ebc3ba283499cae1860c", "parents": ["b200058a1de573298284ba8342aeef9a65e46301", "f4562ea5935cb3e7edd959b256844ce2febe737a"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2068159: Test that the DTMF playout task is queued immediately when required. r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322763\n", "files": ["testing/web-platform/tests/webrtc/RTCDTMFSender-ontonechange.https.html"], "git_node": "346363324cc0148bac5435401d982f0635e86c28", "git_parents": ["364ab8c2d95c27450ed59388956ce10840088fc4"], "node": "f195d0e105101af6b2b82a7b5824a8ba700617de", "parents": ["2f706e6dc38747a7a869ebc3ba283499cae1860c"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2068159: Tighten up spec compliance in InsertDTMF. r=ng\n\n* Queue a playout task immediately in situations where we previously\n  scheduled a timer of duration 0.\n\n* Check CanSendDTMF properly in the playout steps task (this means we\n  don't need to fire events at RTCRtpSender anymore).\n\n* Add spec steps as comments.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322764\n", "files": ["dom/media/webrtc/jsapi/RTCDTMFSender.cpp", "dom/media/webrtc/jsapi/RTCDTMFSender.h", "dom/media/webrtc/jsapi/RTCRtpSender.cpp", "dom/media/webrtc/jsapi/RTCRtpSender.h"], "git_node": "8db4326a67580a02fe262e310baf3191dbade63a", "git_parents": ["346363324cc0148bac5435401d982f0635e86c28"], "node": "a3be05896078bed86a1dab13a63c1f3c184cacda", "parents": ["f195d0e105101af6b2b82a7b5824a8ba700617de"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062444 - Make browser_opentabs_hover_preview.js hover the launcher button and the preview row reliably, r=sfoster.\n\nThe close button is visibility:hidden until its row is hovered, so clicking it\nwithout hovering leaves it with no accessible and the a11y checks fall back to\nthe .preview-row ancestor, a non-focusable role=\"button\" tracked in bug 2067077.\n\nThe launcher button has no layout until it has rendered, so a mousemove\nsynthesized at its centre as soon as it appears in the shadow DOM lands beside\nit and the preview never opens. Awaiting its render is not enough, as the\nlauncher keeps reflowing around it: retry the hover until the button reports\n:hover, moving the pointer away first when it is already there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321902\n", "files": ["browser/components/sidebar/tests/browser/browser_opentabs_hover_preview.js"], "git_node": "ba43578cfbac3e4c80e32f1fe9dfebf5e4656bfc", "git_parents": ["8db4326a67580a02fe262e310baf3191dbade63a"], "node": "26aa9ad510c5175197c336e43a5593f3db128174", "parents": ["a3be05896078bed86a1dab13a63c1f3c184cacda"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2068401: Make this function a no-op on failure. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322984\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/stun/turn_client_ctx.cpp"], "git_node": "c40e18acbf07081a1d8ecd71b76f1b60f0c6e09c", "git_parents": ["ba43578cfbac3e4c80e32f1fe9dfebf5e4656bfc"], "node": "f14f755040eb6d902c5f67302f73b9c7517926c9", "parents": ["26aa9ad510c5175197c336e43a5593f3db128174"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065813 - Take a tab's userContextId from the tab, not its attribute. r=jsudiaman,tabbrowser-reviewers\n\nBoth sites read the attribute where the tab has a getter that parses it, so a documented number was a string. No behaviour rides on the difference: a container id is never 0, since ContextualIdentityService allocates from 1, and every writer of the attribute guards on truthiness, so string and number diverge only for a value that cannot occur.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320694\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "68cfbfead50a80f48d86b3dc90ead8f071be1265", "git_parents": ["c40e18acbf07081a1d8ecd71b76f1b60f0c6e09c"], "node": "6b0abbb46c4bfd70f14b86dd53ca7d43ea17b45b", "parents": ["f14f755040eb6d902c5f67302f73b9c7517926c9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065813 - Pass confirmEx a checkbox state it can write to. r=kcochrane,tabbrowser-reviewers\n\nThe prompt passes no checkbox message, so nothing reads or writes that state: the change is inert at runtime and only satisfies `InOutParam\u003cboolean\u003e`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320695\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "7c05f8dd047add1f375b96cd2baf1872185816e8", "git_parents": ["68cfbfead50a80f48d86b3dc90ead8f071be1265"], "node": "ebb479c5b88d455ff9aac1ffa6a27e6b6642a8b3", "parents": ["6b0abbb46c4bfd70f14b86dd53ca7d43ea17b45b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065813 - Let removeAllTabsBut forward the options it doesn't document. r=nsharpley,tabbrowser-reviewers\n\nThe bag carries `removeTabs` options through, which callers rely on, so its declared shape is two flags out of eight. Enumerating the other six here would duplicate their documentation; the cast says the object is opaque at this point instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320696\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "c3b4df84c958eefa9d820a0f61517e4f055a5363", "git_parents": ["7c05f8dd047add1f375b96cd2baf1872185816e8"], "node": "652949c43bd090845df16aad24d9c22e646f8f82", "parents": ["ebb479c5b88d455ff9aac1ffa6a27e6b6642a8b3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068511 - Document the option defaults a caller would not guess. r=kcochrane,tabbrowser-reviewers\n\nAn optional boolean is falsy when absent and an optional object is not there at all, so spelling those defaults out restates the brackets. Which of them the destructuring declares is arbitrary - one method declares a skip flag's `false` beside a bare sibling - and mirroring that would put the arbitrariness on the generated page. What a reader cannot guess is a default that is neither: one flag defaults to on, and three are computed by the callee, which the descriptions now say.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322878\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "10c6672b1ab04a49705d7b0aaf0b679563f7c8cf", "git_parents": ["c3b4df84c958eefa9d820a0f61517e4f055a5363"], "node": "ca948dc7593ddb7b8cac3ccc0457467095a819c0", "parents": ["652949c43bd090845df16aad24d9c22e646f8f82"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068511 - Rename the tabbrowser's remaining aOptions and aParams bags to options. r=kcochrane,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322879\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "f2f0fd970efffe8b5ed0ecc2e6366645e7c0548c", "git_parents": ["10c6672b1ab04a49705d7b0aaf0b679563f7c8cf"], "node": "07042648f1d31687fb2042d22b4ddef12c66c334", "parents": ["ca948dc7593ddb7b8cac3ccc0457467095a819c0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068511 - Document three public methods that had no JSDoc at all. r=kcochrane,tabbrowser-reviewers\n\nThey are the three whose option bags the previous commit renames; the other four it touches were already documented. `#setTabLabel` destructures exactly the three properties `setInitialTabTitle` now names, so forwarding them individually passes on what the whole bag did. Typing its tab parameter also makes the `_labelIsInitialTitle` it sets visible to the type checker, hence the declaration beside its `_labelIsContentTitle` sibling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322880\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/types/elements.ts"], "git_node": "4cbe7df4b97ab71a64269cb100ac7b0e2cf1ee74", "git_parents": ["f2f0fd970efffe8b5ed0ecc2e6366645e7c0548c"], "node": "768ba66bbf1b292d1379b5758bcd8463bfe0c788", "parents": ["07042648f1d31687fb2042d22b4ddef12c66c334"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066568 - Reduce autocomplete row item icons back to --icon-size. r=desktop-theme-reviewers,credential-management-reviewers,kcochrane,dao,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323113\n", "files": ["browser/themes/shared/autocomplete.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.css"], "git_node": "229cb54bb92d6ca3c76ef81d05f42f70f1c5962c", "git_parents": ["4cbe7df4b97ab71a64269cb100ac7b0e2cf1ee74"], "node": "6c8185a1f8a267fd59e54374b701534fea1f8a58", "parents": ["768ba66bbf1b292d1379b5758bcd8463bfe0c788"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068961 - Add colour metadata test videos with explicit transfer functions. r=media-playback-reviewers,ahale,azebrowski\n\ngen_combos.py cross combines a single colour space name into primaries,\ntransfer and matrix, so the generated corpus cannot express BT.2100 PQ or HLG,\nor wide gamut SDR. Those are the cases where a decoder has to report a transfer\nfunction that is not implied by the primaries, which is what the macOS\nVideoToolbox path gets wrong.\n\nAdd a second, explicit set of combinations for those, signalled through\nx265-params and svtav1-params so the values land in the bitstream rather than\nonly in the container, plus HEVC, which is the codec VideoToolbox most reliably\ndecodes in hardware on macOS and which the corpus had no coverage of at all.\n\nThe samples are transfer converted with zscale rather than merely tagged, so\nregenerating them needs an ffmpeg built with libzimg. Within a combination the\nsamples are identical across codecs, so codec to codec comparisons isolate the\ncontainer and decoder rather than the encode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323303\n", "files": ["dom/media/test/reftest/color_quads/720p.png.bt2020.bt2020.tv.yuv420p10.av1.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.bt2020.tv.yuv420p10.av1.webm", "dom/media/test/reftest/color_quads/720p.png.bt2020.bt2020.tv.yuv420p10.hevc.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.hlg.tv.yuv420p10.av1.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.hlg.tv.yuv420p10.av1.webm", "dom/media/test/reftest/color_quads/720p.png.bt2020.hlg.tv.yuv420p10.hevc.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.hlg.tv.yuv420p10.vp9.webm", "dom/media/test/reftest/color_quads/720p.png.bt2020.pq.tv.yuv420p10.av1.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.pq.tv.yuv420p10.av1.webm", "dom/media/test/reftest/color_quads/720p.png.bt2020.pq.tv.yuv420p10.hevc.mp4", "dom/media/test/reftest/color_quads/720p.png.bt2020.pq.tv.yuv420p10.vp9.webm", "dom/media/test/reftest/color_quads/720p.png.bt709.bt709.tv.yuv420p.hevc.mp4", "dom/media/test/reftest/gen_combos.py"], "git_node": "3e3f1c26c5dd7febbde495066ef5af10d42a77b1", "git_parents": ["229cb54bb92d6ca3c76ef81d05f42f70f1c5962c"], "node": "cd2c2bcb80b326361e67d783f119be3ca1c5f2af", "parents": ["6c8185a1f8a267fd59e54374b701534fea1f8a58"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068961 - Test the colorspace attached to VideoToolbox decoded frames. r=ahale\n\nExhaustive over the cross product of transfer function and colour primaries,\nbecause the rule is a pure function of those two and the combinations codecs\nhappen to emit are only a subset of what has to be right.\n\nPlus one end to end check per side, decoding through VideoToolbox in process\nand inspecting the IOSurface the compositor would receive: an SDR frame keeps\nthe colorspace VideoToolbox gave it, and a PQ frame still gets an explicit one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323304\n", "files": ["dom/media/gtest/TestAppleVTColorSpace.cpp", "dom/media/gtest/moz.build"], "git_node": "6c455079a76a5703dc474b502bd20e7ad06337ba", "git_parents": ["3e3f1c26c5dd7febbde495066ef5af10d42a77b1"], "node": "b6b9b30cb25cca09f92bf49ab94cc8cf70f252cf", "parents": ["cd2c2bcb80b326361e67d783f119be3ca1c5f2af"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2068961 - Only override the VideoToolbox buffer colorspace for wide gamut and HDR content. r=media-playback-reviewers,ahale,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323305\n", "files": ["dom/media/platforms/apple/AppleVTColorSpace.h", "dom/media/platforms/apple/AppleVTDecoder.cpp"], "git_node": "a4f192aa6d645b55eab6f746055d414eedebf0a8", "git_parents": ["6c455079a76a5703dc474b502bd20e7ad06337ba"], "node": "963c8ed70a9871b3d7808789ecd8baa130155c4c", "parents": ["b6b9b30cb25cca09f92bf49ab94cc8cf70f252cf"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067629 - Include popover invoker children/shadow root in sequential focus navigation. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323017\n", "files": ["dom/base/nsFocusManager.cpp", "testing/web-platform/tests/html/semantics/popovers/popover-focus-invoker-with-children.tentative.html", "testing/web-platform/tests/html/semantics/popovers/resources/popover-utils.js"], "git_node": "d9a41916fb5f1df54fb9131cf372a4ae1bc0d372", "git_parents": ["a4f192aa6d645b55eab6f746055d414eedebf0a8"], "node": "35945c4c75cae8691a442fe14136ea135baf567f", "parents": ["963c8ed70a9871b3d7808789ecd8baa130155c4c"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059402 - Update padding-block for panel items in compact mode r=desktop-theme-reviewers,mkennedy,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323314\n", "files": ["toolkit/themes/shared/design-system/src/panel.css"], "git_node": "cdb867f942afb533b64ea532a3e06de862717e61", "git_parents": ["d9a41916fb5f1df54fb9131cf372a4ae1bc0d372"], "node": "1020e417267978831619c7c95c7f5e00d52fd665", "parents": ["35945c4c75cae8691a442fe14136ea135baf567f"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069093 - Report Split View usage preference in Nimbus targeting telemetry r=nimbus-reviewers,beth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323363\n", "files": ["toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/metrics.yaml"], "git_node": "e269aeb83da7115df6a4b83ba0087625b252b9f1", "git_parents": ["cdb867f942afb533b64ea532a3e06de862717e61"], "node": "b94f9275ff8b32b323daee117de663710b463ce9", "parents": ["1020e417267978831619c7c95c7f5e00d52fd665"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067812 - Update newtab trainhop documentation and update-locales to the 2 week release cadence. r=ini\n\nFirefox has switched from a 4 week release cadence to a 2 week one, so the\n\"string stability\" window that New Tab relies on shrank from 3 weeks to 2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322510\n", "files": ["browser/extensions/newtab/docs/v2-system-addon/train_hopping.md", "browser/extensions/newtab/mach_commands.py"], "git_node": "c667ee32f3afb5a6ed84629a8eaace04578812d8", "git_parents": ["e269aeb83da7115df6a4b83ba0087625b252b9f1"], "node": "c1470efe0f663e0e58bc4b83d6eab8b7d1c8d11b", "parents": ["b94f9275ff8b32b323daee117de663710b463ce9"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065086 - Reject non string hints when constructing a lint `Issue` r=linter-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323335\n", "files": ["python/mozlint/mozlint/result.py"], "git_node": "1a3d89a6326f817de2926d12f23f5ee8def6181c", "git_parents": ["c667ee32f3afb5a6ed84629a8eaace04578812d8"], "node": "825c7fa5b805425159463770390f84a948e845d5", "parents": ["c1470efe0f663e0e58bc4b83d6eab8b7d1c8d11b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065086 - Turn the `eslint` fix object into a readable hint r=linter-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323336\n", "files": ["tools/lint/eslint/__init__.py"], "git_node": "22cc224cba9af165b8a33951f2313ada4a613e34", "git_parents": ["1a3d89a6326f817de2926d12f23f5ee8def6181c"], "node": "0f13b3c92795ce675e595683ae2d99ca275a0821", "parents": ["825c7fa5b805425159463770390f84a948e845d5"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050501 - Update \"Close\" button type in sidebar-panel-header r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323051\n", "files": ["browser/components/sidebar/sidebar-panel-header.mjs"], "git_node": "51e4be1a209cb5da5c60e29d68ed7aefe3df0a32", "git_parents": ["22cc224cba9af165b8a33951f2313ada4a613e34"], "node": "6b054ea0f707188449d82d93024f112dad209e8d", "parents": ["0f13b3c92795ce675e595683ae2d99ca275a0821"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1844148 - Provide a mechanism for using center cropping on HTML labels in privileged documents and syntactic sugar to use it with moz-label. r=emilio,mstriemer,desktop-theme-reviewers,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313578\n", "files": ["dom/html/HTMLLabelElement.cpp", "dom/html/HTMLLabelElement.h", "dom/html/test/forms/mochitest.toml", "dom/html/test/forms/test_content_label_no_center_cropping.html", "layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h", "layout/reftests/forms/label/center-cropping-ref.xhtml", "layout/reftests/forms/label/center-cropping.xhtml", "layout/reftests/forms/label/reftest.list", "layout/reftests/forms/reftest.list", "layout/tools/reftest/jar.mn", "toolkit/content/tests/widgets/test_moz_label.html", "toolkit/content/widgets/moz-label/README.stories.md", "toolkit/content/widgets/moz-label/moz-label.css", "toolkit/content/widgets/moz-label/moz-label.mjs"], "git_node": "662fdb47c3b839b81774d40f404be896946addd3", "git_parents": ["51e4be1a209cb5da5c60e29d68ed7aefe3df0a32"], "node": "8a9d941c3429856e0329bb59d81fbe935eb2b6ff", "parents": ["6b054ea0f707188449d82d93024f112dad209e8d"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069028 - Space leaks into urlbar when selecting a search engine with space key. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323296\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_keyNavigation.js"], "git_node": "dc8405094231f4cfba6d719089fd6e7777960633", "git_parents": ["662fdb47c3b839b81774d40f404be896946addd3"], "node": "24c189e6f7f20fe70fb806f8835bce6854777c07", "parents": ["8a9d941c3429856e0329bb59d81fbe935eb2b6ff"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054143 - Let Nimbus fingerprinting-protection recipes leave values unset r=gmalekpour,android-reviewers\n\nThe fingerprinting-protection and baseline-fpp features gated every value\nbehind a single flag (enabled / feat-enabled) and gave each variable a\nnon-null manifest default. A recipe that tripped the gate to experiment on\none field -- fdlibm-math, say -- therefore also wrote the manifest defaults\nover the others, silently replacing the user's settings. baseline-fpp was\nthe worse of the two, since its enabled default is true. There was no way\nfor a recipe to say \"I have no opinion about this field\".\n\nMake the per-value variables Option\u003c...\u003e defaulting to null and apply each\none independently, only when the recipe supplies it. The gate variables are\nkept so existing recipes still parse, but are no longer read.\n\nApplying the values is extracted into two small functions so the behaviour\ncan be unit tested; Core builds the whole engine and is not testable as is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323307\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/CoreFingerprintingProtectionTest.kt"], "git_node": "a5ff9e758b478df944949eae1addc1638490e62c", "git_parents": ["dc8405094231f4cfba6d719089fd6e7777960633"], "node": "3e911e29812b780649b8b3cef0ff327433c8ee6a", "parents": ["24c189e6f7f20fe70fb806f8835bce6854777c07"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068385: Don't support sparse arrays in SpreadMathMinMax r=spidermonkey-reviewers,jandem\n\nMarking the testcase --slow because it takes 7+ minutes on my laptop in an opt-debug build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323120\n", "files": ["js/src/jit-test/tests/bug2068385.js", "js/src/jit/BaselineIC.cpp", "js/src/jit/CacheIR.cpp"], "git_node": "b20bf0dd50fce8cdcee713389ba0fdf2aaa20875", "git_parents": ["a5ff9e758b478df944949eae1addc1638490e62c"], "node": "4105595cbdfbc29d876f1c41dffd6d301202f8fd", "parents": ["3e911e29812b780649b8b3cef0ff327433c8ee6a"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068956 - Update android nightly application-services version bump to a0dafe8407bda1e01477a319adc66ee3036def9a r=release-managers,pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323232\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "449a002a02e3bacaa8c59174f09978bf802c54b5", "git_parents": ["b20bf0dd50fce8cdcee713389ba0fdf2aaa20875"], "node": "7caddf1a953cbf588ac27f3c195540d4d6a6e84c", "parents": ["4105595cbdfbc29d876f1c41dffd6d301202f8fd"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add RemoteMediaManagerChild::EnsureCodecSupportFor for async HW codec support queries. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304784\n", "files": ["dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/ipc/RemoteMediaManagerChild.h"], "git_node": "947e2c1c7e70b4f493a445d2177b2b0b93178b7f", "git_parents": ["449a002a02e3bacaa8c59174f09978bf802c54b5"], "node": "39f98a7eed213aed4fd7a4bffd4e5bd13d315f8d", "parents": ["7caddf1a953cbf588ac27f3c195540d4d6a6e84c"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add cached async codec-support path for MediaCapabilities decode behind a pref. r=media-playback-reviewers,alwu\n\nAdd RemoteMediaManagerChild::EnsureCodecSupportFor-backed async support queries\n(PDMFactory::SupportsAsync / PDMFactorySupport::IsSupportedAsync) and use them\nfor the non-WebRTC MediaCapabilities decode paths, gated by the new\nmedia.mediacapabilities.codec-support-cache.enabled pref (default false). When\nthe pref is disabled the original behaviour is used: creating a decoder and\nquerying it for video, and a synchronous PDMFactorySupport query for audio.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304785\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/ipc/RemoteDecoderModule.h", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/mediacapabilities/MediaCapabilities.h", "dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/PDMFactory.h", "dom/media/platforms/PDMFactorySupport.cpp", "dom/media/platforms/PDMFactorySupport.h", "dom/media/platforms/PlatformDecoderModule.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "9529218ecca5a96cd796d6652b5ddbe8e9e508f3", "git_parents": ["947e2c1c7e70b4f493a445d2177b2b0b93178b7f"], "node": "0fe1789b2cc98d3ffa4d82c1c58a0f723cf782d1", "parents": ["39f98a7eed213aed4fd7a4bffd4e5bd13d315f8d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add moz-WPT for new media-capabilities supports-cache pref. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309551\n", "files": ["testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/meta/media-capabilities/encodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/tests/media-capabilities/decodingInfo-api-modes.any.js", "testing/web-platform/mozilla/tests/media-capabilities/encodingInfo-api-modes.any.js"], "git_node": "7409e33d0615f2d71592a569dfae8c9841d3216b", "git_parents": ["9529218ecca5a96cd796d6652b5ddbe8e9e508f3"], "node": "9c95a8c80874dd65ee9a8fecd3f852e56971e45a", "parents": ["0fe1789b2cc98d3ffa4d82c1c58a0f723cf782d1"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes ct-logs - r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323390\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/translations-models.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "750c5290c626f0b4bcf4ac431170156f32bea15d", "git_parents": ["7409e33d0615f2d71592a569dfae8c9841d3216b"], "node": "be787650d23536a3eca59c7b84bfa32108eb06fa", "parents": ["9c95a8c80874dd65ee9a8fecd3f852e56971e45a"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037297 - Add pyyaml to the test archive, r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323399\n", "files": ["python/mozbuild/mozbuild/action/test_archive.py"], "git_node": "ed02449696ba66f3dd3eb355340bdfee936ce844", "git_parents": ["750c5290c626f0b4bcf4ac431170156f32bea15d"], "node": "60f4fc6e4beb260c2eb38fc6d30bdb6b17508e33", "parents": ["be787650d23536a3eca59c7b84bfa32108eb06fa"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1713705 - Fix argument capture and path matching in the Rambler Authenticator shim r=webcompat-reviewers,twisniewski\n\nThe shim stubs ramblerIdHelper until the user attempts to log in, then opts\nin, loads the real script, and replays the calls the page made in the\nmeantime. Three defects meant it did not replay them correctly.\n\naddLoggedCall assigned an arrow function, which has no `arguments` binding of\nits own, so `arguments` resolved to the enclosing addLoggedCall(fn) call and\nevery logged entry recorded the handler's own name instead of the callback the\npage passed. Replay then called helper[fn] with that string, so none of the\npage's login and frame callbacks were ever registered on the real helper. The\nprototype in bug 1606428 comment 1 used a regular function here and was\ncorrect; the conversion to an arrow function when the shim landed lost that.\nUse rest parameters, which capture the arguments regardless of function kind.\n\nopenAuth had the same problem in a different form: `arguments` inside the\npromise callback is the resolved value of sendMessageToAddon, not openAuth's\narguments, so the page's arguments were replaced by the opt-in response.\n\nFinally, URL.pathname always begins with a slash, so the comparison added in\nbug 1909241 could never match and originalScript always fell through to the\nhardcoded fallback, leaving the protocol and hostname checks unreachable. The\nfallback happens to be the only URL the shim matches, so this was not\nobservable, but the validation was not doing anything.\n\nThis does not address the API change described in comment 0; the shim still\ntakes the pre-iframe approach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317435\n", "files": ["browser/extensions/webcompat/shims/rambler-authenticator.js"], "git_node": "c6aaeab217e259695da185ad43f60e521ab80076", "git_parents": ["ed02449696ba66f3dd3eb355340bdfee936ce844"], "node": "0503dcda093a601401fedbbf780af524c3a50fc1", "parents": ["60f4fc6e4beb260c2eb38fc6d30bdb6b17508e33"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068792 - ensure proper spacing after notices in about:preferences search r=hjones,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323128\n", "files": ["browser/themes/shared/preferences/preferences.css"], "git_node": "ee451fae4b96b5d4a848908b0e93771b66a27bab", "git_parents": ["c6aaeab217e259695da185ad43f60e521ab80076"], "node": "c9bbb0e75f8f2e587e6846307102c4844076968e", "parents": ["0503dcda093a601401fedbbf780af524c3a50fc1"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/engine-system/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-ia/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-pa-rIN/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-ru/strings.xml", "mobile/android/android-components/component