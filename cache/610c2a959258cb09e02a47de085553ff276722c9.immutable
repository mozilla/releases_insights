81f0ec29cefff37befae42d4d3bb7524d1420f", "23a81aee375cc303e3d08a4d53bdc8502edc03da", "61fc3283e0d91b2bf8b40da19cdd2631538bcf03", "ef00335a4a3047589672cae2f824a3027540be80"], "user": "agoloman@mozilla.com"}, "45277": {"changesets": [{"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067063: Record data about other profiles as part of the new-profile ping. r=niklas\" for causing marionette failures.\n\nThis reverts commit 504c4d611551757082e3d2110fe67f153894a3d6.\n", "files": ["toolkit/profile/ProfileComponents.manifest", "toolkit/profile/ProfileMetrics.sys.mjs", "toolkit/profile/metrics.yaml", "toolkit/profile/moz.build", "toolkit/profile/nsToolkitProfileService.cpp", "toolkit/profile/nsToolkitProfileService.h", "toolkit/profile/test/xpcshell/test_new_profile_ping_sent.js", "toolkit/profile/test/xpcshell/test_new_profile_ping_skipped.js", "toolkit/profile/test/xpcshell/test_profile_metrics.js", "toolkit/profile/test/xpcshell/test_profile_metrics_after_submission.js", "toolkit/profile/test/xpcshell/test_profile_metrics_excludes_current.js", "toolkit/profile/test/xpcshell/test_profile_metrics_no_compat.js", "toolkit/profile/test/xpcshell/test_profile_metrics_no_prefs.js", "toolkit/profile/test/xpcshell/test_profile_metrics_other_install.js", "toolkit/profile/test/xpcshell/test_profile_metrics_store_id_match.js", "toolkit/profile/test/xpcshell/test_profile_metrics_store_id_mismatch.js", "toolkit/profile/test/xpcshell/xpcshell.toml"], "git_node": "93ba10a0a6e4ef012b47d033748f4b7bc317f541", "git_parents": ["ef00335a4a3047589672cae2f824a3027540be80"], "node": "e33d547cac57bda94fe398f19dff28f21782ac07", "parents": ["0dee66c2f262e38fa83c6ee902cab53dc34330b3"], "tags": []}], "date": 1788904457, "git_changesets": ["93ba10a0a6e4ef012b47d033748f4b7bc317f541"], "user": "agoloman@mozilla.com"}, "45278": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2069588 - Wrap object in ReadableByteStreamControllerGetBYOBRequest r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324327\n", "files": ["dom/streams/ReadableByteStreamController.cpp", "testing/web-platform/tests/streams/readable-byte-streams/crashtests/from-cross-realm.html"], "git_node": "7e771a1a445239663a6b0d047d71fe5af7558979", "git_parents": ["ef00335a4a3047589672cae2f824a3027540be80"], "node": "d0dcf6dcba8a5f62f79398e2dd01c5ad5fecda02", "parents": ["0dee66c2f262e38fa83c6ee902cab53dc34330b3"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2021221 - Wait for the real match count result in test_findbar.xhtml, r=NeilDeakin.\n\npromiseMatchesCountResult() resolved unconditionally after five times the find\niterator timeout, whether or not the result had arrived. When that escape hatch\nwins, testFindCountUI() asserts on the count the findbar is still displaying for\nthe previous find, which is what every recorded failure of this test looks like:\n\"got\" is the previous find's value.\n\nThere is no safe number to raise that deadline to: FinderIterator scales its own\nwait by the length of the search term, so the shortest terms have the least\nslack, and on Windows a timer that is due while the main thread is idle can slip\nfar past it. Bug 1881627 is the suspected regressor for that. So the wait is now\nunbounded, and a result that never arrives fails the test as a timeout instead\nof as a wrong count.\n\nAlso drop the mac aarch64 opt skip, since bug 2030058 is the same assertion in\nthe same function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321918\n", "files": ["toolkit/content/tests/chrome/chrome-nova.toml", "toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/findbar_window.xhtml"], "git_node": "a5fb27356b921a4f65f824753b23490e52e30c55", "git_parents": ["7e771a1a445239663a6b0d047d71fe5af7558979"], "node": "754d9c9ae331b536c592eb2bdc190882e1e03885", "parents": ["d0dcf6dcba8a5f62f79398e2dd01c5ad5fecda02"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2021221 - Re-enable testFindCountUI() in debug builds, r=NeilDeakin.\n\nBug 1302110 put both testFindCountUI() calls behind !AppConstants.DEBUG in 2016\nto stop frequent intermittents. The guard covers those two calls and nothing\nelse, and the intermittent they produce is the fixed-timer race in\npromiseMatchesCountResult(), which now waits for the real match count result.\n\nRe-enabling them is the coverage that fix buys, and the debug runtime it adds\nstays well inside the test's requestLongerTimeout(2) budget.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321919\n", "files": ["toolkit/content/tests/chrome/findbar_window.xhtml"], "git_node": "c4604f8a9eebc221daab1211bc2605f663dae934", "git_parents": ["a5fb27356b921a4f65f824753b23490e52e30c55"], "node": "41eb14ee5b9bc1ce91abed8642f1088fe9c29170", "parents": ["754d9c9ae331b536c592eb2bdc190882e1e03885"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2021221 - Drop the fixed sleeps in testFindCountUI(), r=NeilDeakin.\n\nEach iteration slept for the find iterator timeout scaled by the length of the\nsearch term before typing and before every onFindAgainCommand(). By the time\npromiseMatchesCountResult() resolves, FinderIterator has already run to\ncompletion and cached its result, so there is nothing left to wait out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321921\n", "files": ["toolkit/content/tests/chrome/findbar_window.xhtml"], "git_node": "f448040f50f4bf6757053809f0d17420eda85032", "git_parents": ["c4604f8a9eebc221daab1211bc2605f663dae934"], "node": "16495b07753c7fcf4e079eefc26c0f3fa28a3c7d", "parents": ["41eb14ee5b9bc1ce91abed8642f1088fe9c29170"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025575: Part 1 - Account for the sizing border when constraining a window to its screen r=win-reviewers,gstoll\n\nnsWindow::OnDPIChanged() constrains the rect suggested by WM_DPICHANGED to the\ndestination screen's work area. That check prevents the case where a large\nwindow's screen goes away (monitor unplugged, resume from suspend) but the window\nends up overflowing the new screen in every direction.\n\nThe existing check is too strict. Windows draws a resizable window's sizing\nborder outside the window's visible edges, so it is a window's *visible* edges\nwhich get aligned with the work area, whether by the shell when snapping a\nwindow or by a user dragging one against a screen edge. Either way the window\nrect itself overhangs the work area by the width of that border (8px at 125%\ndpi), and the window's height exceeds the work area's by as much again. Clamping\nthat away moves the window inwards and shrinks it, which for a snapped window\nleaves it overlapping the neighbouring snap zone.\n\nThis patch tolerates an overhang of one sizing border before deciding a window\ndoes not fit, so that only windows which really are too large get repositioned\nor shrunk. The tolerated overhang region is invisible.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320266\n", "files": ["widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": "9f22d0c1040ddd165733635f0030a699bb0ad7fa", "git_parents": ["f448040f50f4bf6757053809f0d17420eda85032"], "node": "ef669999206732f917208130fc50a73114564e1b", "parents": ["16495b07753c7fcf4e079eefc26c0f3fa28a3c7d"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025575: Part 2 - Use widget device pixels instead of converted CSS pixels in session saver. r=jswinarton\n\nSessionStore stores window positions in desktop pixels rather than CSS pixels,\nprecisely so that they survive multi-monitor, mixed-DPI setups.\nReads/writes were going through CSS pixels anyway though, and both lost\nprecision doing so.  Instead, this patch asks the widget for its position and\nmoves the widget directly, via nsIBaseWindow, which deals in device and desktop\npixels directly.\n\nbrowser_1446343-windowsize.js compared the saved position against\nwindow.screenX/Y, so it only held where one device pixel is one CSS pixel; it\nwas already failing 6 of its 15 checks on a 175% display setup before this\nchange (saved = 42.35 vs window.screenX = 24). It now asks the widget, too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320267\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_1446343-windowsize.js", "browser/components/sessionstore/test/browser_window_position_precision.js"], "git_node": "084cc7cc86fbb9aa02dd285505f89474157ab13b", "git_parents": ["9f22d0c1040ddd165733635f0030a699bb0ad7fa"], "node": "958193ce97f1e6a6c9b206d96d2fc75ac8194454", "parents": ["ef669999206732f917208130fc50a73114564e1b"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025575: Part 3 - Allow for the sizing border on every edge in ConstrainPosition r=win-reviewers,gstoll\n\nBug 1866583 caused nsWindow::ConstrainPosition to leave a window alone if it\nlooked like it had been snapped to the right of the screen, since a snapped\nwindow deliberately overhangs the work area and pulling it back in leaves it\noverlapping the neighbouring snap zone. That check recognised the snapped-right\ncase only -- it requires the window to be flush with the top of the work area\nand to overhang the right and bottom by the same amount -- so a window snapped\nto the *left* still gets dragged inwards by the width of its border, which is\nthe case reported in this bug.\n\nRather than extend the hack, this patch addresses the direct cause of the\noverhang: Windows draws a resizable window's sizing border outside the window's\nvisible edges, and the shell aligns the *visible* edges with the work area.\nInflating the constraint rect by that border therefore covers snapping to any\nedge, and needs no assumption about which edge is involved or about how the\nshell computed the size. Windows which are genuinely too large, or genuinely\noffscreen, are still moved back as before -- the added tolerance is only ever\nthe width of a border (that isn't drawn).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320268\n", "files": ["widget/windows/nsWindow.cpp"], "git_node": "f36465e97aff5b03936b70c92735d2ec7b597a80", "git_parents": ["084cc7cc86fbb9aa02dd285505f89474157ab13b"], "node": "8f223000c271e1c183115c1f7d2469e2d5dee648", "parents": ["958193ce97f1e6a6c9b206d96d2fc75ac8194454"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070202 - Don't adopt a No-Vary-Search cache candidate that would have to be replaced. r=necko-reviewers,valentin\n\nFound while investigating Bug 1970910, a different bug with the same\nsymptom: a specific cached resource stops being usable until the cache is\ncleared.\n\n`CacheStorageService::AddStorageEntry` computes `entryKey` from the URL\nbeing opened. On an exact-key miss it consults the No-Vary-Search\nsecondary index, and a matching candidate is deliberately an entry stored\nunder a *different* URL. `entryKey` is not updated, because the new\nentry, if one is created, has to land under our own key.\n\nFurther down, an entry that already exists is replaced when the caller\nwants memory-only storage but the entry is persistent:\n\n    if (MOZ_UNLIKELY(!aWriteToDisk) && MOZ_LIKELY(entry-\u003eIsUsingDisk())) {\n      replace = true;\n    }\n    ...\n    entries-\u003eRemove(entryKey);\n    entry-\u003eDoomAlreadyRemoved();\n\nFor a No-Vary-Search candidate both statements are wrong. `Remove(entryKey)`\nremoves our key, which is not in the table - we just missed on it - so it\ndoes nothing, while `DoomAlreadyRemoved()` dooms the candidate. Unlike\n`PurgeAndDoom()` it does not unlink the entry itself, on the assumption the\ncaller already did.\n\nSo a load of `/app.js?v=2` that may not be persisted deletes the disk\nentry of `/app.js?v=1` and leaves it doomed inside `sGlobalEntryTables`\nand inside the secondary index. For the rest of the session every open of\n`/app.js?v=1`, and of every sibling the policy covers, resolves to that\nentry and gets `NS_ERROR_CACHE_KEY_NOT_FOUND` from\n`CacheEntry::InvokeAvailableCallback`, so the resource can neither be\nserved from cache nor stored again. Clearing the cache is the only\nrecovery, because `DoomStorageEntries` is the one place that scrubs the\nindex. Reaching it needs `INHIBIT_PERSISTENT_CACHING` at open time, which\ncallers set directly and which is inherited across redirects, hence the\nintermittency.\n\nA candidate found through the index can only ever be reused as it is, so\nskip any that would have to be replaced instead. `OPEN_TRUNCATE` was\nalready excluded from the lookup, which leaves the memory-only case as\nthe only route into that block, and an assertion pins the invariant that\n`entryKey` is the key `entry` is stored under.\n\nThis is also consistent with the exact-key behaviour: there too a\npersistent entry is not served to a load that may not persist. It is just\nnot destroyed on the way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324317\n", "files": ["netwerk/cache2/CacheStorageService.cpp", "netwerk/test/unit/test_no_vary_search_memory_only.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "bae17483dda33b7f0398abb1a201d7726a70875a", "git_parents": ["f36465e97aff5b03936b70c92735d2ec7b597a80"], "node": "5d1604b29c256c8fa3bff0d836c7f2cb1da190ba", "parents": ["8f223000c271e1c183115c1f7d2469e2d5dee648"], "tags": []}, {"author": "Gustavo Rodrigues \u003cgustavokrm@gmail.com\u003e", "branch": "default", "desc": "Bug 2051536 - Remove dead rv assignment in OpaqueResponseUtils.h r=necko-reviewers,leggert,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324315\n", "files": ["netwerk/protocol/http/OpaqueResponseUtils.h"], "git_node": "4e737be215efa89e45d852dcff8fea428056b8bc", "git_parents": ["bae17483dda33b7f0398abb1a201d7726a70875a"], "node": "43f7b82f305d0e2033c50da92caf1ebf1921fd7b", "parents": ["5d1604b29c256c8fa3bff0d836c7f2cb1da190ba"], "tags": []}, {"author": "Diego Ciudad Real Escalante \u003cdiegociudadreale@gmail.com\u003e", "branch": "default", "desc": "Bug 2066806 - Remove red from passing test case in position-try-order-include-base.html. r=TYLin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323850\n", "files": ["testing/web-platform/tests/css/css-anchor-position/position-try-order-include-base-ref.html", "testing/web-platform/tests/css/css-anchor-position/position-try-order-include-base.html"], "git_node": "6c61a730a8d5c80f5adf2ed4254653c798ff0be4", "git_parents": ["4e737be215efa89e45d852dcff8fea428056b8bc"], "node": "4d49f2e5bfdb00f3ff45bd2bfa0e5a3c5ed10751", "parents": ["43f7b82f305d0e2033c50da92caf1ebf1921fd7b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070242 - Stop forcing bfd for the Android x86_64 asan fuzzing build. r=firefox-build-system-reviewers,sergesanspaille\n\nBug 1855106 switched this build to bfd to hide libclang_rt.asan's undefined __extendsftf2/__extenddftf2\nand C++ exception ABI symbols when linking Rust programs (rust-lang/rust#109717). clang 23's Android\ndriver passes --pack-dyn-relocs=android, which bfd does not accept. Switch back to lld, which already\nrejects those same undefined symbols, and keep them tolerated with --allow-shlib-undefined instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324351\n", "files": ["mobile/android/config/mozconfigs/android-x86_64/nightly-fuzzing-asan"], "git_node": "c62d4537b4b192d8c427d6e1ff858240d2572177", "git_parents": ["6c61a730a8d5c80f5adf2ed4254653c798ff0be4"], "node": "dc84efb7363290d6f6995941dc3d819ce677058d", "parents": ["4d49f2e5bfdb00f3ff45bd2bfa0e5a3c5ed10751"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070223 - [devtools] MDN compatibility 157 r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324348\n", "files": ["devtools/shared/compatibility/dataset/css-properties.json"], "git_node": "90611edea37259b997979368bd4c23f4f1760dd0", "git_parents": ["c62d4537b4b192d8c427d6e1ff858240d2572177"], "node": "dfcf8fee29541aa8b993eba924ec5cab8c974b79", "parents": ["dc84efb7363290d6f6995941dc3d819ce677058d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069885 - Clean up --chrome-block-radius usage. r=desktop-theme-reviewers,tabbrowser-reviewers,kcochrane\n\nThe only user that cares about the current value is the statusbar which\nwants not to get clipped.\n\nThe splitview user was not using the radius it wanted, since we now use\n--border-radius-medium for nova as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324068\n", "files": ["browser/base/content/test/maximized/browser_maximized_decoration.js", "browser/themes/shared/browser-shared.css", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "a897ff208df61ea2e49920566495b13ec5757c8a", "git_parents": ["90611edea37259b997979368bd4c23f4f1760dd0"], "node": "9b724fbc5fbc7de217ffe8989bfb7c5718f00013", "parents": ["dfcf8fee29541aa8b993eba924ec5cab8c974b79"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070006 - Remove redundant #ifdef for privacy metrics pref r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324124\n", "files": ["browser/app/profile/firefox.js"], "git_node": "c7e0d3ad14d95fd60e09207a55f4afc18371032c", "git_parents": ["a897ff208df61ea2e49920566495b13ec5757c8a"], "node": "ce2a75fcc805e38afdc6cdc17d171f28dba1a6fa", "parents": ["9b724fbc5fbc7de217ffe8989bfb7c5718f00013"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994840 - Fix a race when accepting the cert exception in browser_mixed_content_cert_override r=emz\n\n#exceptionDialogButton is enabled from load and only gets disabled once the\nadvanced panel starts revealing, so waiting on it returned before the panel\nexisted, and a lost click on #advancedButton left the test clicking into a\nhidden panel until timeout. Wait on the panel and the button together, and\nscroll each target into view and round-trip a mousemove through hit testing\nbefore clicking it.\n\nAlso share one closeIdentityPopup() that hides through gIdentityHandler, so a\npopup caught mid-open gets cancelled instead of staying up with no popuphidden\ncoming.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317245\n", "files": ["browser/base/content/test/siteIdentity/browser_deprecatedTLSVersions.js", "browser/base/content/test/siteIdentity/browser_mixed_content_cert_override.js", "browser/base/content/test/siteIdentity/head.js"], "git_node": "00aefd449ec313ef2ef264d1bddaa0efdd6cf7e1", "git_parents": ["c7e0d3ad14d95fd60e09207a55f4afc18371032c"], "node": "d501364355f5e847ad46f19235b17561fb14f05b", "parents": ["ce2a75fcc805e38afdc6cdc17d171f28dba1a6fa"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069467 - Fix clang 23 unused warnings in xpcom. r=xpcom-reviewers,mccr8\n\nTestTArray2.cpp's is_heap helper has no callers, and nsTraceRefcnt.cpp's gDumpedStatistics only exists\nfor an assertion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323875\n", "files": ["xpcom/base/nsTraceRefcnt.cpp", "xpcom/tests/gtest/TestTArray2.cpp"], "git_node": "6367311ab58a9e5f1edb3e7af0558c6b596d8379", "git_parents": ["00aefd449ec313ef2ef264d1bddaa0efdd6cf7e1"], "node": "db1fa9cd6380ef30fb549f23a6d2cf83d47689b9", "parents": ["d501364355f5e847ad46f19235b17561fb14f05b"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068222 - Add a Nimbus feature for the sync day 1 pairing prompt. r=android-reviewers,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324032\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "be3fa367f6f14592d012ff168acff006a57cb6c7", "git_parents": ["6367311ab58a9e5f1edb3e7af0558c6b596d8379"], "node": "e47ed1381f7dcebf972305e6757be6c07f96ce6e", "parents": ["db1fa9cd6380ef30fb549f23a6d2cf83d47689b9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069469 - Remove the unused STLStringToCFStringWithEncodingsT helper. r=ipc-reviewers,mccr8\n\nBug 913953 removed its callers in 2013, and clang 23.1.0 now reports unused internal-linkage\ntemplates under -Wall.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323877\n", "files": ["ipc/chromium/src/base/sys_string_conversions_mac.mm"], "git_node": "a6f08c479cdc4ee8028a9e26bb9246b2aac0003e", "git_parents": ["be3fa367f6f14592d012ff168acff006a57cb6c7"], "node": "9e8889b3ef9580d6135d582e4b141db8d4f24025", "parents": ["e47ed1381f7dcebf972305e6757be6c07f96ce6e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069469 - Turn network.negotiate-auth.using-native-gsslib into a macOS-only StaticPref. r=necko-reviewers,valentin\n\nOnly the macOS Kerberos ticket check reads it, and gssInit only looks up KLCacheHasValidTickets on that path,\nso the later check can key off the function pointer instead of a separate flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323878\n", "files": ["extensions/auth/nsAuthGSSAPI.cpp", "modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js"], "git_node": "220feefd4a29491711cae5092919f2f43f2bf855", "git_parents": ["a6f08c479cdc4ee8028a9e26bb9246b2aac0003e"], "node": "a2c16b6e8fa19a7aefac016eaab745744e632354", "parents": ["9e8889b3ef9580d6135d582e4b141db8d4f24025"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069469 - Only define sCanReadHostVerificationFiles in official builds. r=media-playback-reviewers,padenot\n\nOnly the MOZILLA_OFFICIAL host verification path reads it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323879\n", "files": ["media/gmp-clearkey/0.1/gmp-clearkey.cpp"], "git_node": "faf7727b923530cc219f299cbdbaaf9c246fc925", "git_parents": ["220feefd4a29491711cae5092919f2f43f2bf855"], "node": "52d1b9a9d01de93e051cb1f57a3d8307c9584352", "parents": ["a2c16b6e8fa19a7aefac016eaab745744e632354"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069469 - Drop the unused libcanberra proplist bindings. r=gtk-reviewers,emilio\n\nca_context_set_driver is only needed when ALSA or sndio support is compiled in, so guard it the same way\nas its caller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323880\n", "files": ["widget/gtk/nsSound.cpp"], "git_node": "7ce79ba4f90d32f9adbe42467448e35e21738491", "git_parents": ["faf7727b923530cc219f299cbdbaaf9c246fc925"], "node": "dd362b2bcfe1c6bd89501873c14e991379e8c021", "parents": ["52d1b9a9d01de93e051cb1f57a3d8307c9584352"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069469 - Remove Breakpad's unused LookupSymbol and breakpad_nlist. r=afranchuk\n\nUpstream still calls LookupSymbol from GetDyldAllImageInfosPointer, but Bug 1814852 replaced that code\nhere, leaving the template and the nlist reader it wrapped without callers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323881\n", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/breakpad_nlist_64.cc", "toolkit/crashreporter/breakpad-client/mac/handler/breakpad_nlist_64.h", "toolkit/crashreporter/breakpad-client/mac/handler/dynamic_images.cc", "toolkit/crashreporter/breakpad-client/mac/handler/moz.build"], "git_node": "3a990ebd786eba2ddfbc0810e8f5af7457a23f54", "git_parents": ["7ce79ba4f90d32f9adbe42467448e35e21738491"], "node": "163272c209526c538ae23edac5bf4bace112d41d", "parents": ["dd362b2bcfe1c6bd89501873c14e991379e8c021"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069469 - Only define gIsBackgroundTask when Output() can read it. r=win-reviewers,gstoll\n\nConsole builds never read it because MOZ_WINCONSOLE takes precedence in Output().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323882\n", "files": ["browser/app/nsBrowserApp.cpp"], "git_node": "174eb0053a0b483d9119f175a847694362ed5dbd", "git_parents": ["3a990ebd786eba2ddfbc0810e8f5af7457a23f54"], "node": "59c54100e6cb21277a6b551e98ea8d8a4903f3ac", "parents": ["163272c209526c538ae23edac5bf4bace112d41d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065772 - Add a page on the tab event vocabulary. r=kcochrane,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324302\n", "files": ["browser/components/tabbrowser/docs/index.md", "browser/components/tabbrowser/docs/tab-events.md"], "git_node": "c71dcdf924edaaad57d138353201de838827dc32", "git_parents": ["174eb0053a0b483d9119f175a847694362ed5dbd"], "node": "a6d54bafb3e52b547cf6a7c6979f7fe0e1bfc11a", "parents": ["59c54100e6cb21277a6b551e98ea8d8a4903f3ac"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070195 - Add a page on lazy tabs and lazy browsers. r=kcochrane,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324318\n", "files": ["browser/components/tabbrowser/docs/index.md", "browser/components/tabbrowser/docs/lazy-browsers.md", "browser/components/tabbrowser/docs/opening-tabs.md", "browser/components/tabbrowser/docs/tab-events.md", "browser/components/tabbrowser/docs/tab-unloading.md"], "git_node": "076582269f45017d93163a636a9236c7b359800d", "git_parents": ["c71dcdf924edaaad57d138353201de838827dc32"], "node": "a9de09ebbd037cc7ca2515f7b97878cf1c4688c7", "parents": ["a6d54bafb3e52b547cf6a7c6979f7fe0e1bfc11a"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069972 - Part 1: Generate ::before and ::after for \u003cselect\u003e with base appearance. r=keithamus\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324291\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-grid-before-after.html.ini"], "git_node": "20010a3a631bfa73889d3b56c196461095eaa898", "git_parents": ["076582269f45017d93163a636a9236c7b359800d"], "node": "b37df7cd0643ea659754a5fb60e337ecada541d7", "parents": ["a9de09ebbd037cc7ca2515f7b97878cf1c4688c7"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069972 - Part 2: Blockify ::checkmark inside flex and grid options. r=keithamus\n\nAlso fix the reference of select-base-appearance-ordering.html, which now\npasses: the select is border-box, the reference div wasn't.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324292\n", "files": ["servo/components/style/gecko/pseudo_elements.toml", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/select-base-appearance-ordering.html.ini", "testing/web-platform/tests/html/se