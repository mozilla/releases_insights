markdown_it_py/markdown_it/rules_block/table.py", "third_party/python/markdown_it_py/markdown_it/rules_core/__init__.py", "third_party/python/markdown_it_py/markdown_it/rules_core/normalize.py", "third_party/python/markdown_it_py/markdown_it/rules_core/replacements.py", "third_party/python/markdown_it_py/markdown_it/rules_core/smartquotes.py", "third_party/python/markdown_it_py/markdown_it/rules_core/text_join.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/__init__.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/autolink.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/balance_pairs.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/escape.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/fragments_join.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/image.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/link.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/linkify.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/newline.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/state_inline.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/strikethrough.py", "third_party/python/markdown_it_py/markdown_it/rules_inline/text.py", "third_party/python/markdown_it_py/markdown_it/token.py", "third_party/python/markdown_it_py/markdown_it/tree.py", "third_party/python/markdown_it_py/markdown_it/utils.py", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/LICENSE", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/LICENSE.markdown-it", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/METADATA", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/RECORD", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/WHEEL", "third_party/python/markdown_it_py/markdown_it_py-3.0.0.dist-info/entry_points.txt", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/METADATA", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/RECORD", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/WHEEL", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/entry_points.txt", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/licenses/LICENSE", "third_party/python/markdown_it_py/markdown_it_py-4.2.0.dist-info/licenses/LICENSE.markdown-it", "third_party/python/pyproject.toml", "third_party/python/requirements.txt", "third_party/python/uv.lock", "third_party/python/uv.lock.hash"], "git_node": "54a1310e36e4c5d969b86087d772b285e0bae4cf", "git_parents": ["4104747738baada761d06f59b81df8c3c6c2f0b6"], "node": "b605a56ef86dcfe203e15ffd90d26a4e6c1d3da5", "parents": ["5db7c72ad554789b92fb5a27e46c7af4c8a5b50a"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - Upgrade sphinx to 9.0.4 and related dependencies r=firefox-source-docs-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277906\n", "files": ["docs/config.yml", "python/sites/docs.txt"], "git_node": "b852c7e3fe373ea088b816ad79c246497762fa7c", "git_parents": ["54a1310e36e4c5d969b86087d772b285e0bae4cf"], "node": "857ef7b3a6f894dea04e6b3ad0938599841a8e9b", "parents": ["b605a56ef86dcfe203e15ffd90d26a4e6c1d3da5"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - doc: make mermaid diagrams legible after the sphinxcontrib-mermaid upgrade r=firefox-source-docs-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316479\n", "files": ["docs/conf.py", "docs/contributing/how_to_submit_a_patch.md"], "git_node": "a808f679f11afe9af8fb8010476e5a846e309e89", "git_parents": ["b852c7e3fe373ea088b816ad79c246497762fa7c"], "node": "f6778f90c4bb2f69f9886fbafa3236b1fc114b5f", "parents": ["857ef7b3a6f894dea04e6b3ad0938599841a8e9b"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - doc: fix JSDoc markup rejected by myst-parser 5 r=firefox-source-docs-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316480\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/PanelMultiView.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "testing/mochitest/tests/SimpleTest/EventUtils.js", "testing/modules/Assert.sys.mjs", "toolkit/actors/PopupAndRedirectBlockingParent.sys.mjs", "toolkit/components/extensions/ConduitsParent.sys.mjs", "toolkit/components/extensions/ExtensionCommon.sys.mjs", "toolkit/components/extensions/ExtensionStorage.sys.mjs", "toolkit/components/extensions/NativeMessaging.sys.mjs", "toolkit/components/extensions/Schemas.sys.mjs", "toolkit/components/extensions/parent/ext-tabs-base.js", "toolkit/components/ml/content/backends/ONNXPipeline.mjs"], "git_node": "74287815dbb2e0d59cdeed108b4c0eefb88141dc", "git_parents": ["a808f679f11afe9af8fb8010476e5a846e309e89"], "node": "fd13a137dd67ac4920c99e59fb2a78a0826e8147", "parents": ["f6778f90c4bb2f69f9886fbafa3236b1fc114b5f"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1983296 - Unship privacy.globalprivacycontrol.functionality.enabled r=necko-reviewers,geckoview-reviewers,webidl,dom-worker-reviewers,mstriemer,smaug,valentin,edenchuang,tcampbell\n\nThis pref gated the availability of GPC as a whole, acting as a third\n\"undecided\" state that left navigator.globalPrivacyControl undefined and\nsuppressed the Sec-GPC header. It has been set to true in firefox.js since\nGPC shipped, so remove it and assume it to be true everywhere.\n\nRemoved from StaticPrefList.yaml, from every line that set it (firefox.js,\nGeckoRuntimeSettings, the about:preferences settings config, and the test\npref environments), and from every use: the three C++ conjunctions in\nnsHttpChannel/Navigator/WorkerNavigator, the [Pref=] annotation on the\nGlobalPrivacyControl WebIDL mixin, the StartupTelemetry check and its\nobserver, and the visibility gate on the gpcEnabled setting.\n\nThis is a no-op for desktop Firefox and for Fenix/Focus, which reach\nsetGlobalPrivacyControl() at startup and committed the pref to true there.\nThe one observable change is for GeckoView embedders that never call\nsetGlobalPrivacyControl(): navigator.globalPrivacyControl becomes false\nrather than undefined. No Sec-GPC header is sent either way, since both\nprivacy.globalprivacycontrol.enabled and .pbmode.enabled default to false.\n\nThere is no GeckoView API change: the removed Pref field is package-private\nand api.txt is untouched.\n\nThe browser_privacy_gpc.js task asserting the section is hidden when the\nfeature pref is disabled is removed rather than rewritten, since its premise\nno longer exists; nonTechnicalPrivacyGroup is now unconditionally visible,\nwhich matches its behaviour with the pref set to true.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317979\n", "files": ["browser/app/profile/firefox.js", "browser/components/StartupTelemetry.sys.mjs", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_gpc.js", "docs/_addons/etp_matrix.py", "dom/base/Navigator.cpp", "dom/security/test/general/browser_test_gpc_privateBrowsingMode.js", "dom/security/test/general/test_gpc.html", "dom/webidl/Navigator.webidl", "dom/workers/WorkerNavigator.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/RuntimeSettingsDefaultsTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/RuntimeSettingsTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntimeSettings.java", "modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "5599bbb01aa217b4b67aff1566ba9fa4b39a681f", "git_parents": ["74287815dbb2e0d59cdeed108b4c0eefb88141dc"], "node": "60123aaff7bbafe4d88bafc9885b9cd3e8a37c3b", "parents": ["fd13a137dd67ac4920c99e59fb2a78a0826e8147"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2070131 - Add a built scene inspector to the WebRender debugger and wrshell. r=gfx-reviewers,gw\n\nAdd a \"Scene\" panel to wrshell (and a get-scene CLI command) that shows the\npicture / primitive tree of the built scene held by the render backend.\nHovering a primitive highlights it in the rendered frame. Clicking a\nprimitive shows its details in a side panel. A checkbox next to each\nprimitive disables it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324251\n", "files": ["gfx/wr/webrender/src/debugger.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/scene_debug.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/webrender_api/src/debugger.rs", "gfx/wr/wrshell/README.md", "gfx/wr/wrshell/src/debug_commands.rs", "gfx/wr/wrshell/src/gui/mod.rs", "gfx/wr/wrshell/src/gui/scene_tree.rs"], "git_node": "2d3d3763feffe4ec88f46150b0377d5557f96326", "git_parents": ["5599bbb01aa217b4b67aff1566ba9fa4b39a681f"], "node": "3c9b464514b32b4ac25f1e07952e7128a33a1094", "parents": ["60123aaff7bbafe4d88bafc9885b9cd3e8a37c3b"], "tags": []}, {"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2070131 - Add a context menu to the wrshell scene tree. r=gfx-reviewers,bradwerth\n\nRight-clicking a node offers bulk actions on the disabled set: focus on the\nnode (disable everything except the node, its ancestors and its\ndescendants), disable or enable a picture's children, and enable all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324301\n", "files": ["gfx/wr/wrshell/README.md", "gfx/wr/wrshell/src/gui/scene_tree.rs"], "git_node": "2e703e325cbf06715d939361e59bee4a97041599", "git_parents": ["2d3d3763feffe4ec88f46150b0377d5557f96326"], "node": "dfc8e47ddf70169cdc6e9c73e74d2493ea0a9e72", "parents": ["3c9b464514b32b4ac25f1e07952e7128a33a1094"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1883563 - Remove the webgl.can-lose-context-in-foreground pref r=gfx-reviewers,nical\n\nAmend: Remove mCanLoseContextInForeground too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322386\n", "files": ["dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextValidate.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "90dd6ce8f3720e3054aab3d454ba7456914fe5cc", "git_parents": ["2e703e325cbf06715d939361e59bee4a97041599"], "node": "71bae4e159a7a8d54f3ccb682686268481eae20e", "parents": ["dfc8e47ddf70169cdc6e9c73e74d2493ea0a9e72"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066051 - Part 1: Report the shutdown phase from the content classifier's blocker state r=emz\n\nGetState() returned nullptr, so every AsyncShutdownTimeout annotation for this\nblocker reads \"state\":\"(none)\" and says nothing about how far the teardown\ngot.\n\nReport the init phase and the live engine count, so the annotation says which\nhalf of BlockShutdown was still outstanding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321356\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp"], "git_node": "9aac0ac48f36b82d53024d7bc708d9bcd5232713", "git_parents": ["90dd6ce8f3720e3054aab3d454ba7456914fe5cc"], "node": "8164a74c9af95c4ed261e986bf90e8823c5ea0ba", "parents": ["71bae4e159a7a8d54f3ccb682686268481eae20e"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066051 - Part 2: Don't wait for the build queue to drain before lifting the shutdown blocker r=emz\n\nThis patch makes the ContentClassifierService::BlockShutdown() to clear\nthe blocker synchronizely, which resolves the shutdown hangs.\n\nNothing on the background queue needs to finish before shutdown proceeds.\nEvery closure re-checks mInitPhase under mLock before touching service state and\nbails once the phase leaves InitSucceeded. So we can drop the fence and lift\nthe blocker synchronously.\n\nAlso set mInitPhase before ShutdownRSClient() rather than after it.\nShutdownRSClient cleared the engine containers under its own lock and then\nreleased it, and the phase was only set under a second acquisition, so a build\nclosure already waiting on mLock could pass its gate in that window and\nrepopulate everything that had just been cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321357\n", "files": ["toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/ContentClassifierService.h", "toolkit/components/content-classifier/moz.build", "toolkit/components/content-classifier/test/unit/test_shutdown_blocker.js", "toolkit/components/content-classifier/test/unit/xpcshell.toml"], "git_node": "a457bcbce1536ec1c4bf48e1588ef30e3dc2df44", "git_parents": ["9aac0ac48f36b82d53024d7bc708d9bcd5232713"], "node": "cdedf80d8f64f01d7355604ee49aa01f3035b59a", "parents": ["8164a74c9af95c4ed261e986bf90e8823c5ea0ba"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1922677 - Rate limit every navigation. r=smaug,zcorpan,firefox-style-system-reviewers,emilio\" for causing crashtest failures\n\nThis reverts commit cdf102b487df4a0d44d72c738d00003a52cca649.\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h", "docshell/base/nsIDocShell.idl", "docshell/test/navigation/mochitest.toml", "docshell/test/navigation/test_rate_limit_location_change.html", "docshell/test/navigation/test_rate_limit_same_document_navigation.html", "dom/base/Location.cpp", "dom/base/nsHistory.cpp", "dom/base/test/mochitest-bug1.toml", "dom/base/test/mochitest-bug2.toml", "dom/html/test/mochitest-bug1.toml", "dom/html/test/mochitest-bug2.toml", "dom/locales/en-US/chrome/dom/dom.properties", "dom/tests/mochitest/dom-level1-core/mochitest-node.toml", "dom/tests/mochitest/dom-level1-core/mochitest.toml", "dom/tests/mochitest/dom-level2-core/mochitest.toml", "dom/tests/mochitest/dom-level2-html/mochitest-element.toml", "dom/tests/mochitest/dom-level2-html/mochitest-form.toml", "dom/tests/mochitest/dom-level2-html/mochitest-table.toml", "dom/tests/mochitest/dom-level2-html/mochitest.toml", "editor/libeditor/tests/mochitest.toml", "layout/style/test/mochitest.toml", "modules/libpref/init/StaticPrefList.yaml", "parser/htmlparser/tests/mochitest/mochitest.toml", "testing/web-platform/meta/html/browsers/browsing-the-web/navigating-across-documents/navigate_too_many_calls.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_go_too_many_calls.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_pushstate_too_many_calls.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_pushstate_too_many_calls_ordering.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_replacestate_too_many_calls.optional.html.ini", "testing/web-platform/meta/html/browsers/history/the-history-interface/history_replacestate_too_many_calls_ordering.optional.html.ini"], "git_node": "1de8c7f1659442a75e9bf624cbe49aa538eaf15e", "git_parents": ["a457bcbce1536ec1c4bf48e1588ef30e3dc2df44"], "node": "851c97e93cb169791366d99f5182574ef79b7ea8", "parents": ["cdedf80d8f64f01d7355604ee49aa01f3035b59a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044285 - Reuse existing Settings tab from the credit card doorhanger options link. r=mtigley,credential-management-reviewers\" for causing mochitest failures @ browser_creditCard_doorhanger_options_link.js\n\nThis reverts commit be363812e1b23d32fd22e8875d8317cd4d031d02.\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_options_link.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "d096b65a0a874584d416ed2fdab759af7bfb8869", "git_parents": ["1de8c7f1659442a75e9bf624cbe49aa538eaf15e"], "node": "16b0e482ed318a449f325aa155ae73c05ff65781", "parents": ["851c97e93cb169791366d99f5182574ef79b7ea8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065180 - Factor out ASR assertion. r=tnikkel,layout-reviewers,dshin\n\nAs requested in D324111, but probably reviewable independently.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324336\n", "files": ["layout/generic/ViewportFrame.cpp", "layout/generic/nsIFrame.cpp", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h"], "git_node": "c92002cf00dff8004b026b37cef476cfd4e144c1", "git_parents": ["d096b65a0a874584d416ed2fdab759af7bfb8869"], "node": "96bba8579c32a68612d181f442251528fcc641e3", "parents": ["16b0e482ed318a449f325aa155ae73c05ff65781"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069240 - Rename shippable-l10n-signing to l10n-signing and let it sign non-shippable repacks. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nRename the shippable-l10n-signing kind (and its transform module) to\nl10n-signing, and make it depend on both the shippable-l10n and l10n kinds\nso that the non-shippable l10n repacks (built on cheaper opt builds with the\non-change locale set) get gpg- and widevine-signed too. This gives a fast\niteration path for signing changes without waiting on a shippable build.\n\nThe shippable l10n kind is chunked and carries chunk_locales; the\nnon-shippable l10n kind is unchunked, so the signing transform falls back to\nall_locales. The only-for-attributes filter is dropped: it was already a no-op\nfor the shippable-l10n set.\n\nThe shippable/nightly release graph is unchanged; the only delta is the four\nnew opt l10n-signing tasks (linux64, linux64-aarch64, win32, win64).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323512\n", "files": ["taskcluster/docs/kinds.md", "taskcluster/docs/signing.md", "taskcluster/gecko_taskgraph/transforms/beetmover_repackage.py", "taskcluster/gecko_taskgraph/transforms/beetmover_repackage_rpm.py", "taskcluster/gecko_taskgraph/transforms/l10n_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing.py", "taskcluster/gecko_taskgraph/transforms/shippable_l10n_signing.py", "taskcluster/gecko_taskgraph/transforms/update_integrity.py", "taskcluster/kinds/beetmover-repackage-rpm/kind.yml", "taskcluster/kinds/beetmover-repackage/kind.yml", "taskcluster/kinds/l10n-signing/kind.yml", "taskcluster/kinds/release-beetmover-signed-langpacks/kind.yml", "taskcluster/kinds/release-eme-free-repack/kind.yml", "taskcluster/kinds/release-partner-repack/kind.yml", "taskcluster/kinds/repackage-deb-l10n/kind.yml", "taskcluster/kinds/repackage-flatpak/kind.yml", "taskcluster/kinds/repackage-l10n/kind.yml", "taskcluster/kinds/repackage-rpm/kind.yml", "taskcluster/kinds/repackage-shippable-l10n-msix/kind.yml", "taskcluster/kinds/shippable-l10n-mac-notarization/kind.yml", "taskcluster/kinds/shippable-l10n-mac-signing/kind.yml", "taskcluster/kinds/shippable-l10n-signing/kind.yml", "taskcluster/kinds/test-update-integrity/kind.yml"], "git_node": "7e409f02294f8db77457bbbfac6307a39b97e0d6", "git_parents": ["c92002cf00dff8004b026b37cef476cfd4e144c1"], "node": "5fe91daf38e823c13fd32159bab2ee7b7b00d702", "parents": ["96bba8579c32a68612d181f442251528fcc641e3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069639 - Update cc crate. r=firefox-build-system-reviewers,supply-chain-reviewers,sergesanspaille\n\nThis allows to remove the shlex patch from the previous commit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323854\n", "files": ["Cargo.lock", "Cargo.toml", "build/rust/shlex/Cargo.toml", "build/rust/shlex/lib.rs", "supply-chain/audits.toml", "supply-chain/imports.lock", "third_party/rust/cc/.cargo-checksum.json", "third_party/rust/cc/.cargo_vcs_info.json", "third_party/rust/cc/.tombi.toml", "third_party/rust/cc/CHANGELOG.md", "third_party/rust/cc/Cargo.lock", "third_party/rust/cc/Cargo.toml", "third_party/rust/cc/Cargo.toml.orig", "third_party/rust/cc/README.md", "third_party/rust/cc/clippy.toml", "third_party/rust/cc/src/command_helpers.rs", "third_party/rust/cc/src/flags.rs", "third_party/rust/cc/src/lib.rs", "third_party/rust/cc/src/parallel/command_runner.rs", "third_party/rust/cc/src/parallel/job_token.rs", "third_party/rust/cc/src/parallel/mod.rs", "third_party/rust/cc/src/parallel/stderr.rs", "third_party/rust/cc/src/target/apple.rs", "third_party/rust/cc/src/target/generated.rs", "third_party/rust/cc/src/target/llvm.rs", "third_party/rust/cc/src/target/parser.rs", "third_party/rust/cc/src/tempfile.rs", "third_party/rust/cc/src/tool.rs", "third_party/rust/cc/src/utilities.rs", "third_party/rust/cc/src/windows/com.rs", "third_party/rust/cc/src/windows/find_tools.rs", "third_party/rust/cc/src/windows/mod.rs", "third_party/rust/cc/src/windows/registry.rs", "third_party/rust/cc/src/windows/setup_config.r