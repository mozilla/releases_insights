/feature/ipprotection/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/media/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/password-importer/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/search/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-hr/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-hr/strings.xml", "mobile/android/fenix/app/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-hr/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml"], "git_node": "29e02680dc06b73271b5264b45700d3343259ab0", "git_parents": ["c2b95ab2513abe36e14ee043df8dfc0b1625291c"], "node": "fb57707860efca2866ef3398f0d6fb384a3434f1", "parents": ["d9811693fc42aeb0dcc6d4acd169ac07e805c504"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 1887045 - Implement bounds check elimination for WebAssembly GC arrays. r=bvisness\n\nExtend WasmBCE to eliminate bounds checks for constant-length array accesses.\nDetection is done in the BCE pass: array bounds checks always use\nMWasmBoundsCheck::Target::Array, and the pass works back from the numElements\nload to the MWasmNewArrayObject source to find a constant length.\n\nAdd testing using Ion MIR inspection for cross-platform verification.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283146\n", "files": ["js/src/jit-test/tests/wasm/gc/array-bce-ion-mir.js", "js/src/jit/MIR-wasm.h", "js/src/jit/WasmBCE.cpp", "js/src/wasm/WasmIonCompile.cpp"], "git_node": "eef0dfdf8af9ec6706665676c6629152d25f12da", "git_parents": ["29e02680dc06b73271b5264b45700d3343259ab0"], "node": "b116cc4af8988c4eb92ac10cc99bed581664f629", "parents": ["fb57707860efca2866ef3398f0d6fb384a3434f1"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2042496 - Add Fluent IDs for the Firefox wallpapers. r=fluent-reviewers,nina-py,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324224\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "d437de69d3b34a3abf19db24c997d89df4dcd532", "git_parents": ["eef0dfdf8af9ec6706665676c6629152d25f12da"], "node": "49fd9384a13d0d254a1087ecfa2eceaf4bfaf589", "parents": ["b116cc4af8988c4eb92ac10cc99bed581664f629"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Test remote decoded color metadata transport r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321679\n", "files": ["dom/media/gtest/TestRemoteImageHolder.cpp"], "git_node": "3b2c419bf06c8f546879be9aafbeead60d4addb5", "git_parents": ["d437de69d3b34a3abf19db24c997d89df4dcd532"], "node": "63567d43565057ad1e627e1dd7a2419e77df95a6", "parents": ["49fd9384a13d0d254a1087ecfa2eceaf4bfaf589"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Preserve decoded color metadata across remote image transport r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321680\n", "files": ["dom/media/ipc/RemoteImageHolder.cpp", "dom/media/ipc/RemoteVideoDecoder.cpp", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp"], "git_node": "fa90afcaf1f6c723f07b16f1474a35bdef39f846", "git_parents": ["3b2c419bf06c8f546879be9aafbeead60d4addb5"], "node": "3c8f51c4bc7bb0f3375b78dc69bd1e52f8cc8cbd", "parents": ["63567d43565057ad1e627e1dd7a2419e77df95a6"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Test FFmpeg decoded frame color metadata r=media-playback-reviewers,alwu\n\nGenerate av1-color-metadata.mp4 with:\n  ./generate_color_metadata_video.py av1-color-metadata.mp4\n      --codec libaom-av1 --pixel-format yuv420p10le\n      --color-primaries bt2020 --color-transfer smpte2084\n      --color-matrix bt2020nc --color-range tv --movflags +faststart\n      --encoder-option cpu-used=8 --encoder-option still-picture=1\n      --encoder-option crf=30\n\nThe checked-in fixture was generated with FFmpeg 6.1.1-3ubuntu5.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321982\n", "files": ["dom/media/gtest/TestMediaDataDecoder.cpp", "dom/media/gtest/av1-color-metadata.mp4", "dom/media/gtest/generate_color_metadata_video.py", "dom/media/gtest/moz.build"], "git_node": "7d2125abe40abe4be3804537ec067d8cdc5f4d60", "git_parents": ["fa90afcaf1f6c723f07b16f1474a35bdef39f846"], "node": "bf2279e9a41cbc5b6f13dc0ce0d87b5f3e85a44a", "parents": ["3c8f51c4bc7bb0f3375b78dc69bd1e52f8cc8cbd"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Preserve FFmpeg decoded frame color metadata r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321681\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h"], "git_node": "48138aafa65ba78194ae43e32de1427a45b6fbad", "git_parents": ["7d2125abe40abe4be3804537ec067d8cdc5f4d60"], "node": "45e7452c158618e0ee6a3883b91b17bca31e1c0d", "parents": ["bf2279e9a41cbc5b6f13dc0ce0d87b5f3e85a44a"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Update draw-snapshot AV1 color-quads fuzziness r=media-playback-reviewers,alwu\n\nPreserving FFmpeg's decoded color metadata reduces the pixel differences for the full-range 8-bit and 10-bit AV1 cases. Update their draw-snapshot expectations to match the corrected output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322710\n", "files": ["dom/media/test/reftest/color_quads/reftest.list"], "git_node": "416a8171c0df98b3f9042bfe7a5adc3a0dd4c145", "git_parents": ["48138aafa65ba78194ae43e32de1427a45b6fbad"], "node": "367b926244a77f0a59b1db73362c6cd78906c001", "parents": ["45e7452c158618e0ee6a3883b91b17bca31e1c0d"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Add debugging logs for PlanarYCbCrData r=media-playback-reviewers,gfx-reviewers,bradwerth,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323445\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "gfx/2d/Types.cpp", "gfx/2d/Types.h", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageContainer.h"], "git_node": "826f955493bbeaa031850f9d737f45b50ed1b91c", "git_parents": ["416a8171c0df98b3f9042bfe7a5adc3a0dd4c145"], "node": "869193601750559c0315b86d3fb6c4d959a27ff7", "parents": ["367b926244a77f0a59b1db73362c6cd78906c001"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Logging by gfx's logging convention r=media-playback-reviewers,gtk-reviewers,emilio,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323446\n", "files": ["dom/media/platforms/EncoderConfig.cpp", "dom/media/platforms/EncoderConfig.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/webcodecs/WebCodecsUtils.cpp", "widget/gtk/WaylandSurface.cpp"], "git_node": "fb7f5f87667c0c877c2c9643062c842f21309b97", "git_parents": ["826f955493bbeaa031850f9d737f45b50ed1b91c"], "node": "66ff254902bf69ab819038eaff92b410bb44cf37", "parents": ["869193601750559c0315b86d3fb6c4d959a27ff7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Log colorspace in full-cycle path r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323447\n", "files": ["dom/media/ipc/RemoteImageHolder.cpp", "dom/media/ipc/RemoteImageHolder.h", "dom/media/ipc/RemoteVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoEncoder.cpp", "dom/media/webcodecs/DecoderTemplate.cpp", "dom/media/webcodecs/EncoderAgent.cpp", "dom/media/webcodecs/EncoderTemplate.cpp", "dom/media/webcodecs/VideoDecoder.cpp", "dom/media/webcodecs/VideoFrame.cpp"], "git_node": "d60143990aded13e5518c3442ed3e6c2cf57ee9b", "git_parents": ["fb7f5f87667c0c877c2c9643062c842f21309b97"], "node": "c630457312e6254c99062ec02e61d3c9f25b192c", "parents": ["66ff254902bf69ab819038eaff92b410bb44cf37"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2057759 - Gate decoded frame color metadata behind a preference r=media-playback-reviewers,padenot\n\nKeep the existing behavior by default until encoder color-space signaling is complete. Enable the new behavior for the color-quads reftests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323448\n", "files": ["dom/media/ipc/RemoteVideoDecoder.cpp", "dom/media/test/reftest/color_quads/reftest.list", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "6e92778e79d89cb414fb4e996f74779cec0d5db2", "git_parents": ["d60143990aded13e5518c3442ed3e6c2cf57ee9b"], "node": "b8ac315c9ab697b1147e0b80133e7f550c4b3801", "parents": ["c630457312e6254c99062ec02e61d3c9f25b192c"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2057759: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/2d/Types.cpp", "gfx/2d/Types.h", "gfx/layers/ImageContainer.cpp"], "git_node": "5cfa424cf4e482108d287d53156359af09e3eb12", "git_parents": ["6e92778e79d89cb414fb4e996f74779cec0d5db2"], "node": "ccf48baf4731537beed30fbad4ca71a068bb72bd", "parents": ["b8ac315c9ab697b1147e0b80133e7f550c4b3801"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2065294 - Update YUVBufferGenerator r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320299\n", "files": ["dom/media/gtest/TestImageConversion.cpp", "dom/media/gtest/TestYUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.cpp", "dom/media/gtest/YUVBufferGenerator.h"], "git_node": "c551a27658b29b70351792e09ad36182665dba3b", "git_parents": ["5cfa424cf4e482108d287d53156359af09e3eb12"], "node": "22c394c72df5d61fff8357bfe7166180124e07c8", "parents": ["ccf48baf4731537beed30fbad4ca71a068bb72bd"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057759: apply code formatting via Lando\" for causing build bustages @NativeLayerWayland.cpp.\n\nThis reverts commit 5cfa424cf4e482108d287d53156359af09e3eb12.\n\nRevert \"Bug 2057759 - Gate decoded frame color metadata behind a preference r=media-playback-reviewers,padenot\"\n\nThis reverts commit 6e92778e79d89cb414fb4e996f74779cec0d5db2.\n\nRevert \"Bug 2057759 - Log colorspace in full-cycle path r=media-playback-reviewers,padenot\"\n\nThis reverts commit d60143990aded13e5518c3442ed3e6c2cf57ee9b.\n\nRevert \"Bug 2057759 - Logging by gfx's logging convention r=media-playback-reviewers,gtk-reviewers,emilio,padenot\"\n\nThis reverts commit fb7f5f87667c0c877c2c9643062c842f21309b97.\n\nRevert \"Bug 2057759 - Add debugging logs for PlanarYCbCrData r=media-playback-reviewers,gfx-reviewers,bradwerth,padenot\"\n\nThis reverts commit 826f955493bbeaa031850f9d737f45b50ed1b91c.\n\nRevert \"Bug 2057759 - Update draw-snapshot AV1 color-quads fuzziness r=media-playback-reviewers,alwu\"\n\nThis reverts commit 416a8171c0df98b3f9042bfe7a5adc3a0dd4c145.\n\nRevert \"Bug 2057759 - Preserve FFmpeg decoded frame color metadata r=media-playback-reviewers,alwu\"\n\nThis reverts commit 48138aafa65ba78194ae43e32de1427a45b6fbad.\n\nRevert \"Bug 2057759 - Test FFmpeg decoded frame color metadata r=media-playback-reviewers,alwu\"\n\nThis reverts commit 7d2125abe40abe4be3804537ec067d8cdc5f4d60.\n\nRevert \"Bug 2057759 - Preserve decoded color metadata across remote image transport r=media-playback-reviewers,alwu\"\n\nThis reverts commit fa90afcaf1f6c723f07b16f1474a35bdef39f846.\n\nRevert \"Bug 2057759 - Test remote decoded color metadata transport r=media-playback-reviewers,alwu\"\n\nThis reverts commit 3b2c419bf06c8f546879be9aafbeead60d4addb5.\n", "files": ["dom/media/gtest/TestMediaDataDecoder.cpp", "dom/media/gtest/TestRemoteImageHolder.cpp", "dom/media/gtest/av1-color-metadata.mp4", "dom/media/gtest/generate_color_metadata_video.py", "dom/media/gtest/moz.build", "dom/media/ipc/RemoteImageHolder.cpp", "dom/media/ipc/RemoteImageHolder.h", "dom/media/ipc/RemoteVideoDecoder.cpp", "dom/media/platforms/EncoderConfig.cpp", "dom/media/platforms/EncoderConfig.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.h", "dom/media/platforms/ffmpeg/FFmpegVideoEncoder.cpp", "dom/media/test/reftest/color_quads/reftest.list", "dom/media/webcodecs/DecoderTemplate.cpp", "dom/media/webcodecs/EncoderAgent.cpp", "dom/media/webcodecs/EncoderTemplate.cpp", "dom/media/webcodecs/VideoDecoder.cpp", "dom/media/webcodecs/VideoFrame.cpp", "dom/media/webcodecs/WebCodecsUtils.cpp", "gfx/2d/Types.cpp", "gfx/2d/Types.h", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageContainer.h", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp", "modules/libpref/init/StaticPrefList.yaml", "widget/gtk/WaylandSurface.cpp"], "git_node": "1d22e251504ed660136a9b618f947b4b02ac6a9d", "git_parents": ["c551a27658b29b70351792e09ad36182665dba3b"], "node": "73caccae1dd7fe14bacb010e93f13f38ffd13cad", "parents": ["22c394c72df5d61fff8357bfe7166180124e07c8"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069276: Don't expose IA2 text interfaces for XUL boxes. r=accessibility-platform-reviewers,morgan\n\nIn general, it's expected that any container which can have TextLeafAccessible children should be a HyperTextAccessible.\nBug 1979253 enforced this even for XUL boxes.\nUnfortunately, we use XUL boxes for address bar action buttons.\nThese don't actually contain any text.\nHowever, because we expose IA2 text interfaces, NVDA mouse tracking looks for text and doesn't find any, causing it to report nothing.\nRather than making a special case exception for the HyperTextAccessible -\u003e TextLeafAccessible invariant (which might cause problems on other platforms, particularly Mac), just avoid exposing the IA2 text interfaces for these elements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324168\n", "files": ["accessible/tests/browser/windows/ia2/browser_text.js", "accessible/windows/msaa/MsaaAccessible.cpp"], "git_node": "3cc1528e15b8865241ffbfee30162814b36517c2", "git_parents": ["1d22e251504ed660136a9b618f947b4b02ac6a9d"], "node": "992a5ac3431e9dff6dc2da9ffb2355aec193ced0", "parents": ["73caccae1dd7fe14bacb010e93f13f38ffd13cad"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070043: Remove PBrowser::UpdateNativeWindowHandle. r=accessibility-platform-reviewers,morgan\n\nThis is a relic from the Windows IPC implementation before Cache the World.\nIt is no longer used anywhere in the content process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324169\n", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/PBrowser.ipdl"], "git_node": "958c6d0cadc9e0a4782f745e36bc9dfaa5b2eaf4", "git_parents": ["3cc1528e15b8865241ffbfee30162814b36517c2"], "node": "e3071ae181b19510681f9f2e1694361b272aa975", "parents": ["992a5ac3431e9dff6dc2da9ffb2355aec193ced0"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052772 - Part 3: Expose nsIFOG.initialized and wait for it before reading Glean in marionette tests r=search-reviewers,sclements,janerik,jteow\" for causing talos failures.\n\nThis reverts commit addffbbb65471ee5041cd498527c4e8707662996.\n\nRevert \"Bug 2052772 - Part 2: Allowlist the pre-existing urlbar focus-ring startup flicker exposed by the idle-task port r=Gijs\"\n\nThis reverts commit f87042a7bece048794e986e4552c316bf152540b.\n\nRevert \"Bug 2052772 - Part 1: Port module initialization in _schedulePerWindowIdleTasks to use category-manager invocation r=Gijs,frontend-codestyle-reviewers,mossop\"\n\nThis reverts commit 1e0acc370f0123cd643e157da6357f998414999d.\n", "files": ["browser/base/content/browser-gestureSupport.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/base/content/test/general/browser_gestureSupport.js", "browser/base/content/test/performance/browser_startup_flicker.js", "browser/components/BrowserComponents.manifest", "browser/components/downloads/DownloadsCommon.sys.mjs", "browser/components/search/test/marionette/telemetry/test_ping_submitted.py", "browser/components/sessionstore/test/marionette/test_new_tab_on_restore.py", "browser/docs/BrowserStartup.md", "browser/modules/test/browser/browser_taskbar_preview.js", "toolkit/components/glean/xpcom/FOG.cpp", "toolkit/components/glean/xpcom/nsIFOG.idl", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/xpcshell/test_BrowserUtils.js"], "git_node": "3e517de3d46500481452736183480db510d76a90", "git_parents": ["958c6d0cadc9e0a4782f745e36bc9dfaa5b2eaf4"], "node": "1d8644dcd8b849e189f9f1cf2988283ed0402ef0", "parents": ["e3071ae181b19510681f9f2e1694361b272aa975"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068697 - Support pinned, splitview and group on tab groups, tab group labels and split views. r=tabbrowser-reviewers,sthompson\n\n`pinned` goes from absent to `false` on a group and its label, which only a loose comparison distinguishes; the two in `drag-and-drop.js` sit behind a `multiselected` check a group label never passes. `splitview` and `group` become `null`, which every use reads the same as absent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323564\n", "files": ["browser/components/tabbrowser/content/tabgroup.js", "browser/components/tabbrowser/content/tabsplitview.js", "browser/components/tabbrowser/types/elements.ts"], "git_node": "c8c717dce454ed8c163ea031012b38591b86b8af", "git_parents": ["3e517de3d46500481452736183480db510d76a90"], "node": "b8c5d711d9254028cd71721a2405795e80efca82", "parents": ["1d8644dcd8b849e189f9f1cf2988283ed0402ef0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070384 - Update intellij-markdown to version 0.7.12. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324473\n", "files": ["gradle/libs.versions.toml"], "git_node": "2eaea2f23a4c67baeb84cf9e9fd41fa7103d690e", "git_parents": ["c8c717dce454ed8c163ea031012b38591b86b8af"], "node": "e8cb009b9f6496e093373447141760bad82cf8d8", "parents": ["b8c5d711d9254028cd71721a2405795e80efca82"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070384 - Update Okio to version 3.18.2. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324474\n", "files": ["gradle/libs.versions.toml"], "git_node": "e0d24577f377d6c07125a26bea6e2e3fb4f3b8d8", "git_parents": ["2eaea2f23a4c67baeb84cf9e9fd41fa7103d690e"], "node": "c2bab13fc76944b23fb5e45d2b08da884c4ce767", "parents": ["e8cb009b9f6496e093373447141760bad82cf8d8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070029 - Update Kotlin to version 2.4.20. r=android-reviewers,adhingra\n\nAlso updates semanticdb-kotlinc to 0.11.0, the release built against Kotlin 2.4.20.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324411\n", "files": ["gradle/libs.versions.toml"], "git_node": "7ca6b45b92e5f4c44cea5ff790af1bb3216ed990", "git_parents": ["e0d24577f377d6c07125a26bea6e2e3fb4f3b8d8"], "node": "ea5b97aa3bab911267e0e7173e6e38dc4575d00d", "parents": ["c2bab13fc76944b23fb5e45d2b08da884c4ce767"], "tags": []}], "date": 1788926952, "git_changesets": ["7e771a1a445239663a6b0d047d71fe5af7558979", "a5fb27356b921a4f65f824753b23490e52e30c55", "c4604f8a9eebc221daab1211bc2605f663dae934", "f448040f50f4bf6757053809f0d17420eda85032", "9f22d0c1040ddd165733635f0030a699bb0ad7fa", "084cc7cc86fbb9aa02dd285505f89474157ab13b", "f36465e97aff5b03936b70c92735d2ec7b597a80", "bae17483dda33b7f0398abb1a201d7726a70875a", "4e737be215efa89e45d852dcff8fea428056b8bc", "6c61a730a8d5c80f5adf2ed4254653c798ff0be4", "c62d4537b4b192d8c427d6e1ff858240d2572177", "90611edea37259b997979368bd4c23f4f1760dd0", "a897ff208df61ea2e49920566495b13ec5757c8a", "c7e0d3ad14d95fd60e09207a55f4afc18371032c", "00aefd449ec313ef2ef264d1bddaa0efdd6cf7e1", "6367311ab58a9e5f1edb3e7af0558c6b596d8379", "be3fa367f6f14592d012ff168acff006a57cb6c7", "a6f08c479cdc4ee8028a9e26bb9246b2aac0003e", "220feefd4a29491711cae5092919f2f43f2bf855", "faf7727b923530cc219f299cbdbaaf9c246fc925", "7ce79ba4f90d32f9adbe42467448e35e21738491", "3a990ebd786eba2ddfbc0810e8f5af7457a23f54", "174eb0053a0b483d9119f175a847694362ed5dbd", "c71dcdf924edaaad57d138353201de838827dc32", "076582269f45017d93163a636a9236c7b359800d", "20010a3a631bfa73889d3b56c196461095eaa898", "4063754dde4c3378e8c3d5093c627af13ce6e5e5", "5f01c073aac2496adf028f3c67ff04cb5b3db33a", "59eae00fcab19ea83cf845af09a036bd44e40596", "3389c073d10a16677fc7d87ee8a52f8074a621e3"