ea7f636ce11459a952d6a60dc54e40db6319445\nsr -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nsv-SE -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nta -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nte -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nth -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\ntl -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\ntr -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\ntrs -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nuk -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nur -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nuz -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nvi -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nwo -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nxh -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nzam -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nzh-CN -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\nzh-TW -\u003e 8ea7f636ce11459a952d6a60dc54e40db6319445\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "d6445e870a72498c3b3245104cb94433d9e9f623", "git_parents": ["4d8ec71379e6dafc4dad2e04fd7557e42a62f3cc"], "node": "b369a9aba9a7b55aec229ddb142831f49440c1cf", "parents": ["a1be85174ffffc7f415e137a0a3f227a9e2ae41a"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 1989689 - Allow Swipe To Dismiss On Downloads Page r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318400\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/compose/DismissibleItemBackground.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/compose/SwipeToDismiss.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/listscreen/DownloadsScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/listscreen/store/DownloadUIAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/listscreen/store/DownloadUIState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/listscreen/store/DownloadUIStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/listscreen/ui/FileListItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/SharedTabItemUi.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/TabGridTabItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/TabListTabItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayout.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/downloads/listscreen/DownloadsScreenSwipeTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/downloads/listscreen/store/DownloadUIStateTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/downloads/listscreen/store/DownloadUIStoreTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/tabitems/SharedTabItemUiTest.kt"], "git_node": "ba396ecbcddea0fc4e37410aae07ac3dfc921f88", "git_parents": ["d6445e870a72498c3b3245104cb94433d9e9f623"], "node": "5bf403c4ab5c6edc4fa5a0424e701c05fb7957b0", "parents": ["b369a9aba9a7b55aec229ddb142831f49440c1cf"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067619 part 1: Don't expose the selectable state for a gridcell which doesn't explicitly define aria-selected. r=accessibility-platform-reviewers,eeejay\n\nPreviously, our exposure of the selectable state caused clients to treat these as \"not selected\".\nHowever, this is different to \"not selectable\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323165\n", "files": ["accessible/base/ARIAMap.cpp", "accessible/tests/browser/states/browser_test_selection.js", "accessible/tests/browser/windows/uia/browser_selectionPatterns.js", "accessible/tests/mochitest/table/test_sels_ariagrid.html"], "git_node": "063e1805da7850d81b28ff6853465bf2be3e19e0", "git_parents": ["ba396ecbcddea0fc4e37410aae07ac3dfc921f88"], "node": "15650dda7544600e74ae00a1f5845169f5882914", "parents": ["5bf403c4ab5c6edc4fa5a0424e701c05fb7957b0"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067619 part 2: Fire a selectable state change event when aria-selected is changed if appropriate. r=accessibility-platform-reviewers,eeejay\n\nSelection changes fire selection events, not state change events.\nTherefore, we handle aria-selected specially, rather than handling it in AttributeChangesState.\nThis meant that previously, a state change event wasn't fired when a change to aria-selected caused the selectable state to change.\nTo fix this, we now handle this case explicitly in LocalAccessible::DOMAttributeChanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323166\n", "files": ["accessible/base/ARIAMap.h", "accessible/generic/LocalAccessible.cpp", "accessible/tests/browser/states/browser_test_selection.js"], "git_node": "82df3fd2f7989d3cbe5eea4206d20207b054c4c4", "git_parents": ["063e1805da7850d81b28ff6853465bf2be3e19e0"], "node": "569bfb9912b04a3f3ba3ebcc5eb1194cf1928b35", "parents": ["15650dda7544600e74ae00a1f5845169f5882914"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2061489 - Make `KeymapWrapper::InitKeyEvent` set `.mKeyNameIndex` to `KEY_NAME_INDEX_USE_STRING` if `aCommitCharReceivedByIMContext` is not void r=m_kato\n\nWhen `aCommitCharReceivedByIMContext` is not void, it means that the key\nintroduced the string with a commit signal. Therefore, its `.key`\nshould be set to the string.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323547\n", "files": ["widget/gtk/nsGtkKeyUtils.cpp"], "git_node": "a59d6a3517f967b9dd4651deb02aaa4d3d7f963e", "git_parents": ["82df3fd2f7989d3cbe5eea4206d20207b054c4c4"], "node": "381dd3bf834deaf5195d79926a29492db7c8ca35", "parents": ["569bfb9912b04a3f3ba3ebcc5eb1194cf1928b35"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069794 - [devtools] Add missing closing parenthesis in fonts.css comment. r=jdescottes,devtools-reviewers. DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323975\n", "files": ["devtools/client/themes/fonts.css"], "git_node": "aca7455e3c3fa56ba1cec50974f38f224923f748", "git_parents": ["a59d6a3517f967b9dd4651deb02aaa4d3d7f963e"], "node": "3476188f5851545b30436f079c367a238ea9e531", "parents": ["381dd3bf834deaf5195d79926a29492db7c8ca35"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2061489 - Make `IMContextWrapper::CommitCompositionNative` not dispatch `eKeyDown` event if we've already dispatched r=m_kato\n\n`IMContextWrapper::CommitCompositionNative` started to dispatch\n`eKeyDown` and `eKeyPress` as far as possible for Microsoft Word's bug.\nHowever, we should not do that for a special case. That is, IME may\nsend canceling composition first, then, send `commit` signal without\nanother composing state during a call of\n`gtk_im_context_filter_keypress`. The reason is, some web apps may\ncount `keydown` events and that may be important for them (e.g.,\ntyping test apps). Therefore, this patch makes `CommitCompositionNative`\ntreats the commit composition without composing state as an input\nwithout a key press after we've already dispatched `eKeyDown`.\n\nNote that this is the traditional behavior before bug 2051354 even\nthough the old code didn't check `mKeyboardEventWasDispatched`.\nhttps://searchfox.org/firefox-main/source/widget/gtk/IMContextWrapper.cpp#1991,2003,2013,2019,2036,2040\n(not matching the `keyval` and `commitString`, `mMaybeInDeadKeySequence`\nwas set to `false` at dispatching the composition commit event for the\npreceding composition cancel and there is `mProcessingKeyEvent`, so,\n`DispatchCompositionCommitEvent()` was used.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323805\n", "files": ["widget/gtk/IMContextWrapper.cpp"], "git_node": "3664b56c3395fa146dc8aac93452cd98b2fbb0be", "git_parents": ["aca7455e3c3fa56ba1cec50974f38f224923f748"], "node": "5a449e20042e8b135923a2f40aa1970ff7bd2ce2", "parents": ["3476188f5851545b30436f079c367a238ea9e531"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069698 - Make `IMContextWrapper::OnCommitCompositionNative` use `eKeyDown` event if DOM `Ctrl`, `Alt` or `Meta` is pressed and the commit string is the same as the key r=m_kato\n\nIME may send `commit` signal without the composing state when\nuser presses `Super` or something. Then, if the commit string is the\nsame as the character introduced by the key press, the user may want\nto use a shortcut key or an access key. Therefore, we need to dispatch\n`eKeyDown` instead of composition events or a content event with\n`Process` `eKeyDown` since the global key handler needs to handle the\nkey event as a shortcut key.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323946\n", "files": ["widget/gtk/IMContextWrapper.cpp"], "git_node": "4075182cae4c86fc0e93d3465d5524ceaff9da3d", "git_parents": ["3664b56c3395fa146dc8aac93452cd98b2fbb0be"], "node": "c3bdf070cef79df7b226a167dc923abd880d7823", "parents": ["5a449e20042e8b135923a2f40aa1970ff7bd2ce2"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995348 - Implement the \"grid-lanes\" value for the \"display\" property r=layout-reviewers,firefox-style-system-reviewers,dholbert,emilio\n\nUse the \"display: grid-lanes\" value to conform to current usage in web\nplatform tests.\n\nTwo tests are marked as CRASH, because the masonry code uses a sort\ncomparitor that is not valid strick weak ordering as required, so it\nasserts in debug builds. See bug 2068688.\n\nSee: https://drafts.csswg.org/css-grid-3/#masonry-model\n\nDifferential Revision: https://phabricator.services.mozilla.com/D273845\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsGridContainerFrame.cpp", "layout/inspector/tests/test_bug877690.html", "layout/style/test/property_database.js", "layout/style/test/test_position_float_display.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/values/specified/box.rs", "testing/web-platform/meta/css/css-anchor-position/__dir__.ini", "testing/web-platform/meta/css/css-anchor-position/grid-lanes-position-area-basic.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/__dir__.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-001.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-002.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-004.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/grid-lanes-container-fragmentation-001.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/grid-lanes-container-fragmentation-002.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/grid-lanes-container-fragmentation-006.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/grid-lanes-fragmentation-001.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/grid-lanes-fragmentation-002.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/grid-lanes-fragmentation-003.html.ini", "testing/web-platform/meta/css/css-display/parsing/tentative/__dir__.ini", "testing/web-platform/meta/css/css-display/parsing/tentative/display-computed.html.ini", "testing/web-platform/meta/css/css-display/parsing/tentative/display-valid.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/__dir__.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/abspos/column