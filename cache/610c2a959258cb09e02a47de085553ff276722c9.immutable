Test.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/TextSelectionTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsHTTPSOnlyModeTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TextSelectionTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SearchRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/FenixSearchMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/search/awesomebar/AwesomeBarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposableTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/search/FenixSearchMiddlewareTest.kt"], "git_node": "3e1379856a7b2983a937aa625b32adf86508af81", "git_parents": ["b7ff882e14486a6e8906100910c22230de093f44"], "node": "b821f05f94a92ee05fc0a7c3b0fd6b1255da5ffc", "parents": ["006db1d26434c97b17377c45308a52d4f5b1ed10"], "tags": []}], "date": 1788299270, "git_changesets": ["035328f2ee7af55109955cc399c28675bdfcfd7c", "27a5f86aa8549e4d3f2f1e08299375ee2ab336a1", "79f3615e22f205765fdd90c11e3aaa3cd631bdb5", "b7ff882e14486a6e8906100910c22230de093f44", "3e1379856a7b2983a937aa625b32adf86508af81"], "user": "abutkovits@mozilla.com"}, "45228": {"changesets": [{"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058565 - Close open preferences subdialogs when the pane changes r=hjones\" for causing bc tests failures at creditCard_osAuth.js\n\nThis reverts commit 035328f2ee7af55109955cc399c28675bdfcfd7c.\n", "files": ["browser/components/preferences/preferences.js", "browser/components/preferences/tests/browser_subdialogs.js"], "git_node": "8a99ef927ea16827f2089e2bdf6a1188ddf645e7", "git_parents": ["3e1379856a7b2983a937aa625b32adf86508af81"], "node": "e250d6adf4c0407181d42472837de3dd03b6ae8e", "parents": ["b821f05f94a92ee05fc0a7c3b0fd6b1255da5ffc"], "tags": []}], "date": 1788299437, "git_changesets": ["8a99ef927ea16827f2089e2bdf6a1188ddf645e7"], "user": "abutkovits@mozilla.com"}, "45229": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067679 - Allow cargo clippy/check to take -p to lint a single package. r=firefox-build-system-reviewers,sylvestre\n\nUse CARGO_NO_AUTO_ARG when specifying a gkrust crate, so that gkrust\nfeatures don't get added to the particular crate automatically (which\nwould cause it not to work).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322320\n", "files": ["build/cargo/cargo-fix.yaml", "python/mozbuild/mozbuild/mach_commands.py"], "git_node": "3ea9abc63164c787ae2418aea674b22cce4a6392", "git_parents": ["3e1379856a7b2983a937aa625b32adf86508af81"], "node": "c55b00ad7e2346de7962245609810d0fa514fa7f", "parents": ["b821f05f94a92ee05fc0a7c3b0fd6b1255da5ffc"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027993 - Add test and comment. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D291199\n", "files": ["js/src/jit-test/tests/fuses/bug2027993.js", "js/src/jit/WarpOracle.cpp"], "git_node": "ae6ea9561666451c69211d24056face11ab81fc6", "git_parents": ["3ea9abc63164c787ae2418aea674b22cce4a6392"], "node": "31fccce7913dead2af4525fb0ba384fe31607365", "parents": ["c55b00ad7e2346de7962245609810d0fa514fa7f"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036983 - Add testing option for EagerBaselineStrategy compile option. r=iain\n\nThe test doesn't generate a huge function because it makes the test very slow,\nbut it has all the scaffolding for a fuzzer to mutate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298876\n", "files": ["js/src/builtin/TestingUtility.cpp", "js/src/jit-test/tests/baseline/eager-baseline-strategy-option.js"], "git_node": "12337e2a8c9682ee0f840b33ce66091b7a035e97", "git_parents": ["ae6ea9561666451c69211d24056face11ab81fc6"], "node": "f5c23bb55e6077ad6c6228af663da6a10bf0a2d9", "parents": ["31fccce7913dead2af4525fb0ba384fe31607365"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2067654 - Fix Happy Eyeballs only trying the first DNS address. r=kershaw,necko-reviewers\n\nThe glue declared NetAddr as an opaque zero-sized union and held it in a\nThinVec\u003cNetAddr\u003e. C++ passed full-size elements, so Rust walked the array with\na stride of 0: every slot read the first address. The engine then dropped the\nduplicates as already-attempted endpoints, leaving one connection attempt and\nno failover.\n\nAn opaque type is safe behind a pointer but not as a collection element, so\npass the IpAddr that cbindgen already generates for the reverse direction.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322583\n", "files": ["Cargo.lock", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/happy_eyeballs_glue/Cargo.toml", "netwerk/protocol/http/happy_eyeballs_glue/cbindgen.toml", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/test/gtest/TestHappyEyeballsNetAddrArray.cpp", "netwerk/test/gtest/moz.build"], "git_node": "9235aa7dd1d66a64c387d0c2ca14a1e2eb02a16b", "git_parents": ["12337e2a8c9682ee0f840b33ce66091b7a035e97"], "node": "bd7475f1c05c1eb25d44697fc4a83903bbd9a315", "parents": ["f5c23bb55e6077ad6c6228af663da6a10bf0a2d9"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2067485. Run third_party/js/cfworker/build.sh with bash, since that is what it is written in. r=mossop\n\nbuild.sh says #!/bin/sh but its second line is `set -euo pipefail` and line 7 uses `[[ ]]`,\nneither of which is POSIX sh.\n\nBash is commonly used in other moz.yaml scripts, so this is nothing new.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322110\n", "files": ["taskcluster/scripts/misc/vendor-verify-expected-fail.yml", "third_party/js/cfworker/build.sh"], "git_node": "de2ac52ef301d3420994eadc21ca5db9d03a6a87", "git_parents": ["9235aa7dd1d66a64c387d0c2ca14a1e2eb02a16b"], "node": "5ab03c852856b4dda8a7f2f387318bc590af5867", "parents": ["bd7475f1c05c1eb25d44697fc4a83903bbd9a315"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065591 - Fix up SessionStore's existing JSDoc and take the file out of the jsdoc lint rollouts. r=frontend-codestyle-reviewers,jswinarton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320529\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "eslint-rollouts.config.mjs"], "git_node": "bd417d20772bacc6f76b5219f778443f62bd0ebd", "git_parents": ["de2ac52ef301d3420994eadc21ca5db9d03a6a87"], "node": "b0e2edc6caee3748e0be37d4ed29252095ec167b", "parents": ["5ab03c852856b4dda8a7f2f387318bc590af5867"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065591 - Document SessionStore's remaining public members. r=jswinarton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320530\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs"], "git_node": "554243353f285888c9dd787bd4df20e25729d9c9", "git_parents": ["bd417d20772bacc6f76b5219f778443f62bd0ebd"], "node": "79490ff9788ace0d41670e1d653534505ff548d3", "parents": ["b0e2edc6caee3748e0be37d4ed29252095ec167b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065591 - Add a Session Restore page to the Firefox source docs. r=firefox-source-docs-reviewers,sylvestre,jswinarton\n\n`@alias` makes the page read `SessionStore` rather than the implementation name. A documented `#`-private field whose name matches a getter aborts the build, so two such fields have their docs on the getters instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320532\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/docs/api.md", "browser/components/sessionstore/docs/index.md", "browser/components/sessionstore/moz.build", "browser/docs/index.md", "docs/config.yml", "docs/jsdoc-plugins/skip-unnamed-members.mjs", "docs/jsdoc.json"], "git_node": "b70a7076ccc81adb47fe862bdedf7eba873e146a", "git_parents": ["554243353f285888c9dd787bd4df20e25729d9c9"], "node": "6952fbcba4d47e91fb370ac9ec08a91f5657867f", "parents": ["79490ff9788ace0d41670e1d653534505ff548d3"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2063425 - Don't block shutdown with failed Nimbus updates r=nimbus-reviewers,emcminn\n\nPreviously, if `RemoteSettingsExperimentLoader.#updateImpl()` threw we\nwould end up not resetting the updating state, so `._updating` would\nalways be true (blocking futher updates) and `finishedUpdating()` would\nnever resolve.\n\nWe now reset this state in a finally clause and report exception\ninformation in a new Glean event.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321990\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js"], "git_node": "78f672072a4dd5f2f8d32c8da656124052e367e2", "git_parents": ["b70a7076ccc81adb47fe862bdedf7eba873e146a"], "node": "b5d80e58b7e46d69f6322868fc3319fda55e07be", "parents": ["6952fbcba4d47e91fb370ac9ec08a91f5657867f"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063759 - Avoid line-clamp style adjustment for displays that aren't block/inline. r=firefox-style-system-reviewers,emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319194\n", "files": ["layout/generic/nsBlockFrame.cpp", "servo/components/style/style_adjuster.rs", "testing/web-platform/tests/css/css-overflow/line-clamp/webkit-line-clamp-bug-2063759-crash.html"], "git_node": "bc6b2cdc1eecb19aa6fefc14b4e37846e9f0ba01", "git_parents": ["78f672072a4dd5f2f8d32c8da656124052e367e2"], "node": "1f8f01ab230fb9b04f0174429c4d56f7ec3ce8e9", "parents": ["b5d80e58b7e46d69f6322868fc3319fda55e07be"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2068000 - Remove jog feature that is effectively always-on. r=janerik\n\nFollow-up to the previous commit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322616\n", "files": ["toolkit/components/glean/bindings/jog/Cargo.toml", "toolkit/components/glean/bindings/jog/src/lib.rs", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "8e19b05f6897d0f8ba19f0c2cd0bfbd77ca41e33", "git_parents": ["bc6b2cdc1eecb19aa6fefc14b4e37846e9f0ba01"], "node": "30b9e3e3cee858da47745caee6d59d908b76a28b", "parents": ["1f8f01ab230fb9b04f0174429c4d56f7ec3ce8e9"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058565 - Close open preferences subdialogs when the pane changes r=hjones\" for causing bc tests failures at creditCard_osAuth.js\n\nThis reverts commit 035328f2ee7af55109955cc399c28675bdfcfd7c.\n", "files": ["browser/components/preferences/preferences.js", "browser/components/preferences/tests/browser_subdialogs.js"], "git_node": "2b35916e379887409476e9be1c566c7daf500282", "git_parents": ["8e19b05f6897d0f8ba19f0c2cd0bfbd77ca41e33"], "node": "ee847a685d3cc16522e72f0c4f18cfca4460ccad", "parents": ["30b9e3e3cee858da47745caee6d59d908b76a28b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067051 - Add debugEnabled and traceEnabled to Log.Logger. r=firefox-desktop-core-reviewers ,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321812\n", "files": ["toolkit/modules/Log.sys.mjs", "toolkit/modules/tests/xpcshell/test_Log.js"], "git_node": "03392c434cd388639d7017fd64ca087b16d5f89e", "git_parents": ["2b35916e379887409476e9be1c566c7daf500282"], "node": "f22e6171279fa16eead4698ab9d9d2c4fdf5731d", "parents": ["ee847a685d3cc16522e72f0c4f18cfca4460ccad"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067051 - Fix SessionSaver's dead debug logging guard. r=sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321813\n", "files": ["browser/components/sessionstore/SessionLogger.sys.mjs", "browser/components/sessionstore/SessionSaver.sys.mjs"], "git_node": "53967564495beaca86071c3bbd1665ab6646bfc0", "git_parents": ["03392c434cd388639d7017fd64ca087b16d5f89e"], "node": "3653bed85b53223fbdfbd9c85cba0253d6014dcc", "parents": ["f22e6171279fa16eead4698ab9d9d2c4fdf5731d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067051 - Use the Log.Logger level getters in services (no functional change). r=sync-reviewers,skhamis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321814\n", "files": ["services/common/rest.sys.mjs", "services/sync/modules/engines.sys.mjs", "services/sync/modules/resource.sys.mjs"], "git_node": "be931f2899fcf09c498fc20a0f719c88f2cbc3ae", "git_parents": ["53967564495beaca86071c3bbd1665ab6646bfc0"], "node": "cb97d2dd04d3b26748c9115f9f89bf1b9cda0047", "parents": ["3653bed85b53223fbdfbd9c85cba0253d6014dcc"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068104 - Enter the top layer only while an in-page address bar is open. r=mbeier,urlbar-reviewers\n\nA closed element keeps the box it had: it stays broken out, and only gives up the top layer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322621\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/NewtabSearchbarContentTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_topLayer.js"], "git_node": "0b69bf96e4134d1f3d0c3af5adf1d04901662beb", "git_parents": ["be931f2899fcf09c498fc20a0f719c88f2cbc3ae"], "node": "68ebda97afbbc3d24bb3d72ea7f8bd0fccdf9c59", "parents": ["cb97d2dd04d3b26748c9115f9f89bf1b9cda0047"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066531 - [remote] Restore recommended preferences on profile-before-change phase r=Sasha,hbenl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322356\n", "files": ["remote/shared/RecommendedPreferences.sys.mjs", "testing/marionette/harness/marionette_harness/tests/unit/test_recommended_prefs.py", "testing/marionette/harness/marionette_harness/tests/unit/unit-tests.toml"], "git_node": "ba5bc763027f334bb2c776029f7efd6f6e5c3819", "git_parents": ["0b69bf96e4134d1f3d0c3af5adf1d04901662beb"], "node": "9d9d5b041fac70cd30fe0b94aaca7024d93a06a0", "parents": ["68ebda97afbbc3d24bb3d72ea7f8bd0fccdf9c59"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064258: Avoid an unconditional store when marking a declaration block as being in the rule tree. r=firefox-style-system-reviewers,emilio\n\nStyleSource::mark_in_rule_tree unconditionally stored true into\nPropertyDeclarationBlock::immutable. The flag is never cleared, so after the\nfirst mark every subsequent store is redundant -- but each one still has to take\nthe declaration block's cache line exclusive, invalidating it for every other\nstyle thread concurrently reading that same line. The servo_arc refcount, the\nSharedRwLock pointer and the ThinVec of declarations all live in that line, and\nthe parallel traversal reads all three per rule node.\n\nLoad before storing so that the steady state is a shared read.\n\nMeasured on a 6P+8E i9-12900HK with\nSpeedometer3.1/?suite=TodoMVC-Angular-Complex-DOM, comparing per-element style\ntraversal time for traversals of \u003e=385 elements (2.3% of traversals, but 85% of\nall elements styled on that workload), median of 3 runs:\n\n  layout.css.stylo-threads=6:  8.96 -\u003e 6.98 us/element  (-22.1%)\n  layout.css.stylo-threads=1: 17.41 -\u003e 17.18 us/element (-1.3%, within noise)\n\nThe parallel speedup on large restyles improves from 1.94x to 2.46x. The win\nbeing parallel-only is the expected signature of removing a cache line\nping-pong rather than of reducing per-element work.\n\nNote that the Speedometer score itself does not move: on that workload the\nlarge traversals happen during the per-iteration app setup, which is outside\nthe measured region (at stylo-threads=1, style traversal alone is\n100.7 ms/iteration against a measured suite time of 62.5 ms/iteration).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321061\n", "files": ["servo/components/style/rule_tree/source.rs"], "git_node": "74ae3cde398bc9768e7e0d542806760c46289181", "git_parents": ["ba5bc763027f334bb2c776029f7efd6f6e5c3819"], "node": "e61c71a4e111077044bb816ea66c12a01a19398a", "parents": ["9d9d5b041fac70cd30fe0b94aaca7024d93a06a0"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067263 - Adjust \"Add a signature\" to Headline 7 for Android PDF viewer r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322396\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/ui/SignatureDialog.kt"], "git_node": "a0d667e079fe962e97811cdf50eaa4d850a6a440", "git_parents": ["74ae3cde398bc9768e7e0d542806760c46289181"], "node": "f45b4978ef12cd88ed3864e2231c2426e44dfed7", "parents": ["e61c71a4e111077044bb816ea66c12a01a19398a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065770 - Drop browser.js's duplicate of the switchToTabHavingURI docs. r=kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321276\n", "files": ["browser/base/content/browser.js"], "git_node": "2ea22d8106261aad5e45a760e63309f0aa2dc750", "git_parents": ["a0d667e079fe962e97811cdf50eaa4d850a6a440"], "node": "832accd8d2e4e3648166e0d575b1c436af96d424", "parents": ["f45b4978ef12cd88ed3864e2231c2426e44dfed7"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064547 - Prefer Skrifa for metrics in FreeType fonts r=jfkthame\n\nThis still relies on some FreeType bits for font-size-adjust, that will be\nhandled as a followup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319644\n", "files": ["gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2FontBase.h"], "git_node": "4cbf967613e01bc4d01a7e61defe466f451667b7", "git_parents": ["2ea22d8106261aad5e45a760e63309f0aa2dc750"], "node": "57af239330473a62635447814f6564f6d52e37cb", "parents": ["832accd8d2e4e3648166e0d575b1c436af96d424"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067260 - Have the user autofocus into the signature field r=android-reviewers,mcarare\n\nAdjusts the `SignatureDialog` so that the user autofocuses into the field.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322426\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/ui/SignatureDialog.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/ui/SignatureDialogTest.kt"], "git_node": "a002c08e5e9f6faa5c08d0c05a8b5238f891cf97", "git_parents": ["4cbf967613e01bc4d01a7e61defe466f451667b7"], "node": "fc290e150a32c2af68748a45519bff18508022a1", "parents": ["57af239330473a62635447814f6564f6d52e37cb"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065636 - Simplify error handling branches in _importChanges r=acottner\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322645\n", "files": ["services/settings/RemoteSettingsClient.sys.mjs"], "git_node": "84331803395e008883d7c0546a6426017cfb8bd4", "git_parents": ["a002c08e5e9f6faa5c08d0c05a8b5238f891cf97"], "node": "b34ff2b11f884bef092dc21eaedba39cd1f85255", "parents": ["fc290e150a32c2af68748a45519bff18508022a1"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066792 - Excessive bottom spacing inside warning banner when title wraps to two lines - r=akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322424\n", "files": ["toolkit/content/widgets/moz-message-bar/moz-message-bar.mjs"], "git_node": "dcca067c3a96465fe581f890b4c0a43f361ac264", "git_parents": ["84331803395e008883d7c0546a6426017cfb8bd4"], "node": "89643b30217d61cb48f18e3d6ae05e03cf2e3216", "parents": ["b34ff2b11f884bef092dc21eaedba39cd1f85255"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2067193 - mots.yaml: update of the mfbt info r=glandium,shtrom\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322210\n", "files": ["mots.yaml"], "git_node": "4b0271cb72bd636bfc14abd0d41d0308a5c3dc21", "git_parents": ["dcca067c3a96465fe581f890b4c0a43f361ac264"], "node": "9df61f4983d0b581af1151a7a832be7cda4d882d", "parents": ["89643b30217d61cb48f18e3d6ae05e03cf2e3216"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066154 Part 1 - Minor cleanup in ComputePositionVisibility(). r=layout-reviewers,emilio\n\nWhen the `containingBlock` is a scrolled frame, `rootRect` is\nrecomputed, so move `GetAllInFlowRectsUnion()` to the `else` branch.\n\nNote that in the `else` branch, `intersectionRoot` and\n`containingBlock` are the same, but this patch swaps the arguments of\n`GetAllInFlowRectsUnion()`, indicating that we are computing\n`containingBlock`'s rect in the `intersectionRoot`'s coordinate space.\n\nThis does not change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322476\n", "files": ["layout/base/AnchorPositioningUtils.cpp"], "git_node": "f328cdda7bc2087cf73443b4af8ffb11897329dd", "git_parents": ["4b0271cb72bd636bfc14abd0d41d0308a5c3dc21"], "node": "225691dd43dc84c0af0becd78a28e271f954c817", "parents": ["9df61f4983d0b581af1151a7a832be7cda4d882d"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066154 Part 2 - Consider IB-split when computing position-visibility and walking the ASR chain. r=layout-reviewers,emilio\n\nThe DisplayPortUtils.cpp modification is needed to prevent this\nassertion [1]:\n\n```\nAssertion failure:\nnsLayoutUtils::IsProperAncestorFrameConsideringContinuations(\n  aLimitAncestor, asrFrame.mFrame)\n```\n\nTeach\n`nsLayoutUtils::IsAncestorFrameCrossDocInProcessConsideringContinuations()`\nthe concept of IB-split so that `DOMIntersectionObserver` [2] works\nwhen calling from `ComputePositionVisibility()`.\n\n[1] https://searchfox.org/firefox-main/rev/935d871d99c5ccb94a8a8b087241d08b4fe1deae/layout/base/DisplayPortUtils.cpp#1272-1273\n[2] https://searchfox.org/firefox-main/rev/935d871d99c5ccb94a8a8b087241d08b4fe1deae/dom/base/DOMIntersectionObserver.cpp#817-825\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322477\n", "files": ["layout/base/AnchorPositioningUtils.cpp", "layout/base/DisplayPortUtils.cpp", "layout/base/nsLayoutUtils.cpp", "testing/web-platform/tests/css/css-anchor-position/position-visibility-anchors-visible-inline-cb.html"], "git_node": "d9f248df0752d738e1e3cb015190fa0af9296020", "git_parents": ["f328cdda7bc2087cf73443b4af8ffb11897329dd"], "node": "71e45e828212344892954b9937ce75d9c93a05ed", "parents": ["225691dd43dc84c0af0becd78a28e271f954c817"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1860411 - Remove the gfx.e10s.font-list.shared pref r=mconley,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322404\n", "files": ["browser/base/content/test/performance/browser_startup_mainthreadio.js", "gfx/thebes/gfxPlatformFontList.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "629e70803c769bd56d6a4400bc0ee7867cbd874d", "git_parents": ["d9f248df0752d738e1e3cb015190fa0af9296020"], "node": "b3b974e58a7939a53309a1df6f6bb5b54c977c17", "parents": ["71e45e828212344892954b9937ce75d9c93a05ed"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2068000 - Fix some clippy nits in nsstring. r=xpcom-reviewers,mccr8\n\nThese show up when running cargo clippy on dependent crates in the same\nworkspace.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322562\n", "files": ["xpcom/rust/nsstring/src/conversions.rs"], "git_node": "ee02490d6704378e0986883266925cb31cd8418a", "git_parents": ["629e70803c769bd56d6a4400bc0ee7867cbd874d"], "node": "9492796410b7aa96f23121c79d6bcb68b69e949f", "parents": ["b3b974e58a7939a53309a1df6f6bb5b54c977c17"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1578480 - Remove the unused --disable-wmf and --disable-ffmpeg flags on moz.configure r=firefox-build-system-reviewers,sergesanspaille\n\nThe bug also mentions the --disable-av1 and --disable-fmp4 flags, but it seems those have been removed already.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322052\n", "files": ["toolkit/moz.configure"], "git_node": "d785fe83c7efec53713460929ecd7836a417840d", "git_parents": ["ee02490d6704378e0986883266925cb31cd8418a"], "node": "55f0533fdc2c9b7f12b8d2be0fe3569bb162b590", "parents": ["9492796410b7aa96f23121c79d6bcb68b69e949f"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2068156 - Bug 2067000 - Skip parsing a URI to look for a password the spec cannot hold. r=necko-reviewers,valentin\n\nConsole and nsScriptError both build an nsIURI out of a script filename on\nevery message, purely to ask whether it carries a password worth hiding. On\nthe console.clear() testcase in the bug that parse is 19% of the content\nprocess main thread.\n\nA password only reaches nsIURI through a userinfo component, and every\nimplementation that can report a non-empty one - nsStandardURL, DefaultURI,\nand SubstitutingJARURI, which forwards to its source URL - derives it from a\nliteral '@'. Scanning for that byte first leaves the sanitizing path\nunchanged and skips the parse otherwise.\n\nBoth call sites now share NS_GetSanitizedSpecFromSpec rather than spelling\nthe same check two different ways. That unifies one behaviour difference: on\na spec that has a password which cannot be hidden, Console used to fall back\nto the raw spec, and nsScriptError to an empty string. The helper keeps\nnsScriptError's behaviour, since emitting a spec known to contain a password\nis the one outcome worth avoiding.\n\nConsole also had an NS_IsMainThread() check in front of the sanitizing,\nadded by bug 1246091 in 2016 when this code first became reachable from\nworkers and NS_NewURI was main thread only. Bug 1536744 renamed\nNS_NewURIOnAnyThread to NS_NewURI in 2019, and nsIURI is immutable and\nthreadsafe, so the check has been dead weight since then. Dropping it also\nmeans worker console events reaching a chrome console event handler - via\nsetConsoleEventHandler or retrieveConsoleEvents - get the same sanitizing\nmain thread ones already got.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321766\n", "files": ["dom/bindings/nsScriptError.cpp", "dom/console/Console.cpp", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "netwerk/test/gtest/TestSanitizedSpec.cpp", "netwerk/test/gtest/moz.build"], "git_node": "de09a5f0cc77e0c657a84944c795d1090a3bf186", "git_parents": ["d785fe83c7efec53713460929ecd7836a417840d"], "node": "77f7147935b04df5d06cbc50a15d2b1fc23fd521", "parents": ["55f0533fdc2c9b7f12b8d2be0fe3569bb162b590"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2068157 - Bug 2067000 - Read the process type once in ConsoleAPIStorage. r=devtools-reviewers,jdescottes\n\n_isDestroyedInnerWindow is a no-op outside the parent process, but it decides\nthat by reading Services.appinfo.processType, which is a full XPConnect\ngetter round trip, on every recorded console event. That is 3.3% of the\ncontent process main thread on the testcases in this bug.\n\nThe process type cannot change, so hoist it to module scope. This matches\nwhat LoginManager, FirefoxRelay and GuardianClient already do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321767\n", "files": ["dom/console/ConsoleAPIStorage.sys.mjs"], "git_node": "02b7ebeff6c802d8ede9f14c517e269f3eda06ce", "git_parents": ["de09a5f0cc77e0c657a84944c795d1090a3bf186"], "node": "40ec2a33701bc947aabf9621c0964df89a600e8d", "parents": ["77f7147935b04df5d06cbc50a15d2b1fc23fd521"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067159 - Isolate root prefs for concurrent xpcshell harness runs. r=ahal\" as per request.\n\nThis reverts commit ce9726d8e85e4e13273b95d480fdedb92b38c951.\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "9c65160a11aeab54ca9856288bbc2f158ac74971", "git_parents": ["02b7ebeff6c802d8ede9f14c517e269f3eda06ce"], "node": "ba813a550b5b27b4298e7a495216998e35b2191a", "parents": ["40ec2a33701bc947aabf9621c0964df89a600e8d"], "tags": []}, {"author": "Chris DuPuis \u003ccdupuis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058020 - Use Windows Runtime API to find MSIX app launch method r=aborondo,win-reviewers,browser-installer-reviewers,mossop,nrishel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316649\n", "files": ["browser/app/winlauncher/LauncherProcessWin.cpp", "browser/app/winlauncher/moz.build"], "git_node": "ec1e82d3de53d9c6710b72ed5f8b534067814073", "git_parents": ["9c65160a11aeab54ca9856288bbc2f158ac74971"], "node": "36e3eee8858e4d02253be992e82b07cd5cd60565", "parents": ["ba813a550b5b27b4298e7a495216998e35b2191a"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065674 - update select border color r=desktop-theme-reviewers,hjones\n\nImports `select-border-color` token from Figma and applies to moz-select\nso that the default border uses the interactive gray instead of purple.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320604\n", "files": ["toolkit/content/widgets/moz-select/moz-select.nova.tokens.json", "toolkit/content/widgets/moz-select/moz-select.tokens.css", "toolkit/content/widgets/moz-select/moz-select.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/sha