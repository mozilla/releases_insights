d-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini"], "git_node": "58dc1aa78388605ef24113561be3ad706e4ea9f0", "git_parents": ["d63f5809f68189ebad5405836b8bd5e4c2572a7b"], "node": "5730010ae5c2731ea5a003671abcb03e678eeb33", "parents": ["69787c17cd2a675c55f52a8e35a68547153a9b61"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054947 - [devtools] Cleanup newGeneratedSource(s) r=devtools-reviewers,ochameau\n\n- This removes `newGeneratedSource` which seems to no longer be used.\n- Also no longer return sources from `newGeneratedSources`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323320\n", "files": ["devtools/client/debugger/src/actions/sources/newSources.js"], "git_node": "20a8abdc2a2f2212367f3a3ab4723bfb3fa3f992", "git_parents": ["58dc1aa78388605ef24113561be3ad706e4ea9f0"], "node": "37ecb95c3800ccca6098631435addd2ab39d967e", "parents": ["5730010ae5c2731ea5a003671abcb03e678eeb33"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068128 - Improve generation of white-listed files for clang-tidy r=sylvestre\" for causing spidermonkey build butages on uset.h.\n\nThis reverts commit d63f5809f68189ebad5405836b8bd5e4c2572a7b.\n", "files": ["build/clang-plugin/ThirdPartyPaths.py", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "a554e2ca28f1d26b560ae4753ea2ee99beab5049", "git_parents": ["20a8abdc2a2f2212367f3a3ab4723bfb3fa3f992"], "node": "edbbc4fdb6e3925b8504cf90687bcfb7fd557459", "parents": ["37ecb95c3800ccca6098631435addd2ab39d967e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1677741 - set priority of backfilled perf tasks to very-low r=taskgraph-reviewers,releng-reviewers,ahal,jlorenzo\n\nUpdate the backfill-task action to detect when the backfill target is a\nperf test, and when that is the case, set the task priority of any task\nit schedules (the perf test and its dependencies) to very-low, to avoid\ninterfering with more recent pushes.  Other backfills are left alone\nsince they're often blocking reopening the tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296404\n", "files": ["taskcluster/gecko_taskgraph/actions/backfill.py", "taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_actions_backfill.py"], "git_node": "5e45f18f9d52ffdd675e70ccc476253267270c70", "git_parents": ["a554e2ca28f1d26b560ae4753ea2ee99beab5049"], "node": "4ebeb339d48c295d16af1339a7497663dd264289", "parents": ["edbbc4fdb6e3925b8504cf90687bcfb7fd557459"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2068658 - Update happy-eyeballs to v1.0.0 r=kershaw,necko-reviewers\n\nv1.0.0 adds by-name connection modes: NetworkConfig gains a resolution field\n(ResolutionMode::ByIp, ByName, ByNameWithHttpsRr) to connect to the origin by\nhostname instead of racing resolved addresses. Firefox keeps the default ByIp,\nso behavior is unchanged.\n\nEndpoint::address became Endpoint::target, an EndpointTarget enum, with an\nEndpoint::address() accessor returning Option\u003cSocketAddr\u003e. Adapt the glue:\ntreat a missing address, which only the by-name modes can produce, as no\nevent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322986\n", "files": [".cargo/config.toml.in", "Cargo.lock", "netwerk/protocol/http/happy_eyeballs_glue/Cargo.toml", "netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/happy_eyeballs_glue/src/profiler.rs", "third_party/rust/happy-eyeballs/.cargo-checksum.json", "third_party/rust/happy-eyeballs/.github/workflows/claude.yml", "third_party/rust/happy-eyeballs/.github/workflows/mutants.yml", "third_party/rust/happy-eyeballs/.github/workflows/rust.yml", "third_party/rust/happy-eyeballs/.github/workflows/sbom.yml", "third_party/rust/happy-eyeballs/Cargo.lock", "third_party/rust/happy-eyeballs/Cargo.toml", "third_party/rust/happy-eyeballs/src/lib.rs", "third_party/rust/happy-eyeballs/tests/common/mod.rs", "third_party/rust/happy-eyeballs/tests/connect_by_name.rs", "third_party/rust/happy-eyeballs/tests/connection_attempts.rs", "third_party/rust/happy-eyeballs/tests/failure.rs", "third_party/rust/happy-eyeballs/tests/hostname_resolution.rs", "third_party/rust/happy-eyeballs/tests/https_records.rs"], "git_node": "46b0d1f15fe3e7f9c7ce605a90ef605bdd0c92f0", "git_parents": ["5e45f18f9d52ffdd675e70ccc476253267270c70"], "node": "f15e5f83a0a54e5c6193cc35c534e3c9174ada44", "parents": ["4ebeb339d48c295d16af1339a7497663dd264289"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2068540 - Abort off-thread script compilation when the request is cancelled. r=arai,spidermonkey-reviewers\n\nAdd a cancellation flag to js::FrontendContext, polled where the frontend\nstarts on a script, a function or its bytecode, so that a cancelled\nStencilCompileOrDecodeTask aborts instead of finishing work whose result is\ndiscarded. Decode and wasm compilation have no poll points.\n\nThis saves CPU cycles on pages which cancel compiles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322930\n", "files": ["dom/script/ScriptLoadContext.h", "dom/script/ScriptLoader.cpp", "js/public/experimental/CompileScript.h", "js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/FoldConstants.cpp", "js/src/frontend/FrontendContext.cpp", "js/src/frontend/FrontendContext.h", "js/src/frontend/Parser.cpp", "js/src/jsapi-tests/testFrontendErrors.cpp"], "git_node": "7c8b91d6d8b4f00fb78732ccb69891ea8bfd35cb", "git_parents": ["46b0d1f15fe3e7f9c7ce605a90ef605bdd0c92f0"], "node": "14183adfd0e8e159cd5795ed26631435a71c5557", "parents": ["f15e5f83a0a54e5c6193cc35c534e3c9174ada44"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2066675 - Remove the unused customizing-movingItem attribute r=kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323210\n", "files": ["browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_978084_dragEnd_after_move.js"], "git_node": "c86e0776d8922d814159f1ae14a0579eb4061e8b", "git_parents": ["7c8b91d6d8b4f00fb78732ccb69891ea8bfd35cb"], "node": "cea13ccc8f7b659e4ab82fbdc8051ded4667d64c", "parents": ["14183adfd0e8e159cd5795ed26631435a71c5557"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2067722 - coverity: mark the ots::Buffer read destination as written r=sergesanspaille DONTBUILD\n\nThe model added in bug 2059416 routes every ReadU8/ReadU16/.../ReadR64\nthrough a Read() that sanitizes the taint of *buf but never writes it,\nwhile the real ots::Buffer::ReadU16() and friends do. Coverity therefore\ntreats the destination of a successful read as still uninitialized, and\nsince every OTS parser is written as\n\n    uint8_t format;\n    if (!subtable.ReadU8(&format) || ...)\n\nthat produced 136 UNINIT reports across gfx/ots, 135 of them first\ndetected the day the model was uploaded.\n\nAdd __coverity_writeall__() on the success path, keeping the sanitize\ncall that bug 2059416 was about.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322305\n", "files": ["tools/coverity/model_file.cpp"], "git_node": "fa76439edaf35015990dac12ec9fc2b4fb38323a", "git_parents": ["c86e0776d8922d814159f1ae14a0579eb4061e8b"], "node": "e851b97ad4f306053dd8e88a9f83c26e0d4cea8e", "parents": ["cea13ccc8f7b659e4ab82fbdc8051ded4667d64c"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2069139 [Linux][Vulkan Video] Pad LINEAR NV12 export pitch for foreign-GPU EGL import. r=stransky,media-playback-reviewers\n\nLINEAR often uses pitch==width; NVIDIA/AMD PRIME needs 256B alignment\n(Mesa ISL). Widen the copy-ring image when exporting LINEAR to another\nGPU so UV is not misread as the wrong stride (green video / GL context\nloss).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323421\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp"], "git_node": "55213bae99d2878e38b75c7d627d0f165c859536", "git_parents": ["fa76439edaf35015990dac12ec9fc2b4fb38323a"], "node": "17731026bb580288d473ab3125abd8afd9e42987", "parents": ["e851b97ad4f306053dd8e88a9f83c26e0d4cea8e"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064737 - Build the onnxruntime toolchain against the sysroot. r=firefox-build-system-reviewers,sergesanspaille\n\nThe linux onnxruntime task builds in a Debian 12 image with no sysroot, so the\nlibrary we ship ends up requiring GLIBC_2.34 and GLIBCXX_3.4.30, meaning a\nsystem no older than Debian 12 or Ubuntu 22.04. Firefox dlopens the library\nlazily (dom/onnx/InferenceSession.cpp), so rather than failing loudly, on any\nolder system InferenceSession::isAvailable() returns false and the ML code\nquietly falls back to the wasm backend.\n\nBuild it against sysroot-x86_64-linux-gnu, the same sysroot the linux64 Firefox\nbuilds use. That brings the glibc requirement down to GLIBC_2.16.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320000\n", "files": ["taskcluster/kinds/toolchain/onnx.yml", "taskcluster/scripts/misc/build-onnxruntime.sh"], "git_node": "5087f684d8223630b31ffa9852db8f517b412bb1", "git_parents": ["55213bae99d2878e38b75c7d627d0f165c859536"], "node": "c8f2cd4f1dcc81c464d797b8783288aa3172b1ee", "parents": ["17731026bb580288d473ab3125abd8afd9e42987"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064737 - Link libstdc++ statically into the onnxruntime library. r=firefox-build-system-reviewers,sergesanspaille\n\nBuilding against the sysroot fixes the glibc requirement, but the library still\nneeds GLIBCXX_3.4.26 and CXXABI_1.3.11, against a baseline of GLIBCXX_3.4.19 and\nCXXABI_1.3.7. That would still lose the native backend on anything older than\nlibstdc++ from gcc 9, which includes Debian 10 and RHEL 8.\n\nMost of that could be shimmed the way build/unix/stdc++compat does it, which\nalready handles _Sp_make_shared_tag::_S_eq and the stringstream constructors at\nthat exact version, and aligned new is the same shape as the operator\ndelete(void*, size_t) shim there. std::filesystem is the exception: it isn't a\ntemplate, so the explicit instantiation trick doesn't apply, its members are out\nof line in libstdc++.so, and shimming them means replicating path::_List and\n_Impl exactly. The sysroot's libstdc++fs.a is no help, since gcc 9 moved the\nC++17 filesystem into libstdc++.so and left it holding only\nstd::experimental::filesystem. Going that way would also mean porting a\nFirefox-internal compat layer, and its mfbt dependency, into a third-party CMake\nbuild and keeping the two in sync.\n\nSo link libstdc++ statically instead. That is safe here because upstream's\nversion script exports only OrtGetApiBase and\nOrtSessionOptionsAppendExecutionProvider_CPU, the interface Firefox uses is the\nORT C API, and the library is dlopened with PR_LD_LOCAL, so no C++ symbols or\nobjects cross into Gecko. The library no longer links against libstdc++.so.6 at\nall.\n\nA static libstdc++ does bring in its __cxa_thread_atexit, a bare forward to\nglibc's __cxa_thread_atexit_impl, which is the only GLIBC_2.18 symbol. The\nstdc++compat shim can't help there: it forwards to __cxa_thread_atexit, which\nagainst a static libstdc++ is that same forward calling back into it. So provide\na real implementation, the same pthread key approach libstdc++ itself uses when\nglibc has no __cxa_thread_atexit_impl. The library ends up at GLIBC_2.16, with no\nGLIBCXX_ or CXXABI_ dependency at all.\n\nThe library grows by 545KB unstripped, which is not measurable in the packaged\nsize: linux64 target.tar.xz went from 94418972 to 94366924 bytes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320001\n", "files": ["taskcluster/kinds/toolchain/onnx.yml", "taskcluster/scripts/misc/build-onnxruntime.sh", "taskcluster/scripts/misc/onnxruntime-thread-atexit.cpp"], "git_node": "8cf01d48fd80e3762f2adffe038460675eb8fd48", "git_parents": ["5087f684d8223630b31ffa9852db8f517b412bb1"], "node": "fd89e7a361dad1060bced133185d909bc49d940f", "parents": ["c8f2cd4f1dcc81c464d797b8783288aa3172b1ee"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064737 - Run check_binary on prebuilt libraries installed by FINAL_TARGET_FILES. r=firefox-build-system-reviewers,sergesanspaille,glandium,ahochheiden\n\nLibraries we link ourselves are checked for compatibility with the\nsystems we support as part of the link rule, but a prebuilt one dropped\ninto FINAL_TARGET_FILES is only copied, so nothing checks it.\nlibonnxruntime is currently the only one, and it shipped needing\nGLIBC_2.34 for a while without anything noticing.\n\nFINAL_TARGET_FILES treats absolute paths separately, so that install\nrule is the place to do this.\n\ncheck_binary skips anything that isn't ELF, so on Windows and macOS this\nonly costs a file type check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320125\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/data/final-target-files-absolute/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "d8e72d0d8b4015819acc7b3effac9976be3c85fa", "git_parents": ["8cf01d48fd80e3762f2adffe038460675eb8fd48"], "node": "7900dae9408a6358f382447ebe47c8ad44e217ea", "parents": ["fd89e7a361dad1060bced133185d909bc49d940f"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054767. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323054\n", "files": ["toolkit/actors/ContentMetaChild.sys.mjs", "toolkit/actors/ContentMetaParent.sys.mjs"], "git_node": "50293a1961fb0bc653e0cc7a43a7736a71797080", "git_parents": ["d8e72d0d8b4015819acc7b3effac9976be3c85fa"], "node": "b9ba563ac6763ec4bb2c4bfd05293ce87e3715e9", "parents": ["7900dae9408a6358f382447ebe47c8ad44e217ea"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064287 - Harden drag handling; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321984\n", "files": ["dom/base/PointerLockManager.cpp", "dom/events/EventStateManager.cpp", "dom/events/EventStateManager.h", "dom/ipc/BrowserParent.cpp", "widget/nsBaseDragService.cpp", "widget/nsIDragService.idl"], "git_node": "f94dc29b1565f7cebd787b606f8179d7afccf752", "git_parents": ["50293a1961fb0bc653e0cc7a43a7736a71797080"], "node": "1305c5ffedc2454b921746163ca37d7595d1c532", "parents": ["b9ba563ac6763ec4bb2c4bfd05293ce87e3715e9"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019992 - un-reverse suffix-list diff. r=releng-reviewers,bhearsum DONTBUILD\n\nHG_SUFFIX_LOCAL is what's currently in the repo, PUBLIC_SUFFIX_LOCAL is\nthe new version we downloaded from publicsuffix.org.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323570\n", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": "de3164f94d82811f263f7ab5362b5e27586384ff", "git_parents": ["f94dc29b1565f7cebd787b606f8179d7afccf752"], "node": "808d8ab9e2650986002ac504a8f2b518b57830dd", "parents": ["1305c5ffedc2454b921746163ca37d7595d1c532"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062077 - Deduplicate storage access promise resolve/reject logic in Document r=timhuang\n\nRequestStorageAccess and RequestStorageAccessForOrigin repeated the same\nresolve-or-reject-with-NotAllowedError logic at every step. Factor it into\ntwo small helpers and drop two locals that were\nonly ever used for a null check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320102\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h"], "git_node": "c36c839b10400a7234d64f3015c4959121f89348", "git_parents": ["de3164f94d82811f263f7ab5362b5e27586384ff"], "node": "d112fbb2a726ee29c59b99c7a65b2e5322c5e57e", "parents": ["808d8ab9e2650986002ac504a8f2b518b57830dd"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2058017 - Backport win11 UILIMIT_HANDLES fix. r=yjuglaret,sandbox-reviewers,sotaro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316613\n", "files": ["gfx/layers/ipc/CompositorThread.cpp", "gfx/webrender_bindings/RenderThread.cpp", "modules/libpref/init/StaticPrefList.yaml", "mozglue/misc/WindowsUserHandleValidation.h", "mozglue/misc/moz.build", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp", "widget/windows/WinCompositorWindowThread.cpp"], "git_node": "95fab400ff8b98cb608e4f4260d8261818ad9cf6", "git_parents": ["c36c839b10400a7234d64f3015c4959121f89348"], "node": "919637842f4f267fab96e5551e8ce516863efd92", "parents": ["d112fbb2a726ee29c59b99c7a65b2e5322c5e57e"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1995348 - Implement the \"grid-lanes\" value for the \"display\" property r=layout-reviewers,firefox-style-system-reviewers,dholbert,emilio\" for causing WR failures @ /css/css-anchor-position/grid-lanes-position-area-basic.html\n\nThis reverts commit 58dc1aa78388605ef24113561be3ad706e4ea9f0.\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsGridContainerFrame.cpp", "layo