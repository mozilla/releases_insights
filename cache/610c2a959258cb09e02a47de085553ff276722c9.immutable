t/privileged.py"], "git_node": "12e70a0e1864306d1fe2b20f84cc5ca54e0d6d3f", "git_parents": ["043ca485b40d8d4fbe8a96f3143dd0ec712e8fe1"], "node": "220a70647c64cc533fa6b0e4a2d005edc54c6704", "parents": ["a839e4d258d9034cca85e648c3863508fbef83a8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065180 - Deal with abspos ASRs correctly when building the top layer. r=tnikkel,layout-reviewers,layout-anchor-positioning-reviewers,dshin\n\nCleaned-up version of D324081.\n\nThe assertion in the bug is one symptom; the other is that such a frame\ndoesn't follow its anchor during an async scroll, which the reftest\ncovers.\n\nCo-Authored-By: D\u00e3o Gottwald \u003cdao@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324111\n", "files": ["layout/base/DisplayPortUtils.cpp", "layout/base/DisplayPortUtils.h", "layout/generic/ViewportFrame.cpp", "layout/generic/nsIFrame.cpp", "layout/reftests/async-scrolling/anchor-pos-top-layer-1-ref.html", "layout/reftests/async-scrolling/anchor-pos-top-layer-1.html", "layout/reftests/async-scrolling/reftest.list"], "git_node": "313ff79ac30bf139427d70aaf89ab7316ab099de", "git_parents": ["12e70a0e1864306d1fe2b20f84cc5ca54e0d6d3f"], "node": "0c9ba60ed826ebf4ff064db53e3526a8ab0b9399", "parents": ["220a70647c64cc533fa6b0e4a2d005edc54c6704"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994840 - Re-enable browser_mixed_content_cert_override.js on macOS 15.30 aarch64 r=emz\n\nBug 1997430 tracked the same failure as this bug: the same test, the same bare\n\"Test timed out\" at 44 seconds with the first task passing and the second task\nproducing no output at all, and the same regressor in bug 1994309. It was never\nfixed, only skipped in bulk along with a batch of unrelated macOS failures in\nbug 2001881. Now that the underlying race in the legacy sub-run is fixed,\nre-enable the test on that configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317395\n", "files": ["browser/base/content/test/siteIdentity/browser.toml"], "git_node": "3e144adde43914558020703097890b2823513ac6", "git_parents": ["313ff79ac30bf139427d70aaf89ab7316ab099de"], "node": "f76ec1cc56f940808f876e4ac25d12cc18c1b317", "parents": ["0c9ba60ed826ebf4ff064db53e3526a8ab0b9399"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063488 - Only allow the parent process to set the service worker BrowsingContext flags. r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322297\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h"], "git_node": "4104747738baada761d06f59b81df8c3c6c2f0b6", "git_parents": ["3e144adde43914558020703097890b2823513ac6"], "node": "5db7c72ad554789b92fb5a27e46c7af4c8a5b50a", "parents": ["f76ec1cc56f940808f876e4ac25d12cc18c1b317"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2008577 - Upgrade vendored markdown-it-py to 4.2.0 r=ahal,mach-reviewers,ahochheiden\n\nmyst-parser 5.x requires markdown-it-py ~=4.2, but the tree vendors 3.0.0\nand taskcluster/requirements.in caps it below 4. That cap was added in\n524c505b0b94 when the previous myst-parser 5.1.0 update was backed out,\nand is marked temporary: it only exists to keep myst-parser 2.0.0\nresolvable. Lift it so the sphinx 9 upgrade can proceed.\n\nrich is the only real consumer and requires markdown-it-py\u003e=2.2.0.\nNeither taskcluster-taskgraph nor mozilla-taskgraph depends on it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324270\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt", "third_party/python/markdown_it_py/markdown_it/__init__.py", "third_party/python/markdown_it_py/markdown_it/_compat.py", "third_party/python/markdown_it_py/markdown_it/_punycode.py", "thir