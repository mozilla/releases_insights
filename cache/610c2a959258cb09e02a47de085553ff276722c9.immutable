std when building against a sysroot. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit b06f4b70348895945d65ef3a379f4412609e3108.\n\nRevert \"Bug 2010541 - Stop exporting undefined disassembler symbols from clang 14's libLTO and libRemarks. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit c41f6ab34f0b247c19afd456a43cdf8f99aeb274.\n", "files": ["build/build-clang/build-clang.py", "build/build-clang/clang-14.json", "build/build-clang/llvmorg-17-init-946-gc294bdd64768_clang_14.patch", "build/build-clang/llvmorg-17-init-947-gbf07de38b05e_clang_14.patch", "build/build-clang/use-system-clang.json", "build/unix/build-binutils/build-binutils.sh", "build/unix/build-gcc/build-gcc.sh", "taskcluster/docker/toolchain-build/Dockerfile", "taskcluster/gecko_taskgraph/transforms/job/toolchain.py", "taskcluster/kinds/toolchain/gn.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/kinds/toolchain/upx.yml", "taskcluster/scripts/misc/build-gn-linux.sh", "taskcluster/scripts/misc/build-llvm-common.sh", "taskcluster/scripts/misc/build-mkbom-linux.sh", "taskcluster/scripts/misc/build-upx.sh", "taskcluster/scripts/misc/build-winchecksec.sh", "taskcluster/scripts/misc/build-xar-linux.sh"], "git_node": "61fc3283e0d91b2bf8b40da19cdd2631538bcf03", "git_parents": ["23a81aee375cc303e3d08a4d53bdc8502edc03da"], "node": "79b6454b241ffd4882798d11fc05ddf72d0b512e", "parents": ["c556e5f3d05d6530bb397b7ef91fa80f86989e7d"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060247 - fix build bustages.\n", "files": ["dom/media/gtest/moz.build"], "git_node": "ef00335a4a3047589672cae2f824a3027540be80", "git_parents": ["61fc3283e0d91b2bf8b40da19cdd2631538bcf03"], "node": "0dee66c2f262e38fa83c6ee902cab53dc34330b3", "parents": ["79b6454b241ffd4882798d11fc05ddf72d0b512e"], "tags": []}], "date": 1788904302, "git_changesets": ["b4e75b7a59d5dc2f561bbd5b96202e7560e309e5", "b3cd4bc9bb2bbcecfbd9c8fcd527e0b648