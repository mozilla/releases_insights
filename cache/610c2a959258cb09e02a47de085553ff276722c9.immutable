sts/css/css-mixins/function-relative-units.html"], "git_node": "dd301d0661e279a42ff8e490c26f4b65aef9d3fc", "git_parents": ["829c61336d7be68b837ab124e0d1c0efdb9bb064"], "node": "f6e370c43ca540d9ad1e45a3031338ca321f5b2d", "parents": ["f2c5dfa49ee1dc917c5f9dbc1fa241e4f50f41fb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067764 [wpt PR 62263] - Update wpt metadata, a=testonly\n\nwpt-pr: 62263\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/function-definition-scope.html.ini", "testing/web-platform/meta/css/css-mixins/function-parameter-scoping.html.ini", "testing/web-platform/meta/css/css-mixins/function-relative-units.html.ini"], "git_node": "4fd075c03f310346949925c9254c860a3e73b6b9", "git_parents": ["dd301d0661e279a42ff8e490c26f4b65aef9d3fc"], "node": "93d7b12e8c1295875d46793acb8f5fd51dc57646", "parents": ["f6e370c43ca540d9ad1e45a3031338ca321f5b2d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067769 [wpt PR 62253] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321425, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export: [css-values-5] Fix substitution of numbers and CSS units for custom properties using attr() (#62253)\n\nhttps://bugs.webkit.org/show_bug.cgi?id=321425\n\nCo-authored-by: Tim Nguyen \u003cnt1m@users.noreply.github.com\u003e\n--\n\nwpt-commits: 1c886cd632991398f2418883d6d45a34a8951b8e\nwpt-pr: 62253\n", "files": ["testing/web-platform/tests/css/css-values/attr-all-types.html", "testing/web-platform/tests/css/css-values/attr-number-invalidation.html", "testing/web-platform/tests/css/css-values/attr-percent-invalidation.html"], "git_node": "4eaea959345f05841a820a4e1cde63612297c7cf", "git_parents": ["4fd075c03f310346949925c9254c860a3e73b6b9"], "node": "f814c1bf1ebd5e2b40e87f0325485089cdad6310", "parents": ["93d7b12e8c1295875d46793acb8f5fd51dc57646"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2067774 [wpt PR 62265] - Revert \"Built-In AI: Move Translator create user activation WPT to its own file\", a=testonly\n\nAutomatic update from web-platform-tests\nRevert \"Built-In AI: Move Translator create user activation WPT to its own file\"\n\nThis reverts commit 5edb7e90d621f54db30c9777b7616d0da07c2ffb.\n\nReason for revert: external/wpt/ai/translator/translator.optional.https.window.html flaky\n\nFailure Link: https://ci.chromium.org/ui/p/chromium/builders/ci/linux-blink-leak-rel/24361/overview\n\nOriginal change's description:\n\u003e Built-In AI: Move Translator create user activation WPT to its own file\n\u003e\n\u003e When running chrome_wpt_tests on bots with pre-installed or sideloaded\n\u003e models, Translator availability starts as available. This caused the\n\u003e downloadable precondition assertion in\n\u003e translator.optional.https.window.js to fail, flakily failing the entire\n\u003e test suite despite all translation functionality subtests passing.\n\u003e\n\u003e Bug: 510552929\n\u003e Change-Id: I7987656d0a8eb8f24299277d927c2a8f1d9fb332\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8280374\n\u003e Reviewed-by: Danilo Tedeschi \u003cdanft@google.com\u003e\n\u003e Commit-Queue: Danilo Tedeschi \u003cdanft@google.com\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1687658}\n\nBug: 510552929\nNo-Presubmit: true\nNo-Tree-Checks: true\nNo-Try: true\nChange-Id: Idc282515c7cb1aa1027e9b50181833c445f1500d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8313947\nBot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\nCommit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\nAuto-Submit: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1687843}\n\n--\n\nwpt-commits: 6ff6436482fa8bd91cc077286260dca1227d056a\nwpt-pr: 62265\n", "files": ["testing/web-platform/tests/ai/translator/translator-create-user-activation.optional.https.window.js", "testing/web-platform/tests/ai/translator/translator.optional.https.window.js"], "git_node": "602922743d07f9563903855a04aff6bb5894f155", "git_parents": ["4eaea959345f05841a820a4e1cde63612297c7cf"], "node": "b4522401c36c47dd0f76631f932416f61f9fc84e", "parents": ["f814c1bf1ebd5e2b40e87f0325485089cdad6310"], "tags": []}, {"author": "Frank Li \u003cfrankli@microsoft.com\u003e", "branch": "default", "desc": "Bug 2067777 [wpt PR 62252] - [Prompt API] Support caller-supplied tool-call history - blink layer CL, a=testonly\n\nAutomatic update from web-platform-tests\n[Prompt API] Support caller-supplied tool-call history - blink layer CL\n\nAllow structured tool calls in initial prompts and append() input.\nConvert tool-call arguments into Mojo dictionary values while enforcing\nrole and serialization constraints.\n\nUpdate the Echo backend to advertise the capability and serialize\nhistorical tool calls for web-test observation. Add WPT coverage for\ninitial history, append and recreation, argument conversion, invalid\nroles, serialization failures, and unavailable capability.\n\nTest: autoninja -C out/debug_x64 blink_tests\nTest: third_party\\blink\\tools\\run_web_tests.bat -t debug_x64 --no-retry-failures virtual/ai_tool_use/external/wpt/ai/language-model/language-model-tool-use.tentative.https.window.js\n\nBug: 422803232\nChange-Id: I838f8aa0ec9d5591d9946ee1c1be1d82b70cb610\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8285949\nReviewed-by: Jingyun Liu \u003cjingyun@google.com\u003e\nReviewed-by: Mike Wasserman \u003cmsw@chromium.org\u003e\nCommit-Queue: Frank Li \u003cfrankli@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1687877}\n\n--\n\nwpt-commits: 7e032a49dac1e651c3eb7705e24e3cfc94e87e93\nwpt-pr: 62252\n", "files": ["testing/web-platform/