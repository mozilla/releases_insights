/track-sizing/grid-lanes-track-sizing-explicit-block.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-span-row.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-within-flexbox-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini"], "git_node": "bbc2bc5fb903b9e1a4b1b1c0617577d3fe0712c0", "git_parents": ["95fab400ff8b98cb608e4f4260d8261818ad9cf6"], "node": "1b3cc64d718a08b0f6e2fe50e6ee96f5927babdc", "parents": ["919637842f4f267fab96e5551e8ce516863efd92"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068378 - Dispatch pass-through OnDataAvailable to the main thread in nsHTTPCompressConv r=necko-reviewers,valentin\n\nRead the data and hand it to do_OnDataAvailable() when a bounce is\nneeded; keep the direct pass-through otherwise.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322964\n", "files": ["netwerk/streamconv/converters/nsHTTPCompressConv.cpp"], "git_node": "3c4e44c12d9668b04b505f279ec1cb526a9e93b7", "git_parents": ["bbc2bc5fb903b9e1a4b1b1c0617577d3fe0712c0"], "node": "c460b93ac5d5eb9ad1309f38b7e5175cdbd23b5b", "parents": ["1b3cc64d718a08b0f6e2fe50e6ee96f5927babdc"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066923 - Quota manager: use signed integers for usage values which we know can underflow. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322186\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/Assertions.cpp", "dom/quota/Assertions.h", "dom/quota/AssertionsImpl.h", "dom/quota/CanonicalQuotaObject.cpp", "dom/quota/ClientUsageArray.cpp", "dom/quota/ClientUsageArray.h", "dom/quota/CommonMetadata.cpp", "dom/quota/CommonMetadata.h", "dom/quota/GroupInfo.cpp", "dom/quota/GroupInfo.h", "dom/quota/OriginInfo.cpp", "dom/quota/OriginInfo.h", "dom/quota/OriginOperations.cpp", "dom/quota/QuotaManager.h", "dom/quota/QuotaResults.cpp", "toolkit/components/resistfingerprinting/nsRFPService.cpp", "toolkit/components/resistfingerprinting/nsRFPService.h"], "git_node": "3ec29012fc1ea65d986be6522f8c21105dfe33c4", "git_parents": ["3c4e44c12d9668b04b505f279ec1cb526a9e93b7"], "node": "bc0f71ea62784c4daa9119af0c6e04a50bfde972", "parents": ["c460b93ac5d5eb9ad1309f38b7e5175cdbd23b5b"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2064287 - Harden drag handling; r=smaug\" for causing build bustages @ PointerLockManager.cpp\n\nThis reverts commit f94dc29b1565f7cebd787b606f8179d7afccf752.\n", "files": ["dom/base/PointerLockManager.cpp", "dom/events/EventStateManager.cpp", "dom/events/EventStateManager.h", "dom/ipc/BrowserParent.cpp", "widget/nsBaseDragService.cpp", "widget/nsIDragService.idl"], "git_node": "d414c7a5e2c9c5fd7af554b3e81a2b1c48dd3026", "git_parents": ["3ec29012fc1ea65d986be6522f8c21105dfe33c4"], "node": "593e644d49b7c9c46e945a0f6dd0a455318082ab", "parents": ["bc0f71ea62784c4daa9119af0c6e04a50bfde972"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049666 - Fixed hang in LlamaGenerateTask  r=ai-platform-reviewers,jbowser\n\nA short window in the \"single-producer single-consumer\" queue owned by LlamaGenerateTask allowed consumers to hang on a promise that was never resolved. A mutex now guards against that window by making sure sequences of operations done by the consumer and the producer are atomic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322897\n", "files": ["toolkit/components/ml/backends/llama/LlamaRunner.cpp", "toolkit/components/ml/backends/llama/LlamaRunner.h", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_native_backend_error.js"], "git_node": "7b22e8e2daa926ef51e29237e9aceac674975392", "git_parents": ["d414c7a5e2c9c5fd7af554b3e81a2b1c48dd3026"], "node": "204caea3617a2c13188610c9b77b411586a04c5d", "parents": ["593e644d49b7c9c46e945a0f6dd0a455318082ab"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068864 - Skip result payload validation in a content realm. r=mbeier\n\nThe dismissal-acknowledgment tip is the one result a content-realm view builds itself, because the dismissed result is already out of the query context by then and the tip's row label comes from view state the parent doesn't have. It therefore never crosses the wire, where fromWire skips validation for everything else. Moving the schemas into UrlbarShared wouldn't extend validation to that realm either, since JsonSchemaValidator ships only as a system module.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323181\n", "files": ["browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_trendingDismissal.js"], "git_node": "a173c68ff36d9f9c0b84a7e12ad2c96e7158bb31", "git_parents": ["7b22e8e2daa926ef51e29237e9aceac674975392"], "node": "64f8b5401201148d9aa42595a1fac435eabe9222", "parents": ["204caea3617a2c13188610c9b77b411586a04c5d"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069005 - Report whether a model install was refused or failed. r=media-playback-reviewers,alwu\n\nPHWInference::InstallModel answered with a plain bool, which cannot tell a\ndownload the task's resolver refused - the user dismissing the doorhanger -\nfrom one that was allowed but did not complete. Answer with\nModelInstallResult instead, so a caller can report the two differently.\n\nNo behavior change: the only consumer, PSpeechRecognition::InstallModels,\nstill collapses the answer to a bool.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323298\n", "files": ["dom/media/webspeech/recognition/SpeechRecognitionParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceTypes.h", "toolkit/components/ml/ipc/PHWInference.ipdl", "toolkit/components/ml/ipc/moz.build"], "git_node": "ce4240d71401c684a6e6adb8737133ae73b385bc", "git_parents": ["a173c68ff36d9f9c0b84a7e12ad2c96e7158bb31"], "node": "87d19940f631582e4326991813eccdc4af81e2b0", "parents": ["64f8b5401201148d9aa42595a1fac435eabe9222"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069005 - Report a refused model install to the content process. r=media-playback-reviewers,alwu\n\nCarry ModelInstallResult over PSpeechRecognition::InstallModels as well, and\nsplit the request itself out of Install() as SpeechRecognitionBackend::\nInstallModels(), so a caller that is not backing a DOM promise can make it.\n\ninstall() still resolves false either way; a refusal is only reported\ndifferently in the next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323299\n", "files": ["dom/media/webspeech/recognition/PSpeechRecognition.ipdl", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/SpeechRecognitionParent.cpp"], "git_node": "46feb341fbce9b5e434f25dd6e95f00d33263867", "git_parents": ["ce4240d71401c684a6e6adb8737133ae73b385bc"], "node": "9ffd05c1ebd77c4dbc960fe63523a56150046e59", "parents": ["87d19940f631582e4326991813eccdc4af81e2b0"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069005 - Split the second half of start() into BeginSession(). r=media-playback-reviewers,alwu\n\nEverything start() needs to bring a session up - the track, the caller type,\nthe effective language, the graph rate and the phrases - becomes a\nPendingSession that BeginSession() starts from, so that the next patch can\ndelay that half without touching it.\n\nThe [[started]] bookkeeping now happens before the backend is created rather\nthan after, so a backend that fails to be created (its thread could not be\nspawned) ends the session with \"error\" and \"end\" instead of \"error\" alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323300\n", "files": ["dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h"], "git_node": "f5578e65a9ccca1bf2073c3eea9235d3b1e88661", "git_parents": ["46feb341fbce9b5e434f25dd6e95f00d33263867"], "node": "f32586ba2b0868579abd19f13f8a8c9a8ca3c939", "parents": ["9ffd05c1ebd77c4dbc960fe63523a56150046e59"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069005 - Offer to install the model when start() needs one. r=media-playback-reviewers,alwu\n\nstart() required the on-device model for its language to already be\ninstalled, and failed the session with service-not-allowed otherwise. Pages\npredating install() - which is every page using this API today - only ever\ncall start(), so offer to download the model instead, and begin the session\nonce it is there.\n\nThe install is waited on before the backend is created and before the\nmicrophone is touched, so no event, \"start\" included, fires until the model\nis installed: the session merely starts later. A refused download ends the\nsession with not-allowed, like a refused microphone, and a download that\nfails with network. stop()/abort() during the wait end the session with\n\"end\" alone, and mSessionGeneration is what tells the pending continuation\nthat it no longer speaks for the current session.\n\nWith no language there is no model to ask for, so this only applies when\nstart() determined one. Controlled by\nmedia.webspeech.recognition.install_on_start.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323301\n", "files": ["dom/media/webspeech/recognition/SpeechRecognition.cpp", "dom/media/webspeech/recognition/SpeechRecognition.h", "dom/media/webspeech/recognition/SpeechRecognitionBackend.cpp", "dom/media/webspeech/recognition/SpeechRecognitionBackend.h", "dom/media/webspeech/recognition/test/browser_speech_recognition_process_lifetime.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "8d42b83d0bd3612734e96b82870b449c3d6a79d5", "git_parents": ["f5578e65a9ccca1bf2073c3eea9235d3b1e88661"], "node": "44cb9a62d8e08358e5cd1585f2b3c4dcd17aa757", "parents": ["f32586ba2b0868579abd19f13f8a8c9a8ca3c939"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2069005 - Add a mochitest for installing a model from start(). r=media-playback-reviewers,alwu\n\nCovers both outcomes of the download prompt start() now shows: refused ends\nthe session with not-allowed and no other event, allowed installs the model\nand fires \"start\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323302\n", "files": ["dom/media/webspeech/recognition/test/mochitest.toml", "dom/media/webspeech/recognition/test/test_install_on_start.html", "toolkit/components/ml/ipc/HWInferenceParent.cpp"], "git_node": "57a96d5f44307769b4084b6f8523a5b07afe6719", "git_parents": ["8d42b83d0bd3612734e96b82870b449c3d6a79d5"], "node": "26f2a191dbbd85cde7062467e237ec85359fc2cb", "parents": ["44cb9a62d8e08358e5cd1585f2b3c4dcd17aa757"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064917: Fold the coefficient splat in ConvolutionFilterAVX2's AccumRemainder into a single broadcast. r=lsalzman\n\nThe remainder tail relied on the SLP vectorizer to build a 32-bit coefficient\nsplat, and clang cannot fold a 16-bit load into that, so each of the up to\nseven unrolled taps emitted movzx + vmovd + vpbroadcastd. vpmovzxbd already\nzeroes the odd 16-bit lanes of the pixel vector, so pmaddwd's second product\nterm is always zero and a 16-bit broadcast is sufficient; vpbroadcastw folds\nthe load directly.\n\nWriting the accumulation with intrinsics takes convolve_horizontally_avx2 from\n159 to 145 instructions (the remainder tail from 62 to 48). Nothing else in the\nfunction changes, and the stack frame and spill counts are unaffected.\n\nThe pixel load uses _mm_loadu_si32 except on GCC older than 12, the first\nrelease with a usable one: it is absent in 10.x, and 11.1/11.2 define it as\n_mm_set_epi32(*(int*)P, 0, 0, 0), which does an aligned int load and lands the\nvalue in the high lane instead of the low one (PR99754, fixed by r12-7640 and\non the 11 branch after 11.2). Since the tree still supports GCC 10.1, those\ncompilers take an open-coded memcpy fallback. Both spellings generate the same\nvpmovzxbd with a folded load; I checked the emitted assembly for each.\n\nResults are bit-identical to the scalar form: pmaddwd on values bounded by\n32768*255 cannot overflow int32, and integer addition is associative, so\naccumulating into a local before the final add is exact. Checked over 3M random\ninputs (r in 1..7, random pixels, coefficients including 0 and both int16\nextremes).\n\nOnly the AVX2 copy changes. ConvolutionFilterSSE2.cpp keeps the scalar form\nbecause pmovzxbd is SSE4.1 and the broadcast fold needs AVX2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323132\n", "files": ["gfx/2d/ConvolutionFilterAVX2.cpp"], "git_node": "1d42fbce41a5a47c792685ca323194e7fee73581", "git_parents": ["57a96d5f44307769b4084b6f8523a5b07afe6719"], "node": "0dba5a02705d4445274a93ba893b61dbd51d22fa", "parents": ["26f2a191dbbd85cde7062467e237ec85359fc2cb"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068715: Use unchecked indexing in SkConvolutionFilter1D::FilterForValue r=lsalzman\n\nFilterForValue runs once per output pixel in the horizontal convolution\nkernels. Both fFilters[valueOffset] and fFilterValues[fDataLocation] went\nthrough mozilla::Vector's bounds-checked operator[], which reloads the vector\nlength and branches on every call. valueOffset is always in\n[0, numValues()) == fFilters.length(), and fDataLocation is set to a valid\nindex by AddFilter, so index the raw pointer with begin()[] instead and guard\nboth invariants with MOZ_ASSERT in debug builds.\n\nThis removes both bounds-check thunks from convolve_horizontally_avx2\n(149 -\u003e 134 instructions) and, on a hot-cache Lanczos3 2048-\u003e1024 horizontal\ndownscale microbenchmark, is ~6% faster (5.05 -\u003e 4.74 ns/output-pixel). The\nchange is in shared code, so it applies to the scalar, SSE2, AVX2 and NEON\nhorizontal paths. Pushed to try to measure the end-to-end decode impact.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323133\n", "files": ["gfx/2d/SkConvolver.h"], "git_node": "c34751174a609d00c3e37e8f97ef07e1f22ee589", "git_parents": ["1d42fbce41a5a47c792685ca323194e7fee73581"], "node": "b605a4f8882d4c81820045c117d539c6755e7bfb", "parents": ["0dba5a02705d4445274a93ba893b61dbd51d22fa"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063892 - Quota manager: stop rescan of origins if shutdown is ongoing. r=jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319043\n", "files": ["dom/quota/ActorsParent.cpp"], "git_node": "d4b13a4b9a4eb312f9aa70f069f425c7f6f3f625", "git_parents": ["c34751174a609d00c3e37e8f97ef07e1f22ee589"], "node": "e2f8f7993ad6f626e6231c02fc0e72160dcd45d3", "parents": ["b605a4f8882d4c81820045c117d539c6755e7bfb"], "tags": []}, {"author": "Gopalarathnam Venkatesan \u003cgopal@g13n.net\u003e", "branch": "default", "desc": "Bug 2000150 - Disable .cls panel inputs when a class cannot be added to the selected node r=devtools-reviewers,jdescottes\n\nWhen the selected node is a pseudo element, a text node or DOCTYPE, the inputs within\nthe class panel are disabled instead of disabling the \".cls\" button itself. The behavior\nis very much like how it's done with the \":hov\" button.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321949\n", "files": ["devtools/client/inspector/rules/test/browser_rules_class_panel_toggle.js", "devtools/client/inspector/rules/views/class-list-previewer.js"], "git_node": "c8d8dd33b265564f50b9c1ad06bd3bcd3e0ae6ec", "git_parents": ["d4b13a4b9a4eb312f9aa70f069f425c7f6f3f625"], "node": "ecfe307aebc16f492426306e4586f632a9b0a062", "parents": ["e2f8f7993ad6f626e6231c02fc0e72160dcd45d3"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068538 - Remove the Legacy Telemetry mirrors of dom.webkit_directory_used and dom.blink_filesystem_used. r=smaug,dom-core-reviewers,janerik\n\nThese were added in bug 1272501 and are now recorded directly through Glean,\nso the Legacy Telemetry mirror is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322884\n", "files": ["dom/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "d97095800d7e48965f401ec1c433e04315abaf5b", "git_parents": ["c8d8dd33b265564f50b9c1ad06bd3bcd3e0ae6ec"], "node": "9dc49b49efb3e5f11fab04c5dd51163831a5a45a", "parents": ["ecfe307aebc16f492426306e4586f632a9b0a062"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055694 - Generate a random nonce per message in NSSCipherStrategy r=dom-storage-reviewers,jari\n\nNSSCipherStrategy::Cipher asked PK11_AEADOp to produce the ChaCha20-Poly1305\nnonce with CKG_GENERATE_COUNTER and fixedbits=0. NSS implements that by\noverwriting the whole 96-bit nonce with a counter private to the PK11Context\nand starting at zero, so the random block prefix callers passed in was\ndiscarded.\n\nObfuscatingVFS creates an encrypt context per SQLite file handle and per\nreopen, all keyed with the same per-database key, so those independent counters\nrepeat (key, nonce) pairs. ChaCha20 is a stream cipher, so a repeated pair\nmeans a repeated keystream, and it also repeats the Poly1305 one-time key.\n\nDraw the nonce with PK11_GenerateRandom on every Cipher call instead and pass\nCKG_NO_GENERATE. Decrypt reads the nonce stored alongside the ciphertext and\nnever derived it, so this changes no on-disk format and existing databases stay\nreadable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319641\n", "files": ["dom/quota/DummyCipherStrategy.h", "dom/quota/EncryptingOutputStream_impl.h", "dom/quota/NSSCipherStrategy.cpp", "dom/quota/NSSCipherStrategy.h", "dom/quota/test/gtest/TestNSSCipherStrategy.cpp", "dom/quota/test/gtest/moz.build", "storage/ObfuscatingVFS.cpp"], "git_node": "8c7497194250dfb732cf3589fae72f438c48410b", "git_parents": ["d97095800d7e48965f401ec1c433e04315abaf5b"], "node": "ef5e46b4f4e3041e139498c2d8d252b9b24f1322", "parents": ["9dc49b49efb3e5f11fab04c5dd51163831a5a45a"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069242 - Ignore native anonymous content when finding and creating text directives. r=emilio\n\nText directives only match web content, so exclude native anonymous content from their nsFind searches without changing normal find-in-page behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323568\n", "files": ["dom/base/TextDirectiveCreator.cpp", "dom/base/TextDirectiveFinder.cpp", "dom/base/test/test_text-fragments-create-text-directive.html", "testing/web-platform/tests/scroll-to-text-fragment/find-range-from-text-directive-target.html", "testing/web-platform/tests/scroll-to-text-fragment/find-range-from-text-directive.html", "toolkit/components/find/nsFind.cpp", "toolkit/components/find/nsFind.h", "toolkit/components/find/test/mochitest/test_nsFind.html"], "git_node": "bdcd41c5cd7e9c70a3324960b92dac04c9d50282", "git_parents": ["8c7497194250dfb732cf3589fae72f438c48410b"], "node": "e3494b7fb43db0420e052a23322b385ade3633a8", "parents": ["ef5e46b4f4e3041e139498c2d8d252b9b24f1322"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 1995443 - Clamp execution trace shape property reads to MAX_COLLECTION_VALUES. r=mstange,profiler-reviewers\n\nThe tracer only records min(numProperties, MAX_COLLECTION_VALUES) property\nkeys in the string buffer, but the profiler read numProperties of them,\nand causing us to read more than what we wrote.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323559\n", "files": ["tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/tests/browser/browser_test_feature_jstracing_values.js", "tools/profiler/tests/browser/tracing_values.html"], "git_node": "0871b7ea65b6cec9553318d01412daf449ce1054", "git_parents": ["bdcd41c5cd7e9c70a3324960b92dac04c9d50282"], "node": "fd82fb61a7e56bdb86ccb21678e5ba3dd693f7a7", "parents": ["e3494b7fb43db0420e052a23322b385ade3633a8"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037905 - Remove the legacy telemetry probe for email_tracker_embedded_per_tab r=timhuang,chumphreys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317037\n", "files": ["toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/url-classifier/tests/browser/browser_emailtracking_telemetry.js"], "git_node": "3d11b67f8a40700545f42061ca10521598d0e586", "git_parents": ["0871b7ea65b6cec9553318d01412daf449ce1054"], "node": "ae8fd44b79230136868a09f5c3f87938a3f2fea7", "parents": ["fd82fb61a7e56bdb86ccb21678e5ba3dd693f7a7"], "tags": []}, {"author": "Dino Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061376 - Remove the Legacy Telemetry mirror of email_tracker_count r=chutten,timhuang\n\nThe Glean metric contentblocking.email_tracker_count is unchanged; only its\nLegacy Telemetry mirror is removed. The recording site in\nUrlClassifierFeatureEmailTrackingDataCollection.cpp already records exclusively\nthrough Glean, so no instrumentation changes are needed.\n\nbrowser_emailtracking_telemetry.js asserted on the legacy histogram only, with\nno Glean equivalent to fall back on, so those assertions are converted to\nGlean rather than dropped. The EMAIL_TRACKER_EMBEDDED_PER_TAB assertions are\nleft alone, as that probe still mirrors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317060\n", "files": ["toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/url-classifier/tests/browser/browser_emailtracking_telemetry.js"], "git_node": "8a94205b124982348c466d3b81a5c12fc0a34dcd", "git_parents": ["3d11b67f8a40700545f42061ca10521598d0e586"], "node": "0dd64b2b8087fa96935d7e82b10c1848617b6837", "parents": ["ae8fd44b79230136868a09f5c3f87938a3f2fea7"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066631 - Improve AV1 tile handling on Vulkan. r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323410\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/av1_tilesize.patch", "media/ffvpx/libavcodec/vulkan_av1.c"], "git_node": "f716b3d145baca902b7cdc1ac07188216e0c6c22", "git_parents": ["8a94205b124982348c466d3b81a5c12fc0a34dcd"], "node": "724b03c51802cc219143ef3d2d1a2b917b058c4a", "parents": ["0dd64b2b8087fa96935d7e82b10c1848617b6837"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2007804 - Add `lid` to the global Copy Clean Link