 ["b12cd4f72dadefffa6c8e1b93ce80144465e974a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067679 - Allow cargo clippy/check to take -p to lint a single package. r=firefox-build-system-reviewers,sylvestre\n\nWithout this change, gkrust features get added to the particular crate\nwhich causes it not to work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322320\n", "files": ["build/cargo/cargo-check.yaml", "build/cargo/cargo-clippy.yaml"], "git_node": "98149c7bfbf98cbbc42c6ad1ace3ab885683924c", "git_parents": ["a37139736434b243b0d8430806a670310fd43eed"], "node": "b6dfaf6f330ee1466efe22bc32ad2cc3fcdff138", "parents": ["d2a977566d891375b6638285df41a303e624645c"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063632 - set min-height for tabbrowser-arrowscrollbox-periphery to fix rapid New Tab button overflow state jumps r=desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320244\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_scroll_size_determination.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "d090da9c9c8aef27cd14ecf788d7d0403f3194f9", "git_parents": ["98149c7bfbf98cbbc42c6ad1ace3ab885683924c"], "node": "769730a36ebec785bb673b6f06b8c561bd949cf3", "parents": ["b6dfaf6f330ee1466efe22bc32ad2cc3fcdff138"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061756 - When homepage as new tab is enabled, make the back button enabled on the homepage if there is something to navigate back to r=android-reviewers,petru\n\nMake navigate back button in expanded toolbar enabled when HNT is enabled and there is something to navigate back to, make navigate back button include navigating back to the homepage, make tab history dialog fragment work with the homepage\n\nDifferen