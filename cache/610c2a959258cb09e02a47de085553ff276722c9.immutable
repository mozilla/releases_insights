hheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324501\n", "files": ["build/moz.configure/toolchain.configure", "docs/code-quality/coding-style/using_cxx_in_firefox_code.md", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/hazard/kind.yml", "taskcluster/kinds/packages/debian.yml", "taskcluster/kinds/toolchain/gcc.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/kinds/toolchain/node.yml", "taskcluster/kinds/toolchain/sysroot.yml"], "git_node": "8cb1b67a266324f2d3772ed97bcbe19d48e25438", "git_parents": ["9050004b251abb1937c7c680906cf676682447f5"], "node": "5c0b1125b79610c544acb949969d0f88ef4e2685", "parents": ["b62f0e20283a0aac6743f6a830879784d2ad2244"], "tags": []}, {"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "default", "desc": "Bug 2063491 - Extend mach coverage-report to comm trees. r=mach-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324565\n", "files": ["tools/code-coverage/mach_commands.py"], "git_node": "7ed365367cb200771f45c67316ad2dc9ada0295d", "git_parents": ["8cb1b67a266324f2d3772ed97bcbe19d48e25438"], "node": "624c82fa65813d1b7fc5625e8a35efaf2172fce3", "parents": ["5c0b1125b79610c544acb949969d0f88ef4e2685"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2058028 - Close all open panels on Smart Window before opening a new one r=czhou\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321728\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_panels.js"], "git_node": "350ec78137cd7bc8b654a05a0314197cdf1cd498", "git_parents": ["7ed365367cb200771f45c67316ad2dc9ada0295d"], "node": "50a93201bd6e86dd92c1b59c5b75b77e1204947b", "parents": ["624c82fa65813d1b7fc5625e8a35efaf2172fce3"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040785 - re-enable previously disabled windows tests due to reduced capacity r=perftest-reviewers,fbilt\n\nPreviously in bug 2038340 windows tests were limited to just the\nessentials. Now that we are back at full capacity we can re-enable the\ntemporarily disabled tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323311\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "9887c2b571e6dae0060b3325439854f9e7149d70", "git_parents": ["350ec78137cd7bc8b654a05a0314197cdf1cd498"], "node": "bd79aa882f6bab673981b31ce231846ff0510af3", "parents": ["50a93201bd6e86dd92c1b59c5b75b77e1204947b"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057617 - Update new tab token grays to match Acorn design system r=jules,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314054\n", "files": ["browser/extensions/newtab/content-src/styles/_theme.scss", "browser/extensions/newtab/content-src/styles/_variables.scss"], "git_node": "8319c2e304d9e499114224f267806a3e3b5e88ff", "git_parents": ["9887c2b571e6dae0060b3325439854f9e7149d70"], "node": "4d7777184810a8b72ec0efc734eb43c1d63660f9", "parents": ["bd79aa882f6bab673981b31ce231846ff0510af3"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061144: Part 1 - Bring browser to front when opening URL file while a file picker is open r=win-reviewers,dom-core-reviewers,smaug,gstoll\n\nOn Windows, when another application hands a URL to a running instance while a\nnative file dialog is up, neither the browser window nor the dialog change\ntheir z-order, even if they are behind other windows.\n\nThe file picker disables the root window for the lifetime of the dialog, so\nnsGlobalWindowOuter::FocusOuter sees a disabled window and aborts.\nnsCocoaWindow::IsEnabled is unconditionally true, so this only changes\nbehavior on Windows and Linux.  Focus requests with the System caller type will\nno longer be blocked just because the window wasn't active.\n\nNB: Win32's SetFocus cannot activate a disabled window, so it alone is not\nsufficient.  Instead, we set the foreground window to the modal dialog\n(found via GW_ENABLEDPOPUP) and then use SetWindowPos to make sure the browser\nis right behind it.  A similar issue, with a similar solution, appears in\nnsWindow::Show.  The only difference is that Show doesn't want to change the\nwidget's z-position and we do, so it does a two step with SetWindowPos to put\nthe dialog immediately in front of the browser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322515\n", "files": ["dom/base/nsGlobalWindowOuter.cpp", "widget/windows/nsWindow.cpp"], "git_node": "8a44e36853beb83c6dff851e36f50f465908d438", "git_parents": ["8319c2e304d9e499114224f267806a3e3b5e88ff"], "node": "7c41ddd29402e54a48a0c7f58bc5d35082bebc53", "parents": ["4d7777184810a8b72ec0efc734eb43c1d63660f9"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061144: Part 2 - Test that Windows moves widget to front when opening URL with file picker open r=win-reviewers,gstoll\n\nThe test uses jsctypes to create, parent, and move native Win32 windows, to set\nup the experiment.  It has to use a dummy window instead of a file picker\nbecause they can't reasonably be closed programmatically (and the\nMockFilePicker doesn't use real windows -- in part for this reason).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323293\n", "files": ["widget/windows/tests/browser/browser.toml", "widget/windows/tests/browser/browser_test_raise_disabled_window.js", "widget/windows/tests/moz.build"], "git_node": "52e28ec03fd1c625984816b6e177a7fc1a367470", "git_parents": ["8a44e36853beb83c6dff851e36f50f465908d438"], "node": "6e0242364413eb72e34848ee6583800cd77607ac", "parents": ["7c41ddd29402e54a48a0c7f58bc5d35082bebc53"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068802 - Fix prettier formatting on Windows r=akulyk,desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323275\n", "files": ["toolkit/themes/shared/design-system/package.json"], "git_node": "3a64319529d134ae2afc95f24c7563d0ab53765a", "git_parents": ["52e28ec03fd1c625984816b6e177a7fc1a367470"], "node": "42622004fdf9f5909f24ee2ef232af7229fc0b3f", "parents": ["6e0242364413eb72e34848ee6583800cd77607ac"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070386 - vendor app-services 11c84e5, r=wverchere\n\nThis comes from these commands:\n\n```\n./mach vendor third_party/application-services/moz.yaml -r 11c84e57fbdf1fd5241f1b90a85949a85d332278\n./mach vendor rust\n./mach uniffi generate\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324637\n", "files": ["Cargo.lock", "docs/rust-components/api/js/autofill.md", "third_party/application-services/automation/swift-components-docs/generate-static-docs-website.sh", "third_party/application-services/components/ads-client/android/build.gradle", "third_party/application-services/components/ads-client/src/client.rs", "third_party/application-services/components/ads-client/src/ffi.rs", "third_party/application-services/components/ads-client/src/lib.rs", "third_party/application-services/components/ads-client/src/mars.rs", "third_party/application-services/components/ads-client/src/mars/ad_request.rs", "third_party/application-services/components/ads-client/src/shutdown.rs", "third_party/application-services/components/autofill/Cargo.toml", "third_party/application-services/components/autofill/src/autofill.udl", "thir