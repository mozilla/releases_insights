"security/manager/ssl/tests/unit/test_certDB_export_pkcs12_with_primary_password.js", "security/manager/ssl/tests/unit/test_certDB_import.js", "security/manager/ssl/tests/unit/test_certDB_import_pkcs12.js", "security/manager/ssl/tests/unit/test_certDB_import_with_primary_password.js", "security/manager/ssl/tests/unit/test_client_auth_speculative_connection.js", "security/manager/ssl/tests/unit/test_logoutAndTeardown.js", "security/manager/ssl/tests/unit/test_pkcs11_module.js", "security/manager/ssl/tests/unit/test_pkcs11_module_client_auth.js", "security/manager/ssl/tests/unit/test_self_signed_certs.js", "security/manager/tools/dumpGoogleRoots.js", "taskcluster/docker/periodic-updates/scripts/genHPKPStaticPins.js", "toolkit/components/antitracking/test/xpcshell/test_staticPartition_clientAuthRemember.js", "toolkit/components/certviewer/AboutCertViewerParent.sys.mjs", "toolkit/components/certviewer/tests/browser/browser_checkNonRepeatedCertTabs.js", "toolkit/components/certviewer/tests/browser/browser_checkStandAlonePage.js", "toolkit/components/certviewer/tests/browser/browser_openTabAndSendCertInfo.js", "toolkit/components/cleardata/tests/unit/test_security_settings.js"], "git_node": "9b140e29b28d6c113711312b5895b727ec200520", "git_parents": ["8a155af15f30bc1bebee8e680603bc87671235b9"], "node": "2bc7a23afe87a792486b79ae52848a7925450dcb", "parents": ["7846fabfdf5938ef2c40314532127fe74ccd9a88"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2067823 - [Monitor Agent] [FE] Monitor time default to user's current half hour r=echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322373\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js"], "git_node": "eb50bbbd4d81ab089ffeda69e8e4def8ed9f756b", "git_parents": ["9b140e29b28d6c113711312b5895b727ec200520"], "node": "5419f3be2d66e6c091cc68d8fb4d6c1e6e1ed063", "parents": ["2bc7a23afe87a792486b79ae52848a7925450dcb"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1945032 - Perform visibility checks on HTML elements with accesskeys in the chrome r=masayuki,mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321562\n", "files": ["dom/events/EventStateManager.cpp", "dom/events/test/chrome.toml", "dom/events/test/mochitest.toml", "dom/events/test/test_accesskey_visibility.html", "dom/events/test/test_accesskey_visibility_content.html"], "git_node": "cd003d027f70791eae25fea2e03babdf639cf976", "git_parents": ["eb50bbbd4d81ab089ffeda69e8e4def8ed9f756b"], "node": "675582579be69e4a3301ec43a5d2975cd82a00c5", "parents": ["5419f3be2d66e6c091cc68d8fb4d6c1e6e1ed063"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1942186 - Add automatic Fluent support for moz-button accesskeys r=mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321563\n", "files": ["toolkit/content/tests/widgets/test_moz_button.html", "toolkit/content/widgets/moz-button/moz-button.mjs", "toolkit/content/widgets/moz-button/moz-button.stories.mjs"], "git_node": "44655123d86d3af35e1cafc22c854e8bc9361169", "git_parents": ["cd003d027f70791eae25fea2e03babdf639cf976"], "node": "fb1679258f7f7d260bd06264a8fbce3e7ba2ac0f", "parents": ["675582579be69e4a3301ec43a5d2975cd82a00c5"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1942186 - Part 2: clean up existing usage of data-l10n-attrs='accesskey' on moz-button r=mkennedy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321564\n", "files": ["browser/components/preferences/widgets/sync-device-name/sync-device-name.mjs", "toolkit/content/net-error-card.mjs", "toolkit/content/widgets/moz-input-folder/moz-input-folder.mjs"], "git_node": "6f5604ab31b228ceabaccd409a5e4a3f43bc4723", "git_parents": ["44655123d86d3af35e1cafc22c854e8bc9361169"], "node": "b36e7a101c80f34a6520d74a110b490d514ee46b", "parents": ["fb1679258f7f7d260bd06264a8fbce3e7ba2ac0f"], "tags": []}, {"author": "Valerie Racine \u003cvracine21@gmail.com\u003e", "branch": "default", "desc": "Bug 1849963 - Remove obsolete sorting_algorithms_comparison.md from the performance docs. r=jstutte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322431\n", "files": ["docs/performance/sorting_algorithms_comparison.md"], "git_node": "972d12883106af512e7f46bc462291a51db13a2c", "git_parents": ["6f5604ab31b228ceabaccd409a5e4a3f43bc4723"], "node": "857cbb45f6ddd1b3d7720f42a5aa69904ed626cf", "parents": ["b36e7a101c80f34a6520d74a110b490d514ee46b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2067457 - Don't click a tool button the launcher has no room for, r=sfoster.\n\ntest_states_for_hide_sidebar_vertical clicked a tool button and then asserted\nSidebarController.isOpen. When the launcher has no room for the button it is\nleft visibility:hidden with its layout box intact, so the click landed on the\nlauncher and no panel opened.\n\nKeep clicking the button when there is one to click, so the task still covers\nthat, and use showPanel() otherwise. The copies in the overflow menu are not an\nalternative: the intersection observer removes and recreates them as the menu\nopens.\n\nAlso wait for the panel box before asserting on it: checkStates() only inspects\nthe launcher, which is already shown and expanded at this point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322107\n", "files": ["browser/components/sidebar/tests/browser/browser_toolbar_sidebar_button.js"], "git_node": "f0e8e02aa417c4a986eda73d4f7506ae075951c3", "git_parents": ["972d12883106af512e7f46bc462291a51db13a2c"], "node": "fd6bfdf4d1d76fd849b1b781d4056581bcb1d6de", "parents": ["857cbb45f6ddd1b3d7720f42a5aa69904ed626cf"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066495 - Do not clear VPN user location preference when user signs out. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322370\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddleware.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionLocationMiddlewareTest.kt"], "git_node": "cb270887c3ad54b4929b292e77eb632406f433af", "git_parents": ["f0e8e02aa417c4a986eda73d4f7506ae075951c3"], "node": "7fd62be334dc24a9282fde2e82928e04c34c6e5e", "parents": ["fd6bfdf4d1d76fd849b1b781d4056581bcb1d6de"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064902 - Register about:aitab and its actor pair r=fluent-reviewers,mlucks,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320291\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "browser/components/aiwindow/ui/actors/AITabChild.sys.mjs", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/content/aitab.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_page.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "b4d81f6df9b3b2abdca43f3dc3b7ef59e492fd81", "git_parents": ["cb270887c3ad54b4929b292e77eb632406f433af"], "node": "33c78c59912030fadef6fc36f10d2d09a38f5fc0", "parents": ["7fd62be334dc24a9282fde2e82928e04c34c6e5e"], "tags": []}, {"author": "Caleb P \u003ccaleb.pickard@gmail.com\u003e", "branch": "default", "desc": "Bug 2058970 - Remove BROWSER_SEARCH_PREF constant. r=scunnane,search-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322413\n", "files": ["browser/components/backup/tests/xpcshell/test_PreferencesBackupResource_searchEngines.js", "toolkit/components/search/ConfigSearchEngine.sys.mjs", "toolkit/components/search/SearchService.sys.mjs", "toolkit/components/search/SearchSettings.sys.mjs", "toolkit/components/search/SearchUtils.sys.mjs", "toolkit/components/search/tests/xpcshell/test_config_loading_uses_env.js", "toolkit/components/search/tests/xpcshell/test_defaultEngine.js", "toolkit/components/search/tests/xpcshell/test_defaultEngine_experiments.js", "toolkit/components/search/tests/xpcshell/test_defaultEngine_fallback.js", "toolkit/components/search/tests/xpcshell/test_defaultPrivateEngine.js", "toolkit/components/search/tests/xpcshell/test_getSubmission_params_pref.js", "toolkit/components/search/tests/xpcshell/test_ignorelist.js", "toolkit/components/search/tests/xpcshell/test_initialization_with_region.js", "toolkit/components/search/tests/xpcshell/test_notifications.js", "toolkit/components/search/tests/xpcshell/test_opensearch_update.js", "toolkit/components/search/tests/xpcshell/test_policyEngine.js", "toolkit/components/search/tests/xpcshell/test_reload_engines.js", "toolkit/components/search/tests/xpcshell/test_reload_engines_experiment.js", "toolkit/components/search/tests/xpcshell/test_searchTermFromResult.js", "toolkit/components/search/tests/xpcshell/test_settings.js", "toolkit/components/search/tests/xpcshell/test_settings_corrupt.js", "toolkit/components/search/tests/xpcshell/test_settings_duplicate.js", "toolkit/components/search/tests/xpcshell/test_settings_good.js", "toolkit/components/search/tests/xpcshell/test_sort_orders-no-hints.js", "toolkit/components/search/tests/xpcshell/test_sort_orders.js", "toolkit/components/search/tests/xpcshell/test_telemetry_default.js", "toolkit/components/search/tests/xpcshell/test_telemetry_default_changed_startup.js"], "git_node": "39b9c330e8030dc44fc861b2b2eae748f0b9e9f7", "git_parents": ["b4d81f6df9b3b2abdca43f3dc3b7ef59e492fd81"], "node": "10c1fe265f7d5828198f245336c2fadce18129c2", "parents": ["33c78c59912030fadef6fc36f10d2d09a38f5fc0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033328 - Let the InputConnection editable catch up before asserting on it. r=geckoview-reviewers,m_kato\n\nTextInputDelegateTest's assert helpers check Gecko's selection and then read the same state back through\nInputConnection.getExtractedText(). Gecko syncs that editable asynchronously and neither\nprocessChildEvents() nor processParentEvents() travels the same channel, so the Java-side value is\nintermittently off by one in either direction while Gecko's is already correct. Pump until the extracted\ntext matches, then assert as before so the failure message is unchanged.\n\nprocessChildEvents() also waited only a single animation frame. Gecko notifies text transactions off the\nrefresh driver, so wait two frames as the IME mochitests do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322224\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TextInputDelegateTest.kt"], "git_node": "9292e95d00d236015e24f022f3e1f862678239a7", "git_parents": ["39b9c330e8030dc44fc861b2b2eae748f0b9e9f7"], "node": "0003dd3dbc7b5984c7061aa04912ea66306a7b93", "parents": ["10c1fe265f7d5828198f245336c2fadce18129c2"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033328 - Re-enable inputConnection_setSelection. r=geckoview-reviewers,ohall\n\nIt was disabled for \"frequent timeout for selection event\" with no bug attached, which is the failure\nthe assert helpers now wait out, and it no longer fails on try.\n\ninputConnection_selectionByArrowKey stays disabled, but against bug 2067617 rather than bug 1741790,\nwhich was resolved the same day the test was disabled. It has been through this before: disabled in\n2024, re-enabled by bug 2011351 in January 2026, disabled again that May. Its forward shift+arrow step\nintermittently leaves the Java editable collapsed while Gecko's selection is correct, in every\nparameterization, and that is a product problem this bug cannot fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322225\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TextInputDelegateTest.kt"], "git_node": "1b8b016b31a00fba4303d59548d3df45a2539ba7", "git_parents": ["9292e95d00d236015e24f022f3e1f862678239a7"], "node": "51e74cb653afb76ac5dad7c2d911106237a53897", "parents": ["0003dd3dbc7b5984c7061aa04912ea66306a7b93"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067942: Reorder tests in CanEnterBaselineJIT r=spidermonkey-reviewers,jandem\n\nTesting whether a script has a baseline script is marginally cheaper than the tests in CanBaselineCompileScript, so we can check that first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322493\n", "files": ["js/src/jit/BaselineJIT.cpp"], "git_node": "7abcecc97f28dacee3ecaf0d6599029dfd53497a", "git_parents": ["1b8b016b31a00fba4303d59548d3df45a2539ba7"], "node": "3b4d9c3708e4184827b6ab98771c22b1790515c1", "parents": ["51e74cb653afb76ac5dad7c2d911106237a53897"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067942: Precompute hash for CacheIRStubKey::Lookup r=spidermonkey-reviewers,jandem\n\nWe reuse the Lookup object in LookupOrCompileStub when we don't get a cache hit, but recompute the hash each time (including a hash of the CacheIR bytes). We can avoid rehashing by storing the hash. We don't even need any additional memory, at least on 64 bit, because the existing data layout had internal padding (but it doesn't matter anyway because this is stack-allocated).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322494\n", "files": ["js/src/jit/CacheIRCompiler.cpp", "js/src/jit/JitZone.h"], "git_node": "87f409bf13569439093b77152d99915443b0c156", "git_parents": ["7abcecc97f28dacee3ecaf0d6599029dfd53497a"], "node": "26a19e9ab79cca8a5f48d60c153482151d68ae74", "parents": ["3b4d9c3708e4184827b6ab98771c22b1790515c1"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067942: Improve codegen for nextDelayedMarkingArena r=spidermonkey-reviewers,jonco\n\nWe currently store nextDelayedMarkingArena_ as a bitfield exactly large enough to hold the shifted arena pointer. Combined with the 4 bits from flags, however, that leaves 8 padding bits, which Clang is conservatively required to preserve, and requires an inefficient code sequence to extract. By simply extending the bitfield to cover the entire word, we improve codegen for both initialization and access. See https://godbolt.org/z/eMj81Eejd.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322495\n", "files": ["js/src/gc/Heap.h"], "git_node": "c36471409f27ee66f97361740260f48f11b58c14", "git_parents": ["87f409bf13569439093b77152d99915443b0c156"], "node": "7c02adfbb46e0b518925975eeb943c322780c6ef", "parents": ["26a19e9ab79cca8a5f48d60c153482151d68ae74"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067942: Remove redundant hash comparison in AtomHasher::match r=spidermonkey-reviewers,jandem\n\nThis is called by the hash table after it's already determined that the hashes are the same, to detect whether there's been a hash collision. Technically, because HashTable::prepareHash is not injective (it masks off the bottom bit after scrambling), it's possible (though rare) for key-\u003ehash() and lookup.hash to be different at this point. In that case, however, the characters must differ, so either the length check or the StringsMatch check will fail.\n\nI got Claude to estimate how often we'd have to do an extra StringsMatch. With random strings, Claude estimates that even with a million atoms in the table, a 31-bit collision will happen on less than 1/1000 lookups. Most of those will fail the length check before testing the hash. So on average we're probably looking at \u003c 1/10000 chance of doing an extra StringsMatch. This test is probably not 10000x cheaper than StringsMatch (especially since StringsMatch will usually fail quickly), so removing the hash comparison is probably a (tiny) net win.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322496\n", "files": ["js/src/vm/JSAtomUtils.cpp"], "git_node": "086ad736289fad6bb3ecf754849903cef7a0dca6", "git_parents": ["c36471409f27ee66f97361740260f48f11b58c14"], "node": "fe664e21d8d6433a900ab47b7e7a088f39276563", "parents": ["7c02adfbb46e0b518925975eeb943c322780c6ef"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\naf -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nan -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nar -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nast -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\naz -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nbe -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nbg -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nbn -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nbo -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nbqi -\u003e d6ff24063e52055b4cd8916491f7641e2a861a1d\nbr -\u003e d6ff24063e52055b4cd891649