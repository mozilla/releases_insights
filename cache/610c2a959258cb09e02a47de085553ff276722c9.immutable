p", "dom/security/featurepolicy/FeaturePolicyParser.h", "dom/security/featurepolicy/fuzztest/fp_fuzzer.cpp", "dom/security/featurepolicy/test/gtest/TestFeaturePolicyParser.cpp"], "git_node": "bcba6175787af54a45c9b7a4e4810d49f1916c00", "git_parents": ["b4b9c502a912390b1f71004b80a7dcc5acb5584e"], "node": "fd955431709d14dca26426ab8653e0bf5700d8af", "parents": ["78496a95c1fafcbc2bf47f98d73285e820b1b21a"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068035 - Update mochitests to use the correct headers and WPT expectations for Permissions-Policy. r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323213\n", "files": ["dom/security/featurepolicy/test/mochitest/file_xslt.html^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt.xml^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt.xsl^headers^", "dom/security/featurepolicy/test/mochitest/file_xslt_outer.html^headers^", "dom/security/featurepolicy/test/mochitest/test_parser.html^headers^", "testing/web-platform/meta/mediacapture-streams/MediaDevices-enumerateDevices-not-allowed-camera.https.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaDevices-enumerateDevices-not-allowed-mic.https.html.ini", "testing/web-platform/meta/serial/serial-disabled-by-permissions-policy.https.sub.html.ini", "testing/web-platform/meta/web-share/disabled-by-permissions-policy.https.sub.html.ini"], "git_node": "6f8a9332ffbf0421658e641f2eba8ecf436bbd8f", "git_parents": ["bcba6175787af54a45c9b7a4e4810d49f1916c00"], "node": "4f414bac5b76e237b88f3273e2b88d88b089d663", "parents": ["fd955431709d14dca26426ab8653e0bf5700d8af"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069250 - Restore effective persistence behavior on popup windows. r=smaug\n\nDo it in a bit more straight-forward way than pre-regression, by just\nchecking the chrome flag before saving the persistent attribute.\n\nThis really undoes the purpose of the regressor, which was fixing issues\nwith bug 2054183 (since we go back to restoring the sizemode attribute\nfrom the xul store...).\n\nBut turns out that since then we've removed the window gap stuff that\ncaused that issue (plus even with the gaps we decided to remove the gaps\nfrom popups altogether), so we might not really care about that anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323778\n", "files": ["toolkit/components/windowwatcher/test/browser_new_sized_window.js", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/AppWindow.h"], "git_node": "43a6c8911f289002946a96c310da8dffc27751a1", "git_parents": ["6f8a9332ffbf0421658e641f2eba8ecf436bbd8f"], "node": "84ef610bba9a8a26ce17cbc126bb0f19e27f8c38", "parents": ["4f414bac5b76e237b88f3273e2b88d88b089d663"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069004 - Make selector matching pass elements by value. r=firefox-style-system-reviewers,dshin\n\nRemoves some unnecessary indirection. Locally this recovers the\nregression, and then some.\n\nWe could keep the Clone bound if needed / avoid Copy. It's just a bit\nannoying tho.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323074\n", "files": ["servo/components/selectors/matching.rs", "servo/components/selectors/relative_selector/filter.rs", "servo/components/selectors/tree.rs", "servo/components/style/dom_apis.rs", "servo/components/style/invalidation/element/element_wrapper.rs", "servo/components/style/invalidation/element/invalidator.rs", "servo/components/style/invalidation/element/relative_selector.rs", "servo/components/style/invalidation/element/state_and_attributes.rs", "servo/components/style/invalidation/stylesheets.rs", "servo/components/style/selector_map.rs", "servo/components/style/stylesheets/scope_rule.rs", "servo/components/style/stylist.rs", "servo/ports/geckolib/glue.rs"], "git_node": "f1d2202bd64aefb27540e95947de29dcde286099", "git_parents": ["43a6c8911f289002946a96c310da8dffc27751a1"], "node": "35fde463eb6566afed79c7bb47d788de814dd06f", "parents": ["84ef610bba9a8a26ce17cbc126bb0f19e27f8c38"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2068000 - Fix some clippy nits in gecko-profiler. r=canova,profiler-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322561\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "mozglue/baseprofiler/build/generate_profiling_categories.py", "tools/profiler/rust-api/src/label.rs", "tools/profiler/rust-api/src/marker/deserializer_tags_state.rs", "tools/profiler/rust-api/src/marker/mod.rs", "tools/profiler/rust-api/src/marker/schema.rs"], "git_node": "80e3ae9f9057418342115434feb87fb5785b4ac8", "git_parents": ["f1d2202bd64aefb27540e95947de29dcde286099"], "node": "232ec7ab754e57dba92bd393304a55eb35d18ab1", "parents": ["35fde463eb6566afed79c7bb47d788de814dd06f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069375 - Make sure to potentially create a widget-specific vsync timer when attached. r=smaug\n\nNot sure how to best test this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323763\n", "files": ["layout/base/PresShellWidgetListener.cpp", "layout/base/nsRefreshDriver.cpp", "layout/base/nsRefreshDriver.h"], "git_node": "d9fdde099e202ba0dcd60574b90f625cef4d1670", "git_parents": ["80e3ae9f9057418342115434feb87fb5785b4ac8"], "node": "2a8268743e23fa9ac1070d00fc508c565c5ab341", "parents": ["232ec7ab754e57dba92bd393304a55eb35d18ab1"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066150 - Remove legacy security telemetry probes r=freddyb\" for causing failures at browser_aboutNetError.js.\n\nThis reverts commit df61c46d8f6e910568dae02bc5de37d5fbf660f5.\n", "files": ["browser/components/metrics.yaml", "dom/security/metrics.yaml", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/Scalars.yaml", "toolkit/components/telemetry/histogram-allowlists.json", "toolkit/content/metrics.yaml"], "git_node": "ed81577d19564c21bdc57e0a499dbeb32c3d7787", "git_parents": ["d9fdde099e202ba0dcd60574b90f625cef4d1670"], "node": "669d81b2f8b5dfe1545c0c0ca7408df12b7c578a", "parents": ["2a8268743e23fa9ac1070d00fc508c565c5ab341"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2068631: Record the state of the profile service and when the current profile is missing. r=jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322944\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/metrics.yaml", "browser/components/profiles/tests/unit/test_recover_database.js", "browser/components/profiles/tests/unit/test_recover_empty_database.js", "browser/components/profiles/tests/unit/test_selectable_profiles_lifecycle.js"], "git_node": "91251776a442ed6b01bff6d620e010221aa0b0be", "git_parents": ["ed81577d19564c21bdc57e0a499dbeb32c3d7787"], "node": "c71810e10ed6da3e240829a64b305a552e3ad65c", "parents": ["669d81b2f8b5dfe1545c0c0ca7408df12b7c578a"], "tags": []}, {"author": "Christoph Moench-Tegeder \u003ccmt@burggraben.net\u003e", "branch": "default", "desc": "Bug 2069658 - include signal.h for SIGRTMIN on FreeBSD r=emilio\n\nOn FreeBSD, we need to explicitly include signal.h for SIGRTMIN.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323864\n", "files": ["xpcom/base/nsMemoryInfoDumper.cpp"], "git_node": "94eb94f380932fb43f5a631c051ff20b71b35801", "git_parents": ["91251776a442ed6b01bff6d620e010221aa0b0be"], "node": "296f892d83344df8510b043315f4a7e864a4ec64", "parents": ["c71810e10ed6da3e240829a64b305a552e3ad65c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069523 - Resolve the good-first-bug mentor from the Bugzilla account. r=ai4dev-reviewers,padenot DONTBUILD\n\n`agent-skills-sync` compares only SKILL.md, so the two copies of the script are kept in step by hand.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323769\n", "files": [".agents/skills/file-good-first-bug/SKILL.md", ".agents/skills/file-good-first-bug/scripts/build_url.py", ".claude/skills/file-good-first-bug/SKILL.md", ".claude/skills/file-good-first-bug/scripts/build_url.py"], "git_node": "75116dd1021eecba9df8ba2ece1cd49db925e96f", "git_parents": ["94eb94f380932fb43f5a631c051ff20b71b35801"], "node": "dd8ecc3b49cc99382ab73adb83973e72cb9b9c00", "parents": ["296f892d83344df8510b043315f4a7e864a4ec64"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069451 - Reference code by name rather than by line number in bugs, reviews and commit messages. r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323701\n", "files": ["AGENTS.md"], "git_node": "070ae9b9826d666caf8a12dfc381c103412e8d12", "git_parents": ["75116dd1021eecba9df8ba2ece1cd49db925e96f"], "node": "51ff0d1b448554caa03083af9a1d014ca83326a7", "parents": ["dd8ecc3b49cc99382ab73adb83973e72cb9b9c00"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068488 - Keep every urlbar bounce in one parent-side store keyed by the tab. r=mbeier\n\nOne module-level weak map replaces the per-collector stores, so a trigger resolves the tab's bounce whichever input started it. Triggering is a module function taking the browser, which the chrome call sites reach directly rather than through a collector and, on the message path, the actor.\n\nThe direct path collects its snapshot before awaiting a prior bounce's trigger, where the engagement record that follows had already closed the view. URILoadingHelper's trigger fires again too, having passed a browser element to a browser-id parameter since bug 1624579, and the load flag it checks now covers every urlbar input rather than the address bar alone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323123\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildTelemetry.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_bounce.js", "browser/modules/URILoadingHelper.sys.mjs"], "git_node": "80127a7218d7cb8ba825ddf0a16ab00add4e474f", "git_parents": ["070ae9b9826d666caf8a12dfc381c103412e8d12"], "node": "fe54c180d124ab77d24537062d858428965d7e6a", "parents": ["51ff0d1b448554caa03083af9a1d014ca83326a7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068488 - Resolve a bounce's sap when the engagement happens. r=mbeier\n\nA bounce records once the tab navigates away, by which point the address bar's sap no longer resolves to the page the search was made on: the direct path recorded a bounce as urlbar where its engagement had recorded urlbar_newtab. Keeping bounces in the parent-side store resolves the message path's sap at engagement time, leaving the two paths to disagree until this commit.\n\nA bounce whose window closes before the trigger records too, where the closed window used to leave it without a sap. The sap test's urlbar expectation now matches the engagement sap test's, the first search of that session being on a blank page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323791\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_bounce_sap.js"], "git_node": "780d59d30aa4bf161c116ff5b53eff3206498f41", "git_parents": ["80127a7218d7cb8ba825ddf0a16ab00add4e474f"], "node": "fbe03de35a266548cef1816a074b60a759dcc776", "parents": ["fe54c180d124ab77d24537062d858428965d7e6a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068488 - Record urlbar.bounce for the New Tab search bar. r=mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323124\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/tests/browser-newtab/browser_bounceTelemetry.js"], "git_node": "2f799b9a916b418678fc4555bc1be4b50e79f374", "git_parents": ["780d59d30aa4bf161c116ff5b53eff3206498f41"], "node": "cbf2d2c6efc50a9c4c59bdf318f75faf8a54419c", "parents": ["fbe03de35a266548cef1816a074b60a759dcc776"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068550 - Report auth-layer fetch failures as a network error instead of an unknown error r=ip-protection-reviewers,apopov\n\nNot all fetches we do are wrapped. So if your network connection is bad, fetch can throw.\nThis then will break the contract -\u003e we bubble up the network-error object to android -\u003e it will get reported as \"unknown\" error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322885\n", "files": ["toolkit/components/ipprotection/IPPAuthProvider.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/enterprise/IPPEnterpriseAuthProvider.sys.mjs", "toolkit/components/ipprotection/fxa/GuardianClient.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_GuardianClient.js"], "git_node": "1dd41d1b34512f65250f9bbbcf12204889233c0f", "git_parents": ["2f799b9a916b418678fc4555bc1be4b50e79f374"], "node": "3772b3f78104afdbf359760a5eaa9f991874586b", "parents": ["cbf2d2c6efc50a9c4c59bdf318f75faf8a54419c"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2069797 [Wayland] Enable HDR only if BT2020/PQ is supported r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323985\n", "files": ["widget/gtk/nsWaylandDisplay.cpp", "widget/gtk/nsWaylandDisplay.h"], "git_node": "66fc3e5927cdd68f93304bd8611140b2226855f2", "git_parents": ["1dd41d1b34512f65250f9bbbcf12204889233c0f"], "node": "2f10e41f156b074d78a40be9250d58b01adc73c3", "parents": ["3772b3f78104afdbf359760a5eaa9f991874586b"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2069797 [Wayland] Add support for GBM_FORMAT_ABGR2101010 DRM format r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323986\n", "files": ["widget/gtk/DMABufFormats.cpp", "widget/gtk/DMABufFormats.h"], "git_node": "faea85bf31161114961d5fcae2ebe7689311c640", "git_parents": ["66fc3e5927cdd68f93304bd8611140b2226855f2"], "node": "3ff55dc5a6b0c9812cb18c77debed62d7c20fde6", "parents": ["2f10e41f156b074d78a40be9250d58b01adc73c3"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2069797 [Wayland] Add DMABufSurface GBM_FORMAT_ABGR2101010 DRM format support r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323987\n", "files": ["widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h"], "git_node": "da37f6d21e1cf89052afecf6bbe5ce70cf5d1bdf", "git_parents": ["faea85bf31161114961d5fcae2ebe7689311c640"], "node": "3a9a01cae85a4cee06a88a8680da5282f5977c33", "parents": ["3ff55dc5a6b0c9812cb18c77debed62d7c20fde6"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2069797: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["widget/gtk/DMABufSurface.cpp"], "git_node": "8d56579bf8c58f49f034de4fe3c8b9c5051e6a91", "git_parents": ["da37f6d21e1cf89052afecf6bbe5ce70cf5d1bdf"], "node": "f2eea694b10a6aa6eae06d93eb902e309af172db", "parents": ["3a9a01cae85a4cee06a88a8680da5282f5977c33"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065072 - Make the graph's IsCurrentThreadIn() allowed during shutdown. r=karlt\n\nSince bug 1993981 the graph is the nsISerialEventTarget that an\nipc::MessageChannel opened on the graph thread binds to, so the graph owns that\nchannel's target shutdown task. MediaTrackGraphShutDownRunnable runs those\ntasks on the main thread, after SetCurrentDriver(nullptr).\nWorkerTargetShutdownTask::TargetShutdown() release-asserts on\nIsOnCurrentThread(), which went through OnGraphThread() and dereferenced the\nnow-null driver.\n\nAnswer IsCurrentThreadIn() with OnGraphThreadOrNotRunning() instead, as tasks\ncan run on main thread during shutdown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321162\n", "files": ["dom/media/MediaTrackGraph.cpp", "dom/media/gtest/TestAudioTrackGraph.cpp"], "git_node": "4bb758aba4ceeadbdb8e93c3a1cab38c718db111", "git_parents": ["8d56579bf8c58f49f034de4fe3c8b9c5051e6a91"], "node": "7bbb87b80643e227850e9795639b4fa8c4bff6e1", "parents": ["f2eea694b10a6aa6eae06d93eb902e309af172db"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065072 - Force the AudioWorklet global scope port closed on main thread. r=karlt,media-playback-reviewers\n\nOnly ConstructGlobalScope() consumes mGlobalScopePortIdentifier, and it runs\nonly for addModule(). Touching audioWorklet without calling addModule()\ntherefore leaves the identifier live for ~AudioWorkletImpl, which runs on the\ngraph thread because NotifyWorkletFinished() releases the global scope there.\n\n~UniqueMessagePortId then force-closes the port, opening a BackgroundChild bound\nto the graph. That connection is closed as the GraphRunner thread exits, by\nwhich time ipc::MessageChannel::AssertWorkerThread() no longer accepts the graph\nthread.\n\nDestroy the identifier on the main thread instead. The new hook runs after the\nglobal scope has gone, so ConstructGlobalScope() can no longer race for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323430\n", "files": ["dom/media/MediaTrackGraph.cpp", "dom/media/test/crashtests/audioworklet-port-without-addmodule.html", "dom/media/test/crashtests/crashtests.list", "dom/media/webaudio/AudioWorkletImpl.cpp", "dom/media/webaudio/AudioWorkletImpl.h", "dom/worklet/WorkletImpl.cpp", "dom/worklet/WorkletImpl.h"], "git_node": "15a89220f80898de7a47e460374821bc61d83a32", "git_parents": ["4bb758aba4ceeadbdb8e93c3a1cab38c718db111"], "node": "a96abb7ba9d33be74f35042621f99afd0ff089f0", "parents": ["7bbb87b80643e227850e9795639b4fa8c4bff6e1"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2065072: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/worklet/WorkletImpl.h"], "git_node": "ef816cd2e70de63be13c5d08c6ab6bdab9fd6ab1", "git_parents": ["15a89220f80898de7a47e460374821bc61d83a32"], "node": "6f2b1812ed2f7633177a7e992c9731925234ebd7", "parents": ["a96abb7ba9d33be74f35042621f99afd0ff089f0"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2069706. Put glibc_hack's namespace_sandbox.cc back to the formatting upstream uses. r=sylvestre,sandbox-reviewers,bobowen\n\nBug 1519636 reformatted this file in May 2025 and the changes are all formatting. The file is vendored from chromium, so we shouldn't be formatting it.\n\nThis file was added to tools/rewriting/ThirdPartyPaths.txt by bug 1896054 in July 2024, so the reformat should have known not to reformat it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323904\n", "files": ["security/sandbox/linux/launch/glibc_hack/sandbox/linux/services/namespace_sandbox.cc", "taskcluster/scripts/misc/vendor-verify-expected-fail.yml"], "git_node": "b239d043ae6b5c76f6f88f6811bfcfe8cfcaf301", "git_parents": ["ef816cd2e70de63be13c5d08c6ab6bdab9fd6ab1"], "node": "35c79712162bd74a4abd2a53a5b8e4d91c4311c0", "parents": ["6f2b1812ed2f7633177a7e992c9731925234ebd7"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2058882 - Send back the profile data during shutdown on utility process r=gerard-majax,mstange,ipc-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D177649\n", "files": ["ipc/glue/PUtilityProcess.ipdl", "ipc/glue/UtilityProcessChild.cpp", "ipc/glue/UtilityProcessChild.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/UtilityProcessManager.h", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "ipc/glue/test/browser/browser_utility_profiler.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "aa1a3e3cd5f618cb244c803cb4f26d4e29007935", "git_parents": ["b239d043ae6b5c76f6f88f6811bfcfe8cfcaf301"], "node": "479cc60399573a4b8762c7d62596c21034ac12dd", "parents": ["35c79712162bd74a4abd2a53a5b8e4d91c4311c0"], "tags": []}], "date": 1788797100, "git_changesets": ["4d8ec71379e6dafc4dad2e04fd7557e42a62f3cc", "d6445e870a72498c3b3245104cb94433d9e9f623", "ba396ecbcddea0fc4e37410aae07ac3dfc921f88", "063e1805da7850d81b28ff6853465bf2be3e19e0", "82df3fd2f7989d3cbe5eea4206d20207b054c4c4", "a59d6a3517f967b9dd4651deb02aaa4d3d7f963e", "aca7455e3c3fa56ba1cec50974f38f224923f748", "3664b56c3395fa146dc8aac93452cd98b2fbb0be", "4075182cae4c86fc0e93d3465d5524ceaff9da3d", "67545d82b217fcec6d2ee374d154bb0a16b80157", "64d922ed4622d1a71edf22cc4e37f145da3e258b", "0d97f3e479291358d4b87919a93799898a7022f0", "bf88c2ebf17f1a509ffa323d0438504c8839b85a", "f2128d2b97820c1f81160caa20a29e6fab33e535", "9a967dac83bf8b0b99fed7be6319b1258776489b", "d1cd48cd3ab49af6dd7bf5a0b3a7a724ab3deeb2", "a5431ba4a089dd0ca56f02fc676d0a08565cf59d", "60d5fa384e549eff9500244a7d3bd7553516738e", "88ea377fab582720cb6a45525bdf29ac4eeb0194", "c7a8b537a1af1f9132ac07751e52528a636ffc20", "df61c46d8f6e910568dae02bc5de37d5fbf660f5", "dc5ce43c496e3dd5b594934a3bd24bd52e3e0162", "8555be833514e7b48d82997e4682df69cf3e699c", "8e67ec05999daa1885a85a9d9edae084b20f3811", "a3030db3f1a7e574dea0800d30179c8c54032adb", "3e222a6a392fef261b01d88fbac0f2b4ec661344", "c11491d8dbe1eb1104beb7d223a0267b60d2d830", "14518ce8c3599866f50767a8b972b3626d37c317", "e3ad624d0b94a79ecaf325fb99cd9e90949bde1d", "c706c7d62052752500734ef910088055c5366815", "b0e948ec594abd5899e76e3d7a81cad706ed2749", "d0b35a9264a57dfc7c55ebaf530d1e8fe150bab7", "7fd7241c51237d784d11139cc3ac82dd0820999c", "ca9de7549f61a2b7b424f6478c84cd13c998378c", "b4b9c502a912390b1f71004b80a7dcc5acb5584e", "bcba6175787af54a45c9b7a4e4810d49f1916c00", "6f8a9332ffbf0421658e641f2eba8ecf436bbd8f", "43a6c8911f289002946a96c310da8dffc27751a1", "f1d2202bd64aefb27540e95947de29dcde286099", "80e3ae9f9057418342115434feb87fb5785b4ac8", "d9fdde099e202ba0dcd60574b90f625cef4d1670", "ed81577d19564c21bdc57e0a499dbeb32c3d7787", "91251776a442ed6b01bff6d620e010221aa0b0be", "94eb94f380932fb43f5a631c051ff20b71b35801", "75116dd1021eecba9df8ba2ece1cd49db925e96f", "070ae9b9826d666caf8a12dfc381c103412e8d12", "80127a7218d7cb8ba825ddf0a16ab00add4e474f", "780d59d30aa4bf161c116ff5b53eff3206498f41", "2f799b9a916b418678fc4555bc1be4b50e79f374", "1dd41d1b34512f65250f9bbbcf12204889233c0f", "66fc3e5927cdd68f93304bd8611140b2226855f2", "faea85bf31161114961d5fcae2ebe7689311c640", "da37f6d21e1cf89052afecf6bbe5ce70cf5d1bdf", "8d56579bf8c58f49f034de4fe3c8b9c5051e6a91", "4bb758aba4ceeadbdb8e93c3a1cab38c718db111", "15a89220f80898de7a47e460374821bc61d83a32", "ef816cd2e70de63be13c5d08c6ab6bdab9fd6ab1", "b239d043ae6b5c76f6f88f6811bfcfe8cfcaf301", "aa1a3e3cd5f618cb244c803cb4f26d4e29007935"], "user": "ctuns@mozilla.com"}, "45268": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a06ca61fa60134d3c250d150a3cdc6c07e3be427 with DEVEDITION_156_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d625c283e2fd2b0d84a0314780afab06320275aa", "git_parents": ["9bd885c206bbb718d93528a2f39db3e7d201080b"], "node": "37fae6f5240823cb43d1a893ab666aa32a30981b", "parents": ["73464dd92b00cd4760e466850c80e87aa60c0886"], "tags": []}], "date": 1788797276, "git_changesets": ["d625c283e2fd2b0d84a0314780afab06320275aa"], "user": "ffxbld@lando.moz.tools"}, "45269": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a06ca61fa60134d3c250d150a3cdc6c07e3be427 with FIREFOX_156_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "3bf8c40c86a15419b3e56feec6823903da8ecd58", "git_parents": ["d625c283e2fd2b0d84a0314780afab06320275aa"], "node": "103f8c26fe098e3a3295951d034e62057653d7fe", "parents": ["37fae6f5240823cb43d1a893ab666aa32a30981b"], "tags": []}], "date": 1788797372, "git_changesets": ["3bf8c40c86a15419b3e56feec6823903da8ecd58"], "user": "ffxbld@lando.moz.tools"}, "45270": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2069885 - Remove some no longer needed nova special-cases. r=desktop-theme-reviewers,dao\n\nThese cause mismatched backgrounds on the native window in the native\ntheme with horizontal tabs for example.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324009\n", "files": ["browser/themes/shared/browser-shared.css"], "git_node": "c169dc7e1c7e840dd3cc97f836870aecf0afa8eb", "git_parents": ["aa1a3e3cd5f618cb244c803cb4f26d4e29007935"], "node": "9d3c4811f446f9258f46267db46329d5ca7bb7dc", "parents": ["479cc60399573a4b8762c7d62596c21034ac12dd"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069284 - Use a per-list minimum_wait_duration for google5 updates. r=dimi\n\nThe V5 protocol sends a minimum_wait_duration per table, but we only\nuse the duration of the last table to schedule the next update, which\ncould be wrong if the duration is longer or shorter than others.\n\nThis patch fixes this issue. The nextUpdateTime pref will contain the\nearliest update time among updated tables. And we use per-list pref to\nstore the update time for tables that have later time than the earliest\ntable. We schedule the timer according to the earliest update time and\nskip those tables that are not expired.\n\nWe also updates relevant tests for this change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323990\n", "files": ["toolkit/components/reputationservice/test/unit/test_app_rep.js", "toolkit/components/reputationservice/test/unit/test_app_rep_maclinux.js", "toolkit/components/reputationservice/test/unit/test_app_rep_windows.js", "toolkit/components/url-classifier/Entries.h", "toolkit/components/url-classifier/ProtocolParser.cpp", "toolkit/components/url-classifier/ProtocolParser.h", "toolkit/components/url-classifier/UrlClassifierListManager.sys.mjs", "toolkit/components/url-classifier/nsIUrlClassifierDBService.idl", "toolkit/components/url-classifier/nsIUrlClassifierTestUtils.idl", "toolkit/components/url-classifier/nsUrlClassifierDBService.cpp", "toolkit/components/url-classifier/nsUrlClassifierDBService.h", "toolkit/components/url-classifier/nsUrlClassifierProxies.cpp", "toolkit/components/url-classifier/nsUrlClassifierProxies.h", "toolkit/components/url-classifier/nsUrlClassifierStreamUpdater.cpp", "toolkit/components/url-classifier/nsUrlClassifierTestUtils.cpp", "toolkit/components/url-classifier/tests/gtest/TestProtocolParser.cpp", "toolkit/components/url-classifier/tests/unit/head_urlclassifier.js", "toolkit/components/url-classifier/tests/unit/test_dbservice.js", "toolkit/components/url-classifier/tests/unit/test_digest256.js", "toolkit/components/url-classifier/tests/unit/test_listmanager_v5_update_timing.js", "toolkit/components/url-classifier/tests/unit/test_rsListService.js", "toolkit/components/url-classifier/tests/unit/xpcshell.toml"], "git_node": "57cf7b17dabc7377ad20a30d9a675ffd1facd49f", "git_parents": ["c169dc7e1c7e840dd3cc97f836870aecf0afa8eb"], "node": "b7d39e993e8af5dd3559787ef74f98da2b12d4e4", "parents": ["9d3c4811f446f9258f46267db46329d5ca7bb7dc"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2055967 - Remove two of the three sort operations from the frecency queries and annotate the remaining one r=places-reviewers,mak\n\nThe frecency queries in CalculateFrecencyFunction and CalculateAltFrecencyFunction\nperformed three sort operations, so every recalculation logged the \"Suboptimal\nindexes for the SQL statement\" storage warning.\n\nTwo were avoidable. The bookmark CTE ordered by dateAdded, but the only index on\nfk is moz_bookmarks_itemlastmodifiedindex; max(dateAdded) expresses the same\nthing without a sort, with HAVING count(*) \u003e 0 keeping the bare aggregate from\nreturning an all-NULL row where ORDER BY ... LIMIT 1 returned none. The\nsampled_visits limit was redundant, since visit_interaction already keeps the\nnumSampledVisits most recent rows of the union and a visit that is not among the\nmost recent here cannot survive that; dropping it lets\nmoz_historyvisits_placedateindex supply the order to the merge directly.\n\nThe third sort is inherent, as no index can order the union of moz_historyvisits\nand moz_places_metadata rows, so the query is annotated with\n/* do not warn (bug 2055967) */ per storage/docs/warnings.md. That annotation is\nwhat stops the warning.\n\nResults are unchanged: both queries were compared against the originals for all\n67201 pages of a real places.sqlite across six parameter combinations, plus\nsynthetic databases covering the bookmark and tied-visit_date cases the profile\nhas no rows for. The tie-boundary choice is formally unspecified, before as after.\n\nComputing the frecency of those 67201 pages went from 1194ms to 899ms for the\nmain query and 1018ms to 823ms for the alternative one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315533\n", "files": ["toolkit/components/places/SQLFunctions.cpp"], "git_node": "9ba93b490778534bb60a9d5daaac0518f4d7584b", "git_parents": ["57cf7b17dabc7377ad20a30d9a675ffd1facd49f"], "node": "3dc6f7a846054e81e37ba5fb9adc2af06b8f4185", "parents": ["b7d39e993e8af5dd3559787ef74f98da2b12d4e4"], "tags": []}, {"author": "Syed \u003csfshah@zohomail.eu\u003e", "branch": "default", "desc": "Bug 2004273 - Turn devtools/client/jsonview/converter-child.js into an ES class r=nchevobbe,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323693\n", "files": ["devtools/client/jsonview/converter-child.js"], "git_node": "88ebb3424b5768f42940c5bddee5b1a7647ef89e", "git_parents": ["9ba93b490778534bb60a9d5daaac0518f4d7584b"], "node": "3d6daec2465552eb614843a452832874abbdd694", "parents": ["3dc6f7a846054e81e37ba5fb9adc2af06b8f4185"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2002596 - Improve algorithmic complexity of manifestparser.filters.chunk_by_runtime r=jcristau\n\nThis saves around 50ms on task graph building.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D274153\n", "files": ["testing/mozbase/manifestparser/manifestparser/filters.py"], "git_node": "94975073e754a9c08f8bdf935210d58f65e9e5d0", "git_parents": ["88ebb3424b5768f42940c5bddee5b1a7647ef89e"], "node": "d0387ce6d1a409c4aff93f7e0134d9c05f11b3fe", "parents": ["3d6daec2465552eb614843a452832874abbdd694"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064377 - Add tests for search mode switcher icon in newtab searchbar. r=urlbar-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323238\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js"], "git_node": "6bdec778209a8b99f417302a13d600edd7771e58", "git_parents": ["94975073e754a9c08f8bdf935210d58f65e9e5d0"], "node": "d274bb6e60c0487429ea0d57b4218907dc1b2ed4", "parents": ["d0387ce6d1a409c4aff93f7e0134d9c05f11b3fe"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062652 - Part 3 - Add Sanitizer entry points for the HTML parser r=tschuster\n\nSanitizing while parsing needs the per-element algorithms of Part 1 one element\nat a time, and from a const Sanitizer, because the parser holds the\nconfiguration for the whole parse without owning it.\n\nThis change adds the entry points and makes the paths they need const. There is\nno caller yet.\n\n- SanitizeElement() runs \"sanitize\" for an element that is already in the tree,\n\n- MatchElement() and ShouldRemoveAttribute() run it for a start tag token,\n  before the element exists: the parser matches the element name once, then\n  filters the token's attributes with that match, so that the element creation\n  process never sees a disallowed \"is\",\n\n- CommentsAllowed() reports whether the configuration keeps comments.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320676\n", "files": ["dom/security/sanitizer/Sanitizer.cpp", "dom/security/sanitizer/Sanitizer.h"], "git_node": "f5018c1c0d72c08c0df4c0f052b0e28c5fd1a2a9", "git_parents": ["6bdec778209a8b99f417302a13d600edd7771e58"], "node": "b644282d11638c9e6b759edd0b049795d96329b5", "parents": ["d274bb6e60c0487429ea0d57b4218907dc1b2ed4"], "tags": []}, {"author": "Janika \u003cjneuberger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028825 - Make DisableDeveloperTools take effect live r=ochameau,devtools-reviewers\n\nObserve devtools.policy.disabled at runtime. On change, DevToolsStartup\nremoves/restores the per-window entry points (the key shortcuts and the lazy\n\"Browser Tools\" menu bootstrap) and toggles the global developer toggle\n(wrench) button, which is created once when the first window is ready. It also\ncloses any open in-window toolbox, Browser Toolbox and Browser Console.\n\ndevtools-browser hides/shows the Tools-menu items live, and the slow-script\nhang notification no longer offers the \"debug script\" button while disabled\n(slowScriptDebugHandler also bails out).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320404\n", "files": ["browser/components/customizableui/test/browser_proton_moreTools_panel.js", "browser/modules/ProcessHangMonitor.sys.mjs", "devtools/client/debugger/test/mochitest/browser_dbg-slow-script.js", "devtools/client/framework/browser-toolbox/Launcher.sys.mjs", "devtools/client/framework/devtools-browser.js", "devtools/client/framework/devtools.js", "devtools/client/menus.js", "devtools/startup/DevToolsStartup.sys.mjs", "devtools/startup/tests/browser/browser.toml", "devtools/startup/tests/browser/browser_disable_devtools_live.js", "devtools/startup/tests/browser/browser_disable_devtools_live_browser_console.js", "devtools/startup/tests/browser/browser_disable_devtools_live_browser_toolbox.js"], "git_node": "5267448ad58340b83b2f4fcda1fcf2c26ae1b709", "git_parents": ["f5018c1c0d72c08c0df4c0f052b0e28c5fd1a2a9"], "node": "15445eb2d9f944271a9f5d409f768d59b803ead8", "parents": ["b644282d11638c9e6b759edd0b049795d96329b5"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2069092 - Align address bar tracker count with about:protections. r=timhuang,daleharvey\n\nThere were a couple of discrepancies between what trackers were counted\nin the address bar and trust panel, vs. when they were counted in the\ntotals on about:protections. Specifically, the address bar/trust panel:\n- accidentally counted detected trackers regardless of whether they were\n  blocked,\n- accidentally also counted non-tracking cookies that were blocked (e.g.\n  if the user just blocks *all* cookies), and\n- also counted entries from #fetchSmartBlocked regardless of whether\n  they were blocked.\n\nAdditionally, it did some unnecessary work by calling\nProtectionCategory.getBlockerCount(), which generates otherwise unused\nDOM elements and counts the number of children. Now, we just look at the\nblocking log directly.\n\n(There is still the possibility of a slight discrepancy. If the same\ntracker gets blocked multiple times on the same page, it will only get\ncounted once - except if you view a surface that calls the\nTrackingDBService, such as about:protections, in between.  However, that\nis a pre-existing edge case outside the scope of this patch.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323078\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/protections/PrivacyMetricsService.sys.mjs", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_privacy_metrics_alignment.js", "toolkit/components/antitracking/TrackingDBService.sys.mjs", "tools/lint/rejected-words.yml"], "git_node": "8168fe2d5fc7fd2a020f29ef395cada361d50888", "git_parents": ["5267448ad58340b83b2f4fcda1fcf2c26ae1b709"], "node": "c92f817dddfbfc94e0e525f6f9ac5c20eecc827b", "parents": ["15445eb2d9f944271a9f5d409f768d59b803ead8"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2069431 - [loong64] Part 1: Use CPUCFG instruction to detect CPU features. r=spidermonkey-reviewers,jandem\n\nThis is more future-proof than kernel's hwcap, since it can enable\ndirect observation of features not yet exposed via hwcap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323681\n", "files": ["js/src/jit/loong64/Architecture-loong64.cpp"], "git_node": "53e2383aaa9a8299656e0c49d7de4c79c3a20438", "git_parents": ["8168fe2d5fc7fd2a020f29ef395cada361d50888"], "node": "aedf99d0fa5c269abfd88096d8c78c37d5000057", "parents": ["c92f817dddfbfc94e0e525f6f9ac5c20eecc827b"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2069431 - [loong64] Part 2: Implement feature detection for the LAMCAS extension. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323683\n", "files": ["js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/loong64/Architecture-loong64.h"], "git_node": "0e917dd6be707eb40a24af8524e8b4f17d2f10ff", "git_parents": ["53e2383aaa9a8299656e0c49d7de4c79c3a20438"], "node": "4b6066e57b7090e99c2b55dd4afed2647d389f65", "parents": ["aedf99d0fa5c269abfd88096d8c78c37d5000057"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2069431 - [loong64] Part 3: Implement simulation for LAMCAS instructions. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323684\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "c6572663ab6263903664e0f45cedbd33d66f4865", "git_parents": ["0e917dd6be707eb40a24af8524e8b4f17d2f10ff"], "node": "0a97c06e0d2a2533a7e56b6b6c4b023b1c41ec0f", "parents": ["4b6066e57b7090e99c2b55dd4afed2647d389f65"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2069431 - [loong64] Part 4: Implement {dis,}assembly for LAMCAS instructions. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323685\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/l