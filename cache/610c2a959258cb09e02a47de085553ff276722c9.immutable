.mozilla.com/D322635\n", "files": ["python/mozbuild/mozbuild/action/fat_aar.py", "python/mozbuild/mozbuild/action/file_generate_wrapper.py", "python/mozbuild/mozbuild/action/generate_symbols_file.py", "python/mozbuild/mozbuild/action/langpack_manifest.py", "python/mozbuild/mozbuild/action/node.py", "python/mozbuild/mozbuild/action/package_generated_sources.py", "python/mozbuild/mozbuild/action/process_define_files.py", "python/mozbuild/mozbuild/action/symbols_archive.py", "python/mozbuild/mozbuild/action/test_archive.py", "python/mozbuild/mozbuild/action/wrap_rustc.py", "python/mozbuild/mozbuild/action/xpccheck.py", "python/mozbuild/mozbuild/action/xpidl-process.py"], "git_node": "1a35a380384089ebc17478177466182c5788f00f", "git_parents": ["de4a22953e43a1579c62276e0b396cce92d359d5"], "node": "eec0e3d050a5cdaa581ab9124b9b0326edeea559", "parents": ["83e2b81e3578b84ba70b8d584f840836609fda5b"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067552: Relax asserts in CanvasTranslator, to prevent a crash by a malicious writer. r=gfx-reviewers,lsalzman\n\nThe shmem header is, by definition, manipulated by the\nCanvasDrawEventRecorder, which should only ever increment the\neventCount. If it does other things, we don't want the CanvasTranslator\nto crash because of inconsistent state. Instead, we mark the translation\nas failed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322768\n", "files": ["gfx/layers/ipc/CanvasTranslator.cpp"], "git_node": "837c31e8c4464a23f7541f51a2728033e9eb9da5", "git_parents": ["1a35a380384089ebc17478177466182c5788f00f"], "node": "1b6686c4819d21441a8a0342a92e421d19949e99", "parents": ["eec0e3d050a5cdaa581ab9124b9b0326edeea559"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066445 - Document FOG startup and shutdown r=janerik DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322430\n", "f