/computed/length.rs", "servo/components/style/values/computed/length_percentage.rs", "servo/components/style/values/computed/mod.rs", "servo/components/style/values/computed/page.rs", "servo/components/style/values/computed/position.rs", "servo/components/style/values/computed/ratio.rs", "servo/components/style/values/computed/rect.rs", "servo/components/style/values/computed/transform.rs", "servo/components/style/values/generics/basic_shape.rs", "servo/components/style/values/generics/calc.rs", "servo/components/style/values/generics/color.rs", "servo/components/style/values/generics/grid.rs", "servo/components/style/values/generics/length.rs", "servo/components/style/values/generics/position.rs", "servo/components/style/values/generics/transform.rs", "servo/components/style/values/generics/ui.rs", "servo/components/style/values/mod.rs", "servo/components/style/values/specified/angle.rs", "servo/components/style/values/specified/animation.rs", "servo/components/style/values/specified/box.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/color.rs", "servo/components/style/values/specified/counters.rs", "servo/components/style/values/specified/easing.rs", "servo/components/style/values/specified/effects.rs", "servo/components/style/values/specified/font.rs", "servo/components/style/values/specified/grid.rs", "servo/components/style/values/specified/image.rs", "servo/components/style/values/specified/length.rs", "servo/components/style/values/specified/list.rs", "servo/components/style/values/specified/number.rs", "servo/components/style/values/specified/param.rs", "servo/components/style/values/specified/percentage.rs", "servo/components/style/values/specified/position.rs", "servo/components/style/values/specified/resolution.rs", "servo/components/style/values/specified/svg.rs", "servo/components/style/values/specified/svg_path.rs", "servo/components/style/values/specified/time.rs"], "git_node": "5bcbe9104f3dd077d3da99571c280fdbfa0ff492", "git_parents": ["38cabc00d69da70f579ad03d2f1aa9b54b4d1905"], "node": "e485e8c58b356c1cef368e2ed7c7b7f1727ddf1b", "parents": ["859e3317eb6f7df10b27ee6e843f4d11e54b45b0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067753 - Fix some of the uncontroversial generated code issues. r=firefox-style-system-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322322\n", "files": ["servo/components/style/gecko/pseudo_element_definition.mako.rs", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/helpers.mako.rs", "servo/components/style/properties/helpers/animated_properties.mako.rs", "servo/components/style/properties/properties.mako.rs"], "git_node": "8123f94f1446e45fd455efd9c789d33dae9537e1", "git_parents": ["5bcbe9104f3dd077d3da99571c280fdbfa0ff492"], "node": "9f977e253a886c9df2888df1d0a8103183d83a4e", "parents": ["e485e8c58b356c1cef368e2ed7c7b7f1727ddf1b"], "tags": []}, {"author": "David Torcivia \u003cdavid.torcivia@gmail.com\u003e", "branch": "default", "desc": "Bug 2057758 - Signal the input color space to the codec in FFmpegVideoEncoder. r=media-playback-reviewers,chunmin\n\nThe encoder config's SampleFormat already carries the input frames' color\nspace for planar YUV sources, but nothing was ever set on the codec\ncontext, so every bitstream we produce says unspecified and decoders\nfall back to resolution-based heuristics. Map the known fields onto the\nAVCodecContext; fields the config does not know stay unspecified, so\nRGB-converted input is unchanged. The guards follow when each AVCOL_*\nconstant was introduced so older system libraries degrade to unspecified\nrather than misreporting.\n\nThe gtest encodes AV1 with a BT2020, PQ, full-range input, deliberately\ndifferent in every field from the CICP defaults, and asserts the parsed\nsequence header color_config via AOMDecoder::ReadSequenceHeaderInfo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314227\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoEncoder.cpp"], "git_node": "acf940dcc072913726509384e5a02c13308fd5d3", "git_parents": ["8123f94f1446e45fd455efd9c789d33dae9537e1"], "node": "f2bd628f3dc6d11aceb25bab7ce87e1c28b14698", "parents": ["9f977e253a886c9df2888df1d0a8103183d83a4e"], "tags": []}, {"author": "David Rubino \u003cdrubino@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067455 - Stub ASRouter.sendTriggerMessage in browser_setDefaultPDFHandler.js. r=firefox-desktop-core-reviewers ,mconley\n\nThe remoteDisable task enrolls with setDefaultBrowserUserChoice: false, which\nflips the fallbackPref that ShellService.setDefaultBrowser reads, so the test\nfalls through to the non-UserChoice path. The native setDefaultBrowser is\nstubbed there, but _maybeShowSetDefaultGuidanceNotification was not, so the\ndeeplinkedToWindowsSettingsUI trigger fired for real and popped a Windows toast\non the machine running the test -- without Windows Settings ever opening.\n\nbrowser_setDefaultBrowser.js already stubs this for the same reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322083\n", "files": ["browser/components/shell/test/browser_setDefaultPDFHandler.js"], "git_node": "a9e2503f49be54ebfbcab8382b2b8a6cee8bdb49", "git_parents": ["acf940dcc072913726509384e5a02c13308fd5d3"], "node": "9dbd3a4df52adf7f9024b2aec31702a73c9fe1de", "parents": ["f2bd628f3dc6d11aceb25bab7ce87e1c28b14698"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2063730 - Don't load the user's desktop folder in browser_switchTabPermissionPrompt.js, r=firefox-desktop-core-reviewers ,mconley.\n\nThe test only needs a readable file:// URI. On part of the macOS test fleet the\ndesktop folder is not readable, and loading it throws\nNS_ERROR_FILE_ACCESS_DENIED.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321924\n", "files": ["browser/base/content/test/tabPrompts/browser_switchTabPermissionPrompt.js"], "git_node": "20359d05092505d27f1863cbf0326777ab8c7364", "git_parents": ["a9e2503f49be54ebfbcab8382b2b8a6cee8bdb49"], "node": "9e0200b520f61998f91a9af2e83168ba7cf75052", "parents": ["9dbd3a4df52adf7f9024b2aec31702a73c9fe1de"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2066852 - Only synthesize an HTTPS AliasMode record when a real AliasMode record was followed r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322245\n", "files": ["netwerk/dns/DNSPacket.cpp", "netwerk/dns/DNSPacket.h", "netwerk/dns/GetAddrInfo.cpp", "netwerk/dns/GetAddrInfo.h", "netwerk/dns/PlatformDNSAndroid.cpp", "netwerk/dns/PlatformDNSMac.cpp", "netwerk/dns/PlatformDNSUnix.cpp", "netwerk/dns/PlatformDNSWin.cpp", "netwerk/dns/TRR.cpp", "netwerk/test/unit/test_dns_override.js", "netwerk/test/unit/test_httpssvc_https_upgrade.js", "netwerk/test/unit/test_trr_httpssvc.js"], "git_node": "99d7a47de87397ea4a2cf7c31f0920b42816da59", "git_parents": ["20359d05092505d27f1863cbf0326777ab8c7364"], "node": "e741979ba4e24050b55ec31008d8009c8a00d5e2", "parents": ["9e0200b520f61998f91a9af2e83168ba7cf75052"], "tags": []}, {"author": "Syed \u003csfshah@zohomail.eu\u003e", "branch": "default", "desc": "Bug 2067302 - Fix misspellings in SearchService.shouldShowInstallPrompt. r=scunnane,search-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322390\n", "files": ["toolkit/components/search/SearchService.sys.mjs"], "git_node": "bdf8dc0e52bedb02e2c446bb7ff8973dab89ade0", "git_parents": ["99d7a47de87397ea4a2cf7c31f0920b42816da59"], "node": "9b2c205800042e0763b2be2caf5f548b3c5789a5", "parents": ["e741979ba4e24050b55ec31008d8009c8a00d5e2"], "tags": []}, {"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 2065005 - Use rounded corners for tooltips on macOS 27. r=mac-reviewers,spohl\n\nmacOS 27 applies rounded corners to native tooltips, measured at 5px. Firefox's tooltips should follow the system appearance and use rounded corners as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319989\n", "files": ["widget/cocoa/nsCocoaWindow.mm"], "git_node": "986291bbd16efa78e34aa922356296682096ac33", "git_parents": ["bdf8dc0e52bedb02e2c446bb7ff8973dab89ade0"], "node": "1d9b1357038727a6ada435f583f6a514b6c2f3e5", "parents": ["9b2c205800042e0763b2be2caf5f548b3c5789a5"], "tags": []}, {"author": "Abhishek Nimalan \u003cabhisheknimalan@gmail.com\u003e", "branch": "default", "desc": "Bug 2067886 - Add perf to native profiling documentation. r=perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322405\n", "files": ["testing/perfdocs/generated/browsertime.md", "testing/raptor/raptor/perfdocs/browsertime.md"], "git_node": "6022f40919069716edd324a20e2bbc5c3a4d838a", "git_parents": ["986291bbd16efa78e34aa922356296682096ac33"], "node": "dfe609906b22f4f8be0af98c8922cbc903196e20", "parents": ["1d9b1357038727a6ada435f583f6a514b6c2f3e5"], "tags": []}, {"author": "mimi \u003cmjung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060590 - Fixes ASRouter import-rollout script r=omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322401\n", "files": ["browser/components/asrouter/bin/import-rollouts.js", "browser/components/asrouter/tests/NimbusRolloutMessageProvider.sys.mjs"], "git_node": "6e3270096bf22a59983813c9d0b1df6865a2c802", "git_parents": ["6022f40919069716edd324a20e2bbc5c3a4d838a"], "node": "5947814c0c2f62e266752da31a9b15a9bbfc53ce", "parents": ["dfe609906b22f4f8be0af98c8922cbc903196e20"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058181 - More carefully clamp grid tracks. r=dshin\" for causing mass failures\n\nThis reverts commit a7bca7e4b37e40531231d502d13d1b913906e6a9.\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/tests/css/css-grid/firefox-bug-2058181-crash.html"], "git_node": "705acae078edb9ce3bc5940ced82a45846b27159", "git_parents": ["6e3270096bf22a59983813c9d0b1df6865a2c802"], "node": "bcb199ce9ddc80edeb9b5c49edf0be08730c0207", "parents": ["5947814c0c2f62e266752da31a9b15a9bbfc53ce"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067296: Use a fuse in TestVAndBranch r=mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322034\n", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": "0c5215507a51504daea65bb4e9750161c012e437", "git_parents": ["705acae078edb9ce3bc5940ced82a45846b27159"], "node": "69e42f6ba8a86c1af44ac70deb787c63b961f8ad", "parents": ["bcb199ce9ddc80edeb9b5c49edf0be08730c0207"], "tags": []}, {"author": "Akhil Pindiprolu \u003capindiprolu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047030 - [Ungrouping] Navigate to confirmation dialog when user clicks Ungroup r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316863\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupCardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabstray/ui/tabitems/TabGroupOnboardingItemTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/ExpandedTabGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupCard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/navigation/TabManagerNavDestination.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/action/TabGroupAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupActionReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/NormalTabsPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/PrivateTabsPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayout.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabstray/TabsTray.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ExpandedTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupReducerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayoutTest.kt"], "git_node": "9d5f089ca19c6b13e4c9f48c00844aab2a5f0280", "git_parents": ["0c5215507a51504daea65bb4e9750161c012e437"], "node": "9b09689b9fa61b3e2d323e94ad6659d76135ead9", "parents": ["69e42f6ba8a86c1af44ac70deb787c63b961f8ad"], "tags": []}, {"author": "Akhil Pindiprolu \u003capindiprolu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047029 - [Ungrouping] Add dialog logic for \"Don't Ask Again\" r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317642\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/action/TabGroupAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/middleware/TabManagerUiStateStorageMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupActionReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/reducer/TabsTrayReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/state/TabsTrayState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/repository/uistate/TabManagerUiStateDataStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/repository/uistate/TabManagerUiStateRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/repository/uistate/data/PersistedUIState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabstray/TabsTray.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/fakes/FakeTabManagerUiStateRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabManagerUiStateStorageMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupReducerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/reducer/TabsTrayStoreReducerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/repository/uistate/DefaultTabManagerUiStateRepositoryTest.kt"], "git_node": "59d1106ace97e34d15066fca39e8cdad2da04123", "git_parents": ["9d5f089ca19c6b13e4c9f48c00844aab2a5f0280"], "node": "4ba008f4e9af273b31d901f115e3316cedd079cd", "parents": ["9b09689b9fa61b3e2d323e94ad6659d76135ead9"], "tags": []}, {"author": "Akhil Pindiprolu \u003capindiprolu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047031 - [Ungrouping] Add logic to delete the group but not the tabs r=android-reviewers,calu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319164\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/ui/FenixOverlay.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/fakes/FakeTabGroupRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/database/TabGroupOperationsDao.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/storage/repository/TabGroupRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/action/TabGroupAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupActionReducer.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/storage/DefaultTabGroupRepositoryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/reducer/TabGroupReducerTest.kt"], "git_node": "4a702b157b7443b63a7b9461d3599d036f64dbd3", "git_parents": ["59d1106ace97e34d15066fca39e8cdad2da04123"], "node": "fee91d8a1ecf7927d441d24cc5cb263d44dbcec3", "parents": ["4ba008f4e9af273b31d901f115e3316cedd079cd"], "tags": []}, {"author": "Akhil Pindiprolu \u003capindiprolu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064425 - [Ungrouping] Record telemetry for ungrouping usage and \"Don't ask again\" checkbox r=android-reviewers,calu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319544\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/TabsTrayTelemetryMiddlewareTest.kt"], "git_node": "d43e232aa0a33da156eba779ea6f10b8f575f1ad", "git_parents": ["4a702b157b7443b63a7b9461d3599d036f64dbd3"], "node": "3a471b9df7ee12d112c34764f9099f3ef77bebc1", "parents": ["fee91d8a1ecf7927d441d24cc5cb263d44dbcec3"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2067555 - Quantise a text run's clip on the axes its glyphs are snapped on r=gfx-reviewers,nical\n\nA glyph pen is sub-pixel positioned on one axis and rounded to a whole device\npixel on the other. Bug 2050692 left the clip exact on both, but that is only\nneeded on the sub-pixel axis: elsewhere an exact clip disagrees with the grid the\nglyphs landed on, and since the shader clamps the glyph quad with no coverage\nterm, a clip edge falling mid-row drops that row of ink outright.\n\nNearest is the rounding that works: the line box is ascent + descent, so the clip\nand the pen are both round(box offset + an integer) and stay flush at every\nphase. Bug 2055145 rounded outward instead, which spills a pixel whenever the ink\ndoes not round up (bug 2065629).\n\nSo derive the axes from the font's SubpixelDirection, mirroring the snap_bias\ntable it already drives; local-raster runs snap in raster space, so leave them.\nThe snap is applied in request_resources and stored on the run's scratch, so\nculling still sees the unsnapped clip.\n\nExact and nearest differ only at the .5 tie, which is where the reftest puts it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322226\n", "files": ["gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/webrender/src/space.rs", "gfx/wr/wrench/reftests/text/bug2067555-ref.yaml", "gfx/wr/wrench/reftests/text/bug2067555.yaml", "gfx/wr/wrench/reftests/text/reftest.list"], "git_node": "ae6e50e39a18a10bfb16ad14045393ef5eb02bb2", "git_parents": ["d43e232aa0a33da156eba779ea6f10b8f575f1ad"], "node": "85dfd4ebc2d0fa88b5da62fa12ef7c6f470375af", "parents": ["3a471b9df7ee12d112c34764f9099f3ef77bebc1"], "tags": []}, {"author": "noahvarghese \u003cvarghese.noah@gmail.com\u003e", "branch": "default", "desc": "Bug 2021799 - import urlparse from urllib instead of six. r=firefox-desktop-core-reviewers ,chumphreys,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322152\n", "files": ["toolkit/components/telemetry/tests/marionette/harness/telemetry_harness/fog_ping_server.py"], "git_node": "f315102652efa184a3305630d13c2fc1f0f3ea8d", "git_parents": ["ae6e50e39a18a10bfb16ad14045393ef5eb02bb2"], "node": "b9fdb2b14ee95f8cb0d42efcfa542746acff69fb", "parents": ["85dfd4ebc2d0fa88b5da62fa12ef7c6f470375af"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2044071 - Part 1: Adapt the homepage shortcuts grid to the available width r=android-reviewers,gl\n\nReplace the fixed 4-per-row, fixed-size shortcut layout with a responsive\ngrid that keeps a 4-column minimum on narrow screens and scales up to 8\ncolumns on wide screens.\n\nAdd calculateTopSitesRowLayout(), which derives the column count (4-8),\ncell width and favicon size from the available width. Spacing between\nshortcuts is a fixed 8dp, so to fit the required columns the cell shrinks\nfrom its default size, and on very narrow screens the favicon shrinks with\nit, letting small devices such as the 240dp-wide Unihertz Jelly Star show 4\nshortcuts without horizontal scrolling.\n\nShortcuts fill from the left and every row starts under the first item, with\nany surplus width left as margin around the grid rather than stretching it\nor widening the gaps. The homepage and the shortcuts library now render the\nsame Shortcuts grid, built on LazyVerticalGrid, replacing the per-row layout\nthe homepage painted itself. The homepage already scrolls, so the grid there\ncannot measure itself; it is instead measured with SubcomposeLayout, from the\nreal TopSiteItemText, and given that exact height with scrolling disabled.\nMeasuring rather than estimating the text matters because a LazyVerticalGrid\nclips what does not fit, and the error in any estimate grows with the user's\nfont scale. The sizes reach TopSiteItem as a single TopSiteItemLayout rather\nthan one parameter per dimension.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318814\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSites.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/TopSitesLayout.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ui/AddShortcutItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ui/Shortcuts.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ui/ShortcutsScreen.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "3276521d4060b693fff9dc91377a43d47d94f6fc", "git_parents": ["f315102652efa184a3305630d13c2fc1f0f3ea8d"], "node": "5cbdf7e519f48743124e37a9f006fa5827307ec9", "parents": ["b9fdb2b14ee95f8cb0d42efcfa542746acff69fb"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2044071 - Part 2: Test the dynamic shortcuts grid layout r=android-reviewers,gl\n\nCover calculateTopSitesRowLayout() directly: the 4-column minimum on narrow\nscreens, the favicon shrinking with the cell once it no longer fits, the cell\nbeing capped at its default size so surplus width is left as margin, and the\ncolumn cap on wide screens.\n\nThis replaces the pager paging test, which went away with the pager itself in\nBug 2065188.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318821\n", "files": ["mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/TopSitesLayoutTest.kt"], "git_node": "513dcbff4c681736817e58f120e42ece1a742abf", "git_parents": ["3276521d4060b693fff9dc91377a43d47d94f6fc"], "node": "2afbcd6ef948dff6db9bbdb158e3f22d2d990e2e", "parents": ["5cbdf7e519f48743124e37a9f006fa5827307ec9"], "tags": []}, {"author": "elkal98 \u003ckhalid.alhaddad98@gmail.com\u003e", "branch": "default", "desc": "Bug 2044153 - Switch usage of \"browsingContext.fixupAndLoadURIString()\" to \"browsingContext.loadURI()\" r=whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321574\n", "files": ["remote/marionette/driver.sys.mjs", "remote/marionette/navigate.sys.mjs", "remote/marionette/reftest.sys.mjs"], "git_node": "0ba87241da92767afec4df669d8ab5d1b8187f8e", "git_parents": ["513dcbff4c681736817e58f120e42ece1a742abf"], "node": "a337a4a76fe6ed7e847be15090ae7f7c7b4c6f8e", "parents": ["2afbcd6ef948dff6db9bbdb158e3f22d2d990e2e"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067204: Separate Gecko's implementation of @supports named-feature from Servo's. r=firefox-style-system-reviewers,TYLin,Oriol\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321893\n", "files": ["servo/components/style/stylesheets/supports_rule.rs"], "git_node": "2061b8c6a4825326f3bf87db0e25e409e449a9c0", "git_parents": ["0ba87241da92767afec4df669d8ab5d1b8187f8e"], "node": "c5a95ff57e25eb1804cd21e5b71454f36041caf3", "parents": ["a337a4a76fe6ed7e847be15090ae7f7c7b4c6f8e"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065632 - Enable tab groups by default r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322395\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "b28849b2307610fd00b9939e50c8148b0fbe59e9", "git_parents": ["2061b8c6a4825326f3bf87db0e25e409e449a9c0"], "node": "ece310594dbf2e8d7d67abe0b796d8f8b6a1d26d", "parents": ["c5a95ff57e25eb1804cd21e5b71454f36041caf3"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065633 - Remove Legacy Telemetry \"update\" ping r=cdupuis,application-update-reviewers\n\nLeaves the Glean \"update\" ping instrumentation in t/c/telemetry for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321013\n", "files": ["toolkit/components/telemetry/docs/concepts/pings.md", "toolkit/components/telemetry/docs/data/update-ping.md", "toolkit/components/telemetry/docs/obsolete/collection/update-ping.md", "toolkit/components/telemetry/pings/UpdatePing.sys.mjs", "toolkit/components/telemetry/tests/browser/browser_UpdatePingSuccess.js", "toolkit/mozapps/update/tests/browser/browser_showWhatsNewPageTest.js", "toolkit/mozapps/update/tests/browser/browser_telemetry_updatePing_downloaded_ready.js", "toolkit/mozapps/update/tests/browser/browser_telemetry_updatePing_staged_ready.js", "toolkit/mozapps/update/tests/data/shared.js"], "git_node": "77dd154031734eeb639928cddc47be8fa35c4336", "git_parents": ["b28849b2307610fd00b9939e50c8148b0fbe59e9"], "node": "e3262a16f282e1a01013a5454bd754052c98af90", "parents": ["ece310594dbf2e8d7d67abe0b796d8f8b6a1d26d"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065633 - Move \"update\" ping instrumentation into owning component r=cdupuis,application-update-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321014\n", "files": ["browser/app/profile/firefox.js", "browser/components/BrowserContentHandler.sys.mjs", "toolkit/components/telemetry/app/TelemetryControllerParent.sys.mjs", "toolkit/components/telemetry/docs/internals/preferences.md", "toolkit/components/telemetry/moz.build", "toolkit/components/telemetry/pings/UpdatePing.sys.mjs", "toolkit/mozapps/update/UpdateService.sys.mjs"], "git_node": "157b4b2d370eb4c91e985f6512f9f9ef8dc4ed80", "git_parents": ["77dd154031734eeb639928cddc47be8fa35c4336"], "node": "2001f78249ae448bfb4227628604106558c0441c", "parents": ["e3262a16f282e1a01013a5454bd754052c98af90"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056965 - Part 1: Add checks for validating process-specific ID origins, r=dom-core-reviewers,vhilla\n\nA number of components use IDs created using GenerateProcessSpecificID.\nThese IDs include the ChildID of the creating process in the ID to avoid\nconflicts.\n\nThis patch adds some extra validation to ensure that, in places where we\nknow the ID should have been generated by the sending process, the\nChildID component of the ID contains that process' ID.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313550\n", "files": ["docshell/base/BrowsingContext.h", "docshell/base/nsDocShellLoadState.cpp", "docshell/shistory/SessionHistoryEntry.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentParent.cpp"], "git_node": "bf9b7e34e3a5aa81d501d87ba6613b3f6d73f619", "git_parents": ["157b4b2d370eb4c91e985f6512f9f9ef8dc4ed80"], "node": "b3588165ada87906b4d0b5fbfdeed93793ed5cb3", "parents": ["2001f78249ae448bfb4227628604106558c0441c"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056965 - Part 2: Validate OuterWindowId in RecvNewWindowGlobal, r=dom-core-reviewers,smaug\n\nThis is done by tracking the root OuterWindowId on the BrowserParent,\nand checking the OuterWindowId against that for toplevel windows within\nthe BrowserParent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318523\n", "files": ["dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/ContentParent.cpp"], "git_node": "0577095daf71da2d4ebd64693cf1d913eb8d96d6", "git_parents": ["bf9b7e34e3a5aa81d501d87ba6613b3f6d73f619"], "node": "ec449dbc95d35928462df642925c5ead262b751a", "parents": ["b3588165ada87906b4d0b5fbfdeed93793ed5cb3"], "tags": []}, {"author": "Chris DuPuis \u003ccdupuis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058020 - Use Windows Runtime API to find MSIX app launch method r=aborondo,win-reviewers,browser-installer-reviewers,mossop,nrishel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316649\n", "files": ["browser/app/winlauncher/LauncherProcessWin.cpp", "browser/app/winlauncher/moz.build"], "git_node": "cc7752aca2ab6d8537a365bcf3bbf8f3af8cfc4b", "git_parents": ["0577095daf71da2d4ebd64693cf1d913eb8d96d6"], "node": "6b5277cb1101a4bb8dbd316079ce21e02e23eb9e", "parents": ["ec449dbc95d35928462df642925c5ead262b751a"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058020 - Use Windows Runtime API to find MSIX app launch method r=aborondo,win-reviewers,browser-installer-reviewers,mossop,nrishel\" for causing build bustages in LauncherProcessWin.cpp.\n\nThis reverts commit cc7752aca2ab6d8537a365bcf3bbf8f3af8cfc4b.\n", "files": ["browser/app/winlauncher/LauncherProcessWin.cpp", "browser/app/winlauncher/moz.build"], "git_node": "5d1f31f6d197ec7099e724859173b96aa303ca74", "git_parents": ["cc7752aca2ab6d8537a365bcf3bbf8f3af8cfc4b"], "node": "1a70f51ad3674e3c31600ad51182f2e6ff0b71f9", "parents": ["6b5277cb1101a4bb8dbd316079ce21e02e23eb9e"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2056347 - Add weather forecast description to Weather widget's small size for screenreaders. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322239\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Weather/_Weather.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Weather.test.jsx"], "git_node": "ab6a13cbbb70e278c26ec8ce405a2b1c80debf39", "git_parents": ["5d1f31f6d197ec7099e724859173b96aa303ca74"], "node": "475881bf8ddac1daac32e7bba5351d5ad025148a", "parents": ["1a70f51ad3674e3c31600ad51182f2e6ff0b71f9"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067727 - In FOG init don't register a shutdown listener for a phase we're in or past. r=chumphreys\n\nWe can be init at any time, so we should be defensive here.\n\nConsidered bailing on init altogether if we're init this late, but even\nextremely short sessions might have some time to do meaningful work (see\nalso init-during-shutdown code in FOG::GetSingleton).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322417\n", "files": ["toolkit/components/glean/xpcom/FOG.cpp"], "git_node": "31f2c2e9bea57c2c4e7ab7bceed720de4bbf5e6f", "git_parents": ["ab6a13cbbb70e278c26ec8ce405a2b1c80debf39"], "node": "bfbfaae693f348f560d3c50276339d968a44b3b0", "parents": ["475881bf8ddac1daac32e7bba5351d5ad025148a"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2062778 - don't skip synchronous pref writes if an async pref write is already queued r=beth\n\nThis issue was mostly fixed in bug 2053962, but this is a corner case that\nwasn't handled correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319202\n", "files": ["modules/libpref/Preferences.cpp", "modules/libpref/test/browser/browser.toml", "modules/libpref/test/browser/browser_savePrefFile_explicit_target.js"], "git_node": "58d80240493aef6f6dabe6a0750d555c49220194", "git_parents": ["31f2c2e9bea57c2c4e7ab7bceed720de4bbf5e6f"], "node": "e4b34a33b9a112aa84e2327b054d525dc90afa0e", "parents": ["bfbfaae693f348f560d3c50276339d968a44b3b0"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067758 - Remove version 155 train-hop fallback for --panel-background-color in the Nova Top Sites dialog. r=ini\n\nThe `, revert` fallback on `.nova-enabled .edit-topsites .modalOverlayOuter` existed\nbecause the Nova value of `--panel-background-color` aliases `--popup-background-color`,\nwhich the platform only defines from 155 (bug 2054953). Shim added in bug 2062621.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322334\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_TopSites.scss"], "git_node": "a64f98f3bf668d9a693fcf4f6f52b70af300772a", "git_parents": ["58d80240493aef6f6dabe6a0750d555c49220194"], "node": "d9ddcf7e7e01fa7a2e884e9a9938fa754a06671e", "parents": ["e4b34a33b9a112aa84e2327b054d525dc90afa0e"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2052614 - Add a structured RemoteType representation. r=ipc-reviewers,necko-reviewers,geckoview-reviewers,extension-reviewers,media-playback-reviewers,webrtc-reviewers,places-reviewers,layout-reviewers,dom-worker-reviewers,ai-platform-reviewers,sandbox-reviewers,janerik,emilio,hiro,kershaw,bwc,asuth,mccr8,alwu,nordzilla,valentin,bobowen\n\nReplace bare remote type strings in C++ process-selection plumbing with\na RemoteType type which stores the parsed kind, isolation URI, and\nprocess selection attributes directly.\n\nThis preserves the existing serialized string form for IPC and JS-facing\nAPIs, while making native callers use explicit predicates and structured\nfields instead of manually parsing remote type prefixes and suffixes.\n\nNo JS-exposed API for parsing or otherwise interpreting remote types are\ncurrently exposed in this patch. My current expectation is that this\nwill likely look like a `nsIRemoteType` interface which wraps this\n`RemoteType` value type, exposing helpful getters for JS callers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310442\n", "files": ["browser/modules/test/unit/test_E10SUtils_nested_URIs.js", "caps/nsScriptSecurityManager.cpp", "docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContextGroup.cpp", "docshell/base/BrowsingContextGroup.h", "docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "docshell/base/nsAboutRedirector.cpp", "docshell/base/nsDocShellLoadState.cpp", "docshell/base/nsDocShellLoadState.h", "dom/base/ChromeUtils.cpp", "dom/base/nsFrameLoader.cpp", "dom/base/nsFrameLoader.h", "dom/base/nsFrameLoaderOwner.cpp", "dom/clients/manager/ClientOpenWindowUtils.cpp", "dom/clients/manager/ClientValidation.cpp", "dom/fetch/FetchParent.cpp", "dom/fs/child/FileSystemBackgroundRequestHandler.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/DOMTypes.ipdlh", "dom/ipc/InProcessChild.h", "dom/ipc/InProcessImpl.cpp", "dom/ipc/InProcessParent.h", "dom/ipc/LoadedOriginSet.cpp", "dom/ipc/LoadedOriginSet.h", "dom/ipc/PContent.ipdl", "dom/ipc/PreallocatedProcessManager.cpp", "dom/ipc/PreallocatedProcessManager.h", "dom/ipc/ProcessIsolation.cpp", "dom/ipc/ProcessIsolation.h", "dom/ipc/ProcessPriorityManager.cpp", "dom/ipc/RemoteType.cpp", "dom/ipc/RemoteType.h", "dom/ipc/WindowGlobalChild.cpp", "dom/ipc/WindowGlobalChild.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/gtest/ProcessIsolationTest.cpp", "dom/ipc/gtest/RemoteTypeTest.cpp", "dom/ipc/gtest/moz.build", "dom/ipc/jsactor/JSActorManager.h", "dom/ipc/jsactor/JSActorService.cpp", "dom/ipc/jsactor/JSActorService.h", "dom/ipc/jsactor/JSProcessActorProtocol.cpp", "dom/ipc/jsactor/JSProcessActorProtocol.h", "dom/ipc/jsactor/JSWindowActorProtocol.cpp", "dom/ipc/jsactor/JSWindowActorProtocol.h", "dom/ipc/moz.build", "dom/ipc/tests/test_headless_content_process.js", "dom/media/gmp/GMPProcessParent.cpp", "dom/media/gmp/GMPServiceParent.cpp", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessManager.cpp", "dom/media/webrtc/transport/ipc/WebrtcTCPSocket.cpp", "dom/onnx/InferenceSession.cpp", "dom/security/nsContentSecurityManager.cpp", "dom/security/nsContentSecurityManager.h", "dom/security/test/gtest/TestUnexpectedPrivilegedLoads.cpp", "dom/serviceworkers/ServiceWorkerPrivate.cpp", "dom/workers/remoteworkers/RemoteWorkerManager.cpp", "dom/workers/remoteworkers/RemoteWorkerManager.h", "dom/workers/remoteworkers/RemoteWorkerServiceParent.cpp", "dom/workers/remoteworkers/RemoteWorkerServiceParent.h", "dom/workers/remoteworkers/RemoteWorkerTypes.ipdlh", "dom/workers/sharedworkers/SharedWorker.cpp", "dom/workers/sharedworkers/SharedWorkerService.cpp", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessManager.cpp", "gfx/vr/ipc/VRProcessManager.cpp", "gfx/vr/ipc/VRProcessParent.cpp", "image/remote/RemoteImageProtocolHandler.cpp", "ipc/glue/BackgroundImpl.cpp", "ipc/glue/BackgroundParent.h", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundUtils.cpp", "ipc/glue/BackgroundUtils.h", "ipc/glue/ProcessUtils.h", "ipc/glue/ProcessUtils_common.cpp", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessManager.cpp", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp", "js/xpconnect/loader/ScriptPreloader.cpp", "js/xpconnect/loader/ScriptPreloader.h", "layout/base/PresShell.cpp", "mobile/android/components/geckoview/GeckoViewContentChannelParent.cpp", "modules/libpref/Preferences.cpp", "modules/libpref/Preferences.h", "netwerk/base/LoadInfo.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/TRRLoadInfo.cpp", "netwerk/base/nsBaseParentChannel.cpp", "netwerk/base/nsBaseParentChannel.h", "netwerk/base/nsILoadInfo.idl", "netwerk/base/nsIOService.cpp", "netwerk/base/nsIParentChannel.idl", "netwerk/ipc/DocumentChannelChild.cpp", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/ipc/DocumentLoadListener.h", "netwerk/ipc/NeckoChannelParams.ipdlh", "netwerk/ipc/NeckoParent.cpp", "netwerk/ipc/ParentChannelWrapper.cpp", "netwerk/ipc/SocketProcessHost.cpp", "netwerk/protocol/file/nsFileChannel.cpp", "netwerk/protocol/file/nsFileChannel.h", "netwerk/protocol/http/HttpChannelParent.cpp", "security/sandbox/linux/glue/SandboxPrefBridge.cpp", "toolkit/components/backgroundhangmonitor/BackgroundHangMonitor.cpp", "toolkit/components/backgroundhangmonitor/HangDetails.cpp", "toolkit/components/extensions/ExtensionPolicyService.cpp", "toolkit/components/extensions/webrequest/ChannelWrapper.cpp", "toolkit/components/glean/bindings/private/Labeled.cpp", "toolkit/components/glean/ipc/FOGIPC.cpp", "toolkit/components/ml/backends/llama/LlamaRunner.cpp", "toolkit/modules/E10SUtils.sys.mjs", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsEmbedFunctions.cpp", "uriloader/exthandler/nsExternalProtocolHandler.cpp", "xpcom/base/MemoryTelemetry.cpp"], "git_node": "c51090b135867f08b4e7a41047e12f67c8ced9e4", "git_parents": ["a64f98f3bf668d9a693fcf4f6f52b70af300772a"], "node": "158c81c49391386ffcd7b5148dc2f4cbea712eec", "parents": ["d9ddcf7e7e01fa7a2e884e9a9938fa754a06671e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067360 - Reserve room for the icon in the switcher's Proton panel items. r=daleharvey,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322382\n", "files": ["browser/themes/shared/urlbar.css"], "git_node": "ba38ff6c319c9805cb84e7e9aaba20c0d8ce2aa6", "git_parents": ["c51090b135867f08b4e7a41047e12f67c8ced9e4"], "node": "da8f5f08bf6ea4e965efe772a9d2c24e1885d155", "parents": ["158c81c49391386ffcd7b5148dc2f4cbea712eec"], "tags": []}, {"author": "tyler-thorne \u003ctthorne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061888 - Register Resource Monitor as a sidebar tool ? r=fluent-reviewers,sclements,flod\n\nAdds a pref-gated sidebar entry pointing at about:processes?groupby=tab,\nfollowing the same registerPrefSidebar() pattern as Passwords/AI Chat.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320796\n", "files": ["browser/app/profile/firefox.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-customize.mjs", "browser/components/sidebar/tests/browser/browser_view_sidebar_menu.js", "browser/locales/en-US/browser/sidebar.ftl", "tools/lint/fluent-lint/exclusions.yml"], "git_node": "822bc4bf816fd9e15d40fc0fdcff53ab5c565340", "git_parents": ["ba38ff6c319c9805cb84e7e9aaba20c0d8ce2aa6"], "node": "fc908ee841abd6a122bdf7e30896faeacf9f7e82", "parents": ["da8f5f08bf6ea4e965efe772a9d2c24e1885d155"], "tags": []}, {"author": "tyler-thorne \u003ctthorne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061888 - Auto-add Resource Monitor to the sidebar launcher ? r=sclements\n\nSets sidebar.newTool.migration.resourcemonitor so the tool appears in\nsidebar.main.tools the first time its visibility pref flips true,\nmatching the existing newTool migration mechanism.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320797\n", "files": ["browser/app/profile/firefox.js", "browser/components/sidebar/tests/browser/browser_tools_migration.js"], "git_node": "9621846ec1c8d89d8c0ae03bf1c83b1f438b5837", "git_parents": ["822bc4bf816fd9e15d40fc0fdcff53ab5c565340"], "node": "2319945cd22639969ce3e19a3b37ba696a140943", "parents": ["fc908ee841abd6a122bdf7e30896faeacf9f7e82"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066890 - Stop doing newtab bundling when running newtab tests r=maxx,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321689\n", "files": [".gitignore", ".hgignore", "browser/extensions/newtab/docs/index.md", "browser/extensions/newtab/package.json", "browser/extensions/newtab/yamscripts.yml"], "git_node": "d6867bd1f81839d7c78025c02438ec541338db52", "git_parents": ["9621846ec1c8d89d8c0ae03bf1c83b1f438b5837"], "node": "1b8e7075eb3c21d77a07051e2e09dac364b77422", "parents": ["2319945cd22639969ce3e19a3b37ba696a140943"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2016440 - Don't block application shutdown on the newtab train-hop update task. r=rpl,thecount,fchasen\n\n`scheduleUpdateTrainhopAddonState` registered an `AsyncShutdown.appShutdownConfirmed`\nblocker that awaited `_updateAddonStateDeferredTask.finalize()`. That tied application\nshutdown to the completion of a train-hop XPI download/install, producing the\n`AsyncShutdownTimeout | quit-application | newtabTrainhopAddon\nscheduleUpdateTrainhopAddonState shutting down` top crash.\n\nTo fix this, we now:\n\n- Drop the AsyncShutdown blocker entirely. Interrupting the update is safe: an already\n  staged install is applied on the next startup, and everything else is recomputed from\n  the Nimbus enrollments next session. Finalizing XPIProvider operations that are still\n  in progress is left to the XPIProvider's own AsyncShutdown blockers.\n- Add an `_isAppShuttingDown()` helper based on `nsIAppStartup.attemptingQuit` (the\n  earliest signal, set before `quit-application-granted` is notified) plus the existing\n  `isInOrBeyondShutdownPhase(APPSHUTDOWNCONFIRMED)` check, for shutdowns that don't go\n  through `nsIAppStartup.quit`.\n- Use it to bail out of the deferred task, to avoid starting a download that could never\n  be cancelled, and to avoid calling `continuePostponedInstall()` on the FirstStartup\n  restartless path once shutdown has begun.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320515\n", "files": ["browser/components/newtab/AboutNewTabResourceMapping.sys.mjs", "browser/components/newtab/test/xpcshell/test_nimbus_newtabTrainhopAddon_onBrowserReady.js", "browser/components/newtab/test/xpcshell/test_nimbus_newtabTrainhopAddon_shutdown.js", "browser/components/newtab/test/xpcshell/xpcshell.toml"], "git_node": "f7b38cf3ac033f159de100d06eb278f12dcd5d58", "git_parents": ["d6867bd1f81839d7c78025c02438ec541338db52"], "node": "b68e341126849077bcc676c8cdcc63aea38f3853", "parents": ["1b8e7075eb3c21d77a07051e2e09dac364b77422"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2013052 - Part 1: Add a ContentRecommendationsProvider interface for retrieving content recommendations r=android-reviewers,skhan\n\n- This provides the foundation that will allow the Merino Rust client to be swapped in as an alternative implementation for retrieving the content recommendations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322153\n", "files": ["mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/ContentRecommendationsUseCases.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpoint.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsProvider.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/ContentRecommendationsUseCasesTest.kt"], "git_node": "3b684ae55cacf6416e4606c0b5ffcdc9537e7ccc", "git_parents": ["f7b38cf3ac033f159de100d06eb278f12dcd5d58"], "node": "0763cc5ca6e13899ef1ac21fe8adb5a5f67f8d04", "parents": ["b68e341126849077bcc676c8cdcc63aea38f3853"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2013052 - Part 2: Extract the content recommendation image URL reformatting into a shared helper r=android-reviewers,skhan\n\n- This refactor the image URL reformatting so that it can be shared by any content recommendations provider implementation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322154\n", "files": ["mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpoint.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/utils/ContentRecommendationsImageUrl.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/utils/ContentRecommendationsImageUrlTest.kt"], "git_node": "05fe0fcb8006fdc9fb05eb56ec8ac5628cc93d52", "git_parents": ["3b684ae55cacf6416e4606c0b5ffcdc9537e7ccc"], "node": "562286671df68702c5c496e301ba29f76ca03057", "parents": ["0763cc5ca6e13899ef1ac21fe8adb5a5f67f8d04"], "tags": []}, {"author": "Nazeer Shaikh \u003ctheoriginalzan77@gmail.com\u003e", "branch": "default", "desc": "Bug 2064544 - Remove duplicate test_dont_suggest_default_engine task. r=scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322440\n", "files": ["browser/components/urlbar/tests/browser-search/browser_contextualsearch.js"], "git_node": "67b6051a51eb4207a201dbf4410d143e0c061ef1", "git_parents": ["05fe0fcb8006fdc9fb05eb56ec8ac5628cc93d52"], "node": "1c25a322318b36f5817a7a13adb592b60dc84fc8", "parents": ["562286671df68702c5c496e301ba29f76ca03057"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1981648 - P1: Add IsHTMLRange and fix IsHTMLSpinner. r=Jamie\n\nHTMLSpinnerAccessible was never assigned an mType of eHTMLSpinnerType,\nso that didn't work. Added IsHTMLRange as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321717\n", "files": ["accessible/basetypes/Accessible.h", "accessible/html/HTMLFormControlAccessible.h"], "git_node": "b4e78f927028bed6d8a0075199074b4d81ba3143", "git_parents": ["67b6051a51eb4207a201dbf4410d143e0c061ef1"], "node": "9f0c64b784d8afcae2dd15ceef1347214c286484", "parents": ["1c25a322318b36f5817a7a13adb592b60dc84fc8"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1981648 - P2: Make ranges and spinners adjustable with scroll action. r=Jamie,geckoview-reviewers,m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321718\n", "files": ["accessible/android/SessionAccessibility.cpp", "accessible/android/SessionAccessibility.h", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-range.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "a4b174ce8b627593936acd7dca83f5fa73bd858c", "git_parents": ["b4e78f927028bed6d8a0075199074b4d81ba3143"], "node": "d91acf6e88bf458eb677b28b61dda08e54992a39", "parents": ["9f0c64b784d8afcae2dd15ceef1347214c286484"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1981648 - P3: Send value change events for numeric values. r=Jamie,geckoview-reviewers,m_kato\n\nA non focused accessible sends a TYPE_VIEW_SCROLLED and a focused one a\nTYPE_VIEW_SELECTED...\n\nAlso removed redundant role description for slider since TalkBack\nalready speaks this role correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321719\n", "files": ["accessible/android/Platform.cpp", "accessible/android/SessionAccessibility.cpp", "accessible/android/SessionAccessibility.h", "dom/locales/en-US/chrome/accessibility/AccessFu.properties", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "eea30b93e20d5678bc3ce2f75a02215b5c6307a6", "git_parents": ["a4b174ce8b627593936acd7dca83f5fa73bd858c"], "node": "d2eecc916de3b5d826880e32b984e3b712c362d1", "parents": ["d91acf6e88bf458eb677b28b61dda08e54992a39"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067889 - Shorten the win64 custom-car checkout path to stay within MAX_PATH r=perftest-reviewers,aglavic\n\nWin64 CaR is failing due to one of the chrome-bidi node modules\nexceeding windows MAX_PATH (259 characters). This patch adjusts the\nintermediate directory names.\n\nThis patch also cleans up the windows PGO_FILE nesting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322407\n", "files": ["taskcluster/scripts/misc/build-custom-car.sh"], "git_node": "e7805e5e24287a8e7f220642867eed1daad3ccad", "git_parents": ["eea30b93e20d5678bc3ce2f75a02215b5c6307a6"], "node": "fa55c918875b7397b52e4cdd852c1d957dec2f58", "parents": ["d2eecc916de3b5d826880e32b984e3b712c362d1"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042429 - Move custom-car toolchain definitions from misc.yml into their own file r=perftest-reviewers,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322412\n", "files": ["taskcluster/kinds/toolchain/custom-car.yml", "taskcluster/kinds/toolchain/kind.yml", "taskcluster/kinds/toolchain/misc.yml"], "git_node"