tml.ini", "testing/web-platform/meta/scheduler/post-task-delay.any.js.ini", "testing/web-platform/meta/web-install/navigator-install-bad-inputs.tentative.https.html.ini", "testing/web-platform/meta/web-install/navigator-install-user-activation.tentative.https.html.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/handle_user_prompt/handle_user_prompt.py.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-addTransceiver.https.html.ini", "testing/web-platform/meta/webrtc/RTCRtpSender-setParameters.html.ini"], "git_node": "2271889cb73745689f25f8f26233d0cdbad11b96", "git_parents": ["2e7a2b239861f0a416980e636f93480f347889dd"], "node": "75b832c3c819c1065a2a1678d7f5266cb5f0b0da", "parents": ["96f8b5863a1a4cab2f81f34cdb60cfb9d04b4ed6"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061358: Update styling for edit sources dialog for SFF r=omarg\" for causing bc failures @ browser_smartwindow_smartformfill_autocomplete.js\n\nThis reverts commit 4361a6c7d78a9816a7a70f9477df5c2101a9116a.\n", "files": ["browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "toolkit/content/widgets/moz-box-item/moz-box-item.css"], "git_node": "db2ee30a0620a7d79be5b55877ac6d57331813c8", "git_parents": ["2271889cb73745689f25f8f26233d0cdbad11b96"], "node": "5caa1bd0cd9a0bb1580d1221d90df7ce450af60b", "parents": ["75b832c3c819c1065a2a1678d7f5266cb5f0b0da"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2067923 - Skip NVIDIA Vulkan decode when nvidia_drm modeset is disabled. r=stransky,media-playback-reviewers\n\nSkip NVIDIA GPUs in SelectVulkanDecoderPhysicalDevice when\nnvidia_drm modeset is off, and return NOT_AVAILABLE from init if no\nusable device remains. If NV12 DMA-BUF export still fails, return\nDECODE_ERR instead of FATAL so MediaFormatReader can drop this decoder.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322674\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp"], "git_node": "9c85b9b3071a80836e123ce5182eff4c4666a534", "git_parents": ["db2ee30a0620a7d79be5b55877ac6d57331813c8"], "node": "d67928675d356e526b5ae91a7a89022c57bcd1ad", "parents": ["5caa1bd0cd9a0bb1580d1221d90df7ce450af60b"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056749 - Add -moz-scrollbar-inset-{block, inline} for improved scrollbar boundaries for rounded chrome corners. r=emilio,tabbrowser-reviewers,firefox-style-system-reviewers,layout-reviewers,sthompson\n\n- Adds `-moz-scrollbar-inset-block` and `-moz-scrollbar-inset-inline`, chrome-only\n  `\u003cnon-negative-length\u003e{1,2}` longhands. Each names the scrollbar's axis it\n  applies to. The two values are the axis' logical start and end\n  and flip with the writing mode.\n- ScrollContainerFrame::ScrollbarInsets() serves as the one place to extract the inset from for\n    both nsScrollbarFrame and GetBorderRadii\n- Applies inset to nsScrollbarFrame::Reflow similar to stepper buttons\n- ScrollContainerFrame::GetBorderRadii no longer squares a corner off when the\n  inset already holds the scrollbar clear of the curve.\n- Forward the \u003cbrowser\u003e embedder's inset to a root scrollbar for the content viewport\n- Add reftests for css-scrollbars\n- This commit does NOT implement the css property anywhere\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313900\n", "files": ["devtools/server/actors/animation-type-longhand.js", "docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "dom/base/use_counter_metrics.yaml", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h", "layout/generic/ScrollContainerFrame.cpp", "layout/generic/ScrollContainerFrame.h", "layout/generic/WritingModes.h", "layout/generic/nsSubDocumentFrame.cpp", "layout/generic/nsSubDocumentFrame.h", "layout/reftests/css-scrollbars/reftest.list", "layout/reftests/css-scrollbars/scrollbar-inset-change-ref.html", "layout/reftests/css-scrollbars/scrollbar-inset-change.html", "layout/reftests/css-scrollbars/scrollbar-inset-forward-change.html", "layout/reftests/css-scrollbars/scrollbar-inset-forward-inner.html", "layout/reftests/css-scrollbars/scrollbar-inset-forward-notref.html", "layout/reftests/css-scrollbars/scrollbar-inset-forward.html", "layout/reftests/css-scrollbars/scrollbar-inset-inline-notref.html", "layout/reftests/css-scrollbars/scrollbar-inset-inline.html", "layout/reftests/css-scrollbars/scrollbar-inset-radii-change.html", "layout/reftests/css-scrollbars/scrollbar-inset-radii-inline-notref.html", "layout/reftests/css-scrollbars/scrollbar-inset-radii-inline.html", "layout/reftests/css-scrollbars/scrollbar-inset-radii-notref.html", "layout/reftests/css-scrollbars/scrollbar-inset-radii-ref.html", "layout/reftests/css-scrollbars/scrollbar-inset-radii-rtl.html", "layout/reftests/css-scrollbars/scrollbar-inset-radii.html", "layout/reftests/css-scrollbars/scrollbar-inset-rtl.html", "layout/reftests/css-scrollbars/scrollbar-inset-zoom.html", "layout/style/GenerateCSSProperties.py", "layout/style/ServoBindings.toml", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "layout/style/test/property_database.js", "layout/tools/reftest/jar.mn", "layout/xul/nsScrollbarFrame.cpp", "layout/xul/nsScrollbarFrame.h", "servo/components/style/properties/longhands.toml", "servo/components/style/values/computed/box.rs", "servo/components/style/values/computed/mod.rs", "servo/components/style/values/generics/box.rs", "servo/components/style/values/specified/box.rs", "servo/components/style/values/specified/mod.rs", "servo/ports/geckolib/cbindgen.toml"], "git_node": "19ded9cd7eb426e2f4e53a596bbff9f98a6df4a0", "git_parents": ["9c85b9b3071a80836e123ce5182eff4c4666a534"], "node": "84abd4c1eb166bfe850e92ac6e552e3b220c5e99", "parents": ["d67928675d356e526b5ae91a7a89022c57bcd1ad"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067366 - Restore the scrollbar in menulist popups. r=desktop-theme-reviewers,emilio\n\nA vertical arrowscrollbox hides its scrollbar, and the menulist rule set the scrollbox's overflow but not its scrollbar-width, so the popup kept scrolling with nothing to drag. Narrowing the overflow declaration to overflow-y crops a menuitem wider than the popup rather than scrolling it sideways. The declarations stay unconditional, so the popup is scrollable in its first frame; the arrowscrollbox only sets [overflowing] a frame later, from a ResizeObserver.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322351\n", "files": ["browser/base/content/test/forms/browser_selectpopup_colors.js", "toolkit/content/tests/chrome/chrome.toml", "toolkit/content/tests/chrome/test_menulist_scrollbar.xhtml", "toolkit/content/widgets/menupopup.css"], "git_node": "938d629cf0eb693dbb95d538fa96a7202d44af33", "git_parents": ["19ded9cd7eb426e2f4e53a596bbff9f98a6df4a0"], "node": "052201ba4a6dd466e53133b1de41b16dae7cd92c", "parents": ["84abd4c1eb166bfe850e92ac6e552e3b220c5e99"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068470 - Move the urlbar Glean telemetry assertion helpers to the shared test head. r=mbeier,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322867\n", "files": ["browser/components/urlbar/tests/browser-engagementTelemetry/head.js", "browser/components/urlbar/tests/browser/head-common.js"], "git_node": "35a34aa027bf3aceb070b23f0adf21c2b029ff28", "git_parents": ["938d629cf0eb693dbb95d538fa96a7202d44af33"], "node": "8d872380da6a8c292cb36985421a2b5ff9fe1e7c", "parents": ["052201ba4a6dd466e53133b1de41b16dae7cd92c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068470 - Resolve a New Tab search bar result's url parent-side in NewtabSearchbarTestUtils. r=mbeier,urlbar-reviewers\n\nReading the details of a search result threw \"Something tried to use the search service before it finished initializing\", since the content-side utils resolved the url themselves.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322868\n", "files": ["browser/components/urlbar/tests/NewtabSearchbarContentTestUtils.sys.mjs", "browser/components/urlbar/tests/NewtabSearchbarTestUtils.sys.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "96c52853df95cdda6ed1f903dac87c1ac0fb1c1f", "git_parents": ["35a34aa027bf3aceb070b23f0adf21c2b029ff28"], "node": "d10d1bdec2e50b9f83885ab5405a7a53df7a62d7", "parents": ["8d872380da6a8c292cb36985421a2b5ff9fe1e7c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068470 - Test the New Tab search bar's engagement, abandonment, disable and bounce telemetry. r=mbeier\n\nThe bar records no urlbar.bounce (bug 2068488), so browser_bounceTelemetry.js asserts that absence with the address bar in the same page as its control.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322869\n", "files": ["browser/components/urlbar/tests/browser-newtab/browser.toml", "browser/components/urlbar/tests/browser-newtab/browser_bounceTelemetry.js", "browser/components/urlbar/tests/browser-newtab/browser_disableTelemetry.js", "browser/components/urlbar/tests/browser-newtab/browser_engagementTelemetry.js", "browser/components/urlbar/tests/browser-newtab/browser_engagementTelemetryGroups.js", "browser/components/urlbar/tests/browser-newtab/head.js", "browser/components/urlbar/tests/browser/head-common.js"], "git_node": "302b1ef016259af50d82dfb5bbe49fb199658212", "git_parents": ["96c52853df95cdda6ed1f903dac87c1ac0fb1c1f"], "node": "a5a9d8186da1eaecf8ef1e4030dbd671a1324e3f", "parents": ["d10d1bdec2e50b9f83885ab5405a7a53df7a62d7"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1984858 - When homepage as new tab is enabled, make new tab shortcuts open to new homepage tab r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318751\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/IntentReceiverActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/OpenHomeIntentProcessor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/shortcut/NewTabShortcutIntentProcessor.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/IntentReceiverActivityTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/OpenHomeIntentProcessorTest.kt"], "git_node": "3cb6a03ecb6cc558b5f529d413f1958fd04de94e", "git_parents": ["302b1ef016259af50d82dfb5bbe49fb199658212"], "node": "9635c34c727db03ea4fc8b09294d6097ad576066", "parents": ["a5a9d8186da1eaecf8ef1e4030dbd671a1324e3f"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065239 - Implement more metrics within InitMetricsFromSkrifa, including those derived from glyph measurement. r=AlaskanEmily,firefox-style-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320224\n", "files": ["gfx/fontations_glue/lib.rs", "gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxMacFont.cpp", "gfx/thebes/gfxMacFont.h", "layout/style/ServoBindings.toml", "layout/style/nsStyleStruct.h"], "git_node": "ce0226a1ed9330c3fc8115d8f8f15273bd2c3cd1", "git_parents": ["3cb6a03ecb6cc558b5f529d413f1958fd04de94e"], "node": "ae765d5eac0d09d6f0d2c57db6135559b9f30d29", "parents": ["9635c34c727db03ea4fc8b09294d6097ad576066"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065580 - Add claude skill for how to triage and resolve performance regressions r=kshampur,ai4dev-reviewers,suhaib\n\nWe previously added a \"perftest\" skill which helps you run a performance test.\nA recent event where a person struggled to resolve a regression made it clear we need to do more, we need a performance regression triage skill.\nThis skill should help all engineers resolve regressions whenever they appear faster(which is useful now that our release schedule is doubled)\nI included a test set to ensure that the \"perftest\" and \"perf-regression-triage\" skills do not get loaded too often and that if it's just a question on how to run a test only the perftest skill gets loaded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320525\n", "files": [".agents/skills/perf-regression-triage/SKILL.md", ".agents/skills/perf-regression-triage/references/close-out.md", ".agents/skills/perf-regression-triage/references/confirm.md", ".agents/skills/perf-regression-triage/references/iterate.md", ".agents/skills/perf-regression-triage/tests/trigger-tests.sh", ".agents/skills/perftest/SKILL.md", ".claude/skills/perf-regression-triage/SKILL.md", ".claude/skills/perf-regression-triage/references/close-out.md", ".claude/skills/perf-regression-triage/references/confirm.md", ".claude/skills/perf-regression-triage/references/iterate.md", ".claude/skills/perf-regression-triage/tests/trigger-tests.sh", ".claude/skills/perftest/SKILL.md"], "git_node": "c2f1c1e75f22c263de780819556b44b0242d57a8", "git_parents": ["ce0226a1ed9330c3fc8115d8f8f15273bd2c3cd1"], "node": "a72fd433b5bb62cb8044cb6e31aae1f8f2acd360", "parents": ["ae765d5eac0d09d6f0d2c57db6135559b9f30d29"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2067606 - Enable trending and recent search on the Homepage Search by default r=android-reviewers,skhan\n\n- Keep the Nimbus feature for experimentation, but remove the Secret Setting now that the feature is enabled on all channels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322937\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "ea90974d93c6dbfdf71b12c2d4f482323e030eda", "git_parents": ["c2f1c1e75f22c263de780819556b44b0242d57a8"], "node": "f255289101e71bad2318c61644089da88468b7bb", "parents": ["a72fd433b5bb62cb8044cb6e31aae1f8f2acd360"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068342 - r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322923\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "0efbf2875092db7dd8a7214196f164331106912e", "git_parents": ["ea90974d93c6dbfdf71b12c2d4f482323e030eda"], "node": "aa325b87b9e622d5153092cce1b2a502c0c790b1", "parents": ["f255289101e71bad2318c61644089da88468b7bb"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050444 - Change sidebar width to 50x wide when vertical tabs are enabled in compact and standard UI densities to make room for scrollbar r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321983\n", "files": ["browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "5e2141707d45273bbff77d583f59f6b5158857df", "git_parents": ["0efbf2875092db7dd8a7214196f164331106912e"], "node": "901e9aa18db1b5071795cf5dec398388e7425a08", "parents": ["aa325b87b9e622d5153092cce1b2a502c0c790b1"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2049215: Test-cases with various sender buffer/frame manipulations. r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318810\n", "files": ["testing/web-platform/meta/webrtc-encoded-transform/RTCEncodedFrame-copy-construction.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/RTCRtpScriptTransform-padding.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/script-metadata-transform.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-audio.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-errors.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-simulcast.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-video-frames.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-video.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/tentative/RTCPeerConnection-insertable-streams-worker.https.html.ini", "testing/web-platform/tests/webrtc-encoded-transform/RTCEncodedFrame-copy-construction.https.html", "testing/web-platform/tests/webrtc-encoded-transform/RTCEncodedFrame-shared-buffer.https.html", "testing/web-platform/tests/webrtc-encoded-transform/RTCEncodedFrame-shared-buffer.https.html.headers", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-encoded-transform-flex-worker.js", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-encoded-transform.https.html", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-padding-worker.js", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-padding.https.html", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-write-rules-worker.js", "testing/web-platform/tests/webrtc-encoded-transform/RTCRtpScriptTransform-write-rules.https.html", "testing/web-platform/tests/webrtc-encoded-transform/routines.js"], "git_node": "c82c38d9d2c8591cac9ca286e758a32d11cc2716", "git_parents": ["5e2141707d45273bbff77d583f59f6b5158857df"], "node": "72b6f9b5336aefa6a435e3d2ab46584c28bd7882", "parents": ["901e9aa18db1b5071795cf5dec398388e7425a08"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2049215: Fix various bugs, and cleanup, in frame handling. r=ng,sfink\n\nFixes a couple of nullptr crashes with frames that have been (or are\nbeing) cloned.\n\nFixes a deprecation warning for GetFrameDependencies.\n\nFixed bug where in-place buffer modifications weren't changing what\nwe fed back to libwebrtc, including transfer of the buffer.\n\nFixed bug where a failed memory allocation would result in a nullptr\ncrash, and other OOM handling improvements.\n\nFix release assert in copy c'tor for frames when a metadata member was\nnot set in the original.\n\nGet structuredClone with internal backrefs working.\n\nStop using struct initializer lists on stuff that has a base class, and\nuse real constructors instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318811\n", "files": ["dom/base/StructuredCloneHolder.cpp", "dom/media/webrtc/jsapi/RTCEncodedAudioFrame.cpp", "dom/media/webrtc/jsapi/RTCEncodedAudioFrame.h", "dom/media/webrtc/jsapi/RTCEncodedFrameBase.cpp", "dom/media/webrtc/jsapi/RTCEncodedFrameBase.h", "dom/media/webrtc/jsapi/RTCEncodedVideoFrame.cpp", "dom/media/webrtc/jsapi/RTCEncodedVideoFrame.h", "dom/media/webrtc/jsapi/RTCRtpScriptTransformer.cpp"], "git_node": "a55f14b766224594c761bf6a66d0d0aab73b91a8", "git_parents": ["c82c38d9d2c8591cac9ca286e758a32d11cc2716"], "node": "a452e2de47131f17db3a1dbf6ea18178b89483a5", "parents": ["72b6f9b5336aefa6a435e3d2ab46584c28bd7882"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2049215: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/webrtc/jsapi/RTCEncodedFrameBase.cpp", "dom/media/webrtc/jsapi/RTCEncodedVideoFrame.cpp"], "git_node": "8e5450c867167e5f6f0afb80abce33fbf41b526e", "git_parents": ["a55f14b766224594c761bf6a66d0d0aab73b91a8"], "node": "5468de625785a2d1c92b21ad7d09cf23ba7ee09c", "parents": ["a452e2de47131f17db3a1dbf6ea18178b89483a5"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068613: Add `all` to scoped name's `SpecifiedValueInfo`. r=emilio\n\nAll of `timeline-scope`, `anchor-scope`, and `view-transition-scope` support it.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/355\n", "files": ["servo/components/style/values/specified/position.rs"], "git_node": "cede486f2bff624502adad14197292d977bf6eb0", "git_parents": ["8e5450c867167e5f6f0afb80abce33fbf41b526e"], "node": "d3acd2b0bbc64852a4d88bbbf32cd6e483c30cf8", "parents": ["5468de625785a2d1c92b21ad7d09cf23ba7ee09c"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068035 - Renamed Feature-Policy to Permissions-Policy and switched to SFV parser r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322576\n", "files": ["dom/base/Document.cpp", "dom/security/featurepolicy/FeaturePolicy.cpp", "dom/security/featurepolicy/FeaturePolicy.h", "dom/security/featurepolicy/FeaturePolicyParser.cpp", "dom/security/featurepolicy/FeaturePolicyParser.h"], "git_node": "3ba2d05ee971280523b09d9d18d0247bd33198c1", "git_parents": ["cede486f2bff624502adad14197292d977bf6eb0"], "node": "7f3a4be7291d806d158bcd815e5e8d93f2a3878c", "parents": ["d3acd2b0bbc64852a4d88bbbf32cd6e483c30cf8"], "tags": []}, {"author": "Ayoub hedri \u003cahedri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068035 - Rename policy methods used for iframe allow attributes. r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322646\n", "files": ["dom/html/HTMLIFrameElement.cpp", "dom/security/featurepolicy/FeaturePolicy.cpp", "dom/security/featurepolicy/FeaturePolicy.h", "dom/security/featurepolicy/FeaturePolicyParser.cpp", "dom/security/featurepolicy/FeaturePolicyParser.h", "dom/security/featurepolicy/fuzztest/fp_fuzzer.cpp", "dom/security/featurepolicy/test/gtest/TestFeaturePolicyParser.cpp"], "git_node": "1b7e05a0278f9ceb6d56ffee22a409421d95d625", "git_parents": ["3ba2d05ee971280523b09d9d18d0247bd33198c1"], "node": "f417ba6cd89f0691605ff94404c1559c3f1339ec", "parents": ["7f3a4be7291d806d158bcd815e5e8d93f2a3878c"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067634 - Avoid H264 hardware encoding on Windows for record applications unless hardware is forced. r=media-playback-reviewers,padenot\n\nThe total encode time with hardware H264 is significantly worse\nthan software MFT on our benchmarks. OpenH264 is actually even more\ncompetitive but needs feature gaps to be closed before we could\nconsider switching to it. The hardware encoder performs better if\nit is able to avoid a GPU upload of the video frame (e.g. it was\nalready on the GPU, from an accelerated canvas) but there needs to\nbe a lot more plumbing to support that. For now, let's just\ncontinue using MFT H264 software encoding as the default, just as\nwe have already been shipping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322909\n", "files": ["dom/media/ipc/RemoteEncoderModule.cpp", "dom/media/platforms/wmf/WMFDataEncoderUtils.cpp"], "git_node": "db0c002802cce232587974e94a1402d594b1b478", "git_parents": ["1b7e05a0278f9ceb6d56ffee22a409421d95d625"], "node": "864ab78ffac1be2f3a4edf0397b12a41012589da", "parents": ["f417ba6cd89f0691605ff94404c1559c3f1339ec"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2066576 - [Monitor Agent] [FE] The Dot indicator r=yjamora,tetchart,desktop-theme-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321702\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorAttention.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_button.js", "browser/components/aiwindow/ui/test/xpcshell/test_MonitorAttention.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml", "browser/themes/shared/toolbarbutton-icons.css", "browser/themes/shared/toolbarbuttons.css", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "3dcde9fa9db984aedb7a0eaa18c2074c7d40f5dd", "git_parents": ["db0c002802cce232587974e94a1402d594b1b478"], "node": "f76eb931b267c462daac34e68a250ea139392872", "parents": ["864ab78ffac1be2f3a4edf0397b12a41012589da"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068547 - VPN location list fails to update dynamically after default browser change - r=ip-protection-reviewers,sstreich\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322941\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/xpcshell/test_IPProtectionPanel.js"], "git_node": "64ed108e8ffdddb7390658a2708d0751065862ff", "git_parents": ["3dcde9fa9db984aedb7a0eaa18c2074c7d40f5dd"], "node": "5ae90da4f5b0351e5dc05730ec522ece66c2dbd4", "parents": ["f76eb931b267c462daac34e68a250ea139392872"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067313 - Record one backupCanBeLoadedSessionFile event per session file load attempt. r=nsharpley\n\nThe finally block in _readInternal previously recorded an outcome for every file that\nexists, on top of the outcome the try and catch branches had already recorded.\nEvery file that existed therefore got counted twice.\n\nA file rejected for having an incompatible format version was counted a 2nd time as\ncan_load=true, because `corrupted` only gets set for read failures.\n\nEach branch now records its own outcome, with a new else branch so that errors\nnot handled by the existing branches handle are still recorded once, and the finally\nblock is left to accumulate corruptFile. The duplicate corruptFile.false sample\non the success path is removed for the same reason.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322788\n", "files": ["browser/components/sessionstore/SessionFile.sys.mjs", "browser/components/sessionstore/test/unit/test_glean_backup_can_be_loaded.js", "browser/components/sessionstore/test/unit/xpcshell.toml"], "git_node": "394779889468894e17bdeca660c1ec87993b8bf3", "git_parents": ["64ed108e8ffdddb7390658a2708d0751065862ff"], "node": "0cb4356798d98a91f83ac29b123d24192613a2e7", "parents": ["5ae90da4f5b0351e5dc05730ec522ece66c2dbd4"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066422 - Add \"--write-task-config\" CLI argument to \"mach try\" command. r=perftest-reviewers,jgraham,sparky\n\nThis argument is supposed to create try_task_config.json without pushing to CI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321215\n", "files": ["tools/tryselect/cli.py", "tools/tryselect/push.py", "tools/tryselect/selectors/auto.py", "tools/tryselect/selectors/chooser/__init__.py", "tools/tryselect/selectors/coverage.py", "tools/tryselect/selectors/empty.py", "tools/tryselect/selectors/fuzzy.py", "tools/tryselect/selectors/perf.py", "tools/tryselect/selectors/release.py", "tools/tryselect/selectors/scriptworker.py", "tools/tryselect/test/test_push.py"], "git_node": "c66e6acb94c3643535c0f1d774366232e80033b4", "git_parents": ["394779889468894e17bdeca660c1ec87993b8bf3"], "node": "fe051673af07339969ed6bdb91b68b463b3c67c3", "parents": ["0cb4356798d98a91f83ac29b123d24192613a2e7"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061059: Style SFF autocomplete row item r=omarg,fluent-reviewers,desktop-theme-reviewers,credential-management-reviewers,mkennedy,hjones,bolsson,mtigley\" for causing bc failures @ browser_smartwindow_smartformfill_autocomplete.js\n\nThis reverts commit df773d5dde4cedc3a1317851955c81af81dcd7ad.\n", "files": ["browser/components/aiwindow/ui/assets/sff-autofill-icon.svg", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/SmartFormFillAutocomplete.sys.mjs", "browser/extensions/formautofill/test/browser/browser_autocomplete_footer.js", "browser/locales-preview/aiWindow.ftl", "browser/themes/shared/autocomplete.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.mjs", "toolkit/components/satchel/test/browser/browser_autocomplete.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "86c31c8702593159e96546be8c4c759d790a41d8", "git_parents": ["c66e6acb94c3643535c0f1d774366232e80033b4"], "node": "2cae0494cd0e3c9c2fe34deda148554473016626", "parents": ["fe051673af07339969ed6bdb91b68b463b3c67c3"], "tags": []}, {"author": "@Giulia \u003c@Giulia\u003e", "branch": "default", "desc": "Bug 2061358: Update styling for edit sources dialog for SFF r=omarg\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320505\n", "files": ["browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.css", "browser/components/aiwindow/ui/components/ai-sff-tab-selector/ai-sff-tab-selector.mjs", "toolkit/content/widgets/moz-box-item/moz-box-item.css"], "git_node": "7e78040d3ddbb9e40f209dc51ed754d058c4b1be", "git_parents": ["86c31c8702593159e96546be8c4c759d790a41d8"], "node": "1e769cf90c81f28542138dc55a0735c4ff63da32", "parents": ["2cae0494cd0e3c9c2fe34deda148554473016626"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068478 - The change event for \u003cinput type=color\u003e should bubble; r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322850\n", "files": ["testing/web-platform/mozilla/tests/html/semantics/forms/the-input-element/color-picker-value.html", "toolkit/actors/ColorPickerChild.sys.mjs"], "git_node": "d5872dbc87ccf5b7fc8e1bd53af5b5b90cc28d3c", "git_parents": ["7e78040d3ddbb9e40f209dc51ed754d058c4b1be"], "node": "099610c02de2cd7c0d864d56286a45ed9612d6fc", "parents": ["1e769cf90c81f28542138dc55a0735c4ff63da32"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067261 - [UI] Anchor the PDF signature dialog to the bottom in tablet mode r=android-reviewers,pollymce\n\nThis patch changes `PdfToolsBehavior` to `PdfOverlayBehavior` to better distinguish the `Tools` (Sign, Download, Print, etc.)\ntoolbar from the `Signature` overlay.\n\nA part of this division is to better organize creation of the overlays in `PdfToolsIntegration`.\n\nFrom there, a change in `signatureDialogBehavior` ensures that the `Signature` aligns to the bottom.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322369\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfOverlayBehavior.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsBehavior.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/ui/PdfOverlayContent.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfOverlayBehaviorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsBehaviorTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsContentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt"], "git_node": "46d69f7b755d1ee5559fd530352d02ed91ae6afb", "git_parents": ["d5872dbc87ccf5b7fc8e1bd53af5b5b90cc28d3c"], "node": "c399418fc09a985a2772b1dd78021c60ab62b757", "parents": ["099610c02de2cd7c0d864d56286a45ed9612d6fc"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2066776 - Check the URL base in IsPDFJS r=calixte,dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321554\n", "files": ["dom/base/nsContentUtils.cpp", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_brotli_large_window.js", "toolkit/components/pdfjs/test/file_pdfjs_brotli_large_window.pdf"], "git_node": "33a0c0be84faefb88ed6acb10761919e76fb149c", "git_parents": ["46d69f7b755d1ee5559fd530352d02ed91ae6afb"], "node": "74be006191704ea02fbe9166bad779fab577b018", "parents": ["c399418fc09a985a2772b1dd78021c60ab62b757"], "tags": []}, {"author": "Wyatt Verchere \u003cwverchere@gmail.com\u003e", "branch": "default", "desc": "Bug 2064543 - Calls ads-client shutdown to safely drop uniffi callbacks on quitting newtab. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319889\n", "files": ["browser/components/BrowserComponents.manifest", "browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AdsClient.js"], "git_node": "b87b1b42760f3870fe618e9f62f72f605b02d67d", "git_parents": ["33a0c0be84faefb88ed6acb10761919e76fb149c"], "node": "9b4f3681de9a861f9e6196edef06a22c05c9d7df", "parents": ["74be006191704ea02fbe9166bad779fab577b018"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068470 - Say what the urlbar.abandonment `tab_switch` type actually records. r=mbeier,urlbar-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322903\n", "files": ["browser/components/urlbar/metrics.yaml"], "git_node": "9f48a7c5d808d7447cbb2ecb43684a01e0e77736", "git_parents": ["b87b1b42760f3870fe618e9f62f72f605b02d67d"], "node": "4e9c6db9c34a4e3548942d3354aa1da9f1f04fb5", "parents": ["9b4f3681de9a861f9e6196edef06a22c05c9d7df"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065813 - Fix the tabbrowser's tab-or-group annotations. r=nsharpley,tabbrowser-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320690\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/types/elements.ts"], "git_node": "d65038640bd23918eb41f68489eab8be673e8e28", "git_parents": ["9f48a7c5d808d7447cbb2ecb43684a01e0e77736"], "node": "38e9975ac08cf3f34e2ee37d020581eead23fa35", "parents": ["4e9c6db9c34a4e3548942d3354aa1da9f1f04fb5"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Convert underrun NS_WARNING to SINK_LOG in AudioSink::PopFrames. r=media-playback-reviewers,alwu\n\nIt's too spammy, and can happen if the machine is completely overloaded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315594\n", "files": ["dom/media/mediasink/AudioSink.cpp"], "git_node": "0ccb57a6b9444cdd1ef953a08b52f46a5c58a813", "git_parents": ["d65038640bd23918eb41f68489eab8be673e8e28"], "node": "0c7db85aa3ee1567fc1337d51568978136ea9300", "parents": ["38e9975ac08cf3f34e2ee37d020581eead23fa35"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Fix mCurrentPlayRangeStart sentinel default so HTMLMediaElement.played is tracked correctly. r=media-playback-reviewers,alwu\n\nThis was broken during a refactoring in 2018: https://hg-edge.mozilla.org/mozilla-central/rev/e865836987b36817a8883cfc2bab34421daf0a83.\n\nBecause we reset it to -1.0 quite often, it went unnoticed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315595\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h", "dom/media/mediaelement/HTMLVideoElement.cpp"], "git_node": "eb25a0c4d680313a5333552bb2033f968e3695fd", "git_parents": ["0ccb57a6b9444cdd1ef953a08b52f46a5c58a813"], "node": "4946060834c7ab437161a00e5e6a55f5f0be85a1", "parents": ["0c7db85aa3ee1567fc1337d51568978136ea9300"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Silence expected AbortError from removeNodeAndSource()/cleanup teardown aborting a pending play() promise in media mochitests. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315596\n", "files": ["dom/media/mediasource/test/mediasource.js", "dom/media/test/manifest.js"], "git_node": "246fe149f8d30b671fe82985ca898a068d2956ac", "git_parents": ["eb25a0c4d680313a5333552bb2033f968e3695fd"], "node": "fb02b291b9c7ea7282e19b0d493e2698d0bc821c", "parents": ["4946060834c7ab437161a00e5e6a55f5f0be85a1"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Handle rejection of the video controls widget's fire-and-forget play() calls. r=kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315597\n", "files": ["toolkit/content/widgets/videocontrols.js"], "git_node": "de9ce9591996e06205a030b556d1710306b59121", "git_parents": ["246fe149f8d30b671fe82985ca898a068d2956ac"], "node": "45ec4c99cbbbb966a1e7485b06420912c26c3c43", "parents": ["fb02b291b9c7ea7282e19b0d493e2698d0bc821c"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Handle rejection of fire-and-forget play() calls in WebRTC mochitest helpers. r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315598\n", "files": ["dom/media/webrtc/tests/mochitests/blacksilence.js", "dom/media/webrtc/tests/mochitests/mediaStreamPlayback.js", "dom/media/webrtc/tests/mochitests/pc.js"], "git_node": "4691cfeac0adbd80a60c1fb7c3ce32e2443036c8", "git_parents": ["de9ce9591996e06205a030b556d1710306b59121"], "node": "9da69f4233e5cd1967ce4dcad0ab82bf5e7bbe9f", "parents": ["45ec4c99cbbbb966a1e7485b06420912c26c3c43"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Handle promise rejection from repeated OfflineAudioContext.startRendering() calls in fuzzer crashtest. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315599\n", "files": ["dom/media/webaudio/test/test_bug875221.html"], "git_node": "a3537b631ee97015487603f631386ecf6166b43f", "git_parents": ["4691cfeac0adbd80a60c1fb7c3ce32e2443036c8"], "node": "f75aa8f2b517f3c3aeabf854a575ac30b52fc329", "parents": ["9da69f4233e5cd1967ce4dcad0ab82bf5e7bbe9f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Downgrade expected single-page Opus end-trimming NS_WARNING to a debug LOG in OggCodecState. r=media-playback-reviewers,alwu\n\nA stream whose only page is also its last page (e.g. short test fixtures)\nhas no previous granule position to trim against; this is a normal,\nexpected case, not a real warning.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315600\n", "files": ["dom/media/ogg/OggCodecState.cpp"], "git_node": "fc6135636947cc3320093db4c2b90dfa1fa1809c", "git_parents": ["a3537b631ee97015487603f631386ecf6166b43f"], "node": "d83f70c7d14752d9daca562f41a43a2d874ce00e", "parents": ["f75aa8f2b517f3c3aeabf854a575ac30b52fc329"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Downgrade expected missing-compositor NS_WARN_IF to a debug LOG in MediaCapabilities::GetCompositor. r=media-playback-reviewers,alwu\n\nThe compositor bridge may not be established yet for a not-yet-painted\ntab, which is normal and not worth warning about; MediaDecoder.cpp\nalready treats the same null-compositor case as expected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315601\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp"], "git_node": "8700f9ab0432e97d4b6ae757df9eb919a1743d45", "git_parents": ["fc6135636947cc3320093db4c2b90dfa1fa1809c"], "node": "37c23537e66ffbf82a8ad05977b4f6a7a169d4a4", "parents": ["d83f70c7d14752d9daca562f41a43a2d874ce00e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2058923 - Don't warn when GMP storage directory doesn't exist during ClearStorage. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315602\n", "files": ["dom/media/gmp/GMPServiceParent.cpp"], "git_node": "61aba094fe8fe0f76c5620627ae4d700dd900c92", "git_parents": ["8700f9ab0432e97d4b6ae757df9eb919a1743d45"], "node": "38ed9ea6628f4bdd7c16ef4f9a8310a721029d30", "parents": ["37c23537e66ffbf82a8ad05977b4f6a7a169d4a4"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2013052 - Part 3: Add a Merino content recommendations provider r=android-reviewers,skhan\n\n- Add a ContentRecommendationsProvider implementation backed by the Application Services CuratedRecommendationsClient.\n- Refactor ContentRecommendationsRequestConfig to accept a Locale and the user agent that the client requires.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322155\n", "files": ["mobile/android/android-components/components/service/pocket/build.gradle", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/PocketStoriesConfig.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/ext/Mappers.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationEndpointRaw.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/recommendations/api/MerinoContentRecommendationsProvider.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/PocketStoriesConfigTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/ext/MappersKtTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/helpers/PocketTestResources.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/api/ContentRecommendationsEndpointRawTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/api/MerinoContentRecommendationsProviderTest.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/recommendations/fake/FakeCuratedRecommendationsClient.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt"], "git_node": "6be2a33c0d02da1b7c05a363d2613cdb0132324d", "git_parents": ["61aba094fe8fe0f76c5620627ae4d700dd900c92"], "node": "016340e4a6caca43914d3b24d82a0766c6936207", "parents": ["38ed9ea6628f4bdd7c16ef4f9a8310a721029d30"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1955841 - Fix A/V drift when repeatedly switching playback rates. r=pehrsons\n\nRepeated 2x-\u003e1x-\u003e2x transitions caused cumulative A/V drift because source\nframes fed to SoundTouch during pipeline startup were silently discarded when\nthe stretcher was retired, advancing the source position without producing\ncorresponding output.\n\nThree changes:\n- Pre-prime the SoundTouch pipeline with silence on creation ((sequence_ms +\n  seekwindow_ms) of input) so the first audio callback never needs more than\n  one putSamples iteration to fill the seek window. This eliminates the\n  per-switch source over-consumption from startup latency.\n- Call flush() in UpdatePlaybackRateIfNeeded when transitioning back to 1x, so\n  any remaining unprocessed input is turned into output rather than discarded\n  when the pipeline drains.\n- Stop retiring the stretcher when GetUnprocessed drains its output to zero.\n  Keeping it alive means the primed internal state is reused on the next non-1x\n  phase and startup latency is never paid more than once.\n\nWithout fix: 1126 frames (~25ms) of source over-consumption per rate switch,\namounting to 511ms of drift after 20 switches (measured with the accompanying\ngtest). With fix: drift is bounded by algorithm rounding, less than 256 frames\nacross any number of switches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294413\n", "files": ["dom/media/AudioStream.cpp"], "git_node": "25937df55ca77fa0f41fc4b98380043ce29108fe", "git_parents": ["6be2a33c0d02da1b7c05a363d2613cdb0132324d"], "node": "c6e83123cf8ede21cb54029b5a87853882e2bad9", "parents": ["016340e4a6caca43914d3b24d82a0766c6936207"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1955841 - Add gtest for A/V drift regression. r=pehrsons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294414\n", "files": ["dom/media/gtest/TestAudioStream.cpp", "dom/media/gtest/moz.build"], "git_node": "060aca74c0d600903de45f1083def1a43aaf5aea", "git_parents": ["25937df55ca77fa0f41fc4b98380043ce29108fe"], "node": "c60e168027dbc67891a88b44fbb7a871300d2ee3", "parents": ["c6e83123cf8ede21cb54029b5a87853882e2bad9"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067221 - Fix GetScrollOffsetFor() when anchor and positioned element are in different abspos CB continuations. r=layout-reviewers,dshin\n\nThis patch teaches `GetScrollOffsetFor()` the concept of IB-split.\n\nBug 2066154 is required to pass `anchor-scroll-009.html`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322478\n", "files": ["layout/base/AnchorPositioningUtils.cpp", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-008.html", "testing/web-platform/tests/css/css-anchor-position/anchor-scroll-009.html"], "git_node": "3007eeda7cfc4555a15458aa03cc8f0036e95d7b", "git_parents": ["060aca74c0d600903de45f1083def1a43aaf5aea"], "node": "b40cf0a2676583543306eb451e99e6b85db9f8f7", "parents": ["c60e168027dbc67891a88b44fbb7a871300d2ee3"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061291 - Avoid reading from a finalized instance when a trap unwinds to a ContBaseFrame. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320287\n", "files": ["js/src/jit-test/tests/wasm/stack-switching/bug2061291.js", "js/src/wasm/WasmFrameIter.cpp"], "git_node": "bc2e2c3e467c2b098467b1cc10c6aab882612099", "git_parents": ["3007eeda7cfc4555a15458aa03cc8f0036e95d7b"], "node": "d5d543ebce1520e0cddc85024899418b06dcf401", "parents": ["b40cf0a2676583543306eb451e99e6b85db9f8f7"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068331 - Forward constructor arguments in nsIFrame's frame property helpers. r=layout-reviewers,emilio\n\n`nsIFrame::GetOrCreateReleasableProperty()` and\n`nsIFrame::SetOrUpdateDeletableProperty()` take the arguments as a\nforwarding reference pack, but passed them to `DataType` constructor\nas lvalues, so a caller could never move values.\n\nNo current caller passes an rvalue, so this patch does not change\nbehavior, but can prevent future footgun.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322813\n", "files": ["layout/generic/nsIFrame.h"], "git_node": "a4e3c0e0ceb5cb7d26b701a4d0b283f07ee5c2ba", "git_parents": ["bc2e2c3e467c2b098467b1cc10c6aab882612099"], "node": "5e77313f741c7442dcfdc80fca2f313dd16589cc", "parents": ["d5d543ebce1520e0cddc85024899418b06dcf401"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068331 - Use nsIFrame::SetOrUpdateDeletableProperty() to simplify frame property updates. r=layout-reviewers,dshin\n\nThis patch simplifies the code, and does not change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322814\n", "files": ["layout/generic/ReflowInput.cpp", "layout/generic/StickyScrollContainer.cpp", "layout/generic/nsIFrame.cpp"], "git_node": "b94682c4a1fc97d07212f419bfdefa410bd5d180", "git_parents": ["a4e3c0e0ceb5cb7d26b701a4d0b283f07ee5c2ba"], "node": "131e7fa162bde99864dd198b391aa6bcc7230bf9", "parents": ["5e77313f741c7442dcfdc80fca2f313dd16589cc"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066014 - [devtools] Do not show inspector's AppErrorBoundary if rootNodeFront was destroyed r=ochameau,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322636\n", "files": ["devtools/client/inspector/inspector.js"], "git_node": "fb2fa0e69671e4c02c9a6024191a4f0fd3e93485", "git_parents": ["b94682c4a1fc97d07212f419bfdefa410bd5d180"], "node": "6389b44ff497a765a79c09b334068d0af0a394a2", "parents": ["131e7fa162bde99864dd198b391aa6bcc7230bf9"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066014 - [devtools] Delay final inspector setup until first root node is ready r=devtools-reviewers,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320854\n", "files": ["devtools/client/inspector/inspector.js"], "git_node": "074de696c2cc6226dc3ff7dd2f24b4e26b4293ff", "git_parents": ["fb2fa0e69671e4c02c9a6024191a4f0fd3e93485"], "node": "3b56c7b85cf1725d4c30104ed82d72e4f5275eee", "parents": ["6389b44ff497a765a79c09b334068d0af0a394a2"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066014 - [devtools] Bail in inspector onRootNodeAvailable if the target changed during mid-flight r=ochameau,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322637\n", "files": ["devtools/client/inspector/inspector.js"], "git_node": "b7777d4bc594b5c924fa34f1d7d0f7f01fbfe890", "git_parents": ["074de696c2cc6226dc3ff7dd2f24b4e26b4293ff"], "node": "9856faa787e27ac6805620c5392cf864466d5b56", "parents": ["3b56c7b85cf1725d4c30104ed82d72e4f5275eee"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050444 - Change sidebar width to 50x wide when vertical tabs are enabled in compact and standard UI densities to make room for scrollbar r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,dao\" for causing bc failures @browser_uidensity_auto_compact.js.\n\nThis reverts commit 5e2141707d45273bbff77d583f59f6b5158857df.\n", "files": ["browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "cd13ce492d5870ae1f5f0a0fd3c2511a37e91d59", "git_parents": ["b7777d4bc594b5c924fa34f1d7d0f7f01fbfe890"], "node": "92a326ca94ed137cc31e1597dfcc3007ece82e9f", "parents": ["9856faa787e27ac6805620c5392cf864466d5b56"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2049215: apply code formatting via Lando\" for causing webr