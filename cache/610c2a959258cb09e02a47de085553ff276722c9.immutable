istentopage/src/test/java/mozilla/components/feature/listentopage/ListenStoreTest.kt"], "git_node": "db9b08c46489de588a5d18adab3ad560aedcb88f", "git_parents": ["c63d13a432e73fa2cc8737c97fa0c1e1ca3ddd5c"], "node": "d96d2f493b7cbd75cc9ea0f0930a42f1322c9117", "parents": ["5d48d2b306fc1afa19bbb6e8daf22ccb73626eef"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067197 - Move pref one directory up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321944\n", "files": ["testing/web-platform/meta/html/rendering/__dir__.ini", "testing/web-platform/meta/html/rendering/widgets/__dir__.ini"], "git_node": "e3dd76f663c7ec911cec1d92b275588b20453e5b", "git_parents": ["db9b08c46489de588a5d18adab3ad560aedcb88f"], "node": "a0e29d83d845871a248b0e220dcf3cc8f21a3659", "parents": ["d96d2f493b7cbd75cc9ea0f0930a42f1322c9117"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066204: Allow label segments to start with digits. r=rhunt\n\nThis was an oversight in our earlier implementation; only the first\nsegment in a label is required to start with a letter.\n\nAlso pulls names out into their own, more concise test file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321111\n", "files": ["js/src/jit-test/tests/wasm/components/names.js", "js/src/jit-test/tests/wasm/components/types.js", "js/src/wasm/WasmValidate.cpp"], "git_node": "dc4521cec81021b0574c4422a9545f51213420d4", "git_parents": ["e3dd76f663c7ec911cec1d92b275588b20453e5b"], "node": "0288ce314584abfd24beb03e9af58dcd6e21ffd6", "parents": ["a0e29d83d845871a248b0e220dcf3cc8f21a3659"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066204: Parse [get] and [set] names. r=rhunt\n\nAdds support for [get] and [set] to the component name parser, and\nupdates the strongly-unique logic to match.\n\nWe were able to delete StronglyUniqueNameHasher, so that's nice! (Although\nit comes at the cost of allocating strings for canonicalized names, I\nguess, which is mildly sad but absolutely not worth worrying about,\nespecially when we don't store the strings after validation.)\n\nName attributes can now be read out of imports and exports, which should\nbe useful for validation and instantiation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321112\n", "files": ["js/src/jit-test/tests/wasm/components/names.js", "js/src/jit-test/tests/wasm/components/strongly-unique.js", "js/src/wasm/WasmComponent.cpp", "js/src/wasm/WasmComponent.h", "js/src/wasm/WasmValidate.cpp"], "git_node": "e1c78c58e3bfda67c0a09448511def7164241fa9", "git_parents": ["dc4521cec81021b0574c4422a9545f51213420d4"], "node": "31d176aa647f8fcde89611bd0bde52ac50d791e0", "parents": ["0288ce314584abfd24beb03e9af58dcd6e21ffd6"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2047723 - Test SoundTouch destination limit through AudioDecoderInputTrack. r=media-playback-reviewers,alwu\n\nReplace the unstable browser crashtest with an AudioDecoderInputTrack gtest that observes the queued SoundTouch output after a large rate transpose. The test fails when the MAX_DEST_LIMIT clamp is absent and passes with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309931\n", "files": ["dom/media/gtest/TestAudioDecoderInputTrack.cpp", "dom/media/gtest/moz.build", "dom/media/mediasink/AudioDecoderInputTrack.h"], "git_node": "6faa69694a19bef502df4459cab633af0fa426c8", "git_parents": ["e1c78c58e3bfda67c0a09448511def7164241fa9"], "node": "f62d57fc813b71b456f283f5b8b7b2d5d057e001", "parents": ["31d176aa647f8fcde89611bd0bde52ac50d791e0"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056890 - Fix broken inter-doc links from bug 2038819 r=firefox-source-docs-reviewers,releng-reviewers,layout-reviewers,dshin,bhearsum,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321900\n", "files": ["devtools/docs/user/page_inspector/how_to/examine_and_edit_css/index.md", "devtools/docs/user/tips/index.md", "devtools/docs/user/web_console/helpers/index.md", "docs/bug-mgmt/guides/bug-types.md", "docs/bug-mgmt/policies/triage-bugzilla.md", "docs/bug-mgmt/processes/fixing-security-bugs.md", "docs/bug-mgmt/processes/labels.md", "docs/bug-mgmt/processes/security-approval.md", "docs/code-quality/coding-style/coding_style_cpp.md", "docs/code-quality/index.md", "docs/config.yml", "docs/contributing/contribution_quickref.md", "docs/contributing/editors/others.md", "docs/crash-reporting/index.md", "docs/crash-reporting/searching_crash_reports.md", "docs/nspr/nspr_contributor_guide.md", "docs/nspr/reference/index.md", "docs/setup/building_with_debug_symbols.md", "docs/setup/configuring_build_options.md", "docs/setup/linux_32bit_build_on_64bit_OS.md", "docs/setup/linux_build.md", "docs/setup/macos_build.md", "docs/setup/windows_build.md", "docs/setup/windows_wsl_build.md", "dom/docs/navigation/nav_replace.md", "layout/docs/Reftest.md", "taskcluster/docs/release-promotion-action.md", "toolkit/components/crashes/docs/index.md", "toolkit/components/messaging-system/schemas/index.md", "toolkit/components/telemetry/docs/obsolete/collection/custom-pings.md", "toolkit/crashreporter/docs/index.md"], "git_node": "f408b91921cd3f14a81d0f1f748e88a060b700f3", "git_parents": ["6faa69694a19bef502df4459cab633af0fa426c8"], "node": "857bd9e2b27ab89dd56d2bca3945539cd12a7000", "parents": ["f62d57fc813b71b456f283f5b8b7b2d5d057e001"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066889 - Return a Result from CreateWebRenderCommands. r=nical,gw\n\nThis lets us make a profiler marker that contains the reason\nfor fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321685\n", "fi