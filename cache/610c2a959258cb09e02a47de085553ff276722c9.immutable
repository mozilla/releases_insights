34fb6c99735a329c096abebf81"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049439 - Part 2: Fix token structure issues r=hjones,desktop-theme-reviewers,fchasen\n\n- Mixed units are not allowed in `calc` functions, so those have been split into multiple tokens\n- Using default light/dark instead of \"brand\" field organizes text tokens better and doesn't affect newtab's build output\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318795\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/content/widgets/moz-message-bar/moz-message-bar.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.nova.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.json", "toolkit/content/widgets/panel-list/panel-item.css", "toolkit/content/widgets/panel-list/panel-item.tokens.css", "toolkit/content/widgets/panel-list/panel-item.tokens.json", "toolkit/themes/shared/design-system/src/figma-import.mjs"], "git_node": "6df827db17956a8e29bf8c13001f6b59f11a0e95", "git_parents": ["eac67a4e67a62f901c4478d9709ed4deac962c7c"], "node": "3098ad2d47d699eec6f2d296d58217a5fc937a06", "parents": ["b003c864a27301a08a0cdc50366d56ac468c2126"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049439 - Part 3: Move Nova token definitions from figma-import.mjs into JSON files r=hjones,desktop-theme-reviewers,tabbrowser-reviewers,urlbar-reviewers,jswinarton,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318796\n", "files": ["browser/themes/addons/moz.build", "browser/themes/addons/process_tokens.py", "browser/themes/shared/tabbrowser/tab.nova.tokens.json", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/urlbar/urlbar.nova.tokens.json", "browser/themes/shared/urlbar/urlbar.tokens.css", "browser/themes/shared/urlbar/urlbar.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.nova.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.json", "toolkit/content/widgets/moz-page-nav/moz-page-nav.nova.tokens.json", "toolkit/content/widgets/moz-page-nav/moz-page-nav.tokens.json", "toolkit/themes/shared/design-system/src/figma-import.mjs", "toolkit/themes/shared/design-system/src/tokens/base/text.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/text.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.tokens.json"], "git_node": "350eab90e66171988c4539ed6b05d2da44cf0045", "git_parents": ["6df827db17956a8e29bf8c13001f6b59f11a0e95"], "node": "94cb8f4b12a4d063e922aed9f3971739b8ebfb29", "parents": ["3098ad2d47d699eec6f2d296d58217a5fc937a06"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049439 - Part 4: Standardize Nova token overrides in JSON files r=hjones,desktop-theme-reviewers,tabbrowser-reviewers,urlbar-reviewers,jswinarton,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318797\n", "files": ["browser/themes/shared/tabbrowser/tabs-navbar.tokens.css", "browser/themes/shared/urlbar/urlbarview.tokens.css", "toolkit/content/widgets/moz-badge/moz-badge.tokens.json", "toolkit/content/widgets/moz-select/moz-select.tokens.css", "toolkit/content/widgets/moz-select/moz-select.tokens.json", "toolkit/content/widgets/panel-list/panel-item.tokens.json", "toolkit/content/widgets/panel-list/panel-list.tokens.css", "toolkit/content/widgets/panel-list/panel-list.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-brand.css", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/base/font.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/info-bar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/input.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/link.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json"], "git_node": "001fef9084d21d75d138adfb21336606d52cd7bb", "git_parents": ["350eab90e66171988c4539ed6b05d2da44cf0045"], "node": "cbab391d1c32ff681bb339647150344999413811", "parents": ["94cb8f4b12a4d063e922aed9f3971739b8ebfb29"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046189 - Prevent Figma import from incorrectly updating tokens r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,hjones,fchasen\n\nRather than attempting a brittle, automated approach, this uses a more explicit case-by-case mechanism for indicating when tokens should ignore the values coming from Figma.\n\nFor tokens that should use the base values, the \"ignoreFigma\" property will prevent values from Figma being written to `*.nova.tokens.json` files. Tokens with \"nova\" overrides in base `*.tokens.json` files will also ignore values from Figma, and I've added comments for each explaining why they are ignored or added where they are (some just don't exist in Figma yet).\n\nWhen running `mach buildtokens`, all the tokens that are being ignored get printed to the console, so we can use that information to fix/add tokens in Figma to reduce the number of tokens that ignore Figma.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313896\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/urlbar/urlbar.tokens.json", "toolkit/content/widgets/moz-badge/moz-badge.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.nova.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.json", "toolkit/content/widgets/moz-page-nav/moz-page-nav.tokens.json", "toolkit/content/widgets/moz-promo/moz-promo.nova.tokens.json", "toolkit/content/widgets/moz-promo/moz-promo.tokens.css", "toolkit/content/widgets/moz-promo/moz-promo.tokens.json", "toolkit/content/widgets/panel-list/panel-item.tokens.json", "toolkit/content/widgets/panel-list/panel-list.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/src/figma-import.mjs", "toolkit/themes/shared/design-system/src/tokens/base/focus.tokens.json", "toolkit/themes/shared/design-system/src/tokens/base/text.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/info-bar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/panel.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbarbutton.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbox.tokens.json"], "git_node": "f14605a7757a8798fee8bdf3354d0cb06bbd8b3d", "git_parents": ["001fef9084d21d75d138adfb21336606d52cd7bb"], "node": "ac53b578831fc9cfaac577d981319cdb6e3e86c7", "parents": ["cbab391d1c32ff681bb339647150344999413811"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066898 - Use undecorated names in mach jj support r=ahochheiden\n\nWithout the patch the test fails as follows:\n\n```\n 0:09.77 _____________________ test_jj_branch_diverged_bookmark[jj] _____________________\n 0:09.77 python/mozversioncontrol/test/test_branch.py:73: in test_jj_branch_diverged_bookmark\n 0:09.77     assert vcs.branch == \"master\"\n 0:09.77 E   AssertionError: assert 'master*' == 'master'\n 0:09.77 E\n 0:09.77 E     - master\n 0:09.77 E     + master*\n 0:09.77 E     ?       +\n 0:09.77 ---------------------------- Captured stdout setup ---\n ```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321694\n", "files": ["python/mozversioncontrol/mozversioncontrol/repo/jj.py", "python/mozversioncontrol/test/test_branch.py"], "git_node": "486255f64466e0cd9259ba0df5ce7c80dbdc18cc", "git_parents": ["f14605a7757a8798fee8bdf3354d0cb06bbd8b3d"], "node": "d9f6362b1d87772abb606cb677bb4736f28f04cc", "parents": ["ac53b578831fc9cfaac577d981319cdb6e3e86c7"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Split CompileForESM into three parts; r=rhunt\n\nTo support off-main thread compilation, we want a version of\nCompileForESM that doesn't require a JSContext. This splits the\ncurrent function into three parts, one that creates the CompileArgs,\none for compilation, and a third to handle the compilation results,\ncreating a WebAssembly.Module instance suitable for use as an ESM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318573\n", "files": ["js/src/vm/Modules.cpp", "js/src/wasm/WasmJS.cpp", "js/src/wasm/WasmJS.h", "js/src/wasm/WasmModule.h", "js/src/wasm/WasmTypeDecls.h"], "git_node": "c60b701453705ddb47760691f2b9594356e976b1", "git_parents": ["486255f64466e0cd9259ba0df5ce7c80dbdc18cc"], "node": "2f13c55d65525cc073d357387d537ea131db740f", "parents": ["d9f6362b1d87772abb606cb677bb4736f28f04cc"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Move Wasm ESM functions to public api; r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318574\n", "files": ["js/public/Modules.h", "js/public/WasmModule.h", "js/src/vm/Modules.cpp", "js/src/wasm/WasmCompileArgs.h", "js/src/wasm/WasmJS.cpp", "js/src/wasm/WasmJS.h", "js/src/wasm/WasmSerialize.cpp"], "git_node": "93e91cc670d797e3d48cfcf9d7ae019a566cfaf3", "git_parents": ["c60b701453705ddb47760691f2b9594356e976b1"], "node": "f316e4059bb7e3bcdd4d7085bd85ab17e567a42e", "parents": ["2f13c55d65525cc073d357387d537ea131db740f"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Add OffThreadCompileTask; r=arai\n\nThis splits the existing CompileOrDecodeTask into two parts,\none of which handles cancellation, and the other compiling\nor decoding to a Stencil. The new base class will be used in\nthe next patch for CompileWasmTask.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318575\n", "files": ["dom/script/ScriptLoadContext.cpp", "dom/script/ScriptLoadContext.h", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "8d75dcf8b8bdea414f794f1c0edcc842d20efbdf", "git_parents": ["93e91cc670d797e3d48cfcf9d7ae019a566cfaf3"], "node": "8128fd96325be58a4822b9bcf63487fb096a265d", "parents": ["f316e4059bb7e3bcdd4d7085bd85ab17e567a42e"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Define WasmCompileTask; r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318576\n", "files": ["dom/script/ScriptLoadContext.h", "dom/script/ScriptLoader.cpp"], "git_node": "8f07d10a2aecf01ab187290b656edc2df23066db", "git_parents": ["8d75dcf8b8bdea414f794f1c0edcc842d20efbdf"], "node": "805489b8c6b7d81ad2ef7d349cd58910d1391efe", "parents": ["8128fd96325be58a4822b9bcf63487fb096a265d"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Add ModuleLoadRequest::IsSourcePhaseRequest; r=arai,dom-worker-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319469\n", "files": ["dom/script/ModuleLoader.cpp", "dom/workers/loader/WorkerModuleLoader.cpp", "dom/worklet/loader/WorkletModuleLoader.cpp", "js/loader/ModuleLoadRequest.cpp", "js/loader/ModuleLoadRequest.h"], "git_node": "1a72f04f5cdf014299aa8573699e3d4387e81bf1", "git_parents": ["8f07d10a2aecf01ab187290b656edc2df23066db"], "node": "b834e5fdec8bfd0cdc36c1151c76a58bd57975a9", "parents": ["805489b8c6b7d81ad2ef7d349cd58910d1391efe"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007696 - Use WasmCompileTask for source phase modules; r=arai,frontend-codestyle-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318577\n", "files": ["dom/base/test/file_wasm_offthread_module.sjs", "dom/base/test/mochitest.toml", "dom/base/test/test_wasm_offthread_compile.html", "dom/script/ModuleLoader.cpp", "dom/script/ScriptLoadContext.cpp", "dom/script/ScriptLoadContext.h", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "eslint-ignores.config.mjs"], "git_node": "012bce19000eb49a9db72dbf150ef088c46e7d76", "git_parents": ["1a72f04f5cdf014299aa8573699e3d4387e81bf1"], "node": "7c86c001aca574c29b0db3f28845b1b77c833f8b", "parents": ["b834e5fdec8bfd0cdc36c1151c76a58bd57975a9"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2007696: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/loader/ModuleLoadRequest.cpp", "js/public/WasmModule.h", "js/src/wasm/WasmJS.cpp"], "git_node": "e83a86a4244f662868a7b565c27e002d015e11ed", "git_parents": ["012bce19000eb49a9db72dbf150ef088c46e7d76"], "node": "0420dba1d55eb5c3fffcb0e4b92fcde4161fad2e", "parents": ["7c86c001aca574c29b0db3f28845b1b77c833f8b"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046189, Bug 2049439 - Prevent Figma import from incorrectly updating tokens r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,hjones,fchasen\" for causing node failures\n\nThis reverts commit f14605a7757a8798fee8bdf3354d0cb06bbd8b3d.\n\nRevert \"Bug 2049439 - Part 4: Standardize Nova token overrides in JSON files r=hjones,desktop-theme-reviewers,tabbrowser-reviewers,urlbar-reviewers,jswinarton,adw\"\n\nThis reverts commit 001fef9084d21d75d138adfb21336606d52cd7bb.\n\nRevert \"Bug 2049439 - Part 3: Move Nova token definitions from figma-import.mjs into JSON files r=hjones,desktop-theme-reviewers,tabbrowser-reviewers,urlbar-reviewers,jswinarton,adw\"\n\nThis reverts commit 350eab90e66171988c4539ed6b05d2da44cf0045.\n\nRevert \"Bug 2049439 - Part 2: Fix token structure issues r=hjones,desktop-theme-reviewers,fchasen\"\n\nThis reverts commit 6df827db17956a8e29bf8c13001f6b59f11a0e95.\n\nRevert \"Bug 2049439 - Part 1: Refactor tokens-config for maintainability r=desktop-theme-reviewers,hjones,fchasen\"\n\nThis reverts commit eac67a4e67a62f901c4478d9709ed4deac962c7c.\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/addons/moz.build", "browser/themes/addons/process_tokens.py", "browser/themes/shared/tabbrowser/tab.nova.tokens.json", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/tabbrowser/tab.tokens.json", "browser/themes/shared/tabbrowser/tabs-navbar.tokens.css", "browser/themes/shared/urlbar/urlbar.nova.tokens.json", "browser/themes/shared/urlbar/urlbar.tokens.css", "browser/themes/shared/urlbar/urlbar.tokens.json", "browser/themes/shared/urlbar/urlbarview.tokens.css", "toolkit/content/widgets/moz-badge/moz-badge.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.nova.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.json", "toolkit/content/widgets/moz-page-nav/moz-page-nav.nova.tokens.json", "toolkit/content/widgets/moz-page-nav/moz-page-nav.tokens.json", "toolkit/content/widgets/moz-promo/moz-promo.nova.tokens.json", "toolkit/content/widgets/moz-promo/moz-promo.tokens.css", "toolkit/content/widgets/moz-promo/moz-promo.tokens.json", "toolkit/content/widgets/moz-select/moz-select.tokens.css", "toolkit/content/widgets/moz-select/moz-select.tokens.json", "toolkit/content/widgets/panel-list/panel-item.css", "toolkit/content/widgets/panel-list/panel-item.tokens.css", "toolkit/content/widgets/panel-list/panel-item.tokens.json", "toolkit/content/widgets/panel-list/panel-list.tokens.css", "toolkit/content/widgets/panel-list/panel-list.tokens.json", "toolkit/themes/shared/design-system/config/figma-tokens-config.js", "toolkit/themes/shared/design-system/config/helpers/desktop-format/create-desktop-format.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/format-token.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-browser-theme-value.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-layer-string.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-token-css.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-token-sections.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/get-tokens-by-layer.mjs", "toolkit/themes/shared/design-system/config/helpers/desktop-format/group-and-sort-token