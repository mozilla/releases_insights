ow/ui/test/browser/browser_chat_assistant_citations.js"], "git_node": "9aeddfeb94392866469ffdc4ef54dc5241f67dee", "git_parents": ["52abe248ae83c3ef1fa22128aed8b9f18dffb400"], "node": "291a852aeb58cb0b7f87153cbfc0e342475cdc85", "parents": ["43e6ed09e1841c2925a92909a18493d3dc2f2836"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067590 - Set the max dirty page modifier once per process priority. r=smaug\" for causing Bug 2068860\n\nThis reverts commit 08f4f4f8df86cab5c2b4503ff457ff588f081196.\n", "files": ["dom/ipc/ContentChild.cpp"], "git_node": "a76508abf122a97082a9803d71f8fbec1f37b71f", "git_parents": ["9aeddfeb94392866469ffdc4ef54dc5241f67dee"], "node": "444681a41e853df1660af72f43ed539155dae510", "parents": ["291a852aeb58cb0b7f87153cbfc0e342475cdc85"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061458 - Record browser_action_complete on the tab confirmation path r=ngrato,ai-security-reviewers,mshillabeer\n\nComplete was never recorded for an action with user confirmation. Stash the telemetry context when the flow is deferred and pass it to handler that resolves the confirmation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320039\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/ManageTabs.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/head.js", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/modules/ToolUITelemetry.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_uitool_telemetry.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolUI.js"], "git_node": "8765832a3194864a5e452eba54e2404a5f958252", "git_parents": ["a76508abf122a97082a9803d71f8fbec1f37b71f"], "node": "8ed26c1f83c1798928164842f210df27c663b9c2", "parents": ["444681a41e853df1660af72f43ed539155dae510"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061465 - Record the browser action on submit and complete r=yjamora,ai-security-reviewers,mshillabeer\n\nAdd `action` for the browser action, rather than overloading `action_type` which carries the trigger on these events, and add `trigger` for how the request was made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320040\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/modules/ToolUI.sys.mjs", "browser/components/aiwindow/ui/modules/ToolUITelemetry.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_manage_tabs_tool.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_uitool_telemetry.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolUI.js"], "git_node": "162466af90d8f9b48283f35d52fa246699a2f417", "git_parents": ["8765832a3194864a5e452eba54e2404a5f958252"], "node": "46bbb831ddfd09bbca06ec7bc820f0dbd1dce626", "parents": ["8ed26c1f83c1798928164842f210df27c663b9c2"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2069594. Give nsRect the default copy constructor so the compiler knows it is trivially copyable. r=layout-reviewers,emilio\n\nOn some ABIs this means that it can be passed and returned in a register instead of in memory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323836\n", "files": ["gfx/src/nsRect.h", "widget/WidgetUtils.h"], "git_node": "66b9023deadcb587d03c18f188e6900a75e00ffe", "git_parents": ["162466af90d8f9b48283f35d52fa246699a2f417"], "node": "bed1786516e2bd31c71f49e3eb9719e4eaf8779b", "parents": ["46bbb831ddfd09bbca06ec7bc820f0dbd1dce626"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2069601. Don't build a temporary set and call memcmp in nsCSSPropertyIDSet::IsSubsetOf. r=layout-reviewers,jfkthame\n\nIsSubsetOf was Intersect(aOther).Equals(*this), and Equals ends up as a memcmp\nof the 56 byte property array. clang won't expand a memcmp that big inline, so\nit was a real call, and passing an address to it forced the temporary that\nIntersect returns onto the stack.\n\nTesting the bits directly has neither the call nor the temporary and it\nmatches the shape of Intersects() just above it.\n\nThis was about 1% of the time under Paint in a Speedometer 3 profile of the\ncomplex-dom subtests. EffectSet::GetForFrame and\nActiveLayerTracker::IsStyleAnimated call it for every frame while building the\ndisplay list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323837\n", "files": ["layout/style/nsCSSPropertyIDSet.h"], "git_node": "52c15a7979c2ecab264dcd261aed00da5e9c2b1e", "git_parents": ["66b9023deadcb587d03c18f188e6900a75e00ffe"], "node": "854f309f66a58f2a5ec38d031052f8ec37bca690", "parents": ["bed1786516e2bd31c71f49e3eb9719e4eaf8779b"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "5e592f02e5fce65f0f87765022a8153599830d1b", "git_parents": ["52c15a7979c2ecab264dcd261aed00da5e9c2b1e", "ae0bb53a873d228e4e61b796e184dc3c687ff82e"], "node": "6c66eeb52599794a2311dd6c78005aa7e12e9275", "parents": ["854f309f66a58f2a5ec38d031052f8ec37bca690", "8c5c7633817c44deafcbbc251fff7f8399edd2fc"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2057579 - Complete the CSSSkew implementation; r=emilio,firefox-style-system-reviewers\n\nComplete the remaining `CSSSkew` functionality by implementing the missing\nattribute setters and `ToMatrix()`, adding constructor and setter argument\nvalidation, and enabling the corresponding WPT coverage.\n\nExtend `DOMMatrix` with an internal `SkewSelf()` helper used to apply the\ncombined two-axis skew required by CSS Typed OM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314879\n", "files": ["dom/base/DOMMatrix.cpp", "dom/base/DOMMatrix.h", "layout/style/typedom/CSSNumericValue.cpp", "layout/style/typedom/CSSNumericValue.h", "layout/style/typedom/CSSSkew.cpp", "layout/style/typedom/CSSSkew.h", "layout/style/typedom/CSSTransformComponent.cpp", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssSkew.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-toMatrix.html.ini"], "git_node": "cb4ffbfbe3e029b4705476cad2d5cb944139305c", "git_parents": ["5e592f02e5fce65f0f87765022a8153599830d1b"], "node": "41332677e45fcddaedeebf17ef6420cf2a04a3d3", "parents": ["6c66eeb52599794a2311dd6c78005aa7e12e9275"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2057579 - Complete the CSSSkewX implementation; r=emilio,firefox-style-system-reviewers\n\nComplete the remaining `CSSSkewX` functionality by implementing the missing\nattribute setter and `ToMatrix()`, adding constructor and setter argument\nvalidation, and enabling the corresponding WPT coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314896\n", "files": ["layout/style/typedom/CSSSkewX.cpp", "layout/style/typedom/CSSSkewX.h", "layout/style/typedom/CSSTransformComponent.cpp", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssSkewX.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-toMatrix.html.ini"], "git_node": "c6c0d1bc99153a4d6e3b9e136ce7554585003fd9", "git_parents": ["cb4ffbfbe3e029b4705476cad2d5cb944139305c"], "node": "a66dca17cd1a1bce15dd80da4a6b018489f81ff0", "parents": ["41332677e45fcddaedeebf17ef6420cf2a04a3d3"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2057579 - Complete the CSSSkewY implementation; r=emilio,firefox-style-system-reviewers\n\nComplete the remaining `CSSSkewY` functionality by implementing the missing\nattribute setter and `ToMatrix()`, adding constructor and setter argument\nvalidation, and enabling the corresponding WPT coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314897\n", "files": ["layout/style/typedom/CSSSkewY.cpp", "layout/style/typedom/CSSSkewY.h", "layout/style/typedom/CSSTransformComponent.cpp", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssSkewY.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-toMatrix.html.ini"], "git_node": "3d38c37633c975417279ab7f9d3362fc38000f01", "git_parents": ["c6c0d1bc99153a4d6e3b9e136ce7554585003fd9"], "node": "85a948f7f94cb51da194d710b7d4b27299670525", "parents": ["a66dca17cd1a1bce15dd80da4a6b018489f81ff0"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1997529 - Make CancelIdleCallback() O(1) by indexing idle requests by handle. r=smaug\n\ncancelIdleCallback() walked mIdleRequestCallbacks looking for a matching\nhandle, so a page with many outstanding requests is O(N^2) in the number of\ncancels. In the testcase from Bug 1997529 comment 0 (120k requests, ~60k\ncancels) that loop is 96% of a 15.5s microtask checkpoint.\n\nIndex the requests by handle alongside the list, following Timeout and\nTimeoutManager::Timeouts. The map is maintained by\nIdleRequest::RemoveFromList() rather than by each call site, because\nIdleRequest::Unlink() takes itself out of the list directly without going\nthrough RemoveIdleCallback(); a map updated only there would keep a dangling\nentry. Inheriting from LinkedListElement protected, as Timeout does, makes the\nbase remove() and removeFrom() inaccessible to callers, so every removal has to\ngo through RemoveFromList().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323469\n", "files": ["dom/base/IdleRequest.cpp", "dom/base/IdleRequest.h", "dom/base/nsGlobalWindowInner.cpp", "dom/base/nsGlobalWindowInner.h"], "git_node": "869fc80031f8c307192a3af5c00e8a66b5704425", "git_parents": ["3d38c37633c975417279ab7f9d3362fc38000f01"], "node": "800744a3a883155634e5c22c5d547062da0b25ee", "parents": ["85a948f7f94cb51da194d710b7d4b27299670525"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2066786 - Update reviewer checklist to reference Fenix instead of Fennec. r=android-reviewers,sfamisa DONTBUILD\n\nThe checklist carried nine bracketed \"[Fennec: ...]\" asides dating from the\npre-GeckoView Android browser. Several referenced APIs that no longer exist\nanywhere in the tree, pointing reviewers at code they cannot find.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321539\n", "files": ["docs/contributing/reviewer_checklist.md"], "git_node": "62371420568d2486a3627ea8ab5e5f6f721cb568", "git_parents": ["869fc80031f8c307192a3af5c00e8a66b5704425"], "node": "576374238d785e4f37b01dc3f65c5335fe67a134", "parents": ["800744a3a883155634e5c22c5d547062da0b25ee"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069673 - Silence clang 23 unused warnings in the vendored Chromium sandbox code. r=sandbox-reviewers,bobowen\n\nThe 32-bit UnicodeAppendUnsafe overload is unused where wchar_t is 16 bits, and s_is_broker is only ever\nwritten. Both are unchanged in upstream Chromium.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323886\n", "files": ["security/sandbox/moz.build"], "git_node": "e42b0aaf62caf61e7a08e842b134e30e8beffd48", "git_parents": ["62371420568d2486a3627ea8ab5e5f6f721cb568"], "node": "d0da32b974a4a414c07b59fa3eadd51fe05d7205", "parents": ["576374238d785e4f37b01dc3f65c5335fe67a134"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069673 - Silence -Wunused-template in zucchini's Chromium base code. r=bobowen\n\nThe 32-bit UnicodeAppendUnsafe overload is unused where wchar_t is 16 bits and is unchanged upstream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323887\n", "files": ["third_party/zucchini/moz.build"], "git_node": "14d1609f773de02558060ba431880c4e82d93465", "git_parents": ["e42b0aaf62caf61e7a08e842b134e30e8beffd48"], "node": "5b8434dc051a365cfc09db01ad65db3367eeab44", "parents": ["d0da32b974a4a414c07b59fa3eadd51fe05d7205"], "tags": []}], "date": 1788727043, "git_changesets": ["940b489f7915b717b53146d32d5c87103ab9b04b", "52abe248ae83c3ef1fa22128aed8b9f18dffb400", "9aeddfeb94392866469ffdc4ef54dc5241f67dee", "a76508abf122a97082a9803d71f8fbec1f37b71f", "8765832a3194864a5e452eba54e2404a5f958252", "162466af90d8f9b48283f35d52fa246699a2f417", "66b9023deadcb587d03c18f188e6900a75e00ffe", "52c15a7979c2ecab264dcd261aed00da5e9c2b1e", "5e592f02e5fce65f0f87765022a8153599830d1b", "cb4ffbfbe3e029b4705476cad2d5cb944139305c", "c6c0d1bc99153a4d6e3b9e136ce7554585003fd9", "3d38c37633c975417279ab7f9d3362fc38000f01", "869fc80031f8c307192a3af5c00e8a66b5704425", "62371420568d2486a3627ea8ab5e5f6f721cb568", "e42b0aaf62caf61e7a08e842b134e30e8beffd48", "14d1609f773de02558060ba431880c4e82d93465"], "user": "imoraru@mozilla.com"}, "45262": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e d2081baaac63f0251443b09b38db94979c6c318f\naf -\u003e d2081baaac63f0251443b09b38db94979c6c318f\nan -\u003e d2081baaac63f0251443b09b38db94979c6c318f\nar -\u003e d2081baaac63f0251443b09b38db94979c6c318f\nast -\u003e d2081baaac63f0251443b09b38db94979c6c318f\naz -\u0