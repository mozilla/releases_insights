ess_data.py", "toolkit/components/telemetry/build_scripts/gen_process_enum.py", "toolkit/components/telemetry/build_scripts/gen_scalar_data.py", "toolkit/components/telemetry/build_scripts/mozparsers/parse_histograms.py", "toolkit/library/build/dependentlibs.py", "toolkit/moz.configure", "toolkit/mozapps/installer/find-dupes.py", "toolkit/mozapps/installer/packager.py"], "git_node": "023cb8315420edf23536fc0fde97d5717e72f5b1", "git_parents": ["540ac11cd4229d748f13796cf26212be6cef9c8e"], "node": "cc7bb49240ffd602a20c65f6b1b93e483cfca45a", "parents": ["9be43ba15080be99b3c4f366e7d6b248f52fbc9d"], "tags": []}], "date": 1788943102, "git_changesets": ["7e1e37f5ef08ca4131da26ef455c670ebc53d0b4", "04c45753bee1c2f31d659e78a61e93340163c26d", "60ad9d1eb17a2b32acc4f9febbc3481b8ac5ff31", "c3d3e434db8e425d6d9d5219f24733a04acc79b4", "80ae4003e55bad247a3191d0be54da2a674290c8", "7bf8d4ab193684fafe02114253b66369d2dac79b", "33f7ca67aa71605087cbfe249f8ef333a6e51e72", "814121cf025bff36a0471d8c1d30913d7e379f03", "c16b6c2e6a57f3ae2b0d875d37cafa096dd3ded0", "4189aec2b4c926e31e1210c5cb98105829c6f6e4", "38a8b7a877ab6aca6357811cfe9591afb7b34879", "53d18a533eed62d59096fc35e938ab1a9ade0441", "8f5ce1e423b0400e1d075a0a5b3648be3a026d61", "d9ab7a4373b62f78e22f724e65ee88eeb67c4a3e", "dbcf03c2514fcd86461fb6240102932285e0e42c", "3fea0e52800e61d0895ada227011c2a6e22f983a", "318beee1c1b5f3039275d60c945136429b29e53e", "49dba1016062268e4e508297b17fc024915a9473", "3fe55e91796ba66fdc0f7d1235c92d5d34955182", "d6ceec2da606eac1e94ecde0655a285f2fec799b", "57c647e76c75cb37fd6f274587b8d1e88b2a3a20", "e65ec172ddcc7d51ba821607106e7c019a360d45", "8aa660504e43301b92b800ad1d39223d800bb503", "6a860f18759a57164826fc225c11e19f209bac89", "3fe2649f80b5d7097622f398d0d3f04de74dd2af", "56b20259e55143f77f51af5d5920e1e030742eca", "bc7aa95b2bb80f503479b2ebfadb599910ab6362", "540ac11cd4229d748f13796cf26212be6cef9c8e", "023cb8315420edf23536fc0fde97d5717e72f5b1"], "user": "smolnar@mozilla.com"}, "45281": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 574c275bcf5b4f86198c979b7e61f4a844aba0ea with FIREFOX_156_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a6a1643cd538c0aaf72605fca18e345eafd92b2a", "git_parents": ["f098aef4c97c1668ff4a0b905d476080ae4155c5"], "node": "ac7a7a344e02abffdecddd8faf123ad7797dd4fc", "parents": ["6af5d3cadd3539586005cab84edd374df7c673af"], "tags": []}], "date": 1788959264, "git_changesets": ["a6a1643cd538c0aaf72605fca18e345eafd92b2a"], "user": "ffxbld@lando.moz.tools"}, "45282": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 574c275bcf5b4f86198c979b7e61f4a844aba0ea with FIREFOX-ANDROID_156_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4441006d589a74d35e9a38b52223afe66dab91ea", "git_parents": ["a6a1643cd538c0aaf72605fca18e345eafd92b2a"], "node": "51b61aad3789021b69fc128c4bdc677c72c3e314", "parents": ["ac7a7a344e02abffdecddd8faf123ad7797dd4fc"], "tags": []}], "date": 1788959358, "git_changesets": ["4441006d589a74d35e9a38b52223afe66dab91ea"], "user": "ffxbld@lando.moz.tools"}, "45283": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 574c275bcf5b4f86198c979b7e61f4a844aba0ea with DEVEDITION_156_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "0f96f6a2f64c336825159f2ec3a4881348e28839", "git_parents": ["4441006d589a74d35e9a38b52223afe66dab91ea"], "node": "925c967270221b18863aca3fbeb25679e7763e2c", "parents": ["51b61aad3789021b69fc128c4bdc677c72c3e314"], "tags": []}], "date": 1788959448, "git_changesets": ["0f96f6a2f64c336825159f2ec3a4881348e28839"], "user": "ffxbld@lando.moz.tools"}, "45284": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 574c275bcf5b4f86198c979b7e61f4a844aba0ea with FIREFOX-ANDROID_156_0b5_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "0ac6a0da8c97166200ae77fdfb65593982254534", "git_parents": ["0f96f6a2f64c336825159f2ec3a4881348e28839"], "node": "e9c8a3f3a29804a52ad39f3aac5ed2b26f8fbfce", "parents": ["925c967270221b18863aca3fbeb25679e7763e2c"], "tags": []}], "date": 1788960828, "git_changesets": ["0ac6a0da8c97166200ae77fdfb65593982254534"], "user": "ffxbld@lando.moz.tools"}, "45285": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069288 - Make tests using XSLT flip the pref on. r=dom-core-reviewers,layout-reviewers,dom-worker-reviewers,emilio,smaug,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323551\n", "files": ["browser/components/resistfingerprinting/test/browser/browser-xslt.toml", "browser/components/resistfingerprinting/test/browser/browser.toml", "docshell/test/chrome/chrome-xslt.toml", "docshell/test/chrome/chrome.toml", "dom/base/test/mochitest-bug1.toml", "dom/base/test/mochitest-bug2.toml", "dom/base/test/mochitest-xslt.toml", "dom/events/test/mochitest-xslt.toml", "dom/events/test/mochitest.toml", "dom/html/test/mochitest-bug1.toml", "dom/html/test/mochitest-xslt.toml", "dom/security/featurepolicy/test/mochitest/mochitest-xslt.toml", "dom/security/featurepolicy/test/mochitest/mochitest.toml", "dom/security/test/csp/mochitest-xslt.toml", "dom/security/test/csp/mochitest.toml", "dom/serviceworkers/test/mochitest-common.toml", "dom/serviceworkers/test/mochitest-xslt.toml", "dom/tests/mochitest/bugs/mochitest-xslt.toml", "dom/tests/mochitest/bugs/mochitest.toml", "dom/tests/mochitest/general/mochitest-xslt.toml", "dom/tests/mochitest/general/mochitest.toml", "dom/tests/reftest/reftest.list", "dom/tests/reftest/xml-stylesheet/reftest.list", "dom/xml/test/mochitest-xslt.toml", "dom/xml/test/mochitest.toml", "dom/xslt/crashtests/crashtests.list", "dom/xslt/tests/browser/browser.toml", "dom/xslt/tests/mochitest/mochitest.toml", "layout/reftests/bugs/reftest.list", "testing/web-platform/meta/content-security-policy/xslt/__dir__.ini", "testing/web-platform/meta/dom/idlharness.window.js.ini", "testing/web-platform/meta/service-workers/service-worker/xsl-base-url.https.html.ini", "testing/web-platform/meta/xml/xslt/__dir__.ini"], "git_node": "c0dfcea1caf03945435be3c4e1a6431693e87a17", "git_parents": ["023cb8315420edf23536fc0fde97d5717e72f5b1"], "node": "cbbe485f94bbf0ca0f4d8f7330c4fefa98d7f177", "parents": ["cc7bb49240ffd602a20c65f6b1b93e483cfca45a"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2070358 - Fold test reg, full-width mask to test reg, reg on x86. r=jandem\n\ntest reg, imm computes reg & imm and sets flags; when imm covers every bit\nof the operand the AND is a no-op, so test reg, reg produces bit-for-bit\nidentical flags (CF=OF=0, ZF/SF/PF from reg, AF undefined either way) in one\nor more fewer bytes. The encoder already narrows test reg, mask to a byte\ntest when the mask fits in 8 bits (testl_ir); this extends the same idea to\nthe all-ones mask, mirroring the existing cmp reg, 0 -\u003e test reg, reg fold in\ncmpl_ir.\n\nHandle the byte, 32-bit, and 64-bit register forms (testb_ir, testl_ir,\ntestq_ir). The fold matches the mask to the operand width, so it fires after\nthe byte narrowing too (testb reg, 0xff -\u003e testb reg, reg). AL is excluded\nfrom the byte form because its test al, 0xff accumulator encoding already\nties test al, al at two bytes.\n\nOn a JetStream 3 run this removes 12,255 redundant test-immediate sites\n(11,907 Ion, 347 Baseline, 1 other). Each is one byte shorter in the\ndominant byte form, or four bytes in the 32- and 64-bit forms, for at least\n12 KB of JIT code overall.\n\nFound via x86lint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324441\n", "files": ["js/src/jit/x64/BaseAssembler-x64.h", "js/src/jit/x86-shared/BaseAssembler-x86-shared.h"], "git_node": "ad77ad3aee803b467e898e1f95582ef6b9122333", "git_parents": ["c0dfcea1caf03945435be3c4e1a6431693e87a17"], "node": "50230f5ba538a44bb4f34fa51ff969b25ec7732b", "parents": ["cbbe485f94bbf0ca0f4d8f7330c4fefa98d7f177"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066639 - Privacy UX spacing and size fixes. r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321453\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/_Privacy.scss", "browser/extensions/newtab/data/content/assets/widget-privacy-etp-off.svg", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx"], "git_node": "0ba3ca74f301e3f94495f1cdedc27f15ea523e1b", "git_parents": ["ad77ad3aee803b467e898e1f95582ef6b9122333"], "node": "981681e33cd1a3027cca0fda435e3a8e0794a0bf", "parents": ["50230f5ba538a44bb4f34fa51ff969b25ec7732b"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\naf -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nan -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nar -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nast -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\naz -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nbe -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nbg -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nbn -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nbo -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nbqi -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nbr -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nbrx -\u003e a21ed4fba858acba22f66c2e3944a05905007aad\nbs -\u003e a21ed4fba858acba22f66c2