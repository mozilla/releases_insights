_party/rust/neqo-transport/benches/rx_stream_orderer.rs", "third_party/rust/neqo-transport/benches/send_streams.rs", "third_party/rust/neqo-transport/benches/sent_packets.rs", "third_party/rust/neqo-transport/benches/transfer_common.rs", "third_party/rust/neqo-transport/src/cc/classic_cc.rs", "third_party/rust/neqo-transport/src/connection/mod.rs", "third_party/rust/neqo-transport/src/connection/params.rs", "third_party/rust/neqo-transport/src/connection/tests/handshake.rs", "third_party/rust/neqo-transport/src/connection/tests/idle.rs", "third_party/rust/neqo-transport/src/connection/tests/keys.rs", "third_party/rust/neqo-transport/src/connection/tests/recovery.rs", "third_party/rust/neqo-transport/src/connection/tests/reset_stream_at.rs", "third_party/rust/neqo-transport/src/crypto.rs", "third_party/rust/neqo-transport/src/fc.rs", "third_party/rust/neqo-transport/src/lib.rs", "third_party/rust/neqo-transport/src/packet/mod.rs", "third_party/rust/neqo-transport/src/path.rs", "third_party/rust/neqo-transport/src/recovery/mod.rs", "third_party/rust/neqo-transport/src/recv_stream.rs", "third_party/rust/neqo-transport/src/sender.rs", "third_party/rust/neqo-transport/src/stats.rs", "third_party/rust/neqo-transport/src/tparams.rs", "third_party/rust/neqo-udp/.cargo-checksum.json", "third_party/rust/neqo-udp/Cargo.toml", "third_party/rust/neqo-udp/build.rs"], "git_node": "8dc4f40edf7bef430a2d53497a736343247501cd", "git_parents": ["561deccccb44d3f1b5481da5b5298a021156316b"], "node": "84c892709258120d74b927d78f4572146c96e267", "parents": ["df07cee79f20a074fef4217c80fe6775befae721"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 1794809 - Add print-to-PDF support to generate pdf.js form field appearances. r=dholbert\n\npdf.js lays out filled form fields as HTML, but saving or printing needs a PDF\nrepresentation of that content, which is hard to reproduce for complex scripts.\nRender it in a hidden iframe and print it to a PDF buffer in the parent, so\npdf.js can extract the resulting appearance stream and subsetted fonts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310592\n", "files": ["toolkit/components/pdfjs/content/GeckoViewPdfJsParent.sys.mjs", "toolkit/components/pdfjs/content/PdfJsParent.sys.mjs", "toolkit/components/pdfjs/content/PdfJsPrint.sys.mjs", "toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs", "toolkit/components/pdfjs/jar.mn", "toolkit/components/pdfjs/test/browser.toml", "toolkit/components/pdfjs/test/browser_pdfjs_printtopdf.js", "toolkit/components/pdfjs/test/unit/test_print_to_pdf_guard.js", "toolkit/components/pdfjs/test/unit/xpcshell.toml"], "git_node": "1d6b3a52abd025c312eb5a296006376c5efd43c0", "git_parents": ["8dc4f40edf7bef430a2d53497a736343247501cd"], "node": "8580c1b9da73db50be457576278d9a3c2b47090a", "parents": ["84c892709258120d74b927d78f4572146c96e267"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066085 - Add MOZ_GUARDED_BY to font-entry members, r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320885\n", "files": ["gfx/thebes/CoreTextFontList.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontList.h"], "git_node": "cf79d0a3e6a096d66af61a2d28c9373283119f0a", "git_parents": ["1d6b3a52abd025c312eb5a296006376c5efd43c0"], "node": "e30b421972df98ffc514c23206a6ac83ce6f3651", "parents": ["8580c1b9da73db50be457576278d9a3c2b47090a"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062795 - tweak checkbox and radio styles for Nova r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319284\n", "files": ["layout/reftests/box-shadow/1212823-2-ref.html", "layout/reftests/box-shadow/reftest.list", "layout/reftests/forms/input/checkbox/reftest.list", "layout/reftests/image-