mp/line-clamp-auto-033.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-035.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-036.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-037.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-038.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-040.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-041.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-with-ruby-001.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-with-ruby-002.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-with-ruby-003.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-with-ruby-004.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-balance-005.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-balance-006.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-balance-010.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-020.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-021.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-015.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-016.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-auto-048.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/line-clamp-auto-048-ref.html"], "git_node": "31ff9ec4b3dd4d55bcab5dc8b7791f36ae5062b8", "git_parents": ["08cda3e03e8a7adf13d07652090ff3739dca12a4"], "node": "df6015b6cfa2d970c04e7b279d17657972550051", "parents": ["70bf799a5c46fbb55559550840ae83b952ae55f4"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2042743 - Check the baseline frame height before creating a stackmap. r=yury\" for causing for causing jit failures @ tests/jit-test/jit-test/tests/wasm/regress/baseline-stack-height-during-stackmap.js\n\nThis reverts commit 1a3cb5deadd0a4c6e16140082b994a2841f35a9a.\n", "files": ["js/src/jit-test/tests/wasm/regress/baseline-stack-height-during-stackmap.js", "js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCFrame.cpp", "js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "77cd1f9c8074a6c2a54152e39089d3f5629fd640", "git_parents": ["31ff9ec4b3dd4d55bcab5dc8b7791f36ae5062b8"], "node": "48b1e145e21b14f79950def908648a051b02cc04", "parents": ["df6015b6cfa2d970c04e7b279d17657972550051"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1981648 - P3: Send value change events for numeric values. r=Jamie,geckoview-reviewers,m_kato\" for causing android gv-junit failures\n\nThis reverts commit 86f69a8d83434f9ba66ad28cc978a572eb84074f.\n\nRevert \"Bug 1981648 - P2: Make ranges and spinners adjustable with scroll action. r=Jamie,geckoview-reviewers,m_kato\"\n\nThis reverts commit 867af286189a94dcc57f39c4565dfbcfaf56c465.\n\nRevert \"Bug 1981648 - P1: Add IsHTMLRange and fix IsHTMLSpinner. r=Jamie\"\n\nThis reverts commit 56ec023597ada2e738b9f5dd1a09fa546d6f12aa.\n", "files": ["accessible/android/Platform.cpp", "accessible/android/SessionAccessibility.cpp", "accessible/android/SessionAccessibility.h", "accessible/basetypes/Accessible.h", "accessible/html/HTMLFormControlAccessible.h", "dom/locales/en-US/chrome/accessibility/AccessFu.properties", "mobile/android/geckoview/src/androidTest/assets/www/accessibility/test-range.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": "8c0204334376b486920fa74442f1d2c98ee6d9db", "git_parents": ["77cd1f9c8074a6c2a54152e39089d3f5629fd640"], "node": "98b07eb41f9a3723ce48c8f49e223fc6efbef564", "parents": ["48b1e145e21b14f79950def908648a051b02cc04"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2036222 - Remove NimbusTestUtils.factories.{experiment,rollout} r=ralkhulaidi,nimbus-reviewers,emcminn\n\nThe use of these factories has been replaced with:\n\n- `ExperimentManager.createIncompleteEnrollment()`, a static method that\n  provides a common implmentation of enrollment creation for the\n  ExperimentManager (via `ExperimentManager.createEnrollment()`) and\n  tests;\n- `NimbusTestUtils.factories.enrollment()`, which generates an enrollment\n  from a recipe using `createInactiveEnrollment()`; and\n- `NimbusTestUtils.factories.addEnrollmentForRecipe()`, which uses\n  `factories.enrollment()` to add an enrollment to a store given a\n  recipe.\n\n`ExperimentManager.createIncompleteEnrollment()` does the bulk of the\nheavy lifting here and exists to generate all the non-stateful (e.g.,\n`prefFlips`, and `prefs` fields).\n\n`ExperimentManager.createEnrollment()` did not provide a default\nenrollment reason for inactive enrollments. Inactive enrollments now\ndefault to \"unknown\".\n\nAdditionally, I found a bug in test_Migrations.js where we were not\nactually testing the values of prefs.\n\nI also took this opportunity to split up the tests in\ntest_ExperimentManager_context.js to be more independent from eachother.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321872\n", "files": ["toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/unit/test_ExperimentAPI_ExperimentFeature.js", "toolkit/components/nimbus/test/unit/test_ExperimentAPI_NimbusFeatures.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_context.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_enroll.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_unenroll.js", "toolkit/components/nimbus/test/unit/test_ExperimentStore.js", "toolkit/components/nimbus/test/unit/test_Migrations.js"], "git_node": "96cf785b9eb62d9ae5a61f411e77e0d74798a747", "git_parents": ["8c0204334376b486920fa74442f1d2c98ee6d9db"], "node": "1d4cecc77824a5c927b24e9a6763b36652acb01e", "parents": ["98b07eb41f9a3723ce48c8f49e223fc6efbef564"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2066616 - Rework NimbusTestUtils branches and bucketConfig factories r=ralkhulaidi,nimbus-reviewers,mconley,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321873\n", "files": ["browser/components/preferences/tests/experimental_features/browser_experimental_features_filter.js", "browser/components/preferences/tests/experimental_features/head.js", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/unit/test_ExperimentManager_enroll.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_unenroll.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js"], "git_node": "5adf600aaddd7f6765b090567132d4edceff64c2", "git_parents": ["96cf785b9eb62d9ae5a61f411e77e0d74798a747"], "node": "3319b6478e71552a926c947d8d879f00a8184b74", "parents": ["1d4cecc77824a5c927b24e9a6763b36652acb01e"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2066616 - Define NimbusTestUtils.factories.recipe.withFeatureConfig using Object.assign r=ralkhulaidi,nimbus-reviewers,emcminn\n\nUsing Object.assign over Object.defineProperties allows for TypeScript\ntype information to be inferred.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321874\n", "files": ["toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs"], "git_node": "d3ee526ee0ecb5bc78130255fe3d158dc23ee91b", "git_parents": ["5adf600aaddd7f6765b090567132d4edceff64c2"], "node": "cb8d99b7df3c0e84bdab0dadade05768e1ddd3a0", "parents": ["3319b6478e71552a926c947d8d879f00a8184b74"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2065869 - Use XPCOMUtils.declareLazy for all Nimbus modules r=ralkhulaidi,nimbus-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321875\n", "files": ["toolkit/components/nimbus/ExperimentAPI.sys.mjs", "toolkit/components/nimbus/FirefoxLabs.sys.mjs", "toolkit/components/nimbus/lib/Enrollments.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/ExperimentStore.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/lib/Telemetry.sys.mjs", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs"], "git_node": "e708ed8ac71f5c9fa1c38d2ff1281f7463fd4284", "git_parents": ["d3ee526ee0ecb5bc78130255fe3d158dc23ee91b"], "node": "58df4a9ffa72c2cbc0002cabb8970e2c080dbfb0", "parents": ["cb8d99b7df3c0e84bdab0dadade05768e1ddd3a0"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2067177 - Remove ExperimentManager.id r=ralkhulaidi,nimbus-reviewers,emcminn\n\nThis argument is never passed and is functionally a constant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321877\n", "files": ["toolkit/components/nimbus/lib/ExperimentManager.sys.mjs"], "git_node": "3c0d8307b06e3d72f7ce0760fcf3dd224e030651", "git_parents": ["e708ed8ac71f5c9fa1c38d2ff1281f7463fd4284"], "node": "65edc7c1ae0fe213e40762a82bc1de74ce152516", "parents": ["58df4a9ffa72c2cbc0002cabb8970e2c080dbfb0"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056186 - enable Nova redesign by default in all channels r=nsharpley\n\nTargeting general release in Firefox 157.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323281\n", "files": ["browser/app/profile/firefox.js"], "git_node": "39d12b14509bb4ec88a62d31b5808a34b2b02564", "git_parents": ["3c0d8307b06e3d72f7ce0760fcf3dd224e030651"], "node": "4aa996027852da93deb67bfa299c680c6fd400b7", "parents": ["65edc7c1ae0fe213e40762a82bc1de74ce152516"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068433 - Assert buffer is same-compartment in fromBufferSameCompartment r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323377\n", "files": ["js/src/vm/TypedArrayObject.cpp"], "git_node": "c31bb02c5ab0fcf95024252cd00ace81aead418c", "git_parents": ["39d12b14509bb4ec88a62d31b5808a34b2b02564"], "node": "174ca1a029eda9d729a10aac8783fd965de48476", "parents": ["4aa996027852da93deb67bfa299c680c6fd400b7"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068433 - Wrap buffer r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323378\n", "files": ["dom/streams/ReadableByteStreamController.cpp"], "git_node": "168f1683dcbca7f54a6a4a91930f4039c161e307", "git_parents": ["c31bb02c5ab0fcf95024252cd00ace81aead418c"], "node": "54d6bd5b1def702c385ebc37f80d9f4e99adfa64", "parents": ["174ca1a029eda9d729a10aac8783fd965de48476"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2068433: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/vm/TypedArrayObject.cpp"], "git_node": "4f42a1e99b52fd558082f586e5b0ca4d5e475783", "git_parents": ["168f1683dcbca7f54a6a4a91930f4039c161e307"], "node": "68484191ccec1c11012f77101d5f2a1aafc39b32", "parents": ["54d6bd5b1def702c385ebc37f80d9f4e99adfa64"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068970 - Use :dir() instead of :-moz-locale-dir() for urlbar / searchbar RTL rules. r=adw,desktop-theme-reviewers,emilio\n\n:-moz-locale-dir() is a document-state pseudo-class, and Document::IsDocumentRightToLeft() returns false for anything but a chrome document, so those rules are inert in about:newtab, which links the same sheet through UrlbarInputBase. :dir() reads the dir attribute DOMLocalization puts on the root, and browser.xhtml and about:newtab both carry it.\n\nSelectors that would otherwise resolve against a dir attribute on the element itself anchor on an ancestor instead, so every rule still keys off the locale direction.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323319\n", "files": ["browser/themes/shared/urlbar.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "2a9455153a2efa32f691f6e09a2b65c7f62ab9dd", "git_parents": ["4f42a1e99b52fd558082f586e5b0ca4d5e475783"], "node": "86ba489062f025fa16cc342731b6004deadd6fcc", "parents": ["68484191ccec1c11012f77101d5f2a1aafc39b32"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066671 - Keep the search mode switcher button within its slot in the address bar. r=adw,urlbar-reviewers\n\nThe moz-button host has a fixed height but `part(button)`, which paints it, only ever gets `min-height`, so it grows past the host once the label's line box outgrows the slot. Compact density leaves that slot 20px, which a 14px chrome root font already exceeds.\n\n`display: flex` on the host also drops the inline-block baseline offset that puts the button below the host's top edge above an 18px root font.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323427\n", "files": ["browser/components/urlbar/tests/browser-searchMode/browser.toml", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_bounds.js", "browser/themes/shared/urlbar.css"], "git_node": "974e0b75e05d8fa63f130ad989dd3c8dfbd57c04", "git_parents": ["2a9455153a2efa32f691f6e09a2b65c7f62ab9dd"], "node": "94ebdfc85fdf621c90f0f487b1db4abb11c217aa", "parents": ["86ba489062f025fa16cc342731b6004deadd6fcc"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063281 - Let content alert, confirm, and prompt dialogs use content's preferred color scheme. r=tabbrowser-reviewers,nsharpley\n\nReland with browser_ext_themes_pbm.js updated: a content-modal prompt in a private window follows content's light scheme, not the window's dark theme.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322997\n", "files": ["browser/base/content/test/tabdialogs/browser_tabdialogbox_content_prompts.js", "browser/themes/shared/tabbrowser/content-area.css", "toolkit/components/extensions/test/browser/browser_ext_themes_pbm.js"], "git_node": "7c0a9bf025a3ef2ff7a03d5f91d885d3cd6b985d", "git_parents": ["974e0b75e05d8fa63f130ad989dd3c8dfbd57c04"], "node": "a912c891d211ef117c3bac37a500ebdf9d67de6c", "parents": ["94ebdfc85fdf621c90f0f487b1db4abb11c217aa"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068663 - Fix \"Pick a Search Engine\" to use sentence casing instead. r=fluent-reviewers,bolsson\n\nNo string id change since casing rules are language specific.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322999\n", "files": ["browser/locales/en-US/browser/browser.ftl"], "git_node": "c0557b0b1035ebc9ecc444f1144a820127cbf39b", "git_parents": ["7c0a9bf025a3ef2ff7a03d5f91d885d3cd6b985d"], "node": "d12dcd88d77d180ee1807106f9993548691d0a31", "parents": ["a912c891d211ef117c3bac37a500ebdf9d67de6c"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065329: Make EGL stop requesting a D3D9 angle backend, which is never available. r=gfx-reviewers,lsalzman\n\nThis collapses two if blocks into one, requesting a D3D11 backend, and\nfalling back to default if not available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323085\n", "files": ["gfx/gl/GLDefs.h", "gfx/gl/GLLibraryEGL.cpp"], "git_node": "1c8b7eab2a4b6273d3a120e05e0b24b03b8d214c", "git_parents": ["c0557b0b1035ebc9ecc444f1144a820127cbf39b"], "node": "d8b93e9b02dc739d92cc49ffb88138c4414a6de4", "parents": ["d12dcd88d77d180ee1807106f9993548691d0a31"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2069177 - Limit SurfaceDescriptor type in ContentCompositorBridgeParent::AllocPTextureParent() r=gfx-reviewers,lsalzman\n\nIn content process, a limited number of SurfaceDescriptor types are used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323443\n", "files": ["gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": "29aa9c78012538b2a3afd5b59d74eed4e5c449c6", "git_parents": ["1c8b7eab2a4b6273d3a120e05e0b24b03b8d214c"], "node": "d8a4ba720579e1896b72d42888cd1d6ef41c081e", "parents": ["d8b93e9b02dc739d92cc49ffb88138c4414a6de4"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2051026 - Firefox should consider content:// URI that has authority with user id. r=geckoview-reviewers,tcampbell\n\nWhen using old version of Samsung My File app and opening a PDF file\nfrom it, URI has authority with user id such as `\"0@media\"`.\n\nWhen opening it with `\"0@meida\"` authority, Firefox cannot open it\nsince `PackageManager.resolveContentProvider` cannot parse it.\n\nSo we need to remove user id from authority when calling\n`PackageManager.resolveContentProvider` to get the correct content\nprovider information.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319025\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/PdfCreationTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/ContentInputStream.java"], "git_node": "66ecf75aa1a0f01cd7c9c6a9b70db1ed6770e5a5", "git_parents": ["29aa9c78012538b2a3afd5b59d74eed4e5c449c6"], "node": "4b7bcd452de6723d2f786104e130fc080d461459", "parents": ["d8a4ba720579e1896b72d42888cd1d6ef41c081e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067987 - Give a directory target in the compile graph a single recipe r=RyanVM\n\nA shared library with an output category puts its directory target in the\ncompile graph under the category's name, which is also the name of the tier\nthat traverses the directory. Two rules then claim that target, and make warns\nthat it is discarding one of them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322554\n", "files": ["config/recurse.mk"], "git_node": "0e79b22f79e8335a4c2ca11cd8b67eb76e9f40f6", "git_parents": ["66ecf75aa1a0f01cd7c9c6a9b70db1ed6770e5a5"], "node": "1920ba943cb41d57ddb8d6bc717576688c42f142", "parents": ["4b7bcd452de6723d2f786104e130fc080d461459"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Add an action to generate linker symbol inputs from a static archive r=firefox-build-system-reviewers,sergesanspaille\n\nA linker needs literal symbol names, so the patterns a symbol pattern file\nholds are resolved against the static library the shared library is linked\nfrom. Windows takes the result as a module definition file, while ELF and\nMach-O take undefined symbol roots that keep the archive members defining\nthose symbols.\n\nA generated file the link reads has to exist before the link runs, so\nEXTRA_LINK_DEPS decides which generated outputs are written in the directory\nthat links them rather than at the top level.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320193\n", "files": ["python/mozbuild/mozbuild/action/generate_archive_symbols.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/action/test_generate_archive_symbols.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/moz.build", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/sharedlib/generate.py", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/sharedlib/moz.build", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/sharedlib/rsp-data", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/unrelated/generate.py", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/unrelated/moz.build", "python/mozbuild/mozbuild/test/backend/data/extra-link-deps/unrelated/rsp-data", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/extra-link-deps-shared/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "acc54bb6ef53a295223d26f8ae23b4e03b8aa640", "git_parents": ["0e79b22f79e8335a4c2ca11cd8b67eb76e9f40f6"], "node": "4838b6c7cabffc88040b490586726aaad876b10e", "parents": ["1920ba943cb41d57ddb8d6bc717576688c42f142"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Add desktop architecture support (Linux, macOS, Windows) to the fat AAR pipeline for `libsForTests` r=nalexander,firefox-build-system-reviewers,geckoview-reviewers\n\nThe `libsForTests` JAR consumers need a complete set of native libraries for\nwhichever host platform their JVM tests run on, and the fat AAR handled Android\narchitectures only. It now also stages target.libmegazord_so_artifacts.zip from\nthe desktop builds.\n\nOnly a build with an in-tree app-services produces that archive, so the desktop\npaths are named explicitly rather than downloaded, and the Android fallback\ntakes its AAR from the app-services build when one is in tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292612\n", "files": ["Makefile.in", "mobile/android/moz.configure", "python/mozbuild/mozbuild/action/fat_aar.py", "python/mozbuild/mozbuild/test/action/test_fat_aar.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "d436c321ed7bdb4a34b85a512326d3225c474d0f", "git_parents": ["acc54bb6ef53a295223d26f8ae23b4e03b8aa640"], "node": "a79ec6d1aadb0ff752f82a9ade85c76e4083d8eb", "parents": ["4838b6c7cabffc88040b490586726aaad876b10e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Export the megazord's UniFFI ABI without the symbol stub r=firefox-build-system-reviewers,sergesanspaille\n\nUniFFI symbols are resolved by name at run time, so nothing refers to them at\nlink time and the linker keeps none of the archive members that define them.\nThe stub named one symbol per crate, which kept one member each, and it did not\npopulate the Windows export table.\n\n`megazord.symbols` describes the ABI once. Windows gets a module definition\nfile, which both keeps those members and exports them. ELF and Mach-O get\nundefined symbol roots to keep the members, and rely on SYMBOLS_FILE for what\nthe library exports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320196\n", "files": ["third_party/application-services/megazords/fenix-dylib/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py", "toolkit/components/uniffi-bindgen-gecko-js/megazord.symbols"], "git_node": "5c2121970343686aaa2a9f07dd5d3b722d624073", "git_parents": ["d436c321ed7bdb4a34b85a512326