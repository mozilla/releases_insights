1567bf6454faeead5e7d334f47a7384b2a3e33"], "node": "64e16150b73021e5219c6018d2a844ddd77ada80", "parents": ["ea8218b9e9e9939543c9bcba30b71f1cccc04de8"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - List the vendored node packages in `about:license` r=sylvestre,firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321778\n", "files": ["toolkit/content/license.html"], "git_node": "f174ceb3cf4ed037a4053fa97bf58ec6d5442dd4", "git_parents": ["d0470670a103bb1d68c2d5b144e83283b43394e0"], "node": "668e494beeefd26cccd7962329dc41e0b9e33a6e", "parents": ["64e16150b73021e5219c6018d2a844ddd77ada80"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Build the newtab bundles from the vendored node packages r=mconley,ai4dev-reviewers,padenot\n\nNothing is installed during the build now, and it can run without network access.\nWebpack's inputs are recorded and hashed rather than returned as dependencies,\nsince the FasterMake backend never includes the dependency files it writes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320323\n", "files": ["browser/extensions/newtab/AGENTS.md", "browser/extensions/newtab/build-newtab-bundles.py", "browser/extensions/newtab/moz.build", "browser/extensions/newtab/webpack.system-addon.config.js", "taskcluster/kinds/artifact-build/kind.yml", "taskcluster/kinds/build-extensions/kind.yml", "taskcluster/kinds/build/kind.yml", "taskcluster/kinds/hazard/kind.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "taskcluster/kinds/source-test/vendor.yml", "taskcluster/kinds/valgrind/kind.yml"], "git_node": "95aa7c1db3626e5a6fd033270d704468ddf464b4", "git_parents": ["f174ceb3cf4ed037a4053fa97bf58ec6d5442dd4"], "node": "5fd880e0eec1c2f56be8d375d785fea7a04cc334", "parents": ["668e494beeefd26cccd7962329dc41e0b9e33a6e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Check the licenses of the vendored node packages r=firefox-build-system-reviewers,linter-reviewers,Standard8,sergesanspaille\n\nThe `node-licenses` lint normally reinstalls `node_modules` with `npm`. For vendored\ntrees that `pnpm` manages, it checks the existing tree instead and reports an\nerror when it is missing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320324\n", "files": ["taskcluster/kinds/source-test/mozlint.yml", "tools/lint/node-licenses.yml", "tools/lint/node-licenses/__init__.py", "tools/lint/test/files/node-licenses/pnpm-missing/package.json", "tools/lint/test/files/node-licenses/pnpm-missing/pnpm-lock.yaml", "tools/lint/test/files/node-licenses/pnpm-unknown/node_modules/@mozilla/unknown-license/package.json", "tools/lint/test/files/node-licenses/pnpm-unknown/package.json", "tools/lint/test/files/node-licenses/pnpm-unknown/pnpm-lock.yaml", "tools/lint/test/files/node-licenses/pnpm-vendored/node_modules/@mozilla/known-license/package.json", "tools/lint/test/files/node-licenses/pnpm-vendored/package.json", "tools/lint/test/files/node-licenses/pnpm-vendored/pnpm-lock.yaml", "tools/lint/test/test_node_licenses.py"], "git_node": "bbd47a1061fe1ee9e78787fe5ad28ac0799c25ce", "git_parents": ["95aa7c1db3626e5a6fd033270d704468ddf464b4"], "node": "5713dbdae4ab703931f5b3e55cf9e54a07d16461", "parents": ["5fd880e0eec1c2f56be8d375d785fea7a04cc334"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065363 - Integrate `pnpm audit` into `mozlint` r=linter-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321400\n", "files": [".yamllint", "docs/code-quality/index.md", "docs/code-quality/lint/linters/pnpm-audit.md", "taskcluster/kinds/source-test/mozlint.yml", "taskcluster/kinds/source-test/python.yml", "tools/lint/pnpm-audit.yml", "tools/lint/pnpm-audit/__init__.py", "tools/lint/test/files/pnpm-audit/clean/package.json", "tools/lint/test/files/pnpm-audit/clean/pnpm-lock.yaml", "tools/lint/test/files/pnpm-audit/vulnerable/package.json", "tools/lint/test/files/pnpm-audit/vulnerable/pnpm-lock.yaml", "tools/lint/test/python.toml", "tools/lint/test/test_pnpm_audit.py"], "git_node": "97313bb6ae6643d814db6a61b9f3902b1e7d85ec", "git_parents": ["bbd47a1061fe1ee9e78787fe5ad28ac0799c25ce"], "node": "d85da6e65e08cc594b58617fb922fb4f6532c58e", "parents": ["5713dbdae4ab703931f5b3e55cf9e54a07d16461"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069417 - Record theme-picker shown telemetry for about:addons aboutaddons-themes-picker webcomponent. r=mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324611\n", "files": ["toolkit/mozapps/extensions/content/components/aboutaddons-themes-picker.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js"], "git_node": "6d067793eae3c9f3720c1da9b2d374a2d3b7d3e1", "git_parents": ["97313bb6ae6643d814db6a61b9f3902b1e7d85ec"], "node": "c06ef94f48a10aa212157e4c1159e23f4ca0eff5", "parents": ["d85da6e65e08cc594b58617fb922fb4f6532c58e"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070341 - Record theme_picker.change appearance mode and native theme mode changes in about:addons. r=mstriemer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324626\n", "files": ["toolkit/mozapps/extensions/content/components/aboutaddons-themes-mode.mjs", "toolkit/mozapps/extensions/content/components/native-theme-colors-checkbox.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_linux_theme_colors_checkbox.js", "toolkit/mozapps/extensions/test/browser/browser_html_themes_mode.js"], "git_node": "273879696aa6665a5b0aaf0f20467a82510417d1", "git_parents": ["6d067793eae3c9f3720c1da9b2d374a2d3b7d3e1"], "node": "f61e8487f10bf1644c33c1985f4deb0c84c3d08c", "parents": ["c06ef94f48a10aa212157e4c1159e23f4ca0eff5"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2070396 - Upgrade sixgill to latest main. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324782\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "f8cb83718e5045878ad1ae6a98d80376116b3df9", "git_parents": ["273879696aa6665a5b0aaf0f20467a82510417d1"], "node": "0d05e3955fa74049c6bd31e454ae7fb33ba8801c", "parents": ["f61e8487f10bf1644c33c1985f4deb0c84c3d08c"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054193 - Add functionality to use form history to target low/no SAP searchers. r=mcheang,omc-reviewers,emcminn\" for causinf bc and TV tests failures at /browser_asrouter_targeting.js\n\nThis reverts commit 7e1f232ae2d893d7423711c730fa2149c64c70b4.\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_targeting.js"], "git_node": "ab5fbb05a20434339c5cf99605714f772053126a", "git_parents": ["f8cb83718e5045878ad1ae6a98d80376116b3df9"], "node": "68bd345bf91418e86f5af22812191b7e718a26f5", "parents": ["0d05e3955fa74049c6bd31e454ae7fb33ba8801c"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052772 - Part 4: Wait for FOG init before reading Glean in the startup_about_home_paint talos addon r=perftest-reviewers,sparky\" for causing talos failures in startup_about_home_paint\n\nThis reverts commit efc45c133c218f4fbee4e7b44f366753d91b6a93.\n", "files": ["testing/talos/talos/startup_test/startup_about_home_paint/addon/api.js"], "git_node": "9529bc255b33276a631271168635f07c7428730a", "git_parents": ["ab5fbb05a20434339c5cf99605714f772053126a"], "node": "41b59d4620dc89571cc83c841cc01368d6c97d5c", "parents": ["68bd345bf91418e86f5af22812191b7e718a26f5"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063156 - Use submitChatMessage for resume conversations r=echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323800\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "f0fd681467c720a281430034852b6c0514e95744", "git_parents": ["9529bc255b33276a631271168635f07c7428730a"], "node": "ce64361a9e89cce72a0a7b1a6caa4c1d0fec8fdf", "parents": ["41b59d4620dc89571cc83c841cc01368d6c97d5c"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070037 - Don't clip a CSS filter function to the region of an earlier url() filter r=firefox-svg-reviewers,longsonr\n\nIn a chain like filter: url(#f) drop-shadow(...), WebRender's SVG filter graph\nbuilder clamped the last primitive's subregion to the filter region. That region\ncomes from the SVG filter element, so it only bounds the primitives that element\ncontributed; a CSS filter function after it has its own extent. The shadow was\ncut off at the edge of the referenced filter's region.\n\nOnly clamp when the chain ends in a url() filter, which is the case the clamp\nwas written for: SVGFilterInstance computes integer subregions, and the filter\nregion it has to be trimmed to is not integer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324167\n", "files": ["layout/reftests/svg/filters/css-svg-filter-chains/css-filter-last-outside-region-ref.html", "layout/reftests/svg/filters/css-svg-filter-chains/css-filter-last-outside-region.html", "layout/reftests/svg/filters/css-svg-filter-chains/reftest.list", "layout/svg/FilterInstance.cpp"], "git_node": "e5ff8b79a53c1a9f3c116dfb632d2bc881b9035c", "git_parents": ["f0fd681467c720a281430034852b6c0514e95744"], "node": "0cb2f8cbbed52136d5129078b6e8602f1dceb3b5", "parents": ["ce64361a9e89cce72a0a7b1a6caa4c1d0fec8fdf"], "tags": []}, {"author": "jsimplicio \u003cjsimplicio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054561 - Message bar spec update for Nova r=desktop-theme-reviewers,mkennedy,translations-reviewers,thecount,nordzilla,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311913\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/shared/preferences/preferences.css", "toolkit/components/translations/content/about-translations.css", "toolkit/content/widgets/infobar.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.nova.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/components/info-bar.tokens.json"], "git_node": "532257c0f5efa536ff8440f24d59a53fc7b4a9d0", "git_parents": ["e5ff8b79a53c1a9f3c116dfb632d2bc881b9035c"], "node": "1fec2b5f4394e20c6baf56db59d4386b883861f7", "parents": ["0cb2f8cbbed52136d5129078b6e8602f1dceb3b5"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070400 - Pt 1 - Stop storing the snapped leaf clip rect on the clip tree r=gfx-reviewers,nical\n\nThe stored copy had one writer and one reader, in the same loop iteration.\nIt is passed to set_active_clips rather than snapped there, because that\nfunction re-targets its snapper per clip node.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324494\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "640abceed218fcc24e57d8faba56fc31ccabb025", "git_parents": ["532257c0f5efa536ff8440f24d59a53fc7b4a9d0"], "node": "7ff23836a85065cd4354c11ca8d8f9b8c5b12cd7", "parents": ["1fec2b5f4394e20c6baf56db59d4386b883861f7"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070400 - Pt 2 - Move the clip root stack into frame visibility state r=gfx-reviewers,nical\n\nIt is frame state, and holding it on the scene's clip tree was the last\nreason frame building borrowed that tree mutably.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324495\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "b7ef5fca9e0a6d23ac640eaa9a917e2bf8b7a151", "git_parents": ["640abceed218fcc24e57d8faba56fc31ccabb025"], "node": "19b1d956faac6e1002c038f0b8322d7df98406e3", "parents": ["7ff23836a85065cd4354c11ca8d8f9b8c5b12cd7"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070400 - Pt 3 - Derive the snap policy from PrimitiveKind r=gfx-reviewers,nical\n\nNothing used the node id the clip leaf stored for this; both consumers only\ncompared it against the INVALID sentinel to recover a bool, which is a property\nof the primitive type. SNAP_CLIPS and the sentinel go too, so a ClipNodeId is\nalways a real node.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324496\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "40f4f0661877ff878996cb9deee1bc06f4c15ac6", "git_parents": ["b7ef5fca9e0a6d23ac640eaa9a917e2bf8b7a151"], "node": "1596e8daa37236b906316f704be4d05bbcffd679", "parents": ["19b1d956faac6e1002c038f0b8322d7df98406e3"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070400 - Pt 4 - Move the clip chain start onto the primitive instance r=gfx-reviewers,nical\n\nFree: it fills existing padding, so PrimitiveInstance stays 32 bytes. Neither\nproducer transformed the node, so callers already had the value. With it,\nset_active_clips no longer needs a leaf id, and the tile cache stores a node\nid rather than a leaf that held nothing but max_rect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324497\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "216b5ae7ecaa66f6d1cb97a2f34013da9971ae5a", "git_parents": ["40f4f0661877ff878996cb9deee1bc06f4c15ac6"], "node": "6762c6f3efab23e0a282de0aaff89a97e9636498", "parents": ["1596e8daa37236b906316f704be4d05bbcffd679"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070400 - Pt 5 - Make PictureIndex a u32 rather than a usize r=gfx-reviewers,nical\n\nIt was the only thing forcing eight-byte alignment on PrimitiveKind, which\ndrops from 24 bytes to 16, and PrimitiveInstance from 32 to 24. SpatialNodeIndex\nand ClipTaskIndex are already u32.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324498\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/picture_graph.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/scene_debug.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "822a814dc6bd589bec49f80b17db2346d85f53d3", "git_parents": ["216b5ae7ecaa66f6d1cb97a2f34013da9971ae5a"], "node": "ce9dae754ae336097d530a15b0a27954ace6f897", "parents": ["6762c6f3efab23e0a282de0aaff89a97e9636498"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2070400 - Pt 6 - Remove ClipTreeLeaf and intern the local clip rect r=gfx-reviewers,nical\n\nThe rect is display-list content like prim_rect, and normalize_common already\nstrips the external scroll offset from it, so keying on it leaves prim_uid\nscroll-stable. Scene building takes it as an argument instead, since a template\ndoes not exist yet at that point.\n\nPrimitiveInstance drops from 24 to 20 bytes; each key and template grows by the\nrect's 16. Fragmentation should be limited to primitives sharing a prim rect but\ndiffering in clip, mainly borders and backgrounds split across continuations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324499\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/gradient/mod.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/prim_store/line_dec.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/prim_store/rectangle.rs", "gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/webrender_api/src/key_types.rs"], "git_node": "fd3e981d9100d649087bba0b37ab6c1293a9b992", "git_parents": ["822a814dc6bd589bec49f80b17db2346d85f53d3"], "node": "ecedc7cc2a0e3b21c23f68501062f87606e36559", "parents": ["ce9dae754ae336097d530a15b0a27954ace6f897"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059861 - hardcode better link contrast in private window info panel r=sfoster,desktop-theme-reviewers\n\nHardcode a brighter link color only in the private window indicator panel, which only displays in a private window.\n\nThe Nova private window theme is inheriting the `--color-violet-30` dark accent color from the system Nova theme. This value is applied to the `--link-color` token. The Nova private window theme is using a lighter color `--color-violet-desaturated-60` for panel backgrounds and this doesn't provide enough contrast with the Nova accent color.\n\nThere's no way for a theme to set a specific color for panel links. There aren't a lot of panels with links, but this one is considered important enough that it should be fixed before the initial release of the Nova redesign. It's also considered important enough to have a short-term, local fix.\n\nSince private windows can display with user themes, this patch tries to only override the color when a user has the Nova built-in private window theme active and the user doesn't have forced colors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324755\n", "files": ["browser/themes/shared/browser-shared.css"], "git_node": "325bba7b47628956cd5b9b9b8466e111810b4ea7", "git_parents": ["fd3e981d9100d649087bba0b37ab6c1293a9b992"], "node": "67eb597b5a34efe94f24ac72b8d29d0ad81c9cf7", "parents": ["ecedc7cc2a0e3b21c23f68501062f87606e36559"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066396 - Let a caller force keyword fixup regardless of keyword.enabled. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321001\n", "files": ["docshell/base/URIFixup.sys.mjs", "docshell/base/nsIURIFixup.idl", "docshell/test/unit/test_URIFixup_search.js", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "e5354bed290f75cf360295b20b96340305ac0684", "git_parents": ["325bba7b47628956cd5b9b9b8466e111810b4ea7"], "node": "2b59f0f840167bb79ad19615edfe60298377f1e0", "parents": ["67eb597b5a34efe94f24ac72b8d29d0ad81c9cf7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066396 - Force the keyword lookup for a search bar's fixup. r=mak,urlbar-reviewers\n\nWithout this, fixup hands the newtab search bar a visit result before the provider's check is reached, so a search string it can't parse as a URL doesn't search while `keyword.enabled` is off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321184\n", "files": ["browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/browser-newtab/browser_blur.js", "browser/components/urlbar/tests/browser-newtab/browser_caret.js", "browser/components/urlbar/tests/browser-newtab/browser_escape.js", "browser/components/urlbar/tests/browser-newtab/browser_pickResult.js", "browser/components/urlbar/tests/browser-newtab/browser_topLayer.js", "browser/components/urlbar/tests/browser-newtab/head.js", "browser/components/urlbar/tests/unit/test_UrlbarProviderSearchSuggestions.js", "browser/components/urlbar/tests/unit/test_providerHeuristicFallback.js", "browser/components/urlbar/tests/unit/test_providerRecentSearches.js"], "git_node": "002299c6481c4d16fd776246dd2552595d6c76f5", "git_parents": ["e5354bed290f75cf360295b20b96340305ac0684"], "node": "b849db0fcbfc6ce80758243829ea46d74dff5e26", "parents": ["2b59f0f840167bb79ad19615edfe60298377f1e0"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2070759 - Upload config.log to the artifacts directory. r=firefox-build-system-reviewers,ahochheiden\n\nIt can contain crucial information that does not appear in the normal\nlog, especially when configure fails, but also when configure succeeds\nin unexpected ways, like it happened in the failure from bug 2069184.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324815\n", "files": ["python/mozbuild/mozbuild/controller/building.py"], "git_node": "f2e75a1bcf7f7f33637ab70af1b03837aef788fd", "git_parents": ["002299c6481c4d16fd776246dd2552595d6c76f5"], "node": "68e676eee6799a21d72597ad5b7c80e50565b80b", "parents": ["b849db0fcbfc6ce80758243829ea46d74dff5e26"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068024 - Stylelint: lift the color declaration scan into helpers.mjs (no functional change) r=hjones,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322594\n", "files": ["tools/lint/stylelint/stylelint-plugin-mozilla/helpers.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/use-paired-color-tokens.mjs"], "git_node": "4e518ef68236b838dd23c1590584aefafeef3325", "git_parents": ["f2e75a1bcf7f7f33637ab70af1b03837aef788fd"], "node": "d40f492429a6f72c3677d6611ace8fa986e67c81", "parents": ["68e676eee6799a21d72597ad5b7c80e50565b80b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068024 - Give the surfaces that paint a token background a text color r=mtigley,desktop-theme-reviewers,credential-management-reviewers,urlbar-reviewers,hjones,mak\n\nMost of these are value-neutral in the default theme, where the text token resolves to the color the surface already inherited and the background token is often a currentColor wash of it; they take effect under forced colors, a lightweight theme and Nova. Visible by default are the app menu's sync-setup button in light mode, about:welcome's selection flair, which was rendering white text on a pale violet fill, the Top Sites edit dialog, taking CanvasText from the UA sheet, and Proton's urlbar result-menu button, where Nova's already carries the color. smartwindow-panel-list also gains the text counterpart of the button hover background it remaps into the panel's palette.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322595\n", "files": ["browser/components/aboutlogins/content/components/login-list-lit-item.css", "browser/components/aboutlogins/content/components/login-list.css", "browser/components/aiwindow/ui/components/ai-website-select/ai-website-select.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/smartwindow-history-menu/smartwindow-history-menu.css", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/genai/chat.css", "browser/components/genai/content/chatbot-promo.css", "browser/components/sidebar/sidebar-opentabs.css", "browser/components/sidebar/sidebar-tab-row.css", "browser/extensions/newtab/content-src/components/CustomizeMenu/_CustomizeMenu.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamAdmin/DiscoveryStreamAdmin.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/AdBannerContextMenu/AdBannerContextMenu.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/_DSCard.scss", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/SectionContextMenu/_SectionContextMenu.scss", "browser/extensions/newtab/content-src/components/DownloadModalToggle/_DownloadModalToggle.scss", "browser/extensions/newtab/content-src/components/WallpaperCategories/_WallpaperCategories.scss", "browser/extensions/newtab/content-src/components/Widgets/Lists/_Lists.scss", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/_PictureOfTheDay.scss", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/_SportsMatchRow.scss", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/content-src/styles/nova/_TopSites.scss", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/migration/migration-wizard.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css", "toolkit/components/aboutprocesses/content/aboutProcesses.css", "toolkit/components/aboutthirdparty/content/aboutThirdParty.css", "toolkit/components/satchel/megalist/content/megalist.css", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker-item.css", "toolkit/mozapps/extensions/content/components/mlmodel-card-header-additions.css", "toolkit/themes/shared/design-system/storybook/tokens-table.css"], "git_node": "cd9f0911c3a16630468d46f9e2c180498d0c843c", "git_parents": ["4e518ef68236b838dd23c1590584aefafeef3325"], "node": "ee6d10aae3de3c66286f7a55f2e9997d67308358", "parents": ["d40f492429a6f72c3677d6611ace8fa986e67c81"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068024 - Annotate the surfaces that cannot carry a text color (no functional change) r=hjones,desktop-theme-reviewers\n\nTab surfaces declare the background and the text color on different elements: .tab-background pairs with its sibling .tab-content, and the split view wrapper's active-tab tint sits above tabs that set their own. The prompt pill's fade overlay paints no text, a color on the trust panel's tracker container would recolor the shield beside the count, and about:config defines --toolbar-background-color as a local variable on a page that loads no token sheet, so the counterpart would not resolve. None is a deferred fix, so none carries a TODO.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322596\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/themes/shared/identity-block/identity-block.css", "browser/themes/shared/tabbrowser/tabs.css", "mobile/android/themes/geckoview/config.css"], "git_node": "ac0311aaf60b6874ebeafe4174f158b249df0943", "git_parents": ["cd9f0911c3a16630468d46f9e2c180498d0c843c"], "node": "4b0ea1a85387866eb65d5917bc5a05180fe69c47", "parents": ["ee6d10aae3de3c66286f7a55f2e9997d67308358"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068024 - Stylelint: create the no-background-without-text-color rule r=hjones,desktop-theme-reviewers\n\nThe rule ships `meta.fixable: false`; bug 2068773 adds the fix, holding it off on the annotated sites with the disable comment stylelint already honours for fixes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322597\n", "files": [".stylelintrc.js", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/no-background-without-text-color.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-paired-color-tokens.md", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/index.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/no-background-without-text-color.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/no-background-without-text-color.tests.mjs"], "git_node": "12eef3d296e59a5be7bc5451b3ac74d7ce095e9c", "git_parents": ["ac0311aaf60b6874ebeafe4174f158b249df0943"], "node": "c908031a1674da64f48ab76f8c88de6c8279764a", "parents": ["4b0ea1a85387866eb65d5917bc5a05180fe69c47"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068773 - Stylelint: autofix the missing text color where a block paints a token background r=hjones,desktop-theme-reviewers\n\nEvery site the rule reports already carries the counterpart or a disable comment, so --fix has nothing to rewrite in the tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323804\n", "files": ["docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/no-background-without-text-color.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-paired-color-tokens.md", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/no-background-without-text-color.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/no-background-without-text-color.tests.mjs"], "git_node": "6cd4886f47f80a3b41c7e6df25f7806007ba2fe2", "git_parents": ["12eef3d296e59a5be7bc5451b3ac74d7ce095e9c"], "node": "d9c3963cdc34aacff79a6988bb2279b017fab951", "parents": ["c908031a1674da64f48ab76f8c88de6c8279764a"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035971 - Make the moz-remote-image protocol preserve the instrinsic aspect ratio by default and add a stretch param. r=mak,urlbar-reviewers,tnikkel\n\nImage and protocol changes:\n\nAdd a `stretch` param to the protocol. When false (the default), treat the given\nsize as a maximum bound on the final size such that the image's intrinsic aspect\nratio is preserved. When true or when the image doesn't have an intrinsic size,\ntreat the given size as the desired final size and stretch the image, ignoring\nits intrinsic aspect ratio (if known).\n\nFront-end changes:\n\nI tried to keep these minimal in order to focus on the image changes and finally\nget those landed. There are two follow-ups I'd like to do, noted in the summary\nbelow.\n\nDefault `stretch` to true in the `getMozRemoteImageURL()` helper so that\nexisting callers aren't accidentally broken. There's at least one test,\n`browser_taskbarTabs_icons.js`, that asserts that the image is stretched. I'd\nlike for this to be a temporary thing and as a follow-up audit callers to make\nsure they can tolerate non-stretched images. That's why the protocol defaults to\nfalse but the front-end defaults to true. That's the first follow-up.\n\nI kept the single `size` param of `getMozRemoteImageURL()` even though separate\nwidth and height params would make more sense. That's the second follow-up. As\npart of that, I'd also like to move `getMozRemoteImageURL()` out of\n`FaviconUtils`. There are a lot of callers that don't use it for favicons.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297542\n", "files": ["browser/base/content/test/favicons/browser.toml", "browser/base/content/test/favicons/browser_favicon_svg.js", "browser/components/urlbar/UrlbarUtils.sys.mjs", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/PContent.ipdl", "image/remote/RemoteImageProtocolHandler.cpp", "image/remote/RemoteImageProtocolHandler.h", "image/test/browser/browser.toml", "image/test/browser/browser_remote_image_size.js", "image/test/browser/firebird_200x100.png", "image/test/browser/intrinsic_size_100x3000.svg", "image/test/browser/intrinsic_size_3000x100.svg", "image/test/browser/intrinsic_size_none.svg", "image/test/browser/intrinsic_size_none_viewBox_3000x100.svg", "toolkit/modules/FaviconUtils.sys.mjs"], "git_node": "3e7c069ee0d5da1041b1fe5d967b25c18c6b86bf", "git_parents": ["6cd4886f47f80a3b41c7e6df25f7806007ba2fe2"], "node": "fca0562169a66d409c6f8af742729f0722a3cbb9", "parents": ["d9c3963cdc34aacff79a6988bb2279b017fab951"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070284 - The customization panel should reset when closed r=Dre\n\nFix the wallpaper category and themes subpanels staying open across\nclosing and reopening the Customize panel. Bug 2037541 removed the\nreset that closed the wallpaper subpanel when the panel closed, and the\nthemes subpanel added in Bug 2056304 never had one.\n\nRather than reinstate the old code, this makes a modest refactor. The\nwallpaper subpanel's open state moves into Base next to the other three\nsubpanels, so all four are managed the same way and one method closes\nthem all once the dialog has finished closing.\n\nNew test coverage is in Jest; the two Enzyme files were only adjusted to\nkeep passing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324515\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/SectionsMgmtPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Nova/CustomizeMenu/WidgetsManagementPanel/WidgetsManagementPanel.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx"], "git_node": "e2214fb04226e8eea01a5bb4498d0cc289ee4e9d", "git_parents": ["3e7c069ee0d5da1041b1fe5d967b25c18c6b86bf"], "node": "195c280e44b2aa85492e0d976ee328b5981944c5", "parents": ["fca0562169a66d409c6f8af742729f0722a3cbb9"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2046257 - Add fence handling to AndroidImageReader r=gfx-reviewers,nical\n\nAImageReader needs to handle android fence on Android device.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323970\n", "files": ["gfx/layers/AndroidHardwareBuffer.h", "gfx/layers/AndroidImageConsumer.cpp", "gfx/layers/AndroidImageConsumer.h", "gfx/layers/AndroidImageReader.cpp", "gfx/layers/AndroidImageReader.h", "gfx/webrender_bindings/RenderAndroidImageReaderImageTextureHost.cpp", "gfx/webrender_bindings/RenderAndroidImageReaderImageTextureHost.h", "gfx/webrender_bindings/RenderCompositor.h", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/RenderCompositorEGL.h", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderTextureHostWrapper.cpp", "gfx/webrender_bindings/RenderTextureHostWrapper.h", "gfx/webrender_bindings/RendererOGL.cpp"], "git_node": "c2dd29c88ec75bf88632b0c335ef1d52221ad2ff", "git_parents": ["e2214fb04226e8eea01a5bb4498d0cc289ee4e9d"], "node": "8900416595467c64f32a17cc4d043bd8cbb475a9", "parents": ["195c280e44b2aa85492e0d976ee328b5981944c5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069386 - Draw the panel-list separator as a border. r=tgiles,desktop-theme-reviewers\n\nThe separator box shrinks to the line it draws. At fractional device pixel ratios the border paints one device pixel where the background covered 1.25 or 1.5 of them, so content below the separator moves up by the difference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323735\n", "files": ["toolkit/content/widgets/panel-list/panel-list.css"], "git_node": "72385745e8b7d6034f1c03d22a984ba5be7dfee9", "git_parents": ["c2dd29c88ec75bf88632b0c335ef1d52221ad2ff"], "node": "231b8f9d763f5de5a84fb2d0d518d6ce5dda46d1", "parents": ["8900416595467c64f32a17cc4d043bd8cbb475a9"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2068875 - Store GpuFenceMTLSharedEvent in CompositeProcessFencesHolderMap r=gfx-reviewers,bradwerth\n\nNecessary for  Bug 2068339.\n\nIt is for delivering GpuFence to RenderMacIOSurfaceTextureHost without re-creating RenderMacIOSurfaceTextureHost.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323499\n", "files": ["dom/canvas/WebGLContext.cpp", "dom/webgpu/ExternalTexture.cpp", "dom/webgpu/SharedTextureMacIOSurface.cpp", "dom/webgpu/SharedTextureMacIOSurface.h", "gfx/gl/GLBlitHelper.cpp", "gfx/gl/SharedSurface.h", "gfx/gl/SharedSurfaceIO.cpp", "gfx/gl/SharedSurfaceIO.h", "gfx/ipc/GPUParent.cpp", "gfx/layers/Fence.h", "gfx/layers/GpuFence.h", "gfx/layers/NativeLayer.h", "gfx/layers/NativeLayerCA.h", "gfx/layers/NativeLayerCA.mm", "gfx/layers/NativeLayerRemoteMac.h", "gfx/layers/NativeLayerRemoteMac.mm", "gfx/layers/NativeLayerWayland.h", "gfx/layers/ipc/CanvasTranslator.cpp", "gfx/layers/ipc/LayersSurfaces.ipdlh", "gfx/layers/opengl/MacIOSurfaceTextureClientOGL.cpp", "gfx/layers/opengl/MacIOSurfaceTextureHostOGL.cpp", "gfx/layers/opengl/MacIOSurfaceTextureHostOGL.h", "gfx/thebes/gfxPlatform.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.h", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.h", "gfx/webrender_bindings/RenderMacIOSurfaceTextureHost.cpp", "gfx/webrender_bindings/RenderMacIOSurfaceTextureHost.h"], "git_node": "68a713d7550dc59a7bfdd7dbfb6b6138a6d39432", "git_parents": ["72385745e8b7d6034f1c03d22a984ba5be7dfee9"], "node": "05faf47c92da817e9f6f3c25476852af28a729c9", "parents": ["231b8f9d763f5de5a84fb2d0d518d6ce5dda46d1"], "tags": []}, {"author": "Mathew Hodson \u003cmathew.hodson@gmail.com\u003e", "branch": "default", "desc": "Bug 207061