zdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Date/time-zones-imported.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js"], "git_node": null, "git_parents": [null], "node": "bb600bf2e951a54ddd79cd824c5b8210ae066c57", "parents": ["2d0e65aa1367e7ca75bd63865bed2885e69836b7"], "tags": []}], "date": 1661264982, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "68": {"changesets": [{"author": "Butkovits Atila \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset e0c24eb1e8d3 (bug 1783784) for causing build bustages. a=backout", "files": [".cargo/config.in", "Cargo.lock", "Cargo.toml", "third_party/rust/packed_simd_2/.cargo-checksum.json", "third_party/rust/packed_simd_2/Cargo.toml", "third_party/rust/packed_simd_2/README.md", "third_party/rust/packed_simd_2/build.rs", "third_party/rust/packed_simd_2/src/api.rs", "third_party/rust/packed_simd_2/src/codegen.rs", "third_party/rust/packed_simd_2/src/codegen/bit_manip.rs", "third_party/rust/packed_simd_2/src/codegen/llvm.rs", "third_party/rust/packed_simd_2/src/codegen/math.rs", "third_party/rust/packed_simd_2/src/codegen/math/float.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/abs.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/cos.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/cos_pi.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/exp.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/ln.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/mul_add.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/mul_adde.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/powf.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sin.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sin_cos_pi.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sin_pi.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sqrt.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sqrte.rs", "third_party/rust/packed_simd_2/src/codegen/pointer_sized_int.rs", "third_party/rust/packed_simd_2/src/codegen/reductions.rs", "third_party/rust/packed_simd_2/src/codegen/reductions/mask.rs", "third_party/rust/packed_simd_2/src/codegen/swap_bytes.rs", "third_party/rust/packed_simd_2/src/codegen/vPtr.rs", "third_party/rust/packed_simd_2/src/lib.rs", "third_party/rust/packed_simd_2/src/testing.rs"], "git_node": null, "git_parents": [null], "node": "53bb047fc03c2dfae9fa9525480f4db5233bbb6b", "parents": ["bb600bf2e951a54ddd79cd824c5b8210ae066c57"], "tags": []}], "date": 1661265983, "git_changesets": [null], "user": "abutkovits@mozilla.com"}, "69": {"changesets": [{"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1786555 - Add Bing ESR PC to test - r=Standard8 a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155400", "files": ["browser/components/search/test/browser/browser_searchEngine_behaviors.js"], "git_node": null, "git_parents": [null], "node": "6018fbc6359475b1df0bbe666f1b80c0fdf748f2", "parents": ["53bb047fc03c2dfae9fa9525480f4db5233bbb6b"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1782795 - Remove shared context from GlyphRasterizer. r=jnicol, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153503", "files": ["gfx/wr/webrender/src/glyph_rasterizer/mod.rs", "gfx/wr/webrender/src/platform/macos/font.rs", "gfx/wr/webrender/src/platform/unix/font.rs", "gfx/wr/webrender/src/platform/windows/font.rs"], "git_node": null, "git_parents": [null], "node": "cf8e58fd483c5112b7e539d4b51164179bd5de06", "parents": ["6018fbc6359475b1df0bbe666f1b80c0fdf748f2"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1783115 - Use only a single FT_Face for each font in WebRender. r=jnicol, a=RyanVM\n\nThis patch uses a single FT_Library for all font threads (even across separate windows)\nwithin WebRender. It maintains a mapping from FontTemplate to a cached FT_Face that will\nbe traded to any font thread that requests it on a first-come-first-serve basis. This\nFT_Face is guarded by a mutex to ensure that no other worker thread can use it while it\nis in-use by the first requesting thread.\n\nIn general it is safe to use different FT_Faces on different threads so long as they are\ndistinct. However, the snag in this is that FT_LcdFilter state is stored globally in the\nFT_Library, even while it is supplied per-FontInstance. To workaround this, we need to\nkeep track of how many threads are currently rasterizing glyphs with the FT_LcdFilter\nstate and wait for them to all finish before we can change the FT_LcdFilter to what\nthe next group of incoming jobs expects. FontContext::begin_rasterize/end_rasterize hooks\nwere added to support this. While there seems to be some support in newer FreeType\nversions for per-FT_Face LcdFilter settings, it doesn't allow disabling the LcdFilter\nor using legacy settings, so we are still suck using the global setting instead.\n\nTo further reduce memory usage, this patch also no longer allocates a separate FT_Face\nfor FontVariations. Instead, since the FT_Face must be locked to a single thread anyway,\nit now just uses FT_Set_Var_Design_Coordinates on the single FT_Face for the font before\nloading the batch of glyphs associated with the FontVariations. So regardless of how many\ndifferent variations are used for a font, it will only allocate a single FT_Face.\n\nNormally, rayon's par_iter is used to scatter glyphs from a single font request onto\nmultiple threads which works against the one-font-per-thread model needed here. This\nadds a FontContext::distribute_across_threads hook to control whether or not par_iter\nshould be used so that we can disable that behavior for this case, where instead we just\nwant to process each glyph serially within the scope of a single worker for a given\nfont request.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153715", "files": ["gfx/wr/webrender/src/glyph_rasterizer/mod.rs", "gfx/wr/webrender/src/platform/macos/font.rs", "gfx/wr/webrender/src/platform/unix/font.rs", "gfx/wr/webrender/src/platform/windows/font.rs"], "git_node": null, "git_parents": [null], "node": "dfa866a49ed64f401e5625eea6fc5a34571064e0", "parents": ["cf8e58fd483c5112b7e539d4b51164179bd5de06"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779005 - Avoid setting |mLoader| to null if we already start a new PAC load, r=necko-reviewers,valentin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154368", "files": ["netwerk/base/nsPACMan.cpp"], "git_node": null, "git_parents": [null], "node": "d4c10f0ca36753fde62468011579284f5e34d9cb", "parents": ["dfa866a49ed64f401e5625eea6fc5a34571064e0"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779005 - Use mLoadFailureCount as an indicator for PAC laod, r=necko-reviewers,valentin a=RyanVM\n\nSince IsLoading() is false when PAC request fails, we have to use something else to indicate that PAC is not available.\nmLoadFailureCount can be used in this case. It only reset when PAC request is succeeded and when reloading a PAC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154907", "files": ["netwerk/base/nsPACMan.cpp", "netwerk/test/unit/test_pac_reload_after_network_change.js", "netwerk/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "fb7f2596831b5c22fe7946a5deb24ef68e01db62", "parents": ["d4c10f0ca36753fde62468011579284f5e34d9cb"], "tags": []}], "date": 1661276789, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "70": {"changesets": [{"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1772290 - tests, r=smaug a=test-only\n\nDepends on D146914\n\nDifferential Revision: https://phabricator.services.mozilla.com/D146915", "files": ["docshell/test/browser/browser.ini", "docshell/test/browser/browser_csp_sandbox_no_script_js_uri.js", "docshell/test/browser/file_csp_sandbox_no_script_js_uri.html", "docshell/test/browser/file_csp_sandbox_no_script_js_uri.html^headers^"], "git_node": null, "git_parents": [null], "node": "5390f307388a44e368dcc86dcef3c7e4d572b3e6", "parents": ["fb7f2596831b5c22fe7946a5deb24ef68e01db62"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1783784 - Update packed_simd_2 to 0.3.8.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154063", "files": [".cargo/config.in", "Cargo.lock", "Cargo.toml", "third_party/rust/packed_simd_2/.cargo-checksum.json", "third_party/rust/packed_simd_2/Cargo.toml", "third_party/rust/packed_simd_2/README.md", "third_party/rust/packed_simd_2/build.rs", "third_party/rust/packed_simd_2/src/api.rs", "third_party/rust/packed_simd_2/src/codegen.rs", "third_party/rust/packed_simd_2/src/codegen/bit_manip.rs", "third_party/rust/packed_simd_2/src/codegen/llvm.rs", "third_party/rust/packed_simd_2/src/codegen/math.rs", "third_party/rust/packed_simd_2/src/codegen/math/float.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/abs.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/cos.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/cos_pi.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/exp.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/ln.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/mul_add.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/mul_adde.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/powf.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sin.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sin_cos_pi.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sin_pi.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sqrt.rs", "third_party/rust/packed_simd_2/src/codegen/math/float/sqrte.rs", "third_party/rust/packed_simd_2/src/codegen/pointer_sized_int.rs", "third_party/rust/packed_simd_2/src/codegen/reductions.rs", "third_party/rust/packed_simd_2/src/codegen/reductions/mask.rs", "third_party/rust/packed_simd_2/src/codegen/swap_bytes.rs", "third_party/rust/packed_simd_2/src/codegen/vPtr.rs", "third_party/rust/packed_simd_2/src/lib.rs", "third_party/rust/packed_simd_2/src/testing.rs"], "git_node": null, "git_parents": [null], "node": "4598f299a274552d9ce75af82bc5c35769cf5d24", "parents": ["5390f307388a44e368dcc86dcef3c7e4d572b3e6"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1784835. Use checkedint in webp encoder to avoid overflow. r=aosmond, a=RyanVM", "files": ["image/encoders/webp/nsWebPEncoder.cpp"], "git_node": null, "git_parents": [null], "node": "e773b8e40a33a840ab5e42deb3a1d901da503b4a", "parents": ["4598f299a274552d9ce75af82bc5c35769cf5d24"], "tags": []}], "date": 1661363070, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "71": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155574", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "cf1f0cc5399be1ee2f9d8a48c1c6736ab520c4c3", "parents": ["e773b8e40a33a840ab5e42deb3a1d901da503b4a"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774453: Disable hiding cursor while typing on Windows. r=cpeterson, a=RyanVM\n\nThere are compat issues with the approach.  There are future plans to restore the functionality but only when typing into a text area.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155275", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "d84502c5fb3a5fd4574fd1d433f64b9d5b4704ae", "parents": ["cf1f0cc5399be1ee2f9d8a48c1c6736ab520c4c3"], "tags": []}], "date": 1661441328, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "72": {"changesets": [{"author": "Sergey Galich \u003csgalich@mozilla.com\u003e", "branch": "default", "desc": "Bug 1559205, 1611093, 1748828 - support moz-proxy in about:logins r=dimi a=RyanVM\n\nUri.host throws when scheme is moz-proxy://\nThis leads to a series of bugs on about:logins when creating or editing moz-proxy URLs.\n\nThis patch is supposed to close bug 1559205, bug 1611093 and bug 1748828.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154925", "files": ["toolkit/components/passwordmgr/LoginHelper.jsm", "toolkit/components/passwordmgr/test/unit/test_getPasswordOrigin.js"], "git_node": null, "git_parents": [null], "node": "c7d4cb4d978b4c3bd514305b6841056f91b077a5", "parents": ["d84502c5fb3a5fd4574fd1d433f64b9d5b4704ae"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1782211 - Init feature policy; r=ckerschb, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154161", "files": ["docshell/base/nsDocShell.cpp", "dom/base/Document.cpp", "dom/base/Document.h"], "git_node": null, "git_parents": [null], "node": "2c575ebba33d377025b7f0acfc04a5994f80575d", "parents": ["c7d4cb4d978b4c3bd514305b6841056f91b077a5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1785186 - Use zero threshold for lazyload observer. r=hiro, a=RyanVM\n\nThis matches WebKit, and the spec:\n\n  https://html.spec.whatwg.org/#lazy-load-intersection-observer\n\nBlink has very weird behavior where it treats a zero-area intersection\nin this particular case with an intersectionRatio of one:\nhttps://bugs.chromium.org/p/chromium/issues/detail?id=1356250\n\nWhich causes them to load the image even though they have a\nnumeric_limits::min threshold.\n\nSo this works in Chromium by chance, but should work per spec.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155501", "files": ["dom/base/DOMIntersectionObserver.cpp", "testing/web-platform/tests/html/semantics/embedded-content/the-img-element/image-loading-lazy-zero-intersection-area.html"], "git_node": null, "git_parents": [null], "node": "aa6f13881478887ff8b62813040a761d0c95be7a", "parents": ["2c575ebba33d377025b7f0acfc04a5994f80575d"], "tags": []}], "date": 1661736752, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "73": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155829", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "e94f6792810a0d440ce164c7c6b72d57ec666e45", "parents": ["aa6f13881478887ff8b62813040a761d0c95be7a"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1787674 - Snap: Run `apt-get update` before downloading apt packages. r=jcristau, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155823", "files": ["taskcluster/docker/firefox-snap/runme.sh"], "git_node": null, "git_parents": [null], "node": "5fbbab4a30abd90edb7559976d31f331d27ac26c", "parents": ["e94f6792810a0d440ce164c7c6b72d57ec666e45"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1781759 factor out ChannelMediaResource::MediaElement() helper r=chunmin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154039", "files": ["dom/media/ChannelMediaResource.cpp", "dom/media/ChannelMediaResource.h"], "git_node": null, "git_parents": [null], "node": "12a6e769cb419327b8dbc7f7a8bbeda79c797c11", "parents": ["5fbbab4a30abd90edb7559976d31f331d27ac26c"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1781759 use media element node principal instead of channel loading principal for cross-origin resource test r=padenot a=RyanVM\n\nWhen the media resource is loaded as a document, the response from the initial\ndocument load gets reused, as an optimization, as an emulated load for the\nresource of the media host element in the generated HTML document.\nhttps://searchfox.org/mozilla-central/rev/5644fae86d5122519a0e34ee03117c88c6ed9b47/dom/html/VideoDocument.cpp#114\nhttps://html.spec.whatwg.org/multipage/browsing-the-web.html#read-media\nThe loadingPrincipal of the initial channel comes from the parent document,\nand so is not useful to determine whether the response is cross-origin with\nthe media element.\n\nThis change makes the cross-origin test on the initial document load\nconsistent with subsequent requests on the same resource and non-document\nloads, which already use the node principal for the loadingPrincipal.\nhttps://searchfox.org/mozilla-central/rev/1061fae5e225a99ef5e43dbdf560a91a0c0d00d1/dom/media/ChannelMediaResource.cpp#750\nhttps://searchfox.org/mozilla-central/rev/4f2984be127d2e7c788cf1848d63dca63022beec/dom/html/HTMLMediaElement.cpp#1708\n\nDepends on D154039\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154040", "files": ["dom/media/ChannelMediaResource.cpp"], "git_node": null, "git_parents": [null], "node": "e73a7cfc006eb91869903011b5486f68446c3b59", "parents": ["12a6e769cb419327b8dbc7f7a8bbeda79c797c11"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1781759 Test cross origin load of media document in parts r=chunmin a=RyanVM\n\nDepends on D154040\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154041", "files": ["testing/web-platform/tests/html/browsers/browsing-the-web/read-media/cross-origin-video.html", "testing/web-platform/tests/html/browsers/browsing-the-web/read-media/resources/iframe-document.sub.html"], "git_node": null, "git_parents": [null], "node": "075e4be3af876c1a75243fb6e7a6e9a6024d85fa", "parents": ["e73a7cfc006eb91869903011b5486f68446c3b59"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1781063 don't use tainting for cross-origin check on document media resource loads r=chunmin a=RyanVM\n\nWhen the media resource is loaded as a document, the response from the initial\ndocument load gets reused, as an optimization, as an emulated load for the\nresource of the media host element in the generated HTML document.\nhttps://searchfox.org/mozilla-central/rev/5644fae86d5122519a0e34ee03117c88c6ed9b47/dom/html/VideoDocument.cpp#114\nhttps://html.spec.whatwg.org/multipage/browsing-the-web.html#read-media\n\nDepends on D154041\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154042", "files": ["dom/media/ChannelMediaResource.cpp"], "git_node": null, "git_parents": [null], "node": "e5979bcbc3508987d4d24126c8404e5f6f8a5b6b", "parents": ["075e4be3af876c1a75243fb6e7a6e9a6024d85fa"], "tags": []}], "date": 1661784201, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "74": {"changesets": [{"author": "Chris Martin \u003ccmartin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1776655 - Allocate input report context for each gamepad. r=mccr8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152938", "files": ["dom/gamepad/cocoa/CocoaGamepad.cpp"], "git_node": null, "git_parents": [null], "node": "422edad7d6e9e68bf9dd409f655003f54767e349", "parents": ["e5979bcbc3508987d4d24126c8404e5f6f8a5b6b"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777209 - Use DrawSurface rather than FillRect to paint \u003ccanvas\u003e, and don't use EXTEND_PAD when writing to PDF. r=jrmuizel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150601", "files": ["gfx/2d/DrawTargetCairo.cpp", "layout/generic/nsHTMLCanvasFrame.cpp", "layout/reftests/bugs/reftest.list"], "git_node": null, "git_parents": [null], "node": "7c1c700c6f368ed74c815f99ba9e2b5e689b69d0", "parents": ["422edad7d6e9e68bf9dd409f655003f54767e349"], "tags": []}], "date": 1661864221, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "75": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156169", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "30149d86242c71f94667cdd386c8eef13258f6ba", "parents": ["7c1c700c6f368ed74c815f99ba9e2b5e689b69d0"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1767360 - use correct image size retrieved from the output type to create video frames buffer. r=media-playback-reviewers,jolin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154310", "files": ["dom/media/platforms/wmf/WMFVideoMFTManager.cpp", "dom/media/platforms/wmf/WMFVideoMFTManager.h"], "git_node": null, "git_parents": [null], "node": "e9d94bf2aced06f1dec2b8fc8de8cce3fe4674af", "parents": ["30149d86242c71f94667cdd386c8eef13258f6ba"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1768671 - force append '.pdf' for pdf blob downloads displayed inline if it's missing, r=marco a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151890", "files": ["toolkit/components/pdfjs/content/PdfStreamConverter.jsm", "toolkit/components/pdfjs/test/browser.ini", "toolkit/components/pdfjs/test/browser_pdfjs_nonpdf_filename.js"], "git_node": null, "git_parents": [null], "node": "47f3eb0e15e0260d5d526cb256899d0849fca2b5", "parents": ["e9d94bf2aced06f1dec2b8fc8de8cce3fe4674af"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1780348 - Exit fullscreen if DOMFullscreenChild is not able to continue the fullscreen transition; r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153807", "files": ["browser/actors/DOMFullscreenChild.jsm"], "git_node": null, "git_parents": [null], "node": "4894228dde3bb51f8aec3eb90e849476a2debb2e", "parents": ["47f3eb0e15e0260d5d526cb256899d0849fca2b5"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1784183. Initialize nsWindow::mPanInProgress. r=rmader, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154331", "files": ["widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "6ba85d17ae013956bfe3f5f9e6c6b4e346b9ab50", "parents": ["4894228dde3bb51f8aec3eb90e849476a2debb2e"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1784387 - Crash in [@ nsDocShell::Reload] in ContentChild::RecvReload, r=mccr8 a=RyanVM\n\nNo test, since the patch is based on the crash reports. Creating a test which relies on some race conditions through IPC is hard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154634", "files": ["docshell/base/nsDocShell.cpp"], "git_node": null, "git_parents": [null], "node": "487d3935117ba0afcd971e2688474614b9df904d", "parents": ["6ba85d17ae013956bfe3f5f9e6c6b4e346b9ab50"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774155 - Avoid copying data URI specs in deprecation warning. r=mccr8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154692", "files": ["dom/bindings/BindingUtils.cpp", "dom/reporting/tests/common_deprecated.js", "dom/reporting/tests/test_deprecated.html"], "git_node": null, "git_parents": [null], "node": "cb9e41e805ee08a2d0dc4d1e99e2bc5d90e13f5d", "parents": ["487d3935117ba0afcd971e2688474614b9df904d"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1787684. Only return views with widgets from FindFloatingViewContaining. r=emilio, a=RyanVM\n\nThe code that bug 1754436 deleted checked to make sure there was a widget for the returned view, but it looks like it's possible in some edge cases to have an open popup that doesn't have a widget (most likely just for a split second). We need a widget to dispatch the event, and if it doesn't have a widget it's not visible so no point in touching it at all anyways.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155819", "files": ["layout/base/PresShell.cpp", "layout/base/nsLayoutUtils.cpp", "layout/base/nsLayoutUtils.h"], "git_node": null, "git_parents": [null], "node": "872373bc197f1c22c874c6aa46154007c3d74f0c", "parents": ["cb9e41e805ee08a2d0dc4d1e99e2bc5d90e13f5d"], "tags": []}], "date": 1662050546, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "76": {"changesets": [{"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1777604 - wasm: Perform a pipeline flush while creating a module object. r=nbp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152304", "files": ["js/src/jit/FlushICache.h", "js/src/jit/arm/Architecture-arm.cpp", "js/src/jit/arm64/Architecture-arm64.cpp", "js/src/jit/arm64/vixl/Cpu-vixl.h", "js/src/jit/arm64/vixl/MozCpu-vixl.cpp", "js/src/wasm/WasmJS.cpp"], "git_node": null, "git_parents": [null], "node": "aa292e0b176b0ffbd3064519863077f46ac24774", "parents": ["872373bc197f1c22c874c6aa46154007c3d74f0c"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 1777604 - wasm: Move membarrier call to separate functions. r=nbp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152305", "files": ["js/src/jit/AutoWritableJitCode.h", "js/src/jit/ExecutableAllocator.h", "js/src/jit/FlushICache.cpp", "js/src/jit/FlushICache.h", "js/src/jit/ProcessExecutableMemory.cpp", "js/src/jit/ProcessExecutableMemory.h", "js/src/jit/arm/Architecture-arm.cpp", "js/src/jit/arm64/Architecture-arm64.cpp", "js/src/jit/arm64/vixl/Cpu-vixl.h", "js/src/jit/arm64/vixl/MozCpu-vixl.cpp", "js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/mips-shared/Architecture-mips-shared.cpp", "js/src/jit/moz.build", "js/src/jsapi-tests/testsJit.cpp", "js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmCode.cpp", "js/src/wasm/WasmCode.h", "js/src/wasm/WasmCompile.cpp", "js/src/wasm/WasmModule.cpp"], "git_node": null, "git_parents": [null], "node": "e84c033070c9c495e90676862cae753bc04ab8e1", "parents": ["aa292e0b176b0ffbd3064519863077f46ac24774"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez  \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1783415 - Don't use custom styling of select in chrome pages. r=mconley, a=RyanVM\n\nAssume default styles fit well enough. This prevents confusing colors from\napplying, since in the described case we pick the hovered select background,\nbut then override the options to use the unhovered background...\n\nWith short selects (like the ones that have only two options), that may cause\nthe wrong impression. A bit tricky!\n\nThis repros for me on win10, for what is worth.", "files": ["toolkit/actors/SelectChild.jsm", "toolkit/actors/SelectParent.jsm"], "git_node": null, "git_parents": [null], "node": "11f8c4fa667772a0c56e7a4be0a751869ac22b58", "parents": ["e84c033070c9c495e90676862cae753bc04ab8e1"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1784432 - allow opening list all tabs menu using the keyboard, r=mhowell a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155868", "files": ["browser/base/content/browser-allTabsMenu.js", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/base/content/test/tabs/browser.ini", "browser/base/content/test/tabs/browser_tab_manager_keyboard_access.js"], "git_node": null, "git_parents": [null], "node": "54a431be0bbe4d4e1ad013c31d761621686543fe", "parents": ["11f8c4fa667772a0c56e7a4be0a751869ac22b58"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1770094 r=freddyb,emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154518", "files": ["dom/html/HTMLFormSubmission.cpp", "dom/html/HTMLSharedElement.cpp", "dom/interfaces/security/nsIContentSecurityPolicy.idl", "dom/security/nsCSPContext.cpp", "parser/html/nsHtml5TreeOpExecutor.cpp"], "git_node": null, "git_parents": [null], "node": "7b43b4ab4275960ba8e3bb936a7c10ccd6ca490a", "parents": ["54a431be0bbe4d4e1ad013c31d761621686543fe"], "tags": []}], "date": 1662123612, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "77": {"changesets": [{"author": "Calixte \u003ccdenizet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1766030 - Add an optional source URL when saving an URL. r=Gijs, a=RyanVM\n\nIn pdf.js, files are saved thanks to a blob but the original URL is lost.\nConsequently, the download panel doesn't contain any information about the\norigins of a saved pdf.\nThe saveURL, internalSave and nsITransfer.init functions has now a parameter for this originalURL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147651", "files": ["browser/base/content/browser.js", "browser/base/content/nsContextMenu.js", "browser/base/content/pageinfo/pageInfo.js", "browser/base/content/utilityOverlay.js", "browser/components/downloads/DownloadsCommon.jsm", "browser/components/downloads/content/indicator.js", "devtools/startup/DevToolsStartup.jsm", "toolkit/components/downloads/DownloadCore.jsm", "toolkit/components/downloads/DownloadLegacy.jsm", "toolkit/components/downloads/test/unit/head.js", "toolkit/components/pdfjs/content/PdfStreamConverter.jsm", "toolkit/components/pdfjs/content/PdfjsParent.jsm", "toolkit/components/pdfjs/test/browser_pdfjs_download_button.js", "toolkit/content/contentAreaUtils.js", "toolkit/content/tests/browser/browser_saveImageURL.js", "toolkit/content/tests/browser/browser_save_resend_postdata.js", "uriloader/base/nsITransfer.idl", "uriloader/exthandler/nsExternalHelperAppService.cpp"], "git_node": null, "git_parents": [null], "node": "778f4b2173c689ce117b7dd3d5a79b87d5b7135d", "parents": ["7b43b4ab4275960ba8e3bb936a7c10ccd6ca490a"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1761265, don't show the downloads panel when a download was started by user action that they expect will save the file, r=mhowell,kershaw a=RyanVM\n\nThe download panel should still appear when clicking on download links or those with content-disposition: attachment\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147875", "files": ["browser/components/downloads/test/browser/browser.ini", "browser/components/downloads/test/browser/browser_downloads_panel_dontshow.js", "dom/webbrowserpersist/nsWebBrowserPersist.cpp", "netwerk/base/LoadInfo.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/TRRLoadInfo.cpp", "netwerk/base/nsILoadInfo.idl", "toolkit/components/downloads/DownloadCore.jsm", "toolkit/components/pdfjs/test/browser_pdfjs_download_button.js"], "git_node": null, "git_parents": [null], "node": "d5a4ffd1e66648681537540ac1cc247ddcaa82c3", "parents": ["778f4b2173c689ce117b7dd3d5a79b87d5b7135d"], "tags": []}, {"author": "Shane Hughes \u003cshmediaproductions@gmail.com\u003e", "branch": "default", "desc": "Bug 1739348 - Don't open downloads panel after download dialogs. r=NeilDeakin, a=RyanVM\n\nThis is a medium sized patch to legacy download construction. It takes\nadvantage of the new property added in Bug 1762033 to prevent the\ndownloads panel from being automatically shown when a download is added\nafter an interaction with the unknown content type dialog or the file\npicker dialog. I chose to not do the same for failed transfers since I\nthought it might serve some use, but that might be wrong. I don't know\nif there's a way to test the dialog that appears when you download an\nexecutable without going through the same path I adjusted with the\npatch. It seems like it's covered but I could be wrong. Also add a test\nto cover these changes from the bottom up. Thanks and apologies for my\nsloppy C++, though I'm sure I'll learn a lot more from the review \ud83d\ude05\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145312", "files": ["browser/components/downloads/DownloadsCommon.jsm", "browser/components/downloads/test/browser/browser.ini", "browser/components/downloads/test/browser/browser_downloads_panel_opens.js", "browser/components/downloads/test/browser/browser_tempfilename.js", "toolkit/components/downloads/DownloadLegacy.jsm", "toolkit/components/pdfjs/test/browser_pdfjs_download_button.js", "toolkit/mozapps/downloads/HelperAppDlg.jsm", "uriloader/base/nsITransfer.idl", "uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/nsExternalHelperAppService.h", "uriloader/exthandler/nsIExternalHelperAppService.idl", "uriloader/exthandler/tests/mochitest/browser_open_internal_choice_persistence.js"], "git_node": null, "git_parents": [null], "node": "ada978675f633128b0cb63eb2078cbccc873f3ef", "parents": ["d5a4ffd1e66648681537540ac1cc247ddcaa82c3"], "tags": []}, {"author": "Shane Hughes \u003cshmediaproductions@gmail.com\u003e", "branch": "default", "desc": "Bug 1783643 - Don't open downloads panel if window is inactive. r=Gijs, a=RyanVM\n\nSince bug 1741076, the downloads panel is already configured not to show\nthe downloads panel if the top chrome window is inactive. However, this\ncheck doesn't matter if the downloads panel has never been opened before\nin the profile (represented by pref browser.download.panel.shown). This\npatch changes the check so that if the top window is not active, we\ndon't show the panel, no matter what.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153334", "files": ["browser/components/downloads/DownloadsCommon.jsm"], "git_node": null, "git_parents": [null], "node": "c700291622295f184dcaea8861dcfdf1698b0744", "parents": ["ada978675f633128b0cb63eb2078cbccc873f3ef"], "tags": []}, {"author": "Calixte \u003ccdenizet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1778714 - Fix the pdf download link in the All Downloads view. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151431", "files": ["browser/components/downloads/content/allDownloadsView.js", "toolkit/components/pdfjs/test/browser_pdfjs_download_button.js"], "git_node": null, "git_parents": [null], "node": "b87d48b3714d52e296d92e96c7ebd80a6437b725", "parents": ["c700291622295f184dcaea8861dcfdf1698b0744"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1759604, check CanDropLink during the drop event as sites can cancel the dragover event causing the drop event to still fire, r=arai a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154896", "files": ["docshell/base/nsDocShellTreeOwner.cpp", "dom/events/test/browser.ini", "dom/events/test/browser_dragimage.js", "dom/events/test/dragimage.html", "dom/events/test/green.png", "testing/mochitest/tests/SimpleTest/EventUtils.js", "toolkit/content/widgets/browser-custom-element.js"], "git_node": null, "git_parents": [null], "node": "15c3a30c8735a9114c12d41a303fe3d1430f58d8", "parents": ["b87d48b3714d52e296d92e96c7ebd80a6437b725"], "tags": []}], "date": 1662145560, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "78": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156430", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f9b431213aec006ee3b72aebf8bb7bf1c3fe26aa", "parents": ["15c3a30c8735a9114c12d41a303fe3d1430f58d8"], "tags": []}], "date": 1662393801, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "79": {"changesets": [{"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1772988, add some additional extensions for some media types as Windows doesn't provide some of them, causing valid extensions to be replaced when saving files, r=mhowell, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155972", "files": ["uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/tests/unit/test_filename_sanitize.js"], "git_node": null, "git_parents": [null], "node": "e1094621add168700c4edf13799e9c5be8a76ed9", "parents": ["f9b431213aec006ee3b72aebf8bb7bf1c3fe26aa"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1786502 - Lock access to DeviceInfo devicechange callbacks. r=webrtc-reviewers,jib a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155365", "files": ["dom/media/systemservices/CamerasParent.h", "third_party/libwebrtc/modules/video_capture/video_capture.h"], "git_node": null, "git_parents": [null], "node": "3cab427780c7e02e960045c7277bb54c717a114f", "parents": ["e1094621add168700c4edf13799e9c5be8a76ed9"], "tags": []}, {"author": "Calixte \u003ccdenizet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1780839 - Update pdf.js to bf000687313b08924186f9f35a604f8cce27bd1d in ESR102. r=marco, a=RyanVM\n\n- bug 1778692: cherry-pick 8f26ba54875ac0730fe72328301085fbb456898a\n- bug 1777693: cherry-pick 6c9e538f5621a554c867123c57b34a9493ec646a\n- fix test toolkit/components/pdfjs/test/browser_pdfjs_js.js\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156417", "files": ["toolkit/components/pdfjs/content/PdfJsDefaultPreferences.jsm", "toolkit/components/pdfjs/content/build/pdf.js", "toolkit/components/pdfjs/content/build/pdf.scripting.js", "toolkit/components/pdfjs/content/build/pdf.worker.js", "toolkit/components/pdfjs/content/web/debugger.js", "toolkit/components/pdfjs/content/web/images/toolbarButton-editorFreeText.svg", "toolkit/components/pdfjs/content/web/images/toolbarButton-editorInk.svg", "toolkit/components/pdfjs/content/web/images/toolbarButton-editorNone.svg", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.html", "toolkit/components/pdfjs/content/web/viewer.js", "toolkit/components/pdfjs/moz.yaml", "toolkit/components/pdfjs/test/browser_pdfjs_js.js"], "git_node": null, "git_parents": [null], "node": "a433475f604c0d5b0099be15580d4b2d1a6c568b", "parents": ["3cab427780c7e02e960045c7277bb54c717a114f"], "tags": []}, {"author": "Bernard Igiri \u003cbigiri@mozilla.com\u003e", "branch": "default", "desc": "Bug 1776222 - Disable fullscreen on audio tags. r=jaws, a=RyanVM\n\nDisabling fullscreen on audio tags so that double clicking does not cause those tags to display as full screen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152564", "files": ["toolkit/content/tests/widgets/mochitest.ini", "toolkit/content/tests/widgets/test_videocontrols.html", "toolkit/content/tests/widgets/test_videocontrols_audio.html", "toolkit/content/widgets/videocontrols.js"], "git_node": null, "git_parents": [null], "node": "d64e15c55783ca957ce3ebb4dc71b0dc72247cb1", "parents": ["a433475f604c0d5b0099be15580d4b2d1a6c568b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1785801 - Make `RangeUpdater::SelAdjJoinNodes` take the ex-offset of right node. r=m_kato, a=RyanVM\n\nIn bug 1739524, I misunderstood the meaning of `aOffset` of `SelAdjJoinNodes`.\n\nAfter joining 2 nodes, and a point points right node which will have ex-left\nnode content, the point needs to point ex-start of the right node to keep\nnext insertion point as-is.  Therefore, it's not useful with new join nodes\ndirection, it needs to know the ex-offset of the right node.\n\nThis is a backport patch of https://phabricator.services.mozilla.com/D155438 for\nESR 102.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156271", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/SelectionState.cpp", "editor/libeditor/SelectionState.h", "testing/web-platform/tests/editing/data/inserttext.js"], "git_node": null, "git_parents": [null], "node": "484dbd3856dc7efa79d7696b4010ea52314b2332", "parents": ["d64e15c55783ca957ce3ebb4dc71b0dc72247cb1"], "tags": []}], "date": 1662489460, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "80": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1780839 - Fix browser_parsable_css.js failures. a=bustage DONTBUILD\n\nThis was removed in bug 1774017 and got missed in the uplift patch.", "files": ["browser/base/content/test/static/browser_parsable_css.js"], "git_node": null, "git_parents": [null], "node": "b0778ce4c218af76434ce8e427e9297a434740a2", "parents": ["484dbd3856dc7efa79d7696b4010ea52314b2332"], "tags": []}], "date": 1662499532, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "81": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1755700: Use StartAudioSession and StopAudioSession symmetrically r=cmartin, a=RyanVM\n\nMoves StopAudioSession earlier -- to nsAppShell::Run -- where we call StartAudioSession.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152299", "files": ["toolkit/xre/nsAppRunner.cpp", "widget/windows/nsAppShell.cpp"], "git_node": null, "git_parents": [null], "node": "a8a4a0687b090f225b8171a84206d97946a4f34b", "parents": ["b0778ce4c218af76434ce8e427e9297a434740a2"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1755700: Simplify ownership of AudioSession r=cmartin, a=RyanVM\n\nConcurrent operations in the MTA make the required lifetime of the AudioSession complex.  In particular, it cannot be known when/if any methods are currently queued or being executed (in particular, Start).  In order to make this safe, we keep the AudioSession at least as long as XPCOM is running background threads.\n\nThis patch also removes a long-defunct state machine and does some basic code cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152300", "files": ["widget/windows/AudioSession.cpp"], "git_node": null, "git_parents": [null], "node": "469da3104d9f118056edbdb29c76efd5b5c2e4e7", "parents": ["a8a4a0687b090f225b8171a84206d97946a4f34b"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1755700: Use AgileReference for cross-apartment AudioSessionControl use r=Jamie, a=RyanVM\n\nA deadlock issue with our main thread audio playback handling arises when we try to destroy the AudioSessionControl from the MTA, despite it being an MTA object.  We therefore dispatch its destruction to the main thread (STA) so the deadlock is impossible.  In order to use it from the STA, we should wrap it in an AgileReference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152301", "files": ["widget/windows/AudioSession.cpp"], "git_node": null, "git_parents": [null], "node": "d5ca441c05ba44f0f60142fe6690b8a0936ffe0c", "parents": ["469da3104d9f118056edbdb29c76efd5b5c2e4e7"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1755700: Serialize IAudioSessionControl destruction/re-creation r=cmartin, a=RyanVM\n\nDestroying the IAudioSessionControl has concurrency issues with audio playback that require it to be done on the main thread.  We have been trying to create a new AudioSessionControl on a background thread while this happens but some AudioSessionControl internals/dependencies are not thread safe.  In order to avoid concurrency crashes, we destroy the old IAudioSessionControl on the main thread, then dispatch the restart to a background (MTA) thread asynchronously.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152302", "files": ["widget/windows/AudioSession.cpp"], "git_node": null, "git_parents": [null], "node": "a6079f152b7db486e2511bec0ee99c0051398ae7", "parents": ["d5ca441c05ba44f0f60142fe6690b8a0936ffe0c"], "tags": []}, {"author": "Masatoshi Kimura \u003cVYV03354@nifty.ne.jp\u003e", "branch": "default", "desc": "Bug 1787633 - Make nsTextToSubURI::UnEscapeNonAsciiURI static. r=m_kato, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156007", "files": ["dom/jsurl/nsJSProtocolHandler.cpp", "intl/uconv/moz.build", "intl/uconv/nsITextToSubURI.idl", "intl/uconv/nsTextToSubURI.cpp", "intl/uconv/nsTextToSubURI.h", "uriloader/exthandler/win/nsMIMEInfoWin.cpp"], "git_node": null, "git_parents": [null], "node": "c581112d97d4033ef541a65a10d1efe3b3f554a6", "parents": ["a6079f152b7db486e2511bec0ee99c0051398ae7"], "tags": []}], "date": 1662557243, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "82": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156816", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "51bcad9d99c294d82c30951710ee551677e3ea4b", "parents": ["c581112d97d4033ef541a65a10d1efe3b3f554a6"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1777574, automate CC zone handling, r=mccr8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156605", "files": ["accessible/aom/AccessibleNode.h", "devtools/shared/heapsnapshot