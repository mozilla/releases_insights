iles": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policies_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "7adee0d5b798062a4105927eb08f69b46748fb0c", "parents": ["2461c3f80f8d301faf0719149be63caf8bab5ae7"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1526439 - Add an enteprise policy for extension updates. r=Felipe,flod, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D19200", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policies_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "3fcb4a70f5914c7d83cc1c4e6117e004c90315de", "parents": ["7adee0d5b798062a4105927eb08f69b46748fb0c"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1538619 - TransactionDatabaseOperationBase::SendFailureResult not called if the actor has been destroyed; r=asuth, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D24744", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "fac75272fedd047fc45bf86bdef543d2f8974cb4", "parents": ["3fcb4a70f5914c7d83cc1c4e6117e004c90315de"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1545120 - Simplify this callback management stuff a little. r=froydnj, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D28390", "files": ["xpcom/threads/nsTimerImpl.cpp", "xpcom/threads/nsTimerImpl.h"], "git_node": null, "git_parents": [null], "node": "d44b551abaf9141cbf6e125dc8c9edd63be8f47f", "parents": ["fac75272fedd047fc45bf86bdef543d2f8974cb4"], "tags": []}], "date": 1556545324, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "401": {"changesets": [{"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "merge d44b551abaf9 (tip end of April 2019) to THUNDERBIRD_60_VERBRANCH. a=jorgk", "files": ["taskcluster/ci/release-mark-as-started/kind.yml", "taskcluster/taskgraph/transforms/release_mark_as_started.py", "taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null, null], "node": "ca01221584b28d6dee81ecb6d07e640a135a78e4", "parents": ["ac46edc9c4223fb6613501d3287705f49d1dfc57", "d44b551abaf9141cbf6e125dc8c9edd63be8f47f"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "Bug 1539110 - Make HTMLEditor::RemoveStyleInside() and HTMLEditor::SplitStyleAbovePoint() check tag names with whitelist. r=m_kato a=jorgk DONTBUILD\n\n`document.execCommand(\"removeformat\")` removes any elements in the range which\nare editable, not `\u003ca\u003e`, not block and a container.\nhttps://searchfox.org/mozilla-central/rev/dd7e27f4a805e4115d0dbee70e1220b23b23c567/editor/libeditor/HTMLStyleEditor.cpp#760-763\n\nThis means that it removes hidden elements like `\u003cscript\u003e` and `\u003cstyle\u003e`,\nor non-HTML elements like SVG elements.  However, the unofficial document\nof `execCommand()` lists up elements which should be handled by the command.\nhttps://w3c.github.io/editing/execCommand.html#removeformat-candidate\n\nAdditionally, Chrome respects this list since not including `\u003cdel\u003e` element\ninto the list does not make sense but Chrome ignores it.  So, we should\nrespect the list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27018", "files": ["editor/libeditor/HTMLEditUtils.cpp", "editor/libeditor/HTMLEditUtils.h", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLStyleEditor.cpp", "testing/web-platform/meta/editing/run/removeformat.html.ini", "testing/web-platform/tests/editing/data/removeformat.js"], "git_node": null, "git_parents": [null], "node": "27ee738ebde14de9f91501650abfef8e26ffbc0b", "parents": ["ca01221584b28d6dee81ecb6d07e640a135a78e4"], "tags": []}], "date": 1556647937, "git_changesets": [null, null], "user": "mozilla@jorgk.com"}, "402": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1518663 - If policy extension download fails, try again. r=Felipe a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D25830", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/tests/browser/browser_policy_extensions.js"], "git_node": null, "git_parents": [null], "node": "496d09494d879d83faeb4eae00af5a3cdf8ff0d6", "parents": ["d44b551abaf9141cbf6e125dc8c9edd63be8f47f"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538736 - Make extra sure Compositables don't refer back to layers after reassignment. r=sotaro, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27930", "files": ["gfx/layers/composite/CanvasLayerComposite.cpp", "gfx/layers/composite/ImageLayerComposite.cpp", "gfx/layers/composite/PaintedLayerComposite.cpp", "gfx/layers/mlgpu/PaintedLayerMLGPU.cpp"], "git_node": null, "git_parents": [null], "node": "bf58b3f239fe1ad0d0dd4b6163b6c7b5ca437423", "parents": ["496d09494d879d83faeb4eae00af5a3cdf8ff0d6"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1542097 - Directly downmix to mono. r=bryce a=lizzard\n\nNo need to first downmix to stereo and then mono.\n\nESR60 rebase\n\nDifferential Revision: https://phabricator.services.mozilla.com//D29309", "files": ["dom/media/AudioConverter.cpp"], "git_node": null, "git_parents": [null], "node": "daf49b46f546a1c4af9a95f4ea84545e4