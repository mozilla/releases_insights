"pushes": {"372": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 7dc3b931ebe512d045e9628533fdca97811601c1 with FIREFOX_60_6_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "af17341c0b1d66bfc0bae78c2c28a3f6959920df", "parents": ["7dc3b931ebe512d045e9628533fdca97811601c1"], "tags": []}], "date": 1552512894, "git_changesets": [null], "user": "ffxbld"}, "373": {"changesets": [{"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1534283 - add a 'tasks_for' property; r=tomprince, a=tomprince\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23569", "files": [".taskcluster.yml", "taskcluster/docs/parameters.rst", "taskcluster/mach_commands.py", "taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/parameters.py", "taskcluster/taskgraph/test/test_decision.py"], "git_node": null, "git_parents": [null], "node": "b0130d317c5535c6ef0643d4209d103fdbd61cfc", "parents": ["af17341c0b1d66bfc0bae78c2c28a3f6959920df"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1525421 - parse out just the try syntax from the commit message r=tomprince\n\nThis mirrors what mozilla-taskcluster does in\nhttps://github.com/taskcluster/mozilla-taskcluster/blob/cb3de4c31e418f7dc1d89cffeeb28ad6a9dae610/src/jobs/taskcluster_graph.js#L46-L58\n\nDifferential Revision: https://phabricator.services.mozilla.com/D18748", "files": ["taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/test/test_decision.py", "taskcluster/taskgraph/try_option_syntax.py"], "git_node": null, "git_parents": [null], "node": "7b8bb76f6afe4bbf191f73ff54faa7efcf55adf3", "parents": ["b0130d317c5535c6ef0643d4209d103fdbd61cfc"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1534283 - filter out tasks when DONT-BUILD is in the message r=aki,tomprince, a=tomprince\n\n(without the dash, because I want *this* push to build)\n\nThis filters out all tasks, but that means that several things will still run:\n\n * docker images and tasks they depend on (debian packages)\n * always_run tasks (various python-y things)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23020", "files": ["taskcluster/taskgraph/decision.py", "taskcluster/taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "aecd2582501a57c503f6a02c7577494627115a44", "parents": ["7b8bb76f6afe4bbf191f73ff54faa7efcf55adf3"], "tags": []}, {"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1534283 - use default parameters for mach try fuzzy r=tomprince, a=tomprince, DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23225", "files": ["taskcluster/taskgraph/parameters.py", "tools/tryselect/cli.py", "tools/tryselect/tasks.py"], "git_node": null, "git_parents": [null], "node": "b18ece2f04083a8f38e79dce52933cac074795f1", "parents": ["aecd2582501a57c503f6a02c7577494627115a44"], "tags": []}], "date": 1552661140, "git_changesets": [null, null, null, null], "user": "dmitchell@mozilla.com"}, "374": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23841", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "27a59bbf00e42adebed807f8da4a8ae7ffa1bb36", "parents": ["b18ece2f04083a8f38e79dce52933cac074795f1"], "tags": []}], "date": 1552914879, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "375": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+tre