sc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D25601", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "ed9cbf4d14a32116e6d45efe77920bd8335e8d6b", "parents": ["f5043009e5efbe0f0abae539324a13bde0bd10ae"], "tags": []}], "date": 1554126085, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "386": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26118", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "733865e931a0550da918e278dc455f52d209259d", "parents": ["ed9cbf4d14a32116e6d45efe77920bd8335e8d6b"], "tags": []}], "date": 1554384368, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "387": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26497", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "868b739ae72bed7ff8215a70d8684b2d6efa3074", "parents": ["733865e931a0550da918e278dc455f52d209259d"], "tags": []}], "date": 1554727461, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "388": {"changesets": [{"author": "Rail Aliiev \u003crail@mozilla.com\u003e", "branch": "default", "desc": "Bug 1541693: Stop marking releases as started r=mtabara a=release\n\nShip-it v1 is going away soon and we won't need to create new releases in Ship-it v1 in parallel with Ship-it v2. It's time to prep patches to remove this functionality.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26044", "files": ["taskcluster/ci/release-mark-as-started/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/release_mark_as_started.py", "taskcluster/taskgraph/transforms/task.py", "taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "9effec70cc6aeb4986bae93f7e8b9b877eb1a39d", "parents": ["868b739ae72bed7ff8215a70d8684b2d6efa3074"], "tags": []}], "date": 1554774632, "git_changesets": [null], "user": "raliiev@mozilla.com"}, "389": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1529948: Switch default for actions from `task` to `hook`; r=Callek a=release\n\nSupport for `kind='task'` is still around to support Thunderbird release\npromotion, which uses releaserunner3. Other actions shouldn't be using it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D20842", "files": ["taskcluster/taskgraph/actions/add_new_jobs.py", "taskcluster/taskgraph/actions/add_talos.py", "taskcluster/taskgraph/actions/backfill.py", "taskcluster/taskgraph/actions/cancel.py", "taskcluster/taskgraph/actions/cancel_all.py", "taskcluster/taskgraph/actions/create_interactive.py", "taskcluster/taskgraph/actions/purge_caches.py", "taskcluster/taskgraph/actions/registry.py", "taskcluster/taskgraph/actions/rerun.py", "taskcluster/taskgraph/actions/retrigger.py", "taskcluster/taskgraph/actions/retrigger_mochitest.py", "taskcluster/taskgraph/actions/run_missing_tests.py"], "git_node": null, "git_parents": [null], "node": "a3b0c7e871ea09cba6c19800b344425f2f442ea0", "parents": ["9effec70cc6aeb4986bae93f7e8b9b877eb1a39d"], "tags": []}], "date": 1554842029, "git_changesets": [null], "user": "asasaki@mozilla.com"}, "390": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27057", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "24f7f2c377af97874d213bef76207730e954731b", "parents": ["a3b0c7e871ea09cba6c19800b344425f2f442ea0"], "tags": []}], "date": 1554986880, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "391": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27495", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "364ea8886aa49be0ab557fe1b774e4429a135010", "parents": ["24f7f2c377af97874d213bef76207730e954731b"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1516862 - Fix test_ext_webrequest_basic intermittency while testing onError events fired on hostname resolving error. r=mixedpuppy, a=test-only\n\nWhen the dns resolution for an url's hostname fails, the webRequest API seems to be\nreceiving (from time to time but more often on macos and windows) more then one call\nto the HttpObserverManager.observeActivity method for the activityType\n\n  nsISocketTransport.STATUS_RESOLVING and nsISocketTransport.STATUS_RESOLVED\n\nwhile channel wrapper errorString property is still null.\n\nThe observeActvity method goal seems to fire fallback WebRequest errors for error conditions\nthat are not fired as ChannelWrapper error events, but the \"NS_ERROR_UNKNOWN_HOST\" error\nis also being fired right after the fallback webRequest error event fired as\n\"NS_ERROR_NET_ON_RESOLVED\" (or \"NS_ERROR_NET_ON_RESOLVING\").\n\nThis behavior consistently triggers the two intermittent failures on the test\ntest_ext_webrequest_basic.html while executing the test_webRequest_frames\ntask\n\n\"expected error message received in onErrorOccurred - Expected: NS_ERROR_UNKNOWN_HOST, Actual: NS_ERROR_NET_ON_RESOLVED\"\n\n(when the fallback NS_ERROR_NET_ON_RESOLVED is fired first)\n\nand then\n\n\"received onErrorOccurred\"\n\n(because the \"NS_ERROR_UNKNOWN_HOST\" error is also being fired\nright after the fallback error message).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D22587", "files": ["toolkit/components/extensions/test/mochitest/head_webrequest.js", "toolkit/components/extensions/test/mochitest/test_ext_webrequest_basic.html"], "git_node": null, "git_parents": [null], "node": "843a3e6725f879365d5bffe8b00236c736661623", "parents": ["364ea8886aa49be0ab557fe1b774e4429a135010"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1531346 - Check for cyclical relationship with aria-activedescendant. r=MarcoZ a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D22633", "files": ["accessible/generic/Accessible.cpp"], "git_node": null, "git_parents": [null], "node": "6420d2cb2fceb0abfc260d1c5f06ced6f2fe93f5", "parents": ["843a3e6725f879365d5bffe8b00236c736661623"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1532761 - Add regionOverrides engine to jarNames. r=daleharvey, a=lizzard", "files": ["toolkit/components/search/nsSearchService.js"], "git_node": null, "git_parents": [null], "node": "b5e6b61e7bfdb5bd97227b5788df5b90f052d0b4", "parents": ["6420d2cb2fceb0abfc260d1c5f06ced6f2fe93f5"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1532530 - Avoid loss of upload data by webRequest API r=kmag a=lizzard\n\nWhen an extension requests access to the request body of a request,\n`nsConverterInputStream` is used to parse the input streams that make up\na request body. These input streams are later (re)used to upload the\nform data to the original destination (server).\n\n`nsConverterInputStream`'s destructor does however close the input\nstreams, which results in data loss when the object is garbage-collected\nbefore the upload completes.\n\nThis patch fixes the issue by explicitly nulling the underlying stream\nbefore returning from the form parser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D24539", "files": ["toolkit/modules/addons/WebRequestUpload.jsm"], "git_node": null, "git_parents": [null], "node": "90a634a74145f4dc26d7591ebc4a349b4d685aec", "parents": ["b5e6b61e7bfdb5bd97227b5788df5b90f052d0b4"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1535518 - Preserve fLastMoveToIndex in SkPath::transform. r=rhunt, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23912", "files": ["gfx/skia/skia/src/core/SkPath.cpp"], "git_node": null, "git_parents": [null], "node": "9f059761b1dfe73f51a4fbe356e4af6c62dcf05b", "parents": ["90a634a74145f4dc26d7591ebc4a349b4d685aec"], "tags": []}], "date": 1555376490, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "392": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D28054", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "c0d92c2fe4926b8f671831e233903516f7bc3f04", "parents": ["9f059761b1dfe73f51a4fbe356e4af6c62dcf05b"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1532553 - Use JSAutoCompartment before calling JS::ReadableStreamGetMode(). r=jorendorff, a=lizzard", "files": ["dom/fetch/Fetch.cpp"], "git_node": null, "git_parents": [null], "node": "937efa6b4c1afd09b526e497eb7c840c597b9414", "parents": ["c0d92c2fe4926b8f671831e233903516f7bc3f04"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1535612 - CSSKeyframeList::RemoveRule should clear parent references when removed. r=heycam, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23729", "files": ["layout/style/ServoKeyframesRule.cpp"], "git_node": null, "git_parents": [null], "node": "bd7e1500465b66749226fad183fede8dd62b6294", "parents": ["937efa6b4c1afd09b526e497eb7c840c597b9414"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1535194 - Always check error return from BufferOffset::diffB. r=luke, a=lizzard\n\nWe were missing error checks at two points.  In one case an error\nreturn is meaningful; in another case it is not, as the problem should\nhave been guarded against at a higher level by emitting far jump\nislands soon enough during pasteup of compiled code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23506", "files": ["js/src/jit/arm/Assembler-arm.cpp", "js/src/jit/arm/MacroAssembler-arm.cpp"], "git_node": null, "git_parents": [null], "node": "0d5ea6a469ca4b27a760c8f8dbaf54d8472bc7e1", "parents": ["bd7e1500465b66749226fad183fede8dd62b6294"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1532465 - Ensure we AddRef prior to early return in MediaType::Assign. r=pehrsons, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23143", "files": ["media/webrtc/trunk/webrtc/modules/video_capture/windows/MediaType.cpp"], "git_node": null, "git_parents": [null], "node": "5e6590420e9cf68b22863d768f4ef3c04da8f7ca", "parents": ["0d5ea6a469ca4b27a760c8f8dbaf54d8472bc7e1"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1534749 - Handle shutdown races between the compositor thread and IPDL object setup. r=rhunt, a=lizzard\n\nWhen the compositor thread has begun shutdown, it will spin the event\nloop for the main thread until the last CompositorThreadHolder reference\nhas been released. While spinning, new IPDL objects may be attempted to\nbe created which depend on the compositor thread; we should check to\nensure the compositor thread is still around before proceeding with\ncreation. These objects include CompositorManagerParent,\nImageBridgeParent, and VRManagerParent. Additionally there is a very\nsimilar bug between the vsync thread and VsyncBridgeChild.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D23308", "files": ["gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/VsyncBridgeChild.cpp", "gfx/ipc/VsyncBridgeChild.h", "gfx/ipc/VsyncIOThreadHolder.h", "gfx/layers/ipc/CompositorManagerParent.cpp", "gfx/layers/ipc/CompositorManagerParent.h", "gfx/layers/ipc/ImageBridgeParent.cpp", "gfx/vr/ipc/VRManagerParent.cpp"], "git_node": null, "git_parents": [null], "node": "67298854427b765d4133dde128154a068c5a843c", "parents": ["5e6590420e9cf68b22863d768f4ef3c04da8f7ca"], "tags": []}], "date": 1555615211, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "393": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1536405 - Cycle-collect through ChromeEventHandler. r=bzbarsky, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D24983", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h"], "git_node": null, "git_parents": [null], "node": "c93e2300ddc750f6fe5afc958878641d8bc0c3c8", "parents": ["67298854427b765d4133dde128154a068c5a843c"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538042 - Change nsIFind::Find to have access to text length. r=mccr8, a=abillings", "files": ["toolkit/components/find/nsFind.cpp", "toolkit/components/find/nsIFind.idl", "toolkit/components/find/nsWebBrowserFind.cpp", "toolkit/components/typeaheadfind/nsTypeAheadFind.cpp", "toolkit/components/windowcreator/test/test_nsFind.html"], "git_node": null, "git_parents": [null], "node": "7405c40534e00ad5e3045229d4f2789f8c67425a", "parents": ["c93e2300ddc750f6fe5afc958878641d8bc0c3c8"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1540166 - Avoid some useless ForgetSkippable handling while we're already dealing with snow-white objects. r=mccr8, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D25414", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": null, "git_parents": [null], "node": "7ac782fad9d24b5395cfab15f56da58c27186ddb", "parents": ["7405c40534e00ad5e3045229d4f2789f8c67425a"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1516325. r=glandium, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D22638", "files": ["config/external/nspr/pr/moz.build"], "git_node": null, "git_parents": [null], "node": "e37f559cf5236bbcc33c80ee1c232689c7aa6f0d", "parents": ["7ac782fad9d24b5395cfab15f56da58c27186ddb"], "tags": []}, {"author": "Alex Gaynor \u003cagaynor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1533554 - Check for integer overflow. r=mats, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D22770", "files": ["widget/windows/nsClipboard.cpp"], "git_node": null, "git_parents": [null], "node": "b7153db8064d4318d6c6391090c4e17f2cc566e7", "parents": ["e37f559cf5236bbcc33c80ee1c232689c7aa6f0d"], "tags": []}, {"author": "Gian-Carlo Pascutto \u003cgcp@mozilla.com\u003e", "branch": "default", "desc": "Bug 1535794 - Allow getrandom() in all sandbox policies. r=jld, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D25610", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": null, "git_parents": [null], "node": "e63f9294b116b10f8de9fca95bec82e2d7413537", "parents": ["b7153db8064d4318d6c6391090c4e17f2cc566e7"], "tags": []}], "date": 1555618461, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "394": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset c93e2300ddc7 (bug 1536405) for bustage.", "files": ["docshell/base/nsDocShell.cpp", "docshell/base/nsDocShell.h"], "git_node": null, "git_parents": [null], "node": "268c77872405d967da2b035145a975cc11784f2a", "parents": ["e63f9294b116b10f8de9fca95bec82e2d7413537"], "tags": []}], "date": 1555620054, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "395": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 7405c40534e0 (bug 1538042) for bustage.", "files": ["toolkit/components/find/nsFind.cpp", "toolkit/components/find/nsIFind.idl", "toolkit/components/find/nsWebBrowserFind.cpp", "toolkit/components/typeaheadfind/nsTypeAheadFind.cpp", "toolkit/components/windowcreator/test/test_nsFind.html"], "git_node": null, "git_parents": [null], "node": "a238b04b4addc802ab3d68573bebbea57594fe3a", "parents": ["268c77872405d967da2b035145a975cc11784f2a"], "tags": []}], "date": 1555621037, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "396": {"changesets": [{"author": "Hector Zhao \u003cbzhao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1540017 - Update Baidu searchplugin with new code. r=mkaply a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D25339", "files": ["browser/locales/searchplugins/baidu.xml"], "git_node": null, "git_parents": [null], "node": "3ed98e76cb81fa379580eae0e7a4793dcfad07de", "parents": ["a238b04b4addc802ab3d68573bebbea57594fe3a"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1536768 - Check completeness of ObjectGroupDispatch in opt builds. r=jandem, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D25304", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": null, "git_parents": [null], "node": "303fa85d8f894d5b0bacac44489640265b65c905", "parents": ["3ed98e76cb81fa379580eae0e7a4793dcfad07de"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1536768 - Check completeness of FunctionDispatch without fallbacks. r=jandem, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D25456", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": null, "git_parents": [null], "node": "c9328455c9c153fa699181bd4d5b22b62c33aece", "parents": ["303fa85d8f894d5b0bacac44489640265b65c905"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1534196: Correct return values from failed brokering. r=jmathies, a=lizzard", "files": ["security/sandbox/chromium/sandbox/win/src/filesystem_policy.cc", "security/sandbox/chromium/sandbox/win/src/named_pipe_policy.cc", "security/sandbox/chromium/sandbox/win/src/process_thread_policy.cc", "security/sandbox/chromium/sandbox/win/src/registry_policy.cc"], "git_node": null, "git_parents": [null], "node": "f7fc686c08c09bf53e99415b7ccb0ae8a7a5207b", "parents": ["c9328455c9c153fa699181bd4d5b22b62c33aece"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1542829 - Backport an upstream libpng patch. r=aosmond a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26575", "files": ["media/libpng/png.c"], "git_node": null, "git_parents": [null], "node": "aca2f0b39735b4073f08d323ed35f83d85f25c7b", "parents": ["f7fc686c08c09bf53e99415b7ccb0ae8a7a5207b"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1541580 - Cleanup ProxyObject creation r=jandem a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26157", "files": ["js/src/vm/ProxyObject.cpp"], "git_node": null, "git_parents": [null], "node": "5acb3927d1ad3c4f36dbeb5dc25b46109a1f315b", "parents": ["aca2f0b39735b4073f08d323ed35f83d85f25c7b"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1540136 - P1: Log more info in ChromiumCDMProxy dtor and Shutdown. r=cpearce a=lizzard\n\nAlso remove unneeded MOZ_COUNT_[CTOR|DTOR] macros. We already get similar\nfunctionality from NS_INLINE_DECL_THREADSAFE_REFCOUNTING.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26204", "files": ["dom/media/gmp/ChromiumCDMProxy.cpp"], "git_node": null, "git_parents": [null], "node": "96d58ba299b1a73a33e197022f68e20fc50910ac", "parents": ["5acb3927d1ad3c4f36dbeb5dc25b46109a1f315b"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1540136 - P2: CDMProxy stores main thread as nsISerialEventTarget, rather than nsIEventTarget. r=cpearce a=lizzard\n\nThis gives us greater flexibility in using the main thread member to run\npromises.\n\nThe site where we obtain the main thread returns a serial event target, so we're\nnot doing much more work here, we're just keeping the serial event target\ninterface, rather than converting to an event target interface.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26205", "files": ["dom/media/eme/CDMProxy.h", "dom/media/eme/MediaKeys.cpp", "dom/media/eme/MediaKeys.h", "dom/media/eme/mediadrm/MediaDrmCDMProxy.cpp", "dom/media/eme/mediadrm/MediaDrmCDMProxy.h", "dom/media/gmp/ChromiumCDMProxy.cpp", "dom/media/gmp/ChromiumCDMProxy.h"], "git_node": null, "git_parents": [null], "node": "93e9204eaa01f3e2f891d3cf71ac64d2dc96f0e3", "parents": ["96d58ba299b1a73a33e197022f68e20fc50910ac"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1540136 - P3: ChromiumCDMProxy runs CDM init thennable code on the main thread. r=cpearce a=lizzard\n\nThis code is calling other code that expects to be on the main thread, and\nhaving this on the main thread (now that the main thread is a serial event\ntarget) makes it easier to reason about this and other main thread code. I.e.\nthis cannot be running during other main thread code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26206", "files": ["dom/media/gmp/ChromiumCDMProxy.cpp"], "git_node": null, "git_parents": [null], "node": "1bf2bf6c8b4da9bc36391d7310020381d56c8ab8", "parents": ["93e9204eaa01f3e2f891d3cf71ac64d2dc96f0e3"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1540136 - P4: Remove ChromiumCDMParent mMainThread as it is unused. r=cpearce a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26207", "files": ["dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/ChromiumCDMParent.h"], "git_node": null, "git_parents": [null], "node": "5fd39f2cf082ab21f8fd30b2f9496754e26c2d66", "parents": ["1bf2bf6c8b4da9bc36391d7310020381d56c8ab8"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1540136 - P5: Handle if ChromiumCDMProxy is shutdown in the middle of init. r=cpearce a=lizzard\n\n- Watch for if a proxy shuts down during init and if so, shutdown the CDM parent\n  that is being initialized.\n- Make ChromiumCDMParent only store a pointer to a ChromiumCDMProxy when it has\n  successfully initialized. This avoid the lopsided relationship where a if a\n  ChromiumCDMParent fails to initialize it may keep a pointer to a proxy, but\n  the proxy will never have a reference to that CDM parent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D26208", "files": ["dom/media/gmp/ChromiumCDMParent.cpp", "dom/media/gmp/ChromiumCDMProxy.cpp", "dom/media/gmp/ChromiumCDMProxy.h"], "git_node": null, "git_parents": [null], "node": "e25a0feffcb8f33a573c94c0b03dcf9d840e2ffc", "parents": ["5fd39f2cf082ab21f8fd30b2f9496754e26c2d66"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "bug 1524478 - don't create JS objects from WebAuthnManager or U2F destructors r=qdot a=lizzard\n\nBefore this patch, the WebAuthnManager/U2F destructors would call MaybeReject on\nexisting transaction promises. Doing this leaks JS objects. If\nWebAuthnManager/U2F are being destructed, though, the window is going away, so\nit shouldn't be necessary to reject any outstanding promises. This patch just\nclears the transactions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27346", "files": ["dom/u2f/U2F.cpp", "dom/webauthn/WebAuthnManager.cpp"], "git_node": null, "git_parents": [null], "node": "8f772fa0fcd93f7835f4d5e41d0c844a3a88492e", "parents": ["e25a0feffcb8f33a573c94c0b03dcf9d840e2ffc"], "tags": []}], "date": 1555666622, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "397": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D28332", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "ef0a49bc97265220e3715780c6f26bdd76172a56", "parents": ["8f772fa0fcd93f7835f4d5e41d0c844a3a88492e"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1544670 - Don't let one to reuse unlinked CallbackObjectHolder. r=mccr8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27732", "files": ["dom/bindings/CallbackObject.h"], "git_node": null, "git_parents": [null], "node": "ec1ce458482f0ace2bdba44a4df7c15e5d343ea4", "parents": ["ef0a49bc97265220e3715780c6f26bdd76172a56"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1543617 - Disallow place: urls in text flavors. r=Standard8, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27048", "files": ["toolkit/components/places/PlacesUtils.jsm", "toolkit/components/places/tests/unit/test_PlacesUtils_unwrapNodes_place.js", "toolkit/components/places/tests/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "abdb274a04d1fb699540164b4fd97374484a42ac", "parents": ["ec1ce458482f0ace2bdba44a4df7c15e5d343ea4"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1543694 - Prevent content from adding place flavors to a DataTransfer. r=NeilDeakin, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27121", "files": ["dom/events/DataTransfer.cpp", "dom/tests/mochitest/general/test_clipboard_disallowed.html"], "git_node": null, "git_parents": [null], "node": "4e95be8a9b6ec84deac4ed5e89ad8b21a8c06932", "parents": ["abdb274a04d1fb699540164b4fd97374484a42ac"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1542581 - Block child process termination until the handler is fully initialized. r=froydnj, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27231", "files": ["toolkit/crashreporter/breakpad-client/windows/crash_generation/crash_generation_server.cc"], "git_node": null, "git_parents": [null], "node": "5a2b41b92c32c675b97ca8967527ebbe3b1973d9", "parents": ["4e95be8a9b6ec84deac4ed5e89ad8b21a8c06932"], "tags": []}], "date": 1555944623, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "398": {"changesets": [{"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1534593 part 1.  Stop special-casing JS::Value initialization, since JS::Value now always initializes itself on construction.  r=qdot,waldo a=lizzard", "files": ["dom/bindings/Codegen.py"], "git_node": null, "git_parents": [null], "node": "4e96099127ff15f264be87fe5baf8a60261a5acd", "parents": ["5a2b41b92c32c675b97ca8967527ebbe3b1973d9"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1534593 part 2.  Factor out the \"determine the default initializer\" code from dictionary member init and reuse it for sequence member init.  r=qdot a=lizzard\n\nThe other option would be to implement nsTArrayElementTraits for JSObject* and\nnull-initialize there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27561", "files": ["dom/bindings/Codegen.py"], "git_node": null, "git_parents": [null], "node": "998f89f983caf8990a450ca053d7477577903c0d", "parents": ["4e96099127ff15f264be87fe5baf8a60261a5acd"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1534593 part 3.  Initialize JSObject* entries in Record types.  r=qdot a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27562", "files": ["dom/bindings/Record.h"], "git_node": null, "git_parents": [null], "node": "7a59a1df616a3a6c3e4fad25a38dd0dfa087bccd", "parents": ["998f89f983caf8990a450ca053d7477577903c0d"], "tags": []}], "date": 1555947658, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "399": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com