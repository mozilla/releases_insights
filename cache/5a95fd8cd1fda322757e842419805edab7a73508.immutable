user": "ryanvm@gmail.com"}, "378": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1537924 - Simplify some alias sets in Ion. r=tcampbell, a=dveditz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D24468", "files": ["js/src/jit/AliasAnalysisShared.cpp", "js/src/jit/MIR.h"], "git_node": null, "git_parents": [null], "node": "cba90e815e4e5e4041dfc87696326fe627d7d927", "parents": ["f99e68be290ac8fdf35e9b9b9e7afa0078743eb2"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538006 - Propagate unknownProperties when changing prototype. r=jandem, a=dveditz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D24465", "files": ["js/src/vm/NativeObject.cpp"], "git_node": null, "git_parents": [null], "node": "4825222c0116b6d54a9c4f8c135f0a5879218f37", "parents": ["cba90e815e4e5e4041dfc87696326fe627d7d927"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538006 - Don't emit unbarriered writes to an object if its group might change. r=tcampbell, a=dveditz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D24466", "files": ["js/src/jit/MIR.cpp"], "git_node": null, "git_parents": [null], "node": "79253cb82ff8d415746056b6ee6a01a0564b7c50", "parents": ["4825222c0116b6d54a9c4f8c135f0a5879218f37"], "tags": ["FIREFOX_60_6_1esr_BUILD1", "FIREFOX_60_6_1esr_RELEASE"]}], "date": 1553220226, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "379": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 79253cb82ff8d415746056b6ee6a01a0564b7c50 with FIREFOX_60_6_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "afe3ba6fd62715d4b5912dc4a5a65659ffffc254", "parents": ["79253cb82ff8d415746056b6e