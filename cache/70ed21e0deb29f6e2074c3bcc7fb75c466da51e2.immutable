s/jaws-esr/locales/jar.mn", "browser/extensions/jaws-esr/locales/lt/jaws-esr.properties", "browser/extensions/jaws-esr/locales/lv/jaws-esr.properties", "browser/extensions/jaws-esr/locales/nl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/nn-NO/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pt-BR/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pt-PT/jaws-esr.properties", "browser/extensions/jaws-esr/locales/ru/jaws-esr.properties", "browser/extensions/jaws-esr/locales/sl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/sv-SE/jaws-esr.properties", "browser/extensions/jaws-esr/locales/th/jaws-esr.properties", "browser/extensions/jaws-esr/locales/tr/jaws-esr.properties", "toolkit/modules/UpdateUtils.jsm", "toolkit/modules/tests/xpcshell/test_UpdateUtils_url.js"], "git_node": null, "git_parents": [null], "node": "3ae7c5b3f6e7f0fdf0cd7a92086484bafa6f9a81", "parents": ["8f93072480db437b2d5754a6c40d531cefcf13f0"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566523 - Remove com.apple.quarantine from gmp downloads. r=dminor a=jcristau\n\nOn MacOS Firefox will add the com.apple.quarantine attribute to files it\ndownloads. Firefox does this as a safety measure to indicate to the OS that the\nfile may be from an untrusted source.\n\nWhile the attribute can be set prior to MacOS 10.15, the attribute is used to\nenforce new features in 10.15. This leads to issues where if we do not clear the\nattribute from GMPs we download, we will fail to load dynamic libs.\n\nThis patch means we will clear the quarantine from GMP downloads. These GMPs\ncome from a trusted source and are checksummed via hash.\n\nNote, most of the heavy lifting for this was done in bug 1566700. We just\nleverage the new API here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39369", "files": ["toolkit/modules/GMPExtractorWorker.js"], "git_node": null, "git_parents": [null], "node": "9a2edfe3c1afd555e2c593ba14f3d01971ecfbba", "parents": ["3ae7c5b3f6e7f0fdf0cd7a92086484bafa6f9a81"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1563994 - [10.15] Right Click When Not Focused Presents \"Keystroke Receiving\" Access Grant Request Dialog r=mstange a=jcristau\n\nUse addGlobalMonitorForEventsMatchingMask instead of CGEventTapCreate to monitor for mouse clicks outside of the application while context menus are displayed.\n\nUsing addGlobalMonitorForEventsMatchingMask prevents the display of the privacy \"Keystroke Receiving\" dialog when listening for mouse clicks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39973", "files": ["widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsToolkit.h", "widget/cocoa/nsToolkit.mm"], "git_node": null, "git_parents": [null], "node": "23b7307d18395656847159ab6489657db7deb857", "parents": ["9a2edfe3c1afd555e2c593ba14f3d01971ecfbba"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1564449, ensure the right body element is used throughout the method call, r=mccr8 a=jcristau", "files": ["dom/html/ImageDocument.cpp", "dom/html/PluginDocument.cpp", "dom/html/VideoDocument.cpp"], "git_node": null, "git_parents": [null], "node": "23d04c883edb76a6984a26c28a966d46783b2642", "parents": ["23b7307d18395656847159ab6489657db7deb857"], "tags": []}], "date": 1565307107, "git_changesets": [null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "475": {"changesets": [{"author": "Razvan Maries \u003crmaries@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 9a2edfe3c1af (bug 1566523) as per Bryce's request. a=backout", "files": ["toolkit/modules/GMPExtractorWorker.js"], "git_node": null, "git_parents": [null], "node": "43f8874f45ab6de5156b9cf164446c860f58214c", "parents": ["23d04c883edb76a6984a26c28a966d46783b2642"], "tags": []}], "date": 1565310869, "git_changesets": [null], "user": "rmaries@mozilla.com"}, "476": {"changesets": [{"author": "Yura Zenevich \u003cyura.zenevich@gmail.com\u003e", "branch": "default", "desc": "Bug 1494926 - updating jaws-esr add-on with newer localization strings and a way for accessibility users to re-enable e10s. r=rhelmer a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37677", "files": ["browser/extensions/jaws-esr/bootstrap.js", "browser/extensions/jaws-esr/install.rdf", "browser/extensions/jaws-esr/locales/de/jaws-esr.properties", "browser/extensions/jaws-esr/locales/en-GB/jaws-esr.properties", "browser/extensions/jaws-esr/locales/en-US/jaws-esr.properties", "browser/extensions/jaws-esr/locales/es-AR/jaws-esr.properties", "browser/extensions/jaws-esr/locales/es-CL/jaws-esr.properties", "browser/extensions/jaws-esr/locales/es-ES/jaws-esr.properties", "browser/extensions/jaws-esr/locales/es-MX/jaws-esr.properties", "browser/extensions/jaws-esr/locales/fr/jaws-esr.properties", "browser/extensions/jaws-esr/locales/hu/jaws-esr.properties", "browser/extensions/jaws-esr/locales/it/jaws-esr.properties", "browser/extensions/jaws-esr/locales/jar.mn", "browser/extensions/jaws-esr/locales/lt/jaws-esr.properties", "browser/extensions/jaws-esr/locales/lv/jaws-esr.properties", "browser/extensions/jaws-esr/locales/nl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/nn-NO/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pt-BR/jaws-esr.properties", "browser/extensions/jaws-esr/locales/pt-PT/jaws-esr.properties", "browser/extensions/jaws-esr/locales/ru/jaws-esr.properties", "browser/extensions/jaws-esr/locales/sl/jaws-esr.properties", "browser/extensions/jaws-esr/locales/sv-SE/jaws-esr.properties", "browser/extensions/jaws-esr/locales/th/jaws-esr.properties", "browser/extensions/jaws-esr/locales/tr/jaws-esr.properties"], "git_node": null, "git_parents": [null], "node": "714b9c847c5987a37e06d0708d5b310ed9ff8d25", "parents": ["43f8874f45ab6de5156b9cf164446c860f58214c"], "tags": []}, {"author": "Yura Zenevich \u003cyura.zenevich@gmail.com\u003e", "branch": "default", "desc": "Bug 1494926 - add the JAWS update URL token to update URL. r=rstrong a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37678\n\nDepends on D37677", "files": ["toolkit/modules/UpdateUtils.jsm", "toolkit/modules/tests/xpcshell/test_UpdateUtils_url.js"], "git_node": null, "git_parents": [null], "node": "67750bf91a7328acc992231d82194e1d27602ff9", "parents": ["714b9c847c5987a37e06d0708d5b310ed9ff8d25"], "tags": []}], "date": 1565336780, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "477": {"changesets": [{"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566700 - Add File.OS macRemoveXAttr. r=Yoric a=jcristau\n\nAdd functionality to remove an extended attribute from a file. This\nfunctionality is currently MacOS specific due to that being the only use case we\ncurrently have (see bug 1566523).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38523", "files": ["toolkit/components/osfile/modules/osfile_async_front.jsm", "toolkit/components/osfile/modules/osfile_async_worker.js", "toolkit/components/osfile/modules/osfile_unix_back.jsm", "toolkit/components/osfile/modules/osfile_unix_front.jsm"], "git_node": null, "git_parents": [null], "node": "44c6365ee67bbda2df83cbc77c1e5346f7c7b210", "parents": ["67750bf91a7328acc992231d82194e1d27602ff9"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566700 - Add functions to OS.File to set and get extended attributes on MacOS. r=Yoric a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38964", "files": ["toolkit/components/osfile/modules/osfile_async_front.jsm", "toolkit/components/osfile/modules/osfile_async_worker.js", "toolkit/components/osfile/modules/osfile_unix_back.jsm", "toolkit/components/osfile/modules/osfile_unix_front.jsm"], "git_node": null, "git_parents": [null], "node": "47a6a95c6f12f17656e9cd01e9aab3df6d69fabb", "parents": ["44c6365ee67bbda2df83cbc77c1e5346f7c7b210"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566700 - Add tests for OS.File extended attribute MacOS functions. r=Yoric a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38965", "files": ["toolkit/components/osfile/tests/xpcshell/test_osfile_mac_async_xattr.js", "toolkit/components/osfile/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "80d79fc1f90e88ee803393489a86a4a7dbfeef06", "parents": ["47a6a95c6f12f17656e9cd01e9aab3df6d69fabb"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566523 - Remove com.apple.quarantine from gmp downloads. r=dminor a=jcristau\n\nOn MacOS Firefox will add the com.apple.quarantine attribute to files it\ndownloads. Firefox does this as a safety measure to indicate to the OS that the\nfile may be from an untrusted source.\n\nWhile the attribute can be set prior to MacOS 10.15, the attribute is used to\nenforce new features in 10.15. This leads to issues where if we do not clear the\nattribute from GMPs we download, we will fail to load dynamic libs.\n\nThis patch means we will clear the quarantine from GMP downloads. These GMPs\ncome from a trusted source and are checksummed via hash.\n\nNote, most of the heavy lifting for this was done in bug 1566700. We just\nleverage the new API here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39369", "files": ["toolkit/modules/GMPExtractorWorker.js"], "git_node": null, "git_parents": [null], "node": "9bebf8915c273ec24cc7408cb493005b456729c9", "parents": ["80d79fc1f90e88ee803393489a86a4a7dbfeef06"], "tags": []}], "date": 1565590010, "git_changesets": [null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "478": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1562033. r=alchen, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36361", "files": ["parser/html/javasrc/Tokenizer.java", "parser/html/javasrc/TreeBuilder.java", "parser/html/nsHtml5Tokenizer.cpp", "parser/html/nsHtml5Tokenizer.h", "parser/html/nsHtml5TreeBuilder.cpp"], "git_node": null, "git_parents": [null], "node": "0738b8df948a5867143aebd7503d73577fd9d19e", "parents": ["9bebf8915c273ec24cc7408cb493005b456729c9"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 1559715 r=dholbert,mstange a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36874", "files": ["dom/svg/SVGFEImageElement.cpp"], "git_node": null, "git_parents": [null], "node": "656ab502f280c80d473daa224c1ae014b15a4044", "parents": ["0738b8df948a5867143aebd7503d73577fd9d19e"], "tags": []}], "date": 1565636131, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "479": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 0738b8df948a (bug 1562033) for bustage.", "files": ["parser/html/javasrc/Tokenizer.java", "parser/html/javasrc/TreeBuilder.java", "parser/html/nsHtml5Tokenizer.cpp", "parser/html/nsHtml5Tokenizer.h", "parser/html/nsHtml5TreeBuilder.cpp"], "git_node": null, "git_parents": [null], "node": "4db76f7c75ecb2baa9fd5ce37203bd9bb2d4bfe7", "parents": ["656ab502f280c80d473daa224c1ae014b15a4044"], "tags": []}], "date": 1565637032, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "480": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1532710: [taskgraph] Provide a function version of `resolve_keyed_by` that doesn't mutate; r=dustin\n\nI'd like to use the same format for config values, that get evaluated in different contexts, so don't\nto mutate the config for that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D22126", "files": ["taskcluster/taskgraph/util/keyed_by.py", "taskcluster/taskgraph/util/schema.py"], "git_node": null, "git_parents": [null], "node": "712a502a811e90458ea7e0fdd356d56dd2cb22c0", "parents": ["4db76f7c75ecb2baa9fd5ce37203bd9bb2d4bfe7"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - mac-signing transform logic + config. r=tomprince\n\nThis moves mac signing tasks to the notarization/iscript pool. It also\nadds support for pkg installers and notarization.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33857", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/task.py", "taskcluster/taskgraph/util/signed_artifacts.py"], "git_node": null, "git_parents": [null], "node": "bc4035b1a42e912c81d4f59b9380857cdd6d97b0", "parents": ["712a502a811e90458ea7e0fdd356d56dd2cb22c0"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - add entitlements url for hardened runtime signing. r=tomprince\n\nFor mac hardened runtime signing, we use an entitlements file that's now\nin-tree. This patch passes the url for that file in the task definition.\n\nThe original patch for this was written by sfraser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33859", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/parameters.py", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "13bb65d5ecf0260a3c13267f10a32ef55e137e2d", "parents": ["bc4035b1a42e912c81d4f59b9380857cdd6d97b0"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - ignore partner_subset if it's an empty list. r=tomprince a=release\n\nThe relpro action requires a list for partner_subset and defaults to\n`[]`. In `get_partner_config_by_url` we check to see `if\npartner_subset`, ignoring the subset if it's an empty list. We either\nneed to do the same thing in `get_partner_config_by_kind`, or we need to\nallow for a `null` value in the action (or populate an empty\n`partner_subset` with the partners from the partner config in the\naction)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33861", "files": ["taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "69d62cb295efbb196ff42a67782ede0a6fc3a894", "parents": ["13bb65d5ecf0260a3c13267f10a32ef55e137e2d"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - add esr support for entitlements. r=tomprince a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38208", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/transforms/signing.py"], "git_node": null, "git_parents": [null], "node": "4862f690ed5cc61785b15312db79a1c31c86f1e4", "parents": ["69d62cb295efbb196ff42a67782ede0a6fc3a894"], "tags": []}], "date": 1565637776, "git_changesets": [null, null, null, null, null], "user": "asasaki@mozilla.com"}, "481": {"changesets": [{"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1543830 - Add Mac Hardened Runtime entitlement files to the tree r=spohl a=release\n\nAdd entitlement files for Hardened Runtime configuration to be used by Release Engineering for official builds and try builds and developers for local builds. These entitlement files are input to the codesign command.\n\nHardened Runtime and codesigning is not yet enabled for local builds or try builds so for now these files will only be used by Release Engineering.\n\nproduction.entitlements.xml is intended to be used for official channel builds that will be codesigned, notarized, and shipped to users.\n\ndeveloper.entitlements.xml is intended to be used for developer and try builds that will be codesigned, but not notarized or shipped to users. The developer file enables debugging which is not compatible with notarization, but is otherwise the same as the production file.\n\ncodesign.bash is a stop-gap script to allow developers who setup Apple Developer ID certificates to codesign Nightly themselves and enabled Hardened Runtime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27396", "files": ["security/mac/hardenedruntime/codesign.bash", "security/mac/hardenedruntime/developer.entitlements.xml", "security/mac/hardenedruntime/production.entitlements.xml"], "git_node": null, "git_parents": [null], "node": "95e9e64fecd8729236b9c7ee7c6f2687f4abaa7a", "parents": ["4862f690ed5cc61785b15312db79a1c31c86f1e4"], "tags": []}], "date": 1565640519, "git_changesets": [null], "user": "asasaki@mozilla.com"}, "482": {"changesets": [{"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570646 - Adjust timeout for repo_update task. r=RyanVM, a=release DONTBUILD\n\nWorkaround until a longer term solution is found\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40616", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": null, "git_parents": [null], "node": "bccf39afff666b5b64ee78633bcb8758bf5d0e05", "parents": ["95e9e64fecd8729236b9c7ee7c6f2687f4abaa7a"], "tags": []}], "date": 1565790843, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "483": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D42124", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "f5f275a8ca362f3e54bf57dc32a725cd5c3aa4ae", "parents": ["bccf39afff666b5b64ee78633bcb8758bf5d0e05"], "tags": []}], "date": 1565874434, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "484": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1562033. r=alchen, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36361", "files": ["parser/html/javasrc/Tokenizer.java", "parser/html/javasrc/TreeBuilder.java", "parser/html/nsHtml5Tokenizer.cpp", "parser/html/nsHtml5Tokenizer.h", "parser/html/nsHtml5TreeBuilder.cpp"], "git_node": null, "git_parents": [null], "node": "3e5da344d87de189fb192032d3fecc23a6d58933", "parents": ["f5f275a8ca362f3e54bf57dc32a725cd5c3aa4ae"], "tags": []}, {"author": "Nathan Froyd \u003cfroydnj@mozilla.com\u003e", "branch": "default", "desc": "Bug 1573160 - shutdown newly-spawned threads if we're shutting down; r=mccr8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D41551", "files": ["xpcom/threads/nsThreadPool.cpp"], "git_node": null, "git_parents": [null], "node": "38189f281389f80653d4133eafbcca505bf6e606", "parents": ["3e5da344d87de189fb192032d3fecc23a6d58933"], "tags": []}], "date": 1565986405, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "485": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1466449 addendum - Turn jArray from a struct to class and make it have a constructor from nullptr. r=smaug a=RyanVM\nSimple adding a constructor from nullptr did not compile without turning\njArray all the way to a class instead of struct.", "files": ["parser/html/jArray.h"], "git_node": null, "git_parents": [null], "node": "ca88b9fad7d5ee879e81dc2c8347b913718faa8e", "parents": ["38189f281389f80653d4133eafbcca505bf6e606"], "tags": []}], "date": 1565986757, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "486": {"changesets": [{"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_60_VERBRANCH", "desc": "merge default (ca88b9fad7d5) to THUNDERBIRD_60_VERBRANCH. a=jorgk CLOSED TREE DONTBUILD", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/parameters.py", "testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": null, "git_parents": [null, null], "node": "83976e91b33c240da4297e8b05199f5004bdf879", "parents": ["eb76765892cfd646d3014e5f3b8df8c6753da2d2", "ca88b9fad7d5ee879e81dc2c8347b913718faa8e"], "tags": []}], "date": 1566069093, "git_changesets": [null], "user": "mozilla@jorgk.com"}, "487": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D42499", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "c073e3faa76e6e95fddc7e280485f791a8c90e25", "parents": ["ca88b9fad7d5ee879e81dc2c8347b913718faa8e"], "tags": []}], "date": 1566226485, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "488": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D43055", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "853c143fa084795354383f6836639b83d26516dd", "parents": ["c073e3faa76e6e95fddc7e280485f791a8c90e25"], "tags": []}], "date": 1566481674, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "489": {"changesets": [{"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570581 - Starting with Firefox 68.0.1, Adobe Acrobat Extension for Firefox fails to send apple events to target application (Acrobat) r=handyman a=RyanVM\n\nRelax our Hardened Runtime settings to allow the com.apple.security.automation.apple-events entitlement so that native messaging webextension helper apps (which are launched by and are child processes of Firefox) can use Apple Events to signal other processes. This will apply to Firefox and all child processes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D42929", "files": ["security/mac/hardenedruntime/developer.entitlements.xml", "security/mac/hardenedruntime/production.entitlements.xml"], "git_node": null, "git_parents": [null], "node": "d960c56b609c098e54537947ac406b7c11d64d3a", "parents": ["853c143fa084795354383f6836639b83d26516dd"], "tags": []}], "date": 1566509352, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "490": {"changesets": [{"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1562684 - PR_GetLibraryFilePathname is returning absolute paths in MacOS Catalina r=froydnj a=RyanVM\n\nInstead of using symlinks, copy .dylib files to the ${OBJDIR}/dist/Nightly{Debug}.app/Contents/MacOS dir for local builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D41926", "files": ["browser/app/Makefile.in", "browser/app/macbuild/Contents/MacOS-files-copy.in", "browser/app/macbuild/Contents/MacOS-files.in"], "git_node": null, "git_parents": [null], "node": "b18f3af3609f604610484ee53b46843bc1f8bece", "parents": ["d960c56b609c098e54537947ac406b7c11d64d3a"], "tags": []}, {"author": "Robert Strong \u003crobert.bugzilla@gmail.com\u003e", "branch": "default", "desc": "Bug 1574980 - Fix issues with maintenance service install. r=bytesized a=jcristau", "files": ["toolkit/mozapps/update/common/moz.build", "toolkit/mozapps/update/common/updatehelper.cpp"], "git_node": null, "git_parents": [null], "node": "0f28c3a1e6a783a09e5550973b5554ac53b3e690", "parents": ["b18f3af3609f604610484ee53b46843bc1f8bece"], "tags": []}], "date": 1566590632, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "491": {"changesets": [{"author": "T\u0133l Coosemans \u003ctijl@FreeBSD.org\u003e", "branch": "default", "desc": "Bug 1575876 - Drop header unused on FreeBSD that breaks with new libc++. r=bwc, a=RyanVM", "files": ["media/mtransport/third_party/nICEr/src/stun/stun.h"], "git_node": null, "git_parents": [null], "node": "b0e6efc322b42b9e64758dac3e7f4253d35814a9", "parents": ["0f28c3a1e6a783a09e5550973b5554ac53b3e690"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D43436", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "699824ca0dcfabcf607025b74e136652f64acebf", "parents": ["b0e6efc322b42b9e64758dac3e7f4253d35814a9"], "tags": []}], "date": 1566825323, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "492": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D43969", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "b8af85a4acb1fb31c0624f4cdada2eaca295e011", "parents": ["699824ca0dcfabcf607025b74e136652f64acebf"], "tags": []}], "date": 1567084986, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "493": {"changesets": [{"author": "Yaron Tausky \u003cytausky@mozilla.com\u003e", "branch": "default", "desc": "Bug 1554989 - Fix implicit checker on inheriting constructors. r=andi, a=jcristau\n\nInheriting constructors are implicitly introduced via a using-declaration.\nSince the C++ grammar doesn't allow attributes on using-declarations, it\nis currently impossible to add MOZ_IMPLICIT to implicit inheriting\nconstructors.\n\nThis commit changes the AST matcher such that it ignores inheriting\nconstructors altogether. If they are inheriting from an implicit inherited\nconstructor, that constructor's check should be enough to ensure that no\nconstructors are unintentionally implicit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D43434", "files": ["build/clang-plugin/CustomMatchers.h"], "git_node": null, "git_parents": [null], "node": "2db1de7836b82ebecbd96a4067b1976077a6394c", "parents": ["b8af85a4acb1fb31c0624f4cdada2eaca295e011"], "tags": []}, {"author": "Yaron Tausky \u003cytausky@mozilla.com\u003e", "branch": "default", "desc": "Bug 1544750 - Part 1: Refactor some IndexedDB code to use ErrorResult. r=asuth, a=jcristau\n\nThis is mostly laying the groundwork for further refactoring.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27666", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/indexedDB/IDBCursor.cpp", "dom/indexedDB/IDBFactory.cpp", "dom/indexedDB/IDBIndex.cpp", "dom/indexedDB/IDBKeyRange.cpp", "dom/indexedDB/IDBKeyRange.h", "dom/indexedDB/IDBObjectStore.cpp", "dom/indexedDB/IDBObjectStore.h", "dom/indexedDB/Key.cpp", "dom/indexedDB/Key.h"], "git_node": null, "git_parents": [null], "node": "2ce17180fd4dd8828caa964ba55205a51c313355", "parents": ["2db1de7836b82ebecbd96a4067b1976077a6394c"], "tags": []}, {"author": "Yaron Tausky \u003cytausky@mozilla.com\u003e", "branch": "default", "desc": "Bug 1501152 - Refactor Key::EncodeJSValInternal to show direct correspondence to spec. r=asuth,tcampbell, a=jcristau\n\nThis commit adds the text of the spec as inline comments and refactors\nthe code such that it directly corresponds to the spec's steps. This\nmakes it easier to understand how the spec's algorithm is implemented.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D43016", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/indexedDB/IDBCursor.cpp", "dom/indexedDB/IDBFactory.cpp", "dom/indexedDB/IDBKeyRange.cpp", "dom/indexedDB/IDBObjectStore.cpp", "dom/indexedDB/IDBResult.h", "dom/indexedDB/Key.cpp", "dom/indexedDB/Key.h", "dom/indexedDB/KeyPath.cpp", "dom/indexedDB/moz.build", "dom/indexedDB/test/gtest/TestIDBResult.cpp", "dom/indexedDB/test/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "d8dd10ac54302e4bd9cf6c537f790933b149099d", "parents": ["2ce17180fd4dd8828caa964ba55205a51c313355"], "tags": ["FIREFOX_60_9_0esr_BUILD1", "FIREFOX_60_9_0esr_RELEASE"]}], "date": 1567331163, "git_changesets": [null, null, null], "user": "jcristau@mozilla.com"}}
}";