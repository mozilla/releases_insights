"pushes": {"270": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 9cbe8ffa12101019dbe0da698f869ed3ef0b9370 with FIREFOX_91_10_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "24056fd86abaa97892576cc8c1ead5404cf9c9bf", "parents": ["9cbe8ffa12101019dbe0da698f869ed3ef0b9370"], "tags": []}], "date": 1653326186, "git_changesets": [null], "user": "ffxbld"}, "271": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "6694878faa1ef3739a1fd92df66c7811a83aec2d", "parents": ["24056fd86abaa97892576cc8c1ead5404cf9c9bf"], "tags": []}], "date": 1653913050, "git_changesets": [null], "user": "ffxbld-merge"}, "272": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 9cbe8ffa12101019dbe0da698f869ed3ef0b9370 with FIREFOX_91_10_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "33772715e1d964e7c23bb644549a6789a1ec99c7", "parents": ["6694878faa1ef3739a1fd92df66c7811a83aec2d"], "tags": []}], "date": 1654001658, "git_changesets": [null], "user": "ffxbld"}, "273": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_91_9_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_91_9_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "eecc8f98f9db5579b6b75b66caf1dbd8cdac7cd5", "parents": ["262b3b86a564b17e3397b519488698bc530f0858"], "tags": []}], "date": 1654013256, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "274": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147639", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "b848041ae7cbc034f7c689186532a36fc5bf86ae", "parents": ["33772715e1d964e7c23bb644549a6789a1ec99c7"], "tags": []}], "date": 1654026905, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "275": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148108", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "290368ea3f964b7ce58d41785353cd89f12e37ef", "parents": ["b848041ae7cbc034f7c689186532a36fc5bf86ae"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1754752 - Use initializer lists in some swgl constructors. r=lsalzman, a=RyanVM\n\nWe call it from another constexpr function. Clang seems to not be so\nstrict about this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139078", "files": ["gfx/wr/swgl/src/glsl.h"], "git_node": null, "git_parents": [null], "node": "01e56a25d098b9c52668b1113ac05fdbb7db6d88", "parents": ["290368ea3f964b7ce58d41785353cd89f12e37ef"], "tags": []}], "date": 1654177019, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "276": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148382", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "7d7f87541d85dba7a40ad7762a3db77da35c9246", "parents": ["01e56a25d098b9c52668b1113ac05fdbb7db6d88"], "tags": []}, {"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1692724: More don't spawn a second save thread if one already exists. r=mccr8, a=RyanVM\n\nBug 1610246 handled this for the other caller of StartCacheWrite. The idea\nbehind not adding an explicit check was that `mSaveComplete` should usually\nimply `!mSaveThread`. However, when there's nothing in the cache to save,\n`PrepareCacheWriteInternal` sets `mSaveComplete` to true before the save\nthread shuts down. And when we have two cache flushes in the same session due\nto multiple extension upgrades, that can lead to us hitting the cache flush\ncodepath in the middle of that critical period.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D121130", "files": ["js/xpconnect/loader/ScriptPreloader.cpp"], "git_node": null, "git_parents": [null], "node": "be257bfe50e731d1c724b4951c1adc592452d0a5", "parents": ["7d7f87541d85dba7a40ad7762a3db77da35c9246"], "tags": []}, {"author": "Scott \u003cscott.downe@gmail.com\u003e", "branch": "default", "desc": "Bug 1771026 - Remove some dead tagging code in Pocket panels. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147426", "files": ["browser/components/pocket/content/pktApi.jsm", "browser/components/pocket/test/unit/browser_pocket_AboutPocketParent.js"], "git_node": null, "git_parents": [null], "node": "12db647f112790d21dc84a7bb12babd79e0c98d7", "parents": ["be257bfe50e731d1c724b4951c1adc592452d0a5"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1768537, r=smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D146914", "files": ["docshell/base/nsDocShell.cpp"], "git_node": null, "git_parents": [null], "node": "58aad8bcc032a9f73ac02a0268781b2f6b361dbf", "parents": ["12db647f112790d21dc84a7bb12babd79e0c98d7"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1568275 - Disable deceptive content prefs when locked. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D144476", "files": ["browser/components/preferences/privacy.js", "browser/components/preferences/tests/browser.ini", "browser/components/preferences/tests/browser_security-3.js"], "git_node": null, "git_parents": [null], "node": "5d77dfedefb2a32563a6272d2c1e30273cab3ce8", "parents": ["58aad8bcc032a9f73ac02a0268781b2f6b361dbf"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1771932 - Use more initializer lists in glsl.h. r=gw a=RyanVM\n\nAvoid assigning to fields in the constructor body when it is constexpr.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148093", "files": ["gfx/wr/swgl/src/glsl.h"], "git_node": null, "git_parents": [null], "node": "82c664cc50ead4ffd51d451a1c03ea846ce6da6e", "parents": ["5d77dfedefb2a32563a6272d2c1e30273cab3ce8"], "tags": []}], "date": 1654629271, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "277": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148766", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "3af06cf6af9f3ba5b94d133804c6e17148af63c9", "parents": ["82c664cc50ead4ffd51d451a1c03ea846ce6da6e"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1771381 - Use entries in TabAttributesInternal.set(). r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147457", "files": ["browser/components/sessionstore/TabAttributes.jsm"], "git_node": null, "git_parents": [null], "node": "13afef538349582b3cce5f0ec6c45bc36b9e4143", "parents": ["3af06cf6af9f3ba5b94d133804c6e17148af63c9"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1770123 - Clear PAC loader when the load is failed, r=dragana a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147861", "files": ["netwerk/base/nsPACMan.cpp"], "git_node": null, "git_parents": [null], "node": "d517719645b2c4f29711564b6681cd2fa6c96cc6", "parents": ["13afef538349582b3cce5f0ec6c45bc36b9e4143"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1765951 - Stop storing BC pointer in nsSHistory. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148748", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/shistory/nsSHistory.cpp", "docshell/shistory/nsSHistory.h"], "git_node": null, "git_parents": [null], "node": "26781ac8c675aaf7aaff34ba9362452e9535b565", "parents": ["d517719645b2c4f29711564b6681cd2fa6c96cc6"], "tags": []}], "date": 1654792333, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "278": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149053", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "fb3e6defb37fa5db7ff5ffefe852de3e5b55e8a5", "parents": ["26781ac8c675aaf7aaff34ba9362452e9535b565"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1757604 - Make content-type on JAR channels behave the same as HTTP channels. r=Gijs, a=RyanVM\n\nThat is, treat it as a hint if called before open, and as an override if\ncalled after. Override the hint on open.\n\nThis is a less invasive change that is green on try and also fixes the\nissue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145098", "files": ["modules/libjar/nsJARChannel.cpp", "modules/libjar/nsJARChannel.h", "toolkit/components/backgroundtasks/tests/browser/browser_xpcom_graph_wait.js"], "git_node": null, "git_parents": [null], "node": "dddc25fd9e036de7730025f86a6c426e77d9c330", "parents": ["fb3e6defb37fa5db7ff5ffefe852de3e5b55e8a5"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1770848, r=jaws,mccr8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147116", "files": ["toolkit/components/contentprefs/ContentPrefService2.jsm"], "git_node": null, "git_parents": [null], "node": "91390d8fc1420dcd835def901e198a1487f0efd4", "parents": ["dddc25fd9e036de7730025f86a6c426e77d9c330"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1763634 - part 1: Make `BrowserParent` handle test APIs only when it's in the automated mode. r=smaug, a=RyanVM\n\nMake testing API path work only when it's in the automated test mode.\n\nThe difference point from the patch for mozilla-central is, there was is\n`BrowserParent::RecvSynthesizeNativeTouchpadPan`.  It was introduced in\n92 (bug 1678771).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148241", "files": ["dom/ipc/BrowserParent.cpp"], "git_node": null, "git_parents": [null], "node": "2678ce535dafa6be0c203fcfd6d91f75d52eb05a", "parents": ["91390d8fc1420dcd835def901e198a1487f0efd4"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1763634 - part 2: Make `BrowserParent` verify whether replied keyboard events are what it sent. r=smaug, a=RyanVM\n\nFor making this, `BrowserParent` (temporarily) store sent keyboard events which\nwants reply from the remote process.  Then, when it gets a reply event received,\nit compares whether the event data is broken or not.\n\nThe different point from the patch for mozilla-central is, there was no\n`nsID::GenerateUUID` because it was introduced in 95 (bug 1723674).  Instead,\nthis patch uses `nsIUUIDGenerator::GenerateUUIDInPlace`.  It looks slower\nsince it requires to get the service.  However, it must be fine because this\nis a reply for a users' key operation, i.e., not a hot path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148242\n\nDepends on D148241", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/PBrowser.ipdl", "widget/BasicEvents.h"], "git_node": null, "git_parents": [null], "node": "0637b6cdc012b3bc7579c432e235cda5f022e803", "parents": ["2678ce535dafa6be0c203fcfd6d91f75d52eb05a"], "tags": []}, {"author": "Dennis Jackson \u003cdjackson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1771523 - Add telemetry probe for app signature verification outcomes. r=keeler a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147530", "files": ["security/apps/AppSignatureVerification.cpp", "toolkit/components/telemetry/Histograms.json"], "git_node": null, "git_parents": [null], "node": "1f18a7d6165e6680fbeb3c01aae91c8f515b8cdb", "parents": ["0637b6cdc012b3bc7579c432e235cda5f022e803"], "tags": []}], "date": 1655128425, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "279": {"changesets": [{"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1730375 [wpt PR 30627] - Regenerate WPT certificates, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated regeneration of WPT certificates\n\n--\n\nwpt-commits: f4c59d61b5a33658def0f3ba931ed419dc3476b9\nwpt-pr: 30627", "files": ["testing/web-platform/tests/tools/certs/cacert.key", "testing/web-platform/tests/tools/certs/cacert.pem", "testing/web-platform/tests/tools/certs/web-platform.test.key", "testing/web-platform/tests/tools/certs/web-platform.test.pem", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/chrome_spki_certs.py"], "git_node": null, "git_parents": [null], "node": "956e03120b241b2783a443a7f4ae67b5f6eba8cc", "parents": ["1f18a7d6165e6680fbeb3c01aae91c8f515b8cdb"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1735252 [wpt PR 31197] - Regenerate WPT certificates, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated regeneration of WPT certificates\n\n--\n\nwpt-commits: 2812b9b0e5830b56b1f2a4e00838c0a16b8db004\nwpt-pr: 31197", "files": ["testing/web-platform/tests/tools/certs/cacert.key", "testing/web-platform/tests/tools/certs/cacert.pem", "testing/web-platform/tests/tools/certs/web-platform.test.key", "testing/web-platform/tests/tools/certs/web-platform.test.pem", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/chrome_spki_certs.py"], "git_node": null, "git_parents": [null], "node": "66a352924a596469bc0a91aeca47bdb666a04b73", "parents": ["956e03120b241b2783a443a7f4ae67b5f6eba8cc"], "tags": []}], "date": 1655159319, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "280": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149505", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "d8310fc4eeabd44433ed2391c26a1db3cb8b04d5", "parents": ["66a352924a596469bc0a91aeca47bdb666a04b73"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1497246 - Release-check aCount for underflow in ReplaceElementsAt, r=mccr8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148456", "files": ["xpcom/ds/nsTArray.h"], "git_node": null, "git_parents": [null], "node": "1f239a458a1001051865955e1d821d5686c2781f", "parents": ["d8310fc4eeabd44433ed2391c26a1db3cb8b04d5"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1772651 - Check if the actor is dead in GetOtherInProcessActor, r=mccr8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148540", "files": ["dom/ipc/InProcessImpl.cpp"], "git_node": null, "git_parents": [null], "node": "e3d90ff57e36a5790c8009302be1cf9309a98e1e", "parents": ["1f239a458a1001051865955e1d821d5686c2781f"], "tags": []}], "date": 1655418292, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "281": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 1f239a458a10 (bug 1497246) for bustage.", "files": ["xpcom/ds/nsTArray.h"], "git_node": null, "git_parents": [null], "node": "4c160d5ff9d47197db68283099c51dd5926e2444", "parents": ["e3d90ff57e36a5790c8009302be1cf9309a98e1e"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1497246 - Release-check aCount for underflow in ReplaceElementsAt, r=mccr8 a=RyanVM", "files": ["xpcom/ds/nsTArray.h"], "git_node": null, "git_parents": [null], "node": "60a5196e74adada73150e6519d57ffca3eccd94c", "parents": ["4c160d5ff9d47197db68283099c51dd5926e2444"], "tags": []}], "date": 1655420708, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "282": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1771084 part 2 - Add Realm option to freeze builtins. r=tcampbell,nika a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147281", "files": ["js/public/Realm.h", "js/public/RealmOptions.h", "js/src/jit-test/tests/basic/freeze-builtins.js", "js/src/shell/js.cpp", "js/src/vm/GlobalObject.cpp", "js/src/vm/Realm.cpp"], "git_node": null, "git_parents": [null], "node": "72bca7a337e49a6d4ab8139c1c4944562bc9ad1d", "parents": ["60a5196e74adada73150e6519d57ffca3eccd94c"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1771084 part 3 - Freeze builtins for the shared system global. r=mccr8,peterv a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147305", "files": ["js/xpconnect/loader/mozJSComponentLoader.cpp", "js/xpconnect/tests/browser/browser.ini", "js/xpconnect/tests/browser/browser_freeze_builtins.js"], "git_node": null, "git_parents": [null], "node": "befef01949f209fa5d388eb74840e6e0f93bddc7", "parents": ["72bca7a337e49a6d4ab8139c1c4944562bc9ad1d"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1745595 - type ResizeInt() parameters to specify units. r=stransky, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147727", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "e5a2f9e64dd4305c2b579ca90d4d931d576fba86", "parents": ["befef01949f209fa5d388eb74840e6e0f93bddc7"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1745595 - wait for resize to complete before adding media query. r=daisuke, a=RyanVM\n\nThis and https://phabricator.services.mozilla.com/D147728 may also help with\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1723436\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147731", "files": ["devtools/shared/commands/resource/tests/browser_resources_stylesheets.js"], "git_node": null, "git_parents": [null], "node": "9ce6409adf882dd8c7080d00b1cb81f46da6dc80", "parents": ["e5a2f9e64dd4305c2b579ca90d4d931d576fba86"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1745595 - record window size changes from app-initiated resizes asynchronously after the first size-allocate. r=stransky, a=RyanVM\n\nThis provides a consistent order of bounds changes corresponding to resize\nevent notifications.  Previously the size reported in bounds could bounce as\nrequested sizes were saved, then overwritten in OnSizeAllocate() with\npreviously queued sizes, and then usually eventually rewritten with the final\nsize in OnSizeAllocate() again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147728", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "6a8bbdb2f7634469c1a2d5c9bca26c78cf1c321e", "parents": ["9ce6409adf882dd8c7080d00b1cb81f46da6dc80"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1745595 - wait for expected geometry after move or resize. r=whimboo, a=RyanVM\n\nThe requestAnimationFrame() callback used in IdlePromise() may run sooner than\n1/60 second, providing insufficient time for changes to be effected.\nhttps://searchfox.org/mozilla-central/rev/e567185fa464270f94430e7cf62d134f4df9a69f/layout/base/nsRefreshDriver.cpp#1730-1731\n\nWaiting for the \"resize\" and \"MozUpdateWindowPos\" events should provide\nminimum wait in the common cases that the OS completes the changes requested.\n\nThis change should also resolve\nhttps://bugzilla.mozilla.org/show_bug.cgi?id=1702255\n\nDifferential Revision: https://phabricator.services.mozilla.com/D147729", "files": ["remote/marionette/driver.js", "remote/marionette/sync.js"], "git_node": null, "git_parents": [null], "node": "f3193a7893f375bd48147e99659ad0bb88a11eab", "parents": ["6a8bbdb2f7634469c1a2d5c9bca26c78cf1c321e"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1745595 - wait for resize to complete before testing className. r=Mardak, a=RyanVM\n\nThis uses the same approach as in D147730.\nThe test was removed on newer branches by D127252.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149576", "files": ["browser/components/tests/browser/browser_browserGlue_upgradeDialog_resize.js"], "git_node": null, "git_parents": [null], "node": "a183595253d282a7ee0b760e9445b99a4ff2cc58", "parents": ["f3193a7893f375bd48147e99659ad0bb88a11eab"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1727653 - wait for resize event before testing restoration of persisted sizes. r=niklas, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149329", "files": ["toolkit/content/tests/chrome/test_navigate_persist.html"], "git_node": null, "git_parents": [null], "node": "cec32c7ec3acf7e8f2afa89ee287b2c6f5e6db81", "parents": ["a183595253d282a7ee0b760e9445b99a4ff2cc58"], "tags": ["FIREFOX_91_11_0esr_BUILD1"]}], "date": 1655494284, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "283": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging cec32c7ec3acf7e8f2afa89ee287b2c6f5e6db81 with FIREFOX_91_11_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "255124d762161f7bcb8841ea4cbb4da6bcd8b226", "parents": ["cec32c7ec3acf7e8f2afa89ee287b2c6f5e6db81"], "tags": []}], "date": 1655752982, "git_changesets": [null], "user": "ffxbld"}, "284": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1773717, r=dveditz a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149404", "files": ["modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "7ac9b20c412b4641bd732e789a3be532fe3d4c43", "parents": ["255124d762161f7bcb8841ea4cbb4da6bcd8b226"], "tags": ["FIREFOX_91_11_0esr_BUILD2", "FIREFOX_91_11_0esr_RELEASE"]}], "date": 1655967078, "git_changesets": [null], "user": "pchevrel@mozilla.com"}}
