634724771fa101833fccac4751912f47"], "node": "06d42ee0455f3680d9cdc0eb6de8d3f72436164d", "parents": ["be6c3d947f2e9eab13808605e4d3c31ddd6258c4"], "tags": []}], "date": 1792746207, "git_changesets": ["72d9753f634724771fa101833fccac4751912f47", "856b10a3b90d9f0e8e3ab949fed1802758647095"], "user": "ffxbld@lando.moz.tools"}, "29125": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083386 - Add a pref to stream directly to the print output destination.  a=dmeehan\n\nPref off defaults to the current behavior, but I think this should\ngenerally be better behavior. I guess main issue is what happens if\nwe crash mid-print or so?\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335803\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336327\n", "files": ["gfx/thebes/PrintTargetSkPDF.cpp", "gfx/thebes/PrintTargetSkPDF.h", "modules/libpref/init/StaticPrefList.yaml", "widget/cocoa/nsDeviceContextSpecX.h", "widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "8471a3debbac9e784b8ba8fbfc3ca18d35f6e1fd", "git_parents": ["856b10a3b90d9f0e8e3ab949fed1802758647095"], "node": "520cb9248b04e00eb31036df14c496c21cf857ef", "parents": ["06d42ee0455f3680d9cdc0eb6de8d3f72436164d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083386 - Add a debug setting to always print via the print session.  a=dmeehan\n\nThis is useful to debug this and other driver issues.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335804\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336328\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "7bc3d6e8da70027ec7b60db71e1b23b5c4184f49", "git_parents": ["8471a3debbac9e784b8ba8fbfc3ca18d35f6e1fd"], "node": "485cf0a73a4ba2447c4772089bfc06ea67632400", "parents": ["520cb9248b04e00eb31036df14c496c21cf857ef"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083386 - Test the atomic file stream codepath.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336028\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336329\n", "files": ["toolkit/components/printing/tests/browser_print_stream.js"], "git_node": "61f02c8b1e27877e9b8b9680ab680e37c8fc0deb", "git_parents": ["7bc3d6e8da70027ec7b60db71e1b23b5c4184f49"], "node": "79c8d9c17542e4071960beec672997aed623eac1", "parents": ["485cf0a73a4ba2447c4772089bfc06ea67632400"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084053 - Send explicit page count down to the driver.  a=dmeehan\n\nSee diagnostics on the bug.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336003\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336330\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "widget/cocoa/nsDeviceContextSpecX.h", "widget/cocoa/nsDeviceContextSpecX.mm"], "git_node": "fa833a38f7124ca4cc15e0060284d44cc384f4bf", "git_parents": ["61f02c8b1e27877e9b8b9680ab680e37c8fc0deb"], "node": "31742050d8da843093038441bee401b9179683c4", "parents": ["79c8d9c17542e4071960beec672997aed623eac1"], "tags": []}], "date": 1792758532, "git_changesets": ["8471a3debbac9e784b8ba8fbfc3ca18d35f6e1fd", "7bc3d6e8da70027ec7b60db71e1b23b5c4184f49", "61f02c8b1e27877e9b8b9680ab680e37c8fc0deb", "fa833a38f7124ca4cc15e0060284d44cc384f4bf"], "user": "dmeehan@mozilla.com"}, "29126": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2082900. Create DrawTargetWebgl render textures as ANGLE render targets up front.  a=dmeehan\n\nhttps://searchfox.org/firefox-main/rev/4523d65b575546e2b588dfb8b91e3d94ebeec19a/dom/canvas/DrawTargetWebgl.cpp#2746\n\nWe allocate DrawTargetWebgl's render textures with TexStorage and no usage\nhint, so ANGLE's D3D backend creates non-render-target storage for them and\nthen recreates it as render target storage the first time we attach the\ntexture to a framebuffer. The ANGLE update in bug 2079951 picked up\nhttps://github.com/google/angle/commit/17c57c6066ac, which makes recreating\nthe storage also copy the old contents back into staging textures. That\nregressed pdfpaint on Windows by up to 39%.\n\nAdd WebGLContext::HintTexRenderTarget, which sets GL_TEXTURE_USAGE_ANGLE to\nGL_FRAMEBUFFER_ATTACHMENT_ANGLE on D3D ANGLE, and call it before TexStorage\nin BindAndInitRenderTex so ANGLE creates render target storage from the\nstart. It is only for DrawTargetWebgl and is not exposed to content. Every\ncaller of BindAndInitRenderTex attaches the texture to a framebuffer, so the\nnon-render-target storage was never useful. On try this fixes the regressed\npdfpaint tests and leaves them faster than before the ANGLE update.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335528\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336338\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextTextures.cpp"], "git_node": "63fa82d671c900f72c8234a494a7c076b1feb040", "git_parents": ["fa833a38f7124ca4cc15e0060284d44cc384f4bf"], "node": "bff6925324155c4d4d86f0b5f4d2595106264051", "parents": ["31742050d8da843093038441bee401b9179683c4"], "tags": []}], "date": 1792758558, "git_changesets": ["63fa82d671c900f72c8234a494a7c076b1feb040"], "user": "dmeehan@mozilla.com"}, "29127": {"changesets": [{"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084960 - Fix green video.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336148\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336174\n", "files": ["gfx/webrender_bindings/RenderD3D11TextureHost.cpp"], "git_node": "ad9ea6fa494cca6179421519f440445fad615492", "git_parents": ["63fa82d671c900f72c8234a494a7c076b1feb040"], "node": "46ea5d0443787e661da44f215c4c3c49ff850526", "parents": ["bff6925324155c4d4d86f0b5f4d2595106264051"], "tags": []}], "date": 1792758601, "git_changesets": ["ad9ea6fa494cca6179421519f440445fad615492"], "user": "dmeehan@mozilla.com"}, "29128": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2080420 - Tighten matching of early hint preloads to their consumers  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335126\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336160\n", "files": ["netwerk/protocol/http/EarlyHintPreloader.cpp", "netwerk/protocol/http/EarlyHintPreloader.h", "netwerk/protocol/http/EarlyHintRegistrar.cpp", "netwerk/protocol/http/EarlyHintRegistrar.h", "netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": "732101df29aa583c0f12ea7b680857efeb04e1dc", "git_parents": ["ad9ea6fa494cca6179421519f440445fad615492"], "node": "2ad64d176b6e9d85331565ac4b0c7b206523f70a", "parents": ["46ea5d0443787e661da44f215c4c3c49ff850526"], "tags": []}], "date": 1792759912, "git_changesets": ["732101df29aa583c0f12ea7b680857efeb04e1dc"], "user": "dmeehan@mozilla.com"}, "29129": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/feature/importer/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/protection-dashboard/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/lib/crash/src/main/res/values-sk/strings.xml", "mobile/android/fe