/languages.mjs", "browser/components/preferences/tests/languages/browser_browser_languages_fallback.js"], "git_node": "511d52fafc09cb2a3460355188278b54bc92e499", "git_parents": ["957ecaadaeca96da6f2a39c5f33bc9abfc8b825e"], "node": "8b9275f4fc3cd23beb1f9bb35e1e8ef7f8a84d6e", "parents": ["e81453f6138ee3966cea4406d82005439b581733"], "tags": []}], "date": 1793205451, "git_changesets": ["511d52fafc09cb2a3460355188278b54bc92e499"], "user": "dmeehan@mozilla.com"}, "29186": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082039 - Hold strong reference to ImageListener and requests during OnStartRequest  a=dmeehan\n\nDuring ImageListener::OnStartRequest -\u003e AddNativeObserver, ReplayImageStatus calls can make things happen on the event loop, which potentially can invalidate weak references.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334458\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337561\n", "files": ["dom/base/crashtests/2082038.html", "dom/base/crashtests/crashtests.list", "dom/base/nsImageLoadingContent.cpp", "dom/html/ImageDocument.cpp"], "git_node": "79e07af8f6c22fc3b54a47bac0876e27180850af", "git_parents": ["511d52fafc09cb2a3460355188278b54bc92e499"], "node": "f929bb36bc5f526b639ffe15106a086e4341a7f8", "parents": ["8b9275f4fc3cd23beb1f9bb35e1e8ef7f8a84d6e"], "tags": []}], "date": 1793205504, "git_changesets": ["79e07af8f6c22fc3b54a47bac0876e27180850af"], "user": "dmeehan@mozilla.com"}, "29187": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2084560. Fix libyuv link failure on 32-bit x86 non-Windows builds.  a=dmeehan\n\nSince the update to 9456b062, libyuv implements the transpose functions for\n32-bit x86 only in rotate_win.cc, on any OS and compiler. But libyuv.gyp sets\nchromium_code, which pulls in filename_rules.gypi, and that excludes *_win.cc\non non-Windows. Upstream's GN and CMake builds compile these files everywhere\nand rely on their #if guards, so we do the same.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335939\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337535\n", "files": ["media/libyuv/05_include_win_sources_on_all_platforms.patch", "media/libyuv/libyuv/libyuv.gyp", "media/libyuv/moz.yaml"], "git_node": "1b95f6d65ffa23b891fd995184e302dbb41dd782", "git_parents": ["79e07af8f6c22fc3b54a47bac0876e27180850af"], "node": "56c16590bff998358086e43db165d472280890e8", "parents": ["f929bb36bc5f526b639ffe15106a086e4341a7f8"], "tags": []}], "date": 1793205547, "git_changesets": ["1b95f6d65ffa23b891fd995184e302dbb41dd782"], "user": "dmeehan@mozilla.com"}, "29188": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2086062 - Make SVGContextPaint refcounting threadsafe  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337102\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337462\n", "files": ["layout/svg/SVGContextPaint.h"], "git_node": "08213e3d8766a53c1e074a0e9a14d63723b94cce", "git_parents": ["1b95f6d65ffa23b891fd995184e302dbb41dd782"], "node": "ee9e4aa3e86379b1f6169085ec4bb87a20fa60aa", "parents": ["56c16590bff998358086e43db165d472280890e8"], "tags": []}], "date": 1793205593, "git_changesets": ["08213e3d8766a53c1e074a0e9a14d63723b94cce"], "user": "dmeehan@mozilla.com"}, "29189": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082033 - Don't fire events sync for pending load triggers.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336732\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337491\n", "files": ["layout/style/Loader.cpp", "layout/style/Loader.h", "layout/style/SharedStyleSheetCache.cpp", "layout/style/SharedStyleSheetCache.h", "layout/style/SheetLoadData.h", "layout/style/StreamLoader.cpp"]