u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nsq -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nsr -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nsv-SE -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nta -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nte -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nth -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\ntl -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\ntr -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\ntrs -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nuk -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nur -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nuz -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nvi -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nwo -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nxh -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nzam -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nzh-CN -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\nzh-TW -\u003e 70b1b115fce798fd8abf71969bd6d7605d14d689\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "a26f71c88198ce2b5d45aaee9a556a7348956b36", "git_parents": ["b4ae89e249a1167ad8bee0b7e9bb28f338f6c38c"], "node": "c518c570183f97a8290f1dcfe32c619ead4acf7f", "parents": ["417d43e990b426948a8c167f8a82d26e18234014"], "tags": []}], "date": 1792832636, "git_changesets": ["b4ae89e249a1167ad8bee0b7e9bb28f338f6c38c", "a26f71c88198ce2b5d45aaee9a556a7348956b36"], "user": "ffxbld@lando.moz.tools"}, "29131": {"changesets": [{"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072942 - Decrease the urlbar row gutter in compact uidensity mode.  a=dmeehan\n\nAll this does is make the row gutter smaller in compact mode.\n\nThe spec [1] says rows should be 28px tall in compact mode, and I think it shows\nthe row gutter at 2px.\n\nOn Windows at 100% scale, the current visible row height in normal and compact\ndensities is already 28.5px. The visible height is determined by the font size\nand `--urlbarview-row-padding-block`, whose value is `--space-small`. Changing\nit to `--space-xsmall` drops the height to 23px, which seems too small and cuts\ncuts off the bottom of chiclets. So I think we're good on visible row height.\n\nThe current gutter is 2.7px. The gutter is determined by\n`--urlbarview-row-gutter`, whose value is `--space-xsmall`. Changing it to\n`--space-xxsmall` drops it to 1.4px. A little smaller than 2px but visually it\nmight as well be, it looks reasonable, and it noticeably decreases the height of\nthe panel.\n\n[1] https://www.figma.com/design/XT0eDYh4RtbMNWaYQi0efM/Chrome-Sidebar-UX-Specifications--Sprint-1-?m=auto&node-id=13742-77617&t=0nlbmpOK3tGUU1Tv-1\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336096\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336404\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "96784f757d91dd7ca8f8707f22a94f1463e50bdc", "git_parents": ["a26f71c88198ce2b5d45aaee9a556a7348956b36"], "node": "b240efd54e23e3fd0702cfdd79e31a521abe8e92", "parents": ["c518c570183f97a8290f1dcfe32c619ead4acf7f"], "tags": []}], "date": 1792846418, "git_changesets": ["96784f757d91dd7ca8f8707f22a94f1463e50bdc"], "user": "dmeehan@mozilla.com"}, "29132": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2084640. Don't reuse cached path patterns at a different offset from the path.  a=dmeehan\n\nhttps://searchfox.org/firefox-main/rev/034cd8a8207e38b04afec5e6f75e5161f75a112f/dom/canvas/DrawTargetWebgl.cpp#4540\n\nPathCacheEntry::MatchesPath ignores translation, assuming the pattern moves\nwith the path. That isn't true when the path stays put in device space and\nonly the pattern moves, e.g. pdf.js filling the whole canvas with a translated\nradial gradient for each shading, so we reused the first draw's texture for\nthe others. This was hidden until bug 2072448 let gradient patterns match in\nthe cache. Record the quantized offset of the pattern relative to the path\nwhenever the pattern is rasterized into an entry's texture, and require it to\nmatch for entries with a baked texture. Entries that only cache WGR vertex\ngeometry draw with the live pattern, so they are unaffected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336152\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336494\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebgl.h", "dom/canvas/DrawTargetWebglInternal.h", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat-expected.html", "testing/web-platform/tests/html/canvas/element/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat-expected.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.html", "testing/web-platform/tests/html/canvas/offscreen/fill-and-stroke-styles/2d.gradient.radial.transform.translated.repeat.w.html", "testing/web-platform/tests/html/canvas/tools/yaml/fill-and-stroke-styles.yaml"], "git_node": "9aa2a137646aa5eccf0c9463d3b8a64a36d45bbe", "git_parents": ["96784f757d91dd7ca8f8707f22a94f1463e50bdc"], "node": "4f3f53c37d67e0e37a1d2da149640a46d613b47b", "parents": ["b240efd54e23e3fd0702cfdd79e31a521abe8e92"], "tags": []}], "date": 1792846825, "git_changesets": ["9aa2a137646aa5eccf0c9463d3b8a64a36d45bbe"], "user": "dmeehan@mozilla.com"}, "29133": {"changesets": [{"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078993 - Don't run scripts between updating two carets.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336063\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336491\n", "files": ["layout/base/AccessibleCaretManager.cpp"], "git_node": "768e3a5a35931a5af4fc31e7ad46cef837d7816d", "git_parents": ["9aa2a137646aa5eccf0c9463d3b8a64a36d45bbe"], "node": "b877950f089fb6532a3b4f062ffe19fc07e7c739", "parents": ["4f3f53c37d67e0e37a1d2da149640a46d613b47b"], "tags": []}], "date": 1792847004, "git_changesets": ["768e3a5a35931a5af4fc31e7ad46cef837d7816d"], "user": "dmeehan@mozilla.com"}, "29134": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2084963 - Honor the per-page size in PrintTargetSkPDF::BeginPage.  a=dmeehan DONTBUILD\n\nLike PrintTargetPDF used to do. We had no test at all for this pref,\namazing.\n\nAdd a browser test based on the one in comment 1 but rewritten to avoid\nhaving to do the temporary file dance or manually parse PDFs.\n\nCo-authored-by: Josh Pieper \u003cjjp@pobox.com\u003e\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336337\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336400\n", "files": ["gfx/thebes/PrintTargetSkPDF.cpp", "testing/web-platform/meta/css/css-page/page-name-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-landscape-001-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-002-print.html.ini", "testing/web-platform/meta/css/css-page/page-orientation-on-portrait-003-print.html.ini", "testing/web-platform/meta/css/css-page/page-size-015-print.tentative.html.ini", "toolkit/components/printing/tests/browser.toml", "toolkit/components/printing/tests/browser_print_page_size_output.js", "toolkit/components/printing/tests/page_size_mixed.html"], "git_node": "54778cd16b075e8bb96a1c1fffc793977d3a3137", "git_parents": ["768e3a5a35931a5af4fc31e7ad46cef837d7816d"], "node": "4d4fe1e7f475f35c43454cb3b88ea9dea26a0122", "parents": ["b877950f089fb6532a3b4f062ffe19fc07e7c739"], "tags": []}], "date": 1792847138, "git_changesets": ["54778cd16b075e8bb96a1c1fffc793977d3a3137"], "user": "dmeehan@