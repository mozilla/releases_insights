["1d115bbb7db2853c61e94e7d826475a1ced61c19"], "node": "a5ac6f858ad3142ced676f1eedbe2cda39617933", "parents": ["f3a6f04b59ebca5a14ae474c0046e4df9b1c251c"], "tags": []}], "date": 1793105315, "git_changesets": ["da335f059663b618f511a7bb6df3b9ee1d28355b"], "user": "ffxbld@lando.moz.tools"}, "29161": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5add844c26613d7e4d84c799d6e23cf987b1240d with FIREFOX_159_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "0b519fe6a6cad1c83a387daebb74370b452b8749", "git_parents": ["da335f059663b618f511a7bb6df3b9ee1d28355b"], "node": "0e984706496ec6382b9ebdd1e26e8b5691f6bb8c", "parents": ["a5ac6f858ad3142ced676f1eedbe2cda39617933"], "tags": []}], "date": 1793105752, "git_changesets": ["0b519fe6a6cad1c83a387daebb74370b452b8749"], "user": "ffxbld@lando.moz.tools"}, "29162": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079715 - Check for content type before using content type hint  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336386\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336762\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "8ac41645fcf776dcb87a37dd67b36521326ec8e0", "git_parents": ["9cd896ed03ad2b4b386217966abb4026db7ff9e7"], "node": "ac84cfad5ee2a3dc0e4c45f6ed82703f948646d2", "parents": ["377e36e71cd42bbc1ca6d88d43ba72b6abc235a2"], "tags": []}], "date": 1793106081, "git_changesets": ["8ac41645fcf776dcb87a37dd67b36521326ec8e0"], "user": "dmeehan@mozilla.com"}, "29163": {"changesets": [{"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2085210 - Simplify `String.toLocale()` and handle complex BCP-47 language tags  a=dmeehan\n\nReplaces custom string-splitting in `String.toLocale()` by normalizing underscores to hyphens and delegating to `Locale.forLanguageTag()`. This ensures language tags containing scripts, variants, or Unicode extensions are properly parsed, and returns `Locale.ROOT` for blank input strings.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/411\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337099\n", "files": ["mobile/android/android-components/components/support/locale/src/main/java/mozilla/components/support/locale/Extensions.kt", "mobile/android/android-components/components/support/locale/src/test/java/mozilla/components/support/locale/ExtensionsTest.kt"], "git_node": "e6d4ed2fbbe32ad9d8c118fae449a18c6a3758b8", "git_parents": ["8ac41645fcf776dcb87a37dd67b36521326ec8e0"], "node": "6875bf78a5648dbe177733785b8085f78cd4ebaf", "parents": ["ac84cfad5ee2a3dc0e4c45f6ed82703f948646d2"], "tags": []}], "date": 1793106103, "git_changesets": ["e6d4ed2fbbe32ad9d8c118fae449a18c6a3758b8"], "user": "dmeehan@mozilla.com"}, "29164": {"changesets": [{"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2085424 - [devtools] Remove deprecated screenshot codepath.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336737\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337124\n", "files": ["devtools/client/definitions.js", "devtools/client/fronts/inspector.js", "devtools/client/shared/screenshot.js", "devtools/client/webconsole/actions/input.js"], "git_node": "b5cdda698541f4ee002b0ec541ee3cf147897595", "git_parents": ["e6d4ed2fbbe32ad9d8c118fae449a18c6a3758b8"], "node": "41260d86133c97db65eb494b89315b4e7ed8d562", "parents": ["6875bf78a5648dbe177733785b8085f78cd4ebaf"], "tags": []}], "date": 1793109126, "git_changesets": ["b5cdda698541f4ee002b0ec541ee3cf147897595"], "user": "dmeehan@mozilla.com"}, "29165": {"changesets": [{"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082634 - Set max width of newtab to match moz-search  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336757\n", "files": ["browser/components/asrouter/content-src/components/asrouter-newtab-multistage/asrouter-newtab-multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/extensions/newtab/content-src/components/Base/_Base.scss"], "git_node": "9d93879030d437ce7c94c580bc95e45bce9832fb", "git_parents": ["b5cdda698541f4ee002b0ec541ee3cf147897595"], "node": "7a7f4a4dce35bc2d6d4d5800145444459f059843", "parents": ["41260d86133c97db65eb494b89315b4e7ed8d562"], "tags": []}], "date": 1793124711, "git_changesets": ["9d93879030d437ce7c94c580bc95e45bce9832fb"], "user": "dmeehan@mozilla.com"}, "29166": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056107 - Validate IsKnownForChildID in RecvCreateBrowsingContext,  a=dmeehan\n\nThis isn't necessary for the parent because of the earlier check\n(parent-\u003eGetIsContentParent() != this).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313545\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337197\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "f4ce43295bc2452e56ce1a2e51977f0ec0b67d03", "git_parents": ["9d93879030d437ce7c94c580bc95e45bce9832fb"], "node": "6a96d8f7c500000417ad6d9f1d088c776ba7c22f", "parents": ["7a7f4a4dce35bc2d6d4d5800145444459f059843"], "tags": []}], "date": 1793124755, "git_changesets": ["f4ce43295bc2452e56ce1a2e51977f0ec0b67d03"], "user": "dmeehan@mozilla.com"}, "29167": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2072096 - Part 1: Ensure all blob:null URIs hold consistent principals,  a=dmeehan\n\nAdds an extra table which is tracked within the protocol handler to\ntrack associations between blob: URLs, and their content principals, to\nensure that they remain consistent. This is tracked by the Blob data\nentry as well as all parsed Blob URLs within the process.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331351\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337204\n", "files": ["dom/file/uri/BlobURL.cpp", "dom/file/uri/BlobURL.h", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/file/uri/BlobURLProtocolHandler.h", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentParent.cpp"], "git_node": "c90b453f93ea5e5b81c8936eba6b894561c30097", "git_parents": ["f4ce43295bc2452e56ce1a2e51977f0ec0b67d03"], "node": "5a0dcc97bfe2135c51e5d91266481a82d674dfcd", "parents": ["6a96d8f7c500000417ad6d9f1d088c776ba7c22f"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2072096 - Part 2: Clarify meaning of BlobURL::GetNullPrincipal,  a=dmeehan\n\nThe type is now explicitly `NullOrigin` to make it more clear that it\ncan also apply to content principals in addition to null principals in\nthe case where the origin doesn't have a web-exposed origin\nserialization (e.g. `file://` URIs).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333748\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337205\n", "files": ["dom/file/uri/BlobURL.cpp", "dom/file/uri/BlobURL.h", "dom/file/uri/BlobURLProtocolHandler.cpp", "dom/file/uri/BlobURLProtocolHandler.h", "ipc/glue/URIParams.ipdlh"], "git_node": "d983351206b2d565fae6a570ea57353bb72f433f", "git_parents": ["c90b453f93ea5e5b81c8936eba6b894561c30097"], "node": "c094bee77d3846f7c81fa05e603b5d5b2906e7f5", "parents": ["5a0dcc97bfe2135c51e5d91266481a82d674dfcd"], "tags": []}], "date": 1793125468, "git_changesets": ["c90b453f93ea5e5b81c8936eba6b894561c30097", "d983351206b2d565fae6a570ea57353bb72f433f"], "user": "dmeehan@mozilla.com"}, "29168": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2060230 - Consider TriggeringRemoteType in IsolationOptionsForNavigation,  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333354\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337203\n", "files": ["dom/ipc/ProcessIsolation.cpp"], "git_node": "425eb6936ccbff5ec851c1d70ae207d11de94f64", "git_parents": ["d983351206b2d565fae6a570ea57353bb72f433f"], "node": "95fcf6506c26696551d949d71775dfd80e021efa", "parents": ["c094bee77d3846f7c81fa05e603b5d5b2906e7f5"], "tags": []}], "date": 1793136700, "git_changesets": ["425eb6936ccbff5ec851c1d70ae207d11de94f64"], "user": "dmeehan@mozilla.com"}, "29169": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081982.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335399\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337221\n", "files": ["layout/style/StyleSheet.cpp"], "git_node": "acd89e7f06ede6e70b88f7c58a8e168f2aa9b0ce", "git_parents": ["425eb6936ccbff5ec851c1d70ae207d11de94f64"], "node": "9e5486a746d26849dc9abb7d4ff0db4c82a3c3e8", "parents": ["95fcf6506c26696551d949d71775dfd80e021efa"], "tags": []}], "date": 1793136745, "git_changesets": ["acd89e7f06ede6e70b88f7c58a8e168f2aa9b0ce"], "user": "dmeehan@mozilla.com"}, "29170": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2082205 - Make `HTMLEditor::ReapplyCachedStyles` clone the cached style while it computes the preserving styles  a=dmeehan\n\nThat requires to flush pending notifications at computing current style.\nTherefore, it should clone the cached styles first. Then, it should\nhandle only the original caches styles.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334438\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337350\n", "files": ["editor/libeditor/HTMLEditSubActionHandler.cpp"], "git_node": "c73b5c2f58396a12