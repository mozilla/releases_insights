cpp", "intl/components/gtest/moz.build", "intl/components/src/Calendar.cpp", "intl/components/src/DateIntervalFormat.cpp", "intl/components/src/DateTimeFormat.cpp", "intl/components/src/TimeZone.cpp", "intl/components/src/TimeZone.h", "js/src/tests/non262/Date/realm-time-zone-legacy-posix.js", "js/src/tests/non262/Date/time-zones-legacy-posix.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_legacy_posix.js", "js/src/vm/DateTime.cpp"], "git_node": "26e4769a7e7bafdb18a82eed92af6f930cbd83cc", "git_parents": ["6cc7605bec8de9b73c24c8b2f44f6f3355d7972b"], "node": "43820959ffb104d435dcaa86b9b990c3bba01c05", "parents": ["3be954b024b63717db19b041aa7f41b67fb4cf8e"], "tags": []}], "date": 1793712443, "git_changesets": ["26e4769a7e7bafdb18a82eed92af6f930cbd83cc"], "user": "dmeehan@mozilla.com"}, "29268": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083626:  gate the optimized jar layout behind an explicit opt-in  a=dmeehan\n\nBuildFileList's offset-4 \"optimized jar layout\" shortcut (bug 559961) was\ngated only on XRE_IsParentProcess(), not on whether the file is actually\nour own omni.jar.\n\nAdd aAllowOptimizedLayout to nsZipArchive::OpenArchive, defaulting to\nfalse, and have Omnijar pass true, since it already knows the file is our\nown omni.jar. Every other caller now always uses the standard EOCD-based\nparse.\n\nAlso updates test_corrupt_1801102.js: its fixture happens to have a\nCentral Directory signature at offset 4, so it's now rejected at open()\ninstead of later during test().\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335617\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338766\n", "files": ["modules/libjar/nsZipArchive.cpp", "modules/libjar/nsZipArchive.h", "modules/libjar/test/unit/test_corrupt_1801102.js", "xpcom/build/Omnijar.cpp"], "git_node": "4bb7edd4587c95f9682c3c5610bcf1a0b0af8335", "git_parents": ["26e4769a7e7bafdb18a82eed92af6f930cbd83cc"], 