47ae8a"], "user": "dmeehan@mozilla.com"}, "29245": {"changesets": [{"author": "theidkamp \u003ctheidkamp@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087534 - Stop prompting for the primary password at startup to migrate logins after it was canceled a configurable number of times.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338328\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338523\n", "files": ["modules/libpref/init/all.js", "toolkit/components/passwordmgr/LoginStorageMigrator.sys.mjs", "toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/test/unit/test_LoginStorageMigrator.js"], "git_node": "55acde7e8dd30d56f57c5988111040e9a06c6650", "git_parents": ["de1a709392da8c378710510562781a441a47ae8a"], "node": "788a5b0e4197a891e2d5d3495eff61eea489ad66", "parents": ["bda9e988bd91283a9be4063dbc4553442f24ca5d"], "tags": []}], "date": 1793544312, "git_changesets": ["55acde7e8dd30d56f57c5988111040e9a06c6650"], "user": "dmeehan@mozilla.com"}, "29246": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings tld-suffixes ct-logs  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338611\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "037347862d0f2681635b546fcea3ec1fd19c283d", "git_parents": ["55acde7e8dd30d56f57c5988111040e9a06c6650"], "node": "89f20f27d9ea42781f784d518852a6535b6bc795", "parents": ["788a5b0e4197a891e2d5d3495eff61eea489ad66"], "tags": []}], "date": 1793565463, "git_changesets": ["037347862d0f2681635b546fcea3ec1fd19c283d"], "user": "rvandermeulen@mozilla.com"}, "29247": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2082075 - Make `SelectionMovementUtils::PeekOffsetForCaretMove` adjust the result of `GetPrimaryFrameForCaret` outside generated content  a=dmeehan\n\n`SelectionMovementUtils::GetPrimaryFrameForCaret` may dive into\ngenerate content nodes because its callers may require generated text\naround the selection to show caret or some other UI. However,\n`SelectionMovementUtils::PeekOffsetForCaretMove` shouldn't return\ngenerated content nodes because the result may be used for new selection\nrange boundary. Therefore, after calling `GetPrimaryFrameForCaret`, it\nneeds to ensure the point is outside any generated content and peeks\noffset from there.\n\nNote that the new code does not handle the position in\n`TreeKind::FlatForSelection` intentionally because\n`nsFrameSelection::MoveCaret` which is the primary caller of\n`SelectionMovementUtils::PeekOffsetForCaretMove` handles `TreeKind::DOM`\ntree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336965\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338626\n", "files": ["layout/generic/SelectionMovementUtils.cpp", "layout/generic/SelectionMovementUtils.h", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h"], "git_node": "5a7b0a9b02b747f39e2317198e44439e55d92eb2", "git_parents": ["037347862d0f2681635b546fcea3ec1fd19c283d"], "node": "c3443027470fc5a0397574dd7cde0bc86f80992e", "parents": ["89f20f27d9ea42781f784d518852a6535b6bc795"], "tags": []}], "date": 1793581254, "git_changesets": ["5a7b0a9b02b747f39e2317198e44439e55d92eb2"], "user": "dmeehan@mozilla.com"}, "29248": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-eu/strings.xml",