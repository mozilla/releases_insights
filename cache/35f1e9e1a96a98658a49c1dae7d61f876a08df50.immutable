bbc5dd9a2b1761abdade6801bbd0daab531f36", "1d7e5019e2dc36b585fb77f02823144100b9d291"], "user": "ffxbld@lando.moz.tools"}, "29233": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087365 - Give exactly the Android Components modules with Robolectric tests a robolectric.properties.  a=dmeehan\n\nThe next patch uses the file to decide which build-components tasks need Robolectric's android-all jars. The\nremoved files belonged to modules without Robolectric tests. lib-accelerometer-sensormanager's class-level\n@Config keeps its SDK.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338439\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338526\n", "files": ["mobile/android/android-components/components/compose/engine/src/test/resources/robolectric.properties", "mobile/android/android-components/components/compose/tabstray/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/base/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/bookmarks-parser/src/test/resources/robolectric.properties", "mobile/android/android-components/components/concept/push/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/example/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/protection-dashboard/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/screendetection/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/tab-collections/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/webauthn/src/test/resources/robolectric.properties", "mobile/android/android-components/components/feature/webcompat/src/test/resources/robolectric.properties", "mobile/android/android-components/components/lib/accelerometer-sensormanager/src/test/resources/robolectric.properties", "mobile/android/android-components/components/lib/bookmark-parser-jsoup/src/test/resources/robolectric.properties", "mobile/android/android-components/components/service/firefox-relay/src/test/resources/robolectric.properties", "mobile/android/android-components/components/service/glean/src/test/resources/robolectric.properties", "mobile/android/android-components/components/service/merino-weather/src/test/resources/robolectric.properties", "mobile/android/android-components/components/service/sync/src/test/resources/robolectric.properties", "mobile/android/android-components/components/support/license/src/test/resources/robolectric.properties"], "git_node": "37a6bef0b41a079aea613192e9af956b8fd6e32f", "git_parents": ["1d7e5019e2dc36b585fb77f02823144100b9d291"], "node": "9ec5bbb23d3e7007e3672510d0a44b762e406f73", "parents": ["74dc6939cc5a98ec03feb53c18a20430a880c792"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087365 - Provide Robolectric's android-all jars from a toolchain instead of Maven Central.  a=dmeehan\n\nRobolectric's local dependency resolver has no fallback to Maven, so the toolchain carries every jar the\npinned Robolectric knows about, derived from its DefaultSdkProvider and checked against the sha512 Maven\npublishes. In automation the property is set unconditionally, so a task that runs Robolectric tests without\nthe toolchain fails instead of downloading the jars. Only build-components tasks of modules with a\nrobolectric.properties fetch it; the taskgraph sparse profile includes those files so the decision task can\nsee them.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338424\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338527\n", "files": ["build/sparse-profiles/taskgraph", "mobile/android/android-components/samples/browser/build.gradle", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt", "taskcluster/android_taskgraph/transforms/build_components.py", "taskcluster/kinds/source-test/mozlint-android.yml", "taskcluster/kinds/test-apk/kind.yml", "taskcluster/kinds/toolchain/android.yml", "taskcluster/scripts/misc/android-robolectric-jars.sh"], "git_node": "66d59f6ab6839b5e75d45ab3890b9d9147230d38", "git_parents": ["37a6bef0b41a079aea613192e9af956b8fd6e32f"], "node": "ecc5dcd09cbeca547bf9ab5dc941b119bec0d51b", "parents": ["9ec5bbb23d3e7007e3672510d0a44b762e406f73"], "tags": []}], "date": 1793460412, "git_changesets": ["37a6bef0b41a079aea613192e9af956b8fd6e32f", "66d59f6ab6839b5e75d45ab3890b9d9147230d38"], "user": "dmeehan@mozilla.com"}, "29234": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087494 - Explicitly install dbus in the flatpak images.  a=dmeehan DONTBUILD\n\nNewer flatpak packages only recommend a system bus, and recommends are\ndisabled in our images, but dbus.sh needs dbus-daemon.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338296\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338313\n", "files": ["taskcluster/docker/debian-flatpak/Dockerfile"], "git_node": "7662c2b9d2837c249324e1137e323d416aa99cc9", "git_parents": ["66d59f6ab6839b5e75d45ab3890b9d9147230d38"], "node": "57c402d5c2366adc0a8888885a6c028c43e01ad4", "parents": ["ecc5dcd09cbeca547bf9ab5dc941b119bec0d51b"], "tags": []}], "date": 1793460668, "git_changesets": ["7662c2b9d2837c249324e1137e323d416aa99cc9"], "user": "dmeehan@mozilla.com"}, "29235": {"changesets": [{"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087602 - Update isPremium check so that unlimited bandwidth does not gate locations -  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338391\n\nDifferential Revision: https://phabricator.services.mozilla.com/D3