 kept\nthe focused toplevel as its insert_text target for as long as the popup\nlived.\n\nRedirect only to a popup of the same toplevel. The entry now also holds a\nreference to its target window, so the target outlives the insert_text\nhandler.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334388\n\n(cherry picked from commit c25ff1d5742ef3b63aef7e1ca3889f3d839b4d0d)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336887\n", "files": ["widget/gtk/nsWindow.cpp"], "git_node": "c5a3e7d93c1035a663c0544d13dd33c7db151629", "git_parents": ["b4ead627f351c96f1b9420030d23e4f6a5796744"], "node": "4471bf9db3392cffc6998f1f4382d4ca6448dce8", "parents": ["39090405c77bb2b725e6ba7db0a461f30954241e"], "tags": []}], "date": 1793054021, "git_changesets": ["c5a3e7d93c1035a663c0544d13dd33c7db151629"], "user": "dmeehan@mozilla.com"}, "29155": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update HSTS HPKP  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336909\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "a73c74eb592894b22f10eafbe45806b4a3bd09b8", "git_parents": ["c5a3e7d93c1035a663c0544d13dd33c7db151629"], "node": "7b9034ec0d6e8994364058de7a58473758ff6b3e", "parents": ["4471bf9db3392cffc6998f1f4382d4ca6448dce8"], "tags": []}], "date": 1793055240, "git_changesets": ["a73c74eb592894b22f10eafbe45806b4a3bd09b8"], "user": "dmeehan@mozilla.com"}, "29156": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-hr/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/component