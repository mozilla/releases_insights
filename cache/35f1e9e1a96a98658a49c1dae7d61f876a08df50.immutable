, "git_changesets": ["0df97f335352d228110d4b50e8498e693795e668"], "user": "ffxbld@lando.moz.tools"}, "29216": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fb7bcc275b0b32c9f5be89f745500d022e86985e with DEVEDITION_160_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "5604c13bae4a27047c977680444a29185ba46be9", "git_parents": ["0df97f335352d228110d4b50e8498e693795e668"], "node": "ac00609cd3c813e3a04711e892276cfcff083f15", "parents": ["9871fdcf3b02f58544307bdef7318ea94648034b"], "tags": []}], "date": 1793375083, "git_changesets": ["5604c13bae4a27047c977680444a29185ba46be9"], "user": "ffxbld@lando.moz.tools"}, "29217": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2083990 - Escape xmlns value in fragment context.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337693\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338325\n", "files": ["dom/base/nsContentUtils.cpp", "dom/serializers/nsXMLContentSerializer.cpp", "dom/serializers/nsXMLContentSerializer.h"], "git_node": "9d776fb609f5d8ea02d4ccaddae24c85f91957fb", "git_parents": ["864e388bb3ada0d2ef6209cdd2a1f31c27c1e699"], "node": "bfc87fa3d17b941e7bc66f9b30bce270db75e6c5", "parents": ["deb3b0a45f8e81ca2cc4255167a97534b6fd082c"], "tags": []}], "date": 1793377189, "git_changesets": ["9d776fb609f5d8ea02d4ccaddae24c85f91957fb"], "user": "dmeehan@mozilla.com"}, "29218": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 2085914 - Discard buffered input when TCPSocket upgrades to TLS.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337009\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338309\n", "files": ["dom/network/TCPSocket.cpp", "dom/network/TCPSocket.h", "dom/network/moz.build", "dom/network/tests/unit/test_tcpsocket_starttls.js", "dom/network/tests/unit/xpcshell.toml"], "git_node": "0af6498311ba936b176701d27f548e7fe7bda329", "git_parents": ["9d776fb609f5d8ea02d4ccaddae24c85f91957fb"], "node": "ee72e398c98539a9ac8dcc6a7bdf0b4416d0fcdf", "parents": ["bfc87fa3d17b941e7bc66f9b30bce270db75e6c5"], "tags": []}], "date": 1793377235, "git_changesets": ["0af6498311ba936b176701d27f548e7fe7bda329"], "user": "dmeehan@mozilla.com"}, "29219": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075976 - Only accept one RespondWith per fetch event op in the parent process.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333191\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338304\n", "files": ["dom/serviceworkers/FetchEventOpChild.cpp", "dom/serviceworkers/FetchEventOpProxyParent.cpp", "dom/serviceworkers/FetchEventOpProxyParent.h"], "git_node": "4b8d6f76e0aa9d153910d7844927ebdf487d37e3", "git_parents": ["0af6498311ba936b176701d27f548e7fe7bda329"], "node": "c0c722c15328333ed2e97acd568ed59a69a21fb4", "parents": ["ee72e398c98539a9ac8dcc6a7bdf0b4416d0fcdf"], "tags": []}], "date": 1793377275, "git_changesets": ["4b8d6f76e0aa9d153910d7844927ebdf487d37e3"], "user": "dmeehan@mozilla.com"}, "29220": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081980.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337511\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338284\n", "files": ["layout/style/CSSImportRule.cpp", "layout/style/Rule.h", "layout/style/StyleSheet.h"], "git_node": "4582acad70eac4cde0191d0add80ee5c608e5ce2", "git_parents": ["4b8d6f76e0aa9d153910d7844927ebdf487d37e3"], "node": "1818da149c4ccead5fd97643f88105e6d1f334c8", "parents": ["c0c722c15328333ed2e97acd568ed59a69a21fb4"], "tags": []}], "date": 1793377707, "git_changesets": ["4582acad70eac4cde0191d0add80ee5c608e5ce2"], "user": "dmeehan@mozilla.com"}, "29221": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2086584 - Fix building for i686 without SSE.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337566\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338216\n", "files": ["js/src/util/Denormals.h", "js/src/wasm/WasmInstance.cpp"], "git_node": "ebe872a3d4744d6b88d3a273e3604a1c5ece6bef", "git_parents": ["4582acad70eac4cde0191d0add80ee5c608e5ce2"], "node": "79b5425a1d88e6666ee3a60713834b48d3ea93d1", "parents": ["1818da149c4ccead5fd97643f88105e6d1f334c8"], "tags": []}], "date": 1793377828, "git_changesets": ["ebe872a3d4744d6b88d3a273e3604a1c5ece6bef"], "user": "dmeehan@mozilla.com"}, "29222": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2086305 - Use DrawSurface more often for SkPDF.  a=dmeehan\n\nDrawTargetSkia::FillRect already redirects to DrawSurface when the image\nfits entirely inside the source rect, but it skipped that redirect for\nopaque surfaces drawn with OVER (which is basically every JPEG).\n\nOn a PDF canvas, the shader path makes SkPDF write a tiling Pattern, and\ngs ends up not downsampling it. A smarter optimizer could figure that\nout, but it seems better to use actual image objects in the PDF.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338022\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338253\n", "files": ["gfx/2d/DrawTargetSkia.cpp", "testing/web-platform/mozilla/meta/printing/video-001-print.html.ini", "testing/web-platform/mozilla/meta/printing/video-002-print.html.ini", "testing/web-platform/mozilla/meta/printing/video-005-print.html.ini", "toolkit/components/printing/tests/browser.toml", "toolkit/components/printing/tests/browser_print_image_output.js", "toolkit/components/printing/tests/browser_print_page_size_output.js", "toolkit/components/printing/tests/file_print_images.html", "toolkit/components/printing/tests/head.js"], "git_node": "5df5a64af71feb18f3684ed9285e5e9e9fe0a2bf", "git_parents": ["ebe872a3d4744d6b88d3a273e3604a1c5ece6bef"], "node": "06fd218b4a14f1d0ed0e18b114f46be0607b3bfc", "parents": ["79b5425a1d88e6666ee3a60713834b48d3ea93d1"], "tags": []}], "date": 1793377873, "git_changesets": ["5df5a64af71feb18f3684ed9285e5e9e9fe0a2bf"], "user": "dmeehan@mozilla.com"}, "29223": {"changesets": [{"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086198 - Bail out of APZCCallbackHelper::UpdateRootFrame when the root scroll container is gone.  a=dmeehan\n\nThe root element can lose its frames, e.g. by display:none, while the\nPresShell and the root content APZC stay alive, so a repaint request with\nan async zoom can arrive without a root scroll container.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337312\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338155\n", "files": ["gfx/layers/apz/util/APZCCallbackHelper.cpp", "gfx/tests/crashtests/2086198.html", "gfx/tests/crashtests/crashtests.list"], "git_node": "89f1a2cbcaebc8908de134aca2e6c128363e99ab", "git_parents": ["5df5a64af71feb18f3684ed9285e5e9e9fe0a2bf"], "node": "584cccc8d5c769cc3b1a7852199aaf4b0050485c", "parents": ["06fd218b4a14f1d0ed0e18b114f46be0607b3bfc"], "tags": []}], "date": 1793377917, "git_changesets": ["89f1a2cbcaebc8908de134aca2e6c128363e99ab"], "user": "dmeehan@mozilla.com"}, "29224": {"changesets": [{"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086347 - Use green for attention color in LWTs  a=dmeehan\n\nWe updated this to use the OS accent color in bug 2067215 but we're\ngetting reports that there isn't always good contrast. Reverting back to\nthe hard-coded green for LWTs\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337999\n\nDifferential Revis