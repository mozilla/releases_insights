acodec_low_latency.patch"], "git_node": "e14b4ef931d3879850aa11660df8cee315e88b85", "git_parents": ["8431655da1fdef17586f7d268d1aa34411ca5e61"], "node": "c2e5ddce37369696e94bd288e6e3ca3506429a6a", "parents": ["0ce0f0a2f31cc1d40d4a8a8e3e9f491d053eca0e"], "tags": []}], "date": 1776986867, "git_changesets": ["077160fec637a422aeabf9b404f8c1ededa20900", "1d68ffcf3c398abca1fab4b2cd24a9c08f79f4eb", "fb9d8686d64e5bc6bc62ee648b77e2099823a860", "8431655da1fdef17586f7d268d1aa34411ca5e61", "e14b4ef931d3879850aa11660df8cee315e88b85"], "user": "dmeehan@mozilla.com"}, "1053": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "No bug - Bump version to 140.10.1 a=me\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "a5b85f334779f42157f986c814d710e1230c1f05", "git_parents": ["7df8dfe86ba8af4d83252597303123f0507bcee5"], "node": "9e5305ca77ad038af15529fd0bc8eec8e2db5558", "parents": ["a1c8c4081ea0e227dbde64c95ec6942fa71edb28"], "tags": []}], "date": 1776999490, "git_changesets": ["a5b85f334779f42157f986c814d710e1230c1f05"], "user": "dsmith@mozilla.com"}, "1054": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1998130 - Firefox should not include keep-alive in websocket Connection header  a=dmeehan DONTBUILD\n\nhttps://datatracker.ietf.org/doc/html/rfc6455\n\u003e The request MUST contain an |Upgrade| header field whose value\n\u003e  MUST include the \"websocket\" keyword.\n\nTechnically Firefox's behaviour is correct, but it appears some servers just check\nfor exact Connection: Upgrade - Chrome and Safari don't include the keep-alive token,\nso I guess this is now a web-compat issue.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D271206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296095\n", "files": ["netwerk/protocol/http/nsHttpChannel