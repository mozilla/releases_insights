": "ffe62b91435fe2b07cfc97585641ec8b0f2de757", "git_parents": ["efc922383fb8809ebdc82b6a06eac4796354adba"], "node": "04e9b31097c38afebb85dd4c811641625b01765b", "parents": ["8ebe68dd49a5059c96b5c9b3e2361213fd26f088"], "tags": []}], "date": 1777395064, "git_changesets": ["ffe62b91435fe2b07cfc97585641ec8b0f2de757"], "user": "dmeehan@mozilla.com"}, "1080": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2029447 - WebRTC backport: [Pipewire] Fix mouse cursor data race.  a=dmeehan DONTBUILD\n\nThis addresses a potential data race when the mouse cursor is updated\non the Pipewire thread and read by the capture thread.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 90b22181ec922900e26de71463b8e0ed47a5c2dd\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296092\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296905\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/moz-patch-stack/90b22181ec.no-op-cherry-pick-msg"], "git_node": "9e76451f0a684fd59b0e1206ad81830e3cd04b8b", "git_parents": ["ffe62b91435fe2b07cfc97585641ec8b0f2de757"], "node": "e5db0e43ae4af7fbf59d6fcb317025d2dc659c3a", "parents": ["04e9b31097c38afebb85dd4c811641625b01765b"], "tags": []}], "date": 1777395110, "git_changesets": ["9e76451f0a684fd59b0e1206ad81830e3cd04b8b"], "user": "dmeehan@mozilla.com"}, "1081": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2029785 - WebRTC backport: Fix use-after-free in ScreenCast and Camera portal D-Bus callbacks  a=dmeehan DONTBUILD\n\nGDBus async callbacks fire on the GLib main thread with a raw pointer\nto the portal object. When the portal is destroyed on another thread,\nthe callback accesses freed memory.\n\nIntroduce PortalGuard, a ref-counted mutex-protected wrapper that\noutlives the portal. Callbacks lock the guard and check the portal\npointer before use. Stop() locks the same mutex to null the pointer,\nblocking until any in-flight callback finishes. Utility functions\nnow take scoped_refptr\u003cPortalGuard\u003e and manage refs internally.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 9dde36ebf937da0ab92837932b253cc3d42c8dc2\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296096\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296907\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/base_capturer_pipewire.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/screen_capture_portal_interface.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/screen_capture_portal_interface.h", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/screencast_portal.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/screencast_portal.h", "third_party/libwebrtc/modules/portal/BUILD.gn", "third_party/libwebrtc/modules/portal/portal_guard.h", "third_party/libwebrtc/modules/portal/xdg_desktop_portal_utils.cc", "third_party/libwebrtc/modules/portal/xdg_desktop_portal_utils.h", "third_party/libwebrtc/modules/video_capture/linux/camera_portal.cc", "third_party/libwebrtc/moz-patch-stack/9dde36ebf9.no-op-cherry-pick-msg"], "git_node": "0b2cc2a7b527b2e6d22c174a156705d1e8180f59", "git_parents": ["9e76451f0a684fd59b0e1206ad81830e3cd04b8b"], "node": "1dd53daa332203af95821aa42e38111fb9f92a17", "parents": ["e5db0e43ae4af7fbf59d6fcb317025d2dc659c3a"], "tags": []}], "date": 1777395159, "git_changesets": ["0b2cc2a7b527b2e6d22c174a156705d1e8180f59"], "user": "dmeehan@mozilla.com"}, "1082": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2030323 - Add DcompSurfaceDescriptor validity check  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296269\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296866\n", "files": ["gfx/layers/DcompSurfaceImage.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": "3858dd91dbe272a645827711d92dcda9822a94e1", "git_parents": ["0b2cc2a7b527b2e6d22c174a156705d1e8180f59"], "node": "42b8809ae16cc75a4ae38f3fe6ac1a28f86b4c15", "parents": ["1dd53daa332203af95821aa42e38111fb9f92a17"], "tags": []}], "date": 1777395206, "git_changesets": ["3858dd91dbe272a645827711d92dcda9822a94e1"], "user": "dmeehan@mozilla.com"}, "1083": {"changesets": [{"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2031662: Dispatch this init to STS to avoid races.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296407\n", "files": ["dom/media/webrtc/transport/test/transport_unittests.cpp"], "git_node": "b4cafd0397efa2e8933eafb8fc3f21ae0d020780", "git_parents": ["3858dd91dbe272a645827711d92dcda9822a94e1"], "node": "1e38336feef1ba8935e49978a007be8981000c79", "parents": ["42b8809ae16cc75a4ae38f3fe6ac1a28f86b4c15"], "tags": []}], "date": 1777395252, "git_changesets": ["b4cafd0397efa2e8933eafb8fc3f21ae0d020780"], "user": "dmeehan@mozilla.com"}, "1084": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032043 - Cherry-pick commit 1803559c from upstream freetype.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296505\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296952\n", "files": ["modules/freetype2/src/truetype/ttinterp.c"], "git_node": "3758f515795bf5888b16b157dd2a74a520f575af", "git_parents": ["b4cafd0397efa2e8933eafb8fc3f21ae0d020780"], "node": "b9997bd87079711db4a9b542e98dc2f594c6e030", "parents": ["1e38336feef1ba8935e49978a007be8981000c79"], "tags": []}], "date": 1777395418, "git_changesets": ["3758f515795bf5888b16b157dd2a74a520f575af"], "user": "dmeehan@mozilla.com"}, "1085": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2033850 - Improve policies.json error handling.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295806\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296968\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/tests/browser/browser_policies_gpo.js"], "git_node": "cda2dc9b2ea8a2128312b3ca2a744fa9a46e9471", "git_parents": ["3758f515795bf5888b16b157dd2a74a520f575af"], "node": "cca29f80672cb6b0a9dc7e44dd7505fb13e76e39", "parents": ["b9997bd87079711db4a9b542e98dc2f594c6e030"], "tags": []}], "date": 1777395465, "git_changesets": ["cda2dc9b2ea8a2128312b3ca2a744fa9a46e9471"], "user": "dmeehan@mozilla.com"}, "1086": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033270.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296799\n", "files": ["dom/canvas/WebGLContext.cpp"], "git_node": "dcc8d802dc2ddd931445d47de096c37a63df8f7d", "git_parents": ["cda2dc9b2ea8a2128312b3ca2a744fa9a46e9471"], "node": "bc088dc1552c1743e8aa505b40408f2252f466dc", "parents": ["cca29f80672cb6b0a9dc7e44dd7505fb13e76e39"], "tags": []}], "date": 1777395853, "git_changesets": ["dcc8d802dc2ddd931445d47de096c37a63df8f7d"], "user": "dmeehan@mozilla.com"}, "1087": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2030323 - Fix ESR140 build a=bustage\n", "files": ["gfx/layers/DcompSurfaceImage.cpp"], "git_node": "b76396cd37b5caa262b582ca5f4f66ad10fe1cac", "git_parents": ["dcc8d802dc2ddd931445d47de096c37a63df8f7d"], "node": "4342a7df5ef07357e3440c199e6c8eb7def76b29", "parents": ["bc088dc1552c1743e8aa505b40408f2252f466dc"], "tags": []}], "date": 1777405733, "git_changesets": ["b76396cd37b5caa262b582ca5f4f66ad10fe1cac"], "user": "dmeehan@mozilla.com"}, "1088": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1983677 - patch 1 - Remove the cached ellipsis textrun from gfxFontGroup.  a=dmeehan\n\nThis also lets us get rid of gfxTextRun::ReleaseFontGroup and associated cruft.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295900\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296659\n", "files": ["gfx/thebes/gfxTextRun.cpp", "gfx/thebes/gfxTextRun.h", "layout/generic/TextOverflow.cpp"], "git_node": "dd81c78ff39f7ca50543e43c7a28e82648cac683", "git_parents": ["b76396cd37b5caa262b582ca5f4f66ad10fe1cac"], "node": "7d22ffc47c5dab7d4e98569c1207dedca9eebd31", "parents": ["4342a7df5ef07357e3440c199e6c8eb7def76b29"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1983677 - patch 2 - Cache ellipsis textrun in TextOverflow for cases where it is rendered on multiple lines in the block.  a=dmeehan\n\nThis is helpful in cases like a large \u003cpre\u003e element with text-wrap:nowrap and\ntext-overflow:ellipsis where there are many long lines, all of which get an\nellipsis rendered.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295901\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296660\n", "files": ["layout/generic/TextOverflow.cpp", "layout/generic/TextOverflow.h"], "git_node": "02d39aa040275ede1fecc888211153464289a4b2", "git_parents": ["dd81c78ff39f7ca50543e43c7a28e82648cac683"], "node": "182f9546aa8b4f94c9b5c2a24d9b9dfd80b15a52", "parents": ["7d22ffc47c5dab7d4e98569c1207dedca9eebd31"], "tags": []}], "date": 1777406252, "git_changesets": ["dd81c78ff39f7ca50543e43c7a28e82648cac683", "02d39aa040275ede1fecc888211153464289a4b2"], "user": "dmeehan@mozilla.com"}, "1089": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028005.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291584\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296773\n", "files": ["storage/mozStorageSQLFunctions.cpp"], "git_node": "8441388c3daea3b54edd546e578f59d8aa0285fa", "git_parents": ["02d39aa040275ede1fecc888211153464289a4b2"], "node": "e9b5c35c3a030f50917e18046b3161420c607332", "parents": ["182f9546aa8b4f94c9b5c2a24d9b9dfd80b15a52"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028005. Part 2.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291585\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296774\n", "files": ["dom/storage/StorageIPC.cpp"], "git_node": "be9520e92e98295ebc95e9cf2f3c8ce1b56a9541", "git_parents": ["8441388c3daea3b54edd546e578f59d8aa0285fa"], "node": "7c89ee03ecfc17938b3f1a35a2befd3beb0dd4e8", "parents": ["e9b5c35c3a030f50917e18046b3161420c607332"], "tags": []}], "date": 1777422307, "git_changesets": ["8441388c3daea3b54edd546e578f59d8aa0285fa", "be9520e92e98295ebc95e9cf2f3c8ce1b56a9541"], "user": "dmeehan@mozilla.com"}, "1090": {"changesets": [{"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032042.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296998\n", "files": ["gfx/angle/checkout/src/libANGLE/renderer/d3d/d3d11/Buffer11.cpp"], "git_node": "c698efbf0282cf2475253e52bcbfa1db5b4bc678", "git_parents": ["be9520e92e98295ebc95e9cf2f3c8ce1b56a9541"], "node": "a6147452dadf052eb0397600e14b589bcbe0dd76", "parents": ["7c89ee03ecfc17938b3f1a35a2befd3beb0dd4e8"], "tags": []}], "date": 1777422353, "git_changesets": ["c698efbf0282cf2475253e52bcbfa1db5b4bc678"], "user": "dmeehan@mozilla.com"}, "1091": {"changesets": [{"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025540: Don't add overflow for abspos if its area is zero.   a=dmeehan DONTBUILD\n\nPrior to Bug 1800907, abspos overflow contribution used `UnionWith`,\nwhich ignored empty (i.e. width or height is zero) overflows. Post\nBug 1800907, the constraint was tightened so that both width and\nheight must be zero for any overflow to be ignored.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290147\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297189\n", "files": ["layout/generic/ReflowOutput.cpp", "layout/generic/ReflowOutput.h", "layout/generic/nsAbsoluteContainingBlock.cpp", "testing/web-platform/tests/css/css-position/position-absolute-scrollable-overflow-zero.html"], "git_node": "0c604e98e0c0d604d586417aeeddc04e995a0096", "git_parents": ["c698efbf0282cf2475253e52bcbfa1db5b4bc678"], "node": "e9136f027a73468f26fa179e9b35949618dc8ff0", "parents": ["a6147452dadf052eb0397600e14b589bcbe0dd76"], "tags": []}], "date": 1777422397, "git_changesets": ["0c604e98e0c0d604d586417aeeddc04e995a0096"], "user": "dmeehan@mozilla.com"}, "1092": {"changesets": [{"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027883 - Fix integer overflow in cairo PDF surface image emission  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D292028\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297158\n", "files": ["gfx/cairo/cairo/src/cairo-pdf-surface.c"], "git_node": "d39f2b80a98b0b9a03f34ab96cb17558bfc2bf2d", "git_parents": ["0c604e98e0c0d604d586417aeeddc04e995a0096"], "node": "c7e2569434939b6f63bf585d3a33db04b7abb458", "parents": ["e9136f027a73468f26fa179e9b35949618dc8ff0"], "tags": []}], "date": 1777423039, "git_changesets": ["d39f2b80a98b0b9a03f34ab96cb17558bfc2bf2d"], "user": "dmeehan@mozilla.com"}, "1093": {"changesets": [{"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2029732: Verify that remote data matches the expected format.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296947\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297270\n", "files": ["toolkit/components/remote/nsUnixRemoteServer.cpp"], "git_node": "95b2cd1fbc8b79fd1bdf3870d7f61f08e4000159", "git_parents": ["d39f2b80a98b0b9a03f34ab96cb17558bfc2bf2d"], "node": "bf0d7fd213cc78edbc7aa9cb23792c88ffd2554d", "parents": ["c7e2569434939b6f63bf585d3a33db04b7abb458"], "tags": []}], "date": 1777492699, "git_changesets": ["95b2cd1fbc8b79fd1bdf3870d7f61f08e4000159"], "user": "dmeehan@mozilla.com"}, "1094": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2029428 - WebRTC backport: Fix signal subscription leak in xdg-desktop-portal callbacks  a=dmeehan DONTBUILD\n\nPrevent duplicate signal processing from a misbehaving portal by\nunsubscribing each response signal handler on first invocation.\nAlso unsubscribe the closed signal handler before re-registering.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 2ba7cce34e86a222c26e7254170cb179066bff5d\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296759\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297308\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/screen_capture_portal_interface.cc", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/screencast_portal.cc", "third_party/libwebrtc/modules/portal/xdg_desktop_portal_utils.cc", "third_party/libwebrtc/modules/portal/xdg_desktop_portal_utils.h", "third_party/libwebrtc/modules/video_capture/linux/camera_portal.cc", "third_party/libwebrtc/moz-patch-stack/2ba7cce34e.no-op-cherry-pick-msg"], "git_node": "11bdd0fa0c82b3d843c98a43316c3db10a223dc0", "git_parents": ["95b2cd1fbc8b79fd1bdf3870d7f61f08e4000159"], "node": "0e11018a36c080c329692e6dd3fc641774b44d30", "parents": ["bf0d7fd213cc78edbc7aa9cb23792c88ffd2554d"], "tags": []}], "date": 1777492749, "git_changesets": ["11bdd0fa0c82b3d843c98a43316c3db10a223dc0"], "user": "dmeehan@mozilla.com"}, "1095": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025956: WorkerScriptLoader owns its ErrorResult instead of holding a reference.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295907\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297468\n", "files": ["dom/workers/ScriptLoader.cpp", "dom/workers/ScriptLoader.h", "dom/workers/loader/WorkerModuleLoader.cpp"], "git_node": "15a4402f86ca9b0bf3ffc6f2d19b191c2d1d6a7a", "git_parents": ["11bdd0fa0c82b3d843c98a43316c3db10a223dc0"], "node": "c5056ee44c2ae54095b5b5af09e56bdb87070822", "parents": ["0e11018a36c080c329692e6dd3fc641774b44d30"], "tags": []}], "date": 1777492801, "git_changesets": ["15a4402f86ca9b0bf3ffc6f2d19b191c2d1d6a7a"], "user": "dmeehan@mozilla.com"}, "1096": {"changesets": [{"author": "Jari Jalkanen \u003cjjjalkanen@gmail.com\u003e", "branch": "default", "desc": "Bug 2030461 - Use platform path separators with paths from nsIFile.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293871\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297459\n", "files": ["dom/filesystem/FileSystemSecurity.cpp", "dom/filesystem/FileSystemUtils.cpp", "dom/filesystem/FileSystemUtils.h"], "git_node": "5460fad2c02b6685de1cf1d64a04cae685df2532", "git_parents": ["15a4402f86ca9b0bf3ffc6f2d19b191c2d1d6a7a"], "node": "866bb588a52f136e7030713c56ae10a5413177e3", "parents": ["c5056ee44c2ae54095b5b5af09e56bdb87070822"], "tags": []}], "date": 1777492883, "git_changesets": ["5460fad2c02b6685de1cf1d64a04cae685df2532"], "user": "dmeehan@mozilla.com"}, "1097": {"changesets": [{"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2028292 - Fix use of on mListenerMT in WebSocketChannel  a=dmeehan DONTBUILD\n\nThe IO thread's unprotected RefPtr copy of mListenerMT raced with the main\nthread freeing it in CallOnStop::Run (two-step load + AddRef UAF).\n\nAdd GetListenerMT() and TakeListenerMT() to atomically snap or transfer\nmListenerMT under mMutex. All four runnables now take a pre-snapped\nRefPtr\u003c\u003e&&. Move mListenerMT to each derived class to enable MOZ_GUARDED_BY:\nWebSocketChannel uses mMutex; WebSocketChannelChild gets a dedicated\nmListenerMutex.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D294448\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297619\n", "files": ["netwerk/protocol/websocket/BaseWebSocketChannel.h", "netwerk/protocol/websocket/WebSocketChannel.cpp", "netwerk/protocol/websocket/WebSocketChannel.h", "netwerk/protocol/websocket/WebSocketChannelChild.cpp", "netwerk/protocol/websocket/WebSocketChannelChild.h"], "git_node": "8fe376d125951ff894ae2b5bf268d8ae5f81e7c4", "git_parents": ["5460fad2c02b6685de1cf1d64a04cae685df2532"], "node": "e26615b3a25fb34a84e8e304a49c08afa5ff1ea3", "parents": ["866bb588a52f136e7030713c56ae10a5413177e3"], "tags": []}], "date": 1777563353, "git_changesets": ["8fe376d125951ff894ae2b5bf268d8ae5f81e7c4"], "user": "dmeehan@mozilla.com"}, "1098": {"changesets": [{"author": "Artur Iunusov \u003caiunusov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2022722 - LoggingInfo: validate serial numbers,  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293472\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297340\n", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": "0520c5f1edb895df4b5d46030f0acd7f58597ec6", "git_parents": ["8fe376d125951ff894ae2b5bf268d8ae5f81e7c4"], "node": "188fb263fef17064d7c51d351dd4a6e0385163ce", "parents": ["e26615b3a25fb34a84e8e304a49c08afa5ff1ea3"], "tags": []}], "date": 1777563402, "git_changesets": ["0520c5f1edb895df4b5d46030f0acd7f58597ec6"], "user": "dmeehan@mozilla.com"}, "1099": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2034