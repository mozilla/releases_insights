fec39f2d4a8b57ddfb0d", "parents": ["fd3487543571130c3a2907f9042cf42c63f0aa52"], "tags": []}], "date": 1777915763, "git_changesets": ["c97cebd8eb3088ddb0b2c0cc356f3b14aaea9958"], "user": "dmeehan@mozilla.com"}, "1120": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr140 repo-update HSTS HPKP remote-settings tld-suffixes ct-logs -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298205\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config-icons.json", "services/settings/dumps/main/search-config-icons/001500a9-1a6c-3f5a-ba15-a5f5a075d256", "services/settings/dumps/main/search-config-icons/001500a9-1a6c-3f5a-ba15-a5f5a075d256.meta.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "2619e0878d4b1a2eb405edcf450d1c704325c9f0", "git_parents": ["c97cebd8eb3088ddb0b2c0cc356f3b14aaea9958"], "node": "8fdc006b91907a41884cadaf1db59daee5455a49", "parents": ["812907f71f67830b258ffec39f2d4a8b57ddfb0d"], "tags": []}], "date": 1777915966, "git_changesets": ["2619e0878d4b1a2eb405edcf450d1c704325c9f0"], "user": "dmeehan@mozilla.com"}, "1121": {"changesets": [{"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2036062 - Don't run perfdocs on non-nightly code-reviews.  a=dmeehan DONTBUILD\n\nThis patch adds a new transform to prevent perfdocs from being scheduled on try runs from reviewbot that are based on non-nightly branches (e.g. beta/esr/etc.). This task doesn't need to run there for code-reviews and only triggers false positives.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297620\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298381\n", "files": ["taskcluster/gecko_taskgraph/transforms/source_test.py"], "git_node": "a446d1a64a1031ac622768277b93264d22d758dc", "git_parents": ["2619e0878d4b1a2eb405edcf450d1c704325c9f0"], "node": "28391eb0d99f07cd8d7b05fbabf9bdf4b1a29d2a", "parents": ["8fdc006b91907a41884cadaf1db59daee5455a49"], "tags": []}], "date": 1777940621, "git_changesets": ["a446d1a64a1031ac622768277b93264d22d758dc"], "user": "dmeehan@mozilla.com"}, "1122": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025467 - Fix a potential issue in MFMediaEngineChild (ESR140 backport)  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298360\n", "files": ["dom/media/ipc/MFMediaEngineChild.cpp"], "git_node": "e16d73a2f727bf5cc7d8759d5ba573cf4c51737e", "git_parents": ["a446d1a64a1031ac622768277b93264d22d758dc"], "node": "58b865325180423ab863ce93d0eef8aa5b4ecdbf", "parents": ["28391eb0d99f07cd8d7b05fbabf9bdf4b1a29d2a"], "tags": []}], "date": 1777940755, "git_changesets": ["e16d73a2f727bf5cc7d8759d5ba573cf4c51737e"], "user": "dmeehan@mozilla.com"}, "1123": {"changesets": [{"author": "unknown \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034754: Modernize nsDataObjCollection::GetFile[Descriptors] and GetText error handling  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297526\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298324\n", "files": ["widget/windows/nsDataObjCollection.cpp", "widget/windows/nsDataObjCollection.h"], "git_node": "d60b2d80dc862eecc6fc4fb643b715e04990b440", "git_parents": ["e16d73a2f727bf5cc7d8759d5ba573cf4c51737e"], "node": "0a8afc337bda41a9c5c66983d9425a69859c2df0", "parents": ["58b865325180423ab863ce93d0eef8aa5b4ecdbf"], "tags": []}], "date": 1777940795, "git_changesets": ["d60b2d80dc862eecc6fc4fb643b715e04990b440"], "user": "dmeehan@mozilla.com"}, "1124": {"changesets": [{"author": "Jim Blandy \u003cjimb@red-bean.com\u003e", "branch": "default", "desc": "Bug 2029910: Cairo: avoid overflow rendering FreeType glyphs.  a=dmeehan\n\nIn `_compute_xrender_bitmap_size`, avoid arithmetic overflow in\ncalculating the size needed for the glyph buffer by: rejecting\nunreasonable glyph sizes early, and using 64-bit temporaries to\nmultiply 32-bit values.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298350\n", "files": ["gfx/cairo/cairo/src/cairo-ft-font.c"], "git_node": "3791153f079c3fe0832eb150283b8f4ed861537d", "git_parents": ["d60b2d80dc862eecc6fc4fb643b715e04990b440"], "node": "8dbb9e05d02f80c1cfaaf9d21ba0b98945942894", "parents": ["0a8afc337bda41a9c5c66983d9425a69859c2df0"], "tags": []}], "date": 1777940913, "git_changesets": ["3791153f079c3fe0832eb150283b8f4ed861537d"], "user": "dmeehan@mozilla.com"}, "1125": {"changesets": [{"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2021977:  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293557\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297001\n", "files": ["layout/generic/nsTextFrame.cpp"], "git_node": "2bd2770ee03fe5e4fd710d5ba923311de44e163d", "git_parents": ["64d8593574c3daa28d3e2c01c3c662a4757282df"], "node": "28b6ae9c7b81f457b5107f0480f34968fc1fa1e2", "parents": ["a24e9e115e02794f72dab9ef6081244403b0183a"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2022576 - Adding IsOtherProcessActor check for BackgroundParentImpl::AllocPRemoteWorkerControllerParent.  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289546\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294891\n", "files": ["ipc/glue/BackgroundParentImpl.cpp"], "git_node": "c63fb0cfc9fe4cee7a9e371b420c6876933b44ad", "git_parents": 