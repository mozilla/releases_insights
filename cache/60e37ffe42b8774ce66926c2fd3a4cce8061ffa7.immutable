 "js/src/gc/FinalizationObservers.h", "js/src/gc/GCRuntime.h", "js/src/moz.build", "xpcom/base/nsCycleCollector.cpp"], "git_node": "5249a33a1f935698e714421dee6baad0a321b3bd", "git_parents": ["1d7aa2310d61ee0e7b81653aa4877d71b492e01f"], "node": "ae612fa87a9b4c12af86d518af524291e28c9cb2", "parents": ["3fd4d40bfa18b28a449da4ac719dbd739d699733"], "tags": []}], "date": 1776711793, "git_changesets": ["5249a33a1f935698e714421dee6baad0a321b3bd"], "user": "dmeehan@mozilla.com"}, "989": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029806: Handle ill-formed UTF16  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D294527\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294993\n", "files": ["intl/icu-patches/bug-2029806-surrogates.diff", "intl/icu/source/common/ustrcase.cpp"], "git_node": "4b25cc8b06e9afc633dea37b40b52c113b72c831", "git_parents": ["5249a33a1f935698e714421dee6baad0a321b3bd"], "node": "e23f16f50f34fa1c24fd674c1f204bf7b41704f7", "parents": ["ae612fa87a9b4c12af86d518af524291e28c9cb2"], "tags": []}], "date": 1776711931, "git_changesets": ["4b25cc8b06e9afc633dea37b40b52c113b72c831"], "user": "dmeehan@mozilla.com"}, "990": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 Treat null input channels as zero in InterleaveAndConvertBuffer()  a=dmeehan\n\nThe loop nesting is inverted so as not to add a null check to the inner loop,\nbut this change would also have some impact on cache use:\n\n* The loop ordering might perhaps not be the ideal for two channels and large\n  sample counts, for example, because it means going through the\n  output/largest buffer twice.\n\n* It does, however, avoid pathological situations of iterating across planar\n  channel buffers, likely to load set-associative cache lines if the channel\n  buffers are page aligned, due to having 1024 (or somewhat fewer) floats, for\n  example.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293825\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294809\n", "files": ["dom/media/AudioSegment.h"], "git_node": "b0cd377749eec7316abbf52671fba7340de7d7da", "git_parents": ["4b25cc8b06e9afc633dea37b40b52c113b72c831"], "node": "8ab4f8d2c308bc1d2864fba7f880ae1b6745d163", "parents": ["e23f16f50f34fa1c24fd674c1f204bf7b41704f7"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 Treat null input channels as zero in DownMixChunk()  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293826\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294810\n", "files": ["dom/media/AudioChannelFormat.h", "dom/media/AudioSegment.cpp"], "git_node": "aabed8760e633b4de64f4b212d220b656f5d68e3", "git_parents": ["b0cd377749eec7316abbf52671fba7340de7d7da"], "node": "08ad185944ea93ff8050b7ee499868787dd94430", "parents": ["8ab4f8d2c308bc1d2864fba7f880ae1b6745d163"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 use nullptr for silent up-mix channels  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293827\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294811\n", "files": ["dom/media/AudioSegment.cpp", "dom/media/AudioSegment.h"], "git_node": "5576a2a0eef167b2aed8c281ff97108ca5f20b38", "git_parents": ["aabed8760e633b4de64f4b212d220b656f5d68e3"], "node": "3da6d56f0e3caba788806fece2a49d84cee90816", "parents": ["08ad185944ea93ff8050b7ee499868787dd94430"], "tags": []}], "date": 1776712129, "git_changesets": ["b0cd377749eec7316abbf52671fba7340de7d7da", "aabed8760e633b4de64f4b212d220b656f5d68e3", "5576a2a0eef167b2aed8c281ff97108ca5f20b38"], "user": "dmeehan@mozilla.com"}, "991": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "B