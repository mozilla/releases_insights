angesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027322 - Modernize sandbox broker operation enum.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291108\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295410\n", "files": ["security/sandbox/linux/SandboxBrokerClient.cpp", "security/sandbox/linux/broker/SandboxBroker.cpp", "security/sandbox/linux/broker/SandboxBroker.h", "security/sandbox/linux/broker/SandboxBrokerCommon.cpp", "security/sandbox/linux/broker/SandboxBrokerCommon.h"], "git_node": "4907cb4d4c9cb1866cffd9229380fb8c8f4001bb", "git_parents": ["0eabd79e0d622242ade2df0d40bc357e046ba862"], "node": "43a9840cbbcc6fc2936ecdcf124b3265d92cefd6", "parents": ["6e61245b0220a38612b700e8c3384072a8b0e11c"], "tags": []}], "date": 1776946081, "git_changesets": ["4907cb4d4c9cb1866cffd9229380fb8c8f4001bb"], "user": "dmeehan@mozilla.com"}, "1037": {"changesets": [{"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1999768 - Allow out of memory on weird 32-bit overflow fuzz test  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D272740\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294365\n", "files": ["js/src/jit-test/tests/bug1782468-ptrdiff-veclen.js"], "git_node": "4456b71763545d57320e4144b26b0b82feadc9be", "git_parents": ["4907cb4d4c9cb1866cffd9229380fb8c8f4001bb"], "node": "634570ed8e6fefc9340014dca735eabef5cd64ac", "parents": ["43a9840cbbcc6fc2936ecdcf124b3265d92cefd6"], "tags": []}], "date": 1776946123, "git_changesets": ["4456b71763545d57320e4144b26b0b82feadc9be"], "user": "dmeehan@mozilla.com"}, "1038": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2032236. Update libpng to v1.6.58.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294538\n", "files": ["media/libpng/ANNOUNCE", "media/libpng/CHANGES", "media/libpng/README", "media/libpng/libpng-manual.txt", "media/libpng/moz.yaml", "media/libpng/png.c", "media/libpng/png.h", "media/libpng/pngconf.h", "media/libpng/pngrtran.c"], "git_node": "58308d8a03c5ea326bbd32f0407f24ce1035b136", "git_parents": ["4456b71763545d57320e4144b26b0b82feadc9be"], "node": "b31e3088cd5ca14e3337def6dee0fc442fc8eb38", "parents": ["634570ed8e6fefc9340014dca735eabef5cd64ac"], "tags": []}], "date": 1776946548, "git_changesets": ["58308d8a03c5ea326bbd32f0407f24ce1035b136"], "user": "dmeehan@mozilla.com"}, "1039": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2028526 - Clear SpeechTaskChild::mActor when SpeechSynthesisRequestChild is destroyed.  a=dmeehan\n\nMirrors the parent-side destructor. Without this, actor destruction paths\nother than RecvOnEnd (e.g. AncestorDeletion during IPC subtree teardown)\nleave SpeechTaskChild holding a dangling pointer, causing a UAF when\nspeechSynthesis.cancel() is subsequently called.\n\nAlso replace MOZ_ASSERT(mActor) in Pause/Resume/Cancel/ForceEnd with\nnull checks, matching the existing pattern in SetAudioOutputVolume.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295325\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295840\n", "files": ["dom/media/webspeech/synth/ipc/SpeechSynthesisChild.cpp"], "git_node": "7ff8bbf43f9ec38fd8412d6238cbb5ac29890bb6", "git_parents": ["58308d8a03c5ea326bbd32f0407f24ce1035b136"], "node": "0fd93dddd2c51d682ced4f0d38f2efebf65778db", "parents": ["b31e3088cd5ca14e3337def6dee0fc442fc8eb38"], "tags": []}], "date": 1776946914, "git_changesets": ["7ff8bbf43f9ec38fd8412d6238cbb5ac29890bb6"], "user": "dmeehan@mozilla.com"}, "1040": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2005068 - Turn off ioi tests on ESR140. r=taskgraph-reviewers,ahal a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295999\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/variant.py"], "git_node": "e8e4167e9dea344f2a4875c4600ebec64f728237", "git_parents": ["7ff8bbf43f9ec38fd8412d6238cbb5ac29890bb6"], "node": "77bf27301288f5423853d6c2add4cf98ff898fc5", "parents": ["0fd93dddd2c51d682ced4f0d38f2efebf65778db"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923469 - Mark RTCRemoteInboundRtpStats.timestamp subtest as intermittent on Windows. r=aryx a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296000\n", "files": ["testing/web-platform/meta/webrtc/RTCPeerConnection-getStats-timestamp.https.html.ini"], "git_node": "9b5fc3e0f9b327cf2986459304c53a5932c07331", "git_parents": ["e8e4167e9dea344f2a4875c4600ebec64f728237"], "node": "0ee8b2a41cea18e47146dcfa29d457a775c879df", "parents": ["77bf27301288f5423853d6c2add4cf98ff898fc5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1948824 - Mark test-partitioned-access-to-fs-in-iframes.https.window.html as intermittent timeout on TSan. r=aryx a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296001\n", "files": ["testing/web-platform/mozilla/meta/dom/quota/test-partitioned-access-to-fs-in-iframes.https.window.js.ini"], "git_node": "e993d973b3a07b5bbddf7865a4dbd025c48dbc71", "git_parents": ["9b5fc3e0f9b327cf2986459304c53a5932c07331"], "node": "ce5a2042fda62afc25b2f1740083dba3e1566b03", "parents": ["0ee8b2a41cea18e47146dcfa29d457a775c879df"], "tags": []}], "date": 1776963750, "git_changesets": ["e8e4167e9dea344f2a4875c4600ebec64f728237", "9b5fc3e0f9b327cf2986459304c53a5932c07331", "e993d973b3a07b5bbddf7865a4dbd025c48dbc71"], "user": "dmeehan@mozilla.com"}, "1041": {"changesets": [{"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029422 - local patch to fix libaom issue.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293707\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294556\n", "files": ["media/libaom/calloc_cdef.patch", "media/libaom/moz.yaml", "third_party/aom/av1/encoder/pickcdef.c"], "git_node": "80b16fcf58fbfe1dc6381e866344cac1d083989d", "git_parents": ["e993d973b3a07b5bbddf7865a4dbd025c48dbc71"], "node": "50ab5d78096f7d9e1dfc38892321a6373fc413ff", "parents": ["ce5a2042fda62afc25b2f1740083dba3e1566b03"], "tags": []}], "date": 1776964624, "git_changesets": ["80b16fcf58fbfe1dc6381e866344cac1d083989d"], "user": "dmeehan@mozilla.com"}, "1042": {"changesets": [{"author": "Bryan Thrall \u003cbthrall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028882 - Set Async flag before calling onNewPromise  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D294205\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295333\n", "files": ["js/src/builtin/Promise.cpp", "js/src/builtin/Promise.h"], "git_node": "d32f7b09d9ee018c5255270d1af4c054e0d0042e", "git_parents": ["80b16fcf58fbfe1dc6381e866344cac1d083989d"], "node": "cfc6f00648839407f545ee254a25e867ec6021f3", "parents": ["50ab5d78096f7d9e1dfc38892321a6373fc413ff"], "tags": []}, {"author": "Bryan Thrall \u003cbthrall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028882 - Avoid resolving async function promises multiple times  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D294208\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295334\n", "files": ["js/public/friend/ErrorNumbers.msg", "js/src/builtin/Promise.cpp"], "git_node": "87ee0c4672def05a40e8f7a3242fd6d5fe3af070", "git_parents": ["d32f7b09d9ee018c5255270d1af4c054e0d0042e"], "node": "b1339c20a00ac57e9abfa657f0ef1d4fb07d0bfa", "parents": ["cfc6f00648839407f545ee254a25e867ec6021f3"], "tags": []}], "date": 1776964762, "git_changesets": ["d32f7b09d9ee018c5255270d1af4c054e0d0042e", "87ee0c4672def05a40e8f7a3242fd6d5fe3af070"], "user": "dmeehan@mozilla.com"}, "1043": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020265 - Allow non-unicode env variables when launching the crash helper  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D289626\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294217\n", "files": ["toolkit/crashreporter/crash_helper_client/src/platform/unix.rs"], "git_node": "b65c14082e4d9cb85b8d5dbee6425da1efd31618", "git_parents": ["87ee0c4672def05a40e8f7a3242fd6d5fe3af070"], "node": "f9a4d4f3b828dd38e4efbba9501fd8d4b79facad", "parents": ["b1339c20a00ac57e9abfa657f0ef1d4fb07d0bfa"], "tags": []}], "date": 1776964807, "git_changesets": ["b65c14082e4d9cb85b8d5dbee6425da1efd31618"], "user": "dmeehan@mozilla.com"}, "1044": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2031028 - (ESR) Part 1: Ensure stream is cloneable eagerly in RemoteLazyInputStreamStorage,  a=dmeehan DONTBUILD\n\nThis should simplify the logic a bit, as we won't need to deal with the\nstream not being cloneable and needing replacement during GetStream.\nInstead, the stream will be made cloneable as it is added to the store,\nand can be reliably cloned in GetStream.\n\nI did this by factoring out this core part of `NS_CloneInputStream`, so\nthat the logic can be easily shared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295911\n", "files": ["dom/file/ipc/RemoteLazyInputStreamStorage.cpp", "dom/file/ipc/RemoteLazyInputStreamStorage.h", "xpcom/io/nsStreamUtils.cpp", "xpcom/io/nsStreamUtils.h"], "git_node": "aaed0faf9a0a3b3d3acdc0ada320a47cf918d1d6", "git_parents": ["b65c14082e4d9cb85b8d5dbee6425da1efd31618"], "node": "6c1fe7fc67427ab69e2ec0d11f925b0612d098d8", "parents": ["f9a4d4f3b828dd38e4efbba9501fd8d4b79facad"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2031028 - (ESR) Part 2: Use NS_EnsureInputStreamIsCloneable in RemoteLazyInputStream,  a=dmeehan DONTBUILD\n\nThere was already similar logic being performed manually in\nRemoteLazyInputStream. This switches the code to use the common helper,\navoiding the need for a manual re-implementation of the method.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295913\n", "files": ["dom/file/ipc/RemoteLazyInputStream.cpp"], "git_node": "ef039f2d6c664ea4c64e78da088eea707e9d0b9c", "git_parents": ["aaed0faf9a0a3b3d3acdc0ada320a47cf918d1d6"], "node": "b9648ab1c1a9aa73ffec91b087068e12f1f9bb0b", "parents": ["6c1fe7fc67427ab69e2ec0d11f925b0612d098d8"], "tags": []}], "date": 1776964852, "git_changesets": ["aaed0faf9a0a3b3d3acdc0ada320a47cf918d1d6", "ef039f2d6c664ea4c64e78da088eea707e9d0b9c"], "user": "dmeehan@mozilla.com"}, "1045": {"changesets": [{"author": "Gregory Pappas \u003cgp3033@protonmail.com\u003e", "branch": "default", "desc": "Bug 1979281 - Fix Mochia methods not working in browser tests r=beth a=test-only\n\nWe need to pass an instance of testScope to Mochia,\nnot testScope itself. The current code is creating\nstatic methods on testScope, which are not accessible\ninside actual tests\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258681\n", "files": ["testing/mochitest/browser-test.js", "testing/mochitest/tests/SimpleTest/SimpleTest.js", "testing/modules/Mochia.js"], "git_node": "7ce58d5b3f5a08292433f9282e1a502e08ea668e", "git_parents": ["ef039f2d6c664ea4c64e78da088eea707e9d0b9c"], "node": "ef33bffb456d66b0e14c2c5421a0d105f4045428", "parents": ["b9648ab1c1a9aa73ffec91b087068e12f1f9bb0b"], "tags": []}], "date": 1776964982, "git_changesets": ["7ce58d5b3f5a08292433f9282e1a502e08ea668e"], "user": "dmeehan@mozilla.com"}, "1046": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029