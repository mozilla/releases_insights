n: https://phabricator.services.mozilla.com/D293825\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294809\n", "files": ["dom/media/AudioSegment.h"], "git_node": "b91a27b1451c8310f9be017af1b2e37c0ac6e98c", "git_parents": ["4a5ac6ba6cb3c8845f62e8747b7637da42c86bb0"], "node": "1c64bf7fc031cd8001e4ee01d4d34b6c40c41c43", "parents": ["8f4f6bed79e4fa163367fe4b1024fedd26fef7af"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2027433 Treat null input channels as zero in DownMixChunk()  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293826\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294810\n", "files": ["dom/media/AudioChannelFormat.h", "dom/media/AudioSegment.cpp"], "git_node": "f88d525ef90c6db14d944dbe8025e8b6a9422839", "git_parents": ["b91a27b1451c8310f9be017af1b2e37c0ac6e98c"], "node": "e487721db0b7203af4ccf7df9b6cb27a40aca891", "parents": ["1c64bf7fc031cd8001e4ee01d4d34b6c40c41c43"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2027433 use nullptr for silent up-mix channels  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293827\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294811\n", "files": ["dom/media/AudioSegment.cpp", "dom/media/AudioSegment.h"], "git_node": "6feda817e3dad4b3252a55fe088ce846421de619", "git_parents": ["f88d525ef90c6db14d944dbe8025e8b6a9422839"], "node": "5d926c2292840f82baed40e4776cbc3d80a93853", "parents": ["e487721db0b7203af4ccf7df9b6cb27a40aca891"], "tags": []}], "date": 1777055865, "git_changesets": ["c78fc2aae75eb727015d45cc82a4cbe189f61a25", "505f87a58f0d405d2d9442364e81d655aee90845", "e75d95cd8ccbd60fe297e397ea8425a84e429485", "8b313bd2f384b25969a18fbb8db56383c38b28a3", "ad3eb1b7a053e26b75bb5043631685cd0e89e59c", "2ca581b1df072a9a5bda017fc1025930f52c4ac7", "51e6d03