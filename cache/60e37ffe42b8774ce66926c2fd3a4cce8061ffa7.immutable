.services.mozilla.com/D297637\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298070\n", "files": ["netwerk/base/nsFileStreams.cpp"], "git_node": "19c811ad73d8dae29cdc212cc1f5013e1f5fc401", "git_parents": ["2c05d0c075ad4eaff3049c04518436513ea2b02e"], "node": "52f79388b05afe2b5072b82d58f83c154ebc7ba3", "parents": ["b4a6b5cd8a9951936f1cfb927037e4e2325fce95"], "tags": []}], "date": 1777840561, "git_changesets": ["19c811ad73d8dae29cdc212cc1f5013e1f5fc401"], "user": "dmeehan@mozilla.com"}, "1112": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2028266 - pick commit f995e1fbf9379027367a93aafd2b5711ba76f81e for libdav1d  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297774\n", "files": ["media/libdav1d/init-cdf-error-handling.patch", "media/libdav1d/moz.yaml", "third_party/dav1d/src/thread_task.c"], "git_node": "ae2f8a2620719567ec1abe3d1d66610f012a666c", "git_parents": ["19c811ad73d8dae29cdc212cc1f5013e1f5fc401"], "node": "ab93ba12f8c9ead7fd5ea26029fd8143a0796319", "parents": ["52f79388b05afe2b5072b82d58f83c154ebc7ba3"], "tags": []}], "date": 1777840603, "git_changesets": ["ae2f8a2620719567ec1abe3d1d66610f012a666c"], "user": "dmeehan@mozilla.com"}, "1113": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2035879.  a=dmeehan\n\n[PATCH] D3D11: Fix overflow in compressed 3D texture deferred-init\nFrom 5141d2393c8495286cfa8823c7f664e2b6780286 Mon Sep 17 00:00:00 2001\nThe ANGLE D3D11 backend computed the zero-fill buffer size for\nblock-compressed 3D textures using an unchecked\n32-bit multiplication that did not account for block height.\nThis produced a value four times larger than the actual\ncompressed image size and could overflow for sufficiently large\ntextures.\n\nThis fix:\n1. Uses InternalFormat::computeCompressedImageSize to correctly\ncalculate the required buffer size for compressed textures,\ntaking block dimensions into account.\n2. Employs angle::CheckedNumeric for uncompressed texture size\ncalculations to prevent potential integer overflows.\n3. Adds a regression test DeferredInit3DOverflow\nthat uses large texture dimensions (2048x2048x320) to verify\nthere is no ASAN error.\n\nBug: b/497896137\nFixed: b/501314630\nChange-Id: I76f0fb008af34e8ac78870318e608d16ed4ddd93\nReviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/7728091\nReviewed-by: Shahbaz Youssefi \u003csyoussefi@chromium.org\u003e\nCommit-Queue: Shahbaz Youssefi \u003csyoussefi@chromium.org\u003e\nAuto-Submit: Shrek Shao \u003cshrekshao@google.com\u003e\n(cherry picked from commit 838c9be2bc21df9ab804428d53bf61fa906be4b4)\nReviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/7783400\nReviewed-by: Geoff Lang \u003cgeofflang@chromium.org\u003e\n---\n src/libANGLE/renderer/d3d/TextureD3D.cpp      | 20 +++++--\n .../gl_tests/BPTCCompressedTextureTest.cpp    | 52 +++++++++++++++++++\n 2 files changed, 69 insertions(+), 3 deletions(-)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298020\n", "files": ["gfx/angle/checkout/src/libANGLE/renderer/d3d/TextureD3D.cpp"], "git_node": "992939643f2dc01dfea9c901ffc14d45eac4f4a8", "git_parents": ["ae2f8a2620719567ec1abe3d1d66610f012a666c"], "node": "6f506f97fadd041295c20a88a7aae43edc3f3cdc", "parents": ["ab93ba12f8c9ead7fd5ea26029fd8143a0796319"], "tags": []}], "date": 1777840932, "git_changesets": ["992939643f2dc01dfea9c901ffc14d45eac4f4a8"], "user": "dmeehan@mozilla.com"}, "1114": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035915 - DNSpacket cleanup,  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297489\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298253\n", "files": ["netwerk/dns/DNSPacket.cpp"], "git_node": "5641c02cd831bbfc9a4d65f1c2de9c88567cb096", "git_parents": ["992939643f2dc01dfea9c901ffc14d45eac4f4a8"], "node": "71583c89f79b8509b9c49b19365f5ce0e8d51d4d", "parents": ["6f506f97fadd041295c20a88a7aae43edc3f3cdc"], "tags": []}], "date": 1777915500, "git_changesets": ["5641c02cd831bbfc9a4d65f1c2de9c88567cb096"], "user": "dmeehan@mozilla.com"}, "1115": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1883230 - Check correct variable for WAYLAND_DISPLAY length in WaylandProxy::SetupWaylandDisplays.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297697\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298248\n", "files": ["third_party/wayland-proxy/wayland-proxy.cpp"], "git_node": "e8651a6d0ca3e470dcc11dce55d8e90d4ece8cab", "git_parents": ["5641c02cd831bbfc9a4d65f1c2de9c88567cb096"], "node": "43fe296350912d73ca603d00e6ca6b819eb7cb13", "parents": ["71583c89f79b8509b9c49b19365f5ce0e8d51d4d"], "tags": []}], "date": 1777915541, "git_changesets": ["e8651a6d0ca3e470dcc11dce55d8e90d4ece8cab"], "user": "dmeehan@mozilla.com"}, "1116": {"changesets": [{"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034496.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297022\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298227\n", "files": ["gfx/angle/checkout/src/libANGLE/renderer/d3d/d3d11/Buffer11.cpp"], "git_node": "4e1aee86f8bf15e822a22a6e82c806cf97e44a3f", "git_parents": ["e8651a6d0ca3e470dcc11dce55d8e90d4ece8cab"], "node": "b96dca3788eddcea22196f982a91c858639a8daa", "parents": ["43fe296350912d73ca603d00e6ca6b819eb7cb13"], "tags": []}], "date": 1777915643, "git_changesets": ["4e1aee86f8bf15e822a22a6e82c806cf97e44a3f"], "user": "dmeehan@mozilla.com"}, "1117": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025412: Simplify OPFS move and rename interfa