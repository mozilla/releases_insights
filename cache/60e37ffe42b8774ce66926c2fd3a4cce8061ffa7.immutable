it_parents": ["9a87c68dd9eaee4d9ab529be08b73f0fb7086199"], "node": "b7999ef4daf48eb97dfe512eb67c035926a2f548", "parents": ["42aef8e7de4e1a1a9b1a980c7969a423ae7872eb"], "tags": []}], "date": 1777655640, "git_changesets": ["2bc0fe44140cac797142bbd527e93eaa062074cb"], "user": "dmeehan@mozilla.com"}, "1105": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2019272: Remove reftest 1798297-1's \"notref\" comparison.  a=dmeehan DONTBUILD\n\nThis \"notref\" file relied on a 'palt' font-feature of the \"Yu Gothic\"\nfont that's bundled with Windows; and the != comparison is only valid if that\nfont-feature is present.\n\nAnd the \"palt\" font-feature was in fact removed from this font in a recent\nWindows upgrade (no longer present as of Yu Gothic version 1.95). So the\nnotref comparison is no longer valid/meaningful.  So let's just remove this\npart of the test.\n\nThis test was a regression-test for bug 1798297 which was specifically about\nadding a special-case for the \"palt\" font-feature in this specific font; so\nit's not too concerning to be nerfing the test, given that this font-feature is\nbeing removed from this font.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285548\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297963\n", "files": ["layout/reftests/bugs/1798297-1-notref.html", "layout/reftests/bugs/reftest.list"], "git_node": "7c0de10134f7778febffa958e128dffd8b5fad53", "git_parents": ["2bc0fe44140cac797142bbd527e93eaa062074cb"], "node": "3159e2f7e47edbea27ff437bfbf7ceba90006bce", "parents": ["b7999ef4daf48eb97dfe512eb67c035926a2f548"], "tags": []}], "date": 1777749106, "git_changesets": ["7c0de10134f7778febffa958e128dffd8b5fad53"], "user": "dmeehan@mozilla.com"}, "1106": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2027288 - Invalidate table cache on row addition/move/remove.  a=dmeehan DONTBUILD\n\nAlso use the pointer given from CachedTableCellAccessible::Acc.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D292881\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297984\n", "files": ["accessible/base/CachedTableAccessible.h", "accessible/generic/DocAccessible.cpp", "accessible/generic/LocalAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/RemoteAccessible.cpp"], "git_node": "9ac1c79cda2a339d6788d3cf2886c83d21234e67", "git_parents": ["7c0de10134f7778febffa958e128dffd8b5fad53"], "node": "a85b39ab94bd49a12c69876499245777fe14bc82", "parents": ["3159e2f7e47edbea27ff437bfbf7ceba90006bce"], "tags": []}], "date": 1777749155, "git_changesets": ["9ac1c79cda2a339d6788d3cf2886c83d21234e67"], "user": "dmeehan@mozilla.com"}, "1107": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034422.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296893\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297990\n", "files": ["gfx/angle/checkout/src/libANGLE/State.cpp"], "git_node": "62a8753ec1149268ce649a23b8b151e938e9d249", "git_parents": ["9ac1c79cda2a339d6788d3cf2886c83d21234e67"], "node": "58a1825fdc3a5bba7d9469a61f5b31def107e290", "parents": ["a85b39ab94bd49a12c69876499245777fe14bc82"], "tags": []}], "date": 1777749202, "git_changesets": ["62a8753ec1149268ce649a23b8b151e938e9d249"], "user": "dmeehan@mozilla.com"}, "1108": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035880.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297553\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297995\n", "files": ["gfx/skia/skia/include/core/SkRegion.h", "gfx/skia/skia/src/core/SkRegion.cpp", "gfx/skia/skia/src/core/SkRegionPriv.h"], "git_node": "c0d6821b35d9ae12aef1f1128289545c1ae5aee9", "git_parents": ["62a8753ec11