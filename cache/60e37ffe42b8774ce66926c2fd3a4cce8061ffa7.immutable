d4524e8ea81bbb67585f318db1a8c2", "parents": ["4e1aee4e101781dca5aa36249025c5bea96e8604"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2032042.  a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296998\n", "files": ["gfx/angle/checkout/src/libANGLE/renderer/d3d/d3d11/Buffer11.cpp"], "git_node": "acbc9d6f4cb230a8e5c67f12d7977c816f12f353", "git_parents": ["4189641c590de502391b01e17e885440153a1746"], "node": "03f63dc7a2a4a2787c75be1ead1c37c941961cbf", "parents": ["c08b167e25d4524e8ea81bbb67585f318db1a8c2"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2032043 - Cherry-pick commit 1803559c from upstream freetype.  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296505\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296952\n", "files": ["modules/freetype2/src/truetype/ttinterp.c"], "git_node": "526a51979998b25bd7383637cf1b17a6fb6661c0", "git_parents": ["acbc9d6f4cb230a8e5c67f12d7977c816f12f353"], "node": "cd0752178b40e772425d0363e142b752632d26a7", "parents": ["03f63dc7a2a4a2787c75be1ead1c37c941961cbf"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2030323 - Add DcompSurfaceDescriptor validity check  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296269\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296866\n\nBug 2030323 - Fix ESR140 build a=bustage\n", "files": ["gfx/layers/DcompSurfaceImage.cpp", "gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": "6e29433fbd23bb4d07f99214810362d5b418a252", "git_parents": ["526a51979998b25bd7383637cf1b17a6fb6661c0"], "node": "9464a014eea309350f7a57d08b0c53909f011438", "parents": ["cd0752178b40e772425d0363e142b752632d26a7"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2027883 - Fix integer overflow in cairo PDF surface image emission  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D292028\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297158\n", "files": ["gfx/cairo/cairo/src/cairo-pdf-surface.c"], "git_node": "6904a6a26dc530c4dc306178077e704ed7c96ae8", "git_parents": ["6e29433fbd23bb4d07f99214810362d5b418a252"], "node": "3f45ea2723160a3fb6795a6176ceef4dcc9ca0da", "parents": ["9464a014eea309350f7a57d08b0c53909f011438"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2019272: Remove reftest 1798297-1's \"notref\" comparison.  a=dsmith\n\nThis \"notref\" file relied on a 'palt' font-feature of the \"Yu Gothic\"\nfont that's bundled with Windows; and the != comparison is only valid if that\nfont-feature is present.\n\nAnd the \"palt\" font-feature was in fact removed from this font in a recent\nWindows upgrade (no longer present as of Yu Gothic version 1.95). So the\nnotref comparison is no longer valid/meaningful.  So let's just remove this\npart of the test.\n\nThis test was a regression-test for bug 1798297 which was specifically about\nadding a special-case for the \"palt\" font-feature in this specific font; so\nit's not too concerning to be nerfing the test, given that this font-feature is\nbeing removed from this font.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285548\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297963\n", "files": ["layout/reftests/bugs/1798297-1-notref.html", "layout/reftests/bugs/reftest.list"], "git_node": "8809023061cd07273ee1cc472a424346eee469f2", "git_parents": ["6904a6a26dc530c4dc306178077e704ed7c96ae8"], "node": "863f0a6db7b41fcaf3f33b9fde576b31474a8f96", "parents": ["3f45ea2723160a3fb6795a6176ceef4dcc9ca0da"], "tags": []}], "date": 1777948193, "git_changesets": ["2bd2770ee03fe5e4fd710d5ba923311de44e163d", "c63fb0cfc9fe4cee7a9e371b420c6876933b44ad", "e6aff54f83a1c7a5b7449d67fa82da7a7c69e11c", "4da63ea398201d189ef3754bc9729cc8fdfda551", "4189641c590de502391b01e17e885440153a1746", "acbc9d6f4cb230a8e5c67f12d7977c816f12f353", "526a51979998b25bd7383637cf1b17a6fb6661c0", "6e29433fbd23bb4d07f99214810362d5b418a252", "6904a6a26dc530c4dc306178077e704ed7c96ae8", "8809023061cd07273ee1cc472a424346eee469f2"], "user": "dsmith@mozilla.com"}, "1126": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2034352 - Make URL::SearchParams return an already_AddRefed  a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297263\n", "files": ["dom/url/URL.cpp", "dom/url/URL.h"], "git_node": "ad53e3301bf2a63f15bf6b1f7322e59ea14553a6", "git_parents": ["8809023061cd07273ee1cc472a424346eee469f2"], "node": "c0ea177cfbbb4e44c4c479249c3544770c6d2af9", "parents": ["863f0a6db7b41fcaf3f33b9fde576b31474a8f96"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2034422.  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D296893\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297990\n", "files": ["gfx/angle/checkout/src/libANGLE/State.cpp"], "git_node": "dcce9092ee65ec0111d5e6aa45a661ade179375c", "git_parents": ["ad53e3301bf2a63f15bf6b1f7322e59ea14553a6"], "node": "5f03364b785e0e17521af8793c6b67e69576151e", "parents": ["c0ea177cfbbb4e44c4c479249c3544770c6d2af9"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2035880.  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D297553\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297995\n", "files": ["gfx/skia/skia/include/core/SkRegion.h", "gfx/skia/skia/src/core/SkRegion.cpp", "gfx/skia/skia/src/core/SkRegionPriv.h"], "git_node": "2943d0c68e08418a63c421ae4bb631d5c49e6a5d", "git_parents": ["dcce9092ee65ec0111d5e6aa45a661ade179375c"], "node": "b32dc63047eaddd4fc953e6a9011d81abe6b75a1", "parents": ["5f03364b785e0e17521af8793c6b67e69576151e"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2033637.  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295654\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297741\n", "files": ["gfx/angle/checkout/src/libANGLE/renderer/d3d/TextureD3D.cpp"], "git_node": "f1d6366354a8d3d55a821b4f3bb65c51493abb1d", "git_parents": ["2943d0c68e08418a63c421ae4bb631d5c49e6a5d"], "node": "bd466a077e464275a8d6f54ba3a090aab1360d21", "parents": ["b32dc63047eaddd4fc953e6a9011d81abe6b75a1"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2035879.  a=dsmith\n\n[PATCH] D3D11: Fix overflow in compressed 3D texture deferred-init\nFrom 5141d2393c8495286cfa8823c7f664e2b6780286 Mon Sep 17 00:00:00 2001\nThe ANGLE D3D11 backend computed the zero-fill buffer size for\nblock-compressed 3D textures using an unchecked\n32-bit multiplication that did not account for block height.\nThis produced a value four times larger than the actual\ncompressed image size and could overflow for sufficiently large\ntextures.\n\nThis fix:\n1. Uses InternalFormat::computeCompressedImageSize to correctly\ncalculate the required buffer size for compressed textures,\ntaking block dimensions into account.\n2. Employs angle::CheckedNumeric for uncompressed texture size\ncalculations to prevent potential integer overflows.\n3. Adds a regression test DeferredInit3DOverflow\nthat uses large texture dimensions (2048x2048x320) to verify\nthere is no ASAN error.\n\nBug: b/497896137\nFixed: b/501314630\nChange-Id: I76f0fb008af34e8ac78870318e608d16ed4ddd93\nReviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/7728091\nReviewed-by: Shahbaz Youssefi \u003csyoussefi@chromium.org\u003e\nCommit-Queue: Shahbaz Youssefi \u003csyoussefi@chromium.org\u003e\nAuto-Submit: Shrek Shao \u003cshrekshao@google.com\u003e\n(cherry picked from commit 838c9be2bc21df9ab804428d53bf61fa906be4b4)\nReviewed-on: https://chromium-review.googlesource.com/c/angle/angle/+/7783400\nReviewed-by: Geoff Lang \u003cgeofflang@chromium.org\u003e\n", "files": ["gfx/angle/checkout/src/libANGLE/renderer/d3d/TextureD3D.cpp"], "git_node": "c6c73960996b2c00462790f6bce26cb7ff661e46", "git_parents": ["f1d6366354a8d3d55a821b4f3bb65c51493abb1d"], "node": "b77fb63140e7088ad461d6084cd8c82b340615b3", "parents": ["bd466a077e464275a8d6f54ba3a090aab1360d21"], "tags": []}, {"author": "Jari Jalkanen \u003cjjjalkanen@gmail.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2030461 - Use platform path separators with paths from nsIFile.  a=dsmith\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293871\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297459\n", "files": ["dom/filesystem/FileSystemSecurity.cpp", "dom/filesystem/FileSystemUtils.cpp", "dom/filesystem/FileSystemUtils.h"], "git_node": "01e920a48c99179915b2d319993a5e9a526b682d", "git_parents": ["c6c73960996b2c00462790f6bce26cb7ff661e46"], "node": "8bdb2c734537cecd730fa865ad634e79307b67b0", "parents": ["b77fb63140e7088ad461d6084cd8c82b340615b3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 2005068 - Turn off ioi tests on ESR140. r=taskgraph-reviewers,ahal a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295999\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/variant.py"], "git_node": "581d9052004e27308acfacecf14830276e704fed", "git_parents": ["01e920a48c99179915b2d319993a5e9a526b682d"], "node": "48e1193042af77ca96fb3656310ed8f8a6d3c9eb", "parents": ["8bdb2c734537cecd730fa865ad634e79307b67b0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 1923469 - Mark RTCRemoteInboundRtpStats.timestamp subtest as intermittent on Windows. r=aryx a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296000\n", "files": ["testing/web-platform/meta/webrtc/RTCPeerConnection-getStats-timestamp.https.html.ini"], "git_node": "d54f76f36b4995c7d6ecebe52dbc4b02f067ac2c", "git_parents": ["581d9052004e27308acfacecf14830276e704fed"], "node": "ef02a19926fac4b8f2a4cd9bd82d015763e1105a", "parents": ["48e1193042af77ca96fb3656310ed8f8a6d3c9eb"], "tags": []}, {"author": "Gregory Pappas \u003cgp3033@protonmail.com\u003e", "branch": "FIREFOX_ESR_140_10_X_RELBRANCH", "desc": "Bug 1979281 - Fix Mochia methods not working in browser tests r=beth a=test-only\n\nWe need to pass an instance of testScope to Mochia,\nnot testScope itself. The current code is creating\nstatic methods on testScope, which are not accessible\ninside actual tests\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258681\n", "files": ["testing/mochitest/browser-test.js", "testing/mochitest/tests/SimpleTest/SimpleTest.js", "testing/modules/Mochia.js"], "git_node": "9be59d838150d1e629a2329bcc9719af68030131", "git_parents": ["d54f76f36b4995c7d6ecebe52dbc4b02f067ac2c"], "node": "54ead6134a7a516ceb2ff311248ad1023907aa14", "parents": ["ef02a19926fac4b8f2a4cd9bd82d015763e1105a"], "tags": []}], "date": 1777950869, "git_changesets": ["ad53e3301bf2a63f15bf6b1f7322e59ea14553a6", "dcce9092ee65ec0111d5e6aa45a661ade179375c", "2943d0c68e08418a63c421ae4bb631d5c49e6a5d", "f1d6366354a8d3d55a821b4f3bb65c51493abb1d", "c6c73960996b2c00462790f6bce26cb7ff661e46", "01e920a48c99179915b2d319993a5e9a526b682d", "581d9052004e27308acfacecf14830276e704fed", "d54f76f36b4995c7d6ecebe52dbc4b02f067ac2c", "