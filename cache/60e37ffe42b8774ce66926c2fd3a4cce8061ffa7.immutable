95507\n", "files": ["netwerk/base/LoadInfo.cpp"], "git_node": "afe4777fcb9a75a40d7060a048d864a5cbe4b341", "git_parents": ["ddb5a1214b3b2210ac1e1ded807d150dc6dc5e3a"], "node": "34966198b0c94506ce6b9572c5b2e7b5906c2daa", "parents": ["a8716004c2bebb734768f1fd73b402a7b1c417db"], "tags": []}], "date": 1776799856, "git_changesets": ["afe4777fcb9a75a40d7060a048d864a5cbe4b341"], "user": "dmeehan@mozilla.com"}, "1010": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031921.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295127\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295558\n", "files": ["dom/canvas/WebGLContext.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "91829d550477b8ba602679cf279275f79e11c860", "git_parents": ["afe4777fcb9a75a40d7060a048d864a5cbe4b341"], "node": "838815cb3dacb004def87b8f41cf2d113c716681", "parents": ["34966198b0c94506ce6b9572c5b2e7b5906c2daa"], "tags": []}], "date": 1776800023, "git_changesets": ["91829d550477b8ba602679cf279275f79e11c860"], "user": "dmeehan@mozilla.com"}, "1011": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031958 - Fix Solaris/GCC -Wincompatible-pointer-types build error in ffvpx parser_list.c  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295104\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295303\n", "files": ["media/ffvpx/libavcodec/parser_list.c"], "git_node": "3541f3f73c446be29823155172f00e683163e2b0", "git_parents": ["91829d550477b8ba602679cf279275f79e11c860"], "node": "697beea4d17932e0aa35aa5baa091ad3c4573757", "parents": ["838815cb3dacb004def87b8f41cf2d113c716681"], "tags": []}], "date": 1776800098, "git_changesets": ["3541f3f73c446be29823155172f00e683163e2b0"], "user": "dmeehan@mozilla.com"}, "1012": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.nore