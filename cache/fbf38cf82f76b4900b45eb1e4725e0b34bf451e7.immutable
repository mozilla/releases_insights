webidl/WebAuthentication.webidl"], "git_node": null, "git_parents": [null], "node": "bf57507edde5080326501e24b4cc441481560333", "parents": ["1822ac63eb8d8bdd1cce0b181d36d999a7e7f4e7"], "tags": []}], "date": 1694173224, "git_changesets": [null, null], "user": "pchevrel@mozilla.com"}, "88": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez  \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1846293 - Improve flush handing in Canvas2D. r=dholbert a=pascalc\nDon't keep weak pointers before flushing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184950", "files": ["dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": null, "git_parents": [null], "node": "135c8a58eee1f9e93d283397120c77178c32368e", "parents": ["bf57507edde5080326501e24b4cc441481560333"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1842674 - Rework gfxCharacterMap management. r=aosmond a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185187", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h", "gfx/thebes/gfxPlatformFontList.cpp", "gfx/thebes/gfxPlatformFontList.h"], "git_node": null, "git_parents": [null], "node": "82a4110ee87f6b853d967392eeec8d92f445d188", "parents": ["135c8a58eee1f9e93d283397120c77178c32368e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1843700 - Hide popups synchronously if needed, even if already hiding async. r=NeilDeakin a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186126", "files": ["layout/xul/nsXULPopupManager.cpp"], "git_node": null, "git_parents": [null], "node": "6c23b6cc5af8a650952d3829c31222ef59a0af6e", "parents": ["82a4110ee87f6b853d967392eeec8d92f445d188"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1843700 - Temporarily annotate HidePopupCallback as script boundary. a=pascalc\n\nThe caller can already run script, it's just that other script-running\nfunctions are already marked as _BOUNDARY (incorrectly). Will fix\nproperly in a follow-up bug.\n\nMANUAL PUSH: Bustage fix CLOSED TREE", "files": ["layout/xul/nsXULPopupManager.h"], "git_node": null, "git_parents": [null], "node": "2ba2649ea65e19f0f2ef13f0baf60ebfc5e51f29", "parents": ["6c23b6cc5af8a650952d3829c31222ef59a0af6e"], "tags": []}, {"author": "Itiel \u003citiel_yn8@walla.com\u003e", "branch": "default", "desc": "Bug 1851001 - Set width to the warning image on about:preferences#privacy r=emilio,Gijs,settings-reviewers a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187697", "files": ["browser/themes/shared/preferences/privacy.css"], "git_node": null, "git_parents": [null], "node": "a0f1d529fb0484775bbdaac4779817f15d9cc3dd", "parents": ["2ba2649ea65e19f0f2ef13f0baf60ebfc5e51f29"], "tags": []}], "date": 1694188807, "git_changesets": [null, null, null, null, null], "user": "pchevrel@mozilla.com"}, "89": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187884", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "ce6277e59722e6bf11e9ff67daec807135850da6", "parents": ["a0f1d529fb0484775bbdaac4779817f15d9cc3dd"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1837070 - Ensure we flush OffscreenCanvas when the display list is recreated. r=lsalzman, a=RyanVM\n\nWhen we recreate the display list, e.g. after tabbing away, we need to\nensure we flush the OffscreenCanvas because our resource handles will be\ninvalidated. This requires the OffscreenCanvasDisplayHelper to know\nwhich OffscreenCanvas it belongs to, and a worker reference if necessary\nto do the dispatching for the flush. Otherwise we would require the\ncanvas to be updated manually by the web application to repaint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184324", "files": ["dom/canvas/OffscreenCanvas.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.h", "dom/html/HTMLCanvasElement.cpp", "dom/html/HTMLCanvasElement.h", "layout/generic/nsHTMLCanvasFrame.cpp"], "git_node": null, "git_parents": [null], "node": "dc5758d229e65e729a49096a77f49162129e194e", "parents": ["ce6277e59722e6bf11e9ff67daec807135850da6"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1848890 - Guard access to FontList::mBlocks with the font-list lock. r=jnicol a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187690", "files": ["gfx/thebes/SharedFontList-impl.h", "gfx/thebes/SharedFontList.cpp", "gfx/thebes/gfxPlatformFontList.cpp"], "git_node": null, "git_parents": [null], "node": "0f605d803733000f3e1fcc3a22c2d53190305314", "parents": ["dc5758d229e65e729a49096a77f49162129e194e"], "tags": []}], "date": 1694463142, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "90": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1852649 - Cherry-pick upstream libwebp fix. r=tnikkel, a=RyanVM\n\nBackport of:\nhttps://chromium.googlesource.com/webm/libwebp.git/+/2af26267cdfcb63a88e5c74a85927a12d6ca1d76\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187950", "files": ["media/libwebp/src/dec/vp8l_dec.c", "media/libwebp/src/dec/vp8li_dec.h", "media/libwebp/src/utils/huffman_utils.c", "media/libwebp/src/utils/huffman_utils.h"], "git_node": null, "git_parents": [null], "node": "96bd93fca47ae72ff0385d2bd87ec7bd18382b0c", "pare