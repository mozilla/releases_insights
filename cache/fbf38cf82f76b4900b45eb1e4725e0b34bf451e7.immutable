third_party/rust/packed_simd_2/src/codegen/reductions/mask/x86/sse.rs", "third_party/rust/packed_simd_2/src/codegen/reductions/mask/x86/sse2.rs", "third_party/rust/packed_simd_2/src/codegen/shuffle.rs", "third_party/rust/packed_simd_2/src/codegen/shuffle1_dyn.rs", "third_party/rust/packed_simd_2/src/codegen/swap_bytes.rs", "third_party/rust/packed_simd_2/src/codegen/v128.rs", "third_party/rust/packed_simd_2/src/codegen/v16.rs", "third_party/rust/packed_simd_2/src/codegen/v256.rs", "third_party/rust/packed_simd_2/src/codegen/v32.rs", "third_party/rust/packed_simd_2/src/codegen/v512.rs", "third_party/rust/packed_simd_2/src/codegen/v64.rs", "third_party/rust/packed_simd_2/src/codegen/vPtr.rs", "third_party/rust/packed_simd_2/src/codegen/vSize.rs", "third_party/rust/packed_simd_2/src/lib.rs", "third_party/rust/packed_simd_2/src/masks.rs", "third_party/rust/packed_simd_2/src/sealed.rs", "third_party/rust/packed_simd_2/src/testing.rs", "third_party/rust/packed_simd_2/src/testing/macros.rs", "third_party/rust/packed_simd_2/src/testing/utils.rs", "third_party/rust/packed_simd_2/src/v128.rs", "third_party/rust/packed_simd_2/src/v16.rs", "third_party/rust/packed_simd_2/src/v256.rs", "third_party/rust/packed_simd_2/src/v32.rs", "third_party/rust/packed_simd_2/src/v512.rs", "third_party/rust/packed_simd_2/src/v64.rs", "third_party/rust/packed_simd_2/src/vPtr.rs", "third_party/rust/packed_simd_2/src/vSize.rs", "third_party/rust/packed_simd_2/tests/endianness.rs"], "git_node": null, "git_parents": [null], "node": "710f69d44491d9ae501814400df35983128c5800", "parents": ["aab12f291219ce19dfa8f4e4a3551fcc5ece57ca"], "tags": []}, {"author": "Masatoshi Kimura \u003cVYV03354@nifty.ne.jp\u003e", "branch": "default", "desc": "Bug 1851596 - await _handleWDBAResult. r=nalexander a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187845", "files": ["browser/components/shell/ShellService.sys.mjs", "browser/components/shell/test/browser_setDefaultBrowser.js"], "git_node": null, "git_parents": [null], "node": "caeab8f0f9ea7fbe29d2193ab3e286e9f25043aa", "parents": ["710f69d44491d9ae501814400df35983128c5800"], "tags": []}, {"author": "Masatoshi Kimura \u003cVYV03354@nifty.ne.jp\u003e", "branch": "default", "desc": "Bug 1851596 - Skip test on platforms earlier than Windows 10. r=test-only a=pascalc\n\n\nSince ESR 115 still supports Windows 7/8.1, we have to skip the test on\nthose platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187879", "files": ["browser/components/shell/test/browser_setDefaultBrowser.js"], "git_node": null, "git_parents": [null], "node": "9755b5fb1c6f8b6542b4067cfa5c3b87643e66c2", "parents": ["caeab8f0f9ea7fbe29d2193ab3e286e9f25043aa"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1849269 - Add SharedWorkerManager::mRemoteWorkerController nullptr checking in SharedWorkerManager::Terminate(). r=dom-worker-reviewers,smaug,asuth a=pascalc\n\nHere comes a possible might cause the crash stack.\n\n    RemoteWorkerController creation fails. If it is Shutdown phase or OOM. The point is ServiceWorkerManager::mRemoteWorkerController is kept as nullptr.\n\n    WorkerManagerCreatedRunnable::mManagerWrapper is the only holder of the ServiceWorkerManager. And it would be released once the runnable finished.\n\n    When releasing WorkerManagerCreatedRunnable::mManagerWrapper, ServiceWorkerManager::UnregisterHolder() is called. In the end SharedWorkerManager::Terminate() is triggered to release the SharedWorker by calling SharedWorkerManager::mRemoteWorkerController::Terminate. However, SharedWorkerManager::mRemoteWorkerController is reasonably a nullptr here, then we meet a de-reference on nullptr.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187269", "files": ["dom/workers/sharedworkers/SharedWorkerManager.cpp"], "git_node": null, "git_parents": [null], "node": "74134705e36a44ac7a24c44b771520bba3ca07f1", "parents": ["9755b5fb1c6f8b6542b4067cfa5c3b87643e66c2"], "tags": []}], "date": 1694510704, "git_changesets": [null, null, null, null, null], "user": "pchevrel@mozilla.com"}, "94": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 2e61ec742c2039eaacac6c4d99c919db51a34b68 with FIREFOX_115_2_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "a5b7d8229da92127eeb43fb285d01f3ec0808206", "parents": ["74134705e36a44ac7a24c44b771520bba3ca07f1"], "tags": []}], "date": 1694532379, "git_changesets": [null], "user": "ffxbld"}, "95": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1850843 - Keeping doing nothing for NotificationWorkerRunnable when the worker is dying. r=dom-worker-reviewers,smaug a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187433", "files": ["dom/notification/Notification.cpp"], "git_node": null, "git_parents": [null], "node": "19e7c1c9a98c2fed55a7d15e02750811025c8565", "parents": ["a5b7d8229da92127eeb43fb285d01f3ec0808206"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1851989 - Add checks in BackgroundParentImpl to see if methods are called by correct actors, r=nika a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187785", "files": ["ipc/glue/BackgroundParentImpl.cpp"], "git_node": null, "git_parents": [null], "node": "a1bbcdb3fee60222b2130dd0e47837d47e9b242e", "parents": ["19e7c1c9a98c2fed55a7d15e02750811025c8565"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1849518 - Add null after call to FileLocation::GetBaseFile r=jesup a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187537", "files": ["mozglue/misc/MmapFaultHandler.h"], "git_node": null, "git_parents": [null], "node": "8bb39dee1f5bfb209958e71330c8e139051a0b2b", "parents": ["a1bbcdb3fee60222b2130dd0e47837d47e9b242e"], "tags": []}, {"author": "Ray Kraesig \u003crkraesig@mozilla.com\u003e", "branch": "default", "desc": "Bug 1850969 - Save off and restore values in patched_NtMapViewOfSection's arguments  r=gstoll a=pascalc\n\nNtMapViewOfSection doesn't write to its out-pointer arguments if it\nreturns an error. Mimic its behavior a little more closely by ensuring\nthat whatever values were present are restored if we unmap and abort.\n\nAvoid taking any pointers to the stack while doing so.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187737", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp"], "git_node": null, "git_parents": [null], "node": "72057601fb07a5042870b1f25635e0f143d1de74", "parents": ["8bb39dee1f5bfb209958e71330c8e139051a0b2b"], "tags": []}], "date": 1694685824, "git_changesets": [null, null, null, null], "user": "pchevrel@mozilla.com"}, "96": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188234", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "fd97120c92754e4bd0af89ec68e7b94a190d447f", "parents": ["72057601fb07a5042870b1f25635e0f143d1de74"], "tags": []}], "date": 1694694834, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "97": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1852460 - Actually land the testcase instead of an empty file. r=