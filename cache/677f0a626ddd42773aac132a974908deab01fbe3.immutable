com\u003e", "branch": "default", "desc": "Bug 1515052 - Use WeakPtr for extension parent pointer. r=lsalzman a=RyanVM\nDifferential Revision: https://phabricator.services.mozilla.com/D31942", "files": ["dom/canvas/WebGLContext.h", "dom/canvas/WebGLExtensionCompressedTextureASTC.cpp", "dom/canvas/WebGLExtensionDebugShaders.cpp", "dom/canvas/WebGLExtensionDisjointTimerQuery.cpp", "dom/canvas/WebGLExtensionDrawBuffers.cpp", "dom/canvas/WebGLExtensionInstancedArrays.cpp", "dom/canvas/WebGLExtensionLoseContext.cpp", "dom/canvas/WebGLExtensionMOZDebug.cpp", "dom/canvas/WebGLExtensionVertexArray.cpp", "dom/canvas/WebGLObjectModel.h"], "git_node": null, "git_parents": [null], "node": "59cff574fac4909976fd25caf261b91e7a6cec32", "parents": ["c1a5c7102567dcd35a6c5763e8b0a6929e892735"], "tags": []}, {"author": "Kyle Machulis \u003ckyle@nonpolynomial.com\u003e", "branch": "default", "desc": "Bug 1543804 - Don't allow cross-origin POST redirects on 308 codes; r=jmathies, a=RyanVM\n\nWe already don't allow cross origin POST redirects on 307 redirects,\nthis adds extra guards to make sure we don't allow them on 308s\neither.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D28927", "files": ["dom/plugins/base/nsPluginStreamListenerPeer.cpp"], "git_node": null, "git_parents": [null], "node": "75dbb6dbcba416c86e7b6f4b0d521053daa0ebe7", "parents": ["59cff574fac4909976fd25caf261b91e7a6cec32"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1555523. r=alchen a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33639", "files": ["parser/html/javasrc/Tokenizer.java", "parser/html/nsHtml5Tokenizer.cpp"], "git_node": null, "git_parents": [null], "node": "911475b61be3cb9b0ae701beb838cab2aaecc157", "parents": ["75dbb6dbcba416c86e7b6f4b0d521053daa0ebe7"], "tags": []}], "date": 1561054777, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "448": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Backed out changeset b1b34f1eebbc (bug 1522093) for bustage at nsHttpChannel.cpp:1657. a=backout", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": null, "git_parents": [null], "node": "409a5e270fa68682629a992def5fcd8a65fbc328", "parents": ["911475b61be3cb9b0ae701beb838cab2aaecc157"], "tags": []}], "date": 1561055801, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "449": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 repo-update HSTS HPKP blocklist tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36188", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "a0def0e8b5c3d8f9c8dfde09d9b43647b3eb5644", "parents": ["409a5e270fa68682629a992def5fcd8a65fbc328"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1550655 - Cherry-pick fixes for angle-66. r=lsalzman, a=RyanVM", "files": ["gfx/angle/checkout/out/gen/angle/id/commit.h", "gfx/angle/checkout/src/common/angleutils.h", "gfx/angle/checkout/src/libANGLE/State.cpp", "gfx/angle/checkout/src/libANGLE/VertexArray.cpp", "gfx/angle/checkout/src/libANGLE/VertexArray.h", "gfx/angle/checkout/src/libANGLE/renderer/d3d/VertexDataManager.cpp", "gfx/angle/checkout/src/libANGLE/renderer/d3d/d3d11/ResourceManager11.cpp", "gfx/angle/checkout/src/libANGLE/renderer/d3d/d3d9/Renderer9.cpp", "gfx/angle/cherries.log"], "git_node": null, "git_parents": [null], "node": "39861a66e6654a425ddea535dfbe0b76f61c99bb", "parents": ["a0def0e8b5c3d8f9c8dfde09d9b43647b3eb5644"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1558548 - Update Firefox ESR60 to NSS 3.36.8. a=RyanVM\n\nUPGRADE_NSS_RELEASE", "files": ["old-configure.in", "security/nss/.taskcluster.yml", "security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/gtests/pk11_gtest/pk11_curve25519_unittest.cc", "security/nss/lib/cryptohi/seckey.c", "security/nss/lib/freebl/dh.c", "security/nss/lib/freebl/ec.c", "security/nss/lib/freebl/ecl/ecp_25519.c", "security/nss/lib/freebl/mpi/mpi.c", "security/nss/lib/nss/nss.h", "security/nss/lib/pk11wrap/pk11akey.c", "security/nss/lib/pk11wrap/pk11cert.c", "security/nss/lib/pk11wrap/pk11pk12.c", "security/nss/lib/softoken/legacydb/lgattr.c", "security/nss/lib/softoken/pkcs11c.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/quickder.c", "security/nss/tests/chains/scenarios/realcerts.cfg", "security/nss/tests/libpkix/certs/PayPalEE.cert", "security/nss/tests/libpkix/certs/PayPalICA.cert", "security/nss/tests/libpkix/vfychain_test.lst"], "git_node": null, "git_parents": [null], "node": "a26b1ffa200abb60a1e06b4e6510137c7e28626e", "parents": ["39861a66e6654a425ddea535dfbe0b76f61c99bb"], "tags": []}, {"author": "Michal Novotny \u003cmichal.novotny@gmail.com\u003e", "branch": "default", "desc": "Bug 1528481 - Possible use after free in Http2Session::RecvPushPromise() if we have a usable entry in the cache for the resource. r=dragana, a=ritu\n\nIf we find a usable cache entry, the stream is closed and release in CachePushCheckCallback::OnCacheEntryCheck(). This patch converts raw pointer to a weak pointer, so we can simply check if the object still exists after AsyncOpenURI() finishes.", "files": ["netwerk/protocol/http/Http2Session.cpp"], "git_node": null, "git_parents": [null], "node": "7d865c16cc050c1e7d6a43fd1d4fee30f10940c0", "parents": ["a26b1ffa200abb60a1e06b4e6510137c7e28626e"], "tags": []}, {"author": "Michal Novotny \u003cmichal.novotny@gmail.com\u003e", "branch": "default", "desc": "Bug 1547266 - Make sure Http2PushedStream is used only on socket thread. r=dragana, a=ritu\n\nRaw pointer to Http2PushedStream is passed to nsHttpChannel and nsHttpTransaction to get it back to a new Http2Stream in the Http2Session. As a result Http2PushedStream's methods can be called on a wrong thread and possibly on already freed object. This patch uses Http2PushedStreamWrapper instead, which takes care about thread safety and checks if the object is still alive.", "files": ["netwerk/protocol/http/Http2Push.cpp", "netwerk/protocol/http/Http2Push.h", "netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Stream.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/protocol/http/nsHttpTransaction.h"], "git_node": null, "git_parents": [null], "node": "dd025bfd97b1913d5280637c74ec357aadf99fa0", "parents": ["7d865c16cc050c1e7d6a43fd1d4fee30f10940c0"], "tags": []}], "date": 1561656990, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "450": {"changesets": [{"author": "Marco Trevisan (Trevi\u00f1o) \u003cmail@3v1n0.net\u003e", "branch": "default", "desc": "Bug 1560064 - Barrier: Set MovableCellHasher\u003cJSObject*\u003e visibility before being used. r=sfink, a=RyanVM", "files": ["js/src/gc/Barrier.cpp", "js/src/gc/Barrier.h"], "git_node": null, "git_parents": [null], "node": "018a95ef3070d3b37b16ea6d3b863ac2694d54da", "parents": ["dd025bfd97b1913d5280637c74ec357aadf99fa0"], "tags": []}, {"author": "Marco Trevisan (Trevi\u00f1o) \u003cmail@3v1n0.net\u003e", "branch": "default", "desc": "Bug 1560064 - Barrier: Remove JS_BROKEN_GCC_ATTRIBUTE_WARNING guards. r=sfink, a=RyanVM", "files": ["js/src/gc/Barrier.cpp"], "git_node": null, "git_parents": [null], "node": "40875ef8e478b3abf990a5e46b543eb7df4f03a8", "parents": ["018a95ef3070d3b37b16ea6d3b863ac2694d54da"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1556733 - [10.15] Multiple \"Firefox Nightly Software Update\" Mac OS X quarantine dialogs when performing a software update. r=rstrong,spohl, a=RyanVM\n\nOn Mac, remove the \"com.apple.quarantine\" extended attribute from the updater after it is copied to the staging area. Required on macOS 10.15 which has new restrictions on launching quarantined applications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35972", "files": ["toolkit/xre/nsUpdateDriver.cpp"], "git_node": null, "git_parents": [null], "node": "6df5bb56fbbf3ee77c799c558ef8632eed402fda", "parents": ["40875ef8e478b3abf990a5e46b543eb7df4f03a8"], "tags": []}], "date": 1561734757, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "451": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1556733 - Add ifdefs so the newly-added code is only used on OSX builds. r=haik, a=bustage", "files": ["toolkit/xre/nsUpdateDriver.cpp"], "git_node": null, "git_parents": [null], "node": "53643f358ba85c34674f2f02d58020bbc84955f9", "parents": ["6df5bb56fbbf3ee77c799c558ef8632eed402fda"], "tags": []}], "date": 1561738784, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "452": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "de191cc363696e4e94c0c2ad2fac1961db1eb0f7", "parents": ["53643f358ba85c34674f2f02d58020bbc84955f9"], "tags": []}], "date": 1561971802, "git_changesets": [null], "user": "ffxbld-merge"}, "453": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr60 re