792d40f0ffff11", "1e8f5f3e6d88a576ed45e6092a28fc727455bc10", "20323b4e6070b55375484601410b2b3e25e233b9", "94aecff01db2fe86a14c3d13f034de1eccab3488", "a871da9e212cd507b1961e733d2554926f6b501d", "77f771c88354dec2f3fa457e1b049f17fe80cec2", "dc76e9d3c884202eba8dad73588381560020ac7d", "90b38ce9e00af3743f7d25abea23bb0d5901198b", "41fd88cb1ec1ce5e5cf0187610712af5309f5cc4", "f2d3fabf804832351b5d3fab1002a220a0be4df7", "bc49288c185b52e0c61c09fe69ec6b65b38e8249", "aa8f489b7e4d68c3ba8d75a885fb2a364f11f429", "8466e40e45e411cb9d82c5da5306391685b9c5a6", "b985b06942cd27773edf7afe748f81e0d0a14806"], "user": "ffxbld@lando.moz.tools"}, "484": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2065929 - Return resolved promise in ContentSearch.destroy  a=dmeehan DONTBUILD\n\n`new Promise()` throws as the constructor requires a function.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320739\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322726\n", "files": ["browser/actors/ContentSearchParent.sys.mjs"], "git_node": "b8bd1847c9078baa5aa9a1c3139ac0ad20e809d6", "git_parents": ["15a726468dfdb223039d7325da0dd30c809db839"], "node": "159283fa493075f7a828783331057156293ee414", "parents": ["f667132e4c6606b36d8f0d47c5bc19f611357f06"], "tags": []}], "date": 1788301104, "git_changesets": ["b8bd1847c9078baa5aa9a1c3139ac0ad20e809d6"], "user": "dmeehan@mozilla.com"}, "485": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025191 - Principal validation for postMessage.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314662\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322606\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "3d5f6da626daaf448dc7720bcb6acaa43662967c", "git_parents": ["b8bd1847c9078baa5aa9a1c3139ac0ad20e809d6"], "node": "e566aeefd3f2b1ae7080da8bed9da01d2c3cb19e", "parents": ["159283fa493075f7a828783331057156293ee414"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2063905 - Validate PostMessage source against innerWindowId,  a=dmeehan\n\nThis is a more reliable mechanism for validating the owning process,\nwhich should avoid edge cases around navigation where the owning process\nfor a BrowsingContext may change while postMessage is being sent.\n\nIf the inner window is gone, this clears out source, in a manner similar\nto PostMessageEvent::Run.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319247\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322607\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "66748d903ba16fc72dbcb172d64a292253f419e1", "git_parents": ["3d5f6da626daaf448dc7720bcb6acaa43662967c"], "node": "fab7280bd9d7429b7414d7761c998a9a7683b1bf", "parents": ["e566aeefd3f2b1ae7080da8bed9da01d2c3cb19e"], "tags": []}], "date": 1788301284, "git_changesets": ["3d5f6da626daaf448dc7720bcb6acaa43662967c", "66748d903ba16fc72dbcb172d64a292253f419e1"], "user": "dmeehan@mozilla.com"}, "486": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2025191 - Fix ESR153 a=bustage\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "eeba7fd01991d9eb32773805b4e6549168e3b700", "git_parents": ["66748d903ba16fc72dbcb172d64a292253f419e1"], "node": "b3eeabdecf74897756d9b4a1b6454c54ecb37a7c", "parents": ["fab7280bd9d7429b7414d7761c998a9a7683b1bf"], "tags": []}], "date": 1788304039, "git_changesets": ["eeba7fd01991d9eb32773805b4e6549168e3b700"], "user": "dmeehan@mozilla.com"}, "487": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061235: Clean up some uses of STGMEDIUM  a=dmeehan DONTBUILD\n\nThis patch includes a bunch of tiny code improvements:\n\n1. The main part of this patch is in nsDataObj::GetText, where it sizes the buffer that we add to the STGMEDIUM by the max char size for the code page, specifically for folks who have configured Windows with the experimental UTF-8 code page, where characters can be 3 bytes.  (NB: An AI checked on stateful code pages.  With state, the max character size can be exceeded.  However, the AI reports that Windows does not allow those pages as CP_ACP.  It says: \"CP_ACP can only resolve to a single-byte code page, a DBCS code page, or 65001. ISO-2022-* and UTF-7 are usable as explicit code-page arguments but Windows won't install them as the system ANSI code page. Every ACP-eligible family is stateless, and all of them held the bound in the measurements above.\".)\n\n2. ScopedOLEMemory checks that the size_t allocation is within bounds.\n\n3. Initializes STGMEDIUM (to TYMED_NULL) in places where it wasn't before.\n\n4. Releases allocated STGMEDIUMs on error (and return an error code when appropriate).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D321723\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322811\n", "files": ["widget/windows/WinOLELock.h", "widget/windows/nsClipboard.cpp", "widget/windows/nsDataObj.cpp", "widget/windows/nsDataObjCollection.cpp", "widget/windows/nsDragService.cpp"], "git_node": "6c2b26ebe897e1c03d481e81a4c94d8d6638b733", "git_parents": ["eeba7fd01991d9eb32773805b4e6549168e3b700"], "node": "bc165dc6bbd2a69d80d18dcda666246eba1adf9e", "parents": ["b3eeabdecf74897756d9b4a1b6454c54ecb37a7c"], "tags": []}], "date": 1788373232, "git_changesets": ["6c2b26ebe897e1c03d481e81a4c94d8d6638b733"], "user": "dmeehan@mozilla.com"}, "488": {"changesets": [{"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061503 - Validate draw fetch limits for matrix attribute columns.  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D322729\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322753\n", "files": ["dom/canvas/WebGLProgram.cpp", "dom/canvas/test/webgl-mochitest/mochitest.toml", "dom/canvas/test/webgl-mochitest/test_draw_matrix_attrib_fetch_limits.html"], "git_node": "debb9add33c102b03492b4f795cddfe27a1d2494", "git_parents": ["6c2b26ebe897e1c03d481e81a4c94d8d6638b733"], "node": "6b527e71434c30b95cf2d64b3291fed03baa7f16", "parents": ["bc165dc6bbd2a69d80d18dcda666246eba1adf9e"], "tags": []}], "date": 1788373254, "git_changesets": ["debb9add33c102b03492b4f795cddfe27a1d2494"], "user": "dmeehan@mozilla.com"}, "489": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058181 - More carefully clamp grid tracks.  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322751\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "testing/web-platform/tests/css/css-grid/firefox-bug-2058181-crash.html"], "git_node": "547f4835e82070b2a952e360863f5dd6214791d7", "git_parents": ["debb9add33c102b03492b4f795cddfe27a1d2494"], "node": "6540ac7f1948846320ade983ee423f46cc1a88af", "parents": ["6b527e71434c30b95cf2d64b3291fed03baa7f16"], "tags": []}], "date": 1788373277, "git_changesets": ["547f4835e82070b2a952e360863f5dd6214791d7"], "user": "dmeehan@mozilla.com"}, "490": {"changesets": [{"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2060235 - Look up proxy contexts by childId and actor.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319821\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322150\n", "files": ["toolkit/components/extensions/ExtensionParent.sys.mjs"], "git_node": "ef9aeb3811a6401b23f0993b0bbdbdec549d9bb9", "git_parents": ["547f4835e82070b2a952e360863f5dd6214791d7"], "node": "1501af36e16bc629a46aca5b607464131d06234a", "parents": ["6540ac7f1948846320ade983ee423f46cc1a88af"], "tags": []}], "date": 1788373663, "git_changesets": ["ef9aeb3811a6401b23f0993b0bbdbdec549d9bb9"], "user": "dm