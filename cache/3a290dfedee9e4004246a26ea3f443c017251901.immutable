nsMathMLmunderoverFrame.h", "layout/svg/SVGContainerFrame.cpp", "layout/svg/SVGContainerFrame.h", "layout/svg/SVGFEImageFrame.cpp", "layout/svg/SVGImageFrame.cpp", "layout/svg/SVGImageFrame.h", "layout/svg/SVGOuterSVGFrame.cpp", "layout/svg/SVGOuterSVGFrame.h", "layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableCellFrame.h", "layout/tables/nsTableColFrame.h", "layout/tables/nsTableColGroupFrame.cpp", "layout/tables/nsTableColGroupFrame.h", "layout/tables/nsTableFrame.cpp", "layout/tables/nsTableFrame.h", "layout/tables/nsTableRowFrame.cpp", "layout/tables/nsTableRowFrame.h", "layout/tables/nsTableRowGroupFrame.cpp", "layout/tables/nsTableRowGroupFrame.h", "layout/tables/nsTableWrapperFrame.cpp", "layout/tables/nsTableWrapperFrame.h", "layout/xul/nsMenuPopupFrame.cpp", "layout/xul/nsMenuPopupFrame.h", "layout/xul/nsScrollbarButtonFrame.cpp", "layout/xul/nsScrollbarButtonFrame.h", "layout/xul/nsScrollbarFrame.cpp", "layout/xul/nsScrollbarFrame.h", "layout/xul/nsSliderFrame.cpp", "layout/xul/nsSliderFrame.h", "layout/xul/nsSplitterFrame.cpp", "layout/xul/nsSplitterFrame.h", "layout/xul/tree/nsTreeBodyFrame.cpp", "layout/xul/tree/nsTreeBodyFrame.h"], "git_node": null, "git_parents": [null], "node": "006f3d725ce08ffc75d749c88c50fdfc8bb267eb", "parents": ["5d728501a599a433ec913a7a1ade431a90070d35"], "tags": []}, {"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1850297 - Make viewsource errors more visible. r=dao, a=RyanVM\n\nMake the errors more visible in viewsource/XMLPrettyPrint by adding a\nsemitransparent red background and switching from a dotted underline to\na wavy underline. Both styles were chosen for consistency with the\ndevtools debugger's error styles. Same background color and same\nunderline appearance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188284", "files": ["layout/style/res/viewsource.css"], "git_node": null, "git_parents": [null], "node": "15a36d5c569e3dfe7b2c73e80600ebba61b256eb", "parents": ["006f3d725ce08ffc75d749c88c50fdfc8bb267eb"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840918 - Protect access to gDBManager of IndexedDatabaseManager. r=dom-storage-reviewers,janv a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188708", "files": ["dom/indexedDB/IndexedDatabaseManager.cpp"], "git_node": null, "git_parents": [null], "node": "df84bc300fd68d96cef12f98f9564179fa8d3921", "parents": ["15a36d5c569e3dfe7b2c73e80600ebba61b256eb"], "tags": []}, {"author": "John Bieling \u003cjohn@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1852249 - Use a central/exported permission Localization object, to allow builds to modify it. r=extension-reviewers,robwu a=RyanVM", "files": ["toolkit/components/extensions/Extension.sys.mjs", "toolkit/components/extensions/ExtensionPermissionMessages.sys.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_detail_permissions.js"], "git_node": null, "git_parents": [null], "node": "342dd9564c17ea5bd6ccd4e74257ea1eedd46d3d", "parents": ["df84bc300fd68d96cef12f98f9564179fa8d3921"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 1850423 - Remove `firefox-esr-next` bouncer aliases from esr115, r=jcristau,releng-reviewers a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189373", "files": ["taskcluster/ci/release-bouncer-aliases/kind.yml"], "git_node": null, "git_parents": [null], "node": "a6d1bb14d854360ea15518e1775d3088a4edb359", "parents": ["342dd9564c17ea5bd6ccd4e74257ea1eedd46d3d"], "tags": []}], "date": 1696271335, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "121": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1851787 - Annotate a mochitest that no longer asserts. a=test-only DONTBUILD\n\nAs expected because the NS_ASSERTION was removed in the patch.", "files": ["layout/generic/test/test_bug394239.html"], "git_node": null, "git_parents": [null], "node": "2ac72356ec29c91f5e504e555ea91c2d6a689c15", "parents": ["a6d1bb14d854360ea15518e1775d3088a4edb359"], "tags": []}], "date": 1696275323, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "122": {"changesets": [{"author": "Marc Seibert \u003cmseibert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1704420 - Test. r=mak, a=test-only", "files": ["browser/components/urlbar/tests/browser/browser_UrlbarInput_formatValue.js"], "git_node": null, "git_parents": [null], "node": "b89315fc78f88d93b655358543017659ed6594a6", "parents": ["2ac72356ec29c91f5e504e555ea91c2d6a689c15"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1846703 - Backport a single revision from ffmpeg into our vendored copy, to fix the build with recent binutils. r=glandium, a=RyanVM\n\nBecause this library is a rather complex, manually trimmed, subset of ffmpeg,\nthis doesn't use updatebot. We're currently investigating moving to it to at\nleast fix some manual work needed, but that hasn't happened yet. In lieu of\nadding the new patch to a yaml file, I'm modified the Mozilla-specific README.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189751", "files": ["media/ffvpx/1846703.patch", "media/ffvpx/README_MOZILLA", "media/ffvpx/libavcodec/x86/mathops.h"], "git_node": null, "git_parents": [null], "node": "e024fe4fd62caae07e9415f4fdddba40f04c2aca", "parents": ["b89315fc78f88d93b655358543017659ed6594a6"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1836972 - [wdspec] Add timeout=long to /webdriver/tests/bidi/input/perform_actions/key_events.py r=webdriver-reviewers,whimboo a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180126", "files": ["testing/web-platform/tests/webdriver/tests/bidi/input/perform_actions/key_events.py"], "git_node": null, "git_parents": [null], "node": "fe92199e8d6962fe9446e711f4ffc9f5789d17d0", "parents": ["e024fe4fd62caae07e9415f4fdddba40f04c2aca"], "tags": []}], "date": 1696348879, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "123": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845309 - Use highp for texcoords in DrawTargetWebgl shaders. r=jrmuizel a=RyanVM\n\nThis issue was originally reported by Asahi Lina, and they also proposed the original\nversion of these changes. I have reworked them a bit just to clean up how clip TCs\nare passed down so that distance AA does not have to be highp.\n\nTheir original comment describing the issue were, in part:\n\n\"See DrawTargetWebgl::SharedContext::CreateShaders in dom/canvas/DrawTargetWebgl.cpp. The fragment shaders specify precision mediump float; and then don't use overriding precision qualifiers anywhere. This causes the texcoords to use fp16 precision on GPUs that support it, which is not sufficient for correct rendering.\"\n\n\"Note that this is a common mistake and the Mesa GPU driver we've been developing actually includes a heuristic that fixes the first instance of the problem (where the varying is used as a texcoord directly), but not the second one where there is an intermediate clamp(). It is that second one that is breaking Google Sheets.\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187694", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": null, "git_parents": [null], "node": "5a104875c516565c0ca1560791e9baec7b8e6b54", "parents": ["fe92199e8d6962fe9446e711f4ffc9f5789d17d0"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@mozilla.com\u003e", "branch": "default", "desc": "Bug 1836607 - Drop mWrappedRunnable early. r=asuth, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190029", "files": ["dom/workers/WorkerPrivate.cpp"], "git_node": null, "git_parents": [null], "node": "8c9a876fd94a6dd31805c96f00b5752d93942c92", "parents": ["5a104875c516565c0ca1560791e9baec7b8e6b54"], "tags": []}], "date": 1696450481, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "124": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1848694 - Remove/avoid global references to nsIIOService r=mccr8,necko-reviewers,kershaw, a=dmeehan\n\nThis patch removes the static pointer to nsIIOService in nsContentUtils,\nreplacing it to calls to mozilla::components::IO::Service.\n\nIt also makes nsScriptSecurityManager::sIOService a StaticRefPtr.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188714", "files": ["caps/nsScriptSecurityManager.cpp", "caps/nsScriptSecurityManager.h", "dom/base/Document.cpp", "dom/base/Element.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/nsObjectLoadingContent.cpp"], "git_node": null, "git_parents": [null], "node": "66aba039ef62b1d6785dcc5dc250c3f8f90052bf", "parents": ["8c9a876fd94a6dd31805c96f00b5752d93942c92"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190169", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6d78d5068d698a5d8ddf62b80dd1613f86290995", "parents": ["66aba039ef62b1d6785dcc5dc250c3f8f90052bf"], "tags": []}], "date": 1696514888, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "125": {"changesets": [{"author": "Marc Seibert \u003cmseibert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1836962 - Only trim URL if directionality doesn't change to RTL.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190160", "files": ["browser/components/urlbar/UrlbarInput.sys.mjs", "browser/components/urlbar/tests/browser/browser_UrlbarInput_formatValue.js"], "git_node": null, "git_parents": [null], "node": "0d55a6c304d087e9077ae33316b34afa3f705d59", "parents": ["6d78d5068d698a5d8ddf62b80dd1613f86290995"], "tags": []}], "date": 1696595053, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "126": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1855640. r=media-playback-reviewers,alwu, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189955", "files": ["dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp"], "git_node": null, "git_parents": [null], "node": "c1f56453791513fc0c561b4b2fa0cacce38c8a4d", "parents": ["0d55a6c304d087e9077ae33316b34afa3f705d59"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1852729 - Update weakRefMap when a WeakRef target is cleared r=jonco, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188150", "files": ["js/src/builtin/WeakRefObject.cpp", "js/src/gc/FinalizationObservers.cpp", "js/src/gc/FinalizationObservers.h", "js/src/jit-test/tests/gc/bug-1852729.js"], "git_node": null, "git_parents": [null], "node": "78594e7905e13ee0c342cef8aab6c35c913b65bd", "parents": ["c1f56453791513fc0c561b4b2fa0cacce38c8a4d"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190452", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/cookie-banner-rules-list.json"], "git_node": null, "git_parents": [null], "node": "112146c8c9bccd7967ff86fd42d9e5b59c636d9e", "parents": ["78594e7905e13ee0c342cef8aab6c35c913b65bd"], "tags": []}], "date": 1696863209, "git_changesets": [null, null, null], "user": "dmeehan@mozilla.com"}, "127": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1832153 - Stop valgrind thinking zero-capacity slots allocations are leaked r=jandem a=NPOTB\n\nFor objects with dynamic slots allocations, NativeObject::slots_ stores a\npointer that points just past the end of the slots header. For zero-capacity\nallocations this pointer points outside the allocation itself.\n\nCurrently this causes valgrind to think that the slots allocation is leaked. To\nfix this the patch adds an extra unused slot to zero capacity slots allocations\non valgrind builds only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190274", "files": ["js/src/vm/NativeObject.h"], "git_node": null, "git_parents": [null], "node": "4ede3f25b20d4eed66c705ce057c06851a4de4b6", "parents": ["112146c8c9bccd7967ff86fd42d9e5b59c636d9e"], "tags": []}], "date": 1696885158, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "128": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1835967: Remove TableAccessibleBase::Select/UnselectCol/Row. r=nlapre, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179513", "files": ["accessible/base/CachedTableAccessible.cpp", "accessible/base/CachedTableAccessible.h", "accessible/basetypes/TableAccessibleBase.h", "accessible/generic/ARIAGridAccessible.cpp", "accessible/generic/ARIAGridAccessible.h", "accessible/html/HTMLTableAccessible.cpp", "accessible/html/HTMLTableAccessible.h", "accessible/interfaces/nsIAccessibleTable.idl", "accessible/tests/mochitest/table.js", "accessible/tests/mochitest/table/test_sels_ariagrid.html", "accessible/tests/mochitest/table/test_sels_table.html", "accessible/tests/mochitest/table/test_sels_tree.xhtml", "accessible/windows/ia2/ia2AccessibleTable.cpp", "accessible/xpcom/xpcAccessibleTable.cpp", "accessible/xpcom/xpcAccessibleTable.h", "accessible/xul/XULListboxAccessible.cpp", "accessible/xul/XULListboxAccessible.h", "accessible/xul/XULTreeGridAccessible.cpp", "accessible/xul/XULTreeGridAccessible.h"], "git_node": null, "git_parents": [null], "node": "2a0e97470be5cdf1a461543aad4bb199ffe9744a", "parents": ["4ede3f25b20d4eed66c705ce057c06851a4de4b6"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1837105: Add methods for determining generic Accessibles and getting the nearest non-generic ancestor. r=nlapre, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179800", "files": ["accessible/base/AccGroupInfo.cpp", "accessible/basetypes/Accessible.h"], "git_node": null, "git_parents": [null], "node": "ac62e57ee20f4cdb47910c8913ca0f04e8766541", "parents": ["2a0e97470be5cdf1a461543aad4bb199ffe9744a"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1832261: Remove most of HTMLTable*Accessible. r=nlapre, a=dmeehan\n\nWe now use CachedTableAccessible for HTML tables, so much of the code in the HTMLTable*Accessible classes was unused.\nHowever, we still depend on these classes for some data needed to build the cached table.\n\n1. HTMLTableAccessible and HTMLTableCellAccessible no longer derive from TableAccessible and TableCellAccessible, respectively. Instead, callers which need specific access to HTML table data use the HTMLTable*Accessible class directly.\n2. All table specific methods have been removed except those that provide data required to build a CachedTableAccessible. The remaining methods are those for querying the row/column span (which depends on layout) and getting the caption (which depends on DOM).\n3. HTMLTable*Accessible are now used for all \u003ctable\u003e, \u003ctd\u003e, \u003cth\u003e and \u003ctr\u003e elements and MathML equivalents. ARIA*Accessible are never used for these elements. This improves consistency, simplifies the code and means that behavior specific to these HTML elements is handled in these classes, rather than in the ARIA classes as well.\n4. The table and row roles are now specified in HTMLMarkupMap and MathMLMarkupMap, rather than overriding NativeRole.  Cell roles are still handled in a NativeRole override; see the code comments for details.\n5. IsProbablyLayoutTable has been moved from TableAccessible to HTMLTableAccessible, as it is only relevant for HTML tables, not for ARIA tables.\n6. HTMLTableHeaderCellAccessible::NativeRole has been rewritten such that it no longer depends on querying table coordinates, as that would now require building a CachedTableAccessible, which would be very wasteful here. This replaces TableCellAccessible::HeaderCellRole, which has been removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179799", "files": ["accessible/base/CachedTableAccessible.cpp", "accessible/base/HTMLMarkupMap.h", "accessible/base/MathMLMarkupMap.h", "accessible/base/nsAccessibilityService.cpp", "accessible/basetypes/Accessible.h", "accessible/generic/ARIAGridAccessible.cpp", "accessible/generic/LocalAccessible.cpp", "accessible/generic/TableAccessible.cpp", "accessible/generic/TableAccessible.h", "accessible/generic/TableCellAccessible.cpp", "accessible/generic/TableCellAccessible.h", "accessible/html/HTMLTableAccessible.cpp", "accessible/html/HTMLTableAccessible.h", "accessible/tests/browser/mac/browser_table.js", "accessible/tests/mochitest/elm/test_shadowroot_subframe.html", "accessible/tests/mochitest/events/test_attrchange.html"], "git_node": null, "git_parents": [null], "node": "971b3bd86474a7fb5b9037f7476ebf2e8d853e28", "parents": ["ac62e57ee20f4cdb47910c8913ca0f04e8766541"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1832228 part 1: Remove ARIAGridAccessible, ARIARowAccessible and most of ARIAGridCellAccessible. r=nlapre, a=dmeehan\n\nWe now use CachedTableAccessible for ARIA tables and grids, so most of the code in the ARIA table classes was unused.\n\n1. Remove ARIAGridAccessible and ARIARowAccessible completely.\n2. ARIAGridCellAccessible no longer derives from TableCellAccessible.\n3. Remove most of ARIAGridCellAccessible.\n4. We still use ARIAGridCellAccessible to differentiate between valid and invalid cells. Valid cells create an ARIAGridCellAccessible and ARIAGridCellAccessible::IsTableCell() returns true due to mGenericTypes. Invalid cells don't get an ARIAGridCellAccessible, so IsTableCell() returns false on those.\n5. We also keep the code in ARIAGridCellAccessible to expose some states and attributes.\n6. The code for creating ARIAGridCellAccessible in CreateAccessible has been refactored, both for simplification and to fix bugs. display: contents tables now properly get the table and table cell interfaces; i.e. IsTable() and IsTableCell() return true when appropriate. Walking non-generic ancestors should fix ARIA tables with intervening generics, though this will be dealt with fully in a separate bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179801", "files": ["accessible/base/nsAccUtils.h", "accessible/base/nsAccessibilityService.cpp", "accessible/basetypes/Accessible.h", "accessible/generic/ARIAGridAccessible-inl.h", "accessible/generic/ARIAGridAccessible.cpp", "accessible/generic/ARIAGridAccessible.h", "accessible/generic/LocalAccessible.cpp", "accessible/tests/browser/e10s/browser_caching_table.js"], "git_node": null, "git_parents": [null], "node": "a90d43bc8dee9e8e6d2782e600c02f0edc78fde2", "parents": ["971b3bd86474a7fb5b9037f7476ebf2e8d853e28"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1832228 part 2: Remove TableAccessible and TableCellAccessible. r=nlapre, a=dmeehan\n\nThese classes are no longer used.\nThe remaining XUL subclasses now derive from Table*AccessibleBase.\nXULTreeGridAccessible depended on some methods in TableAccessible which are no longer used by anything else, so these have been moved into XULTreeGridAccessible itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179802", "files": ["accessible/generic/LocalAccessible.cpp", "accessible/generic/LocalAccessible.h", "accessible/generic/TableAccessible.cpp", "accessible/generic/TableAccessible.h", "accessible/generic/TableCellAccessible.cpp", "accessible/generic/TableCellAccessible.h", "accessible/generic/moz.build", "accessible/mac/mozAccessible.mm", "accessible/xul/XULListboxAccessible.h", "accessible/xul/XULTreeGridAccessible.cpp", "accessible/xul/XULTreeGridAccessible.h"], "git_node": null, "git_parents": [null], "node": "4a6325cc0d8ca3257d3e624a87b6c83f954f7320", "parents": ["a90d43bc8dee9e8e6d2782e600c02f0edc78fde2"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1832228 part 3: Rename TableAccessibleBase to TableAccessible and TableCellAccessibleBase to TableCellAccessible. r=nlapre, a=dmeehan\n\nNow that the local-only TableAccessible and TableCellAccessible have been removed, we no longer need this Base suffix for the unified classes.\nAside from renaming the header files, most of the rest of this was done with the following script:\n\n```\nfunction replace {\n  sed -i 's/'$1'/'$2'/g' `git grep -l $1`\n}\nreplace TableAccessibleBase TableAccessible\nreplace TableCellAccessibleBase TableCellAccessible\nreplace AsTableBase AsTable\nreplace AsTableCellBase AsTableCell\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179803", "files": ["accessible/atk/AccessibleWrap.cpp", "accessible/atk/AccessibleWrap.h", "accessible/atk/nsMaiInterfaceTable.cpp", "accessible/atk/nsMaiInterfaceTableCell.cpp", "accessible/base/AccGroupInfo.cpp", "accessible/base/CachedTableAccessible.cpp", "accessible/base/CachedTableAccessible.h", "accessible/base/nsAccessibilityService.cpp", "accessible/basetypes/Accessible.h", "accessible/basetypes/TableAccessible.h", "accessible/basetypes/TableAccessibleBase.h", "accessible/basetypes/TableCellAccessible.h", "accessible/basetypes/TableCellAccessibleBase.h", "accessible/basetypes/moz.build", "accessible/generic/ARIAGridAccessible.cpp", "accessible/generic/LocalAccessible.cpp", "accessible/generic/LocalAccessible.h", "accessible/html/HTMLTableAccessible.cpp", "accessible/ipc/RemoteAccessibleBase.cpp", "accessible/ipc/RemoteAccessibleBase.h", "accessible/mac/mozTableAccessible.mm", "accessible/windows/ia2/ia2AccessibleTable.cpp", "accessible/windows/ia2/ia2AccessibleTable.h", "accessible/windows/ia2/ia2AccessibleTableCell.cpp", "accessible/windows/ia2/ia2AccessibleTableCell.h", "accessible/xpcom/xpcAccessibleTable.cpp", "accessible/xpcom/xpcAccessibleTable.h", "accessible/xpcom/xpcAccessibleTableCell.cpp", "accessible/xpcom/xpcAccessibleTableCell.h", "accessible/xul/XULListboxAccessible.h", "accessible/xul/XULTreeGridAccessible.cpp", "accessible/xul/XULTreeGridAccessible.h"], "git_node": null, "git_parents": [null], "node": "912cbc9d975d1e1dddba6692b5a0c099b8f4c24a", "parents": ["4a6325cc0d8ca3257d3e624a87b6c83f954f7320"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838540: Don't recurse in ApplyARIAState on a grid cell if the cell is also a table. r=nlapre, a=dmeehan\n\nThis can only happen due to authoring error; \u003ctable role=gridcell outside of an ARIA grid isn't valid.\nNevertheless, we would previously recurse infinitely in this case in ApplyARIAState.\nPrevent this by not recursing if IsTable() is true.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181026", "files": ["accessible/generic/LocalAccessible.cpp", "accessible/tests/browser/e10s/browser_caching_table.js"], "git_node": null, "git_parents": [null], "node": "4275f7f8d4b53156627f36170bc2895cca7725b7", "parents": ["912cbc9d975d1e1dddba6692b5a0c099b8f4c24a"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1825611: Cache overflow r=Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D175193", "files": ["accessible/generic/LocalAccessible.cpp"], "git_node": null, "git_parents": [null], "node": "71f67b3d91f4b53615533f17ace8740cb83c148f", "parents": ["4275f7f8d4b53156627f36170bc2895cca7725b7"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1825611: Trim bounds when hittesting overflow:hidden containers r=Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D175194", "files": ["accessible/ipc/RemoteAccessibleBase.cpp", "accessible/ipc/RemoteAccessibleBase.h"], "git_node": null, "git_parents": [null], "node": "01086a4456555a388b097bd9d0372a6463d18431", "parents": ["71f67b3d91f4b53615533f17ace8740cb83c148f"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1825611: Ensure nodes with overflow:hidden styling always create an accessible r=Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D175195", "files": ["accessible/base/nsAccessibilityService.cpp"], "git_node": null, "git_parents": [null], "node": "fa87c3742028706acea994df3443666e5f790e66", "parents": ["01086a4456555a388b097bd9d0372a6463d18431"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1825611: Add test for overflow:hidden hittesting and acc creation r=Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D175196", "files": ["accessible/tests/browser/hittest/browser_test_general.js", "accessible/tests/browser/tree/browser.ini", "accessible/tests/browser/tree/browser_general.js"], "git_node": null, "git_parents": [null], "node": "5cd8992c2ae86b048a2ce893d8808f7ea49d2941", "parents": ["fa87c3742028706acea994df3443666e5f790e66"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1828373: Create accs for elements with overflow:scroll and overflow:auto styling r=nlapre,Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D176202", "files": ["accessible/base/nsAccessibilityService.cpp", "accessible/tests/browser/events/browser_test_panel.js", "accessible/tests/browser/tree/browser_general.js", "accessible/tests/mochitest/tree/test_table.html", "accessible/tests/mochitest/tree/test_table_2.html", "accessible/tests/mochitest/tree/test_table_3.html", "accessible/tests/mochitest/treeupdate/test_cssoverflow.html"], "git_node": null, "git_parents": [null], "node": "beb04a5c3f9a89066968c5f2ed0316f703588fc3", "parents": ["5cd8992c2ae86b048a2ce893d8808f7ea49d2941"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1832686: Fuzzy-match text leaves contained within generics when hittesting r=Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D178578", "files": ["accessible/ipc/RemoteAccessibleBase.cpp", "accessible/tests/browser/hittest/browser_test_general.js"], "git_node": null, "git_parents": [null], "node": "cc4fea6c414772c0dcf9ff7be53691308c932b04", "parents": ["beb04a5c3f9a89066968c5f2ed0316f703588fc3"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1837024: Only do fuzzy hittesting on descendants of clipped accs r=Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181166", "files": ["accessible/generic/LocalAccessible.cpp", "accessible/ipc/RemoteAccessibleBase.cpp", "accessible/ipc/RemoteAccessibleBase.h", "accessible/tests/browser/hittest/browser_test_general.js", "accessible/tests/browser/hittest/head.js"], "git_node": null, "git_parents": [null], "node": "4602d339a848d282b23d2799f87e9c05308bb698", "parents": ["cc4fea6c414772c0dcf9ff7be53691308c932b04"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840343: Track containers and text leaves separately when fuzzy hittesting r=Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D182269", "files": ["accessible/ipc/RemoteAccessibleBase.cpp", "accessible/tests/browser/hittest/browser_test_general.js"], "git_node": null, "git_parents": [null], "node": "a00dcad72e2a792714d7dede15022b042246265a", "parents": ["4602d339a848d282b23d2799f87e9c05308bb698"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@mozilla.com\u003e", "branch": "default", "desc": "Bug 1837030: Treat fuzzily-matched text leaves as valid in OffsetAtPoint r=Jamie,nlapre, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180515", "files": ["accessible/basetypes/HyperTextAccessibleBase.cpp", "accessible/tests/browser/hittest/browser_test_general.js"], "git_node": null, "git_parents": [null], "node": "cdfa33aff90385b4d933cc4257df3d5ceff9a0d8", "parents": ["a00dcad72e2a792714d7dede15022b042246265a"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838782: Add null checks in HyperTextAccessibleBase::OffsetAtPoint. r=morgan, a=dmeehan\n\n1. nsAccUtils::DocumentFor might return null if the Accessible is being moved and a client queried it during the move.\n2. ChildAtPoint might return null if the point can't be located at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D181213", "files": ["accessible/basetypes/HyperTextAccessibleBase.cpp"], "git_node": null, "git_parents": [null], "node": "d9a7db1ad09fef191451549bacc7a2ccf9f092ec", "parents": ["cdfa33aff90385b4d933cc4257df3d5ceff9a0d8"], "tags": []}], "date": 1696962391, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "129": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1856903 - Don't unnecessarily clear alternative frecency at every startup.  a=dmeehan\n\nA wrong null check causes us to run 2 queries that may be expensive (2s) on slow\ndisks, and that are supposed to run only after a certain urlbar experiment ran.\nThe fix just returns plain null instead of an empty object, allowing the null\ncheck to work as expected.\nThe fix was verified through the Profiler. While it would be possible to write\na very specific test for this case, it would not be particularly useful from\npreventing something similar to happen in the future.\nThough, this is clearly visible in Telemetry, thus we'll monitor that.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D190265\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190550", "files": ["toolkit/components/places/PlacesFrecencyRecalculator.sys.mjs"], "git_node": null, "git_parents": [null], "node": "6ca9bfcc2d0510f1c60f262e5c48117cb5054bf6", "parents": ["d9a7db1ad09fef191451549bacc7a2ccf9f092ec"], "tags": []}], "date": 1697056465, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "130": {"changesets": [{"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1851991: Do not try to raise the GPU process priority when it hasn't been initialized yet. r=jrmuizel, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188275", "files": ["widget/windows/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "e90e96cadfa27036fa3a94aecb73e340dd20b079", "parents": ["6ca9bfcc2d0510f1c60f262e5c48117cb5054bf6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1840160: Handle failed channels in ContinueVerification() r=necko-reviewers,valentin, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188993", "files": ["netwerk/protocol/http/HttpChannelParent.cpp"], "git_node": null, "git_parents": [null], "node": "8243b46f4c1850e1f979657c8f86fe483bef7520", "parents": ["e90e96cadfa27036fa3a94aecb73e340dd20b079"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1856637 - Ignore gfxDWriteFont::UpdateSystemTextVars() call if the gfxVars are not yet initialized. r=gfx-reviewers,lsalzman, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190151", "files": ["gfx/config/gfxVars.h", "gfx/thebes/gfxDWriteFonts.cpp"], "git_node": null, "git_parents": [null], "node": "027b6d175c6d63bae87724c1f2b285331e60fe43", "parents": ["8243b46f4c1850e1f979657c8f86fe483bef7520"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1852596 r=gfx-reviewers,aosmond, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189243", "files": ["gfx/thebes/gfxPlatformFontList.cpp", "gfx/thebes/gfxPlatformFontList.h"], "git_node": null, "git_parents": [null], "node": "006cc93fc76b8507cdc50eb28ccee0bb27ada527", "parents": ["027b6d175c6d63bae87724c1f2b285331e60fe43"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1853201 - replace NewRunnableMethod with NS_NewRunnableFunction. r=media-playback-reviewers,karlt, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190241", "files": ["dom/media/mediasource/MediaSourceDemuxer.cpp", "dom/media/mediasource/MediaSourceDemuxer.h"], "git_node": null, "git_parents": [null], "node": "5e0ca64ad8f0f6d15839e54f5762b165dd600aad", "parents": ["006cc93fc76b8507cdc50eb28ccee0bb27ada527"], "tags": []}, {"author": "Ray Kraesig \u003crkraesig@mozilla.com\u003e", "branch": "default", "desc": "Bug 1842170 - attempt to avoid nested event loops at inconvenient times r=win-reviewers,mhowell, a=dmeehan\n\nIf we enter `SpinEventLoopUntil` while certain Windows events are\nwaiting for resolution, we may enter an unusable state.\n\nSince removing all `SpinEventLoopUntil` instances -- or even the one\ncausing this problem -- isn't really an option at present, kick the can\ndown the road by kicking the can down the road [sic].\n\nDifferential Revision: https://phabricator.services.mozilla.com/D185969", "files": ["widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "eab61ad5e595d81b3fecd900886e65230b23a832", "parents": ["5e0ca64ad8f0f6d15839e54f5762b165dd600aad"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190776", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "8e627c4b60a28efaadb786038867771827a14a22", "parents": ["eab61ad5e595d81b3fecd900886e65230b23a832"], "tags": []}], "date": 1697120226, "git_changesets": [null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "131": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1838113 - Don't build the unused myopen function. r=masayuki, a=dmeehan\n\nClang-trunk changed libc++ in a way that breaks fstream support in WASI,\nwhich prevents building the myopen function in csutil.cxx, but the\nfunction is actually unused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D180759", "files": ["extensions/spellcheck/hunspell/patches/bug1838113.patch", "extensions/spellcheck/hunspell/src/csutil.cxx", "extensions/spellcheck/hunspell/update.sh"], "git_node": null, "git_parents": [null], "node": "21b307a88a490d1ecef22269f7e34d2cd60d1dc7", "parents": ["8e627c4b60a28efaadb786038867771827a14a22"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 1850815 - Make cs_border_solid's vColorLine highp. r=gfx-reviewers,bradwerth, a=dmeehan\n\nThis varying's precision being reduced to mediump in bug bug 1823411\nis causing rendering glitches on certain Mali devices. It should never\nhave been reduced in the first place, as calculations regarding\npositions may require the extra precision. This patch therefore\nreverts it to highp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188984", "files": ["gfx/wr/webrender/res/cs_border_solid.glsl"], "git_node": null, "git_parents": [null], "node": "c6a32b928430267f4d8b017d9b661ef53260b40b", "parents": ["21b307a88a490d1ecef22269f7e34d2cd60d1dc7"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1845486 - fix edge case in testinfo-all where new manifests have no data. r=gbrown, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D184649", "files": ["testing/testinfo.py"], "git_node": null, "git_parents": [null], "node": "9fb9141595669c291e144dac194dafe9ba6d0139", "parents": ["c6a32b928430267f4d8b017d9b661ef53260b40b"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1856113 - add more protections around test-info-all calls to runcount. r=aryx, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190112", "files": ["testing/mach_commands.py", "testing/testinfo.py"], "git_node": null, "git_parents": [null], "node": "5ef51853e763bec52046d086425d15c4da298be2", "parents": ["9fb9141595669c291e144dac194dafe9ba6d0139"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1857233 - Fix null pointer crash [@ GetColumnHeaderCellsCB ]. r=Jamie, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D190278", "files": ["accessible/atk/nsMaiInterfaceTableCell.cpp"], "git_node": null, "git_parents": [null], "node": "1a647602f668968845084f99b43ccc7a40e8e892", "parents": ["5ef51853e763bec52046d086425d15c4da298be2"], "tags": []}], "date": 1697129683, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "132": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1851847 - Check that we really do have a document before creating a MIDI port r=padenot, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187989", "files": ["dom/midi/MIDIPort.cpp"], "git_node": null, "git_parents": [null], "node": "c4ed9a9b16650b212f189a23bca7bfb6c5c6d8f1", "parents": ["1a647602f668968845084f99b43ccc7a40e8e892"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1851829 - Do not send close messages for MIDI ports that have already been disconnected from their remote object r=padenot, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189361", "files": ["dom/midi/MIDIPort.cpp", "dom/midi/crashtests/1851829.html", "dom/midi/crashtests/crashtests.list", "testing/crashtest/crashtests.list"], "git_node": null, "git_parents": [null], "node": "e9b6f035374a797e0409b346940956f8007f4544", "parents": ["c4ed9a9b16650b212f189a23bca7bfb6c5c6d8f1"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1856695 - Improve how we handle MIDI port creation r=padenot, a=dmeehan\n\nDifferential Revisi