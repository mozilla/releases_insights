"pushes": {"104": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 17bedcda2f5c28b7fbc136d300bdbbf04f382e00 with FIREFOX_115_3_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "712782362bf8b62237a27191371cc99303f67ca3", "parents": ["17bedcda2f5c28b7fbc136d300bdbbf04f382e00"], "tags": []}], "date": 1695062787, "git_changesets": [null], "user": "ffxbld"}, "105": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_115_2_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_115_2_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "fc073cab033f09b0ed22b4a0f5f55b20561f6f2d", "parents": ["2e61ec742c2039eaacac6c4d99c919db51a34b68"], "tags": []}], "date": 1695579355, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "106": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "94b752ef924376ef8ec70b930aff108cdbcd59b9", "parents": ["712782362bf8b62237a27191371cc99303f67ca3"], "tags": []}], "date": 1695652981, "git_changesets": [null], "user": "ffxbld-merge"}, "107": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189108", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "9d119704ac2c01fa62a05fcc16016b764a72bb92", "parents": ["94b752ef924376ef8ec70b930aff108cdbcd59b9"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1853973 - only collect testrun info for test-info-all job when on mozilla-central or try. r=aryx, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188666", "files": ["testing/testinfo.py"], "git_node": null, "git_parents": [null], "node": "42ebfdb93a482a8f98d3eb9823cc84dd47944848", "parents": ["9d119704ac2c01fa62a05fcc16016b764a72bb92"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1851854 - Use SetPrefableContextOptions for worklet JS ContextOptions. r=mccr8, a=RyanVM\n\n`SetPrefableContextOptions` currently has to be called on the main thread, so store\nthe options in `StartModuleLoadRunnable` and copy them on the worklet thread.\n\nThis doesn't update the options when the prefs are changed, but we've been moving\nto read-on-startup for prefs so we probably don't need that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187767", "files": ["dom/worklet/WorkletFetchHandler.cpp", "dom/worklet/WorkletThread.cpp", "dom/worklet/WorkletThread.h"], "git_node": null, "git_parents": [null], "node": "d4f4da42ab449b6b9b595a8ec00d6561ed070472", "parents": ["42ebfdb93a482a8f98d3eb9823cc84dd47944848"], "tags": []}], "date": 1695654883, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "108": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1847180.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D188240\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188568", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/test/gtest/TestExecutableLists.cpp", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": null, "git_parents": [null], "node": "d9bdfa2e830585bdbd6ebcaebe5d86eb787ff278", "parents": ["d4f4da42ab449b6b9b595a8ec00d6561ed070472"], "tags": []}], "date": 1695655192, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "109": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 17bedcda2f5c28b7fbc136d300bdbbf04f382e00 with FIREFOX_115_3_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "d1ecb14e40dbe01346584c80491d75d9d4841bc1", "parents": ["d9bdfa2e830585bdbd6ebcaebe5d86eb787ff278"], "tags": []}], "date": 1695732804, "git_changesets": [null], "user": "ffxbld"}, "110": {"changesets": [{"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1855086 - Switch cron-bouncer-check away from esr102 r=releng-reviewers,jcristau a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189179", "files": ["taskcluster/ci/cron-bouncer-check/kind.yml"], "git_node": null, "git_parents": [null], "node": "6bf4b5765aabf8468a5469ad46779b3263f89304", "parents": ["d1ecb14e40dbe01346584c80491d75d9d4841bc1"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1855268 - Run cron-bouncer-check on esr115 r=releng-reviewers,jcristau a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189257", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "fce0900f8117fa04467e5693617ef61720a8f803", "parents": ["6bf4b5765aabf8468a5469ad46779b3263f89304"], "tags": []}], "date": 1695801911, "git_changesets": [null, null], "user": "jcristau@mozilla.com"}, "111": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_3_X_RELBRANCH", "desc": "set version to 115.3.1 a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "1a95b4252f3eb4d15e09aec52e631624bf06f927", "parents": ["17bedcda2f5c28b7fbc136d300bdbbf04f382e00"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_115_3_X_RELBRANCH", "desc": "Bug 1855550 - VP8: disallow thread count changes. r=jesup, a=dsmith\n\nCherry-pick of upstream libvpx commits:\nhttps://chromium.googlesource.com/webm/libvpx/+/af6dedd715f4307669366944cca6e0417b290282\nhttps://chromium.googlesource.com/webm/libvpx/+/3fbd1dca6a4d2dad332a2110d646e4ffef36d590\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189428", "files": ["media/libvpx/libvpx/test/encode_api_test.cc", "media/libvpx/libvpx/vp8/encoder/onyx_if.c"], "git_node": null, "git_parents": [null], "node": "749617c4473c65f8aebb2e3254777ae99dc17cce", "parents": ["1a95b4252f3eb4d15e09aec52e631624bf06f927"], "tags": ["FIREFOX_115_3_1esr_BUILD1", "FIREFOX_115_3_1esr_RELEASE"]}], "date": 1695858555, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "112": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1855550 - VP8: disallow thread count changes. r=jesup, a=dsmith\n\nCherry-pick of upstream libvpx commits:\nhttps://chromium.googlesource.com/webm/libvpx/+/af6dedd715f4307669366944cca6e0417b290282\nhttps://chromium.googlesource.com/webm/libvpx/+/3fbd1dca6a4d2dad332a2110d646e4ffef36d590\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189428", "files": ["media/libvpx/libvpx/test/encode_api_test.cc", "media/libvpx/libvpx/vp8/encoder/onyx_if.c"], "git_node": null, "git_parents": [null], "node": "5241232a3292943bd59ff1704eab60fee3cbc9d1", "parents": ["fce0900f8117fa04467e5693617ef61720a8f803"], "tags": []}], "date": 1695860302, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "113": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 749617c4473c65f8aebb2e3254777ae99dc17cce with FIREFOX_115_3_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "085c98201f6749e325265b5a0e81300bc121f4a6", "parents": ["5241232a3292943bd59ff1704eab60fee3cbc9d1"], "tags": []}], "date": 1695871586, "git_changesets": [null], "user": "ffxbld"}, "114": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 749617c4473c65f8aebb2e3254777ae99dc17cce with FIREFOX_115_3_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "d9b6f7d477ace5b9dec7a0897c2b644085a77c99", "parents": ["085c98201f6749e325265b5a0e81300bc121f4a6"], "tags": []}], "date": 1695906009, "git_changesets": [null], "user": "ffxbld"}, "115": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1854002 - avoid unnecessary CoLockObjectExternal() calls  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D188863\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189231", "files": ["widget/windows/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "b7f369b35a4e5cf8d1a9d9feb641ea54cc715904", "parents": ["d9b6f7d477ace5b9dec7a0897c2b644085a77c99"], "tags": []}], "date": 1695925118, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "116": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1855846 - Adjust zlib fetch url. r+a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189598", "files": ["taskcluster/ci/fetch/toolchains.yml"], "git_node": null, "git_parents": [null], "node": "beb3a60525f9148c628456db67cb30d24c3b794a", "parents": ["b7f369b35a4e5cf8d1a9d9feb641ea54cc715904"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1848833: Clean up mRedirectedCacheKeys r=valentin,necko-reviewers, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188744", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": null, "git_parents": [null], "node": "6ed5e994ed5e8f0d0324b6e80ea2ec528b1f8d5c", "parents": ["beb3a60525f9148c628456db67cb30d24c3b794a"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1855195 - fix test-info-all job to have default value of runcount to work on non trunk branches. r=aryx, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189417", "files": ["testing/testinfo.py"], "git_node": null, "git_parents": [null], "node": "ae6bca895672d71465673ad0d0f56f01dc326c50", "parents": ["6ed5e994ed5e8f0d0324b6e80ea2ec528b1f8d5c"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1853252 - Allow running `mach bootstrap` from more subdirs. r=ahochheiden, a=NPOTB\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188302", "files": ["python/mozboot/mozboot/bootstrap.py", "python/mozversioncontrol/mozversioncontrol/__init__.py"], "git_node": null, "git_parents": [null], "node": "aff3fc247bd8e733d723d17340ae1aeb418f45e2", "parents": ["ae6bca895672d71465673ad0d0f56f01dc326c50"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 1854019 - Add procps to custom-v8 and custom-car linux builds. r=perftest-reviewers,sparky a=NPOTB\n\nDue to some changes upstream in depot_tools, pgrep is now a required cli\ntool. In particular, we fail during the fetching of the source code due\nto a pgrep check if the compiler proxy is running.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188827", "files": ["taskcluster/docker/custom-car-linux/Dockerfile", "taskcluster/docker/custom-v8/Dockerfile"], "git_node": null, "git_parents": [null], "node": "a30d6b7bc80fcf1849ce34e0816550534aa0e2fe", "parents": ["aff3fc247bd8e733d723d17340ae1aeb418f45e2"], "tags": []}], "date": 1695942133, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "117": {"changesets": [{"author": "Karandeep \u003cklubana@mozilla.com\u003e", "branch": "default", "desc": "Bug 1852972 - Add Bing to more locales. r=Standard8, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188268", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_bing.js"], "git_node": null, "git_parents": [null], "node": "d66ff43c0e3ae822db599ab7ed142fcb73779072", "parents": ["a30d6b7bc80fcf1849ce34e0816550534aa0e2fe"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189480", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "01a38986e94ba09ca1fee826893a308500800e7a", "parents": ["d66ff43c0e3ae822db599ab7ed142fcb73779072"], "tags": []}], "date": 1695947947, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "118": {"changesets": [{"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1848471 - about:certificate: remove linkification of URLs in certificate data r=sgalich, a=dsmith\n\nBug 1573133 added code to turn fields in certificate data that look like URLs\ninto links in the new certificate viewer (about:certificate). Since most of\nthese links are to things like OCSP responder URLs, this is of dubious utility,\nhence this patch to remove the feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186743", "files": ["toolkit/components/certviewer/content/components/info-item.mjs", "toolkit/components/certviewer/tests/browser/browser.ini", "toolkit/components/certviewer/tests/browser/browser_clickableLink.js"], "git_node": null, "git_parents": [null], "node": "e9da2d7f45a4c32d6a13c1c1a79841de83834de9", "parents": ["01a38986e94ba09ca1fee826893a308500800e7a"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1845739 - windows.create consistent with tabs.create r=zombie, a=dsmith\n\nThis also fixes bug 1835484\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186130", "files": ["browser/components/extensions/parent/ext-windows.js"], "git_node": null, "git_parents": [null], "node": "a1167276b906d76a2ea30cd0f9c80660399f0f8d", "parents": ["e9da2d7f45a4c32d6a13c1c1a79841de83834de9"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1845739 - About test case in browser_ext_windows_create_url.js r=zombie, a=dsmith\n\nThis also refactors the test to improve its reliability and clarity.\nPreviously, the \"fail\" test cases ran after the test signaled completion\nof the test, which means that it wasn't reliable at detecting expected\nfailures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D186131", "files": ["browser/components/extensions/test/browser/browser_ext_windows_create_url.js"], "git_node": null, "git_parents": [null], "node": "16ab4d61519a55b287eebc76c14131679f0198c8", "parents": ["a1167276b906d76a2ea30cd0f9c80660399f0f8d"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1852841 - Protect patched_NtMapViewOfSection against SharedSection::ConvertToReadOnly. r=gstoll, a=dsmith\n\nThird-party products can start threads in our main process, which can load DLLs before the main thread has gone past SharedSection::ConvertToReadOnly. This patch therefore protects the use of the shared section within patched_NtMapViewOfSection, to guarantee that there is no race condition where the shared section could get converted while being used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D187913", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/SharedSection.cpp", "browser/app/winlauncher/freestanding/SharedSection.h"], "git_node": null, "git_parents": [null], "node": "ace59fc2be9a9ece43ff2445d4baf13fbd5dd5e9", "parents": ["16ab4d61519a55b287eebc76c14131679f0198c8"], "tags": []}], "date": 1695998506, "git_changesets": [null, null, null, null], "user": "dsmith@mozilla.com"}, "119": {"changesets": [{"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1849433 - Add webgl.max-vert-ids-per-draw, default 30M. r=gfx-reviewers,gw a=RyanVM", "files": ["dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextDraw.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "44c386281c90fcc0d6c134435eee932467ae6b08", "parents": ["ace59fc2be9a9ece43ff2445d4baf13fbd5dd5e9"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1844651 - Gracefully handle GMP service shutdown barrier related initialization failures. r=media-playback-reviewers,alwu a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188600", "files": ["dom/ipc/ContentParent.cpp", "dom/media/gmp/GMPContentParent.cpp", "dom/media/gmp/GMPCrashHelperHolder.cpp", "dom/media/gmp/GMPService.cpp", "dom/media/gmp/GMPServiceChild.cpp", "dom/media/gmp/GMPServiceParent.cpp", "toolkit/components/glean/ipc/FOGIPC.cpp"], "git_node": null, "git_parents": [null], "node": "3fa0ea022486a4969371d4f495d13288a741eae9", "parents": ["44c386281c90fcc0d6c134435eee932467ae6b08"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1846205 - Use key state change to send activate/deactivate event when a modal window is opened; r=spohl,mac-reviewers, a=RyanVM", "files": ["widget/cocoa/nsWindowMap.mm"], "git_node": null, "git_parents": [null], "node": "6961bd61cb51e835a47aae2d6adabf39d3880279", "parents": ["3fa0ea022486a4969371d4f495d13288a741eae9"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 1799326 - Don't restore replaced browsing contexts from BFCache. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D188688", "files": ["docshell/shistory/nsSHistory.cpp"], "git_node": null, "git_parents": [null], "node": "5e0affad68dc0d1307fa5f2c41e4cc0a89ac3800", "parents": ["6961bd61cb51e835a47aae2d6adabf39d3880279"], "tags": []}], "date": 1696031322, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "120": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D189816", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "gi