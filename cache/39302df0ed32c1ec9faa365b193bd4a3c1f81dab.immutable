n: https://phabricator.services.mozilla.com/D326383\n", "files": ["gfx/wr/swgl/src/rasterize.h"], "git_node": "1bbe24c9a99f9f1843b814c5afd553fed06c58e1", "git_parents": ["a8d6683a5c9c547c3650cc5eb4d3ca86c3ca71d8"], "node": "dd5edd097600a2f79d37efa24ea853d0b360f8e8", "parents": ["851b3c8cf765759c4d2796e59b7cfe0be80d3ed3"], "tags": []}], "date": 1789718256, "git_changesets": ["1bbe24c9a99f9f1843b814c5afd553fed06c58e1"], "user": "pchevrel@mozilla.com"}, "1578": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068422 - Fix fullscreen subdocument handling;  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325085\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326416\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h"], "git_node": "f77151837fbeceacd7431a62334415d98dd1af95", "git_parents": ["1bbe24c9a99f9f1843b814c5afd553fed06c58e1"], "node": "21d8e8ce78da1f9c27448341a0e49a3057d1bc2a", "parents": ["dd5edd097600a2f79d37efa24ea853d0b360f8e8"], "tags": []}], "date": 1789718288, "git_changesets": ["f77151837fbeceacd7431a62334415d98dd1af95"], "user": "pchevrel@mozilla.com"}, "1579": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068346 - Unwrap a copy in GetJSValFromKeyPathString.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326021\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326475\n", "files": ["dom/indexedDB/KeyPath.cpp"], "git_node": "282674ef4d7124d0a0e16f51502734ac73139a1a", "git_parents": ["f77151837fbeceacd7431a62334415d98dd1af95"], "node": "4a150c22887f8df538731180ee0f089e7eda46e5", "parents": ["21d8e8ce78da1f9c27448341a0e49a3057d1bc2a"], "tags": []}], "date": 1789718352, "git_changesets": ["282674ef4d7124d0a0e16f51502734ac73139a1a"], "user": "pchevrel@mozilla.com"}, "1580": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2047721 - Clear VP9 frame-thread state on flush  a=pascalc DONTBUILD\n\nCherry-pick of FFmpeg commit a024f8c5413d (avcodec/vp9: unref next_refs in\nvp9_decode_flush). vp9_decode_flush() releases s-\u003es.refs[] but not\ns-\u003enext_refs[], and vp9_decode_update_thread_context() seeds a worker's\nrefs[] from the source worker's next_refs[], so references from before a\nflush could survive it. Unref next_refs[] alongside refs[].\n\nThe commit is not in the FFmpeg 9.0 release branch, so it is carried as\nvp9-flush-unref-next-refs.patch and listed in README_MOZILLA to be\nre-applied on the next ffvpx update.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310961\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326603\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/libavcodec/vp9.c", "media/ffvpx/vp9-flush-unref-next-refs.patch"], "git_node": "dabf343d851be20101c1fc1453f277c82be8c038", "git_parents": ["282674ef4d7124d0a0e16f51502734ac73139a1a"], "node": "a91cb7588e0bd1867a67ddd8f18babde31c2cf7d", "parents": ["4a150c22887f8df538731180ee0f089e7eda46e5"], "tags": []}], "date": 1789718398, "git_changesets": ["dabf343d851be20101c1fc1453f277c82be8c038"], "user": "pchevrel@mozilla.com"}, "1581": {"changesets": [{"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 2057988 - Reject a duplicate conduit id.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325089\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326714\n", "files": ["toolkit/components/extensions/ConduitsParent.sys.mjs", "toolkit/components/extensions/test/mochitest/test_ext_subframes_privileges.html"], "git_node": "9d18c4a479de7c4ca1f5175fe2148f7f3f5fc9ed", "git_parents": ["dabf343d851be20101c1fc1453f277c82be8c038"], "node": "66b2b995356da5e68b06517ae845b97c208c6ae4", "parents": ["a91cb7588e0bd1867a67ddd8f18babde31c2cf7d"], "tags": []}], "date": 1789718442, "git_changesets": ["9d18c4a479de7c4ca1f5175fe2148f7f3f5fc9ed"], "user": "pchevrel@mozilla.com"}, "1582": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2049352 - Clear mCallback before invoking Done() in the file, color, and application pickers.  a=pascalc DONTBUILD\n\nSeveral picker and chooser handlers invoke mCallback and null the member\nafterwards. Move the callback into a local before invoking it, and return\nearly when it is already null, so each handler runs at most once.\n\nHandlers updated:\n  * widget/nsFilePickerProxy.cpp (Recv__delete__, ActorDestroy)\n  * widget/gtk/nsFilePicker.cpp (DoneNonPortal, DonePortal, DoneCommon)\n  * widget/gtk/nsColorPicker.cpp (Done)\n  * widget/gtk/nsApplicationChooser.cpp (Done)\n  * widget/cocoa/nsColorPicker.mm (Done)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309753\n\n(cherry picked from commit 9218e63542cccf76054284d84f95c07f1b0b4332)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326720\n", "files": ["widget/cocoa/nsColorPicker.mm", "widget/gtk/nsApplicationChooser.cpp", "widget/gtk/nsColorPicker.cpp", "widget/gtk/nsFilePicker.cpp", "widget/nsFilePickerProxy.cpp"], "git_node": "ab7e54ca0c237e0c20006da1c278075dd1ee5e59", "git_parents": ["9d18c4a479de7c4ca1f5175fe2148f7f3f5fc9ed"], "node": "599a7e57228c168b34e0f53db0a0a2e92ff68ca2", "parents": ["66b2b995356da5e68b06517ae845b97c208c6ae4"], "tags": []}], "date": 1789718517, "git_changesets": ["ab7e54ca0c237e0c20006da1c278075dd1ee5e59"], "user": "pchevrel@mozilla.com"}, "1583": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2071067 - patch for esr115  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326801\n", "files": ["gfx/layers/composite/TextureHost.cpp"], "git_node": "5f75183ab7f154e9fc7f896fdadf6a0d078631a5", "git_parents": ["ab7e54ca0c237e0c20006da1c278075dd1ee5e59"], "node": "5ca3b643c47fb46ebd6e799a583f72060eddb062", "parents": ["599a7e57228c168b34e0f53db0a0a2e92ff68ca2"], "tags": []}], "date": 1789718553, "git_changesets": ["5f75183ab7f154e9fc7f896fdadf6a0d078631a5"], "user": "pchevrel@mozilla.com"}, "1584": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071064 - Check if radio group is null instead of creating it when removing from radio group. r=smaug a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327134\n", "files": ["dom/base/RadioGroupManager.cpp"], "git_node": "b37102597fa88146b16d8a9cbc2ac6c6151a3045", "git_parents": ["5f75183ab7f154e9fc7f896fdadf6a0d078631a5"], "node": "98d91c6d3995981095032f37368166ded8b7b226", "parents": ["5ca3b643c47fb46ebd6e799a583f72060eddb062"], "tags": []}], "date": 1789718663, "git_changesets": ["b37102597fa88146b16d8a9cbc2ac6c6151a3045"], "user": "pchevrel@mozilla.com"}, "1585": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070264 - Guard mFontFace//mFontFace5 members with the font-entry lock.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326447\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326904\n", "files": ["gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFontEntry.h"], "git_node": "aee4702e5e6bd2f80e98dcff1210073f6de3fd47", "git_parents": ["b37102597fa88146b16d8a9cbc2ac6c6151a3045"], "node": "712abf6cf59110880b0c3d712942216b5b9f42c3", "parents": ["98d91c6d3995981095032f37368166ded8b7b226"], "tags": []}], "date": 1789802625, "git_changesets": ["aee4702e5e6bd2f80e98dcff1210073f6de3fd47"], "user": "pchevrel@mozilla.com"}, "1586": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068406 - Validate the display directory for file picker;  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D325830\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326938\n", "files": ["dom/ipc/FilePickerParent.cpp", "widget/gtk/nsFilePicker.cpp", "widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h"], "git_node": "4fd2d983e77213df374991aa59518acde031d963", "git_parents": ["aee4702e5e6bd2f80e98dcff1210073f6de3fd47"], "node": "b9d6da2586baa695a2faa50c7c7b3f825a80499e", "parents": ["712abf6cf59110880b0c3d712942216b5b9f42c3"], "tags": []}], "date": 1789802666, "git_changesets": ["4fd2d983e77213df374991aa59518acde031d963"], "user": "pchevrel@mozilla.com"}, "1587": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327746\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/top-sites.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "16fde367a87db53badedcd1c70b47877a439b7db", "git_parents": ["4fd2d983e77213df374991aa59518acde031d963"], "node": "8d57375f401211139a671c38e5442bf7de632adf", "parents": ["b9d6da2586baa695a2faa50c7c7b3f825a80499e"], "tags": []}], "date": 1789978254, "git_changesets": ["16fde367a87db53badedcd1c70b47877a439b7db"], "user": "pchevrel@mozilla.com"}, "1588": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Make BrowserParent::mBrowserHost a strong reference.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324465\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327123\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "633d9099cb4fb12405c2e5cdaf6a3e692a8c0656", "git_parents": ["16fde367a87db53badedcd1c70b47877a439b7db"], "node": "1312b3591f26978c9c0cd599071fad708c719c00", "parents": ["8d57375f401211139a671c38e5442bf7de632adf"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Make BrowserParent::mBrowserBridgeParent a WeakPtr.  a=pascalc DONTBUILD\n\nEvery user of the field runs on the parent process main thread, which\nWeakPtr's debug-only owning-thread assertions now enforce.\nBrowserBridgeParent::Destroy() still clears it explicitly, so the pointer\nis dropped when the actor is destroyed rather than when the\nBrowserBridgeParent is freed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324466\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327124\n", "files": ["dom/ipc/BrowserBridgeParent.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "693f31eb8546c2bfe0a3b41770324131a07e1b81", "git_parents": ["633d9099cb4fb12405c2e5cdaf6a3e692a8c0656"], "node": "9e0e0ca3d57b075cff0cc187b885dbf7bb556281", "parents": ["1312b3591f26978c9c0cd599071fad708c719c00"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Don't let a content process name an already-embedded tab as the new tab in CreateWindow.  a=pascalc DONTBUILD\n\nIn TryRemoteBrowserInternal, don't create a new BrowserHost is we're going to\nfail immediately anyways. This could result in failing to clean up properly.\n\nFor the two BrowserParent set methods, check in release builds that we are\neither clearing the field or the BrowserParent is not already in use.\n\nIn ContentParent::RecvCreateWindow, make sure that the child is handing us a\nfresh BrowserParent, or we can get into a weird state because things aren't\ncleaned up properly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324467\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327125\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/ContentParent.cpp"], "git_node": "54c26deb5394df1576e57840026f2162def4736e", "git_parents": ["693f31eb8546c2bfe0a3b41770324131a07e1b81"], "node": "7bdc06b2a4ca32a5f7adb9de2bfd46fd925aa5ed", "parents": ["9e0e0ca3d57b075cff0cc187b885dbf7bb556281"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Wait to set BrowserParent::mBrowserBridgeParent.  a=pascalc DONTBUILD\n\nDon't set BrowserParent::mBrowserBridgeParent until we've set the strong half of\nthe cycle, BrowserBridgeParent::mBrowserParent, in case we hit any failure states.\n\nBrowserParent::mBrowserBridgeParent is now only set alongside the strong\nBrowserBridgeParent::mBrowserParent reference, and the two are cleared together,\nso Destroy() can only ever be clearing its own back pointer. Assert that, so\nthis doesn't silently regress into clobbering another bridge's pointer.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324468\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327126\n", "files": ["dom/ipc/BrowserBridgeParent.cpp"], "git_node": "94ca0a3389649a38ba19199ae6802576053c49f6", "git_parents": ["54c26deb5394df1576e57840026f2162def4736e"], "node": "8eeb953110c58f07c5dbd1a2ebaf9fbd452edc86", "parents": ["7bdc06b2a4ca32a5f7adb9de2bfd46fd925aa5ed"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2068322 - Don't embed a discarded BrowsingContext from RecvCreateWindow.  a=pascalc DONTBUILD\n\nThis is like a semi-related cleanup found while working on the other patches.\n\nThe existing BrowsingContext validation checks the shape of the new tab's\nBrowsingContext but not whether it is still live, so a discarded one would be\nadopted as the new frameloader's pending BrowsingContext by CreateBrowsingContext\nin nsFrameLoader.cpp and then embedded.\n\nUnlike the other checks here this isn't necessarily the child's fault, so fail\nthe window open the way we already do for a missing parent rather than killing\nthe child.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324469\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327127\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "10779aa02abe5b5102eeee8a11fbbc08fc46cbe2", "git_parents": ["94ca0a3389649a38ba19199ae6802576053c49f6"], "node": "71d8ddc374508356165dea48edce95920f7bf66b", "parents": ["8eeb953110c58f07c5dbd1a2ebaf9fbd452edc86"], "tags": []}], "date": 1789982036, "git_changesets": ["633d9099cb4fb12405c2e5cdaf6a3e692a8c0656", "693f31eb8546c2bfe0a3b41770324131a07e1b81", "54c26deb5394df1576e57840026f2162def4736e", "94ca0a3389649a38ba19199ae6802576053c49f6", "10779aa02abe5b5102eeee8a11fbbc08fc46cbe2"], "user": "pchevrel@mozilla.com"}, "1589": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Use weak references in sLayerToBrowserParentTable and unregister in ~BrowserParent.  a=pascalc DONTBUILD\n\nUsing weak references in sLayerToBrowserParentTable ensures that we never end\nup with dangling pointers. Clean up the table in ~BrowserParent() in case we\nskipped ActorDestroy.\n\nGetBrowserParentFromLayersId now returns an already_AddRefed because we were\nholding onto a strong reference anyways, and it is probably better anyways to\nhold strong stack references in the callers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327054\n", "files": ["dom/events/EventStateManager.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "gfx/layers/apz/util/APZCCallbackHelper.cpp"], "git_node": "8b72a9bc27c3d67a49ae94e3d040bdbd4f153430", "git_parents": ["10779aa02abe5b5102eeee8a11fbbc08fc46cbe2"], "node": "aa47d9bb08c59dec7df6e6018765bbcb9ac173e3", "parents": ["71d8ddc374508356165dea48edce95920f7bf66b"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Reject child-initiated deletion.  a=pascalc DONTBUILD\n\nThe child should only send us the delete message after we've sent it the\nDestroy message, so if that's not the case, something has gone wrong, so\nlet's kill the child process to prevent further hijinks.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323316\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327055\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "1ffeb9416b9d71d1a225e4b01b4d12268d931b79", "git_parents": ["8b72a9bc27c3d67a49ae94e3d040bdbd4f153430"], "node": "1bcfa6ef8aabebd8f8289eab3ef0eb2d89f61ec9", "parents": ["aa47d9bb08c59dec7df6e6018765bbcb9ac173e3"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Don't initialize rendering for an already-destroyed BrowserParent.  a=pascalc DONTBUILD\n\nIf we can't send in nsFrameLoader::TryRemoteBrowserInternal() or\nBrowserParent::InitRendering(), then we've already started the process of\ndestroying the BrowserParent, so don't set up this rendering stuff that we may\nhave already tried to clean up.\n\nNote that mIsDestroyed is not usable here: it is only set by BrowserParent::Destroy(),\nwhich is not involved when the child initiates teardown.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323317\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327056\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "6226eaedfaa7a4e192f04c7ec3e8721a22c7903e", "git_parents": ["1ffeb9416b9d71d1a225e4b01b4d12268d931b79"], "node": "014379481d7ea7b7502bb8439c40c65b9cb6e2dd", "parents": ["1bcfa6ef8aabebd8f8289eab3ef0eb2d89f61ec9"], "tags": []}], "date": 1789982111, "git_changesets": ["8b72a9bc27c3d67a49ae94e3d040bdbd4f153430", "1ffeb9416b9d71d1a225e4b01b4d12268d931b79", "6226eaedfaa7a4e192f04c7ec3e8721a22c7903e"], "user": "pchevrel@mozilla.com"}, "1590": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068456.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326370\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327016\n", "files": ["gfx/thebes/gfxOTSUtils.h"], "git_node": "625ee70674be31bdac012c2008a17efa0916f2fd", "git_parents": ["6226eaedfaa7a4e192f04c7ec3e8721a22c7903e"], "node": "29bc13a7bb98ce023b1ab526bd4ef0f393e6448b", "parents": ["014379481d7ea7b7502bb8439c40c65b9cb6e2dd"], "tags": []}], "date": 1789982297, "git_changesets": ["625ee70674be31bdac012c2008a17efa0916f2fd"], "user": "pchevrel@mozilla.com"}, "1591": {"changesets": [{"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2071784 - Add guid check to RecvSetTargetAPZC.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326281\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326982\n", "files": ["gfx/layers/ipc/APZCTreeManagerParent.cpp"], "git_node": "7f38686c0d89d63e8e4fbe2813f155f0b63a7c4e", "git_parents": ["625ee70674be31bdac012c2008a17efa0916f2fd"], "node": "4a1e5f387a758bae16e156c3645be57dac4578aa", "parents": ["29bc13a7bb98ce023b1ab526bd4ef0f393e6448b"], "tags": []}], "date": 1789991830, "git_changesets": ["7f38686c0d89d63e8e4fbe2813f155f0b63a7c4e"], "user": "pchevrel@mozilla.com"}, "1592": {"changesets": [{"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072432 - Use AppendChild instead of AppendChildTo in txMozillaXMLOutput::createTxWrapper.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326562\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327118\n", "files": ["dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": "14ee0b68b92a00a9e83f534f5c6882472584d7d6", "git_parents": ["7f38686c0d89d63e8e4fbe2813f155f0b63a7c4e"], "node": "0b5c676c770de46909aae2ee6e135f51186ee933", "parents": ["4a1e5f387a758bae16e156c3645be57dac4578aa"], "tags": []}], "date": 1789991856, "git_changesets": ["14ee0b68b92a00a9e83f534f5c6882472584d7d6"], "user": "pchevrel@mozilla.com"}, "1593": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059404 - Use weak references in sLayerToBrowserParentTable and unregister in ~BrowserParent. a=pascalc\" for causing build failures a=backout\n\nThis reverts commit 8b72a9bc27c3d67a49ae94e3d040bdbd4f153430.\n", "files": ["dom/events/EventStateManager.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "gfx/layers/apz/util/APZCCallbackHelper.cpp"], "git_node": "51a99e87374b976609aaded8e2d6db97162fab06", "git_parents": ["14ee0b68b92a00a9e83f534f5c6882472584d7d6"], "node": "4d418bd89364441ed235fd6c615b4a59366c001b", "parents": ["0b5c676c770de46909aae2ee6e135f51186ee933"], "tags": []}, {"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059404 - Reject child-initiated deletion. a=pascalc\" for causing build failures a=backout\n\nThis reverts commit 1ffeb9416b9d71d1a225e4b01b4d12268d931b79.\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "7ef0ac431b2c3cd037ea29ca75291fddd3d7a9c0", "git_parents": ["51a99e87374b976609aaded8e2d6db97162fab06"], "node": "5e6210b56ccff99ccf4111c8b70aadc5e784cfcf", "parents": ["4d418bd89364441ed235fd6c615b4a59366c001b"], "tags": []}, {"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059404 - Don't initialize rendering for an already-destroyed BrowserParent. a=pascalc\" for causing build failures a=backout\n\nThis reverts commit 6226eaedfaa7a4e192f04c7ec3e8721a22c7903e.\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "b2491e32ce7074c158ec0eaa5f6951839197244e", "git_parents": ["7ef0ac431b2c3cd037ea29ca75291fddd3d7a9c0"], "node": "f07ffe0160b6e4a1c384326dba231a390d064a79", "parents": ["5e6210b56ccff99ccf4111c8b70aadc5e784cfcf"], "tags": []}], "date": 1789995207, "git_changesets": ["51a99e87374b976609aaded8e2d6db97162fab06", "7ef0ac431b2c3cd037ea29ca75291fddd3d7a9c0", "b2491e32ce7074c158ec0eaa5f6951839197244e"], "user": "pchevrel@mozilla.com"}, "1594": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Use weak references in sLayerToBrowserParentTable and unregister in ~BrowserParent.  a=pascalc\n\nUsing weak references in sLayerToBrowserParentTable ensures that we never end\nup with dangling pointers. Clean up the table in ~BrowserParent() in case we\nskipped ActorDestroy.\n\nGetBrowserParentFromLayersId now returns an already_AddRefed because we were\nholding onto a strong reference anyways, and it is probably better anyways to\nhold strong stack references in the callers.\n\nThis ESR-115 version of the fix resolves static accessor ambiguity by taking\nsome changes from bug 1893119: Part 16.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327054\n", "files": ["dom/events/EventStateManager.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "gfx/layers/apz/util/APZCCallbackHelper.cpp"], "git_node": "415232c559b20bda7ad98b0a37a28c99ba22cc8f", "git_parents": ["b2491e32ce7074c158ec0eaa5f6951839197244e"], "node": "245b850de1b5b81ba7064f79dda38f50702057a5", "parents": ["f07ffe0160b6e4a1c384326dba231a390d064a79"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Reject child-initiated deletion.  a=pascalc\n\nThe child should only send us the delete message after we've sent it the\nDestroy message, so if that's not the case, something has gone wrong, so\nlet's kill the child process to prevent further hijinks.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323316\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327055\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "83c3ffea517f2bdb872d6e3c6b118f89e4d2e9f3", "git_parents": ["415232c559b20bda7ad98b0a37a28c99ba22cc8f"], "node": "d2c541eaf5c2632d39293976e6a42f1eca3811ff", "parents": ["245b850de1b5b81ba7064f79dda38f50702057a5"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2059404 - Don't initialize rendering for an already-destroyed BrowserParent.  a=pascalc\n\nIf we can't send in nsFrameLoader::TryRemoteBrowserInternal() or\nBrowserParent::InitRendering(), then we've already started the process of\ndestroying the BrowserParent, so don't set up this rendering stuff that we may\nhave already tried to clean up.\n\nNote that mIsDestroyed is not usable here: it is only set by BrowserParent::Destroy(),\nwhich is not involved when the child initiates teardown.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D323317\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327056\n", "files": ["dom/base/nsFrameLoader.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "70160909d4cbe3d3753c53c53755c720eea62de1", "git_parents": ["83c3ffea517f2bdb872d6e3c6b118f89e4d2e9f3"], "node": "cc6c1e9e8198cd913dcb989477f31ee15e9eab28", "parents": ["d2c541eaf5c2632d39293976e6a42f1eca3811ff"], "tags": []}], "date": 1789999995, "git_changesets": ["415232c559b20bda7ad98b0a37a28c99ba22cc8f", "83c3ffea517f2bdb872d6e3c6b118f89e4d2e9f3", "70160909d4cbe3d3753c53c53755c720eea62de1"], "user": "pchevrel@mozilla.com"}, "1595": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2072433, don't leak elements with animated classes, a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326773\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327423\n", "files": ["dom/base/nsContentList.cpp", "dom/base/nsContentList.h", "dom/base/nsContentUtils.h"], "git_node": "66e403b44d4d441ed1c8fcc71bf67fe1502f2dd7", "git_parents": ["70160909d4cbe3d3753c53c53755c720eea62de1"], "node": "23fb6443a0d72b3e15b9c7b613c363967e3a2503", "parents": ["cc6c1e9e8198cd913dcb989477f31ee15e9eab28"], "tags": []}], "date": 1790022042, "git_changesets": ["66e403b44d4d441ed1c8fcc71bf67fe1502f2dd7"], "user": "pchevrel@mozilla.com"}, "1596": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2072429  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327446\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "layout/svg/SVGObserverUtils.cpp", "layout/svg/SVGObserverUtils.h"], "git_node": "58e70d2df7fea18330c7ef12f7c78cb3cb6e5742", "git_parents": ["66e403b44d4d441ed1c8fcc71bf67fe1502f2dd7"], "node": "bffcddfa72786e1eb2d4cfdbe8ee5bf89b167e4c", "parents": ["23fb6443a0d72b3e15b9c7b613c363967e3a2503"], "tags": []}], "date": 1790024278, "git_changesets": ["58e70d2df7fea18330c7ef12f7c78cb3cb6e5742"], "user": "pchevrel@mozilla.com"}, "1597": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070478 - Fix macOS exception handling for child processes that don't register their own exception handler.  a=pascalc DONTBUILD\n\nWhen we receive an exception that is not meant for us, we claim we\nwant to ignore the exception. However, what we actually tell the\nkernel is that we handled the exception and it can resume the thread\nthat crashed. This causes a crash loop where the process gets\ncontinually resumed at the crashing point, generating a new\nexception and then getting resumed again. It never gets terminated\nby the kernel.\n\nFix that by telling the kernel we didn't handle the exception, so\nthat the exception continues to propagate and the process crashes.\n\nDiscovered while writing tests where the updater binary crashes as\na child of xpcshell. The updater binary does not register an\nexception handler. The tests were failing with a timeout.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D324566\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327876\n", "files": ["toolkit/crashreporter/breakpad-client/mac/handler/exception_handler.cc", "toolkit/crashreporter/test/gtest/TestMacExceptionHandler.cpp", "toolkit/crashreporter/test/gtest/moz.build", "toolkit/crashreporter/test/moz.build"], "git_node": "54ceef8f5313f10fc0cf9eb3484b6361ef590b2c", "git_parents": ["58e70d2df7fea18330c7ef12f7c78cb3cb6e5742"], "node": "aea55e4210d4a81336d65e6d21e10bbcb5a2c4ca", "parents": ["bffcddfa72786e1eb2d4cfdbe8ee5bf89b167e4c"], "tags": []}], "date": 1790060056, "git_changesets": ["54ceef8f5313f10fc0cf9eb3484b6361ef590b2c"], "user": "pchevrel@mozilla.com"}, "1598": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063680 - Destroy CacheIndexRecordWrapper via its refcount  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327707\n", "files": ["netwerk/cache2/CacheIndex.cpp", "netwerk/cache2/CacheIndex.h"], "git_node": "d2f9d949cf65b5cb5ef8c8618ca82e114a9a26d3", "git_parents": ["54ceef8f5313f10fc0cf9eb3484b6361ef590b2c"], "node": "017da9fd1aa8a8b32c71e6ccd34fa0f304f76215", "parents": ["aea55e4210d4a81336d65e6d21e10bbcb5a2c4ca"], "tags": []}], "date": 1790060209, "git_changesets": ["d2f9d949cf65b5cb5ef8c8618ca82e114a9a26d3"], "user": "pchevrel@mozilla.com"}, "1599": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072467.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D327500\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327694\n", "files": ["dom/canvas/OffscreenCanvas.cpp"], "git_node": "b498b763f8e50248b6e6e79f6edb656f731f5bda", "git_parents": ["d2f9d949cf65b5cb5ef8c8618ca82e114a9a26d3"], "node": "868c5db65f18da6054e83ef9ce5827ee49bbc6aa", "parents": ["017da9fd1aa8a8b32c71e6ccd34fa0f304f76215"], "tags": []}], "date": 1790060343, "git_changesets": ["b498b763f8e50248b6e6e79f6edb656f731f5bda"], "user": "pchevrel@mozilla.com"}, "1600": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072429 a=pascalc\" for causing build failures a=backout\n\nThis reverts commit 58e70d2df7fea18330c7ef12f7c78cb3cb6e5742.\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "layout/svg/SVGObserverUtils.cpp", "layout/svg/SVGObserverUtils.h"], "git_node": "994112ee8e905f4112256851311f0e93a7af4ec9", "git_parents": ["b498b763f8e50248b6e6e79f6edb656f731f5bda"], "node": "f1ef307c66b5f8c6de0433117994aadec39ee40e", "parents": ["868c5db65f18da6054e83ef9ce5827ee49bbc6aa"], "tags": []}], "date": 1790065434, "git_changesets": ["994112ee8e905f4112256851311f0e93a7af4ec9"], "user": "pchevrel@mozilla.com"}, "1601": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2072429  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327446\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasRenderingContext2D.h", "layout/svg