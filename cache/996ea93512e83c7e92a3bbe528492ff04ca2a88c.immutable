"pushes": {"101": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 52928ba6fd91414091326fe6339bc63e89b593a6 with FIREFOX_102_4_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "78802a3c14cba9bd7a5778ea03d198dea1f25128", "parents": ["52928ba6fd91414091326fe6339bc63e89b593a6"], "tags": []}], "date": 1665418049, "git_changesets": [null], "user": "ffxbld"}, "102": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "157da79f4814b5cd6a78138fc092b241c3589eca", "parents": ["78802a3c14cba9bd7a5778ea03d198dea1f25128"], "tags": []}], "date": 1666017566, "git_changesets": [null], "user": "ffxbld-merge"}, "103": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159504", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "84808d2f4405013b010e5834b7544b52212b6437", "parents": ["157da79f4814b5cd6a78138fc092b241c3589eca"], "tags": []}, {"author": "Thomas Duellmann \u003cbugzilla2007@duellmann24.net\u003e", "branch": "default", "desc": "Bug 1625632 - Fix dialog button access key handling for unmodified keypress. r=bgrins, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155493", "files": ["toolkit/content/widgets/button.js"], "git_node": null, "git_parents": [null], "node": "ea3e42d5bbff366666606e5d240652daf0f675d7", "parents": ["84808d2f4405013b010e5834b7544b52212b6437"], "tags": []}, {"author": "Brian Grinstead \u003cbgrinstead@mozilla.com\u003e", "branch": "default", "desc": "Bug 1625632 - Test for button element forwarding accesskey to dialog buttons. r=dao, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156623", "files": ["toolkit/content/tests/chrome/chrome.ini", "toolkit/content/tests/chrome/dialog_button.xhtml", "toolkit/content/tests/chrome/test_dialog_button.xhtml"], "git_node": null, "git_parents": [null], "node": "e38a4f59bd10548a21b86ebea720245ba0267714", "parents": ["ea3e42d5bbff366666606e5d240652daf0f675d7"], "tags": []}, {"author": "Dan Ballard \u003cdan@mindstab.net\u003e", "branch": "default", "desc": "Bug 1791689 - StaticPrefList network.proxy.allow_bypass checks MOZ_PROXY_BYPASS_PROTECTION for default value. r=robwu, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157774", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "7ef9905dd02a36b4cb18f20a07eedecb2b650290", "parents": ["e38a4f59bd10548a21b86ebea720245ba0267714"], "tags": []}], "date": 1666019585, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "104": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1795726 - Update wpt certificate expiration dates. r=jgraham, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159526", "files": ["testing/web-platform/tests/tools/certs/cacert.key", "testing/web-platform/tests/tools/certs/cacert.pem", "testing/web-platform/tests/tools/certs/web-platform.test.key", "testing/web-platform/tests/tools/certs/web-platform.test.pem"], "git_node": null, "git_parents": [null], "node": "e51106e671908974a51b4bde28932d2942af08f1", "parents": ["7ef9905dd02a36b4cb18f20a07eedecb2b650290"], "tags": []}], "date": 1666036909, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "105": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 52928ba6fd91414091326fe6339bc63e89b593a6 with FIREFOX_102_4_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "bc362fb1b9d412555d9f8ba42395f01849537702", "parents": ["e51106e671908974a51b4bde28932d2942af08f1"], "tags": []}], "date": 1666097905, "git_changesets": [null], "user": "ffxbld"}, "106": {"changesets": [{"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1658869 - Propagate the InterceptedHttpChannel information to fetch's channel casued by FetchEvent.request. r=dom-worker-reviewers,dragana,jesup, a=dmeehan\n\n\nWhen a network load needs to be intercepted by ServiceWorker, we extract the Request from the InterceptedHttpChannel, and propagate the Request through FetchEvent.request.\n\nHowever, some needed information is not extracted or is modified during the Request propagation, so getting the wrong result when using the Request to fetch resources in the ServiceWorker script.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D145969", "files": ["dom/fetch/Fetch.cpp", "dom/fetch/FetchDriver.cpp", "dom/fetch/FetchTypes.ipdlh", "dom/fetch/InternalRequest.cpp", "dom/fetch/InternalRequest.h", "dom/serviceworkers/ServiceWorkerPrivateImpl.cpp", "ipc/glue/BackgroundUtils.cpp", "netwerk/base/InterceptionInfo.cpp", "netwerk/base/InterceptionInfo.h", "netwerk/base/LoadInfo.cpp", "netwerk/base/LoadInfo.h", "netwerk/base/TRRLoadInfo.cpp", "netwerk/base/moz.build", "netwerk/base/nsIInterceptionInfo.idl", "netwerk/base/nsILoadInfo.idl", "netwerk/cookie/CookieCommons.cpp", "netwerk/ipc/NeckoChannelParams.ipdlh"], "git_node": null, "git_parents": [null], "node": "24a443c8697c7bbd2c6d50ee5410288dd3139ff1", "parents": ["bc362fb1b9d412555d9f8ba42395f01849537702"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159847", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "c6c7eef655ab2690df5ca9ca32a3ba46468ab640", "parents": ["24a443c8697c7bbd2c6d50ee5410288dd3139ff1"], "tags": []}], "date": 1666274948, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "107": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1791029 - Deal with lstat potentially lying in nsLocalFileUnix. r=xpcom-reviewers,nika, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158796", "files": ["xpcom/io/nsLocalFileUnix.cpp"], "git_node": null, "git_parents": [null], "node": "084a542649289e7f4ad7636e24bb6588b1c2c63a", "parents": ["c6c7eef655ab2690df5ca9ca32a3ba46468ab640"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1790815 - Don't raise the window for tab-modal SubDialogs and in print. r=Gijs, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157599", "files": ["toolkit/components/printing/content/print.js", "toolkit/modules/SubDialog.jsm"], "git_node": null, "git_parents": [null], "node": "b59a6e1056f85e9f9d70e7e31344818812ee8c6d", "parents": ["084a542649289e7f4ad7636e24bb6588b1c2c63a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1793829 - Don't steal focus for navigations without user activation. r=hsivonen, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158758", "files": ["docshell/base/nsDocShell.cpp"], "git_node": null, "git_parents": [null], "node": "8bfe53ec3269153eb5bc08cd20abee56c3966fb7", "parents": ["b59a6e1056f85e9f9d70e7e31344818812ee8c6d"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1789808 - Fix buffer overflow, r=necko-reviewers,dragana, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158654", "files": ["netwerk/system/mac/nsNetworkLinkService.mm"], "git_node": null, "git_parents": [null], "node": "4912941eaca3f6ec9a47e8789bab3f62fad4e88e", "parents": ["8bfe53ec3269153eb5bc08cd20abee56c3966fb7"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1794061 - WebSocketChannel::CleanupConnection should run on IO thread, r=necko-reviewers,valentin, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158831", "files": ["netwerk/protocol/websocket/WebSocketChannel.cpp"], "git_node": null, "git_parents": [null], "node": "bb8e5e74571d124069ff6ae7e0dfa506162728e6", "parents": ["4912941eaca3f6ec9a47e8789bab3f62fad4e88e"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160039", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "9f38ac6365f838e96c2c1bcb6b6c88f042ede491", "parents": ["bb8e5e74571d124069ff6ae7e0dfa506162728e6"], "tags": []}], "date": 1666617066, "git_changesets": [null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "108": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1792643. Set clip on background items for table cols and colgroups, when the table row, rowgroup or table has captured clip. r=mstange, a=dmeehan\n\nExactly like bug 1735265 except a frame other then the cell, between the\ncell and the table frame is a stacking context.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158471", "files": ["layout/reftests/bugs/1792643-1-ref.html", "layout/reftests/bugs/1792643-1.html", "layout/reftests/bugs/reftest.list", "layout/tables/nsTableCellFrame.cpp"], "git_node": null, "git_parents": [null], "node": "df5f6cd3a0024faa11022acae5f3519230125b28", "parents": ["9f38ac6365f838e96c2c1bcb6b6c88f042ede491"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1793676 - Dynamically generate DOM code names for some continuous runs of codes, r=mccr8, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159400", "files": ["widget/WidgetEventImpl.cpp"], "git_node": null, "git_parents": [null], "node": "db9a92d5466c11e09d0e0c9a2813df175e7c7d42", "parents": ["df5f6cd3a0024faa11022acae5f3519230125b28"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1795815 - Fix cursor intersection detection on OOP iframes. r=smaug, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159783", "files": ["dom/base/DOMIntersectionObserver.cpp", "dom/base/DOMIntersectionObserver.h", "dom/events/EventStateManager.cpp"], "git_node": null, "git_parents": [null], "node": "200e7126f89de17a0964b710469fb6087d9957e0", "parents": ["db9a92d5466c11e09d0e0c9a2813df175e7c7d42"], "tags": []}, {"author": "sunil mayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 1790311 - update handling of request headers in Fetch/XHR. r=necko-reviewers,valentin, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D157729", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/fetch/FetchUtil.h", "dom/fetch/InternalHeaders.cpp", "dom/fetch/InternalHeaders.h", "dom/xhr/XMLHttpRequestMainThread.cpp"], "git_node": null, "git_parents": [null], "node": "c8dab52e2ead50f94859600571b48d9ac491c854", "parents": ["200e7126f89de17a0964b710469fb6087d9957e0"], "tags": []}, {"author": "sunil mayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 1790311 - update WPT tests for request headers in XHR/Fetch. r=necko-reviewers,valentin, a=dmeehan\n\nDepends on D157729\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158257", "files": ["testing/web-platform/tests/fetch/api/basic/request-forbidden-headers.any.js", "testing/web-platform/tests/xhr/setrequestheader-header-forbidden.htm"], "git_node": null, "git_parents": [null], "node": "ede4ac9e5b4aab368dba0f60f22608e774b5b57d", "parents": ["c8dab52e2ead50f94859600571b48d9ac491c854"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160501", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "3d3df09dc2bd1bc3eb082f792408cc3f1f1924b7", "parents": ["ede4ac9e5b4aab368dba0f60f22608e774b5b57d"], "tags": []}], "date": 1666878607, "git_changesets": [null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "109": {"changesets": [{"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1787381 - Use standards mode in hiddenWindow.html. r=hsivonen, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D155668", "files": ["dom/res/hiddenWindow.html"], "git_node": null, "git_parents": [null], "node": "aec93cc12850d07c7859f3822239e728aab36cc2", "parents": ["3d3df09dc2bd1bc3eb082f792408cc3f1f1924b7"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1761233 - Apply VDMX sanitization fix from https://github.com/khaledhosny/ots/pull/250 to avoid generating invalid \"sanitized\" data. r=gfx-reviewers,lsalzman, a=dmeehan\n\nWith this fix, the site from comment 21 loads successfully.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158712", "files": ["gfx/ots/src/vdmx.cc"], "git_node": null, "git_parents": [null], "node": "bedc23ef1e13f97a8e5e1e5df350a6334364fd84", "parents": ["aec93cc12850d07c7859f3822239e728aab36cc2"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160783", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "a25ed3a36e2a36dda3ccad0efcaf6f9e38e5112e", "parents": ["bedc23ef1e13f97a8e5e1e5df350a6334364fd84"], "tags": []}], "date": 1667221675, "git_changesets": [null, null, null], "user": "dmeehan@mozilla.com"}, "110": {"changesets": [{"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779846 - Remove an unneeded if-statement in TextServicesDocument::OffsetEntryArray::FindWordRange(). r=masayuki, a=dmeehan\n\nThis patch fixed a regression caused by Bug 1730084 Part 4\nhttps://phabricator.services.mozilla.com/D125434, which is intended to preserve\nthe behavior of `WordBreaker::FindWord()`.\n\nBefore Bug 1730084 Part 4, `WordBreaker::FindWord()` returns\n`[aTextLen + 1, aTextLen + 1]` only when `aOffset \u003e aTextLen`.\nBut `WordBreaker::FindWord()` had an assertion `aOffset \u003c= aTextLen`\nto guarantee the caller never passes `aOffset \u003e aTextLen`. Thus, we can never\ngo into the `if (res.mBegin \u003e strLen)` in\n`TextServicesDocument::OffsetEntryArray::FindWordRange()`.\n\nHowever, Bug 1730084 Part 4 wrongly changes the if-statement to\n`if (range.mEnd == range.mBegin)`, and makes it reachable when\n`TextServicesDocument::OffsetEntryArray::FindWordRange()` passes\n`aPos == aLen` into `WordBreaker::FindWord()`. This makes `InitSpellChecker()`\nfailed when `enableSelectionChecking=true`.\n\nThis patch deletes the originally unreachable error handling if-statement, and\nadds an assertion to guarantee `strOffset` and `strLen` is valid.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156210", "files": ["editor/spellchecker/TextServicesDocument.cpp", "editor/spellchecker/tests/mochitest.ini", "editor/spellchecker/tests/test_spellcheck_selection.html"], "git_node": null, "git_parents": [null], "node": "4ecbf3c69ea7deb5002fac5bc61a4a74a3ea7e87", "parents": ["a25ed3a36e2a36dda3ccad0efcaf6f9e38e5112e"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1791975 - Don't sweep realms that were allocated during incremental GC r=jandem, a=dmeehan\n\nWhen marking a BaseShape we mark its global, and we read the pointer to that\nglobal from the realm. If a realm doesn't have a live global we can sweep the\nrealm but there may still be pointers to it in base shapes and these are left\ndangling.\n\nThis happens when we hit OOM while creating a global during an incremental GC.\nThe BaseShape survives because it was allocated after the start of the GC. The\nglobal itself is never successfully created and so the realm doesn't have a\nlive global and is swept. In this case, we trigger UAF when we try to compact\nthe heap and trace the base shape.\n\nThe patch adds an extra case for keeping a realm alive if it was created during\nan incremental GC. This matches the way that GC things are not collected if\nthey are allocated after the start of a GC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158022", "files": ["js/src/gc/GC.cpp", "js/src/vm/Realm-inl.h", "js/src/vm/Realm.cpp", "js/src/vm/Realm.h"], "git_node": null, "git_parents": [null], "node": "7cac6b2502adf13567d030c660500431bb859e3a", "parents": ["4ecbf3c69ea7deb5002fac5bc61a4a74a3ea7e87"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1796901 - Clear realm incremental marking state at the start of GC rather than at the end r=jandem, a=dmeehan\n\nGC can be aborted in several states and zones GCRuntime::finishCollection\ndoesn't always get called. It's easier to clear this state in a signle place at\nthe start.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160056", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug-1796901.js"], "git_node": null, "git_parents": [null], "node": "3589b287051109ea9d3a3d709a98109b7e79f80d", "parents": ["7cac6b2502adf13567d030c660500431bb859e3a"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1762078 - Blocking SerivceWorker interception for no_cors cross-origin range request. r=dom-worker-reviewers,karlt, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D146553", "files": ["dom/serviceworkers/ServiceWorkerInterceptController.cpp", "dom/serviceworkers/moz.build", "testing/web-platform/meta/fetch/range/sw.https.window.js.ini", "testing/web-platform/meta/service-workers/service-worker/fetch-request-resources.https.html.ini"], "git_node": null, "git_parents": [null], "node": "55e50488f64401ccee38d2a5eaedb600e03d32db", "parents": ["3589b287051109ea9d3a3d709a98109b7e79f80d"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1767920 - Increase thread stack size on windows (for ESR 102), r=#necko, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161059", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/base/nsSocketTransportService2.cpp"], "git_node": null, "git_parents": [null], "node": "257c9607c0fa51f99561435b0e259bf39a532d08", "parents": ["55e50488f64401ccee38d2a5eaedb600e03d32db"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1797336 - Apply expat CVE-2022-43680 fix. r=mccr8, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160676", "files": ["parser/expat/lib/xmlparse.c"], "git_node": null, "git_parents": [null], "node": "b8cf39722afabfd9554c87665fe88aedbc13e367", "parents": ["257c9607c0fa51f99561435b0e259bf39a532d08"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1798623: Update time zone data to tzdata2022f (ESR102 backport). r=#platform-i18n-reviewers, a=dmeehan\n\n\nBackport for ESR102.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161009", "files": ["config/external/icu/data/icudt71l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js"], "git_node": null, "git_parents": [null], "node": "02d13fca9b95676c3090f3c9bcf160b4c61bfc84", "parents": ["b8cf39722afabfd9554c87665fe88aedbc13e367"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161119", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "081c4de4fa328544314172e71e162e2546fcb6f2", "parents": ["02d13fca9b95676c3090f3c9bcf160b4c61bfc84"], "tags": []}], "date": 1667490935, "git_changesets": [null, null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "111": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 02d13fca9b95 (bug 1798623) for a perma gtest failure", "files": ["config/external/icu/data/icudt71l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js"], "git_node": null, "git_parents": [null], "node": "77b287f2043676aee24508ac1ebbf76e52081a93", "parents": ["081c4de4fa328544314172e71e162e2546fcb6f2"], "tags": []}], "date": 1667510196, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "112": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777394 - Do not crash on inaccessible dictionary file. r=bholley, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156278", "files": ["extensions/spellcheck/hunspell/glue/RLBoxHunspell.cpp", "extensions/spellcheck/hunspell/glue/mozHunspell.cpp"], "git_node": null, "git_parents": [null], "node": "75b7e80046457dc9ed88a425a688674fe5bfcdf2", "parents": ["77b287f2043676aee24508ac1ebbf76e52081a93"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777207, don't replace extensions of executables when saving on Windows any more; the filename has already been validated and it can cause the filename a user chose to be incorrect, r=mhowell, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156729", "files": ["toolkit/mozapps/downloads/HelperAppDlg.jsm", "toolkit/mozapps/downloads/tests/browser/browser.ini", "toolkit/mozapps/downloads/tests/browser/browser_save_wrongextension.js", "uriloader/exthandler/tests/mochitest/browser_save_filenames.js", "uriloader/exthandler/tests/mochitest/save_filenames.html"], "git_node": null, "git_parents": [null], "node": "8843b2a3a37a8c66d021966a9754daa8c55af370", "parents": ["75b7e80046457dc9ed88a425a688674fe5bfcdf2"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1778597, append valid extensions only when saving a page, r=Gijs,necko-reviewers, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159478", "files": ["netwerk/mime/nsIMIMEService.idl", "toolkit/content/contentAreaUtils.js", "uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/nsExternalHelperAppService.h", "uriloader/exthandler/tests/mochitest/browser_save_filenames.js", "uriloader/exthandler/tests/mochitest/save_filenames.html"], "git_node": null, "git_parents": [null], "node": "cdab5f7deed190914f3084ffd1f20ee70d0ba092", "parents": ["8843b2a3a37a8c66d021966a9754daa8c55af370"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774285 - On Windows 11 22H2, flush the Windows clipboard immediately after setting it. r=neildeakin, a=dmeehan\n\n\nThis works around a windows 11 suggested actions bug, see comment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160646", "files": ["mfbt/WindowsVersion.h", "modules/libpref/init/StaticPrefList.yaml", "widget/windows/nsClipboard.cpp"], "git_node": null, "git_parents": [null], "node": "f878924035a53c4f742374ed7a745586cd2b64d7", "parents": ["cdab5f7deed190914f3084ffd1f20ee70d0ba092"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774285 - Avoid a11y instantiation after clipboard copy. r=nlapre,jamie, a=dmeehan\n\n\nThis prevents a11y from getting instantiated shortly after clipboard paste, in\norder to prevent hangs with the Windows 11 suggested actions feature.\n\nWhen combined with the previous patch, the behavior is the following:\n\n * For users with a11y already-enabled:\n\n   * No hang (due to clipboard flush).\n   * Quick actions menu is positioned at selection offset.\n\n * For users with a11y disabled (most):\n\n   * No hang (due to no a11y instantiation + clipboard flush).\n   * Quick actions menu is positioned at pointer (cursor) offset.\n\nCo-Authored-By: Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160652\n\nDepends on D160646", "files": ["accessible/windows/msaa/Compatibility.cpp", "accessible/windows/msaa/Compatibility.h", "accessible/windows/msaa/LazyInstantiator.cpp", "modules/libpref/init/StaticPrefList.yaml", "widget/nsClipboardProxy.cpp", "widget/windows/nsClipboard.cpp"], "git_node": null, "git_parents": [null], "node": "78947c7f4da3a99a0f5adcbae88a2fed9f2fbbb1", "parents": ["f878924035a53c4f742374ed7a745586cd2b64d7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1798160 - Avoid flushing the clipboard sync for images and files. r=smaug, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160666", "files": ["widget/windows/nsClipboard.cpp", "widget/windows/nsClipboard.h"], "git_node": null, "git_parents": [null], "node": "d9afc31b54adb13ccb27505d5ff8cb4c810c9117", "parents": ["78947c7f4da3a99a0f5adcbae88a2fed9f2fbbb1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1798117 - Only flush clipboard for text data. r=smaug, a=dmeehan\n\nOtherwise Chromium gets confused when pasting (Signal is an Electron\napplication).\n\nI need to dig a bit more, but this doesn't prevent the fix for\nbug 1774285 from working, and fixes the issue here.\n\nIt's probably a Chromium bug that this doesn't work tho since,\nas mentioned in comment 0, it works on other Windows applications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160808", "files": ["widget/windows/nsClipboard.cpp"], "git_node": null, "git_parents": [null], "node": "278696a970e575deb03d7b13cf71c08e9d166e49", "parents": ["d9afc31b54adb13ccb27505d5ff8cb4c810c9117"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1791314, some underlying streams prefer being closed on the target thread, r=valentin,necko-reviewers, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160054", "files": ["netwerk/base/nsInputStreamPump.cpp"], "git_node": null, "git_parents": [null], "node": "2c8ea4b46e9d308dee340d0d785743cfe9ee6c18", "parents": ["278696a970e575deb03d7b13cf71c08e9d166e49"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161463", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "1bc957eee90a2ebc8f71dc62f9ad193864c19552", "parents": ["2c8ea4b46e9d308dee340d0d785743cfe9ee6c18"], "tags": []}], "date": 1667837397, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "113": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1793742 - Disable autofill prefs when locked by policy. r=tgiles,credential-management-reviewers,sgalich, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158676", "files": ["browser/extensions/formautofill/test/browser/browser_privacyPreferences.js", "toolkit/components/formautofill/FormAutofill.jsm", "toolkit/components/formautofill/FormAutofillPreferences.jsm"], "git_node": null, "git_parents": [null], "node": "d3eabae8f6b927bd855a1918813ddfac59383be3", "parents": ["1bc957eee90a2ebc8f71dc62f9ad193864c19552"], "tags": []}, {"author": "Gregory Pappas \u003cgp3033@protonmail.com\u003e", "branch": "default", "desc": "Bug 1792205 - Disable 'More troubleshooting information...' when BlockAboutSupport is active r=mkaply,mconley, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D158071", "files": ["browser/base/content/utilityOverlay.js", "browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_block_about_support.js", "toolkit/components/aboutmemory/content/aboutMemory.js"], "git_node": null, "git_parents": [null], "node": "ff78e95c0a13d01164b55b6f23618a70d8ec2879", "parents": ["d3eabae8f6b927bd855a1918813ddfac59383be3"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1798623: Update time zone data to tzdata2022f (ESR102 backport). r=#platform-i18n-reviewers, a=dmeehan\n\n\nBackport for ESR102.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D161009", "files": ["config/external/icu/data/icudt71l.dat", "intl/components/gtest/TestTimeZone.cpp", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js"], "git_node": null, "git_parents": [null], "node": "28738f45597b736e5689c199131d5da9ae0a6cec", "parents": ["ff78e95c0a13d01164b55b6f23618a70d8ec2879"], "tags": ["FIREFOX_102_5_0esr_BUILD1", "FIREFOX_102_5_0esr_RELEASE"]}], "date": 1667848225, "git_changesets": [null, null, null], "user": "dmeehan@mozilla.com"}}
}";