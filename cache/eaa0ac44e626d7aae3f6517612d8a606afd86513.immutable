ial Revision: https://phabricator.services.mozilla.com/D42609", "files": ["dom/indexedDB/test/file.js", "dom/indexedDB/test/helpers.js", "dom/indexedDB/test/test_file_delete.html", "dom/indexedDB/test/test_file_resurrection_delete.html", "dom/indexedDB/test/test_file_resurrection_transaction_abort.html", "dom/indexedDB/test/test_file_transaction_abort.html"], "git_node": null, "git_parents": [null], "node": "8cbaa2b1e8629235441f15c55a581a337a34af90", "parents": ["cc434f1c56412bfee6166c6a2a9cd00d39b34f71"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1527029 - Split about:blank test from browser_ext_tabs_executeScript.js. r=zombie, a=test-only\n\nThe browser_ext_tabs_executeScript.js test occasionally times out.\nApparently the part of the test that opens \"about:blank\" and awaits the\nresult sometimes times out (`tabs.executeScript` does not resolve).\n\nTo avoid collateral damage by this small part of the test, the\n\"about:blank\" test has been moved to its own file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45955", "files": ["browser/components/extensions/test/browser/browser-common.ini", "browser/components/extensions/test/browser/browser_ext_tabs_executeScript.js", "browser/components/extensions/test/browser/browser_ext_tabs_executeScript_about_blank.js"], "git_node": null, "git_parents": [null], "node": "713675c6e805a1f59bc50cbdfb274c9f9d06d192", "parents": ["8cbaa2b1e8629235441f15c55a581a337a34af90"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1536227: Block safemon64.dll (360 Safeguard/360 Total Security) for causing a11y crashes. r=aklotz a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D27203", "files": ["mozglue/build/WindowsDllBlocklistDefs.h"], "git_node": null, "git_parents": [null], "node": "050d4498c37cebd8f106460f0f6fc71c035dcf48", "parents": ["713675c6e805a1f59bc50cbdfb274c9f9d06d192"], "tags": []}, {"author": "J.C. Jones \u003cjjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1573245 - Change AuthenticatorTransport to be string, not `enum` r=bzbarsky,keeler a=RyanVM\n\nUpstream: https://github.com/w3c/webauthn/issues/1268\n\nDifferential Revision: https://phabricator.services.mozilla.com/D41620", "files": ["dom/webauthn/WebAuthnManager.cpp", "dom/webauthn/tests/test_webauthn_get_assertion.html", "dom/webauthn/tests/test_webauthn_make_credential.html", "dom/webidl/WebAuthentication.webidl"], "git_node": null, "git_parents": [null], "node": "abdb33fc8e07ae265985b87e39c6b97787e1c063", "parents": ["050d4498c37cebd8f106460f0f6fc71c035dcf48"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "bug 1578882 - wait on the loadable roots background task before handing out CertVerifier handles r=tjr a=RyanVM\n\nIf code acquires a handle on the certificate verifier before the loadable roots\nbackground task completes, that instance of the verifier may not know about any\nenterprise certificates loaded, and so early certificate verifications relying\non those certificates may fail. To prevent this, this patch ensures that the\nbackground task has completed before returning the handle. Note that there\nshould be no effect on performance since CertVerifier already ensures that the\nbackground task has completed internally before looking for potential issuer\ncertificates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D46224", "files": ["security/manager/ssl/nsNSSComponent.cpp"], "git_node": null, "git_parents": [null], "node": "579e9b6c15600de85fed6fe41307702c506bc78e", "parents": ["abdb33fc8e07ae265985b87e39c6b97787e1c063"], "tags": []}], "date": 1568905004, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "375": {"changesets": [{"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1525290 Crash in android.os.RemoteException: at com.android.server.job.JobServiceContext.assertCallerLocked(JobServiceContext.java) r=VladBaicu a=RyanVM\n\nNow writing in FileOutputStream on a background thread instead of the main thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45870", "files": ["mobile/android/base/java/org/mozilla/gecko/FilePickerResultHandler.java"], "git_node": null, "git_parents": [null], "node": "9d6b76c3c35063bdb0ddb935799d759a752cbef0", "parents": ["579e9b6c15600de85fed6fe41307702c506bc78e"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1573479 - Show Toast, not crash when sharing fails; r=VladBaicu, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45677", "files": ["mobile/android/base/java/org/mozilla/gecko/widget/GeckoActionProvider.java", "mobile/android/base/locales/en-US/android_strings.dtd", "mobile/android/base/strings.xml.in"], "git_node": null, "git_parents": [null], "node": "3f76f9600f366efa003efec2e8fa3d38565fe12e", "parents": ["9d6b76c3c35063bdb0ddb935799d759a752cbef0"], "tags": []}], "date": 1568905901, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "376": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1564594 - Make sure we set the correct Fennec shared prefs that the core ping is reading (without the `extensions.webcompat.` prefix); r=nalexander, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D44901", "files": ["browser/extensions/webcompat/experiment-apis/sharedPreferences.js", "browser/extensions/webcompat/manifest.json", "mobile/android/extensions/webcompat/experiment-apis/sharedPreferences.js", "mobile/android/extensions/webcompat/manifest.json"], "git_node": null, "git_parents": [null], "node": "d51b5c16f2953d92167bc5c175709b1896008590", "parents": ["3f76f9600f366efa003efec2e8fa3d38565fe12e"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1564594 - use more specific match patterns in the enhanced search experiment to improve performance and avoid test failures; r=denschub, a=RyanVM\n\nuse more specific match patterns in the enhanced search experiment to improve performance and avoid test failures\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45026", "files": ["browser/extensions/webcompat/data/ua_overrides.js", "browser/extensions/webcompat/lib/google.js", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/moz.build", "mobile/android/extensions/webcompat/data/ua_overrides.js", "mobile/android/extensions/webcompat/lib/google.js", "mobile/android/extensions/webcompat/manifest.json", "mobile/android/extensions/webcompat/moz.build"], "git_node": null, "git_parents": [null], "node": "ed787705f44c0ad6e945ce7b117c9127022f4de9", "parents": ["d51b5c16f2953d92167bc5c175709b1896008590"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1564594 - re-sync browser/ and mobile/ versions of the addon to correct a telemetryKey typo, remove the now unusued regex-matching code, and bump version to 6.0.3; r=miketaylr, a=RyanVM\n\nre-sync browser/ and mobile/ versions of the addon to correct a telemetryKey typo, remove the now unusued regex-matching code, and bump version to 6.0.3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45946", "files": ["browser/extensions/webcompat/data/ua_overrides.js", "browser/extensions/webcompat/lib/ua_overrides.js", "browser/extensions/webcompat/manifest.json", "mobile/android/extensions/webcompat/lib/ua_overrides.js", "mobile/android/extensions/webcompat/manifest.json"], "git_node": null, "git_parents": [null], "node": "9af9ca29281ea3485071172c408231a3eb083ab2", "parents": ["ed787705f44c0ad6e945ce7b117c9127022f4de9"], "tags": []}], "date": 1568906305, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "377": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nes-AR -\u003e a5e8e43b0b67\ngn -\u003e 486db3ffe5cd\nhe -\u003e c354d895d06c\nhsb -\u003e d2065587a234\nit -\u003e dd6d411bac87\nkab -\u003e 4ba315e825cf\nnb-NO -\u003e 08b6bb1dc03f\npt-BR -\u003e eb00874e16c3\nsl -\u003e da1ca4a1672c\nsv-SE -\u003e 2ae445c60be6\nuk -\u003e d8c3eda02cd6\nzh-CN -\u003e 5c7f0cd04558", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "ca2f512563547036432e268ba003ae7c4a3482d7", "parents": ["9af9ca29281ea3485071172c408231a3eb083ab2"], "tags": []}], "date": 1568962839, "git_changesets": [null], "user": "ffxbld"}, "378": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ncy -\u003e 04269e1e9480\nde -\u003e ce8f7af5258f\nfr -\u003e 83080af6fcc9\nit -\u003e 5779972b5c27\nsv-SE -\u003e 4b23775e1004", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "102405eac980a30c3507ceeeba5d089a1f93a819", "parents": ["ca2f512563547036432e268ba003ae7c4a3482d7"], "tags": []}], "date": 1568984440, "git_changesets": [null], "user": "ffxbld"}, "379": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1564639 - Make `BrowserParent` use `nsPresContext::GetRootWidget()` when handling IME related messages r=hsivonen a=RyanVM\n\nWhen contents notify IME or requests something to IME, they need to use\nan `nsIWidget` instance which may have focus if active, and handles\nnative keyboard/IME events since that knows correct native IME context.\n\nCurrently, such widget exactly matches with the result of\n`nsPresContext::GetRootWidget()`.  However, this is unclear for most developers.\nTherefore, this patch creates a wrapper method of it named\n`nsPresContext::GetTextInputHandlingWidget()`.  Then, also adds\n`BrowserParent::GetTextInputHandlingWidget()` wraps it.  Finally, makes\n`IMEStateManager` call `GetTextInputHandlingWidget()` of them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D42301", "files": ["dom/events/IMEStateManager.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "layout/base/nsPresContext.cpp", "layout/base/nsPresContext.h"], "git_node": null, "git_parents": [null], "node": "a597dc76a8fea6e02d8332508bb6af65d7641584", "parents": ["102405eac980a30c3507ceeeba5d089a1f93a819"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1580820. Update the inner window id as well as the context (document) pointer on an imgRequest if we validate it for that document/inner window id. r=aosmond a=RyanVM\n\nIf we just update the document pointer and not the inner window id then the request is unusable by any document since both the inner window id and the document pointer must match for it to be re-usable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D46121", "files": ["image/imgLoader.cpp", "image/imgLoader.h", "image/imgRequest.h"], "git_node": null, "git_parents": [null], "node": "3cd88c34effdc1c0267b8068b84a0bfd59d855e1", "parents": ["a597dc76a8fea6e02d8332508bb6af65d7641584"], "tags": []}], "date": 1568993577, "git_changesets": [null, null], "user": "apavel@mozilla.com"}, "380": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nbn -\u003e 734049247f06\ncak -\u003e 236e427d1140\ncs -\u003e 33afbb5fa81c\nda -\u003e 6a71a9ca3feb\nel -\u003e 27d0265709d7\nes-AR -\u003e c61c99293754\net -\u003e adc6f35a4ee9\nit -\