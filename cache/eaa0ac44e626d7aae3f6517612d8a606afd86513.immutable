["taskcluster/scripts/misc/fetch-content"], "git_node": null, "git_parents": [null], "node": "a3ab0641235427e02ccf8e0573b9e276d89cce43", "parents": ["a6c1404320a72f4ef64dbb87335b013b5963e05e"], "tags": []}], "date": 1570548663, "git_changesets": [null], "user": "mozilla@jorgk.com"}, "463": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ndsb -\u003e 32ee146e4a52\nen-GB -\u003e 31adfb363573\ngn -\u003e 48621211f236\nhsb -\u003e 380b2e9495bd\nit -\u003e 89e576ba7532", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "dd44cdcd499093c54adcc21471061d3dbf27edee", "parents": ["36568485b3a066b442050e4a8d605002ca257338"], "tags": []}], "date": 1570564832, "git_changesets": [null], "user": "ffxbld"}, "464": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nar -\u003e 33e2ffd36693\nnn-NO -\u003e a671ab4a205b\npt-BR -\u003e 99af08b0dc79", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "cbfe2df7d30e08cead47006d9c8bdd7145145206", "parents": ["dd44cdcd499093c54adcc21471061d3dbf27edee"], "tags": []}], "date": 1570600833, "git_changesets": [null], "user": "ffxbld"}, "465": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ncs -\u003e a4e380125c76\net -\u003e bd6569e3cccd\neu -\u003e 7cb2cec3f496\nfr -\u003e 8f25f09179cc\ngn -\u003e 00f1f5fd690e\nhu -\u003e f9394ce5f574\nit -\u003e a0b9e60bf1bc\nuk -\u003e 73adec26825d\nvi -\u003e f4e9d650bdcc", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "1cc8e29063c59311d00d803eb8783e97e4f11389", "parents": ["cbfe2df7d30e08cead47006d9c8bdd7145145206"], "tags": []}], "date": 1570626033, "git_changesets": [null], "user": "ffxbld"}, "466": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1586168 Remove mincore and use version instead r=aklotz a=RyanVM\n\nIn Bug 1558350 we added TestNativeNT to the test set and discovered\nthat it could not run on Windows 7. On esr68, trying to enable MinGW\ntests lead to (what I think is) the same problem.\n\nFor MinGW at least, mincore was pulling in api-ms-win-core-*.dlls not\nall of which are available on Windows 7. (Or perhaps MinGW's dll def\nfiles are incorrect but the presence of the issue in 1558350 indicates\nit's not solely a MinGW problem.) By swapping out mincore for version\nwe - at least for MinGW - cause kernel32 to be used instead of the\napi-ms-win-core-*.dll's which fixes the test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48203", "files": ["mozglue/tests/moz.build"], "git_node": null, "git_parents": [null], "node": "dde11ff21e38578041215c03b894be6088e0843e", "parents": ["1cc8e29063c59311d00d803eb8783e97e4f11389"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1581117 - Properly invalidate theme data from the media query change in LightweightThemeConsumer.jsm. r=kmag,dao a=RyanVM\n\nJust this._update() is not enough to update everything that changing the theme\nimplies. Instead, use the observer mechanism so all the pieces of code involved\nupdate properly.\n\nDifferential Revision: https://phabricator.services.mozilla.com//D45926", "files": ["toolkit/modules/LightweightThemeConsumer.jsm"], "git_node": null, "git_parents": [null], "node": "9cd8fc96dfa7a071aee6475cc351273e61da9d09", "parents": ["dde11ff21e38578041215c03b894be6088e0843e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1568169 - Remove SourceListener from window listener in all gUM failure paths. r=jib a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47901", "files": ["dom/media/MediaManager.cpp"], "git_node": null, "git_parents": [null], "node": "f23f3e77b7f294394a7a79e984e9c6bcf5617f21", "parents": ["9cd8fc96dfa7a071aee6475cc351273e61da9d09"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1574963 - Add a policy for using legacy profiles on Windows. r=Mossop a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com//D47841", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "toolkit/profile/nsToolkitProfileService.cpp"], "git_node": null, "git_parents": [null], "node": "822fcb10f6fec5a746f9f9f6986114614db80f8d", "parents": ["f23f3e77b7f294394a7a79e984e9c6bcf5617f21"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1574963 - Add description for LegacyProfiles policy. r=flod,fluent-reviewers a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com//D48421", "files": ["browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "2eed5fdce27200f4596a1ce5cf7e7eaebcab160d", "parents": ["822fcb10f6fec5a746f9f9f6986114614db80f8d"], "tags": []}], "date": 1570631110, "git_changesets": [null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "467": {"changesets": [{"author": "Ksenia Berezina \u003ckberezina@mozilla.com\u003e", "branch": "default", "desc": "Bug 1586188 - Import WebCompat GoFaster 6.2.0 sources; r=miketaylr a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48152", "files": ["browser/extensions/webcompat/data/injections.js", "browser/extensions/webcompat/data/ua_overrides.js", "browser/extensions/webcompat/lib/custom_functions.js", "browser/extensions/webcompat/manifest.json", "mobile/android/extensions/webcompat/data/injections.js", "mobile/android/extensions/webcompat/data/ua_overrides.js", "mobile/android/extensions/webcompat/lib/custom_functions.js", "mobile/android/extensions/webcompat/manifest.json"], "git_node": null, "git_parents": [null], "node": "b8c0cc229407a41283e4500780904d419f6327e9", "parents": ["2eed5fdce27200f4596a1ce5cf7e7eaebcab160d"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1584907 - Deny internal entities closing the doctype. r=bzbarsky, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47704", "files": ["parser/expat/lib/xmlparse.c"], "git_node": null, "git_parents": [null], "node": "1ce6a051dff356f6ff60c709b8b456dfd36b5a6a", "parents": ["b8c0cc229407a41283e4500780904d419f6327e9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1583463 - Lock SourceMediaStream's mMutex also during shutdown. r=padenot, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47681", "files": ["dom/media/MediaStreamGraph.cpp"], "git_node": null, "git_parents": [null], "node": "ec90fb95c3b8d25e30ae8b9b6a7ac6d7a21983f4", "parents": ["1ce6a051dff356f6ff60c709b8b456dfd36b5a6a"], "tags": []}], "date": 1570655845, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "468": {"changesets": [{"author": "Simon Giesecke \u003csgiesecke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1558522 - Ensure that file actors created after the database was closed are expired. r=asuth, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48046", "files": ["dom/indexedDB/IDBDatabase.cpp"], "git_node": null, "git_parents": [null], "node": "edcbd5a1cf794ec807e5a847da5584322c92c72e", "parents": ["ec90fb95c3b8d25e30ae8b9b6a7ac6d7a21983f4"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1534702 - Release marionette_driver 3.0.0 and marionette_harness 5.0.0. r=ato a=test-only\n\nThis will be the last public release of both packages on PyPI.\nSee the announcement from January this year:\n\nhttps://groups.google.com/forum/#!topic/mozilla.tools.marionette/s6_03Qt2ubc\n\nIf both packages are still required by tools, they would have to\nbe self-built by a checkout of mozilla-central.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48674", "files": ["testing/marionette/client/marionette_driver/__init__.py", "testing/marionette/harness/marionette_harness/__init__.py", "testing/marionette/harness/requirements.txt"], "git_node": null, "git_parents": [null], "node": "3957d266c25eec4d8819e55132c097d76e5aa655", "parents": ["edcbd5a1cf794ec807e5a847da5584322c92c72e"], "tags": []}], "date": 1570718848, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "469": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48834", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/blocklists/plugins.json"], "git_node": null, "git_parents": [null], "node": "3f75fcc72a22e30e80177ab1c831faf036c0d59e", "parents": ["3957d266c25eec4d8819e55132c097d76e5aa655"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 1568968. Re-enable existing print telemetry for nightly, beta and release. r=chutten a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D43435", "files": ["toolkit/components/telemetry/Histograms.json"], "git_node": null, "git_parents": [null], "node": "bdcc7ff3b644fa4859b03c5e768d32087254f56f", "parents": ["3f75fcc72a22e30e80177ab1c831faf036c0d59e"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1572806 - Added profile_date parameter to Telemetry Activation Ping. r=VladBaicu, a=RyanVM\n\nProfile creation date (profile_date) is now embedded in Telemetry Activation Ping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47097", "files": ["mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryActivationPingDelegate.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryActivationPingBuilder.java"], "git_node": null, "git_parents": [null], "node": "f10977a01ff66340225e2310d8ff88bfd42ffa6b", "parents": ["bdcc7ff3b644fa4859b03c5e768d32087254f56f"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "bug 1570222 - avoid passing unrelated certificates to mozilla::pkix from NSSCertDBTrustDomain r=kjacobs a=RyanVM\n\nSummary:\nDuring path building, mozilla::pkix filters out candidate certificates provided\nby trust domains where the subject distinguished name does not match the issuer\ndistinguished name of the certificate it's trying to find an issuer for.\nHowever, if there's a problem decoding the candidate issuer certificate,\nmozilla::pkix will make a note of this error, regardless of if that certificate\nwas potentially a suitable issuer. If no trusted path is found, the error from\nthat unrelated certificate may ultimately be returned by mozilla::pkix,\nresulting in confusion.\n\nBefore this patch, NSSCertDBTrustDomain could cause this behavior by blithely\npassing every known 3rd party certificate to mozilla::pkix (other sources of\ncertificates already filter on subject distinguished name). This patch adds\nfiltering to 3rd party certificates as well.\n\nReviewers: kjacobs\n\nTags: #secure-revision\n\nBug #: 1570222\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48120", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp"], "git_node": null, "git_parents": [null], "node": "c62c32d9da65ea00ee8afd920777961fbf9697ee", "parents": ["f10977a01ff66340225e2310d8ff88bfd42ffa6b"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1577149 - Additional preferences managed by policy requested by users. r=mconley, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "e0fb019fef4a18885ea02f8ae5e82bef0037518b", "parents": ["c62c32d9da65ea00ee8afd920777961fbf9697ee"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1586845, r=dragana, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48395", "files": ["netwerk/dns/nsHostResolver.cpp"], "git_node": null, "git_parents": [null], "node": "b07f17122272ffcf922871593a119f23d92271b0", "parents": ["e0fb019fef4a18885ea02f8ae5e82bef0037518b"], "tags": []}], "date": 1570731787, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "470": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1585099 - Update cssparser on ESR68 to 0.25.5 to avoid warning that became a hard error. r=heycam, a=RyanVM\n\nThe changes look big because of the reformatting, but this should be ok, I'd\nthink.\n\nI could've manually cherry-picked the particular fix and used [patch] or\nsomething, but the particular commit didn't apply cleanly and I think it's\nbetter to just update to a published version.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47796", "files": ["Cargo.lock", "third_party/rust/cssparser/.cargo-checksum.json", "third_party/rust/cssparser/Cargo.toml", "third_party/rust/cssparser/build.rs", "third_party/rust/cssparser/build/match_byte.rs", "third_party/rust/cssparser/src/color.rs", "third_party/rust/cssparser/src/cow_rc_str.rs", "third_party/rust/cssparser/src/from_bytes.rs", "third_party/rust/cssparser/src/lib.rs", "third_party/rust/cssparser/src/macros.rs", "third_party/rust/cssparser/src/nth.rs", "third_party/rust/cssparser/src/parser.rs", "third_party/rust/cssparser/src/rules_and_declarations.rs", "third_party/rust/cssparser/src/serializer.rs", "third_party/rust/cssparser/src/size_of_tests.rs", "third_party/rust/cssparser/src/tests.rs", "third_party/rust/cssparser/src/tokenizer.rs", "third_party/rust/cssparser/src/unicode_range.rs"], "git_node": null, "git_parents": [null], "node": "f0020f5178324beb51754fccacfbaa1610bbc266", "parents": ["b07f17122272ffcf922871593a119f23d92271b0"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1528961 - Whitelist AddonPolicy leak in web sockets wpt tests. r=jgraham, a=test-only", "files": ["testing/web-platform/meta/websockets/binary/__dir__.ini", "testing/web-platform/meta/websockets/constructor/__dir__.ini"], "git_node": null, "git_parents": [null], "node": "272fadd2186dc345868423eaa5b3896da4932102", "parents": ["f0020f5178324beb51754fccacfbaa1610bbc266"], "tags": []}], "date": 1570807097, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "471": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1586909 - Process anchor suppressions even when ignoring adjustments. r=dholbert, a=lizzard\n\nOtherwise we may keep the scroll anchor around and we may try to anchor to it\nlater even though we should've really suppressed it completely.\n\nMaybe we should just call InvalidateAnchor() unconditionally from that code\npath, even if there are no suppressions pending...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48456\n\nSigned-off-by: Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "files": ["layout/generic/ScrollAnchorContainer.cpp", "testing/web-platform/tests/css/css-scroll-anchoring/heuristic-with-offset-update-from-scroll-event-listener.html"], "git_node": null, "git_parents": [null], "node": "18ed5d5a087dbd0a16780de037481813f7a58ab7", "parents": ["272fadd2186dc345868423eaa5b3896da4932102"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1567600 - Part 1: Better accessibility for about:addons list view. r=flod,Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40505", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/mozapps/extensions/content/aboutaddons.html", "toolkit/mozapps/extensions/content/aboutaddons.js", "toolkit/mozapps/extensions/test/browser/browser_html_detail_view.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view.js", "toolkit/mozapps/extensions/test/browser/browser_reinstall.js", "toolkit/mozapps/extensions/test/browser/browser_updateid.js", "toolkit/mozapps/extensions/test/browser/head.js"], "git_node": null, "git_parents": [null], "node": "c3e8ea1b501884e9ef2aa2bf9144ddfa23622144", "parents": ["18ed5d5a087dbd0a16780de037481813f7a58ab7"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1567600 - Part 2: Better accessibility for about:addons panel-list. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40506", "files": ["toolkit/mozapps/extensions/content/aboutaddons.html", "toolkit/mozapps/extensions/content/aboutaddons.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view.js"], "git_node": null, "git_parents": [null], "node": "75f9e30366c9efadcc7663e14c4decf6b6cba064", "parents": ["c3e8ea1b501884e9ef2aa2bf9144ddfa23622144"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1567600 - Part 3: Better accessibility for named-deck and about:addons detail view. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D42370", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/mozapps/extensions/content/aboutaddons.html", "toolkit/mozapps/extensions/content/aboutaddons.js", "toolkit/mozapps/extensions/content/extensions.js", "toolkit/mozapps/extensions/content/named-deck.js", "toolkit/mozapps/extensions/test/browser/browser_html_detail_view.js", "toolkit/mozapps/extensions/test/browser/browser_html_updates.js"], "git_node": null, "git_parents": [null], "node": "8e08ea56de2674169703c291e5542293bdfe1a2f", "parents": ["75f9e30366c9efadcc7663e14c4decf6b6cba064"], "tags": []}, {"author": "Vlad Baicu \u003cvlad.baicu@softvision.ro\u003e", "branch": "default", "desc": "Bug 1586770 - Fix activity stream invalid viewholders crash. r=petru, a=RyanVM\n\nDisable predictive animations. There is a bug in RecyclerView which causes views that\nare being reloaded to pull invalid ViewHolders from the internal recycler stack if the\nadapter size has decreased since the ViewHolder was recycled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48929", "files": ["mobile/android/base/java/org/mozilla/gecko/activitystream/homepanel/ActivityStreamPanel.java", "mobile/android/base/java/org/mozilla/gecko/activitystream/homepanel/NpaLinearLayoutManager.java"], "git_node": null, "git_parents": [null], "node": "d0f3a90a4f8dc05566d2e771638ec7090d3d9372", "parents": ["8e08ea56de2674169703c291e5542293bdfe1a2f"], "tags": []}], "date": 1570821122, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "472": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1585380 - Add an enhancedSearchVersion core telemetry ping value, and enhanced-search-control experiment branch. r=sebastian,miketaylr, a=RyanVM\n\nUpdate the Webcompat system addon on the ESR branch to 6.3.0, including updates to Fennec required for the Enhanced Search experiment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48432", "files": ["browser/extensions/webcompat/data/ua_overrides.js", "browser/extensions/webcompat/experiment-apis/sharedPreferences.js", "browser/extensions/webcompat/experiment-apis/sharedPreferences.json", "browser/extensions/webcompat/lib/ua_overrides.js", "browser/extensions/webcompat/manifest.json", "mobile/android/base/java/org/mozilla/gecko/Experiments.java", "mobile/android/base/java/org/mozilla/gecko/GeckoApp.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryCorePingBuilder.java", "mobile/android/extensions/webcompat/data/ua_overrides.js", "mobile/android/extensions/webcompat/experiment-apis/sharedPreferences.js", "mobile/android/extensions/webcompat/experiment-apis/sharedPreferences.json", "mobile/android/extensions/webcompat/lib/ua_overrides.js", "mobile/android/extensions/webcompat/manifest.json"], "git_node": null, "git_parents": [null], "node": "570d88f295c3820e388df8615a027473f9d31430", "parents": ["d0f3a90a4f8dc05566d2e771638ec7090d3d9372"], "tags": []}, {"author": "Vlad Baicu \u003cvlad.baicu@softvision.ro\u003e", "branch": "default", "desc": "Bug 1587631 - Add FxA entrypoint option for panel configurations. r=petru, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48932", "files": ["mobile/android/base/java/org/mozilla/gecko/firstrun/FirstrunPagerConfig.java", "mobile/android/base/java/org/mozilla/gecko/firstrun/FirstrunPanel.java", "mobile/android/base/java/org/mozilla/gecko/firstrun/LastPanel.java", "mobile/android/base/java/org/mozilla/gecko/firstrun/LocalFirstRunPanelProvider.java", "mobile/android/base/java/org/mozilla/gecko/firstrun/PanelConfig.java", "mobile/android/base/java/org/mozilla/gecko/firstrun/SendTabPanel.java"], "git_node": null, "git_parents": [null], "node": "877711d74e9b8038e04c0cd0bd63782352121edf", "parents": ["570d88f295c3820e388df8615a027473f9d31430"], "tags": []}, {"author": "Vlad Baicu \u003cvlad.baicu@softvision.ro\u003e", "branch": "default", "desc": "Bug 1572520 - Fix preferences store for the activation ping distribution id. r=petru, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48077", "files": ["mobile/android/base/java/org/mozilla/gecko/telemetry/TelemetryActivationPingDelegate.java", "mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryActivationPingBuilder.java"], "git_node": null, "git_parents": [null], "node": "e00b767e4a9c35a68156ebf3f8447435fa3188b2", "parents": ["877711d74e9b8038e04c0cd0bd63782352121edf"], "tags": []}, {"author": "Vlad Baicu \u003cvlad.baicu@softvision.ro\u003e", "branch": "default", "desc": "Bug 1572530 - Fix client id field to match backend validation schema. r=petru, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48076", "files": ["mobile/android/base/java/org/mozilla/gecko/telemetry/pingbuilders/TelemetryActivationPingBuilder.java"], "git_node": null, "git_parents": [null], "node": "44b626af52501e0f53f5558eeb739e7a1823e477", "parents": ["e00b767e4a9c35a68156ebf3f8447435fa3188b2"], "tags": []}], "date": 1570825699, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "473": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1558289 - Dispatch accessibility focus events when focusing hovered node. r=geckoview-reviewers,snorp a=RyanVM\n\nThis patch works around a case where the node that we want to set a11y\nfocus to is input focused, and the gecko a11y virtual cursor is set to\nit.\n\nIn gecko a11y we don't have a distinction of hover/a11y focus like in\nAndroid, the virtual cursor is already set to the position through the\nexplore by touch and sends a HOVER_ENTER to android. An accessibility\nservice will typically listen for thos events and then explicitly\nrequest a11y focus on the node. Since it is internally already set, it\nwould result in a no-op and no event will be dispatched.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36141", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/SessionAccessibility.java"], "git_node": null, "git_parents": [null], "node": "cceca249dbd203a6d76a4036649d3c7484785d62", "parents": ["44b626af52501e0f53f5558eeb739e7a1823e477"], "tags": []}], "date": 1571059929, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "474": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1475994 - Add tests for the mingw clang build. r=jmaher, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38032", "files": ["taskcluster/ci/test/test-platforms.yml", "taskcluster/ci/test/test-sets.yml", "taskcluster/ci/test/xpcshell.yml", "taskcluster/taskgraph/transforms/tests.py"], "git_node": null, "git_parents": [null], "node": "359802c2d528460c68a84b15f85e3b8bd433ebc4", "parents": ["cceca249dbd203a6d76a4036649d3c7484785d62"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1585276 - limit page numbers in print preview, r=mconley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47848", "files": ["toolkit/components/printing/content/printPreviewToolbar.js"], "git_node": null, "git_parents": [null], "node": "6fa718b5a3d6bce2a644c2a285010200ec8337b3", "parents": ["359802c2d528460c68a84b15f85e3b8bd433ebc4"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D49175", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "74edcd84332d59fbc7e9b5eb5cb483881085a389", "parents": ["6fa718b5a3d6bce2a644c2a285010200ec8337b3"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1578341 - MultipartBlobImpl must exclude empty Blobs when creating the inputStream, r=smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D44849", "files": ["dom/file/MultipartBlobImpl.cpp"], "git_node": null, "git_parents": [null], "node": "02f312045c0b930686fdad4abf3cff5604ce7ce6", "parents": ["74edcd84332d59fbc7e9b5eb5cb483881085a389"], "tags": ["FENNEC_68_2b7_BUILD1", "FENNEC_68_2b7_RELEASE"]}], "date": 1571070996, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "475": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 02f312045c0b930686fdad4abf3cff5604ce7ce6 with FENNEC_68_2b7_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "c7754c3b59818aa8717856a226cb1dccf86bef1b", "parents": ["02f312045c0b930686fdad4abf3cff5604ce7ce6"], "tags": []}], "date": 1571087161, "git_changesets": [null], "user": "ffxbld"}, "476": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 02f312045c0b930686fdad4abf3cff5604ce7ce6 with FENNEC_68_2b7_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "553017bd6ca68cb924b7fb51d8e4ea324d8fa01f", "parents": ["c7754c3b59818aa8717856a226cb1dccf86bef1b"], "tags": []}, {"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release DONTBUILD", "files": ["mobile/android/config/version-files/beta/version_display.txt"], "git_node": null, "git_parents": [null], "node": "e7b69fd2db75029ca7f2659a09feabac6bab10d1", "parents": ["553017bd6ca68cb924b7fb51d8e4ea324d8fa01f"], "tags": []}], "date": 1571154680, "git_changesets": [null, null], "user": "ffxbld"}, "477": {"changesets": [{"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1580649 - Document Fennec's FxA \"Sign in\" button telemetry events. r=VladBaicu, a=RyanVM\n\nBug 1570880 added \"Sign up\" and \"Sign in\" buttons to Fennec's AwesomeScreen and UI telemetry events measuring how frequently these buttons are used. We already collect FxA UI telemetry when users sign in from Fennec's first-run Onboarding screens or the Settings menu. This patch documents all of these FxA UI telemetry events.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48482", "files": ["mobile/android/docs/uitelemetry.rst"], "git_node": null, "git_parents": [null], "node": "3eae025d6aeb250df8517ebc3401ddb7da01d8ba", "parents": ["e7b69fd2db75029ca7f2659a09feabac6bab10d1"], "tags": []}, {"author": "Brendan Dahl \u003cbrendan.dahl@gmail.com\u003e", "branch": "default", "desc": "Bug 1563295 - Only rebuild native menu when specific elements added. r=mstange a=RyanVM\n\nThe menuitem custom element inserts nodes when rendered. These nodes are\nnot related to the structure of the menu, but were causing nsMenuItemX\nto mark the menu as needing a rebuild. The rebuild would remove all items\nfrom the menu which caused the removal of the special menu items \"Start\nDictation\" and \"Emoji and Symbols\" that are automatically added by MacOS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45420", "files": ["widget/cocoa/nsMenuItemX.mm"], "git_node": null, "git_parents