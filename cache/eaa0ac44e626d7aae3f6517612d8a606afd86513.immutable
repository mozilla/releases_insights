.mozilla.com/D42123", "files": ["devtools/client/jsonview/components/Headers.js", "devtools/client/jsonview/components/HeadersToolbar.js", "devtools/client/jsonview/components/JsonToolbar.js", "devtools/client/jsonview/components/MainTabbedArea.js", "devtools/client/jsonview/components/SearchBox.js", "devtools/client/jsonview/components/TextToolbar.js", "devtools/client/jsonview/converter-child.js"], "git_node": null, "git_parents": [null], "node": "0695f4d489808ea2d1456e1f69da324979da79ac", "parents": ["2fba8a40abccd77aa403d35fb8d094b560690525"], "tags": []}], "date": 1568253209, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "328": {"changesets": [{"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1547519 - Rename NS_STRINGIFY to MOZ_STRINGIFY, move to mfbt, and unify stragglers. r=glandium, a=RyanVM", "files": ["dom/media/gmp/ChromiumCDMAdapter.cpp", "dom/media/mediasource/ContainerParser.cpp", "dom/media/mp4/MoofParser.cpp", "extensions/pref/autoconfig/src/nsReadConfig.cpp", "gfx/gl/GLLibraryEGL.cpp", "mfbt/HelperMacros.h", "mfbt/moz.build", "modules/libpref/Preferences.cpp", "toolkit/components/backgroundhangmonitor/BackgroundHangMonitor.cpp", "toolkit/components/resistfingerprinting/nsRFPService.cpp", "toolkit/profile/nsToolkitProfileService.cpp", "toolkit/xre/nsAppRunner.cpp", "tools/profiler/core/platform.cpp", "xpcom/base/nscore.h", "xpcom/build/Omnijar.cpp", "xpcom/tests/gtest/TestTokenizer.cpp"], "git_node": null, "git_parents": [null], "node": "b0dba8263bdaabdb86e14b3a7f2a7a93c91ca2c6", "parents": ["0695f4d489808ea2d1456e1f69da324979da79ac"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1547519 - Fix jemalloc redirections for MinGW build. r=glandium, a=RyanVM\n\nIn the MinGW build, calls to malloc inside mozglue were not being\nredirected as defined in the .def file. We create aliases for the\nredirected functions to correctly redirect them inside mozglue.\n\nAn alternate solution for this exists. Rather than creating the\nimportlib during the linking step for mozglue, we could have used\ndlltool to create it, and then provided it during linking. This\nwould allow mozglue to know that it should redirect calls to malloc\nto je_malloc as specified in the .def file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38407", "files": ["memory/build/mozjemalloc.cpp", "memory/build/mozmemory_wrap.cpp"], "git_node": null, "git_parents": [null], "node": "6acd9fa1e589bcbcfcee9e881d9df6921d954835", "parents": ["b0dba8263bdaabdb86e14b3a7f2a7a93c91ca2c6"], "tags": []}], "date": 1568253738, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "329": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nan -\u003e d38f477c0190\nar -\u003e d3823c6ec096\nast -\u003e c191edb14c3b\naz -\u003e 718af5499981\nbe -\u003e 1d889f83b30f\nbg -\u003e 7ea6c6631cfe\nbn -\u003e 2d837280bf54\nbr -\u003e f82a80cca70e\nbs -\u003e 0482def4e85f\nca -\u003e 7ceecba3676b\ncak -\u003e ee18a42bc36e\ncs -\u003e 1802d2feb8aa\ncy -\u003e 9ed1b7d130a6\nda -\u003e 422fc5fcd34d\nde -\u003e dc513febb67e\ndsb -\u003e b7b65cf83fa5\nel -\u003e 13f5815c6577\nen-CA -\u003e ede4a95f799f\nen-GB -\u003e 1b10ef35df38\neo -\u003e 6075c7f70de8\nes-AR -\u003e c9fb678e5e41\nes-CL -\u003e 1be27907cf23\nes-ES -\u003e 95c0db40631b\nes-MX -\u003e a4b8a5cdde0f\net -\u003e 4fdc87b7fa72\neu -\u003e 3b1fad91785f\nfa -\u003e 9b6dac2f0646\nff -\u003e fb27bbb6cfeb\nfi -\u003e 28df5861dc99\nfr -\u003e 355e99a3bbd8\nfy-NL -\u003e 5ca4dea57171\nga-IE -\u003e bdff02b7f21c\ngd -\u003e 76f29d80f616\ngl -\u003e 08800587b3be\ngn -\u003e 610bab5b7e06\ngu-IN -\u003e c0b6d27e194a\nhe -\u003e ff01a7855eb2\nhi-IN -\u003e 7b96dff21885\nhr -\u003e bf403d80dd33\nhsb -\u003e d24c31710694\nhu -\u003e 424e26da8834\nhy-A