"date": 1569913231, "git_changesets": [null], "user": "ffxbld"}, "429": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 4ce4d8ccc5c09426914b3fda55027954760a8755 with FENNEC_68_2b5_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "acb61c72eb699b8b7a565fb77667a31c08949128", "parents": ["42a3ed18b9d96ae37741e5c3039c12f2eb1643a9"], "tags": []}, {"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release DONTBUILD", "files": ["mobile/android/config/version-files/beta/version_display.txt"], "git_node": null, "git_parents": [null], "node": "8aadabdaf548e5e74626159b431ff153d31a43df", "parents": ["acb61c72eb699b8b7a565fb77667a31c08949128"], "tags": []}], "date": 1569944985, "git_changesets": [null, null], "user": "ffxbld"}, "430": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1574252 - Run Windows ASAN builds and tests on all branches. r=dmajor, a=npotb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47636", "files": ["taskcluster/ci/build/windows.yml"], "git_node": null, "git_parents": [null], "node": "e5b1af4ab26b38f0236c11471a2c19fe3188e3c3", "parents": ["8aadabdaf548e5e74626159b431ff153d31a43df"], "tags": []}, {"author": "Vlad Baicu \u003cvlad.baicu@softvision.ro\u003e", "branch": "default", "desc": "Bug 1585132 - Fix lint failures from sign up button patches. r=petru, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47778", "files": ["mobile/android/app/src/main/res/drawable-nodpi/firstrun_account.png", "mobile/android/base/locales/en-US/android_strings.dtd", "mobile/android/base/strings.xml.in"], "git_node": null, "git_parents": [null], "node": "e1ccd88fb23ba9c7fe002877bc58b8b3d132cdf6", "parents": ["e5b1af4ab26b38f0236c11471a2c19fe3188e3c3"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1578856 - browser.fixup.dns_first_for_single_words and the keyword-uri-fixup UI are broken. r=adw, a=RyanVM", "files": ["browser/base/content/browser.js", "browser/components/urlbar/UrlbarInput.jsm", "browser/components/urlbar/UrlbarPrefs.jsm", "browser/components/urlbar/UrlbarUtils.jsm", "browser/components/urlbar/tests/browser/browser.ini", "browser/components/urlbar/tests/browser/browser_dns_first_for_single_words.js", "browser/components/urlbar/tests/browser/browser_urlbarSearchSingleWordNotification.js", "browser/components/urlbar/tests/legacy/browser.ini", "docshell/test/browser/browser_uriFixupAlternateRedirects.js", "docshell/test/browser/browser_uriFixupIntegration.js"], "git_node": null, "git_parents": [null], "node": "89110e1502b497f62a07c6f492eb710a76d9263f", "parents": ["e1ccd88fb23ba9c7fe002877bc58b8b3d132cdf6"], "tags": []}, {"author": "Johann Hofmann \u003cjhofmann@mozilla.com\u003e", "branch": "default", "desc": "Bug 1571234 - Change RemoveCookiesFromRootDomain to RemoveCookiesFromExactHost. r=baku a=RyanVM\n\nThis will change RemoveCookiesFromRootDomain to not remove cookies from all sub-domains but instead\nonly remove the single host that is passed. This is necessary to support removing all sub-domain\ncookie data in ForgetAboutSite without compromising on the cookie permissions that are supported by\nSanitizer.jsm\n\nAs a side effect, this also fixes the issues described in https://bugzilla.mozilla.org/show_bug.cgi?id=1515913#c24\n(which were caused by deleting sub-domains without checking their permission).\n\nSanitizer.jsm should retain its functionality even with this change, because it already collects\nall the principals we have to delete individually and tries to delete them (so it would consider\nmozilla.org and support.mozilla.org separately).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45012", "files": ["netwerk/cookie/nsCookieService.cpp", "netwerk/cookie/nsCookieService.h", "netwerk/cookie/nsICookieManager.idl", "toolkit/components/cleardata/ClearDataService.jsm"], "git_node": null, "git_parents": [null], "node": "abf80e225448641b0d83910fe1e0a411f5b6795c", "parents": ["89110e1502b497f62a07c6f492eb710a76d9263f"], "tags": []}, {"author": "Johann Hofmann \u003cjhofmann@mozilla.com\u003e", "branch": "default", "desc": "Bug 1571234 - Manually collect hosts to delete cookies from in ForgetAboutSite. r=baku a=RyanVM\n\nThis is made necessary because ClearDataService will not delete sub-domains anymore. It\ndidn't correctly delete base domains before either, so we just switch to collecting the\ncorrect hosts entirely outside of ClearDataService.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45013", "files": ["toolkit/forgetaboutsite/ForgetAboutSite.jsm", "toolkit/forgetaboutsite/test/browser/browser_cookieDomain.js"], "git_node": null, "git_parents": [null], "node": "3d656f297a65a111c8195ac241d4233c23bff916", "parents": ["abf80e225448641b0d83910fe1e0a411f5b6795c"], "tags": []}, {"author": "Rob Thijssen \u003crthijssen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1582726 - use cafile from certifi when available r=dustin a=bustage-fix\n\npython's `urllib.request.urlopen(url)` can fail when a system doesn't know how to verify a ca certificate. this patch makes use of the cafile provided by the `certifi` module, if/when it is installed, to verify certificates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47044", "files": ["taskcluster/scripts/misc/fetch-content"], "git_node": null, "git_parents": [null], "node": "5fa2e5f55a69dea6dddc08375e35199c4a892f77", "parents": ["3d656f297a65a111c8195ac241d4233c23bff916"], "tags": []}], "date": 1569947996, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "431": {"changesets": [{"author": "Ricky Stewart 