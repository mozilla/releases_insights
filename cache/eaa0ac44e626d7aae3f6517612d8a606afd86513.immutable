], "node": "750758879fc3ddbaed66678f109ef65f48cafc78", "parents": ["034ca4debea253fcb9e8c8e3c25baf3acd20c1a6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1578933 - Run scroll anchoring adjustments when blocking script. r=dholbert a=RyanVM\n\nI wanted to fix the more general problem and script-block more of\nFlushPendingNotifications, but simple attempts to do that have resulted in\nterribly orange try runs with very bizarre failures, so in the \"perfect is the\nenemy of good\" spirit, fix the issue at hand (scroll anchoring adjustments not\ndealing with layout reentering beneath them) by running them while\nscript-blocked, which is the right thing to do anyway.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47256", "files": ["layout/base/PresShell.cpp", "testing/web-platform/meta/css/css-scroll-anchoring/anchoring-with-bounds-clamping-div.html.ini"], "git_node": null, "git_parents": [null], "node": "c4f133b69add9e5d394aa1f7056afd0b2291fa11", "parents": ["750758879fc3ddbaed66678f109ef65f48cafc78"], "tags": []}], "date": 1569852473, "git_changesets": [null, null, null], "user": "archaeopteryx@coole-files.de"}, "422": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47598", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "e5ac44b74045913396db258c8887dbd7a87b4bd0", "parents": ["c4f133b69add9e5d394aa1f7056afd0b2291fa11"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1474041 - Wait for browser.windows.create instead of onCreated. r=rpl, a=test-only\n\nThe browser.windows.onCreated event is triggered before\nbrowser.windows.create returns. Waiting until browser.windows.create has\nresolved may resolve the memory leak from bug 1474041.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47106", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_ntp_colors_perwindow.js"], "git_node": null, "git_parents": [null], "node": "6cd4301ea11c01c77d94450edd7051f94e2d492a", "parents": ["e5ac44b74045913396db258c8887dbd7a87b4bd0"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1581206 - Reconvert browser_bug629172.js to mochitest. r=Ehsan, a=test-only\n\nCurrently, we can use chrome process's shortcut key with\n`EventUtils.synthesizeKey()` with enabling `\"test.events.async.enabled\"` pref.\nSo, we should reconvert it to a mochitest for making it more stable.\n\nOddly, when I try to run this test as test-verify on macOS, it permanently\nfails rendering resizer of `\u003ctextarea\u003e` elements immediately after creation.\nTherefore, this patch disables this test in test-verify on macOS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D46578", "files": ["editor/libeditor/tests/browser.ini", "editor/libeditor/tests/browser_bug629172.js", "editor/libeditor/tests/bug629172.html", "editor/libeditor/tests/mochitest.ini", "editor/libeditor/tests/test_bug629172.html"], "git_node": null, "git_parents": [null], "node": "2a560900197e044d54719e980a0caaa64958062b", "parents": ["6cd4301ea11c01c77d94450edd7051f94e2d492a"], "tags": []}], "date": 1569853518, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "423": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1575681 - Add new test which was lost in the uplift. r+a=me", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policy_passwordmanager.js"], "git_node": null, "git_parents": [null], "node": "4ce4d8ccc5c09426914b3fda55027954760a8755", "parents": ["2a560900197e044d54719e980a0caaa64958062b"], "tags": ["FENNEC_68_2b5_BUILD1", "FENNEC_68_2b5_RELEASE"]}], "date": 1569853748, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "424": {"changesets": [{"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Backed out 2 changesets (bug 1575681) for browser chrome failures on browser_policy_passwordmanager.js. a=backout\n\nBacked out changeset 4ce4d8ccc5c0 (bug 1575681)\nBacked out changeset 034ca4debea2 (bug 1575681)", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_block_about.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_passwordmanager.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "5251100ea091ef3e88c06abdade44beea0590c30", "parents": ["4ce4d8ccc5c09426914b3fda55027954760a8755"], "tags": []}, {"author": "Vlad Baicu \u003cvlad.baicu@softvision.ro\u003e", "branch": "default", "desc": "Bug 1576170 - Sign in strings for Onboarding & Activity Stream. r=petru a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D43245", "files": ["mobile/android/app/lint.xml", "mobile/android/base/locales/en-US/android_strings.dtd", "mobile/android/base/strings.xml.in"], "git_node": null, "git_parents": [null], "node": "903a5ee0bdbb5fe433b458af422b4fd37e7ebd76", "parents": ["5251100ea091ef3e88c06abdade44beea0590c30"], "tags": []}, {"author": "Vlad Baicu \u003cvlad.baicu@softvision.ro\u003e", "branch": "default", "desc": "Bug 1576170 - Relocate the localization note above the strings for consistency. r=flod a=RyanVM\n\nDifferential 