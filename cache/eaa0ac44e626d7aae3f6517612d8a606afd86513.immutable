nents/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "a72213de3eb894b01d5b6ff21c0bd9a83fe92658", "parents": ["59b26012d5306df7e1be01242c3fe0d49c78b596"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1575681 - Add policy to remove access to the password manager. r=MattN,fluent-reviewers,flod a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D43673", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_block_about.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_passwordmanager.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "861b54de75703710aba671eaa6dbd8d15fd2d900", "parents": ["a72213de3eb894b01d5b6ff21c0bd9a83fe92658"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1577944 - Avoid calling CERT_NewTempCertificate in NSSCertDBTrustDomain::GetCertTrust for enterprise certificates. r=jcj,kjacobs a=RyanVM\n\nCalling CERT_NewTempCertificate on an enterprise certificate is inefficient\nbecause NSS tries (and fails) to find a copy of that certificate in its internal\ndata structures (which includes querying softoken, which involves hitting the\ndisk). We can avoid doing so for these certificates in\nNSSCertDBTrustDomain::GetCertTrust because we already know what trust values\nthey should have (after checking the relevant blocklists).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D45588", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp", "security/certverifier/NSSCertDBTrustDomain.h", "security/manager/ssl/CSTrustDomain.cpp"], "git_node": null, "git_parents": [null], "node": "e7b03786bc007e538fa2a5bd100f9251edceafae", "parents": ["861b54de75703710aba671eaa6dbd8d15fd2d900"], "tags": []}, {"author": "Landry Breuil \u003clandry@openbsd.org\u003e", "branch": "default", "desc": "Bug 1579323 - Reenable sandbox by default on OpenBSD. r=froydnj a=RyanVM\n\nThis was broken by bug 1375863", "files": ["old-configure.in"], "git_node": null, "git_parents": [null], "node": "86981b66c0ce813515653d57f9e4651981174f07", "parents": ["e7b03786bc007e538fa2a5bd100f9251edceafae"], "tags": []}], "date": 1569420333, "git_changesets": [null, null, null, null, null, null], "user": "csabou@mozilla.com"}, "401": {"changesets": [{"author": "Coroiu Cristina \u003cccoroiu@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset e7b03786bc00 (bug 1577944) for build bustage at security/certverifier/NSSCertDBTrustDomain.cpp", "files": ["security/certverifier/NSSCertDBTrustDomain.cpp", "security/certverifier/NSSCertDBTrustDomain.h", "security/manager/ssl/CSTrustDomain.cpp"], "git_node": null, "git_parents": [null], "node": "3d0cfdc3894b01bb3f1ef035c8cb3e6816502d8f", "parents": ["86981b66c0ce813515653d57f9e4651981174f07"], "tags": []}], "date": 1569422904, "git_changesets": [null], "user": "ccoroiu@mozilla.com"}, "402": {"changesets": [{"author": "Coroiu Cristina \u003cccoroiu@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 861b54de7570 (bug 1575681) for browser-chrome failures at browser/components/enterprisepolicies/tests/browser/browser_policy_block_about.js a=backout", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterpr