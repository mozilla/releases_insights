ags": []}], "date": 1581454449, "git_changesets": [null], "user": "ffxbld"}, "861": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ncak -\u003e c506de4a49f7\nes-ES -\u003e 8a31761b4544\nes-MX -\u003e fe893cffa03f\neu -\u003e 91d2dc503db6\nit -\u003e b04d19a5d1dc\nkab -\u003e 8865ee6c1918\nko -\u003e 90eaa4249010\nsk -\u003e b143d8439595", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "5acedc71a0d979111b9f8c549d6977720d2cdb9c", "parents": ["0621824137f093e521939fb0731a601aad4149ef"], "tags": []}], "date": 1581490525, "git_changesets": [null], "user": "ffxbld"}, "862": {"changesets": [{"author": "Wander Lairson Costa \u003cwander.lairson@gmail.com\u003e", "branch": "default", "desc": "Bug 1609568: request less parallelism for all gcc linux build r=#build a=Aryx\n\n\nIn GCP we have the double the number of core compared to AWS\ncounterparts, but we use the same amount of memory. Request the builds\nto be less parallel to avoid OOM.\n\nDifferential Revision: https://phabricator.services.mozilla.com//D62514", "files": ["taskcluster/ci/build/linux.yml"], "git_node": null, "git_parents": [null], "node": "f8c580e22738cb7ae9a01a1f0c5248f60b95b1f1", "parents": ["5acedc71a0d979111b9f8c549d6977720d2cdb9c"], "tags": []}, {"author": "Wander Lairson Costa \u003cwander.lairson@gmail.com\u003e", "branch": "default", "desc": "Bug 1614855: Run valgrind builds in AWS r=froydnj a=Aryx\n\n\nGCE instances use Ubuntu 18.04, which is known to cause issues in\nvalgrind builds (Bug 1545094), while EC2 uses Ubuntu 14.04.\n\nMove valgrind builds back to GCE to avoid perma fail of these jobs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D62552", "files": ["taskcluster/ci/valgrind/kind.yml"], "git_node": null, "git_parents": [null], "node": "bf3997e896c08edf066e08a4055f1f70d2e60227", "parents": ["f8c580e22738cb7ae9a01a1f0c5248f60b95b1f1"], "tags": []}], "date": 1581523683, "git_changesets": [null, null], "user": "dluca@mozilla.com"}, "863": {"changesets": [{"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1521363 - Fix timing issue in tabs events test. r=robwu, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39786", "files": ["browser/components/extensions/test/browser/browser_ext_tabs_events.js"], "git_node": null, "git_parents": [null], "node": "1d5073e64d75273808a35a400bc489d88725c587", "parents": ["bf3997e896c08edf066e08a4055f1f70d2e60227"], "tags": []}, {"author": "Dragana Damjanovic \u003cdd.mozilla@gmail.com\u003e", "branch": "default", "desc": "Bug 1613943 - BeaconStreamListener::OnStartRequest should not set an network error. network code will interpret that as a real network error and close a connection immediately. r=bzbarsky, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D62129", "files": ["dom/base/Navigator.cpp"], "git_node": null, "git_parents": [null], "node": "07dc3b6a26424648af398b78db76d262d66bc323", "parents": ["1d5073e64d75273808a35a400bc489d88725c587"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1592078: Grab stack copies of mPCObserver to ensure it stays in scope. r=jib, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D58377", "files": ["media/webrtc/signaling/src/peerconnection/PeerConnectionImpl.cpp"], "git_node": null, "git_parents": [null], "node": "221d3b7d9c32ba6b01b3898875661a151edc9108", "parents": ["07dc3b6a26424648af398b78db76d262d66bc323"], "tags": []}], "date": 1581538115, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "864": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fenne