ity/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "1a6945d1750ce8716c2f7f89fed366133687b3c8", "parents": ["3054e0842e993a3e105607105c1273bbf8ce52d4"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1612636: Tidy up TryAttachSpecialCaseNative. r=jandem, a=RyanVM", "files": ["js/src/jit/CacheIR.cpp", "js/src/jit/CacheIR.h"], "git_node": null, "git_parents": [null], "node": "9b4ac33bddadbfdbf3c272ec219c56e4deacefe6", "parents": ["1a6945d1750ce8716c2f7f89fed366133687b3c8"], "tags": []}], "date": 1583170616, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "927": {"changesets": [{"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1610844 - Store xpi install triggering url into the addon db when available. r=mixedpuppy, a=RyanVM\n\nThis patch ensures that we store in the addon db the url that has triggered an xpi file to install,\nwhen available (e.g. when the xpi file installation has been triggered from a website using the\ninstallTrigger or mozAddonManager APIs, or when a webpage is navigated to an xpi file url).\n\nThe url collected is never sent as part of the addons telemetry events, but in a follow up patch\nit is going to be included in the data submitted for an abuse report of the related addon.\n\n(Patch rebased and small tweaks applied to make it apply cleanly on ESR68)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D64634", "files": ["toolkit/mozapps/extensions/AddonManager.jsm", "toolkit/mozapps/extensions/addonManager.js", "toolkit/mozapps/extensions/amContentHandler.jsm", "toolkit/mozapps/extensions/amInstallTrigger.jsm", "toolkit/mozapps/extensions/amWebAPI.jsm", "toolkit/mozapps/extensions/internal/AddonTestUtils.jsm", "toolkit/mozapps/extensions/test/browser/browser_webapi_install.js", "toolkit/mozapps/extensions/test/xpinstall/browser_amosigned_trigger.js", "toolkit/mozapps/extensions/test/xpinstall/browser_amosigned_url.js", "toolkit/mozapps/extensions/test/xpinstall/browser_containers.js", "toolkit/mozapps/extensions/test/xpinstall/browser_datauri.js", "toolkit/mozapps/extensions/test/xpinstall/browser_privatebrowsing.js"], "git_node": null, "git_parents": [null], "node": "cc1a281e9ed54acead1f4420f14768644bca1029", "parents": ["9b4ac33bddadbfdbf3c272ec219c56e4deacefe6"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1610844 - Submit the xpi install triggering url as part of submitted abuse reports. r=mixedpuppy, a=RyanVM\n\nThis patch adds the \"xpi install triggering url\" to the data submitted using the Firefox integrated abuse report\n(The data review related to the additional addon_install_source_url property is attached to the bugzilla issue).\n\n(Patch rebased and small tweaks applied to make it apply cleanly on ESR68)\n\nDepends on D64634\n\nDifferential Revision: https://phabricator.services.mozilla.com/D64635", "files": ["toolkit/mozapps/extensions/AbuseReporter.jsm", "toolkit/mozapps/extensions/test/xpcshell/test_AbuseReporter.js"], "git_node": null, "git_parents": [null], "node": "02d601aa6cb8d9259e548011522e0012ec6b08a4", "parents": ["cc1a281e9ed54acead1f4420f14768644bca1029"], "tags": ["FENNEC_68_6_0_BUILD1", "FIREFOX_68_6_0esr_BUILD1"]}], "date": 1583174106, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "928": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 02d601aa6cb8d9259e548011522e0012ec6b08a4 with FENNEC_68_6_0_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "814e98f13e4ae5eb5d14ccc9e37ef4264b9c557d", "parents": ["02d601aa6cb8d9259e548011522e0012ec6b08a4"], "tags": []}], "date": 1583187921, "git_changesets": [null], "user": "ffxbld"}, "929": {"chang