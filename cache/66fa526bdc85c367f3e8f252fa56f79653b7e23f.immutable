s:36540:"{
"lastpushid": 1568,
"pushes": {"367": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 36d2dde067333d0c181cb8e21b12b73c307575db with FIREFOX_115_11_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "386fceaaa72dc7893f5dedea05966c7f1e0d25b0", "parents": ["36d2dde067333d0c181cb8e21b12b73c307575db"], "tags": []}], "date": 1715020683, "git_changesets": [null], "user": "ffxbld"}, "368": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "ee3476c2e65029735b1cc71bdfc71ceff278d1ab", "parents": ["386fceaaa72dc7893f5dedea05966c7f1e0d25b0"], "tags": []}], "date": 1715613177, "git_changesets": [null], "user": "ffxbld-merge"}, "369": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 36d2dde067333d0c181cb8e21b12b73c307575db with FIREFOX_115_11_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "900a2756b1380a83c33671ddd40eb760e901669d", "parents": ["ee3476c2e65029735b1cc71bdfc71ceff278d1ab"], "tags": []}], "date": 1715691259, "git_changesets": [null], "user": "ffxbld"}, "370": {"changesets": [{"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1852650 [wpt PR 41925] - Regenerate WPT certificates, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated regeneration of WPT certificates\n\n--\n\nwpt-commits: ed67e0b41005f88bf900d650277fcecaad39b658\nwpt-pr: 41925", "files": ["testing/web-platform/tests/tools/certs/cacert.key", "testing/web-platform/tests/tools/certs/cacert.pem", "testing/web-platform/tests/tools/certs/web-platform.test.key", "testing/web-platform/tests/tools/certs/web-platform.test.pem", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/chrome_spki_certs.py"], "git_node": null, "git_parents": [null], "node": "9e40162e24624f937335b0c3d2f7c686ecbea3c0", "parents": ["900a2756b1380a83c33671ddd40eb760e901669d"], "tags": []}], "date": 1715698710, "git_changesets": [null], "user": "acseh@mozilla.com"}, "371": {"changesets": [{"author": "William Durand \u003cwill+git@drnd.me\u003e", "branch": "default", "desc": "Bug 1891421 - Update add-on production certs.  a=RyanVM\n\nI ran:\n\n```\nopenssl x509 -in ~/Downloads/AMO_Intermediate_Rsa_202404.crt -inform PEM -outform DER -out security/manager/ssl/addons-public-intermediate.crt\nopenssl x509 -in ~/Downloads/root-ca-production-amo.crt -inform PEM -outform DER -out security/manager/ssl/addons-public.crt\n```\n\nOriginal Revision: https://phabricator.services.mozilla.com/D208866\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210320", "files": ["security/manager/ssl/addons-public-intermediate.crt", "security/manager/ssl/addons-public.crt"], "git_node": null, "git_parents": [null], "node": "301e59194beca5a983b84fd205bba86927f3bfe9", "parents": ["9e40162e24624f937335b0c3d2f7c686ecbea3c0"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1895539: update production content signature root certificate  a=RyanVM\n\nThis is https://bugzilla.mozilla.org/attachment.cgi?id=9398246, run through `openssl x509 -in root-ca-production-amo.crt -inform PEM -outform DER`\n\nOriginal Revision: https://phabricator.services.mozilla.com/D209705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210322", "files": ["security/manager/ssl/content-signature-prod.crt"], "git_node": null, "git_parents": [null], "node": "a24a8f45d58cf746256dbee0a181db2215fa519f", "parents": ["301e59194beca5a983b84fd205bba86927f3bfe9"], "tags": []}], "date": 1715703873, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "372": {"changesets": [{"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 1895338 - Add core22 Snap to unblock newer versions of Snapcraft against Python 3.10 r=jcristau a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D209716\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210052", "files": ["taskcluster/docker/firefox-snap/Dockerfile"], "git_node": null, "git_parents": [null], "node": "780e0ae36deb4bbbf330dbdd715b448d9f9d52bc", "parents": ["a24a8f45d58cf746256dbee0a181db2215fa519f"], "tags": []}], "date": 1715703928, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "373": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1893252 - Skip MozillaBuild version check outside of MozillaBuild.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D208561\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209219", "files": ["python/mach/mach/logging.py"], "git_node": null, "git_parents": [null], "node": "661d8592a87e609d0f9a01f7b722891ced017326", "parents": ["780e0ae36deb4bbbf330dbdd715b448d9f9d52bc"], "tags": []}], "date": 1715704152, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "374": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1893416 - Skip assertion about BailoutStack alignment on --disable-jit configuration.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D208685\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208847", "files": ["js/src/jit/Bailouts.cpp"], "git_node": null, "git_parents": [null], "node": "6e13ed85ddf28fbb203ca24d78ddcd6f502fbb4c", "parents": ["661d8592a87e609d0f9a01f7b722891ced017326"], "tags": []}], "date": 1715704333, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "375": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1727526 - Abort DBAction::RunOnTarget if AppShutdown::IsInOrBeyond(ShutdownPhase::AppShutdownQM)  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D204587\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209801", "files": ["dom/cache/DBAction.cpp", "dom/cache/Manager.cpp"], "git_node": null, "git_parents": [null], "node": "0fe3a2a1aa3fa37b0618e34233787c43561f8b2f", "parents": ["6e13ed85ddf28fbb203ca24d78ddcd6f502fbb4c"], "tags": []}], "date": 1715704463, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "376": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210629", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "5ed41f7a6fe914a40c86f5044050b257741b559f", "parents": ["0fe3a2a1aa3fa37b0618e34233787c43561f8b2f"], "tags": []}], "date": 1715858657, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "377": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1896135 - stop running update verify next tasks on esr115. r=gbrown,releng-reviewers a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210043", "files": ["taskcluster/ci/release-update-verify-config-next/kind.yml", "taskcluster/ci/release-update-verify-next/kind.yml"], "git_node": null, "git_parents": [null], "node": "5765735e5ebab25878429b4d1abbee664cd0f25d", "parents": ["5ed41f7a6fe914a40c86f5044050b257741b559f"], "tags": []}], "date": 1716303963, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "378": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888695 - Add a pref for the iframe XFO/CSP Open In New Window button.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D206911\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209784", "files": ["browser/base/content/test/about/browser_aboutNetError_csp_iframe.js", "browser/base/content/test/about/browser_aboutNetError_xfo_iframe.js", "modules/libpref/init/all.js", "toolkit/content/aboutNetError.mjs", "toolkit/modules/RemotePageAccessManager.sys.mjs"], "git_node": null, "git_parents": [null], "node": "146b61f526c736b6503646e27dde404215758fad", "parents": ["5765735e5ebab25878429b4d1abbee664cd0f25d"], "tags": []}], "date": 1716408361, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "379": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210904", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/url-classifier-skip-urls.json"], "git_node": null, "git_parents": [null], "node": "1cbcd8d88d56968e48f85fabb215118c10c9f057", "parents": ["146b61f526c736b6503646e27dde404215758fad"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1690728 - Slow down UI inactivity timer for FOG user activity tests r=TravisLong a=test-only", "files": ["toolkit/components/telemetry/tests/marionette/harness/telemetry_harness/fog_testcase.py"], "git_node": null, "git_parents": [null], "node": "b355d3c3bbf62f99b7685de4a5e8394b66466edc", "parents": ["1cbcd8d88d56968e48f85fabb215118c10c9f057"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1879980 - add tests for prompts, r=pbz a=test-only", "files": ["browser/base/content/test/tabPrompts/browser.ini", "browser/base/content/test/tabPrompts/browser_promptDelays.js"], "git_node": null, "git_parents": [null], "node": "89decce8203b806f82a5b1d298209d0057307088", "parents": ["b355d3c3bbf62f99b7685de4a5e8394b66466edc"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 1832824 - [devtools] Fix browser_command_line_urls.js intermittent. r=devtools-reviewers,nchevobbe a=test-only\n\nView source may update the selection late.", "files": ["devtools/startup/tests/browser/browser_command_line_urls.js"], "git_node": null, "git_parents": [null], "node": "b83191f0dd92555d99f0f0911feb484bb44fbf84", "parents": ["89decce8203b806f82a5b1d298209d0057307088"], "tags": []}], "date": 1716411959, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "380": {"changesets": [{"author": "Iulian Moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 89decce8203b (bug 1879980) for causing bc failures on browser_promptDelays.js. a=backout", "files": ["browser/base/content/test/tabPrompts/browser.ini", "browser/base/content/test/tabPrompts/browser_promptDelays.js"], "git_node": null, "git_parents": [null], "node": "383508771210e3051e7048b6f8b197d3a4f247cc", "parents": ["b83191f0dd92555d99f0f0911feb484bb44fbf84"], "tags": []}], "date": 1716417915, "git_changesets": [null], "user": "imoraru@mozilla.com"}, "381": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211352", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/url-classifier-skip-urls.json"], "git_node": null, "git_parents": [null], "node": "088f4401cbabf554df25b460063cdcceeac76516", "parents": ["383508771210e3051e7048b6f8b197d3a4f247cc"], "tags": []}], "date": 1716571431, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "382": {"changesets": [{"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1882291. Switch to stdarch_arm_neon_intrinsics feature on rust \u003e=1.78. r=glandium a=RyanVM\n\nWe only need this on ARM32 because the ARM64 intrinsics are stable.\n\nstdarch_arm_neon_intrinsics was split out from stdsimd here:\nhttps://github.com/rust-lang/stdarch/pull/1486\n\nDifferential Revision: https://phabricator.services.mozilla.com/D203039", "files": ["Cargo.lock", "gfx/qcms/Cargo.toml", "gfx/qcms/build.rs", "gfx/qcms/src/lib.rs"], "git_node": null, "git_parents": [null], "node": "792a5db48bd342b3b689cbd4b95851471b461724", "parents": ["088f4401cbabf554df25b460063cdcceeac76516"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893075 - Refactor CacheFileIOManager::Write, r=necko-reviewers,valentin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D208739", "files": ["netwerk/cache2/CacheFileIOManager.cpp", "netwerk/cache2/CacheFileIOManager.h", "netwerk/cache2/CacheFileMetadata.cpp", "netwerk/cache2/CacheIndex.cpp"], "git_node": null, "git_parents": [null], "node": "0fa7ec9f1a9b8453cac6121d54198fe00d666440", "parents": ["792a5db48bd342b3b689cbd4b95851471b461724"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893388 - clone video info properly. r=media-playback-reviewers,chunmin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209439", "files": ["dom/media/MediaInfo.h"], "git_node": null, "git_parents": [null], "node": "aed8b21bdcd29217faec25369a330dde60298066", "parents": ["0fa7ec9f1a9b8453cac6121d54198fe00d666440"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893388 - add gtest. r=media-playback-reviewers,chunmin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209440", "files": ["dom/media/gtest/TestMediaInfo.cpp", "dom/media/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "c29e50b0d33cc74768fd070f2d8fbb67f5bb906a", "parents": ["aed8b21bdcd29217faec25369a330dde60298066"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1895086 - Suppress GC during JSObject::swap r=jandem a=RyanVM\n\nWe already suppress GC for part of this, but not for the part where we call\nJSObject::setIsUsedAsPrototype. This can GC (which was surprising to me) and so\nwe can sweep before the pre-write barrier which comes after this.\n\nThe simplest and safest thing is to suppress GC for the whole method.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209813", "files": ["js/src/vm/JSObject.cpp"], "git_node": null, "git_parents": [null], "node": "25c5e091b01e6b64378d0b5c43fe93bceea31eda", "parents": ["c29e50b0d33cc74768fd070f2d8fbb67f5bb906a"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 1895123 - Create stack map in wasm import stub if needed. r=jandem,rhunt a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D210515", "files": ["js/src/wasm/WasmStubs.cpp"], "git_node": null, "git_parents": [null], "node": "953871d57b9cad5d31300bc1d9afb245b3728bc2", "parents": ["25c5e091b01e6b64378d0b5c43fe93bceea31eda"], "tags": []}], "date": 1716575942, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "383": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1875030 - Update element ranges on the mark stack before and after marking to take account of shifted elements.  r=sfink,jandem a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211336", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp"], "git_node": null, "git_parents": [null], "node": "6f9454132cc1309251add0b958234bdacf22d7c7", "parents": ["953871d57b9cad5d31300bc1d9afb245b3728bc2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1889355 - Clear mark stack entries for ranges involving transplanted objects that are no longer native r=sfink a=RyanVM\n\nThe problem here is that transplanting an object can turn it from a native\nobject into a proxy. During incremental marking the mark stack may have an\nentry for a value range inside such and object and attempting to access the\nobject as if it were still a native object after the transplant is unsafe.\n\nThe patch checks mark stack entries when we resume an incremental marking slice\nand overwrites such mark stack entries with dummy entries that don't result in\nanything getting marked (this uses the object pointer, but it's not interpreted\nas a native object when used like this).", "files": ["js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp"], "git_node": null, "git_parents": [null], "node": "792fda534cead58ca9d502afcace740842117852", "parents": ["6f9454132cc1309251add0b958234bdacf22d7c7"], "tags": []}], "date": 1716576524, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "384": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1897635 - Avoid clang 18 exploiting undefined behavior when optimizing NS_InvokeByIndex after inlining invoke_copy_to_stack.  a=RyanVM\n\nThe code has been fragile since its introduction in bug 532198, but in\npractice it (surprisingly) hadn't caused problems so far. What the C++\nimplementation saves us, albeit at the cost of using undefined behavior,\nis having to write several different version of the corresponding\nassembly for the various different ARM variants that are supported\n(including thumb vs.  non-thumb).\n\nWith this being the first time the compiler breaks this code in 14\nyears, I'd say it's worth keeping that way. We may reconsider if it\nbreaks further.\n\nAn alternative way to handle the situation would be to test for\nparamCount=0 and call `func(that)` in that case, but the compiler\ngenerates much more code than necessary for some reason.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D210984\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211117", "files": ["xpcom/reflect/xptcall/md/unix/xptcinvoke_arm.cpp"], "git_node": null, "git_parents": [null], "node": "9824d0db7b2d8f0710fea9996dc0bb9e849d40f8", "parents": ["792fda534cead58ca9d502afcace740842117852"], "tags": []}], "date": 1716576897, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "385": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1193389 - nsTransportEventSinkProxy clean up,  a=RyanVM\n\nThis patch might not fix this issue, but we should try to avoid accessing raw pointer.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D199976\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211443", "files": ["netwerk/base/nsTransportUtils.cpp"], "git_node": null, "git_parents": [null], "node": "8b2b8eb760f4c4fa17b9ad4c5486c1eb66896cd7", "parents": ["9824d0db7b2d8f0710fea9996dc0bb9e849d40f8"], "tags": []}], "date": 1716576958, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "386": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset c29e50b0d33c (bug 1893388)", "files": ["dom/media/gtest/TestMediaInfo.cpp", "dom/media/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "7e7fd5b6d8e28a6edbfcb2690f71b3d94b65ad14", "parents": ["8b2b8eb760f4c4fa17b9ad4c5486c1eb66896cd7"], "tags": []}], "date": 1716578027, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "387": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1883693 - Remove early return in nsExternalProtocolHandler::NewChannel when handler doesn't exist  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205296\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211337", "files": ["uriloader/exthandler/nsExternalProtocolHandler.cpp", "uriloader/exthandler/nsExternalProtocolHandler.h", "uriloader/exthandler/win/nsOSHelperAppService.h"], "git_node": null, "git_parents": [null], "node": "0a1fa48ffc14f6ed6f2b158c077546287096a437", "parents": ["7e7fd5b6d8e28a6edbfcb2690f71b3d94b65ad14"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1883693 - Fix devtools expectation that newChannel throws for unsupported external handlers  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D206754\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211338", "files": ["devtools/shared/DevToolsUtils.js"], "git_node": null, "git_parents": [null], "node": "df4888c4f931ada77bc8d4fdad379630811cefba", "parents": ["0a1fa48ffc14f6ed6f2b158c077546287096a437"], "tags": []}], "date": 1716947648, "git_changesets": [null, null], "user": "rvandermeulen@mozilla.com"}, "388": {"changesets": [{"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1736488 - Ensure we update the channel cookie jar before deriving principals from it.  a=RyanVM\n\nWithout this patch we potentially create the reserved client principal\nbased on a stale cookie jar because we add the ClientChannelHelper\nbefore the cookie jar's partition key is mutated in\nnsHttpChannel::AsyncOpen.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211148\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211250", "files": ["netwerk/ipc/DocumentLoadListener.cpp"], "git_node": null, "git_parents": [null], "node": "e03b1b87dd63aa60331adafd92a8b06ce2792b50", "parents": ["df4888c4f931ada77bc8d4fdad379630811cefba"], "tags": []}], "date": 1716950558, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "389": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1891319.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D207819\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211096", "files": ["dom/canvas/CanvasImageCache.cpp", "dom/canvas/CanvasImageCache.h", "dom/canvas/CanvasRenderingContext2D.cpp"], "git_node": null, "git_parents": [null], "node": "c5f64f0cca751757cd7026d7f9327369fb10bcda", "parents": ["e03b1b87dd63aa60331adafd92a8b06ce2792b50"], "tags": []}], "date": 1716950639, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "390": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1896555 - Fix nsTextFragment OOM handling.  a=RyanVM\n\nDon't release the text eagerly until we know we have a buffer to put the\nnew text in.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D210616\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211712", "files": ["dom/base/nsTextFragment.cpp"], "git_node": null, "git_parents": [null], "node": "5ff085122aa8b1b8683b021652538f669dacee0f", "parents": ["c5f64f0cca751757cd7026d7f9327369fb10bcda"], "tags": []}], "date": 1716950677, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "391": {"changesets": [{"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893406 - Always provide a valid installation time in WER crash reports  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D209234\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211825", "files": ["toolkit/crashreporter/mozwer-rust/lib.rs"], "git_node": null, "git_parents": [null], "node": "77b6fd1533bfc1a8a641ec1e48c049637ca0bda3", "parents": ["5ff085122aa8b1b8683b021652538f669dacee0f"], "tags": []}], "date": 1716951066, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "392": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211725", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "9f539c04ee7e15f9398607a7073aa64ee24f9732", "parents": ["77b6fd1533bfc1a8a641ec1e48c049637ca0bda3"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1862809. r=media-playback-reviewers,azebrowski a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211266", "files": ["dom/media/gmp/GMPVideoDecoderChild.cpp", "dom/media/gmp/GMPVideoDecoderChild.h", "dom/media/gmp/GMPVideoEncoderChild.cpp", "dom/media/gmp/GMPVideoEncoderChild.h"], "git_node": null, "git_parents": [null], "node": "95b0dfa48d2e74558257415928a54cc2b73dadfa", "parents": ["9f539c04ee7e15f9398607a7073aa64ee24f9732"], "tags": []}], "date": 1716951414, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "393": {"changesets": [{"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 1833891 - Update the WPT test for error handling behavior when worker loading a cross-origin script. r=dom-worker-reviewers,smaug,zcorpan a=test-only\n\nAccording to the spec, when a worker is trying to load a cross-origin\nscript, an onerror handler should be called. The detailed calling\nsequence from the spec will be explained in the following paragraph. For the\nlegacy specification, it will be explained in the bottom.\n\nSo we look into current specification first:\n(The numbers indicate the calling sequence)\n= Explain the current behavior when a worker is trying to load a cross-origin script =\n\n== 1. [run a worker](https://html.spec.whatwg.org/#run-a-worker)\n\n14) [Fetch a classic worker script](https://html.spec.whatwg.org/#fetch-a-classic-worker-script) given url, outside settings, destination, inside settings, and with onComplete and performFetch as defined below\n(Note: we use \"fetch a classic worker script\" as an example here)\n\n== 2. [fetch a classic worker script](https://html.spec.whatwg.org/#fetch-a-classic-worker-script)\n\ngiven a url, a fetch client settings object, a destination, a script settings object, an onComplete algorithm, and an optional perform the fetch hook performFetch\n\n1) Let request be a new request whose ...  mode is \"same-origin\", ...\n\n2) If performFetch was given, run performFetch with request, true, and with processResponseConsumeBody as defined below.\n\nNote: Run the performFetch provided in (1),\n\n== 3. performFetch defined in Step 14 of [run a worker](https://html.spec.whatwg.org/#run-a-worker)\n\n...\n3) [Fetch](https://fetch.spec.whatwg.org/#concept-fetch) request with processResponseConsumeBody set to the following steps given response response and null, failure, or a byte sequence bodyBytes:\n\n== 4. [fetch](https://fetch.spec.whatwg.org/#concept-fetch)\n\ngiven a request request, ..., an optional algorithm processResponseConsumeBody\n\n7) Let fetchParams be a new fetch params whose request is request, ...,  process response consume body is processResponseConsumeBody\n...\n17) Run [main fetch](https://fetch.spec.whatwg.org/#concept-main-fetch) given fetchParams.\n\n== 5. [main fetch](https://fetch.spec.whatwg.org/#concept-main-fetch)\n\ngiven a fetch params fetchParams\n\n12) If response is null, then set response to the result of running the steps corresponding to the first matching statement:\n\n    - request\u2019s current URL\u2019s origin is same origin with request\u2019s origin, and request\u2019s response tainting is \"basic\":\n\n    Note: Normal SOP script will execute this part, however in this case we are loading a script which is not the same-origin.\n    So we will fallback to next statement.\n\n    - request\u2019s mode is \"same-origin\":\n      - Return a network error.\n\n== 6. processResponseConsumeBody defined in Step 2 of (2) [fetch a classic worker script](https://html.spec.whatwg.org/#fetch-a-classic-worker-script)\n\n2) If either of the following conditions are met:\n   - bodyBytes is null or failure; or\n   - response's status is not an ok status,\n     - then run onComplete given null, and abort these steps.\n\nNote: Run onComplete provided in (1)\n\n== 7. onComplete defined in Step 14 of (1) [run a worker](https://html.spec.whatwg.org/#run-a-worker)\n\n1) If script is null or if script's error to rethrow is non-null, then:\n   1) Queue a global task on the DOM manipulation task source given worker's relevant global object to fire an event named error at worker.\n\n   2) Run the environment discarding steps for inside settings.\n\n   3) Abort these steps.\n\n---\n\nSo when a worker loads a cross-origin script, the worker.onerror(e) should be\ncalled, where e is a Event whose name is \"error\".\n\n= Explain the legacy behavior when a worker is trying to load a cross-origin script\n\nIn the older HTML spec before 2015. Nov,\nThe specification was actually defined how to handle cross-origin scripts for workers,\nsee http://web.archive.org/web/20151106154945/https://html.spec.whatwg.org/#dom-worker, step 5:\n\n\u003e If the scheme component of worker URL is not \"data\", and the origin of worker URL\n\u003e is not the same as the origin specified by the incumbent settings object, then\n\u003e throw a SecurityError exception and abort these steps.\n\nHowever, the statement was removed in https://github.com/whatwg/html/commit/24242406daa40cfe5d97cdfbac463c29e63433fd\nbecause the SOP check should be done in Fetch API.\nBut WPT doesn't get updated since then, so it caused different error\nhandling behavior between browsers since then.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D179544", "files": ["testing/web-platform/meta/workers/modules/dedicated-worker-import-failure.html.ini", "testing/web-platform/tests/workers/Worker_cross_origin_security_err.htm", "testing/web-platform/tests/workers/constructors/SharedWorker/same-origin.html", "testing/web-platform/tests/workers/constructors/Worker/same-origin.html", "testing/web-platform/tests/workers/modules/dedicated-worker-import-failure.html"], "git_node": null, "git_parents": [null], "node": "75b0d9794bd858a6b1b5f270fdf47b7b40c10468", "parents": ["95b0dfa48d2e74558257415928a54cc2b73dadfa"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 1851134 [wpt PR 41758] - Correct worker test for unsupported: scheme, a=testonly\n\nAutomatic update from web-platform-tests\nCorrect worker test for unsupported: scheme\n\nAlso check that a non-parsable URL throws the correct exception.\n\nIdentified in https://github.com/web-platform-tests/wpt/issues/41745.\n--\n\nwpt-commits: 2d504ed2b20e9325243ef22fb95b9f645ae7d87c\nwpt-pr: 41758", "files": ["testing/web-platform/tests/workers/constructors/SharedWorker/same-origin.html", "testing/web-platform/tests/workers/constructors/Worker/same-origin.html"], "git_node": null, "git_parents": [null], "node": "02bbe8f00f67134020b8b05e288973711ed1cf3d", "parents": ["75b0d9794bd858a6b1b5f270fdf47b7b40c10468"], "tags": []}], "date": 1716989276, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "394": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D212102", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "b0abb2d00e05c63b88cc82d721b684f2d549d920", "parents": ["02bbe8f00f67134020b8b05e288973711ed1cf3d"], "tags": []}], "date": 1717074256, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "395": {"changesets": [{"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1896944 - Restore $TmpVal after using it for a different purpose r=nalexander! a=pascalc\n\nThis is a bit ugly. The better fix for this issue is https://phabricator.services.mozilla.com/D211452 but that fix is a bit more invasive whereas this fix is a bit safer for uplift. So this patch will be uplifted and the other one will clean things up but won't be uplifted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211608", "files": ["browser/installer/windows/nsis/shared.nsh"], "git_node": null, "git_parents": [null], "node": "41e55505e8d96d3ab7e811ba987270d2589c9740", "parents": ["b0abb2d00e05c63b88cc82d721b684f2d549d920"], "tags": []}], "date": 1717093113, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "396": {"changesets": [{"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1891234, additional filename filter checks,  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D208659\n\nDifferential Revision: https://phabricator.services.mozilla.com/D211288", "files": ["toolkit/components/downloads/test/unit/test_DownloadPaths.js", "toolkit/components/extensions/test/xpcshell/test_ext_downloads_urlencoded.js", "uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/tests/mochitest/save_filenames.html", "uriloader/exthandler/tests/mochitest/test_invalidCharFileExtension.xhtml", "uriloader/exthandler/tests/unit/test_filename_sanitize.js"], "git_node": null, "git_parents": [null], "node": "2062b99385d0d9fd5d57389da40fb2358a26a128", "parents": ["41e55505e8d96d3ab7e811ba987270d2589c9740"], "tags": []}], "date": 1717094687, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "397": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1894689 - update pinned cert issuers in windows maintenance service.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D209245\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209336", "files": ["browser/installer/windows/nsis/defines.nsi.in", "browser/installer/windows/nsis/maintenanceservice_installer.nsi", "toolkit/components/maintenanceservice/bootstrapinstaller/maintenanceservice_installer.nsi", "toolkit/mozapps/update/docs/MaintenanceServiceTests.rst"], "git_node": null, "git_parents": [null], "node": "2950bf83466c0bde3017fe6519cd43c90e3f6c3a", "parents": ["2062b99385d0d9fd5d57389da40fb2358a26a128"], "tags": []}], "date": 1717095526, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "398": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D212410", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6b05ad1f5f2dbb0d47ac169115e250ff3776289c", "parents": ["2950bf83466c0bde3017fe6519cd43c90e3f6c3a"], "tags": ["FIREFOX_115_12_0esr_BUILD1", "FIREFOX_115_12_0esr_RELEASE"]}], "date": 1717426292, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}}
