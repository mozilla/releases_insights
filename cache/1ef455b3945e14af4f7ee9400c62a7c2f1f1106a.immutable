"pushes": {"543": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 554efae2f3d235ef2f070cb1a7df62442769f9f8 with FIREFOX_115_18_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "b1bceae636a4b1c1e93c2cc65624d9b87ec95c76", "parents": ["554efae2f3d235ef2f070cb1a7df62442769f9f8"], "tags": []}], "date": 1731947933, "git_changesets": [null], "user": "ffxbld"}, "544": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "88f0c6469f0863c010a5fd612f0b066cc94cce1a", "parents": ["b1bceae636a4b1c1e93c2cc65624d9b87ec95c76"], "tags": []}], "date": 1732541047, "git_changesets": [null], "user": "ffxbld-merge"}, "545": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230095", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "2e11cf5567ada9a27fecd1e2c93bac66f2d38ae4", "parents": ["88f0c6469f0863c010a5fd612f0b066cc94cce1a"], "tags": []}], "date": 1732574729, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "546": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 554efae2f3d235ef2f070cb1a7df62442769f9f8 with FIREFOX_115_18_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "92a4c495718783c96666ed1867078accb88ccbe5", "parents": ["2e11cf5567ada9a27fecd1e2c93bac66f2d38ae4"], "tags": []}], "date": 1732628883, "git_changesets": [null], "user": "ffxbld"}, "547": {"changesets": [{"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1921759: Restart Windows Explorer at start of browser_bookmark_copy_folder_tree.js a=dmeehan\nIn a new Windows update, explorer.exe is grabs the clipboard mutex and holds\nit for a long time, which is causing test failures.  Killing explorer.exe\nrestarts it and forces it to give up the mutex, allowing the test to pass.", "files": ["browser/components/places/tests/browser/browser_bookmark_copy_folder_tree.js"], "git_node": null, "git_parents": [null], "node": "52c7b6e01928235f94021696186874a7d2c308a0", "parents": ["92a4c495718783c96666ed1867078accb88ccbe5"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921759: Log the process that holds the clipboard mutex on Windows a=dmeehan\nWhen Windows keeps us from getting access to the clipboard because another\napplication is using it, this will report the exe that currently holds the\nmutex.", "files": ["widget/windows/WinUtils.cpp", "widget/windows/WinUtils.h", "widget/windows/nsClipboard.cpp"], "git_node": null, "git_parents": [null], "node": "950fa856c4ef59ad26e31a51c44fd76f73b0ec01", "parents": ["52c7b6e01928235f94021696186874a7d2c308a0"], "tags": []}], "date": 1732634481, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "548": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230509", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json"], "git_node": null, "git_parents": [null], "node": "9962ad673b5b54b7e4955b09899bdf045c205a34", "parents": ["950fa856c4ef59ad26e31a51c44fd76f73b0ec01"], "tags": []}], "date": 1732802631, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "549": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231218", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "ac59c37d505ebe535dbe0d70ab0b2e2b46147a02", "parents": ["9962ad673b5b54b7e4955b09899bdf045c205a34"], "tags": []}], "date": 1733420948, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "550": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1874523.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D227304\n\nDifferential Revision: https://phabricator.services.mozilla.com/D229974", "files": ["image/AnimationFrameBuffer.cpp", "image/Decoder.cpp", "image/imgFrame.cpp", "image/imgFrame.h", "image/test/gtest/TestAnimationFrameBuffer.cpp"], "git_node": null, "git_parents": [null], "node": "b7e2dc9c6a896e3ad485003c942678d637ffa5ce", "parents": ["ac59c37d505ebe535dbe0d70ab0b2e2b46147a02"], "tags": []}], "date": 1733426088, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "551": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1926454.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D229928\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230333", "files": ["dom/base/StructuredCloneHolder.cpp"], "git_node": null, "git_parents": [null], "node": "73b5dbed38415985bba0c317675813e2e7431bc6", "parents": ["b7e2dc9c6a896e3ad485003c942678d637ffa5ce"], "tags": []}], "date": 1733426128, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "552": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1932169 - Throw an error when UnderlyingSource.autoAllocateChunkSize is too large on 32-bit build.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D229811\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230270", "files": ["dom/streams/ReadableByteStreamController.cpp", "dom/streams/test/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "a2b56c9b91472176fed3cd48d530b38a37eadd57", "parents": ["73b5dbed38415985bba0c317675813e2e7431bc6"], "tags": []}], "date": 1733427047, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "553": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231523", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "71d6d47ef72987de0d15ce57ff7592b76a3c3bcc", "parents": ["a2b56c9b91472176fed3cd48d530b38a37eadd57"], "tags": []}], "date": 1733793804, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "554": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1931873 - Use WeakPtr in MIDIAccess, r=gsvelto a=RyanVM\n\nThe WeakPtr type simplifies the situation if the `MIDIPort` object\noutlives its `MIDIAccess`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230812", "files": ["dom/midi/MIDIAccess.cpp", "dom/midi/MIDIAccess.h", "dom/midi/MIDIPort.cpp", "dom/midi/MIDIPort.h"], "git_node": null, "git_parents": [null], "node": "234e266bcfdb4f3f36884bed096921a778cefc65", "parents": ["71d6d47ef72987de0d15ce57ff7592b76a3c3bcc"], "tags": []}], "date": 1733795084, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "555": {"changesets": [{"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 1901936 - Set environment variables for custom-v8 builds. r=perftest-reviewers,sparky a=release DONTBUILD\n\nUpstream changes have changed the config path of depot_tools to default\nto `$HOME/.config`. Instead we also have the option to set\n`$XDG_CONFIG_HOME`. At the moment this only affects linux, with\nwindows/macos slated to have a similar change soon with possibly\ndifferent setup.", "files": ["taskcluster/scripts/misc/build-custom-v8.sh"], "git_node": null, "git_parents": [null], "node": "0e6dc321c4bc69e4eb22ac3040411dbb0ed60633", "parents": ["234e266bcfdb4f3f36884bed096921a778cefc65"], "tags": []}], "date": 1733945937, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "556": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231925", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "506a71d05c27073ca5558b76050b695b996e1598", "parents": ["0e6dc321c4bc69e4eb22ac3040411dbb0ed60633"], "tags": []}], "date": 1734011855, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "557": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915535 - [esr115] Ensure consistent cleanup in nsLineBreaker::FlushCurrentWord.  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D231951", "files": ["dom/base/nsLineBreaker.cpp"], "git_node": null, "git_parents": [null], "node": "1a28bb2e9696700209b2df024038c3c9e3de26a6", "parents": ["506a71d05c27073ca5558b76050b695b996e1598"], "tags": []}], "date": 1734083945, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "558": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1932482 - Add support for downloading GMP plugins from mirror URLs.  a=pascalc\n\nWe have found that some users are unable to download the GMP plugin from\nthe default URL because of their specific network\nconfiguration/circumstances. For example, some users cannot access the\n*.gvt1.com domain. This patch adds the ability for balrog to supply\nalternative mirror URLs to attempt to download the plugin, where we first\ntry the primary, and if supplied any secondaries, in the given order.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D229690\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230619", "files": ["toolkit/content/gmp-sources/openh264.json", "toolkit/content/gmp-sources/widevinecdm.json", "toolkit/modules/GMPInstallManager.sys.mjs", "toolkit/modules/tests/xpcshell/test_GMPInstallManager.js", "toolkit/mozapps/extensions/internal/ProductAddonChecker.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/data/productaddons/good.xml", "toolkit/mozapps/extensions/test/xpcshell/test_ProductAddonChecker.js", "toolkit/mozapps/extensions/test/xpcshell/test_ProductAddonChecker_signatures.js"], "git_node": null, "git_parents": [null], "node": "7b461b7d80acc34e0193fa0fbed98f71242b388a", "parents": ["1a28bb2e9696700209b2df024038c3c9e3de26a6"], "tags": []}], "date": 1734084218, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "559": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232201", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "36fd7b6b3ddbffe940e402af3c6d1b44ce285543", "parents": ["7b461b7d80acc34e0193fa0fbed98f71242b388a"], "tags": ["FIREFOX_115_19_0esr_BUILD1", "FIREFOX_115_19_0esr_RELEASE"]}], "date": 1734445054, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}}
}";