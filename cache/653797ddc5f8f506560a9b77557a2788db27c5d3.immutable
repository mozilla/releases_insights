.com/D128739", "files": ["netwerk/sctp/datachannel/DataChannel.cpp"], "git_node": null, "git_parents": [null], "node": "5124138abc283127a01660e4f4f873394ff09067", "parents": ["b2ce3f908336fe51762dfcea6c4f950841e174d5"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732572 - Ignore invisible windows when reopening app from dock, and prioritize top-level browser windows for restoration. r=mstange, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129070", "files": ["toolkit/xre/nsNativeAppSupportCocoa.mm"], "git_node": null, "git_parents": [null], "node": "ec4389b449908e790a0fc47d14d2b2134cbf5679", "parents": ["5124138abc283127a01660e4f4f873394ff09067"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1730120, close ContentViewer properly if initialization fails, r=nika a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130211", "files": ["docshell/base/nsDocShell.cpp", "layout/base/nsDocumentViewer.cpp"], "git_node": null, "git_parents": [null], "node": "d350a75e651733f936836057c59a4e8f63a1d266", "parents": ["ec4389b449908e790a0fc47d14d2b2134cbf5679"], "tags": []}, {"author": "Asumu Takikawa \u003casumu@igalia.com\u003e", "branch": "default", "desc": "Bug 1739683 - Fix code offset use in Wasm calls. r=rhunt,lth a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130527", "files": ["js/src/jit/CodeGenerator.cpp"], "git_node": null, "git_parents": [null], "node": "9ee936305e6868d9fd627fd6fdfd9f88dd9cd3bb", "parents": ["d350a75e651733f936836057c59a4e8f63a1d266"], "tags": []}], "date": 1637252568, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "106": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131776", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "14097457d80b0c258bfaef013d65287a0c759ac8", "parents": ["9ee936305e6868d9fd627fd6fdfd9f88dd9cd3bb"], "tags": []}, {"author": "Tomislav Jovanovic \u003ctomica@gmail.com\u003e", "branch": "default", "desc": "Bug 1645565 - Avoid using innerText in test_ext_contentscript_fission_frame r=willdurand a=test-only\n\ninnerText can be flaky for unrelated reasons, and we dont't actually need it\nfor this test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129703", "files": ["toolkit/components/extensions/test/mochitest/test_ext_contentscript_fission_frame.html"], "git_node": null, "git_parents": [null], "node": "7cc8af3b63009ed048a2cd106ae12aa91ce98911", "parents": ["14097457d80b0c258bfaef013d65287a0c759ac8"], "tags": []}, {"author": "Oriol Brufau \u003coriol-bugzilla@hotmail.com\u003e", "branch": "default", "desc": "Bug 1675584 - [devtools] Await TabChanged event in selectJsonViewContentTab. r=Honza\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126751", "files": ["devtools/client/jsonview/components/MainTabbedArea.js", "devtools/client/jsonview/test/head.js"], "git_node": null, "git_parents": [null], "node": "89306cc0de8ef27a19f6130f242664bfa0ba7902", "parents": ["7cc8af3b63009ed048a2cd106ae12aa91ce98911"], "tags": []}, {"author": "Oriol Brufau \u003coriol-bugzilla@hotmail.com\u003e", "branch": "default", "desc": "Bug 1734940 - Add checks for switching JSON Viewer tab in tests. r=nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128029", "files": ["devtools/client/jsonview/test/head.js"], "git_node": null, "git_parents": [null], "node": "4e6b544b5ce7d0221adcf009f14ea854da466877", "parents": ["89306cc0de8ef27a19f6130f242664bfa0ba7902"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1737666 - Update widevine fallback URLs to 4.10.2391.0 CDM. r=mjf a=RyanVM\n\nUpdate the fallback URLs for Widevine version 4.10.2391.0. This also adds a\nfallback for the Windows asan case. This makes the fallback URLs consistent with\nthe balrog rules and handles the (edge) case where asan Win builds can't connect\nto balrog.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131159", "files": ["toolkit/content/gmp-sources/widevinecdm.json"], "git_node": null, "git_parents": [null], "node": "4f90e0e0970b0b3dae63e87015477fc41e0f2829", "parents": ["4e6b544b5ce7d0221adcf009f14ea854da466877"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1741997 - DMABufSurface::FenceDelete should not require GL context to close mSyncFd handle. r=stransky a=RyanVM\n\nWe can create DMABufSurface objects via deserialization without ever\nsetting a GL context. We must ensure we close the file handle even if we\ndon't have one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131561", "files": ["widget/gtk/DMABufSurface.cpp"], "git_node": null, "git_parents": [null], "node": "b235a2a6357e4c4e4f00b047ea91d62bb56bb034", "parents": ["4f90e0e0970b0b3dae63e87015477fc41e0f2829"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1739920: Fire a focus win event when the real UI replaces the skeleton UI. r=mhowell,dthayer, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130570", "files": ["widget/windows/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "d88fffc5376dce0a8d896588dd7290c6a3404e11", "parents": ["b235a2a6357e4c4e4f00b047ea91d62bb56bb034"], "tags": []}], "date": 1637607047, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "107": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1709679 - Properly map/unmap SourceSurfaceSharedDataWrapper for blob recordings. r=jrmuizel, a=RyanVM\n\nWhen replaying blob recordings, we need to ensure that we map and unmap\nthe surface properly so that we don't accidently expire the mapping too\nearly to free up virtual memory on 32-bit Firefox. The code was written\nbut not activated because we failed to use the wrong type in the\nSourceSurfaceSharedDataWrapper::GetType implementation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129311", "files": ["gfx/2d/DrawTargetSkia.cpp", "gfx/layers/SourceSurfaceSharedData.h"], "git_node": null, "git_parents": [null], "node": "18f10ccdb35f9a7d103fb18646f47fd8ca0aec49", "parents": ["d88fffc5376dce0a8d896588dd7290c6a3404e11"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1739716 - Add keyword.enabled and user stylesheet prefs to policy. r=mtigley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131010", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "f913817e92b2fe85f184949f9a9699333167c01f", "parents": ["18f10ccdb35f9a7d103fb18646f47fd8ca0aec49"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1741217 - Hide private browsing option in managed bookmarks if private browsing is disabled. r=mtigley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131289", "files": ["browser/components/enterprisepolicies/tests/browser/managedbookmarks/browser_policy_managedbookmarks.js", "browser/components/enterprisepolicies/tests/browser/managedbookmarks/managedbookmarks.json", "browser/components/places/PlacesUIUtils.jsm"], "git_node": null, "git_parents": [null], "node": "d4de29d5eff918e19fa66b9645d06f59fbc6137d", "parents": ["f913817e92b2fe85f184949f9a9699333167c01f"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1736046 - Validate length of nested structured serialization data r=baku a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130127", "files": ["dom/base/StructuredCloneBlob.cpp", "dom/ipc/ClonedErrorHolder.cpp"], "git_node": null, "git_parents": [null], "node": "45d3fd63bd24f66072a16d23fefc01c3c68a0bb1", "parents": ["d4de29d5eff918e19fa66b9645d06f59fbc6137d"], "tags": []}], "date": 1637704812, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "108": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1739352 - Make sure to set mCurrentMacCursor if needed. r=mstange a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130769", "files": ["widget/cocoa/nsCursorManager.mm"], "git_node": null, "git_parents": [null], "node": "cee76519645be63c1730e50ff0f2614a584f93e3", "parents": ["45d3fd63bd24f66072a16d23fefc01c3c68a0bb1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1719150 - Push delayed mouse event to the right pres shell. r=smaug a=pascalc\n\nOtherwise if we get an event targeting a different suppressed pres shell\nwhile we're unsuppressing we might get stuck delaying the event over and\nover, see the links in comment 33.\n\nNot sure how to get a repro for this, the patch is written based on the\npernosco session, but suggestions welcome.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130100", "files": ["layout/base/PresShell.cpp", "layout/base/PresShell.h"], "git_node": null, "git_parents": [null], "node": "ba2641b50a760e925a54b58fe1ac7ff5e6bd158b", "parents": ["cee76519645be63c1730e50ff0f2614a584f93e3"], "tags": []}, {"author": "raquelvargas \u003craquelvargas@gmail.com\u003e", "branch": "default", "desc": "Bug 1737389 - Fixes red line of the bar around the left side when not found. r=harry,desktop-theme-reviewers a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129547", "files": ["toolkit/themes/shared/findbar.css"], "git_node": null, "git_parents": [null], "node": "f659b713edc3a5c5994ddd00670b57406e9d7506", "parents": ["ba2641b50a760e925a54b58fe1ac7ff5e6bd158b"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1741455 - Update favicon for C\u1ed1c C\u1ed1c search engine. r=mkaply a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131950", "files": ["browser/components/search/extensions/coccoc/favicon.ico"], "git_node": null, "git_parents": [null], "node": "c2dcd37536a90e8b75a939d07f7e64c607fa588c", "parents": ["f659b713edc3a5c5994ddd00670b57406e9d7506"], "tags": []}], "date": 1637769132, "git_changesets": [null, null, null, null], "user": "pchevrel@mozilla.com"}, "109": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1741204 - Consolidate cookie policy into one Behavior policy. r=pbz a=pascalc", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js"], "git_node": null, "git_parents": [null], "node": "ff9d3593dbefae82e46bb86ec53ad21d8be8a52f", "parents": ["c2dcd37536a90e8b75a939d07f7e64c607fa588c"], "tags": []}, {"author": "Emilio Cobos Alvarez \u003cemilio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1671252 - Move Windows accent border to #navigator-toolbox. r=Gijs a=pascalc\n\nThis works correctly. On the root it seems we hit this codepath:\n\n  https://searchfox.org/mozilla-central/rev/df18dd52da04ee2bad434b0ba2d9fcb196d4d15e/layout/xul/nsBoxFrame.cpp#514-525\n\nAnd end up with an slightly-bigger-than-needed box. I haven't dug into what\nchanging this may entail, but given the root frame is special anyways (because\nit affects window constraints etc) it's probably safer to do this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131421", "files": ["browser/themes/windows/browser-aero.css"], "git_node": null, "git_parents": [null], "node": "9dc5249ea4dc7e5a722de4592510817e393ba667", "parents": ["ff9d3593dbefae82e46bb86ec53ad21d8be8a52f"], "tags": []}, {"author": "Paul Zuehlcke \u003cpbz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1739091, r=Gijs a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131268", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js"], "git_node": null, "git_parents": [null], "node": "d1924a4be37791315e2b3a94d558c7904a42e2de", "parents": ["9dc5249ea4dc7e5a722de4592510817e393ba667"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1739372: Improve handling of reentry in MsaaAccessible::GetRemoteIAccessibleFor. r=eeejay a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131468", "files": ["accessible/windows/msaa/MsaaAccessible.cpp"], "git_node": null, "git_parents": [null], "node": "8cb6e98189b8deec8699296ec4976c96de36e603", "parents": ["d1924a4be37791315e2b3a94d558c7904a42e2de"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1728744 - prevent langpack vs packagedLocale overlap to avoid severe memory usage issues. r=zbraniecki a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D131533", "files": ["toolkit/components/extensions/Extension.jsm", "toolkit/mozapps/extensions/test/xpcshell/test_langpack_locale_match.js", "toolkit/mozapps/extensions/test/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "b7e0d3f07d61e0b723358958bf187c072cc525e9"