l], "node": "b5719df9cb8e9de465bf994b0f27081baa80e9f7", "parents": ["d89f4170814141c9a86ec5c1e8da2dfa844f541b"], "tags": []}], "date": 1635782126, "git_changesets": [null], "user": "ffxbld-merge"}, "94": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 8802d620459d50ea648821a15497d06efd15732b with FIREFOX_91_3_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "dc90f298be6d69ec2480f1764923adcbf65b9bc9", "parents": ["b5719df9cb8e9de465bf994b0f27081baa80e9f7"], "tags": []}], "date": 1635857274, "git_changesets": [null], "user": "ffxbld"}, "95": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1737558 - switch cron-bouncer-check away from esr78. r=jmaher a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129505", "files": ["taskcluster/ci/cron-bouncer-check/kind.yml"], "git_node": null, "git_parents": [null], "node": "794e4f1c4c8926f52526a262bed640726b9b18b1", "parents": ["dc90f298be6d69ec2480f1764923adcbf65b9bc9"], "tags": []}], "date": 1635862261, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "96": {"changesets": [{"author": "Michelle Goossens \u003cmichelle@masterwayz.nl\u003e", "branch": "default", "desc": "Bug 1735396 - Update test_archive.py expected file hashes when running on Python 3.9 or newer. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128294", "files": ["python/mozbuild/mozpack/test/test_archive.py"], "git_node": null, "git_parents": [null], "node": "1ccd82971de9f0d04ab2592c3fd6bb9582332df6", "parents": ["794e4f1c4c8926f52526a262bed640726b9b18b1"], "tags": []}, {"author": "Michelle Goossens \u003cmichelle@masterwayz.nl\u003e", "branch": "default", "desc": "Bug 1733684 - Move the win10-64-source jobs over to the new Win10 2004 Azure workers. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128295", "files": ["python/mozperftest/mozperftest/test/browsertime/visualtools.py", "taskcluster/ci/config.yml", "taskcluster/ci/source-test/python.yml", "taskcluster/ci/startup-test/kind.yml"], "git_node": null, "git_parents": [null], "node": "d629a537c9945939aff0152dc07c3c2edff3e5f5", "parents": ["1ccd82971de9f0d04ab2592c3fd6bb9582332df6"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1734035 - Fix \\ in etlparser.py. r=sparky, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127501", "files": ["testing/talos/talos/xtalos/etlparser.py"], "git_node": null, "git_parents": [null], "node": "d37ecfcfda09ba7de9e8a6a1f1398e9fa201cf02", "parents": ["d629a537c9945939aff0152dc07c3c2edff3e5f5"], "tags": []}, {"author": "Mitchell Hentges \u003cmhentges@mozilla.com\u003e", "branch": "default", "desc": "Bug 1733684 - Resolve mozbuild test compatibility with Py 3.9.5. r=ahal, a=test-only\n\nThere were two failures:\n* One caused by `subprocess.Popen(...)` no longer liking having an\n  `env={}` argument. I couldn't find this documented in the API docs or\n  fixed in a future `3.9.x` release, but it's workaround-able by not\n  setting the redundant parameter.\n* One caused by unexpected characters appearing in a symlink test.\n  However, since we shouldn't be leaning on symlinks on Windows, we skip\n  the test accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128624", "files": ["python/mozbuild/mozbuild/configure/__init__.py", "python/mozbuild/mozpack/test/test_files.py"], "git_node": null, "git_parents": [null], "node": "9596b9ef1cbf7e4be077cbd9e46865694365bc41", "parents": ["d37ecfcfda09ba7de9e8a6a1f1398e9fa201cf02"], "tags": []}, {"author": "surajeet310 \u003csurajeet310@gmail.com\u003e", "branch": "default", "desc": "Bug 1717651 - Removed instances of 'ensure_subprocess_env' from python/mozbuild. r=mhentges, a=test-only\n\nSince Python 2 is no longer used in python/mozbuild, hence 'ensure_subprocess_env' is obsolete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D119791", "files": ["python/mozbuild/mozbuild/artifacts.py", "python/mozbuild/mozbuild/build_commands.py", "python/mozbuild/mozbuild/configure/__init__.py", "python/mozbuild/mozbuild/frontend/gyp_reader.py", "python/mozbuild/mozbuild/mozconfig.py", "python/mozbuild/mozbuild/repackaging/mar.py"], "git_node": null, "git_parents": [null], "node": "c951fdde841991fcce98518d2883fa106797edbb", "parents": ["9596b9ef1cbf7e4be077cbd9e46865694365bc41"], "tags": []}, {"author": "Michelle Goossens \u003cmichelle@masterwayz.nl\u003e", "branch": "default", "desc": "Bug 1733684 - Move the win10-64-source jobs over to the new Win10 2004 Azure workers. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128295", "files": ["taskcluster/ci/startup-test/kind.yml"], "git_node": null, "git_parents": [null], "node": "3803e962c64ad4f24879a4c665021d72b93900ad", "parents": ["c951fdde841991fcce98518d2883fa106797edbb"], "tags": []}, {"author": "Narcis Beleuzu \u003cnbeleuzu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1695612 - Disable tests on Win10-QR for frequent failures. r=MasterWayZ a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D127993", "files": ["toolkit/components/extensions/test/mochitest/chrome.ini"], "git_node": null, "git_parents": [null], "node": "96791378d90217afa74eebb98ba0a8906d8315b8", "parents": ["3803e962c64ad4f24879a4c665021d72b93900ad"], "tags": []}], "date": 1635950649, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "97": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130343", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "8ef4bb8989e4514151ec6be80b887e5dcdeb5139", "parents": ["96791378d90217afa74eebb98ba0a8906d8315b8"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1683062 - Make sure HttpChannelChild::mSuspendCount be updated correctly even if the remote channel is not existed, r=nika, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D119947", "files": ["netwerk/protocol/http/HttpChannelChild.cpp"], "git_node": null, "git_parents": [null], "node": "b08697df780ddca324f469db259f41f8c9e9b919", "parents": ["8ef4bb8989e4514151ec6be80b887e5dcdeb5139"], "tags": []}, {"author": "Ping Chen \u003cremotenonsense@gmail.com\u003e", "branch": "default", "desc": "Bug 1736508 - Make TCPSocket work with ipv6 address again. r=valentin, a=RyanVM\n\nWrap ipv6 address in [ ] when constructing nsIURI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128843", "files": ["dom/network/TCPSocket.cpp", "dom/network/tests/test_tcpsocket_client_and_server_basics.js"], "git_node": null, "git_parents": [null], "node": "7dfabd7cf25845806e8e3f76dbb8fcf744a21a38", "parents": ["b08697df780ddca324f469db259f41f8c9e9b919"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1735588 - Only allow the OMT InitFontList thread to be used if the shared font list is enabled. r=lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128393", "files": ["gfx/thebes/gfxPlatformFontList.cpp"], "git_node": null, "git_parents": [null], "node": "a35d51fc4e7d7497911b737095d1e046493ad6ef", "parents": ["7dfabd7cf25845806e8e3f76dbb8fcf744a21a38"], "tags": []}], "date": 1636043398, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "98": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1739847 - disable browser/components/urlbar/tests/unit/test_unitConversion.js until DST issues get fixed to suppress permanent failures. a=test-only", "files": ["browser/components/urlbar/tests/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "f014c5944c96e6f71b22674e1d888e1c93dc12bf", "parents": ["a35d51fc4e7d7497911b737095d1e046493ad6ef"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130620", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "eab4522d9782ae8608e046bb665b4f5b4fe6627d", "parents": ["f014c5944c96e6f71b22674e1d888e1c93dc12bf"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1735207 - Improve WasmExtendU32Index and WasmWrapU32Index. r=nbp, a=RyanVM\n\nWasmExtendU32Index and WasmWrapU32Index were not GVN-friendly and did\nnot perform constant folding.  (The problem was introduced by the\nsupport for 4GB heaps and 64-bit bounds, which created these nodes.)\nAs a consequence, these nodes impeded bounds check elimination, with\nthe effect that BCE on 64-bit systems did nothing.  BCE on 32-bit\nsystems was likely unaffected by the bug, as the max heap size on\n32-bit is 2GB.\n\nMake these nodes GVN-friendly and add appropriate constant folding.\n\nAdd simple white-box test cases to test that the BCE works properly on\n64-bit and 32-bit both.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128175", "files": ["js/src/jit-test/lib/codegen-x86-test.js", "js/src/jit-test/tests/wasm/bce-x64-ion-codegen.js", "js/src/jit-test/tests/wasm/bce-x86-ion-codegen.js", "js/src/jit/MIR.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/WasmBCE.cpp"], "git_node": null, "git_parents": [null], "node": "3edd7821b9f56325fdf6f42b582f6609d9de8e52", "parents": ["eab4522d9782ae8608e046bb665b4f5b4fe6627d"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1735990 - Ask for the optimizing compiler, not for Ion. r=jseward, a=test-only\n\nThe test case needs to ask for the 'optimizing' compiler to allow it to\nbe loaded with cranelift, and then needs to guard on 'ion' and the\nappropriate architecture to make sense.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128709", "files": ["js/src/jit-test/tests/wasm/bce-x64-ion-codegen.js", "js/src/jit-test/tests/wasm/bce-x86-ion-codegen.js"], "git_node": null, "git_parents": [null], "node": "b17158a445d86a7456a0aae77dde83a16b8a925e", "parents": ["3edd7821b9f56325fdf6f42b582f6609d9de8e52"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1737305 - Don't hardcode app name when checking LegacyProfiles policy. r=mossop, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129315", "files": ["toolkit/profile/moz.build", "toolkit/xre/PolicyChecks.h"], "git_node": null, "git_parents": [null], "node": "9904c4118d7d59c568a88cdc62896971d7fac744", "parents": ["b17158a445d86a7456a0aae77dde83a16b8a925e"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1724488 - Add sponsored content to FirefoxHome policy. r=thecount, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129542", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_firefoxhome.js"], "git_node": null, "git_parents": [null], "node": "b1c3cecb8a3220286056e2adccdff56681d0a8d3", "parents": ["9904c4118d7d59c568a88cdc62896971d7fac744"], "tags": []}, {"author": "William Durand \u003cwill+git@drnd.me\u003e", "branch": "default", "desc": "Bug 1736565 - Determine candidate trees based on the version display in `./mach artifact`. r=nalexander, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128879", "files": ["python/mozbuild/mozbuild/artifacts.py", "python/mozbuild/mozbuild/test/python.ini", "python/mozbuild/mozbuild/test/test_artifacts.py"], "git_node": null, "git_parents": [null], "node": "32276a163c3e8b626cc84442abcea0185367909d", "parents": ["b1c3cecb8a3220286056e2adccdff56681d0a8d3"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1737515 - Null check the result of XrayTraits::ensureHolder(). r=peterv, a=RyanVM\n\nXrayTraits::ensureHolder() can return the result of XrayTraits::createHolder(),\nwhich in turns returns the result of JS_NewObjectWithGivenProto(),\nso we need to null check the result. The other callers already do this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129432", "files": ["js/xpconnect/wrappers/XrayWrapper.h"], "git_node": null, "git_parents": [null], "node": "daa65d44963e88bcc4c4c295aa54116560087e5d", "parents": ["32276a163c3e8b626cc84442abcea0185367909d"], "tags": []}], "date": 1636395046, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "99": {"changesets": [{"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1739847: Respond to summer time. r=adw a=test-only DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D130709", "files": ["browser/components/urlbar/tests/unit/test_unitConversion.js", "browser/components/urlbar/tests/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "64367abc670d7c625e630272871a7e2d6073a6cd", "parents": ["daa65d44963e88bcc4c4c295aa54116560087e5d"], "tags": []}], "date": 1636621777, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}}
}";