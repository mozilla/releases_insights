isUsedColorSchemeDark.html"], "git_node": "0d8d24d3fa5ca59280eab6af585a32ad6a49f33b", "git_parents": ["86b7556c8f346f53d4914989ca1d3ab46b0badb3"], "node": "fabc07a1ba4ff3ad6b65aae32b48b959b7696231", "parents": ["e2bfe5af25936aec1bdbae43eaa2eb3a3f14cf1e"], "tags": []}], "date": 1793969059, "git_changesets": ["0d8d24d3fa5ca59280eab6af585a32ad6a49f33b"], "user": "pchevrel@mozilla.com"}, "29305": {"changesets": [{"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089261 - Update metadata for html/semantics/embedded-content/media-elements/autoplay-with-broken-track.html.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339850\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340289\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/media-elements/autoplay-with-broken-track.html.ini"], "git_node": "6eb1ede22890770792a43fb3846bdac5d54c5fd3", "git_parents": ["0d8d24d3fa5ca59280eab6af585a32ad6a49f33b"], "node": "09de705a22fdb3db4b58e2edcf6cc4b28f64bc3f", "parents": ["fabc07a1ba4ff3ad6b65aae32b48b959b7696231"], "tags": []}], "date": 1793969107, "git_changesets": ["6eb1ede22890770792a43fb3846bdac5d54c5fd3"], "user": "pchevrel@mozilla.com"}, "29306": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2089620 - Register Nimbus pings with Glean  a=pascalc\n\nThe nimbus-targeting-context ping has not been regsitered with Glean and\nthus we have been submitting empty enrollment status telemetry on the\nfirst ping submission from each client.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340026\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340326\n", "files": ["mobile/android/android-components/samples/glean/src/main/java/org/mozilla/samples/glean/GleanApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/GleanHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/GleanMetricsService.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/telemetry/GleanMetricsService.kt"], "git_node": "6fcb2e7fbdc18f3665b76e129bd63ae29902f6ca", "git_parents": ["6eb1ede22890770792a43fb3846bdac5d54c5fd3"], "node": "3f5783d1bf63070f72aead3e2ab3c9f676a04610", "parents": ["09de705a22fdb3db4b58e2edcf6cc4b28f64bc3f"], "tags": []}], "date": 1793969889, "git_changesets": ["6fcb2e7fbdc18f3665b76e129bd63ae29902f6ca"], "user": "pchevrel@mozilla.com"}, "29307": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088158 - Move Wrexham AFC widget strings out from preview into newtab.ftl for localization.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339526\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340390\n", "files": ["browser/locales-preview/newtabPreview.ftl", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "fbc02830401bec20ef0e88c6f5799ee5ec330327", "git_parents": ["6fcb2e7fbdc18f3665b76e129bd63ae29902f6ca"], "node": "f42d371810ab29851be6029775a250f30f3a8368", "parents": ["3f5783d1bf63070f72aead3e2ab3c9f676a04610"], "tags": []}], "date": 1793982056, "git_changesets": ["fbc02830401bec20ef0e88c6f5799ee5ec330327"], "user": "pchevrel@mozilla.com"}, "29308": {"changesets": [{"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2085361 - Enhance Dismiss Telemetry for card stack with resolution, completion status + count  a=pascalc\n\n- Track completion status for visible cards, send a Dismiss event with the aggregated metrics on dismiss\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339336\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340386\n", "files": ["browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/docs/asrouter-newtab-multistage-message.md", "browser/components/asrouter/tests/browser/browser_asrouter_newtab_multistage_messages.js"], "git_node": "afc5c8b2ec516840a15039a18a6825eb0225e83d", "git_parents": ["fbc02830401bec20ef0e88c6f5799ee5ec330327"], "node": "d5042466cf337e1ea1d4f60ebe02c7d6c94cd4b8", "parents": ["f42d371810ab29851be6029775a250f30f3a8368"], "tags": []}], "date": 1793982583, "git_changesets": ["afc5c8b2ec516840a15039a18a6825eb0225e83d"], "user": "pchevrel@mozilla.com"}, "29309": {"changesets": [{"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2089066 - Fix failing verifyLongTapShortcutDisplaysEditShortcutTest efficiency UI test  a=pascalc\n\nThe UI test was failing because on the Customize screen, the test's tap on the \"Share\" option was landing while the settings list was still gliding from its scroll, so the tap got swallowed and Share was never actually selected, even though the test thought the click succeeded.\n\nTo fix this, instead of tapping the screen where the \"Share\" row appeared (the old ViewActions.click(), which could miss while the list was still gliding to a stop), we now use performClick() to tell the row to activate itself directly \u2014 so it gets selected reliably, even mid-scroll.\n\nThe UI test successfully passed 50x on Firebase \u2705\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339923\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340396\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/UiActions.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsCustomizeSimpleToolbarTest.kt"], "git_node": "77a199b1c949aac578161efae78a402a84e32a01", "git_parents": ["afc5c