: ["3fb9c23dcfb033037da71f2eb6262ba7001574d4", "bf189cd90bfdc5e6d8f2f8ed41bedc853cc0ced3"], "user": "ffxbld@lando.moz.tools"}, "29449": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086014.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342489\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342992\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "eafe6218056fe720ed008e0d939393a7214c8a1a", "git_parents": ["bf189cd90bfdc5e6d8f2f8ed41bedc853cc0ced3"], "node": "efef2d9102c010eb4a78418509a8da42fdae64c2", "parents": ["2352ca106dd91a4729ee149e69d3a6e21cbd37d3"], "tags": []}], "date": 1794819950, "git_changesets": ["eafe6218056fe720ed008e0d939393a7214c8a1a"], "user": "pchevrel@mozilla.com"}, "29450": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 1: Make `HTMLEditor::GetTableCellElementAt` callers ignore generated cell  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341688\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343008\n", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLEditorInlines.h", "editor/libeditor/HTMLTableEditor.cpp"], "git_node": "9dec7935f99b113b7c46cddd3f3599fad9b4a920", "git_parents": ["eafe6218056fe720ed008e0d939393a7214c8a1a"], "node": "dfded7923071ee14756f3481c7afe078703d36b8", "parents": ["efef2d9102c010eb4a78418509a8da42fdae64c2"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 2: Make `EditorBase::CollapseSelectionTo` return error if the editor tries to collapse selection into a native anonymous subtree  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341689\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343009\n", "files": ["editor/libeditor/EditorBase.h"], "git_node": "99c1caf442c559f3e26a8b87b8f1ba467539f4ef", "git_parents": ["9dec7935f99b113b7c46cddd3f3599fad9b4a920"], "node": "9f77a44862b3250df3898b3bfeea86f892aeec8f", "parents": ["dfded7923071ee14756f3481c7afe078703d36b8"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 3: Make the style editor ensure handling only editable ranges  a=pascalc\n\nChrome considers whether a range is editable with the start boundary\ncontainer. However, if only the start boundary container is editable,\nonly editable nodes are styled with `execCommand`.\n\nOn the other hand, we don't check it first. Therefore, the range may\nstart or end at non-editable node and that may cause modifying the\nnon-editable node.\n\nFor now, we should ignore ranges whose start or end container is\nnon-editable to avoid the case that the non-editable reason is that\nit's in native anonymous subtree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341690\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343010\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/HTMLStyleEditor.cpp", "testing/web-platform/meta/editing/run/bold.html.ini", "testing/web-platform/tests/editing/data/bold.js"], "git_node": "b05d05e7856e66d5f127982b5633a487e1e37d62", "git_parents": ["99c1caf442c559f3e26a8b87b8f1ba467539f4ef"], "node": "f2133596a0890f7c1bde2e37df328498372d8e30", "parents": ["9f77a44862b3250df3898b3bfeea86f892aeec8f"], "tags": []}], "date": 1794820170, "git_changesets": ["9dec7935f99b113b7c46cddd3f3599fad9b4a920", "99c1caf442c559f3e26a8b87b8f1ba467539f4ef", "b05d05e7856e66d5f127982b5633a487e1e37d62"], "user": "pchevrel@mozilla.com"}, "29451": {"changesets": [{"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092355 - Block Metal ANGLE WebGL on devices with NVIDIA GPU.  a=pascalc\n\nANGLE's Metal backend does not support NVIDIA GPUs, so block Metal ANGLE\nWebGL when an NVIDIA GPU is detected.\n\nIn theory we could keep it enabled when a non-NVIDIA GPU is also\npresent, and ensure we always select the non-NVIDIA one. But it has been\nobserved that GfxInfo will report both an Intel and AMD/NVIDIA adapter\nas being present when in actuality only the AMD/NVIDIA GPU is\nusable. Therefore out of an abundance of caution we block Metal ANGLE\nWebGL when any NVIDIA GPU is detected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342598\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343060\n", "files": ["widget/cocoa/GfxInfo.mm"], "git_node": "8f9e0433d7f96be6e838ba81894ec9c1f61460b0", "git_parents": ["b05d05e7856e66d5f127982b5633a487e1e37d62"], "node": "3b1d8e94d4468e8c656c384a23ecf06491ddcdae", "parents": ["f2133596a0890f7c1bde2e37df328498372d8e30"], "tags": []}], "date": 1794822878, "git_changesets": ["8f9e0433d7f96be6e838ba81894ec9c1f61460b0"], "user": "pchevrel@mozilla.com"}, "29452": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080757 - Also send opener window id when creating browsing context.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334022\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342601\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "dom/ipc/ContentParent.cpp", "dom/ipc/PContent.ipdl"], "git_node": "f6d939e0f747887371caf98ee81b8aa2c67f0bc4", "git_parents": ["8f9e0433d7f96be6e838ba81894ec9c1f61460b0"], "node": "538ba5aa03328c61b80aecfa553ce446b73d48b9", "parents": ["3b1d8e94d4468e8c656c384a23ecf06491ddcdae"], "tags": ["DEVEDITION_161_0b4_BUILD1", "DEVEDITION_161_0b4_RELEASE", "FIREFOX-ANDROID_161_0b4_BUILD1", "FIREFOX-ANDROID_1