 not.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337624\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341719\n", "files": ["toolkit/components/telemetry/docs/data/downgrade-ping.md", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsAppRunner.h", "toolkit/xre/test/gtest/TestDowngradePing.cpp"], "git_node": "e2b639e46458e54fefb8b075d171a9a32cd1347e", "git_parents": ["24116d03055a3604b9697866b10d92884d0e81ba"], "node": "ebde4b714d4e872bea874411ca665c125b2ed592", "parents": ["952bac1e3e2eda8e59e7fc671a32b35ff0a604d6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090259 - Backport upstream Breakpad fix to include stdlib.h in string_utils.cc.  a=diannaS\n\nNewer mingw-w64 headers no longer include stdlib.h from assert.h, which string_utils.cc relied on for mbstowcs\nand wcstombs. This is upstream Breakpad commit c6ec7108ee82ce21f0c0b1d733d4817583b91743.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340777\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341717\n", "files": ["toolkit/crashreporter/breakpad-patches/32-stdlib-include.patch", "toolkit/crashreporter/google-breakpad/src/common/windows/string_utils.cc"], "git_node": "b36079917571c9df89059235dbe2f745c41e1c9e", "git_parents": ["e2b639e46458e54fefb8b075d171a9a32cd1347e"], "node": "b5ed9e9596adcbe1bb8b94675aea4b6a4bec9fad", "parents": ["ebde4b714d4e872bea874411ca665c125b2ed592"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090259 - Update mingw to upstream revision ae5227f620699c8d532609ae30dc66432b903dab.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340778\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341718\n", "files": ["taskcluster/kinds/fetch/toolchains.yml"], "git_node": "76e2ae908d6a655a4f57bcdc15471f0eebb19b8e", "git_parents": ["b36079917571c9df89059235dbe2f745c41e1c9e"], "node": "0bfab5bc07e01c0a82aec46ce589df06cb89559f", "parents": ["b5ed9e9596adcbe1bb8b94675aea4b6a4bec9fad"], "tags": []}], "date": 1794426654, "git_changesets": ["e2b639e46458e54fefb8b075d171a9a32cd1347e", "b36079917571c9df89059235dbe2f745c41e1c9e", "76e2ae908d6a655a4f57bcdc15471f0eebb19b8e"], "user": "dsmith@mozilla.com"}, "29377": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/compose/base/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/feature/protection-dashboard/src/main/res/values-oc/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-oc/strings.xml", "mobile/android/fenix/app/src/main/res/values-pa-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml", "mobile/android/focus-android/app/src/main/res/values-ca/strings.xml"], "git_node": "a1249eb10998be9e8dd5017811a581c08cf65e28", "git_parents": ["76e2ae908d6a655a4f57bcdc15471f0eebb19b8e"], "node": "55d3fa6acc5db5dbd1c953643700ac65d8fa0585", "parents": ["0bfab5bc07e01c0a82aec46ce589df06cb89559f"], "tags": []}], "date": 1794449838, "git_changesets": ["a1249eb10998be9e8dd5017811a581c08cf65e28"], "user": "ffxbld@lando.moz.tools"}, "29378": {"changesets": [{"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 2087261 - Apply paragraph styles to attributed strings in native menus.  a=pascalc\n\nWhen a `NSMenuItem` has an `attributedTitle`, it defaults to an unstyled appearance, which results in some undesired effects such as clipping and incorrectly aligned RTL titles. Apply our own paragraph styles to restore the expected formatting.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341217\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341921\n", "files": ["widget/cocoa/nsMenuUtilsX.mm"], "git_node": "20f50114954b55794e3c750c6813adc426bfeba0", "git_parents": ["a1249eb10998be9e8dd5017811a581c08cf65e28"], "node": "9cbb359856f81cf4f817eee85eb5908b2f8c6d1d", "parents": ["55d3fa6acc5db5dbd1c953643700ac65d8fa0585"], "tags": []}], "date": 1794473231, "git_changesets": ["20f50114954b55794e3c750c6813adc426bfeba0"], "user": "pchevrel@mozilla.com"}, "29379": {"changesets": [{"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083276 - Update metadata for /encrypted-media/* tests.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341411\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341724\n", "files": ["testing/web-platform/meta/encrypted-media/drm-keystatuses-multiple-sessions.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-clear-encrypted.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-multisession.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html.ini"], "git_node": "9df98c45fc4091c622f766234d71ef57648895a4", "git_parents": ["20f50114954b55794e3c750c6813adc426bfeba0"], "node": "71e49c03fc91dcbe1e6a7b39e15940b0169e81b7", "parents": ["9cbb359856f81cf4f817eee85eb5908b2f8c6d1d"], "tags": []}], "date": 1794473283, "git_changesets": ["9df98c45fc4091c622f766234d71ef57648895a4"], "user": "pchevrel@mozilla.com"}, "29380": {"changesets": [{"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2072398. Unregister named timelines and their animations when an element is removed.  a=pascalc\n\nUnbinding an element destroys its timeline and animation collections, but we\ndidn't remove timelines from TimelineManager's name maps or the animations from\nnsAnimationManager's mAnimationsWithNamedTimeline. They were only updated when\nthe element was restyled. As a result, every named timeline lookup kept scanning\nthe stale entries, so rebuilding the same content got slower with each pass, and\nthe entries kept the removed subtrees alive until the pres context went away.\n(Bug 2021326 fixed removal of timeline-scope data.)\n\nThis commit makes TimelineCollection unregister its timelines in its destructor,\nso the manager's own destroy paths no longer do it themselves, and has\nCSSAnimation::CancelFromStyle() drop the animation's named timeline reference\nthrough the code the JS timeline setter already used for that, moved into\nCSSAnimation. The manager is looked up through the owning element so that an\neffect retargeted by script does not matter, and the animation is also dropped\nfrom the deferred update set. This covers the explicit removals in\nnsAnimationManager::DoUpdateAnimations(), which are dropped. Animations attached\nto an unregistered timeline are re-resolved by a later patch in this bug.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340050\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341178\n", "files": ["dom/animation/Animation.cpp", "dom/animation/Animation.h", "dom/animation/CSSAnimation.cpp", "dom/animation/CSSAnimation.h", "layout/style/TimelineCollection.cpp", "layout/style/TimelineCollection.h", "layout/style/TimelineManager.cpp", "layout/style/TimelineManager.h", "layout/style/nsAnimationManager.cpp", "testing/web-platform/tests/scroll-animations/css/animation-timeline-shared-name-removal.html", "testing/web-platform/tests/scroll-animations/css/scroll-timeline-source-removal.html"], "git_node": "9d427164de77a14815d183ee0723078887b8c9a9", "git_parents": ["9df98c45fc4091c622f766234d71ef57648895a4"], "node": "c1c42ae38c8213abd1c74aa1d17ce6d3f235cfe1", "parents": ["71e49c03fc91dcbe1e6a7b39e15940b0169e81b7"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2072398. Run sequential tasks from the style traversal driver rather than from SequentialTaskList's Drop.  a=pascalc\n\nThe tasks ran from SequentialTaskList's Drop, so running them safely relied on\nThreadLocalStyleContext declaring its caches before its task list, and the\ndriver never knew whether a traversal had queued any. Now traverse_dom()\ncollects the tasks from every thread-local context, drops the contexts, and\nruns the tasks itself, so that a later patch can act only after a batch has\nactually run. Dropping a context with unrun tasks is now a debug assertion\nfailure.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340395\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341179\n", "files": ["servo/components/style/context.rs", "servo/components/style/driver.rs"], "git_node": "00c797dbb893f9b213a9ab63a29df9f90b8f2384", "git_parents": ["9d427164de77a14815d183ee0723078887b8c9a9"], "node": "d3b0febe0278bb49b1b5cc5d6050e298b555b83a", "parents": ["c1c42ae38c8213abd1c74aa1d17ce6d3f235cfe1"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2072398. Batch named timeline lookups until the style traversal is done.  a=pascalc\n\nGecko_UpdateAnimations() re-resolved every animation referring to a timeline\nname as soon as one element registered a timeline of that name, and every\nanimation with any named timeline as soon as one element's timeline-scope\nchanged. Those calls exist because the update tasks run in breadth-first order,\nnot tree order, so an animation can be created before the element providing its\ntimeline is processed. With N elements sharing one name in one traversal, that\nis N passes over up to N animations, each doing a lookup that scans the N\ntimelines.\n\nInstead, we now record the affected names in nsAnimationManager and resolve them\nfrom a DomTraversal hook that the traversal driver calls once it has run the\ntraversal's sequential tasks, when every element of the traversal has registered\nits timelines. A timeline-scope change now marks only the names it scoped before\nand after the change, or everything for `all`. Names marked outside a traversal,\nby a timeline's element leaving the tree, are flushed at the end of the next\ntraversal that runs an UpdateAnimations task, or from\nUpdateDeferredTimelineChanges() in the next frame, so such animations re-resolve\ninstead of keeping a timeline on a detached element. That covers the FIXME for\nbug 1774060 in TimelineCollection's destructor.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340054\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341180\n", "files": ["layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "layout/style/TimelineCollection.cpp", "layout/style/TimelineManager.cpp", "layout/style/TimelineManager.h", "layout/style/TimelineScope.h", "layout/style/nsAnimationManager.cpp", "layout/style/nsAnimationManager.h", "servo/components/style/driver.rs", "servo/components/style/gecko/traversal.rs", "servo/components/style/traversal.rs"], "git_node": "7e8c6d48ab71653ddbd6162ecf0cc35b9d856d44", "git_parents": ["00c797dbb893f9b213a9ab63a29df9f90b8f2384"], "node": "910f233bad145b56bf00419a2ba1267f0b51ae40", "parents": ["d3b0febe0278bb49b1b5cc5d6050e298b555b83a"], "tags": []}], "date": 1794473439, "git_changesets": ["9d427164de77a14815d183ee0723078887b8c9a9", "00c797dbb893f9b213a9ab63a29df9f90b8f2384", "7e8c6d48ab71653ddbd6162ecf0cc35b9d856d44"], "user": "pchevrel@mozilla.com"}, "29381": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080094 - On macOS, disable leak-checking for the FontData struct.  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341587\n", "files": ["gfx/thebes/FontData.h"], "git_node": "bbb141ed7f26c09bada219e00fa90b3ce95c1cc8", "git_parents": ["7e8c6d48ab71653ddbd6162ecf0cc35b9d856d44"], "node": "eb9e72c768f1a24b9fb9e9a1fea4ad03b724f07f", "parents": ["910f233bad145b56bf00419a2ba1267f0b51ae40"], "tags": []}], "date": 1794473580, "git_changesets": ["bbb141ed7f26c09bada219e00fa90b3ce95c1cc8"], "user": "pchevrel@mozilla.com"}, "29382": {"changesets": [{"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091550 - Use generic error for vpn unavailable -  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341608\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341612\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_box.js"], "git_node": "e02f253ab7cb5751c9a2d1a5fdb4861ed642d571", "git_parents": ["bbb141ed7f26c09bada219e00fa90b3ce95c1cc8"], "node": "a12e8c9e20b2e0b7ab93022c0007e7995c56ce68", "parents": ["eb9e72c768f1a24b9fb9e9a1fea4ad03b724f07f"], "tags": []}], "date": 1794473625, "git_changesets": ["e02f253ab7cb5751c9a2d1a5fdb4861ed642d571"], "user": "pchevrel@mozilla.com"}, "29383": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2088486 - Make Selection::Repaint do its iteration over a copy of the ranges instead of the main array.  a=pascalc\n\nOur call to SelectFrames can mutate mStyledRanges, including changing its\nlength. So, to avoid walking off the end of the array and aborting, it's safer\nto iterate over a copy of the array, just as we do in\nSelection::DeleteFromDocument().\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341481\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341636\n", "files": ["dom/base/Selection.cpp", "testing/web-platform/tests/css/css-highlight-api/crashtests/firefox-bug-2088486.html"], "git_node": "4da033154c0587c749b33b6c5bbd7c54460aa358", "git_parents": ["e02f253ab7cb5751c9a2d1a5fdb4861ed642d571"], "node": "55635b3d3f382362c948cece6e1b14c962753a1c", "parents": ["a12e8c9e20b2e0b7ab93022c0007e7995c56ce68"], "tags": []}], "date": 1794473681, "git_changesets": ["4da033154c0587c749b33b6c5bbd7c54460aa358"], "user": "pchevrel@mozilla.com"}, "29384": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089206 - Keep alt-svc mappings when a racing connection attempt fails,  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340348\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341253\n", "files