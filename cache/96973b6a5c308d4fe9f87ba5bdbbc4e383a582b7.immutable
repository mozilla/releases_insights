d9b24a0e11330e630 with FIREFOX_160_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "968cf760b27e02318ce79fe6e567e77a873e1a5e", "git_parents": ["d969d8ff7dc7d2aef7ba8b339b6d1d5cb75efce7"], "node": "de650639e1818af429c0fc2677c76898fac897b7", "parents": ["ce9549362989c7f2a51e3e1e74349d34290d4eae"], "tags": []}], "date": 1794317325, "git_changesets": ["968cf760b27e02318ce79fe6e567e77a873e1a5e"], "user": "ffxbld@lando.moz.tools"}, "29346": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 07da6c6c016add6f8270a4ac0e53320df73b1b1c with FIREFOX_115_45_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "3311bf31e72bca1416963ff90ac5c635f39d0407", "git_parents": ["968cf760b27e02318ce79fe6e567e77a873e1a5e"], "node": "488194b303066e73766448d2eccf83068c4ae773", "parents": ["de650639e1818af429c0fc2677c76898fac897b7"], "tags": []}], "date": 1794317401, "git_changesets": ["3311bf31e72bca1416963ff90ac5c635f39d0407"], "user": "ffxbld@lando.moz.tools"}, "29347": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a9effd9e521653405f0ffd311e8edf90bde92237 with FIREFOX_153_7_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a539e6f42b0f18f00f3bcaa502d2346d960d28d1", "git_parents": ["3311bf31e72bca1416963ff90ac5c635f39d0407"], "node": "88991233cd0852cc76736201ab81c73026612c1b", "parents": ["488194b303066e73766448d2eccf83068c4ae773"], "tags": []}], "date": 1794317503, "git_changesets": ["a539e6f42b0f18f00f3bcaa502d2346d960d28d1"], "user": "ffxbld@lando.moz.tools"}, "29348": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging d84e7a6936554efe26097d9d9b24a0e11330e630 with FIREFOX-ANDROID_160_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ab64a73539fed2e0efabb103dcd4766c2a2107c9", "git_parents": ["a539e6f42b0f18f00f3bcaa502d2346d960d28d1"], "node": "0793d949800e08d57773d890c9f10bc09883d5f3", "parents": ["88991233cd0852cc76736201ab81c73026612c1b"], "tags": []}], "date": 1794317771, "git_changesets": ["ab64a73539fed2e0efabb103dcd4766c2a2107c9"], "user": "ffxbld@lando.moz.tools"}, "29349": {"changesets": [{"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2087822. Apply timeline-scope on a pseudo-element to the pseudo-element itself.  a=diannaS\n\nA `timeline-scope` on ::before or ::after was either ignored, because generated\ncontent only goes through animation processing when its style specifies\nanimations or timelines or its originating element already has animation data,\nor, when it was processed, recorded against the originating element, where it\nlimited the names across that element's whole subtree and overwrote the scope\nthe originating element declared itself. The spec applies the property to the\npseudo-element, which has no descendants beyond its own generated content.\n\nMake Servo_ComputedValues_NeedsAnimationTraversal() also report\n`timeline-scope`, so that the scope is registered when the pseudo-element is\ncreated rather than only once it animates, and, since ElementAnimationData\nalready keeps data per pseudo, store and look the scope up with the pseudo\nrequest and walk the lookup from the pseudo-element rather than its originating\nelement.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340077\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340493\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/style/GeckoBindings.cpp", "layout/style/TimelineManager.cpp", "layout/style/TimelineManager.h", "layout/style/nsAnimationManager.cpp", "servo/ports/geckolib/glue.rs", "testing/web-platform/tests/scroll-animations/css/timeline-scope-on-pseudo.html"], "git_node": "7c2729b6df572c8994d8fc96fd0f81b7110e66ee", "git_parents": ["5e5e11b5bdc2e829b752640b7a04c8c76fd2929d"], "node": "39f34e1656254065ef522574c878bce9aad3cc18", "parents": ["cb1aadd195cc2d8b0a6b985219d9a4dbe1afcc13"], "tags": []}], "date": 1794320886, "git_changesets": ["7c2729b6df572c8994d8fc96fd0f81b7110e66ee"], "user": "dsmith@mozilla.com"}, "29350": {"changesets": [{"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089207 - Only activate CTAParagraph links on keyup when the key was pressed on them.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339992\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340923\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/CTAParagraph.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/tests/unit/content-src/components/CTAParagraph.test.jsx"], "git_node": "633ba2488b9391563e38a61aa26099aa5216e9d7", "git_parents": ["7c2729b6df572c8994d8fc96fd0f81b7110e66ee"], "node": "5ca476c97d3daada7053630097c39b6001e2d396", "parents": ["39f34e1656254065ef522574c878bce9aad3cc18"], "tags": []}], "date": 1794326619, "git_changesets": ["633ba2488b9391563e38a61aa26099aa5216e9d7"], "user": "dsmith@mozilla.com"}, "29351": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090281 - Expire the FramedWidgetsFeed manifest cache after 30 minutes instead of at the local day change.  a=diannaS\n\nFramedWidgetsFeed.isStale() now treats a cached manifest as stale once it is 30 minutes old (CACHE_EXPIRY_MS), instead of when the local calendar day changes. A lastUpdated timestamp in the future (e.g. the system clock was set back) is also treated as stale, so a skewed clock can't pin the cache.\n\nRefreshes still happen through the existing SYSTEM_TICK / INIT paths. If the fetch fails, the stale cached manifest is still served as before.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340530\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340971\n", "files": ["browser/extensions/newtab/lib/Widgets/FramedWidgetsFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_FramedWidgetsFeed.js"], "git_node": "f3c450e9f17a41af431d456ceeb971052d2d34e3", "git_parents": ["633ba2488b9391563e38a61aa26099aa5216e9d7"], "node": "aaab088efba6ed9b564d93a6443b9808ef1c9152", "parents": ["5ca476c97d3daada7053630097c39b6001e2d396"], "tags": []}], "date": 1794326724, "git_changesets": ["f3c450e9f17a41af431d456ceeb971052d2d34e3"], "user": "dsmith@mozilla.com"}, "29352": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088960 - Bump taskcluster-taskgraph to 24.7.0.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340345\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341279\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt"], "git_node": "41c2eebd9cea942526c0a21cc1e16f8c8b089d0a", "git_parents": ["f3c450e9f17a41af431d456ceeb971052d2d34e3"], "node": "30c80543bc9738726def9677a0a3f463d7de1c1f", "parents": ["aaab088efba6ed9b564d93a6443b9808ef1c9152"], "tags": []}], "date": 1794326910, "git_changesets": ["41c2eebd9cea942526c0a21cc1e16f8c8b089d0a"], "user": "dsmith@mozilla.com"}, "29353": {"changesets": [{"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090333 - Reduce the gap between the moz-widget header and content.  a=diannaS\n\nPadded moz-widget cards now leave --space-xsmall between the header and\ncontent, the same spacing as the other New Tab widgets.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340546\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341181\n", "files": ["browser/components/widgets/content/moz-widget.css"], "git_node": "f36d50a8e289ab49534f3bef1ab1538838290e55", "git_parents": ["41c2eebd9cea942526c0a21cc1e16f8c8b089d0a"], "node": "f3edbd790030f4cb8c2f903c03ea1d4a42680d4a", "parents": ["30c80543bc9738726def9677a0a3f463d7de1c1f"], "tags": []}], "date": 1794326931, "git_changesets": ["f36d50a8e289ab49534f3bef1ab1538838290e55"], "user": "dsmith@mozilla.com"}, "29354": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2089913 - Use a pin instead of a hold mark.  a=diannaS\n\nThe hold mark doesn't properly handle the case where there's an even\nnewer version of the package.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340258\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341471\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "004f40e0c58768152a8a958f060870bbc58663b8", "git_parents": ["f36d50a8e289ab49534f3bef1ab1538838290e55"], "node": "86921255d37ed83e38b0077435afe729b6c5f45e", "parents": ["f3edbd790030f4cb8c2f903c03ea1d4a42680d4a"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2089905 - Fortify code added in bug 2084865.  a=diannaS\n\nWhile here, also fortify what was added in bug 1984380.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340250\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341472\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "43dc8da031c08916a7905f3d7988c6b951a569f5", "git_parents": ["004f40e0c58768152a8a958f060870bbc58663b8"], "node": "e50baa414f78d790835624c449fdd77074679e39", "parents": ["86921255d37ed83e38b0077435afe729b6c5f45e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089888 - Stop holding ca-certificates at a fixed version in the Ubuntu 22.04 images.  a=diannaS\n\nThe 22.04 images are not built from a snapshot, so they already get a current ca-certificates from\njammy-updates, and holding the older package broke installing ca-certificates-java, which depends on the newer\none.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340222\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341473\n", "files": ["taskcluster/docker/debian-raw/Dockerfile"], "git_node": "ee01cda34f01c68602e6fbdb3ca15ebbfffe4143", "git_parents": ["43dc8da031c08916a7905f3d7988c6b951a569f5"], "node": "8f7165ed6472331e93527732085632c7becfbe32", "parents": ["e50baa414f78d790835624c449fdd77074679e39"], "tags": []}], "date": 1794331109, "git_changesets": ["004f40e0c58768152a8a958f060870bbc58663b8", "43dc8da031c08916a7905f3d7988c6b951a569f5", "ee01cda34f01c68602e6fbdb3ca15ebbfffe4143"], "user": "dsmith@mozilla.com"}, "29355": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075411 - Reject a seekable streaming upload body that can't be cloned  a=diannaS\n\nA streaming upload body skips NormalizeUploadStream(), as a pipe can't be\nbuffered up front.  A seekable one, such as a Blob's stream, can still be\nrewound by the channel for a redirect or an auth retry, so it must be\ncloneable for nsHttpTransaction to read a clone of it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340636\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340934\n", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "a505433e74e34da6d766b85f02a27f6d81dcf665", "git_parents": ["ee01cda34f01c68602e6fbdb3ca15ebbfffe4143"], "node": "c02a845a995582e27b01fe17fe67081fc1d5198a", "parents": ["8f7165ed6472331e93527732085632c7becfbe32"], "tags": []}], "date": 1794344481, "git_changesets": ["a505433e74e34da6d766b85f02a27f6d81dcf665"], "user": "dsmith@mozilla.com"}, "29356": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090902.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340885\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340995\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "3be3f31ef73225e4349f19afd9ad19217b2e3541", "git_parents": ["a505433e74e34da6d766b85f02a27f6d81dcf665"], "node": "2f148ad41fe8e7ad275bd66cd20e40cf71d13676", "parents": ["c02a845a995582e27b01fe17fe67081fc1d5198a"], "tags": []}], "date": 1794344504, "git_changesets": ["3be3f31ef73225e4349f19afd9ad19217b2e3541"], "user": "dsmith@mozilla.com"}, "29357": {"changesets": [{"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2089890 - [loong64] Allocate stack slot for cycle-breaking at use.  a=diannaS\n\nThis mirrors the MoveEmitterARM64 pattern.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340225\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340859\n", "files": ["js/src/jit-test/tests/wasm/simd/move-cycle.js", "js/src/jit/loong64/MoveEmitter-loong64.cpp", "js/src/jit/loong64/MoveEmitter-loong64.h"], "git_node": "be28dd68878893ebeb661172ff8ea49561703ec8", "git_parents": ["3be3f31ef73225e4349f19afd9ad19217b2e3541"], "node": "d56e6e419f8a476a487b051b202cedd28f6dfe3e", "parents": ["2f148ad41fe8e7ad275bd66cd20e40cf71d13676"], "tags": []}], "date": 1794345089, "git_changesets": ["be28dd68878893ebeb661172ff8ea49561703ec8"], "user": "dsmith@mozilla.com"}, "29358": {"changesets": [{"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2087803 - Land assets for final animated card to improve load time  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339197\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340454\n", "files": ["browser/components/asrouter/content/assets/hnt-center-animated-no-loop.svg", "browser/components/asrouter/jar.mn", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs"], "git_node": "00c68bcb700f0616bc5e995c18baaf11