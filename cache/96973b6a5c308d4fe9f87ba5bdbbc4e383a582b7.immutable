3", "parents": ["ef76f08bb44bbad5e1bf4329cc0ed897cc916a31"], "tags": []}], "date": 1794554752, "git_changesets": ["dc58edbf08e2c0759032db64619c428c1b92518b"], "user": "pchevrel@mozilla.com"}, "29407": {"changesets": [{"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092200 - Enable reinstalls feature by default in all channels.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342268\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342296\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "324cee93dc91dc01b3c18401cbac8439b2074893", "git_parents": ["dc58edbf08e2c0759032db64619c428c1b92518b"], "node": "fcdca0ce97fe45653d4468b3411c63f8f34273c2", "parents": ["77127c9017a769cda13867126a08bb124aae2bb3"], "tags": []}], "date": 1794554776, "git_changesets": ["324cee93dc91dc01b3c18401cbac8439b2074893"], "user": "pchevrel@mozilla.com"}, "29408": {"changesets": [{"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091596 - Expand ANGLE Radeon GFX10 buffer upload workaround to all AMD GPUs.  a=pascalc\n\nIn bug 2074540 we disabled the unsynchronized glMapBufferRange fast path\nfor DrawTargetWebgl buffer uploads on Radeon GFX10 GPUs when ANGLE is\nenabled, falling back to glBufferSubData. We have now received reports\nof a similar bug on additional AMD GPUs.\n\nAvoid the bug by taking the glBufferSubData path on all AMD GPUs.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342064\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342324\n", "files": ["dom/canvas/WebGLBuffer.cpp", "gfx/gl/GLContext.cpp", "gfx/gl/GLContext.h", "gfx/gl/GLContextTypes.h"], "git_node": "f5ccfaa20d1aed6e7cf07942ac884dacd48be139", "git_parents": ["324cee93dc91dc01b3c18401cbac8439b2074893"], "node": "0e923ff9146e4b0fcd368c8185b60040ea2e48cb", "parents": ["fcdca0ce97fe45653d4468b3411c63f8f34273c2"], "tags": []}], "date": 1794554798, "git_changesets": ["f5ccfaa20d1aed6e7cf07942ac884dacd48be139"], "user": "pchevrel@mozilla.com"}, "29409": {"changesets": [{"author": "Ashley Hale \u003cahale@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068592 - call Finish before BlitFramebuffer for some cases on Mali  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341652\n", "files": ["dom/canvas/WebGLFramebuffer.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "947e68f9b7ce7af5676ec3691e6159de15f38480", "git_parents": ["f5ccfaa20d1aed6e7cf07942ac884dacd48be139"], "node": "d9fee315e99e6c1ff9fd6bc323f6a51d28f41e93", "parents": ["0e923ff9146e4b0fcd368c8185b60040ea2e48cb"], "tags": []}], "date": 1794554875, "git_changesets": ["947e68f9b7ce7af5676ec3691e6159de15f38480"], "user": "pchevrel@mozilla.com"}, "29410": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090172: Hold a strong reference to the main-thread XHR across worker abort.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340567\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342184\n", "files": ["dom/xhr/XMLHttpRequestWorker.cpp"], "git_node": "4327fd987c57d8b99a62dce4f273c83b49c5d245", "git_parents": ["947e68f9b7ce7af5676ec3691e6159de15f38480"], "node": "d02b8d1eda864b5be8c1f223171cb0716b49fcad", "parents": ["d9fee315e99e6c1ff9fd6bc323f6a51d28f41e93"], "tags": []}], "date": 1794555434, "git_changesets": ["4327fd987c57d8b99a62dce4f273c83b49c5d245"], "user": "pchevrel@mozilla.com"}, "29411": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088854.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341614\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341918\n", "files": ["gfx/skia/skia/src/core/SkAnalyticEdge.h", "gfx/skia/skia/src/core/SkEdgeBuilder.cpp", "gfx/skia/skia/src/core/SkEdgeBuilder.h", "gfx/skia/skia/src/core/SkScan_AAAPath.cpp"], "git_node": "d1458852860f9d069466ed773507d28528e8034a", "git_parents": ["4327fd987c57d8b99a62dce4f273c83b49c5d245"], "node": "700f7b2d819a69a56f3ed771fa1b3266a9e2b103", "parents": ["d02b8d1eda864b5be8c1f223171cb0716b49fcad"], "tags": []}], "date": 1794555457, "git_changesets": ["d1458852860f9d069466ed773507d28528e8034a"], "user": "pchevrel@mozilla.com"}, "29412": {"changesets": [{"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2091233 - Optimize requestUiThreadCallback.  a=pascalc\n\nWhen posting a Runnable task to the Android UI thread, we use\n`GeckoThread.requestUiThreadCallback()`. Finally, `RunAndroidUiTasks`\nwill be called to run tasks in the queue. `requestUiThreadCallback()` is\ncalled multiple times, and then postDelayed() is called multiple times\ntoo, even if we have already scheduled a task to run\n`RunAndroidUiTasks`. This is not necessary, and we can optimize it by\nonly calling postDelayed() once.\n\nAndroid 17's new concurrent message queue always allocates a `Message`\nobject, not recycling it. So we should avoid calling `postDelayed()`\nmultiple times to reduce memory allocation.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341244\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342432\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoThread.java", "widget/android/AndroidUiThread.cpp"], "git_node": "ccbdcb75bb466febcced6042a8ad7882602eeb26", "git_parents": ["d1458852860f9d069466ed773507d28528e8034a"], "node": "eb16feba29c5ddc69e9d82e5ea9b4c7ab0e57df4", "parents": ["700f7b2d819a69a56f3ed771fa1b3266a9e2b103"], "tags": []}], "date": 1794555482, "git_changesets": ["ccbdcb75bb466febcced6042a8ad7882602eeb26"], "user": "pchevrel@mozilla.com"}, "29413": {"changesets": [{"author": "Emily Wachowiak \u003cewachowiak@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091597 - Load branding/brand.ftl in DownloadUIHelper so the downloads prompt resolves the brand name.  a=pascalc\n\nBug 2074615 added { -brand-short-name } to the downloads prompt strings, but\nthe Localization loaded toolkit/branding/brandings.ftl, which doesn't define\nthat term. The prompt showed the literal \"{-brand-short-name}\". The term is\ndefined in branding/brand.ftl, so load that file instead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342167\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342186\n", "files": ["toolkit/components/downloads/DownloadUIHelper.sys.mjs"], "git_node": "99d4d065c2d50685440377b69dc6230c14db8479", "git_parents": ["ccbdcb75bb466febcced6042a8ad7882602eeb26"], "node": "f0dee776fa2e220126376d4498ef66762991648b", "parents": ["eb16feba29c5ddc69e9d82e5ea9b4c7ab0e57df4"], "tags": []}], "date": 1794555619, "git_changesets": ["99d4d065c2d50685440377b69dc6230c14db8479"], "user": "pchevrel@mozilla.com"}, "29414": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073679 - Report a slice as cloneable only when its wrapped stream is  a=pascalc\n\nSlicedInputStream::GetCloneable() returned true whenever the wrapped stream\nimplemented nsICloneableInputStream, but implementing that interface does not\nmean a stream can be cloned right now: nsMultiplexInputStream and\nnsBufferedInputStream both refuse once they have been read from.  Callers that\ncheck before cloning, such as NS_InputStreamIsCloneable(), were told yes and\nthen got a failure out of Clone().  Delegate to the wrapped stream, the way\nnsBufferedInputStream already does.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328176\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341701\n", "files": ["xpcom/io/SlicedInputStream.cpp", "xpcom/tests/gtest/TestSlicedInputStream.cpp"], "git_node": "b1d89a59eec99d9bfb61070b59b37cdf0409a950", "git_parents": ["99d4d065c2d50685440377b69dc6230c14db8479"], "node": "0e8b859143ddb0e4e64ce0978e532f6c099772a6", "parents": ["f0dee776fa2e220126376d4498ef66762991648b"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073679 - Reject an upload stream that NormalizeUploadStream can't make cloneable  a=pascalc\n\nNormalizeUploadStream() promises that a parent-process upload stream is\ncloneable, seekable and synchronous, but the nsIBufferedInputStream and\nnsIMultiplexInputStream branches normalized the streams they wrap and then\nreturned the wrapper untouched, even when the wrapper itself could not be\ncloned because it had already been read from.  Callers that rely on the\nguarantee, such as HttpBaseChannel::CloneUploadStream and\nnsHttpTransaction::Init, are then left unable to clone it.\n\nCheck whether the stream can be used as-is first, and fail when a wrapper\nwould otherwise be returned unchanged, as that means it has been read from\nand can't be rebuilt without losing the data it has buffered.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328177\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341702\n", "files": ["netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/test/unit/test_upload_stream_normalization.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "24c5e4f76b7ffec08f9b1791fafd74fbf0bc1165", "git_parents": ["b1d89a59eec99d9bfb61070b59b37cdf0409a950"], "node": "3b4007ddfc9ef32e4c20160422ad03d21e70fad6", "parents": ["0e8b859143ddb0e4e64ce0978e532f6c099772a6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073679 - Don't fall back to sharing a seekable upload stream with the socket thread  a=pascalc\n\nnsHttpTransaction::Init() reads the channel's own upload stream when it cannot\nclone it, which leaves the socket thread reading a stream the main thread may\nrewind for a redirect or an auth retry.  InternalSetUploadStream now refuses an\nupload stream that can't be cloned, so in the parent process make the fallback\nan error for seekable streams rather than sharing them, and assert that it\nisn't reached.  A stream the channel cannot rewind, such as an async pipe, is\nstill read directly.\n\nThe socket process is exempt: it reads its own deserialized copy of the body,\nwhich nothing else touches and which may not be cloneable (a file stream sent\nas a descriptor never is outside the parent).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328178\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341703\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp"], "git_node": "d7fa4ff1748f509fd8835f78f058431a9d9a12f4", "git_parents": ["24c5e4f76b7ffec08f9b1791fafd74fbf0bc1165"], "node": "38a783963e9310d904b3f1332c70e907085aace8", "parents": ["3b4007ddfc9ef32e4c20160422ad03d21e70fad6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074521 - Don't clone a non-seekable streaming upload body in nsHttpTransaction  a=pascalc\n\nA streaming body is usually an async pipe.  Cloning it adds a second reader\nthat nobody ever reads, so the pipe holds on to every segment written to it\nand buffers the whole upload in memory instead of staying at one pipe's\ncapacity.  HttpBaseChannel::CloneUploadStream already refuses to tee an upload\nstream for exactly that reason.\n\nOnly a parent-process fetch() with a ReadableStream body could hit this: a\ncontent-process streaming body crosses IPC as a DataPipeReceiver, which is not\ncloneable, so the clone attempt failed there anyway.\n\nA pipe can't be rewound, so the channel never touches it once the transaction\nhas it.  A streaming body can also be a Blob's own seekable stream, which the\nchannel may rewind for a redirect or an auth retry, so keep cloning that one.\nAdd a Blob stream case to test_fetch_streaming_upload.js.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328179\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341704\n", "files": ["netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/test/unit/test_fetch_streaming_upload.js"], "git_node": "b3b319eece605ec287c4f71d409a900f9eade88c", "git_parents": ["d7fa4ff1748f509fd8835f78f058431a9d9a12f4"], "node": "dea49e0c442f1cb27a783207faa9bcae7aec924e", "parents": ["38a783963e9310d904b3f1332c70e907085aace8"], "tags": []}], "date": 1794555700, "git_changesets": ["b1d89a59eec99d9bfb61070b59b37cdf0409a950", "24c5e4f76b7ffec08f9b1791fafd74fbf0bc1165", "d7fa4ff1748f509fd8835f78f058431a9d9a12f4", "b3b319eece605ec287c4f71d409a900f9eade88c"], "user": "pchevrel@mozilla.com"}, "29415": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump\n\nach -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\naf -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nan -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nar -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nast -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\naz -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nbe -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nbg -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nbn -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nbr -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nbs -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nca -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nca-valencia -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\ncak -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\ncs -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\ncy -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nda -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nde -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\ndsb -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nel -\u003e 8486a0949983ae20a44335161dcdc76ee3240b93\nen-CA -\u003e 848