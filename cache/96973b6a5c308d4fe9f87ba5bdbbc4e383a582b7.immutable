"user": "ffxbld@lando.moz.tools"}, "29424": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089774 - Use a non-movable load for UnsafeGetReservedSlot.  a=pascalc DONTBUILD\n\nThis adds `LoadReservedFixedSlotResult` and uses it instead of `LoadFixedSlotResult`\nfor the `UnsafeGetReservedSlot` intrinsic.\n\nAlso renames `LoadFixedSlotTypedResult` to `LoadReservedFixedSlotTypedResult`\nfor consistency.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341262\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342546\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIROps.yaml", "js/src/jit/IonCacheIRCompiler.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "ab06934d2cc5df35f4c73295a59694cf84400f9a", "git_parents": ["7341b0fc313cfa88b5b15b2dc198dab959207f59"], "node": "13f51725db746beced93ac11b080c23f667bf3d3", "parents": ["30ac3d19a5e006b4b285a10bbf1519c7b9ac4f1c"], "tags": []}], "date": 1794591036, "git_changesets": ["ab06934d2cc5df35f4c73295a59694cf84400f9a"], "user": "pchevrel@mozilla.com"}, "29425": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091136 - Always merge OSR block parameters with entry block parameters in BacktrackingAllocator.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341297\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342549\n", "files": ["js/src/jit/BacktrackingAllocator.cpp", "js/src/jit/BacktrackingAllocator.h"], "git_node": "4b2609d03f7e3e6b123186c66957c4045309b7af", "git_parents": ["ab06934d2cc5df35f4c73295a59694cf84400f9a"], "node": "0b0d22ee2d5e9bf5f50f3a53a917b1421986b7ea", "parents": ["13f51725db746beced93ac11b080c23f667bf3d3"], "tags": []}], "date": 1794591060, "git_changesets": ["4b2609d03f7e3e6b123186c66957c4045309b7af"], "user": "pchevrel@mozilla.com"}, "29426": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078279 - Adjust file stream handling.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336874\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342178\n", "files": ["dom/file/FileBlobImpl.cpp", "modules/libpref/init/StaticPrefList.yaml", "netwerk/base/nsFileStreams.cpp", "netwerk/base/nsIFileStreams.idl"], "git_node": "6df3d9a15e5a3991147cbee81e9af9f62c2a94b2", "git_parents": ["4b2609d03f7e3e6b123186c66957c4045309b7af"], "node": "8b7a9e29b7d3d9c3721eae94f7b4e935918a8eac", "parents": ["0b0d22ee2d5e9bf5f50f3a53a917b1421986b7ea"], "tags": []}], "date": 1794591083, "git_changesets": ["6df3d9a15e5a3991147cbee81e9af9f62c2a94b2"], "user": "pchevrel@mozilla.com"}, "29427": {"changesets": [{"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986173: Restore history when typed value fixup fails  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341542\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342694\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_newtab_userTypedValue.js"], "git_node": "dbd43792211ae84623132e59949524153b62ee3b", "git_parents": ["6df3d9a15e5a3991147cbee81e9af9f62c2a94b2"], "node": "5c8fea20ccea47a11d9e10b3c685c511294e59e0", "parents": ["8b7a9e29b7d3d9c3721eae94f7b4e935918a8eac"], "tags": []}], "date": 1794591108, "git_changesets": ["dbd43792211ae84623132e59949524153b62ee3b"], "user": "pchevrel@mozilla.com"}, "29428": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089819 - Use a worst-case bound and fallible allocation when calling getIntercepts.  a=pascalc\n\nIn principle this should be more performant, as it means we only make one call\nto getIntercepts, which is where most work happens. The array allocation will\ninitially be oversized, and subsequently truncated to fit the actual number of\nreturned intercepts, but by using fallible allocation we ensure that in an OOM\nsituation it will degrade gracefully (we just bail out of skip-ink processing)\nrather than crashing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340905\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342625\n", "files": ["layout/painting/nsCSSRendering.cpp"], "git_node": "3a8241d918c644d2a7b8725455a25dfff58d6acf", "git_parents": ["dbd43792211ae84623132e59949524153b62ee3b"], "node": "eb256d2c6c6ae93ed0ea1a9985f35a4bb55eeb69", "parents": ["5c8fea20ccea47a11d9e10b3c685c511294e59e0"], "tags": []}], "date": 1794591132, "git_changesets": ["3a8241d918c644d2a7b8725455a25dfff58d6acf"], "user": "pchevrel@mozilla.com"}, "29429": {"changesets": [{"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 2090182 - Check for first-letter frame in overflow list.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342170\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342622\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "a70b1aa708d1d132b08a307185302701aa00a5a6", "git_parents": ["3a8241d918c644d2a7b8725455a25dfff58d6acf"], "node": "eaaae3d0d06f4f188fe902b0c3031b24defe0dda", "parents": ["eb256d2c6c6ae93ed0ea1a9985f35a4bb55eeb69"], "tags": []}], "date": 1794591157, "git_changesets": ["a70b1aa708d1d132b08a307185302701aa00a5a6"], "user": "pchevrel@mozilla.com"}, "29430": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2089592 - Deal with replicated frames in CharacterDataChanged.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341301\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341476\n", "files": 