da3123eabf1e"], "user": "pchevrel@mozilla.com"}, "29437": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092532: settle WebTransport datagram writes when neqo queues them above its high water mark  a=pascalc\n\nneqo reports no outcome for a queued datagram that later expires or is\nevicted, and Http3Client drops the outcomes it does report, so a write()\nwaiting for one never settled and the datagram writable stalled for the\nrest of the session.  Settle every write once neqo has accepted the\ndatagram, and report a datagram neqo refuses as dropped.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342570\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342645\n", "files": ["netwerk/protocol/http/Http3Session.cpp", "netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "b268822d112665c4ed7a8b013fb5709644eaab37", "git_parents": ["45af71f083c429e1f5d4480daf6cda3123eabf1e"], "node": "b6b2800d59381cbfc5924947620be59c10205818", "parents": ["ede31f3c518ae81c8d59873d8142478152bb7e49"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092532: test that every write() of a WebTransport datagram burst that overruns the outgoing queue settles  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342571\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342646\n", "files": ["testing/web-platform/tests/webtransport/datagrams2.https.any.js"], "git_node": "ef28718e44c4fdf9881dee29ee1f808378470573", "git_parents": ["b268822d112665c4ed7a8b013fb5709644eaab37"], "node": "dc6f2b7020e52204a1c2dede09116569fcecb141", "parents": ["b6b2800d59381cbfc5924947620be59c10205818"], "tags": []}], "date": 1794659874, "git_changesets": ["b268822d112665c4ed7a8b013fb5709644eaab37", "ef28718e44c4fdf9881dee29ee1f808378470573"], "user": "pchevrel@mozilla.com"}, "29438": {"changesets": [{"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2092509 - Add Listen to Page to Secret Settings in Beta  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342540\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342573\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt"], "git_node": "c2b0f525f442fad014336d98c5faf1f5b8793090", "git_parents": ["ef28718e44c4fdf9881dee29ee1f808378470573"], "node": "746032275e4d6f79bac006a366a8ba38eefe88c5", "parents": ["dc6f2b7020e52204a1c2dede09116569fcecb141"], "tags": []}], "date": 1794659928, "git_changesets": ["c2b0f525f442fad014336d98c5faf1f5b8793090"], "user": "pchevrel@mozilla.com"}, "29439": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2091728 - Remove kStrokeLogicalScale.  a=pascalc\n\nSince some drivers don't apply it properly. This means we don't get\nsubpixel stroke widths but that matches Cairo.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342560\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342889\n", "files": ["gfx/skia/gdi/SkGDIDocument.cpp"], "git_node": "befc5262b2744e72b1923e946dcf2b4bdf7b5e9a", "git_parents": ["c2b0f525f442fad014336d98c5faf1f5b8793090"], "node": "58f7bb6e31f7bd7ad6e00c7419c6cd17e3f5b95e", "parents": ["746032275e4d6f79bac006a366a8ba38eefe88c5"], "tags": []}], "date": 1794660095, "git_changesets": ["befc5262b2744e72b1923e946dcf2b4bdf7b5e9a"], "user": "pchevrel@mozilla.com"}, "29440": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 1 - Inline GraphWalker and ScanBlackVisitor into FloodBlackNode.  a=pascalc\n\nThey are only used in a single place, so inline it all to make it\neasier to understand.\n\nChange the aPi check in CheckedPush to be a release assert, for simplicity.\n\nWalkFromRoots is not used so it is removed.\n\nI marked FloodBlackNode MOZ_NEVER_INLINE to match GraphWalker::Walk,\nGraphWalker::DoWalk and ScanBlackVisitor::VisitNode.\n\nThis patch should not change the behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338469\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341080\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "9f1a3aaeee868c0c6bedd1c58aef14223f2b9335", "git_parents": ["befc5262b2744e72b1923e946dcf2b4bdf7b5e9a"], "node": "06f7605d32089a94867ec0c51c6599599aa1e686", "parents": ["58f7bb6e31f7bd7ad6e00c7419c6cd17e3f5b95e"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 2 - Use infallible allocation for Push in FloodBlackNode.  a=pascalc\n\nIf a cycle collection can't fully run due to running low on memory, it won't be\nable to free much of anything, so the memory problems will only get worse. If\nwe crash, then at least this issue will be visible in crash stats, as opposed\nto performance invisibly becoming terrible.\n\nThis requires removing a lot of failure propagation code.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338470\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341081\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "cb2682f3dd09db9598305e2a02ec448d841408e7", "git_parents": ["9f1a3aaeee868c0c6bedd1c58aef14223f2b9335"], "node": "f251ec847ac6411675b18406207ae123ef355dcf", "parents": ["06f7605d32089a94867ec0c51c6599599aa1e686"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 3 - Mark nodes black when they are pushed in FloodBlackNode.  a=pascalc\n\nPreviously, every child was pushed onto the queue, and filtered out when it was\npopped if it was already black or had not been traversed. This meant that the\nqueue could grow to the number of edges rather than the number of nodes. Doing\nthe check and marking the node black when it is pushed means each node is\npushed at most once. The resulting coloring and white node count are the same.\n\nRunning browser_aiwindow_smartbar_chat_active_navigate.js locally, this reduced\nthe maximum size of the queue from around 5600 nodes to 2800.\n\nThis probably makes locality worse, because we now look at a node when we push\nit, but I think that's a reasonable tradeoff for cutting memory usage in half.\n(Testing described in the last patch shows that the entire patch set improves\nScanBlockNodes performance over all.)\n\nThis is combined with the patches to make memory allocation infallible in the\nhope that it will reduce the rate of OOM crashes.\n\nRemove a WasTraversed check in ScanBlackNodes that is now redundant.\nThere's a check in PurpleScanBlackVisitor::Visit that is also redundant,\nbut that case is likely more common, so let's leave it to avoid the call\noverhead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338471\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341082\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "7ffa065bd9f2d5436b0ded65ec3d845a196b3693", "git_parents": ["cb2682f3dd09db9598305e2a02ec448d841408e7"], "node": "90459989cf84ed37bb5267bdd907018cf994a7e5", "parents": ["f251ec847ac6411675b18406207ae123ef355dcf"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 4 - Switch from nsDeque to Queue in FloodBlackNodes.  a=pascalc\n\nnsDeque uses a single block of memory, while Queue uses a segmented vector, so\nhopefully this will cause less OOMs. 1024 pointers seems big enough that\niterator overhead shouldn't be a big deal.\n\nWe already use infallible allocation with EdgeBlock, which each contain\n16 * 1024 pointers. Over the last week, those were about 7.6% of all\nOOM | small crashes.\n\nUnlike nsDeque, Queue has no inline storage, so creating one in each\nFloodBlackNode call would mean a heap allocation of a page for every call, which\ncan happen once per root. Instead, create the queue in ScanRoots and pass it\ndown. A drained Queue keeps its head page, so it is only allocated once. It\nwould be nice if it kept all of its empty pages but oh well.\n\nWhile running tests with big CCs, the full patch stack reduced the time spent\nin ScanBlackNodes() by 22% which sounds great but CC time is mostly dominated\nby building the graph so that's not much. The biggest improvement seen\nin a single CC was like 0.3ms.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338472\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341083\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "c82933b6b3a7fdfa8f03a82adcf09e37b8726d37", "git_parents": ["7ffa065bd9f2d5436b0ded65ec3d845a196b3693"], "node": "4f94bdec4269b9df2618662ebe62933bc3b3fd28", "parents": ["90459989cf84ed37bb5267bdd907018cf994a7e5"], "tags": []}], "date": 1794660583, "git_changesets": ["9f1a3aaeee868c0c6bedd1c58aef14223f2b9335", "cb2682f3dd09db9598305e2a02ec448d841408e7", "7ffa065bd9f2d5436b0ded65ec3d845a196b3693", "c82933b6b3a7fdfa8f03a82adcf09e37b8726d37"], "user": "pchevrel@mozilla.com"}, "29441": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update HSTS HPKP  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342695\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "d1cf6e0e421a8f6922ac060ac69bec9ce79c13ef", "git_parents": ["c82933b6b3a7fdfa8f03a82adcf09e37b8726d37"], "node": "1f96d132957990ba418779c712a5d15ce481703c", "parents": ["4f94bdec4269b9df2618662ebe62933bc3b3fd28"], "tags": []}], "date": 1794694735, "git_changesets": ["d1cf6e0e421a8f6922ac060ac69bec9ce79c13ef"], "user": "rvandermeulen@mozilla.com"}, "29442": {"changesets": [{"author": "Release E