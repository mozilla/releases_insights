{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "FIREFOX_ESR_128_3_X_RELBRANCH", "desc": "Bug 1922015 - pin websocketbridge's pyOpenSSL to 23.2.0. a=test-infra-fix\n\nThis avoids a deprecation message getting logged when the webRTC code expects\nthe configuration of the ICE server instead.\n\nBug 1921991 had updated the package.", "files": ["testing/tools/websocketprocessbridge/websocketprocessbridge_requirements_3.txt"], "git_node": null, "git_parents": [null], "node": "9a327e036cdce4d976424e729db47a5d56defc4f", "parents": ["791c5a6d2b1ba5c31d1256eb1fd1e5402d0edbef"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "FIREFOX_ESR_128_3_X_RELBRANCH", "desc": "Bug 1923344 - r=smaug, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224958", "files": ["dom/animation/AnimationTimeline.cpp", "dom/animation/DocumentTimeline.cpp", "dom/animation/ScrollTimelineAnimationTracker.cpp", "layout/base/nsRefreshDriver.cpp"], "git_node": null, "git_parents": [null], "node": "e0c969a3bfc0a23219384269e5b36a589c8f6cc5", "parents": ["9a327e036cdce4d976424e729db47a5d56defc4f"], "tags": ["FIREFOX_128_3_1esr_BUILD1", "FIREFOX_128_3_1esr_RELEASE"]}], "date": 1728409749, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "210": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging e0c969a3bfc0a23219384269e5b36a589c8f6cc5 with FIREFOX_128_3_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "d4d13abba2a415a312458cf735a17b46b5fe51d3", "parents": ["65655e6d520afb94606a227956cb49f41b6a54f6"], "tags": []}], "date": 1728422565, "git_changesets": [null], "user": "ffxbld"}, "211": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging