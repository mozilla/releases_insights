s:86123:"{
"lastpushid": 632,
"pushes": {"186": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging e2cb3d9c8cfc18acad7f77add351416dc95b67c4 with FIREFOX_128_3_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "9934afebd0fd0288891cd60d0ff87365bd7a27e7", "parents": ["e2cb3d9c8cfc18acad7f77add351416dc95b67c4"], "tags": []}], "date": 1727107871, "git_changesets": [null], "user": "ffxbld"}, "187": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "480f586b8c16dbb452107e8c419ac54b4071c7b1", "parents": ["9934afebd0fd0288891cd60d0ff87365bd7a27e7"], "tags": []}], "date": 1727702291, "git_changesets": [null], "user": "ffxbld-merge"}, "188": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224097", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "8ec21eee419cf66d0894344d86ffcbf24c70bb32", "parents": ["480f586b8c16dbb452107e8c419ac54b4071c7b1"], "tags": []}], "date": 1727740623, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "189": {"changesets": [{"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1918978: Initialise other slots first before calling fallible init.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222267\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223614", "files": ["js/src/vm/ArrayBufferViewObject.cpp"], "git_node": null, "git_parents": [null], "node": "7088e8b3253f9c36ac3c3e94f63736f777f05942", "parents": ["8ec21eee419cf66d0894344d86ffcbf24c70bb32"], "tags": []}], "date": 1727740977, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "190": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1760097 - Add a pref for the max confirmation interval r=necko-reviewers,kershaw a=test-only\n\nThe test was timing out, possibly because the confirmation interval could go\nup to 64 seconds, while the test was only waiting for 60 seconds.\nAdding a pref lets us reduce the time it takes to run the test, while\nalso making sure that the at least one successful attempt can execute\nbefore the waiting time is done.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223090", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/dns/TRRService.cpp", "netwerk/test/unit/test_trr_confirmation.js"], "git_node": null, "git_parents": [null], "node": "e7c79066d4103dd05a3acdec5d13ea4591f2faa8", "parents": ["7088e8b3253f9c36ac3c3e94f63736f777f05942"], "tags": []}, {"author": "John Bieling \u003cjohn@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1921412 - Set `app.update.langpack.enabled=false` in `toolkit/mozapps/update/tests/unit_aus_update/xpcshell.toml`. r=application-update-reviewers,nalexander a=test-only\n\nThunderbird would like to enable the `app.update.langpack.enabled` pref\nglobally in its main preference file `/comm/mail/app/profile/all-thunderbird.js`,\nsimilar to what Firefox is doing already in its counterpart file\n`/browser/app/profile/firefox.js` ([here](https://searchfox.org/mozilla-central/source/browser/app/profile/firefox.js#168)).\n\nHowever, if we do that, the following toolkit test starts to fail:\n\n/toolkit/mozapps/update/tests/unit_aus_update/disableBackgroundUpdatesNonBackgroundTask.js\n\nThe reason is that the test ignores global preferences for Firefox, but\nnot for Thunderbird. This is due to bug 1168178 and bug 755724: Firefox\ndoes not load its global preferences unless the manifest specifically\nrequests it by specifying `firefox-appdir = browser`.\n\nThe test which fails needs `app.update.langpack.enabled` to be unset or\nfalse.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223927", "files": ["toolkit/mozapps/update/tests/unit_aus_update/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "5b88b669dcb77849977b92035d45fbd0639e8b1b", "parents": ["e7c79066d4103dd05a3acdec5d13ea4591f2faa8"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1886228 - Add exception to principal validation for removed about page r=tjr a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223221", "files": ["dom/ipc/ContentParent.cpp"], "git_node": null, "git_parents": [null], "node": "29ca70cafd7c8dd951be002f7d7989f9d5b74b0c", "parents": ["5b88b669dcb77849977b92035d45fbd0639e8b1b"], "tags": []}], "date": 1727746935, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "191": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918928 - Only allow to wait for HTTPS RR when TRR is confirmed,  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D222940", "files": ["netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsIHttpChannelInternal.idl", "netwerk/test/unit/test_bug_1918928.js", "netwerk/test/unit/test_httpssvc_https_upgrade.js", "netwerk/test/unit/test_use_httpssvc.js", "netwerk/test/unit/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "afc87f391843df1c96730bdb1b216f5c4decd05c", "parents": ["29ca70cafd7c8dd951be002f7d7989f9d5b74b0c"], "tags": []}], "date": 1727747200, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "192": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging e2cb3d9c8cfc18acad7f77add351416dc95b67c4 with FIREFOX_128_3_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "8867c52108a5e9d424cf1c4bbff14b3256f5abbd", "parents": ["afc87f391843df1c96730bdb1b216f5c4decd05c"], "tags": []}], "date": 1727785685, "git_changesets": [null], "user": "ffxbld"}, "193": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1920933 - update cron-bouncer-check config for esr128 as current ESR r=releng-reviewers,bhearsum a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223475", "files": ["taskcluster/kinds/cron-bouncer-check/kind.yml"], "git_node": null, "git_parents": [null], "node": "ce72e57c98c379f6ba77bfcc696341095b704ba9", "parents": ["8867c52108a5e9d424cf1c4bbff14b3256f5abbd"], "tags": []}], "date": 1727790071, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "194": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1920936 - stop running update verify next tasks on esr128. r=releng-reviewers,bhearsum a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223480", "files": ["taskcluster/kinds/release-update-verify-config-next/kind.yml", "taskcluster/kinds/release-update-verify-next/kind.yml"], "git_node": null, "git_parents": [null], "node": "70f01f133c94c466625283b91efc217895550f7e", "parents": ["ce72e57c98c379f6ba77bfcc696341095b704ba9"], "tags": []}], "date": 1727793088, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "195": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1760085 - move test disabling rule for Linux to correct test test_purge_trackers.js. r=intermittent-reviewers,anti-tracking-reviewers,jmaher a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D214963", "files": ["toolkit/components/antitracking/test/xpcshell/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "f956b6acdac4e960b05189be6d9520039198cc62", "parents": ["70f01f133c94c466625283b91efc217895550f7e"], "tags": []}, {"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1302198 - disabled test_asm.js on Linux with ThreadSanitizer (TSan) enabled. r=jmaher a=test-only\n\nThe test failed permanently since the machine type had been changed from\nn2-standard-2 to c2-standard-4 in bug 1862675.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223954", "files": ["tools/profiler/tests/xpcshell/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "fc04e2d3ef3ab3c915e4d66756be77d3c48d583d", "parents": ["f956b6acdac4e960b05189be6d9520039198cc62"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1829029: clean up memory reporting for CacheFileIOManager r=necko-reviewers,valentin, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221350", "files": ["netwerk/cache2/CacheFileIOManager.cpp"], "git_node": null, "git_parents": [null], "node": "5690bd52e604a34ebfb55d2475489a124b753356", "parents": ["fc04e2d3ef3ab3c915e4d66756be77d3c48d583d"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1912404 - Remove unneeded 16kiB var limit for Mesa. r=gfx-reviewers,lsalzman a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D222010", "files": ["dom/canvas/WebGLShaderValidator.cpp"], "git_node": null, "git_parents": [null], "node": "f14ddef6a7c144ba82914812edbbbd1eef18117c", "parents": ["5690bd52e604a34ebfb55d2475489a124b753356"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1904059 - Using DOM::Function::Call instead JS_CallFunctionValue in DebuggerImmediateRunnable::WorkerRun. r=asuth, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D222436", "files": ["dom/workers/WorkerPrivate.cpp", "dom/workers/test/WorkerDebugger.initialize_waiting_debugger.js"], "git_node": null, "git_parents": [null], "node": "301b45e11abf1dc6204da724cab69e5d97de82fa", "parents": ["f14ddef6a7c144ba82914812edbbbd1eef18117c"], "tags": []}], "date": 1727794507, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "196": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918853 - Mark the Paste contextmenu as tabspecific.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222596\n\nDifferential Revision: https://phabricator.services.mozilla.com/D222919", "files": ["toolkit/modules/ClipboardContextMenu.sys.mjs"], "git_node": null, "git_parents": [null], "node": "6a9bff4fb40abd4295cc70fecafd465b4c51faeb", "parents": ["301b45e11abf1dc6204da724cab69e5d97de82fa"], "tags": []}], "date": 1727795466, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "197": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1922015 - pin websocketbridge's pyOpenSSL to 23.2.0. a=test-infra-fix\n\nThis avoids a deprecation message getting logged when the webRTC code expects\nthe configuration of the ICE server instead.\n\nBug 1921991 had updated the package.", "files": ["testing/tools/websocketprocessbridge/websocketprocessbridge_requirements_3.txt"], "git_node": null, "git_parents": [null], "node": "ec188bd09d88f8b4a42c4543f4a1f0afd7a9e3d6", "parents": ["6a9bff4fb40abd4295cc70fecafd465b4c51faeb"], "tags": []}], "date": 1727800846, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "198": {"changesets": [{"author": "William Wen \u003cwwen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1913000 - Add more rate limiting to History interface. r=emilio a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D221255\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224233", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/shistory/ChildSHistory.cpp", "docshell/test/navigation/test_rate_limit_location_change.html", "dom/base/Location.cpp", "dom/base/LocationBase.cpp", "dom/base/nsHistory.cpp", "dom/base/nsHistory.h", "dom/chrome-webidl/BrowsingContext.webidl", "dom/webidl/History.webidl", "modules/libpref/init/StaticPrefList.yaml", "remote/shared/RecommendedPreferences.sys.mjs", "testing/marionette/client/marionette_driver/geckoinstance.py", "tools/@types/lib.gecko.dom.d.ts"], "git_node": null, "git_parents": [null], "node": "4d095cdccd60327ef7272a127cdc01f7b42ea04a", "parents": ["ec188bd09d88f8b4a42c4543f4a1f0afd7a9e3d6"], "tags": []}], "date": 1727806558, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "199": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1919809 - Always clear mArgumentStorage in Console's Unlink.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222803\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224384", "files": ["dom/console/Console.cpp"], "git_node": null, "git_parents": [null], "node": "61069393c65122b3ebe659b2e003f7775d18546d", "parents": ["4d095cdccd60327ef7272a127cdc01f7b42ea04a"], "tags": []}], "date": 1727923012, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "200": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1912537 - adjust principal display logic for external protocol dialog,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220946\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224328", "files": ["toolkit/mozapps/handling/content/permissionDialog.js"], "git_node": null, "git_parents": [null], "node": "30e4cd583ca2604712cfb8ddc14433a66e1551fd", "parents": ["61069393c65122b3ebe659b2e003f7775d18546d"], "tags": []}], "date": 1727923074, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "201": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224457", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/translations-models.json"], "git_node": null, "git_parents": [null], "node": "2f24d13e11c8ed3b2df2764dc4a2478ec28864be", "parents": ["30e4cd583ca2604712cfb8ddc14433a66e1551fd"], "tags": []}], "date": 1727961336, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "202": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1920800 Remove oldImages from check for flushed old principal handle  a=RyanVM\n\nThe logic should be equivalent when frame IDs on aImages are contiguously\nincreasing from IDs on previously set frames.\n\nThere are currently no callers passing empty aImages, but the logic in this\ncase would now be as described in the documentation of\nUpdatePrincipalHandleForFrameID():\n\n\u003e We will notify mElement that aPrincipalHandle has been applied when all\n\u003e FrameIDs prior to aFrameID have been flushed out.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223922\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224435", "files": ["dom/media/VideoFrameContainer.cpp"], "git_node": null, "git_parents": [null], "node": "2b43c0cb7337a6ba4fdfe4e8dc10f9ec3a644912", "parents": ["2f24d13e11c8ed3b2df2764dc4a2478ec28864be"], "tags": []}], "date": 1727964012, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "203": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1783170 - disable test_enterjit_osr.js and test_pause.js on Linux ThreadSanitizer for frequent failures. r=intermittent-reviewers,jmaher a=test-only\n\nThe tests failed frequently since the machine type had been changed from\nn2-standard-2 to c2-standard-4 in bug 1862675.", "files": ["tools/profiler/tests/xpcshell/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "7d7c128d84486fae35d56c3fb38277b1f9235c2d", "parents": ["2b43c0cb7337a6ba4fdfe4e8dc10f9ec3a644912"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1879744 - Skip this test in tsan. r=aabh,profiler-reviewers a=test-only\n\nBug 1915433 made this perma because it caused gfxPlatform initialization\n(thus a bit more work), where before it used to be skipped by a pref.\n\nBut this happened intermittently before my patch, so likely this just\npushed the test over the limit...\n\nGiven the amount of tests skipped here on tsan, maybe we should have a\nhigher xpcshell timeout there?", "files": ["tools/profiler/tests/xpcshell/xpcshell.toml"], "git_node": null, "git_parents": [null], "node": "65baa26e9b3437a67b0fe20b10f4ffaeed486e0d", "parents": ["7d7c128d84486fae35d56c3fb38277b1f9235c2d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1920660 - Ensure we free external images/surfaces with recorded canvas sooner. r=gfx-reviewers,nical a=RyanVM\n\nIf a canvas never stops drawing to the point the canvas does not go\ndormant to free buffers, and the caller never does a readback to create\na checkpoint, then we may never release our hold on resources used\nearlier in the recording. This patch makes it so that we check at the\nend of each transaction. Eventually the playback of the recording will\ncatch up, or the recording will go dormant, and we will release the\nrelevant surfaces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223572", "files": ["gfx/layers/ipc/CanvasChild.cpp"], "git_node": null, "git_parents": [null], "node": "f4b5ef25d033e33f07df4133b7f68612305a7eb9", "parents": ["65baa26e9b3437a67b0fe20b10f4ffaeed486e0d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1898773 - Ensure we also check for ffmpeg + OpenH264 when determining codec support. r=media-playback-reviewers,padenot a=RyanVM\n\nWhen we create a video decoder with ffmpeg, we check if the underlying\ndecoder implementation is supplied by OpenH264. If so, and the\nmedia.ffmpeg.allow-openh264 is set to false (the default), we refuse to\ncreate the video decoder. This is a problem because the decoder module\nfor ffmpeg declared support for H264, so we did not try falling back to\nour own OpenH264 plugin exposed via GMP.\n\nThis patch duplicates the logic check for ffmpeg + OpenH264 in\nFFmpegDecoderModule::Supports to ensure we fallback properly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D223843", "files": ["dom/media/platforms/ffmpeg/FFmpegDataDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegDecoderModule.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": null, "git_parents": [null], "node": "a51ef6ac52af37a526a52dfac6f693f19ce1ca0a", "parents": ["f4b5ef25d033e33f07df4133b7f68612305a7eb9"], "tags": []}], "date": 1727975211, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "204": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1914521 - Make nsPartChannel inherit the content disposition of the multipart response  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223728\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224288", "files": ["netwerk/streamconv/converters/nsMultiMixedConv.cpp", "netwerk/streamconv/converters/nsMultiMixedConv.h"], "git_node": null, "git_parents": [null], "node": "2f331426fe0d9f39529e61b5f769786cff8972c9", "parents": ["a51ef6ac52af37a526a52dfac6f693f19ce1ca0a"], "tags": []}], "date": 1728248273, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "205": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1917742 - Share link-target escaping code between DrawTargetCairo::Link and DrawTargetCairo::Destination.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D224319\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224628", "files": ["gfx/2d/DrawTargetCairo.cpp"], "git_node": null, "git_parents": [null], "node": "fa6bc54a912e954298d4e493ab4891f9d8f5a7d4", "parents": ["2f331426fe0d9f39529e61b5f769786cff8972c9"], "tags": []}], "date": 1728248341, "git_changesets": [null], "user": "rvandermeulen@mozilla.com"}, "206": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224743", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "46b45da1addeaac817623989bab6d168e59ca852", "parents": ["fa6bc54a912e95