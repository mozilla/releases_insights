", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "017886225558d46e0e657130c65a1e867d595c41", "parents": ["e1ce467797674cee350ea7f97866a5011929ed7b"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1728321 - Clean up encode callback during shutdown. r=ng, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124064", "files": ["media/webrtc/signaling/src/media-conduit/WebrtcGmpVideoCodec.cpp"], "git_node": null, "git_parents": [null], "node": "5a16b1e043044bd928baa3587bf5a60d1d21f3ab", "parents": ["017886225558d46e0e657130c65a1e867d595c41"], "tags": []}], "date": 1631025797, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "323": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125055", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f05c636277566f5e41d87678e5c271881541a190", "parents": ["5a16b1e043044bd928baa3587bf5a60d1d21f3ab"], "tags": []}], "date": 1631200469, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "324": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125383", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "44796c9d3584e0444bbeea1386a3a90ea591fb31", "parents": ["f05c636277566f5e41d87678e5c271881541a190"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1725335 - Streamline ownership and locking in MessageTask. r=mccr8, a=RyanVM\n\nThis simplifies the logic around MessageTask's lifecycle to make\nownership as clear as possible and reduce the number of redundant\nchecks.\n\nThis new change no longer clears the mChannel member when the\nMessageTask is disconnected, instead relying on isInList() to check\nwhether the MessageTask is still in the channel's mPending list. This is\nalready being automatically managed as the mPending list is modified,\nand should avoid potential usage mistakes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123552", "files": ["ipc/glue/MessageChannel.cpp", "ipc/glue/MessageChannel.h"], "git_node": null, "git_parents": [null], "node": "c9b24377a1737cc8104c356a4cb1581ed1e0ea07", "parents": ["44796c9d3584e0444bbeea1386a3a90ea591fb31"], "tags": []}], "date": 1631557048, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "325": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125818", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "94a8a0a5aed946d125e5905c0032e9bdaab11b16", "parents": ["c9b24377a1737cc8104c356a4cb1581ed1e0ea07"], "tags": []}], "date": 1631810379, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "326": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr78 repo-update remote-settings - a=repo-update r=RyanVM", "files": ["services/settings/dumps/main/search-config.json"], "git_node": null, "git_parents": [null], "node": "255e8eff99203a8c3d7b1d00fdf7471b66ed3fca", "parents": ["94a8a0a5aed946d125e5905c0032e9bdaab11b16"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1724248 - Update partner distributions in search-config. r=harry, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124651", "files": ["toolkit/components/search/tests/xpcshell/test_distributions.js"], "git_node": null, "git_parents": [null], "node": "c47e723386867694605615f1762d569bde71cd6c", "parents": ["255e8eff99203a8c3d7b1d00fdf7471b66ed3fca"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1730070: Update DDG logo. r=Standard8, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125145", "files": ["browser/components/newtab/data/content/tippytop/favicons/duckduckgo-com.ico", "browser/components/newtab/data/content/tippytop/images/duckduckgo-com@2x.png", "browser/components/newtab/data/content/tippytop/images/duckduckgo-com@2x.svg", "browser/components/newtab/data/content/tippytop/top_sites.json", "browser/components/search/extensions/ddg/favicon.ico"], "git_node": null, "git_parents": [null], "node": "80d5465ae8d22497fb29e3f8d80aa4bc83861c57", "parents": ["c47e723386867694605615f1762d569bde71cd6c"], "tags": []}, {"author": "Dzmitry Malyshau \u003cdmalyshau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1725854 - Check for the WebGPU pref before initializing the GPU process IPC side. r=aosmond, a=RyanVM", "files": ["gfx/ipc/CompositorOptions.h", "gfx/la