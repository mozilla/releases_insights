": "7c26f8cd7ab321e10bb5c6d28983cd6493f80f33", "parents": ["98a619fa822396f39430b240c4e868e4a0244d4e"], "tags": []}, {"author": "Eric Faust \u003cefaustbmo@gmail.com\u003e", "branch": "default", "desc": "Bug 1254122 - Don't bother saving scratch registers across TypeUpdate IC calls. r=jandem, a=sylvestre\n\nMozReview-Commit-ID: 3Q2H1oNFC8c", "files": ["js/src/jit/BaselineIC.cpp"], "git_node": null, "git_parents": [null], "node": "845dd3bf121f6d7abc9dbde51d41afdb4b1a2b33", "parents": ["7c26f8cd7ab321e10bb5c6d28983cd6493f80f33"], "tags": []}, {"author": "Pip \u003cpipcet@gmail.com\u003e", "branch": "default", "desc": "Bug 1258632 - Distinguish signed/unsigned MDiv/MMod in GVN. r=bbouvier a=sylvestre\n\nModify the congruentTo method of MDiv and MMod opcodes to take into\naccount signedness, which is necessary for correct code generation.\n\nMozReview-Commit-ID: 5bOBSIdADgP", "files": ["js/src/jit-test/tests/asm.js/testExpressions.js", "js/src/jit/MIR.h"], "git_node": null, "git_parents": [null], "node": "dc8a6da43d9f2754fc5b1a56a8295c06a149749d", "parents": ["845dd3bf121f6d7abc9dbde51d41afdb4b1a2b33"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1254622 - Relookup group-\u003enewScript in CreateThisForFunctionWithGroup. r=bhackett a=sylvestre\n\nMozReview-Commit-ID: KXd7kB70f1Z", "files": ["js/src/jsobj.cpp"], "git_node": null, "git_parents": [null], "node": "7cdfe319eef022d542328f7f16fea290264d8d20", "parents": ["dc8a6da43d9f2754fc5b1a56a8295c06a149749d"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1255949 - Check fallible flag in MBoundsCheck::congruentTo. r=h4writer a=sylvestre\n\nMozReview-Commit-ID: GI802phgMou", "files": ["js/src/jit/IonAnalysis.cpp", "js/src/jit/MIR.h"], "git_node": null, "git_parents": [null], "node": "476ab557fc684bde704be95adccbcb9dba6b1567", "parents": ["7cdfe319eef022d542328f7f16fea290264d8d20"], "tags": []}, {"author": "Ralph Giles \u003cgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1257870 - Require 1.5.0 --with-system-libvpx. r=glandium, a=sylvestre\n\nWebRTC code requires VP9E_SET_NOISE_SENSITIVITY from vpx/vp8cx.h\nwhich was added in 1.4. We could feature test, but gating on\nthe minimum version seems better given the m4 code is to be\nreplaced by python.\n\nWe also depend on VPX_MAX_LAYERS wich is part of the 1.5.0 release.\nThis dependency was added with an SVC support patch in May 2015,\nbug 1237023.\n\nOptional --enable-spatial-svc is handled by the work-around\nin bug 1248335.\n\nMozReview-Commit-ID: 6NiZtKunBSm", "files": ["configure.in"], "git_node": null, "git_parents": [null], "node": "44e3eb89bf715408924cecddf5effe61df53cff3", "parents": ["476ab557fc684bde704be95adccbcb9dba6b1567"], "tags": []}], "date": 1460654381, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "kwierso@gmail.com"}, "86": {"changesets": [{"author": "Wes Kocher \u003cwkocher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1247880 - Followup to fix some silly merge bustage a=me\n\nMozReview-Commit-ID: 2XUFHXHhJdH", "files": ["js/src/jit/MIR.cpp"], "git_node": null, "git_parents": [null], "node": "f65347183228aaf0a4d31a84d7e978e274dbef1e", "parents": ["44e3eb89bf715408924cecddf5effe61df53cff3"], "tags": []}], "date": 1460655029, "git_changesets": [null], "user": "kwierso@gmail.com"}, "87": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1262846 (patch for ESR trees) - Update Graphite2 library to 1.3.8. r=jrmuizel a=sledru", "files": ["gfx/graphite2/README.mozilla", "gfx/graphite2/include/graphite2/Font.h", "gfx/graphite2/moz-gr-update.sh", "gfx/graphite2/src/CachedFace.cpp", "gfx/graphite2/src/Code.cpp", "gfx/graphite2/src/Collider.cpp", "gfx/graphite2/src/Face.cpp", "gfx/graphite2/src/GlyphCache.cpp", "gfx/graphite2/src/GlyphFace.cpp", "gfx/graphite2/src/Justifier.cpp", "gfx/graphite2/