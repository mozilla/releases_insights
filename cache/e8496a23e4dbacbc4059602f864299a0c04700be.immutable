["dom/ipc/TabChild.cpp", "gfx/layers/ipc/CompositorChild.cpp"], "git_node": null, "git_parents": [null], "node": "601934a0eba43a7ee7d3e87880446c94623a204a", "parents": ["c9682c2ac62700dbeb3ee8438ffc1ac1b128eede"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1255627 - Don't call methods of TSFTextStore::sEnabledTextStore without independent strong reference to it. r=m_kato, a=sylvestre\n\nTSFTextStore::sEnabledTextStore is a static variable to grab a reference to focused TextStore instance.  So, this may be changed by accidentally during a call of instance methods of TSFTextStore.  Then, focused TextStore may be destroyed during running a method and crash when it accesses a member variable.\n\nFor avoiding this crash, static methods which call a method of sEnabledTextStore should create an independent RefPtr to it before calling the method.\n\nMozReview-Commit-ID: 51Sor1LdABr", "files": ["widget/windows/TSFTextStore.cpp", "widget/windows/TSFTextStore.h"], "git_node": null, "git_parents": [null], "node": "28d6bd3096201eb4c66167415006f855cb42fef2", "parents": ["601934a0eba43a7ee7d3e87880446c94623a204a"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1260461 - Don't flush windows when shutting down due to a Windows log-out. r=jimm, a=sylvestre\n\nMozReview-Commit-ID: 3WWgPTxzdcz", "files": ["browser/components/sessionstore/SessionStore.jsm", "widget/windows/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "ac4a3587325d8046ab436e5966032dfc72dbb8a2", "parents": ["28d6bd3096201eb4c66167415006f855cb42fef2"], "tags": []}, {"author": "Peter Chang \u003cpchang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1261320 - Check DataSurface is vaild before using, r=milan, a=sylvestre\n\nMozReview-Commit-ID: 1uhNttyNAiq", "files": ["dom/canvas/TexUnpackBlob.cpp"], "git_node": null, "git_parents": [null], "node": "f1be5b6a974e496bc51c4486734dc2f159ad46ab", "parents": ["ac4a3587325d8046ab436e5966032dfc72dbb8a2"], "tags": []}], "date": 1461087002, "git_changesets": [null, null, null, null, null, null], "user": "kwierso@gmail.com"}, "92": {"changesets": [{"author": "Andrew Swan \u003caswan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1245956 - Don't distinguish preliminary signing for add-ons. r=mossop, a=lizzard\n\nMozReview-Commit-ID: DfbncH8YnAe", "files": ["toolkit/mozapps/extensions/content/extensions.js", "toolkit/mozapps/extensions/internal/XPIProvider.jsm", "toolkit/mozapps/extensions/test/browser/browser_details.js", "toolkit/mozapps/extensions/test/browser/browser_list.js", "toolkit/mozapps/extensions/test/xpcshell/test_signed_inject.js"], "git_node": null, "git_parents": [null], "node": "a488abb7ec3fc99c32365e224f2a810911457ded", "parents": ["f1be5b6a974e496bc51c4486734dc2f159ad46ab"], "tags": []}, {"author": "Andrew Swan \u003caswan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1245956 - Don't distinguish preliminary signing for add-ons part 2 r=mossop, a=lizzard\n\nMozReview-Commit-ID: 61Ihbe8qp0N", "files": ["toolkit/mozapps/extensions/internal/XPIProvider.jsm", "toolkit/mozapps/extensions/test/xpcshell/test_signed_inject.js"], "git_node": null, "git_parents": [null], "node": "9c9c4da067feb2227cfd0743786011949a7e725e", "parents": ["a488abb7ec3fc99c32365e224f2a810911457ded"], "tags": []}], "date": 1461163613, "git_changesets": [null, null], "user": "cbook@mozilla.com"}, "93": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1261321 - Null-check when the CompositableClient when forcing its destruction at shutdown on a CLOSED TREE. r=jnicol, a=sylvestre\n\nMozReview-Commit-ID: 2qqvYkzapzq", "files": ["gfx/layers/ipc/ImageBridgeChild.cpp"], "git_node": null, "git_parents": [null], "node": "68b732eca6a10d72904877a673624b704eb28c44", "parents": ["9c9c4da067feb2227cfd0743786011949a7e725e"], "tags": []}], "date": 14611725