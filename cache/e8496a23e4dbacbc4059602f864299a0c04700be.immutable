6 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "06f78c530838dd6aa7a211f7f071e79e57dc9b2f", "parents": ["afeaef099b4ad7d13c723c6246a2e9f153a4796d"], "tags": []}], "date": 1458387892, "git_changesets": [null, null, null], "user": "ffxbld"}, "42": {"changesets": [{"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1254784 - Add 45.0esr win64 support to bouncer, r=rail, a=NPOTB", "files": ["testing/mozharness/configs/releases/bouncer_firefox_esr.py"], "git_node": null, "git_parents": [null], "node": "ddc16d5813a398c433b25447dd9cfb8c5b51b0c0", "parents": ["06f78c530838dd6aa7a211f7f071e79e57dc9b2f"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1255245 - ESR45 generates mar files with the wrong channel ID, part II, r=rstrong, a=sylvestre", "files": ["browser/confvars.sh"], "git_node": null, "git_parents": [null], "node": "0937306e704ac4a00a15849d379f74f75ee081b5", "parents": ["ddc16d5813a398c433b25447dd9cfb8c5b51b0c0"], "tags": []}], "date": 1458519319, "git_changesets": [null, null], "user": "nthomas@mozilla.com"}, "43": {"changesets": [{"author": "Rail Aliiev \u003crail@mozilla.com\u003e", "branch": "default", "desc": "Bug 1258060 - tagging should not use DONTBUILD r=jlund a=release\n\nMozReview-Commit-ID: AgyR3qV6Mmd", "files": ["testing/mozharness/scripts/release/postrelease_version_bump.py"], "git_node": null, "git_parents": [null], "node": "03b56e444ad8063d88e3f8efe91a7003a30d5063", "parents": ["0937306e704ac4a00a15849d379f74f75ee081b5"], "tags": []}], "date": 1458583646, "git_changesets": [null], "user": "raliiev@mozilla.com"}, "44": {"changesets": [{"author": "tbirdbld", "branch": "THUNDERBIRD450b3_2016032212_RELBRANCH", "desc": "Automated checkin: version bump for thunderbird 45.0b3 release. DONTBUILD CLOSED TREE a=release", "files": ["config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "f2064e830ebab944bb5e7121327880f30709c151", "parents": ["bab23fd1d89b9ef018046d2c780746d3bc731aa9"], "tags": ["THUNDERBIRD_45_0b3_BUILD1"]}, {"author": "tbirdbld", "branch": "THUNDERBIRD450b3_2016032212_RELBRANCH", "desc": "Added THUNDERBIRD_45_0b3_RELEASE THUNDERBIRD_45_0b3_BUILD1 tag(s) for changeset f2064e830eba. DONTBUILD CLOSED TREE a=release", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "92f87dffe48c2fff8fabcd9c3b704d55be43e83b", "parents": ["f2064e830ebab944bb5e7121327880f30709c151"], "tags": []}, {"author": "tbirdbld", "branch": "default", "desc": "Automated checkin: version bump for thunderbird 45.0b3 release. DONTBUILD CLOSED TREE a=release", "files": ["config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "f7ab87e84465636b79c97abd88656da6bfb40b6b", "parents": ["03b56e444ad8063d88e3f8efe91a7003a30d5063"], "tags": []}], "date": 1458664028, "git_changesets": [null, null, null], "user": "tbirdbld"}, "45": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1255511 - Skip beforeunload prompts once nsIAppStartup shuttingDown returns true. r=Gijs, a=ritu\n\nWhen the application is asked to quit, all windows are checked to see if\nthey can close (which will spawn the permit unload dialogs). Once the\nuser grants the quit via the permit unload dialogs, nsIAppStartup\nreturns true for the shuttingDown attribute, and we know that all\nwindows allowed the shutdown to occur. This means that we don't\nhave to show the permitUnload dialogs again when SessionStore\nattempts to close the windows when it does its final async window\nflush during the quit-application-granted observer topic.\n\nMozReview-Commit-ID: DOy8ljngnTd", "files": ["browser/base/content/browser.js"], "git_node": null, "git_parents": [null], "node": "6345a3c7c1bcedd644cce4dab30b176d65f399fa", "parents": ["f7ab87e84465636b79c97abd88656da6bfb40b6b"], "tags": []}], "date": 1458673051, "git_changesets": [null], "user": "mconley@mozilla.com"}, "46": {"changesets": [{"author": "Jordan Lund \u003cjlund@mozilla.com\u003e", "branch": "default", "desc": "Bug 1258059 - generify dev configs and env for relpro by removing date strings and allow multiple products, CLOSED TREE DONTBUILD a=testing r=rail\n\nstub installers with beta-dev, add staging beta single locale, r?rail\n\nMozReview-Commit-ID: 6h1TtzVO1Jp\nMozReview-Commit-ID: Gtf4cJKsAPu", "files": ["browser/confvars.sh", "testing/mozharness/configs/builds/branch_specifics.py", "testing/mozharness/configs/releases/dev_bouncer_firefox_beta.py", "testing/mozharness/configs/releases/dev_postrelease_firefox_beta.py", "testing/mozharness/configs/releases/dev_updates_firefox_beta.py", "testing/mozharness/configs/releases/postrelease_beta.py", "testing/mozharness/configs/releases/postrelease_date.py", "testing/mozharness/configs/releases/postrelease_firefox_beta.py", "testing/mozharness/configs/releases/updates_beta.py", "testing/mozharness/configs/releases/updates_date.py", "testing/mozharness/configs/releases/updates_firefox_beta.py", "testing/mozharness/configs/single_locale/dev-mozilla-beta.py"], "git_node": null, "git_parents": [null], "node": "7cdae0f90a969758dc48360a2de1a48e5d8d1ff1", "parents": ["6345a3c7c1bcedd644cce4dab30b176d65f399fa"], "tags": []}], "date": 1458678011, "git_changesets": [null], "user": "jlund@mozilla.com"}, "47": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1212328 - Clean up some JSErrorReport-related code. r=Waldo,bz, a=ritu\n\nMozReview-Commit-ID: BqeKa6WxXUB", "files": ["dom/workers/WorkerPrivate.cpp", "js/src/frontend/TokenStream.cpp", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/jscntxt.cpp", "js/src/jsexn.cpp", "js/xpconnect/src/XPCComponents.cpp", "js/xpconnect/src/XPCConvert.cpp", "js/xpconnect/src/nsXPConnect.cpp", "netwerk/base/ProxyAutoConfig.cpp"], "git_node": null, "git_parents": [null], "node": "8abadeccb04b26e49161b80718514f8801d1c54b", "parents": ["7cdae0f90a969758dc48360a2de1a48e5d8d1ff1"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1258562: MSE] Abort if MediaSource has been shutdown. r=gerald a=ritu\n\nThe assumption was made that this code was never called if MediaSourceDecoder::NextFrameBufferedStatus() had been called before. However, that assumption was incorrect as NextFrameBufferedStatus() is only called if we had determine we had no frame buffered.\n\nMozReview-Commit-ID: 1hsEJuInION", "files": ["dom/media/mediasource/MediaSourceDecoder.cpp"], "git_node": null, "git_parents": [null], "node": "3cf9547052455c40906d3a875ddef2570535d7bb", "parents": ["8abadeccb04b26e49161b80718514f8801d1c54b"], "tags": []}, {"author": "Randell Jesup \u003crjesup@jesup.org\u003e", "branch": "default", "desc": "Bug 1254876: assert windows recording is shut down r=pkerr a=ritu\n\nMozReview-Commit-ID: JRqxBb5TgrE", "files": ["media/webrtc/trunk/webrtc/modules/audio_device/win/audio_device_core_win.cc"], "git_node": null, "git_parents": [null], "node": "7a461fddc3a948dc68a41f1ad90c64a6c5e479fb", "parents": ["3cf9547052455c40906d3a875ddef2570535d7bb"], "tags": []}], "date": 1458777598, "git_changesets": [null, null, null], "user": "kwierso@gmail.com"}, "48": {"changesets": [{"author": "Wes Kocher \u003cwkocher@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 8abadeccb04b (bug 1212328) for breaking the build a=backout\n\nMozReview-Commit-ID: 68CBJ1GpScg", "files": ["dom/workers/WorkerPrivate.cpp", "js/src/frontend/TokenStream.cpp", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/jscntxt.cpp", "js/src/jsexn.cpp", "js/xpconnect/src/XPCComponents.cpp", "js/xpconnect/src/XPCConvert.cpp", "js/xpconnect/src/nsXPConnect.cpp", "netwerk/base/ProxyAutoConfig.cpp"], "git_node": null, "git_parents": [null], "node": "836454ede32d4343e8287e585e3402a725a7fb90", "parents": ["7a461fddc3a948dc68a41f1ad90c64a6c5e479fb"