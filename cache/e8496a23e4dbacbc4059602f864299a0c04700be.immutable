mas@mozilla.com"}, "83": {"changesets": [{"author": "Eddy Bruel \u003cejpbruel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1260439 - workerdebuggersandbox_moved needs to update the wrappercache. r=bz, a=lizzard", "files": ["dom/workers/WorkerScope.cpp"], "git_node": null, "git_parents": [null], "node": "be7a56b8ecae39840187a51b0c883f1aabe1861b", "parents": ["6da110abe7ed725b23f5090817bf61c84a7fde9c"], "tags": []}], "date": 1460559003, "git_changesets": [null], "user": "cbook@mozilla.com"}, "84": {"changesets": [{"author": "Nicolas B. Pierron \u003cnicolas.b.pierron@mozilla.com\u003e", "branch": "default", "desc": "Bug 1234736 - IonMonkey: Recover Math.imul as an int32 operation. r=h4writer a=sylvestre\n\nMozReview-Commit-ID: BYEiVXwe7c4", "files": ["js/src/jit-test/tests/ion/dce-with-rinstructions.js", "js/src/jit/Recover.cpp", "js/src/jit/Recover.h", "js/src/jsmath.cpp", "js/src/jsmath.h"], "git_node": null, "git_parents": [null], "node": "dbb29f84cc6ac11eb3d6b1087ba0b2b99809e365", "parents": ["be7a56b8ecae39840187a51b0c883f1aabe1861b"], "tags": []}, {"author": "JW Wang \u003cjwwang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237806 - update playback position before entering buffering mode so the currentTime of the media element is more accurate during buffering. r=jya. a=sylvestre\n\nMozReview-Commit-ID: 4YqLNGSO8fp", "files": ["dom/media/MediaDecoderStateMachine.cpp"], "git_node": null, "git_parents": [null], "node": "ef722522ea0c447c24d29a4fee8a066b2743027f", "parents": ["dbb29f84cc6ac11eb3d6b1087ba0b2b99809e365"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237564 - Fix minor bug with a lexical declaration shadowing a non-configurable global. r=shu a=sylvestre\n\nMozReview-Commit-ID: 8lEVWnCPZNY", "files": ["js/src/jit-test/tests/basic/bug1237564.js", "js/src/jit/BaselineCompiler.cpp"], "git_node": null, "git_parents": [null], "node": "64421b085ce2834c91f262539373324067177fa4", "parents": ["ef722522ea0c447c24d29a4fee8a066b2743027f"], "tags": []}, {"author": "Nick Fitzgerald \u003cfitzgen@gmail.com\u003e", "branch": "default", "desc": "Bug 1247299 - Force SavedFrame columns to be 0 in JS_MORE_DETERMINISTIC builds; r=sfink a=sylvestre\n\nThe fuzzers' differential testing would like to test the asm.js vs non-asm.js\ncode which may or may not involve SavedFrame stacks, but asm.js doesn't ever\nrecord columns so any test case with a SavedFrame stack will fail. To enable the\nfuzzers to get deeper into the system, rather than failing early because of\nSavedFrame stacks, we force SavedFrame columns to 0 in the deterministic builds\nthat the fuzzers use.\n\nMozReview-Commit-ID: GyMFmjhkJDU", "files": ["js/src/vm/SavedStacks.cpp"], "git_node": null, "git_parents": [null], "node": "d08860d4ef5cb8229178c2beddc50ada1f4b3cab", "parents": ["64421b085ce2834c91f262539373324067177fa4"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1247701 - Bail from ArrayShiftDenseKernel if the array is used by for-in iteration. r=jandem,bz a=sylvestre\n\nMozReview-Commit-ID: GZsBlnKhY5F", "files": ["js/src/jsarray.cpp", "js/src/tests/ecma_6/Array/shift_for_in.js"], "git_node": null, "git_parents": [null], "node": "cadc27270fb0ae4f08a6cda211f5dccdc555f6e5", "parents": ["d08860d4ef5cb8229178c2beddc50ada1f4b3cab"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1244502 - Fix minor correctness bug with fun.call bailouts and |arguments|. r=h4writer a=sylvestre\n\nMozReview-Commit-ID: 27EehDqhynO", "files": ["js/src/jit-test/tests/ion/bug1244502.js", "js/src/jit/BaselineBailouts.cpp"], "git_node": null, "git_parents": [null], "node": "cf810786f79deab19cde49c3aa3238ec083c7699", "parents": ["cadc27270fb0ae4f08a6cda211f5dccdc555f6e5"], "tags": []}, {"author": "Eddy Bruel \u003cejpbruel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1241841 - Clear the worker's debugger event queue before destroying its context;r=khuey a=sylvestre\n\nMozReview-Commit-ID: 2DqTq4IRsw", "files": ["dom/workers/RuntimeService.cpp", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h"], "git_node": null, "git_parents": [null], "node": "b0055bb88df83eab3baa9e8fc6e8bfe9d32c68d8", "parents": ["cf810786f79deab19cde49c3aa3238ec083c7699"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1250403 - Part 1. Define ARCH_CPU_ARM64 instead of ARCH_CPU_AARCH64. r=billm a=sylvestre\n\nChromium defines ARCH_CPU_ARM64 and ARCH_CPU_ARM_FAMILY for aarch64.  So we should use it instead.  Because webrtc and sandbox already define it\n\nMozReview-Commit-ID: C7GYnpRryhA", "files": ["ipc/chromium/src/build/build_config.h"], "git_node": null, "git_parents": [null], "node": "7eb9c17e05f28a3b363a91b499ee7b206a54b248", "parents": ["b0055bb88df83eab3baa9e8fc6e8bfe9d32c68d8"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1250403 - Part 2. Import crbug #354405 for aarch64. r=billm a=sylvestre\n\nMozReview-Commit-ID: A3sArb6IE6m", "files": ["ipc/chromium/moz.build", "ipc/chromium/src/base/atomicops.h", "ipc/chromium/src/base/atomicops_internals_arm64_gcc.h"], "git_node": null, "git_parents": [null], "node": "71dbff20d2a92f589c7cfe6ebb71bbeff186d5f0", "parents": ["7eb9c17e05f28a3b363a91b499ee7b206a54b248"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1252699 - Set WEBRTC_DETECT_ARM_NEON when optional neon is requested. r=jesup a=sylvestre\n\nMozReview-Commit-ID: 6DpM7hltSlc", "files": ["media/webrtc/trunk/webrtc/build/common.gypi"], "git_node": null, "git_parents": [null], "node": "5f2ca769a06445856e774ed1b999471a1c20bd2f", "parents": ["71dbff20d2a92f589c7cfe6ebb71bbeff186d5f0"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "defaul