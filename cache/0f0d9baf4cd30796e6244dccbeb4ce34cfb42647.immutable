 ["f777df8cc22c70093af01af364f6587b0094234b"], "node": "cbd04023d9582b850ddce9d874e8cc776f2e9142", "parents": ["f23f859a5df5fe9fcf7d0f1c62ebea55f89f76b4"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 127dce3ac830d68df8479b5f32c9d2430363dba2 with DEVEDITION_161_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "85a4a2743991ff5f261d2a21c84a259a21e1f11b", "git_parents": ["4d2cb3c40daa5b842165593b1c291aa98359c0c9"], "node": "1450c3bd2059ee66df8af960606fac28e9466b39", "parents": ["cbd04023d9582b850ddce9d874e8cc776f2e9142"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 127dce3ac830d68df8479b5f32c9d2430363dba2 with FIREFOX-ANDROID_161_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "228a125bc7a9995c1678e07c9271ed93e8aefa39", "git_parents": ["85a4a2743991ff5f261d2a21c84a259a21e1f11b"], "node": "dbf1e6a2fc179048e18274c3e137526c5d83bc01", "parents": ["1450c3bd2059ee66df8af960606fac28e9466b39"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with FIREFOX_161_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "54ba67ac87ef15dd0182a49653925245347ce568", "git_parents": ["228a125bc7a9995c1678e07c9271ed93e8aefa39"], "node": "0cb5d9e25f78dd8d82bfe4b72170f63d270e99ff", "parents": ["dbf1e6a2fc179048e18274c3e137526c5d83bc01"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with FIREFOX-ANDROID_161_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "43837475decf937354f3dacc66a32a21cfdeca72", "git_parents": ["54ba67ac87ef15dd0182a49653925245347ce568"], "node": "3e1fb4abe13e66a194c8978fadef13a04e9182a8", "parents": ["0cb5d9e25f78dd8d82bfe4b72170f63d270e99ff"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with DEVEDITION_161_0b1_BUILD2 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "943668ce6461bb194e7a5c62aff91354231ec957", "git_parents": ["43837475decf937354f3dacc66a32a21cfdeca72"], "node": "237cb2ff1cd7b0a1797e05d0a9ec2b7ad670919e", "parents": ["3e1fb4abe13e66a194c8978fadef13a04e9182a8"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with FIREFOX-ANDROID_161_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "9223d69324d64d9cfaec15622c7054afd1b4b02e", "git_parents": ["943668ce6461bb194e7a5c62aff91354231ec957"], "node": "295f61ad7001e6fecb6d8c17134061200e373c6e", "parents": ["237cb2ff1cd7b0a1797e05d0a9ec2b7ad670919e"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with FIREFOX_161_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "65e9d250971e0de562319754f96a161576cdf339", "git_parents": ["9223d69324d64d9cfaec15622c7054afd1b4b02e"], "node": "0ad65749232bafd98f028fac214d9b9dcb00b6dd", "parents": ["295f61ad7001e6fecb6d8c17134061200e373c6e"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 483832d21588426d471649f0176bd31f4062d926 with DEVEDITION_161_0b1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d969d8ff7dc7d2aef7ba8b339b6d1d5cb75efce7", "git_parents": ["65e9d250971e0de562319754f96a161576cdf339"], "node": "ce9549362989c7f2a51e3e1e74349d34290d4eae", "parents": ["0ad65749232bafd98f028fac214d9b9dcb00b6dd"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging d84e7a6936554efe26097d9d9b24a0e11330e630 with FIREFOX_160_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "968cf760b27e02318ce79fe6e567e77a873e1a5e", "git_parents": ["d969d8ff7dc7d2aef7ba8b339b6d1d5cb75efce7"], "node": "de650639e1818af429c0fc2677c76898fac897b7", "parents": ["ce9549362989c7f2a51e3e1e74349d34290d4eae"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 07da6c6c016add6f8270a4ac0e53320df73b1b1c with FIREFOX_115_45_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "3311bf31e72bca1416963ff90ac5c635f39d0407", "git_parents": ["968cf760b27e02318ce79fe6e567e77a873e1a5e"], "node": "488194b303066e73766448d2eccf83068c4ae773", "parents": ["de650639e1818af429c0fc2677c76898fac897b7"], "tags": []}], "date": 1794317421, "git_changesets": ["01352a7bdedadc3bd261351a7204ea68bbaf5a36", "94abc887fb0bf994b3724306a45207ff8a5763fd", "4039739d0f8c9f4cf5e8314360c20fe9b01a7729", "583ce48c728b05c4f055d4abc7d287983ef5ca5b", "acaf502510433f8eb0cbcc950f244717836a3ac2", "d4606f959463b819990b394c65e2ab9b5273e589", "7f75d7410975c2d5552310eef7b68a00d2c083fd", "8c851febe92219425bfb5400507f6b927da6852c", "f384887b1b26c8f5d815dcb8f387d927948b56b5", "4de14a84838e326c846d464c40a5e8b288193b06", "864166e0f3ae56c9e3fd5324e35a575855d4841c", "95c93b104d57096a19a3a186d81e909eb17b152c", "f777df8cc22c70093af01af364f6587b0094234b", "4d2cb3c40daa5b842165593b1c291aa98359c0c9", "85a4a2743991ff5f261d2a21c84a259a21e1f11b", "228a125bc7a9995c1678e07c9271ed93e8aefa39", "54ba67ac87ef15dd0182a49653925245347ce568", "43837475decf937354f3dacc66a32a21cfdeca72", "943668ce6461bb194e7a5c62aff91354231ec957", "9223d69324d64d9cfaec15622c7054afd1b4b02e", "65e9d250971e0de562319754f96a161576cdf339", "d969d8ff7dc7d2aef7ba8b339b6d1d5cb75efce7", "968cf760b27e02318ce79fe6e567e77a873e1a5e", "3311bf31e72bca1416963ff90ac5c635f39d0407"], "user": "ffxbld@lando.moz.tools"}, "1815": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067925 - Clear ImageBridgeParent's about-to-send flag after flushing async messages.  a=diannaS DONTBUILD\n\nThe flag was never reset after the first transaction, so NotifyNotUsed\nmessages generated outside of a transaction (e.g. on ReleaseCompositable)\nwere queued until the next transaction on that bridge. If none came, the\ncontent process kept the textures alive indefinitely, along with the\ndecoded frames they reference in the RDD process.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336297\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338093\n", "files": ["gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/ImageBridgeParent.cpp"], "git_node": "bcf34d7669ad364603569e5ba9cd8e039d856e51", "git_parents": ["a643dc44d912caddba210d9648264a4b2ae7659c"], "node": "aad248222514a5f99c97c90a89762a6d669ec289", "parents": ["9d7acfc554c956a82f27cd37a552d2610e3f27da"], "tags": []}], "date": 1794341770, "git_changesets": ["bcf34d7669ad364603569e5ba9cd8e039d856e51"], "user": "dsmith@mozilla.com"}, "1816": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079057 - Avoid registering a font-set that is being destroyed.   a=diannaS\n\n(based on clauditor-suggested patch)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332737\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341025\n", "files": ["gfx/thebes/gfxPlatformFontList.h", "gfx/thebes/gfxUserFontSet.h"], "git_node": "d3968530a7cc35e7b9da83f7309fdb6c0c2bddda", "git_parents": ["bcf34d7669ad364603569e5ba9cd8e039d856e51"], "node": "f10eb7e55e39605cef3d206a65b1daefcfd77791", "parents": ["aad248222514a5f99c97c90a89762a6d669ec289"], "tags": []}], "date": 1794341792, "git_changesets": ["d3968530a7cc35e7b9da83f7309fdb6c0c2bddda"], "user": "dsmith@mozilla.com"}, "1817": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 1 - Clean up ref count checking.  a=pascalc\n\nA few places in the cycle collector take advantage of \"int as bool\" when\nchecking if the refcount is zero, which I find confusing. This patch adds\na new predicate on nsPurpleBufferEntry that return true if the ref count is\nzero.\n\nIt also uses early return in a few places.\n\nFor SnowWhiteKiller, it adds a new predicate to SnowWhiteObject that checks if\nit is still okay to kill the object. It hoists this check out of MaybeKillObject,\nturning it into KillObject. The check was redundant in the budgeted case. This\nwill be relevant in the final patch that modifies KillObject further.\n\nThis also consolidates the mBudget check because it should not matter if we\nadd swo to mObjects before or after we remove the entry from the purple buffer.\n\nThis patch should not change any actual behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337231\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342253\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "daeea7b751f8091713452767529d5b6dbc219195", "git_parents": ["d3968530a7cc35e7b9da83f7309fdb6c0c2bddda"], "node": "d4dacc9b6f1e836033eeb58b63002a68bcdf4814", "parents": ["f10eb7e55e39605cef3d206a65b1daefcfd77791"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 2 - Make the CC resilient against zero refcount objects.  a=pascalc\n\nThe cycle collector currently assumes that the SnowWhiteKiller has successfully\neliminated all objects with a refcount of 0 from the purple buffer. The method\nPtrInfo::IsGrayJS() relies on there being no refcounted objects with a refcount\nof 0, because it uses that to represent gray JS objects.\n\nA later patch will loosen the reentrance guards, so we will no longer be sure\nthat SnowWhiteKiller actually finished at the start of the current CC slice, so\nthe CC needs to be able to deal with objects with a refcount of 0 existing.\nThese objects can't be part of a cycle, so the CC only needs to ensure that they\nare kept out of the CC graph.\n\nThis requires some changes\n* Skip any refcount 0 objects we see in the purple buffer while getting roots,\n  instead of asserting.\n* SelectPointers might not clear snow white objects, so update the assert.\n* If an object was added to the graph and then its refcount dropped to 0\n  before we called DescribeRefCountedNode on the object, treat it like it\n  has a large valid refcount. Only release assert if the refcount is 0 if we're\n  not freeing snow white objects. Make the upper bound release assert a little\n  stricter. Delay logging until we've set the fake refcount.\n* An object could be in the purple buffer with a refcount of 0 in ScanRoots\n  if the refcount dropped to 0 after DescribeRefCountedNode. In that case,\n  it is fine to be cautious and treat it as being alive. To accommodate this\n  we only need to relax an assertion.\n\nAlso, shrink the CC builder's MRUCache to fix static_assert.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337232\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342254\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "71181be2212b023bb90e047d2cb77913ce13174a", "git_parents": ["daeea7b751f8091713452767529d5b6dbc219195"], "node": "e6c59afbe3c815b30806189c6055ad9d55646026", "parents": ["d4dacc9b6f1e836033eeb58b63002a68bcdf4814"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 3 - Add a helper class for whiteNodes in CollectWhite.  a=pascalc\n\nThis is done to make the next step cleaner and should not change any\nbehavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337233\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342255\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "744460de6a06c348252563cad7e75425c859bcc5", "git_parents": ["71181be2212b023bb90e047d2cb77913ce13174a"], "node": "00cc4cd310c5349d54b2f7e7af7ed8ac3d32e7cb", "parents": ["e6c59afbe3c815b30806189c6055ad9d55646026"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 4 - Clear the graph early to simplify the condition of when it is safe to GC.  a=pascalc\n\nUnlink() in CollectWhite() can end up running arbitrary JS, which can GC,\nwhich can cause the JS pointers in the CC to become stale. This isn't a safety\nproblem because we don't use the JS pointers after the Root() loop and we have\na strong reference to any C++ objects being held in a WhiteNode.\n\nHowever, it is hard to describe the specific condition of when it is safe to GC.\nThis patch makes that condition easier to specify: it is safe to GC if and only\nif the CC graph is empty. It does this by clearing the graph after the Root() loop.\n\nTo allow this, the patch changes it so that we store the data needed for Unlink\nand Unroot within WhiteNode, rather than the graph. The drawback is that it will\ntake twice as much memory to store the WhiteNodes, although the segments will\nstill have the same size. On the upside, we avoid some pointer chasing, and we\nreduce the amount of memory being used before we run Unlink which might help.\n\nPotentially this increases the max pause time in an incremental CC, because we\nwill no longer clear the graph in a separate slice, but I don't think it takes\nvery long to clear the graph so I don't think it matters.\n\nThe patch moves the mParticipant assertion to the WhiteNode ctor. Before this\npatch, WhiteNode contained a reference to the CC graph, so if something was\nremoved from the CC graph, then mPInfo-\u003emParticipant could change, and the\nassertions in Unlink() and Unroot() might catch something. Now, the mParticipant\ndata is stored directly within WhiteNode, so it can't be changed if an object\ndies. However, we've already called Root() so it shouldn't be a problem.\n\nNow that the safety condition is clean, change FinishAnyCurrentCollection to use\na release assert when confirming there are no remaining dead pointers in the graph.\nThis requires building the three IsEmpty methods in non-debug builds.\n\nThis also moves the ClearWhiteJSWeakRefTargets call inside AutoAssertNoGC, because\nif it could run the GC, we would fail to finish the CC because mActivelyCollecting\nis true.\n\nFor ESR115, also fold in bug 1930253 in case we depend on that somehow.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337234\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342256\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "1ec6e03a41637b8baadd7a41e2c90f712b1a56de", "git_parents": ["744460de6a06c348252563cad7e75425c859bcc5"], "node": "40ec5872b0631fe58a7d6fc30cd465154c413f0b", "parents": ["00cc4cd310c5349d54b2f7e7af7ed8ac3d32e7cb"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 5 - Make an append-only version of VisitEntries for PurpleScanBlackVisitor.  a=pascalc\n\nA later patch will allow the CC to finish a cycle collection when mFreeingSnowWhite\nis true. FreeSnowWhiteWithBudget runs destructors while iterating over the\npurple buffer, which can make us need to finish the CC. ScanIncrementalRoots is\npart of the critical path of finishing a cycle collection, and iterates over the\npurple buffer using PurpleScanBlackVisitor. It is okay to append to the purple\nbuffer while somebody further up the stack is iterating over it, but not to\nmodify or remove existing entries.\n\nFortunately, PurpleScanBlackVisitor only needs to add entries, so in this patch\nI add a new version of VisitEntries that does not allow modifying or removing\nexisting purple buffer entries. We lose out on compaction, but it isn't going to\nbe useful when we're not removing entries.\n\nAlso, give \"ar\" a better name in preparation for the next patch which will add\na second AutoRestore value to these methods. I added a little RAII helper class\nto deal with the shared nursery cleanup.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337235\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342257\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "498ad65efab83b2bdc5c5d6d4f4aa52b8f4de885", "git_parents": ["1ec6e03a41637b8baadd7a41e2c90f712b1a56de"], "node": "fd9bcda905152cedb3f583d412c7b54c5555aeba", "parents": ["40ec5872b0631fe58a7d6fc30cd465154c413f0b"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 6 - Dynamically prevent iterator invalidation in the purple buffer.  a=pascalc\n\nWhile a function is iterating over the purple buffer using VisitEntries,\nit is okay to add more entries to the purple buffer, but not to remove\nor modify existing entries. Enforce this by tracking when we're iterating\nover the purple buffer with a new data member, and use release asserts\nto enforce that invalidation isn't happening.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337236\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342258\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "2f6c55ecda6386468b35794b3e550b31c1184760", "git_parents": ["498ad65efab83b2bdc5c5d6d4f4aa52b8f4de885"], "node": "a75f192c5b54c0e084f5a67b50b7d1a670ac8860", "parents": ["fd9bcda905152cedb3f583d412c7b54c5555aeba"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 7 - Add CCReason::GC_WAITING_NOW.  a=pascalc\n\nGC_WAITING is used in PrepareForGarbageCollection to indicate that we need to\nfinish up the CC immediately so that it is safe to GC, but in the CC/GC\nscheduler it is used more to mean that we want to GC eventually, so we should\nhurry it up with the CC.\n\nThis patch splits up the two uses by adding a new reason GC_WAITING_NOW\nfor PrepareForGarbageCollection. This will be used in the next patch.\n\nI also simplified things a little and always use GC_WAITING_NOW in\nFinishAnyCurrentCollection. Otherwise, it gets a little weird to\nhave nsCycleCollector_finishAnyCurrentCollection not actually\nfinish the current CC in some conditions after the next patch. It is only used\nin testing so I think that's fine.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337237\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342259\n", "files": ["xpcom/base/nsCycleCollectionParticipant.h", "xpcom/base/nsCycleCollector.cpp"], "git_node": "07309a2e923e2fb4d1173fcf7155292fea85c2fd", "git_parents": ["2f6c55ecda6386468b35794b3e550b31c1184760"], "node": "09a531139bf971f46d62400a37b709c2c39e1f43", "parents": ["a75f192c5b54c0e084f5a67b50b7d1a670ac8860"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 8 - Allow reentrance in Collect during FreeSnowWhite.  a=pascalc\n\nIf the GC is trying to finish the CC, we need to advance the CC enough that\nthe graph is empty, even if we're in the middle of FreeSnowWhite. We'll still\ntry to finish the CC if we can, for instance if it was in CleanupPhase when\nwe GCed, because we'll collect things sooner if the CC is fully done before\nthe GC runs.\n\nThis patch weakens the reentrance guard, and doesn't set mActivelyCollecting\nto true until we're done with FreeSnowWhite. FreeSnowWhite itself also\nguards against mFreeingSnowWhite so we won't reenter there.\n\nAlso, move collectedAny closer to where it is used.\n\nThe SnowWhiteKiller::Visit() change is tricky. In the unbudgeted version of the\nSWK, snow white objects are removed from the purple buffer before any destructors\nare run. If a destructor of a snow white object runs JS, we can end up finishing\na CC while they are in this state. We need to ensure that the CC does not decide\nthese snow white objects need to be unlinked, so we want them to be treated as\nincremental roots. As they aren't in the purple buffer, we instead remove them\nfrom the CC graph (as though they had died) which will mark them as incremental\nroots. If the snow white objects are not yet in the graph, and get resurrected,\nthey will end up back in the purple buffer, and thus will be treated as\nincremental roots. The behavior does not change for a budgeted SWK, which was\nalready removing objects from the graph immediately before destroying them.\n\nI added a comment about FinalizeDeferredThings reentrance causing\nEndCycleCollectionCallback weirdness. This is pre-existing.\n\nWhile I'm touching this code anyways, I adjusted the !IsIncrementalGCInProgress() assertion\nin Collect(). This could happen if you are using test functions to trigger a budgeted CC\nslice that starts an IGC inside from the unlink method, hits the budget before\nCleanupAfterCollection can run, then runs another slice via the testing function.\nBeginCollection will finish the IGC before looking at JS and CleanupPhase doesn't look at\nit, so this is fine. This is pre-existing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337238\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342260\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "959949b5210013d381f6a079710f194dce23669b", "git_parents": ["07309a2e923e2fb4d1173fcf7155292fea85c2fd"], "node": "ab8666f1f0aa678d9723ed2475a9effe1b4fde71", "parents": ["09a531139bf971f46d62400a37b709c2c39e1f43"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 9 - Fix potential ForgetSkippable reentrance issues.  a=pascalc\n\nThis patch fixes a few pre-existing issues with ForgetSkippable.\n\nIn theory, PrepareForForgetSkippable might be able to start a new CC in\nForgetSkippable, so to be safe, recheck that we're idle after we call it.\n\nForgetSkippable should set mFreeingSnowWhite.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337239\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342261\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "fa8905d012c9c3f8080e31868c2380c6c61e4df4", "git_parents": ["959949b5210013d381f6a079710f194dce23669b"], "node": "c128eb2f30c53158f145729c98c17e84058c07c8", "parents": ["ab8666f1f0aa678d9723ed2475a9effe1b4fde71"], "tags": []}], "date": 1794567349, "git_changesets": ["daeea7b751f8091713452767529d5b6dbc219195", "71181be2212b023bb90e047d2cb77913ce13174a", "744460de6a06c348252563cad7e75425c859bcc5", "1ec6e03a41637b8baadd7a41e2c90f712b1a56de", "498ad65efab83b2bdc5c5d6d4f4aa52b8f4de885", "2f6c55ecda6386468b35794b3e550b31c1184760", "07309a2e923e2fb4d1173fcf7155292fea85c2fd", "959949b5210013d381f6a079710f194dce23669b", "fa8905d012c9c3f8080e31868c2380c6c61e4df4"], "user": "pchevrel@mozilla.com"}, "1818": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Backed out 9 changesets (bug 2078599) for causing build bustages in nsCycleCollector.cpp a=backout\n\nBacked out changeset fa8905d012c9 (bug 2078599)\nBacked out changeset 959949b52100 (bug 2078599)\nBacked out changeset 07309a2e923e (bug 2078599)\nBacked out changeset 2f6c55ecda63 (bug 2078599)\nBacked out changeset 498ad65efab8 (bug 2078599)\nBacked out changeset 1ec6e03a4163 (bug 2078599)\nBacked out changeset 744460de6a06 (bug 2078599)\nBacked out changeset 71181be2212b (bug 2078599)\nBacked out changeset daeea7b751f8 (bug 2078599)\n", "files": ["xpcom/base/nsCycleCollectionParticipant.h", "xpcom/base/nsCycleCollector.cpp"], "git_node": "51a8830e2e47cb20cc95a5c7a269b0ef5696009f", "git_parents": ["fa8905d012c9c3f8080e31868c2380c6c61e4df4"], "node": "08ce1680183f64b4ac227f836cedde0ddd1a1853", "parents": ["c128eb2f30c53158f145729c98c17e84058c07c8"], "tags": []}], "date": 1794572387, "git_changesets": ["51a8830e2e47cb20cc95a5c7a269b0ef5696009f"], "user": "pchevrel@mozilla.com"}, "1819": {"changesets": [{"author": "Jonatan Wallmander \u003cjonatan.wallmander@kdab.com\u003e", "branch": "default", "desc": "Bug 2076412 - Copy shared memory when updating uniform texture state.  a=pascalc\n\nThis ensures that the steps taken behave correctly.\nAlso adapt loops etc. to use the local Vector.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338665\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340021\n", "files": ["dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLProgram.h"], "git_node": "e3bcf24ddfb82615e2f8ab0966fd7f535db6343e", "git_parents": ["51a8830e2e47cb20cc95a5c7a269b0ef5696009f"], "node": "b3b1f832d211558c139817c361722dfe11ce369f", "parents": ["08ce1680183f64b4ac227f836cedde0ddd1a1853"], "tags": []}], "date": 1794593540, "git_changesets": ["e3bcf24ddfb82615e2f8ab0966fd7f535db6343e"], "user": "pchevrel@mozilla.com"}, "1820": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset e3bcf24ddfb8 (bug 2076412) for causing build bustages in WebGLContextGL.cpp a=backout\n", "files": ["dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLProgram.h"], "git_node": "4190f39c2c918538cf0068aa4150a58d57f53216", "git_parents": ["e3bcf24ddfb82615e2f8ab0966fd7f535db6343e"], "node": "1f85418e16a06e3d88886f73dbb51c9f3103e375", "parents": ["b3b1f832d211558c139817c361722dfe11ce369f"], "tags": []}], "date": 1794597722, "git_changesets": ["4190f39c2c918538cf0068aa4150a58d57f53216"], "user": "pchevrel@mozilla.com"}, "1821": {"changesets": [{"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2092632 - disable two NTLM tests which fail after Windows update. DONTBUILD\n\nThe November 2026 update for Windows 11 contained KB 5135557 which caused the\ntest failures. Temporarily disable them until they are fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342756\n", "files": ["netwerk/test/unit/xpcshell.ini"], "git_node": "c543700d077a4f9ac0bbffbb812e897400fd1437", "git_parents": ["4190f39c2c918538cf0068aa4150a58d57f53216"], "node": "55f47469da0e372adf3c8238983d6963454cd249", "parents": ["1f85418e16a06e3d88886f73dbb51c9f3103e375"], "tags": []}], "date": 1794603296, "git_changesets": ["c543700d077a4f9ac0bbffbb812e897400fd1437"], "user": "archaeopteryx@coole-files.de"}, "1822": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 1 - Clean up ref count checking.  a=pascalc\n\nA few places in the cycle collector take advantage of \"int as bool\" when\nchecking if the refcount is zero, which I find confusing. This patch adds\na new predicate on nsPurpleBufferEntry that return true if the ref count is\nzero.\n\nIt also uses early return in a few places.\n\nFor SnowWhiteKiller, it adds a new predicate to SnowWhiteObject that checks if\nit is still okay to kill the object. It hoists this check out of MaybeKillObject,\nturning it into KillObject. The check was redundant in the budgeted case. This\nwill be relevant in the final patch that modifies KillObject further.\n\nThis also consolidates the mBudget check because it should not matter if we\nadd swo to mObjects before or after we remove the entry from the purple buffer.\n\nThis patch should not change any actual behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342253\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "6746d3bb9da016cf2fbbb87227b43167ce4e9649", "git_parents": ["c543700d077a4f9ac0bbffbb812e897400fd1437"], "node": "82a443f8072957bb75fb849270fe9ea31bdea44e", "parents": ["55f47469da0e372adf3c8238983d6963454cd249"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 2 - Make the CC resilient against zero refcount objects.  a=pascalc\n\nThe cycle collector currently assumes that the SnowWhiteKiller has successfully\neliminated all objects with a refcount of 0 from the purple buffer. The method\nPtrInfo::IsGrayJS() relies on there being no refcounted objects with a refcount\nof 0, because it uses that to represent gray JS objects.\n\nA later patch will loosen the reentrance guards, so we will no longer be sure\nthat SnowWhiteKiller actually finished at the start of the current CC slice, so\nthe CC needs to be able to deal with objects with a refcount of 0 existing.\nThese objects can't be part of a cycle, so the CC only needs to ensure that they\nare kept out of the CC graph.\n\nThis requires some changes\n* Skip any refcount 0 objects we see in the purple buffer while getting roots,\n  instead of asserting.\n* SelectPointers might not clear snow white objects, so update the assert.\n* If an object was added to the graph and then its refcount dropped to 0\n  before we called DescribeRefCountedNode on the object, treat it like it\n  has a large valid refcount. Only release assert if the refcount is 0 if we're\n  not freeing snow white objects. Make the upper bound release assert a little\n  stricter. Delay logging until we've set the fake refcount.\n* An object could be in the purple buffer with a refcount of 0 in ScanRoots\n  if the refcount dropped to 0 after DescribeRefCountedNode. In that case,\n  it is fine to be cautious and treat it as being alive. To accommodate this\n  we only need to relax an assertion.\n\nAlso, shrink the CC builder's MRUCache to fix static_assert.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342254\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "e5b818ffdfcee112e1a3dcc2a30185a7d2f05a58", "git_parents": ["6746d3bb9da016cf2fbbb87227b43167ce4e9649"], "node": "8857c229b43fef4f7c1fb4319f1d142e75b11f5c", "parents": ["82a443f8072957bb75fb849270fe9ea31bdea44e"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 3 - Add a helper class for whiteNodes in CollectWhite.  a=pascalc\n\nThis is done to make the next step cleaner and should not change any\nbehavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342255\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "7eed5920db470d2f035fa0bb581cf3980b0769e1", "git_parents": ["e5b818ffdfcee112e1a3dcc2a30185a7d2f05a58"], "node": "bac1455055e9834e5c5f6aac81bd5a22243d38e4", "parents": ["8857c229b43fef4f7c1fb4319f1d142e75b11f5c"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 4 - Clear the graph early to simplify the condition of when it is safe to GC.  a=pascalc\n\nUnlink() in CollectWhite() can end up running arbitrary JS, which can GC,\nwhich can cause the JS pointers in the CC to become stale. This isn't a safety\nproblem because we don't use the JS pointers after the Root() loop and we have\na strong reference to any C++ objects being held in a WhiteNode.\n\nHowever, it is hard to describe the specific condition of when it is safe to GC.\nThis patch makes that condition easier to specify: it is safe to GC if and only\nif the CC graph is empty. It does this by clearing the graph after the Root() loop.\n\nTo allow this, the patch changes it so that we store the data needed for Unlink\nand Unroot within WhiteNode, rather than the graph. The drawback is that it will\ntake twice as much memory to store the WhiteNodes, although the segments will\nstill have the same size. On the upside, we avoid some pointer chasing, and we\nreduce the amount of memory being used before we run Unlink which might help.\n\nPotentially this increases the max pause time in an incremental CC, because we\nwill no longer clear the graph in a separate slice, but I don't think it takes\nvery long to clear the graph so I don't think it matters.\n\nThe patch moves the mParticipant assertion to the WhiteNode ctor. Before this\npatch, WhiteNode contained a reference to the CC graph, so if something was\nremoved from the CC graph, then mPInfo-\u003emParticipant could change, and the\nassertions in Unlink() and Unroot() might catch something. Now, the mParticipant\ndata is stored directly within WhiteNode, so it can't be changed if an object\ndies. However, we've already called Root() so it shouldn't be a problem.\n\nNow that the safety condition is clean, change FinishAnyCurrentCollection to use\na release assert when confirming there are no remaining dead pointers in the graph.\nThis requires building the three IsEmpty methods in non-debug builds.\n\nThis also moves the ClearWhiteJSWeakRefTargets call inside AutoAssertNoGC, because\nif it could run the GC, we would fail to finish the CC because mActivelyCollecting\nis true.\n\nFor ESR115, also fold in bug 1930253 in case we depend on that somehow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342256\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "8c179da90eabc1ad20567683ca068e4cc5446cca", "git_parents": ["7eed5920db470d2f035fa0bb581cf3980b0769e1"], "node": "121321dae9de57e75ec7f8083abe7319ffc5a76e", "parents": ["bac1455055e9834e5c5f6aac81bd5a22243d38e4"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 5 - Make an append-only version of VisitEntries for PurpleScanBlackVisitor.  a=pascalc\n\nA later patch will allow the CC to finish a cycle collection when mFreeingSnowWhite\nis true. FreeSnowWhiteWithBudget runs destructors while iterating over the\npurple buffer, which can make us need to finish the CC. ScanIncrementalRoots is\npart of the critical path of finishing a cycle collection, and iterates over the\npurple buffer using PurpleScanBlackVisitor. It is okay to append to the purple\nbuffer while somebody further up the stack is iterating over it, but not to\nmodify or remove existing entries.\n\nFortunately, PurpleScanBlackVisitor only needs to add entries, so in this patch\nI add a new version of VisitEntries that does not allow modifying or removing\nexisting purple buffer entries. We lose out on compaction, but it isn't going to\nbe useful when we're not removing entries.\n\nAlso, give \"ar\" a better name in preparation for the next patch which will add\na second AutoRestore value to these methods. I added a little RAII helper class\nto deal with the shared nursery cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342257\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "51234719cd4abe0ebc0d555f126034d59abc9bd5", "git_parents": ["8c179da90eabc1ad20567683ca068e4cc5446cca"], "node": "dbcf6bc1285caf4a088d69d682938453905e9cc7", "parents": ["121321dae9de57e75ec7f8083abe7319ffc5a76e"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 6 - Dynamically prevent iterator invalidation in the purple buffer.  a=pascalc\n\nWhile a function is iterating over the purple buffer using VisitEntries,\nit is okay to add more entries to the purple buffer, but not to remove\nor modify existing entries. Enforce this by tracking when we're iterating\nover the purple buffer with a new data member, and use release asserts\nto enforce that invalidation isn't happening.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342258\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "701ebb517db3d4b249a748b4851dfb6e236b1132", "git_parents": ["51234719cd4abe0ebc0d555f126034d59abc9bd5"], "node": "126df302c99781676f9f39d2707a69ca17f11fb6", "parents": ["dbcf6bc1285caf4a088d69d682938453905e9cc7"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 7 - Add CCReason::GC_WAITING_NOW.  a=pascalc\n\nGC_WAITING is used in PrepareForGarbageCollection to indicate that we need to\nfinish up the CC immediately so that it is safe to GC, but in the CC/GC\nscheduler it is used more to mean that we want to GC eventually, so we should\nhurry it up with the CC.\n\nThis patch splits up the two uses by adding a new reason GC_WAITING_NOW\nfor PrepareForGarbageCollection. This will be used in the next patch.\n\nI also simplified things a little and always use GC_WAITING_NOW in\nFinishAnyCurrentCollection. Otherwise, it gets a little weird to\nhave nsCycleCollector_finishAnyCurrentCollection not actually\nfinish the current CC in some conditions after the next patch. It is only used\nin testing so I think that's fine.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342259\n", "files": ["xpcom/base/nsCycleCollectionParticipant.h", "xpcom/base/nsCycleCollector.cpp"], "git_node": "63f1218f4b7cdcc5e5471a85c6b161ede7dcbfbd", "git_parents": ["701ebb517db3d4b249a748b4851dfb6e236b1132"], "node": "d313121cfa92ac48e9ca061f776af0a60b8fc2ca", "parents": ["126df302c99781676f9f39d2707a69ca17f11fb6"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 8 - Allow reentrance in Collect during FreeSnowWhite.  a=pascalc\n\nIf the GC is trying to finish the CC, we need to advance the CC enough that\nthe graph is empty, even if we're in the middle of FreeSnowWhite. We'll still\ntry to finish the CC if we can, for instance if it was in CleanupPhase when\nwe GCed, because we'll collect things sooner if the CC is fully done before\nthe GC runs.\n\nThis patch weakens the reentrance guard, and doesn't set mActivelyCollecting\nto true until we're done with FreeSnowWhite. FreeSnowWhite itself also\nguards against mFreeingSnowWhite so we won't reenter there.\n\nAlso, move collectedAny closer to where it is used.\n\nThe SnowWhiteKiller::Visit() change is tricky. In the unbudgeted version of the\nSWK, snow white objects are removed from the purple buffer before any destructors\nare run. If a destructor of a snow white object runs JS, we can end up finishing\na CC while they are in this state. We need to ensure that the CC does not decide\nthese snow white objects need to be unlinked, so we want them to be treated as\nincremental roots. As they aren't in the purple buffer, we instead remove them\nfrom the CC graph (as though they had died) which will mark them as incremental\nroots. If the snow white objects are not yet in the graph, and get resurrected,\nthey will end up back in the purple buffer, and thus will be treated as\nincremental roots. The behavior does not change for a budgeted SWK, which was\nalready removing objects from the graph immediately before destroying them.\n\nI added a comment about FinalizeDeferredThings reentrance causing\nEndCycleCollectionCallback weirdness. This is pre-existing.\n\nWhile I'm touching this code anyways, I adjusted the !IsIncrementalGCInProgress() assertion\nin Collect(). This could happen if you are using test functions to trigger a budgeted CC\nslice that starts an IGC inside from the unlink method, hits the budget before\nCleanupAfterCollection can run, then runs another slice via the testing function.\nBeginCollection will finish the IGC before looking at JS and CleanupPhase doesn't look at\nit, so this is fine. This is pre-existing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342260\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "d07be3bf1682d481943455130396c7f2b4c20bc1", "git_parents": ["63f1218f4b7cdcc5e5471a85c6b161ede7dcbfbd"], "node": "17bf9273af02d0858927c3738df567bd68b1ee08", "parents": ["d313121cfa92ac48e9ca061f776af0a60b8fc2ca"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 9 - Fix potential ForgetSkippable reentrance issues.  a=pascalc\n\nThis patch fixes a few pre-existing issues with ForgetSkippable.\n\nIn theory, PrepareForForgetSkippable might be able to start a new CC in\nForgetSkippable, so to be safe, recheck that we're idle after we call it.\n\nForgetSkippable should set mFreeingSnowWhite.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342261\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "88b655cbf1e873dd0bad372d1bfd17dedfecd6c4", "git_parents": ["d07be3bf1682d481943455130396c7f2b4c20bc1"], "node": "15660df52c437b91dbe9e18f1549a8f21bcc9258", "parents": ["17bf9273af02d0858927c3738df567bd68b1ee08"], "tags": []}], "date": 1794604372, "git_changesets": ["6746d3bb9da016cf2fbbb87227b43167ce4e9649", "e5b818ffdfcee112e1a3dcc2a30185a7d2f05a58", "7eed5920db470d2f035fa0bb581cf3980b0769e1", "8c179da90eabc1ad20567683ca068e4cc5446cca", "51234719cd4abe0ebc0d555f126034d59abc9bd5", "701ebb517db3d4b249a748b4851dfb6e236b1132", "63f1218f4b7cdcc5e5471a85c6b161ede7dcbfbd", "d07be3bf1682d481943455130396c7f2b4c20bc1", "88b655cbf1e873dd0bad372d1bfd17dedfecd6c4"], "user": "pchevrel@mozilla.com"}, "1823": {"changesets": [{"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088286 - disable CRLite/cert_storage xpcshell tests broken by NSS 3.90.7 upgrade.  a=diannaS,pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339351\n", "files": ["security/manager/ssl/tests/unit/xpcshell.ini"], "git_node": "f22c719394482647f4654bb633cf7314b227abc9", "git_parents": ["88b655cbf1e873dd0bad372d1bfd17dedfecd6c4"], "node": "9bf235d4a1446ff9488edcf9029e0d11b7a6603f", "parents": ["15660df52c437b91dbe9e18f1549a8f21bcc9258"], "tags": []}], "date": 1794655681, "git_changesets": ["f22c719394482647f4654bb633cf7314b227abc9"], "user": "pchevrel@mozilla.com"}, "1824": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2058620.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339977\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340843\n", "files": ["dom/file/MutableBlobStorage.cpp", "dom/xhr/XMLHttpRequestMainThread.cpp"], "git_node": "09a79ad5e08a50122a54a4c29af138f283196557", "git_parents": ["f22c719394482647f4654bb633cf7314b227abc9"], "node": "d66a6a246df77296880e9f28d23cdb11d659e044", "parents": ["9bf235d4a1446ff9488edcf9029e0d11b7a6603f"], "tags": []}], "date": 1794666881, "git_changesets": ["09a79ad5e08a50122a54a4c29af138f283196557"], "user": "pchevrel@mozilla.com"}, "1825": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079254 -  Always dispatch cache file doom at OPEN_PRIORITY,  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331646\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339869\n", "files": ["netwerk/cache2/CacheFileIOManager.cpp"], "git_node": "adbd3c2fc1915325434131046520917655e9c5db", "git_parents": ["09a79ad5e08a50122a54a4c29af138f283196557"], "node": "6a6e5ca96f7b0742bc6bf9d146565b051af5ab6e", "parents": ["d66a6a246df77296880e9f28d23cdb11d659e044"], "tags": []}], "date": 1794666920, "git_changesets": ["adbd3c2fc1915325434131046520917655e9c5db"], "user": "pchevrel@mozilla.com"}, "1826": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082140 - Check the ref count inside of the lock.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334181\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339239\n", "files": ["gfx/wr/wr_glyph_rasterizer/src/platform/unix/font.rs"], "git_node": "9d8499420593436f6a5ef8bab5bee13e15470de8", "git_parents": ["adbd3c2fc1915325434131046520917655e9c5db"], "node": "66276369f28244445e4e562636cd3f8dd56e70be", "parents": ["6a6e5ca96f7b0742bc6bf9d146565b051af5ab6e"], "tags": []}], "date": 1794666959, "git_changesets": ["9d8499420593436f6a5ef8bab5bee13e15470de8"], "user": "pchevrel@mozilla.com"}, "1827": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079922;  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338171\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341106\n", "files": ["dom/base/Document.cpp"], "git_node": "2cceaef49cda2c94dbb2e82ffcab209732b74e74", "git_parents": ["9d8499420593436f6a5ef8bab5bee13e15470de8"], "node": "ba6a2e36e394a9571b8aaeaf1465671423ff95f2", "parents": ["66276369f28244445e4e562636cd3f8dd56e70be"], "tags": []}], "date": 1794666981, "git_changesets": ["2cceaef49cda2c94dbb2e82ffcab209732b74e74"], "user": "pchevrel@mozilla.com"}, "1828": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080133 - Fail program linking for transform feedback varyings with unexpected types.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335714\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340002\n", "files": ["dom/canvas/WebGLProgram.cpp"], "git_node": "a28aabaf7f31b2d038877cdcb26173c65d6dae7c", "git_parents": ["2cceaef49cda2c94dbb2e82ffcab209732b74e74"], "node": "5517f481b33ade3f86173a97e7dd0f866d78af21", "parents": ["ba6a2e36e394a9571b8aaeaf1465671423ff95f2"], "tags": []}], "date": 1794667029, "git_changesets": ["a28aabaf7f31b2d038877cdcb26173c65d6dae7c"], "user": "pchevrel@mozilla.com"}, "1829": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088537 - Bind child-written alt-data to the writer's remote type and require a fully loaded origin.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340412\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340974\n", "files": ["netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "95a5436c27aa3c46fef199d6de0f2610869618bf", "git_parents": ["a28aabaf7f31b2d038877cdcb26173c65d6dae7c"], "node": "250058e60642e9304fcb1a1a6ab16c9969ce5e53", "parents": ["5517f481b33ade3f86173a97e7dd0f866d78af21"], "tags": []}], "date": 1794667068, "git_changesets": ["95a5436c27aa3c46fef199d6de0f2610869618bf"], "user": "pchevrel@mozilla.com"}, "1830": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090902.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340885\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341037\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "cdef74b9b70d7a68a75e7cac42825c3a4de7589b", "git_parents": ["95a5436c27aa3c46fef199d6de0f2610869618bf"], "node": "04d46187515f96bd76a674b0d2ade9d42bfc68ea", "parents": ["250058e60642e9304fcb1a1a6ab16c9969ce5e53"], "tags": []}], "date": 1794667137, "git_changesets": ["cdef74b9b70d7a68a75e7cac42825c3a4de7589b"], "user": "pchevrel@mozilla.com"}, "1831": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079465 - Keep an invalid trailer at the end of cache entry files while their data is being written.  a=pascalc DONTBUILD\n\nData writes and truncations put an 8-byte trailer, whose offset word is past\nthe end of any file, after the end of the file; the metadata write truncates it\naway.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340568\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340954\n", "files": ["netwerk/cache2/CacheFileIOManager.cpp", "netwerk/cache2/CacheFileIOManager.h"], "git_node": "b4ea8d3a83a1c506df87f09186efbb568dbd1270", "git_parents": ["cdef74b9b70d7a68a75e7cac42825c3a4de7589b"], "node": "69465038e8cd9bb3f742f28da656baa2455a7740", "parents": ["04d46187515f96bd76a674b0d2ade9d42bfc68ea"], "tags": []}], "date": 1794667194, "git_changesets": ["b4ea8d3a83a1c506df87f09186efbb568dbd1270"], "user": "pchevrel@mozilla.com"}, "1832": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090147 - Clean up after failure within BuildTextRunsScanner::FlushFrames.  a=pascalc DONTBUILD\n\nAlso adds some checks in MergeCharactersInTextRun for extra robustness.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340999\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341437\n", "files": ["layout/generic/nsTextFrame.cpp", "layout/generic/nsTextRunTransformations.cpp"], "git_node": "a8a9294ea20105d5207869404f06d2e02f426bb3", "git_parents": ["b4ea8d3a83a1c506df87f09186efbb568dbd1270"], "node": "c4afa12c55fd2b68285864e156e85cd5b7cfc067", "parents": ["69465038e8cd9bb3f742f28da656baa2455a7740"], "tags": []}], "date": 1794667232, "git_changesets": ["a8a9294ea20105d5207869404f06d2e02f426bb3"], "user": "pchevrel@mozilla.com"}, "1833": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2088670 - Clear node weak references when unlinking.  a=pascalc DONTBUILD\n\nIt turns out we have a third kind of weak reference.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340924\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341352\n", "files": ["dom/base/nsINode.cpp", "dom/base/nsINode.h"], "git_node": "d872458589229edc9fa84111a9ec8ce5828a6157", "git_parents": ["a8a9294ea20105d5207869404f06d2e02f426bb3"], "node": "8f64982a7dd88bbe5cf19e36fa3a43375618d246", "parents": ["c4afa12c55fd2b68285864e156e85cd5b7cfc067"], "tags": []}], "date": 1794667270, "git_changesets": ["d872458589229edc9fa84111a9ec8ce5828a6157"], "user": "pchevrel@mozilla.com"}, "1834": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090118 - Add script runner for ExternalResourceMap::PendingLoad::StartLoad  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340912\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341309\n", "files": ["dom/base/Document.cpp"], "git_node": "ecadd973c5e16cf051211de9e65feb295f0156f6", "git_parents": ["d872458589229edc9fa84111a9ec8ce5828a6157"], "node": "ba82075735d7ab0458ad8fa6390167c8566dec2d", "parents": ["8f64982a7dd88bbe5cf19e36fa3a43375618d246"], "tags": []}], "date": 1794667309, "git_changesets": ["ecadd973c5e16cf051211de9e65feb295f0156f6"], "user": "pchevrel@mozilla.com"}, "1835": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset ecadd973c5e1 (Bug 2090118) for causing build bustages in Document.cpp. a=backout\n", "files": ["dom/base/Document.cpp"], "git_node": "d073db92563c020fd49d17dc479297f5ff3d8d28", "git_parents": ["ecadd973c5e16cf051211de9e65feb295f0156f6"], "node": "7e99006af0f116ba35bdfab4008ad026f4ea66da", "parents": ["ba82075735d7ab0458ad8fa6390167c8566dec2d"], "tags": []}], "date": 1794670350, "git_changesets": ["d073db92563c020fd49d17dc479297f5ff3d8d28"], "user": "pchevrel@mozilla.com"}, "1836": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074205 - Avoid building WR bridges twice.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333195\n\n(cherry picked from commit ae803b44587ee5edcad2302104ffcd6b2f31cda2)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342165\n", "files": ["gfx/layers/ipc/ContentCompositorBridgeParent.cpp"], "git_node": "fe6ce42af281a672f8c790387339e0ffce1e61e4", "git_parents": ["d073db92563c020fd49d17dc479297f5ff3d8d28"], "node": "d687e72d9952d40a07900fcc9b2c334365b4b2a4", "parents": ["7e99006af0f116ba35bdfab4008ad026f4ea66da"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074205 - Check that the pipeline is not in use when creating a WebRenderBridgeParent.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333197\n\n(cherry picked from commit 163245b932951df3104fa8fc9b723905fe01a239)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342166\n", "files": ["gfx/layers/ipc/ContentCompositorBridgeParent.cpp", "gfx/layers/wr/AsyncImagePipelineManager.h"], "git_node": "c1e2482a14650d068375abb2be8e4b089265f6a1", "git_parents": ["fe6ce42af281a672f8c790387339e0ffce1e61e4"], "node": "07cad38b1dccce22aeab91461d406859754bd29c", "parents": ["d687e72d9952d40a07900fcc9b2c334365b4b2a4"], "tags": []}], "date": 1794672036, "git_changesets": ["fe6ce42af281a672f8c790387339e0ffce1e61e4", "c1e2482a14650d068375abb2be8e4b089265f6a1"], "user": "pchevrel@mozilla.com"}, "1837": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2089704.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340297\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340609\n", "files": ["dom/webidl/StyleSheet.webidl", "layout/style/StyleSheet.h"], "git_node": "b5e26ca04ce759d519e618271d82138374ee7ff1", "git_parents": ["c1e2482a14650d068375abb2be8e4b089265f6a1"], "node": "03a29481ccc7d6d79822528ab07e20dbf02505cd", "parents": ["07cad38b1dccce22aeab91461d406859754bd29c"], "tags": []}], "date": 1794672076, "git_changesets": ["b5e26ca04ce759d519e618271d82138374ee7ff1"], "user": "pchevrel@mozilla.com"}, "1838": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076000 - Always handle video visibility notifications async.  a=pascalc DONTBUILD\n\nThe pause path was already async, let's do it consistently.\n\nmPaused check was already covered by the elegibility check.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339886\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340518\n", "files": ["dom/html/HTMLMediaElement.h", "dom/html/HTMLVideoElement.cpp", "dom/html/HTMLVideoElement.h"], "git_node": "71393ad7c8af27a3a49cf16724f5807657563f4d", "git_parents": ["b5e26ca04ce759d519e618271d82138374ee7ff1"], "node": "32428a273faac6dac4d81d6258e546889911c098", "parents": ["03a29481ccc7d6d79822528ab07e20dbf02505cd"], "tags": []}], "date": 1794672187, "git_changesets": ["71393ad7c8af27a3a49cf16724f5807657563f4d"], "user": "pchevrel@mozilla.com"}, "1839": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2089267 - Make `AutoDeleteRangesHandler::Run` handle error of `FallbackToDeleteRangesWithTransaction`  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340835\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341632\n", "files": ["editor/libeditor/HTMLEditorDeleteHandler.cpp"], "git_node": "c285dd024b52295340395afc7528dcbff579a974", "git_parents": ["71393ad7c8af27a3a49cf16724f5807657563f4d"], "node": "d967df1ce41d2ebad7bb20b33a8284088ad45f86", "parents": ["32428a273faac6dac4d81d6258e546889911c098"], "tags": []}], "date": 1794672224, "git_changesets": ["c285dd024b52295340395afc7528dcbff579a974"], "user": "pchevrel@mozilla.com"}, "1840": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2090289.  a=pascalc\n\nUsing the fix provided in the report.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341348\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341753\n", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xslt/xslt/txMozillaTextOutput.cpp"], "git_node": "862eb4a12c7b0774e3175006e09b70805c19dcbb", "git_parents": ["c285dd024b52295340395afc7528dcbff579a974"], "node": "fb4565bc2e3a646ae0039323f4c7b79238433c9c", "parents": ["d967df1ce41d2ebad7bb20b33a8284088ad45f86"], "tags": []}], "date": 1794672263, "git_changesets": ["862eb4a12c7b0774e3175006e09b70805c19dcbb"], "user": "pchevrel@mozilla.com"}, "1841": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2084649 - Track the embedding frameloader in BrowserParent.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340308\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340969\n", "files": ["docshell/shistory/nsSHistory.cpp", "dom/base/nsFrameLoader.cpp", "dom/base/nsFrameLoader.h", "dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "3a7cc692ddb2e673f52c9b707f661072faafcbc2", "git_parents": ["862eb4a12c7b0774e3175006e09b70805c19dcbb"], "node": "6891edf28c38853728b289e43fd03874a8e8f1f6", "parents": ["fb4565bc2e3a646ae0039323f4c7b79238433c9c"], "tags": []}], "date": 1794678058, "git_changesets": ["3a7cc692ddb2e673f52c9b707f661072faafcbc2"], "user": "pchevrel@mozilla.com"}, "1842": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2089775.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341345\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341766\n", "files": ["dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": "a9682730fc49b006b3d48f0e6ecab3871fc0f051", "git_parents": ["3a7cc692ddb2e673f52c9b707f661072faafcbc2"], "node": "e2ae76eb2be4628bc035f4735463aa52f89d41ab", "parents": ["6891edf28c38853728b289e43fd03874a8e8f1f6"], "tags": []}], "date": 1794678095, "git_changesets": ["a9682730fc49b006b3d48f0e6ecab3871fc0f051"], "user": "pchevrel@mozilla.com"}, "1843": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2088854.  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342436\n", "files": ["gfx/skia/skia/src/core/SkAnalyticEdge.h", "gfx/skia/skia/src/core/SkEdgeBuilder.cpp", "gfx/skia/skia/src/core/SkEdgeBuilder.h", "gfx/skia/skia/src/core/SkScan_AAAPath.cpp"], "git_node": "d4a1287288dafc19b639cc9205fb28f88a26fbf6", "git_parents": ["a9682730fc49b006b3d48f0e6ecab3871fc0f051"], "node": "1b7bac41a3e1cdf6d360e0aa5a276f5d5fc1e25c", "parents": ["e2ae76eb2be4628bc035f4735463aa52f89d41ab"], "tags": []}], "date": 1794678157, "git_changesets": ["d4a1287288dafc19b639cc9205fb28f88a26fbf6"], "user": "pchevrel@mozilla.com"}, "1844": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073689 - Register VideoBridgeParent after taking a reference to it.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335662\n\n(cherry picked from commit 104f40b3fc54a83c0ba6d2105c2f052eafffef50)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342512\n", "files": ["gfx/layers/ipc/VideoBridgeParent.cpp", "gfx/layers/ipc/VideoBridgeParent.h"], "git_node": "48ab991966b204902ca645821726b6fe0c22df28", "git_parents": ["d4a1287288dafc19b639cc9205fb28f88a26fbf6"], "node": "8bbe1d304b76737f38c4563f720452cbcd038ba3", "parents": ["1b7bac41a3e1cdf6d360e0aa5a276f5d5fc1e25c"], "tags": []}], "date": 1794678229, "git_changesets": ["48ab991966b204902ca645821726b6fe0c22df28"], "user": "pchevrel@mozilla.com"}, "1845": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090172: Hold a strong reference to the main-thread XHR across worker abort.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340567\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342191\n", "files": ["dom/xhr/XMLHttpRequestWorker.cpp"], "git_node": "82685e321e5d06acc4589cbf5b917aca0d1f426c", "git_parents": ["48ab991966b204902ca645821726b6fe0c22df28"], "node": "a11c2b204a16ff9f6a9e2e75405194297bd3571c", "parents": ["8bbe1d304b76737f38c4563f720452cbcd038ba3"], "tags": []}], "date": 1794678267, "git_changesets": ["82685e321e5d06acc4589cbf5b917aca0d1f426c"], "user": "pchevrel@mozilla.com"}, "1846": {"changesets": [{"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2059024 - Upgrade the consumer count assertion in SharedSurfacesParent::AddTrackingLocked to MOZ_RELEASE_ASSERT.  a=pascalc DONTBUILD\n\nDifferential Revision https://phabricator.services.mozilla.com/D340037\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342602\n", "files": ["gfx/layers/ipc/SharedSurfacesParent.cpp"], "git_node": "18d4fcc062314d40c58a88c6f230fc97d8177310", "git_parents": ["82685e321e5d06acc4589cbf5b917aca0d1f426c"], "node": "233bcc8ce7ec3afff60475d0e5f579e55073e5d7", "parents": ["a11c2b204a16ff9f6a9e2e75405194297bd3571c"], "tags": []}], "date": 1794680389, "git_changesets": ["18d4fcc062314d40c58a88c6f230fc97d8177310"], "user": "pchevrel@mozilla.com"}, "1847": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089774 - Use a non-movable load for UnsafeGetReservedSlot.  a=pascalc DONTBUILD\n\nThis adds `LoadReservedFixedSlotResult` and uses it instead of `LoadFixedSlotResult`\nfor the `UnsafeGetReservedSlot` intrinsic.\n\nAlso renames `LoadFixedSlotTypedResult` to `LoadReservedFixedSlotTypedResult`\nfor consistency.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341262\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342554\n", "files": ["js/src/jit/BaselineCacheIRCompiler.cpp", "js/src/jit/CacheIR.cpp", "js/src/jit/CacheIROps.yaml", "js/src/jit/IonCacheIRCompiler.cpp", "js/src/jit/WarpCacheIRTranspiler.cpp"], "git_node": "a97c3ef5f3aaf7c54da392fb287c999b1ef98384", "git_parents": ["18d4fcc062314d40c58a88c6f230fc97d8177310"], "node": "3d66d0412753a1cf09d84a2770700c93bb18cadd", "parents": ["233bcc8ce7ec3afff60475d0e5f579e55073e5d7"], "tags": []}], "date": 1794680676, "git_changesets": ["a97c3ef5f3aaf7c54da392fb287c999b1ef98384"], "user": "pchevrel@mozilla.com"}, "1848": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091136 - Always merge OSR block parameters with entry block parameters in BacktrackingAllocator.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341297\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342555\n", "files": ["js/src/jit/BacktrackingAllocator.cpp", "js/src/jit/BacktrackingAllocator.h"], "git_node": "38d557b35e14d122c2c5a274c17d2f1f1b815964", "git_parents": ["a97c3ef5f3aaf7c54da392fb287c999b1ef98384"], "node": "0636935af0b4e0c0bf18d2aa1515c153e6ca6839", "parents": ["3d66d0412753a1cf09d84a2770700c93bb18cadd"], "tags": []}], "date": 1794680732, "git_changesets": ["38d557b35e14d122c2c5a274c17d2f1f1b815964"], "user": "pchevrel@mozilla.com"}, "1849": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2089819 - Use a worst-case bound and fallible allocation when calling getIntercepts.  a=pascalc DONTBUILD\n\nIn principle this should be more performant, as it means we only make one call\nto getIntercepts, which is where most work happens. The array allocation will\ninitially be oversized, and subsequently truncated to fit the actual number of\nreturned intercepts, but by using fallible allocation we ensure that in an OOM\nsituation it will degrade gracefully (we just bail out of skip-ink processing)\nrather than crashing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340905\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342627\n", "files": ["layout/painting/nsCSSRendering.cpp"], "git_node": "6e97d95b24ae763335f2a15589c242c8ad9a80a6", "git_parents": ["38d557b35e14d122c2c5a274c17d2f1f1b815964"], "node": "0fa343bfbdb919b436cdc125091ebe3fcf4fdc01", "parents": ["0636935af0b4e0c0bf18d2aa1515c153e6ca6839"], "tags": []}], "date": 1794680772, "git_changesets": ["6e97d95b24ae763335f2a15589c242c8ad9a80a6"], "user": "pchevrel@mozilla.com"}, "1850": {"changesets": [{"author": "Jonathan Kew \u003cjfkthame@gmail.com\u003e", "branch": "default", "desc": "Bug 2090182 - Check for first-letter frame in overflow list.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342170\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342623\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "69daa6971f74a0bcf00efa3c6814f11033e6341d", "git_parents": ["6e97d95b24ae763335f2a15589c242c8ad9a80a6"], "node": "ba7edca99cb900f3e49bce4e974580540c725efc", "parents": ["0fa343bfbdb919b436cdc125091ebe3fcf4fdc01"], "tags": []}], "date": 1794680800, "git_changesets": ["69daa6971f74a0bcf00efa3c6814f11033e6341d"], "user": "pchevrel@mozilla.com"}, "1851": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2089592 - Deal with replicated frames in CharacterDataChanged.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341301\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342593\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h"], "git_node": "38682f3cc5a0d93d418f93e04b423278264ac8e2", "git_parents": ["69daa6971f74a0bcf00efa3c6814f11033e6341d"], "node": "973f40bdeb776924fd59ee4b5eace0ac913439ca", "parents": ["ba7edca99cb900f3e49bce4e974580540c725efc"], "tags": []}], "date": 1794681232, "git_changesets": ["38682f3cc5a0d93d418f93e04b423278264ac8e2"], "user": "pchevrel@mozilla.com"}, "1852": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 1 - Inline GraphWalker and ScanBlackVisitor into FloodBlackNode.  a=pascalc\n\nThey are only used in a single place, so inline it all to make it\neasier to understand.\n\nChange the aPi check in CheckedPush to be a release assert, for simplicity.\n\nWalkFromRoots is not used so it is removed.\n\nI marked FloodBlackNode MOZ_NEVER_INLINE to match GraphWalker::Walk,\nGraphWalker::DoWalk and ScanBlackVisitor::VisitNode.\n\nThis patch should not change the behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338469\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342825\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "b828d3f696b95eb57a0216bbe476867e7d02ed8e", "git_parents": ["38682f3cc5a0d93d418f93e04b423278264ac8e2"], "node": "4adb6ce91b7c6703f152985812fb705a14d877e3", "parents": ["973f40bdeb776924fd59ee4b5eace0ac913439ca"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 2 - Use infallible allocation for Push in FloodBlackNode.  a=pascalc\n\nIf a cycle collection can't fully run due to running low on memory, it won't be\nable to free much of anything, so the memory problems will only get worse. If\nwe crash, then at least this issue will be visible in crash stats, as opposed\nto performance invisibly becoming terrible.\n\nThis requires removing a lot of failure propagation code.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338470\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342826\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "fda0affc15cf5fc0c69e716d566cbbec3ebdbba9", "git_parents": ["b828d3f696b95eb57a0216bbe476867e7d02ed8e"], "node": "e481f533afd06744d16a670828a6e381787f09c4", "parents": ["4adb6ce91b7c6703f152985812fb705a14d877e3"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 3 - Mark nodes black when they are pushed in FloodBlackNode.  a=pascalc\n\nPreviously, every child was pushed onto the queue, and filtered out when it was\npopped if it was already black or had not been traversed. This meant that the\nqueue could grow to the number of edges rather than the number of nodes. Doing\nthe check and marking the node black when it is pushed means each node is\npushed at most once. The resulting coloring and white node count are the same.\n\nRunning browser_aiwindow_smartbar_chat_active_navigate.js locally, this reduced\nthe maximum size of the queue from around 5600 nodes to 2800.\n\nThis probably makes locality worse, because we now look at a node when we push\nit, but I think that's a reasonable tradeoff for cutting memory usage in half.\n(Testing described in the last patch shows that the entire patch set improves\nScanBlockNodes performance over all.)\n\nThis is combined with the patches to make memory allocation infallible in the\nhope that it will reduce the rate of OOM crashes.\n\nRemove a WasTraversed check in ScanBlackNodes that is now redundant.\nThere's a check in PurpleScanBlackVisitor::Visit that is also redundant,\nbut that case is likely more common, so let's leave it to avoid the call\noverhead.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338471\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342827\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "17dbfe4e77d14a46a92fa6c26cd40f62e70643d6", "git_parents": ["fda0affc15cf5fc0c69e716d566cbbec3ebdbba9"], "node": "9026be0c20abacf731df23ce564a0b9a0ddd2db2", "parents": ["e481f533afd06744d16a670828a6e381787f09c4"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2079172, part 4 - Switch from nsDeque to Queue in FloodBlackNodes.  a=pascalc\n\nnsDeque uses a single block of memory, while Queue uses a segmented vector, so\nhopefully this will cause less OOMs. 1024 pointers seems big enough that\niterator overhead shouldn't be a big deal.\n\nWe already use infallible allocation with EdgeBlock, which each contain\n16 * 1024 pointers. Over the last week, those were about 7.6% of all\nOOM | small crashes.\n\nUnlike nsDeque, Queue has no inline storage, so creating one in each\nFloodBlackNode call would mean a heap allocation of a page for every call, which\ncan happen once per root. Instead, create the queue in ScanRoots and pass it\ndown. A drained Queue keeps its head page, so it is only allocated once. It\nwould be nice if it kept all of its empty pages but oh well.\n\nWhile running tests with big CCs, the full patch stack reduced the time spent\nin ScanBlackNodes() by 22% which sounds great but CC time is mostly dominated\nby building the graph so that's not much. The biggest improvement seen\nin a single CC was like 0.3ms.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338472\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342828\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "3652503fd6f143b16b8531c088dc3c7150c00522", "git_parents": ["17dbfe4e77d14a46a92fa6c26cd40f62e70643d6"], "node": "bdf649adddde69691afc1247e291bec5379313d0", "parents": ["9026be0c20abacf731df23ce564a0b9a0ddd2db2"], "tags": []}], "date": 1794749489, "git_changesets": ["b828d3f696b95eb57a0216bbe476867e7d02ed8e", "fda0affc15cf5fc0c69e716d566cbbec3ebdbba9", "17dbfe4e77d14a46a92fa6c26cd40f62e70643d6", "3652503fd6f143b16b8531c088dc3c7150c00522"], "user": "pchevrel@mozilla.com"}, "1853": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343046\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/blocklists/gfx.json", "services/settings/dumps/blocklists/plugins.json", "services/settings/dumps/main/anti-tracking-url-decoration.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/devtools-devices.json", "services/settings/dumps/main/hijack-blocklists.json", "services/settings/dumps/main/language-dictionaries.json", "services/settings/dumps/main/password-recipes.json", "services/settings/dumps/main/password-rules.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/main/search-default-override-allowlist.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/sites-classification.json", "services/settings/dumps/main/top-sites.json", "services/settings/dumps/main/url-classifier-skip-urls.json", "services/settings/dumps/main/websites-with-shared-credential-backends.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "657d9595b16d04bb21bf579a01f6cb59831970ca", "git_parents": ["3652503fd6f143b16b8531c088dc3c7150c00522"], "node": "095b4ad39089819a5c1980b65924e8e9e9acd9c4", "parents": ["bdf649adddde69691afc1247e291bec5379313d0"], "tags": []}], "date": 1794817013, "git_changesets": ["657d9595b16d04bb21bf579a01f6cb59831970ca"], "user": "pchevrel@mozilla.com"}, "1854": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080757 - Also send opener window id when creating browsing context.  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343063\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "dom/ipc/ContentParent.cpp", "dom/ipc/PContent.ipdl"], "git_node": "aa2b08bf269ed9102311e8d12698f5656d5a5971", "git_parents": ["657d9595b16d04bb21bf579a01f6cb59831970ca"], "node": "0d80e27f2d360794508e4d27ac2e212a7f264aac", "parents": ["095b4ad39089819a5c1980b65924e8e9e9acd9c4"], "tags": []}], "date": 1794904783, "git_changesets": ["aa2b08bf269ed9102311e8d12698f5656d5a5971"], "user": "pchevrel@mozilla.com"}, "1855": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090118 - Add script runner for ExternalResourceMap::PendingLoad::StartLoad  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340912\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341309\n", "files": ["dom/base/Document.cpp"], "git_node": "2c4f1b03950d5033f17e15f4c959cf7bbce1320b", "git_parents": ["aa2b08bf269ed9102311e8d12698f5656d5a5971"], "node": "c28013d1adb55a5146ca4d0885dec6479bece583", "parents": ["0d80e27f2d360794508e4d27ac2e212a7f264aac"], "tags": []}], "date": 1794906025, "git_changesets": ["2c4f1b03950d5033f17e15f4c959cf7bbce1320b"], "user": "pchevrel@mozilla.com"}, "1856": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090897 - Reset fullscreen state properly;  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341916\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342924\n", "files": ["dom/base/Document.cpp"], "git_node": "91a70a326dec3ebaf2257669e8d8223216e00308", "git_parents": ["2c4f1b03950d5033f17e15f4c959cf7bbce1320b"], "node": "18661583284d04581c2eb6b46be9e96ac3f53666", "parents": ["c28013d1adb55a5146ca4d0885dec6479bece583"], "tags": []}], "date": 1794912228, "git_changesets": ["91a70a326dec3ebaf2257669e8d8223216e00308"], "user": "pchevrel@mozilla.com"}, "1857": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091345 - Don't cache initial shapes that can be replaced by SharedShape::insertInitialShape.  a=pascalc DONTBUILD\n\nFor some classes we replace the initial empty-shape entry in the table with the\nshape that has builtin properties added to it. Future lookups then get the final\nshape instead of the empty shape.\n\nThis complicates the `ShapeCachePtr` `ShapeWithProto` optimization because it's\nbased on matching the shape in the table. The easiest fix is to not use that\noptimization for those replaceable empty shapes. This patch adds a shape flag\nto make that cheap.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342641\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343405\n", "files": ["js/src/vm/Shape.cpp", "js/src/vm/Shape.h"], "git_node": "0f64ccc0a38162eca2cd84c250c55b8ac21932cc", "git_parents": ["91a70a326dec3ebaf2257669e8d8223216e00308"], "node": "2232c0d64b3381a2848e462c27b0b057d7242458", "parents": ["18661583284d04581c2eb6b46be9e96ac3f53666"], "tags": []}], "date": 1794912980, "git_changesets": ["0f64ccc0a38162eca2cd84c250c55b8ac21932cc"], "user": "pchevrel@mozilla.com"}, "1858": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090900 - Stop setting up a document viewer once another one has replaced the old one.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342108\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343202\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "9dfd959604a6a692e35da7c3706768e4dc7a59de", "git_parents": ["0f64ccc0a38162eca2cd84c250c55b8ac21932cc"], "node": "0defc1d191ff7ef876e3c92d1ca3e86f326fbff3", "parents": ["2232c0d64b3381a2848e462c27b0b057d7242458"], "tags": []}], "date": 1794916402, "git_changesets": ["9dfd959604a6a692e35da7c3706768e4dc7a59de"], "user": "pchevrel@mozilla.com"}, "1859": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2089680.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342536\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342840\n", "files": ["image/VectorImage.cpp"], "git_node": "7be3ef21dbce0e148af6df7d6e705fac9b39f099", "git_parents": ["9dfd959604a6a692e35da7c3706768e4dc7a59de"], "node": "50341e4516f951a28aab9e28421ceae4c5a89519", "parents": ["0defc1d191ff7ef876e3c92d1ca3e86f326fbff3"], "tags": []}], "date": 1794919724, "git_changesets": ["7be3ef21dbce0e148af6df7d6e705fac9b39f099"], "user": "pchevrel@mozilla.com"}, "1860": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086293 - Limit the size of the HTTP/2 output queue, r=necko-reviewers,valentin a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343455\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Session.cpp", "netwerk/protocol/http/Http2Session.h", "netwerk/protocol/http/Http2StreamBase.cpp", "netwerk/protocol/http/Http2StreamBase.h", "netwerk/protocol/http/nsHttp.cpp"], "git_node": "d64056aa4fdb62f5410a31d0736b56e32e1eca08", "git_parents": ["7be3ef21dbce0e148af6df7d6e705fac9b39f099"], "node": "ab202f54385dc01b797fca039b18044ee95895c4", "parents": ["50341e4516f951a28aab9e28421ceae4c5a89519"], "tags": []}], "date": 1794919765, "git_changesets": ["d64056aa4fdb62f5410a31d0736b56e32e1eca08"], "user": "pchevrel@mozilla.com"}, "1861": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090113 - Only add nsViewSourceChannel to the load group once the inner channel has opened.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341909\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343503\n", "files": ["netwerk/protocol/viewsource/nsViewSourceChannel.cpp"], "git_node": "8d8f94d474b0393c060c197c3ee05aaf9e8e60c1", "git_parents": ["d64056aa4fdb62f5410a31d0736b56e32e1eca08"], "node": "cb226c78c2beca5d0e8a10eefca2b9cead94f818", "parents": ["ab202f54385dc01b797fca039b18044ee95895c4"], "tags": []}], "date": 1794920802, "git_changesets": ["8d8f94d474b0393c060c197c3ee05aaf9e8e60c1"], "user": "pchevrel@mozilla.com"}, "1862": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1821458 - Initialize RAPL members, .  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338145\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338229\n", "files": ["tools/profiler/core/PowerCounters-mac-amd64.cpp"], "git_node": "0f0447236109ec2369c4d31f1ddb0cd5ba8c753d", "git_parents": ["8d8f94d474b0393c060c197c3ee05aaf9e8e60c1"], "node": "5ea92e4aef8857459cc7716c015a86bdd8de0516", "parents": ["cb226c78c2beca5d0e8a10eefca2b9cead94f818"], "tags": []}], "date": 1794924551, "git_changesets": ["0f0447236109ec2369c4d31f1ddb0cd5ba8c753d"], "user": "pchevrel@mozilla.com"}, "1863": {"changesets": [{"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2091968 - refactor(thebes): use `GetAdjustedSpacingArray` in `gfxTextRun::GetAdvanceWidth`  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342242\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343584\n", "files": ["gfx/thebes/gfxTextRun.cpp"], "git_node": "a2bc42566203b10cb53c3a29dbb2992a29ffa077", "git_parents": ["0f0447236109ec2369c4d31f1ddb0cd5ba8c753d"], "node": "01ec8f296b3caa9381b9559ba46a4885de550f7c", "parents": ["5ea92e4aef8857459cc7716c015a86bdd8de0516"], "tags": []}], "date": 1794932545, "git_changesets": ["a2bc42566203b10cb53c3a29dbb2992a29ffa077"], "user": "pchevrel@mozilla.com"}, "1864": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2068455 - Caption should only be promoted to first when it is the DOM table's caption.  a=pascalc DONTBUILD\n\nAlso add test to make sure aria-owns does the right thing when including\na caption.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338122\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343593\n", "files": ["accessible/html/HTMLTableAccessible.cpp"], "git_node": "be7ae433f0e1e8bac196d6f1b0f992de32b9b00e", "git_parents": ["a2bc42566203b10cb53c3a29dbb2992a29ffa077"], "node": "2d719724b3524f82a3bb3012465a0d981e7b5108", "parents": ["01ec8f296b3caa9381b9559ba46a4885de550f7c"], "tags": []}], "date": 1794941187, "git_changesets": ["be7ae433f0e1e8bac196d6f1b0f992de32b9b00e"], "user": "pchevrel@mozilla.com"}, "1865": {"changesets": [{"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2090893 - fix(canvas): `OffscreenCanvasDisplayHelper::InvalidateElement`: make `canvasElement` a `RefPtr`  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343562\n", "files": ["dom/canvas/OffscreenCanvasDisplayHelper.cpp"], "git_node": "7db7c43b34897f991b17c26656e34ad49928a322", "git_parents": ["be7ae433f0e1e8bac196d6f1b0f992de32b9b00e"], "node": "11dda0a264cc82b85f5d5e40db92d20f9b8b8216", "parents": ["2d719724b3524f82a3bb3012465a0d981e7b5108"], "tags": []}], "date": 1794941244, "git_changesets": ["7db7c43b34897f991b17c26656e34ad49928a322"], "user": "pchevrel@mozilla.com"}, "1866": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082192 - Extract response body streams on the worker thread before the Worker Launcher handoff.  a=pascalc DONTBUILD\n\nFetchEventOp::ResolvedCallback now takes the body and alternativeBody\nstreams off the InternalResponse itself, rather than leaving that to\nGetIPCSynthesizeResponseArgs on the Worker Launcher thread.\nSynthesizeResponseArgs carries the streams independently of the\nInternalResponse, and SerializeChildToParentInternalResponseBody is\nnow unused and removed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335667\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343575\n", "files": ["dom/fetch/InternalResponse.cpp", "dom/fetch/InternalResponse.h", "dom/serviceworkers/FetchEventOpProxyChild.cpp", "dom/serviceworkers/ServiceWorkerOp.cpp", "dom/serviceworkers/ServiceWorkerOpPromise.h"], "git_node": "1f36991ece4c05f59e9921e3579b27206ce686c6", "git_parents": ["7db7c43b34897f991b17c26656e34ad49928a322"], "node": "764629e4146ef446748a9047a35114f4cb69fdd6", "parents": ["11dda0a264cc82b85f5d5e40db92d20f9b8b8216"], "tags": []}], "date": 1794941299, "git_changesets": ["1f36991ece4c05f59e9921e3579b27206ce686c6"], "user": "pchevrel@mozilla.com"}, "1867": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2088658.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341305\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343550\n", "files": ["layout/base/nsCSSFrameConstructor.cpp"], "git_node": "47d10f56bb9bf69b6378519565b57d62565b115b", "git_parents": ["1f36991ece4c05f59e9921e3579b27206ce686c6"], "node": "220e416288cf99375f47ed595fafa7fbb4166e52", "parents": ["764629e4146ef446748a9047a35114f4cb69fdd6"], "tags": ["FIREFOX_115_46_0esr_BUILD1", "FIREFOX_115_46_0esr_RELEASE"]}], "date": 1794942013, "git_changesets": ["47d10f56bb9bf69b6378519565b57d62565b115b"], "user": "pchevrel@mozilla.com"}}
}";