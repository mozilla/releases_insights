ents": ["66a4d5ccaef69b9ef509b9e6b457f4756f2ee366"], "node": "5bf22f0137a606dd9e420bc21daae681d0a327b6", "parents": ["07da6c6c016add6f8270a4ac0e53320df73b1b1c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER"], "git_node": "1a6492b02afa2e40602509321428753bd51fb1f8", "git_parents": ["96da0b6fd024a0fef958aa4a6d56c98578e2a05d"], "node": "00b9f5288e2dcdad57b25bf434b0c0c1b77b91f2", "parents": ["5bf22f0137a606dd9e420bc21daae681d0a327b6"], "tags": []}], "date": 1793880590, "git_changesets": ["96da0b6fd024a0fef958aa4a6d56c98578e2a05d", "1a6492b02afa2e40602509321428753bd51fb1f8"], "user": "ffxbld@lando.moz.tools"}, "1807": {"changesets": [{"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065520 - Build an aarch64 version of gn for Apple Silicon machines (Cherry-pick Bug 2049854) r=mjf a=pascalc DONTBUILD\n\nWith upcoming macOS 27 dropping Rosetta support, we'll need a native\naarch64 version of the gn executable. This removes the toolchain-alias\nmacosx64-aarch64-gn from macosx64-gn, and adds a real macosx64-aarch64-gn\ntask to replace the alias. build-gn-macosx.sh takes the target triple as an\nargument.\n\nESR115 path mapping: taskcluster/kinds/toolchain/gn.yml -\u003e taskcluster/ci/toolchain/gn.yml\n\n(cherry picked from commit 2fa844fca424e812274158508f785ad9471a0562)\n\nSource Differential: https://phabricator.services.mozilla.com/D308372\nDetailed-Range-First: f5e91bcd88ef60bd99e1fd8b2ff3030936f19fac\nDetailed-Range-Last: f5e91bcd88ef60bd99e1fd8b2ff3030936f19fac\nDetailed-Commit-Count: 1\nDetailed-Stack-Head: f93f24f81a7e33b25003db08ce31776dcd6fa69b\nDetailed-Endpoint-Tree: 60d0ac1e5f7f7ec1946cb09b4f831f64d84f4426\nSource-Orders-First: 0.1\nSource-Orders-Last: 0.1\nSource-Bug: 2049854\nCondensation-Plan-SHA256: cb0