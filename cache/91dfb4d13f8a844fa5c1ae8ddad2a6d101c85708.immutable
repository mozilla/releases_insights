"pushes": {"36": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1778444 - Clear UISettings on shutdown (esr). r=kaie, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151314", "files": ["widget/windows/WindowsUIUtils.cpp"], "git_node": null, "git_parents": [null], "node": "0faf039283ce419e48c558b422bd6d9c1c882c75", "parents": ["1306e81674f5aada1900d40b0c12e39b7391816c"], "tags": []}], "date": 1658162859, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "37": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 73db4126165f2a2eded92f48a6c81c8ece6d21ce with FIREFOX_102_1_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "b4028879209e8c76d036f2921138ea2ac7f3c32c", "parents": ["73db4126165f2a2eded92f48a6c81c8ece6d21ce"], "tags": []}], "date": 1658167813, "git_changesets": [null], "user": "ffxbld"}, "38": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152371", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "43cb5bc75ec2e152beed45a11ad7f3a29cc2aa31", "parents": ["b4028879209e8c76d036f2921138ea2ac7f3c32c"], "tags": []}], "date": 1658418761, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "39": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_102_0_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "4a88ed9d27c39db53164331ca734cadb27a2626e", "parents": ["0faf039283ce419e48c558b422bd6d9c1c882c75"], "tags": []}], "date": 1658603397, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "40": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "d4be63810b66a5cd0e868f8a1a7b9e652ce8a47b", "parents": ["43cb5bc75ec2e152beed45a11ad7f3a29cc2aa31"], "tags": []}], "date": 1658766107, "git_changesets": [null], "user": "ffxbld-merge"}, "41": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 73db4126165f2a2eded92f48a6c81c8ece6d21ce with FIREFOX_102_1_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "0d9e4bb134f6ad70bdeb477e5ad08988ff202d39", "parents": ["d4be63810b66a5cd0e868f8a1a7b9e652ce8a47b"], "tags": []}], "date": 1658839828, "git_changesets": [null], "user": "ffxbld"}, "42": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777521 - enable bouncer-check for Firefox-esr-next-msix-latest-SSL.  r=gabriel a=release DONTBUILD\n\nNow that 102.1.0esr has shipped the Firefox-esr-next-msix-latest-SSL\nproduct is populated in bouncer so we can enable the check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152764", "files": ["testing/mozharness/configs/releases/bouncer_firefox_esr.py"], "git_node": null, "git_parents": [null], "node": "3c8df5155b7f5c4243455580f8a095125aeb93d7", "parents": ["0d9e4bb134f6ad70bdeb477e5ad08988ff202d39"], "tags": []}], "date": 1658853804, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "43": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153074", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "9c8667c1d9c05cf24512c8bc63fc9d3f558f1970", "parents": ["3c8df5155b7f5c4243455580f8a095125aeb93d7"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1770219 - Disallow large buffer allocations. r=jimb, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151583", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": null, "git_parents": [null], "node": "cef5450240bfe622870b34d9a70c5571b1f296d5", "parents": ["9c8667c1d9c05cf24512c8bc63fc9d3f558f1970"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1774476 - [cdp] Delay initialization of CDP until browserStartupFinished. r=jgraham, a=RyanVM\n\nInitializing CDP before the first window has been opened can break\nthe registration of the first browser window because a pre-loaded\nwindow gets opened first before the gBrowser is attached.\n\nThis also prevents any CDP client to connect to any the JSONHandler\nend-points before CDP is actually ready.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151843", "files": ["remote/cdp/CDP.jsm"], "git_node": null, "git_parents": [null], "node": "afc998277cb3869519b95c67945c7a2b4dd977a8", "parents": ["cef5450240bfe622870b34d9a70c5571b1f296d5"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779935 - Ensure GradientCache lookup and insertion are atomic. r=lsalzman, a=RyanVM\n\nThere are potential races between insertion of the same gradient into\nthe cache on different threads, as well as acquiring a strong reference\nto the GradientStops object racing with the expiration timer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151981", "files": ["gfx/thebes/gfxGradientCache.cpp", "gfx/thebes/gfxPlatform.cpp"], "git_node": null, "git_parents": [null], "node": "a84342f23942c07a5eb2eb6a1a5562f52c50a3dc", "parents": ["afc998277cb3869519b95c67945c7a2b4dd977a8"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1778951 - [devtools] Update webextension target actor browsingcontext group id after addon reload. r=rpl,ochameau a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151728", "files": ["devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_console.js", "devtools/server/actors/targets/webextension.js"], "git_node": null, "git_parents": [null], "node": "72609d9bf6213e61aaa878543818cbca53cf935d", "parents": ["a84342f23942c07a5eb2eb6a1a5562f52c50a3dc"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1780076 - fix ordering of multiple setup tasks in xpcshell tests, r=nalexander a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152119", "files": ["testing/xpcshell/example/unit/test_multiple_setups.js", "testing/xpcshell/example/unit/test_multiple_tasks.js", "testing/xpcshell/example/unit/xpcshell.ini", "testing/xpcshell/head.js"], "git_node": null, "git_parents": [null], "node": "fe8278ae29edf6f3a3d89fcedc54c7fd4bae2986", "parents": ["72609d9bf6213e61aaa878543818cbca53cf935d"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1778728 - update-verify: request non-stale responses from the CDN. r=jlorenzo, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151469", "files": ["tools/update-verify/release/get-update-xml.sh", "tools/update-verify/scripts/async_download.py"], "git_node": null, "git_parents": [null], "node": "910741d10d90e1da3851bd148428ce2cc1e75fa8", "parents": ["fe8278ae29edf6f3a3d89fcedc54c7fd4bae2986"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1780540 - Don't forget charmap after setting in a font entry. r=jfkthame, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152379", "files": ["gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxGDIFontList.cpp", "gfx/thebes/gfxMacPlatformFontList.mm"], "git_node": null, "git_parents": [null], "node": "87ebdf7370e8c54cac90df3fb4abd804bfbeb59d", "parents": ["910741d10d90e1da3851bd148428ce2cc1e75fa8"], "tags": []}, {"author": "Philip Chimento \u003cpchimento@igalia.com\u003e", "branch": "default", "desc": "Bug 1776254 - Install ProfilingCategoryList.h. r=arai, a=RyanVM\n\nWhen installing embedded SpiderMonkey, we need to install the generated\nheader ProfilingCategoryList.h into /usr/include/mozjs-___/js/ because\nthat's where the rest of the SpiderMonkey code expects to find it.\nIt's not automatically installed already, because it's generated.\n\nThanks to Arai for the suggestion of where to look.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152549", "files": ["js/src/build/Makefile.in"], "git_node": null, "git_parents": [null], "node": "33147b91e42b79f4c6dd3ec11cce96746018407a", "parents": ["87ebdf7370e8c54cac90df3fb4abd804bfbeb59d"], "tags": []}, {"author": "Philip Chimento \u003cpchimento@igalia.com\u003e", "branch": "default", "desc": "Bug 1780857 - Change if to ifdef for DEBUG. r=jimb, a=RyanVM\n\nThe paradigm for DEBUG is that it is defined or not defined, not 1 or 0,\nso we have to use ifdef here. Otherwise we get a build error in embedded\nSpiderMonkey when DEBUG is not defined.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152556", "files": ["js/public/Debug.h"], "git_node": null, "git_parents": [null], "node": "1fa20fb474f5d149cc32d98df169dee5e6e6861b", "parents": ["33147b91e42b79f4c6dd3ec11cce96746018407a"], "tags": []}], "date": 1659016558, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "44": {"changesets": [{"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset cef5450240bf (bug 1770219) for causing build bustages. a=backout", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": null, "git_parents": [null], "node": "12a5ccd697026e9a98920b75ced36b5d81c1ad79", "parents": ["1fa20fb474f5d149cc32d98df169dee5e6e6861b"], "tags": []}], "date": 1659018133, "git_changesets": [null], "user": "csabou@mozilla.com"}, "45": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153383", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "e41696ce236ac815063cd8f5141442a2d7a69e94", "parents": ["12a5ccd697026e9a98920b75ced36b5d81c1ad79"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1780834. If a webp file header specifies ICCP but no ICCP chunk is found just ignore it and continue. r=aosmond, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152588", "files": ["image/decoders/nsWebPDecoder.cpp", "image/test/reftest/reftest.list", "image/test/reftest/webp/blue.png", "image/test/reftest/webp/icc-bit-no-icc-chunk.webp", "image/test/reftest/webp/reftest.list"], "git_node": null, "git_parents": [null], "node": "40922c97ff033c3333ea9bffbc08f76c8cd0c983", "parents": ["e41696ce236ac815063cd8f5141442a2d7a69e94"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1781094 - Revert the some changes done in bug 1759745 and also try to take more output data, r=necko-reviewers,dragana, a=dsmith\n\nThe problem in the previous change is that `mBrotli-\u003emTotalOut` is not updated immediately. In the case that `nsUnknownDecoder` is involved in the listener chain and the result of `Brotli` decoder is `BROTLI_DECODER_RESULT_NEEDS_MORE_INPUT`, `mBrotli-\u003emTotalOut` is 0. In the end, when `nsHTTPCompressConv::OnStopRequest` is called by `nsUnknownDecoder` [1], an error code is set [2].\nThe safest way would be to revert the changes done in bug 1759745. However, to make the case in bug 1759745 work ( and also make `test_brotli_decoding.js` pass), we need to add another while loop and try to get more output data from the decoder.\n\n\n[1] https://searchfox.org/mozilla-central/rev/d5edb4a4538657b7d691a41c00e6796a19ade6e7/netwerk/streamconv/converters/nsUnknownDecoder.cpp#778\n[2] https://searchfox.org/mozilla-central/rev/d5edb4a4538657b7d691a41c00e6796a19ade6e7/netwerk/streamconv/converters/nsHTTPCompressConv.cpp#167\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152729", "files": ["netwerk/streamconv/converters/nsHTTPCompressConv.cpp"], "git_node": null, "git_parents": [null], "node": "f95a172405adace8207bd40df4643fab779255f3", "parents": ["40922c97ff033c3333ea9bffbc08f76c8cd0c983"], "tags": []}], "date": 1659380565, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "46": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1770219 - Disallow large buffer allocations. r=jimb, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151583", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": null, "git_parents": [null], "node": "fa262c83d47a434e33c82534550f6b24da678806", "parents": ["f95a172405adace8207bd40df4643fab779255f3"], "tags": []}, {"author": "Magnus Melin \u003cmkmelin+mozilla@iki.fi\u003e", "branch": "default", "desc": "Bug 1779343 - Don't crash rewrapping \"\u003e \". r=masayuki, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151682", "files": ["editor/libeditor/HTMLEditorDataTransfer.cpp", "editor/libeditor/tests/test_bug1649005.html"], "git_node": null, "git_parents": [null], "node": "25cff8f465b66461152741bac977fb33692ab886", "parents": ["fa262c83d47a434e33c82534550f6b24da678806"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1773848 - Make the for-loop in the lambda in `HTMLEditor::InsertTableRowsWithTransaction` refer only `cellDataInLastRow` r=m_kato a=RyanVM\n\nIt's renamed from `CellData`, but `cellData` still exists in the wider scope.\nhttps://searchfox.org/mozilla-central/rev/f6a2ef2f028b8f1eb82fa5dc5cb1e39a3baa8feb/editor/libeditor/HTMLTableEditor.cpp#923-924\n\nTherefore, these lines are wrong:\nhttps://searchfox.org/mozilla-central/rev/f6a2ef2f028b8f1eb82fa5dc5cb1e39a3baa8feb/editor/libeditor/HTMLTableEditor.cpp#1049,1053\n\nbecause `cellData` was in the for-loop:\nhttps://searchfox.org/mozilla-central/rev/bc4493c72442ad55aecf6b575edb0df4ed18b113/editor/libeditor/HTMLTableEditor.cpp#1008-1009,1020,1022,1026\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152144", "files": ["editor/libeditor/HTMLTableEditor.cpp", "editor/libeditor/tests/test_nsITableEditor_insertTableRow.html"], "git_node": null, "git_parents": [null], "node": "bf9db213f1dd57dbfe8a4c91d480e65e8259e3b7", "parents": ["25cff8f465b66461152741bac977fb33692ab886"], "tags": []}, {"author": "scott \u003cscott.downe@gmail.com\u003e", "branch": "default", "desc": "Bug 1780554 - Fix Remote settings server url in PersonalityProvider.jsm. r=barret, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153111", "files": ["browser/components/newtab/lib/PersonalityProvider/PersonalityProvider.jsm", "browser/components/newtab/test/unit/lib/PersonalityProvider/PersonalityProvider.test.js"], "git_node": null, "git_parents": [null], "node": "f235e80a0694f2c6b7802e2db85e87704bf00045", "parents": ["bf9db213f1dd57dbfe8a4c91d480e65e8259e3b7"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777225 - Clear last_etag preference when server responds with error. r=gbeckley, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150765", "files": ["services/settings/remote-settings.js", "services/settings/test/unit/test_remote_settings_poll.js"], "git_node": null, "git_parents": [null], "node": "b9a904c80a851c162e438fc26369b2bbd376ed59", "parents": ["f235e80a0694f2c6b7802e2db85e87704bf00045"], "tags": []}, {"author": "Robert Mader \u003crobert.mader@posteo.de\u003e", "branch": "default", "desc": "Bug 1780889 - Add AMD Yellow Carp device ID, r=gfx-reviewers,jgilbert, a=RyanVM\n\nWe really should move to blocklisting...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152582", "files": ["widget/GfxDriverInfo.cpp"], "git_node": null, "git_parents": [null], "node": "d7856e4d55a317d2e25bfbef903791118a735fa1", "parents": ["b9a904c80a851c162e438fc26369b2bbd376ed59"], "tags": []}], "date": 1659461285, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "47": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset f235e80a0694 (bug 1780554) for ESLint and newtab test failures.", "files": ["browser/components/newtab/lib/PersonalityProvider/PersonalityProvider.jsm", "browser/components/newtab/test/unit/lib/PersonalityProvider/PersonalityProvider.test.js"], "git_node": null, "git_parents": [null], "node": "9c92525e861fe46103867d4eb1866e8313d1b456", "parents": ["d7856e4d55a317d2e25bfbef903791118a735fa1"], "tags": []}, {"author": "scott \u003cscott.downe@gmail.com\u003e", "branch": "default", "desc": "Bug 1780554 - Fix Remote settings server url in PersonalityProvider.jsm. r=barret, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153111", "files": ["browser/components/newtab/lib/PersonalityProvider/PersonalityProvider.jsm", "browser/components/newtab/test/unit/lib/PersonalityProvider/PersonalityProvider.test.js"], "git_node": null, "git_parents": [null], "node": "bd1f5a58c60900da2cf8db940398c8053daa7428", "parents": ["9c92525e861fe46103867d4eb1866e8313d1b456"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1769155 - Null-check win in setter for IsActiveBrowserWindowInternal. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148914", "files": ["docshell/base/BrowsingContext.cpp"], "git_node": null, "git_parents": [null], "node": "5371a6a9823d3bd189abc3068e8eab64f8d4da13", "parents": ["bd1f5a58c60900da2cf8db940398c8053daa7428"], "tags": []}, {"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1769155 - Deal with document replacement. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148915", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "dom/xslt/nsIDocumentTransformer.h", "dom/xslt/xslt/txMozillaTextOutput.cpp", "dom/xslt/xslt/txMozillaTextOutput.h", "dom/xslt/xslt/txMozillaXMLOutput.cpp", "dom/xslt/xslt/txMozillaXMLOutput.h", "dom/xslt/xslt/txMozillaXSLTProcessor.cpp"], "git_node": null, "git_parents": [null], "node": "411467b6ab5e8cad0651ec009b1bba4f9d2c996f", "parents": ["5371a6a9823d3bd189abc3068e8eab64f8d4da13"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779173 - [devtools] Fix call to isMinified in Debugger to prevent performance issue when opening big single-line file. r=jdescottes, a=RyanVM\n\nChanges in Bug 1754407 caused a performance regression as it now triggered\nsyntax highlighting of big files, which we avoided before.\nThis is because we don't call `isMinified` with the expected type of data, causing\nthe file to not be seen as minified, and thus highlighting it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153140", "files": ["devtools/client/debugger/src/components/Editor/index.js", "devtools/client/debugger/src/utils/editor/source-documents.js"], "git_node": null, "git_parents": [null], "node": "002d0f2bf50be325c997f7255d9e014590d6925b", "parents": ["411467b6ab5e8cad0651ec009b1bba4f9d2c996f"], "tags": []}], "date": 1659472848, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "48": {"changesets": [{"author": "Erik Nordin \u003cnordzilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1762046 - Add valgrind suppression for the leak of a dynamic atom created by DocumentL10n. r=jseward, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149423", "files": ["build/valgrind/x86_64-pc-linux-gnu.sup"], "git_node": null, "git_parents": [null], "node": "be0c3b8a5ff487f2d677950ab30d6e1065cf4cc4", "parents": ["002d0f2bf50be325c997f7255d9e014590d6925b"], "tags": []}, {"author": "Alessio Placitelli \u003calessio.placitelli@gmail.com\u003e", "branch": "default", "desc": "Bug 1776219 - Gracefully handle psutils failures in mach telemetry. r=ahochheiden, a=NPOTB\n\nOn OpenBSD/i386, psutils fails in the generator used to enumerate the\nactive processes, breaking the build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150462", "files": ["python/mozbuild/mozbuild/telemetry.py"], "git_node": null, "git_parents": [null], "node": "d42bf71bd0e1eb20b1daa9baf04995eab6178b46", "parents": ["be0c3b8a5ff487f2d677950ab30d6e1065cf4cc4"], "tags": []}, {"author": "Malte J\u00fcrgens \u003cmaltejur@dismail.de\u003e", "branch": "default", "desc": "Bug 1780220 - Prompt Mercurial installation on openSUSE like on Debian. r=ahochheiden, a=NPOTB\n\n- Removed `install_mercurial`, since it doesn't seem to be used.\n- Rewrote `upgrade_mercurial` to act more like on Debian,\n  meaning it will prompt the user if Mercurial should be\n  installed via zypper or pip, and install via zypper if\n  non-interactive. Everything is then installed system-\n  wide.\n- Moved `MERCURIAL_INSTALL_PROMPT` into `base.py`\n- Added parantheses to `self.zypper_update()`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152207", "files": ["python/mozboot/mozboot/base.py", "python/mozboot/mozboot/debian.py", "python/mozboot/mozboot/opensuse.py"], "git_node": null, "git_parents": [null], "node": "b8c3d804cabbe388ecb53d7debdbe2aae2c4a81f", "parents": ["d42bf71bd0e1eb20b1daa9baf04995eab6178b46"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1732475 - Closing unused windows for the test browser_privatebrowsing_sidebar.js. r=pbz, a=test-only\n\nThe test used to create a lot of windows and close them at once when the\ntest ends. This behavior consumes lots of memory and could cause OOM\nissue.\n\nTo avoid that, we can close unused windows during the test so that the\nmemory consumption can be reduced for the test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152499", "files": ["browser/components/privatebrowsing/test/browser/browser_privatebrowsing_sidebar.js"], "git_node": null, "git_parents": [null], "node": "8fb5b716752e0771039526bc339745f6ef525ba8", "parents": ["b8c3d804cabbe388ecb53d7debdbe2aae2c4a81f"], "tags": []}], "date": 1659585396, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "49": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153739", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "ed60b6669c4db81ddcbb6bc4cde677b6fabd3316", "parents": ["8fb5b716752e0771039526bc339745f6ef525ba8"], "tags": []}], "date": 1659613937, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "50": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1771685 - Init feature policy. r=farre, a=tjr\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151516", "files": ["dom/base/Document.h", "dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": null, "git_parents": [null], "node": "858d7fde5f6ad2040f2a746bc5839fcfa3198d4b", "parents": ["ed60b6669c4db81ddcbb6bc4cde677b6fabd3316"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1777186 [Wayland] Use correct popup window to calculate parent fit. r=jhorak, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150537", "files": ["widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "92a4771d3b37ea234a6f3926a0f468477728222d", "parents": ["858d7fde5f6ad2040f2a746bc5839fcfa3198d4b"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1778158 - quartz: Avoid reading beyond the end of image surfaces. r=jfkthame, a=RyanVM\n\nThe last row of data may have less than stride bytes so make sure we\nonly copy what we need.\n\nThis corresponds to cairo:cccc81ccba99600483621e02ae9438a4a5a3d024\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151053", "files": ["gfx/cairo/cairo/src/cairo-quartz-surface.c"], "git_node": null, "git_parents": [null], "node": "6f460b86ffd33492165977893450c5417f802596", "parents": ["92a4771d3b37ea234a6f3926a0f468477728222d"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1769429. Revert 1719215. r=lsalzman, a=RyanVM\n\nThis fixes subimage drawing with Cairo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151152", "files": ["gfx/2d/DrawTargetCairo.cpp", "testing/web-platform/tests/css/printing/background-image-print-ref.html", "testing/web-platform/tests/css/printing/background-image-print.html"], "git_node": null, "git_parents": [null], "node": "4a85e34e3380fa56af254d1bdf402566e2dd11fe", "parents": ["6f460b86ffd33492165977893450c5417f802596"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1778281 - Don't override effective color-scheme if there's no theme. r=jdescottes, a=RyanVM\n\nIn the browser toolbox window, we include common.css, but we don't\napply the theme-dark/theme-light classes, so we end up overriding the\ncolor-scheme to light.\n\nInstead, only override color-scheme for theme-light/theme-dark, so that\ncontext menus and so have the right appearance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151131", "files": ["devtools/client/themes/common.css"], "git_node": null, "git_parents": [null], "node": "8fcaf53d6b8995000c5091f4a302b7f5305f4e8c", "parents": ["4a85e34e3380fa56af254d1bdf402566e2dd11fe"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1776210 - [macOS 13] Stack underflow crashes on Wifi Monitor thread on macOS 13 (Ventura) beta. r=mstange,dragana, a=RyanVM\n\nUse a larger stack size on macOS 13 for the Wifi monitor thread to accommodate Core WLAN code allocating 217K+ on the stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152555", "files": ["netwerk/wifi/nsWifiMonitor.cpp", "netwerk/wifi/nsWifiMonitor.h", "widget/cocoa/nsCocoaFeatures.h", "widget/cocoa/nsCocoaFeatures.mm"], "git_node": null, "git_parents": [null], "node": "269b34177205460267f1d205621382f9df7bebef", "parents": ["8fcaf53d6b8995000c5091f4a302b7f5305f4e8c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1781724 - Fix JSString::encodeUTF8Partial with some ropes. r=anba, a=RyanVM\n\nWe can't exit early if src.IsEmpty() if the stack is non-empty.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152899", "files": ["js/src/tests/non262/String/utf8-encode.js", "js/src/vm/StringType.cpp"], "git_node": null, "git_parents": [null], "node": "ad317faecd3009f4ab455dae08ff1cf4469ce8ee", "parents": ["269b34177205460267f1d205621382f9df7bebef"], "tags": []}], "date": 1659622586, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "51": {"changesets": [{"author": "Barret Rennie \u003cbarret@brennie.ca\u003e", "branch": "default", "desc": "Bug 1780445 - Fix Remote Settings server URL lookup in ASRouter and Remote Images. r=pdahiya,nalexander a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152306", "files": ["browser/components/newtab/lib/ASRouter.jsm", "browser/components/newtab/lib/RemoteImages.jsm", "browser/components/newtab/test/RemoteImagesTestUtils.jsm", "browser/components/newtab/test/browser/browser_asrouter_bug1761522.js", "browser/components/newtab/test/unit/unit-entry.js"], "git_node": null, "git_parents": [null], "node": "51f5d02db15f9b42bd31da0ab09483e15371dc08", "parents": ["ad317faecd3009f4ab455dae08ff1cf4469ce8ee"], "tags": []}, {"author": "Barret Rennie \u003cbarret@brennie.ca\u003e", "branch": "default", "desc": "Bug 1783093 - Don't call clearUserPref for the RS server pref in RemoteImages tests. r=thecount, a=test-only\n\nIf we clear the pref, we end up clearing the user-branch value set for tests\nand end up with default branch value, which will point to the Remote Settings\nserver used in production.\n\nInstead, we store the original value when we would reset it so that we have end\nup with the pref set to the test value instead of the real value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153693", "files": ["browser/components/newtab/test/RemoteImagesTestUtils.jsm"], "git_node": null, "git_parents": [null], "node": "0f9ee6312fe212d6b6e78432859ac2cf987a3957", "parents": ["51f5d02db15f9b42bd31da0ab09483e15371dc08"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1714615 - re-enable browser_topsites_section.js on linux tsan. a=test-only\n\nThis test was disabled in an attempt to mitigate this bug. As it turns out, the\nunderlying issue was in a different test, and that test has now been fixed, so\nwe can safely re-enable this one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153894", "files": ["browser/components/newtab/test/browser/browser.ini"], "git_node": null, "git_parents": [null], "node": "3a1d11a48a1da5b659102096acfa444a888839bd", "parents": ["0f9ee6312fe212d6b6e78432859ac2cf987a3957"], "tags": []}, {"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1776658: Update some setNumber callers. r=jandem, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152822", "files": ["dom/bindings/ToJSValue.h", "dom/indexedDB/KeyPath.cpp", "js/xpconnect/src/XPCConvert.cpp", "js/xpconnect/src/XPCVariant.cpp"], "git_node": null, "git_parents": [null], "node": "e54330341b5224a44cc758f3f1e59ad3381bd648", "parents": ["3a1d11a48a1da5b659102096acfa444a888839bd"], "tags": []}, {"author": "sotaro \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1779942 - Check IsContextLost() after DrawingBufferSize() call. r=jgilbert,lsalzman a=RyanVM\n\nClientWebGLContext::DrawingBufferSize() could cause context lost. Then IsContextLost() check is added after the DrawingBufferSize() call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152138", "files": ["dom/canvas/ClientWebGLContext.cpp"], "git_node": null, "git_parents": [null], "node": "77c944cd1c6220375d4c8063342f44b610e23065", "parents": ["e54330341b5224a44cc758f3f1e59ad3381bd648"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779973 - treat failure to parse certificate validity as a time error. r=djackson, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152333", "files": ["security/manager/ssl/SSLServerCertVerification.cpp", "security/manager/ssl/tests/unit/bad_certs/beforeEpochSelfSigned.pem", "security/manager/ssl/tests/unit/bad_certs/beforeEpochSelfSigned.pem.certspec", "security/manager/ssl/tests/unit/test_cert_overrides.js", "security/manager/ssl/tests/unit/tlsserver/cmd/BadCertAndPinningServer.cpp"], "git_node": null, "git_parents": [null], "node": "6632c2c2c030d10fe9d6919b92977255164e5e38", "parents": ["77c944cd1c6220375d4c8063342f44b610e23065"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1778718 - Clean-up some scroll frame DL building code. r=tnikkel, a=RyanVM\n\nThis doesn't change behavior but makes the next patch simpler, and makes\nthe ignore-scrollframe and non-ignore-scrollframe code-paths match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151473", "files": ["layout/generic/nsGfxScrollFrame.cpp"], "git_node": null, "git_parents": [null], "node": "3742a0b502204eff714296687864816729f2ae89", "parents": ["6632c2c2c030d10fe9d6919b92977255164e5e38"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1778718 - Make filters on the root work when using fallback drawing. r=tnikkel, a=RyanVM\n\nThis code-path will be hit with the next patch.\n\nDepends on D151473\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151474", "files": ["layout/painting/nsDisplayList.cpp", "layout/svg/FilterInstance.cpp", "layout/svg/FilterInstance.h", "layout/svg/SVGIntegrationUtils.cpp", "layout/svg/SVGIntegrationUtils.h", "layout/svg/SVGUtils.cpp"], "git_node": null, "git_parents": [null], "node": "827275b8032eb0288f379dbdd1eb24d1dae0b780", "parents": ["3742a0b502204eff714296687864816729f2ae89"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1778718 - Make filter/backdrop-filter wrapping work when ignoring a scroll frame. r=tnikkel, a=RyanVM\n\nFactor the code to build the top layer and wrapping for filters into a\ncommon function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151475", "files": ["layout/generic/nsGfxScrollFrame.cpp", "layout/generic/nsGfxScrollFrame.h", "testing/web-platform/tests/css/filter-effects/svg-image-root-filter-ref.html", "testing/web-platform/tests/css/filter-effects/svg-image-root-filter.html"], "git_node": null, "git_parents": [null], "node": "7e27d6c58d1675a41d3deabcc3b5343e7124d397", "parents": ["827275b8032eb0288f379dbdd1eb24d1dae0b780"], "tags": []}], "date": 1659923022, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "52": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153939", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/password-rules.json", "services/settings/dumps/main/websites-with-shared-credential-backends.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "40f1284cc9298970cfabf9f10bedab90d454c5cd", "parents": ["7e27d6c58d1675a41d3deabcc3b5343e7124d397"], "tags": []}, {"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1782828 - Bump snap dependencies core18=\u003e20 and gnome-3-34=\u003e38 r=gerard-majax,gbrown, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153734", "files": ["taskcluster/docker/firefox-snap/Dockerfile", "taskcluster/docker/firefox-snap/firefox.snapcraft.yaml.in"], "git_node": null, "git_parents": [null], "node": "8e9222f1ef1a87e312b8ec9ec4b11be3d2564c0d", "parents": ["40f1284cc9298970cfabf9f10bedab90d454c5cd"], "tags": []}, {"author": "Kai Engert \u003ckaie@kuix.de\u003e", "branch": "default", "desc": "Bug 1782740 - Update to NSPR 4.34.1 RTM. r=bbeurdouche UPGRADE_NSPR_RELEASE, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153800", "files": ["nsprpub/TAG-INFO", "nsprpub/configure", "nsprpub/configure.in", "nsprpub/pr/include/prinit.h", "nsprpub/pr/src/md/unix/unix.c", "nsprpub/pr/tests/vercheck.c"], "git_node": null, "git_parents": [null], "node": "9e10397c8a15727acf96f89c7780060581c92306", "parents": ["8e9222f1ef1a87e312b8ec9ec4b11be3d2564c0d"], "tags": []}, {"author": "Glenn Watson \u003cgit@intuitionlibrary.com\u003e", "branch": "default", "desc": "Bug 1768678 - Fix blur source size adjustment for downscaling r=gfx-reviewers,lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152243", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/wrench/reftests/filters/filter-blur-downscale-fractional.png", "gfx/wr/wrench/reftests/filters/filter-blur-downscale-fractional.yaml", "gfx/wr/wrench/reftests/filters/filter-large-blur-radius.png", "gfx/wr/wrench/reftests/filters/reftest.list", "testing/web-platform/meta/css/filter-effects/backdrop-filter-edge-clipping.html.ini"], "git_node": null, "git_parents": [null], "node": "219f05219b4cf82e508cf6f9a23c7b19bc0d7c61", "parents": ["9e10397c8a15727acf96f89c7780060581c92306"], "tags": []}, {"author": "Glenn Watson \u003cgit@intuitionlibrary.com\u003e", "branch": "default", "desc": "Bug 1782405 - Fix UV sampling rect for blurs with downscale-adjusted sizes r=gfx-reviewers,lsalzman, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153314", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/wrench/reftests/filters/filter-blur-downscale-fractional.png", "gfx/wr/wrench/reftests/filters/filter-large-blur-radius.png"], "git_node": null, "git_parents": [null], "node": "ea5afc64f4f27ab47d2a41b903558c9ce59820de", "parents": ["219f05219b4cf82e508cf6f9a23c7b19bc0d7c61"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1745116 - Make TestThreadMetrics check against how much time was actually spent, r=smaug a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153809", "files": ["xpcom/tests/gtest/TestThreadMetrics.cpp"], "git_node": null, "git_parents": [null], "node": "1fc0584921f98d5df7db6e0dbff1393e9f3c5c12", "parents": ["ea5afc64f4f27ab47d2a41b903558c9ce59820de"], "tags": []}], "date": 1659967158, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "53": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1778325 - Allow WindowsSSO in iframes. r=dragana,necko-reviewers, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151378", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": null, "git_parents": [null], "node": "a7984702fd55f3607e8ea04665c492bc8abf006e", "parents": ["1fc0584921f98d5df7db6e0dbff1393e9f3c5c12"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1779128, rework filename sanitization to ensure that the extension is properly validated, r=Gijs, a=RyanVM\n\nThe existing code doesn't use the sanitized extension part of the filename, when it replaces the filename when it is too long but instead used a version passed to SanitizeFileName. This newer version always gets the extension from the filename after it has been validated.\n\nSome tests have slightly different results, because the file is now cropped slightly differently when the character count and byte count of long filenames don't match, resulting in some filenames being cropped a few extra characters more than needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151826", "files": ["uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/nsExternalHelperAppService.h", "uriloader/exthandler/tests/unit/test_filename_sanitize.js"], "git_node": null, "git_parents": [null], "node": "5b5eec241e1fb34625a06bcdfa7869e016b426e6", "parents": ["a7984702fd55f3607e8ea04665c492bc8abf006e"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1778429, use utf-16 character literals when calling ReplaceChar in SanitizeFileName, r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152669", "files": ["uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/tests/unit/test_filename_sanitize.js"], "git_node": null, "git_parents": [null], "node": "f2bffe3964aed053e5f146781355b9a9601f2c3f", "parents": ["5b5eec241e1fb34625a06bcdfa7869e016b426e6"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1782947 - Check for null pres context in nsLayoutUtils::GetTextRunFlagsForStyle. r=jfkthame, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153583", "files": ["layout/base/nsLayoutUtils.cpp"], "git_node": null, "git_parents": [null], "node": "9db7c6fcc9f49adbc2f4b306ca7af5f0c1224855", "parents": ["f2bffe3964aed053e5f146781355b9a9601f2c3f"], "tags": []}], "date": 1659981230, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "54": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1776498 - Use popup class with all popups. r=Jamie,handyman, a=RyanVM\n\nManage their shadow style per-window instead. It is a bit unfortunate, but\nalas, seems to work, and we had existing code for various workarounds, so it's\nnot too gross.\n\nThe menulist special-case isn't needed anymore, menulists always have\neTransparencyTransparent nowadays on Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151994", "files": ["layout/xul/nsMenuPopupFrame.cpp", "widget/nsWidgetInitData.h", "widget/windows/WinMessages.h", "widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h", "widget/windows/nsWindowDefs.h"], "git_node": null, "git_parents": [null], "node": "de79c1f8b321b475292770ef249ed31f064d35ac", "parents": ["9db7c6fcc9f49adbc2f4b306ca7af5f0c1224855"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1781747 - Don't use shadow class for non-menupopup popup windows. r=Jamie,handyman, a=RyanVM\n\nThese don't get styles early enough to make a shadow decision before Show().\nThis also matches the previous behavior (nothing would set\nnsWidgetInitData::mDropShadow for these windows), so this is the less risky\nfix.\n\nIt seems somewhat sketchy to use a popup window for these to begin with (Linux\nfor example maps them to a toplevel Window, at least on Wayland...), but let's\nnot change too much right now.\n\nThe hbrBackground change is a no-op because we can't have a brush before\nCreate() is called, we update it in SetBackgroundColor().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153095", "files": ["layout/xul/nsMenuPopupFrame.cpp", "widget/nsWidgetInitData.h", "widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "d9e8135087c50522616b6c32d56fc7bc57b04e70", "parents": ["de79c1f8b321b475292770ef249ed31f064d35ac"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1773771 - Add GoToIntranetSiteForSingleWordEntryInAddressBar enterprise policy. r=mkaply,flod a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148952", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "d6c0e273854d78cf2dc53c3a00c4881812c95185", "parents": ["d9e8135087c50522616b6c32d56fc7bc57b04e70"], "tags": []}, {"author": "Maksim Sadym \u003c69349599+sadym-chromium@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1777173 [wpt PR 34641] - Align `browsingContext.contextCreated` tests with spec, a=testonly\n\nAutomatic update from web-platform-tests\nAlign `browsingContext.contextCreated` tests with spec (#34641)\n\nCo-authored-by: Julian Descottes \u003cjulian.descottes@gmail.com\u003e\nCo-authored-by: Maksim Sadym \u003csadym@google.com\u003e\n\n--\n\nwpt-commits: e351644422d3ffb680b195e6a590b61528db329a\nwpt-pr: 34641", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browsing_context/context_created/context_created.py"], "git_node": null, "git_parents": [null], "node": "a383ed88ef02a02861dd0d2a04b79c2c3cc30537", "parents": ["d6c0e273854d78cf2dc53c3a00c4881812c95185"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777173 [wpt PR 34641] - Update wpt metadata, a=testonly\n\nwpt-pr: 34641\nwpt-type: metadata", "files": ["testing/web-platform/meta/webdriver/tests/bidi/browsing_context/context_created/context_created.py.ini"], "git_node": null, "git_parents": [null], "node": "c7ade6f9b0a25c5b2d1d7e6ad711d32800e8c9ce", "parents": ["a383ed88ef02a02861dd0d2a04b79c2c3cc30537"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1775141 - [webdriver-bidi] Send live \"browsingContext.contextCreated\" events with \"about:blank\" as URL. r=jdescottes, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151321", "files": ["remote/shared/listeners/BrowsingContextListener.jsm", "remote/shared/listeners/test/browser/browser_BrowsingContextListener.js", "remote/webdriver-bidi/modules/root/browsingContext.jsm", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/context_created/context_created.py.ini"], "git_node": null, "git_parents": [null], "node": "8a3b8b2b71d6460dd4f89c2466facd8cdbcfd032", "parents": ["c7ade6f9b0a25c5b2d1d7e6ad711d32800e8c9ce"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1779001 - Fix WindowsPreviewerPerTab scale computation. r=Gijs, a=RyanVM\n\nSeems this code has ~0 tests :-(\n\nIt also seems to have a dpi issue but that is pre-existing (tab contents look\nblurry).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151644", "files": ["browser/modules/WindowsPreviewPerTab.jsm"], "git_node": null, "git_parents": [null], "node": "f2e8994452dd9e70deda1930342eaae03ee54565", "parents": ["8a3b8b2b71d6460dd4f89c2466facd8cdbcfd032"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1770630 - Worker stream readers should contribute to busy count. r=jstutte, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149185", "files": ["dom/base/BodyStream.cpp", "dom/base/BodyStream.h", "dom/fetch/FetchStreamReader.cpp", "dom/fetch/FetchStreamReader.h", "dom/fetch/FetchUtil.cpp", "dom/file/FileReader.cpp", "dom/file/FileReader.h"], "git_node": null, "git_parents": [null], "node": "2052c22e8d9bf8f962b3f62aea39c6b29a8cd446", "parents": ["f2e8994452dd9e70deda1930342eaae03ee54565"], "tags": []}], "date": 1660055378, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "55": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1773891 - Clip overflow of tooltips. r=jfkthame,dao a=RyanVM\n\nI could only repro this on a VM, but I can confirm that removing the\nline-height: 1.2 declaration fixes it on that setup.\n\nAfter some experimenting, it seems like the mouse leaves the main window\nbecause we target the tooltip. That's because of some overflow (maybe a\nline-box being too high or something? I couldn't dig much more).\n\nIncreasing the margin-top substantially or clipping the overflow is\nenough to fix the bug.\n\nThe 21px margin goes back to 2004, and that without it all tooltips\ndisappear in the same fashion. I think it's simpler to just use\noverflow: clip here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151640", "files": ["toolkit/content/xul.css"], "git_node": null, "git_parents": [null], "node": "ccad2e6c7433ffdcff81f3240cfa76adfcf06e24", "parents": ["2052c22e8d9bf8f962b3f62aea39c6b29a8cd446"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1773891 - Remove duplicate tooltip styling. r=dao, a=RyanVM\n\nI don't think why we have a mobile stylesheet (IIUC Android doesn't have\ntooltips...), but I noticed that most tooltip styles are the same and it\nshould be doable to just unify them in xul.css.\n\nWe can't keep the platform-specific bits on their own stylesheet because\nit loads _before_ xul.css, and thus overrides wouldn't quite do.\n\nDepends on D151640\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151641", "files": ["layout/style/test/test_bug405818.html", "toolkit/content/xul.css", "toolkit/themes/linux/global/jar.mn", "toolkit/themes/linux/global/tooltip.css", "toolkit/themes/mobile/global/jar.mn", "toolkit/themes/mobile/global/tooltip.css", "toolkit/themes/osx/global/jar.mn", "toolkit/themes/osx/global/tooltip.css", "toolkit/themes/windows/global/jar.mn", "toolkit/themes/windows/global/tooltip.css"], "git_node": null, "git_parents": [null], "node": "05e120f46ba8d1b35d2fb8d3bc61e32439d69548", "parents": ["ccad2e6c7433ffdcff81f3240cfa76adfcf06e24"], "tags": []}, {"author": "Jeff Muizelaar \u003cjmuizelaar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1773363. Redo serialization of BuiltDisplayListDescriptor. r=nika, a=RyanVM\n\nIt'd be nice to have this automatically generated but I'm not\nsure the best approach for that. This will do for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153666", "files": ["gfx/layers/wr/WebRenderMessageUtils.h"], "git_node": null, "git_parents": [null], "node": "0814879208eb48c7f66c3b6cb3f53037432ce307", "parents": ["05e120f46ba8d1b35d2fb8d3bc61e32439d69548"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1771159 - Don't use gfxXlibSurface in GLContextGLX. r=jgilbert, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153696", "files": ["gfx/gl/GLContextGLX.h", "gfx/gl/GLContextProviderGLX.cpp", "gfx/thebes/gfxPlatformGtk.cpp"], "git_node": null, "git_parents": [null], "node": "d0448fd37c485e7c3c00abd77764db6bc3b4f55f", "parents": ["0814879208eb48c7f66c3b6cb3f53037432ce307"], "tags": []}, {"author": "Mathew Hodson \u003cmathew.hodson@gmail.com\u003e", "branch": "default", "desc": "Bug 1783087 - Fix build with --disable-backgroundtasks. r=nalexander, a=npotb\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153690", "files": ["widget/windows/nsAppShell.cpp"], "git_node": null, "git_parents": [null], "node": "261174b0edf5af0e4191eb6f4fed4dcadd46f1dc", "parents": ["d0448fd37c485e7c3c00abd77764db6bc3b4f55f"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1780054 - Add an IndexedDB composite blob stress test. r=nika, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152837", "files": ["testing/web-platform/tests/IndexedDB/blob-composite-blob-reads.any.js"], "git_node": null, "git_parents": [null], "node": "588d3f76530f3474754c01ce3fecd3027bb7426d", "parents": ["261174b0edf5af0e4191eb6f4fed4dcadd46f1dc"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1780054 - Part 2: Double-check notified stream in nsMultiplexInputStream, r=asuth, a=RyanVM\n\nPreviously, we could end up in situations where nsMultiplexInputStream\nwould receive a callback for a previously notified stream after it had\nalready advanced to the next stream due to the async nature of\nnotifications. This could cause us to skip a stream accidentally. This\nchanges the logic to re-call AsyncWait in that situation on the correct\nstream rather than skipping streams.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152930", "files": ["xpcom/io/nsMultiplexInputStream.cpp"], "git_node": null, "git_parents": [null], "node": "6b992247f60c228d52954602ec13dd91d5c092c8", "parents": ["588d3f76530f3474754c01ce3fecd3027bb7426d"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 1782079 - Mark new test as \"long\" timeout and reduce runtime. r=nika, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153266", "files": ["testing/web-platform/tests/IndexedDB/blob-composite-blob-reads.any.js"], "git_node": null, "git_parents": [null], "node": "7d0208a3d22ca8d85ff6677e816283996e3d3c77", "parents": ["6b992247f60c228d52954602ec13dd91d5c092c8"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1782181 - Part 1: Support canceling AsyncWait in nsMultiplexInputStream, r=asuth, a=RyanVM\n\nPreviously nsMultiplexInputStream would not call `AsyncWait` again when the\ncallback was cleared, meaning that the underlying wait wouldn't actually be\ncancelled. This patch changes the behaviour to more consistently forward the\ncancelling call to the underlying stream.\n\nThere are still some cases where the call will not be cancelled if a read or\nother event caused the stream cursor to advance before canceling, however those\nshould generally be uncommon.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153628", "files": ["xpcom/io/nsMultiplexInputStream.cpp"], "git_node": null, "git_parents": [null], "node": "474e595745e7160380113a86dbc26050459373d8", "parents": ["7d0208a3d22ca8d85ff6677e816283996e3d3c77"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1782181 - Part 2: Notify nsMultiplexInputStream callbacks if AsyncWait fails, r=asuth, a=RyanVM\n\nWhen `nsMultiplexInputStream` calls `AsyncWait` from within\n`OnInputStreamReady`, it is possible for those calls to fail. In that case, we\nwill fail to notify AsyncWait listeners, which could lead to leaks or stream\nhangs. This patch changes the error handling in this situation to instead fire\na pending stream callback after an error when re-dispatching `AsyncWait`.\n\nDepends on D153628\n\nDifferential Revision: https://phabricator.services.mozilla.com/D153629", "files": ["xpcom/io/nsMultiplexInputStream.cpp"], "git_node": null, "git_parents": [null], "node": "bb4ba9e59d36a1f81235dff510a4113ef1cecd05", "parents": ["474e595745e7160380113a86dbc26050459373d8"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1765559 - Add test for bug 1756388; r=smaug, a=test-only\n\nDepends on D144193\n\nDifferential Revision: https://phabricator.services.mozilla.com/D144194", "files": ["dom/html/test/browser.ini", "dom/html/test/browser_fullscreen-document-mutation-navigation.js"], "git_node": null, "git_parents": [null], "node": "18fa1f585ac2f5d0c1d620581814df29d3267db8", "parents": ["bb4ba9e59d36a1f81235dff510a4113ef1cecd05"], "tags": []}], "date": 1660073821, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "56": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update,r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154376", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "5909e8822d62ab7f80d6667e448742396715f207", "parents": ["18fa1f585ac2f5d0c1d620581814df29d3267db8"], "tags": []}], "date": 1660246542, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "57": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154639", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "153088747b81243b2c05dfb0c65734ed5bfd3165", "parents": ["5909e8822d62ab7f80d6667e448742396715f207"], "tags": []}], "date": 1660569920, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "58": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1784877 - Update Qwant icon with the new design. r=mkaply, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154653", "files": ["browser/components/search/extensions/qwant/favicon.ico", "browser/components/search/extensions/qwant/manifest.json", "browser/components/search/extensions/qwantjr/favicon.ico", "browser/components/search/extensions/qwantjr/manifest.json"], "git_node": null, "git_parents": [null], "node": "40d1412657291933cc2c9d65c3306927c1b332e1", "parents": ["153088747b81243b2c05dfb0c65734ed5bfd3165"], "tags": ["FIREFOX_102_2_0esr_BUILD1"]}], "date": 1660582868, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "59": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 40d1412657291933cc2c9d65c3306927c1b332e1 with FIREFOX_102_2_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "205166b6f5991c3d06010a3636503c68a50f20c2", "parents": ["40d1412657291933cc2c9d65c3306927c1b332e1"], "tags": []}], "date": 1660592179, "git_changesets": [null], "user": "ffxbld"}, "60": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154977", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "f53ac628d0a8817f6ef0ccedd809349258cf656e", "parents": ["205166b6f5991c3d06010a3636503c68a50f20c2"], "tags": []}], "date": 1660828513, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "61": {"changesets": [{"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1780564 - Ensure the private search submission url isn't blank r?standard8!, a=dsmith\n\n\nGlean assumes non-url-parseable values for url types are a mistake.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154691", "files": ["toolkit/components/search/SearchService.jsm", "toolkit/components/search/tests/xpcshell/test_defaultEngine.js"], "git_node": null, "git_parents": [null], "node": "f0ebee0d17f68d99b8e3a7566dd7ba3fefe4bff5", "parents": ["f53ac628d0a8817f6ef0ccedd809349258cf656e"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1785830 - Enable JNLP as a trusted file extension for ESR only. a=dsmith", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/test/gtest/TestExecutableLists.cpp", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": null, "git_parents": [null], "node": "c3f360bdd275e22a40d35ac0deadeee1380fcea9", "parents": ["f0ebee0d17f68d99b8e3a7566dd7ba3fefe4bff5"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 1785788 - land NSS NSS_3_79_1_RTM UPGRADE_NSS_RELEASE, r=#nss-reviewers, a=dsmith\n\n```\n2022-08-18  Anna Weine  \u003canna.weine@mozilla.com\u003e\n\n\t* lib/nss/nss.h, lib/softoken/softkver.h, lib/util/nssutil.h:\n\tSet version numbers to 3.79.1 final\n\t[b8532be03b77] [NSS_3_79_1_RTM] \u003cNSS_3_79_1_BRANCH\u003e\n\n\t* doc/rst/releases/nss_3_79_1.rst:\n\tDocumentation: Release notes for NSS 3.79.1\n\t[89171864de68] \u003cNSS_3_79_1_BRANCH\u003e\n\n2022-08-18  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/util/secasn1d.c, lib/util/secasn1e.c:\n\tBug 1330271 - check for null template in sec_asn1{d,e}_push_state. r\n\t=nss-reviewers,djackson\n\n\tSome of our dynamic template choosers, e.g.\n\tsec_pkcs12_choose_attr_type, can return NULL. This patch adds some\n\tdefensive checks to avoid crashes when they do.\n\n\t[d42c5a1bfe5a] \u003cNSS_3_79_1_BRANCH\u003e\n\n2022-06-06  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/softoken/sftkdb.c, lib/softoken/sftkpwd.c:\n\tBug 1760998 - avoid data race on primary password change. r=rrelyea\n\n\t[2c290cd6b08d] \u003cNSS_3_79_1_BRANCH\u003e\n\n2022-06-08  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/softoken/pkcs11.c, lib/softoken/pkcs11i.h:\n\tBug 1759794 - protect SFTKSlot needLogin with slotLock. r=rrelyea\n\n\t[0827dca35888] \u003cNSS_3_79_1_BRANCH\u003e\n\n2022-06-06  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/certdb/certdb.c, lib/certdb/certv3.c, lib/certdb/certxutl.c,\n\tlib/crmf/cmmfrec.c:\n\tBug 1771498 - Uninitialized value in cert_ComputeCertType.\n\tr=djackson\n\n\t[890df0aa8baf] \u003cNSS_3_79_1_BRANCH\u003e\n\n2022-06-07  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/certhigh/certvfy.c, lib/util/SECerrs.h, lib/util/secerr.h:\n\tBug 1366464 - compare signature and signatureAlgorithm fields in\n\tlegacy certificate verifier. r=rrelyea\n\n\t[b6b18d0259e7] \u003cNSS_3_79_1_BRANCH\u003e\n\n2022-08-18  Anna Weine  \u003canna.weine@mozilla.com\u003e\n\n\t* .hgtags:\n\tAdded tag NSS_3_79_1_BETA1 for changeset 50b1502dc601\n\t[4186188d7de4] \u003cNSS_3_79_1_BRANCH\u003e\n\n2022-05-25  Kai Engert  \u003ckaie@kuix.de\u003e\n\n\t* automation/release/nspr-version.txt:\n\tBug 1769302 - NSS 3.79 should depend on NSPR 4.34. r=bbeurdouche\n\n\t[50b1502dc601] [NSS_3_79_1_BETA1] \u003cNSS_3_79_BRANCH\u003e\n\n2022-05-31  Dennis Jackson  \u003cdjackson@mozilla.com\u003e\n\n\t* doc/rst/releases/index.rst, doc/rst/releases/nss_3_79.rst:\n\tRelease notes for NSS 3.79\n\t[5b675d89f013] \u003cNSS_3_79_BRANCH\u003e\n\n2022-05-26  Dennis Jackson  \u003cdjackson@mozilla.com\u003e\n\n\t* .hgtags:\n\tAdded tag NSS_3_79_RTM for changeset 3463596523be\n\t[a842dc16c5a6] \u003cNSS_3_79_BRANCH\u003e\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D154991", "files": ["build/moz.configure/nss.configure", "security/nss/TAG-INFO", "security/nss/automation/release/nspr-version.txt", "security/nss/coreconf/coreconf.dep", "security/nss/doc/rst/releases/index.rst", "security/nss/doc/rst/releases/nss_3_79.rst", "security/nss/doc/rst/releases/nss_3_79_1.rst", "security/nss/lib/certdb/certdb.c", "security/nss/lib/certdb/certv3.c", "security/nss/lib/certdb/certxutl.c", "security/nss/lib/certhigh/certvfy.c", "security/nss/lib/crmf/cmmfrec.c", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/pkcs11.c", "security/nss/lib/softoken/pkcs11i.h", "security/nss/lib/softoken/sftkdb.c", "security/nss/lib/softoken/sftkpwd.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/SECerrs.h", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/secasn1d.c", "security/nss/lib/util/secasn1e.c", "security/nss/lib/util/secerr.h"], "git_node": null, "git_parents": [null], "node": "739a8337e2d1a8acb4263dfaefba6ffdd54d163e", "parents": ["c3f360bdd275e22a40d35ac0deadeee1380fcea9"], "tags": []}], "date": 1660839797, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "62": {"changesets": [{"author": "Kai Engert \u003ckaie@kuix.de\u003e", "branch": "default", "desc": "Bug 1785788 - Gracefully handle null nickname in CERT_GetCertNicknameWithValidity. r=rrelyea, a=RyanVM UPGRADE_NSS_RELEASE", "files": ["security/nss/lib/certhigh/certvfy.c"], "git_node": null, "git_parents": [null], "node": "3876d5327f44c991c9034c4112f33f147ab10ab9", "parents": ["739a8337e2d1a8acb4263dfaefba6ffdd54d163e"], "tags": ["FIREFOX_102_2_0esr_BUILD2", "FIREFOX_102_2_0esr_RELEASE"]}], "date": 1660841883, "git_changesets": [null], "user": "ryanvm@gmail.com"}}
}";