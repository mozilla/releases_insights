0db418e3b03ab4b6f8b8014dc68", "parents": ["77b807c33cdda8e56688bcf4e2a78fabaebdad72"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1074765 - Use greater weight for nearer sample in PeriodicWave interpolation. r=rillian, a=abillings", "files": ["content/media/webaudio/OscillatorNode.cpp"], "git_node": null, "git_parents": [null], "node": "4e5404763aba54edf98ca0988c8cb2d1e8ad2818", "parents": ["47e59b5dbcd0b0db418e3b03ab4b6f8b8014dc68"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 1012609 - Improve PeriodicWave phase-wrapping logic. r=rillian, a=abillings\n\nThis approach takes advantage of the fact that periodicWaveSize is a power of\n2 and uses unsigned integer modulo arithmetic to find the appropriate phase\nof the period.", "files": ["content/media/webaudio/OscillatorNode.cpp"], "git_node": null, "git_parents": [null], "node": "8c431dcec0ffde13988d47eacf341113ea883245", "parents": ["4e5404763aba54edf98ca0988c8cb2d1e8ad2818"], "tags": []}], "date": 1412255900, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "79": {"changesets": [{"author": "Ralph Giles \u003cgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 1063327 - Reject vp9 frames with invalid tiles. r=kinetik, a=abillings", "files": ["media/libvpx/vp9/decoder/vp9_decodframe.c"], "git_node": null, "git_parents": [null], "node": "6023f0b4f8ba49dd117106cc98cd8007c2142bf6", "parents": ["8c431dcec0ffde13988d47eacf341113ea883245"], "tags": []}], "date": 1412279169, "git_changesets": [null], "user": "rgiles@mozilla.com"}, "80": {"changesets": [{"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1072044 - Fire ICE signals on main. r=mt, a=bkerensa", "files": ["media/webrtc/signaling/src/peerconnection/PeerConnectionImpl.cpp", "media/webrtc/signaling/src/peerconnection/PeerConnectionImpl.h", "media/webrtc/signa