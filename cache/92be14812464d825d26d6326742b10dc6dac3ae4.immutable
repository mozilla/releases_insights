"pushes": {"111": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 49e746f805bd2d0c6a18e9db2df6ccbac0242eae with FIREFOX_128_2_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "c85775008c5b6594c412b25b92fe44688c6e6251", "parents": ["49e746f805bd2d0c6a18e9db2df6ccbac0242eae"], "tags": []}], "date": 1724682877, "git_changesets": [null], "user": "ffxbld"}, "112": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "71ce48dbcace14e273689b1bfdb288bc95a00e31", "parents": ["c85775008c5b6594c412b25b92fe44688c6e6251"], "tags": []}], "date": 1725283769, "git_changesets": [null], "user": "ffxbld-merge"}, "113": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 49e746f805bd2d0c6a18e9db2df6ccbac0242eae with FIREFOX_128_2_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "daba74eb832411984801e2be4f9f4e0705987ea6", "parents": ["71ce48dbcace14e273689b1bfdb288bc95a00e31"], "tags": []}], "date": 1725367692, "git_changesets": [null], "user": "ffxbld"}, "114": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220797", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "00ae8ffcb7c611476d60279ee02a2901f80edd46", "parents": ["daba74eb832411984801e2be4f9f4e0705987ea6"], "tags": []}], "date": 1725383783, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "115": {"changesets": [{"author": "Calixte \u003ccdenizet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907000 - Allow e.g. /FitH destinations without additional parameter  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217266\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220922", "files": ["toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs"], "git_node": null, "git_parents": [null], "node": "220016d15726156b32c339ada8aef95d53eecef4", "parents": ["00ae8ffcb7c611476d60279ee02a2901f80edd46"], "tags": []}, {"author": "Calixte \u003ccdenizet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1879035 - Disable existing highlights when drawing a new one in the pdf viewer  a=diannaS\n\nDepends on D220922\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220923", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/web/viewer.css"], "git_node": null, "git_parents": [null], "node": "19c5a8cc638ee531276ffa44d65285645e32b1fe", "parents": ["220016d15726156b32c339ada8aef95d53eecef4"], "tags": []}, {"author": "Calixte \u003ccdenizet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1879104 - Make editor toolbars usable whatever their z-index in the pdf viewer  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217268\n\nDepends on D220923\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220924", "files": ["toolkit/components/pdfjs/content/web/viewer.css"], "git_node": null, "git_parents": [null], "node": "a815693fabd24126ca550fe5e39dca3fca0e82d9", "parents": ["19c5a8cc638ee531276ffa44d65285645e32b1fe"], "tags": []}], "date": 1725396051, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "116": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1715248 - include upload-symbols tasks in desktop release promotion. r=releng-reviewers,taskgraph-reviewers,gbrown a=release\n\nUsually, upload-symbols tasks run as part of the on-push graph; however, if a\npush only touches platform-specific code, builds for other platforms may get\noptimized out, along with the corresponding upload-symbols tasks.  If release\npromotion is triggered on such a push, we may end up shipping builds whose\nsymbols are missing from the symbols server, affecting downstream consumers\nlike crash-stats.  To avoid this, ensure beetmover jobs (as an arbitrary\nchoice) pull in the upload-symbols tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219768", "files": ["taskcluster/gecko_taskgraph/transforms/beetmover_repackage.py", "taskcluster/kinds/beetmover-repackage/kind.yml"], "git_node": null, "git_parents": [null], "node": "d05558ffaa0dff15407e49c610edea45a45d835a", "parents": ["a815693fabd24126ca550fe5e39dca3fca0e82d9"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1715248 - add dependency on upload-symbols to beetmover-geckoview tasks. r=releng-reviewers,gbrown a=release\n\nUploading debug symbols to the symbols server is arguably part of shipping a\nbuild.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219840", "files": ["taskcluster/kinds/beetmover-geckoview/kind.yml"], "git_node": null, "git_parents": [null], "node": "e5a66f359408df4b08b749fb3bfc638807c5d571", "parents": ["d05558ffaa0dff15407e49c610edea45a45d835a"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 1775918 - Fix intermittent failure in browser/components/search/test/browser/browser_searchbar_enter.js. r=search-reviewers,Standard8, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220574", "files": ["browser/components/search/test/browser/browser_searchbar_enter.js"], "git_node": null, "git_parents": [null], "node": "bb1d36dc64d30e71bbc2b7e1c3fb949fd5e40de3", "parents": ["e5a66f359408df4b08b749fb3bfc638807c5d571"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1916191 - remove lineno from .toml file. r=tjr a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220800", "files": ["browser/components/resistfingerprinting/test/browser/browser.toml"], "git_node": null, "git_parents": [null], "node": "ae2e0a280f2c681f0df7d888e5d07ff08c5361f6", "parents": ["bb1d36dc64d30e71bbc2b7e1c3fb949fd5e40de3"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1894709 - [devtools] Fix browser_rules_pseudo-element_01.js intermittent. r=devtools-reviewers,jdescottes. a=test-only\n\nWait until the backdrop rule is being displayed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217928", "files": ["devtools/client/inspector/rules/test/browser_rules_pseudo-element_01.js"], "git_node": null, "git_parents": [null], "node": "44e30ad993bb43367bbdb47aea8066ed9e826e61", "parents": ["ae2e0a280f2c681f0df7d888e5d07ff08c5361f6"], "tags": []}], "date": 1725409358, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "117": {"changesets": [{"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1912074 - Add more validity checks  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218776\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220959", "files": ["toolkit/components/alerts/moz.build", "toolkit/components/alerts/test/browser.toml", "toolkit/components/alerts/test/browser/browser.toml", "toolkit/components/alerts/test/browser/browser_bug1682866.js", "toolkit/components/alerts/test/browser/file_bug1682866.html", "toolkit/components/alerts/test/browser_bug1682866.js", "toolkit/components/alerts/test/chrome/chrome.toml", "toolkit/components/alerts/test/chrome/empty.html", "toolkit/components/alerts/test/chrome/image.gif", "toolkit/components/alerts/test/chrome/image.png", "toolkit/components/alerts/test/chrome/image_server.sjs", "toolkit/components/alerts/test/chrome/test_alerts.html", "toolkit/components/alerts/test/chrome/test_alerts_noobserve.html", "toolkit/components/alerts/test/chrome/test_alerts_requireinteraction.html", "toolkit/components/alerts/test/chrome/test_image.html", "toolkit/components/alerts/test/chrome/test_invalid_utf16.html", "toolkit/components/alerts/test/chrome/test_multiple_alerts.html", "toolkit/components/alerts/test/chrome/test_principal.html", "toolkit/components/alerts/test/file_bug1682866.html", "toolkit/components/alerts/test/image.gif", "toolkit/components/alerts/test/image.png", "toolkit/components/alerts/test/image_server.sjs", "toolkit/components/alerts/test/mochitest.toml", "toolkit/components/alerts/test/test_alerts.html", "toolkit/components/alerts/test/test_alerts_noobserve.html", "toolkit/components/alerts/test/test_alerts_requireinteraction.html", "toolkit/components/alerts/test/test_image.html", "toolkit/components/alerts/test/test_invalid_utf16.html", "toolkit/components/alerts/test/test_multiple_alerts.html", "toolkit/components/alerts/test/test_principal.html", "widget/windows/ToastNotificationHandler.cpp"], "git_node": null, "git_parents": [null], "node": "0c7d42681e001c418f9cd1462761e192d456fcf1", "parents": ["44e30ad993bb43367bbdb47aea8066ed9e826e61"], "tags": []}], "date": 1725411043, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "118": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1911571 - Extend necko tests, r=jmaher,ci-and-tooling a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219533", "files": ["taskcluster/kinds/test/variants.yml"], "git_node": null, "git_parents": [null], "node": "710f16e5f68c9f838554a8180616b3c52228e4f8", "parents": ["0c7d42681e001c418f9cd1462761e192d456fcf1"], "tags": []}, {"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 1915540 - addressing ESlint test failure. r=dsmith", "files": [".eslintrc-rollouts.js"], "git_node": null, "git_parents": [null], "node": "e707e7e6c9e9a79dc56162a7b6aba4bb4239ec35", "parents": ["710f16e5f68c9f838554a8180616b3c52228e4f8"], "tags": []}], "date": 1725417800, "git_changesets": [null, null], "user": "nfay@mozilla.com"}, "119": {"changesets": [{"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 1760806 - WebCrypto: ECDH and ECDSA JWK import to check that the crv in params and crv in alg are the same  a=diannaS\n\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=ed7936b105dea8e588650feb6baf26a50a6439fc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D217273\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220783", "files": ["dom/crypto/WebCryptoTask.cpp", "dom/crypto/test/test-vectors.js", "dom/crypto/test/test_WebCrypto_ECDH.html", "dom/crypto/test/test_WebCrypto_ECDSA.html"], "git_node": null, "git_parents": [null], "node": "2416fd1777b26e9340aff223c776edb6ff2cec97", "parents": ["e707e7e6c9e9a79dc56162a7b6aba4bb4239ec35"], "tags": []}], "date": 1725476610, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "120": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1901769 - Remove unused after_pointer popup position. r=layout-reviewers,jfkthame, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217934", "files": ["layout/xul/nsMenuPopupFrame.cpp", "toolkit/content/tests/chrome/popup_trigger.js", "toolkit/content/tests/widgets/popup_shared.js"], "git_node": null, "git_parents": [null], "node": "f45d2d28031d6f6a6f9082a4a96b34d6292c5470", "parents": ["2416fd1777b26e9340aff223c776edb6ff2cec97"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1901769 - Add some braces in nsMenuPopupFrame::MoveToAttributePosition. r=layout-reviewers,jfkthame, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217935", "files": ["layout/xul/nsMenuPopupFrame.cpp"], "git_node": null, "git_parents": [null], "node": "2142781397eb460fcb6a49ec0911fe6a73cd7988", "parents": ["f45d2d28031d6f6a6f9082a4a96b34d6292c5470"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1912374 - Account for RTL when moving to a point. r=stransky, a=dsmith\n\nWe flip the position / anchor alignment on rtl, so we have to choose\ndifferent resets there to end up at the requested position.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D219665", "files": ["layout/xul/nsMenuPopupFrame.cpp"], "git_node": null, "git_parents": [null], "node": "927837081d962926f7452d727eae04dfcfb6707e", "parents": ["2142781397eb460fcb6a49ec0911fe6a73cd7988"], "tags": []}], "date": 1725484512, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "121": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221124", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "173d04dae3e42137910aaf8e4b0f471bfac8c3d1", "parents": ["927837081d962926f7452d727eae04dfcfb6707e"], "tags": []}], "date": 1725537679, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "122": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1899491 - correctly handle pasting an empty string for DLP  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D212961\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221143", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/browser/browser_clipboard_paste_inputandtextarea_content_analysis.js"], "git_node": null, "git_parents": [null], "node": "acf90d4ecf8c36cc75b313003102b2d1262b6d4f", "parents": ["173d04dae3e42137910aaf8e4b0f471bfac8c3d1"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1900798 - go back to async \"DLP blocked\" dialog for print preview  a=diannaS\n\nA new attempt to fix these problems - always use asynchronous dialogs, but in the print preview case show the \"DLP blocked\" dialog on the original browsingContext that displayed the print preview dialog (since the dialog itself is about to close)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D212815\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221144", "files": ["browser/components/contentanalysis/content/ContentAnalysis.sys.mjs"], "git_node": null, "git_parents": [null], "node": "9d89486fff1ddfa1889aea333d3559aa04e5b103", "parents": ["acf90d4ecf8c36cc75b313003102b2d1262b6d4f"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1754759 - remove modal state from tab when moving to new window  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D213156\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221145", "files": ["browser/actors/PromptParent.sys.mjs", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_replacewithwindow_dialog.js", "browser/components/tabbrowser/test/browser/tabs/tab_that_opens_dialog.html"], "git_node": null, "git_parents": [null], "node": "25025c12a9f49b5952abc120bd13c96d6e1c1564", "parents": ["9d89486fff1ddfa1889aea333d3559aa04e5b103"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902969 - cancel DLP request when warn dialog is moved to new window  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D213998\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221146", "files": ["browser/components/contentanalysis/content/ContentAnalysis.sys.mjs"], "git_node": null, "git_parents": [null], "node": "71390dbcce6f70946dcccfeac79131642177b622", "parents": ["25025c12a9f49b5952abc120bd13c96d6e1c1564"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1901197: do synchronous Content Analysis for clipboard operations on a background thread r=nika a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215457\n# Conflicts:\n#\tdom/ipc/ContentParent.h\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221147", "files": ["build/clang-plugin/ThreadAllows.txt", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "ipc/ipdl/sync-messages.ini", "widget/ClipboardContentAnalysisChild.cpp", "widget/ClipboardContentAnalysisChild.h", "widget/ClipboardContentAnalysisParent.cpp", "widget/ClipboardContentAnalysisParent.h", "widget/PClipboardContentAnalysis.ipdl", "widget/moz.build", "widget/nsClipboardProxy.cpp"], "git_node": null, "git_parents": [null], "node": "b3f8dd60edf74c162a8254eddce5d19aae6f24d1", "parents": ["71390dbcce6f70946dcccfeac79131642177b622"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1906742: Remove concurrency from ClipboardContentAnalysisParent  a=diannaS\n\nUses a normal boolean on the agent backround thread instead of\ncommunicating concurrently with a std::atomic\u003cbool\u003e.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215976\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221148", "files": ["widget/ClipboardContentAnalysisParent.cpp"], "git_node": null, "git_parents": [null], "node": "8e780905c37c3abb673e49cd8b33678bd67da77b", "parents": ["b3f8dd60edf74c162a8254eddce5d19aae6f24d1"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907303 - make Content Analysis check native clipboard format as well  a=diannaS\n\n- Check for native Windows clipboard format (kNativeHTMLMime) as well as plain text and HTML\n- Make CheckClipboardContentAnalysisAsText() check for nsISupportsCString as well as nsISupportsString, as the kNativeHTMLMime format uses nsISupportsCString.\n- Update test to correctly check pasting when copying from Firefox - if allowPaste is false, the paste should not happen. This test was wrong before this change and would have shown this problem if it had been correct.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216358\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221149", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/browser/browser_clipboard_content_analysis.js"], "git_node": null, "git_parents": [null], "node": "6bbd42968244bc4707bb8a9fd72cc5acac794b7e", "parents": ["8e780905c37c3abb673e49cd8b33678bd67da77b"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907466 - make some thread-safety changes for clipboard content analysis  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216608\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221150", "files": ["dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h", "widget/ClipboardContentAnalysisChild.cpp", "widget/ClipboardContentAnalysisChild.h", "widget/ClipboardContentAnalysisParent.cpp", "widget/ClipboardContentAnalysisParent.h", "widget/nsClipboardProxy.cpp"], "git_node": null, "git_parents": [null], "node": "4e194b94534cd3931ebe79d2a9cb6b33565cc0c6", "parents": ["6bbd42968244bc4707bb8a9fd72cc5acac794b7e"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1886604: Part 1: Add JS-scriptable MockDragService  a=diannaS\n\nIntroduces MockDragService as a subclass/implementation of nsBaseDragService.\nThis class is based on the Windows implementation of nsBaseDragService.  The\nservice is created with a MockDragServiceController that JS can use to\ninitiate drag events that would normally come from the system.  Native\ndrag-and-drop is not permitted in automation because it puts the browser into\na state where, if anything goes wrong (e.g. a test failure), it cannot be\nkilled without manual intervention.  This allows us to avoid that limitation\nwhile still testing most of the browser's drag-and-drop behavior, including\nthe (substantial and complex) nsBaseDragService base-class that is common to\nall platforms.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205640\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221151", "files": ["dom/events/EventStateManager.cpp", "widget/MockDragServiceController.cpp", "widget/MockDragServiceController.h", "widget/moz.build", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsIDragService.idl", "widget/nsIMockDragServiceController.idl"], "git_node": null, "git_parents": [null], "node": "6d39164c72993ce9d614db729065ba982c82777b", "parents": ["4e194b94534cd3931ebe79d2a9cb6b33565cc0c6"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1886604: Part 2: Add synthesizeMockDragAndDrop  a=diannaS\n\nAdd synthesizeMockDragAndDrop test function to test elements\ndrag-dropped inside of Firefox.  This uses the new MockDragService to\navoid native DND.  It is a more-complete variant of synthesizeDragAndDrop\nand synthesizePlainDragAndDrop.  It works by:\n\n1. Creating the environment for the test.\n2. Gathering coordinates of the source and target elements from their\nrespective content processes.\n3. Setting up event handlers on the elements to detect any relevant events\nthey may receive.  This allows us to detect not only events that aren't sent\nwhen they should be but also events that are sent that shouldn't be.\n4. Synthesizing mouse events to initiate the drag-session.  This and\nthe remaining steps work by first telling the relevant content process(es)\nwhat events to expect (and which not to), then sending the event, and\nfinally collecting the results and submitting them to mochitest.\n5. Synthesizing drag events with the MockDragServiceController, to emulate\nthe behavior of (Windows) native drag-and-drop.  This is a coarse\napproximation of the Win32 API DoDragDrop.\n6. Cleaning up the event handlers.\n\nThe test does not yet try to mock things like the drag cursor image, although\nthat should be possible without native DND behavior.  The same is true for\nsome more minor aspects of the platform-specific behavior of our DND.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205641\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221152", "files": ["dom/ipc/BrowserParent.cpp", "testing/mochitest/moz.build", "testing/mochitest/tests/SimpleTest/DragChildContextBase.sys.mjs", "testing/mochitest/tests/SimpleTest/DragParentContextBase.sys.mjs", "testing/mochitest/tests/SimpleTest/DragSourceChildContext.sys.mjs", "testing/mochitest/tests/SimpleTest/DragSourceParentContext.sys.mjs", "testing/mochitest/tests/SimpleTest/DragTargetChildContext.sys.mjs", "testing/mochitest/tests/SimpleTest/DragTargetParentContext.sys.mjs", "testing/mochitest/tests/SimpleTest/EventUtils.js", "testing/mochitest/tests/SimpleTest/moz.build"], "git_node": null, "git_parents": [null], "node": "b88ba3de26027a39ee2be955c8269121463b9eb2", "parents": ["6d39164c72993ce9d614db729065ba982c82777b"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1886604: Part 3: Test drag and drop events between windows and iframes  a=diannaS\n\nTest of basic DND functionality between content pages of different domains,\nusing the MockDragService.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D205642\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221153", "files": ["dom/events/test/browser.toml", "dom/events/test/browser_dragdrop.js", "dom/events/test/browser_dragdrop_inner.html", "dom/events/test/browser_dragdrop_outer.html"], "git_node": null, "git_parents": [null], "node": "53733387f5cc251a87ce77304be3080014dcc241", "parents": ["b88ba3de26027a39ee2be955c8269121463b9eb2"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 1 - Add widget/window parameter to nsIDragService::GetCurrentSession  a=diannaS\n\nWe will need this to get the correct drag session in content when there are\nmultiple choices, and as a sanity check elsewhere.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D215033\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221154", "files": ["widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsIDragService.idl"], "git_node": null, "git_parents": [null], "node": "954312aea049945eb2a07b1d94c4ea3ae01cb7d8", "parents": ["53733387f5cc251a87ce77304be3080014dcc241"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 2 - Make C++ callers of nsIDragService::GetCurrentSession pass a widget  a=diannaS\n\nContent process callers must call nsIDragService::GetCurrentSession with the\ncorrect widget under the drag.  For all callers, it is a sanity check.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211065\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221155", "files": ["dom/events/EventStateManager.cpp", "layout/xul/nsXULTooltipListener.cpp", "widget/MockDragServiceController.cpp", "widget/android/nsWindow.cpp", "widget/cocoa/nsChildView.mm", "widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "f5d56d81d2ac849eb14878120c07fccaf2a80b04", "parents": ["954312aea049945eb2a07b1d94c4ea3ae01cb7d8"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 3 - Add widget to nsContentUtils::GetDragSession  a=diannaS\n\nUpdates each client of the nsContentUtils method to get the right drag session -- the one for the widget that is currently the source or target of the drag session.\nThe change to nsDOMWindowUtils::DispatchDOMEventViaPresShellForTesting() supports the change to WidgetDragEvent::InitDropEffectForTests() and enabled a\nlarge number of test fixes in the next patch.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211067\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221156", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/nsDOMWindowUtils.cpp", "dom/events/EventStateManager.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentParent.cpp", "editor/libeditor/EditorBase.cpp", "layout/base/PresShell.cpp", "layout/forms/nsTextControlFrame.cpp", "widget/WidgetEventImpl.cpp", "widget/nsBaseWidget.cpp"], "git_node": null, "git_parents": [null], "node": "1f75f31465425ea9f2a051f2ebd9ae52b7e92579", "parents": ["f5d56d81d2ac849eb14878120c07fccaf2a80b04"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 4 - DataTransfer operations that require a drag must use a widget  a=diannaS\n\nDataTransfer methods that use a drag session should get the one for the \"correct\" widget.  This is especially important in content processes, especially especially since the DataTransfer can be used long after a related drag session completes.  We use the widget associated with the DataTransfer's owner.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211066\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221157", "files": ["dom/events/DataTransfer.cpp", "dom/events/DataTransfer.h", "dom/events/DataTransferItem.cpp"], "git_node": null, "git_parents": [null], "node": "94978507d843c3df2fe5e70430c0b60de2ba008b", "parents": ["1f75f31465425ea9f2a051f2ebd9ae52b7e92579"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 5 - Fix coordinates use in dispatchDOMEventViaPresShellForTesting  a=diannaS\n\nSince we now add the widget to the event in\ndispatchDOMEventViaPresShellForTesting, WidgetGUIEvents that are sent in\nmochitests via that method need to transform their screen coordinates by\nnsIWidget::WidgetToScreenOffset, to mirror the transformation by\nBrowserParent::TransformParentToChild that they don't get because they\nskip the parent process.\n\nThis exposes a bunch of things that were done to work around this bug.  They\nare cleaned up here.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211068\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221158", "files": ["browser/components/places/tests/browser/browser_toolbar_drop_bookmarklet.js", "browser/components/tabbrowser/test/browser/tabs/head.js", "dom/base/nsDOMWindowUtils.cpp", "dom/events/test/test_drag_coords.html", "editor/libeditor/tests/test_dragdrop.html", "testing/mochitest/tests/SimpleTest/EventUtils.js"], "git_node": null, "git_parents": [null], "node": "55d6419322b285ad79df15e784f261147cfd1eb4", "parents": ["94978507d843c3df2fe5e70430c0b60de2ba008b"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 6 - Make JS clients of nsIDragService::GetCurrentSession use a (implicit) window  a=diannaS\n\nGetCurrentSession now needs to know the widget to return the drag\nsession in content processes.  It now uses an explicitly provided\nwindow or the entry global JS context (that must be a window).\n\nThis also adds GetDragSession to DOMWindowUtils, and fixes some small\nbugs in EventUtils.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211064\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221159", "files": ["browser/components/places/content/controller.js", "dom/base/nsDOMWindowUtils.cpp", "dom/interfaces/base/nsIDOMWindowUtils.idl", "remote/marionette/interaction.sys.mjs", "testing/mochitest/tests/SimpleTest/DragChildContextBase.sys.mjs", "testing/mochitest/tests/SimpleTest/DragSourceChildContext.sys.mjs", "testing/mochitest/tests/SimpleTest/EventUtils.js", "toolkit/modules/SubDialog.sys.mjs", "toolkit/mozapps/extensions/test/browser/browser_dragdrop.js", "widget/nsIDragService.idl"], "git_node": null, "git_parents": [null], "node": "1831bda84f4623083481884b60550c2bec40c914", "parents": ["55d6419322b285ad79df15e784f261147cfd1eb4"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 7 - Access sourceNode on nsIDragSession instead of nsIDragService  a=diannaS\n\nA small fix to existing code that used the service where it should have\nused the session.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211071\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221160", "files": ["testing/mochitest/tests/SimpleTest/EventUtils.js"], "git_node": null, "git_parents": [null], "node": "75e3b4851f6baf9e2b17bff3533dc5c8275c9a0a", "parents": ["1831bda84f4623083481884b60550c2bec40c914"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 8 - Prepare for nsBaseDragSession to be broken out of nsBaseDragService  a=diannaS\n\nCreates the nsBaseDragSession class and moves nsIDragSession's methods and data\ninto it.  This patch also does this for each platform-specific nsDragService\nand the nsDragServiceProxy.  The result is that the drag service and drag\nsession are still one object in both the main and child processes, and the\ninheritance diagram for each platform implementation goes from its present\nfrom:\n\nnsDragService -\u003e nsBaseDragService -\u003e nsIDragService + nsIDragSession\n\nto:\n\nnsDragService -\u003e nsDragSession -\u003e nsBaseDragService -\u003e nsIDragService + nsBaseDragSession -\u003e nsIDragSession\n\n(and similar for the nsDragServiceProxy).\n\nAt the end of this patch series, the objects will be separated and the\ninheritance diagram will be as expected:\n\nnsDragService -\u003e nsBaseDragService -\u003e nsIDragService\n\nnsDragSession -\u003e nsBaseDragSession -\u003e nsIDragSession\n\nThere are no substantive changes here -- it's essentially all cut\nand paste to prepare to smoothly sever the unwanted inheritance.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211072\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221161", "files": ["widget/android/nsDragService.cpp", "widget/android/nsDragService.h", "widget/cocoa/nsChildView.mm", "widget/cocoa/nsDragService.h", "widget/cocoa/nsDragService.mm", "widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsDragServiceProxy.h", "widget/windows/nsDragService.cpp", "widget/windows/nsDragService.h", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "3258de22c9bdee1dc5a85aeedd7da4ffcd0f7a9d", "parents": ["75e3b4851f6baf9e2b17bff3533dc5c8275c9a0a"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 9 - Move additional parts of nsIDragService to nsIDragSession  a=diannaS\n\nMoving additional methods and fields.  No substantive changes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211073\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221162", "files": ["widget/android/nsDragService.cpp", "widget/cocoa/nsChildView.mm", "widget/cocoa/nsDragService.mm", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "2c167a762871e4d1d62854be7ff3dbf7c3a3b8ee", "parents": ["3258de22c9bdee1dc5a85aeedd7da4ffcd0f7a9d"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 10 - Move MaybeEditorDeletedSourceNode from nsIDragService to nsIDragSession  a=diannaS\n\nMaybeEditorDeletedSourceNode was defined on nsIDragService but is more appropriately defined on nsIDragSession.  This was not an issue previously since those were the same object.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211074\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221163", "files": ["editor/libeditor/EditorBase.cpp", "widget/nsBaseDragService.cpp", "widget/nsIDragService.idl", "widget/nsIDragSession.idl"], "git_node": null, "git_parents": [null], "node": "ccf869e73000bd2ff21b4e2336b4d1df9385f7b6", "parents": ["2c167a762871e4d1d62854be7ff3dbf7c3a3b8ee"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 11 - Add widget to nsIDragService::InvokeDragSession and friends  a=diannaS\n\nThis also moves InvokeDragSession from an IDL to a private one.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211075\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221164", "files": ["widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsIDragService.idl"], "git_node": null, "git_parents": [null], "node": "b461b84653d2d226d5b954a1cc699b845fd10c5b", "parents": ["ccf869e73000bd2ff21b4e2336b4d1df9385f7b6"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 12 - Move DragMoved from nsIDragService to nsIDragSession  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211076\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221165", "files": ["widget/cocoa/nsChildView.mm", "widget/cocoa/nsDragService.h", "widget/cocoa/nsDragService.mm", "widget/nsBaseDragService.cpp", "widget/nsIDragService.idl", "widget/nsIDragSession.idl", "widget/windows/nsNativeDragSource.cpp"], "git_node": null, "git_parents": [null], "node": "495ca2baba0d7ca0aff2104730fd2e32d5df910b", "parents": ["b461b84653d2d226d5b954a1cc699b845fd10c5b"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 13 - Move FireDragEventAtSource from nsIDragService to nsIDragSession  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211077\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221166", "files": ["dom/ipc/BrowserChild.cpp", "widget/MockDragServiceController.cpp", "widget/android/nsWindow.cpp", "widget/cocoa/nsChildView.mm", "widget/gtk/nsDragService.cpp", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsIDragService.idl", "widget/nsIDragSession.idl", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "36cdfd7c2aab4c738760d19691ee31c7c37016e5", "parents": ["495ca2baba0d7ca0aff2104730fd2e32d5df910b"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 14 - Move SetDragEndPoint from nsBaseDragService to nsIDragSession  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211078\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221167", "files": ["dom/ipc/ContentChild.cpp", "widget/MockDragServiceController.cpp", "widget/android/nsWindow.cpp", "widget/cocoa/nsChildView.mm", "widget/gtk/nsDragService.cpp", "widget/nsBaseDragService.cpp", "widget/nsIDragSession.idl", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "a8096307656a27790c7dd09c1f296e62786b140b", "parents": ["36cdfd7c2aab4c738760d19691ee31c7c37016e5"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 15 - Give StartDragSessionForTests a window to start the drag session on  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211079\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221168", "files": ["browser/components/customizableui/test/browser_1003588_no_specials_in_panel.js", "browser/components/customizableui/test/browser_962069_drag_to_overflow_chevron.js", "dom/events/test/test_bug508479.html", "layout/base/tests/test_bug603550.html", "layout/xul/test/browser_bug706743.js", "testing/mochitest/tests/SimpleTest/EventUtils.js", "toolkit/mozapps/extensions/test/browser/browser_dragdrop.js", "widget/nsBaseDragService.cpp", "widget/nsIDragService.idl"], "git_node": null, "git_parents": [null], "node": "d8018c548ed6290e75fe0fadedbe1aced9ddaa25", "parents": ["a8096307656a27790c7dd09c1f296e62786b140b"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 16 - Make nsBaseDragService weakly remember PBrowsers instead of PContents  a=diannaS\n\nnsBaseDragService keeps track of the processes that might need to cancel a drag with EndDragSession and this is technically correct since the drag session is a singleton in the child process, but this series of patches changes those sessions to be per-PuppetWidget/BrowserChild.  This allows content processes to distinguish which of its browsers is engaged in a drag.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211062\n# Conflicts:\n#\tdom/ipc/ContentParent.h\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221169", "files": ["dom/events/DataTransfer.h", "dom/events/EventStateManager.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PBrowser.ipdl", "dom/ipc/PContent.ipdl", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsIDragService.idl"], "git_node": null, "git_parents": [null], "node": "2cd1c5abfbc71dab7ba7b5f2ca9eb6e596021f99", "parents": ["d8018c548ed6290e75fe0fadedbe1aced9ddaa25"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 17 - Pass the widget to StartDragSession  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211080\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221170", "files": ["dom/ipc/BrowserChild.cpp", "widget/MockDragServiceController.cpp", "widget/android/nsDragService.cpp", "widget/android/nsDragService.h", "widget/android/nsWindow.cpp", "widget/cocoa/nsChildView.mm", "widget/cocoa/nsDragService.h", "widget/cocoa/nsDragService.mm", "widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsDragServiceProxy.cpp", "widget/nsDragServiceProxy.h", "widget/nsIDragService.idl", "widget/windows/nsDragService.cpp", "widget/windows/nsDragService.h", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "11285edf00ffbdf0ccbb49b8ba1b58d893bea7ee", "parents": ["2cd1c5abfbc71dab7ba7b5f2ca9eb6e596021f99"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 18 - Copy/Move MaybeAddBrowser, RemoveAllBrowsers and MustUpdateDataTransfer from nsIDragService to nsIDragSession  a=diannaS\n\nMustUpdateDataTransfer is a simple function that makes more sense on\nnsIDragSession.\n\nMaybeAddBrowser records BrowserParents for processes with existing drag\nsessions.  There may be such processes before the parent process\neven has a drag session, so they cannot be tied to drag sessions.  We tie\nthem to the drag service, until the service creates a drag session in\nthe process, at which point we move them to the drag session.  Since\nthe session and service are still the same object and each now has methods\nwith these names, we leave part of session's implementation commented out\nso that we run correctly instead of looping infinitely.  The code is\nexposed when the objects separate later in the patch series.\n\nFinally, the implementation of TakeSessionBrowserListFromService currently\namounts to a nop, but it will have substace when the service and session\nare separated.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211081\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221171", "files": ["dom/ipc/BrowserParent.cpp", "widget/android/nsDragService.cpp", "widget/android/nsDragService.h", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsIDragService.idl", "widget/nsIDragSession.idl"], "git_node": null, "git_parents": [null], "node": "54b307ef91058822b2313c0f073d359289e8d65b", "parents": ["11285edf00ffbdf0ccbb49b8ba1b58d893bea7ee"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 19 - Make WindowWatcher call EndDragSession on session object  a=diannaS\n\nCreateChromeWindow creates windows in the parent process.  EndDragSession is\nmoving to the drag session, so call it on the paren't session, if one exists.\nNote that this patch will not build without the next one.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211082\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221172", "files": ["toolkit/components/windowwatcher/nsWindowWatcher.cpp"], "git_node": null, "git_parents": [null], "node": "aff320656025395054e97a4dec310ca4828929a8", "parents": ["54b307ef91058822b2313c0f073d359289e8d65b"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 20 - Move EndDragSession from nsIDragService to nsIDragSession  a=diannaS\n\nThis is a straightforward move.  It does take the liberty of breaking out an\nEndDragSessionImpl method, which will be needed later.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211083\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221173", "files": ["browser/components/customizableui/test/browser_1003588_no_specials_in_panel.js", "browser/components/customizableui/test/browser_962069_drag_to_overflow_chevron.js", "dom/base/nsGlobalWindowOuter.cpp", "dom/events/test/test_bug508479.html", "dom/ipc/BrowserChild.cpp", "layout/base/tests/test_bug603550.html", "layout/xul/test/browser_bug706743.js", "testing/mochitest/tests/SimpleTest/EventUtils.js", "toolkit/modules/SubDialog.sys.mjs", "toolkit/mozapps/extensions/test/browser/browser_dragdrop.js", "widget/MockDragServiceController.cpp", "widget/android/nsDragService.cpp", "widget/android/nsDragService.h", "widget/android/nsWindow.cpp", "widget/cocoa/nsChildView.mm", "widget/cocoa/nsDragService.h", "widget/cocoa/nsDragService.mm", "widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/gtk/nsWindow.cpp", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsIDragService.idl", "widget/nsIDragSession.idl", "widget/windows/nsDragService.cpp", "widget/windows/nsDragService.h", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "844225266de8a48a16b351a7dfa6a7ce8ae1978f", "parents": ["aff320656025395054e97a4dec310ca4828929a8"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 21 - Separate nsIDragService and nsIDragSession implementations  a=diannaS\n\nSplit the class inheritance trees for nsIDragService and nsIDragSession.\nRemember that, before the start of this patch series, the inheritance\ndiagram was:\n\nnsDragService -\u003e nsBaseDragService -\u003e nsIDragService + nsIDragSession\n\nand the only instance was a singleton.  We switched it to:\n\nnsDragService -\u003e nsDragSession -\u003e nsBaseDragService -\u003e nsIDragService + nsBaseDragSession -\u003e nsIDragSession\n\nand maintained the singleton.  This allowed us to allow us to move things to\nthe new classes without breaking behavior.  We are done with that,\nso we can now change the inheritance to its final form:\n\nnsDragService -\u003e nsBaseDragService -\u003e nsIDragService\n\nnsDragSession -\u003e nsBaseDragSession -\u003e nsIDragSession\n\nOf course, we also need to properly construct and release the\nnsIDragSessions (formerly part of the singleton), so that is done here as\nwell.  That happens in nsBaseDrag[Service|Session] for parent process drags\nand in nsDrag[Service|Session]Proxy for content.  This is all fairly\nstraightforward, except in the case of gtk, where we need to change\nsome callback behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D211084\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221174", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "widget/MockDragServiceController.cpp", "widget/android/nsDragService.cpp", "widget/android/nsDragService.h", "widget/android/nsWindow.cpp", "widget/cocoa/nsDragService.h", "widget/cocoa/nsDragService.mm", "widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/gtk/nsWindow.cpp", "widget/moz.build", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsDragServiceProxy.cpp", "widget/nsDragServiceProxy.h", "widget/nsIDragService.idl", "widget/nsIDragSession.idl", "widget/windows/nsDragService.cpp", "widget/windows/nsDragService.h", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "c5fbbd12c8d6858403778388010587b26cf0bc49", "parents": ["844225266de8a48a16b351a7dfa6a7ce8ae1978f"], "tags": []}, {"author": "David P \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: Part 22 - Make nsIDragService::StartDragSession return the nsIDragSession  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D212298\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221175", "files": ["widget/android/nsWindow.cpp", "widget/cocoa/nsChildView.mm", "widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/gtk/nsWindow.cpp", "widget/nsBaseDragService.cpp", "widget/nsDragServiceProxy.cpp", "widget/nsDragServiceProxy.h", "widget/nsIDragService.idl", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "d97a954b58c0b9a8175a5e011f8980d66ad34ff2", "parents": ["c5fbbd12c8d6858403778388010587b26cf0bc49"], "tags": []}, {"author": "Otto L\u00e4nd \u003cbind-autoland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1893119: apply code formatting via Lando  a=diannaS\n\n# ignore-this-changeset\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221176", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "editor/libeditor/EditorBase.cpp", "layout/forms/nsTextControlFrame.cpp", "widget/MockDragServiceController.cpp", "widget/android/nsDragService.cpp", "widget/android/nsDragService.h", "widget/cocoa/nsChildView.mm", "widget/cocoa/nsDragService.h", "widget/cocoa/nsDragService.mm", "widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/gtk/nsWindow.cpp", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsDragServiceProxy.cpp", "widget/windows/nsDragService.h", "widget/windows/nsNativeDragTarget.cpp"], "git_node": null, "git_parents": [null], "node": "ba49ddd82c7a628c8ea1e2deeca3745b7a76b129", "parents": ["d97a954b58c0b9a8175a5e011f8980d66ad34ff2"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1911486: Leave DragSession connected to BrowserChild while sending dragend  a=diannaS\n\nDuring EndDragSession and the dispatch of the dragend event in a content process\n(e.g. in an extension), accessing the event's dataTransfer didn't work because\nthe session was already disconnected from the BrowserChild.  This broke things\nlike tab dragging from web-extension-based tabbars.  This leaves the drag\nsession in place until after EndDragSession is done.  It also makes the\nreciprocal change to InvokeDragSession.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218667\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221177", "files": ["widget/nsDragServiceProxy.cpp"], "git_node": null, "git_parents": [null], "node": "ff01ad25cce5da897b10bad2e1d4017153aec6c4", "parents": ["ba49ddd82c7a628c8ea1e2deeca3745b7a76b129"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1912384 part 1 - cache DLP results for clipboard paste for a short time  a=diannaS\n\nThis is a bit of a bandaid fix, but it's straightforward and\nless brittle than trying to fix the various ways of getting\nthe clipboard contents.\n\nI added a relatively short timeout to the cached data to\nensure we don't have to worry about DLP settings in the agent\nchanging or anything like that. In all the cases of double\ncalls I've seen, the calls come very very close to each other\nin time.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219291\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221178", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysis.cpp"], "git_node": null, "git_parents": [null], "node": "77eeae145a3e8fac24fedbef79b2c4a9cbe17151", "parents": ["ff01ad25cce5da897b10bad2e1d4017153aec6c4"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1912384 part 2 - don't show dialog for cached DLP results  a=diannaS\n\nFor BLOCKED text, if we do two requests in quick succession, we will now\nreturn a cached result for the second request. This patch avoids showing\nthe BLOCK dialog more than once. (also works for WARN)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219496\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221179", "files": ["browser/components/contentanalysis/content/ContentAnalysis.sys.mjs", "toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h", "toolkit/components/contentanalysis/nsIContentAnalysis.idl", "toolkit/components/contentanalysis/tests/gtest/TestContentAnalysis.cpp"], "git_node": null, "git_parents": [null], "node": "adf0bb62b3328a19f3c8df6a11d5d0f8480516df", "parents": ["77eeae145a3e8fac24fedbef79b2c4a9cbe17151"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1913760 - parse custom data on the clipboard and send to DLP agent  a=diannaS\n\nPass kCustomTypesMime data on the clipboard to the DLP agent.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219552\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221180", "files": ["dom/events/DataTransfer.cpp", "dom/events/DataTransfer.h", "toolkit/components/contentanalysis/ContentAnalysis.cpp"], "git_node": null, "git_parents": [null], "node": "6722d7340aec5b68a392087426f424b8c2e8a4be", "parents": ["adf0bb62b3328a19f3c8df6a11d5d0f8480516df"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1912340: Use correct principal for remotely dragged data-transfer contents  a=diannaS\n\nThis comment assumes dom.events.datatransfer.protected.enabled=false.  when\ndom.events.datatransfer.protected.enabled=true (which matches the spec and is\nnot the default), the behavior is fine as-is.\n\nSince bug 1871222 (by one perspective) moved drag sessions from PContents to\nPBrowsers, we need to update permission handling for in-process \"remote\"\nsessions (ones that started on one PBrowser and currently target another). When\nthe target and source are in the same process, they don't properly handle\nprivileged DataTransfer access.  We are currently denying privileged access to\nsome in-process principals because we incorrectly use the system principal. The\nsystem principal always happens to give the right result for out-of-process\nremote sessions, which were the only kind that existed before bug 1871222.\n\nThis solution creates the \"remote\" DataTransfer with the \"correct\" (not system)\nprincipal of its source content.  However, this misses the case where two\ndifferent browsers are at the same location (same principal) -- each would\nincorrectly get privileged access to the other's DataTransfer in a drag.  We\navoid that case by limiting the change to extension processes.  This means that\nremote DataTransfers created in the extension process will check for protected\naccess using a principal check against the drag-source-element's principal but,\notherwise, DataTransfers will continue to use the system principal for the\ncheck.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219074\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221181", "files": ["dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/PBrowser.ipdl"], "git_node": null, "git_parents": [null], "node": "0e8678acd81f7c838befa4f576e5817e618a0973", "parents": ["6722d7340aec5b68a392087426f424b8c2e8a4be"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1912340: Test DataTransfer access in synthesizeMockDragAndDrop  a=diannaS\n\nVerify that DataTransfer is properly granted/restricted during DND operations\nbetween different browsers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219075\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221182", "files": ["dom/events/test/browser_dragdrop.js", "testing/mochitest/tests/SimpleTest/DragChildContextBase.sys.mjs", "testing/mochitest/tests/SimpleTest/EventUtils.js"], "git_node": null, "git_parents": [null], "node": "8d1c74665a7d7c890185a4e763d686441805b885", "parents": ["0e8678acd81f7c838befa4f576e5817e618a0973"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1912340: Run drag-drop test with dom.events.dataTransfer.protected.enabled true and false  a=diannaS\n\nThis patch is separated from the previous to ease reading -- the code changes in\nthis patch are minor so the file split is mostly transparent. We also run the\ntest for dom.events.dataTransfer.protected.enabled = true. The test is split\ninto two to avoid timeouts.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219076\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221183", "files": ["dom/events/test/browser.toml", "dom/events/test/browser_dragdrop.js", "dom/events/test/browser_dragdrop_impl.js", "dom/events/test/browser_dragdrop_protected.js", "dom/events/test/browser_dragdrop_unprotected.js"], "git_node": null, "git_parents": [null], "node": "fa02775f2ec768d58f07a6711ac81c409e62a0b0", "parents": ["8d1c74665a7d7c890185a4e763d686441805b885"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1912340: Further split up browser_dragdrop_[un]protected tests  a=diannaS\n\nNo substantive changes.  This avoids timeouts in automation.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219548\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221184", "files": ["dom/events/test/browser.toml", "dom/events/test/browser_dragdrop_impl.js", "dom/events/test/browser_dragdrop_protected.js", "dom/events/test/browser_dragdrop_protected_diff_origin.js", "dom/events/test/browser_dragdrop_protected_same_origin.js", "dom/events/test/browser_dragdrop_unprotected.js", "dom/events/test/browser_dragdrop_unprotected_diff_origin.js", "dom/events/test/browser_dragdrop_unprotected_same_origin.js"], "git_node": null, "git_parents": [null], "node": "e0514f56702cb304fff018f37b560e7c836a02f5", "parents": ["fa02775f2ec768d58f07a6711ac81c409e62a0b0"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1912160 [Linux] Don't do drag drop after D&D operation end  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218850\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221185", "files": ["widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "59ef3298026edb7821128ef759eb04053331a79a", "parents": ["e0514f56702cb304fff018f37b560e7c836a02f5"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1914068 - pass correct URL to Content Analysis for same-origin iframes  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220168\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221186", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/ContentAnalysis.h", "toolkit/components/contentanalysis/nsIContentAnalysis.idl", "toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_clipboard_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_clipboard_paste_inputandtextarea_iframe_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_clipboard_paste_prompt_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_print_iframe_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/clipboard_paste_inputandtextarea_containing_frame.html", "toolkit/components/contentanalysis/tests/browser/clipboard_print_iframe.html", "toolkit/components/contentanalysis/tests/browser/head.js", "toolkit/components/prompts/content/commonDialog.js", "widget/windows/nsFilePicker.cpp"], "git_node": null, "git_parents": [null], "node": "f871bb67c6af5e01403cf43230f321afad1eb7d4", "parents": ["59ef3298026edb7821128ef759eb04053331a79a"], "tags": []}], "date": 1725634246, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "dsmith@mozilla.com"}, "123": {"changesets": [{"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907501 - Restore visible border to findbar textbox  a=diannaS\n\nChanges the findbar textbox to use var(--input-border-color)\ninstead of var(--toolbar-field-border-color), the latter of\nwhich does not seem to be visible in many themes.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D216995\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220166", "files": ["toolkit/themes/shared/findbar.css"], "git_node": null, "git_parents": [null], "node": "19ef82de2223e595cc8f90594ab1e2ddf2ebd5ae", "parents": ["f871bb67c6af5e01403cf43230f321afad1eb7d4"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1907501 - Update browser_ext_themes_findbar.js  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D218068\n\nDepends on D220166\n\nDifferential Revision: https://phabricator.services.mozilla.com/D220167", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_findbar.js"], "git_node": null, "git_parents": [null], "node": "810460b1958c561d5d577bc660008a4d2aad8117", "parents": ["19ef82de2223e595cc8f90594ab1e2ddf2ebd5ae"], "tags": []}], "date": 1725660585, "git_changesets": [null, null], "user": "dsmith@mozilla.com"}, "124": {"changesets": [{"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 1897095 - Shift dialogBox when browser is in RDM. r=desktop-theme-reviewers,devtools-reviewers,dao,nchevobbe, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D217820", "files": ["devtools/client/responsive/responsive-browser.css"], "git_node": null, "git_parents": [null], "node": "a23aa7e17346bfafaf13cdf3c4fcb9d47f00174b", "parents": ["810460b1958c561d5d577bc660008a4d2aad8117"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1897792 - Change NonVolatileSingleMask on ARM64. r=iain, a=dsmith\n\nDifferential Revision: https://phab