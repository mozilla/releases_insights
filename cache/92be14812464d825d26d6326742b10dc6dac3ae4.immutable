ilDeakin,TYLin, a=dsmith\n\n* Make mXPos/mYPos work in terms of margin (mExtraMargin).\n * When we have no anchor, explicitly upgrade them to anchored-to-point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D215444", "files": ["dom/events/test/clipboard/browser_navigator_clipboard_clickjacking.js", "dom/events/test/clipboard/head.js", "layout/xul/nsMenuPopupFrame.cpp", "layout/xul/nsMenuPopupFrame.h", "toolkit/modules/ClipboardContextMenu.sys.mjs", "widget/tests/browser/browser_test_clipboard_contextmenu.js"], "git_node": null, "git_parents": [null], "node": "afb6393b80359240d6ccf74b459e4bf15d52cdb6", "parents": ["a4038768fc4aa0c6724af680f2406d27b106b83d"], "tags": []}], "date": 1725679377, "git_changesets": [null, null, null, null], "user": "dsmith@mozilla.com"}, "126": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset afb6393b8035 (bug 1901769) for causing failures on nsMenuPopupFrame.cpp, a=backout", "files": ["dom/events/test/clipboard/browser_navigator_clipboard_clickjacking.js", "dom/events/test/clipboard/head.js", "layout/xul/nsMenuPopupFrame.cpp", "layout/xul/nsMenuPopupFrame.h", "toolkit/modules/ClipboardContextMenu.sys.mjs", "widget/tests/browser/browser_test_clipboard_contextmenu.js"], "git_node": null, "git_parents": [null], "node": "9f1c1990d648b8c8b5d8a8c7b7950cd654ea7a9f", "parents": ["afb6393b80359240d6ccf74b459e4bf15d52cdb6"], "tags": []}, {"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset a4038768fc4a (bug 1901769) for causing failures on nsMenuPopupFrame.cpp, a=backout", "files": ["layout/xul/nsMenuPopupFrame.cpp", "layout/xul/nsMenuPopupFrame.h", "layout/xul/nsXULPopupManager.cpp"], "git_node": null, "git_parents": [null], "node": "67de124ba400e50882f2faf77f16a9df9810b4c5", "parents": ["9f1c1990d648b8c8b5d8a8c7b7950cd654ea7a9f"], "tags": []}, {"author": "Dianna Smith \u003cdsmith@mozilla.com\u00