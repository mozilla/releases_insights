1eee0e07d99f4e", "git_parents": ["38481347d98b1c6298cee6eaf1d1d8c72d4dc2b9"], "node": "87e70b3343dc53d60f8b2d615a91ab404fd451e3", "parents": ["db22b92fbc41526283b033667799c386575ad918"], "tags": []}], "date": 1791837879, "git_changesets": ["56f5ef713ec6d3564a6c199a5cf5d62ca59499fc", "9658a1695fec72715d392674fcd7d39d2df3d6e2", "38481347d98b1c6298cee6eaf1d1d8c72d4dc2b9", "d5e31fbd4b5b0a0616fba3db7c1eee0e07d99f4e"], "user": "rvandermeulen@mozilla.com"}, "28884": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2079758 - [remote] Cancel timer in PollPromise before throwing the error to prevent leaking it.  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332901\n", "files": ["remote/shared/Sync.sys.mjs", "remote/shared/test/xpcshell/test_Sync.js"], "git_node": "24bdc65796895f0b9ca65a3709bd4a523d92b9dd", "git_parents": ["d5e31fbd4b5b0a0616fba3db7c1eee0e07d99f4e"], "node": "648106a28545402888506cbe26adf84fdc381b42", "parents": ["87e70b3343dc53d60f8b2d615a91ab404fd451e3"], "tags": []}], "date": 1791838653, "git_changesets": ["24bdc65796895f0b9ca65a3709bd4a523d92b9dd"], "user": "rvandermeulen@mozilla.com"}, "28885": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078363 - Fade the vertical tabs overflow indicators out before the content area's rounded corner.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332104\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332910\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "ad832180ad60b43911fdf50acea75a87316a0d63", "git_parents": ["24bdc65796895f0b9ca65a3709bd4a523d92b9dd"], "node": "2c6dfaad479a69f769ae10a03ab574aab61841d8", "parents": ["648106a28545402888506cbe26adf84fdc381b42"], "tags": []}], "date": 1791838699, "git_changesets": ["ad832180ad60b43911fdf50acea75a87316a0d63"], "user": "rvandermeulen@mozilla.com"}, "28886": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076013 - Clamp MAX_UNIFORM_BLOCK_SIZE to 64 KiB.  a=RyanVM\n\nThis avoids excessive memory usage on certain websites on Linux with AMD hardware.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331063\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332798\n", "files": ["dom/canvas/WebGL2ContextState.cpp", "dom/canvas/WebGLTypes.h", "dom/canvas/test/webgl-mochitest/test_webgl2_uniform_block.html"], "git_node": "2d0df11b41aa2c5834a48afca3ce8e5b068bac6c", "git_parents": ["ad832180ad60b43911fdf50acea75a87316a0d63"], "node": "79c0822200553712d84929e4c5a8c81c91cbe4d7", "parents": ["2c6dfaad479a69f769ae10a03ab574aab61841d8"], "tags": []}], "date": 1791838744, "git_changesets": ["2d0df11b41aa2c5834a48afca3ce8e5b068bac6c"], "user": "rvandermeulen@mozilla.com"}, "28887": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073384 - Part 1: Request audio focus only when playback starts.  a=RyanVM\n\nWhen the platform takes audio focus away, the page's media is suspended, but a\npage that declares a playing media session keeps reporting that it is playing.\nEvery later media session update then requested audio focus again and took it\nstraight back, which silenced an alarm right after it started ringing.\n\nRequest audio focus once per playing tab and audio session type, and again only\nafter playback pauses or stops. A later audio session type change still reshapes\nthe request. A request that is not granted right away is retried on the next\nupdate, and only the latest start of the foreground service requests audio\nfocus, provided playback has not paused in the meantime.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331396\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332990\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/focus/AudioFocus.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt"], "git_node": "291499fb226c189e46e888cea19d818b59ff9c3d", "git_parents": ["2d0df11b41aa2c5834a48afca3ce8e5b068bac6c"], "node": "917604d057fc143021d2bb6d9618eb45d30f19d8", "parents": ["79c0822200553712d84929e4c5a8c81c91cbe4d7"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073384 - Part 2: Request audio focus when the user resumes from the platform media controls.  a=RyanVM\n\nAfter the system takes audio focus away for good, a page that declares a playing\nmedia session never reports a pause, so no new playback start requests focus\nagain. An explicit play command from the platform media session, such as a car,\nheadset or assistant play, now requests audio focus directly.\n\nResuming from the page's own controls in that state is not covered yet; that\nneeds Gecko to report that the media actually started playing again.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331397\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332991\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/session/MediaSessionCallback.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/session/MediaSessionCallbackTest.kt"], "git_node": "1bee17d7992b01a6cc2fad9e65d25830486817b1", "git_parents": ["291499fb226c189e46e888cea19d818b59ff9c3d"], "node": "140f784fe0d2909895b27492dc8aa19de23e1200", "parents": ["917604d057fc143021d2bb6d9618eb45d30f19d8"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073384 - Part 3: Test audio focus requests during media session updates.  a=RyanVM\n\nCover that repeated updates for a playing tab do not request audio focus again,\nincluding after a transient or permanent focus loss, and that pausing, stopping,\nshutting down, switching tabs, changing the audio session type, a denied request\nand an explicit play from the platform media session all lead to a new request.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331398\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332992\n", "files": ["mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/focus/AudioFocusTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/session/MediaSessionCallbackTest.kt"], "git_node": "e2391d58419154ceb09711bf723828f57294203f", "git_parents": ["1bee17d7992b01a6cc2fad9e65d25830486817b1"], "node": "b13780e7d8d90ab2247e8c3523119b585c157d7f", "parents": ["140f784fe0d2909895b27492dc8aa19de23e1200"], "tags": []}], "date": 1791848369, "git_changesets": ["291499fb226c189e46e888cea19d818b59ff9c3d", "1bee17d7992b01a6cc2fad9e65d25830486817b1", "e2391d58419154ceb09711bf723828f57294203f"], "user": "rvandermeulen@mozilla.com"}, "28888": {"changesets": [{"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2080007 [Linux][Vulkan Video] - Enable the DMA-BUF sync-file ioctl in ffvpx Vulkan import.  a=RyanVM\n\nThe Linux sysroot has no linux/dma-buf.h new enough for the sync-file ioctl. Define it in hwcontext_vulkan.c, as DMABufSurface.cpp does for DMA_BUF_IOCTL_SYNC.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332261\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332820\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/dma-buf-sync-file.patch", "media/ffvpx/libavutil/hwcontext_vulkan.c"], "git_node": "a53ddaeffa448cb9cbc79f09cb1e50d594d68ae5", "git_parents": ["e2391d58419154ceb09711bf723828f57294203f"], "node": "a217f367c4d29dce7ca917244d0a887f5f6c564c", "parents": ["b13780e7d8d90ab2247e8c3523119b585c157d7f"], "tags": []}], "date": 1791848395, "git_changesets": ["a53ddaeffa448cb9cbc79f09cb1e50d594d68ae5"], "user": "rvandermeulen@mozilla.com"}, "28889": {"changesets": [{"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2077649 - Snap picture cache slice roots to the device pixel grid.  a=RyanVM\n\nA slice is rasterized relative to its spatial node and composited at a whole\ndevice pixel offset. When an unsnapped reference frame leaves a slice root at\na fractional offset, surfaces drawn into the slice that rasterize relative to\nroot land off the slice's pixel grid and get resampled when composited,\nblurring their content. Record slice roots during scene building and snap\nslice root scroll and sticky frames in the spatial tree, carrying the\nadjustment to their descendants, so the spatial tree agrees with where the\nslice is composited.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332180\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333013\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/wrench/reftests/mask/2077649-mask-fractional-scroll-root-ref.yaml", "gfx/wr/wrench/reftests/mask/2077649-mask-fractional-scroll-root.yaml", "gfx/wr/wrench/reftests/mask/reftest.list"], "git_node": "23ac5655f5bcfe27177266ea88a76e1948a11bf9", "git_parents": ["a53ddaeffa448cb9cbc79f09cb1e50d594d68ae5"