": ["9eec646d7ed809f5ae5f9de49dddfce07c0a8317"], "node": "4793c004f2eb90490d2dc3664adaff9389022f81", "parents": ["79bef4486ef975ac8a01bb9a1aa86feb19446529"], "tags": []}], "date": 1792255134, "git_changesets": ["08b7a845625415ec3b381b84207a3cccd162d9a9"], "user": "rvandermeulen@mozilla.com"}, "29016": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082061 - Hold a strong reference to the document in media and image stream listeners.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334055\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334794\n", "files": ["dom/html/ImageDocument.cpp", "dom/html/MediaDocument.cpp"], "git_node": "bd6975e4f6143824aa2ef84487df065c74bcd80f", "git_parents": ["08b7a845625415ec3b381b84207a3cccd162d9a9"], "node": "bbbd7a9b1beb1e39bd822e6a91a7c5b4e5216498", "parents": ["4793c004f2eb90490d2dc3664adaff9389022f81"], "tags": []}], "date": 1792255167, "git_changesets": ["bd6975e4f6143824aa2ef84487df065c74bcd80f"], "user": "rvandermeulen@mozilla.com"}, "29017": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082064.  a=RyanVM\n\nThe crashtest only crashes on ASAN builds but works.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334529\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334821\n", "files": ["layout/generic/MiddleCroppingBlockFrame.cpp", "testing/web-platform/tests/html/rendering/widgets/file-type-label-update-crash.https.html"], "git_node": "05f31ebefc9217ccb8f93ff4ff60661516f9c77e", "git_parents": ["bd6975e4f6143824aa2ef84487df065c74bcd80f"], "node": "ae3688632d3adf795d7c47788efd5811ca48c3fe", "parents": ["bbbd7a9b1beb1e39bd822e6a91a7c5b4e5216498"], "tags": []}], "date": 1792255204, "git_changesets": ["05f31ebefc9217ccb8f93ff4ff60661516f9c77e"], "user": "rvandermeulen@mozilla.com"}, "29018": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081977 - Deal better with style changes in replicated subtrees.  a=RyanVM\n\nQuite a massive hammer, but simple and should be correct / fix a lot of\nthese issues at once.\n\nWe'd need to reframe the root for replicated fixed pos, and would need to\nreframe at least the replicated table for the replicated rowgroups.\n\nHowever since nsPageSequenceFrame will bail on incremental reflow\n(bug 1152354), well...\n\nOther bugs that I found while at this are that nsTableCellMap::Synchronize\nand nsTableFrame::ResetRowIndices only look at a single table continuation.\nA dynamic row-group removal leaks a cell map.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334564\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334844\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/style/RestyleManager.cpp", "testing/web-platform/tests/css/printing/fixed-container-query-removal-crash-print.html", "testing/web-platform/tests/css/printing/table-row-group-container-query-crash-print.html"], "git_node": "d9ab21661aa8e16347f27c4967eec345d8bfed7f", "git_parents": ["05f31ebefc9217ccb8f93ff4ff60661516f9c77e"], "node": "7c577c616bb0f6ebe6c105ae1d32ce943d8706e7", "parents": ["ae3688632d3adf795d7c47788efd5811ca48c3fe"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081977 - Share generated content pseudo-elements and skip counters for extra frames.  a=RyanVM\n\nRepeated table headers and replicated fixed-pos frames used to create\nnew pseudo-element containers and counter nodes for each copy, which\nconfused the generated content lists.\n\nReuse the original pseudo-element instead, and don't make extra frames\nparticipate in counters.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334565\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334845\n", "files": ["layout/base/crashtests/crashtests.list", "layout/base/crashtests/repeated-counter-marker.html", "layout/base/crashtests/repeated-counter-marker.sjs", "layout/base/crashtests/repeated-generated-content.html", "layout/base/nsCSSFrameConstructor.cpp", "layout/base/nsCSSFrameConstructor.h"], "git_node": "fb86d1f11002adedfb3bfca4fc1a6e7dbd3cad0e", "git_parents": ["d9ab21661aa8e16347f27c4967eec345d8bfed7f"], "node": "7c9686b3da36bcc24f95f1d8e7acd44866e0f9fe", "parents": ["7c577c616bb0f6ebe6c105ae1d32ce943d8706e7"], "tags": []}], "date": 1792255246, "git_changesets": ["d9ab21661aa8e16347f27c4967eec345d8bfed7f", "fb86d1f11002adedfb3bfca4fc1a6e7dbd3cad0e"], "user": "rvandermeulen@mozilla.com"}, "29019": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Fail live alt-data readers when the alt-data writer fails  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334172\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334701\n", "files": ["netwerk/cache2/CacheFile.cpp", "netwerk/cache2/CacheFileChunk.cpp", "netwerk/cache2/CacheFileInputStream.h"], "git_node": "5d8c288f4d84862a32da1edab82d76b666510c21", "git_parents": ["fb86d1f11002adedfb3bfca4fc1a6e7dbd3cad0e"], "node": "c1d75e487127dcad6e298837b740ba2b94b4b6f4", "parents": ["7c9686b3da36bcc24f95f1d8e7acd44866e0f9fe"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Reject incomplete compressed script bytecode  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334173\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334702\n", "files": ["dom/script/ScriptCompression.cpp"], "git_node": "ba74f85b39958927eef50f46cac2253b56240574", "git_parents": ["5d8c288f4d84862a32da1edab82d76b666510c21"], "node": "0cb8ef7a45173f390f6b016cf5b23138a9cf259f", "parents": ["c1d75e487127dcad6e298837b740ba2b94b4b6f4"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082139: Test failed alt-data writes and incomplete compressed bytecode  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334174\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334703\n", "files": ["dom/base/test/gtest/TestScriptCompression.cpp", "dom/base/test/gtest/moz.build", "netwerk/test/unit/test_alt-data_failed_write.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "1a88719e9e1abd0d121ee38ee7fe3c9c8c3c3730", "git_parents": ["ba74f85b39958927eef50f46cac2253b56240574"], "node": "0ec527a7904e21182f2bd173f847ba75695d9465", "parents": ["0cb8ef7a45173f390f6b016cf5b23138a9cf259f"], "tags": []}], "date": 1792255291, "git_changesets": ["5d8c288f4d84862a32da1edab82d76b666510c21", "ba74f85b39958927eef50f46cac2253b56240574", "1a88719e9e1abd0d121ee38ee7fe3c9c8c3c3730"], "user": "rvandermeulen@mozilla.com"}, "29020": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2083139: Make grid computed-style getters more robust.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334712\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334720\n", "files": ["layout/style/nsComputedDOMStyle.cpp"], "git_node": "912b1603e5fe618b1de0d34a229d728081d9eccc", "git_parents": ["1a88719e9e1abd0d121ee38ee7fe3c9c8c3c3730"], "node": "86c92f315682a2a51fe4c6aba0777f621a561da0", "parents": ["0ec527a7904e21182f2bd173f847ba75695d9465"], "tags": []}], "date": 1792255325, "git_changesets": ["912b1603e5fe618b1de0d34a229d728081d9eccc"], "user": "rvandermeulen@mozilla.com"}, "29021": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082265 - Part 1: Don't wait on the media engine CDM process for support queries without a media engine id.  a=RyanVM\n\nThe media engine CDM process only creates decoders for media engine playback so it can't affect the answer to those queries. Waiting on it means a launch that never completed leaves them pending forever.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334527\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334835\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp"], "git_node": "382c885ee00282bd8fa16d14c78c505c6a8cd021", "git_parents": ["912b1603e5fe618b1de0d34a229d728081d9eccc"], "node": "650c95401bacf4a86b1dd0ab3b034ff36780adac", "parents": ["86c92f315682a2a51fe4c6aba0777f621a561da0"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082265 - Part 2: Restore the pre-bug 2051510 WPT expectations for strict-mode HEVC support on Windows.  a=RyanVM\n\nWithout the wait on the media engine CDM process, strict-mode HEVC support on Windows again depends on whether that process has reported.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334540\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334836\n", "files": ["testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini"], "git_node": "98eea2825b7c8778ab2dd3abc5bdd260612ecea1", "git_parents": ["382c885ee00282bd8fa16d14c78c505c6a8cd021"], "node": "ff72dd9978e91f3c50d6a26583bf9677860cbb5e", "parents": ["650c95401bacf4a86b1dd0ab3b034ff36780adac"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082265 - Reject pending codec support waits when a remote media manager actor is destroyed.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334348\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334837\n", "files": ["dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/ipc/RemoteMediaManagerChild.h"], "git_node": "b3e4513bd805bb3d32b83ac58042b6f452b7edbd", "git_parents": ["98eea2825b7c87