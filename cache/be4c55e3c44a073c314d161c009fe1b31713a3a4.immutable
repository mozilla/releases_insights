fbdca2d0214082ef4922319b52b8f5cfb6\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "4f1f4d299ce898f37f83afd7175d6aafab878aba", "git_parents": ["8522d72c84ca0e958cbe06e8f0fa08feca842958"], "node": "531a322f6a9bd4d789022e03e2de1bf1860b1c6c", "parents": ["3631cd5171c04cb88831ff677f1076e68d63f4fc"], "tags": []}], "date": 1791882215, "git_changesets": ["8522d72c84ca0e958cbe06e8f0fa08feca842958", "4f1f4d299ce898f37f83afd7175d6aafab878aba"], "user": "ffxbld@lando.moz.tools"}, "28893": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging eb9a6e3a736802c8e080a76c44dc81f409d99d54 with FIREFOX_158_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ed3c342bf463f471bb31108e664a64e425c284cd", "git_parents": ["b6c8aca3a9e8ca4abb55a6f016e17417d43bd53b"], "node": "95216f553d31699c67e93d4069300b1f3ea1c756", "parents": ["f9d3bee3f71c847be0402dbb2b3e6a8ed99856c1"], "tags": []}], "date": 1791895219, "git_changesets": ["ed3c342bf463f471bb31108e664a64e425c284cd"], "user": "ffxbld@lando.moz.tools"}, "28894": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging dedb41ddf85d96319e7d6d5f45dd5a61986163b3 with FIREFOX_115_43_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "27a9b4d7a21a17f6a9b01e58a1710464eafa88bc", "git_parents": ["ed3c342bf463f471bb31108e664a64e425c284cd"], "node": "1fa780c46964db224fc2fb964b74ff7fde6d5507", "parents": ["95216f553d31699c67e93d4069300b1f3ea1c756"], "tags": []}], "date": 1791895408, "git_changesets": ["27a9b4d7a21a17f6a9b01e58a1710464eafa88bc"], "user": "ffxbld@lando.moz.tools"}, "28895": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging fd5558cd1123da4b6a35348a386ac8319bb3a144 with FIREFOX_153_5_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "edc00968cc98b41b48c66bb3b00331fcc0213957", "git_parents": ["27a9b4d7a21a17f6a9b01e58a1710464eafa88bc"], "node": "efc7aa16e0a4b9b8bf41b78454c2d3dd0d09aaa5", "parents": ["1fa780c46964db224fc2fb964b74ff7fde6d5507"], "tags": []}], "date": 1791895566, "git_changesets": ["edc00968cc98b41b48c66bb3b00331fcc0213957"], "user": "ffxbld@lando.moz.tools"}, "28896": {"changesets": [{"author": "Ed Lee \u003cedilee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080033 - add yahoo scout chatbot configuration to allow nimbus rollout  a=RyanVM\n\nadd config and assets, update providers ahead of rollout\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332266\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333166\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/assets/brands/scout.svg", "browser/components/genai/chat.css", "browser/components/genai/tests/browser/browser_chat_sidebar.js", "browser/locales/en-US/browser/genai.ftl"], "git_node": "f14528dc1fdb00c782b8d23a76cff4a5a82a96c0", "git_parents": ["4f1f4d299ce898f37f83afd7175d6aafab878aba"], "node": "20302335e051588705f66afd32f1e07a0f697c45", "parents": ["531a322f6a9bd4d789022e03e2de1bf1860b1c6c"], "tags": []}], "date": 1791902557, "git_changesets": ["f14528dc1fdb00c782b8d23a76cff4a5a82a96c0"], "user": "rvandermeulen@mozilla.com"}, "28897": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2076410 - Read and close JSStreamConsumer streams on a dedicated task queue.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331070\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333132\n", "files": ["dom/fetch/FetchUtil.cpp"], "git_node": "960e1cae718fc6155f37ae6c2f3150a1daabf11c", "git_parents": ["f14528dc1fdb00c782b8d23a76cff4a5a82a96c0"], "node": "97c85978e59752f860b690dc3c25282c655b5d65", "parents": ["20302335e051588705f66afd32f1e07a0f697c45"], "tags": []}], "date": 1791902629, "git_changesets": ["960e1cae718fc6155f37ae6c2f3150a1daabf11c"], "user": "rvandermeulen@mozilla.com"}, "28898": {"changesets": [{"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080436 - Avoid accelerated canvas' PBO upload path on macOS with native GL on Intel GPUs.  a=RyanVM\n\nUsing the shared PBO upload path can result in broken rendering when\nwith the native macOS GL driver on Intel GPUs. We therefore avoid\nit. Rendering when using ANGLE is unaffected.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332840\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333158\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebgl.h"], "git_node": "8b7281b29de849ebfe765ff94f499e012f443556", "git_parents": ["960e1cae718fc6155f37ae6c2f3150a1daabf11c"], "node": "0c23a318ad639247f93e8871ba97ff7e15310eb4", "parents": ["97c85978e59752f860b690dc3c25282c655b5d65"], "tags": []}], "date": 1791902672, "git_changesets": ["8b7281b29de849ebfe765ff94f499e012f443556"], "user": "rvandermeulen@mozilla.com"}, "28899": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2076271 - Make sure executor outlives stream parser.  a=RyanVM\n\nAlso stop the document load explicitly when canceling XHR.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331564\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333119\n", "files": ["dom/xhr/XMLHttpRequestMainThread.cpp", "parser/html/nsHtml5StreamParser.cpp"], "git_node": "23fdf8307a37b68da82cfcb87fd356c4a1d85e49", "git_parents": ["8b7281b29de849ebfe765ff94f499e012f443556"], "node": "20cff692f4c884b30ba12747f3415724e1c49018", "parents": ["0c23a318ad639247f93e8871ba97ff7e15310eb4"], "tags": []}], "date": 1791902886, "git_changesets": ["23fdf8307a37b68da82cfcb87fd356c4a1d85e49"], "user": "rvandermeulen@mozilla.com"}, "28900": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079257 - Change txXPathNodeUtils::getPrefix.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332377\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333149\n", "files": ["dom/xslt/xpath/txMozillaXPathTreeWalker.cpp", "dom/xslt/xpath/txXPathTreeWalker.h", "dom/xslt/xslt/txInstructions.cpp"], "git_node": "8a77f5c2e9c196c9bec6654b87ec393e9c5a2add", "git_parents": ["23fdf8307a37b68da82cfcb87fd356c4a1d85e49"], "node": "7bd9aeb91700905ad2039c4634c5c38daa28dee5", "parents": ["20cff692f4c884b30ba12747f3415724e1c49018"], "tags": []}], "date": 1791902920, "git_changesets": ["8a77f5c2e9c196c9bec6654b87ec393e9c5a2add"], "user": "rvandermeulen@mozilla.com"}, "28901": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075432 - Ensure table continuations use consistent border-collapse model.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330808\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333192\n", "files": ["layout/tables/nsCellMap.cpp", "layout/tables/nsTableFrame.cpp", "testing/web-platform/tests/css/css-tables/table-continuation-border-model-crash-print.html"], "git_node": "05d8bf679562a847b2a58c552ec95b4c7b38ebf8", "git_parents": ["8a77f5c2e9c196c9bec6654b87ec393e9c5a2add"], "node": "b12e1b660ccce2d750ede20b7163fb044e6b9974", "parents": ["7bd9aeb91700905ad2039c4634c5c38daa28dee5"], "tags": []}], "date": 1791902956, "git_changesets": ["05d8bf679562a847b2a58c552ec95b4c7b38ebf8"], "user": "rvandermeulen@mozilla.com"}, "28902": {"changesets": [{"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2080102  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332364\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333176\n", "files": ["image/AutoRestoreSVGState.h", "image/SVGDocumentWrapper.cpp"], "git_node": "202f5e0d7aac0fcf887183c1f3c9883b3a942ffb", "git_parents": ["05d8bf679562a847b2a58c552ec95b4c7b38ebf8"], "node": "e55a6858040a5e38ac3c1b851b8aa334829ddcbc", "parents": ["b12e1b660ccce2d750ede20b7163fb044e6b9974"], "tags": []}], "date": 1791902986, "git_changesets": ["202f5e0d7aac0fcf887183c1f3c9883b3a942ffb"], "user": "rvandermeulen@mozilla.com"}, "28903": {"changesets": [{"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2080116 - Move bogus assertion before inserting into [[LoadedModules]].  a=RyanVM\n\nModuleRequestHasher::match is also called during `lookup`.\nMove the assertion of !ModuleType::Unknown in FinishLoadingImportedModule.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332912\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333188\n", "files": ["js/src/builtin/ModuleObject.h", "js/src/jit-test/tests/modules/bug-2080116.js", "js/src/vm/Modules.cpp"], "git_node": "1742e68368e6f87c4d1ee23076eaffa548fd5a6b", "git_parents": ["202f5e0d7aac0fcf887183c1f3c9883b3a942ffb"], "node": "4400740cee30d3e07194570c46a861965ad3585a", "parents": ["e55a6858040a5e38ac3c1b851b8aa334829ddcbc"], "tags": []}], "date": 1791903052, "git_changesets": ["1742e68368e6f87c4d1ee23076eaffa548fd5a6b"], "user": "rvandermeulen@mozilla.com"}, "28904": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079171 - Update PlaybackEnded handling.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332012\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333289\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp"], "git_node": "e04def7e9c82b1b01542ce0264aaf22ec2761cc6", "git_parents": ["1742e68368e6f87c4d1ee23076eaffa548fd5a6b"], "node": "c50b447001bec4a2569289617334dc7b32e5b5f1", "parents": ["4400740cee30d3e07194570c46a861965ad3585a"], "tags": []}], "date": 1791913279, "git_changesets": ["e04def7e9c82b1b01542ce0264aaf22ec2761cc6"], "user": "rvandermeulen@mozilla.com"}, "28905": {"changesets": [{"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2061508: Remove this ancient stund compatibility mode.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332255\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333339\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/nicer.gyp", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun.h", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_build.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_build.h", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_client_ctx.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_client_ctx.h", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_codec.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_hint.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_msg.cpp", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_msg.h", "dom/media/webrtc/transport/third_party/nICEr/src/stun/stun_proc.cpp"], "git_node": "4428b3cea1d86a69f44efe6c2e4a13547c13660b", "git_parents": ["e04def7e9c82b1b01542ce0264aaf22ec2761cc6"], "node": "10f8f4b53471dc24ed143092fe5dc432b551a403", "parents": ["c50b447001bec4a2569289617334dc7b32e5b5f1"], "tags": []}], "date": 1791913305, "git_changesets": ["4428b3cea1d86a69f44efe6c2e4a13547c13660b"], "user": "rvandermeulen@mozilla.com"}, "28906": {"changesets": [{"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080876 - Part 1: Answer GMP support queries in child processes from the cached capabilities.  a=RyanVM\n\nRead the cached GMP capability list directly when answering GMP support\nqueries in child processes, instead of getting the GMP service first.\nThe parent process sends this list to each content process, and the\nchild GMP service already answered from it, so the answers do not\nchange. Also clear the list under its lock at shutdown, because any\nthread can now read it.\n\nGetting the service created it lazily. When the first query came from a\nbackground thread, a main thread query made at the same time could wait\nforever for that creation to finish, because the creation itself needs\nthe main thread.\n\nLate in shutdown, a child process can now answer from the cached list,\nwhere it used to answer no because the service could no longer be\ncreated.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333074\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333107\n", "files": ["dom/media/gmp/GMPServiceChild.cpp", "dom/media/gmp/GMPServiceChild.h", "dom/media/gmp/GMPUtils.cpp"], "git_node": "b81611f675062195215174c8ec9de1a9bbaacd55", "git_parents": ["4428b3cea1d86a69f44efe6c2e4a13547c13660b"], "node": "c10882ee2c5b9c3e255532904a0135e1dd60781f", "parents": ["10f8f4b53471dc24ed143092fe5dc432b551a403"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080876 - Part 2: Add a test for EME requests racing GMP service creation from MediaCapabilities.  a=RyanVM\n\nAdd a browser test that queries media capabilities and then requests key\nsystem access in a fresh content process that has not created the GMP\nservice yet. The test blocks the main thread between the two calls so\nthat the background support query runs first, and checks that both\nrequests resolve.\n\nThis is the sequence Prime Video uses on load. Before the fix, the\ncapabilities query started creating the GMP service on a background task\nqueue and waited for the main thread, while the key system request\nwaited on the main thread for that pending creation, so neither request\nfinished.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333075\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333108\n", "files": ["dom/media/test/browser/browser.toml", "dom/media/test/browser/browser_eme_gmp_service_creation_race.js"], "git_node": "28d2701d93ac30090a9f41c9390c4c6ab3392b99", "git_parents": ["b81611f675062195215174c8ec9de1a9bbaacd55"], "node": "413e3d1ce042e44cfd77c9112a49cfcff00f2da0", "parents": ["c10882ee2c5b9c3e255532904a0135e1dd60781f"], "tags": []}], "date": 1791913329, "git_changesets": ["b81611f675062195215174c8ec9de1a9bbaacd55", "28d2701d93ac30090a9f41c9390c4c6ab3392b99"], "user": "rvandermeulen@mozilla.com"}, "28907": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078727: Use release assert in RegExpStatics::executeLazy  a=RyanVM\n\nNormally, rerunning a regexp should get the same result. However, if there is a bug in the regexp engine that causes us to fail to match in a case where we should, *and* the choice to emit the buggy code depends on the frequency sampling that the regexp compiler does to its input, then discarding and recompiling can end up with a mismatch. We can nip it all in the bud by simply turning this assert into a release assert.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332218\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332785\n", "files": ["js/src/vm/RegExpStatics.cpp"], "git_node": "ad20725e686bb1bd472da653fdb04d3663f8dcb2", "git_parents": ["28d2701d93ac30090a9f41c9390c4c6ab3392b99"], "node": "0ed6b277987c56b1a39c5a8af758b8da1363b5d2", "parents": ["413e3d1ce042e44cfd77c9112a49cfcff00f2da0"], "tags": []}], "date": 1791913355, "git_changesets": ["ad20725e686bb1bd472da653fdb04d3663f8dcb2"], "user": "rvandermeulen@mozilla.com"}, "28908": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074772 - Gate MOZ_SYSTEM_CONFIG_DIR on automation.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330847\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333410\n", "files": ["xpcom/io/SpecialSystemDirectory.cpp"], "git_node": "ac894f8a4fd71bc3e732a369207f779de145800a", "git_parents": ["ad20725e686bb1bd472da653fdb04d3663f8dcb2"], "node": "c2c1e80f178e45af74688cfb5bfb79ab32b10718", "parents": ["0ed6b277987c56b1a39c5a8af758b8da1363b5d2"], "tags": []}], "date": 1791928920, "git_changesets": ["ac894f8a4fd71bc3e732a369207f779de145800a"], "user": "rvandermeulen@mozilla.com"}, "28909": {"changesets": [{"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2078983: We don't actually need this.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332094\n\nDifferential Revision: https://phabricator.services.mozilla.com/D332435\n", "files": ["dom/media/webrtc/jsapi/RTCEncodedFrameBase.cpp"], "git_node": "a1b7c9a27a219ddbb72450c136aeb11db3aa735d", "git_parents": ["ac894f8a4fd71bc3e732a369207f779de145800a"], "node": "7bca4d9c6753cd3d005e28feda91311e83fbd1b6", "parents": ["c2c1e80f178e45af74688cfb5bfb79ab32b10718"], "tags": []}], "date": 1791928944, "git_changesets": ["a1b7c9a27a219ddbb72450c136aeb11db3aa735d"], "user": "rvandermeulen@mozilla.com"}, "28910": {"changesets": [{"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 1822968 - Match downloaded filenames structure to Desktop  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312566\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333355\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/components/geckoview/GeckoViewExternalAppService.cpp", "mobile/android/components/geckoview/GeckoViewStreamListener.cpp", "mobile/android/components/geckoview/GeckoViewStreamListener.h", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentDelegateTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "8a26cd4b30dabbe4a40005571d31f905cc2516b5", "git_parents": ["a1b7c9a27a219ddbb72450c136aeb11db3aa735d"], "node": "49e7b40d122e40302c89fa2c6c1dc7d9f41c5a0e", "parents": ["7bca4d9c6753cd3d005e28feda91311e83fbd1b6"], "tags": []}], "date": 1791928978, "git_changesets": ["8a26cd4b30dabbe4a40005571d31f905cc2516b5"], "user": "rvandermeulen@mozilla.com"}, "28911": {"changesets": [{"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073686 - Block scripts on ScrollbarActivity::BeginFade().  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330626\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333402\n", "files": ["layout/generic/ScrollbarActivity.cpp"], "git_node": "e24ca6e66975804f2f024c9d38333a402179b541", "git_parents": ["8a26cd4b30dabbe4a40005571d31f905cc2516b5"], "node": "c01c0a1692fb54f49bc27048579db7830e1a1f05", "parents": ["49e7b40d122e40302c89fa2c6c1dc7d9f41c5a0e"], "tags": []}], "date": 1791929010, "git_changesets": ["e24ca6e66975804f2f024c9d38333a402179b541"], "user": "rvandermeulen@mozilla.com"}, "28912": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079156: Don't look up prototype for iterator helpers  a=RyanVM\n\nIterator helpers use a separate path in the spec that does not do a prototype lookup. This can be observable if %GeneratorFunction.prototype%.prototype is redefined as a getter.\n\nAsync iterator helpers are only stage 2. CreateAsyncIteratorFromClosure was removed from the spec due to lack of uses, which is why the comment points to an old revision.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331854\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333347\n", "files": ["js/src/jit-test/tests/iterator/bug2079156-async.js", "js/src/jit-test/tests/iterator/bug2079156.js", "js/src/vm/AsyncIteration.cpp", "js/src/vm/GeneratorObject.cpp"], "git_node": "625ad02578633bf0fa4f9c0362ec07efac9d26e1", "git_parents": ["e24ca6e66975804f2f024c9d38333a402179b541"], "node": "b70b0c8d9d3e57eacaa8fdbad83d2f3994a4c954", "parents": ["c01c0a1692fb54f49bc27048579db7830e1a1f05"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080210: Fix test for beta  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332486\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333348\n", "files": ["js/src/jit-test/tests/iterator/bug2079156-async.js"], "git_node": "e17219cc5d02f10c81770608670f07ae0fd49c10", "git_parents": ["625ad02578633bf0fa4f9c0362ec07efac9d26e1"], "node": "45b4b690b8ee45bd7968d1b5bbe6defc5ec7504d", "parents": ["b70b0c8d9d3e57eacaa8fdbad83d2f3994a4c954"], "tags": []}], "date": 1791929049, "git_changesets": ["625ad02578633bf0fa4f9c0362ec07efac9d26e1", "e17219cc5d02f10c81770608670f07ae0fd49c10"], "user": "rvandermeulen@mozilla.com"}, "28913": {"changesets": [{"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079939 - Turn off all New Tab widgets in automation with one pref  a=RyanVM\n\nSets browser.newtabpage.activity-stream.widgets.enabled to false in the test profiles, the Marionette client and RecommendedPreferences, so no widget renders or fetches in automation unless a test turns widgets back on. This replaces the  per-widget Picture of the Day pref in the test profiles.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332204\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333424\n", "files": ["browser/extensions/newtab/test/browser/browser_customize_menu_content.js", "remote/shared/RecommendedPreferences.sys.mjs", "testing/marionette/client/marionette_driver/geckoinstance.py", "testing/profiles/common/user.js", "testing/profiles/xpcshell/user.js"], "git_node": "16993e105564378d94c3fef42aebe6dc8a0d46d8", "git_parents": ["e17219cc5d02f10c81770608670f07ae0fd49c10"], "node": "17c25ce27550b48cfedbaf80aba75a13524a8de8", "parents": ["45b4b690b8ee45bd7968d1b5bbe6defc5ec7504d"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078974 - Turn on widget market gating with every widget off by default  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331453\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333425\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "aa5f944bcd832083d2b6de354442760268391ad6", "git_parents": ["16993e105564378d94c3fef42aebe6dc8a0d46d8"], "node": "4e743482705072a022c3ab9a16bdc0de7fa236d3", "parents": ["17c25ce27550b48cfedbaf80aba75a13524a8de8"], "tags": []}], "date": 1791930128, "git_changesets": ["16993e105564378d94c3fef42aebe6dc8a0d46d8", "aa5f944bcd832083d2b6de354442760268391ad6"], "user": "rvandermeulen@mozilla.com"}, "28914": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079676.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333187\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333446\n", "files": ["dom/canvas/OffscreenCanvasDisplayHelper.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.h"], "git_node": "3eabae803146e6a0e25aaa6beb9e9fef4a13c468", "git_parents": ["aa5f944bcd832083d2b6de354442760268391ad6"], "node": "78d7cadf0daa3fffb3f1d72632bf3bd3c0030852", "parents": ["4e743482705072a022c3ab9a16bdc0de7fa236d3"], "tags": []}], "date": 1791935177, "git_changesets": ["3eabae803146e6a0e25aaa6beb9e9fef4a13c468"], "user": "rvandermeulen@mozilla.com"}, "28915": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rMX/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/browser/menu/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-pa-rIN/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/compose/menu/src/main/res/values-ro/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-pa-rIN/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-ro/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-es-rMX/strings.xml", "mobile/android/android-components/components/feature/pwa/src/main/res/