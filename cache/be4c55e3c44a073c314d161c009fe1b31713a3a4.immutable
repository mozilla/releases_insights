9e1f8116ab74b070d471ac60e3257c3383f7e1", "876061a702238f62d7b639148e8da7ca07a15bf7"], "user": "rvandermeulen@mozilla.com"}, "29082": {"changesets": [{"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082211 - Patch ICU windows zone data for updated time zones  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334748\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335680\n", "files": ["config/external/icu/data/icudt78l.dat", "intl/icu-patches/bug-2082211-CLDR-19827-windows-zones.diff", "intl/icu/source/data/misc/windowsZones.txt", "intl/tzdata/source/be/windowsZones.res", "intl/tzdata/source/le/windowsZones.res", "intl/update-icu.sh"], "git_node": "efb0b13c8d8b403148921d0ac8b62f63ef1fa64f", "git_parents": ["876061a702238f62d7b639148e8da7ca07a15bf7"], "node": "ab3f23073bf74275b7c4572e2a2d93fd4f7090f2", "parents": ["c5c9ce14a655c2cc273fde3c9cefa36c8215546c"], "tags": []}], "date": 1792513443, "git_changesets": ["efb0b13c8d8b403148921d0ac8b62f63ef1fa64f"], "user": "rvandermeulen@mozilla.com"}, "29083": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081280.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334807\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335543\n", "files": ["layout/style/Loader.cpp", "testing/web-platform/tests/svg/as-image/external-resource-data-url-import-helper.sub.svg", "testing/web-platform/tests/svg/as-image/external-resource-data-url-import.sub.html"], "git_node": "31fed802166297579096aeeca4a15cace2ec59f1", "git_parents": ["efb0b13c8d8b403148921d0ac8b62f63ef1fa64f"], "node": "96c7491e98a048d1785d6e39d34e8279c2db3145", "parents": ["ab3f23073bf74275b7c4572e2a2d93fd4f7090f2"], "tags": []}], "date": 1792513480, "git_changesets": ["31fed802166297579096aeeca4a15cace2ec59f1"], "user": "rvandermeulen@mozilla.com"}, "29084": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082040.  a=RyanVM\n\nMake sure we're consistent about which state we call\nUpdateEmbeddedBrowsingContextDependentData in.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334853\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335540\n", "files": ["layout/generic/nsSubDocumentFrame.cpp"], "git_node": "9ae607ca261382d6d742a83bdb0cc22ff24b57a0", "git_parents": ["31fed802166297579096aeeca4a15cace2ec59f1"], "node": "ad95fc098eceffb4fc3c025af15545e9675b1c0c", "parents": ["96c7491e98a048d1785d6e39d34e8279c2db3145"], "tags": []}], "date": 1792513516, "git_changesets": ["9ae607ca261382d6d742a83bdb0cc22ff24b57a0"], "user": "rvandermeulen@mozilla.com"}, "29085": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2083514 - Deal with reframes of ancestors of replicated fixed-pos frames.  a=RyanVM\n\nSo the issue is that esr153 reframes the ::before and that means really\nreframing the originating element entirely, which is _not_ in the\nfixed-pos subtree. The WPT triggers the issue pre-patch on nightly and\ndoesn't depend on us eventually allowing reframing of individual pseudos\n(which is on file).\n\nMove the paginated bail-out sooner since it's the most aggressive one.\nOtherwise I'm guessing that if you hit the multicol case you might still\nbe able to trigger the original issue.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335133\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335545\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "testing/web-platform/tests/css/printing/fixed-generated-content-reconstruct-crash-print.html"], "git_node": "4bf636f4287935d7006b0f20c0c2313610df9d4d", "git_parents": ["9ae607ca261382d6d742a83bdb0cc22ff24b57a0"], "node": "b09dbb3452eb09085e15eca036398bf6726755a3", "parents": ["ad95fc098eceffb4fc3c025af15545e9675b1c0c"], "tags": []}], "date": 1792513554, "git_changesets": ["4bf636f4287935d7006b0f20c0c2313610df9d4d"], "user": "rvandermeulen@mozilla.com"}, "29086": {"changesets": [{"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075440 - Update PdfEmbedFallback:OpenPdf.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331960\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335572\n", "files": ["toolkit/components/pdfjs/content/PdfEmbedFallbackParent.sys.mjs"], "git_node": "ef20da33eacd874963ac61442a225177a66db3ba", "git_parents": ["4bf636f4287935d7006b0f20c0c2313610df9d4d"], "node": "7f94446e06b184589fafc5b22cbf8a8ae3e2ef4a", "parents": ["b09dbb3452eb09085e15eca036398bf6726755a3"], "tags": []}], "date": 1792513591, "git_changesets": ["ef20da33eacd874963ac61442a225177a66db3ba"], "user": "rvandermeulen@mozilla.com"}, "29087": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Expose arguments passed to host finalization registry cleanup callback  a=RyanVM\n\nCurrently we expose these when we are about to do the cleanup but this needs to\nhappen as soon as we queue the cleanup otherwise the cycle collector could free\nit before it is run.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332423\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335531\n", "files": ["js/src/gc/FinalizationObservers.cpp", "xpcom/base/CycleCollectedJSContext.cpp"], "git_node": "9241d43858c77d3cc4f9e2d7570f457e674b173a", "git_parents": ["ef20da33eacd874963ac61442a225177a66db3ba"], "node": "48752cea77046fce29288e94708ac3f371219d93", "parents": ["7f94446e06b184589fafc5b22cbf8a8ae3e2ef4a"], "tags": []}], "date": 1792513687, "git_changesets": ["9241d43858c77d3cc4f9e2d7570f457e674b173a"], "user": "rvandermeulen@mozilla.com"}, "29088": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080787 - Don't hold on to store buffer entry unnecessarily when tenuring strings  a=RyanVM\n\nSemispace nursery sets a flag |promotedToNursery| when a cell is promoted but\nstays in the nursery. This is used to detect when we need to keep a store\nbuffer entry around rather than discarding it after it's been traced.\n\nThe code in question performs a recursive tenuring operation on a dependent\nstring's base, which overwrites this flag. This can cause the store buffer\nentry to be kept after the pointer it contains is tenured. Subsequent post\nbarrier operations won't remove it for this reason and the memory holding it\ncan be freed, leading to UAF on the next nursery collection.\n\nThe fix is to preserve the flag over the recursive promotion call.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334074\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335538\n", "files": ["js/src/gc/Tenuring.cpp", "js/src/jit-test/tests/gc/bug-2080787.js"], "git_node": "b19624fee17e5d575a0ff3c33323ee22f4508b12", "git_parents": ["9241d43858c77d3cc4f9e2d7570f457e674b173a"], "node": "96533c00d072a721207866dd05dd97555caa2fff", "parents": ["48752cea77046fce29288e94708ac3f371219d93"], "tags": []}], "date": 1792513726, "git_changesets": ["b19624fee17e5d575a0ff3c33323ee22f4508b12"], "user": "rvandermeulen@mozilla.com"}, "29089": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Add testcase  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332424\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335532\n", "files": ["xpcom/tests/crashtests/bug-2079059.html", "xpcom/tests/crashtests/crashtests.list"], "git_node": "90c200edeac84b8862c4faa3237219d74da4970b", "git_parents": ["b19624fee17e5d575a0ff3c33323ee22f4508b12"], "node": "7de44eafa59c6dcd02b90720bff37b360f607736", "parents": ["96533c00d072a721207866dd05dd97555caa2fff"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079059 - Add testcase from related bug  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334020\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335533\n", "files": ["js/src/jit-test/tests/gc/bug-2081988.js"], "git_node": "671b4e9a139ef1af86976ba5aaf8b9ada2432664", "git_parents": ["90c200edeac84b8862c4faa3237219d74da4970b"], "node": "d83432537473d55e82ba2d26709e849a3fffdef0", "parents": ["7de44eafa59c6dcd02b90720bff37b360f607736"], "tags": []}], "date": 1792513952, "git_changesets": ["90c200edeac84b8862c4faa3237219d74da4970b", "671b4e9a139ef1af86976ba5aaf8b9ada2432664"], "user": "rvandermeulen@mozilla.com"}, "29090": {"changesets": [{"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079728 - Prefix the names of the content child processes with \"sandboxed_\".  a=RyanVM\n\nHyperOS's memory cleaner skips processes named \":sandboxed_*\", which\navoids it killing our content processes in the background and causing\ntab reloads. The applink startup test ignores the prefix like the\n\"_disable_art_image_\" tag.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332033\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335750\n", "files": ["mobile/android/docs/geckoview/contributor/native-debugging.md", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentDelegateMultipleSessionsTest.kt", "mobile/android/geckoview/src/main/AndroidManifest_overlay.jinja", "testing/performance/mobile-startup/android_startup_videoapplink.py"], "git_node": "1a0fcfe022c487a97b0ab989aa85b4b890f57d5f", "git_parents": ["671b4e9a139ef1af86976ba5aaf8b9ada2432664"], "node": "ff80deced5f33fcd48c332cebd80efa51c393032", "parents": ["d83432537473d55e82ba2d26709e849a3fffdef0"], "tags": []}], "date": 1792529981, "git_changesets": ["1a0fcfe022c487a97b0ab989aa85b4b890f57d5f"], "user": "rvandermeulen@mozilla.com"}, "29091": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-beta repo-update remote-settings mobile-merino-manifest ct-logs -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335785\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "2d23c857d84d1e7174409722e4efbf74d179b79d", "git_parents": ["1a0fcfe022c487a97b0ab989aa85b4b890f57d5f"], "node": "17366c3f0988b649b34afaaf15fa4cf8231f77df", "parents": ["ff80deced5f33fcd48c332cebd80efa51c393032"], "tags": []}], "date": 1792530015, "git_changesets": ["2d23c857d84d1e7174409722e4efbf74d179b79d"], "user": "rvandermeulen@mozilla.com"}, "29092": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079259 - Take stream from base channel  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334066\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335775\n", "files": ["dom/serviceworkers/ServiceWorkerPrivate.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/InterceptedHttpChannel.cpp"], "git_node": "4eb9af4fb54d955c157d981401718c9f25e0ce67", "git_parents": ["2d23c857d84d1e7174409722e4efbf74d179b79d"], "node": "23808bb4d94063b928087ea78df7ac058d3b1af3", "parents": ["17366c3f0988b649b34afaaf15fa4cf8231f77df"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079259 - Make DecryptingInputStream serialization safe after the inner stream is closed  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334067\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335776\n", "files": ["dom/quota/DecryptingInputStream.cpp", "dom/quota/DecryptingInputStream_impl.h", "dom/quota/test/gtest/TestEncryptedStream.cpp", "ipc/glue/InputStreamParams.ipdlh"], "git_node": "c718fbc4768f3ea7efc3b095025a34fabbf6b567", "git_parents": ["4eb9af4fb54d955c157d981401718c9f25e0ce67"], "node": "e30273592ef19b020c25a696a4557bddb6d4c992", "parents": ["23808bb4d94063b928087ea78df7ac058d3b1af3"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2079259 - test  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334068\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335777\n", "files": ["testing/web-platform/mozilla/tests/fetch/api/request/request-stream-service-worker.h2.html", "testing/web-platform/mozilla/tests/fetch/api/request/request-stream-service-worker.js"], "git_node": "aa86b02339ad7780284cd28d94aef11149d83cce", "git_parents": ["c718fbc4768f3ea7efc3b095025a34fabbf6b567"], "node": "33802d5e27a8b18a4d246584e81a9e7dc763a4d1", "parents": ["e30273592ef19b020c25a696a4557bddb6d4c992"], "tags": []}], "date": 1792530059, "git_changesets": ["4eb9af4fb54d955c157d981401718c9f25e0ce67", "c718fbc4768f3ea7efc3b095025a34fabbf6b567", "aa86b02339ad7780284cd28d94aef11149d83cce"], "user": "rvandermeulen@mozilla.com"}, "29093": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Cherry-pick upstream libwebrtc commit f89edcb7be  a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f89edcb7be1f4be029ee7186e36b2b35ec03373e\n       [M155] Harden payload capacity and reduction checks in RTP packetizers\n\n       Original change's description:\n       \u003e Harden payload capacity and reduction checks in RTP packetizers\n       \u003e\n       \u003e Ensure packet reduction lengths cannot be negative when computing\n       \u003e payload limits in RTPSenderVideo and when determining needed payload\n       \u003e sizes during aggregation. Additionally, add a bounds check against\n       \u003e available payload capacity before copying aggregated fragments in\n       \u003e RtpPacketizerH265.\n       \u003e\n       \u003e Bug: chromium:567088927\n       \u003e Change-Id: Ibd57aacce9ef79379fa627903d4aed89c9fbf489\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506260\n       \u003e Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#48750}\n\n       (cherry picked from commit fc6666263eafa63878d02102189e3dabe9c90455)\n\n       Bug: chromium:567088927\n       Fixed: chromium:567812426\n       Change-Id: Ibd57aacce9ef79379fa627903d4aed89c9fbf489\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506600\n       Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n       Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Cr-Commit-Position: refs/branch-heads/8059@{#2}\n       Cr-Branched-From: 8d208e76fb1ad2b92d557f752e9d1d7d49059efa-refs/heads/main@{#48593}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335554\n", "files": ["third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_h264.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_h264_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_format_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packetizer_h265.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_packetizer_h265_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/moz-patch-stack/f89edcb7be.no-op-cherry-pick-msg"], "git_node": "830d9ad8ca3f21d91c764fd95995bc5dc3cbc6fe", "git_parents": ["aa86b02339ad7780284cd28d94aef11149d83cce"], "node": "ff35074d1346af2d03e336fd12d95f320a17cfd3", "parents": ["33802d5e27a8b18a4d246584e81a9e7dc763a4d1"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Cherry-pick upstream libwebrtc commit d5c7a213b9  a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d5c7a213b976fdf43cc17ce490676d2d4a8a1e86\n       [M155] Ensure stopped transceivers do not hold a channel\n\n       Original change's description:\n       \u003e Ensure stopped transceivers do not hold a channel\n       \u003e\n       \u003e Make sure that a transceiver that has been stopped does not get a\n       \u003e channel during negotiation, and that any channel is cleared before a\n       \u003e stopped transceiver is removed from the transceiver list.\n       \u003e\n       \u003e Bug: chromium:565742177\n       \u003e Change-Id: I63251adef97c03644d499ad95baa244033f6678e\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/505661\n       \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       \u003e Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#48722}\n\n       (cherry picked from commit 82df4ce4226de25e1682351d7ba2e9bf9a198790)\n\n       Bug: chromium:565742177\n       Fixed: chromium:567398117\n       Change-Id: I63251adef97c03644d499ad95baa244033f6678e\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506400\n       Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n       Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       Cr-Commit-Position: refs/branch-heads/8059@{#3}\n       Cr-Branched-From: 8d208e76fb1ad2b92d557f752e9d1d7d49059efa-refs/heads/main@{#48593}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335555\n", "files": ["third_party/libwebrtc/moz-patch-stack/d5c7a213b9.no-op-cherry-pick-msg", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/sdp_offer_answer.cc", "third_party/libwebrtc/pc/sdp_offer_answer_unittest.cc"], "git_node": "18a6cc2b8fc351cd25e90d5b316bf01378ba9e93", "git_parents": ["830d9ad8ca3f21d91c764fd95995bc5dc3cbc6fe"], "node": "5a6bd85d0a8319413f88e657694bf5da8be3cf3a", "parents": ["ff35074d1346af2d03e336fd12d95f320a17cfd3"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081535 - Cherry-pick upstream libwebrtc commit 5bd86a2f17  a=RyanVM\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5bd86a2f17a35dfc986b87d058f511e45805bd1d\n       [M155] Keep transceiver MID in sync with its channel\n\n       Original change's description:\n       \u003e Keep transceiver MID in sync with its channel\n       \u003e\n       \u003e When applying a local description, a transceiver could be matched to an\n       \u003e m= section by its index even if it was already associated with a\n       \u003e different MID. The channel of the transceiver keeps using the MID it was\n       \u003e created for, so the two could get out of sync.\n       \u003e\n       \u003e - Only match transceivers that are not yet associated by m= section\n       \u003e   index.\n       \u003e - Route transport changes to a transceiver based on the MID of its\n       \u003e   channel.\n       \u003e\n       \u003e Bug: chromium:567160162\n       \u003e Change-Id: Ic9f29b66a8f9f181fd414009f5c1e5cebfa9ca54\n       \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/506421\n       \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       \u003e Reviewed-by: Stefan Holmer \u003cstefan@webrtc.org\u003e\n       \u003e Cr-Commit-Position: refs/heads/main@{#48768}\n\n       (cherry picked from commit 7a25e1c85a0af15cae8a2d55bf02e5610bf1af53)\n\n       Bug: chromium:567160162\n       Fixed: chromium:569045198\n       Change-Id: Ic9f29b66a8f9f181fd414009f5c1e5cebfa9ca54\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/507140\n       Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n       Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n       Cr-Commit-Position: refs/branch-heads/8059@{#4}\n       Cr-Branched-From: 8d208e76fb1ad2b92d557f752e9d1d7d49059efa-refs/heads/main@{#48593}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335556\n", "files": ["third_party/libwebrtc/moz-patch-stack/5bd86a2f17.no-op-cherry-pick-msg", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/rtp_transceiver.cc", "third_party/libwebrtc/pc/rtp_transceiver.h", "third_party/libwebrtc/pc/sdp_offer_answer.cc", "third_party/libwebrtc/pc/sdp_offer_answer_unittest.cc", "third_party/libwebrtc/pc/transceiver_list.cc", "third_party/libwebrtc/pc/transceiver_list.h"], "git_node": "87e6b4f97388c2db4c444e084b5c0722022d1004", "git_parents": ["18a6cc2b8fc351cd25e90d5b316bf01378ba9e93"], "node": "c541236a73f3ea5e7ecd53c872429bc844543ed8", "parents": ["5a6bd85d0a8319413f88e657694bf5da8be3cf3a"], "tags": []}], "date": 1792530105, "git_changesets": ["830d9ad8ca3f21d91c764fd95995bc5dc3cbc6fe", "18a6cc2b8fc351cd25e90d5b316bf01378ba9e93", "87e6b4f97388c2db4c444e084b5c0722022d1004"], "user": "rvandermeulen@mozilla.com"}, "29094": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082044.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335387\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335809\n", "files": ["layout/style/nsDOMCSSAttrDeclaration.cpp", "layout/