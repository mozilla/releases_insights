66307a040389b112781"], "node": "39fac05d6f6e9dcc0d671546c43a776661f6984f", "parents": ["76245e4e417531879d34e9cdc02d740df9cb8bc6"], "tags": []}], "date": 1792003866, "git_changesets": ["10d1a902035ec0c29f136a2d87e49d4bd9238b9c"], "user": "rvandermeulen@mozilla.com"}, "28950": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Don't debug system principal tabs when devtools.chrome.enabled is locked to false.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328619\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333802\n", "files": ["devtools/client/framework/devtools-browser.js", "devtools/client/framework/devtools.js", "devtools/client/framework/local-tab-commands-factory.js", "devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_chrome_debugging_disabled.js", "devtools/server/actors/watcher/browsing-context-helpers.sys.mjs", "devtools/server/actors/webbrowser.js", "devtools/shared/commands/commands-factory.js", "devtools/shared/commands/target/tests/browser_target_command_various_descriptors.js"], "git_node": "6da2d4f29295c4b57758bda3a226c77ef49f1511", "git_parents": ["10d1a902035ec0c29f136a2d87e49d4bd9238b9c"], "node": "0485a78d721dfddd8c1dfae063548e6f4dd81af5", "parents": ["39fac05d6f6e9dcc0d671546c43a776661f6984f"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Disable DevTools options checkboxes for locked prefs.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328620\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333803\n", "files": ["devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_options_locked_pref.js", "devtools/client/framework/toolbox-options.js"], "git_node": "ed418a6cd8ad0851f352edd47ee6cc10e6c91cb5", "git_parents": ["6da2d4f29295c4b57758bda3a226c77ef49f1511"], "node": "256134a588f37b30622dffb5c575fdf746dd5d06", "parents": ["0485a78d721dfddd8c1dfae063548e6f4dd81af5"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074589 - Hide the Inspect context menu item on system principal pages when devtools.chrome.enabled is locked to false.  ,mak  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328621\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333804\n", "files": ["browser/base/content/nsContextMenu.sys.mjs", "browser/base/content/test/browser-contextMenu/browser_contextmenu_inspect.js"], "git_node": "cc08d5a347505f140ec97fa5deed8efedfddf39b", "git_parents": ["ed418a6cd8ad0851f352edd47ee6cc10e6c91cb5"], "node": "6304facb0459dfb44d7b83ab4994fcddc372d3fa", "parents": ["256134a588f37b30622dffb5c575fdf746dd5d06"], "tags": []}], "date": 1792003894, "git_changesets": ["6da2d4f29295c4b57758bda3a226c77ef49f1511", "ed418a6cd8ad0851f352edd47ee6cc10e6c91cb5", "cc08d5a347505f140ec97fa5deed8efedfddf39b"], "user": "rvandermeulen@mozilla.com"}, "28951": {"changesets": [{"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2080185 - Pick image raster sizes at the scroll-invariant position WebRender snaps at  a=RyanVM\n\nWebRender moves display items out of the pre-scrolled coordinates Gecko\nauthors them in by the accumulated external scroll offset, and snaps them\nthere, re-applying the scroll offset rounded to whole device pixels. The\nraster size was picked by rounding the pre-scrolled rect, so for a rect with\na fractional device extent it depended on the sub-pixel phase of the scroll\noffset while the rect it is drawn into did not. Since bug 2070683 draws a\ntexture that is a pixel off 1:1 instead of stretching it, every repaint\nduring a scroll could alternate between the two sizes and visibly change\nthe image's shape.\n\nRead the offset back from the WebRender display list builder, so it is the\nsame accumulation it normalizes with, and round there instead. This also\nstops scrolling from requesting a new raster size for such images.\n\nimage-scrolled-fractional-raster-1 encoded the old behaviour, a raster a row\ntaller than the snapped rect drawn 1:1 and clipped; the raster now matches\nthe snapped rect.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332766\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333820\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender_api/src/display_list.rs", "layout/base/nsLayoutUtils.cpp", "layout/base/nsLayoutUtils.h", "layout/generic/nsImageFrame.cpp", "layout/painting/nsCSSRenderingBorders.cpp", "layout/painting/nsImageRenderer.cpp", "layout/reftests/image/reftest.list", "layout/svg/SVGImageFrame.cpp"], "git_node": "b2884532828d544f4ddf1dcd95d8efc12f0fac49", "git_parents": ["cc08d5a347505f140ec97fa5deed8efedfddf39b"], "node": "5bb6807f9eadf5873b15c896a64eae06b9af7ff6", "parents": ["6304facb0459dfb44d7b83ab4994fcddc372d3fa"], "tags": []}], "date": 1792007303, "git_changesets": ["b2884532828d544f4ddf1dcd95d8efc12f0fac49"], "user": "rvandermeulen@mozilla.com"}, "28952": {"changesets": [{"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079677 - Block scripts from running while notifying elements of legend change.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332143\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333250\n", "files": ["dom/html/HTMLFieldSetElement.cpp"], "git_node": "1b83d1511d5fddce3eb5bcf18ac2800d3723b392", "git_parents": ["b2884532828d544f4ddf1dcd95d8efc12f0fac49"], "node": "fbbc5f2eda24d7956e88500d7aca7abcbaf7916d", "parents": ["5bb6807f9eadf5873b15c896a64eae06b9af7ff6"], "tags": []}], "date": 1792010026, "git_changesets": ["1b83d1511d5fddce3eb5bcf18ac2800d3723b392"], "user": "rvandermeulen@mozilla.com"}, "28953": {"changesets": [{"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2080040 - Wayback backed by Nimbus flag wayback-machine  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332277\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333430\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "55a5b1fac4a6ab0d98bfc3b2e7ff70d19197cb0e", "git_parents": ["1b83d1511d5fddce3eb5bcf18ac2800d3723b392"], "node": "fa89e7fe0fdb3a430c40a535e4e2bb6b1cb35404", "parents": ["fbbc5f2eda24d7956e88500d7aca7abcbaf7916d"], "tags": []}], "date": 1792018888, "git_changesets": ["55a5b1fac4a6ab0d98bfc3b2e7ff70d19197cb0e"], "user": "rvandermeulen@mozilla.com"}, "28954": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2081549 - ImageDocument should use the right token list,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333622\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333649\n", "files": ["dom/html/ImageDocument.cpp"], "git_node": "727f8e230b83b029837992c87005ed02931f907f", "git_parents": ["55a5b1fac4a6ab0d98bfc3b2e7ff70d19197cb0e"], "node": "c56ed8a193fefa948f87f3ff74766ce208ae69ff", "parents": ["fa89e7fe0fdb3a430c40a535e4e2bb6b1cb35404"], "tags": []}], "date": 1792018916, "git_changesets": ["727f8e230b83b029837992c87005ed02931f907f"], "user": "rvandermeulen@mozilla.com"}, "28955": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2079053 - Make sure that `HTMLEditor::CreateAnonymousElement` and `HTMLEditor::GetPositionAndDimensions` won't handle different document's node  a=RyanVM\n\nIf the target node of resizers etc was moved into another document\nwhile we're initializing the native anonymous nodes, we may start to\nput some anonymous nodes into the new target's owner document.\nTherefore, the methods should return error in the case to make the\ncaller abort the initialization.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332618\n\nDifferential Revision: https://phabricator.services.mozilla.com/D333933\n", "files": ["editor/libeditor/HTMLAnonymousNodeEditor.cpp"], "git_node": "91d4b1ba2f054dc1b1b2e66f83e77926ea2488d7", "git_parents": ["727f8e230b83b029837992c87005ed02931f907f"], "node": "4c3a73edbd990da8971edc0a381326bffd4c9571", "parents": ["c56ed8a193fefa948f87f3ff74766ce208ae69ff"], "tags": []}], "date": 1792022099, "git_changesets": ["91d4b1ba2f054dc1b1b2e66f83e77926ea2488d7"], "user": "rvandermeulen@mozilla.com"}, "28956": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from main\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-hy-rAM/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/focus-android/app/src/main/res/values-cs/strings.xml"], "git_node": "af8d19aac36aa41a442c04d2be59af3de256e81a", "git_parents": ["91d4b1ba2f054dc1b1b2e66f83e77926ea2488d7"], "node": "e9e66dbbafcc2990cd5dd0f01a9a6553e8f03ab1", "parents": ["4c3a73edbd990da8971edc0a381326bffd4c9571"], "tags": []}], "date": 1792030799, "git_changesets": ["af8d19aac36aa41a442c04d2be59af3de256e81a"], "user": "ffxbld@lando.moz.tools"}, "28957": {"changesets": [{"a