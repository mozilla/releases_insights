3_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "23d0b51b3caa6d3b05b99404235c43c8d787258e", "git_parents": ["3f191cd8e5684ab2b850dafe21e55926c310d39a"], "node": "c6cc7f183e328c0c25b6e351a58cd2859c556187", "parents": ["b5ffa69526cd4ba7538d1250424777d313cc1d6f"], "tags": []}], "date": 1792156076, "git_changesets": ["23d0b51b3caa6d3b05b99404235c43c8d787258e"], "user": "ffxbld@lando.moz.tools"}, "28985": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE DONTBUILD\n", "files": ["browser/config/version_display.txt", "mobile/android/version.txt"], "git_node": "7c1e66c248f99ebef3cf9b43c3267a0a9482e869", "git_parents": ["1d8347ae39a0738a1194db89027f41ffee14547a"], "node": "63e4ecf6fae0ff8d0d8e3e257e8c9f9cd5005158", "parents": ["c87b810aa1f3f79bc24bc4294061826c24051448"], "tags": []}], "date": 1792157856, "git_changesets": ["7c1e66c248f99ebef3cf9b43c3267a0a9482e869"], "user": "ffxbld@lando.moz.tools"}, "28986": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging c87b810aa1f3f79bc24bc4294061826c24051448 with FIREFOX-ANDROID_159_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "841567e2918fe15ea13388d9728a510136b39bdb", "git_parents": ["23d0b51b3caa6d3b05b99404235c43c8d787258e"], "node": "3d175a1d248687833d0a746abd6f472c3f658db3", "parents": ["c6cc7f183e328c0c25b6e351a58cd2859c556187"], "tags": []}], "date": 1792157876, "git_changesets": ["841567e2918fe15ea13388d9728a510136b39bdb"], "user": "ffxbld@lando.moz.tools"}, "28987": {"changesets": [{"author": "Willem Kaufmann \u003cwillem.kaufmann@gmail.com\u003e", "branch": "default", "desc": "Bug 2079806 - Shut down `CookieStore` when its global is torn down.  a=RyanVM\n\nWhile a window is in the `bfcache`, `CookieStoreNotifier` queues cookie\nchange events in `mDelayedDOMEvents`, and each event holds a strong\nreference to the window. When the `bfcache` entry was evicted, nothing\nreleased the queue. The notifier is not cycle collected, and\n`CookieStore::Shutdown()` only ran from unlink and the destructor, which\na page holding cookieStore never reached. As a result, the window leaked\nas a ghost window for the lifetime of its content process.\n\nShut the `CookieStore` down in `DisconnectFromOwner()` and clear the\nqueued events when the notifier is disentangled to prevent the leaks.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D332068\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334493\n", "files": ["dom/cookiestore/CookieStore.cpp", "dom/cookiestore/CookieStore.h", "dom/cookiestore/CookieStoreNotifier.cpp", "netwerk/cookie/test/browser/browser.toml", "netwerk/cookie/test/browser/browser_cookieStore_bfcache_leak.js"], "git_node": "9014d5cebc017440f4168ec7ca2bec3b20a3781f", "git_parents": ["7c1e66c248f99ebef3cf9b43c3267a0a9482e869"], "node": "d0c7728c2d325df26003a8bc6d519745013cc28f", "parents": ["63e4ecf6fae0ff8d0d8e3e257e8c9f9cd5005158"], "tags": []}], "date": 1792160594, "git_changesets": ["9014d5cebc017440f4168ec7ca2bec3b20a3781f"], "user": "rvandermeulen@mozilla.com"}, "28988": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2081262. Null check the solid color item in PresShell::AddCanvasBackgroundColorItem.  a=RyanVM\n\nMakeDisplayItem returns null when building an events-only list (eg inside an\nopacity: 0 stacking context), and we called SetIsCheckerboardBackground on it\nunconditionally.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333969\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334393\n", "files": ["layout/base/PresShell.cpp"], "git_node": "c93fb945df8477af6af2757eff2895ce52e04742", "git_parents": ["9014d5cebc017440f4168ec7ca2bec3b20a3781f"], "node": "55db46c22790958f80d6f188f5ff65f97bf6e962", "parents": ["d0c7728c2d325df26003a8bc6d519745013cc28f"], "tags": []}], "date": 1792160619, "git_changesets": ["c93fb945df8477af6af2757eff2895ce52e04742"], "user": "rvandermeulen@mozilla.com"}, "28989": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068395 - Make densifySparseElements update the initialized length infallibly.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334009\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334518\n", "files": ["js/src/vm/Iteration.cpp", "js/src/vm/NativeObject.cpp", "js/src/vm/NativeObject.h", "js/src/vm/Shape.cpp"], "git_node": "eeda7eb10b5912e1798b943da8fea1a8a7e63c94", "git_parents": ["c93fb945df8477af6af2757eff2895ce52e04742"], "node": "2bbe3243149da54cb03f8e325c8e44409bdb44dc", "parents": ["55db46c22790958f80d6f188f5ff65f97bf6e962"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068395 - Call the add-property hook before densifying sparse elements.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334010\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334519\n", "files": ["js/src/jit-test/tests/arrays/densify-sparse-oom.js", "js/src/vm/NativeObject.cpp"], "git_node": "04e08db8dc04a066b680f86901031f7facd4b925", "git_parents": ["eeda7eb10b5912e1798b943da8fea1a8a7e63c94"], "node": "6b524197ad9cbba0c1bf5614c7cc99f5b956711a", "parents": ["2bbe3243149da54cb03f8e325c8e44409bdb44dc"], "tags": []}], "date": 1792160662, "git_changesets": ["eeda7eb10b5912e1798b943da8fea1a8a7e63c94", "04e08db8dc04a066b680f86901031f7facd4b925"], "user": "rvandermeulen@mozilla.com"}, "28990": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 1: Change existing APIs to record atom references to allow wrapping  a=RyanVM\n\nSymbols may need to be wrapped when they are passed between zones. This changes\nthe internal and external APIs which currently update the atom reference bitmap\nto refer to wrapping symbols.\n\nThe existing external APIs are replaced by a shim over the new APIs. They are\nreplaced in a later patch.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331073\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334439\n", "files": ["js/public/Zone.h", "js/src/debugger/Debugger.cpp", "js/src/debugger/Environment.cpp", "js/src/debugger/Frame.cpp", "js/src/debugger/Object.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/proxy/CrossCompartmentWrapper.cpp", "js/src/shell/js.cpp", "js/src/vm/Compartment-inl.h", "js/src/vm/JSContext.h", "js/src/vm/SymbolType.cpp"], "git_node": "6928deb2bc7e1a8ac76b0df74563fbe1700895c7", "git_parents": ["04e08db8dc04a066b680f86901031f7facd4b925"], "node": "13da2dc9a1117b0e1754171f9e71ba1edb39df23", "parents": ["6b524197ad9cbba0c1bf5614c7cc99f5b956711a"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 2: Merge atom reference bitmap recordRef methods into JSContext  a=RyanVM\n\nThese will do more than just update the atom reference bitmap so merge these\ninto their JSContext callers.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331074\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334440\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h"], "git_node": "396ef2f6eb17a5375b2002675f7aabc66a59c625", "git_parents": ["6928deb2bc7e1a8ac76b0df74563fbe1700895c7"], "node": "e51d3a95bb727a45d6f618eab2d98a9325f2d7d9", "parents": ["13da2dc9a1117b0e1754171f9e71ba1edb39df23"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 3: Update the browser to call JS_WrapId function in place of JS_MarkCrossZoneId  a=RyanVM\n\nThis new function now also wraps symbols when appropriate. It is fallible\nunlike the function it replaces.\n\nUse of JS_MarkCrossZoneIdValue is replaced with JS_WrapValue.\n\nreview comments for patch 3\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331075\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334441\n", "files": ["dom/base/ChromeUtils.cpp", "dom/base/MaybeCrossOriginObject.cpp", "dom/base/nsGlobalWindowOuter.cpp", "dom/bindings/BindingUtils.h", "dom/bindings/Codegen.py", "js/public/Zone.h", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/vm/JSContext-inl.h", "js/xpconnect/src/ExportHelpers.cpp", "js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCWrappedNativeInfo.cpp", "js/xpconnect/src/XPCWrappedNativeJSOps.cpp", "js/xpconnect/wrappers/XrayWrapper.cpp"], "git_node": "867ce948eeb05c9683f8ae41fff154c03a62427c", "git_parents": ["396ef2f6eb17a5375b2002675f7aabc66a59c625"], "node": "c2fa3391b446c8752d1a967520a2119fdf9175c1", "parents": ["e51d3a95bb727a45d6f618eab2d98a9325f2d7d9"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 4: Extend JS::Symbol to support allocating per-zone wrappers  a=RyanVM\n\nAdds methods to query whether a symbol is shared (canonical, allocated in the\natoms zone) or local (a wrapper, not allocated in the atoms zone).\n\nThis changes the symbol header pointer for a local symbol to point to its\nshared symbol. For non-unique and shared symbols the header pointer\ncontinues to point to the description atom.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331076\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334442\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/Cell.h", "js/src/gc/TraceMethods-inl.h", "js/src/vm/SymbolType.cpp", "js/src/vm/SymbolType.h"], "git_node": "d652492e78d5278b3d9363d0425a1a51143d4cdb", "git_parents": ["867ce948eeb05c9683f8ae41fff154c03a62427c"], "node": "06fd2cd7f789876fd1c40e16b88e26476620417c", "parents": ["c2fa3391b446c8752d1a967520a2119fdf9175c1"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 5: Allocate local/shared symbol pairs for unique symbols and implement wrapping  a=RyanVM\n\nThis is the main patch that changes the way symbols are allocated. For unique\nsymbols we allocate a local symbol and make it point to a shared symbol. Local\nsymbols are wrapped when being moved between zones so that JS always sees the\nlocal symbol.\n\nTests are updated to take account of the fact that unqiue symbols are no longer\npresent in atom reference bitmap.\n\nNot using the atoms reference bitmap (which is quite conservative) means we can\ncollect symbols sooner in some cases.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331077\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334443\n", "files": ["js/src/builtin/FinalizationRegistryObject.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/builtin/WeakRefObject.cpp", "js/src/gc/Allocator.cpp", "js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/Cell.h", "js/src/gc/Marking.cpp", "js/src/gc/RootMarking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.h", "js/src/gc/Zone.cpp", "js/src/gc/Zone.h", "js/src/jit-test/tests/gc/bug-1994871.js", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/jit-test/tests/gc/bug-2029769.js", "js/src/jit-test/tests/gc/bug-2042465.js", "js/src/jit-test/tests/gc/bug-2061775.js", "js/src/jit-test/tests/gc/marked-atoms.js", "js/src/jit-test/tests/gc/symbols-as-weakmap-keys.js", "js/src/jit/VMFunctions.cpp", "js/src/jl", "js/src/proxy/Proxy.cpp", "js/src/shell/js.cpp", "js/src/vm/Compartment-inl.h", "js/src/vm/Compartment.cpp", "js/src/vm/EqualityOperations.cpp", "js/src/vm/JSAtomUtils.h", "js/src/vm/JSContext-inl.h", "js/src/vm/JSContext.cpp", "js/src/vm/SymbolType.cpp", "js/src/vm/SymbolType.h"], "git_node": "8fd59397ccb9698fc249dfb66b0340e12bb316b6", "git_parents": ["d652492e78d5278b3d9363d0425a1a51143d4cdb"], "node": "f70812b05a99b469eb6fe94de7b98b01441e4662", "parents": ["06fd2cd7f789876fd1c40e16b88e26476620417c"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 6: Add some tests to exercise symbols being passed between zones  a=RyanVM\n\nI think our existing tests already cover most of this but having some explicit\ntests for this can't hurt.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331078\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334444\n", "files": ["js/src/jit-test/tests/gc/symbol-cross-zone-identity.js", "js/src/jit-test/tests/gc/symbol-cross-zone-weakref-finalization.js"], "git_node": "408af872fba8a92c48638846222c1f3200471cdf", "git_parents": ["8fd59397ccb9698fc249dfb66b0340e12bb316b6"], "node": "7e0dc1863c76c8024900df6b089d6647c056787e", "parents": ["f70812b05a99b469eb6fe94de7b98b01441e4662"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 7: Add a ref to the symbol description in getters  a=RyanVM\n\nI'm not sure why this wasn't already present. We need to add a ref to the\ndescription atom in the current zone when returning it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331079\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334445\n", "files": ["js/public/Symbol.h", "js/src/builtin/Symbol.cpp", "js/src/jit-test/tests/gc/symbol-description-atom-ref.js", "js/src/jsapi-tests/testSymbol.cpp", "js/src/jsapi.cpp"], "git_node": "0b60c7d9620a9da21f42d9c492e20fd46a930804", "git_parents": ["408af872fba8a92c48638846222c1f3200471cdf"], "node": "9853e463ef145c5b1a61dc62cdae2561f6babc71", "parents": ["7e0dc1863c76c8024900df6b089d6647c056787e"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 8: Fix gdb tests to understand the new symbol layout  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331080\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334446\n", "files": ["js/src/gdb/mozilla/CellHeader.py", "js/src/gdb/mozilla/GCCellPtr.py", "js/src/gdb/mozilla/JSSymbol.py", "js/src/gdb/mozilla/prettyprinters.py"], "git_node": "786121905d558a681469eb6de3a6dadba2a5cea0", "git_parents": ["0b60c7d9620a9da21f42d9c492e20fd46a930804"], "node": "988945ed75611b15efe9395484459b8f01bec321", "parents": ["9853e463ef145c5b1a61dc62cdae2561f6babc71"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 9: Stop tracking gray references in atom reference bitmap  a=RyanVM\n\nThis updates APIs to remove references to cell color and removes updating gray\nsymbol references in marking.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331081\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334447\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Marking.cpp", "js/src/gc/Verifier.cpp", "js/src/jit-test/tests/gc/bug-1994871.js", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/vm/JSContext-inl.h"], "git_node": "5c9e68557d0d2b1f1b4a5939fdf53b64db46afb0", "git_parents": ["786121905d558a681469eb6de3a6dadba2a5cea0"], "node": "3141e33aa8dcab0e47f5d167042b7031a71c061b", "parents": ["988945ed75611b15efe9395484459b8f01bec321"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075296 - Part 10: Add tests from related bugs  a=RyanVM\n\nOriginal Revisi