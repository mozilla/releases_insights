de": "f99d216ed25c9376df1e98a72b1f4e5ec1a0510b", "git_parents": ["7eb0e032200fd2b37b5beac0ec7a9edac4a64a95"], "node": "82bdceb60937ad5e8c1b467a4e8d7292b1ef9c01", "parents": ["ffbe619f97d2609b9d4e71235e3971c863624b4a"], "tags": []}], "date": 1792419787, "git_changesets": ["f99d216ed25c9376df1e98a72b1f4e5ec1a0510b"], "user": "rvandermeulen@mozilla.com"}, "29051": {"changesets": [{"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Add tests for the legacy POSIX time zones EST5EDT, CST6CDT, MST7MDT, and PST8PDT  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334162\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335142\n", "files": ["js/src/tests/non262/Date/realm-time-zone-legacy-posix.js", "js/src/tests/non262/Date/time-zones-legacy-posix.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_legacy_posix.js"], "git_node": "134351d22745f38e9c62a82bea6fd27dc396b39a", "git_parents": ["f99d216ed25c9376df1e98a72b1f4e5ec1a0510b"], "node": "da0a4710411074ea2ada4f119ff0713b8ea2664d", "parents": ["82bdceb60937ad5e8c1b467a4e8d7292b1ef9c01"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Update tzdata to 2026e  a=RyanVM\n\nThis is a mechanical update done through `./update-tzdata.sh 2026e`\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334163\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335143\n", "files": ["config/external/icu/data/icudt78l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/timezoneTypes.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/timezoneTypes.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/timezoneTypes.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/timezoneTypes.txt", "intl/tzdata/source/zoneinfo64.txt"], "git_node": "9f8a063b5a33b8d9bc5b6af25ab2940e6229b889", "git_parents": ["134351d22745f38e9c62a82bea6fd27dc396b39a"], "node": "f1cde7b7097f884085245aafb42b459daf835711", "parents": ["da0a4710411074ea2ada4f119ff0713b8ea2664d"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - SpiderMonkey update tz_data  a=RyanVM\n\nThis is a mechanical update via `make_intl_data.py tzdata`\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334164\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335144\n", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "daee3cc23a43641a8eb637d5a2a3b96af0378637", "git_parents": ["9f8a063b5a33b8d9bc5b6af25ab2940e6229b889"], "node": "bf62f3b1d75a1143c69f22f1b53a77e2302ce4bd", "parents": ["f1cde7b7097f884085245aafb42b459daf835711"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Make the ICU data hash visible to the build system to avoid caching failures.  a=RyanVM\n\nI encountered failures with both sccache and buildcache beause the sccache and buildcache don't have semantic tracking through the .incbin inside the .S file, causing both tools to return out of date object files from the caches.\n\nTo fix this we add icu_dat_hashed.S to the sources list, and generate that from icu_data.S + the hash of the data file.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334165\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335145\n", "files": ["config/external/icu/data/icu_data.S", "config/external/icu/data/icu_data_hash.py", "config/external/icu/data/moz.build"], "git_node": "51cc5fb0a1dbbe8d85c33e36af6037fd80530155", "git_parents": ["daee3cc23a43641a8eb637d5a2a3b96af0378637"], "node": "8a14c81e8273cb5e6c4b6b6b5dc153b8bd937670", "parents": ["bf62f3b1d75a1143c69f22f1b53a77e2302ce4bd"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079869 - Ensure EST5EDT, CST6CDT, MST7MDT, and PST8PDT are not exposed as canonical time zone ids to the web  a=RyanVM\n\nSpecial case these in make_intl_data.py\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334166\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335146\n", "files": ["js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/builtin/intl/make_intl_data.py", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "3f385e040f214e9c904483b3caa3dc4cbc4bf970", "git_parents": ["51cc5fb0a1dbbe8d85c33e36af6037fd80530155"], "node": "bbafdd82729a54efe17ca1d2563d84a701923cc3", "parents": ["8a14c81e8273cb5e6c4b6b6b5dc153b8bd937670"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058419 - Map legacy POSIX names to corresponding city zones  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334167\n\nDifferential Revision: https://phabricator.services.mozilla.com/D335147\n", "files": ["js/src/vm/DateTime.cpp"], "git_node": "136d70672bb8f45d661f954bb07cc5922faf1b90", "git_parents": ["3f385e040f214e9c904483b3caa3dc4cbc4bf970"], "node": "eae25fa29a413b3669af6b47ca0887555d3aeca8", "parents": ["bbafdd82729a54efe17ca1d2563d84a701923cc3"], "tags": []}], "date": 1792419899, "git_changesets": ["134351d22745f38e9c62a82bea6fd27dc396b39a", "9f8a063b5a33b8d9bc5b6af25ab2940e6229b889", "daee3cc23a43641a8eb637d5a2a3b96af0378637", "51cc5fb0a1dbbe8d85c33e36af6037fd80530155", "3f385e040f214e9c904483b3caa3dc4cbc4bf970", "136d70672bb8f45d661f954bb07cc5922faf1b90"], "user": "rvandermeulen@mozilla.com"}, "29052": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 6b01f55b37938d2c57530fadb14664b20abc61c9 with DEVEDITION_159_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "c9fcb6abe13c50c9381b4897de119d360a3816ec", "git_parents": ["31d86d7b29ca686ad9a8c227cf9bb3f314057955"], "node": "549b23ae58bb6b117ad52738773e8fe5615c95f1", "parents": ["268a472dd3acdc96d4adaab7a9c01f951e372a64"], "tags": []}], "date": 1792424927, "git_changesets": ["c9fcb6abe13c50c9381b4897de119d360a3816ec"], "user": "ffxbld@lando.moz.tools"}, "29053": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 6b01f55b37938d2c57530fadb14664b20abc61c9 with FIREFOX_159_0b4_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "cadbb9aee57c5725f25b351560cc84c810beb04d", "git_parents": ["c9fcb6abe13c50c9381b4897de119d360a3816ec"], "node": "c7c1b8c8b060791ce45c3044499e57c0ad67eea3", "parents": ["549b23ae58bb6b117ad52738773e8fe5615c95f1"], "tags": []}], "date": 1792426431, "git_changesets": ["cadbb9aee57c5725f25b351560cc84c810beb04d"], "user": "ffxbld@lando.moz.tools"}, "29054": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082376: When handling a query for an MSAA id, skip any top level remote docs that are print docs.  a=diannaS\n\nPrint documents aren't exposed to platform accessibility APIs, so they don't get an MsaaDocAccessible.\nPreviously, we assumed all documents had an MsaaDocAccessible and thus crashed when we encountered a print doc.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334399\n\nDifferential Revision: https://phabricator.services.mo