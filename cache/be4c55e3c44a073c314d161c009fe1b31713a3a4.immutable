0c99443a6d1ec0c5ee2b52441563464a1bcb642"], "node": "bbc62c9ca72c87dfa50c433bc58e447f8864e5db", "parents": ["1c5dc73a8caf93c582fbbd2a0e92c80e3fe8093d"], "tags": []}], "date": 1792314218, "git_changesets": ["c0c99443a6d1ec0c5ee2b52441563464a1bcb642", "ddd8c5e799de0a039189a5b2dfcdc7a3c922749c"], "user": "ffxbld@lando.moz.tools"}, "29026": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082311 - Make \u003ciframe\u003e and friends inert in \u003csvg:use\u003e.  a=RyanVM\n\nLower risk fix.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334015\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334974\n", "files": ["dom/html/nsGenericHTMLFrameElement.cpp", "testing/web-platform/tests/svg/struct/scripted/use-iframe-onload.html"], "git_node": "c4be53b75da42002fcff62631e0d9594a2acc66a", "git_parents": ["ddd8c5e799de0a039189a5b2dfcdc7a3c922749c"], "node": "fa3a216419cd34d9cbc35e25881c446747d09e0f", "parents": ["bbc62c9ca72c87dfa50c433bc58e447f8864e5db"], "tags": []}], "date": 1792347353, "git_changesets": ["c4be53b75da42002fcff62631e0d9594a2acc66a"], "user": "rvandermeulen@mozilla.com"}, "29027": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079522 - Improve SafeThreadLocal behavior for threads without TLS  a=RyanVM\n\nThreads created with THREAD_CREATE_FLAGS_SKIP_LOADER_INIT or as parallel\nloader workers never get a TLS vector.  SafeThreadLocal assumed every\nnon-main thread had one, causing NULL derefs in get() and set().  This\ncrashed in the addition of TakePendingFileHandle(), since every section\nmapping reads the slot, and it has long crashed in\nModuleLoadFrame::ExistsTopFrame and the ModuleLoadFrame constructor, when\ndealing with some AV-created threads.\n\nThis patch:\n\n1. Treats these threads as having no frame and no pending handle\n2. Does not improperly use the main thread's global slot for a second caller\n3. Closes a duplicate patched_NtCreateSection could not stash due to missing\n   TLS.\n\nA thread that has stored nothing now also reads nothing.  Previously, before\nany thread had used TLS, other threads read the main thread's live frame\npointer and kept it in their own slot after it went out of scope.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331831\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334914\n", "files": ["browser/app/winlauncher/freestanding/DllBlocklist.cpp", "browser/app/winlauncher/freestanding/SafeThreadLocal.h", "browser/app/winlauncher/test/TestSafeThreadLocal.cpp"], "git_node": "9abd06e3e4c0391f71307c9874cb75345070e57d", "git_parents": ["c4be53b75da42002fcff62631e0d9594a2acc66a"], "node": "8442c97abfa8a73e443b09d369cf746f90de8bb7", "parents": ["fa3a216419cd34d9cbc35e25881c446747d09e0f"], "tags": []}], "date": 1792347385, "git_changesets": ["9abd06e3e4c0391f71307c9874cb75345070e57d"], "user": "rvandermeulen@mozilla.com"}, "29028": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2071733 - Update FFmpeg decoded frame plane handling.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D326035\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334906\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoUtils.h"], "git_node": "7679edefb06c45e89293297fe18f757960d9a60f", "git_parents": ["9abd06e3e4c0391f71307c9874cb75345070e57d"], "node": "bd1299273827e4372121870115e58a2f391f4f66", "parents": ["8442c97abfa8a73e443b09d369cf746f90de8bb7"], "tags": []}], "date": 1792347421, "git_changesets": ["7679edefb06c45e89293297fe18f757960d9a60f"], "user": "rvandermeulen@mozilla.com"}, "29029": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2081959 - Store filename and FontData directly in SharedFTFace.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334389\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334915\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/2d/NativeFontResourceFreeType.cpp", "gfx/2d/NativeFontResourceFreeType.h", "gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2FontBase.h", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h"], "git_node": "1010e01a74e3fdf34e5ea1ac13c01ee308b72e71", "git_parents": ["7679edefb06c45e89293297fe18f757960d9a60f"], "node": "2c30c2cc9091eb039bd9fc842348ab29588626ff", "parents": ["bd1299273827e4372121870115e58a2f391f4f66"], "tags": []}], "date": 1792347457, "git_changesets": ["1010e01a74e3fdf34e5ea1ac13c01ee308b72e71"], "user": "rvandermeulen@mozilla.com"}, "29030": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2082009 - Don't lose NS_FRAME_GENERATED_CONTENT bit when replicating headers/fixed frames.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334609\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334901\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/printing/fixed-generated-content-whitespace-crash-print.html", "testing/web-platform/tests/css/printing/repeated-generated-content-whitespace-crash-print.html"], "git_node": "6bf05b33ce33c7578c1e0c39fdbf1a6d954a92ef", "git_parents": ["1010e01a74e3fdf34e5ea1ac13c01ee308b72e71"], "node": "375da486ef75d2dd2dc742dbc76f8fd3090ebb29", "parents": ["2c30c2cc9091eb039bd9fc842348ab29588626ff"], "tags": []}], "date": 1792347494, "git_changesets": ["6bf05b33ce33c7578c1e0c39fdbf1a6d954a92ef"], "user": "rvandermeulen@mozilla.com"}, "29031": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082762 - Cache component bounds to avoid exponential work traversing COLRv1 paint graph.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334765\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334932\n", "files": ["gfx/thebes/COLRFonts.cpp"], "git_node": "32136f761d97ff4642a0a2a571e68807bd59c1a4", "git_parents": ["6bf05b33ce33c7578c1e0c39fdbf1a6d954a92ef"], "node": "e68ae0b74a11c8c885d90f9db1e801cccb42dbfa", "parents": ["375da486ef75d2dd2dc742dbc76f8fd3090ebb29"], "tags": []}], "date": 1792347561, "git_changesets": ["32136f761d97ff4642a0a2a571e68807bd59c1a4"], "user": "rvandermeulen@mozilla.com"}, "29032": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2081016 - Fix root scroll restoration when repeatedly reframing.  a=RyanVM\n\nSo the reason this doesn't happen on the first reframe is because we hit\nthe \"visual viewport is set\" case. It's unclear to me why we're clearing\nthe visual viewport when removing the root scrollframe, fwiw, but that\nhappened before, and I want this patch to be safe to uplift.\n\nWhat happen now is that by the time the root\nScrollContainerFrame::Destroy() runs, if the visual viewport is not set,\nwe fall through PresShell::GetLayoutViewportOffset(), which no longer\nfinds the root scrollframe. Before the regression, in\nContentWillBeRemoved we still hadn't cleared the root scrollframe.\n\nSince that is all just a very roundabout way of doing\nGetScrollPosition(), restore the behavior by just falling through when\nthe visual viewport offset is not set.\n\nI'll follow-up with why do we reframe here (ideally we shouldn't need\nto, at least on this reduced test-case...).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334850\n\nDifferential Revision: https://phabricator.services.mozilla.com/D334935\n", "files": ["layout/generic/ScrollContai