t_objectgrips-17.js"], "git_node": null, "git_parents": [null], "node": "769165a6b1247bd97b0d790aedf27a758a30d0cf", "parents": ["d5c0e2bba0f880676c93c65593d7bed21186568c"], "tags": []}, {"author": "Simon Fraser \u003csfraser@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570646 - Adjust timeout for repo_update task. r=RyanVM, a=release\n\nWorkaround until a longer term solution is found\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40616", "files": ["taskcluster/ci/repo-update/kind.yml"], "git_node": null, "git_parents": [null], "node": "3391c3a28e1822a4b074e30c5ab2a2d8af4e8fd5", "parents": ["769165a6b1247bd97b0d790aedf27a758a30d0cf"], "tags": []}, {"author": "Nathan Froyd \u003cfroydnj@mozilla.com\u003e", "branch": "default", "desc": "Bug 1298602 - split condition in TestExpirationTracker; r=KrisWright, a=test-only\n\nThis condition is intermittently failing, but it's hard to tell from the\nfailure which part of the condition is failing.  Split the condition\napart so ideally we'll get some better error messages.  While we're\ndoing that, use a more explicit `EXPECT_LT` for the first half of the\ncondition for even better error messages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40051", "files": ["xpcom/tests/gtest/TestExpirationTracker.cpp"], "git_node": null, "git_parents": [null], "node": "c95ee7757d8a2fd4f802058d1cce25377b558c66", "parents": ["3391c3a28e1822a4b074e30c5ab2a2d8af4e8fd5"], "tags": []}, {"author": "Xidorn Quan \u003cme@upsuper.org\u003e", "branch": "default", "desc": "Bug 1541573 - Round coordinate passed to pointerMove. r=smaug, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40541", "files": ["testing/web-platform/meta/pointerlock/movementX_Y_basic.html.ini", "testing/web-platform/tests/pointerlock/movementX_Y_basic.html"], "git_node": null, "git_parents": [null], "node": "7c819d8e3eeb475b6e1a600485efef4c444af379", "parents": ["c95ee7757d8a2fd4f802058d1cce25377b558c66"], "tags": []}, {"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1370165 - demote shutil copy error to a warning. r=jmaher, a=test-only\n\nChanges:\n- if an error is raised in the vendored `shutil` when copying/moving a file to the target, log that error as a `WARNING`, not an `ERROR`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40914", "files": ["testing/mozharness/mozharness/base/script.py"], "git_node": null, "git_parents": [null], "node": "c11bf75afd184704bb2a56b6320fb75a8374c5a2", "parents": ["7c819d8e3eeb475b6e1a600485efef4c444af379"], "tags": []}], "date": 1565785724, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "222": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ncy -\u003e 876e2f7ea2d2\ndsb -\u003e 5ff91dcf1ef6\nel -\u003e 76b58a997820\nhe -\u003e 192d8ca51e3d\nhsb -\u003e 1a962101d60e\nit -\u003e 6c13c3304433\nnl -\u003e cb6af9c8704b\nnn-NO -\u003e 0d29a70f6e27\ntr -\u003e 64492f97ba7b\nuk -\u003e 111f7ca96306\nzh-TW -\u003e 1ae10d6bcfdf", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "57d2126a27bfd234e339f4b9aef8c9c164a02dbb", "parents": ["c11bf75afd184704bb2a56b6320fb75a8374c5a2"], "tags": []}], "date": 1565787646, "git_changesets": [null], "user": "ffxbld"}, "223": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f1258d45d4b5afc9bfce3bee18e09f7247b66f60 with FENNEC_68_0_2_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "3d02086b8d433bfae05c2a20f6f38a5f0926da23", "parents": ["57d2126a27bfd234e339f4b9aef8c9c164a02dbb"], "tags": []}], "date": 1565792916, "git_changesets": [null], "user": "ffx