03e 2a67f2a71ce4", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "83b51494917d857f6226350ad7e92a4ae22651ed", "parents": ["b02ee9dac2ef1cc26e9d0117f82d36b1fd0f7958"], "tags": []}], "date": 1565611226, "git_changesets": [null], "user": "ffxbld"}, "205": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1569102 - Re-enable XMLDocument.async and XMLDocument.load for webcompat on the ESR. r=ehsan, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D41262", "files": ["modules/libpref/init/all.js", "testing/web-platform/meta/dom/__dir__.ini"], "git_node": null, "git_parents": [null], "node": "2b9b46b4c2278e309b3018514620e8c5e7d3753a", "parents": ["83b51494917d857f6226350ad7e92a4ae22651ed"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1568921 - Don't allow addons to be uninstalled from AMO if policy prevents it. r=aswan a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39902", "files": ["toolkit/mozapps/extensions/AddonManager.jsm", "toolkit/mozapps/extensions/test/browser/browser_webapi_uninstall.js"], "git_node": null, "git_parents": [null], "node": "1eb4ebf648394cb5b784aea47a23e4dceac61de0", "parents": ["2b9b46b4c2278e309b3018514620e8c5e7d3753a"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1537955 - Do not spoof DevicePixelRatio for pdfs. r=Ehsan, a=RyanVM\n\npdfs should not have a way to exfiltrate the true device pixel ratio,\nso it is safe to provide the correct value, enabling them to be rendered\ncorrectly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39994", "files": ["dom/base/nsGlobalWindowOuter.cpp"], "git_node": null, "git_parents": [null], "node": "5e336543485ae31653ae5591164157e271ee8c84", "parents": ["1eb4ebf648394cb5b784aea47a23e4dceac61de0"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1570861 - Editor should store text node in mCachedSelectionNode to pass previous selected node/offset to spell checker r=masayuki a=RyanVM\n\nWhen using `\u003ctextarea\u003e`, spell checker sometimes check spell when editing last text node. Because editor passes invalid previous selection node and offset via `HandleInlineSpellCheck`.\n\nAlthough previous selected node uses `mCachedSelectionNode` that is stored by `BeforeEdit`, when this occurs, it isn't text node.\n\nWhen editing last text node in `\u003ctextarea\u003e`, anchror node might be root node, not current text node. So we should use text node instead when this is inserting text operation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40368", "files": ["editor/libeditor/TextEditRules.cpp"], "git_node": null, "git_parents": [null], "node": "8c6187577b96c327231759de5662fb7a75f81483", "parents": ["5e336543485ae31653ae5591164157e271ee8c84"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1565919 - Don't separate words by contextual-based character. r=Ehsan a=RyanVM\n\nOriginal regression was by bug 1362858, and bug 1418629 wasn't enough to fix.\n\nBy bug 1362858, we use `CHAR_CLASS_SEPARATOR` in additional to DOM word separator. But some characters such as single quote, `@` and etc are `CHAR_CLASS_SEPARATOR`, so we may check spell by incomplete word.\n\nWe shouldn't separate word by characters that is email part, URL part or conditional punctuation.\n\nAnd I also update test cases for this situation. `\u003ctextarea\u003e` is better for spell checking since it can has multiple anonymous text nodes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39829", "files": ["editor/libeditor/tests/spellcheck.js", "editor/spellchecker/tests/test_bug1418629.html", "extensions/spellcheck/src/mozInlineSpellWordUtil.cpp"], "git_node": null, "git_parents": [null], "node": "61097b1f74adc0c4d165157edd534217604ccdb1", "parents": ["8c6187577b96c327231759de5662fb7a75f81483"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 1562033. r=alchen, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36361", "files": ["parser/html/javasrc/Tokenizer.java", "parser/html/javasrc/TreeBuilder.java", "parser/html/nsHtml5Tokenizer.cpp", "parser/html/nsHtml5Tokenizer.h", "parser/html/nsHtml5TreeBuilder.cpp"], "git_node": null, "git_parents": [null], "node": "747a334cde4680aa8dda94b0420ae215d4f218eb", "parents": ["61097b1f74adc0c4d165157edd534217604ccdb1"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570563 - Sync in xptcstubs code from x86_64 to x86_64_gnu. r=froydnj, a=RyanVM\n\nThis contains two changes. One is to zero out the top 56 bits for a bool\nconversion so we can pass bools correctly from cpp -\u003e js. This was also\nneeded in Bug 821628, 1513725\n\nThe other change copies the fix in Bug 689288 where we cast a float value\nas a double.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40686", "files": ["xpcom/reflect/xptcall/md/win32/xptcstubs_x86_64.cpp", "xpcom/reflect/xptcall/md/win32/xptcstubs_x86_64_gnu.cpp"], "git_node": null, "git_parents": [null], "node": "b70b483617617eb5e57da14ee196d5fc59c127d3", "parents": ["747a334cde4680aa8dda94b0420ae215d4f218eb"], "tags": []}], "date": 1565632850, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "206": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 1565744. r=kmag,bobowen a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39380", "files": ["dom/ipc/MemMapSnapshot.cpp"], "git_node": null, "git_parents": [null], "node": "16ef2c272cbf77343967a31c1ee48c1799653f05", "parents": ["b70b483617617eb5e57da14ee196d5fc59c127d3"], "tags": []}, {"author": "Ehsan Akhgari \u003cehsan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1572139 - Enable sending UI notifications for ETP on mobile. r=baku a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D41037", "files": ["browser/app/profile/firefox.js", "modules/libpref/init/StaticPrefList.h"], "git_node": null, "git_parents": [null], "node": "cc4a2709f59ec0c25001a485a94a720f249033a3", "parents": ["16ef2c272cbf77343967a31c1ee48c1799653f05"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 1559715 r=dholbert,mstange a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36874", "files": ["dom/svg/SVGFEImageElement.cpp"], "git_node": null, "git_parents": [null], "node": "5b8102992d772514fcde9893f86feaa7cd261685", "parents": ["cc4a2709f59ec0c25001a485a94a720f249033a3"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjib@mozilla.com\u003e", "branch": "default", "desc": "Bug 1564588 - No longer persist third-party permission. r=johannh a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40897", "files": ["browser/modules/webrtcUI.jsm"], "git_node": null, "git_parents": [null], "node": "a93c2d7350d3ba5034f03073c2d64003a57f382d", "parents": ["5b8102992d772514fcde9893f86feaa7cd261685"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjib@mozilla.com\u003e", "branch": "default", "desc": "Bug 1564588 - Add test for third-party permission prompt wo/remember this decision. r=johannh a=RyanVM\n\nDepends on D40897\n\nDifferential Revision: https://phabricator.services.mozilla.com/D41435", "files": ["browser/base/content/test/webrtc/browser.ini", "browser/base/content/test/webrtc/browser_devices_get_user_media_in_xorigin_frame.js", "browser/base/content/test/webrtc/get_user_media_in_xorigin_frame.html"], "git_node": null, "git_parents": [null], "node": "bb206bf4dc480c90e0c0d3ed1b