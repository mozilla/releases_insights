": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "29648c61a4160e4fc421651f50382d5e0eda6ff6", "parents": ["d569b0cf6ae65d99bbfe9a57abe30ddb57d79420"], "tags": []}], "date": 1565690432, "git_changesets": [null], "user": "ffxbld"}, "210": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nen-GB -\u003e 8d7c3c919497\nfy-NL -\u003e 55df0db64fd4\ngn -\u003e da70fe0da929\nit -\u003e 35f8b893883a\nkab -\u003e 898d8ba5bd3f\nnl -\u003e 8778d8361373\nsl -\u003e cd5717a00926\nsv-SE -\u003e 9c3e70585f76", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "f3a80a6227e66ba96c8db79c354e94cece2255b8", "parents": ["29648c61a4160e4fc421651f50382d5e0eda6ff6"], "tags": []}], "date": 1565697630, "git_changesets": [null], "user": "ffxbld"}, "211": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging bb206bf4dc480c90e0c0d3ed1b307afe8bfe3559 with FENNEC_68_1b6_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "124dc6d62719ddc5f102a6b772b10569c4467634", "parents": ["f3a80a6227e66ba96c8db79c354e94cece2255b8"], "tags": []}, {"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release DONTBUILD", "files": ["mobile/android/config/version-files/beta/version_display.txt"], "git_node": null, "git_parents": [null], "node": "36d007c4698e58a265aefe48c6527c1aa63d5a21", "parents": ["124dc6d62719ddc5f102a6b772b10569c4467634"], "tags": []}], "date": 1565705360, "git_changesets": [null, null], "user": "ffxbld"}, "212": {"changesets": [{"author": "Nathan Froyd \u003cfroydnj@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1298602 - split condition in TestExpirationTracker; r=KrisWright, a=test-only\n\nThis condition is intermittently failing, but it's hard to tell from the\nfailure which part of the condition is failing.  Split the condition\napart so ideally we'll get some better error messages.  While we're\ndoing that, use a more explicit `EXPECT_LT` for the first half of the\ncondition for even better error messages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40051", "files": ["xpcom/tests/gtest/TestExpirationTracker.cpp"], "git_node": null, "git_parents": [null], "node": "f1258d45d4b5afc9bfce3bee18e09f7247b66f60", "parents": ["caa1ef493a47165afb8cbecf076a00802839c142"], "tags": ["FENNEC_68_0_2_BUILD1", "FENNEC_68_0_2_RELEASE", "FIREFOX_68_0_2esr_BUILD1", "FIREFOX_68_0_2esr_RELEASE"]}], "date": 1565711738, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "213": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nes-AR -\u003e 15b65d4aeda6\nkab -\u003e dd3757109435\nmr -\u003e 91cc067b4d91\nnl -\u003e 6abd9bc80246\nnn-NO -\u003e bbf3a6624e9f\npl -\u003e 98d7e6d3e570\nru -\u003e be32d196c886\ntr -\u003e a3c080939f0f\nzh-CN -\u003e df6e2d921960", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "6cf8b84b6e4d9bdc619566701d25548fa8a2e9ad", "parents": ["36d007c4698e58a265aefe48c6527c1aa63d5a21"], "tags": []}], "date": 1565712057, "git_changesets": [null], "user": "ffxbld"}, "214": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f1258d45d4b5afc9bfce3bee18e09f7247b66f60 with FENNEC_68_0_2_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "4d31954eae1e3f60e5ec14d905e87f6dd2c7d149", "parents": ["6cf8b84b6e4d9bdc619566701d25548fa8a2e9ad"], "tags": []}], "date": 1565718963, "git_changesets": [null], "user": "ffxbld"}, "215": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging f1258d45d4b5afc9bfce3bee18e09f7247b66f60 with FIREFOX_68_0_2esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "255c886a12c3b2cf5a60c97c0cd9beab43bb44ef", "parents": ["4d31954eae1e3f60e5ec14d905e87f6dd2c7d149"], "tags": []}], "date": 1565719393, "git_changesets": [null], "user": "ffxbld"}, "216": {"changesets": [{"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555849 - part1 : use 'computeLine' to adjust cue's position when 'snap-to-lines' is false. r=heycam, a=RyanVM\n\nAccording to the spec 7.2.6 [1], we should use `computed line`, not `computed position`.\n\n[1] https://www.w3.org/TR/webvtt1/#ref-for-cue-computed-line-2\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33236", "files": ["dom/media/webvtt/vtt.jsm"], "git_node": null, "git_parents": [null], "node": "68cd88e3c87e489b98ecf200dc7e8dbe599dfb90", "parents": ["255c886a12c3b2cf5a60c97c0cd9beab43bb44ef"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555849 - part2 : enable wpt 'track-webvtt-non-snap-to-lines.html'. r=heycam, a=RyanVM\n\nWe made following changes for 'track-webvtt-non-snap-to-lines.html'.\n\n1. As the video is 300*150, testing file would put the cue on the place which is 20% of video's height (30px) below.\n2. The font size is defined as 5% of video's height (7.5px).\n3. As the cue is left alignment, so we also have to set `left=0`.\n4. In addition, there is no need to add padding.\n\nIn addition, this test would fail on Windows because there is a weird green background showing on the top of the text [1].\n\n[1] https://hg.mozilla.org/mozilla-central/raw-file/tip/layout/tools/reftest/reftest-analyzer.xhtml#logurl=https://queue.taskcluster.net/v1/task/NdZrHNWqTAiskV8QOcBFNA/runs/0/artifacts/public/logs/live_backing.log&only_show_unexpected=1\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33237", "files": ["testing/web-platform/meta/html/semantics/embedded-content/media-elements/track/track-element/track-webvtt-non-snap-to-lines.html.ini", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/track/track-element/track-webvtt-non-snap-to-lines-ref.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/track/track-element/track-webvtt-non-snap-to-lines.html"], "git_node": null, "git_parents": [null], "node": "c2179726f2fab3e8d1a5eb9c7fedb6b1714e23ae", "parents": ["68cd88e3c87e489b98ecf200dc7e8dbe599dfb90"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1568826 - Restrict the fix for bug 1549625 to cases where we have a zoomable viewport. r=tnikkel a=jcristau\n\nThe fix for bug 1549625 is only necessary in cases where the layout and\nvisual viewports can diverge (currently mobile, and later desktop zooming),\nbut it has caused regressions in desktop scenarios that don't involve zooming.\n\nWhile we can get a proper fix in place (tracked in bug 1543485), restricting\nthe existing fix to zoomable configurations mitigates the regressions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40473", "files": ["layout/generic/nsGfxScrollFrame.cpp"], "git_node": null, "git_parents": [null], "node": "866a2b70b04ce2f67cd601e34619b46870541334", "parents": ["c2179726f2fab3e8d1a5eb9c7fedb6b1714e23ae"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570673 - Add mochitest. r=bwc a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40597", "files": ["dom/media/tests/mochitest/mochitest.ini", "dom/media/tests/mochitest/test_peerConnection_disabledVideoPreNegotiation.html"], "git_node": null, "git_parents": [null], "node": "4a013bedd9b22e77f0a48b9afa98f5324afedafd", "parents": ["866a2b70b04ce2f67cd601e34619b46870541334"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570673 - Add an active state to VideoFrameConverter and propagate it from MediaPipeline. r=bwc, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40598", "files": ["dom/media/VideoFrameConverter.h", "dom/media/gtest/TestVideoFrameConverter.cpp", "media/webrtc/signaling/src/mediapipeline/MediaPipeline.cpp"], "git_node": null, "git_parents": [null], "node": "634e8c6ee7289c597156e34a9a69355fabe31b49", "parents": ["4a013bedd9b22e77f0a48b9afa98f5324afedafd"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570673 - Update last frame's time on same-frame-ticks. r=bwc a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40599", "files": ["dom/media/VideoFrameConverter.h", "dom/media/gtest/TestVideoFrameConverter.cpp"], "git_node": null, "git_parents": [null], "node": "23ede143e5f211d081b3f2e6f3924e4f872204e5", "parents": ["634e8c6ee7289c597156e34a9a69355fabe31b49"], "tags": []}, {"author": "Brad Arant \u003cbrad.arant@softvision.com\u003e", "branch": "default", "desc": "Bug 1565488 - Wrong panel from welcome screen is highlighted after clearing data. r=VladBaicu, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39797", "files": ["mobile/android/base/java/org/mozilla/gecko/home/TabMenuStripLayout.java"], "git_node": null, "git_parents": [null], "node": "cdf3353038f23539ac09e9cd021924f3bbd3af53", "parents": ["23ede143e5f211d081b3f2e6f3924e4f872204e5"], "tags": []}], "date": 1565752347, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "217": {"changesets": [{"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1538995 - support repacking stub installers for partners, r=aki\n\nPay attention to the new repack_stub_installer param, and fix config parsing to split on the first =.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34945", "files": ["taskcluster/taskgraph/transforms/partner_repack.py", "taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "d2cd89ac73b2c46ebc1d438c8301e9ceb34274bb", "parents": ["f1258d45d4b5afc9bfce3bee18e09f7247b66f60"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1538995 - adjust repackage jobs to create partner stub installers, r=aki\n\nOn win32, where repack_stub_installer is enabled, extend the inputs to the partner repackage task so that it\ndonwloads the upstream artifacts and creates the stub installer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34946", "files": ["taskcluster/taskgraph/transforms/repackage_partner.py"], "git_node": null, "git_parents": [null], "node": "6273bc3cc6bde763216ef570fc0a105b78bbc2ba", "parents": ["d2cd89ac73b2c46ebc1d438c8301e9ceb34274bb"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1538995 - adjust repackage-signing jobs to sign partner stub installers, r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34948", "files": ["taskcluster/taskgraph/transforms/repackage_signing_partner.py"], "git_node": null, "git_parents": [null], "node": "bb4a84c09eef0b129c8474087561d9bf7d49b32d", "parents": ["6273bc3cc6bde763216ef570fc0a105b78bbc2ba"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1538995 - adjust beetmover to copy partner stub installers into candidates dir, r=aki\n\nAppends the customized stub installer and it's gpg signature to the list of artifacts to beetmove to\ncandidates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34950", "files": ["taskcluster/taskgraph/transforms/beetmover_repackage_partner.py"], "git_node": null, "git_parents": [null], "node": "a5a2841b510778e2e3c9f8171671a1248e4b88eb", "parents": ["bb4a84c09eef0b129c8474087561d9bf7d49b32d"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1538995 - submit partner products to bouncer when we'll host the files, r=aki\n\nAdds a new release-partner-repack-bouncer-sub-firefox task to add the partner products. This is forked from the main bouncer submission because it diverges sufficiently that this is a cleaner approach. The get_partners_to_be_published helper is used by aliases too.\n\nDepends on D34950\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35481", "files": ["taskcluster/ci/release-partner-repack-bouncer-sub/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/bouncer_submission_partners.py", "taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "b84b90e102060caba321a3ca3b069eb138524122", "parents": ["a5a2841b510778e2e3c9f8171671a1248e4b88eb"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1538995 - pass list of partners to beetmover for pushing to releases/partners/, r=aki\n\nThis passes partner data on to the beetmover scriptworker, so it can publish enabled partners. There is beetmover change at https://github.com/mozilla-releng/beetmoverscript/pull/227 to complete this support.\n\nDepends on D35481\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35482", "files": ["taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "d5c5251e78829a6f1ad1c46ba7cc2b43e1a5a0ea", "parents": ["b84b90e102060caba321a3ca3b069eb138524122"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1538995 - update bouncer aliases for partner products when shipping, r=aki, a=release DONTBUILD\n\nPass partner aliases down to the bouncer scriptworker so it can update those too. Matching change to bouncerscript at https://github.com/mozilla-releng/bouncerscript/pull/57.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35483", "files": ["taskcluster/ci/release-bouncer-aliases/kind.yml", "taskcluster/taskgraph/transforms/bouncer_aliases.py"], "git_node": null, "git_parents": [null], "node": "98491bb3308e088bcfa76836c89f6e5fefa1ed0f", "parents": ["d5c5251e78829a6f1ad1c46ba7cc2b43e1a5a0ea"], "tags": []}], "date": 1565755167, "git_changesets": [null, null, null, null, null, null, null], "user": "nthomas@mozilla.com"}, "218": {"changesets": [{"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538995 - support repacking stub installers for partners, r=aki\n\nPay attention to the new repack_stub_installer param, and fix config parsing to split on the first =.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34945", "files": ["taskcluster/taskgraph/transforms/partner_repack.py", "taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "12d8eeacecafc57fcaa5e80a6e02271668107caf", "parents": ["cdf3353038f23539ac09e9cd021924f3bbd3af53"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538995 - adjust repackage jobs to create partner stub installers, r=aki\n\nOn win32, where repack_stub_installer is enabled, extend the inputs to the partner repackage task so that it\ndonwloads the upstream artifacts and creates the stub installer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34946", "files": ["taskcluster/taskgraph/transforms/repackage_partner.py"], "git_node": null, "git_parents": [null], "node": "9d7aaa2073ebdd12b11bdda2fe5647198d01e6a8", "parents": ["12d8eeacecafc57fcaa5e80a6e02271668107caf"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538995 - adjust repackage-signing jobs to sign partner stub installers, r=aki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34948", "files": ["taskcluster/taskgraph/transforms/repackage_signing_partner.py"], "git_node": null, "git_parents": [null], "node": "a820442c5336a3eea26fa5272a89842ae310908f", "parents": ["9d7aaa2073ebdd12b11bdda2fe5647198d01e6a8"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538995 - adjust beetmover to copy partner stub installers into candidates dir, r=aki\n\nAppends the customized stub installer and it's gpg signature to the list of artifacts to beetmove to\ncandidates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34950", "files": ["taskcluster/taskgraph/transforms/beetmover_repackage_partner.py"], "git_node": null, "git_parents": [null], "node": "36170c7f5599585b3c0bf9bfd903c23313806cb8", "parents": ["a820442c5336a3eea26fa5272a89842ae310908f"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538995 - submit partner products to bouncer when we'll host the files, r=aki\n\nAdds a new release-partner-repack-bouncer-sub-firefox task to add the partner products. This is forked from the main bouncer submission because it diverges sufficiently that this is a cleaner approach. The get_partners_to_be_published helper is used by aliases too.\n\nDepends on D34950\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35481", "files": ["taskcluster/ci/release-partner-repack-bouncer-sub/kind.yml", "taskcluster/docs/kinds.rst", "taskcluster/taskgraph/transforms/bouncer_submission_partners.py", "taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "7ac53fae934c2554c60193c89d4f5ff82efd00c5", "parents": ["36170c7f5599585b3c0bf9bfd903c23313806cb8"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538995 - pass list of partners to beetmover for pushing to releases/partners/, r=aki\n\nThis passes partner data on to the beetmover scriptworker, so it can publish enabled partners. There is beetmover change at https://github.com/mozilla-releng/beetmoverscript/pull/227 to complete this support.\n\nDepends on D35481\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35482", "files": ["taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "850da8e93200ddbb6690acb6f860efefdbb21154", "parents": ["7ac53fae934c2554c60193c89d4f5ff82efd00c5"], "tags": []}, {"author": "Nick Thomas \u003cnthomas@mozilla.com\u003e", "branch": "default", "desc": "Bug 1538995 - update bouncer aliases for partner products when shipping, r=aki, a=release DONTBUILD\n\nPass partner aliases down to the bouncer scriptworker so it can update those too. Matching change to bouncerscript at https://github.com/mozilla-releng/bouncerscript/pull/57.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35483", "files": ["taskcluster/ci/release-bouncer-aliases/kind.yml", "taskcluster/taskgraph/transforms/bouncer_aliases.py"], "git_node": null, "git_parents": [null], "node": "40717754884fa73cc11468409dafa1c403c1d3fa", "parents": ["850da8e93200ddbb6690acb6f860efefdbb21154"], "tags": []}], "date": 1565755354, "git_changesets": [null, null, null, null, null, null, null], "user": "nthomas@mozilla.com"}, "219": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nbe -\u003e 19d