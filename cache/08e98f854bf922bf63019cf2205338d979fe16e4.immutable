esets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nnn-NO -\u003e 96a5f058ae64\nzh-TW -\u003e 1a3f12719d4c", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "f5570f4b64c5a5595493cec66d500a23e74971c8", "parents": ["7ed09234cf2a069f133ce3edc40bcadc05533378"], "tags": []}], "date": 1565262030, "git_changesets": [null], "user": "ffxbld"}, "185": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nbg -\u003e e0f354f67a1b\nen-CA -\u003e 85a3e0621caf\nit -\u003e f568a19bce38\nsl -\u003e d245d5c20d63\nuk -\u003e eb6eef8f8d9e", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "0ceffd068da80d670c5bcfbafdb181e8344ebc5c", "parents": ["f5570f4b64c5a5595493cec66d500a23e74971c8"], "tags": []}], "date": 1565265630, "git_changesets": [null], "user": "ffxbld"}, "186": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nbg -\u003e 98c42c1e9342\nfy-NL -\u003e db7db7843be2\nhe -\u003e 1b927741911f\nhsb -\u003e 8c3b3fb70428\nhy-AM -\u003e 75d01c243a2d", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "eda1033358f19d5d93d38891889de78785b45e87", "parents": ["0ceffd068da80d670c5bcfbafdb181e8344ebc5c"], "tags": []}], "date": 1565276429, "git_changesets": [null], "user": "ffxbld"}, "187": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nzh-TW -\u003e 42496240628b", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "2fef84c90928cc2ec3097c767f14638686d4f0d7", "parents": ["eda1033358f19d5d93d38891889de78785b45e87"], "tags": []}], "date": 1565280055, "git_changesets": [null], "user": "ffxbld"}, "188": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ncs -\u003e b43111e64399\ngn -\u003e 2fff44c73ed6\nhy-AM -\u003e b3ffe097092e\nka -\u003e affb7f6852b5\npt-BR -\u003e 137caaff04c2\nsv-SE -\u003e 91b98358fa60\ntr -\u003e d3c710cf5140", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "8f6db73162410d061a910e446bc36e514b3a7f42", "parents": ["2fef84c90928cc2ec3097c767f14638686d4f0d7"], "tags": []}], "date": 1565290830, "git_changesets": [null], "user": "ffxbld"}, "189": {"changesets": [{"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566700 - Add File.OS macRemoveXAttr. r=Yoric a=jcristau\n\nAdd functionality to remove an extended attribute from a file. This\nfunctionality is currently MacOS specific due to that being the only use case we\ncurrently have (see bug 1566523).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38523", "files": ["toolkit/components/osfile/modules/osfile_async_front.jsm", "toolkit/components/osfile/modules/osfile_async_worker.js", "toolkit/components/osfile/modules/osfile_unix_back.jsm", "toolkit/components/osfile/modules/osfile_unix_front.jsm"], "git_node": null, "git_parents": [null], "node": "0e1f9c52cff05890f002113e65d16814b29c747b", "parents": ["8f6db73162410d061a910e446bc36e514b3a7f42"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566700 - Add functions to OS.File to set and get extended attributes on MacOS. r=Yoric a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38964", "files": ["toolkit/components/osfile/modules/osfile_async_front.jsm", "toolkit/components/osfile/modules/osfile_async_worker.js", "toolkit/components/osfile/modules/osfile_unix_back.jsm", "toolkit/components/osfile/modules/osfile_unix_front.jsm"], "git_node": null, "git_parents": [null], "node": "9465a474f587446afe64d978244bf1be2df826c1", "parents": ["0e1f9c52cff05890f002113e65d16814b29c747b"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566700 - Add tests for OS.File extended attribute MacOS functions. r=Yoric a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38965", "files": ["toolkit/components/osfile/tests/xpcshell/test_osfile_mac_async_xattr.js", "toolkit/components/osfile/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "ea19540ddf1af98d3d46fb473cdcfbcfb748ef60", "parents": ["9465a474f587446afe64d978244bf1be2df826c1"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566523 - Remove com.apple.quarantine from gmp downloads. r=dminor a=jcristau\n\nOn MacOS Firefox will add the com.apple.quarantine attribute to files it\ndownloads. Firefox does this as a safety measure to indicate to the OS that the\nfile may be from an untrusted source.\n\nWhile the attribute can be set prior to MacOS 10.15, the attribute is used to\nenforce new features in 10.15. This leads to issues where if we do not clear the\nattribute from GMPs we download, we will fail to load dynamic libs.\n\nThis patch means we will clear the quarantine from GMP downloads. These GMPs\ncome from a trusted source and are checksummed via hash.\n\nNote, most of the heavy lifting for this was done in bug 1566700. We just\nleverage the new API here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39369", "files": ["toolkit/modules/GMPExtractorWorker.js"], "git_node": null, "git_parents": [null], "node": "93b99b2bb3c0ad90333e51d5d9ec83b572a027ef", "parents": ["ea19540ddf1af98d3d46fb473cdcfbcfb748ef60"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1563994 - [10.15] Right Click When Not Focused Presents \"Keystroke Receiving\" Access Grant Request Dialog r=mstange a=jcristau\n\nUse addGlobalMonitorForEventsMatchingMask instead of CGEventTapCreate to monitor for mouse clicks outside of the application while context menus are displayed.\n\nUsing addGlobalMonitorForEventsMatchingMask prevents the display of the privacy \"Keystroke Receiving\" dialog when listening for mouse clicks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39973", "files": ["widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsToolkit.h", "widget/cocoa/nsToolkit.mm"], "git_node": null, "git_parents": [null], "node": "f3738b47741df2bad356120b036f9dd37890412b", "parents": ["93b99b2bb3c0ad90333e51d5d9ec83b572a027ef"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1568946 - Add better errors when addon install policy fails. r=aswan a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39398", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "8cf3ff9d2b1af1930a0ad13e76bdc7b7f218e432", "parents": ["f3738b47741df2bad356120b036f9dd37890412b"], "tags": []}, {"author": "Grisha Kruglov \u003cgkruglov@mozilla.com\u003e", "branch": "default", "desc": "Bug 1568605 - Send corrent Leanplum events during signin, signup and reconnect r=nalexander a=jcristau\n\nThis patch augments FxA messages sent to native code with just enough information that we are able\nto differentiate between \"signin\", \"signup\" and \"reconnect\" events.\n\nCorresponding Leanplum events are sent on the receiving end of the FxA messages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39989", "files": ["mobile/android/base/java/org/mozilla/gecko/AccountsHelper.java", "mobile/android/base/java/org/mozilla/gecko/mma/MmaDelegate.java", "mobile/android/modules/FxAccountsWebChannel.jsm"], "git_node": null, "git_parents": [null], "node": "3bb57b1847b939f2cc5765f17e2af18edfc2edf4", "parents": ["8cf3ff9d2b1af1930a0ad13e76bdc7b7f218e432"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1564449, ensure the right body element is used throughout the method call, r=mccr8 a=jcristau", "files": ["dom/html/ImageDocument.cpp", "dom/html/PluginDocument.cpp", "dom/html/VideoDocument.cpp"], "git_node": null, "git_parents": [null], "node": "9b7159c38798b229645547d4014ed2bc77193011", "parents": ["3bb57b1847b939f2cc5765f17e2af18edfc2edf4"], "tags": []}], "date": 1565299485, "git_changesets": [null, null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "190": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ndsb -\u003e ff2483e5897f\nhsb -\u003e c8c4818719c9\npt-PT -\u003e 72953b739b63\nsk -\u003e 82f291b546b4\ntrs -\u003e 9028b239ce12\nvi -\u003e 504e4b8652e8\nzh-CN -\u003e 19fdbe8d6d88", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "fa93c30e3a60d58d4e108c8e2db7cbefc803856f", "parents": ["9b7159c38798b229645547d4014ed2bc77193011"], "tags": []}], "date": 1565330437, "git_changesets": [null], "user": "ffxbld"}, "191": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nit -\u003e 169df3378c86", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "e11f396d3bd1252930a1ceb6209816fa2ed3ec05", "parents": ["fa93c30e3a60d58d4e108c8e2db7cbefc803856f"], "tags": []}], "date": 1565334032, "git_changesets": [null], "user": "ffxbld"}, "192": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\neu -\u003e 94d29483f64f\ngd -\u003e 6de51f7d03e4\nhe -\u003e e08749acbe73\nhu -\u003e ead9b8a5d794\nmr -\u003e 5f846e575f9f\nnl -\u003e 8c4311b11b76", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "fefac60b57fe65fb983d030df0f5b3e4a3ff3deb", "parents": ["e11f396d3bd1252930a1ceb6209816fa2ed3ec05"], "tags": []}], "date": 1565352035, "git_changesets": [null], "user": "ffxbld"}, "193": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1554949 - Fix WebRTC build failure with newer linux kernel. r=dminor, a=RyanVM DONTBUILD\n\nRecent kernel commit[1] moved a bit the define for this constant. This revealed\na missing include in WebRTC.\n\nI filed this upstream in:\n\n * https://bugs.chromium.org/p/webrtc/issues/detail?id=10677\n\nAnd sent a patch in:\n\n * https://webrtc-review.googlesource.com/c/src/+/138270\n\n[1]: https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=0768e17073dc5\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32809", "files": ["media/webrtc/trunk/webrtc/rtc_base/physicalsocketserver.cc"], "git_node": null, "git_parents": [null], "node": "03fe96d5969ac6885ca539bf7759780ed75a1375", "parents": ["e6cf9d0df0793e7f76cb2877989fc5aeca98e530"], "tags": []}], "date": 1565361669, "git_changesets": [null], "user": "jcristau@mozilla.com"}, "194": {"changesets": [{"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1572836 - Add comm-esr68 to list of release branches for signing scopes. rs+a=jorgk DONTBUILD\n\nTo fix build signing issues when releasing from comm-esr68.", "files": ["taskcluster/taskgraph/util/scriptworker.py"], "git_node": null, "git_parents": [null], "node": "0d2d8881be5ea5d83959650122af2c355a360549", "parents": ["6e07ed77a865bc811f4c3affa47fa5920e7d0323"], "tags": []}], "date": 1565379679, "git_changesets": [null], "user": "mozilla@jorgk.com"}, "195": {"changesets": [{"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570193 add install permission for proxy domain r=aswan a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40699", "files": ["browser/app/permissions"], "git_node": null, "git_parents": [null], "node": "7e61df6fb81da8aa810d43ec672d3b35735c9041", "parents": ["fefac60b57fe65fb983d030df0f5b3e4a3ff3deb"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1569244 - Only uninstall extensions if they are in the profile. r=kmag a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39539", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "4f44285f1b6e182003ccda5e293de54efe5c1c5b", "parents": ["7e61df6fb81da8aa810d43ec672d3b35735c9041"], "tags": []}, {"author": "Grisha Kruglov \u003cgkruglov@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570496 - Forward-compatible treatment of 'action' WebChannel payload param r=nalexander a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40118", "files": ["mobile/android/base/java/org/mozilla/gecko/AccountsHelper.java", "mobile/android/modules/FxAccountsWebChannel.jsm"], "git_node": null, "git_parents": [null], "node": "b870bfa864cdd810b63e5c7ddf7329afaad672ce", "parents": ["4f44285f1b6e182003ccda5e293de54efe5c1c5b"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1570848: When an OuterDocAccessible is constructed, send it as the parent COM proxy for its remote document (if any). ESR68 patch. r=MarcoZ a=jcristau\n\nNormally, the OuterDocAccessible is created first and the DocAccessibleParent for a remote document is created after that.\nSo, we get the OuterDocAccessible and call DocAccessibleParent::SendParentCOMProxy when the DocAccessibleParent is constructed (BrowserParent::RecvPDocAccessibleConstructor).\nHowever, sometimes, the OuterDocAccessible is created *after* the DocAccessibleParent.\nThis sometimes happens for extension popups, for example.\nPreviously, we called SendParentCOMProxy in the OuterDocAccessible constructor to deal with this case.\nUnfortunately, this was a no-op because SendParentCOMProxy called DocAccessible::GetAccessible for the frame element, which would have returned null because the accessible isn't bound to the document until *after* it is constructed.\nThat meant we never actually sent the COM proxy for this case.\nAside from leaving the remote document with a null parent, this also meant we never sent any events for the document, since events are buffered for remote documents until the parent COM proxy is received.\nThis effectively left the remote document (e.g. extension popup) inaccessible.\n\nNow, SendParentCOMProxy takes an OuterDocAccessible and the OuterDocAccessible constructor passes itself to SendParentCOMProxy.\nNote that this doesn't result in duplicates because if the OuterDocAccessible was created first, there won't be a DocAccessibleParent for the remote document yet, so this code won't run.\n\nThat said, if the OuterDocAccessible is recreated (e.g. due to frame reconstruction), we may call SendParentCOMProxy again.\nThis should be okay, but it required an assertion in DocAccessibleChild::RecvParentCOMProxy to be tweaked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D41309", "files": ["accessible/generic/OuterDocAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "accessible/ipc/win/DocAccessibleChild.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": null, "git_parents": [null], "node": "67fba999b1f211948ea6f4c0f00bd8e93d05a8c5", "parents": ["b870bfa864cdd810b63e5c7ddf7329afaad672ce"], "tags": []}], "date": 1565380015, "git_changesets": [null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "196": {"changesets": [{"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1570193 add install permission for proxy domain r=aswan a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D40699", "files": ["browser/app/permissions"], "git_node": null, "git_parents": [null], "node": "caa1ef493a47165afb8cbecf076a00802839c142", "parents": ["03fe96d5969ac6885ca539bf7759780ed75a1375"], "tags": []}], "date": 1565380369, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "197": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nda -\u003e 468bf750e858\ndsb -\u003e 924e88f9f7e0\nen-CA -\u003e b06f0cd8335a\nes-AR -\u003e b23695fc7cf7\ngn -\u003e 404a3f4d856a\nhe -\u003e 9341f4274d15\nhi-IN -\u003e a1e47d932903\nhr -\u003e e4ff73b1f5f2\nhsb -\u003e 9e6c06c58e00\nhu -\u003e 2dc718381480\nit -\u003e f590804a3129\nka -\u003e cca5cefac2d2\nlt -\u003e 4482ca0c369b\nmr -\u003e 695bc7a9f3e3\nnb-NO -\u003e c177e8f088fd\npl -\u003e d1192a13ce11\npt-BR -\u003e b0b950e08354\nth -\u003e ef4d1dcb1657\nzh-CN -\u003e 55e0f3142c93\nzh-TW -\u003e bf461ecea9f4", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "22b6a835ccff0c6ac93c4d949ed6d71748414e16", "parents": ["67fba999b1f211948ea6f4c0f00bd8e93d05a8c5"], "tags": []}], "date": 1565449233, "git_changesets": [null], "user": "ffxbld"}, "198": {"changesets": [{"author": "L10n Bumper Bot