, "mobile/android/app/src/main/res/drawable-xxhdpi/suggestedsites_emag.png", "mobile/android/app/src/main/res/drawable-xxhdpi/suggestedsites_facebook.png", "mobile/android/app/src/main/res/drawable-xxhdpi/suggestedsites_olx.png", "mobile/android/app/src/main/res/drawable-xxhdpi/suggestedsites_skroutz.png", "mobile/android/app/src/main/res/drawable-xxhdpi/suggestedsites_twitch.png", "mobile/android/app/src/main/res/drawable-xxhdpi/suggestedsites_twitter.png", "mobile/android/app/src/main/res/drawable-xxhdpi/suggestedsites_wikipedia.png", "mobile/android/app/src/main/res/drawable-xxhdpi/suggestedsites_youtube.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_aliexpress.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_allegro.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_alza.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_amazon.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_ebay.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_emag.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_facebook.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_olx.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_skroutz.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_twitch.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_twitter.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_wikipedia.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/suggestedsites_youtube.png"], "git_node": null, "git_parents": [null], "node": "e6d0eceb09dd835cc35c1a2fa6d65bb67b7f2e25", "parents": ["5439af0dc57e6b312f99076d594bc46d44943950"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1555950 - Ignore lint error for drawables used for localized Top Sites; r=VladBaicu, a=RyanVM\n\nDepends on D34681\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35441", "files": ["mobile/android/app/lint.xml"], "git_node": null, "git_parents": [null], "node": "22f8773a4dc0663829646e9f67f706221bc3f33f", "parents": ["e6d0eceb09dd835cc35c1a2fa6d65bb67b7f2e25"], "tags": []}], "date": 1562788151, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "64": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37714", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "e7ed9a2f00259062284fdb3ebeb4394f7a57dae7", "parents": ["22f8773a4dc0663829646e9f67f706221bc3f33f"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1555319: Normalize the case of the installation path to always get a consistent install hash. r=froydnj, a=RyanVM\n\nThe XRE_EXECUTABLE_FILE directory entry gives us the actual path that the binary\nwas launched with. On systems where the filesystem is case insensitive this\ncan be in any case, which ends up being a different install hash. This patch\nensures that we get the correct case for the install path before generating the\nhash.\n\nWe have the problem of users who are already affected by this issue. This patch\nalso leaves the old hash available, if no default profile is found for the\ncorrect hash then we also check for a profile for the old hash, if so we use it\nfor this hash going forwards. Testing this is kind of a pain, we have to add a\nway to override the old hash that we will check against. I'm not totally happy with\nhow it is done here but not sure there is anything better.\n\nThis also adds a test that calling xpcshell with differing cases returns the\nsame install hash.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34774", "files": ["toolkit/profile/nsIToolkitProfileService.idl", "toolkit/profile/nsToolkitProfileService.cpp", "toolkit/profile/nsToolkitProfileService.h", "toolkit/profile/xpcshell/head.js", "toolkit/profile/xpcshell/test_fix_directory_case.js", "toolkit/profile/xpcshell/test_ignore_legacy_directory.js", "toolkit/profile/xpcshell/xpcshell.ini", "toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsXREDirProvider.cpp", "toolkit/xre/nsXREDirProvider.h", "toolkit/xre/test/show_hash.js", "toolkit/xre/test/test_install_hash.js", "toolkit/xre/test/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "e09145bef79d7faa1ab3d35d2a2401bf90064a79", "parents": ["e7ed9a2f00259062284fdb3ebeb4394f7a57dae7"], "tags": []}, {"author": "Kathy Brade \u003cbrade@pearlcrescent.com\u003e", "branch": "default", "desc": "Bug 1561636 - intermittent updater failures on Win64 (Error 19). r=rstrong, a=RyanVM\n\nAvoid MinGW's _ftelli64() and _fseeki64() implementations because they\nare unreliable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36037", "files": ["modules/libmar/src/mar_private.h"], "git_node": null, "git_parents": [null], "node": "a3ca22e1ef37d4d0e9d20c4a056bc75de2686f5e", "parents": ["e09145bef79d7faa1ab3d35d2a2401bf90064a79"], "tags": []}, {"author": "Jan Henning \u003cjh+bugzilla@buttercookie.de\u003e", "branch": "default", "desc": "Bug 1552781 - Part 0: Clarify comment in reftest manifest. r=dbaron, a=RyanVM\n\nThere is a natural tendency to add new tests at the bottom of the manifest, so\nthe comment about the lineThreshold pref wasn't entirely accurate anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32620", "files": ["layout/reftests/font-inflation/reftest.list"], "git_node": null, "git_parents": [null], "node": "58cf4ae6d198b5c9ec0bfc583f8ad9c425aa2a6d", "parents": ["a3ca22e1ef37d4d0e9d20c4a056bc75de2686f5e"], "tags": []}, {"author": "Jan Henning \u003cjh+bugzilla@buttercookie.de\u003e", "branch": "default", "desc": "Bug 1552781 - Part 1: Add reftests for flexbox/grid font inflation scope. r=dbaron, a=RyanVM\n\nIn this case, the desired end state is *no* inflation, so we don't need separate\nref-versions of the test pages - the only difference is in the prefs being used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32621", "files": ["layout/reftests/font-inflation/reftest.list", "layout/reftests/font-inflation/threshold-scope-flex-container-1.html", "layout/reftests/font-inflation/threshold-scope-flex-container-2.html", "layout/reftests/font-inflation/threshold-scope-flex-container-items-1.html", "layout/reftests/font-inflation/threshold-scope-flex-container-items-2.html", "layout/reftests/font-inflation/threshold-scope-grid-container-1.html", "layout/reftests/font-inflation/threshold-scope-grid-container-items-1.html"], "git_node": null, "git_parents": [null], "node": "9df75d7dcc937b437400117fa8e32349bfa781c9", "parents": ["58cf4ae6d198b5c9ec0bfc583f8ad9c425aa2a6d"], "tags": []}, {"author": "Jan Henning \u003cjh+bugzilla@buttercookie.de\u003e", "branch": "default", "desc": "Bug 1552781 - Part 2: Flexboxes/grids should be font inflation flow roots. r=dbaron, a=RyanVM\n\nOur algorithm for dividing a page up into separate font inflation flow roots\nseems mostly based on the idea that a new Block Formatting Context (BFC) should\ngo hand in hand with a font inflation flow root.\nFlex containers so far didn't follow that rule, since they technically create a\nnew *Flex* Formatting Context (FFC) and possibly also because nobody thought\nabout font inflation when implementing nsFlexContainerFrame.\n\nThis leads to all flex containers being counted against the next higher-level\nflow root, meaning that a lot of small flex containers can get inflated if their\nsum total of text *collectively* exceeds the font inflation threshold.\nThis alone is likely undesired most of the time, but is then also aggravated by\nthe fact that our flexbox behaviour under font inflation is somewhat buggy (bug\n1142461).\n\nAs apart from the different layout rules inside the container, a FFC behaves\nvery much like a BFC in that it establishes a new formatting context, flex\ncontainers should therefore correspondingly become font inflation flow roots,\ntoo, and therefore be considered individually for font inflation.\n\nAs far as I can tell, with this change we'll also match Blink's behaviour in\nthat regard.\n\nFor completeness's sake, we'll make grid containers follow the same principles,\neven though hopefully grids on non mobile-friendly pages should hopefully be\nsomewhat rarer than flexboxes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32622", "files": ["layout/generic/nsFlexContainerFrame.cpp", "layout/generic/nsGridContainerFrame.cpp", "layout/reftests/font-inflation/reftest.list"], "git_node": null, "git_parents": [null], "node": "6534f2a515fd5db6682afdb2749fd14d2fa3a9af", "parents": ["9df75d7dcc937b437400117fa8e32349bfa781c9"], "tags": []}, {"author": "Jan Henning \u003cjh+bugzilla@buttercookie.de\u003e", "branch": "default", "desc": "Bug 1552781 - Part 3: Make flex/grid items font inflation flow roots, too. r=dbaron, a=RyanVM\n\nThe arguments for the respective container elements apply to their immediate\nchild items, too: They establish a new formatting context as well and presumably\nrepresent page content that can be considered to be logically separate enough to\nwarrant individual consideration for font inflation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35881", "files": ["layout/generic/nsFrame.cpp", "layout/reftests/font-inflation/reftest.list"], "git_node": null, "git_parents": [null], "node": "d011c5c8270b1fdaf3601604702107e9ed34b505", "parents": ["6534f2a515fd5db6682afdb2749fd14d2fa3a9af"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1556275 - Handle unknown values for width and height as 'Auto' in viewport meta tag. r=botond, a=RyanVM\n\nWithout the change a green rectangle in each reftest in this commit covers whole\nscreen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37328", "files": ["dom/base/Document.cpp", "layout/reftests/meta-viewport/device-height-for-width.html", "layout/reftests/meta-viewport/invalid-width-ref.html", "layout/reftests/meta-viewport/invalid-width.html", "layout/reftests/meta-viewport/reftest.list"], "git_node": null, "git_parents": [null], "node": "72421287115f8b0f5d44d75c46ee6be77cd3cbb2", "parents": ["d011c5c8270b1fdaf3601604702107e9ed34b505"], "tags": []}, {"author": "Ehsan Akhgari \u003cehsan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1558503 - Preserve the order of the arguments in the localized storageAccess.message string; r=johannh,flod, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37468", "files": ["browser/modules/PermissionUI.jsm", "toolkit/modules/PopupNotifications.jsm"], "git_node": null, "git_parents": [null], "node": "a1d610b7cb6f1836e76a9c5c9d3f688809d06723", "parents": ["72421287115f8b0f5d44d75c46ee6be77cd3cbb2"], "tags": []}], "date": 1562880487, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "65": {"changesets": [{"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1549043 - Fix browser_urlbar_search_legacy.js and browser_urlbar_keyed_search_legacy.js failures on macOS 10.14 Mojave. r=Standard8 a=testonly", "files": ["browser/base/content/test/performance/browser_urlbar_keyed_search_legacy.js", "browser/base/content/test/performance/browser_urlbar_search_legacy.js"], "git_node": null, "git_parents": [null], "node": "cfb1a61e8d24317edf92e59221eaf2cba7ba2090", "parents": ["a1d610b7cb6f1836e76a9c5c9d3f688809d06723"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1550130 - make tools/profiler/tests/xpcshell/test_enterjit_osr.js more robust. r=gregtatum a=testonly\n\nmake tools/profiler/tests/xpcshell/test_enterjit_osr.js more robust.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D31796", "files": ["tools/profiler/tests/xpcshell/test_enterjit_osr.js"], "git_node": null, "git_parents": [null], "node": "029f15561cb413fe84b70621a2e5bba0719baad5", "parents": ["cfb1a61e8d24317edf92e59221eaf2cba7ba2090"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1553845 - turn on all talos/raptor jobs for osx 10.14. r=gbrown a=testonly\n\nturn on all talos/raptor jobs for osx 10.14.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32334", "files": ["taskcluster/ci/test/test-platforms.yml"], "git_node": null, "git_parents": [null], "node": "ada6d26ad7326e09e5a7ca273bad5224dc55a19c", "parents": ["029f15561cb413fe84b70621a2e5bba0719baad5"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1550141 - disable toolkit/modules/tests/xpcshell/test_DeferredTask.js on osx 10.14. r=Yoric a=testonly\n\ndisable toolkit/modules/tests/xpcshell/test_DeferredTask.js on osx 10.14.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32333", "files": ["toolkit/modules/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "62e7436abd34c01810528d4f9713a1caef60be1e", "parents": ["ada6d26ad7326e09e5a7ca273bad5224dc55a19c"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1557123 - migrate web-platform-tests and web-platform-tests-reftest to osx 10.14. r=egao a=testonly\n\nmigrate web-platform-tests and web-platform-test-reftests to osx 10.14.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33833", "files": ["taskcluster/ci/test/test-sets.yml", "testing/web-platform/meta/css/css-shapes/shape-outside/values/shape-outside-ellipse-005.html.ini", "testing/web-platform/meta/css/css-text-decor/text-emphasis-style-006.html.ini", "testing/web-platform/meta/css/css-values/ch-unit-001.html.ini", "testing/web-platform/meta/css/css-values/ch-unit-003.html.ini", "testing/web-platform/meta/css/css-values/ch-unit-004.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/named-access-on-the-window-object/navigated-named-objects.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-noopener.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/track/track-element/track-mode.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-iframe-element/iframe_sandbox_navigation_download_block_downloads_without_user_activation.sub.tentative.html.ini", "testing/web-platform/meta/html/semantics/links/links-created-by-a-and-area-elements/htmlanchorelement_noopener.html.ini", "testing/web-platform/meta/netinfo/idlharness.any.js.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-mediaelementaudiosourcenode-interface/mediaElementAudioSourceToScriptProcessorTest.html.ini", "testing/web-platform/meta/xhr/event-timeout.any.js.ini"], "git_node": null, "git_parents": [null], "node": "773f4dbaaebfac87d851e76da80390d58fa7b9e8", "parents": ["62e7436abd34c01810528d4f9713a1caef60be1e"], "tags": []}, {"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555454 - migrate marionette, wdspec, firefox UI, test-verify, mochitest-a11y suites to macosx1014 r=jmaher a=testonly\n\nTest suite changes:\n- test-verify, marionette, firefox UI, wdspec, mochitest-a11y suites are migrated over to macosx1014 platform (green without requiring intervention)\n\nTest expected outcomes:\n- skip `browser/components/urlbar/tests/browser/browser_locationBarCommand.js` test as per comments in 1554807\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33066", "files": ["browser/components/urlbar/tests/browser/browser.ini", "taskcluster/ci/test/test-sets.yml"], "git_node": null, "git_parents": [null], "node": "8b89c8d8b979b055dd7cbd3568bd7671a8980d7e", "parents": ["773f4dbaaebfac87d851e76da80390d58fa7b9e8"], "tags": []}, {"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555454 - move cppunit, jittest, mochitest-devtools-webreplay, mochiest-gpu to macosx1014 r=jmaher a=testonly\n\nChanges:\n\ncompiled:\n- move `cppunit`, `jittest` from `macosx64` to `macosx1014` test set\n\nmochitest:\n- move `mochitest-devtools-webreplay`, `mochitest-gpu` to the `macosx1014` test set\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33717", "files": ["taskcluster/ci/test/test-sets.yml"], "git_node": null, "git_parents": [null], "node": "38145d9d4de0d81feb92f69bb2aef8b645534347", "parents": ["8b89c8d8b979b055dd7cbd3568bd7671a8980d7e"], "tags": []}, {"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555454 - remove fail-if condition specific to mac for test_webgl_fingerprinting_resistance.html and migrate to running on macosx1014 r=jmaher a=testonly\n\nChanges:\n- remove `fail-if` condition\n- migrate `mochitest-webgl-core` to running on macosx1014\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33822", "files": ["dom/canvas/test/webgl-mochitest/mochitest.ini", "taskcluster/ci/test/test-sets.yml"], "git_node": null, "git_parents": [null], "node": "4f549212ebe5b8e813e3731034e8b124be05636e", "parents": ["38145d9d4de0d81feb92f69bb2aef8b645534347"], "tags": []}, {"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555454 - move telemetry-tests-client to macosx1014 r=gbrown a=testonly\n\nChanges:\n- move telemetr