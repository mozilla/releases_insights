s:1220735:"{
"lastpushid": 1111,
"pushes": {"100": {"changesets": [{"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1562632 - Pass --with-{branding,version-file-path} as a mozharness extra config r=tomprince,mshal a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37601", "files": ["build/moz.configure/init.configure", "mobile/android/config/mozconfigs/android-aarch64/beta", "mobile/android/config/mozconfigs/android-aarch64/debug", "mobile/android/config/mozconfigs/android-aarch64/debug-beta", "mobile/android/config/mozconfigs/android-aarch64/debug-release", "mobile/android/config/mozconfigs/android-aarch64/nightly", "mobile/android/config/mozconfigs/android-aarch64/release", "mobile/android/config/mozconfigs/android-api-16-frontend/nightly", "mobile/android/config/mozconfigs/android-api-16-gradle-dependencies/nightly", "mobile/android/config/mozconfigs/android-api-16/beta", "mobile/android/config/mozconfigs/android-api-16/debug", "mobile/android/config/mozconfigs/android-api-16/debug-beta", "mobile/android/config/mozconfigs/android-api-16/debug-ccov", "mobile/android/config/mozconfigs/android-api-16/debug-release", "mobile/android/config/mozconfigs/android-api-16/nightly", "mobile/android/config/mozconfigs/android-api-16/release", "mobile/android/config/mozconfigs/android-x86/beta", "mobile/android/config/mozconfigs/android-x86/debug", "mobile/android/config/mozconfigs/android-x86/debug-beta", "mobile/android/config/mozconfigs/android-x86/debug-release", "mobile/android/config/mozconfigs/android-x86/nightly", "mobile/android/config/mozconfigs/android-x86/release", "mobile/android/config/mozconfigs/android-x86_64/beta", "mobile/android/config/mozconfigs/android-x86_64/debug", "mobile/android/config/mozconfigs/android-x86_64/debug-beta", "mobile/android/config/mozconfigs/android-x86_64/debug-release", "mobile/android/config/mozconfigs/android-x86_64/nightly", "mobile/android/config/mozconfigs/android-x86_64/release", "mobile/android/config/mozconfigs/common", "mobile/android/config/mozconfigs/public-partner/distribution_sample/mozconfig1", "taskcluster/ci/build/android.yml", "taskcluster/taskgraph/transforms/build.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_beta.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_beta_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_release.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_release_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_api_16_beta.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_api_16_beta_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_api_16_release.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_api_16_release_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_beta.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_beta_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_release.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_release_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_beta.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_beta_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_release.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_release_debug.py", "testing/mozharness/mozharness/mozilla/building/buildbase.py"], "git_node": null, "git_parents": [null], "node": "a9ec5cfb029f4f3d3803ed1fb1ee9c852c56dfbf", "parents": ["47425b086f353e22f0fc3e532c188bffa0ea3209"], "tags": []}], "date": 1563871666, "git_changesets": [null], "user": "jlorenzo@mozilla.com"}, "101": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nkn -\u003e 90f9bc51dffd\nrm -\u003e aa9d453a6408\nro -\u003e 12ba59dd78db\ntrs -\u003e e2c3cf92e471", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "d553ed1717370231462c217726d6f9fb4a98ecce", "parents": ["a9ec5cfb029f4f3d3803ed1fb1ee9c852c56dfbf"], "tags": []}], "date": 1563883228, "git_changesets": [null], "user": "ffxbld"}, "102": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 1b4640c5477246faac0d589cdffd510b5474a6b4 with FENNEC_68_1b3_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "1208bce123155651ed513f7d76d57a79d3462242", "parents": ["d553ed1717370231462c217726d6f9fb4a98ecce"], "tags": []}, {"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release DONTBUILD", "files": ["mobile/android/config/version-files/beta/version_display.txt"], "git_node": null, "git_parents": [null], "node": "bab79bd8888a3dc3501d43f05fd0d85d049d9f67", "parents": ["1208bce123155651ed513f7d76d57a79d3462242"], "tags": []}], "date": 1563895287, "git_changesets": [null, null], "user": "ffxbld"}, "103": {"changesets": [{"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1562633 - 68 train: Remove Fennec redundant/useless jobs r=tomprince,RyanVM a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38204", "files": ["taskcluster/ci/build/android.yml", "taskcluster/ci/instrumented-build/kind.yml", "taskcluster/ci/test/test-platforms.yml"], "git_node": null, "git_parents": [null], "node": "05d182e0bd2253160fde0b9ca60411df84112a6f", "parents": ["bab79bd8888a3dc3501d43f05fd0d85d049d9f67"], "tags": []}], "date": 1563896504, "git_changesets": [null], "user": "jlorenzo@mozilla.com"}, "104": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1554949 - Fix WebRTC build failure with newer linux kernel. r=dminor, a=RyanVM\n\nRecent kernel commit[1] moved a bit the define for this constant. This revealed\na missing include in WebRTC.\n\nI filed this upstream in:\n\n * https://bugs.chromium.org/p/webrtc/issues/detail?id=10677\n\nAnd sent a patch in:\n\n * https://webrtc-review.googlesource.com/c/src/+/138270\n\n[1]: https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=0768e17073dc5\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32809", "files": ["media/webrtc/trunk/webrtc/rtc_base/physicalsocketserver.cc"], "git_node": null, "git_parents": [null], "node": "e270e1519cbe956dcb1c1fe0803938e7e84ed053", "parents": ["05d182e0bd2253160fde0b9ca60411df84112a6f"], "tags": []}, {"author": "Dan Glastonbury \u003cdan.glastonbury@gmail.com\u003e", "branch": "default", "desc": "Bug 1562111 - Unconditionally include WinUtils.h on Windows. r=bobowen, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36283", "files": ["toolkit/xre/nsXREDirProvider.cpp"], "git_node": null, "git_parents": [null], "node": "f68f9e47a78350589d5abcf069549e6e4e50e368", "parents": ["e270e1519cbe956dcb1c1fe0803938e7e84ed053"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1552141 - The address bar is filtering bookmarklets and not executing them. r=dao, a=RyanVM", "files": ["browser/components/urlbar/UrlbarInput.jsm", "browser/components/urlbar/UrlbarProviderUnifiedComplete.jsm", "browser/components/urlbar/UrlbarProvidersManager.jsm", "browser/components/urlbar/tests/browser/browser_keywordBookmarklets.js", "browser/components/urlbar/tests/legacy/browser.ini"], "git_node": null, "git_parents": [null], "node": "08c37e6e9597b69bef3c031d53a4f145247e4202", "parents": ["f68f9e47a78350589d5abcf069549e6e4e50e368"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1567098 - Allow line-break after a float placeholder if the line is empty. r=emilio, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38512", "files": ["layout/generic/nsLineLayout.cpp"], "git_node": null, "git_parents": [null], "node": "f8df999f8ed3f9f44626a2546bf705deb3bc9c5c", "parents": ["08c37e6e9597b69bef3c031d53a4f145247e4202"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1567098 - Add a WPT reftest where no content fits onto the shortened line beside a float. r=emilio, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38535", "files": ["testing/web-platform/tests/css/CSS2/floats/float-no-content-beside-001-ref.html", "testing/web-platform/tests/css/CSS2/floats/float-no-content-beside-001.html"], "git_node": null, "git_parents": [null], "node": "4566fd9bd50f17038e210c8f6c4170b4681f0bfb", "parents": ["f8df999f8ed3f9f44626a2546bf705deb3bc9c5c"], "tags": []}, {"author": "ksenia \u003ckberezina@mozilla.com\u003e", "branch": "default", "desc": "Bug 1567198 - create UA override for corporate.santander.co.uk r=denschub,rhelmer, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38509", "files": ["browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/ua_overrides.js", "mobile/android/extensions/webcompat/manifest.json", "mobile/android/extensions/webcompat/ua_overrides.js"], "git_node": null, "git_parents": [null], "node": "84f0e8911c24117367145c0fa9d42bee3cd08f79", "parents": ["4566fd9bd50f17038e210c8f6c4170b4681f0bfb"], "tags": []}, {"author": "Nathan Froyd \u003cfroydnj@mozilla.com\u003e", "branch": "default", "desc": "Bug 1545381 - be more defensive in nsAppShellSingleton; r=erahm, a=RyanVM\n\nWe're seeing crashes in bug 1545381 in appshell shutdown, which appear\nto point to appshell initialization somehow falling over non-obviously.\nAppshell initialization should basically never fail, so let's complain\nloudly if that ever happens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38915", "files": ["widget/nsAppShellSingleton.h"], "git_node": null, "git_parents": [null], "node": "1a05f31924184dfac845b43b6c3447f520778e7c", "parents": ["84f0e8911c24117367145c0fa9d42bee3cd08f79"], "tags": []}], "date": 1563913712, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "105": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1556235 - Make `HTMLEditRules::WillDeleteSelection()` remove empty parent blocks when it's called by drop handler r=m_kato a=RyanVM\n\nChromium removes new empty blocks only when the content is removed by dragging.\nBefore bug 1504910, we just removed the dragged range, i.e., kept the new\nempty blocks.  However, now, we put `\u003cbr\u003e` element from\n`HTMLEditRules::AfterEditInner()` because a D&D action was split to the deletion\npart and inserting part (It wasn't called after inserting the dropped content).\n\nTherefore, this patch adds new path for D&D into\n`HTMLEditRules::WillDeleteSelection()`.  If parent blocks become empty,\nthe path removes such blocks and collapse `Selection` to where the most\nancestor empty block was.  With this patch, we get same behavior as Chrome\nin most cases.  You can check it in https://jsfiddle.net/d_toybox/9px07yLr/\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34147", "files": ["editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditRules.cpp", "editor/libeditor/HTMLEditRules.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h"], "git_node": null, "git_parents": [null], "node": "0265acbcb8b981ae5d0c8c90abb5bc27af3c3a34", "parents": ["1a05f31924184dfac845b43b6c3447f520778e7c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1565129 - Re-introduce plain_text.wrap_long_lines. r=bzbarsky a=RyanVM\nLooks like some users use it, and it's not too much effort to support. This is\nsomewhat simpler, and IMO better than what existed before bug 1514655 because:\n\n * It doesn't regress bidi rendering when the pref is disabled (before, the pref\n   would prevent plaintext.css from applying altogether).\n\n * It's consistent with the way view-source docs work.\n\n * It doesn't use non-standard stylesheet APIs to toggle the stylesheet\n   (bug 1260720).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37742\n\nSigned-off-by: Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "files": ["layout/reftests/bugs/1565129.txt", "layout/reftests/bugs/reftest.list", "layout/style/res/plaintext.css", "modules/libpref/init/StaticPrefList.h", "parser/html/nsHtml5PlainTextUtils.cpp", "parser/html/nsHtml5PlainTextUtils.h", "parser/html/nsHtml5TreeBuilderCppSupplement.h"], "git_node": null, "git_parents": [null], "node": "ebe163391af1093cce16db6b1f219080925dcf7c", "parents": ["0265acbcb8b981ae5d0c8c90abb5bc27af3c3a34"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "bug 1564481 - reset HSTS/HPKP state to factory settings rather than storing knockout entries for preloaded sites r=jcj r=KevinJacobs a=RyanVM\n\nAs originally implemented, nsISiteSecurityService.removeState allowed direct\naccess to remove HSTS state. It also provided the implementation for when the\nbrowser encountered an HSTS header with \"max-age=0\". In bug 775370, it was\nupdated to store an entry that would override preloaded information when\nprocessing such headers. However, this meant that the semantics of the direct\naccess API had changed. Preloaded information could be overridden if a user\ninvoked the \"forget about this site\" feature. This change fixes the public API\n(and renames it to \"resetState\") so it actually behaves as its consumers expect.", "files": ["browser/base/content/test/general/browser_blockHPKP.js", "browser/base/content/test/general/browser_star_hsts.js", "devtools/shared/webconsole/test/test_network_security-hpkp.html", "devtools/shared/webconsole/test/test_network_security-hsts.html", "security/manager/ssl/nsISiteSecurityService.idl", "security/manager/ssl/nsSiteSecurityService.cpp", "security/manager/ssl/nsSiteSecurityService.h", "security/manager/ssl/tests/mochitest/browser/browser_bug627234_perwindowpb.js", "security/manager/ssl/tests/unit/test_ocsp_must_staple.js", "security/manager/ssl/tests/unit/test_pinning_header_parsing.js", "security/manager/ssl/tests/unit/test_sss_originAttributes.js", "security/manager/ssl/tests/unit/test_sss_resetState.js", "security/manager/ssl/tests/unit/test_sts_fqdn.js", "security/manager/ssl/tests/unit/xpcshell.ini", "testing/specialpowers/content/SpecialPowersObserverAPI.js", "toolkit/components/cleardata/ClearDataService.jsm"], "git_node": null, "git_parents": [null], "node": "030b03a32913becfdd6ba580d058a9f95ed478bf", "parents": ["ebe163391af1093cce16db6b1f219080925dcf7c"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1567301 - UnifiedComplete: Change the title-tags separator to a non-printable character. r=mak a=RyanVM\n\nThis just changes the `TITLE_TAGS_SEPARATOR` to the non-printable character `\\x1F`, the unit separator, which seems appropriate.\n\nAt first I thought we could use the result label to store tags since we're not using the label at all right now. Hacky, but better than storing them in the title. But (1) `nsAutoCompleteSimpleResult::GetLabelAt` falls back to the value if the label is empty, and (2) `nsAutoCompleteController::GetLabelAt` actually returns the same thing as `GetValueAt`, i.e., the value, not the label. It's doable, but we'd need set the label to some special value for every result that doesn't have tags so that the label doesn't fall back to the value so we can tell which results don't have tags, and we'd need to make sure to always directly ask results for labels instead of going through the controller.  head_autocomplete.js goes through the controller, and I didn't check what else does too.\n\nSo then I thought we could store tags in the style with a special substring like \"tags=tag1,tag2,tag3\". Again it's doable, but:\n\nThe simplest fix is to just change the separator to an unprintable character. That should work, right? We can do better whenever we finally rewrite/refactor UnifiedComplete for quantumbar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38790", "files": ["browser/components/urlbar/UrlbarProviderUnifiedComplete.jsm", "browser/components/urlbar/UrlbarUtils.jsm", "toolkit/components/places/UnifiedComplete.jsm", "toolkit/components/places/tests/unifiedcomplete/head_autocomplete.js"], "git_node": null, "git_parents": [null], "node": "77ee5210462a5fdc12d4f324874d8e2722c60476", "parents": ["030b03a32913becfdd6ba580d058a9f95ed478bf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1567105 - When cloning a document for printing, call SetCompatMode rather than silently copying over the compat mode. r=jwatt a=RyanVM\n\nSo that the styleset and CSS loader react appropriately.\n\nBug 1535788 causes the styleset to be created earlier, so it stopped grabbing the\nalready-updated compat mode.\n\nI think the CSS loader stuff could already cause some issues before bug 1535788,\nfor what is worth.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39053", "files": ["dom/base/Document.cpp"], "git_node": null, "git_parents": [null], "node": "69e221e8c778ac2df52be30b2628a506456d7802", "parents": ["77ee5210462a5fdc12d4f324874d8e2722c60476"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1567105 - Tests. r=jwatt a=RyanVM\n\nThe reftest-paged tests don't trigger the document clone code-path (I realized\nthat after writing them), but I guess they don't hurt, the printpreview test\ndoes fail without the previous patch.\n\nDepends on D39053\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39054", "files": ["layout/base/tests/chrome/chrome.ini", "layout/base/tests/chrome/printpreview_helper.xul", "layout/base/tests/chrome/printpreview_quirks.html", "layout/base/tests/chrome/printpreview_quirks_ref.html", "layout/reftests/pagination/quirks-notref.html", "layout/reftests/pagination/quirks-ref.html", "layout/reftests/pagination/quirks.html", "layout/reftests/pagination/reftest.list"], "git_node": null, "git_parents": [null], "node": "748c6248f4f2c13dabd7401851ff587760bf92be", "parents": ["69e221e8c778ac2df52be30b2628a506456d7802"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1567298 - Refresh preference sheet data from ThemeChanged(). r=heycam a=RyanVM\n\nSo as to grab updated high contrast settings and co.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39084", "files": ["layout/base/nsPresContext.cpp"], "git_node": null, "git_parents": [null], "node": "22c7a4ad22904acda04db7b947fbf6374194565f", "parents": ["748c6248f4f2c13dabd7401851ff587760bf92be"], "tags": []}], "date": 1563997656, "git_changesets": [null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "106": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Backed out 2 changesets (bug 1567105) for bustage at dom/base/Document.cpp. a=backout\n\nBacked out changeset 748c6248f4f2 (bug 1567105)\nBacked out changeset 69e221e8c778 (bug 1567105)", "files": ["dom/base/Document.cpp", "layout/base/tests/chrome/chrome.ini", "layout/base/tests/chrome/printpreview_helper.xul", "layout/base/tests/chrome/printpreview_quirks.html", "layout/base/tests/chrome/printpreview_quirks_ref.html", "layout/reftests/pagination/quirks-notref.html", "layout/reftests/pagination/quirks-ref.html", "layout/reftests/pagination/quirks.html", "layout/reftests/pagination/reftest.list"], "git_node": null, "git_parents": [null], "node": "c08e3b8c55b2bb7062d51cdda4a01b0c74e296b2", "parents": ["22c7a4ad22904acda04db7b947fbf6374194565f"], "tags": []}, {"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Backed out changeset 77ee5210462a (bug 1567301) on request from adw. a=backout", "files": ["browser/components/urlbar/UrlbarProviderUnifiedComplete.jsm", "browser/components/urlbar/UrlbarUtils.jsm", "toolkit/components/places/UnifiedComplete.jsm", "toolkit/components/places/tests/unifiedcomplete/head_autocomplete.js"], "git_node": null, "git_parents": [null], "node": "39668a5acec7be22c3906b3e35d665d752473ce0", "parents": ["c08e3b8c55b2bb7062d51cdda4a01b0c74e296b2"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1567301 - UnifiedComplete: Change the title-tags separator to a non-printable character. r=mak a=RyanVM\n\nThis just changes the `TITLE_TAGS_SEPARATOR` to the non-printable character `\\x1F`, the unit separator, which seems appropriate.\n\nAt first I thought we could use the result label to store tags since we're not using the label at all right now. Hacky, but better than storing them in the title. But (1) `nsAutoCompleteSimpleResult::GetLabelAt` falls back to the value if the label is empty, and (2) `nsAutoCompleteController::GetLabelAt` actually returns the same thing as `GetValueAt`, i.e., the value, not the label. It's doable, but we'd need set the label to some special value for every result that doesn't have tags so that the label doesn't fall back to the value so we can tell which results don't have tags, and we'd need to make sure to always directly ask results for labels instead of going through the controller.  head_autocomplete.js goes through the controller, and I didn't check what else does too.\n\nSo then I thought we could store tags in the style with a special substring like \"tags=tag1,tag2,tag3\". Again it's doable, but:\n\nThe simplest fix is to just change the separator to an unprintable character. That should work, right? We can do better whenever we finally rewrite/refactor UnifiedComplete for quantumbar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38790", "files": ["browser/components/urlbar/UrlbarProviderUnifiedComplete.jsm", "browser/components/urlbar/UrlbarUtils.jsm", "toolkit/components/places/UnifiedComplete.jsm", "toolkit/components/places/tests/unifiedcomplete/head_autocomplete.js", "toolkit/content/widgets/autocomplete-richlistitem.js"], "git_node": null, "git_parents": [null], "node": "5e11ee58ef75361b257990ea45b5fed7978df0ea", "parents": ["39668a5acec7be22c3906b3e35d665d752473ce0"], "tags": []}], "date": 1564000593, "git_changesets": [null, null, null], "user": "archaeopteryx@coole-files.de"}, "107": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Backed out changeset 0265acbcb8b9 (bug 1556235) for build bustage at editor/libeditor/HTMLEditor.cpp. a=backout", "files": ["editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditRules.cpp", "editor/libeditor/HTMLEditRules.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h"], "git_node": null, "git_parents": [null], "node": "c0f6a06ec87d112d0710d2b9fef4857a81bea03a", "parents": ["5e11ee58ef75361b257990ea45b5fed7978df0ea"], "tags": []}], "date": 1564002422, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "108": {"changesets": [{"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1141245 - disable test_tooltip.xul on macosx1014, inheriting from previous config to disable on macosx1010 r=jmaher a=testonly\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37952", "files": ["toolkit/content/tests/chrome/chrome.ini"], "git_node": null, "git_parents": [null], "node": "98ce85c9b7ea85e816e560448b149bb3daf47fa9", "parents": ["c0f6a06ec87d112d0710d2b9fef4857a81bea03a"], "tags": []}, {"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555454 - migrate gtest to macosx1014 r=jmaher a=testonly\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37930", "files": ["taskcluster/ci/test/test-sets.yml"], "git_node": null, "git_parents": [null], "node": "1b737f2968eae0f2a5a8660899cd7c45c3e13480", "parents": ["98ce85c9b7ea85e816e560448b149bb3daf47fa9"], "tags": []}, {"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1514751 - disable browser_aboutdebugging_addons_manifest_url.js for macosx1014 debug r=jmaher a=testonly\n\nChanges:\n- temporarily disable the test on macosx1014 as per comments in the bug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37987", "files": ["devtools/client/aboutdebugging-new/test/browser/browser.ini"], "git_node": null, "git_parents": [null], "node": "00d3643981179eca68dbda873f833a59894b64c6", "parents": ["1b737f2968eae0f2a5a8660899cd7c45c3e13480"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1558890 - Give more leeway to VideoFrameConverterTest::ClearFutureFramesOnJumpingBack. r=dminor a=testonly\n\nThis does two things:\n- Makes times relative to current time, with the only constraint that not a\n  whole second may pass after the first frame, since that will trigger the\n  same-frame timer.\n- Changes asserts to use TimeDuration instead of TimeStamp for understandable\n  logs.\n\nThis has proven needed on some macosx machines.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36217", "files": ["dom/media/gtest/TestVideoFrameConverter.cpp"], "git_node": null, "git_parents": [null], "node": "56660304e4c30bda4707e01e76795376a3212635", "parents": ["00d3643981179eca68dbda873f833a59894b64c6"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1558886: Don't expect exactly one ready stream once ICE is connected. r=mjf a=testonly\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36501", "files": ["media/mtransport/test/ice_unittest.cpp"], "git_node": null, "git_parents": [null], "node": "06bbfdbee5aae56938be1c3cc3947b38feeefa5c", "parents": ["56660304e4c30bda4707e01e76795376a3212635"], "tags": []}, {"author": "Edwin Gao \u003cegao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555454 - disable permafailing tests on macosx1014, migrate mochitest-browser-chrome to macosx1014 r=jmaher a=testonly\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38783", "files": ["browser/base/content/test/general/browser.ini", "browser/base/content/test/performance/browser.ini", "browser/base/content/test/performance/io/browser.ini", "browser/base/content/test/permissions/browser.ini", "browser/base/content/test/webrtc/browser.ini", "browser/components/extensions/test/browser/browser-common.ini", "browser/components/sessionstore/test/browser.ini", "browser/components/shell/test/browser.ini", "browser/components/urlbar/tests/browser/browser.ini", "browser/components/urlbar/tests/legacy/browser.ini", "layout/xul/test/browser.ini", "taskcluster/ci/test/test-platforms.yml", "taskcluster/ci/test/test-sets.yml", "toolkit/mozapps/extensions/test/xpinstall/browser.ini", "xpcom/tests/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "ab57a3014dd40495e6c3e77aea076e9234bd8e7f", "parents": ["06bbfdbee5aae56938be1c3cc3947b38feeefa5c"], "tags": []}], "date": 1564053136, "git_changesets": [null, null, null, null, null, null], "user": "jmaher@mozilla.com"}, "109": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39334", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "71411b1a4e8cd03714d29d1849853ad4aef472e6", "parents": ["ab57a3014dd40495e6c3e77aea076e9234bd8e7f"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1469113 - Fix intermittent issues in browser_884402_customize_from_overflow.js, r=jaws, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39002", "files": ["browser/components/customizableui/test/browser.ini", "browser/components/customizableui/test/browser_884402_customize_from_overflow.js"], "git_node": null, "git_parents": [null], "node": "668008124f46f3ce0127578df6302edabb292f63", "parents": ["71411b1a4e8cd03714d29d1849853ad4aef472e6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1565374 - Improve test. r=jib, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37783", "files": ["dom/media/tests/mochitest/test_fingerprinting_resistance.html"], "git_node": null, "git_parents": [null], "node": "491abbed8480f95a171f5e5aec93a21c1cd5d70b", "parents": ["668008124f46f3ce0127578df6302edabb292f63"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjib@mozilla.com\u003e", "branch": "default", "desc": "Bug 1565374 - Reset state. r=jib, a=RyanVM", "files": ["dom/media/MediaManager.cpp"], "git_node": null, "git_parents": [null], "node": "9fd5fe619ab3cca0f37eba5777f053094d9f99d2", "parents": ["491abbed8480f95a171f5e5aec93a21c1cd5d70b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1567105 - When cloning a document for printing, call SetCompatMode rather than silently copying over the compat mode. r=jwatt a=RyanVM\n\nSo that the styleset and CSS loader react appropriately.\n\nBug 1535788 causes the styleset to be created earlier, so it stopped grabbing the\nalready-updated compat mode.\n\nI think the CSS loader stuff could already cause some issues before bug 1535788,\nfor what is worth.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39053", "files": ["dom/base/Document.cpp"], "git_node": null, "git_parents": [null], "node": "1adec573e052f00505d4383f9b77a8f6251af67d", "parents": ["9fd5fe619ab3cca0f37eba5777f053094d9f99d2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1567105 - Tests. r=jwatt a=RyanVM\n\nThe reftest-paged tests don't trigger the document clone code-path (I realized\nthat after writing them), but I guess they don't hurt, the printpreview test\ndoes fail without the previous patch.\n\nDepends on D39053\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39054", "files": ["layout/base/tests/chrome/chrome.ini", "layout/base/tests/chrome/printpreview_helper.xul", "layout/base/tests/chrome/printpreview_quirks.html", "layout/base/tests/chrome/printpreview_quirks_ref.html", "layout/reftests/pagination/quirks-notref.html", "layout/reftests/pagination/quirks-ref.html", "layout/reftests/pagination/quirks.html", "layout/reftests/pagination/reftest.list"], "git_node": null, "git_parents": [null], "node": "ed2ee021980b0da59bd9cf03c83946ff844feb5e", "parents": ["1adec573e052f00505d4383f9b77a8f6251af67d"], "tags": []}], "date": 1564062675, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "110": {"changesets": [{"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1560440 - Don't attempt to set sample's duration. r=bryce a=RyanVM\n\nThis is a partial revert of bug 1524890 - P17.\n\nWhen setting the duration, with some videos, on output WMF set nonsensical values. Sometimes the duration read is equal to the timestamp of the previous frame leading to broken A/V sync.\n\nIn bug 1222874, we will remove the entire concept of video frame's duration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37683", "files": ["dom/media/platforms/wmf/MFTDecoder.cpp", "dom/media/platforms/wmf/MFTDecoder.h", "dom/media/platforms/wmf/WMFAudioMFTManager.cpp", "dom/media/platforms/wmf/WMFVideoMFTManager.cpp"], "git_node": null, "git_parents": [null], "node": "ebe1c264a4d7ab826fdb5a2d5939d2bf6fa0099e", "parents": ["ed2ee021980b0da59bd9cf03c83946ff844feb5e"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 1564131 - re-enable syncing of builtin themes. r=rpl a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37837", "files": ["browser/app/profile/firefox.js", "services/sync/modules/engines/prefs.js", "services/sync/tests/unit/test_prefs_store.js"], "git_node": null, "git_parents": [null], "node": "dc20fa115b8c7ea014a57b011c2d6393a90f8343", "parents": ["ebe1c264a4d7ab826fdb5a2d5939d2bf6fa0099e"], "tags": []}], "date": 1564084372, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "111": {"changesets": [{"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566385 - add fennec bouncer-locations job for esr68.r=jlorenzo a=release", "files": ["taskcluster/ci/bouncer-locations/kind.yml", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "ceaf54ecb17aec1658f68cfb86021a0be667c5e5", "parents": ["dc20fa115b8c7ea014a57b011c2d6393a90f8343"], "tags": []}], "date": 1564148127, "git_changesets": [null], "user": "mtabara@mozilla.com"}, "112": {"