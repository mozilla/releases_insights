 "browser/components/search/extensions/priberam/manifest.json", "browser/components/search/extensions/rakuten/manifest.json", "browser/components/search/extensions/vatera/manifest.json", "browser/components/search/extensions/yahoo-jp-auctions/manifest.json", "browser/components/search/extensions/zoznam-sk/manifest.json"], "git_node": null, "git_parents": [null], "node": "64b3352a762ab22e1e8638b178cac65d65dc7421", "parents": ["56133138bc14aa82633bf05b8046445f06afb1f6"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1471004 - add notarization workerType aliases. r=nthomas, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33856", "files": ["taskcluster/ci/config.yml"], "git_node": null, "git_parents": [null], "node": "1b2ac76eec05464f33315710c7ad383017e2c967", "parents": ["64b3352a762ab22e1e8638b178cac65d65dc7421"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1471004 - mac-signing transform logic + config. r=tomprince, a=jcristau\n\nThis moves mac signing tasks to the notarization/iscript pool. It also\nadds support for pkg installers and notarization.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33857", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/task.py", "taskcluster/taskgraph/util/signed_artifacts.py"], "git_node": null, "git_parents": [null], "node": "682939872bee09cc2f0f405a8f294df243ccd0f8", "parents": ["1b2ac76eec05464f33315710c7ad383017e2c967"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1471004 - beetmove macosx pkg installer. r=sfraser, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33858", "files": ["taskcluster/taskgraph/manifests/firefox_candidates.yml", "taskcluster/taskgraph/manifests/firefox_nightly.yml"], "git_node": null, "git_parents": [null], "node": "3cc0b90500a4e60c21b9bbda72ad022ed547eb85", "parents": ["682939872bee09cc2f0f405a8f294df243ccd0f8"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1471004 - add entitlements url for hardened runtime signing. r=tomprince, a=jcristau\n\nFor mac hardened runtime signing, we use an entitlements file that's now\nin-tree. This patch passes the url for that file in the task definition.\n\nThe original patch for this was written by sfraser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33859", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/parameters.py", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "ff059ad94ad02b05243687b27d76b272783770ed", "parents": ["3cc0b90500a4e60c21b9bbda72ad022ed547eb85"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1471004 - build_signing: macosx64-nightly -\u003e macosx64-shippable. r=callek, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33860", "files": ["taskcluster/taskgraph/loader/build_signing.py"], "git_node": null, "git_parents": [null], "node": "4cdcbf76a182b7595a14bfdbe7aca7b266403083", "parents": ["ff059ad94ad02b05243687b27d76b272783770ed"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1471004 - ignore partner_subset if it's an empty list. r=tomprince, a=jcristau\n\nThe relpro action requires a list for partner_subset and defaults to\n`[]`. In `get_partner_config_by_url` we check to see `if\npartner_subset`, ignoring the subset if it's an empty list. We either\nneed to do the same thing in `get_partner_config_by_kind`, or we need to\nallow for a `null` value in the action (or populate an empty\n`partner_subset` with the partners from the partner config in the\naction)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33861", "files": ["taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "c51e6af95b386dfbc7a491cc663e578593830b21", "parents": ["4cdcbf76a182b7595a14bfdbe7aca7b266403083"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1471004 - add esr support for entitlements. r=tomprince, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38208", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/transforms/signing.py"], "git_node": null, "git_parents": [null], "node": "61219aed2735afac3edcf590e69edbb463ca7372", "parents": ["c51e6af95b386dfbc7a491cc663e578593830b21"], "tags": ["FIREFOX_68_0_1esr_BUILD1", "FIREFOX_68_0_1esr_RELEASE"]}], "date": 1563392251, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "82": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1553586 - Need JSON as a type for ExtensionSettings for GPO to work. r=jaws a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32350", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_extensionsettings.js"], "git_node": null, "git_parents": [null], "node": "568cc46637e226dcb7d4130936b577648ac69d83", "parents": ["1424ccf7256fbe2e3310f9bee080d99eb1d958d6"], "tags": []}, {"author": "Aaron Klotz \u003caklotz@mozilla.com\u003e", "branch": "default", "desc": "Bug 1553776: Add DLL blocklist entries for injected Ivanti Security Endpoint DLLs; r=dmajor a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37483", "files": ["mozglue/build/WindowsDllBlocklistDefs.h"], "git_node": null, "git_parents": [null], "node": "96618f29fb102c1a582e16ae8e64a0b1b0b9ec24", "parents": ["568cc46637e226dcb7d4130936b577648ac69d83"], "tags": []}, {"author": "ksenia \u003ckberezina@mozilla.com\u003e", "branch": "default", "desc": "Bug 1563839 - add UA for rolb.santanderbank.com r=twisniewski,rhelmer a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37455", "files": ["browser/extensions/webcompat/ua_overrides.js", "mobile/android/extensions/webcompat/ua_overrides.js"], "git_node": null, "git_parents": [null], "node": "85147561a2f389ee1b3d979d291f64fb301407b1", "parents": ["96618f29fb102c1a582e16ae8e64a0b1b0b9ec24"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1553290 - Get support menu href direct from policy. r=jaws, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32367", "files": ["browser/base/content/browser-menubar.inc", "browser/base/content/utilityOverlay.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_support_menu.js"], "git_node": null, "git_parents": [null], "node": "c2d721bb99e101b6b02515f2ac79fd50c1b7ccd1", "parents": ["85147561a2f389ee1b3d979d291f64fb301407b1"], "tags": []}, {"author": "Dragana Damjanovic \u003cdd.mozilla@gmail.com\u003e", "branch": "default", "desc": "Bug 1563695 - Do not close SpdyConnectTransaction in TLSFilterTransaction. r=mayhemer, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37048", "files": ["netwerk/protocol/http/TunnelUtils.cpp"], "git_node": null, "git_parents": [null], "node": "cdbcaa87cf134d615259d5fd3b8c3fd0af415c33", "parents": ["c2d721bb99e101b6b02515f2ac79fd50c1b7ccd1"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1563824 - New error NS_ERROR_TOO_MANY_REQUESTS for 429 response. r=mayhemer, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37140", "files": ["docshell/base/nsDocShell.cpp", "js/xpconnect/src/xpc.msg", "netwerk/protocol/http/TunnelUtils.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpResponseHead.cpp", "netwerk/test/unit/test_http1-proxy.js", "netwerk/test/unit/test_http2-proxy.js", "testing/xpcshell/moz-http2/moz-http2.js", "xpcom/base/ErrorList.py"], "git_node": null, "git_parents": [null], "node": "7af424604cc50e52920fc01dfa04a451973d16bf", "parents": ["cdbcaa87cf134d615259d5fd3b8c3fd0af415c33"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1556491 - Close nsHttpConnection.mTLSFilter when transaction of that connection is being closed to correctly carry cancellation status and prevent calls on a closed ssl socket, r=dragana, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36111", "files": ["netwerk/protocol/http/nsHttpConnection.cpp"], "git_node": null, "git_parents": [null], "node": "75048276fb569c4399a52f3563c267a7be558875", "parents": ["7af424604cc50e52920fc01dfa04a451973d16bf"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1556491 - Always close http transactions from nsHttpConnection::CloseTransaction even when the connection or its filter does not refer any, r=dragana, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37102", "files": ["netwerk/protocol/http/nsHttpConnection.cpp"], "git_node": null, "git_parents": [null], "node": "23efc26d45b2d6c93a9efcb411b619915a4eea06", "parents": ["75048276fb569c4399a52f3563c267a7be558875"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1563538 - Propagate close reason through TLSFilterTransaction to allow tunnel stream reuse when possible + close the undelying tunnel stream when a tunneling connection is closed, r=dragana,kershaw+kershaw, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37122", "files": ["modules/libpref/init/all.js", "netwerk/protocol/http/TunnelUtils.cpp", "netwerk/protocol/http/TunnelUtils.h", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpHandler.h"], "git_node": null, "git_parents": [null], "node": "0256ae3b68fe31dcc2e21427e8a593e24f840e87", "parents": ["23efc26d45b2d6c93a9efcb411b619915a4eea06"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1562315 - Respect again=false indicated by http2 session when calling through TLSFilterTransaction, r=dragana, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37391", "files": ["netwerk/protocol/http/TunnelUtils.cpp", "netwerk/protocol/http/TunnelUtils.h"], "git_node": null, "git_parents": [null], "node": "b80a38be5b6bdee2c0ebe341f89764ce8d8a14c3", "parents": ["0256ae3b68fe31dcc2e21427e8a593e24f840e87"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1556846 - [10.15] Crash in [@ mozilla::plugins::PluginUtilsOSX::SetProcessName]. r=spohl, a=jcristau\n\nAllow limited access to the proc_pidinfo() syscall from the Mac utility process sandbox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37533", "files": ["security/sandbox/mac/SandboxPolicyUtility.h"], "git_node": null, "git_parents": [null], "node": "63288163530510b1393a90b3a1f196c196c88fc8", "parents": ["b80a38be5b6bdee2c0ebe341f89764ce8d8a14c3"], "tags": []}, {"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1565518, emergency preferences to turn off individual bug fixes: 1563695, 1556491, 1562315, r=kershaw, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37848", "files": ["modules/libpref/init/all.js", "netwerk/protocol/http/TunnelUtils.cpp", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpHandler.h"], "git_node": null, "git_parents": [null], "node": "399e7261f098dbac19bdd10fadfcc869c970bb87", "parents": ["63288163530510b1393a90b3a1f196c196c88fc8"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1553228 - Don't free result of FcPatternGetString. r=jfkthame, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38157", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp"], "git_node": null, "git_parents": [null], "node": "f5a32a8e545a11a3086b2ece93c6c60c16eadf4f", "parents": ["399e7261f098dbac19bdd10fadfcc869c970bb87"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 1565779 - Add encoding to non UTF-8 engines. r=Standard8, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37986", "files": ["browser/components/search/extensions/allaannonser-sv-SE/manifest.json", "browser/components/search/extensions/diec2/manifest.json", "browser/components/search/extensions/kannadastore/manifest.json", "browser/components/search/extensions/ozonru/manifest.json", "browser/components/search/extensions/priberam/manifest.json", "browser/components/search/extensions/rakuten/manifest.json", "browser/components/search/extensions/vatera/manifest.json", "browser/components/search/extensions/yahoo-jp-auctions/manifest.json", "browser/components/search/extensions/zoznam-sk/manifest.json"], "git_node": null, "git_parents": [null], "node": "bad97d6baab14c022cf973826f64dabf3c894825", "parents": ["f5a32a8e545a11a3086b2ece93c6c60c16eadf4f"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1565779 - Move encoding definitions to the correct location in the search engine manifest files. r=daleharvey, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38162", "files": ["browser/components/search/extensions/allaannonser-sv-SE/manifest.json", "browser/components/search/extensions/diec2/manifest.json", "browser/components/search/extensions/kannadastore/manifest.json", "browser/components/search/extensions/ozonru/manifest.json", "browser/components/search/extensions/priberam/manifest.json", "browser/components/search/extensions/rakuten/manifest.json", "browser/components/search/extensions/vatera/manifest.json", "browser/components/search/extensions/yahoo-jp-auctions/manifest.json", "browser/components/search/extensions/zoznam-sk/manifest.json"], "git_node": null, "git_parents": [null], "node": "2c3cf1bd7e6cc62ecc732ed337e1a05bb9b1fc46", "parents": ["bad97d6baab14c022cf973826f64dabf3c894825"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - add notarization workerType aliases. r=nthomas, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33856", "files": ["taskcluster/ci/config.yml"], "git_node": null, "git_parents": [null], "node": "608359297e3fe77fe5ed8e57543d24242ff8ee2e", "parents": ["2c3cf1bd7e6cc62ecc732ed337e1a05bb9b1fc46"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - mac-signing transform logic + config. r=tomprince, a=jcristau\n\nThis moves mac signing tasks to the notarization/iscript pool. It also\nadds support for pkg installers and notarization.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33857", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/task.py", "taskcluster/taskgraph/util/signed_artifacts.py"], "git_node": null, "git_parents": [null], "node": "c741fa80faaa123810293fb441cbff2536cade80", "parents": ["608359297e3fe77fe5ed8e57543d24242ff8ee2e"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - beetmove macosx pkg installer. r=sfraser, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33858", "files": ["taskcluster/taskgraph/manifests/firefox_candidates.yml", "taskcluster/taskgraph/manifests/firefox_nightly.yml"], "git_node": null, "git_parents": [null], "node": "25c573afcd27438ed8010707ee7b524be014a7a1", "parents": ["c741fa80faaa123810293fb441cbff2536cade80"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - add entitlements url for hardened runtime signing. r=tomprince, a=jcristau\n\nFor mac hardened runtime signing, we use an entitlements file that's now\nin-tree. This patch passes the url for that file in the task definition.\n\nThe original patch for this was written by sfraser.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33859", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/parameters.py", "taskcluster/taskgraph/transforms/signing.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "9f3c24f60e799c293f35ca75940f980dcfcf4785", "parents": ["25c573afcd27438ed8010707ee7b524be014a7a1"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - build_signing: macosx64-nightly -\u003e macosx64-shippable. r=callek, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33860", "files": ["taskcluster/taskgraph/loader/build_signing.py"], "git_node": null, "git_parents": [null], "node": "07ea65ef9f1ab336918ddebcca2191475abbe063", "parents": ["9f3c24f60e799c293f35ca75940f980dcfcf4785"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - ignore partner_subset if it's an empty list. r=tomprince, a=jcristau\n\nThe relpro action requires a list for partner_subset and defaults to\n`[]`. In `get_partner_config_by_url` we check to see `if\npartner_subset`, ignoring the subset if it's an empty list. We either\nneed to do the same thing in `get_partner_config_by_kind`, or we need to\nallow for a `null` value in the action (or populate an empty\n`partner_subset` with the partners from the partner config in the\naction)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D33861", "files": ["taskcluster/taskgraph/util/partners.py"], "git_node": null, "git_parents": [null], "node": "f0619c9d79229923c1c77fe41d151b50ed5177ba", "parents": ["07ea65ef9f1ab336918ddebcca2191475abbe063"], "tags": []}, {"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1471004 - add esr support for entitlements. r=tomprince, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38208", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/config.py", "taskcluster/taskgraph/transforms/signing.py"], "git_node": null, "git_parents": [null], "node": "cf6798f00871a23458546e0b8b3a1366d5759ea6", "parents": ["f0619c9d79229923c1c77fe41d151b50ed5177ba"], "tags": []}], "date": 1563403100, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "83": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 61219aed2735afac3edcf590e69edbb463ca7372 with FIREFOX_68_0_1esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "9f5a7479620e7631a4cc7f2df626d7a8bcdca64d", "parents": ["cf6798f00871a23458546e0b8b3a1366d5759ea6"], "tags": []}], "date": 1563403519, "git_changesets": [null], "user": "ffxbld"}, "84": {"changesets": [{"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1557844 - add back ProcessRuntime in RDD for mscom init. r=jya a=RyanVM\n\nThis fixes a CoInitializeEx failure when enabling Vorbis\ndecoding on RDD.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34244", "files": ["dom/media/ipc/RDDProcessImpl.h"], "git_node": null, "git_parents": [null], "node": "2160cc9168ad5835d47b7d97376cb3e21073e62e", "parents": ["9f5a7479620e7631a4cc7f2df626d7a8bcdca64d"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1552607 - p1: filter out invalid input buffers. r=jya a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36381", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/Codec.java"], "git_node": null, "git_parents": [null], "node": "53679e9046db08263ae7150cce0971c8389e16ea", "parents": ["2160cc9168ad5835d47b7d97376cb3e21073e62e"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1552607 - p2: check sample session ID when processing buffers. r=jya a=RyanVM\n\nBecause IPC call runs asynchronously in both remote decoder process and\ncontent process, ProcessOutput() for buffers prior to Flush() could be\nscheduled to run after the flush promise is resolved, and Codec.queueInput()\ncould be preempted and processes prior sample after flush.\nTo help check the validness of buffers, a session ID increased by flush\nis added to both RemoteDataDecoder and remote codec service and will be\npassed through IPC. If the passed ID doesn't agree with current session\nID, it means the buffer doesn't belong to current session and should be\ndiscard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36382", "files": ["dom/media/platforms/android/RemoteDataDecoder.cpp", "dom/media/platforms/android/RemoteDataDecoder.h", "media/webrtc/signaling/src/media-conduit/WebrtcMediaCodecVP8VideoCodec.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/Codec.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/CodecProxy.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/Sample.java"], "git_node": null, "git_parents": [null], "node": "57ae9ad9b5747b68f569184ed38775944f757d1a", "parents": ["53679e9046db08263ae7150cce0971c8389e16ea"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1548111 - Fix intermittent failure in browser/components/urlbar/tests/browser/browser_tabMatchesInAwesomebar.js by ignoring spurious resize events. r=mak a=RyanVM\n\nAfter many retriggers on try, this test is now not failing at all, so hopefully this fixes both bug 1548111 and bug 1562416 for good. https://treeherder.mozilla.org/#/jobs?repo=try&revision=442628a48a649ade02b2ab1e58b1fc5bf5653306\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36864", "files": ["browser/components/urlbar/UrlbarView.jsm"], "git_node": null, "git_parents": [null], "node": "70ad054247e013c6ab72f3c61f3c2024a8da34b0", "parents": ["57ae9ad9b5747b68f569184ed38775944f757d1a"], "tags": []}, {"author": "Thomas Nguyen \u003ctnguyen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1556827 - Dont send referrer in case of meta refresh redirect r=smaug a=RyanVM\nDifferential Revision: https://phabricator.services.mozilla.com/D35810", "files": ["docshell/base/nsDocShell.cpp", "dom/base/test/iframe_meta_refresh.sjs", "dom/base/test/mochitest.ini", "dom/base/test/test_meta_refresh_referrer.html", "dom/security/ReferrerInfo.cpp", "dom/security/ReferrerInfo.h"], "git_node": null, "git_parents": [null], "node": "962a469c7f36c46c4eab5138e4f66d44f7ec0e28", "parents": ["70ad054247e013c6ab72f3c61f3c2024a8da34b0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1563484 - Apply text-only zoom to system fonts. r=dbaron a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36893", "files": ["servo/components/style/properties/longhands/font.mako.rs"], "git_node": null, "git_parents": [null], "node": "32bae01305928d8d7f8953ba9dbeab4b66ac9126", "parents": ["962a469c7f36c46c4eab5138e4f66d44f7ec0e28"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1563484 - Add reftest support for text-zoom. r=dbaron a=RyanVM\n\nSeems we had no reftests for this feature :(\n\nDepends on D36893\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36894", "files": ["layout/reftests/reftest-sanity/reftest.list", "layout/reftests/reftest-sanity/text-zoom-notref.html", "layout/reftests/reftest-sanity/text-zoom-ref.html", "layout/reftests/reftest-sanity/text-zoom.html", "layout/tools/reftest/reftest-content.js"], "git_node": null, "git_parents": [null], "node": "b4a0946bc2db94c81c0cb64aec2c81e920f24c4b", "parents": ["32bae01305928d8d7f8953ba9dbeab4b66ac9126"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1563484 - Add reftests for this bug. r=dbaron a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36895", "files": ["layout/reftests/bugs/1563484-notref.html", "layout/reftests/bugs/1563484-ref.html", "layout/reftests/bugs/1563484.html", "layout/reftests/bugs/reftest.list"], "git_node": null, "git_parents": [null], "node": "db86d910c6a254f2e106351123bf3937f826cd16", "parents": ["b4a0946bc2db94c81c0cb64aec2c81e920f24c4b"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 1564021 - Use the default desktop width (980px) in the case where we have any viewport meta element but no valid content there. r=botond a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37329", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "layout/reftests/meta-viewport/invalid-content.html", "layout/reftests/meta-viewport/reftest.list", "layout/reftests/meta-viewport/width-980-ref.html"], "git_node": null, "git_parents": [null], "node": "a2e7bc6a287ab7b14eacf0e34917af9e2459934f", "parents": ["db86d910c6a254f2e106351123bf3937f826cd16"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1563734 - always sync session ID from remote decoder. r=jya, a=RyanVM\n\nIn bug 1552607/D36382, RemoteDataDecoder always increases session ID but\nCodecProxy only performs flush IPC when neccessary. This will cause the\nID numbers out of sync and prevent remote decoder from receiving any\nmore input. By reading the session ID in dequeued input samples, the\nnumbers can always be in sync.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37123", "files": ["dom/media/platforms/android/RemoteDataDecoder.cpp", "dom/media/platforms/android/RemoteDataDecoder.h", "media/webrtc/signaling/src/media-conduit/WebrtcMediaCodecVP8VideoCodec.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/Codec.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/CodecProxy.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/Sample.java"], "git_node": null, "git_parents": [null], "node": "1e4cd8f427ca9e82ff8c8c7eb65b3b9310966e38", "parents": ["a2e7bc6a287ab7b14eacf0e34917af9e2459934f"], "tags": []}, {"author": "Tarek Ziad\u00e9 \u003ctarek@mozilla.com\u003e", "branch": "default", "desc": "Bug 1561404 - Ensure thread safety r=jya a=RyanVM\n\nAdds a lock in MediaCacheStream::SizeOfExcludingThis to prevent a race\ncondition with MediaCache::NoteSeek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36880", "files": ["dom/media/MediaCache.cpp"], "git_node": null, "git_parents": [null], "node": "d1e0829f0a0043bdfaba859f04faab767a22d789", "parents": ["1e4cd8f427ca9e82ff8c8c7eb65b3b9310966e38"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 1514437: Correctly encode the strings passed through nsIMacAttributionService. r=mconley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37317", "files": ["browser/components/attribution/nsIMacAttribution.idl"], "git_node": null, "git_parents": [null], "node": "0fe299a5238843cd9b917c483d976d80179f7fbb", "parents": ["d1e0829f0a0043bdfaba859f04faab767a22d789"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1546027 - Don't apply scroll anchor adjustments if we're restoring our scroll position. r=dholbert a=RyanVM\n\nSince scroll position restoration is absolute, and we'll lose it as soon as we\napply any adjustment or do any other sort of scrolling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37941", "files": ["layout/generic/ScrollAnchorContainer.cpp", "layout/generic/nsGfxScrollFrame.h"], "git_node": null, "git_parents": [null], "node": "f0c9647660d55b3c8564168c6634cda323b08e4c", "parents": ["0fe299a5238843cd9b917c483d976d80179f7fbb"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1564082 The app crash after reopening the recent closed tabs r=petru a=RyanVM\n\nThe cursor was trying to move to first record after it was closed which lead into\nIllegalStateException.\nIn order to avoid this exception, we should simply check if the cursor was already\nclosed before trying to move to the first record.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38085", "files": ["mobile/android/base/java/org/mozilla/gecko/home/CombinedHistoryAdapter.java"], "git_node": null, "git_parents": [null], "node": "8ccf0434f4218329daf3058a3039030da94e1e12", "parents": ["f0c9647660d55b3c8564168c6634cda323b08e4c"], "tags": []}], "date": 1563444396, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "85": {"changesets": [{"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1529205 - Remove DateTimePickerParent's dependency on gBrowser; r=mconley a=jorgk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35392", "files": ["browser/base/content/tabbrowser.js", "browser/modules/FormValidationHandler.jsm", "toolkit/content/widgets/browser-custom-element.js", "toolkit/modules/DateTimePickerParent.jsm"], "git_node": null, "git_parents": [null], "node": "31ea7a5211b05eb55a9341e8205ab6cfe75b7583", "parents": ["61219aed2735afac3edcf590e69edbb463ca7372"], "tags": []}, {"author": "Emilio Cobos Alvarez \u003cemilio@crisal.io\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1561288 - Don't override currentContent when focusing something on a shadow root. r=smaug a=jorgk\n\nIt is wrong, what we're trying to focus is frame-\u003eGetContent() still.\n\nThis is not reproducible outside of Thunderbird because for it to happen the\nfocus manager needs to wrap around the start content.\n\nHere's what's going on:\n\n * We start with a \u003ctree\u003e focused, which is a shadow host.\n * There's nothing else to focus inside the \u003ctree\u003e, or after the \u003ctree\u003e in document order.\n * So we restart the search with a different tabindex (1), but find nothing before the tree (since all focusable elements before the tree also have tabindex 0), and we return wrongly in [1], instead of searching with tabindex 0 again afterwards. (Since the child frame is not focusable, we wrongly end up at [1], and returning early, since currentContent != frame-\u003eGetContent(), instead of keeping looking for the right thing to focus.)\n\nAs I said this cannot reproduce on content, as far as I can tell, so I'm not\nsure how to go about testing this, but all the shadow dom tab navigation tests\nkeep passing with this change.\n\n[1]: https://searchfox.org/mozilla-central/rev/06bd14ced96f25ff1dbd5352cb985fc0fa12a64e/dom/base/nsFocusManager.cpp#3560\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36196", "files": ["dom/base/nsFocusManager.cpp"], "git_node": null, "git_parents": [null], "node": "3922e27da4a9b7cec4774a50bcf8a85f3364f853", "parents": ["31ea7a5211b05eb55a9341e8205ab6cfe75b7583"], "tags": []}, {"author": "Tim Nguyen \u003cntim.bugs@gmail.com\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1563529 - Make HTML inputs inherit font in global.css. r=dao a=jorgk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36933", "files": ["toolkit/themes/shared/global.inc.css"], "git_node": null, "git_parents": [null], "node": "f54da7f15bd40428719e2c79e083ca67f571672e", "parents": ["3922e27da4a9b7cec4774a50bcf8a85f3364f853"], "tags": []}, {"author": "Kai Engert \u003ckaie@kuix.de\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1559900 - Allow applications to add sections to about:license. r=mhoye a=jorgk", "files": ["toolkit/content/license.html"], "git_node": null, "git_parents": [null], "node": "f844f1b563a8fcc2afbc49a94d732389e633c40e", "parents": ["f54da7f15bd40428719e2c79e083ca67f571672e"], "tags": []}, {"author": "Geoff Lankow \u003cgeoff@darktrojan.net\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1561650 - Ignore unused modifier keys on keydown events in \u003ctree\u003e r=vporof a=jorgk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38248", "files": ["toolkit/content/widgets/tree.js"], "git_node": null, "git_parents": [null], "node": "24ee5f54b0a343b67dc4d14961a9f6124904671c", "parents": ["f844f1b563a8fcc2afbc49a94d732389e633c40e"], "tags": []}, {"author": "Kai Engert \u003ckaie\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1561366 - Don't delete key3.db when upgrading to TB 68.x (backout bug 1475775). a=jorgk DONTBUILD", "files": ["security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/tests/unit/test_sdr_upgraded_with_password.js"], "git_node": null, "git_parents": [null], "node": "575925ca8346593f2a2796616eeaae774f2ccf79", "parents": ["24ee5f54b0a343b67dc4d14961a9f6124904671c"], "tags": []}], "date": 1563445560, "git_changesets": [null, null, null, null, null, null], "user": "mozilla@jorgk.com"}, "86": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38480", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/blocklists/plugins.json"], "git_node": null, "git_parents": [null], "node": "48cc388268ceace0c60cb52ea0d9209c3bb45f54", "parents": ["8ccf0434f4218329daf3058a3039030da94e1e12"], "tags": []}], "date": 1563455163, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "87": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 61219aed2735afac3edcf590e69edbb463ca7372 with FIREFOX_68_0_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "dee57e2e6c536b5d3a475b8c4b79a3c57f6aeef6", "parents": ["48cc388268ceace0c60cb52ea0d9209c3bb45f54"], "tags": []}], "date": 1563463299, "git_changesets": [null], "user": "ffxbld"}, "88": {"changesets": [{"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1529557 - Ensure share icons will have the same size r=VladBaicu a=RyanVM\n\nUsed `fitCenter` and`adjustViewBounds` to ensure the images will be scaled to\nfit their container while keeping their aspect ratio.\nIncreased resolution of some images used in the share menu to maths the others'\nand also remove some bluriness of the previous' when they are enlarged.\nThey were losslessly optimized with an average of 18% savings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37386", "files": ["mobile/android/app/src/main/res/drawable-hdpi/ic_menu_share.png", "mobile/android/app/src/main/res/drawable-hdpi/icon_shareplane.png", "mobile/android/app/src/main/res/drawable-hdpi/shareplane.png", "mobile/android/app/src/main/res/drawable-xhdpi/ic_menu_share.png", "mobile/android/app/src/main/res/drawable-xhdpi/icon_shareplane.png", "mobile/android/app/src/main/res/drawable-xhdpi/shareplane.png", "mobile/android/app/src/main/res/drawable-xxhdpi/ic_menu_share.png", "mobile/android/app/src/main/res/drawable-xxhdpi/icon_shareplane.png", "mobile/android/app/src/main/res/drawable-xxhdpi/shareplane.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/ic_menu_share.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/icon_shareplane.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/shareplane.png", "mobile/android/app/src/main/res/values/styles.xml"], "git_node": null, "git_parents": [null], "node": "09cc82fc4ca81bd0921fc897fe895980f8cb9af6", "parents": ["dee57e2e6c536b5d3a475b8c4b79a3c57f6aeef6"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1529557 - Mutate share drawable to prevent against it being reused from cache; r=VladBaicu a=RyanVM\n\nSummary:\nThe share drawable is used in multiple places in code.\nAndroid would cache it and subsequently serve a now dirty version of it with\ntransformations potentially added.\nBy mutating it into a new drawable we ensure we'll always have it clean.\n\nReviewers: VladBaicu\n\nReviewed By: VladBaicu\n\nSubscribers: emilio\n\nBug #: 1529557\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37734", "files": ["mobile/android/base/java/org/mozilla/gecko/menu/MenuItemSwitcherLayout.java"], "git_node": null, "git_parents": [null], "node": "5eddd62ba78becfe257bc693509753310c130f47", "parents": ["09cc82fc4ca81bd0921fc897fe895980f8cb9af6"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1529557 - Use smaller share image to ensure consistency; r=AndreiLazar a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38195", "files": ["mobile/android/app/src/main/res/drawable-hdpi/ic_menu_share.png", "mobile/android/app/src/main/res/drawable-xhdpi/ic_menu_share.png", "mobile/android/app/src/main/res/drawable-xxhdpi/ic_menu_share.png", "mobile/android/app/src/main/res/drawable-xxxhdpi/ic_menu_share.png"], "git_node": null, "git_parents": [null], "node": "abc389fce641412fad384a3a889c6ea364978159", "parents": ["5eddd62ba78becfe257bc693509753310c130f47"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1560044 - Allow --with-macos-sdk as an option when cross-compiling on macOS. r=nalexander a=RyanVM\n\nBuilding host tools on macOS require a macOS SDK, but it's currently\nnot configurable when cross-compiling for e.g. Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36557", "files": ["build/moz.configure/toolchain.configure"], "git_node": null, "git_parents": [null], "node": "ee9e4771f9b8671b040a687ee8c2b62d406e8691", "parents": ["abc389fce641412fad384a3a889c6ea364978159"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1560044 - Always use a SDK path on macOS. r=nalexander a=RyanVM\n\nThe SDK headers may not be installed in /usr/include. The usual response\nhas been to have people run e.g. `open\n/Library/Developer/CommandLineTools/Packages/macOS_SDK_headers_for_macOS_10.14.pkg`\nwhich is not really sustainable.\n\nThis makes builds that happen on a macOS host try to detect their SDK\nand use that as a default for --with-macos-sdk, which has the side\neffect of enabling the SDK version check in that configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36558", "files": ["build/moz.configure/toolchain.configure", "python/mozbuild/mozbuild/test/configure/fake_macos_sdk/SDKSettings.plist", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py", "python/mozbuild/mozbuild/test/configure/test_toolchain_helpers.py"], "git_node": null, "git_parents": [null], "node": "47d890eaa3417e93f66eac6ef3642a04e07b83e7", "parents": ["ee9e4771f9b8671b040a687ee8c2b62d406e8691"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1560044 - Make Xcode checks macOS host only. r=nalexander a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36559", "files": ["build/moz.configure/toolchain.configure"], "git_node": null, "git_parents": [null], "node": "4fa7260201bb5cb3708f914d1766c1d35917a5ee", "parents": ["47d890eaa3417e93f66eac6ef3642a04e07b83e7"], "tags": []}], "date": 1563464262, "git_changesets": [null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "89": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566043 - Update npm dependencies for ESLint. r=ahal,a=NPOTB\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38490", "files": ["package-lock.json", "tools/lint/eslint/eslint-plugin-mozilla/manifest.tt", "tools/lint/eslint/eslint-plugin-mozilla/package-lock.json", "tools/lint/eslint/manifest.tt"], "git_node": null, "git_parents": [null], "node": "0bd8c1e52943ae122f9571a9a61c1a7fad7a7ee9", "parents": ["4fa7260201bb5cb3708f914d1766c1d35917a5ee"], "tags": []}], "date": 1563466973, "git_changesets": [null], "user": "mbanner@mozilla.com"}, "90": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Backed out 3 changesets (bug 1560044) for linux build test failure at test_toolchain_configure.py::OSXToolchainTest::test_unsupported_clang. a=backout\n\nBacked out changeset 4fa7260201bb (bug 1560044)\nBacked out changeset 47d890eaa341 (bug 1560044)\nBacked out changeset ee9e4771f9b8 (bug 1560044)", "files": ["build/moz.configure/toolchain.configure", "python/mozbuild/mozbuild/test/configure/fake_macos_sdk/SDKSettings.plist", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py", "python/mozbuild/mozbuild/test/configure/test_toolchain_helpers.py"], "git_node": null, "git_parents": [null], "node": "726a3249f18ba4f847a291d427acd1cad41c5763", "parents": ["0bd8c1e52943ae122f9571a9a61c1a7fad7a7ee9"], "tags": []}], "date": 1563467788, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "91": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1567011: [update-verify] Use version number to determine branch, rather than product-details category; r=mhentges,rail a=tomprince\n\nFor esr versions, the category switches from \"esr\" to \"stability\" when the next esr branch is started. This breaks\nthe logic for determining which repository a release was made from. Since we also have code for determining the\ntype of release from the version number, we can just use that directly instead.\n\n(Note that the logic will not work for Fennec as all releases have transitioned to mozilla-esr68, but Fennec does not\nuse update-verify.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38437", "files": ["testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": null, "git_parents": [null], "node": "f5920839f310aa6e2d4b04c0a9877f67f14b00da", "parents": ["61219aed2735afac3edcf590e69edbb463ca7372"], "tags": []}], "date": 1563470114, "git_changesets": [null], "user": "mozilla@hocat.ca"}, "92": {"changesets": [{"author": "Tom Prince \u003cmozilla@hocat.ca\u003e", "branch": "default", "desc": "Bug 1567011: [update-verify] Use version number to determine branch, rather than product-details category; r=mhentges,rail a=tomprince\n\nFor esr versions, the category switches from \"esr\" to \"stability\" when the next esr branch is started. This breaks\nthe logic for determining which repository a release was made from. Since we also have code for determining the\ntype of release from the version number, we can just use that directly instead.\n\n(Note that the logic will not work for Fennec as all releases have transitioned to mozilla-esr68, but Fennec does not\nuse update-verify.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38437", "files": ["testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": null, "git_parents": [null], "node": "6cb16d2f8b7058f8f855a3db0ec21c6f8cfb79d5", "parents": ["726a3249f18ba4f847a291d427acd1cad41c5763"], "tags": []}], "date": 1563470222, "git_changesets": [null], "user": "mozilla@hocat.ca"}, "93": {"changesets": [{"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1564208 part 1: Allow extensions to use SVG content regardless of whether the svg.disabled pref is toggled. r=smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37461", "files": ["dom/base/nsNodeInfoManager.cpp"], "git_node": null, "git_parents": [null], "node": "db12384577c9944e62bab7206d4a998b1afc7100", "parents": ["6cb16d2f8b7058f8f855a3db0ec21c6f8cfb79d5"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 1564208 part 2: Use Maybe\u003cbool\u003e to represent lazily-initialized bools for SVG/MathML enabling. r=smaug a=RyanVM\n\nThis patch shouldn't affect behavior at all -- it's just removing a custom enum\ntype, in favor of our more standard representation for lazily-initialized bool,\nwhich is Maybe\u003cbool\u003e.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37465", "files": ["dom/base/nsNodeInfoManager.cpp", "dom/base/nsNodeInfoManager.h"], "git_node": null, "git_parents": [null], "node": "c7a79bce7bcdaf442b9f6e4bf4d1a881d791576f", "parents": ["db12384577c9944e62bab7206d4a998b1afc7100"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 1388015 - Add checks to respect CSP-wildcard + Ports r=ckerschb a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35432", "files": ["dom/security/nsCSPUtils.cpp", "dom/security/test/csp/file_dummy_pixel.png", "dom/security/test/csp/mochitest.ini", "dom/security/test/csp/test_bug1388015.html"], "git_node": null, "git_parents": [null], "node": "fda4a1ea7cf469c11901a7b9db0f284f0a3ead7c", "parents": ["c7a79bce7bcdaf442b9f6e4bf4d1a881d791576f"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1564330: Update tzdata in ICU data files to 2019b. r=jwalden a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com//D37544", "files": ["config/external/icu/data/icudt64l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_notbackward_links.js"], "git_node": null, "git_parents": [null], "node": "a72db9bbc92b4c95f333293ac2df73ed87a44e42", "parents": ["fda4a1ea7cf469c11901a7b9db0f284f0a3ead7c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1554572 - Don't apply scroll anchor adjustments if we're processing an async scroll animation. r=dholbert a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38077", "files": ["layout/generic/ScrollAnchorContainer.cpp"], "git_node": null, "git_parents": [null], "node": "bc6fa9b448fc88c595f1232d03cad104b0113da7", "parents": ["a72db9bbc92b4c95f333293ac2df73ed87a44e42"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 1452037 - Fix Whitelisting of javascript-uris with csp hash r=ckerschb a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35412", "files": ["dom/security/nsCSPContext.cpp", "dom/security/test/csp/file_bug1452037.html", "dom/security/test/csp/mochitest.ini", "dom/security/test/csp/test_bug1452037.html"], "git_node": null, "git_parents": [null], "node": "a2284c62e28a2372d0dcb6abc2491012976e6828", "parents": ["bc6fa9b448fc88c595f1232d03cad104b0113da7"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1560183 - Re-enable the RDD Process for MinGW builds r=jya a=RyanVM\n\nBug 1557844 fixed (inadvertently) the failures we were getting with RDD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38263", "files": ["modules/libpref/init/StaticPrefList.h", "modules/libpref/init/all.js"], "git_node": null, "git_parents": [null], "node": "1b09a11d1ca3b9f411f182f29f0ed1011731e726", "parents": ["a2284c62e28a2372d0dcb6abc2491012976e6828"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1565877 - Bump the stack size on mingwclang builds r=firefox-build-system-reviewers,mshal a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38019", "files": ["config/config.mk"], "git_node": null, "git_parents": [null], "node": "dbf28eeb86265fdcfcf7bbe6e6ad5ad3669d1f0b", "parents": ["1b09a11d1ca3b9f411f182f29f0ed1011731e726"], "tags": []}, {"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1558887: Reduce this STUN response delay a little, since on some platforms it seems to be too long. r=mjf a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37474", "files": ["media/mtransport/test/ice_unittest.cpp"], "git_node": null, "git_parents": [null], "node": "1d61d31a3bf5bb233250a660155fd2cc404a9fb9", "parents": ["dbf28eeb86265fdcfcf7bbe6e6ad5ad3669d1f0b"], "tags": []}, {"author": "Andreea Pavel \u003capavel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1478205 - disabled browser_locationBarCommand.js on esr68 r=Standard8 a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com//D38402", "files": ["browser/components/urlbar/tests/legacy/browser.ini"], "git_node": null, "git_parents": [null], "node": "e64d028bbac21fec00b807da0f80c7b46e81974d", "parents": ["1d61d31a3bf5bb233250a660155fd2cc404a9fb9"], "tags": []}], "date": 1563559508, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "94": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nbn -\u003e 27ef86515251\ndsb -\u003e 009dedd9a331\nen-CA -\u003e 8b6e7bf5bec0\nes-ES -\u003e 35a21d259060\nes-MX -\u003e ea2cc1d2aedd\neu -\u003e 4e13c883ea55\nfi -\u003e c7baaa4b862c\nfr -\u003e 56cd07059971\ngn -\u003e 1bcbf75033e3\nhi-IN -\u003e 90ae1a185264\nhr -\u003e 09cc31597087\nhsb -\u003e 6dc856ea94b9\nhu -\u003e 440b6da4ca6d\nit -\u003e c55b6394e2bd\nkab -\u003e fb55e6083da0\nkk -\u003e 1af4b29f9498\nko -\u003e 264f9c270d44\nlij -\u003e 627d91a8ad54\nlo -\u003e ff8d31a74e02\nnb-NO -\u003e a4a057056cb2\nnl -\u003e 231bbcf2c9d2\nnn-NO -\u003e 4131e31dc2e9\npt-BR -\u003e cf2331678100\npt-PT -\u003e fb2999fc7104\nsk -\u003e 90568ec879bd\nsl -\u003e 375641b3af29\nsr -\u003e bc638c7ea351\nsv-SE -\u003e 06134b59b194\ntr -\u003e 89e40658b40c\ntrs -\u003e 10ce570995eb\nuk -\u003e 7384f904aef9\nvi -\u003e 94dfd7478544\nzh-CN -\u003e d097aa6d35e5\nzh-TW -\u003e 118871907695", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "6a58d046887a8c34de23408370ca322db12adeb4", "parents": ["e64d028bbac21fec00b807da0f80c7b46e81974d"], "tags": []}], "date": 1563742961, "git_changesets": [null], "user": "ffxbld"}, "95": {"changesets": [{"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566957 - Ensure robocop runs with --disable-e10s; r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38395", "files": ["testing/mozharness/scripts/android_emulator_unittest.py"], "git_node": null, "git_parents": [null], "node": "38fe6d861fb1b187fbe1b4405a307440b1151724", "parents": ["6a58d046887a8c34de23408370ca322db12adeb4"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1562622 Startup crash - java.lang.IllegalStateException: This ViewTreeObserver is not alive, call getViewTreeObserver() again. r=petru, a=RyanVM\n\nNow checking the global view tree observer to see if it's alive in order to unsubscribe from further\nnotifications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36485", "files": ["mobile/android/base/java/org/mozilla/gecko/home/TabMenuStripLayout.java"], "git_node": null, "git_parents": [null], "node": "2e1b548e70b387f79a9173cdff7ec4d25eebeec3", "parents": ["38fe6d861fb1b187fbe1b4405a307440b1151724"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1557547 - Actively reject clang \u003c 4.0 during configure. r=mshal, a=RyanVM\n\nBug 1394825 bumped the minimum version of clang we use on automation,\nfor the base toolchain jobs, and there's a libclang test for bindgen,\nbut we should reject the compiler in the first place.\n\nThe check to do that works in both C and C++, contrary to the original\n3.6 test that was checking a C++ feature ; the test was later changed\nfor 3.9, using a check that would have worked in both C and C++, but\nthe C exception was left around. We remove it now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34083", "files": ["build/moz.configure/toolchain.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py", "python/mozbuild/mozbuild/test/configure/test_toolchain_helpers.py"], "git_node": null, "git_parents": [null], "node": "4c1dcf5efb3f97fd2470034b154e4aa2ea498b39", "parents": ["2e1b548e70b387f79a9173cdff7ec4d25eebeec3"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1560044 - Allow --with-macos-sdk as an option when cross-compiling on macOS. r=nalexander a=RyanVM\n\nBuilding host tools on macOS require a macOS SDK, but it's currently\nnot configurable when cross-compiling for e.g. Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36557", "files": ["build/moz.configure/toolchain.configure"], "git_node": null, "git_parents": [null], "node": "b7e8b83d86daf3f94d805817c8de5eaa798fbed1", "parents": ["4c1dcf5efb3f97fd2470034b154e4aa2ea498b39"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1560044 - Always use a SDK path on macOS. r=nalexander a=RyanVM\n\nThe SDK headers may not be installed in /usr/include. The usual response\nhas been to have people run e.g. `open\n/Library/Developer/CommandLineTools/Packages/macOS_SDK_headers_for_macOS_10.14.pkg`\nwhich is not really sustainable.\n\nThis makes builds that happen on a macOS host try to detect their SDK\nand use that as a default for --with-macos-sdk, which has the side\neffect of enabling the SDK version check in that configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36558", "files": ["build/moz.configure/toolchain.configure", "python/mozbuild/mozbuild/test/configure/fake_macos_sdk/SDKSettings.plist", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py", "python/mozbuild/mozbuild/test/configure/test_toolchain_helpers.py"], "git_node": null, "git_parents": [null], "node": "7be1a6c9e9bc5237cbf9ca374cca1beb465485a5", "parents": ["b7e8b83d86daf3f94d805817c8de5eaa798fbed1"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1560044 - Make Xcode checks macOS host only. r=nalexander a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36559", "files": ["build/moz.configure/toolchain.configure"], "git_node": null, "git_parents": [null], "node": "9c631c20c9895537aec5da2ffd6c096558a1578a", "parents": ["7be1a6c9e9bc5237cbf9ca374cca1beb465485a5"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1563133 - limit GlyphBuffer capacity. r=jfkthame, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38214", "files": ["gfx/thebes/gfxFont.cpp"], "git_node": null, "git_parents": [null], "node": "9a0b6508732b643f3dcd1f6ac4b7da7c1ced0bc1", "parents": ["9c631c20c9895537aec5da2ffd6c096558a1578a"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1560417 - Intermittent timeout in browser_inputHistory.js - beta patch. r=dao a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com//D37409", "files": ["browser/components/urlbar/tests/browser/browser_inputHistory.js"], "git_node": null, "git_parents": [null], "node": "711287a1b63d3f5c4ae9d6d38acb337d63e5742a", "parents": ["9a0b6508732b643f3dcd1f6ac4b7da7c1ced0bc1"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1550442 - check track's ready state in the beginning of the test. r=baku, a=test-only\n\nIf the track has already finished loading, we can directly run `trackLoaded()`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37953", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/track/track-element/track-mode.html"], "git_node": null, "git_parents": [null], "node": "5fdbdb559b3804af44d1db7c978ea58019f67bf0", "parents": ["711287a1b63d3f5c4ae9d6d38acb337d63e5742a"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1550442 - extend cue's duration. r=baku, a=test-only\n\nIn order not to miss the second cue, we extend the duration of both the second and third cue to 1 second. And adjust the third cue's start time to keep them non-overlapping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38529", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/track/track-element/resources/captions-fast.vtt"], "git_node": null, "git_parents": [null], "node": "7af81b97c75f3ad2b37997e97d34ae8894ea295b", "parents": ["5fdbdb559b3804af44d1db7c978ea58019f67bf0"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38872", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "9fd38bfea1433b5e6ad61eee5b539f7051210796", "parents": ["7af81b97c75f3ad2b37997e97d34ae8894ea295b"], "tags": []}], "date": 1563804427, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "96": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nca -\u003e 8c49f8e52514\ncy -\u003e 77255c0fad94\nde -\u003e 4d4bb2f97092\nes-AR -\u003e f46908a398ad\nfi -\u003e d5b57da5279a\nfr -\u003e adf49eead120\ngn -\u003e 7b67944b07d1\nkab -\u003e a095ee897735\nlt -\u003e f838df4da196\nnl -\u003e 69ded835e8ae\npa-IN -\u003e 2e445ddb7116\npl -\u003e 552ad1d35e0e\npt-BR -\u003e b3b2608ba5e8\npt-PT -\u003e 10dfd5cd677e\nru -\u003e 27d2c803c9fc\nsv-SE -\u003e a041e3fc1749\ntr -\u003e eaaaa7cc584a\nvi -\u003e f3a9d38d1670", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "a1a76563f1b7f9899c0011a40c2a91781be3f820", "parents": ["9fd38bfea1433b5e6ad61eee5b539f7051210796"], "tags": []}], "date": 1563822029, "git_changesets": [null], "user": "ffxbld"}, "97": {"changesets": [{"author": "Joseph Jalbert \u003cjoseph.a.jalbert@gmail.com\u003e", "branch": "default", "desc": "Bug 1542351: Allow 'edge' and non-gecko browser specific settings in the extensions schema manifest r=rpl a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D32819", "files": ["toolkit/components/extensions/schemas/manifest.json", "toolkit/mozapps/extensions/test/xpcshell/test_webextension_install.js"], "git_node": null, "git_parents": [null], "node": "649260006f28035f6c9453fc2510dbff8c0dca74", "parents": ["a1a76563f1b7f9899c0011a40c2a91781be3f820"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 1555287 - Make sure to detach browsing context children early. r=nika a=RyanVM\n\nAlways move browsing contexts to the cache, even if we're not caching\nthe docshell. If we're not moving to bfcache, BrowsingContext::Detach\nwill detach as normal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35594", "files": ["docshell/base/nsDocShell.cpp"], "git_node": null, "git_parents": [null], "node": "cd330a25b8346edcc0ca0ad37b8cf2dd1f340400", "parents": ["649260006f28035f6c9453fc2510dbff8c0dca74"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1561887 part 1.  Add an overload of JS::ObjectIsMarkedGray that works on TenuredHeap.  r=sfink a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36868", "files": ["js/public/RootingAPI.h"], "git_node": null, "git_parents": [null], "node": "19f09bb6f2af0324127514cbfc8460b43930ede6", "parents": ["cd330a25b8346edcc0ca0ad37b8cf2dd1f340400"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1561887 part 2.  Fix cycle-collection skipping of JSEventHandler to work correctly.  r=smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36870", "files": ["dom/bindings/CallbackFunction.h", "dom/bindings/CallbackObject.cpp", "dom/bindings/CallbackObject.h", "dom/events/JSEventHandler.cpp", "dom/events/test/mochitest.ini", "dom/events/test/test_event_handler_cc.html"], "git_node": null, "git_parents": [null], "node": "bde8d8dcdcf1340801be0e2136625eaf84261590", "parents": ["19f09bb6f2af0324127514cbfc8460b43930ede6"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1563812 - Quantumbar: Fix keyboard navigation after stale results have been removed. r=dao a=RyanVM", "files": ["browser/components/urlbar/UrlbarView.jsm", "browser/components/urlbar/tests/browser/browser_selectStaleResults.js"], "git_node": null, "git_parents": [null], "node": "a5c92411c5bd711ffa8543804c84f49e8095daa3", "parents": ["bde8d8dcdcf1340801be0e2136625eaf84261590"], "tags": []}, {"author": "Jan Andre Ikenmeyer \u003cjan@ikenmeyer.eu\u003e", "branch": "default", "desc": "Bug 1563854 - Restrict Nvidia blocklist entry to the proprietary driver. r=aosmond a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com//D38155", "files": ["widget/GfxDriverInfo.cpp", "widget/GfxDriverInfo.h", "widget/GfxInfoX11.cpp"], "git_node": null, "git_parents": [null], "node": "775c2570f6a3e7d5ffe1c7f58d9bdb8a0ca7030c", "parents": ["a5c92411c5bd711ffa8543804c84f49e8095daa3"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1480031 - Truncate floating menu labels if they overflow screen width; r=VladBaicu a=RyanVM\n\nThere's currently a bug in Android's framework that manifests by placing the\nfloating menu off-screen if a menu label overflows the menu's width.\nhttps://issuetracker.google.com/issues/137169336\nTo overcome this we'll manually check and truncate any menu label that could\ncause issues based on the floating menu style declared upstream.\n\nDifferential Revision: https://phabricator.services.mozilla.com//D37684", "files": ["mobile/android/app/src/main/res/values/dimens.xml", "mobile/android/base/java/org/mozilla/gecko/text/FloatingActionModeCallback.java", "mobile/android/base/java/org/mozilla/gecko/util/WindowUtils.java"], "git_node": null, "git_parents": [null], "node": "c9ef4f8577c5dc17a3af7f95934d60d2f84db571", "parents": ["775c2570f6a3e7d5ffe1c7f58d9bdb8a0ca7030c"], "tags": []}, {"author": "Brad Arant \u003cbrad.arant@softvision.com\u003e", "branch": "default", "desc": "Bug 1268019 - Fix code violation of missing braces on if code block.;r=VladBaicu a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34386", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java"], "git_node": null, "git_parents": [null], "node": "4600a8eb6de26e4fd5bcb6f323d946eb95c69be1", "parents": ["c9ef4f8577c5dc17a3af7f95934d60d2f84db571"], "tags": []}, {"author": "Brad Arant \u003cbrad.arant@softvision.com\u003e", "branch": "default", "desc": "Bug 1268019 - Return default icon for download files that do not have intent for handling.;r=VladBaicu a=RyanVM\n\nDepends on D34386\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34387", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/main/res/drawable/ic_generic_file.xml"], "git_node": null, "git_parents": [null], "node": "aa83ff02de69a51bbcf18ca9d269252741d25b6e", "parents": ["4600a8eb6de26e4fd5bcb6f323d946eb95c69be1"], "tags": []}, {"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1556437 - Use VectorDrawableCompat to load the error svg; r=AndreiLazar a=RyanVM\n\nVectorDrawableCompat allows backwards compatibility up to API 14.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38185", "files": ["mobile/android/base/java/org/mozilla/gecko/FindInPageBar.java"], "git_node": null, "git_parents": [null], "node": "2eccd9d294385e3e162dff24eea613542e0b8391", "parents": ["aa83ff02de69a51bbcf18ca9d269252741d25b6e"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1566299: Update XULListBoxAccessible now that autocomplete-richlistbox-popup is a Custom Element. r=surkov a=RyanVM\n\nIn bug 1525101, autocomplete-richlistbox-popup was converted to a Custom Element.\nThis means we can no longer use do_QueryInterface to get nsIAutoCompletePopup.\nInstead, we must use Element::AsAutoCompletePopup.\nThis fixes accessibility focus for these autocompletes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38158", "files": ["accessible/xul/XULListboxAccessible.cpp"], "git_node": null, "git_parents": [null], "node": "8e5f6cec66c6999f83d32282ad0c9b083d493220", "parents": ["2eccd9d294385e3e162dff24eea613542e0b8391"], "tags": []}, {"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1553938 - Ensure js-confdefs.h is installed and included. r=sfink a=RyanVM\n\njs-confdefs.h contains defines that affect the size and layout of public\nstructures, so it should always be included. It already brings in\njs/RequiredDefines.h itself, so that no longer needs to be explicitly\nincluded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35448", "files": ["js/src/build/Makefile.in", "js/src/build/js-config.in", "js/src/build/js.pc.in"], "git_node": null, "git_parents": [null], "node": "fc7915e1e6451f82a2eda7e223e0260f2110d02d", "parents": ["8e5f6cec66c6999f83d32282ad0c9b083d493220"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1560611 - remember valid buffers only. r=jya a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38129", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/CodecProxy.java"], "git_node": null, "git_parents": [null], "node": "7eeb3be3b8c17a6679fad10ace52342910992380", "parents": ["fc7915e1e6451f82a2eda7e223e0260f2110d02d"], "tags": []}, {"author": "Matthew Noorenberghe \u003cmozilla@noorenberghe.ca\u003e", "branch": "default", "desc": "Bug 1565780 - Await masterPasswordLogin before copying passwords. r=jaws a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38551", "files": ["toolkit/components/passwordmgr/content/passwordManager.js"], "git_node": null, "git_parents": [null], "node": "b2e7fa0e9828ef26862091cbdc73d543fa209f9b", "parents": ["7eeb3be3b8c17a6679fad10ace52342910992380"], "tags": []}], "date": 1563830593, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "98": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1542351: Allow 'edge' and non-gecko browser specific settings in the extensions schema manifest: Fix eslint failure. a=eslint-fix", "files": ["toolkit/mozapps/extensions/test/xpcshell/test_webextension_install.js"], "git_node": null, "git_parents": [null], "node": "1b4640c5477246faac0d589cdffd510b5474a6b4", "parents": ["b2e7fa0e9828ef26862091cbdc73d543fa209f9b"], "tags": ["FENNEC_68_1b3_BUILD1", "FENNEC_68_1b3_RELEASE"]}], "date": 1563832950, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "99": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 1b4640c5477246faac0d589cdffd510b5474a6b4 with FENNEC_68_1b3_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "47425b086f353e22f0fc3e532c188bffa0ea3209", "parents": ["1b4640c5477246faac0d589cdffd510b5474a6b4"], "tags": []}], "date": 1563836988, "git_changesets": [null], "user": "ffxbld"}}
}";