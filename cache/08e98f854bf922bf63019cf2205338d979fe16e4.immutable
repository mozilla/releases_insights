["toolkit/components/search/tests/xpcshell/searchconfigs/head_searchconfig.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_ebay.js"], "git_node": null, "git_parents": [null], "node": "97fdae6f2174e474133aa27ef6c0327703b5145f", "parents": ["fb30e8cccffff340f3a6ea98d816cd6440858416"], "tags": []}], "date": 1563185130, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "68": {"changesets": [{"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1565563 - Add en-US to search configurations to test. r=Standard8,mconnor,a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37869", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/head_searchconfig.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_ebay.js"], "git_node": null, "git_parents": [null], "node": "817060146e3080d845c9a4d102979211b7c39cb4", "parents": ["8313217eb89c18e58f1330b0c35b47a2d6eecd30"], "tags": []}], "date": 1563186846, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "69": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1564319 - Update mobile l10n-changesets.json from mozilla-beta. r=flod, a=release\n\nTaken from https://hg.mozilla.org/releases/mozilla-beta/rev/e5d98eda2ec3", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "1e3fb38efaad5654c81e07bb9646a4af4cd4464c", "parents": ["97fdae6f2174e474133aa27ef6c0327703b5145f"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38066", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "23ea2a779a60fd95636c7a7a97f9044614902edc", "parents": ["1e3fb38efaad5654c81e07bb9646a4af4cd4464c"], "tags": []}, {"author": "Mike Shal \u003cmshal@mozilla.com\u003e", "branch": "default", "desc": "Bug 1560755 - Merge Android PGO profile data in run task; r=chmanchester, a=RyanVM\n\nAndroid profile runs don't always fully write out the profile data. In\nthis case, the corrupted profile data is successfully uploaded, but\nfuture profile-use PGO builds try to merge the data and fail. Retrying\nthe profile-use builds doesn't help, since they all pull from the same\njob that published the corrupt data.\n\nWe can detect this in the run task by using llvm-profdata merge, and if\nthe merge fails the task can automatically be retried. Note that the\ndata gets redundantly merged in the profile-use build, but it may not be\npossible to run the merge in the run task on all platforms (eg: OSX), so\nwe have to keep the merge there as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36294", "files": ["taskcluster/ci/generate-profile/kind.yml", "testing/mozharness/scripts/android_emulator_pgo.py"], "git_node": null, "git_parents": [null], "node": "ca603ab27fe07f8086153b00f33958328f523e65", "parents": ["23ea2a779a60fd95636c7a7a97f9044614902edc"], "tags": []}, {"author": "Eugen Sawin \u003cesawin@me73.com\u003e", "branch": "default", "desc": "Bug 1561385 - [1.0] Change GeckoView cookie behavior default to block third-party trackers (ETP). r=snorp, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36980", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/ContentBlocking.java"], "git_node": null, "git_parents": [null], "node": "7f7f77e35e3ed610c16ef1a7fea576c8b7193161", "parents": ["ca603ab27fe07f8086153b00f33958328f523e65"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1561844 Remove OpenH264 plugin from about:addons r=VladBaicu a=RyanVM\n\nRemoved OpenH264 plugin from addons list for users that doesn't have it installed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37237", "files": ["mobile/android/chrome/content/browser.js"], "git_node": null, "git_parents": [null], "node": "b08cd190d83dadd249ff438c8c99fce1a7cc524f", "parents": ["7f7f77e35e3ed610c16ef1a7fea576c8b7193161"], "tags": []}, {"author": "Andrei Lazar \u003candrei.a.lazar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1554071 - Added support for Enhanced Tracking Protection. r=esawin, a=RyanVM, l10n=flod\n\nExposed \"Enabled, excluding tracking cookies\" Cookie behavior option.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35316", "files": ["mobile/android/app/src/main/res/values/arrays.xml", "mobile/android/base/locales/en-US/android_strings.dtd", "mobile/android/base/strings.xml.in"], "git_node": null, "git_parents": [null], "node": "a8da73ce90a4110e14caaba3e93d8a086b3a0669", "parents": ["b08cd190d83dadd249ff438c8c99fce1a7cc524f"], "tags": []}], "date": 1563213238, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "70": {"changesets": [{"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1565630 - Do searchfox C++/Rust indexing on ESR68. r=RyanVM, a=NPOTB\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38084", "files": [".cron.yml"], "git_node": null, "git_parents": [null], "node": "f2db2cf61f4f526fb948102c373f698d3dc574a0", "parents": ["a8da73ce90a4110e14caaba3e93d8a086b3a0669"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset ca603ab27fe0 (bug 1560755) for decision task bustage.", "files": ["taskcluster/ci/generate-profile/kind.yml", "testing/mozharness/scripts/android_emulator_pgo.py"], "git_node": null, "git_parents": [null], "node": "40092534f4aa397302a28dd73274f4ff23cebdf2", "parents": ["f2db2cf61f4f526fb948102c373f698d3dc574a0"], "tags": []}], "date": 1563213491, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "71": {"changesets": [{"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1561695 - Update GMP fallback downloader to Widevine 4.10.1440.18 and add aarch64. r=rhelmer a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36247", "files": ["toolkit/content/gmp-sources/widevinecdm.json"], "git_node": null, "git_parents": [null], "node": "6e464afe84cc2a0bc6a3759356e2f21d13d9d6cb", "parents": ["40092534f4aa397302a28dd73274f4ff23cebdf2"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1563759 - Add policy for new preference. r=baku a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37081", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": null, "git_parents": [null], "node": "d1ca3b23e1b21fcdb1e5b19b6c9abf3cd04f714e", "parents": ["6e464afe84cc2a0bc6a3759356e2f21d13d9d6cb"], "tags": []}, {"author": "Ehsan Akhgari \u003cehsan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1562837 - Ensure that the fields stored in the nsHttpConnectionInfo hash key are properly preserved when rebuilding it upon a change to the isolation flag; r=michal a=RyanVM a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37321", "files": ["netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.h"], "git_node": null, "git_parents": [null], "node": "e8a83ff321238fc59cf23b3e0cf12eaba67afeed", "parents": ["d1ca3b23e1b21fcdb1e5b19b6c9abf3cd04f714e"], "tags": []}, {"author": "Jan Henning \u003cjh+bugzilla@buttercookie.de\u003e", "branch": "default", "desc": "Bug 1563039 - Fix erroneous base domain highlighting. r=VladBaicu, a=RyanVM\n\nDomain highlighting needs to find the *last* instance of the base domain within\nthe domain part of the URL. Otherwise, there's a chance we mistakenly highlight\n(parts of) a subdomain if it matches the base domain, too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37311", "files": ["mobile/android/base/java/org/mozilla/gecko/toolbar/ToolbarDisplayLayout.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/StringUtils.java"], "git_node": null, "git_parents": [null], "node": "39abdfd19eae286bcd0e6b2d670a724d8a29e6a3", "parents": ["e8a83ff321238fc59cf23b3e0cf12eaba67afeed"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1561484 - Keep MediaInfo object for entire benchmark. r=alwu a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36566", "files": ["dom/media/Benchmark.cpp", "dom/media/Benchmark.h"], "git_node": null, "git_parents": [null], "node": "c9a3832408f8bdf6618f5b562f4f72a96d275ac7", "parents": ["39abdfd19eae286bcd0e6b2d670a724d8a29e6a3"], "tags": []}, {"author": "Oriol Brufau \u003coriol-bugzilla@hotmail.com\u003e", "branch": "default", "desc": "Bug 1558823 - Show generic icon for extensions without icon. r=mstriemer,mixedpuppy a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36730", "files": ["toolkit/mozapps/extensions/content/aboutaddons.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view.js"], "git_node": null, "git_parents": [null], "node": "76ab1f5362b50df63d3918f7ce6e7c5a3de1c65d", "parents": ["c9a3832408f8bdf6618f5b562f4f72a96d275ac7"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1565315 - Fix Yandex missing from en builds when in Russian regions. r=mconnor,daleharvey a=RyanVM a=jcristau\n\nDepends on D37869\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37872", "files": ["browser/components/search/extensions/list.json", "toolkit/components/search/tests/xpcshell/searchconfigs/test_ebay.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_google.js", "toolkit/components/search/tests/xpcshell/searchconfigs/test_yandex.js"], "git_node": null, "git_parents": [null], "node": "562535d4195e157f934ec4423091593ab57ae37e", "parents": ["76ab1f5362b50df63d3918f7ce6e7c5a3de1c65d"], "tags": []}, {"author": "Florens Verschelde \u003cflorens@fvsch.com\u003e", "branch": "default", "desc": "Bug 1564267 - Fix console line-height for large text; r=nchevobbe a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37367", "files": ["devtools/client/themes/webconsole.css"], "git_node": null, "git_parents": [null], "node": "b4d4b2c7e36946690af1b59668cc2534c36b2f0d", "parents": ["562535d4195e157f934ec4423091593ab57ae37e"], "tags": ["FENNEC_68_1b2_BUILD1", "FENNEC_68_1b2_RELEASE"]}], "date": 1563224353, "git_changesets": [null, null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "72": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1563759 - Add policy for new preference. r=baku a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37081", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": null, "git_parents": [null], "node": "1cf405179c737c2404a730f879e06c4fe93e349f", "parents": ["817060146e3080d845c9a4d102979211b7c39cb4"], "tags": []}, {"author": "Ehsan Akhgari \u003cehsan@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1562837 - Ensure that the fields stored in the nsHttpConnectionInfo hash key are properly preserved when rebuilding it upon a change to the isolation flag; r=michal a=RyanVM a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37321", "files": ["netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/