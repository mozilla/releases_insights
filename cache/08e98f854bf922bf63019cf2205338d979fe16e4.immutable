.json"], "git_node": null, "git_parents": [null], "node": "bb7f7a13fa9b6048642ac027a3c786479dcdc288", "parents": ["646596777a4d7e9d75d4f0347b360949863118b7"], "tags": []}], "date": 1564401639, "git_changesets": [null], "user": "ffxbld"}, "118": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39675", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "156eb0ad9327b953ebdfb986afeca85dc36cea04", "parents": ["bb7f7a13fa9b6048642ac027a3c786479dcdc288"], "tags": []}, {"author": "Matthew Noorenberghe \u003cmozilla@noorenberghe.ca\u003e", "branch": "default", "desc": "Bug 1569414 - Don't hardcode a too old history visit date in test_Chrome_history.js. r=mak, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39606", "files": ["browser/components/migration/tests/unit/test_Chrome_history.js"], "git_node": null, "git_parents": [null], "node": "35e9afa928937a4dea581a93b993b1a5fd1738e7", "parents": ["156eb0ad9327b953ebdfb986afeca85dc36cea04"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1568858 - always stretch box shadows except for Cairo. r=jrmuizel, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D39412", "files": ["gfx/thebes/gfxBlur.cpp", "layout/reftests/box-shadow/reftest.list"], "git_node": null, "git_parents": [null], "node": "248a7f84947862d943a11ac01b2c127a2e1f1c3f", "parents": ["35e9afa928937a4dea581a93b993b1a5fd1738e7"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1556235 - Make `HTMLEditRules::WillDeleteSelection()` remove empty parent blocks when it's called by drop handler. r=m_kato, a=RyanVM\n\nChromium removes new empty blocks only when the content is removed by dragging.\nBefore bug 1504910, we just removed the dragged range, i.e., kept the new\nempty blocks.  However, now, we put `\u003cbr\u003e` element from\n`HTMLEditRules::AfterEditInner()` because a D&D action was split to the deletion\npart and inserting part (It wasn't called after inserting the dropped content).\n\nTherefore, this patch adds new path for D&D into\n`HTMLEditRules::WillDeleteSelection()`.  If parent blocks become empty,\nthe path removes such blocks and collapse `Selection` to where the most\nancestor empty block was.  With this patch, we get same behavior as Chrome\nin most cases.  You can check it in https://jsfiddle.net/d_toybox/9px07yLr/\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34147", "files": ["editor/libeditor/EditorBase.h", "editor/libeditor/HTMLEditRules.cpp", "editor/libeditor/HTMLEditRules.h", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/WSRunObject.cpp", "editor/libeditor/WSRunObject.h"], "git_node": null, "git_parents": [null], "node": "4fb90cfe26e72312d1addf4bb1ddbc7dfd2c036f", "parents": ["248a7f84947862d943a11ac01b2c127a2e1f1c3f"], "tags": []}], "date": 1564411442, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "119": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nbg -\u003e 8c4bf00aefde\nbr -\u003e a5c231c54d33\ncy -\u003e e707581fff58\nen-CA -\u003e f0164167a72d\nes-AR -\u003e 17f3638af8cf\nfr -\u003e d50b41557849\ngn -\u003e 9b3e1209822e\nit -\u003e d76bf2420924\nnl -\u003e 0e9304c10bcd\npt-PT -\u003e 2a8983b0fa7a\nsl -\u003e 2c9c5f2f25a1\nsv-SE -\u003e 40244cdb8224\nth -\u003e 4937e4074862\ntrs -\u003e 21aef184791f\nuk -\u003e 13e4593384b8\nzh-CN -\u003e 2c9d1112f337\nzh-TW -\u003e 6025be92430d", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "0cafa2449b381139e525cdde746a4ed5de713585", "parents": ["4fb90cfe26e72312d1addf4bb1ddbc7dfd2c036f"], "tags": []}], "date": 1564423242, "git_changesets": [null], "user": "ffxbld"}, "120": {"changesets": [{"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "Bug 1557635 - Update the Sync Onboarding screen; r=VladBaicu, a=RyanVM\n\nWith this changes we must now support 3 Onboarding versions.\n\nWith this changes we must now support 3 Onboarding versions.\n\nLatest Onboarding UX will use a new title for the \"Sync screen\", new subtext,\nnew image and new text for the signin button.\nThis will be presented only if all this new Strings are localized.\n\nRefactored the existing OnboardingStringUtil to serve as a central point of\ngetting the right resources to be used and querying the Onboarding UX version\nthe app should offer.\n\nAdded to SyncPanel the missing logic to hide the space otherwise occupied by\nthe Onboarding screen message, when there is no message.\n(now behaving the same as the other Onboarding screens.)\n\nApplied a lossless compression for the new sync image which resulted in a 26.5%\nsize reduction.\n\nRemoved the lint suppression initially necessary for when first added the\nupdated Sync Strings which were not used at the moment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35012", "files": ["mobile/android/app/lint.xml", "mobile/android/app/src/main/res/drawable-nodpi/firstrun_account.png", "mobile/android/base/java/org/mozilla/gecko/firstrun/FirstrunPagerConfig.java", "mobile/android/base/java/org/mozilla/gecko/firstrun/LocalFirstRunPanelProvider.java", "mobile/android/base/java/org/mozilla/gecko/firstrun/SyncPanel.java", "mobile/android/base/java/org/mozilla/gecko/mma/LeanplumVariables.java", "mobile/android/base/java/org/mozilla/gecko/util/OnboardingResources.java", "mobile/android/base/java/org/mozilla/gecko/util/OnboardingStringUtil.java", "mobile/android/base/locales/en-US/android_strings.dtd", "mobile/android/base/strings.xml.in"], "git_node": null, "git_parents": [null], "node": "873471c5d85082ac97907ed830622f2721c89104", "parents": ["f5920839f310aa6e2d4b04c0a9877f67f14b00da"], "tags": []}, {"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "FIREFOX_ESR_68_0_X_RELBRANCH", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "8415f0985b73460359d50f6cc6d766150f82ee92", "parents": ["873471c5d85082ac97907ed830622f2721c89104"], "tags": []}], "date": 1564424593, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "121": {"changesets": [{"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1559512: Make sure that we grab the first RTP packet when checking RTP extensions, because the mid extension is only used in the first several. r=jib, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37884", "files": ["dom/media/tests/mochitest/test_peerConnection_basicAudioVerifyRtpHeaderExtensions.html", "dom/media/tests/mochitest/test_peerConnection_basicVideoVerifyRtpHeaderExtensions.html"], "git_node": null, "git_parents": [null], "node": "b90adc03bb672539332196d8c756ec73cbb2d8b0", "parents": ["0cafa2449b381139e525cdde746a4ed5de713585"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1559627 - More reliably detect position changes during reframe. r=rhunt, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D35157", "files": ["layout/base/RestyleManager.cpp", "layout/base/RestyleManager.h", "testing/web-platform/tests/css/css-scroll-anchoring/position-change-heuristic-ib-split.html"], "git_node": null, "git_parents": [null], "node": "f75ccfeab9e9110515508f6f61992706eb9700ee", "parents": ["b90adc03bb672539332196d8c756ec73cbb2d8b0"], "tags": []}, {"author": "dlee \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1553951 - Safe Browsing doesn't call the lookup callback when an error occurs in DoLocalLookup. r=baku, a=RyanVM\n\nFirefox cannot open any URL when Safe Browsing database is corrupted.\nThis is because when Necko asks URL Classifier to classify an URL, it\nfirst suspends the channel, and then wait for a callback to see if the\nchannel should be canceled or resumed.\n\nIn this bug, DoLocalLookup returns an error because Safe Browsing is not\nable to read its database(database is corrupted), but we don't call the\ncallback to resume loading channel, so users cannot load any website.\n\nThis patch adds a scope exit handler to make sure the callback will\nalways be invoked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36456", "files": ["toolkit/components/url-classifier/nsUrlClassifierDBService.cpp"], "git_node": null, "git_parents": [null], "node": "210e075a91c32f22ed75aa38a5fc176e28ab026d", "parents": ["f75ccfeab9e9110515508f6f61992706eb9700ee"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1560736 - MakeCurrent after GeckoSurfaceTexture::DestroyUnused. r=snorp, a=RyanVM\n\nSeems like GeckoSurfaceTexture::DestroyUnused can change the current\ncontext.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36685", "files": ["gfx/layers/opengl/CompositorOGL.cpp", "gfx/webrender_bindings/RenderCompositorEGL.cpp"], "git_node": null, "git_parents": [null], "node": "c2e0e8fc880c8016c74ed80b9a23f92bf1184a39", "parents": ["210e075a91c32f22ed75aa38a5fc176e28ab026d"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1563914 - Fix ConsoleTable with invalid headers. r=Honza, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D37164", "files": ["devtools/client/webconsole/components/ConsoleTable.js", "devtools/client/webconsole/test/mochitest/browser_webconsole_console_table.js"], "git_node": null, "git_parents": [null], "node": "6278b28dfcf0118e24d79ae8dd773f7b42b9e993", "parents": ["c2e0e8fc880c8016c74ed80b9a23f92bf1184a39"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1543599 - Don't suppress scroll anchoring adjustments when switching display to `none`. r=rhunt,dholbert, a=RyanVM\n\n\nSince that means that we won't suppress them when switching display back (since\nwe have no frame to pull the old style from).\n\nWe may want to match Chrome more exactly and don't do this any time `display`\nchanges (which if I'm reading their code correctly is what they do...).\n\nBut for now I've done the minimal thing and added a test.\n\nDifferential Revision: https://phabricator.services.mozilla.com//D38094", "files": ["layout/base/RestyleManager.cpp", "testing/web-platform/tests/css/css-scroll-anchoring/position-change-heuristic-display-none-change.html"], "git_node": null, "git_parents": [null], "node": "e1afa5554ec8707aff43807562185e637869ffa5", "parents": ["6278b28dfcf0118e24d79ae8dd773f7b42b9e993"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1309358 - P1: Add wildcard to Access-Control-Expose-Headers. r=baku, a=RyanVM\n\nFor requests without credentials, add wildcard to Access-Control-Expose-Headers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36624", "files": ["dom/fetch/FetchDriver.cpp", "dom/fetch/InternalHeaders.cpp", "dom/fetch/InternalHeaders.h", "dom/fetch/InternalResponse.cpp", "dom/fetch/InternalResponse.h", "dom/xhr/XMLHttpRequestMainThread.cpp", "testing/web-platform/meta/fetch/api/cors/cors-expose-star.sub.any.js.ini"], "git_node": null, "git_parents": [null], "node": "4ed9a5ede7fb9dc2c4711b05a87b54fd760770fd", "parents": ["e1afa5554ec8707aff43807562185e637869ffa5"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1309358 - P2: Add wildcard to Access-Control-Allow-Method and Access-Control-Allow-Headers. r=baku,mayhemer, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D36990", "files": ["netwerk/protocol/http/nsCORSListenerProxy.cpp", "testing/web-platform/meta/fetch/api/cors/cors-preflight-star.any.js.ini", "testing/web-platform/meta/service-workers/cache-storage/serviceworker/cache-match.https.html.ini", "testing/web-platform/meta/service-workers/cache-storage/window/cache-match.https.html.ini", "testing/web-platform/meta/service-workers/cache-storage/worker/cache-match.https.html.ini", "testing/web-platform/meta/service-workers/service-worker/fetch-cors-exposed-header-names.https.html.ini"], "git_node": null, "git_parents": [null], "node": "fc78fbb5899b0a5987571c5c0cde3cb2673deac0", "parents": ["4ed9a5ede7fb9dc2c4711b05a87b54fd760770fd"], "tags": []}, {"author": "M. Sirringhaus \u003cmsirringhaus@suse.de\u003e", "branch": "default", "desc": "Bug 1564900 - [OS.File] Fix size of statvfs::f_frsize. r=Yoric, a=RyanVM\n\nMake Firefox not assume type of member statvfs::f_frsize from sys head, which may vary\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38306", "files": ["dom/system/OSFileConstants.cpp", "toolkit/components/osfile/modules/osfile_unix_back.jsm"], "git_node": null, "git_parents": [null], "node": "ba3fb8da261bfa3fc1e99d8b78d5b1a169a32bef", "parents": ["fc78fbb5899b0a5987571c5c0cde3cb2673deac0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1566783 - Don't prevent PresShell::ScrollToAnchor() from working due to scroll anchoring adjustments that happen without the user scrolling. r=dholbert, a=RyanVM\n\nWe were bailing out because scroll anchoring adjustments can make this check\nfail:\n\n  * https://searchfox.org/mozilla-central/rev/22b330ecb3edba1536a54887060cbdd09db21c59/layout/base/PresShell.cpp#3194\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38397", "files": ["layout/base/PresShell.h", "layout/generic/ScrollAnchorContainer.cpp", "layout/generic/test/file_SlowTallImage.sjs", "layout/generic/test/file_bug1566783.html", "layout/generic/test/mochitest.ini", "layout/generic/test/test_bug1566783.html"], "git_node": null, "git_parents": [null], "node": "857d13bed3398ba84f195da9b1f04c10f6f8cdbe", "parents": ["ba3fb8da261bfa3fc1e99d8b78d5b1a169a32bef"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1566783 - Make sure to clear mLastAnchorScrolledTo after calling PresShell::ScrollToAnchor(). r=dholbert, a=RyanVM\n\nSeems we can leave this node alive for too long if the user scrolls between\ndomcontentloaded (where GoToAnchor is called) and onload (where ScrollToAnchor()\nis called).\n\nThough it seems we can leave it for too long if we don't end up calling\nScrollToAnchor(), the documentation of the method claims that it's cleared\nunconditionally.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38398", "files": ["layout/base/PresShell.cpp"], "git_node": null, "git_parents": [null], "node": "08cc16b3235116becf68036fb71b97c830c3c9d6", "parents": ["857d13bed3398ba84f195da9b1f04c10f6f8cdbe"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1547017 - Hide the more options button when there are no items. r=mixedpuppy, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D38926", "files": ["toolkit/mozapps/extensions/content/aboutaddons.js", "toolkit/mozapps/extensions/test/browser/browser_html_detail_view.js"], "git_node": null, "git_parents": [null], "node": "733c6