2b925d089b4588eae64ff"], "node": "7a8b8340f99a73bebc2f87444b2347b8e5e42ec9", "parents": ["2d32ca12eedfc31413860a1687f26ae76e38296b"], "tags": []}], "date": 1786746430, "git_changesets": ["e4079e8047f801812e6b16d6cd1cde58161919fc"], "user": "rvandermeulen@mozilla.com"}, "292": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2042751 - Make `maybe_gather_combining()` in the collator fetch the CCC for non-starters in `upcoming`.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318082\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318665\n", "files": ["js/src/tests/non262/Intl/Collator/ccc.js", "third_party/rust/icu_collator/src/elements.rs"], "git_node": "e290d0d04dbc077218b98e41a20211e1de1fe290", "git_parents": ["e4079e8047f801812e6b16d6cd1cde58161919fc"], "node": "2f5b5da035865a6415466062fbd9946eba68bbc0", "parents": ["7a8b8340f99a73bebc2f87444b2347b8e5e42ec9"], "tags": []}], "date": 1786746453, "git_changesets": ["e290d0d04dbc077218b98e41a20211e1de1fe290"], "user": "rvandermeulen@mozilla.com"}, "293": {"changesets": [{"author": "Marcin Kozi\u0144ski \u003cmkozinski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059021 - Ensure duplicated handles are always owned by the crash helper  a=RyanVM\n\nThis moves the task of duplicating handles that need to be passed to the\ncrash helper from a push model to a pull model, it has a few benefits:\n- Received handles are guaranteed to be valid (or duplication will fail)\n- We don't need to wait for the crash helper process to start on Windows\n  before we're able to register child processes with it. This might\n  speedup first process startup.\n- We deliberately avoid duplicating pseudo-handles as we don't want\n  those to be duplicated across processes since they might cause some\n  nasty surprises.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317540\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318680\n", "files": ["toolkit/crashreporter/crash_helper_client/src/lib.rs", "toolkit/crashreporter/crash_helper_client/src/platform/android.rs", "toolkit/crashreporter/crash_helper_client/src/platform/unix.rs", "toolkit/crashreporter/crash_helper_client/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_common/build.rs", "toolkit/crashreporter/crash_helper_common/src/breakpad/windows_strings.rs", "toolkit/crashreporter/crash_helper_common/src/ipc_connector/windows.rs", "toolkit/crashreporter/crash_helper_common/src/platform/windows.rs", "toolkit/crashreporter/crash_helper_server/src/ipc_server.rs"], "git_node": "b5f74b36f795059de285d2498f27857bce25f848", "git_parents": ["e290d0d04dbc077218b98e41a20211e1de1fe290"], "node": "a844ae2ffbf97c7f844eff301b5802af455354f5", "parents": ["2f5b5da035865a6415466062fbd9946eba68bbc0"], "tags": []}], "date": 1786746476, "git_changesets": ["b5f74b36f795059de285d2498f27857bce25f848"], "user": "rvandermeulen@mozilla.com"}, "294": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048793 - Fix bustage. a=me\n", "files": ["docshell/base/nsDocShellLoadState.cpp"], "git_node": "5c7f87f58aa1bf08869fc35afcd624c05be7cb08", "git_parents": ["b5f74b36f795059de285d2498f27857bce25f848"], "node": "1a8402afb04afee5366a9a72f9409505e28dff90", "parents": ["a844ae2ffbf97c7f844eff301b5802af455354f5"], "tags": []}], "date": 1786749265, "git_changesets": ["5c7f87f58aa1bf08869fc35afcd624c05be7cb08"], "user": "rvandermeulen@mozilla.com"}, "295": {"changesets": [{"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2058085 - Pick about:pdf files in the parent process.  a=RyanVM\n\nMove the file picker and PDF validation to AboutPDFParent so content never supplies a local path. Leave dropped PDFs to native drop handling.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318472\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318882\n", "files": ["toolkit/actors/AboutPDFChild.sys.mjs", "toolkit/actors/AboutPDFParent.sys.mjs", "toolkit/components/aboutpdf/content/aboutPDF.html", "toolkit/components/aboutpdf/content/aboutPDF.mjs", "toolkit/components/aboutpdf/tests/browser/browser_aboutPDF.js", "toolkit/components/aboutpdf/tests/browser/browser_aboutPDF_actor.js", "toolkit/components/aboutpdf/tests/browser/head.js", "toolkit/locales/en-US/toolkit/about/aboutPDF.ftl", "toolkit/modules/RemotePageAccessManager.sys.mjs"], "git_node": "619ff055e8c458dce694d7c90c51e0fd8fc4f83f", "git_parents": ["5c7f87f58aa1bf08869fc35afcd624c05be7cb08"], "node": "6dd09fa4cdebb9abb605b0b7bbe4651391cca589", "parents": ["1a8402afb04afee5366a9a72f9409505e28dff90"], "tags": []}], "date": 1786824212, "git_changesets": ["619ff055e8c458dce694d7c90c51e0fd8fc4f83f"], "user": "rvandermeulen@mozilla.com"}, "296": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054631 - Modernize principal IPC in WebBrowserPersist.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315147\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318864\n", "files": ["dom/webbrowserpersist/PWebBrowserPersistDocument.ipdl", "dom/webbrowserpersist/WebBrowserPersistDocumentChild.cpp", "dom/webbrowserpersist/WebBrowserPersistDocumentParent.cpp", "dom/webbrowserpersist/WebBrowserPersistDocumentParent.h", "dom/webbrowserpersist/WebBrowserPersistRemoteDocument.cpp", "dom/webbrowserpersist/WebBrowserPersistRemoteDocument.h"], "git_node": "873887074a9c98a963fdbadae48988eb799886e6", "git_parents": ["619ff055e8c458dce694d7c90c51e0fd8fc4f83f"], "node": "9234d6dbedb15bb773a5508d7e843f5bbecff055", "parents": ["6dd09fa4cdebb9abb605b0b7bbe4651391cca589"], "tags": []}], "date": 1786831351, "git_changesets": ["873887074a9c98a963fdbadae48988eb799886e6"], "user": "rvandermeulen@mozilla.com"}, "297": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2054691 - Validate cross-process paint dependencies.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314723\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318941\n", "files": ["gfx/ipc/CrossProcessPaint.cpp", "gfx/ipc/CrossProcessPaint.h", "layout/printing/ipc/RemotePrintJobParent.cpp", "layout/printing/ipc/RemotePrintJobParent.h"], "git_node": "ef1b657051c5151e6fafcd3b1860e7f79bf973e2", "git_parents": ["873887074a9c98a963fdbadae48988eb799886e6"], "node": "c1902d89bc0d0fde6b2105eb95794656365d6584", "parents": ["9234d6dbedb15bb773a5508d7e843f5bbecff055"], "tags": []}], "date": 1786911993, "git_changesets": ["ef1b657051c5151e6fafcd3b1860e7f79bf973e2"], "user": "rvandermeulen@mozilla.com"}, "298": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update HSTS HPKP -  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318828\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "5ced3b22fe56e13b5d6d2ac04474f351d875b864", "git_parents": ["ef1b657051c5151e6fafcd3b1860e7f79bf973e2"], "node": "71da0a28fba041f4a058ac03167fa8b21a2fc3ef", "parents": ["c1902d89bc0d0fde6b2105eb95794656365d6584"], "tags": []}], "date": 1786912015, "git_changesets": ["5ced3b22fe56e13b5d6d2ac04474f351d875b864"], "user": "rvandermeulen@mozilla.com"}, "299": {"changesets": [{"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044882 - Recover resources based on encryption state.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318196\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318967\n", "files": ["browser/components/backup/BackupService.sys.mjs", "browser/components/backup/tests/xpcshell/test_BackupService_recoverFromSnapshotFolder.js"], "git_node": "bfac4bc7eb2ba0484c57844b74cff1b8740e28ad", "git_parents": ["5ced3b22fe56e13b5d6d2ac04474f351d875b864"], "node": "61838def96241257c194ac416b72ce23989840d1", "parents": ["71da0a28fba041f4a058ac03167fa8b21a2fc3ef"], "tags": []}], "date": 1786924379, "git_changesets": ["bfac4bc7eb2ba0484c57844b74cff1b8740e28ad"], "user": "rvandermeulen@mozilla.com"}, "300": {"changesets": [{"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2049320 - Cancel underlay when mix blend intersects with the underlay  a=RyanVM\n\nThe problem happened when underlay intersects with mix-blend-mode.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308253\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318969\n", "files": ["gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "1d31266b5f99cdd092a614ad570fcceb78310b64", "git_parents": ["bfac4bc7eb2ba0484c57844b74cff1b8740e28ad"], "node": "d89e00c88b725a56c65009aaf03035da737340ca", "parents": ["61838def96241257c194ac416b72ce23989840d1"], "tags": []}], "date": 1786924399, "git_changesets": ["1d31266b5f99cdd092a614ad570fcceb78310b64"], "user": "rvandermeulen@mozilla.com"}, "301": {"changesets": [{"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045266 - Prevent overlapping Settings searches from leaving stale highlight results  a=RyanVM DONTBUILD\n\nUnder the settings redesign, starting a new search before the previous\none finished produced inconsistent highlight results on Windows and\nLinux. searchFunction awaits at several points, so a stale call could\nresume after a newer search and re-add find-selection ranges, tooltips,\nand menuitem indicators. The code checked for this at only two of those\npoints, using a narrow `query !== this.query` comparison.\n\nA stale call must not mutate shared state after a newer search starts.\nEach search aborts the previous one on entry, then after each await\nchecks whether a newer search has aborted it. When a stale call resumes\nand sees the abort, it returns early. The subQuery fast path checks a\nnew searchCompleted flag. After an unfinished search, `.visually-hidden`\nmay be partly applied, so the next search runs in full instead of\nincrementally. The awaits in `searchWithinNode` need the same fix, left\nfor a follow-up.\n\nTwo SRD-only regression tests cover this by asserting the SELECTION_FIND\nrange count does not inflate when searches overlap. One drives the\noverlap directly through searchFunction. The other reproduces it through\nthe real search input, matching the reported interaction.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309716\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319199\n", "files": ["browser/components/preferences/findInPage.js", "browser/components/preferences/tests/searchResults/browser-srd.toml", "browser/components/preferences/tests/searchResults/browser_search_category_filter.js", "browser/components/preferences/tests/searchResults/browser_search_overlapping_ranges.js"], "git_node": "166e2fde02254e843e4f1e413b7d6f067b6f6ab7", "git_parents": ["1d31266b5f99cdd092a614ad570fcceb78310b64"], "node": "290fc345ae025c6467c2cc7ab8d3526ef3d51869", "parents": ["d89e00c88b725a56c65009aaf03035da737340ca"], "tags": []}], "date": 1786998068, "git_changesets": ["166e2fde02254e843e4f1e413b7d6f067b6f6ab7"], "user": "rvandermeulen@mozilla.com"}, "302": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2052162 - Fix nsTableFrame overflow handling.  a=RyanVM DONTBUILD\n\nOnly rowgroups should be considered. Also, there's a separate issue\nwhere the Reflow() loop might've pushed some of the frames in mRowGroups\nto the next continuation, but we'd still consider overflow for them.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312725\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319055\n", "files": ["layout/base/nsLayoutUtils.h", "layout/tables/nsTableFrame.cpp", "layout/tables/nsTableFrame.h", "testing/web-platform/meta/css/printing/table-in-flex-overflow-print.html.ini", "testing/web-platform/tests/css/printing/table-in-flex-overflow-print-ref.html", "testing/web-platform/tests/css/printing/table-in-flex-overflow-print.html"], "git_node": "b56354b2b543dcd0402730c525bb3b554355a775", "git_parents": ["166e2fde02254e843e4f1e413b7d6f067b6f6ab7"], "node": "45d69f7e1306c4dbcc110e894c9a6d37af93b95b", "parents": ["290fc345ae025c6467c2cc7ab8d3526ef3d51869"], "tags": []}], "date": 1786998092, "git_changesets": ["b56354b2b543dcd0402730c525bb3b554355a775"], "user": "rvandermeulen@mozilla.com"}, "303": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2055887 - Make pref.general.disable_button.default_browser work again.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312763\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319149\n", "files": ["browser/components/preferences/main.js"], "git_node": "21761d211915d9a25c19602d50d7175f1cbe5ef5", "git_parents": ["b56354b2b543dcd0402730c525bb3b554355a775"], "node": "8a62c8c52e6bbdc027d63ee88bebb8f82ea983c7", "parents": ["45d69f7e1306c4dbcc110e894c9a6d37af93b95b"], "tags": []}], "date": 1786998116, "git_changesets": ["21761d211915d9a25c19602d50d7175f1cbe5ef5"], "user": "rvandermeulen@mozilla.com"}, "304": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2056928 - Make legacy disabling pref work with new settings.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313517\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319152\n", "files": ["browser/components/enterprisepolicies/tests/browser/browser.t