uthor": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2059018 - Explicitly record serializable support in components.conf,  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315738\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320517\n", "files": ["image/decoders/icon/components.conf", "layout/build/components.conf", "modules/libjar/components.conf", "netwerk/build/components.conf", "security/manager/ssl/components.conf", "xpcom/components/StaticComponents.h", "xpcom/components/gen_static_components.py", "xpcom/io/moz.build", "xpcom/io/nsBinaryStream.cpp"], "git_node": "14a6daa418214823591510b093b9d1b741d136bd", "git_parents": ["62a476a497933907031dd98007c00b47cb183743"], "node": "f0aec46930aea0fc1eab889fc907d9c679c4a494", "parents": ["584af857c408e5b13de41cecff3cc822aee4a0c2"], "tags": []}], "date": 1787413207, "git_changesets": ["14a6daa418214823591510b093b9d1b741d136bd"], "user": "rvandermeulen@mozilla.com"}, "382": {"changesets": [{"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 1994400 - Fix shortcut panel hiding during IME composition  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D285552\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320471\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/tests/browser/browser_chat_shortcuts.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "767631289e30f4a8ba9a66439e36bd813826fda0", "git_parents": ["14a6daa418214823591510b093b9d1b741d136bd"], "node": "75f49123fbbb6fc9e4fc4a75567a837f916a3638", "parents": ["f0aec46930aea0fc1eab889fc907d9c679c4a494"], "tags": []}], "date": 1787413229, "git_changesets": ["767631289e30f4a8ba9a66439e36bd813826fda0"], "user": "rvandermeulen@mozilla.com"}, "383": {"changesets": [{"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060047.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320521\n", "files": ["gfx/ipc/CanvasManagerParent.cpp"], "git_node": "8a0e4b0640e53b703e3384a7637b76e40c0e03d8", "git_parents": ["767631289e30f4a8ba9a66439e36bd813826fda0"], "node": "4d8cccb6d9a4e57731d8cbff32e53952960aab02", "parents": ["75f49123fbbb6fc9e4fc4a75567a837f916a3638"], "tags": []}], "date": 1787413252, "git_changesets": ["8a0e4b0640e53b703e3384a7637b76e40c0e03d8"], "user": "rvandermeulen@mozilla.com"}, "384": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061287 - Improve MFMediaEngineParent lifetime handling  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318611\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320621\n", "files": ["dom/media/ipc/MFMediaEngineParent.cpp", "dom/media/ipc/MFMediaEngineParent.h"], "git_node": "81a78e3c2c77d190027d7ea92fd8aa9de9e94eff", "git_parents": ["8a0e4b0640e53b703e3384a7637b76e40c0e03d8"], "node": "f633fb15d02e74229f9d8a9d36252baadf6af451", "parents": ["4d8cccb6d9a4e57731d8cbff32e53952960aab02"], "tags": []}], "date": 1787413274, "git_changesets": ["81a78e3c2c77d190027d7ea92fd8aa9de9e94eff"], "user": "rvandermeulen@mozilla.com"}, "385": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054645 - Restrict DMABuf import to hardware GL rendering.  a=RyanVM\n\nDMABuf surfaces are only used with hardware GL rendering. Do not import\na DMABuf surface into a GL texture when software rendering is in use.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313682\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320662\n", "files": ["widget/gtk/DMABufSurface.cpp"], "git_node": "87f6b2cad8f3a7f4f1f782a1b90bba637e623ff3", "git_parents": ["81a78e3c2c77d190027d7ea92fd8aa9de9e94eff"], "node": "133588e32378cf404efbbf7470704862334ffe10", "parents": ["f633fb15d02e74229f9d8a9d36252baadf6af451"], "tags": []}], "date": 1787413297, "git_changesets": ["87f6b2cad8f3a7f4f1f782a1b90bba637e623ff3"], "user": "rvandermeulen@mozilla.com"}, "386": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2044535 - Relax the keyframe-count check for real-time 4K batch encoding. a=test-only\n\nIn real-time usage the encoder may drop frames for large frame sizes. Submitting\na whole batch of frames at once can make it drop the frame that requested a\nkeyframe, so the output legitimately contains fewer keyframes than were\nrequested. Dropping frames in real-time mode is permitted by the WebCodecs\nspecification and matches other browsers, so requiring every requested keyframe\nto survive is not a valid expectation on this path.\n\nThe output-length check already tolerated dropped frames for real-time 4K, but\nthe neighbouring keyframe-count check did not. Relax the keyframe-count check the\nsame way in the batch test, requiring only that some output was produced and that\nthe stream still starts with a keyframe. The single-frame tests submit with\nenough slack that the requested-keyframe frame is not dropped, so they keep the\nstrict check.\n\nThis fixes the permafailing MediaDataEncoderTest.H264EncodeBatch4KAnnexBRealtime\nand H264EncodeBatch4KAVCCRealtime gtests on macosx1500-aarch64-shippable/opt.\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp"], "git_node": "63bf0bd8a18c7eb05b231545d35688d6865d1e4a", "git_parents": ["87f6b2cad8f3a7f4f1f782a1b90bba637e623ff3"], "node": "c314920d293a602b3f4986e00f95a9ea9779eec7", "parents": ["133588e32378cf404efbbf7470704862334ffe10"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2044535 - Share the encode-output validation across the H.264 encode tests. a=test-only\n\nThe single-frame and batch H.264 encode tests duplicated the entire post-encode\nvalidation. Keeping the two copies in sync is what let this bug happen: the\nreal-time 4K carve-out was applied to the frame-count check but not to the\nneighbouring keyframe-count check, in either copy.\n\nMove the shared validation into one helper so the expectations live in a single\nplace and a carve-out cannot be applied to one copy only. The batch caller\ntolerates a dropped keyframe on the real-time 4K path; the single-frame caller\nkeeps the strict check. No behaviour change, and the helper also guards its\noutput accesses against an empty result.\n", "files": ["dom/media/gtest/TestMediaDataEncoder.cpp"], "git_node": "d7f9a16450e67d37ddfce4eae76136ea89d4a5b3", "git_parents": ["63bf0bd8a18c7eb05b231545d35688d6865d1e4a"], "node": "ec3f2b3b87f9dc9b8a1e8e7c462eeea4d5cf1cbc", "parents": ["c314920d293a602b3f4986e00f95a9ea9779eec7"], "tags": []}, {"author": "Benjamin Peterson \u003cbenjamin@python.org\u003e", "branch": "default", "desc": "Bug 2064482 - Remove empty browser_ipprotection_usage.js. a=test-only\n", "files": ["browser/components/ipprotection/tests/browser/browser_ipprotection_usage.js"], "git_node": "a49d64b6dc2c0a39437c82d2f46ddf97be5d2c4f", "git_parents": ["d7f9a16450e67d37ddfce4eae76136ea89d4a5b3"], "node": "7dd8e75210e7c41ca0150d035c38ac466bba68f1", "parents": ["ec3f2b3b87f9dc9b8a1e8e7c462eeea4d5cf1cbc"], "tags": []}, {"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 1811277 - Clean up settings action telemetry test a=test-only\n", "files": ["browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_selected_result.js"], "git_node": "43875bc3256db652dbb33b187363eb774644b90a", "git_parents": ["a49d64b6dc2c0a39437c82d2f46ddf97be5d2c4f"], "node": "26972f082ebc754aa2c3a858bf4b84f325fc7bb2", "parents": ["7dd8e75210e7c41ca0150d035c38ac466bba68f1"], "tags": []}], "date": 1787417129, "git_changesets": ["63bf0bd8a18c7eb05b231545d35688d6865d1e4a", "d7f9a16450e67d37ddfce4eae76136ea89d4a5b3", "a49d64b6dc2c0a39437c82d2f46ddf97be5d2c4f", "43875bc3256db652dbb33b187363eb774644b90a"], "user": "rvandermeulen@mozilla.com"}, "387": {"changesets": [{"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045703 - Test overlapping Settings search does not show the whole pane a=test-only\n\nUnder the settings redesign, searching a typo hid the matching group. Deleting\nback toward the real query could leave the intermediate search unfinished. That\nleft this.query a substring of the final query with searchCompleted false. The\nfinal search then took the subQuery fast path, which skips already-hidden groups.\nNo group matched, so the pane-level fallback showed the whole setting-pane.\n\nBug 2045266 fixed this with the searchCompleted gate. Add a test that reproduces\nthe reported keystroke interaction on the sync pane. It checks that the visible\nsetting-groups match a fresh, non-overlapping search.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313117\n", "files": ["browser/components/preferences/tests/searchResults/browser_search_overlapping_ranges.js"], "git_node": "652a290ad34fd5a978f9be2e5e180098df71607f", "git_parents": ["43875bc3256db652dbb33b187363eb774644b90a"], "node": "a5f1ec7d443beabf56ef4d6eca197acc8019c559", "parents": ["26972f082ebc754aa2c3a858bf4b84f325fc7bb2"], "tags": []}], "date": 1787424939, "git_changesets": ["652a290ad34fd5a978f9be2e5e180098df71607f"], "user": "rvandermeulen@mozilla.com"}, "388": {"changesets": [{"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 2064648 - Don't apply the file:// URI allowlist to worker process selection.  a=RyanVM\n\nIsolationBehaviorForURI() maps any origin in the file:// URI allowlist to\nIsolationBehavior::File so that a document which is permitted to link to local\nfiles renders in the file content process, in case it uses file:// sub-resources.\nThat allowlist is built from the capability.policy.* prefs which the\nLocalFileLinks enterprise policy writes, which intranet deployments use so that\nan internal portal (typically SharePoint) may link to files on a network share.\n\nThe rule was never meant to apply to workers. Before worker process selection\nmoved to ProcessIsolation in bug 1850589, E10SUtils.validatedWebRemoteType()\nguarded the equivalent check with !aIsWorker. Losing that guard was silent until\nbug 2050536 added ValidateBehaviorForWorker(), whose File case requires the\ncurrent remote type to be the file remote type. ServiceWorkerPrivate::Initialize()\nruns in the parent but passes the shared \"web\" remote type, so it now fails, and\nin release builds MOZ_ALWAYS_SUCCEEDS() lets construction continue with a\ndefault-constructed mRemoteWorkerData that crashes on the first intercepted fetch.\n\nThread an aIsWorker argument through IsolationBehaviorForURI() and skip the\nallowlist lookup for workers, restoring the pre-bug-1850589 behavior of selecting\nan ordinary web remote type. Genuine file: principals are unaffected; they are\nmatched earlier by scheme, which the new test also covers. Documents are\nunaffected as well, as browser_new_file_whitelisted_http_tab.js continues to\nverify.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320314\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320672\n", "files": ["dom/ipc/ProcessIsolation.cpp", "dom/ipc/gtest/ProcessIsolationTest.cpp"], "git_node": "81e7ffa9afce97661fd7ca51403ff266dddff529", "git_parents": ["652a290ad34fd5a978f9be2e5e180098df71607f"], "node": "e9a99f3f4b55b31e80eb9b16a55fd70fdbf6865e", "parents": ["a5f1ec7d443beabf56ef4d6eca197acc8019c559"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 2064648 - Neutralize a ServiceWorkerPrivate whose Initialize() failed.  a=RyanVM\n\nInitialize() is called only from the constructor and has no retry, but in\nrelease builds MOZ_ALWAYS_SUCCEEDS() does not stop construction. A\nServiceWorkerPrivate therefore survives a failed Initialize() with a\ndefault-constructed mRemoteWorkerData whose OptionalServiceWorkerData union is\nstill T__None, and RefreshRemoteWorkerData() then fatally asserts in\nget_ServiceWorkerData() the first time the worker is asked to spawn.\n\nClear mInfo on any early return from Initialize(). That is the same state\nNoteDeadServiceWorkerInfo() already establishes, so the existing guards do the\nwork: SpawnWorkerIfNeeded() bails before touching mRemoteWorkerData, and since\nExecServiceWorkerOp() and SendFetchEventInternal() both go through it, every\noperation now fails cleanly. A failed fetch interception resets the interception\nand the request goes to the network, so the site loads without its service\nworker rather than taking down the parent process.\n\nSendPushEvent() and SendCookieChangeEvent() are the only entry points which\ndereference mInfo before delegating to SpawnWorkerIfNeeded(), so give them the\nsame null check SendFetchEvent() already has. Everything else which asserts\nmInfo requires a spawned worker or mControllerChild and so is unreachable.\n\nThe MOZ_DIAGNOSTIC_ASSERT in the constructor is deliberately kept, so an\nunexpected Initialize() failure remains loud on Nightly and Dev Edition.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320673\n", "files": ["dom/serviceworkers/ServiceWorkerPrivate.cpp"], "git_node": "4adbefae519833e2a96c6a86c270ff06ccd8e3f1", "git_parents": ["81e7ffa9afce97661fd7ca51403ff266dddff529"], "node": "85428f9994d708566687579ee4944617c90cfbc2", "parents": ["e9a99f3f4b55b31e80eb9b16a55fd70fdbf6865e"], "tags": []}], "date": 1787430226, "git_changesets": ["81e7ffa9afce97661fd7ca51403ff266dddff529", "4adbefae519833e2a96c6a86c270ff06ccd8e3f1"], "user": "rvandermeulen@mozilla.com"}, "389": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045703 - Enable backup pref for macOS. a=bustage\n", "files": ["browser/components/preferences/tests/searchResults/browser_search_overlapping_ranges.js"], "git_node": "9547d2e6581e0092caf8d9a2f548f1f33827fad3", "git_parents": ["4adbefae519833e2a96c6a86c270ff06ccd8e3f1"], "node": "d40cca3f73796f53aa50d618c2c3570d5ab5a82f", "parents": ["85428f9994d708566687579ee4944617c90cfbc2"], "tags": []}], "date": 1787437189, "git_changesets": ["9547d2e6581e0092caf8d9a2f548f1f33827fad3"], "user": "rvandermeulen@mozilla.com"}, "390": {"changesets": [{"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2059035 - Restore the non-positive guard on the GTK screen resolution.  a=RyanVM DONTBUILD\n\ngdk_screen_get_resolution() returns -1 when no resolution has been set,\nand GetGtkTextScaleFactor() handed that on as a scale factor. It reaches\nsystem font sizes both directly in GetSystemFontInfo() and via\nmTextScaleFactor in PerThemeData::GetFont(), and a negative font size\ndraws no glyphs, so all chrome text goes invisible.\n\nThis used to be guarded in gfxPlatformGtk::GetFontScaleDPI(); bug 1967147\nmoved the computation into nsLookAndFeel without carrying the guard over,\nso it's a regression from 140. esr140 is affected, esr128 is not.\n\nReachable on any session that gives GTK no DPI to read, e.g. KDE Plasma\non Wayland with no xsettingsd and no GNOME GSettings schemas. X11 is\nimmune because gdk/x11/gdkxftdefaults.c defaults to 96.0 and gdk/wayland\nhas no equivalent fallback.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315116\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320710\n", "files": ["widget/gtk/nsLookAndFeel.cpp"], "git_node": "38bcdd0d4e6d9deeb51cf145b48e3e41ccaedfd4", "git_parents": ["9547d2e6581e0092caf8d9a2f548f1f33827fad3"], "node": "8aa1543d2136e11d99bebb13333b17013546c396", "parents": ["d40cca3f73796f53aa50d618c2c3570d5ab5a82f"], "tags": []}], "date": 1787503745, "git_changesets": ["38bcdd0d4e6d9deeb51cf145b48e3e41ccaedfd4"], "user": "rvandermeulen@mozilla.com"}, "391": {"changesets": [{"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063336 - Cap the cookie database WAL size in bytes instead of pages  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319294\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320717\n", "files": ["netwerk/cookie/CookiePersistentStorage.cpp"], "git_node": "da94f8fec4ec20b34605b0799160c6c80cfdb989", "git_parents": ["38bcdd0d4e6d9deeb51cf145b48e3e41ccaedfd4"], "node": "9e2f86491ef26388f421459ff02d3ab22ed1faf8", "parents": ["8aa1543d2136e11d99bebb13333b17013546c396"], "tags": []}], "date": 1787503797, "git_changesets": ["da94f8fec4ec20b34605b0799160c6c80cfdb989"], "user": "rvandermeulen@mozilla.com"}, "392": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065926 - Update l10n-changesets on ESR153. a=RyanVM DONTBUILD\n", "files": ["browser/locales/l10n-changesets.json"], "git_node": "af7c709143462e3c963aafede16f57e7ef671c1d", "git_parents": ["da94f8fec4ec20b34605b0799160c6c80cfdb989"], "node": "e471a6055c12ee1765da8bf2346c01bf8e14a85d", "parents": ["9e2f86491ef26388f421459ff02d3ab22ed1faf8"], "tags": []}], "date": 1787504251, "git_changesets": ["af7c709143462e3c963aafede16f57e7ef671c1d"], "user": "rvandermeulen@mozilla.com"}, "393": {"changesets": [{"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051148 - Fix accesskeys in the search mode switcher.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311089\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319417\n", "files": ["browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_keyNavigation.js", "browser/locales/en-US/browser/browser.ftl"], "git_node": "cb37b9398b917f4654f906c9d0775d6dafbe76ea", "git_parents": ["af7c709143462e3c963aafede16f57e7ef671c1d"], "node": "00bead95ba20d8ca97e2db324fc54654487b20d6", "parents": ["e471a6055c12ee1765da8bf2346c01bf8e14a85d"], "tags": []}], "date": 1787504462, "git_changesets": ["cb37b9398b917f4654f906c9d0775d6dafbe76ea"], "user": "rvandermeulen@mozilla.com"}, "394": {"changesets": [{"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918085 - Show updated password import instructions for macOS Sequoia and up.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310415\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319131\n", "files": ["browser/components/migration/MigrationUtils.sys.mjs", "browser/components/migration/MigrationWizardChild.sys.mjs", "browser/components/migration/MigrationWizardParent.sys.mjs", "browser/components/migration/content/migration-wizard-constants.mjs", "browser/components/migration/content/migration-wizard.mjs", "browser/components/migration/tests/browser/browser_safari_passwords.js", "browser/components/migration/tests/chrome/test_migration_wizard.html", "browser/components/storybook/stories/migration-wizard.stories.mjs", "browser/locales/en-US/browser/migrationWizard.ftl"], "git_node": "104a8f79a2904e673f7907e72c4fd08f3995a029", "git_parents": ["cb37b9398b917f4654f906c9d0775d6dafbe76ea"], "node": "6570588cb6ee6b00c6e2f488feac948b66a21daa", "parents": ["00bead95ba20d8ca97e2db324fc54654487b20d6"], "tags": []}], "date": 1787504533, "git_changesets": ["104a8f79a2904e673f7907e72c4fd08f3995a029"], "user": "rvandermeulen@mozilla.com"}, "395": {"changesets": [{"author": "iain holmes \u003ciholmes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021757: Add system logging for debugging initial startup.  a=RyanVM DONTBUILD\n\nAdd the ability to log to macOS's system log to aid debugging before the updater's log files have been created.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D290203\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320743\n", "files": ["toolkit/mozapps/update/common/updatecommon.cpp", "toolkit/mozapps/update/common/updatecommon.h", "toolkit/mozapps/update/updater/updater.cpp"], "git_node": "e82588625d8fa7a9c5908f43d3a8f84ea57e13dc", "git_parents": ["104a8f79a2904e673f7907e72c4fd08f3995a029"], "node": "787396a601cca9c45b6e5ad3f801776c68a2eb2c", "parents": ["6570588cb6ee6b00c6e2f488feac948b66a21daa"], "tags": []}], "date": 1787516945, "git_changesets": ["e82588625d8fa7a9c5908f43d3a8f84ea57e13dc"], "user": "rvandermeulen@mozilla.com"}, "396": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058660 - Forward WebTransport stream events to the retargeted thread.  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320726\n", "files": ["netwerk/protocol/webtransport/WebTransportSessionProxy.cpp"], "git_node": "2dc332f2b4c15ebb0073f879b255ce72752626d9", "git_parents": ["e82588625d8fa7a9c5908f43d3a8f84ea57e13dc"], "node": "c380c5361aa72af16e37f046ae90ad23fd2c9a56", "parents": ["787396a601cca9c45b6e5ad3f801776c68a2eb2c"], "tags": []}], "date": 1787516967, "git_changesets": ["2dc332f2b4c15ebb0073f879b255ce72752626d9"], "user": "rvandermeulen@mozilla.com"}, "397": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2061521 - Fix net::HasRootDomain  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317054\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317449\n", "files": ["netwerk/base/nsNetUtil.cpp", "netwerk/dns/nsIEffectiveTLDService.idl"], "git_node": "c7bbb76c9d1f562c053d6c6acc509c3f12c6c270", "git_parents": ["2dc332f2b4c15ebb0073f879b255ce72752626d9"], "node": "4adb1f6a1685237ad060ba3157e6a1c87fcbd09f", "parents": ["c380c5361aa72af16e37f046ae90ad23fd2c9a56"], "tags": []}], "date": 1787582437, "git_changesets": ["c7bbb76c9d1f562c053d6c6acc509c3f12c6c270"], "user": "rvandermeulen@mozilla.com"}, "398": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063618 - Make ReportingHeader call HasRootDomain with host not origin  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318848\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321009\n", "files": ["dom/reporting/ReportingHeader.cpp", "dom/reporting/tests/browser.toml", "dom/reporting/tests/browser_purgeHost.js", "dom/reporting/tests/reporting_endpoints.sjs"], "git_node": "5c80b18623bf10ff5cc9591350d209ca6d1887c2", "git_parents": ["c7bbb76c9d1f562c053d6c6acc509c3f12c6c270"], "node": "588a500c2ccca707950d14a459661a9104f31e5e", "parents": ["4adb1f6a1685237ad060ba3157e6a1c87fcbd09f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2063618 - Callers of hasRootDomain should use asciiHost instead of displayHost  a=dmeehan DONTBUILD\n\n- Adds #asciiHost getter to browser-trustPanel.js for use when calling other APIs.\n- Renames #host to #displayHost to avoid future confusion\n- Makes passwordRulesManager use asciiHost when calling hasRootDomain\n- Adds tests for both callsites with IDN domains\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319031\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321010\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/components/urlbar/tests/browser/browser_trust_panel_icon.js", "toolkit/components/passwordmgr/PasswordRulesManager.sys.mjs", "toolkit/components/passwordmgr/test/unit/test_PasswordRulesManager_generatePassword.js"], "git_node": "4de68fa8dc8213f14bdc61f7a77b4b05a5413a8e", "git_parents": ["5c80b18623bf10ff5cc9591350d209ca6d1887c2"], "node": "4747dc11f9e1b72e84decc836e4c294a2905aa0f", "parents": ["588a500c2ccca707950d14a459661a9104f31e5e"], "tags": []}], "date": 1787598876, "git_changesets": ["5c80b18623bf10ff5cc9591350d209ca6d1887c2", "4de68fa8dc8213f14bdc61f7a77b4b05a5413a8e"], "user": "dmeehan@mozilla.com"}, "399": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr153 repo-update remote-settings tld-suffixes ct-logs -  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320789\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/softblocks-addons-mlbf.bin.meta.json", "services/settings/dumps/blocklists/gfx.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/newtab-wallpapers-v2.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "64c281860cd31c249aebc9c568785e3cef732064", "git_parents": ["4de68fa8dc8213f14bdc61f7a77b4b05a5413a8e"], "node": "7dc7b689ce2bde761bb7c970251bc67e68310bf6", "parents": ["4747dc11f9e1b72e84decc836e4c294a2905aa0f"], "tags": []}], "date": 1787599054, "git_changesets": ["64c281860cd31c249aebc9c568785e3cef732064"], "user": "rvandermeulen@mozilla.com"}, "400": {"changesets": [{"author": "