s/type.h"], "git_node": "271f13a50f509c8b5a676819cdbc24080f638982", "git_parents": ["455aa3f23afff6a6710fdf5c159e3bf585809c1a"], "node": "089759fffdd68c40b1b53d2cf87ad44818ab979f", "parents": ["dbe50938066f9d98e719ff8a69e472ac2873d528"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054619 - WebRTC backport: Video capture: validate SPA pod values to prevent OOB reads  a=RyanVM\n\nAdd bounds checks when reading SPA pod choice values in OnNodeParam\nand ParseFormat. Validate that the pod value size matches the expected\ntype using spa_pod_type_size() and that the number of choice items\nis sufficient before accessing the underlying arrays.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: a0253ec15b3d3072fb35d6be29ba9224c36f9dd7\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318394\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318414\n", "files": ["third_party/libwebrtc/modules/video_capture/linux/pipewire_session.cc", "third_party/libwebrtc/moz-patch-stack/a0253ec15b.no-op-cherry-pick-msg"], "git_node": "e70c7c6ba368ef09e884bf1b460d7241361742ba", "git_parents": ["271f13a50f509c8b5a676819cdbc24080f638982"], "node": "2b1627bd556a34e75167592e84c32f4c98b6be64", "parents": ["089759fffdd68c40b1b53d2cf87ad44818ab979f"], "tags": []}], "date": 1787062727, "git_changesets": ["271f13a50f509c8b5a676819cdbc24080f638982", "e70c7c6ba368ef09e884bf1b460d7241361742ba"], "user": "rvandermeulen@mozilla.com"}, "330": {"changesets": [{"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059144 - Hotfix for build breakage  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319482\n", "files": ["dom/ipc/nsIDOMProcessParent.idl"], "git_node": "ee94f0b4a40947a10de4d7ea90c5ba7569d549f7", "git_parents": ["e70c7c6ba368ef09e884bf1b460d7241361742ba"], "node": "bed79a940f0ec6b15bb4c147824b93ad071