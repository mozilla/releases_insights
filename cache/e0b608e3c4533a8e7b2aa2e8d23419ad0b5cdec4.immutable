"334": {"changesets": [{"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2054640 - Reset CORS mode when aborting media loads  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313931\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319637\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp"], "git_node": "c15ae73f500d7fd6c17f411dbc486fee78587412", "git_parents": ["067b7f3b5afeee03e418d70fb0fc91d33af4d64d"], "node": "fc0c22c9a3dea7da8bf96cbf9ad51ab8503c8c1c", "parents": ["71ecf448cbcd86bc1d58950d3ce8e3a101cfc3db"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2054640 - Clear CORS mode before MediaStream playback  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313932\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319638\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp"], "git_node": "005d355aae0186deee416b402f754bc374151e5b", "git_parents": ["c15ae73f500d7fd6c17f411dbc486fee78587412"], "node": "cc02ccfd4f9dcd16f8ce474139865c31ecb3bbd1", "parents": ["fc0c22c9a3dea7da8bf96cbf9ad51ab8503c8c1c"], "tags": []}], "date": 1787111316, "git_changesets": ["c15ae73f500d7fd6c17f411dbc486fee78587412", "005d355aae0186deee416b402f754bc374151e5b"], "user": "rvandermeulen@mozilla.com"}, "335": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054652 - Check resource namespaces during displaylist building. r=lsalzman a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315537\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319859\n", "files": ["gfx/layers/wr/AsyncImagePipelineManager.cpp", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/example-compositor/compositor/src/main.rs", "gfx/wr/examples/common/boilerplate.rs", "gfx/wr/examples/document.rs", "gfx/wr/examples/iframe.rs", "gfx/wr/examples/multiwindow.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/wrench/src/rawtest.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "0f1daba40e644d04dbe020479b262660d2730779", "git_parents": ["005d355aae0186deee416b402f754bc374151e5b"], "node": "0acfe5a5ce0e6755fc77ccb9c64da6c733b72441", "parents": ["cc02ccfd4f9dcd16f8ce474139865c31ecb3bbd1"], "tags": []}], "date": 1787237879, "git_changesets": ["0f1daba40e644d04dbe020479b262660d2730779"], "user": "rvandermeulen@mozilla.com"}, "336": {"changesets": [{"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054657: Add Posix compliance check for special characters.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313256\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320098\n", "files": ["dom/filesystem/FileSystemSecurity.cpp"], "git_node": "c7f20e3288dd3d05e475cf216fc218aad678084e", "git_parents": ["0f1daba40e644d04dbe020479b262660d2730779"], "node": "8716c8da76ce0f12741a43f4a9f8be6e9922c600", "parents": ["0acfe5a5ce0e6755fc77ccb9c64da6c733b72441"], "tags": []}], "date": 1787237912, "git_changesets": ["c7f20e3288dd3d05e475cf216fc218aad678084e"], "user": "rvandermeulen@mozilla.com"}, "337": {"changesets": [{"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059180 - Perform cleanup for Reporting API properly  a=RyanVM DONTBUILD\n\nRemove Reporting API metadata when a global (window or worker) is\ndestroyed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317803\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319919\n", "files": ["dom/base/nsIGlobalObject.cpp", "dom/reporting/ReportDeliver.cpp", "dom/reporting/ReportDeliver.h"], "git_node": "d093663803772dbaf3ce11cf92c68534a6544dbc", "git_parents": ["c7f20e3288dd3d05e475cf216fc218aad678084e"], "node": "62011d4177937895e865c5b876a8d6198aeae7e7", "parents": ["8716c8da76ce0f12741a43f4a9f8be6e9922c600"], "tags": []}], "date": 1787237936, "git_changesets": ["d093663803772dbaf3ce11cf92c68534a6544dbc"], "user": "rvandermeulen@mozilla.com"}, "338": {"changesets": [{"author": "Artur Iunusov \u003caiunusov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059185 - FIX Parent process accepts child-forged PERSISTENT persistenceType in PBackgroundIDBFactory open/delete requests  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316564\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320020\n", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": "2e893a7e7d97e83172488a96e2453a8b6f1a459d", "git_parents": ["d093663803772dbaf3ce11cf92c68534a6544dbc"], "node": "82d7b73475a5559c701fa6f3c4378baaadd5a56b", "parents": ["62011d4177937895e865c5b876a8d6198aeae7e7"], "tags": []}], "date": 1787237959, "git_changesets": ["2e893a7e7d97e83172488a96e2453a8b6f1a459d"], "user": "rvandermeulen@mozilla.com"}, "339": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042768 - Remove incorrect weak map marking checks (ESR153)  a=RyanVM DONTBUILD\n\nThis removes the incorrect check (that actually wasn't running until recently\nbecause of another bug) and adds more checks that are hopefuly correct this time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319783\n", "files": ["js/src/gc/Verifier.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.h", "js/src/jit-test/tests/gc/bug-2042768.js"], "git_node": "d8f165e5bb57142d72a42792a546f02661a920b6", "git_parents": ["2e893a7e7d97e83172488a96e2453a8b6f1a459d"], "node": "7f7487d731953932a4342962b82ba2a4ce27a6b5", "parents": ["82d7b73475a5559c701fa6f3c4378baaadd5a56b"], "tags": []}], "date": 1787237995, "git_changesets": ["d8f165e5bb57142d72a42792a546f02661a920b6"], "user": "rvandermeulen@mozilla.com"}, "340": {"changesets": [{"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055678 - Make some session history state update early return.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318031\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320014\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "254568163835f0f788bb3e23ca16dd691ffa2357", "git_parents": ["d8f165e5bb57142d72a42792a546f02661a920b6"], "node": "cb65884ef0a6a8d790177f5aef927aa88dea863c", "parents": ["7f7487d731953932a4342962b82ba2a4ce27a6b5"], "tags": []}], "date": 1787238034, "git_changesets": ["254568163835f0f788bb3e23ca16dd691ffa2357"], "user": "rvandermeulen@mozilla.com"}, "341": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061775 - Ensure GC marker knows which zone we're in when marking weakmaps (ESR153)  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319784\n", "files": ["js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp", "js/src/gc/WeakMap-inl.h", "js/src/jit-test/tests/gc/bug-2061775.js"], "git_node": "af5066f605a4a8342e7f249512d68cf9e6076e7a", "git_parents": ["254568163835f0f788bb3e23ca16dd691ffa2357"], "node": "1405f98bb7e2dba5a137618741e3c7e081ce4a05", "parents": ["cb65884ef0a6a8d790177f5aef927aa88dea863c"], "tags": []}], "date": 1787238060, "git_changesets": ["af5066f605a4a8342e7f249512d68cf9e6076e7a"], "user": "rvandermeulen@mozilla.com"}, "342": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057457 - Ensure we don't lose atom references for symbol weak edges (ESR153)  a=RyanVM DONTBUILD\n\nThe problem is that our efforts to refine the atom references effectively by\ndelaying marking atoms referenced by uncollected zones until after refining the\natom reference bitmaps means that we throw away refernces to live atoms that\nare only weakly referenced by collecting zones.\n\nThis is the same problem we've fixed several times in the weak map marking\ncode.\n\nThe fix adds a common way to handle marking weakly refereneced atoms and uses\nit in both cases. This allows us to remove two previous attempts to patch up\nthis problem. It is similar to what we do for weak map edges: mark weakly\nreferenced atoms that are referenced by uncollected zones eagarly. Thes means\nthey are marked when we refine the reference bitmaps for collected zones so\nexisting references are preserved and not thrown away.\n\nThe patch does the marking manually since we can be in the sweep state by this\ntime and the marking machinery doesn't allow any more marking.\n\nThis moves updating the reference bitmaps until the end of sweeping so that it\ncan see marking done by tracing weak edges. Deferred gray marking checks are\ndone after this happens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319785\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/GCRuntime.h", "js/src/gc/Marking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.cpp", "js/src/jit-test/tests/gc/bug-1997896.js", "js/src/jit-test/tests/gc/bug-2042465.js"], "git_node": "3eafae8e6ee746de1eeb7606a85a365121af09d1", "git_parents": ["af5066f605a4a8342e7f249512d68cf9e6076e7a"], "node": "22601a8ca6704320c9bd1f082c9bc30f603af80f", "parents": ["1405f98bb7e2dba5a137618741e3c7e081ce4a05"], "tags": []}], "date": 1787238116, "git_changesets": ["3eafae8e6ee746de1eeb7606a85a365121af09d1"], "user": "rvandermeulen@mozilla.com"}, "343": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059199 - Reject NUL bytes in chunked trailer and chunk-size lines  a=RyanVM DONTBUILD\n\nA trailer field line whose first byte is NUL would look empty to the\nend-of-trailer check, ending the trailer section early. We would then stop\nreading the body before the server (or a shared proxy) does, and disagree\nwith them about where the response ends.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319931\n", "files": ["netwerk/protocol/http/nsHttpChunkedDecoder.cpp"], "git_node": "8ef6ef98510f7b7447f0caf2962df0a4af759eef", "git_parents": ["3eafae8e6ee746de1eeb7606a85a365121af09d1"], "node": "1e2437140ab2bb11d42bede43fd06806a09779a8", "parents": ["22601a8ca6704320c9bd1f082c9bc30f603af80f"], "tags": []}], "date": 1787238167, "git_changesets": ["8ef6ef98510f7b7447f0caf2962df0a4af759eef"], "user": "rvandermeulen@mozilla.com"}, "344": {"changesets": [{"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051282 - Add back peer connection H264 telemetry on PCImpl Init.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D309693\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320038\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp"], "git_node": "1cc2ba150a19ffa7e753d61a7d1d9a1212bb7849", "git_parents": ["8ef6ef98510f7b7447f0caf2962df0a4af759eef"], "node": "ddef789d01a87808ba64f6d47a6891d8e85e2047", "parents": ["1e2437140ab2bb11d42bede43fd06806a09779a8"], "tags": []}], "date": 1787238206, "git_changesets": ["1cc2ba150a19ffa7e753d61a7d1d9a1212bb7849"], "user": "rvandermeulen@mozilla.com"}, "345": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061300 - Make ProxyObject::renew work when called on dying objects (ESR153)  a=RyanVM\n\nThis is similar to other places where we call setMayHavePointersToDeadCells().\nWe may end up remapping dying proxy objects so if we insert a storebuffer entry\nwe need to set this flag so we'll empty the nursery before we sweep the object.\n\nThe patch also makes a change to the shell to supply a rewrap callback that\ncalls Wrapper::Renew on existing proxies, like the browser does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319786\n", "files": ["js/src/jit-test/tests/gc/bug-2061300.js", "js/src/proxy/Proxy.cpp", "js/src/shell/js.cpp"], "git_node": "e191d46fbe35cf2574ffdfbde85cdd8d34510401", "git_parents": ["1cc2ba150a19ffa7e753d61a7d1d9a1212bb7849"], "node": "3c018312a2ce2025b58cdafbad534c0c4aeb211f", "parents": ["ddef789d01a87808ba64f6d47a6891d8e85e2047"], "tags": []}], "date": 1787238232, "git_changesets": ["e191d46fbe35cf2574ffdfbde85cdd8d34510401"], "user": "rvandermeulen@mozilla.com"}, "346": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059274 - Fix ESLint warning. a=bustage\n", "files": ["netwerk/test/browser/browser_test_lna_insecure_context.js"], "git_node": "7568b29675606110ee9ab42c28bc9ef5bc8cc46b", "git_parents": ["e191d46fbe35cf2574ffdfbde85cdd8d34510401"], "node": "bfaeb03a8a751c1a4dc1e0c957dc841f24d01a0a", "parents": ["3c018312a2ce2025b58cdafbad534c0c4aeb211f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "No bug - Work around known browser_smartwindow_sanitize.js flakiness. a=test-only\n\nThis is a backport of a hunk of what originally landed in bug 2005411 to work around\nknown flakiness this test triggers.\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_sanitize.js"], "git_node": "e243e2c10ddb16efcaa899d8f6f4dd1d1fce0135", "git_parents": ["7568b29675606110ee9ab42c28bc9ef5bc8cc46b"], "node": "260765742c82e62acf80ea5c81cacfb47c31bcb3", "parents": ["bfaeb03a8a751c1a4dc1e0c957dc841f24d01a0a"], "tags": []}], "date": 1787247284, "git_changesets": ["7568b29675606110ee9ab42c28bc9ef5bc8cc46b", "e243e2c10ddb16efcaa899d8f6f4dd1d1fce0135"], "user": "rvandermeulen@mozilla.com"}, "347": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "No bug - Fix ESLint warnings in browser_smartwindow_sanitize.js. a=bustage DONTBUILD\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_smartwindow_sanitize.js"], "git_node": "df016eaaa3b9a7cd4168e017d9d70e75f7e8d0bc", "git_parents": ["e243e2c10ddb16efcaa899d8f6f4dd1d1fce0135"], "node": "dd11ce0ee2774244b00347831746eea1c09a6485", "parents": ["260765742c82e62acf80ea5c81cacfb47c31bcb3"], "tags": []}], "date": 1787250125, "git_changesets": ["df016eaaa3b9a7cd4168e017d9d70e75f7e8d0bc"], "user": "rvandermeulen@mozilla.com"}, "348": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058013 - Only resolve non-filesystem picker results as shell libraries  a=RyanVM DONTBUILD\n\nA genuine shell library is a virtual item with no filesystem path.  A\n.library-ms file is an ordinary file whose XML can name any local directory.\n\nfiledialog::GetFolderResults was passing whatever IFileDialog::GetResult\nreturned to IShellLibrary::LoadLibraryFromItem and, on success, replacing it\nwith the library's embedded default save folder.\n\nGating the resolution on the item being affirmatively not a filesystem object\nkeeps real libraries selectable and resolving as before, while a .library-ms\nfile \"resolves\" to itself -- the .library-ms file, not its target.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318246\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319957\n", "files": ["widget/windows/filedialog/WinFileDialogCommands.cpp"], "git_node": "09466b97643e979e86905be2e9f5a29b3acc6083", "git_parents": ["df016eaaa3b9a7cd4168e017d9d70e75f7e8d0bc"], "node": "42d0cb1b4614ac05dbb6d8119da6e4ae7e1cbad4", "parents": ["dd11ce0ee2774244b00347831746eea1c09a6485"], "tags": []}], "date": 1787250872, "git_changesets": ["09466b97643e979e86905be2e9f5a29b3acc6083"], "user": "rvandermeulen@mozilla.com"}, "349": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058006 - Call Destroy() unconditionally in ~StatusBarEntry.  a=RyanVM DONTBUILD\n\nAllow Destroy() to tear down mIconLoader, even if Init() does not successfully\ncomplete initialization.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319879\n", "files": ["widget/windows/SystemStatusBar.cpp"], "git_node": "6cbd5243da62ddd46ab167a1b66839737bad228e", "git_parents": ["09466b97643e979e86905be2e9f5a29b3acc6083"], "node": "b4fbce2f99495ea8b00763c5b1baa33494f59ddf", "parents": ["42d0cb1b4614ac05dbb6d8119da6e4ae7e1cbad4"], "tags": []}], "date": 1787250895, "git_changesets": ["6cbd5243da62ddd46ab167a1b66839737bad228e"], "user": "rvandermeulen@mozilla.com"}, "350": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059027 - Create the DLL blocklist shared section with an empty DACL.  a=RyanVM DONTBUILD\n\nSharedSection::Init() creates the section with no security descriptor.\nGive the object a present-but-empty DACL, as ipc/glue does for freezable\nshared memory.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318252\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319961\n", "files": ["browser/app/winlauncher/freestanding/SharedSection.cpp", "browser/app/winlauncher/freestanding/moz.build", "browser/app/winlauncher/test/TestCrossProcessWin.cpp", "browser/app/winlauncher/test/moz.build"], "git_node": "eb386283a5acb94ccbecdf47fb9164adac9520bf", "git_parents": ["6cbd5243da62ddd46ab167a1b66839737bad228e"], "node": "9bb2458df113bae3d690f0c7815eaed38c3acb95", "parents": ["b4fbce2f99495ea8b00763c5b1baa33494f59ddf"], "tags": []}], "date": 1787250935, "git_changesets": ["eb386283a5acb94ccbecdf47fb9164adac9520bf"], "user": "rvandermeulen@mozilla.com"}, "351": {"changesets": [{"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2061220, Bug 2058051 - Backport cubeb WASAPI output channel count and WinMM stream destroy fixes.  a=RyanVM DONTBUILD\n\nThis branch pins an older libcubeb revision, so the two fixes are carried as\nlocal vendoring patches rather than a full libcubeb update:\n\n- wasapi-output-mix-channel-count.patch: upstream cubeb dc56ea41 and f0bd97db\n  (mozilla/cubeb#856), bug 2061220.  Creates the output mixer when the device\n  mix channel count differs from the stream channel count, and rejects stream\n  params whose layout and channel count disagree.\n- winmm-destroy-work-item-uaf.patch: upstream cubeb f6b59a3b\n  (mozilla/cubeb#854), bug 2058051.  Counts pending buffer thread work items\n  per stream and in-flight driver callbacks per context so stream and context\n  destruction wait for them to drain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319945\n", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb.c", "media/libcubeb/src/cubeb_wasapi.cpp", "media/libcubeb/src/cubeb_winmm.c", "media/libcubeb/test/test_sanity.cpp", "media/libcubeb/wasapi-output-mix-channel-count.patch", "media/libcubeb/winmm-destroy-work-item-uaf.patch"], "git_node": "554b4d6a1e1748a10f2f94fd2532acd3eae75471", "git_parents": ["eb386283a5acb94ccbecdf47fb9164adac9520bf"], "node": "b0d1db03376c9573d4384975941cba960ef27637", "parents": ["9bb2458df113bae3d690f0c7815eaed38c3acb95"], "tags": []}], "date": 1787250958, "git_changesets": ["554b4d6a1e1748a10f2f94fd2532acd3eae75471"], "user": "rvandermeulen@mozilla.com"}, "352": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062119 - Do not dereference gJarHandler after it has been cleared at shutdown.  a=RyanVM DONTBUILD\n\nnsJARChannel read the gJarHandler global directly in five places. Since bug\n1412726 that global is a StaticRefPtr cleared by ClearOnShutdown, so it can be\nnull while channels are still alive and opening a channel during late shutdown\ncrashes. The owning reference the channel takes in its constructor kept the\nhandler object alive but stopped protecting the global, and has had no readers\nsince that same bug.\n\nAdd shutdown safe accessors that return null once the singleton is gone, use\nthem for all of those accesses and fail the channel with\nNS_ERROR_ILLEGAL_DURING_SHUTDOWN instead. Drop the unused mJarHandler member.\n\nWhile here, EnsureCached can use the accessor instead of fetching the handler\nthrough the IO service and downcasting the result.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317420\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320109\n", "files": ["modules/libjar/nsJARChannel.cpp", "modules/libjar/nsJARChannel.h", "modules/libjar/nsJARProtocolHandler.cpp", "modules/libjar/nsJARProtocolHandler.h"], "git_node": "518427cfdf381a92ddecf6a2fa97c5c3b91ce869", "git_parents": ["554b4d6a1e1748a10f2f94fd2532acd3eae75471"], "node": "3042ddfd2fc3f9b8e2521258c2ea66f955e7294e", "parents": ["b0d1db03376c9573d4384975941cba960ef27637"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062119 - Clear the jar protocol handler after the JS module loader is gone.  a=RyanVM DONTBUILD\n\nChrome JS module loading reads from omni.ja through jar channels, and\nmozJSModuleLoader::UnloadLoaders() runs after the XPCOMShutdownFinal phase,\nwhich is the default phase for ClearOnShutdown. The handler was therefore\ncleared while chrome JS modules could still be imported, leaving a window in\nwhich those imports and any other late jar access fail.\n\nClear it at CCPostLastCycleCollection instead, which runs after UnloadLoaders().\n\nOriginal Revision: https://phabricator.services.mozilla.com/D317421\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320110\n", "files": ["modules/libjar/nsJAR.cpp", "modules/libjar/nsJARProtocolHandler.cpp"], "git_node": "27be338a121d83ee86cfff86836fd0aa4d33fa00", "git_parents": ["518427cfdf381a92ddecf6a2fa97c5c3b91ce869"], "node": "b8b3d1e3bf961ff6a8a67f02ee5c0d9fd9ad8390", "parents": ["3042ddfd2fc3f9b8e2521258c2ea66f955e7294e"], "tags": []}], "date": 1787250984, "git_changesets": ["518427cfdf381a92ddecf6a2fa97c5c3b91ce869", "27be338a121d83ee86cfff86836fd0aa4d33fa00"], "user": "rvandermeulen@mozilla.com"}, "353": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2064188 - Ensure Nimbus update timer is set during init  a=RyanVM DONTBUILD\n\nIn bug 1941963, side effects were removed from\nRemoteSettingsExperimentLoader.sys.mjs, making it safe to import without\ntriggering the creation of a global RemoteSettingsExperimentLoader.\nHowever, that patch also gated setting the update timer based on the\nRemoteSettingsExperimentLoader's enabled state. Unfortunately,\nthe timer was registered *before* the enabled flag was set, which meant\nthat the timer was never actually registered.\n\nWe now ensure that we set the enable state before registering the timer.\nThis behaviour is tracked by a new test.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319282\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319809\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_timer.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "61f852e209854294e2081aa2f388b8c9f771e679", "git_parents": ["27be338a121d83ee86cfff86836fd0aa4d33fa00"], "node": "5250debffd1ab1d07576db9dd82cd4aaccb2b9a2", "parents": ["b8b3d1e3bf961ff6a8a67f02ee5c0d9fd9ad8390"], "tags": []}], "date": 1787251010, "git_changesets": ["61f852e209854294e2081aa2f388b8c9f771e679"], "user": "rvandermeulen@mozilla.com"}, "354": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054624 - WebRTC backport: Video capture: cap resolution and null-check header metadata  a=RyanVM DONTBUILD\n\nReject video dimensions that could overflow frame size calculations.\nHandle missing SPA_META_Header which is optional.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 01455efea7797cff42c5228b14c85ab3cdb4bdac\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319163\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319394\n", "files": ["third_party/libwebrtc/modules/video_capture/linux/video_capture_pipewire.cc", "third_party/libwebrtc/moz-patch-stack/01455efea7.no-op-cherry-pick-msg"], "git_node": "09b103344aad958ab8a9e0a0c8d6922fc6c8da57", "git_parents": ["61f852e209854294e2081aa2f388b8c9f771e679"], "node": "c1771261eca29f6ee83eb1715776182adb3f9149", "parents": ["5250debffd1ab1d07576db9dd82cd4aaccb2b9a2"], "tags": []}], "date": 1787251035, "git_changesets": ["09b103344aad958ab8a9e0a0c8d6922fc6c8da57"], "user": "rvandermeulen@mozilla.com"}, "355": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2055703 - WebRTC backport: Screen capture: reject negative videocrop position values  a=RyanVM DONTBUILD\n\nValidate that SPA_META_VideoCrop position coordinates are\nnon-negative before using them as offsets into the frame buffer.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: f93c4fefee56b60876629d03df1ad01e203cc8c3\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319398\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319474\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/moz-patch-stack/f93c4fefee.no-op-cherry-pick-msg"], "git_node": "cf30df85dfdbf2d58e246cfa9937732704a9dde6", "git_parents": ["09b103344aad958ab8a9e0a0c8d6922fc6c8da57"], "node": "1f839a1bea14a800a1f0c89b9c394f3625cce406", "parents": ["c1771261eca29f6ee83eb1715776182adb3f9149"], "tags": []}], "date": 1787251060, "git_changesets": ["cf30df85dfdbf2d58e246cfa9937732704a9dde6"], "user": "rvandermeulen@mozilla.com"}, "356": {"changesets": [{"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2058627 - WebRTC backport: Screen capture: check n_datas before accessing buffer data planes  a=RyanVM\n\nReturn early from ProcessBuffer when spa_buffer-\u003en_datas is zero\nto avoid out-of-bounds access on metadata-only buffers that carry\nno data planes.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 3ce78cdbd865ad8837d1ffae21553791e8ec491d\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319390\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319471\n", "files": ["third_party/libwebrtc/modules/desktop_capture/linux/wayland/shared_screencast_stream.cc", "third_party/libwebrtc/moz-patch-stack/3ce78cdbd8.no-op-cherry-pick-msg"], "git_node": "383baef9a2076ec62a8e5bebc0e287ac1ebe17a3", "git_parents": ["cf30df85dfdbf2d58e246cfa9937732704a9dde6"], "node": "71529c4032f8a895129cc8a47ab025aab62e4ebf", "parents": ["1f839a1bea14a800a1f0c89b9c394f3625cce406"], "tags": []}], "date": 1787251085, "git_changesets": ["383baef9a2076ec62a8e5bebc0e287ac1ebe17a3"], "user": "rvandermeulen@mozilla.com"}, "357": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2061110, handle popover hiding in a bit more consistent way,  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319204\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319972\n", "files": ["dom/base/Document.cpp"], "git_node": "426aa9414c23cd1eed81b5dd5267b2189d992954", "git_parents": ["383baef9a2076ec62a