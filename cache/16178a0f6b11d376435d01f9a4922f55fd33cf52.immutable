.mozilla.com/D294855\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295160\n", "files": ["gfx/angle/checkout/src/libANGLE/renderer/d3d/d3d11/Renderer11.cpp"], "git_node": "272c38ff98fad7f082645f3aff1314a412059ba3", "git_parents": ["a45731f20522ae09c34f48524aeb4550f9d91cb9"], "node": "02781e2f8a5d4c33a2f1dfae3fa91eadf132c0cb", "parents": ["f0ce769c06d52f8ed9b9fc4ab7f6ef4ecb5de7d1"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2031921.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D295127\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295557\n", "files": ["dom/canvas/WebGLContext.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "fc9fd06a7dfe8c91dfbaa0b928759fd10ccbdb60", "git_parents": ["272c38ff98fad7f082645f3aff1314a412059ba3"], "node": "57bc41ebaf39df88cb74c064782fb0321d41774c", "parents": ["02781e2f8a5d4c33a2f1dfae3fa91eadf132c0cb"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2028731 - FileReader: use CheckedInt to validate size.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293704\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294928\n", "files": ["dom/file/FileReader.cpp"], "git_node": "3824ca1e8acb5ad497803b2a75c51f6f25e2705c", "git_parents": ["fc9fd06a7dfe8c91dfbaa0b928759fd10ccbdb60"], "node": "fab640665b92f68562b86587493e36f0c19fac8e", "parents": ["57bc41ebaf39df88cb74c064782fb0321d41774c"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2027433 Treat null input channels as zero in InterleaveAndConvertBuffer()   a=dmeehan\n\nThe loop nesting is inverted so as not to add a null check to the inner loop,\nbut this change would also have some impact on cache use:\n\n* The loop ordering might perhaps not be the ideal for two channels and large\n  sample counts, for example, because it means going through the\n  output/largest buffer twice.\n\n* It does, however, avoid pathological situations of iterating across planar\n  channel buffers, likely to load set-associative cache lines if the channel\n  buffers are page aligned, due to having 1024 (or somewhat fewer) floats, for\n  example.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293825\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294835\n", "files": ["dom/media/AudioSegment.h"], "git_node": "410524334a4deedbb639e477fc7e866e996a1fcb", "git_parents": ["3824ca1e8acb5ad497803b2a75c51f6f25e2705c"], "node": "44e35e6999fad02ebe1e7f4d0b6144f9ab3ae4d0", "parents": ["fab640665b92f68562b86587493e36f0c19fac8e"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2027433 Treat null input channels as zero in AudioChannelsDownMix()   a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293826\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294836\n", "files": ["dom/media/AudioChannelFormat.h"], "git_node": "91ccdc27b516c690ef6b82557c854edff255e2a9", "git_parents": ["410524334a4deedbb639e477fc7e866e996a1fcb"], "node": "15f4d052a0be77ccc17304c66d6c6bc36c2a149a", "parents": ["44e35e6999fad02ebe1e7f4d0b6144f9ab3ae4d0"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2027433 use nullptr for silent up-mix channels  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293827\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294837\n", "files": ["dom/media/AudioSegment.cpp", "dom/media/AudioSegment.h"], "git_node": "dce37278b94e4078d05cee934de32103b6061d38", "git_parents": ["91ccdc27b516c690ef6b82557c854edff255e2a9"], "node": "6fa1e94d8520f