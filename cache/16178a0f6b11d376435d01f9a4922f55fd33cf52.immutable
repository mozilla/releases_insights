git_node": "98c3759fee2e8898e24b8fa8250a76f1bf433813", "git_parents": ["9435ae04a5a7ae7eab20a8e9880e8916420422b9"], "node": "7299ac413e5a961c901f21acff6bbc5abe92897b", "parents": ["3900dff59079d36ee0e9f11c78d691ba4f182200"], "tags": []}], "date": 1776814905, "git_changesets": ["98c3759fee2e8898e24b8fa8250a76f1bf433813"], "user": "dmeehan@mozilla.com"}, "1204": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2030108 - Hold BufferTextureData's Shmem in ShmemHolder r=lsalzman a=dmeehan\n", "files": ["gfx/layers/BufferTexture.cpp", "gfx/layers/BufferTexture.h"], "git_node": "46999068ff24fc4d6a070f1595ac8d309adf48d4", "git_parents": ["98c3759fee2e8898e24b8fa8250a76f1bf433813"], "node": "c421223e5a7af4fad236eb88fb3ddc893d8a9ba6", "parents": ["7299ac413e5a961c901f21acff6bbc5abe92897b"], "tags": []}], "date": 1776815204, "git_changesets": ["46999068ff24fc4d6a070f1595ac8d309adf48d4"], "user": "dmeehan@mozilla.com"}, "1205": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 Treat null input channels as zero in InterleaveAndConvertBuffer()   a=dmeehan DONTBUILD\n\nThe loop nesting is inverted so as not to add a null check to the inner loop,\nbut this change would also have some impact on cache use:\n\n* The loop ordering might perhaps not be the ideal for two channels and large\n  sample counts, for example, because it means going through the\n  output/largest buffer twice.\n\n* It does, however, avoid pathological situations of iterating across planar\n  channel buffers, likely to load set-associative cache lines if the channel\n  buffers are page aligned, due to having 1024 (or somewhat fewer) floats, for\n  example.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293825\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294835\n", "files": ["dom/media/AudioSegment.h"], "git_node": "29ad23fc26876c5ab2af0507a39674a080a74c38", "git_parents": ["46999068ff24fc4d6a070f1595ac8d309adf48d4"], "node": "163c74119708001aae994f15954f65084d276ed4", "parents": ["c421223e5a7af4fad236eb88fb3ddc893d8a9ba6"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 Treat null input channels as zero in AudioChannelsDownMix()   a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293826\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294836\n", "files": ["dom/media/AudioChannelFormat.h"], "git_node": "0ff690769a0b1d1a76cecc3a3b2312f7b89b766b", "git_parents": ["29ad23fc26876c5ab2af0507a39674a080a74c38"], "node": "f296e7a0f0473334511328b3398353af007874ec", "parents": ["163c74119708001aae994f15954f65084d276ed4"], "tags": []}], "date": 1776864479, "git_changesets": ["29ad23fc26876c5ab2af0507a39674a080a74c38", "0ff690769a0b1d1a76cecc3a3b2312f7b89b766b"], "user": "dmeehan@mozilla.com"}, "1206": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 use nullptr for silent up-mix channels  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293827\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294837\n", "files": ["dom/media/AudioSegment.cpp", "dom/media/AudioSegment.h"], "git_node": "43a7f2be6f742e355a5db2341a4e1fe5d5d39ff9", "git_parents": ["0ff690769a0b1d1a76cecc3a3b2312f7b89b766b"], "node": "cf50a6692c63be701e5afb41b93ec6105b3602d2", "parents": ["f296e7a0f0473334511328b3398353af007874ec"], "tags": []}], "date": 1776864736, "git_changesets": ["43a7f2be6f742e355a5db2341a4e1fe5d5d39ff9"], "user": "dmeehan@mozilla.com"}, "1207": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2029067 -  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293180\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295863\n", "files": ["media/libcubeb/frame-sample.patch", "media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb_resampler_internal.h"], "git_node": "364c555e325f6f60c239d68a511d0c31e8a756b8", "git_parents": ["43a7f2be6f742e355a5db2341a4e1fe5d5d39ff9"], "node": "c211d58b4fd65c40bda8062741ccff4ea37cefcf", "parents": ["cf50a6692c63be701e5afb41b93ec6105b3602d2"], "tags": []}], "date": 1776949600, "git_changesets": ["364c555e325f6f60c239d68a511d0c31e8a756b8"], "user": "dmeehan@mozilla.com"}, "1208": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2032236. Update libpng to v1.6.58.  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294539\n", "files": ["media/libpng/ANNOUNCE", "media/libpng/CHANGES", "media/libpng/README", "media/libpng/libpng-manual.txt", "media/libpng/moz.yaml", "media/libpng/png.c", "media/libpng/png.h", "media/libpng/pngconf.h", "media/libpng/pngrtran.c"], "git_node": "377c8570a1fe120de241c6115aa8be7fa8320695", "git_parents": ["364c555e325f6f60c239d68a511d0c31e8a756b8"], "node": "cacd2194ea5e17d4d6f82045a788189079133859", "parents": ["c211d58b4fd65c40bda8062741ccff4ea37cefcf"], "tags": []}], "date": 1776950196, "git_changesets": ["377c8570a1fe120de241c6115aa8be7fa8320695"], "user": "dmeehan@mozilla.com"}, "1209": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "No bug - Bump version to 115.35.1 a=me\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "11b3aab8ba02e6dcd1a3550a5b3d14986e762431", "git_parents": ["945424e4c5a01ce939852c2de9451583d154cd80"], "node": "3f08d5c2b7a376a7a9fde28b56de22ce4cf7684c", "parents": ["037a342d14b5c61767e9ebb540e0a6c1b39cf7b1"], "tags": []}], "date": 1776999170, "git_changesets": ["11b3aab8ba02e6dcd1a3550a5b3d14986e762431"], "user": "dsmith@mozilla.com"}, "1210": {"cha