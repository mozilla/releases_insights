 2031524 - Pass aDst by reference in SwizzleChunkOpaqueCopy  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D294067\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295150\n", "files": ["gfx/2d/Swizzle.cpp"], "git_node": "92ccdc6ce74bc6e1c1e77d2cf9c7bf7dd10a11f4", "git_parents": ["11b3aab8ba02e6dcd1a3550a5b3d14986e762431"], "node": "43d21032f4edb84a3240ba7070739e228d1a4307", "parents": ["3f08d5c2b7a376a7a9fde28b56de22ce4cf7684c"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2022731 - Add namespace checck for esr115  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295213\n", "files": ["gfx/layers/ipc/ImageBridgeParent.cpp", "gfx/webrender_bindings/RenderThread.cpp"], "git_node": "2b42bb03b7d19298275b5bbecd24a6abf82390be", "git_parents": ["92ccdc6ce74bc6e1c1e77d2cf9c7bf7dd10a11f4"], "node": "4feb6cbe6c399fa6f6e5c7466780c0063f574dd1", "parents": ["43d21032f4edb84a3240ba7070739e228d1a4307"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2028231 - Cycle collector integration for JS WeakRefs (ESR115)  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294188\n", "files": ["js/public/friend/CycleCollector.h", "js/src/gc/FinalizationObservers.cpp", "js/src/gc/FinalizationObservers.h", "js/src/gc/GCRuntime.h", "js/src/moz.build", "xpcom/base/nsCycleCollector.cpp"], "git_node": "ac47f9827eb739abdd60a75b396c96edb6a346e5", "git_parents": ["2b42bb03b7d19298275b5bbecd24a6abf82390be"], "node": "41748eaadcc13f1e5dfa4a535d3317856f7e726d", "parents": ["4feb6cbe6c399fa6f6e5c7466780c0063f574dd1"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2027976 - Fix URL deserialization  a=dmeehan\n\nOriginal Revision: https://phabricator