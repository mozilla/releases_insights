06671bd1449", "parents": ["9227a10c57500b7cf1a3a4fb89963a86554afe2d"], "tags": []}], "date": 1776275100, "git_changesets": ["113905c241e193a051566d04006dcb2029fb17e4"], "user": "rvandermeulen@mozilla.com"}, "1181": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1991572 - disable getdisplaymedia.https.html on linux opt for frequent timeouts. r=pehrsons a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294374\n", "files": ["testing/web-platform/meta/screen-capture/getdisplaymedia.https.html.ini"], "git_node": "982df1ac5520d1a05276b9a98d4a0dc48d9c5045", "git_parents": ["113905c241e193a051566d04006dcb2029fb17e4"], "node": "1a80a531759008d32fe9af485c24d623d07ad081", "parents": ["108f6d071ac7e46496721e0fc2f0306671bd1449"], "tags": []}], "date": 1776275137, "git_changesets": ["982df1ac5520d1a05276b9a98d4a0dc48d9c5045"], "user": "rvandermeulen@mozilla.com"}, "1182": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032056: disable esmify mach command r=firefox-build-system-reviewers,jcristau,ahochheiden a=RyanVM\n\nThis mach command relies on `pathlib.os`, which doesn't exist in more recent python versions. As far as I can tell, the only references to esmify are within the tool itself, and the wiring of it into mach. I see no evidence that it's used in automation. I doubt anyone is using the tool locally on this branch.\n\n(This error prevents `./mach try` from working.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294430\n", "files": ["build/mach_initialize.py"], "git_node": "b4b9c4856440981fa136c06cc2ffa42186cbaebf", "git_parents": ["982df1ac5520d1a05276b9a98d4a0dc48d9c5045"], "node": "f916151866717077126ae4fba15b7283e2331c9b", "parents": ["1a80a531759008d32fe9af485c24d623d07ad081"], "tags": []}], "date": 1776275189, "git_changesets": ["b4b9c4856440981fa136c06cc2ffa42186cbaebf"], "user": "rvandermeulen@mozilla.com"}, "1183": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "519b00a7358e382dce4c3947a7e733c59d034d6e", "git_parents": ["b4b9c4856440981fa136c06cc2ffa42186cbaebf"], "node": "d79d9b64e2dd8e2906ea732073ab5e5f33249a44", "parents": ["f916151866717077126ae4fba15b7283e2331c9b"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER"], "git_node": "488d23adabb421e8438ac907054feb08f3c1531d", "git_parents": ["519b00a7358e382dce4c3947a7e733c59d034d6e"], "node": "5d32f9c335deda4ab6cbe90484d86a5985098544", "parents": ["d79d9b64e2dd8e2906ea732073ab5e5f33249a44"], "tags": []}], "date": 1776696534, "git_changesets": ["519b00a7358e382dce4c3947a7e733c59d034d6e", "488d23adabb421e8438ac907054feb08f3c1531d"], "user": "ffxbld@lando.moz.tools"}, "1184": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2028231 - Cycle collector integration for JS WeakRefs (ESR115)  a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294188\n", "files": ["js/public/friend/CycleCollector.h", "js/src/gc/FinalizationObservers.cpp", "js/src/gc/FinalizationObservers.h", "js/src/gc/GCRuntime.h", "js/src/moz.build", "xpcom/base/nsCycleCollector.cpp"], "git_node": "59b031bc9500eba7b36fbbed2a77e257a2cf9933", "git_parents": ["488d23adabb421e8438ac907054feb08f3c1531d"], "node": "1b0f8ee623d26fe9a477fd4df9f97ce3eb5e31bf", "parents": ["5d32f9c335deda4ab6cbe90484d86a5985098544"], "tags": []}], "date": 1776716809, "git_changesets": ["59b031bc9500eba7b36fbbed2a77e257a2cf9933"], "user": "dmeehan@mozilla.com"}, "1185": {"changesets": [{"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029806: Handle ill-formed UTF16  a=dmeehan DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D294527\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294992\n", "files": ["intl/icu-patches/bug-2029806-surrogates.diff", "intl/icu/source/common/ustrcase.cpp"], "git_node": "50388a1d833a3ad16a0dc0f51b19aeca8aa1308c", "git_parents": ["59b031bc9500eba7b36fbbed2a77e257a2cf9933"], "node": "aaee451e34cefa2ec2fa69312948d618d4172228", "parents": ["1b0f8ee623d26fe9a477fd4df9f97ce3eb5e31bf"], "tags": []}], "date": 1776716845, "git_changesets": ["50388a1d833a3ad16a0dc0f51b19aeca8aa1308c"], "user": "dmeehan@mozilla.com"}, "1186": {"changesets": [{"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 Treat null input channels as zero in InterleaveAndConvertBuffer()  a=dmeehan\n\nThe loop nesting is inverted so as not to add a null check to the inner loop,\nbut this change would also have some impact on cache use:\n\n* The loop ordering might perhaps not be the ideal for two channels and large\n  sample counts, for example, because it means going through the\n  output/largest buffer twice.\n\n* It does, however, avoid pathological situations of iterating across planar\n  channel buffers, likely to load set-associative cache lines if the channel\n  buffers are page aligned, due to having 1024 (or somewhat fewer) floats, for\n  example.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293825\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294835\n", "files": ["dom/media/AudioSegment.h"], "git_node": "1fe27350851f1aa2df3f13a6bf36501f6503c2d8", "git_parents": ["50388a1d833a3ad16a0dc0f51b19aeca8aa1308c"], "node": "875f39c4d96f913af4eb7f6c418546b1b2191b95", "parents": ["aaee451e34cefa2ec2fa69312948d618d4172228"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 Treat null input channels as zero in AudioChannelsDownMix()  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293826\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294836\n", "files": ["dom/media/AudioChannelFormat.h"], "git_node": "7e4e400474e422dbed4c48547f45e82ac36d2b2e", "git_parents": ["1fe27350851f1aa2df3f13a6bf36501f6503c2d8"], "node": "00466a685cd676340327bd811adc7ccbe819160f", "parents": ["875f39c4d96f913af4eb7f6c418546b1b2191b95"], "tags": []}, {"author": "Karl Tomlinson \u003ckarlt+@karlt.net\u003e", "branch": "default", "desc": "Bug 2027433 use nullptr for silent up-mix channels  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293827\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294837\n", "files": ["dom/media/AudioSegment.cpp", "dom/media/AudioSegment.h"], "git_node": "9b2830218ac41a43428f031f7fb2f256c858df8d", "git_parents": ["7e4e400474e422dbed4c48547f45e82ac36d2b2e"], "node": "5a3bb5eab8bea81a1275d2e2b3f2537d7019fc38", "parents": ["00466a685cd676340327bd811adc7ccbe819160f"], "tags": []}], "date": 1776717003, "git_changesets": ["1fe27350851f1aa2df3f13a6bf36501f6503c2d8", "7e4e400474e422dbed4c48547f45e82ac36d2b2e", "9b2830218ac41a43428f031f7fb2f256c858df8d"], "user": "dmeehan@mozilla.com"}, "1187": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Revert \"Bug 2027433 use nullptr for silent up-mix channels  a=dmeehan\" for causing build failures\n\nThis reverts commit 9b2830218ac41a43428f031f7fb2f256c858df8d.\n", "files": ["dom/media/AudioSegment.cpp", "dom/media/AudioSegment.h"], "git_node": "02db835dc9cc7a86abd061afe0d34a6c8358c555", "git_parents": ["9b2830218ac41a43428f031f7fb2f256c858df8d"], "node": "4ecb7cf769d3ba205873e331dadd33f239bd5513", "parents": ["