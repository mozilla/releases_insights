illa.com/D292844\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294730\n", "files": ["accessible/base/CachedTableAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp"], "git_node": "a2830fbe814d635ef0517755417d9326c91edebf", "git_parents": ["ddedae41a621d60dd7b8cb2a6d1c50bb55cb9490"], "node": "a3a330d3aa9d08710033c518f6273ef6b4a4d4b0", "parents": ["0a561e74cf08abbf158067d1971382132aa7b16f"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2029700  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D293962\n", "files": ["dom/media/MediaData.cpp", "dom/media/mp3/MP3Demuxer.cpp"], "git_node": "8d2cdef84bc6e27610548af6fe4fbafef456b644", "git_parents": ["a2830fbe814d635ef0517755417d9326c91edebf"], "node": "94d881051a7ee27a39bf7485a34a9bfea466fe85", "parents": ["a3a330d3aa9d08710033c518f6273ef6b4a4d4b0"], "tags": []}], "date": 1777056593, "git_changesets": ["92ccdc6ce74bc6e1c1e77d2cf9c7bf7dd10a11f4", "2b42bb03b7d19298275b5bbecd24a6abf82390be", "ac47f9827eb739abdd60a75b396c96edb6a346e5", "eca1ac6c04d7852cf4d720455c005e965b24d9d5", "4b9abf9b3f79680340924888da06be1d0f75d014", "ddedae41a621d60dd7b8cb2a6d1c50bb55cb9490", "a2830fbe814d635ef0517755417d9326c91edebf", "8d2cdef84bc6e27610548af6fe4fbafef456b644"], "user": "dmeehan@mozilla.com"}, "1214": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2021904 - Clamp aStart and aLength when constructing a SlicedInputStream,  a=dmeehan\n\nThis is a clean-up of previous changes to sliced input stream\nvalidation. This new approach should reduce the burdern on any external\ncallers while maintaining the documented expected behaviour.\n\nIt's OK for us to truncate these lengths, as start and length positions\npast the end of the provided stream have always been documented to be\naccepted, and this preserves the expected behaviour.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293915\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294252\n", "files": ["xpcom/io/SlicedInputStream.cpp", "xpcom/io/SlicedInputStream.h", "xpcom/io/nsICloneableInputStream.idl", "xpcom/tests/gtest/TestSlicedInputStream.cpp"], "git_node": "7efec74ee81ea23ed4c22cbb552cea60b0aad300", "git_parents": ["8d2cdef84bc6e27610548af6fe4fbafef456b644"], "node": "70263507d3d7f2d4a5b1649ee02c798246287a52", "parents": ["94d881051a7ee27a39bf7485a34a9bfea466fe85"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2030111: Skip dispatching ScriptExecutorRunnable again if one has dispatched already.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293094\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294844\n", "files": ["dom/workers/loader/CacheLoadHandler.cpp"], "git_node": "77f7ec7d22b0a5e2cbf9cb49b0c6ff8973ab6957", "git_parents": ["7efec74ee81ea23ed4c22cbb552cea60b0aad300"], "node": "e43a8625c3933d3e456a465c064bcbb9465744bb", "parents": ["70263507d3d7f2d4a5b1649ee02c798246287a52"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2027158: Transition fetch event promise holders to complete before resolving/reject FetchEventOp::mPreloadResponse.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D291301\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294840\n", "files": ["dom/serviceworkers/ServiceWorkerOp.cpp"], "git_node": "ee0962dd01bab614163f396cc9d978473bdbe748", "git_parents": ["77f7ec7d22b0a5e2cbf9cb49b0c6ff8973ab6957"], "node": "52002fd9bc90736b3f44e6d5f086d9288b328771", "parents": ["e43a8625c3933d3e456a465c064bcbb9465744bb"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug