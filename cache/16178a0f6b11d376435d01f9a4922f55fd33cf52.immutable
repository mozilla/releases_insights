ffvpx/libavutil/x86/pixelutils_init.c", "media/ffvpx/libavutil/x86/tx_float.asm", "media/ffvpx/libavutil/x86/tx_float_init.c", "media/ffvpx/libavutil/x86/x86inc.asm", "media/ffvpx/libavutil/x86/x86util.asm", "media/ffvpx/vp9-get-format-rollback.patch"], "git_node": "a8aa07554b4c4f9b5d4740aa7860671ab938a7f4", "git_parents": ["c7525790aabd717b50bf29a793c565a9c8a9503e"], "node": "52d5f071cae2562793d7967676e9f93827a5653e", "parents": ["b927ab3727b38cd272bc154ef37184bc1e6893a6"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2031547 - Continue using av_rdft -\u003e Tx compatibility shim. r=media-playback-reviewers,alwu a=diannaS\n\nSmall changes on the avfft compat shim that we're keeping here (deleted\nupstream), and build system things.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294210\n", "files": ["media/ffvpx/libavcodec/avcodec.symbols", "media/ffvpx/libavcodec/avfft.c", "media/ffvpx/libavcodec/avfft.h", "media/ffvpx/libavcodec/moz.build", "media/ffvpx/libavutil/moz.build", "media/ffvpx/libavutil_visibility.h"], "git_node": "4c5f9b31a63f0f1d134d8f7989ded545595156dd", "git_parents": ["a8aa07554b4c4f9b5d4740aa7860671ab938a7f4"], "node": "749b6d0611daecda843ef8bf1f874899c6307ad8", "parents": ["52d5f071cae2562793d7967676e9f93827a5653e"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "FIREFOX_ESR_115_35_X_RELBRANCH", "desc": "Bug 2031547 - Update gecko so it uses correct headers for our updated ffvpx revision. r=media-playback-reviewers,alwu a=diannaS\n\nAdd dom/media/platforms/ffmpeg/ffmpeg62/include/ with the correct public\nheaders from the vendored ffmpeg 62 source, and update ffvpx/moz.build to\nuse them instead of the old ffmpeg60 headers.\n\nThe ffmpeg60 headers declared fields that were deprecated in ffmpeg 60 and\nfully removed (from both the public headers AND the struct memory) in\nffmpeg 61/62. Summary of changes:\n\n  AVFrame::pkt_duration  -\u003e AVFrame::duration\n  AVFrame::pkt_pos       -\u003e 0 (removed without replacement)\n  AVFrame::key_frame     -\u003e !!(AVFrame::flags & AV_FRAME_FLAG_KEY)\n  AVCodecContext::reordered_opaque -\u003e removed (log as 0 for simplicity)\n  AVCodecContext::channels         -\u003e ch_layout.nb_channels\n  AVCodecContext::channel_layout   -\u003e ch_layout.u.mask\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294211\n\nBug 2031547 - Fix aarch64 and symbol visibility on 115.\n", "files": ["dom/media/platforms/ffmpeg/FFmpegAudioDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegDataDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/ffmpeg62/include/COPYING.LGPLv2.1", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/avcodec.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/avdct.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/avfft.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/bsf.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/codec.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/codec_desc.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/codec_id.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/codec_par.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/defs.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/packet.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavcodec/version_major.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavutil/attributes.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavutil/avconfig.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavutil/avutil.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavutil/buffer.h", "dom/media/platforms/ffmpeg/ffmpeg62/include/libavutil/channel_layo