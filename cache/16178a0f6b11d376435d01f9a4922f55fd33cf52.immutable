, "parents": ["ffafd43cc20bdc16c1df306baa36219449ea3893"], "tags": []}], "date": 1776796078, "git_changesets": ["3861621cd2d27d2b3eab3f2a8ecc223a124ea84d"], "user": "dmeehan@mozilla.com"}, "1199": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2021904 - Clamp aStart and aLength when constructing a SlicedInputStream,  a=dmeehan DONTBUILD\n\nThis is a clean-up of previous changes to sliced input stream\nvalidation. This new approach should reduce the burdern on any external\ncallers while maintaining the documented expected behaviour.\n\nIt's OK for us to truncate these lengths, as start and length positions\npast the end of the provided stream have always been documented to be\naccepted, and this preserves the expected behaviour.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D293915\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294252\n", "files": ["xpcom/io/SlicedInputStream.cpp", "xpcom/io/SlicedInputStream.h", "xpcom/io/nsICloneableInputStream.idl", "xpcom/tests/gtest/TestSlicedInputStream.cpp"], "git_node": "2eb495dda0af7e6f60ee5d2f3cbd5df7f3b1783e", "git_parents": ["3861621cd2d27d2b3eab3f2a8ecc223a124ea84d"], "node": "93cde759a3316adbf5ec00747b9e2ebdecacd0d6", "parents": ["fba7492834177750e4a1fbbe43e25e5129a7b752"], "tags": []}], "date": 1776796121, "git_changesets": ["2eb495dda0af7e6f60ee5d2f3cbd5df7f3b1783e"], "user": "dmeehan@mozilla.com"}, "1200": {"changesets": [{"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2029700 -  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D292516\n\nDifferential Revision: https://phabricator.services.mozilla.com/D293962\n", "files": ["dom/media/MediaData.cpp", "dom/media/mp3/MP3Demuxer.cpp"], "git_node": "7e431382a72c6b6c658f84fcf1e3ffdc8c0039e5", "git_parents": ["2eb495dda0af7e6f60ee5d2f3cbd5df7f3b1783e"], "node": "55e84ee3b2b2a868c74c09f2ef2ded0acb9fb974", "parents"