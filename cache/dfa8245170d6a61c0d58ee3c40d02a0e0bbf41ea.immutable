es": ["docshell/base/nsDocShell.cpp", "dom/base/test/browser.toml", "dom/base/test/browser_object_attachment.js", "dom/base/test/file_html_attachment.html", "dom/base/test/file_html_attachment.html^headers^", "dom/base/test/file_html_object_attachment.html", "dom/base/test/file_svg_attachment.svg", "dom/base/test/file_svg_attachment.svg^headers^", "dom/base/test/file_svg_object_attachment.html", "uriloader/base/nsIURILoader.idl", "uriloader/base/nsURILoader.cpp"], "git_node": "1116752e9dcce9cef0ab9a6e952db0792450b45d", "git_parents": ["a376255706d166d3f79745696c8314ff4a135911"], "node": "71840e2d895c575655288a0cd4f4919fdf3a93e1", "parents": ["72387d5f3e322527b07ee30d2992bdf96b7bca14"], "tags": []}], "date": 1750089344, "git_changesets": ["1116752e9dcce9cef0ab9a6e952db0792450b45d"], "user": "dmeehan@mozilla.com"}, "570": {"changesets": [{"author": "DonalMe \u003c76789979+DonalMe@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1971140 - (ESR) lint fix a=me\n", "files": ["dom/base/test/browser_object_attachment.js"], "git_node": "92fffa1b27ea6c54039606b57e146e6911b27878", "git_parents": ["1116752e9dcce9cef0ab9a6e952db0792450b45d"], "node": "a98c755773564d7fa040171c18f57259e05f3a56", "parents": ["71840e2d895c575655288a0cd4f4919fdf3a93e1"], "tags": []}], "date": 1750091278, "git_changesets": ["92fffa1b27ea6c54039606b57e146e6911b27878"], "user": "dmeehan@mozilla.com"}, "571": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1972388 - Fix flaky check in browser_object_attachment  a=dmeehan\n\nThis check was failing intermittently due to some differences in how\ncontent handling failures are handled on ESR. As ESR does not have bug\n1918167, we don't cancel the channel in the parent before redirecting to\nthe content process, meaning we create a temporary unnecessary\nBrowsingContext.\n\nThis makes the check use waitForCondition, so that we wait for the\nunnecessary BC to go away before proceeding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253868\n", "files": ["dom/base/test/browser_object_attachment.js"], "git_node": "81bc6445453059d2323e9b71bd09623ad12ddc56", "git_parents": ["92fffa1b27ea6c54039606b57e146e6911b27878"], "node": "f3f836bf735d55fcfdf97dd3788f7952419dea1f", "parents": ["a98c755773564d7fa040171c18f57259e05f3a56"], "tags": ["FIREFOX_128_12_0esr_BUILD1", "FIREFOX_128_12_0esr_RELEASE"]}], "date": 1750100403, "git_changesets": ["81bc6445453059d2323e9b71bd09623ad12ddc56"], "user": "dmeehan@mozilla.com"}}
}";