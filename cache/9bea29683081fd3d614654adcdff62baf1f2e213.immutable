necrl.json", "toolkit/components/certviewer/content/components/logNameTable.mjs"], "git_node": "95c6d0e6cc05a834240509a586c5ebc76d8336bf", "git_parents": ["c318e3511672a445f5e218f7c6360189de329924"], "node": "a33888d108be5e600acb61ec67056dcc2af98388", "parents": ["0543c9cf6f2ca98bc5361ba518db0b3a8e0e3fc7"], "tags": []}], "date": 1794236969, "git_changesets": ["95c6d0e6cc05a834240509a586c5ebc76d8336bf"], "user": "dsmith@mozilla.com"}, "1207": {"changesets": [{"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034013 - Show search bar form history when remote search suggestions are disabled.  a=diannaS DONTBUILD\n\n`browser.search.suggest.enabled` turns off remote search suggestions. The\nold search bar kept showing form history when it was off; the new one,\nbuilt on urlbar code, adopted the urlbar's stricter reading of the pref\nand suppressed form history too.\n\nThe behavior change is scoped to the searchbar SAP, so the urlbar (where\nthe pref does gate both kinds of suggestion) is unaffected. Remote\nsuggestions stay off in the search bar as well, since\n`SearchSuggestionController` checks the pref itself before fetching them.\n\nThis also restores form history in private windows, where\n`browser.search.suggest.enabled.private` defaults to false and was\nsuppressing the search bar's suggestions entirely.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D316300\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339893\n", "files": ["browser/components/urlbar/UrlbarProviderSearchSuggestions.sys.mjs", "browser/components/urlbar/tests/unit/test_UrlbarProviderSearchSuggestions.js", "browser/components/urlbar/tests/unit/test_search_suggestions.js"], "git_node": "874553b88e0001cc5eae88cd0501dbed9ae5b9fd", "git_parents": ["95c6d0e6cc05a834240509a586c5ebc76d8336bf"], "node": "7428ac666461ec86f07a84cb6e24459264d60692", "parents": ["a33888d108be5e600acb61ec67056dcc2af98388"], "tags": []}], "date": 1794260745, "git_changesets": ["874553b88e0001cc5eae88cd0501dbed9ae5b9fd"], "user": "dsmith@mozilla.com"}, "1208": {"changesets": [{"author": "Janika \u003cjneuberger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2017105 - Change binary tree of CombinedProviders to one single provider instance  a=diannaS DONTBUILD\n\n- Add a PoliciesProvider base class holding the shared _policies/_failed state\n  and the policies/hasPolicies/failed getters\n- Rework CombinedProvider to hold an ordered list of providers. Providers are\n  pushed lowest-to-highest precedence and mergePolicies() combines their\n  top-level policies\n- CombinedProvider.failed reports failure only when a provider failed and the\n  merge produced no usable policies. (This preserves the previous behavior where\n  a missing or broken policies.json does not fail the engine as long as the\n  platform provider (GPO/plist) supplied policies, while a broken JSON file on\n  its own still moves the engine to the FAILED state.)\n- Rename _chooseProvider to _buildProvider: it always builds a single\n  CombinedProvider, pushing the JSON provider first and the platform provider\n  (if any) last, preserving the existing \"platform overrides JSON\" behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308806\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339568\n", "files": ["toolkit/components/enterprisepolicies/EnterprisePoliciesParent.sys.mjs", "toolkit/components/enterprisepolicies/tests/xpcshell/test_combined_provider_precedence.js", "toolkit/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "866562c858b1c7caec02ac9e03217f016c92d8a5", "git_parents": ["874553b88e0001cc5eae88cd0501dbed9ae5b9fd"], "node": "c7fb2e7244a0d2f384fd7996443febbfc7740c45", "parents": ["7428ac666461ec86f07a84cb6e24459264d60692"], "tags": []}], "date": 1794260768, "git_changesets": ["866562c858b1c7caec02ac9e03217f016c92d8a5"], "user": "dsmith@mozilla.com"}, "1209": {"changesets": [{"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2074651: Normalize URIs before checking against site policies.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D328555\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340038\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies.js", "toolkit/components/enterprisepolicies/PoliciesHelpers.sys.mjs", "toolkit/components/enterprisepolicies/SitePolicyUtils.sys.mjs"], "git_node": "3e338aa794a557f3e1033d4c97de29a97be34a08", "git_parents": ["866562c858b1c7caec02ac9e03217f016c92d8a5"], "node": "87c5071bb3bccf13f39e2f539ed79cd7ba1c9581", "parents": ["c7fb2e7244a0d2f384fd7996443febbfc7740c45"], "tags": []}], "date": 1794260923, "git_changesets": ["3e338aa794a557f3e1033d4c97de29a97be34a08"], "user": "dsmith@mozilla.com"}, "1210": {"changesets": [{"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077760 - Don't transfer APZTestData to the new APZCTreeManager on layer tree adoption.  a=diannaS DONTBUILD\n\nThe transfer was only kept to preserve the behavior from before bug 1441916,\nwhen the test data was stored per layers id in the compositor.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D330638\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339280\n", "files": ["gfx/layers/apz/src/APZCTreeManager.cpp"], "git_node": "0b1bd23d1da2ffa977da87539fc7d782cea57194", "git_parents": ["3e338aa794a557f3e1033d4c97de29a97be34a08"], "node": "dfcde1a610b19a68962e85fcd0b424712e20bbbd", "parents": ["87c5071bb3bccf13f39e2f539ed79cd7ba1c9581"], "tags": []}], "date": 1794261068, "git_changesets": ["0b1bd23d1da2ffa977da87539fc7d782cea57194"], "user": "dsmith@mozilla.com"}, "1211": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083648 - Fix register encoding when relocating RIP-relative instructions into x64 trampolines.  a=diannaS DONTBUILD\n\nThe relocation of REX-prefixed RIP-relative MOV and LEA ignored REX.R and\nkept the original REX byte, so e.g. `mov r10, [rip+x]` loaded into rdx\ninstead. It also turned RIP-relative stores into loads and emitted invalid\nencodings for rsp/rbp/r12/r13. RIP-relative stores and loads into rsp are\nnow refused instead, as they would require saving a scratch register on\nthe stack or moving rsp to an arbitrary address.\n\nThis also fixes the jump type detection for REX.W `jmp/call [rip+x]`, which\nread a displacement byte instead of the ModR/M byte, refuses the `40 38`\ncmp path for spl because it pushes r11 first, computes the length of `xor`\ninstructions with memory operands correctly, and computes the address of\n`cmp byte ptr [rip+x], imm8` from the end of the instruction rather than\nfrom the end of the displacement.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335129\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336350\n", "files": ["toolkit/xre/dllservices/mozglue/interceptor/PatcherDetour.h"], "git_node": "42965738be415af3986d6399ca438bad0199b3a6", "git_parents": ["0b1bd23d1da2ffa977da87539fc7d782cea57194"], "node": "702a4bd8c95843620915c8d0336a41be240e0e27", "parents": ["dfcde1a610b19a68962e85fcd0b424712e20bbbd"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2083648 - Test relocation of RIP-relative instructions into x64 trampolines.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335130\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336351\n", "files": ["toolkit/xre/dllservices/tests/AssemblyPayloads.h", "toolkit/xre/dllservices/tests/TestDllInterceptor.cpp"], "git_node": "45a0875fbfa321d96ba387f4fe1a808786da7a6e", "git_parents": ["42965738be415af3986d6399ca438bad0199b3a6"], "node": "4d1e082edd0199fea9a18397606b32871b8f11e4", "parents": ["702a4bd8c95843620915c8d0336a41be240e0e27"], "tags": []}], "date": 1794261103, "git_changesets": ["42965738be415af3986d6399ca438bad0199b3a6", "45a0875fbfa321d96ba387f4fe1a808786da7a6e"], "user": "dsmith@mozilla.com"}, "1212": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059824 - [esr153] Make gfxUserFontEntry retain ownership of webfont data after sanitization.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339718\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/2d/NativeFontResourceFreeType.cpp", "gfx/2d/NativeFontResourceFreeType.h", "gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/CoreTextFontList.h", "gfx/thebes/FontData.h", "gfx/thebes/gfxDWriteCommon.cpp", "gfx/thebes/gfxDWriteCommon.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2FontBase.h", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "gfx/thebes/gfxPlatformFontList.h", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h", "gfx/thebes/moz.build", "layout/style/nsFontFaceLoader.cpp"], "git_node": "88bb1a62f0d31d6d77a99d5a9a9b0d8f7ed6bb29", "git_parents": ["45a0875fbfa321d96ba387f4fe1a808786da7a6e"], "node": "0227c525d41524f98e4ed3753de47cc221925821", "parents": ["4d1e082edd0199fea9a18397606b32871b8f11e4"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082289 - [esr153] Strip shaping tables from font data passed to FreeType.  a=diannaS\n\nAlso includes the followup change from bug 2088170, which addresses\nthe perf regression reported when this first landed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339719\n", "files": ["gfx/2d/RecordedEventImpl.h", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxOTSUtils.h"], "git_node": "9606e340395a2ec2926806db077c491ba94c802d", "git_parents": ["88bb1a62f0d31d6d77a99d5a9a9b0d8f7ed6bb29"], "node": "64f56ba6e329c93f554aa73b7ec5c5a818f0cca1", "parents": ["0227c525d41524f98e4ed3753de47cc221925821"], "tags": []}], "date": 1794261134, "git_changesets": ["88bb1a62f0d31d6d77a99d5a9a9b0d8f7ed6bb29", "9606e340395a2ec2926806db077c491ba94c802d"], "user": "dsmith@mozilla.com"}, "1213": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059824 - [esr153] Fix trailing whitespace. a=diannaS DONTBUILD\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/thebes/FontData.h", "gfx/thebes/gfxUserFontSet.cpp"], "git_node": "6ac367dbf2d64bafe6272367c416e7bea528ad29", "git_parents": ["9606e340395a2ec2926806db077c491ba94c802d"], "node": "b71bb8389f8682cdc7314ad42b0df527183dbbdb", "parents": ["64f56ba6e329c93f554aa73b7ec5c5a818f0cca1"], "tags": []}], "date": 1794263732, "git_changesets": ["6ac367dbf2d64bafe6272367c416e7bea528ad29"], "user": "dsmith@mozilla.com"}, "1214": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 07da6c6c016add6f8270a4ac0e53320df73b1b1c with FIREFOX_115_45_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4eed3f14bcf019692ef7ae12bdb569a4b34ab082", "git_parents": ["7ecd1c547f4afb15116d5b6c31ed62146d5440d6"], "node": "6543a077657d77a567a18c8214e7ddcb5e6d20cb", "parents": ["366299066b92042a8d9f0c18587a4dfedb950545"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 657ad591b45ac92fe08af8ab81307ff4d548ed4d with FIREFOX-ANDROID_160_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "01352a7bdedadc3bd261351a7