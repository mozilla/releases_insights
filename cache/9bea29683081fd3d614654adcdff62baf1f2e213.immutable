rents": ["9aecd40e03ebf6e866e32a0a3001488ed751228d"], "node": "74e2f5e052c3e62be83490d8cc3ac707746f82eb", "parents": ["a9effd9e521653405f0ffd311e8edf90bde92237"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER"], "git_node": "0122a4d8eccfbb742d45c051119073f1970cbc65", "git_parents": ["85f6ddb75d017db0d18927bc67bbfd312c374caf"], "node": "caf444c1f83f7d452b147b1bd904d1dbd66ad35f", "parents": ["74e2f5e052c3e62be83490d8cc3ac707746f82eb"], "tags": []}], "date": 1793880541, "git_changesets": ["85f6ddb75d017db0d18927bc67bbfd312c374caf", "0122a4d8eccfbb742d45c051119073f1970cbc65"], "user": "ffxbld@lando.moz.tools"}, "1193": {"changesets": [{"author": "Jonatan Wallmander \u003cjonatan.wallmander@kdab.com\u003e", "branch": "default", "desc": "Bug 2059187 - Default-initialize padding bytes in Limits  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338767\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339416\n", "files": ["dom/canvas/WebGLTypes.h"], "git_node": "3a495f1abb9cd79af7d503890b34a0829e1304cc", "git_parents": ["0122a4d8eccfbb742d45c051119073f1970cbc65"], "node": "8d696e2a63b345cfac03b5572025ad3a5c9296a1", "parents": ["caf444c1f83f7d452b147b1bd904d1dbd66ad35f"], "tags": []}], "date": 1793974600, "git_changesets": ["3a495f1abb9cd79af7d503890b34a0829e1304cc"], "user": "pchevrel@mozilla.com"}, "1194": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067925 - Clear ImageBridgeParent's about-to-send flag after flushing async messages.  a=pascalc\n\nThe flag was never reset after the first transaction, so NotifyNotUsed\nmessages generated outside of a transaction (e.g. on ReleaseCompositable)\nwere queued until the next transaction on that bridge. If none came, the\ncontent process kept the textures alive indefinitely, along with the\ndecoded frames they reference in the RDD process.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336297\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338092\n", "files": ["gfx/layers/ipc/ISurfaceAllocator.h", "gfx/layers/ipc/ImageBridgeParent.cpp"], "git_node": "40bc3bb9dd2ebe15b6d2071d23d569efdeb81413", "git_parents": ["3a495f1abb9cd79af7d503890b34a0829e1304cc"], "node": "a086b0a045999a56d113c12cdaeedeb3f1eece6c", "parents": ["8d696e2a63b345cfac03b5572025ad3a5c9296a1"], "tags": []}], "date": 1793974643, "git_changesets": ["40bc3bb9dd2ebe15b6d2071d23d569efdeb81413"], "user": "pchevrel@mozilla.com"}, "1195": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025335 - Clear the BoundStorageKeyChild listener synchronously in StartDestroyFromListener.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335161\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336719\n", "files": ["dom/cache/BoundStorageKeyChild.cpp"], "git_node": "6272bc5502cc5813ef3e999d1155384a60597e76", "git_parents": ["40bc3bb9dd2ebe15b6d2071d23d569efdeb81413"], "node": "faf1c7f99e14a56f2b5d866e8256e42be65104c8", "parents": ["a086b0a045999a56d113c12cdaeedeb3f1eece6c"], "tags": []}], "date": 1793975015, "git_changesets": ["6272bc5502cc5813ef3e999d1155384a60597e76"], "user": "pchevrel@mozilla.com"}, "1196": {"changesets": [{"author": "Nicolas Silva \u003cnical@fastmail.com\u003e", "branch": "default", "desc": "Bug 2083091 - Sanity-check the upload stride.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D335713\n\nDifferential Revision: https://phabricator.services.mozilla.com/D336651\n", "files": ["gfx/wr/webrender/src/renderer/upload.rs"], "git_node": "86d352259c3854518dbc9d41237197015625b276", "git_parents": ["6272bc5502cc5813ef3e999d1155384a60597e76"], "node": "4ba53b662592c1e755232c370a578be9db3f677b", "parents": ["faf1c7f99e14a56f2b5d866e8256e42be65104c8"], "tags": []}], "date": 1793975037, "git_changesets": ["86d352259c3854518dbc9d41237197015625b276"], "user": "pchevrel@mozilla.com"}, "1197": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2083772 - Make `AutoClonedRangeArray::RemoveCollapsedRanges` optionally preserve the primary range even when all ranges are collapsed  a=pascalc\n\nWe don't know how to reproduce the crash of bug 2083772. So, returning\nerror in the case may break some web apps. Therefore, let's try to\nkeep handling with the anchor-focus range even if all ranges are\ncollapsed with normalizing the white-spaces.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336962\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337354\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/AutoClonedRangeArray.h", "editor/libeditor/HTMLEditorDeleteHandler.cpp"], "git_node": "8c6e710fba272e468683c7dc244a1e17ec07f7a8", "git_parents": ["86d352259c3854518dbc9d41237197015625b276"], "node": "f1413b4cb725927e587cd6bc3179c2c7bf95b306", "parents": ["4ba53b662592c1e755232c370a578be9db3f677b"], "tags": []}], "date": 1793975058, "git_changesets": ["8c6e710fba272e468683c7dc244a1e17ec07f7a8"], "user": "pchevrel@mozilla.com"}, "1198": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1728612 - Complete pending MediaSource transactions in MediaSource::Detach.  a=pascalc\n\nHTMLMediaElement::ShutdownDecoder only resolved the MediaSource's pending\ncompletion promises if the element still held mMediaSource. If the element\nwas unlinked by the cycle collector, mMediaSource was cleared while the\nMediaSourceDecoder still referenced the MediaSource, so MediaSource::Detach\nwould hit the release assert on mCompletionPromises being empty. Instead,\nhave MediaSource::Detach complete the pending transactions itself. Also do\nso in the destructor, in case the MediaSource is destroyed before it could\nbe detached.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334373\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338085\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediasource/MediaSource.cpp"], "git_node": "72757b1393a7cf8cedc2bceec279e19ca33d8ba0", "git_parents": ["8c6e710fba272e468683c7dc244a1e17ec07f7a8"], "node": "16e8bb90c66b204eb9fc95eab88de92a3093363c", "parents": ["f1413b4cb725927e587cd6bc3179c2c7bf95b306"], "tags": []}], "date": 1793975078, "git_changesets": ["72757b1393a7cf8cedc2bceec279e19ca33d8ba0"], "user": "pchevrel@mozilla.com"}, "1199": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2082697 - Only reject the AppleVTDecoder decode promise if it still exists.  a=pascalc\n\nThe VideoToolbox output callback may resolve the decode promise at any time,\nso it may already have been settled when we try to reject it, e.g. when a flush\nraces with the callback, or when the callback fails to output a frame while no\ndecode is pending. This matches the other paths which already use\nRejectIfExists.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334349\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338086\n", "files": ["dom/media/platforms/apple/AppleVTDecoder.cpp"], "git_node": "06f1daabfc7ddf6552aaa57de9b124512f72a78a", "git_parents": ["72757b1393a7cf8cedc2bceec279e19ca33d8ba0"], "node": "af294a09b3bbb6600ce2181731771fe5e132f7dd", "parents": ["16e8bb90c66b204eb9fc95eab88de92a3093363c"], "tags": []}], "date": 1793975099, "git_changesets": ["06f1daabfc7ddf6552aaa57de9b124512f72a78a"], "user": "pchevrel@mozilla.com"}, "1200": {"changesets": [{"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 - Pass the profile dir to ping cleanup  a=pascalc\n\nThis is a partial change taken from\nhttps://phabricator.services.mozilla.com/D323814 to enable uplift.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337252\n", "files": ["toolkit/components/crashes/CrashManager.in.sys.mjs", "toolkit/crashreporter/client/app/src/send_ping.rs"], "git_node": "64e1abdc7853894819a85f198de9a7c0d6002ac8", "git_parents": ["06f1daabfc7ddf6552aaa57de9b124512f72a78a"], "node": "3debde14a905c9c2087c5ecef6ba6a730eb4efe9", "parents": ["af294a09b3bbb6600ce2181731771fe5e132f7dd"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 p1 - Add the `prefs` module for unified prefs handling  a=pascalc\n\nThis replaces the `prefs_parser` module.\n\nThe `Prefs` type will look for a set of prefs relevant to the program\nand aggregate values as prefs files are loaded. This consolidates code\nfrom the `langpack` and `glean` modules. It is intended to be\nfunctionally equivalent to the existing prefs loading. Improvements are\nin following patches.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333401\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337253\n", "files": ["toolkit/crashreporter/client/app/src/config.rs", "toolkit/crashreporter/client/app/src/glean.rs", "toolkit/crashreporter/client/app/src/lang/langpack.rs", "toolkit/crashreporter/client/app/src/lang/mod.rs", "toolkit/crashreporter/client/app/src/main.rs", "toolkit/crashreporter/client/app/src/prefs/mod.rs", "toolkit/crashreporter/client/app/src/prefs/parser.rs", "toolkit/crashreporter/client/app/src/prefs_parser.rs", "toolkit/crashreporter/client/app/src/send_ping.rs", "toolkit/crashreporter/client/app/src/std/path.rs"], "git_node": "21ce6aba3bc7e8d5844e55590fe1909f8e468d6f", "git_parents": ["64e1abdc7853894819a85f198de9a7c0d6002ac8"], "node": "5e23b7171cb9e845b6e9fa8eac1169f323c34201", "parents": ["3debde14a905c9c2087c5ecef6ba6a730eb4efe9"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 p2 - Load user.js prefs  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334738\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337254\n", "files": ["toolkit/crashreporter/client/app/src/prefs/mod.rs"], "git_node": "ffc87b30ac796e6aa30d0208bb53515c0c2d6d87", "git_parents": ["21ce6aba3bc7e8d5844e55590fe1909f8e468d6f"], "node": "cf10e4655ea56e03402c1a9e35e5d5aa273a5ced", "parents": ["5e23b7171cb9e845b6e9fa8eac1169f323c34201"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 p3 - Support the standard prefs directories  a=pascalc\n\nPrefs files are read in prefs directories in reverse-alphabetical order.\nThe order of directories here matches the order in which Firefox loads\nthem.\n\nThis adds support to the prefs parser for other prefs \"functions\". User\npref files are supposed to only have `user_pref`, but default pref files\ncan have the others.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334739\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337255\n", "files": ["toolkit/crashreporter/client/app/src/config.rs", "toolkit/crashreporter/client/app/src/prefs/mod.rs", "toolkit/crashreporter/client/app/src/prefs/parser.rs", "toolkit/crashreporter/client/app/src/send_ping.rs", "toolkit/crashreporter/client/app/src/std/fs.rs", "toolkit/crashreporter/client/app/src/std/path.rs"], "git_node": "11e07a8e699109ab43491caed7bb74de751c24de", "git_parents": ["ffc87b30ac796e6aa30d0208bb53515c0c2d6d87"], "node": "372a24807230618ea58fe8030bd3c704dffbd550", "parents": ["cf10e4655ea56e03402c1a9e35e5d5aa273a5ced"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070693 p4 - Support flatpak and debian prefs directories  a=pascalc\n\nThis fixes the case described in the bug.\n\nThe `mocked_static!` macro was modified in a minor way to explicitly\nindicate the mocked value. This is used in the flatpak detection static\nvalue.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334741\n\nDifferential Revision: https://phabricator.services.mozilla.com/D337256\n", "files": ["toolkit/crashreporter/client/app/src/config.rs", "toolkit/crashreporter/client/app/src/net/http.rs", "toolkit/crashreporter/client/app/src/prefs/mod.rs", "toolkit/crashreporter/client/app/src/std/mock.rs", "toolkit/crashreporter/client/app/src/std/mock_stub.rs"], "git_node": "b42dbd8b5ed1e5e4167fdd87ef4ebf3d61254414", "git_parents": ["11e07a8e699109ab43491caed7bb74de751c24de"], "node": "8c275adc31756f33d62e0a824cb852495de03db6", "parents": ["372a24807230618ea58fe8030bd3c704dffbd550"], "tags": []}], "date": 1793975264, "git_changesets": ["64e1abdc7853894819a85f198de9a7c0d6002ac8", "21ce6aba3bc7e8d5844e55590fe1909f8e468d6f", "ffc87b30ac796e6aa30d0208bb53515c0c2d6d87", "11e07a8e699109ab43491caed7bb74de751c24de", "b42dbd8b5ed1e5e4167fdd87ef4ebf3d61254414"], "user": "pchevrel@mozilla.com"}, "1201": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074218 - Remove BrowsingContexts from the BrowserId map under the key they were added with.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D334046\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339164\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/test/browser/browser.toml", "docshell/test/browser/browser_browsingContext-getCurrentTopByBrowserId.js"], "git_node": "d31d606afafda84917d02d3c4bd1137dbbc9208e", "git_parents": ["b42dbd8b5ed1e5e4167fdd87ef4ebf3d61254414"], "node": "093563b0af4c5fc92f7d4aecb06badbf8d84a9aa", "parents": ["8c275adc31756f33d62e0a824cb852495de03db6"], "tags": []}], "date": 1793975340, "git_changesets": ["d31d606afafda84917d02d3c4bd1137dbbc9208e"], "user": "pchevrel@mozilla.com"}, "1202": {"changesets": [{"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2086342: Install hg-evolve from PyPI instead of cloning it r=firefox-build-system-reviewers,glandium a=pascalc\n\ndocker-image-updatebot keeps failing on the evolve clone: repo.mercurial-scm.org\noften returns incomplete responses, and foss.heptapod.net, which main switched\nto in bug 2082468, has returned 504s and once hung for two hours. Install the\nextension from PyPI instead, pinned by hash. The wheel's files match the 12.0.0\ntag that the image was already using.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D338499\n", "files": ["taskcluster/docker/updatebot/Dockerfile", "taskcluster/docker/updatebot/evolve-requirements.txt", "taskcluster/docker/updatebot/hgrc", "taskcluster/docker/updatebot/privileged-setup.sh", "taskcluster/docker/updatebot/setup.sh"], "git_node": "3650d4ab2efe93ae2448054a13d6cae51f66688d", "git_parents": ["d31d606afafda84917d02d3c4bd1137dbbc9208e"], "node": "f496d99da903f045b354f94605f058fa2d0093c9", "parents": ["093563b0af4c5fc92f7d4aecb06badbf8d84a9aa"], "tags": []}], "date": 1793975391, "git_changesets": ["3650d4ab2efe93ae2448054a13d6cae51f66688d"], "user": "pchevrel@mozilla.com"}, "1203": {"changesets": [{"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2079258 - refactor(webgpu): simplify `Buffer::Cleanup`  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336159\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339071\n", "files": ["dom/webgpu/Buffer.cpp"], "git_node": "ca54864c2dcd43316feea2680b745c74d322db9c", "git_parents": ["3650d4ab2efe93ae2448054a13d6cae51f66688d"], "node": "59724b610ecf9c3e37b0c9df937a5946a09a09fb", "parents": ["f496d99da903f045b354f94605f058fa2d0093c9"], "tags": []}], "date": 1793975460, "git_changesets": ["ca54864c2dcd43316f