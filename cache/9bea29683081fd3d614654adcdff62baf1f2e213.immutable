c6d500b28dd974", "git_parents": ["67b4be2d11622cc5c6570320ac33f5c51b566260"], "node": "1e240407a451dbe4fc1f98be44ca7fb485b62f62", "parents": ["0403229212ed85ebbd127d4f2a150697044dbf62"], "tags": []}], "date": 1794561556, "git_changesets": ["7202fe17aa9b207c543f7467d5c6d500b28dd974"], "user": "pchevrel@mozilla.com"}, "1235": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2090902.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340885\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341038\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "4a21e46b73c7ce90430b1d36dd6fc45b31d9390f", "git_parents": ["7202fe17aa9b207c543f7467d5c6d500b28dd974"], "node": "5c65fb51d6e204fc657a0850836d77cefab43d3d", "parents": ["1e240407a451dbe4fc1f98be44ca7fb485b62f62"], "tags": []}], "date": 1794561578, "git_changesets": ["4a21e46b73c7ce90430b1d36dd6fc45b31d9390f"], "user": "pchevrel@mozilla.com"}, "1236": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2085481 - Serialize the cache-entry check with cancel  a=pascalc DONTBUILD\n\nOnCacheEntryCheck can run on the cache I/O thread and write the cached state\n(alt-data type, cached response head, cache input stream) while a cancel's\nAsyncAbort reads it on the main thread.  Set mCanceled under mCacheWaitLock so\nan in-flight check finishes first, and decline any later check.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340727\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340941\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h"], "git_node": "44714fbc0bf605c62a46a04f65a118bec9080f3c", "git_parents": ["4a21e46b73c7ce90430b1d36dd6fc45b31d9390f"], "node": "269cb3c7f390ec42a4711c0c82d8104d0f04521d", "parents": ["5c65fb51d6e204fc657a0850836d77cefab43d3d"], "tags": []}], "date": 1794561704, "git_changesets": ["44714fbc0bf605c62a46a04f65a118bec9080f3c"], "user": "pchevrel@mozilla.com"}, "1237": {"changesets": [{"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079465 - Keep an invalid trailer at the end of cache entry files while their data is being written.  a=pascalc DONTBUILD\n\nData writes and truncations put an 8-byte trailer, whose offset word is past\nthe end of any file, after the end of the file; the metadata write truncates it\naway.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340568\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340939\n", "files": ["netwerk/cache2/CacheFileIOManager.cpp", "netwerk/cache2/CacheFileIOManager.h"], "git_node": "748ddf18086a6c44519bff91c53d5ce8d4b45788", "git_parents": ["44714fbc0bf605c62a46a04f65a118bec9080f3c"], "node": "094b12573e1f0605a8c38f52edb05d4747f367f9", "parents": ["269cb3c7f390ec42a4711c0c82d8104d0f04521d"], "tags": []}], "date": 1794561727, "git_changesets": ["748ddf18086a6c44519bff91c53d5ce8d4b45788"], "user": "pchevrel@mozilla.com"}, "1238": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090147 - Clean up after failure within BuildTextRunsScanner::FlushFrames.  a=pascalc DONTBUILD\n\nAlso adds some checks in MergeCharactersInTextRun for extra robustness.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D340999\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341423\n", "files": ["layout/generic/nsTextFrame.cpp", "layout/generic/nsTextRunTransformations.cpp"], "git_node": "4bfbcd492610a5015a4c87602f0998615b245229", "git_parents": ["748ddf18086a6c44519bff91c53d5ce8d4b45788"], "node": "530f0ab3e52ebbcd4f2d81be343156c18665fe7b", "parents": ["094b12573e1f0605a8c38f52edb05d4747f367f9"], "tags": []}], "date": 1794561748, "git_changesets": ["4bfbcd492610a5015a4c87602f0998615b245229"], "user": "pchevrel@mozilla.com"}, "1239": {"changesets": [{"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044364 - Wrap secondName in PopupNotifications like name.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337112\n\nDifferential Revision: https://phabricator.services.mozilla.com/D341353\n", "files": ["browser/base/content/test/popupNotifications/browser.toml", "browser/base/content/test/popupNotifications/browser_popupNotification_long_origin.js", "toolkit/content/widgets/popupnotification.js", "toolkit/themes/shared/popupnotification.css"], "git_node": "a939129970d0586382b8f8dec3f4ded62310e38e", "git_parents": ["4bfbcd492610a5015a4c87602f0998615b245229"], "node": "540fc7c3442ab534a84ed4657fbb187b4bc8dde3", "parents": ["530f0ab3e52ebbcd4f2d81be343156c18665fe7b"], "tags": []}], "date": 1794561772, "git_changesets": ["a939129970d0586382b8f8dec3f4ded62310e38e"], "user": "pchevrel@mozilla.com"}, "1240": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2087787 - Avoid duplicate outer dependency handling for a given anchor.  a=pascalc\n\nThis is the kind of dedup the original version of the patch was trying\nto do but at what I think is a better place (that also doesn't depend on\nrule placement), and without the correctness error that it introduced.\n\nThe WPT covers that correctness issue (passes both with and without the\npatch).\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338722\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340299\n", "files": ["servo/components/style/invalidation/element/relative_selector.rs", "testing/web-platform/tests/css/selectors/invalidation/has-shared-argument-multiple-rules.html"], "git_node": "4c9981a1d2c297dbc1e01bd9eef0da762b94a3ef", "git_parents": ["a939129970d0586382b8f8dec3f4ded62310e38e"], "node": "fe621b02fa193fbaee1851a390c6092ef23d6d16", "parents": ["540fc7c3442ab