": ["65e9d250971e0de562319754f96a161576cdf339"], "node": "ce9549362989c7f2a51e3e1e74349d34290d4eae", "parents": ["0ad65749232bafd98f028fac214d9b9dcb00b6dd"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging d84e7a6936554efe26097d9d9b24a0e11330e630 with FIREFOX_160_0_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "968cf760b27e02318ce79fe6e567e77a873e1a5e", "git_parents": ["d969d8ff7dc7d2aef7ba8b339b6d1d5cb75efce7"], "node": "de650639e1818af429c0fc2677c76898fac897b7", "parents": ["ce9549362989c7f2a51e3e1e74349d34290d4eae"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 07da6c6c016add6f8270a4ac0e53320df73b1b1c with FIREFOX_115_45_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "3311bf31e72bca1416963ff90ac5c635f39d0407", "git_parents": ["968cf760b27e02318ce79fe6e567e77a873e1a5e"], "node": "488194b303066e73766448d2eccf83068c4ae773", "parents": ["de650639e1818af429c0fc2677c76898fac897b7"], "tags": []}, {"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a9effd9e521653405f0ffd311e8edf90bde92237 with FIREFOX_153_7_0esr_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a539e6f42b0f18f00f3bcaa502d2346d960d28d1", "git_parents": ["3311bf31e72bca1416963ff90ac5c635f39d0407"], "node": "88991233cd0852cc76736201ab81c73026612c1b", "parents": ["488194b303066e73766448d2eccf83068c4ae773"], "tags": []}], "date": 1794317524, "git_changesets": ["4eed3f14bcf019692ef7ae12bdb569a4b34ab082", "01352a7bdedadc3bd261351a7204ea68bbaf5a36", "94abc887fb0bf994b3724306a45207ff8a5763fd", "4039739d0f8c9f4cf5e8314360c20fe9b01a7729", "583ce48c728b05c4f055d4abc7d287983ef5ca5b", "acaf502510433f8eb0cbcc950f244717836a3ac2", "d4606f959463b819990b394c65e2ab9b5273e589", "7f75d7410975c2d5552310eef7b68a00d2c083fd", "8c851febe92219425bfb5400507f6b927da6852c", "f384887b1b26c8f5d815dcb8f387d927948b56b5", "4de14a84838e326c846d464c40a5e8b288193b06", "864166e0f3ae56c9e3fd5324e35a575855d4841c", "95c93b104d57096a19a3a186d81e909eb17b152c", "f777df8cc22c70093af01af364f6587b0094234b", "4d2cb3c40daa5b842165593b1c291aa98359c0c9", "85a4a2743991ff5f261d2a21c84a259a21e1f11b", "228a125bc7a9995c1678e07c9271ed93e8aefa39", "54ba67ac87ef15dd0182a49653925245347ce568", "43837475decf937354f3dacc66a32a21cfdeca72", "943668ce6461bb194e7a5c62aff91354231ec957", "9223d69324d64d9cfaec15622c7054afd1b4b02e", "65e9d250971e0de562319754f96a161576cdf339", "d969d8ff7dc7d2aef7ba8b339b6d1d5cb75efce7", "968cf760b27e02318ce79fe6e567e77a873e1a5e", "3311bf31e72bca1416963ff90ac5c635f39d0407", "a539e6f42b0f18f00f3bcaa502d2346d960d28d1"], "user": "ffxbld@lando.moz.tools"}, "1215": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 1 - Clean up ref count checking.  a=pascalc\n\nA few places in the cycle collector take advantage of \"int as bool\" when\nchecking if the refcount is zero, which I find confusing. This patch adds\na new predicate on nsPurpleBufferEntry that return true if the ref count is\nzero.\n\nIt also uses early return in a few places.\n\nFor SnowWhiteKiller, it adds a new predicate to SnowWhiteObject that checks if\nit is still okay to kill the object. It hoists this check out of MaybeKillObject,\nturning it into KillObject. The check was redundant in the budgeted case. This\nwill be relevant in the final patch that modifies KillObject further.\n\nThis also consolidates the mBudget check because it should not matter if we\nadd swo to mObjects before or after we remove the entry from the purple buffer.\n\nThis patch should not change any actual behavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337231\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340349\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "2102596cc5cacc995dce35d579e677665ddab7a7", "git_parents": ["6ac367dbf2d64bafe6272367c416e7bea528ad29"], "node": "cf14289c5c8f3fc19a825c499497eb0a8de0eb55", "parents": ["b71bb8389f8682cdc7314ad42b0df527183dbbdb"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 2 - Make the CC resilient against zero refcount objects.  a=pascalc\n\nThe cycle collector currently assumes that the SnowWhiteKiller has successfully\neliminated all objects with a refcount of 0 from the purple buffer. The method\nPtrInfo::IsGrayJS() relies on there being no refcounted objects with a refcount\nof 0, because it uses that to represent gray JS objects.\n\nA later patch will loosen the reentrance guards, so we will no longer be sure\nthat SnowWhiteKiller actually finished at the start of the current CC slice, so\nthe CC needs to be able to deal with objects with a refcount of 0 existing.\nThese objects can't be part of a cycle, so the CC only needs to ensure that they\nare kept out of the CC graph.\n\nThis requires some changes\n* Skip any refcount 0 objects we see in the purple buffer while getting roots,\n  instead of asserting.\n* SelectPointers might not clear snow white objects, so update the assert.\n* If an object was added to the graph and then its refcount dropped to 0\n  before we called DescribeRefCountedNode on the object, treat it like it\n  has a large valid refcount. Only release assert if the refcount is 0 if we're\n  not freeing snow white objects. Make the upper bound release assert a little\n  stricter. Delay logging until we've set the fake refcount.\n* An object could be in the purple buffer with a refcount of 0 in ScanRoots\n  if the refcount dropped to 0 after DescribeRefCountedNode. In that case,\n  it is fine to be cautious and treat it as being alive. To accommodate this\n  we only need to relax an assertion.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337232\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340350\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "81bf745a373e0a5cd18b0ca98c2974f832ce3661", "git_parents": ["2102596cc5cacc995dce35d579e677665ddab7a7"], "node": "4533c32ccf4b3dcce70024f83e75343343e26188", "parents": ["cf14289c5c8f3fc19a825c499497eb0a8de0eb55"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 3 - Add a helper class for whiteNodes in CollectWhite.  a=pascalc\n\nThis is done to make the next step cleaner and should not change any\nbehavior.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337233\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340351\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "959682f78b1746599b701fa372a41c3de5bff82f", "git_parents": ["81bf745a373e0a5cd18b0ca98c2974f832ce3661"], "node": "91d980b2bea2f4f4574c3b1b56bf25b066270d2c", "parents": ["4533c32ccf4b3dcce70024f83e75343343e26188"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 4 - Clear the graph early to simplify the condition of when it is safe to GC.  a=pascalc\n\nUnlink() in CollectWhite() can end up running arbitrary JS, which can GC,\nwhich can cause the JS pointers in the CC to become stale. This isn't a safety\nproblem because we don't use the JS pointers after the Root() loop and we have\na strong reference to any C++ objects being held in a WhiteNode.\n\nHowever, it is hard to describe the specific condition of when it is safe to GC.\nThis patch makes that condition easier to specify: it is safe to GC if and only\nif the CC graph is empty. It does this by clearing the graph after the Root() loop.\n\nTo allow this, the patch changes it so that we store the data needed for Unlink\nand Unroot within WhiteNode, rather than the graph. The drawback is that it will\ntake twice as much memory to store the WhiteNodes, although the segments will\nstill have the same size. On the upside, we avoid some pointer chasing, and we\nreduce the amount of memory being used before we run Unlink which might help.\n\nPotentially this increases the max pause time in an incremental CC, because we\nwill no longer clear the graph in a separate slice, but I don't think it takes\nvery long to clear the graph so I don't think it matters.\n\nThe patch moves the mParticipant assertion to the WhiteNode ctor. Before this\npatch, WhiteNode contained a reference to the CC graph, so if something was\nremoved from the CC graph, then mPInfo-\u003emParticipant could change, and the\nassertions in Unlink() and Unroot() might catch something. Now, the mParticipant\ndata is stored directly within WhiteNode, so it can't be changed if an object\ndies. However, we've already called Root() so it shouldn't be a problem.\n\nNow that the safety condition is clean, change FinishAnyCurrentCollection to use\na release assert when confirming there are no remaining dead pointers in the graph.\nThis requires building the three IsEmpty methods in non-debug builds.\n\nThis also moves the ClearWhiteJSWeakRefTargets call inside AutoAssertNoGC, because\nif it could run the GC, we would fail to finish the CC because mActivelyCollecting\nis true.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337234\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340352\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "f9d33921c20740d8491831c0a993d3b3efb2f8ed", "git_parents": ["959682f78b1746599b701fa372a41c3de5bff82f"], "node": "9f80f15b5832f8965a63d0fb3ef2c44eaff002c6", "parents": ["91d980b2bea2f4f4574c3b1b56bf25b066270d2c"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 5 - Make an append-only version of VisitEntries for PurpleScanBlackVisitor.  a=pascalc\n\nA later patch will allow the CC to finish a cycle collection when mFreeingSnowWhite\nis true. FreeSnowWhiteWithBudget runs destructors while iterating over the\npurple buffer, which can make us need to finish the CC. ScanIncrementalRoots is\npart of the critical path of finishing a cycle collection, and iterates over the\npurple buffer using PurpleScanBlackVisitor. It is okay to append to the purple\nbuffer while somebody further up the stack is iterating over it, but not to\nmodify or remove existing entries.\n\nFortunately, PurpleScanBlackVisitor only needs to add entries, so in this patch\nI add a new version of VisitEntries that does not allow modifying or removing\nexisting purple buffer entries. We lose out on compaction, but it isn't going to\nbe useful when we're not removing entries.\n\nAlso, give \"ar\" a better name in preparation for the next patch which will add\na second AutoRestore value to these methods. I added a little RAII helper class\nto deal with the shared nursery cleanup.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337235\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340353\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "253d887ee4314e2391aaeba62a33044d08b42285", "git_parents": ["f9d33921c20740d8491831c0a993d3b3efb2f8ed"], "node": "f8e3b6c3586c28ef6cd3ad03d7fc9e3ab14f9e1b", "parents": ["9f80f15b5832f8965a63d0fb3ef2c44eaff002c6"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 6 - Dynamically prevent iterator invalidation in the purple buffer.  a=pascalc\n\nWhile a function is iterating over the purple buffer using VisitEntries,\nit is okay to add more entries to the purple buffer, but not to remove\nor modify existing entries. Enforce this by tracking when we're iterating\nover the purple buffer with a new data member, and use release asserts\nto enforce that invalidation isn't happening.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337236\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340354\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "e03deaaba275be19f8edc16ad6c1d8860f06a20d", "git_parents": ["253d887ee4314e2391aaeba62a33044d08b42285"], "node": "a3f9eb0421f1af92e4dcf4c204b1f1cbc0d223a4", "parents": ["f8e3b6c3586c28ef6cd3ad03d7fc9e3ab14f9e1b"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 7 - Add CCReason::GC_WAITING_NOW.  a=pascalc\n\nGC_WAITING is used in PrepareForGarbageCollection to indicate that we need to\nfinish up the CC immediately so that it is safe to GC, but in the CC/GC\nscheduler it is used more to mean that we want to GC eventually, so we should\nhurry it up with the CC.\n\nThis patch splits up the two uses by adding a new reason GC_WAITING_NOW\nfor PrepareForGarbageCollection. This will be used in the next patch.\n\nI also simplified things a little and always use GC_WAITING_NOW in\nFinishAnyCurrentCollection. Otherwise, it gets a little weird to\nhave nsCycleCollector_finishAnyCurrentCollection not actually\nfinish the current CC in some conditions after the next patch. It is only used\nin testing so I think that's fine.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337237\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340355\n", "files": ["xpcom/base/nsCycleCollectionParticipant.h", "xpcom/base/nsCycleCollector.cpp"], "git_node": "85e1dc3eff69742da42c67a82b84e89e5a89195d", "git_parents": ["e03deaaba275be19f8edc16ad6c1d8860f06a20d"], "node": "20ea24b6499ba5e424562d42ef327734dfcb9d16", "parents": ["a3f9eb0421f1af92e4dcf4c204b1f1cbc0d223a4"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 8 - Allow reentrance in Collect during FreeSnowWhite.  a=pascalc\n\nIf the GC is trying to finish the CC, we need to advance the CC enough that\nthe graph is empty, even if we're in the middle of FreeSnowWhite. We'll still\ntry to finish the CC if we can, for instance if it was in CleanupPhase when\nwe GCed, because we'll collect things sooner if the CC is fully done before\nthe GC runs.\n\nThis patch weakens the reentrance guard, and doesn't set mActivelyCollecting\nto true until we're done with FreeSnowWhite. FreeSnowWhite itself also\nguards against mFreeingSnowWhite so we won't reenter there.\n\nAlso, move collectedAny closer to where it is used.\n\nThe SnowWhiteKiller::Visit() change is tricky. In the unbudgeted version of the\nSWK, snow white objects are removed from the purple buffer before any destructors\nare run. If a destructor of a snow white object runs JS, we can end up finishing\na CC while they are in this state. We need to ensure that the CC does not decide\nthese snow white objects need to be unlinked, so we want them to be treated as\nincremental roots. As they aren't in the purple buffer, we instead remove them\nfrom the CC graph (as though they had died) which will mark them as incremental\nroots. If the snow white objects are not yet in the graph, and get resurrected,\nthey will end up back in the purple buffer, and thus will be treated as\nincremental roots. The behavior does not change for a budgeted SWK, which was\nalready removing objects from the graph immediately before destroying them.\n\nI added a comment about FinalizeDeferredThings reentrance causing\nEndCycleCollectionCallback weirdness. This is pre-existing.\n\nWhile I'm touching this code anyways, I adjusted the !IsIncrementalGCInProgress() assertion\nin Collect(). This could happen if you are using test functions to trigger a budgeted CC\nslice that starts an IGC inside from the unlink method, hits the budget before\nCleanupAfterCollection can run, then runs another slice via the testing function.\nBeginCollection will finish the IGC before looking at JS and CleanupPhase doesn't look at\nit, so this is fine. This is pre-existing.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337238\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340356\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "ded3aeed50ef07c822805d7d2185412ccdec4dac", "git_parents": ["85e1dc3eff69742da42c67a82b84e89e5a89195d"], "node": "25670190b3b7b7b27e10b38440cba2caf094c8a1", "parents": ["20ea24b6499ba5e424562d42ef327734dfcb9d16"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599, part 9 - Fix potential ForgetSkippable reentrance issues.  a=pascalc\n\nThis patch fixes a few pre-existing issues with ForgetSkippable.\n\nIn theory, PrepareForForgetSkippable might be able to start a new CC in\nForgetSkippable, so to be safe, recheck that we're idle after we call it.\n\nForgetSkippable should set mFreeingSnowWhite.\n\nPrevent underflow when reporting stats about how many purple objects were removed.\nThis can probably only happen in the early return case.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D337239\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340357\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "a802dd1a19a22ae121b811474a900dbac7725663", "git_parents": ["ded3aeed50ef07c822805d7d2185412ccdec4dac"], "node": "fcfca8e53c1184e8dbba66f191a1309b150f91af", "parents": ["25670190b3b7b7b27e10b38440cba2caf094c8a1"], "tags": []}], "date": 1794499002, "git_changesets": ["2102596cc5cacc995dce35d579e677665ddab7a7", "81bf745a373e0a5cd18b0ca98c2974f832ce3661", "959682f78b1746599b701fa372a41c3de5bff82f", "f9d33921c20740d8491831c0a993d3b3efb2f8ed", "253d887ee4314e2391aaeba62a33044d08b42285", "e03deaaba275be19f8edc16ad6c1d8860f06a20d", "85e1dc3eff69742da42c67a82b84e89e5a89195d", "ded3aeed50ef07c822805d7d2185412ccdec4dac", "a802dd1a19a22ae121b811474a900dbac7725663"], "user": "pchevrel@mozilla.com"}, "1216": {"changesets": [{"author": "Benjamin VanderSloot \u003cbvandersloot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048770 - Use the last custom DoH provider UI in the DoH custom textbox when switching back to Custom -  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311542\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339254\n", "files": ["browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_dnsoverhttps_srd.js"], "git_node": "d14350a8f6e40b80084de8fddb68c7ee6511f60b", "git_parents": ["a802dd1a19a22ae121b811474a900dbac7725663"], "node": "83c2619eb041f04a72e8f6a1d2d900cdda162d06", "parents": ["fcfca8e53c1184e8dbba66f191a1309b150f91af"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055929 - Fix dohCustomProvider resetting URL when switching back from custom URL  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D312800\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339255\n", "files": ["browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/privacy/browser_privacy_dnsoverhttps_srd.js"], "git_node": "ed425a7ed74b0714c7792e4e9ea282836bd413e5", "git_parents": ["d14350a8f6e40b80084de8fddb68c7ee6511f60b"], "node": "88f8b043e981def9f66af04c251bf7445651acc9", "parents": ["83c2619eb041f04a72e8f6a1d2d900cdda162d06"], "tags": []}], "date": 1794500931, "git_changesets": ["d14350a8f6e40b80084de8fddb68c7ee6511f60b", "ed425a7ed74b0714c7792e4e9ea282836bd413e5"], "user": "pchevrel@mozilla.com"}, "1217": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078599 - Shrink the CC builder's MRUCache to fix static_assert.  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342249\n", "files": ["xpcom/base/nsCycleCollector.cpp"], "git_node": "f24df7002940212e5c13979920517916dc698b4a", "git_parents": ["ed425a7ed74b0714c7792e4e9ea282836bd413e5"], "node": "a53a2a790311e755eedc0df3bd249dc2e278acee", "parents": ["88f8b043e981def9f66af04c251bf7445651acc9"], "tags": []}], "date": 1794505448, "git_changesets": ["f24df7002940212e5c13979920517916dc698b4a"], "user": "pchevrel@mozilla.com"}, "1218": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2083975 - Wait for load before showing a universal infobar in a new window.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D336938\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339544\n", "files": ["browser/components/asrouter/modules/InfoBar.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_universal_infobar.js"], "git_node": "cb33d39f2d934eb018b4ad9920d9ac60d2b77959", "git_parents": ["f24df7002940212e5c13979920517916dc698b4a"], "node": "24380bf8ae3e8290ff7df666f7dd80fd0639c577", "parents": ["a53a2a790311e755eedc0df3bd249dc2e278acee"], "tags": []}], "date": 1794557907, "git_changesets": ["cb33d39f2d934eb018b4ad9920d9ac60d2b77959"], "user": "pchevrel@mozilla.com"}, "1219": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2087171. Cast only the size of SVG filter node task rects to integers.  a=pascalc DONTBUILD\n\nThe device rect of an SVG filter graph surface lives in its raster space, which\ncan be far from the origin (for example, under a large scale and perspective)\neven when its size is small. new_svg_filter_graph cast the whole node task rect\nto i32 only to take its size, so a position beyond i32 range panicked. Cast the\nsize instead, like get_surface_rects does for the surface task size.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338189\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339037\n", "files": ["gfx/tests/crashtests/2087171.html", "gfx/tests/crashtests/crashtests.list", "gfx/wr/webrender/src/render_task.rs"], "git_node": "eb37fba433c984d1d983f215955e96b6e08dc97a", "git_parents": ["cb33d39f2d934eb018b4ad9920d9ac60d2b77959"], "node": "d1b79c0d24da98a674da8e15c243ebb237b593d7", "parents": ["24380bf8ae3e8290ff7df666f7dd80fd0639c577"], "tags": []}], "date": 1794558073, "git_changesets": ["eb37fba433c984d1d983f215955e96b6e08dc97a"], "user": "pchevrel@mozilla.com"}, "1220": {"changesets": [{"author": "Jonatan Wallmander \u003cjonatan.wallmander@kdab.com\u003e", "branch": "default", "desc": "Bug 2076412 - Copy shared memory when updating uniform texture state.  a=pascalc\n\nThis ensures that the steps taken behave correctly.\nAlso adapt loops etc. to use the local Vector.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338665\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339417\n", "files": ["dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLProgram.h"], "git_node": "7b1f306a98aa3a8d40444262083c948843b140e9", "git_parents": ["eb37fba433c984d1d983f215955e96b6e08dc97a"], "node": "96d89bbdcd4a75aa196dbe7efc366ae5ebb3584b", "parents": ["d1b79c0d24da98a674da8e15c243ebb237b593d7"], "tags": []}], "date": 1794560233, "git_changesets": ["7b1f306a98aa3a8d40444262083c948843b140e9"], "user": "pchevrel@mozilla.com"}, "1221": {"changesets": [{"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2058620.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339977\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340844\n", "files": ["dom/file/MutableBlobStorage.cpp", "dom/xhr/XMLHttpRequestMainThread.cpp"], "git_node": "c85fe1f01f7632a01dc6b625ec4b7e0713c6dec0", "git_parents": ["7b1f306a98aa3a8d40444262083c948843b140e9"], "node": "750b5d4f71159f9f38c22bdfb98aa51d8d2ae8fa", "parents": ["96d89bbdcd4a75aa196dbe7efc366ae5ebb3584b"], "tags": []}], "date": 1794560262, "git_changesets": ["c85fe1f01f7632a01dc6