la.com/D342923\n", "files": ["dom/base/Document.cpp"], "git_node": "8b60a5ec56611b83b10e71fcaa116df1cd027560", "git_parents": ["50ea0e81f1809ce326e3602f3854487f64a04bc4"], "node": "8441cd821c87d290d99797cb3a6a844ca0488b57", "parents": ["c19fd9ee9e85958cf629f4ed042b68dceba0649a"], "tags": []}], "date": 1794912203, "git_changesets": ["8b60a5ec56611b83b10e71fcaa116df1cd027560"], "user": "pchevrel@mozilla.com"}, "1299": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2086014.  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D342999\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/2d/ScaledFontFontconfig.cpp", "gfx/2d/UnscaledFontFreeType.cpp", "gfx/2d/UnscaledFontFreeType.h", "gfx/layers/wr/WebRenderBridgeParent.cpp"], "git_node": "f96090b6b5a95ef79bdd4458f3045a5a867e39fb", "git_parents": ["8b60a5ec56611b83b10e71fcaa116df1cd027560"], "node": "d02e3014ffe30f731e010073bb1aadefac6197f1", "parents": ["8441cd821c87d290d99797cb3a6a844ca0488b57"], "tags": []}], "date": 1794912342, "git_changesets": ["f96090b6b5a95ef79bdd4458f3045a5a867e39fb"], "user": "pchevrel@mozilla.com"}, "1300": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 1: Make `HTMLEditor::GetTableCellElementAt` callers ignore generated cell  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341688\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343011\n", "files": ["editor/libeditor/HTMLEditor.cpp", "editor/libeditor/HTMLEditor.h", "editor/libeditor/HTMLEditorInlines.h", "editor/libeditor/HTMLTableEditor.cpp"], "git_node": "295cd077f13adada7a0d880fbdc1e222e1723ff8", "git_parents": ["f96090b6b5a95ef79bdd4458f3045a5a867e39fb"], "node": "1417a068cbc57c447d99db32ac3dfb6bd403e1e0", "parents": ["d02e3014ffe30f731e010073bb1aadefac6197f1"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 2: Make `EditorBase::CollapseSelectionTo` return error if the editor tries to collapse selection into a native anonymous subtree  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341689\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343012\n", "files": ["editor/libeditor/EditorBase.h"], "git_node": "82b50dad91ae36b0734511d8be0f9e7b39421ad0", "git_parents": ["295cd077f13adada7a0d880fbdc1e222e1723ff8"], "node": "c20e3aa76f0a1aaf0842f009081ae79df51301f9", "parents": ["1417a068cbc57c447d99db32ac3dfb6bd403e1e0"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2090123 - part 3: Make the style editor ensure handling only editable ranges  a=pascalc DONTBUILD\n\nChrome considers whether a range is editable with the start boundary\ncontainer. However, if only the start boundary container is editable,\nonly editable nodes are styled with `execCommand`.\n\nOn the other hand, we don't check it first. Therefore, the range may\nstart or end at non-editable node and that may cause modifying the\nnon-editable node.\n\nFor now, we should ignore ranges whose start or end container is\nnon-editable to avoid the case that the non-editable reason is that\nit's in native anonymous subtree.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D341690\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343013\n", "files": ["editor/libeditor/AutoClonedRangeArray.cpp", "editor/libeditor/HTMLStyleEditor.cpp", "testing/web-platform/meta/editing/run/bold.html.ini", "testing/web-platform/tests/editing/data/bold.js"], "git_node": "5449ce20371515c9a89c972967cfda60cd467d23", "git_parents": ["82b50dad91ae36b0734511d8be0f9e7b39421ad0"], "node": "463b085e2e41aca31d6491cda7349362eae1f8bb", "parents": ["c20e3aa76f0a1aaf0842f009081ae79df51301f9"], "tags": []}], "date": 1794912368, "git_changesets": ["295cd077f13adada7a0d880fbdc1e222e1723ff8", "82b50dad91ae36b0734511d8be0f9e7b39421ad0", "5449ce20371515c9a89c972967cfda60cd467d23"], "user": "pchevrel@mozilla.com"}, "1301": {"changesets": [{"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064110: Sign the test app bundle before languagePackUpdates.js launches the updater from it.  a=pascalc DONTBUILD\n\nOn macOS with SIP enabled, syspolicyd appears to hold the launch of the updater inside the test's unsigned dir.app behind a \"dir is damaged\" prompt, so staging never starts. Add setupTestAppBundle as the one helper tests call to install the application files and the test updater and, on macOS, write the Info.plist and ad-hoc sign the bundle. Use it from both setupUpdaterTest and languagePackUpdates.js so the two can't drift apart again.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D331621\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343401\n", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/tests/unit_aus_update/languagePackUpdates.js"], "git_node": "8a3be755783b94a1a5925e5c487828b73cd24405", "git_parents": ["5449ce20371515c9a89c972967cfda60cd467d23"], "node": "3cc709edafcca2530bf2300c014e8258c2e7330c", "parents": ["463b085e2e41aca31d6491cda7349362eae1f8bb"], "tags": []}], "date": 1794912935, "git_changesets": ["8a3be755783b94a1a5925e5c487828b73cd24405"], "user": "pchevrel@mozilla.com"}, "1302": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2091345 - Don't cache initial shapes that can be replaced by SharedShape::insertInitialShape.  a=pascalc DONTBUILD\n\nFor some classes we replace the initial empty-shape entry in the table with the\nshape that has builtin properties added to it. Future lookups then get the final\nshape instead of the empty shape.\n\nThis complicates the `ShapeCachePtr` `ShapeWithProto` optimization because it's\nbased on matching the shape in the table. The easiest fix is to not use that\noptimization for those replaceable empty shapes. This patch adds a shape flag\nto make that cheap.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342641\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343400\n", "files": ["js/src/vm/Shape.cpp", "js/src/vm/Shape.h"], "git_node": "39b12cf0024d66713969bcefe2486fb66b3c1d5f", "git_parents": ["8a3be755783b94a1a5925e5c487828b73cd24405"], "node": "07cb371290c8ee072805b744d2ea9971b3b7aedf", "parents": ["3cc709edafcca2530bf2300c014e8258c2e7330c"], "tags": []}], "date": 1794912957, "git_changesets": ["39b12cf0024d66713969bcefe2486fb66b3c1d5f"], "user": "pchevrel@mozilla.com"}, "1303": {"changesets": [{"author": "Celeste \"Coelacanthus\" Liu \u003cuwu@coelacanthus.name\u003e", "branch": "default", "desc": "Bug 2093248 - should pass length w/o NUL into AddNativeFontHandle().  a=pascalc DONTBUILD\n\nAddNativeFontHandle() forwards the filename length to a length-based\nstd::string constructor which expect without NUL. Including NUL makes\nit has an extra NUL in content, then the stored path compare unequal\nto Fontconfig's identical filename, triggering fallback that clears\nthe named-instance bits so it use wrongly default one.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D343047\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343111\n", "files": ["gfx/webrender_bindings/src/moz2d_renderer.rs"], "git_node": "eb8622439a13206029817ff309613725b476eba4", "git_parents": ["39b12cf0024d66713969bcefe2486fb66b3c1d5f"], "node": "5ce456ab3f039e774e7f659158cf857c2b171d9c", "parents": ["07cb371290c8ee072805b744d2ea9971b3b7aedf"], "tags": []}], "date": 1794916199, "git_changesets": ["eb8622439a13206029817ff309613725b476eba4"], "user": "pchevrel@mozilla.com"}, "1304": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2085895 - Normalize URL paths before matching WebsiteFilter patterns.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D339559\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343196\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_websitefilter.js"], "git_node": "85e75ed1d041eabe79efb677394a800776a0686c", "git_parents": ["eb8622439a13206029817ff309613725b476eba4"], "node": "73932991841a5f9430dd9dc58082095606285e7b", "parents": ["5ce456ab3f039e774e7f659158cf857c2b171d9c"], "tags": []}], "date": 1794916341, "git_changesets": ["85e75ed1d041eabe79efb677394a800776a0686c"], "user": "pchevrel@mozilla.com"}, "1305": {"changesets": [{"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2090900 - Stop setting up a document viewer once another one has replaced the old one.  a=pascalc DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D342108\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343200\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "52676eee71a48e06810eb37ad6ed039be6571b17", "git_parents": ["85e75ed1d041eabe79efb677394a800776a0686c"], "node": "af721c5217617081109020e7f4566f6d5b729672", "parents": ["73932991841a5f9430dd9dc58082095606285e7b"], "tags": []}], "date": 1794916376, "git_changesets": ["52676eee71a48e06810eb37ad6ed039be6571b17"], "user": "pchevrel@mozilla.com"}, "1306": {"changesets": [{"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077077 - Dispatch the worker memory reporter's runnable through the worker's control event target.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338019\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343230\n", "files": ["dom/workers/WorkerPrivate.cpp"], "git_node": "281ff58ac420395b53