t_node": "b9d171c90a1cb77cb17252e2645631f0e34eb379", "git_parents": ["89df45f7098a66439b11701ca43634d640122546"], "node": "13c4a052cf38d1a28c56a87858affc165ed1a7ac", "parents": ["6c417524bfc6377941702af68642d96d5a371dbf"], "tags": []}], "date": 1794932585, "git_changesets": ["b9d171c90a1cb77cb17252e2645631f0e34eb379"], "user": "pchevrel@mozilla.com"}, "1312": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053674 - Part 1: Always clear the ORB frontend context state.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333097\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340613\n", "files": ["dom/ipc/JSValidatorChild.cpp"], "git_node": "01281a149a6438841d24d8288e799f112d07887c", "git_parents": ["b9d171c90a1cb77cb17252e2645631f0e34eb379"], "node": "5f1e23fcd6c0f6d2d5755c2c2c56b13900ee541c", "parents": ["13c4a052cf38d1a28c56a87858affc165ed1a7ac"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053674 - Part 2: Add shareScriptData option to the FrontendContext creation.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333098\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340614\n", "files": ["js/public/experimental/CompileScript.h", "js/src/frontend/FrontendContext.cpp", "js/src/frontend/FrontendContext.h", "js/src/vm/JSScript.cpp"], "git_node": "a2314e5ca36cdd7a53f744f67a712ada67ca5368", "git_parents": ["01281a149a6438841d24d8288e799f112d07887c"], "node": "4e81f923c951aa6d74d5958e280b715bddb54f90", "parents": ["5f1e23fcd6c0f6d2d5755c2c2c56b13900ee541c"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2053674 - Part 3: Do not hold the script data in ORB process.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D333099\n\nDifferential Revision: https://phabricator.services.mozilla.com/D340615\n", "files": ["dom/ipc/JSOracleChild.h"], "git_node": "74ef30ed11d6e48ae6d18edebb67a7addc208a5b", "git_parents": ["a2314e5ca36cdd7a53f744f67a712ada67ca5368"], "node": "943fadda4cae9e5c700c6c631f858a6c58933b1b", "parents": ["4e81f923c951aa6d74d5958e280b715bddb54f90"], "tags": []}], "date": 1794936795, "git_changesets": ["01281a149a6438841d24d8288e799f112d07887c", "a2314e5ca36cdd7a53f744f67a712ada67ca5368", "74ef30ed11d6e48ae6d18edebb67a7addc208a5b"], "user": "pchevrel@mozilla.com"}, "1313": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2084028 - Strip trailing dots from the host in AllowedDomainsForApps.  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D339537\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/xpcshell/test_allowed_domains_for_apps.js", "browser/components/enterprisepolicies/tests/xpcshell/xpcshell.toml"], "git_node": "23d82cb26f53f3b4e539446b969fdd4c721e09e7", "git_parents": ["74ef30ed11d6e48ae6d18edebb67a7addc208a5b"], "node": "7580c9253d27b12e4f0cf15c3765deab0d7a42b1", "parents": ["943fadda4cae9e5c700c6c631f858a6c58933b1b"], "tags": []}], "date": 1794936978, "git_changesets": ["23d82cb26f53f3b4e539446b969fdd4c721e09e7"], "user": "pchevrel@mozilla.com"}, "1314": {"changesets": [{"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2068455 - Caption should only be promoted to first when it is the DOM table's caption.  a=pascalc DONTBUILD\n\nAlso add test to make sure aria-owns does the right thing when including\na caption.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D338122\n\nDifferential Revision: https://phabricator.services.mozilla.com/D343596\n", "files": ["accessible/html/HTMLTableAccessible.cpp"], "git_node": "b0420e30ab8787f9e4dae18db7ee8863fb09c6dd", "git_parents": ["23d82cb26f53f3b4e539446b969fdd4c721e09e7"], "node": "