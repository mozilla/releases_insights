s:48987:"{
"lastpushid": 632,
"pushes": {"245": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging c4a5d008ee64fab523384408fa2868e2d028025d with FIREFOX_128_4_0esr_BUILD1 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "36cf46e09178013aa328b8ab4d3b745bd33697e2", "parents": ["c4a5d008ee64fab523384408fa2868e2d028025d"], "tags": []}], "date": 1729555563, "git_changesets": [null], "user": "ffxbld"}, "246": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "2e04aea09d19ec2f1cf851e3ea3682cab6be6596", "parents": ["36cf46e09178013aa328b8ab4d3b745bd33697e2"], "tags": []}], "date": 1730126352, "git_changesets": [null], "user": "ffxbld-merge"}, "247": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging c4a5d008ee64fab523384408fa2868e2d028025d with FIREFOX_128_4_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "79d46f3740f25cf5c3559db48d9e638b40c911ea", "parents": ["2e04aea09d19ec2f1cf851e3ea3682cab6be6596"], "tags": []}], "date": 1730206889, "git_changesets": [null], "user": "ffxbld"}, "248": {"changesets": [{"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1927117 - Add policy to the schema file.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D226896\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227219", "files": ["browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": null, "git_parents": [null], "node": "d5d5f1e1026fe09fe67863b9e1d06c49c5edcdf9", "parents": ["79d46f3740f25cf5c3559db48d9e638b40c911ea"], "tags": []}], "date": 1730217328, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "249": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_128_3_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_128_3_X_RELBRANCH. a=release", "files": [], "git_node": null, "git_parents": [null], "node": "4ef9e4191343e4b040f6208b5b207006be9ca9b1", "parents": ["e0c969a3bfc0a23219384269e5b36a589c8f6cc5"], "tags": []}], "date": 1730221896, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "250": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1898184 - Don't set the forPreview flag if the prefer_system_dialog pref is set, to avoid blocking forever in nsGlobalWindowOuter::Print.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D224950\n\nDifferential Revision: https://phabricator.services.mozilla.com/D226807", "files": ["dom/base/nsGlobalWindowOuter.cpp"], "git_node": null, "git_parents": [null], "node": "d2ed121d32ae71223ca9b43b7fc73ced3d05acab", "parents": ["d5d5f1e1026fe09fe67863b9e1d06c49c5edcdf9"], "tags": []}], "date": 1730296167, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "251": {"changesets": [{"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1917632 - Apply the sidebar revamp in the same window that pref is enabled in  a=dmeehan\n\n`adoptFromWindow` sets the sidebar width based on the \"opener\" window. If the opener\ndoes not have a sidebar, no width is remembered. Previously, flipping the sidebar revamp\npref required opening a new window to see the revamped sidebar, and hence meant the opener\ndid not have a sidebar.\n\nThis patch ensures the revamp is applied in the current/opener window and hence the width\nof the sidebar opened in that window is used to determine the width of the sidebar in future\nwindows opened. This should resolve the issue some users have found when closing the browser\nvia the X button and reopening the browser doesn't remember the sidebar width.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D226942", "files": ["browser/components/sidebar/browser-sidebar.js"], "git_node": null, "git_parents": [null], "node": "2de0c38ef21d6e21544c342286cfe51af950f741", "parents": ["d2ed121d32ae71223ca9b43b7fc73ced3d05acab"], "tags": []}], "date": 1730296379, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "252": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1923655 - stop browser_protocol_ask_dialog_permission.js failing on esr  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D226852", "files": ["uriloader/exthandler/tests/mochitest/browser_protocol_ask_dialog_permission.js"], "git_node": null, "git_parents": [null], "node": "332ccad1154e445fb3a16b9f8877bf7923e17ced", "parents": ["2de0c38ef21d6e21544c342286cfe51af950f741"], "tags": []}], "date": 1730300500, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "253": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out 1 changesets (bug 1917632) for causing perma test failures on esr128\n\nBacked out changeset 2de0c38ef21d (bug 1917632)", "files": ["browser/components/sidebar/browser-sidebar.js"], "git_node": null, "git_parents": [null], "node": "473d052b9e9f48626c19a021ebdff16f23a40b69", "parents": ["332ccad1154e445fb3a16b9f8877bf7923e17ced"], "tags": []}], "date": 1730321131, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "254": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227484", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "624059a17dc57180bda5101fd5dcbba7707d97ff", "parents": ["473d052b9e9f48626c19a021ebdff16f23a40b69"], "tags": []}], "date": 1730378260, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "255": {"changesets": [{"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1919755 - correctly calculate content analysis URL for local PDF file  a=dmeehan\n\nThis was already working for remote PDF files but I went ahead and\nadded tests for both.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D226391", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_content_analysis_impl.js", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_local_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_remote_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/file_pdf.pdf", "toolkit/components/contentanalysis/tests/browser/head.js", "toolkit/components/printing/tests/head.js"], "git_node": null, "git_parents": [null], "node": "19beee0b6d7dcf219f99afacacb79849e9f42271", "parents": ["624059a17dc57180bda5101fd5dcbba7707d97ff"], "tags": []}], "date": 1730396619, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "256": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out 1 changesets (bug 1919755) from esr128 for causing test failures\n\nBacked out changeset 19beee0b6d7d (bug 1919755)", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_content_analysis_impl.js", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_local_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_remote_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/file_pdf.pdf", "toolkit/components/contentanalysis/tests/browser/head.js", "toolkit/components/printing/tests/head.js"], "git_node": null, "git_parents": [null], "node": "893b0489efa4b18355ea91113c28bf7c731a2749", "parents": ["19beee0b6d7dcf219f99afacacb79849e9f42271"], "tags": []}], "date": 1730403832, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "257": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921458.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D226775\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227221", "files": ["toolkit/components/reputationservice/ApplicationReputation.cpp", "toolkit/components/reputationservice/test/gtest/TestExecutableLists.cpp", "xpcom/io/nsLocalFileCommon.cpp", "xpcom/io/nsLocalFileCommon.h"], "git_node": null, "git_parents": [null], "node": "e983e8a66e515a2e32497cec1b3ccf439396dadc", "parents": ["893b0489efa4b18355ea91113c28bf7c731a2749"], "tags": []}], "date": 1730556070, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "258": {"changesets": [{"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1909535 - Don't show select dropdown in background tabs;  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225706\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227607", "files": ["toolkit/actors/SelectParent.sys.mjs"], "git_node": null, "git_parents": [null], "node": "a6cf1a7cd289db4f46cb34f4dd16cce133b25e8d", "parents": ["e983e8a66e515a2e32497cec1b3ccf439396dadc"], "tags": []}], "date": 1730556333, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "259": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227810", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "216a5aa5da9369c3b4786da96eff58124280d0bb", "parents": ["a6cf1a7cd289db4f46cb34f4dd16cce133b25e8d"], "tags": []}], "date": 1730725796, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "260": {"changesets": [{"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 1927151 - Fix Bing follow-on searches incorrectly recorded as organic:none in telemetry.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D227266\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227716", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/unit/test_urlTelemetry_generic.js"], "git_node": null, "git_parents": [null], "node": "c878a93f681ee4e9feb6ee2820d757517d1f7928", "parents": ["216a5aa5da9369c3b4786da96eff58124280d0bb"], "tags": []}], "date": 1730728846, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "261": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1920197 - Add prefs to allow updating Widevine directly from the Chromium update service.  a=dmeehan\n\nThis patch allows us to download Widevine updates directly from the\nChromium update service, bypassing balrog and fallback configuration\noptions. This will be useful in the early stages of testing Widevine\nupdates, allowing us to use whatever Google has pushed to its own users,\nincluding beta updates, before we engage release engineering.\n\nRelevant Widevine L3 prefs have been added:\n- media.gmp-widevinecdm.force-chromium-update\n- media.gmp-widevinecdm.force-chromium-beta\n\nwhich force the use of the Chromium update service, and requesting beta\nversions (if available) respectively.\n\nSimilarly, Widevine L1 prefs have been added as well:\n- media.gmp-widevinecdm-l1.force-chromium-update\n- media.gmp-widevinecdm-l1.force-chromium-beta\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223017\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227229", "files": ["browser/app/profile/firefox.js", "toolkit/modules/GMPInstallManager.sys.mjs", "toolkit/modules/GMPUtils.sys.mjs"], "git_node": null, "git_parents": [null], "node": "4901c5fa4922e21d68e7ad2bd8f6c084ede3beb5", "parents": ["c878a93f681ee4e9feb6ee2820d757517d1f7928"], "tags": []}], "date": 1730734174, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "262": {"changesets": [{"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1921353 - Ensure up-to-date flags in DNR cache  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225005\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227534", "files": ["toolkit/components/extensions/ExtensionDNRStore.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_dynamic_rules.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_static_rules.js"], "git_node": null, "git_parents": [null], "node": "34ea820483b770ad779c0df7255cb7048ba72a33", "parents": ["4901c5fa4922e21d68e7ad2bd8f6c084ede3beb5"], "tags": []}], "date": 1730734524, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "263": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1916152: Make nsCocoaWindow handle failing to enter or exit fullscreen. r=mac-reviewers,mstange, a=dmeehan\n\nPreviously, we had relied on macOS eventually invoking the\nwindowDidEnterFullscreen and windowDidExitFullscreen delegate methods.\nBut in cases where macOS does not, and instead invokes the \"fail\"\nmethods, we can do the right thing to put the nsCocoaWindow in a\nsynchronized state with the DOM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227295", "files": ["widget/cocoa/nsCocoaWindow.mm"], "git_node": null, "git_parents": [null], "node": "47de48e111df9ad4de638e45108d1dedf997d9ba", "parents": ["34ea820483b770ad779c0df7255cb7048ba72a33"], "tags": []}, {"author": "Richard Marti \u003crichard.marti@gmail.com\u003e", "branch": "default", "desc": "Bug 1922961 - Don't append the browser subdirectory in Thunderbird. r=win-reviewers,handyman, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D225443", "files": ["widget/windows/ToastNotification.cpp", "widget/windows/moz.build"], "git_node": null, "git_parents": [null], "node": "5a74da019021e5d169a56319c568868e00040130", "parents": ["47de48e111df9ad4de638e45108d1dedf997d9ba"], "tags": []}], "date": 1730740036, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "264": {"changesets": [{"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1910452: Part 1 - Intercept drop events for content analysis  a=dmeehan\n\nSends OOP drop events to content analysis for approval before sending them to\nthe DOM.  It intercepts drop events at the browser level and sends them to CA\nbefore calling stopPropagation and preventDefault on them.  (CA also presents a\nmodal dialog over the tab.) The drag session then ends as usual in the parent\nprocess but remains open on the related browser in the process where it would be\nsent to the DOM while the drop is being analyzed.  While CA runs, the browser\ndispatches an eQueryDropTargetHittest event to locate the drop target while the\nevent screen coordinates are still valid.  When CA is complete, a drop or\ndragexit event is sent to the drop target (drop if it was approved by CA). Calls\nto EndDragSession are delayed during this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227587", "files": ["dom/events/ContentEventHandler.cpp", "dom/events/ContentEventHandler.h", "dom/events/EventStateManager.cpp", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserChild.h", "dom/ipc/PBrowser.ipdl", "toolkit/content/widgets/browser-custom-element.js", "widget/EventMessageList.h", "widget/TextEvents.h", "widget/WidgetEventImpl.cpp", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h", "widget/nsIDragService.idl", "widget/nsIDragSession.idl"], "git_node": null, "git_parents": [null], "node": "befe8321772d766c27f286157348b5ce1cc46bfb", "parents": ["5a74da019021e5d169a56319c568868e00040130"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1910452: Part 2 - Test that drag-drop respects content analysis  a=dmeehan\n\nThis reuses parts of the dom/events test to test that content analysis is\nconsulted and respected for in-browser drags with drops in the same frame and\nbetween frames/windows with same or different origin.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219549\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227588", "files": ["dom/events/test/browser_dragdrop_impl.js", "dom/events/test/browser_dragdrop_protected_diff_origin.js", "dom/events/test/browser_dragdrop_protected_same_origin.js", "dom/events/test/browser_dragdrop_unprotected_diff_origin.js", "dom/events/test/browser_dragdrop_unprotected_same_origin.js", "toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_content_analysis_dnd_diff_origin.js", "toolkit/components/contentanalysis/tests/browser/browser_content_analysis_dnd_same_origin.js", "toolkit/components/contentanalysis/tests/browser/head.js"], "git_node": null, "git_parents": [null], "node": "726fb6cadff4949a6f92ef9a43fbddd112a36f38", "parents": ["befe8321772d766c27f286157348b5ce1cc46bfb"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1910452: Part 3 - Fix some issues with synthesizeMockDragAndDrop  a=dmeehan\n\nThis fixes four issues:\n\n1. The test didn't provide enough movement to generate a drag session on the\n   source before moving to the target.  This meant that, when they were in\n   different windows, Gecko wouldn't send dragleave to the source or dragenter\n   to the target.  It also never sent dragenter to the source in the first\n   place. This remedies that.\n2. dragenter and dragleave weren't properly handled because the test was sending\n   dragleaves instead of dragexits (the latter being what Gecko expects and the\n   former being synthesized from that -- see e.g. nsNativeDragTarget::DragLeave).\n   This now uses dragexits and sets the proper expectations.\n3. expectProtectedDataTransferAccess was needlessly complicated and, after #1,\n   gave the wrong answers for some events like dragenter called on the source.\n4. The event handler wasn't checking for exceptions and the drop handler was\n   intentionally causing one, which was causing it to miss the rest of its\n   execution.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219550\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227589", "files": ["testing/mochitest/tests/SimpleTest/DragChildContextBase.sys.mjs", "testing/mochitest/tests/SimpleTest/EventUtils.js", "widget/MockDragServiceController.cpp", "widget/nsIMockDragServiceController.idl"], "git_node": null, "git_parents": [null], "node": "39c1eb7dfc5941f396e902856e699620520c8e8a", "parents": ["726fb6cadff4949a6f92ef9a43fbddd112a36f38"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1910452: Part 4 - Wait for iframe to load in drag and drop tests  a=dmeehan\n\nThis was causing \"AbortError: Actor 'SpecialPowers' destroyed before query\n'Spawn' was resolved\" failures.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D219551\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227590", "files": ["dom/events/test/browser_dragdrop_impl.js"], "git_node": null, "git_parents": [null], "node": "a3334fe3774d844e902e251c710a51d8db67d2db", "parents": ["39c1eb7dfc5941f396e902856e699620520c8e8a"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1910452: Part 5 - Release content analysis cache request on main thread  a=dmeehan\n\nWithout this, we assert when releasing the request on the background thread when\nwe hit an error, such as the DLP agent not running.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220617\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227591", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp"], "git_node": null, "git_parents": [null], "node": "4869c672edfa1b3c884c85a8ff1937b251c7b7f8", "parents": ["a3334fe3774d844e902e251c710a51d8db67d2db"], "tags": []}, {"author": "David Parks \u003cdavidp99@gmail.com\u003e", "branch": "default", "desc": "Bug 1916804: Make content analysis DND use getURIForDropEvent  a=dmeehan\n\ngetURIForDropEvent delegates to getURIForBrowsingContext -- the ground truth for\nCA URIs.\n\nThis also adds a check that getURIForDropEvent is correctly called in CA tests.\nWe do not yet test that it returns the right value -- that is future work.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222192\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227592", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/nsIContentAnalysis.idl", "toolkit/components/contentanalysis/tests/browser/browser_content_analysis_dnd_diff_origin.js", "toolkit/components/contentanalysis/tests/browser/browser_content_analysis_dnd_same_origin.js", "toolkit/components/contentanalysis/tests/browser/head.js", "toolkit/content/widgets/browser-custom-element.js", "widget/nsBaseDragService.cpp", "widget/nsIDragSession.idl"], "git_node": null, "git_parents": [null], "node": "1ae6eddb9ffb972f8f600d96127edfe770ffb675", "parents": ["4869c672edfa1b3c884c85a8ff1937b251c7b7f8"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1918579 - don't crash when dropping with content analysis and focus changes  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222290\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227593", "files": ["dom/events/EventStateManager.cpp", "dom/ipc/BrowserChild.cpp"], "git_node": null, "git_parents": [null], "node": "a4757ebd18fdc3d44281d5a2c845f69a51f532cc", "parents": ["1ae6eddb9ffb972f8f600d96127edfe770ffb675"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1919537 - don't crash with DLP on when drag/drop text to a site on Deny list  a=dmeehan\n\nThis prevents a problem where Content Analysis responds synchronously (because\nthe site is on the deny list), which causes a modal window to pop up, which\ncancels the drag session. This causes MOZ_ASSERTs() where we expect the drag\nsession to still be active.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D222668\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227594", "files": ["toolkit/content/widgets/browser-custom-element.js"], "git_node": null, "git_parents": [null], "node": "dd6e12fa073c6bb9f9e56ec33b82df1b064e7d6f", "parents": ["a4757ebd18fdc3d44281d5a2c845f69a51f532cc"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1919755 - correctly calculate content analysis URL for local PDF file  a=dmeehan\n\nThis was already working for remote PDF files but I went ahead and\nadded tests for both.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223639\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227595", "files": ["toolkit/components/contentanalysis/ContentAnalysis.cpp", "toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_content_analysis_impl.js", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_local_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_print_pdf_remote_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/file_pdf.pdf", "toolkit/components/contentanalysis/tests/browser/head.js", "toolkit/components/printing/tests/head.js"], "git_node": null, "git_parents": [null], "node": "dbeb010aea025fac427c0d1f07361e665a01e6ee", "parents": ["dd6e12fa073c6bb9f9e56ec33b82df1b064e7d6f"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921079 - make DLP agent name bold in panel  a=dmeehan\n\nI tried this for the hover text as well but unsurprisingly bold text\nisn't styled any differently there.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225856\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227596", "files": ["browser/components/contentanalysis/content/ContentAnalysis.sys.mjs", "browser/locales/en-US/browser/browser.ftl"], "git_node": null, "git_parents": [null], "node": "ffb680fadb03ebbdc4fec1d077b71e5f63c48fe2", "parents": ["dbeb010aea025fac427c0d1f07361e665a01e6ee"], "tags": []}], "date": 1730821148, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "265": {"changesets": [{"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1928124 - Implement push error metrics  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227855", "files": ["dom/push/PushServiceWebSocket.sys.mjs", "dom/push/metrics.yaml", "toolkit/components/glean/metrics_index.py", "toolkit/components/glean/tags.yaml"], "git_node": null, "git_parents": [null], "node": "ee357585be9b1beaef928fff8c183590296f6009", "parents": ["ffb680fadb03ebbdc4fec1d077b71e5f63c48fe2"], "tags": []}], "date": 1730833161, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "266": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921079 - Update l10n-changesets.json. a=dmeehan", "files": ["browser/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "349c8f8310226a7271ad30d283dfd6898f4f6eba", "parents": ["ee357585be9b1beaef928fff8c183590296f6009"], "tags": []}], "date": 1730912110, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "267": {"changesets": [{"author": "Fatih \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1928871: Fix browser_exslt_timezone_load.js. r=tjr, a=test-only", "files": ["browser/components/resistfingerprinting/test/browser/browser.toml", "browser/components/resistfingerprinting/test/browser/browser_exslt_timezone_load.js"], "git_node": null, "git_parents": [null], "node": "173f721a98a9b74987612fc9a293c783a785e6d6", "parents": ["349c8f8310226a7271ad30d283dfd6898f4f6eba"], "tags": []}], "date": 1730946186, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "268": {"changesets": [{"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1924623 - Only detour VariantClear in Firefox.  a=dmeehan\n\nDetouring VariantClear resulted in a huge crash spike for Thunderbird,\nso let's do that only in Firefox.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D227957\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228304", "files": ["toolkit/xre/nsAppRunner.cpp"], "git_node": null, "git_parents": [null], "node": "0eb7403a0e22981daf3a99f77d094fefb52538ec", "parents": ["173f721a98a9b74987612fc9a293c783a785e6d6"], "tags": []}], "date": 1730985851, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "269": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228324", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "0031e586618d2570d869792eda221c77a0e95960", "parents": ["0eb7403a0e22981daf3a99f77d094fefb52538ec"], "tags": []}], "date": 1730988507, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "270": {"changesets": [{"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1929571: change PSL branch from master to main, r=jcristau a=NPOTB DONTBUILD", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "10f058b08643fec9ed8138eaff0423cfd9874129", "parents": ["0031e586618d2570d869792eda221c77a0e95960"], "tags": []}], "date": 1731001506, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "271": {"changesets": [{"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1924167 - shim updates;  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228367", "files": ["browser/extensions/webcompat/data/shims.js", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/moz.build", "browser/extensions/webcompat/shims/google-safeframe.html", "mobile/android/android-components/components/feature/webcompat/src/main/assets/extensions/webcompat/data/shims.js", "mobile/android/android-components/components/feature/webcompat/src/main/assets/extensions/webcompat/manifest.json", "mobile/android/android-components/components/feature/webcompat/src/main/assets/extensions/webcompat/shims/google-safeframe.html"], "git_node": null, "git_parents": [null], "node": "9ce39543bfbe966ad39a57ffbd6700488bb6a74e", "parents": ["10f058b08643fec9ed8138eaff0423cfd9874129"], "tags": []}], "date": 1731019218, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "272": {"changesets": [{"author": "Sean \u003csekim@mozilla.com\u003e", "branch": "default", "desc": "Bug 1929622 - Improve error handling in SSO Cookie Parsing  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228389", "files": ["netwerk/protocol/http/MicrosoftEntraSSOUtils.mm"], "git_node": null, "git_parents": [null], "node": "97608ba4f9f38c68937e206edf98752833aca077", "parents": ["9ce39543bfbe966ad39a57ffbd6700488bb6a74e"], "tags": []}], "date": 1731251875, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "273": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes -  a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228573", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "449514eb31bd64a9186cb7061a173f2c4c3520be", "parents": ["97608ba4f9f38c68937e206edf98752833aca077"], "tags": []}], "date": 1731334095, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "274": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1915848 - Set network.http.http2.allow-push to false  a=dmeehan\n\nHTTP/2 Push was involved in several web-compat issues recently.\nSee bug 1915830 for known H2-push bugs.\n\nAs such it's best to turn off the feature and align with Chrome\nin order to avoid future push bugs only affecting Firefox.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220699\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228423", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/test/unit/test_dns_by_type_resolve.js", "netwerk/test/unit/test_origin.js", "netwerk/test/unit/test_trr.js"], "git_node": null, "git_parents": [null], "node": "15e6751f9ba3b52cf46943126de0dae010962357", "parents": ["449514eb31bd64a9186cb7061a173f2c4c3520be"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1915134 - Add pref to enable Extensible Prioritization Scheme without sending SETTINGS_NO_RFC7540_PRIORITIES  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220389\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228424", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http2Session.cpp", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": null, "git_parents": [null], "node": "9b3877326b8dcfc40bb214c2f8afb5c49e26bacc", "parents": ["15e6751f9ba3b52cf46943126de0dae010962357"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1915134 - Flip network.http.http2.enabled.deps to false  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D220390\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228425", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "7532dde4e2355eb9b5336f79d302b8c9b25b7ead", "parents": ["9b3877326b8dcfc40bb214c2f8afb5c49e26bacc"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1930122 - Set network.http.http2.send_NO_RFC7540_PRI to false  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D228433\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228437", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "ee41bed4901e47aa46e49ab9ff5c8e85e479490a", "parents": ["7532dde4e2355eb9b5336f79d302b8c9b25b7ead"], "tags": []}], "date": 1731344961, "git_changesets": [null, null, null, null], "user": "dmeehan@mozilla.com"}, "275": {"changesets": [{"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1929600  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D228201\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228580", "files": ["toolkit/mozapps/extensions/internal/XPIDatabase.sys.mjs"], "git_node": null, "git_parents": [null], "node": "3b50417aca257bfb30f3277f915fc400aa83c7c7", "parents": ["ee41bed4901e47aa46e49ab9ff5c8e85e479490a"], "tags": []}], "date": 1731417679, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "276": {"changesets": [{"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1925496.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D228315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228568", "files": ["browser/components/urlbar/UrlbarInput.sys.mjs", "browser/components/urlbar/tests/browser/browser_copying.js"], "git_node": null, "git_parents": [null], "node": "e6099586845f23c0f85fe29a636980e57d206897", "parents": ["3b50417aca257bfb30f3277f915fc400aa83c7c7"], "tags": []}], "date": 1731417733, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "277": {"changesets": [{"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880582: Make nsCocoaWindow add and remove tracking areas from the same view. r=mac-reviewers,spohl, a=dmeehan\n\nIt is important to remove the NSTrackingArea before the nsCocoaWindow is\ndeallocated. This patch ensures that we remember which NSView is holding\nthe tracking area and remove the tracking area from that view during\ndealloc (as well as whenever the tracking area is updated).\n\nSince the `trackingAreaView` property accessor returns a value based on\n`contentView` or its superview, manipulations of either view will change\nthe return value of the accessor. We can't rely on it being consistent\nthroughout the lifetime of the window. This change ensures that we will\nalways remove the tracking area from the view that added it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D212949", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": null, "git_parents": [null], "node": "28d4836f822d319558995da60ee096e6ac6a46af", "parents": ["e6099586845f23c0f85fe29a636980e57d206897"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880582: Use more correct teardown semantics in nsCocoaWindow::Destroy. r=mstange, a=dmeehan\n\nThis patch moves the call to BaseWindow::Destroy() and ::OnDestroy() to\nthe end of nsCocoaWindow::Destroy(). It adds a death grip on this before\nremove this from mParent. This should keep the window in a more stable\nstate throughout the function scope.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D216066", "files": ["widget/cocoa/nsCocoaWindow.mm"], "git_node": null, "git_parents": [null], "node": "406ccf9ac4bd1553639e8ea6489f3ce9d74c51f9", "parents": ["28d4836f822d319558995da60ee096e6ac6a46af"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880582: Hold an autorelease reference to mWindow while releasing it. r=mstange, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D225554", "files": ["widget/cocoa/nsCocoaWindow.mm"], "git_node": null, "git_parents": [null], "node": "f6f6228dc17e03ec3c8898f816563701a52f15f3", "parents": ["406ccf9ac4bd1553639e8ea6489f3ce9d74c51f9"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 1880582: Make nsCocoaWindow hold a death grip on its native window until its destructor. r=mstange, a=dmeehan\n\nThis is a simplified version of a fix authored by Steven Michaud. This\ncreates a death grip in DestroyNativeWindow() and holds it until the\nnsCocoaWindow is destroyed. This seems to satisfy the various run loops\nin macOS which might invoke DestroyNativeWindow() without holding a\nreference to the window itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D226169", "files": ["widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm"], "git_node": null, "git_parents": [null], "node": "653023c93105fa19ddfc0f1390805fc633492395", "parents": ["f6f6228dc17e03ec3c8898f816563701a52f15f3"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1899299 [Linux] Listen mouse events on mShell for modal popups r=emilio, a=dmeehan\n\nA popup attached to a modal parent window doesn't get mouse events\nfrom Gtk as they'are directed to the modal parent. This is usually solved\nby pointer grab which that doesn't work on Wayland in our current\nsetup as it performs show and grab in one step.\n\nWe emulate it by setting popup as modal too but then patent\nwindow doesn't get mouse events outside of popup (Bug 1899299).\nwe need to listen\n\nSurprisingly attaching events handler to mShell fixes it\nand we're getting events from both parent and popup windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221290", "files": ["widget/gtk/nsWindow.cpp"], "git_node": null, "git_parents": [null], "node": "aefd43c367d029cdd8b200d9c68b51f47fc61828", "parents": ["653023c93105fa19ddfc0f1390805fc633492395"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1929911 - DT fix. r=aosmond, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228393", "files": ["gfx/2d/InlineTranslator.h"], "git_node": null, "git_parents": [null], "node": "fbed98e3e9cdc2f99af7a2a14f7184f51fe07d8e", "parents": ["aefd43c367d029cdd8b200d9c68b51f47fc61828"], "tags": []}], "date": 1731440333, "git_changesets": [null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "278": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1842187  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223948\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228631", "files": ["toolkit/components/downloads/DownloadUIHelper.sys.mjs"], "git_node": null, "git_parents": [null], "node": "936e95e3b008cb9bcccd1512332b45757a4bb7f6", "parents": ["fbed98e3e9cdc2f99af7a2a14f7184f51fe07d8e"], "tags": []}], "date": 1731505164, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "279": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228961", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/password-rules.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/main/websites-with-shared-credential-backends.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "c133ec5d3d041a2032178fbe977c1a4e93cc4256", "parents": ["936e95e3b008cb9bcccd1512332b45757a4bb7f6"], "tags": []}], "date": 1731589616, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "280": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1930834 - Align onLeft buffers to the AudioBlockPanStereoToStereo expectation.  a=dmeehan\n\nThe function is compiled for neon, sse2 and sse4_2, the largest\nalignment that requires is 16.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D228768\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228911", "files": ["dom/media/webaudio/PannerNode.cpp", "dom/media/webaudio/StereoPannerNode.cpp"], "git_node": null, "git_parents": [null], "node": "f309bef3810d43aea5f1055a8958532a061a585b", "parents": ["c133ec5d3d041a2032178fbe977c1a4e93cc4256"], "tags": []}], "date": 1731591673, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "281": {"changesets": [{"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 1930629 - Fix Bing follow-on searches selected from suggestion list that are incorrectly recorded as organic:none in telemetry.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D228892\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228919", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/unit/test_urlTelemetry_generic.js"], "git_node": null, "git_parents": [null], "node": "19ee65ce51f1af51084a95277ea4f9461584a264", "parents": ["f309bef3810d43aea5f1055a8958532a061a585b"], "tags": []}], "date": 1731611196, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "282": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1927714 - Missing style invalidation in ShadowRoot::AddSlot(). r=smaug, a=dmeehan\n\nUsually RemoveSlot takes care of this, but if it's not the first slot it\ndoesn't.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D227334", "files": ["dom/base/ShadowRoot.cpp", "testing/web-platform/tests/css/css-scoping/shadow-reassign-dynamic-005-crash.html", "testing/web-platform/tests/css/css-scoping/shadow-reassign-dynamic-006-ref.html", "testing/web-platform/tests/css/css-scoping/shadow-reassign-dynamic-006.html"], "git_node": null, "git_parents": [null], "node": "024738fe527aeff710adacc86cca75bcc10b1f50", "parents": ["19ee65ce51f1af51084a95277ea4f9461584a264"], "tags": []}, {"author": "Fatih \u003cfkilic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1902570: Enable \"Stix Two Math\" on macOS 13 and above.  a=dmeehan\n\nOriginal Revision: https://phabricator.services.mozilla.com/D226945\n\nDifferential Revision: https://phabricator.services.mozilla.com/D228814", "files": ["gfx/thebes/StandardFonts-macos.inc", "gfx/thebes/gfxMacPlatformFontList.mm", "widget/GfxInfoBase.cpp", "widget/nsIGfxInfo.idl"], "git_node": null, "git_parents": [null], "node": "6a5726a161ca874f2039f255bd87eb98b829759f", "parents": ["024738fe527aeff710adacc86cca75bcc10b1f50"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1930050 - Make `AutoRangeArray` check the container type r=m_kato, a=dmeehan\n\nDif