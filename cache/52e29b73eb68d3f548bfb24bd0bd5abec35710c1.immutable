"pushes": {"615": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 5ee62877b9cf66efc794f87f225257dd82c42ae7 with FIREFOX_115_21_1esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "b4e8678ee698b8d5688ffbde025c8e7c24c7753c", "parents": ["605716d71c48cbcfe49f9a03f454e8085efa11f0"], "tags": []}], "date": 1743083495, "git_changesets": [null], "user": "ffxbld"}, "616": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 605716d71c48cbcfe49f9a03f454e8085efa11f0 with FIREFOX_115_22_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "273d9a175b309a893e36f1a1eb8f840b3e2348b3", "parents": ["b4e8678ee698b8d5688ffbde025c8e7c24c7753c"], "tags": []}], "date": 1743087218, "git_changesets": [null], "user": "ffxbld"}, "617": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "f745bf872f6dfd2271351a6de212e120c009d955", "parents": ["273d9a175b309a893e36f1a1eb8f840b3e2348b3"], "tags": []}], "date": 1743425902, "git_changesets": [null], "user": "ffxbld-merge"}, "618": {"changesets": [{"author": "Rob Lemley \u003crob@thunderbird.net\u003e", "branch": "default", "desc": "Bug 1921813 - Update verify_routes_notification_filters to align with Taskcluster \u003e 37.5.0. r=taskgraph-reviewers,ahal a=release\n\nPR #3662 introduced `on-defined`, `on-pending` and `on-running`,\nand deprecated `on-any` in favor of `on-transition` or `on-resolved`.\n\n[jcristau: ported fix from https://github.com/taskcluster/taskgraph/pull/500]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224138", "files": ["taskcluster/gecko_taskgraph/util/verify.py"], "git_node": null, "git_parents": [null], "node": "04426fba9dbc51b72c06a474fd50e009df9f49ee", "parents": ["f745bf872f6dfd2271351a6de212e120c009d955"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1921474 - send matrix notifications for merge-automation tasks. r=taskgraph-reviewers,releng-reviewers,ahal a=release\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224141", "files": ["taskcluster/ci/merge-automation/kind.yml", "taskcluster/gecko_taskgraph/transforms/merge_automation.py"], "git_node": null, "git_parents": [null], "node": "897e515c1519b67e4499177df600401a67a9e27f", "parents": ["04426fba9dbc51b72c06a474fd50e009df9f49ee"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1933469 - fix notification target for merge-automation prod tasks. r=releng-reviewers,taskgraph-reviewers,bhearsum a=release DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D230268", "files": ["taskcluster/gecko_taskgraph/transforms/merge_automation.py"], "git_node": null, "git_parents": [null], "node": "2fca6b676eac8ea13ed9e484a73f8d5dfb6cafde", "parents": ["897e515c1519b67e4499177df600401a67a9e27f"], "tags": []}], "date": 1743495605, "git_changesets": [null, null, null], "user": "jcristau@mozilla.com"}, "619": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 605716d71c48cbcfe49f9a03f454e8085efa11f0 with FIREFOX_115_22_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "220c083291c5e687bd0ee234f9a3520d4988fa84", "parents": ["2fca6b676eac8ea13ed9e484a73f8d5dfb6cafde"], "tags": []}], "date": 1743512186, "git_changesets": [null], "user": "ffxbld"}, "620": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "FIREFOX_ESR_115_21_X_RELBRANCH", "desc": "Close obsolete FIREFOX_ESR_115_21_X_RELBRANCH. a=release DONTBUILD", "files": [], "git_node": null, "git_parents": [null], "node": "b2e57b5b1b4bf8f245d59393556124a133f89f69", "parents": ["5ee62877b9cf66efc794f87f225257dd82c42ae7"], "tags": []}], "date": 1743525887, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "621": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244317", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "7a2e43dcb0c17eedae47a75192949f9be120a79b", "parents": ["220c083291c5e687bd0ee234f9a3520d4988fa84"], "tags": []}], "date": 1743686505, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "622": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244607", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/password-rules.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "b91e3ff5769dec49d4fd31b59f5755f2416d37e3", "parents": ["7a2e43dcb0c17eedae47a75192949f9be120a79b"], "tags": []}], "date": 1744041606, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "623": {"changesets": [{"author": "Hubert Boma Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 1949994 - [devtools] Properly escape the ampersand for Copy as cURL (POSIX) r=devtools-reviewers,ochameau, a=dsmith\n\nThe Copy as CuRL (POSIX) context menu is enabled for Windows, the historical reason was to allow\nWindows users who use other tools (like Cygwin etc) instead of the Win command prompt.\n\nThis patch escapes the ampersand which stops a generating a malicous curl command which can be run\non Windows CMD Prompt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242674", "files": ["devtools/client/netmonitor/test/browser_net_curl-utils.js", "devtools/client/shared/curl.js"], "git_node": null, "git_parents": [null], "node": "3600267773714ebb983fe4e4a6a60ff0612307fb", "parents": ["b91e3ff5769dec49d4fd31b59f5755f2416d37e3"], "tags": []}], "date": 1744145899, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "624": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946084: detect updater command line arguments by inspecting usage message  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244911", "files": ["tools/update-verify/release/common/check_updates.sh"], "git_node": null, "git_parents": [null], "node": "81847f71494b1f92a22847a7b2b2810f2795bcb7", "parents": ["3600267773714ebb983fe4e4a6a60ff0612307fb"], "tags": []}], "date": 1744228118, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "625": {"changesets": [{"author": "Peter Van der Beken \u003cpeterv@propagandism.org\u003e", "branch": "default", "desc": "Bug 1953525 - Disable the XSLT document() function when called through the XSLTProcessor DOM API.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D241227\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244521", "files": ["dom/xslt/xslt/txMozillaXSLTProcessor.cpp", "testing/web-platform/tests/dom/xslt/document-function.window.js"], "git_node": null, "git_parents": [null], "node": "5ca725c82c91c9de8e161ede9ee913d4e0093235", "parents": ["81847f71494b1f92a22847a7b2b2810f2795bcb7"], "tags": []}], "date": 1744246752, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "626": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1942364: switch signing to autograph gcp production  a=diannaS\n\nNote that this also moves us to a new Authenticode certificate out of necessity (see https://bugzilla.mozilla.org/show_bug.cgi?id=1942344)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244624", "files": ["taskcluster/gecko_taskgraph/transforms/geckodriver_signing.py", "taskcluster/gecko_taskgraph/transforms/mar_signing.py", "taskcluster/gecko_taskgraph/transforms/openh264_signing.py", "taskcluster/gecko_taskgraph/transforms/release_generate_checksums_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing_partner.py", "taskcluster/gecko_taskgraph/transforms/source_checksums_signing.py", "taskcluster/gecko_taskgraph/util/signed_artifacts.py"], "git_node": null, "git_parents": [null], "node": "6ba1032ebff7b35e5bea470ab07d86b1b27bf5d6", "parents": ["5ca725c82c91c9de8e161ede9ee913d4e0093235"], "tags": []}], "date": 1744312624, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "627": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 6ba1032ebff7 (bug 1942364) for causing linux and windows signing failures on esr115, a=backout", "files": ["taskcluster/gecko_taskgraph/transforms/geckodriver_signing.py", "taskcluster/gecko_taskgraph/transforms/mar_signing.py", "taskcluster/gecko_taskgraph/transforms/openh264_signing.py", "taskcluster/gecko_taskgraph/transforms/release_generate_checksums_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing_partner.py", "taskcluster/gecko_taskgraph/transforms/source_checksums_signing.py", "taskcluster/gecko_taskgraph/util/signed_artifacts.py"], "git_node": null, "git_parents": [null], "node": "b55a1fa280ce52b3fd0643c4c95d528b5f63f6a1", "parents": ["6ba1032ebff7b35e5bea470ab07d86b1b27bf5d6"], "tags": []}], "date": 1744321661, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "628": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings tld-suffixes -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D245062", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/top-sites.json"], "git_node": null, "git_parents": [null], "node": "df4a9cf8bbdf3a3b61d9b73a1fc332d5f286e396", "parents": ["b55a1fa280ce52b3fd0643c4c95d528b5f63f6a1"], "tags": []}], "date": 1744343464, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "629": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1942364: switch signing to autograph gcp production  a=diannaS\n\nNote that this also moves us to a new Authenticode certificate out of necessity (see https://bugzilla.mozilla.org/show_bug.cgi?id=1942344)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D244624", "files": ["taskcluster/gecko_taskgraph/transforms/geckodriver_signing.py", "taskcluster/gecko_taskgraph/transforms/mar_signing.py", "taskcluster/gecko_taskgraph/transforms/openh264_signing.py", "taskcluster/gecko_taskgraph/transforms/release_generate_checksums_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing.py", "taskcluster/gecko_taskgraph/transforms/repackage_signing_partner.py", "taskcluster/gecko_taskgraph/transforms/source_checksums_signing.py", "taskcluster/gecko_taskgraph/util/signed_artifacts.py"], "git_node": null, "git_parents": [null], "node": "6b583215f264f5a9676e8b5b550655990d942e4c", "parents": ["df4a9cf8bbdf3a3b61d9b73a1fc332d5f286e396"], "tags": []}], "date": 1744390768, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "630": {"changesets": [{"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1917536 - Check for Admin and LocalSystem permissions in updater instead of inferring them from a lockfile. r=bytesized a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D223223\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242457", "files": ["toolkit/mozapps/update/updater/updater-common.build", "toolkit/mozapps/update/updater/updater.cpp", "toolkit/xre/WinTokenUtils.cpp", "toolkit/xre/WinTokenUtils.h"], "git_node": null, "git_parents": [null], "node": "00aa6241f022d9e26db6c666ae25344274777bd0", "parents": ["6b583215f264f5a9676e8b5b550655990d942e4c"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Keep track of argument indices with variables r=bytesized a=diannaS\n\nWe need to add an argument to this executable, but it is made more difficult than it needs to be by the fact that we refer to arguments by number all over this code. Which, to be honest, also just makes the code harder to understand than necessary. This patch simply swaps out raw index values for variables in order to make this easier to understand.\n\nThere should only be one actual functionality change in this patch. [This](https://searchfox.org/mozilla-central/rev/080df48f04783f4dcdba83de687989ae33924f40/toolkit/mozapps/update/updater/updater.cpp#4123) particular invocation of `LaunchCallbackApp` inexplicably passes the path to the callback binary as the first argument instead of the path to the callback's working directory. Presumably this is a bug.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225420\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242458", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "19e9e7a746b2065882eeded2282fa511ecb27dbe", "parents": ["00aa6241f022d9e26db6c666ae25344274777bd0"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Add an argument to the updater to convey which updater instance it is r=bytesized a=diannaS\n\nNote that this patch does not implement the proper usage of the argument. It reads the argument but then does nothing with it.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225421\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242459", "files": ["toolkit/mozapps/update/tests/data/xpcshellUtilsAUS.js", "toolkit/mozapps/update/updater/updater.cpp", "toolkit/xre/nsUpdateDriver.cpp"], "git_node": null, "git_parents": [null], "node": "a651d518d2321d62d51788337abacc46933c5ee9", "parents": ["19e9e7a746b2065882eeded2282fa511ecb27dbe"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Add MMS support for new updater args r=bytesized a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225742\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242460", "files": ["toolkit/components/maintenanceservice/moz.build", "toolkit/components/maintenanceservice/workmonitor.cpp"], "git_node": null, "git_parents": [null], "node": "b906f2b567bb57c27217a23e2a9660f05de10bcc", "parents": ["a651d518d2321d62d51788337abacc46933c5ee9"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Use argument value to determine which updater instance is running rather than elevation r=bytesized a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242461", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "63446c44877e36296d21b0150d66f5f33aad2c73", "parents": ["b906f2b567bb57c27217a23e2a9660f05de10bcc"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1923376 - Fix \"force service fallback\" update test feature r=bytesized a=diannaS\n\nThis patch basically reimplements [this](https://searchfox.org/mozilla-central/rev/754074e05178e017ef6c3d8e30428ffa8f1b794d/toolkit/mozapps/update/updater/updater.cpp#3849-3859) functionality (removed in Bug 1917536), but using the mechanism introduced by Bug 1923376 to convey which invocation the updater should run as.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D225743\n\nDifferential Revision: https://phabricator.services.mozilla.com/D242462", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "1dcad182ec2fcb192bb41b2d551182bd4293d991", "parents": ["63446c44877e36296d21b0150d66f5f33aad2c73"], "tags": []}, {"author": "Robin Steuber \u003cbytesized@mozilla.com\u003e", "branch": "default", "desc": "Bug 1937806 - Pass the second updater invocation args to the macOS elevated updater r=bytesized a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D243229", "files": ["toolkit/mozapps/update/updater/updater.cpp"], "git_node": null, "git_parents": [null], "node": "a4d01f01697e6581e85c801650b2ca25ece28091", "parents": ["1dcad182ec2fcb192bb41b2d551182bd4293d991"], "tags": []}], "date": 1744415539, "git_changesets": [null, null, null, null, null, null, null], "user": "dsmith@mozilla.com"}, "631": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default",