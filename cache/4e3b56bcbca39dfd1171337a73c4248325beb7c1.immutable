anch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258887\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "811f258e62b7b2b7adddd628d0812ac5b3aff38a", "git_parents": ["01ad0c21faf3ec65d7ac0a814d2247e387c0b35b"], "node": "9c83353fba7ecabe019093a2136cb70df32c34f2", "parents": ["afdd869589dfa0947f190bff962ea27cfb4ebe56"], "tags": []}], "date": 1753703810, "git_changesets": ["811f258e62b7b2b7adddd628d0812ac5b3aff38a"], "user": "dsmith@mozilla.com"}, "715": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1977166: When moving a RemoteAccessible, ensure it doesn't still have a parent.  a=diannaS\n\nOriginal Revision: https://phabricator.services.mozilla.com/D257206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258843\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "0e2fc6ce704d9cede17c6582b2228d8af3d783de", "git_parents": ["811f258e62b7b2b7adddd628d0812ac5b3aff38a"], "node": "797307240afa8abdc8ad9748e01abbc5593be660", "parents": ["9c83353fba7ecabe019093a2136cb70df32c34f2"], "tags": []}], "date": 1753735056, "git_changesets": ["0e2fc6ce704d9cede17c6582b2228d8af3d783de"], "user": "dsmith@mozilla.com"}, "716": {"changesets": [{"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1937563 - Remove implicit dot argument for PATHEXT in mozfile  a=diannaS\n\nCertain build dependencies e.g. npm have shell scripts without file extension (for msys usage), and having dot in PATHEXT makes `shutil.which()` always prefer shell scripts even on non-msys shells.\n\nAfter this patch, such behavior should now be entirely opt-in, i.e. the callers would need to explicitly add `exts=[\".\"]` (But callers should also refrain from depending on shell scripts, as otherwise it'll fail on non-msys shells on Windows)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D233086\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259185\n", "files": ["testing/mozbase/mozfile/mozfile/mozfile.py", "testing/mozbase/mozfile/tests/test_which.py"], "git_node": "6e4a0b633e9c36ef886385cbf4d4b74e39cc66b7", "git_parents": ["0e2fc6ce704d9cede17c6582b2228d8af3d783de"], "node": "76daf135d5316cac26a6be6eefdceeaa970e9241", "parents": ["797307240afa8abdc8ad9748e01abbc5593be660"], "tags": []}], "date": 1753838852, "git_changesets": ["6e4a0b633e9c36ef886385cbf4d4b74e39cc66b7"], "user": "dsmith@mozilla.com"}, "717": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976782 - [esr128] Guard against possible race via gfxFontEntry::GetFontTable.  a=diannaS DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D259122\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259123\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h"], "git_node": "e1e13787ef780de8da3413f28baac26121553389", "git_parents": ["6e4a0b633e9c36ef886385cbf4d4b74e39cc66b7"], "node": "71f2b55b6c9853b31c50161bd7920c573d2b945e", "parents": ["76daf135d5316cac26a6be6eefdceeaa970e9241"], "tags": []}], "date": 1753967908, "git_changesets": ["e1e13787ef780de8da3413f28baac26121553389"], "user": "dsmith@mozilla.com"}, "718": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr115 repo-update HSTS HPKP remote-settings -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259406\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/du