s:46174:"{
"lastpushid": 316,
"pushes": {"201": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging e26ff04290d095dac006a3710b07077ee5d20f31 with FIREFOX_102_9_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "dda54415e573dd25b909530d67f587e971d63ae0", "parents": ["e26ff04290d095dac006a3710b07077ee5d20f31"], "tags": []}], "date": 1678407429, "git_changesets": [null], "user": "ffxbld"}, "202": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "b13bc46eac48ac9be5a3b83c79db636053f9d45c", "parents": ["dda54415e573dd25b909530d67f587e971d63ae0"], "tags": []}], "date": 1678724565, "git_changesets": [null], "user": "ffxbld-merge"}, "203": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D172400", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "bf2612752e70cf2b01925aebb53194240c01b615", "parents": ["b13bc46eac48ac9be5a3b83c79db636053f9d45c"], "tags": []}], "date": 1678725066, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "204": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging e26ff04290d095dac006a3710b07077ee5d20f31 with FIREFOX_102_9_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "98bd1f70f6fd4c126009946ab5abddd5e19b7025", "parents": ["bf2612752e70cf2b01925aebb53194240c01b615"], "tags": []}], "date": 1678798375, "git_changesets": [null], "user": "ffxbld"}, "205": {"changesets": [{"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 1819867 - Remove partner code to be updated. a=test-only DONTBUILD", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_distributions.js"], "git_node": null, "git_parents": [null], "node": "82e9f6f64d7e12bdad3a846dc70c79e8dc20c1d8", "parents": ["98bd1f70f6fd4c126009946ab5abddd5e19b7025"], "tags": []}], "date": 1678922151, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "206": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D172780", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config.json", "services/settings/dumps/main/search-telemetry-v2.json"], "git_node": null, "git_parents": [null], "node": "d667f45ea6bbedb2ee957c58da4e84016c5f4cb7", "parents": ["82e9f6f64d7e12bdad3a846dc70c79e8dc20c1d8"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1819493 - Check the buffer. r=karlt, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171485", "files": ["dom/media/webrtc/MediaEngineDefault.cpp"], "git_node": null, "git_parents": [null], "node": "8fcdaf8d685d5903b127e041feb1716637b6008f", "parents": ["d667f45ea6bbedb2ee957c58da4e84016c5f4cb7"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1819244. Cherry pic webp commit fix. r=aosmond, a=dsmith\n\nhttps://github.com/webmproject/libwebp/commit/a486d800b60d0af4cc0836bf7ed8f21e12974129\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171814", "files": ["media/libwebp/MOZCHANGES", "media/libwebp/src/enc/alpha_enc.c"], "git_node": null, "git_parents": [null], "node": "53b805c752ff23080e100eda2b3b4280d4370b2e", "parents": ["8fcdaf8d685d5903b127e041feb1716637b6008f"], "tags": []}], "date": 1678978707, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "207": {"changesets": [{"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1811981 - Add ability to run both x86 and ARM Widevine plugins on Windows ARM. r=jld, a=dsmith\n\nThis patch adds the ability for Windows on ARM to launch either x86 or\nARM Widevine plugins. It also adds the ability for Windows on x86 to\nrefuse ARM binaries in case, for example, a profile is transferred\nbetween machines.\n\nOverall this should be a non-functional change for users at the time of\nlanding. It does however allow us to ship the ARM Widevine plugin to\nWindows ARM users to workaround a plugin crash with the x86 Widevine\nplugin. This only affects Windows 10 users (Windows 11 works fine).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D167634", "files": ["dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPProcessParent.cpp", "dom/media/gmp/GMPProcessParent.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "modules/libpref/init/StaticPrefList.yaml", "security/sandbox/win/src/remotesandboxbroker/RemoteSandboxBrokerParent.cpp", "security/sandbox/win/src/remotesandboxbroker/RemoteSandboxBrokerParent.h", "security/sandbox/win/src/remotesandboxbroker/remoteSandboxBroker.cpp", "security/sandbox/win/src/remotesandboxbroker/remoteSandboxBroker.h", "security/sandbox/win/src/sandboxbroker/sandboxBroker.cpp", "security/sandbox/win/src/sandboxbroker/sandboxBroker.h", "xpcom/io/FileUtilsWin.cpp", "xpcom/io/FileUtilsWin.h"], "git_node": null, "git_parents": [null], "node": "7e9aa91dfb8287a9fa82acb10794e826b8be1b98", "parents": ["53b805c752ff23080e100eda2b3b4280d4370b2e"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1814703 - Allow selecting between ARM and x86 clearkey on Windows ARM. r=azebrowski, a=dsmith\n\nOn Windows ARM, we currently use the x86 version of the clearkey plugin.\nWe do however ship Firefox with the ARM version although prior to this\npatch it was unused. Now if media.gmp-clearkey.allow-x64-plugin-on-arm64\nis set to false, then we will attempt to load the ARM version of the\nplugin. The pref remains true by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D168707", "files": ["toolkit/modules/GMPUtils.jsm", "toolkit/mozapps/extensions/internal/GMPProvider.jsm"], "git_node": null, "git_parents": [null], "node": "f1f54d72daf348a7871224b2093e634b150c06cd", "parents": ["7e9aa91dfb8287a9fa82acb10794e826b8be1b98"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1814910 - Ensure we allow users to switch between ARM and x86 GMP plugins via balrog. r=azebrowski, a=dsmith\n\nWe need to ensure the hash value is the same and remove the old binaries\nif not because if we switch architectures without a version bump, we\nwill continue to use the old binary. Additionally we should also store\nboth ABI preferences for Windows ARM (x86 and aarch64) to ensure that if\nwe profile migrate, or update to a new version, we flush the plugins.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D168809", "files": ["toolkit/modules/GMPInstallManager.jsm", "toolkit/modules/GMPUtils.jsm", "toolkit/modules/tests/xpcshell/test_GMPInstallManager.js", "toolkit/mozapps/extensions/internal/GMPProvider.jsm"], "git_node": null, "git_parents": [null], "node": "e53124355fa8070f8147a23ebe2620472f634f81", "parents": ["f1f54d72daf348a7871224b2093e634b150c06cd"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1819661 - Use ARM clearkey plugin instead of x86 plugin on Windows ARM in nightly. r=media-playback-reviewers,alwu, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171357", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "794bc674deac846a546aa8ed4e9abb479e1c54c0", "parents": ["e53124355fa8070f8147a23ebe2620472f634f81"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1820669 - Ship ARM clearkey plugin to release. r=media-playback-reviewers,alwu, a=dsmith\n\nThis patch ensures that Windows ARM users will use the ARM clearkey\nplugin over the x86 plugin by default. We continue to ship with the x86\nplugin at this time, so the users could switch back if necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171876", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": null, "git_parents": [null], "node": "ddf0ebeb36360a150bdced741eeca0e62395729f", "parents": ["794bc674deac846a546aa8ed4e9abb479e1c54c0"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1819410 - Ensure we shutdown the RemoteSandboxBrokerParent IPDL instance during launch failures. r=jld, a=dsmith\n\nIf the process being launched by the sandbox broker crashes after we\nsetup the IPDL channel, but before we successfully complete the\ninitialization process, we don't explicitly teardown\nRemoteSandboxBrokerParent. As such, when we destroy the owning objects,\nit attempts to destroy RemoteSandboxBrokerParent while the protocol is\nstill open, triggering a release assert for destroying\nPRemoteSandboxBrokerParent while the protocol/channel are still open.\n\nThis patch makes us explicitly teardown the channel if there is a launch\nfailure inside the sandbox broker.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171258", "files": ["security/sandbox/win/src/remotesandboxbroker/remoteSandboxBroker.cpp"], "git_node": null, "git_parents": [null], "node": "7734996812ba83350d067e6949d6cdeeb553ddc6", "parents": ["ddf0ebeb36360a150bdced741eeca0e62395729f"], "tags": []}], "date": 1678994179, "git_changesets": [null, null, null, null, null, null], "user": "dsmith@mozilla.com"}, "208": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D172999", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json"], "git_node": null, "git_parents": [null], "node": "285a9f451ddc21a79aae6fe75f29d01888917998", "parents": ["7734996812ba83350d067e6949d6cdeeb553ddc6"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1814217 - Dispatch release of main thread objects in ~nsHttpChannel r=necko-reviewers,jesup, a=dsmith\n\nThe patch also adds a diagnostic assert that the objects have actually been released in nsHttpChannel::ReleaseListeners\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171717", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": null, "git_parents": [null], "node": "9aa1db544ca9e10c9581f487aa568c0750a89241", "parents": ["285a9f451ddc21a79aae6fe75f29d01888917998"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1814597; r=smaug, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171401", "files": ["dom/base/nsFocusManager.cpp"], "git_node": null, "git_parents": [null], "node": "104fefb06fc693111da20e76f679f8daffef2830", "parents": ["9aa1db544ca9e10c9581f487aa568c0750a89241"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1818357 - Guard nsBufferedStream::mBuffer with recursive mutex r=necko-reviewers,jesup, a=dsmith\n\nIt needs to be a recursive mutex instead of a regular one in case\n`nsStreamLoader::WriteSegmentFun` closes the stream while holding the mutex.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171746", "files": ["netwerk/base/nsBufferedStreams.cpp", "netwerk/base/nsBufferedStreams.h"], "git_node": null, "git_parents": [null], "node": "3b5174799c88cbbfe27cd3e6aa4a47055b068871", "parents": ["104fefb06fc693111da20e76f679f8daffef2830"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1820543 - Update weak maps before finalization observer edges when compacting r=sfink, a=dsmith\n\nThe latter relies on being able to access the former.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171723", "files": ["js/src/gc/Compacting.cpp"], "git_node": null, "git_parents": [null], "node": "d58e0a95e12d2e8cdad84598ee775d3ce225aa0e", "parents": ["3b5174799c88cbbfe27cd3e6aa4a47055b068871"], "tags": []}], "date": 1679337452, "git_changesets": [null, null, null, null, null], "user": "dsmith@mozilla.com"}, "209": {"changesets": [{"author": "Dianna Smith \u003cdsmith@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 3b5174799c88 (bug 1818357) for causing bustages, a=backout", "files": ["netwerk/base/nsBufferedStreams.cpp", "netwerk/base/nsBufferedStreams.h"], "git_node": null, "git_parents": [null], "node": "7231b6aa432550307627126a28f4e7a9235ecf12", "parents": ["d58e0a95e12d2e8cdad84598ee775d3ce225aa0e"], "tags": []}], "date": 1679339736, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "210": {"changesets": [{"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1818357 - Guard nsBufferedStream::mBuffer with recursive mutex r=#necko,jesup, a=dsmith\n\nIt needs to be a recursive mutex instead of a regular one in case\n`nsStreamLoader::WriteSegmentFun` closes the stream while holding the mutex.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D171746", "files": ["netwerk/base/nsBufferedStreams.cpp", "netwerk/base/nsBufferedStreams.h"], "git_node": null, "git_parents": [null], "node": "c979f6159362efb5f651031027b8d61b8ce20688", "parents": ["7231b6aa432550307627126a28f4e7a9235ecf12"], "tags": []}, {"author": "sotaro \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1812498 - Destroy RenderBufferTextureHosts that use VideoBridgeParent's Shmems in VideoBridgeParent::OnChannelError(). r=lsalzman, a=dsmith\n\nDestroy RenderBufferTextureHosts that use VideoBridgeParent's Shmems before destroying all VideoBridgeParent's Shmems by PVideoBridgeParent::OnChannelError().\n\nThe patch includes Bug 1817674 fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D172764", "files": ["dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h", "dom/media/ipc/RemoteDecoderManagerParent.cpp", "gfx/ipc/GPUParent.cpp", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/composite/TextureHost.h", "gfx/layers/ipc/CompositorThread.cpp", "gfx/layers/ipc/VideoBridgeParent.cpp", "gfx/layers/ipc/VideoBridgeParent.h", "gfx/thebes/gfxPlatform.cpp", "gfx/webrender_bindings/RenderBufferTextureHost.cpp", "gfx/webrender_bindings/RenderBufferTextureHost.h", "gfx/webrender_bindings/RenderTextureHost.cpp", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderThread.cpp", "gfx/webrender_bindings/RenderThread.h"], "git_node": null, "git_parents": [null], "node": "10a9a5639f09e5090cac413e1c54073451e9840c", "parents": ["c979f6159362efb5f651031027b8d61b8ce20688"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1819744 - Allow xpinstall.signatures.required to be set via policy on ESR. r=mstriemer, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "70ce09aba3ee6c7eb86c64a5a0ed4fad1362dab3", "parents": ["10a9a5639f09e5090cac413e1c54073451e9840c"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777588 - Init variable length prefix set in constructor. r=timhuang, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D156659", "files": ["toolkit/components/url-classifier/LookupCache.cpp"], "git_node": null, "git_parents": [null], "node": "617c262d3b6f0319f8f13160895a826012003059", "parents": ["70ce09aba3ee6c7eb86c64a5a0ed4fad1362dab3"], "tags": []}], "date": 1679403862, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "211": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 10a9a5639f09 (bug 1812498) for various shutdown hangs.", "files": ["dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h", "dom/media/ipc/RemoteDecoderManagerParent.cpp", "gfx/ipc/GPUParent.cpp", "gfx/layers/composite/TextureHost.cpp", "gfx/layers/composite/TextureHost.h", "gfx/layers/ipc/CompositorThread.cpp", "gfx/layers/ipc/VideoBridgeParent.cpp", "gfx/layers/ipc/VideoBridgeParent.h", "gfx/thebes/gfxPlatform.cpp", "gfx/webrender_bindings/RenderBufferTextureHost.cpp", "gfx/webrender_bindings/RenderBufferTextureHost.h", "gfx/webrender_bindings/RenderTextureHost.cpp", "gfx/webrender_bindings/RenderTextureHost.h", "gfx/webrender_bindings/RenderThread.cpp", "gfx/webrender_bindings/RenderThread.h"], "git_node": null, "git_parents": [null], "node": "7e0e61e6aab9bf522ab1d3273afcce8f4ab66b2a", "parents": ["617c262d3b6f0319f8f13160895a826012003059"], "tags": []}], "date": 1679407327, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "212": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1820602 (ESR102) - Use shape guard instead of class guard for CallDOMFunction, a=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D173136", "files": ["js/src/jit/CacheIR.cpp", "js/src/jit/WarpBuilderShared.h"], "git_node": null, "git_parents": [null], "node": "43190ea413e9e11408468b6d8112eaa93640f2cb", "parents": ["7e0e61e6aab9bf522ab1d3273afcce8f4ab66b2a"], "tags": []}, {"author": "Jon Buckley \u003cjon@jbuckley.ca\u003e", "branch": "default", "desc": "Bug 1815585 - Add DigiCert Global Root G2 and G5 CAs to mozilla_services pinset. r=keeler, a=dsmith\n\nDigicert is migrating users away from the G1 root CA so we need to add the new G2 and G5 root CAs to continue using Digicert certificates with many Firefox services\n\nDifferential Revision: https://phabricator.services.mozilla.com/D169506", "files": ["security/manager/tools/PreloadedHPKPins.json"], "git_node": null, "git_parents": [null], "node": "de9c1a17dc445171aef4253f069ebb4e2a9f8dbf", "parents": ["43190ea413e9e11408468b6d8112eaa93640f2cb"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dsmith\n\nDifferential Revision: https://phabricator.services.mozilla.com/D173421", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "55fe04f6205f9bc5f0765f2eeca6552b4b01d96a", "parents": ["de9c1a17dc445171aef4253f069ebb4e2a9f8dbf"], "tags": []}], "date": 1679580488, "git_changesets": [null, null, null], "user": "dsmith@mozilla.com"}, "213": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1824368: update known hosts file in parter repack docker image for github host key change r=releng-reviewers,jlorenzo a=release DONTBUILD\n\nThis adds the new RSA key from https://github.blog/2023-03-23-we-updated-our-rsa-ssh-host-key/, as well as the existing ed25519 keys (which I got from loading the partner repack image locally, and running `ssh github.com`).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D173527", "files": ["taskcluster/docker/partner-repack/known_hosts"], "git_node": null, "git_parents": [null], "node": "935bd0a4ebb2ef389fa5c8e52665fe64cebb488f", "parents": ["55fe04f6205f9bc5f0765f2eeca6552b4b01d96a"], "tags": []}], "date": 1679674571, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "214": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1815585 - remove DigiCert G5 roots from the mozilla_services pinset on esr102. r=keeler, a=dsmith\n\nThese roots weren't yet included in 102.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D173681", "files": ["security/manager/tools/PreloadedHPKPins.json"], "git_node": null, "git_parents": [null], "node": "4233435e20cf27948f8001d0b28bd36f2d828403", "parents": ["935bd0a4ebb2ef389fa5c8e52665fe64cebb488f"], "tags": []}], "date": 1679935071, "git_changesets": [null], "user": "dsmith@mozilla.com"}, "215": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D173780", "files": ["security/manager/ssl/StaticHPKPins.h", "se