ent-confirmation/secure-payment-confirmation.tentative.https.html.ini"], "git_node": null, "git_parents": [null], "node": "3b42363e79ed288bb9a1b01ee26777426cda649a", "parents": ["d9c3a5d78d43bf61d450282e313b558200e89ae4"], "tags": []}, {"author": "Michelle Goossens \u003cmichelle@masterwayz.nl\u003e", "branch": "default", "desc": "Bug 1730412 - Migrate windows10-mingw from AWS to Azure r=jmaher\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125349", "files": ["taskcluster/ci/test/test-platforms.yml"], "git_node": null, "git_parents": [null], "node": "ee660c166e32eb43c0acd6e07b32b131a8a6a420", "parents": ["3b42363e79ed288bb9a1b01ee26777426cda649a"], "tags": []}, {"author": "Michelle Goossens \u003cmichelle@masterwayz.nl\u003e", "branch": "default", "desc": "Bug 1731843 - Disable \"no build-signing\" sub-suite of CI job for permafails. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126291", "files": ["taskcluster/test/test_mach_try_auto.py"], "git_node": null, "git_parents": [null], "node": "66e03927aed5f7d3452493f5a0793869520ee1c6", "parents": ["ee660c166e32eb43c0acd6e07b32b131a8a6a420"], "tags": []}], "date": 1632263739, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "62": {"changesets": [{"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1720746 - Preload bcryptPrimitives.dll in the main thread of GMP. r=bobowen, a=NPOTB\n\nThe call to `RtlGenRandom` delay-loads bcryptPrimitives.dll.  The GMP process,\nhowever, cannot load bcryptPrimitives.dll after process launch because its process\ntoken is restricted.  This is not a problem normally because bcryptPrimitives.dll\nis loaded in early stage when the main thread still has a non-restricted impersonation\ntoken.\n\nWith ASan, however, the first call to `RandomUint64` happens in a non-main thread,\nand it fails because the thread is not impersonated.  We have PreloadLibs to mitigate\nthis kind of problem, but in this case adding bcryptPrimitives.dll to the list does\nnot help because the call to `RandomUint64` happens before we load PreloadLibs.\n\nThe proposed fix is to explicitly call `RandomUint64` in the main thread before\nany call to `RandomUint64` in the process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D121203", "files": ["toolkit/xre/nsEmbedFunctions.cpp"], "git_node": null, "git_parents": [null], "node": "a92ce0470dcd6be2d75d23a372a3bce39758526c", "parents": ["66e03927aed5f7d3452493f5a0793869520ee1c6"], "tags": []}], "date": 1632271853, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "63": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126482", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "6ba996d90400c8f30b83f51a246fc1a43f84df09", "parents": ["a92ce0470dcd6be2d75d23a372a3bce39758526c"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1732131 - Allow security.tls.enable_0rtt_data via policy. r=emalysz a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126368", "files": ["browser/components/enterprisepolicies/Policies.jsm"], "git_node": null, "git_parents": [null], "node": "3c6c2b68ea3e723ce994bc9ae3671b3dff38bd37", "parents": ["6ba996d90400c8f30b83f51a246fc1a43f84df09"], "tags": []}, {"author": "Manuel Bucher \u003cmbucher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1663836 - Treat invalid HTTP response header names over HTTP2 as malformed. r=dragana, a=RyanVM\n\nRelevant section in the spec: https://datatracker.ietf.org/doc/html/rfc7540#section-10.3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D120969", "files": ["netwerk/protocol/http/Http2Compression.cpp", "netwerk/test/unit/test_http2.js", "testing/xpcshell/moz-http2/moz-http2.js"], "git_node": null, "git_parents": [null], "node": "38b53a0a4a4e16bc7170b34148e156b1541b69dd", "parents": ["3c6c2b68ea3e723ce994bc9ae3671b3dff38bd37"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1726501 - don't use pdf.js for file: links when the user has configured an external app as the default handler for PDFs, r=mtigley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123270", "files": ["toolkit/components/pdfjs/content/PdfStreamConverter.jsm"], "git_node": null, "git_parents": [null], "node": "12d839a5a9c8be3abd3d093fb4cff7969faace32", "parents": ["38b53a0a4a4e16bc7170b34148e156b1541b69dd"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1707582 - Make browser_UsageTelemetry_interaction.js less susceptible to intermittent failure. r=mtigley,Gijs a=test-only\n\nThis test was brittle for a few reasons:\n\n1. The bookmarks toolbar is, by default, configured to show and hide\n   depending on whether or not about:home/about:newtab is displayed.\n   This meant that sometimes when trying to click on a bookmark\n   toolbar item, a transition from the visible-to-collapsed or\n   collapsed-to-visible state would be underway, and the click\n   event would ultimately miss its mark.\n2. The bookmarks toolbar also populates itself lazily, so the test has\n   been adjusted to ensure that there are items in the toolbar before\n   it attempts to click on one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125761", "files": ["browser/modules/test/browser/browser_UsageTelemetry_interaction.js"], "git_node": null, "git_parents": [null], "node": "871657bd59c2c9387f39a3baef146519fef44927", "parents": ["12d839a5a9c8be3abd3d093fb4cff7969faace32"], "tags": []}, {"author": "sotaro \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1727703 - Clear pending transactions in WebRenderLayerManager::DoDestroy(). r=mattwoodrow, a=RyanVM\n\nWhen device reset happens, WebRender and WebRenderLayerManagers are re-created. In this case,  pending transactions of nsRefreshDriver need to be cleared during destroying WebRenderLayerManager.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124011", "files": ["gfx/layers/wr/WebRenderLayerManager.cpp"], "git_node": null, "git_parents": [null], "node": "f315d49650c09ac050d71c793f868e4bdabe11b0", "parents": ["871657bd59c2c9387f39a3baef146519fef44927"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1728594 - fix a SmartBlock regression which causes some site links to not be clickable; r=johannh,ksenia, a=RyanVM\n\n- gpt.js expends dataLayer.push to return true, or it will cancel clicks on the relevant tracked links.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126009", "files": ["browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/shims/google-analytics-and-tag-manager.js"], "git_node": null, "git_parents": [null], "node": "8a0abab0ed6b54bde661e01261c19c608b2ef058", "parents": ["f315d49650c09ac050d71c793f868e4bdabe11b0"], "tags": []}], "date": 1632414139, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "64": {"changesets": [{"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 1716999: Hold the graph mutex when changing the observer. r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D118804", "files": ["xpcom/threads/TaskController.h"], "git_node": null, "git_parents": [null], "node": "0bbe7b7dc6a3e77df4ee75d247709dba9e137521", "parents": ["8a0abab0ed6b54bde661e01261c19c608b2ef058"], "tags": []}, {"author": "Robert Mader \u003crobert.mader@posteo.de\u003e", "branch": "default", "desc": "Bug 1714483 - Force-disable Nvidia FXAA, r=aosmond a=RyanVM\n\nWhile not enabled by default, it is openly exposed in the driver\nsettings and thus apparently not uncommon. Currently it causes\nsignificant glitches for Firefox HW-WR, but also other text focused\napps (GTK 4).\nWhile this should get fixed in the driver eventually, use the\nworkaround recommended by Nvidia to force-disable it for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125981", "files": ["gfx/thebes/gfxPlatformGtk.cpp"], "git_node": null, "git_parents": [null], "node": "0e3f13dc2d09d444a6f16b0549fcc52b4a3eac67", "parents": ["0bbe7b7dc6a3e77df4ee75d247709dba9e137521"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1730397 - Apply prost-derive fix for function name collision. r=emilio, a=RyanVM\n\nThis applies https://github.com/tokio-rs/prost/commit/edb1464b71528286a6ce74278af05f19c3e0e820\nto our copy of prost 0.6.1.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125507", "files": ["Cargo.lock", "Cargo.toml", "third_party/rust/prost-derive/src/lib.rs"], "git_node": null, "git_parents": [null], "node": "e77ed5b5ed8b1bb5d687db5d552d7c0d3646f26d", "parents": ["0e3f13dc2d09d444a6f16b0549fcc52b4a3eac67"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1730397 - Update packed_simd to a version that supports rustc \u003e= 1.56. r=hsivonen, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125604", "files": [".cargo/config.in", "Cargo.lock", "Cargo.toml", "third_party/rust/packed_simd/.cargo-checksum.json", "third_party/rust/packed_simd/Cargo.toml", "third_party/rust/packed_simd/build.rs", "third_party/rust/packed_simd/src/lib.rs"], "git_node": null, "git_parents": [null], "node": "e5a5b3cbb30ea4df57567d6c1f7a25f96dce3148", "parents": ["e77ed5b5ed8b1bb5d687db5d552d7c0d3646f26d"], "tags": []}, {"author": "Scott \u003cscott.downe@gmail.com\u003e", "branch": "default", "desc": "Bug 1724668 - Ensure Pocket panel closes if location changes with locationSpecific CustomizableUI prop. r=Gijs, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D122278", "files": ["browser/base/content/browser.js", "browser/base/content/test/tabPrompts/browser_closeTabSpecificPanels.js", "browser/components/customizableui/CustomizableUI.jsm", "browser/components/customizableui/content/panelUI.js", "browser/components/customizableui/test/browser.ini", "browser/components/customizableui/test/browser_panel_locationSpecific.js", "browser/components/pocket/content/SaveToPocket.jsm", "browser/components/pocket/test/browser_pocket_button_icon_state.js"], "git_node": null, "git_parents": [null], "node": "904824f68a9a144114a23f0fedacf51ea0df7ede", "parents": ["e5a5b3cbb30ea4df57567d6c1f7a25f96dce3148"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1726621 - ensure form validation popup always hides on tabswitches, navigations, etc., r=NeilDeakin  a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124268", "files": ["browser/actors/FormValidationParent.jsm", "browser/base/content/browser.js", "browser/base/content/main-popupset.inc.xhtml", "toolkit/components/passwordmgr/test/browser/browser_doorhanger_remembering.js", "toolkit/components/passwordmgr/test/browser/head.js", "toolkit/content/widgets/browser-custom-element.js"], "git_node": null, "git_parents": [null], "node": "611073b6e2f029fc185f8c9fd3565585e8fa20f9", "parents": ["904824f68a9a144114a23f0fedacf51ea0df7ede"], "tags": []}], "date": 1632428464, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "65": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1715755 - Part 1: Don't ignore dead actors for sync and intr messages, r=handyman a=pascalc\n\nWhen this change was first implemented, it ignored dead actors for all types of\nmessages, but for messages with replies they cannot be ignored, as a reply must\nbe sent. This should fix that oversight.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123148", "files": ["ipc/ipdl/ipdl/lower.py"], "git_node": null, "git_parents": [null], "node": "13d948df9e81c4f7c513a9e75931cf8e42f50f9f", "parents": ["611073b6e2f029fc185f8c9fd3565585e8fa20f9"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1715755 - Part 2: Recover from unhandled special messages without crashing, r=handyman a=pascalc\n\nThis change instead recovers from unhandled special messages by reporting a\nnormal IPC error, which should be handled using the normal IPC error\nmechanisms.\n\nDepends on D123148\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123149", "files": ["ipc/glue/MessageChannel.cpp"], "git_node": null, "git_parents": [null], "node": "c44b947e5236e5c247f65d31f27fdcb635cc0e17", "parents": ["13d948df9e81c4f7c513a9e75931cf8e42f50f9f"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1715755 - Part 3: Don't defer messages if the interrupt stack is empty, r=handyman a=pascalc\n\nPreviously this would misbehave as it couldn't get the interrupt stack.\n\nDepends on D123149\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123150", "files": ["ipc/glue/MessageChannel.cpp"], "git_node": null, "git_parents": [null], "node": "f8ef5376d115c5bd6a8f8eac5ada5858603a0eda", "parents": ["c44b947e5236e5c247f65d31f27fdcb635cc0e17"], "tags": []}], "date": 1632734114, "git_changesets": [null, null, null], "user": "pchevrel@mozilla.com"}, "66": {"changesets": [{"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1731538: Replace ddg favicon with a clearer one. r=adw a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126299", "files": ["browser/components/newtab/data/content/tippytop/favicons/duckduckgo-com.ico", "browser/components/search/extensions/ddg/favicon.ico"], "git_node": null, "git_parents": [null], "node": "c6d088a7eae370d2690578a66b10d655fa74d7b9", "parents": ["f8ef5376d115c5bd6a8f8eac5ada5858603a0eda"], "tags": []}], "date": 1632744966, "git_changesets": [null], "user": "pchevrel@mozilla.com"}, "67": {"changesets": [{"author": "Matt Woodrow \u003cmwoodrow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1726663 - Don't restrict fallback painting to the building rect, since it can be incorrect and is going to be removed soon. r=miko a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125002", "files": ["layout/painting/nsDisplayList.cpp", "layout/reftests/bugs/1726663-1-ref.html", "layout/reftests/bugs/1726663-1.html", "layout/reftests/bugs/reftest.list"], "git_node": null, "git_parents": [null], "node": "7243bddf915ef5a2d4b52b256b07ffd65ee432d7", "parents": ["c6d088a7eae370d2690578a66b10d655fa74d7b9"], "tags": []}], "date": 1632750739, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "68": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 7243bddf915e (bug 1726663) for build bustage.", "files": ["layout/painting/nsDisplayList.cpp", "layout/reftests/bugs/1726663-1-ref.html", "layout/reftests/bugs/1726663-1.html", "layout/reftests/bugs/reftest.list"], "git_node": null, "git_parents": [null], "node": "5d4ad120b8d41af6d9452a0572e774865f110e0e", "parents": ["7243bddf915ef5a2d4b52b256b07ffd65ee432d7"], "tags": ["FIREFOX_91_2_0esr_BUILD1", "FIREFOX_91_2_0esr_RELEASE"]}], "date": 1632751538, "git_changesets": [null], "user": "ryanvm@gmail.com"}}
}";