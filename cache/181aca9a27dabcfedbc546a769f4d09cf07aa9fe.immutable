s.mozilla.com/D257206\n\nDifferential Revision: https://phabricator.services.mozilla.com/D258842\n", "files": ["accessible/ipc/DocAccessibleParent.cpp"], "git_node": "f0ffa99195fca340f629d6923644d05926ea88b9", "git_parents": ["73e89acd89b4a9919c3e58b0450f961b2d95ef1a"], "node": "64d5ff6ffa5f6f07a895971fb21b42a1dfdf45b6", "parents": ["1a01ea283544fedfdd17f798d2099a53d49e6d27"], "tags": []}], "date": 1753735502, "git_changesets": ["f0ffa99195fca340f629d6923644d05926ea88b9"], "user": "dsmith@mozilla.com"}, "608": {"changesets": [{"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1937563 - Remove implicit dot argument for PATHEXT in mozfile  a=diannaS\n\nCertain build dependencies e.g. npm have shell scripts without file extension (for msys usage), and having dot in PATHEXT makes `shutil.which()` always prefer shell scripts even on non-msys shells.\n\nAfter this patch, such behavior should now be entirely opt-in, i.e. the callers would need to explicitly add `exts=[\".\"]` (But callers should also refrain from depending on shell scripts, as otherwise it'll fail on non-msys shells on Windows)\n\nOriginal Revision: https://phabricator.services.mozilla.com/D233086\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259183\n", "files": ["testing/mozbase/mozfile/mozfile/mozfile.py", "testing/mozbase/mozfile/tests/test_which.py"], "git_node": "dde2d0ff89d74bd03ff72003a822e8f2b689ceef", "git_parents": ["f0ffa99195fca340f629d6923644d05926ea88b9"], "node": "a3967a5c47e25baf56a66ed2122d8e48095eb67a", "parents": ["64d5ff6ffa5f6f07a895971fb21b42a1dfdf45b6"], "tags": []}], "date": 1753835760, "git_changesets": ["dde2d0ff89d74bd03ff72003a822e8f2b689ceef"], "user": "dsmith@mozilla.com"}, "609": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr128 repo-update HSTS HPKP remote-settings -  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259391\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "1ff77c8f8982f612dc349ca0b35c2ee177d4520f", "git_parents": ["dde2d0ff89d74bd03ff72003a822e8f2b689ceef"], "node": "cd31c6e1182a48d8dc0a0b2b35c3938358973b96", "parents": ["a3967a5c47e25baf56a66ed2122d8e48095eb67a"], "tags": []}], "date": 1753963146, "git_changesets": ["1ff77c8f8982f612dc349ca0b35c2ee177d4520f"], "user": "dsmith@mozilla.com"}, "610": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976782 - [esr128] Guard against possible race via gfxFontEntry::GetFontTable.  a=diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D259122\n", "files": ["gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxFontEntry.h"], "git_node": "26fa506eec1e06f457421a2f3a5d67fb932cefea", "git_parents": ["1ff77c8f8982f612dc349ca0b35c2ee177d4520f"], "node": "f5b525f4d4b143d688dd92f234b49a7433449604", "parents": ["cd31c6e1182a48d8dc0a0b2b35c3938358973b96"], "tags": []}], "date": 1753964528, "git_changesets": ["26fa506eec1e06f457421a2f3a5d67fb932cefea"], "user": "dsmith@mozilla.com"}, "611": {"changesets": [{"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 1970154 - Streams Realm Handling Improvements r=saschanaz,jonco, a=dsmith DONTBUILD\n\nMake TransferArrayBuffer cautious, and remove overzealous assert in JS_GetArrayBufferViewBuffer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D253288\n", "files": ["dom/streams/ByteStreamHelpers.cpp", "js/src/vm/ArrayBufferViewObject.cpp"], "git_node": "b42cada407b96630c039d6aa39197256f312d039", "git_parents": ["26fa506eec1e06f457421a2f3a5d67fb932cefea"], "node": "505982483c82240da88299d85c15bd8689605738", 