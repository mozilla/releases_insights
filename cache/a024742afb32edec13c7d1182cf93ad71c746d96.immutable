ml", "toolkit/components/aboutprocesses/tests/browser/head.js"], "git_node": null, "git_parents": [null], "node": "f01e39307567f6c3a35407c9f7a93e3132a24254", "parents": ["1b2978dd77fe7e534987eb67555198731f2467bd"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1663508: Handle interruptions of drag sessions more gracefully on macOS. r=mstange a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140796", "files": ["widget/cocoa/nsDragService.mm"], "git_node": null, "git_parents": [null], "node": "d6b476cadd24b6e845de7853a19e71ba62c8a58d", "parents": ["f01e39307567f6c3a35407c9f7a93e3132a24254"], "tags": []}], "date": 1647522906, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "215": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141588", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "1b21f4c7b9b703485d0cd429e9986a93a51b5e82", "parents": ["d6b476cadd24b6e845de7853a19e71ba62c8a58d"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1759506 - Avoid crashing if mReservedClientInfo already has something, r=edenchuang a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141262", "files": ["netwerk/base/LoadInfo.cpp"], "git_node": null, "git_parents": [null], "node": "f34283a3bb66e1c13fbade9b251ea5fa30963d96", "parents": ["1b21f4c7b9b703485d0cd429e9986a93a51b5e82"], "tags": []}, {"author": "Lars T Hansen \u003clhansen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1687417 - Disable static_assert on NOJIT 32-bit. r=jseward, a=RyanVM\n\nBackport for ESR91, see original patch for more discussion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141572", "files": ["js/src/wasm/WasmFrame.cpp"], "git_node": null, "git_parents": [null], "node": "93640595d8e5dbb203475a873fd4aac59a0f8f61", "parents": ["f34283a3bb66e1c13fbade9b251ea5fa30963d96"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1691774 - Check shmem allocation/mapping failures in ClientWebGLContext. r=jgilbert, a=RyanVM\n\nWe use webgl::RaiiShmem in a few places to read in pixel buffers from a\ncall to the compositor process. Shmems might fail to be mapped into our\nprocess, probably due to virtual memory constraints, and we should check\nfor that condition.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D136365", "files": ["dom/canvas/ClientWebGLContext.cpp", "dom/canvas/ClientWebGLContext.h"], "git_node": null, "git_parents": [null], "node": "fa432093d33ee67cd2074b6cf4590dd59c75e708", "parents": ["93640595d8e5dbb203475a873fd4aac59a0f8f61"], "tags": []}], "date": 1647868652, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "216": {"changesets": [{"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1758549, part 1 - Check that WebVR is enabled before creating PVR, PVRGPU and PVRLayer actors. r=jgilbert a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140784", "files": ["gfx/vr/ipc/VRGPUChild.cpp", "gfx/vr/ipc/VRGPUParent.cpp", "gfx/vr/ipc/VRLayerChild.cpp", "gfx/vr/ipc/VRManagerParent.cpp", "gfx/vr/ipc/VRProcessChild.cpp", "gfx/vr/ipc/VRProcessParent.cpp", "testing/web-platform/meta/webvr/__dir__.ini"], "git_node": null, "git_parents": [null], "node": "cbb04ded5d2a1adf5a5f274811779f9d7c8ed58a", "parents": ["fa432093d33ee67cd2074b6cf4590dd59c75e708"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1758549, part 2 - Guard a few more entry points into VRManager. r=jgilbert a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140785", "files": ["gfx/vr/VRManager.cpp"], "git_node": null, "git_parents": [null], "node": "2bb14c5df785f823ce8b982f4d9520cea4533511", "parents": ["cbb04ded5d2a1adf5a5f274811779f9d7c8ed58a"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1759432 - Don't check for the WebVR pref in VRProcessChild::Init. r=jgilbert a=RyanVM\n\nThis check seems to fail even if the VR pref is enabled. I think this is\nbecause we are running this code while very early in process startup.\nI think it will not introduce risk because the other process in this case\nwill be the parent process, so if that's been taken over then we've already\nlost.\n\nThis also seems to fix the leak that I had to ignore before, probably\nbecause the VR process wasn't even starting up properly before, so I've\nremoved the leak threshold I had to add.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141170", "files": ["gfx/vr/ipc/VRProcessChild.cpp", "testing/web-platform/meta/webvr/__dir__.ini"], "git_node": null, "git_parents": [null], "node": "2f1ede75e12bcb6090a94429dcfe2a203656f23c", "parents": ["2bb14c5df785f823ce8b982f4d9520cea4533511"], "tags": []}, {"author": "Lukas Bernhard \u003c15350042+bernhl@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1756957 - Fix AliasSet of MLoadTypedArrayElementHole - r=nbp a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D139977", "files": ["js/src/jit/MIR.h"], "git_node": null, "git_parents": [null], "node": "29f793e0f64d5c330365b04ac7cf0328c43bcfc7", "parents": ["2f1ede75e12bcb6090a94429dcfe2a203656f23c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 1757476: Align spills of ARM64 double registers r=jseward a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140372", "files": ["js/src/jit/JitFrames.cpp", "js/src/jit/JitFrames.h"], "git_node": null, "git_parents": [null], "node": "d816c9c475b1673d9dafb1683ed5533f71a393a9", "parents": ["29f793e0f64d5c330365b04ac7cf0328c43bcfc7"], "tags": []}], "date": 1647871411, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "217": {"changesets": [{"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1760604 - fix bogus domain to be example.com which is part of our test PAC rules. r=ahal a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141609", "files": ["dom/base/test/test_bug338583.html"], "git_node": null, "git_parents": [null], "node": "fa78d1b96a060e93141f4e7c84d524010d2f3ee3", "parents": ["d816c9c475b1673d9dafb1683ed5533f71a393a9"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1757376: Continue post processing of Enter key when any keyup event is detected on URL bar. r=adw a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140908", "files": ["browser/components/urlbar/UrlbarInput.jsm", "browser/components/urlbar/tests/browser/browser_enter.js"], "git_node": null, "git_parents": [null], "node": "6bd1a00584330385889e7b95494d527eff971c7c", "parents": ["fa78d1b96a060e93141f4e7c84d524010d2f3ee3"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 1757376: Continue post processing of Enter key when any keyup event is detected on search bar. r=adw a=RyanVM\n\nDepends on D140908\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141058", "files": ["browser/components/search/content/searchbar.js", "browser/components/search/test/browser/browser_searchbar_enter.js"], "git_node": null, "git_parents": [null], "node": "dd04dec4548cdb6814fac54fef3e70e185283818", "parents": ["6bd1a00584330385889e7b95494d527eff971c7c"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1757805 - Add additional assertions around shmem size, r=ipc-reviewers,handyman a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140097", "files": ["ipc/glue/Shmem.cpp", "ipc/glue/Shmem.h"], "git_node": null, "git_parents": [null], "node": "372c9410ea692d582b6c4152d0a2917b2399a36c", "parents": ["dd04dec4548cdb6814fac54fef3e70e185283818"], "tags": []}], "date": 1647966888, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "218": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141951", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "da5a65af59dd7afb0080298d01e09378721c3cf0", "parents": ["372c9410ea692d582b6c4152d0a2917b2399a36c"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1758975 - Ensure GIF color tables are opaque by default. r=tnikkel a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141176", "files": ["image/decoders/nsGIFDecoder2.cpp"], "git_node": null, "git_parents": [null], "node": "00a6ebc0c7e0eac8b80937f2ade80c5d53edc317", "parents": ["da5a65af59dd7afb0080298d01e09378721c3cf0"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1757760 retain correct search default setting after addon update r=rpl a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141294", "files": ["browser/components/extensions/parent/ext-chrome-settings-overrides.js", "browser/components/extensions/test/xpcshell/test_ext_chrome_settings_overrides_update.js"], "git_node": null, "git_parents": [null], "node": "fae4d734707890421361a73351d2e195d055ef91", "parents": ["00a6ebc0c7e0eac8b80937f2ade80c5d53edc317"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1758357 - Fix PuppetWidget::SetCursor to avoid sending cursor updates to the parent process over and over. r=mstange, a=RyanVM\n\nI accidentally regressed this in bug 1705877, so we'd always\nforce-update the cursor :(\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141863", "files": ["widget/PuppetWidget.cpp"], "git_node": null, "git_parents": [null], "node": "d277a0b059e9b01e16c1ca199701612270e4db61", "parents": ["fae4d734707890421361a73351d2e195d055ef91"], "tags": []}, {"author": "Kelsey Gilbert \u003ckelsey.gilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1744525 - Prevent too-high vert-count draws on Mesa. r=lsalzman a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141883", "files": ["dom/canvas/WebGLContextDraw.cpp"], "git_node": null, "git_parents": [null], "node": "160f7156fea4465a99bbd3ec66d50bcc9cec4a91", "parents": ["d277a0b059e9b01e16c1ca199701612270e4db61"], "tags": []}], "date": 1648129855, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "219": {"changesets": [{"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1744525 - Add missing IsMesa definition. a=bustage\n\nThis was originally added by bug 1657189 for 93+.", "files": ["gfx/gl/GLContext.h"], "git_node": null, "git_parents": [null], "node": "8b95a4976dc045e1a29ccf8352a3a4d82203fedc", "parents": ["160f7156fea4465a99bbd3ec66d50bcc9cec4a91"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1759494 - Remove some dead code introduced for PDFium. r=dholbert a=RyanVM\n\nIsSyncPagePrinting() only had one implementation which unconditionally\nreturned true.\n\nSo, any code that was conditioned on !IsSyncPagePrinting() is necessarily\ndead/unreachable.\n\nThese are also crashing due to a null deref in mPrintTarget which might\nhappen if print is aborted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D140988", "files": ["gfx/src/nsDeviceContext.cpp", "gfx/src/nsDeviceContext.h", "gfx/thebes/PrintTarget.cpp", "gfx/thebes/PrintTarget.h", "layout/printing/ipc/RemotePrintJobParent.cpp", "layout/printing/nsPrintJob.cpp"], "git_node": null, "git_parents": [null], "node": "86d8eb995abe54abe63a97fe82622f8c8b39a42d", "parents": ["8b95a4976dc045e1a29ccf8352a3a4d82203fedc"], "tags": []}], "date": 1648132205, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "220": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 8b95a4976dc0 (bug 1744525)", "files": ["gfx/gl/GLContext.h"], "git_node": null, "git_parents": [null], "node": "1a765fdc874ea3cac4c57bf8e5037d4c850382a5", "parents": ["86d8eb995abe54abe63a97fe82622f8c8b39a42d"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1744525 - Add missing IsMesa definition. a=bustage\n\nThis was originally added by bug 1657189 for 93+.", "files": ["gfx/gl/GLContext.cpp", "gfx/gl/GLContext.h"], "git_node": null, "git_parents": [null], "node": "6e352c94beadeef5e328d83dad715baefb147f85", "parents": ["1a765fdc874ea3cac4c57bf8e5037d4c850382a5"], "tags": []}], "date": 1648132515, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "221": {"changesets": [{"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1706594 - Add nsICancelable out param to nsBaseChannel::BeginAsyncRead virtual method. r=nika,valentin a=RyanVM\n\nThis patch introduces:\n\n- a second nsICancelable out param in nsBaseChannel::BeginAsyncRead, which is meant to be non-null\n  when the subclass is unable to set the nsIRequest out param right away (e.g because there is\n  some async work needed before the subclass is able to get an nsIRequest instance).\n  The nsICancelable does only allow the channel to cancel the underlying request (and stream pump),\n  but it doesn't allow the channel to be suspended and resumed, but that was already the case\n  for the subclasses that were already not returning an nsIRequest instance (e.g. like the\n  ExtensionProtocolHandler was doing when it is asynchrously retriving a stream from the parent\n  process).\n\n- require NotNull\u003cnsCOMPtr\u003c...\u003e\u003e in the SimpleChannel's BeginAsyncRead callback signature, to make harder\n  to overlook the requirement of returning an nsIRequest or nsICancelable.\n\n- a diagnostic assertion (from SimpleChannel's BeginAsyncRead method) to more visible fail if we still end\n  up with neither an nsIRequest or nsICancelable result as SimpleChannel callback result.\n\n- changes to ExtensionProtocolHandler, PageThumbProtocolHandler and nsAnnoProtocolHandler to adapt them\n  to the new nsBaseChannel::BeginAsyncRead signature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D125545", "files": ["netwerk/base/SimpleChannel.cpp", "netwerk/base/SimpleChannel.h", "netwerk/base/nsBaseChannel.cpp", "netwerk/base/nsBaseChannel.h", "netwerk/protocol/res/ExtensionProtocolHandler.cpp", "netwerk/protocol/res/PageThumbProtocolHandler.cpp", "toolkit/components/places/nsAnnoProtocolHandler.cpp"], "git_node": null, "git_parents": [null], "node": "fbb18fe4cd500ad94582d4bffb3d7bee6abc8088", "parents": ["6e352c94beadeef5e328d83dad715baefb147f85"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1735899 - Make sure RemoteLazyInputStream::Close calls mInputStreamCallback OnInputStreamReady method. r=nika, a=RyanVM\n\nRemoteLazyInputStream::Close was not setting mInputStreamCallback to a nullptr without using it in the\nInputStreamCallbackRunnable::Execute, which would be calling OnInputStreamReady on the mInputStreamCallback.\n\nThis does also match the details we gathered while investigating the bug (which was triggered exactly by a remote\nlazy stream getter that did never got to call OnInputStreamReady by the time we were closing the channel).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129374", "files": ["dom/file/ipc/RemoteLazyInputStream.cpp"], "git_node": null, "git_parents": [null], "node": "f329065ab096c6c6cda1c46b9cb5526c26725219", "parents": ["fbb18fe4cd500ad94582d4bffb3d7bee6abc8088"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1735899 - Cover the browserAction popup preload with a smoketest. r=mixedpuppy, a=RyanVM\n\nThis patch includes a new test file to cover a scenario similar to the one\nfixed in Bug 1735899, and possibly some other similar ones that may slip\nthrough unnoticed.\n\nThis test triggers the issue consistently on a build where the fix\nis not included and pass consistently in build including the fix,\nbut even if it doesn't include any arbitrary timeouts to trigger the\nissue there is still a chance that the test may start to fail\nintermittently for some other reasons.\n\nKeeping it as a separate test file will make it easier to disable it\nas a temporary measure if turns out to be necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D132267", "files": ["browser/components/extensions/test/browser/browser.ini", "browser/components/extensions/test/browser/browser_ext_browserAction_popup_preload_smoketest.js"], "git_node": null, "git_parents": [null], "node": "9d49bb0cdd2a8799fd778633bb9867cf6acea0ba", "parents": ["f329065ab096c6c6cda1c46b9cb5526c26725219"], "tags": []}, {"author": "Miko Mynttinen \u003cmikokm@gmail.com\u003e", "branch": "default", "desc": "Bug 1735265 - Part 1: Set clip on background items for table cols and colgroups, when the table cell has captured clip. r=mstange, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129681", "files": ["layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableFrame.cpp", "layout/tables/nsTableFrame.h"], "git_node": null, "git_parents": [null], "node": "aa53a3f7fa5115faa69668e3b5cee9e881fa9f03", "parents": ["9d49bb0cdd2a8799fd778633bb9867cf6acea0ba"], "tags": []}, {"author": "Miko Mynttinen \u003cmikokm@gmail.com\u003e", "branch": "default", "desc": "Bug 1735265 - Part 2: Add test. r=mstange, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D129682", "files": ["layout/reftests/bugs/1735265-1-ref.html", "layout/reftests/bugs/1735265-1.html", "layout/reftests/bugs/reftest.list"], "git_node": null, "git_parents": [null], "node": "333794dc5892259730cd7cdd66e17e3d5d072ac6", "parents": ["aa53a3f7fa5115faa69668e3b5cee9e881fa9f03"], "tags": []}], "date": 1648243934, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "222": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr91 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142196", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/search-config.json", "services/settings/dumps/security-state/intermediates.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": null, "git_parents": [null], "node": "4dae981fb2894c84fcd9bf74dda24ee821353700", "parents": ["333794dc5892259730cd7cdd66e17e3d5d072ac6"], "tags": []}, {"author": "John Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1760872 - land NSS NSS_3_68_3_RTM UPGRADE_NSS_RELEASE, r=djackson a=RyanVM\n\n2022-03-23  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/dev/dev.h, lib/dev/devslot.c, lib/dev/devt.h,\n\tlib/dev/devtoken.c, lib/pk11wrap/dev3hack.c:\n\tBug 1756271 - Remove token member from NSSSlot struct. r=rrelyea\n\n\t[e3da860d9d1c] [NSS_3_68_3_RTM] \u003cNSS_3_68_3_BRANCH\u003e\n\n2022-02-24  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/pki/trustdomain.c:\n\tBug 1755555 - Hold tokensLock through nssToken_GetSlot calls in\n\tnssTrustDomain_GetActiveSlots. r=rrelyea\n\n\t[1931b2b09b55] \u003cNSS_3_68_3_BRANCH\u003e\n\n2022-02-23  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/certdb/crl.c, lib/certdb/stanpcertdb.c, lib/dev/devtoken.c,\n\tlib/dev/devutil.c, lib/pk11wrap/pk11auth.c, lib/pk11wrap/pk11cert.c,\n\tlib/pk11wrap/pk11nobj.c, lib/pk11wrap/pk11slot.c,\n\tlib/pk11wrap/pk11util.c, lib/pk11wrap/secmodti.h,\n\tlib/pki/pki3hack.c, lib/pki/trustdomain.c:\n\tBug 1370866 - Check return value of PK11Slot_GetNSSToken. r=djackson\n\n\t[ba0086e6737d] \u003cNSS_3_68_3_BRANCH\u003e\n\n2022-03-25  John M. Schanck  \u003cjschanck@mozilla.com\u003e\n\n\t* lib/nss/nss.h, lib/softoken/softkver.h, lib/util/nssutil.h:\n\tSet version numbers to 3.68.3 final\n\t[c7b7c2f03ef2] \u003cNSS_3_68_3_BRANCH\u003e\n\n2021-12-15  Benjamin Beurdouche  \u003cbbeurdouche@mozilla.com\u003e\n\n\t* .hgtags:\n\tAdded tag NSS_3_68_2_RTM for changeset 78d2f4a3339f\n\t[c55cf4a0cb0e] \u003cNSS_3_68_2_BRANCH\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142237", "files": ["security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/lib/certdb/crl.c", "security/nss/lib/certdb/stanpcertdb.c", "security/nss/lib/dev/dev.h", "security/nss/lib/dev/devslot.c", "security/nss/lib/dev/devt.h", "security/nss/lib/dev/devtoken.c", "security/nss/lib/dev/devutil.c", "security/nss/lib/nss/nss.h", "security/nss/lib/pk11wrap/dev3hack.c", "security/nss/lib/pk11wrap/pk11auth.c", "security/nss/lib/pk11wrap/pk11cert.c", "security/nss/lib/pk11wrap/pk11nobj.c", "security/nss/lib/pk11wrap/pk11slot.c", "security/nss/lib/pk11wrap/pk11util.c", "security/nss/lib/pk11wrap/secmodti.h", "security/nss/lib/pki/pki3hack.c", "security/nss/lib/pki/trustdomain.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "d8503523b4cc610ec3bade0787f200afdef738e6", "parents": ["4dae981fb2894c84fcd9bf74dda24ee821353700"], "tags": []}], "date": 1648502217, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "223": {"changesets": [{"author": "Mark Adler \u003cmadler@alumni.caltech.edu\u003e", "branch": "default", "desc": "Bug 1761799 - Fix a bug that can crash deflate on some input when using Z_FIXED. r=tjr a=dmeehan\n\nThis bug was reported by Danilo Ramos of Eideticom, Inc. It has\nlain in wait 13 years before being found! The bug was introduced\nin zlib 1.2.2.2, with the addition of the Z_FIXED option. That\noption forces the use of fixed Huffman codes. For rare inputs with\na large number of distant matches, the pending buffer into which\nthe compressed data is written can overwrite the distance symbol\ntable which it overlays. That results in corrupted output due to\ninvalid distances, and can result in out-of-bound accesses,\ncrashing the application.\n\nThe fix here combines the distance buffer and literal/length\nbuffers into a single symbol buffer. Now three bytes of pending\nbuffer space are opened up for each literal or length/distance\npair consumed, instead of the previous two bytes. This assures\nthat the pending buffer cannot overwrite the symbol table, since\nthe maximum fixed code compressed length/distance is 31 bits, and\nsince there are four bytes of pending space for every three bytes\nof symbol space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142231", "files": ["modules/zlib/src/ChangeLog.moz", "modules/zlib/src/deflate.c", "modules/zlib/src/deflate.h", "modules/zlib/src/trees.c"], "git_node": null, "git_parents": [null], "node": "d64927492c807ff322fabd06688369bcb2730602", "parents": ["d8503523b4cc610ec3bade0787f200afdef738e6"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1762128 - bump the cache name for decision images to stop interfering with other trees. r=releng-reviewers,ahal a=release\n\nhg 4.8 (e.g. from the v3.0.1 decision image) seems to choke on cached repos\ncreated with 5.8 (from v4.0.0).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D142455", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "8c09f2e41217912cd30ff29bccc2f7141a05ad95", "parents": ["d64927492c807ff322fabd06688369bcb2730602"], "tags": []}], "date": 1648647963, "git_changesets": [null, null], "user": "dmeehan@mozilla.com"}, "224": {"changesets": [{"author": "donal meehan \u003cdmeehan@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset 8c09f2e41217 (bug 1762128) issue in the build pipeline only affects central not esr", "files": [".taskcluster.yml"], "git_node": null, "git_parents": [null], "node": "8bf5927e8f7603a154d4d98b9ee05e6feafdb3ed", "parents": ["8c09f2e41217912cd30ff29bccc2f7141a05ad95"], "tags": []}], "date": 1648648905, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "225": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 1761026 - Add a null check for FetchDriver::mResponse, r=necko-reviewers,dragana a=dmeehan\n\nThis patch adds a null check to avoid crashing when `mResponse` is null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D141911", "files": ["dom/fetch/FetchDriver.cpp"], "git_node": null, "git_parents": [null], "node": "3b54d6b5407fca03efdb2e2f57a9838498e0d038", "parents": ["8bf5927e8f7603a154d4d98b9ee05e6feafdb3ed"], "tags": ["FIREFOX_91_8_0esr_BUILD1", "FIREFOX_91_8_0esr_RELEASE"]}], "date": 1648653398, "git_changesets": [null], "user": "dmeehan@mozilla.com"}}
}";