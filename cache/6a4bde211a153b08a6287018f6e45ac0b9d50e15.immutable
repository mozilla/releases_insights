2590f", "parents": ["30df855d4556acc027ce764e27a98505e67f6877"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1748325 - Move EGL_EXT_device_query from device exts to client exts. r=lsalzman, a=RyanVM\n\nThis moved due to a fix in ANGLE 56663dbfa78 on 2020-nov-19.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134996", "files": ["gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp"], "git_node": null, "git_parents": [null], "node": "c5927b82cfc552d172607690766ebcc5f3c6e57a", "parents": ["34c1880804abe97d85b9011365954173ebb2590f"], "tags": []}, {"author": "Jeff Gilbert \u003cjgilbert@mozilla.com\u003e", "branch": "default", "desc": "Bug 1748325 - [ANGLE] Add system_utils_apple too. r=mstange, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134997", "files": ["gfx/angle/checkout/src/common/system_utils_apple.cpp", "gfx/angle/targets/angle_common/moz.build", "gfx/angle/update-angle.py"], "git_node": null, "git_parents": [null], "node": "2dd0b56644bc13cf6451a582cce07787f0b394c5", "parents": ["c5927b82cfc552d172607690766ebcc5f3c6e57a"], "tags": []}, {"author": "Mitchell Hentges \u003cmhentges@mozilla.com\u003e", "branch": "default", "desc": "Bug 1731524: Updating ANGLE requires a clobber. r=jgilbert, a=NPOTB\n\nDifferential Revision: https://phabricator.services.mozilla.com/D126245", "files": ["CLOBBER"], "git_node": null, "git_parents": [null], "node": "eb88e94e38c67b5da8c333a80fe64b022b8306da", "parents": ["2dd0b56644bc13cf6451a582cce07787f0b394c5"], "tags": []}, {"author": "Robert Mader \u003crobert.mader@posteo.de\u003e", "branch": "default", "desc": "Bug 1739476 - Check xrandr server version before using it. r=stransky, a=RyanVM\n\nWhile we require libxrandr \u003e= 1.4 to be present, the actual server\nversion can be lower. On remote X11 it appears to be stuck at 1.1,\ncrashing when trying to use API from higher version.\n\nThere are still setups using remote X11 out there, so add some server\nversion checks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135085", "files": ["toolkit/xre/glxtest.cpp"], "git_node": null, "git_parents": [null], "node": "c000b0edc1b92c97e802ea272a38da871031146d", "parents": ["eb88e94e38c67b5da8c333a80fe64b022b8306da"], "tags": []}], "date": 1641393957, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "134": {"changesets": [{"author": "Brendan Dahl \u003cbrendan.dahl@gmail.com\u003e", "branch": "default", "desc": "Bug 1748536 - Update ESR to pdf.js version 2.12.70. r=calixte, a=RyanVM\n\nIncludes revert of pdf.js aae8a2128685f4af94bee2466096bdc2473c0ba7.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135086", "files": ["browser/locales/en-US/pdfviewer/viewer.properties", "browser/locales/l10n-changesets.json", "toolkit/components/pdfjs/README.mozilla", "toolkit/components/pdfjs/content/build/pdf.js", "toolkit/components/pdfjs/content/build/pdf.scripting.js", "toolkit/components/pdfjs/content/build/pdf.worker.js", "toolkit/components/pdfjs/content/web/images/secondaryToolbarButton-scrollPage.svg", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.html", "toolkit/components/pdfjs/content/web/viewer.js", "toolkit/components/pdfjs/moz.yaml"], "git_node": null, "git_parents": [null], "node": "a015d17e786caa7fa23f6d8c3404a9b43d1dd314", "parents": ["c000b0edc1b92c97e802ea272a38da871031146d"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1735856 - Don't trigger violation events for frame-ancestors r=freddyb, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134145", "files": ["dom/security/nsCSPContext.cpp", "testing/web-platform/meta/content-security-policy/frame-ancestors/frame-ancestors-none-block.html.ini"], "git_node": null, "git_parents": [null], "node": "f5701faab5816b6605293bb4e998f4608957aa05", "parents": ["a015d17e786caa7fa23f6d8c3404a9b43d1dd314"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1737816 - Handle truncated mp3 resources. r=bryce, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133645", "files": ["dom/media/mp3/MP3Demuxer.cpp"], "git_node": null, "git_parents": [null], "node": "d39b3f8cdf1eb4d946d2084d4ce0bf1f101c7e9a", "parents": ["f5701faab5816b6605293bb4e998f4608957aa05"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 1746011 - Handle truncated ADTS stream. r=bryce, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133997", "files": ["dom/media/ADTSDemuxer.cpp"], "git_node": null, "git_parents": [null], "node": "e47b5b8be2786fd0d7be288ee471a58840fd345a", "parents": ["d39b3f8cdf1eb4d946d2084d4ce0bf1f101c7e9a"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1745874 - only recreate and start media sink when it's not running. r=bryce, a=RyanVM", "files": ["dom/media/MediaDecoderStateMachine.cpp"], "git_node": null, "git_parents": [null], "node": "c50ba4894d4649ecefcb78c8a1f3e233544c5f6f", "parents": ["e47b5b8be2786fd0d7be288ee471a58840fd345a"], "tags": []}], "date": 1641398663, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "135": {"changesets": [{"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1639850 - disable many testing/xpcshell/example/unit xpcshell tests on windows debug. r=bhearsum, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D121572", "files": ["testing/xpcshell/example/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "52ff5fcaa9db8e88c4fa28b5dfcf9265cb82fd68", "parents": ["c50ba4894d4649ecefcb78c8a1f3e233544c5f6f"], "tags": []}, {"author": "Joel Maher \u003cjmaher@mozilla.com\u003e", "branch": "default", "desc": "Bug 1639850 - adjust xpcshell on windows to remove frequent failures. r=gbrown, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D133119", "files": ["docshell/test/unit/xpcshell.ini", "taskcluster/ci/test/xpcshell.yml", "testing/mozharness/scripts/desktop_unittest.py", "toolkit/components/filewatcher/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "96a5fed7ba836fc8edc35718b6d7c2c05906709e", "parents": ["52ff5fcaa9db8e88c4fa28b5dfcf9265cb82fd68"], "tags": []}, {"author": "Andreea Pavel \u003capavel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1719949 - disable browser_downloads_panel_context_menu.js on win10 not debug. r=jmaher, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D123905", "files": ["browser/components/downloads/test/browser/browser.ini"], "git_node": null, "git_parents": [null], "node": "e382d2e92e36cbf46f499063d9a245df97b466f7", "parents": ["96a5fed7ba836fc8edc35718b6d7c2c05906709e"], "tags": []}, {"author": "Andreea Pavel \u003capavel@mozilla.com\u003e", "branch": "default", "desc": "Bug 1638958 - disable browser_label_and_icon.js on win10_2004 not debug. r=bhearsum, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D124585", "files": ["browser/components/sessionstore/test/browser.ini"], "git_node": null, "git_parents": [null], "node": "cf3f760497d24f77dd02a1192e797f07d2fe7ffc", "parents": ["e382d2e92e36cbf46f499063d9a245df97b466f7"], "tags": []}, {"author": "Butkovits Atila \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Bug 1484212 - disable browser_test_focus_dialog.js on Win_64_qr_opt for frequent failures. r=ahal, a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D120205", "files": ["accessible/tests/browser/events/browser.ini"], "git_node": null, "git_parents": [null], "node": "a52b19015bf399ebb7994429723b51bf096ad73c", "parents": ["cf3f760497d24f77dd02a1192e797f07d2fe7ffc"], "tags": []}], "date": 1641408375, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "136": {"changesets": [{"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1748230 - fix conduit API error marking old repo-update revisions as abandoned. r=jmaher, a=NPOTB\n\nconduit transactions need both a type and value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D134953", "files": ["taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh"], "git_node": null, "git_parents": [null], "node": "763840ede10bd7945926644476a666b6c12e87ca", "parents": ["a52b19015bf399ebb7994429723b51bf096ad73c"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1739888 - allow offline website data checkbox label in prefs' sanitize (clear recent history) dialog to wrap, r=jaws, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D132964", "files": ["browser/components/preferences/dialogs/sanitize.xhtml"], "git_node": null, "git_parents": [null], "node": "a9b1378e1987d5c35d894e91fafe19923ff67d15", "parents": ["763840ede10bd7945926644476a666b6c12e87ca"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1731430 - detect and discard the partial AAC output samples on Windows MFT decoder. r=bryce,padenot a=RyanVM\n\nOn Windows 11, we found a bug in MFT decoder, when calling draining multiple times, even if there is nothing to drain, the decoder doesn't return `MF_E_TRANSFORM_NEED_MORE_INPUT`, but return an invalid sample instead. The decoder will also return another invalid sample after draining, those two samples are all partial size and combining them together makes the perfect size.\n\nThose invalid samples are all silence and make us have a lots those samples whenever we drain the decoder, which causes audio stuttering. Therefore, we want to ignore those invalid samples.\n\nAt the time we wrote this patch, there is no any API to detect whether users are using Windows 11 or not, so we aren't able to make the change only happening on Windows 11 enviroment.\n\nMore details could be found in [1].\n\n[1] https://bugzilla.mozilla.org/show_bug.cgi?id=1731430#c26\n\nDifferential Revision: https://phabricator.services.mozilla.com/D128549", "files": ["dom/media/platforms/wmf/WMFAudioMFTManager.cpp", "dom/media/platforms/wmf/WMFAudioMFTManager.h"], "git_node": null, "git_parents": [null], "node": "38e8f961880755e90941e5cfa3ff9147540c4833", "parents": ["a9b1378e1987d5c35d894e91fafe19923ff67d15"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1745373 - Avoid copying blob payload when serializing over IPC, r=mccr8 a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D135083", "files": ["dom/file/MemoryBlobImpl.cpp", "dom/file/MemoryBlobImpl.h"], "git_node": null, "git_parents": [null], "node": "28571c2eb9624cfc7842c8f20a7c4682e8f4d3af", "parents": ["38e8f961880755e90941e5cfa3ff9147540c4833"], "tags": ["FIREFOX_91_5_0esr_BUILD1", "FIREFOX_91_5_0esr_RELEASE"]}], "date": 1641417706, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}}
}";