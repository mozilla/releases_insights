 https://phabricator.services.mozilla.com/D312026\n", "files": ["gfx/thebes/gfxFont.cpp", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxGraphiteShaper.cpp"], "git_node": "81347ec46a04a0094546e2adf25c72583ff9cc81", "git_parents": ["5a23d11c788a6d06f4e5260d319166797d551d5e"], "node": "db7f191c64b1bdeac3f1f8c1fdc689e279730b05", "parents": ["49fd33be9fba2c7a433143797e9acec17d9529f9"], "tags": []}], "date": 1784025338, "git_changesets": ["81347ec46a04a0094546e2adf25c72583ff9cc81"], "user": "pchevrel@mozilla.com"}, "1420": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053273 - Check for excessive nGlyphs count from graphite shaper. a=pascalc\n\nReland of the change backed out in 5a23d11c788a. The esr115 CI bustage\nthat prompted the backout was an infrastructure issue in the test-harness\nvirtualenv (idna not importable after loosely-pinned Python deps drifted\non the pip mirror), not a regression from this patch. The failure occurred\nduring mozinstall, before Firefox was ever installed or launched, so this\ngfx change could not have caused it.\n", "files": ["gfx/thebes/gfxGraphiteShaper.cpp"], "git_node": "6e7b62ef4d227fac6dd41c849035da55a889e24f", "git_parents": ["81347ec46a04a0094546e2adf25c72583ff9cc81"], "node": "cd6c8859dab2132605975192fc230dfd7dc603ec", "parents": ["db7f191c64b1bdeac3f1f8c1fdc689e279730b05"], "tags": []}], "date": 1784025972, "git_changesets": ["6e7b62ef4d227fac6dd41c849035da55a889e24f"], "user": "pchevrel@mozilla.com"}, "1421": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037909 - Check the default font's Family is initialized before trying to look up the face, to ensure we have a usable default font.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D299492\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312031\n", "files": ["gfx/thebes/gfxPlatformFontList.cpp"], "git_node": "f979b115eca000e6342586a0d59f354d1f00eb18", "git_parents": ["6e7b62ef4d227fac6dd41c849035da55a889e24f"], "node": "608470f1bbb7b48b16986c562083c3333d1d803c", "parents": ["cd6c8859dab2132605975192fc230dfd7dc603ec"], "tags": []}], "date": 1784029233, "git_changesets": ["f979b115eca000e6342586a0d59f354d1f00eb18"], "user": "pchevrel@mozilla.com"}, "1422": {"changesets": [{"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030362: CachedTableAccessible: Never descend into nested tables.  a=pascalc\n\nThis could only happen due to incorrect authoring where a table was nested inside another table without an intervening cell.\nEven so, we should never treat cells in a nested table as part of an ancestor table.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311450\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312001\n", "files": ["accessible/base/CachedTableAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/tests/browser/e10s/browser_caching_table.js"], "git_node": "b12274b8290a5734b822d7ef540cf84040424db9", "git_parents": ["f979b115eca000e6342586a0d59f354d1f00eb18"], "node": "e58c0573609975a17276508550bbc6f7522de8c4", "parents": ["608470f1bbb7b48b16986c562083c3333d1d803c"], "tags": []}], "date": 1784029835, "git_changesets": ["b12274b8290a5734b822d7ef540cf84040424db9"], "user": "pchevrel@mozilla.com"}, "1423": {"changesets": [{"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053326 - Check size_t range in ParseVariationDataSubtable.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311039\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312021\n", "files": ["gfx/ots/src/variations.cc"], "git_node": "1a02941d52c3487276a93bec139b53b8347987f6", "git_parents": ["b12274b8290a5734b822d7ef540cf84040424db9"], "node": "826980ac8a79c4555b61990871cc86cf2c66a757", "parents": ["e58c0573609975a17276508550bbc6f7522de8c4"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053326 - Check offset computations in ItemVariationData::Validate.  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311040\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312022\n", "files": ["gfx/thebes/COLRFonts.cpp"], "git_node": "8683f5a7e4a186b6aa8ffffec13fd56b3cc791b7", "git_parents": ["1a02941d52c3487276a93bec139b53b8347987f6"], "node": "12c531ddbd2bfe05d15ea89a5124a4469c3ddcb4", "parents": ["826980ac8a79c4555b61990871cc86cf2c66a757"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053326 - Also range-check the deltaData during ApplyVariation().  a=pascalc\n\nOriginal Revision: https://phabricator.services.mozilla.com/D311070\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312023\n", "files": ["gfx/thebes/COLRFonts.cpp"], "git_node": "2a59f99cbccb2cef10f9bb199a43bb110ed530b1", "git_parents": ["8683f5a7e4a186b6aa8ffffec13fd56b3cc791b7"], "node": "dc2e1feb9f65382fef1a8f6e57a35f491f05bdc7", "parents": ["12c531ddbd2bfe05d15ea89a5124a4469c3ddcb4"], "tags": []}], "date": 1784031189, "git_changesets": ["1a02941d52c3487276a93bec139b53b8347987f6", "8683f5a7e4a186b6aa8ffffec13fd56b3cc791b7", "2a59f99cbccb2cef10f9bb199a43bb110ed530b1"], "user": "pchevrel@mozilla.com"}, "1424": {"changesets": [{"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046144 - Route ESR115 Windows 11 GPU tests to win10-64-2009-gpu  a=pascalc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307415\n", "files": ["taskcluster/ci/config.yml", "taskcluster/gecko_taskgraph/transforms/test/worker.py"], "git_node": "fd50fd7dfa719eb438c846fadc751772ddf21370", "git_parents": ["2a59f99cbccb2cef10f9bb199a43bb110ed530b1"], "node": "26afe34e3f3ea7d95ced464c3df3d0a96fe87193", "parents": ["dc2e1feb9f65382fef1a8f6e57a35f491f05bdc7"], "tags": []}], "date": 1784031389, "git_changesets": ["fd50fd7dfa719eb438c846fadc751772ddf21370"], "user": "pchevrel@mozilla.com"}, "1425": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046144 - Route ESR115 Windows 11 GPU tests to win10-64-2009-gpu a=pascalc\" punted to next cycle a=pascalc\n\nThis reverts commit fd50fd7dfa719eb438c846fadc751772ddf21370.\n", "files": ["taskcluster/ci/config.yml", "taskcluster/gecko_taskgraph/transforms/test/worker.py"], "git_node": "e24b26fcf40f39cb30ad0c11a67509740625f24b", "git_parents": ["fd50fd7dfa719eb438c846fadc751772ddf21370"], "node": "ae21bc4fa314d25e9823afba381d6d82f08bca83", "parents": ["26afe34e3f3ea7d95ced464c3df3d0a96fe87193"], "tags": []}], "date": 1784033726, "git_changesets": ["e24b26fcf40f39cb30ad0c11a67509740625f24b"], "user": "pchevrel@mozilla.com"}, "1426": {"changesets": [{"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 1868690: add --no-use-pep517 and remove two_pass from mozbase  a=pascalc\n\nThis seems to work around an issue we've been seeing on some Windows workers where locally built wheels end up with unreadable or missing metadata. I don't know exactly why that's happening, but based on some research it looks like this hack prevents us from hitting it elsewhere, due to not using pep517 for builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312060\n", "files": ["testing/mozharness/mozharness/base/python.py", "testing/mozharness/mozharness/mozilla/mozbase.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/mozharness/mozharness/mozilla/testing/talos.py", "testing/mozharness/scripts/android_emulator_unittest.py", "testing/mozharness/scripts/android_hardware_unittest.py", "testing/mozharness/scripts/awsy_script.py", "testing/mozharness/scripts/desktop_unittest.py", "testing/mozharness/scripts/firefox_ui_tests.py", "testing/mozharness/scripts/marionette.py", "testing/mozharness/scripts/telemetry/telemetry_client.py", "testing/mozharness/scripts/web_platform_tests.py", "uv.lock"], "git_node": "30ca65faeb6f3446345621c745b4f3141a8b008d", "git_parents": ["e24b26fcf40f39cb30ad0c11a67509740625f24b"], "node": "a281ccada8710de5ac98302d15e6229a6f6a85ff", "parents": ["ae21bc4fa314d25e9823afba381d6d82f08bca83"], "tags": []}], "date": 1784047294, "git_changesets": ["30ca65faeb6f3446345621c745b4f3141a8b008d"], "user": "pchevrel@mozilla.com"}, "1427": {"changesets": [{"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055030 - Skip linux32 and win64-aarch64 when populating release history, r=releng-reviewers,bhearsum a=pascalc\n\nAlso skip them in the balrog tasks, so next time they are ommitted from\nthe release blobs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312124\n", "files": ["taskcluster/ci/release-balrog-submit-toplevel/kind.yml", "taskcluster/gecko_taskgraph/util/partials.py"], "git_node": "0f31d82db378364f5af385142fbacb85cb3f482d", "git_parents": ["30ca65faeb6f3446345621c745b4f3141a8b008d"], "node": "78a6c0cbea6b49277aba0b961bdc3c88cf8c78aa", "parents": ["a281ccada8710de5ac98302d15e6229a6f6a85ff"], "tags": []}], "date": 1784058689, "git_changesets": ["0f31d82db378364f5af385142fbacb85cb3f482d"], "user": "pchevrel@mozilla.com"}, "1428": {"changesets": [{"author": "Pascal Chevrel \u003cpascal@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1868690: add --no-use-pep517 and remove two_pass from mozbase a=pascalc\" for build failures a=backout\n\nThis reverts commit 30ca65faeb6f3446345621c745b4f3141a8b008d.\n", "files": ["testing/mozharness/mozharness/base/python.py", "testing/mozharness/mozharness/mozilla/mozbase.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/mozharness/mozharness/mozilla/testing/talos.py", "testing/mozharness/scripts/android_emulator_unittest.py", "testing/mozharness/scripts/an