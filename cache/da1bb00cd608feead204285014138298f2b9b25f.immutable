illa.com\u003e", "branch": "default", "desc": "Bug 1376399 - Hard crash in FF 54 and Nightly 56 on Windows 7. r=jgilbert, a=jcristau", "files": ["gfx/angle/src/libANGLE/renderer/d3d/d3d11/Context11.cpp", "gfx/angle/src/libGLESv2/entry_points_gles_2_0.cpp"], "git_node": null, "git_parents": [null], "node": "58a574502ca92bc1ee8a744541a9edac9f07d08a", "parents": ["113da8d46aa40e2627036f7ba9648d0fc17bd538"], "tags": []}, {"author": "Kris Maglione \u003cmaglione.k@gmail.com\u003e", "branch": "default", "desc": "Bug 1396570 - Null check getter/setter when JSPROP_GETTER/JSPROP_SETTER is set. r=bholley, f=jandem, a=jcristau\n\nThese flags don't guarantee that the getter and setter functions are defined.\n\nMozReview-Commit-ID: GBcoRYoKHqL", "files": ["js/xpconnect/wrappers/XrayWrapper.cpp"], "git_node": null, "git_parents": [null], "node": "24db61862c543397c5da17cb09a34c3d95061509", "parents": ["58a574502ca92bc1ee8a744541a9edac9f07d08a"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1380292 - Don't turn on object resizer, inline table editor and etc when element isn't into editor. r=masayuki, a=jcristau", "files": ["editor/libeditor/HTMLAbsPositionEditor.cpp", "editor/libeditor/HTMLEditorObjectResizer.cpp", "editor/libeditor/HTMLInlineTableEditor.cpp"], "git_node": null, "git_parents": [null], "node": "1a02f11c6efecd6b5550ffcffdb4e38e6fe170cf", "parents": ["24db61862c543397c5da17cb09a34c3d95061509"], "tags": []}, {"author": "Andreas Pehrson \u003cpehrsons@mozilla.com\u003e", "branch": "default", "desc": "Bug 1360334 - Improve error handling. r=padenot, a=jcristau\n\nMozReview-Commit-ID: HnM0FgG368J", "files": ["dom/media/GraphDriver.cpp", "dom/media/GraphDriver.h"], "git_node": null, "git_parents": [null], "node": "002686d9536fabc0ded331cafc669dcc7d99caf8", "parents": ["1a02f11c6efecd6b5550ffcffdb4e38e6fe170cf"], "tags": []}], "date": 1505148417, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7300": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "f8202c7b4d50a2d186f2b09fd1b9f09bef31d3b4", "parents": ["002686d9536fabc0ded331cafc669dcc7d99caf8"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-302 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "df712e0256c11e22d9661d55134413ae0443c4ff", "parents": ["f8202c7b4d50a2d186f2b09fd1b9f09bef31d3b4"], "tags": []}], "date": 1505150813, "git_changesets": [null, null], "user": "ffxbld"}, "7301": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "2c42a5f37d81c1ab0552b598d63534ac0c58eb81", "parents": ["df712e0256c11e22d9661d55134413ae0443c4ff"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-303 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "42d9e540c0f3cb3e89f49bc80866d5894af1da40", "parents": ["2c42a5f37d81c1ab0552b598d63534ac0c58eb81"], "tags": []}], "date": 1505237230, "git_changesets": [null, null], "user": "ffxbld"}, "7302": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-305 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "cc66e8b31a93aec851bb44b9071946b9a5fe7ff7", "parents": ["42d9e540c0f3cb3e89f49bc80866d5894af1da40"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-305 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "83d8dd419f6ec08731def2a24602bfc234672cf5", "parents": ["cc66e8b31a93aec851bb44b9071946b9a5fe7ff7"], "tags": []}], "date": 1505323280, "git_changesets": [null, null], "user": "ffxbld"}, "7303": {"changesets": [{"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1389974 - \"Fix\" false positive rooting hazard in ArrayInfo(). r=jonco, a=jcristau\n\nA hazard is reported where on one iteration through the loop over the arguments, obj is set to a JSObject*. Then on the next iteration, the analysis incorrectly things that the if test could skip overwriting obj, and instead call as() on the previous iteration's value. This turns out to be impossible because reaching as() requires the if condition to be false, which means that both branches of the or are evaluated, and the second branch assigns to obj.\n\nIt seems like the call to as() should be dominated by the obj assignment, but in practice the compiler assigns to a temporary boolean variable and then tests it, so in terms of control flow only the as() call is *not* dominated by the obj assignment.\n\nThis patch just roots obj.\n***\nBug 1389974 - Avoid taking reference to temporary Value because it hides from hazard analysis, r=jonco\n***\nBug 1389974 - Rooting fixes for nsJSNPRuntime.cpp, r=froydnj\n***\nBug 1389974 - Annotate nsIScriptSecurityManager.IsSystemPrincipal, r=jonco\n***\nBug 1389974 - Do not require ffi_call to exist, r=jonco\n***\nBug 1389974 - Remove the implication that killing a value overrides using it, r=bhackett", "files": ["dom/plugins/base/nsJSNPRuntime.cpp", "js/src/devtools/rootAnalysis/analyzeRoots.js", "js/src/devtools/rootAnalysis/annotations.js", "js/src/devtools/rootAnalysis/loadCallgraph.js", "js/src/devtools/rootAnalysis/t/hazards/source.cpp", "js/src/devtools/rootAnalysis/t/hazards/test.py", "js/src/jsarray.cpp"], "git_node": null, "git_parents": [null], "node": "eaadb31758d8870fde4927bb8e4cacc62fabb9f1", "parents": ["83d8dd419f6ec08731def2a24602bfc234672cf5"], "tags": []}], "date": 1505327027, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7304": {"changesets": [{"author": "Frank-Rainer Grahl \u003cfrgrahl@gmx.net\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Backed out changeset: 21af4e17cbf9 (Bug 1338655) in TB 52 relbranch for causing Bug 1399690 a=jorgk", "files": ["media/libstagefright/binding/mp4parse-cargo.patch", "media/libstagefright/binding/mp4parse_capi/Cargo.toml"], "git_node": null, "git_parents": [null], "node": "c3c8a796811458695cab3922077bf53b53cee431", "parents": ["d148777380bddd8965a19204fa0b83ecfc89f3d5"], "tags": ["SEAMONKEY_2_49_1_BUILD1"]}], "date": 1505406337, "git_changesets": [null], "user": "frgrahl@gmx.net"}, "7305": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "397e4dd01ed6e4927dda1c699435bc7a1c2c458e", "parents": ["eaadb31758d8870fde4927bb8e4cacc62fabb9f1"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-303 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "e684b0c862b17c98b3d2e7c881ca43e89b35162a", "parents": ["397e4dd01ed6e4927dda1c699435bc7a1c2c458e"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated block