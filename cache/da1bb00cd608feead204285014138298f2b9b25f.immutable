5c77b647829da2", "parents": ["a703e28f691dd624af9ee014e563c28957bc130f"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-306 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "782d1e86beec9cec4b498c274f3027f45a5893dd", "parents": ["6f2be74218fcadae7000916c3a5c77b647829da2"], "tags": []}], "date": 1502729723, "git_changesets": [null, null, null], "user": "ffxbld"}, "7260": {"changesets": [{"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "merge default to THUNDERBIRD_52_VERBRANCH. a=jorgk DONTBUILD", "files": ["widget/nsPrintOptionsImpl.cpp"], "git_node": null, "git_parents": [null, null], "node": "1ff98bcac541cf0801d9c684d52cf088472777f5", "parents": ["c41f37d913e205e08dac3f1a1f530d37c6b34e72", "782d1e86beec9cec4b498c274f3027f45a5893dd"], "tags": []}], "date": 1502733774, "git_changesets": [null], "user": "mozilla@jorgk.com"}, "7261": {"changesets": [{"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "bug 546387 - Don't try to set the GTK clipboard with null items r=karlt a=jorgk\n\nIt causes an assert failure in gtk which prints to the console.\n\nMozReview-Commit-ID: A4106Z4rT36", "files": ["widget/gtk/nsClipboard.cpp"], "git_node": null, "git_parents": [null], "node": "d13e3fefb76ea8a030579965d3c84e04649226fc", "parents": ["1ff98bcac541cf0801d9c684d52cf088472777f5"], "tags": []}, {"author": "Johann Hofmann \u003cjhofmann@mozilla.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1350152 - Don't rely on gBrowser in nsLoginManagerPrompter.js. r=mkaply a=jorgk\n\nIn bug 1266836 we fixed this code to properly work in e10s,\nbut made the mistake of using gBrowser in toolkit code, breaking\nXUL apps that don't have a gBrowser. This solution implements\na different code-path for non-e10s and returns a chrome\nwindow for consumers that don't offer a browser.\n\nMozReview-Commit-ID: 929ahDenzu5", "files": ["toolkit/components/passwordmgr/nsLoginManagerPrompter.js"], "git_node": null, "git_parents": [null], "node": "f822bda79c28da0ad93b67d46abcb66f6d5c8c92", "parents": ["d13e3fefb76ea8a030579965d3c84e04649226fc"], "tags": []}, {"author": "Jorg K \u003cjorgk@jorgk.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1388166 - Handle case where chromeWin.getBrowser() doesn't exist. r=johannh a=jorgk", "files": ["toolkit/components/passwordmgr/nsLoginManagerPrompter.js"], "git_node": null, "git_parents": [null], "node": "fbb0bdb191d5e2d044ca00615d8c3ad3af7a0ab6", "parents": ["f822bda79c28da0ad93b67d46abcb66f6d5c8c92"], "tags": []}, {"author": "Aaron Klotz \u003caklotz@mozilla.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1368150: Add IsWindows10BuildOrNewer to MFBT; r=froydnj a=jorgk\n\nI need to be able to distinguish between builds of Windows 10. Unfortunately the\nstuff that I am working with cannot be sorted out via feature detection.", "files": ["mfbt/WindowsVersion.h"], "git_node": null, "git_parents": [null], "node": "fdbd6734448b56e8fec5917cfae3bb1c45342aa2", "parents": ["fbb0bdb191d5e2d044ca00615d8c3ad3af7a0ab6"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1361132 - TSFTextStore::GetSelection() shouldn't return if it runs on Win10 Anniversary Update or later. r=m_kato, a=jcristau a=jorgk\n\nThis is remaining cases of bug 1312302.  TSF may set focus to context when it receives focus related message.  In such case, TSF tries to retrieve selection but TSFTextStore::GetSelection() returns E_FAIL due to still not initialized, TSF crashes.\n\nThis patch moves the hack to TSFTextStore::GetSelection() and restrict to work only on problematic versions of Windows 10.\n\nMozReview-Commit-ID: 6cTiZ4HCO18", "files": ["widget/windows/TSFTextStore.cpp", "widget/windows/TSFTextStore.h"], "git_node": null, "git_parents": [null], "node": "459150ea79f6be75c0228450b2ae15c28b5fbe1b", "parents": ["fdbd6734448b56e8fec5917cfae3bb1c45342aa2"], "tags": []}, {"author": "Ralph Giles \u003cgiles@mozilla.com\u003e", "branch": "THUNDERBIRD_52_VERBRANCH", "desc": "Bug 1338655 - Don't try to build mp4parse bindings. r=froydnj a=jorgk DONTBUILD\n\nWe use the cheddar crate to generate a C header file\nfor our mp4parse_capi wrapper crate. Currently we\ndo this at code check-in time via update-rust.sh.\n\nCargo 0.18 and later will try to execute a build.rs\nfile in the crate source tree regardless of whether\nit's specified in Cargo.toml so patching out that\nline just results in 'crate cheddar not found'.\n\nThis change restores the old behaviour by substituting\na 'build = false' line instead.\n\nWe do have syntex vendored, but we don't currently build\nit by default, so I prefer this solution to just vendoring\ncheddar and generating the header at build time. The syntex\ncrate is quite large and adds significantly to our compile\ntime.\n\nMozReview-Commit-ID: InJRRODWAdP", "files": ["media/libstagefright/binding/mp4parse-cargo.patch", "media/libstagefright/binding/mp4parse_capi/Cargo.toml"], "git_node": null, "git_parents": [null], "node": "21af4e17cbf9f225e99c4103ac73a72311a702d1", "parents": ["459150ea79f6be75c0228450b2ae15c28b5fbe1b"], "tags": []}], "date": 1502735745, "git_changesets": [null, null, null, null, null, null], "user": "mozilla@jorgk.com"}, "7262": {"changesets": [{"author": "tbirdbld", "branch": "THUNDERBIRD5230_2017081506_RELBRANCH", "desc": "Automated checkin: version bump for thunderbird 52.3.0 release. DONTBUILD CLOSED TREE a=release", "files": ["config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "68d7c7d635870dd5d6763728ef190f7b06026d94", "parents": ["21af4e17cbf9f225e99c4103ac73a72311a702d1"], "tags": ["THUNDERBIRD_52_3_0_BUILD1", "THUNDERBIRD_52_3_0_RELEASE"]}, {"author": "tbirdbld", "branch": "THUNDERBIRD5230_2017081506_RELBRANCH", "desc": "Added THUNDERBIRD_52_3_0_RELEASE THUNDERBIRD_52_3_0_BUILD1 tag(s) for changeset 68d7c7d63587. DONTBUILD CLOSED TREE a=release", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "29ac1354e355a00c4791636803b516150d379be0", "parents": ["68d7c7d635870dd5d6763728ef190f7b06026d94"], "tags": []}], "date": 1502794931, "git_changesets": [null, null], "user": "tbirdbld"}, "7263": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-301 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "9e2b2135e3b4b6ddb1c6564904a2c5dc2c49988e", "parents": ["782d1e86beec9cec4b498c274f3027f45a5893dd"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-301 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "3a0b9eac4f6ff9d3931d5feef3ffcc8194a49647", "parents": ["9e2b2135e3b4b6ddb1c6564904a2c5dc2c49988e"], "tags": []}], "date": 1502816130, "git_changesets": [null, null], "user": "ffxbld"}, "7264": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-307 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "f969ad0348f680e1a7092d54aa9ebabc5bdd7ae6", "parents": ["3a0b9eac4f6ff9d3931d5feef3ffcc8194a49647"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-307 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "5280b5a01c81010848e918c644325b014c0f7bd9", "parents": ["f969ad0348f680e1a7092d54aa9ebabc5bdd7ae6"], "tags": []}], "date": 1502903258, "git_changesets": [null, null], "user": "ffxbld"}, "7265": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-306 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "5a6b39a7143aaecd628e77acdad94247500133c6", "parents": ["5280b5a01c81010848e918c644325b014c0f7bd9"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-306 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "160d7b8a1c6478d68c2aea0d3aac61a73378ecce", "parents": ["5a6b39a7143aaecd628e77acdad94247500133c6"], "tags": []}], "date": 1502989775, "git_changesets": [null, null], "user": "ffxbld"}, "7266": {"changesets": [{"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1389715 - Vendor latest robustcheckout. r=ted, a=release\n\nFrom revision 19db5f4b5b10f639d24e69a4f21e4e80c6e5bbdd of\nversion-control-tools. Previous revision was\n249a47720ddcf896a9f07600c429a1b4492b805e.\n\nChanges include:\n\n* Use new vfs APIs when available (bug 1359959)\n* Mark as compatible with Mercurial 4.2 (bug 1361182)\n* Retry after SSLError (bug 1354824)\n* Mark as compatible with Mercurial 4.3\n* Detect and recover from open locks (bug 1297153)\n\nThe most significant is the last one. TaskCluster can SIGKILL\n`hg`, leading to orphaned transactions and locks. This can lead\nto timeouts or use of a corrupt repository in some scenarios.\nThose problems should no longer occur.\n\nMozReview-Commit-ID: QAOSLyc0xD", "files": ["testing/mozharness/external_tools/robustcheckout.py"], "git_node": null, "git_parents": [null], "node": "85cb2e75fac4f54d0acd07f3e421792d005d4992", "parents": ["160d7b8a1c6478d68c2aea0d3aac61a73378ecce"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1389715 - Upgrade to Mercurial 4.3.1. r=ted, a=release\n\nThis is pretty straightforward: we just update some version numbers\nand hashes.\n\nThe tooltool artifacts were produced and uploaded by me, just like\nthe last ones. I have some patches to establish a proper toolchain\ntask to build Mercurial. But it is a bit of a rabbit hole due to the\nchicken-and-egg problem of Mercurial needing to be in Docker images.\nPreserving the existing install mechanism is the simplest path\nforward. Plus we need this patch so we can uplift so earlier releases\nget a secure Mercurial in their Docker images.\n\ncolor and pager are enabled by default in 4.2. So remove configuration\noptions for them that add no value.\n\nMozReview-Commit-ID: 9pkHX044kV8", "files": ["testing/docker/recipes/install-mercurial.sh"], "git_node": null, "git_parents": [null], "node": "34f79b19001db0caa0fc481e00adf76ac40cbac8", "parents": ["85cb2e75fac4f54d0acd07f3e421792d005d4992"], "tags": []}], "date": 1503007765, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7267": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 34f79b19001d (bug 1389715) for docker image bustage.", "files": ["testing/docker/recipes/install-mercurial.sh"], "git_node": null, "git_parents": [null], "node": "0580cacbed91c2d893ebc7e3e5777feef590f11b", "parents": ["34f79b19001db0caa0fc481e00adf76ac40cbac8"], "tags": []}], "date": 1503009800, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7268": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-301 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "0037174393ec667b4e3f794e981023ce4b898504", "parents": ["0580cacbed91c2d893ebc7e3e5777feef590f11b"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-301 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "664e6b02a93adabf6198dc54fbcd491ba26a5c4b", "parents": ["0037174393ec667b4e3f794e981023ce4b898504"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-301 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "c9f801638cc6b1872b63f225d6ee66f6bd396a62", "parents": ["664e6b02a93adabf6198dc54fbcd491ba26a5c4b"], "tags": []}], "date": 1503077375, "git_changesets": [null, null, null], "user": "ffxbld"}, "7269": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-307 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "22cec148ca92c9657f5db9016f114f43a37ca485", "parents": ["c9f801638cc6b1872b63f225d6ee66f6bd396a62"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-307 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "24a3c32bb5c65d955df21c0d40c90d128e84a435", "parents": ["22cec148ca92c9657f5db9016f114f43a37ca485"], "tags": []}], "date": 1503162429, "git_changesets": [null, null], "user": "ffxbld"}, "7270": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors