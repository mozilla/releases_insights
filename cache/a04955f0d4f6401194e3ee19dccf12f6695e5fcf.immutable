p DONTBUILD\n\nde -\u003e 64a6464a9310\neo -\u003e a353b9837bf7\nhe -\u003e 616446418b87\nit -\u003e 8c618363cbc0\npt-PT -\u003e 00e6f6b41df4\nrm -\u003e 90cd4fe11a56", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "3265604a4ca1537a808eacf884ec14cdd52ae9d6", "parents": ["d64292b4ee5ac5c86c30d5c33670a87367ca2430"], "tags": []}], "date": 1574146833, "git_changesets": [null], "user": "ffxbld"}, "606": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\neo -\u003e e57cdc80959a\nsl -\u003e 6e7296a71a19", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "b2e2147bfbea9fde9f455d787d75fcdec39ff197", "parents": ["3265604a4ca1537a808eacf884ec14cdd52ae9d6"], "tags": []}], "date": 1574164831, "git_changesets": [null], "user": "ffxbld"}, "607": {"changesets": [{"author": "Vlad Baicu \u003cvlad.baicu@softvision.ro\u003e", "branch": "default", "desc": "Bug 1591077 - Make sure send tab resources are always initialised.r=AndreiLazar a=lizzard\n\nSpeculative fix, make sure that send tab resources are always initialized, regardless of the localization status.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D52656", "files": ["mobile/android/base/java/org/mozilla/gecko/mma/LeanplumVariables.java"], "git_node": null, "git_parents": [null], "node": "6e30e3fcb222e2159c7d48ad18d5f87cd2b8b48b", "parents": ["b2e2147bfbea9fde9f455d787d75fcdec39ff197"], "tags": []}, {"author": "Tom Tung \u003cttung@mozilla.com\u003e", "branch": "default", "desc": "Bug 1584986 - P1 - Remove the early return for listInitializedOrigins; r=asuth a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D47740", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/test/unit/test_listInitializedOrigins.js"], "git_node": null, "git_parents": [null], "node": "81742a07a1b3fe3239904fd865c6cc6b1094feaa", "parents": ["6e30e3fcb222e2159c7d48ad18d5f87cd2b8b48b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1582215 - Make `HTMLEditor::DoInsertHTMLWithContext()` compute new insertion point before removing unnecessary `\u003cli\u003e` elements r=m_kato a=lizzard\n\nWhen inserting `\u003cli\u003e` elements into `\u003cul\u003e`, `\u003col\u003e` or `\u003cli\u003e` element,\n`HTMLEditor::DoInsertHTMLWithContext()` removes unnecessary empty `\u003cli\u003e`\nelements at insertion point.  At this time, we've computed next insertion\npoint with removed `\u003cli\u003e` element.  Therefore, insertion point goes out\nfrom the DOM tree.  This patch makes it compute new insertion point before\nremoving each empty `\u003cli\u003e` element.\n\nAdditionally, this patch adds some WPT data for testing this case.  I verified\nthat Chrome passes the new tests too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D49394", "files": ["editor/libeditor/HTMLEditorDataTransfer.cpp", "testing/web-platform/tests/editing/data/inserthtml.js"], "git_node": null, "git_parents": [null], "node": "7f6aa079d9338793222ec2024124d9fe363efa16", "parents": ["81742a07a1b3fe3239904fd865c6cc6b1094feaa"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1587962 - [10.15] \"Use keyboard navigation\" and \"jump to spot\" scrolling preferences do not work r=spohl a=lizzard\n\nUpdate sandbox rules to allow services and files needed for global UI system preferences.\n\nUpdate tests now that stat() calls on the filesystem are permitted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D50298", "files": ["security/sandbox/mac/SandboxPolicyContent.h", "security/sandbox/test/browser_content_sandbox_fs.js"], "git_node": null, "git_parents": [null], "node": "eeb4d6e558891e7b9111300e10b96bb185ad02d2", "parents": ["7f6aa079d9338793222ec2024124d9fe363efa16"], "tags": []}, {"author": "Matthew Noorenberghe \u003cmozilla@noorenberghe.ca\u003e", "branch": "default", "desc": "Bug 1583957 - Indicate support for autocomplete=(username|new-password|current-password). r=farre a=lizzard\n\nBug 917325 started using the `username` token.\nBug 1119063 started using the `new-password` token. This patch also adds support for `current-password` since it's the counterpart to `new-password` and we plan to use it as a signal eventually so want to encourage its use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D50351", "files": ["dom/base/AutocompleteFieldList.h", "dom/html/test/forms/test_autocomplete.html", "dom/html/test/forms/test_autocompleteinfo.html", "testing/web-platform/meta/html/semantics/forms/the-form-element/form-autocomplete.html.ini"], "git_node": null, "git_parents": [null], "node": "e728a989558999c62ec5b32ad842ac6873e1ff6c", "parents": ["eeb4d6e558891e7b9111300e10b96bb185ad02d2"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1546331 - Missing call to WaitForIsDebuggerRegistered r=asuth a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D52139", "files": ["dom/workers/WorkerPrivate.cpp"], "git_node": null, "git_parents": [null], "node": "1827cf7d273d0a956d3e1aed855f327250139ffc", "parents": ["e728a989558999c62ec5b32ad842ac6873e1ff6c"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1593041 - Add com.apple.security.smartcard entitlement to Firefox r=spohl a=lizzard\n\nAdd the com.apple.security.smartcard entitlement to Firefox's entitlements list.\n\nNeeded for clients of some CryptoTokenKit.framework API's, per SmartCardServices(7).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D51303", "files": ["security/mac/hardenedruntime/developer.entitlements.xml", "security/mac/hardenedruntime/production.entitlements.xml"], "git_node": null, "git_parents": [null], "node": "f43123e865f1deba61c80036b483dc6dccf64ee0", "parents": ["1827cf7d273d0a956d3e1aed855f327250139ffc"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1586496 - If two taps are close in time but far in distance, still allow the second one to start a gesture. r=tnikkel a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D51479", "files": ["gfx/layers/apz/src/GestureEventListener.cpp", "gfx/layers/apz/src/GestureEventListener.h"], "git_node": null, "git_parents": [null], "node": "46bd3ef84ba8496eede888d31be5596533c8dbe9", "parents": ["f43123e865f1deba61c80036b483dc6dccf64ee0"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1586496 - Add a gtest. r=tnikkel a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D51480", "files": ["gfx/layers/apz/test/gtest/TestGestureDetector.cpp"], "git_node": null, "git_parents": [null], "node": "462b5dbfb4c9f2176bef0c4f5d2f963d333f93c4", "parents": ["46bd3ef84ba8496eede888d31be5596533c8dbe9"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "bug 1591691 - avoid network I/O when importing enterprise roots on Windows r=mhowell a=pascalc a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D51007", "files": ["security/manager/ssl/EnterpriseRoots.cpp"], "git_node": null, "git_parents": [null], "node": "3b6a5df0a100e52b5bafa98e2a9e2a5265291d87", "parents": ["462b5dbfb4c9f2176bef0c4f5d2f963d333f93c4"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "bug 1591691 - avoid network I/O when importing enterprise roots on MacOS r=spohl a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D51009", "files": ["security/manager/ssl/EnterpriseRoots.cpp"], "git_node": null, "git_parents": [null], "node": "46e80be3afbbc631575ff327a312bcc17222cffe", "parents": ["3b6a5df0a100e52b5bafa98e2a9e2a5265291d87"], "tags": []}], "date": 1574175280, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null], "user": "archaeopteryx@coole-files.de"}, "608": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Backed out changeset 462b5dbfb4c9 (bug 1586496) a=backout", "files": ["gfx/layers/apz/test/gtest/TestGestureDetector.cpp"], "git_node": null, "git_parents": [null], "node": "4e0eded29ce39f15d1d40463d15ba13ed9468dda", "parents": ["46e80be3afbbc631575ff327a312bcc17222cffe"], "tags": []}], "date": 1574177292, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "609": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 86cca1750584d5a064b6e51e856ca18d7118d30d with FENNEC_68_3b5_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "f53a60ebcaabf3f56f4470aede8724f67f03fc6c", "parents": ["4e0eded29ce39f15d1d40463d15ba13ed9468dda"], "tags": []}, {"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Automatic version bump CLOSED TREE NO BUG a=release DONTBUILD", "files": ["mobile/android/config/version-files/beta/version_display.txt"], "git_node": null, "git_parents": [null], "node": "f7eb47914b22bbe8fe216e803f7d3a79764925ea", "parents": ["f53a60ebcaabf3f56f4470aede8724f67f03fc6c"], "tags": []}], "date": 1574178664, "git_changesets": [null, null], "user": "ffxbld"}, "610": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\ndsb -\u003e bad28a066b96\neo -\u003e ccbf6199c944\ngn -\u003e 24d53850587d\nhi-IN -\u003e 774666a61478\nhsb -\u003e 55ddeffe73d2\npt-BR -\u003e aa0f0ddf5055", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "340f0338a8a70701ea0e5118a874d5c58806ff1c", "parents": ["f7eb47914b22bbe8fe216e803f7d3a79764925ea"], "tags": []}], "date": 1574182836, "git_changesets": [null], "user": "ffxbld"}, "611": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\neo -\u003e 908eda66ffda", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "d09c6b07d48ef0f7d633970dc09c4f5d3505eaa0", "parents": ["340f0338a8a70701ea0e5118a874d5c58806ff1c"], "tags": []}], "date": 1574193637, "git_changesets": [null], "user": "ffxbld"}, "612": {"changesets": [{"author": "Toshihito Kikuchi \u003ctkikuchi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1588975 - Replace ShellExecuteExW with mozilla::ShellExecuteByExplorer. r=aklotz a=RyanVM\n\nThe launcher process turns on the `PreferSystem32Images` mitigation policy for\nthe browser process.  Since the mitigation policy is inherited, a process launched\nby the browser process also has `PreferSystem32Images`.  If an application which\ndoes not support `PreferSystem32Images`, such as Skype for Business, is launched\nvia a hyperlink, a custom uri, or a downloaded file, it would fail to launch.\n\nBug 1567614 fixed this issue by introducing `mozilla::ShellExecuteByExplorer` to\n`nsMIMEInfoWin::LoadUriInternal`.  This patch introduces\n`mozilla::ShellExecuteByExplorer` to two more places.\n\n1. xul!nsLocalFile::Launch\nThis is invoked when a user opens a file from the Download Library, or a user\nopens a downloaded file with the default application without saving it.\n\n2. xul!nsMIMEInfoWin::LaunchWithFile\nThis is invoked when a user opens a downloaded file with a custom application\n(configured in about:preference) without saving it.\n\n*Why does this patch change worker.js?*\n\nThe mochitest dom/tests/browser/browser_test_new_window_from_content.js failed\nif it was executed after dom/serviceworkers/test/browser_download.js in the\nsame batch.  This was because browser_download.js launched Notepad to open\nfake_download.bin.txt, preventing a new window from being opened in the\nforeground in browser_test_new_window_from_content.js.\n\nThe test browser_download.js can verify downloaded data without opening an\nassociated application.  So this patch adds the content-type to the response\nheader in order not to open Notepad on Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com//D53273", "files": ["dom/serviceworkers/test/download/worker.js", "uriloader/exthandler/win/nsMIMEInfoWin.cpp", "widget/windows/ShellHeaderOnlyUtils.h", "xpcom/io/nsLocalFileWin.cpp"], "git_node": null, "git_parents": [null], "node": "1cc2971e671a0816c122cbef798a53e577398ad6", "parents": ["d09c6b07d48ef0f7d633970dc09c4f5d3505eaa0"], "tags": []}], "date": 1574218490, "git_changesets": [null], "user": "rmaries@mozilla.com"}, "613": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\neo -\u003e bcb32facf9e8\nes-AR -\u003e 8979b3c9d8ab\nes-CL -\u003e ebfe870a3df2\ntrs -\u003e 5c953a6a2b3e\nvi -\u003e 3696042b720a", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "fe3cf351f430b1e0871de5d25e57bff8a60c8d22", "parents": ["1cc2971e671a0816c122cbef798a53e577398ad6"], "tags": []}], "date": 1574233232, "git_changesets": [null], "user": "ffxbld"}, "614": {"changesets": [{"author": "L10n Bumper Bot \u003crelease+l10nbumper@mozilla.com\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\neu -\u003e 92c4e071bab6\nhu -\u003e 9d5cb2faa4b7\ntr -\u003e 4cea69921c12", "files": ["mobile/locales/l10n-changesets.json"], "git_node": null, "git_parents": [null], "node": "5ed74d712d2cccd2b50eb2b831f5519b621807ae", "parents": ["fe3cf351f430b1e0871de5d25e57bff8a60c8d22"], "tags": []}], "date": 1574258429, "git_changesets": [null], "user": "ffxbld"}, "615": {"changesets": [{"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1322864, r=NeilDeakin a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D50927", "files": ["dom/base/nsContentUtils.cpp", "dom/base/nsCopySupport.cpp"], "git_node": null, "git_parents": [null], "node": "30006ca3a1e1ce3419cc4360cb70d703bc14a40c", "parents": ["5ed74d712d2cccd2b50eb2b831f5519b621807ae"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 1449736: Properly detect failure in receiving plugin NPObjects. r=jmathies, a=RyanVM\n\nProperly handles NPError reporting and makes sure that, in the case of failure, it does not return junk for the NPObject.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48474", "files": ["dom/plugins/ipc/PluginInstanceChild.cpp"], "git_node": null, "git_parents": [null], "node": "a0649b6b82d30f1525267153290625a2fe089302", "parents": ["30006ca3a1e1ce3419cc4360cb70d703bc14a40c"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1585106 - Use mutex in PACResolver when accessing mRequest from multiple threads. r=michal, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D52488", "files": ["netwerk/base/ProxyAutoConfig.cpp"], "git_node": null, "git_parents": [null], "node": "02a75a0b91b8e6c55a6489146432373c9c7e0e0f", "parents": ["a0649b6b82d30f1525267153290625a2fe089302"], "tags": []}], "date": 1574283572, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "616": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D54122", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "9fa19fd1ca3f9ca95cf851a4ae73655de649e58a", "parents": ["02a75a0b91b8e6c55a6489146432373c9c7e0e0f"], "tags": []}, {"author": "J.C. Jones \u003cjjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 1588558 - land NSS NSS_3_44_3_RTM UPGRADE_NSS_RELEASE, r=kjacobs, a=RyanVM\n\n2019-11-19  J.C. Jones  \u003cjjones@mozilla.com\u003e\n\n\t* lib/nss/nss.h, lib/softoken/softkver.h, lib/util/nssutil.h:\n\tSet version numbers to 3.44.3 final\n\t[d871fc63531d] [NSS_3_44_3_RTM] \u003cNSS_3_44_BRANCH\u003e\n\n2019-11-19  Craig Disselkoen  \u003ccdisselk@cs.ucsd.edu\u003e\n\n\t* lib/softoken/pkcs11c.c:\n\tBug 1586176 - EncryptUpdate should use maxout not block size.\n\tr=franziskus\n\t[60bca7c6dc6d] \u003cNSS_3_44_BRANCH\u003e\n\n2019-10-15  Dana Keeler  \u003cdkeeler@mozilla.com\u003e\n\n\t* gtests/mozpkix_gtest/pkixder_universal_types_tests.cpp,\n\tlib/mozpkix/include/pkix/pkixder.h, lib/mozpkix/lib/pkixcert.cpp:\n\tbug 1579060 - fix handling of issuerUniqueID and subjectUniqueID in\n\tmozilla::pkix::BackCert r=jcj\n\n\tAccording to RFC 5280, the definitions of issuerUniqueID and\n\tsubjectUniqueID in TBSCertificate are as follows:\n\n\t issuerUniqueID [1] IMPLICIT UniqueIdentifier OPTIONAL,\n\tsubjectUniqueID [2] IMPLICIT UniqueIdentifier OPTIONAL,\n\n\twhere UniqueIdentifier is a BIT STRING.\n\n\tIMPLICIT tags replace the tag of the underlying type. For these\n\tfields, there is no specified class (just a tag number within the\n\tclass), and the underlying type of BIT STRING is \"primitive\" (i.e.\n\tnot constructed). Thus, the tags should be of the form CONTEXT\n\tSPECIFIC | [number in class], which comes out to 0x81 and 0x82,\n\trespectively.\n\n\tWhen originally implemented, mozilla::pkix incorrectly required that\n\tthe CONSTRUCTED bit also be set for these fields. Consequently, the\n\tlibrary would reject any certificate that actually contained these\n\tfields. Evidently such certificates are rare.\n\n\t[64e55c9f658e] \u003cNSS_3_44_BRANCH\u003e\n\n2019-11-11  Tom Prince  \u003cmozilla@hocat.ca\u003e\n\n\t* automation/taskcluster/graph/src/extend.js,\n\tautomation/taskcluster/windows/setup.sh:\n\tBug 1594891 - Use tc-proxy for nss tooltool; r=dustin,jcj\n\n\t[d0f80763697f] \u003cNSS_3_44_BRANCH\u003e\n\n2019-11-08  Dustin J. Mitchell  \u003cdustin@mozilla.com\u003e\n\n\t* automation/taskcluster/graph/npm-shrinkwrap.json,\n\tautomation/taskcluster/graph/package.json,\n\tautomation/taskcluster/graph/src/image_builder.js,\n\tautomation/taskcluster/graph/src/queue.js,\n\tautomation/taskcluster/scripts/tools.sh,\n\tautomation/taskcluster/windows/gen_certs.sh,\n\tautomation/taskcluster/windows/run_tests.sh:\n\tBug 1594891 - Updates to run correctly on the new TC deployment\n\tr=jcj\n\n\t* Update the Taskcluster client used in the decision task to one\n\tthat understands Taskcluster rootUrls.\n\t* Update scripts that fetch content to use the TASKCLUSTER_ROOT_URL\n\t  * the absence of this variale signals an \"old\" worker so we use an\n\t\"old\" URL\n\n\t[f2604281fdcd] \u003cNSS_3_44_BRANCH\u003e\n\n2019-11-07  Tom Prince  \u003cmozilla@hocat.ca\u003e\n\n\t* .taskcluster.yml, automation/taskcluster/graph/src/extend.js,\n\tautomation/taskcluster/graph/src/queue.js:\n\tBug 1591275: Switch workers to use AWS Provder; r=kjacobs\n\n\t[11b2065c9197] \u003cNSS_3_44_BRANCH\u003e\n\n2019-10-02  J.C. Jones  \u003cjjones@mozilla.com\u003e\n\n\t* .hgtags:\n\tAdded tag NSS_3_44_2_RTM for changeset 927b49b0d5cf\n\t[65da61024980] \u003cNSS_3_44_BRANCH\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D53884", "files": ["old-configure.in", "security/nss/.taskcluster.yml", "security/nss/TAG-INFO", "security/nss/automation/taskcluster/graph/npm-shrinkwrap.json", "security/nss/automation/taskcluster/graph/package.json", "security/nss/automation/taskcluster/graph/src/extend.js", "security/nss/automation/taskcluster/graph/src/image_builder.js", "security/nss/automation/taskcluster/graph/src/queue.js", "security/nss/automation/taskcluster/scripts/tools.sh", "security/nss/automation/taskcluster/windows/gen_certs.sh", "security/nss/automation/taskcluster/windows/run_tests.sh", "security/nss/automation/taskcluster/windows/setup.sh", "security/nss/coreconf/coreconf.dep", "security/nss/gtests/mozpkix_gtest/pkixder_universal_types_tests.cpp", "security/nss/lib/mozpkix/include/pkix/pkixder.h", "security/nss/lib/mozpkix/lib/pkixcert.cpp", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/pkcs11c.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "ea1bc0fb2dda63286402d436c6b1648e4f707390", "parents": ["9fa19fd1ca3f9ca95cf851a4ae73655de649e58a"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1597043: RootAccessible::ProcessDOMEvent: Return early if AsXULMultiSelectControl() on a XUL tree element fails. r=MarcoZ a=pascalc\n\nThis really shouldn't be possible.\nAll XUL trees should have nsIDOMXULMultiSelectControlElement, and the tree is focused at this point, so it shouldn't be dying.\nNevertheless, this sometimes happens in the wild and was causing crashes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D53373", "files": ["accessible/generic/RootAccessible.cpp"], "git_node": null, "git_parents": [null], "node": "d36df7bc997712725f81ed7ed35b6255f592b166", "parents": ["ea1bc0fb2dda63286402d436c6b1648e4f707390"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1597543 - Don't try and associate memory if we failed to create the reflector object r=bzbarsky a=pascalc\n\nThe problem is we're still calling JS::AddAssociatedMemory with a null object pointer. There's an asssertion for this in the JS engine but this doesn't happen in our tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D53813", "files": ["dom/bindings/BindingUtils.h"], "git_node": null, "git_parents": [null], "node": "3bf7df179a7bd06fc0110a7507ac6cb1e13660f3", "parents": ["d36df7bc997712725f81ed7ed35b6255f592b166"], "tags": []}], "date": 1574351586, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "617": {"changesets": [{"author": "Petru Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1596801 - Don't warmup Necko for search engines when in automation. r=AndreiLazar, a=RyanVM\n\nBug 813379 introduced a speculative network connection to the default search\nengine. Opening an external network connection is prohibited in reftests so\nthis would crash the entire testing framework.\nAlthough not ideal this patch introduces a check for if the app is running in\nautomation, case in which we will just avoid warming up Necko.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D54110", "files": ["mobile/android/chrome/content/browser.js"], "git_node": null, "git_parents": [null], "node": "ab1de3d63d0a0bc4f65d7c91acdfc0051f3cbfc6", "parents": ["3bf7df179a7bd06fc0110a7507ac6cb1e13660f3"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1579127 - only count the frame dropping due to system overload. r=mattwoodrow, a=RyanVM\n\nWhen user adjusts the video playback rate, which might cause we sending images in a speed that is faster than the speend we composite images.\n\nIn this situation, the frame dropping actually won't cause any visual defect and we also don't want to report this frame dropping to user, because it's not caused by system overloading, it's just our compositor doesn't support compositing images in such a high rate.\n\nTherefore, we should check if the dropped images are caused by system overload or high update rate, and only report the former to user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D46236", "files": ["gfx/layers/composite/ImageComposite.cpp", "gfx/layers/composite/ImageComposite.h"], "git_node": null, "git_parents": [null], "node": "fc92c73816af233a86d93afb90890d7845580fc4", "parents": ["ab1de3d63d0a0bc4f65d7c91acdfc0051f3cbfc6"], "tags": []}, {"author": "alwu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1579127 - part2 : always present a valid timestamp on image. r=jolin, a=RyanVM\n\nAs we would calculate time difference between frames by checking their timestamp, so we would always ensure that image has valid timestamp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D48034", "files": ["dom/media/mediasink/VideoSink.cpp"], "git_node": null, "git_parents": [null], "node": "f637cbfabf006c7f01d71a12ea7ca1b89684c84b", "parents": ["fc92c73816af233a86d93afb90890d7845580fc4"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1580695 - Revert bug 1533129. r=alwu,bryce a=RyanVM\n\nThis  change was a workaround a Youtube bug that expected a particular behaviour from old TV and that we were exploiting. It was adding support for unsupported, unofficial code.\n\nMediaCapabilities is how things should be done.\n\nMaking this code to work conditionally is too much effort. Reverting it entirely is easier.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D49515", "files": ["dom/media/MediaMIMETypes.cpp", "dom/media/MediaMIMETypes.h", "dom/media/mediasource/MediaSource.cpp", "dom/media/mediasource/test/file_isTypeSupported.html", "dom/media/mediasource/test/mochitest.ini", "dom/media/mediasource/test/test_isTypeSupportedExtensions.html"], "git_node": null, "git_parents": [null], "node": "b152c26ca6f101278453fc4c5c6005d085a8a6be", "parents": ["f637cbfabf006c7f01d71a12ea7ca1b89684c84b"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1589900 - ensure we initialize about:privatebrowsing remote page handler before loading it from the commandline, r=mossop a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D51583", "files": ["browser/components/BrowserContentHandler.jsm", "browser/components/about/AboutPrivateBrowsingHandler.jsm"], "git_node": null, "git_parents": [null], "node": "bf5e67b06638edebd6b0240b8f5ce01ecd8be198", "parents": ["b152c26ca6f101278453fc4c5c6005d085a8a6be"], "tags": []}], "date": 1574353664, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "618": {"changesets": [{"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1577223 - Add specific error for missing scheme in URL policies. r=mconley, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D46985", "files": ["toolkit/components/utils/JsonSchemaValidator.jsm"], "git_node": null, "git_parents": [null], "node": "8544551ce9c75ddbd608b5dda98ded1036f5254d", "parents": ["bf5e67b06638edebd6b0240b8f5ce01ecd8be198"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1560808 - Don't activate policy engine if there are no policies. r=mconley, a=lizzard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D46973", "files": ["browser/components/enterprisepolicies/tests/browser/browser_policies_notice_in_aboutpreferences.js", "toolkit/components/enterprisepolicies/EnterprisePolicies.js", "toolkit/components/enterprisepolicies/tests/moz.build", "toolkit/components/enterprisepolicies/tests/xpcshell/head.js", "toolk