/res/raw/bookmarkdefaults_favicon_restricted_support.png", "mobile/android/app/src/main/res/raw/bookmarkdefaults_favicon_support.png", "mobile/android/branding/official/content/about.png", "mobile/android/branding/official/content/favicon32.png", "mobile/android/branding/official/content/favicon64.png", "mobile/android/branding/official/res/drawable-hdpi/icon.png", "mobile/android/branding/official/res/drawable-hdpi/large_icon.png", "mobile/android/branding/official/res/drawable-hdpi/search_widget_preview.png", "mobile/android/branding/official/res/drawable-ldpi/search_widget_preview.png", "mobile/android/branding/official/res/drawable-mdpi/search_widget_preview.png", "mobile/android/branding/official/res/drawable-nodpi/firstrun_welcome.png", "mobile/android/branding/official/res/drawable-xhdpi/icon.png", "mobile/android/branding/official/res/drawable-xhdpi/large_icon.png", "mobile/android/branding/official/res/drawable-xhdpi/search_widget_preview.png", "mobile/android/branding/official/res/drawable-xxhdpi/icon.png", "mobile/android/branding/official/res/drawable-xxhdpi/large_icon.png", "mobile/android/branding/official/res/drawable-xxhdpi/search_widget_preview.png", "mobile/android/branding/official/res/drawable-xxxhdpi/icon.png", "mobile/android/branding/official/res/drawable-xxxhdpi/search_widget_preview.png", "mobile/android/branding/official/res/mipmap-hdpi/ic_launcher.png", "mobile/android/branding/official/res/mipmap-hdpi/ic_launcher_foreground.png", "mobile/android/branding/official/res/mipmap-mdpi/ic_launcher_foreground.png", "mobile/android/branding/official/res/mipmap-xhdpi/ic_launcher.png", "mobile/android/branding/official/res/mipmap-xhdpi/ic_launcher_foreground.png", "mobile/android/branding/official/res/mipmap-xxhdpi/ic_launcher.png", "mobile/android/branding/official/res/mipmap-xxhdpi/ic_launcher_foreground.png", "mobile/android/branding/official/res/mipmap-xxxhdpi/ic_launcher.png", "mobile/android/branding/official/res/mipmap-xxxhdpi/ic_launcher_foreground.png", "mobile/android/themes/core/images/logo-hdpi.png", "mobile/android/themes/core/images/wordmark-hdpi.png"], "git_node": null, "git_parents": [null], "node": "d1199a86174663465e846a35ea6191dafbbcdbe7", "parents": ["dac90ddb95c5a5110fdfd80bbc2a5805c37654c6"], "tags": []}], "date": 1573533005, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "572": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1581084, nsDeviceSensors::IsSensorAllowedByPref should use the principal of the window, not docshell, to check whether to resist fingerprinting, r=bzbarsky a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D50525", "files": ["dom/system/nsDeviceSensors.cpp"], "git_node": null, "git_parents": [null], "node": "9a0b55d120ba485d54a8779ca59041c971dd39d3", "parents": ["e6f1013ba58034191fabd57a690503f708fcb10c"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1591334, use faster access to the existing doc in antitracking reporting,r=baku a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D50758", "files": ["dom/base/nsGlobalWindowOuter.cpp", "toolkit/components/antitracking/AntiTrackingCommon.cpp"], "git_node": null, "git_parents": [null], "node": "ba98244fe0b0c96e3066b05736d3b8ac6362875b", "parents": ["9a0b55d120ba485d54a8779ca59041c971dd39d3"], "tags": []}, {"author": "Bryce Seager van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1578143 - Prevent TrackBuffersManager attempting to access buffered ranges if none exist when evicting data. r=jya a=RyanVM\n\nIt appears possible for data eviction to take place despite the manager not\ncurrently having any buffered ranges. This shouldn't happen, but if it can if\nthe buffers have become full with 0 duration data. This patch attempts to\nmitigate that case by removing all coded frames. This prevents a bad access on\nthe buffered ranges and should clear up space in the buffers to append more\ndata.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D44711", "files": ["dom/media/mediasource/TrackBuffersManager.cpp", "dom/media/mediasource/TrackBuffersManager.h"], "git_node": null, "git_parents": [null], "node": "f83089aed736e514271932fde363efc3d00f5fa4", "parents": ["ba98244fe0b0c96e3066b05736d3b8ac6362875b"], "tags": []}, {"author": "Daosheng Mu \u003cdaoshengmu@gmail.com\u003e", "branch": "default", "desc": "Bug 1564127 - Check if GPU/VR process has connected with the parent process. r=kip a=RyanVM\n\nThis issue happens when VR/GPU haven't connected with the parent process via IPC protocol, and we are trying to access its IPC Child when it is still null. It is possible to be happened when GPU/VR process is killed/shutdown, and we are trying to launch a new VR process. We need to check these status before completing our VR process's launch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D46540", "files": ["gfx/vr/ipc/VRProcessManager.cpp", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h"], "git_node": null, "git_parents": [null], "node": "8a707e6d24700732a226f74992547aa0be7a6385", "parents": ["f83089aed736e514271932fde363efc3d00f5fa4"], "tags": []}], "date": 1573534006, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "573": {"changesets": [{"author": "Justin Wood \u003cCallek@gmail.com\u003e", "branch": "default", "desc": "Bug 1533818 - Don't try to expand from a 'cose.manifest' file when repacking the l10n copy of omni.ja. r=aki a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D34697", "files": ["python/mozbuild/mozpack/chrome/manifest.py"], "git_node": null, "git_parents": [null], "node": "995b67ef37a9f67687d786e5ce1bb244d2e76b99", "parents": ["8a707e6d24700732a226f74992547aa0be7a6385"], "tags": []}], "date": 1573556336, "git_changesets": [null], "user": "archaeopteryx@c