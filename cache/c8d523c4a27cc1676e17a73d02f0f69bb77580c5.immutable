gs": []}], "date": 1501000110, "git_changesets": [null, null, null], "user": "ffxbld"}, "7229": {"changesets": [{"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1368362 - Use setSlotWithType instead of setSlot in InitGlobalLexicalOperation. r=shu, a=abillings", "files": ["js/src/vm/Interpreter-inl.h"], "git_node": null, "git_parents": [null], "node": "f0ab032fd674ef2a61d830665492be44b212fb8b", "parents": ["d1ef6646eb0fb2b8d642baccf7cfb14fbf362382"], "tags": []}, {"author": "Colomban Wendling \u003ccwendling@hypra.fr\u003e", "branch": "default", "desc": "Bug 1308908 - Compare the whole accessible name when checking equality. r=tbsaunde, a=gchang\n\nUse strcmp() instead of strncmp() when comparing the AtkObject name\nbefore changing it.  9133117f410c06ad7fa25323a168bc97200043b9 changed\nfrom Equals() to strncmp() to prevent issues related to embedded NUL\nbytes, but the change lead to only checking if the AtkObject name has\nthe new value as prefix.  Instead, use strcmp() to check the whole\nC strings, but still stopping at the first NUL byte in the new name.\n\nstrcmp() has to be safe here, as NS_ConvertUTF16toUTF8::get() has to\nreturn a NUL-terminated string or the code would crash a few lines\nbelow when calling strdup() on it.", "files": ["accessible/atk/AccessibleWrap.cpp"], "git_node": null, "git_parents": [null], "node": "48a89721d076c0f742eb70fdf52d853362bb8407", "parents": ["f0ab032fd674ef2a61d830665492be44b212fb8b"], "tags": []}, {"author": "Alexander Surkov \u003csurkov.alexander@gmail.com\u003e", "branch": "default", "desc": "Bug 1347667 - Unlink accessible's parent before accessible's shutdown when document shutdowns. r=yzen, a=gchang", "files": ["accessible/base/nsAccCache.h", "accessible/generic/DocAccessible.cpp"], "git_node": null, "git_parents": [null], "node": "ef1d178219455133e0de854e9963d6ff2a36d926", "parents": ["48a89721d076c0f742eb70fdf52d853362bb8407"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1367128 - Part 1: Remove unused member. r=alwu, a=gchang\n\nMozReview-Commit-ID: 1SQaAdePmyf", "files": ["media/libstagefright/binding/include/mp4_demuxer/MoofParser.h"], "git_node": null, "git_parents": [null], "node": "5a0f69630b039c5c3be4e2a21408c98d9f0b00ab", "parents": ["ef1d178219455133e0de854e9963d6ff2a36d926"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1367128 - Part 2: Add methods to trim index. r=gerald, a=gchang\n\nThe MoofParser's used by the MP4Demuxer, can grow very large as it keeps adding new tables and is never reset.\n\nOnce we have demuxed all data present in the MP4 media segment, we no longer require the samples table for that media segment and we can drop it from the index.\n\nUnfortunately. some websites (in particular some using live video) use media segments containing a single sample in order to (incorrectly) reduce latency. While this is a very bad approach from a performance perspective it does happen in the wild.\n\nMozReview-Commit-ID: I66jxcScmKM", "files": ["media/libstagefright/binding/Index.cpp", "media/libstagefright/binding/MoofParser.cpp", "media/libstagefright/binding/include/mp4_demuxer/Index.h", "media/libstagefright/binding/include/mp4_demuxer/MoofParser.h"], "git_node": null, "git_parents": [null], "node": "7db52eca97b229c10328d3bf6082d97209d1bad1", "parents": ["5a0f69630b039c5c3be4e2a21408c98d9f0b00ab"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1367128 - Part 3: Plumb in new eviction methods with MSE demuxer. r=gerald, a=gchang\n\nMozReview-Commit-ID: HULNEfD3tRJ", "files": ["dom/media/fmp4/MP4Demuxer.cpp"], "git_node": null, "git_parents": [null], "node": "c448439eb5dc57f96955e105c93803dabcbc93a7", "parents": ["7db52eca97b229c10328d3bf6082d97209d1bad1"], "tags": []}, {"author": "Shu-yu Guo \u003cshu@rfrn.org\u003e", "branch": "default", "desc": "Bug 1377016 - Take both with-wrapped and unwrapped enclosing environments when getting non-syntactic lexical environments. r=jorendorff, a=gchang", "files": ["js/src/jscompartment.cpp"], "git_node": null, "git_parents": [null], "node": "319a986ae1f4320751f68a786f24b7b766b8f8d9", "parents": ["c448439eb5dc57f96955e105c93803dabcbc93a7"], "tags": []}], "date": 1501038583, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7230": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-307 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "992a6c5e0a10a03af4a4f903bbc5e4128220a6bf", "parents": ["319a986ae1f4320751f68a786f24b7b766b8f8d9"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-307 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "1e531d662891d1b6e92c5fac7dfc42a2132696cb", "parents": ["992a6c5e0a10a03af4a4f903bbc5e4128220a6bf"], "tags": []}], "date": 1501087156, "git_changesets": [null, null], "user": "ffxbld"}, "7231": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-306 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "63366af86e77326728b48e03019fe090a7fa8950", "parents": ["1e531d662891d1b6e92c5fac7dfc42a2132696cb"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-306 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "721ba06d78a0ece5a800b24c516ecfce4361305e", "parents": ["63366af86e77326728b48e03019fe090a7fa8950"], "tags": []}], "date": 1501173216, "git_changesets": [null, null], "user": "ffxbld"}, "7232": {"changesets": [{"author": "Alexander Surkov \u003csurkov.alexander@gmail.com\u003e", "branch": "default", "desc": "Bug 1342433 - onclick changes shouldn't recreate the tree. r=yzen, a=gchang", "files": ["accessible/base/nsAccessibilityService.cpp", "accessible/tests/browser/e10s/browser_treeupdate_listener.js", "accessible/tests/mochitest/treeupdate/test_bug1175913.html", "accessible/tests/mochitest/treeupdate/test_textleaf.html"], "git_node": null, "git_parents": [null], "node": "09f5bd33efb85cbbb86732fd804d7629f6584929", "parents": ["721ba06d78a0ece5a800b24c516ecfce4361305e"], "tags": []}, {"author": "JW Wang \u003cjwwang@mozilla.com\u003e", "branch": "default", "desc": "Bug 1359058 - Part 1: Handle EOS during seeking. r=jya, a=gchang\n\nMozReview-Commit-ID: DPT3t1pi6o1", "files": ["dom/media/MediaDecoderStateMachine.cpp"], "git_node": null, "git_parents": [null], "node": "7ccb26caa02f4d25020a060061ad0ae1aa57f370", "parents": ["09f5bd33efb85cbbb86732fd804d7629f6584929"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1359058 - Part 2: Rely on container flags when seeking in plain MP4. r=gerald, a=gchang\n\nThis reverts part of bug 1300296. In the worse case we'll get a decoding error. But we're only trading a bad behaviour for another.\n\nMozReview-Commit-ID: H0gF3FqZsU6", "files": ["dom/media/fmp4/MP4Demuxer.cpp"], "git_node": null, "git_parents": [null], "node": "a93c1a40f0d897de01ea3b51aeccfac43f3a3a53", "parents": ["7ccb26caa02f4d25020a060061ad0ae1aa57f370"], "tags": []}, {"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1379537 - Fix InstallManifestNoSymlinks to not install symlinks. r=glandium, a=gchang", "files": ["python/mozbuild/mozpack/manifests.py"], "git_node": null, "git_parents": [null], "node": "fd052b08fc3ee6495a66fe543477aa2252c19acf", "parents": ["a93c1a40f0d897de01ea3b51aeccfac43f3a3a53"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1368030 - Fix race condition in ScreenCapturerMac. r=jesup, a=abillings", "files": ["media/webrtc/trunk/webrtc/modules/desktop_capture/screen_capturer_mac.mm"], "git_node": null, "git_parents": [null], "node": "c3e1f7094883c18ffbc0549ad7ee6e4d97a67681", "parents": ["fd052b08fc3ee6495a66fe543477aa2252c19acf"], "tags": []}], "date": 1501175576, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7233": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-305 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "dbc0ca4c39ec49b6569026fe28c5db52d6054a38", "parents": ["c3e1f7094883c18ffbc0549ad7ee6e4d97a67681"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-305 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "934ca0c51cd488331080bd3e7806aef928514eb2", "parents": ["dbc0ca4c39ec49b6569026fe28c5db52d6054a38"], "tags": []}], "date": 1501259662, "git_changesets": [null, null], "user": "ffxbld"}, "7234": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-307 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "256953018231fc779cdc75663608e4907fb64168", "parents": ["934ca0c51cd488331080bd3e7806aef928514eb2"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-307 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "1dddb010a6d367c0451168501fb853920f639198", "parents": ["256953018231fc779cdc75663608e4907fb64168"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-307 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "d32c2e45f24dd16b513e43aa0338556ac9a8e803", "parents": ["1dddb010a6d367c0451168501fb853920f639198"], "tags": []}], "date": 1501346888, "git_changesets": [null, null, null], "user": "ffxbld"}, "7235": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-304 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "75e4485d07dd23dbabd8c7eadb6e8994da0722e7", "parents": ["d32c2e45f24dd16b513e43aa0338556ac9a8e803"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-304 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "9dc54f3e0c125f840572ae33ac8b0be6b03ca21f", "parents": ["75e4485d07dd23dbabd8c7eadb6e8994da0722e7"], "tags": []}], "date": 1501432920, "git_changesets": [null, null], "user": "ffxbld"}, "7236": {"changesets": [{"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1346389 - Make --enable-shared-js link again. r=sfink, a=gchang", "files": ["js/public/CallArgs.h", "js/public/Debug.h", "js/public/Principals.h", "js/public/ProfilingFrameIterator.h", "js/public/ProfilingStack.h", "js/public/StructuredClone.h", "js/public/UbiNode.h", "js/public/UbiNodeCensus.h", "js/public/Utility.h", "js/src/gc/Barrier.cpp", "js/src/gc/MemoryProfiler.cpp", "js/src/jit/JitcodeMap.cpp", "js/src/jit/OptimizationTracking.cpp", "js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/jsfriendapi.h", "js/src/jstypes.h", "js/src/jswrapper.h", "js/src/proxy/CrossCompartmentWrapper.cpp", "js/src/vm/SPSProfiler.cpp", "js/src/vm/SavedStacks.cpp", "js/src/vm/Stack.h", "js/src/vm/UbiNodeCensus.cpp", "mfbt/BufferList.h"], "git_node": null, "git_parents": [null], "node": "324cc1bccf3d900fc6d6dd93ff96ac0853a222d3", "parents": ["9dc54f3e0c125f840572ae33ac8b0be6b03ca21f"], "tags": []}, {"author": "Chris Pearce \u003ccpearce@mozilla.com\u003e", "branch": "default", "desc": "Bug 1346620 - Resolve symlinks and junction points in path to GMP dir when loading GMP process. r=bobowen, a=gchang\n\nThe sandbox blocks loading of GMPs when the GMP resides in a directory stored\nin a path which contains a symlink or junction point. So resolve GMP paths\nfully before instantiating the GMP process.\n\nMozReview-Commit-ID: EvPCpNIDNwg", "files": ["dom/media/gmp/GMPProcessParent.cpp", "widget/windows/WinUtils.cpp", "widget/windows/WinUtils.h"], "git_node": null, "git_parents": [null], "node": "6f93b270d1e36cc85e15b0b2e133b7ab3908cd3f", "parents": ["324cc1bccf3d900fc6d6dd93ff96ac0853a222d3"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1382303 - Part 1: Add mochitest. r=jwwang, a=gchang\n\nMozReview-Commit-ID: ENSiDzd2SmW", "files": ["dom/media/mediasource/test/mochitest.ini", "dom/media/mediasource/test/test_PlayEventsAutoPlaying.html"], "git_node": null, "git_parents": [null], "node": "688c9284fb121c3a30ce16e149c08a245441aa1b", "parents": ["6f93b270d1e36cc85e15b0b2e133b7ab3908cd3f"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1382303 - Part 2: Do not activate autoplay early. r=jwwang, a=gchang\n\nPer spec, autoplay should only gets triggered once readyState is equal to HAVE_ENOUGH_DATA\n\nMozReview-Commit-ID: 6nW1U6G1qme", "files": ["dom/html/HTMLMediaElement.cpp"], "git_node": null, "git_parents": [null], "node": "7f969ba7b6e807f17d68910bda0075f8e2af3b64", "parents": ["688c9284fb121c3a30ce16e149c08a245441aa1b"], "tags": []}, {"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1382303 - Part 3: Reduce enough data threadhold to 10s. r=jwwang, a=gchang\n\nWe waited 30s until we changed readyState to HAVE_ENOUGH_DATA this would cause autoplay media element to start rather late. In particular with live stream. 10s is typically enough ahead time to start playback.\n\nMozReview-Commit-ID: LJvY8cQYfwZ", "files": ["dom/media/mediasource/MediaSourceDecoder.cpp"], "git_node": null, "git_parents": [null], "node": "7e7b4f104462c4766a339afbccb908bcc5e7fac2", "parents": ["7f969ba7b6e807f17d68910bda0075f8e2af3b64"], "tags": []}, {"author": "Tristan Bourvon \u003ctbourvon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1383000 - Fix UAF in nsJAR::GetInputStreamWithSpec. r=aklotz, a=gchang\n\nMozReview-Commit-ID: 6g7wusTbLfN", "files": ["modules/libjar/nsJAR.cpp"], "git_node": null, "git_parents": [null], "node": "ce65d0641c07af7f6ca4dee216d86fae7fa6fbb0", "parents": ["7e7b4f104462c4766a339afbccb908bcc5e7fac2"], "tags": []}, {"author": "Philip Chimento \u003cphilip.chimento@gmail.com\u003e", "branch": "default", "desc": "Bug 1339931 - Add major version to make parallel installable. r=sfink, a=gchang", "files": ["js/src/Makefile.in", "js/src/shell/Makefile.in"], "git_node": null, "git_parents": [null], "node": "8658b524ed6d7200c4ff91327a7e925d95e694c7", "parents": ["ce65d0641c07af7f6ca4dee216d86fae7fa6fbb0"], "tags": []}], "date": 1501502064, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7237": {"changesets": [{"author": "Honza Bambas \u003chonzab.moz@