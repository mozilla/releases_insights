pp"], "git_node": null, "git_parents": [null], "node": "5bd51bc3f5873e0e7aa5a56553f9f0cd0e04bc21", "parents": ["93148654a8e28379d7d9771639e8de37880b1ced"], "tags": []}], "date": 1498601813, "git_changesets": [null], "user": "jcoppeard@mozilla.com"}, "7177": {"changesets": [{"author": "George Wright \u003cgeorge@mozilla.com\u003e", "branch": "FIREFOX_ESR_52_2_X_RELBRANCH", "desc": "Bug 1318845 - Ensure we support DWrite fonts in the parent process when the GPU process is enabled. r=Bas, a=ritu", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/thebes/gfxWindowsPlatform.cpp"], "git_node": null, "git_parents": [null], "node": "512efd480dac58acf9eebd5f25a76b32917ab56d", "parents": ["93148654a8e28379d7d9771639e8de37880b1ced"], "tags": ["FIREFOX_52_2_1esr_BUILD2", "FIREFOX_52_2_1esr_RELEASE"]}], "date": 1498603988, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7178": {"changesets": [{"author": "Tim Nguyen \u003cntim.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1371586 - Improve security of media query links. r=pbro, a=lizzard", "files": ["devtools/client/styleeditor/StyleEditorUI.jsm"], "git_node": null, "git_parents": [null], "node": "d0c92199b9edbfe33e7f7483a5884e3baf3b0078", "parents": ["5bd51bc3f5873e0e7aa5a56553f9f0cd0e04bc21"], "tags": []}, {"author": "George Wright \u003cgeorge@mozilla.com\u003e", "branch": "default", "desc": "Bug 1318845 - Ensure we support DWrite fonts in the parent process when the GPU process is enabled. r=Bas, a=ritu", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/thebes/gfxWindowsPlatform.cpp"], "git_node": null, "git_parents": [null], "node": "a5bbba7a442db52ecaee8e00e4639f725df505c0", "parents": ["d0c92199b9edbfe33e7f7483a5884e3baf3b0078"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1364513 - Ensure correct buffer initialization. r=mystor, a=abillings", "files": ["dom/canvas/ImageBitmap.cpp"], "git_node": null, "git_parents": [null], "node": "88e9c2137640634ce2f9a7051bb601a983a3b2ec", "parents": ["a5bbba7a442db52ecaee8e00e4639f725df505c0"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1366203 - Revert about blank creation for URIs that don't inherit principals. r=mconley, a=lizzard\n\nMozReview-Commit-ID: 4F0Tq60iVUk", "files": ["browser/base/content/tabbrowser.xml", "browser/base/content/test/urlbar/browser_urlbar_stop_pending.js", "browser/base/content/utilityOverlay.js"], "git_node": null, "git_parents": [null], "node": "08dd87b6bb8f7eb3514468c17790b1cedfabf4bc", "parents": ["88e9c2137640634ce2f9a7051bb601a983a3b2ec"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1368576 - Fix addOsrValueTypeBarrier to use type from the TypeSet if it's more precise. r=nbp, a=abillings", "files": ["js/src/jit/IonBuilder.cpp"], "git_node": null, "git_parents": [null], "node": "5a51a9ef81495ae079fca69fa1ed365f3c204910", "parents": ["08dd87b6bb8f7eb3514468c17790b1cedfabf4bc"], "tags": []}, {"author": "Arthur Edelstein \u003carthuredelstein@gmail.com\u003e", "branch": "default", "desc": "Bug 1344034 - Auto-enforce W^X for WindowsDllInterceptor hook pages. r=dmajor, a=abillings", "files": ["xpcom/build/nsWindowsDllInterceptor.h"], "git_node": null, "git_parents": [null], "node": "012e4429ccd9f086da6f76d438267bd6ee92b63d", "parents": ["5a51a9ef81495ae079fca69fa1ed365f3c204910"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1369913 - Better check of the buffer size in WebSocket. r=smaug, a=gchang", "files": ["dom/base/WebSocket.cpp"], "git_node": null, "git_parents": [null], "node": "f47eaebc0c5c5e9c7a7e75a67ce6ebb13325b5a1", "parents": ["012e4429ccd9f086da6f76d438267bd6ee92b63d"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1371424 - Trace the right thing in TypedArray's TraceSelf implementation. r=mccr8, a=lizzard", "files": ["dom/bindings/TypedArray.h"], "git_node": null, "git_parents": [null], "node": "40ce248a8c157f8022fbc4f15271a9f1133fa286", "parents": ["f47eaebc0c5c5e9c7a7e75a67ce6ebb13325b5a1"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1372112 - Use encodeURI to set ImageTooltipHelper image source. r=pbro, a=lizzard\n\nMozReview-Commit-ID: IypbCTQZr8d", "files": ["devtools/client/shared/widgets/tooltip/ImageTooltipHelper.js"], "git_node": null, "git_parents": [null], "node": "0c8359ac671855075adb65eb7975c2cc4f9a391a", "parents": ["40ce248a8c157f8022fbc4f15271a9f1133fa286"], "tags": []}], "date": 1498623875, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7179": {"changesets": [{"author": "Chris Pearce \u003ccpearce@mozilla.com\u003e", "branch": "default", "desc": "Bug 1375708 - Use base::Time() instead of time(0) in WidevineDecryptor::GetCurrentWallTime(). r=gerald, a=gchang\n\nOn Linux some implementations of time(0) appear to be suffering from integer\noverflow and giving us the wrong dates. This causes the time we expose to the\nCDM to be wrong, and so licenses passed to the CDM are failing to authenticate,\nand Netflix is thus broken on some Linux systems.\n\nThis is only happening in Firefox 54 and earlier, as in those versions we use\nthe WidevineDecryptor to talk to the CDM. In 55 (in beta) and later we use the\nPChromiumCDM protocol to talk to the CDM. This doesn't use time(0) to get a\ntime for the CDM, so it's immune to the problem here.\n\nSo this patch makes the GetCurrentWallTime() implementation in\nWidevineDecryptor match the code currently being used on Nightly and Beta in\nthe ChromiumCDMChild::GetCurrentWallTime() function.\n\nSince we use the PChromiumCDM protocol to talk to the CDM on Nightly and Beta\nby default, the WidevineDecryptor isn't actually being used on Nightly and\nBeta. So this patch will only cause a behaviour change in Release, which still\nuses the old backend. However it will make Release run the same code that we're\nrunning in Nightly and Beta, so it should be safe to uplift to Release.\n\nMozReview-Commit-ID: J58iDyinyQG", "files": ["dom/media/gmp/widevine-adapter/WidevineDecryptor.cpp", "dom/media/gmp/widevine-adapter/moz.build"], "git_node": null, "git_parents": [null], "node": "0f59191c605e4820c443d91cadb9b23adc87358b", "parents": ["0c8359ac671855075adb65eb7975c2cc4f9a391a"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1354443 - Part 0: Strip trailing whitespaces in nsPrintData, nsPrintEngine and nsPrintObject. r=dholbert, a=abillings\n\nThis originally landed under bug 1342994.\n\nMozReview-Commit-ID: GGBrj4Eo45L", "files": ["layout/printing/nsPrintData.cpp", "layout/printing/nsPrintData.h", "layout/printing/nsPrintEngine.cpp", "layout/printing/nsPrintEngine.h", "layout/printing/nsPrintObject.cpp", "layout/printing/nsPrintObject.h"], "git_node": null, "git_parents": [null], "node": "8c27a68ee87ee30a4de58052b0f0f982075418c2", "parents": ["0f59191c605e4820c443d91cadb9b23adc87358b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1354443 - Part 1-1: Make nsPrintData refcountable. r=dholbert, a=abillings", "files": ["layout/printing/nsPrintData.cpp", "layout/printing/nsPrintData.h", "layout/printing/nsPrintEngine.cpp", "layout/printing/nsPrintEngine.h"], "git_node": null, "git_parents": [null], "node": "b2ee0c5466da863b6a354a3950503e28625de0ea", "parents": ["8c27a68ee87ee30a4de58052b0f0f982075418c2"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1354443 - Part 1-2: Methods of nsPrintEngine should guarantee that objects owned by nsPrintData won't be released when they're referred by calling methods via their arguments. r=dholbert, a=abillings\n\nFor example, mPrt-\u003emPrintObject is owned by mPrt.  When nsPrintEngine needs to\ncall a method which takes a reference to mPrt-\u003emPrintObject, the caller should\ngrab the mPrt instance for guaranteeing that mPrt-\u003emPrintObject won't be deleted\nduring the method-call.", "files": ["layout/printing/nsPrintEngine.cpp"], "git_node": null, "git_parents": [null], "node": "25f6ec16e501c14ca743f373bc8565348ca5de22", "parents": ["b2ee0c5466da863b6a354a3950503e28625de0ea"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1354443 - Part 2: nsPrintEngine::Disconnect() should clear mPrintObj. r=dholbert, a=abillings\n\nMozReview-Commit-ID: 1fUZ8YJCvxh", "files": ["layout/printing/nsPagePrintTimer.h"], "git_node": null, "git_parents": [null], "node": "30443b4f758ec6a7b88f718891ae7f1fee159f86", "parents": ["25f6ec16e501c14ca743f373bc8565348ca5de22"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1354443 - Part 3: While nsDocumentViewer is destroying mPrintEngine, null out its pointer & transfer ownership to local var. r=dholbert, a=abillings\n\nMozReview-Commit-ID: ALRlOC07SY2", "files": ["layout/base/nsDocumentViewer.cpp"], "git_node": null, "git_parents": [null], "node": "1b934ab92c59ca30a1628b7598fab41d661cb43e", "parents": ["30443b4f758ec6a7b88f718891ae7f1fee159f86"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1354443 - Part 4: nsPrintData should guarantee that object which has nsIWebProgressListener interface won't be released during calling a method of it. r=dholbert, a=abillings\n\nAlthough, this should be rewritten with range-based for loop, this patch just making them use nsCOMPtr to refer the objects.\n\nMozReview-Commit-ID: IJBWs8CTyCF", "files": ["layout/printing/nsPrintData.cpp"], "git_node": null, "git_parents": [null], "node": "830a345dc0e754e3f7b8a35c49ba6ac70b24b985", "parents": ["1b934ab92c59ca30a1628b7598fab41d661cb43e"], "tags": []}], "date": 1498658444, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7180": {"changesets": [{"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 1365189, part 1 - Prevent SVG elements that are neither displayable nor paint servers from painting. r=dholbert, a=abillings", "files": ["layout/base/nsCSSRendering.cpp", "layout/svg/nsSVGIntegrationUtils.cpp"], "git_node": null, "git_parents": [null], "node": "5c26df489768ec3290f0994be28ff74737e51d7c", "parents": ["830a345dc0e754e3f7b8a35c49ba6ac70b24b985"], "tags": []}], "date": 1498681278, "git_changesets": [null], "user": "jwatt@jwatt.org"}, "7181": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-382 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "230c8eb5b59229749170d4cd426ee091a6822fdc", "parents": ["5c26df489768ec3290f0994be28ff74737e51d7c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-382 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "9d143b06c935eb1004e075c60b004c415e6bd5b8", "parents": ["230c8eb5b59229749170d4cd426ee091a6822fdc"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-382 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "72472bfe7fa5e973fbc1a575947d3b98b7a87ff2", "parents": ["9d143b06c935eb1004e075c60b004c415e6bd5b8"], "tags": []}], "date": 1498683246, "git_changesets": [null, null, null], "user": "ffxbld"}, "7182": {"changesets": 