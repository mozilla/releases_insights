1-1b.html"], "git_node": null, "git_parents": [null], "node": "0f3f951461d75a45133bf3e2dc8635a0bbd0d706", "parents": ["cfb75012cfbd5c7cf19bb8a1f9c00e852df83a3e"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1321803 - Part 3: Don't claim that we forced a non-scrollable block for \u003cbody\u003e elements in a print presentation that would have propagated their scrollbars to the viewport.  We do still want to create a non-scrollable block for them, though. r=dbaron, a=gchang", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/reftests/printing/129941-1c.html", "layout/reftests/printing/129941-1d.html", "layout/reftests/printing/129941-1e.html", "layout/reftests/printing/1321803-1-ref.html", "layout/reftests/printing/1321803-1a.html", "layout/reftests/printing/reftest.list"], "git_node": null, "git_parents": [null], "node": "b654a39db998a7f944ffedf5976f4e4b8208b14d", "parents": ["0f3f951461d75a45133bf3e2dc8635a0bbd0d706"], "tags": []}, {"author": "Colin Dean \u003ccolin.dean@specialiapps.org\u003e", "branch": "default", "desc": "Bug 1364984 - Use non-deprecated API for finding the temporary directory on OS X. r=mstange, a=gchang\n\nFSFindFolder is deprecated as of 10.9 and apparently continues to\nwork...except for the case of finding the temporary directory when the\nuser's home directory lives on an NFS mount (!).  Using\nNSTemporaryDirectory does The Right Thing here, so let's use that instead.", "files": ["xpcom/io/CocoaFileUtils.h", "xpcom/io/CocoaFileUtils.mm", "xpcom/io/SpecialSystemDirectory.cpp"], "git_node": null, "git_parents": [null], "node": "3a94108601395538960e250e72ba9dcdad1699ca", "parents": ["b654a39db998a7f944ffedf5976f4e4b8208b14d"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl.mozilla.bugs@gmail.com\u003e", "branch": "default", "desc": "Bug 1364984 - Ensure that our sandbox and tests can handle temp directory paths using symlinks on macOS. r=haik, r=aswan, a=gchang", "files": ["dom/ipc/ContentChild.cpp", "toolkit/modules/subprocess/test/xpcshell/test_subprocess.js", "xpcom/tests/unit/test_file_equality.js"], "git_node": null, "git_parents": [null], "node": "a0899a3dcd7e54e9ca1c09a7bcbbd8da5311de10", "parents": ["3a94108601395538960e250e72ba9dcdad1699ca"], "tags": []}], "date": 1500069417, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7210": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "673716d0cae0c4f30f503ec85c9c51f9939630bb", "parents": ["a0899a3dcd7e54e9ca1c09a7bcbbd8da5311de10"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-302 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "f023b3c9b64bd71179eba022289c6fd5be403119", "parents": ["673716d0cae0c4f30f503ec85c9c51f9939630bb"], "tags": []}], "date": 1500135859, "git_changesets": [null, null], "user": "ffxbld"}, "7211": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "ea75c724ed8d4ce9a41b3a2aa6f9ac329db0b202", "parents": ["f023b3c9b64bd71179eba022289c6fd5be403119"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-302 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "2ebcec6798551c83e5a3566c862a040750fa128a", "parents"