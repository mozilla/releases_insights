on: we would have stalled forever as the waiting promise would never have been resolved even after new data was appended.\n\nMozReview-Commit-ID: BQSRSHYqTSe", "files": ["dom/media/MediaFormatReader.cpp"], "git_node": null, "git_parents": [null], "node": "f02db36497d2063974698714357325fe211cd05e", "parents": ["00378e7da4956834d8569a77887e5f1e3ce907ba"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1374047 - Keep WebSocketImpl alive before calling DisconnectInternal. r=smaug, a=jcristau", "files": ["dom/base/WebSocket.cpp"], "git_node": null, "git_parents": [null], "node": "0a44ed156da592c123050de540fd5d475ae418de", "parents": ["f02db36497d2063974698714357325fe211cd05e"], "tags": []}, {"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1371259 - Rejigger DOM object unwrapping to take mutable handles to the JS value/object in a bunch of cases. r=peterv, r=mccr8, a=lizzard", "files": ["dom/base/StructuredCloneHolder.cpp", "dom/base/nsDOMClassInfo.cpp", "dom/base/nsDOMClassInfo.h", "dom/base/nsDOMWindowUtils.cpp", "dom/base/nsDocument.cpp", "dom/bindings/BindingUtils.cpp", "dom/bindings/BindingUtils.h", "dom/bindings/Codegen.py", "dom/bindings/WebIDLGlobalNameHash.cpp", "dom/indexedDB/IDBObjectStore.cpp", "dom/media/WebVTTListener.cpp", "dom/messagechannel/MessagePort.cpp", "dom/notification/Notification.cpp", "dom/presentation/PresentationSessionInfo.cpp", "dom/promise/Promise.cpp", "dom/workers/ScriptLoader.cpp", "dom/workers/ServiceWorker.cpp", "dom/workers/ServiceWorkerScriptCache.cpp", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerScope.cpp", "dom/xbl/nsXBLProtoImplField.cpp", "dom/xslt/xpath/XPathExpression.cpp", "js/xpconnect/idl/nsIXPConnect.idl", "js/xpconnect/src/ExportHelpers.cpp", "js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCComponents.cpp", "js/xpconnect/src/XPCConvert.cpp", "js/xpconnect/src/XPCJSContext.cpp", "js/xpconnect/src/XPCJSID.cpp", "js/xpconnect/src/XPCJSWeakReference.cpp", "js/xpconnect/src/XPCWrappedJSClass.cpp", "js/xpconnect/src/XPCWrappedNativeJSOps.cpp", "js/xpconnect/src/nsXPConnect.cpp", "js/xpconnect/src/xpcpublic.h"], "git_node": null, "git_parents": [null], "node": "0a86729d653eb5afcaecc7ee7a4d65d05e51d133", "parents": ["0a44ed156da592c123050de540fd5d475ae418de"], "tags": []}, {"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1378826 - Remove direct track listeners for video tracks if MediaRecorder is notified of their removal. r=jesup, a=lizzard", "files": ["dom/media/MediaRecorder.cpp"], "git_node": null, "git_parents": [null], "node": "98ff43fb228af2896bf77de3e687b6a22bb5955c", "parents": ["0a86729d653eb5afcaecc7ee7a4d65d05e51d133"], "tags": []}], "date": 1499903407, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "7207": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-301 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "d746ef382de7644548ddc501a131138f301f3c93", "parents": ["98ff43fb228af2896bf77de3e687b6a22bb5955c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-301 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "0e2a1fa647e7326737ec8abecb27aa99ef1170ab", "parents": ["d746ef382de7644548ddc501a131138f301f3c93"], "tags": []}], "date": 1499961254, "git_changesets": [null, null], "user": "ffxbld"}, "7208": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-304 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/ns