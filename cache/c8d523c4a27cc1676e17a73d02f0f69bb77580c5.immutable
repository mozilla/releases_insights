from host bld-linux64-spot-307 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "14066bb22d5ec965ec7b56f2d1aa94fd77960e15", "parents": ["88aca1a8a69e7154de2cf3685072558809f22be1"], "tags": []}], "date": 1499269565, "git_changesets": [null, null], "user": "ffxbld"}, "7194": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-301 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "cb77b2d504e7794300fc9e3b4a9c1956727b489f", "parents": ["14066bb22d5ec965ec7b56f2d1aa94fd77960e15"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-301 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "056206bd99b0dc6b9045db738f1eb39199bb0f7f", "parents": ["cb77b2d504e7794300fc9e3b4a9c1956727b489f"], "tags": []}], "date": 1499355957, "git_changesets": [null, null], "user": "ffxbld"}, "7195": {"changesets": [{"author": "Honza Bambas \u003chonzab.moz@firemni.cz\u003e", "branch": "default", "desc": "Bug 1354796 - Close unconnected HTTP connection with NS_ERROR_NET_TIMEOUT after 90s timeout. r=mcmanus, a=ritu", "files": ["netwerk/protocol/http/nsHttpConnectionMgr.cpp"], "git_node": null, "git_parents": [null], "node": "69d1a9de76b9ee7ec0224eeac00c76b9d88909e4", "parents": ["056206bd99b0dc6b9045db738f1eb39199bb0f7f"], "tags": []}, {"author": "Alexander Surkov \u003csurkov.alexander@gmail.com\u003e", "branch": "default", "desc": "Bug 1363027 - Keep removing accessible alive during event coalescence. r=davidb, a=ritu", "files": ["accessible/generic/DocAccessible.cpp"], "git_node": null, "git_parents": [null], "node": "c5eaa2d51b9f43541bdb88a8e87ad3a20cfb18a2", "parents": ["69d1a9de76b9ee7ec0224eeac00c76b9d88909e4"], "tags": []}, {"author": "Dragana Damjanovic \u003cdd.mozilla@gmail.com\u003e", "branch": "default", "desc": "Bug 1364189 - Make sure not to retry socketTransaction if nsHttpConnectionMgr cancels it. r=mcmanus, a=ritu", "files": ["netwerk/base/nsSocketTransport2.cpp", "netwerk/base/nsSocketTransport2.h"], "git_node": null, "git_parents": [null], "node": "852a7781259ed8f77ce0f46cd8c115af63f3f43f", "parents": ["c5eaa2d51b9f43541bdb88a8e87ad3a20cfb18a2"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1342417 - ClearStyle should check that SplitStyleAbovePoint returns node. r=masayuki, a=ritu\n\nSplitStyleAbovePoint can return null for split node, but we don't check it.\nAlso, this crash occurs on paste operation, so I think that there is 100% reproduce test.  But I cannot find it.\n\nMozReview-Commit-ID: 69OlPTc0I9h", "files": ["editor/libeditor/HTMLStyleEditor.cpp"], "git_node": null, "git_parents": [null], "node": "37ccdc5fff2ba3c579b529c5029f32cbeb4d839b", "parents": ["852a7781259ed8f77ce0f46cd8c115af63f3f43f"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1369386 - Fix old invalid millimeter page size prefs using print_paper_size_type as trigger. r=jimm, a=ritu\n\nThese old invalid prefs were caused by us not clearing out old inch page size prefs when the\nuser switched to a standard mm page size (for example A4).\nThis fix uses the fact that an old print_paper_size_type pref was removed at the same time\nto trigger a one off sanitization.", "files": ["widget/nsPrintOptionsImpl.cpp"], "git_node": null, "git_parents": [null], "node": "44228e9137173113c4ae39766c31235dc2a7df8b", "parents": ["37ccdc5fff2ba3c579b529c5029f32cbeb4d839b"], "tags": []}, {"author": "Stephen Fewer \u003cstephen@relyze.com\u003e", "branch": "default", "desc": "Bug 1372849 - Improve the security of WindowsDllDetourPatcher. r=dmajor, a=ritu\n\nMozReview-Commit-ID: BLONsj0OmRy", "files": ["xpcom/build/nsWindowsDllInterceptor.h"], "git_node": null, "git_parents": [null], "node": "a8bd61fc89cc32ac09b86ed8c04a5b69328e376f", "parents": ["44228e9137173113c4ae39766c31235dc2a7df8b"], "tags": []}, {"author": "Cameron McCormack \u003ccam@mcc.id.au\u003e", "branch": "default", "desc": "Bug 1362924 - Part 1: Stop synchronously running XBL constructors and flushing style in PresShell::Initialize. r=tnikkel, a=abillings\n\nMozReview-Commit-ID: 8GUm6Mt5wiK", "files": ["layout/base/nsPresShell.cpp"], "git_node": null, "git_parents": [null], "node": "057ed884ecb045a433b977a37fabaeb2ba0feeed", "parents": ["a8bd61fc89cc32ac09b86ed8c04a5b69328e376f"], "tags": []}, {"author": "Cameron McCormack \u003ccam@mcc.id.au\u003e", "branch": "default", "desc": "Bug 1362924 - Part 2: Add script blockers around remaining PresShell::{Destroy,Initialize} calls to protect against re-entrant nsDocumentViewer calls. r=tnikkel, a=abillings\n\nMozReview-Commit-ID: G0lUGsNLb2b", "files": ["layout/base/nsDocumentViewer.cpp"], "git_node": null, "git_parents": [null], "node": "dd7ed649b82fc5f9d1827ae8c20522ee43fedcf2", "parents": ["057ed884ecb045a433b977a37fabaeb2ba0feeed"], "tags": []}, {"author": "Cameron McCormack \u003ccam@mcc.id.au\u003e", "branch": "default", "desc": "Bug 1353312 - Don't use conditions when caching a struct with no rules. r=dbaron, a=abillings\n\nMozReview-Commit-ID: 2Q1xWcDY10T", "files": ["layout/style/RuleNodeCacheConditions.h", "layout/style/nsRuleNode.cpp", "layout/style/nsRuleNode.h"], "git_node": null, "git_parents": [null], "node": "731958f7ff4da93892663a9c94dcafc7a44d5b91", "parents": ["dd7ed649b82fc5f9d1827ae8c20522ee43fedcf2"], "tags": []}], "date": 1499376596, "git_changesets": [null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7196": {"changesets": [{"author": "Jean-Yves Avenard \u003cjyavenard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1364870 - [ffmpeg] only check format if frame has been decoded. r=gerald, a=gchang\n\nThe format member isn't set when an audio frame hasn't been decoded yet.\n\nMozReview-Commit-ID: IgUj6bjVzdF", "files": ["dom/media/platforms/ffmpeg/FFmpegAudioDecoder.cpp"], "git_node": null, "git_parents": [null], "node": "de8deecbcb02343e05ea338cd63478844e76d536", "parents": ["731958f7ff4da93892663a9c94dcafc7a44d5b91"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1365333 - Avoid quadratic performance in nsDisplayLayerEventRegions::AddFrame() when the maybe-hit region has many rects. r=tnikkel, a=gchang\n\nMozReview-Commit-ID: 99QrhFpHw15", "files": ["layout/base/nsDisplayList.cpp"], "git_node": null, "git_parents": [null], "node": "e3d13b270f45609ccfcb1f1e1d69447adfcf37b0", "parents": ["de8deecbcb02343e05ea338cd63478844e76d536"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1372063 - Use fallible array to avoid OOM. r=jimm, a=gchang\n\nAlthough mChannelData uses infallible array, OOM occurs by AppendElements since clipboard data is too large.  So we should use fallible array instead.\n\nMozReview-Commit-ID: KdIWv2jGbDK", "files": ["widget/windows/nsDataObj.cpp", "widget/windows/nsDataObj.h"], "git_node": null, "git_parents": [null], "node": "58a144bf9677b7161650a7e005aeec5013067ef2", "parents": ["e3d13b270f45609ccfcb1f1e1d69447adfcf37b0"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1373970 - Avoid null pointer deref. r=bagder, a=gchang\n\nMozReview-Commit-ID: BmcolZSrpIL", "files": ["netwerk/base/nsFileStreams.cpp"], "git_node": null, "git_parents": [null], "node": "8321ef71adb5fec6ac94b99b02261bd6511711c7", "parents": ["58a144bf9677b7161650a7e005aeec5013067ef2"], "tags": []}, {"author": "Gerald Squelart \u003cgsquelart@squelart.com\u003e", "branch": "default", "desc": "Bug 1374148 - Block D3D11 on more crashy nv