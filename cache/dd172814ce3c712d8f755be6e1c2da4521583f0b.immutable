ersion-files/beta/version_display.txt"], "git_node": null, "git_parents": [null], "node": "406d9840212b805ca2ea670d24f852c8430a0e13", "parents": ["36da37044f6d7b6f2e798b856d7f8a1882e1f3aa"], "tags": []}], "date": 1584394682, "git_changesets": [null, null], "user": "ffxbld"}, "966": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D67473", "files": ["browser/app/blocklist.xml", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons.json", "services/settings/dumps/blocklists/plugins.json"], "git_node": null, "git_parents": [null], "node": "54db9e0094dd842d9824922bfed7ef29a6f70856", "parents": ["406d9840212b805ca2ea670d24f852c8430a0e13"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1608240 - Add a policy to control user messaging. r=mconley, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_simple_pref_policies.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl"], "git_node": null, "git_parents": [null], "node": "b311f13f52a035061198d6e84fdc18d2e91d52ed", "parents": ["54db9e0094dd842d9824922bfed7ef29a6f70856"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1618131 - Poison moved GC thing contents sooner. r=jandem, a=RyanVM\n\nThis makes sure we will detect use of the contents of moved GC things during the update phase of the GC, not just when we return to the mutator as previously. Annoyingly we need to preserve contents for native objects with fixed elements because the elements flags are stored there and these may be accessed from other objects if they are COW elements.\n\nThis caught a use of unforwarded scripts during invalidation caused by OOM during sweeping type information.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D63872", "files": ["js/src/gc/GC.cpp", "js/src/jit/Ion.cpp"], "git_node": null, "git_parents": [null], "node": "b98350145456e9ae70e1bc71f8692f6a8a3beabd", "parents": ["b311f13f52a035061198d6e84fdc18d2e91d52ed"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1618880 - Fix GC hazard in jit::InvalidateActivation. r=jonco, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D66815", "files": ["js/src/jit/Ion.cpp", "js/src/jit/JSJitFrameIter.cpp", "js/src/jit/JSJitFrameIter.h", "js/src/jit/JitFrames.cpp", "js/src/jit/JitFrames.h"], "git_node": null, "git_parents": [null], "node": "2fac01c54524846de6e369f13a3c143ed54c5d12", "parents": ["b98350145456e9ae70e1bc71f8692f6a8a3beabd"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1572541 - ensure buffer capacity. r=bryce, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D66475", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/CodecProxy.java"], "git_node": null, "git_parents": [null], "node": "075b1d87f23047d68b57fde6096fdf3947d0a1f0", "parents": ["2fac01c54524846de6e369f13a3c143ed54c5d12"], "tags": []}], "date": 1584654842, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "967": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP blocklist remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D67853", "files": ["browser/app/blocklist.xml", "netwerk/dns/effective_tld_names.dat", "security/manager/ssl/Stat