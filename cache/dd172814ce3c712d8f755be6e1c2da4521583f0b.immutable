/base/java/org/mozilla/gecko/updater/UpdateServiceReceiver.java", "mobile/android/base/java/org/mozilla/gecko/updater/Updater.java", "mobile/android/base/java/org/mozilla/gecko/updater/UpdaterService.java", "mobile/android/base/java/org/mozilla/gecko/updater/UpdatesApplyService.java", "mobile/android/base/java/org/mozilla/gecko/updater/UpdatesCheckService.java", "mobile/android/base/java/org/mozilla/gecko/updater/UpdatesDownloadService.java", "mobile/android/base/java/org/mozilla/gecko/updater/UpdatesPrefs.java", "mobile/android/base/java/org/mozilla/gecko/updater/UpdatesRegisterService.java", "mobile/android/config/version-files/release/version.txt", "mobile/android/config/version-files/release/version_display.txt"], "git_node": null, "git_parents": [null, null], "node": "09dcc64cbc433b6d78de33e44821c36bb07baa5a", "parents": ["16d79644762736956033ef1b43686c992a44e270", "d5bc259574e77a27496e5bbbc56f635ff669e24f"], "tags": []}], "date": 1583577236, "git_changesets": [null], "user": "archaeopteryx@coole-files.de"}, "941": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt", "mobile/android/config/version-files/beta/version.txt", "mobile/android/config/version-files/beta/version_display.txt", "mobile/android/config/version-files/nightly/version.txt", "mobile/android/config/version-files/nightly/version_display.txt", "mobile/android/config/version-files/release/version.txt", "mobile/android/config/version-files/release/version_display.txt"], "git_node": null, "git_parents": [null], "node": "f9df27a6bdc9edc102c892e4d1728b61cb32a518", "parents": ["e04f325233a9e91d3c9f71fd5809a60516756996"], "tags": []}], "date": 1583769000, "git_changesets": [null], "user": "ffxbld-merge"}, "942": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "default", "desc": "Bug 1620610 - Remove coalescing for tasks. r=catlee a=NPOTB\n\nBug 1602446 disabled coalescing for tasks which was designed to reduce load on\nthe pools which ran those tasks by skipping some of them. After coalescing was\naffecting almost no tasks, it started to coalesce more tasks in November 2019\n(bug 1602446) up to a level for which too few tasks ran and test coverage was\nimpacted. Coalescing got disabled and the conclusion is that coalescing is\ncurrently not needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D65733", "files": ["taskcluster/ci/test/kind.yml", "taskcluster/taskgraph/transforms/coalesce.py", "taskcluster/taskgraph/transforms/job/__init__.py", "taskcluster/taskgraph/transforms/openh264.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "748a391a226471f6d633c851314869ecc23349a0", "parents": ["f9df27a6bdc9edc102c892e4d1728b61cb32a518"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1620779 - Use built-in cargo vendor to vendor wrench / wgpu. a=NPOTB\n\nWe were using the old cargo-vendor, which tries to fetch dependencies in a way\nthat crates.io dislikes, leading to spurious timeouts.\n\nUse the built-in command instead. We no longer need the --relative-path flag\nbecause the built-in one uses a relative path by default.\n\nMANUAL PUSH: Fixing tree closure, so need to push on CLOSED TREE.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D65882", "files": ["taskcluster/scripts/misc/wrench-deps-vendoring.sh"], "git_node": null, "git_parents": [null], "node": "00a7aedc07c36f3917a0a1bd3c7697b08c8c6de2", "parents": ["748a391a226471f6d633c851314869ecc23349a0"], "tags": []}], "date": 1583771743, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "943": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "FIREFOX_ESR_68_6_X_RELBRANCH", "desc": "No bug - Bump version number to 68.6.1. a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "84de4841a9fc07e8b814a98238477addd766ca28", "parents": ["09dcc64cbc433b6d78de33e44821c36bb07baa5a"], "tags": []}, {"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "FIREFOX_ESR_68_6_X_RELBRANCH", "desc": "Bug 1620610 - Remove coalescing for tasks. r=catlee a=NPOTB\n\nBug 1602446 disabled coalescing for tasks which was designed to reduce load on\nthe pools which ran those tasks by skipping some of them. After coalescing was\naffecting almost no tasks, it started to coalesce more tasks in November 2019\n(bug 1602446) up to a level for which too few tasks ran and test coverage was\nimpacted. Coalescing got disabled and the conclusion is that coalescing is\ncurrently not needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D65733", "files": ["taskcluster/ci/test/kind.yml", "taskcluster/taskgraph/transforms/coalesce.py", "taskcluster/taskgraph/transforms/job/__init__.py", "taskcluster/taskgraph/transforms/openh264.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "36ee82ef8d07394c6c5a257660cd47e67714f465", "parents": ["84de4841a9fc07e8b814a98238477addd766ca28"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "FIREFOX_ESR_68_6_X_RELBRANCH", "desc": "Bug 1620779 - Use built-in cargo vendor to vendor wrench / wgpu. a=NPOTB\n\nWe were using the old cargo-vendor, which tries to fetch dependencies in a way\nthat crates.io dislikes, leading to spurious timeouts.\n\nUse the built-in command instead. We no longer need the --relative-path flag\nbecause the built-in one uses a relative path by default.\n\nMANUAL PUSH: Fixing tree closure, so need to push on CLOSED TREE.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D65882", "files": ["taskcluster/scripts/misc/wrench-deps-vendoring.sh"], "git_node": null, "git_parents": [null], "node": "298575e503f944f0ba7f8f4975dcca215682b445", "parents": ["36ee82ef8d07394c6c5a257660cd47e67714f465"], "tags": []}], "date": 1583772752, "git_changesets": [null, null, null], "user": "archaeopteryx@coole-files.de"}, "944": {"changesets": [{"author": "Sebastian Hengst \u003carchaeopteryx@coole-files.de\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1620610 - Remove coalescing for tasks. r=catlee a=NPOTB\n\nBug 1602446 disabled coalescing for tasks which was designed to reduce load on\nthe pools which ran those tasks by skipping some of them. After coalescing was\naffecting almost no tasks, it started to coalesce more tasks in November 2019\n(bug 1602446) up to a level for which too few tasks ran and test coverage was\nimpacted. Coalescing got disabled and the conclusion is that coalescing is\ncurrently not needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D65733", "files": ["taskcluster/ci/test/kind.yml", "taskcluster/taskgraph/transforms/coalesce.py", "taskcluster/taskgraph/transforms/job/__init__.py", "taskcluster/taskgraph/transforms/openh264.py", "taskcluster/taskgraph/transforms/task.py"], "git_node": null, "git_parents": [null], "node": "a941cc51cdb619eeded70ac45c50aee8689737f0", "parents": ["09dcc64cbc433b6d78de33e44821c36bb07baa5a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "THUNDERBIRD_68_VERBRANCH", "desc": "Bug 1620779 - Use built-in cargo vendor to vendor wrench / wgpu. a=NPOTB\n\nWe were using the old cargo-vendor, which tries to fetch dependencies in a way\nthat crates.io dislikes, leading to spurious timeouts.\n\nUse the built-in command instead. We no longer need the --relative-path flag\nbecause the built-in one uses a relative path by default.\n\nMANUAL PUSH: Fixing tree closure, so need to push on CLOSED TREE.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D65882", "files": ["taskcluster/scripts/misc/wrench-deps-vendoring.sh"], "git_node": null, "git_parents": [null], "node": "2a6f2ff09c34eb40fdf77cec2af1176d5c96a467", "parents": ["a941cc51cdb619eeded70ac45c50aee8689737f0"], "tags": []}], "date": 1583772834, "git_changesets": [null, null], "user": "archaeopteryx@coole-files.de"}, "945": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D66001", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "f1d7f0da9cf7a26cf2d37e84008fcc06e5b066c2", "parents": ["00a7aedc07c36f3917a0a1bd3c7697b08c8c6de2"], "tags": []}], "date": 1583772965, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "946": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "no bug - Bumping Fennec l10n changesets r=release a=l10n-bump DONTBUILD\n\nar -\u003e feea1578c8f9\nast -\u003e 66db94b7bf8c\nbe -\u003e d964ecf3e4e0\nbg -\u003e 0e6ceb783e97\nbn -\u003e 5cbe42445ed2\nbr -\u003e 07a7ad7bf8b4\nca -\u003e b4cf8f3fc271\ncak -\u003e b2bd58c84ed0\ncs -\u003e 345940421c7b\ncy -\u003e cb6433a0d9f5\nde -\u003e a5147c75eae7\ndsb -\u003e 85b29e0bffb9\nel -\u003e 8ac60eb8c33e\nen-CA -\u003e 621961dee93b\nen-GB -\u003e 002a2ae0b6b5\neo -\u003e 144bc419e415\nes-AR -\u003e 7ef752917e52\nes-CL -\u003e dd3973578cd3\nes-ES -\u003e 65618f47c446\nes-MX -\u003e d2091fad0a6e\neu -\u003e 52c8c40c6a92\nff -\u003e 57a98991d05a\nfi -\u003e e6a741e452e7\nfr -\u003e af6df6a6cd0d\nfy-NL -\u003e 75f129d5223b\ngn -\u003e cdfadbd53c45\nhe -\u003e c04e0760c3b5\nhi-IN -