fb5a47182b"], "tags": []}, {"author": "Kirk Steuber \u003cksteuber@mozilla.com\u003e", "branch": "default", "desc": "Bug 1612979 - Enable locking of auto update setting. r=mkaply,mhowell,jaws a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.ini", "browser/components/enterprisepolicies/tests/browser/browser_policy_app_auto_update.js", "browser/components/enterprisepolicies/tests/browser/disable_app_update/browser_policy_disable_app_update.js", "browser/components/preferences/in-content/main.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl", "toolkit/modules/UpdateUtils.jsm"], "git_node": null, "git_parents": [null], "node": "4cbbc30e1ebc3254ec74dc041aff128c81220507", "parents": ["3a6123da412cf707fc8071e9631c00d5e685f61a"], "tags": []}], "date": 1585250420, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "969": {"changesets": [{"author": "Johan Lorenzo \u003cjlorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1614287 - Remove Fennec Beta target_tasks so it does not mess up the Fenix migration r=rail a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D62249", "files": ["taskcluster/ci/config.yml", "taskcluster/taskgraph/target_tasks.py"], "git_node": null, "git_parents": [null], "node": "57352ccfac02e1a71512e414ba9af3fa35ab9168", "parents": ["4cbbc30e1ebc3254ec74dc041aff128c81220507"], "tags": []}], "date": 1585315806, "git_changesets": [null], "user": "cbrindusan@mozilla.com"}, "970": {"changesets": [{"author": "Byron Campen [:bwc] \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1624956: Make sure we're initted before trying to get ICE stats. r=mjf, a=jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D68246", "files": ["media/webrtc/signaling/src/peerconnection/MediaTransportHandler.cpp"], "git_node": null, "git_parents": [null], "node": "f8469d65a5288042cafdc67634286997778edbf9", "parents": ["57352ccfac02e1a71512e414ba9af3fa35ab9168"], "tags": []}, {"author": "Petru-Mugurel Lingurar \u003cpetru.lingurar@softvision.ro\u003e", "branch": "default", "desc": "Bug 1621533 - Expose downloads through FileProvider on Nougat+; r=AndreiLazar, a=jcristau\n\n\nAndroid Nougat came with the recommendation to expose files through a\nFileProvider (content:// in place of file://).\nSeems like Android 10's PackageInstaller imposes this behaviour - to be able to\ninstall dowloaded apks we need to offer them through a FileProvider.\nOr use the Android's PackageInstaller.\n\nThere are currently 2 options users have to install an apk directly from the\napplication:\n  - tapping the notification of a completed apk download - fixed by this patch\n  - opening a downloaded apk from \"about:downloads\" - will still be broken. A\nsolution for this scenario involves a major rethinking of how we handle\ndownloads.\n\nThe download functionality works ok on all platforms, including Android 10 so\nusers will still be able to go with a file manager to the Downloads folder of\ntheir device and manually install a previously downloaded apk from there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D67668", "files": ["mobile/android/base/java/org/mozilla/gecko/notifications/NotificationHelper.java"], "git_node": null, "git_parents": [null], "node": "17b55aa3a26ffc29fb40094f991ee9b49822f204", "parents": ["f8469d65a5288042cafdc67634286997778edbf9"], "tags": []}], "date": 1585578159, "git_changesets": [null, null], "user": "jcristau@mozilla.com"}, "971": {"changesets": [{"author": "Mihai Alexandru Michis \u003cmalexandru@mozilla.com\u003e", "branch": "default", "desc": "Backed out changeset f8469d65a528 (bug 1624956) for causing bustages in MediaTransportHandler.cpp a=backout", "files": ["media/webrtc/signaling/src/peerconnection/MediaTransportHandler.cpp"], "git_node": null, "git_parents": [null], "node": "f89689040f418f44bbe3b93b286b37dd3f87f1d9", "parents": ["17b55aa3a26ffc29fb40094f991ee9b49822f204"], "tags": []}], "date": 1585580633, "git_changesets": [null], "user": "malexandru@mozilla.com"}, "972": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr68 repo-update blocklist remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D68797", "files": ["browser/app/blocklist.xml", "services/settings/dumps/blocklists/addons.json"], "git_node": null, "git_parents": [null], "node": "9d4a99a7c0b4c8c7a19be334296ed65818a14a81", "parents": ["f89689040f418f44bbe3b93b286b37dd3f87f1d9"], "tags": []}, {"author": "Mike Taylor \u003cmiket@mozilla.com\u003e", "branch": "default", "desc": "Bug 1621062 - Import WebCompat v9.0.0 sources. r=denschub, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D68261", "files": ["mobile/android/extensions/webcompat/about-compat/aboutCompat.html", "mobile/android/extensions/webcompat/about-compat/aboutPage.json", "mobile/android/extensions/webcompat/data/injections.js", "mobile/android/extensions/webcompat/data/picture_in_picture_overrides.js", "mobile/android/extensions/webcompat/data/ua_overrides.js", "mobile/android/extensions/webcompat/experiment-apis/aboutConfigPrefs.json", "mobile/android/extensions/webcompat/injections/css/bug1432935-discordapp.com-webkit-scorllbar-white-line.css", "mobile/android/extensions/webcompat/injections/css/bug1518781-twitch.tv-webkit-scrollbar.css", "mobile/android/extensions/webcompat/injections/css/bug1575017-dunkindonuts.com-flex-basis.css", "mobile/android/extensions/webcompat/injections/js/bug1577245-salesforce-communities-hide-unsupported.js", "mobile/android/extensions/webcompat/injections/js/bug1623375-salesforce-communities-hide-unsupported.js", "mobile/android/extensions/webcompat/lib/custom_functions.js", "mobile/android/exte