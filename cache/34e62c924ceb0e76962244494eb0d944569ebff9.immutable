bdomain. This was requested to lower the amount of\nactive HTTP endpoints.\n\nMozReview-Commit-ID: JAFjQFhTCxT", "files": ["testing/firefox-ui/tests/functional/security/test_security_notification.py"], "git_node": null, "git_parents": [null], "node": "135cba1f77acbbeb957648d9786809b2810daf98", "parents": ["82927d3e9ea4862179b222198a520bc3498a9fa1"], "tags": []}], "date": 1496062326, "git_changesets": [null], "user": "cbook@mozilla.com"}, "7131": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "be6701f4d023db4902f411c10aaab4871ac73f81", "parents": ["135cba1f77acbbeb957648d9786809b2810daf98"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-303 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "0ac7ffc2b4bb8f3e10775efd60ccb4ba596f6625", "parents": ["be6701f4d023db4902f411c10aaab4871ac73f81"], "tags": []}], "date": 1496070937, "git_changesets": [null, null], "user": "ffxbld"}, "7132": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-306 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "c627b2fb13318271e2ba8ec803538bd89126708d", "parents": ["0ac7ffc2b4bb8f3e10775efd60ccb4ba596f6625"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-306 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "e554101ca0da784b926a604d3b7c78ec21830a1f", "parents": ["c627b2fb13318271e2ba8ec803538bd89126708d"], "tags": []}], "date": 1496157036, "git_changesets": [null, null], "user": "ffxbld"}, "7133": {"changesets": [{"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 1349531 - Remove non-threadsafe static buffers, r=jandem a=NPOTB", "files": ["js/src/shell/OSObject.cpp"], "git_node": null, "git_parents": [null], "node": "70cd711c6ae87875525a3383fdd8dc696d62db78", "parents": ["e554101ca0da784b926a604d3b7c78ec21830a1f"], "tags": []}], "date": 1496158604, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7134": {"changesets": [{"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1364228 - Increase marionette startup timeout for Linux mochitests. r=ato, a=test-only\n\nOur linux32-debug build is very slow to startup when running mochitests on aws.\nSometimes we see similar behavior on other linux platforms. Intermittently,\nin this environment, startup takes longer than the 120 seconds that marionette\nwaits, resulting in test failures in bug 1261598. Increasing the marionette\nstartup timeout to 180 seconds appears to effectively avoid these failures.", "files": ["layout/tools/reftest/reftestcommandline.py", "layout/tools/reftest/runreftest.py", "testing/marionette/client/marionette_driver/marionette.py", "testing/mochitest/mochitest_options.py", "testing/mochitest/runtests.py", "testing/mozharness/configs/unittests/linux_unittest.py"], "git_node": null, "git_parents": [null], "node": "1515f76d292209c3dfa9e9528df9a7665cc2c039", "parents": ["70cd711c6ae87875525a3383fdd8dc696d62db78"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1260312 - Remove a race in the mochitest-chrome harness. r=jmaher, a=test-only\n\nStart listening for \"chromeEvent\" before loading the script that sends it.", "files": ["testing/mochitest/browser-test.js"], "git_node": null, "git_parents": [null], "node": "2e07e407d6831a6e903a9944b1c55aea8ad36896", "parents": ["1515f76d292209c3dfa9e9528df9a7665cc2c039"], "tags": []}, {"author": "Geoff Brown \u003cgbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 1260312 - Retry mochitest-chrome redirection to improve reliability. r=jmaher, a=test-only\n\nThe mochitest-chrome harness sends a custom \"contentEvent\" event from redirect.html\nto a listener in browser-test.js. It is possible for redirect.html to be loaded\nand send contentEvent before the listener is set up in browser-test.js. In the\nabsence of a better synchronization strategy, redirect.html now retries the send\nafter a few seconds. If the first contentEvent was received, the second will be\nignored; if the first contentEvent was not received, the second should avoid an\nintermittent harness hang and timeout.", "files": ["testing/mochitest/redirect.html"], "git_node": null, "git_parents": [null], "node": "cbad82e6e31bb8626b1fab205692b21e8e1ba346", "parents": ["2e07e407d6831a6e903a9944b1c55aea8ad36896"], "tags": []}, {"author": "Gregory Szorc \u003cgps@mozilla.com\u003e", "branch": "default", "desc": "Bug 1361172 - Rewrite code for finding files in VCS checkout. r=glandium, a=release\n\nWe're getting an intermittent failure running `hg manifest` in CI. I\nhave no clue why.\n\nWhat I do know is that we now have the mozversioncontrol Python package\nfor containing utility code for interacting with version control. It is\nslightly more robust and I'm willing to support it more than I am\ncheck_utils.py.\n\nThis commit adds a new API to our abstract repository class to obtain the\nfiles in the working directory by querying version control.\n\nSince I suspect cwd was coming into play in automation, I've also\nadded a utility function to mozversioncontrol to attempt to find\na version control checkout from the current working directory. It\nsimply traces ancestor paths looking for a .hg or .git directory.\n\nFinally, I've ported all callers of the now-deleted API to the new\none. The old code had some \"../..\" paths in it, meaning it only\nworked when cwd was just right. Since we resolve the absolute path\nto the checkout and store it on the repo object, I've updated the\ncode so it should work no matter what cwd is as long as a repo can\nbe found. I'm not 100% confident I found all consumers assuming cwd.\nBut it's a start.\n\nI'm not 100% confident this will fix the intermittent issues in CI. But\nat least we should get a better error message and at least we'll be\nrunning less hacky code.\n\nMozReview-Commit-ID: AmCraHXcTEX", "files": ["config/check_js_msg_encoding.py", "config/check_macroassembler_style.py", "config/check_spidermonkey_style.py", "config/check_utils.py", "python/mozversioncontrol/mozversioncontrol/__init__.py"], "git_node": null, "git_parents": [null], "node": "91f75b4b32b7f809b4b7ad360d36616e01c8166c", "parents": ["cbad82e6e31bb8626b1fab205692b21e8e1ba346"], "tags": []}], "date": 1496192141, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "7135": {"changesets": [{"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 1342567. r=aosmond, a=jcristau", "files": ["image/imgLoader.cpp"], "git_node": null, "git_parents": [null], "node": "6e644bc1a57fddaea427a544e00ccd49a06240af", "parents": ["91f75b4b32b7f809b4b7ad360d36616e01c8166c"], "tags": []}], "date": 1496271095, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7136": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Bug 1369250 - set VIRTUALENV_NO_DOWNLOAD so virtualenv versions \u003e=14 will know to not download new packages, and older versions won't object to not knowing about the commandline --no-download, a=philor CLOSED TREE\n\nMozReview-Commit-ID: 9MpTWFIGMkA", "files": ["testing/mozharness/mozharness/base/python.py"], "git_node": null, "git_parents": [null], "node": "7c87585eedc4eaf75c3e960b0415c07a5a444a03", "parents": ["6e644bc1a57fddaea427a544e00ccd49a06240af"], "tags": []}], "date": 1496299780, "git_changesets": [null], "user": "philringnalda@gmail.com"}, "7137": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-305 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "d4bfc3e47c025903c2910dfcdd5e3fc939afd740", "parents": ["7c87585eedc4eaf75c3e960b0415c07a5a444a03"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-305 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "6a8641574b83698785f5b894ef2bd64dd70a5cc5", "parents": ["d4bfc3e47c025903c2910dfcdd5e3fc939afd740"], "tags": []}], "date": 1496330398, "git_changesets": [null, null], "user": "ffxbld"}, "7138": {"changesets": [{"author": "Bryce Van Dyk \u003cbvandyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 1368490 - Make sure number of channels is correctly set for opus encoder. r=jesup, a=abillings\n\nMozReview-Commit-ID: 7bOxCvlvTDq", "files": ["dom/media/encoder/TrackEncoder.cpp"], "git_node": null, "git_parents": [null], "node": "279bffa85beba76437f0dac098ab6c9a6a67cd79", "parents": ["6a8641574b83698785f5b894ef2bd64dd70a5cc5"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1356824 - Don't clear mWaitingFactoryOp without holding a self reference in (Open|Delete)DatabaseOp::NoteDatabaseClosed(). r=btseng, a=ritu\n\nRemove now useless self reference in OpenDatabaseOp::SendResults(). Add comments for how to call\nFactoryOp::Run() safely and also add comments to all the call sites. This prevents a self destruction\nwhile Run() (or a method that is called by Run()) is still being executed. Also fix\nTransactionDatabaseOperationBase which also calls Run() directly in NoteContinueReceived().", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "0abcbc6ef8f311a6f46ff7f03299a77cf0aad7d1", "parents": ["279bffa85beba76437f0dac098ab6c9a6a67cd79"], "tags": []}, {"author": "sotaro \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1363280 - Fix Updating sImageBridges handling. r=dvander, r=nical, a=ritu", "files": ["gfx/layers/ipc/CompositorThread.cpp", "gfx/layers/ipc/ImageBridgeParent.cpp", "gfx/layers/ipc/ImageBridgeParent.h", "gfx/layers/ipc/LayerTransactionParent.cpp"], "git_node": null, "git_parents": [null], "node": "e0261afd69b9243e570a95c663c72336d61ada11", "parents": ["0abcbc6ef8f311a6f46ff7f03299a77cf0aad7d1"], "tags": []}], "date": 1496350256, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "7139": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-364 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "9533c13390ed4110c805f4a1b70c50100a8f122a", "parents": ["e0261afd69b9243e570a95c663c72336d61ada11"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-364 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "8e588ca1a86508851d54f7e453858d49dc5ff792", "parents": ["9533c13390ed4110c805f4a1b70c50100a8f122a"], "tags": []}], "date": 1496416806, "git_changesets": [null, null], "user": "ffxbld"}, "7140": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-306 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security