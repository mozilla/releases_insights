de": null, "git_parents": [null], "node": "69fe3d1de65c880312be8ffb4e3b87571506aeb0", "parents": ["8492f65ce7a24727a1f4fb174a5aff526193c4ee"], "tags": []}], "date": 1494430313, "git_changesets": [null], "user": "kaie@kuix.de"}, "7083": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset 69fe3d1de65c (bug 1357599) for ExtendedValidation.cpp assertions.", "files": ["old-configure.in", "security/nss/TAG-INFO", "security/nss/coreconf/coreconf.dep", "security/nss/lib/certdb/genname.c", "security/nss/lib/ckfw/builtins/certdata.txt", "security/nss/lib/ckfw/builtins/nssckbi.h", "security/nss/lib/nss/nss.h", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/nssutil.h"], "git_node": null, "git_parents": [null], "node": "4fbb945d30dd6b0d37bf22d502e8f1b7f157943c", "parents": ["69fe3d1de65c880312be8ffb4e3b87571506aeb0"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1352132 - Navigation unit tests have to wait for the page loaded in the newly opened tab. r=ato, a=test-only\n\nThere is a race condition for all navigation tests inside the setUp\nmethod of the BaseNavigationTestCase class. The assert for history\nitems can already happen if the page hasn't been fully loaded yet.\nAs such a failure is thrown. To fix this we have to wait for the\npage being loaded.\n\nMozReview-Commit-ID: 9LbArVT9WqA", "files": ["testing/marionette/harness/marionette_harness/tests/unit/test_navigation.py"], "git_node": null, "git_parents": [null], "node": "587f5295339a116f702264bda82c0073fb0be360", "parents": ["4fbb945d30dd6b0d37bf22d502e8f1b7f157943c"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1353765 - Add missing FileSystemDirectoryEntry.h include to fix bustage that occurs in some build configs. r=baku, a=jcristau", "files": ["dom/filesystem/compat/FileSystemDirectoryReader.h"], "git_node": null, "git_parents": [null], "node": "1d2e2fde559a9abd1fba4f883091c97114a33559", "parents": ["587f5295339a116f702264bda82c0073fb0be360"], "tags": []}], "date": 1494439687, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "7084": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-307 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "773d7a8b835a1962e86ad8d14d90806466cb7689", "parents": ["1d2e2fde559a9abd1fba4f883091c97114a33559"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-307 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "6785850e48908ae6450ed6546fd210983e8eb9a3", "parents": ["773d7a8b835a1962e86ad8d14d90806466cb7689"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-307 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "1a29850e605a0d762afed76a37157a429e166f0e", "parents": ["6785850e48908ae6450ed6546fd210983e8eb9a3"], "tags": []}], "date": 1494515100, "git_changesets": [null, null, null], "user": "ffxbld"}, "7085": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1363396 - Ensure ContentViewer listeners are handled only when needed. r=mccr8, a=abillings", "files": ["layout/base/nsDocumentViewer.cpp"], "git_node": null, "git_parents": [null], "node": "24cbb7f2e0ff938948e01a6217c323ef07a5701e", "parents": ["1a29850e605a0d762afed76a37157a429e166f0e"], "tags": []}, {"author": "Bevis Tseng \u003cbtseng@mozilla.com\u003e", "branch": "default", "desc": "Bug 1356558 - Do not run ScriptRunner in the intermediate state before destroying PreShell, PresContext, etc at nsDocumentViewer::Hide() is done. r=bz, a=gchang\n\n  Do not run ScriptRunners queued by DestroyPresShell() in the intermediate state\n  before we're done destroying PresShell, PresContext, ViewManager, etc.\n\nMozReview-Commit-ID: LNP7Lp7zekS", "files": ["layout/base/nsDocumentViewer.cpp"], "git_node": null, "git_parents": [null], "node": "89c7fb6c5be315e67b0a1292941cc988931dae95", "parents": ["24cbb7f2e0ff938948e01a6217c323ef07a5701e"], "tags": []}], "date": 1494515942, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7086": {"changesets": [{"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1363893 - Remove downed scl3 proxxy instance. r=catlee, a=release\n\nMozReview-Commit-ID: DBvun6vwCGX", "files": ["testing/mozharness/mozharness/mozilla/proxxy.py"], "git_node": null, "git_parents": [null], "node": "6fbf8768a0307100a9835a9eb80abe195def54b7", "parents": ["89c7fb6c5be315e67b0a1292941cc988931dae95"], "tags": []}, {"author": "Randell Jesup \u003crjesup@jesup.org\u003e", "branch": "default", "desc": "Bug 1337810 - Use sender SSRC for receivers. r=drno, a=ritu", "files": ["media/webrtc/signaling/src/peerconnection/MediaPipelineFactory.cpp"], "git_node": null, "git_parents": [null], "node": "0f6dd3564c7681b5d3da97d52733261308377c83", "parents": ["6fbf8768a0307100a9835a9eb80abe195def54b7"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1347748 - Error check the write methods. r=layzell, a=ritu", "files": ["dom/events/DataTransfer.cpp"], "git_node": null, "git_parents": [null], "node": "145905da25d32c8fd2b1866780a8f0f4f99f5ced", "parents": ["0f6dd3564c7681b5d3da97d52733261308377c83"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1345355 - Allow pinch gestures with a zero span change but a nonzero focus change to scroll. r=botond, a=ritu\n\nIt appears that some touchpad devices send us \"touch\" events (i.e. WM_TOUCH on\nWindows) but with all touch points having the same coordinates. This ends up\ngetting detected as a zero-span pinch gesture in APZ, which short-circuits early\nand doesn't really get processed. Therefore even if the focus point changes we\ndon't do any corresponding scroll. This patch shifts things around a little so\nthat the short-circuit doesn't happen quite so early, and we still scroll when\nthe focus point changes, even if the span is zero.\n\nMozReview-Commit-ID: 3CaQN1MsM8y", "files": ["gfx/layers/apz/src/AsyncPanZoomController.cpp"], "git_node": null, "git_parents": [null], "node": "c5012009a0b2203de9e59474b6b68933343bcd00", "parents": ["145905da25d32c8fd2b1866780a8f0f4f99f5ced"], "tags": []}, {"author": "Kartikaya Gupta \u003ckgupta@mozilla.com\u003e", "branch": "default", "desc": "Bug 1345355 - Add a gtest for a pinch with zero span but changing focus. r=botond, a=ritu\n\nMozReview-Commit-ID: 8AstF1QmBzw", "files": ["gfx/layers/apz/test/gtest/TestPinching.cpp"], "git_node": null, "git_parents": [null], "node": "3caa4973f29431dc73a4c7b3c93a05f6678bd11f", "parents": ["c5012009a0b2203de9e59474b6b68933343bcd00"], "tags": []}, {"author": "Liang-Heng Chen \u003cxeonchen@gmail.com\u003e", "branch": "default", "desc": "Bug 1351340 - Check null pointer before using. r=bagder, a=ritu\n\nMozReview-Commit-ID: LJ0FtjZTKq3", "files": ["netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": null, "git_parents": [null], "node": "047f19a1b9a096fb12f2c28575e6603ad51f7b95", "parents": ["3caa4973f29431dc73a4c7b3c93a05f6678bd11f"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1056322 - Don't run DictionaryFetcher when spllchecker isn't initialized. r=masayuki, a=ritu\n\nWhen CanSpellCheck isn't called yet, mSpellChecker won't be initialized.  So we should check it before running DictionaryFetcher.\n\nI think that UpdateCurrentDictionary is called by OnFocus as long as nsEditorSpellCheck::InitSpellChecker isn't called.  But I cannot find test case to reproduce this...\n\nMozReview-Commit-ID: 5H1pJ0AnX5X", "files": ["editor/composer/nsEditorSpellCheck.cpp"], "git_node": null, "git_parents": [null], "node": "f076a30f6c291b7dfcda20a230ed910f373a3515", "parents": ["047f19a1b9a096fb12f2c28575e6603ad51f7b95"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1355414 - places.sqlite schema migration fails if an application has never used the bookmarks service. r=past, a=ritu\n\nMozReview-Commit-ID: 13YXf2On75J", "files": ["toolkit/components/places/Database.cpp", "toolkit/components/places/Database.h", "toolkit/components/places/tests/migration/test_current_from_v34_no_roots.js", "toolkit/components/places/tests/migration/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "28e09d4ac3e960e318d6d95546428ea5ba0aaf69", "parents": ["f076a30f6c291b7dfcda20a230ed910f373a3515"], "tags": []}, {"author": "Markus Stange \u003cmstange@themasta.com\u003e", "branch": "default", "desc": "Bug 1313977 - Don't round fractional mouse coordinates up, because doing so might push them outside the window. r=kats, a=ritu\n\nOn my machine, if I have my mouse cursor positioned flush against the right\nedge of my screen (which is 1440x900@2x), locationInWindow has an x coordinate\nof 1439.99609375. This value was rounded up to an integer screen coordinate of\n2880, and for that coordinate we don't find a target APZC, and consequently\nrefuse to scroll.\n\nMozReview-Commit-ID: CJic4g3Y6Ag", "files": ["widget/cocoa/nsChildView.h", "widget/cocoa/nsChildView.mm", "widget/cocoa/nsCocoaUtils.h"], "git_node": null, "git_parents": [null], "node": "4c0b09f70aea03e0a4f751685be5e7fff9b7d5a8", "parents": ["28e09d4ac3e960e318d6d95546428ea5ba0aaf69"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1357366 - Avoid a possible crash loop in Places Database corruption handling. r=past, a=ritu\n\nMozReview-Commit-ID: BIN3ji68nAY", "files": ["toolkit/components/places/Database.cpp"], "git_node": null, "git_parents": [null], "node": "0b855945ce34188a3ea6be73c7cc189bef09e909", "parents": ["4c0b09f70aea03e0a4f751685be5e7fff9b7d5a8"], "tags": []}], "date": 1494533710, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7087": {"changesets": [{"author": "Emanuel Hoogeveen \u003cemanuel.hoogeveen@gmail.com\u003e", "branch": "default", "desc": "Bug 1338574 - Part 0: Pass __LINE__ as an argument to MOZ_REALLY_CRASH() instead of using it directly. r=froydnj, a=NPOTB", "files": ["mfbt/Assertions.h"], "git_node": null, "git_parents": [null], "node": "243d7bffa4f120bc396991e1bb76fc893d9f2f9f", "parents": ["0b855945ce34188a3ea6be73c7cc189bef09e909"], "tags": []}, {"author": "Emanuel Hoogeveen \u003cemanuel.hoogeveen@gmail.com\u003e", "branch": "default", "desc": "Bug 1338574 - Part 1: Add MOZ_CRASH_UNSAFE_OOL and MOZ_CRASH_UNSAFE_PRINTF to crash with a runtime generated explanation string. r=froydnj, a=NPOTB", "files": ["memory/replace/logalloc/replay/moz.build", "mfbt/Assertions.cpp", "mfbt/Assertions.h"], "git_node": null, "git_parents": [null], "node": "337398a83aa5168326f57177dd496b06c213130f", "parents": ["243d7bffa4f120bc396991e1bb76fc893d9f2f9f"], "tags": []}], "date": 1494535195, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7088": {"changesets": [{"author": "Emanuel Hoogeveen \u003cemanuel.hoogeveen@gmail.com\u003e", "branch": "default", "desc": "Bug 1338574 - Part 2: Use MOZ_CRASH_UNSAFE_PRINTF in Media. r=jwwang, a=NPOTB", "files": ["dom/media/MediaShutdownManager.cpp"], "git_node": null, "git_parents": [null], "node": "50e120d7ac64a36aff6c4392b1e972bad2b0f95f", "parents": ["337398a83aa5168326f57177dd496b06c213130f"], "tags": []}, {"author": "Emanuel Hoogeveen \u003cemanuel.hoogeveen@gmail.com\u003e", "branch": "default", "desc": "Bug 1338574 - Part 3: Use MOZ_CRASH_UNSAFE_PRINTF in IPC glue. r=mrbkap, a=NPOTB", "files": ["ipc/glue/BackgroundChildImpl.cpp"], "git_node": null, "git_parents": [null], "node": "2d4da5a366e8e24e8db8133ac14890d66e3aa3cb", "parents": ["50e120d7ac64a36aff6c4392b1e972bad2b0f95f"], "tags": []}, {"author": "Emanuel Hoogeveen \u003cemanuel.hoogeveen@gmail.com\u003e", "branch": "default", "desc": "Bug 1338574 - Part 4: Use MOZ_CRASH_UNSAFE_OOL and MOZ_CRASH_UNSAFE_PRINTF in SpiderMonkey. r=jandem, a=NPOTB", "files": ["js/src/gc/Memory.cpp", "js/src/shell/js.cpp"], "git_node": null, "git_parents": [null], "node": "b10d9b0c187f525bda8bb521998302f1830ae2c6", "parents": ["2d4da5a366e8e24e8db8133ac14890d66e3aa3cb"], "tags": []}, {"author": "Emanuel Hoogeveen \u003cemanuel.hoogeveen@gmail.com\u003e", "branch": "default", "desc": "Bug 1338574 - Part 5: Use MOZ_CRASH_UNSAFE_OOL in Necko. r=valentin, a=NPOTB", "files": ["netwerk/ipc/NeckoParent.cpp"], "git_node": null, "git_parents": [null], "node": "697713a6841ca85e9daadf8bcbbe20585141ef8f", "parents": ["b10d9b0c187f525bda8bb521998302f1830ae2c6"], "tags": []}, {"author": "Emanuel Hoogeveen \u003cemanuel.hoogeveen@gmail.com\u003e", "branch": "default", "desc": "Bug 1338574 - Part 7: Use MOZ_CRASH_UNSAFE_PRINTF in XPCOM. r=froydnj, a=NPOTB", "files": ["xpcom/ds/nsAtomTable.cpp", "xpcom/glue/nsTArray.cpp"], "git_node": null, "git_parents": [null], "node": "1d14abf37cf8cac38763f79c70742fac5a0fbb16", "parents": ["697713a6841ca85e9daadf8bcbbe20585141ef8f"], "tags": []}, {"author": "Emanuel Hoogeveen \u003cemanuel.hoogeveen@gmail.com\u003e", "branch": "default", "desc": "Bug 1338574 - Part 8: Use MOZ_ASSERT and MOZ_CRASH_UNSAFE_OOL in mozjemalloc. r=glandium, a=NPOTB", "files": ["memory/mozjemalloc/jemalloc.c"], "git_node": null, "git_parents": [null], "node": "5e85bc599d0c94f0ba792c9505081ba6486f7557", "parents": ["1d14abf37cf8cac38763f79c70742fac5a0fbb16"], "tags": []}], "date": 1494537188, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7089": {"changesets": [{"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1362889 - Ensure the MockContentController in APZ GTests doesn't outlive the test fixture. r=kats, a=test-only\n\nMozReview-Commit-ID: AuSC5w1FXWG", "files": ["gfx/layers/apz/test/gtest/APZCBasicTester.h", "gfx/layers/apz/test/gtest/APZCTreeManagerTester.h", "gfx/layers/apz/test/gtest/APZTestCommon.h"], "git_node": null, "git_parents": [null], "node": "68e0c0279f72f7fbd83c9a3aa11775dd2fa34679", "parents": ["5e85bc599d0c94f0ba792c9505081ba6486f7557"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1152353 - Repost printer properties completion messages after nsAppShell::ProcessNextNativeEvent. r=jimm, a=ritu", "files": ["widget/windows/nsAppShell.cpp", "widget/windows/nsAppShell.h"], "git_node": null, "git_parents": [null], "node": "d893dea8e7b47beccc6bfddcfc8a2866e77ea908", "parents": ["68e0c0279f72f7fbd83c9a3aa11775dd2fa34679"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 1353649 - Update tzdata in ICU data files to 2017b. r=Waldo, a=ritu", "files": ["config/external/icu/data/icudt58l.dat", "intl/tzdata/SVN-INFO", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/IntlTimeZoneData.h", "js/src/tests/Intl/DateTimeFormat/timeZone_backward_links.js", "js/src/tests/Intl/DateTimeFormat/timeZone_backzone.js", "js/src/tests/Intl/DateTimeFormat/timeZone_backzone_links.js", "js/src/tests/Intl/DateTimeFormat/timeZone_notbackward_links.js"], "git_node": null, "git_parents": [null], "node": "b388642b066467743b3f920e79d7080ef1798858", "parents": ["d893dea8e7b47beccc6bfddcfc8a2866e77ea908"], "tags": []}, {"author": "Shane Caraveo \u003cscaraveo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1345893 - Handle Suspend() called on an HTTP channel from http-on-modify-request handler. r=mayhemer, a=ritu\n\nMozReview-Commit-ID: LbW9zgnPzmu", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/test/unit/test_suspend_channel_on_modified.js", "netwerk/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "3a747480ead177402f8a1b9dc6cfa249401c5da6", "parents": ["b388642b066467743b3f920e79d7080ef1798858"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1343172 - PBlob should not create a remoteInputStream if that already exists. r=smaug, a=ritu", "files": ["dom/ipc/Blob.cpp"], "git_node": null, "git_parents": [null], "node": "c7b064f6b93aa0af228a53052c72cfc8760b1b92", "parents": ["3a747480ead177402f8a1b9dc6cfa249401c5da6"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 1352348 - Add a method to nsExternalHelperAppService that only fetches a string mimetype for an extension. r=bz, r=Paolo, a=ritu\n\nMozReview-Commit-ID: 3p1pakC9g45", "files": ["uriloader/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/nsExternalHelperAppService.h", "uriloader/exthandler/win/nsOSHelperAppService.cpp", "uriloader/exthandler/win/nsOSHelperAppService.h"], "git_node": null, "git_parents": [null], "node": "1d86e96610a1c431b8a10f35306d66804177dc92", "parents": ["c7b064f6b93aa0af228a53052c72cfc8760b1b92"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1356843 - Fix -Wcomma warning in dom/xml/nsXMLFragmentContentSink.cpp. r=bz, a=ritu\n\nclang's -Wcomma warning warns about suspicious use of the comma operator such as calling a function for side effects within an expression.\n\nThis warning indicates that nsXMLFragmentContentSink::CloseElement() has been calling aContent-\u003eIsHTMLElement() but not using its return value to determine whether to call PreventExecution(). This was a regression from bug 1134280 back in 2015.\n\ndom/xml/nsXMLFragmentContentSink.cpp:227:50 [-Wcomma] possible misuse of comma operator here\n\nMozReview-Commit-ID: 8y16ISsmNLh", "files": ["dom/xml/nsXMLFragmentContentSink.cpp"], "git_node": null, "git_parents": [null], "node": "3a80d48a9249c162868272af23fa09c5c556bb0c", "parents": ["1d86e96610a1c431b8a10f35306d66804177dc92"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1354308 - Entries API must support patches containing '..'. r=froydnj, a=ritu", "files": ["dom/filesystem/FileSystemSecurity.cpp", "dom/filesystem/compat/tests/script_entries.js", "dom/filesystem/compat/tests/test_basic.html"], "git_node": null, "git_parents": [null], "node": "c8ba3f911eb1fdd4f763f7dbeb96fca09b22eca4", "parents": ["3a80d48a9249c162868272af23fa09c5c556bb0c"], "tags": []}], "date": 1494553526, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7090": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-023 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "d8031f89261994b5dc020ddf526adb5773068c6a", "parents": ["c8ba3f911eb1fdd4f763f7dbeb96fca09b22eca4"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-023 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "502b6aa6fe4aec910532947d4c2af428656edd3b", "parents": ["d8031f89261994b5dc020ddf526adb5773068c6a"], "tags": []}], "date": 1494601687, "git_changesets": [null, null], "user": "ffxbld"}