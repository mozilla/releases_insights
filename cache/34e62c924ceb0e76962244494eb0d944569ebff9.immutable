": []}], "date": 1492526962, "git_changesets": [null, null, null], "user": "ffxbld"}, "7040": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "f97a4f739901e96d9a97a8f46bada5b6f809c06f", "parents": ["a87e87c1c8a0f1f1b86e1f55addc4d2625bfa0bd"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-302 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "15464a15ecf3d24bba72142f440ab371cac1ecfd", "parents": ["f97a4f739901e96d9a97a8f46bada5b6f809c06f"], "tags": []}], "date": 1492614010, "git_changesets": [null, null], "user": "ffxbld"}, "7041": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "3a00f0eeab5d783654e9ff64f7e81d72de886a16", "parents": ["15464a15ecf3d24bba72142f440ab371cac1ecfd"], "tags": []}, {"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "No bug - Tagging 3ea0e075203185d7f2d42f439455e97735bd1b20 with FIREFOX_52_1_0esr_BUILD3, FIREFOX_52_1_0esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "c53b44799e402185c3e38565b560ca5e2e66fbef", "parents": ["3a00f0eeab5d783654e9ff64f7e81d72de886a16"], "tags": []}], "date": 1492621870, "git_changesets": [null, null], "user": "ffxbld"}, "7042": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1355009 - Force update tests to only allow a single update. r=ato, a=test-only\n\nThere was never a need to run a multiple-update step in the past, and as\nwe agreed a while ago it is not something we want to do in the future.\nIt means that watershed releases will have to be tested by issuing\nmultiple update tests.\n\nMozReview-Commit-ID: 7cmK3gEOkv1", "files": ["testing/firefox-ui/harness/firefox_ui_harness/testcases.py"], "git_node": null, "git_parents": [null], "node": "562f2490aba8873aba9c59d76d66a8c1662529a8", "parents": ["c53b44799e402185c3e38565b560ca5e2e66fbef"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1355009 - Harden update tests with better error messages. r=ato, a=test-only\n\nTo ensure better failure messages a refactoring of checks has to be done. It\nincludes the following changes:\n\n* No further checks for a follow-up (watershed) update. It's not supported\nand as such doesn't need assertions (bug 1353717)\n\n* Checks for fallback updates have to be made to ensure that an invalidated\npartial/complete update does not cause an upgrade of Firefox during the restart.\n\nMozReview-Commit-ID: CLb0aXoIur2", "files": ["testing/firefox-ui/harness/firefox_ui_harness/testcases.py"], "git_node": null, "git_parents": [null], "node": "efa5bc8349b39c61b5efdf4b4bc74ad7b228566d", "parents": ["562f2490aba8873aba9c59d76d66a8c1662529a8"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1355009 - Temporarily disable usage of simplified update ui. r=ato, a=test-only\n\nAs long as update tests do not support the new simplified update ui\nit has to be kept disabled.\n\nMozReview-Commit-ID: 4fC0CYhp7Pc", "files": ["testing/firefox-ui/harness/firefox_ui_harness/runners/update.py"], "git_node": null, "git_parents": [null], "node": "c01007911fb75cced97aaf9a563c506758a27c8b", "parents": ["efa5bc8349b39c61b5efdf4b4bc74ad7b228566d"], "tags": []}], "date": 1492648374, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "7043": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-304 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "fee3f760827f2ead739a3b2ab7f28dab6874d5d5", "parents": ["c01007911fb75cced97aaf9a563c506758a27c8b"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-304 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "0c93b525864b1791aabe5934419c5ca7993efd23", "parents": ["fee3f760827f2ead739a3b2ab7f28dab6874d5d5"], "tags": []}], "date": 1492699819, "git_changesets": [null, null], "user": "ffxbld"}, "7044": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-307 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "83229e29b1a57f4b3f6af52550fd645f41e65000", "parents": ["0c93b525864b1791aabe5934419c5ca7993efd23"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-307 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "a64384626286b78d0ddddf59f80982ca8c13e56e", "parents": ["83229e29b1a57f4b3f6af52550fd645f41e65000"], "tags": []}], "date": 1492786406, "git_changesets": [null, null], "user": "ffxbld"}, "7045": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-305 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors",