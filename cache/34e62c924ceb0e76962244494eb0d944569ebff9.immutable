 1284083 - Skip test_pref_maxpages.js on Linux. r=mak, a=test-only", "files": ["toolkit/components/places/tests/expiration/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "32f7cbf9f8cfbdf9c9a2198819140913ecf22698", "parents": ["1373a741c3d0f4b4380dcb178b8669b56b94de2d"], "tags": []}, {"author": "Kate McKinley \u003ckmckinley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1237868 - Don't set URI_IS_LOCAL_RESOURCE on media streams. r=baku, a=ritu\n\nThis patch only sets URI_IS_LOCAL_RESOURCE if the resource is a blob or\nfont table entry, to avoid having media streams treated as local\nobjects.\n\nMozReview-Commit-ID: GOVr8FPByQy", "files": ["dom/base/nsHostObjectProtocolHandler.cpp", "dom/base/nsHostObjectProtocolHandler.h", "dom/base/test/unit/test_bloburi.js", "dom/base/test/unit/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "41138235d4ea891a6ce913a24fa8b8f0247c561f", "parents": ["32f7cbf9f8cfbdf9c9a2198819140913ecf22698"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1331335 - Add SSE2 Flags to all of libANGLE. r=jgilbert, a=ritu\n\nMozReview-Commit-ID: LjzlucR7sPx", "files": ["gfx/angle/src/libANGLE/moz.build"], "git_node": null, "git_parents": [null], "node": "b724283e3b3129bfe76b5837975dc084cdaaad71", "parents": ["41138235d4ea891a6ce913a24fa8b8f0247c561f"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1355818 - Wait for staging to finish in the update wizard if downloading is done before the download page appears. r=rstrong, a=ritu", "files": ["toolkit/mozapps/update/content/updates.js", "toolkit/mozapps/update/nsUpdateService.js", "toolkit/mozapps/update/tests/chrome/chrome.ini", "toolkit/mozapps/update/tests/chrome/test_0085_error_patchApplyFailure_partial_complete_staging.xul", "toolkit/mozapps/update/tests/chrome/utils.js", "toolkit/mozapps/update/tests/data/shared.js"], "git_node": null, "git_parents": [null], "node": "b04be5703bd74e276a1403d80c185ceb6f1ca8c9", "parents": ["b724283e3b3129bfe76b5837975dc084cdaaad71"], "tags": []}, {"author": "Mike Hommey \u003cmh@glandium.org\u003e", "branch": "default", "desc": "Bug 1367267 - Pass -fPIC when compiling the -pie configure test. r=gps, a=ritu", "files": ["build/autoconf/compiler-opts.m4"], "git_node": null, "git_parents": [null], "node": "4c2f4d8b693ebf0f34fd2cafec3ad7cc352df0ec", "parents": ["b04be5703bd74e276a1403d80c185ceb6f1ca8c9"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1366595 - Improve the use of strings in XHR logging. r=smaug, a=abillings", "files": ["dom/xhr/XMLHttpRequestMainThread.cpp"], "git_node": null, "git_parents": [null], "node": "cce3fd6072068bbce65b7e25453844ca45ec8f84", "parents": ["4c2f4d8b693ebf0f34fd2cafec3ad7cc352df0ec"], "tags": []}], "date": 1495752436, "git_changesets": [null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7125": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-303 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "40b0192e41cb9e89da670e896df16e1423d7ff2c", "parents": ["cce3fd6072068bbce65b7e25453844ca45ec8f84"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-303 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "90a4ac697f36e249b291e558c57c00b5cce553c7", "parents": ["40b0192e41cb9e89da670e896df16e1423d7ff2c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-303 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_pa