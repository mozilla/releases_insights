preload list update from host bld-linux64-spot-023 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "a74bf983e07a4d3c251b04c559b1c6dff2bc4521", "parents": ["5400da08a82e9e1c10d3075b6e1ad16b432489b8"], "tags": []}], "date": 1496676805, "git_changesets": [null, null], "user": "ffxbld"}, "7143": {"changesets": [{"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 1368732 - Use StringReplaceString instead of String_replace in Intl. r=till, a=ritu", "files": ["js/src/builtin/Intl.js"], "git_node": null, "git_parents": [null], "node": "4ec931d4bf29ad440c3f6a7717d0c904d5d4f671", "parents": ["a74bf983e07a4d3c251b04c559b1c6dff2bc4521"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1358073 - Call constructors when creating and copying scope data. r=shu, a=ritu", "files": ["js/src/vm/Scope.cpp"], "git_node": null, "git_parents": [null], "node": "a5a7fc1e6027beb906d5e07bd16800eec8ce20ac", "parents": ["4ec931d4bf29ad440c3f6a7717d0c904d5d4f671"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1364002 - Store the user-made search suggestion choice along with userMadeSearchSuggestionChoice. r=past, a=ritu\n\nMozReview-Commit-ID: 46vXbafZvq9", "files": ["browser/base/content/urlbarBindings.xml", "browser/components/nsBrowserGlue.js"], "git_node": null, "git_parents": [null], "node": "fbb4fac62ccbbc849e8a40642a009b042594de10", "parents": ["a5a7fc1e6027beb906d5e07bd16800eec8ce20ac"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1368477 - Mirror the search suggestions pref every time the user makes a choice. r=past, a=ritu\n\nMozReview-Commit-ID: IikmQTZcM4K", "files": ["browser/base/content/urlbarBindings.xml"], "git_node": null, "git_parents": [null], "node": "079dd3dc77bbd371744ead4e4d5fcc3e86690547", "parents": ["fbb4fac62ccbbc849e8a40642a009b042594de10"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1359837 - Block mozAddonsManager if xpinstall.enabled is false/locked. r=mossop, a=ritu\n\nMozReview-Commit-ID: 3BUxRLMjYkF", "files": ["toolkit/mozapps/extensions/AddonManagerWebAPI.cpp"], "git_node": null, "git_parents": [null], "node": "3669ab00f59d1f358437b5815ace1ea007266cba", "parents": ["079dd3dc77bbd371744ead4e4d5fcc3e86690547"], "tags": []}, {"author": "Johann Hofmann \u003cjhofmann@mozilla.com\u003e", "branch": "default", "desc": "Bug 1348791 - Add a timeout to master password prompt when searching logins. r=MattN, a=ritu\n\nThe login manager searching logins for autofill may trap the user\nin an infinite loop of master password prompts until the user enters\nthe correct master password. To prevent that, we're adding a timeout\nto showing the master password prompt for autofill after it was last\ncancelled.\n\nMozReview-Commit-ID: JcmTDU6CKKA", "files": ["modules/libpref/init/all.js", "toolkit/components/passwordmgr/LoginManagerParent.jsm"], "git_node": null, "git_parents": [null], "node": "4a52b2cfc49c26e5498481de956b09a9aab55878", "parents": ["3669ab00f59d1f358437b5815ace1ea007266cba"], "tags": []}, {"author": "Johann Hofmann \u003cjhofmann@mozilla.com\u003e", "branch": "default", "desc": "Bug 1348791 - Add a test for autocomplete master password timeout. r=MattN, a=ritu\n\nMozReview-Commit-ID: GTZQhI4VUv8", "files": ["toolkit/components/passwordmgr/test/browser/browser.ini", "toolkit/components/passwordmgr/test/browser/browser_master_password_autocomplete.js"], "git_node": null, "git_parents": [null], "node": "27083ff87fb429a4fd439c12304a128fd80dc731", "parents": ["4a52b2cfc49c26e5498481de956b09a9aab55878"], "tags": []}], "date": 1496693525, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7144": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "151943e368c77b83c3706a0a205929b29ac4144b", "parents": ["27083ff87fb429a4fd439c12304a128fd80dc731"], "tags": []}], "date": 1496694502, "git_changesets": [null], "user": "mtabara@mozilla.com"}, "7145": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Backed out changeset a5a7fc1e6027 (bug 1358073) for AutoEnterOOMUnsafeRegion crashes.", "files": ["js/src/vm/Scope.cpp"], "git_node": null, "git_parents": [null], "node": "ae9e08eaf6dc1482aa883521d9d324613fd9527c", "parents": ["151943e368c77b83c3706a0a205929b29ac4144b"], "tags": []}], "date": 1496701572, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7146": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "cd0756c943ab94c103a2662246426da2c26af9d4", "parents": ["ae9e08eaf6dc1482aa883521d9d324613fd9527c"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-302 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "d58850a06212a5f7c678d21c21901c4d29c180e2", "parents": ["cd0756c943ab94c103a2662246426da2c26af9d4"], "tags": []}], "date": 1496763248, "git_changesets": [null, null], "user": "ffxbld"}, "7147": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1368526 - Wait for the page to be loaded in a newly opened tab/window. r=ato, a=test-only\n\nIf a web page gets opened in a new tab or window, there is no way for\nthe navigate command to check the current page load status. Instead\nwe have to wait until the correct URL is getting reported.\n\nMozReview-Commit-ID: JQhPXRgh5Ae", "files": ["testing/marionette/harness/marionette_harness/tests/unit/test_window_handles_chrome.py"], "git_node": null, "git_parents": [null], "node": "eeb30d72326518dff20bd806ce7fd46d1bc167e4", "parents": ["d58850a06212a5f7c678d21c21901c4d29c180e2"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1339826 - Part 1: Don't assume that some nsIFile methods can't ever fail. r=btseng, a=ritu", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "9c29579fffe2e45c583adaba9966e0ad666923e2", "parents": ["eeb30d72326518dff20bd806ce7fd46d1bc167e4"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1339826 - Part 2: Warn if a maintenance finishes with an error. r=btseng, a=ritu", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/indexedDB/ReportInternalError.h"], "git_node": null, "git_parents": [null], "node": "be946ea1a75a84d9e5a020a576001b1bfc8cafc9", "parents": ["9c29579fffe2e45c583adaba9966e0ad666923e2"], "tags": []}, {"author": "Jan Varga \u003cjan.varga@gmail.com\u003e", "branch": "default", "desc": "Bug 1339826 - Part 3: Add a self reference in Maintenance::Finish() to prevent self destruction while the method is still being executed. r=btseng, a=ritu", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "44b2fe592a902a3dd7759b1ddd4d9bb07556b013", "parents": ["be946ea1a75a84d9e5a020a576001b1bfc8cafc9"], "tags": []}], "date": 1496797646, "git_changesets": [null, null, null, null], "user": "ryanvm@gmail.com"}, "7148": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-302 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "985e5c7da90bd403efa12f22804ef13b2c99a711", "parents": ["44b2fe592a902a3dd7759b1ddd4d9bb07556b013"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-302 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "a108d15a3a9ce25b83dac94e01bac95ff6d6e65b", "parents": ["985e5c7da90bd403efa12f22804ef13b2c99a711"], "tags": []}], "date": 1496849588, "git_changesets": [null, null], "user": "ffxbld"}, "7149": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1367692 - Make IMEHandler not restore default IMC unless legacy IMM-IME is active. r=m_kato, a=ritu\n\nTIPs (and normal keyboard layouts) don't need IMC on focused window.  So, in most environment, it's not necessary to restore default IMC of focused window.\n\nTherefore, this patch makes IMEHandler not restore default IMC unless legacy IMM-IME is active and disassociate IMC from focused window when IMM-IME isn't active.\n\nHowever, this is risky change.  Therefore, the new behavior is disabled in default settings.  On the other hand, we need the new behavior only when MS-IME for Japanese is active on Win10.  Therefore, this patch adds a pref to enable/disable the hack and make it true in the default settings.\n\nMozReview-Commit-ID: KAVxVT9CrsW", "files": ["modules/libpref/init/all.js", "widget/windows/IMMHandler.cpp", "widget/windows/IMMHandler.h", "widget/windows/TSFTextStore.cpp", "widget/windows/TSFTextStore.h", "widget/windows/WinIMEHandler.cpp", "widget/windows/WinIMEHandler.h"], "git_node": null, "git_parents": [null], "node": "f68e0d98a22a4712a3710998081fd0ea5cd00ccb", "parents": ["a108d15a3a9ce25b83dac94e01bac95ff6d6e65b"], "tags": ["FIREFOX_52_2_0esr_BUILD1", "FIREFOX_52_2_0esr_RELEASE"]}], "date": 1496864246, "git_changesets": [null], "user": "ryanvm@gmail.com"}}
}";