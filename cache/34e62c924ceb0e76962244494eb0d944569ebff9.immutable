ode": null, "git_parents": [null], "node": "1054e9eaa03f6bb35e46956c83e419ae40c649ec", "parents": ["a7d1d3c1621c7795db1c7a0b98cffc75cf61af80"], "tags": []}], "date": 1494860787, "git_changesets": [null, null], "user": "ffxbld"}, "7095": {"changesets": [{"author": "Jesse Ruderman \u003cjruderman@gmail.com\u003e", "branch": "default", "desc": "Bug 779426 - Crashtest. r=mats, a=test-only\n\nMozReview-Commit-ID: H7FMSmfgTfS", "files": ["dom/canvas/crashtests/779426.html", "dom/canvas/crashtests/crashtests.list"], "git_node": null, "git_parents": [null], "node": "dea90d232813befee3c736800ad140e3b5cdaf9e", "parents": ["1054e9eaa03f6bb35e46956c83e419ae40c649ec"], "tags": []}, {"author": "Markus Stange \u003cmstange@themasta.com\u003e", "branch": "default", "desc": "Bug 1355340 - Don't attempt to accumulate line scrolls for line scroll events. r=masayuki, a=ritu\n\nMozReview-Commit-ID: 6xvqJBVupYo", "files": ["widget/cocoa/nsChildView.mm"], "git_node": null, "git_parents": [null], "node": "6b174b41fa44963901d4f09597bd97f60e8e9076", "parents": ["dea90d232813befee3c736800ad140e3b5cdaf9e"], "tags": []}], "date": 1494900905, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7096": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-388 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "5827f42b5caf6afa9762b7ebaf1f9ced3ae57bbd", "parents": ["6b174b41fa44963901d4f09597bd97f60e8e9076"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-388 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "60e8db683b8b5ef29e5d37d54c9f3de87566d2c9", "parents": ["5827f42b5caf6afa9762b7ebaf1f9ced3ae57bbd"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated blocklist update from host bld-linux64-spot-388 - a=blocklist-update", "files": ["browser/app/blocklist.xml"], "git_node": null, "git_parents": [null], "node": "3e251a9e60d2c624821399a37ac21020e2aef4fa", "parents": ["60e8db683b8b5ef29e5d37d54c9f3de87566d2c9"], "tags": []}], "date": 1494947327, "git_changesets": [null, null, null], "user": "ffxbld"}, "7097": {"changesets": [{"author": "Nicholas Hurley \u003churley@mozilla.com\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Bug 1360574 - Backout original fix to bug 1346392. r=mcmanus, a=lizzard\n\nMozReview-Commit-ID: 1ljoiCXciRq", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/protocol/http/nsHttpChannelAuthProvider.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/protocol/http/nsIHttpAuthenticableChannel.idl"], "git_node": null, "git_parents": [null], "node": "237eee78061977630b19a9e55fdb773cd07c6cd0", "parents": ["74be4466e450b5ba29223b949f05faffc0861666"], "tags": []}, {"author": "Nicholas Hurley \u003churley@mozilla.com\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Bug 1360574 - Detect & handle connection auth at the http/2 layer. r=mcmanus, a=lizzard\n\nThis is also the non-broken way to fix bug 1346392. Instead of waiting\nuntil the auth handler gets its hands on things, we break layering a bit\nand inspect the response headers as soon as we decompress them to see if\nthere's any connection-oriented auth being requested. If there is, we\ntreat the situation as if we got a RST_STREAM or GOAWAY with\nHTTP_1_1_REQUIRED.\n\nWe were able to re-purpose the NS_ERROR_ABORT code path that was\npreviously used with an inappropriate HTTP status code when talking to\nan HTTPS proxy over http/2, as that usage was removed a while back from\nthe stream, though we still had the (dead) code in the session to handle\nthe stream giving us that return value. The error code was changed to\nNS_ERROR_NET_RESET, however, to give a better description of what's\ngoing on.\n\nMozReview-Commit-ID: DLjOIIiXGrV", "files": ["netwerk/protocol/http/Http2Compression.cpp", "netwerk/protocol/http/Http2Session.cpp"], "git_node": null, "git_parents": [null], "node": "46a5a4aac18941ca36b6ce819e3e5fe9ed033224", "parents": ["237eee78061977630b19a9e55fdb773cd07c6cd0"], "tags": []}], "date": 1494970203, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7098": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "ee08e92167ba8589958fa3037f22f1afdf1b201f", "parents": ["46a5a4aac18941ca36b6ce819e3e5fe9ed033224"], "tags": []}], "date": 1494970363, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7099": {"changesets": [{"author": "Nicholas Hurley \u003churley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1360574 - Backout original fix to bug 1346392. r=mcmanus, a=lizzard\n\nMozReview-Commit-ID: 1ljoiCXciRq", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpChannel.h", "netwerk/protocol/http/nsHttpChannelAuthProvider.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/protocol/http/nsIHttpAuthenticableChannel.idl"], "git_node": null, "git_parents": [null], "node": "58b2b803775ef7b29999cbf79cc91ad7fbf116d3", "parents": ["3e251a9e60d2c624821399a37ac21020e2aef4fa"], "tags": []}, {"author": "Nicholas Hurley \u003churley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1360574 - Detect & handle connection auth at the http/2 layer. r=mcmanus, a=lizzard\n\nThis is also the non-broken way to fix bug 1346392. Instead of waiting\nuntil the auth handler gets its hands on things, we break layering a bit\nand inspect the response headers as soon as we decompress them to see if\nthere's any connection-oriented auth being requested. If there is, we\ntreat the situation as if we got a RST_STREAM or GOAWAY with\nHTTP_1_1_REQUIRED.\n\nWe were able to re-purpose the NS_ERROR_ABORT code path that was\npreviously used with an inappropriate HTTP status code when talking to\nan HTTPS proxy over http/2, as that usage was removed a while back from\nthe stream, though we still had the (dead) code in the session to handle\nthe stream giving us that return value. The error code was changed to\nNS_ERROR_NET_RESET, however, to give a better description of what's\ngoing on.\n\nMozReview-Commit-ID: DLjOIIiXGrV", "files": ["netwerk/protocol/http/Http2Compression.cpp", "netwerk/protocol/http/Http2Session.cpp"], "git_node": null, "git_parents": [null], "node": "f79eecc1f81b86369e381ba0fad5e1b1b8b9e921", "parents": ["58b2b803775ef7b29999cbf79cc91ad7fbf116d3"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1358776 - Fix building of SkBitmapProcState on ARM NEON. r=jrmuizel, a=ritu", "files": ["gfx/skia/skia/src/core/SkBitmapProcState.cpp", "gfx/skia/skia/src/core/SkBitmapProcState_matrixProcs.cpp"], "git_node": null, "git_parents": [null], "node": "bd35fa23f79aa690978525fd63d461a6e2b23a6c", "parents": ["f79eecc1f81b86369e381ba0fad5e1b1b8b9e921"], "tags": []}, {"author": "Shu-yu Guo \u003cshu@rfrn.org\u003e", "branch": "default", "desc": "Bug 1362590 - Always give global scripts an extra frame slot in JIT code for compiling INITGLEXICAL. r=jandem, a=gchang", "files": ["js/src/jit/BaselineFrameInfo.cpp", "js/src/jit/CompileInfo.h", "js/src/jit/JitFrames.h"], "git_node": null, "git_parents": [null], "node": "c1314a709b41cae538ec5e443b6d9bf56aec4ea6", "parents": ["bd35fa23f79aa690978525fd63d461a6e2b23a6c"], "tags": []}], "date": 1494978238, "git_changesets": [null, null, null, null], "