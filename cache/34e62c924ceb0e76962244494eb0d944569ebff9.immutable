X_ESR_52_1_X_RELBRANCH", "desc": "Bug 1328762 - Cherry-pick ANGLE a4aaa2de57dc51243da35ea147d289a21a9f0c49. a=lizzard\n\nMozReview-Commit-ID: WVK0smAfAW", "files": ["gfx/angle/src/libANGLE/renderer/d3d/d3d11/Buffer11.cpp", "gfx/angle/src/libANGLE/renderer/d3d/d3d11/Buffer11.h"], "git_node": null, "git_parents": [null], "node": "bd4fcdee9a06853cc5b6b6817161cf35f539510f", "parents": ["3ea0e075203185d7f2d42f439455e97735bd1b20"], "tags": []}], "date": 1493921651, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7070": {"changesets": [{"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "120111e65bc4e9b99da97e9d046765de95fbac8c", "parents": ["bd4fcdee9a06853cc5b6b6817161cf35f539510f"], "tags": ["FIREFOX_52_1_1esr_BUILD1", "FIREFOX_52_1_1esr_RELEASE"]}], "date": 1493921967, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7071": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1346499 - Don't remove Ctrl nor Alt modifier state at dispatching eKeyPress event when the modifier doesn't change inputting character. r=m_kato, a=ritu\n\nCtrl+Space causes WM_CHAR of ' '.  On the other native applications, you can input ' ' with this key combination though, we shouldn't allow this because we need to remove Ctrl and Alt modifier state at dispatching keypress event for the limitation of TextEditor but this is important key combination for custom shortcut keys.\n\nSo, when Ctrl or Alt key is pressed but it doesn't change the inputting character, i.e., the character can be inputted without Ctrl or Alt, we shouldn't remove those modifier state from eKeyPress event.\n\nMozReview-Commit-ID: 7omLvNdQWzW", "files": ["widget/tests/test_keycodes.xul", "widget/windows/KeyboardLayout.cpp", "widget/windows/KeyboardLayout.h"], "git_node": null, "git_parents": [null], "node": "747fd6c8198345d1b1c8fe763434ac8202f3407f", "parents": ["43d7b98d87438851169892f0391ae893c29cda24"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1334443 - Add gtest for nsProtocolProxyService::{LoadHostFilters,CanUseProxy} and fix IPv6 parsing. r=bagder, a=ritu\n\nWhile writing a gtest I discovered the parsing an IPv6 address didn't work due to the brackets.\n\nMozReview-Commit-ID: 9mmKS72hf7Y", "files": ["netwerk/base/nsProtocolProxyService.cpp", "netwerk/base/nsProtocolProxyService.h", "netwerk/test/gtest/TestProtocolProxyService.cpp", "netwerk/test/gtest/moz.build"], "git_node": null, "git_parents": [null], "node": "16201e8478dfcb69d878cc24fab38f4e2306fd31", "parents": ["747fd6c8198345d1b1c8fe763434ac8202f3407f"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1334443 - Rewrite nsProtocolProxyService::LoadHostFilters to use Tokenizer. r=bagder, a=ritu\n\nThis eliminates some of the pointer math and makes the method a bit safer.\nThe function's behaviour remains the same as before.\n\nMozReview-Commit-ID: 94wBk6xvkd6", "files": ["netwerk/base/nsProtocolProxyService.cpp", "netwerk/base/nsProtocolProxyService.h", "netwerk/test/gtest/TestProtocolProxyService.cpp"], "git_node": null, "git_parents": [null], "node": "f100e5cf3bcbb98457b53b81b9206450e4bcaf72", "parents": ["16201e8478dfcb69d878cc24fab38f4e2306fd31"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1347191 - Add support for NSIS 3.01 to moz.configure. r=mhowell, a=ritu", "files": ["moz.configure"], "git_node": null, "git_parents": [null], "node": "6797dac51b6ee9daa293cb39b8038dddd4c321e6", "parents": ["f100e5cf3bcbb98457b53b81b9206450e4bcaf72"], "tags": []}, {"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1351482 - Use NSIS 3.01 for buildbot jobs. r=mshal, a=ritu\n\nMozReview-Commit-ID: ElKlo6QwKmR", "files": ["testing/mozharness/configs/builds/releng_base_windows_32_builds.py", "testing/mozharness/configs/builds/releng_base_windows_64_builds.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_stat_and_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_debug.py", "testing/mozharness/configs/single_locale/win32.py", "testing/mozharness/configs/single_locale/win64.py"], "git_node": null, "git_parents": [null], "node": "d7b528e58ce2c955538fbc71dfad6b17092eefc4", "parents": ["6797dac51b6ee9daa293cb39b8038dddd4c321e6"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1354810 - CycleCollectedJSContext::Get() needs to be null-checked. r=baku, a=ritu", "files": ["dom/promise/Promise.cpp"], "git_node": null, "git_parents": [null], "node": "e579ef6e8d112aa21feaac0ddf612585108ed34c", "parents": ["d7b528e58ce2c955538fbc71dfad6b17092eefc4"], "tags": []}, {"author": "Ehsan Akhgari \u003cehsan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1356755 - Don't pass a null pointer to NotifyDocumentTree(). r=qdot, a=ritu", "files": ["dom/base/nsGlobalWindow.cpp"], "git_node": null, "git_parents": [null], "node": "4a3fce67b52d0f830edee2ab19087faa29c17484", "parents": ["e579ef6e8d112aa21feaac0ddf612585108ed34c"], "tags": []}, {"author": "Paolo Amadini \u003cpaolo.mozmail@amadzone.org\u003e", "branch": "default", "desc": "Bug 1273265 - Allow long file names in specific cases. r=jimm, a=ritu\n\nMozReview-Commit-ID: 3tl5Iihxs27", "files": ["toolkit/components/jsdownloads/src/DownloadIntegration.jsm", "toolkit/components/osfile/modules/osfile_win_back.jsm", "toolkit/components/osfile/modules/osfile_win_front.jsm"], "git_node": null, "git_parents": [null], "node": "7902fea300b8992fab50bba503eaf699d6164d0a", "parents": ["4a3fce67b52d0f830edee2ab19087faa29c17484"], "tags": []}, {"author": "Bobby Holley \u003cbobbyholley@gmail.com\u003e", "branch": "default", "desc": "Bug 1353204 - Use entire spec for origin for Thunderbird. r=bz, r=bholley, a=ritu", "files": ["caps/nsPrincipal.cpp"], "git_node": null, "git_parents": [null], "node": "b5a21502aeffb0b565ea38b6e8e83e9c22ec167e", "parents": ["7902fea300b8992fab50bba503eaf699d6164d0a"], "tags": []}, {"author": "Felipe Gomes \u003cfelipc@gmail.com\u003e", "branch": "default", "desc": "Bug 1348576 - e10s is never enabled for non-official release builds. r=mconley, a=ritu\n\nMozReview-Commit-ID: DaqGyeGdgzD", "files": ["browser/extensions/e10srollout/bootstrap.js", "browser/extensions/e10srollout/install.rdf.in"], "git_node": null, "git_parents": [null], "node": "6b7081a6d14967a1f56b1269f618de3735859803", "parents": ["b5a21502aeffb0b565ea38b6e8e83e9c22ec167e"], "tags": []}], "date": 1493945826, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7072": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-383 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "0d47b01c9348c22cb8ec450d0daaaa6c7f4c71a9", "parents": ["6b7081a6d14967a1f56b1269f618de3735859803"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-383 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "1458277df793fc5a0a0818eeaa4860598226ae86", "parents": ["0d47b01c9348c22cb8ec450d0daaaa6c7f4c71a9"], "tags": []}], "date": 1493996404, "git_changesets": [null, null], "user": "ffxbld"}, "7073": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "202a537ec701f2945a68aa9e03905632bbdeee90", "parents": ["1458277df793fc5a0a0818eeaa4860598226ae86"], "tags": []}, {"author": "ffxbld \u003crelease@mozilla.com\u003e", "branch": "default", "desc": "No bug - Tagging 120111e65bc4e9b99da97e9d046765de95fbac8c with FIREFOX_52_1_1esr_BUILD1, FIREFOX_52_1_1esr_RELEASE a=release CLOSED TREE", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "90d42fd9ff0f587dfa35abe2b28cf7a78b4a361c", "parents": ["202a537ec701f2945a68aa9e03905632bbdeee90"], "tags": []}], "date": 1494008513, "git_changesets": [null, null], "user": "asasaki@mozilla.com"}, "7074": {"changesets": [{"author": "Liang-Heng Chen \u003cxeonchen@gmail.com\u003e", "branch": "default", "desc": "Bug 1028195 - Make proxy bypass rule consistent. r=bagder, a=ritu\n\nMozReview-Commit-ID: CMAUt1p3L3u", "files": ["netwerk/base/nsProtocolProxyService.cpp", "toolkit/system/windowsproxy/nsWindowsSystemProxySettings.cpp"], "git_node": null, "git_parents": [null], "node": "69a5ca2bf867e4d3a201ae5a4d3818471b8821dc", "parents": ["90d42fd9ff0f587dfa35abe2b28cf7a78b4a361c"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1347835 - NativeKey should dispatch keypress events even if WM_KEYDOWN is processed by IME but followed by printable WM_(SYS)CHAR messages. r=m_kato, a=ritu\n\nSome IME may handle WM_KEYDOWN message before application and may set the keycode value to VK_PROCSSKEY but not do actually. Similarly, IME may handle WM_KEYDOWN message and replace following WM_CHAR messages with different characters.\nTherefore, even if WM_KEYDOWN message comes with VK_PROCESSKEY, NativeKey shouldn't stop dispatching keypress events if it detects following printable char messages.\n\nMozReview-Commit-ID: DcC2qgcLDrQ", "files": ["widget/tests/test_keycodes.xul", "widget/windows/KeyboardLayout.cpp"], "git_node": null, "git_parents": [null], "node": "bc635f45af3729f93518c2a06553796b07be2ced", "parents": ["69a5ca2bf867e4d3a201ae5a4d3818471b8821dc"], "tags": []}, {"author": "Nico Grunbaum", "branch": "default", "desc": "Bug 1241066 - Fix mozRtt always 0 or 1. r=jib, a=ritu\nMy shortest patch to date.\n\nMozReview-Commit-ID: 8r3ZrGUk40D", "files": ["media/webrtc/trunk/webrtc/modules/rtp_rtcp/source/rtcp_receiver.cc"], "git_node": null, "git_parents": [null], "node": "b922ca70cce5c3c1063520f2dec09aea17c3add5", "parents": ["bc635f45af3729f93518c2a06553796b07be2ced"], "tags": []}, {"author": "Till Schneidereit \u003ctill@tillschneidereit.net\u003e", "branch": "default", "desc": "Bug 1346012 - Handle dead object wrappers in more places in Promise code. r=shu, a=ritu\n\nMozReview-Commit-ID: HlmKwoMub9D", "files": ["js/src/builtin/Promise.cpp"], "git_node": null, "git_parents": [null], "node": "1ce6d0652921eff52db5054e4cfef238ca94955d", "parents": ["b922ca70cce5c3c1063520f2dec09aea17c3add5"], "tags": []}, {"author": "Till Schneidereit \u003ctill@tillschneidereit.net\u003e", "branch": "default", "desc": "Bug 1324140 - Unwrap given Promise in some JSAPI functions. r=bz, a=ritu\n\nTo make Promise-related JSAPI functions easier to use, this patch unwraps handed-in Promise objects automatically. Some functions don't unwrap, mostly debugging-related ones and, notably, JS::IsPromiseObject. The latter doesn't unwrap in order to stay conservative: if JSAPI-using code uses IsPromiseObject to verify that an object is a Promise, it should always be fine to say \"no\".\n\nMozReview-Commit-ID: 7DuCqCj95JR", "files": ["js/src/builtin/Promise.cpp", "js/src/builtin/Promise.h", "js/src/jsapi.cpp", "js/src/jsapi.h"], "git_node": null, "git_parents": [null], "node": "8886f9cd5dd3b6659f0f84095537e3643374467e", "parents": ["1ce6d0652921eff52db5054e4cfef238ca94955d"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1342552 - IMEStateManager should cache nsIWidget for sPresContext and use it. r=smaug, a=gchang\n\nIMEStateManager should cache nsIWidget for sPresContext at caching sPresContext.  Then, even if sPresContext has gone, IMEStateManager can clean up with the nsIWidget cache.\n\nUnfortunately, editor has some bugs about calling IMEStateManager::UpdateIMEState().  That is, calling it *before* IMEStateManager::OnChangeFocus().  In such case, this patch makes UpdateIMEState() ignore the call.", "files": ["dom/events/IMEStateManager.cpp", "dom/events/IMEStateManager.h", "editor/libeditor/EditorBase.cpp"], "git_node": null, "git_parents": [null], "node": "ad995e90916bd6abbde54ba1c5233c0523dd094c", "parents": ["8886f9cd5dd3b6659f0f84095537e3643374467e"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1355039 - Ensure the right url is used for reloading. r=bz, a=gchang", "files": ["docshell/base/nsDocShell.cpp"], "git_node": null, "git_parents": [null], "node": "4ae71415fecf32123ba4d039f6f8b94b90476c10", "parents": ["ad995e90916bd6abbde54ba1c5233c0523dd094c"], "tags": []}], "date": 1494032241, "git_changesets": [null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7075": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-385 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "7ab7cbcb392903200f2a012e29b5c1b3e1c7b28c", "parents": ["4ae71415fecf32123ba4d039f6f8b94b90476c10"], "tags": []}, {"au