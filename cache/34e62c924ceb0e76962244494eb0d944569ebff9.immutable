: [null], "node": "9ab9454a20c532c62b2ba3a6694f3158db9e2ceb", "parents": ["71fc70a0f832d101293defad66446459de3cb0c9"], "tags": []}], "date": 1495033837, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7102": {"changesets": [{"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "default", "desc": "Bug 1364225 - in-tree beetmover to take product in a generic way via configs. r=rail a=release DONTBUILD\n\nMozReview-Commit-ID: 23iQ4leB1Ob", "files": ["testing/mozharness/scripts/release/beet_mover.py"], "git_node": null, "git_parents": [null], "node": "bb14f704d641becf413e329f66a3c2e66493bdc9", "parents": ["9ab9454a20c532c62b2ba3a6694f3158db9e2ceb"], "tags": []}], "date": 1495046150, "git_changesets": [null], "user": "mtabara@mozilla.com"}, "7103": {"changesets": [{"author": "Dustin J. Mitchell \u003cdustin@mozilla.com\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Bug 1363893 - Remove downed scl3 proxxy instance. r=catlee, a=release\n\nMozReview-Commit-ID: DBvun6vwCGX", "files": ["testing/mozharness/mozharness/mozilla/proxxy.py"], "git_node": null, "git_parents": [null], "node": "aa411bd76227a7ca8d0732a363ea3b601b666641", "parents": ["ee08e92167ba8589958fa3037f22f1afdf1b201f"], "tags": []}, {"author": "Mihai Tabara \u003cmtabara@mozilla.com\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Bug 1364225 - in-tree beetmover to take product in a generic way via configs. r=rail a=release\n\nMozReview-Commit-ID: 23iQ4leB1Ob", "files": ["testing/mozharness/scripts/release/beet_mover.py"], "git_node": null, "git_parents": [null], "node": "0dc7c28f20648d597b11b60e90be9a15687656aa", "parents": ["aa411bd76227a7ca8d0732a363ea3b601b666641"], "tags": ["FIREFOX_52_1_2esr_BUILD1", "FIREFOX_52_1_2esr_RELEASE"]}], "date": 1495049041, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7104": {"changesets": [{"author": "Boris Zbarsky \u003cbzbarsky@mit.edu\u003e", "branch": "default", "desc": "Bug 1359859 -  Use the right entry global for XBL constructor/destructor/field execution. r=bholley, a=gchang\n\nThe test doesn't verify that the exceptions are reported to the browser console,\nbut I manually checked that they are.  Adding a test for that part could be\npretty annoying.", "files": ["dom/xbl/nsXBLProtoImplField.cpp", "dom/xbl/nsXBLProtoImplMethod.cpp", "dom/xbl/test/mochitest.ini", "dom/xbl/test/test_bug1098628_throw_from_construct.xhtml", "dom/xbl/test/test_bug1359859.xhtml"], "git_node": null, "git_parents": [null], "node": "e38948fb79d65120ab7f58363d04f179f896f254", "parents": ["bb14f704d641becf413e329f66a3c2e66493bdc9"], "tags": []}, {"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1300311 - Fuzz some reftests on WinXP. a=test-only", "files": ["layout/reftests/bugs/reftest.list", "layout/reftests/table-width/reftest.list", "layout/reftests/w3c-css/received/reftest.list"], "git_node": null, "git_parents": [null], "node": "5615a6f497cd8016546b5147fb31bd207ede0671", "parents": ["e38948fb79d65120ab7f58363d04f179f896f254"], "tags": []}], "date": 1495111782, "git_changesets": [null, null], "user": "ryanvm@gmail.com"}, "7105": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-363 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "927e94bc850697fb30426d68f327663fb458ca90", "parents": ["5615a6f497cd8016546b5147fb31bd207ede0671"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-363 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "8777a001a236ff80004a258339bd706474e682e6", "parents": ["927e94bc850697fb30426d68f327663fb458ca90"], "tags": []}], "date": 1495119539, "git_changesets": [null, null], "user": "ffxbld"}, "7106": {"changesets": [{"author": "Michael Layzell \u003cmichael@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1342057 - Part 1: Use correct MIME type for files as DataTransferItem.type. r=baku, a=jcristau\n\nMozReview-Commit-ID: 4hrZ3YoGTJj", "files": ["dom/events/DataTransfer.cpp", "dom/events/DataTransferItem.cpp", "dom/events/DataTransferItem.h", "dom/events/DataTransferItemList.cpp", "dom/events/test/test_DataTransferItemList.html"], "git_node": null, "git_parents": [null], "node": "278bef1d7a64fe9d3000308ccda1f9ba89643041", "parents": ["8777a001a236ff80004a258339bd706474e682e6"], "tags": []}, {"author": "Michael Layzell \u003cmichael@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1342057 - Part 2: Add a test that the MIME type is set correctly for image data. r=baku, a=jcristau\n\nUnfortunately drag and drop / clipboard data is not super easy to test\nwith our current testing infrastructure, so we can't do too much better\nthan this. Additional testing will have to be done manually through our\nQA process once this has landed.\n\nMozReview-Commit-ID: 1etmIxjjiBd", "files": ["dom/tests/mochitest/general/test_clipboard_events.html"], "git_node": null, "git_parents": [null], "node": "b6d5f7f945de48900052760c6e06ec5bd168d284", "parents": ["278bef1d7a64fe9d3000308ccda1f9ba89643041"], "tags": []}, {"author": "Nils Ohlmeier [:drno] \u003cdrno@ohlmeier.org\u003e", "branch": "default", "desc": "Bug 1325513 - Check RTP extension header length. r=jesup, a=jcristau\n\nMozReview-Commit-ID: 6sUVQjUh8bF", "files": ["media/webrtc/trunk/webrtc/modules/rtp_rtcp/source/rtp_utility.cc"], "git_node": null, "git_parents": [null], "node": "218e0963406f363e0d2d4b6366eb57a24215c115", "parents": ["b6d5f7f945de48900052760c6e06ec5bd168d284"], "tags": []}, {"author": "Ehsan Akhgari \u003cehsan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1304566 - Unregister from the obsever service in order to prevent re-entrancy. r=janv, a=jcristau", "files": ["dom/quota/ActorsParent.cpp"], "git_node": null, "git_parents": [null], "node": "188e39630fcd2b5eeb47aa4e45840bfb72e99898", "parents": ["218e0963406f363e0d2d4b6366eb57a24215c115"], "tags": []}, {"author": "Cameron McCormack \u003ccam@mcc.id.au\u003e", "branch": "default", "desc": "Bug 1356601 - Don't force computation of a Variables struct when animations are involved. r=dbaron, a=jcristau\n\nWithout this change, we can end up asserting in ComputeVariablesData and\ncrashing in CSSVariableResolver::Resolve due to not finding any variable\ndeclarations on the rules we matched, when we have content like in the\ncrashtest added here, i.e. variables inheriting into a pseudo like\n::first-line and animations on the element inside the ::first-line.\n\nWe could solve this alternatively by removing the assertion and making\nCSSVariableResolver::Resolve handle a null aDeclarations more gracefully,\nbut since we can save the effort of recomputing the Variables struct in\nthis case, we may as well.\n\nMozReview-Commit-ID: 6l06ZF3WGsy", "files": ["layout/style/crashtests/1356601-1.html", "layout/style/crashtests/crashtests.list", "layout/style/nsRuleNode.cpp"], "git_node": null, "git_parents": [null], "node": "8191e403fedf0227686b1ab14a4b2fc6372c8ee4", "parents": ["188e39630fcd2b5eeb47aa4e45840bfb72e99898"], "tags": []}, {"author": "Bill McCloskey \u003cwmccloskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 1334097 - Avoid busy waiting caused by MaybeUndeferIncall. r=aklotz, a=jcristau\n\nIn order to avoid a busy wait where we defer and then immediately un-defer a message,\nwe need to ensure that we only un-defer a message if it's actually ready to be processed.\nThis patch uses the same condition in MaybeUndeferIncall as we use in\nDispatchInterruptMessage.", "files": ["ipc/glue/MessageChannel.cpp", "ipc/glue/MessageChannel.h"], "git_node": null, "git_parents": [null], "node": "fe2a2c7e88cb59f4792ca08f86dccea6508e8730", "parents": ["8191e403fedf0227686b1ab14a4b2fc6372c8ee4"], "tags": []}, {"author": "Sean Stangl \u003csstangl@mozilla.com\u003e", "branch": "default", "desc": "Bug 1359051 - Define cacheFlush for non-Simulator ARM64 builds. r=tcampbell, a=jcristau", "files": ["js/src/jit/ExecutableAllocator.h"], "git_node": null, "git_parents": [null], "node": "8d7dbe5c6587414776d71cced925d25943a8d5a5", "parents": ["fe2a2c7e88cb59f4792ca08f86dccea6508e8730"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1359697 - Make CaptivePortalService not poll for status when it is in the NOT_CAPTIVE state. r=mcmanus, a=jcristau\n\nMozReview-Commit-ID: BrxJfipydEj", "files": ["netwerk/base/CaptivePortalService.cpp"], "git_node": null, "git_parents": [null], "node": "ca2b5274549fef6d417590a4252eaab1c55a73ab", "parents": ["8d7dbe5c6587414776d71cced925d25943a8d5a5"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 1343256 - Bookmark keywords disappear from one bookmark when adding a keyword to another bookmark. r=standard8, a=jcristau\n\nMozReview-Commit-ID: Av8pDQi6Yyp", "files": ["browser/components/places/content/editBookmarkOverlay.js", "browser/components/places/tests/chrome/chrome.ini", "browser/components/places/tests/chrome/test_editBookmarkOverlay_keywords.xul", "toolkit/components/places/Bookmarks.jsm"], "git_node": null, "git_parents": [null], "node": "a30dd7dd6617eff55b874ca2eb7a3820ca40158d", "parents": ["ca2b5274549fef6d417590a4252eaab1c55a73ab"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1349310 - Update graphite2 to release 1.3.10. r=milan, a=jcristau", "files": ["gfx/graphite2/README.mozilla", "gfx/graphite2/include/graphite2/Font.h", "gfx/graphite2/src/CMakeLists.txt", "gfx/graphite2/src/Collider.cpp", "gfx/graphite2/src/Decompressor.cpp", "gfx/graphite2/src/Face.cpp", "gfx/graphite2/src/FeatureMap.cpp", "gfx/graphite2/src/GlyphCache.cpp", "gfx/graphite2/src/Intervals.cpp", "gfx/graphite2/src/Pass.cpp", "gfx/graphite2/src/Segment.cpp", "gfx/graphite2/src/Silf.cpp", "gfx/graphite2/src/inc/Collider.h", "gfx/graphite2/src/inc/Pass.h", "gfx/graphite2/src/inc/UtfCodec.h", "gfx/graphite2/src/inc/locale2lcid.h"], "git_node": null, "git_parents": [null], "node": "81b3ce7d37b31a2d03334cac10d2065eecfea401", "parents": ["a30dd7dd6617eff55b874ca2eb7a3820ca40158d"], "tags": []}, {"author": "cku \u003ccku@mozilla.com\u003e", "branch": "default", "desc": "Bug 1356179 - Part 1: Roundout clip region to make sure we have enough space for mask/clip-path painting. r=mstange, a=jcristau\n\nMozReview-Commit-ID: 6hfOiCDq7ni", "files": ["layout/base/nsDisplayList.cpp"], "git_node": null, "git_parents": [null], "node": "66d8893f37f090dcafd1ab86188896ad0a524304", "parents": ["81b3ce7d37b31a2d03334cac10d2065eecfea401"], "tags": []}, {"author": "cku \u003ccku@mozilla.com\u003e", "branch": "default", "desc": "Bug 1356179 - Part 2: Reftest for applying clip-path onto thin objects. r=mstange, a=jcristau\n\nMozReview-Commit-ID: 7CDyDYtLWsN", "files": ["layout/reftests/svg/clipPath-on-thin-object.svg", "layout/reftests/svg/reftest.list"], "git_node": null, "git_parents": [null], "node": "f80a49c81a40d923cb2c617cacba1c4e37d33fe4", "parents": ["66d8893f37f090dcafd1ab86188896ad0a524304"], "tags": []}], "date": 1495131209, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "7107": {"changesets": [{"author": "Ryan VanderMeulen \u003cryanvm@gmail.com\u003e", "branch": "default", "desc": "Bug 1334097 - Remove unused variable. r=billm, a=bustage", "files": ["ipc/glue/MessageChannel.cpp"], "git_node": null, "git_parents": [null], "node": "2f30955c1dca3c1664668c09624346c582b9a1a6", "parents": ["f80a49c81a40d923cb2c617cacba1c4e37d33fe4"], "tags": []}], "date": 1495132885, "git_changesets": [null], "user": "ryanvm@gmail.com"}, "7108": {"changesets": [{"author": "Matt Howell \u003cmhowell@mozilla.com\u003e", "branch": "default", "desc": "Bug 1361326 - Delay-load DLL's used by the 7-zip self-extractor. r=rstrong a=jcristau\n\nMozReview-Commit-ID: 7O0NJBVxaLQ", "files": ["other-licenses/7zstub/firefox/7zSD.sfx", "other-licenses/7zstub/src/7zip/Bundles/SFXSetup-moz/Main.cpp", "other-licenses/7zstub/src/7zip/Bundles/SFXSetup-moz/SFXSetup-moz.dsp"], "git_node": null, "git_parents": [null], "node": "ccbfecefae5a891c579f24d68dd07bc06e3ecde4", "parents": ["2f30955c1dca3c1664668c09624346c582b9a1a6"], "tags": []}], "date": 1495205765, "git_changesets": [null], "user": "mhowell@mozilla.com"}, "7109": {"changesets": [{"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HSTS preload list update from host bld-linux64-spot-305 - a=hsts-update", "files": ["security/manager/ssl/nsSTSPreloadList.errors", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": null, "git_parents": [null], "node": "1418384fba3c96012b4d6e3fbc352e7ab3a5bac2", "parents": ["ccbfecefae5a891c579f24d68dd07bc06e3ecde4"], "tags": []}, {"author": "ffxbld", "branch": "default", "desc": "No bug, Automated HPKP preload list update from host bld-linux64-spot-305 - a=hpkp-update", "files": ["security/manager/ssl/StaticHPKPins.h"], "git_node": null, "git_parents": [null], "node": "f4e5281878f54a22adce586333696daaeaa70835", "parents": ["1418384fba3c96012b4d6e3fbc352e7ab3a5bac2"], "tags": []}], "date": 1495208080, "git_changesets": [null, null], "user": "ffxbld"}, "7110": {"changesets": [{"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Bug 1355009 - Force update tests to only allow a single update. r=ato, a=test-only\n\nThere was never a need to run a multiple-update step in the past, and as\nwe agreed a while ago it is not something we want to do in the future.\nIt means that watershed releases will have to be tested by issuing\nmultiple update tests.\n\nMozReview-Commit-ID: 7cmK3gEOkv1", "files": ["testing/firefox-ui/harness/firefox_ui_harness/testcases.py"], "git_node": null, "git_parents": [null], "node": "435587252b446740ad99f196b3e77a34680b986f", "parents": ["0dc7c28f20648d597b11b60e90be9a15687656aa"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Bug 1355009 - Harden update tests with better error messages. r=ato, a=test-only\n\nTo ensure better failure messages a refactoring of checks has to be done. It\nincludes the following changes:\n\n* No further checks for a follow-up (watershed) update. It's not supported\nand as such doesn't need assertions (bug 1353717)\n\n* Checks for fallback updates have to be made to ensure that an invalidated\npartial/complete update does not cause an upgrade of Firefox during the restart.\n\nMozReview-Commit-ID: CLb0aXoIur2", "files": ["testing/firefox-ui/harness/firefox_ui_harness/testcases.py"], "git_node": null, "git_parents": [null], "node": "2c4ff51c0f7a894f12f2a224aef49ee8b41168d2", "parents": ["435587252b446740ad99f196b3e77a34680b986f"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "FIREFOX_ESR_52_1_X_RELBRANCH", "desc": "Bug 1355009 - Temporarily disable usage of simplified update ui. r=ato, a=test-only DONTBUILD\n\nAs long as update tests do not support the new simplified update ui\nit has to be kept disabled.\n\nMozReview-Commit-ID: 4fC0CYhp7Pc", "files": ["testing/firefox-ui/harness/firefox_ui_harness/runners/update.py"], "git_node": null, "git_parents": [null], "node": "6fa5a7b42bc5931ebaa50f80d25ef564a4c6bde9", "parents": ["2c4ff51c0f7a894f12f2a224aef49ee8b41168d2"], "tags": []}], "date": 1495213694, "git_changesets": [null, null, null], "user": "ryanvm@gmail.com"}, "7111": {"changesets": [{"author": "Aki Sasaki \u003casasaki@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump. CLOSED TREE NO BUG a=release", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "