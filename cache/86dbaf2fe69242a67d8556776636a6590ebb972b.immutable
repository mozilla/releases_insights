4a"], "node": "4bbe06912c69351aeec4888c99a7e2b000bdb066", "parents": ["80e121566dc8afecca0c2cb6532dc693c84c4dec"], "tags": []}], "date": 1787413966, "git_changesets": ["c8797d9a1967f3e72260d3e47a4b09d80a9d0c79"], "user": "rvandermeulen@mozilla.com"}, "1602": {"changesets": [{"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061287 - Improve MFMediaEngineParent lifetime handling  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318611\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320620\n", "files": ["dom/media/ipc/MFMediaEngineParent.cpp", "dom/media/ipc/MFMediaEngineParent.h"], "git_node": "ca615dbdaea5b4f8b04943daea21c18aaf1029bb", "git_parents": ["c8797d9a1967f3e72260d3e47a4b09d80a9d0c79"], "node": "2e3dbf70e7ff6cfb0dab2e66df3781d82b3c4df0", "parents": ["4bbe06912c69351aeec4888c99a7e2b000bdb066"], "tags": []}], "date": 1787413987, "git_changesets": ["ca615dbdaea5b4f8b04943daea21c18aaf1029bb"], "user": "rvandermeulen@mozilla.com"}, "1603": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054645 - Restrict DMABuf import to hardware GL rendering.  a=RyanVM DONTBUILD\n\nDMABuf surfaces are only used with hardware GL rendering. Do not import\na DMABuf surface into a GL texture when software rendering is in use.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313682\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320661\n", "files": ["widget/gtk/DMABufSurface.cpp"], "git_node": "0a348b33874ba9e3b91e2f50f7fefac9b1a0b7de", "git_parents": ["ca615dbdaea5b4f8b04943daea21c18aaf1029bb"], "node": "0dedfb7f9ee56c5ca1f318d0c0e9036b8b7f210f", "parents": ["2e3dbf70e7ff6cfb0dab2e66df3781d82b3c4df0"], "tags": []}], "date": 1787414010, "git_changesets": ["0a348b33874ba9e3b91e2f50f7fefac9b1a0b7de"], "user": "rvandermeulen@mozilla.com"}, "1604": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061300 - Make ProxyObject::renew work when called on dying objects (ESR)  a=RyanVM\n\nThis is similar to other places where we call setMayHavePointersToDeadCells().\nWe may end up remapping dying proxy objects so if we insert a storebuffer entry\nwe need to set this flag so we'll empty the nursery before we sweep the object.\n\nThe original testcase doesn't reproduce on this version due to differences in\nthe shell testing functions and has been removed from the patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320435\n", "files": ["js/src/proxy/Proxy.cpp"], "git_node": "b929e8619c3430fc479e3270759e4c8df2890deb", "git_parents": ["0a348b33874ba9e3b91e2f50f7fefac9b1a0b7de"], "node": "731aa7a93cac94e378ac7f0799d9f5fdb291ad63", "parents": ["0dedfb7f9ee56c5ca1f318d0c0e9036b8b7f210f"], "tags": []}], "date": 1787414032, "git_changesets": ["b929e8619c3430fc479e3270759e4c8df2890deb"], "user": "rvandermeulen@mozilla.com"}, "1605": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059018 - Use mozilla::UniquePtr with getter_Transfers on ESR140. a=bustage\n", "files": ["xpcom/io/nsBinaryStream.cpp"], "git_node": "e2d39f870e6ed415709b2f37c4b4f4e2eadc7592", "git_parents": ["b929e8619c3430fc479e3270759e4c8df2890deb"], "node": "5359b7f54d3e097742d164e0633d93401840cd89", "parents": ["731aa7a93cac94e378ac7f0799d9f5fdb291ad63"], "tags": []}], "date": 1787417693, "git_changesets": ["e2d39f870e6ed415709b2f37c4b4f4e2eadc7592"], "user": "rvandermeulen@mozilla.com"}, "1606": {"changesets": [{"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 2064648 - Don't apply the file:// URI allowlist to worker process selection.  a=RyanVM\n\nIsolationBehaviorForURI() maps any origin in the file:// URI allowlist to\nIsolationBehavior::File so that a document which is permitted to link to local\nfiles renders in the file content process, in case it uses file:// sub-resources.\nThat allowlist is built from the capability.policy.* prefs which the\nLocalFileLinks enterprise policy writes, which intranet deployments use so that\nan internal portal (typically SharePoint) may link to files on a network share.\n\nThe rule was never meant to apply to workers. Before worker process selection\nmoved to ProcessIsolation in bug 1850589, E10SUtils.validatedWebRemoteType()\nguarded the equivalent check with !aIsWorker. Losing that guard was silent until\nbug 2050536 added ValidateBehaviorForWorker(), whose File case requires the\ncurrent remote type to be the file remote type. ServiceWorkerPrivate::Initialize()\nruns in the parent but passes the shared \"web\" remote type, so it now fails, and\nin release builds MOZ_ALWAYS_SUCCEEDS() lets construction continue with a\ndefault-constructed mRemoteWorkerData that crashes on the first intercepted fetch.\n\nThread an aIsWorker argument through IsolationBehaviorForURI() and skip the\nallowlist lookup for workers, restoring the pre-bug-1850589 behavior of selecting\nan ordinary web remote type. Genuine file: principals are unaffected; they are\nmatched earlier by scheme, which the new test also covers. Documents are\nunaffected as well, as browser_new_file_whitelisted_http_tab.js continues to\nverify.\n\nUplift changes for esr140: The changes from bug 2011326 are not on esr140 and\nnot need to be and so this patch is missing the calls to IsolationBehaviorForURI\nfrom PredictRemoteTypeForURI since that method does not exist on esr140.  The\ntest was build and confirmed to work and the necessity of the patch was also\nconfirmed.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320314\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320702\n", "files": ["dom/ipc/ProcessIsolation.cpp", "dom/ipc/gtest/ProcessIsolationTest.cpp"], "git_node": "ae2357d9543c8ebdbf64957b6244635efc0d5950", "git_parents": ["e2d39f870e6ed415709b2f37c4b4f4e2eadc7592"], "node": "0e214ce021d18409e9fa0d91409d17293c53629f", "parents": ["5359b7f54d3e097742d164e0633d93401840cd89"], "tags": []}, {"author": "Andrew Sutherland \u003casutherland@asutherland.org\u003e", "branch": "default", "desc": "Bug 2064648 - Neutralize a ServiceWorkerPrivate whose Initialize() failed.  a=RyanVM\n\nInitialize() is called only from the constructor and has no retry, but in\nrelease builds MOZ_ALWAYS_SUCCEEDS() does not stop construction. A\nServiceWorkerPrivate therefore survives a failed Initialize() with a\ndefault-constructed mRemoteWorkerData whose OptionalServiceWorkerData union is\nstill T__None, and RefreshRemoteWorkerData() then fatally asserts in\nget_ServiceWorkerData() the first time the worker is asked to spawn.\n\nClear mInfo on any early return from Initialize(). That is the same state\nNoteDeadServiceWorkerInfo() already establishes, so the existing guards do the\nwork: SpawnWorkerIfNeeded() bails before touching mRemoteWorkerData, and since\nExecServiceWorkerOp() and SendFetchEventInternal() both go through it, every\noperation now fails cleanly. A failed fetch interception resets the interception\nand the request goes to the network, so the site loads without its service\nworker rather than taking down the parent process.\n\nSendPushEvent() and SendCookieChangeEvent() are the only entry points which\ndereference mInfo before delegating to SpawnWorkerIfNeeded(), so give them the\nsame null check SendFetchEvent() already has. Everything else which asserts\nmInfo requires a spawned worker or mControllerChild and so is unreachable.\n\nThe MOZ_DIAGNOSTIC_ASSERT in the constructor is deliberately kept, so an\nunexpected Initialize() failure remains loud on Nightly and Dev Edition.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D320315\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320703\n", "files": ["dom/serviceworkers/ServiceWorkerPrivate.cpp"], "git_node": "7804a8cf0807de3935448a6bf677d726295d2060", "git_parents": ["ae2357d9543c8ebdbf64957b6244635efc0d5950"], "node": "d828bd907dc28f5e4529d3fd5d5b8881081d2417", "parents": ["0e214ce021d18409e9fa0d91409d17293c53629f"], "tags": []}], "date": 1787430256, "git_changesets": ["ae2357d9543c8ebdbf64957b6244635efc0d5950", "7804a8cf0807de3935448a6bf677d726295d2060"], "user": "rvandermeulen@mozilla.com"}, "1607": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058660 - Forward WebTransport stream events to the retargeted thread.  a=RyanVM DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320727\n", "files": ["netwerk/protocol/webtransport/WebTransportSessionProxy.cpp"], "git_node": "39b7cf92088ee7f489789596916256f9f6e3c7b5", "git_parents": ["7804a8cf0807de3935448a6bf677d726295d2060"], "node": "81b1efa2a2ece091125384fd5217b6a7380e3f56", "parents": ["d828bd907dc28f5e4529d3fd5d5b8881081d2417"], "tags": []}], "date": 1787517068, "git_changesets": ["39b7cf92088ee7f489789596916256f9f6e3c7b5"], "user": "rvandermeulen@mozilla.com"}, "1608": {"changesets": [{"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061397 - Tear down WebSocketChannelChild on the main thread,  a=RyanVM\n\nUse the same approach HttpChannelChild::Release() uses: dispatch off-main-thread\nreleases through the main thread with DecrementWithLimit\u003c2\u003e, so the count==1\nSendDeleteSelf and count==0 delete only run on the main thread where the IPDL\nreference is also released.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319530\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320724\n", "files": ["netwerk/protocol/websocket/WebSocketChannelChild.cpp"], "git_node": "81905a96f6847cebbe401c78eefa1aea935d35c3", "git_parents": ["39b7cf92088ee7f489789596916256f9f6e3c7b5"], "node": "45454adf769d6ad904f1b192e2196f3f5be4c478", "parents": ["81b1efa2a2ece091125384