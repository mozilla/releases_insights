4908eb099a1931c", "59ea4a5c7538b88878e3e47cd9e4db83793e9693"], "user": "ffxbld@lando.moz.tools"}, "1557": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "Automatic version bump NO BUG a=release CLOSED TREE\n", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": "b7f2e6a92f24d0a19a05938d45c531eb86498681", "git_parents": ["cabc34dc1ad1a4593995b76303e97f659c46e3d3"], "node": "108ee8b706b9c44ba1b508318eba4756735ff268", "parents": ["ee9f2b2aedc3c58347d66ca8d7b9f92ef1df3f53"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Update configs after merge day operations a=release\n\nIGNORE BROKEN CHANGESETS\nCLOSED TREE\n", "files": ["CLOBBER"], "git_node": "b123a701f2b9cff9b80f0e479947038da525ef64", "git_parents": ["b7f2e6a92f24d0a19a05938d45c531eb86498681"], "node": "81e96526be79a1a0cdedadf47c109c187e7b06ce", "parents": ["108ee8b706b9c44ba1b508318eba4756735ff268"], "tags": []}], "date": 1786630680, "git_changesets": ["b7f2e6a92f24d0a19a05938d45c531eb86498681", "b123a701f2b9cff9b80f0e479947038da525ef64"], "user": "ffxbld@lando.moz.tools"}, "1558": {"changesets": [{"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052502 - Fix out-of-bounds read in LinuxGamepad by sizing key_map/abs_map with KEY_CNT/ABS_CNT (Coverity CID 1585304)  a=RyanVM DONTBUILD\n\nkey_map/abs_map were sized [KEY_MAX]/[ABS_MAX], but evdev admits EV_KEY codes up to KEY_MAX inclusive, so event.code == KEY_MAX read one past the end. Size the arrays and population loops with KEY_CNT/ABS_CNT (matching keyBits/absBits), and bound the untrusted event.code before indexing key_map.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D310336\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318480\n", "files": ["dom/gamepad/linux/LinuxGamepad.cpp"], "git_node": "2ce7419b3f2d864c4ae9fce42d5e8f28f46ead38", "git_parents": ["b123a701f2b9cff9b80f0e479947038da525ef64"], "node": "f7ee3ff0d5510613f44b50f2f3fb6fc28a39fe91", "parents": ["81e96526be79a1a0cdedadf47c109c187e7b06ce"], "tags": []}], "date": 1786675055, "git_changesets": ["2ce7419b3f2d864c4ae9fce42d5e8f28f46ead38"], "user": "rvandermeulen@mozilla.com"}, "1559": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057107: Ensure that DirectManipulation handler is valid when it is enabled on Windows  a=RyanVM DONTBUILD\n\nDisable it _before_ releasing the objects that it needs to function correctly.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313870\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317689\n", "files": ["widget/windows/DirectManipulationOwner.cpp", "widget/windows/DirectManipulationOwner.h"], "git_node": "befb0d82da6390ba55f47795cd2f130a5f94b042", "git_parents": ["2ce7419b3f2d864c4ae9fce42d5e8f28f46ead38"], "node": "dbe066618ce63d19e0eee9750331c9c843348f6f", "parents": ["f7ee3ff0d5510613f44b50f2f3fb6fc28a39fe91"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057108: Cleanup DirectManipulation initialization failure on Windows  a=RyanVM DONTBUILD\n\nEnsures we properly tear down services on failure.  Also promotes\nNS_ENSURE_HRESULT[_VOID] to WinUtils.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D313871\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317690\n", "files": ["browser/components/shell/nsWindowsShellService.cpp", "widget/windows/DirectManipulationOwner.cpp", "widget/windows/WinUtils.h"], "git_node": "ed02424296d311aca1d48eb6962ea85c2d658aeb", "git_parents": ["befb0d82da6390ba55f47795cd2f130a5f94b042"], "node": "dc9cf229a14c3456e490d11e25d13fcb2618c999", "parents": ["dbe066618ce63d19e0eee9750331c9c84