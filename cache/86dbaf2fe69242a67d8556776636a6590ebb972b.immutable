ntextMenu/file_blocked_image_protocols.html", "netwerk/ipc/NeckoParent.cpp", "netwerk/protocol/res/PageThumbProtocolHandler.cpp", "netwerk/protocol/res/PageThumbProtocolHandler.h", "toolkit/components/places/nsCachedFaviconProtocolHandler.cpp"], "git_node": "8990f16dd20a84d3abbc6c17143c1ba18366f39b", "git_parents": ["78c9e1b5c7348b15047b5854e7a094ea939093c0"], "node": "089440f2ad7891faacc7427e1d55eb157d74365f", "parents": ["79c750460c417d487284e9687847c0e5b7ab5433"], "tags": []}], "date": 1786819627, "git_changesets": ["7d86580d488631252300850f37612227b239f17e", "78c9e1b5c7348b15047b5854e7a094ea939093c0", "8990f16dd20a84d3abbc6c17143c1ba18366f39b"], "user": "rvandermeulen@mozilla.com"}, "1571": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 1: Add threadsafe CurrentRemoteType getter,  a=RyanVM\n\nThis can be helpful within content processes to perform additional validation\nbefore sending IPC messages which would be rejected by principal validation.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302406\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318145\n", "files": ["dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h"], "git_node": "a21ea27f6d8ee40e1c100458b7138032a0b58996", "git_parents": ["8990f16dd20a84d3abbc6c17143c1ba18366f39b"], "node": "b4708bf2c5d06313933aab53eb63add72ffffc16", "parents": ["089440f2ad7891faacc7427e1d55eb157d74365f"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 2: Add more principal validation to PBackground,  a=RyanVM\n\nThis adds principal validation calls in the places where there are visible\nPrincipalInfo instances within PBackground, as well as adding\nPrincipalValidation helpers to BackgroundParent.h.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302407\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318146\n", "files": ["ipc/glue/BackgroundImpl.cpp", "ipc/glue/BackgroundParent.h", "ipc/glue/BackgroundParentImpl.cpp"], "git_node": "b8a3704b406f96b6763944bfee88408ad2a4b134", "git_parents": ["a21ea27f6d8ee40e1c100458b7138032a0b58996"], "node": "c794b063cbf6bc9b393258b1851b640703fa7b75", "parents": ["b4708bf2c5d06313933aab53eb63add72ffffc16"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 3: Check ValidatePrincipal in child,  a=RyanVM\n\nThis adds redundant checks into the content process for the ValidatePrincipal\nchecks added in the parent process in earlier patches in this stack. This is\nintended to reduce the likelihood of hitting one of those failures in the case\nwhere the check is overly restrictive, instead blocking access to storage APIs\nin those cases with an exception.\n\nThis should hopefully reduce the risk of enabling these checks in builds.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302408\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318147\n", "files": ["dom/broadcastchannel/BroadcastChannel.cpp", "dom/cache/CacheStorage.cpp", "dom/fs/child/FileSystemBackgroundRequestHandler.cpp", "dom/simpledb/SDBConnection.cpp", "dom/storage/LocalStorageManager.cpp", "dom/storage/StorageActivityService.cpp", "dom/workers/sharedworkers/SharedWorker.cpp", "ipc/glue/BackgroundChild.h", "ipc/glue/BackgroundImpl.cpp"], "git_node": "5bf156d9c40b1273f6f95d39a8782cb53ae57312", "git_parents": ["b8a3704b406f96b6763944bfee88408ad2a4b134"], "node": "4ea1b10dbe4ca6a8123edd44ff69eaeb3e84bd5b", "parents": ["c794b063cbf6bc9b393258b1851b640703fa7b75"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 4: Use ThreadsafeContentParentHandle in LocalStorage & ClientSource actors,  a=RyanVM\n\nPipe ThreadsafeContentParentInfo throughout LocalStorage & ClientSource such\nthat the local storage state is more generally available there. This should\nhave no behaviour changes, and is just setup for the following parts.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302409\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318148\n", "files": ["dom/clients/manager/ClientManagerParent.cpp", "dom/clients/manager/ClientManagerService.cpp", "dom/clients/manager/ClientManagerService.h", "dom/clients/manager/ClientSourceParent.cpp", "dom/clients/manager/ClientSourceParent.h", "dom/localstorage/ActorsParent.cpp"], "git_node": "0269daeb90edd27376ed65e5c0d51afe0a1d2e7e", "git_parents": ["5bf156d9c40b1273f6f95d39a8782cb53ae57312"], "node": "d96f79142c17fcb13b265fc4eab71c0954aef012", "parents": ["4ea1b10dbe4ca6a8123edd44ff69eaeb3e84bd5b"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 5: ValidatePrincipal in LocalStorage actors,  a=RyanVM\n\nCall ValidatePrincipal on the principals in LocalStorage using the newly piped\nthrough ThreadsafeContentParentHandle to extract the remoteType.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302410\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318149\n", "files": ["dom/localstorage/ActorsParent.cpp"], "git_node": "0febc4fb20d5dd73532aaa8b653a006b7bd39758", "git_parents": ["0269daeb90edd27376ed65e5c0d51afe0a1d2e7e"], "node": "1fc9e6111e7ae9bfbe8ef079aedde39266cbe6ab", "parents": ["d96f79142c17fcb13b265fc4eab71c0954aef012"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 6: Call ValidatePrincipal from PrincipalVerifier,  a=RyanVM\n\nThis call-site was already doing validation on principals for the Cache API.\nThe new checks make this validation more thorough.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302411\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318150\n", "files": ["dom/cache/PrincipalVerifier.cpp"], "git_node": "bf95ca323dc0fc0fe248b7b39ccf47f989ae33de", "git_parents": ["0febc4fb20d5dd73532aaa8b653a006b7bd39758"], "node": "e6e3c1acaf35a861e9dec2594a2a759119e50cb8", "parents": ["1fc9e6111e7ae9bfbe8ef079aedde39266cbe6ab"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 7: Validate ClientSources on creation,  a=RyanVM\n\nThis patch does not validate all places which pass around IPCClientInfo, as\nthat can be passed into a different process. Instead the validation is\nperformed when the ClientSource is bound.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302412\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318151\n", "files": ["dom/clients/manager/ClientSource.cpp", "dom/clients/manager/ClientSourceParent.cpp", "dom/clients/manager/ClientValidation.cpp", "dom/clients/manager/ClientValidation.h"], "git_node": "b34ca4b67beae0e2c7551bec5e47eeda00251f2d", "git_parents": ["bf95ca323dc0fc0fe248b7b39ccf47f989ae33de"], "node": "b42df0c6d7968cca8c57a8a8e0b9503da98a1e9e", "parents": ["e6e3c1acaf35a861e9dec2594a2a759119e50cb8"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 8: We cant access cache for a different origin,  a=RyanVM\n\nThis test was failing after the changes in earlier parts, as it was explicitly\naccessing storage for another origin from within the content process. The test\nwas simplified to access the current document's origin instead, as it appears\nthat is the actual use-case for this API from DevTools.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302413\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318152\n", "files": ["dom/cache/test/mochitest/test_chrome_constructor.html"], "git_node": "fed4a715efb5493a03a9c9de618d2fc5e53ec23f", "git_parents": ["b34ca4b67beae0e2c7551bec5e47eeda00251f2d"], "node": "f0d24d6fef041374d8cdc22f237e2bef90182eda", "parents": ["b42df0c6d7968cca8c57a8a8e0b9503da98a1e9e"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 9: Validate principals early during SharedWorker creation,  a=RyanVM\n\nThis is a bit of an aggressive approach to the implementation, and will result\nin `ValidatePrincipal` failures firing in codepaths reachable from web content.\nSpecifically the checks in the SharedWorkerService will hit this for loads\nwhich would normally fail during network fetch.\n\nIn the future, we should refactor the implementation to avoid needing to do\nvalidation in this way, by deriving these values directly within the parent\nprocess.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D302414\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318153\n", "files": ["dom/workers/sharedworkers/SharedWorker.cpp", "dom/workers/sharedworkers/SharedWorkerService.cpp", "dom/workers/sharedworkers/SharedWorkerService.h", "ipc/glue/GeckoChildProcessHost.h"], "git_node": "a1262f9fcc629848b77ce0284ac9d662712a61b4", "git_parents": ["fed4a715efb5493a03a9c9de618d2fc5e53ec23f"], "node": "455241631b9c0011830f132524080ebe44d2f8e9", "parents": ["f0d24d6fef041374d8cdc22f237e2bef90182eda"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 10: Validate principals during IndexedDB creation,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D307070\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318154\n", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/indexedDB/IDBFactory.cpp"], "git_node": "8161d9f30663f2aed1fee1936efd5b798dcf87b2", "git_parents": ["a1262f9fcc629848b77ce0284ac9d662712a61b4"], "node": "694ee9617448825ae623d91c31f80be6f15acab4", "parents": ["455241631b9c0011830f132524080ebe44d2f8e9"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2039990 - Part 11: Allow some tests to access system IndexedDB from content,  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D308595\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318155\n", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/indexedDB/IDBFactory.cpp", "dom/indexedDB/IndexedDBCommon.cpp", "dom/indexedDB/IndexedDBCommon.h", "dom/indexedDB/test/test_message_manager_ipc.html", "dom/indexedDB/test/unit/xpcshell-head-child-process.js", "dom/indexedDB/test/unit/xpcshell-parent-process.toml", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "9226259a7342044f07b39612347fa72d968b080c", "git_parents": ["8161d9f30663f2aed1fee1936efd5b798dcf87b2"], "node": "e02d0b69e23c33180b05ed965c5b6e64aa0251cb", "parents": ["694ee9617448825ae623d91c31f80be6f15acab4"], "tags": []}], "date": 1786826638, "git_changesets": ["a21ea27f6d8ee40e1c100458b7138032a0b58996", "b8a3704b406f96b6763944bfee88408ad2a4b134", "5bf156d9c40b1273f6f95d39a8782cb53ae57312", "0269daeb90edd27376ed65e5c0d51afe0a1d2e7e", "0febc4fb20d5dd73532aaa8b653a006b7bd39758", "bf95ca323dc0fc0fe248b7b39ccf47f989ae33de", "b34ca4b67beae0e2c7551bec5e47eeda00251f2d", "fed4a715efb5493a03a9c9de618d2fc5e53ec23f", "a1262f9fcc629848b77ce0284ac9d662712a61b4", "8161d9f30663f2aed1fee1936efd5b798dcf87b2", "9226259a7342044f07b39612347fa72d968b080c"], "user": "rvandermeulen@mozilla.com"}, "1572": {"changesets": [{"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054631 - Modernize principal IPC in WebBrowserPersist.  a=RyanVM\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315147\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318866\n", "files": ["dom/webbrowserpersist/PWebBrowserPersistDocument.ipdl", "dom/webbrowserpersist/WebBrowserPersistDocumentChild.cpp", "dom/webbrowserpersist/WebBrowserPersistDocumentParent.cpp", "dom/webbrowserpersist/