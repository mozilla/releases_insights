537\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320023\n", "files": ["gfx/layers/wr/AsyncImagePipelineManager.cpp", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/example-compositor/compositor/src/main.rs", "gfx/wr/examples/common/boilerplate.rs", "gfx/wr/examples/document.rs", "gfx/wr/examples/iframe.rs", "gfx/wr/examples/multiwindow.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/wrench/src/rawtest.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "af1128437ae3111240b408fce48cd845d50371fa", "git_parents": ["5f5b02bdadd32e11bec09088fb2d101e7a2bcd5b"], "node": "9579b0f7bc0976e3409fc83480c2f1579edd2eff", "parents": ["571183adb9f167e52d235c2e39f80e6a737b66f2"], "tags": []}], "date": 1787241619, "git_changesets": ["af1128437ae3111240b408fce48cd845d50371fa"], "user": "rvandermeulen@mozilla.com"}, "1586": {"changesets": [{"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054652 - Fix WR examples build on older ESR branches. a=bustage\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320189\n", "files": ["gfx/wr/examples/multiwindow.rs"], "git_node": "fe99a02e95c75664fd6a4b5d8e7ab5de5cde8e47", "git_parents": ["af1128437ae3111240b408fce48cd845d50371fa"], "node": "a8140d2508b979292976e42e399915f5e232855b", "parents": ["9579b0f7bc0976e3409fc83480c2f1579edd2eff"], "tags": []}], "date": 1787247675, "git_changesets": ["fe99a02e95c75664fd6a4b5d8e7ab5de5cde8e47"], "user": "rvandermeulen@mozilla.com"}, "1587": {"changesets": [{"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059027 - Create the DLL blocklist shared section with an empty DACL.  a=RyanVM DONTBUILD\n\nSharedSection::Init() creates the section with no security descriptor.\nGive the object a present-but-empty DACL, as ipc/glue does for freezable\nshared memory.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318252\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319963\n", "files": ["browser/app/winlauncher/freestanding/SharedSection.cpp", "browser/app/winlauncher/freestanding/moz.build", "browser/app/winlauncher/test/TestCrossProcessWin.cpp", "browser/app/winlauncher/test/moz.build"], "git_node": "8b86099feaea1316ff868a053e461f108883dc85", "git_parents": ["fe99a02e95c75664fd6a4b5d8e7ab5de5cde8e47"], "node": "5f9897a46c9ed685474b0e66121dc9ce8097c6a0", "parents": ["a8140d2508b979292976e42e399915f5e232855b"], "tags": []}], "date": 1787259277, "git_changesets": ["8b86099feaea1316ff868a053e461f108883dc85"], "user": "rvandermeulen@mozilla.com"}, "1588": {"changesets": [{"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2061220, Bug 2058051 - Backport cubeb WASAPI output channel count and WinMM stream destroy fixes.  a=RyanVM DONTBUILD\n\nThis branch pins an older libcubeb revision, so the two fixes are carried as\nlocal vendoring patches rather than a full libcubeb update:\n\n- wasapi-output-mix-channel-count.patch: upstream cubeb dc56ea41 and f0bd97db\n  (mozilla/cubeb#856), bug 2061220.  Creates the output mixer when the device\n  mix channel count differs from the stream channel count, and rejects stream\n  params whose layout and channel count disagree.\n- winmm-destroy-work-item-uaf.patch: upstream cubeb f6b59a3b\n  (mozilla/cubeb#854), bug 2058051.  Counts pending buffer thread work items\n  per stream and in-flight driver callbacks per context so stream and context\n  destruction wait for them to drain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319946\n", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb.c", "media/libcubeb/src/cubeb_wasapi.cpp", "media/libcubeb/src/cubeb_winmm.c", "media/libcubeb/test/test_sanity.cpp", "media/libcubeb/wasapi-output-mix-channel-count.patch", "media/libcubeb/winmm-destroy-work-item-uaf.patch"], "git_node": "be5c17ce6dd61618de08a9c64d0c4b870e9d6255", "git_parents": ["8b86099feaea1316ff868a053e461f108883dc85"], "node": "b3164497f9ee7fba4a9e0aece4447a6209b19794", "parents": ["5f9897a46c9ed685474b0e66121dc9ce8097c6a0"], "tags": []}], "date": 1787259299, "git_changesets": ["be5c17ce6dd61618de08a9c64d0c4b870e9d6255"], "user": "rvandermeulen@mozilla.com"}, "1589": {"changesets": [{"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2064188 - Ensure Nimbus update timer is set during init  a=RyanVM DONTBUILD\n\nIn bug 1941963, side effects were removed from\nRemoteSettingsExperimentLoader.sys.mjs, making it safe to import without\ntriggering the creation of a global RemoteSettingsExperimentLoader.\nHowever, that patch also gated setting the update timer based on the\nRemoteSettingsExperimentLoader's enabled state. Unfortunately,\nthe timer was registered *before* the enabled flag was set, which meant\nthat the timer was never actually registered.\n\nWe now ensure that we set the enable state before registering the timer.\nThis behaviour is tracked by a new test.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319282\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319888\n", "files": ["toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_timer.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "31fdc6f01cc5337f5727c4bf7fa83a65c74937be", "git_parents": ["be5c17ce6dd61618de08a9c64d0c4b870e9d6255"], "node": "bc138111a32c7f88445d42399242f16da9f4e9d1", "parents": ["b3164497f9ee7fba4a9e0aece4447a6209b19794"], "tags": []}], "date": 1787259326, "git_changesets": ["31fdc6f01cc5337f5727c4bf7fa83a65c74937be"], "user": "rvandermeulen@mozilla.com"}, "1590": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2061110, handle popover hiding in a bit more consistent way,  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319204\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320089\n", "files": ["dom/base/Document.cpp"], "git_node": "c5e3fe73b568ef6588b3ff0b74812056fc7d2cc0", "git_parents": ["31fdc6f01cc5337f5727c4bf7fa83a65c74937be"], "node": "c3fccaad750da5aff9877266bbf62e4289077d41", "parents": ["bc138111a32c7f88445d42399242f16da9f4e9d1"], "tags": []}], "date": 1787259350, "git_changesets": ["c5e3fe73b568ef6588b3ff0b74812056fc7d2cc0"], "user": "rvandermeulen@mozilla.com"}, "1591": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061292 - Ensure scrolled content is in the same doc.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D319156\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319728\n", "files": ["layout/base/PresShell.cpp", "testing/web-platform/tests/css/css-contain/content-visibility/crashtests/scroll-into-view-target-moved-to-other-document.html"], "git_node": "f05a9cc8f67fd69feeeb6bee870f0ec9ed72232e", "git_parents": ["c5e3fe73b568ef6588b3ff0b74812056fc7d2cc0"], "node": "6ddf6052d26fd849ad275495963b500f61a12d20", "parents": ["c3fccaad750da5aff9877266bbf62e4289077d41"], "tags": []}], "date": 1787259373, "git_changesets": ["f05a9cc8f67fd69feeeb6bee870f0ec9ed72232e"], "user": "rvandermeulen@mozilla.com"}, "1592": {"changesets": [{"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055693 - Remove dead javascript: URI handling in LoadHistoryEntry.  a=RyanVM DONTBUILD\n\nPer spec, javascript: URIs are never stored in SH. Neither has this code test\ncoverage, nor does the test on the bug that introduced it still pass.\n\nOriginal Revision: https://phabricator.services.mozilla.com/D314860\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319687\n", "files": ["docshell/base/nsDocShell.cpp", "docshell/shistory/SessionHistoryEntry.cpp"], "git_node": "fba90ac24200756e15147cc8e635366def6689cf", "git_parents": ["f05a9cc8f67fd69feeeb6bee870f0ec9ed72232e"], "node": "9bd5a48579a20a9699c0d8de596dd01bd324d2c7", "parents": ["6ddf6052d26fd849ad275495963b500f61a12d20"], "tags": []}], "date": 1787259396, "git_changesets": ["fba90ac24200756e15147cc8e635366def6689cf"], "user": "rvandermeulen@mozilla.com"}, "1593": {"changesets": [{"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060008.  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D315941\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319676\n", "files": ["gfx/2d/DrawTargetCairo.cpp"], "git_node": "a1875de7925fd68f40f4fa7af9d9b6e79b9ce2cc", "git_parents": ["fba90ac24200756e15147cc8e635366def6689cf"], "node": "300801c2ea93575ef58d37b4e9d77e2daea5739f", "parents": ["9bd5a48579a20a9699c0d8de596dd01bd324d2c7"], "tags": []}], "date": 1787259418, "git_changesets": ["a1875de7925fd68f40f4fa7af9d9b6e79b9ce2cc"], "user": "rvandermeulen@mozilla.com"}, "1594": {"changesets": [{"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2057817 - ensure browser id handling is consistent,  a=RyanVM DONTBUILD\n\nOriginal Revision: https://phabricator.services.mozilla.com/D318490\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319954\n", "files": ["docshell/base/BrowsingContext.cpp"], "git_node": "39349547c5b5c55836c8560620e819a39bf15b57", "git_parents": ["a1875de7925fd68f40f4fa7af9d9b6e79b9ce2cc"], "node": "1476340c6f1c5c25c381b8a24e52dc04f986ec4f", "parents": ["300801c2ea93575ef58d37b4e9d77e2daea5739f"], "tags": []}], "date": 17872594