parents": ["457bdadfd82bf30d3401ac86a512e6733bdafb94"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 1804409, cycle collect mVisualViewport, r=emilio a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D164319", "files": ["dom/base/nsGlobalWindowInner.cpp"], "git_node": null, "git_parents": [null], "node": "45286505344b96a4ad21dd0d12b4300634f67346", "parents": ["21e07abfaa8e7a6aa6f05bd585a111f50e2466dd"], "tags": []}, {"author": "Michael Comella \u003cmichael.l.comella@gmail.com\u003e", "branch": "default", "desc": "Bug 1762482 - update PerformanceMeasure to User Timing L3. r=sefeng,smaug a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D143858", "files": ["dom/performance/Performance.cpp", "dom/performance/Performance.h", "dom/performance/PerformanceMark.cpp", "dom/performance/PerformanceMeasure.cpp", "dom/performance/PerformanceMeasure.h", "dom/webidl/Performance.webidl", "dom/webidl/PerformanceMeasure.webidl", "testing/web-platform/meta/user-timing/idlharness.any.js.ini", "testing/web-platform/meta/user-timing/mark-measure-return-objects.any.js.ini", "testing/web-platform/meta/user-timing/measure-l3.any.js.ini", "testing/web-platform/meta/user-timing/measure-with-dict.any.js.ini", "testing/web-platform/meta/user-timing/measure_exception.html.ini", "testing/web-platform/meta/user-timing/structured-serialize-detail.any.js.ini"], "git_node": null, "git_parents": [null], "node": "d332ceb003cf47f1eae970920c9b76470370aa17", "parents": ["45286505344b96a4ad21dd0d12b4300634f67346"], "tags": []}, {"author": "Michael Comella \u003cmichael.l.comella@gmail.com\u003e", "branch": "default", "desc": "Bug 1775499 - check for null GetParentObject in Performance::Measure. r=sefeng\n\nRoot cause: the global object can be null but I wasn't checking for it so it\ncaused a crash. I don't remember under what conditions it can be null but I saw\nI had checked for null when I wrote Performance::Mark and remember debugging it\nso it makes sense to do so here as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151960", "files": ["dom/performance/Performance.cpp"], "git_node": null, "git_parents": [null], "node": "1e3e299cc90d60306ea47a6071fa648834fa87f6", "parents": ["d332ceb003cf47f1eae970920c9b76470370aa17"], "tags": []}, {"author": "Michael Comella \u003cmichael.l.comella@gmail.com\u003e", "branch": "default", "desc": "Bug 1775499 - update user_timing_dying_global test for performance.measure. r=sefeng\n\nRoot cause of test failure: the updates in this bug caused performance.measure\nto throw an exception if there is a dying global. However, the test didn't try\nto catch the exception so it failed with an uncaught exception. I updated the\ntest to handle this case which it was already doing for performance.mark.\n\nAdditionally, I corrected some indentation.\n\nDepends on D151960\n\nDifferential Revision: https://phabricator.services.mozilla.com/D152814", "files": ["dom/performance/tests/test_performance_user_timing_dying_global.html"], "git_node": null, "git_parents": [null], "node": "7d0b18a28d923233c15e2a6607fd349a7c677b30", "parents": ["1e3e299cc90d60306ea47a6071fa648834fa87f6"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1800890 r=asuth a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D165276", "files": ["dom/websocket/WebSocket.cpp"], "git_node": null, "git_parents": [null], "node": "b9be0509188d88adfd1e0c176d5fee5a00c4f1b9", "parents": ["7d0b18a28d923233c15e2a6607fd349a7c677b30"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1795139 - Show fullscreen notification as soon as browser window goes into fullscreen mode; r=smaug, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D159383", "files": ["browser/actors/DOMFullscreenParent.jsm", "dom/base/Document.cpp", "dom/tests/mochitest/chrome/MozDomFullscreen_chrome.xhtml"], "git_node": null, "git_parents": [null], "node": "7968f9296e4c4f49a6efd1d9ccfaec9fe4f9b5b7", "parents": ["b9be0509188d88adfd1e0c176d5fee5a00c4f1b9"], "tags": []}], "date": 1672761011, "git_changesets": [null, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "147": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update\n\nDifferential Revision: https://phabricator.services.mozilla.com/D166043", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/search-config.json", "services/settings/dumps/main/search-telemetry-v2.json"], "git_node": null, "git_parents": [null], "node": "7fe0d2735bb0a4b6e3f34009ce0a41c051ee0902", "parents": ["7968f9296e4c4f49a6efd1d9ccfaec9fe4f9b5b7"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1793905 - Disable HTTPS only preferences when locked. r=settings-reviewers,Gijs,mconley a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D160373", "files": ["browser/components/preferences/privacy.js"], "git_node": null, "git_parents": [null], "node": "402a2c9e7078b01d327f7b490660f77f2da563cb", "parents": ["7fe0d2735bb0a4b6e3f34009ce0a41c051ee0902"], "tags": []}, {"author": "Mike Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1797527 - Update PersonalToolbar policy with newtab feature. r=mstriemer, a=RyanVM", "files": ["browser/components/enterprisepolicies/Policies.jsm", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser_policy_display_bookmarks.js", "browser/components/preferences/privacy.js"], "git_node": null, "git_parents": [null], "node": "2281a47a322a4be1