fallback.js", "toolkit/mozapps/extensions/test/browser/browser_html_detail_permissions.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view_recommendations.js", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js", "toolkit/mozapps/extensions/test/browser/browser_local_install.js", "toolkit/mozapps/extensions/test/browser/browser_webapi_sendAbuseReport.js", "tools/lint/eslint/eslint-plugin-mozilla/lib/configs/general-test.mjs", "tools/lint/eslint/eslint-plugin-mozilla/lib/configs/xpcshell-test.mjs", "tools/lint/eslint/eslint-plugin-sdl-vendored/index.mjs", "tools/lint/eslint/eslint-plugin-sdl-vendored/moz.yaml", "tools/lint/eslint/eslint-plugin-sdl-vendored/package.json", "tools/lint/eslint/eslint-plugin-sdl-vendored/vendor/LICENSE", "tools/lint/eslint/eslint-plugin-sdl-vendored/vendor/no-insecure-url.js", "tools/profiler/tests/browser/browser_test_feature_jstracing_objtestutils.js", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "8b912e281cb5d6407d07db033fb26e9f7d1bc0c6", "git_parents": ["8800d0f76ee2ad7af6cc2851844d1d36943ad74f"], "node": "46ee1a9bf2265f59b05ed0ae15e0259fc790125a", "parents": ["75950fad3e76fdbbc51ebd1c85915942bb2274e7"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2048635 - Don't allow param(--foo) in link-parameters. r=firefox-style-system-reviewers,firefox-svg-reviewers,dshin,longsonr\" for causing wpt and mochitests failures at parameters and value_computation.html\n\nThis reverts commit 073a8207b94ba3f9a50d43f86561873c35e9d67f.\n", "files": ["layout/svg/SVGImageContext.h", "servo/components/style/custom_properties.rs", "servo/components/style/values/specified/param.rs", "testing/web-platform/meta/css/css-link-params/link-parameters-invalid.html.ini"], "git_node": "b1517c6752fac63b464d8d1bb2a4fbfa5edc6243", "git_parents": ["8b912e281cb5d6407d07db033fb26e9f7d1bc0c6"], "node": "776300cb7f75687fc1ed3e53ed18a0cfc152bae2", "parents": ["46ee1a9bf2265f59b05ed0ae15e0259fc790125a"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057884 - Reenable `browser_sandbox_test` under Nova. r=sandbox-reviewers,bobowen\n\nNova is a Firefox frontend revamp, and `browser_sandbox_test` is a suite\nof lower-level sandbox policy tests written in C++, so any failures were\nlikely coincidental, and we should reenable the test and investigate any\nnew failures that result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316140\n", "files": ["security/sandbox/test/browser.toml"], "git_node": "28b5e86da948982342836c3cca50049659f0dc70", "git_parents": ["b1517c6752fac63b464d8d1bb2a4fbfa5edc6243"], "node": "2cf8eec95457451adbd67d223a7af8ed65461fcd", "parents": ["776300cb7f75687fc1ed3e53ed18a0cfc152bae2"], "tags": []}], "date": 1785878959, "git_changesets": ["cbfddbb0d3394c49f5bc3911a5b66142d958a047", "73e13255ce6550e777d95b8c0bcd2942a4b4b36f", "635d57a16e7dfb3c091a5b5800cb19a7a39f33ff", "f60919b832ae584ee8cd332a518957b72941cb80", "13a3aca76194280f2e632c7ed7b31c8ded1987cf", "b348d4de7eee9300f2cf5588ecb7b8d9ab679afc", "8ff1fba668a21f2686d8203cd45aa519ecc97af5", "9dc7bbab8213f0fa9618b27b398b43d98ba223c6", "9bf7876ab0d9bb4d5291e6beaf77e1304fbf86f8", "e8ba0a0066529f623bfc2685b96011b329efe729", "5c3e4c55c1dc3c2ff81505c7d5d0d777c521c490", "d59ef71ecbdac5db1f09a99fb0b7b435be46c9b8", "700ecbb8d93230d7cf63f8b73a5366743495666d", "5d4faac56ff1f1996bfc1a22d1f6e700b17c56a0", "943299678c7f5d3ed27b119513420e878fc28085", "aa4f8b0bb022e7bf693f3a9f234c3e4992dc71d2", "40233118ef8678380e10554ccbd932af8d73bf4f", "8eaee5b05609e7d01c67533431b7d3cace4053ae", "43e40336f8ea9c32c1f93c2ec60af5b0d677d1b9", "43b011434d33df3cca64cd896ce9b3c20054c87b", "5e23648dbbfbb79cbf08090acc8d3b9c47683b67", "f747ebc1440f9773466d93d63d32dd004a76a4d6", "8e824610f738d8109072a95b7a65223297f07f1e", "073a8207b94ba3f9a50d43f86561873c35e9d67f", "d4cad3be6e1d5005e72f73a537bef86f0e0db500", "16278aba3c60df46359e0925356293d1015edb81", "7dc8e943276d97ecefc6ce879a78ec3e7426fe83", "00980d551a1d4133042ef99bfba550c903123b27", "8800d0f76ee2ad7af6cc2851844d1d36943ad74f", "8b912e281cb5d6407d07db033fb26e9f7d1bc0c6", "b1517c6752fac63b464d8d1bb2a4fbfa5edc6243", "28b5e86da948982342836c3cca50049659f0dc70"], "user": "asilaghi@mozilla.com"}, "45026": {"changesets": [{"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050959 - Update documentation for Taskbar Tabs. r=nrishel,hsohaney DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309180\n", "files": ["browser/components/taskbartabs/TaskbarTabsRegistry.sys.mjs", "browser/components/taskbartabs/docs/architecture.md", "browser/components/taskbartabs/docs/index.md"], "git_node": "874d5d8b0b1ee257598bb96d885cb4cc3f5a0f2f", "git_parents": ["28b5e86da948982342836c3cca50049659f0dc70"], "node": "030572bae69ee09265fdf49a39420792a68af962", "parents": ["2cf8eec95457451adbd67d223a7af8ed65461fcd"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046947 - Vendor the double-checkmark icon from acorn-icons r=desktop-theme-reviewers,dao\n\nAdd double-checkmark-16.svg from acorn-icons v1.103.0 and declare it in the\nshared desktop jar so it is available as chrome://global/skin/icons/.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315132\n", "files": ["toolkit/themes/shared/desktop-jar.inc.mn", "toolkit/themes/shared/icons/double-checkmark.svg"], "git_node": "c12f47b3dd4d4e2382705c5439a3046377a60989", "git_parents": ["874d5d8b0b1ee257598bb96d885cb4cc3f5a0f2f"], "node": "23d21bca5e62185240018fbf254de3178b6af60e", "parents": ["030572bae69ee09265fdf49a39420792a68af962"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054390 - Report shown/closed web notifications to chrome observers r=saschanaz\n\nReport every shown and closed web notification to the parent-process observer service, so chrome features such as the New Tab notifications feed can observe Service-Worker-backed and page (new Notification()) notifications uniformly.\n\nThe reporting lives in nsAlertsService rather than in the Notification API. ShowAlert wraps the caller's alert listener in a small nsIObserver that forwards every callback untouched and  additionally fires \"web-notification-shown\" on alertshow and \"web-notification-closed\" on alertfinished. An alert that was never shown (see ShouldShowAlert) still finishes, but reports nothing,  because no consumer was told it existed. Only alerts with an actionable principal are reported, which is what confines this to web content, and private-browsing alerts never are. The nsIAlertNotification is the observer subject.\n\nReporting is a platform capability rather than a feature of any one consumer, so it is on by default: NotifyObservers is inert when nothing has registered for the topics, so an uninterested profile pays a hash lookup per notification and nothing more.\n\nbrowser.alerts.capture.enabled is a kill switch, not a feature gate. Consumers gate themselves; the New Tab feed is the first, and does so with browser.newtabpage.activity-stream.system.showWebNotifications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311746\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/alerts/nsAlertsService.cpp", "toolkit/components/alerts/test/browser/browser.toml", "toolkit/components/alerts/test/browser/browser_alert_capture.js", "toolkit/components/alerts/test/browser/file_empty.html"], "git_node": "d134422f8930178825b22ef5872042361748f377", "git_parents": ["c12f47b3dd4d4e2382705c5439a3046377a60989"], "node": "ab40596abdc83bdbef6f896fb7d81babcd5b5ac4", "parents": ["23d21bca5e62185240018fbf254de3178b6af60e"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054391 - Capture web notifications into a live newtab slice r=thecount\n\nAdd WebNotificationsFeed, the WebNotifications Redux slice, and the by-site\nmatcher. Web-notification-shown / web-notification-closed observers keep it\ncurrent, broadcasting ADDED/REMOVE.\n\nContent is a pure projection that dispatches intents (dismiss, click) to the\nparent; dismiss on the real close path (firing notificationclose).\n\nIntroduce the two prefs that gate the feature, keeping the feature gate and the\nuser preference distinct: system.showWebNotifications decides whether the\nfeature exists for this profile at all (Nimbus/about:config, default off), and\nshowWebNotifications is the user preference the customize toggle will write.\nThe feed observes only while both are set, and drops its captured state when\nthey stop being set, so content never renders a frozen snapshot. Because\nregistering the observers is what makes platform capture reach anyone, that\npair is the whole gate: nothing writes the platform pref.\n\nwebnotificationsfeed is registered as a system feed (default on), like\nweatherfeed. It is constructed for every profile and sits idle until the prefs\nsay otherwise; feed construction is a lifecycle detail, not the feature gate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311747\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/content-src/lib/web-notification-match.mjs", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/WebNotificationsFeed.sys.mjs", "browser/extensions/newtab/test/unit/common/Reducers.test.js", "browser/extensions/newtab/test/unit/content-src/lib/web-notification-match.test.js", "browser/extensions/newtab/test/unit/lib/WebNotificationsFeed.test.js"], "git_node": "cb8d778c5efb5b68c0076e996b81e28ba7ae2c88", "git_parents": ["d134422f8930178825b22ef5872042361748f377"], "node": "f7eccaedcd3af0363e4774c5e4be72dea111a022", "parents": ["ab40596abdc83bdbef6f896fb7d81babcd5b5ac4"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046947 - Add the top sites notifications hover card r=thecount,fluent-reviewers,bolsson\n\nAdd the TopSitesHoverCard shell and its notifications content card. The shell is\na small router: it applies the web notifications gate, then renders exactly one\ncontent variant from an ordered registry (hover-card-content.jsx).\n\nCardWebNotifications lists a site's most recent notifications.\n\nThe gate is isWebNotificationsEnabled, added next to the matcher so that every\nsurface asks the same question rather than each reaching into Prefs for its own\ncombination: the feature must exist for the profile and the user must want it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308103\n", "files": ["browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardAd/CardAd.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/_CardWebNotifications.scss", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/TopSitesHoverCard.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/_TopSitesHoverCard.scss", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/hover-card-content.jsx", "browser/extensions/newtab/content-src/lib/web-notification-icon.mjs", "browser/extensions/newtab/content-src/lib/web-notification-match.mjs", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/test/unit/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSitesHoverCard/TopSitesHoverCard.test.jsx", "browser/extensions/newtab/test/unit/content-src/lib/web-notification-icon.test.js", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "dcdfed02974fd230d6248d3bb0bb5729f67302f3", "git_parents": ["cb8d778c5efb5b68c0076e996b81e28ba7ae2c88"], "node": "3f39dd06bd3b2e8a7bef6e9c4716a08ff71a7653", "parents": ["f7eccaedcd3af0363e4774c5e4be72dea111a022"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046946 - Add the top sites notification badge and customize toggle r=thecount,fluent-reviewers,bolsson\n\nAdd TopSiteWebNotification, a count badge on a tile's icon corner showing how\nmany web notifications the site has.\n\nThe icon lives in an overflow-clipped wrapper, so the badge cannot be a child of\nit and still hang over the corner. Rather than position the badge against the\ntile and derive the icon's corner from the tile's dimensions, wrap the icon in\nan unclipped .icon-stack that takes its size from it, and anchor the badge to\nthat. The badge offset is then just zero, which also disposes of the pixel-grid\nproblem the arithmetic had: the offsets no longer round, so nothing jumps when\nthe tile repaints on hover.\n\nAdd a \"Web notifications\" toggle to the Shortcuts section of the customize\npanel. It writes showWebNotifications and nothing else, so it is an ordinary\ndata-preference toggle rather than a bespoke handler. It is only offered when\nsystem.showWebNotifications says the feature exists for this profile; there is\nno point showing a control for a feature the user cannot have.\n\nBoth the badge and the hover card render only when the feature is enabled, and\nneither requires a redux store for a bare tile mount.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308102\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/TopSiteWebNotification/TopSiteWebNotification.jsx", "browser/extensions/newtab/content-src/components/TopSiteWebNotification/_TopSiteWebNotification.scss", "browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSiteWebNotification/TopSiteWebNotification.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSites.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "b930c352d71dad8157ce4c76090cd39e161f0418", "git_parents": ["dcdfed02974fd230d6248d3bb0bb5729f67302f3"], "node": "bb6957e6ed40164b73fbb9522c15dcf3056e0cc3", "parents": ["3f39dd06bd3b2e8a7bef6e9c4716a08ff71a7653"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058234: Remove new tabs toolbar spring when on vertical tabs r=sfoster\n\nHide the new spring (the one in the left of the alltabs button by default) when moving to vertical tabs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315313\n", "files": ["browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/sidebar/tests/marionette/test_initialize_vertical_tabs.py"], "git_node": "59a9508cf58b7576d5a6594d52833fd28f4eaf33", "git_parents": ["b930c352d71dad8157ce4c76090cd39e161f0418"], "node": "a471432a8a90b220442e6b552391638cd4a2ffc0", "parents": ["bb6957e6ed40164b73fbb9522c15dcf3056e0cc3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060011 - Fix function return values of void in XPIDL rust code. r=nika\n\nNote that pointers are dealt with here aiui:\n\n  https://searchfox.org/firefox-main/rev/2500ad5c8ac76a6a2c166cbbe891f14257e988f3/xpcom/idl-parser/xpidl/xpidl.py#761\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315850\n", "files": ["xpcom/idl-parser/xpidl/rust.py", "xpcom/idl-parser/xpidl/xpidl.py"], "git_node": "1fb9175bc31abc598a841b2123a83cc6db1d9976", "git_parents": ["59a9508cf58b7576d5a6594d52833fd28f4eaf33"], "node": "5e59f5c1a157bf70e7e08d0bb6a5b46d84f18548", "parents": ["a471432a8a90b220442e6b552391638cd4a2ffc0"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060007 - Add the missing toctree entries for orphaned documentation pages. r=necko-reviewers,devtools-reviewers,jdescottes,nchevobbe,valentin\n\n220 pages built but were not reachable from any toctree, so they were\nmissing from the navigation entirely.\n\n./mach doc goes from 905 to 683 warnings. The 3 remaining orphans are\nunder testing/perfdocs/generated, which is generated by\n'./mach lint -l perfdocs' and should be fixed in the generator.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315857\n", "files": ["browser/components/places/docs/index.md", "browser/components/urlbar/docs/ranking.md", "browser/docs/index.md", "browser/installer/windows/docs/index.md", "build/docs/index.md", "devtools/docs/contributor/index.md", "devtools/docs/contributor/tools/inspector.md", "devtools/docs/user/accessibility_inspector/index.md", "devtools/docs/user/application/index.md", "devtools/docs/user/debugger-api/index.md", "devtools/docs/user/debugger/how_to/index.md", "devtools/docs/user/debugger/index.md", "devtools/docs/user/index.md", "devtools/docs/user/memory/index.md", "devtools/docs/user/network_monitor/index.md", "devtools/docs/user/page_inspector/how_to/index.md", "devtools/docs/user/page_inspector/how_to/work_with_animations/index.md", "devtools/docs/user/page_inspector/index.md", "devtools/docs/user/storage_inspector/index.md", "devtools/docs/user/web_console/index.md", "docs/bug-mgmt/processes/index.md", "docs/code-quality/lint/linters/eslint.md", "docs/code-quality/lint/linters/stylelint.md", "docs/code-quality/typescript/index.md", "docs/config.yml", "docs/contributing/index.md", "docs/crash-reporting/index.md", "docs/nspr/index.md", "docs/nspr/listing.md", "docs/performance/index.md", "docs/rust-components/api/index.md", "docs/setup/index.md", "gfx/docs/index.md", "js/src/doc/HazardAnalysis/index.md", "mobile/android/docs/geckoview/index.md", "mobile/android/docs/index.md", "mobile/android/fenix/docs/index.md", "netwerk/docs/index.md", "python/docs/index.md", "remote/doc/index.md", "taskcluster/docs/index.md", "testing/docs/browser-chrome/index.md", "testing/docs/ci-configs/index.md", "testing/docs/mochitest-plain/index.md", "toolkit/components/extensions/docs/index.md", "toolkit/components/telemetry/docs/index.md", "toolkit/docs/index.md", "toolkit/profile/docs/index.md", "tools/tryselect/docs/selectors/index.md"], "git_node": "befdb44d3c68b743c7607108d6e7e3654ea28b08", "git_parents": ["1fb9175bc31abc598a841b2123a83cc6db1d9976"], "node": "2d4faf0f6d417afd801f975f1cf0686ebcc281a8", "parents": ["5e59f5c1a157bf70e7e08d0bb6a5b46d84f18548"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060009 - Fix duplicate documentation labels. r=ai-platform-reviewers\n\nWith autosectionlabel_maxdepth = 1, every page's H1 becomes a global\nlabel, so two pages sharing a title collide.\n\n - mozinfo, WebIDL, AsyncShutdown, FirstStartup and Region carried an\n   explicit (slug)= target left over from the reStructuredText\n   conversion, immediately above an H1 generating the very same label.\n   Drop the redundant target; the autosectionlabel one is identical and\n   points at the same place, so existing refs keep working.\n - Give four generic titles a component-specific name: the TypeScript\n   linter page, the ML inference architecture page, the Glean\n   preferences page and the stylelint no-browser-refs-in-toolkit rule.\n - The eslint and stylelint enabling-rules pages used several H1s where\n   they meant sections; demote the later ones so each page has a single\n   H1.\n\n./mach doc goes from 683 to 672 warnings (76 -\u003e 65 duplicate labels).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315867\n", "files": ["build/docs/mozinfo.md", "docs/code-quality/lint/linters/eslint/enabling-rules.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/no-browser-refs-in-toolkit.md", "docs/code-quality/lint/linters/stylelint/enabling-rules.md", "docs/code-quality/lint/linters/typescript.md", "dom/bindings/docs/index.md", "toolkit/components/glean/docs/dev/preferences.md", "toolkit/components/ml/docs/architecture.md", "toolkit/modules/docs/AsyncShutdown.md", "toolkit/modules/docs/FirstStartup.md", "toolkit/modules/docs/Region.md"], "git_node": "b7646161c508b02f584947c4239e1805c6dc195e", "git_parents": ["befdb44d3c68b743c7607108d6e7e3654ea28b08"], "node": "9553784edbbb810a19d3be9609e92f264b6a4264", "parents": ["2d4faf0f6d417afd801f975f1cf0686ebcc281a8"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057646 - Add World Clock widget city search name strings. r=bolsson,fluent-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314095\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "412dc440954234f91dd63d57e63dcf835afcfd5f", "git_parents": ["b7646161c508b02f584947c4239e1805c6dc195e"], "node": "808bb3bb01baad3ce6168703bc3fe888bddda229", "parents": ["9553784edbbb810a19d3be9609e92f264b6a4264"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060245. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316179\n", "files": ["gfx/layers/ipc/CanvasChild.cpp"], "git_node": "e98b25b5ee45ff89b6c6d063160c09e79a8ec254", "git_parents": ["412dc440954234f91dd63d57e63dcf835afcfd5f"], "node": "2a4a072dea7dfe70053aa154e15694fe81ce42da", "parents": ["808bb3bb01baad3ce6168703bc3fe888bddda229"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021955 - test converting 9-channel audio to stereo. r=media-playback-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301886\n", "files": ["dom/media/test/crashtests/bug2021955.html", "dom/media/test/crashtests/crashtests.list"], "git_node": "4bd10b761d5f4cdce4b088ca8260fc0fb7ed7aa1", "git_parents": ["e98b25b5ee45ff89b6c6d063160c09e79a8ec254"], "node": "94d67ae63359750cffdf78c3409dfea42b0065f9", "parents": ["2a4a072dea7dfe70053aa154e15694fe81ce42da"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2060535 - Don't track background task state on non-Windows in nsBrowserApp. r=afranchuk\n\n`gIsBackgroundTask` is only ever read by `Output`, and only on Windows, where\nit decides whether to pop up a message box. Elsewhere it is set and never read,\nwhich `-Wunused-but-set-global` (new in clang 22) flags.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316268\n", "files": ["browser/app/nsBrowserApp.cpp"], "git_node": "c9236ad5816712b84625c06a6c37e72a2ab14541", "git_parents": ["4bd10b761d5f4cdce4b088ca8260fc0fb7ed7aa1"], "node": "554cf3d66052ca7c035e36f13f3c15a264c9f963", "parents": ["94d67ae63359750cffdf78c3409dfea42b0065f9"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 1946603 - Fix camera preview aspect ratio on LensCameraActivity r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313283\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/AutoFitTextureView.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensPreviewTransform.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/AutoFitTextureViewTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensCameraFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/lens/LensPreviewTransformTest.kt"], "git_node": "639f52942cd91e57aa36650e1e9c7a3cb756b7ec", "git_parents": ["c9236ad5816712b84625c06a6c37e72a2ab14541"], "node": "6cbb475178ed8c741ea986620d39c8fd1f0b4898", "parents": ["554cf3d66052ca7c035e36f13f3c15a264c9f963"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059307 - Only pass apilint.py the list options that were configured. r=geckoview-reviewers,ohall\n\nGradle gives a `ListProperty` an empty value rather than no value, so `lintFilters` and\n`allowedPackages` report as present even when a consumer never sets them, and the `isPresent` guards\nforwarded both flags unconditionally. `apilint.py` takes them as `nargs=\"*\"`, so the flags arrive with\nno values and argparse yields an empty list rather than `None`, which the script treats as a\nconfigured restriction: `--allowed-packages` with nothing after it makes it reject every type in the\nAPI, and it crashes formatting the message.\n\nCheck the lists for emptiness instead. GeckoView sets both options, which is why nothing in the tree\nruns into this today.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315176\n", "files": ["mobile/android/gradle/plugins/apilint/apilint/src/main/kotlin/org/mozilla/apilint/ApiLintPlugin.kt"], "git_node": "2f3793d065bdfc0f97c0851aa7af226de2b46d22", "git_parents": ["639f52942cd91e57aa36650e1e9c7a3cb756b7ec"], "node": "d08fdde99e3aa82dbb4be352d4eb744a462d929f", "parents": ["6cbb475178ed8c741ea986620d39c8fd1f0b4898"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059307 - Declare the apilint settings that the lint tasks read at execution time. r=geckoview-reviewers,ohall\n\n`apiLintSingle` and `apiCompatLint` assemble their command line in a `doFirst` block, reading\n`lintFilters`, `allowedPackages`, `deprecationAnnotation` and `libraryVersion` straight off the\nextension. None of those were declared as task inputs, so Gradle could not tell that changing one\nshould re-run the lint: editing `lintFilters` or `libraryVersion` left both tasks reporting UP-TO-DATE\nand the check silently did not run again.\n\n`libraryVersion` is the one that matters in practice. GeckoView derives it from `MOZILLA_VERSION`, so\nit changes every release, and it is what decides whether a deprecated API should have been removed by\nnow. A version bump on its own would not re-evaluate that.\n\nDeclare them through small helpers so the same wiring can be asserted in a unit test, since covering\nit through the real tasks would need an Android library project.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315177\n", "files": ["mobile/android/gradle/plugins/apilint/apilint/build.gradle.kts", "mobile/android/gradle/plugins/apilint/apilint/src/main/kotlin/org/mozilla/apilint/ApiLintPlugin.kt", "mobile/android/gradle/plugins/apilint/apilint/src/main/kotlin/org/mozilla/apilint/ApiLintTaskInputs.kt", "mobile/android/gradle/plugins/apilint/apilint/src/test/kotlin/org/mozilla/apilint/ApiLintTaskInputsTest.kt"], "git_node": "362adfb467adb6e7c56afb81242b2dc337194a4b", "git_parents": ["2f3793d065bdfc0f97c0851aa7af226de2b46d22"], "node": "c4bf2201fb8e6ecf1519f889a5786062ccfb1e4b", "parents": ["d08fdde99e3aa82dbb4be352d4eb744a462d929f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059307 - Declare the generated API map as a task output. r=geckoview-reviewers,ohall\n\nThe doclet writes a source map next to the API file, named after it, and the lint tasks declare that\nmap as an input. The generating task only declared the API file, so deleting the map on its own left\nthe task up to date and the map ungenerated, and the next task then failed with \"input file does not\nexist\".\n\nDeclare it, deriving the path from the API file so that the task and the lint tasks reading it cannot\ndisagree about the name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315178\n", "files": ["mobile/android/gradle/plugins/apilint/apilint/src/main/kotlin/org/mozilla/apilint/ApiCompatLintTask.kt", "mobile/android/gradle/plugins/apilint/apilint/src/main/kotlin/org/mozilla/apilint/ApiLintPlugin.kt", "mobile/android/gradle/plugins/apilint/apilint/src/test/kotlin/org/mozilla/apilint/ApiCompatLintTaskTest.kt"], "git_node": "8a5f16c0cd09f46ce3182b712bc8e909fbd517e4", "git_parents": ["362adfb467adb6e7c56afb81242b2dc337194a4b"], "node": "12ab10dc7512eee8abe28d7cbabb20cded54a974", "parents": ["c4bf2201fb8e6ecf1519f889a5786062ccfb1e4b"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047023 - Add mochitest-browser-chrome-ml-models for real-model ML tests r=ai-platform-reviewers,taskgraph-reviewers,thasan,ahal,gregtatum\n\nReal ML models can only run under `./mach perftest` today because the\nmozperftest MLServices layer is what allowlists RS + model-hub hosts via\nnetwork.socket.allowed_nonlocal_domains. That's the wrong tool for\ncorrectness regression tests.\n\nnsSocketTransport::ShouldBlockAddress() reads that pref at runtime per\nconnection, so a per-manifest `prefs = [...]` is enough to reach\nmodel-hub.mozilla.org from a plain mochitest \u2014 no hook, no env vars.\n\nAdds browser_models.toml carrying the RS + model-hub subset of\nMLServices.ALLOWED_HOSTS behind subsuite=ml-models, plus two tests: a\nsanity check (HEAD + Range GET GGUF magic) to keep the bypass covered,\nand a real SmolLM2 chat exercising native llama.cpp.\n\nThe corresponding taskcluster task runs Linux opt only, on\nmozilla-central plus try.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310941\n", "files": ["python/mozbuild/mozbuild/schedules.py", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/test-sets.yml", "testing/mochitest/mach_test_package_commands.py", "testing/mozbase/moztest/moztest/resolve.py", "testing/mozharness/configs/unittests/linux_unittest.py", "testing/mozharness/configs/unittests/mac_unittest.py", "testing/mozharness/configs/unittests/win_unittest.py", "testing/mozharness/mach_commands.py", "testing/mozharness/scripts/desktop_unittest.py", "toolkit/components/ml/moz.build", "toolkit/components/ml/tests/browser_models/browser_ml_smollm2_chat.js", "toolkit/components/ml/tests/browser_models/browser_models.toml"], "git_node": "99beeb42b7bf801508900e122fbea47797ac33b0", "git_parents": ["8a5f16c0cd09f46ce3182b712bc8e909fbd517e4"], "node": "7d83fb6aa6222de7b191eb2ecf1a52ade06d4b71", "parents": ["12ab10dc7512eee8abe28d7cbabb20cded54a974"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060537 - Avoid unbinding FBO after partial update blits. r=gfx-reviewers,bradwerth\n\nWhen webrender binds a native picture cache tile, the compositor will\nin some cases blit regions from the tile surface used for the previous\nframe to the tile surface being used for the current frame. This\nensures webrender only needs to render the current frame's dirty\nregion to the tile.\n\nBoth NativeLayerCA and NativeLayerWayland do so by calling\nGLBlitHelper::BlitFramebufferToFramebuffer(). This binds the required\ndraw and read framebuffers, and then restores the previous bindings\nafter performing the blit. draw_picture_cache_target() will then\nimmediately bind the tile surface's FBO again, before rendering the\ntile.\n\nOn Metal ANGLE, we observe that the first draw performed in\ndraw_picture_cache_target() (usually glClear()) causes ANGLE to end\nencoding the previous command buffer (containing the blits) and start\nencoding a new one. This is because the draw framebuffer was changed\nin between the blits and the clear, even though it was immediately\nchanged back again.\n\nWe prevent this by manually binding the required draw and read\nframebuffers when performing the partial update blits, and calling\nGLBlitHelper::BlitFramebuffer() which does *not* change the\nframebuffer bindings. This ensures the same draw framebuffer remains\nbound throughout, allowing ANGLE to use a single command buffer per\ntile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316278\n", "files": ["gfx/layers/NativeLayerMacSurfaceHandler.mm", "gfx/layers/NativeLayerWayland.cpp"], "git_node": "ef2ff706dbdaff5c72471cefcb2c51ed79facd4f", "git_parents": ["99beeb42b7bf801508900e122fbea47797ac33b0"], "node": "202316fd93efae83482eb99fd67e3322393beab8", "parents": ["7d83fb6aa6222de7b191eb2ecf1a52ade06d4b71"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034013 - Show search bar form history when remote search suggestions are disabled. r=mbeier\n\n`browser.search.suggest.enabled` turns off remote search suggestions. The\nold search bar kept showing form history when it was off; the new one,\nbuilt on urlbar code, adopted the urlbar's stricter reading of the pref\nand suppressed form history too.\n\nThe behavior change is scoped to the searchbar SAP, so the urlbar (where\nthe pref does gate both kinds of suggestion) is unaffected. Remote\nsuggestions stay off in the search bar as well, since\n`SearchSuggestionController` checks the pref itself before fetching them.\n\nThis also restores form history in private windows, where\n`browser.search.suggest.enabled.private` defaults to false and was\nsuppressing the search bar's suggestions entirely.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316300\n", "files": ["browser/components/urlbar/UrlbarProviderSearchSuggestions.sys.mjs", "browser/components/urlbar/tests/unit/test_UrlbarProviderSearchSuggestions.js", "browser/components/urlbar/tests/unit/test_search_suggestions.js"], "git_node": "3534aaf4cb209aaa74f49dcb3a6a213985498aff", "git_parents": ["ef2ff706dbdaff5c72471cefcb2c51ed79facd4f"], "node": "94b566dd54831d643d127082d5fe700f12501940", "parents": ["202316fd93efae83482eb99fd67e3322393beab8"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042994 - Parse and serialize -webkit-line-clamp as a legacy shorthand for line-clamp. r=AlaskanEmily,dshin,firefox-style-system-reviewers,emilio\n\nThis also adds special handling for the case where modern line-clamp property\nis pref disabled, but we still want the legacy -webkit-line-clamp to work\nwithout exposing disabled line-clamp. Removed -webkit-line-clamp longhand.\n\nUpdate property database and style tests so -webkit-line-clamp is\nrepresented as a legacy shorthand instead of as a longhand. Teach test\nhelpers to skip disabled subproperties when handling shorthands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312529\n", "files": ["devtools/server/actors/animation-type-longhand.js", "layout/style/nsStyleStruct.cpp", "layout/style/test/property_database.js", "layout/style/test/test_all_shorthand.html", "layout/style/test/test_ch_ex_no_infloops.html", "layout/style/test/test_inherit_computation.html", "layout/style/test/test_inherit_storage.html", "layout/style/test/test_initial_computation.html", "layout/style/test/test_initial_storage.html", "layout/style/test/test_property_database.html", "layout/style/test/test_transitions_per_property.html", "layout/style/test/test_value_computation.html", "layout/style/test/test_value_storage.html", "servo/components/style/properties/data.py", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/style_adjuster.rs", "servo/components/style/values/generics/box.rs", "servo/components/style/values/specified/box.rs", "servo/ports/geckolib/glue.rs"], "git_node": "755cab013ee26b12b0e760127be8443ef6422cda", "git_parents": ["3534aaf4cb209aaa74f49dcb3a6a213985498aff"], "node": "22b400e0a0fbdf37a6788bc5050e309d43aa65bd", "parents": ["94b566dd54831d643d127082d5fe700f12501940"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055937 - Remove layout.css.anchor-positioning.enabled preference. r=layout-reviewers,webidl,devtools-reviewers,firefox-style-system-reviewers,emilio,nchevobbe\n\nCSS anchor positioning shipped in Firefox 147 in bug 1988225. It is time to\nremove the pref.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316280\n", "files": ["accessible/tests/browser/relations/browser.toml", "devtools/client/inspector/rules/test/browser_rules_position-try.js", "devtools/client/shared/sourceeditor/test/css_autocompletion_tests.json", "devtools/client/styleeditor/test/browser_styleeditor_at_rules_sidebar.js", "devtools/server/tests/chrome/test_css-properties.html", "dom/webidl/CSSPositionTryRule.webidl", "layout/inspector/tests/test_bug877690.html", "layout/reftests/async-scrolling/reftest.list", "layout/reftests/scrolling/reftest.list", "layout/reftests/transform/reftest.list", "layout/style/GenerateCSSProperties.py", "layout/style/test/mochitest.toml", "layout/style/test/property_database.js", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/shorthands.toml", "servo/components/style/stylesheets/rule_parser.rs", "servo/components/style/values/generics/length.rs", "servo/components/style/values/generics/position.rs", "servo/components/style/values/specified/align.rs", "servo/components/style/values/specified/calc.rs", "servo/components/style/values/specified/length.rs", "servo/components/style/values/specified/position.rs", "testing/web-platform/meta/__dir__.ini", "testing/web-platform/meta/css/__dir__.ini"], "git_node": "485d39aa1fc46e8d9b203912fe0a67449011a883", "git_parents": ["755cab013ee26b12b0e760127be8443ef6422cda"], "node": "edec3e60a40a10bbd6cbaec92282759a5fafb783", "parents": ["22b400e0a0fbdf37a6788bc5050e309d43aa65bd"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052257 - Add pref to control share button in urlbar r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316134\n", "files": ["browser/app/profile/firefox.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "dad370a0e8ce42b52494e9844ef9673316e4786f", "git_parents": ["485d39aa1fc46e8d9b203912fe0a67449011a883"], "node": "77e542de95823cd3a6fc4c5a526c16e94c1bcd59", "parents": ["edec3e60a40a10bbd6cbaec92282759a5fafb783"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2056615 - List own property names for uncaught non-Error exception objects reported to the console r=spidermonkey-reviewers,jandem\n\nReporting a thrown non-Error object produced the unhelpful bare\n\"uncaught exception: Object\". Build a side-effect-free preview from the\nobject's own string-keyed property names instead, e.g.\n\"uncaught exception: Object (code, message)\".\n\nSince the report string for a thrown object is web-visible through\nwindow.onerror, this is opt-in: a new SniffingBehavior value,\nNoSideEffectsListPropertyNames, enables the preview, and only\nPromise::ReportRejectedPromise uses it, whose report only reaches the\nconsole. window.onerror and the worker error reporting path keep using\nNoSideEffects and are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313315\n", "files": ["dom/promise/Promise.cpp", "js/public/ErrorReport.h", "js/src/jsapi-tests/testPrintError.cpp", "js/src/vm/ErrorObject.cpp", "xpcom/base/CycleCollectedJSContext.cpp"], "git_node": "1720c1c30def0bdd99583dd3b716d16166cfc5d8", "git_parents": ["dad370a0e8ce42b52494e9844ef9673316e4786f"], "node": "eebe25a47cf014b1232d65563ae03e5db7a3832f", "parents": ["77e542de95823cd3a6fc4c5a526c16e94c1bcd59"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 1983119: Remove all security events from legacy telemetry r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D261142\n", "files": ["dom/metrics.yaml", "dom/security/metrics.yaml", "dom/security/test/gtest/TestUnexpectedPrivilegedLoads.cpp", "modules/libpref/metrics.yaml", "modules/libpref/test/browser/browser_sanitization_events.js", "toolkit/components/telemetry/Events.yaml"], "git_node": "0f96e91d3ae1d14f563e1886db8f7b3d9cde3568", "git_parents": ["1720c1c30def0bdd99583dd3b716d16166cfc5d8"], "node": "b017ed1bd0897721861a7c7026013883622e0f23", "parents": ["eebe25a47cf014b1232d65563ae03e5db7a3832f"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056631 - Remove entire canvas_fingerprinting_per_tab metric r=chutten,bvandersloot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313271\n", "files": ["toolkit/components/antitracking/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": 