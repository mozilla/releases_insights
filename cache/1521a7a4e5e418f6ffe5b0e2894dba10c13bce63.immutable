er/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/customizableui/test/browser_uidensity_auto_touch.js", "browser/components/preferences/config/appearance.mjs", "browser/components/preferences/tests/browser_appearance_pane.js"], "git_node": "c40e53e386530673facd0a58f8640163b14afe14", "git_parents": ["e0c09cc29cb8a42b96f7a7c9c7174c899866ac13"], "node": "326876e30314b687574d638ebf3d9b95700f0f06", "parents": ["c1aa2d77fca33f8ea25a918d5aa736a6b31ccdb7"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057614 - Add formatting for EditContext-related types. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314067\n", "files": ["dom/events/TextFormat.cpp", "dom/events/TextFormat.h", "dom/html/EditContext.cpp", "dom/html/EditContext.h"], "git_node": "c2a54d55282b1863bf513e0a83c11f02726c4a0a", "git_parents": ["c40e53e386530673facd0a58f8640163b14afe14"], "node": "23a90b7d0f1d003a88fdb5167c6fb70a37bb6dfc", "parents": ["326876e30314b687574d638ebf3d9b95700f0f06"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974213 - Only allow untrusted schemes in Services.scriptloader.loadSubScript(WithOptions) with an explicit opt-in. r=arai,necko-reviewers,webcompat-reviewers,devtools-reviewers,sync-reviewers,twisniewski,ochameau,jesup,robwu,profiler-reviewers,canova,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313017\n", "files": ["browser/components/places/tests/unit/head_bookmarks.js", "browser/extensions/webcompat/tests/browser/browser_interventions.js", "devtools/client/debugger/test/mochitest/integration/head.js", "devtools/client/shared/test/shared-head.js", "devtools/server/tests/xpcshell/head_dbg.js", "devtools/server/tests/xpcshell/test_setBreakpoint-at-the-beginning-of-a-minified-fn.js", "devtools/server/tests/xpcshell/test_setBreakpoint-at-the-end-of-a-minified-fn.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-column-in-gcd-script.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-column.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-in-gcd-script.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-multiple-offsets.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-multiple-statements.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-no-offsets.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line.js", "devtools/server/tests/xpcshell/test_source-03.js", "devtools/server/tests/xpcshell/test_source-04.js", "dom/indexedDB/test/unit/test_globalObjects_other.js", "dom/localstorage/test/unit/head.js", "dom/quota/test/modules/system/ModuleLoader.sys.mjs", "dom/quota/test/xpcshell/caching/head.js", "dom/quota/test/xpcshell/head.js", "dom/quota/test/xpcshell/telemetry/head.js", "dom/quota/test/xpcshell/upgrades/head.js", "js/xpconnect/idl/mozIJSSubScriptLoader.idl", "js/xpconnect/loader/mozJSSubScriptLoader.cpp", "js/xpconnect/tests/chrome/subscript.js", "js/xpconnect/tests/chrome/test_chrometoSource.xhtml", "js/xpconnect/tests/unit/test_bug451678.js", "js/xpconnect/tests/unit/test_subScriptLoader.js", "modules/libpref/init/StaticPrefList.yaml", "netwerk/test/httpserver/httpd.sys.mjs", "netwerk/test/unit/test_psl.js", "services/sync/tests/unit/head_helpers.js", "services/sync/tps/extensions/tps/resource/tps.sys.mjs", "toolkit/actors/PictureInPictureChild.sys.mjs", "toolkit/components/downloads/test/unit/test_DownloadCore.js", "toolkit/components/downloads/test/unit/test_DownloadLegacy.js", "toolkit/components/extensions/ExtensionCommon.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_domainType.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_dynamic_rules.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_startup_cache.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_static_rules.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_static_rules_limits.js", "toolkit/components/extensions/test/xpcshell/test_ext_dnr_update_static_rules.js", "toolkit/components/extensions/test/xpcshell/test_ext_experiments_console.js", "toolkit/components/places/tests/bookmarks/head_bookmarks.js", "toolkit/components/places/tests/expiration/head_expiration.js", "toolkit/components/places/tests/favicons/head_favicons.js", "toolkit/components/places/tests/history/head_history.js", "toolkit/components/places/tests/legacy/head_legacy.js", "toolkit/components/places/tests/maintenance/head.js", "toolkit/components/places/tests/migration/head_migration.js", "toolkit/components/places/tests/queries/head_queries.js", "toolkit/components/places/tests/sync/head_sync.js", "toolkit/components/places/tests/unit/head_bookmarks.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklist_severities_v2.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_blocklistchange_v2.js", "toolkit/mozapps/extensions/test/xpcshell/rs-blocklist/test_softblocked_v2.js", "toolkit/mozapps/update/tests/data/app_update.sjs", "toolkit/mozapps/update/tests/data/shared.js", "tools/profiler/tests/xpcshell/head.js"], "git_node": "40adcc963c5175b6315226775e28cc51aa6074b2", "git_parents": ["c2a54d55282b1863bf513e0a83c11f02726c4a0a"], "node": "1b78de95f14ad1bfebb9f97b390484d8131c66b4", "parents": ["23a90b7d0f1d003a88fdb5167c6fb70a37bb6dfc"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057249 - Part 1. Allow swizzle to use specific SIMD implementation. r=gfx-reviewers,bradwerth\n\nThis allows us to more easily benchmark different SIMD\nimplementations supported by a platform. This is expected to be\nused for testing only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313794\n", "files": ["gfx/2d/Swizzle.cpp", "gfx/2d/Swizzle.h"], "git_node": "a7af2fec73d438260f06c96c14e30b0ac67763b3", "git_parents": ["40adcc963c5175b6315226775e28cc51aa6074b2"], "node": "255e6555d5d2aa24cc48e7484974938e67ba40aa", "parents": ["1b78de95f14ad1bfebb9f97b390484d8131c66b4"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057249 - Part 2. Add more exhaustive gtests for swizzling. r=gfx-reviewers,lsalzman\n\nThese tests will exercise all of the remainder scenarios, as well\nas more functional coverage between the different formats. It also\nuses the new arch selection to test the fallback and SIMD options\navailable on the host. The new tests can more easily expand as well\nif we have larger batch sizes and/or remainders in the future, i.e.\nwith AVX512.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313795\n", "files": ["gfx/tests/gtest/TestSwizzle.cpp"], "git_node": "7b98822f71a1f862dc937975d02183a60e867139", "git_parents": ["a7af2fec73d438260f06c96c14e30b0ac67763b3"], "node": "b6787fa39fc72d0492b200188d310513cccd1779", "parents": ["255e6555d5d2aa24cc48e7484974938e67ba40aa"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057249 - Part 3. Add scaffolding to allow gtest benchmarks to be cancelled. r=gfx-reviewers,lsalzman\n\nBecause we don't know if the SIMD target is supported until\nruntime, we need to teach MOZ_GTEST_BENCH/MOZ_GTEST_BENCH_F how to\nabandon collecting results. It achieves this by allowing the test\nlambda to return a boolean, where false has it abandon reporting,\nand true continues normally.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313796\n", "files": ["testing/gtest/mozilla/MozGTestBench.cpp", "testing/gtest/mozilla/MozGTestBench.h"], "git_node": "065951ec4eaba333063ebf5c324b74548afb74a6", "git_parents": ["7b98822f71a1f862dc937975d02183a60e867139"], "node": "4e38e23bfac54f3e634d5400a6f2ddb4170454d1", "parents": ["b6787fa39fc72d0492b200188d310513cccd1779"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057249 - Part 4. Add gtest benchmarks for swizzle operations. r=gfx-reviewers,lsalzman\n\nThis includes swizzle, unpack, premultiply and unpremultiply. If a\nparticular SIMD target is unavailable with the current host, or it\nis not implemented yet, it will just silently skip the benchmark.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313797\n", "files": ["gfx/tests/gtest/TestSwizzle.cpp"], "git_node": "aee0923dc2d7270eb361e519f44035f49a563b75", "git_parents": ["065951ec4eaba333063ebf5c324b74548afb74a6"], "node": "207cabb0bc075777565637896f92f09fc2476175", "parents": ["4e38e23bfac54f3e634d5400a6f2ddb4170454d1"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055033: Fix timeout in nova in browser_tab_tooltips.js r=tabbrowser-reviewers,sthompson\n\nWith Nova enabled the close button shape changes, so the , so the\nmouseout landed on the tab content and cancelled the pending tooltip\ntimer before it fired.\n\nAs it turns out, the mouseout is not needed to show the tooltip. I can't\nfind a rationale for why this is needed, and the tests pass without it\n(both variants), so I removed it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314047\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_tab_tooltips.js"], "git_node": "40d485231a7f2c141429ed662c6a3cd63ffe8983", "git_parents": ["aee0923dc2d7270eb361e519f44035f49a563b75"], "node": "85fde499ff7d521060df810da49af9d6ab29c9d1", "parents": ["207cabb0bc075777565637896f92f09fc2476175"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986890 - Show the \"add engine\" badge on the unified search button of the new search bar. r=daleharvey\n\nThe old search bar (browser.search.widget.new=false) badges its search button\nwhen the current page offers an opensearch engine. Do the same for the new\nsearch bar's unified search button, driven from the same OpenSearchManager path\nthat already updates the old search bar.\n\nThe badge is scoped to the search bar; the address bar's unified search button\nstays unbadged, matching the old behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311973\n", "files": ["browser/components/search/OpenSearchManager.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser/searchbar/browser.toml", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_addEngineBadge.js", "browser/themes/shared/urlbar-searchbar.css"], "git_node": "16e8979074c60f9743260cc0cb96f6efac481929", "git_parents": ["40d485231a7f2c141429ed662c6a3cd63ffe8983"], "node": "5278b4c30fe45eb1063264c061d7211d7f727e57", "parents": ["85fde499ff7d521060df810da49af9d6ab29c9d1"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057666 - Add referrals to featureManifest r=emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314117\n", "files": ["toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "a61954fb585c3ebceaf72a361df5ab2fd8c5b9a4", "git_parents": ["16e8979074c60f9743260cc0cb96f6efac481929"], "node": "d804c0aa74be776f720e986cb1ab1a749e10d511", "parents": ["5278b4c30fe45eb1063264c061d7211d7f727e57"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033838 - [tryselect] Allow Git backing repo opt-in to be configurable via env, r=releng-reviewers,bhearsum\n\nPreviously the only way to control it was by overriding\n~/.mozbuild/machrc. This way you can override your default via env for\none off pushes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314019\n", "files": ["tools/tryselect/mach_commands.py"], "git_node": "526646a68248dd69babf659527f8b5bed3065e85", "git_parents": ["a61954fb585c3ebceaf72a361df5ab2fd8c5b9a4"], "node": "b13c0a95adc9f7e09f6681f604c179af2d1fe4dc", "parents": ["d804c0aa74be776f720e986cb1ab1a749e10d511"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057249 - Part 4. Add gtest benchmarks for swizzle operations. r=gfx-reviewers,lsalzman\" for causing build bustages at TestSwizzle.cpp\n\nThis reverts commit aee0923dc2d7270eb361e519f44035f49a563b75.\n\nRevert \"Bug 2057249 - Part 3. Add scaffolding to allow gtest benchmarks to be cancelled. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit 065951ec4eaba333063ebf5c324b74548afb74a6.\n\nRevert \"Bug 2057249 - Part 2. Add more exhaustive gtests for swizzling. r=gfx-reviewers,lsalzman\"\n\nThis reverts commit 7b98822f71a1f862dc937975d02183a60e867139.\n\nRevert \"Bug 2057249 - Part 1. Allow swizzle to use specific SIMD implementation. r=gfx-reviewers,bradwerth\"\n\nThis reverts commit a7af2fec73d438260f06c96c14e30b0ac67763b3.\n", "files": ["gfx/2d/Swizzle.cpp", "gfx/2d/Swizzle.h", "gfx/tests/gtest/TestSwizzle.cpp", "testing/gtest/mozilla/MozGTestBench.cpp", "testing/gtest/mozilla/MozGTestBench.h"], "git_node": "a83008e3f985343923bfd19e08b59bfb0d7954fc", "git_parents": ["526646a68248dd69babf659527f8b5bed3065e85"], "node": "124866bb1b73983df8e23458551565d29bd61669", "parents": ["b13c0a95adc9f7e09f6681f604c179af2d1fe4dc"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054548 - Make sure ThemesList.sys.mjs handle gracefully AMO-hosted theme install failures. r=willdurand,desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312965\n", "files": ["browser/themes/ThemesList.sys.mjs", "browser/themes/test/unit/test_ThemesList.js"], "git_node": "e93107a188c9da5a3ed537a0f9299881e30dc188", "git_parents": ["a83008e3f985343923bfd19e08b59bfb0d7954fc"], "node": "90cb1ac0aaa1095cbf352ded1c9bf8690908a9c1", "parents": ["124866bb1b73983df8e23458551565d29bd61669"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054548 - Add a moz-messagebar to be shown on addons-themes-picker install errors. r=willdurand,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312966\n", "files": ["toolkit/locales-preview/nova-aboutAddons.ftl", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-picker.css", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-picker.mjs", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js"], "git_node": "82d29f8c940f08a0e036e5bb5709d8b8599896cc", "git_parents": ["e93107a188c9da5a3ed537a0f9299881e30dc188"], "node": "7ed6a8a8dfc955bc692082a32dfccba64017e6a8", "parents": ["90cb1ac0aaa1095cbf352ded1c9bf8690908a9c1"], "tags": []}, {"author": "Titouan Thibaud \u003ctthibaud@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057223 - Start the nightly 155 development cycle. r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313716\n", "files": ["mobile/android/android-components/docs/changelog.md"], "git_node": "e704a06aed95688905aabe64e322a6f77910077f", "git_parents": ["82d29f8c940f08a0e036e5bb5709d8b8599896cc"], "node": "6af5feb65835978a36121ce134ede94d110daa00", "parents": ["7ed6a8a8dfc955bc692082a32dfccba64017e6a8"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 2039314 - Make cryptbase.dll pre-emptive loading parent process only. r=glandium\n\nIt is now either no longer needed in child processes or is loaded after the\nsandbox is lowered, guaranteeing PreferSystem32Images.\nThis includes a delay load of advapi32.dll for nss libraries, in particular\nfreebl3.dll. This is because RtlGenRandom (SystemFunction036) is a forwarded\nexport to cryptbase.dll and is still used as a fallback for ProcessPrng on older\nversions of windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313445\n", "files": ["browser/app/nsBrowserApp.cpp", "mozglue/misc/WindowsDllMain.cpp", "mozglue/misc/moz.build", "security/moz.build"], "git_node": "a86ff5efe7e90561f57bf350d2ad96db53112824", "git_parents": ["e704a06aed95688905aabe64e322a6f77910077f"], "node": "c121518eefe1efbf6ae172082b4a931a06bc7f33", "parents": ["6af5feb65835978a36121ce134ede94d110daa00"], "tags": []}, {"author": "Diego Escalante \u003cdescalante@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038940 - Enable advanced css attr by default in all channels. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313584\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "f4b9aefd3443240e777a70a3a2a312a2546df915", "git_parents": ["a86ff5efe7e90561f57bf350d2ad96db53112824"], "node": "562ef9b888015813b9ecbcec133644bb621daebb", "parents": ["c121518eefe1efbf6ae172082b4a931a06bc7f33"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054762 - Make about:privatebrowsing promo tests handle both nova states. r=manuel\n\nThe private browsing newtab tests hardcoded the legacy promo markup and so\nfailed with browser.nova.enabled=true, which renders the Nova \u003cmoz-promo\u003e\nlayout instead. Add pref-aware promo helpers to head.js and update the affected\ntests to assert against whichever layout is active, so coverage is retained for\nboth nova on and off.\n\nAlso make renderPromo's resolvePromoText tolerate a missing Fluent message\ninstead of throwing: under automation formatValue throws for a missing message,\nwhich aborted the Nova promo render before its call-to-action click handler was\nattached. The legacy layout renders nothing for a missing message, so match\nthat behaviour.\n\nSince these tests now pass with nova enabled, remove the nova skip-if rules\nadded in bug 2057902 for the tests fixed here (bugs 2057852, 2057929, 2057936,\n2057937 and, for the promo tests, 2058023). This re-enables the coverage those\nrules disabled.\n\nbrowser_privatebrowsing_indicator.js keeps its nova skip: it asserts on the\nlegacy .private-browsing-indicator-with-label element, which nova hides in\nfavour of the icon-only .private-browsing-indicator-button. That needs the same\npref-aware treatment and is tracked separately in bug 2058023.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312721\n", "files": ["browser/components/privatebrowsing/content/aboutPrivateBrowsing.js", "browser/components/privatebrowsing/test/browser/browser.toml", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_cookie_banners_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_default_pin_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_default_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_nimbus_dismiss.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_nimbus_impressions.js", "browser/components/privatebrowsing/test/browser/head.js"], "git_node": "09505c999483d20722dcdb178e534b456aca9c09", "git_parents": ["f4b9aefd3443240e777a70a3a2a312a2546df915"], "node": "1b3d2e955cf38ca7e1323a6417263003fff3ff9d", "parents": ["562ef9b888015813b9ecbcec133644bb621daebb"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Inject a currentTimeMillis provider into classes r=android-reviewers,mcarare\n\nRoute direct System.currentTimeMillis() calls in android-components and fenix classes through an\ninjectable currentTimeMillis provider defaulted in the primary constructor, the form accepted by the\nNoSystemCurrentTimeMillis lint check, and drop the corresponding baseline entries. Also removes a\nstale baseline entry for a since-deleted file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312358\n", "files": ["mobile/android/android-components/components/browser/storage-sync/lint-baseline.xml", "mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/PlacesHistoryStorage.kt", "mobile/android/android-components/components/feature/accounts-push/lint-baseline.xml", "mobile/android/android-components/components/feature/accounts-push/src/main/java/mozilla/components/feature/accounts/push/FxaPushSupportFeature.kt", "mobile/android/android-components/components/feature/pwa/lint-baseline.xml", "mobile/android/android-components/components/feature/pwa/src/main/java/mozilla/components/feature/pwa/ManifestStorage.kt", "mobile/android/android-components/components/feature/pwa/src/main/java/mozilla/components/feature/pwa/WebAppShortcutManager.kt", "mobile/android/android-components/components/feature/pwa/src/main/java/mozilla/components/feature/pwa/WebAppUseCases.kt", "mobile/android/android-components/components/feature/session/lint-baseline.xml", "mobile/android/android-components/components/feature/session/src/main/java/mozilla/components/feature/session/SessionUseCases.kt", "mobile/android/android-components/components/feature/session/src/main/java/mozilla/components/feature/session/engine/EngineViewPresenter.kt", "mobile/android/android-components/components/feature/session/src/main/java/mozilla/components/feature/session/middleware/LastAccessMiddleware.kt", "mobile/android/android-components/components/feature/sitepermissions/lint-baseline.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/java/mozilla/components/feature/sitepermissions/SitePermissionsFeature.kt", "mobile/android/android-components/components/feature/tab-collections/lint-baseline.xml", "mobile/android/android-components/components/feature/tab-collections/src/main/java/mozilla/components/feature/tab/collections/TabCollectionStorage.kt", "mobile/android/android-components/components/feature/tabs/lint-baseline.xml", "mobile/android/android-components/components/feature/tabs/src/main/java/mozilla/components/feature/tabs/TabsUseCases.kt", "mobile/android/android-components/components/lib/crash/lint-baseline.xml", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/handler/ExceptionHandler.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/service/MozillaSocorroService.kt", "mobile/android/android-components/components/service/firefox-accounts/lint-baseline.xml", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/SyncAuthInfoCache.kt", "mobile/android/android-components/components/service/pocket/lint-baseline.xml", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/infobanner/InfoBanner.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/LensImageUploader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/NotificationManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/bookmarks/BookmarksUseCase.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/share/QRCodeDownloader.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/historymetadata/HistoryMetadataService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/recentsyncedtabs/RecentSyncedTabFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/IPProtectionManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/shortcut/PwaOnboardingObserver.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizationTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/controller/TabManagerController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/telemetry/TelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/termsofuse/TermsOfUseManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/termsofuse/store/PrivacyNoticeBannerRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/whatsnew/WhatsNew.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/whatsnew/WhatsNewStorage.kt"], "git_node": "fdbfe93ba5f164bc2dccf36a15f146bcb791ecfc", "git_parents": ["09505c999483d20722dcdb178e534b456aca9c09"], "node": "cd5624cb77835f410cda1541825f21e19088ac6d", "parents": ["1b3d2e955cf38ca7e1323a6417263003fff3ff9d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Inject a currentTimeMillis parameter into top-level functions r=android-reviewers,mcarare\n\nRoute direct System.currentTimeMillis() calls in top-level functions through an injectable default\nparameter, the form accepted by the NoSystemCurrentTimeMillis lint check, and drop the corresponding\nbaseline entries. One-shot functions take a Long value default matching existing convention, while\nfunctions that read the clock repeatedly take a () -\u003e Long provider.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312359\n", "files": ["mobile/android/android-components/components/browser/state/lint-baseline.xml", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/TabSessionState.kt", "mobile/android/android-components/components/compose/base/lint-baseline.xml", "mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/modifier/Modifier.kt", "mobile/android/android-components/components/service/firefox-relay/lint-baseline.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/java/mozilla/components/service/fxrelay/eligibility/ext/RelayState.kt", "mobile/android/android-components/components/service/pocket/lint-baseline.xml", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/ext/PocketStory.kt", "mobile/android/android-components/components/support/ktx/lint-baseline.xml", "mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/android/net/Uri.kt", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/crashtools/CrashTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/tabs/TabGroupTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/tabs/TabTools.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/SetToDefaultPromptRequest.kt"], "git_node": "2f816fb61462e758422f55a4c6f8eae675775e67", "git_parents": ["fdbfe93ba5f164bc2dccf36a15f146bcb791ecfc"], "node": "4d95c3d9d36059f34303eecd3a587b01f01d6afa", "parents": ["cd5624cb77835f410cda1541825f21e19088ac6d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Relocate currentTimeMillis providers into constructors r=android-reviewers,mcarare\n\nMove the System.currentTimeMillis() default out of the injectable provider property initializer and\ninto a primary-constructor parameter default, the form accepted by the NoSystemCurrentTimeMillis lint\ncheck, while keeping the existing mutable test seam intact.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312360\n", "files": ["mobile/android/android-components/components/feature/top-sites/lint-baseline.xml", "mobile/android/android-components/components/feature/top-sites/src/main/java/mozilla/components/feature/top/sites/PinnedSiteStorage.kt", "mobile/android/android-components/components/support/base/lint-baseline.xml", "mobile/android/android-components/components/support/base/src/main/java/mozilla/components/support/base/ids/SharedIds.kt"], "git_node": "c205c10dd1047185174b1b4a7a83c3f539b15341", "git_parents": ["2f816fb61462e758422f55a4c6f8eae675775e67"], "node": "8a669d3b3d6b59ed7863eec691170d9ef631c0fa", "parents": ["4d95c3d9d36059f34303eecd3a587b01f01d6afa"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Suppress NoSystemCurrentTimeMillis on the DateTimeProvider implementation r=android-reviewers,mcarare\n\nDefaultDateTimeProvider is the sanctioned wrapper around System.currentTimeMillis() that exists so\nthe clock can be injected everywhere else, so annotate its override with a justified suppression\nrather than routing it through yet another provider.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312361\n", "files": ["mobile/android/android-components/components/support/utils/lint-baseline.xml", "mobile/android/android-components/components/support/utils/src/main/java/mozilla/components/support/utils/DateTimeProvider.kt"], "git_node": "1ab6874ef88749e2b9a3c8502f8e17f4159d713c", "git_parents": ["c205c10dd1047185174b1b4a7a83c3f539b15341"], "node": "00d265828f91ec16ca6187af3cf166b1bbf26125", "parents": ["8a669d3b3d6b59ed7863eec691170d9ef631c0fa"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Move the impression timestamp default into the entity constructor r=android-reviewers,mcarare\n\nRelocate SponsoredContentImpressionEntity.impressionDateInSeconds from a body-property initializer to\na primary-constructor parameter default, the form accepted by the NoSystemCurrentTimeMillis lint\ncheck. This pulls the field into the data class's generated equals/copy, so SponsoredContentsRepositoryTest\nnow compares recorded impressions by url rather than by whole-entity equality, which would otherwise\ndepend on which wall-clock second the entities were constructed. Room still populates the column via\nthe constructor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312362\n", "files": ["mobile/android/android-components/components/service/pocket/lint-baseline.xml", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/mars/db/SponsoredContentImpressionEntity.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/mars/SponsoredContentsRepositoryTest.kt"], "git_node": "271c68706127bcebd8c2acc58e062e9b3b0b07fa", "git_parents": ["1ab6874ef88749e2b9a3c8502f8e17f4159d713c"], "node": "e34d0be9816b0d65125ea5fa48bf061ef2b0fe2f", "parents": ["00d265828f91ec16ca6187af3cf166b1bbf26125"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Restructure object and companion members r=android-reviewers,mcarare\n\nObject, companion, and singleton members give the lint check no constructor or top-level function to\nattach an injectable default to. Move each System.currentTimeMillis() into an accepted form: a\ntop-level bundle-reading helper for the Crash companion factories, a constructor-defaulted\nDefaultStartTimeProvider class in place of the object, and an AnnouncementDebouncer class backing\nAccessibilityUtils.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312363\n", "files": ["mobile/android/android-components/components/lib/crash/lint-baseline.xml", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/Crash.kt", "mobile/android/android-components/components/lib/crash/src/main/java/mozilla/components/lib/crash/runtimetagproviders/EnvironmentRuntimeProvider.kt", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/AccessibilityUtils.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/AnnouncementDebouncerTest.kt"], "git_node": "001c05b36f282bcbb5a1546a71d9d685990d0558", "git_parents": ["271c68706127bcebd8c2acc58e062e9b3b0b07fa"], "node": "6bf269fff59436d67bdf1fe5e3b280c88e65ac1a", "parents": ["e34d0be9816b0d65125ea5fa48bf061ef2b0fe2f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Drop method-parameter clock defaults from repository interfaces r=android-reviewers,mcarare\n\nThe lint check only accepts a System.currentTimeMillis() default on a top-level function or a class\nconstructor, not on interface methods. Remove the current-time defaults from the PrivacyNoticeBanner,\nTermsOfUsePrompt, and onboarding terms-of-service interfaces and have their implementations read the\ntime from an injected constructor provider instead. Production callers already invoke these with no\nargument; the affected tests inject a fixed clock through the constructor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312364\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/DefaultOnboardingTermsOfServiceEventHandler.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPageState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/termsofuse/store/PrivacyNoticeBannerRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/termsofuse/store/TermsOfUsePromptRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/DefaultOnboardingTermsOfServiceEventHandlerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/termsofuse/FakeTermsOfUsePromptRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/termsofuse/store/PrivacyNoticeBannerMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/termsofuse/store/TermsOfUsePromptRepositoryTest.kt"], "git_node": "8e2d10312e7997d59ab39761bbfba6298049132a", "git_parents": ["001c05b36f282bcbb5a1546a71d9d685990d0558"], "node": "7f57ddd8d1959556fea78538419e05e4209560b0", "parents": ["6bf269fff59436d67bdf1fe5e3b280c88e65ac1a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Drop method-parameter clock defaults for bookmarks, site permissions, and impressions r=android-reviewers,mcarare\n\nThe lint check does not accept a System.currentTimeMillis() default on interface, Dao, or data-class\nmethods. The sponsored-content impressions Dao now takes the timestamp explicitly, since its one\nproduction caller already supplies it. SitePermissions gains a savedAt constructor default, so both\nSitePermissionsRules.toSitePermissions and SitePermissionsFeature can drop their own clocks, and\nBookmarksStorage.getRecentBookmarks drops its currentTime parameter while PlacesBookmarksStorage\nreads its injected constructor clock instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312365\n", "files": ["mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/PlacesBookmarksStorage.kt", "mobile/android/android-components/components/browser/storage-sync/src/test/java/mozilla/components/browser/storage/sync/PlacesBookmarksStorageTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/permission/SitePermissions.kt", "mobile/android/android-components/components/concept/storage/lint-baseline.xml", "mobile/android/android-components/components/concept/storage/src/main/java/mozilla/components/concept/storage/BookmarksStorage.kt", "mobile/android/android-components/components/feature/awesomebar/src/test/java/mozilla/components/feature/awesomebar/provider/BookmarksStorageSuggestionProviderTest.kt", "mobile/android/android-components/components/feature/sitepermissions/lint-baseline.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/java/mozilla/components/feature/sitepermissions/SitePermissionsFeature.kt", "mobile/android/android-components/components/feature/sitepermissions/src/main/java/mozilla/components/feature/sitepermissions/SitePermissionsRules.kt", "mobile/android/android-components/components/feature/sitepermissions/src/test/java/mozilla/components/feature/sitepermissions/SitePermissionsRulesTest.kt", "mobile/android/android-components/components/service/pocket/lint-baseline.xml", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/mars/db/SponsoredContentsDao.kt", "mobile/android/android-components/components/service/pocket/src/test/java/mozilla/components/service/pocket/mars/db/SponsoredContentsDaoTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/bookmarks/BookmarksUseCaseTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/fake/FakeBookmarksStorage.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/trustpanel/TrustPanelMiddlewareTest.kt"], "git_node": "3dfc66f569cabbfef42f4a516f7a7e7d0c0b8a6b", "git_parents": ["8e2d10312e7997d59ab39761bbfba6298049132a"], "node": "fd775ec088a342fa2cca2a0b74ff61246d0d1b8c", "parents": ["7f57ddd8d1959556fea78538419e05e4209560b0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Record activity timestamps through Settings r=android-reviewers,mcarare\n\nFragments cannot take an injectable constructor parameter because the framework instantiates them\nreflectively. Move the `settings.\u003ctimestamp\u003e = System.currentTimeMillis()` stamps out of\nBrowserFragment, HomeFragment, and OnboardingFragment into Settings recorder methods that use the\nclock Settings already holds in its constructor, so the call sites carry no direct clock read.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312366\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/browser/BrowserFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "0f7aded49cd3dc8bd64d783fca84bcc1e02e2238", "git_parents": ["3dfc66f569cabbfef42f4a516f7a7e7d0c0b8a6b"], "node": "10013dadf42d7c680a570ddad648b9d090f13ab1", "parents": ["fd775ec088a342fa2cca2a0b74ff61246d0d1b8c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Default the sync last-synced timestamp r=android-reviewers,mcarare\n\nThe sync worker and the account-settings observer are framework-instantiated and can't inject a\nclock. Give the top-level setLastSynced() a current-time default so both drop their direct\nSystem.currentTimeMillis() reads, and route the worker's stagger-buffer check and timestamp store\nthrough top-level helpers with the same default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312367\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/lint-baseline.xml", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/WorkManagerSyncManagerTest.kt", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountSettingsFragment.kt"], "git_node": "4668a5577ecb26091f5615c051655da0871eda2a", "git_parents": ["0f7aded49cd3dc8bd64d783fca84bcc1e02e2238"], "node": "3710c98efd9978951655dd3442fd6920961114a8", "parents": ["10013dadf42d7c680a570ddad648b9d090f13ab1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Extract framework-class time cutoffs to top-level functions r=android-reviewers,mcarare\n\nFenixApplication and GrowthDataWorker are framework-instantiated, so their time-based cutoffs move\ninto top-level functions with a current-time default parameter: historyMetadataCleanupCutoff() for\nthe history-metadata cleanup age, and isAfterFirstWeekFromInstall() for the growth-data first-week\ncheck.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312368\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/GrowthDataWorker.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/GrowthDataWorkerTest.kt"], "git_node": "077889fc7cd7d88f2b0572d3ff3ebda9c646c1e0", "git_parents": ["4668a5577ecb26091f5615c051655da0871eda2a"], "node": "121cd0f9c897087e5840b59536aafe2b2655f943", "parents": ["3710c98efd9978951655dd3442fd6920961114a8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Suppress NoSystemCurrentTimeMillis in sample apps r=android-reviewers,mcarare\n\nThe browser and sync sample apps reach System.currentTimeMillis() through framework entry points (an\nApplication.onCreate and a lazily-built FxaAccountManager) that offer no injectable clock seam and no\ntime-dependent behavior worth testing. Annotate both with a justified suppression rather than\nrestructuring sample-only code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312369\n", "files": ["mobile/android/android-components/samples/browser/lint-baseline.xml", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/SampleApplication.kt", "mobile/android/android-components/samples/sync/src/main/java/org/mozilla/samples/sync/MainActivity.kt"], "git_node": "da4924962d93d8174503e209962b4056205da6f9", "git_parents": ["077889fc7cd7d88f2b0572d3ff3ebda9c646c1e0"], "node": "548516b47e8d4a0ee3c49e11291eb77bb3a32dca", "parents": ["121cd0f9c897087e5840b59536aafe2b2655f943"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055298 - Suppress NoSystemCurrentTimeMillis for the capture-image filename r=android-reviewers,mcarare\n\nLensCameraFragment uses System.currentTimeMillis() only to make a captured-image filename unique;\nthere is no time-dependent behavior to test, so the call is annotated with a justified suppression\nrather than injected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312370\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/lens/LensCameraFragment.kt"], "git_node": "4b4ed5d5a6a3602c8ff8be308292a11105662092", "git_parents": ["da4924962d93d8174503e209962b4056205da6f9"], "node": "d45e17686707d9f89e33bf1f0594112ff3bfaabc", "parents": ["548516b47e8d4a0ee3c49e11291eb77bb3a32dca"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054505 - Add quality filters and a clustering timeout to Auto Tab Grouping r=desktop-theme-reviewers,fluent-reviewers,mlucks,bolsson,dao,sthompson\n\nBuilding Auto Tab Grouping 'v0' - largely exploratory and gated behind a pref\nNo finalized designs yet, but there is a demo: https://auto-tab-grouping.netlify.app sw0626\n\nbrowser.smartwindow.autoTabGrouping.enabled\nSmartTabGroupingManager.isEnabled\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312313\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js"], "git_node": "44217d517880e831f415e2b833b3b6400603acce", "git_parents": ["4b4ed5d5a6a3602c8ff8be308292a11105662092"], "node": "6f49bc5e66af2755f7c3b17cc11d6610e44a4634", "parents": ["d45e17686707d9f89e33bf1f0594112ff3bfaabc"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054506 - Add a recent-groups list with ungroup and telemetry to Auto Tab Grouping r=desktop-theme-reviewers,tabbrowser-reviewers,fluent-reviewers,omarg,bolsson,sthompson,dao,rrando\n\nBuilding Auto Tab Grouping 'v0' - largely exploratory and gated behind a pref\nNo finalized designs yet, but there is a demo: https://auto-tab-grouping.netlify.app sw0626\n\nbrowser.smartwindow.autoTabGrouping.enabled\nSmartTabGroupingManager.isEnabled\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312523\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js", "browser/components/tabbrowser/TabMetrics.sys.mjs", "browser/locales-preview/autoTabGrouping.ftl", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "509835a8299d0ea5260c0904892dd89a297c17ea", "git_parents": ["44217d517880e831f415e2b833b3b6400603acce"], "node": "9c7f6e806795346d8eb5a8e55bf1fca295e90305", "parents": ["6f49bc5e66af2755f7c3b17cc11d6610e44a4634"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2056627 - Invalidate tiles that intersects with cancelled underlays r=gfx-reviewers,nical\n\nWhen underlay is cancelled, it is necessary to invalidate intersected tiles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313942\n", "files": ["gfx/wr/webrender/src/invalidation/mod.rs", "gfx/wr/webrender/src/tile_cache/mod.rs"], "git_node": "bd3be7b65450e0efc9d1f084325fdfccd16cf27f", "git_parents": ["509835a8299d0ea5260c0904892dd89a297c17ea"], "node": "3d8e4d994b597b0570d19c857006f98ad04c2255", "parents": ["9c7f6e806795346d8eb5a8e55bf1fca295e90305"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2058142 - Add no-nova extra option when running with nova disabled. r=aryx,perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314358\n", "files": ["testing/raptor/browsertime/support-scripts/speedometer3.py", "testing/talos/talos/run_tests.py"], "git_node": "edbbfac9f5973ed84a831a110683903cbf3ee293", "git_parents": ["bd3be7b65450e0efc9d1f084325fdfccd16cf27f"], "node": "fde521858b3dbf21fdd05396c344d75603baa778", "parents": ["3d8e4d994b597b0570d19c857006f98ad04c2255"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1986890 - Show the \"add engine\" badge on the unified search button of the new search bar. r=daleharvey\" for causing doc generate failures\n\nThis reverts commit 16e8979074c60f9743260cc0cb96f6efac481929.\n", "files": ["browser/components/search/OpenSearchManager.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser/searchbar/browser.toml", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_addEngineBadge.js", "browser/themes/shared/urlbar-searchbar.css"], "git_node": "16a3d8ab97fefe664b3a53002fbadff1827d1d9e", "git_parents": ["edbbfac9f5973ed84a831a110683903cbf3ee293"], "node": "8023695482176b2a3646a8ff5835819eddb7a8b8", "parents": ["fde521858b3dbf21fdd05396c344d75603baa778"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053739 - Auto-enter touch density in tablet mode for the Automatic window density, and default touch spacing off for nova r=firefox-desktop-core-reviewers ,sthompson,hjones,Gijs\" for failures on browser_970511_undo_restore_default.\n\nThis reverts commit c40e53e386530673facd0a58f8640163b14afe14.\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser.js", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_customizemode_uidensity.js", "browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/customizableui/test/browser_uidensity_auto_touch.js", "browser/components/preferences/config/appearance.mjs", "browser/components/preferences/tests/browser_appearance_pane.js"], "git_node": "0cf395b8f72c72ccbdc6c1388d516762dd931426", "git_parents": ["16a3d8ab97fefe664b3a53002fbadff1827d1d9e"], "node": "c496ec54ac805d51ed4d747372becf6f39aa29a3", "parents": ["8023695482176b2a3646a8ff5835819eddb7a8b8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057406 - Annotate another passing test.\n\nSigned-off-by: Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e\n", "files": ["testing/web-platform/meta/css/css-properties-values-api/typedom.html.ini"], "git_node": "d9ae14cdde8979a41e08b88316bd833ff68179a7", "git_parents": ["0cf395b8f72c72ccbdc6c1388d516762dd931426"], "node": "400c59b20c44253540643caf32e3b19a14df30f6", "parents": ["c496ec54ac805d51ed4d747372becf6f39aa29a3"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056505: Fix smart window switcher on overflow menu r=desktop-theme-reviewers,echa,dao\n\nThe window switcher was not looking right when added to the overflow menu and also didn't open its panel.\nNow its padding, box shadow and border is restricted to when it's on a toolbar, and the customizable UI sees it as a view rather than a button to make sure the panel opens.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313776\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/themes/shared/browser-shared.css", "browser/themes/shared/customizableui/customizeMode.css"], "git_node": "cbd76fb96fc7c901ef3c043a550b219c19b59530", "git_parents": ["d9ae14cdde8979a41e08b88316bd833ff68179a7"], "node": "ea33f0230742f9b91f3a9c8ab5084fcb0927fb8a", "parents": ["400c59b20c44253540643caf32e3b19a14df30f6"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057583 - Increase referral code length r=fterdal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314028\n", "files": ["browser/components/referrals/Referrals.sys.mjs", "browser/components/referrals/tests/unit/test_referralCode.js"], "git_node": "dde5219858fa3baf610c4a1e525349b9a27ee985", "git_parents": ["cbd76fb96fc7c901ef3c043a550b219c19b59530"], "node": "320f9493006983ea21cfb32184276f9e27390c34", "parents": ["ea33f0230742f9b91f3a9c8ab5084fcb0927fb8a"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055469, add ML model version number to address autofill telemetry, and add ml reason for each field, r=dimi,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312483\n", "files": ["browser/extensions/formautofill/test/browser/browser_ml_heuristics.js", "toolkit/components/formautofill/metrics.yaml", "toolkit/components/formautofill/shared/AutofillTelemetry.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillML.sys.mjs"], "git_node": "c03ff4fbce401186ee726825d73922d2075f476e", "git_parents": ["dde5219858fa3baf610c4a1e525349b9a27ee985"], "node": "8685d202e0014f8b7dd6542baaa2193b8b8903bd", "parents": ["320f9493006983ea21cfb32184276f9e27390c34"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058080 - Avoid using combined depth stencil buffer if only depth or stencil buffer is requested. r=gfx-reviewers,nical\n\nOn Metal ANGLE we have observed a requested GL_DEPTH24_STENCIL8 format\nactually results in MTLPixelFormat.depth32Float_Stencil8 being used,\nrather than MTLPixelFormat.depth24Unorm_Stencil8. This is because\nMTLDevice.isDepth24Stencil8PixelFormatSupported returns false on both\nthe Intel and Apple silicon GPUs that were tested.\n\nThis results in more memory being used, even in cases where no stencil\nbuffer was actually requested. To avoid this, only use the combined\ndepth stencil format when both a depth and stencil buffer are actually\nrequested.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314319\n", "files": ["dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLFramebuffer.cpp", "gfx/gl/GLContext.cpp", "gfx/gl/MozFramebuffer.cpp", "gfx/gl/MozFramebuffer.h", "gfx/gl/SharedSurfaceAndroidHardwareBuffer.cpp", "gfx/gl/SharedSurfaceD3D11Interop.cpp", "gfx/gl/SharedSurfaceDMABUF.cpp", "gfx/gl/SharedSurfaceEGL.cpp", "gfx/gl/SharedSurfaceGL.cpp", "gfx/gl/SharedSurfaceIO.cpp", "gfx/layers/NativeLayerCA.mm", "gfx/layers/NativeLayerWayland.cpp", "gfx/layers/SurfacePoolCA.mm", "gfx/layers/SurfacePoolWayland.cpp"], "git_node": "e90695b590e6c1b2bd08e85ee40aa513dd29069d", "git_parents": ["c03ff4fbce401186ee726825d73922d2075f476e"], "node": "61b025a529d31c346c23d64e3569fe669407ab60", "parents": ["8685d202e0014f8b7dd6542baaa2193b8b8903bd"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058091 - Add inset to complex clip regions. r=gfx-reviewers,nical\n\nAdd a new 'inset' parameter, allowing the correct computation of\ncontoured superellipses needed for CSS corner-shape.\n\nThis patch is just passing down the data everywhere but does not use it,\nthat will come in follow-up patches.\n\nSee bug 2058091 for the rationale behind this new value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314332\n", "files": ["gfx/webrender_bindings/WebRenderTypes.h", "gfx/wr/examples/animation.rs", "gfx/wr/examples/basic.rs", "gfx/wr/webrender/res/gpu_buffer.glsl", "gfx/wr/webrender/res/ps_quad_mask.glsl", "gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/hit_test.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender/src/util.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrench/src/rawtest.rs", "gfx/wr/wrench/src/yaml_helper.rs", "layout/forms/nsFieldSetFrame.cpp"], "git_node": "f5c18dd548968d5d46a0b4a7144bdb94eb4707a2", "git_parents": ["e90695b590e6c1b2bd08e85ee40aa513dd29069d"], "node": "1bcf18a522af876eea6859aa2b36e7abf224d650", "parents": ["61b025a529d31c346c23d64e3569fe669407ab60"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058091 - Add inset to normal borders. r=gfx-reviewers,nical\n\nAdd a new 'inset' parameter, allowing the correct computation of\ncontoured superellipses needed for CSS corner-shape.\n\nThis patch is just passing down the data everywhere but does not use it,\nthat will come in follow-up patches.\n\nSee bug 2058091 for the rationale behind this new value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314333\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/examples/basic.rs", "gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/gpu_types.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/key_types.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs", "layout/tables/nsTableFrame.cpp"], "git_node": "d423bb15253628a22efae05cd53cf4aaa0928d1d", "git_parents": ["f5c18dd548968d5d46a0b4a7144bdb94eb4707a2"], "node": "ecc1b89990879dcffa519dae5bf5bc8f5cfcabd4", "parents": ["1bcf18a522af876eea6859aa2b36e7abf224d650"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058091 - Add inset to display item clips. r=layout-reviewers,emilio\n\nThis adds a new 'inset' value for rounded rect clips, which is necessary\nfor the correct computation of CSS corner-shape contoured paths.\n\nThe new value keeps track of how much a rect was inflated or shrunk compared\nto its original reference, and allows WebRender to correctly compute the\nrelative curve when corners are superellipses.\n\nSee bug 2058091 for a more detailed rationale on the subject.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314334\n", "files": ["layout/generic/nsHTMLCanvasFrame.cpp", "layout/generic/nsIFrame.cpp", "layout/generic/nsIFrame.h", "layout/generic/nsImageFrame.cpp", "layout/generic/nsVideoFrame.cpp", "layout/painting/DisplayItemClip.cpp", "layout/painting/DisplayItemClip.h", "layout/painting/DisplayListClipState.cpp", "layout/painting/DisplayListClipState.h"], "git_node": "4fb0310804c7f2b31c9c1389f343d0558a2a6486", "git_parents": ["d423bb15253628a22efae05cd53cf4aaa0928d1d"], "node": "968a4ad9c66c545dc2a2b74e34b055137f82bee2", "parents": ["ecc1b89990879dcffa519dae5bf5bc8f5cfcabd4"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058091 - Add inset to borders and outlines. r=layout-reviewers,emilio,gfx-reviewers,nical\n\nThis adds a new 'inset' value for borders and outlines, which is necessary\nfor the correct computation of CSS corner-shape contoured paths.\n\nThe new value keeps track of how much a rect was inflated or shrunk compared\nto its original reference, and allows WebRender to correctly compute the\nrelative curve when corners are superellipses.\n\nSee bug 2058091 for a more detailed rationale on the subject.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314335\n", "files": ["layout/painting/nsCSSRendering.cpp", "layout/painting/nsCSSRenderingBorders.cpp", "layout/painting/nsCSSRenderingBorders.h"], "git_node": "0e5ca1cb0710fa3a8c81fc7024c9ff427af8b566", "git_parents": ["4fb0310804c7f2b31c9c1389f343d0558a2a6486"], "node": "3fe6a7b90cb19bfcef6fbaf941f3094137f2bc78", "parents": ["968a4ad9c66c545dc2a2b74e34b055137f82bee2"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058091 - Add inset in clipping and segment building. r=gfx-reviewers,nical\n\nCorners can go further inside the shape when using CSS corner-shape with\nsuperellipse values below 1 (round). This patch handles these new cases\nin segment building and clipping calculations.\n\nSee bug 2058091 for a more detailed rationale on the subject.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314336\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/segment.rs", "gfx/wr/webrender/src/util.rs", "gfx/wr/webrender_api/src/fast_transform.rs"], "git_node": "34bfedc5618e7aa841e046178e9755e1733f4d17", "git_parents": ["0e5ca1cb0710fa3a8c81fc7024c9ff427af8b566"], "node": "57274f1a597a0dd137fae68cd47b836648de9ea2", "parents": ["3fe6a7b90cb19bfcef6fbaf941f3094137f2bc78"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058091 - Add inset to the 9-patch rendering strategy. r=gfx-reviewers,nical\n\nCorners can go further inside the shape when using CSS corner-shape with\nsuperellipse values below 1 (round). This patch handles these new cases\nin the nine-patch rendering strategy.\n\nSee bug 2058091 for a more detailed rationale on the subject.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314337\n", "files": ["gfx/wr/webrender/src/quad.rs"], "git_node": "8585327f5a56b9c68ad44cc0997a18ef0e6bf5af", "git_parents": ["34bfedc5618e7aa841e046178e9755e1733f4d17"], "node": "50f0ccf1b8f52d2bc56b71d30a3df3a7211b470c", "parents": ["57274f1a597a0dd137fae68cd47b836648de9ea2"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058169 - Collapse identical branches in nsCaret::GetGeometryForFrame (Coverity CID 1521542) r=layout-reviewers,emilio\n\nBoth arms of the if (vertical) RTL adjustment ran the same statement.\nCollapse to a single branch; no behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314376\n", "files": ["layout/base/nsCaret.cpp"], "git_node": "cb42a3f6d9a96cc55a55c0887be9e3fcf85e58f2", "git_parents": ["8585327f5a56b9c68ad44cc0997a18ef0e6bf5af"], "node": "c5e3b585f5cc0a421edd31dd88917c67553a2d12", "parents": ["50f0ccf1b8f52d2bc56b71d30a3df3a7211b470c"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056780: Remove WebGL Vendor Randomization from ETP Strict/PBM on Nightly r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313364\n", "files": ["toolkit/components/resistfingerprinting/RFPTargetsDefault.inc"], "git_node": "15ce83a1b8c24ab880309b6ee483f4505fdfe2d7", "git_parents": ["cb42a3f6d9a96cc55a55c0887be9e3fcf85e58f2"], "node": "b4636fc4df566820945334893836066aecb76a71", "parents": ["c5e3b585f5cc0a421edd31dd88917c67553a2d12"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058159 - Stop running servo-tidy on webrender. r=gfx-reviewers,jnicol\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314359\n", "files": ["gfx/wr/servo-tidy.toml", "taskcluster/kinds/webrender/kind.yml", "testing/docs/automated-testing/index.md", "testing/docs/webrender/index.md", "tools/lint/test-manifest-toml.yml"], "git_node": "07493c9a48b3f6037240dede234ef39f2f3ead96", "git_parents": ["15ce83a1b8c24ab880309b6ee483f4505fdfe2d7"], "node": "d0e0760fde66ecc42fbdf9bcc93bef274a3da2e5", "parents": ["b4636fc4df566820945334893836066aecb76a71"], "tags": []}, {"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051698 - Referrals Account page entry point r=fluent-reviewers,desktop-theme-reviewers,nbarrett,bolsson,dao\n\nCreates an entry point to the about:referrals page\nfrom the account page, gated behind the browser.referrals.enabled flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313074\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/logos/share-firefox.svg", "browser/base/jar.mn", "browser/components/referrals/tests/browser/browser.toml", "browser/components/referrals/tests/browser/browser_referralsAccountMenu.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "e6f613e2e36b416dfed0abb9b21dbf548df1139e", "git_parents": ["07493c9a48b3f6037240dede234ef39f2f3ead96"], "node": "6690f2a544afe869b3819c6815430083b61d47d2", "parents": ["d0e0760fde66ecc42fbdf9bcc93bef274a3da2e5"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057797 - [wdspec] Extend timeout for /mozilla/tests/webdriver/classic/execute_async_script/privileged.py. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314331\n", "files": ["testing/web-platform/mozilla/tests/webdriver/classic/execute_async_script/privileged.py"], "git_node": "8cedc0dae4558329e10ff4cfe9e2748821f7fe45", "git_parents": ["e6f613e2e36b416dfed0abb9b21dbf548df1139e"], "node": "f609dbdfdf92b0fb069b1ab29665aa2bfcddd9cf", "parents": ["6690f2a544afe869b3819c6815430083b61d47d2"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056312 - Add Rakuten as a new marketing partner in Adjust. r=android-reviewers,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313222\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/AdjustMetricsService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/AdjustThirdPartySharingController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/InstallReferrerHandlingService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/InstallReferrerWorker.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/AdjustMetricsServiceTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerHandlingServiceTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerWorkerTest.kt"], "git_node": "87876e1d7a03fa92daab916785cbef515f407d7f", "git_parents": ["8cedc0dae4558329e10ff4cfe9e2748821f7fe45"], "node": "c106da79cccc51053530944e8842ee7af5106717", "parents": ["f609dbdfdf92b0fb069b1ab29665aa2bfcddd9cf"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 1980036: Structural changes to tab hover preview to resolve intermittent test failures r=tabbrowser-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313314\n", "files": ["browser/components/tabbrowser/content/tab-hover-preview.mjs", "browser/components/tabbrowser/content/tabs.js", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js"], "git_node": "e5c0252cff0708ebffe03a8ccad5e782971f60c6", "git_parents": ["87876e1d7a03fa92daab916785cbef515f407d7f"], "node": "c5de296cf636d8399b86a395b477141343abb882", "parents": ["c106da79cccc51053530944e8842ee7af5106717"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046406 - Part 3: Allow switching the country r=geckoview-reviewers,jonalmeida\n\nThis patch adds a switchTo function, allowing switching between servers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307045\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/IPProtectionControllerTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/IPProtectionController.java", "mobile/shared/modules/geckoview/GeckoViewIPProtection.sys.mjs"], "git_node": "6f5bb1575822cc37353ee59d203c1b9d97d33da7", "git_parents": ["e5c0252cff0708ebffe03a8ccad5e782971f60c6"], "node": "989d9abaea378e241485bf8730d90486fdfd22b3", "parents": ["c5de296cf636d8399b86a395b477141343abb882"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056571 - Cover case of promise rejection r=acottner,Gijs\n\nTests are shipped in https://phabricator.services.mozilla.com/D314015\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314013\n", "files": ["services/settings/RemoteSettingsClient.sys.mjs"], "git_node": "b638013b451aa04204ba49c294e97bcc056fddd2", "git_parents": ["6f5bb1575822cc37353ee59d203c1b9d97d33da7"], "node": "be2c3ee606d922f3c8acc6390827764942e58f47", "parents": ["989d9abaea378e241485bf8730d90486fdfd22b3"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1980036: Structural changes to tab hover preview to resolve intermittent test failures r=tabbrowser-reviewers,sthompson\" for causing browser_tab_preview.js\n\nThis reverts commit e5c0252cff0708ebffe03a8ccad5e782971f60c6.\n", "files": ["browser/components/tabbrowser/content/tab-hover-preview.mjs", "browser/components/tabbrowser/content/tabs.js", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js"], "git_node": "2979a1c738527af6eda7e5d2b8a734f0b06f217f", "git_parents": ["b638013b451aa04204ba49c294e97bcc056fddd2"], "node": "96ae9592a388ac6a5f2e661e2e21d589ac849ef8", "parents": ["be2c3ee606d922f3c8acc6390827764942e58f47"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1958705 - Avoid quadratic scans of the adopted stylesheet list when adopting sheets. r=emilio,firefox-style-system-reviewers\n\nConstructing and adopting N constructed stylesheets is quadratic,\nbecause two paths ask \"does this tree adopt this sheet\" by scanning the\ntree's whole adopted stylesheet list.\n\nThis switches between the adopter and the tree list in order to make\nthis cheaper in most cases.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313031\n", "files": ["dom/base/DocumentOrShadowRoot.cpp", "layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h"], "git_node": "4b26ac1c3f3e49de29abb5c0aed914ee39369810", "git_parents": ["2979a1c738527af6eda7e5d2b8a734f0b06f217f"], "node": "8e22e3d7affe007845da3d50d2ef099c81c25da1", "parents": ["96ae9592a388ac6a5f2e661e2e21d589ac849ef8"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056919 - Narrow setting-pane search fallback to header and non-group content r=mstriemer\n\nPreviously the fallback searched the entire pane again when no setting-group matched, which walked every group already searched in the first pass. The fallback now only targets the pane's page header and any non-group content (currently the Firefox Labs pane's description), which are the only elements the fallback needs to cover. The two targets run in parallel via Promise.all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313489\n", "files": ["browser/components/preferences/findInPage.js", "browser/components/preferences/tests/searchResults/browser-srd.toml", "browser/components/preferences/tests/searchResults/browser_search_results_fallback.js"], "git_node": "58e124faca2c0043948160ed2357084a49545216", "git_parents": ["4b26ac1c3f3e49de29abb5c0aed914ee39369810"], "node": "cea47a963d3c088685f7d4dea45af896399e4d87", "parents": ["8e22e3d7affe007845da3d50d2ef099c81c25da1"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058160 - Enable media session notification improvements in Beta. r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314364\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml"], "git_node": "a8a0c511043792f2dabe8c373aafbced8cdbd9d9", "git_parents": ["58e124faca2c0043948160ed2357084a49545216"], "node": "ad3491be5df65c03c238a289500ed30a87613827", "parents": ["cea47a963d3c088685f7d4dea45af896399e4d87"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046861 - Reject InferenceSession.create() on a native session-create failure instead of crashing r=ai-platform-reviewers,valentinp\n\nWhen onnxruntime's CreateSessionFromArray fails (an out-of-memory\ncondition, or a malformed/unsupported model), InferenceSession::Init\ncalled MOZ_CRASH, taking down the whole inference content process. That\nturns a recoverable runtime error into a crash and, because the process\ndies first, prevents JS callers from using the fallback they already\nhave (best-onnx retrying on the wasm backend in MLEngineChild).\n\nReject the promise with the onnxruntime error message instead, matching\nhow the missing-library case a few lines up is already handled.\n\nmach try (all green): https://treeherder.mozilla.org/jobs?repo=try&revision=96f338c920471bae16a3d3c2bff533aac0224cfa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313108\n", "files": ["dom/onnx/InferenceSession.cpp", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_inference_session_error.js", "toolkit/components/ml/tests/browser/ml_inference_session_error_stub.worker.mjs"], "git_node": "20b5fa4084ac135332b025d3a73066f34a275b9d", "git_parents": ["a8a0c511043792f2dabe8c373aafbced8cdbd9d9"], "node": "507de5c66b0db1f90560276a5122357810f31605", "parents": ["ad3491be5df65c03c238a289500ed30a87613827"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058063 - remove the webcompat addon's getReleaseBranch experimental API; r=ksenia,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314384\n", "files": ["browser/extensions/webcompat/experiment-apis/appConstants.js", "browser/extensions/webcompat/experiment-apis/appConstants.json", "browser/extensions/webcompat/lib/logging.js", "browser/extensions/webcompat/lib/shims.js", "browser/extensions/webcompat/manifest.json"], "git_node": "0039bec640ddc22c9feb63050fb2767f23c911b6", "git_parents": ["20b5fa4084ac135332b025d3a73066f34a275b9d"], "node": "1bb30c03a13eda2b6355b81d7392afe7181d8005", "parents": ["507de5c66b0db1f90560276a5122357810f31605"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054595 - Nova redesign for (blocked) Download details panel r=desktop-theme-reviewers,mak,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312780\n", "files": ["browser/themes/shared/downloads/downloads.inc.css"], "git_node": "aa2a357cedd2bbc1a35d3df4767a9da899b7add0", "git_parents": ["0039bec640ddc22c9feb63050fb2767f23c911b6"], "node": "6ff6620d4066d3894c02b69bbd8b71cf895f20d6", "parents": ["1bb30c03a13eda2b6355b81d7392afe7181d8005"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044740 - [devtools] Add test for file:// save as in StyleEditor r=devtools-reviewers,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301545\n", "files": ["devtools/client/styleeditor/test/browser_styleeditor_filesave_original.js"], "git_node": "e5ec0be0371d4ec06161eea444fbd3f70541784c", "git_parents": ["aa2a357cedd2bbc1a35d3df4767a9da899b7add0"], "node": "6c6b408c5a60da3be15704eaf1d64bbc2fbf127f", "parents": ["6ff6620d4066d3894c02b69bbd8b71cf895f20d6"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053739 - Auto-enter touch density in tablet mode for the Automatic window density, and default touch spacing off for nova r=firefox-desktop-core-reviewers ,sthompson,hjones,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313084\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser.js", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/CustomizeMode.sys.mjs", "browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_customizemode_uidensity.js", "browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/customizableui/test/browser_uidensity_auto_touch.js", "browser/components/preferences/config/appearance.mjs", "browser/components/preferences/tests/browser_appearance_pane.js"], "git_node": "e6562dd58f194287f0d298c0fb58442f6de04728", "git_parents": ["e5ec0be0371d4ec06161eea444fbd3f70541784c"], "node": "053ba76118ea5c8063939d799d1171048f6b2012", "parents": ["6c6b408c5a60da3be15704eaf1d64bbc2fbf127f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986890 - Show the \"add engine\" badge on the unified search button of the new search bar. r=daleharvey\n\nThe old search bar (browser.search.widget.new=false) badges its search button\nwhen the current page offers an opensearch engine. Do the same for the new\nsearch bar's unified search button, driven from the same OpenSearchManager path\nthat already updates the old search bar.\n\nThe badge is scoped to the search bar; the address bar's unified search button\nstays unbadged, matching the old behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311973\n", "files": ["browser/components/search/OpenSearchManager.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser/searchbar/browser.toml", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_addEngineBadge.js", "browser/themes/shared/urlbar-searchbar.css"], "git_node": "121994d3fa979b4a488082e3da26d50378ae003e", "git_parents": ["e6562dd58f194287f0d298c0fb58442f6de04728"], "node": "530da3d51cd5a4f8dabf99cd17df89be3a2073c8", "parents": ["053ba76118ea5c8063939d799d1171048f6b2012"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058179 - Add a .watchmanconfig to exclude in-tree objdirs from watchman r=firefox-build-system-reviewers,ahochheiden\n\nWithout a .watchmanconfig, watchman watches the whole source tree including the\nin-tree objdir. Watchman's default ignore_vcs covers .git, but build output is\nnot covered. On a Linux checkout this accounted for ~9600 extra inotify watches,\nand a build's event burst can overflow fs.inotify.max_queued_events (16384 by\ndefault), which forces a watchman recrawl.\n\nA recrawl makes git's core.fsmonitor hook report a fresh instance, which\ninvalidates git's untracked cache. The next `git status` then calls opendir() on\n41713 directories instead of 0, costing roughly 1.2s extra on a 472k-file\ncheckout.\n\nBoth obj*/ and artifacts/ are already gitignored, so suppressing watchman events\nfor them cannot cause git to miss a change.\n\nignore_dirs does not support globs, so the entries have to be exact paths: the\ndefault obj-@CONFIG_GUESS@ names produced by mach plus a few common mozconfig\nconventions. Developers using another objdir name can add their own, and an\nobjdir outside the source tree needs no entry at all. The file has to stay\nstrict JSON, because watchman silently discards the entire config if it contains\ncomments.\n\nDONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314383\n", "files": [".watchmanconfig"], "git_node": "8c27207eaf10d94dc359ab9ff1bba5711dac0584", "git_parents": ["121994d3fa979b4a488082e3da26d50378ae003e"], "node": "3a45d96a850d86b7d279c5fec6198591dea50322", "parents": ["530da3d51cd5a4f8dabf99cd17df89be3a2073c8"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1903142: Fix bug in helper that was duplicating the mid extmap. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314177\n", "files": ["testing/web-platform/meta/webrtc/simulcast/negotiation-encodings.https.html.ini", "testing/web-platform/tests/webrtc/simulcast/simulcast.js"], "git_node": "007398489e84e845e899e42ca0bf5b05cbe1391c", "git_parents": ["8c27207eaf10d94dc359ab9ff1bba5711dac0584"], "node": "685748b6d35816b2b893c8b217e4996986227bb6", "parents": ["3a45d96a850d86b7d279c5fec6198591dea50322"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2050517 - Allow extending ActionOnlyMessage allowed actions via remote settings r=omc-reviewers,mimi\n\nThis patch adds the ability to extend the allowlists of action_only message actions allowed via remote settings. This provides an extra layer of (desired) friction and review outside of the Experimenter message review process for adding new actions for use with this powerful capability. At the same time, it permits greater velocity of experimentation as we no longer need to wait for allowlist updates to ride the trains.\n\nThis capability could be extended to other messaging system allowlists, such as for setting prefs, in the future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309430\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "toolkit/components/messaging-system/jar.mn", "toolkit/components/messaging-system/lib/MessagingSystemAllowlists.sys.mjs", "toolkit/components/messaging-system/lib/test/unit/test_MessagingSystemAllowlists.js", "toolkit/components/messaging-system/lib/test/unit/xpcshell.toml", "toolkit/components/messaging-system/moz.build"], "git_node": "680c02366caf54f589c18bc189d778fccbfe29f3", "git_parents": ["007398489e84e845e899e42ca0bf5b05cbe1391c"], "node": "ee689c4f1259b834b14bcb207e842fbe9cf77b54", "parents": ["685748b6d35816b2b893c8b217e4996986227bb6"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057486 - Restore layout.css.attr.enabled=true in browser-results/browser.toml. r=urlbar-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314064\n", "files": ["browser/components/urlbar/tests/browser-results/browser.toml"], "git_node": "1c67f3f1d93f3a925786d3c728a232b6b8dc9264", "git_parents": ["680c02366caf54f589c18bc189d778fccbfe29f3"], "node": "cb0ea7385213825eac6ef67228185e29968dda8e", "parents": ["ee689c4f1259b834b14bcb207e842fbe9cf77b54"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2019361: Set RTCPeerConnection.sctp in have-remote-offer. r=ng,webidl,saschanaz\n\nAlso make RTCSctpTransport.maxMessageSize and .transport nullable\naccording to latest spec and https://github.com/w3c/webrtc-pc/issues/3112\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312837\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/jsapi/RTCSctpTransport.cpp", "dom/media/webrtc/jsapi/RTCSctpTransport.h", "dom/webidl/RTCSctpTransport.webidl", "testing/web-platform/meta/webrtc/RTCSctpTransport-constructor.html.ini", "testing/web-platform/meta/webrtc/RTCSctpTransport-events.html.ini", "testing/web-platform/meta/webrtc/RTCSctpTransport-maxChannels.html.ini", "testing/web-platform/tests/webrtc/RTCSctpTransport-events.html"], "git_node": "cf7acd3574f9504fd09367a18bbbfb5e21e9f40b", "git_parents": ["1c67f3f1d93f3a925786d3c728a232b6b8dc9264"], "node": "b75481b77056f264291e4cb8a34a272176470447", "parents": ["cb0ea7385213825eac6ef67228185e29968dda8e"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 8ec62959b0710b70db1b8107b1b41fc63a2165ef\naf -\u003e 8ec62959b0710b70db1b8107b1b41fc63a2165ef\nan -\u003e 8ec62959b0710b70db1b8107b1b41fc63a2165ef\nar -\u