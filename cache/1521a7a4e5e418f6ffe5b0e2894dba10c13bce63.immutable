n", "browser/extensions/webcompat/manifest.json", "services/sync/modules/constants.sys.mjs"], "git_node": "61d68bf22afcfb7960b71b2ecb51c2a9db46df6d", "git_parents": ["2ffdbd720569f6040644e5d34c92a159d704e64c"], "node": "89d770fb41a53c2ee95b65a1d3c2712fa99717a9", "parents": ["81572b4da1e835f8e5ce88dfe69eb075e2a58a4b"], "tags": []}], "date": 1784568908, "git_changesets": ["2ffdbd720569f6040644e5d34c92a159d704e64c", "61d68bf22afcfb7960b71b2ecb51c2a9db46df6d"], "user": "ffxbld@lando.moz.tools"}, "44925": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 4c1ce8f04007e1ebcc15ee64c68b6461c41413f9 with FIREFOX_NIGHTLY_154_END a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "fb16a746b2ba40f60258102d693b63cc04bb36b8", "git_parents": ["17afadb7dae34924aef9e970a260b4e7e42ae132"], "node": "0a86d23c2f36efd812c344d07a6796b4714fb17a", "parents": ["a55bc5479d7c1ec3f0af8dade8c11e374c0f9f33"], "tags": []}], "date": 1784568924, "git_changesets": ["fb16a746b2ba40f60258102d693b63cc04bb36b8"], "user": "ffxbld@lando.moz.tools"}, "44926": {"changesets": [{"author": "tmanku \u003ctanvi.manku@gmail.com\u003e", "branch": "default", "desc": "Bug 2048463 - Extend expiry of doorhangerSubmitted metrics to 165. r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312640\n", "files": ["toolkit/components/passwordmgr/metrics.yaml"], "git_node": "c07b3ee4865ceff195ced7f52c0cac1dc15f3c24", "git_parents": ["61d68bf22afcfb7960b71b2ecb51c2a9db46df6d"], "node": "2fc6c81139b7e416fe776791e463fdf5c548c8c1", "parents": ["89d770fb41a53c2ee95b65a1d3c2712fa99717a9"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052660 - treat symbols in resource documents as always visible r=emilio\" for causing regression bug 2056150\n\nThis reverts commit d07b48bc261f6c2795c151572d28e10d64033431.\n", "files": ["dom/svg/SVGSymbolElement.cpp", "testing/web-platform/tests/svg/struct/reftests/reference/use-external-use-ref.svg", "testing/web-platform/tests/svg/struct/reftests/use-external-use.svg"], "git_node": "9631bc624c432f094ca05c276e5a5c922407859f", "git_parents": ["c07b3ee4865ceff195ced7f52c0cac1dc15f3c24"], "node": "27bb72351e256a52cbb34d1dbf13c37b9856543e", "parents": ["2fc6c81139b7e416fe776791e463fdf5c548c8c1"], "tags": []}], "date": 1784569803, "git_changesets": ["c07b3ee4865ceff195ced7f52c0cac1dc15f3c24", "9631bc624c432f094ca05c276e5a5c922407859f"], "user": "csabou@mozilla.com"}, "44927": {"changesets": [{"author": "tobypilling \u003ctoby@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2056010 - Use a weak dependency for shell_windows enable_tests. r=saschanaz DONTBUILD\n\nThe enable_tests feature was strongly enabling the optional shell_windows\ndependency, causing Thunderbird Windows builds with tests enabled to compile\nFirefox-only shell code without the required XPCOM interfaces.\n\nUse Cargo's weak dependency feature syntax so shell_windows/enable_tests is\nenabled only when shell_windows is already part of the crate graph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312865\n", "files": ["toolkit/library/rust/shared/Cargo.toml"], "git_node": "b52296d542b89092ffd707ca478a85ebf0f89ff5", "git_parents": ["9631bc624c432f094ca05c276e5a5c922407859f"], "node": "3b84f070c33f2b7e894e8bad7cb5160b8ea706b1", "parents": ["27bb72351e256a52cbb34d1dbf13c37b9856543e"], "tags": []}], "date": 1784570481, "git_changesets": ["b52296d542b89092ffd707ca478a85ebf0f89ff5"], "user": "csabou@mozilla.com"}, "44928": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5ca49396cb455033afb922ef40cb68d13e469c9d with FIREFOX_154_0b1_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "330d9027ffe93b051d6c8e152a9c9f7851f21897", "git_parents": ["fb16a746b2ba40f60258102d693b63cc04bb36b8"], "node": "5b4341fc