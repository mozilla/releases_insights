ba", "git_parents": ["4d414e10a2a03d5a82f045f19dcd3649aae4ae73"], "node": "c4c98beb4368b950e933d58f6ddfdeb4696bbe29", "parents": ["705bd7c435429e459afdd89bee11fb3ef97c8816"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046795 - Update account menu sign in button for Nova r=desktop-theme-reviewers,fluent-reviewers,omc-reviewers,bolsson,sync-reviewers,skhamis,aminomancer,hjones\" for causing bc failures at browser_sync.js\n\nThis reverts commit 327d291ca0e62ba3fbbb7463576c71e6e094fa65.\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-profiles.js", "browser/base/content/browser-sync.js", "browser/base/content/kit-signed-out.svg", "browser/base/content/test/sync/browser_sync.js", "browser/base/jar.mn", "browser/components/asrouter/tests/browser/browser_asrouter_menu_messages.js", "browser/locales/en-US/browser/sync.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "d8493d873bd5f04d8b2df95c19285f4e874d8795", "git_parents": ["7018af629ef54381e965023d4692b01f6c17fcba"], "node": "1318095bf87f7f5d6607e86a6c8b91569fa5069f", "parents": ["c4c98beb4368b950e933d58f6ddfdeb4696bbe29"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2044646 - Stop keeping a copy of every job result in the profile workers, r=ahal.\n\nEach worker pushed every result it processed into an array that it sent back in\nthe final \"finished\" message, but the main thread collects the results from the\n\"jobComplete\" messages as they arrive and ignores the \"finished\" payload. Each\nworker was thus holding a second copy of all the results it had processed until\nthe end of the run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314967\n", "files": ["testing/timings/profile-worker.js"], "git_node": "df25ca068e75176a0218795b5c9bf31de7bf0c9f", "git_parents": ["d8493d873bd5f04d8b2df95c19285f4e874d8795"], "node": "135a6ef511fab3f7c723d2c8721447e8fad98d5e", "parents": ["1318095bf87f7f5d6607e86a6c8b91569fa5069f"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2044646 - Extract error and warning markers from resource usage profiles, r=ahal.\n\nmozsystemmonitor emits a marker for each C++ warning, C++ assertion,\nconsole.error, console.warn, JavaScript error and JavaScript warning it sees in\nthe log of a test job. Collect them into the job results, normalized so that the\nsame diagnostic seen in different jobs is a single message. On a sample of 188\nprofiles this takes the number of distinct messages from 962 down to 398, and the\nnumber of distinct source paths from 211 down to 153:\n\n- The message text loses pointer addresses, UUIDs, timings and large ids, and the\n  process ids that the shutdown hang warnings would otherwise contribute one\n  message per process for. Process ids are only 4 or 5 digits long, so they have\n  to be recognized from the words around them.\n- A source path loses the directory the file was read from, which names the build\n  or test worker and sometimes the task, and uses forward slashes, so that the\n  same file has one path whatever platform the test ran on. The paths quoted in a\n  message get the same treatment.\n- A file of the profile of the instance under test is named relative to\n  \"\u003cprofile\u003e\", as both the profile directory and the temporary directory it sits\n  in have a random, platform specific name. A URL scheme in front of the path is\n  kept, so that a jar URL stays well formed.\n- The manifest name prefix that xpcshell adds to the test id of tests in a dupe\n  manifest is stripped in a helper shared with extractTestTimings, so that a test\n  has the same identity in the marker data as in the timing data.\n\nNothing consumes the markers yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314968\n", "files": ["testing/timings/profile-worker.js"], "git_node": "0bfc9491d26d0e0c90e666eb9e9e1478c4482a74", "git_parents": ["df25ca068e75176a0218795b5c9bf31de7bf0c9f"], "node": "014441da47e444d1dc6ca75297b83f57d6473407", "parents": ["135a6ef511fab3f7c723d2c8721447e8fad98d5e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2044646 - Share the columnar table code between the data files we generate, r=ahal.\n\ncreateDataTables and sortStringTablesByFrequency each mix code that is specific\nto the test timing data with code that any of our columnar files needs: string\ntables and their interning primitive, the taskInfo and testInfo side tables, and\nthe frequency sorting of the tables with the index remapping that follows. Move\nthe latter to createColumnarTables, createFrequencyCounts, sortTablesByFrequency,\nremapTaskInfo and remapTestInfo, so that the error and warning marker file can\nuse them instead of duplicating them.\n\nThe generated files keep the same contents. Two details of their layout change:\nthe string tables specific to the timing data now come last in the `tables`\nobject, and table entries with the same reference count are now ordered by\ncodepoint rather than with String.localeCompare, so that the order no longer\ndepends on the locale of the machine the file was generated on. The row order of\ntestInfo and of the occurrences still depends on the order in which the jobs were\nprocessed, which varies from one run to the next.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314969\n", "files": ["testing/timings/fetch-test-data.js"], "git_node": "62f4b6577ec24fea96e07d8d9a9e3d09ae737ba3", "git_parents": ["0bfc9491d26d0e0c90e666eb9e9e1478c4482a74"], "node": "307aea3a066d6b9d89c3d21f7255d2c0f1035b84", "parents": ["014441da47e444d1dc6ca75297b83f57d6473407"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2044646 - Generate daily error and warning marker data files from resource usage profiles, r=ahal.\n\nThe error and warning markers extracted from the resource usage profiles are\nwritten to a {harness}-{date}-errors.json daily file, so that the dashboard can\nbreak errors and warnings down by test, by message and by Bugzilla component.\n\nThe data is columnar: on top of the shared string tables, a messages table\ninterns each unique (marker name, message text, file, line, component) so a line\nand file are stored once per distinct message. Occurrences are grouped by (test,\nmessage) with per-group taskIdIds/counts sub-arrays, and the ascending taskIdIds\nare delta-encoded, so the test and message are stored once per group rather than\nonce per (test, task, message) occurrence.\n\nMarkers are folded into an accumulator as each job completes so that a full day's\nmarkers are never all held in memory at once. Building this file is allowed to\nfail without costing us the day's timings, resource usage and stats.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304521\n", "files": ["testing/timings/JSON_FORMAT.md", "testing/timings/fetch-test-data.js"], "git_node": "6fac89edf7a09af2bcf465321e14f3004fed5c47", "git_parents": ["62f4b6577ec24fea96e07d8d9a9e3d09ae737ba3"], "node": "f8b7f2cfb441f0cfae1ddc20b53327163fcec4ce", "parents": ["307aea3a066d6b9d89c3d21f7255d2c0f1035b84"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2044646 - Report the error and warning counts of each day in the stats file, r=ahal.\n\nThe dashboard needs to know how noisy a day was, and for which kind of\ndiagnostic, without downloading that day's errors file, and needs to know which\ndays have an errors file at all, as the days generated before we produced one\nnever will.\n\nBreak the occurrence total that the errors file's metadata carried down per marker\nname, and report the same breakdown in the stats file as one array per marker\nname, next to the mochitest flavor arrays. A day that has no errors file counts 0,\nthe way a day that a mochitest flavor didn't run on does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314970\n", "files": ["testing/timings/JSON_FORMAT.md", "testing/timings/fetch-test-data.js"], "git_node": "f28c8259521066d5fc8e059fe896efd874b03126", "git_parents": ["6fac89edf7a09af2bcf465321e14f3004fed5c47"], "node": "9e9b8f10ff6b94cf566c9f96704cbf0d4ea9f783", "parents": ["f8b7f2cfb441f0cfae1ddc20b53327163fcec4ce"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2044646 - Extract TSan Error markers from resource usage profiles, r=ahal.\n\nThe TSan Error marker that mozsystemmonitor emits differs from the other\ndiagnostic markers: it carries no message, file or line, but the kind of the TSan\nreport, the label of the stack the error was reported for, and that stack.\n\nSynthesize the message as \"{kind}: {label}\", and take the file and line from the\nfirst repository frame of the stack, resolved through the profile's stackTable,\nframeTable and funcTable. The frames at the leaves are skipped: they are crash and\nruntime machinery (MOZ_Crash, the TSan runtime, libc) that no Bugzilla component\nowns.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306284\n", "files": ["testing/timings/JSON_FORMAT.md", "testing/timings/profile-worker.js"], "git_node": "ff604e0850ea0c086b6d02df72ad0a5d2de771b3", "git_parents": ["f28c8259521066d5fc8e059fe896efd874b03126"], "node": "928cb26c77479213e8bd97cc33aad8de365f8946", "parents": ["9e9b8f10ff6b94cf566c9f96704cbf0d4ea9f783"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2044646 - Normalize more run-specific data in error and warning markers, r=ahal.\n\nThe 28701 jobs of 2026-07-29 produce 42631 distinct mochitest marker messages, but\nmost of them are a diagnostic another job also hit, with a number that changed from\none job to the next. Normalizing six more kinds of run-specific data takes them down\nto 12869, and the distinct source paths from 3083 to 1332:\n\n- Process ids in the \"processId 1628\" and \"pid = 10164\" forms. The rule so far\n  needed whitespace before \"id\", so the QM_TRY failures and the \"content process\n  childID = 10 pid = 10164 crashed without leaving a minidump behind\" warning\n  contributed 17008 messages on their own.\n- The port httpd.js and the other test servers listen on, which they are given at\n  runtime, in a source path as well as in a message. Only the authority of a URL is\n  matched: a position in a stack frame (\"Front.js:335:14\") would otherwise look like\n  a host and a port.\n- The pointers a log prints without a \"0x\" prefix (\"Decoder=4d26600\"), which the\n  rule for bare hex addresses missed as they are only 7 characters long. Requiring\n  both a hex letter and a digit keeps a word and a bug number from being read as an\n  address.\n- Devtools actor ids (\"server0.conn0.watcher2.process1234//layout29\"), where every\n  number counts up from the start of the connection.\n- The query parameters an OAuth flow generates, and the tokens some tests put in a\n  URL.\n- The ids of a content process, a window, a browsing context or a tab, which count\n  up from the start of the job and so are shorter than the rule for large decimal\n  ids expects.\n\nThe timestamp some tests append to a URL to bypass the cache is normalized in source\npaths too. Only a query string is matched for it, as a long number elsewhere in a\npath is part of the name of a file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315369\n", "files": ["testing/timings/profile-worker.js"], "git_node": "d53e66d3bd1e5faaad7987fc480c509549be8d31", "git_parents": ["ff604e0850ea0c086b6d02df72ad0a5d2de771b3"], "node": "ce72e781a27921daa76af683a90f1d052d292283", "parents": ["928cb26c77479213e8bd97cc33aad8de365f8946"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012186 - Add test coverage to ensure default search engine dropdown in about:preferences#search is closed when clicked. r=akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315454\n", "files": ["browser/components/preferences/tests/search/browser_searchDefaultEngine.js", "toolkit/content/tests/widgets/test_moz_select_panel.html"], "git_node": "c6d6679add6cf95c75c6d5a97bb649952291f4f3", "git_parents": ["d53e66d3bd1e5faaad7987fc480c509549be8d31"], "node": "5ee5e5b0c12c39784a367a724a2a06b71b3fc59b", "parents": ["ce72e781a27921daa76af683a90f1d052d292283"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059053: apply code formatting via Lando\" for causing mochitest failure @ test_register.html\n\nThis reverts commit 6481f0f4f8cc98c8ef305c17b6bab2f7c4161f04.\n\nRevert \"Bug 2059053 - Part 2: Disallow retrieving push subscription in partitioned worker r=asuth\"\n\nThis reverts commit 64633df4508e639b633c77c6fa1739ce017194e8.\n\nRevert \"Bug 2059053 - Part 1: Add tests for push subscribes r=asuth\"\n\nThis reverts commit 36da4bcf80727fbf0791d788ca5a4ae2d7d6d697.\n", "files": ["dom/push/PushManager.cpp", "testing/web-platform/meta/push-api/worker-subscribe.https.window.js.ini", "testing/web-platform/tests/push-api/cross-origin-nested.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-same-site-request.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-serviceworker.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/resources/cross-origin-nested-child.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-nested-parent.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-serviceworker-iframe.sub.html", "testing/web-platform/tests/push-api/resources/permission-helper.js", "testing/web-platform/tests/push-api/resources/permission-sw.js", "testing/web-platform/tests/push-api/resources/permission-worker.js", "testing/web-platform/tests/push-api/worker-subscribe.https.window.js"], "git_node": "55546d52ebab608273d58bc6b8ef133b6abfba10", "git_parents": ["c6d6679add6cf95c75c6d5a97bb649952291f4f3"], "node": "20d90a2d32d1b497d19c3eba207a3cffc99edc33", "parents": ["5ee5e5b0c12c39784a367a724a2a06b71b3fc59b"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057032 - Make vpn onboarding wait past WarmingUp r=android-reviewers,jonalmeida\n\nAdding NoAccount state for the onboarding to distinguish between fxa\nmanager initializing and having no account at the app start.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313887\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionStorageSynchronizer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/FxaAccountStoreSyncTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPrompt.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPromptTest.kt"], "git_node": "e2f893c81ce36b7ac3d533dd6fdc2d493eeb4d75", "git_parents": ["55546d52ebab608273d58bc6b8ef133b6abfba10"], "node": "51229955d824b89e794c37de3cf9a3c1fb86f306", "parents": ["20d90a2d32d1b497d19c3eba207a3cffc99edc33"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058646 - Account initialization clean up r=jonalmeida,android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314743\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionStorageSynchronizer.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/FxaAccountStoreSyncTest.kt"], "git_node": "1288aae0c463b68934ef19c0874603ee25de265a", "git_parents": ["e2f893c81ce36b7ac3d533dd6fdc2d493eeb4d75"], "node": "b41dbc0e5cb3b35206e7bb400f2f4c89bd68c635", "parents": ["51229955d824b89e794c37de3cf9a3c1fb86f306"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058767 - Remove region gating from the SmartWindow ToU Spotlight Modal r=sachung,omc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315099\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/asrouter/tests/xpcshell/test_OnboardingMessageProvider.js"], "git_node": "e4249b43c57b66fbc2436a2876d3a5d0f1505fa4", "git_parents": ["1288aae0c463b68934ef19c0874603ee25de265a"], "node": "f549c74fb477d42413dd050d6fdb5d77f547e176", "parents": ["b41dbc0e5cb3b35206e7bb400f2f4c89bd68c635"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058730 - record whether the NSS internal PKCS#11 module is in FIPS mode. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315384\n", "files": ["security/manager/ssl/metrics.yaml", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/tests/unit/test_broken_fips.js"], "git_node": "c50b060d3a12b78ca8b4b7e79ee6d82b619d7068", "git_parents": ["e4249b43c57b66fbc2436a2876d3a5d0f1505fa4"], "node": "73f0a89fcf88ea27becf1d7db1060d5f4194d293", "parents": ["f549c74fb477d42413dd050d6fdb5d77f547e176"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058733 - refine builtin roots module source telemetry. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315386\n", "files": ["security/manager/ssl/metrics.yaml", "security/manager/ssl/nsNSSComponent.cpp"], "git_node": "03e6280a0d8e47887fb3006830175af35bd7a02b", "git_parents": ["c50b060d3a12b78ca8b4b7e79ee6d82b619d7068"], "node": "1c2d8b99756697f88d390c626dfe3fb1397899f1", "parents": ["73f0a89fcf88ea27becf1d7db1060d5f4194d293"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 1: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314577\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "remote/shared/NetworkResponse.sys.mjs"], "git_node": "b62c79358e5da14d009dccf0ff0c083084391cc5", "git_parents": ["03e6280a0d8e47887fb3006830175af35bd7a02b"], "node": "af923196c6ef24c75a35430c9b96b4b8bdc4deb7", "parents": ["1c2d8b99756697f88d390c626dfe3fb1397899f1"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 2: Pre-calculate the fallback encoding for the classic script source. r=bthrall,dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314578\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/workers/ScriptLoader.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h"], "git_node": "10184ec04cafc257786697ce1269acad694f36b4", "git_parents": ["b62c79358e5da14d009dccf0ff0c083084391cc5"], "node": "8383f3d1572eda574eae0ddb865901a87cda7ca0", "parents": ["af923196c6ef24c75a35430c9b96b4b8bdc4deb7"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 3: Use pre-calculated fallback encoding for the in-memory cache key. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314579\n", "files": ["dom/script/ScriptLoader.cpp", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "js/loader/LoadedScript.h"], "git_node": "4bfbd49f19cb87b7bdf35f4b70b016a699fe37c1", "git_parents": ["10184ec04cafc257786697ce1269acad694f36b4"], "node": "8f2442917276d7e404f95d076b89ce3c35201c3e", "parents": ["8383f3d1572eda574eae0ddb865901a87cda7ca0"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 4: Use pre-calculated fallback encoding for the classic script disk cache MIME-Type. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314580\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "ca43921a55957dbc3ae09f0b85b2f7f740b2ac46", "git_parents": ["4bfbd49f19cb87b7bdf35f4b70b016a699fe37c1"], "node": "f1a9b366573def94200da7a5eb08130fd8efc058", "parents": ["8f2442917276d7e404f95d076b89ce3c35201c3e"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 5: Add tests. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314581\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset.js", "dom/base/test/head.js"], "git_node": "4f7ca5ec2eceb4cf1d34d1afed234e50a65c5cde", "git_parents": ["ca43921a55957dbc3ae09f0b85b2f7f740b2ac46"], "node": "40ba5ae6122795046cb8db7f848279b292d3cba7", "parents": ["f1a9b366573def94200da7a5eb08130fd8efc058"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2056134: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/script/SharedScriptCache.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.h"], "git_node": "dc20335f97f970ec390ae3b3d00ac25a7e8fa37f", "git_parents": ["4f7ca5ec2eceb4cf1d34d1afed234e50a65c5cde"], "node": "8a9404855d60139089ba911d459598bd4f1517eb", "parents": ["40ba5ae6122795046cb8db7f848279b292d3cba7"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2048762 - Use AboutRedirector for about:studies r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314997\n", "files": ["browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "toolkit/components/normandy/components.conf", "toolkit/components/normandy/content/AboutPages.sys.mjs", "toolkit/components/normandy/moz.build"], "git_node": "5e224a98d3d72acfed2089f6c120c9f7f1f39032", "git_parents": ["dc20335f97f970ec390ae3b3d00ac25a7e8fa37f"], "node": "0a37def1c82d05f8ca3fe2794441132b8ce3b33c", "parents": ["8a9404855d60139089ba911d459598bd4f1517eb"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 1 - Add `--disable-legacy-l10n` configure flag r=firefox-build-system-reviewers,glandium,sergesanspaille\n\nThis stack will implement a new l10n driver alongside the legacy\nrecursive-make one. This flag selects which implementation is\nused. The env var takes precedence over the `--disable-legacy-l10n`\nflag to make diffoscope testing easier.\n\nIn the end, this is all temporary and will be removed when we\nrip out the legacy l10n implementation for good.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299863\n", "files": ["moz.configure"], "git_node": "fbedc6278261b31c7a8a5618ff99e71939fd0644", "git_parents": ["5e224a98d3d72acfed2089f6c120c9f7f1f39032"], "node": "840d9a29b0a9381bc4f296a6bf7cd859998f4196", "parents": ["0a37def1c82d05f8ca3fe2794441132b8ce3b33c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 2 - Add `l10n_manifest` r=firefox-build-system-reviewers,sergesanspaille\n\nAdds the data structures and read/write helpers for\n`l10n-manifest.json`, the file the emitter writes durnig configure\nand the staging action reads at command time. This commit is\njust the container dataclasses and the rest comes in later parts.\n\n`MOZ_L10N_AB_CD_PLACEHOLDER` lets the emitter capture jar.mn\ncontent at parse time with `@AB_CD@` already substituted, so\none configure run covers every locale we could possibly stage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299864\n", "files": ["python/mozbuild/mozbuild/frontend/l10n_manifest.py", "python/mozbuild/mozbuild/test/frontend/test_l10n_manifest.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "37df7c8c8532ac2615414a8577c32dfe6ea7674c", "git_parents": ["fbedc6278261b31c7a8a5618ff99e71939fd0644"], "node": "28ca8cb05ddd003e223535566717d8a3a6b715e3", "parents": ["840d9a29b0a9381bc4f296a6bf7cd859998f4196"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 3 - Add `LOCALE_PP_DEFINES` r=firefox-build-system-reviewers,sergesanspaille\n\n`LOCALE_PP_DEFINES` maps a preprocessor define\nto a per-locale lookup table (exact ab_cd or fnmatch\npattern). It's first used in the next part.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299865\n", "files": ["python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/test/frontend/data/locale-pp-defines/moz.build", "python/mozbuild/mozbuild/test/frontend/test_reader.py"], "git_node": "7a8c50dc717a90c2ac66e6c8bf64c3c3d4e62d9a", "git_parents": ["37df7c8c8532ac2615414a8577c32dfe6ea7674c"], "node": "bc47056154d24ec4ec147626780ffe472a9dbcf4", "parents": ["28ca8cb05ddd003e223535566717d8a3a6b715e3"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 4 - Generate `l10n-manifest.json` r=firefox-build-system-reviewers,sergesanspaille\n\nWe walk `moz.build` contexts at emit time and yield one\n`L10nManifestContext` for each context with localized content.\nThe build backend collects them and writes `l10n-manifest.json`\nunder `topobjdir`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299866\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/frontend/l10n_manifest.py", "python/mozbuild/mozbuild/test/backend/data/jar-manifests/jar.mn", "python/mozbuild/mozbuild/test/backend/data/l10n-manifest/moz.build", "python/mozbuild/mozbuild/test/backend/test_l10n_manifest.py", "python/mozbuild/mozbuild/test/frontend/data/jar-manifests/jar.mn", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "247ebac267ec3d3a7ab1c6ebcc0797078b7968c4", "git_parents": ["7a8c50dc717a90c2ac66e6c8bf64c3c3d4e62d9a"], "node": "c0e7dc035c5e8e0d254db6020dbcd2793217133f", "parents": ["bc47056154d24ec4ec147626780ffe472a9dbcf4"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 5 - Add `l10n_merge` action r=sylvestre\n\nAdds a `py_action` that builds the per-locale merge tree. Wipes the\nmerge dir, runs `python -m moz.l10n.bin.build`, and copies hunspell\ndictionaries that `bin.build` doesn't handle.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299867\n", "files": ["python/mozbuild/mozbuild/action/l10n_merge.py"], "git_node": "89ca298a05f4ac5e513c4e5cea2aa8d4eef33906", "git_parents": ["247ebac267ec3d3a7ab1c6ebcc0797078b7968c4"], "node": "3a57f09b6c8ee72821fe517beb2264c27bd97598", "parents": ["c0e7dc035c5e8e0d254db6020dbcd2793217133f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 6 - Add `l10n_stage` skeleton and `LOCALE_PP_DEFINES` resolution r=firefox-build-system-reviewers,sergesanspaille\n\nAdds a `py_action` skeleton that stages a locale into\n`\u003ctopobjdir\u003e/dist/xpi-stage/locale-\u003cab_cd\u003e/`. Loads\n`l10n-manifest.json`, walks contexts, and dispatches to a per-context\nstager that later parts of this stack fill in.\n\nAdds the runtime resolver for `LOCALE_PP_DEFINES`. Exact `ab_cd`\nkeys win, with fnmatch patterns as fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299868\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py"], "git_node": "5d9291e81d309927bec02c00df02db9227b3d797", "git_parents": ["89ca298a05f4ac5e513c4e5cea2aa8d4eef33906"], "node": "da2b2c513a299013f0673e8d8f8812b01cac4ae1", "parents": ["3a57f09b6c8ee72821fe517beb2264c27bd97598"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 7 - Stage `LOCALIZED_FILES` and `LOCALIZED_PP_FILES` r=firefox-build-system-reviewers,sergesanspaille\n\nGated to `langpack` mode (`chrome` mode multi-locale builds only stage\nchrome). `LOCALIZED_PP_FILES` runs through the preprocessor with\n`LOCALE_PP_DEFINES` resolved for the current locale.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299869\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py"], "git_node": "3a1e0d450eff94601a544364d556fd7d2f22a5cf", "git_parents": ["5d9291e81d309927bec02c00df02db9227b3d797"], "node": "9eb794b7e20fbd106c38bd75ff07fcc301173074", "parents": ["da2b2c513a299013f0673e8d8f8812b01cac4ae1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 8 - Run `LOCALIZED_GENERATED_FILES` scripts r=firefox-build-system-reviewers,sergesanspaille\n\nGated to `langpack` mode. Gen scripts run before\n`LOCALIZED_FILES`/`LOCALIZED_PP_FILES` so `!output` references\nresolve. Output names accept `{AB_CD}` and `{AB_rCD}` placeholders.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299870\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py"], "git_node": "9187b751778a01e9ec3e866b97197ea3b45609e2", "git_parents": ["3a1e0d450eff94601a544364d556fd7d2f22a5cf"], "node": "383988fe45f69acef53e4fff579fda6e40b579e4", "parents": ["9eb794b7e20fbd106c38bd75ff07fcc301173074"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 9 - Stage `jar.mn` locale entries r=firefox-build-system-reviewers,sergesanspaille\n\nRuns in both `langpack` and `chrome` modes since multi-locale builds\npackage chrome content into the en-US dist tree alongside langpack\nstaging. Sections with any `% locale` chrome.manifest line (or\n`[localization]` blocks) stage all entries. Other sections only\nstage entries explicitly marked `%`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299871\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py"], "git_node": "63e2e2dfae0f32642491d32c585c1e3d06b9c193", "git_parents": ["9187b751778a01e9ec3e866b97197ea3b45609e2"], "node": "4377345b4fee4c5628bbc50c11f58d88e1ed8418", "parents": ["383988fe45f69acef53e4fff579fda6e40b579e4"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 10 - Assemble per-locale `chrome.manifest` files r=firefox-build-system-reviewers,sergesanspaille\n\nCollects chrome.manifest entries during jar.mn staging and writes\nthem after all contexts finish. Chrome mode merges existing lines\nso multi-locale runs accumulate per-locale entries on top of the\nen-US baseline. Langpack mode also writes the per-locale\n`res/multilocale.txt` consumed by toolkit's omni.ja.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299872\n", "files": ["python/mozbuild/mozbuild/action/l10n_stage.py"], "git_node": "c93ee3852f0d4564e6ecf2ff5bc273c287f98b27", "git_parents": ["63e2e2dfae0f32642491d32c585c1e3d06b9c193"], "node": "3370d643b20db48af0308964a72a80ed19f486c6", "parents": ["4377345b4fee4c5628bbc50c11f58d88e1ed8418"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 11 - Add `LOCALE_PP_DEFINES` for `app-marketplace-icons` r=sylvestre\n\nAdds `ANDROID_MARKETPLACE_AB_CD` and `IOS_MARKETPLACE_AB_CD` as\n`LOCALE_PP_DEFINES` so the new l10n driver can resolve them at staging\ntime. The equivalent `MAKE_JARS_FLAGS` defines in `Makefile.in` stay in\nplace because the legacy make driver is still the default\n(`MOZ_USE_LEGACY_L10N`). The make side will be removed once the legacy\nl10n driver goes away.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299873\n", "files": ["browser/themes/shared/app-marketplace-icons/moz.build"], "git_node": "43bde7866598056008f2d977d36cc65adb2abbef", "git_parents": ["c93ee3852f0d4564e6ecf2ff5bc273c287f98b27"], "node": "b01ce5f2ed525a2ec9c14a546141c5634dc2a483", "parents": ["3370d643b20db48af0308964a72a80ed19f486c6"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 12 - Add `package_langpack` action r=firefox-build-system-reviewers,sergesanspaille\n\nWraps the two legacy langpack `py_action` calls (`langpack_manifest`\nand `zip`) into one to reduce Python overhead per locale.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299874\n", "files": ["python/mozbuild/mozbuild/action/package_langpack.py"], "git_node": "1cad29ef2766e0df9a9769b4f964bfc5b505bebc", "git_parents": ["43bde7866598056008f2d977d36cc65adb2abbef"], "node": "767563835a89842909a07e239607577dbf9ede54", "parents": ["b01ce5f2ed525a2ec9c14a546141c5634dc2a483"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 13 - Add `l10n_repackage` action r=sylvestre\n\nHandles the full l10n repackaging step (unpack en-US, l10n-repack,\npackage, move output). Superset of the legacy `l10n-repack.py`,\nwhich we'll delete once the legacy l10n driver is gone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299875\n", "files": ["python/mozbuild/mozbuild/action/l10n_repackage.py"], "git_node": "3d9dd5ca64f46e726f280c14667eac9141d7fc94", "git_parents": ["1cad29ef2766e0df9a9769b4f964bfc5b505bebc"], "node": "567c80cd4c97c838cd2fd809a4fdb3532421c594", "parents": ["767563835a89842909a07e239607577dbf9ede54"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038810 - Part 14 - Wire up new Python `l10n` actions so they run when `MOZ_USE_LEGACY_L10N` is false r=firefox-build-system-reviewers,sergesanspaille\n\nAdds an `ifndef MOZ_USE_LEGACY_L10N` branch in each `l10n-%`,\n`chrome-%`, `merge-%`, `repackage-zip-%`, and `package-langpack-%`\nrecipe so `l10n_stage`, `l10n_merge`, `l10n_repackage`, and\n`package_langpack` run when the gate is unset or falsy. The legacy\nrecursive-make path stays as the default for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D299876\n", "files": ["browser/locales/Makefile.in", "mobile/android/locales/Makefile.in", "mobile/locales/Makefile.in", "python/mozbuild/mozbuild/controller/building.py", "toolkit/locales/Makefile.in", "toolkit/locales/l10n.mk"], "git_node": "bfa462403422b573d020c6687fa7ff4a40589fdc", "git_parents": ["3d9dd5ca64f46e726f280c14667eac9141d7fc94"], "node": "703f69da76246fce07dc7b0022ee9a08744a59a0", "parents": ["567c80cd4c97c838cd2fd809a4fdb3532421c594"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2025793 - Bundle newtab JSX/SCSS files during mach build and remove from tree r=mconley,sylvestre\" for causing build bustages\n\nThis reverts commit 7018af629ef54381e965023d4692b01f6c17fcba.\n", "files": [".gitignore", ".hgignore", "CLOBBER", "browser/extensions/moz.configure", "browser/extensions/newtab/addon-jar.mn", "browser/extensions/newtab/bin/try-runner.js", "browser/extensions/newtab/build-newtab-bundles.py", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/vendor.bundle.js", "browser/extensions/newtab/lib/cache.worker.js", "browser/extensions/newtab/moz.build", "browser/extensions/newtab/webext-glue/moz.build", "browser/extensions/newtab/webpack.system-addon.config.js", "taskcluster/kinds/build-extensions/kind.yml", "toolkit/content/license.html", "tools/lint/rejected-words.yml"], "git_node": "cb46d43c454dcd4ec02dc866fa2ba727e8a24a96", "git_parents": ["bfa462403422b573d020c6687fa7ff4a40589fdc"], "node": "b034e6cf372764a3224f11ac8f3471b5049e2489", "parents": ["703f69da76246fce07dc7b0022ee9a08744a59a0"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2058772 - Resolve the SMIL time container once per sample. r=emilio\n\nSVGAnimationElement::GetTimeContainer walks the ancestor chain up to the\nouter svg element on every call, and nothing caches the result.\nDoSampleAt called it three times and then called RegisterMilestone, which\ncalled it a fourth, all for the same answer.\n\nResolve it once at the top of DoSampleAt and pass it down. The container\ncannot change over the call: the state machine only queues time events\nasynchronously, so no script runs that could rebind the element, and the\nexisting code already relied on the three calls agreeing. RegisterMilestone\nasserts that any container it is handed is the one it would have resolved\nitself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314290\n", "files": ["dom/smil/SMILTimedElement.cpp", "dom/smil/SMILTimedElement.h"], "git_node": "580b63d20423b75a0b4c1ec1b52f8dfa3cd8d1c3", "git_parents": ["cb46d43c454dcd4ec02dc866fa2ba727e8a24a96"], "node": "b508d9764fe32ef65b5c7a7076c8b6b39cc606c3", "parents": ["b034e6cf372764a3224f11ac8f3471b5049e2489"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2056646 - Wait for the fullscreen warning animation before clicking its exit button, r=firefox-desktop-core-reviewers ,Gijs.\n\nThe test clicked #fullscreen-exit-button from the MozDOMFullscreen:Entered\nhandler, ie. while nsGlobalWindowOuter::SetWidgetFullscreen still has the chrome\nrefresh driver frozen. No refresh tick can happen there, so the accessibility\ntree update queued when the warning popover was shown never ran, and the\nforceRefreshDriverTick() fallback in AccessibilityUtils silently did nothing.\nThe exit button had no accessible, and the a11y checks failed on the click.\n\nWaiting for FullscreenWarningOnScreen instead puts the click after the refresh\ndriver has been thawed and the accessibility tree updated.\n\nThis also re-enables the test on the Nova configuration, where the same failure\nwas skipped for bug 2057924.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315346\n", "files": ["browser/base/content/test/fullscreen/browser.toml", "browser/base/content/test/fullscreen/browser_fullscreen_toplevel_warning.js"], "git_node": "a21abb649db0e1e851565470a86a8d5db4b129d1", "git_parents": ["580b63d20423b75a0b4c1ec1b52f8dfa3cd8d1c3"], "node": "a1d0c2db642d46826f70dff765be2f233fbbfb20", "parents": ["b508d9764fe32ef65b5c7a7076c8b6b39cc606c3"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-cak/strings.xml", "mobile/android/android-components/components/compose/base/src/main/res/values-cak/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-cak/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "42f0c32b261578727774f35d0ffec51d012b7055", "git_parents": ["a21abb649db0e1e851565470a86a8d5db4b129d1"], "node": "488fe98b3b4f99b24964800960e0fd0eb3c78ca8", "parents": ["a1d0c2db642d46826f70dff765be2f233fbbfb20"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059593 - Stop passing BrowsingContext over IPC in the AutoScroll actors. r=Gijs\n\nAutoScrollChild sent its own BrowsingContext to AutoScrollParent as part\nof the \"Autoscroll:Start\" message, but a JSWindowActorParent and its\npaired JSWindowActorChild always share the same BrowsingContext, so\nAutoScrollParent can just use its own `this.browsingContext` instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315468\n", "files": ["gfx/layers/apz/test/mochitest/browser_test_autoscrolling_in_oop_frame.js", "toolkit/actors/AutoScrollChild.sys.mjs", "toolkit/actors/AutoScrollParent.sys.mjs"], "git_node": "f66e509a3edb278938cf02ad580e3e320fa261cb", "git_parents": ["42f0c32b261578727774f35d0ffec51d012b7055"], "node": "59fe4acc6388ee369aa37d9ae88458696fdbf6ac", "parents": ["488fe98b3b4f99b24964800960e0fd0eb3c78ca8"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058646, Bug 2057032 - Account initialization clean up r=jonalmeida,android-reviewers,gmalekpour\" for causing fenix failures\n\nThis reverts commit 1288aae0c463b68934ef19c0874603ee25de265a.\n\nRevert \"Bug 2057032 - Make vpn onboarding wait past WarmingUp r=android-reviewers,jonalmeida\"\n\nThis reverts commit e2f893c81ce36b7ac3d533dd6fdc2d493eeb4d75.\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionStorageSynchronizer.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/FxaAccountStoreSyncTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPrompt.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPromptTest.kt"], "git_node": "1b546bb3fbcc4bae8e1d557fabd99014c69c5208", "git_parents": ["f66e509a3edb278938cf02ad580e3e320fa261cb"], "node": "4c92ba6ec3b54924c272e028493261b2b5f3bb66", "parents": ["59fe4acc6388ee369aa37d9ae88458696fdbf6ac"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2048762 - Use AboutRedirector for about:studies r=Gijs\" for causing bc failures at browser_all_files_referenced.js\n\nThis reverts commit 5e224a98d3d72acfed2089f6c120c9f7f1f39032.\n", "files": ["browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "toolkit/components/normandy/components.conf", "toolkit/components/normandy/content/AboutPages.sys.mjs", "toolkit/components/normandy/moz.build"], "git_node": "c9f1b83187fdb20406e30f8f6025c74099dda9c6", "git_parents": ["1b546bb3fbcc4bae8e1d557fabd99014c69c5208"], "node": "82e13410209e31891bd453ea1af07aecf523a116", "parents": ["4c92ba6ec3b54924c272e028493261b2b5f3bb66"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056134: apply code formatting via Lando\" for causing failures @ script-charset-03.html\n\nThis reverts commit dc20335f97f970ec390ae3b3d00ac25a7e8fa37f.\n\nRevert \"Bug 2056134 - Part 5: Add tests. r=bthrall\"\n\nThis reverts commit 4f7ca5ec2eceb4cf1d34d1afed234e50a65c5cde.\n\nRevert \"Bug 2056134 - Part 4: Use pre-calculated fallback encoding for the classic script disk cache MIME-Type. r=bthrall\"\n\nThis reverts commit ca43921a55957dbc3ae09f0b85b2f7f740b2ac46.\n\nRevert \"Bug 2056134 - Part 3: Use pre-calculated fallback encoding for the in-memory cache key. r=bthrall\"\n\nThis reverts commit 4bfbd49f19cb87b7bdf35f4b70b016a699fe37c1.\n\nRevert \"Bug 2056134 - Part 2: Pre-calculate the fallback encoding for the classic script source. r=bthrall,dom-worker-reviewers,edenchuang\"\n\nThis reverts commit 10184ec04cafc257786697ce1269acad694f36b4.\n\nRevert \"Bug 2056134 - Part 1: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\"\n\nThis reverts commit b62c79358e5da14d009dccf0ff0c083084391cc5.\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset.js", "dom/base/test/head.js", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "dom/workers/ScriptLoader.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "remote/shared/NetworkResponse.sys.mjs"], "git_node": "079065d33b0b788f93395938d10660927761dceb", "git_parents": ["c9f1b83187fdb20406e30f8f6025c74099dda9c6"], "node": "1f4879f26c6cf87a18e67caee8addf782b776552", "parents": ["82e13410209e31891bd453ea1af07aecf523a116"], "tags": []}], "date": 1785471602, "git_changesets": ["7eb76047eae5884218382b5ed36ca79a4661d5ce", "b201e2a68fb581ea673d80791e33e81677b7ae4d", "d26b23fbfbaff0e95407a79879b7096c746ccee5", "8b39f0393b358ad23ce16f66220898d7db1aea2a", "12064225a990a4b8aad4238919b88ec96973dca8", "ec91c79685a983a4d188f1e760ddfe6cd60c009a", "fa8a0fa85767bbc9362c5d8f77fa8f5ace76a498", "4ddba77ad068bd4b5b94c550545ba566cbbdba66", "c755323a8ae7db4eaeab33631f3e3202c1891a78", "c5148bd88240f06a70add90b3583f209dab33725", "36da4bcf80727fbf0791d788ca5a4ae2d7d6d697", "64633df4508e639b633c77c6fa1739ce017194e8", "6481f0f4f8cc98c8ef305c17b6bab2f7c4161f04", "d2ae75b7d92cb5cca1b928d4ac17d066d5089f87", "7de55102858f44140bc4f2708c56afd60dc14850", "c361e0738b722f5f71ca86649784c9739c36c75f", "dee06f5188a141016070567463a3bd6b57d83c87", "e5022c041c9907699477ed3caa937461494e7464", "734eaa2b1a9e02f7eaf5b1f6f5ca8497d09a6704", "f49e44a6db6ef7b48f790210ff94e40634def087", "9a0dece0960397960c7a17c786d87d84f09aa429", "6649967a438e2d4162959955f55555b47aadbf2a", "3f8c26bb4397df7ed601f48a6b3e83076238fa7c", "e97994401d810754f213b2f1de41e50895ea1fb4", "57818d6caff53cffd278b871e3f35e36fca90cd0", "bbab723d2c28fb9ea2e99961afb90689a7dd9a4e", "327d291ca0e62ba3fbbb7463576c71e6e094fa65", "1a3d807b20cf0c0890fa7b8233a538c2c13d3572", "5ca7246eb9ae49f39853e1f14eef91f031756658", "502a4b4c175b352da4d858942842f3888233b345", "1867b3fcf31039c49e28fe1dfddc5139ed7b4917", "c2ea213cfe445ffe8ad4b110630bd67142b476bd", "d4b3d668507e4e814c6b0416bb243da29ac59fa4", "6a670b26830e34eda693981f726a88419ee229f1", "d923a0e799a3e99f5f81e6bea8858b14cfa1b24a", "884ccb6ab8db53408166fe911f2246e22a3590bc", "2a5a0815893f10114b54eb9e01af17acaa085545", "1b32a918d30f12a6f1e563012a8d236ac6fc3e5f", "5999dca9bc0f3ab71c9a49cdc36c09df80bcec71", "5bd2ff7f5f89bc8e429904cc65c679c77d65658d", "716f026a4b43bb8326c8b088841e3a3ccd2ea764", "bbb1b97860013db32f4deab162195387c3d78288", "bf164ad24e24d26338cbee5da8e2fc41