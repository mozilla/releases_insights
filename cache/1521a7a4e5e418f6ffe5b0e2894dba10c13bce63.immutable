2 Part 2 - Add tests for printing PDFs with scale factors greater than 100% r=layout-reviewers,dholbert\" for causing test_printpreview related failures.\n\nThis reverts commit 85970edefd46f9953f9d042c798086a7e39b2794.\n\nRevert \"Bug 1856162 Part 1 - Allow scaling a PDF beyond its normal page-size. r=dholbert\"\n\nThis reverts commit 8983b5063259dadfc787456fa648206e5d9c1811.\n", "files": ["layout/base/tests/chrome/printpreview_helper.xhtml", "layout/generic/nsPageFrame.cpp", "layout/generic/nsPageSequenceFrame.h", "layout/printing/nsPrintJob.cpp"], "git_node": "f48033004346edf86d7f8271e81d8472008bab1e", "git_parents": ["5f6d2d24a40b1d3ad9127dfc2429fd89518d6570"], "node": "1d2a350593716ddb30717c7f1d6bb0e5b1288948", "parents": ["f369f63080c72990454d43e538f9d1276a1aa202"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055615 - Add SpecialMessageAction that can set the browser icon by ID. r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312583\n", "files": ["toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_set_browser_icon.js"], "git_node": "9a419edb00e27d0c5d7f08f89e32e67d26fc8ee8", "git_parents": ["f48033004346edf86d7f8271e81d8472008bab1e"], "node": "1c6ca8a151283a5865bc7e49afb63fd4758492e0", "parents": ["1d2a350593716ddb30717c7f1d6bb0e5b1288948"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053034 - Update chromium-cdm to d6c4e1ea4c8fc3dcd98ac3ab5a981f63067223a4 r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310757\n", "files": ["dom/media/gmp/widevine-adapter/content_decryption_module.h", "dom/media/gmp/widevine-adapter/moz.yaml"], "git_node": "467133a85c31ea5e91f827ebedcd467b65717aeb", "git_parents": ["9a419edb00e27d0c5d7f08f89e32e67d26fc8ee8"], "node": "a579f77606f5cc54c4c3ffc1850fc204639e2ebc", "parents": ["1c6ca8a151283a5865bc7e49afb63fd4758492e0"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053034 - Apply mozilla patches for chromium-cdm r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310758\n", "files": ["dom/media/gmp/widevine-adapter/content_decryption_module.h"], "git_node": "18f0c1df66e56f41fca4c2ff2b636ca7e78e64d0", "git_parents": ["467133a85c31ea5e91f827ebedcd467b65717aeb"], "node": "95b40433a8d7aebeb113992bf5415a98ee28a064", "parents": ["a579f77606f5cc54c4c3ffc1850fc204639e2ebc"], "tags": []}, {"author": "tmanku \u003ctanvi.manku@gmail.com\u003e", "branch": "default", "desc": "Bug 2052320 - Fix size of add/edit dialogs for payments/addresses in about:preferences. r=mtigley,desktop-theme-reviewers,credential-management-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311155\n", "files": ["browser/extensions/formautofill/skin/shared/editDialog-shared.css"], "git_node": "116db7dfce146025e0d83802947151b7b889c2dd", "git_parents": ["18f0c1df66e56f41fca4c2ff2b636ca7e78e64d0"], "node": "1f2d621b589feb3b8cdc2ceb1efdc4ed35e7d088", "parents": ["95b40433a8d7aebeb113992bf5415a98ee28a064"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056031 - Fix test_popup_button.xhtml regression r=jules\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312928\n", "files": ["toolkit/content/tests/chrome/popup_trigger.js"], "git_node": "7162a1de0cf1e0f323d875f4053a51111452e2c3", "git_parents": ["116db7dfce146025e0d83802947151b7b889c2dd"], "node": "fd156e362af407473a66f9b1ade6f1a819f209fa", "parents": ["1f2d621b589feb3b8cdc2ceb1efdc4ed35e7d088"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050153 - Distinguish moz-visual-picker-item description from its accessible name. r=akulyk\n\nA moz-visual-picker-item with a label and a description exposed a run-on\naccessible name (e.g. \"Horizontal tabs Tabs at the top\"). Its role element had no\nexplicit name, so the name fell back to the whole text subtree.\n\nAdd ids to the label and description and reference them from the role element via\naria-labelledby and aria-describedby. The label becomes the accessible name and\nthe description the accessible description.\n\nAdd computed accessible name and description assertions to the test, and wire in\nthe accessibility test helpers (common.js, name.js) as support-files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312820\n", "files": ["toolkit/content/tests/widgets/chrome-nova.toml", "toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/test_moz_visual_picker.html", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker.mjs"], "git_node": "c72624295dbb0bd2c8c55f8821da54c2becd7039", "git_parents": ["7162a1de0cf1e0f323d875f4053a51111452e2c3"], "node": "811080df9ac6414be5564deca2d9de568c52f188", "parents": ["fd156e362af407473a66f9b1ade6f1a819f209fa"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050176 - Use moz-visual-picker-item title as the accessible description. r=akulyk\n\nA moz-visual-picker-item's title (tooltip) was set on the host element, so it\nbecame the host's accessible name instead of describing the role-bearing element\nthe user interacts with.\n\nMap the title onto the role element via mapped-property support, as moz-button\ndoes. It becomes the accessible description for a named item, or the accessible\nname for an image-only item. A present description (aria-describedby) takes\nprecedence over the title.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312821\n", "files": ["toolkit/content/tests/widgets/test_moz_visual_picker.html", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker.mjs"], "git_node": "dd8dcf8009fb0099ff8d03ace43bb024daa5cb33", "git_parents": ["c72624295dbb0bd2c8c55f8821da54c2becd7039"], "node": "a1b3c2d55cf19e0c975ba514c41c7cbcfa55c6f8", "parents": ["811080df9ac6414be5564deca2d9de568c52f188"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052875 - [IPC Urlbar] Give UrlbarResult a stable id. r=daleharvey\n\nResults cross the actor boundary by structured-clone, which drops object\nidentity, so the message path can't reliably match a reconstructed result back\nto the parent's context entry or the view's row. Assign each result a stable id\nwhen it is finalized in the parent and carry it over the wire, so the following\ncommit can match by id rather than by array position or identity.\n\nBehavior-neutral: nothing reads the id yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310683\n", "files": ["browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/UrlbarResult.mjs"], "git_node": "f7342dcf76d3fe5f133d06950c8899174ba5762b", "git_parents": ["dd8dcf8009fb0099ff8d03ace43bb024daa5cb33"], "node": "fec6379ccfde1414ea0047d013355a24be55e40a", "parents": ["a1b3c2d55cf19e0c975ba514c41c7cbcfa55c6f8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052875 - [IPC Urlbar] Match results by id across the actor boundary. r=daleharvey\n\nResult removal and dismissal/feedback acknowledgment located a result's context\nentry and view row by identity or rowIndex. That only worked because the\nparent's results order matched the view's row order -- an invariant the message\npath can break (a re-query racing a notification), and one acknowledgeFeedback\nhad to weaken its staleness guard around. Match by the stable id instead, so the\nremoval/acknowledgment path no longer depends on ordering or identity, and\nacknowledgeFeedback's post-await correspondence check is restored.\n\nThe removal notification now carries the result id rather than a row index, and\nthe view locates the row by id. To verify: on the direct path this is behavior-\nneutral (same instance, so id-match == indexOf and the reselection is\nunchanged); the message-path reselection now clamps to the remaining row count,\nso removing the last row can't set an out-of-bounds selection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310684\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "7445f1fe7bc6cfb389ec075a3f0d15ae9f01f99d", "git_parents": ["f7342dcf76d3fe5f133d06950c8899174ba5762b"], "node": "0a94a5fb694ff0b9982578ccf46e0c1d1331a32f", "parents": ["fec6379ccfde1414ea0047d013355a24be55e40a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052875 - [IPC Urlbar] Compare results by id across the actor boundary in urlbar tests. r=mak\n\nA provider's onEngagement runs parent-side, so on the message path it sees\nwire-reconstructed details: details.element is dropped (a DOM node can't cross\nthe actor) and details.result is a wire copy, not the view row's result object.\nTests that asserted a pick by object identity only held in-process.\n\nAdd a shared UrlbarTestUtils.assertPickedResult that compares the picked result\nby the stable id this bug adds and expects a null element on the message path,\nand use it from browser_dynamicResults.js and browser_engagement.js. The\ndirect-path assertions are unchanged.\n\nbrowser_editAndEnterWithSlowQuery.js likewise compared a selected result by\nobject identity; the view row's result is a wire copy on the message path, so\ncompare it by id there too.\n\nDrive-by: browser_engagement.js also read privateness through controller.input,\na minimal forwarding stand-in on the message path; read it from the parent\ncontroller's own isPrivate instead so the file passes on both paths.\n\nTest-only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311478\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser/browser_dynamicResults.js", "browser/components/urlbar/tests/browser/browser_editAndEnterWithSlowQuery.js", "browser/components/urlbar/tests/browser/browser_engagement.js"], "git_node": "98c7ff5ba078a4e2c17b413a0a802be683e293d5", "git_parents": ["7445f1fe7bc6cfb389ec075a3f0d15ae9f01f99d"], "node": "e735f6557e385b8785e8d11e88aa773f33b36975", "parents": ["0a94a5fb694ff0b9982578ccf46e0c1d1331a32f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053266 - [IPC Urlbar] Phase 6: Refresh a suggestion's menu commands over the message path at the show-less-frequently cap. r=mbeier\n\nAt the cap, SuggestProvider.handleShowLessFrequently refreshed the result's baked\nmenu commands and cleared the view's command cache so the command drops from the\nopen menu. On the message path both steps were lost: the refresh mutated the\nparent's throwaway result copy, and the command-cache update wasn't reachable\nthrough the ViewProxy.\n\nRoute it through the proxy like acknowledgeFeedback: updateResultMenuCommands\n(renamed from the cache-clearing invalidateResultMenuCommands) takes (resultId,\ncommands), locates the row by id, replaces its result's baked commands, and drops\nthat cache entry; handleShowLessFrequently passes the freshly\ncomputed commands (plain objects that survive the wire). Direct-path behavior is\nunchanged -- the row's result is the same instance the provider holds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310937\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/private/SuggestFeature.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_addons.js", "browser/components/urlbar/tests/quicksuggest/unit/head.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_addons.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_yelp.js", "browser/components/urlbar/tests/quicksuggest/unit/test_weather_keywords.js"], "git_node": "85f9779dfb0009b36fc668f7ee4c3bd482c5765d", "git_parents": ["98c7ff5ba078a4e2c17b413a0a802be683e293d5"], "node": "1e7269c6dbe8a62ea39202bf9ded84f585e5f4d0", "parents": ["e735f6557e385b8785e8d11e88aa773f33b36975"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053266 - [IPC Urlbar] Phase 6: Make quicksuggest dismissal register over the message path. r=mbeier\n\nParent-side engagement handling ran against the wire-reconstructed result. For a\nRust-backed suggestion, structured-clone strips the UniFFI Suggestion class, so\ndismissRustSuggestion's instanceof check rejected the object and the dismissal\nsilently no-oped.\n\nResolve the engagement result to the parent's authoritative result by id before\ndispatching to providers, so onEngagement (and its dismissResult/removeResult)\noperate on the live object -- mirroring removeResult's id match. Direct-path\nbehavior is unchanged (the id resolves to the same instance).\n\nThe dismissal tests inspected the view's (wire) result, which no longer carries\nthe live Suggestion; they now await the async onQueryResultRemoved round-trip\nafter dismissing and verify the recorded dismissal against the parent's live\nstore, rather than calling isResultDismissed on the stripped object.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310938\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_addons.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_block.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_mdn.js"], "git_node": "13ab632905469d5d2236ca1bb3f6dd97e3f55546", "git_parents": ["85f9779dfb0009b36fc668f7ee4c3bd482c5765d"], "node": "243f3941744d9a8ab9c4ec109f491b2c2b2212e8", "parents": ["1e7269c6dbe8a62ea39202bf9ded84f585e5f4d0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053266 - [IPC Urlbar] Phase 6: Carry the visible results over the message path so provider impression and abandonment hooks fire. r=mbeier\n\nnotifyEngagementChange grouped the visible results by provider from\ncontroller.view.visibleResults to drive providers' onImpression/onAbandonment\nhooks. On the message path the parent's view proxy has no results, so those\nhooks never fired -- e.g. impression counting and the quicksuggest impression\nping.\n\nShip the results shown at engagement (captured content-side, and already used to\nbuild the Glean event) in the engagement wire payload, reconstruct them\nparent-side, and pass them to notifyEngagementChange, which prefers them over the\nview. The direct path is unchanged: it passes the same view-derived results the\nfunction read before.\n\nThe reconstructed results are distinct objects from the parent's authoritative\nquery results. The impression hook flags the clicked result by id, so the\nvisible results are passed through as reconstructed; only the selected result is\nresolved back to the live result by id (extending the dismissal path's\nresolution) and given the view-assigned rowIndex the wire preserves, so the\nquicksuggest selection ping records the right position and isClicked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310939\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/UrlbarChildTelemetry.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/private/AmpSuggestions.sys.mjs", "browser/components/urlbar/tests/unit/test_UrlbarTelemetryUtils_wireSerialization.js"], "git_node": "7d48d6e8b60dde050ed43c596b06bda799bd4643", "git_parents": ["13ab632905469d5d2236ca1bb3f6dd97e3f55546"], "node": "75c0898e942c012ecade9eb057492bee40c9b2ae", "parents": ["243f3941744d9a8ab9c4ec109f491b2c2b2212e8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053266 - [IPC Urlbar] Phase 6: Route the contextual opt-in commands over the message path. r=mbeier\n\nThe contextual opt-in's onEngagement read the picked command from the name\nattribute of details.element, but the DOM element doesn't cross the actor\nboundary, so allow/dismiss/learn_more never ran parent-side.\n\nGive the controls a data-command (like other picked commands) so the command\nrides details.selType over the wire, and read it there. The commands now route\nthrough the menu-command pick path, which doesn't navigate, so close the view\nexplicitly when one resolves the prompt -- the generic pick path did this before.\n\nThe test awaits the impression round-trip (async over the wire now) and checks\nthe opt-in is no longer offered via a re-query rather than the parent's last\nquery context, which the child doesn't hold on the message path.\n\nbrowser_selectStaleResults.js read that same parent last query context to count\nthe stopped search's results; it reads the finished context that\nlastQueryContextPromise resolves with instead, which is results-bearing on both\npaths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310940\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarProviderQuickSuggestContextualOptIn.sys.mjs", "browser/components/urlbar/tests/browser/browser_selectStaleResults.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_contextual_optin.js"], "git_node": "1ca03df7e5ae8b5579fd72ea2176c2b4f3b2acd6", "git_parents": ["7d48d6e8b60dde050ed43c596b06bda799bd4643"], "node": "483391c608ea54a67f66ea966606479fe4ec0b04", "parents": ["75c0898e942c012ecade9eb057492bee40c9b2ae"], "tags": []}, {"author": "Oskar Mansfeld \u003cgit@omansfeld.net\u003e", "branch": "default", "desc": "Bug 2056075 - add ect(1) telemetry. r=necko-reviewers,mxinden,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312899\n", "files": ["netwerk/metrics.yaml", "netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "dc8fba341910907c3ffd517dcab4d0ff9fbde48a", "git_parents": ["1ca03df7e5ae8b5579fd72ea2176c2b4f3b2acd6"], "node": "04e01ac0dcd379d882f296ea565fcc437a9b42e1", "parents": ["483391c608ea54a67f66ea966606479fe4ec0b04"], "tags": []}, {"author": "andyh \u003candhuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050577 - Removed all focus promo references. r=omc-reviewers,mviar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310414\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/test/static/browser_all_files_referenced.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_mobile_downloads.js", "browser/components/asrouter/content-src/schemas/MessagingExperiment.schema.json", "browser/components/asrouter/content-src/templates/PBNewtab/NewtabPromoMessage.schema.json", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/unit/content-src/components/MobileDownloads.test.jsx", "browser/components/privatebrowsing/content/assets/focus-promo.png", "browser/components/privatebrowsing/content/assets/focus-qr-code.svg", "browser/components/privatebrowsing/content/assets/klar-qr-code.svg", "browser/components/privatebrowsing/test/browser/browser.toml", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_default_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_focus_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_nimbus_dismiss.js", "browser/locales/en-US/browser/aboutPrivateBrowsing.ftl", "browser/locales/en-US/browser/spotlight.ftl", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_spotlight_dialog.js", "toolkit/locales/en-US/toolkit/branding/brandings.ftl", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/xpcshell/test_BrowserUtils.js"], "git_node": "2db015a6d15974f467ba249c765d51901e483e15", "git_parents": ["dc8fba341910907c3ffd517dcab4d0ff9fbde48a"], "node": "ef92844e1eb9aa59d8fcba03d8b574010c12ce8c", "parents": ["04e01ac0dcd379d882f296ea565fcc437a9b42e1"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053492 - Add telemetry for potentially failing padding file update in cache manager r=dom-worker-reviewers,janv\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312986\n", "files": ["dom/cache/Manager.cpp"], "git_node": "95caea937dab5aca27d290cbab6f769eb6fd3828", "git_parents": ["2db015a6d15974f467ba249c765d51901e483e15"], "node": "c9c82a71ae89ff2312b8ea4e5dad30b359955891", "parents": ["ef92844e1eb9aa59d8fcba03d8b574010c12ce8c"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2055747 - Clamp the WebRender mask placement rect to the region the blob covers. r=gfx-reviewers,nical\n\nThe mask alpha blob is rasterized on the nearest-pixel grid at itemRect ==\nround(bounds); WebRender maps it onto the mask clip node's rect and snaps that\nrect to device pixels at frame time.\n\nSince bug 1973192, with pixel alignment disabled, imageRect was\nbounds.Intersect(GetBuildingRect()). The building rect is the border-box paint\nrect, which can exclude a partially-covered edge row that the blob did\nrasterize (the visual-overflow row of an abs-positioned masked child). Cropping\nto it there, then snapping independently at a fractional device position, landed\nthe mask ~1px below its alpha and clipped the child's top row -- a 1px gap.\n\nSend the unrounded bounds (so WebRender still snaps in lockstep with the masked\ncontent), clamped to the union of the building rect and visibleRect. visibleRect\nis the rasterized region on the blob's grid, so the union keeps edge rows the\nblob covers (fixing this bug) while still clamping away inflated bounds that were\nnever drawn into the blob -- e.g. a filter's blur region above the viewport,\nwhich a plain full-bounds placement would wrongly include and which regressed\nsvg/filters/filter-clipped-rect-01.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312929\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "layout/reftests/svg/mask-absolutely-positioned-child-gap-ref.html", "layout/reftests/svg/mask-absolutely-positioned-child-gap.html", "layout/reftests/svg/reftest.list"], "git_node": "583ad225e6ec644010eec45bf654332f6e160adb", "git_parents": ["95caea937dab5aca27d290cbab6f769eb6fd3828"], "node": "c826b2873e62e390fa33babec5bcf14e2e752055", "parents": ["c9c82a71ae89ff2312b8ea4e5dad30b359955891"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2051177 - Keep a box-shadow's snap outset at exact f32 precision r=gfx-reviewers,lsalzman\n\nBug 2052033 anchors a zero-blur box-shadow's inner ClipOut to the snapped\nelement by insetting a \"snap outset\" equal to the spread, but stored it as\nan Au (1/60px). That quantized a fractional spread by up to half an app\nunit, so when an element edge lands on a device-pixel tie the inner clip's\ntop/left edge rounds a pixel off from the outer clip, leaving that side of\nthe fake-border ring a pixel thin at some zoom / devPixelsPerPx values.\n\nThread the outset through the clip tree as an exact f32 so the anchor\nreconstructs the source rect precisely. ClipEntry keeps a manual Eq/Hash\nover the outset's raw bits, matching the existing float-key pattern.\n\nAdds a discriminating wrench reftest (inset-fake-border-tie).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312923\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/wrench/reftests/boxshadow/inset-fake-border-tie-ref.yaml", "gfx/wr/wrench/reftests/boxshadow/inset-fake-border-tie.yaml", "gfx/wr/wrench/reftests/boxshadow/reftest.list"], "git_node": "08b9350554517605aaee123d1f9a38302efdd21a", "git_parents": ["583ad225e6ec644010eec45bf654332f6e160adb"], "node": "926b0d0eb601281b377aeebccbc0f36b13cb2157", "parents": ["c826b2873e62e390fa33babec5bcf14e2e752055"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055991 - Update angle vendor directory in updatebot test yamls. r=ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312957\n", "files": ["tools/lint/test/files/updatebot/good1.yaml", "tools/lint/test/files/updatebot/no-revision.yaml"], "git_node": "7c4480112b5ab8b1897f7efcf5af40e8a1a9f90a", "git_parents": ["08b9350554517605aaee123d1f9a38302efdd21a"], "node": "864e8071a0c682d6f229758efaf44791b22ccf07", "parents": ["926b0d0eb601281b377aeebccbc0f36b13cb2157"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 1962114 - Ensure there's a new private tab after the private notification erases all private tabs r=android-reviewers,Roger\n\n- Add a new private tab if the user was in private browsing mode when they clicked on the \"Close private tabs?\" notification.\n- Refresh the private notification since it is a one-shot intent that needs to be manually restarted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312947\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/session/PrivateNotificationService.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/session/PrivateNotificationServiceTest.kt"], "git_node": "e433fa02b75e066388b81e13c20ee8de739b87fe", "git_parents": ["7c4480112b5ab8b1897f7efcf5af40e8a1a9f90a"], "node": "b4beb345aef7d4d8af2bc0638787d385bebc34d4", "parents": ["864e8071a0c682d6f229758efaf44791b22ccf07"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047788 - Animate the widgets row height when toggling show more/less r=thecount\n\nClicking show more/less previously snapped the widgets container to its new\nheight. Capture the pre-toggle height and FLIP-animate the container to its\nnew height using the same timing tokens widgets use when resizing, so the\nrow collapses and expands smoothly. Hidden widgets still use display:none so\ntab order and a11y are unaffected. The animation is skipped under\nprefers-reduced-motion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306894\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/content-src/styles/_mixins.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx"], "git_node": "18e838c2e87f0fd6cf5eba97fa53dbd2ece620e3", "git_parents": ["e433fa02b75e066388b81e13c20ee8de739b87fe"], "node": "ff019475bb4ba9142279ac8e529034b370ac0ddb", "parents": ["b4beb345aef7d4d8af2bc0638787d385bebc34d4"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054364 - Track render task grouping at sub-pass instead of surface level. r=gfx-reviewers,gw\n\nWith backdrop filters we can run into situations where a picture is rendered in two steps (two sub-passes). The first step is allocated into a shared texture atlas, then captured, and then the second step needs to render on top of the first with clearing disabled at the sub-pass level. Disabling clearing means we have to refrain from grouping other render tasks into the second sub-pass. However, since is_shared was tracked by the surface, and the first sub-pass was placed into a shared surface, the second sub-pass could in some circumstances receive other render tasks (which relied on clears but clearing was disabled, leading to glitches).\n\nThis patch tracks whether render tasks can be grouped at the sub-pass level so that the second step of a background filter can be correctly isolated even if the first step was put into a shared atlas.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313023\n", "files": ["gfx/wr/webrender/src/render_task_graph.rs"], "git_node": "d1da8f13b593c700807381cf932efff4937ef970", "git_parents": ["18e838c2e87f0fd6cf5eba97fa53dbd2ece620e3"], "node": "117959b4f67b1f4c5f1f139b829372216a79382a", "parents": ["ff019475bb4ba9142279ac8e529034b370ac0ddb"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2048590 - Lock private mode when switching to normal mode r=android-reviewers,gmalekpour\" for causing multiple regressions.\n\nThis reverts commit 7a79a868d6566f9d92aa6568910a18de477c3124.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pbmlock/PrivateBrowsingLockFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/controller/TabManagerController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pbmlock/PrivateBrowsingLockFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/TabManagementFragmentTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/controller/DefaultTabManagerControllerTest.kt"], "git_node": "df0da7af0ca67d88b20393a8c76ec3d869ccd6cd", "git_parents": ["d1da8f13b593c700807381cf932efff4937ef970"], "node": "dd0c00f4f2ebcd0845080ff26868ac605e8282b2", "parents": ["117959b4f67b1f4c5f1f139b829372216a79382a"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047788 - Animate the widgets row height when toggling show more/less r=thecount\" for causing lint failure @ Widgets.jsx\n\nThis reverts commit 18e838c2e87f0fd6cf5eba97fa53dbd2ece620e3.\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/content-src/styles/_mixins.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx"], "git_node": "9700c29486c4a9512ab80a2c7cf60e3cac5112df", "git_parents": ["df0da7af0ca67d88b20393a8c76ec3d869ccd6cd"], "node": "c24b728e6d0adec110824cc14453fa0854e961fd", "parents": ["dd0c00f4f2ebcd0845080ff26868ac605e8282b2"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055902 - Prevent long solid borders from scaling down the corner tasks. r=gfx-reviewers,gw\n\nThe solid corners don't use render tasks so they don't need to be considered when picking the largest task side.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313045\n", "files": ["gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/wrench/reftests/border/long-solid-edge-with-rounded-corner-ref.yaml", "gfx/wr/wrench/reftests/border/long-solid-edge-with-rounded-corner.yaml", "gfx/wr/wrench/reftests/border/reftest.list"], "git_node": "02e9b8be663aa257a150c340a91541fd4d78284d", "git_parents": ["9700c29486c4a9512ab80a2c7cf60e3cac5112df"], "node": "e01c15577d621b1d64838a628217fe1006bc40d2", "parents": ["c24b728e6d0adec110824cc14453fa0854e961fd"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052838 - Remove Homepage Sports Widget r=android-reviewers,android-l10n-reviewers,parker,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310848\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelperDelegate.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/HomeActivityTestRule.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppStoreReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/sports/SportsWidgetReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/sports/SportsWidgetState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/navigation/DebugDrawerRoute.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/sportswidget/SportsWidgetDebugTool.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/ui/FenixOverlay.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/fake/FakeHomepagePreview.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/interactor/HomepageInteractor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sessioncontrol/SessionControlInteractor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/CountdownCalculator.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/CountdownTime.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/MatchCardBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/MatchesResponseMapper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/Region.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportCardData.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportCardErrorState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportsController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportsInteractor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportsMatch.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportsRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/SportsWidgetMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/WorldCupMatchesRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/api/SportsDto.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/sports/client/AppServicesWorldC