ry/parsing/ellipse-rx-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/ellipse-rx-attribute-valid.svg", "testing/web-platform/tests/svg/geometry/parsing/ellipse-ry-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/ellipse-ry-attribute-valid.svg", "testing/web-platform/tests/svg/geometry/parsing/height-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/height-attribute-valid.svg", "testing/web-platform/tests/svg/geometry/parsing/r-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/r-attribute-valid.svg", "testing/web-platform/tests/svg/geometry/parsing/rx-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/rx-attribute-valid.svg", "testing/web-platform/tests/svg/geometry/parsing/ry-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/ry-attribute-valid.svg", "testing/web-platform/tests/svg/geometry/parsing/support/attribute-testcommon.js", "testing/web-platform/tests/svg/geometry/parsing/width-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/width-attribute-valid.svg", "testing/web-platform/tests/svg/geometry/parsing/x-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/x-attribute-valid.svg", "testing/web-platform/tests/svg/geometry/parsing/y-attribute-invalid.svg", "testing/web-platform/tests/svg/geometry/parsing/y-attribute-valid.svg"], "git_node": "5234e707a98f49f293527a3da1e4ddd887d7de79", "git_parents": ["ccfa3fb3c7fc2e0407aac7e994a46e037eee2b9f"], "node": "b327f15c1164e79da5645cab3cbc44556884852f", "parents": ["8ed725111ed4aca337bd169e72c93f36b223126d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057971 [wpt PR 61542] - Update wpt metadata, a=testonly\n\nwpt-pr: 61542\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/geometry/parsing/height-attribute-invalid.svg.ini", "testing/web-platform/meta/svg/geometry/parsing/height-attribute-valid.svg.ini", "testing/web-platform/meta/svg/geometry/parsing/width-attribute-invalid.svg.ini", "testing/web-platform/meta/svg/geometry/parsing/width-attribute-valid.svg.ini"], "git_node": "af948ee4509f34c5a0dc9a2252842d6287f11145", "git_parents": ["5234e707a98f49f293527a3da1e4ddd887d7de79"], "node": "bec5240e26f49289ee0f892c98deb581e837f785", "parents": ["b327f15c1164e79da5645cab3cbc44556884852f"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2057677 [wpt PR 61524] - Fix offset contours for concave corners, a=testonly\n\nAutomatic update from web-platform-tests\nFix offset contours for concave corners\n\nClamp contour miter intersections to their target edges so asymmetric\nconcave corners do not produce stray outline and shadow segments.\n\nBug: 532190484\nChange-Id: I29dfa1d4e072f1692f041417892f33ff60dfda39\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8128561\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1668453}\n\n--\n\nwpt-commits: 4e06b5db9b86f6b1f5df647c8c56112a4a5ac7b0\nwpt-pr: 61524\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/render-corner-shape.html"], "git_node": "0a027283f2ca64587cde573d60d7f1decfc8b2a6", "git_parents": ["af948ee4509f34c5a0dc9a2252842d6287f11145"], "node": "c99d26a841af9a849372e68a6e2e6f6def42c2d6", "parents": ["bec5240e26f49289ee0f892c98deb581e837f785"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057677 [wpt PR 61524] - Update wpt metadata, a=testonly\n\nwpt-pr: 61524\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini"], "git_node": "a6fa0c881b289f981ffd8730d2715cd9d181693a", "git_parents": ["0a027283f2ca64587cde573d60d7f1decfc8b2a6"], "node": "d157abc17ec298c51718baac3ea9bd106935aee1", "parents": ["c99d26a841af9a849372e68a6e2e6f6def42c2d6"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2057821 [wpt PR 61534] - Make registerAltDictionaryAndWait more robust and review usages., a=testonly\n\nAutomatic update from web-platform-tests\nMake registerAltDictionaryAndWait more robust and review usages.\n\nCurrently, `registerAltDictionaryAndWait()` calls\n`waitUntilAvailableDictionaryHeader()` which waits until a request to\n`echo-headers2.py` will be sent with an `available-dictionary` header\nmatching the dictionary hash. This does not properly works if two\ncalls of `registerAltDictionaryAndWait()` are made in the same\n`compression_dictionary_promise_test`, or can lead to flaky behavior\nif they are made in the same test file because it can race with\ntest cleanup's cache clearing. To work around these issues, we instead\nforce callers to pass distinct dictionary id and watch for the\n`Dictionary-ID` header instead. Also improve the documentation are\nverify call sites adhere to it.\n\nBug: 522338661, 40255884\nChange-Id: Ib0945969a4093b2e3abd16b222d2f7ebc2450a23\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8137103\nReviewed-by: Patrick Meenan \u003cpmeenan@chromium.org\u003e\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1668444}\n\n--\n\nwpt-commits: 020e10bcee5ec1ff7af556d1187963b0e6ab4290\nwpt-pr: 61534\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/compressed-large-resources-001.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/compressed-large-resources-002.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/dictionary-fetch-no-cors.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/dictionary-match.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/dictionary-registration.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/resources/compression-dictionary-util.sub.js"], "git_node": "bfb39ca1b853919c3ef1a233cad90324275b981a", "git_parents": ["a6fa0c881b289f981ffd8730d2715cd9d181693a"], "node": "79366a7ad7795d71b784b77e4a183fffc35cc05b", "parents": ["d157abc17ec298c51718baac3ea9bd106935aee1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057821 [wpt PR 61534] - Update wpt metadata, a=testonly\n\nwpt-pr: 61534\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/fetch/compression-dictionary/dictionary-fetch-with-link-header-in-subresources.tentative.https.html.ini"], "git_node": "e21788431eb0a1712a24219d4929857d7fb894e1", "git_parents": ["bfb39ca1b853919c3ef1a233cad90324275b981a"], "node": "fe4b98ed8856cee4df10667aeb9b376bfa8e30d2", "parents": ["79366a7ad7795d71b784b77e4a183fffc35cc05b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058174 - [wpt-sync] Update web-platform-tests to 020e10bcee5ec1ff7af556d1187963b0e6ab4290, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 020e10bcee5ec1ff7af556d1187963b0e6ab4290\nwpt-type: landing\n", "files": ["testing/web-platform/meta/css/css-animations/animation-duration-infinite.html.ini", "testing/web-platform/meta/css/css-content/element-replacement-dynamic.html.ini", "testing/web-platform/meta/css/css-overscroll-behavior/overscroll-behavior.html.ini", "testing/web-platform/meta/dom/events/scrolling/scrollend-event-fires-for-repeat-key-ending-after-scroll-container-end-is-reached.html.ini", "testing/web-platform/meta/fetch/compression-dictionary/dictionary-fetch-with-link-header-in-subresources.tentative.https.html.ini", "testing/web-platform/meta/fetch/metadata/window-open.https.sub.html.ini", "testing/web-platform/meta/html/dom/render-blocking/remove-attr-style-keeps-blocking.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/autoplay-allowed-by-permissions-policy-attribute-redirect-on-load.https.sub.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/autoplay-allowed-by-permissions-policy-attribute.https.sub.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/autoplay-allowed-by-permissions-policy.https.sub.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/autoplay-default-permissions-policy.https.sub.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/autoplay-disabled-by-permissions-policy.https.sub.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/microtasks/basic.any.js.ini", "testing/web-platform/meta/intersection-observer/transformed-iframe-002-cross-origin.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini", "testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/permissions/crashtests/permissions-query.any.js.ini", "testing/web-platform/meta/picture-in-picture/picture-in-picture-element.html.ini", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/referrer-policy/4K/gen/top.meta/unset/fetch.http.html.ini", "testing/web-platform/meta/referrer-policy/gen/srcdoc.meta/default/img-tag.http.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/web-animations/interfaces/TimelineTrigger/constructor.html.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-mediaelementaudiosourcenode-interface/mediaElementAudioSource_volumeChange.html.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/navigation_started/navigation_started.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_pen.py.ini", "testing/web-platform/meta/webdriver/tests/classic/perform_actions/pointer_touch.py.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-remote-track-mute.https.html.ini", "testing/web-platform/meta/webrtc/legacy/simplecall_callbacks.optional.https.html.ini", "testing/web-platform/meta/webrtc/protocol/codecs-subsequent-offer.https.html.ini", "testing/web-platform/meta/webrtc/protocol/rtp-demuxing.html.ini", "testing/web-platform/meta/websockets/Close-server-initiated-close.any.js.ini"], "git_node": "5126ff98f3868c4762f1854c68924a153e10c808", "git_parents": ["e21788431eb0a1712a24219d4929857d7fb894e1"], "node": "925a1e9c26fe6320059663399cc83e1a688a8fba", "parents": ["fe4b98ed8856cee4df10667aeb9b376bfa8e30d2"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058295 - Document the prepare and visibility modules. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314487\n", "files": ["gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "e6f28dc04b4de484c40756bf304e4066d2d95366", "git_parents": ["5126ff98f3868c4762f1854c68924a153e10c808"], "node": "c0493b7512ec2b670eb392e1b1dcd4ca8f1462f1", "parents": ["925a1e9c26fe6320059663399cc83e1a688a8fba"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021324 - Disambiguate the tracy and gecko profiler integrations. r=gfx-reviewers,gw\n\nAfter this patch:\n - profile_marker hooks into both tracy and the gecko profiler. It should be used somewhat sparingly since each label adds a track/line in the gecko profiler UI, so we don't want hundreds of them.\n - tracy_rs::profile_scope hooks into tracy. The tracy_rs:: prefix cannot be omitted so there is less risk of incorrectly epxecting the info to show up in gecko profiles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286280\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/glyph_cache.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task_cache.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/resource_cache.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender/src/texture_cache.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "2374e0db68312da4d56959ffac941ef951adaa22", "git_parents": ["e6f28dc04b4de484c40756bf304e4066d2d95366"], "node": "95f93fb3cc6f9540ea7dc33064ff319d3b2629df", "parents": ["c0493b7512ec2b670eb392e1b1dcd4ca8f1462f1"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021324 - Rename webrender's profiler feature into tracy. r=gfx-reviewers,gw\n\nWebRender exposes some form of profiler integration either way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286281\n", "files": ["gfx/wr/examples/Cargo.toml", "gfx/wr/webrender/Cargo.toml", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/wrench/Cargo.toml"], "git_node": "60418492c3d8fa85ac6124451eabd14e89216244", "git_parents": ["2374e0db68312da4d56959ffac941ef951adaa22"], "node": "72a52ae68e7ac036425b5b17e0c5f2a5