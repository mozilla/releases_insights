-stack/s0122.patch", "third_party/libwebrtc/moz-patch-stack/s0123.patch", "third_party/libwebrtc/moz-patch-stack/s0124.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch", "third_party/libwebrtc/moz-patch-stack/s0126.patch", "third_party/libwebrtc/moz-patch-stack/s0127.patch", "third_party/libwebrtc/moz-patch-stack/s0128.patch", "third_party/libwebrtc/moz-patch-stack/s0129.patch", "third_party/libwebrtc/moz-patch-stack/s0130.patch", "third_party/libwebrtc/moz-patch-stack/s0131.patch", "third_party/libwebrtc/moz-patch-stack/s0132.patch", "third_party/libwebrtc/moz-patch-stack/s0133.patch", "third_party/libwebrtc/moz-patch-stack/s0134.patch", "third_party/libwebrtc/moz-patch-stack/s0135.patch", "third_party/libwebrtc/moz-patch-stack/s0136.patch", "third_party/libwebrtc/moz-patch-stack/s0137.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/moz-patch-stack/s0140.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/moz-patch-stack/s0142.patch", "third_party/libwebrtc/moz-patch-stack/s0143.patch", "third_party/libwebrtc/moz-patch-stack/s0144.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/test/fake_periodic_video_source.h", "third_party/libwebrtc/pc/test/fake_video_track_source.h", "third_party/libwebrtc/pc/video_rtp_track_source.h", "third_party/libwebrtc/sdk/BUILD.gn", "third_party/libwebrtc/sdk/objc/native/src/objc_video_track_source.h", "third_party/libwebrtc/test/BUILD.gn", "third_party/libwebrtc/test/test_video_capturer.h", "third_party/libwebrtc/unsafe_buffers_paths.txt", "third_party/libwebrtc/video/BUILD.gn", "third_party/libwebrtc/video/config/BUILD.gn", "third_party/libwebrtc/video/config/encoder_stream_factory.cc", "third_party/libwebrtc/video/video_stream_encoder_unittest.cc"], "git_node": "e64b031d2e2de01dabc69cb23fab2437f3b5ca67", "git_parents": ["04d80f6fb6953434477780056124b81242d3eb77"], "node": "fd555fc7f814ab1019491d1075cd37f9334aa7e5", "parents": ["df210885b30a1670d60627df8e345a831f74caad"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 0590643ffe - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/api/video/adapted_video_track_source_gn/moz.build", "third_party/libwebrtc/api/video/video_adapter_gn/moz.build", "third_party/libwebrtc/api/video/video_broadcaster_gn/moz.build", "third_party/libwebrtc/api/video/video_common_gn/moz.build", "third_party/libwebrtc/media/adapted_video_track_source_gn/moz.build", "third_party/libwebrtc/media/video_adapter_gn/moz.build", "third_party/libwebrtc/media/video_broadcaster_gn/moz.build", "third_party/libwebrtc/media/video_common_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": "21cdf4cb78fc06f50e374cf1cc0989dd043c850b", "git_parents": ["e64b031d2e2de01dabc69cb23fab2437f3b5ca67"], "node": "9dab6d7f9a27c4d7c045816acb67546097946d57", "parents": ["fd555fc7f814ab1019491d1075cd37f9334aa7e5"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 4820cf11c5\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in 3590bc3fc9.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4820cf11c56af592ea4ed02cbce7c0b1a7656fbe\n    Sframe encryptor implementation\n\n    This CL introduces the concrete Sframe encryptor that sits between the\n    public key-management API and the media pipeline, implementing the\n    sender-side wiring for Sframe end-to-end encryption.\n\n    # High-level design\n    The implementation follows a three-layer split that matches the existing\n    WebRTC layering and respects the api/ visibility rules: 1. Public API\n    layer (api/sframe/) - A narrow, stable interface that exposes only key\n    management to applications: setting an encryption key on the sender\n    side.\n\n    2. Internal media interface layer (modules/sframe/) - Extends the public\n    key-management interface with the Encrypt and \"max ciphertext size\"\n    entry points used by the media pipeline. This is the surface the media\n    channel speaks to; application code never sees it.\n\n    3. Concrete impl layer (modules/sframe/) - Implements the media\n    interface on top of the cisco/sframe library.\n\n    Splitting key management from frame protection lets the public handle\n    expose only the small surface applications need, while the media\n    pipeline talks to a richer interface internally.\n\n    Bug: webrtc:479862368\n    Change-Id: Id93dba5874b6f5b1f32723755dd404af202f6ecf\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/481301\n    Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48065}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/3590bc3fc9.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch"], "git_node": "20b50da869ca8887f185e080476c23627455b159", "git_parents": ["21cdf4cb78fc06f50e374cf1cc0989dd043c850b"], "node": "d7346b3b9f6af3552cd1a1201f178cb9d1e638de", "parents": ["9dab6d7f9a27c4d7c045816acb67546097946d57"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from e9b42b2c51\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e9b42b2c51eabd24d8abcc9e8bc7ffa8a4a577b3\n    Update VCMTiming to use VideoJitterTimingInterface.\n\n    - Make DefaultVideoJitterTiming implement VideoJitterTimingInterface.\n    - Add a new constructor to VCMTiming that accepts a VideoJitterTimingInterface implementation (falls back to DefaultVideoJitterTiming if not provided).\n\n    Bug: b/493549134\n    Change-Id: I6bda979a10824dc02b85bb1f0e074796496ac054\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484680\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Commit-Queue: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48066}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/timing/BUILD.gn", "third_party/libwebrtc/modules/video_coding/timing/default_video_jitter_timing.cc", "third_party/libwebrtc/modules/video_coding/timing/default_video_jitter_timing.h", "third_party/libwebrtc/modules/video_coding/timing/default_video_jitter_timing_unittest.cc", "third_party/libwebrtc/modules/video_coding/timing/timing.cc", "third_party/libwebrtc/modules/video_coding/timing/timing.h", "third_party/libwebrtc/modules/video_coding/timing/timing_unittest.cc"], "git_node": "39083b6af7780c7392a92e0052dc3fbea3c588be", "git_parents": ["20b50da869ca8887f185e080476c23627455b159"], "node": "46463e95cf0993c399351950329797c54f5338d3", "parents": ["d7346b3b9f6af3552cd1a1201f178cb9d1e638de"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from e9b42b2c51 - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/api/video/timing/video_jitter_timing_interface_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": "727b701ce8d80c181e2dc1665801efdcb5f788d0", "git_parents": ["39083b6af7780c7392a92e0052dc3fbea3c588be"], "node": "e2e2b10eb99ddd1253e484c70fd5dbfe1a45c7e7", "parents": ["46463e95cf0993c399351950329797c54f5338d3"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 7519a77ce1\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7519a77ce1b1add58e5bae145fe0ac249f71f12b\n    Add RtpDepacketizerSframe (SFrame RTP depacketizer)\n\n    Introduces a stateless parser for the 1-byte SFrame RTP payload\n    descriptor. RtpDepacketizerSframe::Parse() takes an RtpPacketReceived,\n    parses the S/E/T bits into an SFrameDescriptor, strips the descriptor\n    byte from the payload, and returns the result as an\n    SframeRtpPacketReceived which downstream code (the SFrame packet\n    buffer) can use for assembly without re-parsing the wire format.\n\n    Bug: webrtc:479862368\n    Change-Id: I9fc2916cd84ff1fc798c28ee6ed5739066a37491\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/480120\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48067}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/rtp_rtcp/BUILD.gn", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_depacketizer_sframe.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_depacketizer_sframe.h", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_depacketizer_sframe_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/sframe_descriptor.h"], "git_node": "32ff0f6208db8fb9bf174479db1eb4c7c104d593", "git_parents": ["727b701ce8d80c181e2dc1665801efdcb5f788d0"], "node": "765361edafaf8d724f3488a3ec3ab033857a9c40", "parents": ["e2e2b10eb99ddd1253e484c70fd5dbfe1a45c7e7"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 7519a77ce1 - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/modules/rtp_rtcp/rtp_rtcp_gn/moz.build", "third_party/libwebrtc/modules/rtp_rtcp/sframe_descriptor_gn/moz.build", "third_party/libwebrtc/modules/rtp_rtcp/sframe_rtp_packet_received_gn/moz.build", "third_party/libwebrtc/moz.build"], "git_node": "054a8a9035502ac4882390b0b315bbf15c5970f7", "git_parents": ["32ff0f6208db8fb9bf174479db1eb4c7c104d593"], "node": "123cbba43a9e21642aeb4ac9a10acb77d103fe81", "parents": ["765361edafaf8d724f3488a3ec3ab033857a9c40"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 25ded3fc77\n\nUpstream commit: https://webrtc.googlesource.com/src/+/25ded3fc778871d2af990abb40d6447c54e9f19e\n    Adding thread checker for audio record on native APIs\n\n    Implemented thread safety checks in WebRtcAudioRecord.java using ThreadUtils.ThreadChecker, matching the pattern in WebRtcAudioTrack.java. The checker is detached in the constructor and guards @CalledByNative control APIs (initRecording, startRecording, stopRecording, enableBuiltInAEC, enableBuiltInNS) to ensure they are called consistently from the same C++ worker thread. To prevent crashes, Java-only public APIs (such as setPreferredDevice and setMicrophoneMute) and read-only query APIs remain unguarded as they are expected to be called from application or stats threads.\n\n    Bug: webrtc:524395191\n    Change-Id: I432b9f6f8da1ead5e3ff021dfef4c6e12ef6557f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484740\n    Reviewed-by: Henrik Lundin \u003chenrik.lundin@webrtc.org\u003e\n    Reviewed-by: Henrik Andreassson \u003chenrika@webrtc.org\u003e\n    Commit-Queue: Tim Na \u003cnatim@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48068}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0142.patch", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/audio/WebRtcAudioRecord.java"], "git_node": "513ddd0f51a12a8b9021bca8c1ab95e14c43ab11", "git_parents": ["054a8a9035502ac4882390b0b315bbf15c5970f7"], "node": "79209e1e6ce08c7c1a3113e5c4dd57a8aeab796c", "parents": ["123cbba43a9e21642aeb4ac9a10acb77d103fe81"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 0caa8e00c7\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0caa8e00c735ecc7615dc249e51aeed73d38b155\n    Roll chromium_revision 1f12820c93..31af8a3bc7 (1650828:1651123)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/1f12820c93..31af8a3bc7\n    Full diff: https://chromium.googlesource.com/chromium/src/+/1f12820c93..31af8a3bc7\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/06e395135f..bd86dae874\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/7782a734d3..d31b0403c7\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/ffd5efb795..96cb8b22ec\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/dd440454f8..dbae726227\n    * src/third_party/perfetto: https://chromium.googlesource.com/external/github.com/google/perfetto.git/+log/7f813cb4e9..b2c16893e2\n    * src/tools: https://chromium.googlesource.com/chromium/src/tools/+log/d5602d1db8..64e35c5377\n    DEPS diff: https://chromium.googlesource.com/chromium/src/+/1f12820c93..31af8a3bc7/DEPS\n\n    BUG=None\n\n    Change-Id: I649b200583b6f85b576ded5bcb6db75f80b718d5\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485000\n    Bot-Commit: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48069}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "9851e72261e95a0b9d82014e70572211c41179db", "git_parents": ["513ddd0f51a12a8b9021bca8c1ab95e14c43ab11"], "node": "a36dc72771608683fcb66f2848adfb681e1204d4", "pa