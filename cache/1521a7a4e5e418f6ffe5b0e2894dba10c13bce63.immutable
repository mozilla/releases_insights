ird_party/pipewire/spa/support/plugin-loader.h", "third_party/pipewire/spa/support/plugin.h", "third_party/pipewire/spa/support/system.h", "third_party/pipewire/spa/support/thread.h", "third_party/pipewire/spa/utils/atomic.h", "third_party/pipewire/spa/utils/cleanup.h", "third_party/pipewire/spa/utils/defs.h", "third_party/pipewire/spa/utils/dict.h", "third_party/pipewire/spa/utils/dll.h", "third_party/pipewire/spa/utils/enum-types.h", "third_party/pipewire/spa/utils/hook.h", "third_party/pipewire/spa/utils/json-core.h", "third_party/pipewire/spa/utils/json-pod.h", "third_party/pipewire/spa/utils/json.h", "third_party/pipewire/spa/utils/keys.h", "third_party/pipewire/spa/utils/list.h", "third_party/pipewire/spa/utils/ratelimit.h", "third_party/pipewire/spa/utils/result.h", "third_party/pipewire/spa/utils/ringbuffer.h", "third_party/pipewire/spa/utils/string.h", "third_party/pipewire/spa/utils/type-info.h", "third_party/pipewire/spa/utils/type.h"], "git_node": "2c5f507b08ad5ac688cd2fb5065fa57f4cd50918", "git_parents": ["4c6076be4cef3427b7c0843def5d276a04cefe28"], "node": "40eca849791a8df328b75fc7db133f23b76c50fe", "parents": ["bf7c1b9190af852220c980daaa84bba20b369ba3"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2060289 - Add ignoreUsingDeclarations: true to no-unused-vars rule in configs/recommended.mjs r=Standard8,frontend-codestyle-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316250\n", "files": ["testing/mochitest/tests/Harness_sanity/test_SpecialPowersPushPrefEnv.html", "tools/lint/eslint/eslint-plugin-mozilla/lib/configs/recommended.mjs"], "git_node": "b3055aba89aa32752e9331384f5f076578b425ed", "git_parents": ["2c5f507b08ad5ac688cd2fb5065fa57f4cd50918"], "node": "5d352402edce19febadb323a6ddda982cdb3813d", "parents": ["40eca849791a8df328b75fc7db133f23b76c50fe"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058329 - Add localized strings and about:smartwindowtasks link in Monitor inline chat message r=ngrato,fluent-reviewers,bolsson,ai-security-reviewers,tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315044\n", "files": ["browser/components/aiwindow/ui/actors/AIChatContentParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.mjs", "browser/components/aiwindow/ui/content/aiChatContent.html", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aichat_open_link.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agentui_command.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatConversation.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "6e3184118ccc0997137cceb7f465223e3191eb28", "git_parents": ["b3055aba89aa32752e9331384f5f076578b425ed"], "node": "a615e9fad86af48004b88c50f4b9915d30caac72", "parents": ["5d352402edce19febadb323a6ddda982cdb3813d"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1731313 - Add support for reordering containers r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315903\n", "files": ["browser/components/preferences/config/containers.mjs", "browser/components/preferences/tests/privacy/browser-srd.toml", "browser/components/preferences/tests/privacy/browser.toml", "browser/components/preferences/tests/privacy/browser_containers_reorder.js", "toolkit/components/contextualidentity/ContextualIdentityService.sys.mjs", "toolkit/components/contextualidentity/tests/unit/test_basic.js"], "git_node": "6f3cb8d7e78d940e1fdd47b2b0e72a91ab34451d", "git_parents": ["6e3184118ccc0997137cceb7f465223e3191eb28"], "node": "bf2cb6a51f8547820fab324478140c788472ca7d", "parents": ["a615e9fad86af48004b88c50f4b9915d30caac72"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056993 - Give speculation-rules prefetch channels a BrowsingContext-aware LoadInfo so DevTools can attribute them. r=valentin,bomsy\n\nPrefetchRecordParent::Init() created its channel via NS_NewChannelInternal\nwith a null aLoadingNode, since it runs in the parent process. The\nresulting nsILoadInfo had no associated BrowsingContext, so DevTools'\nNetwork panel which attributes requests to a tab by BrowsingContext ID\nis silently dropped every prefetch request.\n\nUse LoadInfo::CreateForNonDocument(aWGP, ...) instead, which derives the\nBrowsingContext ID (and CookieJarSettings) from the WindowGlobalParent\nalready available in Init(), matching the pattern used for other\nparent-process-initiated loads such as object/embed loads in\nDocumentLoadListener.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316252\n", "files": ["dom/ipc/PrefetchRecordParent.cpp"], "git_node": "b2c421ce28f2aad3a6abd27a7dd6508661810d42", "git_parents": ["6f3cb8d7e78d940e1fdd47b2b0e72a91ab34451d"], "node": "938051e85137465d978005390a9eba52cdb6f313", "parents": ["bf2cb6a51f8547820fab324478140c788472ca7d"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044501 - Add moz-WPT for new media-capabilities supports-cache pref. r=media-playback-reviewers,alwu\" for causing wpt unexpected passes.\n\nThis reverts commit a53d0867cbd629506409a6878624a59d60df69f0.\n\nRevert \"Bug 2044501 - Add cached async codec-support path for MediaCapabilities decode behind a pref. r=media-playback-reviewers,alwu\"\n\nThis reverts commit 76004a6b2462d6faadb10803de77d8d63157f4c9.\n\nRevert \"Bug 2044501 - Add RemoteMediaManagerChild::EnsureCodecSupportFor for async HW codec support queries. r=media-playback-reviewers,alwu\"\n\nThis reverts commit 4d91a741e3ca769461a20d82ce1011e16cb3e92f.\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/ipc/RemoteDecoderModule.h", "dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/ipc/RemoteMediaManagerChild.h", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/mediacapabilities/MediaCapabilities.h", "dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/PDMFactory.h", "dom/media/platforms/PDMFactorySupport.cpp", "dom/media/platforms/PDMFactorySupport.h", "dom/media/platforms/PlatformDecoderModule.h", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/meta/media-capabilities/encodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/tests/media-capabilities/decodingInfo-api-modes.any.js", "testing/web-platform/mozilla/tests/media-capabilities/encodingInfo-api-modes.any.js"], "git_node": "c2d4b77e23d00b1dc3c7d70bd97504773a0a5694", "git_parents": ["b2c421ce28f2aad3a6abd27a7dd6508661810d42"], "node": "244cce54d73d509447ca4054aa58397817f49a7b", "parents": ["938051e85137465d978005390a9eba52cdb6f313"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057935 - Skip helpSwitchDevice in browser_help_panel_cloning.js when Nova is enabled r=Gijs\n\nbrowser_help_panel_cloning.js iterates every non-hidden \u003cmenuitem\u003e in menu_HelpPopup and asserts a corresponding #appMenu_\u003cid\u003e clone exists in PanelUI-helpView. The helpSwitchDevice menuitem is not hidden, but when browser.nova.enabled is true panelUI.js replaces its clone (#appMenu_helpSwitchDevice) with a moz-promo element, so the clone is absent and the Assert.ok fails on the Nova test variant.\n\nPer the module peer's guidance (comment 2), rather than pinning the pref off (brittle once the pref is removed), skip the helpSwitchDevice item in the cloning loop when Nova is enabled, with an info() pointing at browser_novaHelpSwitchDevicePromo.js, which already covers the promo-replacement behavior. Once browser.nova.enabled is removed, getBoolPref returns the false default and the skip never triggers, so this block can simply be deleted with the pref.\n\nAlso removes the now-unnecessary skip-if = [\"nova\"] rule for this file so it runs on the Nova variant again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315998\n", "files": ["browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_help_panel_cloning.js"], "git_node": "be2d8f21fd5b1be7a78f193688f45f3f0846c5ef", "git_parents": ["c2d4b77e23d00b1dc3c7d70bd97504773a0a5694"], "node": "924f814eeb81a145e7b8aae57a6e19c411a7c29c", "parents": ["244cce54d73d509447ca4054aa58397817f49a7b"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060518: Update login-line styles in contextual password manager. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316267\n", "files": ["toolkit/components/satchel/megalist/content/components/login-line/login-line.css", "toolkit/components/satchel/megalist/content/components/password-card/password-card.css", "toolkit/components/satchel/megalist/content/components/password-card/password-card.mjs"], "git_node": "be03f4a8bd92dadf04a9421f7c65fefc8e8c0e46", "git_parents": ["be2d8f21fd5b1be7a78f193688f45f3f0846c5ef"], "node": "08441780bcfb380d2440089f914c0678659f59f7", "parents": ["924f814eeb81a145e7b8aae57a6e19c411a7c29c"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042994 - Parse and serialize -webkit-line-clamp as a legacy shorthand for line-clamp. r=AlaskanEmily,dshin,firefox-style-system-reviewers,emilio\n\nThis also adds special handling for the case where modern line-clamp property\nis pref disabled, but we still want the legacy -webkit-line-clamp to work\nwithout exposing disabled line-clamp. Removed -webkit-line-clamp longhand.\n\nUpdate property database and style tests so -webkit-line-clamp is\nrepresented as a legacy shorthand instead of as a longhand. Teach test\nhelpers to skip disabled subproperties when handling shorthands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312529\n", "files": ["devtools/server/actors/animation-type-longhand.js", "layout/style/nsStyleStruct.cpp", "layout/style/test/property_database.js", "layout/style/test/test_all_shorthand.html", "layout/style/test/test_ch_ex_no_infloops.html", "layout/style/test/test_inherit_computation.html", "layout/style/test/test_inherit_storage.html", "layout/style/test/test_initial_computation.html", "layout/style/test/test_initial_storage.html", "layout/style/test/test_property_database.html", "layout/style/test/test_transitions_per_property.html", "layout/style/test/test_value_computation.html", "layout/style/test/test_value_storage.html", "servo/components/style/properties/data.py", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/style_adjuster.rs", "servo/components/style/values/generics/box.rs", "servo/components/style/values/specified/box.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-019.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-034.html.ini"], "git_node": "1e047fb768e6c991eddfed7981160af017633c28", "git_parents": ["be03f4a8bd92dadf04a9421f7c65fefc8e8c0e46"], "node": "547f6ad11e66e9750ead731314702a634871065e", "parents": ["08441780bcfb380d2440089f914c0678659f59f7"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1882241 - multiple bookmarks updates star. r=places-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315814\n", "files": ["browser/base/content/browser-places.js", "browser/components/places/tests/browser/browser.toml", "browser/components/places/tests/browser/browser_bookmarkStar_multipleBookmarks.js"], "git_node": "d8067bafa502d3e0ef1f68e2ee9667a3b766bed5", "git_parents": ["1e047fb768e6c991eddfed7981160af017633c28"], "node": "998ec71dd48fbc9d4e3d48974356b5cbf875f7e1", "parents": ["547f6ad11e66e9750ead731314702a634871065e"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060653 - Remove unused RemoteMediaDataEncoderParent::mManagerThread member r=aosmond,media-playback-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316362\n", "files": ["dom/media/ipc/RemoteMediaDataEncoderParent.h"], "git_node": "865645f919070e0ccab8588a17784f13543fc26f", "git_parents": ["d8067bafa502d3e0ef1f68e2ee9667a3b766bed5"], "node": "696a13a85b0ff53953df77fc0546ef0357ef6b0b", "parents": ["998ec71dd48fbc9d4e3d48974356b5cbf875f7e1"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2056195 - Follow HTTPS AliasMode and connect to the target name even when the target does not have a HTTPS record r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313153\n", "files": ["netwerk/dns/GetAddrInfo.cpp", "netwerk/dns/TRR.cpp", "netwerk/dns/TRR.h", "netwerk/protocol/http/HTTPSRecordResolver.cpp", "netwerk/test/unit/test_dns_override.js", "netwerk/test/unit/test_trr_httpssvc.js", "netwerk/test/unit/test_use_httpssvc.js"], "git_node": "7c675b516609efb6c6a2cb67703c1d12f43a0d76", "git_parents": ["865645f919070e0ccab8588a17784f13543fc26f"], "node": "1a25ad4201b60efeb5d42851e245b0f44ad755b5", "parents": ["696a13a85b0ff53953df77fc0546ef0357ef6b0b"], "tags": []}, {"author": "Dharma Ong \u003cdharmaong00@gmail.com\u003e", "branch": "default", "desc": "Bug 2042945 - Add telemetry to measure how often users search a query in search mode that looks like a URL. r=mak,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304558\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/metrics.yaml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser.toml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_engagement_search_mode_url_like.js", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "984bca2bb4711293d0824bd9a7c58df0d834f34d", "git_parents": ["7c675b516609efb6c6a2cb67703c1d12f43a0d76"], "node": "bfa796e8486dce8d837f7a9dae79d245a83db9a9", "parents": ["1a25ad4201b60efeb5d42851e245b0f44ad755b5"], "tags": []}, {"author": "Ben Dean-Kawamura \u003cbdk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060244 - Vets for UniFFI 0.32, r=janerik,supply-chain-reviewers\n\nAdding vets ahead of time so that we can take the UniFFI 0.32 release.\nThis will be alongside a Glean release and app-services vendor that also\nupgrade UniFFI.\n\nThe versions here come from audit failures from Glean's CI when they\ntried to do the upgrade.  I think the patch versions could be a bit\ndifferent -- there are newer versions in a couple cases.  However, I\nwent with the ones that cargo chose for the Glean PR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316340\n", "files": ["supply-chain/audits.toml"], "git_node": "f892c4a858ac24b2e94d09fc1219da62695c8b5d", "git_parents": ["984bca2bb4711293d0824bd9a7c58df0d834f34d"], "node": "25b6f138c77e1b2426ee4a4e2d8acee8f20c3363", "parents": ["bfa796e8486dce8d837f7a9dae79d245a83db9a9"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059845 - Suggest agents remind forgetful users to update their AI tooling. r=ai4dev-reviewers,marco DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315717\n", "files": ["AGENTS.md"], "git_node": "4226c86e3c1a4b7601790717ddac723bff93b90b", "git_parents": ["f892c4a858ac24b2e94d09fc1219da62695c8b5d"], "node": "37a7eb29353a5996b96ccbfc0dcf6194ed3d35bc", "parents": ["25b6f138c77e1b2426ee4a4e2d8acee8f20c3363"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060267 - [efficiency] Convert three MainMenuTest smoke tests to ui/efficiency r=isabel_rios,aaronmt\n\nConverts three legacy MainMenuTest smoke tests onto the ui/efficiency framework:\n\n  MainMenuTest.verifyTheReportBrokenSiteSubMenuOptionTest            (TestRail 3080112)\n  MainMenuTest.verifyTheExtensionsMainMenuListTest                   (TestRail 3080134)\n  MainMenuTest.verifyTheMainMenuBackButtonLongClickFromCustomTabTest (TestRail 4245663)\n\nThe first two land in efficiency/tests/MainMenuTest; the custom-tab one lands in\nefficiency/tests/CustomTabsTest alongside the other converted custom-tab main-menu tests.\n\nHarness enablement these conversions required:\n\nReport broken site was not modelled at all, so this adds a WebCompatReporterPage page object and\nWebCompatReporterSelectors, with a MainMenuPage -\u003e WebCompatReporterPage edge that expands the More\nsubmenu first (the entry is browser-only; there is none from the home-page main menu).\n\nCustomTabsSelectors gains MENU_BACK_COMPOSE. mozLongClick dispatches on the resolved element type:\nthe existing UIAutomator MENU_BACK resolves to a UiObject and gets UiObject.longClick(), which uses\nthe ~500ms system long-press timeout. This Compose button does not register that as a long press --\nit lands as a plain click and merely navigates back, so no tab-history sheet ever appears. The\nCompose path instead does composeLongClick(5000ms), matching the legacy robot's\nonNodeWithText(\"Back\") + LONG_CLICK_DURATION.\n\nTabHistorySelectors gains TAB_HISTORY_LIST_UIAUTOMATOR. Espresso resolves against the resumed\nactivity's hierarchy, which is CustomTabActivity inside a custom tab while the test rule's context is\nHomeActivity. The ESPRESSO_BY_ID lookup therefore misses, and the harness then tries to launch\nHomeActivity and times out after 45s. UIAutomator matches device-wide, so it is activity-agnostic --\nand it is what the legacy assertion used.\n\nMainMenuSelectors gains REPORT_BROKEN_SITE_BUTTON, EXTENSIONS_CHEVRON,\nTRY_RECOMMENDED_EXTENSION_BUTTON, DISCOVER_MORE_EXTENSIONS_BUTTON and RECOMMENDED_ADDON_ITEM. Note\nRECOMMENDED_ADDON_ITEM keys on the addon row, not RECOMMENDED_ADDON_ITEM_TITLE: that tag is applied\nvia labelModifier, so the row's merged semantics hide it and a merged-tree onAllNodesWithTag cannot\nsee it.\n\nParity gap: legacy verifyTheRecommendedAddons asserted three named addons, each with its own\n\"Add \u003caddon\u003e\" install button, retrying against a hardcoded candidate list. The port asserts that a\nrecommended-addon row is present instead, since which addons AMO recommends is server-driven and\nmatching on names couples the test to remote data. The install-button check did not carry over. The\nother two tests carry over every legacy assertion explicitly.\n\nThe three legacy tests are annotated with @Converted pointing at their replacements, matching how\nthe rest of this campaign has landed. They keep running alongside the replacements; the annotation is\nwhat the conversion burndown keys off.\n\nAlso corrects the conversion docs, which said to add that marker only once the replacement was green\n\"and landed\". That is not what this campaign does -- every conversion so far has landed the annotation\nin the same commit as its replacement -- and following it literally means the conversion lands looking\nunconverted to the ledger, since a post-landing annotation would need its own bug and review.\n\n# Conflicts:\n#\tmobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316062\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/converting-a-test.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/writing-a-test.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/WebCompatReporterPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/CustomTabsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/TabHistorySelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/WebCompatReporterSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CustomTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "65b3d8630090a9bed2b3e6f9dd1c51109f30a6ec", "git_parents": ["4226c86e3c1a4b7601790717ddac723bff93b90b"], "node": "2e0e38f0b2180c56225576c49b248c5ad3b4bd99", "parents": ["37a7eb29353a5996b96ccbfc0dcf6194ed3d35bc"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060280 - [efficiency] Refresh harness docs: drop stale files, document the tracking meta bug, normalize with prettier r=isabel_rios,aaronmt\n\nDeletes nine stale docs under ui/efficiency/docs/ that describe the removed\nSteps/FeatureSpec/factory-tier model:\n\n  ArchitectureOverview.md   TestAutomationStrategy.md   TestFactoryDesignGoals.md\n  FeatureSpecDataModel.md   FeatureLayer.md             StepsLayer.md\n  Factories.md              LoggingLayer.md             DebugUtilities.md\n\nAll nine were last touched 2025-10-31/2025-11-12, while every doc that survives dates from\n2026-07-29 or later. docs/README.md already listed exactly these nine as \"should be deleted\"; that\nmaintenance note goes away with them, since it only existed to flag the pending removal.\n\nChecked before removing, rather than going on the filename convention alone: the model they document\nis gone from the code (no FeatureSpec/StepsLayer identifiers remain anywhere), the live factory story\nis covered by architecture.md (\"The factories (generation/) - status is honest\", Reachability factory),\nand nothing outside that README note linked to any of them. So no current information is lost.\n\nDocuments a step that was missing from the conversion workflow: each conversion bug has to block the\ntracking meta bug 2030727 ([meta] TAE - Migrate and remove legacy tests), which tracks the campaign\nthrough its depends_on list. A conversion that never gets linked is invisible to anyone reading the meta\nfor status. converting-a-test.md step 8 now says so, and scopes it: test-conversion bugs go on the meta,\ntooling/docs/harness bugs stay off it.\n\nThe remaining docs are normalized with prettier. This is not a lint-gate fix: rumdl covers\nmobile/android/fenix/docs/ but not app/src/androidTest/.../efficiency/docs/, and .prettierrc.js has no\nmarkdown override wired into mozlint, so nothing in-tree enforces formatting on these files. It is a\none-time normalization for consistency.\n\nOne correctness fix rides along. Prettier's *emphasis* -\u003e _emphasis_ rewrite corrupted a bare\n\"isabel_rios\" into \"isabel*rios\" in converting-a-test.md, and left the emphasis unclosed - opening\nwith `*(` and closing with `)\\_`. The reviewer names are now in backticks so the underscore sits in a\ncode span and cannot be reinterpreted by a future prettier run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316063\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effpretty/README.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effview/README.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/ArchitectureOverview.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/DebugUtilities.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/Factories.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/FeatureLayer.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/FeatureSpecDataModel.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/LoggingLayer.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/README.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/StepsLayer.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/TestAutomationStrategy.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/TestFactoryDesignGoals.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/architecture.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/converting-a-test.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/gotchas.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/adding-navigation.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/authoring-selectors.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/creating-a-page-object.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/debugging-tests.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/discovering-selectors.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/extending-basepage.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/guides/writing-a-test.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/tooling.md"], "git_node": "170b1cf2f0d9fbd67a164b4a5ed8454416147ab9", "git_parents": ["65b3d8630090a9bed2b3e6f9dd1c51109f30a6ec"], "node": "acad2a79f3b4ef5d6e6c3bcac27678640dbfbd7e", "parents": ["2e0e38f0b2180c56225576c49b248c5ad3b4bd99"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060288 - [efficiency] Convert MainMenuTest.verifyRecommendedExtensionsListWhileNoExtensionIsInstalledTest to ui/efficiency r=isabel_rios,aaronmt\n\nConverts the one extension smoke test in MainMenuTest that verifies the recommended-extensions list\nwithout installing anything (TestRail 3080151), so it needs no addon-install capability.\n\nAdds MainMenuSelectors.EXTENSIONS_BUTTON_UIAUTOMATOR. The Extensions row opens its submenu in a new\nwindow and the node sets testTagsAsResourceId, so it is matched by res-id at the device level rather\nthan through Compose -- mirroring the legacy\nitemWithResId(\"mainMenu.extensions\").clickAndWaitForNewWindow. The existing Compose-text\nEXTENSIONS_BUTTON stays as the twin for verifying the row is present rather than opening it.\n\nConfirmed on device that opening the submenu via the Extensions row lands on the same elements as the\nchevron-expand path, so the existing \"expandedExtensionsMenuItems\" group already covers\nverifyRecommendedAddonsViewFromRedesignedMainMenu -- no new page object needed.\n\nParity: every legacy assertion carried over explicitly (page content, the try-a-recommended-extension\nbutton, the recommended-addons view). Verified in isolation on device: effcheck PASS, outcome=pass,\n0 failures, 0 skipped, not a retry-pass.\n\nDepends on the selectors added in bug 2060267 (TRY_RECOMMENDED_EXTENSION_BUTTON,\nDISCOVER_MORE_EXTENSIONS_BUTTON, RECOMMENDED_ADDON_ITEM), so it stacks on that commit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316149\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "8261c3ce53f5e2e6f477ecaf492d47ac90f27dca", "git_parents": ["170b1cf2f0d9fbd67a164b4a5ed8454416147ab9"], "node": "f61e546dddf1a22608c6e34764d0f33eab1ba278", "parents": ["acad2a79f3b4ef5d6e6c3bcac27678640dbfbd7e"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060297 - [efficiency] Fix ShareOverlayPage navigation: empty nav edge and missing page-presence anchor r=isabel_rios,aaronmt\n\nShareOverlayPage could not be navigated to, and failed silently rather than erroring. Two defects\ncompounded:\n\nIts only NavigationRegistry edge (from BrowserPage) had an empty step list, left behind with a\nplaceholder comment, so on.shareOverlay.navigateToPage() performed no actions at all. And\nShareOverlaySelectors had no \"requiredForPage\" selector, so the page-presence check had nothing to\nassert against. Together these made navigateToPage() report success while still sitting on the\nbrowser -- the failure surfaced much later, as a missing element on a screen the test never reached.\n\nSHARING_LAYOUT (the share sheet's root layout, from fragment_share.xml) now joins \"requiredForPage\",\nso arrival is actually verified.\n\nThe empty BrowserPage edge is replaced by an edge from MainMenuPage clicking\nMainMenuSelectors.SHARE_BUTTON. Registering from MainMenuPage lets the graph route\nBrowserPage -\u003e MainMenuPage -\u003e ShareOverlayPage rather than duplicating the menu-opening step, matching\nhow WebCompatReporterPage is wired.\n\nAlso deletes ShareOverlaySelectors.SAVE_AS_PDF_BUTTON: it was UIAUTOMATOR_WITH_RES_ID with the value\n\"Save as PDF\", so it resolved to the res-id \"\u003cpkg\u003e:id/Save as PDF\" and could never match. It had no\ncallers. SAVE_AS_PDF_LABEL, which matches on text the way the legacy robot did, is the working one.\n\nVerified on device: navigation completes through Three Dot Menu -\u003e Share -\u003e \"Share overlay layout\"\nfound. Adding \"requiredForPage\" makes a previously-vacuous presence check real for the existing tests\nthat reach the share sheet by their own clicks (BookmarksTest, CollectionsTest, MainMenuTest), so\nMainMenuTest#verifyTheShareButtonTest was re-run as a regression check: passes, 0 failures, 0 skipped.\n\nNo legacy test is annotated here: this is harness enablement, not a conversion, so it is also\ndeliberately not attached to the conversion tracking meta bug 2030727.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316151\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/ShareOverlayPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ShareOverlaySelectors.kt"], "git_node": "d3b4082cf695d263e4606d5f990c8d5863bfce7a", "git_parents": ["8261c3ce53f5e2e6f477ecaf492d47ac90f27dca"], "node": "fecc2ca47cc06949f151ef72236116d889155ea9", "parents": ["f61e546dddf1a22608c6e34764d0f33eab1ba278"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060299 - [efficiency] Convert DownloadTest.saveAsPdfFunctionalityTest to ui/efficiency r=isabel_rios\n\nAdds efficiency/tests/DownloadTest and converts saveAsPdfFunctionalityTest (TestRail 2048448).\n\nThis is the share-sheet route to Save as PDF; the main-menu More-submenu route is already covered by\nMainMenuTest.verifyTheSaveAsPDFSubMenuOptionTest. It uses the local mockWebServer loremIpsumAsset, so\nthere is no network dependency.\n\nBuilds on the ShareOverlayPage navigation fix in bug 2060297 -- before that, navigating to the share\nsheet was a silent no-op.\n\nThe test class disables PromptAbuserDetector for its duration, and that is load-bearing rather than\nboilerplate: without it the download prompt's Download button still resolves and the click still\nreports success, but the click is treated as prompt abuse and dropped, so the dialog stays open and no\ndownload starts. The failure then surfaces much later as a missing download-complete snackbar rather\nthan as a failed click. The legacy DownloadRobot.clickDownload toggles the same flag around its click,\nand eff MainMenuTest already does it as a @Before -- which is why the main-menu save-as-PDF test worked\nwhile a fresh test class did not.\n\nParity gap, recorded in the @Converted notes: legacy verifyDownloadPrompt also asserted that the prompt\nnamed the file (\"Lorem\") and that the Cancel button was displayed. The shared downloadDialog group\ncovers the dialog title and the Download button only. The share-sheet prompt is a native AlertDialog\ncarrying a filename field (prefilled from the page text) alongside Cancel/Download, so it is a\ndifferent dialog from the main-menu route's and deserves its own selectors rather than widening\ndownloadDialog to cover both; those two checks did not carry over.\n\nVerified in isolation on device: effcheck PASS, effverify ok=true clean=true failed_total=0, not a\nretry-pass.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316152\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/DownloadTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/DownloadTest.kt"], "git_node": "3e532955b2eb62b5279d13f2c983e536b4067490", "git_parents": ["d3b4082cf695d263e4606d5f990c8d5863bfce7a"], "node": "104c9496765452c35bc21a60dd6094b657d8e2c5", "parents": ["fecc2ca47cc06949f151ef72236116d889155ea9"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060305 - [efficiency] Add notification-shade capability to the harness r=isabel_rios,aaronmt\n\nNeeded by the two remaining download conversions (CustomTabsTest.verifyDownloadInACustomTabTest and\nDownloadTest.pauseResumeCancelDownloadTest); neither could be expressed before this.\n\nAdds the selector strategy UIAUTOMATOR_WITH_RAW_RES_ID_CONTAINING_TEXT. Both existing res-id+text\nstrategies prefix \"$packageName:id/\", but notification action buttons are \"android:id/action0\" --\nsystem ids we do not own -- so the prefixing made them unmatchable. This follows the existing\nUIAUTOMATOR_WITH_WEB_ID_AND_TEXT precedent for res-ids used verbatim.\n\nNotificationSelectors gains NOTIFICATION_ACTION_BUTTON(action), SYSTEM_NOTIFICATION(text) and\nNOTIFICATION_TOP_LINE(text). Every action button on a notification shares android:id/action0, so the\nlabel is what distinguishes PAUSE from RESUME from CANCEL.\n\nNotificationPage gains openNotificationTray(), expandNotification(text),\nclickNotificationActionButton(action), verifyNotificationExists, verifyNotificationDoesNotExist and\ncloseNotificationTray(). Notifications in the shade are collapsed by default and their action buttons\nare not in the hierarchy at all until expanded, hence expandNotification.\n\nclickNotificationActionButton confirms success by the button no longer being present rather than by the\nclick returning: clicking PAUSE swaps the button for RESUME, so the old label going away is what\nactually proves the action was applied. That mirrors the legacy NotificationRobot semantics, and it is\nwhat makes a pause/resume/cancel sequence testable at all.\n\nThree latent defects fixed along the way:\n\nNotificationPage was never registered in PageContext, so it was unreachable via on.* -- the whole page\nobject was dead code, which is why it had a single selector and no helpers.\n\nnavigateToPage() returns BasePage, so page-specific helpers are not visible when chained off it. Added\nthe narrowing override that SettingsAutofillPage and TabHistoryPage already use.\n\nThe shade was modelled as a nav-graph destination with a single edge from HomePage, so navigateToPage()\nfailed with \"no navigation path found\" from anywhere else -- for instance from inside a custom tab. The\nshade is a system overlay reachable from every app state, so openNotificationTray() pulls it down\ndirectly and verifies the header instead. Adding an edge per page would be the wrong shape for\nsomething globally reachable.\n\nVerified on device: the in-progress conversion of CustomTabsTest.verifyDownloadInACustomTabTest\nexercises openNotificationTray + verifyNotificationExists + closeNotificationTray from inside a custom\ntab and passes in isolation (effverify ok=true clean=true failed_total=0, not a retry-pass). That\nconversion is deliberately not included here -- it passes alone but fails when the full CustomTabsTest\nclass runs, with a HomeActivity launch timeout that looks like leaked state, so it lands separately once\nthe teardown is sorted.\n\nNo legacy test is annotated here: this is harness enablement, not a conversion, so it is also\ndeliberately not attached to the conversion tracking meta bug 2030727.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316153\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/Selector.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/NotificationPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/NotificationSelectors.kt"], "git_node": "ac67015013cf9ede3e3198a0d17fdbc439814b25", "git_parents": ["3e532955b2eb62b5279d13f2c983e536b4067490"], "node": "af57b5eb04b1b468a3263abdcbb383dfb0e248ea", "parents": ["104c9496765452c35bc21a60dd6094b657d8e2c5"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060317 - [efficiency] Dismiss the tab-history sheet at the end of the custom-tab long-press test r=isabel_rios\n\nverifyTheMainMenuBackButtonLongClickFromCustomTabTest (landed in bug 2060267) ends with the tab-history\nbottom sheet open and never dismisses it, handing the next test in the class an open sheet.\n\nAdds TabHistoryPage.dismissTabHistorySheet(), which presses back and verifies the sheet is gone, and\ncalls it at the end of that test.\n\nScope note, so this is not overclaimed: this is test hygiene, not a fix for the CustomTabsTest flake. It\nwas written as a candidate fix for a retry-pass on verifyDownloadInACustomTabTest and it is not the\ncause -- adding it left the class result byte-identical. That leak is still unidentified, and the\nhelper's KDoc says so explicitly so nobody later reads this as the fix for it.\n\nDeliberately not routed through OverlayRegistry. That registry is scoped to system surfaces a test never\nasked for (OEM prompts, IME tutorials) and only fires on a locate miss, as a recovery path rather than\nteardown. The tab-history sheet is app UI the test opened on purpose, and the registry's own\ndocumentation warns against growing it past a single entry until overlay ordering and per-miss probe\ncost are settled.\n\nVerified: full efficiency CustomTabsTest class green 6/6, effverify ok=true clean=true failed_total=0\nretried=false.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316154\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/TabHistoryPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CustomTabsTest.kt"], "git_node": "cbabe079143b044dca0ef42acf9f2edee1f1688c", "git_parents": ["ac67015013cf9ede3e3198a0d17fdbc439814b25"], "node": "0fe83065607c2757423f54f755b0e735d38aaa78", "parents": ["af57b5eb04b1b468a3263abdcbb383dfb0e248ea"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060324 - [efficiency] Drop the never-invoked lambda from NavigationStep.OpenNotificationsTray r=isabel_rios,aaronmt\n\nFollow-up to bug 2060305, which noted this and deliberately left it alone.\n\nNavigationStep.OpenNotificationsTray was a data class taking an openNotificationsTrayAction: () -\u003e Unit\nthat BasePage never invoked -- its handler calls mozOpenNotificationsTray() unconditionally. The\nparameter was dead weight, and worse a trap: anyone passing a real action would reasonably expect it to\nrun, and it silently would not. The single call site passed an empty lambda, which read like a bug in its\nown right.\n\nNow a parameterless object, matching PressBack and WaitForIdle, so the type no longer advertises\nbehaviour it does not have.\n\nKept separate from 2060305 rather than folded in: that bug adds notification-shade capability, while this\nremoves a pre-existing wart on a shared navigation type. Verified compiling and green.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316155\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/NavigationStep.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/NotificationPage.kt"], "git_node": "7b6ab36a9eb14c83ddbc7e72ab556a00e4ee8389", "git_parents": ["cbabe079143b044dca0ef42acf9f2edee1f1688c"], "node": "8744ac489bb08b817175649714cd89fa7299f364", "parents": ["0fe83065607c2757423f54f755b0e735d38aaa78"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060336 - [efficiency] Remove dormant no-op navigation edges from seven page objects r=isabel_rios,aaronmt\n\nFound by the effcheck NAV/ANCHOR checks added in testops-tools 0e9e06e.\n\nMicrosurveysPage, PWAPage, ReaderViewPage, ShortcutsPage, SitePermissionsPage, SiteSecurityPage and\nTranslationsPage each registered a NavigationRegistry edge with an empty step list -- two of them holding\nonly a \"Will need to create selectors...\" placeholder comment. An edge with no steps makes\nnavigateToPage() perform no actions and report success, so a test carries on against whatever screen\nhappens to be in front of it and fails later, elsewhere, for a reason that points at the wrong step. That\nis the same defect that cost a device build to diagnose in bug 2060297.\n\nThe edges are deleted rather than filled in. All seven pages are unused by any test today, so nobody knows\nthe real navigation path and it cannot be verified; inventing steps would swap a silent lie for an\nunverified one. With no edge at all, navigateToPage() fails loudly with \"no navigation path found\", which\nis the honest answer until someone needs the page and can supply and verify real steps. Because the pages\nare unused, no test changes behaviour. Now-unused NavigationRegistry imports are pruned with them.\n\nThe effcheck ANCHOR rule was narrowed alongside this (in testops-tools): it now only demands a\n\"requiredForPage\" selector from pages that actually register an edge. A page with no edge cannot be\nnavigated to, so there is no arrival check to anchor, and the unnarrowed rule pushed toward inventing\nunverifiable anchors on unfinished scaffolding.\n\nSweep result: 11 page objects flagged before this change, 4 after. The remaining four are deliberately\nleft alone. AddToHomeScreenComponent, CollectionsPage and ToolbarComponent all have empty-step edges but\nARE used -- by MainMenuTest, CollectionsTest and ToolbarTest respectively -- so those tests may currently\nbe green partly because navigation silently succeeds, and fixing them needs a real nav path plus device\nverification per test. SettingsSiteSettingsPermissionsPage needs a requiredForPage anchor. Follow-up work,\nnot mechanical.\n\nVerified: full efficiency CustomTabsTest class green 6/6, effverify ok=true clean=true failed_total=0\nretried=false; ./mach lint on the efficiency package reports 0 errors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316156\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/MicrosurveysPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/PWAPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/ReaderViewPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/ShortcutsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SitePermissionsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SiteSecurityPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/TranslationsPage.kt"], "git_node": "a56f34bae83321fc5dfc9fe9326ceb7d1959bf42", "git_parents": ["7b6ab36a9eb14c83ddbc7e72ab556a00e4ee8389"], "node": "d954a8858d6089a2cd823599d0473e2904f85eac", "parents": ["8744ac489bb08b817175649714cd89fa7299f364"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060339 - [efficiency] Remove CollectionsPage's no-op nav edge and add a missing page-presence anchor r=isabel_rios,aaronmt\n\nClears the last two effcheck NAV/ANCHOR findings, following bug 2060336.\n\nCollectionsPage registered a HomePage -\u003e CollectionsPage edge with an empty step list, making\nnavigateToPage() a silent no-op that reported success without navigating. The edge is removed rather than\nfilled in, for the same reason as the seven in bug 2060336 plus one specific to this page: collections are\na section of the tabs tray rather than a screen of their own, and CollectionsTest never calls\nnavigateToPage() on it -- all four usages are mozVerify/mozClick, treating the page purely as a selector\nnamespace after arriving by other means. With no edge, navigateToPage() fails loudly instead of pretending\nto have navigated. Removing it also clears the ANCHOR finding, since a page that cannot be navigated to\nhas no arrival to anchor.\n\nSettingsSiteSettingsPermissionsSelectors gains \"requiredForPage\" on ASK_TO_ALLOW_RADIO_BUTTON. Unlike\nCollectionsPage this page registers a real multi-step edge (main menu -\u003e Settings -\u003e Site settings -\u003e\npermission), so the anchor will be exercised as soon as anything navigates there; without it the first\nsuch navigation would report success against whatever screen happened to be in front of it. The\npermission detail screen always shows the \"Ask to allow\" radio, so it is a sound arrival marker.\n\nAll 58 page objects now pass effcheck's NAV and ANCHOR checks, down from 11 findings when those checks\nwere introduced.\n\nVerified: efficiency CollectionsTest green 4/4 -- the only consumer of CollectionsPage, so the one thing\nthat could have regressed -- effloop_exit 0, and ./mach lint on the efficiency package reports 0 errors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316157\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/CollectionsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSiteSettingsPermissionsSelectors.kt"], "git_node": "9b5fd00b760779f14db2376437e4f2732c4b064e", "git_parents": ["a56f34bae83321fc5dfc9fe9326ceb7d1959bf42"], "node": "f6735bd132947878811baed821d290cae2b10aeb", "parents": ["d954a8858d6089a2cd823599d0473e2904f85eac"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060345 - [efficiency] Anchor NotificationPage on the shade itself and close it on the failure path r=isabel_rios,aaronmt\n\nNOTIFICATION_HEADER matched the text appName, which only exists once Firefox has\nposted a notification and system UI has rendered it, so the page-presence check\nwas racing the notification the caller was actually waiting for. NOTIFICATION_SHADE\nkeys on the shade's own scroller res-id instead, which is present exactly when the\nshade is open. That needs UIAUTOMATOR_WITH_RAW_RES_ID, since the existing raw-res-id\nstrategy's text criterion is not optional at the UiSelector level.\n\nopenNotificationTray() also left the shade open when its verify failed. An open\nshade holds window focus, so everything after it failed on an unrelated error\ninstead of the real one. It now closes the shade before rethrowing, and\ncloseNotificationTray() confirms the close instead of assuming back worked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316158\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/Selector.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/NotificationPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/NotificationSelectors.kt"], "git_node": "aca6207e467de57445042f4d9f45e6e50cc4f1d5", "git_parents": ["9b5fd00b760779f14db2376437e4f2732c4b064e"], "node": "047adc054bfa2b9a2a5b3b0e9afc451987c5ada3", "parents": ["f6735bd132947878811baed821d290cae2b10aeb"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060346 - [efficiency] Convert CustomTabsTest.verifyDownloadInACustomTabTest to ui/efficiency r=isabel_rios,aaronmt\n\nTwo deviations from legacy, both noted in the test: the page is served by the local\nmockWebServer instead of storage.googleapis.com, and PromptAbuserDetector validations\nare disabled so the download prompt's confirm click is not dropped as prompt abuse.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316159\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CustomTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CustomTabsTest.kt"], "git_node": "9ca431ffe188366fa46b06971fc8f15d9fa357a4", "git_parents": ["aca6207e467de57445042f4d9f45e6e50cc4f1d5"], "node": "67b4b3cd8df9758797afc5b64cd17968a83947e2", "parents": ["047adc054bfa2b9a2a5b3b0e9afc451987c5ada3"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060347 - [efficiency] Finish the failed attempt's activities before retrying r=isabel_rios,aaronmt\n\nA retry starts by launching a fresh HomeActivity, and that launch was what failed\nwhenever the previous attempt's HomeActivity was still alive. HomeActivity is\nlaunchMode=\"singleTask\", so the intent went to the existing instance instead of\ncreating one, MonitoringInstrumentation never saw a newly launched activity reach\nRESUMED, and the attempt died after 45s on \"Could not launch intent ... HomeActivity\".\nBecause that error names HomeActivity, it replaced whatever actually failed first.\n\nThe retry path now finishes every activity that is not already destroyed and waits,\nbounded, for the stage registry to clear. It is best-effort: a failure to inspect or\nfinish is logged rather than raised, since this must not convert one failure into\nanother.\n\nCustom-tab tests were where this showed up, because a failure there tends to leave\nHomeActivity resumed behind the custom tab, but nothing about it was specific to\ncustom tabs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316160\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt"], "git_node": "42d2eb05f4b51163e0890ad0197f6de39eed4b84", "git_parents": ["9ca431ffe188366fa46b06971fc8f15d9fa357a4"], "node": "99bbc24a566fe65d10979f493986545684839990", "parents": ["67b4b3cd8df9758797afc5b64cd17968a83947e2"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060406 - [efficiency] Convert CreditCardAutofillTest.deleteSavedCreditCardUsingMenuButtonTest to ui/efficiency r=isabel_rios,aaronmt\n\nFirst credit-card coverage on the framework, so it brings the missing pieces with it:\nCreditCardTestData (expiry year relative to today, since the editor offers no past\nyears), credit-card selectors on SettingsAutofillSelectors, and\nSettingsAutofillPage.fillAndSaveCreditCard mirroring fillAndSaveAddress.\n\nThree harness gaps surfaced while validating on device:\n\n- selectDropdownOption matched option text exactly, but the card expiry dropdowns\n  render options with surrounding text, so the month selection found nothing. It now\n  takes an opt-in substring mode, as the legacy robot does for those two dropdowns.\n- selectDropdownOption caught Exception around its retry, and Compose's waitUntil\n  raises ComposeTimeoutException, which extends Throwable \u2014 so a timeout escaped the\n  loop and the retry never ran for the case it was written for.\n- BaseTest cleared saved addresses between attempts but not saved cards. A leftover\n  card replaces \"Add card\" with \"Manage cards\", so a retry started on a different\n  screen than the first attempt.\n\nThe secure-your-cards prompt is a platform AlertDialog, so its \"Later\" button uses the\nframework res-id verbatim; ESPRESSO_BY_ID resolves names against the app's R class and\ncannot see it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316161\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CreditCardAutofillTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/data/CreditCardTestData.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAutofillPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsAutofillSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CreditCardAutofillTest.kt"], "git_node": "0fb04a360d8dbec1ca40188ce492e52089a0661f", "git_parents": ["42d2eb05f4b51163e0890ad0197f6de39eed4b84"], "node": "acf3b4a9586f89b4a06e3f232e57e516551a791e", "parents": ["99bbc24a566fe65d10979f493986545684839990"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060429 - [efficiency] Root ShareOverlayPage and WebCompatReporterPage at BrowserPage so reachability can route to them r=isabel_rios,aaronmt\n\nBoth pages hung their edge off MainMenuPage, but that node stands for two different\nscreens \u2014 the home menu and the browser menu \u2014 and it is reachable from HomePage in one\nstep. So the planner routed AppEntry -\u003e HomePage -\u003e MainMenuPage and then looked for\nShare, or More + Report broken site, in the home menu, where neither exists. Both are\nbrowser-only items.\n\nInside a test this never surfaced: both call sites load a URL first, so the tracker is\nalready on BrowserPage and the browser-menu route is the one taken. Only the reachability\nfactory, which starts cold from AppEntry, exposes it.\n\nRooting the edges at BrowserPage with the menu-opening click inline duplicates that click,\nwhich is what hanging them off MainMenuPage was avoiding \u2014 but a duplicated step is worth\nmore than an edge the graph can reach through the wrong screen. FindInPagePage,\nTabHistoryPage and UnifiedTrustPanelPage are rooted the same way. Both pages now default\nthe url in navigateToPage, since reaching a share sheet or a broken-site report needs a\npage to act on.\n\nSplitting MainMenuPage into home and browser nodes would fix the ambiguity at its root;\nthat is a larger change and is not attempted here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316178\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/ShareOverlayPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/WebCompatReporterPage.kt"], "git_node": "0c8e5d23a3970348a7ee091bb275fb4b10dbd473", "git_parents": ["0fb04a360d8dbec1ca40188ce492e52089a0661f"], "node": "7cba0244cc4864d81c7377f1f8fcdfcf10d8a6da", "parents": ["acf3b4a9586f89b4a06e3f232e57e516551a791e"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1999420 - relax flicker test focus change detection rules r=emilio\n\nbrowser_startup_flicker.js fails on macOS under both Proton and Nova designs. Two icons and the active tab are animating their opacity while the window activates, but `isLikelyFocusChange` does not return true because it is only being passed the rects for the two icons. `isLikelyFocusChange` needs three or more rects to change at once.\n\nThe main change I made is to allow 2 or more rects in the titlebar to be identified as a focus change. This is sufficient to fix the test for macOS with both Nova and Proton. It feels like there's a risk that this could mask unwanted flickers in the future, though.\n\nThe Nova design does not have a shadow around the active tab, so I removed that exception when the test is running with Nova enabled. This is not necessary to fix the test, but this will hopefully be a flag for us to remove this exception entirely during post-Nova codebase cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316441\n", "files": ["browser/base/content/test/performance/browser_startup_flicker.js", "browser/base/content/test/performance/head.js"], "git_node": "f0bd7c0bfb4fed796b1a025c8422521cbaa28f34", "git_parents": ["0c8e5d23a3970348a7ee091bb275fb4b10dbd473"], "node": "74b17e47cef13a1acaadc0c0d259dc3b2410a20e", "parents": ["7cba0244cc4864d81c7377f1f8fcdfcf10d8a6da"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059474 - Pin the target browser for urlbar SERP and search-form loads. r=Standard8\n\nThe parent controller's SERP and search-form opens resolved their target\nimplicitly, from whichever tab was selected when the parent ran them. On the\ndirect path that is the same turn as the commit, so it is always the committing\ntab. On the actor message path the call round-trips, so a tab selected in\nbetween receives the load instead, and the SERP opens in the wrong tab.\n\nPin the committing tab's browser at the commit and resolve it parent-side\nthrough resolveTargetBrowser, as the URL-loading path already does. The pin gets\none definition per input instead of a read inlined at each commit point, which\nis also how the remaining commit paths -- the one-off and search-button opens --\npick it up.\n\nBehavior-neutral on the direct path, where the pinned browser is the selected\nbrowser anyway; an absent pin still falls back to the selected tab, and a\nnon-\"current\" load still passes no target, since it opens its own tab. The\nmessage-path change is the fix: browser_switchTabs.js's slow_load switches away\nright after Enter and then waits for the SERP in the tab it left, so it timed\nout on the message path and passes now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315343\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "daa508a6ee9887f7e8d53904271ffdbd1bdc14f0", "git_parents": ["f0bd7c0bfb4fed796b1a025c8422521cbaa28f34"], "node": "e3089e6a41aa1fbb76ec7ea14cd5955565764abf", "parents": ["74b17e47cef13a1acaadc0c0d259dc3b2410a20e"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058991 - Make Windows InstallTime crash annotation stable, take 2 r=yjuglaret,afranchuk\n\nDue to some slightly misguided suggestion from yours truly, the first\nattempt at stabilisation ended up still reading an actual pointer value\nrather than the data pointed to.\n\nIn addition to fixing the code, this patch separates it into discrete\nfunctions for testability, adds tests, and guards against some possible\nweirdness, e.g. if in the future the SID ends up not being at the end of\nthe payload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314977\n", "files": ["toolkit/crashreporter/crash_helper_common/src/appinfo/windows.rs", "toolkit/library/rust/moz.build"], "git_node": "2f8b693abca7ef45e62ff90ba5828f676ca50d0b", "git_parents": ["daa508a6ee9887f7e8d53904271ffdbd1bdc14f0"], "node": "8490621ec271cb44d765c61b9e690231eec1ec77", "parents": ["e3089e6a41aa1fbb76ec7ea14cd5955565764abf"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059786 - Update IP protection locations title to match Figma. r=android-reviewers,android-l10n-reviewers,parker,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315647\n", "files": ["mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "dd8f53d5b9b9a81b71a03a37f75b36eeb1c30046", "git_parents": ["2f8b693abca7ef45e62ff90ba5828f676ca50d0b"], "node": "602243fc95d5e5cfca9dc2696b348ba60bc462f7", "parents": ["8490621ec271cb44d765c61b9e690231eec1ec77"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052664 - Consider a history entry which is being replaced by a dropped link on it's tab as having user iteraction. r=dom-core-reviewers,tabbrowser-reviewers,jjaschke,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312105\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/test/browser/dragdrop/browser.toml", "browser/components/tabbrowser/test/browser/dragdrop/browser_drop_link_user_interaction.js"], "git_node": "30ce11508e34b1b90ad2cd7e9592a811faa6ac72", "git_parents": ["dd8f53d5b9b9a81b71a03a37f75b36eeb1c30046"], "node": "84140ca6b275eb16ef7fdd67088566a9e0f4f8bb", "parents": ["602243fc95d5e5cfca9dc2696b348ba60bc462f7"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057317 - Provide the New Tab context id to the Mozilla Ads Client r=mconley\" for causing xpcshell failures @ test_AdsClient\n\nThis reverts commit 4c6076be4cef3427b7c0843def5d276a04cefe28.\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/AdsFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AdsFeed.js"], "git_node": "eed399fe82defc92426e628ce5da79dd23785e28", "git_parents": ["30ce11508e34b1b90ad2cd7e9592a811faa6ac72"], "node": "4ae072f168b2d42cc2a99e36e22de407097625ac", "parents": ["84140ca6b275eb16ef7fdd67088566a9e0f4f8bb"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060607 - update wpt metadata.\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-on-self-origin-by-permissions-policy.tentative.https.sub.html.ini"], "git_node": "a9201949a410b73b784acc012001f6bc7387e7d3", "git_parents": ["eed399fe82defc92426e628ce5da79dd23785e28"], "node": "ade8978959e52c4531392c4e67c28d781b97ab13", "parents": ["4ae072f168b2d42cc2a99e36e22de407097625ac"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020715 - Track potentially speculatable links. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305691\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/Link.cpp", "dom/base/Link.h", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h"], "git_node": "15f0184d199f6ddc0c2a26d2aa4bb9b5b03fbba0", "git_parents": ["a9201949a410b73b784acc012001f6bc7387e7d3"], "node": "3118131bc6e245c745f0a32f0e053990f3c637e8", "parents": ["ade8978959e52c4531392c4e67c28d781b97ab13"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2020715 - Implement consider speculative loads for predicate rules. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307970\n", "files": ["dom/base/SpeculationRuleSet.cpp", "dom/base/SpeculationRuleSet.h", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/base/speculationrules/cbindgen.toml", "dom/base/speculationrules/consider_loads.rs", "dom/base/speculationrules/lib.rs", "dom/security/ReferrerInfo.cpp", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini"], "git_node": "493ad3010cd0a70694465f8e6e959fae05f7a3e2", "git_parents": ["15f0184d199f6ddc0c2a26d2aa4bb9b5b03fbba0"], "node": "968bb3583c49912ea6140d90c5c1f3d9ab5db5c4", "parents": ["3118131bc6e245c745f0a32f0e053990f3c637e8"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057458 - Remove assertion that depends on marking only a single object for testing r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316392\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug2057458.js"], "git_node": "73dc906c1a0bb92020d124a692329f335933ab57", "git_parents": ["493ad3010cd0a70694465f8e6e959fae05f7a3e2"], "node": "fc5dbd1fd92a0869242e82a8618e6b103ebd149a", "parents": ["968bb3583c49912ea6140d90c5c1f3d9ab5db5c4"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2060873 - Let svg.new-getBBox.enabled and svg.Moz2D.strokeBounds.enabled ride the trains r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316536\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "8bcd9b687fd218fd17aeca2ed7754889d770d856", "git_parents": ["73dc906c1a0bb92020d124a692329f335933ab57"], "node": "77298ee10dae2c5c526746ca6974810c69c967c5", "parents": ["fc5dbd1fd92a0869242e82a8618e6b103ebd149a"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2052811 - part 1: rename FaultingCodeOffset to FaultingCodeRange.  r=bvisness.\n\nCurrently, when generating trapping instructions, the assembler stack returns a\nFaultingCodeOffset that points to the first byte of the trapping instruction.\n\nThe purpose of this patch series is to replace FaultingCodeOffset with\nFaultingCodeRange, which carries both the offset and length.  This facilitates:\n\n* At trap-registration time, cross-checking the presented FaultingCodeRange\n  with the length that SummarizeTrapInstruction computes\n\n* When creating a trap and stackmap together, it provides a way to guarantee\n  that both have the correct offset, since the associated FaultingCodeRange\n  carries both the relevant offsets.\n\nA single patch that does all this would be huge and hard to review, since it\nwould be mostly renamings, interspersed with some changes in logic.\n\nInstead, the changes are in three patches.  This first patch is huge but it is\npurely renamings; literally nothing else:\n\n  FaultingCodeOffset        --\u003e   FaultingCodeRange\n  FaultingCodeOffsetPair    --\u003e   FaultingCodeRangePair\n  fco                       --\u003e   fcr\n  trackFCO                  --\u003e   trackFCR\n  fcoLogicCheck             --\u003e   fcrLogicCheck  (is unused?)\n\nThe result is a system that is functionally unchanged, but now operating on\nfake FaultingCodeRanges, that are really still FaultingCodeOffsets.  The next\npatch in the series converts them to real FaultingCodeRanges.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313382\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm-inl.h", "js/src/jit/arm/MacroAssembler-arm.cpp", "js/src/jit/arm/MacroAssembler-arm.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/arm64/vixl/MacroAssembler-vixl.cpp", "js/src/jit/arm64/vixl/MacroAssembler-vixl.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/mips-shared/MacroAssembler-mips-shared-inl.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared.cpp", "js/src/jit/none/MacroAssembler-none.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h", "js/src/jit/shared/Assembler-shared.h", "js/src/jit/wasm32/MacroAssembler-wasm32-inl.h", "js/src/jit/wasm32/MacroAssembler-wasm32.cpp", "js/src/jit/x64/CodeGenerator-x64.cpp", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x64/MacroAssembler-x64.h", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared.h", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/MacroAssembler-x86.cpp", "js/src/jit/x86/MacroAssembler-x86.h", "js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBaselineCompile.cpp", "js/src/wasm/WasmCodegenTypes.h", "js/src/wasm/WasmGC.cpp"], "git_node": "fb81217fc9e32ae79b88033de04255b390c4cde5", "git_parents": ["8bcd9b687fd218fd17aeca2ed7754889d770d856"], "node": "876dca5d312660063163d3150126e5d6524bef4b", "parents": ["77298ee10dae2c5c526746ca6974810c69c967c5"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2052811 - part 2: provide a proper definition for FaultingCodeRange.  r=bvisness.\n\nThis patch contains two elements:\n\n(1) It converts the \"fake\" FaultingCodeRange to a real range, unfortunately\n    right at the end of the patch.\n\n(2) For x86_32 and x86_64 only, changes every place that reads\n    ::currentOffset() before an instruction, to also read it afterwards, and\n    bake that into the resulting FaultingCodeOffset.\n\nFor (1), FaultingCodeRange now has two (non-default) constructors, but one or\nthe other is always #ifdef'd out.  For x86_32 and x86_64 -- the only\nvariable-length targets -- the constructor takes two offsets, that of the insn\nand of the first byte after it.\n\nAll other targets (arm{32,64}, rv64, etc) have fixed insn lengths and so there\nis only a one-argument constructor available.  It knows the length of an\ninstruction on the target and bakes that in as necessary.  This means that, on\nthese targets, there are no changes analogous to (2) above.\n\nFor (2) on x86_32 and x86_64, the changes are tedious but mechanical.  The\nstandard construction is:\n\n  auto before = masm.currentOffset();\n  masm.make_me_a_trapping_insn();\n  auto after = masm.currentOffset();\n  return FaultingCodeRange(before, after);\n\nA side-effect of this ifdef'd-dual-constructor scheme is that it is impossible\nto create FaultingCodeRanges in target-independent code.  Such attempts will\nlead to compilation failure for targets on the other side of the\nfixed-vs-variable-length instruction fence, because a constructor of the\ncorrect arity will not be available.\n\nThis is a good thing: the most reliable way to get a FaultingCodeRange is from\na low-level, target-specific assembler method.  Trying to do it at a higher\nlevel by calling `MacroAssembler::currentOffset()` risks reading the offset too\nlate (or early); it's hard to be sure that some part of the stack hasn't\nslipped in extra instructions before/after the faulting one.\n\nThe new instruction-length information is not used in this patch; the patch\nmerely facilitates its collection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313383\n", "files": ["js/src/jit/x64/CodeGenerator-x64.cpp", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x64/MacroAssembler-x64.h", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared.h", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/MacroAssembler-x86.cpp", "js/src/jit/x86/MacroAssembler-x86.h", "js/src/wasm/WasmCodegenTypes.h"], "git_node": "4c9f0707a38c46211faec1cc5d26e5fc52beee38", "git_parents": ["fb81217fc9e32ae79b88033de04255b390c4cde5"], "node": "9da5d9b599c2294aeab318ba86950ace8d84bb95", "parents": ["876dca5d312660063163d3150126e5d6524bef4b"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2052811 - part 3: Use FaultingCodeRange to cross-check SummarizeTrapInstruction.  r=bvisness.\n\nFinally, this patch puts the collected instruction-length information to use:\nwhen registering a trap, a FaultingCodeRange must be presented, and that is\nchecked against the length computed for the instruction by\nSummarizeTrapInstruction.  That requires the following components:\n\n(1) New method\n    MacroAssembler::appendAndVerify(Trap, TrapMachineInsn,\n                                    FaultingCodeRange, TrapSiteDesc)\n    that actually does the cross-checking.  This is the new official way to\n    register a trapping instruction in the metadata and replaces\n    AssemblerShared::append in that role.\n\n(2) Per (1), renaming of many calls from AssemblerShared::append to\n    MacroAssembler::appendAndVerify.\n\n(3) New\n    class InstructionBytesFromMasm : public wasm::InstructionBytes\n    that provides a way for SummarizeTrapInstruction to read bytes from an\n    assembler buffer, as required by (1).\n\n(4) New method MacroAssembler::getByteAtOffset, that fetches bytes from an\n    assembler buffer, in support of (3).  This involves some ugly\n    target-specifics since different targets use different arrangements for\n    assembler buffers.\n\n(5) New method Assembler::readableSize, used for range-checking in (4).\n    Assembler::size() isn't usable for this because on some targets it\n    MOZ_CRASHes if the assembler currently has un-committed constant pools.\n    ::readableSize returns just the committed size.  Since we don't need (3) to\n    be able to look inside constant pools, this is fine.\n\n(6) There are a few places where we create the trap for an instruction before\n    the instruction itself.  This causes (1) to assert because it requires\n    reading instruction bytes that don't exist in the buffer yet, per (5).\n    These places have been fixed to first generate the instruction and then\n    register the trap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313384\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/Assembler-arm.cpp", "js/src/jit/arm/Assembler-arm.h", "js/src/jit/arm/MacroAssembler-arm.cpp", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/vixl/Assembler-vixl.h", "js/src/jit/none/MacroAssembler-none.h", "js/src/jit/riscv64/Assembler-riscv64.cpp", "js/src/jit/riscv64/Assembler-riscv64.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/shared/Assembler-shared.h", "js/src/jit/shared/IonAssemblerBufferWithConstantPools.h", "js/src/jit/x64/BaseAssembler-x64.h", "js/src/jit/x64/CodeGenerator-x64.cpp", "js/src/jit/x64/MacroAssembler-x64.cpp", "js/src/jit/x86-shared/Assembler-x86-shared.h", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp", "js/src/jit/x86-shared/MacroAssembler-x86-shared.cpp", "js/src/jit/x86/BaseAssembler-x86.h", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/MacroAssembler-x86.cpp", "js/src/wasm/WasmBaselineCompile.cpp", "js/src/wasm/WasmCodegenTypes.h", "js/src/wasm/WasmGC.cpp"], "git_node": "4ab0eec757a7ed70c9bfb03eb855b738a31990f2", "git_parents": ["4c9f0707a38c46211faec1cc5d26e5fc52beee38"], "node": "a69a6e298d7b86fe9a14783083d1b877dff73874", "parents": ["9da5d9b599c2294aeab318ba86950ace8d84bb95"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033089 - Don't reuse view results that were fetched for another page. r=Standard8\n\nWhen the view reopens for an abandoned search, it shows the results of the\nprevious query while a new query runs, and it considered them reusable as long\nas the search string was unchanged. Results depend on the selected tab, though,\nand the search bar keeps its value across tabs, so clicking it after a tab\nswitch showed the previous tab's tab-to-search suggestion until the new results\narrived.\n\nReusable results now have to match the current page as well, and the query\ncontext cache is keyed on it, so both tabs' results stay cached and switching\nback and forth doesn't flicker. Where nothing is cached for the current page,\nthe view opens once the new results arrive instead of immediately showing\nanother page's results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316244\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser/browser_queryContextCache.js", "browser/components/urlbar/tests/browser/searchbar/browser.toml", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_queryContextCache.js"], "git_node": "a384857f0a11a511290f209fc3ccab5ea6ac87cb", "git_parents": ["4ab0eec757a7ed70c9bfb03eb855b738a31990f2"], "node": "5ba07b9f13390d87ff45e01eb0854accf0d2bf48", "parents": ["a69a6e298d7b86fe9a14783083d1b877dff73874"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2058043 - fix issues with nova in browser_customization_context_menus.js, r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316071\n", "files": ["browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_customization_context_menus.js"], "git_node": "49c907f1dd9e00c67859bde071f62abb008f5f64", "git_parents": ["a384857f0a11a511290f209fc3ccab5ea6ac87cb"], "node": "5c977d4b9f887f27b05770a17b42f531445e8457", "parents": ["5ba07b9f13390d87ff45e01eb0854accf0d2bf48"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2028648 - fix browser_customization_context.js expectation of a resized window so it doesn't fail on Windows standalone, r=florian\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316276\n", "files": ["browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_customization_context_menus.js"], "git_node": "7dbb2256cd59a6f8015aff1861a5e944691478dd", "git_parents": ["49c907f1dd9e00c67859bde071f62abb008f5f64"], "node": "e4429ef70c6c34325be5903ed8b1d394c729d672", "parents": ["5c977d4b9f887f27b05770a17b42f531445e8457"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2058736 - document profile data upgrade/migration steps as a \"how to\"