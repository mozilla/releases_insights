/browser/browser-nova.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser-proton.toml", "browser/components/urlbar/tests/quicksuggest/browser/browserNova.toml"], "git_node": "c99a42be0b72e3b7399bb8bb611b45151e52db35", "git_parents": ["39be27c0a25fa48581682a98649e4bece55e97ce"], "node": "ef1abbb689349ebaade64da356fc73d2e67e7bfe", "parents": ["e6fea2b6a5764212d5de88baa94975e22d037b2b"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046592 - Add Desktop notification when active monitor meets condition r=ngrato,tetchart,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313841\n", "files": ["browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/locales-preview/aiWindow.ftl", "browser/locales/jar.mn"], "git_node": "17b72d8689e088662397e6a5f9cbadc973b21a05", "git_parents": ["c99a42be0b72e3b7399bb8bb611b45151e52db35"], "node": "6a7ce92641244a9bb08a70adf33941e9b1c1e92c", "parents": ["ef1abbb689349ebaade64da356fc73d2e67e7bfe"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057599 - Part 2: Prefill monitor condition from the /monitor command text r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314029\n", "files": ["browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agentui_command.js"], "git_node": "187f271899f8051410567cf436fa10c649f9e0bf", "git_parents": ["17b72d8689e088662397e6a5f9cbadc973b21a05"], "node": "8bfc13c19350cb547123f2dafc7fbeb769156f5d", "parents": ["6a7ce92641244a9bb08a70adf33941e9b1c1e92c"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050584. r=gfx-reviewers,nical\" for causing gtests failures in test_2_conformance__extensions__ext-float-blend.html.\n\nThis reverts commit e9eb24c961039abb436a85bc631c3a554c351cce.\n", "files": ["dom/canvas/WebGLFramebuffer.cpp"], "git_node": "3b28c2674c87646386f6b3920d41e10eb4eff12b", "git_parents": ["187f271899f8051410567cf436fa10c649f9e0bf"], "node": "575afa99633032c6c62482b8e55f3f0f889d924a", "parents": ["8bfc13c19350cb547123f2dafc7fbeb769156f5d"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058791 - Restore the scroll offset as well as the resolution in helper_doubletap_zoom_oopif-2.html. r=tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314830\n", "files": ["gfx/layers/apz/test/mochitest/helper_doubletap_zoom_oopif-2.html"], "git_node": "9b2306754bebd107c73ffc3464842edae3a3723d", "git_parents": ["3b28c2674c87646386f6b3920d41e10eb4eff12b"], "node": "edcc6abae2247c2040de3a3518e2800919551b1a", "parents": ["575afa99633032c6c62482b8e55f3f0f889d924a"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058189 - Re-enable test_group_double_tap_zoom-2.html with Nova. r=tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314831\n", "files": ["gfx/layers/apz/test/mochitest/mochitest.toml"], "git_node": "cd2e7572edec6b75872221f71532b58a487c867b", "git_parents": ["9b2306754bebd107c73ffc3464842edae3a3723d"], "node": "17d3f9a086889628108bfd86634f91c3d445eb02", "parents": ["edcc6abae2247c2040de3a3518e2800919551b1a"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058121 - Migrate privateTabsDoNotPersistAfterClosingAppTest UI test to the efficiency framework r=aaronmt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314347\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/TabbedBrowsingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HomeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/TabDrawerSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TabbedBrowsingTest.kt"], "git_node": "364fac47aa2dc0e1a3807c883843253a528d1bf2", "git_parents": ["cd2e7572edec6b75872221f71532b58a487c867b"], "node": "77758b8abedd7be23159457f9c59cffc025e061a", "parents": ["17d3f9a086889628108bfd86634f91c3d445eb02"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046592 - Add Desktop notification when active monitor meets condition r=ngrato,tetchart,fluent-reviewers,bolsson\" for causing bc failures @ browser_monitor_agent\n\nThis reverts commit 17b72d8689e088662397e6a5f9cbadc973b21a05.\n", "files": ["browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/locales-preview/aiWindow.ftl", "browser/locales/jar.mn"], "git_node": "30198072e4d1cebf5e5cf855a3245138dbe97889", "git_parents": ["364fac47aa2dc0e1a3807c883843253a528d1bf2"], "node": "ee82c9cb80e875af1ee446da5baedefcda108ae6", "parents": ["77758b8abedd7be23159457f9c59cffc025e061a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2057190 - Skip discarded per-task worker schema construction in fast taskgraph mode r=taskgraph-reviewers,ahal\n\nIn fast mode (used by local `mach try` task generation), validate_schema()\nis a no-op, yet the `validate` transform still constructed a voluptuous or\nmsgspec worker schema for every task only to discard it immediately. Guard\nthat construction behind `not taskgraph.fast`.\n\nThe generated task graph is unchanged (full_task_set serializes byte-for-byte\nidentically before and after); this only removes work whose result was thrown\naway in fast mode.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313701\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "be45611f95af018cad2c03ac1a38425d1fd43977", "git_parents": ["30198072e4d1cebf5e5cf855a3245138dbe97889"], "node": "3be2e20b2fe6c9e34a4d8b78960a842cbc8cff5c", "parents": ["ee82c9cb80e875af1ee446da5baedefcda108ae6"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2057189 - Cache invariant variant symbols in group_name_variant r=taskgraph-reviewers,bhearsum\n\ngroup_name_variant() rebuilt the sorted variant_symbols list from the\nmodule-level TEST_VARIANTS constant on every call (~48k times during a full\ntask graph generation), even though the result never varies. Hoist it into a\nfunctools.cache-d helper so it is computed once.\n\nThe generated task graph is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313702\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "716e0c525abe15f6e26f9d8e525d592b00827a8a", "git_parents": ["be45611f95af018cad2c03ac1a38425d1fd43977"], "node": "6f4a60fd426ca3ce4ca68206fb7a951dc1d5af17", "parents": ["3be2e20b2fe6c9e34a4d8b78960a842cbc8cff5c"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2057393 - Set `GeckoEditableParent` if not set when taking a focus. r=geckoview-reviewers,owlish\n\nWhen opening a new window, virtual keyboard might not work because\n`GeckoEditableParent` is not set.\n\nNormally, it is creates and attched with parent process when global document\nis created. If it is too early, it is rarely failed since root window isn't\nfound yet.\n\nWe have a fallback path to create it when taking a IME focus, but it forget\nattaching with parent process. So we should attach it on fallback path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313929\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TextInputDelegateTest.kt", "widget/android/GeckoEditableSupport.cpp", "widget/android/GeckoEditableSupport.h", "widget/android/GeckoProcessManager.cpp", "widget/android/GeckoProcessManager.h"], "git_node": "57e674a6df172706b46693bdfbfabf358b72fde8", "git_parents": ["716e0c525abe15f6e26f9d8e525d592b00827a8a"], "node": "8813c7e524874ec9e69ac236ea9af2d4a70a72e6", "parents": ["6f4a60fd426ca3ce4ca68206fb7a951dc1d5af17"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\naf -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nan -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nar -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nast -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\naz -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nbe -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nbg -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nbn -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nbo -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nbqi -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nbr -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nbrx -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nbs -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nca -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nca-valencia -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\ncak -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nckb -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\ncs -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\ncy -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nda -\u003e 7d71b0c48882516ce409354d90b2ccd8fa921e19\nde -\u003e 7d71b0c4888251