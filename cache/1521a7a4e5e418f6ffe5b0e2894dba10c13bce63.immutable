4aadd2da49f5\nvi -\u003e b793fe9ae14b82524693075363d44aadd2da49f5\nwo -\u003e b793fe9ae14b82524693075363d44aadd2da49f5\nxh -\u003e b793fe9ae14b82524693075363d44aadd2da49f5\nzam -\u003e b793fe9ae14b82524693075363d44aadd2da49f5\nzh-CN -\u003e b793fe9ae14b82524693075363d44aadd2da49f5\nzh-TW -\u003e b793fe9ae14b82524693075363d44aadd2da49f5\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "f6a579d18b6c495781af993e8244d28f84494006", "git_parents": ["2ec9019a38a984e349fb2996b40d6bbb40afdfa1"], "node": "d8384ec1a12666e38add2dbb34a7bebb6515300a", "parents": ["81e85f751c474de71277d38ff5e499500c5a55ed"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2061942. Show whether the CMS output profile is in use in about:support. r=gfx-reviewers,lsalzman\n\nabout:support reports CMSOutputProfile from GetPlatformCMSOutputProfileData(),\nwhich is the configured display_profile pref or the OS display profile. The\nprofile actually used as the color management transform target is forced to\nsRGB when gfx.color_management.native_srgb (true by default on macOS) or\ngfx.color_management.force_srgb is set. As a result CMSOutputProfile can show a\nwide-gamut monitor profile that is not the profile in use, which is misleading\nwhen diagnosing color management problems.\n\nAdd a CMSOutputProfileInUse property to the about:support graphics diagnostics\nthat reports whether the configured profile is the effective output profile or\nhas been overridden to sRGB.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317248\n", "files": ["gfx/thebes/gfxPlatform.cpp"], "git_node": "74d399ed23898adecf13fa9f2576c1dd78e068c3", "git_parents": ["f6a579d18b6c495781af993e8244d28f84494006"], "node": "0ff95d3205f838ef6376b621887c09efc427b01f", "parents": ["d8384ec1a12666e38add2dbb34a7bebb6515300a"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2061646 - NONDISPLAY frames have no bounding rect r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317292\n", "files": ["dom/base/Element.cpp", "testing/web-platform/meta/svg/geometry/svg-geometry-apis-in-non-rendered-elements.html.ini"], "git_node": "7ae4b5b0abf9492eb71a268aa1b9d7e2f8211ead", "git_parents": ["74d399ed23898adecf13fa9f2576c1dd78e068c3"], "node": "3987e054b088e2827abd50fde3720697aba990a0", "parents": ["0ff95d3205f838ef6376b621887c09efc427b01f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2054311 - Sort includes in mfbt. r=sergesanspaille\n\nAutogenerated with:\n\n    cp dom/.clang-format mfbt/ && mach format mfbt/**.{cpp,h,mm}\n\nNo manual changes required.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311691\n", "files": ["mfbt/Algorithm.h", "mfbt/Alignment.h", "mfbt/AllocPolicy.h", "mfbt/Array.h", "mfbt/ArrayUtils.h", "mfbt/Assertions.cpp", "mfbt/AtomicBitfields.h", "mfbt/BinarySearch.h", "mfbt/BitSet.h", "mfbt/BloomFilter.h", "mfbt/BoundedMPSCQueue.h", "mfbt/Buffer.h", "mfbt/BufferList.h", "mfbt/Casting.h", "mfbt/ChaosMode.h", "mfbt/Char16.h", "mfbt/CheckedInt.h", "mfbt/CompactPair.h", "mfbt/CumulativeAverage.h", "mfbt/DbgMacro.h", "mfbt/DefineEnum.h", "mfbt/EndianUtils.h", "mfbt/EnumSet.h", "mfbt/EnumeratedArray.h", "mfbt/FStream.h", "mfbt/FastBernoulliTrial.h", "mfbt/FloatingPoint.h", "mfbt/FunctionRef.h", "mfbt/Fuzzing.h", "mfbt/HashFunctions.h", "mfbt/HashTable.h", "mfbt/InitializedOnce.h", "mfbt/IntegerRange.h", "mfbt/IntegerTypeTraits.h", "mfbt/JSONWriter.h", "mfbt/Latin1.h", "mfbt/MathAlgorithms.h", "mfbt/MaybeOneOf.h", "mfbt/MruCache.h", "mfbt/NeverDestroyed.h", "mfbt/NonDereferenceable.h", "mfbt/PairHash.h", "mfbt/PodOperations.h", "mfbt/Poison.h", "mfbt/Range.h", "mfbt/RangedPtr.h", "mfbt/RefPtr.h", "mfbt/Result.h", "mfbt/ResultExtensions.h", "mfbt/RollingMean.h", "mfbt/SHA1.cpp", "mfbt/SHA1.h", "mfbt/SPSCQueue.h", "mfbt/Saturate.h", "mfbt/S