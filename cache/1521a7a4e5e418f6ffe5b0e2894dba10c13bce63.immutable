"devtools/server/tests/chrome/chrome.toml", "devtools/server/tests/chrome/doc_Debugger.Source.prototype.introductionType.html", "devtools/server/tests/chrome/test_Debugger.Source.prototype.introductionType.html", "devtools/shared/webconsole/test/chrome/chrome.toml", "devtools/shared/webconsole/test/chrome/sandboxed_iframe.html", "devtools/shared/webconsole/test/chrome/sandboxed_iframe_inner.html"], "git_node": "87b85e6ea8d008f6f6d6848557f3bc74840f0061", "git_parents": ["f6ca973e172efcdb560916cb53a70d8d7c8fb1cc"], "node": "3f1a7a293c4fc9039b04b94935dcbbe18e6db1a5", "parents": ["3b6a4dc592b38874030184e3cdfeaaaec26b8602"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058894 - Load the print preview downloadable font iframes from a file instead of srcdoc. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315579\n", "files": ["layout/base/tests/chrome/printpreview_downloadable_font_in_iframe.html", "layout/base/tests/chrome/printpreview_downloadable_font_in_iframe_ref.html"], "git_node": "423b147b2d487e9352981d4386004208920ccaa4", "git_parents": ["87b85e6ea8d008f6f6d6848557f3bc74840f0061"], "node": "132bc0a5bad9c1f657dff009987f699575273920", "parents": ["3f1a7a293c4fc9039b04b94935dcbbe18e6db1a5"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058894 - Use reference files instead of srcdoc in test_context_properties_allowed_domains.html. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315580\n", "files": ["layout/svg/tests/chrome.toml", "layout/svg/tests/file_green_reference.html", "layout/svg/tests/file_red_reference.html", "layout/svg/tests/test_context_properties_allowed_domains.html"], "git_node": "77a9efb133208b2a97267f0f710287ec6bcfad02", "git_parents": ["423b147b2d487e9352981d4386004208920ccaa4"], "node": "e9fc04a1e7a9a71c0b82ed6983ea5f6477174fb6", "parents": ["132bc0a5bad9c1f657dff009987f699575273920"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058894 - Use about:blank instead of srcdoc for the designMode editor in the IME state test. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315581\n", "files": ["widget/tests/file_test_ime_state_on_focus_move.js"], "git_node": "0366e4921acd0067dcbf0d168bf4eea6af4ea19f", "git_parents": ["77a9efb133208b2a97267f0f710287ec6bcfad02"], "node": "f3bc8c46e673cd14b3b58725b1b1888259238e19", "parents": ["e9fc04a1e7a9a71c0b82ed6983ea5f6477174fb6"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2058894: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["docshell/base/nsDocShell.cpp"], "git_node": "1a6e9b3d33aa3c218b388fa917a0e1546fd38993", "git_parents": ["0366e4921acd0067dcbf0d168bf4eea6af4ea19f"], "node": "5ea3be56e8937bc7093b73e6b9a8a76eb0b732c3", "parents": ["f3bc8c46e673cd14b3b58725b1b1888259238e19"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062052 - Do not sync screenOrientation for discarded iframes. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317455\n", "files": ["dom/base/ScreenOrientation.cpp", "dom/base/test/browser_screen_orientation_override.js"], "git_node": "c3d73b534270e75535331ab7a4ad0ab5fd5edf63", "git_parents": ["1a6e9b3d33aa3c218b388fa917a0e1546fd38993"], "node": "1fb2a851886c9f092833be7e5cd8ec5a997ab833", "parents": ["5ea3be56e8937bc7093b73e6b9a8a76eb0b732c3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060897 - Move the clipboard paste helpers from UrlbarUtils to UrlbarShared. r=mbeier\n\nThe input has to stop reaching into UrlbarUtils before it can run in a content\nprocess. Both helpers reached for parent-only APIs, so this isn't a plain\nrelocation; there are two substitutions to review.\n\nScheme classification goes through the URL parser. Its scheme grammar is the one\nnet_ExtractURLScheme implements, but it insists the whole string parse, so it\nrejects a few things extractScheme accepts -- javascript://[ and friends. Those\nare exactly the strings Services.io.newURI rejects too, so nothing that could\nactually be loaded is classified differently; the new xpcshell test pins both\nhalves of that.\n\nsanitizeTextFromClipboard still needs the keyword verdict, which only URI fixup\ncan give and which is parent-only, so it takes that in instead of running the\nfixup itself. Inputs already have the seam in controller.getFixupInfo, and the\nprimitives the actor was building move to UrlbarUtils so the clipboard provider\ncan share them.\n\nOne behavior difference: an input's fixup passes FIXUP_FLAG_PRIVATE_CONTEXT in a\nprivate window, which the inline fixup didn't. It only picks the engine that\nbuilds preferredURI, which this code never reads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317119\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/base/content/browser-commands.js", "browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/components/urlbar/UrlbarProviderClipboard.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/unit/test_UrlbarShared_stripUnsafeProtocolOnPaste.js", "browser/components/urlbar/tests/unit/xpcshell.toml"], "git_node": "bd86b6f50dfb935d1fdd3719004b652b1f5b06c1", "git_parents": ["c3d73b534270e75535331ab7a4ad0ab5fd5edf63"], "node": "77a7338b191736f9cb88c6a1e5c688eca8d1b6a7", "parents": ["1fb2a851886c9f092833be7e5cd8ec5a997ab833"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062117 - Remove newtab bundle/CSS artifacts re-added after Bug 2025793 r=mconley\n\nBug 2025793 stopped committing the generated newtab bundle and CSS and added\nthem to .gitignore, but Bug 2050954 later re-added\ndata/content/activity-stream.bundle.js and css/activity-stream.css to the tree.\nRemove them again so only the build-generated, packaged copies remain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317388\n", "files": ["browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js"], "git_node": "b4b220f7bfcbea9542bf055763ca636d1fc2e5c4", "git_parents": ["bd86b6f50dfb935d1fdd3719004b652b1f5b06c1"], "node": "d4d04521101b85988115db47b2c8ecaa55454fef", "parents": ["77a7338b191736f9cb88c6a1e5c688eca8d1b6a7"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061090 - Fix Crash in [@ java.lang.NullPointerException: at org.mozilla.fenix.library.history.HistoryFragment$onDeleteTimeRange$1.invokeSuspend(HistoryFragment.kt:199)]. r=android-reviewers,alastun\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317424\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryFragment.kt"], "git_node": "b99249aff76dea1454c571e6e11e54f363e8643d", "git_parents": ["b4b220f7bfcbea9542bf055763ca636d1fc2e5c4"], "node": "76133cf766d70f835cbde9a75c7a1ea353a6b8f6", "parents": ["d4d04521101b85988115db47b2c8ecaa55454fef"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062129 - Hide the \"Clear cookies and site data\" option from the security panel of private tabs r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317451\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/trustpanel/TrustPan