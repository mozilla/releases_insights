 "git_parents": ["350db7f46d23c9be7acc5e63d4738df153fe9692"], "node": "0f88baaccc6f8be08b3e1f809b232513435fb801", "parents": ["b66ab1d03f00a15e3d58295d8243d9d0cea40bda"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2055614 - SearchEngines.PreventInstalls should suppress OpenSearch add-engine offers instead of blocking discovery. r=Standard8,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313575\n", "files": ["browser/actors/LinkHandlerChild.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_search_engine.js", "browser/components/search/OpenSearchManager.sys.mjs", "browser/components/search/SearchOneOffs.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs"], "git_node": "ac9c8513e4f3c9e1ec5c133f7889cf7a12ec8396", "git_parents": ["5c8739dffe9b81efc78d0a1c0c1c2eae569985e2"], "node": "6f802a68817c89e899c538a965964007a6803b0b", "parents": ["0f88baaccc6f8be08b3e1f809b232513435fb801"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2055614 - SearchEngines.PreventInstalls should suppress the contextual search install prompt. r=Standard8,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313576\n", "files": ["browser/components/urlbar/ActionsProviderContextualSearch.sys.mjs", "browser/components/urlbar/tests/browser-search/browser_contextualsearch_install.js"], "git_node": "830d91e69ef419bbd8d9f942695469876611cfd4", "git_parents": ["ac9c8513e4f3c9e1ec5c133f7889cf7a12ec8396"], "node": "89de21369f9675ac36c0af6eb09193127a85c0ab", "parents": ["6f802a68817c89e899c538a965964007a6803b0b"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055681: Only allowed parent process to construct protocol for ClearStoragesForOrigin.r=dom-storage-reviewers,ipc-reviewers,nika,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315148\n", "files": ["dom/storage/components.conf", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h"], "git_node": "751f779af377bbf942b6be7aa17c6d30d0abac62", "git_parents": ["830d91e69ef419bbd8d9f942695469876611cfd4"], "node": "5fc94060392d2ee6f7df48cd0a6d6e6f448c6577", "parents": ["89de21369f9675ac36c0af6eb09193127a85c0ab"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059572 - Only retain as much memory as a captured stack needs, r=profiler-reviewers,canova.\" for causing spidermonkey build bustages related to check_vanilla_allocations.py.\n\nThis reverts commit 6cd914af4539ba6b17feec8a8b4234f3d8523323.\n", "files": ["mozglue/baseprofiler/core/BaseAndGeckoProfilerDetail.cpp", "mozglue/baseprofiler/core/platform.cpp", "mozglue/baseprofiler/public/BaseAndGeckoProfilerDetail.h", "tools/profiler/core/platform.cpp", "tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "c0e69e63c5bda15ab50b2dac39fa638605c47f60", "git_parents": ["751f779af377bbf942b6be7aa17c6d30d0abac62"], "node": "cd10b75afb36c6615a9d632a7ebc2545fb8ab7fa", "parents": ["5fc94060392d2ee6f7df48cd0a6d6e6f448c6577"], "tags": []}, {"author": "Artem Bilous \u003cmistikasoft@gmail.com\u003e", "branch": "default", "desc": "Bug 2056733 - Create cargo_bin directory if it does not exist in ensure_cargo_tools. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313331\n", "files": ["python/mozboot/mozboot/base.py"], "git_node": "6fa35304d238a468f552be4c88c81a6b0f081c91", "git_parents": ["c0e69e63c5bda15ab50b2dac39fa638605c47f60"], "node": "6cc60075814da9dee71f1018117024dc173a24b1", "parents": ["cd10b75afb36c6615a9d632a7ebc2545fb8ab7fa"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054403 - Only register the WebRender capture shortcuts when captures are enabled. r=firefox-desktop-core-reviewers ,Gijs\n\nThe key elements bound to wrCaptureCmd and wrToggleCaptureSequenceCmd were\nalways in the document. ShortcutUtils.isSystem only looks for a matching key\nelement, so Ctrl+Shift+3 and Ctrl+Shift+6 counted as Firefox shortcuts and could\nnot be assigned to WebExtension commands on macOS, even though the commands they\nare bound to do nothing unless gfx.webrender.debug.enable-capture is set (which\nonly happens in builds configured with --enable-webrender-debugger). The key\nhandler also swallowed the key events before finding out that the command is\ndisabled.\n\nRegister the keys dynamically when captures are enabled instead. They need their\nown keyset because a keyset's handlers are built when it is inserted into the\ndocument.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314601\n", "files": ["browser/base/content/browser-graphics-utils.js", "browser/base/content/browser-sets.inc.xhtml", "browser/base/content/test/keyboard/browser.toml", "browser/base/content/test/keyboard/browser_gfxDebugShortcuts.js"], "git_node": "ac82e80b0c753f15ebc3d851e07008e2193098e1", "git_parents": ["6fa35304d238a468f552be4c88c81a6b0f081c91"], "node": "66bec31baaceb39f5035496cdae9b7f64096932e", "parents": ["6cc60075814da9dee71f1018117024dc173a24b1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1982771 - Avoid some flushing in view transition processing. r=layout-reviewers,dshin\n\nWe don't need to flush for every already-done transition.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315575\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/view-transitions/ViewTransition.cpp"], "git_node": "cc610e6f633f4cd8cd11a6cdd3fb154c27c22a19", "git_parents": ["ac82e80b0c753f15ebc3d851e07008e2193098e1"], "node": "7f5e8edc71756a04c23d37614aa4e380f6bbebe3", "parents": ["66bec31baaceb39f5035496cdae9b7f64096932e"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058426 - [remote] Recursively set breakpoints on child scripts r=Sasha\n\nIn the initial landing for the moz:debugging module, I misunderstood the onNewScript behavior, as well as what was a \"script\" from the point of view of SpiderMonkey.\n\nThere is no 1:1 relationship between a Script and a Source, and for instance a source which contains several functions will be associated with (if I understood correctly) as many scripts as there are functions.\n\nDepending on how the script gets compiled, we might get individual onNewScript calls for each compilation unit, or just one for the top script.\n\nDevTools already handles this by recursively checking all the child scripts from a top level script, so we reapply the same approach here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314602\n", "files": ["remote/webdriver-bidi/modules/windowglobal/moz/debugging.sys.mjs", "testing/web-platform/mozilla/tests/webdriver/bidi/moz/debugging/set_breakpoint/inner_function.py"], "git_node": "9bc8908f03eccb3fcae37fbf083b1da0607dbaf3", "git_parents": ["cc610e6f633f4cd8cd11a6cdd3fb154c27c22a19"], "node": "8cc3913baed6a8fcd1ebdb61b647450292a36e4d", "parents": ["7f5e8edc71756a04c23d37614aa4e380f6bbebe3"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053465 - Add hover state to theme picker items r=desktop-theme-reviewers,mstriemer\n\nHovering an unchecked theme picker item now shows a ring using the\nselected border color at 40 percent opacity and the same width as\nthe selected state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314048\n", "files": ["toolkit/content/widgets/theme-picker/theme-picker.css"], "git_node": "61a5f796be3bde93d076cf91419df57c67036600", "git_parents": ["9bc8908f03eccb3fcae37fbf083b1da0607dbaf3"], "node": "1379b2d293971120ea5a58523588d0bd17f17e18", "parents": ["8cc3913baed6a8fcd1ebdb61b647450292a36e4d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2057930 - Re-enable browser_edit_address_doorhanger_display.js on Linux, r=aryx.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315536\n", "files": ["browser/extensions/formautofill/test/browser/address/browser.toml"], "git_node": "d58e70267b4f25fbbf4f0c105866122d7884f7f2", "git_parents": ["61a5f796be3bde93d076cf91419df57c67036600"], "node": "b6fd275515a13be25eb84930909b00113e29dfce", "parents": ["1379b2d293971120ea5a58523588d0bd17f17e18"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046795 - Update account menu sign in button for Nova r=desktop-theme-reviewers,fluent-reviewers,omc-reviewers,bolsson,sync-reviewers,skhamis,aminomancer,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313016\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-profiles.js", "browser/base/content/browser-sync.js", "browser/base/content/kit-signed-out.svg", "browser/base/content/test/sync/browser_sync.js", "browser/base/jar.mn", "browser/components/asrouter/tests/browser/browser_asrouter_menu_messages.js", "browser/locales/en-US/browser/sync.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "338e691fa10958e0aa5a60d9c187ee3124d30dea", "git_parents": ["d58e70267b4f25fbbf4f0c105866122d7884f7f2"], "node": "25bb1fe2c7946d8bb78a7dce6300a5a0af825c24", "parents": ["b6fd275515a13be25eb84930909b00113e29dfce"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057320 - Remove My services section and implement conditional strings diplay for Privacy tools section r=rking,fluent-reviewers,desktop-theme-reviewers,Itiel,bolsson\n\n- remove My Services section from account menu\n- show all tools in Privacy Tools section and update strings if a user is signed up for that tool\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315305\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "087eb6aa67c27a2ba0adf80ae3b3e03d4279580f", "git_parents": ["338e691fa10958e0aa5a60d9c187ee3124d30dea"], "node": "3a1cddc93ceae35747f8b576bcf77e3ebd2c2a9b", "parents": ["25bb1fe2c7946d8bb78a7dce6300a5a0af825c24"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058273 - Make sure newly added shared prefs are added to the shared database. r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314497\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_nova_test.js", "browser/components/profiles/tests/browser/browser_test_current_theme_from_amo.js", "browser/components/profiles/tests/browser/head.js", "browser/components/profiles/tests/unit/test_shared_prefs_lifecycles_methods.js"], "git_node": "e321328b3d8db5ce6752b02d36745b40912c417b", "git_parents": ["087eb6aa67c27a2ba0adf80ae3b3e03d4279580f"], "node": "1b392e30dc516d8ef2aed2b61412e5b04ed8ab6d", "parents": ["3a1cddc93ceae35747f8b576bcf77e3ebd2c2a9b"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058714 - Same-document navigation can originate a SERP impression for a browser with no prior tracked session - r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315507\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/schema/search-telemetry-v2-schema.json", "browser/components/search/schema/search-telemetry-v2-ui-schema.json", "browser/components/search/test/browser/telemetry/browser.toml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_spa_require_top_level_impression_origin.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_spa_single_tab.js", "browser/components/search/test/browser/telemetry/head-spa.js", "browser/components/search/test/browser/telemetry/head.js", "browser/components/search/test/browser/telemetry/searchTelemetryNonSerpPushState.html", "browser/components/search/test/browser/telemetry/searchTelemetrySinglePageApp.html"], "git_node": "f4896c203dd924f051037f5f5cb2fe6f6e3ad009", "git_parents": ["e321328b3d8db5ce6752b02d36745b40912c417b"], "node": "ba6864999fc7e7edf44a10d07fe5512d2a47fedf", "parents": ["1b392e30dc516d8ef2aed2b61412e5b04ed8ab6d"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057566 - Import browser/components/urlbar/content modules into content global. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314010\n", "files": ["browser/components/urlbar/content/UrlbarChildTelemetry.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "ad407445b21f910f641419551e12d399c6e40ad9", "git_parents": ["f4896c203dd924f051037f5f5cb2fe6f6e3ad009"], "node": "c9ec05775a4c573fd81cdc530fdcc7e4680f3e8e", "parents": ["ba6864999fc7e7edf44a10d07fe5512d2a47fedf"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872782 - Remove the layout.css.font-palette.enabled pref. r=layout-reviewers,webidl,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313757\n", "files": ["dom/animation/test/mozilla/test_disabled_properties.html", "dom/webidl/CSSFontPaletteValuesRule.webidl", "gfx/thebes/gfxPlatform.cpp", "layout/style/test/file_animations_with_disabled_properties.html", "layout/style/test/property_database.js", "layout/style/test/test_animations_with_disabled_properties.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/longhands.toml", "servo/components/style/stylesheets/rule_parser.rs"], "git_node": "eb5e792bb700cceac04566ffcff8610feb0f07d0", "git_parents": ["ad407445b21f910f641419551e12d399c6e40ad9"], "node": "211160798fd4961359f792d35f9940a4c452050d", "parents": ["c9ec05775a4c573fd81cdc530fdcc7e4680f3e8e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872781 - Remove the layout.css.font-variations.enabled pref. r=layout-reviewers,webidl,devtools-reviewers,firefox-style-system-reviewers,emilio,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313759\n", "files": ["devtools/server/actors/page-style.js", "dom/webidl/FontFace.webidl", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxPlatform.cpp", "layout/inspector/tests/chrome/test_fontVariationsAPI.xhtml", "layout/reftests/font-face/reftest.list", "layout/reftests/font-variations/reftest.list", "layout/style/FontFaceImpl.cpp", "layout/style/FontFaceSetImpl.cpp", "layout/style/test/property_database.js", "layout/style/test/test_system_font_serialization.html", "layout/style/test/test_transitions_per_property.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/font_face_descriptors.toml", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/shorthands.rs", "testing/manifest/test/data/fontface_reftest.list", "testing/web-platform/meta/css/css-fonts/__dir__.ini"], "git_node": "653481b7acb70c10b589564ac2280e2aa0cf433c", "git_parents": ["eb5e792bb700cceac04566ffcff8610feb0f07d0"], "node": "b53fa49d734e2e8e1a339426e22f17d149a9c19b", "parents": ["211160798fd4961359f792d35f9940a4c452050d"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872779 - Remove the layout.css.font-tech.enabled pref. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313761\n", "files": ["layout/reftests/font-face/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/font_face.rs", "servo/components/style/stylesheets/supports_rule.rs", "testing/manifest/test/data/fontface_reftest.list"], "git_node": "edc9db30ea804a11e3735ce628ccc099ebe707e6", "git_parents": ["653481b7acb70c10b589564ac2280e2aa0cf433c"], "node": "f91489791e972afdd4828e74a128a856087fcc12", "parents": ["b53fa49d734e2e8e1a339426e22f17d149a9c19b"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057236 - Remove the layout.css.font-variant-emoji.enabled pref. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313764\n", "files": ["layout/style/test/property_database.js", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/shorthands.rs"], "git_node": "69600d1b1d5efe49236872c43e724c5f00776284", "git_parents": ["edc9db30ea804a11e3735ce628ccc099ebe707e6"], "node": "486fadc923aedd96bdfb6b806155fc2e7e0a4bdc", "parents": ["f91489791e972afdd4828e74a128a856087fcc12"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057259 - Remove the gfx.font_rendering.colr_v1.enabled pref. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313766\n", "files": ["gfx/tests/fuzz/TestCOLRv1.cpp", "gfx/thebes/COLRFonts.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxPlatform.cpp", "layout/reftests/font-face/colrv1-02.html", "layout/reftests/font-face/colrv1-02a-ref.html", "layout/reftests/font-face/colrv1-02b-ref.html", "layout/reftests/font-face/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "testing/manifest/test/data/fontface_reftest.list", "testing/manifest/test/test_skipfails.py"], "git_node": "4423ce645c8735a523b9ee4c6e1d12f789975795", "git_parents": ["69600d1b1d5efe49236872c43e724c5f00776284"], "node": "a4fbce8c0519192af3781bc2dc81f57099841505", "parents": ["486fadc923aedd96bdfb6b806155fc2e7e0a4bdc"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1872779, 1872781, 1872782, 2057236, 2057259: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/tests/fuzz/TestCOLRv1.cpp"], "git_node": "fb99df8a6d76af5a8e97f2385b9f40c75ef8e152", "git_parents": ["4423ce645c8735a523b9ee4c6e1d12f789975795"], "node": "2c55635c9f1995600507b32d3f9d786d4ce6215b", "parents": ["a4fbce8c0519192af3781bc2dc81f57099841505"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2057074: Add bug references to recently updated metrics. r=jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314313\n", "files": ["toolkit/profile/metrics.yaml"], "git_node": "eaa323393d87abda4f5876dde7d169081d148fec", "git_parents": ["fb99df8a6d76af5a8e97f2385b9f40c75ef8e152"], "node": "5322d612db1417087535f0e1c3b3913d3708b4bf", "parents": ["2c55635c9f1995600507b32d3f9d786d4ce6215b"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - mozharness: avoid arch mismatch between python and venv on mac. r=taskgraph-reviewers,bhearsum\n\nTasks using `use-uv` on mac currently fetch a x86_64 uv.  When using\nsystem python on Apple silicon we might end up with arm64 python and a\nx86_64 venv, and fail to load binary modules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315614\n", "files": ["testing/mozharness/mozharness/base/python.py"], "git_node": "d17a86064272fe44a72b9ee721ff51aa4dcdf1b2", "git_parents": ["eaa323393d87abda4f5876dde7d169081d148fec"], "node": "01dee8dd74148152f01d8b5854eaa983cb5dc245", "parents": ["5322d612db1417087535f0e1c3b3913d3708b4bf"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2052154 - Let keyboard users Tab to the edit button in login autocomplete rows. r=desktop-theme-reviewers,credential-management-reviewers,mtigley,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313266\n", "files": ["browser/themes/shared/autocomplete.css", "toolkit/actors/AutoCompleteChild.sys.mjs", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/components/autocomplete/nsIAutoCompletePopup.idl", "toolkit/components/passwordmgr/LoginAutoComplete.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_preselect_login.js", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.css", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.mjs", "toolkit/components/satchel/nsFormFillController.cpp", "toolkit/content/widgets/autocomplete-popup.js", "toolkit/locales/en-US/chrome/passwordmgr/passwordmgr.properties"], "git_node": "8161c7b2cf22c312c8b75e6c4e8a7595a2f408a2", "git_parents": ["d17a86064272fe44a72b9ee721ff51aa4dcdf1b2"], "node": "c9ce5895d0a017d3a1b975e3b4e38213b55d675d", "parents": ["01dee8dd74148152f01d8b5854eaa983cb5dc245"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use uv in mochitest tasks. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312751\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "1da2c2278d1e01142984aea88f01711d21abe73d", "git_parents": ["8161c7b2cf22c312c8b75e6c4e8a7595a2f408a2"], "node": "036ff6333def894c87c86d68d7f4bf425c61d749", "parents": ["c9ce5895d0a017d3a1b975e3b4e38213b55d675d"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2048762 - Use AboutRedirector for about:studies r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314997\n", "files": ["browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "toolkit/components/normandy/ShieldContentProcess.sys.mjs", "toolkit/components/normandy/components.conf", "toolkit/components/normandy/content/AboutPages.sys.mjs", "toolkit/components/normandy/moz.build"], "git_node": "5059533d570715ee210858d456bc6cc6439fc263", "git_parents": ["1da2c2278d1e01142984aea88f01711d21abe73d"], "node": "2c9c7b5dfeb912c67b9b6c52f4c512a624019612", "parents": ["036ff6333def894c87c86d68d7f4bf425c61d749"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057489 - Scope the urlbar message path's browser resolution to the sender. r=mbeier\n\nUrlbarParentController resolved a target browser from a caller-supplied\nbrowserId via the global BrowsingContext.getCurrentTopByBrowserId at several\nmessage-path handlers. Once the actor is exposed to a content \u003cmoz-urlbar\u003e\n(bug 2057482), that id is attacker-controllable by a compromised privilegedabout\nprocess, which could then reach an arbitrary tab in any window -- loadURL most\nsharply, via a where=\"current\" openTrustedLinkIn.\n\nRoute every browser-by-id resolution through one resolveTargetBrowser helper\nkeyed on the sender's own browsing context, which is parent-resolved and can't\nbe spoofed by content: a content sender (isContent) only ever targets its own\ntab (top.embedderElement) and its wire browserId is ignored; only a chrome\nsender, which has no own content tab, is trusted to resolve a pinned id globally.\n\nBehavior-neutral on both chrome transports -- the direct path and the\nchromeMessagePassing message path both take the chrome branch -- so the existing\nsuite and the pref-on CI variant stay green; the content branch is exercised\nonce a content instance exists. Routing through one helper also keeps the\nboundary auditable: getCurrentTopByBrowserId appears once, in the helper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313986\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs"], "git_node": "a0116cbeade21234ca1c2a1caa3a9b5a105c71b3", "git_parents": ["5059533d570715ee210858d456bc6cc6439fc263"], "node": "9ed61b30faf168865aaf7088aafc99feb0490067", "parents": ["2c9c7b5dfeb912c67b9b6c52f4c512a624019612"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059379 - Let search mode settle in assertSearchMode. r=mbeier\n\nEntering and exiting search mode resolves the engine through the engine store,\nwhich round-trips on the message path, so a caller asserting immediately can\nstill observe the previous state.\n\nWorth checking: the wait swallows its own timeout, so the assertions below it\nstill report a genuine mismatch precisely instead of it surfacing as a bare\ntimeout. Around 280 call sites share this helper, which is why the settling\nbelongs here rather than in each test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315268\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "3141709ec472ee2f1a55bee900803487dea49c94", "git_parents": ["a0116cbeade21234ca1c2a1caa3a9b5a105c71b3"], "node": "8e39615113d9f50be8aed7157a77f9a547007e44", "parents": ["9ed61b30faf168865aaf7088aafc99feb0490067"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Resolve the one-off button after its rebuild in enterSearchMode. r=mbeier\n\nA test fix. The one-offs rebuild asynchronously and replace their buttons, so the\nbutton the helper resolved before a rebuild is detached by the time the click is\nsynthesized: the click lands on nothing and no search mode is entered, or on\nwhichever button now occupies that position. The helper waited for the rebuild in\nflight when it started, but a fresh one can begin after that wait -- over the wire\nthe engine data arrives late enough in a new window to invalidate the cache at just\nthat point. It now resolves the button once the rebuild settles and confirms the\nbutton is still in the document.\n\nWorth knowing: forcing _rebuild() at the worst moment reproduces the failure on\nLinux, and passes with this change in place. The Windows uipc failure this addresses\nis the sibling symptom, where the click reaches a different connected button and\nsearch mode ends up carrying an engine name -- browser_no_results.js then sees one\nresult where it expects zero.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315540\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "d508631f185f8304123f016d01a822f6567dafb6", "git_parents": ["3141709ec472ee2f1a55bee900803487dea49c94"], "node": "66227f428c7bd8d98097a6502222ded440788a95", "parents": ["8e39615113d9f50be8aed7157a77f9a547007e44"], "tags": []}, {"author": "Ryo Hiyoshi \u003cryohiy.dev@gmail.com\u003e", "branch": "default", "desc": "Bug 2058669 [wpt PR 61580] - Replace lone surrogates with U+FFFD in the Rust XML parser, a=testonly\n\nAutomatic update from web-platform-tests\nReplace lone surrogates with U+FFFD in the Rust XML parser\n\nCurrently, when the input string contains a lone surrogate,\nDOMParser.parseFromString() returns a parsererror, so the entire\ndocument is lost.\n\nConvert the input with kStrictReplacingErrors so that lone\nsurrogates become U+FFFD, producing a lenient output like Firefox.\n\nFixed: 40814739\nChange-Id: I494a0ef31e1ea8971c749625c1836386f3256f1c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8015162\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669746}\n\n--\n\nwpt-commits: 6308049a5f8d8f1e07d75d606a009af2415c5d81\nwpt-pr: 61580\n", "files": ["testing/web-platform/tests/domparsing/DOMParser-parseFromString-xml-parsererror.html"], "git_node": "48bbb6ac22240a89ff26ba1c506d130d5e952a6c", "git_parents": ["d508631f185f8304123f016d01a822f6567dafb6"], "node": "8d3dd5aeddad66a63270547198317bdbe72952c0", "parents": ["66227f428c7bd8d98097a6502222ded440788a95"], "tags": []}, {"author": "David Grogan \u003cdgrogan@chromium.org\u003e", "branch": "default", "desc": "Bug 2058681 [wpt PR 61582] - [menu a11y] Begin menu dialog fallback and keyboard routing, a=testonly\n\nAutomatic update from web-platform-tests\n[menu a11y] Begin menu dialog fallback and keyboard routing\n\nThis CL is the first step of tracking and reacting to content model\nviolations for \u003cmenubar\u003e and \u003cmenulist\u003e elements. We follow the \u003cselect\u003e\npattern and change to a dialog aria role and re-enable TAB key\nnavigation when we detect certain types of descendants. This prevents\nscreen reader users from missing content because the menu-specific\narrow-key navigation skips it.\n\nSpecifically, a menu WILL fallback to a dialog role if we detect:\n - interactive elements (e.g., \u003cbutton\u003e, \u003cinput\u003e).\n - Anchor tags (\u003ca\u003e), which the explainer explicitly disallows in menus.\n - Stray text nodes that are not wrapped in a \u003cmenuitem\u003e or \u003clegend\u003e.\n - Elements that dynamically become interactive via attributes (i.e.,\n   adding tabindex or contenteditable).\n\nAs of this CL, a menu WILL NOT fallback to a dialog role for:\n - Pure structural violations that don't inherently trap focus or hide\n   content, such as a bare \u003cdiv\u003e inside a \u003csubmenu\u003e or a \u003cmenubar\u003e\n   inside a \u003cmenulist\u003e.\n - Malformed submenu structures (e.g., missing required elements,\n   placing the \u003cmenulist\u003e before the \u003cmenuitem\u003e, or adding extra\n   elements).\n - Wayward text injected via CSS pseudo-elements (this is a known\n   shortcoming, as MutationObserver cannot detect pseudo-elements).\n\nThese^^ scenarios need further manual testing. Some may necessitate\nswitching to dialog.\n\nDevTools warnings and UseCounters will be added in a future CL.\n\nUnder the hood, this CL introduces MenuMutationObserver, mirroring\nSelectMutationObserver's pattern and sharing some utility methods. It\nignores transient mutation records from already-detached subtrees to\nprevent double-counting.\n\nWe also modify HTMLMenuItemElement's HandleMenuKeyboardEvents and\nIsKeyboardFocusableSlow. If the owning menu is in dialog mode, we bail\nout of arrow-key routing and allow menuitems to be natively focusable.\nThis enables TAB to navigate between the valid menuitems and the invalid\ncontent.\n\nBug: 513637242\nChange-Id: Icdf2ad252ec8abb83df79e0e99250aa55292b71a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7712770\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: David Grogan \u003cdgrogan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669762}\n\n--\n\nwpt-commits: 1841645046b720bdd785155ad1e2fc1169b1fbb8\nwpt-pr: 61582\n", "files": ["testing/web-platform/tests/html/semantics/menu/tentative/menu-content-model-violation.html", "testing/web-platform/tests/html/semantics/menu/tentative/menu-dialog-mode-focus.html"], "git_node": "9cd94146fdfd1167bf8cf6a57b04b9c5a5869d09", "git_parents": ["48bbb6ac22240a89ff26ba1c506d130d5e952a6c"], "node": "467e2946b2d199c9a28ef5a15c45bf103b29a1be", "parents": ["8d3dd5aeddad66a63270547198317bdbe72952c0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058681 [wpt PR 61582] - Update wpt metadata, a=testonly\n\nwpt-pr: 61582\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/menu/tentative/menu-content-model-violation.html.ini", "testing/web-platform/meta/html/semantics/menu/tentative/menu-dialog-mode-focus.html.ini"], "git_node": "1bd1fcafbe25c24b4bda2cb2295b828769a9e821", "git_parents": ["9cd94146fdfd1167bf8cf6a57b04b9c5a5869d09"], "node": "5e390382147b5ea827bea54e63c77fe2597383f8", "parents": ["467e2946b2d199c9a28ef5a15c45bf103b29a1be"], "tags": []}, {"author": "Giovanni Del Valle \u003cgdelvalle@microsoft.com\u003e", "branch": "default", "desc": "Bug 2058689 [wpt PR 61585] - [Content-Allowlist] Enforce embedded enforcement handshake, a=testonly\n\nAutomatic update from web-platform-tests\n[Content-Allowlist] Enforce embedded enforcement handshake\n\nThis is one in a series of CLs:\n\n1. https://crrev.com/c/7926080 - Rename AllowCSPFromHeaderValue to OriginOrWildcardHeaderValue\n2. https://crrev.com/c/7925634 - Add Connection-Allowlist embedded enforcement primitives\n3. https://crrev.com/c/7925636 - Add connectionallowlist iframe attribute + IPC transport\n4. https://crrev.com/c/7933938 - [You are here.]\n\nImplements the browser-side handshake for Connection-Allowlist embedded\nenforcement, mirroring CSP embedded enforcement.\n\nAt navigation start, SetupConnectionAllowlistEmbeddedEnforcement()\nsnapshots the frame's `connectionallowlist` attribute (parsed in the\nrenderer into a ConnectionAllowlist by the previous CL) or inherits the\nparent's requirement. At the response,\nCheckConnectionAllowlistEmbeddedEnforcement() resolves the deferred\n`response-origin` token against the framed origin, enforces never-loosen\nagainst an ancestor's requirement, and decides whether the requirement\nmay apply: the framed document must either opt in via\n`Allow-Connection-Allowlist-From` (or be a local scheme) or deliver its\nown Connection-Allowlist that subsumes the required one. Otherwise the\nframe is blocked (ERR_BLOCKED_BY_RESPONSE).\n\nWhen the document opts into blanket enforcement, the required allowlist\nis installed as the frame's enforced Connection-Allowlist at commit, and\nRenderFrameHostImpl stores the requirement so descendant frames inherit\nit.\n\nLocal-scheme frames (about:blank/srcdoc/data/...) are allowed but do not\nyet install the requirement; that needs incorporation in the policy\ncontainer builder and is a follow-up (TODO crbug.com/447954811). The\nenforcement browsertests are added in a follow-up change.\n\nBug: 522111613\nChange-Id: I595ded00a84edd49cf6c55e8ae90c5a1bd9c1095\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7933938\nReviewed-by: Rakina Zata Amni \u003crakina@chromium.org\u003e\nReviewed-by: Brandon Maslen \u003cbrandm@microsoft.com\u003e\nCommit-Queue: Giovanni Del Valle \u003cgdelvalle@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1669850}\n\n--\n\nwpt-commits: 82d68c3c29d9d28538b1ed30ebe540eb52b34f9b\nwpt-pr: 61585\n", "files": ["testing/web-platform/tests/connection-allowlist/tentative/iframe-connectionallowlist-embedded-enforcement.https.html", "testing/web-platform/tests/connection-allowlist/tentative/iframe-connectionallowlist-request-header.https.html", "testing/web-platform/tests/connection-allowlist/tentative/resources/embedded-enforcement-child.py"], "git_node": "2993010f1d869197360b24812d843d675c251e26", "git_parents": ["1bd1fcafbe25c24b4bda2cb2295b828769a9e821"], "node": "18aa3ce6cdacc7486caa1ea2a7f9791150f6f217", "parents": ["5e390382147b5ea827bea54e63c77fe2597383f8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058689 [wpt PR 61585] - Update wpt metadata, a=testonly\n\nwpt-pr: 61585\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/iframe-connectionallowlist-embedded-enforcement.https.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/iframe-connectionallowlist-request-header.https.html.ini"], "git_node": "5506573c9bd1cdc09539c0a4afe5bf09c7de8185", "git_parents": ["2993010f1d869197360b24812d843d675c251e26"], "node": "edbda32f2495329b3a9ae59fc5f365b84019ec3b", "parents": ["18aa3ce6cdacc7486caa1ea2a7f9791150f6f217"], "tags": []}, {"author": "Dale Curtis \u003cdalecurtis@chromium.org\u003e", "branch": "default", "desc": "Bug 2058765 [wpt PR 61588] - [WebCodecs] Preemptively fix some test color space issues, a=testonly\n\nAutomatic update from web-platform-tests\n[WebCodecs] Preemptively fix some test color space issues\n\nOnce we start allowing BT.709 color spaces for RGB -\u003e YUV\nconversions, these tests will start failing due to bugs in the\ntest setup. Preemptively fix them.\n\nR=tguilbert\n\nBug: 467555325\nChange-Id: I04dabe8b0e5917033759340b54defcdd03620557\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8160274\nReviewed-by: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nAuto-Submit: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCommit-Queue: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCommit-Queue: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669878}\n\n--\n\nwpt-commits: 6e30b050e41f4c82ad77759e73a2ff8773a40a8a\nwpt-pr: 61588\n", "files": ["testing/web-platform/tests/webcodecs/full-cycle-test.https.any.js", "testing/web-platform/tests/webcodecs/videoFrame-createImageBitmap.https.any.js"], "git_node": "3c58fa929ef872cfd0a399bb29e92b3c1f913519", "git_parents": ["5506573c9bd1cdc09539c0a4afe5bf09c7de8185"], "node": "dc1f2aec1266bd7f8bbcaedf3d707c545938d758", "parents": ["edbda32f2495329b3a9ae59fc5f365b84019ec3b"], "tags": []}, {"author": "Dale Curtis \u003cdalecurtis@chromium.org\u003e", "branch": "default", "desc": "Bug 2058775 [wpt PR 61590] - [WebCodecs] Enable HBD format checks for vp9.(2|3) encoding tests, a=testonly\n\nAutomatic update from web-platform-tests\n[WebCodecs] Enable HBD format checks for vp9.(2|3) encoding tests\n\nHBD formats are now standardized, so the test can check these.\n\nR=tguilbert\n\nBug: 537818862\nChange-Id: Iee46055180ed013d95e6a9bbc510628d883a05ee\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8164168\nCommit-Queue: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nAuto-Submit: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nReviewed-by: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCommit-Queue: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669896}\n\n--\n\nwpt-commits: f1919c1af650123230323c859560b7b2d4e3c3f6\nwpt-pr: 61590\n", "files": ["testing/web-platform/tests/webcodecs/full-cycle-test.https.any.js"], "git_node": "1303fe782ae01cda301c2c5a1940f665eb089d2c", "git_parents": ["3c58fa929ef872cfd0a399bb29e92b3c1f913519"], "node": "446aa1359c7f12d9aa8b7e16e43f12ddef6e7fdc", "parents": ["dc1f2aec1266bd7f8bbcaedf3d707c545938d758"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058775 [wpt PR 61590] - Update wpt metadata, a=testonly\n\nwpt-pr: 61590\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webcodecs/full-cycle-test.https.any.js.ini"], "git_node": "872698501c47084cb25aa604bfd26779d966cff3", "git_parents": ["1303fe782ae01cda301c2c5a1940f665eb089d2c"], "node": "09988a49da542d29bfa5662a40f00474803d68e5", "parents": ["446aa1359c7f12d9aa8b7e16e43f12ddef6e7fdc"], "tags": []}, {"author": "Patrick Griffis \u003cpgriffis@igalia.com\u003e", "branch": "default", "desc": "Bug 2058706 [wpt PR 61586] - compression-dictionary: Fix corrupted dcb files, a=testonly\n\nAutomatic update from web-platform-tests\ncompression-dictionary: Fix corrupted dcb files\n\n--\n\nwpt-commits: dd725197d591626ee4ad361929a0ba395a668fe4\nwpt-pr: 61586\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/resources/static/Makefile", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/dcb-header", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/dcz-header", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-image-001.png.dcb", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-subframe-001.html.dcb"], "git_node": "999c2a40a6b415338ef04699ffa7d46a3370523b", "git_parents": ["872698501c47084cb25aa604bfd26779d966cff3"], "node": "4b2b1a459cff994ae3a9c8aba020c621d3934777", "parents": ["09988a49da542d29bfa5662a40f00474803d68e5"], "tags": []}, {"author": "Basuke Suzuki \u003cbasuke@apple.com\u003e", "branch": "default", "desc": "Bug 2057681 [wpt PR 61525] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320102, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320102 (#61525)\n\nCo-authored-by: Basuke Suzuki \u003cb_suzuki@apple.com\u003e\n--\n\nwpt-commits: 817f5dff5e39b8da6177c8e098d42f4d64827178\nwpt-pr: 61525\n", "files": ["testing/web-platform/tests/webtransport/resources/webtransport-test-helpers.sub.js", "testing/web-platform/tests/webtransport/streams-close.https.any.js"], "git_node": "8f84adaef407b952f5279ccb7f141b8b37e6ffe5", "git_parents": ["999c2a40a6b415338ef04699ffa7d46a3370523b"], "node": "db3e4f28bd7bdca8f6f0dea940517950f9bce5eb", "parents": ["4b2b1a459cff994ae3a9c8aba020c621d3934777"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2058837 [wpt PR 61593] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=318103, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=318103 (#61593)\n--\n\nwpt-commits: 5ac50747f1c8cb3fc025529f0b5aa22b78c02482\nwpt-pr: 61593\n", "files": ["testing/web-platform/tests/svg/types/scripted/SVGMatrix-tentative.html", "testing/web-platform/tests/svg/types/scripted/SVGMatrix.html", "testing/web-platform/tests/svg/types/scripted/WEB_FEATURES.yml"], "git_node": "75b2243e4253c7ba1cd3557ee1adbb8c3c6e1623", "git_parents": ["8f84adaef407b952f5279ccb7f141b8b37e6ffe5"], "node": "e0510f726b88910149d155bb4360ef4bd681dc3f", "parents": ["db3e4f28bd7bdca8f6f0dea940517950f9bce5eb"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2055848 [wpt PR 61361] - Update CODEOWNERS, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated update of CODEOWNERS\n\n--\n\nwpt-commits: 6aab815f34c7c012a47202485e29dc8217e40877\nwpt-pr: 61361\n", "files": ["testing/web-platform/tests/CODEOWNERS"], "git_node": "da2406b118ba7c4afd34a7660496a01af2e280d8", "git_parents": ["75b2243e4253c7ba1cd3557ee1adbb8c3c6e1623"], "node": "4fede227086c90b0db0ff0f84b2ea52f03151626", "parents": ["e0510f726b88910149d155bb4360ef4bd681dc3f"], "tags": []}, {"author": "Gabriel Brito \u003cgabrielbrito@microsoft.com\u003e", "branch": "default", "desc": "Bug 2058848 [wpt PR 61600] - Convert HTMLMediaElement web tests to WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nConvert HTMLMediaElement web tests to WPTs\n\nThis CL converts the HTMLMediaElement web tests for the\nmedia-playback-while-not-visible permission policy to WPTs.\n\nBug: 351354996\nChange-Id: Ia129b5c66a453d8db444be04e0d25f0a8157b3c2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8133567\nReviewed-by: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCommit-Queue: Gabriel Brito \u003cgabrielbrito@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1670029}\n\n--\n\nwpt-commits: 8a458af3c3d42217e95c0546922d81279732046a\nwpt-pr: 61600\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/media-elements/media-playback-while-not-visible-permission-policy/cant-play-if-hidden.tentative.sub.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/media-playback-while-not-visible-permission-policy/pause-when-hidden.tentative.sub.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/media-playback-while-not-visible-permission-policy/resources/intermediate-frame.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/media-playback-while-not-visible-permission-policy/resources/media-frame.html", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/media-playback-while-not-visible-permission-policy/resources/media-playback-while-not-visible-utils.js", "testing/web-platform/tests/html/semantics/embedded-content/media-elements/media-playback-while-not-visible-permission-policy/viewport.tentative.sub.html"], "git_node": "6f55c1e33c4b83515320ea1724075b3db57bcdeb", "git_parents": ["da2406b118ba7c4afd34a7660496a01af2e280d8"], "node": "1a273b8afa27a9e647e6215cfcd8918dae43ecf6", "parents": ["4fede227086c90b0db0ff0f84b2ea52f03151626"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058848 [wpt PR 61600] - Update wpt metadata, a=testonly\n\nwpt-pr: 61600\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/embedded-content/media-elements/media-playback-while-not-visible-permission-policy/cant-play-if-hidden.tentative.sub.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/media-playback-while-not-visible-permission-policy/pause-when-hidden.tentative.sub.html.ini"], "git_node": "06657d3a1b5199a986070925a159b67d4287f4c9", "git_parents": ["6f55c1e33c4b83515320ea1724075b3db57bcdeb"], "node": "d16db065dcaf54d9d11c149567449f3010b66274", "parents": ["1a273b8afa27a9e647e6215cfcd8918dae43ecf6"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@abandonedwig.info\u003e", "branch": "default", "desc": "Bug 2047242 [wpt PR 60589] - layout: Properly set IS_BLEND_CONTAINER when creating WebRender stacking contexts, a=testonly\n\nAutomatic update from web-platform-tests\nlayout: Properly set IS_BLEND_CONTAINER when creating WebRender stacking contexts\n\nIn order to properly support `mix-blend-mode` stacking contexts that are\nparents of child stacking contexts with `mix-blend-mode` in their style\nneed to be marked with the is `IS_BLEND_CONTAINER` StackingContextFlag.\nIn addition to correcting the display of `mix-blend-mode` content, this\nalso work around an issue where `mix-blend-mode` was causing a panic\nwhen combined with a particular transform.\n\nThis also works around a variety of WebRender bugs that happen when\n`mix-blend-mode` is used near the root stacking context.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@abandonedwig.info\u003e\n\n--\n\nwpt-commits: 0fa86ce479b2dcee85f6bc0616894c18631cc347\nwpt-pr: 60589\n", "files": ["testing/web-platform/tests/css/compositing/mix-blend-mode/mix-blend-mode-root-element-transform-crash.html"], "git_node": "dc73115fe94ad41e5c0943657254c51525acd1ab", "git_parents": ["06657d3a1b5199a986070925a159b67d4287f4c9"], "node": "753048b62d8238f557764242dcf0e1875d3db6fa", "parents": ["d16db065dcaf54d9d11c149567449f3010b66274"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2059036 [wpt PR 61608] - Finish local WhitespaceAttacher before updating ::first-letter, a=testonly\n\nAutomatic update from web-platform-tests\nFinish local WhitespaceAttacher before updating ::first-letter\n\nTowards the end of Element::RebuildLayoutTree(), the local\nWhitespaceAttacher goes out of scope and ReattachWhitespaceSiblings() is\ncalled to clean up any remaining whitespace layout objects at the start\nof inline children.\n\nBefore going out of scope, we would update ::first-letter based on\nchanges from re-attached descendant boxes. However, since the\nWhitespaceAttacher had not gone out of scope, we would still have\nleftover whitespace boxes confusing the code finding the ::first-letter\ntext box.\n\nThis caused inconsistencies about whether we had a first-letter text at\nbox creation time vs interleaved layout tree update in the presence of\nsize container queries which resulted in re-attaching ::first-letters\noutside of the size container being laid out, which ended up crashing.\n\nMove RebuildFirstLetterLayoutTree() out of the WhitespaceAttacher scope\nin RebuildLayoutTree().\n\nBug: 536997542\n\nChange-Id: I9166e61f51a31020a7071139155579e0ee837e56\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8163672\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1670268}\n\n--\n\nwpt-commits: e0a659af0916d1ed8839e9e3d3f5158f6ecddd3c\nwpt-pr: 61608\n", "files": ["testing/web-platform/tests/css/css-pseudo/crashtests/chrome-536997542-crash.html"], "git_node": "0e8d0300bb785f9cd2c0522827196075291022b1", "git_parents": ["dc73115fe94ad41e5c0943657254c51525acd1ab"], "node": "868e13da58ae8e0f485d1614a950df5a1acf3910", "parents": ["753048b62d8238f557764242dcf0e1875d3db6fa"], "tags": []}, {"author": "Caio Lima \u003ccaiolima@igalia.com\u003e", "branch": "default", "desc": "Bug 2059028 [wpt PR 61607] - [defer-import-eval] Expect deadlock in cyclic TLA deferred import test, a=testonly\n\nAutomatic update from web-platform-tests\n[defer-import-eval] Expect deadlock in cyclic TLA deferred import test\n\nPer the resolution of the deferred import evaluation proposal\ndiscussion [1], a cycle where import.defer(A) pre-evaluates an\nasynchronous dependency B whose top-level `await import(A)` triggers\nA's evaluation must deadlock: A waits for B (evaluating-async), B\nwaits for A, and no promise ever settles. The existing test instead\nexpected import.defer() to reject with a TypeError, which matched\nV8's current (non-conformant) behavior: A's body runs and throws on\naccessing the still-evaluating deferred namespace.\n\nRewrite cyclic-tla-defer-eval.tentative.html to assert the spec\nbehavior: module B starts evaluating and suspends at its top-level\nawait, module A's body never runs, and the import.defer() promise\nremains pending after draining several macrotask turns.\n\nAlso remove cyclic-tla-fn-defer-eval.tentative.html: it exercised the\nsame cycle (only differing in A exporting a function, which doesn't\naffect the deadlock, since it happens before A's body runs) and its\nexpectation of successful resolution is wrong for the same reason.\n\n[1] https://github.com/tc39/proposal-defer-import-eval/issues/83\n\nBug: 530457806\nChange-Id: I64719d860d2258cba80827eb4d7d80a4725eface\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8037401\nCommit-Queue: Caio Lima \u003ccaiolima@igalia.com\u003e\nReviewed-by: Nikolaos Papaspyrou \u003cnikolaos@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1670269}\n\n--\n\nwpt-commits: ceaa87c2e174e12b23da8dc244c67cf8e993aa72\nwpt-pr: 61607\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-script-element/module/dynamic-import/cyclic-tla-defer-eval.tentative.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/module/dynamic-import/cyclic-tla-fn-defer-eval.tentative.html", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/module/dynamic-import/resources/cyclic-tla-fn-dep-a.js", "testing/web-platform/tests/html/semantics/scripting-1/the-script-element/module/dynamic-import/resources/cyclic-tla-fn-dep-b.js"], "git_node": "dd787dc3baf0bdd582b341d27769d46122e0489d", "git_parents": ["0e8d0300bb785f9cd2c0522827196075291022b1"], "node": "cfbb3a5f6362a7eed959e8e6619ce0ed606f236a", "parents": ["868e13da58ae8e0f485d1614a950df5a1acf3910"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059028 [wpt PR 61607] - Update wpt metadata, a=testonly\n\nwpt-pr: 61607\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/cyclic-tla-fn-defer-eval.tentative.html.ini"], "git_node": "367d7feb709ce67b17357383eea8ebcfa9bfa12c", "git_parents": ["dd787dc3baf0bdd582b341d27769d46122e0489d"], "node": "79cd936b93c240565f53048ce02817cc59c02e84", "parents": ["cfbb3a5f6362a7eed959e8e6619ce0ed606f236a"], "tags": []}, {"author": "Kiet Ho \u003ckiet.ho@apple.com\u003e", "branch": "default", "desc": "Bug 2058683 [wpt PR 61583] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320160, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320160\n\n--\n\nwpt-commits: 4833e6a6cb1488c21312a61d8759259b611161f9\nwpt-pr: 61583\n", "files": ["testing/web-platform/tests/css/css-conditional/container-queries/style-query-registered-custom-root-relative-units-change.html"], "git_node": "4c7c5967cbb0b71fcba4bfe135e7ec1b38305732", "git_parents": ["367d7feb709ce67b17357383eea8ebcfa9bfa12c"], "node": "8522615ab13afb0f32312bb2afa879d21dd42aa9", "parents": ["79cd936b93c240565f53048ce02817cc59c02e84"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058683 [wpt PR 61583] - Update wpt metadata, a=testonly\n\nwpt-pr: 61583\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/container-queries/style-query-registered-custom-root-relative-units-change.html.ini", "testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini"], "git_node": "697261216c035cec2f1afc186a149c57877ecc81", "git_parents": ["4c7c5967cbb0b71fcba4bfe135e7ec1b38305732"], "node": "3f9fa3c1f214b1a8047daa48089e10fcb07bfcdf", "parents": ["8522615ab13afb0f32312bb2afa879d21dd42aa9"], "tags": []}, {"author": "Navoda Munasinha \u003cnavoda.munasinha@codimite.com\u003e", "branch": "default", "desc": "Bug 2058608 [wpt PR 61575] - Keep input caret at the end when JS sets value after focus, a=testonly\n\nAutomatic update from web-platform-tests\nKeep input caret at the end when JS sets value after focus\n\nSetting input.value removes the old inner text node and creates a new\none, collapsing the live DOM selection to offset 0. SelectionChanged()\nthen cached that 0 even while unfocused (where the cache is\nauthoritative), so a mouse-release notification moved the caret to\nthe start on the next focus.\n\nOnly refresh the cache from the live selection while the control is\nfocused. This is guarded by the PreserveUnfocusedSelectionCache runtime\nflag (enabled by default) so it can be disabled if problems arise.\n\nBug: 40884623\nChange-Id: I6daf4b7ade20a56428784992dd5466bf1766bb8f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8143064\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nReviewed-by: David Baron \u003cdbaron@chromium.org\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1670439}\n\n--\n\nwpt-commits: ffb20c1d1878568b7fb8460502131a65da0e8fea\nwpt-pr: 61575\n", "files": ["testing/web-platform/tests/html/semantics/forms/textfieldselection/selection-set-value-after-focus.html"], "git_node": "6dab908caac698f5af617a1f1764be8e5ad4bd58", "git_parents": ["697261216c035cec2f1afc186a149c57877ecc81"], "node": "89071699f86bc1de626e6c0d4ca7d3c39600c304", "parents": ["3f9fa3c1f214b1a8047daa48089e10fcb07bfcdf"], "tags": []}, {"author": "Justin Lulejian \u003cjlulejian@chromium.org\u003e", "branch": "default", "desc": "Bug 2059256 [wpt PR 61612] - [Extensions] Fix WPT test failure for duplicate alarm name check, a=testonly\n\nAutomatic update from web-platform-tests\n[Extensions] Fix WPT test failure for duplicate alarm name check\n\nPreviously, the WebPlatform test browser.alarms.extension.html failed\nin testAlarmsErrorCases when testing that browser.alarms.create()\nthrows an error if an alarm name is specified both as a positional\nargument and inside AlarmCreateInfo. The test incorrectly used\nbrowser.test.assertThrows(), which only catches synchronous JavaScript\nexceptions. Specifying duplicate alarm names passes synchronous schema\nvalidation in the renderer process and is rejected asynchronously in\nthe browser process.\n\nAfter this commit lands, the WPT test suite correctly verifies that\nbrowser.alarms.create() rejects its returned Promise asynchronously\nwhen an alarm name is specified in both places. This change is a\nfollow-up to https://crrev.com/c/8040045 to fix the WPT test failure\nintroduced in that change.\n\nWe accomplished this by removing the synchronous assertThrows() call\nfrom testAlarmsErrorCases() and adding a new asynchronous test case,\ntestAlarmsCreateNameBothWaysError(), which asserts that the Promise\nreturned by browser.alarms.create() is rejected.\n\nTAG=agy\nCONV=12c27002-7096-4acc-b800-574a0262cf52\n\nBug: None\nChange-Id: I3048b55c23ee49c6dafd6f92c016809815b28e79\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8166461\nReviewed-by: Andrea Orru \u003candreaorru@chromium.org\u003e\nCommit-Queue: Justin Lulejian \u003cjlulejian@chromium.org\u003e\nAuto-Submit: Justin Lulejian \u003cjlulejian@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1670484}\n\n--\n\nwpt-commits: 94a99ce2263f96acbf10e22d6fedf258982d0a79\nwpt-pr: 61612\n", "files": ["testing/web-platform/tests/web-extensions/resources/alarms/background.js"], "git_node": "56c3306977a7f26cb4aec97b78539e71bc166e87", "git_parents": ["6dab908caac698f5af617a1f1764be8e5ad4bd58"], "node": "e4b8a20a7fdd8e090af79e2372c27c04a3dbb4a7", "parents": ["89071699f86bc1de626e6c0d4ca7d3c39600c304"], "tags": []}, {"author": "Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e", "branch": "default", "desc": "Bug 2057650 [wpt PR 61521] - webrtc-stats: add WPT for outbound-rtp psnrSum / psnrMeasurements, a=testonly\n\nAutomatic update from web-platform-tests\nwebrtc-stats: add WPT for outbound-rtp psnrSum / psnrMeasurements\n\nsplit from\n  https://chromium-review.googlesource.com/c/chromium/src/+/6149759/\nfor easier rollout\n\nBug: webrtc:388070060\nChange-Id: I65ca40200301e02269f952299efb0cc125ce0d05\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/6866692\nReviewed-by: Guido Urdaneta \u003cguidou@chromium.org\u003e\nCommit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\nReviewed-by: Erik Spr\u00e5ng \u003csprang@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1670581}\n\n--\n\nwpt-commits: 0989d75ef32dd0767f0abe7a29fc03a930ad22e3\nwpt-pr: 61521\n", "files": ["testing/web-platform/tests/webrtc-stats/video-psnr.https.html"], "git_node": "0a907bbc4e47d5cda405854aa8eba734ea684e2d", "git_parents": ["56c3306977a7f26cb4aec97b78539e71bc166e87"], "node": "14b2d728323d17184a8332816cd4001edba1b5ac", "parents": ["e4b8a20a7fdd8e090af79e2372c27c04a3dbb4a7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057650 [wpt PR 61521] - Update wpt metadata, a=testonly\n\nwpt-pr: 61521\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webrtc-stats/video-psnr.https.html.ini"], "git_node": "4433b390fb03a608e0e1cf6a03438d78367ed99e", "git_parents": ["0a907bbc4e47d5cda405854aa8eba734ea684e2d"], "node": "edc68e896fa692822bcbc04ece47eda5f59d71c8", "parents": ["14b2d728323d17184a8332816cd4001edba1b5ac"], "tags": []}, {"author": "Jose Dapena Paz \u003cjdapena@igalia.com\u003e", "branch": "default", "desc": "Bug 2059122 [wpt PR 61609] - ContainerTiming: use empty string for entry name, a=testonly\n\nAutomatic update from web-platform-tests\nContainerTiming: use empty string for entry name\n\nThe ContainerTiming specification does not define a value for the `name`\nproperty of \"container\" PerformanceEntry objects. We originally emitted\nthe fixed string \"container-paints\" by analogy with ElementTiming, which\nuses `name` to distinguish image (\"image-paint\") from text\n(\"text-paint\") entries.\n\nThat distinction does not apply to Container Timing: a container\naggregates both image and text paints, so there is nothing to\ndifferentiate via the name. Other paint-timing backends such as LCP do\nnot populate `name` this way either. Containers are already\ndistinguished by their `identifier` property, so the fixed name carried\nno information.\n\nSet the entry name to the empty string instead. Consumers should\nidentify container entries via `entryType === \"container\"` (or the\nPerformanceContainerTiming interface), not by name.\n\nSee https://github.com/WICG/container-timing/issues/62\n\nBug: 537814753\nChange-Id: Ief94a1fc192d675c3aafd84a4e7fee5fd4623174\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8138964\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCommit-Queue: Jos\u00e9 Dapena Paz \u003cjdapena@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1670583}\n\n--\n\nwpt-commits: d68053b0766adf9191a878b8f6a001d52d15c9a3\nwpt-pr: 61609\n", "files": ["testing/web-platform/tests/container-timing/resources/container-timing-helpers.js"], "git_node": "65aa3553ea53215229c69aec2cdf40624abcf128", "git_parents": ["4433b390fb03a608e0e1cf6a03438d78367ed99e"], "node": "7978809a8c96d9be121f6a9c3699292b33bfb593", "parents": ["edc68e896fa692822bcbc04ece47eda5f59d71c8"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2059318 [wpt PR 61621] - Tolerate text pixel difference in highlight-fallback-not-tinted.html, a=testonly\n\nAutomatic update from web-platform-tests\nTolerate text pixel difference in highlight-fallback-not-tinted.html\n\nOn Chrome Linux, highlight-fallback-not-tinted.html differs from its\nreference at one foreground pixel. At the final glyph edge, the test\npaints the red highlight background where the reference paints green\ntext.\n\nAdd fuzzy metadata tightly bounded to the observed one-pixel difference\nand maximum channel difference of 200. This preserves coverage that the\nfallback text is highlighted and that the object host is not tinted.\n\nBug: 357946492\nChange-Id: I265f837b9138cf09dce2c899917e84332920768d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8169740\nReviewed-by: Ana Sollano Kim \u003cansollan@microsoft.com\u003e\nCommit-Queue: Ana Sollano Kim \u003cansollan@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1670740}\n\n--\n\nwpt-commits: 7071993d531b18a91e503bd1e537f180b90cdff5\nwpt-pr: 61621\n", "files": ["testing/web-platform/tests/css/css-highlight-api/highlight-fallback-not-tinted.html"], "git_node": "419580d1ddc727256bfeb6bd4498dce7467e4b1e", "git_parents": ["65aa3553ea53215229c69aec2cdf40624abcf128"], "node": "9e8e6aa0167461ffc800c18f9b02d7d0e194fe0f", "parents": ["7978809a8c96d9be121f6a9c3699292b33bfb593"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2059321 [wpt PR 61624] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320606, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320606 (#61624)\n--\n\nwpt-commits: a95401e4e06351eb1e15f0e15cf50abf08fa545f\nwpt-pr: 61624\n", "files": ["testing/web-platform/tests/svg/coordinate-systems/viewBox-scaling-text-001.html"], "git_node": "7cab7b13db76009b8c8b4bd7a532a8586f3bd8f1", "git_parents": ["419580d1ddc727256bfeb6bd4498dce7467e4b1e"], "node": "3e404596ecd9cdc87132590a842f7f917d6ef120", "parents": ["9e8e6aa0167461ffc800c18f9b02d7d0e194fe0f"], "tags": []}, {"author": "Simon Sapin \u003csimon@igalia.com\u003e", "branch": "default", "desc": "Bug 2059246 [wpt PR 61611] - script: Use `is_in_a_document_tree()` to check if a node is in a tree, a=testonly\n\nAutomatic update from web-platform-tests\nscript: Use `is_in_a_document_tree()` to check if a node is in a tree\n\n\u2026 instead of `.has_parent()`. Being in a tree is a pre-condition of\n`insert_pre_order()` for its call to `compare_dom_tree_position()`.\nFailing to uphold that pre-condition caused a panic in some case\nfound by a DOM fuzzer.\n\nFixes: https://github.com/servo/servo/issues/46790\nTesting: adding a new crashtest to WPT\n\nSigned-off-by: Simon Sapin \u003csimon@igalia.com\u003e\n\n--\n\nwpt-commits: 01ac82934ee74c0a94ae6441b062c5a693b3d602\nwpt-pr: 61611\n", "files": ["testing/web-platform/tests/html/semantics/forms/resetting-a-form/form-attribute-detach-crash.html"], "git_node": "9ad971bb532ed5527434984cb516bc74d79a38a8", "git_parents": ["7cab7b13db76009b8c8b4bd7a532a8586f3bd8f1"], "node": "7be9c630cd6bc1a6161846c769f2b29cd7d5921b", "parents": ["3e404596ecd9cdc87132590a842f7f917d6ef120"], "tags": []}, {"author": "Josh Matthews \u003cjosh@joshmatthews.net\u003e", "branch": "default", "desc": "Bug 2059324 [wpt PR 61625] - test: Delay webxr test completion until all checks have completed., a=testonly\n\nAutomatic update from web-platform-tests\ntest: Delay test completion until all checks have completed.\n\nSigned-off-by: Josh Matthews \u003cjosh@joshmatthews.net\u003e\n\n--\n\nwpt-commits: c663605b15a65674963e0dd1bb6c0c6166617034\nwpt-pr: 61625\n", "files": ["testing/web-platform/tests/webxr/render_state_update.https.html"], "git_node": "173d302291e7da8a563b7465fc7ead5ce3a35acf", "git_parents": ["9ad971bb532ed5527434984cb516bc74d79a38a8"], "node": "78d5d3c3365476a4b9fca8b40284c893ddc1db5a", "parents": ["7be9c630cd6bc1a6161846c769f2b29cd7d5921b"], "tags": []}, {"author": "Servo WPT Sync \u003c32481905+servo-wpt-sync@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2059261 [wpt PR 61615] - Add tests for Attr.prefix for parser-inserted attributes, a=testonly\n\nAutomatic update from web-platform-tests\nAdd tests for Attr.prefix for parser-inserted attributes\n\nCo-authored-by: Ms2ger \u003cMs2ger@gmail.com\u003e\n--\n\nwpt-commits: 4bd79b259506afa78791f5c7f4de1fbc2ae168b8\nwpt-pr: 61615\n", "files": ["testing/web-platform/tests/dom/nodes/Attr-prefix-xhtml.xhtml", "testing/web-platform/tests/dom/nodes/Attr-prefix.html", "testing/web-platform/tests/dom/nodes/attributes.js"], "git_node": "2c429a2908e3b49d5fc15cc504037219ca722cb2", "git_parents": ["173d302291e7da8a563b7465fc7ead5ce3a35acf"], "node": "9e4373bb3e78f08e6c1eed897f531690683c08cb", "parents": ["78d5d3c3365476a4b9fca8b40284c893ddc1db5a"], "tags": []}, {"author": "youennf \u003cyouennf@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2059136 [wpt PR 61610] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=318556, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=318556 (#61610)\n--\n\nwpt-commits: b7ed7c8dcd260f0f80879577752c68f042a7d054\nwpt-pr: 61610\n", "files": ["testing/web-platform/tests/service-workers/service-worker/resources/soft-update-fetch-metadata.py", "testing/web-platform/tests/service-workers/service-worker/soft-update-fetch-metadata.https.html"], "git_node": "87957747901a3ae4d0916a0788d67ef0ef0b8b72", "git_parents": ["2c429a2908e3b49d5fc15cc504037219ca722cb2"], "node": "2bfb5ce45f0960a6fda5af3b4d5841bcef494d5a", "parents": ["9e4373bb3e78f08e6c1eed897f531690683c08cb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059136 [wpt PR 61610] - Update wpt metadata, a=testonly\n\nwpt-pr: 61610\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/service-workers/service-worker/soft-update-fetch-metadata.https.html.ini"], "git_node": "06dbfa28abea3ef1e9c3190024baaf1bab8fc541", "git_parents": ["87957747901a3ae4d0916a0788d67ef0ef0b8b72"], "node": "4a6a3c4d7895a14d4d079c1c05e0c7e81c287ebf", "parents": ["2bfb5ce45f0960a6fda5af3b4d5841bcef494d5a"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2059391 [wpt PR 61631] - Export some SVGTransformList tests to WPT, a=testonly\n\nAutomatic update from web-platform-tests\nExport some SVGTransformList tests to WPT\n\nCleans up the tests and expands test coverage a bit.\n\nBug: 40572887\nChange-Id: I7af176e2360b4b487f83df564a341c07c1784195\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8165205\nCommit-Queue: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1670934}\n\n--\n\nwpt-commits: 0da80337a45b0cd98f9c1d3ca80896d42a8a27a7\nwpt-pr: 61631\n", "files": ["testing/web-platform/tests/svg/coordinate-systems/SVGTransformList.consolidate-01.html", "testing/web-platform/tests/svg/coordinate-systems/SVGTransformList.list-01.html", "testing/web-platform/tests/svg/coordinate-systems/SVGTransformList.list-02.html"], "git_node": "deb17e7f15b4d147e68fb6a4766318430fe06198", "git_parents": ["06dbfa28abea3ef1e9c3190024baaf1bab8fc541"], "node": "24c9e14eafd72b46162628d5c69217e1c9671499", "parents": ["4a6a3c4d7895a14d4d079c1c05e0c7e81c287ebf"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059391 [wpt PR 61631] - Update wpt metadata, a=testonly\n\nwpt-pr: 61631\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/svg/coordinate-systems/SVGTransformList.list-01.html.ini"], "git_node": "e70fb4ce05e5d3660c62448fc93265e1ede8c5b3", "git_parents": ["deb17e7f15b4d147e68fb6a4766318430fe06198"], "node": "20029b126d8c24e71609fd223f90bbb6848d3461", "parents": ["24c9e14eafd72b46162628d5c69217e1c9671499"], "tags": []}, {"author": "Javier Fern\u00e1ndez Garc\u00eda-Boente \u003cjfernandez@igalia.com\u003e", "branch": "default", "desc": "Bug 2055440 [wpt PR 61330] - Tests for CSSStyleValue hierarchy in worker contexts, a=testonly\n\nAutomatic update from web-platform-tests\n[css-typed-om] Run worker-exposed value tests in workers\n\nConvert the stylevalue-subclasses tests whose interfaces are exposed to\nWorker to the .any.js template (global=window,worker), and add new\nworker-context tests for CSSUnitValue and CSSNumericValue:\n\nThese are DOM-free value tests, so they run unchanged in dedicated, shared\nand service workers. They avoid CSSNumericValue.parse() and\nCSSStyleValue.parse() (which are Exposed=Window) and operations that produce\ntypes not exposed to workers (e.g. CSSMathSum).\n\n--\n\nwpt-commits: e94af787e39d4161f01f0ef78d933f1103ee32b4\nwpt-pr: 61330\n", "files": ["testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/cssKeywordValue-value.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/cssKeywordValue-value.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/cssKeywordValue.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/cssKeywordValue.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/cssUnparsedValue-empty.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/cssUnparsedValue-empty.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/add-two-types.tentative.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/add-two-types.tentative.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/create-a-type.tentative.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/create-a-type.tentative.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/cssMathInvert-type.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/cssMathInvert-type.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/cssMathNegate-type.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/cssMathNegate-type.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/cssnumericvalue-multiply-two-types.tentative.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/cssnumericvalue-multiply-two-types.tentative.html", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/to.tentative.any.js", "testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/numeric-objects/to.tentative.html"], "git_node": "8cfd575a3b8df111f5c09999655f72ffe341b81c", "git_parents": ["e70fb4ce05e5d3660c62448fc93265e1ede8c5b3"], "node": "8d9877a6cea732fe82837ca7538445b72a13c522", "parents": ["20029b126d8c24e71609fd223f90bbb6848d3461"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055440 [wpt PR 61330] - Update wpt metadata, a=testonly\n\nwpt-pr: 61330\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.any.js.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/arithmetic.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/to.tentative.any.js.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/numeric-objects/to.tentative.html.ini"], "git_node": "19ccaf5e7eb9b743b4416bbfa637ee6304e27df9", "git_parents": ["8cfd575a3b8df111f5c09999655f72ffe341b81c"], "node": "b03e7facddeb2de4db6bc4de4666e0e1ce2595f5", "parents": ["8d9877a6cea732fe82837ca7538445b72a13c522"], "tags": []}, {"author": "Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e", "branch": "default", "desc": "Bug 2058480 [wpt PR 61568] - script: Implement async FileSystemFileEntry.file() success callback, a=testonly\n\nAutomatic update from web-platform-tests\nAdd `webkitGetAsEntry` auto test\n\nSigned-off-by: Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e\n\n--\n\nwpt-commits: b0f488f34bb8fa2574ab7944f7435c8e16cab2bf\nwpt-pr: 61568\n", "files": ["testing/web-platform/tests/entries-api/webkitGetAsEntry.html"], "git_node": "2daf5e600c5685174c9915d1eea0e24e49b00403", "git_parents": ["19ccaf5e7eb9b743b4416bbfa637ee6304e27df9"], "node": "9d9aa913a7dbe0ba4fd3381f73ce7aa6e59c98e5", "parents": ["b03e7facddeb2de4db6bc4de4666e0e1ce2595f5"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2054660 [wpt PR 61266] - [scroll-animations] Relative lengths are not allowed for the inset property on ViewTimelineOptions., a=testonly\n\nAutomatic update from web-platform-tests\n[scroll-animations] Relative lengths are not allowed for the inset property on ViewTimelineOptions. (#61266)\n\nPer the discussion in https://github.com/w3c/csswg-drafts/issues/13853 and https://github.com/w3c/csswg-drafts/issues/13852, we should make ViewTimelineOptions.inset be consistent with rangeStart/rangeEnd:\n\n\"Restrict allowed values from the CSSNumericValue or DOMString input to absolute units as was done with DOMMatrix and IntersectionObservers.\"\n\nSo remove the testcase of relative lengths and expect them throw.\n--\n\nwpt-commits: d645ced2cfda70af35f1af585d0a1120a576a65a\nwpt-pr: 61266\n", "files": ["testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-inset.html"], "git_node": "a3158432ee2caa21a3f4418b888274780ffcd99c", "git_parents": ["2daf5e600c5685174c9915d1eea0e24e49b00403"], "node": "af6a44e20ba56cdcbcde32b9a21bf0050422ecd5", "parents": ["9d9aa913a7dbe0ba4fd3381f73ce7aa6e59c98e5"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2059466 [wpt PR 61635] - Migrate css-syntax atrule-with-escape-character crashtest to WPT, a=testonly\n\nAutomatic update from web-platform-tests\nAlign serialization of color-mix() percentages with the spec\n\nAlso, palette-mix() follows the same serialization rules.\n\nBug: 537461415\nChange-Id: Ib1467b32111c1717f2a0f1eea3dfcb82081966bf\n\n--\nMigrate css-syntax atrule-with-escape-character crashtest to WPT\n\nBug: 40361423, 485677942\nChange-Id: I88a9414ef2ef7dcfa986033da21997189f2e43a0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8169945\nReviewed-by: Christian Biesinger \u003ccbiesinger@chromium.org\u003e\nCommit-Queue: Sharon Yang \u003cyangsharon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1671106}\n\n--\n\nwpt-commits: 61670f6c25a8e65af3574e2a8eeda18836367302, 4c0028a65ead3996f4d6eb450aaa324b806d5bcd\nwpt-pr: 61635\n", "files": ["testing/web-platform/tests/css/css-fonts/palette-mix-computed.html", "testing/web-platform/tests/css/css-syntax/crashtests/atrule-with-escape-character.html", "testing/web-platform/tests/css/css-values/random-computed.tentative.html", "testing/web-platform/tests/css/css-values/sign-in-keyframes-with-relative-units.html", "testing/web-platform/tests/css/css-values/tree-counting/sibling-index-keyframe-palette-mix-dynamic.html"], "git_node": "111ab2e9410fe62552b44622d6252ae8a9048ae9", "git_parents": ["a3158432ee2caa21a3f4418b888274780ffcd99c"], "node": "a5bd5c91b29926cadf3e4d30f355148ab619c409", "parents": ["af6a44e20ba56cdcbcde32b9a21bf0050422ecd5"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2059328 [wpt PR 61620] - Tolerate pixel differences in highlight-priority-painting.html, a=testonly\n\nAutomatic update from web-platform-tests\nTolerate pixel differences in highlight-priority-painting.html (#61620)\n\nOn Chrome Linux, highlight-priority-painting.html differs from its\nreference by 16 glyph pixels in the final \"-Blue\" text. The test shapes\n\"Yellow-Blue\" as one text run while the reference splits it across\nadjacent spans, producing platform-dependent text rasterization\ndifferences unrelated to highlight priority.\n\nAdd fuzzy metadata tightly bounded to the observed pixel count and\nchannel difference. This keeps the text visible while preserving strict\ncoverage of the highlight background priority.\n\nChange-Id: Ibe16ce778c4116426fb62f5f2270665f43facf74\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8168140\nCommit-Queue: Dan Clark \u003cdaniec@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Dan Clark \u003cdaniec@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1670770}\n\nCo-authored-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\n--\n\nwpt-commits: 15cfef9f95a00c95693ec375d91f05cfac696553\nwpt-pr: 61620\n", "files": ["testing/web-platform/tests/css/css-highlight-api/highlight-priority-painting.html"], "git_node": "ed83c8ecaf56310117291d2b7604dad6ad75fbed", "git_parents": ["111ab2e9410fe62552b44622d6252ae8a9048ae9"], "node": "5e49d85fa6b63f723151512e04c088cc6327fa72", "parents": ["a5bd5c91b29926cadf3e4d30f355148ab619c409"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059328 [wpt PR 61620] - Update wpt metadata, a=testonly\n\nwpt-pr: 61620\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-highlight-api/highlight-priority-painting.html.ini"], "git_node": "793066c4bb01f9b01c0daba67dabdce243cf573d", "git_parents": ["ed83c8ecaf56310117291d2b7604dad6ad75fbed"], "node": "18729f76d4d6dd4bbd90ae04c322b8829660dae6", "parents": ["5e49d85fa6b63f723151512e04c088cc6327fa72"], "tags": []}, {"author": "Leo Lee \u003cleolee@microsoft.com\u003e", "branch": "default", "desc": "Bug 2059381 [wpt PR 61629] - Mark fragment-parsed SVG \u003cscript\u003e elements as already started, a=testonly\n\nAutomatic update from web-platform-tests\nMark fragment-parsed SVG \u003cscript\u003e elements as already started\n\nThe HTML fragment parsing algorithm marks parser-created script elements\n\"already started\" so they never execute. Blink applied this only to HTML\nscripts in InsertScriptElement(); foreign-content scripts (e.g. SVG\n\u003cscript\u003e) are created in CreateElement() and were left unmarked. As a\nresult an SVG \u003cscript\u003e injected via innerHTML stayed inert but executed\nwhen the option subtree was later cloned into the document (e.g. by\n\u003cselectedcontent\u003e), which was an XSS vector.\n\nMark fragment-parsed SVG script elements already started, using the same\npolicy as the HTML script path, and add a regression WPT.\n\nBug: 538197148\nChange-Id: Ia532a46aebd68a1ecca5a55ced4d55e438259bcc\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8137934\nReviewed-by: Dan Clark \u003cdaniec@microsoft.com\u003e\nCommit-Queue: Leo Lee \u003cleolee@microsoft.com\u003e\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1671162}\n\n--\n\nwpt-commits: 7d140e82000a5f599fda5d4d0721dd49ac4c952a\nwpt-pr: 61629\n", "files": ["testing/web-platform/tests/html/semantics/scripting-1/the-script-element/svg-script-fragment-parsed-not-executed-on-clone.html"], "git_node": "dfbd8dae5064444dab8077040065a02e50ab5bba", "git_parents": ["793066c4bb01f9b01c0daba67dabdce243cf573d"], "node": "80120f71b238fbd225efdd16f2294caba2abf261", "parents": ["18729f76d4d6dd4bbd90ae04c322b8829660dae6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059381 [wpt PR 61629] - Update wpt metadata, a=testonly\n\nwpt-pr: 61629\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/scripting-1/the-script-element/css-module/repeated-import.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/json-module/repeated-imports.any.js.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/concurrent-failed-imports.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/concurrent-failed-imports.any.js.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/repeated-imports.any.js.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/shared-dependency-repeated-import.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/modulepreload-referrerpolicy.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/shared-dependency-repeated-import.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/text-module/repeated-imports.any.js.ini"], "git_node": "cb8657a29f9960c405fcff63bdf6092239e5f058", "git_parents": ["dfbd8dae5064444dab8077040065a02e50ab5bba"], "node": "ffc7b4236a1b84fc9534fba434ccbd61c566dae5", "parents": ["80120f71b238fbd225efdd16f2294caba2abf261"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2059296 [wpt PR 61618] - [Grid] Fix nested subgrid items displaced by baseline alignment, a=testonly\n\nAutomatic update from web-platform-tests\nAdd text-decoration-inset style support in Blink\n\nAdd parsing, computed style, and AppliedTextDecoration plumbing for\ntext-decoration-inset behind the CSSTextDecorationInset runtime flag.\nThis stores the parsed inset data on style without changing paint output.\n\nBug: 468928416, 498974811\nChange-Id: I4f4e57544b8485a5c75dc6e119d3d59745b5e715\n\n--\n[Grid] Fix nested subgrid items displaced by baseline alignment\n\nWhen two or more subgrids are nested under baseline alignment, the inner\ngrid items were displaced by roughly -33554432px (LayoutUnit::Min()),\nrendering them far off-screen.\n\nRoot cause: a grid baseline aligned item using its subgrid children's\nbaselines, but a subgrid's baseline is only known after it's laid out.\n`CompleteFinalBaselineAlignment` finalized the sizing tree and walked it\nonce, so an ancestor could ask a nested subgrid for a baseline it hadn't\nresolved yet, get back LayoutUnit::Min() (\"no baseline\"), and consume\nthat value as a real placement offset.\n\nFix: Add a bottom-up pass before `CompleteFinalBaselineAlignment`. This\npass resolves the deferred standalone subgrids \u2014 whose baseline depends\non their own not-yet-laid-out children \u2014 in post-order, so the innermost\nsubgrids are resolved first and every grid has its subgrid children\nfinalized before it is measured. Then, in\n`CompleteFinalBaselineAlignment`, we have all the information we need,\nso every item's baseline can be correctly resolved in a single top-down\npass over the whole tree.\n\nAfter: https://imgur.com/a/5dALsno\nBug: 527843240\nChange-Id: I67ed9fd075e8a0954d843938f9a5c131409fc49a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8037583\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1671260}\n\n--\n\nwpt-commits: f69b2bcafa4ab375dfac498c47a5ae9dd108ca4a, 6e90070a5bb0391124e6cc799185b66002511883\nwpt-pr: 61618\n", "files": ["testing/web-platform/tests/css/css-grid/subgrid/subgrid-baseline-013.html", "testing/web-platform/tests/css/css-grid/subgrid/subgrid-baseline-014.html", "testing/web-platform/tests/css/css-grid/subgrid/subgrid-baseline-015.html", "testing/web-platform/tests/css/css-grid/subgrid/subgrid-baseline-016.html", "testing/web-platform/tests/css/css-grid/subgrid/subgrid-baseline-017.html", "testing/web-platform/tests/css/css-grid/subgrid/subgrid-baseline-018.html", "testing/web-platform/tests/css/css-text-decor/parsing/text-decoration-inset-invalid.html"], "git_node": "86905c3bc87f573f283ce46e6a1daf96f2966099", "git_parents": ["cb8657a29f9960c405fcff63bdf6092239e5f058"], "node": "fb1f3bf6af0e9be84f58aeb2e4a91f5b24f07ff1", "parents": ["ffc7b4236a1b84fc9534fba434ccbd61c566dae5"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059296 [wpt PR 61618] - Update wpt metadata, a=testonly\n\nwpt-pr: 61618\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/subgrid/subgrid-baseline-016.html.ini", "testing/web-platform/meta/css/css-grid/subgrid/subgrid-baseline-017.html.ini", "testing/web-platform/meta/css/css-grid/subgrid/subgrid-baseline-018.html.ini"], "git_node": "d166744e9cf0307cdf5f42985dfb10c1d714a5ab", "git_parents": ["86905c3bc87f573f283ce46e6a1daf96f2966099"], "node": "e0d479cce9d90c35889d22aa769d4ebfae4c4ba1", "parents": ["fb1f3bf6af0e9be84f58aeb2e4a91f5b24f07ff1"], "tags": []}, {"author": "Kevin Lu \u003cklu@dexlabs.xyz\u003e", "branch": "default", "desc": "Bug 2058996 [wpt PR 61603] - dom: Follow the specification more closely when determining form submitter element action, a=testonly\n\nAutomatic update from web-platform-tests\nCreate form submission action tests\n\nSigned-off-by: Kevin Lu \u003cklu@dexlabs.xyz\u003e\n\n--\nGenerate form submission tests for both inputs and buttons\n\nSigned-off-by: Kevin Lu \u003cklu@dexlabs.xyz\u003e\n\n--\nRemoved indents in form generator script\n\nSigned-off-by: Kevin Lu \u003cklu@dexlabs.xyz\u003e\n\n--\n\nwpt-commits: 5e488251a1ef3f78642c188abb12b040e9c2a4e6, fd6f06cc6585bd1aaef8e5c74d0fa396bf254ffc, bcab123fff7b5fb617b33370dd1818a64c4d5c2a\nwpt-pr: 61603\n", "files": ["testing/web-platform/tests/html/semantics/forms/form-submission-0/form-submit-action.html", "testing/web-platform/tests/html/semantics/forms/form-submission-0/resources/form-with-submitter.js"], "git_node": "ddd77d96bce47bf48ab785a2a05c320adf5f1aca", "git_parents": ["d166744e9cf0307cdf5f42985dfb10c1d714a5ab"], "node": "c912281a42f2971028ec54f2106a4c573c5316a2", "parents": ["e0d479cce9d90c35889d22aa769d4ebfae4c4ba1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058996 [wpt PR 61603] - Update wpt metadata, a=testonly\n\nwpt-pr: 61603\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/form-submission-0/form-submit-action.html.ini"], "git_node": "b5e4a4a3c804a2cfc2e07b43bd41b70828af2409", "git_parents": ["ddd77d96bce47bf48ab785a2a05c320adf5f1aca"], "node": "1c438c7145e79ca088cce72b0ecb387d8972408f", "parents": ["c912281a42f2971028ec54f2106a4c573c5316a2"], "tags": []}, {"author": "Daniel Cheng \u003cdcheng@chromium.org\u003e", "branch": "default", "desc": "Bug 2059288 [wpt PR 61617] - [HiC] An origin-tainted filter should taint its subtree, a=testonly\n\nAutomatic update from web-platform-tests\nSanitize URLs in Connection-Allowlist violation reports\n\nBug: 540082621\nChange-Id: I880471de03518e0f631892fc86d92ee09d4f9150\n\n--\nSpeculation measurement - renderer source of truth\n\nAfter having moved the speculation rules heuristics to the renderer,\nthis CL moves the speculation rules measurement to be based on these\nrenderer-side heuristics.\n\nChange-Id: Ifef5dd8548285f03aa87ddbb9da3840e64b406ad\nBug: 532860179\n\n--\n[HiC] An origin-tainted filter should taint its subtree\n\nBug: 532952073\nChange-Id: I86a21f9c6fc1928dab4b96f078121818d3409fa0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8131725\nCommit-Queue: Stefan Zager \u003cszager@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1671390}\n\n--\n\nwpt-commits: 8d3ade530ca7869170c1f4f87b624a49638b1ac2, eac3535a75c5f1b10825b9052a08223c1a567a1d, 980d75cf32721846a895852629a0ad191babdeb4\nwpt-pr: 61617\n", "files": ["testing/web-platform/tests/connection-allowlist/tentative/service-worker-reporting-url-sanitization.https.sub.window.js", "testing/web-platform/tests/connection-allowlist/tentative/service-worker-reporting-url-sanitization.https.sub.window.js.sub.hea