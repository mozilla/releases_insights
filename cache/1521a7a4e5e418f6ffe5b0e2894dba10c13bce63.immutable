r.css"], "git_node": "e234aabd1d6d7486f6b901bc1dc7f1cd3f11e9c2", "git_parents": ["1a610abe469f33f53812638f425940d0a81a9254"], "node": "7cf8e5d81cc244522fa36e0720d4af696968e9fc", "parents": ["c77023699795646dc005c207fbf793208cb0f114"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use uv in test tasks. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312753\n", "files": ["taskcluster/kinds/test/kind.yml"], "git_node": "06dfe241aed6822641cd0d92a27abc22af75d473", "git_parents": ["e234aabd1d6d7486f6b901bc1dc7f1cd3f11e9c2"], "node": "422e7254fc04c3970006a7d4f49a5125e9ea1bfc", "parents": ["7cf8e5d81cc244522fa36e0720d4af696968e9fc"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059594 - Update metadata for /connection-allowlist/tentative/speculation_rules_prefetch.https.sub.window.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315570\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/speculation_rules_prefetch.https.sub.window.js.ini"], "git_node": "4721c7d8198b0b2104af7b1ddd977a6fff7bbecb", "git_parents": ["06dfe241aed6822641cd0d92a27abc22af75d473"], "node": "c7a057f7860eb51add254b5a129ab03dfc46fea4", "parents": ["422e7254fc04c3970006a7d4f49a5125e9ea1bfc"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055837 - use uv in test tasks. r=taskgraph-reviewers,bhearsum\" for causing mochitest failures\n\nThis reverts commit 06dfe241aed6822641cd0d92a27abc22af75d473.\n", "files": ["taskcluster/kinds/test/kind.yml"], "git_node": "e333b82b6ca8f61fe06f8c3dd0be3ae5e9ea63b8", "git_parents": ["4721c7d8198b0b2104af7b1ddd977a6fff7bbecb"], "node": "dc435f3a7875fffaa00e97f43625921094cb8611", "parents": ["c7a057f7860eb51add254b5a129ab03dfc46fea4"], "tags": []}, {"author": "AndiAJ \u003c