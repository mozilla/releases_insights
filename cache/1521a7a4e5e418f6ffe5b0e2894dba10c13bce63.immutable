gle place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314258\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/quad.rs"], "git_node": "30383bc36001d15c527e06e8b5af5039469c0301", "git_parents": ["af802f69fb6abfef1cc46ef25070f0086d4bcce4"], "node": "bb0a0c7e86e6823a14e56043876034d2288f04dc", "parents": ["920be24d2c686bbb74bbf921d38431014b35215a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057720 - Fix some typos. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314259\n", "files": ["gfx/wr/webrender/src/bump_allocator.rs", "gfx/wr/webrender/src/gpu_types.rs", "gfx/wr/webrender/src/invalidation/mod.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_task_graph.rs"], "git_node": "f145a07a6b7ef53467009742a5b13840ffbecfae", "git_parents": ["30383bc36001d15c527e06e8b5af5039469c0301"], "node": "53cfe84129b155711defe2ec1a34069d8bbd5c47", "parents": ["bb0a0c7e86e6823a14e56043876034d2288f04dc"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057720 - Refresh the documentation in lib.rs. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314260\n", "files": ["gfx/wr/webrender/src/lib.rs"], "git_node": "216fceab4b43080bb87116143898adff96ec3417", "git_parents": ["f145a07a6b7ef53467009742a5b13840ffbecfae"], "node": "370149a1ba4ec11ecb5e940c35837b65c23e04cd", "parents": ["53cfe84129b155711defe2ec1a34069d8bbd5c47"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057720 - Fix stale references in comments. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314261\n", "files": ["gfx/wr/webrender/res/composite.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/ps_quad_blend.glsl", "gfx/wr/webrender/src/internal_types.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/util.rs"], "git_node": "e87b2f6fd31af1674753f59be9d2794a2fd334ea", "git_parents": ["216fceab4b43080bb87116143898adff96ec3417"], "node": "f1eff9594e4e0786f061eaa87e1a075eddf050db", "parents": ["370149a1ba4ec11ecb5e940c35837b65c23e04cd"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057720 - Fix mis-indentations. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314262\n", "files": ["gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/render_task.rs", "gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender/src/tile_cache/mod.rs"], "git_node": "92cc9bfd66b477eb312e44656005b39e005656d0", "git_parents": ["e87b2f6fd31af1674753f59be9d2794a2fd334ea"], "node": "05f863f6dc823e805ba2940c44d4cc63ea9fcc77", "parents": ["f1eff9594e4e0786f061eaa87e1a075eddf050db"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057720 - Remove reexports from picture.rs. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314263\n", "files": ["gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/invalidation/cached_surface.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/picture_graph.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/surface.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "a87dfc8b5d01e029153db77b591b6b8a9853d0b1", "git_parents": ["92cc9bfd66b477eb312e44656005b39e005656d0"], "node": "934980f4e802fa052e8bc27940aeeb1e88ef53d0", "parents": ["05f863f6dc823e805ba2940c44d4cc63ea9fcc77"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057720 - Extract debug overlay code from renderer/mod.rs. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314264\n", "files": ["gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "b55c4c2c70f688652a4a4bc2b8b1cc65a721d262", "git_parents": ["a87dfc8b5d01e029153db77b591b6b8a9853d0b1"], "node": "9639d2c839a4a0803605a6bb41131793be1f6e96", "parents": ["934980f4e802fa052e8bc27940aeeb1e88ef53d0"], "tags": []}, {"author": "Vladimir Levin \u003cvmpstr@chromium.org\u003e", "branch": "default", "desc": "Bug 2057203 [wpt PR 61499] - Scoped VT: Add contain: size and contain-intrinsic-size: auto, a=testonly\n\nAutomatic update from web-platform-tests\nScoped VT: Add contain: size and contain-intrinsic-size: auto\n\nBased on the resolution (see referenced bug), this adds a flag-guarded\ncontain: size and contain-intrinsic-size: auto. The latter is introduced\nvia a EffectiveContainIntrinsicSize computed style function.\n\nR=kevers@chromium.org\n\nBug: 535198786\nChange-Id: I4e252fe966e0fa89350175600307fe9b749ddc00\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8110037\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1667123}\n\n--\n\nwpt-commits: b761abc7d70502d3997524d39f83383e52bde986\nwpt-pr: 61499\n", "files": ["testing/web-platform/tests/css/css-view-transitions/scoped/scope-containment-during-capture.html", "testing/web-platform/tests/css/css-view-transitions/scoped/scope-containment-pseudo-border-ref.html", "testing/web-platform/tests/css/css-view-transitions/scoped/scope-containment-pseudo-border.html", "testing/web-platform/tests/css/css-view-transitions/scoped/scope-containment-sibling-offset.html"], "git_node": "6aaacbbe93f75821d0394f5cb21d2b9f34b40886", "git_parents": ["b55c4c2c70f688652a4a4bc2b8b1cc65a721d262"], "node": "6e0b4fd87f561bb630b8b5033db7a961af66e12b", "parents": ["9639d2c839a4a0803605a6bb41131793be1f6e96"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057203 [wpt PR 61499] - Update wpt metadata, a=testonly\n\nwpt-pr: 61499\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-view-transitions/scoped/scope-containment-during-capture.html.ini", "testing/web-platform/meta/css/css-view-transitions/scoped/scope-containment-pseudo-border.html.ini", "testing/web-platform/meta/css/css-view-transitions/scoped/scope-containment-sibling-offset.html.ini"], "git_node": "241b48c4538791b9859fb633ad03998e53722aff", "git_parents": ["6aaacbbe93f75821d0394f5cb21d2b9f34b40886"], "node": "ab99283313b7f146416b6c7c4c78fa2a2e2b9f93", "parents": ["6e0b4fd87f561bb630b8b5033db7a961af66e12b"], "tags": []}, {"author": "Hongchan Choi \u003chongchan@google.com\u003e", "branch": "default", "desc": "Bug 2057080 [wpt PR 61488] - [WebAudio] Remove legacy AudioContext.playoutStats API, a=testonly\n\nAutomatic update from web-platform-tests\n[WebAudio] Remove legacy AudioContext.playoutStats API\n\nThis CL completely removes the legacy, non-standard\nAudioContext.playoutStats API and the associated AudioPlayoutStats\ninterface from the codebase, as scheduled for removal in M147.\n\nThe newer, spec-compliant AudioContext.playbackStats (status: stable)\nis now the sole statistics API.\n\nKey Changes:\n- Removed AudioContextPlayoutStats runtime flag.\n- Marked kAudioContextPlayoutStats UseCounter as obsolete (retaining\n  its entry for telemetry stability).\n- Deleted audio_playout_stats.idl/h/cc.\n- Cleaned up playoutStats references from AudioContext.\n- Pruned associated unit tests and WPTs.\n\nNO_IFTTT=Unrelated preexisting IFTTT errors in enums.xml\n\nBug: 475838360\nChange-Id: Id531d926ac070b52b9368637091527abe95d2c56\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7886659\nReviewed-by: Nate Chapin \u003cjaphet@chromium.org\u003e\nCommit-Queue: Hongchan Choi \u003chongchan@chromium.org\u003e\nReviewed-by: Guido Urdaneta \u003cguidou@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1667152}\n\n--\n\nwpt-commits: bee5358b3fe5ed3e60f0f4465afc8aa1508eefaf\nwpt-pr: 61488\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-audiocontext-interface/audiocontext-playoutstats.html"], "git_node": "04f2849e2b5c5e058669a8af06d3240b5a363867", "git_parents": ["241b48c4538791b9859fb633ad03998e53722aff"], "node": "8916448ae62d84fdc3b5b23042f13301ec0fdc2f", "parents": ["ab99283313b7f146416b6c7c4c78fa2a2e2b9f93"], "tags": []}, {"author": "Justin Lulejian \u003cjlulejian@chromium.org\u003e", "branch": "default", "desc": "Bug 2057192 [wpt PR 61498] - [Extensions] Update WPT test assertions to match W3C proposal, a=testonly\n\nAutomatic update from web-platform-tests\n[Extensions] Update WPT test assertions to match W3C proposal\n\nCurrently, a browser.bookmarks test case relies on the non-standard\nbrowser.test.fail() method to assert that a Promise is expected to be\nrejected when invalid or deleted objects are queried.\n\nAfter this commit lands, these test will instead return a promise that\nrejects if the test does not behave as expected.\n\nTAG=agy\nCONV=13c67052-fc49-4c0d-808e-ae6eaf3802cd\n\nBug: 527385398\nChange-Id: Iab4b538207f9ef830b0297f4cb7e8c3d43dd31e4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8063507\nCommit-Queue: Justin Lulejian \u003cjlulejian@chromium.org\u003e\nReviewed-by: Oliver Dunk \u003coliverdunk@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1667210}\n\n--\n\nwpt-commits: 6c2b9b6029522eb5b3f2938d130bc35386c171b5\nwpt-pr: 61498\n", "files": ["testing/web-platform/tests/web-extensions/resources/bookmarks/background.js"], "git_node": "11bb46815a1117b7cc7c23431e6a945d2732b248", "git_parents": ["04f2849e2b5c5e058669a8af06d3240b5a363867"], "node": "3507e5bd84192ee9451afb0841e02363f0d44f8a", "parents": ["8916448ae62d84fdc3b5b23042f13301ec0fdc2f"], "tags": []}, {"author": "lilly \u003c173393835+cupidsity@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2055758 [wpt PR 61356] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319432, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export: corner-shape: update corner-shape TestExpectations (#61356)\n\nhttps://bugs.webkit.org/show_bug.cgi?id=319432\n--\n\nwpt-commits: 435dbd5f4f8695143f0e67c01bf496f6ed7e306d\nwpt-pr: 61356\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-scoop.html", "testing/web-platform/tests/css/css-borders/corner-shape/corner-shape-superellipse-scoop.html"], "git_node": "0a962962153eca9ad54f9774c525a051e34ed2ce", "git_parents": ["11bb46815a1117b7cc7c23431e6a945d2732b248"], "node": "f95c330d9f19c151673417b46c517586a1b8909b", "parents": ["3507e5bd84192ee9451afb0841e02363f0d44f8a"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2057159 [wpt PR 61493] - [compression-dictionary] Add WPT test for a dictionary loaded via a link and compressed with another dictionary with a match-dest., a=testonly\n\nAutomatic update from web-platform-tests\n[compression-dictionary] Add WPT test for a dictionary loaded via a link and compressed with another dictionary with a match-dest.\n\nA typical use case for compression dictionary transport is to register\na dictionary with `match=webapp.v*.js` so that `webapp.v2.js` is\ncompressed using `webapp.v1.js` as a dictionary, and `webapp.v3.js`\nis compressed using that compressed dictionary `webapp.v2.js`.\nExisting test `dictionary-compressed.tentative.https.html` already\ncovers that use case, but this CL introduces a slightly more involved\nversion:\n\n1) The first dictionary is registered with a specific `match-dest`.\n2) The second (compressed) dictionary is registered via a link\n   element with `rel=compression-dictionary`.\n3) Data compressed with the second dictionary is fetched (same as in the\n   original test).\n\nWhen `match-dest=(\"compression-dictionary\")`, because (2) triggers\na fetch with destination \"compression-dictionary\" the dictionary should\nstill be properly registered and so usable to decompress (3).\n\nFor `match-dest` values that don't match \"compression-dicitonary\", the\nsecond dictionary won't be registered in step (2) and so (3) would just\nreturned the compressed data. The cases checked are an invalid\ndestination or a valid non-matching destination.\n\nBug: 522338661, 40255884\nChange-Id: I7b8a9197de6e9c392dc174c35a733e7245e2a6b0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8129944\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nReviewed-by: Patrick Meenan \u003cpmeenan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1666893}\n\n--\n\nwpt-commits: f5a7deaba2bffac7a534dfafaa3baf14b9a253cf\nwpt-pr: 61493\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/dictionary-compressed-fetch-with-link-match-dest.tentative.https.html"], "git_node": "d27fafd8f7c5fa9823b6bf8782de670d89062748", "git_parents": ["0a962962153eca9ad54f9774c525a051e34ed2ce"], "node": "fff3424366c85f6307f1a2a815dbc59daa748554", "parents": ["f95c330d9f19c151673417b46c517586a1b8909b"], "tags": []}, {"author": "David Baron \u003cdbaron@chromium.org\u003e", "branch": "default", "desc": "Bug 2057342 [wpt PR 61506] - Synthesize click events for activated menuitems that don't otherwise get clicks., a=testonly\n\nAutomatic update from web-platform-tests\nSynthesize click events for activated menuitems that don't otherwise get clicks.\n\nThis synthesizes clicks in a somewhat similar way to the way \u003clabel\u003e\nelements synthesize clicks.  The reason to do this is discussed in\nhttps://github.com/openui/open-ui/issues/1312 ; we want the click event\nto fire every time a menuitem is activated rather than firing for most\nbut not all gestures.  Doing otherwise would lead event handlers in the\npage to be unreliable.\n\nThis means we do end up with two click events sent to different targets\n(though one of them has its default handling stopped partway through).\n\n(Substantial parts of the code were written by AI, but I almost\ncompletely rewrote the AI-authored test.)\n\nBug: 406566432\nChange-Id: I2de7f91d17b1d40dcc77837b074328f08f5addba\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8133028\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1667410}\n\n--\n\nwpt-commits: 3f4809d5bd8152c9c9bb290e449146990c602ea9\nwpt-pr: 61506\n", "files": ["testing/web-platform/tests/html/semantics/menu/tentative/menuitem-activate.html", "testing/web-platform/tests/html/semantics/menu/tentative/menuitem-drag-click-event.html"], "git_node": "4bd46561733799e8343219db79534d13de2d34ff", "git_parents": ["d27fafd8f7c5fa9823b6bf8782de670d89062748"], "node": "d2d5f2c247af67bb03430eb37c379e74b2961beb", "parents": ["fff3424366c85f6307f1a2a815dbc59daa748554"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057342 [wpt PR 61506] - Update wpt metadata, a=testonly\n\nwpt-pr: 61506\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/menu/tentative/menuitem-drag-click-event.html.ini"], "git_node": "b6ca085f77be37fc390d1cf51089766233fe888f", "git_parents": ["4bd46561733799e8343219db79534d13de2d34ff"], "node": "f6d3da451037775d41f11e184d1d5843748d135a", "parents": ["d2d5f2c247af67bb03430eb37c379e74b2961beb"], "tags": []}, {"author": "Simon Fraser \u003csmfr@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2056747 [wpt PR 61466] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319648, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit pixel tolerance adjustments\n\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=319648 (#61466)\n--\n\nwpt-commits: f9f8c7047ff32259f9b22f03e0db66d7fb98477e\nwpt-pr: 61466\n", "files": ["testing/web-platform/tests/css/css-masking/clip-path/animations/clip-path-transition-allow-discrete-shape.html", "testing/web-platform/tests/css/css-masking/clip-path/clip-path-borderBox-1c.html", "testing/web-platform/tests/css/css-masking/clip-path/clip-path-paddingBox-1c.html", "testing/web-platform/tests/css/css-masking/clip-path/clip-path-strokeBox-1a.html", "testing/web-platform/tests/css/css-masking/clip-path/clip-path-viewBox-1c.html", "testing/web-platform/tests/css/css-masking/mask-image/mask-image-inline-sliced-1.html", "testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/gradients/shape-outside-linear-gradient-001.html", "testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/gradients/shape-outside-linear-gradient-002.html", "testing/web-platform/tests/css/css-shapes/shape-outside/shape-image/gradients/shape-outside-linear-gradient-003.html", "testing/web-platform/tests/svg/shapes/reftests/pathlength-003.svg"], "git_node": "a81ddc63bc220894a2ae9f35703937ead4f77557", "git_parents": ["b6ca085f77be37fc390d1cf51089766233fe888f"], "node": "241ac8383dbd6e71d33da96b960d149c01eeb3af", "parents": ["f6d3da451037775d41f11e184d1d5843748d135a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056747 [wpt PR 61466] - Update wpt metadata, a=testonly\n\nwpt-pr: 61466\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-masking/clip-path/animations/clip-path-transition-allow-discrete-shape.html.ini"], "git_node": "d3b55c9ac26f077d4fd7b6fabb573710c05f75a8", "git_parents": ["a81ddc63bc220894a2ae9f35703937ead4f77557"], "node": "25ef4a1e0da86420b32e56ad5e643deb3a95fef9", "parents": ["241ac8383dbd6e71d33da96b960d149c01eeb3af"], "tags": []}, {"author": "Karl Dubost \u003ckarlcow@apple.com\u003e", "branch": "default", "desc": "Bug 2057400 [wpt PR 61510] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320095, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320095 (#61510)\n--\n\nwpt-commits: 50941534896f8c38aeefbe219a569d9d59c879b2\nwpt-pr: 61510\n", "files": ["testing/web-platform/tests/svg/coordinate-systems/viewBox-invalid-attribute-baseval.tentative.html", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-001-expected.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-001.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-002-expected.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-002.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-003-expected.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-003.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-contexts-ref.html", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-contexts.html", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-marker-expected.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-marker-ref.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-disables-rendering-marker.svg", "testing/web-platform/tests/svg/coordinate-systems/viewBox-zero-di