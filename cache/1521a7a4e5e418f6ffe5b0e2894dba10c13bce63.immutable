PI/sign_verify/ecdsa.https.any.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/ecdsa.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/eddsa.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/eddsa_curve25519.https.any.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/eddsa_curve448.tentative.https.any.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/hmac.https.any.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/hmac.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/kmac.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/kmac.tentative.https.any.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/mac.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/mldsa.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/mldsa.tentative.https.any.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/mldsa_vectors.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/rsa.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/rsa_pkcs.https.any.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/rsa_pkcs_vectors.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/rsa_pss.https.any.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/rsa_pss_vectors.js", "testing/web-platform/tests/WebCryptoAPI/sign_verify/signature.js", "testing/web-platform/tests/WebCryptoAPI/supports-modern.tentative.https.any.js", "testing/web-platform/tests/WebCryptoAPI/supports.tentative.https.any.js", "testing/web-platform/tests/WebCryptoAPI/tools/generate.py", "testing/web-platform/tests/WebCryptoAPI/util/ec_key_fixtures.js", "testing/web-platform/tests/WebCryptoAPI/util/helpers.js", "testing/web-platform/tests/WebCryptoAPI/util/mldsa_key_fixtures.js", "testing/web-platform/tests/WebCryptoAPI/util/okp_key_fixtures.js", "testing/web-platform/tests/WebCryptoAPI/util/rsa_key_fixtures.js", "testing/web-platform/tests/WebCryptoAPI/util/supports.js", "testing/web-platform/tests/WebCryptoAPI/wrapKey_unwrapKey/wrapKey_unwrapKey.https.any.js", "testing/web-platform/tests/WebCryptoAPI/wrapKey_unwrapKey/wrapKey_unwrapKey_vectors.js"], "git_node": "86c627ca6cdeb084ff5b28cc9e0ef535072fa4cf", "git_parents": ["5ebb5122e1240ee6ba183878ff8428065fd43d16"], "node": "c4feec41caf79fa07bf1e2cb0c2e76e8c916199a", "parents": ["d8dbfa106673cf1fab774f60ac4abe6b79e63903"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056082 [wpt PR 61397] - Update wpt metadata, a=testonly\n\nwpt-pr: 61397\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/WebCryptoAPI/derive_bits_keys/cfrg_curves_bits_curve448.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/derive_bits_keys/cfrg_curves_keys_curve448.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/sign_verify/mldsa.tentative.https.any.js.ini"], "git_node": "4f9a836fae2597ce4e6cc01881c2f3fcab801787", "git_parents": ["86c627ca6cdeb084ff5b28cc9e0ef535072fa4cf"], "node": "6aadf4e5c1293da3c6cbcac9ff38729092bb0e61", "parents": ["c4feec41caf79fa07bf1e2cb0c2e76e8c916199a"], "tags": []}, {"author": "Claire Chambers \u003cclchambers@microsoft.com\u003e", "branch": "default", "desc": "Bug 2059005 [wpt PR 61604] - Fix another issue where zoom would not apply for cc clip-paths, a=testonly\n\nAutomatic update from web-platform-tests\nFix another issue where zoom would not apply for cc clip-paths\n\nThis bug occurs because the StyleResolverState does not initialize the\nLength Conversion Data with zoom by default. In the case of dependent\nunits (such as %, vh, etc) this would occur. However, pixels would not\ntrigger a recalc in this case. Since *all* units are dependent on zoom\n(effectively), this recalc is now made mandatory.\n\nAdditionally, since the StyleResolverState is does not change across\nkeyframes, the constructor is hoisted to the Paint/Bounding Rect\ncallers, so that the resolution and creation of a cloned style only\noccurs once rather than per keyframe.\n\nBug: 535696703\nChange-Id: I2b58faa21310a98de55a7f25ddd6994b202243b3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8160313\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCommit-Queue: Claire Chambers \u003cclchambers@microsoft.com\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1672640}\n\n--\n\nwpt-commits: e2e519e002f87b80fcdc8a62a34350bc0a597ad2\nwpt-pr: 61604\n", "files": ["testing/web-platform/tests/css/css-masking/clip-path/animations/clip-path-transition.html"], "git_node": "726d5c387ba97df8ea11f06bf34bc50fcad854b6", "git_parents": ["4f9a836fae2597ce4e6cc01881c2f3fcab801787"], "node": "b8302bb6975283ff5e45b37ce6aba85ee5edbdcc", "parents": ["6aadf4e5c1293da3c6cbcac9ff38729092bb0e61"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059005 [wpt PR 61604] - Update wpt metadata, a=testonly\n\nwpt-pr: 61604\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-masking/clip-path/animations/clip-path-animation-forward-fill-positive-delay.html.ini"], "git_node": "8585726b1acf3c07150073c83ae4f7527c33e1aa", "git_parents": ["726d5c387ba97df8ea11f06bf34bc50fcad854b6"], "node": "b5003ea4ca37086e001e320a877a976598094490", "parents": ["b8302bb6975283ff5e45b37ce6aba85ee5edbdcc"], "tags": []}, {"author": "Mike West \u003cmkwst@chromium.org\u003e", "branch": "default", "desc": "Bug 2058908 [wpt PR 61601] - [Connection Allowlist] Add reporting support for navigation., a=testonly\n\nAutomatic update from web-platform-tests\n[Connection Allowlist] Add reporting support for navigation.\n\nThis CL adds reporting capabilities to the shared utility functions used\nto check for Connection Allowlist compliance outside the network stack,\nand ensures that they're wired up correctly to send reports for\nnavigations and navigational redirects.\n\nBug: 482728970\nChange-Id: I3e5fb2b635ab1fa82a04826f5420774606e3a6c2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7899824\nReviewed-by: Shivani Sharma \u003cshivanisha@chromium.org\u003e\nCommit-Queue: Mike West \u003cmkwst@chromium.org\u003e\nReviewed-by: Arthur Sonzogni \u003carthursonzogni@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1672660}\n\n--\n\nwpt-commits: efc4a961dd8d1cb0caa208a79f35aa4d8c346092\nwpt-pr: 61601\n", "files": ["testing/web-platform/tests/connection-allowlist/tentative/reporting-navigation-blocked.https.sub.html", "testing/web-platform/tests/connection-allowlist/tentative/reporting-navigation-blocked.https.sub.html.sub.headers", "testing/web-platform/tests/connection-allowlist/tentative/reporting-navigation-redirect-blocked.https.sub.html", "testing/web-platform/tests/connection-allowlist/tentative/reporting-navigation-redirect-blocked.https.sub.html.sub.headers", "testing/web-platform/tests/connection-allowlist/tentative/reporting-navigation-redirect-report-only.https.sub.html", "testing/web-platform/tests/connection-allowlist/tentative/reporting-navigation-redirect-report-only.https.sub.html.sub.headers", "testing/web-platform/tests/connection-allowlist/tentative/reporting-navigation-report-only.https.sub.html", "testing/web-platform/tests/connection-allowlist/tentative/reporting-navigation-report-only.https.sub.html.sub.headers", "testing/web-platform/tests/connection-allowlist/tentative/reporting-speculation-rules-prefetch-blocked.https.sub.html", "testing/web-platform/tests/connection-allowlist/tentative/reporting-speculation-rules-prefetch-blocked.https.sub.html.sub.headers"], "git_node": "d74452b99450b3b8dfadfe6f5d5a67fef0d7577a", "git_parents": ["8585726b1acf3c07150073c83ae4f7527c33e1aa"], "node": "be3328243a873e1ac772a70dd09acef56eb5ff31", "parents": ["b5003ea4ca37086e001e320a877a976598094490"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058908 [wpt PR 61601] - Update wpt metadata, a=testonly\n\nwpt-pr: 61601\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/reporting-navigation-blocked.https.sub.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/reporting-navigation-redirect-blocked.https.sub.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/reporting-navigation-redirect-report-only.https.sub.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/reporting-navigation-report-only.https.sub.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/reporting-speculation-rules-prefetch-blocked.https.sub.html.ini"], "git_node": "d2dd5e6aaa84f766b43046ff83e3b847631785cc", "git_parents": ["d74452b99450b3b8dfadfe6f5d5a67fef0d7577a"], "node": "65064837831b4a59322ba8ae50f053184cd5ef53", "parents": ["be3328243a873e1ac772a70dd09acef56eb5ff31"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060353 - [wpt-sync] Update web-platform-tests to efc4a961dd8d1cb0caa208a79f35aa4d8c346092, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: efc4a961dd8d1cb0caa208a79f35aa4d8c346092\nwpt-type: landing\n", "files": ["testing/web-platform/meta/WebCryptoAPI/derive_bits_keys/cfrg_curves_bits_curve448.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/derive_bits_keys/cfrg_curves_keys_curve448.tentative.https.any.js.ini", "testing/web-platform/meta/WebCryptoAPI/sign_verify/mldsa.tentative.https.any.js.ini", "testing/web-platform/meta/fetch/metadata/generated/fetch.sub.html.ini", "testing/web-platform/meta/html/dom/render-blocking/remove-attr-style-keeps-blocking.html.ini", "testing/web-platform/meta/html/user-activation/navigate-to-sameorigin.html.ini", "testing/web-platform/meta/mediacapture-record/passthrough/MediaRecorder-passthrough.https.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini", "testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/webdriver/tests/bidi/input/perform_actions/pointer_mouse_multiclick.py.ini"], "git_node": "757d33a44aaa530dfa4f5b67e0d0e574f04e86ce", "git_parents": ["d2dd5e6aaa84f766b43046ff83e3b847631785cc"], "node": "49aad38aa104ad3e22e4326c8fecf2c87e3ae223", "parents": ["65064837831b4a59322ba8ae50f053184cd5ef53"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058622, validate selected options entries, r=jjaschke\" for causing unexpected-pass wpt at select-selectedOptions-nesting.window.html\n\nThis reverts commit 38b2a5edc74052d013e5fc1f1474a36cc5a72d6a.\n", "files": ["dom/html/HTMLSelectElement.cpp"], "git_node": "2160ada58d19edcec4aef6a5f680089eb0fb1a12", "git_parents": ["757d33a44aaa530dfa4f5b67e0d0e574f04e86ce"], "node": "dded86da9184e46139abba6deb5c23b1737edad3", "parents": ["49aad38aa104ad3e22e4326c8fecf2c87e3ae223"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060361 - Use exact scale factors for perspective surfaces that map coplanar content affinely r=gfx-reviewers,lsalzman\" for causing reftest failures at preserve3d-6a.html\n\nThis reverts commit 174534f884b455ab756906061f46c07c62f234cf.\n", "files": ["gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender/src/util.rs", "gfx/wr/wrench/reftests/snap/preserve-3d.png", "gfx/wr/wrench/reftests/split/same-plane.png", "gfx/wr/wrench/reftests/text/reftest.list"], "git_node": "128aaa5b95b28bfede02f79f962dd7e73bfb5e09", "git_parents": ["2160ada58d19edcec4aef6a5f680089eb0fb1a12"], "node": "a8e78137d529c2cf68d8ff3f98b11d6c2412bfbd", "parents": ["dded86da9184e46139abba6deb5c23b1737edad3"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044501 - Add moz-WPT for new media-capabilities supports-cache pref. r=media-playback-reviewers,alwu\" for causing wpt failures @decodingInfo-api-modes.any.html?mode=supportscache\n\nThis reverts commit 598f0bd89a7a698b10520c21b85b205cb0be5b77.\n\nRevert \"Bug 2044501 - Add cached async codec-support path for MediaCapabilities decode behind a pref. r=media-playback-reviewers,alwu\"\n\nThis reverts commit e44f785f3e1d5ef1d03531251bb50009162f239f.\n\nRevert \"Bug 2044501 - Add RemoteMediaManagerChild::EnsureCodecSupportFor for async HW codec support queries. r=media-playback-reviewers,alwu\"\n\nThis reverts commit 56cd88aeb93831e8c85c7051aaf2304e46445f7e.\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/ipc/RemoteDecoderModule.h", "dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/ipc/RemoteMediaManagerChild.h", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/mediacapabilities/MediaCapabilities.h", "dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/PDMFactory.h", "dom/media/platforms/PDMFactorySupport.cpp", "dom/media/platforms/PDMFactorySupport.h", "dom/media/platforms/PlatformDecoderModule.h", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/meta/media-capabilities/encodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/tests/media-capabilities/decodingInfo-api-modes.any.js", "testing/web-platform/mozilla/tests/media-capabilities/encodingInfo-api-modes.any.js"], "git_node": "b7f8d225801a3e935cc07d45134b4094c91a9ca9", "git_parents": ["128aaa5b95b28bfede02f79f962dd7e73bfb5e09"], "node": "27793afcb28dd5655e8880daf38b102d00b15a30", "parents": ["a8e78137d529c2cf68d8ff3f98b11d6c2412bfbd"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2058685 - Resolve the mozcheck binary in mozlint's parent process r=linter-reviewers,sylvestre\n\nNone of the mozcheck-backed linters declare a `setup` key, so\nmozcheck:setup, which calls _find_mozcheck_binary() and possibly\nbootstraps mozcheck doesn't run before mozlint runs the linters.\n\nmozlint runs linters in a ProcessPoolExecutor, and all those processes\nmay end up calling _find_mozcheck_binary() themselves at the same time.\nIn that case, they may all run `mach taskgraph tasks`, in turn running\n`hg` and later possibly `cargo`. In some cases, that could lead to\nrandom failures.\n\nBy declaring mozcheck:setup as a setup for all the linters, the binary\nis now resolved (and possibly bootstrapped) only once, before linter\nprocesses are spawn.\n\n`setup` and `lint` also have to agree on the root they pass down, or\n_get_mozcheck_target_dir() can hand them two different target directories and\nthe workers end up rebuilding anyway; both now go through _resolve_root().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316224\n", "files": ["tools/lint/dot-mozilla-reference.yml", "tools/lint/file-perm.yml", "tools/lint/file-whitespace.yml", "tools/lint/license.yml", "tools/lint/mozcheck/__init__.py", "tools/lint/rejected-words.yml", "tools/lint/trojan-source.yml"], "git_node": "b0e2f7838f59d0bcadac14ee7eec586a7916de0e", "git_parents": ["b7f8d225801a3e935cc07d45134b4094c91a9ca9"], "node": "d0035ec058a5a819856175a167f07496791a0316", "parents": ["27793afcb28dd5655e8880daf38b102d00b15a30"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054344 - Don't reserve space for clear button when placeholder is shown in the search bar. r=emilio,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316099\n", "files": ["browser/themes/shared/urlbar-searchbar.css"], "git_node": "b99b8c6219faf73f2cc856dcecf273697472d5f8", "git_parents": ["b0e2f7838f59d0bcadac14ee7eec586a7916de0e"], "node": "7bf87c1202ccfaedf76c9dc2e500ee0e8a18fee8", "parents": ["d0035ec058a5a819856175a167f07496791a0316"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Move the pointer off the addon row after clicking it. r=mbeier\n\nA test fix. The loop clicks the addon row, which parks the pointer at that row's\ncentre. Row geometry shifts with each suggestion, so a later iteration's freshly\nbuilt row can land under the parked pointer and be genuinely hovered -- the bottom\nseparator and url are then correctly visible and the isHidden assertions fail.\nremovePseudoClassLock() does not help, since it drops the artificial lock rather\nthan real pointer hover.\n\nWorth knowing for similar triage: only the message path surfaces this, because its\nextra asynchrony leaves the real hover in effect when the assertions run, and only\nunder the proton manifest, whose row geometry differs from nova. Reading computed\nstyle before an assertion forces a flush that recomputes hover, so any probe placed\nthere makes the failure disappear.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315359\n", "files": ["browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_addons.js"], "git_node": "fbd0c82268fa59a97aa80db3fd6457357c6dbe22", "git_parents": ["b99b8c6219faf73f2cc856dcecf273697472d5f8"], "node": "cf3c522b58f8324bbce66deb5b36179aa2b0d4a1", "parents": ["7bf87c1202ccfaedf76c9dc2e500ee0e8a18fee8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Await the dismissal and acknowledgment effects in browser_weather.js. r=mbeier\n\nA test fix, using the helpers the dismissal wire-safety work added; this file never\nadopted them.\n\nThe dismissal awaited quicksuggest-dismissals-changed, which the parent observes,\nand then asserted the row had become a dismissalAcknowledgment tip. Over the wire\nthe engagement runs parent-side, calls removeResult and notifies back, so the row is\nreplaced a hop after that topic fires; it now also awaits onQueryResultRemoved. The\ntwo feedback-acknowledgment assertions read an attribute applied content-side, so\nthey wait on a mutation, matching browser_acknowledgeFeedbackAndDismissal.\n\nWorth knowing: this accounts for all ten failures the file showed over the wire.\ndontShow failed its tip assertions and never reached its cleanup, so suggest.weather\nstayed dismissed and four later tasks reported \"Not enough results\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315360\n", "files": ["browser/components/urlbar/tests/quicksuggest/browser/browser_weather.js"], "git_node": "249843645f9610d55cfe605c6ff59fe19c47b705", "git_parents": ["fbd0c82268fa59a97aa80db3fd6457357c6dbe22"], "node": "5671023f4afa6184853a8c967076ca719d03180a", "parents": ["cf3c522b58f8324bbce66deb5b36179aa2b0d4a1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Await the restarted query after opting in, in browser_quicksuggest_realtime_optin.js. r=mbeier\n\nA test fix. Picking the opt-in's allow button restarts the query with the same\nkeyword, and that engagement runs parent-side, so over the wire the new query begins\nafter the pick returns. promiseSearchComplete() follows lastQueryContextPromise only\nwhile it changes, so it saw the query that had already completed and the assertions\nread pre-opt-in results: source \"rust\" for \"merino\", provider \"Dynamic\" for\n\"polygon\". The test now waits for onQueryFinished, armed before the pick.\n\nWorth knowing: this covers all eight failures the file showed over the wire.\noptIn_mouse failed before restoring quicksuggest.online.enabled, so optIn_keyboard\nthen found the market result where it expected the opt-in tip.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315361\n", "files": ["browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_realtime_optin.js"], "git_node": "bce64f7692b5d00ac33a62589431f17c894f5bb6", "git_parents": ["249843645f9610d55cfe605c6ff59fe19c47b705"], "node": "e8406ef57fc02a73f2cba57e700b4e96c49baea5", "parents": ["5671023f4afa6184853a8c967076ca719d03180a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059696 - Lay out the Ctrl-Tab previews in a grid so they shrink instead of wrapping. r=emilio,desktop-theme-reviewers\n\nThe previews' flex-basis is content-based, and a flex container breaks lines\nfrom each item's hypothetical main size before any shrinking happens, so\nmin-width: 0 doesn't keep them on one line. Once their combined intrinsic width\nexceeds the panel's content box the last preview wraps. That happens on\nnarrower screens, where the fixed ~170px of padding, borders and panel chrome\neats the slack that scales with screen.availWidth, and whenever the popup can't\nget the width _openPanel asks for (under Wayland it is confined to the browser\nwindow). The panel is sized from its intrinsic height, measured at an\nunconstrained inline size where everything fits on one line, so the extra row\nis clipped rather than making the panel taller.\n\nA grid of previewColumnCount equal columns takes the row count out of the\nlayout's hands: the previews shrink at any panel width, and the intrinsic\nheight already accounts for the rows that will be rendered.\n\nOne deliberate rendering change to check: a partial last row (maxPreviews above\n7, e.g. 10 previews in rows of 7) now keeps the same preview width as the full\nrows instead of stretching to fill the panel.\n\nThe previewsContainer getter is behavior-neutral.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315568\n", "files": ["browser/components/tabbrowser/content/browser-ctrlTab.js", "browser/components/tabbrowser/test/browser/tabs/browser_ctrlTab.js", "browser/themes/shared/tabbrowser/ctrlTab.css"], "git_node": "8acd49d8e75d021872be9c064e8f161f380992b0", "git_parents": ["bce64f7692b5d00ac33a62589431f17c894f5bb6"], "node": "3d9dfaa621b08eaaa472f0a44c971395a29a257f", "parents": ["e8406ef57fc02a73f2cba57e700b4e96c49baea5"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058198 - Improve the container tab strokes r=kcochrane,desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314682\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "25e5840e6015315485e2ededc45871aaba03db14", "git_parents": ["8acd49d8e75d021872be9c064e8f161f380992b0"], "node": "2eb8b20faa39775fd7846527b2a98bf55d0f9d24", "parents": ["3d9dfaa621b08eaaa472f0a44c971395a29a257f"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2041996 - Move tooltip-label word-wrap/min-width to xul.css so the default (native-anonymous) tooltip wraps long text, r=desktop-theme-reviewers,dao\n\nThe `.tooltip-label` word-wrap rule lived in global-shared.css, which is a\ndocument-level (author) sheet. The default tooltip created by nsCanvasFrame is\ndocument-level native-anonymous content and does not pick up document-level\nstyles, so it didn't apply there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315592\n", "files": ["toolkit/content/xul.css", "toolkit/themes/shared/global-shared.css"], "git_node": "efe74072c41c03e40886ad66c042965775f52177", "git_parents": ["25e5840e6015315485e2ededc45871aaba03db14"], "node": "8151121626753580d1e04d673aa4aa53e69ac29a", "parents": ["2eb8b20faa39775fd7846527b2a98bf55d0f9d24"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2053566 - Remove unused toolkit.telemetry.dap_* preferences r=simonf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313136\n", "files": ["modules/libpref/init/all.js"], "git_node": "2a151d9ae396509cdbe79866922afc022472dc3d", "git_parents": ["efe74072c41c03e40886ad66c042965775f52177"], "node": "92e3fae6cf7a23f10aef07811ffad9155b1bb193", "parents": ["8151121626753580d1e04d673aa4aa53e69ac29a"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2058622, validate selected options entries, r=jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314926\n", "files": ["dom/html/HTMLSelectElement.cpp", "testing/web-platform/meta/html/semantics/forms/the-select-element/select-selectedOptions-nesting.window.js.ini"], "git_node": "8a55ffe0f9f71ce48b9960e83464efefc2605b3d", "git_parents": ["2a151d9ae396509cdbe79866922afc022472dc3d"], "node": "cbbab5db72bc49f08921077b1a847b0e2a3834e1", "parents": ["92e3fae6cf7a23f10aef07811ffad9155b1bb193"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059666 - [devtools] Improve contrast for .jsonParseError. r=devtools-reviewers,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316192\n", "files": ["devtools/client/jsonview/css/json-panel.css"], "git_node": "3dfb63dc144dc212a998d0f813a611ee0b315417", "git_parents": ["8a55ffe0f9f71ce48b9960e83464efefc2605b3d"], "node": "6e09dc741d39bcdb0043903d85082890a4438481", "parents": ["cbbab5db72bc49f08921077b1a847b0e2a3834e1"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060060 - Record HTTP/3 connection close reason for closes that skip Closing r=valentin,necko-reviewers\n\nThe networking.http_3_connection_close_reason counter was only recorded in\nthe Closing branch of the neqo_glue state-change handler. Closes that go\nstraight to Closed without a closing handshake, such as an idle timeout,\nnever reached that branch, so their reasons went uncounted and the\nIdleTimeout bucket stayed empty.\n\nRecord the reason from both the Closing and Closed state changes, guarded by\na per-connection flag so a connection that surfaces both is counted once. A\nclose that goes through a handshake is still counted at Closing exactly as\nbefore; a close that skips it is now counted at Closed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315875\n", "files": ["netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "3def04e4f7f66773233bf4af68eda79d7749bbd1", "git_parents": ["3dfb63dc144dc212a998d0f813a611ee0b315417"], "node": "b1799460049bb139957b7236082ff20c51cbd5a8", "parents": ["6e09dc741d39bcdb0043903d85082890a4438481"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2059942 - Disable persistence earlier for popups. r=smaug\n\nRight now we disable it too late, by the point we've already applied the\npersistent attributes, which causes the styling we use for the initial\nload to be wrong (which causes some test failures with the changes from\nbug 2054183).\n\nUse the chrome flags to determine whether we need persistence instead.\n\nI'd use a separate flag or so, but I think we're out of bits, I'd need\nto harvest some or expand it or something. Can look into it next week.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315802\n", "files": ["docshell/base/nsDocShellTreeOwner.cpp", "docshell/base/nsIDocShellTreeOwner.idl", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsChromeTreeOwner.cpp", "xpfe/appshell/nsContentTreeOwner.cpp"], "git_node": "c7d60f29170c060ca443811363c740901a73fcab", "git_parents": ["3def04e4f7f66773233bf4af68eda79d7749bbd1"], "node": "a4cd0c2ca15ff989d2142df6c34b844aec2bb7f1", "parents": ["b1799460049bb139957b7236082ff20c51cbd5a8"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060226 - [WebCrypto] Return the same error PublicKeyToJwk returns instead of overriding it with OperationError r=nss-reviewers,keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316007\n", "files": ["dom/crypto/WebCryptoTask.cpp"], "git_node": "ee4c8bbf12af62d77b8121a36cf97bf5443a49a0", "git_parents": ["c7d60f29170c060ca443811363c740901a73fcab"], "node": "39b283340c58bb766a4d13a9b2f9edc11446d8f6", "parents": ["a4cd0c2ca15ff989d2142df6c34b844aec2bb7f1"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060469 - [DevTools Release Tasks - Cycle 155] Update MDN compat data r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316226\n", "files": ["devtools/shared/compatibility/dataset/css-properties.json"], "git_node": "06daa464cf53474d8888360e6c2993db6b1161b9", "git_parents": ["ee4c8bbf12af62d77b8121a36cf97bf5443a49a0"], "node": "f4e0c78756f2183b2e669d64775d7b6a5274150e", "parents": ["39b283340c58bb766a4d13a9b2f9edc11446d8f6"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2059942 - Remove getPersistence as well. r=smaug\n\nWe can just check the persist attribute is the expected value.\n\nDo some auxiliary clean-up while at it (most of the strings were\nunused).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315894\n", "files": ["docshell/base/nsDocShellTreeOwner.cpp", "docshell/base/nsIDocShellTreeOwner.idl", "toolkit/components/windowwatcher/test/browser_new_sized_window.js", "xpfe/appshell/nsChromeTreeOwner.cpp", "xpfe/appshell/nsChromeTreeOwner.h", "xpfe/appshell/nsContentTreeOwner.cpp"], "git_node": "c3106d4a0e323a642069da542fb4b4b087fdd2c9", "git_parents": ["06daa464cf53474d8888360e6c2993db6b1161b9"], "node": "4286f23b2c5379e7cab65c2f7176e0f74f888fb4", "parents": ["f4e0c78756f2183b2e669d64775d7b6a5274150e"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888528 - Convert mozcrash to f-string formatting to fix lint warnings. r=mozbase-reviewers,ahal\n\nmozcrash.py still used %-style string formatting in a number of log and\nprint statements, which tripped lint warnings. Convert them to f-strings\nfor consistency with the rest of the file, with no behavior change.\n\nThis is a preparatory cleanup for the following mozcrash changes in this\nstack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311487\n", "files": ["testing/mozbase/mozcrash/mozcrash/mozcrash.py"], "git_node": "4a88374b479cc9ee99ca97bb9ed28f16cf5d7dd1", "git_parents": ["c3106d4a0e323a642069da542fb4b4b087fdd2c9"], "node": "6d2596f162f6c071d4f80552981b7df9441c1818", "parents": ["4286f23b2c5379e7cab65c2f7176e0f74f888fb4"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888528 - Let mozcrash honor a fixed crash signature override annotation. r=afranchuk,mozbase-reviewers,ahal\n\nWhen a crash carries the new CrashSignatureOverrideForTesting annotation,\nmozcrash now reports it under that fixed signature instead of the one\nderived from the crashing stack. This lets intentional crashes, such as a\nchild the parent deliberately crashes while it hangs at shutdown, group\nunder a single signature across platforms rather than being filed as many\nper-platform bugs.\n\nThe annotation is documented in CrashAnnotations.yaml and only affects test\nautomation; production crash reporting ignores it. A new mozcrash unit test\ncovers the override.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311488\n", "files": ["testing/mozbase/mozcrash/mozcrash/mozcrash.py", "testing/mozbase/mozcrash/tests/conftest.py", "testing/mozbase/mozcrash/tests/manifest.toml", "testing/mozbase/mozcrash/tests/test_crash_signature_override.py", "toolkit/crashreporter/CrashAnnotations.yaml"], "git_node": "235b7104f051703055c9112500650d57bea622ce", "git_parents": ["4a88374b479cc9ee99ca97bb9ed28f16cf5d7dd1"], "node": "c1dc6567b9c735cc25928c7c1d1dc1f413cab51c", "parents": ["6d2596f162f6c071d4f80552981b7df9441c1818"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888528 - Let mozcrash treat annotated intentional crashes as non-failures. r=afranchuk,mozbase-reviewers,ahal\n\nAdd an IntentionalCrashForTesting annotation that test automation sets on a\nprocess it deliberately crashes and expects to crash. When mozcrash sees it,\nit logs the crash as intentional and does not count it as a test failure.\nThe annotation must only ever be set under test-specific configuration;\nproduction crashes must never carry it, otherwise real failures would be\nsilently ignored.\n\nThe annotation is documented in CrashAnnotations.yaml, and new mozcrash unit\ntests cover both the intentional-crash-is-not-a-failure case and the case\nwhere a crash without the annotation still fails even when it carries a\nsignature override.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311489\n", "files": ["testing/mozbase/mozcrash/mozcrash/mozcrash.py", "testing/mozbase/mozcrash/tests/manifest.toml", "testing/mozbase/mozcrash/tests/test_intentional_crash.py", "toolkit/crashreporter/CrashAnnotations.yaml"], "git_node": "503e8b849b86c69cc2127e6a42a33609ecb4d4d9", "git_parents": ["235b7104f051703055c9112500650d57bea622ce"], "node": "03da3a305a0386ac2b777b60e0a42171257a7bd8", "parents": ["c1dc6567b9c735cc25928c7c1d1dc1f413cab51c"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888528 - Crash children hanging at shutdown under a uniform signature. r=ipc-reviewers,nika\n\nOn debug builds the parent process deliberately crashes children that hang\nat shutdown (since bug 1793525), producing a distinct crash signature from\neach child's stack and thus many separate intermittent bugs. Record a fixed\nCrashSignatureOverrideForTesting annotation on the parent around the code\nthat crashes these children, on both POSIX and Windows: the crash helper\npropagates a parent annotation into a child's report when the child left it\nunset, so all such crashes now group under the single \"child process hang at\nshutdown\" signature.\n\nThe annotation is scoped so a later crash of the parent itself (e.g. via\nnsTerminator) is not misattributed. The shared signature string lives in\nprocess_watcher.h.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311490\n", "files": ["ipc/chromium/src/chrome/common/process_watcher.h", "ipc/chromium/src/chrome/common/process_watcher_posix_sigchld.cc", "ipc/chromium/src/chrome/common/process_watcher_win.cc"], "git_node": "3602e0421533464306d5037aad7d72c8c9c65ad0", "git_parents": ["503e8b849b86c69cc2127e6a42a33609ecb4d4d9"], "node": "3ee0fee04232c50926893483e39af5c3563fa353", "parents": ["03da3a305a0386ac2b777b60e0a42171257a7bd8"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888528 - Add test coverage for uniform child shutdown-hang crash reports. r=whimboo,ipc-reviewers,nika\n\nStop skipping the shutdown-hang crash path under MOZ_TEST_CHILD_EXIT_HANG,\nsince the hang delay used by browser_child_hang.js is low enough to avoid\nthe crash path anyway.\n\nAdd a Marionette test for NS_FREE_PERMANENT_DATA builds, that forces a\nchild process hang at shutdown by using MOZ_TEST_CHILD_EXIT_HANG, then\nverifies that this results in a crash report that carries the expected\nuniform crash signature override annotation.\n\nMark MOZ_TEST_CHILD_EXIT_HANG crashes as intentional by using the new\nIntentionalCrashForTesting annotation, to avoid flagging the test runs\nthat produce these crash reports as failures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311491\n", "files": ["ipc/chromium/src/chrome/common/process_watcher_posix_sigchld.cc", "ipc/chromium/src/chrome/common/process_watcher_win.cc", "ipc/glue/ProcessChild.cpp", "ipc/glue/moz.build", "ipc/glue/test/marionette/manifest.toml", "ipc/glue/test/marionette/test_child_shutdown_hang_crash.py", "testing/marionette/harness/marionette_harness/tests/integration-tests.toml"], "git_node": "94a7941255f9a486c8b5807f66fe4b8b2023d456", "git_parents": ["3602e0421533464306d5037aad7d72c8c9c65ad0"], "node": "1819b355031b17ec3c3cc9531ce264926bce0cc3", "parents": ["3ee0fee04232c50926893483e39af5c3563fa353"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060271 - Use REGEXP_SPACES from UrlbarShared instead of UrlUtils in UrlbarTelemetryUtils. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316045\n", "files": ["browser/components/urlbar/content/UrlbarTelemetryUtils.mjs"], "git_node": "440af657f04017c189c727e595299d9353f1e3f6", "git_parents": ["94a7941255f9a486c8b5807f66fe4b8b2023d456"], "node": "234c71b8ceafc890a9f9e42537aa4dfdf3aee60a", "parents": ["1819b355031b17ec3c3cc9531ce264926bce0cc3"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1969451 - Set mDidDeleteNonCollapsedRange to true when non-collapsed range is deleted in HandleDeleteTextAroundCollapsedRanges. r=masayuki\n\nThis ensures that we create the \u003cbr\u003e element to make the invisible line visible.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315637\n", "files": ["editor/libeditor/HTMLEditorDeleteHandler.cpp", "testing/web-platform/meta/editing/run/delete.html.ini", "testing/web-platform/tests/editing/plaintext-only/backspace-end-of-plaintext-only-pre-ref.html", "testing/web-platform/tests/editing/plaintext-only/backspace-end-of-plaintext-only-pre.html"], "git_node": "f48fb10feb11f343af68875c6a7b7e1d2d9ffc46", "git_parents": ["440af657f04017c189c727e595299d9353f1e3f6"], "node": "f76dd2a256305c4e7d129c7f9c5f12a0ec0cda6a", "parents": ["234c71b8ceafc890a9f9e42537aa4dfdf3aee60a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060410 - Update KSP to version 2.3.11. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316142\n", "files": ["gradle/libs.versions.toml"], "git_node": "2992f48763f51c2b16fee23ac878bd5f478a88a1", "git_parents": ["f48fb10feb11f343af68875c6a7b7e1d2d9ffc46"], "node": "6244c5784e674a1435c1a6d832a19b51bf802226", "parents": ["f76dd2a256305c4e7d129c7f9c5f12a0ec0cda6a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060411 - Update Sentry to version 8.51.0. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316143\n", "files": ["gradle/libs.versions.toml"], "git_node": "28e46d6883ab738795318059981f3279abf00096", "git_parents": ["2992f48763f51c2b16fee23ac878bd5f478a88a1"], "node": "9d8f8c4e52bba18d36f9856e62c65e7d2d7b17d5", "parents": ["6244c5784e674a1435c1a6d832a19b51bf802226"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058611 - Clear form for element when insertion is aborted. r=hsivonen\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315079\n", "files": ["parser/html/nsHtml5TreeOperation.cpp"], "git_node": "d2e68413e0199fe6025515cdbc4e907f3435762c", "git_parents": ["28e46d6883ab738795318059981f3279abf00096"], "node": "4e73bc6b4acca4c0036d8cbf89b621377e2888dc", "parents": ["9d8f8c4e52bba18d36f9856e62c65e7d2d7b17d5"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2048869 - FxaException.Forbidden shouldn't crash Fenix. r=sfamisa,android-reviewers\n\nI find this \"white listing\" of exceptions a little odd but it clearly needs `Forbidden`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316189\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/Exceptions.kt"], "git_node": "35f817d62c409fe07b008486b797d92bbbf29a04", "git_parents": ["d2e68413e0199fe6025515cdbc4e907f3435762c"], "node": "929ce64737fdb2394fcb6497a7c6c7a17eaf3ecc", "parents": ["4e73bc6b4acca4c0036d8cbf89b621377e2888dc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059518 - Refresh Android lint baselines. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315402\n", "files": ["mobile/android/android-components/components/ui/animation/lint-baseline.xml", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/geckoview/lint-baseline.xml"], "git_node": "324c137b7b02210cff3ab519dafc962b3e2369be", "git_parents": ["35f817d62c409fe07b008486b797d92bbbf29a04"], "node": "3cf9fb750135d31e09cba6a04024826639286377", "parents": ["929ce64737fdb2394fcb6497a7c6c7a17eaf3ecc"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059518 - Use kotlin.test.assertNotNull in Android unit tests. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315403\n", "files": ["mobile/android/android-components/components/ui/animation/build.gradle", "mobile/android/android-components/components/ui/animation/lint-baseline.xml", "mobile/android/android-components/components/ui/animation/src/test/java/mozilla/components/ui/animation/AnimatedIllustrationTest.kt", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bookmarks/BookmarksMiddlewareTest.kt"], "git_node": "df229167d9efac0f416e21aed8f6f10b5ee354be", "git_parents": ["324c137b7b02210cff3ab519dafc962b3e2369be"], "node": "3bb23510e85ff695e3135a5c0b81e37c8160ba77", "parents": ["3cf9fb750135d31e09cba6a04024826639286377"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059518 - Fix assorted Android lint findings. r=android-reviewers,mcarare\n\n- EmptySuperCall (Fenix): ProfilerViewModel no longer calls the empty ViewModel.onCleared()\n  superclass implementation.\n- CheckResult (Fenix): HomeScreenRobot called Espresso's ViewActions.swipeUp() from inside a Compose\n  performTouchInput block, which only builds a ViewAction and then discards it, so the fallback swipe\n  never actually ran. Importing the TouchInjectionScope extension of the same name makes the swipe\n  happen as intended.\n- UseOfNonLambdaOffsetOverload (Fenix): the research surface survey slide-in uses the lambda overload\n  of Modifier.offset, so the animated value is read while laying out rather than while composing.\n- LocalContextResourcesRead (samples): read resources through LocalResources rather than reaching for\n  them via LocalContext.\n- RtlSymmetry (Fenix, Focus): these layouts pad a single side deliberately, so say so with a local\n  suppression instead of carrying baseline entries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315404\n", "files": ["mobile/android/android-components/samples/acorn-components/lint-baseline.xml", "mobile/android/android-components/samples/acorn-components/src/main/java/org/mozilla/samples/acorn/components/ui/IconsScreen.kt", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HomeScreenRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/experiments/view/ResearchSurfaceSurvey.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/ProfilerViewModel.kt", "mobile/android/fenix/app/src/main/res/layout/checkbox_left_sub_preference.xml", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/src/main/res/layout/item_custom_domain.xml", "mobile/android/focus-android/app/src/main/res/layout/preference_manual_add_search_engine.xml"], "git_node": "c57275882888ef90182f9b54fd8082dd340661a1", "git_parents": ["df229167d9efac0f416e21aed8f6f10b5ee354be"], "node": "428ac67801f789a783ab4ac4d2547c2cb3e0fdaa", "parents": ["3bb23510e85ff695e3135a5c0b81e37c8160ba77"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059518 - Suppress UnusedResources for the Focus resources that only look unused. r=android-reviewers,android-l10n-reviewers,mcarare,parker\n\nThe check does not analyze dependencies and covers a single variant, so some of what it reports is\ngenuinely in use. The browser menu styles and the certificate error strings override android-components\ndefaults and are referenced only from there, and the per-variant text selection labels are referenced\nthrough manifestPlaceholders in build.gradle. Suppress the check in place on each of them, as Fenix already\ndoes for its own overrides, and drop the baseline entries. Bug 2056403 had to restore the menu styles after\nthey were deleted for looking unused, so this also keeps that from recurring.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315405\n", "files": ["mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/src/main/res/values/strings.xml", "mobile/android/focus-android/app/src/main/res/values/styles.xml"], "git_node": "9209572cacf7abc7e737acb3db20038bbe7da253", "git_parents": ["c57275882888ef90182f9b54fd8082dd340661a1"], "node": "e1c13e44623270b6247396d9c1626bd0345a6adf", "parents": ["428ac67801f789a783ab4ac4d2547c2cb3e0fdaa"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059518 - Remove unused Focus strings. r=android-reviewers,android-l10n-reviewers,parker,mcarare\n\nNone of these strings are referenced any more. Their localized copies are left alone, since the l10n\nimport drops those once the string is gone from the reference strings.xml, which means the localized files\nhold strings nothing references until it runs. Ignore UnusedResources for them and stop reporting\nExtraTranslation, as Fenix already does for the same reason. With nothing left baselined for the check,\nraise it to an error as well, matching Fenix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315406\n", "files": ["mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/focus-android/app/lint.xml", "mobile/android/focus-android/app/src/main/res/values/strings.xml"], "git_node": "bde0274931fa811b6df7f49e53e1bf887886470b", "git_parents": ["9209572cacf7abc7e737acb3db20038bbe7da253"], "node": "0387d3351250f57754bba8179bbf9ba53a59bb51", "parents": ["e1c13e44623270b6247396d9c1626bd0345a6adf"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059518 - Only check plural and fraction conventions in the default Fenix strings. r=android-reviewers,mcarare\n\nUnusedQuantity and TypographyFractions fire on the localized strings, where the plural forms a language\nneeds and whether to use a fraction character are the translators' call, and where the files come from the\nl10n import rather than being edited here. Restrict both checks to the default strings, alongside the\nrelated checks that are already handled that way, and drop the baseline entries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315407\n", "files": ["mobile/android/fenix/app/lint-baseline.xml", "mobile/android/fenix/app/lint.xml"], "git_node": "d0d8c04b85032c5bd92bbc60d0c73bfdfbeed6ce", "git_parents": ["bde0274931fa811b6df7f49e53e1bf887886470b"], "node": "c8065a0a230530586