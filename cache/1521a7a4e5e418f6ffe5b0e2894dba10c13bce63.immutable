": ["23cdf60a3b944e09fdf7fdb47c8b5f660adcf962"], "node": "73fb6acb3f9ff674c1be088c42f05a9ad69c3e35", "parents": ["5885c0e5909eaa8da859c55683843adc619ff682"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058739 - Update JNA to version 5.19.1. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314790\n", "files": ["gradle/libs.versions.toml"], "git_node": "38d822e2983e7c97dbcade9153487fd00d99b24a", "git_parents": ["673240ce6835a2dfd45d657c5fa8e09cf55a7abb"], "node": "d45ca0ab82ae1f72e8a1176a7dc3a9aaacd471db", "parents": ["73fb6acb3f9ff674c1be088c42f05a9ad69c3e35"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058739 - Update Protobuf to version 4.35.1. r=android-reviewers,adhingra\n\nAlso drop the comment about keeping the version in sync with application-services, which no longer holds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314791\n", "files": ["gradle/libs.versions.toml"], "git_node": "db0b219247ebdc2583125f6593d267fbf4dcaec2", "git_parents": ["38d822e2983e7c97dbcade9153487fd00d99b24a"], "node": "ebf726417452ae0a22bcff4c654b009f51c7a382", "parents": ["d45ca0ab82ae1f72e8a1176a7dc3a9aaacd471db"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058739 - Update Spotless to version 8.9.0. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314792\n", "files": ["gradle/libs.versions.toml"], "git_node": "3b0fefe145e6ec45964e464426c817ddfac44991", "git_parents": ["db0b219247ebdc2583125f6593d267fbf4dcaec2"], "node": "fb0a3b0a5ff6893a70c6de919873a00a69254f25", "parents": ["ebf726417452ae0a22bcff4c654b009f51c7a382"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058739 - Update DAGP to version 3.18.0. r=android-reviewers,adhingra\n\n3.18.0 isolates the plugin's kotlin-metadata-jvm usage to workers and downgrades the Kotlin version it uses,\nwhich is what previously kept us on 3.12.0. Note 3.17.0 made the binary-compatibility check opt-in, so it now\ndefaults to off.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314793\n", "files": ["gradle/libs.versions.toml"], "git_node": "e18cf5d0910ef3f2360edaefb9cbb1583e4ff35a", "git_parents": ["3b0fefe145e6ec45964e464426c817ddfac44991"], "node": "a75aa9a26a751641c8ca9d30096d5818b2e0f8a9", "parents": ["fb0a3b0a5ff6893a70c6de919873a00a69254f25"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058741 - Update intellij-markdown to version 0.7.8. r=android-reviewers,adhingra\n\n0.7.6 deprecated the String overloads of MarkdownParser in favour of CharSequence ones, and deprecated the\nconstructors that don't take a CancellationToken. Since android-components compiles with -Werror, adapt the\nrichtext parser: thread CharSequence through the parsing helpers and pass the cancellation token explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314794\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/components/ui/richtext/src/main/kotlin/mozilla/components/ui/richtext/parsing/ParseBlockContent.kt", "mobile/android/android-components/components/ui/richtext/src/main/kotlin/mozilla/components/ui/richtext/parsing/ParseInlineContent.kt", "mobile/android/android-components/components/ui/richtext/src/main/kotlin/mozilla/components/ui/richtext/parsing/Parser.kt"], "git_node": "61b7a1f629a783d533c1f7c2a2a545641b3647ac", "git_parents": ["e18cf5d0910ef3f2360edaefb9cbb1583e4ff35a"], "node": "9f7a2db01c2a80fd534925297a84ee1c93dc014c", "parents": ["a75aa9a26a751641c8ca9d30096d5818b2e0f8a9"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058273 - Make sure newly added shared prefs are added to the shared database. r=mossop\" for causing mochitests failures in browser_preferences.js.\n\nThis reverts commit 630ac8bda815a81797f6435ade02817d813b0133.\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/tests/unit/test_shared_prefs_lifecycles_methods.js"], "git_node": "def262bd5d4daafa5de866478cf81a0a39e306c1", "git_parents": ["61b7a1f629a783d533c1f7c2a2a545641b3647ac"], "node": "1209764b2b80c9159e83a8462b0742e49091db7f", "parents": ["9f7a2db01c2a80fd534925297a84ee1c93dc014c"], "tags": []}, {"author": "Olivia \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032175 - Let Firefox Labs on Android ride the trains r=gl,android-reviewers\n\nPatch enables Firefox Labs for Android.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310118\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FeatureFlags.kt"], "git_node": "af3fa61831eaf1430c18868cb1cb2082db612bc7", "git_parents": ["def262bd5d4daafa5de866478cf81a0a39e306c1"], "node": "94813fd7efeae62005a0bb6276016734c33899c3", "parents": ["1209764b2b80c9159e83a8462b0742e49091db7f"], "tags": []}, {"author": "Alex Cottner \u003cacottner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058906 - Removing secondary remote-settings server url test as we dropped v1 server from AppConstants r=leplatrem\n\nThis test is no longer valid as we're back down to having only 1 URL in `AppConstants.REMOTE_SETTINGS_SERVER_URLS`.\nIn D313612 I removed the v1 remote-settings server from , but missed removing this unit-test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314964\n", "files": ["services/settings/test/unit/test_remote_settings_release_prefs.js"], "git_node": "052322c28f3d23234b4f6bf38985e76b0cf479d5", "git_parents": ["af3fa61831eaf1430c18868cb1cb2082db612bc7"], "node": "c6c9891266fd5dfbc33143b6262428e3bb4659d