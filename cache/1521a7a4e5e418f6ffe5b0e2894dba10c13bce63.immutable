f68", "parents": ["91cdd1e7da632fc3ce9f9e4f4eae585a7427b9c6"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872781 - Remove the layout.css.font-variations.enabled pref. r=layout-reviewers,webidl,devtools-reviewers,firefox-style-system-reviewers,emilio,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313759\n", "files": ["devtools/server/actors/page-style.js", "dom/webidl/FontFace.webidl", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxPlatform.cpp", "layout/inspector/tests/chrome/test_fontVariationsAPI.xhtml", "layout/reftests/font-face/reftest.list", "layout/reftests/font-variations/reftest.list", "layout/style/FontFaceImpl.cpp", "layout/style/FontFaceSetImpl.cpp", "layout/style/test/property_database.js", "layout/style/test/test_system_font_serialization.html", "layout/style/test/test_transitions_per_property.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/font_face_descriptors.toml", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/shorthands.rs", "testing/manifest/test/data/fontface_reftest.list", "testing/web-platform/meta/css/css-fonts/__dir__.ini"], "git_node": "0efe680e064533345b71fa1b31ec4c8f59cb1ede", "git_parents": ["46136c0ae1732d442447a9fa799fe0b4d3707652"], "node": "3232e1fdb80c4fee399e9fe56940b0faaf169044", "parents": ["4e454fedb3d15bf8a5f39ddbddfa274d6be96f68"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1872779 - Remove the layout.css.font-tech.enabled pref. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313761\n", "files": ["layout/reftests/font-face/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/font_face.rs", "servo/components/style/stylesheets/supports_rule.rs", "testing/manifest/test/data/fontface_reftest.list"], "git_node": "321670e3c09b50263f6364c69c44296e2a223bca", "git_parents": ["0efe680e064533345b71fa1b31ec4c8f59cb1ede"], "node": "5077f980cff235b33052b5da0b7c4b511737f9f6", "parents": ["3232e1fdb80c4fee399e9fe56940b0faaf169044"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057236 - Remove the layout.css.font-variant-emoji.enabled pref. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313764\n", "files": ["layout/style/test/property_database.js", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/properties/longhands.toml"], "git_node": "7ed301e8c07fe2edb0d2952e9d8baa93772dd2d2", "git_parents": ["321670e3c09b50263f6364c69c44296e2a223bca"], "node": "25a1d4e427fab9b4e44b49b3e5a4332f0c5511b7", "parents": ["5077f980cff235b33052b5da0b7c4b511737f9f6"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057259 - Remove the gfx.font_rendering.colr_v1.enabled pref. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313766\n", "files": ["gfx/tests/fuzz/TestCOLRv1.cpp", "gfx/thebes/COLRFonts.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxPlatform.cpp", "layout/reftests/font-face/colrv1-02.html", "layout/reftests/font-face/colrv1-02a-ref.html", "layout/reftests/font-face/colrv1-02b-ref.html", "layout/reftests/font-face/reftest.list", "modules/libpref/init/StaticPrefList.yaml", "testing/manifest/test/data/fontface_reftest.list", "testing/manifest/test/test_skipfails.py"], "git_node": "7f0339fc95ab4d0098e997c44e2858191e08b8f2", "git_parents": ["7ed301e8c07fe2edb0d2952e9d8baa93772dd2d2"], "node": "b14f78befaf545925777b8dff8517d672cd9d28f", "parents": ["25a1d4e427fab9b4e44b49b3e5a4332f0c5511b7"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1872779, 1872781, 1872782, 2057236, 2057259: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/tests/fuzz/TestCOLRv1.cpp"], "git_node": "c70170cf32d9618e7e207daa7c76e7ed3a04f845", "git_parents": ["7f0339fc95ab4d0098e997c44e2858191e08b8f2"], "node": "60cf22a8f6ad37ce154dfede41940ff10ebe6897", "parents": ["b14f78befaf545925777b8dff8517d672cd9d28f"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058644 - Don't strip a pref branch root longer than the pref name. r=gstoll\n\nCallbackNode strips a trailing dot from its domain so it maps onto the trie's\ndot-separated segments, which puts domain \"browser.download.\" at the same node\nas the pref literally named \"browser.download\". All callbacks at a terminal\nnode fire, so the observer registered for the branch also fired for that\nshorter name, where the pre-trie StringBeginsWith match never did. Restore that\nby remembering whether the domain as registered ended with a dot. Array entries\nare not dot-stripped, so an exact match against one still fires.\n\nNotifyObserver strips GetRootLength() bytes off the notified name, which\nassumes the root is a prefix of it. The trie normalizes trailing dots while the\nroot length does not, so clamp the strip to the name length rather than rely on\nthat. Not an assertion: the two legitimately disagree for a root carrying a\nredundant dot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315233\n", "files": ["modules/libpref/Preferences.cpp"], "git_node": "d8fa47080dcd2959b90a05739962ebabebd89104", "git_parents": ["c70170cf32d9618e7e207daa7c76e7ed3a04f845"], "node": "cd045ae7e0ec19c8230cf6cca1fa8175e2c2adaa", "parents": ["60cf22a8f6ad37ce154dfede41940ff10ebe6897"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1958755 - Insert coalesced loads after the list head to avoid O(N^2) loading r=emilio,firefox-style-system-reviewers\n\nCoalesceLoad() walked the coalesced-load list to its tail to append each\nnew load, which is quadratic when many loads for the same URL are\nstarted at once (e.g. thousands of @import rules pointing at the same\nsheet).\n\nThe only ordering invariant here is that the head is the load that\ntriggers the request, so inserting right after the head is O(1) and\npreserves it.\n\nThe pending path already puts a later-arriving load at the front, so the\norder of the rest was never arrival order to begin with.\n\nThis does change the relative order in which coalesced loads are\nnotified on completion, so several \u003clink\u003es pointing at the same URL fire\ntheir load events in a different order than before, but that order\nisn't guaranteed per spec.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312853\n", "files": ["layout/style/SharedSubResourceCache.h"], "git_node": "0d5536e3ff3961362e8e013f3afe649a8a345c13", "git_parents": ["d8fa47080dcd2959b90a05739962ebabebd89104"], "node": "779b13c6af8015a77329d540a9aea9afa42d7a86", "parents": ["cd045ae7e0ec19c8230cf6cca1fa8175e2c2adaa"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1872779, 1872781, 1872782, 2057236, 2057259: apply code formatting via Lando\" for causing rust tests build bustages and lint failures.\n\nThis reverts commit c70170cf32d9618e7e207daa7c76e7ed3a04f845.\n\nRevert \"Bug 2057259 - Remove the gfx.font_rendering.colr_v1.enabled pref. r=layout-reviewers,emilio\"\n\nThis reverts commit 7f0339fc95ab4d0098e997c44e2858191e08b8f2.\n\nRevert \"Bug 2057236 - Remove the layout.css.font-variant-emoji.enabled pref. r=layout-reviewers,firefox-style-system-reviewers,emilio\"\n\nThis reverts commit 7ed301e8c07fe2edb0d2952e9d8baa93772dd2d2.\n\nRevert \"Bug 1872779 - Remove the layout.css.font-tech.enabled pref. r=layout-reviewers,firefox-style-system-reviewers,emilio\"\n\nThis reverts commit 321670e3c09b50263f6364c69c44296e2a223bca.\n\nRevert \"Bug 1872781 - Remove the layout.css.font-variations.enabled pref. r=layout-reviewers,webidl,devtools-reviewers,firefox-style-system-reviewers,emilio,nchevobbe\"\n\nThis reverts commit 0efe680e064533345b71fa1b31ec4c8f59cb1ede.\n\nRevert \"Bug 1872782 - Remove the layout.css.font-palette.enabled pref. r=layout-reviewers,webidl,firefox-style-system-reviewers,emilio\"\n\nThis reverts commit 46136c0ae1732d442447a9fa799fe0b4d3707652.\n", "files": ["devtools/server/actors/page-style.js", "dom/animation/test/mozilla/test_disabled_properties.html", "dom/webidl/CSSFontPaletteValuesRule.webidl", "dom/webidl/FontFace.webidl", "gfx/tests/fuzz/TestCOLRv1.cpp", "gfx/thebes/COLRFonts.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFontEntry.cpp", "gfx/thebes/gfxPlatform.cpp", "layout/inspector/tests/chrome/test_fontVariationsAPI.xhtml", "layout/reftests/font-face/colrv1-02.html", "layout/reftests/font-face/colrv1-02a-ref.html", "layout/reftests/font-face/colrv1-02b-ref.html", "layout/reftests/font-face/reftest.list", "layout/reftests/font-variations/reftest.list", "layout/style/FontFaceImpl.cpp", "layout/style/FontFaceSetImpl.cpp", "layout/style/test/file_animations_with_disabled_properties.html", "layout/style/test/property_database.js", "layout/style/test/test_animations_with_disabled_properties.html", "layout/style/test/test_system_font_serialization.html", "layout/style/test/test_transitions_per_property.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/font_face.rs", "servo/components/style/properties/font_face_descriptors.toml", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/shorthands.rs", "servo/components/style/stylesheets/rule_parser.rs", "servo/components/style/stylesheets/supports_rule.rs", "testing/manifest/test/data/fontface_reftest.list", "testing/manifest/test/test_skipfails.py", "testing/web-platform/meta/css/css-fonts/__dir__.ini"], "git_node": "f70408570995854dad2549c9b377375c57060be2", "git_parents": ["0d5536e3ff3961362e8e013f3afe649a8a345c13"], "node": "e4ef2f5b4adf1cf7fd2ca2aace268ee868ed41e0", "parents": ["779b13c6af8015a77329d540a9aea9afa42d7a86"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055837 - use uv in reftest tasks. r=taskgraph-reviewers,bhearsum\" for causing mochitest failures\n\nThis reverts commit 1a610abe469f33f53812638f425940d0a81a9254.\n", "files": ["taskcluster/kinds/reftest/kind.yml"], "git_node": "849d83251690f6d330d409dc712797fdcb27e275", "git_parents": ["f70408570995854dad2549c9b377375c57060be2"], "node": "2e606e9659df0662ac48c35b331760ec2c587d5c", "parents": ["e4ef2f5b4adf1cf7fd2ca2aace268ee868ed41e0"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055837 - use uv in mochitest tasks. r=taskgraph-reviewers,bhearsum\" for causing mochitest failures\n\nThis reverts commit 9baf35358753261eb9786818b6e215215e7f129f.\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "f7b12637919cfcb4bc3a81da18a7e33adc813d96", "git_parents": ["849d83251690f6d330d409dc712797fdcb27e275"], "node": "67dbff79b6a125a309afaf4db1c1e0e9572be659", "parents": ["2e606e9659df0662ac48c35b331760ec2c587d5c"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058852 - Prune stale docs concurrently with uploads in source-test-doc-upload r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nThe source-test-doc-upload task spends ~13.5 min in the upload step (task K80tP0C7SJCb1RP-zz2gdQ took 22 min total). Log analysis shows the two s3_delete_missing() calls (one per key prefix) run serially *after* each upload pass, each doing a slow bucket listing while nothing is uploaded \u2014 ~5.5 min of pure blocking (3.9 min + 1.6 min).\n\ns3_delete_missing only removes keys that are NOT in the current file set, while the uploads only write keys that ARE in it, so the two operate on disjoint keys and their ordering is irrelevant to the result. Submit the prune to the upload thread pool up front so its bucket listing overlaps the uploads instead of blocking after them, cutting the upload phase to roughly max(uploads, listing) per prefix (~8 min).\n\nAlso bumps max_pool_connections to accommodate the extra concurrent prune connection, moves the file read onto the worker thread, and adds a moztreedocs unit test covering upload, selective pruning, main/ preservation, error propagation, and the upload/prune overlap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314868\n", "files": ["tools/moztreedocs/upload.py"], "git_node": "bdb283ca77b2430b59512a9cbb91f49e17d23133", "git_parents": ["f7b12637919cfcb4bc3a81da18a7e33adc813d96"], "node": "c0b292c10df63ecf176c7fb4902aaeeb66ab61b9", "parents": ["67dbff79b6a125a309afaf4db1c1e0e9572be659"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051013 - Validate `mInnerURI` when deserializing, r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314611\n", "files": ["netwerk/base/nsSimpleNestedURI.cpp", "netwerk/base/nsSimpleNestedURI.h", "netwerk/protocol/about/nsAboutProtocolHandler.cpp", "netwerk/protocol/about/nsAboutProtocolHandler.h"], "git_node": "fa4f02f2d5526536cd992681aa70e162661acd5e", "git_parents": ["bdb283ca77b2430b59512a9cbb91f49e17d23133"], "node": "2bdcaf74072c698fb9913b94b46cf5fa26ab5332", "parents": ["c0b292c10df63ecf176c7fb4902aaeeb66ab61b9"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057009 - The shield should not start off with the check mark as default regardless if trackers are found or not. r=urlbar-reviewers,desktop-theme-reviewers,dao,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313607\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/browser.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_pages.js", "browser/themes/shared/identity-block/identity-block.css"], "git_node": "3ebf887ad1b32cd970bfd9968f31a3ffd236e150", "git_parents": ["fa4f02f2d5526536cd992681aa70e162661acd5e"], "node": "6b1b034df8fa7aca760b914a1c3e7f1194e64060", "parents": ["2bdcaf74072c698fb9913b94b46cf5fa26ab5332"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051700 - Add referrals section to about:preferences. r=fluent-reviewers,nbarrett,hjones,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314382\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-init.js", "browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/components/preferences/config/account-sync.mjs", "browser/components/preferences/preferences.js", "browser/components/referrals/Referrals.sys.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "207a89f358dbeffcb2848dfa30cd5ec56646ebe5", "git_parents": ["3ebf887ad1b32cd970bfd9968f31a3ffd236e150"], "node": "4dd1874bec8bca5183cccc666766a8b9546533c9", "parents": ["6b1b034df8fa7aca760b914a1c3e7f1194e64060"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055837 - use uv in browsertime tasks. r=taskgraph-reviewers,bhearsum\" for causing mochiest failures\n\nThis reverts commit 98aa33de1e31671661caef6156565b087b0c871e.\n", "files": ["taskcluster/kinds/browsertime/kind.yml"], "git_node": "e0b3a9ca75794cb78d6abeff72269456d69b8919", "git_parents": ["207a89f358dbeffcb2848dfa30cd5ec56646ebe5"], "node": "a5b41e1a2a6f34933a0c52326861e7c179f6a725", "parents": ["4dd1874bec8bca5183cccc666766a8b9546533c9"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059224 - Use NonVoidStringToJsval for HostGetCodeForEval. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315242\n", "files": ["dom/security/trusted-types/TrustedTypeUtils.cpp"], "git_node": "574824caefca91fdfeabe6087991cc78f1abc143", "git_parents": ["e0b3a9ca75794cb78d6abeff72269456d69b8919"], "node": "02476d032c7d78bb011b8ea9238c54c94e69c9b4", "parents": ["a5b41e1a2a6f34933a0c52326861e7c179f6a725"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2057579 - Implement CSSTransformComponent is2D setter and prepare toMatrix dispatch; r=emilio,firefox-style-system-reviewers\n\nImplement the `CSSTransformComponent.is2D` setter according to the CSS Typed OM\nspecification.\n\nThe setter now updates the stored value for transform components whose `is2D`\nattribute is mutable, while leaving it unchanged for skew and perspective\ncomponents, where the attribute is fixed by the specification.\n\nThis patch also adds the common dispatch structure for\n`CSSTransformComponent::ToMatrix()`. The individual transform-component matrix\nconversions will be added incrementally in follow-up patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314857\n", "files": ["layout/style/typedom/CSSTransformComponent.cpp", "layout/style/typedom/CSSTransformComponent.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-serialization/cssTransformValue.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssRotate.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssScale.tentative.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTranslate.tentative.html.ini"], "git_node": "72097ad7b1874427d5b5b4c11492af67bd51d6d0", "git_parents": ["574824caefca91fdfeabe6087991cc78f1abc143"], "node": "5d9c2fdb99dd7dfd7964ee8b94b2db2ee93579e6", "parents": ["02476d032c7d78bb011b8ea9238c54c94e69c9b4"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058458 - Ensure auto-compact mode works as expected when opening/closing the sidebar r=jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315303\n", "files": ["browser/base/content/browser.js", "browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_uidensity_auto_compact.js"], "git_node": "d14a34421f95f2f43008f0c0cc93440ae4580be7", "git_parents": ["72097ad7b1874427d5b5b4c11492af67bd51d6d0"], "node": "5c9f073bbfb62b3d561c4508c2aa5df80e6cc7d4", "parents": ["5d9c2fdb99dd7dfd7964ee8b94b2db2ee93579e6"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059649 - Update android nightly application-services version bump to b21da19867ff58b1cfd8c83fceba8dac1f243c44 r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315535\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "7dc890eb4f10c773de95312ae23ed3af292fc36f", "git_parents": ["d14a34421f95f2f43008f0c0cc93440ae4580be7"], "node": "b5e22e18ded826b49369204434560e43a4bb17a6", "parents": ["5c9f073bbfb62b3d561c4508c2aa5df80e6cc7d4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2059572 - Only retain as much memory as a captured stack needs, r=profiler-reviewers,canova.\n\nStacks are captured into a buffer that can hold the deepest possible stack,\n128KB, and callers that keep a captured backtrace alive retained all of it.\nTimeout keeps one per pending setTimeout(), so a page scheduling timers faster\nthan they fire could retain tens of GB of mostly unused buffers.\n\nCopy the captured stack into a buffer sized to what it actually used before\nhanding it to the caller.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315453\n", "files": ["mozglue/baseprofiler/core/BaseAndGeckoProfilerDetail.cpp", "mozglue/baseprofiler/core/platform.cpp", "mozglue/baseprofiler/public/BaseAndGeckoProfilerDetail.h", "tools/profiler/core/platform.cpp", "tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "6cd914af4539ba6b17feec8a8b4234f3d8523323", "git_parents": ["7dc890eb4f10c773de95312ae23ed3af292fc36f"], "node": "fddb9abea15da1e47befd502a0af4913abe527aa", "parents": ["b5e22e18ded826b49369204434560e43a4bb17a6"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2055568 - Allow a distribution.ini with only an id r=firefox-desktop-core-reviewers ,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314011\n", "files": ["browser/components/distribution.sys.mjs", "browser/components/tests/unit/test_distribution_idonly.js", "browser/components/tests/unit/xpcshell.toml"], "git_node": "b90e01b23bce2561c82d734d82d0976c20131c86", "git_parents": ["6cd914af4539ba6b17feec8a8b4234f3d8523323"], "node": "49b8758343fcef4c337b206ca98875e8bf6add50", "parents": ["fddb9abea15da1e47befd502a0af4913abe527aa"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2055568 - Only show distribution info in About when there is about text r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314012\n", "files": ["browser/base/content/aboutDialog.js", "browser/components/preferences/config/about-firefox.mjs"], "git_node": "cafa9b2cfdab2a0d8ef2c105a0b6a621d640b49e", "git_parents": ["b90e01b23bce2561c82d734d82d0976c20131c86"], "node": "729d0b5ebdced5b987f57fa1d4f453c2e46089bf", "parents": ["49b8758343fcef4c337b206ca98875e8bf6add50"], "tags": []}, {"author": "Sandor 