ents": ["8cfec43be524aa0df313b9fb09595657511a8f1b"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057674: Add dismissable sync promo to app menu history panel r=sync-reviewers,fluent-reviewers,desktop-theme-reviewers,bolsson,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314168\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-menubar.js", "browser/base/content/browser-sync.js", "browser/base/content/browser.js", "browser/components/customizableui/content/jar.mn", "browser/components/customizableui/content/sync-promo.css", "browser/components/customizableui/content/sync-promo.mjs", "browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_history_sync_promo.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/fxa/sync-promo-connectdevice.svg", "browser/themes/shared/fxa/sync-promo-signin.svg", "browser/themes/shared/fxa/sync-promo-turnonsync.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "271f0dabba299e53140e07166613343aba8f3abe", "git_parents": ["2f568b5c843830c1a2665a7da4208b1faada67e3"], "node": "16e190baa3fe3c0082f2d299a31d90823894c12a", "parents": ["b08e7f99aa74c656f43e33e06fffb5c5743d7e03"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059270: Add dismissable sync promo to app menu bookmarks panel r=sync-reviewers,fluent-reviewers,places-reviewers,desktop-theme-reviewers,Standard8,tgiles,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315146\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-places.js", "browser/components/customizableui/content/sync-promo.mjs", "browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_bookmarks_sync_promo.js", "browser/components/customizableui/test/browser_history_sync_promo.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/fxa/sync-promo-bookmarks.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "32607ec9aaf2f0f3c1f0632f67b90fe45f39e4dc", "git_parents": ["271f0dabba299e53140e07166613343aba8f3abe"], "node": "e124b7d58a3fa426c2157b76dd6148d32e364c23", "parents": ["16e190baa3fe3c0082f2d299a31d90823894c12a"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054381 - Fix ConcurrentConnection LOCKED race on Places startup. r=places-reviewers,daisuke\" for causing gtest failures at ConcurrentConnection\n\nThis reverts commit b10910c797b082225747c7f5375603947cf3adac.\n", "files": ["toolkit/components/places/ConcurrentConnection.cpp", "toolkit/components/places/ConcurrentConnection.h", "toolkit/components/places/Database.cpp", "toolkit/components/places/Database.h", "toolkit/components/places/tests/gtest/test_ConcurrentConnection.cpp"], "git_node": "55b850373b3227bd3ccf9d81d5a4bfff4d7f69cf", "git_parents": ["32607ec9aaf2f0f3c1f0632f67b90fe45f39e4dc"], "node": "b8154c2191911ff426a8a58b009851ee4aa6967c", "parents": ["e124b7d58a3fa426c2157b76dd6148d32e364c23"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2018699 - Migrate simple unit tests to Jest/RTL. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315080\n", "files": ["browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/test/jest/content-src/components/ComponentPerfTimer.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DownloadModalToggle.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/ErrorBoundary.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/ExternalComponentWrapper.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/FluentOrText.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/ModalOverlay.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/MoreRecommendations.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/ComponentPerfTimer.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/DownloadModalToggle.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/ErrorBoundary.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/ExternalComponentWrapper.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/FluentOrText.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/ModalOverlay.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/MoreRecommendations.test.jsx"], "git_node": "e01da02fcdb9408eb5f92843341403816685f90f", "git_parents": ["55b850373b3227bd3ccf9d81d5a4bfff4d7f69cf"], "node": "1339ecf1b19241e38a68c56737cba9abf45b9d0e", "parents": ["b8154c2191911ff426a8a58b009851ee4aa6967c"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051788: Clamp content-initiated window resizes to the screen in the parent process. r=emilio,dom-core-reviewers,smaug\n\nBrowserParent::RecvSetDimensions() rescaled a resize request coming from content for DPI and passed it on without bounding the size, and nothing further down keeps a window near the size of its screen. The size passed to window.open() is already bounded that way in nsWindowWatcher::SizeOpenedWindow().\n\nThe size is now clamped to twice the available area of the screen the window is on. Twice rather than exactly the screen, because the size we get for a screen is not always accurate, on Wayland in particular, and all we need is to keep the size in a range the window can be given. The clamp lives in RecvSetDimensions() rather than in nsGlobalWindowOuter, because for a content window the resize is requested in the content process but carried out in the parent, so this is where it can be enforced.\n\nResizeByOuter() also added the deltas coming from content to the current size in 32-bit arithmetic, which overflows for large values. It now adds in 64 bits and keeps the result in range.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316180\n", "files": ["browser/base/content/test/popups/browser.toml", "browser/base/content/test/popups/browser_popup_resize_clamp.js", "dom/base/nsGlobalWindowOuter.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "e30801fa1ccdf62526c18bcfe6d123be07d274da", "git_parents": ["e01da02fcdb9408eb5f92843341403816685f90f"], "node": "65c3fd5404da73abfdd17cc3d36a7011f15931b2", "parents": ["1339ecf1b19241e38a68c56737cba9abf45b9d0e"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2060449 - Wait ImageBrige task handled in CanvasContext::Unconfigure() with offscreen canvas r=gfx-reviewers,aosmond\n\nThe wait ensures that FwdTransactionTracker is updated by ImageBridgeChild.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316208\n", "files": ["dom/webgpu/CanvasContext.cpp", "gfx/layers/ipc/ImageBridgeChild.cpp", "gfx/layers/ipc/ImageBridgeChild.h"], "git_node": "9178c688df23bce37339fac04f82962854ee3150", "git_parents": ["e30801fa1ccdf62526c18bcfe6d123be07d274da"], "node": "9653569b5fbb0271cff699d8a6dede5ad40ea935", "parents": ["65c3fd5404da73abfdd17cc3d36a7011f15931b2"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058270 - Gate Smart Window ATG/'Organize Tabs' button to minimum user RAM r=echa,mzhang\n\nRequirement: `browser.smartwindow.autoTabGrouping.enabled` in a Smart Window\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314471\n", "files": ["browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_AutoTabGrouping.js"], "git_node": "e3daca6219fc78576a91f69a09eccc86452372c9", "git_parents": ["9178c688df23bce37339fac04f82962854ee3150"], "node": "fe3414e8ada8827dda6f4549a689a1f3299a595b", "parents": ["9653569b5fbb0271cff699d8a6dede5ad40ea935"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2051788: Clamp content-initiated window resizes to the screen in the parent process. r=emilio,dom-core-reviewers,smaug\" for causing bustage @ BrowserParent.cpp\n\nThis reverts commit e30801fa1ccdf62526c18bcfe6d123be07d274da.\n", "files": ["browser/base/content/test/popups/browser.toml", "browser/base/content/test/popups/browser_popup_resize_clamp.js", "dom/base/nsGlobalWindowOuter.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "3351e1c4ecb6a2f97577af4f87a1198f0eb6b2f7", "git_parents": ["e3daca6219fc78576a91f69a09eccc86452372c9"], "node": "98ab9cf6b1d8258f6b326891fb6ce7ee9d16c014", "parents": ["fe3414e8ada8827dda6f4549a689a1f3299a595b"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2042994 - Parse and serialize -webkit-line-clamp as a legacy shorthand for line-clamp. r=AlaskanEmily,dshin,firefox-style-system-reviewers,emilio\" for causing wr at /line-clamp-034.html\n\nThis reverts commit 4889e720448b570304f42ff7ee6af52ef5c2f1f2.\n", "files": ["devtools/server/actors/animation-type-longhand.js", "layout/style/nsStyleStruct.cpp", "layout/style/test/property_database.js", "layout/style/test/test_all_shorthand.html", "layout/style/test/test_ch_ex_no_infloops.html", "layout/style/test/test_inherit_computation.html", "layout/style/test/test_inherit_storage.html", "layout/style/test/test_initial_computation.html", "layout/style/test/test_initial_storage.html", "layout/style/test/test_property_database.html", "layout/style/test/test_transitions_per_property.html", "layout/style/test/test_value_computation.html", "layout/style/test/test_value_storage.html", "servo/components/style/properties/data.py", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/style_adjuster.rs", "servo/components/style/values/generics/box.rs", "servo/components/style/values/specified/box.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-019.html.ini"], "git_node": "c29cc56528f5f15ada21238573da73bcb4b83c04", "git_parents": ["3351e1c4ecb6a2f97577af4f87a1198f0eb6b2f7"], "node": "d975760b09831351c0417f6548000f4dc84da4cb", "parents": ["98ab9cf6b1d8258f6b326891fb6ce7ee9d16c014"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051788: Clamp content-initiated window resizes to the screen in the parent process. r=emilio,dom-core-reviewers,smaug\n\nBrowserParent::RecvSetDimensions() rescaled a resize request coming from content for DPI and passed it on without bounding the size, and nothing further down keeps a window near the size of its screen. The size passed to window.open() is already bounded that way in nsWindowWatcher::SizeOpenedWindow().\n\nThe size is now clamped to twice the available area of the screen the window is on. Twice rather than exactly the screen, because the size we get for a screen is not always accurate, on Wayland in particular, and all we need is to keep the size in a range the window can be given. The clamp lives in RecvSetDimensions() rather than in nsGlobalWindowOuter, because for a content window the resize is requested in the content process but carried out in the parent, so this is where it can be enforced.\n\nResizeByOuter() also added the deltas coming from content to the current size in 32-bit arithmetic, which overflows for large values. It now adds in 64 bits and keeps the result in range.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316180\n", "files": ["browser/base/content/test/popups/browser.toml", "browser/base/content/test/popups/browser_popup_resize_clamp.js", "dom/base/nsGlobalWindowOuter.cpp", "dom/ipc/BrowserParent.cpp"], "git_node": "f9d85c89f016f3bdc92c1ff3eb81281a0dbe84ca", "git_parents": ["c29cc56528f5f15ada21238573da73bcb4b83c04"], "node": "bd6d0684a78dfed848faba4bba7b7ad7bda25ff0", "parents": ["d975760b09831351c0417f6548000f4dc84da4cb"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2059800. Teach the code that looks for the first scrollable frame to give a displayport about the tab bar scroller. r=dao,hiro,layout-reviewers,emilio,akulyk\n\nMaybeCreateDisplayPortInFirstScrollFrameEncountered gives a displayport to the\nfirst async scrollable frame it finds, so that frame is ready for APZ before\nanything scrolls it. It skips tabbrowser-arrowscrollbox entirely. That was\ncorrect when bug 1755290 added the bail out, because \u003cscrollbox\u003e was\noverflow: hidden and so never WantAsyncScroll(). Bug 1899582 gave the vertical\ntab strip's scrollbox overflow-y: auto, and bug 2059794 moves that into\narrowscrollbox.css gated on [overflowing], so the tab bar does contain an async\nscrollable element now.\n\nThe strip therefore has only the minimal displayport from\nShouldActivateAllScrollFrames(), which with apz.prefer_jank_minimal_displayports\nsuppresses the async scroll offset until APZ requests a content repaint. It gets\na non-minimal one the first time it is scrolled. The bail out does not prevent\nthe strip from getting a displayport, only from having one before that first\nscroll.\n\nThe arrowscrollbox's scroll container is a direct child frame and every tab\nlives inside it, so scanning only the direct children finds it without walking\nthe tabs. That preserves the optimization bug 1755290 added, which was measured\nat roughly 15% of the parent-process time to open a new tab in a session with\nmany tabs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315780\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "layout/base/DisplayPortUtils.cpp", "toolkit/content/widgets/arrowscrollbox.js"], "git_node": "667ef7dd6c9f7c5f2db1601bde81caf732ed765b", "git_parents": ["f9d85c89f016f3bdc92c1ff3eb81281a0dbe84ca"], "node": "5ba5df245a519f5f0f05f8c08c9cb44ffaeefd5a", "parents": ["bd6d0684a78dfed848faba4bba7b7ad7bda25ff0"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2060106. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316236\n", "files": ["dom/base/nsContentUtils.cpp"], "git_node": "d7420de296238efb3c45b5fa3b9f4eb81d080802", "git_parents": ["667ef7dd6c9f7c5f2db1601bde81caf732ed765b"], "node": "3f320f654f07317b39b158565c066241d6ff4c7e", "parents": ["5ba5df245a519f5f0f05f8c08c9cb44ffaeefd5a"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-hu/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-ar/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-ro/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml", "mobile/android/focus-android/app/src/main/res/values-kk/strings.xml"], "git_node": "921d50162cd6fff02d81face258e0b3453017c50", "git_parents": ["d7420de296238efb3c45b5fa3b9f4eb81d080802"], "node": "661b66697265887122ef525efb903bc4f3275820", "parents": ["3f320f654f07317b39b158565c066241d6ff4c7e"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057058 - Report browser.nova.enabled - r=sthompson,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316147\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/metrics.yaml", "browser/modules/test/browser/browser_UsageTelemetry_idleDaily.js"], "git_node": "b2784d221c707f9cddd27846d1012cae3508ab08", "git_parents": ["921d50162cd6fff02d81face258e0b3453017c50"], "node": "42ade49f818f094a499a835def09d88f325e18ba", "parents": ["661b66697265887122ef525efb903bc4f3275820"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056670 - Allow swiping from home when HNT enabled r=android-reviewers,npoon\" for causing fenix ui test failures\n\nThis reverts commit 6e40c75c47d5630fbe29097421371c4dfe24a6ff.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/gestures/ToolbarHorizontalGesturesHandler.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/HomeSwipeIntegration.kt"], "git_node": "91aaa01b6b321901d13edfdb1970f80a27996e67", "git_parents": ["b2784d221c707f9cddd27846d1012cae3508ab08"], "node": "1a030517db00db0525ec038bb9b9be95e0ef0d94", "parents": ["42ade49f818f094a499a835def09d88f325e18ba"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2057443 - Avoid light-dark() for tab group colors since the tokens already apply it r=desktop-theme-reviewers,tabbrowser-reviewers,urlbar-reviewers,jsudiaman,emilio,adw\n\nBug 2046942 moved the light/dark switch into the --tab-group-${color} tokens\nthemselves, but we were still applying an additional light-dark(). We should\nuse --tab-group-color directly now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315905\n", "files": ["browser/themes/shared/tabbrowser/tabs.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "ec0684b9e8aaf00e98663a43a6672631a0713a0e", "git_parents": ["91aaa01b6b321901d13edfdb1970f80a27996e67"], "node": "2190c849ea4e9ca562140ab696a760fcf8e70475", "parents": ["1a030517db00db0525ec038bb9b9be95e0ef0d94"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049117: Let Shift+Option+Arrow selection cross paragraph boundaries on macOS. r=mac-reviewers,bradwerth\n\nOn macOS, Shift+Option+ArrowDown/ArrowUp is interpreted by AppKit as a single moveParagraphForwardAndModifySelection: / moveParagraphBackwardAndModifySelection: selector, which we mapped to a single SelectEndParagraph / SelectBeginParagraph command. That command extends the selection to the current paragraph's edge but cannot advance past it, so once the selection focus sits at a paragraph boundary, repeated presses stop extending the selection and only a single paragraph can be selected.\n\nThe non-selecting Option+ArrowDown/ArrowUp binding already avoids this by emitting a character move (moveForward: / moveBackward:) before the paragraph move so the caret first steps across the boundary. Mirror that for the selecting variants by expanding the two moveParagraph...AndModifySelection: selectors into a character-selection command followed by the paragraph-selection command. This keeps them distinct from the Emacs-style Ctrl+Shift+E / Ctrl+Shift+A bindings, whose native selectors intentionally do not cross paragraph boundaries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315279\n", "files": ["widget/cocoa/NativeKeyBindings.mm", "widget/tests/gtest/TestNativeKeyBindings.cpp", "widget/tests/mochitest.toml", "widget/tests/test_paragraph_selection_with_alt_arrow_on_mac.html"], "git_node": "75815c9be080478889c36888337c24b517132fbe", "git_parents": ["ec0684b9e8aaf00e98663a43a6672631a0713a0e"], "node": "9f92a55baf85af846bc5094bbc1072a57eea75b8", "parents": ["2190c849ea4e9ca562140ab696a760fcf8e70475"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060413 - fix invalid test wpt/webrtc/simulcast/rid-manipulation.html;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316162\n", "files": ["testing/web-platform/meta/webrtc/simulcast/rid-manipulation.html.ini", "testing/web-platform/tests/webrtc/simulcast/rid-manipulation.html"], "git_node": "6ec4312c7ebfad648232b79564450dba0b036d0f", "git_parents": ["75815c9be080478889c36888337c24b517132fbe"], "node": "16f6ec8044b0173a74a6004db26f597225b57683", "parents": ["9f92a55baf85af846bc5094bbc1072a57eea75b8"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057183 - Rename SWGL's __VERSION__ to __SWGL_GLSL_VERSION__. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316397\n", "files": ["gfx/wr/glsl-to-cxx/src/lib.rs", "gfx/wr/swgl/build.rs"], "git_node": "ba9d92c857db2b2e6215171ffad927e3a9a58662", "git_parents": ["6ec4312c7ebfad648232b79564450dba0b036d0f"], "node": "1580a03b763d61728ca708a338c8cd95f18669d3", "parents": ["16f6ec8044b0173a74a6004db26f597225b57683"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059955 - Enumerate android-gradle-dependencies by Gradle build, not by task list. r=ahochheiden\n\nThe toolchain task asked Gradle for a curated list of tasks, on the assumption that the list drove which\ndependencies got enumerated. It doesn't: with --write-verification-metadata, Gradle resolves every\nresolvable configuration of every project that the requested tasks pull into the build, so a task list can\nonly ever narrow the result. The list was also entirely :geckoview-scoped, which is why the top-level pass\ncovered barely half of what the task as a whole enumerated, and why three further invocations had to make\nup the difference.\n\nMove the passes into `mach android gradle-dependencies` as the set of Gradle builds to cover, each\nrequesting nothing but `help` so that nothing is narrowed, and keep the geckoview-lite artifact scoped by\nnaming the projects its consumers build rather than by naming tasks. Both artifacts enumerate exactly the\nsame set of components and artifacts they did before.\n\nA dependency that is only used conditionally now has to be gated on DOWNLOAD_ALL_GRADLE_DEPENDENCIES,\nwhich this task's mozconfig sets, rather than on a Gradle property that a pass would have to name.\nAndroid-components' coverage dependencies already were, so asking for -Pcoverage was redundant.\n\nThe flags that make a pass enumerate rather than build move in with the passes, so neither caller has to\nset GRADLE_FLAGS in between `mach build` and them. That ordering was load-bearing and easy to get wrong,\nwhich is why both scripts carried a comment warning about it; the trap is now gone rather than documented.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315811\n", "files": [".gitignore", ".hgignore", "build/docs/toolchains.md", "build/sparse-profiles/taskgraph", "mobile/android/gradle.configure", "mobile/android/mach_commands.py", "taskcluster/kinds/toolchain/android.yml", "taskcluster/scripts/misc/android-gradle-dependencies-lite.sh", "taskcluster/scripts/misc/android-gradle-dependencies.sh"], "git_node": "bfb2435b3c2dc1dc80b745e2ae02bbe8c2061a0d", "git_parents": ["ba9d92c857db2b2e6215171ffad927e3a9a58662"], "node": "b3700aa212f31a3c322d58c5b0211ff4cd33041e", "parents": ["1580a03b763d61728ca708a338c8cd95f18669d3"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059955 - Check that the packaged Gradle dependency cache is complete. r=ahochheiden\n\nThis task has intermittently produced artifacts with files missing, which only surfaces much later as a\nconfusing resolution failure in a task that fetched it. The existing check watches a single hardcoded\nartifact as a canary.\n\nCheck all of it instead. Each enumeration pass leaves behind an inventory of every artifact Gradle\nresolved, with a sha256 for each, so verify the packaged repositories against those. The passes resolve\neither through the local Nexus or from a repository that is packaged as it stands, so anything else absent,\nor any component packaged with one of its files missing or damaged, is a fault and fails the task before it\npays to compress the artifact. The three are reported apart, since what to do about a component that was\nnever packaged is not what to do about one that was packaged incompletely.\n\nTwo wrinkles. Downstream tasks are handed every packaged repository, so an artifact only has to appear in\none of them. And a component's module metadata can name a file that a different module publishes: Gradle\nrecords guava's -jre jar under its -android component, and Kotlin Multiplatform modules redirect to a\nplatform-specific module. Where the recorded name isn't where the component's coordinates point, look for\nits checksum elsewhere in the packaged tree.\n\nGeckoView is exempt: this task builds it and publishes it to a local Maven repository that the standalone\npasses resolve it from, so it is deliberately not packaged.\n\nOnly those three fail the task, because only those three become a resolution failure in a task that fetched\nthe archive. An inventory that contradicts itself, or an entry too malformed to check, is reported as a\nwarning instead: the archive still works, and a red toolchain task would cost more than it tells anyone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315812\n", "files": ["build/docs/toolchains.md", "taskcluster/scripts/misc/android-gradle-dependencies/after.sh", "taskcluster/scripts/misc/android-gradle-dependencies/verify_dependencies.py", "taskcluster/test/python.toml", "taskcluster/test/test_verify_dependencies.py"], "git_node": "5704fb79a38f4c5fa8e8c0ee4d64d464166d4228", "git_parents": ["bfb2435b3c2dc1dc80b745e2ae02bbe8c2061a0d"], "node": "bdb27a67e1888acdd9b33d60a2bec2600fe022c3", "parents": ["b3700aa212f31a3c322d58c5b0211ff4cd33041e"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046947 - Vendor the double-checkmark icon from acorn-icons r=desktop-theme-reviewers,dao\n\nAdd double-checkmark-16.svg from acorn-icons v1.103.0 and declare it in the\nshared desktop jar so it is available as chrome://global/skin/icons/.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315132\n", "files": ["toolkit/themes/shared/desktop-jar.inc.mn", "toolkit/themes/shared/icons/double-checkmark.svg"], "git_node": "27a65fe1bc37b6d8461a1c9edcee2540dd27aeae", "git_parents": ["5704fb79a38f4c5fa8e8c0ee4d64d464166d4228"], "node": "8733eab4cc7a65d8f8cdabeedd44645fd3faff03", "parents": ["bdb27a67e1888acdd9b33d60a2bec2600fe022c3"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054390 - Report shown/closed web notifications to chrome observers r=saschanaz\n\nReport every shown and closed web notification to the parent-process observer service, so chrome features such as the New Tab notifications feed can observe Service-Worker-backed and page (new Notification()) notifications uniformly.\n\nThe reporting lives in nsAlertsService rather than in the Notification API. ShowAlert wraps the caller's alert listener in a small nsIObserver that forwards every callback untouched and  additionally fires \"web-notification-shown\" on alertshow and \"web-notification-closed\" on alertfinished. An alert that was never shown (see ShouldShowAlert) still finishes, but reports nothing,  because no consumer was told it existed. Only alerts with an actionable principal are reported, which is what confines this to web content, and private-browsing alerts never are. The nsIAlertNotification is the observer subject.\n\nReporting is a platform capability rather than a feature of any one consumer, so it is on by default: NotifyObservers is inert when nothing has registered for the topics, so an uninterested profile pays a hash lookup per notification and nothing more.\n\nbrowser.alerts.capture.enabled is a kill switch, not a feature gate. Consumers gate themselves; the New Tab feed is the first, and does so with browser.newtabpage.activity-stream.system.showWebNotifications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311746\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/alerts/nsAlertsService.cpp", "toolkit/components/alerts/test/browser/browser.toml", "toolkit/components/alerts/test/browser/browser_alert_capture.js", "toolkit/components/alerts/test/browser/file_empty.html"], "git_node": "26bd9e647a32e45a63fe3cd446cd1fa9213ae1cc", "git_parents": ["27a65fe1bc37b6d8461a1c9edcee2540dd27aeae"], "node": "ef3e9b590f64f8ecab08351effab9ac6632d06c7", "parents": ["8733eab4cc7a65d8f8cdabeedd44645fd3faff03"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054391 - Capture web notifications into a live newtab slice r=thecount\n\nAdd WebNotificationsFeed, the WebNotifications Redux slice, and the by-site\nmatcher. Web-notification-shown / web-notification-closed observers keep it\ncurrent, broadcasting ADDED/REMOVE.\n\nContent is a pure projection that dispatches intents (dismiss, click) to the\nparent; dismiss on the real close path (firing notificationclose).\n\nIntroduce the two prefs that gate the feature, keeping the feature gate and the\nuser preference distinct: system.showWebNotifications decides whether the\nfeature exists for this profile at all (Nimbus/about:config, default off), and\nshowWebNotifications is the user preference the customize toggle will write.\nThe feed observes only while both are set, and drops its captured state when\nthey stop being set, so content never renders a frozen snapshot. Because\nregistering the observers is what makes platform capture reach anyone, that\npair is the whole gate: nothing writes the platform pref.\n\nwebnotificationsfeed is registered as a system feed (default on), like\nweatherfeed. It is constructed for every profile and sits idle until the prefs\nsay otherwise; feed construction is a lifecycle detail, not the feature gate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311747\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/content-src/lib/web-notification-match.mjs", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/WebNotificationsFeed.sys.mjs", "browser/extensions/newtab/test/unit/common/Reducers.test.js", "browser/extensions/newtab/test/unit/content-src/lib/web-notification-match.test.js", "browser/extensions/newtab/test/unit/lib/WebNotificationsFeed.test.js"], "git_node": "e0ba87884ec9b6333f4383995115ed60d2bb60a4", "git_parents": ["26bd9e647a32e45a63fe3cd446cd1fa9213ae1cc"], "node": "1223713d761801c7f06628ca13ab67282f8a6ec6", "parents": ["ef3e9b590f64f8ecab08351effab9ac6632d06c7"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046947 - Add the top sites notifications hover card r=thecount,fluent-reviewers,bolsson\n\nAdd the TopSitesHoverCard shell and its notifications content card. The shell is\na small router: it applies the web notifications gate, then renders exactly one\ncontent variant from an ordered registry (hover-card-content.jsx).\n\nCardWebNotifications lists a site's most recent notifications.\n\nThe gate is isWebNotificationsEnabled, added next to the matcher so that every\nsurface asks the same question rather than each reaching into Prefs for its own\ncombination: the feature must exist for the profile and the user must want it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308103\n", "files": ["browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardAd/CardAd.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/_CardWebNotifications.scss", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/TopSitesHoverCard.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/_TopSitesHoverCard.scss", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/hover-card-content.jsx", "browser/extensions/newtab/content-src/lib/web-notification-icon.mjs", "browser/extensions/newtab/content-src/lib/web-notification-match.mjs", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/test/unit/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSitesHoverCard/TopSitesHoverCard.test.jsx", "browser/extensions/newtab/test/unit/content-src/lib/web-notification-icon.test.js", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "ade1a83f543617477bd142b583d4210699db0ddd", "git_parents": ["e0ba87884ec9b6333f4383995115ed60d2bb60a4"], "node": "a3674aa6d913c8c166a4daeddc1a1ad9f107cfa7", "parents": ["1223713d761801c7f06628ca13ab67282f8a6ec6"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046946 - Add the top sites notification badge and customize toggle r=thecount,fluent-reviewers,bolsson\n\nAdd TopSiteWebNotification, a count badge on a tile's icon corner showing how\nmany web notifications the site has.\n\nThe icon lives in an overflow-clipped wrapper, so the badge cannot be a child of\nit and still hang over the corner. Rather than position the badge against the\ntile and derive the icon's corner from the tile's dimensions, wrap the icon in\nan unclipped .icon-stack that takes its size from it, and anchor the badge to\nthat. The badge offset is then just zero, which also disposes of the pixel-grid\nproblem the arithmetic had: the offsets no longer round, so nothing jumps when\nthe tile repaints on hover.\n\nAdd a \"Web notifications\" toggle to the Shortcuts section of the customize\npanel. It writes showWebNotifications and nothing else, so it is an ordinary\ndata-preference toggle rather than a bespoke handler. It is only offered when\nsystem.showWebNotifications says the feature exists for this profile; there is\nno point showing a control for a feature the user cannot have.\n\nBoth the badge and the hover card render only when the feature is enabled, and\nneither requires a redux store for a bare tile mount.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308102\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/TopSiteWebNotification/TopSiteWebNotification.jsx", "browser/extensions/newtab/content-src/components/TopSiteWebNotification/_TopSiteWebNotification.scss", "browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSiteWebNotification/TopSiteWebNotification.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSites.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "a54f79e825a0d070d54c862d4a79c0d605eb5dec", "git_parents": ["ade1a83f543617477bd142b583d4210699db0ddd"], "node": "b08d2e5a82fd09a774413d8c6e54a49dd708e7ac", "parents": ["a3674aa6d913c8c166a4daeddc1a1ad9f107cfa7"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2060674 - Fix distrobox sharing shader cache with host r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316395\n", "files": ["gfx/wr/ci-scripts/distrobox.ini", "gfx/wr/wrench/script/headless.py"], "git_node": "a6a10fd10203348f48feb1eb79861d169f3e85ed", "git_parents": ["a54f79e825a0d070d54c862d4a79c0d605eb5dec"], "node": "dc53177a8fc4df71f9de53ea4d83f7855ae66c15", "parents": ["b08d2e5a82fd09a774413d8c6e54a49dd708e7ac"], "tags": []}, {"author": "Max Emig \u003cmozilla@emigm.ax\u003e", "branch": "default", "desc": "Bug 2060028 - Fix the caret position regression when inserting content into an empty block. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315934\n", "files": ["editor/libeditor/HTMLEditorDataTransfer.cpp", "editor/libeditor/tests/mochitest.toml", "editor/libeditor/tests/test_insertHTML_caret_position_after_replaced_element.html"], "git_node": "eebdde9f7e9f13c5a71d0d31e93391ca57180c75", "git_parents": ["a6a10fd10203348f48feb1eb79861d169f3e85ed"], "node": "944f566d2f1418cf2c93aa2e286d519a3454d5a2", "parents": ["dc53177a8fc4df71f9de53ea4d83f7855ae66c15"], "tags": []}, {"author": "Colden Cullen \u003ccolden@coldencullen.com\u003e", "branch": "default", "desc": "Bug 2060708: Remove unused type Impl from traits r=firefox-style-system-reviewers,emilio\n\nThese aren't actually used anywhere, and make re-using Pseudo implementations between different parsers MUCH more complicated.\n\nThis is technically a breaking change, as downstreams will need to\nremove the type definition, but that's all that's required (see\nstyle/servo/selector_parser.rs for required changes).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316430\n", "files": ["servo/components/selectors/parser.rs", "servo/components/style/gecko/pseudo_element.rs", "servo/components/style/gecko/selector_parser.rs", "servo/components/style/servo/selector_parser.rs"], "git_node": "856a07b9fd1b6112f2869f9ceff5e9ecd74c3706", "git_parents": ["eebdde9f7e9f13c5a71d0d31e93391ca57180c75"], "node": "120311fdbe5d0f197961d22c7813de5717a43e73", "parents": ["944f566d2f1418cf2c93aa2e286d519a3454d5a2"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2059632 - Move SCCACHE_MAX_FRAME_LENGTH out of mozconfig.cache. r=firefox-build-system-reviewers,ahochheiden\n\nIn some cases, IPC messages between the sccache client and sccache\nserver are too large for the default frame length, and we had a work\naround for some of those cases that happened in CI some time ago.\n\nTurning on the sccache client-side mode makes this IPC default frame\nlength problem worse, preventing the caching of many rust crate build\noutput.  So at least until sccache is improved to handle the situation\nmore smoothly, we're going to need to increase the frame length.\n\nThe previous workaround only applied to automation, where\nmozconfig.cache is used. We however now need to apply it more globally,\nsetting the variable from configure whenever sccache is in use instead,\nalongside the other sccache variables, which also gets it in the\nenvironment of whatever starts the sccache daemon: configure's own\ncompiler checks, make, or client.mk.\n\nThis only moves the setting, without changing the value just yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316436\n", "files": ["build/moz.configure/toolchain.configure", "build/mozconfig.cache", "config/config.mk", "python/mozbuild/mozbuild/controller/building.py"], "git_node": "8ff29f8d3883f8b13efb95643afe6352d09f3696", "git_parents": ["856a07b9fd1b6112f2869f9ceff5e9ecd74c3706"], "node": "cd4ddc1d5982e3824559a284feb6876b3cd78877", "parents": ["120311fdbe5d0f197961d22c7813de5717a43e73"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2059632 - Enable sccache client side mode. r=firefox-build-system-reviewers,ahochheiden\n\nAlso increase the sccache max frame length to work around caching issues\nwith large build outputs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316437\n", "files": ["build/moz.configure/toolchain.configure", "config/config.mk"], "git_node": "aed87c3e0841a58bb57f7dbeb38b0dae1c837c9b", "git_parents": ["8ff29f8d3883f8b13efb95643afe6352d09f3696"], "node": "b9db883235d16a0a81bbab0db856b5a3944e2d85", "parents": ["cd4ddc1d5982e3824559a284feb6876b3cd78877"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047023 - Add mochitest-browser-chrome-ml-models for real-model ML tests r=ai-platform-reviewers,taskgraph-reviewers,thasan,ahal,gregtatum\" for causing mochitest failures.\n\nThis reverts commit 99beeb42b7bf801508900e122fbea47797ac33b0.\n", "files": ["python/mozbuild/mozbuild/schedules.py", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/test-sets.yml", "testing/mochitest/mach_test_package_commands.py", "testing/mozbase/moztest/moztest/resolve.py", "testing/mozharness/configs/unittests/linux_unittest.py", "testing/mozharness/configs/unittests/mac_unittest.py", "testing/mozharness/configs/unittests/win_unittest.py", "testing/mozharness/mach_commands.py", "testing/mozharness/scripts/desktop_unittest.py", "toolkit/components/ml/moz.build", "toolkit/components/ml/tests/browser_models/browser_ml_smollm2_chat.js", "toolkit/components/ml/tests/browser_models/browser_models.toml"], "git_node": "310fb4a72b799281249c705e802fb47ba2759ef9", "git_parents": ["aed87c3e0841a58bb57f7dbeb38b0dae1c837c9b"], "node": "668c78399e71f4f8206f5aa2503b51ef17a13660", "parents": ["b9db883235d16a0a81bbab0db856b5a3944e2d85"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060474 - Migrate verifyUpdatedLoginIsSavedTest and verifyMultipleLoginsSelectionsTest UI tests to the efficiency framework r=jajohnson\n\nConverted the verifyUpdatedLoginIsSavedTest and verifyMultipleLoginsSelectionsTest UI tests to the efficiency framework.\n\nThe new UI tests successfully passed 50x on Firebase.  [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=75070  | Try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=75068 | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316321\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/LoginsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mob