.ini"], "git_node": "403ca34ba9498d069dde5568a02a289323923841", "git_parents": ["e4c7f17fce49ce97972d17202c956f0aee8bbf20"], "node": "ab00fb5df5e8755ce739b4f6f1e2854bd54ac7d5", "parents": ["11514629b8fee7b2941ab637b47d679585437a8c"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059643 - [wpt-sync] Update web-platform-tests to 297c52e229606070194d3b39f872ecfdd610b858, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 297c52e229606070194d3b39f872ecfdd610b858\nwpt-type: landing\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/speculation_rules_prefetch.https.sub.window.js.ini", "testing/web-platform/meta/cookiestore/cookieStore_set_arguments.https.any.js.ini", "testing/web-platform/meta/css/css-animations/animation-duration-infinite.html.ini", "testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini", "testing/web-platform/meta/css/css-image-animation/image-animation-paused-exact-frame.html.ini", "testing/web-platform/meta/css/css-view-transitions/window-resize-aborts-transition.html.ini", "testing/web-platform/meta/dom/events/scrolling/scrollend-fires-to-text-input.html.ini", "testing/web-platform/meta/fetch/compression-dictionary/compressed-large-resources-001.tentative.https.html.ini", "testing/web-platform/meta/fetch/compression-dictionary/compressed-large-resources-002.tentative.https.html.ini", "testing/web-platform/meta/html/browsers/browsing-the-web/back-forward-cache/broadcastchannel/dedicatedworker.tentative.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-properties.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-defaults.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-popup-behavior.html.ini", "testing/web-platform/meta/html/canvas/element/manual/draw-element-image/privacy/svg-mask-nested-filter.tentative.ht