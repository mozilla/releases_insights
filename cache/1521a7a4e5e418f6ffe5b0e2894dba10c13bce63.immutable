nts": ["dd0efc79d718fd77a850ff91e5631f8d61115339"], "node": "f525bfbe9e4e33a6ae6be9541e916abba64fb121", "parents": ["d8902026bf5a4ba82236b2f86ad6d52f902ec6de"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2051361 - Add a chat history entry point to the Smart Window assistant. r=fluent-reviewers,desktop-theme-reviewers,gcardieri,dao,bolsson\n\nSidebar: a \"...\" button next to New chat opens a menu that navigates in place from a main view - Chat history and Smart Window settings - to a chat history subview listing recent chats plus a shortcut to all chats.\n\nFullpage: a labeled top-actions row - New chat, Chat history, and More. Chat history opens a dropdown of recent chats and a \"View all chats\" shortcut; More holds Smart Window settings.\n\nRecent chats are tab-specific: selecting one switches to its tab if open, otherwise reopens it in a new tab. \"View all chats\" opens the Chats section of Firefox View.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313089\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-history-menu/smartwindow-history-menu.css", "browser/components/aiwindow/ui/components/smartwindow-history-menu/smartwindow-history-menu.mjs", "browser/components/aiwindow/ui/components/smartwindow-history-menu/smartwindow-history-menu.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AIWindowMenu.sys.mjs", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/ChatMessage.sys.mjs", "browser/components/aiwindow/ui/modules/ChatSql.sys.mjs", "browser/components/aiwindow/ui/modules/ChatStore.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_history_menu.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_new_chat_button.js", "browser/locales/en-US/browser/aiWindow.ftl"], "git_node": "99b7171a57c5b9f55aa70ea3093bb1a279517f3a", "git_parents": ["c4ee1e9c28ef0fad37213d378a6041de1ec4c89b"], "node": "60276c1f80d2452b66f3106b9a3b51bec9fc1b07", "parents": ["f525bfbe9e4e33a6ae6be9541e916abba64fb121"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Green up browser_inputHistory.js on the message path. r=mbeier,urlbar-reviewers\n\nEnter on a tab-switch result switches tabs and records the adaptive-history\nengagement parent-side, so both are async over the actor message path. The test\nasserted the switched tab synchronously right after the key (and, downstream,\nthe updated adaptive ordering on the next query). Await the TabSelect event\nbefore asserting. Test-only; direct path behavior-neutral.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313688\n", "files": ["browser/components/urlbar/tests/browser-tabs/browser_inputHistory.js"], "git_node": "ceb2f42049196104287316dc0d4c2458cd00dd95", "git_parents": ["99b7171a57c5b9f55aa70ea3093bb1a279517f3a"], "node": "0f9b9b5ed2c875a6f8eb62fd705b01a9e525f31f", "parents": ["60276c1f80d2452b66f3106b9a3b51bec9fc1b07"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2003181 - Remove unused dom.security.credentialmanagement.chooser.testing.enabled pref r=gregp\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314245\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "81e9a46c4d774c387ddb3ef0f5204e5f64801374", "git_parents": ["ceb2f42049196104287316dc0d4c2458cd00dd95"], "node": "e0987b675cb72ac8785991f5613b551240214c91", "parents": ["0f9b9b5ed2c875a6f8eb62fd705b01a9e525f31f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Don't let a deferred-Enter's late caret reset clobber the next search. r=mbeier\n\nOn a deferred-Enter load the keyup handler awaits the load then focusBrowser,\nand on success resets the caret to (0,0) to keep the domain visible.\nfocusBrowser round-trips over the actor, so on the message path that reset can\nland after the user has already begun a fresh search in the same input,\ncollapsing its caret; autofill's first-result guard\n(selectionEnd == _lastSearchString.length) then bails and the typed string\nisn't autofilled.\n\nThe load's own search and a newer search are indistinguishable by input state\n(same value, same pageproxystate), so the decision keys on history instead: an\ninput-epoch counter, bumped on each input-driven search and snapshotted on the\ndeferred-Enter, lets the keyup reset the caret only when no fresher search has\nrun since. browser_enter.js's searchOnEnterSoon relies on the reset still\nhappening for the load's own search, which this preserves.\n\nBehavior-neutral on the direct path, where focusBrowser resolves synchronously\nand the reset lands before any new search. Greens up browser_canonize.js on the\nmessage path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313689\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "8af91b8c5d5bdbe1d3b99cb3b0f9b7539cd5850c", "git_parents": ["81e9a46c4d774c387ddb3ef0f5204e5f64801374"], "node": "a5722788159856fec417eb82e83c69379b7d0934", "parents": ["e0987b675cb72ac8785991f5613b551240214c91"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053759 - Make it possible import UrlbarPrefs into non-chrome content. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312735\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarContentPrefs.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/jar.mn", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "4c89155a6a0f560e120516200bf0b3a9a573d51f", "git_parents": ["8af91b8c5d5bdbe1d3b99cb3b0f9b7539cd5850c"], "node": "70daf33c45aa331f20776cd1715637f2a5dfdb63", "parents": ["a5722788159856fec417eb82e83c69379b7d0934"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057227 - Use IPC for the search engine store. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313769\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SearchEngineStore.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "eba2411bb426dd3ae8c902274c6b1b2e802b9386", "git_parents": ["4c89155a6a0f560e120516200bf0b3a9a573d51f"], "node": "a6c7c8e7c4337fde6fffefd4d4d8ba275241cd33", "parents": ["70daf33c45aa331f20776cd1715637f2a5dfdb63"], "tags": []}, {"author": "rnvannatta \u003crnvannatta@gmail.com\u003e", "branch": "default", "desc": "Bug 2052617 - Fix off by one error in YuvStamper::WriteDigit. r=webrtc-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com