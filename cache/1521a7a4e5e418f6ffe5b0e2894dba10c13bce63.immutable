.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-subgrid-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-subgrid-005.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/column-grid-lanes-item-baseline-subgrid-006.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-container-baseline-subgrid-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-subgrid-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-subgrid-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-subgrid-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-subgrid-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-subgrid-005.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/baseline/row-grid-lanes-item-baseline-subgrid-006.html.ini"], "git_node": "45c33fcfb954e353b4acd52a7e2f5e119a76518a", "git_parents": ["f8d00765428402e78a2dba0028d83b6a1836f6f3"], "node": "3afe8af680b11cbcf5f7971e286cb6422055b944", "parents": ["21219c861ed0cfa5b426f51d8401040db251b65c"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2060986 [wpt PR 61759] - Don't reuse base style with 'display: none' when animating display, a=testonly\n\nAutomatic update from web-platform-tests\nDon't reuse base style with 'display: none' when animating display\n\nCompanion to the condition in StyleResolverState::LoadPendingResources.\nIf the base style is created before the element is transition/animated\nwe may have created a ComputedStyle with a StylePendingImage.\n\nExtend the test from issue 496524440, because the minimized testcase\nfrom this bug matches it exactly.\n\nFixed: 525810815\nChange-Id: Iaadc3819b860c51098c6d679b0cdd60ed3a2c35b\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8130898\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nAuto-Submit: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1674165}\n\n--\n\nwpt-commits: 84c16aad5c90f65df31c02829564c29d28579db2\nwpt-pr: 61759\n", "files": ["testing/web-platform/tests/css/css-transitions/top-layer-background-image-transition-crash.html", "testing/web-platform/tests/css/css-transitions/top-layer-image-transition-crash.html"], "git_node": "a11391b7ce5b809c7e0eda650ceae9e9a92623a1", "git_parents": ["45c33fcfb954e353b4acd52a7e2f5e119a76518a"], "node": "daa15ece77e54c1d14ba7fd644dd6aae0864f2bb", "parents": ["3afe8af680b11cbcf5f7971e286cb6422055b944"], "tags": []}, {"author": "Joey Arhar \u003cjarhar@chromium.org\u003e", "branch": "default", "desc": "Bug 2060988 [wpt PR 61758] - Fix corners in listbox-abspos-descendant.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix corners in listbox-abspos-descendant.html\n\nThis reftest was failing due to mismatching pixels at the corners of the\nselect element. By removing the border-radius of both the main file and\nthe reference, they now match exactly.\n\nFixed: 540308352\nChange-Id: Ia7a88a97998762dbbed984907a775c113aea1998\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8186428\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1674209}\n\n--\n\nwpt-commits: d6575c644c2f4a1c92361461bd9a55e414cfb132\nwpt-pr: 61758\n", "files": ["testing/web-platform/tests/html/rendering/bindings/the-select-element-0/listbox-abspos-descendant-ref.html", "testing/web-platform/tests/html/rendering/bindings/the-select-element-0/listbox-abspos-descendant.html"], "git_node": "c14294f54e17b3bfdb3427b5ee9218b85319855a", "git_parents": ["a11391b7ce5b809c7e0eda650ceae9e9a92623a1"], "node": "6bc83766a17dceded4feb5ad9721c33fd901d236", "parents": ["daa15ece77e54c1d14ba7fd644dd6aae0864f2bb"], "tags": []}, {"author": "Marcos C\u00e1ceres \u003ccaceres_m@apple.com\u003e", "branch": "default", "desc": "Bug 2014339 [wpt PR 57557] - Digital Credentials: require both mdoc and signed OpenID4VP protocols, a=testonly\n\nAutomatic update from web-platform-tests\nDigital Credentials: require both mdoc and signed OpenID4VP protocols (#57557)\n\n* Digital Credentials: at least one presentation protocol is supported\n\n* Fix assertion messages\n\n* Link correct PR\n\n* Digital Credentials: require both mdoc and signed OpenID4VP protocols\n\n* Apply suggestion from @marcoscaceres\n--\n\nwpt-commits: fb0a674ef8f5253664bc89b8c345a452ad6c18cb\nwpt-pr: 57557\n", "files": ["testing/web-platform/tests/digital-credentials/user-agent-allows-protocol.https.html"], "git_node": "f0378effdcfdc3c5fce4813623e29f578a67df9b", "git_parents": ["c14294f54e17b3bfdb3427b5ee9218b85319855a"], "node": "eba1d5dbc5c38fd05d4f953a19854a186c6d1811", "parents": ["6bc83766a17dceded4feb5ad9721c33fd901d236"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014339 [wpt PR 57557] - Update wpt metadata, a=testonly\n\nwpt-pr: 57557\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/digital-credentials/user-agent-allows-protocol.https.html.ini"], "git_node": "d972657b73d6189506f9f101d3800cf241d6a852", "git_parents": ["f0378effdcfdc3c5fce4813623e29f578a67df9b"], "node": "c087260f1b9d22eef2e87a0aa1b983f234315630", "parents": ["eba1d5dbc5c38fd05d4f953a19854a186c6d1811"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2060995 [wpt PR 61764] - Remove stray closing tags from anchor transition WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove stray closing tags from anchor transition WPTs\n\nRemove closing script tags that incorrectly follow help link elements.\n\nBug: 542686202\nChange-Id: I6116f1da03a1d40554b311b5ef7ec22ae345d0c4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8190777\nReviewed-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1674257}\n\n--\n\nwpt-commits: 25a3469620f29c090eeb4206fe5036b00b0f8697\nwpt-pr: 61764\n", "files": ["testing/web-platform/tests/css/css-anchor-position/anchor-transition-001.html", "testing/web-platform/tests/css/css-anchor-position/anchor-transition-002.html", "testing/web-platform/tests/css/css-anchor-position/anchor-transition-003.html"], "git_node": "0af0f48105f07dff2c408c61ffed7323ffd7d1e2", "git_parents": ["d972657b73d6189506f9f101d3800cf241d6a852"], "node": "991b0b72453189182103c3d1ef604ebcb7f4ebe5", "parents": ["c087260f1b9d22eef2e87a0aa1b983f234315630"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2060996 [wpt PR 61765] - Fix button markup in focus-visible WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nFix button markup in focus-visible WPTs\n\nClose the test buttons with matching tags so later focus targets remain\nsibling elements instead of button descendants.\n\nBug: 542686202\nChange-Id: I051cdb3f46225cf8456e7ae8ac0c9366df19deca\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8194513\nReviewed-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Ana Sollano Kim \u003cansollan@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1674268}\n\n--\n\nwpt-commits: 10aa6d6db38a185f55742b339f8efe9c7b344c18\nwpt-pr: 61765\n", "files": ["testing/web-platform/tests/css/selectors/focus-visible-003.html", "testing/web-platform/tests/css/selectors/focus-visible-004.html"], "git_node": "ead77febccf01268d2f714669057f3ee5ad6ad0e", "git_parents": ["0af0f48105f07dff2c408c61ffed7323ffd7d1e2"], "node": "2733dc433f792cc836498681e2574aeb3568f548", "parents": ["991b0b72453189182103c3d1ef604ebcb7f4ebe5"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2060998 [wpt PR 61766] - Fix mismatched tag in custom-highlight-painting-below-grammar.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix mismatched tag in custom-highlight-painting-below-grammar.html\n\nThe `\u003cspan\u003e` element was incorrectly closed with a `\u003c/div\u003e`. Change it\nto the matching `\u003c/span\u003e`.\n\nBug: 542686202\nChange-Id: If8cef3b803ece167dc51f82ec32adcc30ca2ad9e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8196845\nReviewed-by: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nReviewed-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1674294}\n\n--\n\nwpt-commits: 30daff903d8baa919a63e75302dd51a5dca1261c\nwpt-pr: 61766\n", "files": ["testing/web-platform/tests/css/css-highlight-api/painting/custom-highlight-painting-below-grammar.html"], "git_node": "df0dfae89357f242703c84f437d8a79fd0e938db", "git_parents": ["ead77febccf01268d2f714669057f3ee5ad6ad0e"], "node": "2f1768f09563cdc70b39b6c311bbb62e5de1b139", "parents": ["2733dc433f792cc836498681e2574aeb3568f548"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2060403 [wpt PR 61700] - Implement text-decoration-inset painting in Blink, a=testonly\n\nAutomatic update from web-platform-tests\nImplement text-decoration-inset painting in Blink\n\nUse the text-decoration-inset style data when painting text decorations,\nincluding inline fragment boundary handling for sliced and cloned boxes.\nAdd coverage for SVG fragments and remove the WPT expectations for the\nnow-supported rendering cases.\n\nBug: 468928416, 498974811\nLow-Coverage-Reason: COVERAGE_UNDERREPORTED The uncovered area is a straightforward TextDecorationInset equality check; behavior is covered by Blink/WPT tests.\nBinary-Size: Size increase is unavoidable\nChange-Id: Ieea054f3d65a11eee05b9461728d1b30c18989e0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7748204\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1674336}\n\n--\n\nwpt-commits: b02e6de3b783a7d4612744c8ab268ee4005c6b98\nwpt-pr: 61700\n", "files": ["testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-svg-fragment-001-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-svg-fragment-002-ref.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-003.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-007.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-008.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-009.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-011.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-014.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-svg-fragment-001.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-svg-fragment-002.html"], "git_node": "306dedd15356d9ddceb3ce24990bb1ad4f86c192", "git_parents": ["df0dfae89357f242703c84f437d8a79fd0e938db"], "node": "13d8ea810d1eb79d9bc9f41c506c899cff993ad1", "parents": ["2f1768f09563cdc70b39b6c311bbb62e5de1b139"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060403 [wpt PR 61700] - Update wpt metadata, a=testonly\n\nwpt-pr: 61700\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text-decor/text-decoration-inset-svg-fragment-001.html.ini", "testing/web-platform/meta/css/css-text-decor/text-decoration-inset-svg-fragment-002.html.ini"], "git_node": "5d904b96076754389dc4462ec5a5d957cc58b5ce", "git_parents": ["306dedd15356d9ddceb3ce24990bb1ad4f86c192"], "node": "6b624a609d3d0748f2b90532bf32cf92a2c380d6", "parents": ["13d8ea810d1eb79d9bc9f41c506c899cff993ad1"], "tags": []}, {"author": "Helmut Januschka \u003chelmut@januschka.com\u003e", "branch": "default", "desc": "Bug 2060557 [wpt PR 61721] - Resolve text-decoration-inset overflow and percentages precisely, a=testonly\n\nAutomatic update from web-platform-tests\nResolve text-decoration-inset overflow and percentages precisely\n\nReplace the conservative text-decoration-inset ink overflow bounds with\nexact bounds: overflow computation now receives the same fragment\ncontext as painting (a line cursor positioned at the current fragment\nplus its neighboring fragments), so inset trims and expansions match\nthe painted decoration exactly. Conservative bounds remain for\nmarker-driven highlight overflow paths: text-decoration-inset is valid\non highlight pseudo styles, but those paths have no fragment context.\n\nPercentage insets with box-decoration-break: slice now resolve against\nthe total inline size of the decorated run instead of the individual\nfragment, by walking the fragment chain in both directions, across\nsoft-wrapped lines and forced breaks inside the run. Run-edge trims\ncarry into following or preceding fragments when they exceed a fragment\nsize, which makes the previously failing WPT tests\ntext-decoration-inset-028 and -030 pass.\n\nAdd unit coverage for run-based percentage resolution and inset\naccumulation, WPT reftests for single-line and wrapped fragmented runs,\nand a WPT invalidation reftest that adds and removes insets (including\nnegative insets extending beyond the text) after the initial paint.\n\nBug: 539095434, 498974811\nBinary-Size: Size increase is unavoidable\nChange-Id: I56187b052f7e3eadd8cf7eaf5410772d6edc7491\nFixed: 539095434\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8148940\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\nCr-Commit-Position: refs/heads/main@{#1674338}\n\n--\n\nwpt-commits: 1cdb13f217f91c3cb1240c1edff05d16462ddfe0\nwpt-pr: 61721\n", "files": ["testing/web-platform/tests/css/css-text-decor/invalidation/reference/text-decoration-inset-invalidation-ref.html", "testing/web-platform/tests/css/css-text-decor/invalidation/text-decoration-inset-invalidation.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-percentage-slice-multiline-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-decoration-inset-percentage-slice-ref.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-percentage-slice-multiline.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-inset-percentage-slice.html"], "git_node": "bb7cf95351dd6464547d604287dba83a2300fd66", "git_parents": ["5d904b96076754389dc4462ec5a5d957cc58b5ce"], "node": "eee85249974f177f8a685c5a02b96e0971d392b7", "parents": ["6b624a609d3d0748f2b90532bf32cf92a2c380d6"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060557 [wpt PR 61721] - Update wpt metadata, a=testonly\n\nwpt-pr: 61721\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-text-decor/text-decoration-inset-percentage-slice.html.ini"], "git_node": "4aa596a6372f34b9df5750b1a72802c8577c29aa", "git_parents": ["bb7cf95351dd6464547d604287dba83a2300fd66"], "node": "0e123abf51deea188cad3a290e62f1f6e8d4f6b3", "parents": ["eee85249974f177f8a685c5a02b96e0971d392b7"], "tags": []}, {"author": "Ravjit Uppal \u003cravjit@chromium.org\u003e", "branch": "default", "desc": "Bug 2061004 [wpt PR 61763] - [CE] Update setConstraints() for single track capability elements, a=testonly\n\nAutomatic update from web-platform-tests\n[CE] Update setConstraints() for single track capability elements\n\nThis CL separates the IDL setConstraints method signatures for\n\u003ccamera\u003e/\u003cmicrophone\u003e (MediaTrackConstraintSet) vs \u003cusermedia\u003e\n(HTMLMediaStreamConstraints) while consolidating internal storage and\nsanitization. Key changes:\n- Binds both IDL partial interfaces to MediaCaptureElementConstraints via [ImplementedAs].\n- Unifies constraint storage and track sanitization across all media capture elements on HTMLMediaCaptureElementBase.\n- Adds unit tests and WPTs for track isolation and constraint sanitization.\n\nBug: 538120587\nChange-Id: I957025af6202b5541a3de563f66af50e5a4da199\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8142265\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Ravjit Uppal \u003cravjit@chromium.org\u003e\nReviewed-by: Thomas Nguyen \u003ctungnh@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1674340}\n\n--\n\nwpt-commits: 921306ffd6e52ba7d2aeb3396f72e79e88a54a0b\nwpt-pr: 61763\n", "files": ["testing/web-platform/tests/html/semantics/permission-element/camera/camera-set-constraints.tentative.https.html", "testing/web-platform/tests/html/semantics/permission-element/microphone/microphone-set-constraints.tentative.https.html", "testing/web-platform/tests/html/semantics/permission-element/usermedia/usermedia-set-constraints-sanitization.tentative.https.html"], "git_node": "eec13f33607cd5ea15f53c2dcfae909cf4318b52", "git_parents": ["4aa596a6372f34b9df5750b1a72802c8577c29aa"], "node": "cc4ad559e0ee67387a0d4ac17d5e7aeb6afd4157", "parents": ["0e123abf51deea188cad3a290e62f1f6e8d4f6b3"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061004 [wpt PR 61763] - Update wpt metadata, a=testonly\n\nwpt-pr: 61763\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/permission-element/camera/camera-set-constraints.tentative.https.html.ini", "testing/web-platform/meta/html/semantics/permission-element/microphone/microphone-set-constraints.tentative.https.html.ini", "testing/web-platform/meta/html/semantics/permission-element/usermedia/usermedia-set-constraints-sanitization.tentative.https.html.ini"], "git_node": "2c8c23794d072dc410912f7d6707658a68a835f7", "git_parents": ["eec13f33607cd5ea15f53c2dcfae909cf4318b52"], "node": "a2bc2c02a9580e10e243b68d0a993276f3929c80", "parents": ["cc4ad559e0ee67387a0d4ac17d5e7aeb6afd4157"], "tags": []}, {"author": "Basuke Suzuki \u003cb_suzuki@apple.com\u003e", "branch": "default", "desc": "Bug 2060744 [wpt PR 61741] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320390, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320390\n\n--\n\nwpt-commits: d6a29624d94b5308403f90490a2948a7c1d3b042\nwpt-pr: 61741\n", "files": ["testing/web-platform/tests/webtransport/receive-stream-pull.https.any.js"], "git_node": "5780c4136dd26a39d1c05016ba01366f40999b35", "git_parents": ["2c8c23794d072dc410912f7d6707658a68a835f7"], "node": "17b79a7dc2df80a0db24fe65728c2e4f0a5de611", "paren