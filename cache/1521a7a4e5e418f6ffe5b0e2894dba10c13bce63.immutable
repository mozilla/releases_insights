ts/browser-trustPanel/browser_trust_panel_security_view.js", "browser/components/urlbar/tests/browser-trustPanel/head.js", "browser/components/urlbar/tests/browser/browser.toml", "browser/components/urlbar/tests/browser/browser_trust_panel.js", "browser/components/urlbar/tests/browser/browser_trust_panel_cert_exception.js", "browser/components/urlbar/tests/browser/browser_trust_panel_focus.js", "browser/components/urlbar/tests/browser/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser/browser_trust_panel_pages.js", "browser/components/urlbar/tests/browser/browser_trust_panel_security_view.js", "tools/lint/rejected-words.yml"], "git_node": "156f4b6c9684d95f1988d1c1e9d95fa93fa4f7a1", "git_parents": ["038bfcff7bf12152ff2b458a96cee479d327d599"], "node": "3a6dbc7eab1d8340054a4faecb34618e50262b0a", "parents": ["325feb97bf1cd2fc1bb6dc46cfe206b9750440a4"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045093 - Add arm64 android emulator raptor perf tests. r=perftest-reviewers,mozperftest-reviewers,taskgraph-reviewers,bhearsum,sparky\" for breaking Gecko Decision Task\n\nThis reverts commit 26658d8587374c37f40dd9a0b3f26d1cc5e50f88.\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/kinds/browsertime/kind.yml", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "testing/mozharness/configs/raptor/android_emulator_macosx_config.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/perfdocs/generated/raptor.rst"], "git_node": "26a21dc291809029437710a8ff050293e353d09e", "git_parents": ["156f4b6c9684d95f1988d1c1e9d95fa93fa4f7a1"], "node": "a404318ee90d2d67bdae8f14b181e0b22c67b49d", "parents": ["3a6dbc7eab1d8340054a4faecb34618e50262b0a"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2056609 [wpt PR 61443] - Missing reset of pseudo_element for :nth-*(N of S) matching, a=testonly\n\nAutomatic update from web-platform-tests\nMissing reset of pseudo_element for :nth-*(N of S) matching\n\nWas reset to nullptr in other sub-contexts but the context for matching\nthe selector inside :nth*() selectors was missing this reset causing\noriginating element matching while resolving pseudo element styles fail.\n\nRegression from [1].\n\n[1] https://crrev.com/b0f674daa93af2b73d331057f3618fccf16ae541\n\nBug: 531138929\nChange-Id: I771817836329b898efd503effc25d1fa9461ab90\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8131020\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1665478}\n\n--\n\nwpt-commits: 3bb81af27d1c62ebb9fc80f27e1ee98e60dd6db3\nwpt-pr: 61443\n", "files": ["testing/web-platform/tests/css/selectors/nth-of-selector-before.html"], "git_node": "87efa999368b209d5bec32e7da04304a6a855bbe", "git_parents": ["26a21dc291809029437710a8ff050293e353d09e"], "node": "ee5efa0334c128a7b499acd20b1da7da1c7167be", "parents": ["a404318ee90d2d67bdae8f14b181e0b22c67b49d"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2056418 [wpt PR 61429] - \u003ctemplate for\u003e with empty \"for\" attribute patches \"in place\", a=testonly\n\nAutomatic update from web-platform-tests\n\u003ctemplate for\u003e with empty \"for\" attribute patches \"in place\"\n\n- Added behind a new flag (DeclarativeFragment)\n- When for is empty, we use the template itself as the marker\n- the template is attached at start, and removed when done.\n\nSome existing test has a subtest where the existing behavior is\nasserted. Separated that to own test with .txt expectations.\n\nSee\nhttps://github.com/WICG/declarative-partial-updates/blob/frag-alternatives/fragment-include-explainer.md\n\nChromestatus / I2P:\nhttps://chromestatus.com/feature/5188900898340864\n\nBug: 535664974\nChange-Id: Id691865a6884273eab493bc7b0f6eee153835626\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8116632\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1665490}\n\n--\n\nwpt-commits: a87b6599a08d3e0386e71486305f59745096d31b\nwpt-pr: 61429\n", "files": ["testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/empty-for-streaming.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/template-for-empty.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/template-for-multiple-cases.html"], "git_node": "d2cee576d54bcdd0a27e7b0c5c1e76d0fb7138e0", "git_parents": ["87efa999368b209d5bec32e7da04304a6a855bbe"], "node": "f17ea2e337b8f627564fbf8e214e38ec60b571ed", "parents": ["ee5efa0334c128a7b499acd20b1da7da1c7167be"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056418 [wpt PR 61429] - Update wpt metadata, a=testonly\n\nwpt-pr: 61429\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/empty-for-streaming.html.ini"], "git_node": "e849c8330247f69455fd23645b58f73e32b8d36c", "git_parents": ["d2cee576d54bcdd0a27e7b0c5c1e76d0fb7138e0"], "node": "0ddc7e97cefb6ec28329ff42cc59a59f6db52ce3", "parents": ["f17ea2e337b8f627564fbf8e214e38ec60b571ed"], "tags": []}, {"author": "Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2056431 [wpt PR 61433] - [css-mixins] Make @apply and @contents rules StyleRuleGroups, a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Make @apply and @contents rules StyleRuleGroups\n\n@apply and @contents carry child rules but extended StyleRuleBase,\nstashing them on a throwaway \"fake parent\" StyleRule. This CL makes them\nextend StyleRuleGroup, owning their children directly and joining\nDowncastTraits\u003cStyleRuleGroup\u003e and continuing the work from CL:7755161.\n\nThis is a behavior-preserving refactor. A web test was added confirming\nthat an empty `@apply --foo {}` block suppresses the mixin's @contents\nfallback, while `@apply --foo;` still lets it apply.\n\nChange-Id: I033b0d0b0e6d399152cb6ce3e1ac4dfd0c563c48\nFixed: 502048295\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8114919\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1665525}\n\n--\n\nwpt-commits: 7aae0c90c727e7184fb4b20754e1d2fd5abaae10\nwpt-pr: 61433\n", "files": ["testing/web-platform/tests/css/css-mixins/mixins/contents-rule.html"], "git_node": "36faeb443d57f0c77fd46bcd71fb391c67c3723d", "git_parents": ["e849c8330247f69455fd23645b58f73e32b8d36c"], "node": "0798d445ec826765d200c31063a111c07d60ac4d", "parents": ["0ddc7e97cefb6ec28329ff42cc59a59f6db52ce3"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056431 [wpt PR 61433] - Update wpt metadata, a=testonly\n\nwpt-pr: 61433\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-mixins/mixins/contents-rule.html.ini"], "git_node": "46607327fae77bdf53f9330b91d79f93c92b7030", "git_parents": ["36faeb443d57f0c77fd46bcd71fb391c67c3723d"], "node": "df2888aed41bfd4227027da4bdd8c7bd639c496c", "parents": ["0798d445ec826765d200c31063a111c07d60ac4d"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2056612 [wpt PR 61444] - Fix outline painting crash with \u003carea\u003e outside flat tree, a=testonly\n\nAutomatic update from web-platform-tests\nFix outline painting crash with \u003carea\u003e outside flat tree\n\nWith GetComputedStyleOutsideFlatTree disabled, EnsureComputedStyle()\nreturns nullptr ComputedStyle for elements outside the flat tree\n(non-slotted host children).\n\nThis is a regression from when we allowed computing non-empty styles\noutside the flat tree, but neither Firefox, nor Safari, picks up this\noutline color.\n\nBug: 531745321\nChange-Id: I61bbce0ade10e057f0024d5cb190476db29032ef\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8126000\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1665545}\n\n--\n\nwpt-commits: 3b2b4dae970ca8c0964e208c7af7221f58ea5ab4\nwpt-pr: 61444\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-area-element/chrome-531745321-crash.html"], "git_node": "dea9399693fefa5f2e85dcd15db45991a97639ef", "git_parents": ["46607327fae77bdf53f9330b91d79f93c92b7030"], "node": "745190d56caae475351cda80ae86e3f583de0c42", "parents": ["df2888aed41bfd4227027da4bdd8c7bd639c496c"], "tags": []}, {"author": "Joanne Pan \u003c71951015+J0pan@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2055428 [wpt PR 61326] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319297, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=319297 (#61326)\n--\n\nwpt-commits: 214c257171cf2623369617568d0a64b9871afd3f\nwpt-pr: 61326\n", "files": ["testing/web-platform/tests/css/css-values/random-item-computed.html"], "git_node": "b01fc0b91ddd528585092378882a570c1fab2d2a", "git_parents": ["dea9399693fefa5f2e85dcd15db45991a97639ef"], "node": "a0e2c0b6dec85a33b3f05c3fe16f32ccccf488f9", "parents": ["745190d56caae475351cda80ae86e3f583de0c42"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055428 [wpt PR 61326] - Update wpt metadata, a=testonly\n\nwpt-pr: 61326\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/random-item-computed.html.ini"], "git_node": "5f353cdec6f5e54dc061dbde21789577eca5781a", "git_parents": ["b01fc0b91ddd528585092378882a570c1fab2d2a"], "node": "920161cd001cf53b95c747073476e707b91ac051", "parents": ["a0e2c0b6dec85a33b3f05c3fe16f32ccccf488f9"], "tags": []}, {"author": "Tyler Wilcock \u003ctyler_w@apple.com\u003e", "branch": "default", "desc": "Bug 2038404 [wpt PR 59768] - Add aamtest support for Safari, implement AXAPI tests, a=testonly\n\nAutomatic update from web-platform-tests\nAdd aamtest support for Safari and WebKit, implement AXAPI tests (#59768)\n\nThis commit registers the aamtest test type with PytestExecutor for\nSafari, and implements test_axapi for:\n  - role/button.py\n  - role/button_haspopup.py\n  - role/button_pressed.py\n  - attribute/aria_braillelabel.py\n  - attribute/aria_error_message.py\n--\n\nwpt-commits: e917a41e0ff132df331c18fee1396a00f27f2ba5\nwpt-pr: 59768\n", "files": ["testing/web-platform/tests/core-aam/aamtests/attribute/aria_braillelabel.py", "testing/web-platform/tests/core-aam/aamtests/attribute/aria_error_message.py", "testing/web-platform/tests/core-aam/aamtests/role/button.py", "testing/web-platform/tests/core-aam/aamtests/role/button_haspopup.py", "testing/web-platform/tests/core-aam/aamtests/role/button_pressed.py", "testing/web-platform/tests/core-aam/aamtests/support/axapi_wrapper.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/safari.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/webkit.py"], "git_node": "b9f2310b07b92504daa75a0f4653e055bbd8593a", "git_parents": ["5f353cdec6f5e54dc061dbde21789577eca5781a"], "node": "580e1301036b91985250f99a2402d4f54209c5fa", "parents": ["920161cd001cf53b95c747073476e707b91ac051"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2056685 [wpt PR 61456] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=301807, a=testonly\n\nAutomatic upd