utomated/WEB_FEATURES.yml", "testing/web-platform/tests/workers/semantics/encodings/WEB_FEATURES.yml", "testing/web-platform/tests/workers/semantics/interface-objects/WEB_FEATURES.yml", "testing/web-platform/tests/workers/semantics/multiple-workers/WEB_FEATURES.yml", "testing/web-platform/tests/workers/semantics/navigation/WEB_FEATURES.yml", "testing/web-platform/tests/workers/semantics/reporting-errors/WEB_FEATURES.yml", "testing/web-platform/tests/workers/semantics/run-a-worker/WEB_FEATURES.yml", "testing/web-platform/tests/workers/semantics/xhr/WEB_FEATURES.yml", "testing/web-platform/tests/xhr/WEB_FEATURES.yml", "testing/web-platform/tests/xml/xslt/WEB_FEATURES.yml"], "git_node": "238b6d79170360e059921b627c0effefca6b5d7a", "git_parents": ["a3541d456330791d94cd9b7d8f1322c3de4956a4"], "node": "c771b48d853313414077b440c6cf51ca5e15b56b", "parents": ["ddfbab92485f420d48e892550d6c54765cb7800c"], "tags": []}, {"author": "Xiaochen Zhou \u003cxiaochenzh@chromium.org\u003e", "branch": "default", "desc": "Bug 2056715 [wpt PR 61460] - [Connection-Allowlist] Add web platform tests for connection allowlist enforcement on PaymentRequest API: service worker registration, a=testonly\n\nAutomatic update from web-platform-tests\n[Connection-Allowlist] Add web platform tests for connection allowlist enforcement on PaymentRequest API: service worker registration\n\nThe web platform tests cover the service worker registration behavior\nwhen there is a connection allowlist on the initiator frame of PaymentRequest API.\n\nRequests flow:\n1. PaymentRequest API sends a HEAD request to payment url.\n2. A response with Link header pointing to the app manifest is\n   sent back.\n3. The API downloads the app manifest.\n4. The app registers a service worker.\n\nThe test sets up allowlist to either block or allow the registration.\n\nAbout CA: https://github.com/WICG/connection-allowlists\n\nBug: 519915328, 447954811, 506480941\nChange-Id: I6f7b8f39e6227404242c22d24fee5c2992c50f10\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8012329\nCommit-Queue: Xiaochen Zhou \u003cxiaochenzh@chromium.org\u003e\nReviewed-by: Andrew Verge \u003caverge@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1668628}\n\n--\n\nwpt-commits: 177f223ecdb4595572b01c4e9cf61de4e7b5465a\nwpt-pr: 61460\n", "files": ["testing/web-platform/tests/connection-allowlist/tentative/payment-app-manifest.json", "testing/web-platform/tests/connection-allowlist/tentative/payment-app-manifest.json.headers", "testing/web-platform/tests/connection-allowlist/tentative/payment-app-sw.js", "testing/web-platform/tests/connection-allowlist/tentative/payment-request-sw-registration-allowed.https.window.js", "testing/web-platform/tests/connection-allowlist/tentative/payment-request-sw-registration-allowed.https.window.js.headers", "testing/web-platform/tests/connection-allowlist/tentative/payment-request-sw-registration-blocked.https.window.js", "testing/web-platform/tests/connection-allowlist/tentative/payment-request-sw-registration-blocked.https.window.js.headers"], "git_node": "874da2fd4dfce930dde6f10438b6b1b400b48c0d", "git_parents": ["238b6d79170360e059921b627c0effefca6b5d7a"], "node": "e8c0234c7681ef72be1ba551d9b16ba3cfb8aac4", "parents": ["c771b48d853313414077b440c6cf51ca5e15b56b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056715 [wpt PR 61460] - Update wpt metadata, a=testonly\n\nwpt-pr: 61460\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/payment-request-sw-registration-allowed.https.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/payment-request-sw-registration-blocked.https.window.js.ini"], "git_node": "060260a9ad4cd5f0def4439b4a51a9f2fc8e813d", "git_parents": ["874da2fd4dfce930dde6f10438b6b1b400b48c0d"], "node": "a99f65e62f2eb74155755a73c179b4970159b0bd", "parents": ["e8c0234c7681ef72be1ba551d9b16ba3cfb8aac4"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2057773 [wpt PR 61531] - Support \u003ctemplate for=\"...\" buffer\u003e, a=testonly\n\nAutomatic update from web-platform-tests\nSupport \u003ctemplate for=\"...\" buffer\u003e\n\nThe \"buffer\" boolean attribute makes it so that the template content\nstreams into the template, and only applies to the target as a patch\nonce the template is done.\n\nDuring streaming, the content is available in template.content.\n\n(behind the DeclalrativeFragment flag)\n\nBug: 535664974\nChange-Id: I2ca998553e26725bb8e488f08efe2e196b2d080a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8124335\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1668718}\n\n--\n\nwpt-commits: aeec70fdf67b70fcff2efb33da0a6fd2cdb51102\nwpt-pr: 61531\n", "files": ["testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/buffer-immutability.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/buffer-in-place.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/buffer-mutation-observer.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/buffer-reflection.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/buffer-streaming-reflection.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/buffer-streaming-reflection.py", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/buffer-targeted.html", "testing/web-platform/tests/html/dom/partial-updates/tentative/fragment/streaming-target-marker-removed.html"], "git_node": "bb55e1ee55117d79a8f201dc88a0d17f4b0e5379", "git_parents": ["060260a9ad4cd5f0def4439b4a51a9f2fc8e813d"], "node": "280d1837e0f7d0c576309e77f763e6a35488f155", "parents": ["a99f65e62f2eb74155755a73c179b4970159b0bd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057773 [wpt PR 61531] - Update wpt metadata, a=testonly\n\nwpt-pr: 61531\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/buffer-immutability.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/buffer-in-place.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/buffer-mutation-observer.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/buffer-reflection.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/buffer-streaming-reflection.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/buffer-targeted.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/fragment/streaming-target-marker-removed.html.ini"], "git_node": "a9296020cfb5004b915c49dd15921dfe4a2c04a6", "git_parents": ["bb55e1ee55117d79a8f201dc88a0d17f4b0e5379"], "node": "f17e8e29578e28ac4e6b1c115356caf6fcb36cb7", "parents": ["280d1837e0f7d0c576309e77f763e6a35488f155"], "tags": []}, {"author": "Mustaq Ahmed \u003cmustaq@google.com\u003e", "branch": "default", "desc": "Bug 2058225 [wpt PR 61549] - Make transitionrun event timing spec-compliant, a=testonly\n\nAutomatic update from web-platform-tests\nMake transitionrun event timing spec-compliant\n\nService the transition event delegate synchronously upon transition\ncreation in CSSAnimations::MaybeApplyPendingUpdate behind the\nEventTimingMatchingHTML flag so that transitionrun event timing is\nspec-compliant with CSS Transitions Level 1:\nhttps://drafts.csswg.org/css-transitions/#transitionrun\n\nTAG=agy\nCONV=20d252d1-f2a2-4994-acf6-67ee89d64665\n\nBug: 397737222\nChange-Id: Ib0f075d0d642076b5277cb3f60f4460973abf374\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8129069\nCommit-Queue: Mustaq Ahmed \u003cmustaq@chromium.org\u003e\nReviewed-by: Kevin Ellis \u003ckevers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1668730}\n\n--\n\nwpt-commits: 5059bfeb1f68db7fcb288a91f5625e77b98ffe70\nwpt-pr: 61549\n", "files": ["testing/web-platform/tests/web-animations/timing-model/timelines/update-and-send-events.html"], "git_node": "eaedb717da9728e3cbd6d0cb24a2ec85fd53ac8e", "git_parents": ["a9296020cfb5004b915c49dd15921dfe4a2c04a6"], "node": "95f03d36cfdc30a59873bff863399b372c5604c4", "parents": ["f17e8e29578e28ac4e6b1c115356caf6fcb36cb7"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2058231 [wpt PR 61550] - [html-in-canvas] Fix missing background color on nested canvases, a=testonly\n\nAutomatic update from web-platform-tests\n[html-in-canvas] Fix missing background color on nested canvases\n\nWhen a layer exists for canvas, CSS background colors were set on the\nlayer. This did not work for nested html-in-canvas where the background\nneeds to be painted into the parent. This bug was only present after\ncalling ctx.reset() because on the initial render, a cc layer does not\nyet exist for the nested canvas, so DrawsBackgroundOntoContentLayer\nreturned false.\n\nFixed: 536346616\nChange-Id: If90fd1ff95438e49e75960996c696fdea2135502\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8149499\nReviewed-by: Stefan Zager \u003cszager@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1668735}\n\n--\n\nwpt-commits: 688f174f5efa277e4a2b6db64893b1dbfecb4600\nwpt-pr: 61550\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-canvas-reset-ref.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/nested-canvas-reset.tentative.html"], "git_node": "c0ba2b3d5f940b0872f73c39d8c7b6f6387ab367", "git_parents": ["eaedb717da9728e3cbd6d0cb24a2ec85fd53ac8e"], "node": "48b25da2560e68c5ae214837d3aa582cf6c774f2", "parents": ["95f03d36cfdc30a59873bff863399b372c5604c4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058231 [wpt PR 61550] - Update wpt metadata, a=testonly\n\nwpt-pr: 61550\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/canvas/element/manual/draw-element-image/nested-canvas-reset.tentative.html.ini"], "git_node": "e39a6daba6155e53227e11625f76572302623438", "git_parents": ["c0ba2b3d5f940b0872f73c39d8c7b6f6387ab367"], "node": "3c8509478fec1dbb36ee20d037720312b2405551", "parents": ["48b25da2560e68c5ae214837d3aa582cf6c774f2"], "tags": []}, {"author": "Anthony Vallee-Dubois \u003canthonyvd@chromium.org\u003e", "branch": "default", "desc": "Bug 2058275 [wpt PR 61552] - Revert \"[sub apps] enable wpt tests\", a=testonly\n\nAutomatic update from web-platform-tests\nRevert \"[sub apps] enable wpt tests\"\n\nThis reverts commit f56a10fc2ca726d6401a1c2232370faa8ce7d740.\n\nReason for revert: New tests fail on some Linux bots\n\nFailure Link: https://ci.chromium.org/ui/p/chromium/builders/ci/Linux%20Tests/184324/overview\n\nOriginal change's description:\n\u003e [sub apps] enable wpt tests\n\u003e\n\u003e Re-enable the tests in third_party/blink/web_tests/external/wpt/subapps.\n\u003e\n\u003e - Use virtual test suits to emulate isolated context with header overrides.\n\u003e - Modernized tests to fit new sub apps API shape.\n\u003e - Remove insecure context test because by definition isolated context cannot be insecure.\n\u003e - Add a test that checks permission policy behavior.\n\u003e\n\u003e Fixed: 40928236\n\u003e Change-Id: Idc3d52c01a5a4cb4f4f588ea8c6011e1e13b4901\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8122238\n\u003e Reviewed-by: Andrew Rayskiy \u003cgreengrape@google.com\u003e\n\u003e Reviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\n\u003e Reviewed-by: Rick Byers \u003crbyers@chromium.org\u003e\n\u003e Commit-Queue: Vlad Krot \u003cvkrot@google.com\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1668571}\n\nBug: 40928236\nNo-Presubmit: true\nNo-Tree-Checks: true\nNo-Try: true\nChange-Id: Icd7537fdea44945284b4f83325c6805ff8886727\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8157180\nOwners-Override: Anthony Vallee-Dubois \u003canthonyvd@chromium.org\u003e\nReviewed-by: Anthony Vallee-Dubois \u003canthonyvd@chromium.org\u003e\nBot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\nAuto-Submit: Anthony Vallee-Dubois \u003canthonyvd@chromium.org\u003e\nCommit-Queue: Anthony Vallee-Dubois \u003canthonyvd@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1668824}\n\n--\n\nwpt-commits: da8d7a45f7393e4b3e075a533bd7f0cb67f4bbc1\nwpt-pr: 61552\n", "files": ["testing/web-platform/tests/interfaces/sub-apps.tentative.idl", "testing/web-platform/tests/resources/chromium/mock-subapps.js", "testing/web-platform/tests/subapps/__dir__.headers", "testing/web-platform/tests/subapps/add-error.tentative.https.html", "testing/web-platform/tests/subapps/add-success.tentative.https.html", "testing/web-platform/tests/subapps/disabled-by-permissions-policy.tentative.https.html", "testing/web-platform/tests/subapps/disabled-by-permissions-policy.tentative.https.html.headers", "testing/web-platform/tests/subapps/insecure-context-error.tentative.html", "testing/web-platform/tests/subapps/list-error.tentative.https.html", "testing/web-platform/tests/subapps/list-success.tentative.https.html", "testing/web-platform/tests/subapps/remove-error.tentative.https.html", "testing/web-platform/tests/subapps/remove-success.tentative.https.html", "testing/web-platform/tests/subapps/resources/subapps-helpers.js"], "git_node": "e2d6e50f067972c8b02811884fb29d21f25092fa", "git_parents": ["e39a6daba6155e53227e11625f76572302623438"], "node": "ff140f6757c1dab255946d7ca5964c6107264b52", "parents": ["3c8509478fec1dbb36ee20d037720312b2405551"], "tags": []}, {"author": "Gaston Rodriguez \u003cgastonr@microsoft.com\u003e", "branch": "default", "desc": "Bug 2057703 [wpt PR 61527] - Drags continue even if the layout shifts on drag start, a=testonly\n\nAutomatic update from web-platform-tests\nDrags continue even if the layout shifts on drag start\n\nThis CL fixes a bug with drag and drop where a drag will not happen if\nthe `dragstart` listener removes the drag source or generates a layout\nshift.\n\nWhen a drag starts, blink will try hit-testing the drag start location\n*after* the `dragstart` event is fired to determine the dragged element\nand create an overlay image for it. If listeners of the `dragstart`\nevent caused a layout shift or removed the element from the document,\nthen the hit test will fail and the drag operation will be aborted.\n\nThis CL reorders the steps in the sequence to create a drag by moving\nthe hit testing and image overlay generation to *before* the `dragstart`\nevent is fired in `PopulateDragDataTransfer`. With this change, even if\n`dragstart` removes an element from the document, the user will still\nbe presented with the correct drag overlay image.\n\nIn addition to the new tests in this CL, these changes were manually\nverified in the WPT remove/ and overlay/ drag and drop directories to\nconfirm correct UA behavior.\n\nBug: 434130455\nChange-Id: I84bab2edb505b113e8a9481109f196d225d77718\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7748202\nReviewed-by: Mustaq Ahmed \u003cmustaq@chromium.org\u003e\nCommit-Queue: Gaston Rodriguez \u003cgastonr@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1668792}\n\n--\n\nwpt-commits: 8e573188890e6d0a5219711afc9bbb5dc5abbd7a\nwpt-pr: 61527\n", "files": ["testing/web-platform/tests/html/editing/dnd/layoutshift/001.html", "testing/web-platform/tests/html/editing/dnd/remove/001.html", "testing/web-platform/tests/html/editing/dnd/remove/001.xhtml", "testing/web-platform/tests/html/editing/dnd/remove/023-manual.html", "testing/web-platform/tests/html/editing/dnd/resources/test-helper.js"], "git_node": "7f304af702c6ffa6c04d702061e20319b5807e8c", "git_parents": ["e2d6e50f067972c8b02811884fb29d21f25092fa"], "node": "bb7d3f2b1106aa3706fa54d7b53a3649f875a6e4", "parents": ["ff140f6757c1dab255946d7ca5964c6107264b52"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057703 [wpt PR 61527] - Update wpt metadata, a=testonly\n\nwpt-pr: 61527\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/editing/dnd/layoutshift/001.html.ini", "testing/web-platform/meta/html/editing/dnd/remove/001.html.ini"], "git_node": "a8603f55f19fd642911e4d107d71f624e370a499", "git_parents": ["7f304af702c6ffa6c04d702061e20319b5807e8c"], "node": "f24a8965bc10320cf003d0d3110ef346b8660a9f", "parents": ["bb7d3f2b1106aa3706fa54d7b53a3649f875a6e4"], "tags": []}, {"author": "Ahmed Moussa \u003cahmedmoussa@google.com\u003e", "branch": "default", "desc": "Bug 2058319 [wpt PR 61555] - Revert \"Fix offset contours for concave corners\", a=testonly\n\nAutomatic update from web-platform-tests\nRevert \"Fix offset contours for concave corners\"\n\nThis reverts commit 0e59b495250929d4295f232e03bba5eab1d5248c.\n\nReason for revert: Causing Failures in Mac13 Test bots\n\nFailure Link: first failing run https://ci.chromium.org/ui/p/chromium/builders/ci/Mac13%20Tests/42210/overview\n\nOriginal change's description:\n\u003e Fix offset contours for concave corners\n\u003e\n\u003e Clamp contour miter intersections to their target edges so asymmetric\n\u003e concave corners do not produce stray outline and shadow segments.\n\u003e\n\u003e Bug: 532190484\n\u003e Change-Id: I29dfa1d4e072f1692f041417892f33ff60dfda39\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8128561\n\u003e Commit-Queue: Helmut Januschka \u003chelmut@januschka.com\u003e\n\u003e Reviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1668453}\n\nBug: 532190484\nNo-Presubmit: true\nNo-Tree-Checks: true\nNo-Try: true\nChange-Id: I4ed8fb2f2afea019be369bcff2c6145da75a80ce\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8158379\nCommit-Queue: Ahmed Moussa \u003cahmedmoussa@google.com\u003e\nBot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\nAuto-Submit: Ahmed Moussa \u003cahmedmoussa@google.com\u003e\nOwners-Override: Ahmed Moussa \u003cahmedmoussa@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1668861}\n\n--\n\nwpt-commits: bf101f78c68620c7b096d6ac01ff86acd9186964\nwpt-pr: 61555\n", "files": ["testing/web-platform/tests/css/css-borders/corner-shape/render-corner-shape.html"], "git_node": "b8d97b93b86e3aa6d893f429853271842ce40724", "git_parents": ["a8603f55f19fd642911e4d107d71f624e370a499"], "node": "31428bc82fef075af3b24c231178304d9442e8ec", "parents": ["f24a8965bc10320cf003d0d3110ef346b8660a9f"], "tags": []}, {"author": "Hongchan Choi \u003chongchan@google.com\u003e", "branch": "default", "desc": "Bug 2058325 [wpt PR 61557] - [WebAudio] Loosen oscillator test thresholds to avoid Mac-11 flakiness, a=testonly\n\nAutomatic update from web-platform-tests\n[WebAudio] Loosen oscillator test thresholds to avoid Mac-11 flakiness\n\nA subtle difference in FFT precision on Mac ARM64 (specifically Mac-11)\ncauses several oscillator tests to fail due to minor sample value\ndiscrepancies.\n\nThis CL loosens the error and SNR thresholds slightly for:\n- osc-negative-freq.html\n- osc-sweep-snr-custom.html\n- osc-sweep-snr-sawtooth.html\n- osc-sweep-snr-sine.html\n- osc-sweep-snr-square.html\n- osc-sweep-snr-triangle.html\n- start-sampling.html\n- osc-basic-waveform.html\n\nAdditionally, updated `osc-basic-waveform.html` to include the\nfrequency in the SNR assertion message to avoid duplicate test names\nwhen they share the same threshold.\n\nTAG=agy\nCONV=f54516f1-0c57-4af3-a490-fb33437bdacb\n\nBug: 40915857\nTest: blink_web_tests\nChange-Id: Idc9232aa5f6583f3474c140153bbf2b186361d81\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8155381\nReviewed-by: Mahesh Kannan \u003ckmaheshb@google.com\u003e\nCommit-Queue: Hongchan Choi \u003chongchan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1668917}\n\n--\n\nwpt-commits: 56b0a9f2255791b7f344af4dbda506cb2c4f9457\nwpt-pr: 61557\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-oscillatornode-interface/osc-basic-waveform.html"], "git_node": "3d8dca287ddc7d16de191ec2525e6eb64e93f806", "git_parents": ["b8d97b93b86e3aa6d893f429853271842ce40724"], "node": "b83d22cb1706cf73633891c86e6780976b4c0875", "parents": ["31428bc82fef075af3b24c231178304d9442e8ec"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2058316 [wpt PR 61554] - Check null for originating element when synchronizing VT rects, a=testonly\n\nAutomatic update from web-platform-tests\nCheck null for originating element when synchronizing VT rects\n\nBug: 522621866\nChange-Id: I8811fc33d376fe7acfcba442c6075bcf0f795ea9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8145860\nAuto-Submit: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCommit-Queue: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1668953}\n\n--\n\nwpt-commits: 5a53ac9ae0347cf923df3cfb03cc1950232cad51\nwpt-pr: 61554\n", "files": ["testing/web-platform/tests/css/css-view-transitions/remove-document-element-crash.html"], "git_node": "45a27323ec19da67bdfd6cf49e2e12adaf53cb44", "git_parents": ["3d8dca287ddc7d16de191ec2525e6eb64e93f806"], "node": "80f0291ea1f7165a44c51ac851b443f63b122cb8", "parents": ["b83d22cb1706cf73633891c86e6780976b4c0875"], "tags": []}, {"author": "Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2058362 [wpt PR 61563] - [css-mixins] Serialize parameterless @mixin without parentheses, a=testonly\n\nAutomatic update from web-platform-tests\n[css-mixins] Serialize parameterless @mixin without parentheses\n\nCSSMixinRule::cssText() always emitted a parenthesized parameter list,\nso a parameterless @mixin serialized as `@mixin --foo() { ... }` even\nwhen it was defined as `@mixin --foo { ... }`.\n\nOmit the parentheses when the mixin has no parameters, per the CSSWG\nresolution:\nhttps://github.com/w3c/csswg-drafts/issues/13015#issuecomment-5026379236\n\nChange-Id: I568170020972374c7da47d85d002dea2e26a7eca\nFixed: 535826284\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8127699\nCommit-Queue: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nReviewed-by: Kevin Babbitt \u003ckbabbitt@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1669061}\n\n--\n\nwpt-commits: 0e6fba5635c1970881ae7bafc6745e730678a959\nwpt-pr: 61563\n", "files": ["testing/web-platform/tests/css/css-mixins/mixins/mixin-cssom.tentative.html", "testing/web-platform/tests/css/css-mixins/mixins/mixin-invalidation.tentative.html"], "git_node": "e50fea0ed0b99e0027685c0d162a64562666e8a7", "git_parents": ["45a27323ec19da67bdfd6cf49e2e12adaf53cb44"], "node": "b8362a31edf95c549e0e184cf1f8e53172ab8f9e", "parents": ["80f0291ea1f7165a44c51ac851b443f63b122cb8"], "tags": []}, {"author": "Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e", "branch": "default", "desc": "Bug 2058352 [wpt PR 61561] - [layout] Fix OOF-positioned margin under-invalidation., a=testonly\n\nAutomatic update from web-platform-tests\n[layout] Fix OOF-positioned margin under-invalidation.\n\nIn crrev.com/c/7812714 we simplified the OOF layout code by making the\nconstraint-space construction the same for the two places where we\ninvoke layout on a non-replaced element.\n\nThis introduced an under-invaldation bug when margins change.\n\nPreviously when a margin changed, we'd calculate a new fixed-block size,\nwhich would cause the cache-miss. Importantly for OOF-positioned we\ndon't mark the layout-object as dirty when a margin changes.\n\nWith the new code we would potentially just compare the\nconstraint-spaces directly (without computing the block-size), causes\nthe incorrect cache-hit.\n\nSkipping the margin layout invalidation likely isn't important for\nreal-world use-cases so just mark a layout object as needing layout for\nthis case.\n\nAdditionally remove the two bespoke field-diffs:\n - \"margin\" just becomes \"layout\" for OOF.\n - \"out-of-flow\" switches to \"inset\", and now we just check if we have\n   non-static position.\n\nBug: 539404705\nChange-Id: If54326af096c8cb30308e7274c515e859760ea9f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8157320\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669065}\n\n--\n\nwpt-commits: f4b24b414258bfdca10fbb0f8d646b97fc6657ec\nwpt-pr: 61561\n", "files": ["testing/web-platform/tests/css/css-position/position-absolute-dynamic-relayout-007.html"], "git_node": "3224787fa4818fe55c5937ce350530497c5af8fa", "git_parents": ["e50fea0ed0b99e0027685c0d162a64562666e8a7"], "node": "cb3273def37e7cef62951b3451c638fdc8ebdd60", "parents": ["b8362a31edf95c549e0e184cf1f8e53172ab8f9e"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2058346 [wpt PR 61559] - Add long timeout to 3 accname tests, a=testonly\n\nAutomatic update from web-platform-tests\nAdd long timeout to 3 accname tests\n\ncomp_label.html, comp_host_language_label.html, and comp_text_node.html\ngenerate many dynamic test cases and can exceed the default 10s\ntestharness timeout.\n\nBug: 443203688\nChange-Id: Iedb17afcfc7ddc4c00011644c31323644e61da6d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8129542\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nReviewed-by: David Tseng \u003cdtseng@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669116}\n\n--\n\nwpt-commits: 1bf8e08a1d1e098cdeaf26f64965b67dd97879f0\nwpt-pr: 61559\n", "files": ["testing/web-platform/tests/accname/name/comp_host_language_label.html", "testing/web-platform/tests/accname/name/comp_label.html", "testing/web-platform/tests/accname/name/comp_text_node.html"], "git_node": "8efa62acf951aebe485d2acc652a55d3224dfc01", "git_parents": ["3224787fa4818fe55c5937ce350530497c5af8fa"], "node": "02f253970c039a713b263ad67290c5563d20aacd", "parents": ["cb3273def37e7cef62951b3451c638fdc8ebdd60"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2058386 [wpt PR 61564] - WebMCP: Reject invalid origins with \"NotSupportedError\", a=testonly\n\nAutomatic update from web-platform-tests\nWebMCP: Reject invalid origins with \"NotSupportedError\"\n\nSee https://crrev.com/c/8121241/comment/a263bec5_46b078a4/ and\nhttps://github.com/webmachinelearning/webmcp/pull/226#discussion_r3627952082.\nWith both Mason *and* Fran\u00e7ois in agreement about this, we should\nmigrate from DataError =\u003e NotSupportedError.\n\nR=masonf\n\nBug: 489045948,536063275\nChange-Id: I9e5fc78b082de179c016f8a16dc052744ee28513\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8155899\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669154}\n\n--\n\nwpt-commits: bcbf3234805101c41303f35a874913fc70b2d966\nwpt-pr: 61564\n", "files": ["testing/web-platform/tests/webmcp/declarative/opaque-origin-tools.https.html", "testing/web-platform/tests/webmcp/imperative/opaque-origin-tools.https.html"], "git_node": "43480f92d39364f47b1d2e91c7a60302fe9f8b32", "git_parents": ["8efa62acf951aebe485d2acc652a55d3224dfc01"], "node": "b25b9a498157d87a8b8a0155a2ace8a2bd6b0ef8", "parents": ["02f253970c039a713b263ad67290c5563d20aacd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058386 [wpt PR 61564] - Update wpt metadata, a=testonly\n\nwpt-pr: 61564\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/imperative/opaque-origin-tools.https.html.ini"], "git_node": "427d524fcb62d02c94f9665d6d1ca33de93bfc08", "git_parents": ["43480f92d39364f47b1d2e91c7a60302fe9f8b32"], "node": "f613da801335064c3ca5ef4374e6f70889cba44e", "parents": ["b25b9a498157d87a8b8a0155a2ace8a2bd6b0ef8"], "tags": []}, {"author": "Philip Rogers \u003cpdr@chromium.org\u003e", "branch": "default", "desc": "Bug 2057704 [wpt PR 61529] - Use fuzzy matching in composited-filters-under-opacity.html, a=testonly\n\nAutomatic update from web-platform-tests\nUse fuzzy matching in composited-filters-under-opacity.html\n\nhttps://crrev.com/1665715 changed the reference for\ncomposited-filters-under-opacity.html in a way that makes the test not\ncover the original goals (see: http://crrev.com/653319). This patch\nreverts https://crrev.com/1665715 and instead adds fuzzy matching, as\nbeing off by 1 is fine for this test.\n\nChange-Id: I39baa73181fb4ab74243044f1b1e130e6137bf34\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8145500\nReviewed-by: Keren Zhu \u003ckerenzhu@chromium.org\u003e\nAuto-Submit: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Keren Zhu \u003ckerenzhu@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669217}\n\n--\n\nwpt-commits: 6ef32b046d691dd751b9c88417011b831feb034a\nwpt-pr: 61529\n", "files": ["testing/web-platform/tests/css/css-color/composited-filters-under-opacity-ref.html", "testing/web-platform/tests/css/css-color/composited-filters-under-opacity.html"], "git_node": "4e9390630b72511c67b518fcc75143dc9ca5e6c4", "git_parents": ["427d524fcb62d02c94f9665d6d1ca33de93bfc08"], "node": "6be1dc4854e3e0043f5c1bd59a86a9448172d9ea", "parents": ["f613da801335064c3ca5ef4374e6f70889cba44e"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2058200 [wpt PR 61548] - [RouteMatching] Untangle NavigationState from RouteMap., a=testonly\n\nAutomatic update from web-platform-tests\n[RouteMatching] Untangle NavigationState from RouteMap.\n\nMake :nav-source shippable, by associating NavigationState with Document\nrather than RouteMap, and by introducing a runtime feature\nNavigationState. The existing RouteMatching feature now depends on that\nfeature. On its own, NavigationState only provides support for\n:nav-source.\n\nUpstream existing :nav-source test.\n\nBug: 436805487\nChange-Id: Ifde73ca221c1500cddc416793c2bbf1fed4fc08e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8153282\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669298}\n\n--\n\nwpt-commits: 7ed5def3136f50fdf9664e19e30e85a57e3a08ed\nwpt-pr: 61548\n", "files": ["testing/web-platform/tests/css/css-navigation/META.yml", "testing/web-platform/tests/css/css-navigation/nav-source-001.html", "testing/web-platform/tests/css/css-navigation/resources/test-navigation.js"], "git_node": "48955d26ae445a399fa300126c360f35020739e5", "git_parents": ["4e9390630b72511c67b518fcc75143dc9ca5e6c4"], "node": "441610d153fc8953f1fe2f6639b7143d3728e431", "parents": ["6be1dc4854e3e0043f5c1bd59a86a9448172d9ea"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058200 [wpt PR 61548] - Update wpt metadata, a=testonly\n\nwpt-pr: 61548\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-navigation/nav-source-001.html.ini"], "git_node": "aea8e913dd658879bf92bc09909045345af5ffb5", "git_parents": ["48955d26ae445a399fa300126c360f35020739e5"], "node": "ada88b24cdd8ec767d0f5e5f28e5c167be96e1fd", "parents": ["441610d153fc8953f1fe2f6639b7143d3728e431"], "tags": []}, {"author": "youennf \u003cyouennf@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058400 [wpt PR 61567] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320359, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320359 (#61567)\n\n* WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320359\n--\n\nwpt-commits: 92ce110bdfaafc84acc1e37b4bbae549f112b8aa\nwpt-pr: 61567\n", "files": ["testing/web-platform/tests/lint.ignore", "testing/web-platform/tests/service-workers/service-worker/fetch-request-body-cancel-worker.js", "testing/web-platform/tests/service-workers/service-worker/fetch-request-body-cancel.https.html"], "git_node": "e83adc10defb01a7d5f4f7db040c97f3c36a8656", "git_parents": ["aea8e913dd658879bf92bc09909045345af5ffb5"], "node": "b26ff1bf6b83b4d71745d53790f41e39056e7c9f", "parents": ["ada88b24cdd8ec767d0f5e5f28e5c167be96e1fd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058400 [wpt PR 61567] - Update wpt metadata, a=testonly\n\nwpt-pr: 61567\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/service-workers/service-worker/fetch-request-body-cancel.https.html.ini"], "git_node": "dc09fc71f1d20c83db7df697ef59db0d30982f2b", "git_parents": ["e83adc10defb01a7d5f4f7db040c97f3c36a8656"], "node": "6afa2f67beb8ef9a606017023609466ec908c7be", "parents": ["b26ff1bf6b83b4d71745d53790f41e39056e7c9f"], "tags": []}, {"author": "Simon W\u00fclker \u003csimon.wuelker@arcor.de\u003e", "branch": "default", "desc": "Bug 2057341 [wpt PR 61505] - layout: Fix baseline alignment of horizontal text in column flex container, a=testonly\n\nAutomatic update from web-platform-tests\nAdd web platform test\n\nSigned-off-by: Simon W\u00fclker \u003csimon.wuelker@arcor.de\u003e\n\n--\n\nwpt-commits: 6383bc5f719678ab2f496fc407515f649069df41\nwpt-pr: 61505\n", "files": ["testing/web-platform/tests/css/css-flexbox/align-self-baseline-with-flex-wrap.html"], "git_node": "623059af9c8bc24f44cb800e40e99ddb7355bf5a", "git_parents": ["dc09fc71f1d20c83db7df697ef59db0d30982f2b"], "node": "263c291886f0f2759f5f4f819ded496c2e0200c2", "parents": ["6afa2f67beb8ef9a606017023609466ec908c7be"], "tags": []}, {"author": "Byungwoo Lee \u003cblee@igalia.com\u003e", "branch": "default", "desc": "Bug 2057582 [wpt PR 61514] - Preserve invalid selectors in :is() and :where(), a=testonly\n\nAutomatic update from web-platform-tests\nPreserve invalid selectors in :is() and :where()\n\nAs per the resolution in w3c/csswg-drafts/issues/8356 [1], forgiving\nselector lists (argument of :is(), :where()) need to preserve invalid\narguments for serialization, even though they never match anything.\n\nUse the existing pseudo type kPseudoUnparsed with kNone nesting type\nto keep an invalid selector text and change the css selector parser\nso it creates the placeholder for the failed-parsing complex selector.\n\nTo keep the current First()/Next() behavior of CSSSelectorList, the\nmethods skip the unparsed-invalid selector.\n\nFirstIncludingUnparsedInvalid() and NextIncludingUnparsedInvalid()\nare added in CSSSelectorList to serialize with the unparsed-invalid\nselectors.\n\nAdd a private method IsInvalidWithoutUnparsed() to CSSSelectorList\nto distinguish an empty list (CSSSelectorList::Empty()) from an\ninvalid list that has unparsed-invalid selectors. Replace the IsValid()\nchecks that meant \"empty\" with it (e.g. in Copy() and ComputeLength()),\nso the methods can handle the preserved unparsed invalid selectors.\n\nThe invalid selector serialization works behind the experimental\nfeature SerializeInvalidSelectorsInForgivingSelectorList.\n\n[1] https://github.com/w3c/csswg-drafts/issues/8356\n\nBug: 40277472\nChange-Id: I5d350d815153fbf846ed8763707d0938a2327376\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8068106\nCommit-Queue: Byungwoo Lee \u003cblee@igalia.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669314}\n\n--\n\nwpt-commits: 0acb81f2619df3096926dcc5a9d234d668f5a38e\nwpt-pr: 61514\n", "files": ["testing/web-platform/tests/css/selectors/parsing/parse-is-where.html", "testing/web-platform/tests/css/support/parsing-testcommon.js"], "git_node": "de0efbbc463865c78b8c3949a6957be6054d46b3", "git_parents": ["623059af9c8bc24f44cb800e40e99ddb7355bf5a"], "node": "4333fe44df86ff20437d790f82b2505a7647bf7c", "parents": ["263c291886f0f2759f5f4f819ded496c2e0200c2"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2057838 [wpt PR 61535] - Update Wasm tests, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate Wasm tests from WebAssembly/spec@dfa3f32\n\nUpstream: https://github.com/WebAssembly/spec/commit/dfa3f32a881aecc60a8c792da3c25787ccb15572\n\n--\n\nwpt-commits: ad1c8c29357141e48698bf34f0dc32abd278a4a6\nwpt-pr: 61535\n", "files": ["testing/web-platform/tests/wasm/core/js/return_call.wast.js", "testing/web-platform/tests/wasm/core/js/return_call_indirect.wast.js"], "git_node": "d4a7afe56c47345d80f372fe1ebdfc8e9c70d72d", "git_parents": ["de0efbbc463865c78b8c3949a6957be6054d46b3"], "node": "efa147986cd53cbb582dfdf35c856ec6ee155eff", "parents": ["4333fe44df86ff20437d790f82b2505a7647bf7c"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2058507 [wpt PR 61569] - Test ::first-letter outside size query container, a=testonly\n\nAutomatic update from web-platform-tests\nTest ::first-letter outside size query container\n\nIf the ::first-letter rule on an inner block stops applying due to a\nnon-matching container query, the ::first-letter on an outer container\nshould start matching.\n\nBug: 539636529\nChange-Id: I28cdf836a7a90dd669825f4b0c2a2da435ffedfb\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8157161\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669356}\n\n--\n\nwpt-commits: 2e15912f71ac35c79e894fc5db066dbfff87f9cd\nwpt-pr: 61569\n", "files": ["testing/web-platform/tests/css/css-conditional/container-queries/first-letter-outside-size-container.html"], "git_node": "7ed0f74ed1e6262ae9a05e31e05d611acaf73ca3", "git_parents": ["d4a7afe56c47345d80f372fe1ebdfc8e9c70d72d"], "node": "d7482b7ead83165697999f2d7a59e9a581a06bca", "parents": ["efa147986cd53cbb582dfdf35c856ec6ee155eff"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058507 [wpt PR 61569] - Update wpt metadata, a=testonly\n\nwpt-pr: 61569\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/container-queries/first-letter-outside-size-container.html.ini"], "git_node": "df8da2ca7851d6501d20c7b460444dc6675ccc50", "git_parents": ["7ed0f74ed1e6262ae9a05e31e05d611acaf73ca3"], "node": "eb28f2da82efb392eaafcf17c14f05201648daeb", "parents": ["d7482b7ead83165697999f2d7a59e9a581a06bca"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2058543 [wpt PR 61571] - Block CE reactions from elements disallowed by sanitizer, a=testonly\n\nAutomatic update from web-platform-tests\nBlock CE reactions from elements disallowed by sanitizer\n\nThis applies both to regular fragment parsing and to streaming.\n\nWe check the sanitizer early (when element is created) and avoid\ninitializing the CE definition if the element is anyway going to be\nremoved by the sanitizer.\n\nBug: 538197156\nChange-Id: Ib10400043a54710060d84477c9b30513e4acc1d8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8158260\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1669408}\n\n--\n\nwpt-commits: fefb5fc613b29f75ba402dc18360f98c7e92b212\nwpt-pr: 61571\n", "files": ["testing/web-platform/tests/domparsing/tentative/stream-html-custom-element-sanitizer.html", "testing/web-platform/tests/sanitizer-api/sanitizer-custom-elements-constructor.html"], "git_node": "21879e3c5bf03949b71a1aa38e2eb4e6e7f33dc6", "git_parents": ["df8da2ca7851d6501d20c7b460444dc6675ccc50"], "node": "f9f7a36b8e38c0dba382420c93fefd7cc194c893", "parents": ["eb28f2da82efb392eaafcf17c14f05201648daeb"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058543 [wpt PR 61571] - Update wpt metadata, a=testonly\n\nwpt-pr: 61571\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-html-custom-element-sanitizer.html.ini", "testing/web-platform/meta/sanitizer-api/sanitizer-custom-elements-constructor.html.ini"], "git_node": "38858b08b8c998891b677466ef6ef6fa16cca30e", "git_parents": ["21879e3c5bf03949b71a1aa38e2eb4e6e7f33dc6"], "node": "5cf7be8f9b32f71373bf3e8dc8ec6cc3a4213579", "parents": ["f9f7a36b8e38c0dba382420c93fefd7cc194c893"], "tags": []}, {"author": "Keren Zhu \u003ckerenzhu@chromium.org\u003e", "branch": "default", "desc": "Bug 2058677 [wpt PR 61581] - Update fuzzy match tolerance for composited-filters-under-opacity.html, a=testonly\n\nAutomatic update from web-platform-tests\nUpdate fuzzy match tolerance for composited-filters-under-opacity.html\n\nIncreases the allowed maxDifference from 1 to 2 (test page #7f7ff7 vs\nref page #8080f7).\n\nChange-Id: Ib69e7100bdc399a8146c49bada54c9e837906186\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8163381\nAuto-Submit: Keren Zhu \u003ckerenzhu@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1669616}\n\n--\n\nwpt-commits: 4439a8c1303f43015a4e54989a53738c5399ce91\nwpt-pr: 61581\n", "files": ["testing/web-platform/tests/css/css-color/composited-filters-under-opacity.html"], "git_node": "a712fbd21a899a04848348f0549262266a9fda9c", "git_parents": ["38858b08b8c998891b677466ef6ef6fa16cca30e"], "node": "75cf5ab7d1f4bd06a2aee91a4791538a02ef3c72", "parents": ["5cf7be8f9b32f71373bf3e8dc8ec6cc3a4213579"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@igalia.com\u003e", "branch": "default", "desc": "Bug 2058639 [wpt PR 61579] - layout: Use a total order comparator when distributing extra space to rowspans, a=testonly\n\nAutomatic update from web-platform-tests\nlayout: Use a total order comparator when distributing extra space to rowspans\n\nExtra space is distributed to rowspans in an order determined by the\nspecification. The sorting that was used to determine this order wasn't\ntotal which meant that you could have a situation where:\n\n - rowspan_a == rowspan_b\n - rowspan_a \u003e rowspan_c\n - rowspan_c \u003e rowspan_b\n\nThis change makes the sorting total by properly ordering ranges even\nwhen one side of their ranges overlap. The test included here\nunfortunately has to be a bit noisy because the standard library only\ndetects a non-total ordering under a specific set and distribution of\nelements.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@igalia.com\u003e\n\n--\n\nwpt-commits: 012495eaecad92cee7537db8dbc4dd1d385ec13d\nwpt-pr: 61579\n", "files": ["testing/web-platform/tests/css/css-tables/crashtests/row-size-distribution-rowspan-sorting.html"], "git_node": "8aec13a8cb58584bbae8f30902167ac6beb169c6", "git_parents": ["a712fbd21a899a04848348f0549262266a9fda9c"], "node": "93e6ad02c28d2342da1db833b7b3a8a417e669d8", "parents": ["75cf5ab7d1f4bd06a2aee91a4791538a02ef3c72"], "tags": []}, {"author": "Hoch Hochkeppel (HE/HIM) \u003cmhochk@microsoft.com\u003e", "branch": "default", "desc": "Bug 2058684 [wpt PR 61584] - Agnosticize seg-break-transformation tests, a=testonly\n\nAutomatic update from web-platform-tests\nAgnosticize seg-break-transformation tests\n\nThis does *not* fix these tests, it reduces the test expectations noise.\n\nUpdate the seg-break-transformation tests to all specify a provided font\nrather than relying on the OS default, so their failure values are\nidentical across platforms.\n\nThis aligns with the latest of these tests (which were already\nspecifying a font), reduces the number of expectations files currently\nneeded, and protects against needing to make additional\nplatform-specific expectations files for these tests going forward\n(which has historically happend for different Mac versions). It does not\nuse the Ahem font (used by the latest of these tests) because that does\nnot include all the relevant characters being tested.\n\nThis also required updating these tests (that are using script) to\nexplicitly wait for font loading to complete. Otherwise, they would\npotentially be falling back to the defaults, re-introducing the problem\nthis is trying to fix.\n\nWhile touching these files, also updating their spec links to point at\ncss-text-4 (where this functionality is currently an open issue).\n\nBug: 40771963\nChange-Id: I30a936bae5c0a20c856ce3464fee31babd01ef73\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8133969\nReviewed-by: Kurt Catti-Schmidt \u003ckschmi@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Hoch Hochkeppel \u003cmhochk@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1669643}\n\n--\n\nwpt-commits: cd0e4e4ffad93f5eb771124e85c480821c4fde94\nwpt-pr: 61584\n", "files": ["testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-000.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-001.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-002.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-003.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-004.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-005.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-006.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-007.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-008.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-009.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-010.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-011.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-012.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-014.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-015.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-016.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-017.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-018.tentative.html", "testing/web-platform/tests/css/css-text/white-space/seg-break-transformation-019.tentative.html"], "git_node": "8d3212a0f8fcb8c49e76ef06b0fc9db8867cb54c", "git_parents": ["8aec13a8cb58584bbae8f30902167ac6beb169c6"], "node": "1cbc6dfad61bcd53dd1acb4c3edf2fb5742ae904", "parents": ["93e6ad02c28d2342da1db833b7b3a8a417e669d8"], "tags": []}, {"author": "Andrew Verge \u003caverge@chromium.org\u003e", "branch": "default", "desc": "Bug 2058597 [wpt PR 61574] - [Connection-Allowlist] Implement CSP-style restrictions for WebRTC., a=testonly\n\nAutomatic update from web-platform-tests\n[Connection-Allowlist] Implement CSP-style restrictions for WebRTC.\n\nPreviously, Connection Allowlist blocked WebRTC by throwing an error in\nthe RTCPeerConnection constructor (crrev.com/c/7676321). However, this\ndiverges from how CSP handles WebRTC blocking, which could result in\nchurn for developers. This CL changes the renderer-side WebRTC blocking\nbehavior to match what has been specified for CSP. In particular:\n\n* Filter all ICE servers to avoid surfacing local candidates\n* Prevent adding of remote ICE candidates (this mimics the current state of the WebRTC + CSP integration)\n* Immediately fire an event to change to \u201cfailed\u201d connection state(s) after construction\n* Calling restartIce() doesn\u2019t change this outcome.\n\nThese four changes should produce the same result declared in the CSP\nspec: https://w3c.github.io/webappsec-csp/#directive-webrtc\n\nWeb Platform Tests have been updated to match this new behavior, and\neven pass the existing, unmodified CSP test logic.\n\nBug: 492439214\nFixed: 492439214\nChange-Id: Ib3b6261d0d19fdb3121ddca4f7d26905a0935fce\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8132041\nCommit-Queue: Andrew Verge \u003caverge@chromium.org\u003e\nReviewed-by: Guido Urdaneta \u003cguidou@chromium.org\u003e\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1669728}\n\n--\n\nwpt-commits: 7ba7013f9eab51c771cb980eec5807c49c1a4bb1\nwpt-pr: 61574\n", "files": ["testing/web-platform/tests/connection-allowlist/tentative/webrtc-allow.sub.window.js", "testing/web-platform/tests/connection-allowlist/tentative/webrtc-block-default.sub.window.js", "testing/web-platform/tests/connection-allowlist/tentative/webrtc-block-interactions.sub.window.js", "testing/web-platform/tests/connection-allowlist/tentative/webrtc-block-interactions.sub.window.js.headers", "testing/web-platform/tests/connection-allowlist/tentative/webrtc-block.sub.window.js", "testing/web-platform/tests/connection-allowlist/tentative/webrtc-queuereport-enforce.https.sub.window.js", "testing/web-platform/tests/connection-allowlist/tentative/webrtc-queuereport-report-only.https.sub.window.js"], "git_node": "a4dfe205b5ee7711308732a7e3bffc78885142f2", "git_parents": ["8d3212a0f8fcb8c49e76ef06b0fc9db8867cb54c"], "node": "e2e87845aeafe49fd3834c2b3f53b141e5f1d92d", "parents": ["1cbc6dfad61bcd53dd1acb4c3edf2fb5742ae904"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058597 [wpt PR 61574] - Update wpt metadata, a=testonly\n\nwpt-pr: 61574\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/webrtc-block-default.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/webrtc-block-interactions.sub.window.js.ini", "testing/web-platform/meta/connection-allowlist/tentative/webrtc-queuereport-report-only.https.sub.window.js.ini"], "git_node": "c1bf0a1c96ef8584f69e41bb3f32ff87e7e9858f", "git_parents": ["a4dfe205b5ee7711308732a7e3bffc78885142f2"], "node": "f1bf24117a5d079206affe317547cb07725625ce", "parents": ["e2e87845aeafe49fd3834c2b3f53b141e5f1d92d"], "tags": []}, {"author": "Luke Warlow \u003clwarlow@igalia.com\u003e", "branch": "default", "desc": "Bug 2058554 [wpt PR 61572] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320096, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320096 (#61572)\n--\n\nwpt-commits: 0f33a7772bc48d908ddec38071cb93bda5a0231e\nwpt-pr: 61572\n", "files": ["testing/web-platform/tests/dom/nodes/moveBefore/custom-element-move-reactions.html"], "git_node": "3f99ea8989aa2147aea519cec5d38fd8dda3edeb", "git_parents": ["c1bf0a1c96ef8584f69e41bb3f32ff87e7e9858f"], "node": "da5d6a8453a69141ed6ba497ecc9a23bef409d02", "parents": ["f1bf24117a5d079206affe317547cb07725625ce"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058554 [wpt PR 61572] - Update wpt metadata, a=testonly\n\nwpt-pr: 61572\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/dom/nodes/moveBefore/custom-element-move-reactions.html.ini"], "git_node": "f52eed90ff237ecd746f32decf0cada33b57ef23", "git_parents": ["3f99ea8989aa2147aea519cec5d38fd8dda3edeb"], "node": "5b08d65fd3c31f6144f27642e623414e23a5cad4", "parents": ["da5d6a8453a69141ed6ba497ecc9a23bef409d02"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058782 - [wpt-sync] Update web-platform-tests to 0f33a7772bc48d908ddec38071cb93bda5a0231e, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 0f33a7772bc48d908ddec38071cb93bda5a0231e\nwpt-type: landing\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/webrtc-block-default.sub.window.js.ini", "testing/web-platform/meta/cookiestore/cookieStore_set_arguments.https.any.js.ini", "testing/web-platform/meta/css/css-animations/animation-duration-infinite.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini", "testing/web-platform/meta/css/css-content/element-replacement-dynamic.html.ini", "testing/web-platform/meta/css/css-overscroll-behavior/overscroll-behavior.html.ini", "testing/web-platform/meta/css/css-text/writing-system/writing-system-font-001.html.ini", "testing/web-platform/meta/css/css-view-transitions/window-resize-aborts-transition.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-aliases.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-access-vs-named-access.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-defaults.window.js.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-noopener.html.ini", "testing/web-platform/meta/html/dom/render-blocking/remove-attr-style-keeps-blocking.html.ini", "testing/web-platform/meta/html/semantics/embedded-content/the-canvas-element/security.pattern.fillStyle.sub.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/microtasks/basic.any.js.ini", "testing/web-platform/meta/html/semantics/the-button-element/command-and-commandfor/on-video-behavior.tentative.html.ini", "testing/web-platform/meta/html/user-activation/activation-trigger-touch.tentative.html.ini", "testing/web-platform/meta/intersection-observer/transformed-iframe-002-cross-origin.html.ini", "testing/web-platform/meta/mediacapture-record/MediaRecorder-stop.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/picture-in-picture/picture-in-picture-element.html.ini", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/referrer-policy/4K/gen/top.meta/same-origin/img-tag.http.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-audio+video.https.sub.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-audio.https.sub.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-video.https.sub.html.ini", "testing/web-platform/meta/screen-orientation/orientation-reading.html.ini", "testing/web-platform/meta/service-workers/service-worker/getregistration.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/out-of-document-rule-set.https.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-audioworklet-interface/audioworkletprocessor-unconnected-outputs.https.window.js.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/fragment_navigated/user_context_tentative.py.ini", "testing/web-platform/meta/webmcp/imperative/opaque-origin-tools.https.html.ini", "testing/web-platform/meta/webrtc-encoded-transform/script-transform-generateKeyFrame.https.html.ini", "testing/web-platform/meta/websockets/basic-auth.any.js.ini", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini"], "git_node": "698a1ad3561f6ea4b5d70354e7792bb8eb14a019", "git_parents": ["f52eed90ff237ecd746f32decf0cada33b57ef23"], "node": "21630f0c8d377893123ef387ba4c8cd642d0dd2f", "parents": ["5b08d65fd3c31f6144f27642e623414e23a5cad4"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2058915 - vendor logins-wipe-crash app-services branch. r=joschmidt\n\nVendoring main is currently broken in multiple ways. The logins-wipe-crash\nbranch is what's currently in m-c plus\nhttps://github.com/mozilla/application-services/pull/7515.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315224\n", "files": ["third_party/application-services/components/logins/src/sync/engine.rs", "third_party/application-services/moz.yaml"], "git_node": "ee1b309f800a8e1cae70b4dd02a9433517a66181", "git_parents": ["698a1ad3561f6ea4b5d70354e7792bb8eb14a019"], "node": "8ce8d4eb467cdeffbe162e6f057a6eba92b60213", "parents": ["21630f0c8d377893123ef387ba4c8cd642d0dd2f"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059097 - Update PDF.js to 61acf93172acab60498f23186ae1780c4752aa4b r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315056\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/content/web/wasm/qcms_bg.wasm", "toolkit/components/pdfjs/moz.yaml"], "git_node": "de99b689e6164d8df6ba555d6c3d5973af66da58", "git_parents": ["ee1b309f800a8e1cae70b4dd02a9433517a66181"], "node": "607a4841262802279dec8534757282d12d9dce65", "parents": ["8ce8d4eb467cdeffbe162e6f057a6eba92b60213"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037102 - [speculation-rules] Part 1.1: Add PPrefetchRecord IPDL actor scaffolding r=dom-core-reviewers,necko-reviewers,avandolder,nika,kershaw\n\nPlumbing-only patch for Speculation Rules prefetch (M1, same-origin).\nAdds the PPrefetchRecord IPDL protocol, child/parent actor skeletons,\nand PWindowGlobal management. No behavior yet \u2014 Init/Cancel bodies and\nSpeculationRulesManager wiring follow in subsequent parts.\n\n- dom/ipc/PPrefetchRecord.ipdl (new): protocol definition\n- dom/ipc/PrefetchIPCTypes.ipdlh (new): shared IPDL types\n  (SpeculativePrefetchArgs) usable by PPrefetchRecord + PWindowGlobal\n- dom/ipc/PrefetchTypes.h (new): shared C++ enums (PrefetchState,\n  PrefetchAnonymizationPolicy, PrefetchSource) and ExchangeRecord\n- dom/ipc/PrefetchRecordChild.{h,cpp} (new): content-side actor; holds\n  URL + anon policy\n- dom/ipc/PrefetchRecordParent.{h,cpp} (new): parent-side actor; holds\n  prefetch record fields; empty RecvCancel/ActorDestroy\n- dom/ipc/PWindowGlobal.ipdl: add 'manages PPrefetchRecord;' and\n  constructor message\n- dom/ipc/WindowGlobalParent.{h,cpp}: add AllocPPrefetchRecordParent\n- dom/ipc/moz.build: wire new sources\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302502\n", "files": ["dom/ipc/PPrefetchRecord.ipdl", "dom/ipc/PWindowGlobal.ipdl", "dom/ipc/PrefetchIPCTypes.ipdlh", "dom/ipc/PrefetchRecordChild.cpp", "dom/ipc/PrefetchRecordChild.h", "dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "dom/ipc/PrefetchTypes.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/moz.build"], "git_node": "31d07ee57de01953241906588c12ebda1d6e0bd1", "git_parents": ["de99b689e6164d8df6ba555d6c3d5973af66da58"], "node": "b78b5447b12e4cd3271a73f96fe05094e55e24fb", "parents": ["607a4841262802279dec8534757282d12d9dce65"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041008 - [speculation-rules] Part 1.2: Add SpeculationRulesManager skeleton r=dom-core-reviewers,avandolder\n\nEmpty DOM-side orchestrator class for Speculation Rules prefetch.\nHolds the active PrefetchRecordChild list; only RemoveRecord is\nimplemented for now. Document integration follows in Part 1.3;\nStartPrefetch / CancelPrefetch / GarbageCollect and rule parsing\nland in Part 6.\n\n- dom/base/SpeculationRulesManager.{h,cpp} (new): skeleton class\n- dom/base/moz.build: wire new sources\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302503\n", "files": ["dom/base/SpeculationRulesManager.cpp", "dom/base/SpeculationRulesManager.h", "dom/base/moz.build"], "git_node": "be3023bd8ec7f4c5c20a7b021cb737f2213927da", "git_parents": ["31d07ee57de01953241906588c12ebda1d6e0bd1"], "node": "09f11311d515e73adb3a4037491013fe62814412", "parents": ["b78b5447b12e4cd3271a73f96fe05094e55e24fb"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041008 - [speculation-rules] Part 1.3: Integrate SpeculationRulesManager with Document r=dom-core-reviewers,jjaschke\n\nAdds the lazy UniquePtr\u003cSpeculationRulesManager\u003e field on Document and\nwires PrefetchRecordChild::ActorDestroy to RemoveRecord via the\nWindow -\u003e Document chain. Records-list cleanup now happens automatically\non actor death (PWindowGlobal teardown, Send__delete__, content\nprocess crash).\n\nAlso adds a Source() accessor to PrefetchRecordParent to clear a\n-Wunused-private-field warning on mSource introduced in Part 1.1.\n\n- dom/base/Document.{h,cpp}: forward declaration, member, accessor,\n  include\n- dom/ipc/PrefetchRecordChild.cpp: wire ActorDestroy -\u003e RemoveRecord\n- dom/ipc/PrefetchRecordParent.h: add Source() accessor\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302504\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/ipc/PrefetchRecordChild.cpp"], "git_node": "60041157c2d327d5f364b9a20b3bae20298f0cfe", "git_parents": ["be3023bd8ec7f4c5c20a7b021cb737f2213927da"], "node": "2cdbeb59657486492569ed424bb5b5ec3b3ee22c", "parents": ["09f11311d515e73adb3a4037491013fe62814412"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041008 - [speculation-rules] Part 1.4: Add SpeculationRules MOZ_LOG module and prefs r=dom-core-reviewers,avandolder\n\nLogging infrastructure and pref surface for Speculation Rules\nprefetch. No log calls yet.\n\n- dom/ipc/PrefetchLog.h (new): extern LazyLogModule\n  gSpeculationRulesLog + LOG_SPECRULES macros\n- dom/ipc/PrefetchRecordParent.cpp: define gSpeculationRulesLog\n- dom/ipc/moz.build: export PrefetchLog.h\n\nPrefs added to modules/libpref/init/StaticPrefList.yaml:\n- dom.speculation_rules.enabled (false): master switch\n- dom.speculation_rules.wait_timeout_ms (2000): navigation-wait timeout\n- dom.speculation_rules.max_records_per_document (20): records cap\n- dom.speculation_rules.max_body_bytes (5242880): body cap\n- dom.speculation_rules.record_expiry_ms (300000): record expiry\n- dom.speculation_rules.same_origin_only (true): same-origin gate\n\nEnable via: MOZ_LOG=SpeculationRules:5\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302505\n", "files": ["dom/ipc/PrefetchLog.h", "dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/moz.build", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "4bae892402193d4412f25052d0a7116678637d8e", "git_parents": ["60041157c2d327d5f364b9a20b3bae20298f0cfe"], "node": "b34ff5043f95d86bef15b17cc4b6c058f75f6764", "parents": ["2cdbeb59657486492569ed424bb5b5ec3b3ee22c"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041008 - [speculation-rules] Part 1.5: Wire lifecycle log calls for prefetch actors and SpeculationRulesManager r=dom-core-reviewers,avandolder\n\nAdds MOZ_LOG=SpeculationRules:5 visibility for the actor lifecycle and\nmanager bookkeeping wired up in Parts 1.1-1.4. Each log line carries\nthe relevant arguments (URL, anonymization policy, reason code, tag\ncount, remaining records).\n\n- dom/ipc/PrefetchRecordChild.cpp: log ctor + ActorDestroy\n- dom/ipc/PrefetchRecordParent.cpp: log RecvCancel + ActorDestroy\n- dom/base/SpeculationRulesManager.cpp: log RemoveRecord\n- dom/ipc/WindowGlobalParent.cpp: log AllocPPrefetchRecordParent\n  with deserialized URL + args\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302506\n", "files": ["dom/ipc/PrefetchRecordChild.cpp", "dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/WindowGlobalParent.cpp"], "git_node": "2e05c616c7750e1ff965e5f0b06082640b5f3fa6", "git_parents": ["4bae892402193d4412f25052d0a7116678637d8e"], "node": "bbfa1f67ad98978691be63830c18f3347ec15968", "parents": ["b34ff5043f95d86bef15b17cc4b6c058f75f6764"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037103 - [speculation-rules] Part 2.1: Implement PrefetchRecordParent::Init() and streaming interfaces r=dom-core-reviewers,necko-reviewers,avandolder,kershaw\n\nImplements \"start a referrer-initiated navigational prefetch\":\nHTTPS gate, same-origin gate, conditional isolation setup,\nNS_NewChannelInternal with TYPE_OTHER, Sec-Purpose header, referrer\ninfo, and AsyncOpen. Adds nsIStreamListener/nsIRequestObserver/\nnsIInterfaceRequestor/nsIChannelEventSink as base classes with full\nQI. OnDataAvailable enforces the body-bytes cap via\ndom.speculation_rules.max_body_bytes pref. OnStartRequest fills\nthe redirect chain entry with response status and No-Vary-Search\nheader. AsyncOnChannelRedirect updates the redirect chain; cross-site\npartition check follows in Part 2.3.\n\nHelper functions added: IsCrossOriginToDocument,\nPopulateIsolatedPartitionKey, ConfigureSecPurpose,\nPrefetchIPAnonymizationPolicyRequiresAnonymity, AppendRedirectChainEntry,\nFillResponseOnLastEntry.\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html#start-a-referrer-initiated-navigational-prefetch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302507\n", "files": ["dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "dom/ipc/WindowGlobalParent.cpp", "netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "c5993d48e5b31a5a83cdeefc1db9e4c33790bbfc", "git_parents": ["2e05c616c7750e1ff965e5f0b06082640b5f3fa6"], "node": "a5ca836b3f071548935a4613ce03b3a0b9fc91e4", "parents": ["bbfa1f67ad98978691be63830c18f3347ec15968"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037103 - [speculation-rules] Part 2.2: Add cross-site redirect partition-key check r=dom-core-reviewers,necko-reviewers,avandolder,valentin\n\nCompletes AsyncOnChannelRedirect: when a redirect crosses a site\nboundary (proposedPartitionKey != sourcePartitionKey), the prefetch\nis aborted if the referrer policy would leak too much source-page\ninformation. Strict policies (strict-origin-when-cross-origin,\nstrict-origin, same-origin, no-referrer, empty) are allowed;\nno-referrer-when-downgrade, origin, origin-when-cross-origin,\nand unsafe-url are rejected.\n\nNew helpers: ComputePartitionKeyForChannel (derives partition key\nfrom the redirected URL via OriginAttributes::SetPartitionKey),\nIsReferrerPolicySufficientlyStrict.\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html#list-of-sufficiently-strict-speculative-navigation-referrer-policies\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302508\n", "files": ["dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h"], "git_node": "2f858c2ca63055fa995123c979997e36dfeb359e", "git_parents": ["c5993d48e5b31a5a83cdeefc1db9e4c33790bbfc"], "node": "cd96af1fefcc3269293bb2f45efe02e8a357ed42", "parents": ["a5ca836b3f071548935a4613ce03b3a0b9fc91e4"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037103 - [speculation-rules] Part 3.1: Implement RecvCancel, ActorDestroy safety net, and FirePrefetchStatusUpdated stub r=dom-core-reviewers,avandolder\n\nImplements \"cancel and discard a prefetch record\": RecvCancel\nsets state=Canceled, aborts the channel, fires the prefetchstatusupdated\nfailure event stub, and notifies state-change waiters. ActorDestroy adds\na safety net that cancels the channel if the actor dies mid-flight\n(tab close, PWindowGlobal teardown, process crash).\n\n- PrefetchRecordParent: RecvCancel (idempotent guard, channel abort,\n  FirePrefetchStatusUpdated, NotifyPrefetchStateChanged); ActorDestroy\n  safety net; FirePrefetchStatusUpdated stub (BiDi wiring deferred)\n- WindowGlobalParent: NotifyPrefetchStateChanged stub (waiter logic\n  added in Part 4.2)\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html#prefetch-record-cancel-and-discard\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302509\n", "files": ["dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "1b94e6e93f9255adf7b6fe8f7d4a9249004fc1c5", "git_parents": ["2f858c2ca63055fa995123c979997e36dfeb359e"], "node": "80fa799cd1ce94e4d82edc3907bcfcdb4c0ab9c1", "parents": ["cd96af1fefcc3269293bb2f45efe02e8a357ed42"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037103 - [speculation-rules] Part 3.2: Implement OnStopRequest completion path and DedupePrefetchRecords r=dom-core-reviewers,avandolder\n\nImplements \"complete a prefetch record\": OnStopRequest success path\nsets expiry (via dom.speculation_rules.record_expiry_ms pref), deduplicates\nsame-URL completed records, sets state=Completed, fires prefetchstatusupdated\nsuccess stub, and notifies state-change waiters. OnStopRequest failure path\nuses MarkCanceled and notifies waiters.\n\nAdds MarkCanceled() helper (extracted from RecvCancel) so both RecvCancel\nand DedupePrefetchRecords can share the cancel logic without code duplication.\n\nDedupePrefetchRecords marks older Completed records with the same URL as\nCanceled.\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html#prefetch-record-complete\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302510\n", "files": ["dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "558b46c940a2af86ce6544cf790b98038bca9f69", "git_parents": ["1b94e6e93f9255adf7b6fe8f7d4a9249004fc1c5"], "node": "52e063a66a14df46b236c92ff6a98f54856dc064", "parents": ["80fa799cd1ce94e4d82edc3907bcfcdb4c0ab9c1"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041372 - [speculation-rules] Part 4.1: Implement navigation matching algorithms r=dom-core-reviewers,necko-reviewers,avandolder,kershaw\n\nImplements the synchronous navigation matching algorithms:\n\n- \"find a matching complete prefetch record\": iterates managed\n  actors, prefers exact URL match over No-Vary-Search equivalence,\n  checks expiry and conflicting credentials on every redirect chain hop.\n\n- \"prefetch record matches a URL\": exact URL equality first, then\n  No-Vary-Search variance from redirect chain[0]'s response header via\n  mozilla::net::ParseNoVarySearchHeader /\n  URLsAreEquivalentModuloVariationConfig (bug 2038006).\n\n- IsExpectedToMatch: pre-response variant using the rule's noVarySearchHint;\n  used by \"wait for a matching prefetch record\" to identify ongoing records\n  that might complete into a match.\n\n- \"conflicting credentials exist\": computes hypothetical partition\n  key for each redirect hop; same-site always returns false (M1); M2 will\n  add nsICookieManager cookie presence check for cross-site hops.\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html#find-a-matching-complete-prefetch-record\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302512\n", "files": ["dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h"], "git_node": "fd8d75cb12a3fe5f0838d37f30493de46a40d2d5", "git_parents": ["558b46c940a2af86ce6544cf790b98038bca9f69"], "node": "f145130aa381a8fe805d1a17a9270e2e910ff0e4", "parents": ["52e063a66a14df46b236c92ff6a98f54856dc064"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041372 - [speculation-rules] Part 4.2: Implement async PrefetchMatchWaiter for the wait algorithm r=dom-core-reviewers,avandolder\n\nImplements \"wait for a matching prefetch record\": when navigation\narrives while a potentially matching prefetch is still ongoing,\nWaitForMatchingPrefetchRecord fast-paths to FindMatchingPrefetchRecord\n(sync), or registers a PrefetchMatchWaiter if ongoing records could\nsatisfy the URL.\n\nPrefetchMatchWaiter holds a MozPromise, an nsITimer for the\ndom.speculation_rules.wait_timeout_ms timeout, and an Atomic\u003cbool\u003e\nresolved flag to prevent double-resolution if the timer and a\nstate-change notification race.\nNotifyPrefetchStateChanged now iterates mPrefetchWaiters and calls\nOnRecordStateChanged on each.\n\nSpec: https://wicg.github.io/nav-speculation/prefetch.html#wait-for-a-matching-prefetch-record\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302513\n", "files": ["dom/ipc/PrefetchMatchWaiter.cpp", "dom/ipc/PrefetchMatchWaiter.h", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/ipc/moz.build"], "git_node": "109b38c95b115dbedd925bf15804c87b0f88f247", "git_parents": ["fd8d75cb12a3fe5f0838d37f30493de46a40d2d5"], "node": "636c22faef87e48be3651ab4373a78382aa5b32d", "parents": ["f145130aa381a8fe805d1a17a9270e2e910ff0e4"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041381 - [speculation-rules] Part 5.1: Serve navigation from prefetch cache in DocumentLoadListener. r=necko-reviewers,cookie-reviewers,valentin\n\nHooks DocumentLoadListener::Open() to check for a matching prefetch record\nbefore opening the navigation channel to the network.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302514\n", "files": ["netwerk/cookie/PrefetchCookieCopier.cpp", "netwerk/cookie/PrefetchCookieCopier.h", "netwerk/cookie/moz.build", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/ipc/DocumentLoadListener.h"], "git_node": "9516822646a4402c9ad52be722331073e4f3e65d", "git_parents": ["109b38c95b115dbedd925bf15804c87b0f88f247"], "node": "6450a918641a4f01bfb41aa721931accae3bb601", "parents": ["636c22faef87e48be3651ab4373a78382aa5b32d"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041381 - [speculation-rules] Part 5.2: Expose deliveryType=\"navigational-prefetch\" on PerformanceNavigationTiming r=dom-core-reviewers,necko-reviewers,webidl,emilio,canova,saschanaz,kershaw,avandolder\n\nPropagates the activation signal from DocumentLoadListener (parent process)\nto PerformanceNavigationTiming (content process) via a new boolean on\nnsDOMNavigationTiming, which is already IPC-serialized in RedirectToRealChannelArgs.\n\nWhen a navigation is served from a speculation rules prefetch cache,\nperformance.getEntriesByType(\"navigation\")[0].deliveryType returns\n\"navigational-prefetch\" instead of the default empty string.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302516\n", "files": ["dom/base/nsDOMNavigationTiming.cpp", "dom/base/nsDOMNavigationTiming.h", "dom/performance/PerformanceMainThread.cpp", "dom/performance/PerformanceResourceTiming.cpp", "dom/performance/PerformanceResourceTiming.h", "dom/webidl/PerformanceResourceTiming.webidl", "modules/libpref/init/StaticPrefList.yaml", "netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "361012b811d5de287d8094a05e2ab0a36c9335a7", "git_parents": ["9516822646a4402c9ad52be722331073e4f3e65d"], "node": "7abd115d3445fedd0a124f7e00c6cb68971c1b91", "parents": ["6450a918641a4f01bfb41aa721931accae3bb601"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041381 - [speculation-rules] Part 6: Integrate DOM speculation rules parser with PrefetchRecord Actors and SpeculationRules manager. r=dom-core-reviewers,necko-reviewers,avandolder,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302517\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRulesManager.cpp", "dom/base/SpeculationRulesManager.h", "dom/base/speculationrules/lib.rs"], "git_node": "2f0546f9f8d811ce3c397a4263350ea21b22b8c1", "git_parents": ["361012b811d5de287d8094a05e2ab0a36c9335a7"], "node": "0000c5ce4ed2e2b674de83eeb6f473d119b9cf13", "parents": ["7abd115d3445fedd0a124f7e00c6cb68971c1b91"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041381 - pass cookies storage info while creating channel in prefetch parent. r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302518\n", "files": ["dom/ipc/PrefetchRecordParent.cpp", "dom/ipc/PrefetchRecordParent.h", "dom/ipc/WindowGlobalParent.cpp", "netwerk/ipc/DocumentLoadListener.cpp", "netwerk/ipc/DocumentLoadListener.h", "netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "49eda02be24894d787d9733adea8cde28704f915", "git_parents": ["2f0546f9f8d811ce3c397a4263350ea21b22b8c1"], "node": "f270f9a8bac5d9197235d86f8afd0d253036ed76", "parents": ["0000c5ce4ed2e2b674de83eeb6f473d119b9cf13"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041381 - Enable Speculation Rules API (same-origin prefetch) for nightly. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310767\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "4580b66c00179620f24c4a33a67f649dfb4e7de8", "git_parents": ["49eda02be24894d787d9733adea8cde28704f915"], "node": "5992f1b704e17a138727cdf9cac23320df2e26c3", "parents": ["f270f9a8bac5d9197235d86f8afd0d253036ed76"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054560 - Update WPT expectation for speculation rules. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315237\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/duplicate-urls.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/multiple-url.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/mutate-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/tentative/service-worker/redirect.sub.https.html.ini", "testing/web-platform/meta/speculation-rules/speculation-tags/invalid-tags.https.html.ini"], "git_node": "5bbabec7d31668de710c9e007308b62fe42ccfa1", "git_parents": ["4580b66c00179620f24c4a33a67f649dfb4e7de8"], "node": "d8911b3511d46a98c69ddcb0552649779289342d", "parents": ["5992f1b704e17a138727cdf9cac23320df2e26c3"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058136 - Migrate verifyTheOpenInAppSubMenuOptionIsEnabledTest UI test to the efficiency framework r=aaronmt\n\nConverted the verifyTheOpenInAppSubMenuOptionIsEnabledTest UI test to the efficiency framework.\n\nThe new UI test successfully passed 50x on Firebase.   [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=72305  | Try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=61478e4611122196ae2372a874c4eb125157aa47 | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314594\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "40002876476f853ff489991fe305f98a049c2ea2", "git_parents": ["5bbabec7d31668de710c9e007308b62fe42ccfa1"], "node": "ece54a641492ca2ba45a4f408c35d1f87149be0f", "parents": ["d8911b3511d46a98c69ddcb0552649779289342d"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2057693 - Fix fallback for Vulkan Video VP9 decoding. r=alwu\n\nVulkan Video VP9 decoding requires libavcodec 62 or newer. Skip the Vulkan decoder with older FFmpeg versions so initialization can fall back to VA-API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314176\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp"], "git_node": "971b0e7cdee14118372143aa5a2bb12f9881e687", "git_parents": ["40002876476f853ff489991fe305f98a049c2ea2"], "node": "cc2bae68f080a768d019245a966faa43ee02196d", "parents": ["ece54a641492ca2ba45a4f408c35d1f87149be0f"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2035512 - Increase the urlbar input's line-height so the caret can be placed anywhere r=desktop-theme-reviewers,urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313373\n", "files": ["browser/themes/shared/urlbar-searchbar.css"], "git_node": "9f4bdbdd64a5ee9d7d6f8cc4c52bd19c94fca893", "git_parents": ["971b0e7cdee14118372143aa5a2bb12f9881e687"], "node": "2a566d62ef69b0ceaf41b19a594b253c8e26555d", "parents": ["cc2bae68f080a768d019245a966faa43ee02196d"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2058356 - Use mozilla::Span for LineBreaker. r=TYLin\n\nCurrently, we are using pointer for text and break position state, but it is more safe to use Span.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314550\n", "files": ["dom/base/nsLineBreaker.cpp", "intl/lwbrk/LineBreakCache.h", "intl/lwbrk/LineBreaker.cpp", "intl/lwbrk/LineBreaker.h", "intl/lwbrk/gtest/TestSegmenterPerf.cpp"], "git_node": "c7ebb59cdcefd4a121691bc2cf57187cd4f26053", "git_parents": ["9f4bdbdd64a5ee9d7d6f8cc4c52bd19c94fca893"], "node": "dbef9b1cea4dfe5f1e8621132593cc8b1dc93047", "parents": ["2a566d62ef69b0ceaf41b19a594b253c8e26555d"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2046156 - Remove executeSoon() in favor of Services.tm.dispatchToMainThread() r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315023\n", "files": ["remote/marionette/actors/MarionetteCommandsChild.sys.mjs", "remote/marionette/transport.sys.mjs", "remote/server/WebSocketHandshake.sys.mjs", "remote/shared/Sync.sys.mjs", "remote/shared/test/xpcshell/test_Sync.js", "remote/webdriver-bidi/modules/windowglobal/input.sys.mjs"], "git_node": "af10e7b7de4eaa33ef388f733decd7ed2bbf21ba", "git_parents": ["c7ebb59cdcefd4a121691bc2cf57187cd4f26053"], "node": "0b639d2d93823c8318214db3448269ee213d6487", "parents": ["dbef9b1cea4dfe5f1e8621132593cc8b1dc93047"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058990 - Fix typo in GpuFences. r=gfx-reviewers,lsalzman\n\nAs amusing as the old name was, better to fix it while we're touching\nrelated code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315018\n", "files": ["gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.h", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.h"], "git_node": "0313f3732076193cdfd5ad71529f9c8a49a92031", "git_parents": ["af10e7b7de4eaa33ef388f733decd7ed2bbf21ba"], "node": "49545b19d8ec9dd631fa6b4f29aacd13db20890a", "parents": ["0b639d2d93823c8318214db3448269ee213d6487"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058990 - Make GpuFenceMTLSharedEvent call Metal APIs directly rather than via wgpu. r=gfx-reviewers,webgpu-reviewers,aleiserson,lsalzman\n\nThis will allow subsequent patches to use it for MTLSharedEvents that\ndo not originate from wgpu.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315019\n", "files": ["CLOBBER", "dom/webgpu/SharedTextureMacIOSurface.cpp", "gfx/layers/GpuFenceMTLSharedEvent.cpp", "gfx/layers/GpuFenceMTLSharedEvent.h", "gfx/layers/GpuFenceMTLSharedEvent.mm", "gfx/layers/moz.build", "gfx/wgpu_bindings/src/server.rs", "gfx/wgpu_bindings/wgpu.h"], "git_node": "623a32e98ad63309ecac8c6eba74859dc2f39794", "git_parents": ["0313f3732076193cdfd5ad71529f9c8a49a92031"], "node": "fd95957bf4446fe57befd329a5c11928ab54b97e", "parents": ["49545b19d8ec9dd631fa6b4f29aacd13db20890a"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058990 - Add GpuFence::ClientWait helper method. r=gfx-reviewers,lsalzman\n\nAnd switch callsites where we call HasCompleted() in a loop to use it\ninstead.\n\nFor GpuFenceMTLSharedEvent, on macOS 12 onwards we can call\nMTLSharedEvent.waitUntilSignaledValue(). On previous macOS versions we\nmust continue to check HasCompleted() in a loop, but at least contain\nthis logic to a single place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315020\n", "files": ["gfx/layers/GpuFence.h", "gfx/layers/GpuFenceMTLSharedEvent.h", "gfx/layers/GpuFenceMTLSharedEvent.mm", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderMacIOSurfaceTextureHost.cpp"], "git_node": "e503be08c6237b49e62f11098886d1123820814a", "git_parents": ["623a32e98ad63309ecac8c6eba74859dc2f39794"], "node": "9a58cf7ecde9e5ba2208734388653c99fa8b296b", "parents": ["fd95957bf4446fe57befd329a5c11928ab54b97e"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058990 - Synchronise Metal ANGLE WebGL with webrender using a MTLSharedEvent. r=gfx-reviewers,lsalzman\n\nWhen rendering using CGL,\nSharedSurface_IOSurface::ProducerReleaseImpl() calls glFlush(), which\nensures the rendering is synchronized with the next webrender\nrender. On Metal ANGLE, however, this is not sufficient.\n\nInstead, we must create a MTLSharedEvent using the\nEGL_ANGLE_metal_shared_event_sync extension, and plumb it via a\nGpuFenceMTLSharedEvent through to the RenderTextureHost. At this\npoint, the existing mechanism used for WebGPU will ensure it is\nsynchronized correctly with presentation, namely\nRenderMacIOSurfaceTextureHost::Lock() which waits for the shared event\nto be signalled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315021\n", "files": ["dom/canvas/WebGLContext.cpp", "gfx/gl/GLDefs.h", "gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h", "gfx/gl/SharedSurface.h", "gfx/gl/SharedSurfaceIO.cpp", "gfx/gl/SharedSurfaceIO.h"], "git_node": "df86674100dafba192cc98b7848afe65919763a3", "git_parents": ["e503be08c6237b49e62f11098886d1123820814a"], "node": "e5ac4c8c59b5c53739e8b2664531bef24861333c", "parents": ["9a58cf7ecde9e5ba2208734388653c99fa8b296b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057970 - Avoid large render tasks for non-dashed/dotted borders. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314700\n", "files": ["gfx/wr/webrender/src/border.rs", "gfx/wr/wrench/reftests/border/long-edge-all-styles-ref.yaml", "gfx/wr/wrench/reftests/border/long-edge-all-styles.yaml", "gfx/wr/wrench/reftests/border/reftest.list"], "git_node": "d35afdb47a20ec8c959bab439ea60dc393203038", "git_parents": ["df86674100dafba192cc98b7848afe65919763a3"], "node": "6dac6493b8fe41b23f06df3661a0e4c4aa0147b6", "parents": ["e5ac4c8c59b5c53739e8b2664531bef24861333c"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058782 - Update metadata for webtransport/datagrams.https.any.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315252\n", "files": ["testing/web-platform/meta/webtransport/datagrams.https.any.js.ini"], "git_node": "1216868c57d46e19c5563087de6baeb4146806e1", "git_parents": ["d35afdb47a20ec8c959bab439ea60dc393203038"], "node": "36d5f327b24ccbd3d4edccdaa40c4eebea1efc49", "parents": ["6dac6493b8fe41b23f06df3661a0e4c4aa0147b6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055442 - Extract the urlbar's URI fixup-info lookup to UrlbarUtils. r=mak\n\nUrlbarInput and SmartbarInput each carried a private _getURIFixupInfo that builds\nthe fixup flags and calls Services.uriFixup.getFixupURIInfo. Lift the body to a\nstatic UrlbarUtils.getURIFixupInfo(searchString, isPrivate) so the privileged\nurlbar-side modules (the UrlbarChild actor and UrlbarParentController) can reach the\nsame lookup when the fixup sites route over the seam. The inputs' _getURIFixupInfo\nnow delegates. Behavior-neutral.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312463\n", "files": ["browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "c409beea91005f2a188fc2d20117b943a1841985", "git_parents": ["1216868c57d46e19c5563087de6baeb4146806e1"], "node": "a20284050f2de5619f4ad7c342ed4d96780444b0", "parents": ["36d5f327b24ccbd3d4edccdaa40c4eebea1efc49"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055442 - Route the urlbar's display-time URI fixup reads through UrlbarChild. r=mak\n\nThe trimmed-URL display refinement and the on-focus untrim read URI fixup info and\nnormalize a URL through Services.uriFixup / Services.io, which a content-web input\ncan't reach. Route both through the privileged UrlbarChild actor, following the\nwhereToOpen pattern: getFixupInfo returns the keywordAsSent / preferred-URI\ndisplay-spec primitives (never an nsIURIFixupInfo), and getURIDisplaySpec parses a\nURL, so the input holds only strings. The display policy stays in the input.\n\nBehavior-neutral for the chrome address bar and search bars: the actor runs in the\ninput's own process, so these reads stay synchronous with the same results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312464\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "a6baf0c0141e64d6b49a9b8c7949fe9d64ad8bfc", "git_parents": ["c409beea91005f2a188fc2d20117b943a1841985"], "node": "f9e77a10a6ac27a88f2afd1e8954f3ae9c5086fd", "parents": ["a20284050f2de5619f4ad7c342ed4d96780444b0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055442 - Route the single-word keyword URI fixup check through the parent controller. r=mak\n\npickResult's single-word DNS check (gKeywordURIFixup.check) is per-window infobar\nUI that also needs the parent's search service to fix up the string, so it can't\nrun in a content input. Route it through UrlbarParentController.checkKeywordURIFixup,\ntargeting the same browser the load will use (fire-and-forget, mirroring\nspeculativeConnect); the parent rebuilds the fixup info locally and calls the\nunchanged gKeywordURIFixup global. The search string, not the non-cloneable\nnsIURIFixupInfo, crosses the seam.\n\nWith all three fixup sites routed, the inputs' _getURIFixupInfo is gone.\n\nBehavior-neutral for the address bar (chrome direct path runs synchronously). The\ncheck stays gated on isAddressbar: UrlbarInput was already gated (Bug 2054328);\nSmartbarInput now gains the gate too, so its smartbar/searchbar modes no longer run\nthe single-word DNS check -- an address bar behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312465\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "c1fbfb1315e64dede2f62d38f98290416934cd45", "git_parents": ["a6baf0c0141e64d6b49a9b8c7949fe9d64ad8bfc"], "node": "9370803e2123471707bf928605536de4c53381a3", "parents": ["f9e77a10a6ac27a88f2afd1e8954f3ae9c5086fd"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055646 - Convert urlbar pickResult/_loadURL to options-object signatures and make #loadURL private. r=mak\n\npickResult and _loadURL (mirrored in SmartbarInput) carried long positional\nparameter lists that forced filler like `null, false, browserId` at call\nsites. Both now take an options object, and _loadURL becomes the private\ncallers already compute.\n\nBehavior-neutral. The load still funnels through controller.loadURL, so tests\nthat previously stubbed _loadURL now stub that seam instead (aiwindow smartbar\ntests, browser_dns_first_for_single_words, browser_edit_invalid_url,\nbrowser_handleCommand_fallback).\n\nbrowser_privateFeature no longer reaches the load method directly; it drives\nthe private-window plumbing through handleNavigation. The original explicit\n`private: false` case has no public trigger (a private window can't open a\nnon-private one from the urlbar), so it is covered instead by opening from a\nnon-private window, which exercises the same isPrivate branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312598\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_chat_active_navigate.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_context_paste.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_suggestions.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_privateFeature.js", "browser/components/urlbar/tests/browser/browser_dns_first_for_single_words.js", "browser/components/urlbar/tests/browser/browser_edit_invalid_url.js", "browser/components/urlbar/tests/browser/browser_handleCommand_fallback.js"], "git_node": "daf5ed9ad12223850a33ed40a660100f594e9180", "git_parents": ["c1fbfb1315e64dede2f62d38f98290416934cd45"], "node": "76c7e787edd162ac3884ff3aa6730f297e094072", "parents": ["9370803e2123471707bf928605536de4c53381a3"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Pin the addressbar load's target browser at the Enter commit. r=mbeier,urlbar-reviewers\n\nThe URL-load branch in handleNavigation (#isAddressbar && URL.canParse, reached\nby a search-mode engine Enter) called #loadURL without a browserId, unlike the\nsibling pick and fixup paths. loadURL then resolves the target from the live\nselectedBrowser at load time. On the message path the load round-trips, so a tab\nswitched between the Enter and the load steals it, landing the load in the wrong\ntab. Pin the target browser at the Enter commit, matching the other load paths;\nthe capture is hoisted from the fixup branch so both share one.\n\nBehavior-neutral on the direct path, where the load is synchronous and the\npinned browser is the one loadURL would have resolved anyway. A content\nmoz-urlbar has no gBrowser, so browserId stays null and the parent resolves the\nactor's own tab. Greens up browser_switchTabs.js (slow_load) on the message path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313687\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "e690ee092e8dba13d15d9caad89f5d17043f8a59", "git_parents": ["daf5ed9ad12223850a33ed40a660100f594e9180"], "node": "e806c8dc8323cecb6dd8257d1656b72cfc87ca3a", "parents": ["76c7e787edd162ac3884ff3aa6730f297e094072"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058350 - Stop serving a window's documents once its Renderer is gone. r=gfx-reviewers,gw\n\nBefore the render-backend pool, stop_render_backend() sent\nSceneBuilderRequest::StopRenderBackend, which made the backend leave its main\nloop for a drain loop that discarded everything except external events, flush\nresponses and shutdown. Nothing could touch result_tx after that point.\n\nThe pool work turned stop_render_backend() into a plain scene-builder flush and\nleft the StopRenderBackend machinery orphaned. The window now stays registered\nand keeps being served until UnregisterWindow arrives, which happens much later\nin ~WebRenderAPI and since mRootApi is a RefPtr, not until every clone is\nreleased. In that gap DestroyRenderer has already dropped result_rx, so a\ntransaction that still reaches the backend panics in\nwin.result_tx.send(..).unwrap().\n\nReplace the flush with SceneBuilderRequest::StopWindow, sent on the\nlow-priority scene channel and forwarded to the backend, which marks the window\nstopped and acks. Taking that route is what makes it a barrier: it cannot\novertake work queued earlier on either scene channel, and because it comes back\nas a SceneBuilderResult the backend answers it in FIFO order with api-channel\ntraffic that skipped the scene builder entirely (UpdateDocuments, frame\nmessages).\n\nAlso add the missing mRendererDestroyed check to HandleWrTransactionEvents\n(reached from a RemoteTextureMap readiness callback that holds its own\nreference to the api), and remove the unreachable StopRenderBackend variants.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314935\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/scene_builder_thread.rs"], "git_node": "7f4e5f508d528765c3562b4577cbbccea3ff6b5e", "git_parents": ["e690ee092e8dba13d15d9caad89f5d17043f8a59"], "node": "3415cff10c05369b0b5c663768f31f7eab3704f5", "parents": ["e806c8dc8323cecb6dd8257d1656b72cfc87ca3a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058350 - Add render backend tests for window teardown. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314936\n", "files": ["gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/shutdown_test.rs"], "git_node": "d2acb3e18b1f88edc86ecf36833649fa93d2c955", "git_parents": ["7f4e5f508d528765c3562b4577cbbccea3ff6b5e"], "node": "dc2d2fa73757884cc3a362f72de1343bcc2cba66", "parents": ["3415cff10c05369b0b5c663768f31f7eab3704f5"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054662 - Add ownership check when registering a WebSocket event listener r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312269\n", "files": ["netwerk/ipc/NeckoParent.cpp", "netwerk/ipc/NeckoParent.h"], "git_node": "d2c41e52737d081ca27f784d21a0e997a54b0919", "git_parents": ["d2acb3e18b1f88edc86ecf36833649fa93d2c955"], "node": "c5380fd10dca25dbe0cae5b63104ddfa0e6cee02", "parents": ["dc2d2fa73757884cc3a362f72de1343bcc2cba66"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057768 - Improve atom subtable selection after HashString change. r=smaug\n\nThe low bits of string hashes are not that good.\n\nThis should actually improve pre-regression behavior as well, see\nbug 2051347 for some analysis and try runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314218\n", "files": ["xpcom/ds/nsAtomTable.cpp"], "git_node": "cd4b1ac23d8774e517df990ae4dc88da03802b8d", "git_parents": ["d2c41e52737d081ca27f784d21a0e997a54b0919"], "node": "fb385721200800a90fbdd0a010c1001915f4f5f7", "parents": ["c5380fd10dca25dbe0cae5b63104ddfa0e6cee02"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057864 - Don't send urlbar message-path notifications to a closed window global. r=Standard8\n\nA UrlbarParentController outlives the window global it belongs to: it registers a\nweak browser-search-engine-modified observer, so a later engine change still\nreaches a controller whose window has closed. Its parent-side child proxy then\ncalls sendAsyncMessage on a dead actor, which throws InvalidStateError. The stale\ncontrollers also accumulate, because the child's per-input Destroy message comes\nfrom a FinalizationRegistry that never runs when the whole window global goes\naway -- so every subsequent engine change throws once per window ever closed.\n\nTear the controllers down when the actor is destroyed, unregistering that\nobserver so an engine change stops reaching them at all, and route the proxies'\nsends through one guard for what can still arrive after teardown: work a\ncontroller already started -- a query, a provider's engagement hook -- resolves\nindependently of its window global.\n\nThe guard is narrower than the throw, deliberately. sendAsyncMessage throws on\n!CanSend() || !mManager || !mManager-\u003eCanSend(), and sendToChild tests only the\nmanager half; the actor's own CanSend() goes false at StartDestroy, before\ndidDestroy runs. JS has no way to read it, and a try/catch there would swallow\ngenuine serialization failures too. With the observer unregistered at teardown, I\nhave no path that reaches that window.\n\nConsole-only: a dropped notification had nowhere to arrive. The message path is\noff by default (browser.urlbar.ipc.chromeMessagePassing); with it on, this drops\nthe urlbar's share of the InvalidStateError reports in\nbrowser_searchModeSwitcher_basic.js. That file still logs some either way -- they\nshow up with the pref off too, at comparable volume, where these proxies are\nnever built, so another actor fails to send during window-global teardown. Worth\nknowing for review: this also doesn't change the file's three failures. Those\ncome from the message path having no synchronous engine-store init, so UrlbarInput\nfalls back to its after-paint path and a new window's switcher icon isn't set\nwhen the test asserts on it -- a separate defect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314273\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs"], "git_node": "9bc0833585d31e942670baeef1bd9c965f62f494", "git_parents": ["cd4b1ac23d8774e517df990ae4dc88da03802b8d"], "node": "a4888a0f5d307bf981fde4c265c3c669dd207b05", "parents": ["fb385721200800a90fbdd0a010c1001915f4f5f7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Route the switcher's engine-page opens over the message path. r=Standard8\n\nUrlbarParentControllerProxy had neither openSERP nor openSearchForm, so opening an\nengine's page directly from the search mode switcher (shift-click or shift-Enter on\nan engine, via openSearchEnginePage) threw \"openSearchForm is not a function\" on the\nmessage path and no page ever loaded. The parent-side implementations already resolve\ntheir window through the actor, so only the wire hop was missing: add the two proxy\nmethods and their actor cases. Both are fire-and-forget with cloneable arguments,\nlike the other navigation commands.\n\nBehavior-neutral on the direct path, which builds the real controller in place and\nnever consults the proxy.\n\nGreens open_engine_page_directly, the last message-path failure in\nbrowser_searchModeSwitcher_basic.js; the file now runs green over the wire with the\nsame assertion count as the direct path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314278\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "7f660eaef54fcfdeac019efa4ab29a813f395f34", "git_parents": ["9bc0833585d31e942670baeef1bd9c965f62f494"], "node": "d35e873b97330a310717ee30a8575bb225d866dc", "parents": ["a4888a0f5d307bf981fde4c265c3c669dd207b05"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 267369 - Document how Firefox records download origin metadata r=firefox-desktop-core-reviewers ,mossop DONTBUILD\n\nAdd a short page describing the platform-specific file metadata written when a\ndownload completes: the Zone.Identifier stream on Windows, kMDItemWhereFroms and\nquarantine metadata on macOS, and the metadata::download-uri GIO attribute on\nLinux.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315226\n", "files": ["toolkit/components/downloads/docs/index.md", "toolkit/components/downloads/moz.build", "toolkit/docs/index.md"], "git_node": "dcbf9d2aea551ca72cacd8328c08411fd0d67c32", "git_parents": ["7f660eaef54fcfdeac019efa4ab29a813f395f34"], "node": "d31008ff54189947d86f2098223af487584dd1f5", "parents": ["d35e873b97330a310717ee30a8575bb225d866dc"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2053159 r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311228\n", "files": ["gfx/gl/GLBlitHelper.cpp", "gfx/layers/GPUVideoImage.h"], "git_node": "f56986b9ff7b35d8ff3294ca201206adce25e6b4", "git_parents": ["dcbf9d2aea551ca72cacd8328c08411fd0d67c32"], "node": "42588f6e23f2cd8dd4ff5c8c766c2e9642682e2c", "parents": ["d31008ff54189947d86f2098223af487584dd1f5"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2057100 r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313928\n", "files": ["gfx/gl/SharedSurfaceD3D11Interop.cpp"], "git_node": "0324618b835b5f6a1eab30e6d7c24ca8b2a50f73", "git_parents": ["f56986b9ff7b35d8ff3294ca201206adce25e6b4"], "node": "bcc871ea97f97f79b8cb1b4cfd11a0ac25df79a4", "parents": ["42588f6e23f2cd8dd4ff5c8c766c2e9642682e2c"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2057577 - DOM Media - Add FFmpeg 63 support. r=alwu,frontend-codestyle-reviewers,Standard8\n\nRaise FFMPEG_MAX_MAJOR_VERSION to 63 and add the ffmpeg63 header tree\nso system/custom libavcodec.so.63 can be loaded. Keep libavcodec.so.62\nin the runtime linker search list after the max bump. Adapt to FFmpeg\n63 API removals: query sample rates via avcodec_get_supported_config,\nand pick the Vulkan transfer queue from AVVulkanDeviceContext::qf.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314026\n", "files": [".clang-format-ignore", ".prettierignore", "dom/media/platforms/ffmpeg/FFmpegAudioEncoder.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.cpp", "dom/media/platforms/ffmpeg/FFmpegLibWrapper.h", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/ffmpeg63/include/COPYING.LGPLv2.1", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/avcodec.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/avdct.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/bsf.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_desc.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_id.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/codec_par.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/defs.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/packet.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/vdpau.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavcodec/version_major.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/attributes.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/avconfig.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/avutil.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/buffer.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/channel_layout.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/common.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/cpu.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/dict.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/error.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/frame.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_drm.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_vaapi.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/hwcontext_vulkan.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/intfloat.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/log.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/macros.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/mathematics.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/mem.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/pixfmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/rational.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/samplefmt.h", "dom/media/platforms/ffmpeg/ffmpeg63/include/libavutil/version.h", "dom/media/platforms/ffmpeg/ffmpeg63/moz.build", "dom/media/platforms/ffmpeg/moz.build", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "df4c67dc9015f789b258e112450397049ca4337d", "git_parents": ["0324618b835b5f6a1eab30e6d7c24ca8b2a50f73"], "node": "762a761fcffa55f50874038f8d33de80c96e1112", "parents": ["bcc871ea97f97f79b8cb1b4cfd11a0ac25df79a4"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2057101 r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313927\n", "files": ["gfx/layers/d3d11/TextureD3D11.cpp"], "git_node": "99e6475d1acd78e1f140db6d94c9072426a5ab5c", "git_parents": ["df4c67dc9015f789b258e112450397049ca4337d"], "node": "92bfd4305f6b7c3c4ec82a389b7b45ff7179a4be", "parents": ["762a761fcffa55f50874038f8d33de80c96e1112"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045023 - Synchronously update descendant selectedcontent elements when option.selected changes. r=emilio\n\nImplements the relevant part of https://github.com/whatwg/html/pull/12263.\n\nSetOptionsSelectedByIndex enforces the selectedness invariant itself instead\nof going through RunSelectednessSettingAlgorithm, so it never schedules a\nselectedcontent update. Force one when it actually changes the selection,\nmatching select.value/select.selectedIndex, and add\nRunPendingSelectedContentUpdate() so the synchronous and microtask\nschedulers can't both fire for the same pending update.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314003\n", "files": ["dom/html/HTMLOptionElement.cpp", "dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSelectElement.h", "testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/selectedcontent.html.ini", "testing/web-platform/tests/html/semantics/forms/the-select-element/customizable-select/selectedcontent.html"], "git_node": "2cb8dfd1631c50557347102bdfe126f4a979492d", "git_parents": ["99e6475d1acd78e1f140db6d94c9072426a5ab5c"], "node": "84bee42fd8577194eac5d9dae361b9542b882bf8", "parents": ["92bfd4305f6b7c3c4ec82a389b7b45ff7179a4be"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057216 - Open the urlbar's engine-search Enter through the parent controller so it's content-safe. r=mbeier\n\nThe one-off and search-mode Enter paths resolved the engine with\nUrlbarSearchUtils (the search service) and built the SERP submission URL\ncontent-side (UrlbarUtils.getSearchQueryUrl -\u003e engine.getSubmission), neither of\nwhich a content-process \u003cmoz-urlbar\u003e can do. Resolve the engine from the\ncontent-side engineStore (id + name) and route the SERP open through\nUrlbarParentController.openSERP, which resolves the full engine and builds the\nURL parent-side.\n\nopenSERP now annotates the load as a search visit (globalHistoryOptions), so the\nPlaces search-visit tagging survives the move parent-side -- and the same\nannotation now also covers openSearchEnginePage's SERP path, which lacked it.\nopenSERP and openSearchForm also resolve the window via browserWindow (from the\nactor) rather than this.input.window, which is null on the message path.\n\nBehavior-neutral on the direct path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313798\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "4c750fdb1832a11aefd7b17836f3ab8aaa9b978a", "git_parents": ["2cb8dfd1631c50557347102bdfe126f4a979492d"], "node": "dcb69f6365ee2297b8e2c4b55891fe9f823984d4", "parents": ["84bee42fd8577194eac5d9dae361b9542b882bf8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057482 - Give the content realm one Urlbar actor port, and route the prefs shim through it. r=mbeier\n\nA content/expanded-principal \u003cmoz-urlbar\u003e (about:newtab) can't reach the Urlbar\nactor the way a chrome one does: windowGlobalChild.getActor(\"Urlbar\") is\n[ChromeOnly] and the actor is a system-principal object content can't hold. So\nUrlbarChild exposes its content-facing surface on the content window\n(Cu.waiveXrays + Cu.cloneInto) and UrlbarChildController picks it up behind a\ntypeof-ChromeUtils gate -- the window-exposure pattern the UrlbarPrefs shim\nestablished (bug 2053759). A content-realm input always takes the message path.\ndom/docs/scriptSecurity/index.md sanctions exportFunction/cloneInto as the way to\nhand a privileged surface to a less privileged scope.\n\nThat shim is folded in here rather than left alongside, so the content realm gets\none port instead of two unrelated window globals from the same actor: its three\npref methods move onto the port as getPref/addPrefObserver/removePrefObserver and\nUrlbarContentPrefs reads them there. Nothing else read window.UrlbarPrefs. This\nalso drops a publish that was happening in the parent process, where the shim is\nnever read -- the port is content-only.\n\nWhy not RemotePageChild: it already provides exactly this (RPMSendQuery and\nfriends, auto-exported to the page), but it pairs with RemotePageAccessManager,\nwhose allowlist is keyed by page URL. \u003cmoz-urlbar\u003e is a custom element usable on\nany page rather than one about: URL, so there is no URL to key on. The\nINVOKABLE_CONTENT_ACTIONS allowlist here is RemotePageAccessManager's idea applied\nto the inbound direction instead.\n\nWhy not an event bridge (the MigrationWizardChild shape, where the element\ndispatches and the actor answers): it fits the port's asynchronous half, but not\nits reason for existing. whereToOpenLink, getFixupInfo and getDisplaySpec are\nsynchronous privileged reads -- the child actor runs in the input's own process,\nso they are plain calls, and bug 2055442 routed them that way deliberately. Their\ncallers can't take an async answer: the on-focus untrim decision must be made\nbefore the value is set, and #getValueFromResult returns the display string. An\nevent can carry a request but not a synchronous reply; nothing in tree answers one\nthat way.\n\nsendQuery hands back a content-realm promise built by #wrapPromise, following the\nwrapPromise convention (RemotePageChild, ASRouterChild, AboutWelcomeChild). A\nrejection is re-created as a content-realm Error carrying only its message, so\nneither a system-principal object nor a chrome stack crosses over -- the same care\nAboutTranslationsChild takes.\n\nBecause the port hands a content process sendAsyncMessage/sendQuery,\nUrlbarParent.receiveMessage now treats its payload as untrusted, acting only on\nknown message names and live controllers. It does not yet scope a\ncaller-supplied browser id to the sender; that hardening is left to a follow-up.\n\nBehavior-neutral in chrome: the gate keeps chrome/parent on the direct getActor\npath and on the direct UrlbarPrefs import, and the port is only published in a\ncontent process. Verify the prefs move on the chrome side, since that shim is\nshared by both transports.\n\nThe exposed path stays unexercised until a real content \u003cmoz-urlbar\u003e exists, and\ntwo things still stand in the way, both outside this commit: UrlbarChildController\nuses ChromeUtils at module scope so it can't load in a content realm yet, and the\nactor's registration has no instantiation trigger, so in a content process nothing\nwould create the actor and publish the port in the first place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313984\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarContentPrefs.mjs"], "git_node": "174e73ca7acbe8a3b4e1d35e1a4f0c8e269d303f", "git_parents": ["4c750fdb1832a11aefd7b17836f3ab8aaa9b978a"], "node": "00aa61a6c12e04535816c23ee3f29954b084945a", "parents": ["dcb69f6365ee2297b8e2c4b55891fe9f823984d4"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058902 - Fix browser_ext_themes_multiple_backgrounds.js intermittent failure in windows jobs when Nova is enabled. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314934\n", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_dynamic_updates.js", "toolkit/components/extensions/test/browser/browser_ext_themes_multiple_backgrounds.js", "toolkit/components/extensions/test/browser/head.js"], "git_node": "c6ad102664f0a58500004c1547476c7285591c2e", "git_parents": ["174e73ca7acbe8a3b4e1d35e1a4f0c8e269d303f"], "node": "bededda8afdf147c17740aea523f45b1e6773d53", "parents": ["00aa61a6c12e04535816c23ee3f29954b084945a"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1699444 - Plumbing for private flag of tabs.create() r=geckoview-reviewers,android-reviewers,android-addons-reviewers,owlish,willdurand,twhite\n\nThis moves the private browsing specifier for tabs.create(),\nfrom the Fenix layer to the Android-Components layer, very close to the\nGeckoView layer. That paves the path for bug 1372178, eventually.\n\nMore importantly, this also fixes two functional defects:\n\n- The original implementation in Fenix was only cosmetic (bug 1699444).\n  Now the opened tab is really sharing state with private browsing tabs.\n\n- The original implementation relied on an active tab, and would\n  otherwise open a non-private tab (bug 2041306). The new implementation\n  checks the app's current private browsing mode and is more reliable.\n\nThis patch includes some unit tests to test interaction with A-C, a full\nend-to-end test involving Fenix will be added in bug 2054102.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311847\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngine.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/webextension/GeckoWebExtension.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineTest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/webextension/GeckoWebExtensionTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/webextension/WebExtension.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/webextension/WebExtensionDelegate.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/webextension/WebExtensionTest.kt", "mobile/android/android-components/components/support/webextensions/src/main/java/mozilla/components/support/webextensions/WebExtensionSupport.kt", "mobile/android/android-components/components/support/webextensions/src/test/java/mozilla/components/support/webextensions/WebExtensionSupportTest.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/SampleApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/FocusApplication.kt", "mobile/android/test_runner/src/main/java/org/mozilla/geckoview/test_runner/TestRunnerActivity.java"], "git_node": "156251d663b4be44576472cac329291ac64a1b4f", "git_parents": ["c6ad102664f0a58500004c1547476c7285591c2e"], "node": "9133a64d43a7e06eb6c79fcc654639598028273e", "parents": ["bededda8afdf147c17740aea523f45b1e6773d53"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1699444 - Reject tabs.create() call when PBM is not allowed r=android-reviewers,android-addons-reviewers,willdurand,twhite\n\nThe `tabs.create()` call does currently not have a way for extensions to\nspecify where the tab should be opened (bug 1372178), so the\nimplementation currently picks an arbitrary tab. But this could enable\nextensions without private browsing access to open tabs in private\nbrowsing mode (PBM), so we are adding a check to guard against it.\n\nAn alternative implementation is to open the tab in the regular browsing\nmode. But the user would not notice that, and it could be confusing if\nthe user returns to the non-private browsing mode and finds some\nseemingly random tab. So for now we just reject `tabs.create()` calls.\n\nExtensions hitting this would encounter \"Cannot create new tab\" from\nhttps://searchfox.org/firefox-main/rev/a07b2cb8ff33387a81968a7ed9d59ebdc4dad607/mobile/shared/modules/geckoview/GeckoViewTab.sys.mjs#151\n\nTestRunnerActivity does not recognize the concept of private browsing,\nso this patch only has tests for the A-C layer, not a mochitest.\nBug 2054102 will add a more thorough integration test involving Fenix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311848\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/webextension/GeckoWebExtension.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/webextension/GeckoWebExtensionTest.kt"], "git_node": "07ee9c98e87263519f262dae27448fc7ce856447", "git_parents": ["156251d663b4be44576472cac329291ac64a1b4f"], "node": "cb547f7ea0b51740a82e0d72cb90feb4fdc98a9e", "parents": ["9133a64d43a7e06eb6c79fcc654639598028273e"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 1748526 - Open action popups in matching private browsing mode on Android r=android-reviewers,android-addons-reviewers,willdurand,twhite\n\nCurrently, extension popups are unconditionally opened in non-private\nbrowsing mode. In contrast, on desktop extension popups are opened in\nthe private browsing mode of the window they are contained in.\n\nThis patch makes sure that any opened extension popup matches the\nprivate browsing state of the tab they are opened for.\n\nThe unit tests in this patch are limited to A-C interactions only;\na full integration test with Fenix will be added in bug 2054102.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311849\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngine.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/webextension/WebExtensionDelegate.kt", "mobile/android/android-components/components/support/webextensions/src/main/java/mozilla/components/support/webextensions/WebExtensionSupport.kt", "mobile/android/android-components/components/support/webextensions/src/test/java/mozilla/components/support/webextensions/WebExtensionSupportTest.kt"], "git_node": "f12502b4cf6c72813473700f6f4cf7d4c41e75fa", "git_parents": ["07ee9c98e87263519f262dae27448fc7ce856447"], "node": "dd346b9c459b9c59b8357e4b139bb41c66749309", "parents": ["cb547f7ea0b51740a82e0d72cb90feb4fdc98a9e"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2054102 - Add androidTest for extension in private browsing r=android-addons-reviewers,willdurand\n\nThis provides test coverage in Fenix for:\n- bug 1699444\n- bug 1748526\n- bug 2041306\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311850\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/TestWebExtensionInstaller.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/ExtensionPrivateBrowsingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/ThreeDotMenuMainRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/WebExtensionActionPopupRobot.kt", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/background.js", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/manifest.json", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/page.html", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/page.js", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/popup.html", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/popup.js"], "git_node": "3d0f4f563f9fbc75ed6e06d20f9c932a11b31679", "git_parents": ["f12502b4cf6c72813473700f6f4cf7d4c41e75fa"], "node": "d554b90d697bff9758817f67c5af8d000081fb7f", "parents": ["dd346b9c459b9c59b8357e4b139bb41c66749309"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2054102 - Support incognito:not_allowed for builtin extensions on Android r=android-addons-reviewers,willdurand\n\nThe `GeckoWebExtension.isAllowedInPrivateBrowsing()` check\nunconditionally returns true for builtin extensions. This is wrong, its\nvalue should reflect what the engine considers to be allowed, reflected\nin the metadata.\n\nBuiltins are indeed granted private browsing access by default, unless\nthey set `\"incognito\": \"not_allowed\"` in their manifest.json to opt out\nof private browsing access.\n\nThis functionality is depended on by ExtensionPrivateBrowsingTest.kt\nthat I will add in the next commit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311851\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/webextension/GeckoWebExtension.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/webextension/GeckoWebExtensionTest.kt"], "git_node": "d5285127094ff2b4a0f8b4019cc607e7dcf95c1d", "git_parents": ["3d0f4f563f9fbc75ed6e06d20f9c932a11b31679"], "node": "fb4570f459a0790f31ef01d7cddbcc1643a46212", "parents": ["d554b90d697bff9758817f67c5af8d000081fb7f"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2054102 - Add test for tabs.create() failing in private browsing r=android-addons-reviewers,willdurand\n\nThis provides the final piece of test coverage for bug 2041306, and\ndepends on support for `\"incognito\": \"not_allowed\"` for builtins,\nbecause there is currently no other easy way to test extensions without\nprivate browsing access on Fenix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311852\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/ExtensionPrivateBrowsingTest.kt", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_not_allowed_test/background.js", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_not_allowed_test/manifest.json"], "git_node": "febfdababb4d7b2d8c6146e5e903f147c6153305", "git_parents": ["d5285127094ff2b4a0f8b4019cc607e7dcf95c1d"], "node": "6e09a1dc9e3244e6f33c2948156a44c749ba187e", "parents": ["fb4570f459a0790f31ef01d7cddbcc1643a46212"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Bug 1968811 - Update WPT metadata for speculation rules prefetch timeouts\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini"], "git_node": "f143a929b733019acbf08cd784be35c1cbb5c224", "git_parents": ["febfdababb4d7b2d8c6146e5e903f147c6153305"], "node": "9a9f593630616438347546026349ac8d33b51481", "parents": ["6e09a1dc9e3244e6f33c2948156a44c749ba187e"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1968811 - Update WPT metadata for speculation rules prefetch timeouts\" for wrong commit bug.\n\nThis reverts commit f143a929b733019acbf08cd784be35c1cbb5c224.\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini"], "git_node": "db442833d04684cd09ca20374b8b1c04a6080b34", "git_parents": ["f143a929b733019acbf08cd784be35c1cbb5c224"], "node": "aac9f03241d769539d32d6d4887aa18019086a2e", "parents": ["9a9f593630616438347546026349ac8d33b51481"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054560 - Update WPT metadata for speculation rules prefetch timeouts\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini"], "git_node": "b5b64a71111682c3cafd3a73fc3358ac1691cbb1", "git_parents": ["db442833d04684cd09ca20374b8b1c04a6080b34"], "node": "6e97c4cfabafa9a8b2629c44a1790cac4d66be4c", "parents": ["aac9f03241d769539d32d6d4887aa18019086a2e"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2059417 - chore(webgpu): document reliance on `enum` discriminants matching for blend factors r=webidl,saschanaz DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D262249\n", "files": ["dom/webgpu/Utility.cpp", "dom/webidl/WebGPU.webidl"], "git_node": "09a90e0260dab15ee711ad561e5eb35160fd2fd4", "git_parents": ["b5b64a71111682c3cafd3a73fc3358ac1691cbb1"], "node": "d1c2b4dec90cdf43034b0ae2cb618c94e70f1328", "parents": ["6e97c4cfabafa9a8b2629c44a1790cac4d66be4c"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 1 - Remove InterpreterFrame RESUMED_GENERATOR flag. r=iain\n\nThis flag isn't actually needed. It was checked in `popInlineFrame` but\ngenerator/async frames are never constructing. We remove the flag here so later\npatches can add a new resuming-generator flag with a different meaning.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314913\n", "files": ["js/src/vm/GeneratorObject.cpp", "js/src/vm/Interpreter.cpp", "js/src/vm/Stack.h"], "git_node": "bc0fba47a276d6cbaaadc68a94b2fae905d7823d", "git_parents": ["09a90e0260dab15ee711ad561e5eb35160fd2fd4"], "node": "127e5f4744bcf531d441fc8365f7dbd17c1ec6a0", "parents": ["d1c2b4dec90cdf43034b0ae2cb618c94e70f1328"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 2 - Factor out InterpreterStack::createGeneratorResumeFrame. r=iain\n\nAlso renames `resumeGeneratorCallFrame` to `pushInlineGeneratorResumeFrame`, to be\nmore consistent with `pushInlineFrame` for regular calls.\n\nCurrently all generators and async functions go through `JSOp::Resume` and in the\nC++ interpreter this always pushes an inline (non-entry) frame, but later patches\nwill change this so that the activation's entry frame can also be a resumed\ngenerator or async function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314914\n", "files": ["js/src/frontend/Parser.cpp", "js/src/vm/Activation.h", "js/src/vm/GeneratorObject.cpp", "js/src/vm/Stack-inl.h", "js/src/vm/Stack.h"], "git_node": "6b4c79440fb2c47db0aebb6d3820e008eca04f5a", "git_parents": ["bc0fba47a276d6cbaaadc68a94b2fae905d7823d"], "node": "478d23a4789f26274bc50c9753d102b99ce6b3db", "parents": ["127e5f4744bcf531d441fc8365f7dbd17c1ec6a0"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 3 - Refactor AbstractGeneratorObject::resume so that it can be used for entry frames. r=iain\n\nMove the inline-interpreter-frame pushing out of `AbstractGeneratorObject::resume`\nso that we can later call `resume` for entry frames too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314915\n", "files": ["js/src/vm/GeneratorObject.cpp", "js/src/vm/GeneratorObject.h", "js/src/vm/Interpreter.cpp"], "git_node": "c9474b229d28338ea5628498b8dc275f9d21162c", "git_parents": ["6b4c79440fb2c47db0aebb6d3820e008eca04f5a"], "node": "edc295acce87e899c8f0e4d189a5573db714c85f", "parents": ["478d23a4789f26274bc50c9753d102b99ce6b3db"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 4 - Add GeneratorResumeState for resuming a generator or async function/module. r=iain\n\nThis adds a third `RunState` type that will be used for resuming a generator or\nasync script. This will make it possible to resume without going through\n`JSOp::Resume` in later patches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314916\n", "files": ["js/src/vm/Interpreter.cpp", "js/src/vm/Interpreter.h", "js/src/vm/Stack.cpp", "js/src/vm/Stack.h"], "git_node": "22fc76a27c3efc6335e77ed8d561a00c1ffd0a06", "git_parents": ["c9474b229d28338ea5628498b8dc275f9d21162c"], "node": "1a2de41107dff6ed94fea459407be488bdea9576", "parents": ["edc295acce87e899c8f0e4d189a5573db714c85f"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 5 - Resume async functions/generators via GeneratorResumeState. r=iain\n\nJIT support for `GeneratorResumeState` comes in a later patch. This patch adds\na check to `MaybeEnterJit` to force using the C++ interpreter for now.\n\n`AsyncFunctionResume` and `AsyncGeneratorResume` now call `js::ResumeGenerator`\ndirectly instead of going through self-hosted wrapper functions.\n\n`IsTopMostAsyncFunctionCall` (used by `JSOp::CanSkipAwait`) used to check for\nthese self-hosted wrapper functions. This is replaced with a flag on the activation\nto indicate the activation's entry frame is a resumed generator or async function.\nThis works because async functions and generators are always resumed from C++.\nLater patches will build on this to remove the expensive frame iteration completely.\n\n`JSOp::Resume` is now used only for plain/sync generator functions. The op is still\nrequired there because these generators are resumed from JS via `GeneratorNext`.\n\nThe `bug1644699-terminated-generator.js` test is removed because it depended on the\nremoved self-hosted resume code. We can't change this test to use sync generators\ninstead because these aren't closed by a terminated resume.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314917\n", "files": ["js/src/builtin/AsyncFunction.js", "js/src/builtin/AsyncIteration.js", "js/src/builtin/Promise.cpp", "js/src/builtin/moz.build", "js/src/jit-test/tests/debug/bug1644699-terminated-generator.js", "js/src/jit-test/tests/profiler/interpreter-stacks.js", "js/src/jit/Jit.cpp", "js/src/vm/Activation.h", "js/src/vm/AsyncFunction.cpp", "js/src/vm/AsyncIteration.cpp", "js/src/vm/CommonPropertyNames.h", "js/src/vm/GeneratorObject.cpp", "js/src/vm/GeneratorObject.h", "js/src/vm/Interpreter.cpp", "js/src/vm/Stack-inl.h", "js/src/vm/Stack.cpp", "js/src/vm/Stack.h"], "git_node": "6abf808ba09baf8de3e4d721fba37acddef4a35d", "git_parents": ["22fc76a27c3efc6335e77ed8d561a00c1ffd0a06"], "node": "211eb5fe09c1e62212d7b386563661b8af6a76e3", "parents": ["1a2de41107dff6ed94fea459407be488bdea9576"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 6 - Remove InterpretGeneratorResume and JSOp::ForceInterpreter. r=iain,frontend-codestyle-reviewers\n\nWith `GeneratorResumeState`, the cold generator-resume fallback no longer needs a\nself-hosted function forced into the C++ interpreter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314918\n", "files": ["js/src/builtin/.eslintrc.mjs", "js/src/builtin/Generator.js", "js/src/debugger/Script.cpp", "js/src/frontend/BytecodeEmitter.cpp", "js/src/frontend/BytecodeEmitter.h", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineJIT.cpp", "js/src/jit/VMFunctions.cpp", "js/src/jit/WarpBuilder.h", "js/src/vm/CommonPropertyNames.h", "js/src/vm/Interpreter.cpp", "js/src/vm/JSScript.h", "js/src/vm/Opcodes.h", "js/src/vm/PortableBaselineInterpret.cpp", "js/src/vm/SelfHosting.h"], "git_node": "7caf7be2710c59368a81d0e11fd80302e086a4d8", "git_parents": ["6abf808ba09baf8de3e4d721fba37acddef4a35d"], "node": "325d761980569ac7d4d3131c19b28ad899b82a9a", "parents": ["211eb5fe09c1e62212d7b386563661b8af6a76e3"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 7 - Remove the module handler function; store the module in the generator. r=iain\n\nAn async module's top-level-await generator previously stored a synthetic\nhandler function (wrapping the module script) in the generator's callee slot\nso that the generator machinery could be reused. It's now possible and cleaner\nto remove this function and store the module object directly.\n\n`CALLEE_SLOT` is renamed to `CALLEE_OR_MODULE_SLOT` and the accessors updated.\nMost uses of `callee()` now call `script()` instead.\n\n`GeneratorResumeState::pushInterpreterFrame` now resumes a module generator as an\nexecute/module frame.\n\nBecause `JSOp::Resume` is now only used for plain generators, the interpreter and\nJIT implementations can still assume the resumee is a function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314919\n", "files": ["js/src/debugger/Debugger.cpp", "js/src/debugger/Frame.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/WarpBuilder.cpp", "js/src/vm/GeneratorObject.cpp", "js/src/vm/GeneratorObject.h", "js/src/vm/Interpreter.cpp", "js/src/vm/Stack.cpp", "js/src/vm/Stack.h"], "git_node": "eb88cab8567526a1e010bb2b03fdfd4a0aac04c3", "git_parents": ["7caf7be2710c59368a81d0e11fd80302e086a4d8"], "node": "11a92941614bceb3d30ec532bf9153c9d3d169ee", "parents": ["325d761980569ac7d4d3131c19b28ad899b82a9a"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 8 - Make the Debugger's onResumeFrame/AfterYield code more consistent. r=iain\n\nThe C++ interpreter called `onResumeFrame` as part of the prologue. In the JITs\nthis happened as part of `JSOp::AfterYield`.\n\nThe JIT also had some code in `HandleDebugTrap` for when breakpoint/stepping reaches\n`AfterYield` (before the `onResumeFrame` call). In this case we called `DebugAfterYield`\nearly.\n\nThis patch makes our behavior more consistent. `JSOp::AfterYield` clears the\nis-resuming-generator flag, and before that point, debugger traps are suppressed\nfor the frame. This also helps us later when we can execute other bytecode\nops while this flag is set. `onResumeFrame` is now always called from\n`JSOp::AfterYield`. In `onResumeFrame` we then handle `onEnterFrame` and\nbreakpoints/stepping for the `AfterYield` op itself.\n\nIn `HandleDebugTrap` we still check for the `AfterYield` op instead of the frame's\n`isResumingGenerator` flag because the JITs don't have the flag yet at this point.\nA later patch changes this to match the interpreter.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314920\n", "files": ["js/src/debugger/DebugAPI.h", "js/src/debugger/Debugger.cpp", "js/src/jit/VMFunctions.cpp", "js/src/vm/Interpreter.cpp"], "git_node": "60f355addf08dbdb6520ec2dc1ec57ad43ba1738", "git_parents": ["eb88cab8567526a1e010bb2b03fdfd4a0aac04c3"], "node": "7eeae052e29a30b5d987001ae00aa25aa437c10b", "parents": ["11a92941614bceb3d30ec532bf9153c9d3d169ee"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 9 - Add a MacroAssembler::andPtr overload that takes an Address. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314921\n", "files": ["js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm-inl.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/mips64/MacroAssembler-mips64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/wasm32/MacroAssembler-wasm32-inl.h", "js/src/jit/x64/Assembler-x64.h", "js/src/jit/x64/BaseAssembler-x64.h", "js/src/jit/x64/MacroAssembler-x64-inl.h", "js/src/jit/x86/MacroAssembler-x86-inl.h"], "git_node": "e9ffed1ce057e020d6c80e27bf378157962b6f28", "git_parents": ["60f355addf08dbdb6520ec2dc1ec57ad43ba1738"], "node": "9ac940fe8f587bac478159274cabbec00ec79a78", "parents": ["7eeae052e29a30b5d987001ae00aa25aa437c10b"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 10 - Make Baseline JSOp::Resume callee-driven (resume via the prologue). r=iain\n\nInstead of building the resumed generator/async frame in the resumer\n(`emit_Resume`) and jumping straight to the resume point, `JSOp::Resume` now calls\nthe callee's Baseline entry like an ordinary call, and the callee's prologue\nrestores the suspended state and dispatches to the resume point.\n\nLater patches will build on this to support `GeneratorResumeState` (for C++ =\u003e JIT\nresume calls). This also enables resuming directly into Warp in the future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314922\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineFrame.cpp", "js/src/jit/BaselineFrame.h", "js/src/jit/JitFrames.h", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/VMFunctions.cpp", "js/src/vm/Stack.h"], "git_node": "8ca07121ad8d69d029ddd840cc229d265d329086", "git_parents": ["e9ffed1ce057e020d6c80e27bf378157962b6f28"], "node": "421edb7e4b1338ed46f4a9e175d94dfbf0e22882", "parents": ["9ac940fe8f587bac478159274cabbec00ec79a78"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 11 - Support using the interpreter stub for resuming a generator. r=iain\n\nThis lets us simplify `JSOp::Resume` more in Baseline because it no longer needs\na special code path for a generator without a `JitScript`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314923\n", "files": ["js/src/jit-test/tests/generators/resume-ion-lazy-link.js", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/Ion.cpp", "js/src/jit/JSJitFrameIter.cpp", "js/src/jit/VMFunctionList-inl.h", "js/src/jit/VMFunctions.cpp", "js/src/jit/VMFunctions.h"], "git_node": "2077dd65ad97d1f3665f6d8bb025f3b0cc3d9ee8", "git_parents": ["8ca07121ad8d69d029ddd840cc229d265d329086"], "node": "3da14bd1c3b00ffb0552406f25185f27c9564498", "parents": ["421edb7e4b1338ed46f4a9e175d94dfbf0e22882"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 12 - Resume suspended generator/async functions into Baseline from C++. r=iain\n\nThis adds a version of the `EnterJit` trampoline for resuming a generator\nor async function (or module script with top-level await). This is the `EnterJit`\nequivalent of the rewritten `emit_Resume` code in an earlier patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314924\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/Ion.cpp", "js/src/jit/Jit.cpp", "js/src/jit/JitRuntime.h", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/Trampoline.cpp", "js/src/jit/arm/Trampoline-arm.cpp", "js/src/jit/arm64/Trampoline-arm64.cpp", "js/src/jit/loong64/Trampoline-loong64.cpp", "js/src/jit/mips64/Trampoline-mips64.cpp", "js/src/jit/none/Trampoline-none.cpp", "js/src/jit/riscv64/Trampoline-riscv64.cpp", "js/src/jit/wasm32/Trampoline-wasm32.cpp", "js/src/jit/x64/Trampoline-x64.cpp", "js/src/jit/x86/Trampoline-x86.cpp", "js/src/vm/GeneratorObject.cpp", "js/src/vm/Stack.h"], "git_node": "bf8b8c9fe7fcd108d951984b2a0b3308fcfad62f", "git_parents": ["2077dd65ad97d1f3665f6d8bb025f3b0cc3d9ee8"], "node": "9be551f4325bd39ff4375c9f84d66a384257f5a2", "parents": ["3da14bd1c3b00ffb0552406f25185f27c9564498"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 13 - Support resuming a generator in the interpreter entry trampoline. r=iain\n\nWhen the interpreter entry trampoline is enabled, it has to copy the\n`ResumeFrameArgs` and propagate the `IsResumingGenerator` descriptor flag.\n\nA `BaselineInterpreterEntry` frame can now be called directly by a Baseline frame,\nwithout a stub frame, so `ComputeBaselineFrameSize` has to account for that too.\n\nAlso adds some jit-tests that failed without this change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314925\n", "files": ["js/src/jit-test/tests/async/resume-interpreter-entry-trampoline.js", "js/src/jit-test/tests/generators/resume-interpreter-entry-trampoline.js", "js/src/jit-test/tests/modules/top-level-await-interpreter-entry-trampoline.js", "js/src/jit/InterpreterEntryTrampoline.cpp", "js/src/jit/JSJitFrameIter.cpp"], "git_node": "0701743cfa6038449c2b98a5ea5727cf3af8fe31", "git_parents": ["bf8b8c9fe7fcd108d951984b2a0b3308fcfad62f"], "node": "e438a25f2126f453d50df21dc08a9dde95f786d7", "parents": ["9be551f4325bd39ff4375c9f84d66a384257f5a2"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 14 - Resume in JIT code for JSOp::Resume in the C++ interpreter. r=iain\n\nIf the generator has a `JitScript`, we can resume in JIT code now.  This is similar\nto what we do for calls.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314927\n", "files": ["js/src/vm/Interpreter.cpp"], "git_node": "31fa3ed8bebfee2d86936e2e68dc2d668bd20c5b", "git_parents": ["0701743cfa6038449c2b98a5ea5727cf3af8fe31"], "node": "572c2de1697defb06d194f675c422a50a164ecfc", "parents": ["e438a25f2126f453d50df21dc08a9dde95f786d7"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 15 - Don't emit the CanSkipAwait optimization for module scripts. r=iain\n\nFor modules with top-level-await, the fast path was never used because\n`IsTopMostAsyncFunctionCall` returned `false` in this case.\n\nNot emitting this check makes it easier to optimize `JSOp::CanSkipAwait` in\nthe next patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314928\n", "files": ["js/src/builtin/Promise.cpp", "js/src/frontend/BytecodeEmitter.cpp"], "git_node": "b95ceefcd8f9d019f7980aba31a477bc91d40d31", "git_parents": ["31fa3ed8bebfee2d86936e2e68dc2d668bd20c5b"], "node": "f4c2d34e27a7c3be0b33f1b40b112f45b65d6b75", "parents": ["572c2de1697defb06d194f675c422a50a164ecfc"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 16 - Avoid frame iteration for CanSkipAwait optimization. r=iain\n\nFrame iteration is expensive, especially for Ion frames when we can resume async\nfunctions directly in Ion.\n\nEach tier now only reaches `js::CanSkipAwait` when the current frame is the first\nframe of its activation. This is cheap to check in JIT code (but expensive in C++).\n\n`js::CanSkipAwait` then requires the activation to have been entered to resume\na suspended async function and to be the sole activation on the `JSContext`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314929\n", "files": ["js/src/builtin/Promise.cpp", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/jit/WarpBuilder.cpp", "js/src/vm/Interpreter.cpp"], "git_node": "b9a7d5ffc8183a04447cdbcbea9ed8a0e82fdc59", "git_parents": ["b95ceefcd8f9d019f7980aba31a477bc91d40d31"], "node": "273254d9b487cc382da36ff25abd5db0239ce9a2", "parents": ["f4c2d34e27a7c3be0b33f1b40b112f45b65d6b75"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 17 - Remove JSContext::asyncResumeDepth. r=iain\n\nThis was added in bug 2033499 to avoid frame iteration for `CanSkipAwait` in some\ncases, but we no longer need this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314930\n", "files": ["js/src/builtin/Promise.cpp", "js/src/vm/AsyncFunction.cpp", "js/src/vm/AsyncFunction.h", "js/src/vm/AsyncIteration.cpp", "js/src/vm/JSContext.cpp", "js/src/vm/JSContext.h"], "git_node": "1dedbdc992283777ab8e27d301393606034e73d7", "git_parents": ["b9a7d5ffc8183a04447cdbcbea9ed8a0e82fdc59"], "node": "b66597f5ce1b4f6996628967bf67886717468541", "parents": ["273254d9b487cc382da36ff25abd5db0239ce9a2"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058411 part 18 - Fix PBL build. r=iain\n\nThis was easier than expected because PBL currently doesn't run generator/async\nscripts at all. See bug 1922981 part 31 (D224683).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314931\n", "files": ["js/src/jit/Jit.cpp", "js/src/vm/PortableBaselineInterpret.cpp", "js/src/vm/PortableBaselineInterpret.h"], "git_node": "6faad569a82e61ecfb1259c729d357c9d5575b71", "git_parents": ["1dedbdc992283777ab8e27d301393606034e73d7"], "node": "f5e28c7f856bcf53fbce27e134579439ef86f154", "parents": ["b66597f5ce1b4f6996628967bf67886717468541"], "tags": []}, {"author": "Olivia \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051964 - Add Fission Testing to GeckoView Performance r=sparky,perftest-reviewers\n\nAdding these tests in anticipation of removing the `geckoview-no-fission` suite, so we have some overlap in results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310061\n", "files": ["taskcluster/kinds/browsertime/mobile.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "f55fe066c6d6eb450d326e278760960e08b79a91", "git_parents": ["6faad569a82e61ecfb1259c729d357c9d5575b71"], "node": "1c978ef6a440af5fd138220d8ab8001304b999e5", "parents": ["f5e28c7f856bcf53fbce27e134579439ef86f154"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015460: Don't keep the requesting browser window alive during a macOS passkey handshake. r=keeler\n\nMacOSAuthenticatorPresentationContextProvider held a strong reference to the requesting NSWindow for the lifetime of a passkey handshake. If the handshake stalled (the platform does not always invoke the completion callback) and the user then closed that window, the window had been -close'd but stayed retained, so it lingered as an invisible window that remains in Mission Control and captures mouse events over its old frame until Firefox is force-quit.\n\nStore the window number instead and resolve the presentation anchor lazily via -[NSApplication windowWithWindowNumber:], which returns nil once the window has closed. This removes the retain without depending on zeroing weak references (which are not enabled for our Objective-C++ sources).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310261\n", "files": ["dom/webauthn/MacOSWebAuthnService.mm"], "git_node": "c400639a9bb193918e4862e9615e095922f1e0de", "git_parents": ["f55fe066c6d6eb450d326e278760960e08b79a91"], "node": "90ecd9ed2608be25621a4c7124593201ce7e3c80", "parents": ["1c978ef6a440af5fd138220d8ab8001304b999e5"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059400 - Consolidate ScheduleSelectedContentUpdate into a single function with a mode enum. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315272\n", "files": ["dom/html/HTMLOptionElement.cpp", "dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSelectElement.h", "dom/html/HTMLSelectedContentElement.cpp"], "git_node": "698326402c5b7735b83accb1fb5fd398961d1dba", "git_parents": ["c400639a9bb193918e4862e9615e095922f1e0de"], "node": "37e8272a140f5a6f1eac3f839e509698f83b77b5", "parents": ["90ecd9ed2608be25621a4c7124593201ce7e3c80"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2059419 - Avoid a bugprone-use-after-move warning in DispatchOffThreadBaselineCompile r=jandem\n\nThe snapshots.clear() on the task allocation failure path is safe: when\nLifoAlloc::new_ fails it returns nullptr without running the constructor,\nso the list was never actually moved from. clang-tidy can't see that and\nreports bugprone-use-after-move.\n\nThe call only exists so that the LinkedList destructor doesn't hit its\ndebug \"list must be empty\" assertion, so unlink the snapshot directly\ninstead of going through the moved-from list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315285\n", "files": ["js/src/jit/BaselineJIT.cpp"], "git_node": "8db24a6a47a1dec7be60074f45a68afd6bcc30a1", "git_parents": ["698326402c5b7735b83accb1fb5fd398961d1dba"], "node": "21e0acc57c0d95f2a8a3437002ca89713f6ff6b5", "parents": ["37e8272a140f5a6f1eac3f839e509698f83b77b5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059159 - Wait for the searchbar to observe the new default engine in test_switch_engine. r=mbeier\n\nA test-only fix that has to precede the pref-on CI variant: test_switch_engine\nclicks the go button immediately after awaiting SearchService.setDefault(), and\non the message path the child's engine store still holds the previous default at\nthat moment, so the search submits to the old engine.\n\nWorth checking: the wait is inert on the direct path, where the store is updated\nsynchronously within setDefault(). The second wait, after the task's own cleanup\nsetDefault(), keeps the next task from running against a stale default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315239\n", "files": ["browser/components/urlbar/tests/browser/searchbar/browser_search.js"], "git_node": "7619b3f4c40a570f6b3f51d2e1523d1a6709246c", "git_parents": ["8db24a6a47a1dec7be60074f45a68afd6bcc30a1"], "node": "d2bd499defdc7ab980782efb6aefdf320761cb0e", "parents": ["21e0acc57c0d95f2a8a3437002ca89713f6ff6b5"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1964366 - Don't show the paste option in the addressbar if there's nothing to paste r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314965\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/InlineAutocompleteTextField.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/ui/InlineAutocompleteTextFieldTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/TextSelectionTest.kt"], "git_node": "ca365ae8fe2c7e6e747012486ce67b69a3cf6a7e", "git_parents": ["7619b3f4c40a570f6b3f51d2e1523d1a6709246c"], "node": "924d896c21c7bf6856531031383faf83d6109a39", "parents": ["d2bd499defdc7ab980782efb6aefdf320761cb0e"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["testing/web-platform/tests/subapps/insecure-context-error.tentative.html"], "git_node": "a9d4ecbaf7383afd25b05a135dacde66f5563f1b", "git_parents": ["ca365ae8fe2c7e6e747012486ce67b69a3cf6a7e", "878b64a4c024f657de81fb66a1e7de1aaad9109c"], "node": "ada0b18a274d98c3754a399a7d80f50e86bc10fa", "parents": ["924d896c21c7bf6856531031383faf83d6109a39", "ff789e9f149e00980fe9a47c69751b78848367fd"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054560 - more wpt metadata update\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini"], "git_node": "92c8e17430e3ebe32ea9414f044bacb8b846924f", "git_parents": ["a9d4ecbaf7383afd25b05a135dacde66f5563f1b"], "node": "876a78c8f635c97f8b4e06e1fd5c9f38937cc9fe", "parents": ["ada0b18a274d98c3754a399a7d80f50e86bc10fa"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054560 - Update WPT metadata for speculation rules prefetch timeouts\" for causing wpt failures\n\nThis reverts commit b5b64a71111682c3cafd3a73fc3358ac1691cbb1.\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini"], "git_node": "3479f396589ee9495bc12e8d000041c55e288181", "git_parents": ["92c8e17430e3ebe32ea9414f044bacb8b846924f"], "node": "731653d7a3b97df8167966ff246fba9a52f20851", "parents": ["876a78c8f635c97f8b4e06e1fd5c9f38937cc9fe"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054560 - more wpt metadata update\" for causing wpt failures\n\nThis reverts commit 92c8e17430e3ebe32ea9414f044bacb8b846924f.\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini"], "git_node": "15e14612e91af8f43b43b22dea4147fa7ceae1d9", "git_parents": ["3479f396589ee9495bc12e8d000041c55e288181"], "node": "2d1e424320975a5807ab852240100a111d618266", "parents": ["731653d7a3b97df8167966ff246fba9a52f20851"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045023 - Update WPT expectations for selectedcontent.html\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-select-element/customizable-select/selectedcontent.html.ini"], "git_node": "790de96b1a95978cc7e0c5af0fac6cc081ee83c6", "git_parents": ["15e14612e91af8f43b43b22dea4147fa7ceae1d9"], "node": "3a0a48698fc883a533822e4ec116091edbe96b9b", "parents": ["2d1e424320975a5807ab852240100a111d618266"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054560 - Update metdata for speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315319\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini"], "git_node": "a5811449e7f71f58e68d807810735f8982319b71", "git_parents": ["790de96b1a95978cc7e0c5af0fac6cc081ee83c6"], "node": "41bcef3a5286563828b1ba1df8fd2a7fed8f62f6", "parents": ["3a0a48698fc883a533822e4ec116091edbe96b9b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057205 - Don't repeat a non-repeating gradient because of rounding. r=gw\n\noptimize_radial_gradient shrinks a gradient's primitive rect to the bounding box\nof the interesting part of the ellipse and pushes the removed margins into\ntile_spacing. simplify_repeated_primitive then collapses that back into a single\ntile, but the tile size is stored as a ratio of the primitive rect while\ntile_spacing stays absolute, and the ratio is computed against the unsnapped rect\nand resolved against the snapped one at prepare time. The round-trip is therefore\nnot exact and could yield a stretch size a fraction of a pixel smaller than the\nprimitive rect, making prepare_repeatable_quad believe the primitive repeats.\n\nTwo fixes:\n\n - compute_stretch_ratio now reports exactly 1.0 on an axis where the tile\n   fuzzily covers the whole primitive rect, so a non-repeating primitive can't\n   be resurrected as a repeating one with a sub-pixel stride.\n\n - The CPU repetition loop now clips each tile to the primitive rect as well as\n   to the local clip rect. The last tile of a row or column always overhangs the\n   primitive rect and used to rely on the local clip rect bounding it, which is\n   not an invariant optimize_radial_gradient preserves. Without this the spurious\n   repetition rendered a complete, unclipped duplicate of the gradient.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314908\n", "files": ["gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender_api/src/prim_geometry.rs", "gfx/wr/wrench/reftests/gradient/radial-spurious-repeat-ref.yaml", "gfx/wr/wrench/reftests/gradient/radial-spurious-repeat.yaml", "gfx/wr/wrench/reftests/gradient/reftest.list"], "git_node": "bbe53c66dcee25735642f71b118b8977da5eb4e9", "git_parents": ["a5811449e7f71f58e68d807810735f8982319b71"], "node": "d51dd5d9e1a314d91be75eba2f5cd89bf1d07394", "parents": ["41bcef3a5286563828b1ba1df8fd2a7fed8f62f6"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046673 - Fix new sidebar: Tab key focuses individual history/bookmark items r=kcochrane,mstriemer\n\nOnly the active row of a `\u003csidebar-tab-list\u003e` or `\u003csidebar-bookmark-list\u003e` should be a tab stop. Other rows are reachable using arrow keys.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313049\n", "files": ["browser/components/sidebar/SidebarTreeView.sys.mjs", "browser/components/sidebar/sidebar-bookmark-list.mjs", "browser/components/sidebar/sidebar-bookmarks.mjs", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/sidebar-page.mjs", "browser/components/sidebar/sidebar-syncedtabs.mjs", "browser/components/sidebar/sidebar-tab-list.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_keyboard_navigation.js", "browser/components/sidebar/tests/browser/browser_history_keyboard_navigation.js", "testing/mochitest/tests/SimpleTest/AccessibilityUtils.js", "toolkit/content/widgets/moz-card/moz-card.mjs"], "git_node": "8d026cb01901edca33cfcf27cdb50d333512a8fd", "git_parents": ["bbe53c66dcee25735642f71b118b8977da5eb4e9"], "node": "5635c6df780467db9a7b4a167a3ba255162289f4", "parents": ["d51dd5d9e1a314d91be75eba2f5cd89bf1d07394"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047706 - Add pref and option for regexp buffer boundaries; r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315024\n", "files": ["js/src/jsapi.cpp", "js/src/jsapi.h", "js/src/shell/js.cpp", "js/xpconnect/src/XPCJSContext.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "ea87517b3c01775ed603ad3d380d194a443b5e6e", "git_parents": ["8d026cb01901edca33cfcf27cdb50d333512a8fd"], "node": "c4a9dd0c21359b955ad4daa6919219fbb5766ab2", "parents": ["5635c6df780467db9a7b4a167a3ba255162289f4"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047706 - Import buffer boundary Test262 tests; r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315025\n", "files": ["js/src/tests/test262-update.py", "js/src/tests/test262/prs/4975/annexB/browser.js", "js/src/tests/test262/prs/4975/annexB/built-ins/RegExp/browser.js", "js/src/tests/test262/prs/4975/annexB/built-ins/RegExp/buffer-boundaries/browser.js", "js/src/tests/test262/prs/4975/annexB/built-ins/RegExp/buffer-boundaries/not-supported-outside-unicode-modes.js", "js/src/tests/test262/prs/4975/annexB/built-ins/RegExp/buffer-boundaries/shell.js", "js/src/tests/test262/prs/4975/annexB/built-ins/RegExp/shell.js", "js/src/tests/test262/prs/4975/annexB/built-ins/browser.js", "js/src/tests/test262/prs/4975/annexB/built-ins/shell.js", "js/src/tests/test262/prs/4975/annexB/shell.js", "js/src/tests/test262/prs/4975/browser.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/browser.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/browser.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/shell.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/slash-lower-case-z-matches-end-of-buffer-u-mode.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/slash-lower-case-z-matches-end-of-buffer-v-mode.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/slash-upper-case-a-matches-start-of-buffer-u-mode.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/slash-upper-case-a-matches-start-of-buffer-v-mode.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/slash-upper-case-z-matches-lineterminatorsequence-end-of-buffer-u-mode.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/slash-upper-case-z-matches-lineterminatorsequence-end-of-buffer-v-mode.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/syntax/browser.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/syntax/shell.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/syntax/u-mode.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/buffer-boundaries/syntax/v-mode.js", "js/src/tests/test262/prs/4975/built-ins/RegExp/shell.js", "js/src/tests/test262/prs/4975/built-ins/browser.js", "js/src/tests/test262/prs/4975/built-ins/shell.js", "js/src/tests/test262/prs/4975/shell.js", "js/src/tests/test262/prs/4975/staging/browser.js", "js/src/tests/test262/prs/4975/staging/shell.js", "js/src/tests/test262/prs/4975/staging/sm/RegExp/browser.js", "js/src/tests/test262/prs/4975/staging/sm/RegExp/shell.js", "js/src/tests/test262/prs/4975/staging/sm/RegExp/unicode-disallow-extended.js", "js/src/tests/test262/prs/4975/staging/sm/browser.js", "js/src/tests/test262/prs/4975/staging/sm/shell.js"], "git_node": "5a82e81296d450a2a0145a42b78e7c6d45ddc858", "git_parents": ["ea87517b3c01775ed603ad3d380d194a443b5e6e"], "node": "96bb9bb8dfde0304652bfbf777728a20bb24e66a", "parents": ["c4a9dd0c21359b955ad4daa6919219fbb5766ab2"], "tags": []}, {"author": "DrSeed Lu \u003cdr.seed.lu@gmail.com\u003e", "branch": "default", "desc": "Bug 2039596 - Add a sort menu to the sidebar open tabs panel r=nsharpley,kcochrane,fluent-reviewers,desktop-theme-reviewers,bolsson\n\nAdds a three-dot options menu to the Open Tabs sidebar panel with a \"Sort\nby\" section (Tab order and Most recent) and a \"Connect another device\"\nlink, matching the History panel's options menu.\n\nThe sort choice is applied by passing the recency flag to\ngetTabsForWindow, and persisted across visits via the new\nsidebar.openTabsPanel.sortOption pref. Sorting by date and site, and the\ndevice-dependent \"Show tabs\" options, are left for follow-up bugs\n(2039604 and the synced-tabs work).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314728\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/main-popupset.inc.xhtml", "browser/components/sidebar/sidebar-opentabs.css", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/tests/browser/browser_opentabs_sidebar.js", "browser/locales/en-US/browser/sidebar.ftl"], "git_node": "8d2eb5da8d33f5fe3c47b98894a525c42892c4ec", "git_parents": ["5a82e81296d450a2a0145a42b78e7c6d45ddc858"], "node": "cf4258c919707f8d3acccbd9fb6c7a0199a68247", "parents": ["96bb9bb8dfde0304652bfbf777728a20bb24e66a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2059423 - Reduce inline stack size of StyleSharingCandidate. r=firefox-style-system-reviewers,dshin\n\nPresentation attributes and part attributes aren't that common to\nguarantee so much inline space, and the regressing bug changed sizes of\nthings enough to overflow the stack of the style threads (which is a lot\nsmaller by default).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315288\n", "files": ["servo/components/style/sharing/mod.rs"], "git_node": "e6763beac94923ceab1e6258c1d3e9d7acc98cb8", "git_parents": ["8d2eb5da8d33f5fe3c47b98894a525c42892c4ec"], "node": "ee149f5f36fa42a2b344d3699ef55448dba905e5", "parents": ["cf4258c919707f8d3acccbd9fb6c7a0199a68247"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054763. r=places-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312543\n", "files": ["browser/components/places/InteractionsChild.sys.mjs", "browser/components/places/InteractionsParent.sys.mjs"], "git_node": "ed531ed39876345345bdcd7c767b3bf98317845c", "git_parents": ["e6763beac94923ceab1e6258c1d3e9d7acc98cb8"], "node": "cb3166b1dff5cb060c44713ac67420bb2be1bad9", "parents": ["ee149f5f36fa42a2b344d3699ef55448dba905e5"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2058959 - Update Nova icons with acorn-icons upstream r=android-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315149\n", "files": ["mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_audio_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_audio_muted_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_screenshot_24.xml", "mobile/android/android-components/samples/acorn-components/src/main/java/org/mozilla/samples/acorn/components/ui/IconsScreen.kt"], "git_node": "62ac3552aad561cdcf7d3c4c408c68571595a2af", "git_parents": ["ed531ed39876345345bdcd7c767b3bf98317845c"], "node": "ef81a6e01ed538d12b1aa4c3ae747e38d79961c7", "parents": ["cb3166b1dff5cb060c44713ac67420bb2be1bad9"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2054667 - ValidatePrincipal in PServiceWorkerRegistration, r=dom-worker-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313528\n", "files": ["dom/serviceworkers/ServiceWorkerRegistration.cpp", "ipc/glue/BackgroundParentImpl.cpp"], "git_node": "92784e8e3d57fb585cc265504e4d6fa0731bc78f", "git_parents": ["62ac3552aad561cdcf7d3c4c408c68571595a2af"], "node": "2caa21dfe53845b286658d68af3dae7b83e31089", "parents": ["ef81a6e01ed538d12b1aa4c3ae747e38d79961c7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059379 - Wait for the engine store before entering the default-engine search mode. r=mbeier,urlbar-reviewers\n\nsearchModeShortcut() read the store's default engine synchronously. The store is\npopulated by an actor message on the message path, so in a fresh window that read\ncomes back empty and the mode is built with a search source and no engine -- a\nshape with no local-search-mode entry, so the switcher throws resolving its\nlabel.\n\nAwaiting the store first is inert on the direct path, where it is already\npopulated by the time the shortcut runs. Behavior does change when the search\nservice has failed: the shortcut now leaves search mode alone rather than\nentering that same engine-less mode.\n\nBoth inputs carried identical copies of this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315267\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "c569e5fdf73a3886e75e842daec43b8a630f5b53", "git_parents": ["92784e8e3d57fb585cc265504e4d6fa0731bc78f"], "node": "8c1cd932a2a6d287a137e21c6a3915a857568f1d", "parents": ["2caa21dfe53845b286658d68af3dae7b83e31089"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2054674 - ValidatePrincipal in PServiceWorker, r=dom-worker-reviewers,asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313527\n", "files": ["dom/serviceworkers/ServiceWorker.cpp", "ipc/glue/BackgroundParentImpl.cpp"], "git_node": "f48a4a1ef09e19558f03346ea6083bc0b14fcc7e", "git_parents": ["c569e5fdf73a3886e75e842daec43b8a630f5b53"], "node": "d623c46ef3892b320fbca5bad9807ba479d43fdb", "parents": ["8c1cd932a2a6d287a137e21c6a3915a857568f1d"], "tags": []}, {"author": "Sameem-baba \u003cssssameembaba@gmail.com\u003e", "branch": "default", "desc": "Bug 1988723 - Remove support for 'contexts' argument in 'session.unsubscribe'. r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315070\n", "files": ["remote/webdriver-bidi/modules/root/session.sys.mjs"], "git_node": "83f766378cc6d9a762991e4ecad1fb69d7cffbe5", "git_parents": ["f48a4a1ef09e19558f03346ea6083bc0b14fcc7e"], "node": "26e832aa20ff68fef0db2661507684bc0b4c5d37", "parents": ["d623c46ef3892b320fbca5bad9807ba479d43fdb"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2057175 - Fix persisting previews and scroll up behaviour when mouse leaves autocomplete dropdown panel. r=mtigley,credential-management-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313831\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_preview_cleared_on_pointer_leave.js", "toolkit/components/satchel/test/browser/browser_popup_mouseover.js", "toolkit/content/widgets/autocomplete-popup.js"], "git_node": "521d75724f3327196fda6cf843d66da713140315", "git_parents": ["83f766378cc6d9a762991e4ecad1fb69d7cffbe5"], "node": "7f7f163f48a6b6533e16a41c9db4eb5236ff9f46", "parents": ["26e832aa20ff68fef0db2661507684bc0b4c5d37"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051071: Don't let a tab detached from a fullscreen window enter native fullscreen on its initial show on macOS. r=mac-reviewers,firefox-desktop-core-reviewers ,tabbrowser-reviewers,bradwerth,mconley,jswinarton\n\nWhen a tab is dragged out of a window that is in native macOS fullscreen, the front-end opens a new top-level browser window. Because a fullscreen space is active, macOS adopts the new window into its own fullscreen space during its initial show, which goes through a synchronous XPC transition to the Dock. On recent macOS versions that transition can deadlock the main thread, leaving Firefox unresponsive until it is force quit.\n\nThis plumbs a one-shot CHROME_SUPPRESS_INITIAL_FULLSCREEN flag from the tab-detach code through to the Cocoa widget. When set, Show() temporarily marks the window as not supporting native fullscreen for its initial display, the same mechanism already used for popups, alerts, and always-on-top windows, and restores it right after. The window can still be taken into fullscreen afterwards via the green button.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310696\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "toolkit/components/windowwatcher/test/browser_new_content_window_chromeflags.js", "widget/InitData.h", "widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm", "xpfe/appshell/nsAppShellService.cpp"], "git_node": "9e88ac7a151315a68eadca1b902b87e408203730", "git_parents": ["521d75724f3327196fda6cf843d66da713140315"], "node": "1cc4f9a4f21428361802e82e2239de05b57b3d75", "parents": ["7f7f163f48a6b6533e16a41c9db4eb5236ff9f46"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1952164 - Check for register uses in LIRGenerator::visitInt32ToIntPtr. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314393\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MIR.h"], "git_node": "4abff7d74bb3b370ac33c12936fc4cdcfdba16f6", "git_parents": ["9e88ac7a151315a68eadca1b902b87e408203730"], "node": "8a5693143cd14a479271be11db9ecfd3a3fcad33", "parents": ["1cc4f9a4f21428361802e82e2239de05b57b3d75"], "tags": []}, {"author": "Jim Blandy \u003cjimb@red-bean.com\u003e", "branch": "default", "desc": "Bug 2045777: In pixman fast rotate path, round in 64 bits. r=gfx-reviewers,lsalzman\n\nIn libpixman's fast path for rotations by multiples of 90 degrees,\nround translation amounts in `pixman_fixed_48_16_t`, not\n`pixman_fixed_16_16_t`, as the matrix values are provided by the user,\nso rounding could overflow a 32-bit type. Since the results always\nrepresent values \u003c 65537, `pixman_fixed_to_int` can always safely\nconvert them back to 32-bit ints.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314824\n", "files": ["gfx/cairo/README", "gfx/cairo/libpixman/src/pixman-fast-path.c", "gfx/cairo/pixman-translation-round-in-wide.patch", "gfx/tests/crashtests/2045777.html", "gfx/tests/crashtests/crashtests.list"], "git_node": "594a616652da6f0fd80b5e3c9bd2624118b71554", "git_parents": ["4abff7d74bb3b370ac33c12936fc4cdcfdba16f6"], "node": "1bea5a7881eed37f81833d838da289503d1779a9", "parents": ["8a5693143cd14a479271be11db9ecfd3a3fcad33"], "tags": []}, {"author": "Florin Bilt \u003cfbilt@mozilla.com\u003e", "branch": "default", "desc": "Bug 1978597 - Fix formatting and process for inactive alert templates in perf-sheriffing docs r=perftest-reviewers,afinder\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313982\n", "files": ["testing/perfdocs/generated/perf-sheriffing.md", "testing/performance/perf-sheriffing/perfdocs/index.md"], "git_node": "a75c5fc89d5a78ebca14576c68207f211c64b4d6", "git_parents": ["594a616652da6f0fd80b5e3c9bd2624118b71554"], "node": "cd76e0e0549be6371e8a8f2af4e233637a45e684", "parents": ["1bea5a7881eed37f81833d838da289503d1779a9"], "tags": []}, {"author": "Florin Bilt \u003cfbilt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058172 - Disable android ytp power tests in the general-perf-testing cron r=perftest-reviewers,taskgraph-reviewers,sparky,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314404\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py"], "git_node": "9c9caf7a451e8eaa303f18721da4003c8b41d878", "git_parents": ["a75c5fc89d5a78ebca14576c68207f211c64b4d6"], "node": "b715cdbbd5220f91d659db6a8592612e9802bc0e", "parents": ["cd76e0e0549be6371e8a8f2af4e233637a45e684"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053418 - Part 1: Allow asrouter-newtab-message buttons to override their moz-button type. r=omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314119\n", "files": ["browser/components/asrouter/content/components/asrouter-newtab-message/asrouter-newtab-message.mjs", "browser/components/asrouter/docs/asrouter-newtab-message.md", "browser/components/asrouter/tests/browser/browser_asrouter_newtab_messages.js"], "git_node": "c349d8d66e122e3816d608add137a78aeb651b3c", "git_parents": ["9c9caf7a451e8eaa303f18721da4003c8b41d878"], "node": "454ff312181a7e5e5b625110e178b3681b65d535", "parents": ["b715cdbbd5220f91d659db6a8592612e9802bc0e"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053418 - Part 2: Let asrouter-newtab-message reformulate content from polled declarative state targeting. r=omc-reviewers,thecount,sachung,mimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314120\n", "files": ["browser/components/asrouter/content/components/asrouter-newtab-message/ASRouterNewTabMessageChild.sys.mjs", "browser/components/asrouter/content/components/asrouter-newtab-message/ASRouterNewTabMessageParent.sys.mjs", "browser/components/asrouter/content/components/asrouter-newtab-message/asrouter-newtab-message.mjs", "browser/components/asrouter/docs/asrouter-newtab-message.md", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_newtab_messages.js", "browser/extensions/newtab/lib/ExternalComponentsFeed.sys.mjs"], "git_node": "05a2c4435bd7b3e39ee9592c7f3a0a044928b3f6", "git_parents": ["c349d8d66e122e3816d608add137a78aeb651b3c"], "node": "3df8c373bc6678f29d6d4db92c74c63bb71171a2", "parents": ["454ff312181a7e5e5b625110e178b3681b65d535"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058645 - Clear a stale user value when an incoming pref update flips the type. r=gstoll\n\nPref keeps its default and user values in a union governed by a single shared\ntype tag. FromDomPref applies the incoming default value first, so when that\nvalue changes the type it leaves mUserValue holding a member of the old type,\nwhich the user-value handling right below then reads as the new type.\n\nA content process can hold a user value whose type no longer matches the\nparent's, because ContentParent::Observe deliberately drops updates for prefs\nthat ShouldSanitizePreference() classifies as sanitized, and that\nclassification applies only while a dynamically named pref is a String without\na default value.\n\nClear such a user value before the type tag changes, while Clear() can still\nmatch the type it was actually stored as.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315248\n", "files": ["modules/libpref/Preferences.cpp"], "git_node": "36791c923c6525549e85d00f016a02dede8be6c8", "git_parents": ["05a2c4435bd7b3e39ee9592c7f3a0a044928b3f6"], "node": "47a0aa7d8d50504212996e0a5d45b37603bd1d7d", "parents": ["3df8c373bc6678f29d6d4db92c74c63bb71171a2"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2059337 - Fix verifyTheChangeAppIconButtonTest efficiency UI test r=aaronmt\n\nThe UI test was flaky because it clicked the \"Homepage\" setting instead of the \"Customize\" setting option.\n\nBased on past problems encountered with our \"legacy\" tests in some cases espresso clicks the wrong elements.\n\nBecause of this, I've switched from the ESPRESSO_BY_TEXT to UIAUTOMATOR_WITH_TEXT selector strategy.\n\nThe UI test successfully passed 50x on Firebase \u2705 (without the retry rule)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315274\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSelectors.kt"], "git_node": "d21912fbd533f7a180465fdbf63fcff4ab0ed5e1", "git_parents": ["36791c923c6525549e85d00f016a02dede8be6c8"], "node": "ab0c161c20f00c2a19800a530ebf85f4e4338f83", "parents": ["47a0aa7d8d50504212996e0a5d45b37603bd1d7d"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058588 - Mock out installation discovery in test_new_profile.js. r=janerik\n\nThe non-MSIX case only worked because under xpcshell\n`Services.appinfo.name` is undefined, and it'd be unusual to have anything\nunder HKLM\\Software\\Mozilla\\undefined\\TaskBarIDs (or HKCU).\n\nFor both, avoid running the actual code and replace with mocks that return\nempty arrays/sets. In theory we could now check that the fields are\npopulated correctly, but (a) that'd be more refactoring of the test (maybe\ninvolving removing the legacy mirroring), and (b) it's out of scope for\nthis bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314744\n", "files": ["toolkit/components/telemetry/tests/unit/test_new_profile.js"], "git_node": "5196821075557b6252fcfd23dee447d87cf2e47a", "git_parents": ["d21912fbd533f7a180465fdbf63fcff4ab0ed5e1"], "node": "13865aeedef60caec51b003228739652ef7e06f1", "parents": ["ab0c161c20f00c2a19800a530ebf85f4e4338f83"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2059430: Simplify writing new profile preferences. r=niklas\n\nThis also removes the additional write of DAU_GROUPID_PREF_NAME which will have already been read from the database.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315298\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs"], "git_node": "2cc2dbb3a5f04acfda5d55cc62de6450612fd48e", "git_parents": ["5196821075557b6252fcfd23dee447d87cf2e47a"], "node": "09c18cb098e865ad51bc47942c9d4898c18fb809", "parents": ["13865aeedef60caec51b003228739652ef7e06f1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021346 - Resolve a bounce snapshot before awaiting a pre-empted bounce's trigger. r=urlbar-reviewers,mak\n\nAn engagement while a bounce is already tracked triggers that bounce first, and\nthe child collector awaited it before reading the session and the live\ninput/view its own snapshot needs. By then the engagement record that follows\nthe tracking call has ended the session, so the new bounce was built from no\nsession and dropped: on the message path, re-engaging the address bar in a tab\nstopped bounces from being recorded for every search after the first. The\nparent-side recorder already reads its session up front, so the direct path is\nunaffected.\n\nWorth checking: the moved reads (session, engagement data, smartbar data) are\nall live input/view state that must be read at pick time, and nothing between\nthem and their uses depends on the trigger having run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314874\n", "files": ["browser/components/urlbar/content/UrlbarChildTelemetry.mjs"], "git_node": "c1243b5a590be259c737d2dabd2fa961185ab654", "git_parents": ["2cc2dbb3a5f04acfda5d55cc62de6450612fd48e"], "node": "4a42e5ebaeabf830f9cabee214d73af0a3aef713", "parents": ["09c18cb098e865ad51bc47942c9d4898c18fb809"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021346 - Test the sap key of the urlbar bounce and disable events. r=urlbar-reviewers,mak\n\nOne file per event, built on head-sap.js like the engagement and abandonment sap\ntests, which gains an option for the search string so a test can search for a\nSuggest keyword.\n\nBoth events are recorded after the search they report on has ended, so their sap\nis resolved from whatever page shows at that later moment. The flows are shaped\nto keep the expected value unambiguous -- bounces trigger by navigating back to\nthe page the search started from, and the disable cases either abandon the\nsearch or start it on a regular page -- which is what the comments in the two\nfiles explain.\n\nWorth checking are the cases that assert no event: the disable event can only\ncarry a sap where a Suggest result can be visible, which rules out the searchbar\n(no Suggest provider) and a handoff session (engine search mode). Relatedly, a\nbounce from a handoff session needs a picked result, since Enter in search mode\nloads the engine's search URL without picking one.\n\nTelemetryEvent.reset(), which the tests call between tasks, now also drops a\npending disable candidate, so a candidate an earlier task left behind can't\nrecord into a later task's assertions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314875\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/tests/browser-engagementTelemetry/browser.toml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_bounce_sap.js", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_disable_sap.js", "browser/components/urlbar/tests/browser-engagementTelemetry/head-sap.js"], "git_node": "897f2096901824e50cb757da4c7f02ceba8db114", "git_parents": ["c1243b5a590be259c737d2dabd2fa961185ab654"], "node": "0e03def033b0bf0e3c548f36a494e5f7fd1ce00c", "parents": ["4a42e5ebaeabf830f9cabee214d73af0a3aef713"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058666 - Clear mDocumentChildren after XSLT branch consumes it in DidBuildModel. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314950\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "fe767d7ea7a6cfdc705fa7b780686a88b49df85a", "git_parents": ["897f2096901824e50cb757da4c7f02ceba8db114"], "node": "d46ad447ea193ef4ac0d29f8c3f41d70b638e8b6", "parents": ["0e03def033b0bf0e3c548f36a494e5f7fd1ce00c"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059441 - Disable some macOS driver bug workarounds on Metal ANGLE. r=gfx-reviewers,nical\n\nMetal ANGLE does not appear to be affected by these driver bugs. And\nsince it does not support GPU migration we don't need to\npessimistically apply them even on unaffected GPUs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315304\n", "files": ["gfx/wr/webrender/src/device/gl.rs"], "git_node": "bea8db6aa32da62281241b8163b9b067be6a50aa", "git_parents": ["fe767d7ea7a6cfdc705fa7b780686a88b49df85a"], "node": "a7617b22387dd1fd449ded7bbcaad68355bee5c4", "parents": ["d46ad447ea193ef4ac0d29f8c3f41d70b638e8b6"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2056652 - Wait for the update doorhanger panel to be fully shown before clicking its button, r=application-update-reviewers,yjuglaret.\n\nAlso re-enables browser_doorhanger_sp_patch_partialApplyFailure.js, which was\nskipped in bug 2057934 for the a11y checks failure this fixes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314314\n", "files": ["toolkit/mozapps/update/tests/browser/browser.toml", "toolkit/mozapps/update/tests/browser/head.js"], "git_node": "e7a0b9b00b177917b96257bb2651bfd8bd4fafd7", "git_parents": ["bea8db6aa32da62281241b8163b9b067be6a50aa"], "node": "36ee42879f9856b96205a50a5fac972008afbdfd", "parents": ["a7617b22387dd1fd449ded7bbcaad68355bee5c4"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057087 - Fix blank strip in DOM fullscreen video for Nova + Vertical Tabs + Expand on Hover. r=sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314720\n", "files": ["browser/components/sidebar/tests/browser/browser_domfullscreen_sidebar.js", "browser/themes/shared/sidebar.css"], "git_node": "d0be2f3d44d694e68c76698b36a3ad3ce8c21f77", "git_parents": ["e7a0b9b00b177917b96257bb2651bfd8bd4fafd7"], "node": "19b422b072c77a9f3296642b55379b265df1ee46", "parents": ["36ee42879f9856b96205a50a5fac972008afbdfd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2059467 - Fix list-style: outside outside serialization. r=firefox-style-system-reviewers,dshin\n\nOmitting the position there will cause wrong round-tripping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315314\n", "files": ["servo/components/style/counter_style/mod.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/values/specified/list.rs", "testing/web-platform/tests/css/css-lists/parsing/list-style-valid.html", "xpcom/ds/StaticAtoms.py"], "git_node": "5fbd2f131255776ba6e34e4b426b3920435fc908", "git_parents": ["d0be2f3d44d694e68c76698b36a3ad3ce8c21f77"], "node": "8058ca58fcaa170efd04d34f99b7de060826b7d7", "parents": ["19b422b072c77a9f3296642b55379b265df1ee46"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057455 - Allow observing mark state of shared atoms in shell testing functions r=spidermonkey-reviewers,jandem\n\nThe cell here can be a shared atom so we need to skip the assertion in zone()\nthat checks whether the zone is one we have access to. The shared atoms zone\ndoesn't get GCed until shutdown so we're OK to check its GC state here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315240\n", "files": ["js/src/jit-test/tests/gc/bug-2057455.js", "js/src/shell/js.cpp"], "git_node": "9f667bd744984f722a7dcfb7d955a66858ad98c8", "git_parents": ["5fbd2f131255776ba6e34e4b426b3920435fc908"], "node": "f9bc36b067638840dc8ccbed5d33d57fb690dc51", "parents": ["8058ca58fcaa170efd04d34f99b7de060826b7d7"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059121 - Hold strong reference to Document in HidePopoverInternal. r=keithamus\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315331\n", "files": ["dom/html/nsGenericHTMLElement.cpp"], "git_node": "c9637487c1550050b51e0bc98855a259e3bafbd1", "git_parents": ["9f667bd744984f722a7dcfb7d955a66858ad98c8"], "node": "540dbc38aa8c57d7b0f86c76ca53ddb394944633", "parents": ["f9bc36b067638840dc8ccbed5d33d57fb690dc51"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059432 - use searchfox permalinks in good-first-bugs. r=padenot,ai4dev-reviewers,marco DONTBUILD\n\nLinks to trunk are bound to go stale.  And while there, replace\nmozilla-central with firefox-main.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315293\n", "files": [".agents/skills/file-good-first-bug/SKILL.md", ".claude/skills/file-good-first-bug/SKILL.md"], "git_node": "95e52347227