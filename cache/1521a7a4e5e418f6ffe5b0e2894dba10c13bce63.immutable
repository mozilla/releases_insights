 https://bugs.webkit.org/show_bug.cgi?id=320617, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320617 (#61640)\n--\n\nwpt-commits: 8faa09513e896e817e3920722433793f9b20ee76\nwpt-pr: 61640\n", "files": ["testing/web-platform/tests/xhr/responseurl-after-abort.any.js"], "git_node": "f442fa262bdb2db4e8efa3bbdab738931c9f6ae8", "git_parents": ["9de0658421c3470f3f965ad2ec8be2920449e683"], "node": "a2061d73910e581462b7e0a37ffc3cc704577962", "parents": ["e81291476048b22a812f4b999a531eae9b364c65"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059608 [wpt PR 61640] - Update wpt metadata, a=testonly\n\nwpt-pr: 61640\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/xhr/responseurl-after-abort.any.js.ini"], "git_node": "1d5922f3c4d068c8887aff780225cc30d121ce7f", "git_parents": ["f442fa262bdb2db4e8efa3bbdab738931c9f6ae8"], "node": "c3c5ecb8cad5b8c0c356e1148ca8e539c2e46abe", "parents": ["a2061d73910e581462b7e0a37ffc3cc704577962"], "tags": []}, {"author": "Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e", "branch": "default", "desc": "Bug 2059638 [wpt PR 61622] - script: Implement async FileSystemEntry.getParent() success callback, a=testonly\n\nAutomatic update from web-platform-tests\nAdd `filesystementry.getParent` auto test\n\nSigned-off-by: Euclid Ye \u003cyezhizhenjiakang@gmail.com\u003e\n\n--\n\nwpt-commits: 0fc95b85fa48c3303576485982399b094f5a50c6\nwpt-pr: 61622\n", "files": ["testing/web-platform/tests/entries-api/filesystementry-getParent.html"], "git_node": "71b143ce27c8efef91f12be8cd72afdf64cb9974", "git_parents": ["1d5922f3c4d068c8887aff780225cc30d121ce7f"], "node": "e7810f657a39fba8474583f3d37449cd78ccfa75", "parents": ["c3c5ecb8cad5b8c0c356e1148ca8e539c2e46abe"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059638 [wpt PR 61622] - Update wpt metadata, a=testonly\n\nwpt-pr: 61622\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/entries-api/filesystementry-getParent.html.ini"], "git_node": "79740a87b0ea964a357b66be2fa7cb7e585cdd42", "git_parents": ["71b143ce27c8efef91f12be8cd72afdf64cb9974"], "node": "8600668cf550c5713a786c79866f920a530c3cd3", "parents": ["e7810f657a39fba8474583f3d37449cd78ccfa75"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2056735 [wpt PR 61462] - [highlights] Fix highlightsFromPoint WPT assertions, a=testonly\n\nAutomatic update from web-platform-tests\n[highlights] Fix highlightsFromPoint WPT assertions\n\nCorrect two no-hit checks that assigned to an unused variable while\nasserting stale results.\n\nMake the invalid StaticRange test retain overlapping live geometry and\ninvalidate the static offset directly, so an incorrectly returned range\ncannot pass unnoticed.\n\nReplace explainer links with the normative Highlight API and CSSOM View\nsections.\n\nBug: 527784934\nChange-Id: I32a624ebd033ce910f04bf2a6c9334eddca6b6fb\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8119492\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Stephanie Zhang \u003cstephanie.zhang@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1665698}\n\n--\n\nwpt-commits: 8ed70c8c3787450d340397e02155d7f65901ce5d\nwpt-pr: 61462\n", "files": ["testing/web-platform/tests/css/css-highlight-api/HighlightRegistry-highlightsFromPoint-ranges.html", "testing/web-platform/tests/css/css-highlight-api/HighlightRegistry-highlightsFromPoint.html"], "git_node": "0f9a37711fc30f43a49e386dcb294d7514451bc7", "git_parents": ["79740a87b0ea964a357b66be2fa7cb7e585cdd42"], "node": "2cccc07b7a5a7c1cdec4da9698cd700a9a1d5205", "parents": ["8600668cf550c5713a786c79866f920a530c3cd3"], "tags": []}, {"author": "Chris Dumez \u003ccdumez@apple.com\u003e", "branch": "default", "desc": "Bug 2059628 [wpt PR 61648] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320636, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320636 (#61648)\n--\n\nwpt-commits: 288347532c8e475a58d0c0a6824b425de5c59ea3\nwpt-pr: 61648\n", "files": ["testing/web-platform/tests/css/filter-effects/svg-mutation-fedropshadow-stddeviation-ref.html", "testing/web-platform/tests/css/filter-effects/svg-mutation-fedropshadow-stddeviation.html"], "git_node": "a2873672524c1ede27b6768829788cc3da549fa5", "git_parents": ["0f9a37711fc30f43a49e386dcb294d7514451bc7"], "node": "2fc824e94d795c2fc6d326564f86bcc895eabf5f", "parents": ["2cccc07b7a5a7c1cdec4da9698cd700a9a1d5205"], "tags": []}, {"author": "Chris Dumez \u003ccdumez@apple.com\u003e", "branch": "default", "desc": "Bug 2059626 [wpt PR 61646] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=298890, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=298890 (#61646)\n--\n\nwpt-commits: eef7aa4c9d7a2ea9bdd6b76cce43502b8affd57f\nwpt-pr: 61646\n", "files": ["testing/web-platform/tests/css/motion/offset-path-ray-sides-fourth-quadrant-ref.html", "testing/web-platform/tests/css/motion/offset-path-ray-sides-fourth-quadrant.html"], "git_node": "2e94a25f8616b297de5d54eca4a31f95cedccb48", "git_parents": ["a2873672524c1ede27b6768829788cc3da549fa5"], "node": "6e742990c58b9a130c33ccb83132e7a8b37df019", "parents": ["2fc824e94d795c2fc6d326564f86bcc895eabf5f"], "tags": []}, {"author": "Chris Dumez \u003ccdumez@apple.com\u003e", "branch": "default", "desc": "Bug 2059650 [wpt PR 61650] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320623, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320623 (#61650)\n--\n\nwpt-commits: f74a34fb6e5876f0957ef6b328efdbf1288feb66\nwpt-pr: 61650\n", "files": ["testing/web-platform/tests/FileAPI/reading-data-section/filereader_abort.any.js"], "git_node": "026a76a27e4ca303565fe947e1d110c077cf2277", "git_parents": ["2e94a25f8616b297de5d54eca4a31f95cedccb48"], "node": "d49b7cc69ab0660ca5f6c17a306880b9c37813b9", "parents": ["6e742990c58b9a130c33ccb83132e7a8b37df019"], "tags": []}, {"author": "Kent Tamura \u003ctkent@chromium.org\u003e", "branch": "default", "desc": "Bug 2059687 [wpt PR 61655] - cssom&html: Make empty style assertions independent of property count, a=testonly\n\nAutomatic update from web-platform-tests\ncssom&html: Make empty style assertions independent of property count\n\nChange `assert_equals(style.length, 0)` to `assert_true(style.length ==\n0)` in CSSOM and HTML tests.\n\nWhen `assert_equals` fails, the error message includes the actual length\n(the total number of supported CSS properties, e.g., 488). This causes\ntest expectation files (*-expected.txt) to require updates whenever a\nnew CSS property is added to the engine.\n\nUsing `assert_true` hides the specific property count from the failure\nmessage, reducing maintenance overhead and preventing unrelated test\nfailures during CSS property additions.\n\nChange-Id: I97e486c78434e14a3356173e80ba1640fcbfad89\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8174043\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nAuto-Submit: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Koji Ishii \u003ckojii@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1671658}\n\n--\n\nwpt-commits: 751e38ec5b86810097fa036af9235914b3693da5\nwpt-pr: 61655\n", "files": ["testing/web-platform/tests/css/cssom/getComputedStyle-pseudo.html", "testing/web-platform/tests/html/rendering/widgets/shadow-dom.html"], "git_node": "d5bf64b623c3fe102c5488bc5b845dba542a8d9e", "git_parents": ["026a76a27e4ca303565fe947e1d110c077cf2277"], "node": "d1f9232f76d2307011d34f237418ff8f731ad5b9", "parents": ["d49b7cc69ab0660ca5f6c17a306880b9c37813b9"], "tags": []}, {"author": "moonira \u003cmoonira@google.com\u003e", "branch": "default", "desc": "Bug 2059691 [wpt PR 61657] - Avoid caching styles with random() percentage values in MPC, a=testonly\n\nAutomatic update from web-platform-tests\nAvoid caching styles with random() percentage values in MPC\n\nMark element-dependent css random() values with unresolvable percentages\nas not cacheable in MPC.\n\nBug: 413385732\nChange-Id: I4eeb143893f4a09c28919804c23db2849b2f01c3\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8175865\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Munira Tursunova \u003cmoonira@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1671755}\n\n--\n\nwpt-commits: 91ecca8a5f40e3b8634e2279ecf6ae1996ed74c9\nwpt-pr: 61657\n", "files": ["testing/web-platform/tests/css/css-values/random-computed.tentative.html"], "git_node": "c658d7fd290184055a3079564bb21dd53d240e39", "git_parents": ["d5bf64b623c3fe102c5488bc5b845dba542a8d9e"], "node": "55369387e9bf9a4f56c17df718306cdbb8bed338", "parents": ["d1f9232f76d2307011d34f237418ff8f731ad5b9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059691 [wpt PR 61657] - Update wpt metadata, a=testonly\n\nwpt-pr: 61657\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-values/random-computed.tentative.html.ini"], "git_node": "bcf0d4762a40b72ff12aa5ecd152deb286c3fbf1", "git_parents": ["c658d7fd290184055a3079564bb21dd53d240e39"], "node": "fd763133ee15f9136e496e4ec4fce469f82ff178", "parents": ["55369387e9bf9a4f56c17df718306cdbb8bed338"], "tags": []}, {"author": "Vlad Krot \u003cvkrot@google.com\u003e", "branch": "default", "desc": "Bug 2059624 [wpt PR 61645] - Reland \"[sub apps] enable wpt tests\", a=testonly\n\nAutomatic update from web-platform-tests\nReland \"[sub apps] enable wpt tests\"\n\nThis is a reland of commit f56a10fc2ca726d6401a1c2232370faa8ce7d740\n\nI have only changed a single file `disable-site-isolation-trials` to\nexclude tests that require isolated origin so that\nnot_site_per_process_blink_wpt_tests do not run the tests.\n\nOriginal change's description:\n\u003e [sub apps] enable wpt tests\n\u003e\n\u003e Re-enable the tests in third_party/blink/web_tests/external/wpt/subapps.\n\u003e\n\u003e - Use virtual test suits to emulate isolated context with header overrides.\n\u003e - Modernized tests to fit new sub apps API shape.\n\u003e - Remove insecure context test because by definition isolated context cannot be insecure.\n\u003e - Add a test that checks permission policy behavior.\n\u003e\n\u003e Fixed: 40928236\n\u003e Change-Id: Idc3d52c01a5a4cb4f4f588ea8c6011e1e13b4901\n\u003e Reviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8122238\n\u003e Reviewed-by: Andrew Rayskiy \u003cgreengrape@google.com\u003e\n\u003e Reviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\n\u003e Reviewed-by: Rick Byers \u003crbyers@chromium.org\u003e\n\u003e Commit-Queue: Vlad Krot \u003cvkrot@google.com\u003e\n\u003e Cr-Commit-Position: refs/heads/main@{#1668571}\n\nBug: 40928236\nChange-Id: I4c06e2489f8d8d24e91c18e05f721a2cb2252597\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8173844\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCommit-Queue: Vlad Krot \u003cvkrot@google.com\u003e\nReviewed-by: Rick Byers \u003crbyers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1671765}\n\n--\n\nwpt-commits: df8ee2a055cccdf50753a4a5d41196e51eb63caa\nwpt-pr: 61645\n", "files": ["testing/web-platform/tests/interfaces/sub-apps.tentative.idl", "testing/web-platform/tests/resources/chromium/mock-subapps.js", "testing/web-platform/tests/subapps/__dir__.headers", "testing/web-platform/tests/subapps/add-error.tentative.https.html", "testing/web-platform/tests/subapps/add-success.tentative.https.html", "testing/web-platform/tests/subapps/disabled-by-permissions-policy.tentative.https.html", "testing/web-platform/tests/subapps/disabled-by-permissions-policy.tentative.https.html.headers", "testing/web-platform/tests/subapps/insecure-context-error.tentative.html", "testing/web-platform/tests/subapps/list-error.tentative.https.html", "testing/web-platform/tests/subapps/list-success.tentative.https.html", "testing/web-platform/tests/subapps/remove-error.tentative.https.html", "testing/web-platform/tests/subapps/remove-success.tentative.https.html", "testing/web-platform/tests/subapps/resources/subapps-helpers.js"], "git_node": "d6d0076e354ebccbbd9731eba416375ae946214e", "git_parents": ["bcf0d4762a40b72ff12aa5ecd152deb286c3fbf1"], "node": "fe9accf577f44ca6191f38ebe4c97ab39bd0c91a", "parents": ["fd763133ee15f9136e496e4ec4fce469f82ff178"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2059760 [wpt PR 61662] - Fix anchor position scroll adjustments with transformed scrollers., a=testonly\n\nAutomatic update from web-platform-tests\nFix anchor position scroll adjustments with transformed scrollers.\n\nWhen positioning an anchor-positioned element whose anchor is inside a\nscroll container with CSS transforms (e.g. scale(2)), scroll offset\nadjustments were un-transformed. Fix this.\n\nIn Blink: In ComputeAdjustmentContainersData(), scroll offsets were\naccumulated directly as raw un-transformed local offsets. We now map\nsuch offsets into the containing block's coordinate space using\nLocalToAncestorPoint().\n\nIn cc::TransformTree::AnchorPositionOffset, the scroll offset was\naccumulated without coordinate space transformation. This is needed for\nstuff to appear correctly on screen after having scrolled, when the main\nthread isn't involved.\n\nNeed to do this both for the actual scroll offsets and any sticky\npositioning offset.\n\nThe WPT tests are written by humans. The rest (including this comment)\nis AI-based, but heavily revised and refactored by a human (i.e. moi).\n\nTAG=agy\nCONV=095372e0-1453-498f-9c7c-72b00c760663\n\nBug: 534655508\nChange-Id: I3c743a75f63b01b2e367314f59ebf3eeaaa22dd0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8158082\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1671810}\n\n--\n\nwpt-commits: ca7da81f5174e870474b1ae2a4118927e9f132d6\nwpt-pr: 61662\n", "files": ["testing/web-platform/tests/css/css-anchor-position/transform-018.html", "testing/web-platform/tests/css/css-anchor-position/transform-019.html", "testing/web-platform/tests/css/css-anchor-position/transform-020.html", "testing/web-platform/tests/css/css-anchor-position/transform-021.html", "testing/web-platform/tests/css/css-anchor-position/transform-022.html", "testing/web-platform/tests/css/css-anchor-position/transform-023.html"], "git_node": "b73e4154becf5f4f6cd1168d4758d0150b5322fb", "git_parents": ["d6d0076e354ebccbbd9731eba416375ae946214e"], "node": "711fefdc0a09f190b9ba769a338b7ce7da4c0cbd", "parents": ["fe9accf577f44ca6191f38ebe4c97ab39bd0c91a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059760 [wpt PR 61662] - Update wpt metadata, a=testonly\n\nwpt-pr: 61662\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-anchor-position/transform-018.html.ini", "testing/web-platform/meta/css/css-anchor-position/transform-019.html.ini", "testing/web-platform/meta/css/css-anchor-position/transform-020.html.ini", "testing/web-platform/meta/css/css-anchor-position/transform-021.html.ini", "testing/web-platform/meta/css/css-anchor-position/transform-022.html.ini", "testing/web-platform/meta/css/css-anchor-position/transform-023.html.ini"], "git_node": "d4bbbf0dad87b374c4f56ed4c7f39de90adc5b00", "git_parents": ["b73e4154becf5f4f6cd1168d4758d0150b5322fb"], "node": "23bfa6159a23cf82c788afc95ea2039e9cbafe31", "parents": ["711fefdc0a09f190b9ba769a338b7ce7da4c0cbd"], "tags": []}, {"author": "Alison Maher \u003calmaher@microsoft.com\u003e", "branch": "default", "desc": "Bug 2059710 [wpt PR 61661] - [Masonry] Add initial column grid-lanes fragmentation, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Add initial column grid-lanes fragmentation\n\nAdd initial item fragmentation for column grid-lanes containers. The\nexisting placement pass persists stitched-container offsets for each\nlane, then a new fragmentation pass lays out the children belonging to\nthe current fragment.\n\nIntroduce a Flex-inspired item iterator that processes child break\ntokens before unstarted items, tracks progress independently for each\nlane, and reconstructs continuation state at the start of each\nfragment. This makes sure to handle lanes with no items and child\nbreak-token ordering that differs from lane order.\n\nThe fragmentation pass converts persisted offsets to fragment-relative\ncoordinates, creates fragmented child constraint spaces, lays out\ncontinued and unstarted children, and computes the current fragment\u2019s\nintrinsic block size.\n\nRows, spanners, dense-packed items, fragmented subgrids, break rules,\nexpansion, margins, baselines, and cloned decorations remain follow-up\nwork.\n\nAdd single- and multi-lane WPT coverage adapted from Flex. Existing\ngrid-lanes-fragmentation-001 still differs because `break-inside: avoid`\nis unsupported and its reference assumes block-style placement\nrestarting in each fragment.\n\nBug: 343257585\nChange-Id: I4969532dfc154039e39dd074ce14fd47af1fd31f\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8175168\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1671879}\n\n--\n\nwpt-commits: e0189ad12dd9b6b82c3e7270abf2d36c8aed7da4\nwpt-pr: 61661\n", "files": ["testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-001.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-002.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-003.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-004.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-001.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-002.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-003.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/column-single-lane-fragmentation-004.html", "testing/web-platform/tests/css/css-break/grid/grid-lanes/grid-lanes-fragmentation-001.html"], "git_node": "063d1b2d56b2fc5f6c5e0c20607ee4f04a96d946", "git_parents": ["d4bbbf0dad87b374c4f56ed4c7f39de90adc5b00"], "node": "c4e61aaf7a4dc74adfdf2fd85152df9c76675a1a", "parents": ["23bfa6159a23cf82c788afc95ea2039e9cbafe31"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059710 [wpt PR 61661] - Update wpt metadata, a=testonly\n\nwpt-pr: 61661\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-001.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-002.html.ini", "testing/web-platform/meta/css/css-break/grid/grid-lanes/column-multi-lane-fragmentation-004.html.ini"], "git_node": "894a2dec4524fc1deb48df18c55ea3bd6361058e", "git_parents": ["063d1b2d56b2fc5f6c5e0c20607ee4f04a96d946"], "node": "e9fd3a0ab62e7dcf71c446b7268cc8bb37a098be", "parents": ["c4e61aaf7a4dc74adfdf2fd85152df9c76675a1a"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2045207 [wpt PR 60406] - Change ClipboardItem::getType() rejection to InvalidStateError, a=testonly\n\nAutomatic update from web-platform-tests\nChange ClipboardItem::getType() rejection to InvalidStateError (#60406)\n\nClipboardItem.getType() should reject with\nInvalidStateError when the clipboard data has changed between read()\nand getType(), or when a null blob is returned from the clipboard\nreader. Chromium was using DataError at these rejection sites in\nclipboard_item.cc. This changes them to InvalidStateError for spec\ncompliance.\n\nBug: 519633341\nChange-Id: Idd2458219b4d2b1b706b644e3f40ca84c1254057\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7902351\nCommit-Queue: Shweta Bindal \u003cshwetabindal@microsoft.com\u003e\nReviewed-by: Rohan Raja \u003croraja@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1643732}\n\nCo-authored-by: Shweta Bindal \u003cshwetabindal@microsoft.com\u003e\n--\n\nwpt-commits: a80516695489e924564d8911a55f023271a050f0\nwpt-pr: 60406\n", "files": ["testing/web-platform/tests/clipboard-apis/async-clipboard-cached-getType-reject.tentative.https.html", "testing/web-platform/tests/clipboard-apis/async-clipboard-stale-getType-reject.tentative.https.html"], "git_node": "86a741d823076a8ea89ae42207b0b32b28079947", "git_parents": ["894a2dec4524fc1deb48df18c55ea3bd6361058e"], "node": "6ab2bb422839598e1bf1bbae4a0eb4c8c036bd89", "parents": ["e9fd3a0ab62e7dcf71c446b7268cc8bb37a098be"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045207 [wpt PR 60406] - Update wpt metadata, a=testonly\n\nwpt-pr: 60406\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/clipboard-apis/async-clipboard-cached-getType-reject.tentative.https.html.ini", "testing/web-platform/meta/clipboard-apis/async-clipboard-stale-getType-reject.tentative.https.html.ini", "testing/web-platform/meta/clipboard-apis/async-custom-formats-write-read.tentative.https.html.ini", "testing/web-platform/meta/clipboard-apis/async-html-script-removal.https.html.ini", "testing/web-platform/meta/clipboard-apis/clipboard-copy-selection-line-break.https.html.ini"], "git_node": "34a58d64a836762da0e6a011ed29498458a87434", "git_parents": ["86a741d823076a8ea89ae42207b0b32b28079947"], "node": "d49ad255bef1c02f0882909cf71c93d806e089c8", "parents": ["6ab2bb422839598e1bf1bbae4a0eb4c8c036bd89"], "tags": []}, {"author": "Jose Dapena Paz \u003cjdapena@igalia.com\u003e", "branch": "default", "desc": "Bug 2059833 [wpt PR 61663] - ContainerTiming: regression tests for cross-frame isolation, a=testonly\n\nAutomatic update from web-platform-tests\nContainerTiming: regression tests for cross-frame isolation\n\nEach frame has its own ContainerTiming Supplement and tracker; paints\ninside an iframe must not surface in the parent.\n\nAdds a blink_unittests case using SingleChildLocalFrameClient,\nparameterized over both the pre-paint and the fallback attribution\npaths: it simulates a paint in a child frame and asserts the entry\nappears only in the child's performance timeline, never the parent's.\n\nAdds same-origin and cross-origin WPTs where the parent observer must\nstay silent. The subframe postMessages its own container entry, so that\nparent silence is meaningful rather than vacuous.\n\nWeb tests run single-threaded by default, and in that configuration an\nout-of-process iframe never gets presentation feedback, so it reports no\npaint timing at all (element timing and LCP alike). Both WPTs therefore\nrun exclusively under the existing threaded virtual suite, where the\nsubframe reliably reports its entry and the tests can assert it outright.\n\nBug: 489959278\nChange-Id: I938abed481896c36abe2f5696beed0778bc032da\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7842320\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Jos\u00e9 Dapena Paz \u003cjdapena@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1671936}\n\n--\n\nwpt-commits: 8cfe9b0e7baa9081197630c1ecf5801fe3e8c540\nwpt-pr: 61663\n", "files": ["testing/web-platform/tests/container-timing/tentative/iframe-isolation-cross-origin.sub.html", "testing/web-platform/tests/container-timing/tentative/iframe-isolation-same-origin.html", "testing/web-platform/tests/container-timing/tentative/resources/iframe-isolation-subframe.html"], "git_node": "e0910e45a557f3ec219d8ceb7acc419b9377680f", "git_parents": ["34a58d64a836762da0e6a011ed29498458a87434"], "node": "07c02497c0fddc2fd8292d0d183db669ee36667c", "parents": ["d49ad255bef1c02f0882909cf71c93d806e089c8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059833 [wpt PR 61663] - Update wpt metadata, a=testonly\n\nwpt-pr: 61663\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/container-timing/tentative/iframe-isolation-cross-origin.sub.html.ini", "testing/web-platform/meta/container-timing/tentative/iframe-isolation-same-origin.html.ini"], "git_node": "dfe96095983015cba59a24b4187791a3fb4f085f", "git_parents": ["e0910e45a557f3ec219d8ceb7acc419b9377680f"], "node": "df20dcba065a68d87c32e3f3a565439f485607f5", "parents": ["07c02497c0fddc2fd8292d0d183db669ee36667c"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2059878 [wpt PR 61664] - Add tests for available-dictionary header with large resources., a=testonly\n\nAutomatic update from web-platform-tests\nAdd tests for available-dictionary header with large resources.\n\nThis is a follow-up of CL 8126502.\n\nBug: 522338661, 40255884\nChange-Id: I3b67622132675e3c528ecbea3b7962a30ecf9995\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8138686\nReviewed-by: Patrick Meenan \u003cpmeenan@chromium.org\u003e\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1671938}\n\n--\n\nwpt-commits: bad12620fb9173a9378f99c4e5a6b2d43d599df1\nwpt-pr: 61664\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/compressed-large-resources-dictionary-hashes.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/Makefile", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/dictionary-hashes.js"], "git_node": "c900343d08be691d3470a45a372697ffb62981b9", "git_parents": ["dfe96095983015cba59a24b4187791a3fb4f085f"], "node": "6b738e743a0403778ca329e6870f71731aa4ceb4", "parents": ["df20dcba065a68d87c32e3f3a565439f485607f5"], "tags": []}, {"author": "Yanling Wang \u003cyanlingwang@microsoft.com\u003e", "branch": "default", "desc": "Bug 2056297 [wpt PR 61418] - [Masonry] Support overflow with fill-reverse and track-reverse, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Support overflow with fill-reverse and track-reverse\n\nThis CL makes the overflow direction follow the reversed flow:\nfill-reverse and track-reverse each flip which edge overflow comes from,\nso the scroll origin is computed from the reversed edge, following the\nsame logic as flexbox. This edge depends only on the container's style,\nnot its content, so the scrollable region stays stable whether or not\nanything actually overflows.\n\nTrack-reverse only changes which track fills first, the tracks\nthemselves still start at the leading edge, so an overflowing container\nwould still scroll the wrong way. To fix this, when the tracks overflow\nwe slide the whole track area toward the end edge, so the first-filled\ntrack sits against that edge and the overflow matches the reversed\norder. If instead the tracks fit but an item is larger than its track,\nthat item overflows off the reversed (non-scrollable) edge and the\nexcess is clipped\n\nBug: 343257585\nChange-Id: If5ca61d4108918e575ce5b3f3e7cc4447704fb0e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8020862\nCommit-Queue: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1672040}\n\n--\n\nwpt-commits: 3b4663dbed96101b10b94c5992aa7b54233bbfd1\nwpt-pr: 61418\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-002.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-003.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-004-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-004.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-005-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-005.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-baseline-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-baseline-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-baseline-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-baseline-002.html"], "git_node": "7cbfbfda64ebd9fdbe361e68cddbcc147807b97c", "git_parents": ["c900343d08be691d3470a45a372697ffb62981b9"], "node": "875927440a3b9c712db82e1773cd8db93a272c63", "parents": ["6b738e743a0403778ca329e6870f71731aa4ceb4"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056297 [wpt PR 61418] - Update wpt metadata, a=testonly\n\nwpt-pr: 61418\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-004.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-005.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-baseline-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/overflow/grid-lanes-overflow-reverse-baseline-002.html.ini"], "git_node": "41d7609ef5c0133d9d7d1a11a356c5a3ce99f8f7", "git_parents": ["7cbfbfda64ebd9fdbe361e68cddbcc147807b97c"], "node": "9e437def3cc640de1eb06b578b1c9541640623dc", "parents": ["875927440a3b9c712db82e1773cd8db93a272c63"], "tags": []}, {"author": "Noam Rosenthal \u003cnrosenthal@chromium.org\u003e", "branch": "default", "desc": "Bug 2059699 [wpt PR 61659] - Use inert document when creating a sanitizer-disallowed element, a=testonly\n\nAutomatic update from web-platform-tests\nUse inert document when creating a sanitizer-disallowed element\n\nThis makes it so that creation time side effects like \u003cimg onerror\u003e\ndon't take effect if the element is going to be removed anyway, while\nkeeping the same flow for elements that are going to work the same (e.g.\nscripts remain associated with this document)\n\nBug: 537814747\nChange-Id: I4df2b57d5cb642ab83c0a53bc91f5f80af4c7562\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8159266\nReviewed-by: Daniel Vogelheim \u003cvogelheim@chromium.org\u003e\nCommit-Queue: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1672097}\n\n--\n\nwpt-commits: d45ce9f5a723fc7012e9418c86921d468d894a73\nwpt-pr: 61659\n", "files": ["testing/web-platform/tests/domparsing/tentative/stream-sanitizer-img-ctor.html"], "git_node": "94f4c2a2441aec118fef9b65b72aac71bea3ecda", "git_parents": ["41d7609ef5c0133d9d7d1a11a356c5a3ce99f8f7"], "node": "5afd10b29831078bc1a1bfc2daa869b58e7994f6", "parents": ["9e437def3cc640de1eb06b578b1c9541640623dc"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059699 [wpt PR 61659] - Update wpt metadata, a=testonly\n\nwpt-pr: 61659\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domparsing/tentative/stream-sanitizer-img-ctor.html.ini"], "git_node": "1b6411eac395ad9a6feb50159352ba6ea2b245bc", "git_parents": ["94f4c2a2441aec118fef9b65b72aac71bea3ecda"], "node": "3506b65c3989f1ceb793f499c7490cf5d529c2c8", "parents": ["5afd10b29831078bc1a1bfc2daa869b58e7994f6"], "tags": []}, {"author": "Ryo Hiyoshi \u003cryohiy.dev@gmail.com\u003e", "branch": "default", "desc": "Bug 2059905 [wpt PR 61667] - Fix the duplicate-ID expectation in wpt/domxpath/fn-id.html, a=testonly\n\nAutomatic update from web-platform-tests\nFix the duplicate-ID expectation in wpt/domxpath/fn-id.html\n\nThe id(\"duplicate\") subtest expects XPath's id() to return all elements\nthat share the same ID. However, Chromium's current implementation\nreturns only the first element, so this subtest is failing. According to\nXPath 1.0 section 5.2.1 [1], if two elements have the same unique ID,\nthe second element must be treated as not having a unique ID. In\naddition, every browser listed on wpt.fyi fails this subtest. Therefore,\nthe test itself is what is wrong.\n\nUpdate the expectation to match the spec and remove the failure\nbaseline.\n\n[1] https://www.w3.org/TR/1999/REC-xpath-19991116/#unique-id\n\nFixed: 422038088\nChange-Id: I4796d83f5e57eca80e6122c5627fd43d3c8cfda8\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8041295\nCommit-Queue: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1672176}\n\n--\n\nwpt-commits: 9ec5fda3affa81a602f32977ada7564fd0de6d56\nwpt-pr: 61667\n", "files": ["testing/web-platform/tests/domxpath/fn-id.html"], "git_node": "e93e1f03daf546dafe5623301043c60957a859cf", "git_parents": ["1b6411eac395ad9a6feb50159352ba6ea2b245bc"], "node": "06b225ff814a5374394a3e91540c273b59fb2568", "parents": ["3506b65c3989f1ceb793f499c7490cf5d529c2c8"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059905 [wpt PR 61667] - Update wpt metadata, a=testonly\n\nwpt-pr: 61667\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/domxpath/fn-id.html.ini"], "git_node": "ad9ca1e33301571f7dfb6fb5dc447b2ab22ba04b", "git_parents": ["e93e1f03daf546dafe5623301043c60957a859cf"], "node": "a93a2c29368af9ebb1aa72ad602a19b3dc64b9a8", "parents": ["06b225ff814a5374394a3e91540c273b59fb2568"], "tags": []}, {"author": "Joone Hur \u003cjoonehur@microsoft.com\u003e", "branch": "default", "desc": "Bug 2059910 [wpt PR 61673] - LoAF: Report worker congestion from a saturated task queue, a=testonly\n\nAutomatic update from web-platform-tests\nLoAF: Report worker congestion from a saturated task queue\n\nThe Long Animation Frame (LoAF) API today reports only individual long\ntasks in Web Workers. A worker's event loop can also be saturated by a\nflood of consecutive short tasks: no single task is long enough to be\nreported on its own, but together they keep the loop busy past the 200ms\ncongestion threshold. This congestion is invisible to developers even\nthough it blocks the worker just as effectively as a single long task.\n\nThis CL lets the LoAF API detect such congestion in a Web Worker and\nreport it as a long-animation-frame entry. Congestion is detected by\nqueuing delay: a task that was already scheduled before the previous\ntask started running means two tasks were queued at once (backlog depth\n\u003e= 2). This is what separates real congestion from a steady async\niteration, which keeps the loop busy without ever building a backlog and\nmust not be reported.\n\nOnce a congested moment opens, consecutive tasks are folded into a\nsingle saturated interval for as long as the thread does not actually go\nidle between them. The interval ends when the queue drains (a real idle\ngap), and is reported once as a single entry covering the whole\ninterval.\n\nFor a congestion entry, scriptCount counts every top-level script entry\npoint folded into the interval even when scripts[] is empty (each task\nis under the 5ms attribution threshold), and blockingDuration is the\nspan beyond the 200ms threshold.\n\nThe behavior is gated behind the LongAnimationFrameWorker flag, so\ndefault behavior is unchanged. Main-thread congestion is handled in a\nseparate CL.\n\nRun with --enable-blink-features=LongAnimationFrameWorker.\n\nDesign Doc:\nhttps://docs.google.com/document/d/13tERlM0Cd8gKUDC01-lQeW4oNllKs4AKdEGw41bnH4k/edit?usp=sharing\n\nTest: third_party/blink/tools/run_web_tests.py -t release_x64 --additional-driver-flag=--enable-blink-features=LongAnimationFrameWorker external/wpt/long-animation-frame/loaf-congested-moment-worker.html\nBug: 534893134\nChange-Id: I69beb4a72021b2c4ac094c4ae5d14deabe796739\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8132581\nReviewed-by: Noam Rosenthal \u003cnrosenthal@google.com\u003e\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCommit-Queue: Joone Hur \u003cjoonehur@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1672187}\n\n--\n\nwpt-commits: 7ea3d665ff9ae1df1f742433d51bd1e9c6499a3b\nwpt-pr: 61673\n", "files": ["testing/web-platform/tests/lint.ignore", "testing/web-platform/tests/long-animation-frame/loaf-congested-moment-worker.html", "testing/web-platform/tests/long-animation-frame/resources/loaf-congested-moment-worker.js"], "git_node": "7366958794e1e14b4b301d2a29249ab682b6c931", "git_parents": ["ad9ca1e33301571f7dfb6fb5dc447b2ab22ba04b"], "node": "100fa5297febac1e51010ea19043698bc48be08a", "parents": ["a93a2c29368af9ebb1aa72ad602a19b3dc64b9a8"], "tags": []}, {"author": "Patrick Griffis \u003cpgriffis@igalia.com\u003e", "branch": "default", "desc": "Bug 2059906 [wpt PR 61668] - [CSP] Add tests for a \"*:*\" host-source with a path, a=testonly\n\nAutomatic update from web-platform-tests\n[CSP] Add tests for a \"*:*\" host-source with a path\n\nNo test cases previously covered that and it was failing in WebKit.\n\n--\n\nwpt-commits: 64ed8eebeafbae380caeed37ea7beb0e231522a6\nwpt-pr: 61668\n", "files": ["testing/web-platform/tests/content-security-policy/generic/source-list-wildcard-host-and-port.https.sub.html"], "git_node": "5e5f3a5ffe96d99cf7f9e6b9295438b2406638a1", "git_parents": ["7366958794e1e14b4b301d2a29249ab682b6c931"], "node": "4340012205060deedb9f965486ef12ed2c4ea833", "parents": ["100fa5297febac1e51010ea19043698bc48be08a"], "tags": []}, {"author": "Patrick Griffis \u003cpgriffis@igalia.com\u003e", "branch": "default", "desc": "Bug 2059908 [wpt PR 61669] - Add test for a preload in HTML with both href and imagesrcset, a=testonly\n\nAutomatic update from web-platform-tests\nAdd test for a preload in HTML with both href and imagesrcset\n\nStep 2 of \"preload\" replaces options's href with the result of selecting\nan image source from options's source set, so a \u003clink rel=preload\nas=image\u003e carrying both href and imagesrcset must fetch only the selected\ncandidate.\n\ndynamic-adding-preload-imagesrcset.html already covers that combination\nbut it builds the element from script so a scanner working from markup never sees it.\n\n--\n\nwpt-commits: 342fa825dba5ea3bacfc7b89179a9f4721f6e01f\nwpt-pr: 61669\n", "files": ["testing/web-platform/tests/preload/preload-imagesrcset-in-markup.html"], "git_node": "0c3c8f3755e4f462e27fab707e6ae31accb32b74", "git_parents": ["5e5f3a5ffe96d99cf7f9e6b9295438b2406638a1"], "node": "24237f10153ec336888f5c10829ad6c88a3abaa6", "parents": ["4340012205060deedb9f965486ef12ed2c4ea833"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059908 [wpt PR 61669] - Update wpt metadata, a=testonly\n\nwpt-pr: 61669\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/preload/preload-in-data-doc.html.ini"], "git_node": "2355de7c96db6698d10ae28ba05178c5c04510bb", "git_parents": ["0c3c8f3755e4f462e27fab707e6ae31accb32b74"], "node": "2f8209af6446cf963c3c9958f504e3d21cefb143", "parents": ["24237f10153ec336888f5c10829ad6c88a3abaa6"], "tags": []}, {"author": "Daniel Cheng \u003cdcheng@chromium.org\u003e", "branch": "default", "desc": "Bug 2059912 [wpt PR 61674] - Return an empty node-set from document('') with an invalid base URI, a=testonly\n\nAutomatic update from web-platform-tests\nReturn an empty node-set from document('') with an invalid base URI\n\n`document('')` is sometimes used as an idiom for returning a node-set\ncorresponding to the current stylesheet. However, resolving the empty string\nagainst an invalid base URI produces an invalid URI, and per section\n12.1 of the XSLT 1.0 standard:\n\n  If there is an error retrieving the resource, then the XSLT processor\n  may signal the error; if it does not signal the error, it must recover\n  by returning an empty node-set.\n\nThe spec is a bit contradictory here; elsewhere, it also states:\n\n  Note that a zero-length URI reference is a reference to the document\n  relative to which the URI reference is being resolved; thus\n  document(\"\") refers to the root node of the stylesheet; the tree\n  representation of the stylesheet is exactly the same as if the XML\n  document containing the stylesheet was the initial source document.\n\nBut the standard also says:\n\n  The URI reference may be relative. The base URI of the node in the\n  second argument node-set that is first in document order is used as\n  the base URI for resolving the relative URI into an absolute URI.\n\nAnd resolving the empty string against an invalid URI should arguably\nproduce an invalid URI.\n\nIn some ways, this brings Chrome behavior closer to Firefox, though it\nstill differs in other ways: the specific test case here returns a\ndifferent result in Firefox, because Firefox appears to ignore an\nattempt to set an invalid base URI, while Chrome does not.\n\nBug: 495541478\nChange-Id: I9ea2be319c1d4295c75d7fa3bf9b177b428cfd65\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8178615\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Tom Sepez \u003ctsepez@chromium.org\u003e\nCommit-Queue: Daniel Cheng \u003cdcheng@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1672234}\n\n--\n\nwpt-commits: d90970d4050881b98c9513cfa764035693dedf84\nwpt-pr: 61674\n", "files": ["testing/web-platform/tests/xml/xslt/document-function.window.js"], "git_node": "d3d20b7526f3a99682f5dedb4933be5489eeb5d9", "git_parents": ["2355de7c96db6698d10ae28ba05178c5c04510bb"], "node": "ef101a31f8ffc8d0d0276665d1389bec6fe93243", "parents": ["2f8209af6446cf963c3c9958f504e3d21cefb143"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059927 - [wpt-sync] Update web-platform-tests to d90970d4050881b98c9513cfa764035693dedf84, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: d90970d4050881b98c9513cfa764035693dedf84\nwpt-type: landing\n", "files": ["testing/web-platform/meta/clipboard-apis/async-clipboard-cached-getType-reject.tentative.https.html.ini", "testing/web-platform/meta/clipboard-apis/async-clipboard-stale-getType-reject.tentative.https.html.ini", "testing/web-platform/meta/css/css-animations/animation-duration-infinite.html.ini", "testing/web-platform/meta/css/css-image-animation/image-animation-paused-exact-frame.html.ini", "testing/web-platform/meta/css/css-view-transitions/iframe-and-main-frame-transition-old-main-new-iframe.html.ini", "testing/web-platform/meta/css/css-view-transitions/window-resize-aborts-transition.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-indexed-properties-strict.html.ini", "testing/web-platform/meta/html/browsers/the-window-object/window-open-defaults.window.js.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/autoplay-disabled-by-permissions-policy.https.sub.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/dynamic-import/microtasks/basic.any.js.ini", "testing/web-platform/meta/html/user-activation/navigate-to-crossorigin-redirect.html.ini", "testing/web-platform/meta/intersection-observer/reinsert-element.html.ini", "testing/web-platform/meta/long-animation-frame/loaf-congested-moment-worker.html.ini", "testing/web-platform/meta/mediacapture-record/MediaRecorder-requestData.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini", "testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/picture-in-picture/picture-in-picture-element.html.ini", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/service-workers/service-worker/same-site-cookies.https.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webdriver/tests/bidi/browser/set_download_behavior/global.py.ini", "testing/web-platform/meta/webrtc/RTCDataChannel-close.html.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-ondatachannel.html.ini", "testing/web-platform/meta/webrtc/RTCRtpReceiver-track-settings.tentative.html.ini", "testing/web-platform/meta/webrtc/RTCRtpReceiver-video-anyCodec.html.ini", "testing/web-platform/meta/webrtc/__dir__.ini", "testing/web-platform/meta/webrtc/protocol/rtp-demuxing.html.ini", "testing/web-platform/meta/webrtc/simulcast/h264.https.html.ini"], "git_node": "7735582bbb9c651e530ec73c0bba570583bd5efb", "git_parents": ["d3d20b7526f3a99682f5dedb4933be5489eeb5d9"], "node": "1a900b0181bb7806e781d567750209fbe3481d27", "parents": ["ef101a31f8ffc8d0d0276665d1389bec6fe93243"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1883552 - Wait for the autofill popup footer to be inside the list before clicking it, r=credential-management-reviewers,mtigley.\n\ntest_click_on_footer waited only for BrowserTestUtils.isVisible(), which walks\ndisplay, visibility and popup state, but ignores clipping by a scrollable\nancestor. While the popup is still being sized the rows briefly overflow the\nrichlistbox, leaving the footer outside it, and the center of the footer is then\nover the page. Clicking there dismissed the popup instead of pressing the\nfooter, so the awaited preferences tab never opened and the test timed out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315644\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_footer.js"], "git_node": "b06c4f514d7cc9c86b306e619db0fc899f6febe6", "git_parents": ["7735582bbb9c651e530ec73c0bba570583bd5efb"], "node": "433309584a70fc44528ee7f95121ff804ad65f7f", "parents": ["1a900b0181bb7806e781d567750209fbe3481d27"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/