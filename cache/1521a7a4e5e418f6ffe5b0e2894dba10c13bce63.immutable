/strings.xml", "mobile/android/fenix/app/src/main/res/values-ro/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sat/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sr/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-th/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-ug/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "8aeaeeaab8d7cbf2e76772686ce572eacee12108", "git_parents": ["4a0aa29b9f8a02349f89efd1aba0699921e4ae06"], "node": "9050cc56da2c2566091f43691778900f354d23dd", "parents": ["9e595efcd5ee35681139e3264a4d0115a1fd2abc"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056919 - Narrow setting-pane search fallback to header and non-group content r=mstriemer\"\n\nThis reverts commit 58e124faca2c0043948160ed2357084a49545216.\n", "files": ["browser/components/preferences/findInPage.js", "browser/components/preferences/tests/searchResults/browser-srd.toml", "browser/components/preferences/tests/searchResults/browser_search_results_fallback.js"], "git_node": "0c080d3885b6713f8df1a8b3f1be1b2a6e4f26e4", "git_parents": ["8aeaeeaab8d7cbf2e76772686ce572eacee12108"], "node": "f2775b2c1461e6c90c46c13c96a931155ac609ba", "parents": ["9050cc56da2c2566091f43691778900f354d23dd"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2054354: Properly handle case where inline axis is bottom-to-top when drawing fragmented borders. r=layout-reviewers,TYLin\n\nThis is in our code that decides which border sides to skip, for fragmented borders.\n\nWe start with a logical side (e.g. IEnd to skip painting the inline-end border\nfor a fragmented span), and we convert that to a physical side that our painting code can use.\n\nBefore this patch, our code simplistically assumed that the inline-start is\nalways the top for a vertical writing-mode, and inline-end is always the\nbottom; but that's not true, because sideways-lr has the inline-end side at the\ntop (and so do the other writing modes, if we apply `direction: rtl` to explicitly flip their inline axis).\n\nThis patch makes us use `IsInlineReversed` (which specifically tells us whether\nthe inline axis runs counter to the physical axis) when deciding whether the\nvertical inline-{start,end} sides are the bottom or the top.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312394\n", "files": ["layout/generic/nsIFrame.cpp", "testing/web-platform/tests/css/css-writing-modes/border-slice-001-ref.html", "testing/web-platform/tests/css/css-writing-modes/border-slice-001.html"], "git_node": "06b6d4fe57bd161314fc512f0c7add9e035872ad", "git_parents": ["0c080d3885b6713f8df1a8b3f1be1b2a6e4f26e4"], "node": "08da267d7b15e95a7434aa33753183712018c057", "parents": ["f2775b2c1461e6c90c46c13c96a931155ac609ba"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2047561 - Fix HCM styling for History Thumbnail list/grid view buttons r=pdahiya\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309744\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-grid/ai-chat-grid.css"], "git_node": "73d9313222820db7e7ebfb3d3361182b1f74f9b3", "git_parents": ["06b6d4fe57bd161314fc512f0c7add9e035872ad"], "node": "0985e4ba8bfb9930777f4891b57695531d360617", "parents": ["08da267d7b15e95a7434aa33753183712018c057"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2056610 - Don't suppress content in listbox select. r=keithamus,layout-reviewers,firefox-style-system-reviewers,dshin\n\nOptions can now per spec be wrapped in \u003cdiv\u003es etc. Just avoid removing\nthose at frame construction time.\n\nNow that we don't suppress stuff we need to hide the\n::-moz-select-content and picker icons via UA sheet properly, since\nthose used to get this treatment.\n\nRemove a bunch of reftests that are invalid now that we don't suppress\nabspos \u003cdiv\u003es etc, and add some WPTs which cover this.\n\nThe innerText getter stuff now matches other browsers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313991\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "layout/forms/test/test_select_key_navigation_bug1498769.html", "layout/reftests/abs-pos/reftest.list", "layout/reftests/abs-pos/select-1-dynamic.html", "layout/reftests/abs-pos/select-1-ref.html", "layout/reftests/abs-pos/select-1.html", "layout/reftests/forms/select/boguskids-ref.html", "layout/reftests/forms/select/boguskids.html", "layout/reftests/forms/select/dynamic-boguskids.html", "layout/reftests/forms/select/reftest.list", "layout/style/res/forms.css", "testing/web-platform/tests/html/dom/elements/the-innertext-and-outertext-properties/getter-tests.js", "testing/web-platform/tests/html/rendering/bindings/the-select-element-0/listbox-abspos-descendant-ref.html", "testing/web-platform/tests/html/rendering/bindings/the-select-element-0/listbox-abspos-descendant.html", "testing/web-platform/tests/html/rendering/bindings/the-select-element-0/listbox-option-display-contents-ref.html", "testing/web-platform/tests/html/rendering/bindings/the-select-element-0/listbox-option-display-contents.html", "testing/web-platform/tests/html/rendering/bindings/the-select-element-0/listbox-option-in-div-ref.html", "testing/web-platform/tests/html/rendering/bindings/the-select-element-0/listbox-option-in-div.html"], "git_node": "4e53d86c35a6761fc75c9623562e57f17eb30b29", "git_parents": ["73d9313222820db7e7ebfb3d3361182b1f74f9b3"], "node": "7818a5d22b19d3f8fbd6cb4dee2d1e89e0a29e47", "parents": ["0985e4ba8bfb9930777f4891b57695531d360617"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057107: Ensure that DirectManipulation handler is valid when it is enabled on Windows r=win-reviewers,gstoll\n\nDisable it _before_ releasing the objects that it needs to function correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313870\n", "files": ["widget/windows/DirectManipulationOwner.cpp", "widget/windows/DirectManipulationOwner.h"], "git_node": "05676314437e2ef0a90be0a3f177855e38477fb9", "git_parents": ["4e53d86c35a6761fc75c9623562e57f17eb30b29"], "node": "17de5f60be9797130d7efe15eb807b0165cf2154", "parents": ["7818a5d22b19d3f8fbd6cb4dee2d1e89e0a29e47"], "tags": []}, {"author": "Abhishek Nimalan \u003cabhisheknimalan@gmail.com\u003e", "branch": "default", "desc": "Bug 2035943 - Create an additional native profiling task instead of modifying the original. r=perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311415\n", "files": ["taskcluster/gecko_taskgraph/parameters.py", "taskcluster/gecko_taskgraph/transforms/test/raptor.py", "testing/perfdocs/generated/browsertime.rst", "testing/perfdocs/generated/mach-try-perf.rst", "testing/perfdocs/generated/perftest-in-a-nutshell.rst", "testing/perfdocs/generated/raptor.rst", "testing/performance/mach-try-perf/perfdocs/index.rst", "testing/performance/perftest-in-a-nutshell/perfdocs/index.rst", "testing/raptor/raptor/perfdocs/browsertime.rst", "tools/tryselect/selectors/fuzzy.py", "tools/tryselect/selectors/perf.py", "tools/tryselect/task_config.py"], "git_node": "940c89f6b3c19335a971903e80d3e5329128d841", "git_parents": ["05676314437e2ef0a90be0a3f177855e38477fb9"], "node": "c4dcbf0527358f93746bd4d842a362f8ddc2fb7c", "parents": ["17de5f60be9797130d7efe15eb807b0165cf2154"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051897: Reference .part files in a download analysis r=dlp-reviewers,gstoll\n\nIf the download contents are in a part file then pass that to CA.  Tests\ncheck that the passed file exists and that the final (non-part) filename\nexists after the analysis.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313078\n", "files": ["toolkit/components/contentanalysis/tests/browser/browser_download_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/browser_download_save_link_as_content_analysis.js", "toolkit/components/contentanalysis/tests/browser/head.js", "toolkit/components/downloads/DownloadIntegration.sys.mjs"], "git_node": "6a0cabaad070e7d6d6834f8b1b1b62a550b0714d", "git_parents": ["940c89f6b3c19335a971903e80d3e5329128d841"], "node": "2992bbf37bbe853523c3ac9eee7406842441f3c7", "parents": ["c4dcbf0527358f93746bd4d842a362f8ddc2fb7c"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056865: Skip zone writer for dragged http/https URLs on Windows r=win-reviewers,gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314233\n", "files": ["widget/windows/nsDataObj.cpp", "widget/windows/nsDataObj.h"], "git_node": "0aee8418428ea8510211533f7bf3895e467a3e70", "git_parents": ["6a0cabaad070e7d6d6834f8b1b1b62a550b0714d"], "node": "531a56a007328aa45915b06fd11ea7ca15d2069b", "parents": ["2992bbf37bbe853523c3ac9eee7406842441f3c7"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2058128 - Allow extending the SET_PREF allowed prefs lists via remote settings r=mimi,omc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314363\n", "files": ["browser/components/aboutwelcome/actors/AboutWelcomeParent.sys.mjs", "browser/components/asrouter/modules/Spotlight.sys.mjs", "toolkit/components/messaging-system/lib/MessagingSystemAllowlists.sys.mjs", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/lib/test/unit/test_MessagingSystemAllowlists.js", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_set_prefs.js", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/head.js"], "git_node": "c4a386bfaf5fc61f46d9585daca64df176252775", "git_parents": ["0aee8418428ea8510211533f7bf3895e467a3e70"], "node": "f29599b017301ef0ff585ff1c715651b83a89714", "parents": ["531a56a007328aa45915b06fd11ea7ca15d2069b"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Add 'head_git_rev' to a few more test params, r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314441\n", "files": ["taskcluster/test/params/autoland-onpush-backstop.yml", "taskcluster/test/params/autoland-onpush.yml", "taskcluster/test/params/mc-onpush.yml", "taskcluster/test/params/mr-onpush-geckoview.yml", "taskcluster/test/params/mr-onpush.yml"], "git_node": "28e08654735c813a5fb6985a4584fd68f3143e71", "git_parents": ["c4a386bfaf5fc61f46d9585daca64df176252775"], "node": "2ae8124b0219c10db8b1cad9a2749096b68d6514", "parents": ["f29599b017301ef0ff585ff1c715651b83a89714"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Clone some tier 2 lint tasks with Git, r=taskgraph-reviewers,bhearsum\n\nThese are the first tasks that will begin cloning from Github on\nautoland/main. They will continue to use Mercurial when running on Try\nor project branches.\n\nThe goal here is to determine whether this bifurcation is a big deal, as\nwell as to start gathering more data on clone performance. After a few\na couple of days, if no issues arise, we'll expand this to more tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314442\n", "files": ["taskcluster/kinds/source-test/mozlint.yml"], "git_node": "da3af60fe9e39f9b36781e6972bdafadbc45f9f1", "git_parents": ["28e08654735c813a5fb6985a4584fd68f3143e71"], "node": "88df46eac95ef420ed69d92ee363f0958c123e53", "parents": ["2ae8124b0219c10db8b1cad9a2749096b68d6514"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057906 - update libgbm's moz.yaml for the no-op vendoring. r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314440\n", "files": ["third_party/gbm/moz.yaml"], "git_node": "737b5a32bc9ee888082657eecd6073b190082a27", "git_parents": ["da3af60fe9e39f9b36781e6972bdafadbc45f9f1"], "node": "74b349537d64947512c6e4a4119ce4ceee19f38a", "parents": ["88df46eac95ef420ed69d92ee363f0958c123e53"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2057351 - Re-record the WebRender mask blob when the item's sub-pixel offset changes r=layout-reviewers,gfx-reviewers,tnikkel\n\nThe mask blob is rasterized against itemRect's grid but painted in absolute\nreference-frame coordinates, so the item's sub-pixel offset from itemRect is\nbaked into the recorded alpha. Nothing in the re-record check notices when that\noffset changes: itemRect is an integer rect and maskOffset is translation\ninvariant.\n\nBefore bug 1973192 this was harmless, because rounding out meant any sub-pixel\nmove also resized itemRect and tripped the check on its own. Rasterizing on the\nnearest-pixel grid lets a move leave both the origin and the size unchanged, so\nan item nudged a sub-pixel distance without being invalidated -- which is what\nhappens when a sibling's layout change moves it, rather than a change to the\nelement itself -- keeps alpha rasterized against the offset it had at its\nprevious position. Mask image drawing snaps to a whole pixel inside the blob, so\nonce the stale offset crosses a rounding boundary the mask is a full device\npixel out of place, and stays there until something else invalidates the item.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314286\n", "files": ["gfx/layers/wr/WebRenderCommandBuilder.cpp", "gfx/layers/wr/WebRenderUserData.h", "layout/reftests/svg/mask-image-after-sibling-move-ref.html", "layout/reftests/svg/mask-image-after-sibling-move.html", "layout/reftests/svg/reftest.list"], "git_node": "4dd8d7804a48bb2a315ce9499414bc3c404a0d9e", "git_parents": ["737b5a32bc9ee888082657eecd6073b190082a27"], "node": "3e7b7d4ddd3d463075b79ed75da6a942a8f9cc75", "parents": ["74b349537d64947512c6e4a4119ce4ceee19f38a"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057249 - Part 1. Allow swizzle to use specific SIMD implementation. r=gfx-reviewers,bradwerth\n\nThis allows us to more easily benchmark different SIMD\nimplementations supported by a platform. This is expected to be\nused for testing only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313794\n", "files": ["gfx/2d/Swizzle.cpp", "gfx/2d/Swizzle.h"], "git_node": "07d3974e22fb655b4c871ac98ee896a98381cefb", "git_parents": ["4dd8d7804a48bb2a315ce9499414bc3c404a0d9e"], "node": "1e30511fa746c56d62f5ec337c72ffb47a7795c7", "parents": ["3e7b7d4ddd3d463075b79ed75da6a942a8f9cc75"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057249 - Part 2. Add more exhaustive gtests for swizzling. r=gfx-reviewers,lsalzman\n\nThese tests will exercise all of the remainder scenarios, as well\nas more functional coverage between the different formats. It also\nuses the new arch selection to test the fallback and SIMD options\navailable on the host. The new tests can more easily expand as well\nif we have larger batch sizes and/or remainders in the future, i.e.\nwith AVX512.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313795\n", "files": ["gfx/tests/gtest/TestSwizzle.cpp"], "git_node": "889e2975df533424eea96fdb17127421e8b8f672", "git_parents": ["07d3974e22fb655b4c871ac98ee896a98381cefb"], "node": "781c1c0be7f7722bfbfab7072ea0fc47fe66a831", "parents": ["1e30511fa746c56d62f5ec337c72ffb47a7795c7"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057249 - Part 3. Add scaffolding to allow gtest benchmarks to be cancelled. r=gfx-reviewers,lsalzman\n\nBecause we don't know if the SIMD target is supported until\nruntime, we need to teach MOZ_GTEST_BENCH/MOZ_GTEST_BENCH_F how to\nabandon collecting results. It achieves this by allowing the test\nlambda to return a boolean, where false has it abandon reporting,\nand true continues normally.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313796\n", "files": ["testing/gtest/mozilla/MozGTestBench.cpp", "testing/gtest/mozilla/MozGTestBench.h"], "git_node": "d89bffd7272f6f0e90a28760adbe364d1384a6ef", "git_parents": ["889e2975df533424eea96fdb17127421e8b8f672"], "node": "d9e4695433aa6aded9a68e39be32b6f808f249d1", "parents": ["781c1c0be7f7722bfbfab7072ea0fc47fe66a831"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057249 - Part 4. Add gtest benchmarks for swizzle operations. r=gfx-reviewers,lsalzman\n\nThis includes swizzle, unpack, premultiply and unpremultiply. If a\nparticular SIMD target is unavailable with the current host, or it\nis not implemented yet, it will just silently skip the benchmark.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313797\n", "files": ["gfx/tests/gtest/TestSwizzle.cpp"], "git_node": "fdbe9ec63736ee603de8dd7eeefc15d3361722e9", "git_parents": ["d89bffd7272f6f0e90a28760adbe364d1384a6ef"], "node": "ac17dc38be3445557816afeddf76ad003af742de", "parents": ["d9e4695433aa6aded9a68e39be32b6f808f249d1"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049744 p1 - Add meta.annotations metric r=gsvelto\n\nThis metric contains the source JSON document unaltered, aside from\nfiltering to only the ping-scoped annotations. We don't define the\nexpected schema within the Glean metric because the object property\nnames are altered in the generated Rust code (see bug 1929903).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313284\n", "files": ["toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/glean_metrics.py", "toolkit/crashreporter/crashping/static_metrics.yaml"], "git_node": "df1e652c2f44e24dc10594c76ea5eadc146be383", "git_parents": ["fdbe9ec63736ee603de8dd7eeefc15d3361722e9"], "node": "dc78a06b147511bb542746f299a6edb8a68fcd63", "parents": ["ac17dc38be3445557816afeddf76ad003af742de"], "tags": []}, {"author": "Alex Franchuk \u003cafranchuk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049744 p2 - Set meta.annotations metric r=gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313286\n", "files": ["toolkit/crashreporter/crashping/src/lib.rs"], "git_node": "23faf72a8bef2c50fb8d3c5bed91291e25181867", "git_parents": ["df1e652c2f44e24dc10594c76ea5eadc146be383"], "node": "32c527ac46a12552516462162d0338defbc9f985", "parents": ["dc78a06b147511bb542746f299a6edb8a68fcd63"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1974213 - Only allow untrusted schemes in Services.scriptloader.loadSubScript(WithOptions) with an explicit opt-in. r=arai,necko-reviewers,webcompat-reviewers,devtools-reviewers,sync-reviewers,twisniewski,ochameau,jesup,robwu,profiler-reviewers,canova,Gijs\" for causing talos performance tests failures.\n\nThis reverts commit 40adcc963c5175b6315226775e28cc51aa6074b2.\n", "files": ["browser/components/places/tests/unit/head_bookmarks.js", "browser/extensions/webcompat/tests/browser/browser_interventions.js", "devtools/client/debugger/test/mochitest/integration/head.js", "devtools/client/shared/test/shared-head.js", "devtools/server/tests/xpcshell/head_dbg.js", "devtools/server/tests/xpcshell/test_setBreakpoint-at-the-beginning-of-a-minified-fn.js", "devtools/server/tests/xpcshell/test_setBreakpoint-at-the-end-of-a-minified-fn.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-column-in-gcd-script.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-column.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-in-gcd-script.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-multiple-offsets.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-multiple-statements.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-no-offsets.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line.js", "devtools/server/tests/xpcshell/test_source-03.js", "devtools/server/tests/xpcshell/test_source-04.js", "dom/indexedDB/test/unit/test_globalObjects_other.js", "dom/localstorage/test/unit/head.js", "dom/quota/test/modules/system/ModuleLoader.sys.mjs", "dom/quota/test/xpcshell/caching/head.js", "dom/quota/test/xpcshell/head.js", "dom/quota/test/xpcshell/telemetry/head.js", "dom/quota/test/xpcshell/upgrades/head.js", "js/xpconnect/idl/mozIJSSubScriptLoader.idl", "js/xpconnect/loader/mozJSSubScriptLoader.cpp", "js/xpconnect/tests/chrome/subscript.js", "js/xpconnect/tests/chrome/test_chrometoSource.xhtml", "js/xpconnect/tests/unit/test_bug451678.js", "js/xpconnect/tests/unit/test_subScriptLoader.js", "modules/libpref/init/StaticPrefList.yaml", "netwerk/test/httpserver/httpd.sys.mjs", "netwerk/test/unit/test_psl.js", "services/sync/tests/unit/head_helpers.js", "services/sync/tps/extensions/tps/resource/tps.sys.mjs", "toolkit/actors/PictureIn