4b44807aa35b81"], "node": "f39fa5e563412e3daef1a3f76e80591e1870d8ef", "parents": ["33f3fb26b3ca70c93763b9552ec448e635341da1"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057374 - Update PromoCard component for tablet and accessibility r=android-reviewers,calu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316222\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/PromoCard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/TabGroupOnboardingItem.kt"], "git_node": "d5d4cc74e61653313e07eb9c77eb7872300b8493", "git_parents": ["e65366f507fb8f77e57f7e19838866f22f0b81f2"], "node": "ecd49df2744b5ae3bff051c5424f467a18251761", "parents": ["f39fa5e563412e3daef1a3f76e80591e1870d8ef"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 1838723 - Cap search term length in SearchEngine.getSubmission. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315049\n", "files": ["toolkit/components/search/SearchEngine.sys.mjs", "toolkit/components/search/tests/xpcshell/test_getSubmission_encoding.js"], "git_node": "32f1e72358153ec756daf7f5abd1264821713c95", "git_parents": ["d5d4cc74e61653313e07eb9c77eb7872300b8493"], "node": "ae15007f22ed06035188bea4d84480e9952c2c30", "parents": ["ecd49df2744b5ae3bff051c5424f467a18251761"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2054933 - Update firstrun cards for HCM selected text and Back button icon styling r=czhou\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316402\n", "files": ["browser/components/aiwindow/ui/content/firstrun.css"], "git_node": "1149eb2999f6d17cb010a5248d6b8b65169fa592", "git_parents": ["32f1e72358153ec756daf7f5abd1264821713c95"], "node": "e50bc64ae0fa38a0d843f8bdcdb4594479238051", "parents": ["ae15007f22ed06035188bea4d84480e9952c2c30"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060895 - Move isOriginUrl from UrlbarUtils to UrlbarShared. r=mbeier,urlbar-reviewers\n\nA behavior-neutral relocation with no forwarder left behind: the check is pure\nURL parsing with no parent-process dependencies, so it belongs in the module\ncontent code can import, not in UrlbarUtils, which UrlbarInput has to stop\nreaching into before it can run in a content process.\n\nWorth verifying that the body is unchanged and that every caller moved.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316816\n", "files": ["browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/unit/test_UrlbarShared_isOriginUrl.js", "browser/components/urlbar/tests/unit/test_UrlbarUtils_isOriginUrl.js", "browser/components/urlbar/tests/unit/xpcshell.toml"], "git_node": "d024d4c99f1e17de37085e2cbf99b5dae4388d7d", "git_parents": ["1149eb2999f6d17cb010a5248d6b8b65169fa592"], "node": "b4bddeee2ed69ebade5b15c03421221de6b30274", "parents": ["e50bc64ae0fa38a0d843f8bdcdb4594479238051"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060895 - Handle autofill re-integration in the parent controller. r=mbeier,urlbar-reviewers\n\nWhen a user navigates to a URL whose autofill we had blocked, we clear the\nblock and record how long it had stood. Both halves are parent-side \u2014 the\nPlaces write, the in-memory backspace bookkeeping, and Glean, which isn't even\nexposed to the about:newtab content realm \u2014 so the whole cluster moves behind\nthe controller seam and the input is left deciding only when a navigation\ncounts as a re-integration.\n\nThe re-integration steps move into UrlbarUtils rather than the controller so\nthey sit next to the primitives they compose; the controller adds the\ntelemetry. Worth checking that the statement order there still matches the\nblock it replaces: the backspace entry is read after the database clear\nresolves and cleared immediately after, and the counters are still only\nrecorded when a block was actually cleared.\n\nThe input fires this without awaiting it, so tests sequence on\nUrlbarParentController._lastAutofillReintegrationPromise, which now also covers\nthe Glean write.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316817\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/tests/browser-autofill/browser_inputField_contextmenu_reintegration.js", "browser/components/urlbar/tests/browser-autofill/browser_reintegration_telemetry.js", "browser/components/urlbar/tests/browser/head-common.js", "browser/components/urlbar/tests/unit/test_UrlbarUtils_reintegrateAutofill.js", "browser/components/urlbar/tests/unit/xpcshell.toml"], "git_node": "06cd982c75792338280c5073c1703f633443ded5", "git_parents": ["d024d4c99f1e17de37085e2cbf99b5dae4388d7d"], "node": "b88c52f969f7eb5077c1554900ddb5cce4fa13af", "parents": ["b4bddeee2ed69ebade5b15c03421221de6b30274"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060895 - Clear the autofill backspace entry through the parent controller. r=mbeier,urlbar-reviewers\n\nAccepting an autofilled result clears its backspace count. That bookkeeping is\nthe parent's, so the input hands the URL over instead of reaching into\nUrlbarUtils; it stays fire-and-forget, and pickResult stays synchronous.\n\nNote a pre-existing wrinkle this makes easier to see: for a \"url\" autofill\npick, this clear runs before the re-integration below it, so the backspace\ntimestamp is already gone by the time re-integration looks for it and no\nunblock-delay sample is recorded. That is unchanged here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316818\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "995a0fa4a0189051fccc570b4209a2813b4e566a", "git_parents": ["06cd982c75792338280c5073c1703f633443ded5"], "node": "24c2ceb0166c7386054946b9f8987489d93fefb7", "parents": ["b88c52f969f7eb5077c1554900ddb5cce4fa13af"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060895 - Share the autofill dismissal implementation with UrlbarProviderAutofill. r=mbeier,urlbar-reviewers\n\nThe provider's result-menu dismissal and the input's context-menu dismissal do\nthe same three things: block the pairing (or remove the URL from history),\nclear the backspace bookkeeping, re-run the query. Only the last differs\nbetween them, so the first two move into UrlbarUtils and the provider is\nswitched over. This is a prerequisite for routing the input's copy through the\ncontroller, which is where the duplication would otherwise be entrenched.\n\nParent-only, no seam involved yet. Worth verifying the failure handling is\npreserved: a failed write is still reported and swallowed so the entry is\ncleared and the query re-runs either way. The block duration is now read in one\nplace, so the two dismissal paths can't drift apart on it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316819\n", "files": ["browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/tests/unit/test_UrlbarUtils_dismissAutofill.js", "browser/components/urlbar/tests/unit/xpcshell.toml"], "git_node": "e5c05628782c44194e193ccf6ccc4cf266708952", "git_parents": ["995a0fa4a0189051fccc570b4209a2813b4e566a"], "node": "a68cc79ca733a92b111abf6b8baa5ebd84d39faa", "parents": ["24c2ceb0166c7386054946b9f8987489d93fefb7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060895 - Dismiss autofill through the parent controller. r=mbeier,urlbar-reviewers\n\nBoth inputs' context-menu dismissal now hands the URL and the action to the\nparent controller, which owns the Places write, the backspace bookkeeping and\nthe Glean counter. This is the last of the autofill helpers the inputs reached\ninto directly, and it lets PlacesUtils go from both import maps.\n\nUnlike the other two, this one round-trips: the caller has to await the write\nbefore re-running its query, so the parent-controller method is async and the\nproxy uses sendQuery. That makes it the first query in this seam that resolves\nnothing \u2014 flagging it in case you'd rather it didn't. A rejected query is\ncaught at the call site, so the re-query still runs either way.\n\nThe Smartbar copy of the dismissal is identical and comes along, so the two\ncan't drift. It only ever takes the direct path, and it has no automated\ncoverage \u2014 a Smartbar dismissal test would be worth filing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316820\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "311469a5bf85c6b7b7768f1058072825a289fd27", "git_parents": ["e5c05628782c44194e193ccf6ccc4cf266708952"], "node": "fc32651b4dc54a0ccb0e08ec36faa8a3e8957b13", "parents": ["a68cc79ca733a92b111abf6b8baa5ebd84d39faa"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060895 - Record autofill deletions through the parent controller. r=mbeier,urlbar-reviewers\n\nThe last Glean call left in the inputs' autofill path, and it has the same\nproblem as the rest of the cluster: Glean isn't exposed to the about:newtab\ncontent realm. Fire-and-forget, so both inputs keep their synchronous input\nhandler.\n\nThe counter's test asserted it synchronously after the triggering input, which\nraces the actor hop on the message path \u2014 off by one, cascading into the\nfollowing subtests through the clear-on-read. It now waits for the expected\ncount first, the same way the engagement-telemetry helpers do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316821\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/tests/browser-telemetry/browser_autofill.js"], "git_node": "ce60b94840a7a8809429a215c2321f63ba7811b7", "git_parents": ["311469a5bf85c6b7b7768f1058072825a289fd27"], "node": "3c2a0e4e53731cf86c4d0947cff3ffd1a72e9ead", "parents": ["fc32651b4dc54a0ccb0e08ec36faa8a3e8957b13"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e b9e0e6109555d277a1dfdf814fd3a7bbf0ecb109\naf -\u