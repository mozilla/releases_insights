], "node": "6f01a002a21e0638659a7ceb911dc88e86dcd5cf", "parents": ["f3d458dff928cdc3cfd8623a9051569833b46e33"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2058168 - Migrate misc vm objects to TypedSlot. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314373\n", "files": ["js/src/vm/AsyncFunction.cpp", "js/src/vm/AsyncFunction.h", "js/src/vm/Iteration.cpp", "js/src/vm/Iteration.h", "js/src/vm/NativeObject.h", "js/src/vm/SharedArrayObject.cpp", "js/src/vm/SharedArrayObject.h"], "git_node": "471b51e7c12123f4ba025bb6c78341153bfd95d4", "git_parents": ["d5d5bb712f6b5f82fd6aecdaf5452f34c2e44d61"], "node": "6007b8a8df956cc56cfd46a74667ea140445318c", "parents": ["6f01a002a21e0638659a7ceb911dc88e86dcd5cf"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2058432: Disable ::-webkit-scrollbar on content.powerapps.com. r=TYLin\n\nThis domain (used by app.powerbi.com) has some JS that works with\n::-webkit-scrollbar in a way that's more sophisticated than our partial support\ncan handle (specifically, expecting arbitrary `width` / `height` values to\nwork).  This ends up giving us a worse experience (various useless scrollbars)\nwhen we have this feature enabled.  So, let's add the site to our feature\nopt-out list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315681\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "89a1d82ae033c74a0d38d97d2e3776eb2d17b63e", "git_parents": ["471b51e7c12123f4ba025bb6c78341153bfd95d4"], "node": "dab3514b715bdf2a2787ffccac483a4579a11042", "parents": ["6007b8a8df956cc56cfd46a74667ea140445318c"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055984 - Pre 1: Move taskbar FFI entry points into the ffi module. r=hsohaney\n\nDifferential Revision: https://phabricator.servic