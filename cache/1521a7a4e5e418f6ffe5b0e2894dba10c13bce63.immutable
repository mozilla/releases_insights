b7d39465756b54\nzam -\u003e 952e6a08ff0c03449421ee878ab7d39465756b54\nzh-CN -\u003e 952e6a08ff0c03449421ee878ab7d39465756b54\nzh-TW -\u003e 952e6a08ff0c03449421ee878ab7d39465756b54\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "0b7a3078a913c3c6ad0eb5176f27e952f76ec902", "git_parents": ["8af3dda4b7b58d5e6089b0f0c3df002a8bf82f2e"], "node": "610b620835ef13619da234ef52734daee0304c8a", "parents": ["877919aee2d5d6f2ed884e8e2913123a43402bda"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1910767 - Add subtitles support for ardmediathek.de. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D232854\n", "files": ["browser/extensions/pictureinpicture/data/picture_in_picture_overrides.js", "browser/extensions/pictureinpicture/video-wrappers/ardmediathek.js"], "git_node": "11b9905196ec0117225b5bb92b4cdc68e0620bd9", "git_parents": ["0b7a3078a913c3c6ad0eb5176f27e952f76ec902"], "node": "a259c2f30806e194957b7ae5c29799f2869c03ec", "parents": ["610b620835ef13619da234ef52734daee0304c8a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2052706 - Keep sidebar interactive in F11 fullscreen autohide r=emilio,sfoster\n\nThe autohide hides the toolbox when the pointer enters FullScreen's mouse-target\nrect. That rect was cached from tabpanels before the sidebar settled, so it\ncovered the sidebar; hovering it hid the toolbox (and the sidebar), making\nvertical tabs uninteractive.\n\nCompute the rect live in getMouseTargetRect so it follows the sidebar reveal.\nOnce settled, tabpanels excludes the sidebar on whichever side it sits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310514\n", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js"], "git_node": "24af02ad6f40fb1a6740a032a54c0e215ffba6c4", "git_parents": ["11b9905196ec0117225b5bb92b4cdc68e0620bd9"], "node": "faa328a84ba27835aa3746484d9d1b82223ef8c4", "parents": ["a259c2f30806e194957b7ae5c29799f2869c03ec"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2052711 - Keep panel sidebars visible in F11 fullscreen r=emilio,desktop-theme-reviewers,dao,sfoster\n\nBug 1927457 collapsed all sidebar elements on fullscreenNavToolboxHidden, so in\nF11 the panel sidebars (bookmarks, history) hid too and Ctrl+B couldn't bring\nthem back. The intent was to hide only the tools/vertical-tabs launcher, like\nthe horizontal tab strip.\n\nSplit the CSS: the launcher (#sidebar-container, #sidebar-launcher-splitter)\nstill hides with the toolbox, while the panel (#sidebar-box, #sidebar-splitter)\nonly hides in DOM fullscreen and stays toggleable in F11.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310515\n", "files": ["browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/themes/shared/tabbrowser/fullscreen-and-pointerlock.css"], "git_node": "9c716f78b062dcf0856c8fb81b9b31a541719aad", "git_parents": ["24af02ad6f40fb1a6740a032a54c0e215ffba6c4"], "node": "89b4b6a6d54282b84f19c9f2b5bd364ff222ee2d", "parents": ["faa328a84ba27835aa3746484d9d1b82223ef8c4"], "tags": []}, {"author": "Ped Y \u003cpedram.yekta12@gmail.com\u003e", "branch": "default", "desc": "Bug 2042435 - Fix Ruff warnings in ThirdPartyPaths.py. r=sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305454\n", "files": ["build/clang-plugin/ThirdPartyPaths.py"], "git_node": "e0a285c7fea75675dea9cb1eb262ad41abdc610d", "git_parents": ["9c716f78b062dcf0856c8fb81b9b31a541719aad"], "node": "4d98e75463d1e619a3ff5f864dfd326438e6ed02", "parents": ["89b4b6a6d54282b84f19c9f2b5bd364ff222ee2d"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057712 - Update android nightly application-services version bump to f80c895c3e4df71108cb594f786d05f194353302 r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314203\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "01cb2f6442a66cbf986619ba5f2723fd4af59e89", "git_parents": ["e0a285c7fea75675dea9cb1eb262ad41abdc610d"], "node": "68aa33038a6034697922f1ed4a4edb6ca6cf88a9", "parents": ["4d98e75463d1e619a3ff5f864dfd326438e6ed02"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1704419: Parse the Nintendo Switch Pro USB report directly on Windows r=cmartin\n\nThe Switch Pro (and 8BitDo pads in Switch mode, all VID 057e PID 2009) stream a\n0x30 full input report over USB, but their HID report descriptor does not\ndescribe that report's layout, so HidP_GetUsageValue/GetUsages extract garbage\n(jittering sticks, phantom buttons from the battery/charging-grip bits). Parse\nthe 0x30 report bytes directly instead, matching Chromium's NintendoController.\nNo init handshake is needed since the device already sends 0x30.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310550\n", "files": ["dom/gamepad/windows/WindowsGamepad.cpp"], "git_node": "8ff452d3f7adc21d7f94586d027bcaa2c51209cf", "git_parents": ["01cb2f6442a66cbf986619ba5f2723fd4af59e89"], "node": "3a4fd524bf6ee227ed03c41fa0e4e5322c161eae", "parents": ["68aa33038a6034697922f1ed4a4edb6ca6cf88a9"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057651 - Update PDF.js to 05e100c76e1e89949d31f9826ece370b733c1d14 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314100\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/p