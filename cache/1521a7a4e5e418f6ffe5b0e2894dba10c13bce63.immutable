s/browser/ContentSharingMockServer.sys.mjs", "browser/components/sharing/tests/browser/browser.toml", "browser/components/sharing/tests/browser/browser_testFeatureDisabled.js", "browser/components/sharing/tests/browser/browser_testLoadingState.js", "browser/components/sharing/tests/browser/browser_testModalErrors.js", "browser/components/sharing/tests/browser/browser_testPrivateBrowsing.js", "browser/components/sharing/tests/browser/browser_testReuseAuthCompleteTab.js", "browser/components/sharing/tests/browser/browser_testServerErrors.js", "browser/components/sharing/tests/browser/browser_testShareAuth.js", "browser/components/sharing/tests/browser/browser_testShareBookmarks.js", "browser/components/sharing/tests/browser/browser_testShareBookmarksFromSidebar.js", "browser/components/sharing/tests/browser/browser_testShareFolderEmpties.js", "browser/components/sharing/tests/browser/browser_testShareTabGroup.js", "browser/components/sharing/tests/browser/browser_testShareTabs.js", "browser/components/sharing/tests/browser/head.js", "browser/components/sharing/tests/unit/head.js", "browser/components/sharing/tests/unit/invalidContentSharing.0.1.0.json", "browser/components/sharing/tests/unit/test_cookies.js", "browser/components/sharing/tests/unit/test_detectLogin.js", "browser/components/sharing/tests/unit/test_makeValid.js", "browser/components/sharing/tests/unit/test_schema.js", "browser/components/sharing/tests/unit/validContentSharing.0.1.0.json", "browser/components/sharing/tests/unit/xpcshell.toml", "browser/components/tabbrowser/content/tabgroup-menu.js", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/modules/SharingUtils.sys.mjs", "browser/modules/moz.build", "toolkit/components/glean/metrics_index.py"], "git_node": "cadbf3422eb65f4f3357e346fa2a3c6e1a7de4b3", "git_parents": ["961df7232a53c686d7594164c2f9d34a861ef400"], "node": "f794027810afadd699e1e876ff3f4c18976defa5", "parents": ["1ee9c0836cf61aecadbee28009f1d29b4e7f862e"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060616 - Fix shield losing checkmark when returning to the tab for a domain with no trackers blocked. r=urlbar-reviewers,dao\n\nWhen navigating from a site with trackers to a site without trackers, the check-mark in the shield icon should persist.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316322\n", "files": ["browser/base/content/browser.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js"], "git_node": "b16fe93c1720114caa8344331aacc768e90eaaed", "git_parents": ["cadbf3422eb65f4f3357e346fa2a3c6e1a7de4b3"], "node": "070bfd7adf8224a27d032183ca27a32a3cb66ee0", "parents": ["f794027810afadd699e1e876ff3f4c18976defa5"], "tags": []}, {"author": "Jan-Ivar Bruaroey \u003cjan-ivar@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2056810 - update libdrm's moz.yaml for the no-op vendoring. r=ng\n\nUpstream f198c21dfcb89127083413dd4779a13b3f9a6507 does not modify any of the\nfiles we vendor, so `mach vendor` exits at the spurious-update check before\nbumping moz.yaml. Bump the revision by hand instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316345\n", "files": ["third_party/drm/moz.yaml"], "git_node": "6cbbbb85508e8f8bcd396c9ea9c3e06e4ae14779", "git_parents": ["b16fe93c1720114caa8344331aacc768e90eaaed"], "node": "3b148743f8b3a8c41c16f3288491f45d85c5856b", "parents": ["070bfd7adf8224a27d032183ca27a32a3cb66ee0"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060349: Change PNativeLayerRemote to use a SurfaceTransfer union. r=mstange\n\nThis changes the macOS-specifc IOSurfacePort into a generic union\nSurfaceTransfer, which is a union of platform-specific structures. The\nSurfaceTransferMacOS struct has a single IOSurfacePort member. An\nalternative hierarchy could define the SurfaceTransfer union with a\ncollection of platform-specific members. The chosen approach makes clear\nwhich struct is associated with each platform.\n\nThis also fixes up usage sites in NativeLayerRemoteMac and in\nNativeLayerRootRemoteMacParent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316123\n", "files": ["gfx/layers/NativeLayerRemoteMac.mm", "gfx/layers/NativeLayerRootRemoteMacParent.mm", "gfx/layers/ipc/PNativeLayerRemote.ipdl"], "git_node": "e269097645550c8ead5946b1bad1fdcb5a52949a", "git_parents": ["6cbbbb85508e8f8bcd396c9ea9c3e06e4ae14779"], "node": "d6751e6f64c7bf8682bdce7e1ca04a17d8a90410", "parents": ["3b148743f8b3a8c41c16f3288491f45d85c5856b"], "tags": []}], "date": 1785904056, "git_changesets": ["874d5d8b0b1ee257598bb96d885cb4cc3f5a0f2f", "c12f47b3dd4d4e2382705c5439a3046377a60989", "d134422f8930178825b22ef5872042361748f377", "cb8d778c5efb5b68c0076e996b81e28ba7ae2c88", "dcdfed02974fd230d6248d3bb0bb5729f67302f3", "b930c352d71dad8157ce4c76090cd39e161f0418", "59a9508cf58b7576d5a6594d52833fd28f4eaf33", "1fb9175bc31abc598a841b2123a83cc6db1d9976", "befdb44d3c68b743c7607108d6e7e3654ea28b08", "b7646161c508b02f584947c4239e1805c6dc195e", "412dc440954234f91dd63d57e63dcf835afcfd5f", "e98b25b5ee45ff89b6c6d063160c09e79a8ec254", "4bd10b761d5f4cdce4b088ca8260fc0fb7ed7aa1", "c9236ad5816712b84625c06a6c37e72a2ab14541", "639f52942cd91e57aa36650e1e9c7a3cb756b7ec", "2f3793d065bdfc0f97c0851aa7af226de2b46d22", "362adfb467adb6e7c56afb81242b2dc337194a4b", "8a5f16c0cd09f46ce3182b712bc8e909fbd517e4", "99beeb42b7bf801508900e122fbea47797ac33b0", "ef2ff706dbdaff5c72471cefcb2c51ed79facd4f", "3534aaf4cb209aaa74f49dcb3a6a213985498aff", "755cab013ee26b12b0e760127be8443ef6422cda", "485d39aa1fc46e8d9b203912fe0a67449011a883", "dad370a0e8ce42b52494e9844ef9673316e4786f", "1720c1c30def0bdd99583dd3b716d16166cfc5d8", "0f96e91d3ae1d14f563e1886db8f7b3d9cde3568", "b83904cf797c9cd1fd11d469b44f4c53201e59fd", "401821b2cb1a1d2c383ef9ef076ef9fff2f818a6", "151abebddb2b60048903a12c6013c1ad4e361b52", "f6011f9884d6173e6bfdac8ab84f093ff6ed0fb