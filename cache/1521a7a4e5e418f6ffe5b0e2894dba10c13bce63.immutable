lure is unrelated to Nova or vertical tab; it is a permafail on Wayland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317701\n", "files": ["dom/documentpip/tests/browser/browser.toml"], "git_node": "fe15ba0a09c4d65a385292b5fd5fd095752853ec", "git_parents": ["5afdd55de9b2b5b69450726175a16eef221e6b82"], "node": "c30c1fe8b2921fa0b552c95db98dec6d22b46048", "parents": ["9cb0fe778a6a7ab902052d7be49a513b6c2ebb5f"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2061661 - Prefer using oneOf over enums in policy schema. r=apieper,mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317039\n", "files": ["browser/components/contextualidentity/test/browser/browser_container_definitions_in_sync.js", "browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": "e6f5e816ccbec9883bd28e5e34783cb7fb690517", "git_parents": ["fe15ba0a09c4d65a385292b5fd5fd095752853ec"], "node": "07becdf2c6159e311c06c12d3acc7278b5c8d64b", "parents": ["c30c1fe8b2921fa0b552c95db98dec6d22b46048"], "tags": []}, {"author": "Artur Iunusov \u003caiunusov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059185 - FIX Parent process accepts child-forged PERSISTENT persistenceType in PBackgroundIDBFactory open/delete requests r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316564\n", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": "646f03709dbf879981642b1c9bffa5e1237d8557", "git_parents": ["e6f5e816ccbec9883bd28e5e34783cb7fb690517"], "node": "c538043d8852b5c8396d7ceb0d168a41e0ab569a", "parents": ["07becdf2c6159e311c06c12d3acc7278b5c8d64b"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062282 - Close unrelated auto popovers when dialog inside hint opens r=dom-core-reviewers,smaug\n\nThis updates these algorithms to match the spec changes proposed in https://github.com/whatwg/html/pull/12764\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317541\n", "files": ["dom/base/Document.cpp", "dom/events/EventStateManager.cpp", "testing/web-platform/meta/html/semantics/popovers/popover-top-layer-nesting-hints.html.ini", "testing/web-platform/tests/html/semantics/popovers/popover-top-layer-nesting-hints.html"], "git_node": "f6a45b81e450ec75d9845be749da3cb4fdfceae0", "git_parents": ["646f03709dbf879981642b1c9bffa5e1237d8557"], "node": "bb5eaa67b04795f6caf1ca4d078a91d891466c25", "parents": ["c538043d8852b5c8396d7ceb0d168a41e0ab569a"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2060165 - chore(rust): audit-shim-upgrade `itertools` 0.14.0 \u2192 0.15.0 r=glandium,supply-chain-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315997\n", "files": ["Cargo.lock", "Cargo.toml", "build/rust/itertools-0.13/Cargo.toml", "build/rust/itertools-0.13/lib.rs", "build/rust/itertools/Cargo.toml", "build/workspace-hack/Cargo.toml", "supply-chain/audits.toml", "third_party/rust/itertools/.cargo-checksum.json", "third_party/rust/itertools/.cargo_vcs_info.json", "third_party/rust/itertools/CHANGELOG.md", "third_party/rust/itertools/Cargo.lock", "third_party/rust/itertools/Cargo.toml", "third_party/rust/itertools/Cargo.toml.orig", "third_party/rust/itertools/README.md", "third_party/rust/itertools/benches/combinations_with_replacement.rs", "third_party/rust/itertools/benches/powerset.rs", "third_party/rust/itertools/benches/specializations.rs", "third_party/rust/itertools/benches/tree_reduce.rs", "third_party/rust/itertools/benches/tuple_combinations.rs", "third_party/rust/itertools/examples/iris.rs", "third_party/rust/itertools/src/adaptors/coalesce.rs", "third_party/rust/itertools/src/adaptors/mod.rs", "third_party/rust/itertools/src/all_equal_value_err.rs", "third_party/rust/itertools/src/array_impl.rs", "third_party/rust/itertools/src/combinations.rs", "third_party/rust/itertools/src/combinations_with_replacement.rs", "third_party/rust/itertools/src/duplicates_impl.rs", "third_party/rust/itertools/src/either_or_both.rs", "third_party/rust/itertools/src/exactly_one_err.rs", "third_party/rust/itertools/src/free.rs", "third_party/rust/itertools/src/group_map.rs", "third_party/rust/itertools/src/groupbylazy.rs", "third_party/rust/itertools/src/grouping_map.rs", "third_party/rust/itertools/src/kmerge_impl.rs", "third_party/rust/itertools/src/lib.rs", "third_party/rust/itertools/src/minmax.rs", "third_party/rust/itertools/src/pad_tail.rs", "third_party/rust/itertools/src/peeking_take_while.rs", "third_party/rust/itertools/src/powerset.rs", "third_party/rust/itertools/src/size_hint.rs", "third_party/rust/itertools/src/tuple_impl.rs", "third_party/rust/itertools/src/unique_impl.rs", "third_party/rust/itertools/src/with_position.rs", "third_party/rust/itertools/src/ziptuple.rs", "third_party/rust/itertools/tests/adaptors_no_collect.rs", "third_party/rust/itertools/tests/arrays.rs", "third_party/rust/itertools/tests/laziness.rs", "third_party/rust/itertools/tests/quick.rs", "third_party/rust/itertools/tests/specializations.rs", "third_party/rust/itertools/tests/test_core.rs", "third_party/rust/itertools/tests/test_std.rs", "third_party/rust/itertools/tests/zip.rs"], "git_node": "6c3cf2c215a425f0c867d5219d2bfa10641db690", "git_parents": ["f6a45b81e450ec75d9845be749da3cb4fdfceae0"], "node": "a8e77af4346fc3b3820809075237fb43243545ca", "parents": ["bb5eaa67b04795f6caf1ca4d078a91d891466c25"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062448 - Give BrowserTestUtils.waitForMutationCondition a default timeout and message. r=firefox-desktop-core-reviewers ,Gijs\n\nwaitForMutationCondition only settles when its condition passes, so a condition\nthat never becomes true hangs the test until the harness kills it, with nothing\nin the log naming the wait. Tests have been reaching for waitForCondition\ninstead, or hand-rolling bounded wrappers of their own.\n\nThis gives it the failure behavior waitForCondition already has: a timeout, a\nmessage naming the wait, and rejection if the test finishes while the wait is\nstill pending. The timeout defaults to 10s, well under the 45s browser-chrome\ntask timeout. Infinity opts out of it; 0 doesn't, so a miscomputed timeout fails\nfast rather than hanging. Callers that pass no message get one built from the\ncall site and the source of checkFn.\n\nThe 10s default comes out of try runs at 60s, 30s, 20s and 10s across opt,\ndebug, asan and tsan, which turned up a single wait that legitimately needs\nlonger; it's opted out later in this stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317817\n", "files": ["testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs", "testing/mochitest/tests/browser/browser_BrowserTestUtils.js"], "git_node": "aff828eb526bcb9fb179ef9fee646cd92f681f11", "git_parents": ["6c3cf2c215a425f0c867d5219d2bfa10641db690"], "node": "e3d43777f908face0abfd1f94477ed1bffe40773", "parents": ["a8e77af4346fc3b3820809075237fb43243545ca"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062448 - Let the sidebar tools resize wait run as long as it needs. r=sfoster\n\nresetToolsHeight waits for the tools to stop overflowing after resizeTools has\nshrunk them, and resizeTools walks the splitter down a frame at a time. Under\ntsan that walk runs past a minute, so the bound waitForMutationCondition now\napplies by default cut the wait short where it used to just take a while.\n\nA longer bound is no help: measured against tsan the wait wants more than 60s and\nthe harness gives up on the test at 120s, so anything that fits between the two is\na guess that turns into an intermittent. Opt this wait out and let the harness be\nthe thing that gives up. The eight callers all go through this helper, so this is\nthe only place that needs it.\n\nThe underlying slowness is worth its own look - a resize this expensive to drive\nis a lot of test runtime for what it checks - but that is a bigger change than\nunblocking the default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317819\n", "files": ["browser/components/sidebar/tests/browser/browser_tools_overflow.js"], "git_node": "baee68dff159340643602442aa7df08dbba36bf9", "git_parents": ["aff828eb526bcb9fb179ef9fee646cd92f681f11"], "node": "dbfd94e4f16d88089ddb3bbdcacb18f39512ba84", "parents": ["e3d43777f908face0abfd1f94477ed1bffe40773"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062448 - Watch for the tab strip leaving moving-tab mode instead of polling for it. r=nsharpley,tabbrowser-reviewers\n\nThe stale drag tests polled for the movingtab attribute because\nwaitForMutationCondition had no way to fail. It does now, so observe the\nattribute the check reads: the wait ends on the mutation that clears it, and a\nrecovery that never happens fails with the message naming what was expected\nrather than after fifty quiet retries.\n\nThe three waits collapse into one helper alongside assertNotMovingTab. The\nreduced-motion wait stays a waitForCondition - gReduceMotion is a script global\nwith no mutation behind it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317853\n", "files": ["browser/components/tabbrowser/test/browser/dragdrop/browser_stale_drag_session.js"], "git_node": "3dd7a9f398e9b5a4410436efb49f3e3b95b3d6a5", "git_parents": ["baee68dff159340643602442aa7df08dbba36bf9"], "node": "c0567eed158d28ae50863387809a524336090b29", "parents": ["dbfd94e4f16d88089ddb3bbdcacb18f39512ba84"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062892 - Enable Happy Eyeballs v3 by default on desktop, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318057\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "80a35b690ff2cd00778022054f374b3cd27fadf2", "git_parents": ["3dd7a9f398e9b5a4410436efb49f3e3b95b3d6a5"], "node": "262b73f22a31f8b7c388d5f891db5ed32e2b8b04", "parents": ["c0567eed158d28ae50863387809a524336090b29"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 1980909 - Update use-moz-src to support actors. r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316936\n", "files": ["tools/use-moz-src/mach_commands.py"], "git_node": "5290942ae11bffcc86b7e4b178fdaac2f7563ccb", "git_parents": ["80a35b690ff2cd00778022054f374b3cd27fadf2"], "node": "a73bc64beb884598359f57cadd4f3b78368de066", "parents": ["262b73f22a31f8b7c388d5f891db5ed32e2b8b04"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2059947 - Enable QUIC v2 version negotiation on all channels r=kershaw\n\nnetwork.http.http3.version_negotiation.enabled has shipped as Nightly-only\n(@IS_NIGHTLY_BUILD@) since it was introduced. When the pref is true, neqo\noffers Version::all() (QUIC v2 preferred, then v1), letting Firefox negotiate\nup to QUIC v2 (RFC 9369) with servers that support it; when false it offers\nv1 only. The pref has ridden Nightly without issue, so enable it on all\nchannels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315805\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "0a85f7f248ea43b68b9aa310b6766d34520be3c2", "git_parents": ["5290942ae11bffcc86b7e4b178fdaac2f7563ccb"], "node": "24ca3123a6ce108cc17a8c558e77e3cac99883b9", "parents": ["a73bc64beb884598359f57cadd4f3b78368de066"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053404 - Cleanup default state for static-analysis on Windows / intl part r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311060\n", "files": ["intl/components/src/Bidi.cpp", "intl/components/src/Bidi.h", "intl/locale/windows/OSPreferences_win.cpp"], "git_node": "98704c3bd2e9c54a93e1cc66ffba91604f7b89d8", "git_parents": ["0a85f7f248ea43b68b9aa310b6766d34520be3c2"], "node": "6babda91e8c4c9afacf54f022eee3a9fb8b0a314", "parents": ["24ca3123a6ce108cc17a8c558e77e3cac99883b9"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053404 - Cleanup default state for static-analysis on Windows / image part r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311061\n", "files": ["image/decoders/icon/win/nsIconChannel.cpp"], "git_node": "fa78f6c1c9787343dbe4f4b74251437cbdad28a2", "git_parents": ["98704c3bd2e9c54a93e1cc66ffba91604f7b89d8"], "node": "465f8d7858aa7472b1fbc0ddb666ebabcddc89a1", "parents": ["6babda91e8c4c9afacf54f022eee3a9fb8b0a314"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053404 - Cleanup default state for static-analysis on Windows / hal part r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311062\n", "files": ["hal/windows/WindowsSensor.cpp"], "git_node": "1fab485d5b4cf618c1bb9766096ac38f6fbcbce5", "git_parents": ["fa78f6c1c9787343dbe4f4b74251437cbdad28a2"], "node": "2731fa44001f6aef6af89a7d5046f462593ab8b3", "parents": ["465f8d7858aa7472b1fbc0ddb666ebabcddc89a1"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053404 - Cleanup default state for static-analysis on Windows / gfx part r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311063\n", "files": ["gfx/2d/NativeFontResourceDWrite.cpp", "gfx/2d/SkConvolver.cpp", "gfx/2d/SkConvolver.h", "gfx/2d/SourceSurfaceD3D11.cpp", "gfx/2d/SourceSurfaceD3D11.h", "gfx/ipc/FileHandleWrapper.cpp", "gfx/ipc/FileHandleWrapper.h", "gfx/layers/D3D11ZeroCopyTextureImage.cpp", "gfx/layers/D3D11ZeroCopyTextureImage.h", "gfx/layers/NativeLayerCommandQueue.cpp", "gfx/layers/NativeLayerCommandQueue.h", "gfx/layers/RemoteTextureMap.cpp", "gfx/layers/RemoteTextureMap.h", "gfx/layers/apz/src/InputQueue.h", "gfx/layers/apz/src/OverscrollHandoffState.cpp", "gfx/layers/apz/src/OverscrollHandoffState.h", "gfx/layers/d3d11/CompositeProcessD3D11FencesHolderMap.cpp", "gfx/layers/d3d11/CompositeProcessD3D11FencesHolderMap.h", "gfx/layers/d3d11/CompositorD3D11.cpp", "gfx/layers/d3d11/CompositorD3D11.h", "gfx/layers/d3d11/DeviceAttachmentsD3D11.cpp", "gfx/layers/d3d11/DeviceAttachmentsD3D11.h", "gfx/layers/d3d11/FenceD3D11.cpp", "gfx/layers/d3d11/FenceD3D11.h", "gfx/layers/d3d11/GpuProcessD3D11TextureMap.cpp", "gfx/layers/d3d11/GpuProcessD3D11TextureMap.h", "gfx/layers/d3d11/TextureD3D11.cpp", "gfx/layers/d3d11/TextureD3D11.h", "gfx/layers/d3d11/VideoProcessorD3D11.cpp", "gfx/layers/wr/AsyncImagePipelineOp.cpp", "gfx/layers/wr/AsyncImagePipelineOp.h", "gfx/thebes/D3D11Checks.cpp", "gfx/thebes/SharedFontList.h", "gfx/thebes/gfxDWriteCommon.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFont.h", "gfx/thebes/gfxWindowsPlatform.cpp", "gfx/vr/ipc/VRParent.cpp", "gfx/vr/ipc/VRParent.h", "gfx/vr/service/OSVRSession.cpp", "gfx/vr/service/OpenVRSession.cpp", "gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/RenderCompositorD3D11SWGL.h", "gfx/webrender_bindings/RenderD3D11TextureHost.cpp"], "git_node": "f3cd9c7cf5c6ade84a7eb56eb11304df12d76445", "git_parents": ["1fab485d5b4cf618c1bb9766096ac38f6fbcbce5"], "node": "e4b46ee621d80ffb408f802bc837afb6f7c5307f", "parents": ["2731fa44001f6aef6af89a7d5046f462593ab8b3"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062282 - Close unrelated auto popovers when dialog inside hint opens r=dom-core-reviewers,smaug\" for causing wpt failures @ popover-hint-dialog-dismisses-unrelated-auto.htm\n\nThis reverts commit f6a45b81e450ec75d9845be749da3cb4fdfceae0.\n", "files": ["dom/base/Document.cpp", "dom/events/EventStateManager.cpp", "testing/web-platform/meta/html/semantics/popovers/popover-top-layer-nesting-hints.html.ini", "testing/web-platform/tests/html/semantics/popovers/popover-top-layer-nesting-hints.html"], "git_node": "855ff4cfc558919955c26b95c47106ba1f3fbc35", "git_parents": ["f3cd9c7cf5c6ade84a7eb56eb11304df12d76445"], "node": "ff50a3fac37a6ff62bac9b8e81df9f17326aa185", "parents": ["e4b46ee621d80ffb408f802bc837afb6f7c5307f"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062448 - Watch for the tab strip leaving moving-tab mode instead of polling for it. r=nsharpley,tabbrowser-reviewers\" for causing bc failures @ browser_sidebar_expand_on_hover\n\nThis reverts commit 3dd7a9f398e9b5a4410436efb49f3e3b95b3d6a5.\n\nRevert \"Bug 2062448 - Let the sidebar tools resize wait run as long as it needs. r=sfoster\"\n\nThis reverts commit baee68dff159340643602442aa7df08dbba36bf9.\n\nRevert \"Bug 2062448 - Give BrowserTestUtils.waitForMutationCondition a default timeout and message. r=firefox-desktop-core-reviewers ,Gijs\"\n\nThis reverts commit aff828eb526bcb9fb179ef9fee646cd92f681f11.\n", "files": ["browser/components/sidebar/tests/browser/browser_tools_overflow.js", "browser/components/tabbrowser/test/browser/dragdrop/browser_stale_drag_session.js", "testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs", "testing/mochitest/tests/browser/browser_BrowserTestUtils.js"], "git_node": "66e0a2b9a42aab6ab2522a212808a1849f8c5e07", "git_parents": ["855ff4cfc558919955c26b95c47106ba1f3fbc35"], "node": "fdb0abb43ecaad0e0f299ad7a3fb91162581862b", "parents": ["ff50a3fac37a6ff62bac9b8e81df9f17326aa185"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053997 - Make `Range.deleteContents()`, `Range.cloneContents()`, `Range.extractContents()` and `Selection.deleteFromDocument()` work as in the DOM r=smaug\" for causing reftest failure\n\nThis reverts commit c0e7a7b5ddc71f1eea050af7b4c213d0d45111c2.\n", "files": ["dom/base/CrossShadowBoundaryRange.h", "dom/base/nsRange.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/selection/shadow-dom/tentative/Selection-deleteFromDocument-around-shadow.html.ini", "testing/web-platform/tests/dom/ranges/Range-cloneContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-cloneContents-around-shadow.tentative.html", "testing/web-platform/tests/dom/ranges/Range-deleteContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-deleteContents-around-shadow.tentative.html", "testing/web-platform/tests/dom/ranges/Range-extractContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-extractContents-around-shadow.tentative.html", "testing/web-platform/tests/selection/shadow-dom/tentative/Selection-deleteFromDocument-around-shadow.html"], "git_node": "604a2df6d15da2b659e680a0492c4e3367755eb9", "git_parents": ["66e0a2b9a42aab6ab2522a212808a1849f8c5e07"], "node": "147bc958c171144a227b613145f7b1ec9b078034", "parents": ["fdb0abb43ecaad0e0f299ad7a3fb91162581862b"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2006675 - Add WPTs for promise rejection events with many promises. r=smaug\n\nThe existing tests in this directory all use one or two promises. These\nreject more in a single turn, then handle them all, none, every other one,\nin reverse order, and after the reports have already been dispatched.\n\nThese cover existing behaviour and pass without the change that follows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317557\n", "files": ["testing/web-platform/tests/html/webappapis/scripting/processing-model-2/unhandled-promise-rejections/promise-rejection-events-many-promises.dedicatedworker.html", "testing/web-platform/tests/html/webappapis/scripting/processing-model-2/unhandled-promise-rejections/promise-rejection-events-many-promises.html", "testing/web-platform/tests/html/webappapis/scripting/processing-model-2/unhandled-promise-rejections/support/promise-rejection-events-many-promises.js"], "git_node": "8d9038852dce851c9ae942a397468174fc37609d", "git_parents": ["604a2df6d15da2b659e680a0492c4e3367755eb9"], "node": "cc4324909127701b3d09a92f0f7e76b6592a17ed", "parents": ["147bc958c171144a227b613145f7b1ec9b078034"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2006675 - Find rejected promises by ID instead of scanning the pending lists. r=smaug\n\nPromiseRejectionTrackerCallback and PromiseDebugging::AddConsumedRejection\neach located a promise by walking an entire list on every settled rejection.\nCleared entries are nulled in place rather than removed, so every scan walks\npast all of them. With many rejections settled in one microtask checkpoint\nthis is quadratic.\n\nmPendingUnhandledRejections is already keyed by promise ID and already\nremoved from on both arms of the handled path, so it now also stores the\npromise's index in mAboutToBeNotifiedRejectedPromises. One Extract replaces\nthe scan and that removal, which is less work than before at any list length.\nThe index outlives the array when AfterProcessMicrotasks hands it off, so the\nslot is re-checked before being cleared.\n\nPromiseDebugging's mUncaughtRejections has no such existing table, and unlike\nthe above it is appended to even for muted errors, so it keeps a companion\nindex hashtable built only once it grows past kRejectedPromiseIndexThreshold.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312890\n", "files": ["dom/promise/PromiseDebugging.cpp", "dom/promise/PromiseDebugging.h", "xpcom/base/CycleCollectedJSContext.cpp", "xpcom/base/CycleCollectedJSContext.h"], "git_node": "4488afd0ce18e7f0a1397def96b491baa10b3be8", "git_parents": ["8d9038852dce851c9ae942a397468174fc37609d"], "node": "d7894a6210ac7732a848f0b10d85a65732741f00", "parents": ["cc4324909127701b3d09a92f0f7e76b6592a17ed"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062811 - Use line-height for vertical scroll amount. r=jfkthame,masayuki,layout-reviewers\n\nSee bug 2062811 for some discussion, but generally it seems like this is\na better metric for \"how tall a line is\". It matches how we do\ncontenteditable sizing and such for example, and gives authors some\nflexibility here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317959\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/tests/css/css-overflow/line-scroll-amount-line-height.html"], "git_node": "8de33327c932c3be1c5f4fa1e1681fa6e40f2aae", "git_parents": ["4488afd0ce18e7f0a1397def96b491baa10b3be8"], "node": "c6cd6f5e332339f8f3e1092d046ed6f5c58dd144", "parents": ["d7894a6210ac7732a848f0b10d85a65732741f00"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke.akatsuka@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2046646 - Apply high contrast syle to result menu and switcher for Nova r=desktop-theme-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312188\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/themes/shared/urlbar-searchbar.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/windows/browser.css"], "git_node": "d74097bad5260a3b37abe26b028cc9a339f2a80e", "git_parents": ["8de33327c932c3be1c5f4fa1e1681fa6e40f2aae"], "node": "314320cad65b6de6986b8ec95de8c48a5f4e666e", "parents": ["c6cd6f5e332339f8f3e1092d046ed6f5c58dd144"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1859385 - Avoid gathering visited declarations if we know it'd be pointless. r=firefox-style-system-reviewers,dshin\n\nI think this is a simpler version of D317356 in practice.\n\nD317356 on top could help, only if there's any visited property on the\nelement under the link, but that seems more uncommon.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317967\n", "files": ["servo/components/style/properties/cascade.rs"], "git_node": "75418169be8631ed11fbbc682d1da27fbd3b7e69", "git_parents": ["d74097bad5260a3b37abe26b028cc9a339f2a80e"], "node": "ad33dc1273c971a10ca0dcaa05781663995cf220", "parents": ["314320cad65b6de6986b8ec95de8c48a5f4e666e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062204 - Avoid sign extension reading DWARF CFA opcode (Coverity CID 1213979) r=profiler-reviewers,canova\n\nAssigning *cursor_ (signed char) to unsigned opcode sign-extends bytes\n\u003e= 0x80. Cast through unsigned char, matching the existing pattern\nelsewhere in this file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317474\n", "files": ["tools/profiler/lul/LulDwarf.cpp"], "git_node": "13886646de6fe553d1bd4fbd3e7beb95874f677e", "git_parents": ["75418169be8631ed11fbbc682d1da27fbd3b7e69"], "node": "54b1f004744a4797ca701df59de0b6e8f2f48b84", "parents": ["ad33dc1273c971a10ca0dcaa05781663995cf220"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1962840 - Use a HashSet instead of a sorted Vector for wasm instance tracking. r=yury\n\n`wasm::Realm::instances_` and `JSRuntime::wasmInstances` were sorted\nvectors, so every registration did a `BinarySearchIf` and an `O(N)`\n`Vector::insert`, making instantiation quadratic.\n\nThe ordering was actually no longer necessary. It existed so a second binary search\ncould map a pc to an instance during stack walking, which was changed to be process-wide\nin bug 1406041.\n\nThanks to Mayank Bansal  for reporting this and investigating the fix. This is based on\nhis patch but it had to be rebased for bug 2045435.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317786\n", "files": ["js/src/debugger/Debugger.cpp", "js/src/vm/Realm.cpp", "js/src/vm/Runtime.cpp", "js/src/vm/Runtime.h", "js/src/wasm/WasmRealm.cpp", "js/src/wasm/WasmRealm.h", "js/src/wasm/WasmTypeDecls.h"], "git_node": "571dd294d879218e57b6aa124638071c405a409a", "git_parents": ["13886646de6fe553d1bd4fbd3e7beb95874f677e"], "node": "14f05b3bf7a9a7baac077bd333b0e6e392f7670c", "parents": ["54b1f004744a4797ca701df59de0b6e8f2f48b84"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061506 - [devtools] Close RDM reload notification when closing RDM. r=devtools-reviewers,jdescottes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317834\n", "files": ["devtools/client/responsive/ui.js", "devtools/client/responsive/utils/notification.js"], "git_node": "f302e0d87e5a9fc6a457b141f9e597904ab4789e", "git_parents": ["571dd294d879218e57b6aa124638071c405a409a"], "node": "33ce243b1071976b84fea29e022c75e4bbfbfdd7", "parents": ["14f05b3bf7a9a7baac077bd333b0e6e392f7670c"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2056523 - Part 1 - Prevent redundant private mode lock actions. r=android-reviewers,alastun,twhite\n\nCancel browser and app store scopes during Activity destruction and guard\n private mode lock dispatches by checking the current app state.\n\n This avoids unnecessary navigation events and prevents background collectors\n from continuing after the Activity is destroyed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316664\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pbmlock/PrivateBrowsingLockFeature.kt"], "git_node": "3a0f015f95c01cdfe4c0b49bf38569a87a6feed4", "git_parents": ["f302e0d87e5a9fc6a457b141f9e597904ab4789e"], "node": "7ae2d4a98201aaaad87aaf172787b157903834c9", "parents": ["33ce243b1071976b84fea29e022c75e4bbfbfdd7"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2056523 - Part 2 - Fix Open in Firefox private lock suppression race. r=android-reviewers,twhite\n\nIssue:\n The Custom Tab to browser handoff creates a new Activity and a new\n PrivateBrowsingLockFeature instance. The instance-scoped openInFirefoxRequested\n flag can be lost before the new Activity observes the AppStore update, causing\n an unexpected private browsing unlock prompt.\n\n Changes:\n - Move 'openInFirefoxRequested' to a static companion object to bridge\n   the suppression signal across Activity instances.\n - Remove the 'onStart' reset to resolve the race condition where a\n   newly starting Activity would clear the signal before the outgoing\n   Activity's 'onStop' could use it.\n - Adds cleanup of the static flag in 'onDestroy' to ensure suppression\n   is only applied to the intended handoff.\n - Add and modify tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316665\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pbmlock/PrivateBrowsingLockFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pbmlock/PrivateBrowsingLockFeatureTest.kt"], "git_node": "453572852711ad78034f33468e1479f7a6333743", "git_parents": ["3a0f015f95c01cdfe4c0b49bf38569a87a6feed4"], "node": "999ef8cd4ba2b6adf22353d57b500f45ac1137eb", "parents": ["7ae2d4a98201aaaad87aaf172787b157903834c9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060903 - Resolve a result's SERP-ness in the parent process. r=daleharvey\n\nWhether a result's URL is a search engine results page takes the search\nservice, so a content process can't answer it. The providers manager resolves\nit when it finalizes a result, alongside the other data it pre-computes for the\nview, and the result carries the answer over the wire.\n\nThe check only moves earlier within the same query, past a query start that\nalready awaits the search service, so it still answers what it answered at view\nand record time. Its sole consumer is the engagement telemetry type's `_serp`\nsuffix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317581\n", "files": ["browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/UrlbarResult.mjs"], "git_node": "305a47ff4a39e5bb7ab7641c7a3ca907dac9dc6e", "git_parents": ["453572852711ad78034f33468e1479f7a6333743"], "node": "1b045115ab6c6428b0978f8708e0991c16acac60", "parents": ["999ef8cd4ba2b6adf22353d57b500f45ac1137eb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060903 - Move searchEngagementTelemetryType to UrlbarShared. r=daleharvey\n\nThe view and the telemetry collector both classify a result content-side, so the\nclassifier has to live in a module content can import. It's a plain move except\nfor the `_serp` suffix, which now reads the SERP-ness off the result instead of\nasking the search service, and the tip types, which it now names through\nUrlbarShared.\n\nWith this, UrlbarUtils no longer pulls in UrlbarSearchUtils or the two tip\nproviders.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317582\n", "files": ["browser/components/urlbar/UrlbarMuxerStandard.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarTelemetryUtils.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-engagementTelemetry/head-exposure.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_weather.js"], "git_node": "5045203921a9d9d241e22ac63846bfd0f9715b58", "git_parents": ["305a47ff4a39e5bb7ab7641c7a3ca907dac9dc6e"], "node": "909b6efefa3902dfd86b2bf3e03678da519412d6", "parents": ["1b045115ab6c6428b0978f8708e0991c16acac60"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062580 - Migrate 2 SettingsGeneralTest UI tests to the efficiency framework r=jajohnson\n\nConverts the two remaining @SmokeTest methods in org.mozilla.fenix.ui.SettingsGeneralTest onto the ui/efficiency framework:\n\n    verifyFontSizingChangeTest (TestRail 344213)\n    changeDefaultBrowserSetting (TestRail 243583)\n\nHarness additions (all reusable):\n\n    BasePage.mozSetSliderValue: drives a Compose slider via the SetProgress semantics action.\n    SettingsAccessibilityPage: font-sizing selectors + verifyFontSizingMenuItems / clickAutomaticFontSizingToggle / changeTextSizeSlider / verifyTextSizePercentage.\n    BrowserPage.verifyTextSizeOnWebsite: asserts engine.settings.fontSizeFactor.\n    SettingsPage: verifyDefaultBrowserToggle / clickDefaultBrowserSwitch / verifyAndroidDefaultAppsMenuAppears (Espresso intended(REQUEST_ROLE); BaseTest already runs on HomeActivityIntentTestRule / IntentsTestRule).\n\nParity: full \u2014 every legacy assertion is carried over (both font-sizing menu-state checks, slider set + percentage, engine font factor; default-browser toggle-off, switch click, role-request intent). No dropped legs.\n\nVerified green on an emulator: JUnit tests=3 failures=0 errors=0 skipped=0, no retry. effcheck and :fenix:ktlint clean.\n\nWhy: Move Fenix smoke coverage onto the maintained ui/efficiency framework and retire the legacy robot-based tests.\n\nContext: part of the ui/efficiency UI-test modernization. This is a faithful port of an existing legacy ui/ smoke test onto the ui/efficiency framework \u2014 same coverage and assertions, but far less per-test code via a shared page-object / selector / navigation layer, which bends the UI-test maintenance cost curve. Smoke-conversion campaign.\n\nTestRail: 344213, 243583\n\nBoth UI tests successfully passed 50x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=77995 | try ]]\n\nAll efficiency UI test successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=77994 | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318046\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsGeneralTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAccessibilityPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsAccessibilitySelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsGeneralTest.kt"], "git_node": "ebb62c488dd381897ede72706186302b539d7a5f", "git_parents": ["5045203921a9d9d241e22ac63846bfd0f9715b58"], "node": "e077106cb818e68c8424f312145c014ecce1dced", "parents": ["909b6efefa3902dfd86b2bf3e03678da519412d6"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062937. Don't record the checkout path in libvpx's generated config files. r=media-playback-reviewers,padenot\n\ngenerate_sources_mozbuild.sh passed an absolute --log path to libvpx's configure,\nand configure records its own command line in vpx_config.c, so the absolute path of\nwhoever last ran the script ended up committed in all twelve config/*/vpx_config.c.\nThat publishes a contributor's local directory layout, and it means the file can only\nbe regenerated identically on that one machine, so re-vendoring libvpx never\nreproduces the committed tree anywhere else.\n\nPass a relative --log and copy the log to where it was written before, so the\ngenerated files no longer depend on where the tree lives, and regenerate the config\nfiles.\n\nWith this, `./mach vendor media/libvpx/moz.yaml -r\nd0bddd329ffea6c5d56b54fa87820b9f6c5db2be --patch-mode check --force` reproduces the\ncommitted tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318080\n", "files": ["media/libvpx/config/generic/vpx_config.c", "media/libvpx/config/linux/arm/vpx_config.c", "media/libvpx/config/linux/arm64/vpx_config.c", "media/libvpx/config/linux/ia32/vpx_config.c", "media/libvpx/config/linux/loongarch64/vpx_config.c", "media/libvpx/config/linux/x64/vpx_config.c", "media/libvpx/config/mac/arm64/vpx_config.c", "media/libvpx/config/mac/ia32/vpx_config.c", "media/libvpx/config/mac/x64/vpx_config.c", "media/libvpx/config/win/aarch64/vpx_config.c", "media/libvpx/config/win/ia32/vpx_config.c", "media/libvpx/config/win/x64/vpx_config.c", "media/libvpx/generate_sources_mozbuild.sh"], "git_node": "4316ee1711ee9c9027ad8f45f2e7e22201a8d13a", "git_parents": ["ebb62c488dd381897ede72706186302b539d7a5f"], "node": "fc725b889a63b2be1882fd9dbfd4b4d8a4e57c93", "parents": ["e077106cb818e68c8424f312145c014ecce1dced"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2059686 - Fix verifyTheTranslatePageSubMenuOptionTest UI test r=jajohnson\n\nThe UI test was flaky because:\n\n  - It checked all parts of the translation sheet in one snapshot with no retry \u2014 but the language dropdowns render a split second late, so the check sometimes ran too early and failed.\n\n  - After clicking Translate, it only waited 25s for the sheet to close \u2014 but a first translation download ran past 25s when the network hiccuped.\n\nTo fix this, I've added two reusable steps in BrowserPage.kt:\n  - verifyTranslationSheetIsDisplayed() \u2014 waits for the last dropdown before checking the sheet\n  - translatePageFromSheet() \u2014 retries the \u201csheet closed\u201d wait a few times so a slow model download has enough time.\n\nThe UI test successfully passed 100x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebease \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318032\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "47a115a37ccb9bb31fefa172d346e44b1624d43e", "git_parents": ["4316ee1711ee9c9027ad8f45f2e7e22201a8d13a"], "node": "a24e277defcd1695a8ddacd12f14fc0db380ff37", "parents": ["fc725b889a63b2be1882fd9dbfd4b4d8a4e57c93"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062856 - Migrate verifyUBlockWorksInPrivateModeTest and noCrashWithAddonInstalledTest UI tests to the efficiency framework r=jajohnson\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318045\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsAddonsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAddonsManagerPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsAddonsManagerSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsAddonsTest.kt"], "git_node": "e72f5d283d0c3dc4a5ff2c25450a15fc508d249e", "git_parents": ["47a115a37ccb9bb31fefa172d346e44b1624d43e"], "node": "fa713fbc1c9208602dd90516262a598ca5184f55", "parents": ["a24e277defcd1695a8ddacd12f14fc0db380ff37"], "tags": []}, {"author": "Chris Vander Linden \u003ccvanderl@uiowa.edu\u003e", "branch": "default", "desc": "Bug 2058383 - Remove unused CloseButton prop from the Debugger FileSearch wrapper. r=bomsy,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314570\n", "files": ["devtools/client/debugger/src/components/Editor/FileSearch.js"], "git_node": "c52a29596e2ccf1d8f0c26ae5a6cc9f513902a97", "git_parents": ["e72f5d283d0c3dc4a5ff2c25450a15fc508d249e"], "node": "da79c34551ec9401a6aae41fd33b855b756b1b60", "parents": ["fa713fbc1c9208602dd90516262a598ca5184f55"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060907 - Move prepareUrlForDisplay from UrlbarUtils to UrlbarShared. r=mbeier\n\nUrlbarResult and UrlbarView both format URLs for display, so both have to stop\nreaching into UrlbarUtils before they can run in a content process.\n\nThe two XPCOM transforms this needs -- the IDN-safe Unicode form of a URL, and\nthe unescaping of percent-encoding -- have no content-realm equivalent: the URL\nparser keeps the host in punycode, and decodeURIComponent skips the spoofing\nfiltering. So they're reached the way UrlbarPrefs already is, via a per-realm\naccessor that calls the services directly when privileged and goes through\nUrlbarChild otherwise. Keeping that in its own module leaves UrlbarShared free\nof `window`, which its header requires. unEscapeURIForUI comes along rather than\nbeing duplicated, since prepareUrlForDisplay ends by calling it.\n\nWorth checking: the display spec now comes from Services.io.newURI instead of\nthe ChromeOnly URL.URI, which is what lets the actor's existing getDisplaySpec\nserve it. Both go through NS_NewURI; I diffed them over IDN, percent-encoded,\nuppercase, IPv6, userinfo and non-special-scheme URLs and they agree\neverywhere. BrowserUIUtils is a system module, so its one-line trailing-slash\nregex is inlined.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317128\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/UrlbarProviderAutofill.sys.mjs", "browser/components/urlbar/UrlbarProviderBookmarkKeywords.sys.mjs", "browser/components/urlbar/UrlbarProviderClipboard.sys.mjs", "browser/components/urlbar/UrlbarProviderHeuristicFallback.sys.mjs", "browser/components/urlbar/UrlbarProviderPlaces.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/UrlbarContentURIUtils.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/jar.mn", "browser/components/urlbar/tests/unit/test_UrlbarShared_unEscapeURIForUI.js", "browser/components/urlbar/tests/unit/test_UrlbarUtils_unEscapeURIForUI.js", "browser/components/urlbar/tests/unit/xpcshell.toml", "tools/@types/generated/tspaths.json"], "git_node": "099404e1b7ad9bb49cacc3a52c17f691e1c226bc", "git_parents": ["c52a29596e2ccf1d8f0c26ae5a6cc9f513902a97"], "node": "2d6472fbcb5954a7a48582051a03d92d51b1d106", "parents": ["da79c34551ec9401a6aae41fd33b855b756b1b60"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062870 - Update android nightly application-services version bump to 5995881c47184145a63b770e7d4bbb1a96d7dbe8 r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318027\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "e1c2109039927c8cfd217cf15ebd2a33accf8a7f", "git_parents": ["099404e1b7ad9bb49cacc3a52c17f691e1c226bc"], "node": "6493bf9f3dbafcd2f288d563e28f2110716fccb9", "parents": ["2d6472fbcb5954a7a48582051a03d92d51b1d106"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062946. Fix the path in expat's 13_high_surrogate_mask.patch. r=hsivonen\n\nThe patch added in bug 2053153 names the file it changes expat/expat/lib/xmltok.c,\nwith expat/ doubled, while the other thirteen expat patches use expat/lib/... . The\npatches are applied with `patch -p1 --directory parser/expat`, so patch could not find\na file at that path, skipped the whole patch and counted its hunk as ignored. The\nchange was in the tree anyway, so nothing looked wrong, but re-vendoring expat dropped\nit and left upstream's mask, and the next update of expat would have done the same.\n\nWith this, `./mach vendor parser/expat/moz.yaml -r R_2_8_2 --patch-mode check --force`\nreproduces the committed tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318092\n", "files": ["parser/expat/13_high_surrogate_mask.patch"], "git_node": "52c45c2701a32f734079ba8f464b577453ed0ceb", "git_parents": ["e1c2109039927c8cfd217cf15ebd2a33accf8a7f"], "node": "be3c20dbc02a773484b85c9150598f3025e41130", "parents": ["6493bf9f3dbafcd2f288d563e28f2110716fccb9"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046646 - Apply high contrast syle to result menu and switcher for Nova r=desktop-theme-reviewers,dao\" for causing bc failures @ browser_parsable_css.js\n\nThis reverts commit d74097bad5260a3b37abe26b028cc9a339f2a80e.\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/themes/shared/urlbar-searchbar.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/windows/browser.css"], "git_node": "e9a2d070d89dce1e7b595ed9390798c46b76ef43", "git_parents": ["52c45c2701a32f734079ba8f464b577453ed0ceb"], "node": "1433b99a74d73e3f03442193a77df761cf83bb9a", "parents": ["be3c20dbc02a773484b85c9150598f3025e41130"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062811 - Use line-height for vertical scroll amount. r=jfkthame,masayuki,layout-reviewers\" for causing multiple failures\n\nThis reverts commit 8de33327c932c3be1c5f4fa1e1681fa6e40f2aae.\n", "files": ["layout/generic/ScrollContainerFrame.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/tests/css/css-overflow/line-scroll-amount-line-height.html"], "git_node": "5c40b2ae52d487afeba939fedf22e868a865de40", "git_parents": ["e9a2d070d89dce1e7b595ed9390798c46b76ef43"], "node": "c5619b38453bb0e3e55459bcd97814d01ac24980", "parents": ["1433b99a74d73e3f03442193a77df761cf83bb9a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061139 - Route input-history writes through the parent controller. r=mbeier\n\nThe Places write only works in the parent, so a \u003cmoz-urlbar\u003e living in a\ncontent process can't record input history for a picked result. Route it over\nthe controller seam like the other parent-only follow-up writes, and let\nswitch-to-tab share the same entry point.\n\nWorth checking: the deferred variant has to register its page-visited observer\nbefore the navigation starts. It still does, because the parent method enters\naddToInputHistoryWhenReady synchronously, and on the message path the\nfire-and-forget command is ordered ahead of the LoadURL query on the same\nactor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317585\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "16c32f6cac3a38ad881abbcf5eb1327248349a8c", "git_parents": ["5c40b2ae52d487afeba939fedf22e868a865de40"], "node": "0fc4c442bcf8cf32a4506fe92d664b8bd209417a", "parents": ["c5619b38453bb0e3e55459bcd97814d01ac24980"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062954. Make fmt's use-double-conversion.patch match what is in the tree. r=padenot\n\nformat_float_gecko is added by use-double-conversion.patch, and the patch declares\n`bool success;` while the copy of format.h committed alongside it in bug 1717448 has\n`bool success = false;`. So the patch has never matched the tree, and re-vendoring fmt\nboth failed to reproduce it and reintroduced an uninitialized bool that the following\nbranches may leave unset.\n\nInitialize it in the patch too.\n\nWith this, `./mach vendor third_party/fmt/moz.yaml -r\n6bdc12a19946794a3c653854def5cf0fc09b49b1 --patch-mode check --force` reproduces the\ncommitted tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318097\n", "files": ["third_party/fmt/use-double-conversion.patch"], "git_node": "a55f60ab0b2eadb77d80da4809cfc0f9b6e2e4cf", "git_parents": ["16c32f6cac3a38ad881abbcf5eb1327248349a8c"], "node": "e10e2f0c00c85d7accbeb481eff07fdb7f3a6eb5", "parents": ["0fc4c442bcf8cf32a4506fe92d664b8bd209417a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062949. Regenerate nsprpub/config/prdepend.h for NSPR_4_40_RTM. r=sylvestre UPGRADE_NSPR_RELEASE\n\nprdepend.py appends the release tag from moz.yaml to config/prdepend.h so that updating\nNSPR forces a rebuild. The update to NSPR_4_40_RTM in bug 2050344 did not re-run it, so\nthe header still records NSPR_4_39_RTM, which is exactly the staleness it exists to\nprevent, and re-vendoring nsprpub did not reproduce the committed tree.\n\nWith this, `./mach vendor nsprpub/moz.yaml -r NSPR_4_40_RTM --patch-mode check --force`\nreproduces the committed tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318093\n", "files": ["nsprpub/config/prdepend.h"], "git_node": "0dbaaf79730454183b34de7b3b7cab97db77d6b1", "git_parents": ["a55f60ab0b2eadb77d80da4809cfc0f9b6e2e4cf"], "node": "766224ed8259bbee8de3cbbdc2e0b316c7db7c56", "parents": ["e10e2f0c00c85d7accbeb481eff07fdb7f3a6eb5"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2061268 - Vendor application-services revision 5995881c. r=urlbar-reviewers,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318010\n", "files": ["Cargo.lock", "browser/components/urlbar/tests/quicksuggest/RemoteSettingsServer.sys.mjs", "docs/rust-components/api/js/autofill.md", "third_party/application-services/automation/build_against_all.py", "third_party/application-services/automation/build_against_fenix.py", "third_party/application-services/automation/build_against_hnt.py", "third_party/application-services/automation/build_against_ios.py", "third_party/application-services/automation/shared.py", "third_party/application-services/automation/smoke-test-fenix.py", "third_party/application-services/automation/smoke-test-fxios.py", "third_party/application-services/build-scripts/component-common.gradle", "third_party/application-services/components/ads-client/android/build.gradle", "third_party/application-services/components/ads-client/src/client.rs", "third_party/application-services/components/ads-client/src/ffi/telemetry.rs", "third_party/application-services/components/ads-client/src/http_cache.rs", "third_party/application-services/components/ads-client/src/http_cache/store.rs", "third_party/application-services/components/ads-client/src/lib.rs", "third_party/application-services/components/ads-client/src/mars.rs", "third_party/application-services/components/ads-client/src/mars/transport.rs", "third_party/application-services/components/ads-client/src/telemetry.rs", "third_party/application-services/components/autofill/android/build.gradle", "third_party/application-services/components/autofill/src/autofill.udl", "third_party/application-services/components/autofill/src/db/addresses.rs", "third_party/application-services/components/autofill/src/db/models/address.rs", "third_party/application-services/components/autofill/src/db/store.rs", "third_party/application-services/components/autofill/src/error.rs", "third_party/application-services/components/autofill/src/lib.rs", "third_party/application-services/components/autofill/src/sync/address/incoming.rs", "third_party/application-services/components/autofill/src/sync/bridge.rs", "third_party/application-services/components/autofill/src/sync/engine.rs", "third_party/application-services/components/autofill/src/sync/mod.rs", "third_party/application-services/components/crashtest/android/build.gradle", "third_party/application-services/components/fxa-client/android/build.gradle", "third_party/application-services/components/fxa-client/build.rs", "third_party/application-services/components/fxa-client/src/account.rs", "third_party/application-services/components/fxa-client/src/auth.rs", "third_party/application-services/components/fxa-client/src/device.rs", "third_party/application-services/components/fxa-client/src/error.rs", "third_party/application-services/components/fxa-client/src/fxa_client.udl", "third_party/application-services/components/fxa-client/src/lib.rs", "third_party/application-services/components/fxa-client/src/profile.rs", "third_party/application-services/components/fxa-client/src/push.rs", "third_party/application-services/components/fxa-client/src/state_machine/display.rs", "third_party/application-services/components/fxa-client/src/state_machine/mod.rs", "third_party/application-services/components/fxa-client/src/state_machine/transitions.rs", "third_party/application-services/components/fxa-client/src/storage.rs", "third_party/application-services/components/fxa-client/src/telemetry.rs", "third_party/application-services/components/fxa-client/src/token.rs", "third_party/application-services/components/init_rust_components/android/build.gradle", "third_party/application-services/components/logins/android/build.gradle", "third_party/application-services/components/merino/android/build.gradle", "third_party/application-services/components/merino/src/curated_recommendations/error.rs", "third_party/application-services/components/merino/src/suggest/error.rs", "third_party/application-services/components/merino/src/worldcup/error.rs", "third_party/application-services/components/nimbus/android/build.gradle", "third_party/application-services/components/nimbus/src/stateful/dbcache.rs", "third_party/application-services/components/places/Cargo.toml", "third_party/application-services/components/places/android/build.gradle", "third_party/application-services/components/push/android/build.gradle", "third_party/application-services/components/push/src/error.rs", "third_party/application-services/components/relay/android/build.gradle", "third_party/application-services/components/relay/src/error.rs", "third_party/application-services/components/remote_settings/android/build.gradle", "third_party/application-services/components/remote_settings/src/client.rs", "third_party/application-services/components/remote_settings/src/config.rs", "third_party/application-services/components/remote_settings/src/error.rs", "third_party/application-services/components/remote_settings/src/schema.rs", "third_party/application-services/components/remote_settings/src/service.rs", "third_party/application-services/components/search/android/build.gradle", "third_party/application-services/components/search/src/selector.rs", "third_party/application-services/components/suggest/android/build.gradle", "third_party/application-services/components/support/error/android/build.gradle", "third_party/application-services/components/support/nimbus-cli/src/output/server.rs", "third_party/application-services/components/support/rc_crypto/Cargo.toml", "third_party/application-services/components/support/rc_crypto/nss/Cargo.toml", "third_party/application-services/components/support/rc_crypto/nss/nss_build_common/Cargo.toml", "third_party/application-services/components/support/rc_crypto/nss/nss_build_common/src/lib.rs", "third_party/application-services/components/support/rc_crypto/nss/nss_sys/Cargo.toml", "third_party/application-services/components/support/rc_crypto/nss/nss_sys/build.rs", "third_party/application-services/components/support/rust-log-forwarder/android/build.gradle", "third_party/application-services/components/support/tracing/android/build.gradle", "third_party/application-services/components/sync15/android/build.gradle", "third_party/application-services/components/sync15/src/engine/sync_engine.rs", "third_party/application-services/components/sync_manager/android/build.gradle", "third_party/application-services/components/sync_manager/src/error.rs", "third_party/application-services/components/sync_manager/src/manager.rs", "third_party/application-services/components/sync_manager/src/syncmanager.udl", "third_party/application-services/components/tabs/android/build.gradle", "third_party/application-services/components/viaduct/Cargo.toml", "third_party/application-services/components/viaduct/android/build.gradle", "third_party/application-services/components/viaduct/src/lib.rs", "third_party/application-services/docs/howtos/locally-published-components-in-firefox-hnt.md", "third_party/application-services/docs/howtos/smoke-testing-app-services.md", "third_party/application-services/megazords/fenix-dylib/megazord_stub.c", "third_party/application-services/megazords/full/Cargo.toml", "third_party/application-services/megazords/full/android/build.gradle", "third_party/application-services/moz.yaml", "third_party/application-services/pub