kmarks.mjs", "browser/components/sidebar/sidebar-history.mjs", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/sidebar-page.mjs", "browser/components/sidebar/sidebar-syncedtabs.mjs", "browser/components/sidebar/sidebar-tab-list.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_keyboard_navigation.js", "browser/components/sidebar/tests/browser/browser_history_keyboard_navigation.js", "testing/mochitest/tests/SimpleTest/AccessibilityUtils.js", "toolkit/content/widgets/moz-card/moz-card.mjs"], "git_node": "a0b234446b4688a8c352f0e7a1dd78c5fc74e01e", "git_parents": ["6257b6c5f2ac674599e1609406cadd888b2557d2"], "node": "e5e4ab08a2c6a8ef1984a40e0eced062045fdf77", "parents": ["30ee6b638c6a45ca3622dabce862c6de04126786"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058235 - Fix browser_ext_management_themes.js default theme name assertion hit when browser.nova.enabled is true. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314438\n", "files": ["toolkit/components/extensions/test/browser/browser.toml", "toolkit/components/extensions/test/browser/browser_ext_management_themes.js"], "git_node": "c9613cee10bb57d6989a07036860ac2c1e22dee2", "git_parents": ["a0b234446b4688a8c352f0e7a1dd78c5fc74e01e"], "node": "1066330870a3885d2bbd2f7d98fc68f7ebedbae4", "parents": ["e5e4ab08a2c6a8ef1984a40e0eced062045fdf77"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057808 - Check format 4 subtable length. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314708\n", "files": ["gfx/thebes/gfxFontUtils.cpp"], "git_node": "f7a73787a92134db5697f2d21f3e3e73d5925dab", "git_parents": ["c9613cee10bb57d6989a07036860ac2c1e22dee2"], "node": "1a2ee78b1899497f83dc947c20e6289d9b933df6", "parents": ["1066330870a3885d2bbd2f7d98fc68f7ebedbae4"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057808 - Zero newly-allocated range. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314709\n", "files": ["gfx/thebes/gfxOTSUtils.h"], "git_node": "67ef6f6c26b3ab3c424d1166bf9971c653167aaa", "git_parents": ["f7a73787a92134db5697f2d21f3e3e73d5925dab"], "node": "3bf6f2cfc7e9e23e58161ff3e0719e1255cfec52", "parents": ["1a2ee78b1899497f83dc947c20e6289d9b933df6"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1788917 - Show the current notification's contents when a doorhanger is replaced while the panel is opening, r=Gijs.\n\nisPanelOpen is also true while the panel is animating open, so _showPanel takes\nthe \"already open\" path and fires \"shown\" for the current notifications right\naway. The popupshown listener registered when the panel started opening was left\nin place, so it later fired \"shown\" a second time for the notifications it had\ncaptured back then, including ones that had since been replaced. Those callbacks\nran last and overwrote the panel contents.\n\nbrowser_doorhanger_form_password_edit.js hits this when a password edit lands\nwhile the doorhanger panel is animating open: the edit replaces the notification,\nand the panel then shows the password from an earlier keystroke.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314475\n", "files": ["browser/base/content/test/popupNotifications/browser.toml", "browser/base/content/test/popupNotifications/browser_popupNotification_replace_while_opening.js", "toolkit/modules/PopupNotifications.sys.mjs"], "git_node": "771590d601cb52b02ba9d8ad5f44a696ba06b52c", "git_parents": ["67ef6f6c26b3ab3c424d1166bf9971c653167aaa"], "node": "5f89d58cb7bdae0f8439588c6b899ca79fb031ee", "parents": ["3bf6f2cfc7e9e23e58161ff3e0719e1255cfec52"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057680 - Fix Add-Container dialog size r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314267\n", "files": ["browser/components/preferences/dialogs/containers.js", "browser/components/preferences/tests/privacy/browser.toml", "browser/components/preferences/tests/privacy/browser_containers_dialog_size.js"], "git_node": "08ff63f4457d4c50bd9bd6dba7648f91ee21c32d", "git_parents": ["771590d601cb52b02ba9d8ad5f44a696ba06b52c"], "node": "bd86aeb7ccd988652c7619f1e1f383e08ae59ba8", "parents": ["5f89d58cb7bdae0f8439588c6b899ca79fb031ee"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2056939 - Restore the NVIDIA block-linear modifier with a reduced block height. r=alwu\n\nOlder NVIDIA drivers may not expose tiled modifiers for multiplanar YCbCr\nimages (ImageFormatProperties2 fails), so negotiation collapses to LINEAR.\nRestore a same-device arch-specific BL fallback for the copy-path export\nbuffers, and disable direct decode export in that case so we do not put\nDRM-modifier tiling on decode images the query already rejected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314220\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.h"], "git_node": "24a742d26012d979c93abdef76c9c944366cf27a", "git_parents": ["08ff63f4457d4c50bd9bd6dba7648f91ee21c32d"], "node": "70a587779c076a1b1d2a405e9e6210c676ebfe2e", "parents": ["bd86aeb7ccd988652c7619f1e1f383e08ae59ba8"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057769 - Don't ignore tabindex if nothing is focusable after selection inside focused content. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314676\n", "files": ["dom/base/nsFocusManager.cpp", "testing/web-platform/tests/html/interaction/focus/sequential-focus-navigation-starting-point.tentative.html"], "git_node": "32b577420288671b40a16e616dd5c43f699762df", "git_parents": ["24a742d26012d979c93abdef76c9c944366cf27a"], "node": "2a9b85facd590c45eb624f59f4c8930c1b262c1e", "parents": ["70a587779c076a1b1d2a405e9e6210c676ebfe2e"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058483 - CPM panel padding should be consistent. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314644\n", "files": ["toolkit/components/satchel/megalist/content/megalist.css"], "git_node": "4b0189a97d0d5562e3dfbc637d7575480819e839", "git_parents": ["32b577420288671b40a16e616dd5c43f699762df"], "node": "b5f4e21a9980462db6cab8a762b1baae32e58512", "parents": ["2a9b85facd590c45eb624f59f4c8930c1b262c1e"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058492 - Replace current CPM search input with moz-input-search. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314651\n", "files": ["toolkit/components/satchel/megalist/content/MegalistAlpha.mjs", "toolkit/components/satchel/megalist/content/megalist.css", "toolkit/components/satchel/megalist/content/tests/browser/browser_passwords_empty.js", "toolkit/components/satchel/megalist/content/tests/browser/browser_passwords_filter.js"], "git_node": "c9804ff01a34b4b8c0ca63057612157b0f5e03fe", "git_parents": ["4b0189a97d0d5562e3dfbc637d7575480819e839"], "node": "f3b7a905332faca3442322f86525babece1a5fbf", "parents": ["b5f4e21a9980462db6cab8a762b1baae32e58512"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058585: Support pseudo-elements becoming a named timeline. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,boris,emilio\n\nTwo simple fixes:\n\n* Scroll container frame lookup should use the pseudo-element, not the\n  originating element.\n* When eager pseudos get created, if the pseudo specifies a named timeline,\n  force a style traversal. We could plumb the sequential task for updating\n  timelines, but this is simpler, even though it causes a mostly-unnecessary\n  style traversal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314757\n", "files": ["dom/animation/ScrollTimeline.cpp", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/scroll-animations/css/scroll-timeline-on-pseudo.html.ini", "testing/web-platform/tests/scroll-animations/css/scroll-timeline-on-pseudo-002.html", "testing/web-platform/tests/scroll-animations/css/view-timeline-pseudo-on-scroller-002.html"], "git_node": "eb82ee7b73197cc04216b50ea5bafae916ae12e3", "git_parents": ["c9804ff01a34b4b8c0ca63057612157b0f5e03fe"], "node": "941c815b1d70002ee1769adb69879d1730d1e350", "parents": ["f3b7a905332faca3442322f86525babece1a5fbf"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057597 - Migrate older code to QM_SCOPED_CONTEXT. r=janv\n\nFollow-up of D314033.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314041\n", "files": ["dom/localstorage/LSSnapshot.cpp", "dom/quota/ActorsParent.cpp"], "git_node": "a928e88ec1df34426074ec090d26fa3bc370efb2", "git_parents": ["eb82ee7b73197cc04216b50ea5bafae916ae12e3"], "node": "6057f94d98f12e29bd6716e12c60dd8a6aa17674", "parents": ["941c815b1d70002ee1769adb69879d1730d1e350"], "tags": []}, {"author": "Manuel Bucher \u003cmanuel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054991 - Fix SEC_ERROR_CA_CERT_INVALID not recoverable in felt privacy r=crypto-reviewers,keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314603\n", "files": ["browser/base/content/test/about/browser_aboutCertError_caInvalid.js", "toolkit/content/errors/cert-errors.mjs", "toolkit/content/tests/browser/browser_