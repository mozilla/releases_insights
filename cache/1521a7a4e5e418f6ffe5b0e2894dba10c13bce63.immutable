oads/indicator.css", "browser/themes/shared/downloads/notification-finish-animation.svg", "browser/themes/shared/downloads/notification-start-animation.svg", "browser/themes/shared/downloads/progress-ring-20.svg", "browser/themes/shared/icons/success-animation.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "fdb1343c1aa1f17db85f26823479308ecc9cc77c", "git_parents": ["71d6fc2eae4fa7962dc5eb94c84e0f8b383137f0"], "node": "135fa4853d964edc505b0961c9a085914320a8a0", "parents": ["27fa5489ca267d4d29da1651fc643f2ad3257e5a"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2057579 - Add a WPT for mixed length-percentage CSSTranslate coordinates; r=emilio,firefox-style-system-reviewers\n\nAdd a WPT for mixed length-percentage CSSTranslate coordinates\n\nAdd a regression test covering construction of a CSSTranslate from CSSMathSum\nvalues containing both a length and a percentage. This verifies that mixed\n\u003clength-percentage\u003e CSSMathValues are accepted for the X and Y coordinates, as\nrequired by the Typed OM specification.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315277\n", "files": ["testing/web-platform/tests/css/css-typed-om/stylevalue-subclasses/cssTranslate.tentative.html"], "git_node": "775d273b6e9e367d031679199c3893c3f982c11e", "git_parents": ["fdb1343c1aa1f17db85f26823479308ecc9cc77c"], "node": "d90e27aeba1d29957a5687e42e2483e0ecd868d4", "parents": ["135fa4853d964edc505b0961c9a085914320a8a0"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054652 - Check resource namespaces during displaylist building. r=gfx-reviewers,lsalzman\" for causing webrender build bustages\n\nThis reverts commit 71d6fc2eae4fa7962dc5eb94c84e0f8b383137f0.\n", "files": ["gfx/layers/wr/AsyncImagePipelineManager.cpp", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/example-compositor/compositor/src/main.rs", "gfx/wr/examples/common/boilerplate.rs", "gfx/wr/examples/document.rs", "gfx/wr/examples/iframe.rs", "gfx/wr/examples/multiwindow.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/wrench/src/rawtest.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "18cf95db888c8ead71ea61655c1fb5a6fbec9ef1", "git_parents": ["775d273b6e9e367d031679199c3893c3f982c11e"], "node": "215a7e00653363334a17bcf7b34d4ef6d0daf4e3", "parents": ["d90e27aeba1d29957a5687e42e2483e0ecd868d4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2025141 - Build the keyframe array by appending instead of prepending. r=boris,firefox-style-system-reviewers\n\nSo that we don't need to relocate keyframes every insert.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315986\n", "files": ["js/src/devtools/rootAnalysis/analyzeHeapWrites.js", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "servo/ports/geckolib/glue.rs"], "git_node": "04c2394b591fab08d2cbb5c0da310d423ee670ec", "git_parents": ["18cf95db888c8ead71ea61655c1fb5a6fbec9ef1"], "node": "d5191d65dbb6b923c1adef424590272ad26c1bf9", "parents": ["215a7e00653363334a17bcf7b34d4ef6d0daf4e3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1679817: Grant HTML user activation on gamepad interaction r=dom-core-reviewers,edgar\n\nIsBackground() only excludes background tabs; it doesn't capture\nwhether the browser window itself has OS focus, which the spec's\n\"top-level traversable with user attention\" condition also requires.\nAdd GetIsActiveBrowserWindow(), matching the same pairing already used\nin nsDeviceSensors.cpp and MediaDevices.cpp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312901\n", "files": ["dom/gamepad/Gamepad.h", "dom/gamepad/GamepadManager.cpp", "dom/gamepad/GamepadManager.h"], "git_node": "ffa32faf1b5cc068f2f257efafda73b9ee14c3f1", "git_parents": ["04c2394b591fab08d2cbb5c0da310d423ee670ec"], "node": "78ea3756574f4911e3f4373f44c713e882ce61a0", "parents": ["d5191d65dbb6b923c1adef424590272ad26c1bf9"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1679817: Add a mochitest for gamepad-triggered user activation r=dom-core-reviewers,edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312902\n", "files": ["dom/tests/mochitest/gamepad/mochitest.toml", "dom/tests/mochitest/gamepad/test_gamepad_user_activation.html", "dom/tests/mochitest/gamepad/test_gamepad_user_activation_iframe.html"], "git_node": "ca037c98aae0fa8265b6c5f2631ef0a4e0f90875", "git_parents": ["ffa32faf1b5cc068f2f257efafda73b9ee14c3f1"], "node": "a1e0f1351a62df3c9303abbdb59d3484164b63cb", "parents": ["78ea3756574f4911e3f4373f44c713e882ce61a0"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 1679817: Add a mochitest for background-tab gamepad activation r=dom-core-reviewers,edgar\n\nVerifies that a gamepad button press does not grant user activation to\na background tab, matching the existing per-tab visibility filtering\nin GamepadManager::Update(). Modeled on\ntest_gamepad_hidden_frame.html's two-tab pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315204\n", "files": ["dom/tests/mochitest/gamepad/mochitest.toml", "dom/tests/mochitest/gamepad/test_gamepad_user_activation_background_tab.html"], "git_node": "7d0e039f4773f933e9cd32823b73423ac9e1d38c", "git_parents": ["ca037c98aae0fa8265b6c5f2631ef0a4e0f90875"], "node": "292f65f66a5b468f1d00b13a9bc88aa6fe731afc", "parents": ["a1e0f1351a62df3c9303abbdb59d3484164b63cb"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059543 - better browser/content container icon mapping r=dveditz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315803\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "browser/components/contextualidentity/jar.mn"], "git_node": "29ff7ec4041dc463975afe84ba6cc910c518ab83", "git_parents": ["7d0e039f4773f933e9cd32823b73423ac9e1d38c"], "node": "1e55a6d3fd4b24911e41ec2e82608544d85f4787", "parents": ["292f65f66a5b468f1d00b13a9bc88aa6fe731afc"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2053200 - Add SpecialPowers.prefEnv r=jgraham\n\nThis allows a new pattern using the new Async Explicit Resource Management, `await using pref = await SpecialPowers.prefEnv`.\n\nThis way tests can have per-subtest prefs more easily, and it's WPT friendly too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314726\n", "files": ["testing/mochitest/tests/Harness_sanity/test_SpecialPowersPushPrefEnv.html", "testing/specialpowers/content/SpecialPowersChild.sys.mjs"], "git_node": "f6e031087d62bf1102747b2c8569bf97904f2ebe", "git_parents": ["29ff7ec4041dc463975afe84ba6cc910c518ab83"], "node": "3b44e9dca9dd00c18f91c154e9d2a299a7099383", "parents": ["1e55a6d3fd4b24911e41ec2e82608544d85f4787"], "tags": []}, {"author": "Artem Popov \u003capopov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054901 - IP-Protection: option to enable GPI auth provider in secret settings r=android-reviewers,jonalmeida,geckoview-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312258\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngine.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/Settings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntimeSettings.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "29086a9681f7468f705a49432e8abee98e1915c4", "git_parents": ["f6e031087d62bf1102747b2c8569bf97904f2ebe"], "node": "b53308655b037e8ec59498fc5c2405d81c841ec9", "parents": ["3b44e9dca9dd00c18f91c154e9d2a299a7099383"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 1960469 - Wait for default browser prompt to actually open in activeNotifications test r=omc-reviewers,yazan\n\nBrowser glue (intentionally) does not await `DefaultBrowserCheck.prompt()`, which\ndoes some async things before the dialog actually opens. The test was using\na visibilitychange listener to evaluate if it should proceed, which was not\nactually tied to if the dialog was present or not. This was causing the\nactiveNotifications check to return false in some instances, since it'd make its\ncheck before the dialog was actually open.\n\nWith this patch, we wait for the dialog box to actually open on the window that\nhas the prompt, and ensure that window is focused, since activeNotifications only\nchecks the top window.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314805\n", "files": ["browser/components/asrouter/tests/browser/browser_asrouter_targeting.js"], "git_node": "39d12b06fa2e6eef2fdda74e4fe40d4225e51631", "git_parents": ["29086a9681f7468f705a49432e8abee98e1915c4"], "node": "2d113e33bcc6dc0a698e13b04b6b1f2cd9585810", "parents": ["b53308655b037e8ec59498fc5c2405d81c841ec9"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059715 - Remove sidebar.revamp.round-content-area pref. r=desktop-theme-reviewers,tabbrowser-reviewers,sfoster,jswinarton.\n\nThis removes the pref and the `-moz-pref()` calls that were using it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315603\n", "files": ["browser/app/profile/firefox.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "3cf610526ae1a48a6d562f60cf3c08ecdc296af7", "git_parents": ["39d12b06fa2e6eef2fdda74e4fe40d4225e51631"], "node": "1f6a9a7bc1a571c2e6a4a6af0dd92386965ecb30", "parents": ["2d113e33bcc6dc0a698e13b04b6b1f2cd9585810"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059697 - Fix dialog border radius when Nova is enabled. r=sfoster,desktop-theme-reviewers,tabbrowser-reviewers,jswinarton.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315604\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "e82d54feb5c2ff065a60862857078db391337e72", "git_parents": ["3cf610526ae1a48a6d562f60cf3c08ecdc296af7"], "node": "0f69a6aa58990fd8714568ee34b78c00a6e97e1d", "parents": ["1f6a9a7bc1a571c2e6a4a6af0dd92386965ecb30"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057994 - Update the waiting-for-key timer handling in MFContentProtectionManager. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314731\n", "files": ["dom/media/ipc/MFMediaEngineParent.cpp", "dom/media/platforms/wmf/MFContentProtectionManager.cpp", "dom/media/platforms/wmf/MFContentProtectionManager.h"], "git_node": "a76e8882d1fdc944d0f69ffbf0c9d77563bbdf2d", "git_parents": ["e82d54feb5c2ff065a60862857078db391337e72"], "node": "bbb4c7ec3e7b7861ffeea627afe667efbeadc30d", "parents": ["0f69a6aa58990fd8714568ee34b78c00a6e97e1d"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057994 - Synchronize access to the content protection manager state. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315688\n", "files": ["dom/media/ipc/MFMediaEngineParent.cpp", "dom/media/platforms/wmf/MFContentProtectionManager.cpp", "dom/media/platforms/wmf/MFContentProtectionManager.h"], "git_node": "cf26ca35c1a4414d78225b395192ef69d43ed995", "git_parents": ["a76e8882d1fdc944d0f69ffbf0c9d77563bbdf2d"], "node": "a3fe9892f9b65834a04df19493138adbca9faa95", "parents": ["bbb4c7ec3e7b7861ffeea627afe667efbeadc30d"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055697 - Base media load-error message redaction on the final loaded resource. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313806\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/mediaelement/HTMLMediaElement.h"], "git_node": "9389b9ac9cef1ecf8ae8f29f9ddf7675a890baed", "git_parents": ["cf26ca35c1a4414d78225b395192ef69d43ed995"], "node": "06b6b2feb0495d60d8924af389bda273ac765908", "parents": ["a3fe9892f9b65834a04df19493138adbca9faa95"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055708 - Remove focus ring and border radius from preonboarding splash r=omc-reviewers,mviar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314754\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "225f7a257a8a620b7c5028b6bd1b58d6a7f13620", "git_parents": ["9389b9ac9cef1ecf8ae8f29f9ddf7675a890baed"], "node": "b01ddab16410c088f975d0b9028f9e236b9d7d14", "parents": ["06b6b2feb0495d60d8924af389bda273ac765908"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058032. r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315759\n", "files": ["gfx/2d/DrawTargetSkia.cpp", "gfx/2d/Factory.cpp", "gfx/2d/NativeFontResourceGDI.cpp", "gfx/2d/NativeFontResourceGDI.h", "gfx/2d/ScaledFontWin.cpp", "gfx/2d/ScaledFontWin.h", "gfx/2d/Types.h", "gfx/2d/UnscaledFontGDI.h", "gfx/2d/moz.build"], "git_node": "52e8917eedfa0a51e61075bc5f5881e6fdb94cea", "git_parents": ["225f7a257a8a620b7c5028b6bd1b58d6a7f13620"], "node": "f22056162a3dbd33dbe256b76dd40b3b51efa803", "parents": ["b01ddab16410c088f975d0b9028f9e236b9d7d14"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060237 - Ensure set_profiler_hooks is called before we create the render backend threads. r=gfx-reviewers,jnicol\" for causing wpt failures.\n\nThis reverts commit 3aec55d8ef649cfb5b70dc3e68bc0c78b446396d.\n", "files": ["gfx/webrender_bindings/src/bindings.rs"], "git_node": "c41c9214f2185f421d02e97340713552a50e081d", "git_parents": ["52e8917eedfa0a51e61075bc5f5881e6fdb94cea"], "node": "487df84e7ed5e51f2a28248465b4bf01a9117cc5", "parents": ["f22056162a3dbd33dbe256b76dd40b3b51efa803"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023143 - Add a11y tests for the new searchbar. r=Standard8\n\nThe new searchbar reuses the urlbar's code, so these mirror the urlbar's\naccessible tree and focus-management tests, restricted to what the searchbar\nactually exposes.\n\nTwo things worth confirming in the tree test: the input container's children\nvary with state (the go button and the result list only show up once there is\na value), and the roles marked with bug 2016839 are the ones that bug will\nchange for both bars at once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314900\n", "files": ["accessible/tests/browser/events/browser.toml", "accessible/tests/browser/events/browser_test_focus_searchbar.js", "accessible/tests/browser/tree/browser.toml", "accessible/tests/browser/tree/browser_searchbar_new.js"], "git_node": "a3d81994ba0c02a0e2a61fd05e6b2babb7f1bcd2", "git_parents": ["c41c9214f2185f421d02e97340713552a50e081d"], "node": "f21341dc59a8b4da7c379665c9f83413af10dab5", "parents": ["487df84e7ed5e51f2a28248465b4bf01a9117cc5"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - fix unbalanced AddRef/Release in SocketProcessParent. r=bwc,necko-reviewers,jesup\n\nBecause SocketProcessParent::DeallocPWebrtcTCPSocketParent is never called,\nthe AddRef in AllocPWebrtcTCPSocketParent was never balanced with a Release.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315667\n", "files": ["dom/media/webrtc/transport/ipc/WebrtcTCPSocketParent.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h"], "git_node": "4385852fd3e15aa242c60fb9496c3b2856992351", "git_parents": ["a3d81994ba0c02a0e2a61fd05e6b2babb7f1bcd2"], "node": "8fc030f3534f2e1a8a60f0af4e7bed643babe367", "parents": ["f21341dc59a8b4da7c379665c9f83413af10dab5"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - add checkRemoteCandidatePorts to test_peerConnection_portRestrictions.html r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313822\n", "files": ["dom/media/webrtc/tests/mochitests/test_peerConnection_portRestrictions.html"], "git_node": "94af811ff8f722fe50bb1a918578abcc9f32ce76", "git_parents": ["4385852fd3e15aa242c60fb9496c3b2856992351"], "node": "5b52b9b9147f6d119018297e4591d3da603199fe", "parents": ["8fc030f3534f2e1a8a60f0af4e7bed643babe367"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Fix stale comment in UDPSocketParent::RecvOutgoingData. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313823\n", "files": ["dom/network/UDPSocketParent.cpp"], "git_node": "276e73ab90542aeb38b06cb2850e2156e6412c5b", "git_parents": ["94af811ff8f722fe50bb1a918578abcc9f32ce76"], "node": "517adf92c198cd9ad84f926ac9c876146bfa0d1f", "parents": ["5b52b9b9147f6d119018297e4591d3da603199fe"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Expose the webrtc port allowlist as a shared IsWebrtcPortAllowed helper. r=bwc\n\nTurn the gGoodWebrtcPortList allowlist into IceServerParser::kGoodWebrtcPortList\nand make the file-local IsPortAllowed check to a public mozilla::IsWebrtcPortAllowed\nhelper, so the outgoing port restriction can be reused outside of ICE server URL\nparsing. No behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313824\n", "files": ["dom/media/webrtc/common/IceServerParser.cpp", "dom/media/webrtc/common/IceServerParser.h"], "git_node": "7c118142911eea409c6439644259bf1ee4beb8d7", "git_parents": ["276e73ab90542aeb38b06cb2850e2156e6412c5b"], "node": "dbaf45b5bcb4e2a287b9e217f29d71b533d4ad10", "parents": ["517adf92c198cd9ad84f926ac9c876146bfa0d1f"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Apply outgoing port restrictions to remote ICE candidate destinations in NrSocket. r=bwc\n\nNrSocket (used for direct UDP/TCP sockets in the socket process and parent\nprocess) now rejects sends/connects to ports that are not allowed for webrtc,\nvia NrSocketBase::IsForbiddenAddress.  This blocks remote ICE candidates that\npoint at restricted destination ports in parent or socket process, the same\nway Bug 1677046 closed for them for ICE server URLs.  IsForbiddenAddress also\ngains the webrtc port allowlist so 53/3478/5349 stay usable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313825\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp", "dom/media/webrtc/transport/nr_socket_prsock.h", "dom/media/webrtc/transport/test/test_nr_socket_unittest.cpp"], "git_node": "54c979b1e91dbb8e48dfe6f8566cc12b565e9606", "git_parents": ["7c118142911eea409c6439644259bf1ee4beb8d7"], "node": "11a34d7d4e38e886ff2a589501280de4737f61b0", "parents": ["dbaf45b5bcb4e2a287b9e217f29d71b533d4ad10"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Enforce the webrtc outgoing port restriction in the parent process for content-process UDP. r=bwc\n\nWhen mtransport runs in the content process, UDP is sent via NrUdpSocketIpc to\nUDPSocketParent in the parent process. Drop outgoing packets destined for a\nrestricted port there, so the restriction is enforced in a process the content\nprocess cannot bypass. A disallowed port is dropped silently (IPC_OK) rather\nthan treated as a protocol violation, since it can come from a remote candidate\nsupplied through the normal API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313826\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp", "dom/media/webrtc/transport/stun_socket_filter.cpp"], "git_node": "7018d2b57f7111b2b44c16bc88947d986ec5ef45", "git_parents": ["54c979b1e91dbb8e48dfe6f8566cc12b565e9606"], "node": "eb6029a401f9f0c858023be483cc917878465ad7", "parents": ["11a34d7d4e38e886ff2a589501280de4737f61b0"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Enforce the webrtc outgoing port restriction in the parent process for ICE-TCP. r=bwc\n\nICE-TCP connections are opened via WebrtcTCPSocketParent::RecvAsyncOpen (in the\nsocket or parent process). Reject opens to a restricted destination port there,\nsignalling a normal connection failure to the child via OnClose rather than\ntearing down the process with IPC_FAIL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313827\n", "files": ["dom/media/webrtc/transport/ipc/WebrtcTCPSocketParent.cpp"], "git_node": "e42e498367b5b647611a514b53ef4353890c52d7", "git_parents": ["7018d2b57f7111b2b44c16bc88947d986ec5ef45"], "node": "7527969f1469c7e1d295acf95146704a651f2d8d", "parents": ["eb6029a401f9f0c858023be483cc917878465ad7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2038465 - Add Web Audio mochitest for FLAC with varying per-frame channel count r=karlt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300184\n", "files": ["dom/media/webaudio/test/bug2038465_varying_channels.flac", "dom/media/webaudio/test/mochitest.toml", "dom/media/webaudio/test/test_bug2038465.html"], "git_node": "a3506531f0448b58ad33802e43e121f12c7fb6b6", "git_parents": ["e42e498367b5b647611a514b53ef4353890c52d7"], "node": "327a7be3b29b9b73d8bba35f64abff25c4e66601", "parents": ["7527969f1469c7e1d295acf95146704a651f2d8d"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\naf -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nan -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nar -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nast -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\naz -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nbe -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nbg -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nbn -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nbo -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nbqi -\u003e 5496e87fba5d59d084310cdb8dbf26e0338358fe\nbr -\u003e 5496e87fba5d59d084310cdb8