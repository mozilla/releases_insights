sets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 5ea6f25c57d411c3dea06f0405775b4066302e09 with FIREFOX-ANDROID_153_0_3_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "38b512743f5593b5958912ae7413757ef6992c00", "git_parents": ["4c8e828efefb34259e2489b2991e7b3fb657971b"], "node": "66feaee2b275e7f3d9349ca41bacd439473c023d", "parents": ["8805dae5325a3278b80fa3952813913679c2b099"], "tags": []}], "date": 1785772615, "git_changesets": ["38b512743f5593b5958912ae7413757ef6992c00"], "user": "ffxbld@lando.moz.tools"}, "45019": {"changesets": [{"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057501 - [WebCompat Reporter v3] 'Send report' button should not be above the keyboard. r=android-reviewers,calu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313999\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporter.kt"], "git_node": "1b97510663d382f186effcede7df1987cd8f7f89", "git_parents": ["1fab04c3f9fe8d72b22d697bcdb501fd2ccebba9"], "node": "dd13b3d853918918a9b788052533248393f1deae", "parents": ["38fabd2e22ca6f3332f7260d5f50ed7cb8ecf9fe"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058887 - don't draw a failed snapshot into the tab preview thumbnail canvas r=tabbrowser-reviewers,niklas\n\nbrowser-custom-element's drawSnapshot() returns false when the browser's\nwindow global goes away mid-capture. captureTabPreviewThumbnail passed that\nstraight to drawImage(), which threw:\n\n  TypeError: CanvasRenderingContext2D.drawImage: Argument 1 could not be\n  converted to any of: HTMLImageElement, [...]\n\nThis is reachable by closing a tab whose thumbnail capture is still pending:\npermitUnload() spins a nested event loop for the beforeunload prompt, letting\nthe capture resume after the tab is on its way out. The error was caught and\nlogged by tab-hover-preview, so it was console noise rather than a functional\nbreak.\n\nReturn whether a thumbnail was actually drawn, and bail out on both teardown\npaths: a currentWindowGlobal that is already gone before getActor(), and a\nfalsy drawSnapshot() result afterwards. The caller now checks that value so an\nearly return does not leave a blank canvas as the preview.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314985\n", "files": ["browser/components/tabbrowser/content/tab-hover-preview.mjs", "toolkit/components/thumbnails/PageThumbs.sys.mjs"], "git_node": "bc52ff953a17e764ceebced6d3650a7a0d652a79", "git_parents": ["1b97510663d382f186effcede7df1987cd8f7f89"], "node": "1316e5718f9a7b6998d15bccbef106c20ddd7450", "parents": ["dd13b3d853918918a9b788052533248393f1deae"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\naf -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nan -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nar -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nast -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\naz -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nbe -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nbg -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nbn -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nbo -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nbqi -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nbr -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nbrx -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nbs -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nca -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nca-valencia -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\ncak -\u003e c0ad2a93aeeaeb74549d62429d16281454b63370\nckb -\u003e c0ad2a93aeeaeb74549d62429