 height mismatches. r=nchevobbe,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314566\n", "files": ["devtools/client/shared/widgets/TableWidget.js"], "git_node": "65b309b283813f5d73a8dcb3a8b176f1751c809d", "git_parents": ["11e2354ac0d7b769cb01d5f229ed7c4707d17812"], "node": "44f56a7744f262950379850f03a27b76a58e99ff", "parents": ["8aca4a78a39768840d2510737b190dd403792f0e"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042994 - Parse and serialize -webkit-line-clamp as a legacy shorthand for line-clamp. r=dshin,firefox-style-system-reviewers,emilio\n\nThis also adds special handling for the case where modern line-clamp property\nis pref disabled, but we still want the legacy -webkit-line-clamp to work\nwithout exposing disabled line-clamp. Removed -webkit-line-clamp longhand.\n\nUpdate property database and style tests so -webkit-line-clamp is\nrepresented as a legacy shorthand instead of as a longhand. Teach test\nhelpers to skip disabled subproperties when handling shorthands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312529\n", "files": ["devtools/server/actors/animation-type-longhand.js", "layout/style/nsStyleStruct.cpp", "layout/style/test/property_database.js", "layout/style/test/test_all_shorthand.html", "layout/style/test/test_ch_ex_no_infloops.html", "layout/style/test/test_inherit_computation.html", "layout/style/test/test_inherit_storage.html", "layout/style/test/test_initial_computation.html", "layout/style/test/test_initial_storage.html", "layout/style/test/test_property_database.html", "layout/style/test/test_transitions_per_property.html", "layout/style/test/test_value_computation.html", "layout/style/test/test_value_storage.html", "servo/components/style/properties/data.py", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/style_adjuster.rs", "servo/components/style/values/generics/box.rs", "servo/components/style/values/specified/box.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-019.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-034.html.ini"], "git_node": "ccb424375c83932573a2cb9849ae8b4b09b08633", "git_parents": ["65b309b283813f5d73a8dcb3a8b176f1751c809d"], "node": "3096b396221fe4dc48663bb6ae83716bfcf2d346", "parents": ["44f56a7744f262950379850f03a27b76a58e99ff"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057941: set LD_LIBRARY_PATH to the updater directory r=releng-reviewers,jcristau\n\nVery old versions of Firefox do not have [RPATH](https://en.wikipedia.org/wiki/Rpath) set when linking, which means they're unable to find the necessary libraries sitting right next to them. This means that when post-watershed update integrity tests run, they fail if they're testing very old versions of Firefox still.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314292\n", "files": ["tools/update-verify/marannon/src/test.rs"], "git_node": "cb8a165e91cbf0788c6a89ea680481d03d139847", "git_parents": ["ccb424375c83932573a2cb9849ae8b4b09b08633"], "node": "55e64a925cbc047c0ac9b1c76e6a64c0e618f5b5", "parents": ["3096b396221fe4dc48663bb6ae83716bfcf2d346"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057941: add nightly to list of channels that ignore comment changes in channel-prefs.js r=releng-reviewers,jcristau\n\nThere's some comment changes that crept into this file that need to be ignored for post-watershed tests to pass. (On Nightly, the post-watershed version is from all the way back in 2017...)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314293\n", "files": ["tools/update-verify/release/compare-directories.py"], "git_node": "65907bca93bebafaab9d588611d626bcf944a7d0", "git_parents": ["cb8a165e91cbf0788c6a89ea680481d03d139847"], "node": "e58a4f799578beab2b51f5a9b188ac9b88487d57", "parents": ["55e64a925cbc047c0ac9b1c76e6a64c0e618f5b5"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055914 - Don't fetch the sync oauth token until sync r=android-reviewers,markh,bdk,jonalmeida\n\nWe previously used to pre-emptively request sync access token and cache it as soon as an account was connected. Now that FxA can be used without any intention to sync, we want to avoid provisioning sync auth info until a sync is actually about to run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313274\n", "files": ["mobile/android/android-components/components/browser/storage-sync/src/main/java/mozilla/components/browser/storage/sync/Types.kt", "mobile/android/android-components/components/concept/sync/src/main/java/mozilla/components/concept/sync/Sync.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/Exceptions.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/SyncAuthInfoCache.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/Types.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/FxaAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/manager/GlobalAccountManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/SyncManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/Types.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/FxaAccountManagerTest.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/SyncAuthInfoCacheTest.kt"], "git_node": "7a0211df858ff28588b05aa1a724b6f4bdc9d769", "git_parents": ["65907bca93bebafaab9d588611d626bcf944a7d0"], "node": "64d828a03fad999f6d8d32a59fb7dee84b04c50d", "parents": ["e58a4f799578beab2b51f5a9b188ac9b88487d57"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057662 - Don't fire characterboundsupdate for querying mFirstCharRect. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314452\n", "files": ["dom/events/ContentEventHandler.cpp", "dom/html/EditContext.cpp", "dom/html/EditContext.h", "editor/libeditor/tests/edit-context/mochitest.toml", "editor/libeditor/tests/edit-context/test_editcontext_characterboundsupdate_range.html", "widget/ContentCache.cpp", "widget/ContentCache.h", "widget/TextEvents.h"], "git_node": "e1ac0b6fad53cc547da0c92b340852d7bd63d413", "git_parents": ["7a0211df858ff28588b05aa1a724b6f4bdc9d769"], "node": "c8d456c027c7476e9242b27c391bebfac4a474ab", "parents": ["64d828a03fad999f6d8d32a59fb7dee84b04c50d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058423 - Remove PlacesUtils.sys.mjs import from UrlbarShared.mjs. r=mbeier\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314597\n", "files": ["browser/components/urlbar/content/UrlbarShared.mjs"], "git_node": "9726f9a7de717f196d4a4d69e28844f2d2d21703", "git_parents