odule.js", "js/src/jit-test/tests/parser/bug-1263355-16.js", "js/src/jit-test/tests/parser/bug-1263355-23.js", "js/src/jit-test/tests/parser/bug-1263355-48.js", "js/src/jit-test/tests/parser/compile-script.js", "js/src/jit-test/tests/parser/stencil-eager-delazify-certviewer.js", "js/src/jit-test/tests/xdr/module-exports.js", "js/src/jit-test/tests/xdr/module-imports.js", "js/src/tests/shell/script-file-name-utf8.js"], "git_node": "3f33667d1110049439381c7b8c8b49796da556c0", "git_parents": ["1b9574aea50a43711090ae87307093358227b684"], "node": "23fa75ae65a3e42b5037bb4f14f2d6f8bd86de49", "parents": ["7ef6b272d06e373b00c594dfd4e8313e9baa3bdf"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2060925: Move the aDefaultAnchorValid check earlier in GetAutoResolutionOverrideParams. r=layout-reviewers,firefox-style-system-reviewers,dshin\n\nIf aDefaultAnchorValid is false, this lets us bail out slightly earlier, and it\napparently gives us a small but measurable perf improvement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316578\n", "files": ["layout/style/nsStyleStruct.cpp"], "git_node": "7e13dea1e55d4cc44c05f23c892511e02e2bcb1c", "git_parents": ["3f33667d1110049439381c7b8c8b49796da556c0"], "node": "46c8081426b0534e2f84a0dc79ff264a56990291", "parents": ["23fa75ae65a3e42b5037bb4f14f2d6f8bd86de49"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2059578: Use smaller-than-default block-axis padding for findbar textfield, to avoid overflow. r=desktop-theme-reviewers,hjones\n\nIn frontend code, with Nova enabled, our default vertical padding on a textfield\nis 0.5rem (on the top and the bottom).  That's is between 5-8px added to the top\nand bottom, depending on platform. That's pretty large and can cause the\ntextfield to overflow the findbar on Ubuntu.\n\nWith nova disabled, we instead use 2px of vertical padding on this findbar\ntextfield (from the `padding` decl in the pref-guarded CSS below the spot that\nthis patch is touching).\n\nSo: for the nova-enabled case, let's use a smaller amount of padding, with the\n--space-xsmall design token (0.25rem).  This is still larger than the 2px that\nwe were using pre-nova, and it's small enough to avoid overflow on Ubuntu.\nAnd this should have virtually no visible change on Windows or macOS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315713\n", "files": ["toolkit/themes/shared/findbar.css"], "git_node": "28dd3e11542628eff173833d8d8f2f933d02cd55", "git_parents": ["7e13dea1e55d4cc44c05f23c892511e02e2bcb1c"], "node": "c47a67c8b3b7bf06a1bb741147d241999cfd4e33", "parents": ["46c8081426b0534e2f84a0dc79ff264a56990291"], "tags": []}, {"author": "Serah Nderi \u003csarahngima77@gmail.com\u003e", "branch": "default", "desc": "Bug 2057463 - Legacy features must be enabled in optimized path; r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316242\n", "files": ["js/src/shell/js.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "c0db43ec555c1ec2d88e79d3b9da9cdb70b1c8cc", "git_parents": ["28dd3e11542628eff173833d8d8f2f933d02cd55"], "node": "3a68ee49ef1beeb78e6419bca85aede0afc16f03", "parents": ["c47a67c8b3b7bf06a1bb741147d241999cfd4e33"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054954 - Add timeline to media notification. r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312064\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/ext/MediaSessionState.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/service/MediaSessionServiceDelegate.kt", "mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/session/MediaSessionCallback.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/ext/MediaSessionStateKtTest.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/service/MediaSessionServiceDelegateTest.kt"], "git_node": "41c5227db0ba0ccbbd34e6edad6d3a13a21b6cc1", "git_parents": ["c0db43ec555c1ec2d88e79d3b9da9cdb70b1c8cc"], "node": "f1ebc1d34465a4def2ac2089d3246eb063da4cc3", "parents": ["3a68ee49ef1beeb78e6419bca85aede0afc16f03"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2057860 - adjust macOS skip rule for browser/components/tabbrowser/test/browser/dragdrop/browser.toml because failure is not caused by Nova design. r=sthompson,tabbrowser-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316587\n", "files": ["browser/components/tabbrowser/test/browser/dragdrop/browser.toml"], "git_node": "010a3163afa50c53fd4a78bd33d354ada2a4fe41", "git_parents": ["41c5227db0ba0ccbbd34e6edad6d3a13a21b6cc1"], "node": "65181263e885753fd2a6dfc2c1a0c2d712e5704a", "parents": ["f1ebc1d34465a4def2ac2089d3246eb063da4cc3"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053889 - Part 1: Add a single row overflow handler r=czhou\n\nRows are width-aware by default. They measure themselves and show the items\nthat fit. Overflowing items are shown behind a \"+n more\" button. Setting a\nfixed item count overrides the width-aware behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314738\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-overflow-row/SmartwindowOverflowRow.mjs", "browser/components/aiwindow/ui/components/smartwindow-overflow-row/smartwindow-overflow-row.css", "browser/components/aiwindow/ui/jar.mn"], "git_node": "95f14d5c50235bbcbc85bee6155ebf541472b1f1", "git_parents"