87ef030b0893ef8cdfde82a9fb14fd01ff2180", "01c77017036cb96d3e50d03b0aa35e58faecc96f", "800cb02b9ff01fa051828fc7bfed8e77924d9d31", "34f3c148b34ca6e079515c100af91d88cde63c16", "4e3da5d1d644c7ff265e0a031188c7cfc7eb9aeb", "9f1c2c20273fe14f4a4fdd4e0fea3ddc973b3691", "a5d102b60f5eb61056d834524f2a49c38e4f632c", "ac83466f050d687e82c428853c26796cb14bbe86", "6c8b2ded193b9259f5b3b5c32456d77e971d8c47", "b11e5370a34d60af7dd64e8d40b94ba9c42ad73e", "d3691c1f149f351ba28a2b015fd7dd25ab209b1c", "4225b4048e5cd9b5f7434044e7d9ebd173c0d41d", "c615021d596315662005f5b83ce9c8fb4a22d225", "15f29ddf7647febc65ff5d7f2232196a4ff40983", "fd4104f8e0bd1b5822777a9a2152c30734f0e51e", "b8cae7088e7252ef83ab8358432f48ac4a55aa98", "6b71b64ca07b8a1326778558f4f13d61c20e6f8f", "9f77c02430cc0a14d6a29f24347ebdb74efe1df7", "6ea98f2b85c64987a2a86ef0d8e7f1df9856c5b1", "789ce894df7ca957aa12b43fb922667b1f8b1d15", "71e2267c243c4a2fa62ab03390a2ab4fdee49ac6", "e2a4ae425b310a9415360e768daf18ebb21965de", "8d4f297e7481f71d5b3fad7fb84aa8e2f600b4c6"], "user": "pstanciu@mozilla.com"}, "45073": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045444 - Handle allocation failure in wasm Ion store helpers r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313782\n", "files": ["js/src/jit-test/tests/wasm/oom/bug2045444.js", "js/src/wasm/WasmIonCompile.cpp"], "git_node": "2c98b7f421775219eb16755849cb0b351117eed1", "git_parents": ["8d4f297e7481f71d5b3fad7fb84aa8e2f600b4c6"], "node": "ec80d001adc1e92f61de593e256ca857ab0d38c8", "parents": ["3423c34c6221f32067b9117d2c90a5a6d4222c25"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045440 - Decode wasm init expressions under compile-time features r=rhunt\n\nInitExprInterpreter re-decodes validated constant-expression bytecode at\ninstantiation time, but rebuilt its FeatureArgs from the current context via\nFeatureArgs::build(cx, FeatureOptions()) rather than the features the module\nwas validated with. These can differ -- a feature pref may have flipped since\ncompile, and the default FeatureOptions() drops the module's compile-time\noptions -- so re-decoding a feature-gated heap type (e.g. ref.null cont) fails,\ntripping the !error asserts in the interpreter. Reuse the module's compile-time\nFeatureArgs from codeMeta().features() instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313890\n", "files": ["js/src/wasm/WasmInitExpr.cpp"], "git_node": "2934e93b5729422f5019888123d0c8ef6b5a5793", "git_parents": ["2c98b7f421775219eb16755849cb0b351117eed1"], "node": "cfc0c1c58c1fc5170f998102acd2ef36b9b16f97", "parents": ["ec80d001adc1e92f61de593e256ca857ab0d38c8"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059109 - Keep try_table block params off the value stack while emitting the baseline landing pad. r=rhunt\n\nemitTryTable left the try block's params on the value stack while emitting the\nlanding pad; remove them across pad emission and restore them for the try body,\nmatching endTryCatch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315721\n", "files": ["js/src/wasm/WasmBaselineCompile.cpp"], "git_node": "dafdb11cabe80a81ff743207d702fd95bf203153", "git_parents": ["2934e93b5729422f5019888123d0c8ef6b5a5793"], "node": "ef565105d6560667a1aa82a6b3a40dfc42285996", "parents": ["cfc0c1c58c1fc5170f998102acd2ef36b9b16f97"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2059632 - Move SCCACHE_MAX_FRAME_LENGTH out of mozconfig.cache. r=firefox-build-system-reviewers,ahochheiden\n\nIn some cases, IPC messages between the sccache client and sccache\nserver are too large for the default frame length, and we had a work\naround for some of those cases that happened in CI some time ago.\n\nTurning on the sccache client-side mode makes this IPC default frame\nlength problem worse, preventing the caching of many rust crate build\noutput.  So at least until sccache is improved to handle the situation\nmore smoothly, we're going to need to increase the frame length.\n\nThe previous workaround only applied to automation, where\nmozconfig.cache is used. We however now need to apply it more globally,\nsetting the variable from configure whenever sccache is in use instead,\nalongside the other sccache variables, which also gets it in the\nenvironment of whatever starts the sccache daemon: configure's own\ncompiler checks, make, or client.mk.\n\nThis only moves the setting, without changing the value just yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316436\n", "files": ["build/moz.configure/toolchain.configure", "build/mozconfig.cache", "config/config.mk", "python/mozbuild/mozbuild/controller/building.py"], "git_node": "f2685d7dd2c02201b5443812baf458bddbff9451", "git_parents": ["dafdb11cabe80a81ff743207d702fd95bf203153"], "node": "1d0f2a0aa068bba60a475b5249f5d4d5c35c05ef", "parents": ["ef565105d6560667a1aa82a6b3a40dfc42285996"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2059632 - Enable sccache client side mode. r=firefox-build-system-reviewers,ahochheiden\n\nAlso increase the sccache max frame length to work around caching issues\nwith large build outputs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316437\n", "files": ["build/moz.configure/toolchain.configure", "config/config.mk"], "git_node": "57502d5cd4370f9a82b27aa736dfa1dea6fc48f2", "git_parents": ["f2685d7dd2c02201b5443812baf458bddbff9451"], "node": "7d21bc08216abecd01e4f82414edd1861f118c7b", "parents": ["1d0f2a0aa068bba60a475b5249f5d4d5c35c05ef"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050521: Handle unavailable stream in IDB ProcessStream. r=dom-storage-reviewers,hsingh\n\nUnblocks calling FileMetadataCallback on close (bug 1737783).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312720\n", "files": ["dom/indexedDB/ActorsChild.cpp"], "git_node": "7201baaf6dfa29a7f75f0e2f6a982adfc6c384a8", "git_parents": ["57502d5cd4370f9a82b27aa736dfa1dea6fc48f2"], "node": "d2b1ec5d9d902ebebf5ac0bc6948ef4112de424a", "parents": ["7d21bc08216abecd01e4f82414edd1861f118c7b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053503 - Log a 'checking' line for toolchain bootstrapping during configure r=firefox-build-system-reviewers,glandium,sylvestre\n\nRight now there's no indication this ever happens, unless there's a failure.\nSince it's one of the longer running tasks during configure, I think it makes\nsense for it to have its own line in the log.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311366\n", "files": ["build/moz.configure/bootstrap.configure"], "git_node": "50691777d300fffc7d1f7844b59769109bc76f3e", "git_parents": ["7201baaf6dfa29a7f75f0e2f6a982adfc6c384a8"], "node": "da427064065323c932017db628a8b300c15c8d9c", "parents": ["d2b1ec5d9d902ebebf5ac0bc6948ef4112de424a"], "tags": []}], "date": 1786527419, "git_changesets": ["2c98b7f421775219eb16755849cb0b351117eed1", "2934e93b5729422f5019888123d0c8ef6b5a5793", "dafdb11cabe80a81ff743207d702fd95bf203153", "f2685d7dd2c02201b5443812baf458bddbff9451", "57502d5cd4370f9a82b27aa736dfa1dea6fc48f2", "7201baaf6dfa29a7f75f0e2f6a982adfc6c384a8", "50691777d300fffc7d1f7844b59769109bc76f3e"], "user": "nfay@mozilla.com"}, "45074": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 1d78fecadb05f7a244f966728e5228681708c72c with DEVEDITION_154_0b10_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "18e81b45107331f924668167d2ba7e428b6fc289", "git_parents": ["949294dd653999b876f1ca77531e88e46ba0c723"], "node"