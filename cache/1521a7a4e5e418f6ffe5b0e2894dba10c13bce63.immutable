828edc354ecd4f9a3e004\nsk -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nsl -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nson -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nsq -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nsr -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nsv-SE -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nta -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nte -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nth -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\ntl -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\ntr -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\ntrs -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nuk -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nur -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nuz -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nvi -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nwo -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nxh -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nzam -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nzh-CN -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\nzh-TW -\u003e 442c58eb81a8c4eadaa828edc354ecd4f9a3e004\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "4ddba77ad068bd4b5b94c550545ba566cbbdba66", "git_parents": ["fa8a0fa85767bbc9362c5d8f77fa8f5ace76a498"], "node": "2f3961f9397bd45787a82fe3d706d32a57c8d5ce", "parents": ["7625b3f5e61ca04cc9a88536b6b2962f3344425d"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057009 - The shield should not start off with the check mark as default regardless if trackers are found or not. r=urlbar-reviewers,desktop-theme-reviewers,dao,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313607\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/browser.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_pages.js", "browser/themes/shared/identity-block/identity-block.css"], "git_node": "c755323a8ae7db4eaeab33631f3e3202c1891a78", "git_parents": ["4ddba77ad068bd4b5b94c550545ba566cbbdba66"], "node": "7d0c355f633c5df3a2f0b7a6376c8bbbef47aed2", "parents": ["2f3961f9397bd45787a82fe3d706d32a57c8d5ce"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052180 - Convert `selected` to a standard boolean attribute for the remaining XUL select-control widgets. r=desktop-theme-reviewers,mkennedy,hjones\n\nFollow-up to bug 1849907, which did this for tabbox `\u003ctab\u003e` and taught the a11y\nengine to classify XUL `selected` changes by attribute presence. This brings\nrichlistitem, radio and menulist selection in line: selecting now writes\n`selected=\"\"` rather than `selected=\"true\"`.\n\nBehavior is unchanged provided every consumer tests for presence rather than\nthe value \"true\", which is what's worth checking here:\n\n- The theme richlistbox rules move from `[selected=\"true\"]` to `[selected]`;\n  markup still spelling out `selected=\"true\"` keeps matching either way.\n- The handlers view in Settings looked up the selected action with an\n  (unquoted) `[selected=true]` selector, so it silently stopped finding one and\n  left the action label blank. The `querySelector` scope is the row's\n  descendants, so relaxing it to `[selected]` can't pick up the row's own\n  selection state.\n- menulist's initial selection scan needs the `\"*\"` wildcard so it also finds\n  items selected programmatically before the popup is (re-)initialized.\n- The C++ side -- XULButtonElement's checked state and the a11y selection\n  events -- already keys off attribute presence.\n\nThe `listitem` widget named in the bug no longer exists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314562\n", "files": ["browser/components/preferences/main.js", "toolkit/content/tests/chrome/test_menulist_initial_selection.xhtml", "toolkit/content/tests/chrome/test_menulist_initial_selection_with_connected_callback.xhtml", "toolkit/content/widgets/autocomplete-richlistitem.js", "toolkit/content/widgets/menulist.js", "toolkit/content/widgets/radio.js", "toolkit/content/widgets/richlistbox.js", "toolkit/themes/linux/global/richlistbox.css", "toolkit/themes/osx/global/richlistbox.css", "toolkit/themes/windows/global/richlistbox.css"], "git_node": "c5148bd88240f06a70add90b3583f209dab33725", "git_parents": ["c755323a8ae7db4eaeab33631f3e3202c1891a78"], "node": "aa6cc20d73c5d6d10208340d9379178e464230f2", "parents": ["7d0c355f633c5df3a2f0b7a6376c8bbbef47aed2"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 1: Add tests for push subscribes r=asuth\n\nThis mostly copies the same tests from notifications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315057\n", "files": ["testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini", "testing/web-platform/meta/push-api/worker-subscribe.https.window.js.ini", "testing/web-platform/tests/push-api/cross-origin-nested.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-same-site-request.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-serviceworker.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/resources/cross-origin-nested-child.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-nested-parent.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-serviceworker-iframe.sub.html", "testing/web-platform/tests/push-api/resources/permission-helper.js", "testing/web-platform/tests/push-api/resources/permission-sw.js", "testing/web-platform/tests/push-api/resources/permission-worker.js", "testing/web-platform/tests/push-api/worker-subscribe.https.window.js"], "git_node": "36da4bcf80727fbf0791d788ca5a4ae2d7d6d697", "git_parents": ["c5148bd88240f06a70add90b3583f209dab33725"], "node": "10711e9514a0f500dd086775ec52940d977d0a81", "parents": ["aa6cc20d73c5d6d10208340d9379178e464230f2"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 2: Disallow retrieving push subscription in partitioned worker r=asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315058\n", "files": ["dom/push/PushManager.cpp", "testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini"], "git_node": "64633df4508e639b633c77c6fa1739ce017194e8", "git_parents": ["36da4bcf80727fbf0791d788ca5a4ae2d7d6d697"], "node": "a3c66f687e0f496a666b897d0ef14e6603886e90", "parents": ["10711e9514a0f500dd086775ec52940d977d0a81"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2059053: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/push/PushManager.cpp"], "git_node": "6481f0f4f8cc98c8ef305c17b6bab2f7c4161f04", "git_parents": ["64633df4508e639b633c77c6fa1739ce017194e8"], "node": "c2ee85d8bcb493525f32d5fc8add2d5a8bcf7e41", "parents": ["a3c66f687e0f496a666b897d0ef14e6603886e90"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2059035 - Restore the non-positive guard on the GTK screen resolution. r=emilio\n\ngdk_screen_get_resolution() returns -1 when no resolution has been set,\nand GetGtkTextScaleFactor() handed that on as a scale factor. It reaches\nsystem font sizes both directly in GetSystemFontInfo() and via\nmTextScaleFactor in PerThemeData::GetFont(), and a negative font size\ndraws no glyphs, so all chrome text goes invisible.\n\nThis used to be guarded in gfxPlatformGtk::GetFontScaleDPI(); bug 1967147\nmoved the computation into nsLookAndFeel without carrying the guard over,\nso it's a regression from 140. esr140 is affected, esr128 is not.\n\nReachable on any session that gives GTK no DPI to read, e.g. KDE Plasma\non Wayland with no xsettingsd and no GNOME GSettings schemas. X11 is\nimmune because gdk/x11/gdkxftdefaults.c defaults to 96.0 and gdk/wayland\nhas no equivalent fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315116\n", "files": ["widget/gtk/nsLookAndFeel.cpp"], "git_node": "d2ae75b7d92cb5cca1b928d4ac17d066d5089f87", "git_parents": ["6481f0f4f8cc98c8ef305c17b6bab2f7c4161f04"], "node": "6f63bb32345b437d7dd75af144357b61d56c7e05", "parents": ["c2ee85d8bcb493525f32d5fc8add2d5a8bcf7e41"], "tags": []}, {"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059138 - Validate Feature Callout flip value before using it. r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315351\n", "files": ["browser/components/asrouter/modules/FeatureCallout.sys.mjs"], "git_node": "7de55102858f44140bc4f2708c56afd60dc14850", "git_parents": ["d2ae75b7d92cb5cca1b928d4ac17d066d5089f87"], "node": "8d8f8b06f270986c251412725f31ab006b2364d0", "parents": ["6f63bb32345b437d7dd75af144357b61d56c7e05"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2048762 - Use AboutRedirector for about:studies r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314997\n", "files": ["browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "toolkit/components/normandy/components.conf", "toolkit/components/normandy/content/AboutPages.sys.mjs", "toolkit/components/normandy/moz.build"], "git_node": "c361e0738b722f5f71ca86649784c9739c36c75f", "git_parents": ["7de55102858f44140bc4f2708c56afd60dc14850"], "node": "e865f3986df35ac532a6b829af790e806683cfe6", "parents": ["8d8f8b06f270986c251412725f31ab006b2364d0"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058916 - part 1 - Skip LinkText links not found in the full text r=android-reviewers,sfamisa\n\n`buildUrlAnnotatedString` logged but still added a LinkAnnotation when the link\ntext was blank or not found in the full text (indexOf returned -1), producing a\nspan with a negative start that crashed later in the text layout pass.\nSkip such links instead so the text still renders, just without the broken\nclickable span. This mainly guards against localized strings whose link\nsubstring drifts out of the full text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315282\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/LinkText.kt", "mobile/android/android-components/components/compose/base/src/test/java/mozilla/components/compose/base/LinkTextTest.kt"], "git_node": "dee06f5188a141016070567463a3bd6b57d83c87", "git_parents": ["c361e0738b722f5f71ca86649784c9739c36c75f"], "node": "ed69de72aa79b6643386ee32453cf0d339a9602c", "parents": ["e865f3986df35ac532a6b829af790e806683cfe6"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058916 - part 2 - Clamp the domain range before measuring the highlighted URL r=android-reviewers,sfamisa\n\n`computeDomainEndScrollValue` passed the registrable domain indices straight to\n`getPathForRange`, which throws if they are out of range or start \u003e end. Coerce\nthem so 0 \u003c= startIndex \u003c= endIndex \u003c= text.length always holds, guarding\nagainst a caller supplying a domain span inconsistent with the displayed URL.\n\nThis is mostly hardening the changes done for bug 2056836.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315283\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/build.gradle", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/HighlightedDomainUrl.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/ui/HighlightedDomainUrlLayoutTest.kt"], "git_node": "e5022c041c9907699477ed3caa937461494e7464", "git_parents": ["dee06f5188a141016070567463a3bd6b57d83c87"], "node": "de36f9398a2e0191a680c50454d82e45986e685d", "parents": ["ed69de72aa79b6643386ee32453cf0d339a9602c"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053578 - Use static_cast in nsSplittableFrame::UpdateFirstContinuationAndFirstInFlowCache(). r=layout-reviewers,jfkthame\n\n`nsSplittableFrame` is a subclass of `nsIFrame`, it is sufficient to use\n`static_cast`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315157\n", "files": ["layout/generic/nsSplittableFrame.cpp"], "git_node": "734eaa2b1a9e02f7eaf5b1f6f5ca8497d09a6704", "git_parents": ["e5022c041c9907699477ed3caa937461494e7464"], "node": "3ec6e7dfb4e9529ccd474739a43d900b26ca5928", "parents": ["de36f9398a2e0191a680c50454d82e45986e685d"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053578 - Update first-in-flow cache when a continuation is changing from fluid to non-fluid. r=layout-reviewers,jfkthame\n\nThe original case in bug 2053578 comment 5 can reproduce an ASAN\nuse-after-poison with the patch bug 2053578 comment 6 applied. However, with\nunpatched code, the best we can do is using a DEBUG-only assertion to catch the\nerror condition that detect a stale first-in-flow cache in next-in-flow.\n\n`bidi-inline-continuation-first-in-flow.html` is generated with the help of\nClaude code, and it can trigger the assertion without other fix in this patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315158\n", "files": ["layout/generic/nsSplittableFrame.cpp", "testing/web-platform/tests/css/css-writing-modes/crashtests/bidi-inline-continuation-first-in-flow.html"], "git_node": "f49e44a6db6ef7b48f790210ff94e40634def087", "git_parents": ["734eaa2b1a9e02f7eaf5b1f6f5ca8497d09a6704"], "node": "c1c95a8d3b6e1a89584b2bc25c51fafe14df14b8", "parents": ["3ec6e7dfb4e9529ccd474739a43d900b26ca5928"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2048762 - Use AboutRedirector for about:studies r=Gijs\" for causing build bustages\n\nThis reverts commit c361e0738b722f5f71ca86649784c9739c36c75f.\n", "files": ["browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "toolkit/components/normandy/components.conf", "toolkit/components/normandy/content/AboutPages.sys.mjs", "toolkit/components/normandy/moz.build"], "git_node": "9a0dece0960397960c7a17c786d87d84f09aa429", "git_parents": ["f49e44a6db6ef7b48f790210ff94e40634def087"], "node": "57459003590816ccd23e2299d3404bd8697c673f", "parents": ["c1c95a8d3b6e1a89584b2bc25c51fafe14df14b8"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2052949 - Fire load/error event for a modulepreload whose module is fetching, fetched or cached. r=jonco,dom-core-reviewers,edgar,arai\n\nA \u003clink rel=modulepreload\u003e whose module is already in the module map, or comes\nfrom the in-memory navigation cache, is satisfied without opening a channel.\nRegistration with the PreloadService happens in StartLoadInternal, which isn't\nreached in those cases, so PreloadService::PreloadOrCoalesce finds no preloader\nfor the element and a spurious error event is fired.\n\nRegister such a request in ScriptLoader::PreloadURI instead, identifying it by\nhaving no channel, and report the top-level module's result from\nScriptLoadContext::NotifyPreloadCoalescingResult: load once the module has been\nfetched, even with a parse error, error once the fetch has failed or been\ncanceled, and nothing while it is still fetching - ModuleLoaderBase notifies\nagain when the fetch it coalesced onto finishes or is dropped. As the\nmodulepreload spec requires, this happens before the module's dependencies.\n\nThe coalesced state is flagged on the ScriptLoadContext instead of being derived\nfrom the eLinkPreload script mode, which a \u003cscript\u003e element stealing the preload\nclears while the element still needs its event.\n\nAdd WPTs for the module map states, for firing before dependencies and for a\npreload consumed by a \u003cscript\u003e element, and a mochitest for the memory cache.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311782\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_module_preload.js", "dom/script/ScriptLoadContext.cpp", "dom/script/ScriptLoadContext.h", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "js/loader/ModuleLoadRequest.cpp", "js/loader/ModuleLoadRequest.h", "js/loader/ModuleLoaderBase.cpp", "testing/web-platform/tests/preload/modulepreload-already-in-module-map.html", "testing/web-platform/tests/preload/modulepreload-consumed-by-script.html", "testing/web-platform/tests/preload/modulepreload-fires-before-dependencies.html", "testing/web-platform/tests/preload/resources/preload-module-helper.js", "testing/web-platform/tests/preload/resources/preload-module.py", "uriloader/preload/PreloaderBase.h"], "git_node": "6649967a438e2d4162959955f55555b47aadbf2a", "git_parents": ["9a0dece0960397960c7a17c786d87d84f09aa429"], "node": "6b42ae86be3e9be525e6678dc3d7447fdf47f44e", "parents": ["57459003590816ccd23e2299d3404bd8697c673f"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058840 - Add Sans Serif Collection to Windows standard font list. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315366\n", "files": ["gfx/thebes/StandardFonts-win10.inc"], "git_node": "3f8c26bb4397df7ed601f48a6b3e83076238fa7c", "git_parents": ["6649967a438e2d4162959955f55555b47aadbf2a"], "node": "21296e042bdf31230d5b88b3138b3663c2bf2e68", "parents": ["6b42ae86be3e9be525e6678dc3d7447fdf47f44e"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2058818 - Migrate verifyOpeningScreenOptionsTest UI test to the efficiency framework r=aaronmt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314885\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsHomepageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/Selector.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsHomepagePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsHomepageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsHomepageTest.kt"], "git_node": "e97994401d810754f213b2f1de41e50895ea1fb4", "git_parents": ["3f8c26bb4397df7ed601f48a6b3e83076238fa7c"], "node": "3db4de5ff1d6dd8d71cbb5f7fd3dac715ff873b2", "parents": ["21296e042bdf31230d5b88b3138b3663c2bf2e68"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2059467 - Fix JustifyItems::from_computed_value. r=firefox-style-system-reviewers,dshin\n\nThe right value to use is the computed one, that's the \"real\" one it\nrepresents.\n\nBefore this patch:\n\n  getComputedStyle(document.documentElement).placeItems // normal legacy\n\nAfter it returns normal, as expected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315315\n", "files": ["servo/components/style/values/computed/align.rs", "testing/web-platform/meta/css/css-align/parsing/place-items-computed.html.ini", "testing/web-platform/tests/css/css-align/parsing/place-items-computed.html"], "git_node": "57818d6caff53cffd278b871e3f35e36fca90cd0", "git_parents": ["e97994401d810754f213b2f1de41e50895ea1fb4"], "node": "0ba245b5b7c6d00856baaccfe6a8929a250a32b8", "parents": ["3db4de5ff1d6dd8d71cbb5f7fd3dac715ff873b2"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2059467 - Use getComputedStyle() in get_computed_value. r=firefox-style-system-reviewers,dshin\n\nNow getComputedStyle supports shorthands so we can do this.\n\nRemove some \"initial values\" which are not really initials (percentages\ndon't get resolved to 0px). Arguably it should, but separate /\npre-existing issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315316\n", "files": ["layout/style/test/property_database.js"], "git_node": "bbab723d2c28fb9ea2e99961afb90689a7dd9a4e", "git_parents": ["57818d6caff53cffd278b871e3f35e36fca90cd0"], "node": "e3c4b68d0f559b65ef81b045c2147b2d0e93bd6d", "parents": ["0ba245b5b7c6d00856baaccfe6a8929a250a32b8"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046795 - Update account menu sign in button for Nova r=desktop-theme-reviewers,fluent-reviewers,omc-reviewers,bolsson,sync-reviewers,skhamis,aminomancer,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313016\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-profiles.js", "browser/base/content/browser-sync.js", "browser/base/content/kit-signed-out.svg", "browser/base/content/test/sync/browser_sync.js", "browser/base/jar.mn", "browser/components/asrouter/tests/browser/browser_asrouter_menu_messages.js", "browser/locales/en-US/browser/sync.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "327d291ca0e62ba3fbbb7463576c71e6e094fa65", "git_parents": ["bbab723d2c28fb9ea2e99961afb90689a7dd9a4e"], "node": "8eb246ee9b3f0625c5bbad4e4d9766410c198a39", "parents": ["e3c4b68d0f559b65ef81b045c2147b2d0e93bd6d"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059031 - [Nova] Increase the urlbar's min-height in compact mode. r=dao,desktop-theme-reviewers,urlbar-reviewers\n\nI'm pretty sure this bug is due to the fact that the border in Nova is actually\nan outline inside the urlbar rather than a border outside it. The min-height\nneeds to take the extra 2px into account.\n\nIn the Figma, the height of the input is 28px and does seem to include the\nborder. The border width is 1, so excluding the border the height is 26px.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315137\n", "files": ["browser/themes/shared/urlbar/variables.css"], "git_node": "1a3d807b20cf0c0890fa7b8233a538c2c13d3572", "git_parents": ["327d291ca0e62ba3fbbb7463576c71e6e094fa65"], "node": "d2fa2525836536ab691a077a06c4a21eb2251a9d", "parents": ["8eb246ee9b3f0625c5bbad4e4d9766410c198a39"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043047 - Move wasmCompileInSeparateProcess to the fuzzing-unsafe shell functions. r=jandem\n\nUnder --fuzzing-safe the builtin is no longer defined, so a fuzzing harness\ncannot invoke it and interpose on the child compile-and-serialize process to\nfeed back a tampered serialized module. The separate-process machinery itself\nis unchanged; the function remains available for normal (non-fuzzing) shell\ntesting.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314733\n", "files": ["js/src/shell/js.cpp"], "git_node": "5ca7246eb9ae49f39853e1f14eef91f031756658", "git_parents": ["1a3d807b20cf0c0890fa7b8233a538c2c13d3572"], "node": "cf7f30ce6ad1652d8fb638dff4f10e8e1f3d6ea7", "parents": ["d2fa2525836536ab691a077a06c4a21eb2251a9d"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058118 - Fix LlamaCppPipeline.run() finalOutput accumulating chunk objects as text r=ai-platform-reviewers,nordzilla\n\nrun() accumulated chunk objects into finalOutput, yielding \"[object Object]...\" text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314516\n", "files": ["toolkit/components/ml/content/backends/LlamaCppPipeline.mjs"], "git_node": "502a4b4c175b352da4d858942842f3888233b345", "git_parents": ["5ca7246eb9ae49f39853e1f14eef91f031756658"], "node": "4b18bc8f8eaea648f18aaee2255d8afe011b8fbb", "parents": ["cf7f30ce6ad1652d8fb638dff4f10e8e1f3d6ea7"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058119 - llama.cpp callsites stop requesting options the engine never served r=ai-platform-reviewers,ngrato,nordzilla\n\nkvCacheDtype, flashAttn and numBatch/numUbatch requests were never honored.\nThis deletes fiction in consumer use of the llama.cpp backend.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314519\n", "files": ["browser/components/genai/LinkPreviewModel.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_llama_smollm2_smoke.js", "toolkit/components/ml/tests/browser/browser_ml_llama_summarizer_perf.js", "toolkit/components/ml/tests/browser/browser_ml_native.js"], "git_node": "1867b3fcf31039c49e28fe1dfddc5139ed7b4917", "git_parents": ["502a4b4c175b352da4d858942842f3888233b345"], "node": "bc68a25817c8dfd6d3aff29ec89b7e4e3e104d3d", "parents": ["4b18bc8f8eaea648f18aaee2255d8afe011b8fbb"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058122 - Improved llama engine crash test. r=ai-platform-reviewers,nordzilla\n\nAdded a check that a crash indeed happened, improving upon previous version which was asserting ok.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314522\n", "files": ["toolkit/components/ml/tests/browser/browser_ml_native.js"], "git_node": "c2ea213cfe445ffe8ad4b110630bd67142b476bd", "git_parents": ["1867b3fcf31039c49e28fe1dfddc5139ed7b4917"], "node": "910d7f87ebb5a8d77c963361616782eea3540e57", "parents": ["bc68a25817c8dfd6d3aff29ec89b7e4e3e104d3d"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058687 - Cleanup the llama.cpp summarizer perftest r=ai-platform-reviewers,perftest-reviewers,nordzilla,aglavic\n\nbrowser_ml_llama_summarizer_perf now runs Qwen3 0.6B and SmolLM2 360M in configurations close to Link Preview\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314753\n", "files": ["testing/perfdocs/generated/mozperftest.md", "toolkit/components/ml/tests/browser/browser_ml_llama_summarizer_perf.js"], "git_node": "d4b3d668507e4e814c6b0416bb243da29ac59fa4", "git_parents": ["c2ea213cfe445ffe8ad4b110630bd67142b476bd"], "node": "78742650acee8508d4fab1d24e8efd1e4eddac6a", "parents": ["910d7f87ebb5a8d77c963361616782eea3540e57"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059422 - Schedule the speculation rules prefetch list-source tests in CI r=perftest-reviewers,sparky\n\nSchedule these tests to monitor for feature support and potential breakages.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315289\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "6a670b26830e34eda693981f726a88419ee229f1", "git_parents": ["d4b3d668507e4e814c6b0416bb243da29ac59fa4"], "node": "106de60379ccefd9878a4db75dd9b43f5e2b3c94", "parents": ["78742650acee8508d4fab1d24e8efd1e4eddac6a"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2059541 - Update telemetry alerts dashboard links. r=aglavic,perftest-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315392\n", "files": ["testing/perfdocs/generated/telemetry-alerting.md", "testing/performance/telemetry-alerting/perfdocs/index.md"], "git_node": "d923a0e799a3e99f5f81e6bea8858b14cfa1b24a", "git_parents": ["6a670b26830e34eda693981f726a88419ee229f1"], "node": "dfdb3b92adcc3c859a9ba6186a3b1f95b7f2ab52", "parents": ["106de60379ccefd9878a4db75dd9b43f5e2b3c94"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2054529 - [Monitor Agent][FE] Move hardcded string to locals preview file r=yjamora,fluent-reviewers,bolsson import uuid\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314066\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/content/aiChatContent.html", "browser/components/aiwindow/ui/content/tasks.html", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_chat.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/components/aiwindow/ui/test/browser/test_agent_monitor_item_page.html", "browser/locales-preview/aiWindow.ftl"], "git_node": "884ccb6ab8db53408166fe911f2246e22a3590bc", "git_parents": ["d923a0e799a3e99f5f81e6bea8858b14cfa1b24a"], "node": "95a80fbba56a71e140532bf14c38ee1930acf55e", "parents": ["dfdb3b92adcc3c859a9ba6186a3b1f95b7f2ab52"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1452337 - Restrict WebRender image sampling to the visible sprite sheet cell r=gfx-reviewers,lsalzman\n\nA sprite sheet is pushed as the whole image clipped to one cell, with nothing\nrestricting sampling, so filtering at fractional raster scales pulls in the\nneighbours. Add ImageDisplayItem::sub_rect, applied via add_sub_rect the way\nborder-image already does per nine-patch slice.\n\nnsImageRenderer rounds it out and leaves dest alone, mirroring the subimage in\nComputeSnappedImageDrawingParameters, so the rounding cannot displace anything.\nSince add_sub_rect narrows the one rect used for both the uv mapping and the\nsample bounds, the pattern is situated on the sub-rect's destination instead of\ngiving every quad a second rect.\n\n403181-1 covers this bleed directly and now matches exactly, and 446100-1c\nimproves, so both fuzz annotations move with it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315175\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/examples/blob.rs", "gfx/wr/examples/image_resize.rs", "gfx/wr/examples/texture_cache_stress.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/webrender_api/src/interned_prims.rs", "gfx/wr/wrench/reftests/image/reftest.list", "gfx/wr/wrench/reftests/image/sub-rect-clamp-ref.yaml", "gfx/wr/wrench/reftests/image/sub-rect-clamp.yaml", "gfx/wr/wrench/src/rawtest.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs", "layout/painting/nsImageRenderer.cpp", "layout/reftests/backgrounds/reftest.list", "layout/reftests/backgrounds/sprite-sampling-clamp-1-ref.html", "layout/reftests/backgrounds/sprite-sampling-clamp-1.html", "layout/reftests/backgrounds/sprite-sampling-clamp-ref.png", "layout/reftests/backgrounds/sprite-sampling-clamp.png", "layout/reftests/bugs/reftest.list"], "git_node": "2a5a0815893f10114b54eb9e01af17acaa085545", "git_parents": ["884ccb6ab8db53408166fe911f2246e22a3590bc"], "node": "00875c15a35fc2e42304c45d2bcc96eb22cf9c59", "parents": ["95a80fbba56a71e140532bf14c38ee1930acf55e"], "tags": []}, {"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051660 - New Tab referrals entry point r=omc-reviewers,emcminn,maxx\n\nAdds an iconSrc to the primary button for NewTab message, as well as\nfour assets for the Firefox mascot.\n\nIn order to make the message look good on different widths, this also\nadds a .has-responsive-image CSS class to the asrouter-newtab-message\nstyles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313891\n", "files": ["browser/components/asrouter/content/components/asrouter-newtab-message/asrouter-newtab-message.css", "browser/components/asrouter/content/components/asrouter-newtab-message/asrouter-newtab-message.mjs", "browser/components/asrouter/docs/asrouter-newtab-message.md", "browser/extensions/newtab/data/content/assets/firefox-mascot-prop-heart-dark-narrow.svg", "browser/extensions/newtab/data/content/assets/firefox-mascot-prop-heart-dark-responsive.svg", "browser/extensions/newtab/data/content/assets/firefox-mascot-prop-heart-dark.svg", "browser/extensions/newtab/data/content/assets/firefox-mascot-prop-heart-light-narrow.svg", "browser/extensions/newtab/data/content/assets/firefox-mascot-prop-heart-light-responsive.svg", "browser/extensions/newtab/data/content/assets/firefox-mascot-prop-heart-light.svg"], "git_node": "1b32a918d30f12a6f1e563012a8d236ac6fc3e5f", "git_parents": ["2a5a0815893f10114b54eb9e01af17acaa085545"], "node": "5c431608ab3e803342390b77d84ac81a059aac2e", "parents": ["00875c15a35fc2e42304c45d2bcc96eb22cf9c59"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050228 - Guard against dash length becoming zero in cairo-win32 printing backend. r=gfx-reviewers,lsa