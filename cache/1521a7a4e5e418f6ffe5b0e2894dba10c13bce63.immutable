.css", "devtools/client/shared/components/FileSearchBar.css", "devtools/client/shared/components/tabs/Tabs.css", "devtools/client/themes/common.css", "devtools/client/themes/dark-theme.css", "devtools/client/themes/light-theme.css", "devtools/client/themes/markup.css", "devtools/client/themes/rules.css", "devtools/client/themes/styleeditor.css", "devtools/client/themes/tooltips.css", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/no-has-selector.md", "toolkit/components/translations/content/about-translations.css", "toolkit/content/widgets/moz-box-item/moz-box-item.css", "toolkit/content/widgets/moz-button/moz-button.css", "toolkit/content/widgets/moz-card/moz-card.css", "toolkit/content/widgets/moz-fieldset/moz-fieldset.css", "toolkit/content/widgets/moz-five-star/moz-five-star.css", "toolkit/content/widgets/moz-input-common.css", "toolkit/content/widgets/moz-page-header/moz-page-header.css", "toolkit/content/widgets/moz-page-nav/moz-page-nav.css", "toolkit/content/widgets/moz-promo/moz-promo.css", "toolkit/content/widgets/moz-select/moz-select.css", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker-item.css", "toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/themes/shared/aboutNetError.css", "toolkit/themes/shared/pictureinpicture/player.css", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/index.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/no-has-selector.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/no-has-selector.tests.mjs"], "git_node": "6fde85fcae9c12daa94400f4b68b598ef2a9d203", "git_parents": ["7858629ebaa1a9975ee3b8674b430c2842c6b714"], "node": "f06e1d57bf64f26b3f287ef0475f4f822c62529f", "parents": ["ceac4084e2618c3d9da550ff64f47b550c379ae1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060416 - Honor browser.tabs.closeWindowWithLastTab when content closes the last tab. r=tabbrowser-reviewers,sclements\n\nThe DOMWindowClose handler tore the window down whenever the closing browser\nwas the only tab, without consulting the pref that removeTab() checks. A page\nthat opens popups (rendered as tabs under browser.link.open_newwindow.restriction=0)\nand closes them from its unload handler therefore quit the browser: the opener's\nunload runs after its own tab is gone, so the last popup's close request hits\nthat branch.\n\nFalling through to removeTab() for the pref-off case reuses the existing\nlast-tab handling, which leaves an empty tab behind. Worth verifying: popup\nwindows have no tab strip, so the !window.toolbar.visible half of the condition\nmust keep closing them outright - the third test task covers that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316279\n", "files": ["browser/components/tabbrowser/content/tabbrowser.js", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_closeWindowWithLastTab_contentClose.js"], "git_node": "7452c589da021d2f30a9564580288c47727cd99d", "git_parents": ["6fde85fcae9c12daa94400f4b68b598ef2a9d203"], "node": "6050590e27422e25201b48ee13ac301b44ab40b0", "parents": ["f06e1d57bf64f26b3f287ef0475f4f822c62529f"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Revert \"Bug 2048082 - World Cup celebration phase 2: tournament result views r=thecount\" for installer size increase (bug 2055495)\n\nThis reverts commit 08bf4be16e54f33e2b31870eaccf6a8f5e1fe7bb.\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/SportsWidget/SportsResultCelebration.jsx", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/SportsWidget.jsx", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/_SportsResultCelebration.scss", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/matchResult.mjs", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/stageLabels.mjs", "browser/extensions/newtab/content-src/components/Widgets/WidgetCelebration.jsx", "browser/extensions/newtab/content-src/components/Widgets/_WidgetCelebration.scss", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/content-src/styles/nova/activity-stream.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/assets/kit-champion.png", "browser/extensions/newtab/data/content/assets/kit-champion.webm", "browser/extensions/newtab/data/content/assets/kit-default.png", "browser/extensions/newtab/data/content/assets/kit-default.webm", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/SportsResultCelebration.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/SportsWidget.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetCelebration.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/matchResult.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/Widgets/WidgetCelebration.test.jsx"], "git_node": "395404218d891f4da618342bfd4a268dc634ae15", "git_parents": ["7452c589da021d2f30a9564580288c47727cd99d"], "node": "96468f2f5bea4c9dcffd1291fc5d3afa7210704e", "parents": ["6050590e27422e25201b48ee13ac301b44ab40b0"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059019. r=webgpu-reviewers,aleiserson\" for causing lint failures @ GpuProcessD3D11TextureMap.h\n\nThis reverts commit 7858629ebaa1a9975ee3b8674b430c2842c6b714.\n", "files": ["dom/webgpu/ExternalTexture.cpp", "gfx/gl/GLBlitHelperD3D.cpp", "gfx/layers/d3d11/GpuProcessD3D11TextureMap.cpp", "gfx/layers/d3d11/GpuProcessD3D11TextureMap.h"], "git_node": "4f285b74e436a0c376eb8c5ad04d1dce6356c0fc", "git_parents": ["395404218d891f4da618342bfd4a268dc634ae15"], "node": "d323fd750a15736c20e0c14b1ab06bd6e22bf80c", "parents": ["96468f2f5bea4c9dcffd1291fc5d3afa7210704e"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060802 - Enable the continuous onboarding flow by default r=android-reviewers,alastun\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316513\n", "files": ["mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/OnboardingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/OnboardingSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/OnboardingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HomeScreenRobot.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesOnboardingBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/utils/UiDevice.kt"], "git_node": "e88b23431edbce2b7030053bf3746bc43af5c46a", "git_parents": ["4f285b74e436a0c376eb8c5ad04d1dce6356c0fc"], "node": "d8eb1986c5227486f1a04cc32a804830cc909148", "parents": ["d323fd750a15736c20e0c14b1ab06bd6e22bf80c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1961954 - Hand tab hover state over to the tab replacing a closing one. r=tabbrowser-reviewers,sclements\n\nClosing a tab dismissed the tab preview even though the pointer hadn't moved\nand another tab had immediately taken the closed tab's place under it. Nothing\nbrought the preview back deliberately: that relied on Gecko's reflow-driven\nsynthesized mouse move producing a mouseover on the replacement tab, and on\nthat landing inside the preview's 300ms zero-delay window. Where it didn't, the\npreview stayed gone until the mouse was moved; where it did, the panel still\nvisibly closed and reopened.\n\nWe already invalidate the closing tab's hover state, so hand it to the tab\nmoving into its spot rather than waiting for an event that may not come. The\nexisting TabHoverEnd/TabHoverStart path then carries the preview across without\nit closing, and _hover stays accurate, which is what lets a second close in a\nrow be noticed at all.\n\nWorth checking: nothing takes the closed tab's place (last tab) and a tab group\nlabel taking it both still dismiss the preview, and the panel stays correctly\nanchored while the strip animates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315624\n", "files": ["browser/components/tabbrowser/content/tabbrowser.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js"], "git_node": "7456f1aba61a49b9b536cd962a9253c10407c9e3", "git_parents": ["e88b23431edbce2b7030053bf3746bc43af5c46a"], "node": "8d20dbaa769e19dd7990516470276830455a4c2f", "parents": ["d8eb1986c5227486f1a04cc32a804830cc909148"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054652 - Check resource namespaces during displaylist building. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315537\n", "files": ["gfx/layers/wr/AsyncImagePipelineManager.cpp", "gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/example-compositor/compositor/src/main.rs", "gfx/wr/examples/common/boilerplate.rs", "gfx/wr/examples/document.rs", "gfx/wr/examples/iframe.rs", "gfx/wr/examples/multiwindow.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/shutdown_test.rs", "gfx/wr/wrench/src/rawtest.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "36ad2c446eb4b63418ca51e9691b1b2f4c5a9086", "git_parents": ["7456f1aba61a49b9b536cd962a9253c10407c9e3"], "node": "7147d70b6981b61f1ed8c7aa4d9f0df10e39106b", "parents": ["8d20dbaa769e19dd7990516470276830455a4c2f"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2060505 - Reconfigure stdout/stderr as utf-8 r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316245\n", "files": ["python/mach/mach/main.py", "python/mozlint/mozlint/cli.py"], "git_node": "830ae95dc78edd3cc4f0fdfe263239942cc19755", "git_parents": ["36ad2c446eb4b63418ca51e9691b1b2f4c5a9086"], "node": "69f40722525fbaad610d1a131bc903a026ca33d9", "parents": ["7147d70b6981b61f1ed8c7aa4d9f0df10e39106b"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2053812 - Add message targeting for Windows users where one-click default is enabled r=omc-reviewers,nrishel,hanna_a,aborondo,hsohaney\n\nAdd message system targeting for Windows users where one-click set to default is enabled and functional.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311309\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/shell/ShellService.sys.mjs", "browser/components/shell/WindowsUserChoice.cpp", "browser/components/shell/WindowsUserChoice.h", "browser/components/shell/nsIWindowsShellService.idl", "browser/components/shell/nsWindowsShellService.cpp", "browser/components/shell/test/unit/test_isOneClickSetDefaultEnabled.js", "browser/components/shell/test/unit/xpcshell.toml"], "git_node": "7dc630a7c85d63c4041ca55ba4937f14d58bd9aa", "git_parents": ["830ae95dc78edd3cc4f0fdfe263239942cc19755"], "node": "a708373de5e4f3c808a286d7a8b737d4ef2c1e6c", "parents": ["69f40722525fbaad610d1a131bc903a026ca33d9"], "tags": []}, {"author": "Tiaan Louw \u003ctlouw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056189 - Add tests for applying margin-trim styles dynamically r=layout-reviewers,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312980\n", "files": ["testing/web-platform/tests/css/css-box/margin-trim/block-container-style-change-triggers-layout-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/block-container-style-change-triggers-layout-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/block-container-style-change-triggers-layout-block.html"], "git_node": "7dcb930e58813dd1315e2d43d336c8926d2ee286", "git_parents": ["7dc630a7c85d63c4041ca55ba4937f14d58bd9aa"], "node": "2c3556f1b66a71dd4050f3641b0b235d2f5d416c", "parents": ["a708373de5e4f3c808a286d7a8b737d4ef2c1e6c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058815 - Remove unnecessary alignment declaration that causes indefinite block sizes. r=desktop-theme-reviewers,dao\n\nThis goes effectively back to bug 1392340, but tons of changes have\nhappened since (including the move to flex layout and the regressing\nbugs).\n\nIt doesn't seem to be needed. I tested by bumping up the transition\nduration and transitioning between the open tracker panel opening and\nback (which trigger this \"very different height\" case), and smoketesting\nother panels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316255\n", "files": ["browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "76b81a0f17439ec283e255861db1a5cbbc92b7ed", "git_parents": ["7dcb930e58813dd1315e2d43d336c8926d2ee286"], "node": "013f1bd6c47ce94d4176c92705ded739e88d4506", "parents": ["2c3556f1b66a71dd4050f3641b0b235d2f5d416c"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056189 - Add tests for applying margin-trim styles dynamically r=layout-reviewers,jfkthame\" for causing WR failures @ /css/css-box/margin-trim/block-container-style-change-triggers-layout-block-end.html\n\nThis reverts commit 7dcb930e58813dd1315e2d43d336c8926d2ee286.\n", "files": ["testing/web-platform/tests/css/css-box/margin-trim/block-container-style-change-triggers-layout-block-end.html", "testing/web-platform/tests/css/css-box/margin-trim/block-container-style-change-triggers-layout-block-start.html", "testing/web-platform/tests/css/css-box/margin-trim/block-container-style-change-triggers-layout-block.html"], "git_node": "a852425caab71ab797500fffda2e0344579c1565", "git_parents": ["76b81a0f17439ec283e255861db1a5cbbc92b7ed"], "node": "f8d4422293f62f243cb7c3d68bbaf2b34272947a", "parents": ["013f1bd6c47ce94d4176c92705ded739e88d4506"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048082 - World Cup celebration phase 2: tournament result views r=thecount\n\nAdd the end-of-tournament celebration views to the Sports widget: a\nthird-place card, a champion card, and a final-standings podium, with\nteam-colored soccer confetti, a fireworks finale, and a fox mascot.\n\nPlacements are derived from the Final and 3rd Place matches (champion and\nrunner-up from the Final, third place from the 3rd Place match), reading\nfinished matches from both the previous and current buckets so a just-ended\nmatch still sitting in current is picked up. A live match always wins: the\nresult views take over the widget and hide the tab bar, so they are\nsuppressed while a match is in progress.\n\nAlso map the \"3rd Place\" stage string to its Fluent label in stageLabels;\nthe feed sends \"3rd Place\", not the previously-assumed \"Bronze Final\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307661\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/SportsWidget/SportsResultCelebration.jsx", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/SportsWidget.jsx", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/_SportsResultCelebration.scss", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/matchResult.mjs", "browser/extensions/newtab/content-src/components/Widgets/SportsWidget/stageLabels.mjs", "browser/extensions/newtab/content-src/components/Widgets/WidgetCelebration.jsx", "browser/extensions/newtab/content-src/components/Widgets/_WidgetCelebration.scss", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/content-src/styles/nova/activity-stream.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/assets/kit-champion.png", "browser/extensions/newtab/data/content/assets/kit-champion.webm", "browser/extensions/newtab/data/content/assets/kit-default.png", "browser/extensions/newtab/data/content/assets/kit-default.webm", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/SportsResultCelebration.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/SportsWidget.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetCelebration.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/matchResult.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/Widgets/WidgetCelebration.test.jsx"], "git_node": "dc9cf3563fd916db0decb593db69d69bb423581f", "git_parents": ["a852425caab71ab797500fffda2e0344579c1565"], "node": "c33ed6ece546f524466594ebb465d6668bb4ef46", "parents": ["f8d4422293f62f243cb7c3d68bbaf2b34272947a"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060802 - Enable the continuous onboarding flow by default r=android-reviewers,alastun\" for causing android failures\n\nThis reverts commit e88b23431edbce2b7030053bf3746bc43af5c46a.\n", "files": ["mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/OnboardingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/OnboardingSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/OnboardingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HomeScreenRobot.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesOnboardingBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/utils/UiDevice.kt"], "git_node": "9c1326e31c449715035d4b617328fece561d436d", "git_parents": ["dc9cf3563fd916db0decb593db69d69bb423581f"], "node": "041401b887b356697a22c0b415acd27103a1493e", "parents": ["c33ed6ece546f524466594ebb465d6668bb4ef46"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048082 - Fix node newtab failures\n", "files": ["browser/extensions/newtab/data/content/activity-stream.bundle.js"], "git_node": "1ff4e2fba3597984bc5627adc6662a0f18e18e68", "git_parents": ["9c1326e31c449715035d4b617328fece561d436d"], "node": "a3b31187f5436ebfb3db38ba8ec55c44ca338f6d", "parents": ["041401b887b356697a22c0b415acd27103a1493e"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061183 - Enable at-rule() on WPTs.\n\nDONTBUILD, metadata only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316795\n", "files": ["testing/web-platform/meta/__dir__.ini"], "git_node": "8c0480aa3581e35193ba86f274ed59baef512c67", "git_parents": ["1ff4e2fba3597984bc5627adc6662a0f18e18e68"], "node": "46ab24e13db2ca49f3ad255ab2eb386a795af0c0", "parents": ["a3b31187f5436ebfb3db38ba8ec55c44ca338f6d"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2060505 - Hotfix for mozlint test failure\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316796\n", "files": ["python/mozlint/mozlint/cli.py"], "git_node": "dfc93bae676015f4ad2b6dcc15bae395153e8416", "git_parents": ["8c0480aa3581e35193ba86f274ed59baef512c67"], "node": "aae589bdf4fd498d7482305464541bbdb6a0d804", "parents": ["46ab24e13db2ca49f3ad255ab2eb386a795af0c0"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061092 - Update android nightly application-services version bump to 1912ba62c1c03d0e2bbd33a680f6d66b745d0212 r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316722\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "6a6850399b4a64dd675050300705f9e2e2c8dabf", "git_parents": ["dfc93bae676015f4ad2b6dcc15bae395153e8416"], "node": "0ebf0b1422ab9f48589bac5b366554cb531c63fc", "parents": ["aae589bdf4fd498d7482305464541bbdb6a0d804"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061105 - Fix inverted ternary in arena_t::PurgeLoop() reuse grace check. r=pbone\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316727\n", "files": ["memory/build/mozjemalloc.cpp"], "git_node": "ab1209f255608316e6f4a6dff129ed3362a92873", "git_parents": ["6a6850399b4a64dd675050300705f9e2e2c8dabf"], "node": "ac3042382201bf51d215d25fa378314409608d0d", "parents": ["0ebf0b1422ab9f48589bac5b366554cb531c63fc"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060831 - Update various node_modules and cleanup eslint-plugin-mozilla dependencies. r=frontend-codestyle-reviewers,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316515\n", "files": ["package-lock.json", "package.json", "tools/lint/eslint/eslint-plugin-mozilla/package-lock.json", "tools/lint/eslint/eslint-plugin-mozilla/package.json"], "git_node": "218e0b719c945627462aa98b305f16216189341a", "git_parents": ["ab1209f255608316e6f4a6dff129ed3362a92873"], "node": "f5f19b330111c39bfee56d450d652def7a08bd42", "parents": ["ac3042382201bf51d215d25fa378314409608d0d"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058673 - Add ensureBallast() for wasm Ion phi-allocation loops. r=jandem\n\nTwo loops in WasmIonCompile.cpp allocate one MPhi per element infallibly on a\nmodule-controlled trip count without a prior ensureBallast(), so a wide\nsignature exhausts the TempAllocator ballast and LifoAlloc asserts allocating a\nfresh chunk in an infallible scope (release: a controlled OOM abort):\n\n  - finishInlinedCallDirect: one phi per inlined callee result.\n  - the loop-header builder: one phi per loop block-parameter.\n\nAdd ensureBallast() at the top of each loop, matching bug 2042728.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315452\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2058673.js", "js/src/wasm/WasmIonCompile.cpp"], "git_node": "64b66c7ad648e93e8cacafe3c6738873e8beac94", "git_parents": ["218e0b719c945627462aa98b305f16216189341a"], "node": "ba9a2c633e3db3e3f627b5246bce4f73a977eca0", "parents": ["f5f19b330111c39bfee56d450d652def7a08bd42"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058621 - Part 1: Don't fire characterboundsupdate in ContentEventHandler. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315381\n", "files": ["dom/events/ContentEventHandler.cpp", "dom/html/EditContext.cpp", "dom/html/EditContext.h", "editor/libedit