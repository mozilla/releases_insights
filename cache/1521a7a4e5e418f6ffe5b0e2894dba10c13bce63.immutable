796e9bdcd94f73a548eaddcda00a16e3", "c5146aca54e022c84c29ec822ec7ddcd575d3ea7", "a3fde618a9404e3c39ffc8b5724b98315e9fd981", "cd6ffccd5dd3cfdf521e76c0e1bbfcd03f872939", "9c9d5a993b17d3ffd6245a157735493a06f84a35", "c2828f677e643714500d55f98c81736e2dcc28f1", "868f519c72dd0663cfb77d4783af441ae9c1e2a1", "ec2ab92b87822af8a58a225d59a763a3fd42c1bb", "259146e75e9cd01632b3371f95d543bcc1744ebd", "2f603b6be05c16a391c37708686aae1a8793a9cd", "09f59c80baebe714af240e6e947b482a6145377e", "c4693e19154faf3440e3755d6093bcf9207024ad", "582eeef4db53f1a4cbad5d22742586115feed460", "62f3a39b0ed863ac7f3a0e32b85fa6e52995b916", "1101153c3de2347be4dc16b0a6d6be7d533071a5", "f46583cd21065bd5063cc66b0f9da5c668df8b0c", "4ec138fdb02d8f8aa454d2db6aace70a7a30ff41", "492ee7ea0876bc97cecc03371daf16bceb465931", "d68039fa3f5fd6ca397553ea077cddc3a625c64c", "23bb2518bfc6c2d4465caaccff59daa7fc924bbc", "f73ae5567683688640c39b8bf69ef15e20bada83", "59ed6e0fb2377d0924286800dddbf4ec02f503fd", "11b0792e82d48348ac4ebea0ba3b8a3da6ad855d", "59d7241eb095411d84205061c76bbca271d11154", "7a1829761d5b8d1dd0db6c1ad411544283a1e954"], "user": "imoraru@mozilla.com"}, "45086": {"changesets": [{"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062275 - Memories Scheduler doesn't instantiate when browser opens directly into Smart Window r=gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317945\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_memories.js"], "git_node": "1ca4875bd39381bea847ad8256fcb5cbf11bd321", "git_parents": ["7a1829761d5b8d1dd0db6c1ad411544283a1e954"], "node": "dc5f75a9729920c4d29a371f3272080e3bbc6878", "parents": ["3b57684b8c98aaf3a96e1d2b7528c85ccc6c4ba1"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061024 - [Nova] Show the history favicon badge for top sites from history in the urlbar. r=daisuke,urlbar-reviewers,places-reviewers\n\nSet `result.source` to `HISTORY` rather than `OTHER_LOCAL` for sites from\nhistory and when history results are enabled. Add a condition to the view so\nthat we then set `type=\"history\"` for those rows rather than `\"top_site\"`. The\nhistory badge will be applied due to the existing CSS rules here:\n\nhttps://searchfox.org/firefox-main/rev/202150dcdade5798ca858b843b51b20112b4d061/browser/themes/shared/urlbar/view-nova.css#387-400\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316718\n", "files": ["browser/components/urlbar/UrlbarProviderTopSites.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser/browser_top_sites.js", "browser/components/urlbar/tests/unit/head.js", "browser/components/urlbar/tests/unit/test_UrlbarProviderTopSites.js", "browser/themes/shared/urlbar/view-nova.css", "toolkit/components/places/tests/PlacesTestUtils.sys.mjs"], "git_node": "2d7def6b21a21a350b4f1cca57c2eae38c991fbd", "git_parents": ["1ca4875bd39381bea847ad8256fcb5cbf11bd321"], "node": "44a3937af9b940fec955cc31cb8e2e67dc4a35da", "parents": ["dc5f75a9729920c4d29a371f3272080e3bbc6878"], "tags": []}, {"author": "Mark Hammond \u003cmhammond@skippinet.com.au\u003e", "branch": "default", "desc": "Bug 2062860 - Remove unused 'fxaccounts:verify_login' push message. r=skhamis\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318020\n", "files": ["browser/components/AccountsGlue.sys.mjs", "services/fxaccounts/FxAccountsCommon.sys.mjs", "services/fxaccounts/FxAccountsPush.sys.mjs", "services/fxaccounts/tests/browser/browser.toml", "services/fxaccounts/tests/browser/browser_verify_login.js", "services/fxaccounts/tests/xpcshell/test_push_service.js"], "git_node": "aabfc2b1fa3e83eb29e88e26e56e59c4b5586d71", "git_parents": ["2d7def6b21a21a350b4f1cca57c2eae38c991fbd"], "node": "53691e2a9e0a3e0e6c9ec8477fd3beb79529437e", "parents": ["44a3937af9b940fec955cc31cb8e2e67dc4a35da"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062042 - Minor native theme follow-ups. r=desktop-theme-reviewers,tabbrowser-reviewers,tgiles,dao\n\n* Don't override the chrome / content separator color with the nova\n   branded one.\n\n * Bring back the selected tab shadow since there's no border and\n   otherwise it might be hard to distinguish on some themes.\n\n * On macOS with nova, blend with the vibrant window background.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317324\n", "files": ["browser/themes/osx/browser.css", "browser/themes/shared/browser-colors.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "b7e5040c38ce32e053332dfd0d9183cbb629068b", "git_parents": ["aabfc2b1fa3e83eb29e88e26e56e59c4b5586d71"], "node": "8befe760c33332c555753d12aa9b31a9bbb5b968", "parents": ["53691e2a9e0a3e0e6c9ec8477fd3beb79529437e"], "tags": []}, {"author": "Daniel Darnell \u003cdaniel@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2062493 - Add update_clobber_file parameter to landoscript payload. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317712\n", "files": ["taskcluster/gecko_taskgraph/actions/merge_automation.py", "taskcluster/gecko_taskgraph/transforms/merge_automation.py"], "git_node": "c083282e5b066630302dd42b049a720e987e544a", "git_parents": ["b7e5040c38ce32e053332dfd0d9183cbb629068b"], "node": "75a98ba5afe5b935907a626a546f5f6c3aa2f2f0", "parents": ["8befe760c33332c555753d12aa9b31a9bbb5b968"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2000355 - Skip to the lowest observed ancestor on repeated mutations r=smaug\n\nForEachAncestorObserver walks the inclusive ancestor chain on every mutation,\nwhich is O(depth). To improve performance, nsINode memoizes one walk's start\nnode and the lowest ancestor found to hold an observer, and a later walk from\nthe same node starts there.\n\nThe memo only picks where a walk starts, never what it returns. It is dropped\nwhen an observer is registered anywhere, or when certain mutations occur.\n\nTestcase goes 8346 -\u003e 2342 samples, with the walk down from 53% to 0.8%.\nSpeedometer3 is neutral. mach try auto is clean.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314591\n", "files": ["dom/base/MutationObservers.cpp", "dom/base/MutationObservers.h", "dom/base/nsINode.cpp", "dom/base/nsINode.h"], "git_node": "0ed984469b442cd3395495b1ab70a79a90dfb9a3", "git_parents": ["c083282e5b066630302dd42b049a720e987e544a"], "node": "d2b9fe253a334ce34828086629d88919d8a0ccaf", "parents": ["75a98ba5afe5b935907a626a546f5f6c3aa2f2f0"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053939 - Support reopening browsing context from Pickup Where You Left Off r=pdahiya\n\n- Resume pills now construct a new conversation to continue the associated activity, rather than submitting the pill headline as a regular chat message\n- Adds an open_tabs confirmation card based on the pill's preview tabs so users can reopen the associated pages\n- Falls back to a normal chat message if conversation construction fails or the user navigates away before it completes\n- Falls back to a standard chat when memories are disabled, preventing resume memory context from being added to the system prompt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316955\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "9c3922cb6b6e4846adfe1ec3e986a6d72357d79a", "git_parents": ["0ed984469b442cd3395495b1ab70a79a90dfb9a3"], "node": "66306bd68ada1750bef531e795d860d822dc2f04", "parents": ["d2b9fe253a334ce34828086629d88919d8a0ccaf"], "tags": ["FIREFOX_BETA_155_BASE", "FIREFOX_NIGHTLY_155_END"]}], "date": 1786614798, "git_changesets": ["1ca4875bd39381bea847ad8256fcb5cbf11bd321", "2d7def6b21a21a350b4f1cca57c2eae38c991fbd", "aabfc2b1fa3e83eb29e88e26e56e59c4b5586d71", "b7e5040c38ce32e053332dfd0d9183cbb629068b", "c083282e5b066630302dd42b049a720e987e544a", "0ed984469b442cd3395495b1ab70a79a90dfb9a3", "9c3922cb6b6e4846adfe1ec3e986a6d72357d79a"], "user": "abutkovits@mozilla.com"}}
}";