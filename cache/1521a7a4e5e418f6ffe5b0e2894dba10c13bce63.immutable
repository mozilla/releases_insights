_setLocalAnswerInStable.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_setLocalOfferInHaveRemoteOffer.html", "dom/webidl/RTCError.webidl", "dom/webidl/RTCErrorEvent.webidl", "dom/workers/test/test_worker_interfaces.js", "netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannel.h", "netwerk/sctp/datachannel/DataChannelDcSctp.cpp", "testing/web-platform/meta/webrtc/RTCDataChannel-close.html.ini", "testing/web-platform/meta/webrtc/RTCPeerConnection-setLocalDescription-answer.html.ini"], "git_node": "3a0b1f2148364a6c4dd9d515827f58192fd422d1", "git_parents": ["cdcbbe25ef9b194fe9ed33c286dd1c68fed5b3f3"], "node": "2f9576e63cd2ce7b4a745a53693622ae62566a81", "parents": ["4eeabc18b7bfc1c473327302605bf025b74780d8"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059030 - Use MAC in TopSitesFeed for fetching tiles from MARS r=mconley\n\nWhen AdsClient is enabled and set in TopSitesFeed,\nuse MAC to make calls to MARS instead of manual fetch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315036\n", "files": ["browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TopSitesFeed.js"], "git_node": "048a4d26f24981e3e6b4a44861a4c7a1e6a95ef4", "git_parents": ["3a0b1f2148364a6c4dd9d515827f58192fd422d1"], "node": "3c99f5835ccf17259e00aa542a2c786b17805da6", "parents": ["2f9576e63cd2ce7b4a745a53693622ae62566a81"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046592 - Add Desktop notification when active monitor meets condition r=ngrato,tetchart,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313841\n", "files": ["browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/locales-preview/aiWindow.ftl", "browser/locales/jar.mn"], "git_node": "b073475e9fc14e67ea15086260645c343089dfdf", "git_parents": ["048a4d26f24981e3e6b4a44861a4c7a1e6a95ef4"], "node": "32fdd0ce87f81561f0ca44cfe47a5d594a2a403a", "parents": ["3c99f5835ccf17259e00aa542a2c786b17805da6"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2019353: Perform state-checking before comparison against last created description. r=dbaker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314158\n", "files": ["dom/media/webrtc/jsep/JsepSession.h", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/tests/mochitests/test_peerConnection_setLocalAnswerInHaveLocalOffer.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_setLocalAnswerInStable.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_setLocalOfferInHaveRemoteOffer.html", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "testing/web-platform/meta/webrtc/RTCPeerConnection-setLocalDescription-answer.html.ini"], "git_node": "4c0077bfd1d9f19528831c89d4b778be5728b9ce", "git_parents": ["b073475e9fc14e67ea15086260645c343089dfdf"], "node": "5ff4aa9cc8ecf5b3baec7b1e10a45c0806a1a96d", "parents": ["32fdd0ce87f81561f0ca44cfe47a5d594a2a403a"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1814460: Surface RTCError for SCTP failures. r=mjf,webidl,saschanaz,dom-worker-reviewers,asuth\n\n*Lots* of hops involved in plumbing that error through.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312838\n", "files": ["dom/media/webrtc/jsapi/RTCDataChannel.cpp", "dom/media/webrtc/jsapi/RTCDataChannel.h", "dom/webidl/RTCError.webidl", "dom/webidl/RTCErrorEvent.webidl", "dom/workers/test/test_worker_interfaces.js", "netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannel.h", "netwerk/sctp/datachannel/DataChannelDcSctp.cpp", "testing/web-platform/meta/webrtc/RTCDataChannel-close.html.ini"], "git_node": "7ef270ad6a9010acbcc4c842bde5cd4c40319261", "git_parents": ["4c0077bfd1d9f19528831c89d4b778be5728b9ce"], "node": "8211d03631e38d44a092cb26302463b4fed123b5", "parents": ["5ff4aa9cc8ecf5b3baec7b1e10a45c0806a1a96d"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2058995 - Don't call process_sibling_invalidations when there are no sibling invalidations. r=firefox-style-system-reviewers,dshin\n\ninvalidate_child calls it for every element it walks, and with an empty\nlist it builds and drains a SmallVec to do nothing. invalidate_siblings\nalready checks this before its loop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314357\n", "files": ["servo/components/style/invalidation/element/invalidator.rs"], "git_node": "69eaab2ca3c1a77417ca426ad88f5de73ac1028f", "git_parents": ["7ef270ad6a9010acbcc4c842bde5cd4c40319261"], "node": "05647a025d2c8f5c1a1c81d5ae939cd4689ecdb4", "parents": ["8211d03631e38d44a092cb26302463b4fed123b5"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053579 - avoid DescendingSeqNumComp\u003cuint16_t\u003e as comparator in std::set. r=bwc\n\nThis is a combined cherry-pick of upstream libwebrtc bf6f744d19, 5ecea90550,\n6395da1ed7.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bf6f744d19a84a7d0c3f5acbc844123a8197165a\n       Check RTP sequence number order when assembling H264 frame in PacketBuffer\n\n       PacketBuffer::buffer_ slots can be re-used by packets with with\n       different sequence numbers when their difference is multiple of\n       buffer_.size()\n\n       Non-H264 code path validates RTP sequence numbers continuity in\n       `PotentialNewFrame` helper, H264 code path missed such check as the new\n       test demonstrate.\n\n       Bug: chromium:537233963\n       Change-Id: I6af0f52bfcb3a4437450dffcece85bee7ce172cd\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/490840\n       Reviewed-by: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n       Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#48222}\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5ecea90550816628fa124e7cf55f4cdbc5aa4a7e\n       In PacketBuffer use helper to find packet slot in the buffer\n\n       This is a preparation for using unwrapped int64_t instead of wrapped\n       uint16_t RTP sequence number in PacketBuffer. Using modular works when\n       sequence number is unsigned but produces incorrect result when signed\n       sequence number happens to be negative.\n\n       Bug: chromium:537233963\n       Change-Id: I515cb7441d052a2823eee4891bb4e17b254d602f\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/491920\n       Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n       Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#48231}\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6395da1ed7da9f3a8d97475c4e8db722d9415e6f\n       Use unwrappred RTP sequence numbers in PacketBuffer\n\n       Thus avoid brittle DescendingSeqNumComp\u003cuint16_t\u003e as comparator in set.\n       Such comparator lacks some properties like transitivity making it\n       dangerous to use with the std::set\n\n       Bug: chromium:537233963\n       Change-Id: I400b423ab3f0d557219d459752e00d211fd97450\n       Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/491041\n       Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n       Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n       Cr-Commit-Position: refs/heads/main@{#48232}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315045\n", "files": ["third_party/libwebrtc/api/video/rtp_video_frame_assembler.cc", "third_party/libwebrtc/module