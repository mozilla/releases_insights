va/org/mozilla/fenix/tabgroups/ExpandedTabGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayout.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ExpandedTabGroupTest.kt"], "git_node": "8b7e0f2e81a1f4a3aa8c1e02e2d6d697eaa99cac", "git_parents": ["1c2c6dc2343ffd4d9a778ec01a50b0d52b639ec4"], "node": "f3ebd8c560f1eb696af3f43ca8b36ab36f0d5c75", "parents": ["4adcead6362e8afbf70d4824fa476a9064d1bf21"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060006 - Fix stale .rst documentation links after the Markdown conversion. r=jdescottes,chumphreys\n\nThe documentation was converted from reStructuredText to Markdown, but a\nnumber of intra-tree links still pointed at .rst targets, so Sphinx could\nnot resolve them. Point them at the .md files instead, covering both\ninline links and reference-style link definitions.\n\nAlso fix three targets that were wrong beyond the extension:\n - the scalars page moved under telemetry/obsolete/\n - the Browser Console anchor is browser-console-command-line\n - the Marionette index anchor is lowercase 'communication'\n\nThis clears 98 'myst cross-reference target not found' warnings from\n./mach doc (1003 -\u003e 905).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315853\n", "files": ["browser/docs/CategoryManagerIndirection.md", "browser/docs/FrontendCodeReviewBestPractices.md", "browser/docs/how_to/add_preview_strings.md", "browser/docs/how_to/template.md", "docs/code-quality/typescript/index.md", "docs/contributing/ai-coding.md", "docs/performance/Benchmarking.md", "docs/performance/automated_performance_testing_and_sheriffing.md", "docs/performance/index.md", "docs/performance/memory/heap_scan_mode.md", "docs/performance/memory/refcount_tracing_and_balancing.md", "docs/performance/power_profiling_overview.md", "docs/performance/tools_power_rapl.md", "docs/testing-rust-code/index.md", "docs/writing-rust-code/index.md", "docs/writing-rust-code/xpcom.md", "ipc/docs/proc_shutdown.md", "js/src/doc/feature_checklist.md", "js/src/doc/hacking_tips.md", "js/src/doc/use_counter.md", "mobile/android/docs/geckoview/contributor/translations-toolkit-to-fenix.md", "remote/doc/Building.md", "remote/doc/Testing.md", "remote/doc/marionette/Building.md", "remote/doc/marionette/Contributing.md", "remote/doc/marionette/Debugging.md", "remote/doc/marionette/NewContributors.md", "remote/doc/marionette/Prefs.md", "remote/doc/marionette/Testing.md", "testing/docs/browser-chrome/index.md", "testing/docs/browser-chrome/writing.md", "testing/docs/mochitest-plain/faq.md", "testing/docs/mochitest-plain/index.md", "testing/geckodriver/doc/Bugs.md", "testing/geckodriver/doc/Building.md", "testing/geckodriver/doc/Capabilities.md", "testing/geckodriver/doc/Flags.md", "testing/geckodriver/doc/Testing.md", "toolkit/components/antitracking/docs/bounce-tracking-protection/index.md", "toolkit/components/antitracking/docs/cookie-purging/index.md", "toolkit/components/glean/docs/dev/ipc.md", "toolkit/components/glean/docs/dev/style_guide.md", "toolkit/components/glean/docs/user/gifft.md", "toolkit/mozapps/update/docs/Concepts.md", "toolkit/mozapps/update/docs/Debugging.md", "toolkit/mozapps/update/docs/Implementation.md", "toolkit/mozapps/update/docs/MacElevatedUpdate.md"], "git_node": "7c02cc55f016410399fd0a68ffe449598a196e86", "git_parents": ["8b7e0f2e81a1f4a3aa8c1e02e2d6d697eaa99cac"], "node": "4ec17bd12a68cf3831e56dd2a2e51c39022629d8", "parents": ["f3ebd8c560f1eb696af3f43ca8b36ab36f0d5c75"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060237 - Ensure set_profiler_hooks is called before we create the render backend threads. r=gfx-reviewers,jnicol\n\nOtherwise they aren't profiled anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316020\n", "files": ["gfx/webrender_bindings/src/bindings.rs"], "git_node": "3aec55d8ef649cfb5b70dc3e68bc0c78b446396d", "git_parents": ["7c02cc55f016410399fd0a68ffe449598a196e86"], "node": "6ef8a0d02d53fc4c2e097e4746cb3ef340fcac3c", "parents": ["4ec17bd12a68cf3831e56dd2a2e51c39022629d8"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060174 - Migrate deleteSavedAddressTest UI test to the efficiency framework r=jajohnson\n\nConverted the deleteSavedAddressTest UI test to the efficiency framework.\n\nThe new UI test successfully passed 50x on Firebase.  [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=74553  | try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=6dead8be34e17f00716e80540af17dade2c089d2  | try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316013\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/AddressAutofillTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsAutofillSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/AddressAutofillTest.kt"], "git_node": "0fc63be95d23b86758935d30cf59602f1f52309b", "git_parents": ["3aec55d8ef649cfb5b70dc3e68bc0c78b446396d"], "node": "480a3522b98c661932fc58b15f3d1809922b1245", "parents": ["6ef8a0d02d53fc4c2e097e4746cb3ef340fcac3c"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2060217 - Migrate verifyMainMenuTranslationButtonFunctionalityTest UI test to the efficiency framework r=jajohnson\n\nThe UI test successfully passed 50x on Fireabse \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316023\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/TranslationsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/TranslationsTest.kt"], "git_node": "2bb4da5da396c90a69ea20f004ed5a6d2eccf3d5", "git_parents": ["0fc63be95d23b86758935d30cf59602f1f52309b"], "node": "c44bf44af88ddc7f2e994230e8161786219d0c52", "parents": ["480a3522b98c661932fc58b15f3d1809922b1245"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052068 - fix moz-checkbox vertical alignment on windows r=akulyk,desktop-theme-reviewers,Itiel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315296\n", "files": ["toolkit/content/widgets/moz-checkbox/moz-checkbox-icon.svg", "toolkit/content/widgets/moz-input-common.css"], "git_node": "7325e5b8e3d6a963f34190c1808545b0443c06d1", "git_parents": ["2bb4da5da396c90a69ea20f004ed5a6d2eccf3d5"], "node": "fcd6780a5943b8147f3912d5edadda4339fa2afa", "parents": ["c44bf44af88ddc7f2e994230e8161786219d0c52"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059801 - Stop using PartnerLinkAttribution in UrlbarInput. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315666\n", "files": ["browser/components/urlbar/UrlbarProviderTopSites.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/tests/browser/browser.toml", "browser/components/urlbar/tests/browser/browser_top_sites_attribution.js"], "git_node": "f8c6b209587d137b52bbfd2a9e1869b7f19a5dbf", "git_parents": ["7325e5b8e3d6a963f34190c1808545b0443c06d1"], "node": "b62e14e6dd724c08cbac94fd88da75e6edf09c60", "parents": ["fcd6780a5943b8147f3912d5edadda4339fa2afa"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "