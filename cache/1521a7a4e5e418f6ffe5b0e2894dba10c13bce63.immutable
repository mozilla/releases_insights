ts": ["aa024aa8d2fd92e0af198fc477cbeaa811af7ebd"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2053153 - Only check for high surrogates when intending to avoid split pair. r=mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314632\n", "files": ["parser/expat/13_high_surrogate_mask.patch", "parser/expat/expat/lib/xmltok.c", "parser/expat/moz.yaml"], "git_node": "937eecc494ff3bdd229a26ff89c5da0794ca61a2", "git_parents": ["eb7d807e97c863c06cc89aff563662ddb8e2378f"], "node": "6306c4549ab3f9862f6af7b4dc962c7d59cb198d", "parents": ["ee7ca2efbf72c1a4067b8f63ceed987915bdbb8f"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060407 - Update PDF.js to b4ba666b0c917b56acc05d3305e53958ee8c11de r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316138\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "adc59d141538d065ed8fa5cfc20c663103c81bdc", "git_parents": ["937eecc494ff3bdd229a26ff89c5da0794ca61a2"], "node": "94760f1d69b32a8a4ea78c97beaec3a734eb4ba0", "parents": ["6306c4549ab3f9862f6af7b4dc962c7d59cb198d"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2057337 - Use android_res_nresult in PlatformDNSAndroid r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313842\n", "files": ["netwerk/dns/PlatformDNSAndroid.cpp"], "git_node": "4bf26c01d66c989c012937046a0ef8f06072eae9", "git_parents": ["adc59d141538d065ed8fa5cfc20c663103c81bdc"], "node": "a26b2e7ec393c20f6cf4c6614aefa30e2a36b98d", "parents": ["94760f1d69b32a8a4ea78c97beaec3a734eb4ba0"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2015199 test - Add crashtest. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315939\n", "files": ["parser/htmlparser/tests/crashtests/2015199-1.html", "parser/htmlparser/tests/crashtests/crashtests.list"], "git_node": "cd3f9dea827ea23c7769b1a12ccd6fe117e6ceed", "git_parents": ["4bf26c01d66c989c012937046a0ef8f06072eae9"], "node": "3291fb9527a05957b5c6bc69436f92672ad7464c", "parents": ["a26b2e7ec393c20f6cf4c6614aefa30e2a36b98d"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060121 - Fix concurrent rope marking r=sfink\n\nAlso check for ongoing flattening when checking rope flags during marking.\n\nWe have to set a flattening flag on the rope's root node for this to work, but\nthis flag is never checked by flattening and is overwritten at the end.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316004\n", "files": ["js/src/gc/TraceMethods-inl.h", "js/src/vm/StringType.cpp"], "git_node": "af9b8f08699c3ad1abf77f7b8121f5a8b07c15fa", "git_parents": ["cd3f9dea827ea23c7769b1a12ccd6fe117e6ceed"], "node": "cdd53138e1c8ac62c5c312f042c2447c3f9f50ed", "parents": ["3291fb9527a05957b5c6bc69436f92672ad7464c"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060184 - Fix concurrent marking zeal mode r=sfink\n\nThe patch allows enabling concurrent marking zeal mode before concurrent\nmarking is enabled, as happens when the zeal mode is enabled from the\nenvironment options and concurrent marking is enabled by a command line flag.\nThe zeal mode does nothing until concurrent marking is enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316003\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug-1916362.js"], "git_node": "72f73c6e2594b99b8804f6e084a20f8e6f83a21c", "git_parents": ["af9b8f08699c3ad1abf77f7b8121f5a8b07c15fa"], "node": "6d49fc080aeae4d2b41fe75ef8cc6013e9114267", "parents": ["cdd53138e1c8ac62c5c312f042c2447c3f9f50ed"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057457 - Ensure we don't lose atom references for symbol weak edges r=sfink\n\nThe problem is that our efforts to refine the atom references effectively by\ndelaying marking atoms referenced by uncollected zones until after refining the\natom reference bitmaps means that we throw away refernces to live atoms that\nare only weakly referenced by collecting zones.\n\nThis is the same problem we've fixed several times in the weak map marking\ncode.\n\nThe fix adds a common way to handle marking weakly refereneced atoms and uses\nit in both cases. This allows us to remove two previous attempts to patch up\nthis problem. It is similar to what we do for weak map edges: mark weakly\nreferenced atoms that are referenced by uncollected zones eagarly. Thes means\nthey are marked when we refine the reference bitmaps for collected zones so\nexisting references are preserved and not thrown away.\n\nThe patch does the marking manually since we can be in the sweep state by this\ntime and the marking machinery doesn't allow any more marking.\n\nThis moves updating the reference bitmaps until the end of sweeping so that it\ncan see marking done by tracing weak edges.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316060\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/GCRuntime.h", "js/src/gc/Marking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/WeakMap-inl.h", "js/src/gc/WeakMap.cpp", "js/src/jit-test/tests/gc/bug-1997896.js"], "git_node": "e147abd1835914d11ca6bdf9ab3f2e15688f3053", "git_parents": ["72f73c6e2594b99b8804f6e084a20f8e6f83a21c"], "node": "f0e9602ade0c4eb405765a09a9859bf2a04fe183", "parents": ["6d49fc080aeae4d2b41fe75ef8cc6013e9114267"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013551 - Add test r=spidermonkey-reviewers,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281450\n", "files": ["js/src/jit-test/tests/gc/bug-2013551.js"], "git_node": "a32e9f838e7732173624f69275cc430bf441ccc8", "git_parents": ["e147abd1835914d11ca6bdf9ab3f2e15688f3053"], "node": "95aed3b49f626b9387862cedcb7be954b58fe9e0", "parents": ["f0e9602ade0c4eb405765a09a9859bf2a04fe183"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2013599 - Add test r=spidermonkey-reviewers,iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D281478\n", "files": ["js/src/jit-test/tests/modules/bug-2013599.js"], "git_node": "6235915115cf3c049db6422c635a713eb3a21600", "git_parents": ["a32e9f838e7732173624f69275cc430bf441ccc8"], "node": "064dac34b4babbee8fc1dd1d8ebd1e43162667d0", "parents": ["95aed3b49f626b9387862cedcb7be954b58fe9e0"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2015084 - Add testcase r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282666\n", "files": ["js/src/jit-test/tests/gc/bug-2015084.js"], "git_node": "317198c075601ddab2d46561aaa63c28ced8e9e1", "git_parents": ["6235915115cf3c049db6422c635a713eb3a21600"], "node": "1b16038a4654a7ca258ea28a0db58867beab2de9", "parents": ["064dac34b4babbee8fc1dd1d8ebd1e43162667d0"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2017622 - Add testcase r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283902\n", "files": ["js/src/jit-test/tests/gc/bug-2017622.js"], "git_node": "8cdb72ef8dcb0b30694bb1f68f4d4e6b5a1f7c18", "git_parents": ["317198c075601ddab2d46561aaa63c28ced8e9e1"], "node": "308a28c21bd3d6724e3e9d86863267786f6577cb", "parents": ["1b16038a4654a7ca258ea28a0db58867beab2de9"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2015084 - Add testcase r=sfink\" for causing jit-proc failures in bug-2015084.js.\n\nThis reverts commit 317198c075601ddab2d46561aaa63c28ced8e9e1.\n", "files": ["js/src/jit-test/tests/gc/bug-2015084.js"], "git_node": "5e3ae3b10ca32a8619079f09b5e6a7c25e2fdd35", "git_parents": ["8cdb72ef8dcb0b30694bb1f68f4d4e6b5a1f7c18"], "node": "7c06165ae50f70b758d75e4d6ec4f4c6a5531b38", "parents": ["308a28c21bd3d6724e3e9d86863267786f6577cb"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060184 - Fix concurrent marking zeal mode r=sfink\" for causing sm bustages.\n\nThis reverts commit 72f73c6e2594b99b8804f6e084a20f8e6f83a21c.\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug-1916362.js"], "git_node": "63d399a2221c822e5118c757fbad1d076ad16c85", "git_parents": ["5e3ae3b10ca32a8619079f09b5e6a7c25e2fdd35"], "node": "afbd75970c9b0aa40a154b5d56bd4eed20fb91f1", "parents": ["7c06165ae50f70b758d75e4d6ec4f4c6a5531b38"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2054010 - Convert free-text profiler marker fields to unique strings so URLs get sanitized r=mstange,profiler-reviewers,joel\n\nThe text, flow text, and log markers all carry developer-provided\nfree-text fields that might embed URLs. These fields were declared with\nMS::Format::String, which the profiler front-end\ndoesn't sanitize.\n\nSwitch these fields to MS::Format::UniqueString so their contents are\nadded to the profile's shared string table. The front-end runs\nremoveURLs over the whole string table when sanitizing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311475\n", "files": ["browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "mozglue/baseprofiler/public/BaseProfilerMarkers.h", "mozglue/tests/TestBaseProfiler.cpp", "toolkit/components/backgroundtasks/tests/browser/browser_xpcom_graph_wait.js", "toolkit/components/telemetry/tests/unit/test_UserInteraction_annotations.js", "tools/profiler/public/FlowMarkers.h", "tools/profiler/tests/gtest/GeckoProfiler.cpp", "tools/profiler/tests/xpcshell/test_addProfilerMarker.js", "xpcom/base/Logging.cpp"], "git_node": "155a47cbb7728bcb98a956c4076a313105d87e17", "git_parents": ["63d399a2221c822e5118c757fbad1d076ad16c85"], "node": "0f346426066a12d60e3a874e6c2a9f8c45294e59", "parents": ["afbd75970c9b0aa40a154b5d56bd4eed20fb91f1"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060381 - Remove CHROME_STATUSBAR. r=smaug,sthompson,vhilla\n\nIt's unused in Firefox (nothing uses chrome-statusbar).\n\nThunderbird has some but never disables it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315897\n", "files": ["browser/components/extensions/test/browser/browser_ext_windows_create.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_restored_window_features.js", "dom/base/BarProps.cpp", "dom/tests/browser/browser_test_toolbars_visibility.js", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/windowwatcher/nsWindowWatcher.cpp", "toolkit/components/windowwatcher/test/browser_new_content_window_chromeflags.js", "toolkit/components/windowwatcher/test/head.js", "toolkit/themes/shared/global-shared.css", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsAppShellService.cpp"], "git_node": "cc2423df83964232fa456098a0dc3a283a18dad6", "git_parents": ["155a47cbb7728bcb98a956c4076a313105d87e17"], "node": "6a81eb1596510232ac8d81c779bc318181e247e6", "parents": ["0f346426066a12d60e3a874e6c2a9f8c45294e59"], "tags": []}, {"author": "elkal98 \u003ckhalid.alhaddad98@gmail.com\u003e", "branch": "default", "desc": "Bug 2041335 - Stop using enterNestedEventLoop in webdriver bidi debugging module. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316008\n", "files": ["remote/webdriver-bidi/modules/windowglobal/moz/debugging.sys.mjs"], "git_node": "02f01a7f850286a5cf4bf52a3335d5c0f11581a3", "git_parents": ["cc2423df83964232fa456098a0dc3a283a18dad6"], "node": "0cfc4705e5c6886eeffd5f6d4b35fce87cc84f22", "parents": ["6a81eb1596510232ac8d81c779bc318181e247e6"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059635 - [Nova] Fix the urlbar top-pick icon border radius. r=dao,desktop-theme-reviewers,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315522\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "ba1b68685c9530ef03aefde1740d979f83caf00a", "git_parents": ["02f01a7f850286a5cf4bf52a3335d5c0f11581a3"], "node": "8b1b36806e54473e7662427a032878a8de2968cc", "parents": ["0cfc4705e5c6886eeffd5f6d4b35fce87cc84f22"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2050056 - Do not enable dohAutoselect when LinkProperties#isPrivateDnsActive() r=necko-reviewers,geckoview-reviewers,kershaw,owlish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308551\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "netwerk/base/nsINetworkLinkService.idl", "netwerk/dns/nsDNSService2.cpp", "netwerk/dns/nsITRRSkipReason.idl", "netwerk/docs/dns/trr-skip-reasons.md", "netwerk/system/android/nsAndroidNetworkLinkService.cpp", "toolkit/components/doh/DoHController.sys.mjs", "toolkit/components/doh/DoHHeuristics.sys.mjs", "toolkit/components/doh/metrics.yaml", "toolkit/components/doh/test/browser/browser_platformDetection.js"], "git_node": "09beeef2572509c938ab926753a33f76c61e5529", "git_parents": ["ba1b68685c9530ef03aefde1740d979f83caf00a"], "node": "5f63e91a5376a8b561349062c4c28ef1e8bfd717", "parents": ["8b1b36806e54473e7662427a032878a8de2968cc"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2050056 - Track Android private DNS (DoT) state asynchronously via a default NetworkCallback. r=necko-reviewers,geckoview-reviewers,kershaw,owlish\n\nLinkProperties#isPrivateDnsActive() is not a stable value: it changes\nas the default network comes and goes, and in particular it flips while\nthe private DNS server name is being resolved (SVCB queries in\nprogress). Reading it synchronously on demand would therefore risk\nobserving a transient or stale value, and nothing would prompt a\nre-read once it settles, since a private-DNS transition on an otherwise\nunchanged network does not produce a CONNECTIVITY_ACTION broadcast.\n\nInstead, register a default-network callback in GeckoNetworkManager and\nread the value off the LinkProperties delivered to\nonLinkPropertiesChanged, so the cached state is always current. The\nresult is kept in a volatile field (written from the callback thread,\nread from the Gecko thread) and exposed to Gecko via a WrapForJNI\ngetter. When the state changes we reuse the existing onStatusChanged\n(\"changed\") path to notify Gecko, so any network-dependent heuristics\nare re-evaluated against the new value.\n\nThe callback is registered/unregistered alongside the existing\nconnectivity BroadcastReceiver and guarded against double-registration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308722\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoNetworkManager.java", "netwerk/system/android/nsAndroidNetworkLinkService.cpp"], "git_node": "a32a1c87dabbb0280d087d0154f8c4876601ae6f", "git_parents": ["09beeef2572509c938ab926753a33f76c61e5529"], "node": "f86b27d6a485b5ee5314d415c15e79a12ab6f60e", "parents": ["5f63e91a5376a8b561349062c4c28ef1e8bfd717"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059207 - Honor idExtension partition in the No-Vary-Search cache lookup, r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315290\n", "files": ["netwerk/cache2/CacheStorageService.cpp"], "git_node": "1ad2adfbb763ce32ec9f873afd663940721de81a", "git_parents": ["a32a1c87dabbb0280d087d0154f8c4876601ae6f"], "node": "e4fae9713b212c4632c1f196a7b769eb3ed44d17", "parents": ["f86b27d6a485b5ee5314d415c15e79a12ab6f60e"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add RemoteMediaManagerChild::EnsureCodecSupportFor for async HW codec support queries. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304784\n", "files": ["dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/ipc/RemoteMediaManagerChild.h"], "git_node": "56cd88aeb93831e8c85c7051aaf2304e46445f7e", "git_parents": ["1ad2adfbb763ce32ec9f873afd663940721de81a"], "node": "616c57a70de6b2e50eb58976e55cfcc6dee8e934", "parents": ["e4fae9713b212c4632c1f196a7b769eb3ed44d17"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add cached async codec-support path for MediaCapabilities decode behind a pref. r=media-playback-reviewers,alwu\n\nAdd RemoteMediaManagerChild::EnsureCodecSupportFor-backed async support queries\n(PDMFactory::SupportsAsync / PDMFactorySupport::IsSupportedAsync) and use them\nfor the non-WebRTC MediaCapabilities decode paths, gated by the new\nmedia.mediacapabilities.codec-support-cache.enabled pref (default false). When\nthe pref is disabled the original behaviour is used: creating a decoder and\nquerying it for video, and a synchronous PDMFactorySupport query for audio.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304785\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/ipc/RemoteDecoderModule.h", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/mediacapabilities/MediaCapabilities.h", "dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/PDMFactory.h", "dom/media/platforms/PDMFactorySupport.cpp", "dom/media/platforms/PDMFactorySupport.h", "dom/media/platforms/PlatformDecoderModule.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "e44f785f3e1d5ef1d03531251bb50009162f239f", "git_parents": ["56cd88aeb93831e8c85c7051aaf2304e46445f7e"], "node": "6ee34560f04d3978c37803a1314d4b2e03179482", "parents": ["616c57a70de6b2e50eb58976e55cfcc6dee8e934"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add moz-WPT for new media-capabilities supports-cache pref. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309551\n", "files": ["testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/meta/media-capabilities/encodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/tests/media-capabilities/decodingInfo-api-modes.any.js", "testing/web-platform/mozilla/tests/media-capabilities/encodingInfo-api-modes.any.js"], "git_node": "598f0bd89a7a698b10520c21b85b205cb0be5b77", "git_parents": ["e44f785f3e1d5ef1d03531251bb50009162f239f"], "node": "1e7cc002c5f00dbd698392e915e0fbeea4318824", "parents": ["6ee34560f04d3978c37803a1314d4b2e03179482"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057938 - [Nova] Fix urlbar and legacy search bar focus ring color. r=dao,extension-reviewers,desktop-theme-reviewers,urlbar-reviewers,rpl\n\n* Replace uses of `--focus-outline-color` with `--toolbar-field-border-color-focus`,\n  including the legacy search bar's outline (`browser.search.widget.new = false`)\n\n* Update the test so it checks the border rather than the outline when Nova is\n  enabled, since bug 2053381 changed the focus ring from an outline to a border\n  in Nova when the view is closed\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315084\n", "files": ["browser/themes/shared/urlbar-searchbar.css", "toolkit/components/extensions/test/browser/browser.toml", "toolkit/components/extensions/test/browser/browser_ext_themes_toolbar_fields_focus.js"], "git_node": "46cc84554fb4f40b7cd8378ec42bd8593e2863cb", "git_parents": ["598f0bd89a7a698b10520c21b85b205cb0be5b77"], "node": "53a4664f032d50e106047a509ede72f3778925b3", "parents": ["1e7cc002c5f00dbd698392e915e0fbeea4318824"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2058622, validate selected options entries, r=jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314926\n", "files": ["dom/html/HTMLSelectElement.cpp"], "git_node": "38b2a5edc74052d013e5fc1f1474a36cc5a72d6a", "git_parents": ["46cc84554fb4f40b7cd8378ec42bd8593e2863cb"], "node": "55c7c346df3ac34c9b0c6136092173a8ed923275", "parents": ["53a4664f032d50e106047a509ede72f3778925b3"], "tags": []}, {"author": "tobypilling \u003ctoby@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2059182 - Fix Thunderbird default theme Fluent localization. r=rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315131\n", "files": ["toolkit/mozapps/extensions/internal/ThemesBundledLocalization.sys.mjs", "toolkit/mozapps/extensions/test/browser/browser_verify_l10n_strings.js"], "git_node": "43c75e4b6fbdf12c2dd3b1694cab0a104b6fbdba", "git_parents": ["38b2a5edc74052d013e5fc1f1474a36cc5a72d6a"], "node": "d358251311cb38f0ec9c00d19303a532086f0e01", "parents": ["55c7c346df3ac34c9b0c6136092173a8ed923275"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054381 - Fix ConcurrentConnection LOCKED race on Places startup. r=places-reviewers,daisuke\n\nIn the parent process, ConcurrentConnection opening places.sqlite concurrently\nwith EnsureConnection() causes WAL-mode lock contention (SQLITE_LOCKED or\nSQLITE_IOERR), which bypasses busy_timeout. Defer the CC open until\nTOPIC_PLACES_INIT_COMPLETE, which fires only after the main connection is\nestablished. A 10s fallback timer handles the case where the notification\nnever arrives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313466\n", "files": ["toolkit/components/places/ConcurrentConnection.cpp", "toolkit/components/places/ConcurrentConnection.h", "toolkit/components/places/Database.cpp", "toolkit/components/places/Database.h", "toolkit/components/places/tests/gtest/test_ConcurrentConnection.cpp"], "git_node": "b10910c797b082225747c7f5375603947cf3adac", "git_parents": ["43c75e4b6fbdf12c2dd3b1694cab0a104b6fbdba"], "node": "d6819df168823809ded537abc2708d35aa86a543", "parents": ["d358251311cb38f0ec9c00d19303a532086f0e01"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@ledru.info\u003e", "branch": "default", "desc": "Bug 2060259 - mots.yaml: replace removed view/ with layout/base/ and layout/painting/ r=shtrom DONTBUILD\n\nThe view/ top-level directory no longer exists in the Firefox repository.\nThe View System code was absorbed into layout/base/ and layout/painting/.\nUpdate the 'Core: View System' module includes accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316095\n", "files": ["mots.yaml"], "git_node": "ea5bd08efcb989ca7b737fe47842fd9b082e686e", "git_parents": ["b10910c797b082225747c7f5375603947cf3adac"], "node": "e3f098c4ad44a9923909eb2dab05790ea070bcc9", "parents": ["d6819df168823809ded537abc2708d35aa86a543"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053432 - Detect Android 17 Local Network Protection blocking TCP connections. r=necko-reviewers,valentin\n\nAndroid 17 enforces OS-level Local Network Protection: a TCP connect() to\na local-network address is silently blocked unless the app holds\nACCESS_LOCAL_NETWORK/NEARBY_DEVICES (see\nhttps://developer.android.com/privacy-and-security/local-network-permission#strategy-by-use-case).\nFirefox's own LNA prompt only triggers after a successful connect, so this\nOS-level block never reaches that check and the load just fails with no\npath forward for the user.\n\nAdd an Android-only helper, netwerk/system/android/AndroidNetworkBlockedReason.{h,cpp},\nthat asks the OS directly via android_getnetworkblockedreason()\n(dlsym-resolved against libandroid.so, since the NDK doesn't declare it\nyet) whether a failed TCP connect in nsSocketTransport2.cpp was caused by\nthis block, failing it with a new, distinct\nNS_ERROR_OS_LOCAL_NETWORK_ACCESS_DENIED. A follow-up commit teaches\nnsDocShell and GeckoView to recognize it.\n\nQUIC/HTTP3 isn't detected separately: per Android's guidance (same link\nabove), a blocked UDP send just returns EPERM with no reliable way to\nattribute it specifically to this block, and necko already retries a\nfailed HTTP3 connection over TCP, which hits this same detection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315953\n", "files": ["netwerk/base/moz.build", "netwerk/base/nsSocketTransport2.cpp", "netwerk/system/android/AndroidNetworkBlockedReason.cpp", "netwerk/system/android/AndroidNetworkBlockedReason.h", "netwerk/system/android/moz.build", "netwerk/test/gtest/TestSocketTransportService.cpp", "netwerk/test/gtest/moz.build", "xpcom/base/ErrorList.py"], "git_node": "349363282806ab38756c827feeac9fb99cb55f4d", "git_parents": ["ea5bd08efcb989ca7b737fe47842fd9b082e686e"], "node": "fe5cf7557299cce0ef6f87edf3fd7e8e210b18ff", "parents": ["e3f098c4ad44a9923909eb2dab05790ea070bcc9"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053432 - Surface OS-level Local Network Protection failures to GeckoView's onLoadError. r=dom-core-reviewers,smaug\n\nNS_ERROR_OS_LOCAL_NETWORK_ACCESS_DENIED was silently rewritten to NS_OK\nbefore reaching nsDocShell's error handling, so GeckoView's onLoadError\nnever fired for it.\n\nAdd it to FilterStatusForErrorPage's allowlist and to DisplayLoadError's\nclassification (temporarily grouped with NS_ERROR_NET_RESET, see TODO).\nBug 2057481 will intercept it in GeckoEngineSession.onLoadError()\n(android-components) to prompt for the nearby devices permission and\nreload on grant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315954\n", "files": ["docshell/base/moz.build", "docshell/base/nsDocShell.cpp", "docshell/base/test/gtest/TestFilterStatusForErrorPage.cpp", "docshell/base/test/gtest/moz.build"], "git_node": "0d8b5ee3d4b9fbed415f788857cde22e423082b0", "git_parents": ["349363282806ab38756c827feeac9fb99cb55f4d"], "node": "131b3e709784eb3ba25bedbda6ff79598e932b46", "parents": ["fe5cf7557299cce0ef6f87edf3fd7e8e210b18ff"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2053432: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["netwerk/system/android/AndroidNetworkBlockedReason.cpp"], "git_node": "c9c6f9e62eab64871fcaaaec3ecec4b30f791043", "git_parents": ["0d8b5ee3d4b9fbed415f788857cde22e423082b0"], "node": "554d1564abe00f78556ce2a4e07933fcbb961d3f", "parents": ["131b3e709784eb3ba25bedbda6ff79598e932b46"], "tags": []}, {"author": "Stephen Chenney \u003cschenney@chromium.org\u003e", "branch": "default", "desc": "Bug 2060083 [wpt PR 61681] - [HiC] Invalidate body background images in iframes, a=testonly\n\nAutomatic update from web-platform-tests\n[HiC] Invalidate body background images in iframes\n\nWhen a iframe with a background image specified for the body (or\nhtml) is moved into a canvas subtree, the image is not invalidated\nand a cross-origin image may still be painted into the canvas. Fix\nthis by invalidating the display item clients associated with the\nroot background.\n\nBug: 532914190\nChange-Id: I982af5f176d648472f8453e911cd4c32588c5f2a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8181706\nCommit-Queue: Stephen Chenney \u003cschenney@chromium.org\u003e\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1672440}\n\n--\n\nwpt-commits: 34174a4a37b1c0b8570fd816600191aaa7a5d7f7\nwpt-pr: 61681\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/background-image-in-iframe-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/background-image-in-iframe-moved-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/background-image-on-body-in-iframe-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/background-image-on-body-in-iframe-moved-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/background-image-on-html-in-iframe-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/background-image-on-html-in-iframe-moved-ignored.tentative.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/support/subframe-cross-origin-background-image-on-body.https.sub.html", "testing/web-platform/tests/html/canvas/element/manual/draw-element-image/privacy/support/subframe-cross-origin-background-image-on-html.https.sub.html"], "git_node": "1767621cda11d3140521aafb6f03577b2e19eae1", "git_parents": ["c9c6f9e62eab64871fcaaaec3ecec4b30f791043"], "node": "51bb1f74fc034d9c875df0c2ace3d5feea83cfcb", "parents": ["554d1564abe00f78556ce2a4e07933fcbb961d3f"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060083 [wpt PR 61681] - Update wpt metad