rowser/themes/shared/sharePanel.css"], "git_node": "fd4104f8e0bd1b5822777a9a2152c30734f0e51e", "git_parents": ["15f29ddf7647febc65ff5d7f2232196a4ff40983"], "node": "0282ae10d67f2dc6151c8d4292967a19cc8a03af", "parents": ["a9431b59afb92c557d24edd096830e712d723297"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061876 - Add count-up celebration to the Privacy New Tab widget. r=fchasen\n\nPer HNT-2845/Figma, the Privacy widget should react when its blocked-tracker\ncount moves: a brief sparkle plus a count-up on any +10, and a longer, denser\nsparkle for the bigger earned moments. Today the number changes silently.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317213\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/_Privacy.scss", "browser/extensions/newtab/content-src/components/Widgets/WidgetCelebration.jsx", "browser/extensions/newtab/content-src/components/Widgets/_WidgetCelebration.scss", "browser/extensions/newtab/content-src/components/Widgets/useCountUp.jsx", "browser/extensions/newtab/content-src/components/Widgets/usePageVisible.jsx", "browser/extensions/newtab/content-src/components/Widgets/useWidgetCelebration.jsx", "browser/extensions/newtab/data/content/assets/kit-circle-animated.svg", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/Widgets/PrivacyFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/useCountUp.test.jsx", "browser/extensions/newtab/test/xpcshell/test_PrivacyFeed.js"], "git_node": "b8cae7088e7252ef83ab8358432f48ac4a55aa98", "git_parents": ["fd4104f8e0bd1b5822777a9a2152c30734f0e51e"], "node": "8bf13600fdd5a14b243ab46afdd9d3d8dff6a75d", "parents": ["0282ae10d67f2dc6151c8d4292967a19cc8a03af"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2059809 - Add a perf-reftest. r=firefox-style-system-reviewers,perftest-reviewers,dshin,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317923\n", "files": ["testing/talos/talos/tests/perf-reftest/nth-edge-child-1.html", "testing/talos/talos/tests/perf-reftest/nth-edge-child-ref.html", "testing/talos/talos/tests/perf-reftest/perf_reftest.manifest"], "git_node": "6b71b64ca07b8a1326778558f4f13d61c20e6f8f", "git_parents": ["b8cae7088e7252ef83ab8358432f48ac4a55aa98"], "node": "02f933ba66a444f1b763c426549b77cd6b85ab61", "parents": ["8bf13600fdd5a14b243ab46afdd9d3d8dff6a75d"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2059191 - Add a check for the root-layer-tree instance. r=hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317588\n", "files": ["gfx/layers/apz/src/APZCTreeManager.h", "gfx/layers/ipc/APZCTreeManagerParent.cpp", "gfx/layers/ipc/APZCTreeManagerParent.h"], "git_node": "9f77c02430cc0a14d6a29f24347ebdb74efe1df7", "git_parents": ["6b71b64ca07b8a1326778558f4f13d61c20e6f8f"], "node": "3184df624465259e2dacf3077169a377969f3898", "parents": ["02f933ba66a444f1b763c426549b77cd6b85ab61"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2059192 - Add a check for the root-layer-tree instance. r=hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317604\n", "files": ["gfx/layers/ipc/APZCTreeManagerParent.cpp"], "git_node": "6ea98f2b85c64987a2a86ef0d8e7f1df9856c5b1", "git_parents": ["9f77c02430cc0a14d6a29f24347ebdb74efe1df7"], "node": "74f0ed1f4b46c47c9fc974363590dfae66da421f", "parents": ["3184df624465259e2dacf3077169a377969f3898"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050778 - [Nova] Update tabs and quick actions icons in the urlbar search-mode switcher and move/rename the SVGs. r=daisuke,dao,desktop-theme-reviewers,urlbar-reviewers,maxx\n\nThe point of this revision is to update two icons in the urlbar's search-mode\nswitcher panel:\n\n* Use the open-tabs icon for the tabs local search mode\n* Use the lightning bolt icon for the quick-actions local search mode\n\nPaul made this request, and I got approval from Jane and Ania on the Acorn team\non Slack to make these changes.\n\nIt makes sense to make two further changes:\n\n* Move the open-tabs icon out of the `firefoxview` directory. Urlbar isn't its\n  only external consumer either. `open-tabs` is the name of this icon in the\n  Nova icon library [1]. (I previously made this change in D311672 but ended up\n  abandoning that revision for a simpler one.)\n\n* Rename the lightning-bolt icon so that the name describes what it looks like\n  rather than one way it might be used. `lightning-bolt` is the Nova icon\n  library name.\n\n[1] https://www.figma.com/design/PqfaOcMGbX5liEXTTUzeYX/Nova-Components--Experimental-?node-id=8065-29149&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311982\n", "files": ["browser/components/firefoxview/content/view-opentabs.svg", "browser/components/firefoxview/firefoxview.html", "browser/components/firefoxview/jar.mn", "browser/components/preferences/config/tabs-browsing.mjs", "browser/components/sidebar/browser-sidebar.js", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_localOneOffs_actionText.js", "browser/extensions/newtab/content-src/styles/_icons.scss", "browser/themes/shared/icons/lightning-bolt.svg", "browser/themes/shared/icons/open-tabs.svg", "browser/themes/shared/icons/quickactions.svg", "browser/themes/shared/icons/trending.svg", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "789ce894df7ca957aa12b43fb922667b1f8b1d15", "git_parents": ["6ea98f2b85c64987a2a86ef0d8e7f1df9856c5b1"], "node": "5e9e83d0f78d040eb3df9da6f8182a0db864a0f5", "parents": ["74f0ed1f4b46c47c9fc974363590dfae66da421f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060396 - Make chrome flags immutable. r=vhilla\n\nWe only deal with a couple of these flags anyways. The bar changes could\ntheoretically work, but we don't use them (other than in a test).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316217\n", "files": ["browser/base/content/test/popupNotifications/browser_popupNotification_2.js", "dom/base/BarProps.cpp", "dom/base/BarProps.h", "dom/ipc/BrowserChild.cpp", "toolkit/components/browser/nsIWebBrowserChrome.idl", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/nsAppShellService.cpp", "xpfe/appshell/nsContentTreeOwner.cpp", "xpfe/appshell/nsContentTreeOwner.h", "xpfe/appshell/nsIAppWindow.idl"], "git_node": "71e2267c243c4a2fa62ab03390a2ab4fdee49ac6", "git_parents": ["789ce894df7ca957aa12b43fb922667b1f8b1d15"], "node": "d89dc224aea38b4d10591ccd5c76896dd0d63f2a", "parents": ["5e9e83d0f78d040eb3df9da6f8182a0db864a0f5"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2062115 - [Monitor Agent][FE] Add monitor icon near form title r=yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317867\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitor-icon.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/jar.mn"], "git_node": "e2a4ae425b310a9415360e768daf18ebb21965de", "git_parents": ["71e2267c243c4a2fa62ab03390a2ab4fdee49ac6"], "node": "6334e3e79871a3f4ef5f8fc8430ebe6a2d5b1c0e", "parents": ["d89dc224aea38b4d10591ccd5c76896dd0d63f2a"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056994 - Correct tab hover preview card and thumbnail corner radii to match spec r=desktop-theme-reviewers,tabbrowser-reviewers,niklas,emilio\n\nThe nova tab hover preview used too-large corner radii. The card used --border-radius-xlarge (24px) and the thumbnail used a nova-only override of --border-radius-large (16px).\n\nPer the UX spec, the card should be 16px and the thumbnail 12px. Change the card to --border-radius-large (16px) and drop the redundant nova thumbnail override so it uses the base --border-radius-medium, which resolves to 12px under nova (8px otherwise, unchanged).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313636\n", "files": ["browser/themes/shared/tabbrowser/tab-hover-preview.css"], "git_node": "8d4f297e7481f71d5b3fad7fb84aa8e2f600b4c6", "git_parents": ["e2a4ae425b310a9415360e768daf18ebb21965de"], "node": "3423c34c6221f32067b9117d2c90a5a6d4222c25", "parents": ["6334e3e79871a3f4ef5f8fc8430ebe6a2d5b1c0e"], "tags": []}], "date": 1786506838, "git_changesets": ["99345c6a1e381c41522adce8e7cd49c823145d99", "ff845bb1673e7181650c6e49f5dd023630a09d0a", "50b01df111ae760dee9964992b1bfaa64278b05e", "e99d23fb258f75e2b88ae715847d1d0bb67ab6c9", "b1810fa41e41d639632815054d7ad7a2cb81c54b", "6ad4f1d17c396be61a017272a496add3910e7d4b", "9991d18fdd849843918ab34f343453699e0769a8", "28ea41d95d545fc0f2d10928c0589ca37099364e", "6e3188