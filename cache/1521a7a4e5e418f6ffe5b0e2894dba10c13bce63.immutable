ird_party/rust/neqo-transport/tests/retry.rs", "third_party/rust/neqo-transport/tests/server.rs", "third_party/rust/neqo-udp/.cargo-checksum.json", "third_party/rust/neqo-udp/Cargo.toml", "third_party/rust/neqo-udp/build.rs", "third_party/rust/neqo-udp/src/lib.rs"], "git_node": "6eeb989c1bdd7fdfd13fccbded1093014f74a877", "git_parents": ["1dba15fe7f0add7e3c94ea375928627407f8d62d"], "node": "9b91da0cb4901d7ee1d9a0022d5a73b4a3a6d704", "parents": ["360f162274af88dd8d68d9482caa019c19633426"], "tags": []}, {"author": "tobypilling \u003ctoby@thunderbird.net\u003e", "branch": "default", "desc": "Bug 2056010 - Use a weak dependency for shell_windows enable_tests. r=saschanaz\n\nThe enable_tests feature was strongly enabling the optional shell_windows\ndependency, causing Thunderbird Windows builds with tests enabled to compile\nFirefox-only shell code without the required XPCOM interfaces.\n\nUse Cargo's weak dependency feature syntax so shell_windows/enable_tests is\nenabled only when shell_windows is already part of the crate graph.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312865\n", "files": ["toolkit/library/rust/shared/Cargo.toml"], "git_node": "2ee74017f7ff2a4a9991dd0d5de41206345bac2a", "git_parents": ["6eeb989c1bdd7fdfd13fccbded1093014f74a877"], "node": "f1ebbe0cbdecee9a6e060315f506e007b173e0e9", "parents": ["9b91da0cb4901d7ee1d9a0022d5a73b4a3a6d704"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2053875 - Update generated Typescript declarations. r=saschanaz\n\nAgain this is simply the result of `mach ts build && mach ts update`\nto make next commit's diff cleaner.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312738\n", "files": ["tools/@types/generated/lib.gecko.dom.d.ts", "tools/@types/generated/lib.gecko.nsresult.d.ts", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "8dc9b956b0f4ed94ad2e52b1d086883ae87d9d72", "git_parents": ["2ee74017f7ff2a4a9991dd0d5de41206345bac2a"], "node": "2cdd3419858f11c9ddec320cafbe7d6c62ccd359", "parents": ["f1ebbe0cbdecee9a6e060315f506e007b173e0e9"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2053875 - Add annotations to generated Typescript DOM bindings for Searchfox. r=saschanaz\n\nThis adds docstrings to generated Typescript declarations which can be\nparsed by Searchfox to link them back to their source WebIDL symbols,\nlike recently done for XPCOM.\n\nNote that a couple of declarations don't have a docstring emitted by\n@typescript/dom-lib-generator, but this sets the comment property\nnonetheless in case it ever does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312739\n", "files": ["tools/@types/generated/lib.gecko.dom.d.ts", "tools/ts/build_dom.js"], "git_node": "babe13b0b711a1fd869befcda1e848c1197e4060", "git_parents": ["8dc9b956b0f4ed94ad2e52b1d086883ae87d9d72"], "node": "3eaa3312171c13e3c6e340a53e4905df29e8a3f9", "parents": ["2cdd3419858f11c9ddec320cafbe7d6c62ccd359"], "tags": []}, {"author": "tmanku \u003ctanvi.manku@gmail.com\u003e", "branch": "default", "desc": "Bug 2048463 - Extend expiry of doorhangerSubmitted metrics to 165. r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312640\n", "files": ["toolkit/components/passwordmgr/metrics.yaml"], "git_node": "119ec2c5fabfbdfc26a818484dd36bbf7e7d1e88", "git_parents": ["babe13b0b711a1fd869befcda1e848c1197e4060"], "node": "b843544e30d0a5ea676dc8a24d591ddaeb3d6fbc", "parents": ["3eaa3312171c13e3c6e340a53e4905df29e8a3f9"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2044968 - Add ACCESS_LOCAL_NETWORK permission support for Android 17 (API 37) r=android-reviewers,jonalmeida\n\nAdd runtime permission support for Android 17's new ACCESS_LOCAL_NETWORK permission to enable local area network device discovery and communication while respecting user privacy.\n\n- Conditionally add ACCESS_LOCAL_NETWORK to permission mappings (API 37+)\n- Declare permission in both Fenix and Focus AndroidManifest.xml\n- Create Permission.AppLocalNetworkAccess type for the new permission\n- Update tests for backward compatibility verification.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311095\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/permission/GeckoPermissionRequest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/permission/GeckoPermissionRequestTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/permission/PermissionRequest.kt", "mobile/android/fenix/app/src/main/AndroidManifest.xml", "mobile/android/focus-android/app/src/main/AndroidManifest.xml"], "git_node": "7dbaf18e3ba589e34b2d9d6eebd60243a2ee88d7", "git_parents": ["119ec2c5fabfbdfc26a818484dd36bbf7e7d1e88"], "node": "78ce26562dc8182e161cc2ec1103a5e2d3369e72", "parents": ["b843544e30d0a5ea676dc8a24d591ddaeb3d6fbc"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2055238 - Rename experimental-arm to fenix-tae-arm-debug r=jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312816\n", "files": ["mobile/android/test_infra/flank-configs/fenix/arm-experimental-api-tests.yml", "mobile/android/test_infra/flank-configs/fenix/arm-tae-tests.yml", "taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "7d92006ef65bdb3da12780cd285a41f9b7c9f22a", "git_parents": ["7dbaf18e3ba589e34b2d9d6eebd60243a2ee88d7"], "node": "277183b33940c6edcc3b2f3138184d3f5cb44cc9", "parents": ["78ce26562dc8182e161cc2ec1103a5e2d3369e72"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1869075 - Follow RFC9460 HTTPS AliasMode TargetName r=necko-reviewers,kershaw\n\nThis change makes follows AliasMode HTTPS records for both TRR and native resolution.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312868\n", "files": ["netwerk/dns/GetAddrInfo.cpp", "netwerk/dns/GetAddrInfo.h", "netwerk/dns/PlatformDNSAndroid.cpp", "netwerk/dns/PlatformDNSMac.cpp", "netwerk/dns/PlatformDNSUnix.cpp", "netwerk/dns/PlatformDNSWin.cpp", "netwerk/dns/TRR.cpp", "netwerk/test/gtest/TestDNS.cpp", "netwerk/test/unit/test_dns_override.js", "netwerk/test/unit/test_trr_httpssvc.js"], "git_node": "9c994c20fbfe2f1afd65179dc764b238dca0ba54", "git_parents": ["7d92006ef65bdb3da12780cd285a41f9b7c9f22a"], "node": "d8b5168860fd0cf7e7b79e16aa72e3cee630e611", "parents": ["277183b33940c6edcc3b2f3138184d3f5cb44cc9"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054591 - Extend speculation rules prefetch browsertime navigation tests to include list rules r=sunil,perftest-reviewers,sparky\n\nAdd prefetch-list-{immediate,eager,moderate,conservative} variants that inject\nlist-source speculation rules, complementing the existing document-source tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312551\n", "files": ["testing/perfdocs/generated/raptor.rst", "testing/raptor/browsertime/speculation-rules-prefetch.js", "testing/raptor/browsertime/support-scripts/speculation_rules.py", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/tests/custom/browsertime-speculation-rules.toml"], "git_node": "ecc252f7ff4d30ba1b846beff19a87527edb9a66", "git_parents": ["9c994c20fbfe2f1afd65179dc764b238dca0ba54"], "node": "8337368eb023194767d71ff9afa17d7484babd35", "parents": ["d8b5168860fd0cf7e7b79e16aa72e3cee630e611"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2056207 - Remove image text recognition shadow DOM code. r=nordzilla\n\nThis never shipped, and is only testable on macOS. Nobody seems actively\nworking on this so we should probably delete it.\n\nWe can always rescue from git history if needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312977\n", "files": ["browser/components/storybook/docs/README.other-widgets.stories.md", "dom/base/nsImageLoadingContent.cpp", "toolkit/actors/UAWidgetsChild.sys.mjs", "toolkit/content/jar.mn", "toolkit/content/tests/widgets/test_image_recognition.html", "toolkit/content/widgets/textrecognition.js", "widget/TextRecognition.cpp"], "git_node": "ea0e13eecb7acfdb7afc0b533d6c822a65880c2d", "git_parents": ["ecc252f7ff4d30ba1b846beff19a87527edb9a66"], "node": "52352c48567739ba55549720be71f6d9e8ec4e52", "parents": ["8337368eb023194767d71ff9afa17d7484babd35"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052490 - Don't release buffer allocator lock before checking GC state r=spidermonkey-reviewers,jandem\n\nThere's an intermittent assertion failure because we release the lock between\nmerging swept data and checking the expected GC state which allows the\nbackground sweeping task to add more chunks to the swept chunks lists. When we\nmerge this data the expected state will be restored restored.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312447\n", "files": ["js/src/gc/BufferAllocator.cpp"], "git_node": "fb4ac2ae858ef18be4e8a906a22312bee6ed64d8", "git_parents": ["ea0e13eecb7acfdb7afc0b533d6c822a65880c2d"], "node": "3c30da6c28e9b914d4d97b0e75c6e779fdd31469", "parents": ["52352c48567739ba55549720be71f6d9e8ec4e52"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055193 - Add buffer allocator heap density telemetry r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312267\n", "files": ["js/public/friend/UsageStatistics.h", "js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/BufferAllocatorInternals.h", "js/src/gc/GCRuntime.h", "js/src/gc/Statistics.cpp", "js/xpconnect/metrics.yaml", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": "750ad38e796d3bddb08180f3fc73f6d286c7274f", "git_parents": ["fb4ac2ae858ef18be4e8a906a22312bee6ed64d8"], "node": "234ced32cb266759e3f337098602b984a5e98ca7", "parents": ["3c30da6c28e9b914d4d97b0e75c6e779fdd31469"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055193 - Add buffer allocator heap size telemetry r=spidermonkey-reviewers,jandem\n\nSince we already have the information it would be useful to record the heap\nsize too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312688\n", "files": ["js/public/friend/UsageStatistics.h", "js/src/gc/Statistics.cpp", "js/xpconnect/metrics.yaml", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": "b1b589a3f438039ac162cf12058e2d066ad20519", "git_parents": ["750ad38e796d3bddb08180f3fc73f6d286c7274f"], "node": "4aec98b65be0d6299fe66dc1ca2b22f30a384587", "parents": ["234ced32cb266759e3f337098602b984a5e98ca7"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2010632 - Group applink startup tests into a single metric with submetrics. r=perftest-reviewers,mozperftest-reviewers,sparky\n\nThis fixes the issue of a cluttered perfcompare when looking at applink data.\nTo do this a new suite called \"\u003cstartup_test\u003e_submetrics which has a primary value of the startup test data was added.\nI added a new key with all the submetrics, and kept the old one to not give confusion when this org-level KPI suddenly changes and every single scipt which uses this value breaks.\nWithin the new _submetrics suite I added the startup time, so that in case we do want to remove the single startup data suite we can and we'll have the redundant data to not worry about data being missed for sheriffing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302324\n", "files": ["python/mozperftest/mozperftest/metrics/common.py", "python/mozperftest/mozperftest/metrics/perfherder.py", "python/mozperftest/mozperftest/test/shellscript.py", "testing/performance/mobile-startup/android_startup_videoapplink.py"], "git_node": "7176ab14e987e061fea50f499ddcbf03b3cfd9fa", "git_parents": ["b1b589a3f438039ac162cf12058e2d066ad20519"], "node": "7ae1996ab6bbe2bfe4fccb58a60bd5a5c7a2b627", "parents": ["4aec98b65be0d6299fe66dc1ca2b22f30a384587"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055571 - Add telemetry for max mark stack size r=spidermonkey-reviewers,jandem\n\nTo limit the performanc impact this track a high watermark of the stack's\ncapacity rather than the exact used size. If this is not sufficient we can\ninvestigate making it more accurate later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312542\n", "files": ["js/public/friend/UsageStatistics.h", "js/src/gc/GC.cpp", "js/src/gc/GCMarker.h", "js/src/gc/Marking.cpp", "js/src/gc/Statistics.cpp", "js/src/gc/Statistics.h", "js/xpconnect/metrics.yaml", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": "04ec84e5ecd1daec6c7eb73ed66c39c3c90a17f5", "git_parents": ["7176ab14e987e061fea50f499ddcbf03b3cfd9fa"], "node": "f857dbd1b027e961ddcd3ac83ccc51311b108ee9", "parents": ["7ae1996ab6bbe2bfe4fccb58a60bd5a5c7a2b627"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055643 - Populate MozAdsRequestOptions flags from adsBackendConfig in AdsFeed r=mconley\n\nFollow up from initial implementation of MAC singleton and use in\nAdsFeed (Bug 2051420). Adds parity for passing flags to MARS through\nMAC with manual MARS calls.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312589\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/AdsFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AdsFeed.js"], "git_node": "ab69ac099cc4b75a075c2de8bc33dd4cb2eada64", "git_parents": ["04ec84e5ecd1daec6c7eb73ed66c39c3c90a17f5"], "node": "a45de330378f4ebd0447e703f661a9aada4eeea9", "parents": ["f857dbd1b027e961ddcd3ac83ccc51311b108ee9"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2055999 - Call is_running_under_coding_agent() instead of using it as a value in BuildDriver._build(). r=padenot,ai4dev-reviewers,marco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312854\n", "files": ["python/mozbuild/mozbuild/controller/building.py"], "git_node": "ed99104773b6c2a7dc5158096d468270c0aa25e6", "git_parents": ["ab69ac099cc4b75a075c2de8bc33dd4cb2eada64"], "node": "bc38958c21a9ba82c2428187dd7b8d75094785c4", "parents": ["a45de330378f4ebd0447e703f661a9aada4eeea9"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2055310 - Adjust the toolbar and search suggestion background color to align when Homepage Trending and Recent Search is enabled r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312930\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomepageEdgeToEdgeFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/HomepageEdgeToEdgeFeatureTest.kt"], "git_node": "0bf0251202d9d894a4aa711e5b69f29ff07635d0", "git_parents": ["ed99104773b6c2a7dc5158096d468270c0aa25e6"], "node": "cd19622bd221349727b2b81abd32945fdfa5b022", "parents": ["bc38958c21a9ba82c2428187dd7b8d75094785c4"], "tags": []}, {"author": "Katherine Ye \u003ckye@mozilla.com\u003e", "branch": "default", "desc": "Bug 1924567 - Remove unobservable-document constraints from plaintext layout styles. r=AlaskanEmily,firefox-style-system-reviewers,emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300591\n", "files": ["layout/reftests/bugs/reftest.list", "layout/style/CSSMozDocumentRule.cpp", "layout/style/DocumentMatchingFunction.h", "layout/style/res/plaintext.css", "servo/components/style/stylesheets/document_rule.rs"], "git_node": "b331de10688915836a2455d61c080af6b8095c90", "git_parents": ["0bf0251202d9d894a4aa711e5b69f29ff07635d0"], "node": "fc9461caaea2f4796ac4cc09eb560187edbac703", "parents": ["cd19622bd221349727b2b81abd32945fdfa5b022"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2052482 - Put dom.webshare.enabled back to nightly only on Windows r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312995\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "312447b42a0f19b1efc84a9d9ee0d70dd1bc9872", "git_parents": ["b331de10688915836a2455d61c080af6b8095c90"], "node": "ba00370ed691094b6563ac82a854d0e5267eb22e", "parents": ["fc9461caaea2f4796ac4cc09eb560187edbac703"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2056207 - Remove textrecognition.css as well, which I missed.\n", "files": ["toolkit/themes/shared/media/textrecognition.css", "toolkit/themes/shared/minimal-toolkit.jar.inc.mn"], "git_node": "a87e113fe4e79ee20bccdefa01cf9d2ba0fb3191", "git_parents": ["312447b42a0f19b1efc84a9d9ee0d70dd1bc9872"], "node": "9dd8996111bfa716fa244e5b07978020dd7e44f8", "parents": ["ba00370ed691094b6563ac82a854d0e5267eb22e"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052229 - Skip onboarding for performance tests running on Android emulators r=android-reviewers,tthibaud\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310096\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/Performance.kt"], "git_node": "5613cde0aed4ffb28496bfd8b71fe3c706784a88", "git_parents": ["a87e113fe4e79ee20bccdefa01cf9d2ba0fb3191"], "node": "927e79899ed74eca7b6203e4760df59114d763f6", "parents": ["9dd8996111bfa716fa244e5b07978020dd7e44f8"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049930: Add a11y label and role to empty bookmark folders in new sidebar r=nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312312\n", "files": ["browser/components/sidebar/sidebar-bookmark-list.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js"], "git_node": "22c8c3c607bd2a84e54ec7b7a2b23437de4e6130", "git_parents": ["5613cde0aed4ffb28496bfd8b71fe3c706784a88"], "node": "be4cc9e1efdc20c64fa21bf0516a823cb4825cff", "parents": ["927e79899ed74eca7b6203e4760df59114d763f6"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2053703 - Evaluate GetCycleTimeFrequencyMHz's automation gate live instead of caching it, r=profiler-reviewers,canova.\n\nOn machines without a constant TSC (typical of CI VMs), GetCycleTimeFrequencyMHz()\nreturned a cached 0 whenever a process was profiled from startup: the profiler\nqueries CPU times before the automation prefs that make IsInAutomation() true are\napplied, so the first call cached the \"not in automation\" result and pinned the\nprocess to the coarse 1/64s GetProcessTimes fallback for its whole life. This\ncoarsened power and engine_run CPU telemetry and made browser_ml_telemetry.js fail\nintermittently under profiler-by-default, as short engine_run CPU deltas quantized\nto 0.\n\nEvaluate the gate live instead of caching it. This is safe for the profiler's\nsampling hot path, which collects raw cycle counts via Query{Thread,Process}CycleTime\nand defers the frequency conversion to serialization time, so it never calls\nGetCycleTimeFrequencyMHz(). The remaining callers are cold (RecordPowerMetrics,\nwake-count recording, serialization), and the recompute is cheap: a constant\nhas_constant_tsc(), a lock-free IsInAutomation() read, and the already-cached\nGetCpuFrequencyMHz().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311254\n", "files": ["toolkit/components/processtools/ProcInfo_win.cpp"], "git_node": "59277e1e989468b318bf7ed1eedceb76d3247872", "git_parents": ["22c8c3c607bd2a84e54ec7b7a2b23437de4e6130"], "node": "6283d3713c47005ec7a998308032c96f9118c812", "parents": ["be4cc9e1efdc20c64fa21bf0516a823cb4825cff"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052229 - Skip onboarding for performance tests running on Android emulators r=android-reviewers,tthibaud\" for causing klint at Performance.kt\n\nThis reverts commit 5613cde0aed4ffb28496bfd8b71fe3c706784a88.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/Performance.kt"], "git_node": "88520a2c991be9e1bcb4e2b0de4e6d7f0e4e098b", "git_parents": ["59277e1e989468b318bf7ed1eedceb76d3247872"], "node": "7f57e1c5397add6282ac93683b0a46c94a7e2197", "parents": ["6283d3713c47005ec7a998308032c96f9118c812"], "tags": []}, {"author": "Haik Aftandilian \u003chafta@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2044478 - Add profile container App Group to production entitlements for Developer Edition r=spohl\n\nAdd the app group for accessing App Group Container Firefox profiles to\nDeveloper Edition, matching Nightly. Release and Beta share the same\nbundle ID so we'll add those later after Developer Edition has been\nvalidated and the Beta/Release provisioning profiles are updated. The\nDeveloper Edition provisioning profile already includes the App Group\nContainer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310736\n", "files": ["security/mac/hardenedruntime/production/firefoxdeveloperedition.browser.xml"], "git_node": "ae35a6caa0c0c7403e2aa1049cdc41362d2637ea", "git_parents": ["88520a2c991be9e1bcb4e2b0de4e6d7f0e4e098b"], "node": "91974a2bf7225a6cc03a0275f31c3888d48d8bfa", "parents": ["7f57e1c5397add6282ac93683b0a46c94a7e2197"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2023762: Nova info architecture changes for application menu r=sclements,fluent-reviewers,webcompat-reviewers,twisniewski,bolsson\n\nReorder the app menu so that History comes before Bookmarks and\nTranslate comes before Find in Page.\n\nThe \"Help\" menu is renamed to \"Help and Report\" and the \"Report Broken\nSite\" is moved into the Help and Report menu.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311409\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/test/static/browser_sentence_case_strings.js", "browser/components/customizableui/content/panelUI.js", "browser/components/customizableui/test/browser_help_panel_cloning.js", "browser/components/reportbrokensite/ReportBrokenSite.sys.mjs", "browser/components/reportbrokensite/test/browser/browser_keyboard_navigation.js", "browser/components/reportbrokensite/test/browser/head.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "56f60330a985b090b057c9aa5441ca52a97cac8c", "git_parents": ["ae35a6caa0c0c7403e2aa1049cdc41362d2637ea"], "node": "f73d983623c798bb7106cbb95787e748f6074844", "parents": ["91974a2bf7225a6cc03a0275f31c3888d48d8bfa"], "tags": []}, {"author": "Florin Bilt \u003cfbilt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039408 - Stop running Ares6 and sunspider in CI r=perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312981\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.rst"], "git_node": "e5b6540f9c7d47d5b7bfc175c0f125d7946d677f", "git_parents": ["56f60330a985b090b057c9aa5441ca52a97cac8c"], "node": "898ed9c674c4e7fd8c121d80e161f3a56633a082", "parents": ["f73d983623c798bb7106cbb95787e748f6074844"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2056089 - Remove obsolete pref from storage-related devtools tests r=devtools-reviewers,nchevobbe\n\nThese prefs became obsolete by the change from bug 1550476.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312908\n", "files": ["devtools/client/storage/test/browser_storage_cookies_hostOnly.js", "devtools/client/storage/test/browser_storage_cookies_partitioned.js", "devtools/client/storage/test/browser_storage_dynamic_updates_cookies.js"], "git_node": "07ba01c1c98e8e77de81e5584b5033cdfb558b5d", "git_parents": ["e5b6540f9c7d47d5b7bfc175c0f125d7946d677f"], "node": "fba39abc7430c8ef8d20b425babc457863197632", "parents": ["898ed9c674c4e7fd8c121d80e161f3a56633a082"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043271: Update HeapReg after debug stub. r=rhunt\n\nBecause moving grows can occur during debug events, we need to update\nHeapReg upon coming back to wasm.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306330\n", "files": ["js/src/jit-test/tests/debug/wasm-grow-memory-in-trap.js", "js/src/wasm/WasmStubs.cpp"], "git_node": "4769cdc73085af34cce7d7daa46fcf56a9bbcd7a", "git_parents": ["07ba01c1c98e8e77de81e5584b5033cdfb558b5d"], "node": "95fff006168300fc6e8bc71ada6026cf1f50dc32", "parents": ["fba39abc7430c8ef8d20b425babc457863197632"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056233 - Update PDF.js to cd03276d606895f73295159c1a7e084e575ab49d r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312989\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "428c764249a84a9d3ca5a50c21ce298cfdebc591", "git_parents": ["4769cdc73085af34cce7d7daa46fcf56a9bbcd7a"], "node": "f63ac07ecdeadc90cb53d7ce2df1dd534b1f6516", "parents": ["95fff006168300fc6e8bc71ada6026cf1f50dc32"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050478 - Fix two panel-list submenu defects on keyboard open: dismissal on page scroll and off-screen opening. r=hjones\n\nOpening a submenu by keyboard on a sideways-scrolling page had two\ndefects. First, the panel-item arrow key handler did not call\npreventDefault, so the arrow key scrolled the page. The scroll-hide\nlistener then dismissed the menu. Second, setSubmenuAlign() measured the\nsubmenu's width before layout. The value read as 0, so the overflow\ncheck chose the wrong side and opened it off-screen.\n\nCall preventDefault in the submenu open and close key branches, matching\nArrowDown, ArrowUp and Tab. Defer the measurement with\nrequestAnimationFrame plus setTimeout, as setAlign() does, so the width\nis known before the side is chosen.\n\nAdd regression tests verifying that a submenu wider than the room to its\nright opens where it fits, and that opening via keyboard does not scroll\nthe page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309661\n", "files": ["toolkit/content/tests/widgets/test_panel_list_popover.html", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "803931c078ca70b2e57bbc296b9624cb4ffdcc2b", "git_parents": ["428c764249a84a9d3ca5a50c21ce298cfdebc591"], "node": "917e73d8ce07158e576f25d95f2f15dc74d64f67", "parents": ["f63ac07ecdeadc90cb53d7ce2df1dd534b1f6516"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2051391 - [geckodriver] Fix release changeset and remove outdated references from CHANGES.md. r=jdescottes,geckodriver-reviewers,Sasha DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312974\n", "files": ["testing/geckodriver/CHANGES.md"], "git_node": "815af695eaabe9c3dab3a57a6b3a7495773e2e4d", "git_parents": ["803931c078ca70b2e57bbc296b9624cb4ffdcc2b"], "node": "106e242a8a69a9215a0d3d934390456a0f91409b", "parents": ["917e73d8ce07158e576f25d95f2f15dc74d64f67"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051555: In case of OOM, make an inline array. r=jpages\n\nFor both array and struct objects, an OOM can occur in between\nallocating the object and allocating its out-of-line data area. For\nstructs we don't really have a choice but to be aware of null data\npointers in obj_trace and obj_moved, but for arrays we can just convert\nthe failed array into an empty inline-storage array.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311827\n", "files": ["js/src/jit-test/tests/wasm/gc/bug2051555.js", "js/src/wasm/WasmGcObject-inl.h", "js/src/wasm/WasmGcObject.cpp"], "git_node": "9440878b4ee641ee5e8f6ed736cdf764d75d7396", "git_parents": ["815af695eaabe9c3dab3a57a6b3a7495773e2e4d"], "node": "fd4824b9b03915611302a3d3353073c61bc02255", "parents": ["106e242a8a69a9215a0d3d934390456a0f91409b"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035790 - Fix stack overflow in ContType::hash() for self-referencing cont types. r=rhunt\n\nAdd TypeContext::cancelStartRecGroup() to undo a startRecGroup() call when\nvalidation fails, preventing malformed rec groups from remaining in recGroups_\nwhere ~TypeContext would hash them during cleanup.\n\nUse a MakeScopeExit guard in DecodeTypeSection to call cancelStartRecGroup()\non any early return between startRecGroup and endRecGroup.\n\nAlso guard ContType::hash() against non-func funcTypeDef_ as defense-in-depth\nto avoid infinite recursion through self-referencing cont types.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308383\n", "files": ["js/src/jit-test/tests/wasm/stack-switching/bug2035790.js", "js/src/wasm/WasmTypeDef.h", "js/src/wasm/WasmValidate.cpp"], "git_node": "813adc5d8794f3d53e53005514be763fe8d69529", "git_parents": ["9440878b4ee641ee5e8f6ed736cdf764d75d7396"], "node": "b4b5c0c429f18c343ff15b17e30a913f89bfca5e", "parents": ["fd4824b9b03915611302a3d3353073c61bc02255"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045122 - Adapt browser_ext_themes_autocomplete_popup.js to pass with and without Nova styles enabled. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305348\n", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_autocomplete_popup.js"], "git_node": "03dfef0d2ac24e53d0c15df03307bce38f529ba7", "git_parents": ["813adc5d8794f3d53e53005514be763fe8d69529"], "node": "087cbe98f45f9a94978cc589357f83c9d961a2ba", "parents": ["b4b5c0c429f18c343ff15b17e30a913f89bfca5e"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045122 - Adapt browser_ext_themes_dynamic_updates.js to pass with and without Nova styles enabled. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305349\n", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_dynamic_updates.js"], "git_node": "a4ed463b60b9d3d76f459440d1ee0504825306fe", "git_parents": ["03dfef0d2ac24e53d0c15df03307bce38f529ba7"], "node": "fa5c177349f0086ae733d7cd2979145849a4687f", "parents": ["087cbe98f45f9a94978cc589357f83c9d961a2ba"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045122 - Adapt browser_ext_themes_separators.js to pass with and without Nova styles enabled. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305350\n", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_separators.js"], "git_node": "4eff807e9d40d7de2c93c68e29f7282dc7bc4d10", "git_parents": ["a4ed463b60b9d3d76f459440d1ee0504825306fe"], "node": "acf1d03b543541852ec31523856b6e89a7464808", "parents": ["fa5c177349f0086ae733d7cd2979145849a4687f"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045122 - Adapt browser_ext_themes_multiple_backgrounds.js to pass with Nova enabled and disabled. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305354\n", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_multiple_backgrounds.js"], "git_node": "a7bc76ef11a4bd36a3817bc9f96bfe23e32b4991", "git_parents": ["4eff807e9d40d7de2c93c68e29f7282dc7bc4d10"], "node": "089b0a7ad13a6b9365e378f850a2493556e8f6f6", "parents": ["acf1d03b543541852ec31523856b6e89a7464808"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2004172 - Fix crash when calling pushState on initial about:blank. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311803\n", "files": ["docshell/base/crashtests/2004172.html", "docshell/base/crashtests/crashtests.list", "docshell/base/nsDocShell.cpp"], "git_node": "cc121ee819feb9f69b318ebcefaf483d6880fe70", "git_parents": ["a7bc76ef11a4bd36a3817bc9f96bfe23e32b4991"], "node": "ccb6bbab78d109cc53735afded75267da82a133e", "parents": ["089b0a7ad13a6b9365e378f850a2493556e8f6f6"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052660 - treat symbols in resource documents as always visible r=emilio\" for causing regression bug 2056150\n\nThis reverts commit d07b48bc261f6c2795c151572d28e10d64033431.\n", "files": ["dom/svg/SVGSymbolElement.cpp",