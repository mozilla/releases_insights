ules/audio_coding/test/PacketLossTest.cc", "third_party/libwebrtc/modules/audio_coding/test/TestAllCodecs.cc", "third_party/libwebrtc/modules/audio_coding/test/TestRedFec.cc", "third_party/libwebrtc/modules/audio_coding/test/TestStereo.cc", "third_party/libwebrtc/modules/audio_coding/test/TestVADDTX.cc", "third_party/libwebrtc/modules/audio_coding/test/opus_test.cc", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/test/video_codec_unittest.h", "third_party/libwebrtc/modules/video_coding/codecs/vp8/test/vp8_impl_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0096.patch", "third_party/libwebrtc/moz-patch-stack/s0143.patch", "third_party/libwebrtc/p2p/base/p2p_transport_channel_unittest.cc"], "git_node": "6ee8fbd7f69237b0081c926f15f16144e5b0642e", "git_parents": ["586341cccfe551b602f7d68abd7b6f4d569dd8e9"], "node": "c2ae9b5f7bb31a4926831552a6feebc8d18d60cf", "parents": ["a9bbc88d159c9a7376e923c0340fc0f101d81c0f"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 419cb40312\n\nUpstream commit: https://webrtc.googlesource.com/src/+/419cb403120f7093da3b2b341630079bccbc35b1\n    Enforce simulcast RID limits and ignore duplicates\n\n    Guard against large SDP inputs with excessive RIDs during simulcast\n    description parsing and validation and cap the total number of parsed\n    RIDs to 16 per direction during deserialization.\n\n    Fixed: b/509982146\n    Change-Id: Id6c3ad9214a4ce15d64eb56453a352f0d7cb58a0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/480520\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#47987}\n"