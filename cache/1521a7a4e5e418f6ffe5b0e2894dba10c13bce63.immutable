8e", "b4c4d0bb1f5a38f580874cc809eb0c861c37c6b4", "4b00f94fe792ee163a9457fdb760647dedf6d61f", "d726f7df31cd821b9e47785ad5c7ba56382c9f69", "8c9946b42c4beacb9859c71e0ee83703584f7d33", "a2152ea74bfb38c237beb92fe93c0146ca9699b6", "bc3b2eb6f8239e9900cb8398fcc2e883255cde8b", "0372164bf317a03f4b4387406af483fd48d0964a", "779463c725d2d1b08620971a460fe7248e27e2f1", "cc0d52be8653150aac748cf8304b7e5ced8b3862", "d714e9c2ef868d3283f7eef6b3426d1d5da35a81", "0ef390cc87b205f8e92842e0655c8aba8a71563c", "6dd3d70900965a4088059ec6db863375a3d4ae9b", "a6cc4809f2580a24fa550497afef4be361c56edd", "b7280e3b597b7ec1c4884cfc75e956d5ba877911", "8b32d772784c5b8b3ec9fbc9626d2fde28983fed", "f806fadb1094a51a4cb9a9aae9f96d0ad99cd9ed", "f6fe253bcf235082591d3b46dfdad16c5a52ea18", "d08e15204722f504c27de33dbbd1efe4a1406a30", "b8113a102407e378a58c82248c0286bf23fe72f5", "51916ddc26d90e09b453a7a33161fc2dd3e2730f", "0d218990609f9e69c70d4036fa05c7363b155319", "4eddb46920f026331de2c260ea7a3853434105f9", "a2edeb25c3a4f8d9b2b24c9e426f7bd26ef997bb", "4d27ff7f1514bab7dd1d5c6472d247e848f9c0e0", "4559366a819949a8db0b02386410cd770aa4ff38", "82c61463f5e7af932199cce855997138a3b1f27e", "3e08fc5eecd5f0fc6e36aa96fe4029c7dca81edd", "4841e0b11bb226bc902bad018668c392558f2487", "7c457f55a9a6f36c8fa797580544f3535f1137d8", "431a7aba79f70860248d3364f2388f48e8276ffc", "75eb9e887d9086f8285d42a7eb772e58d1aea46d", "2fb66fc843b3c9d96d7517b70cdb4483bbe6e243", "48c6077d0cf5378771a2f76c276c642ee63e81ca", "f5287d7ba4f48f1a822c1cd7f0288dc01ebf7306", "91d6cd2d1476bca635bb96f82ca34eda283b5460"], "user": "pstanciu@mozilla.com"}, "44948": {"changesets": [{"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2055239 - Add a TLS Tokens tab to about:networking r=kershaw,necko-reviewers,fluent-reviewers,desktop-theme-reviewers,bolsson,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312289\n", "files": ["dom/chrome-webidl/NetDashboard.webidl", "netwerk/base/Dashboard.cpp", "netwerk/base/Dashboard.h", "netwerk/base/DashboardTypes.h", "netwerk/base/SSLTokensCache.cpp", "netwerk/base/SSLTokensCache.h", "netwerk/base/nsIDashboard.idl", "netwerk/ipc/PSocketProcess.ipdl", "netwerk/ipc/SocketProcessChild.cpp", "netwerk/ipc/SocketProcessChild.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "toolkit/content/aboutNetworking.html", "toolkit/content/aboutNetworking.js", "toolkit/locales/en-US/toolkit/about/aboutNetworking.ftl", "toolkit/themes/shared/aboutNetworking.css"], "git_node": "db3f6ee27fca311ba08432e1162b9be13177c7e2", "git_parents": ["91d6cd2d1476bca635bb96f82ca34eda283b5460"], "node": "2b918dd4e6897fc3ead4e2333366b9b06dfa6987", "parents": ["ae4fce3374394a29726cf0d8a5e1cd33dd04bc7d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056917 - [riscv64] Qualify enum BaseOpcode in return type position in InstructionBase. r=anba\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313478\n", "files": ["js/src/jit/riscv64/base/Instruction.h"], "git_node": "0be02e974718aaaade8fc18603cb18311c05b126", "git_parents": ["db3f6ee27fca311ba08432e1162b9be13177c7e2"], "node": "dbd09a63659704261530f9e6e2dd02b7f66a0a4d", "parents": ["2b918dd4e6897fc3ead4e2333366b9b06dfa6987"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2056926 - Paper over bug 1681745 / bug 1941972. r=firefox-style-system-reviewers,dshin\n\nSee the comment for reasoning, and bug 1681745 + bug 1941972 for\ncontext.\n\nNot a fan in many ways, since this is likely to cause wrong rendering at\nbest, and random crashes later down the line at worst. But at least I\nadd the crash reporter annotation message, if we then crash later down\nthe line...\n\nTested manually by removing select.css from my objdir and using the\nnon-nightly codepath.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313486\n", "files": ["dom/base/Document.cpp", "dom/base/ShadowRoot.cpp", "layout/style/GlobalStyleSheetCache.cpp", "layout/style/GlobalStyleSheetCache.h"], "git_node": "2a9f3f2c1c1731dcebc0b4922caf7d4bdae887f3", "git_parents": ["0be02e974718aaaade8fc18603cb18311c05b126"], "node": "1c8f51b10d8cc40f4cc501df2522234ea2429652", "parents": ["dbd09a63659704261530f9e6e2dd02b7f66a0a4d"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056495 - IP-Protection: Remove world-cup deprecated entries in the list of breakage rules r=lesleynorton\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313163\n", "files": ["browser/extensions/ipp-activator/extension/breakages/tab.json", "browser/extensions/ipp-activator/manifest.json"], "git_node": "b0ee076972da0f40cc97649a9e9679b82b6fab44", "git_parents": ["2a9f3f2c1c1731dcebc0b4922caf7d4bdae887f3"], "node": "2fdcd8dae89ad300a196280d45d45a523f6d258b", "parents": ["1c8f51b10d8cc40f4cc501df2522234ea2429652"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055029 - Standardize New Tab widgets and sections header spacing. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312128\n", "files": ["browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/_CardSections.scss", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/content-src/styles/nova/_CardSections.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css"], "git_node": "ac2f6fa3bc208b68c321575c90c2ab07bcb845f9", "git_parents": ["b0ee076972da0f40cc97649a9e9679b82b6fab44"], "node": "b3d15f100e26c48bc2738ec4c7f8cb4418f05a73", "parents": ["2fdcd8dae89ad300a196280d45d45a523f6d258b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048732 - Part 1: Add a GeckoView signal to route a system audio-focus change to the audio session interrupt. r=geckoview-reviewers,android-reviewers,owlish,pollymce\n\nCarries a system audio-focus change (gain, transient loss, permanent loss)\nfrom the embedder through GeckoView to the chrome media controller's\ninterrupt, so a focus loss suspends and a gain resumes the tab's audible\nWeb Audio and Web Speech. No caller drives it yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312103\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/mediasession/GeckoMediaSessionController.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/mediasession/GeckoMediaSessionControllerTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/mediasession/MediaSession.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/assets/www/media_session_audio_loop.html", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/MediaSessionTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/MediaSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/modules/geckoview/GeckoViewMediaControl.sys.mjs"], "git_node": "11bdcfb9bc9850baab0c30e8adfee5dd0d1b4a6a", "git_parents": ["ac2f6fa3bc208b68c321575c90c2ab07bcb845f9"], "node": "5758e3f04f6acd3ff07aed28035d4b6d079516e4", "parents": ["b3d15f100e26c48bc2738ec4c7f8cb4418f05a73"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048732 - Part 2: Drive the audio session interrupt from Android system audio-focus loss and gain. r=android-reviewers,pollymce\n\nRoute Android's transient and permanent audio-focus loss and the subsequent\ngain through the audio session interrupt, which now suspends and resumes media\nelements as well as Web Audio and Web Speech. The legacy transport pause and\nresume on a focus change is therefore redundant and dropped; the deferred-start\nresume and the denied-request pause are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312102\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/focus/AudioFocus.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/focus/AudioFocusTest.kt"], "git_node": "ecc415652f1ed078492228b24cb4fd9b4dfb86c2", "git_parents": ["11bdcfb9bc9850baab0c30e8adfee5dd0d1b4a6a"], "node": "84fcd1dc94edf71217c2ebed49f30555f3c4f945", "parents": ["5758e3f04f6acd3ff07aed28035d4b6d079516e4"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050592: Replace right titlebar-spacer with a flexible space r=Gijs\n\nFigma: https://www.figma.com/design/XT0eDYh4RtbMNWaYQi0efM/Chrome-Sidebar-UX-Specifications--Sprint-1-?node-id=3796-142219&p=f&m=dev\n\nTransform the right (pos-tabs) titlebar-spacer element into a flexible space element that can be removed/moved around by the user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310715\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/test/unit/test_titlebar_spacer_migration.js", "browser/components/customizableui/test/unit/xpcshell.toml", "browser/components/sidebar/tests/marionette/test_initialize_vertical_tabs.py"], "git_node": "f1680989652636eabc18abce6de01bf506e18438", "git_parents": ["ecc415652f1ed078492228b24cb4fd9b4dfb86c2"], "node": "687a73ee86c8650425168cf39cc0dc23d5339e9c", "parents": ["84fcd1dc94edf71217c2ebed49f30555f3c4f945"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1989252 - Don't show unavailable quickactions in action mode. r=daleharvey,urlbar-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312081\n", "files": ["browser/components/urlbar/ActionsProviderQuickActions.sys.mjs", "browser/components/urlbar/QuickActionsLoaderDefault.sys.mjs", "browser/components/urlbar/UrlbarProviderActionsSearchMode.sys.mjs", "browser/components/urlbar/tests/browser-quickactions/browser_general.js", "browser/components/urlbar/tests/unit/test_quickaction_telemetry.js"], "git_node": "22e2727ab23df41c3bb0a2fe5ecc5713d84b5ca7", "git_parents": ["f1680989652636eabc18abce6de01bf506e18438"], "node": "e4bc554fdd09289603be0390172497aaee58b66b", "parents": ["687a73ee86c8650425168cf39cc0dc23d5339e9c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Await the tip's deferred engagement effects in the search-tips and suppress-focus-border tests on the message path. r=mbeier\n\nThe tip provider's onEngagement (disabling the tip once tipShownCount reaches\nthe cap) and onSearchSessionEnd (clearing the engagement's tip state) run\nparent-side, so over the message path their effects land asynchronously after\nthe pick, and the tests raced them.\n\nAwait the effects before asserting. UrlbarTestUtils.waitForPrefValue waits for\nan UrlbarPrefs value (checking the current value first, then observing) and\nfolds the assertion in via its message, so it resolves immediately on the\ndefault in-process path and only actually waits over the wire. In\nbrowser_suppressFocusBorder.js the tip pick's blur clears the\nsuppress-focus-border attribute, which lands the same way, so wait for it with\nTestUtils.waitForCondition.\n\nDrive-by: two sibling asserts in browser_suppressFocusBorder.js passed their\nmessage as a second argument to hasAttribute, a one-argument method, so it was\nsilently dropped; move it to the Assert.ok call.\n\nTest-only; the default path is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311275\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-tips/browser_searchTips_interaction.js", "browser/components/urlbar/tests/browser/browser_suppressFocusBorder.js"], "git_node": "a8f05c5c0a02aa3c42d4400fa0e9bafa8761ba51", "git_parents": ["22e2727ab23df41c3bb0a2fe5ecc5713d84b5ca7"], "node": "4f952e7cc77992c2f194b15d94a5684f911665e7", "parents": ["e4bc554fdd09289603be0390172497aaee58b66b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Await the provider's deferred onSelection over the message path. r=mbeier\n\nA provider's onSelection hook runs parent-side, so over the message path it\nlands asynchronously relative to the key navigation that drives the selection,\nwhereas the direct path runs it synchronously. The test asserted the selection\ncount immediately after synthesizing the navigation and raced it.\n\nAwait the hook instead: the provider resolves a promise once onSelection has\nfired for every selected element, which happens synchronously on the default\nin-process path.\n\nTest-only; the default path is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311504\n", "files": ["browser/components/urlbar/tests/browser/browser_result_onSelection.js"], "git_node": "7ccbdcfb44296179274b6c1a670f8b3e36058fe5", "git_parents": ["a8f05c5c0a02aa3c42d4400fa0e9bafa8761ba51"], "node": "658a1f8f1b97fe7d4a65a617088c64955a8ea966", "parents": ["4f952e7cc77992c2f194b15d94a5684f911665e7"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056271 - Removed run_search from tools and embedded behavior switch in search_the_web r=tetchart,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313088\n", "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js", "browser/components/aiwindow/models/tests/xpcshell/test_Chat.js", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs"], "git_node": "355688820d70eebb362db6dc05a9646b4e439388", "git_parents": ["7ccbdcfb44296179274b6c1a670f8b3e36058fe5"], "node": "f2d201ed474492b1a6e531d66638593322fce21a", "parents": ["658a1f8f1b97fe7d4a65a617088c64955a8ea966"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056626 - Added timeout to return from getPageContent if no results by READ_TIMEOUT_MS r=tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313323\n", "files": ["browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js"], "git_node": "1e6c3db14c2104c27e5fa2de9aca6f49a5ed8607", "git_parents": ["355688820d70eebb362db6dc05a9646b4e439388"], "node": "5a2c7c540c8ba9f6dc4a430434c302ef69d55ced", "parents": ["f2d201ed474492b1a6e531d66638593322fce21a"], "tags": []}, {"author": "Justin Link \u003cjlink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055593: Avoid costly call to TimeStamp::Now() in nsTimerImpl::Fire() when not needed r=xpcom-reviewers,jstutte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312761\n", "files": ["xpcom/threads/nsTimerImpl.cpp"], "git_node": "e2aa372fa7d684d12a74573e75e719192289d2ec", "git_parents": ["1e6c3db14c2104c27e5fa2de9aca6f49a5ed8607"], "node": "1d60c318b6873cf380ede955d358ad8d44a4846c", "parents": ["5a2c7c540c8ba9f6dc4a430434c302ef69d55ced"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056905 - Remove redundant edge to edge and wallpaper related UI tests r=ajoltan\n\nThe QA team's ongoing initiative to optimize the full functional test suite revealed 2 redundant UI tests related to edge to edge and wallpaper verification.\n\nRemove redundant tests and consolidates overlapping coverage:\n\n  - Delete the older `verifyTheExpandedToolbarHomepageItemsTest`. Its exact verification is already covered by `verifyTheExpandedToolbarHomepageItemsWithEdgeToEdgeTest`, which also verifies the edge to edge wallpaper, already set as default homepage background in all releases. The remaining UI test will be renamed `verifyTheExpandedToolbarHomepageItemsTest`.\n\n  - Modify the `verifyWallpaperChangeFunctionalityTest` UI test to additionally verify that wallpapers are correctly highlighted (as already specified in the manual test), and delete \ufeff\ufeff\ufeff`verifyTheSelectedWallpaper`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313472\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NavigationToolbarExpandedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsHomepageTest.kt"], "git_node": "14834c742c7e0281da348f15122cd84f35b1876e", "git_parents": ["e2aa372fa7d684d12a74573e75e719192289d2ec"], "node": "c52aa33f8afe0945126c22d95bdbaf6c9abbc4a5", "parents": ["1d60c318b6873cf380ede955d358ad8d44a4846c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2053268 - Attribute profiler samples to the right thread when OS thread ids are recycled, r=profiler-reviewers,mstange.\n\nOS thread ids get reused across short-lived threads (e.g. web workers). At\nprofile-streaming time several dead ProfiledThreadData can share a thread id,\nand ProcessStreamingContext::GetThreadStreamingContext returned the first\nmatch, so all of that id's samples were dispatched to a single thread's\nstreaming context. A JitReturnAddr sample from a later same-id thread then\nfailed the buffer-position lookup against the first thread's JIT ranges,\ntripping the MOZ_RELEASE_ASSERT in\nUniqueStacks::LookupFramesForJITAddressFromBufferPos.\n\nDispatch each entry to the streaming context whose lifetime window covers the\nentry's buffer position instead: same-id threads have disjoint, ordered\nwindows, so pick the context with the smallest unregistration position that is\nstill \u003e= the entry position, or the still-registered context otherwise. The\nthread id and its unregistration position are grouped in a small\nThreadStreamingId array, and the selection is factored into a static\nSelectStreamingContextIndex helper covered by a gtest, since a regression would\ncrash release users via the release assert.\n\nSamples and markers both supply their own buffer position. Execution-trace\nevents carry no buffer position, so they pass the maximum position to select\nthe still-registered context for their thread id (traces are snapshotted from\nlive JS contexts).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310936\n", "files": ["tools/profiler/core/ProfileBuffer.h", "tools/profiler/core/ProfileBufferEntry.cpp", "tools/profiler/core/ProfiledThreadData.cpp", "tools/profiler/core/ProfiledThreadData.h", "tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "ab250fba72d54c03c155c346ec090cf3b538925b", "git_parents": ["14834c742c7e0281da348f15122cd84f35b1876e"], "node": "2c4d5da411656b4a3aea51a96c4b205ea7b7f26e", "parents": ["c52aa33f8afe0945126c22d95bdbaf6c9abbc4a5"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2056734 - Part 1: Clean up the Contile Top Sites provider r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313369\n", "files": ["mobile/android/android-components/components/service/mars/lint-baseline.xml", "mobile/android/android-components/components/service/mars/src/main/java/mozilla/c