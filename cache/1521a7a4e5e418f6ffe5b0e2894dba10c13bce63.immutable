r/exthandler/nsExternalHelperAppService.cpp", "uriloader/exthandler/nsExternalHelperAppService.h", "uriloader/exthandler/nsIContentDispatchChooser.idl", "uriloader/exthandler/tests/mochitest/browser.toml", "uriloader/exthandler/tests/mochitest/browser_first_prompt_not_blocked_without_user_interaction.js", "uriloader/exthandler/tests/mochitest/browser_mailto_user_activation.js", "uriloader/exthandler/tests/mochitest/browser_protocol_ask_dialog.js", "uriloader/exthandler/tests/mochitest/head.js"], "git_node": "fb9105edf652e33c8d43e3e0f062e5b5baf156e0", "git_parents": ["5bb3306f8a2bcf852b7fb1d3c80f321f920e86ce"], "node": "895bf08285d17624bfdc8c4fcea5a795710aca35", "parents": ["65b7ea25c7db8fd730e59925c3d2438c45a0c5dc"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2057902 - skip tests with Nova design enabled if they fail permanently or frequently: follow-up 3\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314428\n", "files": ["browser/components/customizableui/test/browser.toml", "devtools/client/framework/browser-toolbox/test/browser.toml", "devtools/shared/webconsole/test/chrome/chrome.toml", "gfx/layers/apz/test/mochitest/mochitest.toml", "testing/web-platform/meta/uievents/order-of-events/mouse-events/wheel-multiple-sources-deadlock.html.ini", "toolkit/components/extensions/test/browser/browser.toml", "toolkit/components/extensions/test/mochitest/mochitest-common.toml"], "git_node": "f7f30d78635e49277b8b3658f915be4367c06a6e", "git_parents": ["fb9105edf652e33c8d43e3e0f062e5b5baf156e0"], "node": "b72fe3b0c972b60ea7f2b059e9d3157764bc5cc8", "parents": ["895bf08285d17624bfdc8c4fcea5a795710aca35"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2054671 - ValidatePrincipal in PLockManager, r=dom-core-reviewers,edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313529\n", "files": ["dom/locks/LockManager.cpp", "ipc/glue/BackgroundParentImpl.cpp"], "git_node": "a2ee5ffa2d676e4a18274660bed742ca483a8e1f", "git_parents": ["f7f30d78635e49277b8b3658f915be4367c06a6e"], "node": "7b7051f3c6d7128b14367f64cc3789428e6c2a18", "parents": ["b72fe3b0c972b60ea7f2b059e9d3157764bc5cc8"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050797 - [devtools] Make the collapsible section headings keyboard accessible r=devtools-reviewers,nchevobbe\n\nNotables in this patch\n\n- Using the \u003cdetails\u003e\n- Stop the reducer cache from triggering updates back to the components\n  as expand/collapse is handled by the browser\n- Removed the animation as it was not working well with the new markup\n  and needed soem compx implementaion to work for its small subtle\n  effect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311471\n", "files": ["devtools/client/aboutdebugging/aboutdebugging.js", "devtools/client/aboutdebugging/src/components/RuntimePage.js", "devtools/client/aboutdebugging/src/components/debugtarget/DebugTargetPane.css", "devtools/client/aboutdebugging/src/components/debugtarget/DebugTargetPane.js", "devtools/client/aboutdebugging/src/reducers/ui-state.js", "devtools/client/aboutdebugging/test/browser/browser.toml", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_debug-target-pane_collapsibilities_interaction.js", "devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_debug-target-pane_collapsibilities_preference.js", "devtools/client/aboutdebugging/test/browser/head.js", "devtools/client/aboutdebugging/test/browser/helper-collapsibilities.js"], "git_node": "a122b1d7f1a3e54807a3eea8886d4f3118351ee1", "git_parents": ["a2ee5ffa2d676e4a18274660bed742ca483a8e1f"], "node": "3d57a830f067de3c1d52d6f3944971385e686147", "parents": ["7b7051f3c6d7128b14367f64cc3789428e6c2a18"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055305: Update smart window @mentions placeholder font color for Nova r=desktop-theme-reviewers,dao\n\nWe had the wrong font color for the @mentions placeholder on Nova, we get the value for \"free\" from the token `--text-color-deemphasized` so no need to override it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314098\n", "files": ["browser/components/multilineeditor/multiline-editor.css"], "git_node": "3806415cf255b3dc7c5d9e3a5a9e3966640a518d", "git_parents": ["a122b1d7f1a3e54807a3eea8886d4f3118351ee1"], "node": "072abf199a20d20c0b8f76bd6986b847cef66d9f", "parents": ["3d57a830f067de3c1d52d6f3944971385e686147"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027446 - Pages don't load when dom.ipc.useNativeEventProcessing.content=true r=mac-reviewers,mstange\n\nRemove unused/unsupported pref dom.ipc.useNativeEventProcessing.content on macOS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292041\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/xre/nsAppRunner.cpp"], "git_node": "86f69b5d80787f4e891f0c93534af7dc06b4f6ee", "git_parents": ["3806415cf255b3dc7c5d9e3a5a9e3966640a518d"], "node": "82f63cdd21317979da74d4931cf33b725d98b6d2", "parents": ["072abf199a20d20c0b8f76bd6986b847cef66d9f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057894 - Don't apply vertical-align to ::placeholder. r=dholbert,layout-reviewers,firefox-style-system-reviewers,dshin\n\nIn the regressing bug we did the same for line-height for similar\nreasons. In this case the site is setting vertical-align on\n::placeholder but expecting it not to have an effect.\n\nIt doesn't have an effect per spec:\n\n\u003e All properties that apply to the ::first-line pseudo-element also\n\u003e apply to the ::placeholder pseudo-element, except those defined in\n\u003e [CSS-INLINE-3].\n\nImplement that to the letter (which in practice only impacts\nvertical-align).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314283\n", "files": ["layout/style/test/property_database.js", "servo/components/style/properties/data.py", "testing/web-platform/tests/css/css-pseudo/placeholder-vertical-align-ref.html", "testing/web-platform/tests/css/css-pseudo/placeholder-vertical-align.html"], "git_node": "3d37da6a78fedc47a9b5b2f49d7690249711d2c1", "git_parents": ["86f69b5d80787f4e891f0c93534af7dc06b4f6ee"], "node": "64d487415d14f6bd8c3f84190b48c7c34ae8a078", "parents": ["82f63cdd21317979da74d4931cf33b725d98b6d2"], "tags": []}, {"author": "alin lastun \u003calastun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041496 - Fix VPN animation when coming back from settings. r=android-reviewers,twhite\n\nProblem:\n   When turning on the VPN in settings, the animation played in the background. When the user went back to the tab, the animation was already finished.\n\n   Solution:\n   - Do not mark the animation as shown in the background.\n   - Add an `onAnimationStarted` callback to `AnimatedPillActionRes`.\n   - Use `LaunchedEffect` in `ActionContainer` to run the animation only when the toolbar is visible on the screen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313694\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ActionContainer.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/concept/Action.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt"], "git_node": "aaf0c0fbb9de60d1403930d5c126275309131131", "git_parents": ["3d37da6a78fedc47a9b5b2f49d7690249711d2c1"], "node": "3a448421ba98784c4f7b7ef2c6d8dcc9dfb6b033", "parents": ["64d487415d14f6bd8c3f84190b48c7c34ae8a078"], "tags": []}, {"author": "Alex Cottner \u003cacottner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057028 - remove remote-settings v2 switches as v1 options will be replaced by v2 in application-services PR 7492 r=leplatrem,android-reviewers,matt-tighe\n\nWe are removing the v1 service options in the application-services [PR 7492](https://github.com/mozilla/application-services/pull/7492).\nThis patch should be merged before or with that change to prevent breaking changes.\nThis patch is a revert of D296461, which added the v2 switches/support in the first place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313608\n", "files": ["mobile/android/android-components/components/support/remotesettings/src/main/java/mozilla/components/support/remotesettings/RemoteSettingsServer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/RemoteSettingsServerFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/arrays.xml", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/remote_settings_server_preferences.xml"], "git_node": "bef729469668f412fb5cd54d419170accb33a130", "git_parents": ["aaf0c0fbb9de60d1403930d5c126275309131131"], "node": "e89357c1f2e55ac335b5a6e8f0060c6d45e236bf", "parents": ["3a448421ba98784c4f7b7ef2c6d8dcc9dfb6b033"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056188 - Flip the global nova pref for Nightly only r=sthompson\" for causing mochitests failures.\n\nThis reverts commit 74e96457b17e22a4ca2949951d7aa4b2a5472ce5.\n", "files": ["browser/app/profile/firefox.js"], "git_node": "27073064e172ee2ccb520aa9aecd0a63f8667453", "git_parents": ["bef729469668f412fb5cd54d419170accb33a130"], "node": "251a22acfd8b9e4c0bff0ea66b4cb1a895a994a6", "parents": ["e89357c1f2e55ac335b5a6e8f0060c6d45e236bf"], "tags": []}, {"author": "mimi \u003cmjung@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946565 - ASRouter Devtools Part 2: Remove duplicate, redundant or unused paneltestprovider messages r=omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312593\n", "files": ["browser/components/asrouter/content-src/components/ASRouterAdmin/ASRouterAdmin.jsx", "browser/components/asrouter/content/asrouter-admin.bundle.js", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_toast_notification-gif.js", "browser/components/asrouter/tests/browser/browser_asrouter_toast_notification.js"], "git_node": "ee38be27ae272934a1926cbd1a99bc671e6460ac", "git_parents": ["27073064e172ee2ccb520aa9aecd0a63f8667453"], "node": "1d5585536ce658a1153ab32412f84fb1175926b1", "parents": ["251a22acfd8b9e4c0bff0ea66b4cb1a895a994a6"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056188 - Flip the global nova pref for Nightly only r=sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313755\n", "files": ["browser/app/profile/firefox.js"], "git_node": "875e08048ab5ad92c1d012ef82eb41bf5c99773e", "git_parents": ["ee38be27ae272934a1926cbd1a99bc671e6460ac"], "node": "654f80944a6e300c9b3a956943ef87876d33ecec", "parents": ["1d5585536ce658a1153ab32412f84fb1175926b1"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2057902 - skip tests with Nova design enabled if they fail permanently or frequently: browser_test_position_sticky.js\n", "files": ["gfx/layers/apz/test/mochitest/browser.toml"], "git_node": "7398dbc78df0e3ebc6f4eca2f9382d2139fd4646", "git_parents": ["875e08048ab5ad92c1d012ef82eb41bf5c99773e"], "node": "51f945bf