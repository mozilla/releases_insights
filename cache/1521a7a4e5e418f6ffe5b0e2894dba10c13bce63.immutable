com/D316343\n", "files": ["browser/components/aiwindow/models/memories/MemoriesManager.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_MemoriesManager.js", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_ChatConversation.js"], "git_node": "a0dd3be2570eb72457915e884c49ec4e72d58e2e", "git_parents": ["ac63c2390c862911a84fb273bf8d87368ff8eefc"], "node": "bc5385b8b44f59db6f65e0746e62bf8cb96f9991", "parents": ["0b9452232ae9411fcaa0450bcb5fbe7b57e83170"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057897 - Unskip browser_auth.js on Nova builds while keeping skip-if restricted to linux22.04 wayland jobs. r=zombie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316840\n", "files": ["toolkit/mozapps/extensions/test/xpinstall/browser.toml"], "git_node": "3e2d1e5abd6b50835d48915e7335f239732ef912", "git_parents": ["a0dd3be2570eb72457915e884c49ec4e72d58e2e"], "node": "f85df10fde002f3ef88c633b9897e108c341aaff", "parents": ["bc5385b8b44f59db6f65e0746e62bf8cb96f9991"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057928 - Re-enable browser_ext_webNavigation_bookmark_transitions.js on Nova and linux a11y_checks jobs. r=zombie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316853\n", "files": ["browser/components/extensions/test/browser/browser.toml"], "git_node": "a0b9aeb9a2f41dda6e17306a4f6f7608a40214d9", "git_parents": ["3e2d1e5abd6b50835d48915e7335f239732ef912"], "node": "ed5ac7eae2ff91f1c70f931a8645a73513ec180c", "parents": ["f85df10fde002f3ef88c633b9897e108c341aaff"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059883 - Part 1: Disable extensions.formautofill.useml on Linux r=rrando,NeilDeakin\n\nThe native ONNX path does not yet work on Linux machines,\nand we would like to avoid the WASM path entirely for now,\nso it makes sense to leave this pref as `false` on Linux.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316639\n", "files": ["modules/libpref/init/all.js"], "git_node": "c495c042d0e80b241ce322250f9ccc94e4008b4f", "git_parents": ["a0b9aeb9a2f41dda6e17306a4f6f7608a40214d9"], "node": "f1b29dd04a218dac217d4148e06e9ce9e44c508b", "parents": ["ed5ac7eae2ff91f1c70f931a8645a73513ec180c"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059883 - Part 2: Use two threads for form autofill ML inference r=rrando,credential-management-reviewers,NeilDeakin\n\nThis commit ensures that if the WASM path were to run, it would only\nspin up two workers, rather than being bounded by CPU concurrency.\nThe WASM path still uses quite a bit of memory even with only two\nworkers, which is why we are avoiding it for the time being, but\nif it were to run, two workers is better than the default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316640\n", "files": ["toolkit/components/formautofill/shared/FormAutofillML.sys.mjs"], "git_node": "588dcd1dbc96d713e414fd457052a96c067ad6cb", "git_parents": ["c495c042d0e80b241ce322250f9ccc94e4008b4f"], "node": "36bce3c332b4b4f3cd66f2294c68a55a2cb2bc18", "parents": ["f1b29dd04a218dac217d4148e06e9ce9e44c508b"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059883 - Part 3: Use form autofill ML only when native ONNX is available r=NeilDeakin,credential-management-reviewers,rrando,nordzilla\n\nAt startup the parent process asks the inference process whether the\nnative ONNX runtime is available and records the answer in\nextensions.formautofill.useml.nativeOnnxAvailable.\n\nThis commit ensures that form autofill will only use ML inference\nwhen the native ONNX runtime is available, otherwise it will use\nthe regex classification paths.\n\nNote that it is still possible to fall back to the ONNX WASM path\nin the case where native ONNX is available, but genuinely fails\nwith an error. This case should be very rare, if it happens at all.\n\nDepends on D316640\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317006\n", "files": ["browser/extensions/formautofill/api.js", "modules/libpref/init/all.js", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs"], "git_node": "b27cd70164d313d58f746d564395d15e8db44e42", "git_parents": ["588dcd1dbc96d713e414fd457052a96c067ad6cb"], "node": "7e849b377219f9a60427c5da07c3816c8b8e2825", "parents": ["36bce3c332b4b4f3cd66f2294c68a55a2cb2bc18"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059883 - Part 4: Introduce native ONNX availability test r=rrando,credential-management-reviewers,NeilDeakin\n\nThis commit introduces a new test case to ensure that the native ONNX\navaiability correctly influences whether form autofill utilizes machine\nlearning vs. regex for classification.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317116\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_ml_heuristics.js", "browser/extensions/formautofill/test/browser/browser_ml_native_onnx_availability.js", "browser/extensions/formautofill/test/browser/head.js"], "git_node": "e2230f631fc5b3109220eec68fb358961c6f9fdc", "git_parents": ["b27cd70164d313d58f746d564395d15e8db44e42"], "node": "3e615463ee982e4d455ec9673e8a1ae64d2d1164", "parents": ["7e849b377219f9a60427c5da07c3816c8b8e2825"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057845 - Unskip browser_ext_windows_create.js on Nova builds while keeping skip-if restricted to linux22.04 wayland jobs. r=zombie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316890\n", "files": ["browser/components/extensions/test/browser/browser-windows.toml"], "git_node": "dc057d5aaa04b8ad4a40e195039f2f0142cec967", "git_parents": ["e2230f631fc5b3109220eec68fb358961c6f9fdc"], "node": "50e6d4e0ee83f73aad16b728a47e1bc8a9c37664", "parents": ["3e615463ee982e4d455ec9673e8a1ae64d2d1164"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047802 - test SampleBuffer bounds validation. r=geckoview-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307894\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/SampleBufferTest.kt"], "git_node": "2bf1683ce56ebe2e46e27e72ec9779d0c0f5e9ac", "git_parents": ["dc057d5aaa04b8ad4a40e195039f2f0142cec967"], "node": "f849335a230101fbd76209f02058c3bb2f648482", "parents": ["50e6d4e0ee83f73aad16b728a47e1bc8a9c37664"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062364 - Only require fetched newtab-node-modules when the task provides fetches. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317594\n", "files": ["browser/extensions/newtab/build-newtab-bundles.py"], "git_node": "5243d39ace9a990aae67a43f1fec750796ec35c0", "git_parents": ["2bf1683ce56ebe2e46e27e72ec9779d0c0f5e9ac"], "node": "e01d55323713f1234c36450467364e763985a3b3", "parents": ["f849335a230101fbd76209f02058c3bb2f648482"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062065 - Support masks with image sources for non-pixel-backed canvases. r=emilio\n\nCurrently it is unsupported to use a mask operation with an image source for Mask,\nMaskSurface, or PushLayer if the canvas is not pixel-backed. This implements fallbacks\nfor those cases to better support mask operations in SkPDF.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317393\n", "files": ["gfx/2d/DrawTargetSkia.cpp", "gfx/2d/DrawTargetSkia.h", "gfx/skia/skia/src/pdf/SkPDFDevice.cpp"], "git_node": "b816256dcd53cf5fc8757107d544f0748217a52d", "git_parents": ["5243d39ace9a990aae67a43f1fec750796ec35c0"], "node": "662e3aea51a9517524dcda257790456109710fab", "parents": ["e01d55323713f1234c36450467364e763985a3b3"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062198 - Use an 8-bit string as param to MakeUniqueUserFontName. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317437\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFontUtils.cpp", "gfx/thebes/gfxFontUtils.h"], "git_node": "d52c02eb537804e6bbbf11fa05eac32223018967", "git_parents": ["b816256dcd53cf5fc8757107d544f0748217a52d"], "node": "ff2f4806e72341cc8526115eed433835ab28aaa1", "parents": ["662e3aea51a9517524dcda257790456109710fab"], "tags": []}, {"author": "DrSeed Lu \u003cdr.seed.lu@gmail.com\u003e", "branch": "default", "desc": "Bug 2039601 - Add a hover preview of recently active tabs to the sidebar open tabs button r=nsharpley,kcochrane,fluent-reviewers,desktop-theme-reviewers,flod\n\nHovering the Open Tabs button in the sidebar launcher now shows a preview\nof the five most recently active tabs. Tabs with audio are listed first and\ncarry a button that mutes or unmutes them, rows reveal a close button on hover,\nand \"Show all\" opens the Open Tabs panel.\n\nThe preview is a Lit component in a panel beside the tools overflow\npanel. It opens after ui.tooltip.delay_ms and stays open briefly after\nthe pointer leaves the button so the pointer can reach it, matching the\ntab strip hover preview.\n\nsidebar.openTabsPanel.hoverPreview.enabled defaults to true. Bug 2039602\nadds the setting for it in Customize Sidebar.\n\n\"Show all\" reuses firefoxview-show-all, which is already loaded in\nthe chrome document. Tabs that are playing audio or muted are floated to\nthe top of the five most recent tabs, rather than pulled in from outside that set.\nMuted tabs float too, so that muting from the preview does not make the row jump out\nfrom under the pointer. The preview is not keyboard reachable, matching the tab strip preview.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316309\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/main-popupset.inc.xhtml", "browser/components/sidebar/jar.mn", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/sidebar-opentabs-preview.css", "browser/components/sidebar/sidebar-opentabs-preview.mjs", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/sidebar/tests/browser/browser_opentabs_hover_preview.js", "browser/locales/en-US/browser/sidebar.ftl"], "git_node": "53dffcc2f5cab29d48c52e8df753ff205b837246", "git_parents": ["d52c02eb537804e6bbbf11fa05eac32223018967"], "node": "ab34a3bbd300900ab45ab6a8c5e2f019cc04f78a", "parents": ["ff2f4806e72341cc8526115eed433835ab28aaa1"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059824 - Make gfxUserFontEntry retain ownership of webfont data after sanitization. r=layout-reviewers,gfx-reviewers,emilio,lsalzman\n\nRather than passing ownership of the memory buffer in to the various per-platform\nimplementations of MakePlatformFont, some of which end up holding it behind opaque\nplatform objects, we retain ownership of the buffer in gfxUserFontEntry and share\na reference to it with the platform backends.\n\nThis will allow us to easily instantiate a (platform-independent) Skrifa font ref\nbased on the same buffer, without needing to duplicate potentially large amounts\nof font data for Skrifa vs platform backend use.\n\nThe MakePlatformFont implementations are updated to accept a reference to a\nrefcounted FontData struct that wraps the data buffer & length. The user font entry\ncreates and initially owns this, but backends can also hold a reference for as\nlong as they need to guarantee that the data remains available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317440\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/2d/NativeFontResourceFreeType.cpp", "gfx/2d/NativeFontResourceFreeType.h", "gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/CoreTextFontList.h", "gfx/thebes/FontData.h", "gfx/thebes/gfxDWriteCommon.cpp", "gfx/thebes/gfxDWriteCommon.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "gfx/thebes/gfxPlatformFontList.h", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h", "gfx/thebes/moz.build", "layout/style/nsFontFaceLoader.cpp"], "git_node": "304f449f786f218328be9375bed26841cdedb9fc", "git_parents": ["53dffcc2f5cab29d48c52e8df753ff205b837246"], "node": "04b0e3278023edb3cb9507060b13839d9ae17eab", "parents": ["ab34a3bbd300900ab45ab6a8c5e2f019cc04f78a"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061901 - re-enable ecdsa/sha1 signature scheme in nightly for now r=nkulatova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317222\n", "files": ["security/manager/ssl/EnabledSignatureSchemes.h"], "git_node": "5c949ed211c1bbc89ad62429a378b7acaee0f7e7", "git_parents": ["304f449f786f218328be9375bed26841cdedb9fc"], "node": "146719b1a72c8b5e827a643b751c7dcbddd937bf", "parents": ["04b0e3278023edb3cb9507060b13839d9ae17eab"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2062065 - Support masks with image sources for non-pixel-backed canvases. r=emilio\" for causing backout conflicts.\n\nThis reverts commit b816256dcd53cf5fc8757107d544f0748217a52d.\n", "files": ["gfx/2d/DrawTargetSkia.cpp", "gfx/2d/DrawTargetSkia.h", "gfx/skia/skia/src/pdf/SkPDFDevice.cpp"], "git_node": "a76f69594da3158afb133aa0fcc687fcd18968ee", "git_parents": ["5c949ed211c1bbc89ad62429a378b7acaee0f7e7"], "node": "57a61a495ab041d46dd4c18d16057c67d62e6363", "parents": ["146719b1a72c8b5e827a643b751c7dcbddd937bf"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061173 - Avoid using clip shaders for mask applied to solid color. r=emilio\" for causing failures at browser_urlbar_keyed_search.js.\n\nThis reverts commit ac63c2390c862911a84fb273bf8d87368ff8eefc.\n", "files": ["gfx/2d/DrawTargetSkia.cpp"], "git_node": "c451a9fd311dbd107c43410bf6567466075e8f8f", "git_parents": ["a76f69594da3158afb133aa0fcc687fcd18968ee"], "node": "5d703df1f3451f3fce8aeee68ca639f08b0df7fb", "parents": ["57a61a495ab041d46dd4c18d16057c67d62e6363"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061633 - Revert Bug 2022527, fix an issue in browser_tokenAlias.js and adjust browser_searchbar_new.js. r=urlbar-reviewers,dao\" for causing failures at browser_startup_flicker.js.\n\nThis reverts commit 8accab4a4eb856985ffd9d0ca29fe1f8f3c2711f.\n", "files": ["accessible/tests/browser/tree/browser_searchbar_new.js", "browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/components/urlbar/tests/browser/browser_tokenAlias.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_customizing_nobreakout.js"], "git_node": "c4a1bbc602c23e630672da0e4833bf6abbd0de38", "git_parents": ["c451a9fd311dbd107c43410bf6567466075e8f8f"], "node": "0b9ae88bff2377796622599342af60746308354e", "parents": ["5d703df1f3451f3fce8aeee68ca639f08b0df7fb"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054096: Develop prompting and code for new tab PUWYLO chip or card r=ai-platform-reviewers,ai-security-reviewers,cdipersio,thasan,tetchart\" for causing failures at browser_test_swipe_gesture.js.\n\nThis reverts commit db2d8e456cb1e21f840a2ba9c27dead862a14e49.\n", "files": ["browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/ConversationSuggestions.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesChatSource.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesHistorySource.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_conversation_starters.js", "toolkit/components/ml/content/EngineProcess.sys.mjs"], "git_node": "a8f66008ed504c62b422c7bac8e89b301833e4ce", "git_parents": ["c4a1bbc602c23e630672da0e4833bf6abbd0de38"], "node": "fdd1dc86be42ee80a987f46f603076e16d74a819", "parents": ["0b9ae88bff2377796622599342af60746308354e"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059824 - Make gfxUserFontEntry retain ownership of webfont data after sanitization. r=layout-reviewers,gfx-reviewers,emilio,lsalzman\" for causing build bustages in NativeFontResourceFreeType.cpp\n\nThis reverts commit 304f449f786f218328be9375bed26841cdedb9fc.\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/2d/NativeFontResourceFreeType.cpp", "gfx/2d/NativeFontResourceFreeType.h", "gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/CoreTextFontList.h", "gfx/thebes/FontData.h", "gfx/thebes/gfxDWriteCommon.cpp", "gfx/thebes/gfxDWriteCommon.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "gfx/thebes/gfxPlatformFontList.h", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h", "gfx/thebes/moz.build", "layout/style/nsFontFaceLoader.cpp"], "git_node": "95c14640868b99ce0c1098bfe66d209f2a8ee7af", "git_parents": ["a8f66008ed504c62b422c7bac8e89b301833e4ce"], "node": "930b9bc50fc9c1ac01cab3c16f84ef37e8fee54e", "parents": ["fdd1dc86be42ee80a987f46f603076e16d74a819"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048276 - Schedule BHR aggregation daily on TaskCluster r=dthayer\n\nAdd a cron-scheduled TaskCluster job that runs the BHR aggregation in a\ncustom Docker image. The container authenticates to BigQuery headlessly\nwith a GCP service-account JSON pulled from a TaskCluster secret via the\ntaskcluster-proxy (no interactive gcloud login), and publishes the\ndashboard JSON as a public artifact indexed at\ngecko.v2.\u003cproject\u003e.latest.firefox.bhr-aggregate.\n\nPieces:\n- taskcluster/scripts/bhr-aggregate.py: container entry point\n- taskcluster/docker/bhr-aggregate/: image + python deps\n- taskcluster/kinds/bhr-aggregate/kind.yml: the task\n- docker-image + target_tasks + .cron.yml: registration and daily schedule\n- build/sparse-profiles/bhr-aggregate: minimal sparse checkout\n\nThe secret is project/bhr/aggregation-gcp-key, created for this job in\nbug 2056977. RelEng granted secrets:get:project/bhr/* to cron:bhr-aggregate\n(trust domain gecko, level 3, mozilla-central) in fxci-config PR #1097.\n\nThe secret name is a fixed constant on both the kind's scope and the\nscript's default, deliberately not templated on MOZ_SCM_LEVEL. No level-1\nsecret name exists, so anything other than the level-3 mozilla-central\ncron fails closed on a scope it cannot hold rather than resolving to some\nother secret. This job must never be reachable from try: try is level 1\nand runs contributor code, and the credential reads production data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315102\n", "files": [".cron.yml", "build/sparse-profiles/bhr-aggregate", "taskcluster/docker/bhr-aggregate/Dockerfile", "taskcluster/docker/bhr-aggregate/requirements.txt", "taskcluster/docs/kinds.md", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/bhr-aggregate/kind.yml", "taskcluster/kinds/docker-image/kind.yml", "taskcluster/scripts/bhr-aggregate.py"], "git_node": "457b915ba271f6e3eb3b3e7e9376b9c3420306e6", "git_parents": ["95c14640868b99ce0c1098bfe66d209f2a8ee7af"], "node": "0bb84a194bd7b62417504e03b4cc3f0a50d41e2b", "parents": ["930b9bc50fc9c1ac01cab3c16f84ef37e8fee54e"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048276 - Read BHR pings from the firefox_desktop.hang_report view r=dthayer\n\nData Engineering manages BigQuery access for the CI service account through\nthe firefox_desktop.hang_report view rather than the underlying\nfirefox_desktop_stable.hang_report_v1 table. The view has the same schema, so\nthe query is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315103\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_collection.py"], "git_node": "20a50d10332d2119586c1f3b91cabaa80c1f35c3", "git_parents": ["457b915ba271f6e3eb3b3e7e9376b9c3420306e6"], "node": "58f1ca55ddd169a7a6e8fb3cae92bad4d4b8c3d7", "parents": ["0bb84a194bd7b62417504e03b4cc3f0a50d41e2b"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048276 - Request an explicit scope when checking GCP credentials r=dthayer\n\ngoogle.auth.default() returns a service-account key unscoped, and\nrefreshing an unscoped service account raises RefreshError, so the\npreflight check reported \"credentials are missing or expired\" for a\ncredential that was in fact valid. Only user credentials from\n`gcloud auth application-default login` worked, because those arrive\nalready scoped.\n\nThis matters for testing the TaskCluster cron: pointing\nGOOGLE_APPLICATION_CREDENTIALS at the job's service-account key is how\nyou verify the credential the cron will actually use, and that path was\nunreachable. The error message also pointed at\n`gcloud auth application-default login`, which would overwrite the\ndeveloper's own credentials without addressing the problem.\n\nOnly the preflight was affected; bigquery.Client() resolves its own\nscopes, so the aggregation itself always worked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315104\n", "files": ["toolkit/components/backgroundhangmonitor/mach_commands.py"], "git_node": "970f45000d5d52ca5336f293317ba1a1578d121d", "git_parents": ["20a50d10332d2119586c1f3b91cabaa80c1f35c3"], "node": "8a62beb9089e291f5cc53023b4b098e3a2827124", "parents": ["58f1ca55ddd169a7a6e8fb3cae92bad4d4b8c3d7"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052961 - Reconstruct inlined frames during BHR symbolication r=dthayer\n\nParse the INLINE and INLINE_ORIGIN records in breakpad .sym files so a code\naddress that lands inside inlined code resolves to its full source-level chain\n(the enclosing FUNC followed by each inlined callee, outer first) instead of\njust the enclosing function. Inline records are parsed in a targeted second\npass, only for the functions the requested offsets land in, so the large number\nof INLINE records in a debug .sym does not slow symbolication down.\n\nsymbolicate_stacks now splices the reconstructed chain into the stack in place,\nso the aggregated hang signatures reflect the source-level call path. Total hang\ntime and count are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311151\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/symbolication.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/fixtures/example.sym", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_symbolication.py"], "git_node": "a5b9b60793cb46fe929f29244a7aaaba08cdf842", "git_parents": ["970f45000d5d52ca5336f293317ba1a1578d121d"], "node": "3fd6f3cdda8abbcbb225d8a84b5d451ede426309", "parents": ["8a62beb9089e291f5cc53023b4b098e3a2827124"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062254 - Fix about:translations port reacquisition (quick fix) r=translations-reviewers,gregtatum\n\nThis commit fixes an issue where about:translations attempts to reuse\na port after its TranslationsEngine is destroyed and the port is closed.\nThe Translator now acquires a new port each time before starting a\nnew batch of translation requests.\n\nSince Translator is only used by about:translations and SelectTranslations,\nthis should not affect the performance of FullPageTranslations. Even so\nthe performance hit of creating a new port is fairly minimal compared to\nthe correctness it will provide in the near term.\n\nThis commit is intended for Beta uplift.\n\nThe following commit contains a more robust fix for notifying features of\nengine termination that will fully ride the release trains.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317555\n", "files": ["toolkit/components/translations/content/Translator.mjs", "toolkit/components/translations/tests/browser/browser.toml", "toolkit/components/translations/tests/browser/browser_about_translations_engine_destroy.js"], "git_node": "2f2b483d779b052367e59b456a5c01d3e9fb0552", "git_parents": ["a5b9b60793cb46fe929f29244a7aaaba08cdf842"], "node": "3ca3f4298d8c8b1494cf61f1f2cc55f4de594584", "parents": ["3fd6f3cdda8abbcbb225d8a84b5d451ede426309"], "tags": []}, {"author": "Nora Liu \u003cnliu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062405 - Fix typo in emitWeapMapBarrierFastPath. r=tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317650\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h"], "git_node": "8ccdf5d49d6a350e7207584a0bdef234dfecad00", "git_parents": ["2f2b483d779b052367e59b456a5c01d3e9fb0552"], "node": "d48d996b9fb43ddda176349c7753802c5aaf8eac", "parents": ["3ca3f4298d8c8b1494cf61f1f2cc55f4de594584"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059498 - Fix stale browser reference in reused feature callouts. r=omc-reviewers,mimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317130\n", "files": ["browser/components/asrouter/modules/FeatureCalloutBroker.sys.mjs", "browser/components/asrouter/tests/browser/browser_feature_callout_in_chrome.js"], "git_node": "625736b8e1b7fc9e856d7339c701b3712ab310b2", "git_parents": ["8ccdf5d49d6a350e7207584a0bdef234dfecad00"], "node": "a2b2eb3717dce8c4771bb179a0660ae079d9b7d4", "parents": ["d48d996b9fb43ddda176349c7753802c5aaf8eac"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060262 - Improve Precision Configs for Auto Tab Grouping Clustering. r=mshillabeer\n\nThis patch improves the group cohesion and ensures that we show fewer, more precise groups.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317651\n", "files": ["browser/app/profile/firefox.js"], "git_node": "b1b49855721b2555694916b27128f378983586e4", "git_parents": ["625736b8e1b7fc9e856d7339c701b3712ab310b2"], "node": "b3b8b2a0b2743272773d87ae00058c8a87ecd5d7", "parents": ["a2b2eb3717dce8c4771bb179a0660ae079d9b7d4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062145 - Close the panels webextension tests leave open, r=extension-reviewers,rpl.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317404\n", "files": ["browser/components/extensions/test/browser/browser_always_on_pbm_prompt.js", "browser/components/extensions/test/browser/browser_ext_browserAction_contextMenu.js", "browser/components/extensions/test/browser/browser_ext_browserAction_disabled.js", "browser/components/extensions/test/browser/browser_ext_tabs_hide_update.js", "browser/components/extensions/test/browser/browser_ext_tabs_sharingState.js", "browser/components/extensions/test/browser/head.js"], "git_node": "e94cfb4d3c891593e95a7f87b7b864f7a134387f", "git_parents": ["b1b49855721b2555694916b27128f378983586e4"], "node": "275c525544aa2f0b09357f0b57c6a435f8871a02", "parents": ["b3b8b2a0b2743272773d87ae00058c8a87ecd5d7"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062145 - Close the doorhanger and the context menu these urlbar tests leave open, r=urlbar-reviewers,daleharvey.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317406\n", "files": ["browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_newBadge.js"], "git_node": "7095376daecfb9dc7d75f3fdc88e30ab7e532fe5", "git_parents": ["e94cfb4d3c891593e95a7f87b7b864f7a134387f"], "node": "dbe9c426130cc186a2fe600c82858333ab9e9490", "parents": ["275c525544aa2f0b09357f0b57c6a435f8871a02"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062145 - Wait for the add-on install doorhanger to be taken down, r=rpl.\n\nalwaysAcceptAddonPostInstallDialogs() removes its popupshown listener in its\nown cleanup function, and cleanups run in registration order, so on Windows the\ndoorhanger can arrive after the listener that would accept it is gone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317407\n", "files": ["dom/midi/tests/browser_midi_permission_gated.js"], "git_node": "0e16514d9e3ce19845bd9f4b8e41ece3eb195829", "git_parents": ["7095376daecfb9dc7d75f3fdc88e30ab7e532fe5"], "node": "87a9dfc6fbdafbad2ad93c169478598213bd9796", "parents": ["dbe9c426130cc186a2fe600c82858333ab9e9490"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062145 - Close the identity popup at the end of browser_identityPopup_clearSiteData_extensions.js, r=firefox-desktop-core-reviewers ,mossop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317408\n", "files": ["browser/base/content/test/siteIdentity/browser_identityPopup_clearSiteData_extensions.js"], "git_node": "b1fc29ae460322e83401355e6c016909644df851", "git_parents": ["0e16514d9e3ce19845bd9f4b8e41ece3eb195829"], "node": "ab40be37ff74e4cab3cce98bf76f224363b26b54", "parents": ["87a9dfc6fbdafbad2ad93c169478598213bd9796"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062145 - Close the bookmark menupopups browser_recursive_hierarchies.js opens, r=places-reviewers,Standard8.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317409\n", "files": ["browser/components/places/tests/browser/browser_recursive_hierarchies.js"], "git_node": "38326e3533e22cbe77bae05bcb0146d637124d95", "git_parents": ["b1fc29ae460322e83401355e6c016909644df851"], "node": "b1456af29adf0b59a99374e0a3f20c0ae667aca8", "parents": ["ab40be37ff74e4cab3cce98bf76f224363b26b54"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2061883 - Remove the unused _notifyCategoryAndObservers from SpecialPowersParent.sys.mjs. r=ahal DONTBUILD\n\nThis uses a dodgy heuristic to decide if a contract ID is for a service and isn't used,\nso let's remove it. The last use of this was removed in bug 1318206 as part of post-B2G\ncleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317200\n", "files": ["testing/specialpowers/content/SpecialPowersParent.sys.mjs"], "git_node": "d0b798710caf124628b55b7fdbcafb3e29c1ef17", "git_parents": ["38326e3533e22cbe77bae05bcb0146d637124d95"], "node": "b0035b53d743f0476e6085047f2bc29132795e4b", "parents": ["b1456af29adf0b59a99374e0a3f20c0ae667aca8"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2061887 - Make the category entry for ProfileAfterChangeGate more normal. r=timhuang\n\nThis is only used for error logging, the profiler, and to determine\nthe order of the notifications. Hopefully we're not depending on\nthe last one here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317201\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/components.conf"], "git_node": "830faeb114171f87895f2b9560be6a27cf6420dc", "git_parents": ["d0b798710caf124628b55b7fdbcafb3e29c1ef17"], "node": "f6519cf52cf89c3be78393d250d4d9e561d2c798", "parents": ["b0035b53d743f0476e6085047f2bc29132795e4b"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059951: Update irregexp to 0218677be4a45d5394faa541b6ec74b05def1261 r=dminor\n\nPatch summary:\n- Adds a new optimization to make greedy loops faster: no work needed on our part\n- Improves quick checks using a first-character membership table: no work needed on our part\n- Adds tableswitch support: requires backend to opt in. Opened bug 2061825.\n- Adds backtrack-stack elision (speeds up regexps with no backtracking): requires backend to opt in. Opened bug 2061826.\n- Adds support for initial quick-check filters that can be cheaply tested before executing the regexp: Opened bug 2060702\n- Removes experimental bytecode analysis\n- Fixes some small correctness issues involving modifier flags being reset appropriately\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317153\n", "files": ["js/src/irregexp/imported/regexp-ast.h", "js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecode-peephole.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-bytecodes.cc", "js/src/irregexp/imported/regexp-bytecodes.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-compiler-tonode.cc", "js/src/irregexp/imported/regexp-compiler.cc", "js/src/irregexp/imported/regexp-compiler.h", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-macro-assembler.h", "js/src/irregexp/imported/regexp-nodes.h", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h", "js/src/irregexp/moz.yaml"], "git_node": "3806ed99457a0c47c9a4b68a08778a1d19c67983", "git_parents": ["830faeb114171f87895f2b9560be6a27cf6420dc"], "node": "44b3f42618e3541a048fefb64aa685a8a1922cc5", "parents": ["f6519cf52cf89c3be78393d250d4d9e561d2c798"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059951: Fix patch r=dminor\n\nThe patch metadata was wrong, so it didn't apply.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317154\n", "files": ["js/src/irregexp/patches/icu4x.patch"], "git_node": "0e802fcf929af2ea0118c51947fef9d5fe6b4687", "git_parents": ["3806ed99457a0c47c9a4b68a08778a1d19c67983"], "node": "d5d81a2edf48a375e173991f91b6b92f8efe7b82", "parents": ["44b3f42618e3541a048fefb64aa685a8a1922cc5"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059951: Remove obsolete patch r=dminor\n\nUpstream V8 abandoned the bytecode analysis prototype and deleted the code, so we no longer need this.\n\nPart of this patch #ifdef'd out a call to RegExpBytecodeDisassemble, because it used BytecodeAnalysis internally. Now that it's been removed, it's easier to just compile RegExpBytecodeDisassemble (in imported/regexp-bytecodes.cc).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317155\n", "files": ["js/src/irregexp/moz.build", "js/src/irregexp/patches/disable-bytecode-analysis.patch"], "git_node": "90e3b9031db77720d4df084b0fb087a813a97716", "git_parents": ["0e802fcf929af2ea0118c51947fef9d5fe6b4687"], "node": "2113b2012d0a383b39658ea77533f2443891b7d5", "parents": ["d5d81a2edf48a375e173991f91b6b92f8efe7b82"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059951: Apply mozilla patches for irregexp r=dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317156\n", "files": ["js/src/irregexp/imported/regexp-bytecode-generator.cc", "js/src/irregexp/imported/regexp-bytecodes-inl.h", "js/src/irregexp/imported/regexp-code-generator.cc", "js/src/irregexp/imported/regexp-graph-printer.cc", "js/src/irregexp/imported/regexp-interpreter.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.cc", "js/src/irregexp/imported/regexp-macro-assembler-tracer.h", "js/src/irregexp/imported/regexp-macro-assembler.cc", "js/src/irregexp/imported/regexp-parser.cc", "js/src/irregexp/imported/regexp-stack.cc", "js/src/irregexp/imported/regexp-stack.h"], "git_node": "9e57d3b85e6623c2024c2d1c32d419ce2cd22c0a", "git_parents": ["90e3b9031db77720d4df084b0fb087a813a97716"], "node": "8bf90df4d919bd3287fb82f4ea07b5022375f80a", "parents": ["2113b2012d0a383b39658ea77533f2443891b7d5"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059951: Add quickcheck stubs r=dminor\n\nThe definition of V8_TARGET_LITTLE_ENDIAN is necessary because part of the definition of the quickcheck code in regexp-compiler.cc is behind an #ifdef.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317157\n", "files": ["js/src/irregexp/RegExpShim.h"], "git_node": "5375f1a01c40684a8fe5320339bcc906d8837866", "git_parents": ["9e57d3b85e6623c2024c2d1c32d419ce2cd22c0a"], "node": "51afc8cbd174ef46b7a54a4540e6971532395757", "parents": ["8bf90df4d919bd3287fb82f4ea07b5022375f80a"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2059951: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/irregexp/RegExpShim.h"], "git_node": "359ab0323379b0f997a21bb2703c0282f78ce739", "git_parents": ["5375f1a01c40684a8fe5320339bcc906d8837866"], "node": "dda88725d476eef3bf6a220b2379c7cc6611cb44", "parents": ["51afc8cbd174ef46b7a54a4540e6971532395757"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061895: Refactor SplitHelper to better match spec r=spidermonkey-reviewers,jandem\n\nThis patch started as an attempt to add a fast path to String.split in cases where there were no matches. On review, Claude mentioned that I had detached the 'Our match algorithm' comment from its referent. When I tried to figure out where it should actually go, I realized that a bunch of the code in this function is a vestigial leftover from the time when it also handled regexp splitting. Our callers already handle the empty separator, so we don't need any special handling for zero-length matches.\n\nI rewrote the code to better match the current version of the spec, with the exception that the first match is hoisted outside the loop to save setup in the no-match case.\n\nThis is about 20% faster on a microbenchmark with no matches. I had Claude review the performance overall, and it confirmed that the new code executes fewer instructions in every test it tried.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317214\n", "files": ["js/src/builtin/String.cpp"], "git_node": "d3b5b259774670c374583f127d8ac1f3ef0fba55", "git_parents": ["359ab0323379b0f997a21bb2703c0282f78ce739"], "node": "bb2fce8177187c2c5842d6ddc4073520d888d3d6", "parents": ["dda88725d476eef3bf6a220b2379c7cc6611cb44"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062248  - Split the container test browser_siteContainer.js r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317566\n", "files": ["browser/components/contextualidentity/test/browser/browser.toml", "browser/components/contextualidentity/test/browser/browser_siteContainer.js", "browser/components/contextualidentity/test/browser/browser_siteContainer_eligibility.js", "browser/components/contextualidentity/test/browser/browser_siteContainer_redirect.js", "browser/components/contextualidentity/test/browser/browser_siteContainer_retarget.js", "browser/components/contextualidentity/test/browser/browser_siteContainer_serviceworker.js", "browser/components/contextualidentity/test/browser/browser_siteContainer_webext.js", "browser/components/contextualidentity/test/browser/head_siteContainer.js"], "git_node": "cd1e0911bffc78342ae8d45b275145eb9894dd77", "git_parents": ["d3b5b259774670c374583f127d8ac1f3ef0fba55"], "node": "db644a595ab7623662a0c964abf81fd352c6b033", "parents": ["bb2fce8177187c2c5842d6ddc4073520d888d3d6"], "tags": []}, {"author": "Sebastian Zartner \u003csebastianzartner@gmail.com\u003e", "branch": "default", "desc": "Bug 1692434 - Renamed \"simulation\" to \"emulation\" for media emulations. r=devtools-reviewers,fluent-reviewers,devtools-backward-compat-reviewers,bolsson,nchevobbe\n\nWent all in on renaming \"simulation\" to \"emulation\" regarding media emulations within the Rules panel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308083\n", "files": ["devtools/client/aboutdebugging/test/browser/browser_aboutdebugging_addons_debug_inspector.js", "devtools/client/inspector/emulation/actions/emulation.js", "devtools/client/inspector/emulation/actions/index.js", "devtools/client/inspector/emulation/reducers/emulation.js", "devtools/client/inspector/index.xhtml", "devtools/client/inspector/rules/rules.js", "devtools/client/inspector/rules/test/browser_part1.toml", "devtools/client/inspector/rules/test/browser_part2.toml", "devtools/client/inspector/rules/test/browser_rules_color_scheme_emulation.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_emulation_bfcache.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_emulation_meta.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_emulation_rdm.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_emulation_rfp.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_bfcache.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_meta.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_rdm.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_rfp.js", "devtools/client/inspector/rules/test/browser_rules_light_dark.js", "devtools/client/inspector/rules/test/browser_rules_mark_overridden_refresh.js", "devtools/client/inspector/rules/test/browser_rules_print_media_emulation.js", "devtools/client/inspector/rules/test/browser_rules_print_media_simulation.js", "devtools/client/inspector/rules/test/doc_print_media_emulation.html", "devtools/client/inspector/rules/test/doc_print_media_simulation.html", "devtools/client/jar.mn", "devtools/client/themes/images/rules-view-dark-mode-emulation.svg", "devtools/client/themes/images/rules-view-dark-mode-simulation.svg", "devtools/client/themes/images/rules-view-light-mode-emulation.svg", "devtools/client/themes/images/rules-view-light-mode-simulation.svg", "devtools/client/themes/rules.css", "devtools/server/actors/target-configuration.js", "devtools/shared/specs/target-configuration.js"], "git_node": "16b345be915c8d7b043a86ad9a783e9ccc33542e", "git_parents": ["cd1e0911bffc78342ae8d45b275145eb9894dd77"], "node": "e22fe8125e76cab93a4bfbbf633d5567ffda9d58", "parents": ["db644a595ab7623662a0c964abf81fd352c6b033"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2062273 - XPCshell tests for MSIX must also target Windows 25H2. r=ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317538\n", "files": ["taskcluster/kinds/test/xpcshell.yml"], "git_node": "3b71d69cc15f1e340eba4b7ee8e0be3500805dcc", "git_parents": ["16b345be915c8d7b043a86ad9a783e9ccc33542e"], "node": "9770b1ab769a4be107aae89d62934b5b90bad19b", "parents": ["e22fe8125e76cab93a4bfbbf633d5567ffda9d58"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061864 - Recover from tab drag sessions that the platform never ends. r=nsharpley,tabbrowser-reviewers\n\nMoving-tab mode is only ever left via finishAnimateTabMove, which runs off the\ndrop and dragend events. When a platform loses those, the movingtab attribute\nsticks: #nav-bar keeps pointer-events: none and the tab strip keeps overlapping\nit, leaving a window the user can only fix by restarting.\n\nTwo triggers detect that. A watchdog verifies that a live drag session is still\nbacking moving-tab mode, covering the case where only the dragend was lost and\nrecovering with no user input. A primary mouse button press covers the case\nwhere the session itself outlived the drag, since it can't be delivered while\nthe platform runs a drag loop; it reaches us even though the nav-bar is inert,\nbecause the event lands on the toolbox.\n\nTwo things worth checking. Bug 1955112 tried the same idea keyed on mousemove\nand bug 1957434 backed it out, because moving-tab mode legitimately outlives the\ndrop while the dropped tabs animate into place, and tearing it down there snaps\nthe tab back to where it came from. Recovery is suppressed for that window,\nusing a self-expiring deadline so a transition that never fires can't disable it\npermanently. Separately, recovery ends the session as an incomplete drag so no\ndragend reaches the source, keeping the detach path from tearing the tab into a\nnew window from stale coordinates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317186\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/test/browser/dragdrop/browser.toml", "browser/components/tabbrowser/test/browser/dragdrop/browser_stale_drag_session.js"], "git_node": "8b244902569c800e3e1c0c4d994ee1bbd1c8e5d7", "git_parents": ["3b71d69cc15f1e340eba4b7ee8e0be3500805dcc"], "node": "851a1a5b94c58e5a9a45876bbe2b1ff27a184ee2", "parents": ["9770b1ab769a4be107aae89d62934b5b90bad19b"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060924: Don't assume that DocAccessible::IPCDoc() will always return something just because IPCAccessibilityActive() returns true. r=eeejay\n\nThis may not be the case if we chose not to send the doc to the parent process.\nThe SetViewportCacheDirty change is indirect: a dirty viewport cache will cause ProcessQueuedCacheUpdates to send data, which will crash when there's no IPCDoc().\nQueueCacheUpdate already avoids queuing if IPCDoc() is null.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316702\n", "files": ["accessible/base/EventQueue.cpp", "accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h"], "git_node": "cf8ac554cf561ee2df5e7f34d3f826b80dc3d1ef", "git_parents": ["8b244902569c800e3e1c0c4d994ee1bbd1c8e5d7"], "node": "59e3c7456e6f711db73f3d1bc837f5c61cc56855", "parents": ["851a1a5b94c58e5a9a45876bbe2b1ff27a184ee2"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057069 - extend HLS metrics expiry to version 162. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317674\n", "files": ["dom/media/hls/metrics.yaml"], "git_node": "8362a85c5dc918a951d19708975d51f90ccb836e", "git_parents": ["cf8ac554cf561ee2df5e7f34d3f826b80dc3d1ef"], "node": "49972a846809555c4fcd85f15fee6fd944294799", "parents": ["59e3c7456e6f711db73f3d1bc837f5c61cc56855"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057069 - extend Matroska metrics expiry to version 162. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317675\n", "files": ["dom/media/metrics.yaml"], "git_node": "d923cdeddec067161e6332564cab58f0af02380e", "git_parents": ["8362a85c5dc918a951d19708975d51f90ccb836e"], "node": "435eeafd93a999d1e97e6323fd9d9c1e6924c188", "parents": ["49972a846809555c4fcd85f15fee6fd944294799"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061837 - Keep adding tabs until the tab strip really overflows. r=tabbrowser-reviewers,nsharpley\n\noverflowTabs sizes the strip up from a single measurement and then waits for an\noverflow event with no timeout, so when the estimate comes up short no event\never arrives and the caller hangs until the test times out, with no assertion\nto point at the cause. That is what backed out bug 1961577.\n\nTop the estimate up while the scrolled content still fits, and wait for the\noverflowing state with a bounded condition so a strip that can't overflow fails\nwith a message instead. The estimate stays as the opening batch, so callers\nasking for a factor of 3 still get the same roomy strip.\n\nWorth checking: the promises array that was awaited held tab elements, since\nBrowserTestUtils.addTab returns the tab synchronously, so the overflow event\nwas the only thing that await actually waited for.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317195\n", "files": ["testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "5dd4d47bb94442d085d3e8ea9b9a66f88fee6f23", "git_parents": ["d923cdeddec067161e6332564cab58f0af02380e"], "node": "45a92ca16be56f14998858be9a75610855398f28", "parents": ["435eeafd93a999d1e97e6323fd9d9c1e6924c188"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061837 - Let callers ask overflowTabs for a specific amount of overflow. r=tabbrowser-reviewers,jsudiaman\n\nThe tab count the factor produces only approximates how much room there is to\nscroll, which is what a test that scrolls the strip actually cares about.\nbrowser_drag_tab_group_overflow.js needs the strip to overflow by more tabs\nthan the small group it collapses and fewer than the large one, and grew its\nown tab-opening loop to get that; overflowBy expresses it directly, so the\nloop goes away.\n\nWorth checking: the early return now also has to account for a strip that\noverflows by less than the caller asked for.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317196\n", "files": ["browser/components/tabbrowser/test/browser/dragdrop/browser_drag_tab_group_overflow.js", "testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "103f2e252cac31ed395bb6c9ba9eef077dc515e8", "git_parents": ["5dd4d47bb94442d085d3e8ea9b9a66f88fee6f23"], "node": "92297113edcef2d1e155dcbd1afea4a2ae44a335", "parents": ["45a92ca16be56f14998858be9a75610855398f28"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2062132 - Call InvalidateTransformNotifyFrame whenever we get a new fragment identifier viewBox r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317624\n", "files": ["dom/svg/SVGSVGElement.cpp", "layout/reftests/svg/fragmentIdentifier-01a.xhtml", "layout/reftests/svg/fragmentIdentifier-01b.xhtml"], "git_node": "428431e02fc8c39aa9ccee0ee44b7641cbb500cf", "git_parents": ["103f2e252cac31ed395bb6c9ba9eef077dc515e8"], "node": "c3049002368b39f7afefaf38e0f7b1d8da804d7b", "parents": ["92297113edcef2d1e155dcbd1afea4a2ae44a335"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Make `install_static_libs` produce the archive it promises to install r=nalexander,firefox-build-system-reviewers\n\nThe application-services megazord links `mozpkix` statically, so `dist/lib`\nneeds a real archive. In D306609 I added `install_static_libs` to put it there,\nbut marking a library for installation is not enough on its own. Nothing in the\nFirefox build produces an archive for a gyp static library unless\n`NO_EXPAND_LIBS` is set.\n\nD315231 was the missing half. I set `no_expand_libs` on the `mozpkix` gyp\ntarget in NSS so the archive would exist for D306609 to install. That worked,\nbut `NO_EXPAND_LIBS` does two things. It builds the archive, and it makes every\nconsumer link that archive instead of the expanded object files. libxul started\nlinking `mozpkix` lazily, and within libxul `VerifyCodeSigningCertificateChain`\nis referenced only from Rust. The build system orders Rust static libraries\nafter all others, and GNU ld reads an archive once at the point it appears,\nso the reference arrived too late and `build-linux64-base-toolchains/debug`\nfailed to link, forcing a backout of the NSS vendor bump in D316987. lld revisits\narchives, which is why no other build was impacted.\n\nThe fix is to split the two meanings. `BUILD_STATIC_LIB_ARCHIVE` builds the\narchive and leaves consumer linkage alone, and `NO_EXPAND_LIBS` implies it, so\nexisting callers are unaffected. `install_static_libs` now sets the new\nvariable, which is the one line in `gyp_reader.py` that gives `mozpkix` its\narchive, and the rest of this patch is the variable that line needs. Because\n`install_static_libs` drives the archive now, D315231 is no longer needed and\ncan be reverted upstream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317613\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/frontend/gyp_reader.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/linkage/build-static-lib-archive/frob1.c", "python/mozbuild/mozbuild/test/backend/data/linkage/build-static-lib-archive/moz.build", "python/mozbuild/mozbuild/test/backend/data/linkage/moz.build", "python/mozbuild/mozbuild/test/backend/data/linkage/prog/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-library-archive-dep/archive/frob1.c", "python/mozbuild/mozbuild/test/backend/data/rust-library-archive-dep/archive/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-library-archive-dep/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-library-archive-dep/rust/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-library-archive-dep/rust/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/data/build-static-lib-archive-non-static/moz.build", "python/mozbuild/mozbuild/test/frontend/data/build-static-lib-archive/moz.build", "python/mozbuild/mozbuild/test/frontend/test_emitter.py"], "git_node": "7e387101122f7339a8a4b61c980c48b2830a11c2", "git_parents": ["428431e02fc8c39aa9ccee0ee44b7641cbb500cf"], "node": "209b1757dda1f7a336c4e3dd988d769486489c88", "parents": ["c3049002368b39f7afefaf38e0f7b1d8da804d7b"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061739 - Make crypto subsample tests independent of decode error tolerance. r=media-playback-reviewers,alwu\n\nSome builds allow decode-error retries, causing malformed-sample tests\nto enter an unrelated seek path. Set the retry limit to zero for these tests\nand restore the previous user pref state afterward.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317233\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "498be6f14797a298ab9727d88fabc9c91bea38f4", "git_parents": ["7e387101122f7339a8a4b61c980c48b2830a11c2"], "node": "df3826df995c78b86a82d93d094cff5ccf2fcf8d", "parents": ["209b1757dda1f7a336c4e3dd988d769486489c88"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060893 - [devtools] Add test to assert speculation rules prefetch requests r=devtools-reviewers,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317327\n", "files": ["devtools/client/netmonitor/test/browser_mz.toml", "devtools/client/netmonitor/test/browser_net_speculation-rules-prefetch-requests.js", "devtools/client/netmonitor/test/html_speculation-rules.html", "devtools/client/netmonitor/test/html_speculation-rules_subpage.html"], "git_node": "c7edce98a418111a853b148a21f10c381cf2295d", "git_parents": ["498be6f14797a298ab9727d88fabc9c91bea38f4"], "node": "9aa8b22d1e82bb31d69e9814697f24513a76c253", "parents": ["df3826df995c78b86a82d93d094cff5ccf2fcf8d"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-uk/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-ja/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-nb-rNO/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-uk/strings.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml"], "git_node": "203218eeda4d69335ea27534cd8f954f6baceaa2", "git_parents": ["c7edce98a418111a853b148a21f10c381cf2295d"], "node": "04885cedb5103c6b3edade78265e55529c0601fd", "parents": ["9aa8b22d1e82bb31d69e9814697f24513a76c253"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061270 - [Fenix] Add Secret Setting to control new PDF viewer tools r=android-reviewers,skhan\n\n* This patch adds a secret setting to show the new Android UI PDF viewer tools (floating action buttons / toolbar).\n* The existing toolbar renders UI in the PDF.js HTML layer itself.\n  * There are follow-ups to turn off the existing toolbar and enable some PDF.js settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317625\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "eb732aa8620a1ef46b0d8b6021b1008dd5daa8ee", "git_parents": ["203218eeda4d69335ea27534cd8f954f6baceaa2"], "node": "03f9d94a6afdf9f42a8d8da29f36e035f2773c3a", "parents": ["04885cedb5103c6b3edade78265e55529c0601fd"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062318 - Only do platform video/audio encoding outside the content process. r=media-playback-reviewers,jolin\n\nThis patch should ensure that any pure software video/audio\nencoding within Firefox stays within the content process. This\nshould avoid performance caveats unveiled while allowing remote\nhardware video encoding to ship.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317574\n", "files": ["dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/ffmpeg/FFmpegDataEncoder.cpp", "dom/media/platforms/ffmpeg/FFmpegEncoderModule.cpp", "dom/media/webcodecs/EncoderTemplate.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "5f0e77e4628b8c7a7ee9a6338d6df849bec5a2a5", "git_parents": ["eb732aa8620a1ef46b0d8b6021b1008dd5daa8ee"], "node": "454e4b02444f530f66fdb834a51f413f7873a4dd", "parents": ["03f9d94a6afdf9f42a8d8da29f36e035f2773c3a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 1: Add MASM computeScaledAddress with Address result. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316735\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "ae2849b036d931c77976da53a445230611a88fb6", "git_parents": ["5f0e77e4628b8c7a7ee9a6338d6df849bec5a2a5"], "node": "7a267525d264dce8ed18f65fdb39d0f763fef421", "parents": ["454e4b02444f530f66fdb834a51f413f7873a4dd"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 2: Handle $zero index in computeScaledAddress. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316736\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "ce0db4ccecd5ab44d5c5029167eaff366e6778df", "git_parents": ["ae2849b036d931c77976da53a445230611a88fb6"], "node": "84512e7f7d3ffb8b09415cd337d4c94f10523290", "parents": ["7a267525d264dce8ed18f65fdb39d0f763fef421"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 3: Add helper ToTwoInt12. r=jandem\n\nThis will be used in Part 4.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316737\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "bd9d0999892ab6f2cf2ca19fce1db1d53c8b1484", "git_parents": ["ce0db4ccecd5ab44d5c5029167eaff366e6778df"], "node": "183008733c2a260b23599bdbb0704d012f605ada", "parents": ["84512e7f7d3ffb8b09415cd337d4c94f10523290"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 4: Shorten ma_{load,store} codegen for offset=si12+si12. r=jandem\n\nTry to fuse some of the offsets into the ld/st instruction itself as in\nriscv64. Since it is one instruction longer than ldptr/stptr, it's tried\nafter those.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316738\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "c41ff2abea772f1ad10c64b22a638d72b978636a", "git_parents": ["bd9d0999892ab6f2cf2ca19fce1db1d53c8b1484"], "node": "8c8c3d89ca6f83de5cb503d48c2f73fe48e89c4c", "parents": ["183008733c2a260b23599bdbb0704d012f605ada"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 5: Redirect ma_{ld,st}_* to ma_{load,store} for better instruction selection. r=jandem\n\nNone of their callers seem to explicitly depend on the instruction\nselection of these ma_{ld,st}_*, so there's really no reasons to keep\nthem duplicated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316739\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "1bc62be5b5187e424296f5c8eef00bb45dded47d", "git_parents": ["c41ff2abea772f1ad10c64b22a638d72b978636a"], "node": "be43f5ec8a333b2b48958955432d1b5d97bdff74", "parents": ["8c8c3d89ca6f83de5cb503d48c2f73fe48e89c4c"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 6: Improve codegen for loads/stores with constant heap offsets. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316740\n", "files": ["js/src/jit-test/tests/wasm/memory-loong64-ion-codegen.js", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "849e7a948acb9c91be372596a389e152bd23dae1", "git_parents": ["1bc62be5b5187e424296f5c8eef00bb45dded47d"], "node": "e77054ddbc67ad026f0e414337128e68a904bf81", "parents": ["be43f5ec8a333b2b48958955432d1b5d97bdff74"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 7: Don't clobber index register in Wasm{Load,Store}I64. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316741\n", "files": ["js/src/jit/loong64/CodeGenerator-loong64.cpp"], "git_node": "730e14fdca67c368afe6468b829dc5fbd240f231", "git_parents": ["849e7a948acb9c91be372596a389e152bd23dae1"], "node": "41f0e5db8584623bb96ff2a8dd13113f2348b85d", "parents": ["e77054ddbc67ad026f0e414337128e68a904bf81"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 8: Optimize zero wasm-stores. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316742\n", "files": ["js/src/jit-test/tests/wasm/store-zero-loong64-ion-codegen.js", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "e717deeb202068030d9c64073a46958676099428", "git_parents": ["730e14fdca67c368afe6468b829dc5fbd240f231"], "node": "496397d51d7e003362ed9a435470f57904054e76", "parents": ["41f0e5db8584623bb96ff2a8dd13113f2348b85d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061309 - [loong64] Part 1: Pass ZeroExtend32To64 to Wasm atomic operations. r=jandem\n\nLink: https://phabricator.services.mozilla.com/D313413 (\"Bug 2056833 -\n Part 13: Pass ZeroExtend32To64 to Wasm Atomic operations.\n r=#spidermonkey-reviewers!\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316843\n", "files": ["js/src/jit/MacroAssembler.h", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "ab3f3f1aa57ebba6b42c7f5989455bdacf5cf7ba", "git_parents": ["e717deeb202068030d9c64073a46958676099428"], "node": "1900b839def6e7140328d27df31e1e283c857fe0", "parents": ["496397d51d7e003362ed9a435470f57904054e76"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061309 - [loong64] Part 2: Enable WASM huge memory on platforms with 48+ bits of VA. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316844\n", "files": ["js/src/jit-test/tests/wasm/store-zero-loong64-ion-codegen.js", "js/src/js-config.mozbuild", "js/src/wasm/WasmMemory.cpp", "js/src/wasm/WasmProcess.cpp"], "git_node": "43f3f1b62ffc62ce6f5203494f53e5669ce6dbe2", "git_parents": ["ab3f3f1aa57ebba6b42c7f5989455bdacf5cf7ba"], "node": "29df0806986d8ed801cd97de59d9afc1b622ee1a", "parents": ["1900b839def6e7140328d27df31e1e283c857fe0"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 1: Implement simulation of am{swap,add,and,or,xor}{,_db}.[wd] instructions. r=spidermonkey-reviewers,jandem\n\nThese are part of the base LoongArch ISA (as opposed to LoongArch V1.1).\nFor the same reasons described in D313404, am{min,max}{,_db}.[wd]{,u}\nare not implemented for the lack of matching primitives from\nAtomicOperations.\n\nLink:\n https://github.com/loongson/la-toolchain-conventions/blob/36d207cd76301618624d10e67daf7b7f1c060411/LoongArch-toolchain-conventions-EN.adoc\n (\"Toolchain Conventions of the LoongArch(tm) Architecture\")\nLink: https://phabricator.services.mozilla.com/D313404 (\"Bug 2056833 -\n Part 4: Fix simulation of AMO instructions.\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317022\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "4f629baad0416581323437ec022612e5895a0d95", "git_parents": ["43f3f1b62ffc62ce6f5203494f53e5669ce6dbe2"], "node": "93f5fa5de61adf3f80ac91dfc08f9abd63d4ea5b", "parents": ["29df0806986d8ed801cd97de59d9afc1b622ee1a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 2: Assert invalid operand combinations of atomic instructions. r=spidermonkey-reviewers,jandem\n\nThe ISA manual says:\n\n        If the AM* atomic memory access instruction has the same\n        register number as rd and rj, the execution will trigger an\n        Instruction Non-defined Exception.\n\n        If the AM* atomic memory access instruction has the same\n        register number as rd and rk, the execution result is uncertain.\n        Please software[sic.] to avoid this situation\n\nThus pleasing the software by asserting that we never generate such\ninvalid combinations.\n\nLink:\n https://github.com/loongson/LoongArch-Documentation/blob/e0d6592229d9e00e512bd28b688a7f20b171714f/docs/LoongArch-Vol1-EN/basic-integer-instructions/overview-of-basic-integer-instructions/atomic-memory-access-instructions.adoc\n (\"Atomic Memory Access Instructions\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317023\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp"], "git_node": "e1d75748b510b9cf6279c4bbcde5d72f8988090c", "git_parents": ["4f629baad0416581323437ec022612e5895a0d95"], "node": "5d0b38f1cd1053d0a6c08a69f2a03d10eca4cd2f", "parents": ["93f5fa5de61adf3f80ac91dfc08f9abd63d4ea5b"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 3: Use AMO instructions from base ISA when possible in Atomic{Exchange,FetchOp,EffectOp}{,64}. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317024\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "4c4df7db2034bc88062539791ab9a87caae10940", "git_parents": ["e1d75748b510b9cf6279c4bbcde5d72f8988090c"], "node": "1091832e49528783979bb0753bb99d38b28b27df", "parents": ["5d0b38f1cd1053d0a6c08a69f2a03d10eca4cd2f"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 4: Specialize AtomicEffectOp64 and reduce temp register usage. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317025\n", "files": ["js/src/jit/LIROps.yaml", "js/src/jit/MacroAssembler.h", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/wasm/WasmBCMemory.cpp"], "git_node": "4af6c0a914756c6ebdad0c2546395821d315d757", "git_parents": ["4c4df7db2034bc88062539791ab9a87caae10940"], "node": "20dfcfb81b217129f69667900b123bb3676ca4e4", "parents": ["1091832e49528783979bb0753bb99d38b28b27df"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 5: (Drive-by) Only register loong64-sim-* shell options on simulator. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317026\n", "files": ["js/src/shell/js.cpp"], "git_node": "2af21ce1d32be5639676ad7247ba102bed51b800", "git_parents": ["4af6c0a914756c6ebdad0c2546395821d315d757"], "node": "e936152938666406215e14bc43c65eac74790a79", "parents": ["20dfcfb81b217129f69667900b123bb3676ca4e4"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 6: Implement CPU feature flags detection facilities. r=spidermonkey-reviewers,jandem\n\nThis is mostly learned from riscv64's design. Loong64 does not have ISA\nstrings that can specify arbitrary extensions, so the parsing is much\nsimpler.\n\nLink:\n https://github.com/loongson/la-toolchain-conventions/blob/36d207cd76301618624d10e67daf7b7f1c060411/LoongArch-toolchain-conventions-EN.adoc\n (\"Toolchain Conventions of the LoongArch(tm) Architecture\", see Table\n 6.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317027\n", "files": ["js/src/jit/JitContext.cpp", "js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/loong64/Architecture-loong64.h", "js/src/shell/js.cpp"], "git_node": "0d2ac32dbbd692527fd8d4babee7b8e6d56309c0", "git_parents": ["2af21ce1d32be5639676ad7247ba102bed51b800"], "node": "cd1424393c38aeefb36dc424e0a54587e24bad47", "parents": ["e936152938666406215e14bc43c65eac74790a79"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 7: Implement simulation for LAM_BH instructions. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317028\n", "files": ["js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "7f0df17584f28bd93a4a355488cc296fef74253a", "git_parents": ["0d2ac32dbbd692527fd8d4babee7b8e6d56309c0"], "node": "67211483ad8b9e1f5857e0f6bc66c31a421ce6a3", "parents": ["cd1424393c38aeefb36dc424e0a54587e24bad47"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 8: Implement {dis,}assembly for LAM_BH instructions. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317029\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/disasm/Disasm-loong64.cpp"], "git_node": "9a7ab0ef460fbeeb330bc48be53081114e83f6c6", "git_parents": ["7f0df17584f28bd93a4a355488cc296fef74253a"], "node": "202d0eb0097f62f15c534df41b784eaa0c32b623", "parents": ["67211483ad8b9e1f5857e0f6bc66c31a421ce6a3"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 9: Enable code generation using LAM_BH instructions. r=spidermonkey-reviewers,jandem\n\nThis can benefit Atomic{FetchOp,EffectOp,Exchange} in their 1B/2B paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317030\n", "files": ["js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/wasm/WasmBCMemory.cpp", "js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "3dd763353295d42fa84384b19fd29876459e3b4d", "git_parents": ["9a7ab0ef460fbeeb330bc48be53081114e83f6c6"], "node": "682c9ed4097bf72c3fee340d72b8b8c7e632b36d", "parents": ["202d0eb0097f62f15c534df41b784eaa0c32b623"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061654 - [loong64] Part 9: Enable code generation using LAM_BH instructions. r=spidermonkey-reviewers,jandem\"\n\nThis reverts commit 3dd763353295d42fa84384b19fd29876459e3b4d.\n", "files": ["js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/wasm/WasmBCMemory.cpp", "js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "57c36971ade26cb76e127c7d32140fc56bf56d36", "git_parents": ["3dd763353295d42fa84384b19fd29876459e3b4d"], "node": "e6b6e342c50fb6cebb90956d51d1d4025d2dca9d", "parents": ["682c9ed4097bf72c3fee340d72b8b8c7e632b36d"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061654 - [loong64] Part 8: Implement {dis,}assembly for LAM_BH instructions. r=spidermonkey-reviewers,jandem\"\n\nThis reverts commit 9a7ab0ef460fbeeb330bc48be53081114e83f6c6.\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/disasm/Disasm-loong64.cpp"], "git_node": "d36fe0b15a0392a5855aa2b77e63fdb88d4d2b73", "git_parents": ["57c36971ade26cb76e127c7d32140fc56bf56d36"], "node": "d96d70674e45b7b8d680c20a6e33813758666974", "parents": ["e6b6e342c50fb6cebb90956d51d1d4025d2dca9d"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061654 - [loong64] Part 7: Implement simulation for LAM_BH instructions. r=spidermonkey-reviewers,jandem\"\n\nThis reverts commit 7f0df17584f28bd93a4a355488cc296fef74253a.\n", "files": ["js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "2f1f33dd11306486a9cc27198c485f46cbd3bc69", "git_parents": ["d36fe0b15a0392a5855aa2b77e63fdb88d4d2b73"], "node": "ded9f12c53323c613ae7076c77387b54bf8840c9", "parents": ["d96d70674e45b7b8d680c20a6e3381375866