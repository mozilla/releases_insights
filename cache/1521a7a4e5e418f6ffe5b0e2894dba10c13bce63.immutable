f28ecf54efc77414871f\nlt -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nltg -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nlv -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nmeh -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nmix -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nml -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nmr -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nms -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nmy -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nnb-NO -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nne-NP -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nnl -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nnn-NO -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\noc -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\npa-IN -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\npl -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\npt-BR -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\npt-PT -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nrm -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nro -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nru -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nsk -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nsl -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nson -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nsq -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nsr -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nsv-SE -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nta -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nte -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nth -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\ntl -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\ntr -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\ntrs -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nuk -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nur -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nuz -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nvi -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nwo -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nxh -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nzam -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nzh-CN -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\nzh-TW -\u003e aa629449fc16d0f202a1f28ecf54efc77414871f\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "f6a08b8f2e01d1f68b09ead3fa2ee54e51e75093", "git_parents": ["f41682b4e9415ea5555d95d3869e29e59d4d9c24"], "node": "6e1835cb12f83633d36a8da18cf201cb900a5a72", "parents": ["36c2096a52d643634f1c3fe99971fa7b6f618fb4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2057023 - Don't record sandbox syscall-brokering markers on threads without working TLS, r=bobowen,profiler-reviewers,mstange,sandbox-reviewers.\n\nThe syscall interceptions can run on OS-owned threads that have no TLS allocated (see bug 1705579), where the Gecko marker callbacks crash reading a thread_local; the interception observed here ran on a thread-pool worker doing heap maintenance. Skip the marker callbacks in the sandbox target glue when the current thread has no TLS, mirroring WinIOAutoObservation (bug 1705579), and note the requirement next to the profiler TLS access.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313606\n", "files": ["security/sandbox/chromium-shim/sandbox/win/TargetGeckoClient.cpp", "tools/profiler/public/ProfilerThreadRegistration.h"], "git_node": "4dc19ce1ab062d48190c937efb51c854885d82f8", "git_parents": ["f6a08b8f2e01d1f68b09ead3fa2ee54e51e75093"], "node": "4245c1529b3f3d7a985345129198f3d5e0fe8fdb", "parents": ["6e1835cb12f83633d36a8da18cf201cb900a5a72"], "tags": []}, {"author": "fmasalha \u003cfmasalha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049019 - Added sign-in content for summarization integrity failures r=android-reviewers,android-l10n-reviewers,flod,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307863\n", "files": ["mobile/android/android-components/components/concept/llm/src/main/java/mozilla/components/concept/llm/Llm.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationAction.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationMiddleware.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationReducer.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationScreen.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/ui/FxaSignInContent.kt", "mobile/android/android-components/components/feature/summarize/src/main/res/values/strings.xml", "mobile/android/android-components/components/lib/llm-mlpa/src/main/java/mozilla/components/lib/llm/mlpa/service/MlpaService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizationTelemetryMiddleware.kt"], "git_node": "5756e0bf67f1cf5bdeb0598e2bc14f0e765b9f9c", "git_parents": ["4dc19ce1ab062d48190c937efb51c854885d82f8"], "node": "354b7d2e868376bc10d6643884ee2994f2380b4d", "parents": ["4245c1529b3f3d7a985345129198f3d5e0fe8fdb"], "tags": []}, {"author": "fmasalha \u003cfmasalha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049018 - Wired up sign-in and reauthentication for summarization r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307864\n", "files": ["mobile/android/android-components/components/concept/llm/src/main/java/mozilla/components/concept/llm/Llm.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationAction.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationMiddleware.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationReducer.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationScreen.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/SummarizationState.kt", "mobile/android/android-components/components/feature/summarize/src/main/java/mozilla/components/feature/summarize/ext/LlmProvider.kt", "mobile/android/android-components/components/feature/summarize/src/test/java/mozilla/components/feature/summarize/SummarizationStoreTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/accounts/FenixFxAEntryPoint.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/llm/ext/FxaAccountManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/llm/ext/MlpaTokenProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SupportUtils.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizationFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/summarization/SummarizationTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/llm/ext/MlpaTokenProviderTest.kt"], "git_node": "5ab9af37f3f6089b3c5e4b828ba9c68921f88573", "git_parents": ["5756e0bf67f1cf5bdeb0598e2bc14f0e765b9f9c"], "node": "a7ea3431f795a03e2f4e8b1ef5ce0f93256836c7", "parents": ["354b7d2e868376bc10d6643884ee2994f2380b4d"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057731 - Add telemetry for the global stylesheet cache not finding the expected stylesheet. r=dholbert,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314213\n", "files": ["layout/base/metrics.yaml", "layout/style/GlobalStyleSheetCache.cpp"], "git_node": "87f604e7f0756019d0ab6a99237e93adb44820b4", "git_parents": ["5ab9af37f3f6089b3c5e4b828ba9c68921f88573"], "node": "bb0029a5b903fb30e61b469949173df68f47b734", "parents": ["a7ea3431f795a03e2f4e8b1ef5ce0f93256836c7"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/sitepermissions/src/main/res/values-sat/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sat/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-th/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml"], "git_node": "106d33cdc12aa65b39a4d1a9994c5b1a9663724a", "git_parents": ["87f604e7f0756019d0ab6a99237e93adb44820b4"], "node": "85492687218db940850e1956b3041fcb64d3cbaf", "parents": ["bb0029a5b903fb30e61b469949173df68f47b734"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1624579 - Switch to a tab through the parent controller. r=daleharvey\n\nPicking a tab-switch result reached the chrome window and parent-only\nservices directly -- gBrowser.selectedTab, its split view,\nswitchToTabHavingURI, removeTab, the input-history write, and the\nopen-tab-provider unregister on a miss -- none of which a content-process\nurlbar can touch.\n\nRoute the whole action over the controller seam as a fire-and-forget\nUrlbarParentController.switchToTab (mirroring speculativeConnect): it does the\ntabbrowser bookkeeping and both follow-up writes parent-side, so no status\nneeds to cross back. The child keeps the input/view and telemetry work --\nhandleRevert and the engagement event -- and hands over the serializable\ninputs (url, container id, tab group, adopt flag, search string, heuristic\nflag).\n\nBoth UrlbarInput and SmartbarInput are routed through the same parent method,\nso they stay in sync; SmartbarInput's tabs carry no split view, which the\nshared path handles as a no-op. Behavior-neutral for the chrome address bar,\nwhere tab switches happen today. Verified with the browser_switchToTab* and\nbrowser_inputHistory.js tests, and the smartbar suite, under the\nmessage-passing pref both off and on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312319\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "ea2930b81b6821c3565ba6d4469f42304bfe996e", "git_parents": ["106d33cdc12aa65b39a4d1a9994c5b1a9663724a"], "node": "7b447e9277b3b4d581644da473bf92a0ec9fd42f", "parents": ["85492687218db940850e1956b3041fcb64d3cbaf"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1624579 - Resolve the heuristic-fallback navigation in the parent controller. r=mak\n\nhandleNavigation's no-result fallback fetched the heuristic\n(UrlbarUtils.getHeuristicResultFor), recorded the heuristicResultMissing\ncounters, guarded against the browser navigating mid-fetch\n(lastLocationChange), and on failure ran Services.uriFixup -- all reaching\nthe chrome window and parent-only services a content-process urlbar can't\ntouch (getHeuristicResultFor read gBrowser directly; uriFixup throws in\ncontent). It's also not address-bar-only: a searchbar reaches it whenever\nthere's no cached result at Enter.\n\nMove the whole block to UrlbarParentController.resolveFallbackNavigation: it\nbuilds the heuristic query with the current tab's data, runs it (reusing\ngetHeuristicResult), records the counters, captures the navigation epoch, and\non failure runs uriFixup -- then hands the content side only a heuristic\nresult to pick or a fixup URL to load, or nothing when the browser navigated\nin the meanwhile. The content keeps just the pickResult/_loadURL and the\nschemeless-input annotation. Routed over the controller seam like LoadURL\n(direct path synchronous, message path round-trips), and mirrored into\nSmartbarInput. getHeuristicResultFor, now unused, is removed.\n\nBecause that resolution is asynchronous, the content side captures the target\ntab at the commit and passes it through pickResult/_loadURL, so a tab opened\nbefore the load lands can't steal it (the old synchronous path implicitly used\nthe tab current at Enter).\n\nThe tests that drove the old content-side getHeuristicResultFor now target\nthe controller's getHeuristicResult -- stubbed on UrlbarParentController's\nprototype so it covers the parent controller on both transports -- or spy\nresolveFallbackNavigation.\n\nVerified with browser_handleCommand_fallback.js, browser_loadRace.js,\nbrowser_raceWithTabs.js, browser_editAndEnterWithSlowQuery.js, and\nbrowser_heuristic.js under the message-passing pref both off and on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312344\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/tests/browser-telemetry/browser_heuristic.js", "browser/components/urlbar/tests/browser/browser_editAndEnterWithSlowQuery.js", "browser/components/urlbar/tests/browser/browser_handleCommand_fallback.js", "browser/components/urlbar/tests/browser/browser_loadRace.js"], "git_node": "0d1849b21ed568179fbe8051a1a04e66b3952cb1", "git_parents": ["ea2930b81b6821c3565ba6d4469f42304bfe996e"], "node": "6d2ce88afd52dc941d360570ca02faa03153e7aa", "parents": ["7b447e9277b3b4d581644da473bf92a0ec9fd42f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1624579 - Key urlbar bounce tracking by browser id instead of the browser element. r=daleharvey\n\nBounce-event tracking is the last thing holding pickResult to the \u003cbrowser\u003e\nelement. Its per-tab state lived on the input's #browserStates map keyed by the\nelement (a map shared with addressbar-only per-tab state), and it read the browser\nid off a live element -- neither works for a content-process urlbar, which has no\n\u003cbrowser\u003e.\n\nMove the tracking state into the telemetry collectors, keyed by the stable browser\nid, off #browserStates: TelemetryEvent (direct) and UrlbarChildTelemetry (message)\neach keep their own map, and startTrackingBounceEvent / handleBounceEventTrigger /\nrecordBounceEvent take an id. The direct path caches the element while alive so a\ntab-close trigger can still reach Interactions for it, mirroring the message path's\nunchanged. Call sites pass browser.browserId.\n\nBehavior-neutral: the same tab resolves to the same id, so tracking, triggering,\nand recording are unchanged; this unblocks dropping pickResult's browser element\nnext. The bounce test stops poking the now-private tracking state and anchors its\nstubbed interactions to now instead.\n\nVerified with browser_glean_telemetry_bounce.js and browser_enter.js under the\nmessage-passing pref both off and on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312397\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildTelemetry.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/tests/browser-engagementTelemetry/browser_glean_telemetry_bounce.js"], "git_node": "508feb17d7e57dd454114a8f98700078f253a139", "git_parents": ["0d1849b21ed568179fbe8051a1a04e66b3952cb1"], "node": "8ba611e21e6b59c414d0bea0f4d57863b063156e", "parents": ["6d2ce88afd52dc941d360570ca02faa03153e7aa"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1624579 - Drop the browser element from the urlbar pick/load path. r=daleharvey\n\nWith bounce tracking now keyed by browser id, the pick/load path no longer needs\nthe \u003cbrowser\u003e element -- the last chrome-window reach that a content urlbar can't\nsatisfy.\n\nReplace the browser element on pickResult and _loadURL with a browserId, and drop\nthe parameter from #pickMenuResult. The chrome address bar captures its selected\ntab's id at the commit (this.window.gBrowser.selectedBrowser) and passes it,\npinning the load; a content-process urlbar has no gBrowser and passes null, so\nUrlbarParentController.loadURL loads the urlbar's own tab, resolved from the\nactor's browsing context, falling back to the selected browser. Behavior-neutral\nfor the address bar. Bounce tracking reads the selected tab's id under the\nthis.window.gBrowser gate, skipped for a content urlbar that has no tab to bounce.\n\nThis also fixes a latent arg-order bug: the canonized-Enter path passed the\nbrowser element into _loadURL's resultDetails slot, so #notifyStartNavigation\nreceived a browser rather than result details; it now receives null, like the\nother callers.\n\nMirrored into SmartbarInput. Behavior-neutral for the chrome address bar and\nsmartbar. Verified with browser_enter.js, browser_canonizeURL.js,\nbrowser_handleCommand_fallback.js, browser_raceWithTabs.js, and\nbrowser_glean_telemetry_bounce.js under the message-passing pref both off and on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312398\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "f3aa7e8278bb79ab5f25598f0e0ec157a9d6065b", "git_parents": ["508feb17d7e57dd454114a8f98700078f253a139"], "node": "9a75263758eb5586e4d1be79eb83b4f8d38c0cf7", "parents": ["8ba611e21e6b59c414d0bea0f4d57863b063156e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1624579 - Route new-tab search recording through the parent controller. r=Standard8\n\nRecording a search that opens in a new tab needs the new tab's browser. The\ninputs got it by adding a TabOpen listener to gBrowser.tabContainer and reading\nlinkedBrowser -- a chrome-window reach a content urlbar can't make.\n\nMove the listen-and-record into the parent:\nUrlbarParentController.recordSearchInOpenedTab registers the {once} TabOpen\nlistener on its own tabContainer and records against the new tab's browser (the\nload opens the tab right after this call, so the next TabOpen is the search tab).\n_recordSearch takes an inNewTab flag and routes to it or the existing\nrecordSearch, collapsing each caller's TabOpen/else pair to a single call.\n\nBehavior-neutral: the direct path registers the listener in-process against the\nsame gBrowser; the message path ships the search data and registers the listener\nparent-side before the load message opens the tab. Mirrored into SmartbarInput.\n\nVerified with browser_searchTelemetry.js, browser_urlbar_telemetry.js,\nbrowser_oneOffs_keyModifiers.js, and browser_locationBarCommand.js under the\nmessage-passing pref both off and on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312399\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "ca3ab8340a0a8ceea025650c1d23df1a75cfd29e", "git_parents": ["f3aa7e8278bb79ab5f25598f0e0ec157a9d6065b"], "node": "42df5fc09f87eb80abdd0e8ce13bb668c4606baa", "parents": ["9a75263758eb5586e4d1be79eb83b4f8d38c0cf7"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055303 - Reparent abspos children in non-first inline continuation in a fragmentainer during column balancing. r=layout-reviewers,dshin\n\nThis patch adds a new sanity check in absolute containing block for inline as\nabspos containing block. It ensures only the first inline continuation in a\nfragmentainer can contain abspos children, and all the other continuations in\nthe same fragmentainer cannot. The crashtest added in this patch can trigger the\nassertions without the fix in `PrepareAbsoluteFrames()`.\n\nThe fix in `PrepareAbsoluteFrames()` has two parts: the first part after\n`DrainPushedChildList()` is to ensure the above-mentioned invariant that the new\ncheck verifies. The second part is to generalize existing logic, ensuring at\nmost one continuation of an abspos frame can be in the child list. The check for\nthis is at [1].\n\n[1] https://searchfox.org/firefox-main/rev/3b3f727963c10fe58e6e72c15989ad0e35dbf832/layout/generic/AbsoluteContainingBlock.cpp#344-351\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313899\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp", "layout/generic/AbsoluteContainingBlock.h", "testing/web-platform/tests/css/css-position/crashtests/inline-containing-block-multicol-balancing-002.html"], "git_node": "7a70fbf38c87e053350a8f9526bcd30c71d2707f", "git_parents": ["ca3ab8340a0a8ceea025650c1d23df1a75cfd29e"], "node": "ac9d3ffd60fc50cf8497e130e256723ec98c1ce8", "parents": ["42df5fc09f87eb80abdd0e8ce13bb668c4606baa"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2047345 - Set layout.css.progress-function.enabled for all users. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314200\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "34ce15fe54f759aedcbf1d73f914f68e080bd880", "git_parents": ["7a70fbf38c87e053350a8f9526bcd30c71d2707f"], "node": "931ab81408da62225181f5bd4f5a831088ab7e5c", "parents": ["ac9d3ffd60fc50cf8497e130e256723ec98c1ce8"], "tags": []}], "date": 1785057841, "git_changesets": ["f41682b4e9415ea5555d95d3869e29e59d4d9c24", "f6a08b8f2e01d1f68b09ead3fa2ee54e51e75093", "4dc19ce1ab062d48190c937efb51c854885d82f8", "5756e0bf67f1cf5bdeb0598e2bc14f0e765b9f9c", "5ab9af37f3f6089b3c5e4b828ba9c68921f88573", "87f604e7f0756019d0ab6a99237e93adb44820b4", "106d33cdc12aa65b39a4d1a9994c5b1a9663724a", "ea2930b81b6821c3565ba6d4469f42304bfe996e", "0d1849b21ed568179fbe8051a1a04e66b3952cb1", "508feb17d7e57dd454114a8f98700078f253a139", "f3aa7e8278bb79ab5f25598f0e0ec157a9d6065b", "ca3ab8340a0a8ceea025650c1d23df1a75cfd29e", "7a70fbf38c87e053350a8f9526bcd30c71d2707f", "34ce15fe54f759aedcbf1d73f914f68e080bd880"], "user": "sstanca@mozilla.com"}, "44961": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e a66ea12ad51a