NeckoChannelParams.ipdlh", "netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/ConnectionEntry.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/HappyEyeballsTransaction.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.h", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/test/unit/test_bug2052534.js", "netwerk/test/unit/test_http3_alt_svc_validation.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "607de6ace5434da784ec7a4034e82b45c6c6e31e", "git_parents": ["abba4c4be97db3e44d7449e7aca5f697505d3454"], "node": "5a275a85fd1229dd7db8a5f9481b271435383b7a", "parents": ["741f795592d7add5d4ff11baa53fe07efa13e6c4"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055954 - Have nsStorageInputStream only keep its logical cursor, recalculating others when needed. r=xpcom-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312826\n", "files": ["xpcom/io/nsStorageStream.cpp", "xpcom/tests/gtest/TestStorageStream.cpp"], "git_node": "2d2a56dd5551371d0cd99e58969b04aa75ccd02c", "git_parents": ["607de6ace5434da784ec7a4034e82b45c6c6e31e"], "node": "17c884b52763177a731d5678bee72f39e69b9cc3", "parents": ["5a275a85fd1229dd7db8a5f9481b271435383b7a"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044906 - When sharing multiple links, make the list numbered r=android-reviewers,skhan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313530\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/ShareSheetLauncher.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/ShareSheetLauncherTest.kt"], "git_node": "25a46b98ee20a41b97f5c03e8849e093c649e1fe", "git_parents": ["2d2a56dd5551371d0cd99e58969b04aa75ccd02c"], "node": "8bc84eb5e2526f472ee03f81b2155b530caa27cb", "parents": ["17c884b52763177a731d5678bee72f39e69b9cc3"], "tags": []}, {"author": "Your Name \u003cyou@example.com\u003e", "branch": "default", "desc": "Bug 2053568 - Remove unused locale-thumbs-config, region-thumbs-config, searchTopsitesCompact r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313135\n", "files": ["browser/app/profile/firefox.js"], "git_node": "7cceb7fba8be7e15e301db059cf96c6210e7ddd5", "git_parents": ["25a46b98ee20a41b97f5c03e8849e093c649e1fe"], "node": "93ebf9b3cb3ecf889c1688d27909676bde445dbd", "parents": ["8bc84eb5e2526f472ee03f81b2155b530caa27cb"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053503 - Don't swallow taskgraph bootstrap errors r=firefox-build-system-reviewers,glandium\n\nPreviously, when this failed, it printed a one line warning that\nwas easily missed, and also not helpful for debugging the problem.\nNow it will print the entire log for the `./mach taskgraph` command\nif it fails, which should be more helpful, and harder to miss.\n\nI considered making this a hard stop, but it's probably not one\nintentionally, since the build can still find locally installed\ntoolchains on the PATH and still succeed that way. Though, you\ncould argue that you should opt into that behavior by using\n`--disable-bootstrap`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311365\n", "files": ["python/mozbuild/mozbuild/toolchains.py"], "git_node": "8d7c15c5dd5baa2807dcade02eab6c19be3556d3", "git_parents": ["7cceb7fba8be7e15e301db059cf96c6210e7ddd5"], "node": "3067c60f8fbad625b0eb1b25f67813d0385c8fea", "parents": ["93ebf9b3cb3ecf889c1688d27909676bde445dbd"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047023 - Add mochitest-browser-chrome-ml-models for real-model ML tests r=ai-platform-reviewers,taskgraph-reviewers,thasan,ahal,gregtatum\n\nReal ML models can only run under `./mach perftest` today because the\nmozperftest MLServices layer is what allowlists RS + model-hub hosts via\nnetwork.socket.allowed_nonlocal_domains. That's the wrong tool for\ncorrectness regression tests.\n\nnsSocketTransport::ShouldBlockAddress() reads that pref at runtime per\nconnection, so a per-manifest `prefs = [...]` is enough to reach\nmodel-hub.mozilla.org from a plain mochitest \u2014 no hook, no env vars.\n\nAdds browser_models.toml carrying the RS + model-hub subset of\nMLServices.ALLOWED_HOSTS behind subsuite=ml-models, plus two tests: a\nsanity check (HEAD + Range GET GGUF magic) to keep the bypass covered,\nand a real SmolLM2 chat exercising native llama.cpp.\n\nThe corresponding taskcluster task runs Linux opt only, on\nmozilla-central plus try.\n\nTry run (green): https://treeherder.mozilla.org/jobs?repo=try&revision=784ffbd6ef4894b58d4ea7c60df0c53717d1af6d&selectedTaskRun=HWMdbvcuQpeuVOu2m4edrw.0\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310941\n", "files": ["python/mozbuild/mozbuild/schedules.py", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/test-sets.yml", "testing/mochitest/mach_test_package_commands.py", "testing/mozbase/moztest/moztest/resolve.py", "testing/mozharness/configs/unittests/linux_unittest.py", "testing/mozharness/configs/unittests/mac_unittest.py", "testing/mozharness/configs/unittests/win_unittest.py", "testing/mozharness/mach_commands.py", "testing/mozharness/scripts/desktop_unittest.py", "toolkit/components/ml/moz.build", "toolkit/components/ml/tests/browser_models/browser_ml_smollm2_chat.js", "toolkit/components/ml/tests/browser_models/browser_models.toml"], "git_node": "4ac4d41f2c2d33c90f23a610a2fe8ebe5f25806f", "git_parents": ["8d7c15c5dd5baa2807dcade02eab6c19be3556d3"], "node": "545d3aa0acf30f9f4520aedcdf830269e1446f38", "parents": ["3067c60f8fbad625b0eb1b25f67813d0385c8fea"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048396 - Stop vendoring application-services moz.build files r=nalexander,firefox-build-system-reviewers,sergesanspaille\n\nThese `moz.build` files only matter to the `firefox` build, so it\ndoesn't make sense to maintain them upstream and re-vendor every\ntime they change. This excludes them from `./mach vendor` sync\nso they can be edited directly in the tree. The files stay where\nthey are (We're not removing them), just taking ownership of them\ninstead of pulling them from `application-services`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307430\n", "files": ["third_party/application-services/moz.yaml"], "git_node": "53c8f99b3adb2f82203b18cced04c2c023ac1c29", "git_parents": ["4ac4d41f2c2d33c90f23a610a2fe8ebe5f25806f"], "node": "94d20a9e66b26ad3b5b4de7a820b0b97358629f4", "parents": ["545d3aa0acf30f9f4520aedcdf830269e1446f38"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053599. r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312932\n", "files": ["gfx/cairo/cairo/src/cairo-truetype-subset.c", "gfx/cairo/patches/0044-Bug-2053599-glyph-index-bounds.patch"], "git_node": "7a7681a1340e75a108c6b1b9cbf52a272e5a5aae", "git_parents": ["53c8f99b3adb2f82203b18cced04c2c023ac1c29"], "node": "49741eae0bca4658992847a7428bc22142221972", "parents": ["94d20a9e66b26ad3b5b4de7a820b0b97358629f4"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2056826 - Add settings entry for local network access permission. r=android-reviewers,android-l10n-reviewers,rebecatudor273,parker\n\nThis adds a \"Local Network Access / Nearby Devices\" entry to the Fenix settings.\nWhen not already allowed, clicking the entry will attempt to request the ACCESS_LOCAL_NETWORK permission directly.\nIf the permission is permanently denied, a second click will navigate the user to the App Info page in system settings as a fallback.\n\nI already allowed, clicking the entry will navigate the user to the App Info page in system settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313430\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ext/Context.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/preferences.xml"], "git_node": "ce81a405f9576ff838c8cdc2dfb74d905ddaae2a", "git_parents": ["7a7681a1340e75a108c6b1b9cbf52a272e5a5aae"], "node": "43c3f2f160016ab39254c548f3614f92f3f4b5de", "parents": ["49741eae0bca4658992847a7428bc22142221972"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056504: Fix spidermonkey make-install for generated files. r=sfink\n\nThe 'make install' rule is still used by downstream embedders like GnomeJS so\nfix some bitrot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313341\n", "files": ["js/src/build/Makefile.in"], "git_node": "62a7802eed8b56e16f0a0c6a64dd871ab14ba2c0", "git_parents": ["ce81a405f9576ff838c8cdc2dfb74d905ddaae2a"], "node": "d365364f145ec9f1ac381b3a90f3aa2d57d4a5dc", "parents": ["43c3f2f160016ab39254c548f3614f92f3f4b5de"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2056669 - Remove `uploadByUrl` endpoint from Google Lens integration r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313296\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/LensFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/LensImageUploader.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/LensFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/LensImageUploaderTest.kt"], "git_node": "a13b0bef4c46d42be8effa1ab8e5d09b95631c2f", "git_parents": ["62a7802eed8b56e16f0a0c6a64dd871ab14ba2c0"], "node": "764b096ba8734dc8e9cacb38ffb0ddc71f22b02a", "parents": ["d365364f145ec9f1ac381b3a90f3aa2d57d4a5dc"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2056519 - Add SpecialPowers for Gecko-only WPT crashtests. r=whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313187\n", "files": ["testing/web-platform/mozilla/tests/infrastructure/specialPowers/specialpowers-crash.html", "testing/web-platform/tests/tools/wptrunner/wptrunner/executors/executormarionette.py"], "git_node": "5f45df1511537ab23fd247471f2ec373ba0171c3", "git_parents": ["a13b0bef4c46d42be8effa1ab8e5d09b95631c2f"], "node": "d0f115e69cb69f054e8ea30d94f418e93ef1d3f5", "parents": ["764b096ba8734dc8e9cacb38ffb0ddc71f22b02a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2024438 - Miscellaneous cleanups to LabelsNodeList. r=dom-core-reviewers,jjaschke\n\nWritten while I was going through his code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313191\n", "files": ["dom/base/ContentList.cpp"], "git_node": "2d0a3d025627ead0bad4fa8e61873f5d12beb991", "git_parents": ["5f45df1511537ab23fd247471f2ec373ba0171c3"], "node": "17656ce71419417d41c35c900266d9bd4e71c606", "parents": ["d0f115e69cb69f054e8ea30d94f418e93ef1d3f5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2024438 - Remove unsound WatchLabeledDescendantsOfNearestAncestorLabel. r=dom-core-reviewers,jjaschke\n\nThis will need re-implementing, but on its current shape it is just not\nsound.\n\nIf we need this invalidation, we need to watch \u003clabel\u003e control elements\nmore closely.\n\nRight now:\n\n * We only watch if there's an existing labelable element for the\n   ancestor \u003clabel\u003e (we don't get notified when another labelable\n   element for that label becomes labelable).\n\n * More importantly, we never remove the observer...\n\nFor now, take one subtest regression. Bug 2015796 covers implementing\nthis properly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313190\n", "files": ["dom/base/ContentList.cpp", "dom/base/ContentList.h", "testing/web-platform/meta/shadow-dom/reference-target/tentative/label-descendant.html.ini", "testing/web-platform/mozilla/meta/shadow-dom/__dir__.ini", "testing/web-platform/mozilla/tests/shadow-dom/referencetarget-labels-crash.html"], "git_node": "7026447ebdac4743c14191e1cd75c3f05d0753aa", "git_parents": ["2d0a3d025627ead0bad4fa8e61873f5d12beb991"], "node": "bda692bcea29fe2f2fcb9976b706ce9b1ac317e5", "parents": ["17656ce71419417d41c35c900266d9bd4e71c606"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2053095 - Move untrusted marking back to document-element-inserted, r=dom-core-reviewers,jjaschke\n\nIt turns out that the location in BrowserChild.cpp appears to have been\nsubstantially earlier than the previous location, which may have caused\nus to miss some scripts in the script cache.\n\nAfter this change, it's likely that the first point when a process\nbecomes untrusted is as the HttpChannelChild is created within the\nprocess.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311914\n", "files": ["dom/base/nsContentSink.cpp", "dom/ipc/BrowserChild.cpp"], "git_node": "e1dc6c205d6d52fb622b69fcc8b407fba97a908b", "git_parents": ["7026447ebdac4743c14191e1cd75c3f05d0753aa"], "node": "ee76f675353b13314edf5df1086254f436da7598", "parents": ["bda692bcea29fe2f2fcb9976b706ce9b1ac317e5"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051413 - Newtab client needs to request layouts from remote settings. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312824\n", "files": ["browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/lib/SectionsLayoutFeed.sys.mjs", "browser/extensions/newtab/test/unit/lib/DiscoveryStreamFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_SectionsLayoutFeed.js"], "git_node": "03d42518886d9386b34afdf0444ed64f2e227972", "git_parents": ["e1dc6c205d6d52fb622b69fcc8b407fba97a908b"], "node": "66bcab9c27f3afa0689ebaf527d5334e4a1167b5", "parents": ["ee76f675353b13314edf5df1086254f436da7598"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-ca/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rMX/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", 