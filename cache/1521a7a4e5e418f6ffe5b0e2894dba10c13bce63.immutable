browser/head.js", "toolkit/components/antitracking/test/browser/browser_partitionkey_bloburl.js", "toolkit/components/antitracking/test/browser/trackingAPI.js", "toolkit/components/cookiebanners/test/browser/browser_cookiebannerservice_domainPrefs.js", "toolkit/components/extensions/test/browser/browser_ext_notifications_useSystemBackend_false.js", "toolkit/components/extensions/test/browser/browser_ext_urlclassifier.js", "toolkit/components/extensions/test/mochitest/test_ext_contentscript_securecontext.html", "toolkit/components/extensions/test/mochitest/test_ext_dnr_upgradeScheme.html", "toolkit/components/extensions/test/mochitest/test_ext_webrequest_upgrade.html", "toolkit/components/httpsonlyerror/tests/browser/browser_errorpage_no_timeout.js", "toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/pageextractor/tests/browser/browser_anonymous_headless_extractor.js", "toolkit/components/passwordmgr/test/browser/browser_glean_pwmgr_form_autofill_result.js", "toolkit/components/passwordmgr/test/mochitest/test_include_other_subdomains_in_lookup.html", "toolkit/components/places/tests/browser/browser_upgrade.js", "toolkit/components/places/tests/browser/browser_visituri_restriction.js", "toolkit/components/places/tests/browser/browser_visituri_restriction_origin.js", "toolkit/components/reader/tests/browser/browser_bug1780350_readerModeSaveScroll.js", "toolkit/components/translations/tests/browser/shared-head.js", "toolkit/content/tests/browser/browser_felt_privacy_fallback.js", "toolkit/mozapps/extensions/test/browser/browser_html_detail_permissions.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view.js", "toolkit/mozapps/extensions/test/browser/browser_html_list_view_recommendations.js", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js", "toolkit/mozapps/extensions/test/browser/browser_local_install.js", "toolkit/mozapps/extensions/test/browser/browser_webapi_sendAbuseReport.js", "tools/profiler/tests/browser/browser_test_feature_jstracing_objtestutils.js"], "git_node": "44a4b924ba68e71ce1e0098ab90520b618f53818", "git_parents": ["cd8f60655be016bdf15da5cbac2506b7996a3820"], "node": "3d9c20038808fc5264d281fa5cbfabc931caed77", "parents": ["0b9380ba27c6ac2d843fcbdc8e85a818e3f78de5"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054414: Simplify IteratorEnd check in OptimizeIteratorIndices r=jandem\n\nThis will disable the optimization whenever there is an IteratorEnd between the use and the MoreIter, regardless of which iterator is being closed. This prevents optimizing uses after nested for-in statements. The alternative would be to replace `if (ins-\u003eisIteratorEnd()) { return false; }` with:\n```\nif (ins-\u003eisIteratorEnd()) {\n  MDefinition* endIter = ins-\u003etoIteratorEnd()-\u003eiterator();\n  if (!endIter-\u003eisObjectToIterator() || endIter == iter) {\n    return false;\n  }\n}\n```\nClaude's audit concluded that either approach would be sound; for now I've gone with the conservative choice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315739\n", "files": ["js/src/jit/IonAnalysis.cpp"], "git_node": "18b5a3b0bfb4a386b3885f384d66a271389da73c", "git_parents": ["44a4b924ba68e71ce1e0098ab90520b618f53818"], "node": "4491b31cc20c84a34998b0ae6ef192137cb0c51c", "parents": ["3d9c20038808fc5264d281fa5cbfabc931caed77"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054414: Add test r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315740\n", "files": ["js/src/jit-test/tests/ion/bug2054414.js"], "git_node": "a9167fd1f40f46fe15bf69bf432e5e59c0eb0428", "git_parents": ["18b5a3b0bfb4a386b3885f384d66a271389da73c"], "node": "55d815bf53b6c78488b1fc0d26b124a922998b04", "parents": ["4491b31cc20c84a34998b0ae6ef192137cb0c51c"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049644: Track dense element state in PropertyEnumerator r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315765\n", "files": ["js/src/jit-test/tests/iterator/bug2049644.js", "js/src/vm/Iteration.cpp"], "git_node": "f6a44a697f5f4d6151b16058fd5e6e410b028ceb", "git_parents": ["a9167fd1f40f46fe15bf69bf432e5e59c0eb0428"], "node": "2042d514e6ee551a23c1c0aa0e6d811f03a36227", "parents": ["55d815bf53b6c78488b1fc0d26b124a922998b04"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057198 - Change menu entry on home screen from \"Update wallpaper\" to \"Customize homepage\" r=android-reviewers,android-l10n-reviewers,parker,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314468\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/ThreeDotMenuMainRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MainMenu.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuNavigationMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuTelemetryMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/store/MenuAction.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/home_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuNavigationMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuTelemetryMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/MainMenuTest.kt"], "git_node": "e15edc126b3a3454cefafe3645fc644c3aae7352", "git_parents": ["f6a44a697f5f4d6151b16058fd5e6e410b028ceb"], "node": "55101b2d093a138bd7aa9ce5a3ff40ee996ba62b", "parents": ["2042d514e6ee551a23c1c0aa0e6d811f03a36227"], "tags": []}, {"author": "s-rosen \u003csimon.rosen17@gmail.com\u003e", "branch": "default", "desc": "Bug 1875517 - Add a playback speed control to the Picture-in-Picture player. r=fluent-reviewers,desktop-theme-reviewers,kpatenio,bolsson,dao\n\nAdds a playback speed button to the Picture-in-Picture window, gated behind\nthe pref media.videocontrols.picture-in-picture.playback-speed.enabled.\nIt opens a panel, modeled on the existing subtitles settings panel, containing a live\nrate readout, a 0.25x-2.0x slider, and one-tap presets for 0.75x/1.0x/1.25x/1.5x/2.0x.\nThe \u003c and \u003e keys (with Shift key as a modifier) step through the standard presets.\n\nThe rate is applied to the originating video through new overridable\nPictureInPictureChildVideoWrapper methods (getPlaybackRate/setPlaybackRate)\nwith the usual fallback implementation. A ratechange listener on the\noriginating video keeps the panel in sync when the rate is changed from\nthe page, and the originating video's rate is carried into the PiP window\nwhen it opens (mirroring the existing volume flow).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306643\n", "files": ["browser/app/profile/firefox.js", "toolkit/actors/PictureInPictureChild.sys.mjs", "toolkit/components/pictureinpicture/PictureInPicture.sys.mjs", "toolkit/components/pictureinpicture/content/player.js", "toolkit/components/pictureinpicture/content/player.xhtml", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/pictureinpicture/tests/browser_playbackRate.js", "toolkit/locales/en-US/toolkit/pictureinpicture/pictureinpicture.ftl", "toolkit/themes/shared/media/playback-speed-button.svg", "toolkit/themes/shared/minimal-toolkit.jar.inc.mn", "toolkit/themes/shared/pictureinpicture/player.css"], "git_node": "961df7232a53c686d7594164c2f9d34a861ef400", "git_parents": ["e15edc126b3a3454cefafe3645fc644c3aae7352"], "node": "1ee9c0836cf61aecadbee28009f1d29b4e7f862e", "parents": ["55101b2d093a138bd7aa9ce5a3ff40ee996ba62b"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059557 - Consolidate /contentsharing and SharingUtils into /sharing. r=tabbrowser-reviewers,places-reviewers,urlbar-reviewers,nbarrett,jsudiaman,janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315428\n", "files": ["browser/base/content/browser.js", "browser/base/content/main-popupset.js", "browser/components/contentsharing/ContentSharingUtils.sys.mjs", "browser/components/contentsharing/content/background-dark.svg", "browser/components/contentsharing/content/background-light.svg", "browser/components/contentsharing/content/content-sharing-icon.svg", "browser/components/contentsharing/content/content-sharing-modal.css", "browser/components/contentsharing/content/content-sharing-modal.mjs", "browser/components/contentsharing/content/contentSharingModal.xhtml", "browser/components/contentsharing/contentsharing.schema.json", "browser/components/contentsharing/jar.mn", "browser/components/contentsharing/metrics.yaml", "browser/components/contentsharing/moz.build", "browser/components/contentsharing/tests/browser/ContentSharingMockServer.sys.mjs", "browser/components/contentsharing/tests/browser/browser.toml", "browser/components/contentsharing/tests/browser/browser_testFeatureDisabled.js", "browser/components/contentsharing/tests/browser/browser_testLoadingState.js", "browser/components/contentsharing/tests/browser/browser_testModalErrors.js", "browser/components/contentsharing/tests/browser/browser_testPrivateBrowsing.js", "browser/components/contentsharing/tests/browser/browser_testReuseAuthCompleteTab.js", "brow