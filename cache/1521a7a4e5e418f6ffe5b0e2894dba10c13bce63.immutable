2786e31"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048207 - Move trust-panel urlbar tests into browser-trustPanel/. r=urlbar-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312612\n", "files": ["browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "browser/components/urlbar/tests/browser-trustPanel/browserNova.toml", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_cert_exception.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_focus.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_pages.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_security_view.js", "browser/components/urlbar/tests/browser-trustPanel/head.js", "browser/components/urlbar/tests/browser/browser.toml", "browser/components/urlbar/tests/browser/browser_trust_panel.js", "browser/components/urlbar/tests/browser/browser_trust_panel_cert_exception.js", "browser/components/urlbar/tests/browser/browser_trust_panel_focus.js", "browser/components/urlbar/tests/browser/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser/browser_trust_panel_pages.js", "browser/components/urlbar/tests/browser/browser_trust_panel_security_view.js", "tools/lint/rejected-words.yml"], "git_node": "1e199f0fd130d93b12a5c6f7ea7129cde0140592", "git_parents": ["9b2a5853dcf2d8d7b4a2aefbd91480a8c62a705a"], "node": "5ab718c5a32c093f8846931b1c2a9fcf92c37058", "parents": ["1072c4c4c80c2070c4a9c00d5ae65b6664ee0c86"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055839 - Ensure accelerated canvas uses glMapBufferRange fast path on Metal ANGLE. r=gfx-reviewers,gw\n\nBug 1827047 prevented us using this fast path on ANGLE due to\nperformance regressions on D3D. At the time, IsANGLE() could only mean\nD3D, but now it can also mean Metal where we do in fact want this fast\npath.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313512\n", "files": ["dom/canvas/WebGLBuffer.cpp", "gfx/gl/GLContext.h", "gfx/gl/GLContextEGL.h", "gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h"], "git_node": "acca47549fb05ef05ad15faa38b613badf1d2809", "git_parents": ["1e199f0fd130d93b12a5c6f7ea7129cde0140592"], "node": "9ec93414071b909bc6fd9f272c02b5a2800d35ec", "parents": ["5ab718c5a32c093f8846931b1c2a9fcf92c37058"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055839 - Use shared PBO for DrawTargetWebgl uploads. r=gfx-reviewers,lsalzman\n\nMetal ANGLE allocates a staging buffer for each glTexSubImage texture\nupload. With accelerated canvas on MotionMark's canvas lines subtest\nthis results in a lot of overhead during upload.\n\nThis patch implements a simple shared PBO upload mechanism for\nDrawTargetWebgl. A fixed-size 1MiB PBO is allocated, and each upload\nappends its data to the end of the buffer before uploading. The buffer\nis orhpaned once full. Individual allocations too large for the buffer\navoid the PBO path altogeher.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313513\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/DrawTargetWebgl.h"], "git_node": "c547c203c14bc9fcffbdd3efff03b0efea2ec2fd", "git_parents": ["acca47549fb05ef05ad15faa38b613badf1d2809"], "node": "c9c78ae99215d977e1b6c17377637ae04f81275f", "parents": ["9ec93414071b909bc6fd9f272c02b5a2800d35ec"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054594 - Expect a full-window paint when window becomes active and nova is enabled. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313327\n", "files": ["browser/base/content/test/performance/head.js"], "git_node": "0a826563227f0bd9ae7195d4badd2fc54ab71360", "git_parents": ["c547c203c14bc9fcffbdd3efff03b0efea2ec2fd"], "node": "cc056d05c4b9dc7a61514784302d1f9cccda55c6", "parents": ["c9c78ae99215d977e1b6c17377637ae04f81275f"], "tags": []}, {"author": "CamBlackwell \u003ccameronBlackwell80@gmail.com\u003e", "branch": "default", "desc": "Bug 2052619 - Added UNINT32_MAX guard for maybeSize in AutoMemMap::initInternal. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313157\n", "files": ["js/xpconnect/loader/AutoMemMap.cpp"], "git_node": "0ec90766bb50e63cdfd0c3ecb3250b530dae92bd", "git_parents": ["0a826563227f0bd9ae7195d4badd2fc54ab71360"], "node": "239533eab8580cc2767719cade3203167e434806", "parents": ["cc056d05c4b9dc7a61514784302d1f9cccda55c6"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2055262 - Introduce TypedSlot and *Typed slot functions. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312335\n", "files": ["js/public/Value.h", "js/src/gc/Barrier.h", "js/src/vm/NativeObject.h"], "git_node": "8175468a7cec8c8ad632fcfd2d96fb0b573fc805", "git_parents": ["0ec90766bb50e63cdfd0c3ecb3250b530dae92bd"], "node": "0ef102e55ddde067139f00d4bd5d75386a3d8924", "parents": ["239533eab8580cc2767719cade3203167e434806"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2055262 - Migrate Date to use TypedSlot. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312336\n", "files": ["js/src/builtin/Date.cpp", "js/src/jit/ScalarReplacement.cpp", "js/src/vm/DateObject.h"], "git_node": "cdbefdcf16dc2b76f0cf1c9f67671f17850d8ee5", "git_parents": ["8175468a7cec8c8ad632fcfd2d96fb0b573fc805"], "node": "f099c0fcad018efee80528e06491dcf5e6264276", "parents": ["0ef102e55ddde