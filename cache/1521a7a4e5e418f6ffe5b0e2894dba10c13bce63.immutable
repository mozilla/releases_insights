a.com\u003e", "branch": "default", "desc": "Bug 2058203 - Re-enable test_ext_tabs_captureTab.html on Nova builds. r=zombie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316912\n", "files": ["toolkit/components/extensions/test/mochitest/mochitest-common.toml"], "git_node": "2d2430308b0a85cfa3c2843733f2e58ff1a9bff1", "git_parents": ["72995df8d97c703a5b3697ad6317db0bc5c9f5a2"], "node": "01499386fe4082b705fb24c37d6a7e2c2f7944b8", "parents": ["cbf6cb69726fb0434841724de90ceddd829c50a3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062315 - Improve PrecomputedHasher's output. r=firefox-style-system-reviewers,dshin\n\nMake sure we don't output the upper 64 bits of hash as always zero.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317579\n", "files": ["servo/components/style/selector_map.rs"], "git_node": "9ac4086531fb1876c31add61356e097525f52811", "git_parents": ["2d2430308b0a85cfa3c2843733f2e58ff1a9bff1"], "node": "71e373401d8479b16296720166f28b6da2c8f3ce", "parents": ["01499386fe4082b705fb24c37d6a7e2c2f7944b8"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059139 - Check textrun length. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317756\n", "files": ["layout/generic/nsTextFrame.cpp"], "git_node": "6edf1a43aee23143d7a0e89ad286c6156ed6db5d", "git_parents": ["9ac4086531fb1876c31add61356e097525f52811"], "node": "b2e3ebbf70da8d543358b770a2f1b2f82b7b8507", "parents": ["71e373401d8479b16296720166f28b6da2c8f3ce"], "tags": []}, {"author": "Brian Smith \u003cbrian@smith.berlin\u003e", "branch": "default", "desc": "Bug 2061661 - Prefer using oneOf over enums in policy schema. r=apieper,mkaply\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317039\n", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": "5ac96b3428b107f508eedb49919752681b477d10", "git_parents": ["6edf1a43aee23143d7a0e89ad286c6156ed6db5d"], "node": "3c57d6608e3616917d4b930f02003e0b0d8a6b95", "parents": ["b2e3ebbf70da8d543358b770a2f1b2f82b7b8507"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059824 - Make gfxUserFontEntry retain ownership of webfont data after sanitization. r=layout-reviewers,gfx-reviewers,emilio,lsalzman\n\nRather than passing ownership of the memory buffer in to the various per-platform\nimplementations of MakePlatformFont, some of which end up holding it behind opaque\nplatform objects, we retain ownership of the buffer in gfxUserFontEntry and share\na reference to it with the platform backends.\n\nThis will allow us to easily instantiate a (platform-independent) Skrifa font ref\nbased on the same buffer, without needing to duplicate potentially large amounts\nof font data for Skrifa vs platform backend use.\n\nThe MakePlatformFont implementations are updated to accept a reference to a\nrefcounted FontData struct that wraps the data buffer & length. The user font entry\ncreates and initially owns this, but backends can also hold a reference for as\nlong as they need to guarantee that the data remains available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317440\n", "files": ["gfx/2d/2D.h", "gfx/2d/Factory.cpp", "gfx/2d/NativeFontResourceFreeType.cpp", "gfx/2d/NativeFontResourceFreeType.h", "gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/CoreTextFontList.h", "gfx/thebes/FontData.h", "gfx/thebes/gfxDWriteCommon.cpp", "gfx/thebes/gfxDWriteCommon.h", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxDWriteFontList.h", "gfx/thebes/gfxFT2FontBase.cpp", "gfx/thebes/gfxFT2FontList.cpp", "gfx/thebes/gfxFT2FontList.h", "gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h", "gfx/thebes/gfxPlatformFontList.h", "gfx/thebes/gfxUserFontSet.cpp", "gfx/thebes/gfxUserFontSet.h", "gfx/thebes/moz.build", "layout/style/nsFontFaceLoader.cpp"], "git_node": "9811930bb1e730cb63f298b401c7cdb7d438340a", "git_parents": ["5ac96b3428b107f508eedb49919752681b477d10"], "node": "c4bf6bc31d9086a3ffd8c7903baa448e27420417", "parents": ["3c57d6608e3616917d4b930f02003e0b0d8a6b95"], "tags": []}, {"author": "Titouan Thibaud \u003ctthibaud@mozilla.com\u003e", "branch": "default", "desc": "Bug 2037209 - Reduce number of iterations of baseline profile generation on try. r=android-reviewers,twhite,aaronmt,npoon,releng-reviewers,bhearsum\n\nThe android try presets will now trigger `generate-baseline-profile-firebase-fenix-simulation` to make sure the baseline profile generation is not broken.\nBuilding Fenix Nightly/Beta/Release will still require the real `generate-baseline-profile-firebase-fenix`, using maxIterations=15, to generate a reliable baseline profile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316502\n", "files": ["mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/BaselineProfileExt.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/BrowserPageScrollBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/HomepageScrollBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/LaunchIntentBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/NormalBrowsingBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/OnboardingBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/PrivateBrowsingBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/StartupOnlyBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/SwitchTabsBaselineProfileGenerator.kt", "taskcluster/kinds/generate-baseline-profile-firebase/kind.yml", "taskcluster/scripts/tests/test-lab.py", "tools/tryselect/try_presets.yml"], "git_node": "f2106199c3da5ff42257623cfc4657870660a24e", "git_parents": ["9811930bb1e730cb63f298b401c7cdb7d438340a"], "node": "6c318959b55cd9eb2abbadb09d3d9badb1933471", "parents": ["c4bf6bc31d9086a3ffd8c7903baa448e27420417"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046965: When the old animation gets reused, do not create a new anonymous timeline. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,boris\n\n... Because we are currently unconditionally re-creating the timeline even when\nsetting animation-play-state, we end up setting a flag for auto-aligning the\nstart time, and gCS returns style without animation cascade.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317212\n", "files": ["dom/animation/ScrollTimeline.cpp", "dom/animation/ScrollTimeline.h", "dom/animation/ViewTimeline.cpp", "dom/animation/ViewTimeline.h", "layout/style/nsAnimationManager.cpp", "testing/web-platform/meta/scroll-animations/css/scroll-timeline-paused-animations.html.ini", "testing/web-platform/meta/scroll-animations/css/view-timeline-paused-animations.html.ini", "testing/web-platform/tests/scroll-animations/css/scroll-timeline-anonymous-reuse.html"], "git_node": "88c93c8d683f6a8afa9cf9585ca3e5f78de7137e", "git_parents": ["f2106199c3da5ff42257623cfc4657870660a24e"], "node": "cd9d2cfc8be19df2dec8a9d9614c3261b68b83b8", "parents": ["6c318959b55cd9eb2abbadb09d3d9badb1933471"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048793 - Use Che