9a2acbc7caee72352fed660", "git_parents": ["b670e7935ad1e2e19a72fbfe53078dd6f67fbfd3"], "node": "e1b5cd0693eadb740644a946e9b4456ce1841cd5", "parents": ["7af6330c5045d692e0281f69b3580d8fc9771f2c"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055260 - Add new memory tracking embedder APIs r=jonco\n\nAdd GetGCHeapSizeForZone, GetMallocHeapSizeForZone, and\nGetJITHeapSizeForZone to the embedder API. Each of these methods\nreturns one of the sizes that is currently added together and\nreturned by GetMemoryUsageForZone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312817\n", "files": ["js/src/jsfriendapi.cpp", "js/src/jsfriendapi.h"], "git_node": "898bdf60aaad2ce389a74eb0671700f098e0f90a", "git_parents": ["fe5682d290f7da9c09a2acbc7caee72352fed660"], "node": "5599a175779a4b55b4199eeed6e194b6f960cb67", "parents": ["e1b5cd0693eadb740644a946e9b4456ce1841cd5"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055173 - Only BrokenSite Other reason should not have \"optional\" in label r=android-reviewers,android-l10n-reviewers,parker,avirvara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312263\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/store/WebCompatReporterStore.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporter.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "ebfed9394f7b9d8f6729928fd643f91b57bc379a", "git_parents": ["898bdf60aaad2ce389a74eb0671700f098e0f90a"], "node": "76604880aeb5380a7f1d5d00c68e0ca637f04159", "parents": ["5599a175779a4b55b4199eeed6e194b6f960cb67"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041701 - History delete button should be visible when disabled with Light theme in Private mode. r=android-reviewers,avirvara\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311522\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryFragment.kt", "mobile/android/fenix/app/src/main/res/values-night/colors.xml", "mobile/android/fenix/app/src/main/res/values/colors.xml"], "git_node": "836b7a75a2add02f33c5ef9ad306477f7f3d2f03", "git_parents": ["ebfed9394f7b9d8f6729928fd643f91b57bc379a"], "node": "2c940e4a118e2fee656487d7b1e122d4f6382828", "parents": ["76604880aeb5380a7f1d5d00c68e0ca637f04159"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021386 - Vendor in latest skv changes. r=mak\n\nThe latest skv changes add the possibility to close a database\nconnection in the same thread where it was opened. This is useful for\nVFS and UDF implementations which perform actions at these life cycle\ndifferentiation points.\n\nThis feature is not needed to replace rkv with skv. By default, both\nimplementations automatically close connections, and the additional\npower of nsSQLiteKeyValueStore to close the connection explicitly\ncauses no backward compatibility issue for the existing rkv users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296420\n", "files": ["third_party/skv/moz.yaml", "third_party/skv/src/abort.rs", "third_party/skv/src/coordinator.rs", "third_party/skv/src/store.rs"], "git_node": "6073fac76670ec665107de65279049bd62e26d84", "git_parents": ["836b7a75a2add02f33c5ef9ad306477f7f3d2f03"], "node": "6fd002da693452dd68f02e687734a3c770064019", "parents": ["2c940e4a118e2fee656487d7b1e122d4f6382828"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021386 - Convert importer tests to use pre-built rkv safe mode fixtures. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296412\n", "files": ["toolkit/components/kvstore/test/xpcshell/data/rkv-baz-bool-double-int.bin", "toolkit/componen