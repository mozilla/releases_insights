/rkv-qux-double.bin", "toolkit/components/kvstore/test/xpcshell/test_sqlite_kvstore.js"], "git_node": "3dd056eaf95043633457fab758293530023274df", "git_parents": ["8e8ea8953f4c90bebe9a72cb3fdff95603175f4b"], "node": "44950c3afa9209512cee70a231765894af41ebd7", "parents": ["0cab47f853d1bc9c28f7c3df3ca55f4034087a83"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2048252 - Look up the last-visited date for Top Site suggestions r=urlbar-reviewers,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312670\n", "files": ["browser/components/urlbar/UrlbarProviderTopSites.sys.mjs", "browser/components/urlbar/tests/unit/test_UrlbarProviderTopSites.js", "browser/components/urlbar/tests/unit/xpcshell.toml"], "git_node": "bd9fd60ccd7c3bb2f1e44a6678c6fbf9d5831cdc", "git_parents": ["3dd056eaf95043633457fab758293530023274df"], "node": "dfa3d15f4060d8f508a171a207674b40d1735379", "parents": ["44950c3afa9209512cee70a231765894af41ebd7"], "tags": []}, {"author": "Marcin Kozi\u0144ski \u003cmkozinski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055784 - Part 1: Switch to runCurrent if there are no delays to advance past r=mcarare,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312693\n", "files": ["mobile/android/android-components/components/lib/accelerometer-sensormanager/src/test/java/mozilla/components/lib/accelerometer/sensormanager/LifecycleAwareSensorManagerAccelerometerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/MarketingPageRemovalSupportTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/perf/ProfilerViewModelTest.kt"], "git_node": "fafb576d7e6d761ba452de2bfb5baa0d775a4851", "git_parents": ["bd9fd60ccd7c3bb2f1e44a6678c6fbf9d5831cdc"], "node": "d93838a028046392847d0c475360c83d8dfcd3cd", "parents": ["dfa3d15f4060d8f508a171a207674b40d1735379"], "tags": []}, {"author": "Marcin Kozi\u0144ski \u003cmkozinski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055784 - Part 2: Use backgroundScope instead of manually managing a job r=mcarare,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312694\n", "files": ["mobile/android/android-components/components/lib/accelerometer-sensormanager/src/test/java/mozilla/components/lib/accelerometer/sensormanager/LifecycleAwareSensorManagerAccelerometerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/MarketingPageRemovalSupportTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/perf/ProfilerViewModelTest.kt"], "git_node": "18af77316bfb2cc2b92baa10a9643473435aab00", "git_parents": ["fafb576d7e6d761ba452de2bfb5baa0d775a4851"], "node": "617892ce4c014240be2cd1a98def10dd7a345f97", "parents": ["d93838a028046392847d0c475360c83d8dfcd3cd"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053935 - [IPC Urlbar] Phase 6: Arm the event bufferer synchronously so a fast Enter is deferred over the message path. r=mbeier\n\nUrlbarEventBufferer defers a just-typed Enter until results arrive so the key\nlands on a stable result instead of a stale heuristic. It armed on the\nQUERY_STARTED notification, which UrlbarParentController.startQuery fires\nsynchronously \"as soon as startQuery is invoked\". In-process that guarantee\nholds; over the actor message path the notification reaches the content-side\nbufferer a round-trip later (after the key event), so a fast type+Enter isn't\ndeferred and navigates the stale heuristic, crashing the test harness's\nnon-local-connection guard on a google.com search URL.\n\nArm the bufferer from UrlbarChildController.startQuery, the single content-side\nentry both inputs route through, via a new queryStarting() call rather than the\nQUERY_STARTED listener notification. This touches only the bufferer's own state\n(it emits no out-of-order notification), so the query lifecycle other listeners\nsee, and exposure telemetry, are unchanged. The arm runs after the query is\ndispatched so the parent's synchronous teardown of the previous query\n(in-process) can't clobber the freshly-armed state. The direct path stays\nbehavior-neutral.\n\nReplaying a deferred down-arrow then hit a second gap: lastResultIsSelected\nreads the stored context's results, but queryStarting armed the bufferer with\nthe pre-query context, whose results the parent populates on its own copy over\nthe message path, so the getter threw on undefined results. Refresh the stored\ncontext from onQueryResults, which receives the results-bearing one; in-process\nthat's the same object, so this is behavior-neutral too.\n\n`newMockController`'s input gains a no-op `eventBufferer` stub, since\n`queryStarting()` now runs for the xpcshell unit tests that drive the child\ncontroller.\n\nGreens browser_autocomplete_enter_race, browser_bufferer_onQueryResults,\nbrowser_slow_heuristic, and browser_tabToSearch's tab_key_race on the message\npath.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311425\n", "files": ["browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarEventBufferer.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs"], "git_node": "99fcc07f176331e1c6acb44dc7b78fa401004159", "git_parents": ["18af77316bfb2cc2b92baa10a9643473435aab00"], "node": "2c9049b4238286e84e07328d64bf0716de0acca7", "parents": ["617892ce4c014240be2cd1a98def10dd7a345f97"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045721: Add IPCClientInfo type checking r=necko-reviewers,ipc-reviewers,dom-worker-reviewers,nika,asuth,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305382\n", "files": ["dom/clients/manager/ClientManagerParent.cpp", "dom/clients/manager/moz.build", "dom/fetch/FetchParent.cpp", "dom/ipc/WindowGlobalParent.cpp", "dom/serviceworkers/ServiceWorkerContainerParent.cpp", "ipc/glue/BackgroundParentImpl.cpp"], "git_node": "bccde97888d6556ef9ccc606f62dbd665d8802d7", "git_parents": ["99fcc07f176331e1c6acb44dc7b78fa401004159"], "node": "1e172828bb1291cbda257e9acea6ccd6c6202a45", "parents": ["2c9049b4238286e84e07328d64bf0716de0acca7"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2046954 - Sandbox - Fix RDD Vulkan sandbox policy for display server access. r=jld,sandbox-reviewers\n\nEnable brokered socket/connect syscalls in the RDD sandbox and add narrow\nMAY_CONNECT rules for Wayland and X11 display sockets so EGL can connect\nfor EGL_MESA_image_dma_buf_export during Vulkan video decode.\n\nOn XWayland, both the Wayland socket and the X11 socket (/tmp/.X11-unix/X*)\nare now allowed since EGL may connect via either path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306340\n", "files": ["security/sandbox/linux/SandboxFilter.cpp", "security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": "34ba72e8f8df8283cfbfe1b3c8f5d32958213b9d", "git_parents": ["bccde97888d6556ef9ccc606f62dbd665d8802d7"], "node": "2bd4d1634b6c006144d400db75688ee09a1374e8", "parents": ["1e172828bb1291cbda257e9acea6ccd6c6202a45"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056240 - Update onboarding to use the updated colour tokens used in the Figma. r=android-reviewers,rebecatudor273\n\nThis patch updates:\n1. the card background colour\n2. The pagination dots\n\n| Dark mode | Light mode |\n| {F75722313} | {F75722321} |\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312994\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/MarketingDataOnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/TermsOfServiceOnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/ToolbarOnboardingPage.kt"], "git_node": "c693f2424f54f60379d68113f07efa645d4a5e54", "git_parents": ["34ba72e8f8df8283cfbfe1b3c8f5d32958213b9d"], "node": "760c73764d5321a01eaa3ad21bb9627f32ea0e02", "parents": ["2bd4d1634b6c006144d400db75688ee09a1374e8"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056247 - Update onboarding pager spacing and card peek r=android-reviewers,rebecatudor273\n\nUpdate the onboarding pager to use the padding and peek values defined in the latest Figma designs.\n\n- The space between the visible card and the edge of the screen should be `24.dp`.\n- When a previous or next card is available, this space should be split into:\n  - `12.dp` spacing between adjacent cards.\n  - `12.dp` of the previous/next card visible as a peek.\n\nScreenshot device was 360dp width.\n\n{F75724780}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313019\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt"], "git_node": "110c4281155cbb479d6eb4d577f513887afdfc51", "git_parents": ["c693f2424f54f60379d68113f07efa645d4a5e54"], "node": "f8ee3e46563ccf7f3ffe7a50759da8aa49128f7f", "parents": ["760c73764d5321a01eaa3ad21bb9627f32ea0e02"], "tags": []}, {"author": "Federico Cucinotta \u003cgithub@fedec.online\u003e", "branch": "default", "desc": "Bug 1418178 - Allow configuring the number of Ctrl-Tab previews with a pref. r=emilio,desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nAdd a hidden pref, browser.ctrlTab.maxPreviews (default 7, clamped to\n[4, 49]), controlling how many tab previews the ctrl-tab panel shows.\nPreviews wrap into rows of at most 7, as suggested in the earlier\nreview of D194909, and the preview buttons are rebuilt when the pref\nchanges. The XUL flex attribute is removed from the preview buttons\nbecause its flex-basis of 0 prevents flex wrapping; the equivalent\nflex styling with a content-based basis is applied in CSS instead.\n\nThis supersedes D194909, which its author invited commandeering of in\nbug 1418178 comment 33.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306290\n", "files": ["browser/app/profile/firefox.js", "browser/components/tabbrowser/content/browser-ctrlTab.js", "browser/components/tabbrowser/test/browser/tabs/browser_ctrlTab.js", "browser/themes/shared/tabbrowser/ctrlTab.css"], "git_node": "22224c1a718aa05d63fcce2e56e9a489bf402f98", "git_parents": ["110c4281155cbb479d6eb4d577f513887afdfc51"], "node": "7608da1da6bf05348b94f3104c031dff31b05e0b", "parents": ["f8ee3e46563ccf7f3ffe7a50759da8aa49128f7f"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049020 \u2014 undo PiP fullscreen Nova icons. r=desktop-theme-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311945\n", "files": ["toolkit/themes/shared/media/picture-in-picture-enter-fullscreen-button.svg", "toolkit/themes/shared/media/picture-in-picture-exit-fullscreen-button.svg"], "git_node": "cfcca8d3b634aec63704820af3fc3aebe87754a6", "git_parents": ["22224c1a718aa05d63fcce2e56e9a489bf402f98"], "node": "e79f7a095f4e6417d06bbc1416ccd52607fdb77c", "parents": ["7608da1da6bf05348b94f3104c031dff31b05e0b"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056247, Bug 2056240 - Update onboarding pager spacing and card peek r=android-reviewers,rebecatudor273\" for causing fenix failures.\n\nThis reverts commit 110c4281155cbb479d6eb4d577f513887afdfc51.\n\nRevert \"Bug 2056240 - Update onboarding to use the updated colour tokens used in the Figma. r=android-reviewers,rebecatudor273\"\n\nThis reverts commit c693f2424f54f60379d68113f07efa645d4a5e54.\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/MarketingDataOnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/TermsOfServiceOnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/ToolbarOnboardingPage.kt"], "git_node": "7bafbf2a1f721385f2c85fc35881537075dbbe46", "git_parents": ["cfcca8d3b634aec63704820af3fc3aebe87754a6"], "node": "5f6d4867e957c04d77430ac71bc261949668008e", "parents": ["e79f7a095f4e6417d06bbc1416ccd52607fdb77c"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046954 - Sandbox - Fix RDD Vulkan sandbox policy for display server access. r=jld,sandbox-reviewers\" for causing failures at browser_sandbox_test.js.\n\nThis reverts commit 34ba72e8f8df8283cfbfe1b3c8f5d32958213b9d.\n", "files": ["security/sandbox/linux/SandboxFilter.cpp", "security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": "77daa967f50c787c35afdb077801a1ae4615cb80", "git_parents": ["7bafbf2a1f721385f2c85fc35881537075dbbe46"], "node": "a168b0e43d987a21c35a3d93f5486d7194eeab65", "parents": ["5f6d4867e957c04d77430ac71bc261949668008e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1418178 - Allow configuring the number of Ctrl-Tab previews with a pref. r=emilio,desktop-theme-reviewers,tabbrowser-reviewers,dao\" for causing failures at browser_ctrlTab.js.\n\nThis reverts commit 22224c1a718aa05d63fcce2e56e9a489bf402f98.\n", "files": ["browser/app/profile/firefox.js", "browser/components/tabbrowser/content/browser-ctrlTab.js", "browser/components/tabbrowser/test/browser/tabs/browser_ctrlTab.js", "browser/themes/shared/tabbrowser/ctrlTab.css"], "git_node": "2162d35669f8063afa49db8a2a428694e6de924b", "git_parents": ["77daa967f50c787c35afdb077801a1ae4615cb80"], "node": "8ffd969853702b947ae61eb8e3b4bd8385c6d7f9", "parents": ["a168b0e43d987a21c35a3d93f5486d7194eeab65"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050397 - Implement Passport management page r=mtigley,fluent-reviewers,desktop-theme-reviewers,credential-management-reviewers,mstriemer,flod\n\nAdd the \"Personal info\" preferences category and its manage subpage,\nbacked by passport autofill. How the preferences work:\n\n\"Personal info\" is a preferences-only grouping of autofill data types\n(passports today; more may join later). It is a pure UI concept, so the\ndata-type registry is intentionally unaware of it and the category's\nmembership is listed in passwords-autofill.mjs.\n\nThere is no dedicated category-level pref. Instead the single \"Save and\nautofill personal info\" checkbox stands in for the .enabled prefs of\nevery member type:\n\n  - Checked state: the box is checked when *any* member type's .enabled\n    pref is true (logical OR), and toggling it writes *every* member\n    type's .enabled pref. So enabling the box actually enables passport\n    autofill (extensions.formautofill.passports.enabled) rather than a\n    separate UI-only pref.\n\nVisibility follows the same rules the address and credit-card sections\nuse, keyed off each type's .supported pref via\nFormAutofill.isAutofillTypeAvailable():\n\n  - The Personal info section (checkbox and \"Manage\" entry point) is\n    shown whenever *any* member type is available.\n  - Inside the manage subpage, each type's controls (the add-passport\n    button and the passport list) are shown only when that type is\n    available, so an unsupported type surfaces no UI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308798\n", "files": ["browser/components/preferences/config/passwords-autofill.mjs", "browser/components/preferences/preferences.js", "browser/extensions/formautofill/content/autofillEditForms.mjs", "browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/content/editPassport.mjs", "browser/extensions/formautofill/content/editPassport.xhtml", "browser/extensions/formautofill/skin/shared/editPassport.css", "browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_editPassportDialog.js", "browser/extensions/formautofill/test/browser/browser_managePersonalInfoSubpage.js", "browser/extensions/formautofill/test/browser/head.js", "browser/extensions/formautofill/test/browser/heuristics/browser.toml", "browser/locales/en-US/browser/preferences/formAutofill.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/icons/personal-info-16.svg", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/preferences/preferences.css", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs"], "git_node": "cca0cb149c4abdea78efb2fbf8f08df3e6d44235", "git_parents": ["2162d35669f8063afa49db8a2a428694e6de924b"], "node": "ea7f2350e5e450dae82a0f9da459a5990ba581f9", "parents": ["8ffd969853702b947ae61eb8e3b4bd8385c6d7f9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056160 - Use aria-expanded attribute for the urlbar result-menu button's open-state styling. r=daleharvey\n\nConverting the result menu to panel-list (Bug 2039292) stopped the [open] attribute from being set on the menu's anchor button. panel-list already reflects the open state on the anchor via aria-expanded, so use that in those rules (it's also what moz-button.css does).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313052\n", "files": ["browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "c55cf3fd09b1b4e41ddbb7aa97da86fa28d60217", "git_parents": ["cca0cb149c4abdea78efb2fbf8f08df3e6d44235"], "node": "61f6c2848b7fcc8e36ff8fa897ca307645a9648d", "parents": ["ea7f2350e5e450dae82a0f9da459a5990ba581f9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2054145 - Apply PollJSSampling's JS engine calls without the thread data lock held, r=profiler-reviewers,canova.\n\nA DOM Worker clearing its JSContext ran PollJSSampling() under its\nThreadRegistration data lock, and PollJSSampling calls into the JS engine\n(js::EnableContextProfilingStack -\u003e ReleaseAllJITCode -\u003e\nCancelOffThreadIonCompile), which blocks on the JS helper threads. The\nSamplerThread holds gPSMutex and blocks acquiring that same data lock, so every\nthread that needs gPSMutex to register/unregister -- including the helper the\nworker waits on -- is stuck. Circular wait.\n\nSplit PollJSSampling into TakeJSSamplingChange() (flips mJSSampling under the\ndata lock) and ApplyJSSamplingChange() (makes the js::Enable* calls). The\ncurrent-thread poll path now takes the data lock only for the state flip and\napplies the JS-engine change with no lock held, mirroring the existing 'drop\nthe global profiler mutex before calling into the JS engine' discipline.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311644\n", "files": ["tools/profiler/core/ProfilerThreadRegistrationData.cpp", "tools/profiler/core/platform.cpp", "tools/profiler/public/ProfilerThreadRegistrationData.h"], "git_node": "724bca4b404c6fd9e9777839f82174a421a972ab", "git_parents": ["c55cf3fd09b1b4e41ddbb7aa97da86fa28d60217"], "node": "239561abdfe82c79e309fdfec386d44960659337", "parents": ["61f6c2848b7fcc8e36ff8fa897ca307645a9648d"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055733 - Preserve touch tilt and altitude/azimuth angles through the APZ round-trip. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312639\n", "files": ["dom/events/test/pointerevents/test_pointerevent_altitude_azimuth_angle.html", "widget/InputData.cpp", "widget/InputData.h", "widget/nsGUIEventIPC.h"], "git_node": "415d6643aa7e4293d7df09a6c7507ff6d414e01c", "git_parents": ["724bca4b404c6fd9e9777839f82174a421a972ab"], "node": "7d3408479de653b0a3526d10540740579c6ac522", "parents": ["239561abdfe82c79e309fdfec386d44960659337"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1949093 [Linux] Merge gfx test utilities to one binary r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311502\n", "files": ["browser/installer/package-manifest.in", "python/mozbuild/mozbuild/artifacts.py", "toolkit/xre/gfxtest/gfxtest.cpp", "toolkit/xre/gfxtest/glxtest.cpp", "toolkit/xre/gfxtest/moz.build", "toolkit/xre/gfxtest/v4l2test.cpp", "toolkit/xre/gfxtest/vaapitest.cpp", "toolkit/xre/gfxtest/vulkantest.cpp", "toolkit/xre/glxtest/glxtest.cpp", "toolkit/xre/glxtest/moz.build", "toolkit/xre/moz.build", "widget/gtk/GfxInfo.cpp", "widget/gtk/GfxInfoUtils.h", "widget/gtk/moz.build", "widget/gtk/v4l2test/moz.build", "widget/gtk/v4l2test/v4l2test.cpp", "widget/gtk/vaapitest/moz.build", "widget/gtk/vaapitest/vaapitest.cpp", "widget/gtk/vulkantest/moz.build", "widget/gtk/vulkantest/vulkantest.cpp"], "git_node": "a5549b324df924a3f6489902e4cf6920f4296928", "git_parents": ["415d6643aa7e4293d7df09a6c7507ff6d414e01c"], "node": "7eec48cf2c4ec1fef0ff6d3b204ef2bf161b0f02", "parents": ["7d3408479de653b0a3526d10540740579c6ac522"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2056218 - Pass FullOriginMetadata by rvalue reference in OriginCacheMap::InsertOrUpdate. r=dom-storage-reviewers,jari\n\nFixes Coverity CID 1697006 (PASS_BY_VALUE): FullOriginMetadata is 184\nbytes and the argument is always moved into the map, so take it by\nrvalue reference to avoid the copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312999\n", "files": ["dom/quota/OriginCacheMap.h"], "git_node": "73e4abf15d7739cd9734f3593b7e3b2ebccdef84", "git_parents": ["a5549b324df924a3f6489902e4cf6920f4296928"], "node": "46667ab7ada55d1c25fbaa744c623ba80a4dc57c", "parents": ["7eec48cf2c4ec1fef0ff6d3b204ef2bf161b0f02"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2056218 - Avoid copying FullOriginMetadata in the InitializeOriginDirectory map lambda. r=dom-storage-reviewers,jari\n\nFixes Coverity CID 1697007 (PASS_BY_VALUE): take the lambda parameter by\nforwarding reference instead of by value, since the 184-byte\nFullOriginMetadata is immediately moved into the returned Maybe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313000\n", "files": ["dom/quota/ActorsParent.cpp"], "git_node": "b6f40b80224d6e07984ea1e6261338e11bb18945", "git_parents": ["73e4abf15d7739cd9734f3593b7e3b2ebccdef84"], "node": "79a7e39189aed9eb0b424f3e74fd8718e7cabf5a", "parents": ["46667ab7ada55d1c25fbaa744c623ba80a4dc57c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2056218 - Read FlagOriginInfoAsDirtyOnDisk result under the mutex. r=dom-storage-reviewers,jari\n\nFixes Coverity CID 1697004 (MISSING_LOCK): on the same-thread path, read\nthe shared result through WaitForResult() so it is accessed while holding\nmMutex, consistent with every other access.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313001\n", "files": ["dom/quota/ActorsParent.cpp"], "git_node": "921b909cd44ddf7ccf9361a393cb7c6a61d01c7d", "git_parents": ["b6f40b80224d6e07984ea1e6261338e11bb18945"], "node": "c15495c0c7f787add90ccbfa1b4c32774ec1147e", "parents": ["79a7e39189aed9eb0b424f3e74fd8718e7cabf5a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2056243 - Move Maybe\u003cRTCErrorParams\u003e in MediaTransportHandlerSTS state-change handlers. r=webrtc-reviewers,bwc\n\nFixes Coverity CID 1696626 and CID 1696625 (COPY_INSTEAD_OF_MOVE): the\nerror value is at its last use when forwarded to the base\nOnStateChange/OnRtcpStateChange, so move it instead of copying.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313002\n", "files": ["dom/media/webrtc/jsapi/MediaTransportHandler.cpp"], "git_node": "ba5e645ed3e3a5179e9c4aa7c156f27571aa366e", "git_parents": ["921b909cd44ddf7ccf9361a393cb7c6a61d01c7d"], "node": "56127d99715fb186795ecb3c89f46ccb19a8f989", "parents": ["c15495c0c7f787add90ccbfa1b4c32774ec1147e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2056243 - Move Maybe\u003cRTCErrorParams\u003e in MediaTransportChild Recv handlers. r=webrtc-reviewers,bwc\n\nFixes Coverity CID 1696624 and CID 1696623 (COPY_INSTEAD_OF_MOVE): the\nerror parameter is at its last use when forwarded to\nOnStateChange/OnRtcpStateChange, so move it instead of copying.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313003\n", "files": ["dom/media/webrtc/jsapi/MediaTransportHandlerIPC.cpp"], "git_node": "0a948b6e566ef3b472d6e9ad46272a202cba0a0c", "git_parents": ["ba5e645ed3e3a5179e9c4aa7c156f27571aa366e"], "node": "443738be761acdc706ec7a3411f12bf161868b58", "parents": ["56127d99715fb186795ecb3c89f46ccb19a8f989"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2056243 - Move Maybe\u003cRTCErrorParams\u003e in PeerConnectionImpl DTLS state-change handlers. r=webrtc-reviewers,bwc\n\nFixes Coverity CID 1696621 and CID 1696620 (COPY_INSTEAD_OF_MOVE): aError\nis at its last use when forwarded to UpdateState/OnDtlsStateChange, so\nmove it instead of copying.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313004\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp"], "git_node": "2c7f8b5eb5959acf38ef87ccb226b428adffc2ca", "git_parents": ["0a948b6e566ef3b472d6e9ad46272a202cba0a0c"], "node": "115902587b8802eb95dc3854bc94b26cc77314b5", "parents": ["443738be761acdc706ec7a3411f12bf161868b58"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2003408 - Make removal from a shared StyleSheetInfo O(1) via a cached index. r=emilio,firefox-style-system-reviewers\n\nRemoveSheet() is called once per sheet sharing an inner during teardown,\nand did a linear IndexOf scan (via UnorderedRemoveElement) over mSheets\nto find the entry.\n\nKeep mSheets as an array (fast and allocation-free for the common case\nof few shared sheets) but cache each sheet's index into it on the\nStyleSheet (mInnerSheetIndex), so removal is an O(1) unordered\nswap-removal with no scan. EnsureUniqueInner() now removes from the old\ninner before cloning, since CloneFor() re-adds the sheet to the clone\nand overwrites the index.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312723\n", "files": ["layout/style/StyleSheet.cpp", "layout/style/StyleSheet.h", "layout/style/StyleSheetInfo.h"], "git_node": "ab75de031daac608eaa0e6a7e9fc802173da110a", "git_parents": ["2c7f8b5eb5959acf38ef87ccb226b428adffc2ca"], "node": "e6dd4c3b9f4e4533533f79e01b0d80bc4ef8ba2d", "parents": ["115902587b8802eb95dc3854bc94b26cc77314b5"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1949093 [Linux] Merge gfx test utilities to one binary r=emilio\" for causing failures at glxtest.cpp.\n\nThis reverts commit a5549b324df924a3f6489902e4cf6920f4296928.\n", "files": ["browser/installer/package-manifest.in", "python/mozbuild/mozbuild/artifacts.py", "toolkit/xre/gfxtest/gfxtest.cpp", "toolkit/xre/gfxtest/glxtest.cpp", "toolkit/xre/gfxtest/moz.build", "toolkit/xre/gfxtest/v4l2test.cpp", "toolkit/xre/gfxtest/vaapitest.cpp", "toolkit/xre/gfxtest/vulkantest.cpp", "toolkit/xre/glxtest/glxtest.cpp", "toolkit/xre/glxtest/moz.build", "toolkit/xre/moz.build", "widget/gtk/GfxInfo.cpp", "widget/gtk/GfxInfoUtils.h", "widget/gtk/moz.build", "widget/gtk/v4l2test/moz.build", "widget/gtk/v4l2test/v4l2test.cpp", "widget/gtk/vaapitest/moz.build", "widget/gtk/vaapitest/vaapitest.cpp", "widget/gtk/vulkantest/moz.build", "widget/gtk/vulkantest/vulkantest.cpp"], "git_node": "2fb13660e05073568422b7d25f2e23391348c403", "git_parents": ["ab75de031daac608eaa0e6a7e9fc802173da110a"], "node": "89e8e590f99b3e5f238a769fbd8176ad8c02605a", "parents": ["e6dd4c3b9f4e4533533f79e01b0d80bc4ef8ba2d"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2055979. Update mp4parse-rust to 8a49a0769764. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312846\n", "files": [".cargo/config.toml.in", "Cargo.lock", "third_party/rust/mp4parse/.cargo-checksum.json", "third_party/rust/mp4parse/src/lib.rs", "third_party/rust/mp4parse/tests/public.rs", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "42ed36492a9f6c9844a91a039152898e2368dd62", "git_parents": ["2fb13660e05073568422b7d25f2e23391348c403"], "node": "f35e4ba931f010f02b67b3c5c3fc4fe3f48ba457", "parents": ["89e8e590f99b3e5f238a769fbd8176ad8c02605a"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055856 - Update gfx SanityTest to load with a resource:// URL in a content process. r=Gijs,gfx-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312717\n", "files": ["dom/security/nsContentSecurityUtils.cpp", "toolkit/components/gfx/SanityTest.sys.mjs", "toolkit/components/gfx/content/gfxFrameScript.js", "toolkit/components/gfx/content/sanitytest.html", "toolkit/components/gfx/jar.mn"], "git_node": "704c491db19e1539e8217425c718718aa5567ead", "git_parents": ["42ed36492a9f6c9844a91a039152898e2368dd62"], "node": "a9b1a1c9e9551e9c81fa541e79ef54a7232f83d3", "parents": ["f35e4ba931f010f02b67b3c5c3fc4fe3f48ba457"], "tags": []}, {"author": "Sebastian Zartner \u003csebastianzartner@gmail.com\u003e", "branch": "default", "desc": "Bug 1692434 - Grouped media query emulation features in panel. r=devtools-reviewers,nchevobbe,fluent-reviewers,bolsson\n\nA new Emulation Features panel got introduced, which holds features for color scheme and print media emulation.\nThis panel can be toggled via a toolbar button.\nThe options themselves are grouped by feature in the new panel. Each feature is now also linked to the related MDN documentation page.\n\nThe print media toolbar button got removed, though the color scheme toolbar buttons are kept to keep the one-click UX for color scheme emulation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300993\n", "files": ["devtools/client/inspector/components/InspectorTabPanel.css", "devtools/client/inspector/emulation/actions/emulation.js", "devtools/client/inspector/emulation/actions/index.js", "devtools/client/inspector/emulation/actions/moz.build", "devtools/client/inspector/emulation/moz.build", "devtools/client/inspector/emulation/reducers/emulation.js", "devtools/client/inspector/emulation/reducers/moz.build", "devtools/client/inspector/index.xhtml", "devtools/client/inspector/moz.build", "devtools/client/inspector/rules/rules.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_bfcache.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_rdm.js", "devtools/client/inspector/rules/test/browser_rules_light_dark.js", "devtools/client/inspector/rules/test/browser_rules_media-queries.js", "devtools/client/inspector/rules/test/browser_rules_print_media_simulation.js", "devtools/client/inspector/rules/test/doc_media_queries.html", "devtools/client/inspector/rules/test/head.js", "devtools/client/jar.mn", "devtools/client/locales/en-US/inspector.ftl", "devtools/client/locales/en-US/inspector.properties", "devtools/client/themes/images/rules-view-print-simulation.svg", "devtools/client/themes/rules.css", "devtools/client/themes/toolbars.css"], "git_node": "ecc77fe767e99087470f981636ab1e9f541a037f", "git_parents": ["704c491db19e1539e8217425c718718aa5567ead"], "node": "3a692da9be0135ddc4ba9de4c19ea316c324b338", "parents": ["a9b1a1c9e9551e9c81fa541e79ef54a7232f83d3"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054416 - Validate RemoteTypeOverride. r=nika,necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312471\n", "files": ["docshell/base/nsDocShellLoadState.cpp", "netwerk/ipc/DocumentLoadListener.cpp"], "git_node": "3ec5c71b41bbcfac3020b53db373d41202ee516b", "git_parents": ["ecc77fe767e99087470f981636ab1e9f541a037f"], "node": "6598e4b352ef421d407fea8e6fa318de9360ce8b", "parents": ["3a692da9be0135ddc4ba9de4c19ea316c324b338"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1949093 [Linux] Merge gfx test utilities to one binary r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311502\n", "files": ["browser/installer/package-manifest.in", "python/mozbuild/mozbuild/artifacts.py", "toolkit/xre/gfxtest/gfxtest.cpp", "toolkit/xre/gfxtest/glxtest.cpp", "toolkit/xre/gfxtest/moz.build", "toolkit/xre/gfxtest/v4l2test.cpp", "toolkit/xre/gfxtest/vaapitest.cpp", "toolkit/xre/gfxtest/vulkantest.cpp", "toolkit/xre/glxtest/glxtest.cpp", "toolkit/xre/glxtest/moz.build", "toolkit/xre/moz.build", "widget/gtk/GfxInfo.cpp", "widget/gtk/GfxInfoUtils.h", "widget/gtk/moz.build", "widget/gtk/v4l2test/moz.build", "widget/gtk/v4l2test/v4l2test.cpp", "widget/gtk/vaapitest/moz.build", "widget/gtk/vaapitest/vaapitest.cpp", "w