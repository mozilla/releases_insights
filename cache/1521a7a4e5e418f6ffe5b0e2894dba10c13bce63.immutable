gn", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0074.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0104.patch", "third_party/libwebrtc/moz-patch-stack/s0109.patch"], "git_node": "1117156d010b152a331c82de08f9beb0cacfe2e8", "git_parents": ["a1e1748c0a941979e630ff624e02e0e3aa622434"], "node": "f0a17059645d61965bda0e9d622f83ec87eaf5b7", "parents": ["234bee46854808ce54670af731813c3097b8fa00"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from cd6dbf4793\n\nUpstream commit: https://webrtc.googlesource.com/src/+/cd6dbf47937cee5aff1e3d52f58f258da9e6bbea\n    Make sure rid has a matching ssrc when requesting keyframe.\n\n    Bug: b/510386551\n    Change-Id: Ic1a6606d987dc2ff3dced041235317bc7436972b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484940\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48072}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/video/video_send_stream_impl.cc", "third_party/libwebrtc/video/video_send_stream_impl_unittest.cc"], "git_node": "795cfa20989b3ecfb05404db10420d4fdbe6d3c2", "git_parents": ["1117156d010b152a331c82de08f9beb0cacfe2e8"], "node": "b9e1ab24e56749ff1c4010e9e9225a1cb46c11ac", "parents": ["f0a17059645d61965bda0e9d622f83ec87eaf5b7"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from e9f4924b6c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e9f4924b6ccd53114a76240e50200dbf64b2a00b\n    Add support for external frame drop signal in EncoderBitrateAdjuster.\n\n    Bug: webrtc:42225768\n    Change-Id: If88d73525fd3e09aa156ff20d9a54c2382da3816\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484980\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48073}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0068.patch", "third_party/libwebrtc/moz-patch-stack/s0102.patch", "third_party/libwebrtc/moz-patch-stack/s0131.patch", "third_party/libwebrtc/video/encoder_bitrate_adjuster.cc", "third_party/libwebrtc/video/encoder_bitrate_adjuster.h", "third_party/libwebrtc/video/encoder_bitrate_adjuster_unittest.cc", "third_party/libwebrtc/video/encoder_overshoot_detector.cc", "third_party/libwebrtc/video/video_stream_encoder.cc", "third_party/libwebrtc/video/video_stream_encoder_unittest.cc"], "git_node": "1e8684c0cf88fdcbf2e848099d584586dfc4d0fd", "git_parents": ["795cfa20989b3ecfb05404db10420d4fdbe6d3c2"], "node": "b11adadabe6986c36414f0549de9a075e502d011", "parents": ["b9e1ab24e56749ff1c4010e9e9225a1cb46c11ac"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 2eb08c6dce\n\nUpstream commit: https://webrtc.googlesource.com/src/+/2eb08c6dce9509b3b6aede64189b333213a65a5f\n    Prevent potential nullptr dereference if metrics are not enabled.\n\n    If `webrtc::metrics::Enable();` has not been called, then\n    `metrics::HistogramFactoryGetCountsLinear()` may return a nullptr.\n\n    Bug: None\n    Change-Id: Id5c01c461fbac818dd91d31a0c2a7fce4fa4f15e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485100\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48074}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/video/send_statistics_proxy.cc"], "git_node": "b773d4794f515c1594f7378bfcd993682df24ad9", "git_parents": ["1e8684c0cf88fdcbf2e848099d584586dfc4d0fd"], "node": "310c0ab4f20b073342052bb01440e6b213c4d2cb", "parents": ["b11adadabe6986c36414f0549de9a075e502d011"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 5a17b97df9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5a17b97df91370162109acab41f856079de897cb\n    Relax feedback NTP timestamp reordering threshold to 5 seconds\n\n    When congestion control feedback or transport feedback arrives out of order,\n    a negative feedback time delta can occur. A 500 ms threshold was too strict\n    and triggered unexpected feedback NTP time delta warnings and offset resets\n    when packets reordered by more than 500 ms. Increase the negative delta\n    threshold to -5 seconds in TransportFeedbackAdapter and ParsedRtcEventLog.\n\n    Bug: webrtc:515090595\n    Change-Id: I28b034165896f453183c6b325102ead55658cc0f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485101\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Auto-Submit: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48075}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/logging/rtc_event_log/rtc_event_log_parser.cc", "third_party/libwebrtc/modules/congestion_controller/rtp/transport_feedback_adapter.cc"], "git_node": "ec2c60e313f560d23a6b969ffd5a402fbc86d89c", "git_parents": ["b773d4794f515c1594f7378bfcd993682df24ad9"], "node": "7c2812f53d1ab7fc34f55696919f6f279457c323", "parents": ["310c0ab4f20b073342052bb01440e6b213c4d2cb"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 4e0c079a2b\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4e0c079a2b24c7ec577949494e94ba6f5bf264e4\n    Reland \"SetLocalDescription: Avoid redundant offer/answer generation\"\n\n    This is a reland of commit 21c8bd5b1fb6f4e3b1cc96fd928e18dc6281f67a\n\n    The downstream failures were false positives but even so this reland\n    includes improvements to the dcheck verification logic to keep the\n    options used to generate the cached offer/answer and incorporate async\n    sequencing.\n\n    Original change's description:\n    \u003e SetLocalDescription: Avoid redundant offer/answer generation\n    \u003e\n    \u003e In parameterless SetLocalDescription(), we currently always generate a\n    \u003e new description. This change optimizes it by reusing the last created\n    \u003e offer or answer if no renegotiable state changes have occurred since it\n    \u003e was generated.\n    \u003e\n    \u003e Bug: chromium:40120757\n    \u003e Change-Id: I158c0b900adde0966537ef274d0d750492e68449\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/481600\n    \u003e Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48020}\n\n    Bug: chromium:40120757\n    Change-Id: I219dfbbb6e949a2a8f9280f403713dbd39539f6b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/483040\n    Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48076}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/peer_connection_signaling_unittest.cc", "third_party/libwebrtc/pc/rtp_transceiver.cc", "third_party/libwebrtc/pc/sdp_offer_answer.cc", "third_party/libwebrtc/pc/sdp_offer_answer.h"], "git_node": "b8dbec4811caa1339ecfa1e334b0aaa0f39957b5", "git_parents": ["ec2c60e313f560d23a6b969ffd5a402fbc86d89c"], "node": "63cb38298b1cd7722661d44d7df1b12b085d1d98", "parents": ["7c2812f53d1ab7fc34f55696919f6f279457c323"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 3590bc3fc9\n\nWe already cherry-picked this when we vendored 4820cf11c5.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/3590bc3fc94418ecddf2a2cf392e19f8a1a17a05\n    Revert \"Sframe encryptor implementation\"\n\n    This reverts commit 4820cf11c56af592ea4ed02cbce7c0b1a7656fbe.\n\n    Reason for revert: Breaks downstream projects due to new third party dependency.\n\n    Original change's description:\n    \u003e Sframe encryptor implementation\n    \u003e\n    \u003e This CL introduces the concrete Sframe encryptor that sits between the\n    \u003e public key-management API and the media pipeline, implementing the\n    \u003e sender-side wiring for Sframe end-to-end encryption.\n    \u003e\n    \u003e # High-level design\n    \u003e The implementation follows a three-layer split that matches the existing\n    \u003e WebRTC layering and respects the api/ visibility rules: 1. Public API\n    \u003e layer (api/sframe/) - A narrow, stable interface that exposes only key\n    \u003e management to applications: setting an encryption key on the sender\n    \u003e side.\n    \u003e\n    \u003e 2. Internal media interface layer (modules/sframe/) - Extends the public\n    \u003e key-management interface with the Encrypt and \"max ciphertext size\"\n    \u003e entry points used by the media pipeline. This is the surface the media\n    \u003e channel speaks to; application code never sees it.\n    \u003e\n    \u003e 3. Concrete impl layer (modules/sframe/) - Implements the media\n    \u003e interface on top of the cisco/sframe library.\n    \u003e\n    \u003e Splitting key management from frame protection lets the public handle\n    \u003e expose only the small surface applications need, while the media\n    \u003e pipeline talks to a richer interface internally.\n    \u003e\n    \u003e Bug: webrtc:479862368\n    \u003e Change-Id: Id93dba5874b6f5b1f32723755dd404af202f6ecf\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/481301\n    \u003e Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48065}\n\n    Bug: webrtc:479862368\n    Change-Id: Icef4fe1ce6e391b045f7b94087ee419b7899a96c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485200\n    Commit-Queue: Johannes Kron \u003ckron@webrtc.org\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48077}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/3590bc3fc9.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch"], "git_node": "62b2f9ae6d598cde7ed821d8c566020731bf57df", "git_parents": ["b8dbec4811caa1339ecfa1e334b0aaa0f39957b5"], "node": "9185659b4e7fca757d0419ff6075522e6c2d8061", "parents": ["63cb38298b1cd7722661d44d7df1b12b085d1d98"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from b77d80422e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b77d80422e17c5ef542805bf22d22fe986118e1b\n    Reduce max time between repeat frame to avoid flakiness.\n\n    The frame cadance adapter injects repeat frames with a ca 1s interval\n    even if no new content has arrived, and the libaom AV1 encoder skips\n    higher temporal layer repeat frames for up to 1s. The causes a\n    potential race between the two that may in some edge cases result in\n    an extra keyframe being generated. Reducing the encoder interval to\n    500ms avoids that condition.\n\n    Bug: b/519058486\n    Change-Id: I3f84be1dbc5a2c160ce76afaa6034332f5429e10\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485120\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48078}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder.cc", "third_party/libwebrtc/moz-patch-stack/s0124.patch", "third_party/libwebrtc/moz-patch-stack/s0133.patch", "third_party/libwebrtc/moz-patch-stack/s0135.patch"], "git_node": "334665cbb84d715b0152d653fa70657fb8be15aa", "git_parents": ["62b2f9ae6d598cde7ed821d8c566020731bf57df"], "node": "72ddbbe713351217d154bb7fd799dedf603acf5e", "parents": ["9185659b4e7fca757d0419ff6075522e6c2d8061"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from ceca392160\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ceca392160739ca27e642edf33972707fd47750f\n    Roll chromium_revision 31af8a3bc7..35ac7eab8b (1651123:1651839)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/31af8a3bc7..35ac7eab8b\n    Full diff: https://chromium.googlesource.com/chromium/src/+/31af8a3bc7..35ac7eab8b\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/bd86dae874..0cd0da38e2\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/d31b0403c7..74b0e069a3\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/96cb8b22ec..fa465dc169\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/dbae726227..b9d56f2f82\n    * src/third_party/androidx/cipd: MLly0zGQsQ09fsGpsNKfknJmg-UhQ5YN_fF9eHmy8PYC..o_OuE2CO4QyCxyuLHRYazGc8604VcVjMMnWXZ-0qsskC\n    * src/third_party/boringssl/src: https://boringssl.googlesource.com/boringssl.git/+log/2bbaed043e..cfb6860620\n    * src/third_party/compiler-rt/src: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/compiler-rt.git/+log/f079fcc71d..b8772d83c8\n    * src/third_party/eigen3/src: https://chromium.googlesource.com/external/gitlab.com/libeigen/eigen.git/+log/bf7d62172f..6103881d14\n    * src/third_party/google-truth/src: https://chromium.googlesource.com/external/github.com/google/truth.git/+log/389c59fe47..0ec4145f1e\n    * src/third_party/grpc/src: https://chromium.googlesource.com/external/github.com/grpc/grpc.git/+log/c90dc002fe..4c2cd9b2b4\n    * src/third_party/harfbuzz/src: https://chromium.googlesource.com/external/github.com/harfbuzz/harfbuzz.git/+log/6dda1a083c..511df88b82\n    * src/third_party/kotlin_stdlib/cipd: vxSXXwFEZlvis5sB5DCupP-Bk7HTj92OBwRiC9jAbZIC..gksJWToP3p4HV2UvlIeFHtixY1Mgv2BUKn3dswOs4MIC\n    * src/third_party/libgav1/src: https://chromium.googlesource.com/codecs/libgav1.git/+log/66ac176206..9b9ac86895\n    * src/third_party/llvm-libc/src: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/libc.git/+log/37de7002cb..9160bc05cd\n    * src/third_party/perfetto: https://chromium.googlesource.com/external/github.com/google/perfetto.git/+log/b2c16893e2..bdbea786f1\n    * src/tools: https://chromium.googlesource.com/chromium/src/tools/+log/64e35c5377..da284fdfb5\n    DEPS diff: https://chromium.googlesource.com/chromium/src/+/31af8a3bc7..35ac7eab8b/DEPS\n\n    BUG=None\n\n    Change-Id: I5b251cbda2396fd2c0429eb8ee08ddfca4d75259\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485300\n    Bot-Commit: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48079}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "6487293e80fa55e059b17b75c28a3fd97efa2955", "git_parents": ["334665cbb84d715b0152d653fa70657fb8be15aa"], "node": "30fa4fa47650dda326305fae2a1746401863a351", "parents": ["72ddbbe713351217d154bb7fd799dedf603acf5e"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from c27bc56fa5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c27bc56fa588f6e2c3dfe1470dfad5cd1e1ce946\n    Update WebRTC code version (2026-06-25T04:04:44).\n\n    Bug: None\n    Change-Id: If051235b27616bbd2dd956dd804ef5a032d8f983\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485420\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48080}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "0492b2267e5d6e97fdb533328dd6dd77b5559c5d", "git_parents": ["6487293e80fa55e059b17b75c28a3fd97efa2955"], "node": "0329a5b26c7d8970a310b94b7d7879b0fcbbc885", "parents": ["30fa4fa47650dda326305fae2a1746401863a351"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 394a597b7e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/394a597b7e832291b3dc66e6cd8362516fc36940\n    Fix data channel ID reuse race condition\n\n    When a peer reopens a data channel quickly after closing it, the Host\n    might receive the new OPEN message while the old channel is still in\n    kClosing state (waiting for the Client's ACK to complete the reset).\n    This causes the Host to reject the OPEN message because the SID is\n    still marked as reserved.\n\n    This fix forcefully closes the old channel if it is in kClosing state\n    and we receive a new OPEN message for the same SID, allowing the new\n    channel to be created successfully.\n\n    Also includes a reproduction test in data_channel_controller_unittest.cc.\n\n    Bug: chromium:480916451\n    Change-Id: Ie181a110f5d23561dcd90fbc63676f18040a7429\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485180\n    Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48081}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/data_channel_controller.cc", "third_party/libwebrtc/pc/data_channel_controller_unittest.cc"], "git_node": "9f499b1dd93b8f40418d60c493139c8fb7463d78", "git_parents": ["0492b2267e5d6e97fdb533328dd6dd77b5559c5d"], "node": "2fc25ad2fd74c20bb737c045f636be54fd7a6031", "parents": ["0329a5b26c7d8970a310b94b7d7879b0fcbbc885"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 1395bc1e61\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1395bc1e611ced8ffff25963b230ae7d1f85c39c\n    agents: add api-compat-reviewer skill\n\n    which catches api changes that might cause downstream\n    breakages due to API compat changes.\n\n    Testable e.g. with\n      Use the api-compat-reviewer skill to review commit 60094aab91. Review just the commit.\n      We are testing whether the skill based on the revert and reland works\n    from the reverted\n      https://webrtc-review.googlesource.com/c/src/+/470580\n\n    Bug: webrtc:465491622\n    Change-Id: I2ede32ea5308e61b986afde34fa05ec9f92cfa88\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/470981\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48082}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/agents/skills/api-compat-reviewer/SKILL.md", "third_party/libwebrtc/agents/skills/api-compat-reviewer/references/bad_patterns.md", "third_party/libwebrtc/agents/skills/api-compat-reviewer/references/checklist.md"], "git_node": "1719a9b81553708d24995e486c06d1f1d1c4f2d5", "git_parents": ["9f499b1dd93b8f40418d60c493139c8fb7463d78"], "node": "67932d82758983a7d61740e3790c31477c626d44", "parents": ["2fc25ad2fd74c20bb737c045f636be54fd7a6031"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from ff95cab2f0\n\nWe already cherry-picked this when we vendored 86fc980100.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ff95cab2f007b728ef12e8b6d46764488f3754f1\n    Revert \"Exclude rate_tracker_rust_tests from ASan builds\"\n\n    This reverts commit 86fc98010046899a27f3804668b28fdc3e6781cd.\n\n    Reason for revert: This should be fixed by https://gn-review.git.corp.google.com/c/gn/+/23360 so excluding the target should no longer be necessary :)\n\n    Original change's description:\n    \u003e Exclude rate_tracker_rust_tests from ASan builds\n    \u003e\n    \u003e In is_asan=true is_debug=false builds, it fails to link (see bug).\n    \u003e Exclude it to unbreak the builds.\n    \u003e\n    \u003e Bug: chromium:513478482\n    \u003e Change-Id: Iceae7d2b94e3a2ce014f2da2f0dad2e136c125f9\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/482721\n    \u003e Commit-Queue: Hans Wennborg \u003chans@chromium.org\u003e\n    \u003e Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48026}\n\n    Bug: chromium:513478482\n    Change-Id: Ib9d0735b5ec7cd54b6c7609bea37b14889162daf\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485380\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48083}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/ff95cab2f0.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "cb7e567cfb02a0b62532cacbf78bcd0bc5c0adc0", "git_parents": ["1719a9b81553708d24995e486c06d1f1d1c4f2d5"], "node": "984ca90749aec0603c50527d199f262439889cae", "parents": ["67932d82758983a7d61740e3790c31477c626d44"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 8a89f9623f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8a89f9623f2abb4099ccadc441d0a087a913ded1\n    Make VideoJitterTimingFactory injectable through PeerConnectionFactoryDependencies.\n\n    Bug: b/493549134\n    Change-Id: Ida2c39fdc425eb5de195e11e45fc465695f