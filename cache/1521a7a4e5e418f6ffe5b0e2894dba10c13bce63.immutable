n\nDifferential Revision: https://phabricator.services.mozilla.com/D314023\n", "files": ["browser/base/content/test/sync/browser_sync.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "ad93953724c26d691d6a60a1f8a750261da04269", "git_parents": ["a70c70d324b9722027c947f70612fdea7ea5a006"], "node": "e7bdb339f3ae00f00e56720c1ba268f051eb85ad", "parents": ["5e0dbe044335b9afd38efca4d569296866c66801"], "tags": []}, {"author": "Alex Cottner \u003cacottner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056364 - Making remote-settings v2 the default version to sync with for desktop. r=Sasha,leplatrem,mozperftest-reviewers,dimi,kshampur\n\nMaking remote-settings v2 the default version for desktop.\nWe can still switch to v1 for a:b comparisons on nightly and dev builds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313612\n", "files": ["python/mozperftest/mozperftest/system/ml_services.py", "python/mozperftest/mozperftest/tests/test_ml_services.py", "services/settings/docs/index.md", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh", "testing/firefox-ui/tests/functional/safebrowsing/test_initial_download.py", "toolkit/modules/AppConstants.sys.mjs"], "git_node": "a04ea786af2f4625ecfc2ed4fa2878cc6089555b", "git_parents": ["ad93953724c26d691d6a60a1f8a750261da04269"], "node": "b13523dd6bd1e11af2c97148208bb7262903bc49", "parents": ["e7bdb339f3ae00f00e56720c1ba268f051eb85ad"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2032141: Add subdomain information for specific high volume sites to the eTLD+1 pageload event. r=denispal,data-stewards,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311839\n", "files": ["dom/metrics.yaml", "tools/performance/PageloadEvent.cpp"], "git_node": "c44e4542249b0942acc252230938fbcb3e05b4c0", "git_parents": ["a04ea786af2f4625ecfc2ed4fa2878cc6089555b"], "node": "34488f5320d70fcffec1ff1372e71c634e4642a0", "parents": ["b13523dd6bd1e11af2c97148208bb7262903bc49"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2058384: Remove temp-copy for LBoxFloatingPoint. r=jandem\n\nThis is no longer needed for x86 since bug 1381438. And it was never needed for arm32\nin the first place. (The arm32 lowering code was copied from x86, see bug 683300.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314571\n", "files": ["js/src/jit/LIROps.yaml", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/x86/CodeGenerator-x86.cpp", "js/src/jit/x86/Lowering-x86.cpp"], "git_node": "c2d6bfab28f9380a9cd0c85aeda287118bb4b7d6", "git_parents": ["c44e4542249b0942acc252230938fbcb3e05b4c0"], "node": "58bf1c8bde9a0ef65699b25f074ffc33d95ab5a0", "parents": ["34488f5320d70fcffec1ff1372e71c634e4642a0"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046819 - Add Raptor benchmark for Media Capabilities r=pehrsons,perftest-reviewers,sparky,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307872\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.rst", "testing/raptor/browsertime/support-scripts/media_capabilities.py", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/raptor.toml", "testing/raptor/raptor/tests/benchmarks/media-capabilities.toml", "third_party/webkit/PerformanceTests/media-capabilities/LICENSE", "third_party/webkit/PerformanceTests/media-capabilities/README.md", "third_party/webkit/PerformanceTests/media-capabilities/configs.js", "third_party/webkit/PerformanceTests/media-capabilities/driver.js", "third_party/webkit/PerformanceTests/media-capabilities/index.html", "third_party/webkit/PerformanceTests/media-capabilities/media-capabilities-worker.js", "third_party/webkit/PerformanceTests/media-capabilities/moz.yaml", "third_party/webkit/PerformanceTests/media-capabilities/runner.js"], "git_node": "e82b20ce3c450aae6377859c242a003636c9e1b1", "git_parents": ["c2d6bfab28f9380a9cd0c85aeda287118bb4b7d6"], "node": "0689313cccc01711ce661a0cfc1c388c662ae154", "parents": ["58bf1c8bde9a0ef65699b25f074ffc33d95ab5a0"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2058272 - Part 1: Use RootModule's LoadContext-\u003eIsPreload() in AddToResolvedModuleSet. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314559\n", "files": ["js/loader/ModuleLoaderBase.cpp", "js/loader/ModuleLoaderBase.h"], "git_node": "ca5bda72b745cd84519fc3e85c796b27aa59a135", "git_parents": ["e82b20ce3c450aae6377859c242a003636c9e1b1"], "node": "07307ce4c693459ddd022c945fe667635ee10bca", "parents": ["0689313cccc01711ce661a0cfc1c388c662ae154"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2058272 - Part 2: Test. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314560\n", "files": ["dom/base/test/jsmodules/importmaps/multiple/mochitest.toml", "dom/base/test/jsmodules/importmaps/multiple/test_bug_2058272.html"], "git_node": "fd1ab6eac91ac04a8fea96270263917dc77484c8", "git_parents": ["ca5bda72b745cd84519fc3e85c796b27aa59a135"], "node": "409b726a9704c2a396c49949135c595f10df37f0", "parents": ["07307ce4c693459ddd022c945fe667635ee10bca"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2056267 - Show a clean error instead of a raw traceback when Lando returns a non-JSON response r=sheehan\n\nWhen Lando returns a non-JSON body on an error (commonly a transient HTTP\n503 \"backend write error\"), `LandoAPI.post()` fell back to\n`response.raise_for_status()`, which raises a bare\n`requests.exceptions.HTTPError`. That is not a `LandoAPIException`, so the\ncaller's handler in `push_to_lando_try()` did not catch it and the traceback\nescaped to mach, looking like a bug in mach itself.\n\nConvert a non-JSON error response into a `LandoAPIException` with a readable\nmessage (including the status code and, for 5xx, a hint that it is likely\ntransient), so the existing handler renders a clean abort message.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313022\n", "files": ["tools/tryselect/lando.py", "tools/tryselect/test/test_lando_api.py"], "git_node": "07e895819af6161403043aed4e75ee04cc006b0f", "git_parents": ["fd1ab6eac91ac04a8fea96270263917dc77484c8"], "node": "08285d8dd77ce3d65919609552ca6269ccd16fdd", "parents": ["409b726a9704c2a396c49949135c595f10df37f0"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025732: Increase Cache API opaque response padding.r=dom-storage-reviewers,dom-worker-reviewers,jari,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313509\n", "files": ["dom/cache/FileUtils.cpp", "dom/fetch/InternalResponse.cpp"], "git_node": "2eb4d9c5af743de142b4f777ed8b71efb23f8ccb", "git_parents": ["07e895819af6161403043aed4e75ee04cc006b0f"], "node": "82a9294776e4f4d3870eeadefc8cdba8da18952c", "parents": ["08285d8dd77ce3d65919609552ca6269ccd16fdd"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "no bug - update to ruff 0.16.0 r=linter-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314270\n", "files": ["python/sites/lint.txt", "python/sites/python-test.txt"], "git_node": "1b05b9226a37c0d6c3e53e6d8fa5b1ca1e27bece", "git_parents": ["2eb4d9c5af743de142b4f777ed8b71efb23f8ccb"], "node": "9ee7ed5ff112b3f0f4c62057da57a22e272b791c", "parents": ["82a9294776e4f4d3870eeadefc8cdba8da18952c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058054 - Coverity CID 1697238: hoist AverageFrameLength() out of MP3TrackDemuxer::Duration r=media-playback-reviewers,alwu\n\nThe guard and the division each called AverageFrameLength() separately, so\nnothing tied the tested value to the divisor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314324\n", "files": ["dom/media/mp3/MP3Demuxer.cpp"], "git_node": "42c923cea166b0da68233d2e036ddd9091cd00c6", "git_parents": ["1b05b9226a37c0d6c3e53e6d8fa5b1ca1e27bece"], "node": "4eb180d5b9ca9fbc9400db36e725ba8697ef43c6", "parents": ["9ee7ed5ff112b3f0f4c62057da57a22e272b791c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058054 - Coverity CID 1697200: move the alias name into host in ResolveHTTPSRecord r=necko-reviewers,kershaw\n\naliasName is re-declared on every iteration and unused after the assignment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314328\n", "files": ["netwerk/dns/GetAddrInfo.cpp"], "git_node": "b8cbab185affa9391ecfc7b54fc742c7d9629953", "git_parents": ["42c923cea166b0da68233d2e036ddd9091cd00c6"], "node": "312a81057cb35ee575f2b8441bc56ce163aa20a4", "parents": ["4eb180d5b9ca9fbc9400db36e725ba8697ef43c6"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058144 - coverity: store the model file in tree r=emilio,mccr8 DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314424\n", "files": ["tools/coverity/model_file.cpp"], "git_node": "ec75fdae082b3fac14e61abff9a7331d52e15d79", "git_parents": ["b8cbab185affa9391ecfc7b54fc742c7d9629953"], "node": "dcc7f6ab1a72542a481379408a0687cf6a1bf2cf", "parents": ["312a81057cb35ee575f2b8441bc56ce163aa20a4"], "tags": []}, {"author": "Beatriz Rizental \u003cbea@torproject.org\u003e", "branch": "default", "desc": "Bug 2051440 - Replace omni.ja URI parsing in GetApkURI with a direct JNI call.r=ohall,necko-reviewers,geckoview-reviewers,jesup,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309470\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "netwerk/protocol/res/nsResProtocolHandler.cpp"], "git_node": "bc3f16b7fd3fc1271f4aba1dc8b2e662b57d3627", "git_parents": ["ec75fdae082b3fac14e61abff9a7331d52e15d79"], "node": "f5ebac930d5dc927a8c248aa968463c84cdd8c7f", "parents": ["dcc7f6ab1a72542a481379408a0687cf6a1bf2cf"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2056762 - Disable WebChannelParent.sys.mjs in GeckoView r=markh\n\nGeckoView embedders do not use the js WebChannel modules to communicate\nwith FxA.\n\nLeaving these around causes confusion because they start-up and leave\nlogs like \"no such channel\" which are red-herrings for developers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314524\n", "files": ["toolkit/actors/moz.build", "toolkit/modules/ActorManagerParent.sys.mjs"], "git_node": "2172b632523dd6ec220700bb77d0ebcf2305e8f3", "git_parents": ["bc3f16b7fd3fc1271f4aba1dc8b2e662b57d3627"], "node": "d6075b7a719a78fc1bbb7ada3e338f384ff17563", "parents": ["f5ebac930d5dc927a8c248aa968463c84cdd8c7f"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"no bug - update to ruff 0.16.0 r=linter-reviewers,ahal\" for causing lint failures.\n\nThis reverts commit 1b05b9226a37c0d6c3e53e6d8fa5b1ca1e27bece.\n", "files": ["python/sites/lint.txt", "python/sites/python-test.txt"], "git_node": "ee7b741c50b07404824b5e3d913f61d891c1ce99", "git_parents": ["2172b632523dd6ec220700bb77d0ebcf2305e8f3"], "node": "fd06d4ede00e695aa369c6edd8c41d303d172a9d", "parents": ["d6075b7a719a78fc1bbb7ada3e338f384ff17563"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046819 - Add Raptor benchmark for Media Capabilities r=pehrsons,perftest-reviewers,sparky,padenot\" for causing lint failures.\n\nThis reverts commit e82b20ce3c450aae6377859c242a003636c9e1b1.\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.rst", "testing/raptor/browsertime/support-scripts/media_capabilities.py", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/raptor.toml", "testing/raptor/raptor/tests/benchmarks/media-capabilities.toml", "third_party/webkit/PerformanceTests/media-capabilities/LICENSE", "third_party/webkit/PerformanceTests/media-capabilities/README.md", "third_party/webkit/PerformanceTests/media-capabilities/configs.js", "third_party/webkit/PerformanceTests/media-capabilities/driver.js", "third_party/webkit/PerformanceTests/media-capabilities/index.html", "third_party/webkit/PerformanceTests/media-capabilities/media-capabilities-worker.js", "third_party/webkit/PerformanceTests/media-capabilities/moz.yaml", "third_party/webkit/PerformanceTests/media-capabilities/runner.js"], "git_node": "ddfff8381d02cbd1d7e7f71ea208f9710481e0f9", "git_parents": ["ee7b741c50b07404824b5e3d913f61d891c1ce99"], "node": "baecff85a620db27417ae9d02b71a0b97bfcbc20", "parents": ["fd06d4ede00e695aa369c6edd8c41d303d172a9d"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2051440 - Replace omni.ja URI parsing in GetApkURI with a direct JNI call.r=ohall,necko-reviewers,geckoview-reviewers,jesup,nalexander\" for causing build bustages @nsResProtocolHandler.cpp.\n\nThis reverts commit bc3f16b7fd3fc1271f4aba1dc8b2e662b57d3627.\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "netwerk/protocol/res/nsResProtocolHandler.cpp"], "git_node": "851e84a4ad5e18f57e679ac6606bf5d31a8a28ac", "git_parents": ["ddfff8381d02cbd1d7e7f71ea208f9710481e0f9"], "node": "9811f833a43710bdca213c5a0c1fa9e2dc0cbfc1", "parents": ["baecff85a620db27417ae9d02b71a0b97bfcbc20"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056919 - Narrow setting-pane search fallback to header and non-group content r=mstriemer\n\nPreviously the fallback searched the entire pane again when no setting-group matched, which walked every group already searched in the first pass. The fallback now walks the pane's non-setting-group section children in parallel, which currently covers the page header, the Firefox Labs description and reset button, and the Firefox Labs feature cards. Iterating the feature cards from their parent keeps each card's visibility in sync with the current search query.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313489\n", "files": ["browser/components/preferences/findInPage.js", "browser/components/preferences/tests/searchResults/browser-srd.toml", "browser/components/preferences/tests/searchResults/browser_search_results_fallback.js"], "git_node": "849ac49bb02063b0b9d7f1b8113d7489130049a8", "git_parents": ["851e84a4ad5e18f57e679ac6606bf5d31a8a28ac"], "node": "c2f821fc2e8fb158fc8b8a7ed619f4d0d0021684", "parents": ["9811f833a43710bdca213c5a0c1fa9e2dc0cbfc1"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053826 - migrating fetchTrackedURLs to array binding. r=mak,places-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313718\n", "files": ["toolkit/components/places/BookmarkList.sys.mjs"], "git_node": "a19eb773c2c8ea50151faea35b301e27c9cfd303", "git_parents": ["849ac49bb02063b0b9d7f1b8113d7489130049a8"], "node": "b94cf8c6f4f52f506326b4514f3b261a6741858f", "parents": ["c2f821fc2e8fb158fc8b8a7ed619f4d0d0021684"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057768 - Use power-of-two size + ScrambleHashCode() rather than prime size in recently used atoms cache. r=hsivonen,dom-core-reviewers\n\nThis reuses the existing mechanism we have for this, and causes fewer\ncollisions / is better distributed.\n\nOn the jQuery benchmark from bug 2051347, this gets the same perfect\ndistribution both before and after the hash change.\n\nI filed bug 2057753 to investigate if MruCache (used from AtomCache /\nNS_AtomizeMainThread and co) should be using a similar pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314221\n", "files": ["parser/html/nsHtml5AtomTable.cpp", "parser/html/nsHtml5AtomTable.h"], "git_node": "211fe2c78d7dac2d5385f91c2658af965a5acb11", "git_parents": ["a19eb773c2c8ea50151faea35b301e27c9cfd303"], "node": "21f57060c84d82f84dfcbf5e1ad30cdbb17af18e", "parents": ["b94cf8c6f4f52f506326b4514f3b261a6741858f"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2049980 - Align username dropdown chevron icon with password reveal icon. r=mtigley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313595\n", "files": ["browser/components/passwordmgr/content/login-doorhanger-username-field.css"], "git_node": "0fed8858590f0b3481151a72321c391a7b271ef3", "git_parents": ["211fe2c78d7dac2d5385f91c2658af965a5acb11"], "node": "518cebfee45a73cb3da5382f866b8dff20d773dc", "parents": ["21f57060c84d82f84dfcbf5e1ad30cdbb17af18e"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056842 - Match the Range request header case-insensitively when rejecting an opaque ranged response. r=hsingh\n\nBug 1465074 implemented main fetch step 21, turning an opaque 206/416 response\nfrom a ServiceWorker into a network error when the intercepted request does not\ncontain a Range header. The header name was compared with nsCString::Equals,\nbut InternalHeaders preserves the casing the caller used, and every other\nlookup in that file compares with EqualsIgnoreCase. A request made with a\nlowercase \"range\" header was therefore misclassified as not being a ranged\nrequest, and the response the ServiceWorker gave it was failed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314677\n", "files": ["dom/serviceworkers/FetchEventOpChild.cpp"], "git_node": "4e829d84e9fb7d02483c8189841bee898862e0b6", "git_parents": ["0fed8858590f0b3481151a72321c391a7b271ef3"], "node": "f1ecb5bd2578fe5c4b8e8381b3731e55ffc66d10", "parents": ["518cebfee45a73cb3da5382f866b8dff20d773dc"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2055890 - Add Happy Eyeballs DNS answer-spread telemetry r=kershaw,necko-reviewers\n\nRecord the time between the first and last positive DNS answer (A, AAAA\nor HTTPS) of a run in netwerk.happy_eyeballs_dns_answer_spread, to tune\nnetwork.http.happy_eyeballs_resolution_delay against real data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312767\n", "files": ["netwerk/protocol/http/happy_eyeballs_glue/src/lib.rs", "netwerk/protocol/http/happy_eyeballs_glue/src/metrics.rs", "netwerk/protocol/http/metrics.yaml"], "git_node": "cb4edc91ca1d650944f039c789c8c59f065bf91c", "git_parents": ["4e829d84e9fb7d02483c8189841bee898862e0b6"], "node": "242cd93f0e681b54b73cb70a73f4f53cf1c32907", "parents": ["f1ecb5bd2578fe5c4b8e8381b3731e55ffc66d10"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046073 - Disable onboarding for all CUJs except onboarding r=android-reviewers,tthibaud\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313059\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/TabsTrayBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/utils/Constants.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/utils/MacrobenchmarkScope.kt"], "git_node": "4cb29dd94e2bfce6874c153fd43cfbc822749a8e", "git_parents": ["cb4edc91ca1d650944f039c789c8c59f065bf91c"], "node": "1fb0c62d34ef232efd2edb56706342d09df81b13", "parents": ["242cd93f0e681b54b73cb70a73f4f53cf1c32907"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054543 - part 1: factor out common code on desktop which will also be used by Android; r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312642\n", "files": ["browser/components/reportbrokensite/ReportBrokenSite.sys.mjs", "browser/components/reportbrokensite/test/browser/browser_report_preview.js", "browser/components/reportbrokensite/test/browser/send_more_info.js", "toolkit/components/reportbrokensite/ReportBrokenSiteChild.sys.mjs", "toolkit/components/reportbrokensite/ReportBrokenSiteHelpers.mjs", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs", "toolkit/components/reportbrokensite/moz.build"], "git_node": "46780cf3cab4076d3a9a7b1164c98a0fee32bc0f", "git_parents": ["4cb29dd94e2bfce6874c153fd43cfbc822749a8e"], "node": "a426ce6bb6eaa73dc00b07ca173abdad3a55fed1", "parents": ["1fb0c62d34ef232efd2edb56706342d09df81b13"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054543 - part 2: have Fenix use the factored-out toolkit code to send broken site reports with Glean; r=tthibaud,ohall,geckoview-reviewers,android-reviewers,frontend-codestyle-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312643\n", "files": ["eslint-file-globals.config.mjs", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-system/src/main/java/mozilla/components/browser/engine/system/SystemEngineSession.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/engine/EngineObserverTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/EngineSession.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/EngineSessionTest.kt", "mobile/android/android-components/components/feature/webcompat-reporter/build.gradle", "mobile/android/android-components/components/support/test-fakes/src/main/java/mozilla/components/support/test/fakes/engine/TestEngineSession.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/GleanBrokenSiteReportSender.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/di/WebCompatReporterMiddlewareProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatInfoDeserializer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatInfoDto.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterRetrievalService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterSubmissionMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/fake/FakeEngineSession.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/middleware/DefaultWebCompatReporterRetrievalServiceTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterSubmissionMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/testdata/WebCompatTestData.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/modules/geckoview/GeckoViewContent.sys.mjs", "mobile/shared/modules/geckoview/test/mochitest/mochitest.toml", "mobile/shared/modules/geckoview/test/mochitest/test_geckoview_brokensitereporter.html"], "git_node": "0a0ffa6f1baaa74446852ee8adbc4182bfd4bbe0", "git_parents": ["46780cf3cab4076d3a9a7b1164c98a0fee32bc0f"], "node": "4b2f2ee50925c8d491b1f327c2b0bd80ec87358b", "parents": ["a426ce6bb6eaa73dc00b07ca173abdad3a55fed1"], "tags": []}, {"author": "Akhil Pindiprolu \u003capindiprolu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047028 - [Ungrouping] Create the new confirmation dialog UI r=android-reviewers,android-l10n-reviewers,calu,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314053\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupsTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/UngroupTabGroupConfirmationDialog.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ui/tabgroups/UngroupTabGroupConfirmationDialogTest.kt"], "git_node": "7ea117c07aa3f2559be8f9912a8c49c9c63ef8fe", "git_parents": ["0a0ffa6f1baaa74446852ee8adbc4182bfd4bbe0"], "node": "b6ee637e7271caeff21f2e9e1a3f096ea05e9b75", "parents": ["4b2f2ee50925c8d491b1f327c2b0bd80ec87358b"], "tags": []}, {"author": "Matt Cleinman \u003c9295855+mcleinman@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2051977 - Show the VPN unavailable screen when getting a 451 from Guardian. r=sstreich,ip-protection-reviewers,kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312390\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/content/ipprotection-constants.mjs", "browser/components/ipprotection/content/ipprotection-content.mjs", "browser/components/ipprotection/content/ipprotection-status-box.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_box.js", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/docs/Constants.md"], "git_node": "a69f33c78ec429a2e38388ac7533af8a5094c578", "git_parents": ["7ea117c07aa3f2559be8f9912a8c49c9c63ef8fe"], "node": "aec31bc5829ad81c482625c34d04d470a12f0bc1", "parents": ["b6ee637e7271caeff21f2e9e1a3f096ea05e9b75"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2051059 - Wait until the popup blocked notification is fully shown in browser_framebusting_notification.js, r=mossop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314316\n", "files": ["browser/base/content/test/framebusting/browser_framebusting_notification.js"], "git_node": "78672f318d206df902c8f48d1aae840443138e62", "git_parents": ["a69f33c78ec429a2e38388ac7533af8a5094c578"], "node": "a4d70949a4a07ebb510bb503938af364b53a5f5c", "parents": ["aec31bc5829ad81c482625c34d04d470a12f0bc1"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058252 - Route GitLab vendor API requests through the retrying session. r=tjr\n\nBaseHost configures self.session with an HTTPAdapter whose Retry backs off\non 429/500/502/503/504, but GitLabHost.upstream_commit used the bare\nrequests.get, bypassing that adapter. A single transient 504 from\ngitlab.freedesktop.org therefore aborted the entire `mach vendor` run, which\nshowed up as intermittent CI failures while passing locally.\n\nUse self.session.get so the API metadata request benefits from the same\nretry/backoff policy already used by download_single_file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314472\n", "files": ["python/mozbuild/mozbuild/vendor/host_gitlab.py"], "git_node": "138d980408a6fb2be517cabf737305978df9f378", "git_parents": ["78672f318d206df902c8f48d1aae840443138e62"], "node": "1ffc18f84ea4ac680c20fcb61efac69995c2cc0a", "parents": ["a4d70949a4a07ebb510bb503938af364b53a5f5c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058575 - Center the Ctrl-Tab preview labels with text-align. r=emilio,desktop-theme-reviewers\n\nThe labels were centered by justify-content, which had an effect only while\nlabel:where([value]) computed to inline-flex. Bug 2049182 removed that rule, so\nthe label is a block container, the declaration is inert, and each title sits\nflush with the left edge of its thumbnail. text-align centers the inline text\nwhatever the label's display resolves to.\n\nTo verify: open the Ctrl-Tab panel (browser.ctrlTab.sortByRecentlyUsed) on tabs\nwith short titles and check each title against its thumbnail's center. Long\ntitles were unaffected either way, since they fill the label's width.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314707\n", "files": ["browser/themes/shared/tabbrowser/ctrlTab.css"], "git_node": "2573517bee30584acbbd4bac939550da1397af8e", "git_parents": ["138d980408a6fb2be517cabf737305978df9f378"], "node": "0b9ceda3fb5b281ac00eff76b884da198cc0ccd9", "parents": ["1ffc18f84ea4ac680c20fcb61efac69995c2cc0a"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047571 - Make CrashReports.getReports resilient to deleted files r=gsvelto\n\nA crash report file can be removed concurrently (e.g. by crash report\nsubmission) between the directory enumeration and the read of its\nlast-modified time. nsIFile.lastModifiedTime would then throw\nNS_ERROR_FILE_NOT_FOUND and abort the whole scan.\n\nInstead, catch the error and simply ignore that specific report.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309058\n", "files": ["toolkit/crashreporter/CrashReports.sys.mjs", "toolkit/crashreporter/test/unit/test_crashreports.js"], "git_node": "083e0f362d5084370e8c9647ad7b32560d93efda", "git_parents": ["2573517bee30584acbbd4bac939550da1397af8e"], "node": "48524b1b83a24584c6dbe09bcc0649e8c29a1612", "parents": ["0b9ceda3fb5b281ac00eff76b884da198cc0ccd9"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - add checkRemoteCandidatePorts to test_peerConnection_portRestrictions.html r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313822\n", "files": ["dom/media/webrtc/tests/mochitests/test_peerConnection_portRestrictions.html"], "git_node": "8e2a6327b34e6d0fe08a778c43e5b6024450b1fa", "git_parents": ["083e0f362d5084370e8c9647ad7b32560d93efda"], "node": "1773607fa63fd26b7de8e5ff110a44a25576f28d", "parents": ["48524b1b83a24584c6dbe09bcc0649e8c29a1612"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Fix stale comment in UDPSocketParent::RecvOutgoingData. r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313823\n", "files": ["dom/network/UDPSocketParent.cpp"], "git_node": "472187777b573845b316515564357abe86c64227", "git_parents": ["8e2a6327b34e6d0fe08a778c43e5b6024450b1fa"], "node": "75eda60f94e8a5c98cf521befac13e7961ddd5d3", "parents": ["1773607fa63fd26b7de8e5ff110a44a25576f28d"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Expose the webrtc port allowlist as a shared IsWebrtcPortAllowed helper. r=bwc\n\nTurn the gGoodWebrtcPortList allowlist into IceServerParser::kGoodWebrtcPortList\nand make the file-local IsPortAllowed check to a public mozilla::IsWebrtcPortAllowed\nhelper, so the outgoing port restriction can be reused outside of ICE server URL\nparsing. No behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313824\n", "files": ["dom/media/webrtc/common/IceServerParser.cpp", "dom/media/webrtc/common/IceServerParser.h"], "git_node": "3168fe4335891d220e7a197f5265604023663499", "git_parents": ["472187777b573845b316515564357abe86c64227"], "node": "15d31fa809e148c25a055326fb504a6d936c7aef", "parents": ["75eda60f94e8a5c98cf521befac13e7961ddd5d3"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Apply outgoing port restrictions to remote ICE candidate destinations in NrSocket. r=bwc\n\nNrSocket (used for direct UDP/TCP sockets in the socket process and parent\nprocess) now rejects sends/connects to ports that are not allowed for webrtc,\nvia NrSocketBase::IsForbiddenAddress.  This blocks remote ICE candidates that\npoint at restricted destination ports in parent or socket process, the same\nway Bug 1677046 closed for them for ICE server URLs.  IsForbiddenAddress also\ngains the webrtc port allowlist so 53/3478/5349 stay usable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313825\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp", "dom/media/webrtc/transport/nr_socket_prsock.h", "dom/media/webrtc/transport/test/test_nr_socket_unittest.cpp"], "git_node": "1684bd5486af1d200c2d455281fde75d2906b068", "git_parents": ["3168fe4335891d220e7a197f5265604023663499"], "node": "529f171b8ac5f03e1e80b0eed3629769fb05d533", "parents": ["15d31fa809e148c25a055326fb504a6d936c7aef"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Enforce the webrtc outgoing port restriction in the parent process for content-process UDP. r=bwc\n\nWhen mtransport runs in the content process, UDP is sent via NrUdpSocketIpc to\nUDPSocketParent in the parent process. Drop outgoing packets destined for a\nrestricted port there, so the restriction is enforced in a process the content\nprocess cannot bypass. A disallowed port is dropped silently (IPC_OK) rather\nthan treated as a protocol violation, since it can come from a remote candidate\nsupplied through the normal API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313826\n", "files": ["dom/media/webrtc/transport/nr_socket_prsock.cpp", "dom/media/webrtc/transport/stun_socket_filter.cpp"], "git_node": "c8529ad48e0aecba18a96936b256850f7965ad50", "git_parents": ["1684bd5486af1d200c2d455281fde75d2906b068"], "node": "681ae4ca83a39831364f7d779ebd73d9ec82178c", "parents": ["529f171b8ac5f03e1e80b0eed3629769fb05d533"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2045368 - Enforce the webrtc outgoing port restriction in the parent process for ICE-TCP. r=bwc\n\nICE-TCP connections are opened via WebrtcTCPSocketParent::RecvAsyncOpen (in the\nsocket or parent process). Reject opens to a restricted destination port there,\nsignalling a normal connection failure to the child via OnClose rather than\ntearing down the process with IPC_FAIL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313827\n", "files": ["dom/media/webrtc/transport/ipc/WebrtcTCPSocketParent.cpp"], "git_node": "1473f2aba29b4a756b949f9449c925f3c2b0caaa", "git_parents": ["c8529ad48e0aecba18a96936b256850f7965ad50"], "node": "ace30783590967e9fd6bb107b099814906936cff", "parents": ["681ae4ca83a39831364f7d779ebd73d9ec82178c"], "tags": []}, {"author": "Jesse Schwartzentruber \u003ctruber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053518 - Handle the *-oe-linux-* rust targets added in rustc 1.98 in rust target detection. r=firefox-build-system-reviewers,glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311145\n", "files": ["build/moz.configure/rust.configure", "python/mozbuild/mozbuild/test/configure/test_toolchain_configure.py"], "git_node": "1ecaa12836a69896dd6702fb5ed5e13979399371", "git_parents": ["1473f2aba29b4a756b949f9449c925f3c2b0caaa"], "node": "8df170d41a0b90951379496aeb7119d8f1ca2431", "parents": ["ace30783590967e9fd6bb107b099814906936cff"], "tags": []}, {"author": "Jim Blandy \u003cjimb@red-bean.com\u003e", "branch": "default", "desc": "Bug 2057774: Update `gfx/cairo` vendoring patch list and metadata. r=gfx-reviewers,bradwerth\n\nUpdate the contents of `gfx/cairo/moz.yaml` and adjust the headers of the\npatches in `gfx/cairo/patches` so that `mach vendor` gives\n`gfx/cairo/src` a clean bill of health again: applying the updated\npatch stack to the base Cairo release accurately reproduces the state\nof `gfx/cairo/src`.\n\nThe changes to the patches only affect the headers giving the paths of\nthe affected files, not the textual changes they represent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314231\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0032-Bug-2033610-Check-cairo-image-surface-for-error.patch", "gfx/cairo/patches/0033-Bug-2036587-No-component-alpha-for-dwrite-glyph-surfaces.patch", "gfx/cairo/patches/0033-Bug-2037290-cff-subset-offset-checks.patch", "gfx/cairo/patches/0034-Bug-2037290-cff-subset-offset-checks.patch", "gfx/cairo/patches/0034-cff-dict-validation.patch", "gfx/cairo/patches/0035-cff-dict-validation.patch", "gfx/cairo/patches/0035-cff-fdselect-bounds.patch", "gfx/cairo/patches/0037-fdselect-checks.patch", "gfx/cairo/patches/0037-pcf-row_bytes.patch", "gfx/cairo/patches/0037-type1-decode-integer.patch", "gfx/cairo/patches/0038-gid-range-check.patch", "gfx/cairo/patches/0038-pcf-row_bytes.patch", "gfx/cairo/patches/0039-cff-fdselect-bounds.patch", "gfx/cairo/patches/0039-type1-stack-check.patch", "gfx/cairo/patches/0040-Bug-2048799-flip-polarity-of-a-bounds-check.patch", "gfx/cairo/patches/0040-type1-decode-integer.patch", "gfx/cairo/patches/0041-Bug-2048799-flip-polarity-of-a-bounds-check.patch", "gfx/cairo/patches/0041-fdselect-checks.patch", "gfx/cairo/patches/0042-gid-range-check.patch", "gfx/cairo/patches/0042-win32-printing-linear-pattern.patch", "gfx/cairo/patches/0043-Bug-2045711-records-size-check.patch", "gfx/cairo/patches/0043-type1-stack-check.patch", "gfx/cairo/patches/0044-Bug-2053599-glyph-index-bounds.patch", "gfx/cairo/patches/0044-win32-printing-linear-pattern.patch", "gfx/cairo/patches/0045-Bug-2045711-records-size-check.patch", "gfx/cairo/patches/0046-Bug-2053599-glyph-index-bounds.patch"], "git_node": "01f0005a11f93c4803f84ecab1793dde6af689ea", "git_parents": ["1ecaa12836a69896dd6702fb5ed5e13979399371"], "node": "b26cec0d2527c9a01e9a1d37744ab9c8e1258312", "parents": ["8df170d41a0b90951379496aeb7119d8f1ca2431"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2048977 - Add review-context.toml linter for AI code review context rules. r=ai4dev-reviewers,suhaib\n\nAdds a mozlint linter that validates review-context.toml, the file the\nbugbug code review agent reads to inject domain knowledge into the review\nprompt. The schema/grammar is vendored verbatim from bugbug so the tree\nvalidates against the same schema the agent uses at runtime; this will be\nreplaced by a pinned stdlib-only package once bugbug publishes one.\n\nExcludes the file from test-manifest-toml, which would otherwise try to\nparse it as a ManifestParser test manifest and fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307834\n", "files": ["pyproject.toml", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/python/review_context_schema.py", "tools/lint/python/review_context_toml.py", "tools/lint/review-context-toml.yml", "tools/lint/test-manifest-toml.yml"], "git_node": "ae4c2aa13c4739db6d359d05c4195fb83655302c", "git_parents": ["01f0005a11f93c4803f84ecab1793dde6af689ea"], "node": "2628eb74c0026c1f93f8301e06fa062c053be6c8", "parents": ["b26cec0d2527c9a01e9a1d37744ab9c8e1258312"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2048977 - Add initial review-context.toml rules. r=Gijs,smaug\n\nLoads the desktop front-end and WebIDL implementation skills as review\ncontext for patches touching the matching files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307835\n", "files": ["review-context.toml"], "git_node": "31df9a4c49b7cc38d34500017a1ee346cfe5ec14", "git_parents": ["ae4c2aa13c4739db6d359d05c4195fb83655302c"], "node": "23876b8ee8d0aa0c80c7edc500924dbc93cb2609", "parents": ["2628eb74c0026c1f93f8301e06fa062c053be6c8"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2048977 - Document review-context.toml authoring. r=ai4dev-reviewers,suhaib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307836\n", "files": ["docs/ai-agent-tools/code-review-context.md", "docs/ai-agent-tools/index.md"], "git_node": "24038ed1a120d0bc49b6fa48a6789bded94d7f65", "git_parents": ["31df9a4c49b7cc38d34500017a1ee346cfe5ec14"], "node": "ac84ad6688e9248a1a6551e2fa5801fd375f2e05", "parents": ["23876b8ee8d0aa0c80c7edc500924dbc93cb2609"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058061 - dom/quota/ActorsParent.cpp: fix static code analysis report. r=jari\n\nThis was introduced in D313000 / Bug 2056218.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314317\n", "files": ["dom/quota/ActorsParent.cpp"], "git_node": "d3f018f8c7b51f5f2631edb90d91f0ac082ac382", "git_parents": ["24038ed1a120d0bc49b6fa48a6789bded94d7f65"], "node": "92e93f5ff1ca046d9ec997898597da81304884b0", "parents": ["ac84ad6688e9248a1a6551e2fa5801fd375f2e05"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040992 - Make captured `PATH` and `INCLUDE` deterministic r=nalexander,firefox-build-system-reviewers,ohall,sergesanspaille,geckoview-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301634\n", "files": ["Makefile.in", "build/moz.configure/toolchain.configure", "build/moz.configure/util.configure", "build/moz.configure/windows.configure", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/MachTasksPlugin.kt"], "git_node": "57338fa2e1fc69fece7ea9a18fe3a6302be3c554", "git_parents": ["d3f018f8c7b51f5f2631edb90d91f0ac082ac382"], "node": "418ed3f753190059b5ef395805ec015af9bde2f6", "parents": ["92e93f5ff1ca046d9ec997898597da81304884b0"], "tags": []}, {"author": "Jim Blandy \u003cjimb@red-bean.com\u003e", "branch": "default", "desc": "Bug 2058360: Use Voluptuous validators' built-in transformation r=tjr\n\nLet the Voluptuous schema validators transform the `moz.yaml` contents\nthemselves, rather than making a separate `schema_transform` pass that\nmight interpret values differently from the validators.\n\nSpecifically, ensure that `Boolean` processing is consistent. In the\nold code, the string `\"enable\"` is accepted by `voluptuous.Boolean`\nand treated as `True`, but `moz_yaml.py`'s `_schema_1_transform`\ntreats it as `False`. Simply letting the schema do the transformation\nitself avoids this kind of inconsistency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314563\n", "files": ["python/mozbuild/mozbuild/test/test_manifest.py", "python/mozbuild/mozbuild/vendor/moz_yaml.py"], "git_node": "46708c37ae1743d55e161ffe1e4fb4dd7c688138", "git_parents": ["57338fa2e1fc69fece7ea9a18fe3a6302be3c554"], "node": "7eaefeb0055977d936306fad2defd66a18d66b33", "parents": ["418ed3f753190059b5ef395805ec015af9bde2f6"], "tags": []}, {"author": "Jim Blandy \u003cjimb@red-bean.com\u003e", "branch": "default", "desc": "Bug 2057787 - Let `moz.yaml` opt out of git object validation. r=tjr\n\nAdd a `tolerate-git-fsck-errors` vendoring option to `mach vendor`'s\n`moz.yaml` schema that disables git's fsck validation for\nclones/fetches of the given repository. This defaults to `false`, so\nthat git applies the usual fsck checks; only manifests that explicitly\nopt in after confirming the offending object is benign are affected.\n\nSet this option in `gfx/cairo/moz.yaml`. Cairo's upstream history\ncontains an old commit whose author/committer line git's fsck\nvalidation rejects, so `mach vendor` fails outright when cloning it,\neven though the object has nothing to do with any revision we actually\nvendor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314565\n", "files": ["gfx/cairo/moz.yaml", "python/mozbuild/mozbuild/vendor/docs/template.yaml", "python/mozbuild/mozbuild/vendor/host_base.py", "python/mozbuild/mozbuild/vendor/moz_yaml.py"], "git_node": "97b626d0cd183adf9e318ca41abf7bab0778c780", "git_parents": ["46708c37ae1743d55e161ffe1e4fb4dd7c688138"], "node": "2f85073a2f4fd007f3deeadb97de09a510d7a263", "parents": ["7eaefeb0055977d936306fad2defd66a18d66b33"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2057787, 2058360: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["python/mozbuild/mozbuild/test/test_manifest.py"], "git_node": "8442510d9bbab61253856233b1786b4ffc4456d8", "git_parents": ["97b626d0cd183adf9e318ca41abf7bab0778c780"], "node": "8e8767dbccb0bcfc3b35280103e4a3a287de94ed", "parents": ["2f85073a2f4fd007f3deeadb97de09a510d7a263"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 1700046 - IDB: revert back error code to indicate a corruption when objectStoreId isn't found. r=dom-storage-reviewers,asuth\n\nThis was introduced by accident in https://phabricator.services.mozilla.com/D89919#inline-1688036 (bug 1663924).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314392\n", "files": ["dom/indexedDB/ActorsParent.cpp"], "git_node": "f5c7d8b68e2e65d1604e4e2bdcac066d720eb3ef", "git_parents": ["8442510d9bbab61253856233b1786b4ffc4456d8"], "node": "abff329cca12ff6c9d3fd2bd6de56cff15856363", "parents": ["8e8767dbccb0bcfc3b35280103e4a3a287de94ed"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058177 - coverity: drop the always false lower bound check of the usrsctp sysctl setters r=webrtc-reviewers,bwc DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314616\n", "files": ["tools/coverity/model_file.cpp"], "git_node": "88882ad2df902bbafe763c20d00ee314991c9764", "git_parents": ["f5c7d8b68e2e65d1604e4e2bdcac066d720eb3ef"], "node": "79ba5b1b62cd47e72e810a023009a36dc2031833", "parents": ["abff329cca12ff6c9d3fd2bd6de56cff15856363"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1924328 - WebGPU: Enable `dual-source-blending` feature, when available r=webgpu-reviewers,webidl,saschanaz,ErichDonGubler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313886\n", "files": ["dom/webgpu/Adapter.cpp", "dom/webidl/WebGPU.webidl", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/render_pipeline/fragment_state/cts.https.html.ini"], "git_node": "41b180029e18ffa6f27eef7f69cd11ab7745621c", "git_parents": ["88882ad2df902bbafe763c20d00ee314991c9764"], "node": "b19603ce822237ba628d6d6043b5e26d11e5799e", "parents": ["79ba5b1b62cd47e72e810a023009a36dc2031833"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057647 - Part 1: Remove the paths restriction from the media-patch-review skill. r=ai4dev-reviewers,padenot\n\n`paths` gates activation on Claude having already read a matching file. A\nsession started at the repository root, the normal case for running\n/media-patch-review against a diff or a D-number, has read no dom/media file\nyet, so the skill is missing from the skill listing entirely.\n\nThe field is redundant anyway: the description and body already state that the\nskill reviews dom/media changes only.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314461\n", "files": [".agents/skills/media-patch-review/SKILL.md", ".claude/skills/media-patch-review/SKILL.md"], "git_node": "096fe4fb2a06d7a0d248c3551a6f7330e2a8fd54", "git_parents": ["41b180029e18ffa6f27eef7f69cd11ab7745621c"], "node": "7079032bc9a83b56a09266f205ec94baebe3e89b", "parents": ["b19603ce822237ba628d6d6043b5e26d11e5799e"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057647 - Part 2: Add security-review guidance to the dom/media review docs. r=media-playback-reviewers,padenot\n\nFold the patterns that recurred across recent dom/media reviews into the\nmatching checklists, each phrased as a portable \"code shape -\u003e invariant to\nverify\" bullet so the files stay usable both by a human reviewer and by\nbugbug's code-review context. Every bullet states one distinct shape;\noverlapping ones are merged rather than repeated.\n\nmemory-safety.md is the bulk of it, and its general section is now grouped into\nfive subsections (bounds/sizes/arithmetic, lifetime/ownership/refcounting,\ncycle collection and registrations, uninitialized/stale/disclosed memory, and\nwhere a check belongs) so it stays scannable at its new length. The added\nshapes cover cross-source size agreement, unit consistency in bounds checks,\nbuffer initialization on every return path, destroy order and opaque-handle\nvalidity, untrusted external sizes, checked arithmetic, narrowing casts,\ndebug-only enforcement, releasing a self-reference, use-after-move, Unlink vs.\ndestructor completeness, array-extent validation, post-construction writes,\nleak fixes unmasking use-after-free, proxy success signals, recycled buffers,\nvalidating at the shared sink, uninitialized data reaching a script-readable\nsink, id reuse, and a global cap left unset in a process that skipped its\ninitializer.\n\nipc.md gains bullets on peer-supplied identity, abnormal vs. graceful teardown,\ncross-channel callback lifetime, guarding the pointer rather than a flag, and\nhardening at the creation choke point; the existing message-ordering bullet\npicks up the at-most-once rejection obligation.\n\nthreading.md gains a bullet on MozPromiseHolder being single-thread-only with\nno assertion to catch the misuse, and MozMonitoredPromiseHolder as the\ncross-thread form.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314462\n", "files": ["dom/media/docs/review/ipc.md", "dom/media/docs/review/memory-safety.md", "dom/media/docs/review/threading.md"], "git_node": "b94209f7f0e018d012b5ea42f4a24e3e807d6389", "git_parents": ["096fe4fb2a06d7a0d248c3551a6f7330e2a8fd54"], "node": "d5822a8086221aa770e016290fdafde99c61401c", "parents": ["7079032bc9a83b56a09266f205ec94baebe3e89b"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2048977 - Document review-context.toml authoring. r=ai4dev-reviewers,suhaib\" for causing bugzilla related failures\n\nThis reverts commit 24038ed1a120d0bc49b6fa48a6789bded94d7f65.\n\nRevert \"Bug 2048977 - Add initial review-context.toml rules. r=Gijs,smaug\"\n\nThis reverts commit 31df9a4c49b7cc38d34500017a1ee346cfe5ec14.\n\nRevert \"Bug 2048977 - Add review-context.toml linter for AI code review context rules. r=ai4dev-reviewers,suhaib\"\n\nThis reverts commit ae4c2aa13c4739db6d359d05c4195fb83655302c.\n", "files": ["docs/ai-agent-tools/code-review-context.md", "docs/ai-agent-tools/index.md", "pyproject.toml", "review-context.toml", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/python/review_context_schema.py", "tools/lint/python/review_context_toml.py", "tools/lint/review-context-toml.yml", "tools/lint/test-manifest-toml.yml"], "git_node": "cfaaef87c50adf24dbd0ad89ffb785c12d792926", "git_parents": ["b94209f7f0e018d012b5ea42f4a24e3e807d6389"], "node": "58573a0cf840d6d6727bbe5c77313d9369904137", "parents": ["d5822a8086221aa770e016290fdafde99c61401c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 6986d12703302f1126290502aa4e70c874dcab95\naf -\u0