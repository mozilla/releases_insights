-with-abspos-005.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-006.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-009.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-010.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-011.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-012.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-015.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-018.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-abspos-022.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-001.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-002.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-005.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-006.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-009.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-010.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-011.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-012.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-fixed-pos-017.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-001.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-002.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-003.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-floats-004.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-bfc-ref.html", "testing/web-platform/tests/css/css-overflow/line-clamp/line-clamp-bfc.html"], "git_node": "0e084adab8461876c1598731aa4ecb2793ee4ffc", "git_parents": ["9129a47a6bda518d7e3368b4bda8d5bc431c3c5c"], "node": "fa790382d48a26db863f654c0f9130ba8c41f647", "parents": ["a1082b2064b56d617732eec8e63e02b3f461c9db"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2052809 - part 1: add classes InstructionBytes and SummarizeResult.  r=bvisness.\n\nThe goal of this bug is to enhance wasm::SummarizeTrapInstruction so it also\nreturns the length of recognized instructions.\n\nAs a preliminary step, this patch adds two new classes, but does not use them\nfor anything:\n\n* class SummarizeResult: this holds the new return value from\n  SummarizeTrapInstruction.  It is either a pair of (instruction kind,\n  instruction length), or nothing.\n\n* class InstructionBytes: currently SummarizeTrapInstruction reads instruction\n  bytes to analyze out of raw memory.  Future patches will need it to also read\n  bytes from an assembler buffer.  InstructionBytes is a virtual base class\n  that generalizes the source, so that SummarizeTrapInstruction can pull bytes\n  from any source that provides a suitable instantiation of it.\n\nAdditionally, the patch pulls SummarizeTrapInstruction out of #ifdef DEBUG; it\nis now available in release builds too.  The next patch in this series will\nrequire it in all build configurations.  That is to say,\nSummarizeTrapInstruction is no longer a best-effort debug-only helper; it will\nbecome a necessary part of the traps/stackmaps management machinery.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311458\n", "files": ["js/src/wasm/WasmCodegenTypes.h", "js/src/wasm/WasmSummarizeInsn.cpp", "js/src/wasm/WasmSummarizeInsn.h"], "git_node": "3fba8b9162934362fa2963f52ff3f9fa76b0a069", "git_parents": ["0e084adab8461876c1598731aa4ecb2793ee4ffc"], "node": "a2f40901e909661ce3306779a90c04cfac97bf95", "parents": ["fa790382d48a26db863f654c0f9130ba8c41f647"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2052809 - part 2: rework SummarizeTrapInstruction to use new source/result classes.  r=bvisness.\n\nThis patch consists of two logical sections:\n\n(1) Rework SummarizeTrapInstruction to use classes InstructionBytes and\n    SummarizeResult, in particular, computing the length of identified\n    instructions.\n\n(2) Redo uses of SummarizeTrapInstruction to make use of the length info.\n\nPart (1) is 95% of the patch and (2) is only 5% of it, but (2) is important to\nnote.\n\nPart (2) changes the use point in jit::JitActivation::startWasmTrap, so that\nthe length of a resumable trap instruction is no longer assumed to be\njit::WasmTrapInstructionLength.  Instead it is computed using\nSummarizeTrapInstruction.  This is a key change that will in future let us use\nstack maps together with variable length trap instructions, which is necessary\nfor correct handling of traps created when compiling wasm for debugging.\n\nThe only other use-point change is TrapSitesForKind::checkInvariants, but that\nmerely accomodates the change in return type of SummarizeTrapInstruction; it\ndoes not provide any new functionality.  Note that\nTrapSitesForKind::checkInvariants checks that all trapping instructions can be\nidentified correctly by SummarizeTrapInstruction, which is a useful\ncross-check.  However it cannot (yet) check that the computed length is\ncorrect.\n\nPart (1) is large, but the complexity is confined to the x86/x64 cases.  For\nall other architectures, the change is merely to use InstructionBytes as a\nsource and return 4 as the discovered length.\n\nFor x86/x64, there is a new routine AddressModeLength to compute the length of\nan x86/x64 memory address expression (not simple), and uses of it throughout\nthe code.  As with the other targets, InstructionBytes is used as a source.\nFinally, there are new cases to handle add/sub/and/or/xor with a LOCK prefix.\nPreviously these were all trivially identified as TrapMachineInsn::Atomic\nmerely by the presence of the prefix, but that is insufficient to compute the\nlength, so now they have to be handled properly.\n\nFor riscv64, there are fixes for some obvious bugs and missing cases, but\nfurther work will be needed; this recogniser is still not correct/complete.\nNote that TrapSitesForKind::checkInvariants does not (yet) check recogniser\noutput on riscv64, which is why riscv64 sorta-kinda works most of the time.\nThis will need to be fixed properly in a followup bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311459\n", "files": ["js/src/vm/JitActivation.cpp", "js/src/wasm/WasmCodegenTypes.cpp", "js/src/wasm/WasmSummarizeInsn.cpp", "js/src/wasm/WasmSummarizeInsn.h"], "git_node": "1451fd75fe02d0f88f109ced6eaddf69634e9e75", "git_parents": ["3fba8b9162934362fa2963f52ff3f9fa76b0a069"], "node": "fc2059c0f672ff82d7ca44d9c236d39e8f498791", "parents": ["a2f40901e909661ce3306779a90c04cfac97bf95"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055943 - Remove version 151 allowed-dupes entries for newtab shaft-arrow SVGs. r=ini\n\nThe duplicated SVGs were removed back in bug 2049032.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312809\n", "files": ["browser/installer/allowed-dupes.mn"], "git_node": "939b4a2c23c2f5d570b1a74e7ddacb74004373cf", "git_parents": ["1451fd75fe02d0f88f109ced6eaddf69634e9e75"], "node": "03083dc743e2847452e3313b0dc908ca579d234f", "parents": ["fc2059c0f672ff82d7ca44d9c236d39e8f498791"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049653 - Fix same-session re-run of ASRouter download test r=omc-reviewers,mviar\n\n1. Add `services.settings.base_attachments_url` to the ignore-list. Since Bug 2043699, `Utils.baseAttachmentsURL()` persists the resolved CDN URL into this pref via `setStringPref`, so every RS attachment download mutates it. `pushPrefEnv()`/`popPrefEnv()` can't revert a pref set this way, so the harness's `comparePrefsToBaseline` check flags it as a leaked changed preference (a `TEST-UNEXPECTED-FAIL` under `--verify`)\n\n2.  `ms-language-packs`changeset `timestamp: 42` \u2192 `Date.now()`: With a hardcoded timestamp, a same-session re-run (as test-verify does) sees an unchanged collection and skips the sync, keeping the previous run's record. But each run serves a fresh random attachment UUID from a new server, so the retained stale record points at an attachment the current server no longer serves \u2192 download fails, FTL never written (`NS_ERROR_FILE_NOT_FOUND`)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311255\n", "files": ["browser/components/asrouter/tests/browser/browser_asrouter_bug1761522.js", "testing/mochitest/ignorePrefs.json"], "git_node": "451f34f4e8967bfe3b5029bcd73ba537029aa06f", "git_parents": ["939b4a2c23c2f5d570b1a74e7ddacb74004373cf"], "node": "03eab4905909b37dbad6155e675158842bcabf6a", "parents": ["03083dc743e2847452e3313b0dc908ca579d234f"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055942 - Remove version 145 train-hop shim for PrivacyFeed getTodayStats guard. r=maxx\n\nPrivacyMetricsService.getTodayStats was introduced in bug 2050518 and uplifted to\nFirefox 152 and 153. We can now remove this shim.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312818\n", "files": ["browser/extensions/newtab/lib/Widgets/PrivacyFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_PrivacyFeed.js"], "git_node": "9ca8d79506f23a17381f0a3aa37296d6476e8147", "git_parents": ["451f34f4e8967bfe3b5029bcd73ba537029aa06f"], "node": "dbfe4742fb48a2007aab2ad827fe8006ded84cd8", "parents": ["03eab4905909b37dbad6155e675158842bcabf6a"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049472 - Newtab widget drag n drops transitions r=nina-py\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308112\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/useWidgetDnD.jsx", "browser/extensions/newtab/content-src/lib/useReorderFlip.jsx", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/test/jest/content-src/lib/useReorderFlip.test.jsx"], "git_node": "82f9ddd5838c47f3e6c10adb83d352ae5de397a4", "git_parents": ["9ca8d79506f23a17381f0a3aa37296d6476e8147"], "node": "4fcd7f647a4c21cc5436d89208d846c61cb25d15", "parents": ["dbfe4742fb48a2007aab2ad827fe8006ded84cd8"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039373 Part 1: Make NativeLayerCA::LogSurface into a public method. r=mstange\n\nThis is done to make it possible to call this static method from outside\nthe NativeLayerCA class. No new callsites are added by this patch, but\nit makes it easier to debug other sources of IOSurfaceRefs in the\nfuture.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310164\n", "files": ["gfx/layers/NativeLayerCA.h", "gfx/layers/NativeLayerCA.mm"], "git_node": "150e92ae39030a43ac79ecd533d98a9510d92fea", "git_parents": ["82f9ddd5838c47f3e6c10adb83d352ae5de397a4"], "node": "57ececc9753d63c728c81a4712c909bb3d0ed5af", "parents": ["4fcd7f647a4c21cc5436d89208d846c61cb25d15"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039373 Part 2: Make LogSurface print a header string, add more detail. r=mstange\n\nThis allows callsites to make clear where the logging is coming from.\nThe callsite at NativeLayerCA::EnqueueSurface also logs the\nCMSampleBuffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310165\n", "files": ["gfx/layers/NativeLayerCA.h", "gfx/layers/NativeLayerCA.mm"], "git_node": "c371fa5229cd330e791c93faec64e8303d49985f", "git_parents": ["150e92ae39030a43ac79ecd533d98a9510d92fea"], "node": "a121d028045002aff5a2f6b42d8021b8d8244fce", "parents": ["57ececc9753d63c728c81a4712c909bb3d0ed5af"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039373 Part 3: Make MP4 decoder provide default HDR metadata. r=media-playback-reviewers,mstange,padenot\n\nThis matches Chrome behavior. The change is purely defensive, in case\nApple changes requirements for proper HDR display based on what Chrome\nis doing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310167\n", "files": ["dom/media/gtest/TestMP4Demuxer.cpp", "dom/media/mp4/DecoderData.cpp"], "git_node": "a6de1d412131be42e389d77e82f9a066e95e878a", "git_parents": ["c371fa5229cd330e791c93faec64e8303d49985f"], "node": "7b56bd53ab6ecb8a79a085fb9c0449c6b909b0ee", "parents": ["a121d028045002aff5a2f6b42d8021b8d8244fce"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039373 Part 4: Make AppleVTDecoder::OutputFrame rebuild the colorspace. r=media-playback-reviewers,mstange,padenot\n\nFor some combinations of transfer function, color primaries, and matrix,\nthe CVPixelBufferRef from the decoder does not have a matching\ncolorspace property. Build a CGColorSpace from the color primaries and\ntransfer function, and attach it to the buffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311997\n", "files": ["dom/media/platforms/apple/AppleVTDecoder.cpp"], "git_node": "5ccb8503a6323378904aaf3ef3dd2e2a44d02a7b", "git_parents": ["a6de1d412131be42e389d77e82f9a066e95e878a"], "node": "712cc48532a755bcb9cfb4f3f85e49391c2b127c", "parents": ["7b56bd53ab6ecb8a79a085fb9c0449c6b909b0ee"], "tags": []}, {"author": "Brad Werth \u003cbwerth@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039373 Part 5: Enqueue HDR video surfaces with extended dynamic range. r=mstange\n\nThis adds plumbing to NativeLayerCA and ::Representation to indicate if\nit is showing HDR video content. This value is used to conditionally set\na property on the video layer to enable the display of extended color.\nSetting this property has to be done before every call to\nenqueueSampleBuffer. We would like to set the property only once, when\nthe video layer is created, but this approach doesn't seem to work\nbeyond the first sample buffer, for an unknown reason.\n\nThe video layer property is different depending on macOS version:\nmacOS 26: preferredDynamicRange.\nmacOS 14 or 15: wantsExtendedDynamicRangeContent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311998\n", "files": ["gfx/layers/NativeLayerCA.h", "gfx/layers/NativeLayerCA.mm", "gfx/layers/NativeLayerRemoteMac.mm"], "git_node": "68cab7f8e7c98430061739f333d522b8330dd3c2", "git_parents": ["5ccb8503a6323378904aaf3ef3dd2e2a44d02a7b"], "node": "8494747d48f2dc89c46c9e058bcf3a8a09e8a310", "parents": ["712cc48532a755bcb9cfb4f3f85e49391c2b127c"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 1856162 Part 1 - Allow scaling a PDF beyond its normal page-size. r=dholbert\n\nThis will only happen when printing a single page-per-sheet, and when the page\nis smaller than the sheet. This also does not let you zoom the PDF up past the\nsize of the sheet being used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D284747\n", "files": ["layout/generic/nsPageFrame.cpp", "layout/generic/nsPageSequenceFrame.h", "layout/printing/nsPrintJob.cpp"], "git_node": "8983b5063259dadfc787456fa648206e5d9c1811", "git_parents": ["68cab7f8e7c98430061739f333d522b8330dd3c2"], "node": "ab3688e5ce2346412c5e4fbf7e25b21332da5089", "parents": ["8494747d48f2dc89c46c9e058bcf3a8a09e8a310"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 1856162 Part 2 - Add tests for printing PDFs with scale factors greater than 100% r=layout-reviewers,dholbert\n\nThis tests that scaling a PDF above 100% will work up to the maximum of the\nsheet size.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312832\n", "files": ["layout/base/tests/chrome/printpreview_helper.xhtml"], "git_node": "85970edefd46f9953f9d042c798086a7e39b2794", "git_parents": ["8983b5063259dadfc787456fa648206e5d9c1811"], "node": "ab3ccde67d7d55bbc96ab29fca5b94f3f2110cb7", "parents": ["ab3688e5ce2346412c5e4fbf7e25b21332da5089"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054941 - Add assertions guarding the BounceTrackingState OriginAttributes invariant against future per-site container association. r=bvandersloot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313036\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtection.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp"], "git_node": "8a1e0eee6f50923898723a372007ea969dacec35", "git_parents": ["85970edefd46f9953f9d042c798086a7e39b2794"], "node": "4c73787c849ac54e507f05df4a6b8e5119978d92", "parents": ["ab3ccde67d7d55bbc96ab29fca5b94f3f2110cb7"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "0bddcd3c18e7c6ea6bca18e99403ecbfdc3d5f49", "git_parents": ["8a1e0eee6f50923898723a372007ea969dacec35", "9631bc624c432f094ca05c276e5a5c922407859f"], "node": "bd1e359b0946d29584898996524f7ac62b0b7b88", "parents": ["4c73787c849ac54e507f05df4a6b8e5119978d92", "27bb72351e256a52cbb34d1dbf13c37b9856543e"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "33edae724a1ee8922aa0863e5d7d8d5fe27754a2", "git_parents": ["0bddcd3c18e7c6ea6bca18e99403ecbfdc3d5f49", "b52296d542b89092ffd707ca478a85ebf0f89ff5"], "node": "2288129a8a6db433ea6d93b684f86d4b0614dff5", "parents": ["bd1e359b0946d29584898996524f7ac62b0b7b88", "3b84f070c33f2b7e894e8bad7cb5160b8ea706b1"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2004172 - Fix crash when calling pushState on initial about:blank. r=dom-core-reviewers,jjaschke\" for causing crashes on 2004172.html.\n\nThis reverts commit cc121ee819feb9f69b318ebcefaf483d6880fe70.\n", "files": ["docshell/base/crashtests/2004172.html", "docshell/base/crashtests/crashtests.list", "docshell/base/nsDocShell.cpp"], "git_node": "622e678b39827cb474c0626be38a14d64d5c7b37", "git_parents": ["33edae724a1ee8922aa0863e5d7d8d5fe27754a2"], "node": "8597a93edb598fcf746b0fc8f188ffc052b8bf3a", "parents": ["2288129a8a6db433ea6d93b684f86d4b0614dff5"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 1867132 - bump up the requestLongerTimeout on browser/components/reportbrokensite/test/browser/browser_keyboard_navigation.js; r=ksenia,webcompat-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313041\n", "files": ["browser/components/reportbrokensite/test/browser/browser_keyboard_navigation.js"], "git_node": "1612cd620baf668a0665b7026d3e1335a73d7c3e", "git_parents": ["622e678b39827cb474c0626be38a14d64d5c7b37"], "node": "56dda2a119a239d158288b2c2328768253f2d969", "parents": ["8597a93edb598fcf746b0fc8f188ffc052b8bf3a"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046603 - show monitor card in chat r=ngrato,tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311576\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.stories.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_chat.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "dce652e18fff2fc71e3f5162aece0976af825032", "git_parents": ["1612cd620baf668a0665b7026d3e1335a73d7c3e"], "node": "6438d2de51ed5f5a160bd9970d75203b9c16fe6b", "parents": ["56dda2a119a239d158288b2c2328768253f2d969"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2022656 - Implement lastWindowClose trigger r=Gijs,hanna_a,omc-reviewers\n\nSupersedes D297136 which implemented a quitRequested trigger scoped to app quit in favor of triggering on last window close (known limitation that this trigger does not run if window is closed simply by clearing out all tabs).\n\n- Dispatches an ASRouter \"lastWindowClose\" trigger.\n- Cancels the last window close while a message is pending.\n- Once the message's closedPromise resolves, reissues the window close.\n- A module-level guard prevents dispatching a second message if the user attempts to close the same window again while the first is still pending.\n\n**Important notes for when this is used in practice: ** This trigger is scoped to use with the Spotlight modal only. When a lastWindowClose triggered Spotlight message's button fires a SpecialMessageAction(s) that needs to complete before the window actually closes, set `\"needsAwait\": true` on the action(s).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312782\n", "files": ["browser/base/content/browser.js", "browser/base/content/browser.js.globals", "browser/components/asrouter/metrics.yaml", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/Spotlight.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "browser/components/tests/browser/browser.toml", "browser/components/tests/browser/browser_last_window_close_trigger.js", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/index.md"], "git_node": "6ddc79753550df72e0f03db1b1ff63578e91e9f5", "git_parents": ["dce652e18fff2fc71e3f5162aece0976af825032"], "node": "68d6f7fef4b0882fcf766169c340f0ec61b28c4c", "parents": ["6438d2de51ed5f5a160bd9970d75203b9c16fe6b"], "tags": []}, {"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053221 - Support fire and forget for PIN_FIREFOX_TO_TASKBAR action. r=omc-reviewers,mviar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311190\n", "files": ["browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_upgrade_multistage_mr.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_pin_firefox.js"], "git_node": "442315f30bffff4bce07107b0b155a9630283578", "git_parents": ["6ddc79753550df72e0f03db1b1ff63578e91e9f5"], "node": "8dde3099bef4283e1927d70f2ec6961d51afbd6f", "parents": ["68d6f7fef4b0882fcf766169c340f0ec61b28c4c"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2053223 - Update styles for system-prompt-spotlight. r=omc-reviewers,hanna_a\n\nOur system prompt spotlight doesn't fully visually match system prompts. This bug is for fixing that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311192\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "c80511f428e9cd6e1cf8dfb1e6d3fbc32a840982", "git_parents": ["442315f30bffff4bce07107b0b155a9630283578"], "node": "53251128fad9186a26bca28e3eb25e87756ad4e9", "parents": ["8dde3099bef4283e1927d70f2ec6961d51afbd6f"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052229 - Skip onboarding for performance tests running on Android emulators r=android-reviewers,tthibaud\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310096\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/Performance.kt"], "git_node": "0aa7a2882ad02e4177ce0ea9f445799806e276d2", "git_parents": ["c80511f428e9cd6e1cf8dfb1e6d3fbc32a840982"], "node": "53cbdbafdb79881e726a89f41add4db1cb74b734", "parents": ["53251128fad9186a26bca28e3eb25e87756ad4e9"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2051545 - Highlight blocked trackers in the address bar. r=fluent-reviewers,desktop-theme-reviewers,flod,daleharvey,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309557\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/controlcenter/metrics.yaml", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/tests/browser/browser_trust_panel.js", "browser/components/urlbar/tests/browser/browser_trust_panel_icon.js", "browser/locales/en-US/browser/browser.ftl", "browser/themes/shared/identity-block/identity-block.css", "tools/lint/rejected-words.yml"], "git_node": "18e028f6758e6572975faa1a3bcd118ff7994c2c", "git_parents": ["0aa7a2882ad02e4177ce0ea9f445799806e276d2"], "node": "e11e78ac1559c1d2d21ed16395bbb141b93a90ff", "parents": ["53cbdbafdb79881e726a89f41add4db1cb74b734"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2052046 - Allow tracker count to be controlled by an experiment. r=urlbar-reviewers,daisuke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309916\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-trustPanel.js", "browser/components/urlbar/tests/browser/browser_trust_panel_icon.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "e905a96b2184e11785ba241bb079c063983096c1", "git_parents": ["18e028f6758e6572975faa1a3bcd118ff7994c2c"], "node": "576d780d2e0c1484bc16f2f60b84a43ee20e7723", "parents": ["e11e78ac1559c1d2d21ed16395bbb141b93a90ff"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052047 - Add setting for tracker count. r=urlbar-reviewers,fluent-reviewers,mconley,flod,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309917\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/browser-trustPanel.js", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/etp/browser_etp_status.js", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/tests/browser/browser_trust_panel_icon.js", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "6df634b802fcf109a7eaf3bd8981df8670bbe715", "git_parents": ["e905a96b2184e11785ba241bb079c063983096c1"], "node": "981144874a19547ce41aecb4fd2cfac9be0ea985", "parents": ["576d780d2e0c1484bc16f2f60b84a43ee20e7723"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056231 - Add slack notifications for failures for macrobenchmark tests r=releng-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313006\n", "files": ["taskcluster/kinds/run-macrobenchmark-firebase/kind.yml"], "git_node": "a938abf0397e472b2de1afbbddb77926e4e9356a", "git_parents": ["6df634b802fcf109a7eaf3bd8981df8670bbe715"], "node": "ad0c572b0a63ae3e35339ea09487d54de8dcb82e", "parents": ["981144874a19547ce41aecb4fd2cfac9be0ea985"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054805 - Update browser_modal_resize.js test for Nova r=tabbrowser-reviewers,nsharpley\n\nWhen Nova is on, the print dialog has a bit less room than the window. The test compared against the window size, so its expected values drifted just enough to fail. The expected size is now derived from what the dialog actually has to work with.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312387\n", "files": ["toolkit/components/printing/tests/browser_modal_resize.js"], "git_node": "971b87eebce775ca75a449ef46340903e35d0ad6", "git_parents": ["a938abf0397e472b2de1afbbddb77926e4e9356a"], "node": "416e5370cea4ee908250932d9280484e2b4ee80c", "parents": ["ad0c572b0a63ae3e35339ea09487d54de8dcb82e"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047788 - Animate the widgets row height when toggling show more/less r=thecount\n\nClicking show more/less previously snapped the widgets container to its new\nheight. Capture the pre-toggle height and FLIP-animate the container to its\nnew height using the same timing tokens widgets use when resizing, so the\nrow collapses and expands smoothly. Hidden widgets still use display:none so\ntab order and a11y are unaffected. The animation is skipped under\nprefers-reduced-motion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306894\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/components/Widgets/_Widgets.scss", "browser/extensions/newtab/content-src/styles/_mixins.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx"], "git_node": "c9480f67625ac8e0960819ca2c7c22f53187265e", "git_parents": ["971b87eebce775ca75a449ef46340903e35d0ad6"], "node": "eac7378493b302ddafe5cc5d740734a12afdb54f", "parents": ["416e5370cea4ee908250932d9280484e2b4ee80c"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049955 - Fix VPN location selection section UI r=android-reviewers,android-l10n-reviewers,gmalekpour,jonalmeida,parker\n\nChanged padding, copyright, and did a minor refactoring.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311138\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "e1f213b391781bb2a0889f59793b1d5789ce0b14", "git_parents": ["c9480f67625ac8e0960819ca2c7c22f53187265e"], "node": "dc84832c8371be6a88d5a9dc431674fcd1edec06", "parents": ["eac7378493b302ddafe5cc5d740734a12afdb54f"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2053761 - Move constants from UrlbarUtils to UrlbarShared r=dao,urlbar-reviewers,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311961\n", "files": ["accessible/tests/browser/events/browser_test_focu