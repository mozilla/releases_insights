ests/xnotify.c", "nsprpub/pr/tests/y2k.c", "nsprpub/pr/tests/y2ktmo.c", "nsprpub/pr/tests/zerolen.c"], "git_node": "39a1d8f0f736acd6cfc2d7a780fd864ee65746de", "git_parents": ["39c90c25677e929dd943f3394b04720794733a2a"], "node": "873b3783a1a20e3f6db2af40aa45b1c08f7c4931", "parents": ["f667e9c4750821fb3fecf824f021bd7376ac863d"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "No bug - Clarify review turnaround expectations and prefer review groups r=overholt DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315439\n", "files": ["docs/contributing/reviews.md"], "git_node": "5b4e6d3ec25fa80f620b56582fbeea531250de81", "git_parents": ["39a1d8f0f736acd6cfc2d7a780fd864ee65746de"], "node": "1e6a84e494e14630b7ec237193b95868010600d1", "parents": ["873b3783a1a20e3f6db2af40aa45b1c08f7c4931"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "No bug - Document how to cross-reference documents in the documentation skill r=ai4dev-reviewers,padenot DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316237\n", "files": [".agents/skills/documentation/SKILL.md", ".claude/skills/documentation/SKILL.md"], "git_node": "e1bbbaef048045596e7367cffc5369f79372ca08", "git_parents": ["5b4e6d3ec25fa80f620b56582fbeea531250de81"], "node": "00df67b1c9b8921d0dcccb24a5ac08d124b70137", "parents": ["1e6a84e494e14630b7ec237193b95868010600d1"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2039416 - Update builders to rustc 1.95. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310745\n", "files": ["build/build-rust/Zprofile.patch", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/rust.yml"], "git_node": "a91a99a53ff3ae309b8f8473e4debdf54ec580a3", "git_parents": ["e1bbbaef048045596e7367cffc5369f79372ca08"], "node": "4cc0b14e5e1084b9e11182bd198eadf2c5e79c2f", "parents": ["00df67b1c9b8921d0dcccb24a5ac08d124b70137"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1977771 - Update builders to clang 22. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310746\n", "files": ["build/build-clang/clang-tidy.json", "build/moz.configure/compile-checks.configure", "taskcluster/kinds/toolchain/clang-tidy.yml", "taskcluster/kinds/toolchain/clang.yml", "tools/clang-tidy/config.yaml"], "git_node": "283d5481d38a6b215e87622c8af5edda7bb0f406", "git_parents": ["a91a99a53ff3ae309b8f8473e4debdf54ec580a3"], "node": "fba57edd5a0c0775c0a71925b2736f9f15a1ec53", "parents": ["4cc0b14e5e1084b9e11182bd198eadf2c5e79c2f"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 1 - Pass the generator resume index in the ResumeFrameArgs. r=iain\n\nThis adds a fourth slot to `ResumeFrameArgs` for the generator's resume index.\nThe resumer is now responsible for reading the generator's resume index slot and\nmarking the generator as running (this clobbers the generator's resume index slot).\n\nInitially this was required for part 4, but I've since changed that path to no longer\nallow executing arbitrary JS through the interrupt handler. However having the resume\nindex in `ResumeFrameArgs` also simplifies the Ion implementation later on and will be\nmore efficient in some cases, so I've kept it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316193\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/Jit.cpp", "js/src/jit/JitFrames.h", "js/src/jit/VMFunctions.cpp", "js/src/vm/GeneratorObject.cpp", "js/src/vm/Interpreter.cpp", "js/src/vm/Stack.h"], "git_node": "44ccd2a4fcf1b4272a75abb2b3905728ec7b0bb6", "git_parents": ["283d5481d38a6b215e87622c8af5edda7bb0f406"], "node": "f8944199b9e5ed71a4aa4e4cd2b3185c71df162f", "parents": ["fba57edd5a0c0775c0a71925b2736f9f15a1ec53"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 2 - Add emitAfterCall argument to emitIsDebuggeeCheck. r=iain\n\nThe next patch will use this to restore registers in `emitIsDebuggeeCheck` only if\nwe actually called into C++.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316194\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h"], "git_node": "5eedf93248d8d48988a8865707dc483b42812602", "git_parents": ["44ccd2a4fcf1b4272a75abb2b3905728ec7b0bb6"], "node": "4256d4d5e00608b816c98a19971b0a3116a987f8", "parents": ["f8944199b9e5ed71a4aa4e4cd2b3185c71df162f"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 3 - Set the frame's debuggee flag in Baseline's generator resume prologue. r=iain\n\nWe were doing this as part of `JSOp::AfterYield`, but that's too late when we\nadd an overrecursion check to the resume prologue.\n\nSetting the flag in the prologue makes this consistent with both the C++ interpreter's\nresume code and Baseline's non-resume prologue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316195\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/VMFunctions.cpp", "js/src/vm/Interpreter.cpp"], "git_node": "9879a2d1ab80d9a1b57611cfcd4b37b21c9427b9", "git_parents": ["5eedf93248d8d48988a8865707dc483b42812602"], "node": "8b06c0d9e6a0e967f7a6df498ec2c1ebab4a1743", "parents": ["4256d4d5e00608b816c98a19971b0a3116a987f8"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 4 - Add an overrecursion check to the generator resume prologue. r=iain\n\nThis is more consistent with the normal (non-resume) prologue. Currently all\ngenerator-resumes go through `GeneratorNext` and it has an overrecursion check,\nbut when Ion can inline that function and compile generators, the generator's\nown overrecursion check becomes more important.\n\nUnlike the normal overrecursion check in the prologue, this one does not handle\ninterrupts. Supporting interrupts while we're in the middle of resuming a generator\nframe is complicated considering Debugger interactions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316196\n", "files": ["js/src/debugger/Debugger.cpp", "js/src/jit-test/tests/debug/bug2060131-resume-interrupt-attach-debuggee.js", "js/src/jit-test/tests/generators/bug2060131-resume-overrecursion.js", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BaselineDebugModeOSR.cpp", "js/src/jit/BaselineJIT.h", "js/src/jit/CompileWrappers.cpp", "js/src/jit/CompileWrappers.h", "js/src/jit/JitFrames.cpp", "js/src/jit/VMFunctions.cpp", "js/src/vm/FrameIter.cpp", "js/src/vm/FrameIter.h", "js/src/vm/Runtime.cpp"], "git_node": "8efdfae70717f45b0c9e6ac1459c5a9927242062", "git_parents": ["9879a2d1ab80d9a1b57611cfcd4b37b21c9427b9"], "node": "c008707e2e8604a499c2e2a6dc009e52b918d247", "parents": ["8b06c0d9e6a0e967f7a6df498ec2c1ebab4a1743"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 5 - Shrink GeneratorNext so that it can be inlined later. r=iain\n\n`GeneratorNext` now has a bytecode length of ~115, less than `smallFunctionMaxBytecodeLength` (140).\nThis ensures we can inline it once WarpBuilder can compile `JSOp::Resume`.\n\nThe `GeneratorSetClosed` intrinsic was only called in the `catch`-blocks, after\nchecking `!GeneratorObjectIsClosed`. Move that if-statement into the intrinsic to\navoid the extra call and branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316197\n", "files": ["js/src/builtin/Generator.js", "js/src/vm/SelfHosting.cpp"], "git_node": "13a058f8307e2dd55605e79555dffb9f6844ee7a", "git_parents": ["8efdfae70717f45b0c9e6ac1459c5a9927242062"], "node": "c8c48b313662339c5d12a6f574948fdd4154e170", "parents": ["c008707e2e8604a499c2e2a6dc009e52b918d247"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 6 - Support JSOp::Resume in WarpBuilder. r=iain\n\nNow that `JSOp::Resume` is very similar to a call, we can Ion-compile and inline\nthe self-hosted `GeneratorNext` function. (`GeneratorThrow` and `GeneratorReturn`\ncan also be Ion-compiled now but they're less performance-sensitive.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316198\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp", "js/src/jit/Lowering.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.h", "js/src/jit/WarpBuilder.cpp", "js/src/jit/WarpBuilder.h", "js/src/jit/WarpOracle.cpp", "js/src/vm/Opcodes.h"], "git_node": "52b3c9699cea30f750a46ae4a6d311edba2fc29a", "git_parents": ["13a058f8307e2dd55605e79555dffb9f6844ee7a"], "node": "0b3651bc33f528e998832a028fcf539f5b2dadb4", "parents": ["c8c48b313662339c5d12a6f574948fdd4154e170"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 7 - Rename CallIsSuspendedGeneratorResult op to IsSuspendedGeneratorResult. r=iain\n\nThis op doesn't make a call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316199\n", "files": ["js/src/jit/CacheIR.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIROps.yaml"], "git_node": "1d7c81028b308890ee7355f5323fc909d2c5c8ad", "git_parents": ["52b3c9699cea30f750a46ae4a6d311edba2fc29a"], "node": "676585a0fe2ffe9479003a671cf1e3a4b74aa95c", "parents": ["0b3651bc33f528e998832a028fcf539f5b2dadb4"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 8 - Make IsSuspendedGeneratorResult take an object operand. r=iain\n\nThis will avoid a redundant unbox in Ion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316200\n", "files": ["js/src/jit/CacheIR.cpp", "js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIROps.yaml"], "git_node": "f10aa7bbbdd6dae7d99556000953048bfc8ee47a", "git_parents": ["1d7c81028b308890ee7355f5323fc909d2c5c8ad"], "node": "3b44c81dae619387946f80761cbcf612378e3581", "parents": ["676585a0fe2ffe9479003a671cf1e3a4b74aa95c"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 9 - Transpile IsSuspendedGeneratorResult. r=iain\n\nThis is required to get good performance for Ion-compiled `GeneratorNext`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316201\n", "files": ["js/src/jit/CacheIRCompiler.cpp", "js/src/jit/CacheIROps.yaml", "js/src/jit/CodeGenerator.cpp", "js/src/jit/LIROps.yaml", "js/src/jit/Lowering.cpp", "js/src/jit/MIROps.yaml", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/WarpCacheIRTranspiler.cpp", "js/src/vm/GeneratorObject.h"], "git_node": "cd88ae08d75fc09fbd035127480ee177f38aa6f7", "git_parents": ["f10aa7bbbdd6dae7d99556000953048bfc8ee47a"], "node": "10f0f7db2d8a01d0d6569eb76f3c421f25d16166", "parents": ["3b44c81dae619387946f80761cbcf612378e3581"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060131 part 10 - Assert resuming generator stack slots are only traced at the resume point. r=iain\n\n`BaselineFrame::trace` and `InterpreterFrame::trace` clear the locals that aren't live\nat the frame's pc. Nothing between restoring these slots and setting the pc can GC,\nso assert this to prevent a (future) footgun.\n\nThis was an issue for an earlier prototype based on a different approach. It caused\nJetStream to fail intermittently.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316202\n", "files": ["js/src/jit/BaselineFrame.cpp", "js/src/vm/Stack.cpp"], "git_node": "9c6d75198bd384c54415a2515c19eeb4d560c62b", "git_parents": ["cd88ae08d75fc09fbd035127480ee177f38aa6f7"], "node": "ce8346d5a287b2be8da97d0dc6ad2ada12a9a63d", "parents": ["10f0f7db2d8a01d0d6569eb76f3c421f25d16166"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042839 - [devtools] Display ::picker rules in Rules view. r=devtools-reviewers,bomsy.\n\nThose are displayed in the \"Pseudo elements\" section when a `\u003cselect\u003e` element\nis selected.\nWe can also have them displayed in \"Inherited\" sections in the Rules view.\nAdd test cases to cover this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315258\n", "files": ["devtools/client/inspector/rules/models/rule.js", "devtools/client/inspector/rules/test/browser_rules_inherited-element-backed-pseudo-elements.js", "devtools/client/inspector/rules/test/browser_rules_pseudo-element_01.js", "devtools/server/actors/page-style.js"], "git_node": "a14690fb3b6bdd61607097e2cf911b823ca1767f", "git_parents": ["9c6d75198bd384c54415a2515c19eeb4d560c62b"], "node": "85589eb29a50a9a3184b47725408297db39e7c30", "parents": ["ce8346d5a287b2be8da97d0dc6ad2ada12a9a63d"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042839 - [devtools] Handle ::picker rules in computed panel matched selectors. r=devtools-reviewers,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315259\n", "files": ["devtools/client/inspector/computed/test/browser_computed_inherited-element-backed-pseudo-elements.js", "devtools/server/actors/inspector/utils.js", "devtools/shared/inspector/css-logic.js"], "git_node": "d7855b78866cd05e44d4a79bc0e39881ab1a69dc", "git_parents": ["a14690fb3b6bdd61607097e2cf911b823ca1767f"], "node": "10f8814556b2d98bc2d01c159cb9d7e928e425b6", "parents": ["85589eb29a50a9a3184b47725408297db39e7c30"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert (Bug 1977771, Bug 2039416) for causing toolchain bustages\n\nThis reverts commit 283d5481d38a6b215e87622c8af5edda7bb0f406.\n\nRevert \"Bug 2039416 - Update builders to rustc 1.95. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit a91a99a53ff3ae309b8f8473e4debdf54ec580a3.\n", "files": ["build/build-clang/clang-tidy.json", "build/build-rust/Zprofile.patch", "build/moz.configure/compile-checks.configure", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/clang-tidy.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/rust.yml", "tools/clang-tidy/config.yaml"], "git_node": "4b5abcfa6b7d2e568581b7c1942e52e3f1c7e04d", "git_parents": ["d7855b78866cd05e44d4a79bc0e39881ab1a69dc"], "node": "15b4dcbdb6c28d3b30e6eaa0e0f31eab0305c658", "parents": ["10f8814556b2d98bc2d01c159cb9d7e928e425b6"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048566 - Gate WebRTC GMP codec creation on plugin availability. r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308756\n", "files": ["dom/media/webrtc/libwebrtcglue/GmpVideoCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp"], "git_node": "abe6cd3ead8e5aada0ba7341b0cd81dc9b9ae152", "git_parents": ["4b5abcfa6b7d2e568581b7c1942e52e3f1c7e04d"], "node": "621f83cddd330f79e672a2033eb88031f127451d", "parents": ["15b4dcbdb6c28d3b30e6eaa0e0f31eab0305c658"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add RemoteMediaManagerChild::EnsureCodecSupportFor for async HW codec support queries. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304784\n", "files": ["dom/media/ipc/RemoteMediaManagerChild.cpp", "dom/media/ipc/RemoteMediaManagerChild.h"], "git_node": "4d91a741e3ca769461a20d82ce1011e16cb3e92f", "git_parents": ["abe6cd3ead8e5aada0ba7341b0cd81dc9b9ae152"], "node": "49ae0f8c00e9f05e7b4c11e25f1c8a55d70c7531", "parents": ["621f83cddd330f79e672a2033eb88031f127451d"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add cached async codec-support path for MediaCapabilities decode behind a pref. r=media-playback-reviewers,alwu\n\nAdd RemoteMediaManagerChild::EnsureCodecSupportFor-backed async support queries\n(PDMFactory::SupportsAsync / PDMFactorySupport::IsSupportedAsync) and use them\nfor the non-WebRTC MediaCapabilities decode paths, gated by the new\nmedia.mediacapabilities.codec-support-cache.enabled pref (default false). When\nthe pref is disabled the original behaviour is used: creating a decoder and\nquerying it for video, and a synchronous PDMFactorySupport query for audio.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304785\n", "files": ["dom/media/ipc/RemoteDecoderModule.cpp", "dom/media/ipc/RemoteDecoderModule.h", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/mediacapabilities/MediaCapabilities.h", "dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/PDMFactory.h", "dom/media/platforms/PDMFactorySupport.cpp", "dom/media/platforms/PDMFactorySupport.h", "dom/media/platforms/PlatformDecoderModule.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "76004a6b2462d6faadb10803de77d8d63157f4c9", "git_parents": ["4d91a741e3ca769461a20d82ce1011e16cb3e92f"], "node": "494ad0898a82c4efd4165da0f0fc68fd24fe4cd2", "parents": ["49ae0f8c00e9f05e7b4c11e25f1c8a55d70c7531"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044501 - Add moz-WPT for new media-capabilities supports-cache pref. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309551\n", "files": ["testing/web-platform/mozilla/meta/media-capabilities/decodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/meta/media-capabilities/encodingInfo-api-modes.any.js.ini", "testing/web-platform/mozilla/tests/media-capabilities/decodingInfo-api-modes.any.js", "testing/web-platform/mozilla/tests/media-capabilities/encodingInfo-api-modes.any.js"], "git_node": "a53d0867cbd629506409a6878624a59d60df69f0", "git_parents": ["76004a6b2462d6faadb10803de77d8d63157f4c9"], "node": "cee87821e1d4defd741038f4e7cea042a38a420f", "parents": ["494ad0898a82c4efd4165da0f0fc68fd24fe4cd2"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2057724 - Sandbox - Allow RDD XWayland socket and Xauthority on Wayland for Vulkan Video. r=jld,sandbox-reviewers\n\nOn a GTK Wayland session, AddX11Dependencies() skips both the X11 socket and\n$XAUTHORITY because GdkIsWaylandDisplay() is true. NVIDIA EGL bring-up in RDD\nstill dials XWayland (/tmp/.X11-unix/X*) and needs the auth cookie\n($XAUTHORITY; on GNOME this is $XDG_RUNTIME_DIR/.mutter-Xwaylandauth.*). Socket-\nonly granting left cookie access denied (\"Authorization required\"), so EGL\nstill failed. Grant the same pair AddX11Dependencies would on X11, only in\nGetRDDPolicy() when Vulkan Video is FEATURE_STATUS_OK and DISPLAY is set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315912\n", "files": ["security/sandbox/linux/broker/SandboxBrokerPolicyFactory.cpp"], "git_node": "91b0860d83c0b620c496116b76990047e303a72a", "git_parents": ["a53d0867cbd629506409a6878624a59d60df69f0"], "node": "a1203d2c667b5b271b6a2af666a46bb127940be8", "parents": ["cee87821e1d4defd741038f4e7cea042a38a420f"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057352 - Only accept modifying existing attributes in nested resource updates. r=devtools-reviewers,nchevobbe\" as requeste by dev.\n\nThis reverts commit ee4dd00e853d252b0263c2e16d72574ffc4946bf.\n", "files": ["devtools/shared/commands/resource/resource-command.js"], "git_node": "d4bf43c844d37a7c82b179edf71a8509310cefa7", "git_parents": ["91b0860d83c0b620c496116b76990047e303a72a"], "node": "c2d8d1f0ae9ba895951ef94006fc62dc4643f4e2", "parents": ["a1203d2c667b5b271b6a2af666a46bb127940be8"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2048566 - Gate WebRTC GMP codec creation on plugin availability. r=webrtc-reviewers,bwc\" for causing webrtc and media failures.\n\nThis reverts commit abe6cd3ead8e5aada0ba7341b0cd81dc9b9ae152.\n", "files": ["dom/media/webrtc/libwebrtcglue/GmpVideoCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcGmpVideoCodec.cpp"], "git_node": "fbc01907a368f3c1bcf95653c5fda48099a4688b", "git_parents": ["d4bf43c844d37a7c82b179edf71a8509310cefa7"], "node": "e6bdf20c42c23e55e16b9990800ae1cb0d31dfeb", "parents": ["c2d8d1f0ae9ba895951ef94006fc62dc4643f4e2"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2045980: Add a site policy for https-only mode. r=mkaply,necko-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316221\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_https.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_sitepolicies_jit.js", "browser/components/enterprisepolicies/tests/browser/sitepolicies_https_subresource.html", "browser/components/enterprisepolicies/tests/xpcshell/test_sitepolicies.js", "netwerk/base/nsNetUtil.cpp"], "git_node": "da25fd8337c6a2ef00deb78757b5348809d9ddf9", "git_parents": ["fbc01907a368f3c1bcf95653c5fda48099a4688b"], "node": "87eb7dd59026e7cc81443c1a610b97403778e5d9", "parents": ["e6bdf20c42c23e55e16b9990800ae1cb0d31dfeb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2054691 - Validate cross-process paint dependencies. r=nika,layout-reviewers,dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314723\n", "files": ["gfx/ipc/CrossProcessPaint.cpp", "gfx/ipc/CrossProcessPaint.h", "layout/printing/ipc/RemotePrintJobParent.cpp", "layout/printing/ipc/RemotePrintJobParent.h"], "git_node": "be37a7a2aaafd27556dd23f6998bff139df2f0f6", "git_parents": ["da25fd8337c6a2ef00deb78757b5348809d9ddf9"], "node": "063fea5dbe9c7df579ba9908593b2e4d9e4bbedf", "parents": ["87eb7dd59026e7cc81443c1a610b97403778e5d9"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044636 - Route MediaCapabilities WebRTC and encode paths through async codec support. r=media-playback-reviewers,webrtc-reviewers,bwc,padenot\n\nAdd async support queries through the encoder stack (PlatformEncoderModule,\nRemoteEncoderModule, PEMFactory) and convert the WebRTC decode/encode glue\n(WebrtcMediaDataDecoder, WebrtcVideoCodecFactory, MediaDataCodec, CodecInfo) to\nresolve once the relevant remote process has reported accurate hardware\nsupport. The MediaCapabilities WebRTC decode and encode paths and the\nTestWebRTCCodecInfo gtests now use these; the superseded synchronous WebRTC\nsupport paths are removed. WebRTC decode support reuses the cached\nPDMFactorySupport singleton.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304787\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/ipc/RemoteEncoderModule.cpp", "dom/media/ipc/RemoteEncoderModule.h", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/platforms/PlatformEncoderModule.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h"], "git_node": "f57a88af44ba8e36337758b1b7162e9cd33cafd1", "git_parents": ["be37a7a2aaafd27556dd23f6998bff139df2f0f6"], "node": "b9bc89e7aabb64b665b75f84c03e9ea35ab93bf8", "parents": ["063fea5dbe9c7df579ba9908593b2e4d9e4bbedf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2048635 - Don't allow param(--foo) in link-parameters. r=firefox-style-system-reviewers,firefox-svg-reviewers,dshin,longsonr\n\nAlso while at it be clearer about hashing in SVGImageContext, since it\nlooks like we'd be hashing hashes :)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316274\n", "files": ["layout/svg/SVGImageContext.h", "servo/components/style/custom_properties.rs", "servo/components/style/values/specified/param.rs", "testing/web-platform/meta/css/css-link-params/link-parameters-invalid.html.ini"], "git_node": "ca99efee6b1ac1899e2066a3ba7359c3d36f9f07", "git_parents": ["f57a88af44ba8e36337758b1b7162e9cd33cafd1"], "node": "7dcf758ddbcbf7a02b1531c5d2a67065a3fc421b", "parents": ["b9bc89e7aabb64b665b75f84c03e9ea35ab93bf8"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Give SegmentBuilder a single bounds rect. r=gw\n\nSegmentBuilder::initialize took a prim rect and a clip rect and pushed both as\nclips. Its only non-test caller is the compositor clip promotion path in\nrenderer/composite.rs, which passes the same rect for both, so collapsing the\npair into a single bounds rect changes nothing there and removes a duplicate\nclip item (and the split events it generated).\n\nThe segment unit tests keep exercising both rects: they pass the intersection\nas the bounds and still push the two rects explicitly, which is what makes them\ninteresting clips.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316288\n", "files": ["gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/segment.rs"], "git_node": "f5ae18b4c1525c7974e0311a10d4fac46789f55b", "git_parents": ["ca99efee6b1ac1899e2066a3ba7359c3d36f9f07"], "node": "d3742f981a5fcf4dcdac2b9148bad18cc4d8761a", "parents": ["7dcf758ddbcbf7a02b1531c5d2a67065a3fc421b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Anti-alias the quad's coverage rect, not its intersection with the pattern rect. r=gw\n\n`antialiasing_vertex` built the transform bounds by intersecting\n`local_prim_rect` with `local_clip_rect`. Despite the names, the former is\nthe rect that situates the pattern (it is fed from `QuadPrimitive.pattern_rect`)\nand the latter is the primitive's coverage rect (`QuadPrimitive.bounds`), so\nthe pattern rect was constraining where anti-aliasing is applied.\n\nThe intersection is inert today: `create_quad_primitive` rounds `bounds` to\nthe device grid but deliberately captures `pattern_rect` before rounding, so\n`bounds` can exceed `pattern_rect` by up to half a pixel, but only on the\nedges selected by `round_edges = !aa_flags` - and `edge_no_aa_offset` pushes\nthose edges out by 10 units anyway. No behavior change; this removes the\ndependency so the pattern rect can be moved independently of coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316289\n", "files": ["gfx/wr/webrender/res/ps_quad.glsl"], "git_node": "7db1111dcd9097b39df4af7da55fa3efa3e40cb0", "git_parents": ["f5ae18b4c1525c7974e0311a10d4fac46789f55b"], "node": "c2399a55c52ca03b1d68f2cc702fc5e54af09e98", "parents": ["d3742f981a5fcf4dcdac2b9148bad18cc4d8761a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Rename the quad shaders' PrimitiveInfo rect fields to pattern_rect/bounds. r=gw\n\nThe quad GPU representation already carries a coverage rect (bounds) and a\nrect that situates the pattern (pattern_rect); only the PrimitiveInfo field\nnames still used the old local_prim_rect/local_clip_rect vocabulary. Pure\nrename, no behavior change.\n\nThe PrimitiveHeader path (prim_shared.glsl, ps_text_run.glsl) is untouched;\nit is still on the old representation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316290\n", "files": ["gfx/wr/webrender/res/ps_quad.glsl", "gfx/wr/webrender/res/ps_quad_backdrop.glsl", "gfx/wr/webrender/res/ps_quad_blend.glsl", "gfx/wr/webrender/res/ps_quad_box_shadow.glsl", "gfx/wr/webrender/res/ps_quad_mask.glsl", "gfx/wr/webrender/res/ps_quad_mix_blend.glsl", "gfx/wr/webrender/res/ps_quad_repeat.glsl", "gfx/wr/webrender/res/ps_quad_textured.glsl", "gfx/wr/webrender/res/ps_quad_yuv.glsl"], "git_node": "a55e12a142bcc6c471731df302100639f5b865a9", "git_parents": ["7db1111dcd9097b39df4af7da55fa3efa3e40cb0"], "node": "90ebd499ae8a0be46d8a133c8bafa8ae871c973e", "parents": ["c2399a55c52ca03b1d68f2cc702fc5e54af09e98"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Surface the primitive's coverage rect on ClipChainInstance. r=gw\n\n`build_clip_chain_instance` already computes the primitive's coverage rect as\n`local_bounding_rect` (its extent intersected with the accumulated\naxis-aligned clip), uses it to evaluate the clip nodes and to derive\n`pic_coverage_rect`, and then throws it away. The same rect is reconstructed\nby hand further down the pipeline.\n\nStore it as `local_coverage_rect` and convert the first of those\nreconstructions: `prepare_image_quads`' `tight_clip_rect` was exactly\n`clip_chain.local_clip_rect.intersection(&prim_rect).unwrap()`, with\n`prim_rect` being the snapped prim rect that `get_local_prim_coverage_rect`\nreturns for a non-picture primitive. Dropping the unwrap removes a latent\npanic.\n\n`local_clip_rect` stays: it excludes the primitive's own extent, which is what\ncallers drawing a differently-shaped sub-quad need.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316291\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/image.rs"], "git_node": "e325f8e4a387d8ca279639da1c7a5e478e059433", "git_parents": ["a55e12a142bcc6c471731df302100639f5b865a9"], "node": "a9c9fd6c9beaaf66e9c0b675cc4a18bc153bced3", "parents": ["90ebd499ae8a0be46d8a133c8bafa8ae871c973e"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Make QuadDescriptor's second rect the coverage rect. r=gw\n\n`local_clip_rect` held only the clips that applied to the quad, and\n`prepare_quad_impl` folded the primitive's rect into the coverage on its\nbehalf. Replace it with `bounds`, which each call site fills in with the whole\ncoverage of what it is drawing: the extent, intersected with whatever extra\nclips it knows about.\n\n`prepare_quad_impl` still intersects `desc.local_rect` and the clip chain's\nlocal clip rect, so this commit is a no-op; the point is that every site now\nstates its own coverage, which is what lets the next commit drop the\n`local_rect` term.\n\n`local_rect` keeps its name until it stops affecting coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316292\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/quad.rs"], "git_node": "6639d25b2b6ab87ca369da5e236c9a55998c96a9", "git_parents": ["e325f8e4a387d8ca279639da1c7a5e478e059433"], "node": "365145d4022f9d88405ba5aeefe831e97d996d66", "parents": ["a9c9fd6c9beaaf66e9c0b675cc4a18bc153bced3"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Stop folding the quad's pattern rect into its coverage. r=gw\n\nThis is the point of the series. `prepare_quad_impl` intersected\n`desc.local_rect` - the rect that situates the pattern - into the coverage\nrect, so moving or resizing the pattern changed which pixels the primitive\ncovered. The previous commit made every call site supply its own coverage, so\nthe term can go.\n\nCombining `desc.bounds` with the clip chain's accumulated local clip rect\nstays: that is a clip rect, and leaving it here means a call site that omits\nit still renders correctly rather than escaping its clip.\n\nThe only places where this term was not already redundant are the ones where\nthe pattern rect legitimately extends past the primitive: the stretch path in\n`prepare_repeatable_quad`, which bakes a stretch size larger than the prim\nrect into the pattern rect, and radial gradients, where\n`optimize_radial_gradient` shrinks the prim rect without shrinking the clip\nrect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316293\n", "files": ["gfx/wr/webrender/src/quad.rs"], "git_node": "8e8fb477d07ada1fecf53dcaa7decaf01cefeff5", "git_parents": ["6639d25b2b6ab87ca369da5e236c9a55998c96a9"], "node": "98e421a6d9958b6e23abaf56c6b87f83fe2a038c", "parents": ["365145d4022f9d88405ba5aeefe831e97d996d66"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Bound border and nine-patch segments by the primitive. r=gw\n\nThe segmenting paths built each segment's coverage from the clip chain's bare\nclip rect, so a segment whose rect escapes the primitive was not clipped back\nto it. Compose from `desc.bounds` instead, like the repeated-tile path already\ndoes. That makes the rule for every sub-quad uniform - intersect your extent\ninto the parent's bounds - and drops the need to reach for the clip chain.\n\nOnly reachable through WebRender's own API: `create_border_segments` builds the\ncorner rects from the raw widths (the `overlap` computation exists for widths\nthat exceed the border box) and `NinePatchDescriptor::for_each_segment`\nlikewise, but a CSS border box always contains its widths. Nothing about the\ncached corner texture, the segment cache key or the radius changes - only which\npixels of the segment are painted.\n\nThe two new reftests cover both paths. Neither behavior was pinned before:\nborder-widths-exceed-box spills 3200 pixels outside the border box without\nthis change, and border-image-widths-exceed-box 21192.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316294\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/wrench/reftests/border/border-image-widths-exceed-box-ref.yaml", "gfx/wr/wrench/reftests/border/border-image-widths-exceed-box.yaml", "gfx/wr/wrench/reftests/border/border-widths-exceed-box-ref.yaml", "gfx/wr/wrench/reftests/border/border-widths-exceed-box.yaml", "gfx/wr/wrench/reftests/border/reftest.list"], "git_node": "cdf9180b8bb3713a8751896211c7e833468b7175", "git_parents": ["8e8fb477d07ada1fecf53dcaa7decaf01cefeff5"], "node": "93fa2bd94e8951c8a2a2197bc6a2544f91f5b7cc", "parents": ["98e421a6d9958b6e23abaf56c6b87f83fe2a038c"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Pick AA edge instances based on the quad's coverage. r=gw\n\nWhether a quad is large enough to be worth splitting into anti-aliased edge\nstrips is a question about the area it draws, not about the rect that situates\nits pattern. With the two now separate, read `bounds`.\n\nThis is the last consumer in the quad path that read the pattern rect to make a\ncoverage decision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316295\n", "files": ["gfx/wr/webrender/src/quad.rs"], "git_node": "98f50b52107e577414bfcdc1894d3d97ddb8e830", "git_parents": ["cdf9180b8bb3713a8751896211c7e833468b7175"], "node": "4d6abf28a191dccf89e8b99857dd2231e0ba73fb", "parents": ["93fa2bd94e8951c8a2a2197bc6a2544f91f5b7cc"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Stop bounding repetitions by the pattern rect. r=gw\n\n`image_tiling::repetitions` took the rect that anchors the pattern and used it\nfor two things: its origin as the anchor the repetitions step away from, and its\nextent to bound how many repetitions are emitted, via an intersection with the\nvisible rect. The second is a coverage decision and does not belong to a\npattern rect.\n\nDrop the intersection and let `coverage_rect` be the only rect that bounds the\nresult. Two guards replace what it also happened to do: an empty coverage rect\nreturns no repetitions as before (and keeps dodging the stride asserts), and the\ncounts are clamped at zero for a coverage rect lying entirely before the anchor.\n\nThe callers that were relying on it now say so:\n\n - `prepare_repeatable_quad` needs no change. It already intersects the\n   conservative visible rect with the quad's bounds, which makes the old\n   intersection redundant - it was not on main, where that term was the bare\n   clip rect.\n - `prepare_image_quads`' tiled path passed the conservative visible rect,\n   bounded by nothing, so bound it by the coverage rect. That is tighter than\n   the prim rect it used to be intersected with, which only drops repetitions\n   whose tiles were clipped out anyway. `tiles` keeps the untightened rect so\n   its edge flags are unaffected.\n - The image-mask clip in `clip.rs` bounds the region by the mask rect, which\n   for a repeated mask genuinely is the coverage bound. Its bug 1648323 fallback\n   can leave the visible rect outside the mask rect entirely, and relied on the\n   intersection to produce no repetitions at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316296\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/image_tiling.rs", "gfx/wr/webrender/src/prim_store/image.rs"], "git_node": "83d458bd751223d71d8c400e1d4cd1ba25610b21", "git_parents": ["98f50b52107e577414bfcdc1894d3d97ddb8e830"], "node": "21f31129dfb952b8a1f43af857b1f66ead1a5077", "parents": ["4d6abf28a191dccf89e8b99857dd2231e0ba73fb"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Rename QuadDescriptor::local_rect to pattern_rect. r=gw\n\nNow that it no longer contributes to coverage, every remaining use situates the\npattern: the pattern builder's origin, the stretch size and repetition counts,\nthe nine-patch source slicing, and the rect written to the GPU as the quad's\npattern rect. Rename it, and the local bindings that feed it, to say so.\n\n`adjust_indirect_pattern_resolution` already took the pattern rect under the old\nname; its parameter follows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316297\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/image.rs", "gfx/wr/webrender/src/quad.rs"], "git_node": "fd76992fbba4e70f278fad1e67bff3ca246c2541", "git_parents": ["83d458bd751223d71d8c400e1d4cd1ba25610b21"], "node": "5d2630a951efd549eede2ae019394cd97b53fa78", "parents": ["21f31129dfb952b8a1f43af857b1f66ead1a5077"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Move PrimitiveHeader to the bounds/pattern_rect representation. r=gw\n\nPrimitiveHeader is the last GPU struct on the old representation. Its two\nremaining users are text runs and split composites, and for both the rename\nis exact: local_rect already only situates content (for a text run it is the\nrun anchor, and the shader reads nothing but its origin) while\nlocal_clip_rect is already the only rect that clips.\n\nRenames the Rust struct, PrimitiveHeaderF, and the matching GLSL in\nprim_shared.glsl, ps_text_run.glsl and ps_split_composite.glsl. No behavior\nchange: in particular the text run's bounds deliberately keep no prim-rect\nterm, since glyph ink extends past the authored rect.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316298\n", "files": ["gfx/wr/webrender/res/prim_shared.glsl", "gfx/wr/webrender/res/ps_split_composite.glsl", "gfx/wr/webrender/res/ps_text_run.glsl", "gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/gpu_types.rs"], "git_node": "9c633680d56d35ef71f3d69f225a5cc2b5859fb4", "git_parents": ["fd76992fbba4e70f278fad1e67bff3ca246c2541"], "node": "9bb1f2df5332256ba4909d41bdbeb774f5f77438", "parents": ["5d2630a951efd549eede2ae019394cd97b53fa78"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060286 - Rename the remaining prim-rect-as-pattern fields. r=gw\n\nMechanical follow-up now that the two roles are separate everywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316299\n", "files": ["gfx/wr/webrender/src/batch.rs", "gfx/wr/webrender/src/border.rs", "gfx/wr/webrender/src/box_shadow.rs", "gfx/wr/webrender/src/command_buffer.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/internal_types.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/borders.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/prim_store/text_run.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/visibility.rs"], "git_node": "3424c800416d49325d4dfd6bf45cae949263aefb", "git_parents": ["9c633680d56d35ef71f3d69f225a5cc2b5859fb4"], "node": "38a96b00d2f5e0ff38f91a2ad94b9b5bc381f9ad", "parents": ["9bb1f2df5332256ba4909d41bdbeb774f5f77438"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2057366 - Match target's with their content process. r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313995\n", "files": ["devtools/server/connectors/js-process-actor/DevToolsProcessParent.sys.mjs"], "git_node": "2175a4c97647545061b7a03056f4d22515b06a2c", "git_parents": ["3424c800416d49325d4dfd6bf45cae949263aefb"], "node": "32e9dc84617ace480c67cfa72028918c533d7f5f", "parents": ["38a96b00d2f5e0ff38f91a2ad94b9b5bc381f9ad"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057885 - Give browser_blockingIndexedDb.js enough timeout headroom on coverage builds. r=timhuang\n\nThe test passes under Nova, it just runs out of its timeout on code coverage\nbuilds. browser-chrome arms the timeout once per file rather than per task, so\nrequestLongerTimeout(N) is a whole-file budget of N * 45s, and overrunning it is\nreported as a failure even when every assertion passed.\n\nBug 2051271 dropped this file's requestLongerTimeout(4) and bug 2053008 restored\nonly a factor of 2, while raising the comparable siblings to 5, 7 and 10. That\nleft 90s for a file running two full runTestInNormalAndPrivateMode() passes,\nwhich coverage builds cross once Nova adds its overhead.\n\nRaise the factor to 5, matching browser_blockingSharedWorkers.js which has\nalmost the same runtime, and re-enable the test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316070\n", "files": ["toolkit/components/antitracking/test/browser/browser-blocking.toml", "toolkit/components/antitracking/test/browser/browser_blockingIndexedDb.js"], "git_node": "2cc35aee39bed722b0c8c484228225a7d4dd57bb", "git_parents": ["2175a4c97647545061b7a03056f4d22515b06a2c"], "node": "b9cabaefeaa787c1fe4db27c590ecc67f6b50b69", "parents": ["32e9dc84617ace480c67cfa72028918c533d7f5f"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2060781 - Make the GNU make build system use stdint.h and inttypes.h on Windows. r=sylvestre\n\nIt's currently limited to MINGW, but MSVC has had those headers for a\nwhile. Switching to clang 22 causes a build failure with the alternative\ncode path, so this preventively fixes it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316487\n", "files": ["taskcluster/scripts/misc/build-mozmake.sh"], "git_node": "af5513e31ca8d5bfa92216ee17ae9531fb585a28", "git_parents": ["2cc35aee39bed722b0c8c484228225a7d4dd57bb"], "node": "942f73042b8cb5da057eb0b331a9541c0521dd81", "parents": ["b9cabaefeaa787c1fe4db27c590ecc67f6b50b69"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060039 - Pass a WindowContext rather than a BrowsingContext around for remote printing. r=nika,Jamie,geckoview-reviewers,win-reviewers,gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315886\n", "files": ["accessible/base/DocManager.cpp", "accessible/docs/TaggedPdfOutput.md", "accessible/ipc/DocAccessibleParent.cpp", "accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/pdf/PdfStructTreeBuilder.h", "gfx/2d/2D.h", "gfx/2d/DrawTargetRecording.cpp", "gfx/2d/DrawTargetRecording.h", "gfx/2d/DrawTargetSkia.cpp", "gfx/2d/DrawTargetSkia.h", "gfx/2d/RecordedEventImpl.h", "gfx/src/nsDeviceContext.cpp", "gfx/src/nsDeviceContext.h", "gfx/thebes/PrintTarget.h", "gfx/thebes/PrintTargetCG.h", "gfx/thebes/PrintTargetCG.mm", "gfx/thebes/PrintTargetSkPDF.cpp", "gfx/thebes/PrintTargetSkPDF.h", "gfx/thebes/PrintTargetThebes.cpp", "gfx/thebes/PrintTargetThebes.h", "gfx/thebes/PrintTargetWindows.cpp", "gfx/thebes/PrintTargetWindows.h", "layout/generic/nsIFrame.cpp", "layout/painting/nsDisplayList.cpp", "layout/painting/nsDisplayList.h", "layout/printing/ipc/PRemotePrintJob.ipdl", "layout/printing/ipc/RemotePrintJobChild.cpp", "layout/printing/ipc/RemotePrintJobChild.h", "layout/printing/ipc/RemotePrintJobParent.cpp", "layout/printing/ipc/RemotePrintJobParent.h", "layout/printing/nsPrintJob.cpp", "widget/android/nsDeviceContextAndroid.cpp", "widget/android/nsDeviceContextAndroid.h", "widget/cocoa/nsDeviceContextSpecX.h", "widget/cocoa/nsDeviceContextSpecX.mm", "widget/gtk/nsDeviceContextSpecG.cpp", "widget/gtk/nsDeviceContextSpecG.h", "widget/nsDeviceContextSpecProxy.cpp", "widget/nsDeviceContextSpecProxy.h", "widget/nsIDeviceContextSpec.h", "widget/windows/nsDeviceContextSpecWin.h"], "git_node": "3c49a93e08532dbccca25d0f94419f061551c7de", "git_parents": ["af5513e31ca8d5bfa92216ee17ae9531fb585a28"], "node": "924495f3ebae765cf726c43d2e05fa0ed530b61b", "parents": ["942f73042b8cb5da057eb0b331a9541c0521dd81"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054403 - Only register the WebRender capture shortcuts when captures are enabled. r=firefox-desktop-core-reviewers ,Gijs\n\nThe key elements bound to wrCaptureCmd and wrToggleCaptureSequenceCmd were\nalways in the document. ShortcutUtils.isSystem only looks for a matching key\nelement, so Ctrl+Shift+3 and Ctrl+Shift+6 counted as Firefox shortcuts and could\nnot be assigned to WebExtension commands on macOS, even though the commands they\nare bound to do nothing unless gfx.webrender.debug.enable-capture is set (which\nonly happens in builds configured with --enable-webrender-debugger). The key\nhandler also swallowed the key events before finding out that the command is\ndisabled.\n\nRegister the keys dynamically when captures are enabled instead. They need their\nown keyset because a keyset's handlers are built when it is inserted into the\ndocument.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314601\n", "files": ["browser/base/content/browser-graphics-utils.js", "browser/base/content/browser-sets.inc.xhtml", "browser/base/content/test/keyboard/browser.toml", "browser/base/content/test/keyboard/browser_gfxDebugShortcuts.js"], "git_node": "04f509798db049429d2f45a02e0a1439d536530a", "git_parents": ["3c49a93e08532dbccca25d0f94419f061551c7de"], "node": "ed6d39d4e130a2053ec3d42440a3a83a77ec470b", "parents": ["924495f3ebae765cf726c43d2e05fa0ed530b61b"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2039416 - Update builders to rustc 1.95. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310745\n", "files": ["build/build-rust/Zprofile.patch", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/rust.yml"], "git_node": "7ad170b516de70551779e80d27ec840f70386406", "git_parents": ["04f509798db049429d2f45a02e0a1439d536530a"], "node": "7ddc9f03b94e91faf48bbba434670d6d0d303343", "parents": ["ed6d39d4e130a2053ec3d42440a3a83a77ec470b"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1977771 - Update builders to clang 22. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310746\n", "files": ["build/build-clang/clang-tidy.json", "build/moz.configure/compile-checks.configure", "taskcluster/kinds/toolchain/clang-tidy.yml", "taskcluster/kinds/toolchain/clang.yml", "tools/clang-tidy/config.yaml"], "git_node": "3f6b989a6b866ec8bb982ecadd1eb573ba78264b", "git_parents": ["7ad170b516de70551779e80d27ec840f70386406"], "node": "6899dba6082aba8865e8b40c7b7df65dfca39b34", "parents": ["7ddc9f03b94e91faf48bbba434670d6d0d303343"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060612 - Wait for the render backend pool threads to exit at shutdown. r=gfx-reviewers,lsalzman\n\nNow that the profiler hooks are installed before the pool spawns its threads,\nthose threads register with the Gecko profiler, and ThreadRegistry::Register\nlazily creates an nsThread wrapper for them that is only released when the\nthread exits. Nothing waited for the pool's threads, so they could still be\nwinding down when XPCOM writes its leak log, which showed up as an intermittent\nleaked nsThread (and its Mutex) in the GPU process.\n\nKeep the threads' join handles and wait for them to exit when the pool is\ndropped. The pool's own channel clones have to be dropped before joining: the\nscene builder's SceneBuilderResult::ShutDown is consumed by the render backend's\nmain loop, so the backend's drain loop only ends once every api_tx clone is gone\nand recv() fails.\n\nAlso destroy the pool explicitly from RenderThread::ShutDown rather than\nrelying on the RenderThread destructor: the destructor runs after sRenderThread\nhas been cleared, so callbacks made by a draining backend thread could no\nlonger find the render thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316311\n", "files": ["gfx/webrender_bindings/RenderThread.cpp", "gfx/webrender_bindings/RenderThread.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/render_backend_pool.rs"], "git_node": "2eab5d639ce56b13d276310a4f79aee7e100826d", "git_parents": ["3f6b989a6b866ec8bb982ecadd1eb573ba78264b"], "node": "8cd0faaa79cf7b771fae010ea853ea4658e34ea1", "parents": ["6899dba6082aba8865e8b40c7b7df65dfca39b34"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1977771, Bug 2039416 - Update builders to clang 22. r=firefox-build-system-reviewers,sergesanspaille\" for causing toolchain failures.\n\nThis reverts commit 3f6b989a6b866ec8bb982ecadd1eb573ba78264b.\n\nRevert \"Bug 2039416 - Update builders to rustc 1.95. r=firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit 7ad170b516de70551779e80d27ec840f70386406.\n", "files": ["build/build-clang/clang-tidy.json", "build/build-rust/Zprofile.patch", "build/moz.configure/compile-checks.configure", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/clang-tidy.yml", "taskcluster/kinds/toolchain/clang.yml", "taskcluster/kinds/toolchain/rust.yml", "tools/clang-tidy/config.yaml"], "git_node": "d77a7079309c62539ac45cf6ec322bd42cb09714", "git_parents": ["2eab5d639ce56b13d276310a4f79aee7e100826d"], "node": "651119cf902000ed7194b7bbc332d219c85915f3", "parents": ["8cd0faaa79cf7b771fae010ea853ea4658e34ea1"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044636 - Route MediaCapabilities WebRTC and encode paths through async codec support. r=media-playback-reviewers,webrtc-reviewers,bwc,padenot\" for causing build bustages @TestWebrtcCodecFactory.cpp.\n\nThis reverts commit f57a88af44ba8e36337758b1b7162e9cd33cafd1.\n", "files": ["dom/media/gtest/TestWebRTCCodecInfo.cpp", "dom/media/ipc/RemoteEncoderModule.cpp", "dom/media/ipc/RemoteEncoderModule.h", "dom/media/mediacapabilities/MediaCapabilities.cpp", "dom/media/platforms/PEMFactory.cpp", "dom/media/platforms/PEMFactory.h", "dom/media/platforms/PlatformEncoderModule.h", "dom/media/webrtc/CodecInfo.cpp", "dom/media/webrtc/CodecInfo.h", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.cpp", "dom/media/webrtc/libwebrtcglue/MediaDataCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataDecoderCodec.h", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcVideoCodecFactory.h"], "git_node": "da654e92f196e3e1faea42213569d4452485503a", "git_parents": ["d77a7079309c62539ac45cf6ec322bd42cb09714"], "node": "d61c435f29c06c43430c0669f8065762e8609fe5", "parents": ["651119cf902000ed7194b7bbc332d219c85915f3"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 1: Remove the cookie banner handling UI from the protections panel and preferences. r=desktop-theme-reviewers,mstriemer,chutten,timhuang\n\nRemoves the Cookie Banner Blocker section and subview from the protections\npanel, its CSS, its Fluent strings, and the two about:preferences pref\nregistrations. The preferences.ftl strings and the privacy.mjs registrations\nwere already orphaned; the prefs UI row was removed in an earlier bug.\n\nAlso removes the two protections-popup Glean events that only the deleted\ntoggle recorded, together with their Legacy Telemetry mirror objects.\n\nDrive-by: browser_privacy_gpc.js had a copy-pasted header comment claiming it\ntests the cookie banner UI; it tests Global Privacy Control.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314665\n", "files": ["browser/base/content/browser-siteProtections.js", "browser/base/content/metrics.yaml", "browser/base/content/test/protectionsUI/browser.toml", "browser/base/content/test/protectionsUI/browser_protectionsUI_cookie_banner.js", "browser/components/controlcenter/content/protectionsPanel.inc.xhtml", "browser/components/preferences/config/privacy.mjs", "browser/components/preferences/tests/browser_bug795764_cachedisabled.js", "browser/components/preferences/tests/searchResults/browser_search_subdialogs_within_preferences_site_data.js", "browser/components/preferences/tests/searchResults/browser_search_subdialogs_within_preferences_site_data_xul.js", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/locales/en-US/browser/protectionsPanel.ftl", "browser/themes/shared/controlcenter/panel.css", "toolkit/components/telemetry/Events.yaml"], "git_node": "0d3c11d148afac5c13cea446bb575e1694b10173", "git_parents": ["da654e92f196e3e1faea42213569d4452485503a"], "node": "be18d5a0fb0392126514dff81e9b41f2a44238ca", "parents": ["d61c435f29c06c43430c0669f8065762e8609fe5"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 2: Remove the cookie banner messaging surfaces and private browsing promo. r=omc-reviewers,desktop-theme-reviewers,joel,mstriemer,emcminn\n\nRemoves the cookieBannerDetected and cookieBannerHandled triggers, the cookie\nbanner feature callout, the about:privatebrowsing promo and its asset, the\nCOOKIE_BANNERS promo type, and the three cookiebanners.* entries from the\nSET_PREF allow-list.\n\nNotes for reviewers:\n\n- BrowserUtils.PromoType keeps a gap at 5 rather than renumbering, matching the\n  existing vacancy at 3. The values cross the parent/content boundary, so\n  renumbering would be a silent behaviour change.\n- PB_NEWTAB_COOKIE_BANNERS_PROMO was the only type: \"default\" pb_newtab\n  message, so about:privatebrowsing now renders without a default promo. That\n  is intended.\n- browser_privatebrowsing_about_default_promo.js and _nimbus_dismiss.js were\n  rewritten rather than deleted, to preserve the only coverage of\n  handlePromoOnPreload() cross-tab dismissal and the deferred message load path.\n- shouldShowPromo() still throws on an unrecognised promo type, so a stale\n  enrolled message naming COOKIE_BANNERS would reject the ShouldShowPromo\n  query. This hazard pre-exists: the schemas also permit \"OTHER\", which is\n  likewise absent from PromoType. Left alone to keep this patch a removal.\n- test_shouldShowCookieBannersPromo was the only coverage of\n  showForEnterprise: true, which is now untested.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314666\n", "files": ["browser/components/aboutwelcome/tests/unit/unit-entry.js", "browser/components/asrouter/content-src/schemas/MessagingExperiment.schema.json", "browser/components/asrouter/content-src/templates/PBNewtab/NewtabPromoMessage.schema.json", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterTriggerListeners.sys.mjs", "browser/components/asrouter/modules/FeatureCalloutMessages.sys.mjs", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_trigger_listeners.js", "browser/components/asrouter/tests/unit/ASRouterTriggerListeners.test.js", "browser/components/asrouter/tests/unit/unit-entry.js", "browser/components/privatebrowsing/content/assets/cookie-banners-begone.svg", "browser/components/privatebrowsing/test/browser/browser.toml", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_cookie_banners_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_default_promo.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_nimbus_dismiss.js", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_about_nova_promo.js", "browser/extensions/newtab/test/unit/unit-entry.js", "browser/locales/en-US/browser/aboutPrivateBrowsing.ftl", "browser/locales/en-US/browser/newtab/asrouter.ftl", "browser/themes/shared/controlcenter/3rdpartycookies-blocked.svg", "browser/themes/shared/jar.inc.mn", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/TriggerActionSchemas.json", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/index.md", "toolkit/modules/BrowserUtils.sys.mjs", "toolkit/modules/tests/xpcshell/test_BrowserUtils.js"], "git_node": "4d394fd5bdb4a3ebffbebb8541a6fda7da1dbd1c", "git_parents": ["0d3c11d148afac5c13cea446bb575e1694b10173"], "node": "683b157a9893daa598fbac933544c59a5433f7ef", "parents": ["be18d5a0fb0392126514dff81e9b41f2a44238ca"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 3: Remove the cookie banner handling UI from Fenix. r=android-reviewers,android-l10n-reviewers,parker,gl\n\nRemoves the Cookie Banner Blocker preference, its settings-search entry, the\nNimbus cookie-banners feature and its Glean metric, and the stale exposure\nrecord left in BrowserFragment.\n\nThe DataStore cleanup migration added in bug 2053618 is kept and now uses the\nliteral file name, because the android-components class it imported the name\nfrom is removed in Part 5. Dropping it would strand an orphaned preferences\nfile on every existing install.\n\nThe now-unused string is deleted outright, per\nhttps://firefox-source-docs.mozilla.org/mobile/android/fenix/Working-with-Strings.html#removing-unused-strings\nandroid-l10n imports strings per branch, so removing them on main is safe.\n\nAlso removes the cookie-banners entry from the checked-in experimenter\nmanifest, and the Cookie Banner Blocker assertion in SettingsPrivacyTest,\nwhich would otherwise fail now the row is gone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314667\n", "files": ["mobile/android/fenix/app/.experimenter.yaml", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/experimentintegration/variables.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CookieBannerBlockerTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsPrivacyTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/BrowserRobot.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/gecko/GeckoProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/cookiebannerhandling/CustomCBHSwitchPreference.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/settingssearch/DefaultFenixSettingsIndexer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/main/res/xml/preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "b8e655f8389c49604b8fa0cec28459bd25e9a7c4", "git_parents": ["4d394fd5bdb4a3ebffbebb8541a6fda7da1dbd1c"], "node": "d95f24e8a0838b111dbb490d967912e50d936e2d", "parents": ["683b157a9893daa598fbac933544c59a5433f7ef"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 4: Remove the cookie banner reducer from Focus. r=android-reviewers,android-l10n-reviewers,parker,gl\n\nRemoves the cookie banner settings screen, the reducer store and its details\npanel, the toolbar CFR, the AppState/AppAction/AppReducer plumbing, the SUMO\ntopic and the Glean metrics and cookie-banner-report-site ping.\n\nAdds a one-time migration deleting the report_site_domains_preferences\nDataStore and the five obsolete cookie banner preference keys, mirroring the\nequivalent Fenix cleanup. Focus previously had no such cleanup.\n\nThe now-unused strings are deleted outright, per\nhttps://firefox-source-docs.mozilla.org/mobile/android/fenix/Working-with-Strings.html#removing-unused-strings\nandroid-l10n imports strings per branch, so removing them on main is safe.\nNote mobile/android/focus-android/docs/Removing-strings.md still documents the\nolder moz:removedIn process and is stale; filed separately.\n\nReviewer note: removing the cookie_banner_exception ComposeView from\ndialog_tracking_protection_sheet.xml re-anchors enhanced_tracking to\nsecurity_info. The removed view carried a 28dp top margin, so the gap above\nthe ETP switch is now the layout's usual 16dp. This inflates cleanly, so\nplease sanity-check the panel spacing visually.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314668\n", "files": ["mobile/android/focus-android/app/.experimenter.yaml", "mobile/android/focus-android/app/build.gradle", "mobile/android/focus-android/app/legacy_metrics.yaml", "mobile/android/focus-android/app/legacy_pings.yaml", "mobile/android/focus-android/app/nimbus.fml.yaml", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/CustomTabTest.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/helpers/FeatureSettingsHelper.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/helpers/MainActivityTestRule.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/Components.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/FocusApplication.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserToolbarIntegration.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cfr/CfrMiddleware.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/components/EngineProvider.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebanner/CookieBannerFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebanner/CookieBannerOption.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebanner/CookieBannerRejectAllPreference.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebannerreducer/CookieBannerExceptionDetailsSwitch.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebannerreducer/CookieBannerReducerDetailsPanel.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebannerreducer/CookieBannerReducerItem.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebannerreducer/CookieBannerReducerMiddleware.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebannerreducer/CookieBannerReducerStatus.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebannerreducer/CookieBannerReducerStore.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/cookiebannerreducer/DefaultCookieBannerReducerInteractor.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/settings/privacy/PrivacySecuritySettingsFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/settings/privacy/TrackingProtectionPanel.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/state/AppAction.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/state/AppReducer.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/state/AppState.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/ui/theme/FocusTypography.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/utils/Settings.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/utils/SupportUtils.kt", "mobile/android/focus-android/app/src/main/res/layout/cookie_banner_reducer_details.xml", "mobile/android/focus-android/app/src/main/res/layout/dialog_tracking_protection_sheet.xml", "mobile/android/focus-android/app/src/main/res/values-night/colors.xml", "mobile/android/focus-android/app/src/main/res/values/colors.xml", "mobile/android/focus-android/app/src/main/res/values/preference_keys.xml", "mobile/android/focus-android/app/src/main/res/values/strings.xml", "mobile/android/focus-android/app/src/main/res/xml/cookie_banner_settings.xml", "mobile/android/focus-android/app/src/main/res/xml/privacy_security_settings.xml", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/cfr/CfrMiddlewareTest.kt"], "git_node": "5715ac69dc65a1b96c4b8cad378284bd9661e2f8", "git_parents": ["b8e655f8389c49604b8fa0cec28459bd25e9a7c4"], "node": "fc35b7885d193452bd59679b348120e962572512", "parents": ["d95f24e8a0838b111dbb490d967912e50d936e2d"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 5: Remove the cookie banner handling API from android-components. r=android-reviewers,gl\n\nRemoves the concept-engine cookiehandling package, GeckoCookieBannersStorage,\nReportSiteDomainsRepository, the CookieBannerHandlingMode and\nCookieBannerHandlingStatus enums, EngineSession.hasCookieBannerRuleForSession,\nthe Settings.cookieBannerHandling* settings, CookieBannerAction and\nSessionState.cookieBanner.\n\nThis is a breaking change for the published components; there is no\nreplacement API.\n\nFakeEngineSession in Fenix is updated in this commit rather than Part 3\nbecause hasCookieBannerRuleForSession is abstract: removing either the member\nor its override alone fails to compile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314670\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/build.gradle", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngine.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/cookiebanners/GeckoCookieBannersStorage.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/cookiebanners/ReportSiteDomainsRepository.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/ext/TrackingProtectionPolicy.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineTest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/cookiebanners/GeckoCookieBannersStorageTest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/cookiebanners/ReportSiteDomainsRepositoryTest.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/ext/TrackingProtectionPolicyKtTest.kt", "mobile/android/android-components/components/browser/engine-system/src/main/java/mozilla/components/browser/engine/system/SystemEngineSession.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/action/BrowserAction.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/engine/EngineObserver.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/BrowserStateReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/reducer/CookieBannerStateReducer.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/CustomTabSessionState.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/SessionState.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/TabSessionState.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/action/CookieBannerActionTest.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/engine/EngineObserverTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/EngineSession.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/Settings.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/cookiehandling/CookieBannersStorage.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/EngineSessionTest.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/SettingsTest.kt", "mobile/android/android-components/components/support/test-fakes/src/main/java/mozilla/components/support/test/fakes/engine/TestEngineSession.kt", "mobile/android/android-components/config/detekt-baseline.xml", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/fake/FakeEngineSession.kt"], "git_node": "3c57b6d1a48256af5667166c08695a50415d0b12", "git_parents": ["5715ac69dc65a1b96c4b8cad378284bd9661e2f8"], "node": "cc97128e262d1f245224b68064ebcc8f66f5c0f0", "parents": ["fc35b7885d193452bd59679b348120e962572512"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 6: Remove the cookie banner handling API from GeckoView. r=geckoview-reviewers,android-reviewers,owlish\n\nRemoves ContentBlocking.CookieBannerMode and CBCookieBannerMode, the\nContentBlocking.Settings cookie banner getters, setters and builder methods,\nGeckoSession.ContentDelegate.onCookieBannerDetected and onCookieBannerHandled,\nGeckoSession.hasCookieBannerRuleForBrowsingContextTree, and the four\nStorageController cookie banner domain methods, along with the JS side that\nserviced them.\n\nThis is an outright removal with no prior deprecation and no replacement, as\nthe underlying Gecko feature is being deleted. Embedders using these APIs will\nneed to drop the calls.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314671\n", "files": ["mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/background.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-api.js", "mobile/android/geckoview/src/androidTest/assets/web_extensions/test-support/test-schema.json", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/BaseSessionTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentBlockingControllerTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ContentDelegateTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoSessionTestRuleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/StorageControllerTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/rule/GeckoSessionTestRule.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/ContentBlocking.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/StorageController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/GeckoViewActivity.java", "mobile/android/geckoview_example/src/main/res/values/strings.xml", "mobile/android/geckoview_example/src/main/res/xml/settings.xml", "mobile/ios/GeckoTestBrowser/GeckoTestBrowser/UI/RootViewController.swift", "mobile/ios/GeckoTestBrowser/GeckoView/ContentDelegate.swift", "mobile/shared/components/geckoview/GeckoViewStartup.sys.mjs", "mobile/shared/modules/geckoview/GeckoViewContent.sys.mjs", "mobile/shared/modules/geckoview/GeckoViewStorageController.sys.mjs"], "git_node": "1d0c7918b466171878b8a1e1a09699bca1b3231f", "git_parents": ["3c57b6d1a48256af5667166c08695a50415d0b12"], "node": "80a5f5790ceefc9697a31e4a997700bff04dc885", "parents": ["cc97128e262d1f245224b68064ebcc8f66f5c0f0"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 7: Remove the cookie banner clear-data integration. r=timhuang\n\nRemoves CLEAR_COOKIE_BANNER_EXCEPTION and CLEAR_COOKIE_BANNER_EXECUTED_RECORD,\ntheir two cleaners, and their use from the Clear-Site-Data header path,\nSanitizer and SiteDataTestUtils.\n\nBits 26 and 27 are left as permanent holes rather than renumbering the\nremaining flags, following the precedent of bug 2006028, which removed\nCLEAR_PREDICTOR_NETWORK_DATA and left bit 8 vacant. Renumbering would silently\nchange the meaning of flag values held by out-of-tree callers. The interface\nuuid is likewise not revved, matching that precedent.\n\nAll JS consumers land here with the IDL change: in JS, `x | undefined`\nevaluates to `x`, so a stale reference would silently become a no-op rather\nthan throwing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314672\n", "files": ["browser/modules/Sanitizer.sys.mjs", "toolkit/components/cleardata/ClearDataService.sys.mjs", "toolkit/components/cleardata/SiteDataTestUtils.sys.mjs", "toolkit/components/cleardata/nsIClearDataService.idl", "toolkit/components/cleardata/tests/unit/test_cookie_banner_handling.js", "toolkit/components/cleardata/tests/unit/xpcshell.toml", "toolkit/components/clearsitedata/ClearSiteData.cpp"], "git_node": "fa5f9508217e306a1ab625fac100d6d066cba30c", "git_parents": ["1d0c7918b466171878b8a1e1a09699bca1b3231f"], "node": "c3b49c86ffa08c7a295b2640edf6f0a355e43593", "parents": ["80a5f5790ceefc9697a31e4a997700bff04dc885"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 8: Remove the cookie banner handling implementation. r=necko-reviewers,ipc-reviewers,frontend-codestyle-reviewers,chutten,kershaw,mossop,timhuang\n\nDeletes toolkit/components/cookiebanners and everything that reached into it:\nthe static and runtime prefs, the JSWindowActor registration, the\nnsILoadInfo.hasInjectedCookieForCookieBannerHandling plumbing and its IPC\nserialization, the Glean and Legacy Telemetry registrations, the Nimbus\nfeature, and the shipped cookie-banner-rules-list Remote Settings dump.\n\nNotes for reviewers:\n\n- Removing the cookiebanners pref group from modules/libpref/moz.build and the\n  StaticPrefList.yaml block must happen together; a mismatch fails at build\n  time rather than lint time.\n- Deleting the local dump does not decommission the main/cookie-banner-rules-list\n  Remote Settings collection. ESR and older clients still sync it live, so the\n  server-side collection needs to outlive them and be retired separately.\n- docs/overview/gecko.md used nsCookieBannerService purely as its worked\n  example of XPCOM component instantiation; the diagram is kept with a service\n  that still exists.\n- Recorded perf pages will now show cookie banners, since hooks_recording.py no\n  longer sets the dismissal prefs. Worth a follow-up if that shifts baselines.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314673\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/test/performance/browser_startup_content.js", "browser/base/content/test/performance/browser_startup_content_subframe.js", "docs/_addons/etp_matrix.py", "docs/overview/gecko.md", "eslint-rollouts.config.mjs", "ipc/glue/BackgroundUtils.cpp", "modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js", "modules/libpref/moz.build", "netwerk/base/LoadInfo.h", "netwerk/base/nsILoadInfo.idl", "netwerk/ipc/NeckoChannelParams.ipdlh", "services/settings/dumps/main/cookie-banner-rules-list.json", "services/settings/dumps/main/moz.build", "testing/performance/hooks_recording.py", "toolkit/components/cookiebanners/CookieBannerChild.sys.mjs", "toolkit/components/cookiebanners/CookieBannerDomainPrefService.cpp", "toolkit/components/cookiebanners/CookieBannerDomainPrefService.h", "toolkit/components/cookiebanners/CookieBannerListService.sys.mjs", "toolkit/components/cookiebanners/CookieBannerParent.sys.mjs", "toolkit/components/cookiebanners/components.conf", "toolkit/components/cookiebanners/jar.mn", "toolkit/components/cookiebanners/metrics.yaml", "toolkit/components/cookiebanners/moz.build", "toolkit/components/cookiebanners/nsClickRule.cpp", "toolkit/components/cookiebanners/nsClickRule.h", "toolkit/components/cookiebanners/nsCookieBannerRule.cpp", "toolkit/components/cookiebanners/nsCookieBannerRule.h", "toolkit/components/cookiebanners/nsCookieBannerService.cpp", "toolkit/components/cookiebanners/nsCookieBannerService.h", "toolkit/components/cookiebanners/nsCookieInjector.cpp", "toolkit/components/cookiebanners/nsCookieInjector.h", "toolkit/components/cookiebanners/nsCookieRule.cpp", "toolkit/components/cookiebanners/nsCookieRule.h", "toolkit/components/cookiebanners/nsIClickRule.idl", "toolkit/components/cookiebanners/nsICookieBannerListService.idl", "toolkit/components/cookiebanners/nsICookieBannerRule.idl", "toolkit/components/cookiebanners/nsICookieBannerService.idl", "toolkit/components/cookiebanners/nsICookieRule.idl", "toolkit/components/cookiebanners/schema/CookieBannerRule.schema.json", "toolkit/components/cookiebanners/schema/CookieBannerRuleUI.schema.json", "toolkit/components/cookiebanners/schema/README", "toolkit/components/cookiebanners/test/browser/browser.toml", "toolkit/components/cookiebanners/test/browser/browser_bannerClicking.js", "toolkit/components/cookiebanners/test/browser/browser_bannerClicking_domainPref.js", "toolkit/components/cookiebanners/test/browser/browser_bannerClicking_events.js", "toolkit/components/cookiebanners/test/browser/browser_bannerClicking_globalRules.js", "toolkit/components/cookiebanners/test/browser/browser_bannerClicking_runContext.js", "toolkit/components/cookiebanners/test/browser/browser_bannerClicking_slowLoad.js", "toolkit/components/cookiebanners/test/browser/browser_bannerClicking_stopExecuteAfterSeveralAttempt.js", "toolkit/components/cookiebanners/test/browser/browser_bannerClicking_visibilityOverride.js", "toolkit/components/cookiebanners/test/browser/browser_cookiebanner_telemetry.js", "toolkit/components/cookiebanners/test/browser/browser_cookiebanner_webconsole.js", "toolkit/components/cookiebanners/test/browser/browser_cookiebannerservice.js", "toolkit/components/cookiebanners/test/browser/browser_cookiebannerservice_domainPrefs.js", "toolkit/components/cookiebanners/test/browser/browser_cookiebannerservice_getRules.js", "toolkit/components/cookiebanners/test/browser/browser_cookiebannerservice_hasRuleForBCTree.js", "toolkit/components/cookiebanners/test/browser/browser_cookiebannerservice_prefs.js", "toolkit/components/cookiebanners/test/browser/browser_cookieinjector.js", "toolkit/components/cookiebanners/test/browser/browser_cookieinjector_events.js", "toolkit/components/cookiebanners/test/browser/file_banner.html", "toolkit/components/cookiebanners/test/browser/file_banner_b.html", "toolkit/components/cookiebanners/test/browser/file_banner_invisible.html", "toolkit/components/cookiebanners/test/browser/file_delayed_banner.html", "toolkit/components/cookiebanners/test/browser/file_delayed_banner_load.html", "toolkit/components/cookiebanners/test/browser/head.js", "toolkit/components/cookiebanners/test/browser/slowSubresource.sjs", "toolkit/components/cookiebanners/test/browser/testCookieHeader.sjs", "toolkit/components/cookiebanners/test/unit/test_cookiebannerlistservice.js", "toolkit/components/cookiebanners/test/unit/xpcshell.toml", "toolkit/components/glean/metrics_index.py", "toolkit/components/moz.build", "toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/components/telemetry/Scalars.yaml", "toolkit/locales/en-US/toolkit/global/cookieBannerHandling.ftl", "toolkit/modules/ActorManagerParent.sys.mjs", "tools/lint/eslint/eslint-plugin-mozilla/lib/services.json"], "git_node": "2213eda366ff56e4584d1372a4b975b8cbb2d101", "git_parents": ["fa5f9508217e306a1ab625fac100d6d066cba30c"], "node": "dfc9e3c70dcaea5eb9ea6bd8f400ea528ca4e105", "parents": ["c3b49c86ffa08c7a295b2640edf6f0a355e43593"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 9: Report content pref connection failures through the callback. r=timhuang\n\nContentPrefService2._execStmts awaited the database connection outside its\ntry/catch. Callers such as removeByName() do not consume the promise it\nreturns, so a connection failure surfaced as an unhandled rejection instead of\nreaching onError/onDone.\n\nPart 10 calls removeByName() from a synchronous profile data migration, which\nopens the database late enough that the connection can be closed before the\nremoval lands. Without this, every xpcshell test that runs the migrations fails\nwith \"uncaught rejection: Connection is not open.\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314674\n", "files": ["toolkit/components/contentprefs/ContentPrefService2.sys.mjs"], "git_node": "79573d367476b2a5fcbafcd56716c552ec78e8ac", "git_parents": ["2213eda366ff56e4584d1372a4b975b8cbb2d101"], "node": "3104e346936b5f7eb763fe24b540d25325cacc85", "parents": ["dfc9e3c70dcaea5eb9ea6bd8f400ea528ca4e105"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058143 - Part 10: Clear cookie banner data from existing profiles. r=firefox-desktop-core-reviewers ,mossop,timhuang\n\nPer-site cookie banner exceptions were stored as content prefs under the names\n\"cookiebanner\" and \"cookiebannerprivate\". The private one was persisted to disk\nwhenever a domain pref was set with persistInPrivateBrowsing, so both need\nclearing. Nothing removes them once the feature is gone, so they would sit in\ncontent-prefs.sqlite indefinitely.\n\nAdds profile data version 179, removing both content pref names across all\ndomains and clearing any user values left under the cookiebanners. and\nbrowser.promo.cookiebanners. branches, whose defaults no longer exist.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314675\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/ProfileDataUpgrader.sys.mjs", "browser/components/tests/unit/test_profileDataUpgrade_cookieBannerData.js", "browser/components/tests/unit/xpcshell.toml"], "git_node": "17202d7987df5100eb4e9ad34b7cfc887535e091", "git_parents": ["79573d367476b2a5fcbafcd56716c552ec78e8ac"], "node": "ef1cf3521be3198e75360ebc50e675771256b3a3", "parents": ["3104e346936b5f7eb763fe24b540d25325cacc85"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060504 - Close a ContentPrefService2 connection that is still opening when Sqlite shutdown begins. r=firefox-desktop-core-reviewers ,mak\n\nThe Sqlite.shutdown blocker was added only after openConnection() resolved, so a\nconnection still opening when the barrier passed was never covered by it and\ncould outlive shutdown, crashing with \"Storage connection not closed:\ncontent-prefs.sqlite\". Register it in the conn getter instead, before opening.\n\nFound via bug 2058143 part 10, which calls removeByName() from the synchronous\nprofile data migration; an xpcshell test that starts one and then exits loses\nthe race.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316247\n", "files": ["toolkit/components/contentprefs/ContentPrefService2.sys.mjs"], "git_node": "67a2fce136c2a2f72d3c169cc8c816c9ad3d2c39", "git_parents": ["17202d7987df5100eb4e9ad34b7cfc887535e091"], "node": "1c973847d361237b098dfeab440bcb53cb2a7f52", "parents": ["ef1cf3521be3198e75360ebc50e675771256b3a3"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2039416 - Update builders to rustc 1.95. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310745\n", "files": ["build/build-rust/Zprofile.patch", "taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/rust.yml"], "git_node": "44358da688573d4a4379261d41f4cabe33f374ea", "git_parents": ["67a2fce136c2a2f72d3c169cc8c816c9ad3d2c39"], "node": "dc45bdae4c461d94a61d7d3561144aae8b0ae122", "parents": ["1c973847d361237b098dfeab440bcb53cb2a7f52"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1977771 - Update builders to clang 22. r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310746\n", "files": ["build/build-clang/clang-tidy.json", "build/moz.configure/compile-checks.configure", "taskcluster/kinds/toolchain/clang-tidy.yml", "taskcluster/kinds/toolchain/clang.yml", "tools/clang-tidy/config.yaml"], "git_node": "36abd325b3cb498251a36a5cbb91425cdd3d82fb", "git_parents": ["44358da688573d4a4379261d41f4cabe33f374ea"], "node": "87733f2606a4f5cd419be4e518507b66d37c3039", "parents": ["dc45bdae4c461d94a61d7d3561144aae8b0ae122"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2046323 [Wayland] Use smart pointers for Wayland interfaces r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313433\n", "files": ["widget/gtk/WUniquePtr.h", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h", "widget/gtk/moz.build", "widget/gtk/mozgtk/mozgtk.c", "widget/gtk/mozwayland/mozwayland.c", "widget/gtk/wayland/color-management-v1-protocol.c", "widget/gtk/wayland/color-representation-v1-protocol.c", "widget/gtk/wayland/fractional-scale-v1-protocol.c", "widget/gtk/wayland/gtk-primary-selection-protocol.c", "widget/gtk/wayland/idle-inhibit-unstable-v1-protocol.c", "widget/gtk/wayland/kde-appmenu-protocol.c", "widget/gtk/wayland/linux-dmabuf-unstable-v1-protocol.c", "widget/gtk/wayland/pointer-constraints-unstable-v1-protocol.c", "widget/gtk/wayland/primary-selection-unstable-v1-protocol.c", "widget/gtk/wayland/relative-pointer-unstable-v1-protocol.c", "widget/gtk/wayland/viewporter-protocol.c", "widget/gtk/wayland/xdg-activation-v1-protocol.c", "widget/gtk/wayland/xdg-output-unstable-v1-protocol.c", "widget/gtk/wayland/xdg-session-management-v1-protocol.c", "widget/gtk/wayland/xdg-shell-protocol.c", "widget/gtk/wayland/xx-fractional-scale-v2-protocol.c", "widget/gtk/wayland/xx-pip-v1-protocol.c"], "git_node": "defbb0ab5826dce1a4d8a498160850da2e16487d", "git_parents": ["36abd325b3cb498251a36a5cbb91425cdd3d82fb"], "node": "7ec9c39f804cb7a7f8bfb4bab4d77db4691d5d21", "parents": ["87733f2606a4f5cd419be4e518507b66d37c3039"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2051007 - Fix broken \"Experimenter Docs\" link in Nimbus docs r=firefox-source-docs-reviewers,marco DONTBUILD\n\nThe \"Experimenter Docs\" link in toolkit/components/nimbus/docs/index.md pointed to https://mozilla.github.io/experimenter-docs/desktop-feature-api, which 301-redirects to https://experimenter.info/desktop-feature-api and returns HTTP 404 (the reported \"Page Not Found\"). Updated it to the current location https://experimenter.info/platform-guides/desktop/feature-api (\"Feature API | Mozilla Nimbus Documentation\"), which loads correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314211\n", "files": ["toolkit/components/nimbus/docs/index.md"], "git_node": "77b051668e0991c433a7fbca569a3498f6c66b24", "git_parents": ["defbb0ab5826dce1a4d8a498160850da2e16487d"], "node": "653a4429e51d80ae530d2058582594fd37040415", "parents": ["7ec9c39f804cb7a7f8bfb4bab4d77db4691d5d21"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2048635 - Fix some tests.\n", "files": ["layout/style/test/property_database.js", "testing/web-platform/tests/css/css-link-params/inheritance.html"], "git_node": "1f06cff967c5ee39255700ae1a913c5c37bc7ae1", "git_parents": ["77b051668e0991c433a7fbca569a3498f6c66b24"], "node": "d5b38cd15813f329f5138c5f1c6884e8f5a7870d", "parents": ["653a4429e51d80ae530d2058582594fd37040415"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1958702 - Use a hash set for DocGroup::mDocuments. r=smaug\n\nRemoving N documents from a single DocGroup was O(N^2): each\nRemoveDocument did a linear scan plus an array compaction. Tearing down\n500k Document objects spent 94% of content process main thread samples\nthere (75% memmove, 19% scan).\n\nmDocuments is private and its only readers are IsEmpty() and an\nunordered existence test, so ordering is not observable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315846\n", "files": ["dom/base/DocGroup.cpp", "dom/base/DocGroup.h"], "git_node": "bb03981b64cdaf84769e48317fffe8d77e675619", "git_parents": ["1f06cff967c5ee39255700ae1a913c5c37bc7ae1"], "node": "d2d665af97e40780725c6b2d04d85b35558ff7c0", "parents": ["d5b38cd15813f329f5138c5f1c6884e8f5a7870d"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2051002 - Break out of the bfcache request scan once a blocker is found. r=smaug\n\nFurther requests can only set BFCacheStatus::REQUEST again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315851\n", "files": ["dom/base/Document.cpp"], "git_node": "636d432e442af14521765ff484b1e63e614f6b39", "git_parents": ["bb03981b64cdaf84769e48317fffe8d77e675619"], "node": "910857b02c956966b6541b7e819b1e38a723c8e2", "parents": ["d2d665af97e40780725c6b2d04d85b35558ff7c0"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054381 - Fix ConcurrentConnection LOCKED race on Places startup. r=places-reviewers,daisuke\n\nIn the parent process, ConcurrentConnection opening places.sqlite concurrently\nwith EnsureConnection() causes WAL-mode lock contention (SQLITE_LOCKED or\nSQLITE_IOERR), which bypasses busy_timeout. Defer the CC open until\nTOPIC_PLACES_INIT_COMPLETE, which fires only after the main connection is\nestablished. A 10s fallback timer handles the case where the notification\nnever arrives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313466\n", "files": ["toolkit/components/places/ConcurrentConnection.cpp", "toolkit/components/places/ConcurrentConnection.h", "toolkit/components/places/Database.cpp", "toolkit/components/places/Database.h", "toolkit/components/places/tests/gtest/test_ConcurrentConnection.cpp"], "git_node": "3372dfb93854b6e38b3bb98414e95396954ce49b", "git_parents": ["636d432e442af14521765ff484b1e63e614f6b39"], "node": "b49c0a456811d07f9a9d1da9869f05781595e1a3", "parents": ["910857b02c956966b6541b7e819b1e38a723c8e2"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059365 - Remove mochitest-remote from the macosx1500-aarch64-vms test set. r=jdescottes\n\nmochitest-remote is the only browser-chrome flavor suite running on the\nheadless VM pool, and it has been failing consistently since it was enabled.\n\nbrowser-test.js nextTest calls SimpleTest.waitForFocus before every test,\nincluding the first. That lands in SimpleTest.promiseFocus, which awaits a\nfocus event with no timeout and no fallback. Window activation never\ncompletes on these workers, so the job hangs before the first test, produces\nno output, and is killed by the 370s harness timeout on every one of its\nnine retries. A representative task burns 1h15m to produce zero results.\n\nProfiler captures taken automatically at the hang confirm the browser is\nidle rather than deadlocked: 1156 of 1157 GeckoMain samples sit in\nNative event loop idle under NSApplication run, waiting for an AppKit event\nthat never arrives.\n\nThis is not specific to mochitest-remote. mochitest-devtools-chrome was\nevaluated for this pool in June 2026 and rejected for the same signature;\nmochitest-remote only predates that finding. The block comment on this test\nset already states that suites needing focus management and browser windows\nare intentionally omitted, so this brings the list back in line with its own\nstated policy.\n\nBug 2050174 tracks the underlying window activation issue on these workers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316346\n", "files": ["taskcluster/test_configs/test-sets.yml"], "git_node": "adc0ceedfb3c2dcc19cb41785f247e35894d05e3", "git_parents": ["3372dfb93854b6e38b3bb98414e95396954ce49b"], "node": "3207f52888f284b7729d4e9abd94330b82ce5da3", "parents": ["b49c0a456811d07f9a9d1da9869f05781595e1a3"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2058944: Implement MacroAssembler::flush() for riscv64. r=spidermonkey-reviewers,jandem.\n\nChanges:\n- Implement `MacroAssembler::flush()` which calls `Assember::flush` mirroring arm32/64.\n- Add `Assembler::flush()` which calls `m_buffer.flushPool()`, also mirroring arm32/64.\n- `Assembler::flush()` and `Assembler::flushBuffer()` both flush the assembler buffer,\n  no idea why there are two identical methods for arm32/64.\n- In `Assembler::finish()` and `Assembler::appendRawCode()` explictly call `flush()` to match arm32/64.\n- Also update `Assembler::appendRawCode()` to call `m_buffer.appendRawCode` to match arm32/64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315017\n", "files": ["js/src/jit/riscv64/Assembler-riscv64.cpp", "js/src/jit/riscv64/Assembler-riscv64.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "2a5ebd48aed43ab21982cf8e3d18c2d54ba6093b", "git_parents": ["adc0ceedfb3c2dcc19cb41785f247e35894d05e3"], "node": "a10beeca6fa1dc94e78421f26e47c942bfa8258c", "parents": ["3207f52888f284b7729d4e9abd94330b82ce5da3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060558 - Deal with arbitrary substitution functions even if value is parsed correctly. r=firefox-style-system-reviewers,dshin\n\n`link-parameters: param(--foo, var(--bar));` is a valid value, but has\nan arbitrary substitution function and we shouldn't just treat it as a\nparsed value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316285\n", "files": ["servo/components/style/properties/mod.rs", "testing/web-platform/tests/css/css-link-params/link-parameters-computed.html"], "git_node": "f3b6370c6510ff3c2f92919f749dbc439d8f11a6", "git_parents": ["2a5ebd48aed43ab21982cf8e3d18c2d54ba6093b"], "node": "d6f4f69976e3341d7436fed93f489fcb91336faa", "parents": ["a10beeca6fa1dc94e78421f26e47c942bfa8258c"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060759 - Update android nightly application-services version bump to e15eae17ef0a4ccc5f3584ff7a9c6b57677a4058 r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316459\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "bdc1e7772e99f9be35c6629e4c3a537dea18545b", "git_parents": ["f3b6370c6510ff3c2f92919f749dbc439d8f11a6"], "node": "586ee2c8908e79fbfa3d9ecd2af0d6ba0abec79b", "parents": ["d6f4f69976e3341d7436fed93f489fcb91336faa"], "tags": []}, {"author": "Titouan Thibaud \u003ctthibaud@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060530 - Remove unused translate strings for `mozac_feature_relay_chip_text`. r=android-reviewers,parker,marcin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316262\n", "files": ["mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ar/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-bg/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-brh/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-cak/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-cs/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-da/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-de/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-dsb/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-en-rCA/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-en-rGB/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-eo/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-es-rAR/strings.xml", "mobile/android/