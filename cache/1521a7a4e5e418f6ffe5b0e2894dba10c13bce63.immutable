2fafd61b69afbb38aa", "parents": ["6044054d2936cf134d13fdc776cf96098c50d13b"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053925 - Part 1: Add the AI action confirmation component r=desktop-theme-reviewers,ngrato,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313473\n", "files": ["browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.css", "browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.mjs", "browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.stories.mjs", "browser/components/aiwindow/ui/content/aiChatContent.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_confirmation.js", "browser/components/aiwindow/ui/test/browser/test_ai_action_confirmation.mjs", "browser/components/aiwindow/ui/test/browser/test_ai_action_confirmation_page.html", "browser/themes/shared/icons/closed-tabs.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "08f8bbf82a508176c418a716ffde5b405af52f10", "git_parents": ["4e82ceeeb78fa5b9a944becb02290f4a48ff84c8"], "node": "a7a993c3a690ac9f8e01a1becf4469ed502bc26c", "parents": ["1802f910a83cf44ffcdc522fafd61b69afbb38aa"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053925 - Part 2: Render NL browser actions with the action confirmation r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313474\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_chat_tool_ui.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_tab_close_integration.js"], "git_node": "cf66062d5e5d2785d0fbe7f23a5ee53b948daf5e", "git_parents": ["08f8bbf82a508176c418a716ffde5b405af52f10"], "node": "bdf9964c32590651347cc38ea84cd39bf7f72a8b", "parents": ["a7a993c3a690ac9f8e01a1becf4469ed502bc26c"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2057370 - [Monitor Agent][FE] Monitor Card UI clean up r=yjamora,fluent-reviewers,flod\n\nUltimitly this patch is a catch all for a lot of small UX/UI changes called out by either tyler or taylor. This patch can see somewhat \"all over the place\" but these are small changes in a lot of places for the same goal to launch monitor in V0. Many of these small changes do not need thier own patch. Figma attached in description.\n\nAdditional notes from tyler :\n\n    I'd like to see the success/failure bool in the change history\n    When editing, I'm surprised to still have the pause button.\n    When editing, It might be nice to have a cancel button to basically undo anything I was messing around with instead of committing it with save\n    The only way to get out of editing is to hit the pencil again. That's a bit unintuitive. I would have expected hitting save to also exit me out of the edit state\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316323\n", "files": ["browser/components/aiwindow/ui/actors/SmartWindowTasksParent.sys.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser_aiwi