perfdocs/index.rst", "tools/lint/file-whitespace.yml", "tools/lint/rumdl.yml"], "git_node": "95093cab6d49bbce32c3e1b2268694d08691d5e6", "git_parents": ["aaf87b4c02ba9fab54ff0d59369e2fbea765b09f"], "node": "5b9d88d3878137f6ff286a7e03c94a193734d9b7", "parents": ["b75537cdbb507ecd932e375ad8a535d07222f908"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053437 - Fix issue with \u003cselect\u003e element content translation r=translations-reviewers,gregtatum\n\nThis commit fixes an issue where a `\u003cselect\u003e` element's options are not translated correctly due\nnot being correctly observed by the intersection observer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312271\n", "files": ["toolkit/components/translations/content/translations-document.sys.mjs", "toolkit/components/translations/tests/browser/browser_translations_full_page.js", "toolkit/components/translations/tests/browser/browser_translations_translation_document_mutations.js", "toolkit/components/translations/tests/browser/translations-test.mjs"], "git_node": "1046deb017198f83a102097302bb7a7976fb7b85", "git_parents": ["95093cab6d49bbce32c3e1b2268694d08691d5e6"], "node": "ea4aa9706c78d07610f1b5d21021da7bc67fc659", "parents": ["5b9d88d3878137f6ff286a7e03c94a193734d9b7"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058419 - Part 2: Clobber for tzdata update. r=spidermonkey-reviewers,dminor\" for causing multiple failures\n\nThis reverts commit 427c2da10235796050828eef3324f776b9570f19.\n\nRevert \"Bug 2058419 - Part 1: Update to tzdata 2026c. r=spidermonkey-reviewers,dminor\"\n\nThis reverts commit 1203898655291882a77170e5f0cc5f4f0a1e0cc4.\n", "files": ["CLOBBER", "config/external/icu/data/icudt78l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "d3fdc9df5e8c9996b409369ae75c173133c465de", "git_parents": ["1046deb017198f83a102097302bb7a7976fb7b85"], "node": "3a81984e1fd40c6c5ce37eef0ae2b55bee4a84f1", "parents": ["ea4aa9706c78d07610f1b5d21021da7bc67fc659"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058273 - Make sure newly added shared prefs are added to the shared database. r=mossop\" for causing bc failures on browser_preferences.js.\n\nThis reverts commit a502487ad3c4524224256b7c0059fd6e12f89951.\n", "files": ["browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/tests/unit/test_shared_prefs_lifecycles_methods.js"], "git_node": "5855f28243234435230dd4a57a8c330b8933b7a0", "git_parents": ["d3fdc9df5e8c9996b409369ae75c173133c465de"], "node": "954217fe82701304a5be5ad630fd8fd57c2025d3", "parents": ["3a81984e1fd40c6c5ce37eef0ae2b55bee4a84f1"], "tags": []}, {"author": "Beatriz Rizental \u003cbea@torproject.org\u003e", "branch": "default", "desc": "Bug 2058343 - Do not read AutoConfig from /etc/firefox when --disable-system-preferences. r=gstoll\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314532\n", "files": ["extensions/pref/autoconfig/src/nsReadConfig.cpp"], "git_node": "efae5aceb8f51fcb39a129bdf11f7dd3a588a675", "git_parents": ["5855f28243234435230dd4a57a8c330b8933b7a0"], "node": "e9ac95f88fcccb70e2bcab6cf5369b2df20493bf", "parents": ["954217fe82701304a5be5ad630fd8fd57c2025d3"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 1975797 - Ensure download progress updates eventually by using a timer. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D256150\n", "files": ["toolkit/components/downloads/DownloadCore.sys.mjs", "toolkit/components/downloads/test/unit/head.js", "toolkit/components/downloads/test/unit/test_DownloadCore.js"], "git_node": "69339ce1ad7fdbf9d9e590adb35ecfec4609c873", "git_parents": ["efae5aceb8f51fcb39a129bdf11f7dd3a588a675"], "node": "fe91f53d6a0a7ed6a32a9ae73bbd50ca88f10c6b", "parents": ["e9ac95f88fcccb70e2bcab6cf5369b2df20493bf"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2056111 - Add remote.screenshot.use_readback pref to capture screenshots via WebRender r=jdescottes\n\nWebDriver and Marionette screenshots normally re-render the document through\nthe software drawSnapshot path, which does not reflect WebRender-specific\nrendering. When this pref is enabled, capture.canvas instead reads back the\nactual WebRender composited framebuffer via drawWindow with USE_WIDGET_LAYERS.\n\nReadback can only return the content area composited on screen, and its\ncoordinates are relative to the chrome window rather than the document, so with\nthe pref enabled every capture degrades to the whole content area of the\nforeground tab: full-document, clip and element captures all return the\nviewport. A capture with no content area to read back, such as one taken in\nchrome scope, keeps using drawSnapshot.\n\nReadback is not usable on macOS, where the GPU process asks the parent process\nfor the composited pixels and the parent only honours that request in\nautomation, so the documentation calls that platform out as unsupported and the\nmarionette tests are skipped there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312921\n", "files": ["gfx/docs/DebuggingWebRenderScreenshots.md", "gfx/docs/index.md", "modules/libpref/init/all.js", "remote/doc/Prefs.md", "remote/shared/Capture.sys.mjs", "testing/marionette/harness/marionette_harness/tests/unit/test_screenshot.py"], "git_node": "0108265b167291f8fa8eef747e1db1dfdc8b2a7b", "git_parents": ["69339ce1ad7fdbf9d9e590adb35ecfec4609c873"], "node": "382962127d48faa3b38a16308d5b772c25e6c8de", "parents": ["fe91f53d6a0a7ed6a32a9ae73bbd50ca88f10c6b"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045680 - Fix send to devices bottom sheet height on rotation r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313836\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesDialogFragment.kt"], "git_node": "352c4e28e9969742bd835834ad2a748a2f9e9c5f", "git_parents": ["0108265b167291f8fa8eef747e1db1dfdc8b2a7b"], "node": "f6057b513720f3f5ff880714c50e3e8ebcaa1f31", "parents": ["382962127d48faa3b38a16308d5b772c25e6c8de"], "tags": []}, {"author": "Bryan Olsson \u003cbolsson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058326 - Add skill for generating Fluent migration recipes, r=flod,ai4dev-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314511\n", "files": [".agents/skills/fluent-migration/SKILL.md", ".claude/skills/fluent-migration/SKILL.md"], "git_node": "3fefb4a906c803886f84f1cbc93eed29129dc850", "git_parents": ["352c4e28e9969742bd835834ad2a748a2f9e9c5f"], "node": "ad6bf32b5b9f1b479ee9800c687349aca4bb5b7b", "parents": ["f6057b513720f3f5ff880714c50e3e8ebcaa1f31"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050348 - fix nova moz-toggle hover/active styles r=desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313313\n", "files": ["toolkit/content/widgets/moz-toggle/moz-toggle.css", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.css", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-table.mjs"], "git_node": "d187a0c3062c4d26dec451c44a91f190df9882be", "git_parents": ["3fefb4a906c803886f84f1cbc93eed29129dc850"], "node": "4433458c5ff2644d97c0c3c28f6cc9d1e492b49f", "parents": ["ad6bf32b5b9f1b479ee9800c687349aca4bb5b7b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2057692 - Make `RangeBoundaryBase::IsSetAndValid()` use right API to get the max offset of the parent r=jjaschke\n\nIf `mTreeKind` is for `TreeKind::FlatForSelection`, `mParent-\u003eLength()`\nis wrong API if `mParent` is a shadow host or a `\u003cslot\u003e` which has\nsome assigned nodes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314582\n", "files": ["dom/base/RangeBoundary.h", "testing/web-platform/tests/selection/crashtests/selection-modify-line-into-svg-use.html"], "git_node": "59f0d745d02cbd891418d4342a68451a64ebe430", "git_parents": ["d187a0c3062c4d26dec451c44a91f190df9882be"], "node": "a34b6a93d7a8f7db8c793113255e9aee9bf94be6", "parents": ["4433458c5ff2644d97c0c3c28f6cc9d1e492b49f"], "tags": []}, {"author": "Matthew Gregan \u003ckinetik@flim.org\u003e", "branch": "default", "desc": "Bug 2057682 - Update libcubeb to ef47ae58. r=cubeb-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314159\n", "files": ["media/libcubeb/moz.yaml", "media/libcubeb/src/cubeb_log.h", "media/libcubeb/src/cubeb_wasapi.cpp", "media/libcubeb/test/test_logging.cpp"], "git_node": "2d21d14a9528ac075ad60cb3a034cfcf548289c5", "git_parents": ["59f0d745d02cbd891418d4342a68451a64ebe430"], "node": "a21caeff88b90ef439aba5209b427b91236c5542", "parents": ["a34b6a93d7a8f7db8c793113255e9aee9bf94be6"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2048097 - Add missing include for uint*_t. r=media-playback-reviewers,chunmin\n\nBug 2033987 removed a cinttypes include, but it was actually necessary for\none specific code path. But the direct include is cstdint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311679\n", "files": ["dom/media/webaudio/blink/DenormalDisabler.h"], "git_node": "629a8bcb0977121d09a8e6414f189957ba49c7ed", "git_parents": ["2d21d14a9528ac075ad60cb3a034cfcf548289c5"], "node": "24eed0c8838f6a8d23ace141e63ce3da3896b0e3", "parents": ["a21caeff88b90ef439aba5209b427b91236c5542"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056570 - [devtools] Put RDM toolbar after notification box in markup in Split View. r=devtools-reviewers,tabbrowser-reviewers,jsudiaman,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313470\n", "files": ["browser/components/tabbrowser/content/tabbrowser.js", "devtools/client/responsive/index.css", "devtools/client/responsive/responsive-browser.css", "devtools/client/responsive/ui.js"], "git_node": "6e3fcb957e3005435164df56f91dba0cc17b8af4", "git_parents": ["629a8bcb0977121d09a8e6414f189957ba49c7ed"], "node": "0d26549d9cac15a2ac337426e796acd70875c9c9", "parents": ["24eed0c8838f6a8d23ace141e63ce3da3896b0e3"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057983 - [devtools] Replace RDM ResizeObserver with a MediaQueryList change listener. r=devtools-reviewers,bomsy.\n\nIn the RDM toolbar document, we have a media query to switch the toolbar between\na single line to two lines when the toolbar gets too narrow.\nIn parallel, we used to have a ResizeObserver on the browserStack element to\ncheck if it was narrow, and in such case, add a special case on the iframe that\nrenders the toolbar (to update the height if needed).\nThis was a bit overkill, as we only need to know when the media query \"matches\"\nstate is updated (which would only apply when the browserStack element width\nis changed).\n\nIn this patch, we're setting a MediaQueryList change listener for the media query\ncondition we set in the CSS. This way we'll only try to toggle the appropriate\nclass when the media query gets applied/is no longer applied, and not for every\nchange in the browserStack size.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314308\n", "files": ["devtools/client/responsive/index.css", "devtools/client/responsive/index.js", "devtools/client/responsive/ui.js"], "git_node": "8734e6acc3dd0b675e87baeb97b1e152f5afd771", "git_parents": ["6e3fcb957e3005435164df56f91dba0cc17b8af4"], "node": "cbf6839acbb84c26eff4c3fb23d907ed68f6e1c2", "parents": ["0d26549d9cac15a2ac337426e796acd70875c9c9"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057434 - [devtools] Extend test coverage of DevTools toolbox splitter aria-value(min|max) attribute values. r=devtools-reviewers,bomsy.\n\nMake sure the attributes are properly updated whenever the available space for\nthe toolbox changes (e.g. the \"Find in page\" bar is toggled, notifications are\nadded in split view, RDM is toggled, Firefox sidebar is enabled, \u2026)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314309\n", "files": ["devtools/client/framework/test/browser_toolbox_splitter_keyboard.js"], "git_node": "87c2c49197ed7725d57b679f077cdf63f1083041", "git_parents": ["8734e6acc3dd0b675e87baeb97b1e152f5afd771"], "node": "199f91235633c4c30fb253f6191a6021ae673491", "parents": ["cbf6839acbb84c26eff4c3fb23d907ed68f6e1c2"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057108: Cleanup DirectManipulation initialization failure on Windows r=win-reviewers,gstoll\n\nEnsures we properly tear down services on failure.  Also promotes\nNS_ENSURE_HRESULT[_VOID] to WinUtils.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313871\n", "files": ["browser/components/shell/nsWindowsShellService.cpp", "widget/windows/DirectManipulationOwner.cpp", "widget/windows/WinUtils.h"], "git_node": "9c79808b516f4f00fc4c332a7de6724db06423eb", "git_parents": ["87c2c49197ed7725d57b679f077cdf63f1083041"], "node": "e3621dbcf4d07233c19703b12c5c7120d026d749", "parents": ["199f91235633c4c30fb253f6191a6021ae673491"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050291 - Create SplitView Trigger that gets fired on using split view feature r=pdahiya,tabbrowser-reviewers,omc-reviewers,sclements,aminomancer\n\n- add a new `splitViewUsed` trigger that fires after a configurable delay (`browser.tabs.splitview.trigger.delay_ms`, default 15s) of continuous Split View use, cancelling if the user leaves Split View before the delay elapses and restarting if they return\n- expose `splitViewCreateCount` in the trigger context (`browser.tabs.splitview.trigger.createCount`), tracking distinct Split View creations so message targeting can apply usage-based conditions (e.g. excluding first-time users)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308664\n", "files": ["browser/app/profile/firefox.js", "browser/components/asrouter/modules/ASRouterTriggerListeners.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_trigger_listeners.js", "toolkit/components/messaging-system/schemas/TriggerActionSchemas/index.md"], "git_node": "741fcf353c26b97b2b03cfbad63a241ce7f990c9", "git_parents": ["9c79808b516f4f00fc4c332a7de6724db06423eb"], "node": "13b8bb8b1fce21157288e58b663cee917c9c5d7d", "parents": ["e3621dbcf4d07233c19703b12c5c7120d026d749"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053825 - Migrated determineNonSyncableGuids to array binding. r=mak,places-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313719\n", "files": ["toolkit/components/places/PlacesSyncUtils.sys.mjs"], "git_node": "0bc38be784b5288852b85a99a061f42ef73a796e", "git_parents": ["741fcf353c26b97b2b03cfbad63a241ce7f990c9"], "node": "f679cbabeb0a8f424e8310907f0135923d976cb5", "parents": ["13b8bb8b1fce21157288e58b663cee917c9c5d7d"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053824 - Migrated fetchMany to array binding. r=mak,places-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313720\n", "files": ["toolkit/components/places/History.sys.mjs", "toolkit/components/places/tests/history/test_fetchMany.js"], "git_node": "88bb3924016e6a3f96ecb9b7d2b13afc514e86cc", "git_parents": ["0bc38be784b5288852b85a99a061f42ef73a796e"], "node": "5adb96507633c6c061cab76b0fcb65bc1196e4fb", "parents": ["f679cbabeb0a8f424e8310907f0135923d976cb5"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2058578 - Add HyperlinkElementUtils interface to SVGAElement r=emilio,webidl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314710\n", "files": ["dom/webidl/SVGAElement.webidl", "testing/web-platform/meta/svg/idlharness.window.js.ini", "testing/web-platform/tests/svg/linking/scripted/a.hyperlink-getter-01.svg"], "git_node": "5d10c983dd794f04db0e6ae9ca103a2dd5f3de72", "git_parents": ["88bb3924016e6a3f96ecb9b7d2b13afc514e86cc"], "node": "5c9c563cf8bede85924ee3c2178e255a177dc91b", "parents": ["5adb96507633c6c061cab76b0fcb65bc1196e4fb"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1892418 - Enable full scenario for macosx conditioned profiles. r=perftest-reviewers,sparky\n\nWe got a bug report that we are creating only 'settled' scenarios, not 'full' scenarios for the conditioned profiles on macosx.\nFor context, we create both on windows and linux.\nThis PR adds the 'full' scenario and migrates the jobs away from the old 1015s to the newer 1500s\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314016\n", "files": ["taskcluster/kinds/condprof/kind.yml"], "git_node": "25b02bf17409158537cc504f9caa520131010448", "git_parents": ["5d10c983dd794f04db0e6ae9ca103a2dd5f3de72"], "node": "a018bfd02aec892ca0625e250da80b78a66efe47", "parents": ["5c9c563cf8bede85924ee3c2178e255a177dc91b"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055658: Remove accessibility.ARIAElementReflection.enabled pref. r=eeejay,webidl,saschanaz\n\nThis has been around for a while now without problems.\nAlso, we depend on it in several areas of our front-end code now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313147\n", "files": ["dom/webidl/ARIAMixin.webidl", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/custom-elements/ElementInternals-accessibility.html.ini", "testing/web-platform/meta/custom-elements/element-internals-aria-element-reflection.html.ini", "testing/web-platform/meta/html/dom/aria-element-reflection-disconnected.html.ini", "testing/web-platform/meta/html/dom/aria-element-reflection-labelledby.html.ini", "testing/web-platform/meta/html/dom/aria-element-reflection.html.ini", "testing/web-platform/meta/shadow-dom/reference-target/tentative/property-reflection.html.ini", "testing/web-platform/meta/wai-aria/idlharness.window.js.ini"], "git_node": "6a43a3387a87df3b55df2904c094a264cd6fc9a8", "git_parents": ["25b02bf17409158537cc504f9caa520131010448"], "node": "4ecf7a76ffd8c4fb1029edc260d66b99be19536c", "parents": ["a018bfd02aec892ca0625e250da80b78a66efe47"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049028 - Add feature flag for vpn location selection r=android-reviewers,rebecatudor273,gmalekpour\n\nThe flag makes the feature availalbe on nightly vie secret settings and\non a debug build by default.\n\nI scoped it down from the bug discription - we do not need an extra\nnimbus flag, will be relying on the general vpn flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311621\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "d74460c2e84e25304ec5fea5489a0783bb102c95", "git_parents": ["6a43a3387a87df3b55df2904c094a264cd6fc9a8"], "node": "36d5471ec67ae5df1530b9da956b8cc32a5ecca0", "parents": ["4ecf7a76ffd8c4fb1029edc260d66b99be19536c"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049038 - Implement the location list UI r=android-reviewers,android-l10n-reviewers,parker,rebecatudor273,jonalmeida,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311655\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/IPProtectionScreenTest.kt"], "git_node": "6ca0ca4cf60806352879d80d8b3960300cdeb83b", "git_parents": ["d74460c2e84e25304ec5fea5489a0783bb102c95"], "node": "6c32979d1afac2933a854e6a545f84b6c2f1da10", "parents": ["36d5471ec67ae5df1530b9da956b8cc32a5ecca0"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054588 - Add an empty state for the location list r=android-reviewers,android-l10n-reviewers,jonalmeida,gmalekpour,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312825\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocations.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "cc79806944efd9ce250e303561802ea97b736036", "git_parents": ["6ca0ca4cf60806352879d80d8b3960300cdeb83b"], "node": "7b7c23ae3e4e5bfceab1ad85dc1912f63848fe23", "parents": ["6c32979d1afac2933a854e6a545f84b6c2f1da10"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049036 - Part 1: Add countries data class into the ip state r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312831\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/ipprotection/GeckoIPProtectionDelegate.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/ipprotection/GeckoIPProtectionHandler.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/ipprotection/IPProtectionDelegate.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/ipprotection/IPProtectionHandler.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt"], "git_node": "6086504cd24539306127e3b471c1b62a39ff48e8", "git_parents": ["cc79806944efd9ce250e303561802ea97b736036"], "node": "b33cf9a8fb13ade338f67a3fe281274387063b34", "parents": ["7b7c23ae3e4e5bfceab1ad85dc1912f63848fe23"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049036 - Part 2: Use country data classes within IP protection location ui r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313073\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt"], "git_node": "829f81ce4b731bb18818f4e882c40d3fb1df4ff1", "git_parents": ["6086504cd24539306127e3b471c1b62a39ff48e8"], "node": "58b9b2641aece4221017310b80c213b630f18b0b", "parents": ["b33cf9a8fb13ade338f67a3fe281274387063b34"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048732 - Part 1: Add a GeckoView signal to route a system audio-focus change to the audio session interrupt. r=geckoview-reviewers,android-reviewers,owlish,pollymce\n\nCarries a system audio-focus change (gain, transient loss, permanent loss)\nfrom the embedder through GeckoView to the chrome media controller's\ninterrupt, so a focus loss suspends and a gain resumes the tab's audible\nWeb Audio and Web Speech. No caller drives it yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312103\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/mediasession/GeckoMediaSessionController.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/mediasession/GeckoMediaSessionControllerTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/mediasession/MediaSession.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/MediaSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/modules/geckoview/GeckoViewMediaControl.sys.mjs"], "git_node": "7a446640337798b1512c58fe05b4655613eaa893", "git_parents": ["829f81ce4b731bb18818f4e882c40d3fb1df4ff1"], "node": "f57cb3048b7a67795318a0c0d3e3d96a2cedc7a0", "parents": ["58b9b2641aece4221017310b80c213b630f18b0b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048732 - Part 2: Drive the audio session interrupt from Android system audio-focus loss and gain. r=android-reviewers,pollymce\n\nRoute Android's transient and permanent audio-focus loss and the subsequent\ngain through the audio session interrupt, which now suspends and resumes media\nelements as well as Web Audio and Web Speech. The legacy transport pause and\nresume on a focus change is therefore redundant and dropped; the deferred-start\nresume and the denied-request pause are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312102\n", "files": ["mobile/android/android-components/components/feature/media/src/main/java/mozilla/components/feature/media/focus/AudioFocus.kt", "mobile/android/android-components/components/feature/media/src/test/java/mozilla/components/feature/media/focus/AudioFocusTest.kt"], "git_node": "b3012872312e19aff1bba42f16677463afc588f4", "git_parents": ["7a446640337798b1512c58fe05b4655613eaa893"], "node": "f0b70670c68334a05e74fa9338b4d641c5a1d361", "parents": ["f57cb3048b7a67795318a0c0d3e3d96a2cedc7a0"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058332 - Pt 1 - Remove the GPU cache's leftover scaffolding r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314515\n", "files": ["gfx/wr/webrender/res/gpu_cache_update.glsl", "gfx/wr/webrender/src/device/gl.rs"], "git_node": "0282aaf70ee2483cd2ec4b2a4197602630259696", "git_parents": ["b3012872312e19aff1bba42f16677463afc588f4"], "node": "5685572b6feaf1aa0b5924b3c9f3335211c7df67", "parents": ["f0b70670c68334a05e74fa9338b4d641c5a1d361"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058332 - Pt 2 - Remove unused Device methods r=gfx-reviewers,ahale\n\nTen more Device/Texture methods with no callers anywhere in the tree.\nUnlike the GPU cache scaffolding these do not share a single origin;\nthey are just accumulated GL wrappers that outlived their users. The\nsubpixel pair dates from when text was drawn in two blend passes --\nset_blend_mode_subpixel_dual_source, which replaced them, stays.\n\nConfirmed dead by demoting each to private and checking that rustc\nreports it as never used rather than failing to compile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314521\n", "files": ["gfx/wr/webrender/src/device/gl.rs"], "git_node": "4e7b7b27c5bd113c8dc7b598d85be7b600d50f0a", "git_parents": ["0282aaf70ee2483cd2ec4b2a4197602630259696"], "node": "bf94ece4a2db882e63741d24db522485cbcbfee8", "parents": ["5685572b6feaf1aa0b5924b3c9f3335211c7df67"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058332 - Pt 3 - Remove clip methods orphaned by earlier removals r=gfx-reviewers,nical\n\npush_clip_root_leaf, has_visible_tiles, set_active_clips_from_clip_chain\nand push_clip_instance each lost their last caller to a removal patch\n(bugs 1836063, 1851101, 2054524, 2018240) rather than being added as\nhooks. push_clip_root_node and the visible_tiles field stay.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314523\n", "files": ["gfx/wr/webrender/src/clip.rs"], "git_node": "210d5f8c0d396bd3dd024971eb7e987550e1bc87", "git_parents": ["4e7b7b27c5bd113c8dc7b598d85be7b600d50f0a"], "node": "f030120c618f7008d07c060a82d7050b4d8e1960", "parents": ["bf94ece4a2db882e63741d24db522485cbcbfee8"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-azb/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rAR/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fr/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-gn/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ko/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ru/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-tg/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-ug/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-zh-rTW/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-bqi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-cy/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-eu/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-fi/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-gn/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ko/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ru/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-tg/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-ug/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-zh-rCN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-zh-rTW/strings.xml", "mobile/android/fenix/app/src/main/res/values-ar/strings.xml", "mobile/android/fenix/app/src/main/res/values-es/strings.xml", "mobile/android/fenix/app/src/main/res/values-fi/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-ug/strings.xml"], "git_node": "f07291268f9676e6e3efe20aaa05ee5c583ff693", "git_parents": ["210d5f8c0d396bd3dd024971eb7e987550e1bc87"], "node": "c98d2852ef0dcf903e414e48f9d3e80c83977859", "parents": ["f030120c618f7008d07c060a82d7050b4d8e1960"], "tags": []}, {"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056604 - ASRouter to only ingest messages from one enrollment on non-coenrolling features. r=hanna_a,omc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314767\n", "files": ["browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/tests/browser/browser_coenrolling_messaging_features.js"], "git_node": "643e24a2a8e4749bc41c515c6b19b14413469c2f", "git_parents": ["f07291268f9676e6e3efe20aaa05ee5c583ff693"], "node": "06988f5a75c39456ccabb316a4648f6f63bbff4d", "parents": ["c98d2852ef0dcf903e414e48f9d3e80c83977859"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1806181 - Add distinct errors for SDP parsing failures. r=webrtc-reviewers,bwc,diegociudadreale,!bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295656\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.h", "dom/media/webrtc/sdp/SdpHelper.cpp", "dom/media/webrtc/sdp/SdpHelper.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "testing/web-platform/meta/webrtc/protocol/ice-ufragpwd.html.ini"], "git_node": "3dc37b3dce29cbcb5e151154a758871cbc2ab2f0", "git_parents": ["643e24a2a8e4749bc41c515c6b19b14413469c2f"], "node": "cffd4ad83b89ad1b4a61bf639615e03fbbbd940c", "parents": ["06988f5a75c39456ccabb316a4648f6f63bbff4d"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058637 - Hold a transiently interrupted audio session across the suspension it causes. r=media-playback-reviewers,azebrowski\n\nInterrupting a session suspends its audible sources, which makes the browsing\ncontext inaudible. The audibility-derived state update treated that as the page\ngoing quiet, so it replaced `interrupted` with `inactive` and then pruned the\nrecord, leaving the restore nothing to re-activate. Content observed a spurious\n`inactive` state, and the session only returned to `active` later when playback\nresumed, rather than through the restore.\n\nIgnore audibility changes for a context whose sources the interruption\nsuspended, so the record keeps its state and audibility until focus returns.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314745\n", "files": ["dom/media/mediacontrol/AudioSessionManager.cpp", "dom/media/mediacontrol/tests/gtest/TestAudioSessionManager.cpp"], "git_node": "f9fdd36c6a22f3c1f2b667641aa21520786555fc", "git_parents": ["3dc37b3dce29cbcb5e151154a758871cbc2ab2f0"], "node": "eceb88a11959521dc0641cf193bff292439050ce", "parents": ["cffd4ad83b89ad1b4a61bf639615e03fbbbd940c"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054517 - Part 1: Define the media.audio_session and media.audio_focus Glean metrics. r=media-playback-reviewers,azebrowski\n\nAdd the metric definitions for the Audio Session API telemetry set, split into\ntwo categories: media.audio_session for the spec-specific behaviour (API\nadoption and the session arbitration/selection state machine) and\nmedia.audio_focus for the platform audio-focus interaction (interruption\nlifecycle, per-source resume, and the type forwarded to the platform). The\nrecording call sites follow in later parts. The probes record no origin or URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312614\n", "files": ["dom/media/metrics.yaml"], "git_node": "5bf626716285ee01354467413b8adb5a542e193d", "git_parents": ["f9fdd36c6a22f3c1f2b667641aa21520786555fc"], "node": "e1e90dbdbe54c6e024836707e86ecc2641c60f23", "parents": ["eceb88a11959521dc0641cf193bff292439050ce"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054517 - Part 2: Record audio-session arbitration and interrupt telemetry in the parent. r=media-playback-reviewers,azebrowski\n\nRecord the parent-side probes from the audio session manager: selected-session\nchanges, the resolved effective type of an auto session, and each arbitration\npass that inactivates a session (the media.audio_session arbitration probes),\nplus interruption counts by cause and each interruption's terminal outcome (the\nmedia.audio_focus interruption probes: recovered, ended permanently, or left\nunresolved at teardown). The audio-session-type to Glean-label mapping is shared\nthrough MediaControlUtils so Part 3 reuses it.\n\nA recovery is recorded only once the session has actually been returned to\nactive, so a session the restore declines to re-activate reports no outcome.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312615\n", "files": ["dom/media/mediacontrol/AudioSessionManager.cpp", "dom/media/mediacontrol/MediaControlUtils.h"], "git_node": "b8d82d1d60af691e8e9c1417bef5310ce9dca9b7", "git_parents": ["5bf626716285ee01354467413b8adb5a542e193d"], "node": "c260d3bcdfe3775891ae555de3fa791e5857c8b9", "parents": ["e1e90dbdbe54c6e024836707e86ecc2641c60f23"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054517 - Part 3: Record Audio Session API adoption telemetry. r=media-playback-reviewers,azebrowski\n\nRecord whether a document uses navigator.audioSession and, when a page sets\naudioSession.type explicitly, which value it picks. These record from the\nnavigator.audioSession surface, which the WebIDL only exposes when the Audio\nSession API is enabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312616\n", "files": ["dom/base/Navigator.cpp", "dom/media/AudioSession.cpp"], "git_node": "2571fd35d3d529e346841c86b298732332db7ff4", "git_parents": ["b8d82d1d60af691e8e9c1417bef5310ce9dca9b7"], "node": "0026d46f870025676ef1adc676687262dda0c4d3", "parents": ["c260d3bcdfe3775891ae555de3fa791e5857c8b9"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054517 - Part 4: Record per-source interrupt resume. r=media-playback-reviewers,azebrowski\n\nWhen an interruption ends, record for each audible source the interruption\nsuspended that it was dispatched its resume signal, by source kind (media\nelement, Web Audio, or Web Speech). A source the interruption never suspended,\nor that the page took over during the interruption, is not counted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312617\n", "files": ["dom/media/mediaelement/HTMLMediaElement.cpp", "dom/media/webaudio/AudioDestinationNode.cpp", "dom/media/webspeech/synth/ipc/SpeechSynthesisChild.cpp"], "git_node": "1a60251ed2bf9f5090b406d064b230c1f44b5be9", "git_parents": ["2571fd35d3d529e346841c86b298732332db7ff4"], "node": "056ed6f642afba7c67ade7db5432e9fc702b9e34", "parents": ["0026d46f870025676ef1adc676687262dda0c4d3"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054517 - Part 5: Add browser-chrome tests for the media.audio_session and media.audio_focus probes. r=media-playback-reviewers,azebrowski\n\nDrive each recording path and assert every probe: API adoption, arbitration\nselection and effective auto type, cross-frame arbitration inactivation,\ninterruption count and recovery outcome, and per-source resume.\n\nThe interruption outcome is asserted per suspended session: a tab whose main\nframe and cross-origin iframe are both active reports a recovery for each once\nboth are returned to active, and a resume with no preceding interruption reports\nnone.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312618\n", "files": ["dom/media/mediacontrol/tests/browser/browser.toml", "dom/media/mediacontrol/tests/browser/browser_audiosession_telemetry.js"], "git_node": "b9a766dc38361f0808cac4fe8d74b0456386cd7f", "git_parents": ["1a60251ed2bf9f5090b406d064b230c1f44b5be9"], "node": "d0aaf508ca3b91f9bac1bc0e5a948e4c41804851", "parents": ["056ed6f642afba7c67ade7db5432e9fc702b9e34"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054517 - Part 6: Record the Android platform audio-focus type. r=geckoview-reviewers,owlish\n\nOn Android, record the effective audio-session type Firefox forwards to the\nembedder to shape the platform audio-focus request. Record it where GeckoView\nforwards the effective type, so it captures the type actually used on the\nplatform, including the source-derived fallback (ambient for Web Audio,\ntransient for Web Speech) that the selected-session probes do not surface.\nGated on the GeckoView audio-session-type preference.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312619\n", "files": ["mobile/shared/modules/geckoview/GeckoViewMediaControl.sys.mjs"], "git_node": "98369612bb561856a4eb4555d6d3d1dfdadfd7c0", "git_parents": ["b9a766dc38361f0808cac4fe8d74b0456386cd7f"], "node": "7219d52a71b2c9c2d16f2e40fa275d3eb99ee341", "parents": ["d0aaf508ca3b91f9bac1bc0e5a948e4c41804851"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058501: pick up taskgraph 24.2.1 r=taskgraph-reviewers,ahal\n\nThis version of taskgraph contains https://github.com/taskcluster/taskgraph/pull/1008, which avoids nested ProcessPoolExecutors, and minimizes the chance of OOMing when running `./mach taskgraph` with multiple sets of parameters at once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314660\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt"], "git_node": "197b50d3311842c71c8f150d8189659b23bebf71", "git_parents": ["98369612bb561856a4eb4555d6d3d1dfdadfd7c0"], "node": "1e8e09766f284f526b93eba60f1abe317dc6795d", "parents": ["7219d52a71b2c9c2d16f2e40fa275d3eb99ee341"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055645: pre: upgrade mozilla-taskgraph to 5.0.0 r=releng-reviewers,ahal\n\nThis contains a breaking change for landoscript payloads containing a `tag` action which will be addressed elsewhere in this stack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314656\n", "files": ["taskcluster/requirements.in", "taskcluster/requirements.txt"], "git_node": "2704895c960bc752d246d7b56df8e1874a8979a2", "git_parents": ["197b50d3311842c71c8f150d8189659b23bebf71"], "node": "1ecb11344899b25ebeece1d77bc00f648bbb3952", "parents": ["1e8e09766f284f526b93eba60f1abe317dc6795d"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055645: use direct git tagging in early-tagging and version-bump tasks r=taskgraph-reviewers,releng-reviewers,ahal\n\nThese tasks are currently broken on Try because landoscript tries to map the hg revision to a git revision, which doesn't work for try (there's no git version of that repository). Once https://github.com/mozilla-releng/scriptworker-scripts/pull/1491 is deployed, landoscript will support having git revisions fed to it directly, which will let us fix this.\n\nThis work also kindof depends on [a mozilla-taskgraph change](https://github.com/mozilla-releng/mozilla-taskgraph/pull/238) which will require `revision` to always be passed for tag actions. This means that for the hg case, we need to look this up ourselves and feed it in. (I say \"kindof depends\" because we've actually duplicated this code into Gecko for the moment...I plan to sort this out, but in the meantime I'm simply trying to keep them in sync.)\n\nFor the git case, we simply feed in a sensible branch name based on the release type. Eventually, we'll end up using this mode for production releases as well. For these, we'll likely end up feeding a specific revision fed in through the release promotion action. (We'll probably also do this for Try when those pushes are going through git directly.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312774\n", "files": ["taskcluster/gecko_taskgraph/transforms/resolve_landoscript_keyed_by.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/release-early-tagging/kind.yml", "taskcluster/kinds/release-version-bump/kind.yml"], "git_node": "ca6e9493686b3e5ed1cddb8d3a3974068463df71", "git_parents": ["2704895c960bc752d246d7b56df8e1874a8979a2"], "node": "9654bd949e36f345253280b3e5ea66653b28d847", "parents": ["1ecb11344899b25ebeece1d77bc00f648bbb3952"], "tags": []}], "date": 1785298470, "git_changesets": ["a502487ad3c4524224256b7c0059fd6e12f89951", "79454b766cbebf83ea0a8b31ea3a01862d8be61f", "ead9ad092e3bc8345915edd130b1ff7d5246132f", "a5437b2743f6f42c90e6c8573e30f70772112458", "25e660c8c3491b9a46f25914eebf2cccc6fb3996", "7e565874c7d43a0f27a647db2caf875f806eda9b", "99f0969bff54d9e3f392344855f6b862ec8a586e", "6ce321489d5775723150fd4ab7afe0bdfd4b1c32", "5cc96baf2d111725d7fc80de0749dc965dc2a869", "b8fe6dff856c96b43eed11748dc5a283d3daa514", "56050f5c3438a07157d75ab5f1889b4ad3e90ecc", "1203898655291882a77170e5f0cc5f4f0a1e0cc4", "427c2da10235796050828eef3324f776b9570f19", "79db9d1e6df3cdfed19da7c3df5cd736ac3c83b0", "aaf87b4c02ba9fab54ff0d59369e2fbea765b09f", "95093cab6d49bbce32c3e1b2268694d08691d5e6", "1046deb017198f83a102097302bb7a7976fb7b85", "d3fdc9df5e8c9996b409369ae75c173133c465de", "5855f28243234435230dd4a57a8c330b8933b7a0", "efae5aceb8f51fcb39a129bdf11f7dd3a588a675", "69339ce1ad7fdbf9d9e590adb35ecfec4609c873", "0108265b167291f8fa8eef747e1db1dfdc8b2a7b", "352c4e28e9969742bd835834ad2a748a2f9e9c5f", "3fefb4a906c803886f84f1cbc93eed29129dc850", "d187a0c3062c4d26dec451c44a91f190df9882be", "59f0d745d02cbd891418d4342a68451a64ebe430", "2d21d14a9528ac075ad60cb3a034cfcf548289c5", "629a8bcb0977121d09a8e6414f189957ba49c7ed", "6e3fcb957e3005435164df56f91dba0cc17b8af4", "8734e6acc3dd0b675e87baeb97b1e152f5afd771", "87c2c49197ed7725d57b679f077cdf63f1083041", "9c79808b516f4f00fc4c332a7de6724db06423eb", "741fcf353c26b97b2b03cfbad63a241ce7f990c9", "0bc38be784b5288852b85a99a061f42ef73a796e", "88bb3924016e6a3f96ecb9b7d2b13afc514e86cc", "5d10c983dd794f04db0e6ae9ca103a2dd5f3de72", "25b02bf17409158537cc504f9caa520131010448", "6a43a3387a87df3b55df2904c094a264cd6fc9a8", "d74460c2e84e25304ec5fea5489a0783bb102c95", "6ca0ca4cf60806352879d80d8b3960300cdeb83b", "cc79806944efd9ce250e303561802ea97b736036", "6086504cd24539306127e3b471c1b62a39ff48e8", "829f81ce4b731bb18818f4e882c40d3fb1df4ff1", "7a446640337798b1512c58fe05b4655613eaa893", "b3012872312e19aff1bba42f16677463afc588f4", "0282aaf70ee2483cd2ec4b2a4197602630259696", "4e7b7b27c5bd113c8dc7b598d85be7b600d50f0a", "210d5f8c0d396bd3dd024971eb7e987550e1bc87", "f07291268f9676e6e3efe20aaa05ee5c583ff693", "643e24a2a8e4749bc41c515c6b19b14413469c2f", "3dc37b3dce29cbcb5e151154a758871cbc2ab2f0", "f9fdd36c6a22f3c1f2b667641aa21520786555fc", "5bf626716285ee01354467413b8adb5a542e193d", "b8d82d1d60af691e8e9c1417bef5310ce9dca9b7", "2571fd35d3d529e346841c86b298732332db7ff4", "1a60251ed2bf9f5090b406d064b230c1f44b5be9", "b9a766dc38361f0808cac4fe8d74b0456386cd7f", "98369612bb561856a4eb4555d6d3d1dfdadfd7c0", "197b50d3311842c71c8f150d8189659b23bebf71", "2704895c960bc752d246d7b56df8e1874a8979a2", "ca6e9493686b3e5ed1cddb8d3a3974068463df71"], "user": "imoraru@mozilla.com"}, "44982": {"changesets": [{"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052050 - Redefine EARLY_BETA_OR_EARLIER as NIGHTLY_BUILD. r=firefox-build-system-reviewers,glandium\n\nThe distinct early and late beta periods are being phased out (bug 2051729). EARLY_BETA_OR_EARLIER is\nnow defined exactly when NIGHTLY_BUILD is, keyed off the milestone rather than the app's display\nversion. This also eliminates the need for build/defines.sh, which was previously used to control\nthis define.\n\n--as-milestone gains a \"beta\" value; \"early-beta\" and \"late-beta\" are kept as deprecated aliases so\nthat existing mozconfigs keep working.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314759\n", "files": ["build/defines.sh", "build/moz.configure/init.configure", "docs/setup/configuring_build_options.md", "python/mozbuild/mozbuild/test/configure/test_toolkit_moz_configure.py"], "git_node": "937fca8523304be195dc207171c2bc8b21c411aa", "git_parents": ["ca6e9493686b3e5ed1cddb8d3a3974068463df71"], "node": "71615c97760d8f14ef05565954f8f0bca0892c32", "parents": ["9654bd949e36f345253280b3e5ea66653b28d847"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052050 - Retire the early-to-late-beta merge automation. r=releng-reviewers,taskgraph-reviewers,bhearsum\n\nIts only job was rewriting build/defines.sh mid-beta-cycle, which no longer exists now that\nEARLY_BETA_OR_EARLIER is defined as NIGHTLY_BUILD.\n\nThe behavior remains implemented in landoscript; this only removes the in-tree configuration that\nused it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314760\n", "files": ["taskcluster/gecko_taskgraph/actions/merge_automation.py", "taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/kinds/merge-automation/kind.yml", "taskcluster/test/params/mb-early-to-late-beta-merge-automation.yml", "tools/tryselect/selectors/release.py"], "git_node": "7187a54bc9f14fa295a65f4f97d3519a4442b3c4", "git_parents": ["937fca8523304be195dc207171c2bc8b21c411aa"], "node": "0e04566860da704417ea63ac972ae7f936682036", "parents": ["71615c97760d8f14ef05565954f8f0bca0892c32"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007206: Make WebTransportHash members required r=saschanaz,webidl,necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277246\n", "files": ["dom/webidl/WebTransport.webidl", "dom/webtransport/api/WebTransport.cpp", "netwerk/protocol/http/Http3Session.cpp", "netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "a1a9e3128b22ff428df62d82470657569ea2a84c", "git_parents": ["7187a54bc9f14fa295a65f4f97d3519a4442b3c4"], "node": "5491fd5e4c11da9eb3be8cc2fc0198ebe36be979", "parents": ["0e04566860da704417ea63ac972ae7f936682036"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007150: Add protocols option to WebTransportOptions - partial DOM-only impl r=webidl,saschanaz,necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277247\n", "files": ["dom/webidl/WebTransport.webidl", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "testing/web-platform/meta/webtransport/connect.https.any.js.ini", "testing/web-platform/meta/webtransport/idlharness.https.sub.any.js.ini"], "git_node": "061cafdb376a26c8786d09399cb525ea9ed66815", "git_parents": ["a1a9e3128b22ff428df62d82470657569ea2a84c"], "node": "4e63d4f5ddb341dbb906c2230338a1ac97038857", "parents": ["5491fd5e4c11da9eb3be8cc2fc0198ebe36be979"], "tags": []}, {"author": "Randell Jesup \u003crjesup@m