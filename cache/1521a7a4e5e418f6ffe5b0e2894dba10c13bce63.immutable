bile/android/focus-android/app/src/main/res/values-te/strings.xml", "mobile/android/focus-android/app/src/main/res/values-tg/strings.xml", "mobile/android/focus-android/app/src/main/res/values-th/strings.xml", "mobile/android/focus-android/app/src/main/res/values-tr/strings.xml", "mobile/android/focus-android/app/src/main/res/values-trs/strings.xml", "mobile/android/focus-android/app/src/main/res/values-tsz/strings.xml", "mobile/android/focus-android/app/src/main/res/values-tt/strings.xml", "mobile/android/focus-android/app/src/main/res/values-uk/strings.xml", "mobile/android/focus-android/app/src/main/res/values-ur/strings.xml", "mobile/android/focus-android/app/src/main/res/values-vi/strings.xml", "mobile/android/focus-android/app/src/main/res/values-yua/strings.xml", "mobile/android/focus-android/app/src/main/res/values-zam/strings.xml", "mobile/android/focus-android/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/focus-android/app/src/main/res/values-zh-rHK/strings.xml", "mobile/android/focus-android/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "69d64b55503b3365d32f40c2775d038d76552dd9", "git_parents": ["e625be8bdbff4bf2826457b0575e8c81a916e8f4"], "node": "25a95c20ec1a9208729143083582af6e89259e5a", "parents": ["d70b671ac26ab2e86700f6d3684631f509de4bcd"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060843 - Separate the test coverage of regular and compositor clips. r=gw\" for causing webrender failures\n\nThis reverts commit 566101cc1e6daecc93236f4c3018a16f29e1d2cc.\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/wrench/reftests/boxshadow/boxshadow-spread-only-ref.png", "gfx/wr/wrench/reftests/clip/sc-mask-with-blur.png", "gfx/wr/wrench/reftests/compositor-surface/underlay-mask-on-translucent-slice.png", "gfx/wr/wrench/reftests/compositor/clipped-out-ref.yaml", "gfx/wr/wrench/reftests/compositor/clipped-out.yaml", "gfx/wr/wrench/reftests/compositor/corner-shape-ref.yaml", "gfx/wr/wrench/reftests/compositor/corner-shape.yaml", "gfx/wr/wrench/reftests/compositor/elliptical-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/elliptical-radius.yaml", "gfx/wr/wrench/reftests/compositor/fractional-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/fractional-radius.yaml", "gfx/wr/wrench/reftests/compositor/larger-than-tile-ref.yaml", "gfx/wr/wrench/reftests/compositor/larger-than-tile.yaml", "gfx/wr/wrench/reftests/compositor/nested-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/nested-clip.yaml", "gfx/wr/wrench/reftests/compositor/per-corner-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/per-corner-radius.yaml", "gfx/wr/wrench/reftests/compositor/radius-clamped-ref.yaml", "gfx/wr/wrench/reftests/compositor/radius-clamped.yaml", "gfx/wr/wrench/reftests/compositor/rect-and-rounded-ref.yaml", "gfx/wr/wrench/reftests/compositor/rect-and-rounded.yaml", "gfx/wr/wrench/reftests/compositor/reftest.list", "gfx/wr/wrench/reftests/compositor/rotated-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/rotated-clip.yaml", "gfx/wr/wrench/reftests/compositor/rounded-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/rounded-clip.yaml", "gfx/wr/wrench/reftests/compositor/scrolled-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/scrolled-clip.yaml", "gfx/wr/wrench/reftests/compositor/tile-boundary-ref.yaml", "gfx/wr/wrench/reftests/compositor/tile-boundary.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-combined-ref.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-combined.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-offset-ref.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-offset.yaml", "gfx/wr/wrench/reftests/text/border-radius-alpha.png", "gfx/wr/wrench/reftests/text/border-radius-subpx.png", "gfx/wr/wrench/reftests/text/reftest.list", "gfx/wr/wrench/reftests/transforms/reftest.list", "gfx/wr/wrench/src/args.yaml", "gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/reftest.rs", "gfx/wr/wrench/src/test_invalidation.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "2d90926dc781ae1ad4d3d4d0458c8e76ad385966", "git_parents": ["69d64b55503b3365d32f40c2775d038d76552dd9"], "node": "c3f5105b751d3294f2fcf77f63a7bd054966772e", "parents": ["25a95c20ec1a9208729143083582af6e89259e5a"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 1991243 - Always add a homepage tab for the current browsing mode on startup r=android-reviewers,jonalmeida\n\n- Replaces StartupMiddleware with HomepageTabBinding, which adds a homepage tab whenever there are no tabs for the current browsing mode on startup once the previous session has been restored.\n- StartupMiddleware ran on RestoreCompleteAction, which is only dispatched once on cold startup. This caused intermittent issues with adding private tabs when starting up in private mode because warm relaunch would have tab restore already completed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315845\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bindings/HomepageTabBinding.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/HomepageAsANewTabPreferencesRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/StartupMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/customtabs/ExternalAppBrowserActivity.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bindings/HomepageTabBindingTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/StartupMiddlewareTest.kt"], "git_node": "85f99df78cc49e42e8199cea4dd9bed960cb2cc2", "git_parents": ["2d90926dc781ae1ad4d3d4d0458c8e76ad385966"], "node": "40c5ec01cf73528f9d2c7dc22e417701015c27f8", "parents": ["c3f5105b751d3294f2fcf77f63a7bd054966772e"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045271 - Part 1: Move getUrl into HitResult.kt r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314017\n", "files": ["mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/HitResult.kt", "mobile/android/android-components/components/feature/contextmenu/src/main/java/mozilla/components/feature/contextmenu/ContextMenuCandidate.kt"], "git_node": "8c7e060cb9e80206479d6ed3169ee847b05b29b7", "git_parents": ["85f99df78cc49e42e8199cea4dd9bed960cb2cc2"], "node": "3eb96f3a25c6a34eb0b34ca18a2e65f7fb318eca", "parents": ["40c5ec01cf73528f9d2c7dc22e417701015c27f8"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045271 - Part 2: Display chooser actions when long clicking link and pressing share r=android-reviewers,gl\n\nWhen the native share sheet is enabled (and supported, API 34+ long-pressing a link/image/video and choosing \"Share\" now surfaces the extra chooser actions (Send to Devices, QR code) directly in the system share sheet.\n- Adds a reusable createShareLinkCandidate(...) factory to ContextMenuCandidate.kt (a \"Share Link\" context menu item shown for URIs, images, and video/audio).\n- In BrowserFragment, getContextMenuCandidates now branches: when the native share sheet is on, it builds the full candidate list explicitly (including the new share-link candidate); otherwise it falls back to the existing defaultCandidates(...).\n- Adds a new NativeShareSheetContextMenuCandidate object with a defaultCandidates method to provide the context menu candidates for native share sheet, mirroring CustomTabContextMenuCandidate.\n- The new share-link action (in NativeShareSheetContextMenuCandidate.defaultCandidates) calls shareUseCases.shareItems(...) with chooserActions = [SEND_TO_DEVICES, QR_CODE], falling back to navigating to the ShareFragment when the system sheet doesn't apply.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314018\n", "files": ["mobile/android/android-components/components/feature/contextmenu/src/main/java/mozilla/components/feature/contextmenu/ContextMenuCandidate.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/NativeShareSheetContextMenuCandidate.kt"], "git_node": "52b5cbb5ef1d90357a9bbdecf8476aa6bb221c20", "git_parents": ["8c7e060cb9e80206479d6ed3169ee847b05b29b7"], "node": "fc721e420995142c2b200c5cb89e4f0086182764", "parents": ["3eb96f3a25c6a34eb0b34ca18a2e65f7fb318eca"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060749 - Stocks widget: flip an interaction pref on user actions r=reemhamz\n\nAdds widgets.stocks.interaction (default false) and flips it to true on the\nchange_size, search_tickers, and learn_more actions via the shared\nhandleUserInteraction helper, matching the other widgets. Hiding the widget\ndoes not count as an interaction.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316458\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx"], "git_node": "b2581c8cdd2a840fd7fc6d60ac8247ca2859f604", "git_parents": ["52b5cbb5ef1d90357a9bbdecf8476aa6bb221c20"], "node": "adf8adde0fe568bb292ed47202f040bd014aa513", "parents": ["fc721e420995142c2b200c5cb89e4f0086182764"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036942 - Pre: Stop collecting service pack in telemetry and hardcode it to 0 for update URIs. r=Gijs,application-update-reviewers,TravisLong\n\nFor all versions of Windows 10 and later, the service pack has been\nzero. Since pre-Win10 is no longer supported, keeping it isn't helpful,\nand it can always be added back if necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314481\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/TelemetryEnvironmentTesting.sys.mjs", "toolkit/modules/UpdateUtils.sys.mjs", "tools/@types/generated/lib.gecko.glean.d.ts", "xpcom/metrics.yaml"], "git_node": "08b6d4ae1a52c3fd65ae9b4ffe29aafc89a2ca0b", "git_parents": ["b2581c8cdd2a840fd7fc6d60ac8247ca2859f604"], "node": "74cc1d98d5c8dd6033c2381492e6b7bd05c6b7db", "parents": ["adf8adde0fe568bb292ed47202f040bd014aa513"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036942 - Part 1: Use the registry to get the Windows build number for telemetry and update checks. r=application-update-reviewers,TravisLong,iholmes,cdupuis\n\nThis aims to move away from using the deprecated GetVersionEx. While\nthis registry key isn't formally documented, it is used by Chromium for\nsome of their purposes (see the comments), and ultimately it usually\nshouldn't be affected by compatibility shims, so updates can be pushed\nregardless and telemetry can better estimate the scale of any problem.\n\nNote that the user can override this on their system; this also fools\nWinVer, giving a good suggestion that this is the 'real' value, but also\nthey'd need admin access. Worst-case is they get slightly different\nupdates and telemetry is wrong.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314482\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/modules/UpdateUtils.sys.mjs", "xpcom/metrics.yaml"], "git_node": "183298efc42a57b8bbfac45fa1e6e213903b43ef", "git_parents": ["08b6d4ae1a52c3fd65ae9b4ffe29aafc89a2ca0b"], "node": "1932951fbd8d0d8654952bcf77dea7d60f6d1c33", "parents": ["74cc1d98d5c8dd6033c2381492e6b7bd05c6b7db"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036942 - Part 2: Add nsSystemInfo::IsWindows10BuildOrLater and use it for most version comparisons from JS. r=xpcom-reviewers,beth,Gijs\n\nThis again tries to get away from actually using the version number and\nGetVersionEx. It's a thin wrapper over mozilla::IsWindows10BuildOrLater,\nwhich itself calls VerifyVersionInfoW, which is also deprecated;\nhowever, it makes it harder to mess up the check, and that API is used\ninternally by Microsoft's recommended version helper functions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314483\n", "files": ["browser/components/preferences/config/appearance.mjs", "browser/components/preferences/tests/browser_appearance_pane.js", "browser/components/resistfingerprinting/test/browser/browser_navigator.js", "browser/components/resistfingerprinting/test/browser/browser_navigator_iframes.js", "browser/components/shell/ShellService.sys.mjs", "layout/style/test/chrome/test_chrome_only_media_queries.html", "toolkit/modules/OsEnvironment.sys.mjs", "widget/tests/browser/browser_test_scrollbar_colors.js", "xpcom/base/nsSystemInfo.cpp", "xpcom/system/nsISystemInfo.idl"], "git_node": "d315f1e081af3baa24af1e6d3d5ee1f6ae0d2452", "git_parents": ["183298efc42a57b8bbfac45fa1e6e213903b43ef"], "node": "3af6e3683409dcb94dd52e272da6f5f76534987e", "parents": ["1932951fbd8d0d8654952bcf77dea7d60f6d1c33"], "tags": []}, {"author": "Duncan McIntosh \u003cdmcintosh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036942 - Part 3: Use nsSystemInfo[\"build\"] from ClientEnvironment and remove WindowsVersionInfo.sys.mjs. r=cdupuis,TravisLong\n\nAdditionally, this converts ClientEnvironment to use the \"build\"\nproperty. It'd probably be good to remove the \"build\" property if we're\navoiding GetVersionEx (currently the browser won't start if it fails),\nbut in the meantime this is used by the messaging system and Nimbus. I\ndon't know how difficult it would be to change them, so punt for now.\n\nI sketched out a replacement getExactWindows10Build function, but I\nfigure this is a good enough stopgap.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314484\n", "files": ["toolkit/components/utils/ClientEnvironment.sys.mjs", "toolkit/components/utils/WindowsVersionInfo.sys.mjs", "toolkit/components/utils/moz.build", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "99f0b650866097e301bbdf9f8550ad44d30438c5", "git_parents": ["d315f1e081af3baa24af1e6d3d5ee1f6ae0d2452"], "node": "c43bdc594a1d2c9c3ca83e787f2dd949e9c92b38", "parents": ["3af6e3683409dcb94dd52e272da6f5f76534987e"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2047784 - Avoid computing --urlbar-height in JS r=desktop-theme-reviewers,adw,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316359\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/themes/shared/browser-shared.css", "browser/themes/shared/urlbar-searchbar.css", "browser/themes/shared/urlbar/variables.css"], "git_node": "a76763682812fb561afc90d993dbbefcac1c51dc", "git_parents": ["99f0b650866097e301bbdf9f8550ad44d30438c5"], "node": "526cd0920cc12a6c75a4618ad32a5701d45bbe37", "parents": ["c43bdc594a1d2c9c3ca83e787f2dd949e9c92b38"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060973 - Fix AccountStatus Uninitialized and NoAccount usages r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316636\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt"], "git_node": "3f532fdd35327ce8148090c5677da1f27e7c9543", "git_parents": ["a76763682812fb561afc90d993dbbefcac1c51dc"], "node": "ababb63312772000796faa9d1260a0a9c42d88b4", "parents": ["526cd0920cc12a6c75a4618ad32a5701d45bbe37"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2060937 - Add a Nimbus flag and secret setting for the OLED theme r=android-reviewers,skhan,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316594\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "c89c5a4fa9a623b0bbc9b8fdf70df1cae68827ca", "git_parents": ["3f532fdd35327ce8148090c5677da1f27e7c9543"], "node": "d4fa3147f2924421bbd7e8474ce0a40ed7b00ee4", "parents": ["ababb63312772000796faa9d1260a0a9c42d88b4"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2060942 - Add an OLED color scheme to AcornColors r=android-reviewers,007\n\nFigma: https://www.figma.com/design/TBCUJRlJuFnu5bygUvrzWY/Android-OLED-Theme?node-id=265-15861&t=S9k6Wp0Ox8KVc8Vd-11\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316595\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/AcornColorGrid.kt", "mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/AcornColors.kt", "mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/theme/AcornGradientScheme.kt"], "git_node": "52206f323429f7529bd6eddd37940b709c3843ba", "git_parents": ["c89c5a4fa9a623b0bbc9b8fdf70df1cae68827ca"], "node": "17db0587ad5a338e99c9ae19b22c18f78bb68740", "parents": ["d4fa3147f2924421bbd7e8474ce0a40ed7b00ee4"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054725 - Remove the unused GMP getNodeId callback API. r=aosmond,media-playback-reviewers\n\nThe getNodeId path has no callers: the node id needed to launch a GMP is\nalready resolved on the plugin-launch path from the NodeIdVariant, so this\nseparate resolution path is unused. Remove it end to end:\n- mozIGeckoMediaPluginService::getNodeId and the GetNodeIdCallback plumbing\n  (the XPCOM method plus its GeckoMediaPluginService child and parent\n  implementations);\n- the PGMPService::GetGMPNodeId IPC message and the\n  GMPServiceParent::RecvGetGMPNodeId handler.\n\nAlso move the CDM-storage gtest's node-id lookup into CDMStorageTest (now a\nfriend) so it calls the private synchronous lookup directly instead of the\nremoved callback, without widening the public interface.\n\nThe removal was confirmed safe:\n- getNodeId is [noscript] and [builtinclass], so it is C++-only with no\n  scriptable, JS, or extension consumers.\n- The only references to getNodeId, GetNodeIdCallback and GetGMPNodeId in\n  mozilla-central are its own implementations and this gtest (verified via\n  searchfox), and there is no Rust caller beyond the generated xpcrs vtable\n  stubs.\n- External GMP plugins reach Gecko through the GMP C API, not this XPCOM\n  interface or the PGMPService protocol; the Widevine/CDM adapter has no\n  references and the plugin C API exposes no node-id lookup.\n- No references in comm-central.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313872\n", "files": ["dom/media/gmp/GMPServiceChild.cpp", "dom/media/gmp/GMPServiceChild.h", "dom/media/gmp/GMPServiceParent.cpp", "dom/media/gmp/GMPServiceParent.h", "dom/media/gmp/PGMPService.ipdl", "dom/media/gmp/mozIGeckoMediaPluginService.idl", "dom/media/gtest/TestCDMStorage.cpp"], "git_node": "09660d16d174204b6d2a65c830c113648c95f657", "git_parents": ["52206f323429f7529bd6eddd37940b709c3843ba"], "node": "291f888568595b87430e31b4b6df5b518afdca97", "parents": ["17db0587ad5a338e99c9ae19b22c18f78bb68740"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054725 - Validate GMP launch node-id origins against the content process remote type. r=aosmond,media-playback-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313873\n", "files": ["dom/ipc/ContentParent.cpp", "dom/media/gmp/GMPServiceParent.cpp", "dom/media/gmp/GMPServiceParent.h"], "git_node": "b003f0d0f62af6d1e3bfa0033a85a44d263f2c2e", "git_parents": ["09660d16d174204b6d2a65c830c113648c95f657"], "node": "d9d605bc04b7af2ba883cc2a3f3cc5d721288f69", "parents": ["291f888568595b87430e31b4b6df5b518afdca97"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2048590 - Part 1 - Lock private mode when switching to normal mode. r=android-reviewers,tcampbell\n\nPrevious behavior:\n Private mode is locked only when the app goes in background.\n\n New behavior:\n Private mode is locked when either the app goes in background or\n switching to normal mode.\n\n Changes:\n - Rename `maybeLockPrivateModeOnStop` to `maybeLockPrivateMode` for reuse.\n - In PrivateBrowsingLockFeature observe browser mode change and lock private mode\n if all conditions are met.\n - `observeOpenInFirefoxRequest()` included in the new observer: `observeAppStoreUpdates()`.\n - Add tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313468\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pbmlock/PrivateBrowsingLockFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pbmlock/PrivateBrowsingLockFeatureTest.kt"], "git_node": "a3b5794fa0f8fc90c6a47b4b4788d82b7bf2c19c", "git_parents": ["b003f0d0f62af6d1e3bfa0033a85a44d263f2c2e"], "node": "d120a997eab05c0df26b8c68f51f8985d1cea744", "parents": ["d9d605bc04b7af2ba883cc2a3f3cc5d721288f69"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2048590 - Part 2 - Lock private mode after exiting TabsTray. r=android-reviewers,tcampbell\n\nEnsure private tabs are locked whenever when leaving the tabstray unless it\u2019s private mode.\n This prevents private tabs or previews from being accessible without authentication after\n a TabsTray interaction has concluded.\n\n Changes:\n - Add a new app state to track TabsTray visibility.\n - Observe isTabsTrayVisible in PrivateBrowsingLockFeature and lock private mode accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313469\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppStoreReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pbmlock/PrivateBrowsingLockFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt"], "git_node": "58960f2b3c55f2a02b34d8a0a16061d04ce48ccd", "git_parents": ["a3b5794fa0f8fc90c6a47b4b4788d82b7bf2c19c"], "node": "54da15e4475442944b9de84c737aeee29aee439e", "parents": ["d120a997eab05c0df26b8c68f51f8985d1cea744"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059464 - Close the urlbar view before awaiting the switcher's engine list. r=daleharvey\n\nOpening the search mode switcher closes the urlbar view, which collapses the\nurlbar and so moves the panel's anchor. panel-list aligns itself asynchronously\nand abandons the open if its anchor moves mid-alignment, so the close has to\nland before that alignment window.\n\nIt did so only by timing: the close sat after an await on the engine list, which\nresolves promptly while the engine store is warm. On the message path the store\nround-trips, so the close lands mid-alignment and the panel never opens -- no\npopupshown, and focus left on the document body. Worth checking that nothing\nbetween the two statements needs the view still open; the engine list is built\nfrom the store, not from the view.\n\nGreens up browser_searchModeSwitcher_keyNavigation.js's test_keyboard_nav on the\nmessage path. The direct path keeps the same observable ordering, and the\ndependency on how long the engine list takes is latent there too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315310\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs"], "git_node": "f301bd00c8c7952b09a28c6ab2c6f8deb7afa072", "git_parents": ["58960f2b3c55f2a02b34d8a0a16061d04ce48ccd"], "node": "1fdc9ff1993146c585aa5136f70e085a858ff53a", "parents": ["54da15e4475442944b9de84c737aeee29aee439e"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059083 - Part 1: Pass the user selected country to GeckoView r=android-reviewers,jonalmeida,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315062\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/ipprotection/GeckoIPProtectionDelegate.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/ipprotection/GeckoIPProtectionHandler.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/ipprotection/IPProtectionHandler.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/State.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/CountryTest.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocations.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/ipprotection/IPProtectionLocationsFragment.kt"], "git_node": "ef0b6529dc32967a47c5f3fdbd8a2c12e2439eaa", "git_parents": ["f301bd00c8c7952b09a28c6ab2c6f8deb7afa072"], "node": "5b53b9b97f06284a4c3ffd8b8354625c384971b2", "parents": ["1fdc9ff1993146c585aa5136f70e085a858ff53a"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059083 - Part 2: Remove unnecessary check around location r=android-reviewers,gmalekpour\n\n...section click.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315755\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionFragment.kt"], "git_node": "e3be4d9a58591852dadf028c91500dd9d798f33d", "git_parents": ["ef0b6529dc32967a47c5f3fdbd8a2c12e2439eaa"], "node": "3840b7b756165f1c38754c95384133af2c72d4ac", "parents": ["5b53b9b97f06284a4c3ffd8b8354625c384971b2"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059099 - Switch to another country if vpn is active already r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315063\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt"], "git_node": "d3ae44b7027f5dbd344eeabb384550a62ca50374", "git_parents": ["e3be4d9a58591852dadf028c91500dd9d798f33d"], "node": "20781e3e33ef89386e7f70ead5aba4525a9a08cc", "parents": ["3840b7b756165f1c38754c95384133af2c72d4ac"], "tags": []}, {"author": "John Lin \u003cjolin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047221 - test crypto subsample size validation. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306898\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "346ed151755e2642ad8754a4255fdcb420a187a3", "git_parents": ["d3ae44b7027f5dbd344eeabb384550a62ca50374"], "node": "6cec8af5be9ad7c06ebfca9d0e2eca9111768c84", "parents": ["20781e3e33ef89386e7f70ead5aba4525a9a08cc"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2037642 - Cache default timing function and default composite for processing keyframes. r=firefox-style-system-reviewers,layout-scroll-driven-animation-reviewers,emilio,dshin\n\nPer spec, when processing keyframes (especially for generating 0% and\n100% keyframes in the following patches), we have to know the style values\nfor animation-composition and animation-timing-function.\n\nThese values are for CSS Keyframes so they shouldn't be updated from Web\nAnimations. That's why we don't use the composition operation and easing\nstored in KeyframeEffect.\n\nNo behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316398\n", "files": ["dom/animation/CSSAnimation.h", "dom/animation/KeyframeEffect.h", "layout/style/nsAnimationManager.cpp"], "git_node": "79df1e825bd8c814102a4b1210a31a2fa97cdc72", "git_parents": ["346ed151755e2642ad8754a4255fdcb420a187a3"], "node": "d0af1898e0feffa8168086eb1ecf1c7c36059ccf", "parents": ["6cec8af5be9ad7c06ebfca9d0e2eca9111768c84"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2037642 - Implement the generation of initial and final keyframes for animated properties. r=layout-scroll-driven-animation-reviewers,dshin\n\nThis implements the spec: the step 3 (i.e. Generate Initial and Final Frames)\nin [1], and it handles the offsets with `\u003c= 0` and `\u003e= 1` based on [2].\n\nI comment out the caller because we are still generating the initial\nand final keyframes and filling the missing properties in\n`Servo_StyleSet_GetKeyframesForName()` (to the specified keyframes).\n\n[1] https://drafts.csswg.org/css-animations-2/#keyframe-processing\n[2] https://drafts.csswg.org/scroll-animations-1/#named-range-keyframes\n\nNo behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316399\n", "files": ["dom/animation/CSSAnimation.cpp", "dom/animation/CSSAnimation.h", "dom/animation/Keyframe.h", "dom/animation/KeyframeEffect.cpp", "dom/animation/KeyframeEffect.h"], "git_node": "975b0611f75ca0693af621332792d00f577e84e1", "git_parents": ["79df1e825bd8c814102a4b1210a31a2fa97cdc72"], "node": "ce2636189a4179086c13654562a6f33ab970bf4d", "parents": ["d0af1898e0feffa8168086eb1ecf1c7c36059ccf"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2037642 - Start to generate missing initial and final keyframes lazily. r=firefox-style-system-reviewers,layout-scroll-driven-animation-reviewers,dshin\n\nWe generate the keyframes based on the resolved computed offsets, so we\ndefer the generation until getKeyframes() and building properties.\n\nAlso remove the unused code and update the test expectations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316400\n", "files": ["dom/animation/Keyframe.h", "dom/animation/KeyframeEffect.cpp", "dom/animation/KeyframeEffect.h", "dom/animation/KeyframeUtils.cpp", "dom/animation/KeyframeUtils.h", "layout/style/GeckoBindings.cpp", "layout/style/GeckoBindings.h", "layout/style/ServoStyleSet.cpp", "layout/style/ServoStyleSet.h", "layout/style/nsAnimationManager.cpp", "servo/components/style/stylesheets/keyframes_rule.rs", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-animations/KeyframeEffect-getKeyframes.tentative.html.ini", "testing/web-platform/meta/scroll-animations/css/timeline-offset-in-keyframe-change-timeline.tentative.html.ini", "testing/web-platform/meta/scroll-animations/css/timeline-offset-keyframes-hidden-subject.html.ini", "testing/web-platform/meta/scroll-animations/css/timeline-offset-keyframes-with-document-timeline.html.ini"], "git_node": "a8fbf94566970e9fad9f8f58f157237140c3b122", "git_parents": ["975b0611f75ca0693af621332792d00f577e84e1"], "node": "759ea02bf3b9a3a5ca9718c1345032af1dc0b735", "parents": ["ce2636189a4179086c13654562a6f33ab970bf4d"], "tags": []}, {"author": "sarah541 \u003csarahkhan1107@hotmail.com\u003e", "branch": "default", "desc": "Bug 2056670 - Allow swiping from home when HNT enabled r=android-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313602\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/gestures/ToolbarHorizontalGesturesHandler.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/HomeSwipeIntegration.kt"], "git_node": "6e9c8a55d8138dd6fba1856483d5767679d09544", "git_parents": ["a8fbf94566970e9fad9f8f58f157237140c3b122"], "node": "6ef38854528bb4d037e9190ec61d0ede20740e2f", "parents": ["759ea02bf3b9a3a5ca9718c1345032af1dc0b735"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047221 - test crypto subsample size validation. r=media-playback-reviewers,alwu\" for causing build bustages\n\nThis reverts commit 346ed151755e2642ad8754a4255fdcb420a187a3.\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "9d787e9b231e9635791ebbdc103d1fbdceb701b9", "git_parents": ["6e9c8a55d8138dd6fba1856483d5767679d09544"], "node": "f946a9f88bb7ff7042f0d25d729da59b41163b8b", "parents": ["6ef38854528bb4d037e9190ec61d0ede20740e2f"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054725 - Validate GMP launch node-id origins against the content process remote type. r=aosmond,media-playback-reviewers\" for causing mochitest failures @ test_eme_createMediaKeys_iframes.html\n\nThis reverts commit b003f0d0f62af6d1e3bfa0033a85a44d263f2c2e.\n\nRevert \"Bug 2054725 - Remove the unused GMP getNodeId callback API. r=aosmond,media-playback-reviewers\"\n\nThis reverts commit 09660d16d174204b6d2a65c830c113648c95f657.\n", "files": ["dom/ipc/ContentParent.cpp", "dom/media/gmp/GMPServiceChild.cpp", "dom/media/gmp/GMPServiceChild.h", "dom/media/gmp/GMPServiceParent.cpp", "dom/media/gmp/GMPServiceParent.h", "dom/media/gmp/PGMPService.ipdl", "dom/media/gmp/mozIGeckoMediaPluginService.idl", "dom/media/gtest/TestCDMStorage.cpp"], "git_node": "100490def16369fd3209e6e786c730b517258df6", "git_parents": ["9d787e9b231e9635791ebbdc103d1fbdceb701b9"], "node": "8df39068ed7ada8336d124e350fe93b98b7d5dbe", "parents": ["f946a9f88bb7ff7042f0d25d729da59b41163b8b"], "tags": []}, {"author": "mimi \u003cmjung@mozilla.com\u003e", "branch": "default", "desc": "Bug 1946565 - ASRouter Devtools Part 2: Remove duplicate, redundant or unused paneltestprovider messages r=omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312593\n", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "browser/components/asrouter/content-src/components/ASRouterAdmin/ASRouterAdmin.jsx", "browser/components/asrouter/content/asrouter-admin.bundle.js", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser_asrouter_toast_notification-gif.js", "browser/components/asrouter/tests/browser/browser_asrouter_toast_notification.js"], "git_node": "2d0b737a4592d4ea1f3e12fa486729b0da5091a8", "git_parents": ["100490def16369fd3209e6e786c730b517258df6"], "node": "92a0609cd4300be1bf865a4486baf58440b84455", "parents": ["8df39068ed7ada8336d124e350fe93b98b7d5dbe"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2060357. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316207\n", "files": ["gfx/layers/ipc/SharedRGBImage.cpp", "gfx/layers/ipc/SharedRGBImage.h"], "git_node": "ae4cc36924afc31cad019b47e8eba4aa8b676abc", "git_parents": ["2d0b737a4592d4ea1f3e12fa486729b0da5091a8"], "node": "7cc256a46d316a701c08c6a0cab53788fbfcbe3c", "parents": ["92a0609cd4300be1bf865a4486baf58440b84455"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2058388. Allow passing the DrawView flag to drawSnapshot so root scrollbars are painted, and so reftest's snapshot path matches its default one. r=dom-core-reviewers,webrtc-reviewers,devtools-reviewers,webcompat-reviewers,layout-reviewers,jdescottes,twisniewski,emilio,smaug,pehrsons\n\ndrawSnapshot only asked CrossProcessPaint for DrawView when no rect was passed.\nWithout DrawView the paint also gets IgnoreViewportScrolling | DocumentRelative,\nwhich makes nsLayoutUtils::PaintFrame set the root scroll container as the display\nlist builder's ignored scroll frame. ScrollContainerFrame::BuildDisplayList then\nonly appends the scroll parts on that path when painting to a window, which a\nsnapshot never is. The reftest harness needs an explicit rect, so it lost the root\nscrollbars, and drew position:fixed content at the scroll offset while the rest of\nthe page was document relative. The default harness path doesn't have either\nproblem because it calls drawWindow with DRAWWINDOW_DRAW_VIEW.\n\nReplace the trailing resetScrollPosition boolean on drawSnapshot with a\nDrawSnapshotOptions dictionary and add drawView to it, which sets the DrawView\nflag even when a rect is given. Both reftest harnesses opt in. Every other caller\nkeeps the document relative behaviour it has today, which is what thumbnails,\nScreenshots, DevTools and tabs.captureTab want; those call sites are mechanically\nconverted from the positional boolean to the dictionary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314618\n", "files": ["devtools/server/actors/utils/capture-screenshot.js", "dom/chrome-webidl/WindowGlobalActors.webidl", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/media/systemservices/video_engine/tab_capturer.cc", "layout/reftests/backgrounds/reftest.list", "layout/reftests/bugs/reftest.list", "layout/reftests/css-gradients/reftest.list", "layout/reftests/css-scroll-snap/reftest.list", "layout/reftests/forms/fieldset/reftest.list", "layout/reftests/scrolling/reftest.list", "layout/reftests/transform/reftest.list", "layout/tools/reftest/reftest.sys.mjs", "layout/xul/reftest/reftest.list", "remote/marionette/reftest.sys.mjs", "remote/shared/Capture.sys.mjs", "testing/specialpowers/content/SpecialPowersParent.sys.mjs", "toolkit/components/extensions/parent/ext-tabs-base.js", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs"], "git_node": "dd1773e2331e2969e31444cfb6d7238e65b60997", "git_parents": ["ae4cc36924afc31cad019b47e8eba4aa8b676abc"], "node": "38e07552fb8b0d1772124f407fb7dd12cb69ecec", "parents": ["7cc256a46d316a701c08c6a0cab53788fbfcbe3c"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059576 - Stack the felt privacy error page illustration above the text on narrow viewports r=desktop-theme-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315470\n", "files": ["toolkit/themes/shared/aboutNetError.css"], "git_node": "13860fa016029d10d9dcfbc444f1ece75af6757e", "git_parents": ["dd1773e2331e2969e31444cfb6d7238e65b60997"], "node": "1cc5324c64b126e53e70cebd4ad474935665365a", "parents": ["38e07552fb8b0d1772124f407fb7dd12cb69ecec"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054375 - Update libffi to version 3.7.1. r=glandium\n\nRemoves dlmalloc-msvc-lock-cast.patch, which has been fixed upstream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315471\n", "files": ["config/external/ffi/subst_header.py", "js/src/ctypes/libffi-patches/dlmalloc-msvc-lock-cast.patch", "js/src/ctypes/libffi/include/ffi.h.in", "js/src/ctypes/libffi/moz.yaml", "js/src/ctypes/libffi/src/aarch64/ffi.c", "js/src/ctypes/libffi/src/alpha/ffi.c", "js/src/ctypes/libffi/src/alpha/ffitarget.h", "js/src/ctypes/libffi/src/closures.c", "js/src/ctypes/libffi/src/frv/ffi.c", "js/src/ctypes/libffi/src/ia64/ffi.c", "js/src/ctypes/libffi/src/m32r/ffi.c", "js/src/ctypes/libffi/src/moxie/ffi.c", "js/src/ctypes/libffi/src/or1k/ffi.c", "js/src/ctypes/libffi/src/pa/ffi.c", "js/src/ctypes/libffi/src/pa/ffitarget.h", "js/src/ctypes/libffi/src/powerpc/ffi.c", "js/src/ctypes/libffi/src/powerpc/ffi_darwin.c", "js/src/ctypes/libffi/src/powerpc/ffi_linux64.c", "js/src/ctypes/libffi/src/powerpc/ffi_powerpc.h", "js/src/ctypes/libffi/src/powerpc/ffi_sysv.c", "js/src/ctypes/libffi/src/powerpc/ffitarget.h", "js/src/ctypes/libffi/src/prep_cif.c", "js/src/ctypes/libffi/src/s390/ffitarget.h", "js/src/ctypes/libffi/src/sh64/ffi.c", "js/src/ctypes/libffi/src/sparc/ffi.c", "js/src/ctypes/libffi/src/sparc/ffi64.c", "js/src/ctypes/libffi/src/tramp.c", "js/src/ctypes/libffi/src/types.c", "js/src/ctypes/libffi/src/wasm/ffi.c", "js/src/ctypes/libffi/src/x86/ffi.c", "js/src/ctypes/libffi/src/x86/ffi64.c", "js/src/ctypes/libffi/src/x86/ffitarget.h", "js/src/ctypes/libffi/src/x86/ffiw64.c", "js/src/ctypes/libffi/src/x86/sysv.S", "js/src/ctypes/libffi/src/x86/sysv_intel.S", "js/src/ctypes/libffi/src/x86/unix64.S", "js/src/ctypes/libffi/src/x86/win64.S", "js/src/ctypes/libffi/src/x86/win64_intel.S"], "git_node": "89d05f985bbf5ebc694584514e938014abbd58bf", "git_parents": ["13860fa016029d10d9dcfbc444f1ece75af6757e"], "node": "2b768cc3f0e86c28e7724257364333853415decd", "parents": ["1cc5324c64b126e53e70cebd4ad474935665365a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054375 - Use libffi's reusable call plan for repeated ctypes calls on x86-64. r=glandium\n\nFunctionType::Call re-derived the libffi argument placement on every\nffi_call. libffi 3.7.0 adds the ffi_call_plan API, which captures that\nplacement once and reuses it, with an accelerated implementation for the\nx86-64 System V ABI. Build a plan per non-variadic FunctionType where\nthat fast path exists and invoke it in place of ffi_call, falling back to\nffi_call for signatures the plan does not accelerate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315472\n", "files": ["js/public/MemoryFunctions.h", "js/src/ctypes/CTypes.cpp", "js/src/ctypes/CTypes.h", "js/src/jit-test/tests/ctypes/call-plan-fast-path.js"], "git_node": "4811b934e8736d0271400f9258645c4b24177923", "git_parents": ["89d05f985bbf5ebc694584514e938014abbd58bf"], "node": "9a4070930d16d4bc5a3ed54343698a3b114b476f", "parents": ["2b768cc3f0e86c28e7724257364333853415decd"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054375 - Stop building the unused libffi raw and Java raw APIs. r=glandium\n\nraw_api.c compiles to an empty translation unit because the build defines\nFFI_NO_RAW_API, and the ffi_java_raw_* symbols from java_raw_api.c are\nunreferenced by ctypes, the library's only consumer. Drop both from SOURCES.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315473\n", "files": ["config/external/ffi/moz.build"], "git_node": "71f41f69b99db8fdf6b77370fc512ee67304e744", "git_parents": ["4811b934e8736d0271400f9258645c4b24177923"], "node": "a7c076644dba56f2ac6d3a6f6ccc87bb1931fd45", "parents": ["9a4070930d16d4bc5a3ed54343698a3b114b476f"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["tools/clang-tidy/config.yaml"], "git_node": "bbdf65338f09567bd5c818a12030c63b530833a2", "git_parents": ["71f41f69b99db8fdf6b77370fc512ee67304e744", "02e25036dc44ff11c9af3218179160517dcd7677"], "node": "8011f9dd9c42d29681ba20b8d834a0d1e8537a4b", "parents": ["a7c076644dba56f2ac6d3a6f6ccc87bb1931fd45", "a930bda5ad38c96fd4ea9646945a5b090b6bd4f8"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2061031 - Add the error from IPProtectionController to vpn.error_encountered r=geckoview-reviewers,android-reviewers,kaya\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316675\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Actions.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionSnackbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddlewareTest.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/IPProtectionController.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "a4ec7d2356a6af19517118a27e40000f4dd5d177", "git_parents": ["bbdf65338f09567bd5c818a12030c63b530833a2"], "node": "725147790f194349eefc55cf835c536391f28949", "parents": ["8011f9dd9c42d29681ba20b8d834a0d1e8537a4b"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2060806 - Update *-cli tools. r=padenot\n\nThe win32-stmo-cli toolchain fails to build after the upgrade, but win32\nis actually not a supported tier 1 host platform, so just remove the\ntask.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316504\n", "files": ["taskcluster/kinds/fetch/toolchains.yml", "taskcluster/kinds/toolchain/stmo-cli.yml"], "git_node": "ea0d5faa30cae8791f4cc594ae24808f156d6407", "git_parents": ["a4ec7d2356a6af19517118a27e40000f4dd5d177"], "node": "fe441e0a284c82dddaab6f7c56552bf407395065", "parents": ["725147790f194349eefc55cf835c536391f28949"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2058778 - Memoize the most recent deferred finalizer table lookup. r=smaug\n\nDeferredFinalize() does a PLDHashTable lookup keyed on the finalize function for\nevery object queued. Consecutive objects almost always share a function -- every\nnsISupports-derived binding uses DeferredFinalizerImpl\u003cnsISupports\u003e's -- so\ncaching the last (function, data) pair turns most lookups into a pointer\ncomparison. The cached data stays valid until the table is drained, which only\nhappens in FinalizeDeferredThings().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314241\n", "files": ["xpcom/base/CycleCollectedJSRuntime.cpp", "xpcom/base/CycleCollectedJSRuntime.h"], "git_node": "99c08d0d7c799e01e629a46c5c93b1f598b81de4", "git_parents": ["ea0d5faa30cae8791f4cc594ae24808f156d6407"], "node": "f02ab9bb7f7023be1d2ba2b3c8e89c7e6d2e9e25", "parents": ["fe441e0a284c82dddaab6f7c56552bf407395065"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2060447 - Add enterprise-repack parameter to TaskCluster schema r=ahal,taskgraph-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316206\n", "files": ["taskcluster/gecko_taskgraph/config.py"], "git_node": "ec02fe81a55f01512ee1ca035781f73b9ce06a69", "git_parents": ["99c08d0d7c799e01e629a46c5c93b1f598b81de4"], "node": "a5a37fee9ad0525dccc4e4265c893fb8022d8f25", "parents": ["f02ab9bb7f7023be1d2ba2b3c8e89c7e6d2e9e25"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2060901 - Clear resource cache before running the test. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316717\n", "files": ["dom/base/test/jsmodules/importmaps/test_bug_2054295.html"], "git_node": "408a169fff55e3684919c8cd1a47e515f51a767c", "git_parents": ["ec02fe81a55f01512ee1ca035781f73b9ce06a69"], "node": "e21e1e47e039f67759b4043757c4245d2ce8af90", "parents": ["a5a37fee9ad0525dccc4e4265c893fb8022d8f25"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060721: Fix failing browser_bookmarks_sync_promo.js test r=sync-reviewers,markh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316624\n", "files": ["browser/components/customizableui/test/browser_bookmarks_sync_promo.js", "browser/components/customizableui/test/browser_history_sync_promo.js"], "git_node": "7b31e7ca3ef64bbedc1906c13895408cc0b61953", "git_parents": ["408a169fff55e3684919c8cd1a47e515f51a767c"], "node": "c17671d38347ceae228ded0c56847b331c98c4fe", "parents": ["e21e1e47e039f67759b4043757c4245d2ce8af90"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058388. Allow passing the DrawView flag to drawSnapshot so root scrollbars are painted, and so reftest's snapshot path matches its default one. r=dom-core-reviewers,webrtc-reviewers,devtools-reviewers,webcompat-reviewers,layout-reviewers,jdescottes,twisniewski,emilio,smaug,pehrsons\" for causing reftest failures @ layout/reftests/scrolling/webkit-scrollbar-on-root-on-mobile.html\n\nThis reverts commit dd1773e2331e2969e31444cfb6d7238e65b60997.\n", "files": ["devtools/server/actors/utils/capture-screenshot.js", "dom/chrome-webidl/WindowGlobalActors.webidl", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/media/systemservices/video_engine/tab_capturer.cc", "layout/reftests/backgrounds/reftest.list", "layout/reftests/bugs/reftest.list", "layout/reftests/css-gradients/reftest.list", "layout/reftests/css-scroll-snap/reftest.list", "layout/reftests/forms/fieldset/reftest.list", "layout/reftests/scrolling/reftest.list", "layout/reftests/transform/reftest.list", "layout/tools/reftest/reftest.sys.mjs", "layout/xul/reftest/reftest.list", "remote/marionette/reftest.sys.mjs", "remote/shared/Capture.sys.mjs", "testing/specialpowers/content/SpecialPowersParent.sys.mjs", "toolkit/components/extensions/parent/ext-tabs-base.js", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs"], "git_node": "1987fd15df53bb6c8313593f7b6dbe1b36735997", "git_parents": ["7b31e7ca3ef64bbedc1906c13895408cc0b61953"], "node": "3c991e41ca946d1e878410578e4137476fd96953", "parents": ["c17671d38347ceae228ded0c56847b331c98c4fe"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2058347 - DOM Media - Use vkGetDeviceQueue2 with FFmpeg queue_flags for Vulkan copy queues. r=stransky\n\nFFmpeg may create device queues with non-zero VkDeviceQueueCreateFlags\n(e.g. INTERNALLY_SYNCHRONIZED). vkGetDeviceQueue is illegal for those\nqueues; fetch them with vkGetDeviceQueue2 using AVVulkanDeviceContext.queue_flags\n(lavu 60.32.100+). Fixes RDD AbnormalShutdown on the Vulkan copy-export path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316672\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.h"], "git_node": "f229730f26d656340942801247f8f75ccc0ad85f", "git_parents": ["1987fd15df53bb6c8313593f7b6dbe1b36735997"], "node": "e52979e5394db913a5eb47178dcd3c97e657a14b", "parents": ["3c991e41ca946d1e878410578e4137476fd96953"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060901 - Clear resource cache before running the test. r=arai\" for causing build bustages\n\nThis reverts commit 408a169fff55e3684919c8cd1a47e515f51a767c.\n", "files": ["dom/base/test/jsmodules/importmaps/test_bug_2054295.html"], "git_node": "6f8d2ee6abce74a31327e94d6d96bb905fc4cffd", "git_parents": ["f229730f26d656340942801247f8f75ccc0ad85f"], "node": "b87cce1679adefc9d2ed6ca91853a6a01f781400", "parents": ["e52979e5394db913a5eb47178dcd3c97e657a14b"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch