s.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_organize_tabs_panel.js"], "git_node": "ac83466f050d687e82c428853c26796cb14bbe86", "git_parents": ["a5d102b60f5eb61056d834524f2a49c38e4f632c"], "node": "8b621757a1bd716941ec396086f5ee9913d8a0bc", "parents": ["3b377427c47bad05988ce9e84a112a5ebb284f55"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058218 - Add Organize Tabs telemetry events, remove deprecated ones r=omc-reviewers,aminomancer\n\nAuto Tab Grouping / 'Organize Tabs'\n\nSpec: https://docs.google.com/spreadsheets/d/1eEDfKdPECzFYQm5_gkIz8lG_t32VPrCQwO-ZMvJpUpM/edit?gid=0#gid=0\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316270\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/modules/AIWindowUI.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_organize_tabs_callout.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_open_organize_tabs_panel.js"], "git_node": "6c8b2ded193b9259f5b3b5c32456d77e971d8c47", "git_parents": ["ac83466f050d687e82c428853c26796cb14bbe86"], "node": "1932434c5490742e0db59d1b1b84cb1071240b71", "parents": ["8b621757a1bd716941ec396086f5ee9913d8a0bc"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2055446 - remove private attribution code, r=webidl,emilio,smaug,dom-core-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317545\n", "files": ["dom/base/Navigator.cpp", "dom/base/Navigator.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContent.ipdl", "dom/moz.build", "dom/origin-trials/OriginTrials.cpp", "dom/origin-trials/ffi/lib.rs", "dom/origin-trials/tests/mochitest/mochitest.toml", "dom/origin-trials/tests/mochitest/test_meta_simple.html", "dom/origin-trials/tests/mochitest/test_trial_hidden.html", "dom/origin-trials/tests/mochitest/test_trial_hidden_deprecated.html", "dom/privateattribution/PrivateAttribution.cpp", "dom/privateattribution/PrivateAttribution.h", "dom/privateattribution/PrivateAttributionIPCUtils.h", "dom/privateattribution/PrivateAttributionService.sys.mjs", "dom/privateattribution/components.conf", "dom/privateattribution/moz.build", "dom/privateattribution/nsIPrivateAttributionService.idl", "dom/privateattribution/tests/mochitest/mochitest.toml", "dom/privateattribution/tests/mochitest/test_ppa_disabled_detectable.html", "dom/privateattribution/tests/xpcshell/test_ppa.js", "dom/privateattribution/tests/xpcshell/xpcshell.toml", "dom/webidl/Navigator.webidl", "dom/webidl/PrivateAttribution.webidl", "dom/webidl/moz.build", "modules/libpref/init/StaticPrefList.yaml", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "b11e5370a34d60af7dd64e8d40b94ba9c42ad73e", "git_parents": ["6c8b2ded193b9259f5b3b5c32456d77e971d8c47"], "node": "111fcb13b6571355c879a30df0ca62d69e8c7955", "parents": ["1932434c5490742e0db59d1b1b84cb1071240b71"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2061173 - Tests. r=lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317317\n", "files": ["testing/web-platform/tests/css/printing/mask-image-print-notref.html", "testing/web-platform/tests/css/printing/mask-image-print.html", "testing/web-platform/tests/css/printing/text-shadow-blur-print.html"], "git_node": "d3691c1f149f351ba28a2b015fd7dd25ab209b1c", "git_parents": ["b11e5370a34d60af7dd64e8d40b94ba9c42ad73e"], "node": "23335e1deb970baf3ed44c9cfcfef499f28b4969", "parents": ["111fcb13b6571355c879a30df0ca62d69e8c7955"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061547 - Restrict ::-webkit-scrollbar to a pref-controlled site list. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nReplaces the per-domain blocklist with an enabled_domains_pref allowlist:\nthe pseudo-element is treated as unsupported on every domain that is not\nlisted in layout.css.fake-webkit-scrollbar.enabled-domains, so an empty\nvalue disables it everywhere and \"*\" enables it everywhere.\n\nAn empty value deliberately means \"no domain\" rather than \"every\ndomain\": once the listed sites stop relying on the pseudo-element the\nlist is meant to shrink to nothing, and draining it should leave the\nfeature off rather than silently turn it on for the whole web. That also\nmatches nsContentUtils::IsURIInList, which matches nothing for an empty\nlist. \"*\" is the escape hatch for testing, and\nlayout.css.fake-webkit-scrollbar.enabled remains the global off switch,\nso the blocklist and its plumbing are no longer needed.\n\nThe list starts with mail.google.com (bug 1973196). Its\n::-webkit-scrollbar rules live in an inline stylesheet, so the URL\nbeing matched is the document's. Slack (bug 2016775) is deliberately\nnot listed: that bug was resolved in February when Slack moved the\nnative scrollbar out of view, so it no longer relies on this feature.\nIts rules also come from a.slack-edge.com rather than slack.com, so\nlisting it would mean allowlisting a CDN.\n\nThe domains that were on the blocklist (discord.com, shitposter.world,\ngemini.google.com, content.powerapps.com) are covered by not being on\nthe allowlist.\n\nThe pre-existing ::-webkit-scrollbar reftests load over file://, which\nIsURIInList never matches, so a `defaults` line in reftest.list sets\nenabled-domains to \"*\" for them. The tests that exercise the allowlist\nitself set the list they need on their own line.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316992\n", "files": ["layout/reftests/scrolling/reftest.list", "layout/reftests/scrolling/webkit-scrollbar-allowlist-subdomain-ref.html", "layout/reftests/scrolling/webkit-scrollbar-allowlist-subdomain.html", "modules/libpref/init/StaticPrefList.yaml", "servo/components/style/gecko/pseudo_element.rs", "servo/components/style/gecko/pseudo_element_definition.mako.rs", "servo/components/style/gecko/pseudo_elements.py", "servo/components/style/gecko/pseudo_elements.toml"], "git_node": "4225b4048e5cd9b5f7434044e7d9ebd173c0d41d", "git_parents": ["d3691c1f149f351ba28a2b015fd7dd25ab209b1c"], "node": "8c6e520baf7023c41be7811a4aeb0f1790626538", "parents": ["23335e1deb970baf3ed44c9cfcfef499f28b4969"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052548 - Update icons for theme picker r=extension-reviewers,desktop-theme-reviewers,hjones,rpl\" for causing build bustages.\n\nThis reverts commit ad16525d05dcc2c77015190f831ac9777b10109b.\n", "files": ["browser/themes/shared/jar.inc.mn", "browser/themes/shared/notification-icons/local-host.svg", "toolkit/content/widgets/theme-picker/theme-picker.mjs", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-mode.mjs", "toolkit/themes/shared/desktop-jar.inc.mn", "toolkit/themes/shared/icons/local-host.svg", "toolkit/themes/shared/icons/moon.svg", "toolkit/themes/shared/icons/sun.svg"], "git_node": "c615021d596315662005f5b83ce9c8fb4a22d225", "git_parents": ["4225b404