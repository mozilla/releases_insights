": ["dom/media/webrtc/jsep/JsepSession.h", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/tests/mochitests/test_peerConnection_setLocalAnswerInHaveLocalOffer.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_setLocalAnswerInStable.html", "dom/media/webrtc/tests/mochitests/test_peerConnection_setLocalOfferInHaveRemoteOffer.html", "testing/web-platform/meta/webrtc/RTCPeerConnection-setLocalDescription-answer.html.ini"], "git_node": "6cbee7632531f8bd30e3349340f8092f0790076c", "git_parents": ["d573d849c063353bda3a67541ab219c8a548773a"], "node": "8aaf7ea877aaf1b5ff775967033a1e6e5b3e0466", "parents": ["e27ed214afc885ba37c203ec0fafac8be01fd237"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 1814460: Surface RTCError for SCTP failures. r=mjf,webidl,saschanaz,dom-worker-reviewers,asuth\n\n*Lots* of hops involved in plumbing that error through.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312838\n", "files": ["dom/media/webrtc/jsapi/RTCDataChannel.cpp", "dom/media/webrtc/jsapi/RTCDataChannel.h", "dom/webidl/RTCError.webidl", "dom/webidl/RTCErrorEvent.webidl", "dom/workers/test/test_worker_interfaces.js", "netwerk/sctp/datachannel/DataChannel.cpp", "netwerk/sctp/datachannel/DataChannel.h", "netwerk/sctp/datachannel/DataChannelDcSctp.cpp", "testing/web-platform/meta/webrtc/RTCDataChannel-close.html.ini"], "git_node": "2354187b12120a0ae0d6efb16a2a7f45b9aac918", "git_parents": ["6cbee7632531f8bd30e3349340f8092f0790076c"], "node": "a0105e99bc3732ac0e20ede74f9194ea7d329103", "parents": ["8aaf7ea877aaf1b5ff775967033a1e6e5b3e0466"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050584. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313883\n", "files": ["dom/canvas/WebGLFramebuffer.cpp", "dom/canvas/test/webgl-conf/mochitest-errata.toml"], "git_node": "117172f0e6d07fdac97eea3c645966b13fd93c45", "git_parents": ["2354187b12120a0ae0d6efb16a2a7f45b9aac918"], "node": "799a6cf048304a0e8d6e25475b988303e5574acd", "parents": ["a0105e99bc3732ac0e20ede74f9194ea7d329103"], "tags": []}, {"author": "Juliana Gaibler \u003cgit@juliana.me\u003e", "branch": "default", "desc": "Bug 2053689 - Updated .notificationbox-stack in Split View. r=desktop-theme-reviewers,tabbrowser-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314768\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "01d3542d6a5726b97f156307c2a43375d90a0e5b", "git_parents": ["117172f0e6d07fdac97eea3c645966b13fd93c45"], "node": "c319922ab3ca0b1abf44d031a056b0fc3ee2a318", "parents": ["799a6cf048304a0e8d6e25475b988303e5574acd"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055399 - Track listbox selection range by pointer. r=emilio,jjaschke,dom-core-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312759\n", "files": ["dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSelectElement.h"], "git_node": "a3d30c5a18a6540e10aeb1e4f6dc7ddda50dad0a", "git_parents": ["01d3542d6a5726b97f156307c2a43375d90a0e5b"], "node": "f6bc986d43cc13f479a5eead65b28093605260f7", "parents": ["c319922ab3ca0b1abf44d031a056b0fc3ee2a318"], "tags": []}, {"author": "Vincent Hilla \u003cvhilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055399 - Shrink listbox selection range when anchor option is removed. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312760\n", "files": ["dom/html/HTMLSelectElement.cpp", "dom/html/HTMLSelectElement.h"], "git_node": "f2143fad40a9d300db71bcfd95fa95fbb45a0cbc", "git_parents": ["a3d30c5a18a6540e10aeb1e4f6dc7ddda50dad0a"], "node": "ec0e026b2ed843ed39ed48dc6e72c2d93c10bacf", "parents": ["f6bc986d43cc13f479a5eead65b28093605260f7"], "tags": []}, {"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059015 - Revert partials to mbsdiff on beta r=yjuglaret,releng-reviewers,taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315030\n", "files": ["taskcluster/gecko_taskgraph/transforms/zucchini_partial_rollout.py"], "git_node": "b1e86bda2add900c66a34adaa5ec4add69753199", "git_parents": ["f2143fad40a9d300db71bcfd95fa95fbb45a0cbc"], "node": "6a33cf9f5e5aac9955337630b9ad2e654fff90f7", "parents": ["ec0e026b2ed843ed39ed48dc6e72c2d93c10bacf"], "tags": []}, {"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2048291 - Fixed TPS form data sync test r=skhamis,markh,credential-management-reviewers,joschmidt\n\nThe issue causing the `test_formdata.js` TPS test to fail is that the [phase 4 verifyNot check](https://searchfox.org/firefox-main/source/services/sync/tests/tps/test_formdata.js#62), which ensures that the tombstone synced from `profile1` is applied, fails.\n\n**The high-level explanation for this failure is** the logic assumes a guid should be created for new form data records, but adding new guids to incoming sync records that already have guids from the server causes future searches by sync server guid to fail. That failure to find a local record by a server guid is what prevents the synced deletion from being applied locally in this test thereby causing the \"verifyNot\" check in phase 4 to fail.\n\n**The detailed explanation is** that when form data records are added via the apply incoming step of [the sync in phase 2 on profile2](https://searchfox.org/firefox-main/source/services/sync/tests/tps/test_formdata.js#46), the guids supplied by the server are cleared in [FormHistory.update](https://searchfox.org/firefox-main/source/toolkit/components/satchel/FormHistory.sys.mjs#1138) and then reset in a later [updateFormHistoryWrite](https://searchfox.org/firefox-main/source/toolkit/components/satchel/FormHistory.sys.mjs#657) call. So after one of those records is [deleted and synced in phase3 on profile1](https://searchfox.org/firefox-main/source/services/sync/tests/tps/test_formdata.js#50,55), [the incoming tombstone is skipped](https://searchfox.org/firefox-main/source/services/sync/modules/engines.sys.mjs#1683) in the reconcile step of [the phase4 sync on profile2](https://searchfox.org/firefox-main/source/services/sync/tests/tps/test_formdata.js#59) because the guid from the server and the guid of the local record (which was reset when it was added) don't match.\n\nThe fix I'm proposing is skipping the guid reset for added records in `FormHistory.update` for form data records with populated guids, which will allow future searches of synced records by guid to be successful. **Because this fix is updating the sync code and not just the TPS test, I welcome scrutiny here.**\n\nIt's worth noting that I have successfully run the following tests locally with these changes:\n- browser/base/content/test/sanitize/\n- browser/components/backup/tests/marionette/test_backup.py\n- browser/components/extensions/test/browser/browser_ext_browsingData_formData.js\n- browser/components/migration/tests/marionette/test_refresh_firefox.py\n- browser/components/search/test/browser\n- browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_heuristics.js\n- services/sync/tests/unit/test_engine_changes_during_sync.js\n- toolkit/components/satchel/test/\n- toolkit/components/search/tests/xpcshell/test_searchSuggest.js\n- toolkit/content/tests/chrome/test_editor_for_input_with_autocomplete.html\n- toolkit/content/tests/mochitest/test_autocomplete_change_after_focus.html\n\nI also ran `browser/components/migration/tests/unit/test_Chrome_formdata.js` but it failed with and without my changes. But if there are other tests I should run, let me know.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313107\n", "files": ["toolkit/components/satchel/FormHistory.sys.mjs"], "git_node": "68f8ea7ed86f8cb4a753c55a3a8114649e83e28b", "git_parents": ["b1e86bda2add900c66a34adaa5ec4add69753199"], "node": "d3159e22f7eb818de4f29fc0ca6a6685577f84e1", "parents": ["6a33cf9f5e5aac9955337630b9ad2e654fff90f7"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045577: Clear RegexpStatics invalidation flag when successfully updating from jitcode r=spidermonkey-reviewers,anba\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314769\n", "files": ["js/src/jit-test/tests/regexp/bug2045577.js", "js/src/jit/CodeGenerator.cpp"], "git_node": "abbb2b71144fd2d13aa1d35a6d83e534d8254364", "git_parents": ["68f8ea7ed86f8cb4a753c55a3a8114649e83e28b"], "node": "9a591368aad9823880dc08e496748b364ebb1d5a", "parents": ["d3159e22f7eb818de4f29fc0ca6a6685577f84e1"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045578: Check for dense frozen elements in Proxy get trap validation r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314772\n", "files": ["js/src/jit-test/tests/proxy/bug2045578.js", "js/src/vm/NativeObject.cpp"], "git_node": "040376355b57586451f0ff28b30bd2d2dc028d7b", "git_parents": ["abbb2b71144fd2d13aa1d35a6d83e534d8254364"], "node": "20939a5a9fbcbf9bf5ca48e42f3d359d5e0de242", "parents": ["9a591368aad9823880dc08e496748b364ebb1d5a"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045299: Don't assert BaselineCompileQueue invariants while tracing r=spidermonkey-reviewers,mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314777\n", "files": ["js/src/jit-test/tests/baseline/bug2045299.js", "js/src/jit/BaselineJIT.cpp"], "git_node": "85136da0fa6856e37dbea65b0040ec1b7a6278fd", "git_parents": ["040376355b57586451f0ff28b30bd2d2dc028d7b"], "node": "66dc81fc4c6220d6328d816cffce3dd03bd7c9e4", "parents": ["20939a5a9fbcbf9bf5ca48e42f3d359d