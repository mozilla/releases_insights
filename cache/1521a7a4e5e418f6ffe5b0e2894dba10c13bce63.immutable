l.yaml"], "git_node": "462f50a5c2c314b170e42102379c1a77c4ace94f", "git_parents": ["7945bd9ae041d3a505f22a99069986d9c149051c"], "node": "9871da9591ef7d12aabc7a3086dbab1c15586904", "parents": ["64b415c7d81a8bbb5820305adc5528f222154f04"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2007697 - Make `nsRange::CutContents()` handle `ShadowRoot` and `DocumentFragment` r=smaug,dom-core-reviewers\n\n`RangeSubtreeIterator` may return a `ShadowRoot` or `DocumentFragment`\nif all children of them is selected by the range. Therefore, if it's\nlisted up, `nsRange::CutContents()` needs to delete or move all children\nof the node.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283252\n", "files": ["dom/base/nsRange.cpp", "testing/web-platform/tests/dom/ranges/Range-cloneContents-in-ShadowRoot.html", "testing/web-platform/tests/dom/ranges/Range-deleteContents-in-ShadowRoot.html", "testing/web-platform/tests/dom/ranges/Range-extractContents-in-ShadowRoot.html", "testing/web-platform/tests/dom/ranges/crashtests/Range-deleteContents-when-selecting-shadow-root-all-children.html"], "git_node": "554465a7db3b508df0bd3a877845973481812485", "git_parents": ["462f50a5c2c314b170e42102379c1a77c4ace94f"], "node": "37f3ba2e47865088c5ce5baedd0c0ee80b9b8954", "parents": ["9871da9591ef7d12aabc7a3086dbab1c15586904"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2001718 - Remove \"Add to home screen\" modal for PWAs r=android-reviewers,android-l10n-reviewers,parker,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317009\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/experimentintegration/GenericExperimentIntegrationTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/experimentintegration/SurveyExperimentIntegrationTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelper.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/FeatureSettingsHelperDelegate.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/helpers/HomeActivityTestRule.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NavigationToolbarExpandedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NavigationToolbarTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsSitePermissionsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SitePermissionsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/UnifiedTrustPanelTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/LaunchConfig.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BrowserFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/Performance.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/shortcut/PwaOnboardingDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/shortcut/PwaOnboardingObserver.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/layout/fragment_pwa_onboarding.xml", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/shortcut/PwaOnboardingObserverTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt", "mobile/android/fenix/config/detekt-baseline.xml"], "git_node": "6e92b6a06bf697af14e87f0d15beb87ed586e5c3", "git_parents": ["554465a7db3b508df0bd3a877845973481812485"], "node": "5b6df546ed7ebfaa89a9f972ff0399629df49988", "parents": ["37f3ba2e47865088c5ce5baedd0c0ee80b9b8954"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2053997 - Make `Range.deleteContents()`, `Range.cloneContents()`, `Range.extractContents()` and `Selection.deleteFromDocument()` work as in the DOM r=smaug\n\nThe spec does not mention about the flattened tree and Chrome handles\nthe range as in a DOM. E.g., unassigned node is handled, but the nodes\nin the shadow are ignored.\n\nFor the compatibility with Chrome, we should follow their behavior\nfor now.\n\nThe new tests for `Selection.deleteFromDocument` does not pass even\nwith this patch. However, we just call `nsRange::DeleteContents()` [1].\nTherefore, it may be caused by a bug of `Selection::SetBaseAndExtent()`.\nFixing it may require more changes. So, this does not fix the failures.\n\n1. https://searchfox.org/firefox-main/rev/a07b2cb8ff33387a81968a7ed9d59ebdc4dad607/dom/base/Selection.cpp#4205\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311661\n", "files": ["dom/base/CrossShadowBoundaryRange.h", "dom/base/nsRange.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/selection/shadow-dom/tentative/Selection-deleteFromDocument-around-shadow.html.ini", "testing/web-platform/tests/dom/ranges/Range-cloneContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-cloneContents-around-shadow.tentative.html", "testing/web-platform/tests/dom/ranges/Range-deleteContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-deleteContents-around-shadow.tentative.html", "testing/web-platform/tests/dom/ranges/Range-extractContents-around-shadow.html", "testing/web-platform/tests/dom/ranges/Range-extractContents-around-shadow.tentative.html", "testing/web-platform/tests/selection/shadow-dom/tentative/Selection-deleteFromDocument-around-shadow.html"], "git_node": "c0e7a7b5ddc71f1eea050af7b4c213d0d45111c2", "git_parents": ["6e92b6a06bf697af14e87f0d15beb87ed586e5c3"], "node": "c68da91726c825bf10516787425198ad29797367", "parents": ["5b6df546ed7ebfaa89a9f972ff0399629df49988"], "tags": []}, {"author": "Louis-Philippe \u003clpmanette@omnicesoft.com\u003e", "branch": "default", "desc": "Bug 2057751 - Hardware decoded videos HDR metadata aren\u2019t passed to compositor causing lack of luminance/washed colors. r=stransky,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317125\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.h", "gfx/layers/NativeLayerWayland.cpp", "gfx/layers/ipc/LayersSurfaces.ipdlh", "widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h", "widget/gtk/nsWaylandDisplay.cpp", "widget/gtk/nsWaylandDisplay.h"], "git_node": "fe77f218df48b835ad72c2de06769e5111222586", "git_parents": ["c0e7a7b5ddc71f1eea050af7b4c213d0d45111c2"], "node": "a0679b199d296b76df6c59c8fa873135c31f17e6", "parents": ["c68da91726c825bf10516787425198ad29797367"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062684 - Add \"aamtest\" test suit into subsuite map. r=jgraham\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317846\n", "files": ["testing/mozbase/moztest/moztest/resolve.py"], "git_node": "30cfcdf6d619fdbc4146d7f08101cce5cfba3366", "git_parents": ["fe77f218df48b835ad72c2de06769e5111222586"], "node": "c29f2b8fcd6664b079760a86762680ce7b59cf68", "parents": ["a0679b199d296b76df6c59c8fa873135c31f17e6"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062183 - IPDL codegen emits no-op std::move() on non-movable parameters in promise-returning Send methods r=ipc-reviewers,nika\n\nThe parameters are declared as const references, raw pointers or by-value\nSpans, so std::move() on them yields a const rvalue reference that binds\nstraight back to the copying overload. Nothing is ever moved, but the\nconstruct reads as a transfer of ownership, and Coverity takes it at face\nvalue: 15 High-impact \"Using a moved object\" defects in this scan alone\n(CIDs 1699941, 1699942, 1699945, 1699946, 1699948, 1699949, 1699951,\n1699954, 1699957, 1699958, 1699962, 1699963, 1699964, 1699965, 1699966).\n\nsendAsyncWithPromise now forwards each argument with std::forward\u003cT\u003e()\nusing the parameter type from the generated declaration, the same approach\ngenHelperCtor took in bug 2052642. Const-reference parameters stay lvalues\nand rvalue-reference ones still move, as verified by regenerating\nPWebTransportChild.cpp, PCanvasParent.cpp and PContentChild.cpp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317428\n", "files": ["ipc/ipdl/ipdl/lower.py"], "git_node": "b7be85eddd6cef8079c9c0f68269d26990ffd2ed", "git_parents": ["30cfcdf6d619fdbc4146d7f08101cce5cfba3366"], "node": "d601e78f10a6f5f3e6dfc56e41be4b4c5ad86078", "parents": ["c29f2b8fcd6664b079760a86762680ce7b59cf68"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057751 - Hardware decoded videos HDR metadata aren\u2019t passed to compositor causing lack of luminance/washed colors. r=stransky,gtk-reviewers\" for causing bustage @ TestDMABufSurface.cpp\n\nThis reverts commit fe77f218df48b835ad72c2de06769e5111222586.\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVideoFramePool.h", "gfx/layers/NativeLayerWayland.cpp", "gfx/layers/ipc/LayersSurfaces.ipdlh", "widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h", "widget/gtk/WaylandSurface.cpp", "widget/gtk/WaylandSurface.h", "widget/gtk/nsWaylandDisplay.cpp", "widget/gtk/nsWaylandDisplay.h"], "git_node": "733b7a68e16cbd1101a979502071cbd265985752", "git_parents": ["b7be85eddd6cef8079c9c0f68269d26990ffd2ed"], "node": "8ef452ee9910d9451066a77b7a586fc15e4c5c28", "parents": ["d601e78f10a6f5f3e6dfc56e41be4b4c5ad86078"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062574 - Properly credit woff2 in license file r=sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317777\n", "files": ["toolkit/content/license.html"], "git_node": "972fdcf73b714db61531a969957dab74a7146645", "git_parents": ["733b7a68e16cbd1101a979502071cbd265985752"], "node": "4fa9c6cbb7e1c582e1e688c14e3ff774d0cc1bb3", "parents": ["8ef452ee9910d9451066a77b7a586fc15e4c5c28"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061763 - Part 1: Rename main chunks lists to 'current' (vs existing 'available' lists) r=sfink\n\nNot a functional change but renames the current lists (previously just\nmixedChunks and tenuredChunks) to distinguish them from the available lists.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317728\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h"], "git_node": "4cd85d8cff3d23617da4151e6a16ae040f16fa27", "git_parents": ["972fdcf73b714db61531a969957dab74a7146645"], "node": "663240998dcffdebe413a471d334d7495b3cfc3d", "parents": ["4fa9c6cbb7e1c582e1e688c14e3ff774d0cc1bb3"], "tags": []}, {"author": "Jon Coppeard \u003cjonco@pobox.com\u003e", "branch": "default", "desc": "Bug 2061763 - Part 2: Add SlimLinkedList::removeRange r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317729\n", "files": ["js/src/ds/SlimLinkedList.h", "js/src/jsapi-tests/testLinkedList.cpp"], "git_node": "1844d0041418ef95c830a0ee9b6d4b5cf19d55be", "git_parents": ["4cd85d8cff3d23617da4151e6a16ae040f16fa27"], "node": "1d5efc6ea4104fa5fd4ea6d22c77d37cf4dd139a", "parents": ["663240998dcffdebe413a471d334d7495b3cfc3d"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061763 - Part 3: Use a single set of lists for available chunks and partition them by mixed/tenured kind r=sfink\n\nIf semispace nursery is not in use then everything live is tenured by minor\ncollection and the available mixed chunks lists will always be empty.\n\nThis changes this implementation of the avilable lists to use a single list for\nboth mixed and tenured chunks, arranged so that all mixed chunks come before\nany tenured chunks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317730\n", "files": ["js/src/gc/BufferAllocator.cpp", "js/src/gc/BufferAllocator.h", "js/src/gc/BufferAllocatorInternals.h"], "git_node": "f22c487927fd136e0a30c70d84e2a40ba236acf6", "git_parents": ["1844d0041418ef95c830a0ee9b6d4b5cf19d55be"], "node": "1782606c72d2b9c31bd0a14304a1e9fb63776df8", "parents": ["1d5efc6ea4104fa5fd4ea6d22c77d37cf4dd139a"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062246 - Add a machine-readable ChildProcessLifecycle log, r=ipc-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317927\n", "files": ["dom/ipc/ContentParent.cpp", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h"], "git_node": "b0308936856d4b70f74ca2f40603a2661cd8fbfa", "git_parents": ["f22c487927fd136e0a30c70d84e2a40ba236acf6"], "node": "3716f5d12e3b2b778386aea1c175ee79c383e522", "parents": ["1782606c72d2b9c31bd0a14304a1e9fb63776df8"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025191 - Principal validation for postMessage. r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314662\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "bc569dd9224569d0ba2e06babfb45f0f26122ea1", "git_parents": ["b0308936856d4b70f74ca2f40603a2661cd8fbfa"], "node": "2e69d02e0646aac84294c047001350405a28f4a5", "parents": ["3716f5d12e3b2b778386aea1c175ee79c383e522"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059180 - Perform cleanup for Reporting API properly r=dom-core-reviewers,dom-worker-reviewers,smaug,edenchuang\n\nRemove Reporting API metadata when a global (window or worker) is\ndestroyed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317803\n", "files": ["dom/base/nsIGlobalObject.cpp", "dom/reporting/ReportDeliver.cpp", "dom/reporting/ReportDeliver.h"], "git_node": "b1e642e86e9f023d0e1de3152c4d3c0d5175ab78", "git_parents": ["bc569dd9224569d0ba2e06babfb45f0f26122ea1"], "node": "051c85693468559c7328353c4b093242f38dee2a", "parents": ["2e69d02e0646aac84294c047001350405a28f4a5"], "tags": []}, {"author": "Kyrylo Arshuk-Popov \u003csevenwithawp@gmail.com\u003e", "branch": "default", "desc": "Bug 1642578 - Add disable/enable all breakpoints shortcut. r=bomsy,devtools-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314277\n", "files": ["devtools/client/debugger/src/components/Editor/index.js", "devtools/client/debugger/src/components/ShortcutsModal.js", "devtools/client/debugger/test/mochitest/browser_dbg-breakpoints.js", "devtools/client/debugger/test/mochitest/shared-head.js", "devtools/client/locales/en-US/debugger.properties"], "git_node": "cd15e657b3ff1aacbca4664e889fdd87c990972e", "git_parents": ["b1e642e86e9f023d0e1de3152c4d3c0d5175ab78"], "node": "285792072f214b225a460d660213034e41c2423d", "parents": ["051c85693468559c7328353c4b093242f38dee2a"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062863 - Update metadata for clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318047\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html.ini"], "