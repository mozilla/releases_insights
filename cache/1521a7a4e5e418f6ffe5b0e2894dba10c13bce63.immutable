e", "git_parents": ["2133bfcb1f10a0201344c7e5f8d3a2537e83b65f"], "node": "cdab792365a2119a574191af62e72c0a437f8eac", "parents": ["414a3c1112ee5be01b2f4678a1f7e66d1c7c572d"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053559 - Fix yaml lint failure\n", "files": [".cron.yml"], "git_node": "a5040a51d7d824914846e6d7ed52c2fc83f69db2", "git_parents": ["75bc0d62e619681018386c917c59ef636866d8ae"], "node": "419e906da04b6195fecf5edea40d52386f514159", "parents": ["cdab792365a2119a574191af62e72c0a437f8eac"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Make doc tasks clone with Git, r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317874\n", "files": ["taskcluster/kinds/source-test/doc.yml"], "git_node": "fae932d2798f8de654dcb4bb8bb9f2af75711208", "git_parents": ["a5040a51d7d824914846e6d7ed52c2fc83f69db2"], "node": "60729a01d02e4d33c7cb447bd7998722c125d83b", "parents": ["419e906da04b6195fecf5edea40d52386f514159"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058156 - Make android-l10n-lint tasks clone with Git, r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317875\n", "files": ["taskcluster/kinds/source-test/android-l10n-lint.yml"], "git_node": "5fd9932ea6612f8b3e03e1dbbe2058da51e4ef84", "git_parents": ["fae932d2798f8de654dcb4bb8bb9f2af75711208"], "node": "c3ae9e42359e5b0107c48d70d457f2f2cadb72ca", "parents": ["60729a01d02e4d33c7cb447bd7998722c125d83b"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 1724172: Eliminate graphite code from Firefox when it is rlboxed r=ahochheiden,firefox-build-system-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317626\n", "files": ["gfx/graphite2/src/moz.build", "gfx/ots/src/moz.build", "modules/woff2/moz.build"], "git_node": "a71edcddd4fa9cdc3d2ef46ec41ab72b0021be29", "git_parents": ["5fd9932ea6612f8b3e03e1dbbe2058da51e4ef84"], "node": "aef196cc32c92bd7ebcbc884c77b94efe6225486", "parents": ["c3ae9e42359e5b0107c48d70d457f2f2cadb72ca"], "tags": []}, {"author": "John Oberhauser \u003cj.git@obez.io\u003e", "branch": "default", "desc": "Bug 2062816 - Adding a deeplink for VPN settings r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317982\n", "files": ["mobile/android/fenix/app/src/main/AndroidManifest.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/GlobalDirections.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/intent/HomeDeepLinkIntentProcessor.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/intent/HomeDeepLinkIntentProcessorTest.kt"], "git_node": "1e9b82042dcdf41605c9dab5c3d69ed69ac25d67", "git_parents": ["a71edcddd4fa9cdc3d2ef46ec41ab72b0021be29"], "node": "0504bec72210f630060e950c53fa3528ec643772", "parents": ["aef196cc32c92bd7ebcbc884c77b94efe6225486"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061242 - Improve handling MFMediaEngineStream's stream descriptor. r=alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317661\n", "files": ["dom/media/platforms/wmf/MFMediaEngineStream.cpp", "dom/media/platforms/wmf/MFMediaEngineStream.h"], "git_node": "09ffb76bc70dd842f4950610c582c1db99123ef8", "git_parents": ["1e9b82042dcdf41605c9dab5c3d69ed69ac25d67"], "node": "d0f704affa9bc9481559bd71a83073232a9ed7c1", "parents": ["0504bec72210f630060e950c53fa3528ec643772"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061242 - Improve accessing MFMediaEngineStream's parent source. r=alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317662\n", "files": ["dom/media/platforms/wmf/MFMediaEngineStream.cpp", "dom/media/platforms/wmf/MFMediaEngineStream.h"], "git_node": "1cc37850074d6538884c7ce4ff6df3501b344572", "git_parents": ["09ffb76bc70dd842f4950610c582c1db99123ef8"], "node": "4ac9dc6aea78cd7dd2bf7c98f2ccd72575fc514e", "parents": ["d0f704affa9bc9481559bd71a83073232a9ed7c1"], "tags": []}, {"author": "Emily McDonough \u003cemcdonough@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038957 - Create a Skrifa font whenever we construct a font through fontconfig r=jfkthame\n\nA later patch will merge together how skrifa fonts and supporting memory is\nmanaged by gfxFontEntry, etc.\n\nThis code is fully gated behind the --enable-fontations configure flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315743\n", "files": ["gfx/thebes/gfxFcPlatformFontList.cpp", "gfx/thebes/gfxFcPlatformFontList.h"], "git_node": "4c44cc2f2d2ea4a5faa748ce20ec6d267418d1fa", "git_parents": ["1cc37850074d6538884c7ce4ff6df3501b344572"], "node": "34c27d3f227688f2ee9f5bcf89bb61b9de7236a4", "parents": ["4ac9dc6aea78cd7dd2bf7c98f2ccd72575fc514e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Make `./mach uniffi generate` `AUTOCLOBBER` its own objdir r=firefox-build-system-reviewers,nalexander\n\nTo do this cleanly, we need to move where the `mozconfig` lives, otherwise\n`AUTOCLOBBER` nukes it. It can just live in tree and we can point to it with\n`MOZCONFIG`. For good measure we move the `MOZ_OBJDIR` out of the mozconfig\nto `env`, so that we don't need to specify it in two places.\n\nWe also drop the explicit `./mach configure` call, since `./mach build`\nhandles it automatically.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318275\n", "files": ["toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py", "toolkit/components/uniffi-bindgen-gecko-js/uniffi-mozconfig"], "git_node": "7210df8fb6ce8a24d85af0dc470705fff326fe7d", "git_parents": ["4c44cc2f2d2ea4a5faa748ce20ec6d267418d1fa"], "node": "8ee57375c847b962259efe6347ba75f0c6383a9b", "parents": ["34c27d3f227688f2ee9f5bcf89bb61b9de7236a4"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2049606 - Avoid VPX hardware encoding on Windows for realtime applications unless hardware is forced. r=media-playback-reviewers,padenot\" for breaking VP9 realtime encoding\n\nThis reverts commit 13574a93692205224a75b9c4f720dc7c89aeaa0d.\n", "files": ["dom/media/platforms/wmf/WMFDataEncoderUtils.cpp"], "git_node": "d5edb5826ca85f2d2af10976059ee44e6ed7e24f", "git_parents": ["7210df8fb6ce8a24d85af0dc470705fff326fe7d"], "node": "47d97fae349c16d5aaf0e2c6fe809188cd79ba95", "parents": ["8ee57375c847b962259efe6347ba75f0c6383a9b"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2044882 - Recover resources based on encryption state. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318196\n", "files": ["browser/components/backup/BackupService.sys.mjs", "browser/components/backup/tests/xpcshell/test_BackupService_recoverFromSnapshotFolder.js"], "git_node": "d42b5220fa3df33bee3aaed269a3b945c1dc7886", "git_parents": ["d5edb5826ca85f2d2af10976059ee44e6ed7e24f"], "node": "20b4e092038aff702172342c01119ff07b53ae32", "parents": ["47d97fae349c16d5aaf0e2c6fe809188cd79ba95"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059920 - Add check for Taskbar pinning being blocked by Group Policy. r=hsohaney\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315771\n", "files": ["browser/components/shell/rust/shell_windows/src/taskbar/mod.rs", "browser/components/shell/test/unit/test_taskbarPinningPolicy.js", "browser/components/shell/test/unit/xpcshell.toml"], "git_node": "b546313a4058f078c9b24a2722a5f8c4bdab7a1d", "git_parents": ["d42b5220fa3df33bee3aaed269a3b945c1dc7886"], "node": "8cc395285b07a510bb912ffb8759a1f1e6a090d5", "parents": ["20b4e092038aff702172342c01119ff07b53ae32"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059894 - Add granularity to Taskbar pinning via WinRT checks. r=hsohaney\n\nThis now checks `ITaskbarManagerDesktopAppSupportStatics`, which more accurately captures whether the pin-to-taskbar APIs will work for Win32 desktop apps.\n\nThis makes a best effort to respect when the OS reports that pinning is not allowed, with an exception for cases where it's ambiguous whether we could pin with additional setup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315772\n", "files": ["browser/components/shell/rust/shell_windows/src/taskbar/mod.rs", "browser/components/shell/rust/shell_windows/src/taskbar/winrt.rs"], "git_node": "64df5742a104c556d2fadd6a5a0673eb11c504c5", "git_parents": ["b546313a4058f078c9b24a2722a5f8c4bdab7a1d"], "node": "53c71ea7b12d8575ea092198e9f9524844766f33", "parents": ["8cc395285b07a510bb912ffb8759a1f1e6a090d5"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059888 - Don't check if COM Taskbar pinning API is available for MSIX. r=hsohaney\n\nWhile this API might be usable for MSIX, we likely don't want to use it there given we have no way to clean it up on uninstall.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315773\n", "files": ["browser/components/shell/rust/shell_windows/src/taskbar/mod.rs"], "git_node": "7565ca69c3efeb9855cd7587636f540cc9202b24", "git_parents": ["64df5742a104c556d2fadd6a5a0673eb11c504c5"], "node": "d673b8d9aa6d38555a12764c87608baecc5c7a81", "parents": ["53c71ea7b12d8575ea092198e9f9524844766f33"], "tags": []}, {"author": "Nicholas Rishel \u003cnrishel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060777 - Reject attempts to pin non-default AUMIDs in MSIX. r=hsohaney\n\nTagalong comment cleanup to clarify how we could prevent this case, plus a log\nmessage pointing at the alternative API to use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316593\n", "files": ["browser/components/shell/rust/shell_windows/src/taskbar/mod.rs"], "git_node": "082d0c57575bbf780464b0684dad35f57c2f690d", "git_parents": ["7565ca69c3efeb9855cd7587636f540cc9202b24"], "node": "0b0305ad09021f11f001cb6615dce119cef7ca15", "parents": ["d673b8d9aa6d38555a12764c87608baecc5c7a81"], "tags": []}, {"author": "Christopher DiPersio \u003ccdipersio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062278 - Memories Scheduler watermark is set to the timestamp of the session's last event r=cmurray\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317669\n", "files": ["browser/components/aiwindow/models/memories/MemoriesManager.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesSchedulers.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_MemoriesManager.js", "browser/components/aiwindow/models/tests/browser/browser_MemoriesSchedulers.js", "browser/components/aiwindow/services/MemoryStore.sys.mjs", "browser/components/aiwindow/services/tests/xpcshell/test_MemoryStore.js"], "git_node": "1f1514d1c2a8b04022742a30980a872a8c9ff444", "git_parents": ["082d0c57575bbf780464b0684dad35f57c2f690d"], "node": "33cfb106dc0df4e6b8e38f7f09cdeb22f0df1b33", "parents": ["0b0305ad09021f11f001cb6615dce119cef7ca15"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1697626 - Wait for the extension onRequestFinished listener to be registered before navigating in browser_ext_devtools_network.js, and re-enable the test, r=extension-reviewers,rpl.\n\nRegistering the listener is asynchronous on the parent side and the test\nnavigates immediately after asking for it, so PAYLOAD_READY can be emitted and\ndropped before the listener exists. The test navigates only once, so it then\nwaits forever. Poll hasRequestFinishedListeners() before navigating.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317522\n", "files": ["browser/components/extensions/test/browser/browser-devtools.toml", "browser/components/extensions/test/browser/browser_ext_devtools_network.js"], "git_node": "8d4649fa08d9846bfa31562f91e087e7b5cf4b89", "git_parents": ["1f1514d1c2a8b04022742a30980a872a8c9ff444"], "node": "802baea6b91567af95cf520bc9ea78d66209146a", "parents": ["33cfb106dc0df4e6b8e38f7f09cdeb22f0df1b33"], "tags": []}, {"author": "Jared Hirsch \u003cohai@6a68.net\u003e", "branch": "default", "desc": "Bug 2063104 - Include referral ID when sharing Firefox from settings page r=tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318287\n", "files": ["browser/components/preferences/config/account-sync.mjs"], "git_node": "3e9179a5a082d6217776d7ac7f9dbec04350a7d1", "git_parents": ["8d4649fa08d9846bfa31562f91e087e7b5cf4b89"], "node": "3b254e4ee358b851f12401740072c1ea5677286e", "parents": ["802baea6b91567af95cf520bc9ea78d66209146a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Add BrowserTestUtils.activateMenuItem and selectMenulistItem, r=Gijs,firefox-desktop-core-reviewers .\n\nActivating a menu item takes three steps: start waiting for the menu to close,\ncall activateItem, then await. Opening a menulist first adds two more. The\ntests fixed in this bug were each about to grow their own copy, and one of\nthem already had a local selectMenulistItem helper.\n\nBoth take only the item and find the menupopup, and the menulist, from it.\n\nClicking the item instead, which is what those tests were doing, does not work\nwhile the menu is still opening: its items are not focusable and not exposed\nto the accessibility APIs until it is open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318034\n", "files": ["testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "d7b7e188bc7ba10f4276e0ed2636dd8994f0b3c9", "git_parents": ["3e9179a5a082d6217776d7ac7f9dbec04350a7d1"], "node": "83382554a11f0f8b498aeec3f980189011ed4dfc", "parents": ["3b254e4ee358b851f12401740072c1ea5677286e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Wait for the migration wizard's selector panel to be open before clicking an item, r=migration-reviewers,Gijs.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318035\n", "files": ["browser/components/migration/tests/browser/browser.toml", "browser/components/migration/tests/browser/browser_disabled_migrator.js", "browser/components/migration/tests/browser/browser_file_migration.js", "browser/components/migration/tests/browser/head.js"], "git_node": "5a104d2260a89ecb5c8f669559c79e692dc12ca8", "git_parents": ["d7b7e188bc7ba10f4276e0ed2636dd8994f0b3c9"], "node": "8a479a3f0bd651af1bfda1fc506288ec79bdb208", "parents": ["83382554a11f0f8b498aeec3f980189011ed4dfc"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Open the permission menulist before selecting an item in browser_popup_blocker_identity_block.js, r=permissions-reviewers,emz.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318037\n", "files": ["browser/base/content/test/popups/browser_popup_blocker_identity_block.js"], "git_node": "bcdce3e0796e9bdcd94f73a548eaddcda00a16e3", "git_parents": ["5a104d2260a89ecb5c8f669559c79e692dc12ca8"], "node": "dd4960ac3e199d98b9c037666f3926bbe055b1e1", "parents": ["8a479a3f0bd651af1bfda1fc506288ec79bdb208"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Open the menulists before selecting items in the preferences tests, r=Gijs.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nbrowser_browser_languages_subdialog.js was calling doCommand() on a menuitem of\na menulist it never opened, then hidePopup() on the closed popup. Open the\nmenulist and activate the item instead, so the test goes through the same path\na user does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318038\n", "files": ["browser/components/preferences/tests/etp/browser_contentblocking.js", "browser/components/preferences/tests/languages/browser_browser_languages_subdialog.js", "browser/components/preferences/tests/languages/browser_languages_subdialog.js"], "git_node": "c5146aca54e022c84c29ec822ec7ddcd575d3ea7", "git_parents": ["bcdce3e0796e9bdcd94f73a548eaddcda00a16e3"], "node": "470c0af8880f203b6e923e3bdc3fac6fd33f751b", "parents": ["dd4960ac3e199d98b9c037666f3926bbe055b1e1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Activate context menu items from an open menu in the tab tests, r=tabbrowser-reviewers,kcochrane.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nThe tests that go on to activate an item now check the item visibility against\nthe menu they activate it from, rather than opening the menu once through\nupdateTabContextMenu() for the checks and again for the activation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318039\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_pin_unpin.js", "browser/components/tabbrowser/test/browser/tabs/browser_multiselect_tabs_reload.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js"], "git_node": "a3fde618a9404e3c39ffc8b5724b98315e9fd981", "git_parents": ["c5146aca54e022c84c29ec822ec7ddcd575d3ea7"], "node": "5c311cf2db4b7fce67dbadf8ed2150811fd99ee7", "parents": ["470c0af8880f203b6e923e3bdc3fac6fd33f751b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Wait for the reopened webRTC doorhanger to be shown before clicking it, r=tabbrowser-reviewers,dao.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318042\n", "files": ["browser/base/content/test/webrtc/browser_devices_get_user_media.js"], "git_node": "cd6ffccd5dd3cfdf521e76c0e1bbfcd03f872939", "git_parents": ["a3fde618a9404e3c39ffc8b5724b98315e9fd981"], "node": "d1bf3756db6274fb7819be7ef8965e4d2c591fd0", "parents": ["5c311cf2db4b7fce67dbadf8ed2150811fd99ee7"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Wait for the update doorhanger to be open in browser_discardUpdateNotif.js, r=application-update-reviewers,yjuglaret.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318043\n", "files": ["toolkit/mozapps/update/tests/browser/browser_discardUpdateNotif.js"], "git_node": "9c9d5a993b17d3ffd6245a157735493a06f84a35", "git_parents": ["cd6ffccd5dd3cfdf521e76c0e1bbfcd03f872939"], "node": "0d1cddc678b501558fa6f00b35f379e8f262c2b3", "parents": ["d1bf3756db6274fb7819be7ef8965e4d2c591fd0"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062572 - Wait for the popups the urlbar tests open to be shown before clicking in them, r=urlbar-reviewers,dao.\n\nWaiting for the popup to be open before interacting with its contents. Its\ncontents are invisible to the accessibility APIs and not focusable before that,\nwhich is the intermittent \"Node is not focusable via the accessibility API\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318044\n", "files": ["browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_selection.js"], "git_node": "c2828f677e643714500d55f98c81736e2dcc28f1", "git_parents": ["9c9d5a993b17d3ffd6245a157735493a06f84a35"], "node": "b53629f604527f0d6f0bb598ce240da4c91d3e9f", "parents": ["0d1cddc678b501558fa6f00b35f379e8f262c2b3"], "tags": []}, {"author": "Harrison Oglesby \u003coglesby.harrison@gmail.com\u003e", "branch": "default", "desc": "Bug 2062793 - Report install referral codes on a separate ping and exclude them from attribution r=android-reviewers,jhirsch,data-stewards,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317978\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/pings.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/InstallReferrerWorker.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/metrics/ReferralAttribution.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/InstallReferrerWorkerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/metrics/ReferralAttributionTest.kt"], "git_node": "868f519c72dd0663cfb77d4783af441ae9c1e2a1", "git_parents": ["c2828f677e643714500d55f98c81736e2dcc28f1"], "node": "1958bb635fe9eca10d4924296430cd0d280ace31", "parents": ["b53629f604527f0d6f0bb598ce240da4c91d3e9f"], "tags": []}, {"author": "Chris DuPuis \u003ccdupuis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058020 - Use Windows Runtime API to find MSIX app launch method r=aborondo,win-reviewers,browser-installer-reviewers,mossop,nrishel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316649\n", "files": ["browser/app/winlauncher/LauncherProcessWin.cpp", "browser/app/winlauncher/moz.build", "browser/installer/windows/msix/AppxManifest.xml.in"], "git_node": "ec2ab92b87822af8a58a225d59a763a3fd42c1bb", "git_parents": ["868f519c72dd0663cfb77d4783af441ae9c1e2a1"], "node": "52ef9de9b470b388d187fdfd3ab73603e07663a2", "parents": ["1958bb635fe9eca10d4924296430cd0d280ace31"], "tags": []}, {"author": "Greg Stoll \u003cgstoll@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062316 - Show tab-modal prompts from the chatbot sidebar browser as tab dialogs again r=dlp-reviewers,echa,handyman\n\nSeparate the concepts of whether something is embedded in the sidebar versus whether\ntab dialog boxes should get shown there. Also add a test as this is historically a fragile\narea.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317812\n", "files": ["browser/actors/PromptParent.sys.mjs", "browser/components/genai/tests/browser/browser_chat_sidebar.js"], "git_node": "259146e75e9cd01632b3371f95d543bcc1744ebd", "git_parents": ["ec2ab92b87822af8a58a225d59a763a3fd42c1bb"], "node": "9832cd6787b3aba006734ebb2cc725f100bf9ca4", "parents": ["52ef9de9b470b388d187fdfd3ab73603e07663a2"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062970. Restore third_party/picosha2/README.md to upstream. r=glandium\n\nBug 1840493 changed the code fences in this file from c++ to cpp as part of a tree-wide\ndocumentation sweep. picosha2 is vendored, this file is not part of our documentation\nbuild, and nothing lints it, so the only effect was that picosha2 stopped re-vendoring\nto what is committed.\n\nThat sweep touched exactly two vendored files. The other, third_party/function2/Readme.md,\nhad the same change silently overwritten by the update in bug 1881970 two months later,\nwhich is why function2 still re-vendors cleanly.\n\nWith this, `./mach vendor third_party/picosha2/moz.yaml -r\n27fcf6979298949e8a462e16d09a0351c18fcaf2 --patch-mode check --force` reproduces the\ncommitted tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318105\n", "files": ["third_party/picosha2/README.md"], "git_node": "2f603b6be05c16a391c37708686aae1a8793a9cd", "git_parents": ["259146e75e9cd01632b3371f95d543bcc1744ebd"], "node": "746adf2ba516dc3d44b7db233bf777d00dc2912e", "parents": ["9832cd6787b3aba006734ebb2cc725f100bf9ca4"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062981. Point nimbus schemas' revision at what is actually vendored. r=nimbus-reviewers,beth\n\nBug 1960386 vendored mozilla-nimbus-schemas v3001 by updating the three schema files and\nchanging release from \"version 2025.1.1\" to \"version 3001.0.0\", but left revision at\nfa4a7e30, a commit from February. So re-vendoring fetched the older schemas and could not\nreproduce what is committed: the tree has fields, such as allowCoenrollment, that the\npinned revision does not.\n\nPoint revision at bfa19cb37b8e, the last upstream change to these schemas before that\nvendoring, which reproduces all three files exactly, and record the package version in a\ncomment instead.\n\nThe release and revision lines are left in the exact form `mach vendor` writes them,\nrather than as a hand-written string like \"version 3001.0.0\". `mach vendor` rewrites both\nlines every time it runs, so a hand-written value is replaced the next time anyone\nre-vendors, and the file ends up modified without anyone having edited it.\n\nWith this, `./mach vendor toolkit/components/nimbus/schemas/moz.yaml -r\nbfa19cb37b8e818a2ee218aa71251aca1caa19fa --patch-mode check --force` reproduces the\ncommitted tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318119\n", "files": ["toolkit/components/nimbus/schemas/moz.yaml"], "git_node": "09f59c80baebe714af240e6e947b482a6145377e", "git_parents": ["2f603b6be05c16a391c37708686aae1a8793a9cd"], "node": "910cbefe0b67db577794f8eeb7ddd882f2b9a1e2", "parents": ["746adf2ba516dc3d44b7db233bf777d00dc2912e"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062557. Don't leave mach vendor in a deleted directory when a tag lookup fails. r=tjr\n\nupstream_tag() clones the repository into a temporary directory, moved the\nprocess into it with os.chdir(), and restored the original directory only on the\nsuccess path. When the tag lookup fails, the temporary directory is deleted while\nthe process is still inside it, so anything that later resolves a relative path\nfails.\n\nBug 2056506 made that reachable: a tag-tracking library pinned to a commit hash\nnow falls back to resolving the hash as a commit, and vendoring then failed while\ncopying the upstream files into the library's (relative) vendor-directory:\n\n    FileNotFoundError: [Errno 2] No such file or directory: 'media'\n\nPass cwd= to the git commands instead of moving the process, so there is no\ndirectory state left to restore on any path out of the function. media/libwebp\n(tag tracking, pinned to an untagged commit on its release branch) reconstructs\ncleanly with this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317746\n", "files": ["python/mozbuild/mozbuild/vendor/host_base.py"], "git_node": "c4693e19154faf3440e3755d6093bcf9207024ad", "git_parents": ["09f59c80baebe714af240e6e947b482a6145377e"], "node": "e5c0c7d6b6e7f12592dd36d9eda5cd3dd1c69214", "parents": ["910cbefe0b67db577794f8eeb7ddd882f2b9a1e2"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-zh-rCN/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-ug/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-zh-rCN/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-ar/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-dsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rCL/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ka/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rBR/strings.xml", "mobile/android/fenix/app/src/main/res/values-pt-rPT/strings.xml", "mobile/android/fenix/app/src/main/res/values-ru/strings.xml", "mobile/android/fenix/app/src/main/res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-tg/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-ug/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "582eeef4db53f1a4cbad5d22742586115feed460", "git_parents": ["c4693e19154faf3440e3755d6093bcf9207024ad"], "node": "8df9ab448812cfede1a79bc1e5331173e43acaf0", "parents": ["e5c0c7d6b6e7f12592dd36d9eda5cd3dd1c69214"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062487 - Stop disabling Overdraw for the two browser menu components. r=android-reviewers,adhingra\n\nEach component switched the check off for its whole module, which also hid anything introduced later.\nOnly three layouts actually report, and all of them paint a ripple that the check mistakes for a\nredundant background because a library has no theme of its own to compare against, so suppress those\nthree individually instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317703\n", "files": ["mobile/android/android-components/components/browser/menu/lint.xml", "mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_button.xml", "mobile/android/android-components/components/browser/menu2/lint.xml", "mobile/android/android-components/components/browser/menu2/src/main/res/layout/mozac_browser_menu2_button.xml", "mobile/android/android-components/components/browser/menu2/src/main/res/layout/mozac_browser_menu2_candidate_row_small_icon.xml"], "git_node": "62f3a39b0ed863ac7f3a0e32b85fa6e52995b916", "git_parents": ["582eeef4db53f1a4cbad5d22742586115feed460"], "node": "c1c2387e37f2760af43816fb9f4c5064198cf52b", "parents": ["8df9ab448812cfede1a79bc1e5331173e43acaf0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062487 - Share one lint configuration between Fenix and Focus. r=android-reviewers,adhingra\n\nThe two applications had grown separate rule sets that largely agreed, with Focus missing the performance\nand correctness rules Fenix had accumulated over time. Merge them into a single file, which leaves Fenix\nreporting the same findings it did before and adds one finding to Focus. The file is deliberately not named\nlint.xml, so that it only ever applies where something references it.\n\nMoving the file out of the two application directories also takes it out of the paths that decide\nwhether each application's lint tasks run, so name it explicitly in both, or a change to the rules\nthey share would schedule nothing.\n\nLongfox lives inside the Fenix application directory and had been picking up the Fenix rules purely by\nsitting below them, so it needs a reference of its own once that file is gone.\n\nOverdraw had been sitting in a tier of its own, marked as something to escalate to error eventually, at a\nseverity that matched what lint gives it anyway. Neither application reports it, so make good on that note\nnow and move it up with the rest of the escalated performance checks rather than leave behind a marker\nnobody will come back to.\n\nThe shared file also silences the note lint emits about the findings a baseline filtered out. That note\nis informational, but the review bot reads the report and raises it as a finding of its own, which\nandroid-components and GeckoView already avoid the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317704\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/lint.xml", "mobile/android/fenix/app/longfox/build.gradle", "mobile/android/focus-android/app/build.gradle", "mobile/android/focus-android/app/lint.xml", "mobile/android/shared-lint.xml", "taskcluster/kinds/source-test/android-lint.yml", "taskcluster/kinds/source-test/mozlint-android.yml", "tools/lint/android-fenix.yml", "tools/lint/android-focus.yml"], "git_node": "1101153c3de2347be4dc16b0a6d6be7d533071a5", "git_parents": ["62f3a39b0ed863ac7f3a0e32b85fa6e52995b916"], "node": "5b2aa523eef2e9a04c8887161d8f1e5a4b8f6a1c", "parents": ["c1c2387e37f2760af43816fb9f4c5064198cf52b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062487 - Remove Android lint suppressions that no longer suppress anything. r=android-reviewers,adhingra\n\nSuppressions accumulate and are never revisited, so a good number of them now sit on code that the\nchecks stopped objecting to, where they hide nothing and mislead the next reader. Find them by removing\nevery suppression in a project, running lint, and keeping only the ones something actually reported\nagainst.\n\nSites in source sets or modules the run does not analyse are left alone, since absence of a finding\nproves nothing there, as are the WrongThread ones, which turn out to also suppress ThreadConstraint.\n\nThe shared configuration had never been through the same audit, so run it there too. Three of its\npath-scoped ignores match nothing their check reports and one names a support library the tree stopped\nusing long ago, while three severity entries name the severity lint already applies to a check it\nalready enables, so they configure nothing at all. The two jar ignores go on weaker evidence: the check\nbehind them reports nothing in either application and nothing here can make it report, but if it ever\ndoes it names the jar it is unhappy about, which is cheap enough to put back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317705\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/NestedGeckoView.kt", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorPages.kt", "mobile/android/android-components/components/browser/menu/src/main/java/mozilla/components/browser/menu/view/StickyItemLayoutManager.kt", "mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_highlightable_item.xml", "mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_highlightable_switch.xml", "mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_item_image_text.xml", "mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_item_image_text_checkbox_button.xml", "mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_item_parent_menu.xml", "mobile/android/android-components/components/browser/menu2/src/main/res/layout/mozac_browser_menu2_candidate_compound_checkbox.xml", "mobile/android/android-components/components/browser/menu2/src/main/res/layout/mozac_browser_menu2_candidate_compound_switch.xml", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/content/PermissionHighlightsState.kt", "mobile/android/android-components/components/concept/base/src/main/java/mozilla/components/concept/base/crash/Breadcrumb.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/permission/SitePermissions.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/prompt/ShareData.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/identitycredential/Account.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/identitycredential/Provider.kt", "mobile/android/android-components/components/concept/storage/src/main/java/mozilla/components/concept/storage/CreditCardsAddressesStorage.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/Addon.kt", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_fragment_dialog_addon_permissions.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_item.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_permissions_domain_item.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_permissions_required_data_collection_permissions_item.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_permissions_required_item.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_unsupported_item.xml", "mobile/android/android-components/components/feature/app-links/src/main/java/mozilla/components/feature/app/links/AppLinksInterceptor.kt", "mobile/android/android-components/components/feature/autofill/src/main/java/mozilla/components/feature/autofill/handler/FillRequestHandler.kt", "mobile/android/android-components/components/feature/downloads/src/main/java/mozilla/components/feature/downloads/ui/DownloaderApp.kt", "mobile/android/android-components/components/feature/downloads/src/main/res/layout/mozac_download_app_list_item.xml", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/dialog/AbstractPromptTextDialogFragment.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/dialog/AuthenticationDialogFragment.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/dialog/TextPromptDialogFragment.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/widget/MonthAndYearPicker.kt", "mobile/android/android-components/components/feature/prompts/src/main/res/layout/mozac_feature_prompt_auth_prompt.xml", "mobile/android/android-components/components/feature/toolbar/src/main/res/drawable/mozac_feature_toolbar_ic_vacation.xml", "mobile/android/android-components/components/service/digitalassetlinks/src/main/java/mozilla/components/service/digitalassetlinks/AndroidAssetFinder.kt", "mobile/android/android-components/components/service/pocket/src/main/java/mozilla/components/service/pocket/GlobalDependencyProvider.kt", "mobile/android/android-components/components/support/test-fakes/src/main/java/mozilla/components/support/test/fakes/android/FakeContext.kt", "mobile/android/android-components/components/support/utils/src/main/AndroidManifest.xml", "mobile/android/android-components/components/support/utils/src/main/java/mozilla/components/support/utils/Browsers.kt", "mobile/android/android-components/components/support/utils/src/main/res/drawable/ic_cc_logo_diners.xml", "mobile/android/android-components/components/support/utils/src/main/res/drawable/ic_cc_logo_unionpay.xml", "mobile/android/android-components/components/support/utils/src/main/res/drawable/ic_cc_logo_visa.xml", "mobile/android/android-components/components/ui/tabcounter/src/main/res/drawable/mozac_ui_infinite_tabcounter_box.xml", "mobile/android/android-components/samples/acorn-components/src/main/AndroidManifest.xml", "mobile/android/android-components/samples/browser/src/main/AndroidManifest.xml", "mobile/android/android-components/samples/browser/src/main/res/layout/fragment_browser.xml", "mobile/android/android-components/samples/compose-browser/src/main/AndroidManifest.xml", "mobile/android/android-components/samples/crash/src/main/AndroidManifest.xml", "mobile/android/android-components/samples/glean/src/main/AndroidManifest.xml", "mobile/android/android-components/samples/glean/src/main/res/layout/activity_main.xml", "mobile/android/android-components/samples/sync/src/main/AndroidManifest.xml", "mobile/android/android-components/samples/toolbar/src/main/AndroidManifest.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionsProcessDisabledForegroundController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/infobanner/InfoBanner.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/tabstrip/TabStrip.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/experiments/ResearchSurfaceDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/controller/TopSiteController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/WallpaperOnboardingDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/wallpaper/WallpaperSettings.kt", "mobile/android/fenix/app/src/main/res/drawable/ic_etp_artwork.xml", "mobile/android/fenix/app/src/main/res/layout/address_select_bar.xml", "mobile/android/fenix/app/src/main/res/layout/creditcard_select_bar.xml", "mobile/android/fenix/app/src/main/res/layout/fragment_add_on_internal_settings.xml", "mobile/android/fenix/app/src/main/res/layout/fragment_browser.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_gradient_blue_hour.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_gradient_golden_hour.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_gradient_midnight.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_gradient_northern_lights.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_gradient_sunrise.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_gradient_sunset.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_gradient_twilight.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_solid_blue.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_solid_dark.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_solid_green.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_solid_light.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_solid_purple.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_solid_purple_dark.xml", "mobile/android/fenix/app/src/main/res/mipmap-anydpi/ic_launcher_solid_red.xml", "mobile/android/focus-android/app/src/main/res/layout/activity_main.xml", "mobile/android/focus-android/app/src/main/res/layout/item_app.xml", "mobile/android/focus-android/app/src/main/res/layout/item_install_banner.xml", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoNetworkManager.java", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/Sample.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoFontScaleListener.java", "mobile/android/shared-lint.xml"], "git_node": "f46583cd21065bd5063cc66b0f9da5c668df8b0c", "git_parents": ["1101153c3de2347be4dc16b0a6d6be7d533071a5"], "node": "c7a9729027c98edd226d9568c9c48507f29ca92d", "parents": ["5b2aa523eef2e9a04c8887161d8f1e5a4b8f6a1c"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062487 - Stop suppressing Android lint findings that we ought to be fixing. r=android-reviewers,adhingra\n\nGoing through the suppressions that do still hide a finding, most of them are hiding something the check\nhas no way of knowing: widget layouts cannot use AppCompat attributes, a browser has to permit cleartext,\na custom tabs service has to be exported unprotected, and a root view that something looks up by id\ncannot become a merge tag. Those are worth keeping.\n\nThe rest are ordinary gaps, so drop their suppressions and let the baseline record them as work: images\nwith no description, an inconsistent gravity, a prompt field with no autofill setting, two layouts nested\nfor no reason, and two manifests that configure backup for Android 12 but not for the versions below it.\nAlso move one suppression off a root element, where it was quietly covering everything beneath it, onto\nthe single view that needs it.\n\nOne is worth fixing outright rather than recording. A Focus preference key is written across three lines,\nand the leading whitespace is the whole of what the check objects to; writing it inline like its seventy\nneighbours removes the finding and the ignore that hid it, which sharing the configuration had extended\nto Fenix as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317706\n", "files": ["mobile/android/android-components/components/browser/menu/src/main/res/layout/mozac_browser_menu_web_extension.xml", "mobile/android/android-components/components/browser/toolbar/src/main/res/layout/mozac_browser_toolbar_displaytoolbar.xml", "mobile/android/android-components/components/browser/toolbar/src/main/res/layout/mozac_browser_toolbar_edittoolbar.xml", "mobile/android/android-components/components/feature/addons/src/main/res/layout/mozac_feature_addons_header_section_item.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/layout/mozac_feature_text_prompt.xml", "mobile/android/android-components/samples/browser/src/main/res/layout/fragment_browser.xml", "mobile/android/android-components/samples/compose-browser/src/main/AndroidManifest.xml", "mobile/android/android-components/samples/dataprotect/src/main/AndroidManifest.xml", "mobile/android/android-components/samples/sync-logins/src/main/res/layout/activity_main.xml", "mobile/android/android-components/samples/sync/src/main/res/layout/activity_main.xml", "mobile/android/focus-android/app/src/main/res/values/preference_keys.xml", "mobile/android/shared-lint.xml"], "git_node": "4ec138fdb02d8f8aa454d2db6aace70a7a30ff41", "git_parents": ["f46583cd21065bd5063cc66b0f9da5c668df8b0c"], "node": "694ae6c4dd718bd15e1407e72cf237e26f975914", "parents": ["c7a9729027c98edd226d9568c9c48507f29ca92d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062487 - Refresh the Android lint baselines. r=android-reviewers,adhingra\n\nThe growth is the findings whose suppressions came off earlier in this stack, recorded here so that the\nwork they were hiding is visible somewhere, plus the single finding Focus picks up from the shared\nconfiguration.\n\nOne entry is not ours: a JUnitAssertNotNull warning that has been in the tree for a while without ever\nreaching a baseline, and which the refresh picks up along the way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317707\n", "files": ["mobile/android/android-components/components/browser/menu/lint-baseline.xml", "mobile/android/android-components/components/browser/toolbar/lint-baseline.xml", "mobile/android/android-components/components/feature/ipprotection/lint-baseline.xml", "mobile/android/android-components/components/feature/prompts/lint-baseline.xml", "mobile/android/android-components/samples/browser/lint-baseline.xml", "mobile/android/android-components/samples/compose-browser/lint-baseline.xml", "mobile/android/android-components/samples/dataprotect/lint-baseline.xml", "mobile/android/android-components/samples/sync-logins/lint-baseline.xml", "mobile/android/android-components/samples/sync/lint-baseline.xml", "mobile/android/fenix/app/lint-baseline.xml", "mobile/android/focus-android/app/lint-baseline.xml", "mobile/android/geckoview/lint-baseline.xml"], "git_node": "492ee7ea0876bc97cecc03371daf16bceb465931", "git_parents": ["4ec138fdb02d8f8aa454d2db6aace70a7a30ff41"], "node": "56d64cc674f6621755f8ebb72f4cb76b11af28b7", "parents": ["694ae6c4dd718bd15e1407e72cf237e26f975914"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058020 - Use Windows Runtime API to find MSIX app launch method r=aborondo,win-reviewers,browser-installer-reviewers,mossop,nrishel\" for causing browser-chrome msix failures.\n\nThis reverts commit ec2ab92b87822af8a58a225d59a763a3fd42c1bb.\n", "files": ["browser/app/winlauncher/LauncherProcessWin.cpp", "browser/app/winlauncher/moz.build", "browser/installer/windows/msix/AppxManifest.xml.in"], "git_node": "d68039fa3f5fd6ca397553ea077cddc3a625c64c", "git_parents": ["492ee7ea0876bc97cecc03371daf16bceb465931"], "node": "152c02c1ddf841d5013e3daaad7c9115793fa498", "parents": ["56d64cc674f6621755f8ebb72f4cb76b11af28b7"], "tags": []}, {"author": "Andy Leiserson \u003caleiserson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055704. r=webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317696\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "23bb2518bfc6c2d4465caaccff59daa7fc924bbc", "git_parents": ["d68039fa3f5fd6ca397553ea077cddc3a625c64c"], "node": "bfd88e3ff55e86e409c6e242c816c5c57e76cac6", "parents": ["152c02c1ddf841d5013e3daaad7c9115793fa498"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062711 - Refactored search_the_web to user snippets (behind pref) r=ai-security-reviewers,cdipersio,gregtatum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317936\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js"], "git_node": "f73ae5567683688640c39b8bf69ef15e20bada83", "git_parents": ["23bb2518bfc6c2d4465caaccff59daa7fc924bbc"], "node": "08c4f96fe3300ae79b745b139684caa058f3f008", "parents": ["bfd88e3ff55e86e409c6e242c816c5c57e76cac6"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062830 - Privacy Widget Celebration: Reduce the Sparkles. r=fchasen\n\nDesign feedback on the landed celebration: the burst is too dense. Brief drops\nfrom 12 sparkles to 5, and the loud tier from 24 to 12.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317989\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx"], "git_node": "59ed6e0fb2377d0924286800dddbf4ec02f503fd", "git_parents": ["f73ae5567683688640c39b8bf69ef15e20bada83"], "node": "16692772c381aca42867422227c235b9714d1f7c", "parents": ["08c4f96fe3300ae79b745b139684caa058f3f008"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057522 - Re-enable browser_tabclose.js on macOS with Nova. r=florian\n\nThe skip was added by `mach manifest skip-fails`. Bug 2055600 fixed the test for Nova's changed tab strip dimensions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318122\n", "files": ["browser/base/content/test/performance/browser.toml"], "git_node": "11b0792e82d48348ac4ebea0ba3b8a3da6ad855d", "git_parents": ["59ed6e0fb2377d0924286800dddbf4ec02f503fd"], "node": "0344e33f82b5dac593d596d5ac154f85bfd50c8e", "parents": ["16692772c381aca42867422227c235b9714d1f7c"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063098 - Gate newtab web notifications behind a Nimbus trainhop config r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318257\n", "files": ["browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/lib/web-notification-match.mjs", "browser/extensions/newtab/lib/WebNotificationsFeed.sys.mjs", "browser/extensions/newtab/test/unit/content-src/lib/web-notification-match.test.js", "browser/extensions/newtab/test/unit/lib/WebNotificationsFeed.test.js"], "git_node": "59d7241eb095411d84205061c76bbca271d11154", "git_parents": ["11b0792e82d48348ac4ebea0ba3b8a3da6ad855d"], "node": "03658e9c4292160ce1487b7fe0e3d01f723f0e2c", "parents": ["0344e33f82b5dac593d596d5ac154f85bfd50c8e"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2048388 - Add telemetry to privacy widget. r=Dre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317082\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/_Priv