6a7e298b5ab7de6511\nnn-NO -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\noc -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\npa-IN -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\npl -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\npt-BR -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\npt-PT -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nrm -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nro -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nru -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nsk -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nsl -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nson -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nsq -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nsr -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nsv-SE -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nta -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nte -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nth -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\ntl -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\ntr -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\ntrs -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nuk -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nur -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nuz -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nvi -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nwo -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nxh -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nzam -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nzh-CN -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\nzh-TW -\u003e c700cb6b7d0f0837cab4566a7e298b5ab7de6511\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "6775b6211697dd88a20ee4572b1cc650407f54ad", "git_parents": ["c87e91191942872304d3b62c9a8d45b3320a7a74"], "node": "e17eeacf3f2f12310d2709ea15dd5c986678e797", "parents": ["85bd19dd1cd0439f5a49eea3b55e30ce155d1e39"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057458 - Remove assertion that depends on marking only a single object for testing r=spidermonkey-reviewers,jonco\" for causing build bustages at bug2057458.js\n\nThis reverts commit 73dc906c1a0bb92020d124a692329f335933ab57.\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug2057458.js"], "git_node": "69d609307119f7a3d5b2801c5fe27bcd0a8120be", "git_parents": ["6775b6211697dd88a20ee4572b1cc650407f54ad"], "node": "ee1afe23c1e52c29b685d6fc9687ffa92c2ce302", "parents": ["e17eeacf3f2f12310d2709ea15dd5c986678e797"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998331: Making button element selectable by default r=dholbert,firefox-style-system-reviewers,emilio,devtools-reviewers,layout-reviewers,dshin,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300613\n", "files": ["devtools/client/themes/webconsole.css", "devtools/server/tests/browser/browser_accessibility_node.js", "devtools/server/tests/browser/browser_accessibility_node_events.js", "layout/base/tests/test_caret_browsing_around_form_controls.html", "layout/style/res/forms.css", "testing/web-platform/tests/css/css-ui/tentative/button-user-select.html"], "git_node": "f3477aafb4450c86b2f8a18239823bafa1ead182", "git_parents": ["69d609307119f7a3d5b2801c5fe27bcd0a8120be"], "node": "a8be2ee400067d10f2acac8b41dc2f289b35ba6d", "parents": ["ee1afe23c1e52c29b685d6fc9687ffa92c2ce302"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057143 - Avoid ProcessTypedArraysFixed re-entrancy by splitting Enqueue out of {Compress,Decompress}AndEnqueue and calling it afterwards. r=saschanaz\n\nAlso fix up some spec references.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316356\n", "files": ["dom/compression/BaseAlgorithms.cpp", "dom/compression/BaseAlgorithms.h"], "git_node": "9223e4e4fd2d61070e388601664c18d054c2bdf6", "git_parents": ["f3477aafb4450c86b2f8a18239823bafa1ead182"], "node": "bd759fa70abe522db640201c851a008fd2d2fc42", "parents": ["a8be2ee400067d10f2acac8b41dc2f289b35ba6d"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053143: Adjust smart window mono logo to use context fill r=desktop-theme-reviewers,Itiel,hjones\n\n- Remove hex color and replace with context-fill for the smart window mono icon.\n- Rename it to have the -32 suffix\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315349\n", "files": ["browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/preferences.js", "browser/themes/shared/icons/smart-window-mono-32.svg", "browser/themes/shared/icons/smart-window-mono.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "ecb431eed44c7c205c77d5f60271902ecfa86d2b", "git_parents": ["9223e4e4fd2d61070e388601664c18d054c2bdf6"], "node": "85893b8d23d6a96789dd31a3ae4d531bef641071", "parents": ["bd759fa70abe522db640201c851a008fd2d2fc42"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059603 - Request a longer timeout for browser_searchDefaultEngine.js due to test-verify chaos mode slowness. r=akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315907\n", "files": ["browser/components/preferences/tests/search/browser_searchDefaultEngine.js"], "git_node": "1763d7eafe754d7f8631cebbd6ba42a686313e8c", "git_parents": ["ecb431eed44c7c205c77d5f60271902ecfa86d2b"], "node": "a22bf3a665335f083850070bb946b46fb5251f8b", "parents": ["85893b8d23d6a96789dd31a3ae4d531bef641071"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059186 - Remove the unused Gradle Plugin Portal publishing setup from apilint. r=geckoview-reviewers,ohall\n\nThe apilint plugin is developed in-tree and consumed by GeckoView through an included build, so\nnothing ever publishes it to the Gradle Plugin Portal or to a Maven repository. The\n`com.gradle.plugin-publish` plugin only contributes the `publishPlugins` and `login` tasks, which no\nbuild or CI task invokes, and `maven-publish` is likewise unused: composite-build plugin\nsubstitution resolves `org.mozilla.apilint` from the plugin descriptors generated by\n`java-gradle-plugin`, not from a publication.\n\nThe `website`, `vcsUrl` and `tags` properties are portal listing metadata with no other consumer, so\ndrop them as well. Note that these properties live on Gradle's own\n`GradlePluginDevelopmentExtension` and `PluginDeclaration`, so `displayName` and `description` keep\nworking without `com.gradle.plugin-publish` applied.\n\nThe README documented consuming the plugin from the portal through a `buildscript` classpath, which\nwas never how the in-tree build resolves it, so replace those instructions too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316374\n", "files": ["mobile/android/gradle/plugins/apilint/README.md", "mobile/android/gradle/plugins/apilint/apilint/build.gradle.kts"], "git_node": "983c6255e519d88c6d8f1eae18c8a9ec36283589", "git_parents": ["1763d7eafe754d7f8631cebbd6ba42a686313e8c"], "node": "a9f153be61be10a3aad966ca217660da51861cc9", "parents": ["a22bf3a665335f083850070bb946b46fb5251f8b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059186 - Drop the dead buildSrc source directory from the apilint plugin build. r=geckoview-reviewers,ohall\n\nThe main source set adds `../buildSrc` as an extra Java source directory, but no such directory\nexists in the tree. It is a leftover from when the plugin was maintained in a standalone repository.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316375\n", "files": ["mobile/android/gradle/plugins/apilint/apilint/build.gradle.kts"], "git_node": "e0139cef3f6f06073924fec58858e4251e83c9b6", "git_parents": ["983c6255e519d88c6d8f1eae18c8a9ec36283589"], "node": "39a06baba9b0d234927127e37a1bfe1bf3359bc8", "parents": ["a9f153be61be10a3aad966ca217660da51861cc9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059186 - Remove dead code from the apidoc-plugin build. r=geckoview-reviewers,ohall\n\n`tools.jar` was removed in JDK 9; the doclet gets `com.sun.source` and `jdk.javadoc.doclet` from the\n`jdk.compiler` and `jdk.javadoc` modules instead, which the `--add-exports` flags in\n`gradle.properties` already account for. The dependency pointed at a path that has not existed for\nseveral JDK releases, so it contributed nothing to the compile classpath.\n\nEvery branch of the `JavaVersion` switch from `VERSION_1_9` up resolves the same javadoc path, and\nthe JDK 8 branch is unreachable because the build requires a much newer JDK, so collapse it.\n\nFinally, `sourcesJar`, `javadocJar` and `group` only mattered while this project was published to a\nMaven repository. Nothing consumes them now that the publishing setup is gone; the doclet jar\nreaches the apilint plugin through the `docletJar` configuration, which is a project dependency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316376\n", "files": ["mobile/android/gradle/plugins/apilint/apidoc-plugin/build.gradle"], "git_node": "448b4dafb2381bf971863e919899e2ed09b9d946", "git_parents": ["e0139cef3f6f06073924fec58858e4251e83c9b6"], "node": "b3f0390552e467bb9ad83a8ced9af53bc4708584", "parents": ["39a06baba9b0d234927127e37a1bfe1bf3359bc8"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059186 - Clean up the apilint plugin build's gradle.properties. r=geckoview-reviewers,ohall\n\nDrop the javac `--add-exports` flags, which arrived verbatim when the plugin was copied in from its\nstandalone repository. Nothing here references `com.sun.tools.javac`; the doclet uses `com.sun.source`\nand `jdk.javadoc.doclet`, which `jdk.compiler` and `jdk.javadoc` export already, and Gradle passes the\n`javac.api` and `javac.util` exports to the daemon on its own. Since the setting specified no heap\noptions, removing it leaves the daemon on the same defaults it was already getting.\n\nRecord why the configuration cache stays off here rather than enabling it. Spotless intermittently\nfails to load formatter classes when the configuration cache is on for a multi-project build invoked\nwith `clean`, and this build is both. The task graph is small enough that the cache buys little, so\nthere is no reason to take on the flakiness for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316377\n", "files": ["mobile/android/gradle/plugins/apilint/gradle.properties"], "git_node": "95dbc939774d1b0dd13877ad12b6b5539dbcfca3", "git_parents": ["448b4dafb2381bf971863e919899e2ed09b9d946"], "node": "0b55ef15d6fcb50fa11d31e58b4cba047d84292a", "parents": ["b3f0390552e467bb9ad83a8ced9af53bc4708584"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059186 - Correct the apilint invocations in the docs and help text. r=geckoview-reviewers,ohall\n\nThe task examples told readers to run `./gradlew`, which is not how the plugin's tasks are invoked in\nthis tree, and the README already used `./mach gradle` in its own instructions for running the\nplugin's tests. The extension's default `helpCommand`, printed when the API file needs updating, said\nthe same thing; GeckoView overrides it with the mach equivalent, so the default only ever shows up for\na consumer that has not set one, but it may as well be right.\n\nThe GeckoView contributor quick-start guide had the same problem in a different form: the command for\nregenerating `api.txt` read `./mach gradlew`, which is neither of the two ways to invoke it. The\n`./gradlew` further down that page is left alone, since it runs in a downstream consumer's own project\nrather than in this tree.\n\nAlso spell out where the API file lives, in place of a stray `//api.txt`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316378\n", "files": ["mobile/android/docs/geckoview/contributor/geckoview-quick-start.md", "mobile/android/gradle/plugins/apilint/README.md", "mobile/android/gradle/plugins/apilint/apilint/src/main/kotlin/org/mozilla/apilint/ApiLintPluginExtension.kt"], "git_node": "67e487d001d8ed1c10c782f05ed01a4477eec8fd", "git_parents": ["95dbc939774d1b0dd13877ad12b6b5539dbcfca3"], "node": "c9ac93960237314c63aa1b1edbdee3240f84bc78", "parents": ["0b55ef15d6fcb50fa11d31e58b4cba047d84292a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059186 - Modernize the string formatting in apilint.py. r=geckoview-reviewers,ohall\n\nThe script was still using percent formatting throughout, which ruff flags as UP031. It carries an\nAOSP copyright, but upstream removed apilint entirely in favour of metalava and the script has grown\nMozilla-only features since it was imported, so there is nothing left to keep textually comparable.\n\nAlso rename the loop variable that the API file parser reassigned, so the raw line and the stripped\nline are no longer the same name.\n\nThe four remaining PLW0603 warnings are left alone: the module-level `failures` and `noticed` state is\nthreaded through the whole file, and unpicking it would be a real refactor of the code that gates the\nGeckoView API rather than a formatting change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316379\n", "files": ["mobile/android/gradle/plugins/apilint/apilint/src/main/resources/apilint.py"], "git_node": "f491dbeaec46194c4221b17ee6a329b9c5d59e64", "git_parents": ["67e487d001d8ed1c10c782f05ed01a4477eec8fd"], "node": "cd2ea912c341f68a87518f2b64ec374bd0648595", "parents": ["c9ac93960237314c63aa1b1edbdee3240f84bc78"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2054045 - Ask from the urlbar render chat appropriately based on fullpage vs sidebar mode r=urlbar-reviewers,flozia,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314779\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_urlbar_chat.js", "browser/components/urlbar/UrlbarProviderAiChat.sys.mjs"], "git_node": "9ce028e1c90b529a53e3553a231856689d9e4f22", "git_parents": ["f491dbeaec46194c4221b17ee6a329b9c5d59e64"], "node": "6c6fa91093bfbf5753dcefd0a17e3ab5704eeaeb", "parents": ["cd2ea912c341f68a87518f2b64ec374bd0648595"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2024012: Rename InactiveTimeline to UnresolvedTimeline. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,boris\n\nAs per:\nhttps://github.com/w3c/csswg-drafts/issues/9256#issuecomment-4556112966\nIt's technically different from the existing concept of inactive timeline.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315616\n", "files": ["dom/animation/Animation.cpp", "dom/animation/Animation.h", "dom/animation/AnimationEffect.cpp", "dom/animation/AnimationTimeline.h", "dom/animation/ScrollTimeline.cpp", "dom/animation/ScrollTimeline.h", "layout/style/nsAnimationManager.cpp"], "git_node": "95a996877132840ecf60fb9d58e474136026d544", "git_parents": ["9ce028e1c90b529a53e3553a231856689d9e4f22"], "node": "39319a25c0e42dc8aae0770eaa2e70902f3b312f", "parents": ["6c6fa91093bfbf5753dcefd0a17e3ab5704eeaeb"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2024012: Have unresolved timelines be current, but not produce any effect. r=layout-scroll-driven-animation-reviewers,boris\n\nThis lines up better with other browsers, and the resolution in\nhttps://github.com/w3c/csswg-drafts/issues/9256.\nShould be noted that we (Nor other browsers) seem to resolve\nthe ready promise, which should be a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315617\n", "files": ["dom/animation/Animation.cpp", "dom/animation/AnimationEffect.cpp", "testing/web-platform/meta/scroll-animations/css/animation-timeline-deferred.html.ini"], "git_node": "6020f63a2f74a0c4a2a648b1f956c2aee20ef0b6", "git_parents": ["95a996877132840ecf60fb9d58e474136026d544"], "node": "6833e04c208aaa1bdf0f9b0b8a23accca2857251", "parents": ["39319a25c0e42dc8aae0770eaa2e70902f3b312f"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2024012: Update the scoping rule to match the most recent resolution. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,boris\n\nRemove a test from\n`animation-timeline-named-scroll-progress-timeline.tentative.html`\nthat asserts sibling timeline(s) not being visible by default,\nwhich isn't the case anymore.\n\nAdjust `timeline-scope*` tests to reflect the new behaviour.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315618\n", "files": ["layout/style/TimelineManager.cpp", "layout/style/TimelineManager.h", "layout/style/nsAnimationManager.cpp", "testing/web-platform/meta/scroll-animations/css/animation-timeline-deferred.html.ini", "testing/web-platform/meta/scroll-animations/css/timeline-scope.html.ini", "testing/web-platform/meta/scroll-animations/css/view-timeline-dynamic.html.ini", "testing/web-platform/meta/scroll-animations/css/view-timeline-lookup.html.ini", "testing/web-platform/tests/scroll-animations/css/animation-timeline-named-scroll-progress-timeline.tentative.html", "testing/web-platform/tests/scroll-animations/css/timeline-scope-all.html", "testing/web-platform/tests/scroll-animations/css/timeline-scope.html"], "git_node": "43a1a3c7a60149810039545822967cffd6e27a5d", "git_parents": ["6020f63a2f74a0c4a2a648b1f956c2aee20ef0b6"], "node": "4f6160672884a01d3a6159a17ff7865742e7c83d", "parents": ["6833e04c208aaa1bdf0f9b0b8a23accca2857251"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2024012: Always return unresolved timeline for named timeline references. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,boris\n\nGiven https://github.com/w3c/csswg-drafts/issues/9256, hopefully an\nuncontroversial change. Previously, because `timeline-scope` made timelines\nmore available, it made sense that we handle unscoped and scoped timeline\nreferences differently. Now that timelines are more visible and\n`timeline-scope` in fact restricts visibility, it seems inconsistent to\ncontinue to treat them differently.\n\nThe following tests used unresolved timelines without any `timeline-scope`,\nand expected the animation to produce an effect, which should not be the\ncase anymore:\n\n* animation-timeline-named-scroll-progress-timeline.tentative.html\n* animation-timeline-none.html\n* scroll-timeline-dynamic.tentative.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315619\n", "files": ["dom/animation/Animation.cpp", "layout/style/TimelineManager.cpp", "testing/web-platform/tests/scroll-animations/css/animation-timeline-named-scroll-progress-timeline.tentative.html", "testing/web-platform/tests/scroll-animations/css/animation-timeline-none.html", "testing/web-platform/tests/scroll-animations/css/scroll-timeline-dynamic.tentative.html"], "git_node": "c25a408a3119033bbeae69a178ac122b5c0eae4a", "git_parents": ["43a1a3c7a60149810039545822967cffd6e27a5d"], "node": "bacfb3d1a257302f3a037bbf532a23fcc9585983", "parents": ["4f6160672884a01d3a6159a17ff7865742e7c83d"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2051724 - Re-enable previously disabled shake-to-summarize tests r=matt-tighe,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314525\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsGeneralTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsPageSummariesTest.kt"], "git_node": "58bf4fb907abf640d58abecd3b4a5975c55eee64", "git_parents": ["c25a408a3119033bbeae69a178ac122b5c0eae4a"], "node": "4d5db48b3e3e7c631c43f14510d7d6761c8bdf2d", "parents": ["bacfb3d1a257302f3a037bbf532a23fcc9585983"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2057299 - Fix intermimttent about:neterror tests caused by SSLKEYLOGFILE env var r=mxinden\n\nThe test used Services.env to set the SSLKEYLOGFILE environmment variable\nand then reset it at the end of the test.\nOn MacOS this triggered intermittent failures.\n\nThis fix moves the test to a different folder, and strarts the browser with\nthe variable already present in the environment. That should avoid it being set\nand breaking other tests\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316235\n", "files": ["browser/base/content/test/about/browser.toml", "browser/base/content/test/about/browser_aboutNetError_sslKeyLogging.js", "browser/base/content/test/about/browser_aboutNetError_sslKeyLoggingDisabled.js", "browser/base/content/test/about/sslKeyLogging_processScript.js", "browser/base/content/test/about/sslkeylogging/browser.toml", "browser/base/content/test/about/sslkeylogging/browser_aboutNetError_sslKeyLogging.js", "browser/base/moz.build"], "git_node": "dabcf639b500870ed506f7e1ed20d8952ce12695", "git_parents": ["58bf4fb907abf640d58abecd3b4a5975c55eee64"], "node": "cc55e4bf36427ab0426d767969b4b98dfffa3af9", "parents": ["4d5db48b3e3e7c631c43f14510d7d6761c8bdf2d"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2060881 - Discard SegmentedVector::Append() results with a cast to void in TestSegmentedVector.cpp r=mccr8 DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316543\n", "files": ["mfbt/tests/TestSegmentedVector.cpp"], "git_node": "a98c55719105cb6d0e966b1ff6cc6f0b5c0fb04a", "git_parents": ["dabcf639b500870ed506f7e1ed20d8952ce12695"], "node": "82415beda63232a00ae1a37739c78ac50217fd63", "parents": ["cc55e4bf36427ab0426d767969b4b98dfffa3af9"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055482 - Fix how we calculate coordinates to move the pointer over the target element. r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315757\n", "files": ["browser/components/screenshots/tests/browser/browser_keyboard_tests.js"], "git_node": "030ed59f887ded6263ba67ee09f6e8e7b7ce9c3f", "git_parents": ["a98c55719105cb6d0e966b1ff6cc6f0b5c0fb04a"], "node": "1c414a2b0a538ff8d311071844e8f1e61f34804c", "parents": ["82415beda63232a00ae1a37739c78ac50217fd63"], "tags": []}, {"author": "Mathieu Leplatre \u003cmathieu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049653 - Fix test where IndexedDB persists between iterations r=omc-reviewers,emcminn\n\nWithout this change, the following test fails when ran with --verify:\n\n```\n./mach test --headless --verify browser/components/asrouter/tests/browser/browser_asrouter_bug1761522.js\n```\n\nIf we don't clear the DB between runs, the attachment for the record \u003cuuid\u003e is in local DB but not served by the HttpServer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316507\n", "files": ["browser/components/asrouter/tests/browser/browser_asrouter_bug1761522.js"], "git_node": "4f41abd8faaf3021d83b16ecd52b90775d462b84", "git_parents": ["030ed59f887ded6263ba67ee09f6e8e7b7ce9c3f"], "node": "4cc7eb74d431863ab65151d1ba967786ebea8857", "parents": ["1c414a2b0a538ff8d311071844e8f1e61f34804c"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057871 - Fixing newtab test to be less brittle by getting a consistent resize across different platforms and displays r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316439\n", "files": ["browser/extensions/newtab/test/browser/browser_newtab_last_LinkMenu.js"], "git_node": "ddc7d55a9bd84cbd80cb809d46d28be5cd0d780f", "git_parents": ["4f41abd8faaf3021d83b16ecd52b90775d462b84"], "node": "886f712c771e39f66e370f109e7a829b6b691162", "parents": ["4cc7eb74d431863ab65151d1ba967786ebea8857"], "tags": []}, {"author": "Tom Schuster \u003cevilpies@gmail.com\u003e", "branch": "default", "desc": "Bug 2059936 - Convert callsites from set(JS::XXXXValue()) to setXXXValue. r=spidermonkey-reviewers,dom-core-reviewers,dom-storage-reviewers,janerik,janv,jonco,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315783\n", "files": ["accessible/xpcom/xpcAccessibleMacInterface.mm", "docshell/shistory/SessionHistoryEntry.cpp", "dom/base/StructuredCloneBlob.cpp", "dom/base/nsGlobalWindowOuter.cpp", "dom/bindings/BindingUtils.cpp", "dom/bindings/BindingUtils.h", "dom/bindings/Codegen.py", "dom/canvas/ClientWebGLContext.cpp", "dom/indexedDB/ActorsChild.cpp", "dom/payments/PaymentRequestData.cpp", "js/src/builtin/Array.cpp", "js/src/builtin/DataViewObject.cpp", "js/src/builtin/DisposableStackObjectBase.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/builtin/TestingUtility.cpp", "js/src/debugger/Object.cpp", "js/src/jit/VMFunctions.cpp", "js/src/shell/ShellModuleObjectWrapper.cpp", "js/src/shell/js.cpp", "js/src/vm/EnvironmentObject.cpp", "js/src/vm/ErrorObject.cpp", "js/src/vm/Interpreter.cpp", "js/src/vm/Modules.cpp", "js/src/vm/RegExpObject.cpp", "js/src/wasm/WasmDebug.cpp", "js/src/wasm/WasmDebugFrame.cpp", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmJS.cpp", "js/src/wasm/WasmPI.cpp", "js/src/wasm/WasmValue.cpp", "js/xpconnect/src/Sandbox.cpp", "js/xpconnect/src/XPCComponents.cpp", "js/xpconnect/wrappers/XrayWrapper.cpp"