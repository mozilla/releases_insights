nd.yml", "taskcluster/kinds/toolchain/libunwind.yml", "taskcluster/kinds/toolchain/libxml2.yml", "taskcluster/kinds/toolchain/llvm-symbolizer.yml", "taskcluster/kinds/toolchain/macos-sdk.yml", "taskcluster/kinds/toolchain/mingw.yml", "taskcluster/kinds/toolchain/minidump-stackwalk.yml", "taskcluster/kinds/toolchain/misc.yml", "taskcluster/kinds/toolchain/mozcheck.yml", "taskcluster/kinds/toolchain/nasm.yml", "taskcluster/kinds/toolchain/nimbus-fml.yml", "taskcluster/kinds/toolchain/node.yml", "taskcluster/kinds/toolchain/onnx.yml", "taskcluster/kinds/toolchain/pkgconf.yml", "taskcluster/kinds/toolchain/profiler-node-tools.yml", "taskcluster/kinds/toolchain/python-wheels.yml", "taskcluster/kinds/toolchain/python.yml", "taskcluster/kinds/toolchain/rust-size.yml", "taskcluster/kinds/toolchain/rust.yml", "taskcluster/kinds/toolchain/samply.yml", "taskcluster/kinds/toolchain/sccache.yml", "taskcluster/kinds/toolchain/sysroot.yml", "taskcluster/kinds/toolchain/upx.yml", "taskcluster/kinds/toolchain/uv.yml", "taskcluster/kinds/trigger-comm-central/kind.yml", "taskcluster/kinds/ui-test-apk/kind.yml", "taskcluster/kinds/update-test/kind.yml", "taskcluster/kinds/updatebot/kind.yml", "taskcluster/kinds/upload-generated-sources/kind.yml", "taskcluster/kinds/upload-symbols/kind.yml", "taskcluster/kinds/valgrind/kind.yml", "taskcluster/kinds/webrender/kind.yml"], "git_node": "b04d66d743e7422b67bf7e66b4e25c26d7b377a5", "git_parents": ["79ba2722d68ae1750660f16d2bf88a893aa9dc00"], "node": "6b0f347cc782e6298dbe38d75fa313bbcca4a528", "parents": ["d2df205d347654a0e6e529befecfb0404ef187b7"], "tags": []}, {"author": "Niklas Baumgardner \u003cnbaumgardner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052258 - Create share panel for share button in url bar. r=fluent-reviewers,desktop-theme-reviewers,hjones,flod,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316367\n", "files": ["browser/base/content/browser.xhtml", "browser/base/content/main-popupset.inc.xhtml", "browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/BrowserComponents.manifest", "browser/components/sharing/SharePageAction.sys.mjs", "browser/components/sharing/content/sharePanel.inc.xhtml", "browser/components/sharing/moz.build", "browser/locales/en-US/browser/sharePanel.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/sharePanel.css", "browser/themes/shared/urlbar-searchbar.css"], "git_node": "df824a0fac50b8189d209707d733fc6d0d8cda6d", "git_parents": ["b04d66d743e7422b67bf7e66b4e25c26d7b377a5"], "node": "02d93deb48cd75e5990124302896d1bf7b05a76e", "parents": ["6b0f347cc782e6298dbe38d75fa313bbcca4a528"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062207 - Fix big-endian ARGB packing in UnpackRowRGB24_To_ARGB (Coverity CID 1690687) r=gfx-reviewers,lsalzman\n\nOn big-endian, the shifts placed red at bit 24 (colliding with the\n0xFF000000 alpha constant) and mis-slotted green/blue. The A8R8G8B8\nmemory order requires (R \u003c\u003c 16) | (G \u003c\u003c 8) | B.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317466\n", "files": ["gfx/2d/Swizzle.cpp"], "git_node": "e1f3236895d0f39bed4aceb60a3a86d436b0372e", "git_parents": ["df824a0fac50b8189d209707d733fc6d0d8cda6d"], "node": "9639c9ef7eb7d35abcbef0318831f6d5e03baa4f", "parents": ["02d93deb48cd75e5990124302896d1bf7b05a76e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060933 - Wait for the engine store before a result can reach the UI. r=mbeier\n\nThe content-side engine store is populated asynchronously, while results are\nproduced by the parent's providers, which use the search service directly. A\nresult can therefore reach the content-side UI while its store is still empty,\nand the result-handling paths read the store without checking: picking a search\nresult throws on the undefined engine, and a trending row renders its group\nlabel with `engine: undefined`. Nothing fails in CI today; no test arranges the\nprecondition.\n\nWaiting where results come into existence covers the class, so the individual\nreads stay downstream of a populated store and keep no guards of their own.\n\nThe gate sits in the child controller, the dispatch point both input classes\nshare. `startQuery` keeps a fully synchronous path when the store is ready, so\nthe arming of the event bufferer, the synchronous assignment of\n`lastQueryContextPromise` and `UrlbarView.autoOpen`'s focus-to-panel timing are\nuntouched for every query after init. Only the pre-init window defers. There the\nbufferer is armed before the wait, so a just-typed Enter is still deferred:\nnothing can tear down the previous query in between, which is the only thing the\narm-after-dispatch ordering guards against. A failed search service takes the\nsynchronous path too -- the store will never be populated, and waiting on it\nwould keep the input from producing results at all.\n\nA query cancelled or superseded during the wait doesn't dispatch afterwards,\nwhich the query id already tracks for superseding. Cancelling now bumps it, the\ninvalidation `discardResults` does for the same reason. That also keeps results\nof a cancelled query from reaching the listeners -- only reachable over the\nmessage path, where they're in flight when the cancellation is sent, and the\nfreeze the view cancels for is what dropping them amounts to.\n\n`resolveFallbackNavigation` needs the same wait. Its result is picked like a\nquery's, and paste-and-go reaches it with the query suppressed, so nothing\nupstream has waited for the store.\n\nThe search restrict token is the one read a query can't gate: `search` resolves\nthe default engine before any query exists. An empty store yields\n`{ engineName: undefined }`, which is truthy, so today the token is stripped\nfrom the value while search mode is silently not entered. It waits and retries,\nkeying on `failed` as well so a rejected init doesn't recurse.\n\nSmartbarInput carries its own copy of `search` and gets the same change.\n\nThe new test pins the store empty rather than racing it -- taking its engines\naway along with the `initialized` flag, since it is necessarily populated by the\ntime a test can pin it. Each case fails without the patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317088\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-search/browser.toml", "browser/components/urlbar/tests/browser-search/browser_engineStoreQueryGate.js", "browser/components/urlbar/tests/unit/test_searchEngineStore.js"], "git_node": "592acccdfbea40f6d57bf5cde5306b14173d6c8f", "git_parents": ["e1f3236895d0f39bed4aceb60a3a86d436b0372e"], "node": "d06c725fe1618224aba1110bedb1540cd8e718be", "parents": ["9639c9ef7eb7d35abcbef0318831f6d5e03baa4f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062195 - Remove NativeMenu observers. r=gtk-reviewers,layout-reviewers,stransky,dshin\n\nThis simplifies bug 2013692.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314101\n", "files": ["layout/xul/nsXULPopupManager.cpp", "layout/xul/nsXULPopupManager.h", "widget/NativeMenu.cpp", "widget/NativeMenu.h", "widget/cocoa/NativeMenuMac.h", "widget/cocoa/NativeMenuMac.mm", "widget/gtk/NativeMenuGtk.cpp", "widget/gtk/NativeMenuGtk.h"], "git_node": "6333c5037f3c07816646bd5e1458bcf93c417ec9", "git_parents": ["592acccdfbea40f6d57bf5cde5306b14173d6c8f"], "node": "85460f5ed4d02c0192b0911aa3858481d0a6406a", "parents": ["d06c725fe1618224aba1110bedb1540cd8e718be"], "tags": []}, {"author": "Joel \u003cjoelkelly@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060958 - Add surface_id to the newtab ping r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316625\n", "files": ["browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/test/unit/lib/DiscoveryStreamFeed.test.js", "browser/extensions/newtab/test/unit/unit-entry.js"], "git_node": "356f32f4971c922f100c457f4111c37fc2e22ec3", "git_parents": ["6333c5037f3c07816646bd5e1458bcf93c417ec9"], "node": "51db08cac7131518870d6cd4232a113947b40601", "parents": ["85460f5ed4d02c0192b0911aa3858481d0a6406a"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059991 - Resolve CAR perma fail. r=perftest-reviewers,kshampur\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316609\n", "files": ["taskcluster/scripts/misc/build-custom-car.sh"], "git_node": "bc61270b29dd797214cd880f2876e66e63813778", "git_parents": ["356f32f4971c922f100c457f4111c37fc2e22ec3"], "node": "802f9ddae7ea7e467226578973eb4df94469883e", "parents": ["51db08cac7131518870d6cd4232a113947b40601"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2058595 - Fix perma failing browser/base/content/test/sync/browser_sync.js r=skhamis,desktop-theme-reviewers,Juliana\" for causing bc failures at browser_synced_tabs_menu.js\n\nThis reverts commit bf01fb8a81818cfca02171071562eb1c113c2552.\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js", "browser/extensions/newtab/webext-glue/metrics/runtime-metrics-153.json", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "1d1539b9546446c253f7e2ccc5d46c79051ad556", "git_parents": ["bc61270b29dd797214cd880f2876e66e63813778"], "node": "98597bee90da429200adf114e997962fdbdc933c", "parents": ["802f9ddae7ea7e467226578973eb4df94469883e"], "tags": []}, {"author": "hanna.alemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 1930141 - Fix feature callout intermittent failure r=omc-reviewers,yazan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317083\n", "files": ["browser/components/asrouter/tests/browser/browser_feature_callout_in_chrome.js"], "git_node": "1c1e72e00f45e96e3daf38e433447ecd1d056ad1", "git_parents": ["1d1539b9546446c253f7e2ccc5d46c79051ad556"], "node": "354d1fbe0cd0a919ca9d3de6091b90a982489714", "parents": ["98597bee90da429200adf114e997962fdbdc933c"], "tags": []}, {"author": "Jon Oliver \u003cjooliver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055462 - Fix findbar notfound/flash colors for lightweight themes r=desktop-theme-reviewers,extension-reviewers,dao,rpl\n\nExclude notfound and flash states from the :root[lwtheme] findbar\ntextbox override so those status colors apply under lightweight themes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316541\n", "files": ["toolkit/components/extensions/test/browser/browser_ext_themes_findbar.js", "toolkit/themes/shared/findbar.css"], "git_node": "6e4345fed1e079031fb14f0257dfc9c3c57ae2ad", "git_parents": ["1c1e72e00f45e96e3daf38e433447ecd1d056ad1"], "node": "3207d8cae8ee9a35ba167c1f40432ca4b5be1fc2", "parents": ["354d1fbe0cd0a919ca9d3de6091b90a982489714"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2061679 - Update job expiration when cap is applied r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317053\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "eed0931f85474d0db6e2326dfd9718c6bf1cd418", "git_parents": ["6e4345fed1e079031fb14f0257dfc9c3c57ae2ad"], "node": "00eb54081dcf5a04287237f2b516658561ecabd6", "parents": ["3207d8cae8ee9a35ba167c1f40432ca4b5be1fc2"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058173 - Bound untrusted allocation sizes in libmar (Coverity CID 1459297, 1459486) r=application-update-reviewers,yjuglaret\n\nmar_read_index malloc'd size_of_index read straight from the (untrusted)\nMAR before any bound check; reject sizes larger than the buffer.\nextract_signature malloc'd an unbounded signature length with no NULL\ncheck; cap it at MAX_SIGNATURE_LENGTH and check the allocation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314378\n", "files": ["modules/libmar/sign/mar_sign.c", "modules/libmar/src/mar_read.c"], "git_node": "e46f28da1cd3a5d46a2680b3d87361e9e8de4ae6", "git_parents": ["eed0931f85474d0db6e2326dfd9718c6bf1cd418"], "node": "6f2dd9617d6f1e1cd90a2038b2f64e8dda463c96", "parents": ["00eb54081dcf5a04287237f2b516658561ecabd6"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058173 - Bound and null-check remaining untrusted allocations in mar_sign r=application-update-reviewers,yjuglaret\n\nFollow-up to review feedback on D314378:\n- import_signature: cap the MAR signature length at MAX_SIGNATURE_LENGTH and\n  check the allocation.\n- import_signature: check the allocation for the base64 signature file.\n- strip_signature_block and mar_repackage_and_sign: reject an index length\n  larger than the source MAR and check the allocation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317534\n", "files": ["modules/libmar/sign/mar_sign.c"], "git_node": "821ab0cd6044728ac3bd787478e9a948d5edc113", "git_parents": ["e46f28da1cd3a5d46a2680b3d87361e9e8de4ae6"], "node": "26f55f839cba21d1686515fd7c6a96adc369d845", "parents": ["6f2dd9617d6f1e1cd90a2038b2f64e8dda463c96"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2057270 - Clarify working directory for test262-update.py in js/src/tests/README.txt r=dminor\n\ntest262-update.py must be run from js/src/tests/, but the preceding\nsection header (js/src/tests/test262/ contains a snapshot...) reads as\nthough the commands should be run from inside test262/ itself. Make\nthe working directory explicit in step 2 to avoid that confusion.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314778\n", "files": ["js/src/tests/README.txt"], "git_node": "ae1e679a42aefad797a8206e31cbe00bb1ae5133", "git_parents": ["821ab0cd6044728ac3bd787478e9a948d5edc113"], "node": "dbb1d4dc3559031b189d54b6b79f654e23bf7f29", "parents": ["26f55f839cba21d1686515fd7c6a96adc369d845"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2057270 - Update test262 snapshot r=dminor\n\nUpdate the vendored test262 snapshot to the latest upstream revision.\n\nSkips built-ins/AsyncIteratorPrototype/Symbol.asyncDispose/invokes-return.js\nunder --enable-explicit-resource-management pending bug 2058720.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314781\n", "files": ["js/src/tests/jstests.list", "js/src/tests/test262/GIT-INFO", "js/src/tests/test262/built-ins/Array/fromAsync/shell.js", "js/src/tests/test262/built-ins/AsyncDisposableStack/prototype/adopt/shell.js", "js/src/tests/test262/built-ins/AsyncDisposableStack/prototype/defer/shell.js", "js/src/tests/test262/built-ins/AsyncDisposableStack/prototype/disposeAsync/shell.js", "js/src/tests/test262/built-ins/AsyncDisposableStack/prototype/move/shell.js", "js/src/tests/test262/built-ins/AsyncDisposableStack/prototype/use/shell.js", "js/src/tests/test262/built-ins/AsyncFromSyncIteratorPrototype/next/shell.js", "js/src/tests/test262/built-ins/AsyncFromSyncIteratorPrototype/return/shell.js", "js/src/tests/test262/built-ins/AsyncFromSyncIteratorPrototype/throw/shell.js", "js/src/tests/test262/built-ins/AsyncGeneratorPrototype/next/shell.js", "js/src/tests/test262/built-ins/AsyncIteratorPrototype/Symbol.asyncDispose/invokes-return.js", "js/sr