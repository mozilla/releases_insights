/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/sl/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/son/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/sq/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/sr/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/sv-SE/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/sw/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/szl/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/ta/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/te/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/tg/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/th/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/tl/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/tr/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/trs/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/uk/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/ur/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/uz/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/vi/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/wo/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/xcl/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/xh/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/zh-CN/browser/newtab/newtab.ftl", "browser/extensions/newtab/webext-glue/locales/zh-TW/browser/newtab/newtab.ftl"], "git_node": "c45f535c19d95e98b7456ef9c1c4dd8ddb04fcbc", "git_parents": ["840603f5fd08a6544577219e649001d21321cc09"], "node": "cc38f91c667f3f3665ce6629f3db791ccbd1bd40", "parents": ["b1435a6cd151284ffcbbdca780b5df8c77a08053"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048379 - Re-inject preferences strings into New Tab's build-time generated train-hop locales. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316652\n", "files": ["browser/extensions/newtab/webext-glue/locales/gen_locales.py", "browser/extensions/newtab/webext-glue/moz.build"], "git_node": "b5cb346e8bd58c4f23f2042c6408eb45a958b3fb", "git_parents": ["c45f535c19d95e98b7456ef9c1c4dd8ddb04fcbc"], "node": "3c413dd3e34201e794d7c29b6e9b9b8cb0948785", "parents": ["cc38f91c667f3f3665ce6629f3db791ccbd1bd40"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Add a pref-on CI variant exercising the urlbar actor message-passing path. r=taskgraph-reviewers,mbeier,bhearsum\n\nThe message path (`browser.urlbar.ipc.chromeMessagePassing`) is off by default,\nso nothing in CI exercises the wire contract the chrome `\u003cmoz-urlbar\u003e` instances\nare meant to prove out. Add a `urlbar-ipc` test variant that forces the pref on\nand runs the urlbar mochitest-browser-chrome suite over the wire, scoped via\n`MOZHARNESS_TEST_TAG: [urlbar]` (the urlbar manifests already tag their tests)\nso it doesn't run the whole browser-chrome suite. A `mozinfo: urlbar_ipc` flag\nlets an individual test opt out (`skip-if = urlbar_ipc`) when it must stay on the\ndirect path.\n\nAttached to `mochitest-browser-chrome` as `urlbar-ipc` (Windows/macOS) and\n`webrender-sw+urlbar-ipc` (Linux, under software WebRender), on opt, tier 3.\nWindows and Linux run on autoland and mozilla-central. macOS runs on\nmozilla-central only: on the modern aarch64 platform M(bc) is scheduled solely\non the shippable build, which isn't produced on autoland.\n\nFour tests assert the switcher's icon in a window they open themselves, which the\nmessage path can't satisfy while bug 2059513 is open: the engine store's snapshot\narrives from the parent, so the fallback icon shows until then. Rather than skip\nthem outright they pin the pref off for the window they open, so they keep running\nand only their transport changes. test_keyword_disabled's searchbar assertion also\nhad to move to that window -- it read the l10n id off the test's own window, unlike\nthe urlbar assertion beside it, so pinning the pref would otherwise not have\nreached it.\n\nThe private-engine icon is one of the four. It is timing-dependent and doesn't\nreproduce locally, so it survived an earlier pref-on run that appeared to clear\nit; a try run of this variant fails it on Linux.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309861\n", "files": ["browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchModeSwitcher.js", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/test_configs/variants.yml"], "git_node": "5b2b75817b8812278f752b227480c1765932c8ee", "git_parents": ["b5cb346e8bd58c4f23f2042c6408eb45a958b3fb"], "node": "f720efc478736a73084828b137669e861e37163f", "parents": ["3c413dd3e34201e794d7c29b6e9b9b8cb0948785"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056706 - fix for headless mode for automated webcompat intervention tests; r=ksenia\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316867\n", "files": ["testing/webcompat/fixtures.py"], "git_node": "6d702d81e348ce4e47d31de8b4be95f8bf18b08a", "git_parents": ["5b2b75817b8812278f752b227480c1765932c8ee"], "node": "5d6a52f646f038f79482232297ac35c8e7d6b1a6", "parents": ["f720efc478736a73084828b137669e861e37163f"], "tags": []}, {"author": "Sam Foster \u003csfoster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054183 - Zero out outer rounded corners, borders and padding from chrome when window is maximized. r=tabbrowser-reviewers,desktop-theme-reviewers,frontend-codestyle-reviewers,dao,extension-reviewers,willdurand\n\n- Add a new maximized window suite and test to check window decoration values in various states\n- Fix intermittent tab spacing test by waiting for documentFlushed rather than rAF\n- Extension `toolbar_bottom_separator` test should be only checking the borderTopColor\n- Run the popup size test with nova enabled,disabled\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314796\n", "files": ["browser/base/content/test/maximized/browser.toml", "browser/base/content/test/maximized/browserNova.toml", "browser/base/content/test/maximized/browser_maximized_decoration.js", "browser/base/content/test/maximized/head.js", "browser/base/content/test/popups/browser_popup_new_window_size.js", "browser/base/moz.build", "browser/components/tabbrowser/test/browser/tabs/browser_tabs_space_consistent.js", "browser/themes/shared/browser-shared.css", "browser/themes/shared/customizableui/customizeMode.css", "browser/themes/shared/tabbrowser/content-area.css", "eslint-test-paths.config.mjs", "toolkit/components/extensions/test/browser/browser_ext_themes_separators.js"], "git_node": "2a95e83f8632e37538f6a16889013f04bb4f4976", "git_parents": ["6d702d81e348ce4e47d31de8b4be95f8bf18b08a"], "node": "a34846f458d21422e4608f5ab2fe7f83e699e19b", "parents": ["5d6a52f646f038f79482232297ac35c8e7d6b1a6"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1888334 - Clamp un-premultiplied colors to [0,1] in the mix-blend shader. r=wsmind\n\nIn ps_quad_mix_blend.glsl the backdrop and source are un-premultiplied via `cb.rgb /= cb.a` and `cs.rgb /= cs.a`. The content of these textures is not guaranteed to hold rgb \u003c= a: gradient dithering perturbs the color channels but not alpha, and SVG filter primitives such as feComposite arithmetic operate on premultiplied colors and clamp each channel independently. Un-premultiplying then produces components above 1.0, and the blend functions are only defined for inputs in [0,1]; e.g. color_dodge(cb, cs) with cs \u003e 1.0 computes cb/(1-cs) with a negative denominator, producing a negative (black) result.\nThis patch address it by clamping cb.rgb and cs.rgb to [0,1] immediately after un-premultiplying, before any blend function runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313777\n", "files": ["gfx/wr/swgl/src/blend.h", "gfx/wr/webrender/res/ps_quad_mix_blend.glsl", "gfx/wr/wrench/reftests/blend/color-dodge-unpremultiplied-overflow-ref.yaml", "gfx/wr/wrench/reftests/blend/color-dodge-unpremultiplied-overflow.yaml", "gfx/wr/wrench/reftests/blend/reftest.list"], "git_node": "f606e45ff2454a5c52c6e2cb55deca643524b7fc", "git_parents": ["2a95e83f8632e37538f6a16889013f04bb4f4976"], "node": "ea3c04c24de08c342b6273f070c89bfee92c53b4", "parents": ["a34846f458d21422e4608f5ab2fe7f83e699e19b"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2061230 - Support autoconfig files in partner repacks r=releng-reviewers,bhearsum\n\nCopy the contents of a partner's autoconfig/ directory to the root of the\napplication directory, obfuscating .cfg files so that Firefox's autoconfig\ncan read them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316832\n", "files": ["python/mozrelease/mozrelease/partner_repack.py"], "git_node": "0d2d7ce117cd3cee3edc4a7564d25f3c4439e667", "git_parents": ["f606e45ff2454a5c52c6e2cb55deca643524b7fc"], "node": "326fb9568ff4350cbe1e7088d68d13e5a7f1cae5", "parents": ["ea3c04c24de08c342b6273f070c89bfee92c53b4"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049698 - Restore panel focus across shadow roots so the address bar keeps focus when the password doorhanger closes. r=credential-management-reviewers,NeilDeakin\n\nBug 2034256 moved the save/update password doorhanger's username and\npassword inputs into shadow roots. panel.js's on_popuphidden decides\nwhether focus needs restoring by walking parentNode up from the focused\nelement to the panel, which stops at the ShadowRoot, so focus was never\nreturned to the content browser. That was worked around in\nLoginManagerPrompter by calling browser.focus() on \"dismissed\", which\nalso ran when the doorhanger rolled up from an address bar click and\nstole focus back from the urlbar, leaving the URL unselected.\n\nWalk out of shadow roots in on_popuphidden and drop the workaround.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316188\n", "files": ["toolkit/components/passwordmgr/LoginManagerPrompter.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser_doorhanger_urlbar_focus.js", "toolkit/content/widgets/panel.js"], "git_node": "d12305e002e2af94cea1003f41fc56ed05a11fd3", "git_parents": ["0d2d7ce117cd3cee3edc4a7564d25f3c4439e667"], "node": "7a5fcc7f7d30d3508c92183d676797c5f6e189f9", "parents": ["326fb9568ff4350cbe1e7088d68d13e5a7f1cae5"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058621 - Part 1: Don't fire characterboundsupdate in ContentEventHandler. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315381\n", "files": ["dom/events/ContentEventHandler.cpp", "dom/html/EditContext.cpp", "dom/html/EditContext.h", "editor/libeditor/tests/edit-context/test_editcontext_query_characters.html", "editor/libeditor/tests/edit-context/test_editcontext_redundant_characterboundsupdate.html", "widget/ContentCache.cpp"], "git_node": "36cd2a05f7819e983b4883cf3120e48367a775b4", "git_parents": ["d12305e002e2af94cea1003f41fc56ed05a11fd3"], "node": "79786d574e8ca68046fba20ee19bd0db761059d7", "parents": ["7a5fcc7f7d30d3508c92183d676797c5f6e189f9"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058621 - Part 2: Fire characterboundsupdate when EditContext is activated. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315382\n", "files": ["dom/html/EditContext.cpp", "dom/html/EditContext.h", "editor/libeditor/tests/edit-context/mochitest.toml", "editor/libeditor/tests/edit-context/test_editcontext_characterboundsupdate_focus.html", "modules/libpref/init/all.js"], "git_node": "986781519e92d750532dd715a078e89c6a50bfee", "git_parents": ["36cd2a05f7819e983b4883cf3120e48367a775b4"], "node": "42f3e06c33c2eab85aa0a6f95c6d2fdd686d7486", "parents": ["79786d574e8ca68046fba20ee19bd0db761059d7"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058621 - Part 3: Revert adding mIsFirstCharFallbackRect from bug 2057662, since it's no longer needed. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315383\n", "files": ["widget/ContentCache.cpp", "widget/ContentCache.h", "widget/TextEvents.h"], "git_node": "790cb7d2693d9ff513aade58651d8533275b0ef4", "git_parents": ["986781519e92d750532dd715a078e89c6a50bfee"], "node": "cbcad62e66f2f4dd3211fb036e16ce8dc8ceb794", "parents": ["42f3e06c33c2eab85aa0a6f95c6d2fdd686d7486"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060569 - Move top sites listener to UrlbarParentController. r=dao,urlbar-reviewers\" for causing documentation failures.\n\nThis reverts commit 9622365edfc8907fc9e5486ff3981d6ddae0b42b.\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser/browser_queryContextCache.js"], "git_node": "94aeb9f917384621fb96aa9a4a8c9a660a72edd9", "git_parents": ["790cb7d2693d9ff513aade58651d8533275b0ef4"], "node": "8b767bdc193ecd667a6e2c81dc801a75313ff50a", "parents": ["cbcad62e66f2f4dd3211fb036e16ce8dc8ceb794"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053421 - Cleanup default state for static-analysis on OSX r=media-playback-reviewers,profiler-reviewers,migration-reviewers,mconley,canova,alwu\" for causing macOS bp-nu bustages in PoisonIOInterposerMac.cpp.\n\nThis reverts commit 27e546ec34b81256b18dd14958372f182352d2a7.\n", "files": ["accessible/mac/AccessibleWrap.mm", "accessible/mac/DocAccessibleWrap.mm", "accessible/mac/GeckoTextMarker.h", "accessible/mac/GeckoTextMarker.mm", "accessible/xpcom/xpcAccessibleMacInterface.h", "browser/components/migration/nsKeychainMigrationUtils.h", "browser/components/shell/nsMacShellService.h", "dom/gamepad/cocoa/CocoaGamepad.cpp", "dom/media/webspeech/synth/cocoa/OSXSpeechSynthesizerService.mm", "dom/system/mac/nsOSPermissionRequest.h", "dom/webgpu/SharedTextureMacIOSurface.cpp", "hal/cocoa/CocoaBattery.cpp", "hal/cocoa/CocoaSensor.mm", "image/decoders/icon/mac/nsIconChannelCocoa.mm", "toolkit/components/parentalcontrols/nsParentalControlsServiceCocoa.mm", "tools/profiler/core/PowerCounters-mac-amd64.cpp", "xpcom/base/AvailableMemoryWatcherMac.cpp", "xpcom/build/PoisonIOInterposerMac.cpp"], "git_node": "acf8ef1e62bc1a37b70d8284b5377fd6119b785e", "git_parents": ["94aeb9f917384621fb96aa9a4a8c9a660a72edd9"], "node": "d11c9c7e5a0d8b09eb5e865b4c3f39452bb39a74", "parents": ["8b767bdc193ecd667a6e2c81dc801a75313ff50a"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2032628: Use 'visibility:collapse' instead of 'display:none' to show/hide tab-close-button on hovered/unhovered tabs. r=tabbrowser-reviewers,desktop-theme-reviewers,sthompson,kcochrane\" for causing mochitests failures in browser_audioTabIcon.js.\n\nThis reverts commit 5959fc3a8e181038fa8997cb920b4029007755c6.\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "33ede3869d8df04b770cccf843c2702f958873eb", "git_parents": ["acf8ef1e62bc1a37b70d8284b5377fd6119b785e"], "node": "e9bdaf807ab4dad7012e886bb3517ee28a45d17f", "parents": ["d11c9c7e5a0d8b09eb5e865b4c3f39452bb39a74"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059522 - [tryselect] Add a regression test to ensure we can push to Git backing on Windows, r=ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315389\n", "files": ["tools/tryselect/test/test_push.py"], "git_node": "329457f8f9cd6d6dd2a14d52479e4e5d2ec562a8", "git_parents": ["33ede3869d8df04b770cccf843c2702f958873eb"], "node": "2e64f0c22a25d6b8b02139f3ca7d9c5a9e86927e", "parents": ["e9bdaf807ab4dad7012e886bb3517ee28a45d17f"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059522 - [tryselect] Close keyfile before Git uses it, r=ahochheiden\n\nThis happens when pushing to the Git backing repo, and is needed for\nWindows. We must release the file before Git reads it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315390\n", "files": ["tools/tryselect/push.py"], "git_node": "b6241d95608e087a832bdd08745c23fb60a2cdaf", "git_parents": ["329457f8f9cd6d6dd2a14d52479e4e5d2ec562a8"], "node": "69952b1bb8308bb4c4cd3ee88a5fdf6b2a71251a", "parents": ["2e64f0c22a25d6b8b02139f3ca7d9c5a9e86927e"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059522 - [tryselect] Restrict git-backing SSH key ACL to the owner on Windows, r=ahochheiden\n\nos.chmod cannot restrict a file's ACL on Windows, so the private key\nremained readable by other users there. Use icacls to lock it down to\nthe current user only to avoid permissions being too open.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316804\n", "files": ["tools/tryselect/push.py", "tools/tryselect/test/test_push.py"], "git_node": "1a0cff5fb7b0f2b033732bfbafabd1b5de518ce2", "git_parents": ["b6241d95608e087a832bdd08745c23fb60a2cdaf"], "node": "80945a25c54409c831f4ebe54fd225f7ed6e9411", "parents": ["69952b1bb8308bb4c4cd3ee88a5fdf6b2a71251a"], "tags": []}, {"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2040610 - Hide Share Folder for Empty Folders r=places-reviewers,fterdal,niklas,mak\n\n- Hide the Share Folder menu item when a bookmarks folder with no URIs with content (http/https links) is right-clicked\n- Add tests in the Bookmarks Toolbar and Library\n- Moved content check from a helper to PlacesUtils\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313821\n", "files": ["browser/components/places/content/controller.js", "browser/components/places/content/placesContextMenu.inc.xhtml", "browser/components/places/tests/browser/browser_bookmark_context_menu_contents.js", "toolkit/components/places/PlacesUtils.sys.mjs"], "git_node": "1749d8a85f5da2bb0f2d2741659ddb1827885fd4", "git_parents": ["1a0cff5fb7b0f2b033732bfbafabd1b5de518ce2"], "node": "201d9d412596c7eefaeaa80fbb5d0530ad2305a0", "parents": ["80945a25c54409c831f4ebe54fd225f7ed6e9411"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061186 - Update PDF.js to 71a3c6a896b1d297f1f48384a65df6645ad11c4b r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316797\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "38a188c5d2a895d66be969d41b0642d290b251ee", "git_parents": ["1749d8a85f5da2bb0f2d2741659ddb1827885fd4"], "node": "426a10ef