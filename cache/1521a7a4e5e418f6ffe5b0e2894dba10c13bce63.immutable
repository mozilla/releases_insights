f931d98683b"], "node": "da35c84bbf265753bdfbe52fcf2e626316a7460e", "parents": ["3fa789e46c0e615113a1079347d70a6b9d80543f"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062474 - Enable Auto Tab Grouping for SW. r=rrando\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317691\n", "files": ["browser/app/profile/firefox.js"], "git_node": "486393ac90593601fe68f8c9e5ce0c16653f315d", "git_parents": ["e8998da3bc3e7430c83956d9d18738a8b642ecd2"], "node": "26b9bdb2d5d07ab5967200dc7884dcc6529012c1", "parents": ["da35c84bbf265753bdfbe52fcf2e626316a7460e"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2058780 - Increase the nursery wrapper vector segment size to 3800. r=xpcom-reviewers,smaug,jstutte\n\nmNurseryObjects only stores pointers, but inherited its 512 byte segment from\na vector of much larger elements that has since been removed. 3800 fits 471\npointers per segment instead of 60, while keeping the segment allocation\ninside a mozjemalloc bin.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314242\n", "files": ["xpcom/base/CycleCollectedJSRuntime.h"], "git_node": "6d1045c0786859481d8612e27b1573ed970e0a12", "git_parents": ["486393ac90593601fe68f8c9e5ce0c16653f315d"], "node": "d7616517a58f9351145f681ab1a90961c7ba08d5", "parents": ["26b9bdb2d5d07ab5967200dc7884dcc6529012c1"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2061774 - [Monitor Agent][FE] Monitor feature STRINGS - round 2 r=fluent-reviewers,bolsson,echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317132\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/locales-preview/aiWindow.ftl"], "git_node": "666e0b05342399bf6e3706568c1fca43fcda091c", "git_parents": ["6d1045c0786859481d8612e27b1573ed970e0a12"], "node": "6171543fd5e26bbdb32e62716e35121b17e534d5", "parents": ["d7616517a58f9351145f681ab1a90961c7ba08d5"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 1958658 - Don't dismiss the software keyboard when GeckoView already loses focus. r=geckoview-reviewers,ohall\n\nActually, when dismissing the software keyboard, it is delayed due to\nbug 1893045. When focus is changed to another non-GeckoView view, that\nfix causes the software keyboard to be dismissed unexpectedly.\n\nSo if GeckoView view is already losing focus, we should not dismiss the\nsoftware keyboard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315928\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/TextInputDelegateTest.kt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoEditable.java"], "git_node": "e05cf56b88682a8ff201c057c36f60cbc5be3ce2", "git_parents": ["666e0b05342399bf6e3706568c1fca43fcda091c"], "node": "2faa0f13065cc06191b6f9ff0ea2c2bf80689c99", "parents": ["6171543fd5e26bbdb32e62716e35121b17e534d5"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057876 - Skip browser_document_command_paste_contextmenu_suppression.js on Wayland; r=smaug,aryx\n\nThe failure is unrelated to Nova; it is a permafail on Wayland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317429\n", "files": ["dom/events/test/clipboard/browser.toml"], "git_node": "a1fec465dca73c73dfb574259aa0e4360aa6ff36", "git_parents": ["e05cf56b88682a8ff201c057c36f60cbc5be3ce2"], "node": "a88d92e4f026a06d73d6405c087dd4e6cca0c842", "parents": ["2faa0f13065cc06191b6f9ff0ea2c2bf80689c99"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2060901 - Clear resource cache before running the test. r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316717\n", "files": ["dom/base/test/jsmodules/importmaps/test_bug_2054295.html"], "git_node": "79a01579637f04c24fa68efe0ae0f65b02aa566e", "git_parents": ["a1fec465dca73c73dfb574259aa0e4360aa6ff36"], "node": "4a6fa7216d6306f331ee44dbd3ac03ce41f7bfbd", "parents": ["a88d92e4f026a06d73d6405c087dd4e6cca0c842"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057875 - Skip browser_move_pip_for_fullscreen.js on Wayland; r=smaug,aryx\n\nThe failure is unrelated to Nova; it is a permafail on Wayland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317493\n", "files": ["dom/documentpip/tests/browser/browser.toml"], "git_node": "9dea12282b0095a7accd9e60cecd5630abef44eb", "git_parents": ["79a01579637f04c24fa68efe0ae0f65b02aa566e"], "node": "2dd2e345b78b4bb339b1f9ee49a39931f6c53772", "parents": ["4a6fa7216d6306f331ee44dbd3ac03ce41f7bfbd"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061774 - [Monitor Agent][FE] Monitor feature STRINGS - round 2 r=fluent-reviewers,bolsson,echa\" for causing failures at browser_aiwindow_monitor_create.js.\n\nThis reverts commit 666e0b05342399bf6e3706568c1fca43fcda091c.\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/locales-preview/aiWindow.ftl"], "git_node": "f3bfb0755789140744e940bbcfd65f57406fe861", "git_parents": ["9dea12282b0095a7accd9e60cecd5630abef44eb"], "node": "a05da8612a9cc76102de89341fbb447e38e94e33", "parents": ["2dd2e345b78b4bb339b1f9ee49a39931f6c53772"], "tags": []}, {"author": "Zyphrenn \u003czyphrenn@gmail.com\u003e", "branch": "default", "desc": "Bug 2033961 - Hide \"Drag tabs together to create tab groups\" setting when tab groups are disabled. r=sthompson,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315813\n", "files": ["browser/components/preferences/config/tabs-browsing.mjs", "browser/components/preferences/tests/browser_tabs_browsing_pane.js"], "git_node": "eae0e8b72b84c45a8d9fa1333254718c2ece72ee", "git_parents": ["f3bfb0755789140744e940bbcfd65f57406fe861"], "node": "74b206f13f97d3c0f5ab0d9444a9eeede7354e5e", "parents": ["a05da8612a9cc76102de89341fbb447e38e94e33"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062245 - Migrate remaining main menu related UI tests to the efficiency framework r=aaronmt,jajohnson\n\nAll 4 UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317494\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/Selector.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsAddonsManagerPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HomeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "4c4dd7849871934d8c4ec79f7cd0111bb94aaf78", "git_parents": ["eae0e8b72b84c45a8d9fa1333254718c2ece72ee"], "node": "eb712f0f9126eb6f44e29b82e214486d8134e0fd", "parents": ["74b206f13f97d3c0f5ab0d9444a9eeede7354e5e"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060723 - Protect mIsDeferredPurgeEnabled with a lock r=jstutte\n\nThe main change is moving the read of mIsDeferredPurgeEnabled during\narena construction within the arena collection lock.  The arena\nconstructor will set this to null then after taking the lock the caller\nwill update the arena's copy of this value.\n\nThe other changes in this patch:\n * Move a read of this value within a critical section.\n * Rename a variable from \"ret\" to \"previous\"\n * Add locking annotations\n * Use default values in declarations rather than constructors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316467\n", "files": ["memory/build/Arena.h", "memory/build/mozjemalloc.cpp"], "git_node": "3131c8f5b8f7199f3d85180f866cdebead49d282", "git_parents": ["4c4dd7849871934d8c4ec79f7cd0111bb94aaf78"], "node": "138abc7231948c51cf9044b7654fbcb3e7ea4c03", "parents": ["eb712f0f9126eb6f44e29b82e214486d8134e0fd"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060723 - Fix old veriable names in comments r=jstutte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316468\n", "files": ["memory/build/mozjemalloc.cpp"], "git_node": "9599738aca6544750dafe9d2d21334f07889abef", "git_parents": ["3131c8f5b8f7199f3d85180f866cdebead49d282"], "node": "f7021c5526a579545b840071cb43ce698401477f", "parents": ["138abc7231948c51cf9044b7654fbcb3e7ea4c03"], "tags": []}, {"author": "Paul Bone \u003cpbone@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060723 - Don't set mIsDeferredPurgeEnabled to the same value r=jstutte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316469\n", "files": ["memory/build/mozjemalloc.cpp"], "git_node": "0b18706716af369b2f14eb7923d575018f26512c", "git_parents": ["9599738aca6544750dafe9d2d21334f07889abef"], "node": "afb4a81d3cf2aa34bd6c4a0a6e47a958bc60abd1", "parents": ["f7021c5526a579545b840071cb43ce698401477f"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058393 - [Nova] Polish the switch-to-tab, tab-group, and contextual-identity (user-context) chiclets and related CSS in the urlbar. r=dao,desktop-theme-reviewers,urlbar-reviewers\n\nSummary of changes below. I ended up rewriting most of the Nova path for the\ncontextual-identity (user-context) and tab-group chiclets. I left the current\npath for Proton because it's not worth updating at this point.\n\nThis also makes CSS changes related to actions and URLs that aren't strictly\nnecessary but address some areas that I think can be improved. I thought it\nmight be eaiser to review all of this together rather than separately.\n\n-----\n\nAdd the contextual-identity and tab-group chiclets to all rows as part of\n`#createRowContentForRichSuggestion()` rather than waiting until they need to be\nshown and then cloning the primary action element. That's a little more\nstraightfoward I think.\n\nUpdate the contextual-identity chiclet so it uses a background image like the\nswitch-to-tab chiclet does rather than a child `\u003cimg\u003e`. Also remove the child\n`\u003cdiv\u003e` for text label since Nova doesn't show the text label.\n\nSet the height of the contextual-identity chiclet by giving it a nbsp for its\ncontent. (This chiclet only has an icon in Nova.) The other chiclets get their\nheight from their text and padding, so this will ensure it has the same height.\nIt's a little hacky and I tried some other ways of giving all chiclets a uniform\nproper height, but it's not easy due to how deep they are in the DOM. Their\nimmediate ancestors, `.urlbarView-row-body-top-no-wrap` etc., are narrow and\naren't the full height of the row.\n\nGive both chiclets a transparent border so they're the same visual height as the\nswitch-to-tab chiclet.\n\n-----\n\nImprove the tooltips and a11y of the contextual-identity and tab-group chiclets.\nTested with NVDA on Windows and VoiceOver on Mac.\n\n-----\n\nFor each of the elements listed below, group all visibility-related rules inside\na single nested rule (exclusions noted later):\n\n* `.urlbarView-action` - Already grouped in 1 place, no change\n* `.urlbarView-explanation` - Was spread over 3 places, now 1 place\n* `.urlbarView-switchToTab-accessory` - Introduced by this patch\n* `.urlbarView-title-separator` - Was in 2 places, now 1 place\n* `.urlbarView-url` - Already grouped in 1 place, no change\n\nFor example:\n\n```css\n.urlbarView-explanation {\n  .urlbarView-row:not([has-explanation]) &,\n  .urlbarView-row[has-explanation]:not([selected], :hover) &,\n  .urlbarView:not([action-override]) .urlbarView-row[type=\"switchtab\"] & {\n    visibility: collapse;\n  }\n  @container (width \u003c 450px) {\n    & {\n      visibility: collapse;\n    }\n  }\n}\n```\n\nThe other alternative that makes sense is to group visibility rules per row\ntype. I tried that too but think per-element is a little better. Any time we add\nnew row types or need modify existing types, it's a simple matter of finding the\nmain rule for each of those elements and then updating the visibility part.\nPer-element is also how we do it right now, so this isn't a radical change.\n\nExclusions: wrap handling and \"non-standard\" rows (tips and bottom-URL rows,\nalthough we recently made tips use the standard \"rich suggestion\" DOM). I think\nit's OK to consider these cases separately, so I left the nested visibility\nrules in those alone.\n\n-----\n\nConsistently use `visibility: collapse` instead of `display: none` to hide the\nelements listed above. There's a code comment about overflow and bug 1549787.\nSeems like that ought to apply to all of these elements in all cases.\n\n-----\n\nReplace the `.urlbarView-title-separator::before { opacity: 0 }` trick for a11y\nwith something better. Tested with NVDA on Windows and VoiceOver on Mac.\n\n-----\n\nRemove two `#searchbar-new & { display: none }` rules that afaict aren't\nnecessary since the main visibility rules hide those elements.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314823\n", "files": ["browser/components/contextualidentity/test/browser/browser_switchTab_across_user_context.js", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarView/browser_resultTypes_display.js", "browser/components/urlbar/tests/browser-search/browser_oneOffs_heuristicRestyle.js", "browser/components/urlbar/tests/browser-tabs/browser_switchToTab_chiclet.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchbar_actionLabels.js", "browser/themes/shared/urlbar/view-nova.css"], "git_node": "e24404c585deceaae33e54bc7e6dae6ae653097b", "git_parents": ["0b18706716af369b2f14eb7923d575018f26512c"], "node": "328a0c403c8bff8f4687392356d6f16aa47ac943", "parents": ["afb4a81d3cf2aa34bd6c4a0a6e47a958bc60abd1"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057531 - Enable browser_referrer_click_pinned_tab.js on Linux 22.04 with Nova enabled; r=aryx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317443\n", "files": ["browser/base/content/test/referrer/browser.toml"], "git_node": "5929b8fc49fc5386841b8e2a094ddec9718da551", "git_parents": ["e24404c585deceaae33e54bc7e6dae6ae653097b"], "node": "39c7509bec0cd9a6604342ee301651f047799a6a", "parents": ["328a0c403c8bff8f4687392356d6f16aa47ac943"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058964 - Trigger full scan when storage.sqlite is missing or corrupt. r=dom-storage-reviewers,hsingh\n\nWhen storage.sqlite is missing or corrupt, SQLite silently creates a new\nempty database. MaybeCreateOrUpgradeCache now reports whether the cache\nwas newly created, and LoadQuota uses this to bypass the cache read path\nand perform a full directory scan to recover origin data.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314981\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/QuotaManager.h"], "git_node": "d5402e6232e8698ad1a2d6f898fe9f678a56658b", "git_parents": ["5929b8fc49fc5386841b8e2a094ddec9718da551"], "node": "b7e6811f936132e50e89f2e61ec489e21ddcd992", "parents": ["39c7509bec0cd9a6604342ee301651f047799a6a"], "tags": []}, {"author": "Sammy Khamis \u003cskhamis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062432: Update sync app menu promos to ignore individual engine toggles r=sync-reviewers,markh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317686\n", "files": ["browser/base/content/browser-sync.js", "browser/components/customizableui/content/sync-promo.mjs", "browser/components/customizableui/test/browser_bookmarks_sync_promo.js", "browser/components/customizableui/test/browser_history_sync_promo.js"], "git_node": "39e85de4c133bee8ee0fec59df1823319ae4e219", "git_parents": ["d5402e6232e8698ad1a2d6f898fe9f678a56658b"], "node": "e4030d456a61001b55d9229b3a02275835e1f055", "parents": ["b7e6811f936132e50e89f2e61ec489e21ddcd992"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061908 - Clean up redundant `default` values and inverted `when` conditions in configure options r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317224\n", "files": ["build/moz.configure/update-programs.configure", "js/moz.configure", "mobile/android/moz.configure", "moz.configure"], "git_node": "41187a077990821ccf636ba8604e59e0fceb4527", "git_parents": ["39e85de4c133bee8ee0fec59df1823319ae4e219"], "node": "62738be88e9a2989bb9e0cefc76ec5050e5e8606", "parents": ["e4030d456a61001b55d9229b3a02275835e1f055"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the parallel job count resolution and backend regeneration logic into shared helpers r=firefox-build-system-reviewers,sergesanspaille\n\nThis is necessary to avoid duplication further up the stack.\n\n`resolve_num_jobs` now also reads `MOZ_PARALLEL_BUILD`, so every caller\nresolves the job count the same way. `_run_make` now passes the remaining\n`MOZ_MAKE_FLAGS` through even when the caller sets `num_jobs`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316171\n", "files": ["python/mozbuild/mozbuild/base.py", "python/mozbuild/mozbuild/controller/building.py", "python/mozbuild/mozbuild/test/test_base.py"], "git_node": "6f48334dc3d4555fb1c9cc0b2f41e22546fcad50", "git_parents": ["41187a077990821ccf636ba8604e59e0fceb4527"], "node": "7ad787cd58d3ffb91c22fceaf7e9859e1952532f", "parents": ["62738be88e9a2989bb9e0cefc76ec5050e5e8606"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the Mercurial source bundle target r=firefox-build-system-reviewers,sylvestre\n\nRemoves `hg-bundle` and the variables that exist only to serve it. The recipe\nruns `hg bundle` against `$(topsrcdir)`, which requires the source tree to be a\nMercurial working copy. No taskcluster kind or mozharness script invokes it, and\nthe only references are forwarding targets in `browser/build.mk` and\n`comm-central`'s `mail/build.mk`.\n\nWithout `UPLOAD_HG_BUNDLE` the bundle never reaches `SOURCE_UPLOAD_FILES`, which\nnothing reads either, and nothing sets `HG_BUNDLE_REVISION`. Source packaging is\n`./mach source-package`, which produces a `tar.xz`.\n\n`comm-central` forwards `hg-bundle` from `mail/build.mk` and will need two\nlines removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317225\n", "files": ["browser/build.mk", "toolkit/mozapps/installer/package-name.mk", "toolkit/mozapps/installer/packager.mk", "toolkit/mozapps/installer/upload-files.mk"], "git_node": "85101411339c8ff768fc3cb059f5438b238a7b1c", "git_parents": ["6f48334dc3d4555fb1c9cc0b2f41e22546fcad50"], "node": "264040057907382ddd09f6b644dcdd3409a988b5", "parents": ["7ad787cd58d3ffb91c22fceaf7e9859e1952532f"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["browser/base/content/logos/fxa-logo.svg", "browser/components/contextualidentity/test/browser/browser_siteContainer.js", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_bfcache.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_meta.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_rdm.js", "devtools/client/inspector/rules/test/browser_rules_color_scheme_simulation_rfp.js", "devtools/client/inspector/rules/test/browser_rules_print_media_simulation.js", "devtools/client/inspector/rules/test/doc_print_media_simulation.html", "devtools/client/themes/images/rules-view-dark-mode-simulation.svg", "devtools/client/themes/images/rules-view-light-mode-simulation.svg", "js/src/irregexp/patches/disable-bytecode-analysis.patch", "js/src/tests/test262/built-ins/Atomics/pause/non-integral-iterationnumber-throws.js", "js/src/tests/test262/staging/sm/Error/constructor-proto.js", "js/src/t