browser/components/defaultwindowslaunchonlogin/DefaultWindowsLaunchOnLogin.sys.mjs", "browser/components/defaultwindowslaunchonlogin/moz.build", "browser/components/defaultwindowslaunchonlogin/tests/test_DefaultWindowsLaunchOnLogin.js", "browser/components/defaultwindowslaunchonlogin/tests/xpcshell.toml", "browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_launch_on_login.js", "browser/components/moz.build", "browser/components/preferences/main.js", "browser/components/preferences/tests/browser_windows_launch_on_login.js", "browser/components/preferences/tests/browser_windows_launch_on_login_msix.js", "browser/components/shell/StartupOSIntegration.sys.mjs", "browser/components/shell/nsIMacShellService.idl", "browser/components/shell/nsMacShellService.mm", "browser/components/tests/unit/test_startupTelemetry_launchOnLoginState.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_launch_on_login.js", "toolkit/modules/WindowsLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/LaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/MacOSLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/UnsupportedLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/WindowsLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/moz.build", "toolkit/modules/moz.build", "tools/@types/generated/lib.gecko.darwin.d.ts"], "git_node": "6cee80f87168d5aabd9e343099e2a8e5535e5320", "git_parents": ["2875eb1b250b12db2a25ea3cbce50c1b7cb83765"], "node": "5d8f92a89915507ab48edf9f3585b69d5fedf976", "parents": ["7adf2d55ec35c7f38fa6603eba0d7244d8b2c6d1"], "tags": []}], "date": 1786566037, "git_changesets": ["6cee80f87168d5aabd9e343099e2a8e5535e5320"], "user": "smolnar@mozilla.com"}, "45083": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 9ce1ee6baeb9a3c326dbd180bdece65d8fc2eadc with FIREFOX_154_0_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "fdc7b89fa373ef598034b733aeba0d85da001ac2", "git_parents": ["dda5c34f54ebe93f9ddd1fd4200e96584b970c8a"], "node": "980263d2b804efc8ba6e103945628c3103bf6975", "parents": ["71ad565005c277f2757f6c77807d1b2b5a72b01e"], "tags": []}], "date": 1786569144, "git_changesets": ["fdc7b89fa373ef598034b733aeba0d85da001ac2"], "user": "ffxbld@lando.moz.tools"}, "45084": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 9ce1ee6baeb9a3c326dbd180bdece65d8fc2eadc with FIREFOX-ANDROID_154_0_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "b7477903fc54901a821c45d3128704161414e783", "git_parents": ["fdc7b89fa373ef598034b733aeba0d85da001ac2"], "node": "aef72bce0c5ce5613da6c616f3edfbe4f9814c09", "parents": ["980263d2b804efc8ba6e103945628c3103bf6975"], "tags": []}], "date": 1786569545, "git_changesets": ["b7477903fc54901a821c45d3128704161414e783"], "user": "ffxbld@lando.moz.tools"}, "45085": {"changesets": [{"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045044 - Part 2 - Ensure clang plugin for FINAL cycle collecting macros scans all of DOM r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305339\n", "files": ["build/clang-plugin/FinalCycleCollectingIsupportsChecker.cpp"], "git_node": "a7a3af2fcaeec2a6a71455f6b955caf5a22cbab2", "git_parents": ["2875eb1b250b12db2a25ea3cbce50c1b7cb83765"], "node": "9a6325b55841c7c1766f4315ff2a28b71e96fb15", "parents": ["7adf2d55ec35c7f38fa6603eba0d7244d8b2c6d1"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054515 - add french contextual embedding support r=places-reviewers,ai-platform-reviewers,thasan,Standard8,yjamora\n\nSemantic search is gated by\n\nMinimum memory +\nsemanticFeatureGate --- triggered by Nimbus\nsmartWindowFeatureGate -- triggered by SmartWindow enrollment only\n+ Locale matching from config (en, fr)\n\nWe are using English contextual embeddings for France because they work as a fuzzy keyword matcher and perform ok with French.\n\nThose are gated by a new pref which matches locale fr-* or english/french in country \"FR\"\n\nNote that this has been restructured to use a Builder class for EmbeddingsGenerator to reduce the chance of a change in embeddings format if the country changes while the browser is running.\n\nIf a user goes from France to the UK for several weeks and restarts their browser, the embeddings will rebuild.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316141\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/SmartWindowNavigationInfo.sys.mjs", "browser/components/aiwindow/services/MemoryStore.sys.mjs", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/tabbrowser/SmartTabGrouping.sys.mjs", "toolkit/components/ml/content/nlp/EmbeddingsGenerator.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_embeddings_generator.js", "toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/components/places/PlacesSemanticHistoryManager.sys.mjs", "toolkit/components/places/tests/unit/test_PlacesSemanticHistoryManager.js", "toolkit/modules/RegionLocaleMap.sys.mjs", "toolkit/modules/moz.build", "toolkit/modules/tests/xpcshell/test_RegionLocaleMap.js", "toolkit/modules/tests/xpcshell/xpcshell.toml", "tools/@types/generated/lib.gecko.modules.d.ts"], "git_node": "70fa6f81794717d84441a6be36c898ad4cb55f9a", "git_parents": ["a7a3af2fcaeec2a6a71455f6b955caf5a22cbab2"], "node": "b3924c7c97a283dfcd194bd5ae94bfdc8efffc84", "parents": ["9a6325b55841c7c1766f4315ff2a28b71e96fb15"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060664 - Use MAC for callbacks in HNT TelemetryFeed r=mconley\n\nWhen MAC is enabled route impressions, click, and report\ncallbacks through the MAC singleton instead of directly\nusing HTTP calls. The callback URLs are still checked against\nconfigured allowed endpoints.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316381\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "336be9c68625437af95b9690fedc16aa88ea2f00", "git_parents": ["70fa6f81794717d84441a6be36c898ad4cb55f9a"], "node": "1935066c67c05b748a99f80d86a0ee89a6d7788e", "parents": ["b3924c7c97a283dfcd194bd5ae94bfdc8efffc84"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062743 - Scroll the vertical tab strip by a row per line. r=tabbrowser-reviewers,desktop-theme-reviewers,jsudiaman,emilio\n\nSince bug 2059794 the strip scrolls natively, so a wheel notch moves the wheel's\nline count times the font line height rather than whole rows: 120px against the\n249px the widget's own handler moved, measured on Linux (bug 2062682).\n\nSaying in CSS that a line is a row keeps up with the font and the nova branch by\nitself, so the measuring that fed the old value goes away -- vertical mode no\nlonger reads the widget's lineScrollAmount at all. The horizontal override stays\nfor the script path, where a line is the tab min width.\n\nMenupopups and other vertical arrowscrollboxes keep the font-derived amount,\nsince their line amount is the average measured item size.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318049\n", "files": ["browser/components/tabbrowser/content/tabs.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "8a60cd41e9403c6303ec66d35be30a40aead2910", "git_parents": ["336be9c68625437af95b9690fedc16aa88ea2f00"], "node": "f31dc911f22474b758dce785549f2bd469f765e7", "parents": ["1935066c67c05b748a99f80d86a0ee89a6d7788e"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058755 - Mark stream-open and per-chunk timing in the OpenAI pipeline r=ai-platform-reviewers,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316125\n", "files": ["toolkit/components/ml/content/backends/OpenAIPipeline.mjs"], "git_node": "518d7ea35119d5f6f4cda09bbe51c869cc8b3f4a", "git_parents": ["8a60cd41e9403c6303ec66d35be30a40aead2910"], "node": "5195292db3a56c84da9f0b77f351479ed976d871", "parents": ["f31dc911f22474b758dce785549f2bd469f765e7"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060272 - Read a tool-calling round to the end of the stream r=ai-platform-reviewers,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316126\n", "files": ["toolkit/components/ml/content/backends/OpenAIPipeline.mjs", "toolkit/components/ml/tests/browser/browser_ml_openai.js", "toolkit/components/ml/tests/browser/head.js"], "git_node": "f99c515aea8c8177016c4385f900531bd73c7217", "git_parents": ["518d7ea35119d5f6f4cda09bbe51c869cc8b3f4a"], "node": "9aea096e5b78997b68ab1fbfc9704a066de5dd99", "parents": ["5195292db3a56c84da9f0b77f351479ed976d871"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060911 - changed order of modifier chain to fix rounded corners r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317938\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabGroupList.kt"], "git_node": "7d15e73b2ab73defe987f437b815a9de4e498037", "git_parents": ["f99c515aea8c8177016c4385f900531bd73c7217"], "node": "0f37ac7405d20b1a2c9ecee6aa9121ff416e58e8", "parents": ["9aea096e5b78997b68ab1fbfc9704a066de5dd99"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2062672 - Mark some EntryWrapper methods as const and stop using MATCH. r=xpcom-reviewers,nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317842\n", "files": ["xpcom/components/nsComponentManager.cpp", "xpcom/components/nsComponentManager.h"], "git_node": "4a7cf37fa41a86e2d357f274aaf7ebd13e0a79fd", "git_parents": ["7d15e73b2ab73defe987f437b815a9de4e498037"], "node": "f2652018b80d9d02b598fe8de769e1bb057f495a", "parents": ["0f37ac7405d20b1a2c9ecee6aa9121ff416e58e8"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2062763 - Use do_CreateInstance in XPCConvert::JSValToXPCException. r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317931\n", "files": ["js/xpconnect/src/XPCConvert.cpp"], "git_node": "f0fe2283d36453da42a0d1b1a9cf02594b1e9d80", "git_parents": ["4a7cf37fa41a86e2d357f274aaf7ebd13e0a79fd"], "node": "e2d497b7ad8778c05a231a8b6869f9f1aeb0311f", "parents": ["f2652018b80d9d02b598fe8de769e1bb057f495a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Move the Rust sancov, PGO, and `PASS_ONLY_BASE_CFLAGS_TO_RUST` flag computations from Make to `moz.configure` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314512\n", "files": ["build/moz.configure/rust.configure", "config/makefiles/rust.mk"], "git_node": "a83a8eebd30db1b6763c7e13c93ffe49ff02f8a4", "git_parents": ["f0fe2283d36453da42a0d1b1a9cf02594b1e9d80"], "node": "dbd64e763dce3548593c31b933703ec03b031a39", "parents": ["e2d497b7ad8778c05a231a8b6869f9f1aeb0311f"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062871 - Accept artifact-mode Glean `object` metric test API quirks in test_BHRObserver.js r=florian\n\nWith bug 1974314 test_BHRObserver.js now runs in artifact mode.\nAlas, `object` metrics have some storage quirks in artifact mode,\nsometimes returning `null` or `[]` instead of `undefined` for empty\nfields.\n\nThis inconsistency will be investigated and addressed in bug 1965481 but\nuntil then this adaptation will allow the test to continue to work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318107\n", "files": ["toolkit/components/backgroundhangmonitor/tests/test_BHRObserver.js"], "git_node": "b8ff6455e18bd29d453a7e4f07464e8e6432c740", "git_parents": ["a83a8eebd30db1b6763c7e13c93ffe49ff02f8a4"], "node": "3bc0f63d676090e137aed0911fb0efd5a9fe92be", "parents": ["dbd64e763dce3548593c31b933703ec03b031a39"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053941 - Implement Pickup Where You Left Off entry point on Smart Window new tab r=pdahiya\n\n- Integrates PUWYLO resume pills into the full-page starter prompt flow, merging them with the existing static conversation starters\n- Adds configurable limits for resume pills vs. total starter pills\n- Wires up resume pill clicks to pass the associated memory ID and preview tabs through to the chat flow\n- Fixes an existing issue where starter/follow-up prompts weren't passing their context into submitChatMessage due to using the wrong parameter name\n- Shows resume pills only on a tab\u2019s initial fullpage load; \u201cNew Chat\u201d shows static starters\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315461\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js"], "git_node": "2cd662375e806871a99c322ad0285c6c1a2b1c76", "git_parents": ["b8ff6455e18bd29d453a7e4f07464e8e6432c740"], "node": "15a669810ad9a685c30a817dd0574bc088872a68", "parents": ["3bc0f63d676090e137aed0911fb0efd5a9fe92be"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060236 - Land strings for built-in VPN for Android promo - r=ip-protection-reviewers,fluent-reviewers,flod,kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316837\n", "files": ["browser/locales/en-US/browser/ipProtection.ftl", "python/l10n/fluent_migrations/bug_2060236_ip_protection_android_promo_callout_button.py"], "git_node": "449e6d7ebb142e27dc2059af351585a4978370b5", "git_parents": ["2cd662375e806871a99c322ad0285c6c1a2b1c76"], "node": "d1add292f73da16a8dade30f94c05cb53f4bfbe1", "parents": ["15a669810ad9a685c30a817dd0574bc088872a68"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052962 - Distinct affected-client counting for BHR via HyperLogLog r=dthayer\n\nCount distinct affected clients per hang signature and per day with a small, mergeable HyperLogLog sketch (sparse serialization). This is the basis for the percentage-of-users-affected metric. Only counts and sketches are emitted, never client ids.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313287\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/client_metrics.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/python.toml", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_client_metrics.py"], "git_node": "76791399a2761ea99204ebd42fb1b8efa0cdfc63", "git_parents": ["449e6d7ebb142e27dc2059af351585a4978370b5"], "node": "d50f260edf0381fad5d05fe4e018b7b9e8ec9900", "parents": ["d1add292f73da16a8dade30f94c05cb53f4bfbe1"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052962 - Wire --client-metrics into the BHR aggregation pipeline r=dthayer\n\nUnder --client-metrics the job reads client_id (locally only), computes the\nper-signature and day-total HyperLogLog counts and sketches, and attaches them\nto the profile as affectedClients. client_id is never written to an artifact.\n\nAlso bounds the sketch payload, which this is the first patch to actually\nproduce at scale.\n\nSketches serialize as the base64 register array, one fixed size regardless of\nhow many clients a signature affected. Storing only the nonzero registers is\nthe obvious encoding, and is smaller as raw JSON, but it is the wrong choice\nonce the consumer gzips: a mostly-zero register array is a long run of one\nbyte, which compresses far better than a map of scattered indices. Measured\nover a 200-signature, 10-day state file with distinct data per day, gzipped:\n\n  sparse, object keys        1.25 MB\n  sparse, parallel arrays    1.04 MB\n  dense, base64              0.61 MB\n\nDense also removes the failure mode sparse had. Sparse grew with the number of\ndistinct clients while dense is fixed, so past a few hundred nonzero registers\nsparse was the larger of the two and kept growing: at p=14 a signature with\n100k clients reached 181 KB against 21 KB dense, about 11x, with nothing\ncapping it.\n\nPrecision drops from p=14 to p=11 (2048 registers). Over 12 random trials per\ncardinality that measures 1.5% mean relative error and 2.6% at the 95th\npercentile, against a theoretical 2.3%, comfortably inside what a\npercentage-of-affected-users figure needs. The trade is worth making because a\nsketch is persisted per signature per day across a 365-day window, so size\ndominates.\n\nPer-sketch, that is 2.7 KB flat (1.2 KB gzipped) against a previous worst case\nof 182 KB that grew without bound.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313288\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/bhr_collection.py", "toolkit/components/backgroundhangmonitor/aggregation/client_metrics.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_client_metrics.py", "toolkit/components/backgroundhangmonitor/mach_commands.py"], "git_node": "3278129cd8a79d35a3c81efad59f3071a6bf4e20", "git_parents": ["76791399a2761ea99204ebd42fb1b8efa0cdfc63"], "node": "885c0c2f0c6a8ade627f14a691dd7cc07d72db50", "parents": ["d50f260edf0381fad5d05fe4e018b7b9e8ec9900"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052962 - Import bhr_timeseries roll-up job (from the bug-2048276 work) as base for cross-day metrics r=dthayer\n\nA day in a published series is null, not 0, when we do not know what happened.\nThat is either a day with no artifact, or a day that was truncated to its top-N\nwith this signature below the cut. 0 now means only what it says: the day kept\nevery signature it saw and this one did not hang.\n\nReporting both as 0 was misleading in the place it matters most. A zero plotted\non the dashboard asserts the hang did not occur that day, when the common cause\nis that its total ms simply did not reach the 2000th-ranked hang and we dropped\nit. The two are not distinguishable after the fact, so the artifact has to carry\nthe difference.\n\nAlso registers test_bhr_timeseries.py in python.toml, which it should have done\nwhen it added the file. Without it the tests here do not run at all until a\nlater patch adds the entry.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313289\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/bhr_timeseries.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/python.toml", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_timeseries.py"], "git_node": "2a2cfd5afdb687d86c868c1c5c820e79bfcd5a97", "git_parents": ["3278129cd8a79d35a3c81efad59f3071a6bf4e20"], "node": "bb2ca68f79fb25d1759b353ac5879d5462360c8c", "parents": ["885c0c2f0c6a8ade627f14a691dd7cc07d72db50"], "tags": []}, {"author": "Sky Ning \u003csning@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052962 - Roll up affected-client HLL sketches across 7/28/365 day windows r=dthayer\n\nThe roll-up unions the per-signature and day-total HLL sketches register-wise over each trailing window and publishes, per signature, the distinct users affected and their share of the window's total users, plus a per-day affected-users series (parallel to ms/count) for single-day hover. Windows are 7/28/365 (28 = four whole weeks). Only sketches are persisted, never ids.\n\nThe per-day affected-users series follows the same null-means-no-data rule as\nms and count, with one more way to reach it: the signature hung that day but\nthe artifact carried no client metrics, so there is a hang count and no user\ncount.\n\nImports client_metrics directly rather than behind a try/except ImportError.\nThe fallback was a leftover from before client_metrics existed: it is a sibling\nmodule added earlier in this same series, so the import cannot fail, and the\ncomment justifying it described a data condition (artifacts built without\n--client-metrics carry no sketches) that has nothing to do with importability.\nThat case is already handled by returning None when no day in the window has a\nsketch. Guarding on HyperLogLog being None was dead code that would also have\nquietly disabled affected-users reporting if the import ever did break.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313290\n", "files": ["toolkit/components/backgroundhangmonitor/aggregation/bhr_timeseries.py", "toolkit/components/backgroundhangmonitor/aggregation/tests/test_bhr_timeseries.py"], "git_node": "698b83ed478650c55dbaa648ac9c41ad330a0343", "git_parents": ["2a2cfd5afdb687d86c868c1c5c820e79bfcd5a97"], "node": "ce8d1e1856606a3a0f9bf83cfb10381ed614f4f3", "parents": ["bb2ca68f79fb25d1759b353ac5879d5462360c8c"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055648: Properly recognize mouseexits involving caption buttons on Windows r=win-reviewers,gstoll\n\nWhen mousing out of the window caption buttons, the WindowAtMouse will be the\ndummy window added by the Windows App SDK, not a Gecko window.  Ignore\nnon-Gecko child windows when analyzing the WM_[NC]WINDOWLEAVE messages sent to\nGecko windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313337\n", "files": ["widget/windows/nsWindow.cpp", "widget/windows/nsWindow.h"], "git_node": "4fa8d2c2dc24600d05481ca1a8cb5bb983495655", "git_parents": ["698b83ed478650c55dbaa648ac9c41ad330a0343"], "node": "858de38d57d977538fe5598eef70c6f08ba8d220", "parents": ["ce8d1e1856606a3a0f9bf83cfb10381ed614f4f3"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062374: Ship the Wasm Wide Arithmetic proposal. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318156\n", "files": ["js/src/jit-test/tests/wasm/binary.js", "js/src/jit-test/tests/wasm/directiveless/features.js", "js/src/jit-test/tests/wasm/wide-arithmetic.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "0161cbbefce26c25e364a111001ca93344e1ea8d", "git_parents": ["4fa8d2c2dc24600d05481ca1a8cb5bb983495655"], "node": "2cb93d84eb2718996d7d72255197d9f4276c33d3", "parents": ["858de38d57d977538fe5598eef70c6f08ba8d220"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062374: Include wide-arithmetic spec tests. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318157\n", "files": ["js/src/jit-test/etc/wasm/generate-spectests/config-lock.toml", "js/src/jit-test/etc/wasm/generate-spectests/config.toml", "js/src/jit-test/tests/wasm/spec/wide-arithmetic/directives.txt", "js/src/jit-test/tests/wasm/spec/wide-arithmetic/harness/directives.txt", "js/src/jit-test/tests/wasm/spec/wide-arithmetic/harness/harness.js", "js/src/jit-test/tests/wasm/spec/wide-arithmetic/wide-arithmetic.wast.js"], "git_node": "14ead2b9e537fc31ed4af91335b6f233eee7f713", "git_parents": ["0161cbbefce26c25e364a111001ca93344e1ea8d"], "node": "7cc2b9a03646d8a564b9c2c88e401b521ff348c3", "parents": ["2cb93d84eb2718996d7d72255197d9f4276c33d3"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2062361 - Use native rendering for checkbox / radio again. r=hjones,dwhisman,desktop-theme-reviewers\n\nThe difference is rather minor, and there's value on not rendering our\nown checkboxes (such like this bug, or in general checkboxes / radio\nbuttons looking the same for users in websites and in our UI).\n\nNote that the color still matches the nova accent color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317896\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "toolkit/content/jar.mn", "toolkit/content/widgets/moz-checkbox/moz-checkbox-icon.svg", "toolkit/content/widgets/moz-input-common.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/tokens/components/checkbox.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/checkbox.tokens.json"], "git_node": "cd0083f7cba0bb98d16669604f1b3217df289496", "git_parents": ["14ead2b9e537fc31ed4af91335b6f233eee7f713"], "node": "7d3c25738e5e572a58f93f2660036725f55080b6", "parents": ["7cc2b9a03646d8a564b9c2c88e401b521ff348c3"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2045044 - Part 2 - Ensure clang plugin for FINAL cycle collecting macros scans all of DOM r=dom-core-reviewers,smaug\" for causing build bustages\n\nThis reverts commit a7a3af2fcaeec2a6a71455f6b955caf5a22cbab2.\n", "files": ["build/clang-plugin/FinalCycleCollectingIsupportsChecker.cpp"], "git_node": "284b2d59778d748fe2dc0461e2ffb23ef6447fc1", "git_parents": ["cd0083f7cba0bb98d16669604f1b3217df289496"], "node": "0608a3656ee69570c4d406a0b0aa677fed1bd1b1", "parents": ["7d3c25738e5e572a58f93f2660036725f55080b6"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053447: Part 5 - Update for enterprise policies.r=mkaply\" for causing bc failures @ browser_searchTips.js\n\nThis reverts commit b261b48eda5c11bb45c4fbdd32f20a20d5613496.\n\nRevert \"Bug 2053447: Part 4 - Update rest of LaunchOnLogin code to use new API.r=omc-reviewers,firefox-desktop-core-reviewers ,aminomancer\"\n\nThis reverts commit 0b434d30a1b242d1ad8920247967bc0ef3c89fb1.\n\nRevert \"Bug 2053447: Part 3 - Update Launch on Login pref to use new API.r=tgiles\"\n\nThis reverts commit 913a5d3241f676e77b2a549c20dad5307790c193.\n\nRevert \"Bug 2053447: Part 2 - Port the existing LaunchOnLogin code.r=hsohaney\"\n\nThis reverts commit 8df867ed8f7b35901811417f5dafd4821470d4eb.\n\nRevert \"Bug 2053447 - Part 1: Create a LaunchOnLogin interface for macOS. r=hsohaney\"\n\nThis reverts commit 6d18ba53d5f9b3c19d4d2aa6156fccb39e0199a5.\n", "files": ["browser/app/profile/firefox.js", "browser/base/content/test/performance/browser_startup.js", "browser/components/BrowserComponents.manifest", "browser/components/StartupTelemetry.sys.mjs", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/defaultlaunchonlogin/DefaultLaunchOnLogin.sys.mjs", "browser/components/defaultlaunchonlogin/moz.build", "browser/components/defaultlaunchonlogin/tests/test_DefaultLaunchOnLogin.js", "browser/components/defaultlaunchonlogin/tests/xpcshell.toml", "browser/components/defaultwindowslaunchonlogin/DefaultWindowsLaunchOnLogin.sys.mjs", "browser/components/defaultwindowslaunchonlogin/moz.build", "browser/components/defaultwindowslaunchonlogin/tests/test_DefaultWindowsLaunchOnLogin.js", "browser/components/defaultwindowslaunchonlogin/tests/xpcshell.toml", "browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_launch_on_login.js", "browser/components/moz.build", "browser/components/preferences/main.js", "browser/components/preferences/tests/browser_windows_launch_on_login.js", "browser/components/preferences/tests/browser_windows_launch_on_login_msix.js", "browser/components/shell/StartupOSIntegration.sys.mjs", "browser/components/shell/nsIMacShellService.idl", "browser/components/shell/nsMacShellService.mm", "browser/components/tests/unit/test_startupTelemetry_launchOnLoginState.js", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_launch_on_login.js", "toolkit/modules/WindowsLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/LaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/MacOSLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/UnsupportedLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/WindowsLaunchOnLogin.sys.mjs", "toolkit/modules/launchonlogin/moz.build", "toolkit/modules/moz.build", "tools/@types/generated/lib.gecko.darwin.d.ts"], "git_node": "22613800b4e3f541d5223f39201ff32765be9db9", "git_parents": ["284b2d59778d748fe2dc0461e2ffb23ef6447fc1"], "node": "adae7962ac50752cca541897a784da097412e26e", "parents": ["0608a3656ee69570c4d406a0b0aa677fed1bd1b1"], "tags": []}, {"author": "Jared Hirsch \u003cohai@6a68.net\u003e", "branch": "default", "desc": "Bug 2063036 - Remove colon character from referral code r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318186\n", "files": ["browser/components/attribution/AttributionCode.sys.mjs", "browser/components/attribution/test/xpcshell/test_referralAttribution.js"], "git_node": "db84bf2f5cbe77e175ba69d5084bade625e99ff0", "git_parents": ["22613800b4e3f541d5223f39201ff32765be9db9"], "node": "44d13913938c8bdcd96d97813ac822fff85bd9c4", "parents": ["adae7962ac50752cca541897a784da097412e26e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062878 - Make Mach warn when a checkout is in a location known to degrade Mach's performance r=firefox-build-system-reviewers,sergesanspaille\n\nThe check only runs for employees, because the slowdown comes from software\nfound on Mozilla issued hardware.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318028\n", "files": ["build/mach_initialize.py", "python/mozbuild/mozbuild/path_performance.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_path_performance.py"], "git_node": "1c3452a3ec46c30e7209ae217d5186c0d7c2cb8f", "git_parents": ["db84bf2f5cbe77e175ba69d5084bade625e99ff0"], "node": "56ea6dd7a575d44996a8787c00b10e03041623f1", "parents": ["44d13913938c8bdcd96d97813ac822fff85bd9c4"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049606 - Avoid VPX hardware encoding on Windows for realtime applications unless hardware is forced. r=media-playback-reviewers,padenot\n\nThe frame to frame latency with the hardware VP9 hardware is\nsignificantly higher than that of the software encoders. This patch\nmakes it so that we prefer to fallback to the software VPX encoders\nfor realtime applications, unless the caller specifically requests\nhardware encoders.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318166\n", "files": ["dom/media/platforms/wmf/WMFDataEncoderUtils.cpp"], "git_node": "13574a93692205224a75b9c4f720dc7c89aeaa0d", "git_parents": ["1c3452a3ec46c30e7209ae217d5186c0d7c2cb8f"], "node": "4ebb0601cb1b2f21b575917d32458fb028705be6", "parents": ["56ea6dd7a575d44996a8787c00b10e03041623f1"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2062367 - Add new reachability factory CI task (tae-arm-reachability) r=jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318198\n", "files": ["mobile/android/test_infra/flank-configs/fenix/arm-tae-reachability-tests.yml", "mobile/android/test_infra/flank-configs/fenix/arm-tae-tests.yml", "taskcluster/kinds/ui-test-apk/kind.yml"], "git_node": "27003c7ff6b876f56d9014bba26af4d9a138c9d7", "git_parents": ["13574a93692205224a75b9c4f720dc7c89aeaa0d"], "node": "36f23890752c6afa22605651ba73fe3f78872f0a", "parents": ["4ebb0601cb1b2f21b575917d32458fb028705be6"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052548 - Update icons for theme picker r=extension-reviewers,desktop-theme-reviewers,hjones,rpl\n\nThe theme picker was showing placeholder weather icons for the light,\ndark, and device options. The picker now uses the intended sun, moon,\nand local-host icons from the design system.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317645\n", "files": ["browser/components/preferences/config/permissions-data.mjs", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/notification-icons.css", "browser/themes/shared/notification-icons/local-host.svg", "browser/themes/shared/preferences/privacy.css", "toolkit/content/widgets/theme-picker/theme-picker.mjs", "toolkit/mozapps/extensions/content/components/aboutaddons-themes-mode.mjs", "toolkit/themes/shared/desktop-jar.inc.mn", "toolkit/themes/shared/icons/local-host.svg", "toolkit/themes/shared/icons/moon.svg", "toolkit/themes/shared/icons/sun.svg"], "git_node": "5df0416ced0f0ce3f2139bf7fdf36c74ee024e4f", "git_parents": ["27003c7ff6b876f56d9014bba26af4d9a138c9d7"], "node": "6223a3b54e4b7b4b8759bfa6193d157c645de519", "parents": ["36f23890752c6afa22605651ba73fe3f78872f0a"], "tags": []}, {"author": "calu \u003ccalu@