/meta/screen-capture/permissions-policy-video.https.sub.html.ini", "testing/web-platform/meta/scroll-animations/css/scroll-timeline-dynamic.tentative.html.ini", "testing/web-platform/meta/svg/text/reftests/transform-dynamic-change.html.ini", "testing/web-platform/meta/video-rvfc/request-video-frame-callback-webrtc.https.html.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/user_prompt_opened/user_prompt_opened.py.ini", "testing/web-platform/meta/websockets/basic-auth.any.js.ini", "testing/web-platform/meta/webtransport/draining.https.any.js.ini"], "git_node": "f3083e84c10317897ac0b825479c453ca2a8bbc8", "git_parents": ["5780c4136dd26a39d1c05016ba01366f40999b35"], "node": "9b4763f9dfc1c93408bf02eb9aca5d871ea4918f", "parents": ["17b79a7dc2df80a0db24fe65728c2e4f0a5de611"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2057564 - Apply proper Nova styling to legacy search bar results r=desktop-theme-reviewers,urlbar-reviewers,adw,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314572\n", "files": ["browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "3926e0657bc3e73b629c0b3a3533cb27bef669bf", "git_parents": ["f3083e84c10317897ac0b825479c453ca2a8bbc8"], "node": "e6ea7d72d0581faedc5566ff4cac30f203221131", "parents": ["9b4763f9dfc1c93408bf02eb9aca5d871ea4918f"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056617 - Remove dialog backdrop radius when Responsive Design Mode is enabled. r=sfoster,devtools-reviewers,desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315569\n", "files": ["browser/themes/shared/tabbrowser/content-area.css", "devtools/client/responsive/ui.js"], "git_node": "80e68d49d5dc543d555b9735a719d5b7a9626486", "git_parents": ["3926e0657bc3e73b629c0b3a3533cb27bef669bf"], "node": "68302afdf4de6d08fc0d0edcdb99063f262b3a3e", "parents": ["e6ea7d72d0581faedc5566ff4cac30f203221131"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059733 - Adapt dialog backdrop radius when DevTools is enabled. r=sfoster,desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,devtools-reviewers,jdescottes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315605\n", "files": ["browser/themes/shared/tabbrowser/content-area.css", "devtools/client/framework/test/browser_toolbox_hosts.js", "devtools/client/framework/toolbox-host-manager.js", "devtools/client/framework/toolbox-hosts.js"], "git_node": "d30a2c024d80ec0c2d76d97ae9effd2e81d8f9a8", "git_parents": ["80e68d49d5dc543d555b9735a719d5b7a9626486"], "node": "cf92035fb0b3d86ecb957fe30dc978721bbe9bd2", "parents": ["68302afdf4de6d08fc0d0edcdb99063f262b3a3e"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053712 - Remove \u003csplit-view-footer\u003e end end border radius when DevTools is docked to the bottom. r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315610\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "605cf4848cce5771e8b23fb50e86893acaef21d2", "git_parents": ["d30a2c024d80ec0c2d76d97ae9effd2e81d8f9a8"], "node": "e739bd741fbd0f36edcd83cbc6e1ec7154a0cbfb", "parents": ["cf92035fb0b3d86ecb957fe30dc978721bbe9bd2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058525 - Make submenus inherit the color scheme of their parent popup. r=emilio,desktop-theme-reviewers\n\nThe generic popup rule sets color-scheme on every popup, submenus included, so\na popup that narrows its scheme couldn't pass that on: the content context\nmenu follows content's preferred color scheme, but its submenus fell back to\nthe chrome scheme, which can be the opposite one.\n\nPopups whose parent doesn't narrow the scheme are unaffected, since inheriting\nthere resolves to the same light dark.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316919\n", "files": ["browser/base/content/test/contextMenu/browser.toml", "browser/base/content/test/contextMenu/browser_contextmenu_color_scheme.js", "toolkit/themes/shared/popup.css"], "git_node": "d5678f682f3a9c7a4a38f2c3b81ef4fac6aa21f5", "git_parents": ["605cf4848cce5771e8b23fb50e86893acaef21d2"], "node": "8ef10be6afe3d354b8d6702e5e5cc3c07d9ea281", "parents": ["e739bd741fbd0f36edcd83cbc6e1ec7154a0cbfb"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998719 - Fix ESLint JSDoc valid-types issues in UITour-lib.js. r=omc-reviewers,frontend-codestyle-reviewers,mossop,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315243\n", "files": ["browser/components/uitour/UITour-lib.js", "eslint-rollouts.config.mjs"], "git_node": "c095c68d576fc3286472e76fa1202d9fcd558ada", "git_parents": ["d5678f682f3a9c7a4a38f2c3b81ef4fac6aa21f5"], "node": "41d4ae5e67b9f6a443ec77095f1cde6636e039f7", "parents": ["8ef10be6afe3d354b8d6702e5e5cc3c07d9ea281"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059647 - Check for duplicate children when walking history entries. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317013\n", "files": ["docshell/shistory/nsSHistory.cpp", "docshell/test/browser/browser.toml", "docshell/test/browser/browser_purge_shistory_keeps_current.js"], "git_node": "0592649add90e0fc7505f5fbdd0dedfa1abac491", "git_parents": ["c095c68d576fc3286472e76fa1202d9fcd558ada"], "node": "7c0dc1a53b802a22cd5179859265f1ebb62fcc4a", "parents": ["41d4ae5e67b9f6a443ec77095f1cde6636e039f7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1961577 - Keep tabs in place when collapsing a dragged tab group. r=tabbrowser-reviewers,nsharpley\n\nCollapsing a dragged tab group shrinks the tab strip's scrolled content. While\nthe strip is scrolled away from its start, that clamps the scroll position, and\nif the collapse frees up enough space the strip also stops overflowing and drops\nits scroll buttons, so the tabs that are meant to stay put slide along the strip\ninstead. Locking the tab sizes for the drag doesn't help, since none of this is\nabout how wide the tabs are.\n\nThe space of the dragged item, which the drag takes out of the layout, was\nalready being reserved at the end of the strip. This extends that reservation to\nthe tabs of a collapsing group and keeps it until they have animated back to\ntheir full size after the drop. Reserving the dragged item's margin box instead\nof its border box takes care of the same problem in the small, which is visible\nwhen dragging an already collapsed group label.\n\nWorth checking that the reservation is released on every way out of a drag,\nincluding a drop in another window: _resetTabsAfterDrop leaves it alone when a\ngroup is about to expand again, and _expandGroupOnDrop takes over from there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315576\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/test/browser/dragdrop/browser.toml", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_tab_group_overflow.js"], "git_node": "9450c9760f367d2f1f8865c5dfc88ed05668a08a", "git_parents": ["0592649add90e0fc7505f5fbdd0dedfa1abac491"], "node": "860ffa5407953af8c4a36504b377b78dcb7372eb", "parents": ["7c0dc1a53b802a22cd5179859265f1ebb62fcc4a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059680 - Annotate a few gradient and border tests. r=gfx-reviewers,gw\n\nSome of these tests don't play well with fractional scales when hard stops end up rounded one way while the reference emulating them is rounded the other way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316813\n", "files": ["gfx/wr/wrench/reftests/border/reftest.list", "gfx/wr/wrench/reftests/gradient/reftest.list"], "git_node": "d884899ccbb112f92b89d5f2cdf645bd52288338", "git_parents": ["9450c9760f367d2f1f8865c5dfc88ed05668a08a"], "node": "99c5d123bdcd73485662b30c44310e622dfb29c7", "parents": ["860ffa5407953af8c4a36504b377b78dcb7372eb"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043530 - Add never save option to address capture doorhanger. r=mtigley,fluent-reviewers,credential-management-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316857\n", "files": ["browser/extensions/formautofill/test/browser/address/browser_address_doorhanger_display.js", "browser/extensions/formautofill/test/browser/head.js", "browser/locales/en-US/browser/preferences/formAutofill.ftl", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "ac420c48756213a8b2fe4f49474c0255de23c03f", "git_parents": ["d884899ccbb112f92b89d5f2cdf645bd52288338"], "node": "a16ae0545cecbf6e075145ab53624f88d98c9c2d", "parents": ["99c5d123bdcd73485662b30c44310e622dfb29c7"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2059680 - Annotate a few gradient and border tests. r=gfx-reviewers,gw\" for causing wrench failures\n\nThis reverts commit d884899ccbb112f92b89d5f2cdf645bd52288338.\n", "files": ["gfx/wr/wrench/reftests/border/reftest.list", "gfx/wr/wrench/reftests/gradient/reftest.list"], "git_node": "88cfc204fb093f1d66d048a8ecd424c2423c1696", "git_parents": ["ac420c48756213a8b2fe4f49474c0255de23c03f"], "node": "9339c987a836f155a69af9f49fd97348c5f9ae01", "parents": ["a16ae0545cecbf6e075145ab53624f88d98c9c2d"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061640 - Disable performance-unnecessary-copy-initialization until they are fixed in the code base r=sylvestre DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317008\n", "files": ["tools/clang-tidy/config.yaml"], "git_node": "606180c5bda90e083ed2368fc96a0039f47e2b15", "git_parents": ["88cfc204fb093f1d66d048a8ecd424c2423c1696"], "node": "0d35a78a63b0634615f352b87134f2ca3a82d081", "parents": ["9339c987a836f155a69af9f49fd97348c5f9ae01"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052508 - Activate clang-tidy's modernize-use-transparent-functors check r=emilio,webrtc-reviewers,sylvestre,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310337\n", "files": ["dom/canvas/DmdStdContainers.h", "dom/media/webrtc/libwebrtcglue/MediaConduitInterface.h", "gfx/gl/Colorspaces.h", "js/loader/ImportMap.h", "js/src/vm/BigIntType.cpp", "tools/clang-tidy/config.yaml", "tools/clang-tidy/test/modernize-use-transparent-functors.cpp", "tools/clang-tidy/test/modernize-use-transparent-functors.json"], "git_node": "4be7fc19bc0f6c6026d8ac3ee4905fe0421a4daf", "git_parents": ["606180c5bda90e083ed2368fc96a0039f47e2b15"], "node": "b6711a7f953edbe74a1e3eb8dd04824c682a27ba", "parents": ["0d35a78a63b0634615f352b87134f2ca3a82d081"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2061354 - Apply the urlbar input line-height to the search bar as well r=desktop-theme-reviewers,adw,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316965\n", "files": ["browser/themes/shared/urlbar-searchbar.css"], "git_node": "3238da7d7482706cf8bc91e3ace9ec1aa5c0f181", "git_parents": ["4be7fc19bc0f6c6026