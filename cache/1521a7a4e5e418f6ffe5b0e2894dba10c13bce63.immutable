: "e31397590d51eea9d9552f79fef53d06a3d07fbe", "parents": ["f16775d2098f5b555a01cb5e6a1b2a53e656e5a9"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061758 - Part 1: Run heap check if gray marking assertions fail to give more information r=spidermonkey-reviewers,sfink\n\nThis changes the gray marking checks to print all cells that were found to be\ngray (rather than stopping at the first one) and then running a gray marking check\nover the whole heap at the end of GC if any were found (and if it is compiled in).\n\nIt also adds some extra details like trace kind and zone GC state to the output.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317112\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp"], "git_node": "71d5988e4d1fa34dcd39fde9b5b8a2d52caeb165", "git_parents": ["96175f8f0d995e3be2e928a25df495fdb5a318b6"], "node": "47ff9049790aed639bfbab4945489988b4ddc8ab", "parents": ["e31397590d51eea9d9552f79fef53d06a3d07fbe"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061758 - Part 2: Try to skip recording duplicate elements in the buffer r=spidermonkey-reviewers,sfink\n\nWe sometimes get the same cell recorded multiple times in the buffer, so add a\ncheck against the last element to help mitigate this.\n\nThe buffer doesn't seem to grow particularly large in actual use (the largest I\nsaw was ~100 elements) so it's probably not worth makin this more complicated\nby using a hash table.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317445\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/Sweeping.cpp"], "git_node": "124287f870cdb59246ab42cbf2aa0c1e6cdf86ad", "git_parents": ["71d5988e4d1fa34dcd39fde9b5b8a2d52caeb165"], "node": "86c18715db778dbcf1ab2d9d3c1878939bef407e", "parents": ["47ff9049790aed639bfbab4945489988b4ddc8ab"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057272 - Allow subsequent request per principal. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316265\n", "files": ["dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "testing/web-platform/mozilla/tests/fetch/orb/tentative/media-subsequent-request-shared-per-principal.tentative.html", "testing/web-platform/mozilla/tests/fetch/orb/tentative/resources/partial-wav.py"], "git_node": "471bc1633d475ceca964de68c00f9e6e68e353bf", "git_parents": ["124287f870cdb59246ab42cbf2aa0c1e6cdf86ad"], "node": "a85a0d9a651862dbf21a55e96db4a833de54a5e4", "parents": ["86c18715db778dbcf1ab2d9d3c1878939bef407e"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "fd459ec34d07a4c9343b4f746f8caaf0aca977c3", "git_parents": ["471bc1633d475ceca964de68c00f9e6e68e353bf", "537539ad81a9b06e8e90b07d13a66003300d7f06"], "node": "1f207a387e78d9eea0f0c7591789ac84919a6511", "parents": ["a85a0d9a651862dbf21a55e96db4a833de54a5e4", "11b07d869739452a0b2fce564da18fc1cadcbafb"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060211 - Increase expiry date for multiple test variants, r=necko-reviewers,valentin DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317737\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "65939c53734bcab87e412d824b2f35e20fe702b3", "git_parents": ["fd459ec34d07a4c9343b4f746f8caaf0aca977c3"], "node": "fd075af4f8b7e7d52bed8e3e09edb9624640134b", "parents": ["1f207a387e78d9eea0f0c7591789ac84919a6511"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056740 - [devtools] Actually manage the CustomHighlighterActor by the parent actor passed in the constructor. r=devtools-reviewers,bomsy,ochameau.\n\nWith the patch from Bug 1247553, the created CustomHighlighterActor is no longer\nreturned to the client, which mean it wasn't managed anymore.\n\nHere, we explicitly manage the new instance with the parent actor that is passed,\nso fixes the issue where the Rulers highlighters wasn't removed when closing\nthe toolbox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316454\n", "files": ["devtools/client/framework/test/browser_toolbox_rulers_button_highlighter_reload.js", "devtools/server/actors/highlighters.js"], "git_node": "e1b29c2806ffa1093ee83a0ba49adfccb523f939", "git_parents": ["65939c53734bcab87e412d824b2f35e20fe702b3"], "node": "dcaea3ad67d9d07d35d6646d06472f0e29d26fcc", "parents": ["fd075af4f8b7e7d52bed8e3e09edb9624640134b"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062526 - [devtools] Remove unnecessary _parent property in CustomHighlighterActor. r=devtools-reviewers,ochameau.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317732\n", "files": ["devtools/server/actors/highlighters.js"], "git_node": "f1e0f14c8eed1d9270bcb891bfe8b72c40c2d957", "git_parents": ["e1b29c2806ffa1093ee83a0ba49adfccb523f939"], "node": "b3c64901cf0d04999d46c01339cc43d0fc2aac44", "parents": ["dcaea3ad67d9d07d35d6646d06472f0e29d26fcc"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062528 - [devtools] Fix #enabledHighlighters usage in BaseTargetActor. r=devtools-reviewers,ochameau.\n\nThe lookup we were doing was plain wrong as we were passing it a string\nwhile we were storing an object.\nUsing a Map\u003chighlighterType, highlighterActorInstance\u003e makes it easier\u003e\nto work with.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317733\n", "files": ["devtools/server/actors/targets/base-target-actor.js"], "git_node": "409631505130d11d316d8328d38951c0752161e1", "git_parents": ["f1e0f14c8eed1d9270bcb891bfe8b72c40c2d957"], "node": "e513fa3fddec6f2acde7a5daec0ec4f01303c032", "parents": ["b3c64901cf0d04999d46c01339cc43d0fc2aac44"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2062549. Add three missing cairo patches to the moz.yaml patches list. r=gfx-reviewers,jnicol\n\nThree fixes were applied to the vendored cairo sources and patch files were\ncreated for them, but those files were never added to the `patches:` list in\ngfx/cairo/moz.yaml. Re-vendoring cairo therefore did not reapply them and could\nnot reproduce the committed tree:\n\n  patches/0047-Bug-2050228-win32-print-tiny-dash.patch\n  patches/0048-Bug-2054626-type2-decode-integer.patch (was 0047-...)\n  patches/0049-Bug-2054627-skip-token-check.patch (was 0048-...)\n\nTwo of them also used tree-relative paths (a/gfx/cairo/cairo/src/...) in their\ndiff headers. Patches are applied with `patch -p1 --directory gfx/cairo/cairo`,\nso a header has to be relative to the vendor directory (a/src/...) like every\nother patch in the list; as written these two would not have applied. Two of the\nfiles also shared the 0047 prefix, so renumber them while we are here.\n\nWith this, `./mach vendor gfx/cairo/moz.yaml -r 1.18.4 --patch-mode check\n--force` reproduces the committed tree exactly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317741\n", "files": ["gfx/cairo/moz.yaml", "gfx/cairo/patches/0047-Bug-2054626-type2-decode-integer.patch", "gfx/cairo/patches/0048-Bug-2054626-type2-decode-integer.patch", "gfx/cairo/patches/0048-Bug-2054627-skip-token-check.patch", "gfx/cairo/patches/0049-Bug-2054627-skip-token-check.patch"], "git_node": "dcd29685a8c0cf0defa27ef72b8e63f231da903f", "git_parents": ["409631505130d11d316d8328d38951c0752161e1"], "node": "d5129acc70652f456ee1b74f4e760d30d5824af3", "parents": ["e513fa3fddec6f2acde7a5daec0ec4f01303c032"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2061839 - Remove some legacy telemetry probes, r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317146\n", "files": ["browser/components/sessionstore/test/browser_bfcache_telemetry.js", "docshell/base/metrics.yaml", "netwerk/protocol/http/metrics.yaml", "toolkit/components/telemetry/Histograms.json"], "git_node": "670166adef65bd2f0427b877220e02b6c8c9f2c5", "git_parents": ["dcd29685a8c0cf0defa27ef72b8e63f231da903f"], "node": "cd67d25d99e1dd0c23415e9059a12144b1ebc860", "parents": ["d5129acc70652f456ee1b74f4e760d30d5824af3"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054299 - WebRTC backport: Video capture: fix division by zero when framerate is unset r=pehrsons\n\nSPA_FORMAT_VIDEO_framerate is optional in the PipeWire format pod. When\nabsent or zero, the unguarded division in OnFormatChanged() causes\na SIGFPE crash. Initialize format structs and fallback to max_framerate\nor a default of 30 FPS.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 67becacf3c88a16f7118766492439863406852cf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317736\n", "files": ["third_party/libwebrtc/modules/video_capture/linux/video_capture_pipewire.cc", "third_party/libwebrtc/moz-patch-stack/67becacf3c.no-op-cherry-pick-msg"], "git_node": "141fd57d3aa050312bf748d47d13dd346242f3ab", "git_parents": ["670166adef65bd2f0427b877220e02b6c8c9f2c5"], "node": "eab64a6c2c606edd49aad5e58a35da0bdd116620", "parents": ["cd67d25d99e1dd0c23415e9059a12144b1ebc860"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2018914 - Add shadowRootCustomElementRegistry IDL attribute and getHTML serialization r=dom-core-reviewers,webidl,saschanaz,edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313459\n", "files": ["dom/base/nsContentUtils.cpp", "dom/html/HTMLTemplateElement.h", "dom/webidl/HTMLTemplateElement.webidl", "testing/web-platform/meta/custom-elements/registries/template.window.js.ini"], "git_node": "1d7c83f57b84967e8ac857618977c4a932d51d33", "git_parents": ["141fd57d3aa050312bf748d47d13dd346242f3ab"], "node": "70d56b67d38058dbd764c65793bc8c8679599275", "parents": ["eab64a6c2c606edd49aad5e58a35da0bdd116620"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2062479 - [loong64] Migrate backend to FaultingCodeRange. r=jseward\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317727\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "f294f078318f3875f6cf8a40dc54ee2efc363fa8", "git_parents": ["1d7c83f57b84967e8ac857618977c4a932d51d33"], "node": "157d212fc47f4faca97282bf1c765a8c381c3a83", "parents": ["70d56b67d38058dbd764c65793bc8c8679599275"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 1: Add MASM computeScaledAddress with Address result. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316735\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "5ae24c5e912640b048afbbd2a25676d10241b8f3", "git_parents": ["f294f078318f3875f6cf8a40dc54ee2efc363fa8"], "node": "7e02912e90f7ab7579624113cf50e17c7c7f749d", "parents": ["157d212fc47f4faca97282bf1c765a8c381c3a83"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 2: Handle $zero index in computeScaledAddress. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316736\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "434cf050005480328912a18c9effcc4348552969", "git_parents": ["5ae24c5e912640b048afbbd2a25676d10241b8f3"], "node": "7036609d59b50136b9fce80244a993fa4a046d72", "parents": ["7e02912e90f7ab7579624113cf50e17c7c7f749d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 3: Add helper ToTwoInt12. r=jandem\n\nThis will be used in Part 4.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316737\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "855972add46e3bdf437501e4363cba94c88b6566", "git_parents": ["434cf050005480328912a18c9effcc4348552969"], "node": "7d21ffde63e7796980acb4788ed018c27ced2935", "parents": ["7036609d59b50136b9fce80244a993fa4a046d72"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 4: Shorten ma_{load,store} codegen for offset=si12+si12. r=jandem\n\nTry to fuse some of the offsets into the ld/st instruction itself as in\nriscv64. Since it is one instruction longer than ldptr/stptr, it's tried\nafter those.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316738\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "22f2c91d6c52018808b2f6a6ddbb63d0d135e1ad", "git_parents": ["855972add46e3bdf437501e4363cba94c88b6566"], "node": "56473662c0d2ac6e294cdf2603537b0f5826e679", "parents": ["7d21ffde63e7796980acb4788ed018c27ced2935"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 5: Redirect ma_{ld,st}_* to ma_{load,store} for better instruction selection. r=jandem\n\nNone of their callers seem to explicitly depend on the instruction\nselection of these ma_{ld,st}_*, so there's really no reasons to keep\nthem duplicated.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316739\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "0945056da51f7bb8dbccc6df3ea5b7842702e187", "git_parents": ["22f2c91d6c52018808b2f6a6ddbb63d0d135e1ad"], "node": "d9a12c8c602fe62726e5a81bb5023e238468d707", "parents": ["56473662c0d2ac6e294cdf2603537b0f5826e679"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 6: Improve codegen for loads/stores with constant heap offsets. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316740\n", "files": ["js/src/jit-test/tests/wasm/memory-loong64-ion-codegen.js", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "b0e43aa2140c3036519af3798c11fb2d80292434", "git_parents": ["0945056da51f7bb8dbccc6df3ea5b7842702e187"], "node": "3734a99c400096f4d717bd9ba2d2fe753ba119a9", "parents": ["d9a12c8c602fe62726e5a81bb5023e238468d707"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 7: Don't clobber index register in Wasm{Load,Store}I64. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316741\n", "files": ["js/src/jit/loong64/CodeGenerator-loong64.cpp"], "git_node": "991d181dc3457ad7d6c8b5e395e3dfdc77c49cd7", "git_parents": ["b0e43aa2140c3036519af3798c11fb2d80292434"], "node": "5eb99b7353c375f3f240cdaa0290fcf9c6683d44", "parents": ["3734a99c400096f4d717bd9ba2d2fe753ba119a9"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061116 - [loong64] Part 8: Optimize zero wasm-stores. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316742\n", "files": ["js/src/jit-test/tests/wasm/store-zero-loong64-ion-codegen.js", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "e97a45d0a13f711b3b9a5134cdb1665b866c8bcb", "git_parents": ["991d181dc3457ad7d6c8b5e395e3dfdc77c49cd7"], "node": "d132b94feff657f179a477cbc6669bf8ad38e048", "parents": ["5eb99b7353c375f3f240cdaa0290fcf9c6683d44"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061309 - [loong64] Part 1: Pass ZeroExtend32To64 to Wasm atomic operations. r=jandem\n\nLink: https://phabricator.services.mozilla.com/D313413 (\"Bug 2056833 -\n Part 13: Pass ZeroExtend32To64 to Wasm Atomic operations.\n r=#spidermonkey-reviewers!\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316843\n", "files": ["js/src/jit/MacroAssembler.h", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp"], "git_node": "32333cdb7a16c65770738c663aa9a378a3f427ae", "git_parents": ["e97a45d0a13f711b3b9a5134cdb1665b866c8bcb"], "node": "4c703bee0a0b1b01d6d1660a660e17032b104101", "parents": ["d132b94feff657f179a477cbc6669bf8ad38e048"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061309 - [loong64] Part 2: Enable WASM huge memory on platforms with 48+ bits of VA. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316844\n", "files": ["js/src/jit-test/tests/wasm/store-zero-loong64-ion-codegen.js", "js/src/js-config.mozbuild", "js/src/wasm/WasmMemory.cpp", "js/src/wasm/WasmProcess.cpp"], "git_node": "22a290037e65e673d7c41fd38a638de9d1766d9c", "git_parents": ["32333cdb7a16c65770738c663aa9a378a3f427ae"], "node": "564a7c10341997f51fa5b7fbc62d6acf4b4e8308", "parents": ["4c703bee0a0b1b01d6d1660a660e17032b104101"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 1: Implement simulation of am{swap,add,and,or,xor}{,_db}.[wd] instructions. r=spidermonkey-reviewers,jandem\n\nThese are part of the base LoongArch ISA (as opposed to LoongArch V1.1).\nFor the same reasons described in D313404, am{min,max}{,_db}.[wd]{,u}\nare not implemented for the lack of matching primitives from\nAtomicOperations.\n\nLink:\n https://github.com/loongson/la-toolchain-conventions/blob/36d207cd76301618624d10e67daf7b7f1c060411/LoongArch-toolchain-conventions-EN.adoc\n (\"Toolchain Conventions of the LoongArch(tm) Architecture\")\nLink: https://phabricator.services.mozilla.com/D313404 (\"Bug 2056833 -\n Part 4: Fix simulation of AMO instructions.\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317022\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp", "js/src/jit/loong64/Simulator-loong64.h"], "git_node": "180b2140acd6b7611713021c8bac015e283005de", "git_parents": ["22a290037e65e673d7c41fd38a638de9d1766d9c"], "node": "ad14f2a734a37a802b9e2b5306f934f206dff6dd", "parents": ["564a7c10341997f51fa5b7fbc62d6acf4b4e8308"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 2: Assert invalid operand combinations of atomic instructions. r=spidermonkey-reviewers,jandem\n\nThe ISA manual says:\n\n        If the AM* atomic memory access instruction has the same\n        register number as rd and rj, the execution will trigger an\n        Instruction Non-defined Exception.\n\n        If the AM* atomic memory access instruction has the same\n        register number as rd and rk, the execution result is uncertain.\n        Please software[sic.] to avoid this situation\n\nThus pleasing the software by asserting that we never generate such\ninvalid combinations.\n\nLink:\n https://github.com/loongson/LoongArch-Documentation/blob/e0d6592229d9e00e512bd28b688a7f20b171714f/docs/LoongArch-Vol1-EN/basic-integer-instructions/overview-of-basic-integer-instructions/atomic-memory-access-instructions.adoc\n (\"Atomic Memory Access Instructions\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317023\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp"], "git_node": "f2810f47ea5d5c49f459a75f9f3ee017e64a333d", "git_parents": ["180b2140acd6b7611713021c8bac015e283005de"], "node": "0d8cd070edd9cd782ea2d465f442da421fc3a8cc", "parents": ["ad14f2a734a37a802b9e2b5306f934f206dff6dd"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 3: Use AMO instructions from base ISA when possible in Atomic{Exchange,FetchOp,EffectOp}{,64}. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317024\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "6de6345f05832bcc70ff41e05fc7a0382fa2f242", "git_parents": ["f2810f47ea5d5c49f459a75f9f3ee017e64a333d"], "node": "b946332cf01c6b7880c3bddf0e33e5d86e16770a", "parents": ["0d8cd070edd9cd782ea2d465f442da421fc3a8cc"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 4: Specialize AtomicEffectOp64 and reduce temp register usage. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317025\n", "files": ["js/src/jit/LIROps.yaml", "js/src/jit/MacroAssembler.h", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/wasm/WasmBCMemory.cpp"], "git_node": "321e9d82c04c7d4eaf30ddaffe476965dbb84fc5", "git_parents": ["6de6345f05832bcc70ff41e05fc7a0382fa2f242"], "node": "6b38e162d2e1e11c5f1c53be8b391ef45edaa89a", "parents": ["b946332cf01c6b7880c3bddf0e33e5d86e16770a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 5: (Drive-by) Only register loong64-sim-* shell options on simulator. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317026\n", "files": ["js/src/shell/js.cpp"], "git_node": "9efafb914203669d4eb045d7b199d58a00f45263", "git_parents": ["321e9d82c04c7d4eaf30ddaffe476965dbb84fc5"], "node": "eceace2f08ca56a98973165f624eeb41f976b334", "parents": ["6b38e162d2e1e11c5f1c53be8b391ef45edaa89a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 6: Implement CPU feature flags detection facilities. r=spidermonkey-reviewers,jandem\n\nThis is mostly learned from riscv64's design. Loong64 does not have ISA\nstrings that can specify arbitrary extensions, so the parsing is much\nsimpler.\n\nLink:\n https://github.com/loongson/la-toolchain-conventions/blob/36d207cd76301618624d10e67daf7b7f1c060411/LoongArch-toolchain-conventions-EN.adoc\n (\"Toolchain Conventions of the LoongArch(tm) Architecture\", see Table\n 6.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317027\n", "files": ["js/src/jit/JitContext.cpp", "js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/loong64/Architecture-loong64.h", "js/src/shell/js.cpp"], "git_node": "5bf399240ba7f83cdab54af47154a0ddc8899c44", "git_parents": ["9efafb914203669d4eb045d7b199d58a00f45263"], "node": "7f27dd778c33e384f1767aa361bac5bc3022a1ef", "parents": ["eceace2f08ca56a98973165f624eeb41f976b334"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 7: Implement simulation for LAM_BH instructions. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317028\n", "files": ["js/src/jit/loong64/Architecture-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "ed71b4bbb962571a45875985992b1e9a91258391", "git_parents": ["5bf399240ba7f83cdab54af47154a0ddc8899c44"], "node": "6ab47e64b852e7dfadb09f1234cfe45f68af6a9b", "parents": ["7f27dd778c33e384f1767aa361bac5bc3022a1ef"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 8: Implement {dis,}assembly for LAM_BH instructions. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317029\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/disasm/Disasm-loong64.cpp"], "git_node": "48ec64edc764917f5b65fe980cb88e36969330bd", "git_parents": ["ed71b4bbb962571a45875985992b1e9a91258391"], "node": "261984b88d73b13a200772000922cfed217a494f", "parents": ["6ab47e64b852e7dfadb09f1234cfe45f68af6a9b"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2061654 - [loong64] Part 9: Enable code generation using LAM_BH instructions. r=spidermonkey-reviewers,jandem\n\nThis can benefit Atomic{FetchOp,EffectOp,Exchange} in their 1B/2B paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317030\n", "files": ["js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/wasm/WasmBCMemory.cpp", "js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "03c781edf7ca88b1d83bec435ae27f56775152d5", "git_parents": ["48ec64edc764917f5b65fe980cb88e36969330bd"], "node": "9ad9a7a71741b743743298879213b555822b400b", "parents": ["261984b88d73b13a200772000922cfed217a494f"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2062465 - move macOS browser-chrome tests from 10.15 Intel to 15.00 AArch64. r=florian\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317684\n", "files": ["taskcluster/test_configs/test-sets.yml"], "git_node": "f44fc244fe5e1fd11f2c9ca4360980b3df756bed", "git_parents": ["03c781edf7ca88b1d83bec435ae27f56775152d5"], "node": "9c8b32aacfaf8769d4b65e3bbef1edd594592ed7", "parents": ["9ad9a7a71741b743743298879213b555822b400b"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2062465 - disable tests which fail permanently or frequently on macOS 15 AArch64. r=florian,credential-management-reviewers,urlbar-reviewers,dao,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317685\n", "files": ["browser/base/content/test/about/browser.toml", "browser/base/content/test/contextMenu/browser.toml", "browser/base/content/test/fullscreen/browser.toml", "browser/components/asrouter/tests/browser/browser.toml", "browser/components/urlbar/tests/browser-trustPanel/browser.toml", "dom/events/test/browser.toml", "security/sandbox/test/browser.toml", "toolkit/components/certviewer/tests/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/satchel/megalist/content/tests/browser/browser.toml"], "git_node": "18de0f819dc6ddc593e156640cef4f680dfafac2", "git_parents": ["f44fc244fe5e1fd11f2c9ca4360980b3df756bed"], "node": "55d9ba5b92299435881e1dd43fc253f2a00b2d6d", "parents": ["9c8b32aacfaf8769d4b65e3bbef1edd594592ed7"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2059416 - coverity: sanitize the values read by the ots::Buffer bounds-checked reader r=jfkthame DONTBUILD\n\nCoverity treats every byte read from a font file as tainted, and\nots::Buffer is the reader through which nearly every font table field\ngoes, so almost every such field ends up reported as TAINTED_SCALAR\n(untrusted loop bound, untrusted divisor, ...).\n\nots::Buffer::Read() checks that the requested bytes are inside the\nbuffer before copying them and returns false otherwise, so a caller\nthat checks the return value only ever sees in-bounds data; validating\nthe value itself is what the OTS sanitiser does. Model the class so a\nsuccessful read sanitizes its destination, and leave CheckBounds()\nundefined so both paths of the real bounds check stay reachable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314615\n", "files": ["tools/coverity/model_file.cpp"], "git_node": "9bc1436cdc2f53db1fd8beb54523bd8e5b011c4c", "git_parents": ["18de0f819dc6ddc593e156640cef4f680dfafac2"], "node": "f2d5edb7e5755fa782fbff2f2c8bc41dea7ca17c", "parents": ["55d9ba5b92299435881e1dd43fc253f2a00b2d6d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062137 - Restart the confirmation hint auto-hide timer when a hint is already showing, r=dao.\n\nshow() clears the pending timer and then calls openPopup(), which is a no-op\nwhile the panel is open, so the popupshown listener that would rearm the timer\nnever runs. Arm it directly instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317400\n", "files": ["browser/base/content/browser.js", "browser/base/content/test/browser-confirmationHint/browser.toml", "browser/base/content/test/browser-confirmationHint/browser_confirmationHint.js", "browser/base/moz.build"], "git_node": "4ceab579b32be4661d5927e1c93c4cf57cea22b2", "git_parents": ["9bc1436cdc2f53db1fd8beb54523bd8e5b011c4c"], "node": "8f1d1f3c13e44a9ce4d0ca86a7a3c86311c6cdad", "parents": ["f2d5edb7e5755fa782fbff2f2c8bc41dea7ca17c"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2055229. Add jpeg xl speed of decode telemetry like other image formats. r=saschanaz,gfx-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312283\n", "files": ["image/decoders/metrics.yaml", "image/decoders/nsJXLDecoder.cpp", "image/decoders/nsJXLDecoder.h"], "git_node": "fa987c47ab10a415086dab23c2bc007de93a3497", "git_parents": ["4ceab579b32be4661d5927e1c93c4cf57cea22b2"], "node": "a9f9364f9cc6bcc38a2c1922c6e31c5293df9f82", "parents": ["8f1d1f3c13e44a9ce4d0ca86a7a3c86311c6cdad"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2055229. Add some jpeg xl telemetry for failure modes and feature use. r=saschanaz\n\nAdd jxl.decode_result, recorded once per image: success / partial_frame /\nno_frame for successful decodes, and a categorized failure reason\n(decode_error, size_overflow, out_of_memory, pipe_init_error,\ninvalid_frame_duration, write_error, no_basic_info) otherwise. Failures are\nrecorded on whichever decode pass first fails so failures during the\nmetadata pass are not lost.\n\nAlso add jxl.hdr and jxl.animated, recorded for successfully decoded images.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312284\n", "files": ["image/decoders/metrics.yaml", "image/decoders/nsJXLDecoder.cpp", "image/decoders/nsJXLDecoder.h", "image/test/mochitest/corrupt.jxl", "image/test/mochitest/green.jxl", "image/test/mochitest/mochitest.toml", "image/test/mochitest/test_jxl_telemetry.html"], "git_node": "78afba27c2185f5d8f98cd7c8059670be59bcd8a", "git_parents": ["fa987c47ab10a415086dab23c2bc007de93a3497"], "node": "61dd6559be815eb4371887833cbc257fe526183e", "parents": ["a9f9364f9cc6bcc38a2c1922c6e31c5293df9f82"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2062556 - Rename GetAnimPathSegList to match other GetAnimated methods r=emilio DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317747\n", "files": ["dom/svg/SVGElement.cpp", "dom/svg/SVGElement.h", "dom/svg/SVGPathElement.cpp", "dom/svg/SVGPathElement.h", "dom/svg/SVGTextPathElement.h"], "git_node": "1cac57b56524af9a6b96cad0097a5661dd8fe339", "git_parents": ["78afba27c2185f5d8f98cd7c8059670be59bcd8a"], "node": "79a8df6412d4ada42fe26000b38adcc3a688bb7b", "parents": ["61dd6559be815eb4371887833cbc257fe526183e"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061285 - Make DetailedGlyphStore::mLastUsed 