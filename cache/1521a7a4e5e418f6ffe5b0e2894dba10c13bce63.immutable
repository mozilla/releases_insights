form/meta/css/css-typed-om/the-stylepropertymap/declared/delete.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/inline/attribute-changed-callback.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/inline/delete-invalid.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/inline/delete-shorthand.html.ini", "testing/web-platform/meta/css/css-typed-om/the-stylepropertymap/inline/delete.html.ini"], "git_node": "cadda9dc89d6809edc674a2bf218af2dc3173adf", "git_parents": ["aee531ac41034bf427df0ca0acf5184014406c44"], "node": "2368a92d584c655f8392f8d848ad508b42b616ae", "parents": ["a3f40e11543d53f56b8f675c8650d44fb98a08bf"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056952 - Fire BounceTrackingState::OnStartNavigation for parent-initiated top level loads r=necko-reviewers,bvandersloot,jesup\n\nTop level navigations initiated in the parent process go through\nDocumentLoadListener::OpenInParent instead of OpenDocument. Only\nOpenDocument called BounceTrackingState::OnStartNavigation, so for parent\ninitiated loads (address bar / bookmark loads with the system principal,\nand content initiated cross-site navigations that process switch under\nFission) the BounceTrackingRecord was never created. As a result\nOnDocumentStartRequest / OnResponseReceived failed and server side bounces\nfrom these loads were never classified.\n\nMove the OnStartNavigation call to the shared DocumentLoadListener::Open\npath so it runs for both OpenDocument and OpenInParent, at navigation\ninitiation. A single logical navigation spans multiple\nDocumentLoadListeners across process switches and speculative loads, so\ndedupe the call at the BounceTrackingState layer using the navigation's\nload identifier (nsDocShellLoadState::GetLoadIdentifier), which is stable\nacross those transitions but distinct per client side redirect hop.\n\nNow that the record reliably exists, restore the OnDocumentStartRequest\nand OnResponseReceived / OnDocumentLoaded warnings that were suppressed\nfor this bug.\n\nThe test observer for record-bounces now reports the number of classified\ncandidates so waitForRecordBounces can skip finalizations that classify\nnothing, e.g. the empty extended navigation an activated initial page load\nfinalizes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313542\n", "files": ["netwerk/ipc/DocumentLoadListener.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingProtection.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp", "toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.h", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser.toml", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser_bouncetracking_parent_initiated_load.js", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/head.js"], "git_node": "8e8fb77ff1ba6a83c95db97a6422598209d478a2", "git_parents": ["cadda9dc89d6809edc674a2bf218af2dc3173adf"], "node": "42d707defb0f61730e33f2c713876bb4e072aabf", "parents": ["2368a92d584c655f8392f8d848ad508b42b616ae"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986890 - Show the \"add engine\" badge on the unified search button of the new search bar. r=daleharvey\n\nThe old search bar (browser.search.widget.new=false) badges its search button\nwhen the current page offers an opensearch engine. Do the same for the new\nsearch bar's unified search button, driven from the same OpenSearchManager path\nthat already updates the old search bar.\n\nThe badge is scoped to the search bar; the address bar's unified search button\nstays unbadged, matching the old behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311973\n", "files": ["browser/components/search/OpenSearchManager.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser/searchbar/browser.toml", "browser/themes/shared/urlbar-searchbar.css"], "git_node": "0e283f94bbe9842b0376f07e61d70762ce0fa4bb", "git_parents": ["8e8fb77ff1ba6a83c95db97a6422598209d478a2"], "node": "92d08efec462494fee743cc216df99205ddde84f", "parents": ["42d707defb0f61730e33f2c713876bb4e072aabf"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1986890 - Show the \"add engine\" badge on the unified search button of the new search bar. r=daleharvey\" for causing build bustages at /searchbar/browser.toml\n\nThis reverts commit 0e283f94bbe9842b0376f07e61d70762ce0fa4bb.\n", "files": ["browser/components/search/OpenSearchManager.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser/searchbar/browser.toml", "browser/themes/shared/urlbar-searchbar.css"], "git_node": "92784b528a229662921280b8bea8aee947319369", "git_parents": ["0e283f94bbe9842b0376f07e61d70762ce0fa4bb"], "node": "086a31370d2dbe0fa73c71dab68821be0401c2b0", "parents": ["92d08efec462494fee743cc216df99205ddde84f"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2057902 - skip tests with Nova design enabled if they fail permanently or frequently: follow-up 2\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314348\n", "files": ["browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/customizableui/test/browser.toml", "browser/components/privatebrowsing/test/browser/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "devtools/client/aboutdebugging/test/browser/browser.toml", "devtools/client/debugger/test/mochitest/browser_af.toml", "devtools/client/framework/test/browser.toml", "gfx/layers/apz/test/mochitest/mochitest.toml", "testing/we