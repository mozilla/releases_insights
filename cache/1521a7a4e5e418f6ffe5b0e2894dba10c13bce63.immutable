fragpwd.html\n\nThis reverts commit ac58947268df53fabd1462880d296d6c04b88406.\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.h", "dom/media/webrtc/sdp/SdpHelper.cpp", "dom/media/webrtc/sdp/SdpHelper.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp"], "git_node": "31f3c00665b729b7a7d44d8fea0ce365c041d66a", "git_parents": ["1d89fc93290c909e2249bbc756afdd11dfc1c042"], "node": "9f0cca5396dd812a8006de857bfd5c986c43c65f", "parents": ["8ca3de1be53fb9099df46da2e4dbe82b52c79e85"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056304 - Add the full browser theme selection panel to the New Tab customize panel r=Dre\" for causing bc process crashes\n\nThis reverts commit 35da6586e8d53462d743bbc43ec0674207b365db.\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ThemesManagementPanel/ThemesManagementPanel.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/_CustomizeMenu.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ThemesManagementPanel.test.jsx"], "git_node": "7103dc909fa7d66cf1d3cd49a4327b6b4307533f", "git_parents": ["31f3c00665b729b7a7d44d8fea0ce365c041d66a"], "node": "1224407227adc1e32da568def6