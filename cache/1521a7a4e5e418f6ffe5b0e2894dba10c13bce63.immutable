Scope/postmessage.https.html.ini", "testing/web-platform/meta/service-workers/service-worker/ServiceWorkerGlobalScope/unregister.https.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/uievents/mouse/mousemove-action-interpolation.html.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/websockets/basic-auth.any.js.ini"], "git_node": "879a239185ebddca9bba0303407d958b3da81e4c", "git_parents": ["4d05dbd53fd21a223a50783ed1272f721cda89c8"], "node": "283a323714209cebbc5e0848900bd71add6385fc", "parents": ["27856421d595c9609f6ee964e6904cd24111312b"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2057905 - Setting a single viewBox value should create the viewBox attribute r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315815\n", "files": ["dom/svg/SVGAnimatedViewBox.cpp", "testing/web-platform/tests/svg/types/scripted/SVGAnimatedRect.html"], "git_node": "9bbd0e0537b09a9b520615f4f606e1c5854d0c6b", "git_parents": ["879a239185ebddca9bba0303407d958b3da81e4c"], "node": "368ffb2105e9e8fb43b20cff707875402923e667", "parents": ["283a323714209cebbc5e0848900bd71add6385fc"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2053543 - Remove unused preference browser.shell.checkDefaultPDF. r=sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313726\n", "files": ["browser/app/profile/firefox.js"], "git_node": "bc6d52bf6c65d8adc31a212e1c704a560c49923e", "git_parents": ["9bbd0e0537b09a9b520615f4f606e1c5854d0c6b"], "node": "4f3d0f398ff0b77f49add2a200537427d3119706", "parents": ["368ffb2105e9e8fb43b20cff707875402923e667"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059700 - [devtools] Test to assert the speculation rules tag in the inspector markup view r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315630\n", "files": ["devtools/client/inspector/markup/test/browser.toml", "devtools/client/inspector/markup/test/browser_markup_speculationrules.js", "devtools/client/inspector/markup/test/doc_markup_speculationrules.html", "devtools/client/inspector/markup/test/doc_markup_speculationrules_subpage.html"], "git_node": "f80c007115c0e36afe483e60693509e595be0a4a", "git_parents": ["bc6d52bf6c65d8adc31a212e1c704a560c49923e"], "node": "b49c4e57ef57f3d881490cd35bf6fb0d68082972", "parents": ["4f3d0f398ff0b77f49add2a200537427d3119706"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009909 - [devtools] Display ::checkmark pseudo elements in the markup view. r=devtools-reviewers,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314880\n", "files": ["devtools/client/inspector/markup/test/browser_markup_pseudo.js", "devtools/client/inspector/markup/test/browser_markup_search_01.js", "devtools/client/inspector/markup/test/doc_markup_pseudo.html", "devtools/client/inspector/markup/test/doc_markup_search.css", "devtools/client/inspector/rules/test/browser_rules_pseudo-element_01.js", "devtools/client/inspector/rules/test/doc_pseudoelement.html", "devtools/client/inspector/test/browser_inspector_breadcrumbs.js", "devtools/client/inspector/test/doc_inspector_breadcrumbs.html", "devtools/client/inspector/test/highlighter/browser_inspector_highlighter-02.js", "devtools/client/inspector/test/highlighter/doc_inspector_highlighter.html", "devtools/client/inspector/test/shared-head.js", "devtools/server/actors/inspector/utils.js", "devtools/shared/inspector/css-logic.js"], "git_node": "d6c0c1e6c42a40d2a6eb746386365dd2acfc3a39", "git_parents": ["f80c007115c0e36afe483e60693509e595be0a4a"], "node": "63571e0c0712e7051efd5949a308fead206f190c", "parents": ["b49c4e57ef57f3d881490cd35bf6fb0d68082972"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058023 - Make browser_privatebrowsing_indicator.js pref-aware for browser.nova.enabled r=timhuang\n\nNova replaces the labeled indicator with the icon-only button, so the layout\ntests resolve the selector at runtime instead of hardcoding the labeled one.\nRemoves the nova skip-if.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316006\n", "files": ["browser/components/privatebrowsing/test/browser/browser.toml", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_indicator.js"], "git_node": "e0e8e6b83b78e4f7282ef6c4191b755f15d2d35d", "git_parents": ["d6c0c1e6c42a40d2a6eb746386365dd2acfc3a39"], "node": "6bd39eb0064783427e684bd2d1c748b71a583a98", "parents": ["63571e0c0712e7051efd5949a308fead206f190c"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060067 - Raise network.http.http3.max_gso_segments default from 10 to 64 r=kershaw\n\nThe previous default of 10 was an arbitrary cap well below what the OS\nsupports. The Linux kernel allows up to UDP_MAX_SEGMENTS (64) segments per\nGSO send, and quinn-udp reports this via max_gso_segments(). Sends are\nalready bounded by min(pref, socket.max_gso_segments()), so raising the\npref to 64 lets the actual OS capability govern batch size instead of an\nartificial ceiling. Windows stays at 1 (GSO disabled).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315883\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "b2ffea1db248a6c25c9be9e9c90e8c0513ceacfd", "git_parents": ["e0e8e6b83b78e4f7282ef6c4191b755f15d2d35d"], "node": "fb04c0d7caeb428426748e8b9249c7d780803054", "parents": ["6bd39eb0064783427e684bd2d1c748b71a583a98"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050135 - Un-Init Ipproteciton-Panel/Buttons on windowclose r=rking,ip-protection-reviewers,apopov\n\nWe do call panel.init() when we create them. The panel adds an eventlistener, which creates a strong ref.\n\nSo first off i added a test to check when a window closes the GC should collect the panels.\n\nIt seems no-one is calling uninit(), so we keep the strong ref's, and thus prevent the panels to be collected.\n\nSo i just add a listner to the CustomizableUI onWindowClose to call uninit and it seems it gets collected now c:\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308572\n", "files": ["browser/components/ipprotection/IPProtection.sys.mjs", "browser/components/ipprotection/tests/browser/browser.toml", "browser/components/ipprotection/tests/browser/browser_ipprotection_window_close.js"], "git_node": "7005d8cb24d2c6103f7fb187f5583e1deb01801a", "git_parents": ["b2ffea1db248a6c25c9be9e9c90e8c0513ceacfd"], "node": "48074f45da49519207f62f664695baf1a66d0be7", "parents": ["fb04c0d7caeb428426748e8b9249c7d780803054"], "tags": []}, {"author": "Artem Popov \u003capopov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054901 - IP-Protection: option to enable GPI auth provider in secret settings r=android-reviewers,jonalmeida,geckoview-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312258\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngine.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/Settings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntimeSettings.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "837bc2ef77d295631cbdfdeaf143d65301e36031", "git_parents": ["7005d8cb24d2c6103f7fb187f5583e1deb01801a"], "node": "22966c38961cc2fc56f7355e7eb8ec51149f8069", "parents": ["48074f45da49519207f62f664695baf1a66d0be7"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054901 - IP-Protection: option to enable GPI auth provider in secret settings r=android-reviewers,jonalmeida,geckoview-reviewers\" for causing browser-engine-gecko failures\n\nThis reverts commit 837bc2ef77d295631cbdfdeaf143d65301e36031.\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngine.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/Settings.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtection.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoRuntimeSettings.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "d3e7ce6714d38e3f706f480aef3b3f17b1445682", "git_parents": ["837bc2ef77d295631cbdfdeaf143d65301e36031"], "node": "4ad597356800