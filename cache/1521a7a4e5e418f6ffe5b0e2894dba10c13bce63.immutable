erential Revision: https://phabricator.services.mozilla.com/D316047\n", "files": ["browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_searchMode.js"], "git_node": "3a75a6824d8d36f0d87c4cbfd9214f414788a41d", "git_parents": ["54fd9fc147df850a4b0091c3041e7c8909bba427"], "node": "294a9933c7b36f1e33ad87a7e6d982cf3d83b374", "parents": ["05d199b1eefe3b0f8eab9b8c909cc572e0c5e969"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060276 - Record form history in UrlbarParentController::recordSearch instead of UrlbarInput. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316048\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "614733b7f823eb41325679ffede7964b890fcc18", "git_parents": ["3a75a6824d8d36f0d87c4cbfd9214f414788a41d"], "node": "a22f5c4a9da093999d1fc21289a1ba0b45410bef", "parents": ["294a9933c7b36f1e33ad87a7e6d982cf3d83b374"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056349 - ensure theme-picker reflects device appearance pref r=mstriemer,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313217\n", "files": ["browser/actors/ThemePickerChild.sys.mjs", "browser/actors/ThemePickerParent.sys.mjs", "browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/content/edit-profile-card.mjs", "browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_nova_test.js", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-direct-controller.mjs", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs", "toolkit/content/widgets/theme-picker/theme-picker.mjs"], "git_node": "ffa73b745cc28e43e2cbf7588c873355950c4047", "git_parents": ["614733b7f823eb41325679ffede7964b890fcc18"], "node": "dff295603a1c18ef698c7809f77a700e0a60f129", "parents": ["a22f5c4a9da093999d1fc21289a1ba0b45410bef"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060859 - Route BrowserUtils.willLoadInBackground and Services.urlFormatter.formatURLPref through UrlbarChild. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316545\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "a87d943a940a1cc41bbcaa218ed516c1913ec8b8", "git_parents": ["ffa73b745cc28e43e2cbf7588c873355950c4047"], "node": "d224cbbf8e98bd73263de5cbb6a07d0bc401ed8b", "parents": ["dff295603a1c18ef698c7809f77a700e0a60f129"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2060529 - Profile every record of a JSON Lines document in the JSON Viewer. r=devtools-reviewers,nchevobbe\n\ncreateSizeProfile() parsed a single JSON value and treated the rest of the\ndocument as trailing content, so for a JSON Lines document it only profiled the\nfirst line. The remaining lines were attributed to a null stack handle, which\nrecordBytesConsumed() discards, making the profile look like it was missing most\nof its samples while meta.fileSize stayed correct.\n\nPass JSONView.isJsonlines through to createSizeProfile() and loop over the\nrecords. Each record is bounded to its own line via the new endPos limit, so a\nmalformed record can no longer consume the records that follow it, and record\nvalidity is decided with JSON.parse so that the profile agrees with what the\nviewer renders as an error. Record separators and invalid lines are attributed\nto their own frames rather than dropped.\n\nAll records share the top-level \"json\" path, so a property is aggregated across\nevery record and the frame count stays bounded by the shape of the records\nrather than by their number.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316261\n", "files": ["devtools/client/jsonview/json-size-profiler.mjs", "devtools/client/jsonview/json-viewer.mjs", "devtools/client/jsonview/test/browser_jsonview_profile_size.js"], "git_node": "cf6f1c57c5413842c7676ceff8a3deff8ebce636", "git_parents": ["a87d943a940a1cc41bbcaa218ed516c1913ec8b8"], "node": "eb70e6238b3bca29c563ffa9a0cc0ba326a1e3d5", "parents": ["d224cbbf8e98bd73263de5cbb6a07d0bc401ed8b"], "tags": []}, {"author": "Teodor Tanasoaia \u003cttanasoaia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059019. r=webgpu-reviewers,aleiserson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316234\n", "files": ["dom/webgpu/ExternalTexture.cpp", "gfx/gl/GLBlitHelperD3D.cpp", "gfx/layers/d3d11/GpuProcessD3D11TextureMap.cpp", "gfx/layers/d3d11/GpuProcessD3D11TextureMap.h"], "git_node": "57b28210267ebc2e2020490244184a9869b47e77", "git_parents": ["cf6f1c57c5413842c7676ceff8a3deff8ebce636"], "node": "ff565e87813e3f433b0370d9313938c047ddabef", "parents": ["eb70e6238b3bca29c563ffa9a0cc0ba326a1e3d5"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054093 - Add /monitor command palette in smartbar r=flozia,urlbar-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312316\n", "files": ["browser/components/aiwindow/ui/assets/agent-watch.svg", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/smartw