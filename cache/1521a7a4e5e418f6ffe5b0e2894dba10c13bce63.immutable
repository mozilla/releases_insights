e/background-size-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/block-step-size-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/border-image-outset-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/column-gap-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/column-width-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/filters-blur-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/mask-border-outset-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/row-gap-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/tab-size-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/vertical-align-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/row-gap.html", "testing/web-platform/tests/css/css-viewport/zoom/tab-size.html", "testing/web-platform/tests/css/css-viewport/zoom/vertical-align.html"], "git_node": "986e10358d2c3882d73af1caba79ad28bd0b7407", "git_parents": ["d9872c069d2a37e676fcd26f6597ebdc191f4c57"], "node": "5a1b9bb1dd9a4635b56e135615e0240ce2099b49", "parents": ["ec7d88d6ed1609f1e80d42579de643a8cb1a5a26"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056655 [wpt PR 61449] - Update wpt metadata, a=testonly\n\nwpt-pr: 61449\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-viewport/zoom/background-size.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/block-step-size.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/border-image-outset.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/column-gap.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/row-gap.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/vertical-align.html.ini"], "git_node": "bdaccd9aeb658b5795867e76ad0f66d61cbf7bed", "git_parents": ["986e10358d2c3882d73af1caba79ad28bd0b7407"], "node": "51bd6795810dc4f009a8813d99958e943e94755e", "parents": ["5a1b9bb1dd9a4635b56e135615e0240ce2099b49"], "tags": []}, {"author": "Sammy Gill \u003csammy.gill@apple.com\u003e", "branch": "default", "desc": "Bug 2056653 [wpt PR 61448] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319194, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=319194 (#61448)\n--\n\nwpt-commits: 82c2a43fce2041ef49937b8651b9093a60012751\nwpt-pr: 61448\n", "files": ["testing/web-platform/tests/css/css-viewport/zoom/custom-property.html", "testing/web-platform/tests/css/css-viewport/zoom/reference/custom-property-ref.html"], "git_node": "394cf0cbeb573a14102c0c60d9dba92d4058aaef", "git_parents": ["bdaccd9aeb658b5795867e76ad0f66d61cbf7bed"], "node": "022db2f99c64da4b40996731b336e2dc6c35d7e7", "parents": ["51bd6795810dc4f009a8813d99958e943e94755e"], "tags": []}, {"author": "Javier Contreras \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2056651 [wpt PR 61447] - [gap-decorations]: Preserve flex rule pattern across fragmentation, a=testonly\n\nAutomatic update from web-platform-tests\n[gap-decorations]: Preserve flex rule pattern across fragmentation\n\nThis CL is a continuation of crrev.com/c/7899276, which landed the\nscaffolding and grid implementation for preserving rule patterns across\nfragmentation. This CL does the implementation for flex.\n\nThe convention for rule pattern continuity is that, for each fragment we\nneed:\n* the total count of row gaps across all fragments\n* the first unprocessed row gap\n\nThis allows us a gap's stitched (unfragmented) index to access the\ncorrect rule from the iterator.\n\nThe flex case is a bit tricky, as row flexboxes and column flexboxes\nfragment row gaps quite differently. The interesting case comes up with\ncolumn flex, where the row gaps exist between items within a line,\nhence, there isn't a trivial way to determine the first unprocessed row\ngap without storing the number of gaps per line.\n\nThis births the `FlexRowGapInfo` struct that stores a row gap's start\nindex and the row gap count (including suppressed ones). The flex break\ntoken carries a list of these, which is then consumed at paint for rule\npattern preservation across fragments.\n\nFor row flex, we store just one element, since only one row gap can get\nfragmented. For column flex, we store one element per line, since we\nneed to continue the pattern across each item in a line, and any line\nmay or may not have a suprressed gap.\n\nOn the paint side, we move the mutable `main_gap_running_index_` state\nthat wrongly lived in `GapGeometry` up to the paint code (a longstanding\ntodo) and use it to compute the cross gap ends and to obtain the\nstitched index of cross gaps for column flex.\n\nFinally, since the last fragment has no break token data, we derive its\nrow gap info using the previous break token and gap geometry info. This\nis possible because the last fragment can't have any suppressed gap.\n\nThis CL makes an additional change to Pre initialize main gaps in a\nfragmented column flex. This is because a test that was added recently\nstarted failing in this CL, and this CL then makes this small change to\nensure that the test no longer fails.\n\nWe need this initialization because we want to make sure that flex lines\nthat don't span all fragments (they get finished in an earlier fragment)\nstill have corresponding gaps/gap decorations in all fragments, which is\nwhat we need.\n\nBug: 505387221\nChange-Id: If3b2a04ff48a8bb9093c59f1f1fedd9b4fec59e6\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7898244\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1665562}\n\n--\n\nwpt-commits: 76301751b3f30d0df50f111a2b6a83f8f82a23a1\nwpt-pr: 61447\n", "files": ["testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-023-ref.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-023.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-024-ref.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-024.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-025-ref.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-025.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-028-ref.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-028.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-029-ref.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-029.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-030-ref.html", "testing/web-platform/tests/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-030.html"], "git_node": "83fa7598ee3dc38c932a45909bf0f87b62638fa9", "git_parents": ["394cf0cbeb573a14102c0c60d9dba92d4058aaef"], "node": "09f297440e934fae0acd3d82503e4e628555406a", "parents": ["022db2f99c64da4b40996731b336e2dc6c35d7e7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056651 [wpt PR 61447] - Update wpt metadata, a=testonly\n\nwpt-pr: 61447\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-023.html.ini", "testing/web-platform/meta/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-024.html.ini", "testing/web-platform/meta/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-025.html.ini", "testing/web-platform/meta/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-028.html.ini", "testing/web-platform/meta/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-029.html.ini", "testing/web-platform/meta/css/css-gaps/flex/fragmentation/flex-gap-decorations-fragmentation-030.html.ini"], "git_node": "153bf62177da63e40d2fe771159391190b9a4811", "git_parents": ["83fa7598ee3dc38c932a45909bf0f87b62638fa9"], "node": "f3e5faa17caf2eb5e814f0197025285083b24b71", "parents": ["09f297440e934fae0acd3d82503e4e628555406a"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2056648 [wpt PR 61446] - WebMCP: Deflake some tests, a=testonly\n\nAutomatic update from web-platform-tests\nWebMCP: Deflake some tests\n\nThis CL deflakes a couple WebMCP tests by using\n`waitForFormToolSchemaToMatch()` instead of `waitForTool()`, and\nupdating that helper's implementation to resolve with the tool.\n\nR=masonf\n\nBug: 521896358,525117902\nChange-Id: I81bb94d8151b2781161618f1317390d0ac46411c\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8121954\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1665582}\n\n--\n\nwpt-commits: 0f7f977cd7a5f4ec7cff97b4c39f62fc756e9b4f\nwpt-pr: 61446\n", "files": ["testing/web-platform/tests/webmcp/declarative/getTools-declarative-schema.https.html", "testing/web-platform/tests/webmcp/resources/helpers.js"], "git_node": "10645e134cd91964d400374f2483b99ace8a1382", "git_parents": ["153bf62177da63e40d2fe771159391190b9a4811"], "node": "03575e2c6b2675b6be7be6199f59175f9de44962", "parents": ["f3e5faa17caf2eb5e814f0197025285083b24b71"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056648 [wpt PR 61446] - Update wpt metadata, a=testonly\n\nwpt-pr: 61446\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/declarative/getTools-declarative-schema.https.html.ini"], "git_node": "5d966e27478b69206cd92425dff04fb950c266f9", "git_parents": ["10645e134cd91964d400374f2483b99ace8a1382"], "node": "2d1756acfbe71d4c3a2ce2104c2b2d3c0e8b7137", "parents": ["03575e2c6b2675b6be7be6199f59175f9de44962"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2056709 [wpt PR 61458] - WebMCP: Prevent tool execution in opaque origins, a=testonly\n\nAutomatic update from web-platform-tests\nWebMCP: Prevent tool execution in opaque origins\n\nIt's impossible to represent an opaque origin faithfully in JavaScript,\nsince there is no `Origin` object that could hold the internal nonce of\nan opaque origin. Instead, opaque origins just lossily serialize to\n\"null\".\n\nThis means if an opaque origin registers a WebMCP tool, any document\nthat can view the tool cannot execute it! This is because to execute\na tool, you must provide a `RegisteredTool` dictionary containing a\nstringified origin. For opaque origin tools, this string will never\ncapture the tool host's real origin, and the browser process will fail\n[1] the execution because the expected origin is cross-origin.\n\nWhen spec'ing executeTool(), I realized that it's cleanest and more\npredictable to just fail this in the renderer process up-front, where\nwe have the most information. So this CL synchronously rejects tool\nexecution Promises bound for opaque-origin tools.\n\nThis is a temporary limitation until https://crbug.com/536063275 is\nsolved.\n\n[1]:\nhttps://source.chromium.org/chromium/chromium/src/+/main:content/browser/renderer_host/model_context_user_data.cc;l=295-303;drc=6cc2423914a1aef76bbf526cf60187a2c18fdd47\n\nR=masonf\n\nBug: 489045948,536063275\nChange-Id: I45e9a6000d7008dd94f1db3e3c80c9697b9cb7da\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8121241\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nReviewed-by: Alex Moshchuk \u003calexmos@chromium.org\u003e\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nAuto-Submit: Dominic Farolino \u003cdom@chromium.org\u003e\nCommit-Queue: Mark Pearson \u003cmpearson@chromium.org\u003e\nReviewed-by: Mark Pearson \u003cmpearson@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1665626}\n\n--\n\nwpt-commits: 163398642601518313a64f074ee676bcd44fd69f\nwpt-pr: 61458\n", "files": ["testing/web-platform/tests/webmcp/declarative/opaque-origin-tools.https.html", "testing/web-platform/tests/webmcp/declarative/opaque-origin-tools.https.html.headers", "testing/web-platform/tests/webmcp/imperative/opaque-origin-tools.https.html"], "git_node": "60ab83d05f93f043329498181fd9780c6dad32f4", "git_parents": ["5d966e27478b69206cd92425dff04fb950c266f9"], "node": "aec3f338525f9f5e25e1d517b1513cc6a29ced18", "parents": ["2d1756acfbe71d4c3a2ce2104c2b2d3c0e8b7137"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056709 [wpt PR 61458] - Update wpt metadata, a=testonly\n\nwpt-pr: 61458\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/declarative/opaque-origin-tools.https.html.ini", "testing/web-platform/meta/webmcp/imperative/opaque-origin-tools.https.html.ini"], "git_node": "b4167a232176d234eabbbe6c9e59059332562529", "git_parents": ["60ab83d05f93f043329498181fd9780c6dad32f4"], "node": "428babd9a30cbd75492b2c096f3bbfcf47d98f77", "parents": ["aec3f338525f9f5e25e1d517b1513cc6a29ced18"], "tags": []}, {"author": "Dominic Farolino \u003cdom@chromium.org\u003e", "branch": "default", "desc": "Bug 2056687 [wpt PR 61457] - WebMCP: Document and test Object arguments, a=testonly\n\nAutomatic update from web-platform-tests\nWebMCP: Document and test Object arguments\n\nWebMCP has a helper `JSONStringToScriptObject()` to convert a string\ninto a JSON Object passed into the WebMCP tool execution callback, to\ngive the callback its arguments from the tool caller.\n\nBefore this CL, `JSONStringToScriptObject()` had an error branch for\nhandling `v8::String::NewFromUtf8()` failures. At first I thought this\nwas to handle two cases:\n 1. Invalid UTF-8 strings\n 2. Whatever else might fail, which to my knowledge is only OOMs (and\n    we're generally comfortable crashing the renderer process for those)\n\nUpon further investigation, I found that (1) above was not possible,\nbecause mojo strings are deserialized into `blink::String` objects via\n`blink::String::FromUTF8()`, which is not a lenient conversion\nmechanism, and returns a null string, which translates to a plain old\nempty `std::string` when we call `json_string.Utf8()` later.\n\nSo I originally replaced this error branch with:\n\n```\n  v8::Local\u003cv8::String\u003e v8_json_string =\n      v8::String::NewFromUtf8(script_state-\u003eGetIsolate(),\n                              json_string.Utf8().c_str())\n          .ToLocalChecked();\n```\n\nBut this still seemed wasteful:\n - At mojo deserialization time, we perform full UTF-8 validation on a\n   std::string, and assign its contents to a blink::String.\n - Later, we call `blink::String::UTF8()`, re-running UTF-8 validation\n   and producing a std::string.\n - Finally calling `v8::String::NewFromUtf8()`, which allocates a whole\n   new string (and performs UTF-8 validation again, as I understand).\n\nSo I found that there was a `V8String()` helper in the Blink bindings\nlayer specifically for converting `blink::String` values to JavaScript\nstrings. This helper avoids all of the UTF-8 re-validation, and handles\nOOM renderer crashing.\n\n----\n\nSeparately, this CL also adds more tests for another condition in that\nsame helper, which confirms that arrays are treated like Objects by\nv8 and ECMAScript. Whether this is the exact behavior we want is a\nmatter of discussion in\nhttps://github.com/webmachinelearning/webmcp/issues/92. But this CL just\naims to more-rigorously test and document the current behavior.\n\n[1]:\nhttps://source.chromium.org/chromium/chromium/src/+/main:mojo/public/cpp/bindings/lib/string_traits_wtf.cc;l=31-36;drc=0ce06599d4f0c331bfc4018b20e0b196f375cdc2\n\nR=beaufort.francois@gmail.com\n\nBug: 489045948\nChange-Id: I8ea2bfdc9bb81402afbe9d1fa5f5c45a7ed79ad1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8123202\nReviewed-by: Fr \u003cbeaufort.francois@gmail.com\u003e\nCommit-Queue: Dominic Farolino \u003cdom@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1665628}\n\n--\n\nwpt-commits: 93ac982122c6bf8be3e2f3fbcf5aca050e2d56ed\nwpt-pr: 61457\n", "files": ["testing/web-platform/tests/webmcp/imperative/object-arguments.https.html"], "git_node": "bebbc28e857e0bfd188a427c70e8e5cf6a5430ff", "git_parents": ["b4167a232176d234eabbbe6c9e59059332562529"], "node": "a89022afbe471cdd8ce3ea8f1ffb02543863e110", "parents": ["428babd9a30cbd75492b2c096f3bbfcf47d98f77"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056687 [wpt PR 61457] - Update wpt metadata, a=testonly\n\nwpt-pr: 61457\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webmcp/imperative/object-arguments.https.html.ini"], "git_node": "b97c383eec581b295dc13a63e09945523e27960c", "git_parents": ["bebbc28e857e0bfd188a427c70e8e5cf6a5430ff"], "node": "1e9e3e7c3e1d83927129c846308aea13f25d099c", "parents": ["a89022afbe471cdd8ce3ea8f1ffb02543863e110"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2056711 [wpt PR 61459] - [compression-dictionary] Make sure link element uses the baseURL, a=testonly\n\nAutomatic update from web-platform-tests\n[compression-dictionary] Make sure link element uses the baseURL\n\nSee https://html.spec.whatwg.org/multipage/semantics.html#create-link-options-from-element\n\nBug: 522338661, 40255884\nChange-Id: Ib624f2636315e9290c8c80a719afdb3e7bb894dc\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8117615\nReviewed-by: Patrick Meenan \u003cpmeenan@chromium.org\u003e\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1665649}\n\n--\n\nwpt-commits: 4ca867f5dbec7dc8937438a468918c7071fddb95\nwpt-pr: 61459\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/dictionary-fetch-with-link-element-baseURL.tentative.https.html"], "git_node": "b77d78b82706dab56f829baf3f698513c13a0ea3", "git_parents": ["b97c383eec581b295dc13a63e09945523e27960c"], "node": "6ad30e68590c552e7109dc4fe2068e5f246ffd8a", "parents": ["1e9e3e7c3e1d83927129c846308aea13f25d099c"], "tags": []}, {"author": "Keren Zhu \u003ckerenzhu@chromium.org\u003e", "branch": "default", "desc": "Bug 2056730 [wpt PR 61461] - [WPT] Align composited layers in composited-filters-under-opacity-ref, a=testonly\n\nAutomatic update from web-platform-tests\n[WPT] Align composited layers in composited-filters-under-opacity-ref\n\nThis CL fixes a 1 value difference error in WPT reftest\ncomposited-filters-under-opacity and filters-under-will-change-opacity\non some platforms / devices.\n\nPreviously, their shared reference HTML did not set will-change: opacity\non the child \u003cdiv\u003es. This caused a different rendering pipeline\n(one-pass drawing vs two-pass compositing) which resulted in subpixel\nrounding mismatches in some environments.\n\nThis CL fixes the issue by using will-change: opacity for all \u003cdiv\u003es in\nthe reference HTML, aligning with the test HTMLs.\n\nExample failure:\n\nhttps://ci.chromium.org/ui/p/chromium/builders/ci/linux-surface-embed-rel/1152/test-results?q=ExactID%3A%3A%2F%2F%5C%3Achrome_wpt_tests%21webtest%3A%3Aexternal%2Fwpt%2Fcss%2Fcss-color%23composited-filters-under-opacity.html+VHash%3A6129bda16b001a29\n\nTo reproduce locally:\n\nautoninja -C out/Default chrome chromedriver blink_tests && vpython3\nthird_party/blink/tools/run_wpt_tests.py -p chrome -t Default\nthird_party/blink/web_tests/external/wpt/css/css-color/filters-under-will-change-opacity.html\n\nBug: none\nChange-Id: I9d87525c17e5edb1f31cb026b9b0481961d6b9bf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8107116\nReviewed-by: Maks Orlovich \u003cmorlovich@chromium.org\u003e\nCommit-Queue: Keren Zhu \u003ckerenzhu@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1665715}\n\n--\n\nwpt-commits: 1dd255a403d319c4a8b69b758fe717ab2a2b89f3\nwpt-pr: 61461\n", "files": ["testing/web-platform/tests/css/css-color/composited-filters-under-opacity-ref.html"], "git_node": "e20394b9261edd3af86d8c4e27fdcc3f2b0ecd88", "git_parents": ["b77d78b82706dab56f829baf3f698513c13a0ea3"], "node": "76abd1a821d26120012c64082abd21a6ced6b4bb", "parents": ["6ad30e68590c552e7109dc4fe2068e5f246ffd8a"], "tags": []}, {"author": "Ananya Anand \u003ct-anaanand@microsoft.com\u003e", "branch": "default", "desc": "Bug 2056751 [wpt PR 61468] - [counter-styles] Make extended counter styles inherit disclosure marker direction, a=testonly\n\nAutomatic update from web-platform-tests\n[counter-styles] Make extended counter styles inherit disclosure marker direction\n\n`disclosure-open`/`disclosure-closed` paint a triangle whose direction\nfollows the writing mode and direction (e.g. pointing left in RTL), but\nthis was not propagated through `system: extends`. As a result, a custom\ncounter style extending one rendered as non-directional text and pointed\nthe wrong way in RTL and vertical writing modes.\n\nAdd `CounterStyle::GetEffectiveSymbolMarkerName()`, which follows the\n`extends` chain to the predefined symbol marker a style resolves to,\nplus an `IsDisclosureMarker()` helper for the check that was previously\nrepeated inline. Route the marker category, symbol painting, sizing,\nmargins and the `\u003csummary\u003e` marker check through them. The new behavior\nis scoped to the disclosure markers only; styles that extend `disc`,\n`circle` or `square` keep rendering as text, per\nhttps://drafts.csswg.org/css-counter-styles-3/#simple-symbolic.\n\nThe exact rendering of these markers is UA-defined, so the external\ntests use `rel=mismatch` to stay UA-independent (Chromium paints the\nmarkers as geometry rather than font glyphs):\n`disclosure-closed-extends-direction-001`/`-002`/`-003` and\n`disclosure-open-vs-closed-001`/`-002`, each with a `-notref`, cover\ndirection and open-vs-closed marker rendering across `horizontal-tb`,\n`vertical-lr`, and `vertical-rl`. A `wpt_internal` reftest,\n`disclosure-extends-painted-direction`, pins Chromium's exact marker\ngeometry against a hardcoded reference.\n\nBug: 40164946\nChange-Id: I71d75c7283cf81ca43c46fad1f479f4cee9840d7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8008803\nCommit-Queue: Ananya Anand \u003ct-anaanand@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nReviewed-by: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1665807}\n\n--\n\nwpt-commits: c1f5249311d17c3778af122fadd80adea9f0d04a\nwpt-pr: 61468\n", "files": ["testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-closed-extends-direction-001-notref.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-closed-extends-direction-001.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-closed-extends-direction-002-notref.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-closed-extends-direction-002.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-closed-extends-direction-003-notref.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-closed-extends-direction-003.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-open-vs-closed-001-notref.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-open-vs-closed-001.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-open-vs-closed-002-notref.html", "testing/web-platform/tests/css/css-counter-styles/counter-style-at-rule/disclosure-open-vs-closed-002.html"], "git_node": "f9c35ac6e76cf4fcec7f6279b566212be91f3cf3", "git_parents": ["e20394b9261edd3af86d8c4e27fdcc3f2b0ecd88"], "node": "ca1e05b73e197b17e326908cc143f75cfbac3c3a", "parents": ["76abd1a821d26120012c64082abd21a6ced6b4bb"], "tags": []}, {"author": "Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e", "branch": "default", "desc": "Bug 2056737 [wpt PR 61463] - [anchor] Shift grid/grid-lanes adjustment into AnchorEvaluatorImpl, a=testonly\n\nAutomatic update from web-platform-tests\n[anchor] Shift grid/grid-lanes adjustment into AnchorEvaluatorImpl\n\nThis unifies the logic for the various containing-block adjustments we\nneed to do for: https://drafts.csswg.org/css-position/#original-cb\n\nThis additionally fixes grid-position-area-basic.html which had an\napplication error.\n\nFixed: 467185802\nChange-Id: I78be6183a7828843a524a7aace5ed46c9ae0d7e9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8120653\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nReviewed-by: David Grogan \u003cdgrogan@chromium.org\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1665811}\n\n--\n\nwpt-commits: e916edf8532b276c06b45b3650fd68a4268265ac\nwpt-pr: 61463\n", "files": ["testing/web-platform/tests/css/css-anchor-position/grid-lanes-position-area-basic-ref.html", "testing/web-platform/tests/css/css-anchor-position/grid-lanes-position-area-basic.html"], "git_node": "c0bd2f6afa551a200113c558be55ba1f9c167b67", "git_parents": ["f9c35ac6e76cf4fcec7f6279b566212be91f3cf3"], "node": "4222388aa21c4c1498ae4eddb9f28efd0d6a7c9d", "parents": ["ca1e05b73e197b17e326908cc143f75cfbac3c3a"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056737 [wpt PR 61463] - Update wpt metadata, a=testonly\n\nwpt-pr: 61463\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-anchor-position/grid-lanes-position-area-basic.html.ini"], "git_node": "b9cefa15be1bb74ef31d230be3a27b4cb8a83020", "git_parents": ["c0bd2f6afa551a200113c558be55ba1f9c167b67"], "node": "8bb6e317e00ffb699c229a7603ce987307b1b89a", "parents": ["4222388aa21c4c1498ae4eddb9f28efd0d6a7c9d"], "tags": []}, {"author": "Ana Sollano Kim \u003cansollan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2056748 [wpt PR 61467] - Keep NSColorSampler alive past its selection handler, a=testonly\n\nAutomatic update from web-platform-tests\nKeep NSColorSampler alive past its selection handler\n\nReleasing NSColorSampler from inside its own selection handler wedges\nthe system sampler on macOS Tahoe. Hold an extra retain on the main\nqueue across the listener notification so AppKit can fully unwind the\nhandler callout before the sampler is released.\n\nAlso add a manual WPT with repeated open/select cycles so the regression\nis easier to reproduce and validate.\n\nBug: 509627745\nChange-Id: Iaf463d8c2dcb2503354d64232a52b7f0d69fc5b1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7891434\nCommit-Queue: Ana Sollano Kim \u003cansollan@microsoft.com\u003e\nReviewed-by: Avi Drissman \u003cavi@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1665815}\n\n--\n\nwpt-commits: 64b7f13eb815d799b1e7958db3c9dd4f81c301c3\nwpt-pr: 61467\n", "files": ["testing/web-platform/tests/eyedropper/manual/eye-dropper-repeated-open.tentative.html"], "git_node": "b06ed2c5a5971b5d686c552398ab8f4034b99fe0", "git_parents": ["b9cefa15be1bb74ef31d230be3a27b4cb8a83020"], "node": "86e04fb8589254e5fdf59c060a62bd3311a57e97", "parents": ["8bb6e317e00ffb699c229a7603ce987307b1b89a"], "tags": []}, {"author": "Celeste Pan \u003ccelestepan@microsoft.com\u003e", "branch": "default", "desc": "Bug 2056738 [wpt PR 61464] - [Masonry] Implement stacking-axis alignment for dense-packing, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Implement stacking-axis alignment for dense-packing\n\nThis change implements stacking-axis alignment for densely-packed items.\nWe handle this by adding the densely-packed item as the item above the\ntrack opening it's packed into.\n\nAdded a new test case which accounts for an item being densely-packed\nand splitting an opening, and then performing alignment on that item.\n\nAlso fixed broken ref files\n`row/column-dense-packing-align-items-multi-span-002-ref.html` which\nwere passing locally but not on WPT runs.\n\nBug: 343257585\nChange-Id: I7624e87f681965aab969e11338d8eb97a3106862\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8093506\nReviewed-by: Yanling Wang \u003cyanlingwang@microsoft.com\u003e\nCommit-Queue: Celeste Pan \u003ccelestepan@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1665859}\n\n--\n\nwpt-commits: f4ff7a6e7b761535b2cc564ac4d61054b71548c0\nwpt-pr: 61464\n", "files": ["testing/web-platform/tests/css/css-grid/grid-lanes/alignment/column-dense-packing-align-items-multi-span-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/column-dense-packing-align-items-multi-span-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/column-dense-packing-align-items-multi-span-003.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/column-fill-reverse-dense-packing-align-items-multi-span-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/column-fill-reverse-dense-packing-align-items-multi-span-002.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/column-fill-reverse-dense-packing-align-items-multi-span-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/column-fill-reverse-dense-packing-align-items-multi-span-003.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/row-dense-packing-justify-items-multi-span-002-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/row-dense-packing-justify-items-multi-span-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/alignment/row-dense-packing-justify-items-multi-span-003.html"], "git_node": "15fea657acfc1b0a7d7f43ac4813fb28d743f9cf", "git_parents": ["b06ed2c5a5971b5d686c552398ab8f4034b99fe0"], "node": "850fc404f4e3870bb7dd54e6a8a38a45154480e6", "parents": ["86e04fb8589254e5fdf59c060a62bd3311a57e97"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056738 [wpt PR 61464] - Update wpt metadata, a=testonly\n\nwpt-pr: 61464\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/alignment/column-dense-packing-align-items-multi-span-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/alignment/column-fill-reverse-dense-packing-align-items-multi-span-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/alignment/column-fill-reverse-dense-packing-align-items-multi-span-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/alignment/row-dense-packing-justify-items-multi-span-003.html.ini"], "git_node": "e8120743d95ddd4c80ab66c4f135c0a0143c04ae", "git_parents": ["15fea657acfc1b0a7d7f43ac4813fb28d743f9cf"], "node": "c4393656e199dc86721958abd66aa9679343eb74", "parents": ["850fc404f4e3870bb7dd54e6a8a38a45154480e6"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2056602 [wpt PR 61442] - [compression-dictionary] Use encodeURIComponent to escape match pattern., a=testonly\n\nAutomatic update from web-platform-tests\n[compression-dictionary] Use encodeURIComponent to escape match pattern.\n\n--\n\nwpt-commits: 57e48fbf38927e10e86e049b9b03c0e7a1686878\nwpt-pr: 61442\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/resources/compression-dictionary-util.sub.js"], "git_node": "327d43bf3b36aaddc433d3eee0d6b8b58e5b7224", "git_parents": ["e8120743d95ddd4c80ab66c4f135c0a0143c04ae"], "node": "248a9622c4ea5533e92f61e4ce70272114b996b3", "parents": ["c4393656e199dc86721958abd66aa9679343eb74"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056853 - [wpt-sync] Update web-platform-tests to 4c09287abd64977be00014983b8ef51281d1f2f9, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 4c09287abd64977be00014983b8ef51281d1f2f9\nwpt-type: landing\n", "files": ["testing/web-platform/meta/clipboard-apis/clipboard-copy-selection-line-break.https.html.ini", "testing/web-platform/meta/connection-allowlist/tentative/webtransport-shared-worker.https.sub.window.js.ini", "testing/web-platform/meta/css/CSS2/css1/c5510-ipadn-000.xht.ini", "testing/web-platform/meta/css/css-animations/animation-duration-infinite.html.ini", "testing/web-platform/meta/css/css-content/element-replacement-dynamic.html.ini", "testing/web-platform/meta/css/css-view-transitions/window-resize-aborts-transition.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-again-after-resetting-src.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-syntax-mediakeysession.https.html.ini", "testing/web-platform/meta/html/canvas/element/path-objects/2d.path.closed.arc.html.ini", "testing/web-platform/meta/html/dom/partial-updates/tentative/template-for-multiple-cases.html.ini", "testing/web-platform/meta/html/user-activation/activation-trigger-touch.tentative.html.ini", "testing/web-platform/meta/html/user-activation/navigate-to-sameorigin.html.ini", "testing/web-platform/meta/intersection-observer/transformed-iframe-003-cross-origin.html.ini", "testing/web-platform/meta/intersection-observer/transformed-iframe-0