/var.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/expression/call/builtin/arrayLength.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/expression/call/builtin/bufferArrayView.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/expression/call/builtin/bufferLength.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/expression/call/builtin/bufferView.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/functions/restrictions.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/shader_io/align.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/shader_io/locations.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/statement/swizzle_assignment.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/types/buffer.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/shader/validation/types/pointer.spec.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/api/validation/capability_checks/features/texture_compression_unaligned.as_worker.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/api/validation/min_buffer_binding_size.as_worker.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/execution/expression/call/builtin/bufferArrayView.as_worker.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/execution/expression/call/builtin/bufferLength.as_worker.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/execution/expression/call/builtin/bufferView.as_worker.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/validation/expression/call/builtin/bufferArrayView.as_worker.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/validation/expression/call/builtin/bufferLength.as_worker.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/validation/expression/call/builtin/bufferView.as_worker.js", "testing/web-platform/mozilla/tests/webgpu/webgpu/webworker/shader/validation/types/buffer.as_worker.js"], "git_node": "d5202c7d76dfa9a7d2ae2a997c21cf7e4f55b018", "git_parents": ["cff1d8b5320aa7f723d291bce7dc2cf957676f10"], "node": "1eef4c834028e4b6d4b80a420e627c8bcf1c1f05", "parents": ["4e2fc36feba8f6883c0424548c204bac3d18886c"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054501 - Gate Auto Tab Grouping on en-* locale and on-device ML r=Gijs,rrando\n\nBuilding Auto Tab Grouping 'v0' - largely exploratory and gated behind a pref\nNo finalized designs yet, but there is a demo: https://auto-tab-grouping.netlify.app sw0626\n\n browser.smartwindow.autoTabGrouping.enabled\n browser.ml.enable + SmartTabGroupingManager.isAllowed\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312297\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js"], "git_node": "2db765f575913e88ab606b3be0a120fd9ef75190", "git_parents": ["d5202c7d76dfa9a7d2ae2a997c21cf7e4f55b018"], "node": "6098bf125fc3b5631b45201955a150b0926fe03e", "parents": ["1eef4c834028e4b6d4b80a420e627c8bcf1c1f05"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054504 - Render the \"Group my tabs\" panel with Lit, localize it, and complete an accessibility pass r=desktop-theme-reviewers,fluent-reviewers,Gijs,bolsson,jswinarton,dao\n\nRenders the panel and flyout as light-DOM Lit custom elements\n(smartwindow-group-tabs-card / -flyout), moves the panel strings to Fluent (in\na preview/ file, since the feature is still in development), and adds an\naccessibility pass:\n\n- the card is role=\"dialog\" with aria-labelledby; focus moves into it on open\n  and returns to the toolbar button on Escape\n- suggestions are focusable buttons; focusing one opens its flyout (the\n  keyboard equivalent of hovering)\n- decorative tiles, color dots, and the chevron are aria-hidden\n- suggestion rows and the flyout expose Fluent-localized accessible names\n\nDemo (no finalized designs yet): https://auto-tab-grouping.netlify.app sw0626\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312298\n", "files": ["browser/base/content/browser.js", "browser/base/content/browser.xhtml", "browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AutoTabGrouping.sys.mjs", "browser/components/aiwindow/ui/modules/AutoTabGroupingSuggestions.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button.js", "browser/locales-preview/autoTabGrouping.ftl", "browser/locales/jar.mn", "browser/themes/shared/smartwindowGroupTabs.css"], "git_node": "5ad97192729fa57897c2b8358aec05c180fd22a1", "git_parents": ["2db765f575913e88ab606b3be0a120fd9ef75190"], "node": "1a85802bb782e37424bb12112d18e605363c8920", "parents": ["6098bf125fc3b5631b45201955a150b0926fe03e"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057046 - [efficiency] Harness core: UiElement facade + resolve() seam + ScreenDump r=isabel_rios\n\nIntroduce a backend-agnostic UiElement facade (Compose/Espresso/UiAutomator)\nand a resolve() seam in BasePage so interaction verbs no longer switch on node\ntype. Migrate mozClick onto it and retire mozClickDisplayed; resolve() picks the\ndisplayed match among duplicates, fixing ambiguous shared-label selectors in\nHorizontalPagers and lists. Add ScreenDump, a concise Compose-semantics dump\nemitted on failure (tag EffScreenDump) for a fast debug loop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313631\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/UiElement.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/ScreenDump.kt"], "git_node": "c151965cc99dfb845fea99d303c9b06f993e7cc5", "git_parents": ["5ad97192729fa57897c2b8358aec05c180fd22a1"], "node": "805333d8ab48ecb13f735cf9346cd80785dc0592", "parents": ["1a85802bb782e37424bb12112d18e605363c8920"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057050 - [efficiency] Stop screenshot-on-failure from masking real test errors; make presence checks exception-safe. r=isabel_rios\n\nOn a debug build on real hardware, Espresso's DefaultFailureHandler captures a\nscreenshot on failure; the bitmap copy trips StrictMode penaltyDeath and kills\nthe process before the real assertion error is reported, so failures look like\nopaque crashes and don't reproduce on Firebase. Install the handler with\ncaptureScreenshotOnFailure=false in BaseTest. Also make mozVerifyElement\nexception-safe: a presence check polled before navigation must never throw, or\nit re-triggers the same screenshot-\u003edeath path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313632\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/UiElement.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt"], "git_node": "28a2010d58a2bcf54811ebc6bb0f0aa252322b9b", "git_parents": ["c151965cc99dfb845fea99d303c9b06f993e7cc5"], "node": "e8d3026f4dfd177a65332787c152f5452f9579af", "parents": ["805333d8ab48ecb13f735cf9346cd80785dc0592"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057051 - [efficiency] Emit structured test logs on a dedicated 'Eff' logcat tag, plain (no baked-in color). r=isabel_rios\n\nRoute ConsoleLogger output to a dedicated \"Eff\" tag instead of the shared\nSystem.out, which any app/library println pollutes and which made filtering\nnoisy. Emit plain text and drop the baked-in ANSI color (constants, colorize(),\nthe testLogColors flag, and the now-unused type param on ok/err/skip, with the\nTimedReporter callers updated): the old palette was non-colorblind-safe\nred/green, and color is now a view-time concern owned by effpretty. Keeps the\nraw logcat artifact clean and machine-parseable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313633\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/ConsoleLogger.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/logging/TimedReporter.kt"], "git_node": "92b8eb0b1e296e86e6895bd89023ad30aac410e3", "git_parents": ["28a2010d58a2bcf54811ebc6bb0f0aa252322b9b"], "node": "7700ba5ca407ee98b5fd22eddc39e51f99045427", "parents": ["e8d3026f4dfd177a65332787c152f5452f9579af"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057052 - [efficiency] Add effpretty, an accessible renderer for structured test logs. r=isabel_rios\n\nAdd devtools/effpretty/effpretty.py, a portable Python dev tool (not run in\ntests) that renders the Eff structured stream into an indented, glyph-annotated,\ncolorblind-safe (Okabe-Ito) view, with --out for a clean ANSI-free copy. Two\nsubcommands: view (render a saved/downloaded logcat or stdin) and capture\n(--mode live|watch|dump via adb). Lets anyone render a downloaded Firebase log\nand gives AI agents a reliable plain-text handoff. README included.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313634\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effpretty/README.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/effpretty/effpretty.py"], "git_node": "45783d0418652dcb74e98a7d87fb438e7925db58", "git_parents": ["92b8eb0b1e296e86e6895bd89023ad30aac410e3"], "node": "b2ee4be0ef379eb7dea3f7b54fdd9b28f381f407", "parents": ["7700ba5ca407ee98b5fd22eddc39e51f99045427"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057136 - [efficiency] Reachability: per-page launch config r=isabel_rios\n\nThe Reachability factory auto-registers every page object and launches each one\nwith the harness default (skipOnboarding = true, standard feature flags), because\nthe launch flags are fixed on BaseTest at construction. A page that only exists\nunder a non-default launch -- e.g. Onboarding, which requires skipOnboarding =\nfalse -- can never be reached, so its generated reachability case fails.\n\nLet a page declare the launch state it needs, and have the factory honor it:\n\n- LaunchConfig: the app-launch flags a page is reached under (mirrors the\n  HomeActivityIntentTestRule flags on BaseTest, same defaults).\n- NavigationEdge / NavigationRegistry: an edge can carry a LaunchConfig, and\n  launchConfigFor(page) returns the config declared for reaching a page.\n- BaseTest: launch flags now come from an overridable launchConfig() hook that\n  defaults to the constructor args, so every existing test is unchanged.\n- Reachability: each ReachabilityCase carries its LaunchConfig (looked up from the\n  registry after bootstrapping the graph), and BaseReachabilityShardTest overrides\n  launchConfig() to launch the activity with the case's config.\n\nBehavior-preserving for existing pages: LaunchConfig() equals today's default\nlaunch, so every page that doesn't declare one resolves identically.\nNavigation-Pairs can't vary launch per case, so launch-gated pages are excluded\nfrom Pairs only.\n\nThe first consumer -- OnboardingPage declaring skipOnboarding = false -- is in the\nonboarding-conversion commit stacked on top of this one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313661\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/NavigationTestPlanner.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/reachability/BaseReachabilityShardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/reachability/ReachabilityCase.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/reachability/ReachabilityCaseFactory.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/LaunchConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/NavigationEdge.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/NavigationRegistry.kt"], "git_node": "46d2d8904cbf8879e7d50442dcc6fc753cee4b9d", "git_parents": ["45783d0418652dcb74e98a7d87fb438e7925db58"], "node": "0e6812c95cdb4fc539d808c328f24fa08c393a30", "parents": ["b2ee4be0ef379eb7dea3f7b54fdd9b28f381f407"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057054 - [efficiency] Convert Onboarding card smoke tests to ui/efficiency r=isabel_rios\n\nFirst smoke-conversion pilot. Add OnboardingPage, OnboardingSelectors, and five\ncard tests (Terms of Use, Default Browser, Search Widget, Sync, Toolbar),\nlaunched via BaseTest(skipOnboarding=false) and walking the pager with mozClick.\nThe runtime-gated Notification card is excluded. Establishes the selector-\nstrategy rule (prefer testTag/resource-id/content-description/text) captured in\nthe efficiency-test-authoring skill.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313635\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/OnboardingPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/OnboardingSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/OnboardingTest.kt"], "git_node": "501e4fb648de67c65545d8b2a0681f45c57f0caa", "git_parents": ["46d2d8904cbf8879e7d50442dcc6fc753cee4b9d"], "node": "cd4971c22cc082e2456fe133ed4ce246fc02306b", "parents": ["0e6812c95cdb4fc539d808c328f24fa08c393a30"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1806181 - Add distinct errors for SDP parsing failures. r=webrtc-reviewers,bwc,diegociudadreale,!bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295656\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.h", "dom/media/webrtc/sdp/SdpHelper.cpp", "dom/media/webrtc/sdp/SdpHelper.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp"], "git_node": "ac58947268df53fabd1462880d296d6c04b88406", "git_parents": ["501e4fb648de67c65545d8b2a0681f45c57f0caa"], "node": "79d23ded502f30601263409c59e3e33d1e90dcdc", "parents": ["cd4971c22cc082e2456fe133ed4ce246fc02306b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035579 - Wire rusttests through the build system to link in-tree native libraries r=nalexander,firefox-build-system-reviewers\n\nRust tests may depend on native libraries built elsewhere in the tree,\nboth at link time and at run time. Make `RustTests` a `Linkable` so it can\ncarry `USE_LIBS`, and have the emitter and recursivemake backend turn\nthose `USE_LIBS` into build ordering dependencies via a shared\n`_add_rust_build_order_deps`. Cargo still performs the actual linking, so\nthe `USE_LIBS` only guarantee the dependencies are built ahead of the\ntests.\n\nA dependency may produce generated files during the `pre-compile` tier,\nwhich the `rusttests` build did not run. Add `pre-compile` to its `ALL_TIERS`\nso those prerequisites exist before the tests build.\n\nAt test time the binaries find their shared library dependencies via an\nrpath to dist/bin on Linux and macOS, or libraries staged next to them\non Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311624\n", "files": ["config/baseconfig.mk", "config/makefiles/rust.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py"], "git_node": "dbc812d13920733b2e2f95e6e920cc28e7541759", "git_parents": ["ac58947268df53fabd1462880d296d6c04b88406"], "node": "77531261321c2d8419dce03b29f81483ab8ea5ba", "parents": ["79d23ded502f30601263409c59e3e33d1e90dcdc"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Vendor `proguard-rules-consumer-jna.pro` r=nalexander\n\nThe full megazord applies it via `consumerProguardFiles`, so excluding it from\nvendoring breaks the build at `mergeReleaseConsumerProguardFiles`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313773\n", "files": ["third_party/application-services/moz.yaml", "third_party/application-services/proguard-rules-consumer-jna.pro"], "git_node": "2b0d3ea91668ce93f75ee7014bcbfc16b8bfe3d0", "git_parents": ["dbc812d13920733b2e2f95e6e920cc28e7541759"], "node": "f8e6700f2b0f74d621c800d771786004c34747f3", "parents": ["77531261321c2d8419dce03b29f81483ab8ea5ba"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045093 - Add arm64 android emulator raptor perf tests. r=perftest-reviewers,mozperftest-reviewers,taskgraph-reviewers,bhearsum,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309413\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/gecko_taskgraph/transforms/test/raptor.py", "taskcluster/gecko_taskgraph/transforms/test/worker.py", "taskcluster/kinds/browsertime/kind.yml", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "testing/mozharness/configs/raptor/android_emulator_macosx_config.py", "testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/perfdocs/generated/raptor.rst"], "git_node": "5c5857cce779ce20367a3d80dc4eeba2cd732dd3", "git_parents": ["2b0d3ea91668ce93f75ee7014bcbfc16b8bfe3d0"], "node": "4d1d77ee9303773cf5f5cd4d5fa8e0bebc36b8bd", "parents": ["f8e6700f2b0f74d621c800d771786004c34747f3"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056301 - Add New Tab customize panel browser theme strings r=fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313090\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "550e4d1b75151b333b507a75aaeb509f738ff3bd", "git_parents": ["5c5857cce779ce20367a3d80dc4eeba2cd732dd3"], "node": "158b13c2adf89e49c5f41b15c96f033570bd269f", "parents": ["4d1d77ee9303773cf5f5cd4d5fa8e0bebc36b8bd"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056300 - Integrate the compact theme-picker into the New Tab customize panel r=Dre\n\nEmbed the reusable toolkit `theme-picker` element (compact layout) in the New Tab customize panel so users can switch their Firefox theme directly from Firefox Home.\n\n- Render `\u003ctheme-picker layout=\"compact\" installsource=\"about:newtab\"\u003e` in ContentSection, gated on the browser-wide `browser.nova.enabled` pref. PrefsFeed reads and observes that pref and broadcasts it to content as `browserNovaEnabled`; CustomizeMenu threads it through to ContentSection.\n- Register the ThemePicker JSWindowActor for `about:newtab` and `about:home` so the element's remote controller can reach AddonManager/ThemesList via the parent in the content sandbox (about:home covers the startup-cache first tab).\n- Load the theme-picker / moz-visual-picker / moz-segmented-control element modules in the live-rendered page (render-activity-stream-html.js) and the about:home startup-cache template (page.html.template) so the custom element is defined on both normal and cached pages.\n- Add tests for the gate (ContentSection) and the pref observer/broadcast (PrefsFeed).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313091\n", "files": ["browser/extensions/newtab/bin/render-activity-stream-html.js", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/_CustomizeMenu.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/abouthomecache/page.html.template", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/prerendered/activity-stream-debug.html", "browser/extensions/newtab/prerendered/activity-stream-noscripts.html", "browser/extensions/newtab/prerendered/activity-stream.html", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/unit/lib/PrefsFeed.test.js"], "git_node": "6b1f2658d4abc5b5ff429cb54ec1038ef497b416", "git_parents": ["550e4d1b75151b333b507a75aaeb509f738ff3bd"], "node": "d2552e711a8e98b5d521f4ee728d8739414bb866", "parents": ["158b13c2adf89e49c5f41b15c96f033570bd269f"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056304 - Add the full browser theme selection panel to the New Tab customize panel r=Dre\n\nWire the existing \"See more themes\" button in the customize panel's Appearance section to a new full theme selection sub-panel.\n\n- New ThemesManagementPanel (mirrors WidgetsManagementPanel): the box-button opens a sliding sub-panel with a back button (\"Firefox Themes\" title), the full-layout theme-picker (Light/Dark/Device chooser + all themes), and a moz-box-link out to the about:addons themes list.\n- Panel visibility state (showThemesPanel / toggleThemesPanel) lives in Base and is threaded through CustomizeMenu to ContentSection.\n- OPEN_ABOUT_ADDONS_THEMES action + AboutPreferences handler open addons://list/theme via BrowserAddonUI.openAddonsMgr.\n- Load the moz-box-link element module in the prerendered and startup-cache HTML; reuse the mgmt-panel slide styles for .themes-mgmt-panel.\n- Tests for the panel and appearance section; Karma coverage override for the Jest-tested panel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313092\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ThemesManagementPanel/ThemesManagementPanel.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/_CustomizeMenu.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ThemesManagementPanel.test.jsx"], "git_node": "35da6586e8d53462d743bbc43ec0674207b365db", "git_parents": ["6b1f2658d4abc5b5ff429cb54ec1038ef497b416"], "node": "a0ea4cfa1964f4097339ec7021fdb99f3ec3ab68", "parents": ["d2552e711a8e98b5d521f4ee728d8739414bb866"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2054787: Simplify this; alpn was hard-coded anyway. r=kershaw,necko-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313609\n", "files": ["dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/transport/ipc/WebrtcProxyConfig.ipdlh", "dom/media/webrtc/transport/ipc/WebrtcTCPSocket.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/test/unit/test_proxyconnect.js"], "git_node": "6c43188d534dde2d8372728b51f1abb7fa23ac8d", "git_parents": ["35da6586e8d53462d743bbc43ec0674207b365db"], "node": "d4fdcc8b027aa92adb89584e840f8fcc2c3d822b", "parents": ["a0ea4cfa1964f4097339ec7021fdb99f3ec3ab68"], "tags": []}, {"author": "Shane Hughes \u003cshughes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057060 - Make launch-on-login attributes and targeting usable by Nimbus. r=dmose\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313652\n", "files": ["toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/metrics.yaml"], "git_node": "ff8a76c3e167d1dc6a74b7e9ab89e16b367951be", "git_parents": ["6c43188d534dde2d8372728b51f1abb7fa23ac8d"], "node": "36f10f3f346652df09d5240cf088c3c7b569a969", "parents": ["d4fdcc8b027aa92adb89584e840f8fcc2c3d822b"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes ct-logs - r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313837\n", "files": ["netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": "754fd6f25e8bc3c4fbcdd8fb1ee1a65b92861abd", "git_parents": ["ff8a76c3e167d1dc6a74b7e9ab89e16b367951be"], "node": "18ce1bfc8bdb53b9ae0a681ff679c44f06d004a8", "parents": ["36f10f3f346652df09d5240cf088c3c7b569a969"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2056510. Fix mach vendor silently skipping quoted or unusual revision/release values. r=tjr\n\nupdate_yaml() rewrites the `release:` and `revision:` lines of a moz.yaml after\na vendor. It located the value to replace with the regex `[v\\.a-f0-9]+`, whose\ncharacter class excludes the quote character, so a hand-written value such as\n`revision: \"v1.3.0\"` was never matched and the field was left unchanged. The\nclass also excludes anything not starting with v/./hex, so tags such as\n`VER-2-14-2` or `NSPR_4_39_RTM` were skipped as well.\n\nThe failure was silent: `replaced` was incremented whenever the key was present\nrather than when a substitution actually happened, so\n`assert len(replacements) == replaced` passed even though nothing was written.\n\nMatch the rest of the line, so quoted and unusual values are replaced too, and\ncount the actual substitutions, so a no-op now trips the assert loudly instead\nof leaving a stale field behind.\n\nThis has been biting the tree. A scan of all 112 moz.yaml files found ~17\nlibraries whose release/revision update_yaml silently skips, including:\n  - media/libjpeg, media/libpng: quoted revisions (\"3.1.4.1\", \"v1.6.58\")\n  - media/libmkv, third_party/gbm, third_party/libepoxy: quoted hashes\n  - modules/freetype2, nsprpub, parser/expat, ipc/.../libevent: tags such as\n    VER-2-14-2, NSPR_4_39_RTM, R_2_8_2, release-2.1.13-stable\nTwo are visibly stale as a result: media/libyuv's release is frozen at\n\"master (2022-06-22)\" while its revision was last updated in 2026, and\nmodules/fdlibm's release and revision hashes disagree.\n\nThis corrects such fields on the next vendor; it does not retroactively fix\nvalues that are already stale.\n\n* * *\nBug 2056510. Add a test for mach vendor's update_yaml quoted/unusual value fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313177\n", "files": ["python/mozbuild/mozbuild/test/vendor/test_vendor_manifest.py", "python/mozbuild/mozbuild/vendor/vendor_manifest.py"], "git_node": "94db292aa3b36e2a5f72d3522f73207eab7eda51", "git_parents": ["754fd6f25e8bc3c4fbcdd8fb1ee1a65b92861abd"], "node": "65566e23899a1f5b5f7567daefe2f043300deb5b", "parents": ["18ce1bfc8bdb53b9ae0a681ff679c44f06d004a8"], "tags": []}, {"author": "Fred Chasen \u003cfchasen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031665 - Update weather widget sponsored footer for small and medium sizes r=Dre\n\n- Updates the sponsored footer to be inside of the widget for the small and medium sized widgets by adding a small `SponsoredText` component.\n- Uses just the provider name for the small size.\n- Aligns the weather icon and forecast cards at the top.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312845\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Weather/Weather.jsx", "browser/extensions/newtab/content-src/components/Widgets/Weather/_Weather.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Weather.test.jsx"], "git_node": "606961f9e67afe65bbc021f30875a71e75125497", "git_parents": ["94db292aa3b36e2a5f72d3522f73207eab7eda51"], "node": "7bbd4fa61c69bb119c3b9d1ca067565341d7a5f6", "parents": ["65566e23899a1f5b5f7567daefe2f043300deb5b"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2057034: Fix a latent off-by-one bug. r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313696\n", "files": ["dom/media/webrtc/sdp/SipccSdp.cpp"], "git_node": "cab01c515cba8adef9340881cbdea54937cd53bd", "git_parents": ["606961f9e67afe65bbc021f30875a71e75125497"], "node": "ed1658a0fbfda905ce3341d1aa68317d6c5e7fca", "parents": ["7bbd4fa61c69bb119c3b9d1ca067565341d7a5f6"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042931 - Fix vpn sumo link for vpn onboarding r=android-reviewers,jonalmeida\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313904\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/ui/IPProtectionBottomSheetFragment.kt"], "git_node": "a0aaa2685ddd202bb1dbe718dbcfcdbda29f70c1", "git_parents": ["cab01c515cba8adef9340881cbdea54937cd53bd"], "node": "4d0ce7b684c8a02153c7cd9434d775ff5046e3ce", "parents": ["ed1658a0fbfda905ce3341d1aa68317d6c5e7fca"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-km/strings.xml", "mobile/android/fenix/app/src/main/res/values-ar/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-eu/strings.xml", "mobile/android/fenix/app/src/main/