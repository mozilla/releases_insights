src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/pairs/shards/NavigationPairShard15.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/pairs/shards/NavigationPairShard16.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/pairs/shards/NavigationPairShard17.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/pairs/shards/NavigationPairShard18.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/pairs/shards/NavigationPairShard19.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/pairs/shards/NavigationPairShard20.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/planning/DisplayLabels.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/planning/ShardUtils.kt", "mobile/android/test_infra/flank-configs/fenix/arm64-v8a-detect-leaks.yml", "mobile/android/test_infra/flank-configs/fenix/arm64-v8a.yml"], "git_node": "7c518bd386cfbbda25d14c910f14273237281f87", "git_parents": ["831f643561190fcc12aff6f9082532b91b633717"], "node": "9eac0a0468773cf39d398aaf1303814c1af92acc", "parents": ["215a4688c80426fccde6c0e518dea2a37a96c696"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056459 - Move ui/efficiency's interaction generator files into the new generation/ package structure r=aaronmt\n\nPure move, no logic changes and no class renames (these classes were\nalready Interaction-prefixed, matching the package). Third of four\nper-domain diffs for P2b-4 (behavior to follow). Relocates the entire\nnavigation/interaction/ package into generation/interaction/:\n\n  InteractionCase, InteractionCaseFactory, InteractionShardData,\n  BaseInteractionShardTest, InteractionTestPlanner, SelectorCatalog,\n  InteractionCaseGenerator, shards/InteractionShard01\n\nUpdates arm-experimental-api-tests.yml's Flank package path in the same\ndiff (interaction shards ARE CI-wired, so this is required or CI silently\nstops running them). Repoints two examples/ callers' imports.\n\nScoping notes:\n- InteractionTestPlanner and SelectorCatalog move with the domain (used\n  only by interaction, confirmed via grep - genuinely domain-specific,\n  not shared infra).\n- InteractionCaseGenerator (a dev-tool) moves here too rather than being\n  stranded; it physically lived inside navigation/interaction/. Per the\n  target structure it will eventually live in devtools/ with the other\n  generators, so expect one more move for it later.\n- ShardUtils/NavigationTestPlanner/toDisplayLabel promotion out of\n  navigation.planning remains its own separate diff, same as the prior\n  domain moves.\n\nVerified locally: builds and runs clean with the old files removed.\n\nThis is P2b-4 (MTE-5686), Phase 2b (MTE-5652).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313151\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/examples/InteractionGeneratedCasePrintTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/examples/NavigationCaseGeneratorTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/interaction/BaseInteractionShardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/interaction/InteractionCase.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/interaction/InteractionCaseFactory.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/interaction/InteractionCaseGenerator.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/interaction/InteractionShardData.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/interaction/InteractionTestPlanner.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/interaction/SelectorCatalog.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/interaction/shards/InteractionShard01.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/interaction/BaseInteractionShardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/interaction/InteractionCase.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/interaction/InteractionCaseFactory.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/interaction/InteractionCaseGenerator.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/interaction/InteractionShardData.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/interaction/InteractionTestPlanner.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/interaction/SelectorCatalog.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/interaction/shards/InteractionShard01.kt", "mobile/android/test_infra/flank-configs/fenix/arm-tae-tests.yml", "mobile/android/test_infra/flank-configs/fenix/arm64-v8a-detect-leaks.yml", "mobile/android/test_infra/flank-configs/fenix/arm64-v8a.yml"], "git_node": "f9efb19bdb27f86b9ca5402b60fe772f786d0194", "git_parents": ["7c518bd386cfbbda25d14c910f14273237281f87"], "node": "63c94bcefa8f05c4a9c237b47cb18fe1ca21dd1e", "parents": ["9eac0a0468773cf39d398aaf1303814c1af92acc"], "tags": []}, {"author": "Jackie Johnson \u003cjajohnson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056467 - Move ui/efficiency's behavior generator files into the new generation/ package structure r=aaronmt\n\nPure move, no logic changes and no class renames (these classes were\nalready Behavior-prefixed, matching the package). Fourth and final\nper-domain diff for P2b-4. Relocates the entire navigation/behavior/\npackage (19 files) into generation/behavior/.\n\nNo Flank config change - behavior shards aren't CI-wired (separate,\nalready-tracked gap, P3-3), same as pairs.\n\nScoping notes (consistent with the earlier domain moves):\n- SelectorTemplate moves with the domain (used only by behavior, confirmed\n  via grep - domain-specific despite not being Behavior-prefixed).\n- BehaviorCaseGenerator (a dev-tool) moves here too rather than being\n  stranded, same as InteractionCaseGenerator. Per the target structure it\n  will eventually live in devtools/, so expect one more move for it later.\n- Shared-infra files still imported from navigation.planning (ShardUtils,\n  PageCatalog, NavigationGraphBootstrap, DevToolReport/buildBoilerplateReport/\n  logReport) are NOT promoted here; that's its own separate diff.\n\nRepoints one examples/ caller (BehaviorCaseGeneratorTest). Verified\nlocally: builds and runs clean with the old files removed.\n\nWith this, all four generator domains live under generation/ and\nnavigation/ is down to its 3 core files + planning/.\n\nThis is P2b-4 (MTE-5686), Phase 2b (MTE-5652).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313156\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/examples/BehaviorCaseGeneratorTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BaseBehaviorShardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorBaseTestConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorCapability.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorCase.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorCaseFactory.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorCaseGenerator.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorCasePlan.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorContextManifest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorContextMatrix.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorContextSupportRegistry.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorData.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorRunArguments.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorRuntime.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorRuntimeStateSetup.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorShardData.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorTemplate.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/BehaviorTestPlanner.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/SelectorTemplate.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/generation/behavior/shards/BehaviorShard01.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui