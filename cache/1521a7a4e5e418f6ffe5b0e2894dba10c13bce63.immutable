anch": "default", "desc": "Bug 2049748 - Include the InstallTime annotation in crash pings r=gsvelto\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313035\n", "files": ["toolkit/crashreporter/CrashAnnotations.yaml", "toolkit/crashreporter/crashping/generated_metrics.yaml", "toolkit/crashreporter/crashping/src/lib.rs"], "git_node": "ee4be8e7a33bb579219363ad8c860a18701a5379", "git_parents": ["f031cc01c1e517ac9e6c06bdb05c897f8990bf98"], "node": "16732e03f66f2a81f0a94f51172f35479302121b", "parents": ["4cdf2bc87fd3e5140a820671c270f39222cb090b"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054214 - When opening a starter tab, do not navigate to the home page r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313046\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/usecases/FenixBrowserUseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/controller/TabManagerController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/controller/DefaultTabManagerControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/redux/middleware/TabStorageMiddlewareTest.kt"], "git_node": "b6a2266df98880b4ac990f9d60ded933b4c23190", "git_parents": ["ee4be8e7a33bb579219363ad8c860a18701a5379"], "node": "2186d0a355e46120a3389704124f146131e5aa07", "parents": ["16732e03f66f2a81f0a94f51172f35479302121b"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034297 - Nova visual update for tab group hover preview panel. r=tabbrowser-reviewers,desktop-theme-reviewers,jswinarton,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312562\n", "files": ["browser/components/tabbrowser/content/tab-hover-preview.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_tab_preview.js", "browser/themes/shared/tabbrowser/tab-hover-preview.css"], "git_node": "4dd8baad6a7e32aea1049586e2f36f5b6cbff442", "git_parents": ["b6a2266df98880b4ac990f9d60ded933b4c23190"], "node": "55178633dc5a16faf35526f6f9b8050a65ddd723", "parents": ["2186d0a355e46120a3389704124f146131e5aa07"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 2056414 - Synchronously remove tabs at the end of tests. r=jswinarton,tabbrowser-reviewers,dao\n\nI encountered some failures in other tests in this file after seemingly\nunrelated changes, where they ran into an unexpected number of tabs.\nIt looks like those were leftover tabs from the tests modified in this\npatch.\n\nSupposedly the animations cause the tabs to remain in the DOM until\nthe animations finish, leading to an unexpected tab count in followup\ntests. Apparently, this happened to not be problematic because the\ncheck for prefers-reduced-motion hadn't happened yet, and thus\nanimations were still disabled. But when I added a different patch\nthat then triggered it to be evaluated (I think because it added a\nprefers-reduced-motion check?), the animation started to run.\n\nI'm not super confident about this change, but it appears to resolve the issue that caused the backout of [[ https://bugzilla.mozilla.org/show_bug.cgi?id=2051545#c4 | my seemingly unrelated patch ]], and seems fairly innocent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313209\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js"], "git_node": "03568a4efb05988bed9d99e4706373d455096dcc", "git_parents": ["4dd8baad6a7e32aea1049586e2f36f5b6cbff442"], "node": "f66c394f10abf17c232282901eff55a5377f7e9e", "parents": ["55178633dc5a16faf35526f6f9b8050a65ddd723"], "tags": []}, {"author": "Vincent Tunru \u003cgit@vincenttunru.com\u003e", "branch": "default", "desc": "Bug 205154