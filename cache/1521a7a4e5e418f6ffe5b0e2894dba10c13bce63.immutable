systems/viewBox-invalid-attribute-baseval.tentative.html.ini", "testing/web-platform/meta/svg/coordinate-systems/viewBox-zero-disables-rendering-pattern.svg.ini"], "git_node": "a0e0bd72e004dc7dfa7d15a4e46bce73853a1197", "git_parents": ["cf2790a04be11c387a782d8409dab5c68aa28303"], "node": "900a9f75b8c07d02f0469d873c082849b4c530b0", "parents": ["a2d24a47798ed982438afdcac4ebefd53a27015d"], "tags": []}, {"author": "Anton Bershanskyi \u003cbershanskyi@gmail.com\u003e", "branch": "default", "desc": "Bug 2057378 [wpt PR 61508] - [Extensions] Implement AlarmCreateInfo.name, a=testonly\n\nAutomatic update from web-platform-tests\n[Extensions] Implement AlarmCreateInfo.name\n\nAdd support for specifying alarm name for alarms.create() in the second\nobject argument called AlarmCreateInfo.name.\n\nBackground:\n - https://github.com/w3c/webextensions/issues/999\n - https://github.com/w3c/webextensions/blob/main/_minutes/2026-05-21-wecg.md\n\nBug: None\nChange-Id: I4cac7c8928641fa61be3e2f319e699eac9fee195\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8040045\nReviewed-by: Justin Lulejian \u003cjlulejian@chromium.org\u003e\nReviewed-by: Devlin Cronin \u003crdevlin.cronin@chromium.org\u003e\nCommit-Queue: Anton Bershanskyi \u003cbershanskyi@gmail.com\u003e\nCr-Commit-Position: refs/heads/main@{#1667716}\n\n--\n\nwpt-commits: 9fe2a5b0d4b3827dd0d622eaa27344166f3d8204\nwpt-pr: 61508\n", "files": ["testing/web-platform/tests/web-extensions/resources/alarms/background.js"], "git_node": "2e377f79444ddb64691814f1bc986c5575242c68", "git_parents": ["a0e0bd72e004dc7dfa7d15a4e46bce73853a1197"], "node": "56e678a0c96cc9ebec1d1663fc110c6efbb0607e", "parents": ["900a9f75b8c07d02f0469d873c082849b4c530b0"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2057396 [wpt PR 61509] - Ensure FillPaint, StrokePaint and SourceAlpha sources are tainted, a=testonly\n\nAutomatic update from web-platform-tests\nEnsure FillPaint, StrokePaint and SourceAlpha sources are tainted\n\nThese sources would not get the tainted flag set if the canvas was\ntainted.\n\nFixed: 497854976\nChange-Id: If8217e5acfb0106b2b58a7234011ccfc39d7a83a\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8121147\nReviewed-by: Philip Rogers \u003cpdr@chromium.org\u003e\nCommit-Queue: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCr-Commit-Position: refs/heads/main@{#1667769}\n\n--\n\nwpt-commits: 28ce02f0c6ec4f7e02a96eef7ee8a19df168dc03\nwpt-pr: 61509\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/filters/reference/green-100x100.html", "testing/web-platform/tests/html/canvas/element/manual/filters/svg-displacement-filter-tainted-fillpaint.sub.html", "testing/web-platform/tests/html/canvas/element/manual/filters/svg-displacement-filter-tainted-sourcealpha.sub.html", "testing/web-platform/tests/html/canvas/element/manual/filters/svg-displacement-filter-tainted-strokepaint.sub.html"], "git_node": "570fbfebcd35eddc8ba5c0bd76970608b7bbdc8a", "git_parents": ["2e377f79444ddb64691814f1bc986c5575242c68"], "node": "9328b39842305b3e7fa5556f8b0ab45505f22cdc", "parents": ["56e678a0c96cc9ebec1d1663fc110c6efbb0607e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057619 - [wpt-sync] Update web-platform-tests to 0278039ba762f1cca066169ebe295348bde6ae19, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 0278039ba762f1cca066169ebe295348bde6ae19\nwpt-type: landing\n", "files": ["testing/web-platform/meta/document-picture-in-picture/requires-width-and-height-to-both-be-specified.https.html.ini", "testing/web-platform/meta/fetch/metadata/window-open.https.sub.html.ini", "testing/web-platform/meta/html/rendering/cdata-001.xhtml.ini", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/offsets-into-the-media-resource/currentTime-move-within-document.html.ini", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/module/modulepreload-referrerpolicy.html.ini", "testing/web-platform/meta/html/user-activation/activation-trigger-touch.tentative.html.ini", "testing/web-platform/meta/intersection-observer/transformed-iframe-002-cross-origin.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini", "testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini", "testing/web-platform/meta/mediasession/__dir__.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/navigation-api/navigate-event/navigate-history-back-bfcache.html.ini", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/scheduler/post-task-delay.any.js.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/web-extensions/browser.alarms.extension.js.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/webaudio/the-audio-api/the-audiocontext-interface/audiocontext-playoutstats.html.ini", "testing/web-platform/meta/webmcp/imperative/document-domain-enabled.https.html.ini", "testing/web-platform/meta/webrtc/legacy/simplecall_callbacks.optional.https.html.ini", "testing/web-platform/meta/websockets/basic-auth.any.js.ini"], "git_node": "81e38c398ec0c60b15612b5c43f5d6fa6c0d3f1a", "git_parents": ["570fbfebcd35eddc8ba5c0bd76970608b7bbdc8a"], "node": "c3289daf692661e054edfdb5aa6b0f29dda70388", "parents": ["9328b39842305b3e7fa5556f8b0ab45505f22cdc"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056032 - Only add the marketing card when required instead of adding then removing it. r=android-reviewers,rebecatudor273\n\nNote: The demos below use an artificial **5-second delay** for demonstration purposes. In reality, **the delay is less than 1.2 seconds for 75% of users **and less than 2.8 seconds for 95% of users.\n\nThe edge case flow is what a user would see if Firefox was already set as the default browser prior to onboarding.\n\n| Standard flow | Edge case flow |\n| {F75960578} | {F75960568} |\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314000\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/MarketingPageAdditionSupport.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/MarketingPageRemovalSupport.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/MarketingPageAdditionSupportTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/MarketingPageRemovalSupportTest.kt"], "git_node": "9626599b9b4966f4de6c4e6a0c8cf8ba7048e5e5", "git_parents": ["81e38c398ec0c60b15612b5c43f5d6fa6c0d3f1a"], "node": "591fb3a28e10349664ca2981e82f5a129aae63b1", "parents": ["c3289daf692661e054edfdb5aa6b0f29dda70388"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057452 - Wait for commands to be scheduled before compositing on Metal ANGLE. r=gfx-reviewers,bradwerth\n\nRenderCompositorNative calls glFlush() prior to compositing its\nlayers. This is enough synchronisation on native GL on macOS, but on\nMetal ANGLE we have observed intermittent tile shaped glitches.\n\nIt's hard to reproduce reliably, but as a speculative fix try waiting\nfor the prior commands to be scheduled using the\nANGLE_metal_commands_scheduled_sync extension.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313969\n", "files": ["gfx/gl/GLDefs.h", "gfx/gl/GLLibraryEGL.cpp", "gfx/gl/