.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/tests/browser/browser_whereToOpen.js"], "git_node": "b7e9930420fbc4b1cc8d1afc2e458ce9c8a06a72", "git_parents": ["207427403d8c1103646786ac5bd7bdab5409e363"], "node": "c265e9bbdc2b7733a97fa1394aad3e727eafc927", "parents": ["1a56223e34e7e289dfeec387f661f37b77224694"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2031045: run update integrity tests on one older release per platform r=releng-reviewers,taskgraph-reviewers,jcristau\" for causing py failures @ test_determinism\n\nThis reverts commit d81f6096e62621dcb462322ce7cdd86e2af6e827.\n\nRevert \"Bug 2031045: pre: add build platform -\u003e ftp platform mapping r=releng-reviewers,ahal\"\n\nThis reverts commit 79d0e2695b4f42c64416cb63a90e1fad2c19653d.\n\nRevert \"Bug 2031045: pre: add getNightlyDir helper function r=releng-reviewers,ahal\"\n\nThis reverts commit c5ed8b60ab810feb947c7ea9beec33b3ae0be7cf.\n\nRevert \"Bug 2031045: pre: add bz2 support to marannon r=releng-reviewers,ahal\"\n\nThis reverts commit 9dde8c2458140500c1a0230eba044537e52034f3.\n", "files": ["python/mozrelease/mozrelease/paths.py", "python/mozrelease/mozrelease/platforms.py", "taskcluster/gecko_taskgraph/transforms/update_integrity.py", "taskcluster/kinds/test-update-integrity/kind.yml", "tools/update-verify/marannon/Cargo.lock", "tools/update-verify/marannon/Cargo.toml", "tools/update-verify/marannon/src/main.rs", "tools/update-verify/marannon/src/updater.rs"], "git_node": "1dd5465a538c8416631ee63733e8a4fadaee08cb", "git_parents": ["b7e9930420fbc4b1cc8d1afc2e458ce9c8a06a72"], "node": "9801d42587fd984821e9c7d1e15f285091a6c0d8", "parents": ["c265e9bbdc2b7733a97fa1394aad3e727eafc927"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055837 - use taskcluster-built python for web-platform-tests tasks. r=taskgraph-reviewers,bhearsum\" for causing ba failures.\n\nThis reverts commit 5106e9fe3aae0df7e31d87b27be7a5873a403fed.\n\nRevert \"Bug 2055837 - use taskcluster-built python for reftest tasks. r=taskgraph-reviewers,bhearsum\"\n\nThis reverts commit 7721791d09f0455b9de5504ad1f0d7dda970ea10.\n\nRevert \"Bug 2055837 - use taskcluster-built python for mochitest tasks. r=taskgraph-reviewers,bhearsum\"\n\nThis reverts commit 81f5fbdb3301101b8957fa8521c388883f7362f1.\n", "files": ["taskcluster/kinds/mochitest/kind.yml", "taskcluster/kinds/reftest/kind.yml", "taskcluster/kinds/web-platform-tests/kind.yml"], "git_node": "6987688672e9013f48e6dccae40f458b3b57d397", "git_parents": ["1dd5465a538c8416631ee63733e8a4fadaee08cb"], "node": "423cf24aa4f9f67ac69bca6ecae0ed10c48de893", "parents": ["9801d42587fd984821e9c7d1e15f285091a6c0d8"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046221 - Part 2: Add telemetry to NotificationParent r=nrishel\" for causing mochitest-plain failures at test_ext_notifications.html\n\nThis reverts commit ba85cfd8aba17362fea051a1836687dd313003c9.\n\nRevert \"Bug 2046925 - Refactor NotificationObserver::Observe for clearer behavior for each topic r=asuth\"\n\nThis reverts commit 873ba040d7b51dbf4fd957653821c8df4f7717b1.\n\nRevert \"Bug 2052574 - Track ignored notifications on Windows r=nrishel,win-reviewers\"\n\nThis reverts commit e29a6acf419201493c7e7bf6b618adb4835d1488.\n\nRevert \"Bug 2049782 - Update Alerts Service mocks to use showAlertWithCallbacks r=extension-reviewers,nrishel,robwu\"\n\nThis reverts commit 34420480d27ced14f466d93bf4d1079fabe71fc0.\n\nRevert \"Bug 2049782 - Fall back to ShowAlert in AndroidAlerts r=nrishel\"\n\nThis reverts commit 5bb68c92becfbd5d26647c78164a6e4e8aae7251.\n\nRevert \"Bug 2049782 - Add nsIAlertCallbacks to replace nsIObserver for Alerts Service r=nrishel,win-reviewers\"\n\nThis reverts commit 31ffaa6370f203b2cf59f7eaaef19ba2b583a5d7.\n", "files": ["dom/notification/NotificationParent.cpp", "dom/notification/NotificationParent.h", "dom/notification/NotificationUtils.cpp", "dom/notification/NotificationUtils.h", "dom/notification/metrics.yaml", "dom/notification/test/browser/browser_openwindow_without_window.js", "dom/notification/test/browser/browser_userContextId_openWindow.js", "dom/notification/test/browser/browser_userContextId_tag.js", "dom/notification/test/chrome/test_notification_system_principal.xhtml", "dom/notification/test/mochitest/MockAlertsService.js", "dom/notification/test/mochitest/test_notification_tag.html", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/notifications/resources/SiteCategory.js", "testing/web-platform/mozilla/tests/notifications/telemetry.sub.https.window.js", "toolkit/components/alerts/alert.js", "toolkit/components/alerts/nsAlertsService.cpp", "toolkit/components/alerts/nsIAlertsService.idl", "toolkit/components/alerts/nsXULAlerts.cpp", "toolkit/components/alerts/nsXULAlerts.h", "toolkit/components/alerts/test/chrome/chrome.toml", "toolkit/components/alerts/test/chrome/test_alerts_callbacks.html", "toolkit/system/gnome/nsAlertsIconListener.cpp", "toolkit/system/gnome/nsAlertsIconListener.h", "toolkit/system/gnome/nsSystemAlertsService.cpp", "widget/android/AndroidAlerts.cpp", "widget/cocoa/MacOSNotificationCenter.mm", "widget/windows/ToastNotification.cpp", "widget/windows/ToastNotificationHandler.cpp", "widget/windows/ToastNotificationHandler.h"], "git_node": "48cae055172c04e1684886dd7a965e9b66835847", "git_parents": ["6987688672e9013f48e6dccae40f458b3b57d397"], "node": "e44f299a9a60eb2a3f742a725f6e405c24dc7b0b", "parents": ["423cf24aa4f9f67ac69bca6ecae0ed10c48de893"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056391 - Update show_custom_tab_extensions secret setting to be visible in nightly to match debug builds. r=android-reviewers,petru\n\nWe still keep the default as false while also adding a warning sign to indicate to users that enabling this setting is not recommended.{F75784314}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313145\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "f54629578b1431eb728f744f36658c93530acf8d", "git_parents": ["48cae055172c04e1684886dd7a965e9b66835847"], "node": "b53dffa9ad23c352fe2e92331ab90052dba8a626", "parents": ["e44f299a9a60eb2a3f742a725f6e405c24dc7b0b"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057286 - Newtab make ad allowed ranks configurable via trainhopConfig. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313792\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/lib/SectionsLayoutFeed.sys.mjs", "browser/extensions/newtab/test/unit/lib/DiscoveryStreamFeed.test.js", "browser/extensions/newtab/test/xpcshell/test_SectionsLayoutFeed.js"], "git_node": "aab8e258700c345403ea29225e777dd3f504f41c", "git_parents": ["f54629578b1431eb728f744f36658c93530acf8d"], "node": "91d323474a3bfe4d58d08811f3d3b2f005e3cb29", "parents": ["b53dffa9ad23c352fe2e92331ab90052dba8a626"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055160: Remove locale from smart window first run explainer page r=yjamora\n\nRemove the fixed \"en-us\" from the explainer page URL. It gets the locale automatically and uses \"en-us\" as a fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313574\n", "files": ["browser/app/profile/firefox.js"], "git_node": "7e0124b08b70e49522928730f50f3af474d36c6c", "git_parents": ["aab8e258700c345403ea29225e777dd3f504f41c"], "node": "0feb988ac4fcd17eb45383c8158d3cdc992b93ac", "parents": ["91d323474a3bfe4d58d08811f3d3b2f005e3cb29"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035579 - Wire rusttests through the build system to link in-tree native libraries r=nalexander,firefox-build-system-reviewers\n\nRust tests may depend on native libraries built elsewhere in the tree,\nboth at link time and at run time. Make `RustTests` a `Linkable` so it can\ncarry `USE_LIBS`, and have the emitter and recursivemake backend turn\nthose `USE_LIBS` into build ordering dependencies via a shared\n`_add_rust_build_order_deps`. Cargo still performs the actual linking, so\nthe `USE_LIBS` only guarantee the dependencies are built ahead of the\ntests.\n\nA dependency may produce generated files during the `pre-compile` tier,\nwhich the `rusttests` build did not run. Add `pre-compile` to its `ALL_TIERS`\nso those prerequisites exist before the tests build.\n\nAt test time the binaries find their shared library dependencies via an\nrpath to dist/bin on Linux and macOS, or libraries staged next to them\non Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311624\n", "files": ["config/baseconfig.mk", "config/makefiles/rust.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py"], "git_node": "f84495ab13257c5b21dcaecf89aad81ccad80145", "git_parents": ["7e0124b08b70e49522928730f50f3af474d36c6c"], "node": "fa7c32b1bf8be24912208ab49cbf11d74bf306d9", "parents": ["0feb988ac4fcd17eb45383c8158d3cdc992b93ac"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2048201 - Adjust padding inline end on #nav-bar for smart window r=desktop-theme-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313622\n", "files": ["browser/themes/shared/browser-shared.css", "browser/themes/shared/toolbarbuttons.css"], "git_node": "c0175e885762f1c343d316e190f6b29cd7f89771", "git_parents": ["f84495ab13257c5b21dcaecf89aad81ccad80145"], "node": "30e65b9708e4c557220ab5366da3b2c716d58ce2", "parents": ["fa7c32b1bf8be24912208ab49cbf11d74bf306d9"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2046588 - [Monitor Agent][FE] Create monitor view r=yjamora,tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313505\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/ui/actors/SmartWindowTasksChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartWindowTasksParent.sys.mjs", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_tasks_actors.js"], "git_node": "6406b519955523851255d2d3a3a4d3843c95c39b", "git_parents": ["c0175e885762f1c343d316e190f6b29cd7f89771"], "node": "89d78d92cd662f53310fcc30f2e580f52d6a238d", "parents": ["30e65b9708e4c557220ab5366da3b2c716d58ce2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054502 - Move UrlbarInput::_whereToOpen to UrlbarChildController::whereToOpen, route BrowserUtils.whereToOpenLink through UrlbarChild. r=mbeier\n\nFor a content-process \u003cmoz-urlbar\u003e (e.g. about:newtab), UrlbarInput can't compute\nwhere to open a picked result: _whereToOpen calls BrowserUtils.whereToOpenLink (a\nsystem module a content-web scope can't import) and reads gBrowser directly.\n\nMove the computation into UrlbarChildController.whereToOpen (with the\nisCanonizeKeyboardEvent helper it uses), which is content-safe: event modifiers,\nprefs, and a guarded gBrowser read for the empty-tab reuse (absent in a content\nprocess, so a content input skips reuse). Only the BrowserUtils.whereToOpenLink\ncall routes through the UrlbarChild actor, which is privileged and runs in the\ninput's own process, so the whole computation stays synchronous with the live\nevent passed straight through, preserving whereToOpenLink's sourceEvent handling.\n\nUrlbarInput and SmartbarInput drop their own _whereToOpen and\nbrowser_whereToOpen.js now drives the controller entry point instead of the\nremoved method. Behavior-neutral for the chrome address bar and search bars.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311856\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/tests/browser/browser_whereToOpen.js"], "git_node": "3c22ab209fd98c9ce00135069027e7554dcf28dc", "git_parents": ["6406b519955523851255d2d3a3a4d3843c95c39b"], "node": "f2227e493ff25fce273a4d14de99ada252ae14bc", "parents": ["89d78d92cd662f53310fcc30f2e580f52d6a238d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054502 - Rename UrlbarChildController's #parent field to #parentController. r=daleharvey\n\nBehavior-neutral rename of the private field to mirror the public\n`parentController` getter and avoid confusion with the `UrlbarParent`\nactor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311964\n", "files": ["browser/components/urlbar/content/UrlbarChildController.mjs"], "git_node": "f68de28d43c80dbe6bc220445373df03b8e6e480", "git_parents": ["3c22ab209fd98c9ce00135069027e7554dcf28dc"], "node": "cb86d9b2ec73e259ef9f4f2265001cc2ef06c03a", "parents": ["f2227e493ff25fce273a4d14de99ada252ae14bc"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053751 - Move parent-only search recording out of urlbar content to the parent controller. r=Standard8\n\nBrowserSearchTelemetry and ASRouter are parent-process modules, recordSearch\nneeds the live \u003cbrowser\u003e and resolved engine, and the search-count prefs can\nonly be written in the parent -- so urlbar content code can't do any of this\ndirectly once it runs in a content process. Route it all to\nUrlbarParentController through the controller pair (directly in-process, or as\nactor messages on the message path), the same way engagement telemetry already\nreaches the parent recorder.\n\nThe content side ships the engine by name and, only for the new-tab case, a\nbrowserId; the parent resolves both (defaulting to its selected browser), bumps\nthe browser.search.totalSearches / widget.lastUsed prefs, fires the ASRouter\nonSearch trigger, and records the search telemetry.\n\nBehavior-neutral on the direct path. Exercised on both transports with the\nurlbar telemetry/search-mode and ASRouter onSearch tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312150\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "54f26e30240c08e4b528ba6f8a091a136adc06dd", "git_parents": ["f68de28d43c80dbe6bc220445373df03b8e6e480"], "node": "ba4b4bf178b57ff076128281461489942cbdd71f", "parents": ["cb86d9b2ec73e259ef9f4f2265001cc2ef06c03a"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1624579 - Focus the deferred-Enter load's browser in the parent controller. r=mak\n\nOn Enter keyup after a deferred load, the urlbar inputs focused the loaded\n\u003cbrowser\u003e directly and compared it against gBrowser.selectedBrowser --\nchrome-window reaches a content-process urlbar can't make.\n\nRoute it over the controller seam like the load itself: loadURL now returns\nthe id of the browser it loaded into, the child hands that id to the key up\nhandler through the _keyDownEnterDeferred promise, and a new\nUrlbarChildController.focusBrowser forwards to the parent, which focuses the\nbrowser only if it is still selected and reports back so the child can keep\nthe domain name visible. The direct path runs synchronously; the message\npath round-trips, mirroring LoadURL.\n\nBehavior-neutral for the chrome address bar. Verified with browser_enter.js\nand browser_autocomplete_enter_race.js under the message-passing pref both\noff and on.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312318\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs"], "git_node": "1f2094a2f0bdfcd73fa786d7952e0c34edfea96b", "git_parents": ["54f26e30240c08e4b528ba6f8a091a136adc06dd"], "node": "4b251864422727f688b60d95834a5531604299f6", "parents": ["ba4b4bf178b57ff076128281461489942cbdd71f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057340 - Alias `win64-7zz` as `win64-aarch64-7zz` so `aarch64` Windows can bootstrap it r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313902\n", "files": ["taskcluster/kinds/toolchain/7zz.yml"], "git_node": "5dae33881621310b8f38d18640abee64fb8cb42a", "git_parents": ["1f2094a2f0bdfcd73fa786d7952e0c34edfea96b"], "node": "10161bc745ab520a48975f9f2b2bf6c3e2df6359", "parents": ["4b251864422727f688b60d95834a5531604299f6"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047289: Ensure that intermediate-transform.html doesn't depend inline sizes contributed by whitespaces. r=layout-scroll-driven-animation-reviewers,boris\n\nCorresponding test change proposal:\nhttps://github.com/web-platform-tests/interop/issues/1311\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313802\n", "files": ["testing/web-platform/meta/scroll-animations/view-timelines/intermediate-transform.html.ini", "testing/web-platform/tests/scroll-animations/view-timelines/intermediate-transform.html"], "git_node": "9a3fa0f960c33314d894622ec8f33d26180fbba4", "git_parents": ["5dae33881621310b8f38d18640abee64fb8cb42a"], "node": "c0355e974a030ac458061b5507a620f85951020f", "parents": ["10161bc745ab520a48975f9f2b2bf6c3e2df6359"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2057335 - Update dependencies in android-ui-tests Dockerfile r=isabel_rios\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314006\n", "files": ["taskcluster/docker/android-ui-tests/Dockerfile"], "git_node": "f524ac2f5ceb7b9dfc1443bd40e9e9b5c46da89d", "git_parents": ["9a3fa0f960c33314d894622ec8f33d26180fbba4"], "node": "12bb0822c0203cc250d3cc9e21c14d680c1fc0ae", "parents": ["c0355e974a030ac458061b5507a620f85951020f"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055090 - Implement themes picker component in about:welcome r=omc-reviewers,fluent-reviewers,desktop-theme-reviewers,hjones,emcminn,flod\n\nAdds a theme-picker content tile type to about:welcome that implements the shared theme-picker component, and adds a screen to about:welcome's default screens that uses that content tile type.\n\nKnown issues (unrelated to this implementation): [The linux default theme checkbox is always present](https://bugzilla.mozilla.org/show_bug.cgi?id=2055941), and [themes reflected when \"device\" is selected do not represent the actual device theme](https://bugzilla.mozilla.org/show_bug.cgi?id=2056349)\n\nhttps://www.figma.com/design/MPYRmdy1F5sLL0cyhkmAAs/NPO-Experiments-2026?node-id=2343-14447&t=Q4jEbgAjyUf9Esjn-0\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313125\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aboutwelcome/content/aboutwelcome.html", "browser/components/aboutwelcome/modules/AboutWelcomeDefaults.sys.mjs", "browser/components/aboutwelcome/tests/browser/browser.toml", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_theme_picker.js", "browser/components/asrouter/content-src/components/ContentTiles.jsx", "browser/components/asrouter/content-src/components/EmbeddedThemePicker.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/tests/unit/content-src/components/ContentTiles.test.jsx", "browser/locales/en-US/browser/newtab/onboarding.ftl", "toolkit/content/widgets/theme-picker/theme-picker.mjs"], "git_node": "ad71eddb7d36ff40afd186ca7f3212331d4c0069", "git_parents": ["f524ac2f5ceb7b9dfc1443bd40e9e9b5c46da89d"], "node": "35bbe0634d1f22c96c0a657710011df2a8a81eea", "parents": ["12bb0822c0203cc250d3cc9e21c14d680c1fc0ae"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056301 - Add New Tab customize panel browser theme strings r=fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313090\n", "files": ["browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "f1003ece1c2974fe05c3dad44863e05aca876623", "git_parents": ["ad71eddb7d36ff40afd186ca7f3212331d4c0069"], "node": "714f7a5b98e3184cdd538d76d4339497eff1367a", "parents": ["35bbe0634d1f22c96c0a657710011df2a8a81eea"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056300 - Integrate the compact theme-picker into the New Tab customize panel r=Dre\n\nEmbed the reusable toolkit `theme-picker` element (compact layout) in the New Tab customize panel so users can switch their Firefox theme directly from Firefox Home.\n\n- Render `\u003ctheme-picker layout=\"compact\" installsource=\"about:newtab\"\u003e` in ContentSection, gated on the browser-wide `browser.nova.enabled` pref. PrefsFeed reads and observes that pref and broadcasts it to content as `browserNovaEnabled`; CustomizeMenu threads it through to ContentSection.\n- Register the ThemePicker JSWindowActor for `about:newtab` and `about:home` so the element's remote controller can reach AddonManager/ThemesList via the parent in the content sandbox (about:home covers the startup-cache first tab).\n- Load the theme-picker / moz-visual-picker / moz-segmented-control element modules in the live-rendered page (render-activity-stream-html.js) and the about:home startup-cache template (page.html.template) so the custom element is defined on both normal and cached pages.\n- Add tests for the gate (ContentSection) and the pref observer/broadcast (PrefsFeed).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313091\n", "files": ["browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/_CustomizeMenu.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/CustomizeMenu.test.jsx", "browser/extensions/newtab/test/unit/lib/PrefsFeed.test.js"], "git_node": "c679cecab1ce6f52bcdd3dd776030e0e2e964212", "git_parents": ["f1003ece1c2974fe05c3dad44863e05aca876623"], "node": "124bd6c2a9f435618a917f664bdb62b70b8c826a", "parents": ["714f7a5b98e3184cdd538d76d4339497eff1367a"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056304 - Add the full browser theme selection panel to the New Tab customize panel r=Dre\n\nWire the existing \"See more themes\" button in the customize panel's Appearance section to a new full theme selection sub-panel.\n\n- New ThemesManagementPanel (mirrors WidgetsManagementPanel): the box-button opens a sliding sub-panel with a back button (\"Firefox Themes\" title), the full-layout theme-picker (Light/Dark/Device chooser + all themes), and a moz-box-link out to the about:addons themes list.\n- Panel visibility state (showThemesPanel / toggleThemesPanel) lives in Base and is threaded through CustomizeMenu to ContentSection.\n- OPEN_ABOUT_ADDONS_THEMES action + AboutPreferences handler open addons://list/theme via BrowserAddonUI.openAddonsMgr.\n- Load the moz-box-link element module in the prerendered and startup-cache HTML; reuse the mgmt-panel slide styles for .themes-mgmt-panel.\n- Tests for the panel and appearance section; Karma coverage override for the Jest-tested panel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313092\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ThemesManagementPanel/ThemesManagementPanel.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/_CustomizeMenu.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/CustomizeMenu/ThemesManagementPanel.test.jsx"], "git_node": "5505a6ac604d027ba4f19939d1e3e0f162be5448", "git_parents": ["c679cecab1ce6f52bcdd3dd776030e0e2e964212"], "node": "5088d5016a6e89894fa8e1bf9a1dd6d4c27051b6", "parents": ["124bd6c2a9f435618a917f664bdb62b70b8c826a"], "tags": []}, {"author": "andyh \u003candhuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057307 - Set cookie banner promo false. r=omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314042\n", "files": ["browser/app/profile/firefox.js"], "git_node": "0403672cb48ca87311f3260cfb2d7ba589338d87", "git_parents": ["5505a6ac604d027ba4f19939d1e3e0f162be5448"], "node": "b6daf1c6a23d558ee325515740bdcb179749457b", "parents": ["5088d5016a6e89894fa8e1bf9a1dd6d4c27051b6"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045703 - Test overlapping Settings search does not show the whole pane r=mstriemer\n\nUnder the settings redesign, searching a typo hid the matching group. Deleting\nback toward the real query could leave the intermediate search unfinished. That\nleft this.query a substring of the final query with searchCompleted false. The\nfinal search then took the subQuery fast path, which skips already-hidden groups.\nNo group matched, so the pane-level fallback showed the whole setting-pane.\n\nBug 2045266 fixed this with the searchCompleted gate. Add a test that reproduces\nthe reported keystroke interaction on the sync pane. It checks that the visible\nsetting-groups match a fresh, non-overlapping search.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313117\n", "files": ["browser/components/preferences/tests/searchResults/browser_search_overlapping_ranges.js"], "git_node": "6d1261908c0bd14974d61da85eed54ff72966aec", "git_parents": ["0403672cb48ca87311f3260cfb2d7ba589338d87"], "node": "b5f5283d604dcadf3bb894e9f333e5f5a6e0b73c", "parents": ["b6daf1c6a23d558ee325515740bdcb179749457b"], "tags": []}, {"author": "Jared Hirsch \u003cohai@6a68.net\u003e", "branch": "default", "desc": "Bug 2057074 - Update toolkit/profile metrics expiring in 156 r=niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313901\n", "files": ["toolkit/profile/metrics.yaml"], "git_node": "27b19b24e5d2843aaad6223be4a4f84e26cba1ba", "git_parents": ["6d1261908c0bd14974d61da85eed54ff72966aec"], "node": "c351d5a8665d2b0dc66b4735acb0779d7a2291aa", "parents": ["b5f5283d604dcadf3bb894e9f333e5f5a6e0b73c"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046577: Don't let style changes clobber DOM timeline-range-* changes. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312833\n", "files": ["dom/animation/Animation.cpp", "dom/animation/Animation.h", "dom/animation/AnimationUtils.cpp", "dom/animation/CSSAnimation.cpp", "dom/animation/CSSAnimation.h", "layout/style/nsAnimationManager.cpp", "testing/web-platform/meta/scroll-animations/css/animation-range-ignored.html.ini"], "git_node": "5faaee03ed0b64f568d0b3cac2112e0c8cea5661", "git_parents": ["27b19b24e5d2843aaad6223be4a4f84e26cba1ba"], "node": "6da5079172a55cdb999d455c8252bba162257610", "parents": ["c351d5a8665d2b0dc66b4735acb0779d7a2291aa"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031045: pre: add bz2 support to marannon r=releng-reviewers,ahal\n\nThis is needed to test post-watershed versions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297798\n", "files": ["tools/update-verify/marannon/Cargo.lock", "tools/update-verify/marannon/Cargo.toml", "tools/update-verify/marannon/src/main.rs", "tools/update-verify/marannon/src/updater.rs"], "git_node": "84f0261a982765bedeedc7591688d3349eb8271c", "git_parents": ["5faaee03ed0b64f568d0b3cac2112e0c8cea5661"], "node": "49d6cb4982aa990fd390aed657df98d64c0cf544", "parents": ["6da5079172a55cdb999d455c8252bba162257610"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031045: pre: add getNightlyDir helper function r=releng-reviewers,ahal\n\nThis is needed to support the goal of running update integrity tests on an older release, and makes a good companion to the release versions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297799\n", "files": ["python/mozrelease/mozrelease/paths.py"], "git_node": "0bb69c3ab3b2727923be0b15dd3c275b5fbd5297", "git_parents": ["84f0261a982765bedeedc7591688d3349eb8271c"], "node": "067e118362b5ae216672ecfe00465216e49dbc64", "parents": ["49d6cb4982aa990fd390aed657df98d64c0cf544"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031045: pre: add build platform -\u003e ftp platform mapping r=releng-reviewers,ahal\n\nThese build platforms are *so* close to being the same as ftp ones, but alas, they are just different enough to need this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297800\n", "files": ["python/mozrelease/mozrelease/platforms.py"], "git_node": "c31050410cde35daacfc072a78bc641039989ca1", "git_parents": ["0bb69c3ab3b2727923be0b15dd3c275b5fbd5297"], "node": "5e9ff877fb801406af44c17b3d716fe5ebb7decb", "parents": ["067e118362b5ae216672ecfe00465216e49dbc64"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031045: run update integrity tests on one older release per platform r=releng-reviewers,taskgraph-reviewers,jcristau\n\nThis adds an additional `--from` test for each update integrity task. For releases, this is the first post-watershed release for each platform. For nightly this is something a little bit after that, for reasons explained in the comments. Try is slightly different as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D297801\n", "files": ["taskcluster/gecko_taskgraph/transforms/update_integrity.py", "taskcluster/kinds/test-update-integrity/kind.yml", "taskcluster/test/conftest.py"], "git_node": "94cca702062a5a6222940ec8f3638855aaecfc05", "git_parents": ["c31050410cde35daacfc072a78bc641039989ca1"], "node": "04920a0bff43e306f3a697c57333f730950686b1", "parents": ["5e9ff877fb801406af44c17b3d716fe5ebb7decb"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052293 \u2014 disable TAB_GROUP_ONBOARDING_CALLOUT messaging r=sthompson,omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313828\n", "files": ["browser/app/profile/firefox.js", "browser/components/asrouter/modules/FeatureCalloutMessages.sys.mjs"], "git_node": "2ccabd93e19eb758e8d7cd87dab7d8069fb46931", "git_parents": ["94cca702062a5a6222940ec8f3638855aaecfc05"], "node": "e3908f640775f4cdce70d66ed694f4f72c5b3480", "parents": ["04920a0bff43e306f3a697c57333f730950686b1"], "tags": []}, {"author": "Zoya \u003czfatima@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049844 - Added wayback machine archived version button to error pages with clean URL r=android-reviewers,android-l10n-reviewers,flod,matt-tighe\n\nFixed revisions\nAdded UI tests. Since JS fetch can't hit a local mock, the UI test can only be used to assert the button renders.\n Initially attempted moving it to native to get deterministic androidTest UI tests. native has no handle to the live\n error-page DOM, so \"not found\" needed a navigation to update the page \u2014 but the error page's \"resource://\" URL is a\n blocked scheme in loadUrl, so the reload was silently dropped (spinner hung forever)\nTelemetry added for 1. viewing archived version or 2. searching the web\n\nrebased\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308394\n", "files": ["mobile/android/android-components/components/browser/errorpages/README.md", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorPages.kt", "mobile/android/android-components/components/browser/errorpages/src/main/res/values/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/test/java/mozilla/components/browser/errorpages/ErrorPagesTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/AppRequestInterceptor.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/WaybackMachineErrorPageTest.kt", "mobile/android/fenix/app/src/main/assets/lowMediumErrorPages.js", "mobile/android/fenix/app/src/main/assets/low_and_medium_risk_error_pages.html", "mobile/android/fenix/app/src/main/assets/low_and_medium_risk_error_style.css", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/AppRequestInterceptor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/AppRequestInterceptorTest.kt"], "git_node": "838a21b30e1bc33a350b45bad8dfaab369042288", "git_parents": ["2ccabd93e19eb758e8d7cd87dab7d8069fb46931"], "node": "cfab69395985e2d98002a6e43b0d8bb552e245a9", "parents": ["e3908f640775f4cdce70d66ed694f4f72c5b3480"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053174 - Compare source and destination surface sizes in ConvertToRGBA. r=media-playback-reviewers,chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313543\n", "files": ["dom/media/ImageConversion.cpp"], "git_node": "c3a4b8000f68f22775ee9862c3af795cfeddf448", "git_parents": ["838a21b30e1bc33a350b45bad8dfaab369042288"], "node": "5bc13d50b83bd8ccfe603f8b20b0bc0cffacae02", "parents": ["cfab69395985e2d98002a6e43b0d8bb552e245a9"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 5fa893749f5746d7ff1ee7ed3a814d048b731706\naf -\u003e 5fa893749f5746d7ff1ee7ed3a814d048b731706\nan -\u003e 5fa893749f5746d7ff1ee7ed3a814d048b731706\nar -\u003e 5fa893749f5746d7ff1ee7ed3a814d048b731706\nast -\u003e 5fa893749f5746d7ff1ee7ed3a814d048b731706\naz -\u003e 5fa893749f5746d7ff1ee7ed3a814d048b731706\nbe -\u003e 5fa893749f5746d7ff1ee7ed3a814d048b731706\nbg -\u003e 5fa893749f5746d7f