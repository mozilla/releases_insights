4.cpp", "js/src/jit/loong64/Lowering-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "48d11e39aa70e6fea935510f424f3a3ae7f2b878", "git_parents": ["3becab1c56c90c104d4f0a2ed846bf0f8f9f282a"], "node": "b68c19428634d8157c1559177145842f16631158", "parents": ["d09f01b4ae626126dc30dcd486f02368d15881ee"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056055 - [riscv64] Part 2.1: Honor canBeNaN from range analysis in visitMinMax{F,D}. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312882\n", "files": ["js/src/jit/riscv64/CodeGenerator-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h"], "git_node": "748b1687adbde4c533257aecc15d9820d212a522", "git_parents": ["48d11e39aa70e6fea935510f424f3a3ae7f2b878"], "node": "87a3fc791aa1ec1268ac8171771ad3ba449b44d7", "parents": ["b68c19428634d8157c1559177145842f16631158"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056055 - [riscv64] Part 2.2: Honor -0 and -inf possibility information in visitPowHalfD. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312883\n", "files": ["js/src/jit/riscv64/CodeGenerator-riscv64.cpp"], "git_node": "7d3c7ee39a5cbf333a8309ae079f3679f892e94d", "git_parents": ["748b1687adbde4c533257aecc15d9820d212a522"], "node": "c8e95ed1a580340ff0902806737c195519ad379f", "parents": ["87a3fc791aa1ec1268ac8171771ad3ba449b44d7"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056002 - [loong64] Part 1: Extract disassembly out of {,Macro}Assembler-loong64. r=jandem\n\nCurrently, disassembly and codegen spew code is mixed with assembler\nemission code. Extract them into disasm/Disasm-loong64.{cpp,h} for later\nreuse.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312856\n", "files": ["js/moz.configure", "js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/disasm/Disasm-loong64.cpp", "js/src/jit/loong64/disasm/Disasm-loong64.h", "js/src/jit/moz.build"], "git_node": "962b4b65dd255a000617cce8046dcc6e38666bc4", "git_parents": ["7d3c7ee39a5cbf333a8309ae079f3679f892e94d"], "node": "22a90c7402179d065b112c0581c8bd7e1e9dc8d9", "parents": ["c8e95ed1a580340ff0902806737c195519ad379f"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056002 - [loong64] Part 2: Normalize disassembly text per manual. r=jandem\n\nThe existing disassembly deviates from the canonical LoongArch assembly\nin mnemonics, operand orders, and immediate display. Normalize them\naccording to the manual for a more friendly and familiar view.\n\nLink: https://github.com/loongson/la-asm-manual (\"Assembly Language\n Programming Guide for the LoongArch(tm) Architecture\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312857\n", "files": ["js/src/jit/loong64/Architecture-loong64.h", "js/src/jit/loong64/disasm/Disasm-loong64.cpp"], "git_node": "a31edc1a70f06a1fe6a2578e427b70f7c42b5e1e", "git_parents": ["962b4b65dd255a000617cce8046dcc6e38666bc4"], "node": "a391b9ca889bf587a6b601904e0f8ff8edf63358", "parents": ["22a90c7402179d065b112c0581c8bd7e1e9dc8d9"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056002 - [loong64] Part 3: Pass LabelDoc to branch methods. r=jandem\n\nPass LabelDoc to branch methods in preparation for enabling\nDisassemblerSpew for loong64.\n\nLink: https://phabricator.services.mozilla.com/D308451\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312858\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/