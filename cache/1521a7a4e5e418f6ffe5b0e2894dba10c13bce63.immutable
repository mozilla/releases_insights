 "testing/webcompat/interventions/tests/test_2059742_13coins_toast_site.py"], "git_node": "8919d75063405a186eb3ad360705aa53759e0922", "git_parents": ["a6567e1ac2622101b3db305d1c83189b16d633c6"], "node": "578b630926b7f3dbd2731b461c6b69742231f585", "parents": ["f634a0cfc0b10f6392ccf5e774f1194997298cb0"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057149 - add a JS webcompat intervention for patreon.com; r=skyschub,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316687\n", "files": ["browser/extensions/webcompat/data/interventions/2057149-patreon.com.json", "browser/extensions/webcompat/injections/js/speed_up_wheel_events.js", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_2057149_patreon_com.py"], "git_node": "94f998543c3dab64ad4c4370361e38d97ea1e6eb", "git_parents": ["8919d75063405a186eb3ad360705aa53759e0922"], "node": "5ebc3adf585a631d96003a92d679a5bf71627ff5", "parents": ["578b630926b7f3dbd2731b461c6b69742231f585"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058162 - add a desktop-only CSS webcompat intervention for the-image-editor.com; r=skyschub,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316688\n", "files": ["browser/extensions/webcompat/data/interventions/2058162-the-image-editor.com.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_2058162_the-image-editor_com.py"], "git_node": "b1be8e55fb401e878b653ed47cfb4fbfc9863014", "git_parents": ["94f998543c3dab64ad4c4370361e38d97ea1e6eb"], "node": "49269f4d4b18f3622313a7b9a0fd61c30866b465", "parents": ["5ebc3adf585a631d96003a92d679a5bf71627ff5"], "tags": []}], "date": 1786076616, "git_changesets": ["a9e2daf46efcf854eb1a6ce254cb9b6282463067", "9622365e