 "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-it/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-iw/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ja/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ka/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-kab/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-kk/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-km/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ko/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-lo/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ml/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-nb-rNO/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-nl/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-nn-rNO/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-om/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-pa-rIN/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ps/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-pt-rBR/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-pt-rPT/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-rm/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ro/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ru/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-sat/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-sc/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-sk/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-sl/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-sq/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-sr/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-sv-rSE/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-tg/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-th/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-tr/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-trs/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-ug/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-uk/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-vi/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-zh-rCN/strings.xml", "mobile/android/android-components/components/service/firefox-relay/src/main/res/values-zh-rTW/strings.xml"], "git_node": "68ac12e2f807832350e7550716a8d77fbb2fe7f5", "git_parents": ["bdc1e7772e99f9be35c6629e4c3a537dea18545b"], "node": "6fd74007dff337fae59bf4e8bc026e3e37a1e322", "parents": ["586ee2c8908e79fbfa3d9ecd2af0d6ba0abec79b"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2060130 - Only build the BBox space path when we need to r=emilio\n\nWhen both fill and stroke bounds are requested, the transformed copy of\nthe path is only consulted on the rare empty-stroke fallback, but it was\nbuilt unconditionally on every call, costing a full copy of the path\ndata. Only build when a consumer actually needs it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316028\n", "files": ["layout/svg/SVGGeometryFrame.cpp"], "git_node": "fe290610c201b9bbf11af7d5b661a0bba11d7f5e", "git_parents": ["68ac12e2f807832350e7550716a8d77fbb2fe7f5"], "node": "1302f049f2695ad5a53a98e28d0af386892c53b0", "parents": ["6fd74007dff337fae59bf4e8bc026e3e37a1e322"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2051002 - Add nsILoadGroup::visitRequests and use it for the bfcache request check. r=smaug\n\nrequests copies the whole group, which CanSavePresentation doesn't need. It\ncan't be made lazy itself because StopPendingJavascriptURLNavigations cancels\nrequests while iterating it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315852\n", "files": ["dom/base/Document.cpp", "netwerk/base/nsILoadGroup.idl", "netwerk/base/nsLoadGroup.cpp"], "git_node": "9a41420b537dc21162995b66fc61e6f440cc24e4", "git_parents": ["fe290610c201b9bbf11af7d5b661a0bba11d7f5e"], "node": "ff7dc8dc6191edb3325d6549bb5a8e8501d17d29", "parents": ["1302f049f2695ad5a53a98e28d0af386892c53b0"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053220 - Remove testing XPI base url pref from ThemesList.sys.mjs. r=dao,willdurand,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311577\n", "files": ["browser/themes/ThemesList.sys.mjs", "browser/themes/test/unit/test_ThemesList.js"], "git_node": "86f7741b176e9d9a7da26f1afd3f485fe8db3e2d", "git_parents": ["9a41420b537dc21162995b66fc61e6f440cc24e4"], "node": "d6eae4d1cb87e9fa141428a89c51d8c1da828bf5", "parents": ["ff7dc8dc6191edb3325d6549bb5a8e8501d17d29"], "tags": []}, {"author": "Mason Freed \u003cmasonf@chromium.org\u003e", "branch": "default", "desc": "Bug 2060258 [wpt PR 61689] - Fix race condition in parse-a-sizes-attribute WPT test helper, a=testonly\n\nAutomatic update from web-platform-tests\nFix race condition in parse-a-sizes-attribute WPT test helper\n\nRefactor parse-a-sizes-attribute.js to check document.readyState before\nregistering a load listener.\n\nPreviously, the script assigned 'onload = function() { ... done(); }'\non window. If the iframe completed loading before the script parsed and\nassigned onload, the load event was missed. Because the test harness\nuses setup({explicit_done: true}), missing the load event left done()\nuncalled, causing intermittent test timeouts.\n\nThe sizes-auto.html test was including parse-a-sizes-attribute.js,\nbut not using it. That was also removed.\n\nFixed: 540555511\nChange-Id: I1a2a0b2ec797a05619384caf284a02f22f6590ff\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8175234\nAuto-Submit: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1672702}\n\n--\n\nwpt-commits: 52ae6c243bb762e3b87426da362411ef1ced0208\nwpt-pr: 61689\n", "files": ["testing/web-platform/tests/html/semantics/embedded-content/the-img-element/sizes/sizes-auto.html", "testing/web-platform/tests/html/semantics/embedded-content/the-img-element/sizes/support/parse-a-sizes-attribute.js"], "git_node": "4ef88893d4f5ab7028575f00ebc7881ebf61ed76", "git_parents": ["86f7741b176e9d9a7da26f1afd3f485fe8db3e2d"], "node": "a3d2744f9f0d91269b7655a76f3e0e1f456c3214", "parents": ["d6eae4d1cb87e9fa141428a89c51d8c1da828bf5"], "tags": []}, {"author": "wpt-pr-bot \u003cwpt-pr-bot@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2059651 [wpt PR 61651] - Update CODEOWNERS, a=testonly\n\nAutomatic update from web-platform-tests\nAutomated update of CODEOWNERS\n\n--\n\nwpt-commits: 844f550c6bc1b604bc5aed82bfcd9048ea5cc339\nwpt-pr: 61651\n", "files": ["testing/web-platform/tests/CODEOWNERS"], "git_node": "36f872e72ea625d93ae684b6c486badc7a7ff491", "git_parents": ["4ef88893d4f5ab7028575f00ebc7881ebf61ed76"], "node": "95a34c9fda8c681f6ffe940f0bd98117ae03ce1e", "parents": ["a3d2744f9f0d91269b7655a76f3e0e1f456c3214"], "tags": []}, {"author": "Roberto Rodriguez \u003croberto_rodriguez2@apple.com\u003e", "branch": "default", "desc": "Bug 2059674 [wpt PR 61652] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=317890, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=317890\n\n--\n\nwpt-commits: d1a19d13b9c8d2aa4d3c66f4b890671ea3f0c112\nwpt-pr: 61652\n", "files": ["testing/web-platform/tests/content-security-policy/script-src/script-src-strict_dynamic_modulepreload_parser_inserted_module.html", "testing/web-platform/tests/content-security-policy/script-src/script-src-strict_dynamic_modulepreload_parser_inserted_module.html.headers"], "git_node": "85a7ffb2a24eadfe53d3ecc68fb1e8f8d4593e2a", "git_parents": ["36f872e72ea625d93ae684b6c486badc7a7ff491"], "node": "83c12dd4bf786ad5dab01c67a376d6ca197e2432", "parents": ["95a34c9fda8c681f6ffe940f0bd98117ae03ce1e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059674 [wpt PR 61652] - Update wpt metadata, a=testonly\n\nwpt-pr: 61652\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/content-security-policy/script-src/script-src-strict_dynamic_modulepreload_parser_inserted_module.html.ini"], "git_node": "18367648e5092900be4f6e33c72f7c98f259dcf0", "git_parents": ["85a7ffb2a24eadfe53d3ecc68fb1e8f8d4593e2a"], "node": "a418e35fa575bf5b2fd2f4ec5d6820720418dfc2", "parents": ["83c12dd4bf786ad5dab01c67a376d6ca197e2432"], "tags": []}, {"author": "Roberto Rodriguez \u003croberto_rodriguez2@apple.com\u003e", "branch": "default", "desc": "Bug 2059677 [wpt PR 61653] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=319508, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=319508\n\n--\n\nwpt-commits: 82150ed7f0a219c6af5bf5d584567116bdcebfa8\nwpt-pr: 61653\n", "files": ["testing/web-platform/tests/content-security-policy/script-src/script-src-strict_dynamic_parser_inserted_module_empty_hash.html", "testing/web-platform/tests/content-security-policy/script-src/script-src-strict_dynamic_parser_inserted_module_empty_hash.html.headers"], "git_node": "bb331b30578f904852323b700c82710c80ec20bf", "git_parents": ["18367648e5092900be4f6e33c72f7c98f259dcf0"], "node": "4ef0dc542c6d85dd0674f1e40ba17a0695fcd62d", "parents": ["a418e35fa575bf5b2fd2f4ec5d6820720418dfc2"], "tags": []}, {"author": "Jose Dapena Paz \u003cjdapena@igalia.com\u003e", "branch": "default", "desc": "Bug 2060348 [wpt PR 61693] - Container Timing: rename containertiming-ignore to containertimingignore, a=testonly\n\nAutomatic update from web-platform-tests\nContainer Timing: rename containertiming-ignore to containertimingignore\n\nThe standard discussion [1] concluded that a dashed HTML content\nattribute is inappropriate for the ignore marker. It should be spelled\n`containertimingignore` (no dash), consistent with how HTML content\nattributes are conventionally named. The JS accessor remains\n`containerTimingIgnore`.\n\n[1] https://github.com/WICG/container-timing/issues/65\n\n`containertimingignore` becomes the canonical spelling.\n\nBoth are spelling are:\n- Functional. Though the dashed `containertiming-ignore` spelling is\ndeprecated (showing a console warning when found).\n- Firing the existing use counter.\n- Read through the HasContainerTimingIgnoreAttribute() helper, that\nshould go away with the dashed spelling once the origin trial ends.\n\nBug: 539984792\nChange-Id: I2af8a3a007c5387a1dce58d23e60cd6fca2564ac\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8166600\nReviewed-by: Scott Haseley \u003cshaseley@chromium.org\u003e\nCommit-Queue: Jos\u00e9 Dapena Paz \u003cjdapena@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1672798}\n\n--\n\nwpt-commits: afc63310c3991e10dd182555b91c34be7ddaf4b1\nwpt-pr: 61693\n", "files": ["testing/web-platform/tests/container-timing/tentative/containertiming-and-ignore-on-img-itself.html", "testing/web-platform/tests/container-timing/tentative/containertiming-and-ignore-on-text-itself.html", "testing/web-platform/tests/container-timing/tentative/containertiming-with-child-ignore-and-child-img.html", "testing/web-platform/tests/container-timing/tentative/containertiming-with-ignore-and-child-img.html", "testing/web-platform/tests/container-timing/tentative/ignore-with-containertiming-and-child-img.html", "testing/web-platform/tests/container-timing/tentative/nested-containertiming-and-ignore-on-img.html", "testing/web-platform/tests/container-timing/tentative/nested-containertiming-and-ignore-on-text.html", "testing/web-platform/tests/container-timing/tentative/nested-containertiming-child-img-with-ignore.html", "testing/web-platform/tests/container-timing/tentative/nested-containertiming-with-ignore.html"], "git_node": "f7ce3f61bbbf0c2d9d0104ced5891e8220fe5ca1", "git_parents": ["bb331b30578f904852323b700c82710c80ec20bf"], "node": "b84d403b367cd4025adc465c8ad72c4ed1d049d0", "parents": ["4ef0dc542c6d85dd0674f1e40ba17a0695fcd62d"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060348 [wpt PR 61693] - Update wpt metadata, a=testonly\n\nwpt-pr: 61693\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/container-timing/tentative/containertiming-and-ignore-on-img-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-and-ignore-on-text-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/ignore-with-containertiming-and-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-and-ignore-on-img.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-and-ignore-on-text.html.ini"], "git_node": "5e9f486c9fad55d431ee1d33b0e3b249bf885e23", "git_parents": ["f7ce3f61bbbf0c2d9d0104ced5891e8220fe5ca1"], "node": "1c4538f0689b8ab7106611e59763ec61647f0e16", "parents": ["b84d403b367cd4025adc465c8ad72c4ed1d049d0"], "tags": []}, {"author": "Sharon Yang \u003cyangsharon@igalia.com\u003e", "branch": "default", "desc": "Bug 2060401 [wpt PR 61699] - Migrate CSS2 float-append-child crashtest to WPT, a=testonly\n\nAutomatic update from web-platform-tests\nMigrate CSS2 float-append-child crashtest to WPT\n\nBug: 40077397\nChange-Id: I9e1a543d352d25dfd8fb44102a00ee9b00b79a57\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8187614\nReviewed-by: Kent Tamura \u003ctkent@chromium.org\u003e\nCommit-Queue: Sharon Yang \u003cyangsharon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1672937}\n\n--\n\nwpt-commits: 14d3819692b8bf1b55444314e696b6e943cf1cdd\nwpt-pr: 61699\n", "files": ["testing/web-platform/tests/css/CSS2/floats/crashtests/float-append-child.html"], "git_node": "041f4b39f2bb2e7ef22536d5bf27610be147fdbb", "git_parents": ["5e9f486c9fad55d431ee1d33b0e3b249bf885e23"], "node": "0c47b0e1c76bc69a2acef9361f70d9fe9502d8bd", "parents": ["1c4538f0689b8ab7106611e59763ec61647f0e16"], "tags": []}, {"author": "Fredrik S\u00f6derquist \u003cfs@opera.com\u003e", "branch": "default", "desc": "Bug 2060422 [wpt PR 61702] - Fix flag-check in LayoutSVGShape::ComputeNonScalingStrokeTransform, a=testonly\n\nAutomatic update from web-platform-tests\nFix flag-check in LayoutSVGShape::ComputeNonScalingStrokeTransform\n\nThe if-branch should be the pre-flag behavior, not the post-flag\nbehavior. Reverse the polarity.\n\nFixed: 541684117\nChange-Id: Ie49f0a985ea83280d416142aae9e8f82c97e08f0\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8184233\nCommit-Queue: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nAuto-Submit: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1672990}\n\n--\n\nwpt-commits: e1528f66352a21070355383dcda8138275a07be0\nwpt-pr: 61702\n", "files": ["testing/web-platform/tests/svg/painting/reftests/non-scaling-stroke-008.html"], "git_node": "4e491f44617db9de1ff693207008eb2558f51077", "git_parents": ["041f4b39f2bb2e7ef22536d5bf27610be147fdbb"], "node": "c6742292127a3a0ea6cd11a4df1ce34cd8e6ac87", "parents": ["0c47b0e1c76bc69a2acef9361f70d9fe9502d8bd"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2060341 [wpt PR 61692] - Add fuzzy match to rotate keyframes animation reftest, a=testonly\n\nAutomatic update from web-platform-tests\nAdd fuzzy match to rotate keyframes animation reftest\n\nBug: 499073688\nChange-Id: I8ef11602bcbe5493dd727bbe3795d6dca6aabe55\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8173664\nReviewed-by: Jonathan Lee \u003cjonathanjlee@google.com\u003e\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1673003}\n\n--\n\nwpt-commits: ffd0e6e991ddf7e00e030aeef226afefd9707b56\nwpt-pr: 61692\n", "files": ["testing/web-platform/tests/css/css-transforms/animation/rotate-explicit-and-implicit-keyframes.html"], "git_node": "445c5119120de030847e765bb80c61a3c1178f0c", "git_parents": ["4e491f44617db9de1ff693207008eb2558f51077"], "node": "b0d6abef8130286ba0051066bbce681a6bd09195", "parents": ["c6742292127a3a0ea6cd11a4df1ce34cd8e6ac87"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2060175 [wpt PR 61684] - Fix clipboard permissions-policy tests timing out, a=testonly\n\nAutomatic update from web-platform-tests\nFix clipboard permissions-policy tests timing out\n\npermissions-policy-clipboard-{read,write}.html were sending\n{enabled: true/false} but test_feature_availability() filters on\nevt.data.type === 'availability-result', so test.done() was never\ncalled. Add the type field to fix the mismatch.\n\nBug: 492280259\nChange-Id: I0644ec5399ef87039818d13f8b220c7578cabfe1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8185536\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nReviewed-by: Ari Chivukula \u003carichiv@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1673006}\n\n--\n\nwpt-commits: 82d79deebb4ae4b03edb6ab5316b8749298279a9\nwpt-pr: 61684\n", "files": ["testing/web-platform/tests/permissions-policy/resources/permissions-policy-clipboard-read.html", "testing/web-platform/tests/permissions-policy/resources/permissions-policy-clipboard-write.html"], "git_node": "a7a6374bb766d1dd9e73d95b84e78bfe34db1b6c", "git_parents": ["445c5119120de030847e765bb80c61a3c1178f0c"], "node": "27231da4ecc6fd640ae33e7ceb57692eb8cb7483", "parents": ["b0d6abef8130286ba0051066bbce681a6bd09195"], "tags": []}, {"author": "Chris Dumez \u003ccdumez@apple.com\u003e", "branch": "default", "desc": "Bug 2060432 [wpt PR 61706] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=320884, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=320884 (#61706)\n--\n\nwpt-commits: 72d2bd81dda52cf6d3d8e3066694bbedb87956b3\nwpt-pr: 61706\n", "files": ["testing/web-platform/tests/webaudio/the-audio-api/the-constantsourcenode-interface/constant-source-onended-not-connected.html"], "git_node": "8721da5cb9809fba38681b91574309ef233f4218", "git_parents": ["a7a6374bb766d1dd9e73d95b84e78bfe34db1b6c"], "node": "a8b95b285e18e0f15e727e863da43d69b0867fff", "parents": ["27231da4ecc6fd640ae33e7ceb57692eb8cb7483"], "tags": []}, {"author": "Yoshisto Yanagisawa \u003cyyanagisawa@chromium.org\u003e", "branch": "default", "desc": "Bug 2060424 [wpt PR 61704] - ServiceWorker: Do not set timing_allow_passed for filtered subresource responses, a=testonly\n\nAutomatic update from web-platform-tests\nServiceWorker: Do not set timing_allow_passed for filtered subresource responses\n\nServiceWorkerSubresourceLoader::StartResponse sets `timing_allow_passed`\non the response head. This should only be set for same-origin (kBasic)\nor synthetic (kDefault) responses, and not for filtered responses\n(kCors, kOpaque, kOpaqueRedirect, etc.).\n\nTAG=agy\nCONV=486ca596-5fda-41bd-8a3e-dfe09b7d70fe\n\nBug: 517092658\nChange-Id: Iae1cb465902187cc8724d1000676451a5c68f18d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8182169\nReviewed-by: Shunya Shishido \u003csisidovski@chromium.org\u003e\nCommit-Queue: Yoshisato Yanagisawa \u003cyyanagisawa@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1673052}\n\n--\n\nwpt-commits: eb56b4751033eb5f67589fcf07e8c7574114dc9f\nwpt-pr: 61704\n", "files": ["testing/web-platform/tests/service-workers/service-worker/resource-timing-cross-origin-server-timing.https.html", "testing/web-platform/tests/service-workers/service-worker/resources/resource-timing-server-timing-worker.js", "testing/web-platform/tests/service-workers/service-worker/resources/server-timing.py"], "git_node": "e7c5c11627a28acbdd70f410a4362c6097ced0d1", "git_parents": ["8721da5cb9809fba38681b91574309ef233f4218"], "node": "e0db1e8c8854c7c7f4e03332793d57646f24aa1e", "parents": ["a8b95b285e18e0f15e727e863da43d69b0867fff"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060424 [wpt PR 61704] - Update wpt metadata, a=testonly\n\nwpt-pr: 61704\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/service-workers/service-worker/resource-timing-cross-origin-server-timing.https.html.ini"], "git_node": "bf46e424a8b910f1858369e9973470943fd276e5", "git_parents": ["e7c5c11627a28acbdd70f410a4362c6097ced0d1"], "node": "13031a46f7430567c8007231274475a1c225bcf0", "parents": ["e0db1e8c8854c7c7f4e03332793d57646f24aa1e"], "tags": []}, {"author": "tnikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2060431 [wpt PR 61705] - jpegxl: fix css-before-content comparing a 3x3 image to a 120x120 reference, a=testonly\n\nAutomatic update from web-platform-tests\njpegxl: fix css-before-content comparing a 3x3 image to a 120x120 reference (#61705)\n\nThe image renders at 3x3 even though the test asks for 120x120, so it can't\nmatch the 120x120 reference. width and height on a ::before with an image don't\nsize the image in any browser yet, so a jxl test shouldn't depend on it.\n\nJust make the reference a copy of the test with a png instead of a jxl.\n--\n\nwpt-commits: ee17ed4138513e8e6de39022053977cf71ddf8cc\nwpt-pr: 61705\n", "files": ["testing/web-platform/tests/jpegxl/css-before-content-ref.html", "testing/web-platform/tests/jpegxl/css-before-content.html"], "git_node": "8d9371b8e6938f0ce382caade95506391e076189", "git_parents": ["bf46e424a8b910f1858369e9973470943fd276e5"], "node": "41c05eed44f6b444e902f6c6428c4091f0fdc9c9", "parents": ["13031a46f7430567c8007231274475a1c225bcf0"], "tags": []}, {"author": "Minseong Kim \u003cjja08111@gmail.com\u003e", "branch": "default", "desc": "Bug 2060437 [wpt PR 61708] - [css-overflow] Suppress line breaks in text-overflow, a=testonly\n\nAutomatic update from web-platform-tests\n[css-overflow] Suppress line breaks in text-overflow\n\nIntroduce a `SuppressLineBreaks` function to sanitize the string\nprovided to the `text-overflow` property. This function replaces\nconsecutive forced line break characters with a single space to prevent\nunintended line breaks.\n\nCSSWG Discussion:\nhttps://github.com/w3c/csswg-drafts/issues/12557#issuecomment-3960400974\n\nAnd, this CL adds a Hangul-only subset of Noto Sans CJK KR because\nKorean ellipsis strings have no self-calibrating CSS unit unlike ch for\nLatin or ic for full-width CJK. Pinning a font with fixed metrics keeps\nthose tests deterministic across platforms.\n\nBug: 487634228, 41492459\nChange-Id: I46feadc7d52e18ef16d5fea5e177a25a86f1fde1\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/7710192\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: Minseong Kim \u003cjja08111@gmail.com\u003e\nReviewed-by: Andreu Botella \u003cabotella@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1673114}\n\n--\n\nwpt-commits: 9642bcee4c4185eac53224f4b1e05b9841f4581b\nwpt-pr: 61708\n", "files": ["testing/web-platform/tests/css/css-ui/reference/text-overflow-string-009-ref.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-010-ref.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-011-ref.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-012-ref.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-013-ref.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-014-ref.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-015-ref.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-016-ref.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-024-ref.tentative.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-025-ref.tentative.html", "testing/web-platform/tests/css/css-ui/reference/text-overflow-string-026-ref.tentative.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-003.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-009.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-010.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-011.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-012.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-013.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-014.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-015.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-016.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-017.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-018.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-019.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-020.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-021.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-022.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-023.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-024.tentative.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-025.tentative.html", "testing/web-platform/tests/css/css-ui/text-overflow-string-026.tentative.html", "testing/web-platform/tests/fonts/noto/cjk-kr/LICENSE.txt", "testing/web-platform/tests/fonts/noto/cjk-kr/NotoSansCJKkr-Regular-subset.otf", "testing/web-platform/tests/fonts/noto/cjk-kr/README.md", "testing/web-platform/tests/fonts/noto/cjk-kr/subset.sh"], "git_node": "47bd7ea0f9bab0eafc9543ac94a9bc038239c146", "git_parents": ["8d9371b8e6938f0ce382caade95506391e076189"], "node": "0236df68c99cbce72804aa1176b6ebb316bdd758", "parents": ["41c05eed44f6b444e902f6c6428c4091f0fdc9c9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060437 [wpt PR 61708] - Update wpt metadata, a=testonly\n\nwpt-pr: 61708\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-ui/text-overflow-string-009.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-010.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-011.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-012.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-013.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-016.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-017.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-018.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-019.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-020.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-021.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-022.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-023.html.ini"], "git_node": "f4dc24c1ff210965bce141404f9206a8c36e2fd0", "git_parents": ["47bd7ea0f9bab0eafc9543ac94a9bc038239c146"], "node": "728730d502da12c78e6b1a74c69d2410f5207a81", "parents": ["0236df68c99cbce72804aa1176b6ebb316bdd758"], "tags": []}, {"author": "dependabot[bot] \u003c49699333+dependabot[bot]@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2060398 [wpt PR 61698] - Bump docker/login-action from 4.4.0 to 4.6.0, a=testonly\n\nAutomatic update from web-platform-tests\nBump docker/login-action from 4.4.0 to 4.6.0\n\nBumps [docker/login-action](https://github.com/docker/login-action) from 4.4.0 to 4.6.0.\n- [Release notes](https://github.com/docker/login-action/releases)\n- [Commits](https://github.com/docker/login-action/compare/af1e73f918a031802d376d3c8bbc3fe56130a9b0...dbcb813823bdd20940b903addbd779551569679f)\n", "files": ["testing/web-platform/tests/.github/workflows/docker.yml"], "git_node": "aed278276993dd55023f6edab338942a46b85383", "git_parents": ["f4dc24c1ff210965bce141404f9206a8c36e2fd0"], "node": "29274c76755b33c362fd097d427abab2f560c703", "parents": ["728730d502da12c78e6b1a74c69d2410f5207a81"], "tags": []}, {"author": "Nina Satragno \u003cnsatragno@google.com\u003e", "branch": "default", "desc": "Bug 2058250 [wpt PR 61551] - [webdriver] Add suggested reviewers for the WebDriver WebAuthn folder, a=testonly\n\nAutomatic update from web-platform-tests\n[webdriver] Add suggested reviewers for WebAuthn\n\nAdd nsatragno (myself) and whimboo as suggested reviewers for the\nWebAuthn webdriver tests.\n\nSee issue #20684\n\n--\n\nwpt-commits: e1964b2b9e68e86c4f59ebf78f57a4611e4b67b7\nwpt-pr: 61551\n", "files": ["testing/web-platform/tests/webdriver/tests/classic/external/webauthn/META.yml"], "git_node": "d84fa0b5fdc27a108a86be6ccc94f377970367bf", "git_parents": ["aed278276993dd55023f6edab338942a46b85383"], "node": "f98c5741717b5196f61da87bc8c8b6722bb8b71b", "parents": ["29274c76755b33c362fd097d427abab2f560c703"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058250 [wpt PR 61551] - Update wpt metadata, a=testonly\n\nwpt-pr: 61551\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/classic/external/webauthn/add_virtual_authenticator/add.py.ini", "testing/web-platform/meta/webdriver/tests/classic/external/webauthn/remove_virtual_authenticator/invalid.py.ini"], "git_node": "fc15c4205d27576eb8ad92caf341e6dc345f7bf1", "git_parents": ["d84fa0b5fdc27a108a86be6ccc94f377970367bf"], "node": "49f6e637eba467e400ff5e874293828a08f6e010", "parents": ["f98c5741717b5196f61da87bc8c8b6722bb8b71b"], "tags": []}, {"author": "Alison Maher \u003calmaher@microsoft.com\u003e", "branch": "default", "desc": "Bug 2060458 [wpt PR 61712] - [Masonry] Intrinsic block size when fragmenting, a=testonly\n\nAutomatic update from web-platform-tests\n[Masonry] Intrinsic block size when fragmenting\n\nTrack the complete grid-lanes intrinsic block size separately from the\ncurrent fragment\u2019s intrinsic block size. The total size is computed\nduring sizing and placement, persisted in the break token, and used for\nnon-fragmented layout, while `intrinsic_block_size_` is reserved for\nper-fragment sizing.\n\nThis also fixes empty contenteditable grid-lanes fragmentation, with a\nnew test added for this case.\n\nBug: 343257585\nChange-Id: I881e22bce9ef9bdba4640679bb1e59f456c889bb\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8175235\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1673218}\n\n--\n\nwpt-commits: f28136b77ca55899945381a1fc4adb80e838b4f5\nwpt-pr: 61712\n", "files": ["testing/web-platform/tests/css/css-break/grid/grid-lanes/grid-lanes-container-fragmentation-007.tentative.html"], "git_node": "86e6d0d1162bd9e1cad06ac3bde2255eb09ede5e", "git_parents": ["fc15c4205d27576eb8ad92caf341e6dc345f7bf1"], "node": "9891671360620ffd7928bb2c77418fc9720e61c9", "parents": ["49f6e637eba467e400ff5e874293828a08f6e010"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060458 [wpt PR 61712] - Update wpt metadata, a=testonly\n\nwpt-pr: 61712\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-break/grid/grid-lanes/grid-lanes-container-fragmentation-007.tentative.html.ini"], "git_node": "07f94de02011ab5950f213ae1ba787c87b99c534", "git_parents": ["86e6d0d1162bd9e1cad06ac3bde2255eb09ede5e"], "node": "0cc21909e7fe6a861c8c7c266418b370c3a3bb88", "parents": ["9891671360620ffd7928bb2c77418fc9720e61c9"], "tags": []}, {"author": "Cathie Chen \u003ccchen@igalia.com\u003e", "branch": "default", "desc": "Bug 2060434 [wpt PR 61707] - [Selection] Selecting from contenteditable to OOF user-select:none, a=testonly\n\nAutomatic update from web-platform-tests\n[Selection] Selecting from contenteditable to OOF user-select:none\n\nThis is a fix for a regression introduced by crrev.com/c/7617189, which\nadded a NoExtendSelectionToUserSelectNoneOutOfFlow early-return in\nPositionRespectingEditingBoundary() before UserSelectContainBoundaryOf()\nwas called. When the selection anchor was inside a contenteditable\n(non-null editable_element), let UserSelectContainBoundaryOf() handle\nit. A new flag NoExtendSelectionToUserSelectNoneOutOfFlowUnlessEditable\nadded to control this change.\n\nBug: 522844903\nTest: wpt/selection/drag-selection-contenteditable-to-out-of-flow-user-select-none.html\nChange-Id: I112ecf4424bd2d3dbf187085d99b61624b0e63b5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8011000\nReviewed-by: Koji Ishii \u003ckojii@chromium.org\u003e\nCommit-Queue: cathie chen \u003ccchen@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1673219}\n\n--\n\nwpt-commits: 5571fcea703e6a567e714aed82670749d6064c6e\nwpt-pr: 61707\n", "files": ["testing/web-platform/tests/selection/drag-selection-contenteditable-to-out-of-flow-user-select-none.html", "testing/web-platform/tests/selection/drag-selection-extend-to-user-select-none.html"], "git_node": "9cb1a7a703041aa7ee5e7c057c4d42e1bd96ff56", "git_parents": ["07f94de02011ab5950f213ae1ba787c87b99c534"], "node": "60cea6b97d5c71a1208ab5524554e3a5416820a1", "parents": ["0cc21909e7fe6a861c8c7c266418b370c3a3bb88"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060434 [wpt PR 61707] - Update wpt metadata, a=testonly\n\nwpt-pr: 61707\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/selection/drag-selection-contenteditable-to-out-of-flow-user-select-none.html.ini"], "git_node": "b8ce5e7d1ea849c0cfe64cd3985b420d0f644c2c", "git_parents": ["9cb1a7a703041aa7ee5e7c057c4d42e1bd96ff56"], "node": "d7236f0645a898b218616caf8e11732d9ce56d3f", "parents": ["60cea6b97d5c71a1208ab5524554e3a5416820a1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060607 - [wpt-sync] Update web-platform-tests to 5571fcea703e6a567e714aed82670749d6064c6e, a=testonly\n\nMANUAL PUSH: wpt sync bot\n\nwpt-head: 5571fcea703e6a567e714aed82670749d6064c6e\nwpt-type: landing\n", "files": ["testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-disabled-by-permissions-policy.tentative.https.sub.html.ini", "testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-by-permissions-policy.tentative.https.sub.html.ini", "testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-read/clipboard-read-enabled-on-self-origin-by-permissions-policy.tentative.https.sub.html.ini", "testing/web-platform/meta/clipboard-apis/permissions-policy/clipboard-write/clipboard-write-disabled-by-permissions-policy.tentative.https.sub.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-and-ignore-on-img-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/containertiming-and-ignore-on-text-itself.html.ini", "testing/web-platform/meta/container-timing/tentative/ignore-with-containertiming-and-child-img.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-and-ignore-on-img.html.ini", "testing/web-platform/meta/container-timing/tentative/nested-containertiming-and-ignore-on-text.html.ini", "testing/web-platform/meta/cookiestore/cookieStore_get_arguments.https.any.js.ini", "testing/web-platform/meta/cookiestore/cookieStore_set_arguments.https.any.js.ini", "testing/web-platform/meta/css/css-borders/subpixel-borders-with-child.html.ini", "testing/web-platform/meta/css/css-link-params/inheritance.html.ini", "testing/web-platform/meta/css/css-masking/mask-image/backdrop-filter-bad-mask-image.html.ini", "testing/web-platform/meta/editing/run/delete.html.ini", "testing/web-platform/meta/html/user-activation/navigate-to-crossorigin-redirect.html.ini", "testing/web-platform/meta/html/user-activation/navigate-to-sameorigin.html.ini", "testing/web-platform/meta/jpegxl/css-before-content.html.ini", "testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini", "testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini", "testing/web-platform/meta/mozilla-sync", "testing/web-platform/meta/pointerevents/pointerlock/pointerevent_coordinates_when_locked.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia-settings.https.html.ini", "testing/web-platform/meta/screen-capture/getdisplaymedia.https.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-audio+video.https.sub.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-audio.https.sub.html.ini", "testing/web-platform/meta/screen-capture/permissions-policy-video.https.sub.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini", "testing/web-platform/meta/webrtc/RTCRtpReceiver-video-anyCodec.html.ini", "testing/web-platform/meta/webtransport/close.https.any.js.ini"], "git_node": "a521925ce15fa17e7f4dc3b58c9abe6a0bd0e2d0", "git_parents": ["b8ce5e7d1ea849c0cfe64cd3985b420d0f644c2c"], "node": "059f95acb195b1cf3264cc12d90276e46c6bca75", "parents": ["d7236f0645a898b218616caf8e11732d9ce56d3f"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2060649 - Remove unused BounceTrackingState::ShouldCreateBounceTrackingStateForBC declaration r=emz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316438\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.h"], "git_node": "70483802e079d4e50ed0626cf5d266d6683fb80e", "git_parents": ["a521925ce15fa17e7f4dc3b58c9abe6a0bd0e2d0"], "node": "fe8a13040420cc1bb2845861642730e121d70306", "parents": ["059f95acb195b1cf3264cc12d90276e46c6bca75"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1982627 - Collapse selection range if extending across shadow boundary via JS. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315719\n", "files": ["dom/base/Selection.cpp", "dom/base/nsRange.cpp", "testing/web-platform/tests/selection/shadow-dom/cross-shadow-boundary-extend.html"], "git_node": "8384e0b10c7247e94fb27e7a9bdfc6ec7fd959d4", "git_parents": ["70483802e079d4e50ed0626cf5d266d6683fb80e"], "node": "1a0b81ad2d11a9c50e740e46cc9ef7788f134f3e", "parents": ["fe8a13040420cc1bb2845861642730e121d70306"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060639 - Send urlbar engine icons over the actor as data URLs. r=mbeier\n\nAn engine's icon URL is a blob URL, which only resolves in the process that\ncreated it, so passing it to the child leaves a \u003cmoz-urlbar\u003e in a content\nprocess -- what the new tab page needs -- with a URL it can't load.\nUrlbarParent converts such an icon to a data URL, which loads anywhere.\n\nThe conversion sits in UrlbarParent so that the direct path keeps handing out\nthe parent's own URL and copies nothing. Base64 costs a third more than the\nbytes it carries, but the search service caps an icon at MAX_ICON_SIZE (20KB)\nand each engine is fetched once per process, so the ceiling is a few KB --\ncheap next to giving the child a blob it would have to own and revoke.\n\nWorth checking: a test can no longer compare the switcher's icon against the\nURL the search service resolves, because over the message path those are one\nimage under two URLs. searchModeSwitcherIconIs compares what they show instead,\nand the assertions that rested on URL equality go through it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316347\n", "files": ["browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchModeSwitcher.js"], "git_node": "56cad6e42a02433a111cbbf0a2a66b3739e9ec3e", "git_parents": ["8384e0b10c7247e94fb27e7a9bdfc6ec7fd959d4"], "node": "786225ecf5ee99e2a3535fd08f115947627e78c9", "parents": ["1a0b81ad2d11a9c50e740e46cc9ef7788f134f3e"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2054295 - Unblock onload when a off-thread compiled Module is canceled. r=jonco\n\nA off-thread compiled ScriptLoadRequest will block the onload handler of the\ndocument until it's done. But if it's canceled (for example, an import map is\ninserted), it should also unblock the onload handler.\n\ntest_bug_2054295.html drives the reproduction by suspending two channels from an\n\"http-on-opening-request\" observer.\n\nThe sequence is as follows:\n1. bug_2054295_hold_parser.js is suspended, holding off the parser of\n   file_bug_2054295.html before it reaches the import map.\n2. Meanwhile the preload scanner preloads bug_2054295_entry.mjs, which is long\n   enough to be compiled off-thread, and that blocks onload.\n3. The compiled entry module starts fetching bug_2054295_dep.mjs. That fetch is\n   suspended in turn, and the parser is released.\n4. The parser inserts the import map. Registering it cancels the preloaded (and\n   now onload-blocking) entry module, and the page reports that back to the\n   test.\n5. The dependency fetch is released so the load group drains, and the onload\n   handler must be called.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316039\n", "files": ["dom/base/test/jsmodules/importmaps/bug_2054295_dep.mjs", "dom/base/test/jsmodules/importmaps/bug_2054295_entry.mjs", "dom/base/test/jsmodules/importmaps/bug_2054295_hold_parser.js", "dom/base/test/jsmodules/importmaps/file_bug_2054295.html", "dom/base/test/jsmodules/importmaps/mochitest.toml", "dom/base/test/jsmodules/importmaps/test_bug_2054295.html", "js/loader/ScriptLoadRequest.cpp"], "git_node": "3372dfb7220e5f2f5c70229830cb6c482c58f861", "git_parents": ["56cad6e42a02433a111cbbf0a2a66b3739e9ec3e"], "node": "cf0f9b84f306432fea5aefef5a89f7337babcaab", "parents": ["786225ecf5ee99e2a3535fd08f115947627e78c9"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2041557 - Change sync worker backoff policy to linear back-off instead of exponential back-off r=markh,jonalmeida,android-reviewers\n\nWe have been having a couple of issues with the reliability of the sync, and requests getting backed off for significant periods of time.\nIn order to be gentler, we would like to change the exponential backoff policy to a linear one\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316357\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt"], "git_node": "e152e4212d19c94dfebb720a828ab44651a6e32b", "git_parents": ["3372dfb7220e5f2f5c70229830cb6c482c58f861"], "node": "7af4cec35157b5fc7e89ceeff5eb465c89adb0db", "parents": ["cf0f9b84f306432fea5aefef5a89f7337babcaab"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054625 - WebRTC backport: Video capture: validate PipeWire camera frame size to prevent OOB read r=pehrsons\n\nCheck spa_chunk::size is not larger than mmap'ed buffer, which would\nlead to an out-of-bounds read when the frame is copied. Validate that\nchunk offset + size does not exceed maxsize before processing.\n\nThis is a simple backport of an WebRTC upstream change.\n\nUpstream commit: 612430e8266881eaff478b0000cacc90fb71c918\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316000\n", "files": ["third_party/libwebrtc/modules/video_capture/linux/video_capture_pipewire.cc", "third_party/libwebrtc/moz-patch-stack/612430e826.no-op-cherry-pick-msg"], "git_node": "5863efcc070cb5ea81729827b6b7f1a3f7ddd9d0", "git_parents": ["e152e4212d19c94dfebb720a828ab44651a6e32b"], "node": "104591ff24beecaf118826e216e5a0dee17f98a2", "parents": ["7af4cec35157b5fc7e89ceeff5eb465c89adb0db"], "tags": []}, {"author": "Hansheng Zhao \u003chzhao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057317 - Provide the New Tab context id to the Mozilla Ads Client r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315026\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/AdsFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AdsFeed.js"], "git_node": "4c6076be4cef3427b7c0843def5d276a04cefe28", "git_parents": ["5863efcc070cb5ea81729827b6b7f1a3f7ddd9d0"], "node": "bf7c1b9190af852220c980daaa84bba20b369ba3", "parents": ["104591ff24beecaf118826e216e5a0dee17f98a2"], "tags": []}, {"author": "Jan Grulich \u003cjgrulich@redhat.com\u003e", "branch": "default", "desc": "Bug 2054620 - Update vendored PipeWire to 1.6.8 r=webrtc-reviewers,pehrsons\n\nThis fixes two security issues reported against Firefox:\n- Heap buffer overflow read in spa_pod_parser_getv (Bug 2054620)\n- Heap buffer overflow read via truncated SPA choice pod because of\n  missing body-size validation in spa_pod_get_values (Bug 2054619)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314886\n", "files": ["third_party/pipewire/moz.yaml", "third_party/pipewire/pipewire/array.h", "third_party/pipewire/pipewire/buffers.h", "third_party/pipewire/pipewire/capabilities.h", "third_party/pipewire/pipewire/client.h", "third_party/pipewire/pipewire/context.h", "third_party/pipewire/pipewire/control.h", "third_party/pipewire/pipewire/core.h", "third_party/pipewire/pipewire/data-loop.h", "third_party/pipewire/pipewire/device.h", "third_party/pipewire/pipewire/factory.h", "third_party/pipewire/pipewire/i18n.h", "third_party/pipewire/pipewire/impl-client.h", "third_party/pipewire/pipewire/impl-module.h", "third_party/pipewire/pipewire/impl-node.h", "third_party/pipewire/pipewire/impl-port.h", "third_party/pipewire/pipewire/keys.h", "third_party/pipewire/pipewire/link.h", "third_party/pipewire/pipewire/loop.h", "third_party/pipewire/pipewire/map.h", "third_party/pipewire/pipewire/mem.h", "third_party/pipewire/pipewire/module.h", "third_party/pipewire/pipewire/node.h", "third_party/pipewire/pipewire/permission.h", "third_party/pipewire/pipewire/pipewire.h", "third_party/pipewire/pipewire/port.h", "third_party/pipewire/pipewire/private.h", "third_party/pipewire/pipewire/properties.h", "third_party/pipewire/pipewire/protocol.h", "third_party/pipewire/pipewire/proxy.h", "third_party/pipewire/pipewire/resource.h", "third_party/pipewire/pipewire/stream.h", "third_party/pipewire/pipewire/thread-loop.h", "third_party/pipewire/pipewire/thread.h", "third_party/pipewire/pipewire/timer-queue.h", "third_party/pipewire/pipewire/type.h", "third_party/pipewire/pipewire/utils.h", "third_party/pipewire/pipewire/version.h", "third_party/pipewire/spa/buffer/alloc.h", "third_party/pipewire/spa/buffer/buffer.h", "third_party/pipewire/spa/buffer/meta.h", "third_party/pipewire/spa/buffer/type-info.h", "third_party/pipewire/spa/control/control.h", "third_party/pipewire/spa/control/type-info.h", "third_party/pipewire/spa/control/ump-utils.h", "third_party/pipewire/spa/debug/buffer.h", "third_party/pipewire/spa/debug/context.h", "third_party/pipewire/spa/debug/dict.h", "third_party/pipewire/spa/debug/file.h", "third_party/pipewire/spa/debug/format.h", "third_party/pipewire/spa/debug/log.h", "third_party/pipewire/spa/debug/mem.h", "third_party/pipewire/spa/debug/node.h", "third_party/pipewire/spa/debug/pod.h", "third_party/pipewire/spa/debug/types.h", "third_party/pipewire/spa/filter-graph/filter-graph.h", "third_party/pipewire/spa/graph/graph.h", "third_