k/include/opentelemetry/sdk/common/atomic_unique_ptr.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/common/attribute_utils.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/common/attributemap_hash.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/instrumentationscope/scope_configurator.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/multi_recordable.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/recordable.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/span_data.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/span_limits.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/tracer.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/tracer_context.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/tracer_provider.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/trace/tracer_provider_factory.h", "third_party/opentelemetry-cpp/sdk/include/opentelemetry/sdk/version/version.h", "third_party/opentelemetry-cpp/sdk/src/common/empty_attributes.cc", "third_party/opentelemetry-cpp/sdk/src/resource/resource_detector.cc", "third_party/opentelemetry-cpp/sdk/src/trace/multi_recordable.cc", "third_party/opentelemetry-cpp/sdk/src/trace/span.cc", "third_party/opentelemetry-cpp/sdk/src/trace/span.h", "third_party/opentelemetry-cpp/sdk/src/trace/span_data.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_context.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_provider.cc", "third_party/opentelemetry-cpp/sdk/src/trace/tracer_provider_factory.cc", "third_party/opentelemetry-cpp/sdk/src/version/version.cc"], "git_node": "fd07875dc22750eea4df5d4080be89c4c4b4f0f1", "git_parents": ["3238da7d7482706cf8bc91e3ace9ec1aa5c0f181"], "node": "7b39f8c43d1dfb3797914af5d721c17018c945e5", "parents": ["a78412610ba50f35acb8200e44364592160eea74"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055724 - Apply mozilla patches for opentelemetry-cpp r=jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312627\n", "files": ["third_party/opentelemetry-cpp/api/include/opentelemetry/context/context_value.h", "third_party/opentelemetry-cpp/exporters/otlp/include/opentelemetry/exporters/otlp/otlp_recordable_utils.h", "third_party/opentelemetry-cpp/exporters/otlp/src/otlp_recordable_utils.cc"], "git_node": "dd256f0fa21d15341cda5f51020952ce915f0936", "git_parents": ["fd07875dc22750eea4df5d4080be89c4c4b4f0f1"], "node": "011496e77dffac55d986154baeecc43a5596688e", "parents": ["7b39f8c43d1dfb3797914af5d721c17018c945e5"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060802 - Enable the continuous onboarding flow by default r=android-reviewers,alastun\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316513\n", "files": ["mobile/android/fenix/app/onboarding.fml.yaml", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/OnboardingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/OnboardingSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/OnboardingTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HomeScreenRobot.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesOnboardingBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/utils/UiDevice.kt"], "git_node": "9fa18dd68caa2386a5066374e07fa381b371d03c", "git_parents": ["dd256f0fa21d15341cda5f51020952ce915f0936"], "node": "dc7919389226f1bd5b820d920e9a79da388d5721", "parents": ["011496e77dffac55d986154baeecc43a5596688e"], "tags": []}, {"author": "alin lastun \u003calastun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051381 - Give VPN connection status priority over the feature name in the menu badge r=android-reviewers,sfamisa,twhite\n\nGive the status badge full priority for the space. Only show the 'VPN' label if it fits completely (measured with TextMeasurer), instead of showing an ellipsis (...)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316219\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt"], "git_node": "e2eaf5edd5f18ad273a0e3bd9926e934faaea6db", "git_parents": ["9fa18dd68caa2386a5066374e07fa381b371d03c"], "node": "6811a892c261002b708f16fe6fe21fdad13e9ce9", "parents": ["dc7919389226f1bd5b820d920e9a79da388d5721"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2061083 - Clamp infinite length-percentage calc expressions. r=firefox-style-system-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316990\n", "files": ["servo/components/style/values/computed/length_percentage.rs", "testing/web-platform/meta/css/css-values/typed_arithmetic.html.ini", "testing/web-platform/tests/css/css-values/calc-infinity-nan-computed.html"], "git_node": "9165316d6b7289325e14f36e7b649a62ed22c33e", "git_parents": ["e2eaf5edd5f18ad273a0e3bd9926e934faaea6db"], "node": "f67df042f45132142e7de6fbed326c2d2fc28831", "parents": ["6811a892c261002b708f16fe6fe21fdad13e9ce9"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054065 - Rework instances of :root:has() in sidebar.css and content-area.css to resolve perf regression r=desktop-theme-reviewers,tabbrowser-reviewers,jsudiaman,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316841\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview.js", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/content-area.css", "toolkit/content/widgets/tabbox.js"], "git_node": "96c87b9a6e6362ac3021706be95270f601f25ec2", "git_parents": ["9165316d6b7289325e14f36e7b649a62ed22c33e"], "node": "fea353a5dcf42c07b7dbc069808a27c29bb3dcb6", "parents": ["f67df042f45132142e7de6fbed326c2d2fc28831"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2056986 - Update AboutWelcome default screens based on set default prompt segmentation and trigger set default when OS-level consent prompt will show r=omc-reviewers,jprickett\n\nAuto-trigger set default for platforms where an OS consent prompt or settings\npanel will open when new users land on new tab. Do not show the set default\ncheckbox in about:welcome for these users.\n\nAlso includes and update to ensure that on local builds users who don't have\nthe pin and default actions auto-triggers still see the options in\nabout:welcome.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314021\n", "files": ["browser/components/aboutwelcome/modules/AboutWelcomeDefaults.sys.mjs", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multistage_languageSwitcher.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_multistage_mr.js", "browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_screen_targeting.js", "browser/components/asrouter/docs/action-only.md", "browser/components/asrouter/docs/messaging-surfaces.md", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/MessagingTargetingConstants.sys.mjs", "browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "75a5d0bebfce31d8f79341db7a36864c2ff9ce0a", "git_parents": ["96c87b9a6e6362ac3021706be95270f601f25ec2"], "node": "11861e76f01e354744f1ff879e3db9f2dd853dc2", "parents": ["fea353a5dcf42c07b7dbc069808a27c29bb3dcb6"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060232 - Fix for auto-touch mode checkbox visibility and add check for touch-mode capability on Windows r=sfoster,hjones,gstoll\n\nThis technically fixes two issues:\n1. The issue described in bug 2060232 where the checkbox under the Standard window density setting doesn't always display when expected on tablet mode capable devices. It should show only when you're using a tablet-capable Win 11 device, a Win 10 device, or Linux AND the Standard density mode must be currently selected.\n2. Adds a fix for an underlying issue with our previously added check for when to display these conditional touch-specific settings in about:preferences#appearance \u003e Window density. We previously were checking for platform alone including only looking at Win10/Linux for these touch settings. With this patch, we should be able to tell on Win11 if the device is tablet mode capable and show settings accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316241\n", "files": ["browser/components/preferences/config/appearance.mjs", "browser/components/preferences/tests/browser_appearance_pane.js", "widget/nsIWindowsUIUtils.idl", "widget/windows/WinEventObserver.cpp", "widget/windows/WindowsUIUtils.cpp", "widget/windows/WindowsUIUtils.h"], "git_node": "2ab024e831370a8c2d77b9789c24d97657cdfa35", "git_parents": ["75a5d0bebfce31d8f79341db7a36864c2ff9ce0a"], "node": "08b2d55d555f6ada919d60953cd5848b203603cb", "parents": ["11861e76f01e354744f1ff879e3db9f2dd853dc2"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1961577 - Keep tabs in place when collapsing a dragged tab group. r=tabbrowser-reviewers,nsharpley\" for causing bc and TV failures at tab_group_overflow.js\n\nThis reverts commit 9450c9760f367d2f1f8865c5dfc88ed05668a08a.\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/test/browser/dragdrop/browser.toml", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_tab_group_overflow.js"], "git_node": "5f08c7f2d08d991ec95e1227f956ff18a78c3a76", "git_parents": ["2ab024e831370a8c2d77b9789c24d97657cdfa35"], "node": "f21bfb6593bb874c60ac279f71f8ee7a0b29bbe8", "parents": ["08b2d55d555f6ada919d60953cd5848b203603cb"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061142 - Migrate verifyReaderModeControlsTest UI test to the efficiency framework r=jajohnson\n\nConverted the verifyReaderModeControlsTest UI test to the efficiency framework.\n\nFirst status check revealed an navigation-reachability issue: `TEST-UNEXPECTED-FAIL | org.mozilla.fenix.ui.efficiency.generation.reachability.shards.ReachabilityShard15#verifyNavigationReachability[0: ReaderViewPage (TBD) \u2014 Navigation Reachability] | java.lang.AssertionError: No navigation path found from 'AppEntry' to 'ReaderViewPage'` .\n\nRemoved ReaderViewPage from PageContext (instantiating it locally in the test instead) so it's no longer auto-enrolled in the navigation-reachability suite \u2014 the reader-view appearance controls are a transient overlay the navigation graph can't express, so the generated case always failed.\n\nAlso fixes two flakes: added a polled mozVerify before the \"Close reader view\" click (which previously raced the toolbar recomposition), and made verifyFontSize poll SharedPreferences instead of reading once (the +/- change   persists asynchronously, causing off-by-one failures like expected:6 but was:5).\n\nThe new UI test successfully passed 50x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=76458   | try ]]\nAll efficiency UI test successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=76459  | try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316838\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/ReaderViewTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/ReaderViewPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ReaderViewSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/ReaderViewTest.kt"], "git_node": "24cac005c5dfe6c73b87f0bbf2809f91b499a8ac", "git_parents": ["5f08c7f2d08d991ec95e1227f956ff18a78c3a76"], "node": "4d3665b0668b4889f700b9112a69947ac6eae24d", "parents": ["f21bfb6593bb874c60ac279f71f8ee7a0b29bbe8"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058504 - Add test for EditContext empty text character rect. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316839\n", "files": ["editor/libeditor/tests/edit-context/test_editcontext_fallback_bounds.html"], "git_node": "0278cc5ef38c1af1d3914e881afe3cd895d7e305", "git_parents": ["24cac005c5dfe6c73b87f0bbf2809f91b499a8ac"], "node": "92d1599373dd890eee31ad3f5d03ac0141beafb7", "parents": ["4d3665b0668b4889f700b9112a69947ac6eae24d"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061641 - Clobber for the New Tab build-time locales generation. r=firefox-build-system-reviewers,sergesanspaille DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317010\n", "files": ["CLOBBER"], "git_node": "1fd6dcffb93b4e985ccdf47880c0c33f89f7444e", "git_parents": ["0278cc5ef38c1af1d3914e881afe3cd895d7e305"], "node": "cec1b384bdd7c2a1a8590e896f071855939a09c2", "parents": ["92d1599373dd890eee31ad3f5d03ac0141beafb7"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059446 - [devtools] Fix profiler button color in win10 HCM r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316586\n", "files": ["devtools/client/themes/perf.css"], "git_node": "1bcf4a444fcd854c023d510d31ebaa634aff60fd", "git_parents": ["1fd6dcffb93b4e985ccdf47880c0c33f89f7444e"], "node": "294517df2cbf19de6336bf6e95b3c4f56f5f8014", "parents": ["cec1b384bdd7c2a1a8590e896f071855939a09c2"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061608 - Update android nightly application-services version bump to 3f6bd4d96e43e61a712578c16b148a82316e6b0a r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316993\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "77e9766b0d0a6b7353b1ce596ca35f667dc6cc7a", "git_parents": ["1bcf4a444fcd854c023d510d31ebaa634aff60fd"], "node": "8b5ee7f978b9559d0c9756bfc2535054354b971c", "parents": ["294517df2cbf19de6336bf6e95b3c4f56f5f8014"], "tags": []}, {"author": "Sajid Anwar \u003csajidanwar94@gmail.com\u003e", "branch": "default", "desc": "Bug 2061690 - Enable CSS typed arithmetic pref on tests. r=firefox-style-system-reviewers,dshin\n\nDONTBUILD, metadata only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317061\n", "files": ["layout/inspector/tests/mochitest.toml", "layout/style/test/mochitest.toml", "testing/web-platform/meta/__dir__.ini"], "git_node": "935c482add028492a310e6e0c962c940de9a3f85", "git_parents": ["77e9766b0d0a6b7353b1ce596ca35f667dc6cc7a"], "node": "353c68d58c1528d13b1217c8d922421b82de267f", "parents": ["8b5ee7f978b9559d0c9756bfc2535054354b971c"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061274 - Add a new pref to gate the site inclusions feature - r=ip-protection-reviewers,kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316855\n", "files": ["browser/app/profile/firefox.js", "toolkit/components/ipprotection/docs/Preferences.md"], "git_node": "520908bfbee1ba850db1db1d7b9b13c3bec6d772", "git_parents": ["935c482add028492a310e6e0c962c940de9a3f85"], "node": "c386c5377225862004e4a3078310f542e9fd7cb2", "parents": ["353c68d58c1528d13b1217c8d922421b82de267f"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051225 - VPN panel briefly displays loading state every time it is opened while in paused state - r=ip-protection-reviewers,kpatenio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311557\n", "files": ["browser/components/ipprotection/IPProtectionPanel.sys.mjs", "browser/components/ipprotection/tests/browser/browser_ipprotection_status_box.js"], "git_node": "1e6d78cf9f2b50e5fc52024ce814fc464c2b397e", "git_parents": ["520908bfbee1ba850db1db1d7b9b13c3bec6d772"], "node": "fee8a407295fe721b80df08cfc9e84212813bdcf", "parents": ["c386c5377225862004e4a3078310f542e9fd7cb2"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059098: Make ViewTimeline's subject argument required. r=layout-scroll-driven-animation-reviewers,webidl,smaug,boris\n\nFollows the resolution:\n\nhttps://github.com/w3c/csswg-drafts/issues/13959\n\nWPT Changes:\n* `/scroll-animations/view-timelines/duration.html`: Null-subject is incidental,\n  we only care that any view timeline returns the duration of 100%.\n* `/scroll-animations/view-timelines/view-timeline-missing-subject.html`:\n  Deleted, since it actively tests the null subject.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316809\n", "files": ["dom/animation/ViewTimeline.cpp", "dom/animation/ViewTimeline.h", "dom/webidl/ViewTimeline.webidl", "testing/web-platform/tests/interfaces/scroll-animations.idl", "testing/web-platform/tests/scroll-animations/view-timelines/duration.html", "testing/web-platform/tests/scroll-animations/view-timelines/view-timeline-missing-subject.html"], "git_node": "338a85af904c84d889610da0c0c32b1cea944f96", "git_parents": ["1e6d78cf9f2b50e5fc52024ce814fc464c2b397e"], "node": "5891a3089e7d3e3c2108f011e4416b6570f53b09", "parents": ["fee8a407295fe721b80df08cfc9e84212813bdcf"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998331: Making button element selectable by default r=dholbert,firefox-style-system-reviewers,emilio,devtools-reviewers,layout-reviewers,dshin,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300613\n", "files": ["accessible/tests/browser/mac/browser_text_selection.js", "devtools/client/themes/webconsole.css", "devtools/server/tests/browser/browser_accessibility_node.js", "devtools/server/tests/browser/browser_accessibility_node_events.js", "layout/base/tests/test_caret_browsing_around_form_controls.html", "layout/style/res/forms.css", "testing/web-platform/tests/css/css-ui/tentative/button-user-select.html"], "git_node": "042bed283e8c970ce18461810a8941a287182139", "git_parents": ["338a85af904c84d889610da0c0c32b1cea944f96"], "node": "49922679114b69841e3cf40afa475f38e0a7a1e2", "parents": ["5891a3089e7d3e3c2108f011e4416b6570f53b09"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Fix uninitialized corner shape values in theme drawing. r=gfx-reviewers,nical\n\nFollowing the first implementation of CSS corner shape rendering (see bug 2035317),\nthe struct wr::BorderRadius now has four new fields for the corner shapes, which\nwere left uninitialized here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317056\n", "files": ["widget/ThemeDrawing.cpp"], "git_node": "cdbda8a2ec98e0a55546a33572983737dfdb88ca", "git_parents": ["042bed283e8c970ce18461810a8941a287182139"], "node": "9687b89c94d4d3166f8165cba266e1858b7a8f95", "parents": ["49922679114b69841e3cf40afa475f38e0a7a1e2"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Improve superellipse normal approximation. r=gfx-reviewers,nical\n\nFix normal discontinuity when shape approaches 1 (round). Both normal approximations\nnow correctly converge towards axis-aligned normals when reaching a round shape, which\nmatches the preexisting implementation of ellipses for border radii, ensuring a smooth\ntransition between the two and no jumps when animating the shape parameter.\n\nThe new version of compute_superellipse_half_corner(), with the correction applied\nwith a quadratic falloff, actually becomes almost linear. Thus, a much cheaper linear\napproximation has been implemented, and is now used by default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317057\n", "files": ["gfx/wr/webrender/res/ellipse.glsl", "gfx/wr/wrench/reftests/boxshadow/box-shadow-spread-shape.png", "gfx/wr/wrench/reftests/clip/clip-superellipse.png", "gfx/wr/wrench/reftests/mask/shaped-corners-inset.png", "gfx/wr/wrench/reftests/mask/shaped-corners-outset.png"], "git_node": "3eafc4cf0bd4c3c3eadb23505bcf1eef38e36a5b", "git_parents": ["cdbda8a2ec98e0a55546a33572983737dfdb88ca"], "node": "8b2863256c7286b0b0f9786cc632043b1bba072e", "parents": ["9687b89c94d4d3166f8165cba266e1858b7a8f95"], "tags": []}, {"author": "R\u00e9mi Papilli\u00e9 \u003crpapillie@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047627 - Add support for CSS corner-shape in borders. r=gfx-reviewers,nical\n\nAdd support for corner-shape for most types of borders. The same shader is also\nused for outlines, and sometimes to draw rounded rects (see bug 1694269).\n\nAll border types are supported exept dotted and dashed. These are left as\nfuture work.\n\nSome other extreme edge cases (such as when corners overlap) are also not\nhandled correctly yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317058\n", "files": ["gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/cs_border_solid.glsl", "gfx/wr/wrench/reftests/border/border-shape-2.png", "gfx/wr/wrench/reftests/border/border-shape-2.yaml", "gfx/wr/wrench/reftests/border/border-shape-3.png", "gfx/wr/wrench/reftests/border/border-shape-3.yaml", "gfx/wr/wrench/reftests/border/border-shape-4.png", "gfx/wr/wrench/reftests/border/border-shape-4.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape-inset.yaml", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/border-shape.yaml", "gfx/wr/wrench/reftests/border/reftest.list", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-superellipse.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-100.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-inf.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini"], "git_node": "6bc9076b4919a615fb15ae1e3e22058dbe02c7e5", "git_parents": ["3eafc4cf0bd4c3c3eadb23505bcf1eef38e36a5b"], "node": "f52d3aaec7de79f70390fd6f1404fa4971c19a77", "parents": ["8b2863256c7286b0b0f9786cc632043b1bba072e"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2047627: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["widget/ThemeDrawing.cpp"], "git_node": "5900f3e66da39517ce00561ccd77bf4d91e234a7", "git_parents": ["6bc9076b4919a615fb15ae1e3e22058dbe02c7e5"], "node": "3ab8c553d984a9ab0d71df819dbb44a5a002ffe8", "parents": ["f52d3aaec7de79f70390fd6f1404fa4971c19a77"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025793 - Bundle newtab JSX/SCSS files during mach build and remove from tree r=mconley,sylvestre,firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289821\n", "files": [".gitignore", ".hgignore", "CLOBBER", "browser/extensions/moz.configure", "browser/extensions/newtab/.npmrc", "browser/extensions/newtab/addon-jar.mn", "browser/extensions/newtab/bin/try-runner.js", "browser/extensions/newtab/build-newtab-bundles.py", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/vendor.bundle.js", "browser/extensions/newtab/lib/cache.worker.js", "browser/extensions/newtab/moz.build", "browser/extensions/newtab/package-lock.json", "browser/extensions/newtab/webext-glue/moz.build", "browser/extensions/newtab/webpack.system-addon.config.js", "taskcluster/kinds/build-extensions/kind.yml", "taskcluster/kinds/build/kind.yml", "toolkit/content/license.html", "tools/lint/rejected-words.yml"], "git_node": "23d2aab4c1e0398575525462234903b8fc08e124", "git_parents": ["5900f3e66da39517ce00561ccd77bf4d91e234a7"], "node": "28e26cb513c05c1e8cc86e2b3f9bdcd62628b7b5", "parents": ["3ab8c553d984a9ab0d71df819dbb44a5a002ffe8"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2061551 - Remove the unused nsDataModule.cpp. r=necko-reviewers,valentin DONTBUILD\n\nThere are no references to it anywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316968\n", "files": ["netwerk/protocol/data/nsDataModule.cpp"], "git_node": "f6472e558ce539b708217c97712d1d52e5bf363a", "git_parents": ["23d2aab4c1e0398575525462234903b8fc08e124"], "node": "1d7be2eb22feb57d5b7b20e36d7359d064b6535c", "parents": ["28e26cb513c05c1e8cc86e2b3f9bdcd62628b7b5"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2058615 - Part 1: Call state-\u003ereject handler in case of over-recursion. r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316025\n", "files": ["js/loader/ModuleLoaderBase.cpp", "js/src/vm/Modules.cpp"], "git_node": "076865575a6c38b5034428d9c60e12dff304ffa0", "git_parents": ["f6472e558ce539b708217c97712d1d52e5bf363a"], "node": "c338a2c1c8d3695b7dec835125af624282555b7e", "parents": ["1d7be2eb22feb57d5b7b20e36d7359d064b6535c"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061652 - Remove obsolete MOZ_create_context_provoking_vertex_dont_care support r=gfx-reviewers,nical\n\nThis extension appears to have originally been added as a local patch\nto ANGLE in bug 1492723. This patch was dropped when ANGLE was later\nupdated in bug 1520948 which added upstream support for\nGL_ANGLE_provoking_vertex. Webrender has long since made use of the\nupstream extension, and the remaining\nMOZ_create_context_provoking_vertex_dont_care related code is now\ndead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317032\n", "files": ["gfx/gl/GLContextProviderEGL.cpp", "gfx/gl/GLContextTypes.h", "gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h", "gfx/webrender_bindings/RenderThread.cpp"], "git_node": "9353276db4df61e1cc7af8ce96c08a2197555aff", "git_parents": ["076865575a6c38b5034428d9c60e12dff304ffa0"], "node": "4fda1bf2190e38c473f93c3691b5d87d48757687", "parents": ["c338a2c1c8d3695b7dec835125af624282555b7e"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061652 - Select first vertex convention if appropriate for accelerated canvas. r=gfx-reviewers,nical\n\nAccelerated canvas' blur shader contains flat varyings. When ANGLE is\nrunning on top of Metal or D3D this requires expensive emulation of\nOpenGL's default last vertex convention on top of the native APIs'\nfirst vertex convention.\n\nThe blur shader is actually provoking vertex agnositic. Therefore we\nshould query whether the extension WEBGL_provoking_vertex is\navailable, and if so call ProvokingVertex(FirstVertex). We already do\nthe equivalent in webrender.\n\nNote we must now ensure going forward that all shaders used by\naccelerated canvas continue to be provoking vertex agnostic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317033\n", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": "6a61cc38bd4e5f290476684342b28423857038af", "git_parents": ["9353276db4df61e1cc7af8ce96c08a2197555aff"], "node": "4d2c10c4a12b2b7e1c8d49bfdc482f951078e92d", "parents": ["4fda1bf2190e38c473f93c3691b5d87d48757687"], "tags": []}, {"author": "hsingh-moz \u003c105445818+hsingh-moz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2059183: Fixing storage usage for persisted origins.#dom-storage-reviewers r=asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316888\n", "files": ["dom/quota/ActorsParent.cpp", "dom/quota/test/xpcshell/test_estimateOrigin.js"], "git_node": "beffc966753e06037315d792d5973feef88b52a0", "git_parents": ["6a61cc38bd4e5f290476684342b28423857038af"], "node": "afdd0c2933c69698d0f886d965d304e40db2c393", "parents": ["4d2c10c4a12b2b7e1c8d49bfdc482f951078e92d"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2025793 - Bundle newtab JSX/SCSS files during mach build and remove from tree r=mconley,sylvestre,firefox-build-system-reviewers,ahochheiden\" for causing bustages at /newtab-node-modules\n\nThis reverts commit 23d2aab4c1e0398575525462234903b8fc08e124.\n", "files": [".gitignore", ".hgignore", "CLOBBER", "browser/extensions/moz.configure", "browser/extensions/newtab/.npmrc", "browser/extensions/newtab/addon-jar.mn", "browser/extensions/newtab/bin/try-runner.js", "browser/extensions/newtab/build-newtab-bundles.py", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/vendor.bundle.js", "browser/extensions/newtab/lib/cache.worker.js", "browser/extensions/newtab/moz.build", "browser/extensions/newtab/package-lock.json", "browser/extensions/newtab/webext-glue/moz.build", "browser/extensions/newtab/webpack.system-addon.config.js", "taskcluster/kinds/build-extensions/kind.yml", "taskcluster/kinds/build/kind.yml", "toolkit/content/license.html", "tools/lint/rejected-words.yml"], "git_node": "0567affd3536fd037fba91b1699b96aafde7aa15", "git_parents": ["beffc966753e06037315d792d5973feef88b52a0"], "node": "9d2d1d8f3877aad63daaaa154b0b084d88197bc4", "parents": ["afdd0c2933c69698d0f886d965d304e40db2c393"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1998331: Making button element selectable by default r=dholbert,firefox-style-system-reviewers,emilio,devtools-reviewers,layout-reviewers,dshin,nchevobbe\" for causing mochitest failures @ browser_text_selection.js\n\nThis reverts commit 042bed283e8c970ce18461810a8941a287182139.\n", "files": ["accessible/tests/browser/mac/browser_text_selection.js", "devtools/client/themes/webconsole.css", "devtools/server/tests/browser/browser_accessibility_node.js", "devtools/server/tests/browser/browser_accessibility_node_events.js", "layout/base/tests/test_caret_browsing_around_form_controls.html", "layout/style/res/forms.css", "testing/web-platform/tests/css/css-ui/tentative/button-user-select.html"], "git_node": "0f6710abe46c1870788a2fe6cb5941a4139f5bab", "git_parents": ["0567affd3536fd037fba91b1699b96aafde7aa15"], "node": "32b9595c1fc6bf32e1b0d4ed10c3d2a1900dccde", "parents": ["9d2d1d8f3877aad63daaaa154b0b084d88197bc4"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2061612 - Migrate the navigation toolbar related UI tests to the efficiency framework r=jajohnson\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317043\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NavigationToolbarTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/NavigationToolbarExpandedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/NavigationToolbarTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/ToolbarTest.kt"], "git_node": "e7a0b5874f5e69441d9161a91211f3adeefe5c82", "git_parents": ["0f6710abe46c1870788a2fe6cb5941a4139f5bab"], "node": "743dc021dd7ffef3505c3f8b023bf18d2fc91fb2", "parents": ["32b9595c1fc6bf32e1b0d4ed10c3d2a1900dccde"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054481 - Fix missing sidebar custom theme outline color with Nova enabled. r=rpl,desktop-theme-reviewers,emilio,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305351\n", "files": ["browser/themes/shared/sidebar.css", "toolkit/components/extensions/test/browser/browser.toml", "toolkit/components/extensions/test/browser/browser_ext_themes_sidebars.js"], "git_node": "71eedb78eb0ad3d5877b792f95059b6b027c5d3e", "git_parents": ["e7a0b5874f5e69441d9161a91211f3adeefe5c82"], "node": "a096efefb64d940b5d1e3591de4d7c48b36bdac1", "parents": ["743dc021dd7ffef3505c3f8b023bf18d2fc91fb2"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061487 - Stop recording SEARCH_SERVICE_COUNTRY_FETCH_* to legacy telemetry. r=daleharvey,TravisLong\n\nAlso removes test_location_timeout_xhr.js because it isn't listed in an xpcshell.toml file and also duplicates a test in test_Region.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316928\n", "files": ["toolkit/components/search/tests/xpcshell/head_search.js", "toolkit/components/search/tests/xpcshell/test_location_timeout_xhr.js", "toolkit/components/telemetry/Histograms.json", "toolkit/components/telemetry/histogram-allowlists.json", "toolkit/modules/gecko_metrics.yaml", "toolkit/modules/tests/xpcshell/test_Region.js"], "git_node": "7b15e34863cf6b30b613ffadf9d6431fe5a55585", "git_parents": ["71eedb78eb0ad3d5877b792f95059b6b027c5d3e"], "node": "341517e50536e16d5b35f304a8e290365dfdfa45", "parents": ["a096efefb64d940b5d1e3591de4d7c48b36bdac1"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059717 - Update gleam to provide ARB/EXT_base_instance extension. r=gfx-reviewers,supply-chain-reviewers,ahale\n\nUpdate gleam to include https://github.com/servo/gleam/pull/235,\nadding bindings for ARB_base_instance/EXT_base_instance extensions.\n\nUnfortunately this gleam PR cannot be merged until gl_generator merges\nhttps://github.com/rust-windowing/gl-rs/pull/566 and releases a new\nversion. Without the gl_generator fix, arm32 profile-generate builds\ntake hours due to what is presumably a rustc/LLVM bug.\n\nIn the meantime, use [patch.crates-io] to vendor specific git\nrevisions of gl_generator and gleam including the required fixes. Once\nboth the gl_generator and gleam pull requests have been merged and new\nversions of the respective crates have been published, we should\nswitch back to using the crates.io versions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316861\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "gfx/wr/Cargo.lock", "gfx/wr/Cargo.toml", "gfx/wr/swgl/src/swgl_fns.rs", "supply-chain/audits.toml", "supply-chain/config.toml", "third_party/rust/gl_generator/.cargo-checksum.json", "third_party/rust/gl_generator/.cargo_vcs_info.json", "third_party/rust/gl_generator/Cargo.toml", "third_party/rust/gl_generator/Cargo.toml.orig", "third_party/rust/gl_generator/generators/struct_gen.rs", "third_party/rust/gleam/.cargo-checksum.json", "third_party/rust/gleam/.cargo_vcs_info.json", "third_party/rust/gleam/Cargo.lock", "third_party/rust/gleam/Cargo.toml", "third_party/rust/gleam/Cargo.toml.orig", "third_party/rust/gleam/README.md", "third_party/rust/gleam/build.rs", "third_party/rust/gleam/src/gl.rs", "third_party/rust/gleam/src/gl_fns.rs", "third_party/rust/gleam/src/gles_fns.rs", "third_party/rust/khronos_api/.cargo-checksum.json", "third_party/rust/khronos_api/.cargo_vcs_info.json", "third_party/rust/khronos_api/Cargo.toml", "third_party/rust/khronos_api/Cargo.toml.orig"], "git_node": "05e438d7ec85aa94abf2ded5142e9b4668c36545", "git_parents": ["7b15e34863cf6b30b613ffadf9d6431fe5a55585"], "node": "e807d63ee83f373e2aba127bcf6a87d41a772ab5", "parents": ["341517e50536e16d5b35f304a8e290365dfdfa45"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059717 - Share instance buffers between webrender draw calls. r=gfx-reviewers,ahale\n\nAdds a \"shared instance buffer\" mode to webrender, where rather than\neach VAO owning its own instance buffer ID which is reallocated on\nevery draw call, we use a single fixed-size instance buffer shared\nbetween all VAOs. Prior to each draw, instance data is written to the\nnext free location in the buffer using an unsynchronized mapping, then\nthe draw is performed by calling\nglDrawElementsInstancedBaseInstance(), ensuring instance data is read\nfrom the correct offset.\n\nWhen the buffer is full, a new one is allocated and the offset is\nreset to zero. The existing chunking mechanism is used to ensure that\ninstance data never exceeds the fixed buffer size.\n\nThis mode can be enabled via WebRenderOptions's\nenable_shared_instance_buffer flag, which is hooked up to the pref\n\"gfx.webrender.shared-instance-buffer\". It additionally requires\nARB_base_instance or EXT_base_instance OpenGL support.\n\nTesting shows this significantly reduces buffer allocation overhead\nduring draw calls on Metal ANGLE, but is net a performance loss on\nWindows, and either a slight win or neutral on other platforms. We\ntherefore enable it everywhere but Windows for now. This can be\ntweaked if we receive reports of correctness or performance issues on\ncertain platforms.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316862\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/vertex.rs", "gfx/wr/wrench/src/wrench.rs", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "3154f11044d1f3fc4e56b688f19dfdcb70400584", "git_parents": ["05e438d7ec85aa94abf2ded5142e9b4668c36545"], "node": "6f16d0ac376a589cea004e5c2fe3dc691cbfa684", "parents": ["e807d63ee83f373e2aba127bcf6a87d41a772ab5"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054117 - Add logging for EditContext. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316897\n", "files": ["dom/base/DOMRect.cpp", "dom/base/DOMRect.h", "dom/html/EditContext.cpp", "dom/html/EditContext.h"], "git_node": "1d687a62c601db4fda744e2b715d291911b6cf4a", "git_parents": ["3154f11044d1f3fc4e56b688f19dfdcb70400584"], "node": "14872e27da218aeae1c432536405c011146d7fc4", "parents": ["6f16d0ac376a589cea004e5c2fe3dc691cbfa684"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054775 - Use content Blob URL for context menu. r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316753\n", "files": ["browser/actors/ContextMenuChild.sys.mjs", "browser/actors/ContextMenuParent.sys.mjs", "browser/base/content/nsContextMenu.sys.mjs", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl"], "git_node": "fdaa5b266fee5fd71711910b83a6d62c4b583fe1", "git_parents": ["1d687a62c601db4fda744e2b715d291911b6cf4a"], "node": "2fd15c90f77e131ac0d5f4ca3a8494e283055136", "parents": ["14872e27da218aeae1c432536405c011146d7fc4"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057277 - Backfill history grid preview images for filtered searches r=tetchart\n\nFiltered history searches go through `nsINavHistory`, which does not expose `preview_image_url`. Attempt to backfill them from `moz_places`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316230\n", "files": ["browser/components/aiwindow/models/SearchBrowsingHistory.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_SearchBrowsingHistory.js"], "git_node": "95c544439d2316b9c669a35e6c61e304534d8f78", "git_parents": ["fdaa5b266fee5fd71711910b83a6d62c4b583fe1"], "node": "df6d4d1bb03fe8bbf4c6ea73ed5b702d29fa9f00", "parents": ["2fd15c90f77e131ac0d5f4ca3a8494e283055136"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058873 - Re-enable ordering for microsurvey answers r=android-reviewers,twhite\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316637\n", "files": ["mobile/android/android-components/components/service/nimbus/messaging.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/microsurvey/ui/ext/MicrosurveyUIData.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/microsurvey/ui/ext/MicrosurveyUIDataTest.kt"], "git_node": "435bf58f5aa4c1746758a315e711f447e0631b0b", "git_parents": ["95c544439d2316b9c669a35e6c61e304534d8f78"], "node": "2200afda8a84b633e61b39656d8a73d6708c742c", "parents": ["df6d4d1bb03fe8bbf4c6ea73ed5b702d29fa9f00"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047733 - Add share button to tab groups r=android-reviewers,android-l10n-reviewers,parker,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314983\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupCardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupListTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupsPageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabstray/ui/tabitems/TabGroupOnboardingItemTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/ExpandedTabGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupCard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabManagementFeatureHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/SharedTabItemUi.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/NormalTabsPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/PrivateTabsPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabGroupList.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabGroupsPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayout.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabstray/TabsTray.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ExpandedTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayoutTest.kt"], "git_node": "57362659304d6039b5b40c0f865589622a5252c9", "git_parents": ["435bf58f5aa4c1746758a315e711f447e0631b0b"], "node": "ed6fc084c5951c214646057bc85550d2e4b69db7", "parents": ["2200afda8a84b633e61b39656d8a73d6708c742c"], "tags": []}, {"author": "calu \u003ccalu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047731 - Customize tab group share sheet r=android-reviewers,android-l10n-reviewers,parker,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314984\n", "files": ["mobile/android/android-components/components/support/ktx/src/main/java/mozilla/components/support/ktx/android/content/Context.kt", "mobile/android/android-components/components/support/ktx/src/test/java/mozilla/components/support/ktx/android/content/ContextTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/ShareSheetLauncher.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/usecases/ShareUseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareCloseView.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/share/ShareFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/ExpandedTabGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/controller/TabManagerController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/main/res/layout/share_close.xml", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/usecases/ShareUseCasesTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/usecases/fake/FakeShareSheetLauncher.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ExpandedTabGroupTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabstray/controller/DefaultTabManagerControllerTest.kt"], "git_node": "41c49a0d6b853b8865a312608dacdfa2fc5369b4", "git_parents": ["57362659304d6039b5b40c0f865589622a5252c9"], "node": "7b7dc0d662592a4f464cb923f7976d998fd30e27", "parents": ["ed6fc084c5951c214646057bc85550d2e4b69db7"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059369 - Add isBrowserAutomation argument to startAtRuntime helpers r=Sasha,smaug\n\nWith this isBrowserAutomation argument, we can decide whether to flip navigator.webdriver or not.\nIf users manually started the browser and are using any automation but still want to connect to tools\nrelying on our remote agent commands and events, navigator.webdriver should be false.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314050\n", "files": ["dom/base/Navigator.cpp", "dom/ipc/ContentParent.cpp", "remote/components/Marionette.sys.mjs", "remote/components/RemoteAgent.sys.mjs", "remote/components/nsIMarionette.idl", "remote/components/nsIRemoteAgent.idl"], "git_node": "69b1870f5e87db4f1bc84dc8b8397ff2bea24f03", "git_parents": ["41c49a0d6b853b8865a312608dacdfa2fc5369b4"], "node": "2c91b4c98cba35a05893c87513665a5471853fd7", "parents": ["7b7dc0d662592a4f464cb923f7976d998fd30e27"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061549 - Schedule the Gradle plugin tests when their shared build inputs change. r=geckoview-reviewers,ohall\n\nBoth plugin builds resolve dependencies through the top-level version catalog and run against the\nversion of Gradle pinned by the wrapper, but neither file appeared in `files-changed`. Bumping AGP,\nspotless, google-java-format or Gradle itself therefore left these tasks unscheduled, so a bump that\nbroke either plugin build would only show up once something else happened to trigger them.\n\nSort each list alphabetically while here, since the entries were in no particular order.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316976\n", "files": ["taskcluster/kinds/source-test/android-gradle-plugins.yml"], "git_node": "da596a4296d7c8134b9e41b698676e12ddbb146e", "git_parents": ["69b1870f5e87db4f1bc84dc8b8397ff2bea24f03"], "node": "691e2f8bf778319bf56af7c5d8dd9791c5a46b48", "parents": ["2c91b4c98cba35a05893c87513665a5471853fd7"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061549 - Make the apilint plugin test tasks skippable. r=geckoview-reviewers,ohall\n\nThe five Python test suites were bare `Exec` tasks with no declared inputs or outputs, so Gradle had to\nre-run all of them on every invocation. Declare the scripts and fixtures they read as inputs, and give\neach suite a private output directory: a task with inputs but no outputs is never up to date, and an\nempty directory is enough for Gradle to snapshot.\n\nTwo suites were already writing real artifacts to places nothing declared. `apilint_test.py` put 64\nresult files straight into the build directory, and the doclet test generated its API into `build/tmp`,\nwhich is Gradle's own scratch space. Pointing both at their task's output directory brings those files\nunder the snapshot and out of directories they do not own.\n\nThe suites import the scripts they exercise, so Python writes bytecode caches into\n`src/main/resources`. Those are ignored build artifacts rather than inputs, and snapshotting them cost\nan extra re-run of every suite after each script change, so exclude them from the input trees.\n\nA repeat `test` invocation now reports everything up to date rather than re-running the suites. Each\nsuite still re-runs when the script under test, its fixtures, or the doclet jar change. These stay\nuncacheable: `Exec` opts out of the build cache, and caching a suite that produces nothing the build\nconsumes would not buy anything.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316977\n", "files": ["mobile/android/gradle/plugins/apilint/apidoc-plugin/build.gradle.kts", "mobile/android/gradle/plugins/apilint/apilint/build.gradle.kts"], "git_node": "ee9ed825d379d6190467c2ab39729b2bfb4114ec", "git_parents": ["da596a4296d7c8134b9e41b698676e12ddbb146e"], "node": "b679ca2d5fe87d56f8dd5fc752b10f2218e8d27a", "parents": ["691e2f8bf778319bf56af7c5d8dd9791c5a46b48"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061549 - Add tests for the apilint plugin's diff script. r=geckoview-reviewers,ohall\n\n`diff.py` had no tests of its own even though `apidoc_test.py` uses its exit code as the assertion\nthat the doclet produced the expected output. A regression that made it always report \"identical\"\nwould leave the doclet test passing while checking nothing.\n\nCover the exit codes both ways, the diff it prints, and the fact that the suggested command is only\nprinted when the API actually differs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316978\n", "files": ["mobile/android/gradle/plugins/apilint/apilint/build.gradle.kts", "mobile/android/gradle/plugins/apilint/apilint/src/test/resources/diff_test.py"], "git_node": "f39b647c5bc0430e371bd7a7caf91cd20cd4f1a6", "git_parents": ["ee9ed825d379d6190467c2ab39729b2bfb4114ec"], "node": "76ef9ca3d71ab8c7d575ce707b0561b9253bcf72", "parents": ["b679ca2d5fe87d56f8dd5fc752b10f2218e8d27a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061549 - Add unit tests for the apilint Gradle plugin. r=geckoview-reviewers,ohall\n\nThe JVM tests so far cover the task classes and the lint input declarations; nothing covered applying\nthe plugin itself. Add tests for the parts that do not need the Android Gradle plugin: that applying it\nregisters the extension but no tasks until `com.android.library` shows up, and that the extension's\ndocumented defaults hold.\n\nThese also pin down that a `ListProperty` reports as present when unconfigured, which is the behaviour\nthat made the plugin forward empty list options to apilint.py until bug 2059307 fixed it.\n\n`PythonExecTest` covers the interpreter default and that the scripts the tasks run are packaged as\nresources.\n\nThe `helpCommand` cases join the existing default-rendering test rather than starting a second home for\nthem, and add the Groovy closure path, since GeckoView's build script assigns one.\n\nCovering the per-variant task registration needs a real `com.android.library` project, and the Android\nGradle plugin is `compileOnly` so it is absent from the test runtime classpath. That is left for a\nfunctional test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316979\n", "files": ["mobile/android/gradle/plugins/apilint/apilint/src/test/kotlin/org/mozilla/apilint/ApiLintPluginExtensionTest.kt", "mobile/android/gradle/plugins/apilint/apilint/src/test/kotlin/org/mozilla/apilint/ApiLintPluginTest.kt", "mobile/android/gradle/plugins/apilint/apilint/src/test/kotlin/org/mozilla/apilint/PythonExecTest.kt"], "git_node": "61f424a88d97d0ec0f6432212a07eeeef2dc084f", "git_parents": ["f39b647c5bc0430e371bd7a7caf91cd20cd4f1a6"], "node": "6189b0b19531e9b52a567a7fccf2dab4d2e5699f", "parents": ["76ef9ca3d71ab8c7d575ce707b0561b9253bcf72"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054010 - Convert free-text profiler marker fields to unique strings so URLs get sanitized r=mstange,profiler-reviewers,joel\" as requested by dev because it triggers a bug in the profiler front-end\n\nThis reverts commit 155a47cbb7728bcb98a956c4076a313105d87e17.\n", "files": ["browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js", "mozglue/baseprofiler/public/BaseProfilerMarkers.h", "mozglue/tests/TestBaseProfiler.cpp", "toolkit/components/backgroundtasks/tests/browser/browser_xpcom_graph_wait.js", "toolkit/components/telemetry/tests/unit/test_UserInteraction_annotations.js", "tools/profiler/public/FlowMarkers.h", "tools/profiler/tests/gtest/GeckoProfiler.cpp", "tools/profiler/tests/xpcshell/test_addProfilerMarker.js", "xpcom/base/Logging.cpp"], "git_node": "cb4ad277c937f6290d5073398cbf3e0c389aeaec", "git_parents": ["61f424a88d97d0ec0f6432212a07eeeef2dc084f"], "node": "27d6132625eaf32b1db7b39b146e773553fdc462", "parents": ["6189b0b19531e9b52a567a7fccf2dab4d2e5699f"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047627: apply code formatting via Lando\" for causing devtools and mochitests failures\n\nThis reverts commit 5900f3e66da39517ce00561ccd77bf4d91e234a7.\n\nRevert \"Bug 2047627 - Add support for CSS corner-shape in borders. r=gfx-reviewers,nical\"\n\nThis reverts commit 6bc9076b4919a615fb15ae1e3e22058dbe02c7e5.\n\nRevert \"Bug 2047627 - Improve superellipse normal approximation. r=gfx-reviewers,nical\"\n\nThis reverts commit 3eafc4cf0bd4c3c3eadb23505bcf1eef38e36a5b.\n\nRevert \"Bug 2047627 - Fix uninitialized corner shape values in theme drawing. r=gfx-reviewers,nical\"\n\nThis reverts commit cdbda8a2ec98e0a55546a33572983737dfdb88ca.\n", "files": ["gfx/wr/webrender/res/border_shared.glsl", "gfx/wr/webrender/res/cs_border_segment.glsl", "gfx/wr/webrender/res/cs_border_solid.glsl", "gfx/wr/webrender/res/ellipse.glsl", "gfx/wr/wrench/reftests/border/border-shape-2.png", "gfx/wr/wrench/reftests/border/border-shape-2.yaml", "gfx/wr/wrench/reftests/border/border-shape-3.png", "gfx/wr/wrench/reftests/border/border-shape-3.yaml", "gfx/wr/wrench/reftests/border/border-shape-4.png", "gfx/wr/wrench/reftests/border/border-shape-4.yaml", "gfx/wr/wrench/reftests/border/border-shape-inset.png", "gfx/wr/wrench/reftests/border/border-shape-inset.yaml", "gfx/wr/wrench/reftests/border/border-shape.png", "gfx/wr/wrench/reftests/border/border-shape.yaml", "gfx/wr/wrench/reftests/border/reftest.list", "gfx/wr/wrench/reftests/boxshadow/box-shadow-spread-shape.png", "gfx/wr/wrench/reftests/clip/clip-superellipse.png", "gfx/wr/wrench/reftests/mask/shaped-corners-inset.png", "gfx/wr/wrench/reftests/mask/shaped-corners-outset.png", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-notch.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-mixed.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square-notch-superellipse.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-square.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-bevel.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-100.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-negative-inf.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/corner-shape-superellipse-scoop.html.ini", "testing/web-platform/meta/css/css-borders/corner-shape/render-corner-shape.html.ini", "widget/ThemeDrawing.cpp"], "git_node": "510ee1f485644dd6521195bc159652e7a7d46ff2", "git_parents": ["cb4ad277c937f6290d5073398cbf3e0c389aeaec"], "node": "d185d8573e664343f144c69a2ca93ad085872611", "parents": ["27d6132625eaf32b1db7b39b146e773553fdc462"], "tags": []}, {"author": "Jonathan Almeida \u003cjonalmeida942@gmail.com\u003e", "branch": "default", "desc": "Bug 2048869 - Make callers to getAccessToken handle Forbidden requests r=sfamisa,markh,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316282\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/Exceptions.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt", "mobile/android/android-components/components/service/firefox-relay/src/main/java/mozilla/components/service/fxrelay/FxRelay.kt", "mobile/android/android-components/components/service/firefox-relay/src/test/java/mozilla/components/service/fxrelay/FxRelayTest.kt"], "git_node": "78a4bc474136c0056146e6e9eecc187dd18cc029", "git_parents": ["510ee1f485644dd6521195bc159652e7a7d46ff2"], "node": "5ec263d82a95b52451663b48bc7c93c12c938069", "parents": ["d185d8573e664343f144c69a2ca93ad085872611"], "tags": []}, {"author": "isabelrios \u003cisabelrios@gmail.com\u003e", "branch": "default", "desc": "Bug 2060521 - [efficiency] Convert DownloadFileTypesTest.allFilesAppearInDownloadsMenuTest to ui/efficiency r=jajohnson,aaronmt\n\nFaithful port of the legacy DownloadFileTypesTest smoke test, keeping the parameterized\nrun over all nine file types (zip, docx, mp3, txt, png, webm, csv, xml, svg) as one\n@SmokeTest method rather than reducing coverage.\n\nHarness capability added by this port:\n\n- SelectorStrategy.UIAUTOMATOR2_BY_DESCRIPTION_CONTAINS (By.descContains). Each download\n  link on the test page renders as a pair: a clickable node carrying the\n  content-description, and a sibling text node with the same string that is not clickable.\n  A textContains match resolved the inert twin, so the click reported success and did\n  nothing. UiObject's clickAndSync compounds this by reporting failure when no window\n  update arrives within ~5.5s, which a download routinely exceeds; UiObject2 leaves the\n  waiting to the caller.\n\n- The download dialog's confirm button needs a device-level tap. It is a FilledButton with\n  no testTag (RenameAndChangeLocationDialogContent.DialogActionButtons), and every Compose\n  strategy tried -- unmerged, merged, and merged+hasClickAction -- resolved a node and\n  reported a successful click while the dialog stayed open.\n\n- BrowserPage -\u003e DownloadsPage navigation edge through the browser three-dot menu. Routing\n  browser -\u003e home -\u003e downloads would lose the loaded page.\n\n- Optional effdump.url argument on EffScreenDumpRunner, so a screen dump can be taken on a\n  specific test page instead of the default example.com. This is what identified both\n  selector problems above from ground truth rather than guesswork.\n\nDeviation from legacy: the test loads the local mockWebServer downloads.html asset instead\nof https://storage.googleapis.com/mobile_test_assets/test_app/downloads.html, so it no\nlonger depends on external network -- over the real network the dialog and completion\nsnackbar exceeded 25s often enough to fail a different subset of the nine on every run.\nThe asset was extended from three file types to the same nine the legacy test covers;\nvideoSample.webm is a copy of the existing dom/media/test/av1-yuv422p10.webm fixture.\nNote this local copy will not track the QA-owned remote page if that page gains file types.\n\nVerified: 9/9 parameterized cases pass, 0 skipped. Shared-selector changes re-verified\nagainst the two existing efficiency tests that use DownloadsSelectors --\nSettingsDeleteBrowsingDataOnQuitTest is fully green and MainMenuTest's download flow\npasses. MainMenuTest's 5 other failures (Print, Save as PDF, Add to home screen, Open in\napp, Translate) were confirmed pre-existing by re-running one of them against an\nunmodified tree.\n\nRe-land after backout in 3a2f808d5416 for CustomTabsTest failures. Bug 2060346 landed\nduring the review window and moved verifyDownloadInACustomTabTest from the remote QA page\nonto the local downloads.html asset, hardcoding web_icon.png -- which this patch renames\nto png_image.png. This version updates that reference, and the stale names inside the new\nxml_file.xml payload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316272\n", "files": ["mobile/android/fenix/app/src/androidTest/assets/pages/audioMediaPage.html", "mobile/android/fenix/app/src/androidTest/assets/pages/downloads.html", "mobile/android/fenix/app/src/androidTest/assets/resources/audioSample.mp3", "mobile/android/fenix/app/src/androidTest/assets/resources/csv_file.csv", "mobile/android/fenix/app/src/androidTest/assets/resources/docx_document.docx", "mobile/android/fenix/app/src/androidTest/assets/resources/mp3_audio.mp3", "mobile/android/fenix/app/src/androidTest/assets/resources/png_image.png", "mobile/android/fenix/app/src/androidTest/assets/resources/smallZip.zip", "mobile/android/fenix/app/src/androidTest/assets/resources/svg_image.svg", "mobile/android/fenix/app/src/androidTest/assets/resources/textfile.txt", "mobile/android/fenix/app/src/androidTest/assets/resources/txt_file.txt", "mobile/android/fenix/app/src/androidTest/assets/resources/web_icon.png", "mobile/android/fenix/app/src/androidTest/assets/resources/webm_video.webm", "mobile/android/fenix/app/src/androidTest/assets/resources/xml_file.xml", "mobile/android/fenix/app/src/androidTest/assets/resources/zip_small.zip", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/DownloadFileTypesTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/DownloadTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/devtools/EffScreenDumpRunner.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/Selector.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/DownloadsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/DownloadsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CustomTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/DownloadFileTypesTest.kt"], "git_node": "79227c0719ff9fb2e62bab15e74fa58d7dff47c6", "git_parents": ["78a4bc474136c0056146e6e9eecc187dd18cc029"], "node": "9cc944195cc3368fd94d3828f8c55cd35b3a6603", "parents": ["5ec263d82a95b52451663b48bc7c93c12c938069"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046602: Make view-timeline-inset part of the view-timeline shorthand. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,emilio,boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316759\n", "files": ["servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/values/generics/animation.rs", "testing/web-platform/meta/scroll-animations/css/view-timeline-shorthand.html.ini"], "git_node": "de088c7a6bd87ecbb1562c2b2794df47044a6ad4", "git_parents": ["79227c0719ff9fb2e62bab15e74fa58d7dff47c6"], "node": "91d9d9d66765b19a5dfb0af523338e9e09ad031b", "parents": ["9cc944195cc3368fd94d3828f8c55cd35b3a6603"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060569 - Move top sites listener to UrlbarParentController. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316281\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/actors/UrlbarParent.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser/browser_queryContextCache.js"], "git_node": "daec77b6eba3193256b6e3142d33514f45ea8046", "git_parents": ["de088c7a6bd87ecbb1562c2b2794df47044a6ad4"], "node": "0d84e6f69170d87112857092575d614e471ad28f", "parents": ["91d9d9d66765b19a5dfb0af523338e9e09ad031b"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "bug 2060240 - Put the Assert autoclass :members: list on a single line so all members are documented r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nThe `testing/assert` docs only rendered a subset of `Assert` methods after the RST-\u003eMarkdown conversion (bug 2038819).\n\nIn MyST Markdown a directive option (`:name: value`) must be on a single line. When the value wraps onto an indented continuation line, MyST silently drops the continuation into the directive body instead of the option. The `:members:` list for the `{js:autoclass} Assert` directive spanned three lines, so only the first line (`ok`..`notDeepEqual`) was passed as `:members:`; the remaining explicit members and, crucially, the `*` wildcard were dropped, which is why only a subset of methods appeared.\n\nFix: put the entire `:members:` list on one line. Verified with the MyST parser that the option now captures all 16 entries (including `*`) with no leftover body content.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316223\n", "files": ["testing/docs/assert.md"], "git_node": "621bde39bf283a5bdda0b8859060434a5b80e46a", "git_parents": ["daec77b6eba3193256b6e3142d33514f45ea8046"], "node": "2903b0bae8c83553bd7e6e0aa58da7a24142b22c", "parents": ["0d84e6f69170d87112857092575d614e471ad28f"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060863 - Move isTextDirectionRTL to UrlbarChild. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316546\n", "files": ["browser/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "af0e172625ba7357e5aa3276ef7a7c374211fac1", "git_parents": ["621bde39bf283a5bdda0b8859060434a5b80e46a"], "node": "916b47d67abd1c038b4c67c581a7159834afc8cf", "parents": ["2903b0bae8c83553bd7e6e0aa58da7a24142b22c"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060705 - Skip the Organize Tabs panel test under test-verify r=flozia\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316937\n", "files": ["browser/components/aiwindow/ui/test/browser/browser.toml"], "git_node": "2bae73d08a0f7f06d585ef73ba8644f41ba032ad", "git_parents": ["af0e172625ba7357e5aa3276ef7a7c374211fac1"], "node": "d792918ed4241c332691156ed7a5fff03e1218c7", "parents": ["916b47d67abd1c038b4c67c581a7159834afc8cf"], "tags": []}, {"author": "Nathan Barrett \u003cnbarrett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2025793 - Bundle newtab JSX/SCSS files during mach build and remove from tree r=mconley,sylvestre,firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D289821\n", "files": [".gitignore", ".hgignore", "CLOBBER", "browser/extensions/moz.configure", "browser/extensions/newtab/.npmrc", "browser/extensions/newtab/addon-jar.mn", "browser/extensions/newtab/bin/try-runner.js", "browser/extensions/newtab/build-newtab-bundles.py", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/vendor.bundle.js", "browser/extensions/newtab/lib/cache.worker.js", "browser/extensions/newtab/moz.build", "browser/extensions/newtab/package-lock.json", "browser/extensions/newtab/webext-glue/moz.build", "browser/extensions/newtab/webpack.system-addon.config.js", "taskcluster/kinds/artifact-build/kind.yml", "taskcluster/kinds/build-extensions/kind.yml", "taskcluster/kinds/build/kind.yml", "taskcluster/kinds/hazard/kind.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "taskcluster/kinds/valgrind/kind.yml", "toolkit/content/license.html", "tools/lint/rejected-words.yml"], "git_node": "d2988abef473dfb23b49543b937402ec50082bfd", "git_parents": ["2bae73d08a0f7f06d585ef73ba8644f41ba032ad"], "node": "0f1fbdb49ddc3894282cee0595b294fd3adb9681", "parents": ["d792918ed4241c332691156ed7a5fff03e1218c7"], "tags": []}, {"author": "Dharma Ong \u003cdharmaong00@gmail.com\u003e", "branch": "default", "desc": "Bug 1979722 - Remove browser.urlbar.deduplication.thresholdDays pref. r=mbeier,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307390\n", "files": ["browser/app/profile/firefox.js", "browser/components/urlbar/UrlbarMuxerStandard.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/tests/browser-results/browser_same_ref_deduplication.js"], "git_node": "252fa86249fa4dee58edcf71f407420a4237dbcb", "git_parents": ["d2988abef473dfb23b49543b937402ec50082bfd"], "node": "bfebfb039bd65dea1e7f92e59053e7b2e3cbbd1b", "parents": ["0f1fbdb49ddc3894282cee0595b294fd3adb9681"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046995: Throw when updateTiming is called with infinite iterations with finite timeline. r=layout-scroll-driven-animation-reviewers,boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316771\n", "files": ["dom/animation/AnimationEffect.cpp", "testing/web-platform/meta/scroll-animations/scroll-timelines/effect-updateTiming.html.ini"], "git_node": "448eec99005679674cdd6f3c212141107a0029b3", "git_parents": ["252fa86249fa4dee58edcf71f407420a4237dbcb"], "node": "5499a3a5a64f26fd8f4969341d3abb971e0397c8", "parents": ["bfebfb039bd65dea1e7f92e59053e7b2e3cbbd1b"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061688 - Disable pdf crypto signature by default in Nightly r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317059\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/pdfjs/PdfJsOverridePrefs.js"], "git_node": "4306336fc970901e0b2f1aad59095a4e6647b660", "git_parents": ["448eec99005679674cdd6f3c212141107a0029b3"], "node": "9414dcb3cb1a599a87f8792ef936052a320c4edb", "parents": ["5499a3a5a64f26fd8f4969341d3abb971e0397c8"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2061492 - Improve twinopen markers. r=perftest-reviewers,aglavic\n\nThe twinopen marker was covering a lot more than the measured time.\nAdd two markers that describe the \"setup\" actions (GC+CC and wait),\nstart the actual twinopen marker after those setup actions, and\nput the measured value into the marker text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316924\n", "files": ["testing/talos/talos/tests/twinopen/api.js"], "git_node": "5f75fb9866754a3e1ce9552cfee830f5aa8af9f9", "git_parents": ["4306336fc970901e0b2f1aad59095a4e6647b660"], "node": "1425b0489f9247ce9a3e39f7c6114370832ac52e", "parents": ["9414dcb3cb1a599a87f8792ef936052a320c4edb"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061436: Protect StorageStatsManager from IOException. r=segunfamisa\n\nWe are seeing odd crashes querying storage for some telemetry. Swallow the exception to avoid crashes in this telemetry path.\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/324\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/StorageStatsMetrics.kt"], "git_node": "2672a7d7037130352592f06a1662f726499a6c7d", "git_parents": ["5f75fb9866754a3e1ce9552cfee830f5aa8af9f9"], "node": "d86e0e5e551d1b3568c47b981a0e3e515991d52a", "parents": ["1425b0489f9247ce9a3e39f7c6114370832ac52e"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 1861924 - Honor the swipe gesture prefs when triggering swipe-to-navigate. r=hiro\n\nSwipe-to-navigate is driven by several events processed in the chrome code,\nas described in the comment in dom/webidl/SimpleGestureEvent.webidl. This\npatch fixes two of those phases.\n\nThe first one is the phase that answers \"Should a swipe really be started,\nand in which directions should the user be able to swipe?\", i.e.\n_shouldDoSwipeGesture() handling MozSwipeGestureMayStart. It used to bail\nout unless browser.gesture.swipe.left was Browser:BackOrBackDuplicate *and*\nbrowser.gesture.swipe.right was Browser:ForwardOrForwardDuplicate, so any\nother combination disabled swipe-to-navigate entirely.\nIt now accepts the swipe as long as at least one of the two prefs is bound\nto a history navigation command, and it computes aEvent.allowedDirections\nfrom what each pref is actually bound to instead of assuming left == back\nand right == forward.\n\nThe second one is the animation phase, where gHistorySwipeAnimation decides\nwhich way the pages move. _willGoBack() and _willGoForward() used to derive\nthe direction from the sign of the swipe amount alone, so the animation\nwould disagree with a non-default binding.\nThey now look up the command bound to the direction being swiped with\ngGestureSupport._getCommand(), the same lookup the other phases use, which is\nwhy updateAnimation() takes the gesture event now.\n\nNote that in both phases the physical direction is mapped through\ngHistorySwipeAnimation.isLTR: for RTL users, the \"left\" and \"right\"\ncommands map to the opposite physical directions.\n\nThe tests cover the combinations that are now allowed to trigger\nswipe-to-navigate:\n\n- left bound to forward and right bound to back, i.e. the reversed\n  combination, checking that both a go-back and a go-forward swipe\n  navigate, in LTR and in RTL.\n- both directions bound to forward, checking that swiping either way goes\n  forward.\n- only one direction bound to a navigation command, checking that the bound\n  direction navigates and the other one does\n- neither direction bound to a navigation command, checking that no swipe\n  navigates.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316679\n", "files": ["browser/base/content/browser-gestureSupport.js", "widget/tests/browser/browser_test_swipe_gesture.js"], "git_node": "2ff1933b1dab29f32deb1eaf8ed268929493cb1d", "git_parents": ["2672a7d7037130352592f06a1662f726499a6c7d"], "node": "f096dca60e6890cbeedcaa46a2fb8a112c4a56d8", "parents": ["d86e0e5e551d1b3568c47b981a0e3e515991d52a"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058626: Check for mutually exclusive flags when deserializing cloned RegExp r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316904\n", "files": ["js/src/jit-test/tests/structured-clone/bug2058626.js", "js/src/vm/StructuredClone.cpp"], "git_node": "730b0878dd352b1d9045db8d21fa66e83ae320e1", "git_parents": ["2ff1933b1dab29f32deb1eaf8ed268929493cb1d"], "node": "aa077284e4d761ab255a9a2645ef89520446bac1", "parents": ["f096dca60e6890cbeedcaa46a2fb8a112c4a56d8"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061414: Don't support Float32 in AddIsANonZeroAdditionOf r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316958\n", "files": ["js/src/jit-test/tests/bug2061414.js", "js/src/jit/MIR.cpp"], "git_node": "fe9725f49624813985f0f1376415dfa11e6ccd23", "git_parents": ["730b0878dd352b1d9045db8d21fa66e83ae320e1"], "node": "ff3c9b9218ce4796060ef123eec5f9c8cb4192f0", "parents": ["aa077284e4d761ab255a9a2645ef89520446bac1"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061321: Handle argument underflow in PBL stack check r=spidermonkey-reviewers,jandem\n\nI'm not including a testcase because this only fails in an ASAN build of PBL, and we don't run those anywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316960\n", "files": ["js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "5e23becf8811bced2cdfb7ba63d2c8e1f3b29c6a", "git_parents": ["fe9725f49624813985f0f1376415dfa11e6ccd23"], "node": "df0c44443323d7be7132a35ceac82fc239c564b9", "parents": ["ff3c9b9218ce4796060ef123eec5f9c8cb4192f0"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061321: Handle argument underflow in PBL stack check r=spidermonkey-reviewers,jandem\" for causing spidermonkey failures\n\nThis reverts commit 5e23becf8811bced2cdfb7ba63d2c8e1f3b29c6a.\n", "files": ["js/src/vm/PortableBaselineInterpret.cpp"], "git_node": "27fe961b3f21820a228fbb2c49f1a7658a404d0e", "git_parents": ["5e23becf8811bced2cdfb7ba63d2c8e1f3b29c6a"], "node": "eea520140e5204a518e08e2a4e0ad97e5caa8375", "parents": ["df0c44443323d7be7132a35ceac82fc239c564b9"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054665 - r=edgar\" for causing Bug 2060748\n\nThis reverts commit 4489638f733deee9539fdcd814414e85bfec802a.\n", "files": ["dom/ipc/BrowserParent.cpp", "widget/nsBaseDragService.cpp"], "git_node": "9d429f8b4bff0aedc6344ffa1d6837d97d61e6b9", "git_parents": ["27fe961b3f21820a228fbb2c49f1a7658a404d0e"], "node": "f3bbe25ddc96516104f4e1ffee87b600b3d1cbe0", "parents": ["eea520140e5204a518e08e2a4e0ad97e5caa8375"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046602: Make view-timeline-inset part of the view-timeline shorthand. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,emilio,boris\" for causing layout related mochitest failures.\n\nThis reverts commit de088c7a6bd87ecbb1562c2b2794df47044a6ad4.\n", "files": ["servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/values/generics/animation.rs", "testing/web-platform/meta/scroll-animations/css/view-timeline-shorthand.html.ini"], "git_node": "1dcc9a592e6f7f4b06a473b40765aa64996d7fad", "git_parents": ["9d429f8b4bff0aedc6344ffa1d6837d97d61e6b9"], "node": "f895691ba757ba842601dc9e6c7fdf8349286697", "parents": ["f3bbe25ddc96516104f4e1ffee87b600b3d1cbe0"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047731 - Customize tab group share sheet r=android-reviewers,android-l10n-reviewers,parker,jdelorenzo\" for causing android build bustages\n\n