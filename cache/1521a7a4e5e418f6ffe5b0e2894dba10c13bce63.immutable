Response.sys.mjs"], "git_node": "c0bc4e330d9dd12226c9784fa83979e9217abf71", "git_parents": ["a10d301b33e2b572fe2b51b8b8ba37d6ea5f6115"], "node": "661a660e5cc39c52d3871ba30f27a64fb757c743", "parents": ["247180e0eba1e5e0a3e0ef1eea65e8224894c113"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 2: Pre-calculate the fallback encoding for the classic script source. r=bthrall,dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314578\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/workers/ScriptLoader.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/script-charset-03.html.ini"], "git_node": "fd0eb6927252ff3dbf261dd927e14b8826eac206", "git_parents": ["c0bc4e330d9dd12226c9784fa83979e9217abf71"], "node": "7b630dc24794ca44de8e013371399b0c11fdcb2c", "parents": ["661a660e5cc39c52d3871ba30f27a64fb757c743"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 3: Use pre-calculated fallback encoding for the in-memory cache key. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314579\n", "files": ["dom/script/ScriptLoader.cpp", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "js/loader/LoadedScript.h"], "git_node": "3173e731bf5aba65d25af591398996042ee7e643", "git_parents": ["fd0eb6927252ff3dbf261dd927e14b8826eac206"], "node": "7eb0bcaa8e1ca899a5a5d4c2f26c1ce8d3a2c5e7", "parents": ["7b630dc24794ca44de8e013371399b0c11fdcb2c"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 4: Use pre-calculated fallback encoding for the classic script disk cache MIME-Type. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314580\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "07b098aa0decb8ba9e07e96195cf47cd768a9644", "git_parents": ["3173e731bf5aba65d25af591398996042ee7e643"], "node": "bd1ca4c031895d1572f79d8834abde1b81db06c1", "parents": ["7eb0bcaa8e1ca899a5a5d4c2f26c1ce8d3a2c5e7"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 5: Add tests. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314581\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset.sjs", "dom/base/test/head.js"], "git_node": "7bb924079862d7bab5c3be822354f2ab3ae63687", "git_parents": ["07b098aa0decb8ba9e07e96195cf47cd768a9644"], "node": "306fe81d0b0424c52032b6957ff2cc6476112899", "parents": ["bd1ca4c031895d1572f79d8834abde1b81db06c1"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2056134: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.h"], "git_node": "1abc6298e106c4ef94528857a4d7120d162a786f", "git_parents": ["7bb924079862d7bab5c3be822354f2ab3ae63687"], "node": "6b54c56d6da8f31fe2a445ac2db5cffd8cd848e7", "parents": ["306fe81d0b0424c52032b6957ff2cc6476112899"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2059540 - Convert QuotaManager::RecordShutdownStep debug tracing to MOZ_LOG r=dom-storage-reviewers,janv\n\nWe see this warning millions of time every day in the CI\n\nRecordShutdownStep emitted every recorded shutdown step through\nNS_DebugBreak(NS_DEBUG_WARNING, ...) under #ifdef DEBUG, with an in-tree\ncomment noting this was not the right mechanism. Each shutdown step of every\nquota client therefore became an unconditional WARNING: line, and these\ndominate the warning counts of debug test runs while not describing a defect.\n\nUse the existing QuotaManager log module via QM_LOG/QM_LOG_TEST instead, which\nis already used unconditionally elsewhere in this file. The tracing is now\nopt-in with MOZ_LOG=QuotaManager:4 and available in all build configurations.\nThe shutdown steps remain recorded in mShutdownSteps and are still reported\nthrough the QuotaManagerShutdownTimeout crash annotation, so diagnosing\nshutdown hangs is unaffected.\n\nThis also fixes an operator precedence bug introduced in bug 1588512 when\naClientType became a Maybe\u003cClient::Type\u003e: + binds tighter than ?:, so\n\" shutdown step\" was concatenated onto the else branch only and a client-type\nstep was labelled \"idb\" rather than \"idb shutdown step\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315391\n", "files": ["dom/quota/ActorsParent.cpp"], "git_node": "cef8d49c715a2dd907c6710a2e794ee9ebd5d262", "git_parents": ["1abc6298e106c4ef94528857a4d7120d162a786f"], "node": "c6fc63d9be443757fada37f6890f404da6c926e8", "parents": ["6b54c56d6da8f31fe2a445ac2db5cffd8cd848e7"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058878 - Remove skip-if==nova for already fixed tests r=Gijs,aryx,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314884\n", "files": ["browser/base/content/test/performance/browser.toml", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/customizableui/test/browser.toml", "browser/components/places/tests/browser/browser.toml", "dom/events/test/clipboard/browser.toml", "dom/tests/mochitest/chrome/chrome.toml", "toolkit/components/windowwatcher/test/browser.toml"], "git_node": "9644cf122c906f8f3e9a79fda3c0b500363b0ed9", "git_parents": ["cef8d49c715a2dd907c6710a2e794ee9ebd5d262"], "node": "d054ba0fbafb5ca58462f3eb4c7bbdad14c4b598", "parents": ["c6fc63d9be443757fada37f6890f404da6c926e8"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058878 - Remove skip-if==nova for more fixed browser tests r=omc-reviewers,aminomancer,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315032\n", "files": ["browser/components/aboutwelcome/tests/browser/browser.toml", "browser/components/screenshots/tests/browser/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "toolkit/components/printing/tests/browser.toml"], "git_node": "5c71e13bfe869046bf1e9d4e90273a5f4636178d", "git_parents": ["9644cf122c906f8f3e9a79fda3c0b500363b0ed9"], "node": "1b357761b2f45d266804fa7652c16d0e3e506031", "parents": ["d054ba0fbafb5ca58462f3eb4c7bbdad14c4b598"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["toolkit/components/taskscheduler/TaskSchedulerWinMSIXImpl.sys.mjs", "toolkit/components/taskscheduler/nsIWinBackgroundTaskRegistrar.idl", "toolkit/components/taskscheduler/rust/Cargo.toml", "toolkit/components/taskscheduler/rust/src/WinBackgroundTaskRegistrar.h", "toolkit/components/taskscheduler/rust/src/lib.rs", "toolkit/mozapps/msixcomserver-rust/Cargo.toml", "toolkit/mozapps/msixcomserver-rust/moz.build", "toolkit/mozapps/msixcomserver-rust/src/lib.rs", "toolkit/mozapps/msixcomserver/moz.build", "toolkit/mozapps/msixcomserver/msixcomserver.cpp", "toolkit/mozapps/msixcomserver/msixcomserver.def"], "git_node": "f52f6a576908bfa041b2092d87869e9628c4b596", "git_parents": ["5c71e13bfe869046bf1e9d4e90273a5f4636178d", "fdd583cd5a10d051053acda8b760c3bd5d800034"], "node": "63f86aea6753008ff1bda375cbcaaf2a6c73cb2d", "parents": ["1b357761b2f45d266804fa7652c16d0e3e506031", "47f3b1d601409c7cd2c5dee876eaef22b18ae9d5"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2056792 - Introduce CleanupWeakRefs for remaining list types r=dholbert,firefox-svg-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313922\n", "files": ["dom/svg/DOMSVGLengthList.cpp", "dom/svg/DOMSVGLengthList.h", "dom/svg/DOMSVGNumber.cpp", "dom/svg/DOMSVGNumber.h", "dom/svg/DOMSVGNumberList.cpp", "dom/svg/DOMSVGNumberList.h", "dom/svg/DOMSVGPointList.cpp", "dom/svg/DOMSVGPointList.h", "dom/svg/DOMSVGTransform.cpp", "dom/svg/DOMSVGTransform.h", "dom/svg/DOMSVGTransformList.cpp", "dom/svg/DOMSVGTransformList.h"], "git_node": "2436dac3207f67e51dd2254d3f477a9c813b79aa", "git_parents": ["f52f6a576908bfa041b2092d87869e9628c4b596"], "node": "2853f313afe436d818ab404de68b4a1f10381160", "parents": ["63f86aea6753008ff1bda375cbcaaf2a6c73cb2d"], "tags": []}, {"author": "fatadel \u003cafatkhutdinov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056208 - Add a hexadecimal marker schema field format and use it for HostResolver flags. r=canova,profiler-reviewers\n\nThe hexadecimal format takes an integer payload value and lets the\nfront-end render it in base 16 with a 0x prefix, so marker producers no\nlonger have to pre-format such values into strings. HostResolverMarker\nwrites its flags as a raw integer now instead of a hex string.\nThe profiler format version is bumped to 35 to match the front-end.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314952\n", "files": ["mozglue/baseprofiler/core/ProfilerMarkers.cpp", "mozglue/baseprofiler/public/BaseAndGeckoProfilerDetail.h", "mozglue/baseprofiler/public/BaseProfilerMarkersPrerequisites.h", "netwerk/dns/nsHostRecord.cpp", "taskcluster/kinds/fetch/toolchains.yml", "tools/profiler/tests/gtest/GeckoProfiler.cpp"], "git_node": "80c2cba32eff695956d2c51a918174050fa1fe31", "git_parents": ["2436dac3207f67e51dd2254d3f477a9c813b79aa"], "node": "21724a2c296d04886a70d535df1edbdb207eec81", "parents": ["2853f313afe436d818ab404de68b4a1f10381160"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057753 - Use power of two + scrambled hash rather than prime size in MruCache. r=layout-reviewers,dshin,smaug\n\nSee bug 2051347 for context.\n\nAt least for string-keyed MruCache this should be better in practice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314225\n", "files": ["gfx/thebes/gfxHarfBuzzShaper.h", "intl/lwbrk/LineBreakCache.h", "layout/painting/nsImageRenderer.cpp", "mfbt/MruCache.h", "xpcom/base/nsCycleCollector.cpp", "xpcom/tests/gtest/TestMruCache.cpp"], "git_node": "0ba2ca902862ebd975b2ab75e84cc4562fdb3575", "git_parents": ["80c2cba32eff695956d2c51a918174050fa1fe31"], "node": "413b5a0e31ebbeaa2fef66610403b9bffe97f5c3", "parents": ["21724a2c296d04886a70d535df1edbdb207eec81"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use uv in browsertime tasks. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312750\n", "files": ["taskcluster/kinds/browsertime/kind.yml"], "git_node": "98aa33de1e31671661caef6156565b087b0c871e", "git_parents": ["0ba2ca902862ebd975b2ab75e84cc4562fdb3575"], "node": "69ebb24485e2c990dfd1c3b392f6dd5d63d61fda", "parents": ["413b5a0e31ebbeaa2fef66610403b9bffe97f5c3"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059390: fix crash in SitePermissionsFragment.onDismiss r=segunfamisa\n\nIf a fragment is detached, it is no longer safe to call `requireComponents`, because this method throws if the `context` is null. In this case, `BaseBrowserFragment` is not attached and returning true from `shouldHide` will stop us from showing the permission prompt, rather than crashing. Also checked `hidePermissionsPrompt` which will be called if `shouldHide` is true. This allows for the case of the fragment not being attached by using an optional and a let, so should be safe to call in this detached fragment case.\n\n[try is running here](https://treeherder.mozilla.org/jobs?repo=try&revision=8dbfc878c87991d2da9167e8ad5daed2bb54579a)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/321\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt"], "git_node": "4dbfb9dc06e14786c57feca0ef20f95a5ed75f3c", "git_parents": ["98aa33de1e31671661caef6156565b087b0c871e"], "node": "e44c7c330ad536b1d011df073320368f2e7fe665", "parents": ["69ebb24485e2c990dfd1c3b392f6dd5d63d61fda"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059594 - Remove metadata for connection-allowlist/tentative/speculation_rules_prefetch.https.sub.window.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315542\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/speculation_rules_prefetch.https.sub.window.js.ini"], "git_node": "1dd5821307095b5085b1e923af2d77530a0f43c3", "git_parents": ["4dbfb9dc06e14786c57feca0ef20f95a5ed75f3c"], "node": "7d93742c6c5e543edaae26772b1a940a6aadc5a3", "parents": ["e44c7c330ad536b1d011df073320368f2e7fe665"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059602 - Update metadata for speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315550\n", "files": ["testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single-with-hint.https.html.ini"], "git_node": "34b173f596d0445f3e51d05ffee39373afda64b0", "git_parents": ["1dd5821307095b5085b1e923af2d77530a0f43c3"], "node": "37c1e39c6bcce6f3d796a1e8646426902fc078ee", "parents": ["7d93742c6c5e543edaae26772b1a940a6aadc5a3"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059366 - [devtools] Small UI refactor for RDM toolbar + notificationbox in Nova. r=devtools-reviewers,bomsy.\n\nRemove the top border on the RDM toolbar now that the notification box has its own bottom border.\nRemove inline-end margin and padding on the RDM toolbar close button to align with notification\nclose buttons.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315256\n", "files": ["devtools/client/responsive/index.css", "devtools/client/responsive/responsive-browser.css"], "git_node": "1b26d1ca450e14a8acf1f8abae2509cccafe4500", "git_parents": ["34b173f596d0445f3e51d05ffee39373afda64b0"], "node": "62f6b05207c65d6eddc26c28e3db8039eba90da5", "parents": ["37c1e39c6bcce6f3d796a1e8646426902fc078ee"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055837 - use uv in mochitest tasks. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312751\n", "files": ["taskcluster/kinds/mochitest/kind.yml"], "git_node": "9baf35358753261eb9786818b6e215215e7f129f", "git_parents": ["1b26d1ca450e14a8acf1f8abae2509cccafe4500"], "node": "76582d6b4803e533f07bd7bfff85e8ac5a284920", "parents": ["62f6b05207c65d6eddc26c28e3db8039eba90da5"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2058667, consistently use smart pointers, r=masayuki,TYLin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315435\n", "files": ["layout/base/PresShell.cpp"], "git_node": "87c804268c6fe6badb91409e9f625e86fcba2da3", "git_parents": ["9baf35358753261eb9786818b6e215215e7f129f"], "node": "e6a7dbcbe856530f046e80b9805d0a45a8bf7425", "parents": ["76582d6b4803e533f07bd7bfff85e8ac5a284920"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059679 - [devtools] Add MDN link for No-Vary-Search header. r=devtools-reviewers,bomsy.\n\nDif