er.cc", "third_party/libwebrtc/modules/video_coding/codecs/vp9/vp9_frame_buffer_pool.cc", "third_party/libwebrtc/modules/video_coding/codecs/vp9/vp9_frame_buffer_pool_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0096.patch", "third_party/libwebrtc/moz-patch-stack/s0143.patch"], "git_node": "1cc841eba0184e32e01107319caebe4c0252c7f5", "git_parents": ["b25eb4784d7f1086f93d11481b2b98f5b51e8871"], "node": "a83e5ae283fd913f506c520fbdc1bfae61679808", "parents": ["2b442034c302ff32d16b2b6e95c5f8d4e6d25a68"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 473f76246c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/473f76246ceda66b5975c6e8d4cd3c5d998840a6\n    Fix audio_engine_tests for force-test-env flag\n\n    Update audio/ unittests to use CreateTestEnvironment\n    instead of production versions, allowing audio_engine_tests\n    to pass with the --force-test-environment flag.\n\n    Bug: webrtc:521534686\n    Change-Id: I1117d4a8b02c378ca78bc72f66f488726d6c82ec\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/480962\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#47989}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/BUILD.gn", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0096.patch"], "git_node": "0f17529f406a1bfa899f40b28540c727f59f5208", "git_parents": ["1cc841eba0184e32e01107319caebe4c0252c7f5"], "node": "72d412fc12ed024e7acd04e24def6b1e4b4866eb", "parents": ["a83e5ae283fd913f506c520fbdc1bfae61679808"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from adaff0d0b1\n\nUpstream commit: https://webrtc.googlesource.com/src/+/adaff0d0b160009da75267159ddb54367d8ed4c7\n    Fix many more test binaries for force-test-env flag\n\n    Update a lot of test binaries to use CreateTestEnvironment,\n    CreateTestFieldTrials, or AutoBypassTestEnvironmentCheck as\n    appropriate to allow them to pass with the --force-test-environment\n    flag.\n\n    This covers:\n    - audio_engine_tests\n    - modules_tests\n    - call_tests\n    - neteq quality tests\n    - svc_tests\n    - tools_unittests\n    - video_codec_perf_tests\n    - video_timing_tests\n    - voip_unittests\n\n    Bug: webrtc:521534686\n    Change-Id: Ie9ce3f42444aa75a5daeba19c9d29a6fe132d772\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/481440\n    Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#47990}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/voip/BUILD.gn", "third_party/libwebrtc/api/voip/test/voip_engine_factory_unittest.cc", "third_party/libwebrtc/audio/voip/test/BUILD.gn", "third_party/libwebrtc/audio/voip/test/audio_channel_unittest.cc", "third_party/libwebrtc/audio/voip/test/audio_egress_unittest.cc", "third_party/libwebrtc/audio/voip/test/audio_ingress_unittest.cc", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/flexfec_receive_stream_unittest.cc", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/modules/audio_coding/BUILD.gn", "third_party/libwebrtc/modules/audio_coding/neteq/tools/neteq_quality_test.cc", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/test/video_codec_test.cc", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", 