est/descriptor_database.js", "layout/style/test/property_database.js", "layout/style/test/test_font_face_parser.html", "layout/style/test/test_font_loading_api.html", "layout/style/test/test_system_font_serialization.html", "layout/style/test/test_transitions_per_property.html", "layout/style/typedom/CSSUnitValue.cpp", "servo/components/style/font_face.rs", "servo/components/style/matching.rs", "servo/components/style/properties/cascade.rs", "servo/components/style/properties/data.py", "servo/components/style/properties/font_face_descriptors.toml", "servo/components/style/properties/gecko.mako.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/values/computed/font.rs", "servo/components/style/values/computed/mod.rs", "servo/components/style/values/specified/font.rs", "servo/components/style/values/specified/mod.rs", "servo/ports/geckolib/cbindgen.toml", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/css/css-fonts/idlharness.html.ini", "testing/web-platform/meta/css/css-fonts/parsing/font-stretch-alias.html.ini", "testing/web-platform/meta/css/css-fonts/parsing/font-width-computed.html.ini", "testing/web-platform/meta/css/css-fonts/parsing/font-width-valid.html.ini", "testing/web-platform/tests/css/css-font-loading/font-face-width-descriptor-aliasing-ref.html", "testing/web-platform/tests/css/css-font-loading/font-face-width-descriptor-aliasing.html", "testing/web-platform/tests/css/css-font-loading/resources/variabletest_matching.ttf", "widget/android/nsLookAndFeel.cpp", "widget/gtk/nsLookAndFeel.cpp", "widget/headless/HeadlessLookAndFeelGTK.cpp", "widget/uikit/nsLookAndFeel.mm"], "git_node": "8dc93c08cab8ff7ee1077c2d51939192a8a876d3", "git_parents": ["1d043b4d775e4658addef8b121d79a727deb302e"], "node": "62ae8eb7849ed5ce2c00fb37154b7e2e8abd42e6", "parents": ["17787c47f802a4b7e221d7fbeca8a5eb53b0567d"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2058219 - Port OSX speech synth to AVSpeechSynthesizer. r=media-playback-reviewers,padenot\n\nNSSpeechSynthesizer stopped providing us with default voices at some point.\nThis caused us to use \"novelty\" voices by default.\nI took the opportunity to filter out novelty voices entirely,\n as well as Eloquence voices that don't seem to work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314489\n", "files": ["dom/media/webspeech/synth/cocoa/OSXSpeechSynthesizerService.mm"], "git_node": "58f4b6a9c12900e3e4753dcb9bbfce75ceda8031", "git_parents": ["8dc93c08cab8ff7ee1077c2d51939192a8a876d3"], "node": "09c8aca4673bb2294de3686e4cb309d3f61494b7", "parents": ["62ae8eb7849ed5ce2c00fb37154b7e2e8abd42e6"], "tags": []}, {"author": "az \u003cazebrowski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046819 - Add Raptor benchmark for Media Capabilities r=pehrsons,perftest-reviewers,sparky,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D307872\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/browsertime/support-scripts/media_capabilities.py", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/raptor.toml", "testing/raptor/raptor/tests/benchmarks/media-capabilities.toml", "third_party/webkit/PerformanceTests/media-capabilities/LICENSE", "third_party/webkit/PerformanceTests/media-capabilities/README.md", "third_party/webkit/PerformanceTests/media-capabilities/configs.js", "third_party/webkit/PerformanceTests/media-capabilities/driver.js", "third_party/webkit/PerformanceTests/media-capabilities/index.html", "third_party/webkit/PerformanceTests/media-capabilities/media-capabilities-worker.js", "third_party/webkit/PerformanceTests/media-capabilities/moz.yaml", "third_party/webkit/PerformanceTests/media-capabilities/runner.js"], "git_node": "65be147605b43483004f121a05a48114e6de6d2d", "git_parents": ["58f4b6a9c12900e3e4753dcb9bbfce75ceda8031"], "node": "68d8d51ba080e70bf0c06f72122f82e20671b319", "parents": ["09c8aca4673bb2294de3686e4cb309d3f61494b7"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058030 - Fix Nova failures on Firefox View due to string mismatches. r=fxview-reviewers,nsharpley\n\nInstead of comparing strings, compare l10n attributes, as recommended by Fluent docs: https://firefox-source-docs.mozilla.org/l10n/fluent/tutorial.html#testing\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316574\n", "files": ["browser/components/firefoxview/tests/browser/browser.toml", "browser/components/firefoxview/tests/browser/browser_history_firefoxview.js", "browser/components/firefoxview/tests/browser/browser_recentlyclosed_firefoxview.js", "browser/components/firefoxview/tests/browser/browser_syncedtabs_errors_firefoxview.js", "browser/components/firefoxview/tests/browser/browser_syncedtabs_firefoxview.js"], "git_node": "cd7c0c471c8160efb2fe896ae07e1b160124916e", "git_parents": ["65be147605b43483004f121a05a48114e6de6d2d"], "node": "6e54f056f383f450661f557eab6fff7180d382d2", "parents": ["68d8d51ba080e70bf0c06f72122f82e20671b319"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057458 - Remove assertion that depends on marking only a single object for testing r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316392\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug2057458.js"], "git_node": "43acc0f70c6a111fdb20738cbf9dd973bf6ed02a", "git_parents": ["cd7c0c471c8160efb2fe896ae07e1b160124916e"], "node": "b4302e87f496217879d0ad2c2a8adb3e44113229", "parents": ["6e54f056f383f450661f557eab6fff7180d382d2"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2060970: Use range-based for-loop (and avoid unnecessary refcount traffic) in PresShell::MaybeReflowForInflationScreenSizeChange(). r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316631\n", "files": ["layout/base/PresShell.cpp"], "git_node": "6a1779dd7e94b8754bec38296a266b97e5e4a099", "git_parents": ["43acc0f70c6a111fdb20738cbf9dd973bf6ed02a"], "node": "a7181fa7b0b220bfb54d6b78cb85cdd230ddcf70", "parents": ["b4302e87f496217879d0ad2c2a8adb3e44113229"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049644: Avoid calling ObjectMayHaveExtraIndexedOwnProperties in release r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316414\n", "files": ["js/src/vm/Iteration.cpp"], "git_node": "95dc656cebddff0f928df2d8da537c1d7be4cce1", "git_parents": ["6a1779dd7e94b8754bec38296a266b97e5e4a099"], "node": "d17aa686f501fca14f427fad3fa2c661e56be968", "parents": ["a7181fa7b0b220bfb54d6b78cb85cdd230ddcf70"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059933: Fix central-as-beta simulation error r=spidermonkey-reviewers,sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316404\n", "files": ["js/src/jit-test/tests/typedarray/bug2049412.js"], "git_node": "b8d192b1ed2db0dd6e57a64b91c95688663c5dc2", "git_parents": ["95dc656cebddff0f928df2d8da537c1d7be4cce1"], "node": "c5f8bb1049506df6fe2c1d73b5a7b0d78a87312a", "parents": ["d17aa686f501fca14f427fad3fa2c661e56be968"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2052153 - Add title attribute to autocomplete login edit icon. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316590\n", "files": ["toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.mjs"], "git_node": "246cf8433c244906a3d250b8f7e838acde3a3e80", "git_parents": ["b8d192b1ed2db0dd6e57a64b91c95688663c5dc2"], "node": "cf112b899cce76bf44b23c326c64b7d3de88aa1c", "parents": ["c5f8bb1049506df6fe2c1d73b5a7b0d78a87312a"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060966 - Respect MOZ_DISABLE_GPU_SANDBOX on macOS. r=sandbox-reviewers,bobowen\n\nFor debugging and testing, when the MOZ_DISABLE_GPU_SANDBOX environment\nvariable is set, disable the GPU sandbox on macOS (like we already do on\nWindows).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316630\n", "files": ["security/sandbox/common/SandboxSettings.cpp", "security/sandbox/common/SandboxSettings.h"], "git_node": "4d303694e5b7ffb75687d3a431e9a945e10688ce", "git_parents": ["246cf8433c244906a3d250b8f7e838acde3a3e80"], "node": "c63c1189379fcbf673d594c7af74cc4595d32195", "parents": ["cf112b899cce76bf44b23c326c64b7d3de88aa1c"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057458 - Remove assertion that depends on marking only a single object for testing r=spidermonkey-reviewers,jonco\" for causing spidermonkey build bustages\n\nThis reverts commit 43acc0f70c6a111fdb20738cbf9dd973bf6ed02a.\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/bug2057458.js"], "git_node": "40b9956d8380e1edb75300446506d171f7e94417", "git_parents": ["4d303694e5b7ffb75687d3a431e9a945e10688ce"], "node": "536d6f4f97e168d61bd30b2a4018f9b76c0aa3b3", "parents": ["c63c1189379fcbf673d594c7af74cc4595d32195"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2049644: Avoid calling ObjectMayHaveExtraIndexedOwnProperties in release r=jandem\" for causing osx-aarch64-nightlyasrelease build bustages\n\nThis reverts commit 95dc656cebddff0f928df2d8da537c1d7be4cce1.\n", "files": ["js/src/vm/Iteration.cpp"], "git_node": "69e34e5d1843a592ec3d0e02fb447edb46d951d8", "git_parents": ["40b9956d8380e1edb75300446506d171f7e94417"], "node": "ee434ea40033373c52be4d3b647a3293b1685bb3", "parents": ["536d6f4f97e168d61bd30b2a4018f9b76c0aa3b3"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "02c7f3783e4ac483ae7dde530f9c8989a7558ac2", "git_parents": ["69e34e5d1843a592ec3d0e02fb447edb46d951d8", "fcddc9cb649ced42079ec1c037bbdbd6a4bb65b7"], "node": "a53d72c9a531668c169b5055a0ee947d44219dd5", "parents": ["ee434ea40033373c52be4d3b647a3293b1685bb3", "bb3ac5a217ffe1d7fc66eb86f4af7f6e113d9054"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049644: Avoid calling ObjectMayHaveExtraIndexedOwnProperties in release r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316414\n", "files": ["js/src/vm/Iteration.cpp"], "git_node": "7c87df9b66ba336548926a334853c9a3305165cb", "git_parents": ["02c7f3783e4ac483ae7dde530f9c8989a7558ac2"], "node": "243d79939ccf3ec50e13f202c3538c3cfdfc5e70", "parents": ["a53d72c9a531668c169b5055a0ee947d44219dd5"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057463 - Legacy features must be enabled in optimized path; r=iain\" for causing aarch64-nightlyasrelease build bustages\n\nThis reverts commit c0db43ec555c1ec2d88e79d3b9da9cdb70b1c8cc.\n", "files": ["js/src/shell/js.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "c6c66b8f643e11c99a53a6c16d8a8270e6a7a1a0", "git_parents": ["7c87df9b66ba336548926a334853c9a3305165cb"], "node": "2cc96063625f5953d81647080c474eab467f1f27", "parents": ["243d79939ccf3ec50e13f202c3538c3cfdfc5e70"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1998331: Making button element selectable by default r=dholbert,firefox-style-system-reviewers,emilio,devtools-reviewers,layout-reviewers,dshin,nchevobbe\" for causing browser failures at browser_text_selection.js\n\nThis reverts commit f3477aafb4450c86b2f8a18239823bafa1ead182.\n", "files": ["devtools/client/themes/webconsole.css", "devtools/server/tests/browser/browser_accessibility_node.js", "devtools/server/tests/browser/browser_accessibility_node_events.js", "layout/base/tests/test_caret_browsing_around_form_controls.html", "layout/style/res/forms.css", "testing/web-platform/tests/css/css-ui/tentative/button-user-select.html"], "git_node": "69e11a76dd95492c1ac116eac1df3f5768a51ad3", "git_parents": ["c6c66b8f643e11c99a53a6c16d8a8270e6a7a1a0"], "node": "cf366d00ee907a794ee803624a958f33c207c090", "parents": ["2cc96063625f5953d81647080c474eab467f1f27"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060964 - Fix spoc request building in DiscoveryStream with MAC r=mconley\n\nWhen refactoring, included the requests.push in the conditional.\nThis led to any simple placements (non-contextual) being excluded.\nUpdated the test to ensure that this would be caught if regressed again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316634\n", "files": ["browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/test/unit/lib/DiscoveryStreamFeed.test.js"], "git_node": "e722fc92d190a5e2acbebc2ec64dca8ef6345702", "git_parents": ["69e11a76dd95492c1ac116eac1df3f5768a51ad3"], "node": "44e4d506f6508cf01d3f376980e5e612c1b9a074", "parents": ["cf366d00ee907a794ee803624a958f33c207c090"], "tags": []}, {"author": "Zyphrenn \u003czyphrenn@gmail.com\u003e", "branch": "default", "desc": "Bug 2059969 - Hide \"Tab group suggestions\" AI control when tab groups are disabled. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315816\n", "files": ["browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures.js"], "git_node": "c8407c33042eeb84a641a927b0ce7f09f489473a", "git_parents": ["e722fc92d190a5e2acbebc2ec64dca8ef6345702"], "node": "dbadb8279a88eb1fd51c274f827c0b7e07e6831f", "parents": ["44e4d506f6508cf01d3f376980e5e612c1b9a074"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060035 - Remove the duplicated MDN import of the DevTools Memory panel docs. r=devtools-reviewers,nchevobbe\n\nThe DevTools Memory panel user documentation was imported from MDN\ntwice: once into devtools-user/memory (the DevTools user docs tree) and\nonce into performance/memory, alongside the genuine Gecko\nmemory-debugging docs. The two copies had already drifted apart.\n\nKeep the devtools-user copy, which is the right home for user-facing\nDevTools documentation and is self-contained (it carries its own\nimages), and drop the eight pages and 34 images duplicated under\nperformance/memory. That tree keeps the Gecko-specific content\n(about:memory, AWSY, BloatView, DMD, leak hunting, refcount tracing).\n\nThe performance/memory index now points at the DevTools user docs\ninstead of listing the copies, and redirects are added so the old URLs\nkeep resolving.\n\n./mach doc goes from 672 to 661 warnings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315868\n", "files": ["docs/config.yml", "docs/performance/img/dominators-1.png", "docs/performance/img/dominators-10.png", "docs/performance/img/dominators-2.png", "docs/performance/img/dominators-3.png", "docs/performance/img/dominators-4.png", "docs/performance/img/dominators-5.png", "docs/performance/img/dominators-6.png", "docs/performance/img/dominators-7.png", "docs/performance/img/dominators-8.png", "docs/performance/img/dominators-9.png", "docs/performance/img/memory-1-small.png", "docs/performance/img/memory-2-small.png", "docs/performance/img/memory-3-small.png", "docs/performance/img/memory-4-small.png", "docs/performance/img/memory-5-small.png", "docs/performance/img/memory-6-small.png", "docs/performance/img/memory-7-small.png", "docs/performance/img/memory-graph-dominator-multiple-references.svg", "docs/performance/img/memory-graph-dominators.svg", "docs/performance/img/memory-graph-immediate-dominator.svg", "docs/performance/img/memory-graph-unreachable.svg", "docs/performance/img/memory-graph.svg", "docs/performance/img/memory-tool-aggregate-view.png", "docs/performance/img/memory-tool-call-stack-expanded.png", "docs/performance/img/memory-tool-call-stack.png", "docs/performance/img/memory-tool-in-group-icon.png", "docs/performance/img/memory-tool-in-group-retaining-paths.png", "docs/performance/img/memory-tool-in-group.png", "docs/performance/img/memory-tool-inverted-call-stack.png", "docs/performance/img/memory-tool-switch-view.png", "docs/performance/img/monsters.svg", "docs/performance/img/treemap-bbc.png", "docs/performance/img/treemap-domnodes.png", "docs/performance/img/treemap-monsters.png", "docs/performance/index.md", "docs/performance/memory/DOM_allocation_example.md", "docs/performance/memory/aggregate_view.md", "docs/performance/memory/basic_operations.md", "docs/performance/memory/dominators.md", "docs/performance/memory/dominators_view.md", "docs/performance/memory/index.md", "docs/performance/memory/memory.md", "docs/performance/memory/monster_example.md", "docs/performance/memory/tree_map_view.md"], "git_node": "0c1faf05883d1427f90c589fef2c86439a16e752", "git_parents": ["c8407c33042eeb84a641a927b0ce7f09f489473a"], "node": "184b94add159a13abedd49eed9b54fb87c438f68", "parents": ["dbadb8279a88eb1fd51c274f827c0b7e07e6831f"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060036 - Fix the remaining code-fence, docstring and glossary doc warnings. r=taskgraph-reviewers,releng-reviewers,omc-reviewers,bhearsum,emcminn\n\nCode fences whose language did not match their contents: the High\nContrast Mode CSS blocks use nesting, which Pygments' css lexer bails\nout on, so fence them as scss; an asrouter JEXL example was fenced as\njava; and the Fluent review doc used the {js} role for Fluent comment\nmarkers.\n\nRST docstrings rendered by autodoc: mozbuild's context.py and\ngecko_taskgraph's backfill_action had lists and literal blocks not\npreceded by a blank line, which also caused two knock-on 'Block quote\nends without a blank line' warnings.\n\nGlossaries: the glossary directive treats non-indented lines as terms,\nso the MyST ': definition' syntax made every definition look like a\nterm. Indent the definitions instead.\n\n./mach doc goes from 661 to 636 warnings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315869\n", "files": ["accessible/docs/HCMCSSChecklist.md", "accessible/docs/HCMMediaQueries.md", "browser/components/asrouter/docs/targeting-attributes.md", "build/docs/glossary.md", "intl/l10n/docs/fluent/review.md", "intl/l10n/docs/glossary.md", "python/mozbuild/mozbuild/frontend/context.py", "taskcluster/gecko_taskgraph/actions/backfill.py"], "git_node": "0eeac7d2fa677dc82e4995c3cfe6e38cf140a6bc", "git_parents": ["0c1faf05883d1427f90c589fef2c86439a16e752"], "node": "c339c268d88a3c3a5cca2e048bc0126f57f34b17", "parents": ["184b94add159a13abedd49eed9b54fb87c438f68"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060038 - Publish the Marionette documentation only once. r=necko-reviewers,geckodriver-reviewers,Sasha,janerik,jesup\n\nremote/moz.build declared two overlapping Sphinx trees:\n\n    SPHINX_TREES[\"/remote\"] = \"doc\"\n    SPHINX_TREES[\"/testing/marionette\"] = \"doc/marionette\"\n\nThe second path is a subdirectory of the first, so every page under\nremote/doc/marionette was built twice, once at /remote/marionette and\nonce at /testing/marionette. With autosectionlabel_maxdepth = 1 each\npage's H1 becomes a global label, so every Marionette heading collided\nwith its own copy.\n\nDrop the /testing/marionette tree and add a prefix redirect so the old\nURLs keep resolving, then repoint the in-tree cross-references. Only\nthe published path moves; the testing/marionette source directory is\nuntouched.\n\nA clean ./mach doc goes from 59 to 45 duplicate label warnings. The\nremaining ones are collisions between distinct pages that happen to\nshare a generic title ('Testing', 'Debugging', 'Preferences'), not\npages duplicating themselves.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315887\n", "files": ["docs/config.yml", "netwerk/docs/new_to_necko_resources.md", "remote/doc/Building.md", "remote/doc/index.md", "remote/moz.build", "testing/docs/automated-testing/index.md", "testing/geckodriver/README.md", "testing/geckodriver/doc/Building.md", "testing/geckodriver/doc/Flags.md", "testing/geckodriver/doc/Testing.md", "testing/marionette/client/docs/basics.md", "toolkit/components/glean/docs/dev/testing.md", "tools/moztreedocs/docs/redirect.md"], "git_node": "4414af1925b96be528078f2c72074a5f866f1a9e", "git_parents": ["0eeac7d2fa677dc82e4995c3cfe6e38cf140a6bc"], "node": "be765b95c171f3e25e3ae52ab89cea4d12abca7c", "parents": ["c339c268d88a3c3a5cca2e048bc0126f57f34b17"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060038 - Stop allowing duplicate documentation labels. r=firefox-source-docs-reviewers,geckoview-reviewers,devtools-reviewers,places-reviewers,profiler-reviewers,android-reviewers,Sasha,janerik,nchevobbe,canova,ohall,ahal\n\nWith autosectionlabel_maxdepth = 1 every page's H1 becomes a global\nlabel, so pages sharing a generic title collide. The blanket\n'WARNING: duplicate label' entry in allowed_warnings hid all of them.\n\nFix the remaining 45 collisions, then drop the entry so new ones fail\nthe build:\n\n - Give generic page titles a component-specific name: 'Testing',\n   'Debugging', 'Preferences', 'Contributing', 'Telemetry',\n   'Architecture overview', 'Settings', 'Metrics' and the DevTools user\n   docs' 'How to', 'UI Tour' and 'Search'.\n - The mobile RFCs used one H1 per section, so every RFC redefined\n   'Summary', 'Motivation' and friends. Give each a single H1 title and\n   demote the section headings.\n - Prefix four explicit targets that collided with another page's H1:\n   introduction, plhashtable, preferences and mochitests.\n - docs/contributing/build/supported.md only did a MyST include of\n   build/docs/supported-configurations.md, which redefined every label\n   in it. Drop the page and redirect to the included one instead.\n\nA clean ./mach doc goes from 1385 to 1257 warnings and from 59\nduplicate labels to 0, with no new undefined labels or broken\ncross-references.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315888\n", "files": ["browser/components/places/docs/architecture-overview.md", "browser/extensions/newtab/docs/v2-system-addon/preferences.md", "devtools/client/netmonitor/docs/architecture.md", "devtools/docs/contributor/architecture-overview.md", "devtools/docs/contributor/contributing.md", "devtools/docs/contributor/frontend/telemetry.md", "devtools/docs/contributor/preferences.md", "devtools/docs/user/debugger/how_to/index.md", "devtools/docs/user/debugger/how_to/search/index.md", "devtools/docs/user/debugger/ui_tour/index.md", "devtools/docs/user/page_inspector/how_to/index.md", "devtools/docs/user/page_inspector/ui_tour/index.md", "devtools/docs/user/performance/index.md", "docs/config.yml", "docs/contributing/build/supported.md", "docs/contributing/debugging/debugging_webrtc_calls.md", "docs/contributing/index.md", "docs/contributing/pocket-guide-shipping-firefox.md", "docs/metrics/index.md", "mobile/android/docs/rfcs/0000-template.md", "mobile/android/docs/rfcs/0015-android-rfc-process.md", "mobile/android/docs/shared/android/testing.md", "mobile/android/docs/shared/rfc/wallpapers_v2_network_improvements.md", "mobile/android/fenix/docs/Architecture-Decisions.md", "mobile/android/fenix/docs/Telemetry-implementation,-reviews,-renewals.md", "mobile/android/fenix/docs/architecture-overview.md", "mobile/android/fenix/docs/telemetry.md", "mobile/android/focus-android/docs/Architecture-Decisions.md", "mobile/android/focus-android/docs/Telemetry.md", "python/mach/docs/settings.md", "remote/doc/Debugging.md", "remote/doc/Prefs.md", "remote/doc/Testing.md", "remote/doc/marionette/CodeStyle.md", "remote/doc/marionette/Contributing.md", "remote/doc/marionette/Debugging.md", "remote/doc/marionette/Patches.md", "remote/doc/marionette/Prefs.md", "remote/doc/marionette/Testing.md", "testing/docs/chrome-tests/index.md", "toolkit/components/contentrelevancy/docs/telemetry.md", "toolkit/components/glean/docs/dev/testing.md", "toolkit/components/ipprotection/docs/Preferences.md", "toolkit/components/normandy/docs/data-collection.md", "tools/profiler/docs/code-overview.md", "xpcom/docs/hashtables_detailed.md"], "git_node": "fe90d22103ecbdfc7f683f5d758b9c15c16dd570", "git_parents": ["4414af1925b96be528078f2c72074a5f866f1a9e"], "node": "cea3d9c34315dfb339bfae6868030ed3ee52e905", "parents": ["be765b95c171f3e25e3ae52ab89cea4d12abca7c"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060038 - Drop the allowed_warnings entries that no longer match anything. r=firefox-source-docs-reviewers,ahal\n\nA clean ./mach doc no longer emits any of these, so they only made the\nlist harder to read and hid the fact that the underlying issues were\nalready fixed. 95 entries go down to 51.\n\nThe graphviz 'dot cannot be run' entry is kept even though it does not\nmatch locally: it only fires on a machine without graphviz installed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315889\n", "files": ["docs/config.yml"], "git_node": "b1cffc6731e7c1952c3603086ac96863bfac5b11", "git_parents": ["fe90d22103ecbdfc7f683f5d758b9c15c16dd570"], "node": "0cfcfda2c3ec9d01497db28d8c26ac6513366a6f", "parents": ["cea3d9c34315dfb339bfae6868030ed3ee52e905"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060006 - Point documentation cross-references at the source document instead of the rendered .html. r=necko-reviewers,geckoview-reviewers,releng-reviewers,profiler-reviewers,migration-reviewers,urlbar-reviewers,Sasha,janerik,canova,ohall,bhearsum,valentin\n\n111 MyST cross-references used the rendered .html path, which resolves\nto nothing, so Sphinx reported 'cross-reference target not found' for\neach of them.\n\nMost were mechanical (foo.html -\u003e foo.md). Nine targeted documents that\nhad moved in the meantime:\n\n - the eslint-plugin-mozilla valid-ci-uses and valid-services-property\n   rules moved under rules/\n - /devtools/tests/debugging-intermittents moved to\n   /testing/debugging-intermittents/\n - /tools/lint/linters/rstlinter moved to\n   /code-quality/lint/linters/rstlinter\n - the telemetry collection/scalars and collection/events pages moved\n   under obsolete/collection/\n - taskcluster/optimization is a directory now, so the link needs\n   optimization/index\n - /security/nss/index and /python/marionette_driver are still .rst\n\nreport-gecko-telemetry-in-glean.md linked to glean/user/migration.html,\nwhich does not exist under that name; point it at the Glean user index\ninstead.\n\nA clean ./mach doc goes from 1257 to 1037 warnings and the 111 .html\ncross-reference failures drop to 0, with no new undefined labels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315898\n", "files": ["accessible/docs/ColorsAndHighContrastMode.md", "browser/components/migration/docs/migration-wizard.md", "browser/components/urlbar/docs/testing.md", "docs/code-quality/lint/linters/eslint-plugin-mozilla/rules/use-console-createInstance.md", "docs/code-quality/lint/linters/eslint.md", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/no-browser-refs-in-toolkit.md", "docs/code-quality/lint/linters/stylelint.md", "docs/code-quality/lint/linters/typescript.md", "docs/code-quality/static-analysis/existing.md", "docs/contributing/build/building_mobile_firefox.md", "docs/contributing/contributing_to_mozilla.md", "docs/contributing/debugging/debugging_webrtc_calls.md", "gfx/docs/AsyncPanZoom.md", "mobile/android/docs/geckoview/consumer/index.md", "mobile/android/docs/geckoview/contributor/contributing-to-firefox.md", "mobile/android/docs/geckoview/contributor/for-gecko-engineers.md", "mobile/android/docs/geckoview/contributor/geckoview-architecture.md", "mobile/android/docs/geckoview/contributor/geckoview-quick-start.md", "mobile/android/docs/geckoview/contributor/index.md", "mobile/android/docs/geckoview/contributor/native-debugging.md", "mobile/android/docs/geckoview/design/index.md", "netwerk/docs/network_test_guidelines.md", "netwerk/docs/new_to_necko_resources.md", "remote/doc/marionette/index.md", "taskcluster/docs/release-promotion-action.md", "toolkit/components/crashes/docs/index.md", "toolkit/components/glean/docs/user/gifft.md", "toolkit/components/normandy/docs/execution-model.md", "toolkit/components/prompts/docs/nsIPromptService.md", "toolkit/components/telemetry/docs/index.md", "toolkit/components/telemetry/docs/start/index.md", "toolkit/components/telemetry/docs/start/report-gecko-telemetry-in-glean.md", "tools/moztreedocs/docs/mdn-import.md", "tools/profiler/docs/markers-guide.md", "xpcom/docs/logging.md"], "git_node": "e39f0659825af19bb25843c38e9f2b0bc5378a78", "git_parents": ["b1cffc6731e7c1952c3603086ac96863bfac5b11"], "node": "89508be079bd5bdaeb24f93055c5e1817b6a694e", "parents": ["0cfcfda2c3ec9d01497db28d8c26ac6513366a6f"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060006 - Use autolinks for about: URLs in the WebRTC debugging docs.\n\nWritten as [about:config](about:config), MyST treats the target as a\ncross-reference rather than a URL, so it warned and the link did not\nrender for readers. The same page already uses the \u003cabout:webrtc\u003e\nautolink form elsewhere, which works; use it for the remaining ten.\n\nA clean ./mach doc goes from 1037 to 1017 warnings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315900\n", "files": ["docs/contributing/debugging/debugging_webrtc_calls.md"], "git_node": "e5c77dc97130db6bbcfda06086c114d49a4b6171", "git_parents": ["e39f0659825af19bb25843c38e9f2b0bc5378a78"], "node": "6ce6ea2f169c82521e27913b2ec93afe97030847", "parents": ["89508be079bd5bdaeb24f93055c5e1817b6a694e"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038819 - Remove the RST linter r=linter-reviewers,ahal\n\nThe in-tree documentation has been converted from RST to Markdown, so\nrstcheck no longer covers any Firefox-owned documentation. The remaining\n.rst files belong to upstream projects (NSS, web-platform-tests) or are\nvendored third-party code.\n\nThis removes tools/lint/rst.yml and its implementation, the associated\ntest and fixtures, the .rstcheck.cfg configuration, the doc(rst) CI task,\nthe rstcheck pins, and the linter documentation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314843\n", "files": [".rstcheck.cfg", "docs/code-quality/index.md", "docs/code-quality/lint/create.md", "docs/code-quality/lint/linters/rstlinter.md", "moz.build", "python/sites/lint.txt", "python/sites/python-test.txt", "taskcluster/kinds/source-test/mozlint.yml", "tools/lint/rst.yml", "tools/lint/rst/__init__.py", "tools/lint/test/files/rst/.dotfile.rst", "tools/lint/test/files/rst/bad.rst", "tools/lint/test/files/rst/bad2.rst", "tools/lint/test/files/rst/bad3.rst", "tools/lint/test/files/rst/good.rst", "tools/lint/test/python.toml", "tools/lint/test/test_rst.py", "tools/moztreedocs/docs/mdn-import.md", "tools/moztreedocs/docs/rstlint.md"], "git_node": "56e1c53c5ada2199fb9870350ba1c0cdf05f082e", "git_parents": ["e5c77dc97130db6bbcfda06086c114d49a4b6171"], "node": "2cee8e1ad20f757be4030863526d33c038c7505f", "parents": ["6ce6ea2f169c82521e27913b2ec93afe97030847"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060528 - Adjust the nss document with the recent import r=jschanck\n\nThe NSS update in bug 2060338 renamed security/nss/doc/rst to\nsecurity/nss/doc/src, but SPHINX_TREES still pointed at the old path, so\nthe whole NSS documentation tree silently dropped out of the build. That\nbroke the {ref}`Network Security Services (NSS)` references in\ndocs/mots/index.md and docs/nspr/index.md.\n\nPoint SPHINX_TREES (and the SCHEDULES glob) at nss/doc/src, and drop the\nallowed_warnings entry that was papering over the missing\nsecurity/nss/index document.\n\nThe NSS docs themselves still carry legacy MDN-style anchors that do not\nresolve, plus a duplicate label and an ambiguous cross-reference. Those\nlive in upstream-owned files that updatebot would clobber, so they are\nallow-listed under the existing bug 1915274 entry instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316258\n", "files": ["docs/config.yml", "docs/contributing/contributing_to_mozilla.md", "security/moz.build"], "git_node": "7aba560e2f5d7fb630af5efb53a7cf1d370b82da", "git_parents": ["56e1c53c5ada2199fb9870350ba1c0cdf05f082e"], "node": "bb9ea64c46e3325b4c1d10afdec5c7a50956a58f", "parents": ["2cee8e1ad20f757be4030863526d33c038c7505f"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057892 \u2014 re-enable browser_input_file_tooltips.js when Nova is enabled r=sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316619\n", "files": ["toolkit/components/tooltiptext/tests/browser.toml"], "git_node": "5a9a4053da845c05d5e06095f46953a9186e8f91", "git_parents": ["7aba560e2f5d7fb630af5efb53a7cf1d370b82da"], "node": "47d6f8eb372a5a636d40618fa0654f1d84b5dbe0", "parents": ["bb9ea64c46e3325b4c1d10afdec5c7a50956a58f"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057891 \u2014 undo browser_passwords_create_login.js linux 22.04 and nova skip rules r=credential-management-reviewers,mtigley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316626\n", "files": ["toolkit/components/satchel/megalist/content/tests/browser/browser.toml"], "git_node": "4e5667598b7575c52f01d16c18c5efb340653a01", "git_parents": ["5a9a4053da845c05d5e06095f46953a9186e8f91"], "node": "77a3d64dd7ef222d251e419a49fc3240257c6934", "parents": ["47d6f8eb372a5a636d40618fa0654f1d84b5dbe0"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2059582 - [Nova] Don't stretch the row title across the row when wrap is active r=desktop-theme-reviewers,urlbar-reviewers,mstriemer,adw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315467\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "2f37f18517601a5092185720cba649d632f02033", "git_parents": ["4e5667598b7575c52f01d16c18c5efb340653a01"], "node": "5622e140d8d8d22fbab062b71b08be8f93769195", "parents": ["77a3d64dd7ef222d251e419a49fc3240257c6934"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060843 - Separate the test coverage of regular and compositor clips. r=gw\n\nWe started with only regular clips and the bulk of wrench tests that exercise\nclipping meant to test that code path and how it interracts with the rest of\nthe rendering pipeline. Later, composiotr clips were introduced and a lot of\nwrench tests silently switched to using that code path.\n\nCompositor clips re fairly simple and self-contained so covering them does not\nrequire a large amount of tests. This patch adds a debug flag to disable\ncompositor clips and enable it by default for wrench reftests. Moving the bulk\nof wrench reftests back to covering the original code path.\nA separate set of tests in wrench/reftests/compositor is added to test the\ncompositor clips explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316525\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/wrench/reftests/boxshadow/boxshadow-spread-only-ref.png", "gfx/wr/wrench/reftests/clip/sc-mask-with-blur.png", "gfx/wr/wrench/reftests/compositor-surface/underlay-mask-on-translucent-slice.png", "gfx/wr/wrench/reftests/compositor/clipped-out-ref.yaml", "gfx/wr/wrench/reftests/compositor/clipped-out.yaml", "gfx/wr/wrench/reftests/compositor/corner-shape-ref.yaml", "gfx/wr/wrench/reftests/compositor/corner-shape.yaml", "gfx/wr/wrench/reftests/compositor/elliptical-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/elliptical-radius.yaml", "gfx/wr/wrench/reftests/compositor/fractional-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/fractional-radius.yaml", "gfx/wr/wrench/reftests/compositor/larger-than-tile-ref.yaml", "gfx/wr/wrench/reftests/compositor/larger-than-tile.yaml", "gfx/wr/wrench/reftests/compositor/nested-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/nested-clip.yaml", "gfx/wr/wrench/reftests/compositor/per-corner-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/per-corner-radius.yaml", "gfx/wr/wrench/reftests/compositor/radius-clamped-ref.yaml", "gfx/wr/wrench/reftests/compositor/radius-clamped.yaml", "gfx/wr/wrench/reftests/compositor/rect-and-rounded-ref.yaml", "gfx/wr/wrench/reftests/compositor/rect-and-rounded.yaml", "gfx/wr/wrench/reftests/compositor/reftest.list", "gfx/wr/wrench/reftests/compositor/rotated-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/rotated-clip.yaml", "gfx/wr/wrench/reftests/compositor/rounded-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/rounded-clip.yaml", "gfx/wr/wrench/reftests/compositor/scrolled-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/scrolled-clip.yaml", "gfx/wr/wrench/reftests/compositor/tile-boundary-ref.yaml", "gfx/wr/wrench/reftests/compositor/tile-boundary.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-combined-ref.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-combined.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-offset-ref.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-offset.yaml", "gfx/wr/wrench/reftests/text/border-radius-alpha.png", "gfx/wr/wrench/reftests/text/border-radius-subpx.png", "gfx/wr/wrench/reftests/text/reftest.list", "gfx/wr/wrench/reftests/transforms/reftest.list", "gfx/wr/wrench/src/args.yaml", "gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/reftest.rs", "gfx/wr/wrench/src/test_invalidation.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "566101cc1e6daecc93236f4c3018a16f29e1d2cc", "git_parents": ["2f37f18517601a5092185720cba649d632f02033"], "node": "2198b1994f1d54686868ed20c8c3d63500bc81c2", "parents": ["5622e140d8d8d22fbab062b71b08be8f93769195"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2057481 - Request ACCESS_LOCAL_NETWORK permission after local-network load errors. r=geckoview-reviewers,android-reviewers,ohall,jonalmeida\n\nWire ERROR_LOCAL_NETWORK_ACCESS_DENIED through GV and AC so GeckoEngineSession can trigger an app permission request when local-network access is blocked on Android 17+.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316539\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineSessionTest.kt", "mobile/android/android-components/components/browser/errorpages/src/main/java/mozilla/components/browser/errorpages/ErrorPages.kt", "mobile/android/android-components/components/browser/errorpages/src/test/java/mozilla/components/browser/errorpages/ErrorPagesTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/AppRequestInterceptor.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/AppRequestInterceptor.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/WebRequestError.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/package-info.java", "mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/GeckoViewActivity.java"], "git_node": "3b05980dd7e744642a3ac184265227878837a26c", "git_parents": ["566101cc1e6daecc93236f4c3018a16f29e1d2cc"], "node": "c5b19f643d91ade211a0cb3fc49916b6385ea96b", "parents": ["2198b1994f1d54686868ed20c8c3d63500bc81c2"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045435 - Prune dying entries from wasm::Realm::instances_ during sweeping. r=jpages\n\nwasm::Realm::instances_ is a weak list. Readers rely on the\ninstances()[i]-\u003eobject() read barrier, but that barrier is a no-op once the\nowning zone is being incrementally swept, and entries are otherwise only\nremoved at Instance finalization (~Instance -\u003e unregisterInstance). So between\nmarking a zone's instance objects dead and finalizing them, the list could\nstill hand an about-to-be-finalized instance to a reader.\n\nPrune such entries at the start of zone sweeping via a new\nwasm::Realm::traceWeakInstances(), called from beginSweepingSweepGroup\nalongside the other per-realm weak-collection sweeps. This makes instances_\nbehave like the engine's other weak collections, so it never exposes an\nabout-to-be-finalized instance to the mutator during sweep slices.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314032\n", "files": ["js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp", "js/src/wasm/WasmRealm.cpp", "js/src/wasm/WasmRealm.h"], "git_node": "e625be8bdbff4bf2826457b0575e8c81a916e8f4", "git_parents": ["3b05980dd7e744642a3ac184265227878837a26c"], "node": "d70b671ac26ab2e86700f6d3684631f509de4bcd", "parents": ["c5b19f643d91ade211a0cb3fc49916b6385ea96b"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-bg/strings.xml", "mobile/android/fenix/app/src/main/res/values-bqi/strings.xml", "mobile/android/fenix/app/src/main/res/values-cak/strings.xml", "mobile/android/fenix/app/src/main/res/values-cy/strings.xml", "mobile/android/fenix/app/src/main/res/values-de/strings.xml", "mobile/android/fenix/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-fr/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-gl/strings.xml", "mobile/android/fenix/app/src/main/res/values-hsb/strings.xml", "mobile/android/fenix/app/src/main/res/values-ia/strings.xml", "mobile/android/fenix/app/src/main/res/values-it/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-kk/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobi