0e11abe645ad4"], "node": "4b76e2106a0073053494599d67d44e4b93bce33c", "parents": ["33e6285c700b477b217b1cbd644c55af423075de"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056750 - Update PDF.js to 0c8f67059e1d0e06291b85a38860ae5d3723a402 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313345\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "59901daa610828367ab798dcf5dee9305afd485b", "git_parents": ["78bc695686c11a7dc2a7e7f22eaeb55264f24127"], "node": "c692921d56321e640bac0bcc797a4d1e81031066", "parents": ["4b76e2106a0073053494599d67d44e4b93bce33c"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1993744  - Refactor various asynchronous operations to support coroutine cancellation by transitioning from `suspendCoroutine` to `suspendCancellableCoroutine`. r=android-reviewers,nalexander\n\nKey changes:\n- Updated `GeckoResult.await()` to use `suspendCancellableCoroutine` and call `cancel()` on the `GeckoResult` when the coroutine is cancelled.\n- Refactored `AddressStructureRuntime` and its implementations to return `CancellableOperation`, allowing address structure requests to be cancelled.\n- Updated `ProfilerProvider`, `AddonUpdater`, `TranslationsMiddleware`, and `SplashScreenOperation` to use `suspendCancellableCoroutine`, ensuring observers are unregistered or logs are emitted upon cancellation.\n- Transitioned Google Play Integrity API requests and cookie banner support checks to use cancellable coroutines.\n- Modified `AddressEditorFragment` to explicitly cancel the engine's address structure operation if the coroutine scope is closed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D293069\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngine.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoResult.kt", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/autofill/RuntimeAddressStructureAccessor.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/GeckoEngineTest.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/engine/middleware/TranslationsMiddleware.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/autofill/AddressStructureRuntime.kt", "mobile/android/android-components/components/feature/addons/src/main/java/mozilla/components/feature/addons/update/AddonUpdater.kt", "mobile/android/android-components/components/lib/integrity-googleplay/src/main/java/mozilla/components/lib/integrity/googleplay/ext/StandardIntegrityManager.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/perf/ProfilerProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/address/AddressEditorFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/splashscreen/SplashScreenOperation.kt"], "git_node": "edb87afa2cd678909b3ba456dfbcdd63f57f09c9", "git_parents": ["59901daa610828367ab798dcf5dee9305afd485b"], "node": "fd1edc43fa62a9ca902bb89b213e7f98319d81c3", "parents": ["c692921d56321e640bac0bcc797a4d1e81031066"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets