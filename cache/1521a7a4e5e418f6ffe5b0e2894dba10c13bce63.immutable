g/web-platform/tests/css/css-viewport/zoom/reference/shape-outside-xywh-ref.html", "testing/web-platform/tests/css/css-viewport/zoom/shape-outside-circle.html", "testing/web-platform/tests/css/css-viewport/zoom/shape-outside-ellipse.html", "testing/web-platform/tests/css/css-viewport/zoom/shape-outside-inset.html", "testing/web-platform/tests/css/css-viewport/zoom/shape-outside-polygon.html", "testing/web-platform/tests/css/css-viewport/zoom/shape-outside-rect.html", "testing/web-platform/tests/css/css-viewport/zoom/shape-outside-xywh.html"], "git_node": "8ba6f490e25565d9caadefe2314b1c4359d90f64", "git_parents": ["394866f1a69702d82626a4d9f429a93233252a21"], "node": "20195f0300776c29a658704d5aa05b37264335e1", "parents": ["bf9ff9100795f44f943646a6189b3dc39788f798"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056658 [wpt PR 61450] - Update wpt metadata, a=testonly\n\nwpt-pr: 61450\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-viewport/zoom/shape-outside-circle.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/shape-outside-ellipse.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/shape-outside-inset.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/shape-outside-polygon.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/shape-outside-rect.html.ini", "testing/web-platform/meta/css/css-viewport/zoom/shape-outside-xywh.html.ini"], "git_node": "b05f8db0bff70627062822b0b3c51a9181583163", "git_parents": ["8ba6f490e25565d9caadefe2314b1c4359d90f64"], "node": "8b6eea163ddbd180b3d613434b66fba49ad5303f", "parents": ["20195f0300776c29a658704d5aa05b37264335e1"], "tags": []}, {"author": "Zhou Shuangshuang \u003cshuangshuang.zhou@intel.com\u003e", "branch": "default", "desc": "Bug 2057156 [wpt PR 61492] - Fix SelectorQuery fast path for :nth-child(0)., a=testonly\n\nAutomatic update from web-platform-tests\nFix SelectorQuery fast path for :nth-child(0).\n\nThe single-compound fast path stores :nth-child(b) as\nCompound::nth_child = b, where 0 means \"no :nth-child() constraint\".\n:nth-child(0) has b == 0, so it collided with that sentinel and was\ntreated as unconstrained: matches() and querySelectorAll() matched\neverything instead of nothing (nth indices are 1-based).\n\nTake the fast path only for b \u003e 0. :nth-child(0) and negative b match\nnothing via the full selector checker.\n\nBug: 537416059\nChange-Id: I776aab9154a0fa78d682e2d58baa9bf2d06cdde6\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8133617\nReviewed-by: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nCommit-Queue: Zhou, Shuangshuang \u003cshuangshuang.zhou@intel.com\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1666884}\n\n--\n\nwpt-commits: 6ad3fd22ea884c41c0fff2016a8d6a15249a9a67\nwpt-pr: 61492\n", "files": ["testing/web-platform/tests/css/selectors/child-indexed-pseudo-class.html"], "git_node": "e180d59f475caa6976030527d933e6eddfc01a7c", "git_parents": ["b05f8db0bff70627062822b0b3c51a9181583163"], "node": "fc0b1d008c0d083d021ba107646f1b6a9bd06dd4", "parents": ["8b6eea163ddbd180b3d613434b66fba49ad5303f"], "tags": []}, {"author": "Martin Robinson \u003cmrobinson@igalia.com\u003e", "branch": "default", "desc": "Bug 2056557 [wpt PR 61440] - stylo: Also update `AnimationState::Paused` in `Animation::update_from_other` if delay changes, a=testonly\n\nAutomatic update from web-platform-tests\nstylo: Also update `AnimationState::Paused` in `Animation::update_from_other` if delay changes\n\nThis incorporates servo/stylo#422 and adds a test case.\n\nSigned-off-by: Martin Robinson \u003cmrobinson@igalia.com\u003e\nCo-authored-by: Oriol Brufau \u003cobrufau@igalia.com\u003e\n\n--\n\nwpt-commits: ace47e783b5bb7f3a16f002707de5e4c8e31a9e7\nwpt-pr: 61440\n", "files": ["testing/web-platform/tests/css/css-animations/crashtests/update-delay-of-paused-animation.html"], "git_node": "5d0662e89f91b3bb7f01a141196b09c178d2f84e", "git_parents": ["e180d59f475caa6976030527d933e6eddfc01a7c"], "node": "1c6718e87a990fa40afae957bda9b1b98e278b58", "parents": ["fc0b1d008c0d083d021ba107646f1b6a9bd06dd4"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2057176 [wpt PR 61495] - [compression-dictionary] Add WPT test for large HTML resources., a=testonly\n\nAutomatic update from web-platform-tests\n[compression-dictionary] Add WPT test for large HTML resources.\n\nCurrently, most of the tests use the short text \"This is a test\ndictionary.\" as both dictionary content and compressed data, and the\nempty string as match destination. This CL introduces some large\npages as PNG images, HTML subframes, CSS stylesheets or JS scripts\nas well as dcb/dcz-compressed versions of each of them (using either\nitself or another one as a dictionary). The content was generated\nwith the help of Domato fuzzer and compressed with a simple Makefile.\n\nNew WPT tests are added to check they can be properly decompressed\nand used normally in a page. Dictionaries are registered using\ndestinations \"image\", \"script\", \"style\" and \"iframe\".\n\nThe Makefile and tests are written in a generic way, so that it\ncan be easy to add interesting test cases that show up in the\nfuture.\n\nBug: 522338661, 40255884\nChange-Id: I301d28c240eb303c81e3497651b6094ed7d06ca2\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8126502\nReviewed-by: Patrick Meenan \u003cpmeenan@chromium.org\u003e\nSLSA-Policy-Verified: SLSA Policy Verification Service \u003cdevtools-gerritcodereview-exitgate@google.com\u003e\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1666933}\n\n--\n\nwpt-commits: ebb8dee9d696a150d288f61f1e96577aadda126d\nwpt-pr: 61495\n", "files": ["testing/web-platform/tests/fetch/compression-dictionary/compressed-large-resources-001.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/compressed-large-resources-002.tentative.https.html", "testing/web-platform/tests/fetch/compression-dictionary/resources/compression-dictionary-util.sub.js", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/Makefile", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/dcb-header", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/dcz-header", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/image-001.png", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/image-001.png.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/script-001.js", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/script-001.js.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-image-001.png.dcb", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-image-001.png.dcb.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-image-001.png.dcz", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-image-001.png.dcz.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-script-001.js.dcb", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-script-001.js.dcb.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-script-001.js.dcz", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-script-001.js.dcz.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-style-001.css.dcb", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-style-001.css.dcb.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-style-001.css.dcz", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-style-001.css.dcz.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-subframe-001.html.dcb", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-subframe-001.html.dcb.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-subframe-001.html.dcz", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/self-compressed-subframe-001.html.dcz.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/style-001.css", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/style-001.css.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/subframe-001-compressed-by-script-001.html.dcb", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/subframe-001-compressed-by-script-001.html.dcb.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/subframe-001-compressed-by-script-001.html.dcz", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/subframe-001-compressed-by-script-001.html.dcz.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/subframe-001-compressed-by-style-001.html.dcb", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/subframe-001-compressed-by-style-001.html.dcb.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/subframe-001-compressed-by-style-001.html.dcz", "testing/web-platform/tests/fetch/compression-dictionary/resources/static/subframe-001-compressed-by-style-001.html.dcz.headers", "testing/web-platform/tests/fetch/compression-dictionary/resources/