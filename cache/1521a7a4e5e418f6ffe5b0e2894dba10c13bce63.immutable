omponents/urlbar/tests/browser/browser_downArrowKeySearch.js", "browser/components/urlbar/tests/browser/browser_dynamicResults.js", "browser/components/urlbar/tests/browser/browser_engine_used_on_search_mode.js", "browser/components/urlbar/tests/browser/browser_enter_race.js", "browser/components/urlbar/tests/browser/browser_groupLabels.js", "browser/components/urlbar/tests/browser/browser_heuristicNotAddedFirst.js", "browser/components/urlbar/tests/browser/browser_hideHeuristic.js", "browser/components/urlbar/tests/browser/browser_ime_composition.js", "browser/components/urlbar/tests/browser/browser_inputHistory.js", "browser/components/urlbar/tests/browser/browser_inputHistory_autofill.js", "browser/components/urlbar/tests/browser/browser_inputHistory_emptystring.js", "browser/components/urlbar/tests/browser/browser_keepStateAcrossTabSwitches.js", "browser/components/urlbar/tests/browser/browser_keyword.js", "browser/components/urlbar/tests/browser/browser_keywordBookmarklets.js", "browser/components/urlbar/tests/browser/browser_keywordSearch.js", "browser/components/urlbar/tests/browser/browser_keywordSearch_postData.js", "browser/components/urlbar/tests/browser/browser_keyword_override.js", "browser/components/urlbar/tests/browser/browser_keyword_select_and_type.js", "browser/components/urlbar/tests/browser/browser_less_common_selection_manipulations.js", "browser/components/urlbar/tests/browser/browser_lossless_encode.js", "browser/components/urlbar/tests/browser/browser_move_tab_to_new_window.js", "browser/components/urlbar/tests/browser/browser_new_tab_urlbar_reset.js", "browser/components/urlbar/tests/browser/browser_oneOffs.js", "browser/components/urlbar/tests/browser/browser_oneOffs_contextMenu.js", "browser/components/urlbar/tests/browser/browser_oneOffs_heuristicRestyle.js", "browser/components/urlbar/tests/browser/browser_oneOffs_keyModifiers.js", "browser/components/urlbar/tests/browser/browser_oneOffs_searchSuggestions.js", "browser/components/urlbar/tests/browser/browser_oneOffs_settings.js", "browser/components/urlbar/tests/browser/browser_pasteAndGo.js", "browser/components/urlbar/tests/browser/browser_paste_multi_lines.js", "browser/components/urlbar/tests/browser/browser_paste_then_focus.js", "browser/components/urlbar/tests/browser/browser_paste_then_switch_tab.js", "browser/components/urlbar/tests/browser/browser_percent_encoded.js", "browser/components/urlbar/tests/browser/browser_placeholder.js", "browser/components/urlbar/tests/browser/browser_primary_selection_safe_on_new_tab.js", "browser/components/urlbar/tests/browser/browser_raceWithTabs.js", "browser/components/urlbar/tests/browser/browser_readOnly.js", "browser/components/urlbar/tests/browser/browser_recentsearches.js", "browser/components/urlbar/tests/browser/browser_remotetab.js", "browser/components/urlbar/tests/browser/browser_removeUnsafeProtocolsFromURLBarPaste.js", "browser/components/urlbar/tests/browser/browser_remove_match.js", "browser/components/urlbar/tests/browser/browser_restoreEmptyInput.js", "browser/components/urlbar/tests/browser/browser_resultSpan.js", "browser/components/urlbar/tests/browser/browser_result_explanations.js", "browser/components/urlbar/tests/browser/browser_result_menu.js", "browser/components/urlbar/tests/browser/browser_result_menu_general.js", "browser/components/urlbar/tests/browser/browser_result_noTitle.js", "browser/components/urlbar/tests/browser/browser_result_onSelection.js", "browser/components/urlbar/tests/browser/browser_results_format_displayValue.js", "browser/components/urlbar/tests/browser/browser_retainedResultsOnFocus.js", "browser/components/urlbar/tests/browser/browser_revert.js", "browser/components/urlbar/tests/browser/browser_same_ref_deduplication.js", "browser/components/urlbar/tests/browser/browser_searchFunction.js", "browser/components/urlbar/tests/browser/browser_searchHistoryLimit.js", "browser/components/urlbar/tests/browser/browser_searchSettings.js", "browser/components/urlbar/tests/browser/browser_searchSingleWordNotification.js", "browser/components/urlbar/tests/browser/browser_searchSuggestions.js", "browser/components/urlbar/tests/browser/browser_searchTelemetry.js", "browser/components/urlbar/tests/browser/browser_search_bookmarks_from_bookmarks_menu.js", "browser/components/urlbar/tests/browser/browser_search_continuation.js", "browser/components/urlbar/tests/browser/browser_search_history_from_history_panel.js", "browser/components/urlbar/tests/browser/browser_secondaryActions.js", "browser/components/urlbar/tests/browser/browser_selectStaleResults.js", "browser/components/urlbar/tests/browser/browser_selectionKeyNavigation.js", "browser/components/urlbar/tests/browser/browser_separatePrivateDefault.js", "browser/components/urlbar/tests/browser/browser_separatePrivateDefault_differentEngine.js", "browser/components/urlbar/tests/browser/browser_shortcuts_add_search_engine.js", "browser/components/urlbar/tests/browser/browser_slow_heuristic.js", "browser/components/urlbar/tests/browser/browser_speculative_connect.js", "browser/components/urlbar/tests/browser/browser_stopSearchOnSelection.js", "browser/components/urlbar/tests/browser/browser_suggestedIndex.js", "browser/components/urlbar/tests/browser/browser_switchToTabHavingURI_aOpenParams.js", "browser/components/urlbar/tests/browser/browser_switchToTab_chiclet.js", "browser/components/urlbar/tests/browser/browser_switchToTab_closed_tab.js", "browser/components/urlbar/tests/browser/browser_switchToTab_closes_newtab.js", "browser/components/urlbar/tests/browser/browser_switchToTab_fullUrl_repeatedKeydown.js", "browser/components/urlbar/tests/browser/browser_tabMatchesInAwesomebar.js", "browser/components/urlbar/tests/browser/browser_tabMatchesInAwesomebar_perwindowpb.js", "browser/components/urlbar/tests/browser/browser_tabToSearch.js", "browser/components/urlbar/tests/browser/browser_testUrlbarIcons.js", "browser/components/urlbar/tests/browser/browser_text_dont_shift_on_mousedown.js", "browser/components/urlbar/tests/browser/browser_top_sites_switchtab.js", "browser/components/urlbar/tests/browser/browser_trust_panel.js", "browser/components/urlbar/tests/browser/browser_trust_panel_cert_exception.js", "browser/components/urlbar/tests/browser/browser_trust_panel_focus.js", "browser/components/urlbar/tests/browser/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser/browser_trust_panel_pages.js", "browser/components/urlbar/tests/browser/browser_trust_panel_security_view.js", "browser/components/urlbar/tests/browser/browser_typed_value.js", "browser/components/urlbar/tests/browser/browser_unitConversion.js", "browser/components/urlbar/tests/browser/browser_urlbar_contextmenu.js", "browser/components/urlbar/tests/browser/browser_urlbar_selection.js", "browser/components/urlbar/tests/browser/browser_userTypedValue.js", "browser/components/urlbar/tests/browser/browser_valueOnTabSwitch.js", "eslint-rollouts.config.mjs", "tools/lint/rejected-words.yml"], "git_node": "9af722aece91803233316594567ab746e0206d94", "git_parents": ["36960e0ed3befac428004299158485232aad772b"], "node": "43662eeba41689275ec9954c8593dd8ad9455dec", "parents": ["fe08515263adc4ffacebcaf88738bdcb1f079218"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2054145 - Apply PollJSSampling's JS engine calls without the thread data lock held, r=profiler-reviewers,canova.\n\nA DOM Worker clearing its JSContext ran PollJSSampling() under its\nThreadRegistration data lock, and PollJSSampling calls into the JS engine\n(js::EnableContextProfilingStack -\u003e ReleaseAllJITCode -\u003e\nCancelOffThreadIonCompile), which blocks on the JS helper threads. The\nSamplerThread holds gPSMutex and blocks acquiring that same data lock, so every\nthread that needs gPSMutex to register/unregister -- including the helper the\nworker waits on -- is stuck. Circular wait.\n\nSplit PollJSSampling into TakeJSSamplingChange() (flips mJSSampling under the\ndata lock) and ApplyJSSamplingChange() (makes the js::Enable* calls). The\ncurrent-thread poll path now takes the data lock only for the state flip and\napplies the JS-engine change with no lock held, mirroring the existing 'drop\nthe global profiler mutex before calling into the JS engine' discipline.\n\nHolding the data lock across the enable path also served as serialization: the\nSamplerThread takes that same lock before sampling the thread, so it never\nobserved a half-applied enable. Making the js::Enable* calls without the lock\nloses that, letting the sampler walk a thread whose JS sampling state is only\npartly set up -- e.g. a Baseline Interpreter frame whose JitScript has not yet\nbeen given its profiler label string, tripping the profileString_ assertion in\nJitScript. Restore the guarantee by suppressing this thread's sampling across\nEnableContextProfilingStack with AutoSuppressProfilerSampling, which takes no\nlock and so cannot deadlock.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311644\n", "files": ["js/src/vm/GeckoProfiler.cpp", "tools/profiler/core/ProfilerThreadRegistrationData.cpp", "tools/profiler/core/platform.cpp", "tools/profiler/public/ProfilerThreadRegistrationData.h"], "git_node": "751114823990e4fc24e93d18290c1e09ffae59a7", "git_parents": ["9af722aece91803233316594567ab746e0206d94"], "node": "7ace2a9fb1b85fc96f8eb677510c977e4f724e7b", "parents": ["43662eeba41689275ec9954c8593dd8ad9455dec"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056908 - Fix slack notifications for macrobenchmark tests and baseline profile generation r=releng-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313477\n", "files": ["taskcluster/kinds/generate-baseline-profile-firebase/kind.yml", "taskcluster/kinds/run-macrobenchmark-firebase/kind.yml"], "git_node": "eb86d467608c7beb8104a18ef7142ebdce2c3177", "git_parents": ["751114823990e4fc24e93d18290c1e09ffae59a7"], "node": "611c78d681264a2c8db4603ef9b2168a382327bf", "parents": ["7ace2a9fb1b85fc96f8eb677510c977e4f724e7b"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2056791: Handle larger mDNS addresses than we use. r=mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313577\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate.cpp"], "git_node": "517f11b62f2ddb31631159cf886ddd96c729b584", "git_parents": ["eb86d467608c7beb8104a18ef7142ebdce2c3177"], "node": "066e398d8b4023631d29123cb6245ea91c5b3981", "parents": ["611c78d681264a2c8db4603ef9b2168a382327bf"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056573 - Recreate IMEContentObserver when switching between EditContext/non-EditContext editor. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313311\n", "files": ["dom/base/Document.cpp", "dom/events/IMEContentObserver.cpp", "dom/events/IMEContentObserver.h", "dom/html/EditContext.cpp", "dom/html/EditContext.h", "dom/html/nsGenericHTMLElement.cpp", "editor/libeditor/HTMLEditor.cpp", "editor/libeditor/tests/edit-context/test_editcontext_ime_notifications.html", "testing/web-platform/tests/editing/edit-context/edit-context-detach-from-contenteditable-crash.html"], "git_node": "c50f0081c164b423379fd492be47334e9552ba28", "git_parents": ["517f11b62f2ddb31631159cf886ddd96c729b584"], "node": "642a98307437242c804a6450848444835a142055", "parents": ["066e398d8b4023631d29123cb6245ea91c5b3981"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054869 - Ensure paste goes to new editor if active EditContext changes during paste handler. r=masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312755\n", "files": ["editor/libeditor/EditorBase.cpp", "editor/libeditor/EditorBase.h", "testing/web-platform/tests/editing/edit-context/edit-context-paste-handler-changes-active.tentative.html"], "git_node": "1df412748d9f671769d41dd79ba23ba35907a908", "git_parents": ["c50f0081c164b423379fd492be47334e9552ba28"], "node": "891bb4d0b980ea8aded73d795b9fe550a6708ec1", "parents": ["642a98307437242c804a6450848444835a142055"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050218 - Better handling of when EditContext character bounds aren't available synchronously. r=masayuki\n\nSpecifically, we now use nearby character bounds if possible,\ndon't notify IME of anything until the characters are provided, and\nemit a warning in the console so that developers are aware of the\nissue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311917\n", "files": ["dom/html/EditContext.cpp", "dom/html/EditContext.h", "dom/locales/en-US/chrome/dom/dom.properties", "editor/libeditor/tests/edit-context/test_editcontext_fallback_bounds.html", "editor/libeditor/tests/edit-context/test_editcontext_ime_notifications.html", "editor/libeditor/tests/edit-context/test_editcontext_redundant_characterboundsupdate.html", "modules/libpref/init/all.js"], "git_node": "829756fa0636f5cefacf60a592c96ab3ad66282c", "git_parents": ["1df412748d9f671769d41dd79ba23ba35907a908"], "node": "9c8bb4f93698d3ddf968ea112e8c39dfd787c535", "parents": ["891bb4d0b980ea8aded73d795b9fe550a6708ec1"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2044682 - Replace JS::JitCodeRecord lookup with a per-entry source info table r=mgaudet,mstange\n\nAdd a reusable per-entry source-position table (JitCodeSourceInfo) that\na JitcodeGlobalEntry can own directly, which replaces the global\nJS::JitCodeRecord side table for the profiler's JIT line/column lookups.\nThis mirrors how IonEntry already owns its `regionTable_`. Currently\nit's used only for the baseline entries, but it's tier-agnostic so other\nentry kinds can use the same pattern later. Ion currently doesn't use\nPerfSpewer data due to the fact that it doesn't has any inlined frame\ninformation.\n\nThis is an improvement over the older lookup (JS::LookupJitCodeRecord)\nbecause that one had to take a PerfMutex lock every time it needed this\ninformation which could results in a deadlock.\n\nextractSourceInfo() builds the table from the per-op data PerfSpewer\nalready collects in `debugInfo_`, moved onto the entry at construction,\nand callStackAtAddr does an O(log n) search over the entry's own\nimmutable data with no shared mutex on the sampler path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309848\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/JitCodeSourceInfo.h", "js/src/jit/JitcodeMap.cpp", "js/src/jit/JitcodeMap.h", "js/src/jit/PerfSpewer.cpp", "js/src/jit/PerfSpewer.h"], "git_node": "03bef9fcb49ac1e2d9f3379aef66ed8153565911", "git_parents": ["829756fa0636f5cefacf60a592c96ab3ad66282c"], "node": "7d05f905ad99eee15e658bb0f1c5db0e3fb5e7d4", "parents": ["9c8bb4f93698d3ddf968ea112e8c39dfd787c535"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2044682 - Delete the JS::JitCodeRecord global side table r=mgaudet,mstange\n\nNothing reads the `JS::JitCodeRecord` table anymore. BaselineEntry's\n`sourceInfo_` and IonEntry's `regionTable_` each own their source-position\ndata, so this table is just not needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309850\n", "files": ["js/public/JitCodeAPI.h", "js/src/jit/JitcodeMap.cpp", "js/src/jit/PerfSpewer.cpp", "js/src/jit/PerfSpewer.h", "js/src/moz.build"], "git_node": "0ada818d62fd850a2645248366bb21b22c67b99d", "git_parents": ["03bef9fcb49ac1e2d9f3379aef66ed8153565911"], "node": "db9c282a6ba461c0db5ebc18a504a848205368f3", "parents": ["7d05f905ad99eee15e658bb0f1c5db0e3fb5e7d4"], "tags": []}, {"author": "Naz\u0131m Can Alt\u0131nova \u003ccanaltinova@gmail.com\u003e", "branch": "default", "desc": "Bug 2044682 - Revert the PerfSpewer profiler-suppression workaround r=jonco\n\nBug 2038577 disabled the profiler while holding the PerfSpewer mutex to\navoid re-entering the engine when a native memory allocation hook called\n`JS::LookupJitCodeRecord`, which itself took the PerfSpewer lock.\n\nNow that the `JS::JitCodeRecord` global side table and its lookup are\ngone, that re-entrancy path no longer exists, so the workaround is\nunnecessary. This reverts that commits to restore AutoLockPerfSpewer to\na plain mutex guard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310321\n", "files": ["js/src/jit/PerfSpewer.cpp", "js/src/jit/PerfSpewer.h", "js/src/vm/GeckoProfiler-inl.h", "js/src/vm/GeckoProfiler.h"], "git_node": "4783e949f18e664cb8aaaba5fed23c179b58704a", "git_parents": ["0ada818d62fd850a2645248366bb21b22c67b99d"], "node": "31c07a469b1a3d39a21bc650c32e9518afc6f203", "parents": ["db9c282a6ba461c0db5ebc18a504a848205368f3"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035579 - Wire rusttests through the build system to link in-tree native libraries r=nalexander,firefox-build-system-reviewers\n\nRust tests may depend on native libraries built elsewhere in the tree,\nboth at link time and at run time. Make `RustTests` a `Linkable` so it can\ncarry `USE_LIBS`, and have the emitter and recursivemake backend turn\nthose `USE_LIBS` into build ordering dependencies via a shared\n`_add_rust_build_order_deps`. Cargo still performs the actual linking, so\nthe `USE_LIBS` only guarantee the dependencies are built ahead of the\ntests.\n\nA dependency may produce generated files during the `pre-compile` tier,\nwhich the `rusttests` build did not run. Add `pre-compile` to its `ALL_TIERS`\nso those prerequisites exist before the tests build.\n\nAt test time the binaries find their shared library dependencies via an\nrpath to dist/bin on Linux and macOS, or libraries staged next to them\non Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311624\n", "files": ["config/baseconfig.mk", "config/makefiles/rust.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py"], "git_node": "8fbdafb9045d34d29bb1f5c57dc631e81ce8f75e", "git_parents": ["4783e949f18e664cb8aaaba5fed23c179b58704a"], "node": "4c41f7284bc6d006f24170e9f1859bef458542ad", "parents": ["31c07a469b1a3d39a21bc650c32e9518afc6f203"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2055911: Implement RTCTransportStats.selectedCandidatePairChanges r=ng,webidl,tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312835\n", "files": ["dom/media/webrtc/WebrtcGlobal.h", "dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/tests/mochitests/stats.js", "dom/webidl/RTCStatsReport.webidl", "testing/web-platform/meta/webrtc-stats/supported-stats.https.html.ini"], "git_node": "39a731af7bbe3332584f027a4016363c3c5ca405", "git_parents": ["8fbdafb9045d34d29bb1f5c57dc631e81ce8f75e"], "node": "2d4944f86b80231738af561da654a959540469eb", "parents": ["4c41f7284bc6d006f24170e9f1859bef458542ad"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2053297: Start RTCTransportStats.iceState in \"new\" r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312836\n", "files": ["dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "testing/web-platform/meta/webrtc/RTCPeerConnection-transport-stats.https.html.ini"], "git_node": "f3d9cb6ba7756a0d0dbf46606c4e9051631dcd0c", "git_parents": ["39a731af7bbe3332584f027a4016363c3c5ca405"], "node": "4aca61635aa9319998811b1bcdf4303c044aacd9", "parents": ["2d4944f86b80231738af561da