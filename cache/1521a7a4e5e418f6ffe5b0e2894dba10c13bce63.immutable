rts macro in dom/xslt r=dom-core-reviewers,farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305337\n", "files": ["dom/xslt/xpath/XPathResult.h", "dom/xslt/xslt/txMozillaXSLTProcessor.h"], "git_node": "45d1412b9ad4ecbdde14a5f6d9d36332146a15a0", "git_parents": ["f32bbbb0141683de0370af6eafb40f37c34bdf52"], "node": "52b270602fdb2348bd2ce87f93f7527acc5f4ac7", "parents": ["b6e05067be1d174771bb4486f6fe5dab1babd738"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2045043 - Part 60 - Ensure bindings uses isupports cycle collecting FINAL macros on final classes r=dom-core-reviewers,farre,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305338\n", "files": ["dom/bindings/Codegen.py", "dom/bindings/Exceptions.cpp", "dom/bindings/SimpleGlobalObject.h", "dom/bindings/test/TestInterfaceAsyncIterableDouble.h", "dom/bindings/test/TestInterfaceAsyncIterableDoubleUnion.h", "dom/bindings/test/TestInterfaceIterableDouble.h", "dom/bindings/test/TestInterfaceIterableDoubleUnion.h", "dom/bindings/test/TestInterfaceIterableSingle.h", "dom/bindings/test/TestInterfaceMaplike.h", "dom/bindings/test/TestInterfaceMaplikeJSObject.h", "dom/bindings/test/TestInterfaceMaplikeObject.h", "dom/bindings/test/TestInterfaceSetlike.h", "dom/bindings/test/TestInterfaceSetlikeNode.h"], "git_node": "91444883b762e6d5f780ad7457d010e3299e08e8", "git_parents": ["45d1412b9ad4ecbdde14a5f6d9d36332146a15a0"], "node": "85f6b7b21b540c2af71266b921132c1231b9463f", "parents": ["52b270602fdb2348bd2ce87f93f7527acc5f4ac7"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2056836 - Keep the highlighted URL layout in sync with text changes r=android-reviewers,pollymce\n\nRemeasure the displayed URL when its text, style, or viewport width changes.\nThis prevents domain ranges from the current URL from being applied to a stale TextLayoutResult.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313504\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/HighlightedDomainUrl.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/ui/HighlightedDomainUrlLayoutTest.kt"], "git_node": "aee4706c23ae17a054d00c0ae115d1a634007198", "git_parents": ["91444883b762e6d5f780ad7457d010e3299e08e8"], "node": "6c688254fe2d9b1568186d09e5ad2a3c1a35d1d0", "parents": ["85f6b7b21b540c2af71266b921132c1231b9463f"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043189 - Part 1: Add SearchEngineStore. r=Standard8,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304811\n", "files": ["browser/components/search/SearchUIUtils.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SearchEngineStore.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/jar.mn", "browser/components/urlbar/tests/unit/test_searchEngineStore.js", "browser/components/urlbar/tests/unit/xpcshell.toml", "toolkit/components/search/SearchService.sys.mjs", "tools/@types/generated/tspaths.json"], "git_node": "29d38f920f3e0554752478d30e9df6d14bac961d", "git_parents": ["aee4706c23ae17a054d00c0ae115d1a634007198"], "node": "d6fc92477579daf836efc06cd595cced13a81995", "parents": ["6c688254fe2d9b1568186d09e5ad2a3c1a35d1d0"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043189 - Part 2: Use SearchEngineStore instead of SearchService in urlbar content modules. r=urlbar-reviewers,mlucks,search-reviewers,scunnane,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306828\n", "files": ["browser/base/content/browser-init.js", "browser/components/BrowserComponents.manifest", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_chat_active_navigate.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_input_cta.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/search/BrowserSearchTelemetry.sys.mjs", "browser/components/search/SearchUIUtils.sys.mjs", "browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarInput.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-search/browser_placeholder.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js"], "git_node": "f171dc9ad1a50cb56cc1a2ff234469fa19c6ac01", "git_parents": ["29d38f920f3e0554752478d30e9df6d14bac961d"], "node": "278ca19bf5986909fad837ff5fb7ecaf3a751c5f", "parents": ["d6fc92477579daf836efc06cd595cced13a81995"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055661 - Use zero touch start/move tolerance on wpt. r=botond,whimboo\" for causing wpt failures @ pointerevent_fractional_coordinates.html\n\nThis reverts commit 4b4a3076a0b8d1cb8bd7cc6628654192dc144edd.\n", "files": ["remote/shared/RecommendedPreferences.sys.mjs", "testing/marionette/client/marionette_driver/geckoinstance.py", "testing/profiles/web-platform/user.js"], "git_node": "a5ffa2529beb42cc4ce4de491ee47a59ff6a08df", "git_parents": ["f171dc9ad1a50cb56cc1a2ff234469fa19c6ac01"], "node": "1a50ec7fceccc07865337d36610de4a11b1808e4", "parents": ["278ca19bf5986909fad837ff5fb7ecaf3a751c5f"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056837 - [loong64] Part 1: Port D311458 to loong64. r=jseward\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313414\n", "files": ["js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "1b154dcdc1716c84543da5f44a5834d06b2ae92c", "git_parents": ["a5ffa2529beb42cc4ce4de491ee47a59ff6a08df"], "node": "01a29d4bc4a43c4e91e5fdeb77bc557a4c2dc77a", "parents": ["1a50ec7fceccc07865337d36610de4a11b1808e4"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056837 - [mips64] Part 2: Port D311458 to mips64. r=jseward\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313415\n", "files": ["js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "8b5157337be71be8e9ca6fcdeed09e9b2380c1e7", "git_parents": ["1b154dcdc1716c84543da5f44a5834d06b2ae92c"], "node": "aa6158072fc1c982cc6cc650540432ffc6b96e02", "parents": ["01a29d4bc4a43c4e91e5fdeb77bc557a4c2dc77a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2056837 - Part 3: Clean up unused usings and stale comments. r=jseward\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313416\n", "files": ["js/src/wasm/WasmCodegenTypes.cpp", "js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "faf0038a4f784b074c26aa4965c04f264d7fd39b", "git_parents": ["8b5157337be71be8e9ca6fcdeed09e9b2380c1e7"], "node": "d4e3a5108e474f2ed17e79dfbc834a730ef161b3", "parents": ["aa6158072fc1c982cc6cc650540432ffc6b96e02"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057178 - Make \u003csplitter\u003e handle items in Grid container. r=emilio,layout-reviewers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312251\n", "files": ["layout/xul/nsSplitterFrame.cpp", "layout/xul/test/test_splitter_sibling.xhtml"], "git_node": "469ab59699d3c630b4e2e88433ef7fd319fa6d4e", "git_parents": ["faf0038a4f784b074c26aa4965c04f264d7fd39b"], "node": "e1b7e90e1965dae048c5659ec306db7460520218", "parents": ["d4e3a5108e474f2ed17e79dfbc834a730ef161b3"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2036402 - Apply std::move in layout/painting where values can be moved instead of copied r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313231\n", "files": ["layout/painting/nsDisplayList.cpp"], "git_node": "09c28df335f659047fa9496f269b82b84b761cc1", "git_parents": ["469ab59699d3c630b4e2e88433ef7fd319fa6d4e"], "node": "cc55eb0b08d7acd06174ac001526ddd79bb705c8", "parents": ["e1b7e90e1965dae048c5659ec306db7460520218"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2052854 - firefox-desktop-frontend skill: point to docs/performance/bestpractices.md for performance guidance r=ai4dev-reviewers,suhaib DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310637\n", "files": [".agents/skills/firefox-desktop-frontend/SKILL.md", ".claude/skills/firefox-desktop-frontend/SKILL.md"], "git_node": "24c72c84147ca285e1391ecc6626bb75f26211f6", "git_parents": ["09c28df335f659047fa9496f269b82b84b761cc1"], "node": "3fc6640143dedd9e52ea6a047fd87b26700c65b5", "parents": ["cc55eb0b08d7acd06174ac001526ddd79bb705c8"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2001799 - Make the cargo-audit lint test resilient to advisory database changes. r=linter-reviewers,ahal DONTBUILD\n\nThe test runs against the live RustSec advisory database, so the exact\nnumber of advisories matching the checked-in .lock fixtures changes over\ntime as new advisories are published. Assert only that the known set of\nadvisories is present instead of an exact count, and surface guidance to\nfile a new bug blocking bug 1747536 rather than treating the failure as a\nbackout-able regression.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313013\n", "files": ["tools/lint/test/test_cargo-audit.py"], "git_node": "288ca372209b9645c791e3ec203c7314613f6723", "git_parents": ["24c72c84147ca285e1391ecc6626bb75f26211f6"], "node": "c58bf33811446c44e5f5c10a7435ef916affd578", "parents": ["3fc6640143dedd9e52ea6a047fd87b26700c65b5"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2001799 - Improve the cargo-audit linter error message when the advisory database can't be loaded. r=linter-reviewers,ahal DONTBUILD\n\nA non-zero exit code with no output usually means cargo-audit could not\nload the RustSec advisory database (for example because it contains an\nadvisory in a format the pinned cargo-audit version cannot parse). Make\nthe failure readable and point at bug 1747536 so it isn't mistaken for a\nregression caused by a specific push.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313014\n", "files": ["tools/lint/cargo-audit/__init__.py"], "git_node": "983b70faaf6902b4f6324e19caaa59adebe0a7f6", "git_parents": ["288ca372209b9645c791e3ec203c7314613f6723"], "node": "b5d4c8800e330cd51149ad44fb0b3c1be7a3e409", "parents": ["c58bf33811446c44e5f5c10a7435ef916affd578"], "tags": []}, {"author": "alin lastun \u003calastun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046202 - Connect showOnboardingBottomSheet Nimbus flag in IPProtectionPromptRepository. r=android-reviewers,twhite\n\nExpose the showOnboardingBottomSheet property via Settings and integrate it into canShowIPProtectionPrompt inside IPProtectionPromptRepository. This ensures the prompt logic correctly checks Nimbus experiment eligibility before displaying the onboarding bottom sheet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313427\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionPromptRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/FakeIPProtectionPromptRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPromptTest.kt"], "git_node": "4e21d47c6033ea4f481e9c9877482d9cde335dca", "git_parents": ["983b70faaf6902b4f6324e19caaa59adebe0a7f6"], "node": "1c041abb07af526f1e2bd42b107bbbb9d837650f", "parents": ["b5d4c8800e330cd51149ad44fb0b3c1be7a3e409"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057147 - Update android nightly application-services version bump to b5f89b3d24b62a16efc06c7a17140f835b6c22c7 r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313663\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "f0ecca3de6ca581b0ffc472d53573b69b457fe4c", "git_parents": ["4e21d47c6033ea4f481e9c9877482d9cde335dca"], "node": "bc4d0ded329b3012f2c7e1302c60aa00f135761e", "parents": ["1c041abb07af526f1e2bd42b107bbbb9d837650f"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050159 - [devtools] add mdn icon to learn more links in webconsole r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308592\n", "files": ["devtools/client/debugger/test/mochitest/sourcemaps/browser_dbg-sourcemaps-redirect.js", "devtools/client/shared/components/MdnLink.css", "devtools/client/themes/webconsole.css", "devtools/client/webconsole/components/Output/Message.js", "devtools/client/webconsole/test/browser/browser_console_dead_objects.js", "devtools/client/webconsole/test/browser/browser_webconsole_previewers.snapshot.mjs", "devtools/client/webconsole/test/browser/browser_webconsole_sourcemap_nosource.js"], "git_node": "33c6a6af7ed66c5d63e1c1ac08b56d467d0858eb", "git_parents": ["f0ecca3de6ca581b0ffc472d53573b69b457fe4c"], "node": "23c6d5c8245e025573f1017963a0dabfae529691", "parents": ["bc4d0ded329b3012f2c7e1302c60aa00f135761e"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2052618 - Fix shadowed style variable in GetWidgetRootStyle for GTK \u003c 3.20. r=stransky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313662\n", "files": ["widget/gtk/GtkWidgets.cpp"], "git_node": "31eeab242a98c0578fabadc5c99ebf1bc4d30581", "git_parents": ["33c6a6af7ed66c5d63e1c1ac08b56d467d0858eb"], "node": "b4b8ed44ea8c6d335f9545be50c399591eee7ea7", "parents": ["23c6d5c8245e025573f1017963a0dabfae529691"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Add an onProviderEngagement notification so content can await a provider's engagement side effect. r=daleharvey\n\nProvider `onEngagement` hooks run parent-side, so a provider's engagement side\neffect (e.g. `UrlbarProviderUnitConversion` copying its result to the clipboard)\nlands on the content side asynchronously over the actor message path, with no\nsignal content can wait on. Add a controller notification, `onProviderEngagement`,\nfired once the picked result's provider has handled the engagement, so\ncontent-side listeners can await that the side effect has run. It fires\nsynchronously on the direct path and after the actor round-trip on the message\npath, riding the existing controller notification bus.\n\n`UrlbarTestUtils.promiseProviderEngagement` wraps it for tests, so a test can\nawait a provider's engagement side effect instead of polling for it:\n`browser_unitConversion.js` before reading the clipboard, `browser_result_menu.js`\nbefore asserting the dismissed result was removed, `browser_action_tabgroups.js`\nbefore asserting the group expanded or the tab switched, and\n`browser_secondaryActions.js`, `browser-quickactions/browser_general.js` and\n`browser_contextualsearch.js` before asserting a quickaction's callback ran. The\nnotification is behavior-neutral on the direct path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311533\n", "files": ["browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-quickactions/browser_general.js", "browser/components/urlbar/tests/browser-results/browser_result_menu.js", "browser/components/urlbar/tests/browser-results/browser_secondaryActions.js", "browser/components/urlbar/tests/browser-results/browser_unitConversion.js", "browser/components/urlbar/tests/browser-search/browser_contextualsearch.js", "browser/components/urlbar/tests/browser-tabs/browser_action_tabgroups.js"], "git_node": "1e0807cb0b8d93d26b520b6c6e38cf70ad33a54a", "git_parents": ["31eeab242a98c0578fabadc5c99ebf1bc4d30581"], "node": "e1c5612572b25faac5cd4ad5cfd6e29a1080a302", "parents": ["b4b8ed44ea8c6d335f9545be50c399591eee7ea7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Search the selected search-mode engine on Enter instead of a stale heuristic. r=daleharvey\n\nIn an engine search mode, Enter navigated using the view's heuristic result.\nOn the message path a search-mode change re-queries asynchronously, so the\nauto-selected heuristic can still carry the previously-cycled engine when Enter\nfires, navigating to the wrong engine (surfacing as browser_searchModeSwitcher_basic\nreaching the real Wikipedia engine and tripping the harness's non-local-connection\nguard).\n\nMake the selected search-mode engine authoritative: when Enter would pick the\nheuristic in an engine search mode, search the current engine directly. The\none-off branch's engine-search (query URL + search recording + form history) is\nextracted into a shared helper the search-mode path reuses.\n\nOpening the engine's search URL directly skips the result-pick path that tags\nthe load with globalHistoryOptions.triggeringSearchEngine, which Places uses to\nrecord the visit source as a search. The shared helper now sets that tag, so\nsearch-mode Enter keeps annotating the visit. This also fixes a pre-existing\nbug: the one-off path already opened the URL directly and never set the tag, so\none-off searches were recorded as organic visits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310464\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInput.mjs"], "git_node": "9736d4430690d84a47e6697b2fde6be396412ed4", "git_parents": ["1e0807cb0b8d93d26b520b6c6e38cf70ad33a54a"], "node": "e0f9b7bf2aef59f53d0c444e2384cce76bdbceae", "parents": ["e1c5612572b25faac5cd4ad5cfd6e29a1080a302"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055850 - passing inference params via defined parameter inferenceParams r=simonf,ai-platform-reviewers,mshillabeer,valentinp,ai-security-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312773\n", "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/memories/Memories.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesManager.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesSchemas.sys.mjs", "browser/components/aiwindow/models/memories/moz.build", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_conversation_stream.js", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js", "browser/components/aiwindow/models/tests/xpcshell/test_Conversation.js", "toolkit/components/ml/content/backends/OpenAIPipeline.mjs"], "git_node": "489a6bd8c2fa11d856c8878b3b9bf7ea05aebb5e", "git_parents": ["9736d4430690d84a47e6697b2fde6be396412ed4"], "node": "599683cd0d88efaf26b9da56c14256550ffe7024", "parents": ["e0f9b7bf2aef59f53d0c444e2384cce76bdbceae"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1797215 - [Taskcluster] Extend the async-event-dispatching variant for async touch events. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312492\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "f436228803a204c2ca811d3eac3d8413ef179c6f", "git_parents": ["489a6bd8c2fa11d856c8878b3b9bf7ea05aebb5e"], "node": "908c75249a6c5d384cf110a75f62d0fb1234c168", "parents": ["599683cd0d88efaf26b9da56c14256550ffe7024"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1797215 - Update JSDoc for EventUtils.js. r=hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D284831\n", "files": ["testing/mochitest/tests/SimpleTest/EventUtils.js"], "git_node": "60adb4ba39679d6f318d8b6c59a980a5218e1bbf", "git_parents": ["f436228803a204c2ca811d3eac3d8413ef179c6f"], "node": "6340bef31df785a87f51aaf511597f2bf520901e", "parents": ["908c75249a6c5d384cf110a75f62d0fb1234c168"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1797215 - [remote] Add support for async touch events to Marionette and WebDriver BiDi. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D284832\n", "files": ["remote/marionette/actors/MarionetteCommandsChild.sys.mjs", "remote/marionette/driver.sys.mjs", "remote/shared/webdriver/Actions.sys.mjs", "remote/shared/webdriver/Event.sys.mjs", "remote/webdriver-bidi/modules/root/input.sys.mjs", "remote/webdriver-bidi/modules/windowglobal/input.sys.mjs"], "git_node": "0318fa635065e3b5fbce4297de2778e6a1633f98", "git_parents": ["60adb4ba39679d6f318d8b6c59a980a5218e1bbf"], "node": "0dfe4b16f1ec7973515ea6c7f888777bb59bb0df", "parents": ["6340bef31df785a87f51aaf511597f2bf520901e"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1797215 - [wdspec] Run WebDriver classic \"Perform Actions\" tests for touch input in a new tab. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313698\n", "files": ["testing/web-platform/tests/webdriver/tests/classic/perform_actions/pointer_touch.py"], "git_node": "09491f779d0fa351ca1635cefbe909edf3aff10e", "git_parents": ["0318fa635065e3b5fbce4297de2778e6a1633f98"], "node": "0e294898374aaf35415a6bd3bc6ede6781828266", "parents": ["0dfe4b16f1ec7973515ea6c7f888777bb59bb0df"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052861 - Gate Link Preview key points on llama.cpp support r=gregtatum,flozia\n\nLink Preview key-points are now skipped for users running non-AVX2 hardware.\nKey-points users now only run native llama.cpp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311367\n", "files": ["browser/components/genai/LinkPreview.sys.mjs", "browser/components/genai/LinkPreviewModel.sys.mjs", "browser/components/genai/tests/browser/browser_link_preview.js", "browser/components/genai/tests/browser/browser_link_preview_aifeature_lifecycle.js", "browser/components/genai/tests/browser/browser_link_preview_optin.js", "browser/components/genai/tests/browser/browser_link_preview_telemetry.js"], "git_node": "a629590