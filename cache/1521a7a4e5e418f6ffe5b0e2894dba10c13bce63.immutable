sys.mjs", "browser/components/aiwindow/models/moz.build", "browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build"], "git_node": "44743873c431be484e85b574d4554d82d06b2fb9", "git_parents": ["7ab324f90e1523fbb53a5a588c3d06a8136dbdbb"], "node": "765abfa1f8f9db60f8b72568834d40291ea228f0", "parents": ["7b6b05d3f05185c892b8c724b3a5a827e91625de"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056036 Part 1 - Rename FrameChildListID::OverflowOutOfFlow to OverflowFloats and co. r=layout-reviewers,dshin\n\nThe list only ever holds float frames but not other out-of-flow frames. To avoid\nconfusion, rename the list ID and related helpers.\n\nThis doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315662\n", "files": ["layout/base/nsLayoutUtils.cpp", "layout/generic/ScrollAnchorContainer.cpp", "layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h", "layout/generic/nsFrameList.cpp", "layout/generic/nsFrameList.h", "layout/generic/nsFrameStateBits.h"], "git_node": "c23c6c19fede3538edfe27fac3fbf078d860096c", "git_parents": ["44743873c431be484e85b574d4554d82d06b2fb9"], "node": "fd876ab63c77343400be20eaf342eef8f606c115", "parents": ["765abfa1f8f9db60f8b72568834d40291ea228f0"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056036 Part 2 - Add HasOverflowFloats(), and rewrite MaybeHasFloats(). r=layout-reviewers,dshin\n\nAfter Part 1, the overflow floats list is known to hold only floats, so this\npatch simplifies `MaybeHasFloats()` and rename it to `HasAnyFloats()`. Note that\n`HasFloats()` is taken to test the `FloatsProperty`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315663\n", "files": ["layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h"], "git_node": "dc8e1048b017b49dad401c59d3dd160df681b17d", "git_parents": ["c23c6c19fede3538edfe27fac3fbf078d860096c"], "node": "7272e5dd1ebfa587a8425b2c8ffa6fed63dfe02f", "parents": ["fd876ab63c77343400be20eaf342eef8f606c115"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056036 Part 3 - Rename nsAutoOOFFrameList to AutoOverflowFloatsList. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315664\n", "files": ["layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h"], "git_node": "a335fe64e6e26694404e236c5cbedcacf5e1aba0", "git_parents": ["dc8e1048b017b49dad401c59d3dd160df681b17d"], "node": "a039dd0a64c44300b7f43ae8bed4303b8456a6bd", "parents": ["7272e5dd1ebfa587a8425b2c8ffa6fed63dfe02f"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045762. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315754\n", "files": ["gfx/skia/skia/src/core/SkBlitBWMaskTemplate.h", "gfx/skia/skia/src/ports/SkFontHost_cairo.cpp"], "git_node": "765defc06554526f71e09fe134e152ca2f5932d4", "git_parents": ["a335fe64e6e26694404e236c5cbedcacf5e1aba0"], "node": "38164be1556ee92b932b214cd6412665f1e19d6b", "parents": ["a039dd0a64c44300b7f43ae8bed4303b8456a6bd"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055009 - Smart Form Fill core form/field detection and filling, with mocked LLM requests r=mlucks,mshillabeer\" for causing bc tests failures at browser_startup.js\n\nThis reverts commit 44743873c431be484e85b574d4554d82d06b2fb9.\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/models/SmartFormFillModel.sys.mjs", "browser/components/aiwindow/models/moz.build", "browser/components/aiwindow/ui/actors/SmartFormFillChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartFormFillParent.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillController.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillDocument.sys.mjs", "browser/components/aiwindow/ui/modules/SmartFormFillUtils.sys.mjs", "browser/components/aiwindow/ui/moz.build"], "git_node": "c8a2a9b8c549eb0723bd20baabeb79760a2d3c4c", "git_parents": ["765defc06554526f71e09fe134e152ca2f5932d4"], "node": "bc1d3c5cdc6083b5d66b01111a7db749f99a624d", "parents": ["38164be1556ee92b932b214cd6412665f1e19d6b"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054740 - Harden image transferable buffer size validation; r=smaug,gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315538\n", "files": ["dom/base/nsContentUtils.cpp", "gfx/2d/DataSurfaceHelpers.cpp"], "git_node": "abf79171ccbaa86809d3b7de2db74ace1848b674", "git_parents": ["c8a2a9b8c549eb0723bd20baabeb79760a2d3c4c"], "node": "38dddfbb722cee98109b24c896aa008e5f147b9f", "parents": ["bc1d3c5cdc6083b5d66b01111a7db749f99a624d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2045155 - Only recreate XUL label accessibles when the label itself was reported as inserted, r=accessibility-platform-reviewers,eeejay.\n\nPruneOrInsertSubtree removes and reschedules any XULLabelAccessible it walks\nover. That is correct for a label whose frame was just reconstructed, because\nthe anonymous content backing its `value` attribute is rebuilt with it, but the\nfunction also applies it while recursing through an ancestor's subtree, where\nnothing tells us the label needs recreating. Such a label is removed from the\ntree and only reinserted in a later notification controller pass, so assistive\ntechnology sees a spurious hide and reorder and the label is briefly absent.\n\nOnly apply the recreation to the node that was reported as inserted, not to\ndescendants reached by the subtree walk.\n\nThis is reachable whenever a popup finishes opening: RootAccessible handles\npopupshown by calling ContentInserted on the panel, whose subtree has already\nbeen built, and the walk reached every XUL label and description underneath it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315734\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h"], "git_node": "56ad29049a11ced909e25d7e1fabcc6155e1a516", "git_parents": ["abf79171ccbaa86809d3b7de2db74ace1848b674"], "node": "2336731ab773104c090421ed627b7fd19590ec9a", "parents": ["38dddfbb722cee98109b24c896aa008e5f147b9f"], "tags": []}], "date": 1785577756, "git_changesets": ["6fcc9c4d4f810c74cc0ddb1cd86be4503926b25b", "ac184e9d8a4851d71fc9118e8ab9993f560a11d2", "6efa9c8980d2fae21faf3d3163f7dd6a002fdca1", "c6182c4189b31919fcc6b784db6d8bcd4c9fd183", "e0593ce383e4180a57f2a097603df4c4bb070b58", "226230a8d344db60db644d76e50974bd06df0902", "f90e41304eeb673b40646d35be52b9fb8059730a", "75948f8125f838f05f4333e119f9ab8b382b81e4", "ad62acfd4b757f46945dfb1d9dd5ca346bb9a368", "e7f54c323f020bc597dc30239ea184b8e61fc8e3", "8f1cbb9d65483b2d92920a2208c004f1116f0da5", "56048444867a93fe8274c2fbe88076c1a55809e9", "1505b4958d559e8f0b5a961bd98392e7e24527a9", "2fa772016a4ab1b3581813eb9170eb66d601c6c8", "f5ae277c198d798c31b4461e2ebf5511cd2d246a", "2e3c99d4751aa1dd76dcb1d4eac53ef33c566f90", "381b9e492fb38404f8e52775d8f4be00245f66ea", "f41736558b9011c9a60168d94a05e57160c07e11", "1a0190c54c1b04ef81322c51335f006dbd7f0eda", "4e4fb20b51b3a23df14aeffe976c24fc101304a4", "7c42ef6ebbb7d5b6a365f8be1eb809be6ce91a59", "e380e4caa13dd91b31001378680eee7531505fb7", "d050d9d0f98565edbf2b50d5a7b175a1bc28121f", "f31830e7293d0b41e5a919ed00b4e0b89e7b9790", "ffbcca35a7e018e3d2e48ddafa70b217294dbd2f", "a10d301b33e2