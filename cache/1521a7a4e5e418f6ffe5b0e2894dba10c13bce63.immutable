/ContileTopSitesUpdaterWorker.kt", "mobile/android/android-components/components/service/mars/src/main/java/mozilla/components/service/mars/contile/ContileTopSitesUseCases.kt", "mobile/android/android-components/components/service/mars/src/test/java/mozilla/components/service/mars/ContileTopSitesUpdaterTest.kt", "mobile/android/android-components/components/service/mars/src/test/java/mozilla/components/service/mars/ContileTopSitesUpdaterWorkerTest.kt", "mobile/android/android-components/components/service/mars/src/test/java/mozilla/components/service/mars/ContileTopSitesUseCasesTest.kt", "mobile/android/android-components/components/service/mars/src/test/java/mozilla/components/service/mars/MacTopSitesUpdaterTest.kt", "mobile/android/android-components/components/service/mars/src/test/java/mozilla/components/service/mars/MacTopSitesUpdaterWorkerTest.kt", "mobile/android/android-components/components/service/mars/src/test/java/mozilla/components/service/mars/MacTopSitesUseCasesTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/HomeActivity.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt"], "git_node": "b393c5134a1bb384d01da341416e90c1a2ab45d2", "git_parents": ["1732f5684d7b82923dad6045445c0dc422dd179d"], "node": "7f33ddcc519c2bec1642cf1adf5151ad081e3805", "parents": ["db9016fc5815cd8b12b2319718734a6ed999e95f"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056030 - Ensure splash screen only appears when about:welcome would be displayed r=mviar,omc-reviewers\n\nUpdates the preonboarding splash screen to only show if about:welcome would have shown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313303\n", "files": ["browser/components/asrouter/modules/PreonboardingSplash.sys.mjs", "browser/components/asrouter/tests/xpcshell/test_PreonboardingSplash.js"], "git_node": "f3e39b09a92207ebb8d5e3f1c31ac3ce29bb5013", "git_parents": ["b393c5134a1bb384d01da341416e90c1a2ab45d2"], "node": "7000dc761f949cff8143e5154b7231bd7d1a4c26", "parents": ["7f33ddcc519c2bec1642cf1adf5151ad081e3805"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050592: Replace right titlebar-spacer with a flexible space r=Gijs\" for causing mochitests failures in browser_1003588_no_specials_in_panel.js.\n\nThis reverts commit f1680989652636eabc18abce6de01bf506e18438.\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/test/unit/test_titlebar_spacer_migration.js", "browser/components/customizableui/test/unit/xpcshell.toml", "browser/components/sidebar/tests/marionette/test_initialize_vertical_tabs.py"], "git_node": "f6d0deac032a9c0720499199c1cc1d4a37e0f515", "git_parents": ["f3e39b09a92207ebb8d5e3f1c31ac3ce29bb5013"], "node": "8b1b3a39815d601a64019851c70dca80150dbbad", "parents": ["7000dc761f949cff8143e5154b7231bd7d1a4c26"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2056717 - Intermittent [TV] browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js r=yjamora\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313515\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js"], "git_node": "93ee23255579e11cb06f271865edfffebf7b03de", "git_parents": ["f6d0deac032a9c0720499199c1cc1d4a37e0f515"], "node": "7f02d59433fc24a005e2d49d4ba2cbd8dc96f282", "parents": ["8b1b3a39815d601a64019851c70dca80150dbbad"], "tags": []}, {"author": "Raul Bucata \u003crbucata@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051291 - add a webcompat CSS intervention for customers.extend.com; r=twisniewski,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313273\n", "files": ["browser/extensions/webcompat/data/interventions/2051291-customers.extend.com.json", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_2051291_customers_extend_com.py"], "git_node": "fb6b66ac4376dc6e27339c7a26ff4cbf62f18647", "git_parents": ["93ee23255579e11cb06f271865edfffebf7b03de"], "node": "3d2948827500323aef6156eab69f538551d66f6e", "parents": ["7f02d59433fc24a005e2d49d4ba2cbd8dc96f282"], "tags": []}, {"author": "Raul Bucata \u003crbucata@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053077 - Add a webcompat CSS intervention for jobs.abbott.com; r=twisniewski,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312343\n", "files": ["browser/extensions/webcompat/data/interventions/2053077-jobs.abbott.com.json", "browser/extensions/webcompat/preprocessed_intervention_files.mozbuild", "testing/webcompat/interventions/tests/test_2053077_jobs_abbott_com.py"], "git_node": "2c557a58cf67fc68d2f4df26a0ae9c2300f2ccab", "git_parents": ["fb6b66ac4376dc6e27339c7a26ff4cbf62f18647"], "node": "1ad1a5cd45bbb51a55ec7ea331e406815451e9d1", "parents": ["3d2948827500323aef6156eab69f538551d66f6e"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1976492 - add a hasVirtualAuthenticator method to nsIWebAuthnService. r=mfarrell,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313101\n", "files": ["dom/webauthn/AndroidWebAuthnService.cpp", "dom/webauthn/MacOSWebAuthnService.mm", "dom/webauthn/WebAuthnService.cpp", "dom/webauthn/WinWebAuthnService.cpp", "dom/webauthn/authrs_bridge/src/lib.rs", "dom/webauthn/authrs_bridge/src/test_token.rs", "dom/webauthn/nsIWebAuthnService.idl", "remote/marionette/driver.sys.mjs", "remote/marionette/webauthn.sys.mjs", "testing/web-platform/meta/webdriver/tests/classic/external/webauthn/add_credential/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/classic/external/webauthn/get_credentials/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/classic/external/webauthn/remove_all_credentials/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/classic/external/webauthn/remove_credential/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/classic/external/webauthn/remove_virtual_authenticator/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/classic/external/webauthn/set_user_verified/invalid.py.ini"], "git_node": "7273d787a4f4cbe7cf88474a9960ca773851e303", "git_parents": ["2c557a58cf67fc68d2f4df26a0ae9c2300f2ccab"], "node": "91827d183764078bcf4293f158d0118d0a6316d2", "parents": ["1ad1a5cd45bbb51a55ec7ea331e406815451e9d1"], "tags": []}, {"author": "Ted Campbell \u003ctcampbell@mozilla.com\u003e", "branch": "default", "desc": "Bug 2012992: Avoid scraping s3 bucket in fx-source-doc uploader. r=ahal\n\nWhen we try to remove old files from the \"current\" site, we get the existing\nlist from S3. Unfortunately this also discovered files of every past versioned\nupload and the filtering is client-side. This reworks the fetch to apply\nfiltering in the request to avoid timing out the taskcluster job.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313361\n", "files": ["tools/moztreedocs/upload.py"], "git_node": "624a82291f6f36339d69cef27a13731019f01ae8", "git_parents": ["7273d787a4f4cbe7cf88474a9960ca773851e303"], "node": "0881978327a8ac749817c97ff237f1e70ffca048", "parents": ["91827d183764078bcf4293f158d0118d0a6316d2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051959 - [IPC Urlbar] Phase 6: Green up browser_caret_position.js on the message path. r=mbeier\n\n`checkIfKeyStartsQuery` detected a key-initiated query by reading a `queryStarted`\nflag synchronously right after the key. The flag is set from the `onQueryStarted`\ncontroller notification, which round-trips from the parent on the message path,\nso it hadn't arrived yet and the query-expected assertions failed. For those\ncases, await a promise the notification resolves; the no-query cases still read\nsynchronously. Test-only; direct path behavior-neutral.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311547\n", "files": ["browser/components/urlbar/tests/browser/browser_caret_position.js"], "git_node": "190464b81fa6af949ce7510b6e2280e2f31522bf", "git_parents": ["624a82291f6f36339d69cef27a13731019f01ae8"], "node": "7cfab571225f0c70b9be505185afc381014c6579", "parents": ["0881978327a8ac749817c97ff237f1e70ffca048"], "tags": []}, {"author": "Bryan Johns \u003cbjohns@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055850 - passing inference params via defined parameter inferenceParams r=simonf,ai-platform-reviewers,mshillabeer,valentinp,ai-security-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312773\n", "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/memories/Memories.sys.mjs", "browser/components/aiwindow/models/memories/MemoriesManager.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_conversation_stream.js", "browser/components/aiwindow/models/tests/browser/browser_search_the_web.js", "browser/components/aiwindow/models/tests/xpcshell/test_Conversation.js", "toolkit/components/ml/content/backends/OpenAIPipeline.mjs"], "git_node": "2ca6fa221d80afb3cd67af4308eb28c7943560e7", "git_parents": ["190464b81fa6af949ce7510b6e2280e2f31522bf"], "node": "b6fa02e05d248c962cc69137fbe96d6dde2783ec", "parents": ["7cfab571225f0c70b9be505185afc381014c6579"], "tags": []}, {"author": "Andrej Glavic \u003cagl