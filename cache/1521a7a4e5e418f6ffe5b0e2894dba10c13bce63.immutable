js/src/builtin/intl/NumberFormat.cpp", "js/src/builtin/intl/NumberFormat.h", "js/src/builtin/intl/PluralRules.cpp", "js/src/builtin/intl/PluralRules.h", "js/src/builtin/intl/RelativeTimeFormat.cpp", "js/src/builtin/intl/RelativeTimeFormat.h", "js/src/builtin/intl/Segmenter.h"], "git_node": "5c4620845ca19d6d73ac49051d578f433aea32d0", "git_parents": ["8eba74ded6e5bd7c9c2e7945f8ebb67a1873f5eb"], "node": "8773059d76c3f5716bef5334a038799839ab799a", "parents": ["3c61be08e864477142db0074413c6f665fd50df0"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2055262 - Migrate primitive objects to use TypedSlot. r=spidermonkey-reviewers,jonco\n\nThis change is simply for alignment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312339\n", "files": ["js/src/builtin/BigInt.cpp", "js/src/builtin/BigInt.h", "js/src/builtin/Boolean.cpp", "js/src/builtin/Symbol.cpp", "js/src/builtin/Symbol.h", "js/src/vm/BooleanObject-inl.h", "js/src/vm/BooleanObject.h"], "git_node": "0b27fe30b35baa6c7ba1a7f84776b931fd00c395", "git_parents": ["5c4620845ca19d6d73ac49051d578f433aea32d0"], "node": "17d86cc68daaa190a4b31f76a0e2093c49d46b4b", "parents": ["8773059d76c3f5716bef5334a038799839ab799a"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2055262 - Migrate ModuleObject to use TypedSlot. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312340\n", "files": ["js/src/builtin/ModuleObject.cpp", "js/src/builtin/ModuleObject.h"], "git_node": "fe594930d72e299b95a813b269dc13579da0774c", "git_parents": ["0b27fe30b35baa6c7ba1a7f84776b931fd00c395"], "node": "b691696eba98b22e620dd41dddf505d5b49c02e7", "parents": ["17d86cc68daaa190a4b31f76a0e2093c49d46b4b"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2055262 - Migrate FinalizationRegistryObject to use TypedSlot. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312341\n", "files": ["js/src/builtin/FinalizationRegistryObject.cpp", "js/src/builtin/FinalizationRegistryObject.h"], "git_node": "500d26c0492b6f843a15e31a5bbaf82293a9a3a6", "git_parents": ["fe594930d72e299b95a813b269dc13579da0774c"], "node": "02e101004a837bed04f5706be25b172a986cbfed", "parents": ["b691696eba98b22e620dd41dddf505d5b49c02e7"], "tags": []}, {"author": "Peter Lafreniere \u003cpeter@n8pjl.ca\u003e", "branch": "default", "desc": "Bug 2055262 - Migrate more of js/src/builtin to use TypedSlot. r=spidermonkey-reviewers,jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312342\n", "files": ["js/src/builtin/AsyncDisposableStackObject.cpp", "js/src/builtin/DisposableStackObject.cpp", "js/src/builtin/DisposableStackObjectBase.cpp", "js/src/builtin/DisposableStackObjectBase.h", "js/src/builtin/MapObject.cpp", "js/src/builtin/MapObject.h", "js/src/builtin/ParseRecordObject.cpp", "js/src/builtin/ParseRecordObject.h"], "git_node": "69ad92234d501dbf23f0105c80aea3dca6cdca01", "git_parents": ["500d26c0492b6f843a15e31a5bbaf82293a9a3a6"], "node": "0c722a0e816ff6d45bfb29c882aef5618ec1726d", "parents": ["02e101004a837bed04f5706be25b172a986cbfed"], "tags": []}, {"author": "mike a \u003cmavduevskiy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054812 - Check account when vpn toggle fails for an entitled user r=android-reviewers,jonalmeida\n\nThis patch aims to unblock authenticated users that initiated VPN auth flow while\ntheir account was still being warming up. That would result in user\nhaving \"entitled\" account status, but ip protection service would be\nstill \"unauthenticated\", which locks the UI in connecting state. Why?\n\nNormally, that state means that the user has finished auth flow, and\nip protection machinery is processing new data and eventually moving\ninto \"ready\" state. The source of truth for the UI is the service state.\nThe auth flow is finished (we closed the custom tab with account),\nbut the ip protection state hasn't updated yet - so the UI goes into\nconnecting state, to show that it's working and prevent user from\nrepeated calls.\n\nHappy state flow is, account manager notifies it's ready, vpn ui\nelements initiate account check - that warms up the ip protection\nmachinery, and then user goes through the auth flow, so ip protection\nresponds to the auth flow properly, and eventually goes into ready\nstate.\n\nBut vpn auth flow doesn't wait for fxa to finish warming up, and the vpn\nauth flow might be started before that.\n\nI tried several approaches here:\n1. Make CheckAccount work for WarmingUp account state. Didn't work:\n   WarmingUp means both not account and an account in process\n2. Lock \"get started\" until WarmingUp finishes. Didn't work: the\n   CheckAccount is fired when the screen is opened, it doesn't listen to\n   the account state.\n3. Making IPProtectionStorageSynchronizer to also check account if\n   NeedsAuthorization happens during Auth flow. Didn't work: it still\n   leaves the race condition, fxa might take longer than auth flow.\n\nI also noticed that when FXA is not ready, the state transitions as if\nit were Authentication (AwaitingAuthentication, etc), which then updates\nwith \"NeedsAuthorization\" - and the FXA page shows Authorization. What's\nhappening in code doesn't represent what's going on.\n\nBut in the end, I want to avoid locking user in the \"connecting\" state.\nOur auth proccess always ends with a toggle action, so if that errors\nwhile we are entitled but the service state is still unauthenticated, we\nit means fxa and vpn auth went out of sync, and we should check account\nstate (warm up the ip protection machinery).\n\nIn theory, we could warn a check after seeing a toggle failure while the\nservice is unauthenticated - without considering account state, but I\nwanted to be eplicit about this case to minimize side-effects when we\nintroduce gpi as a way to enroll.\n\nFor that racing condition, the user will see a snackbar error \"try\nagain\", but they actually will be able to try again. Added telemetry to\nsee how often that happens, for prioritizing feature improvments here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312137\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/Reducers.kt", "mobile/android/android-components/components/feature/ipprotection/src/test/java/mozilla/components/feature/ipprotection/store/IPProtectionReducerTest.kt", "mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/IPProtectionTelemetryMiddlewareTest.kt"], "git_node": "2a068caa3ce38247edf8de27a8c1a53f71c06725", "git_parents": ["69ad92234d501dbf23f0105c80aea3dca6cdca01"], "node": "1e90f0c3195766562292ebabd90258772145ff04", "parents": ["0c722a0e816ff6d45bfb29c882aef5618ec1726d"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050531 - add JSWindowActor pair for theme-picker r=mstriemer,maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312555\n", "files": ["browser/actors/ThemePickerChild.sys.mjs", "browser/actors/ThemePickerParent.sys.mjs", "browser/actors/moz.build", "browser/components/DesktopActorRegistry.sys.mjs", "toolkit/content/jar.mn", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs"], "git_node": "11c65070e0e8cbed6a15f1211aa969e2517f0c33", "git_parents": ["2a068caa3ce38247edf8de27a8c1a53f71c06725"], "node": "2e8270efa5a21afa8024e837892c8970a06ba717", "parents": ["1e90f0c3195766562292ebabd90258772145ff04"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049716 - integrate theme-picker into about:editprofile r=mstriemer,jhirsch\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312556\n", "files": ["browser/actors/ThemePickerChild.sys.mjs", "browser/components/profiles/ProfilesParent.sys.mjs", "browser/components/profiles/SelectableProfileService.sys.mjs", "browser/components/profiles/content/edit-profile-card.mjs", "browser/components/profiles/content/edit-profile.html", "toolkit/content/widgets/theme-picker/theme-picker.css", "toolkit/content/widgets/theme-picker/theme-picker.mjs"], "git_node": "b6f288a1887e846dbcf732521a1e78e90bc72022", "git_parents": ["11c65070e0e8cbed6a15f1211aa969e2517f0c33"], "node": "0cad2b360015f27eca061e6afe883e3f9a6084be", "parents": ["2e8270efa5a21afa8024e837892c8970a06ba717"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055125: Only send accessibility info to the parent process if accessibility is in use there. r=eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312224\n", "files": ["accessible/base/NotificationController.cpp", "accessible/base/nsAccessibilityService.h", "accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h", "accessible/generic/LocalAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h"], "git_node": "cbca422e3bc40de9116e8381441b05d7caf85a26", "git_parents": ["b6f288a1887e846dbcf732521a1e78e90bc72022"], "node": "6286c91b57cdb7cac8e5d54906725e7cc5cc9811", "parents": ["0cad2b360015f27eca061e6afe883e3f9a6084be"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053741: Don't allow f10 or ctrl+f10 to be assigned in about:keyboard on Windows and Linux. r=firefox-desktop-core-reviewers ,Gijs\n\nF10 activates the menu bar and Gecko prioritises this over other bindings.\nPreviously, it could be assigned, but it wouldn't perform the action to which it was assigned.\nTherefore, disallow it to avoid confusion.\nCuriously, Gecko also intercepts ctrl+f10 to activate the menu bar, so disallow that as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313144\n", "files": ["browser/components/customkeys/CustomKeysParent.sys.mjs", "browser/components/customkeys/tests/browser/browser_aboutKeyboard.js"], "git_node": "931274d105fe8fb558bc907a29d34be84add7d17", "git_parents": ["cbca422e3bc40de9116e8381441b05d7caf85a26"], "node": "496509497817eb3842f9ed6c5735f8d3e142268e", "parents": ["6286c91b57cdb7cac8e5d54906725e7cc5cc9811"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053962 - Dispatch async backup pref writes as standalone writes instead of sharing the sPendingWriteData slot. r=gstoll\n\nBackupPrefFile writes go through PreferencesImpl::WritePrefFile, which coalesces\nall writes through a single sPendingWriteData slot destined for the profile\nprefs.js. A backup targets a different file with a filtered pref set and carries\na MozPromise. When the slot was already occupied, the backup took the coalescing\nearly-return, dropping its MozPromiseHolder without settling it and leaving its\nfiltered data in the slot. Give writes that carry a promise holder their own\nPWRunnable with their own data so they never touch the shared slot.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311551\n", "files": ["modules/libpref/Preferences.cpp", "modules/libpref/test/unit/test_backupPrefFile.js"], "git_node": "58d973b24a3b87223d7934df41341d554b2c68e7", "git_parents": ["931274d105fe8fb558bc907a29d34be84add7d17"], "node": "fa8e9db1acddef48a4b45de8b9ca549074cd20bd", "parents": ["496509497817eb3842f9ed6c5735f8d3e142268e"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2057033: Disable ::-webkit-scrollbar on gemini.google.com. r=layout-reviewers,hiro\n\nThe gemini.google.com website has its own bespoke \"fake overlay scrollbars\"\nscrollbar styles.  Their styles turn out to produce a worse experience for\nus if we enable our partial ::-webkit-scrollbar support.  So, let's turn off\nthat support on this site for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313616\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "be397f8f0acae8b8b9b40799cb16990e5cd11b43", "git_parents": ["58d973b24a3b87223d7934df41341d554b2c68e7"], "node": "71719edb7dcad94fe26012e472f6d29fbd0b6b7b", "parents": ["fa8e9db1acddef48a4b45de8b9ca549074cd20bd"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045112 - Rename \"atom marking bitmaps\" to \"atom reference bitmaps\" r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304873\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/Compacting.cpp", "js/src/gc/GCMarker.h", "js/src/gc/GCRuntime.h", "js/src/gc/Heap.h", "js/src/gc/Marking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/WeakMap.h", "js/src/jit-test/tests/gc/bug-1994871.js", "js/src/vm/HelperThreads.cpp", "js/src/vm/JSContext-inl.h"], "git_node": "bcff936bbdcf2326a3d2734e2511b0eaaeab265d", "git_parents": ["be397f8f0acae8b8b9b40799cb16990e5cd11b43"], "node": "1f43f5338b4433aac8f85340b623bda36f4f3fea", "parents": ["71719edb7dcad94fe26012e472f6d29fbd0b6b7b"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045112 - Rename Zone::markedAtoms -\u003e referencedAtoms r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304874\n", "files": ["js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/Zone.cpp", "js/src/gc/Zone.h"], "git_node": "a44c3ea2f9753e831ce9cbbb06fa669e04ec7c35", "git_parents": ["bcff936bbdcf2326a3d2734e2511b0eaaeab265d"], "node": "8c64cba65d321b095fb8080a1cc967f2c1c97ddd", "parents": ["1f43f5338b4433aac8f85340b623bda36f4f3fea"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045112 - Use \"record\"/\"ref\"/\"reference\" terminology: \"atomIsMarked\" =\u003e \"hasRef\", \"mark atom\" -\u003e \"record reference\" (and AtomMarkingRuntime -\u003e ZoneRefRuntime) r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304877\n", "files": ["js/src/builtin/RegExp.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/builtin/intl/SharedIntlData.cpp", "js/src/debugger/Debugger.cpp", "js/src/debugger/Environment.cpp", "js/src/debugger/ExecutionTracer.cpp", "js/src/debugger/Frame.cpp", "js/src/debugger/Object.cpp", "js/src/frontend/BytecodeCompiler.cpp", "js/src/gc/AtomMarking-inl.h", "js/src/gc/AtomMarking.cpp", "js/src/gc/AtomMarking.h", "js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Heap-inl.h", "js/src/gc/Marking.cpp", "js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp", "js/src/gc/WeakMap.cpp", "js/src/jsapi.cpp", "js/src/proxy/CrossCompartmentWrapper.cpp", "js/src/shell/js.cpp", "js/src/vm/Compartment-inl.h", "js/src/vm/Compartment.cpp", "js/src/vm/JSAtomUtils.cpp", "js/src/vm/JSAtomUtils.h", "js/src/vm/JSContext-inl.h", "js/src/vm/JSContext.h", "js/src/vm/JSFunction.cpp", "js/src/vm/JSFunction.h", "js/src/vm/NativeObject.h", "js/src/vm/SavedStacks.cpp", "js/src/vm/Scope.cpp", "js/src/vm/StructuredClone.cpp", "js/src/vm/SymbolType.cpp"], "git_node": "46922b93cadc4fac6f914ae2bf4d1172f69bbeae", "git_parents": ["a44c3ea2f9753e831ce9cbbb06fa669e04ec7c35"], "node": "f1a91963e3b3292c2dabace15f3f44b18f6d0aa1", "parents": ["8c64cba65d321b095fb8080a1cc967f2c1c97ddd"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2045112: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/gc/Marking.cpp"], "git_node": "880cec0f21ef1b246017fb0696be7eefae96d876", "git_parents": ["46922b93cadc4fac6f914ae2bf4d1172f69bbeae"], "node": "cf4156cb4395439eafe8f59239a496904560e514", "parents": ["f1a91963e3b3292c2dabace15f3f44b18f6d0aa1"], "tags": []}, {"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2050221 - Added bookmark menu items for send tab r=skhamis,places-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308620\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "browser/base/content/browser-places.js", "browser/base/content/test/sync/browser_sync.js"], "git_node": "dc22a5e498aff1eb926501d1419c870ecef51608", "git_parents": ["880cec0f21ef1b246017fb0696be7eefae96d876"], "node": "ae0a327a0601b82212d1adcf6927f422ba9c5ca6", "parents": ["cf4156cb4395439eafe8f59239a496904560e514"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2035512 - Increase the urlbar input's line-height so the caret can be placed anywhere r=desktop-theme-reviewers,urlbar-reviewers,dao\" for causing wpt failures in anchor-scroll-position-try-016.html.\n\nThis reverts commit 0c8a121f4e29bb735112e040da6b314c71c75e82.\n", "files": ["browser/themes/shared/urlbar-searchbar.css"], "git_node": "54009ff250a451da0525ce978b467b47f6568256", "git_parents": ["dc22a5e498aff1eb926501d1419c870ecef51608"], "node": "a24092a99e09d545d10879b7c3f5e28502519490", "parents": ["ae0a327a0601b82212d1adcf6927f422ba9c5ca6"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054673. r=gfx-reviewers,gw\" for causing mochitests failures @ test_animations_omta.html\n\nThis reverts commit b77a79d152f6afdd89b683750aa981224f3606c9.\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.h"], "git_node": "4c24b4037674ede46cbf1d5167d724a9c5d7c2d0", "git_parents": ["54009ff250a451da0525ce978b467b47f6568256"], "node": "f8fa239cd36f5e7b55d7cebd3f76fcb643c75e08", "parents": ["a24092a99e09d545d10879b7c3f5e28502519490"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056853 - Some further annotations.\n", "files": ["testing/web-platform/meta/intersection-observer/transformed-iframe-004-cross-origin.html.ini"], "git_node": "98dfa4936349965e4c867a5ec1ad24cc252591db", "git_parents": ["4c24b4037674ede46cbf1d5167d724a9c5d7c2d0"], "node": "da12e5c1291b5ca438520d856c1723ef95909936", "parents": ["f8fa239cd36f5e7b55d7cebd3f76fcb643c75e08"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052937 - Make nsReadableUtils depend less on comparators. r=nika,xpcom-reviewers,layout-reviewers,dshin\" for causing XPC failures @ test_app_rep_maclinux.js\n\nThis reverts commit cce08d6f6a77a1ecc8ba34dde9266608e26c9e6a.\n", "files": ["dom/base/nsAttrValue.cpp", "dom/filesystem/FileSystemSecurity.cpp", "editor/libeditor/HTMLEditor.cpp", "intl/unicharutil/util/nsUnicharUtils.h", "layout/base/nsCSSFrameConstructor.cpp", "storage/mozStorageAsyncStatement.cpp", "storage/mozStorageStatement.cpp", "xpcom/base/nsMacUtilsImpl.cpp", "xpcom/docs/stringguide.md", "xpcom/string/nsReadableUtils.cpp", "xpcom/string/nsReadableUtils.h", "xpcom/string/nsStringFwd.h", "xpcom/string/nsTStringRepr.h"], "git_node": "e3cc4e81e4636a68452c2da434c24cdb7763e1fe", "git_parents": ["98dfa4936349965e4c867a5ec1ad24cc252591db"], "node": "a91426b2ee2d8038df8739437e8d36459232da5c", "parents": ["da12e5c1291b5ca438520d856c1723ef95909936"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2056858 - remove force-ui-migration from BrowserGlue and update tests to invoke ProfileDataUpgrader directly, r=firefox-desktop-core-reviewers ,mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313426\n", "files": ["browser/components/BrowserGlue.sys.mjs", "browser/components/tests/unit/test_browserGlue_migration_ctrltab_recently_used_order.js", "browser/components/tests/unit/test_browserGlue_migration_formautofill.js", "browser/components/tests/unit/test_browserGlue_migration_no_errors.js", "browser/components/tests/unit/test_browserGlue_migration_osauth.js", "browser/components/tests/unit/test_browserGlue_migration_places_xulstore.js", "browser/components/tests/unit/test_browserGlue_migration_removeABAPerms.js", "browser/components/tests/unit/test_browserGlue_migration_removeContentBlockerPerms.js", "browser/components/tests/unit/test_browserGlue_migration_remove_pref.js", "browser/components/tests/unit/test_browserGlue_migration_resetDefaults.js", "browser/components/tests/unit/test_browserGlue_migration_reset_tracking_table.js"], "git_node": "751a827eb4b1ebee812327910e7b2705e1cc16ad", "git_parents": ["e3cc4e81e4636a68452c2da434c24cdb7763e1fe"], "node": "6e4a371931bf36f84ded4342090cb620468af504", "parents": ["a91426b2ee2d8038df8739437e8d36459232da5c"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 1423834 - Add gtest for MP3Demuxer average frame length overflow r=media-playback-reviewers,alwu\n\nMP3TrackDemuxer accumulated frame lengths in a signed int64_t. Its\noverflow check evaluated the overflowing addition and therefore invoked\nundefined behavior.\n\nExercise UpdateState with two synthetic INT64_MAX / 2 + 10 frame ranges,\nthen verify the public seek offset. FRIEND_TEST grants only this test\naccess to UpdateState. The expected value describes only fixed behavior\nbecause pre-fix overflow has no defined result. The test fails before\nthe fix and passes after it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286545\n", "files": ["dom/media/gtest/TestMP3Demuxer.cpp", "dom/media/mp3/MP3Demuxer.h"], "git_node": "e98ae8cc62f5a8bc2cc8d223391bcabe5de633ab", "git_parents": ["751a827eb4b1ebee812327910e7b2705e1cc16ad"], "node": "71c22473a8992e1f715cfe30568c8aa345b0387c", "parents": ["6e4a371931bf36f84ded4342090cb620468af504"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 1423834 - Fix MP3Demuxer average frame length overflow r=media-playback-reviewers,alwu\n\nMP3TrackDemuxer accumulated frame lengths in a signed int64_t. Its\noverflow check itself invoked signed-overflow undefined behavior. Even\nwith wrapping, halving the sum and count would distort later weights.\n\nStore the running mean in CumulativeAverage\u003cdouble\u003e instead. Parsed\nframe lengths are uint32_t, so reaching int64_t overflow requires an\nimpractical number of frames. This is a correctness fix, not an observed\nfailure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286546\n", "files": ["dom/media/mp3/MP3Demuxer.cpp", "dom/media/mp3/MP3Demuxer.h"], "git_node": "722e86d488f90c050c69f01f3989036f3b8e436f", "git_parents": ["e98ae8cc62f5a8bc2cc8d223391bcabe5de633ab"], "node": "1821b71b29cf35619a512e4ae959227584646d56", "parents": ["71c22473a8992e1f715cfe30568c8aa345b0387c"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 1423834 - Fix ADTSDemuxer average frame length overflow r=media-playback-reviewers,alwu\n\nADTSTrackDemuxer accumulated frame lengths in a uint64_t. On impending\noverflow it halved both sum and count, losing precision and giving later\nframes too much weight.\n\nReplace both fields with CumulativeAverage\u003cdouble\u003e. ADTS frames are at\nmost 8191 bytes, so reaching uint64_t overflow requires about 2.25\nquadrillion frames. This is a correctness fix, not an observed failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D286547\n", "files": ["dom/media/ADTSDemuxer.cpp", "dom/media/ADTSDemuxer.h"], "git_node": "ae1c0a2f9a67fafe10a3c1104eef79a942b9658a", "git_parents": ["722e86d488f90c050c69f01f3989036f3b8e436f"], "node": "e355ae4420c5cf8aa3f8e06ad93e7b6cd71dc158", "parents": ["1821b71b29cf35619a512e4ae959227584646d56"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2054351 - Make `Selection::StyledRanges::ReorderRangesIfNecessary` compare range boundaries in the flat tree r=jjaschke\n\nWhen `Selection` compares range boundaries, it always uses\n`TreeKind::FlatForSelection`. Therefore, this drops the template\nparameters of `CompareToRangeStart` and `CompareToRangeEnd`.\n\nThen, `Selection::StyledRanges::ReorderRangesIfNecessary` calls\n`nsContentUtils::ComparePoints` with range boundaries in\n`TreeKind::DOM`. So, this mismatch causes the crash with unexpected\nsituation.\n\nHowever, this patch does not strict `nsContentUtils::ComparePoints`\nbecause it requires a big patch. Therefore, this adds error handling\nand assertions into the related methods.\n\nIn a follow up, I think we should make `RangeBoundaryBase` split for\n`TreeKind::DOM` and `TreeKind::FlatForSelection`. Then, we can prevent\nmisuse of wrong tree kind boundaries.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313392\n", "files": ["dom/base/Selection.cpp", "dom/base/nsContentUtils.cpp"], "git_node": "555e545b7e1e62bcc68fb38e47b102eef7bc6fd2", "git_parents": ["ae1c0a2f9a67fafe10a3c1104eef79a942b9658a"], "node": "a9a8d4ec8dabe74e3311f454d8fcdadfcea724a4", "parents": ["e355ae4420c5cf8aa3f8e06ad93e7b6cd71dc158"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2056506. Let mach vendor resolve a commit-hash revision for a tag-tracking library. r=tjr\n\nA library that tracks tags (vendoring.tracking: tag) can still be pinned to a\nspecific upstream commit, for example an untagged post-release fix on its\nrelease branch. `mach vendor -r \u003chash\u003e` then failed for such a library because\ntag tracking resolves the revision with upstream_tag(), which looks a tag up by\nname, and a commit hash matches no tag.\n\nupstream_tag() now raises a specific TagNotFound, which the vendor manifest\ncatches and falls back to upstream_commit() when the revision looks like a full\ncommit hash. The commit-tracking and newest-tag (\"HEAD\") paths are unchanged,\nso updatebot's release discovery is unaffected.\n\n* * *\nBug 2056506. Add a test for mach vendor's tag-tracking commit-hash fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313174\n", "files": ["python/mozbuild/mozbuild/test/vendor/test_vendor_manifest.py", "python/mozbuild/mozbuild/vendor/host_base.py", "python/mozbuild/mozbuild/vendor/vendor_manifest.py"], "git_node": "39386390b98b96d8ae2372e5696d8461f0104c30", "git_parents": ["555e545b7e1e62bcc68fb38e47b102eef7bc6fd2"], "node": "6603b8882204b0e28981a2efad27b2947c858cb9", "parents": ["a9a8d4ec8dabe74e3311f454d8fcdadfcea724a4"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055341 - Update SmartWindow to use AboutNewTab TopSites API r=gcardieri\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312781\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_topsites.js"], "git_node": "ae13d246ad21f37547f911607f65f80940af7a0d", "git_parents": ["39386390b98b96d8ae2372e5696d8461f0104c30"], "node": "f833acdb1dff522eb5e420c1d0064e0f89554e1e", "parents": ["6603b8882204b0e28981a2efad27b2947c858cb9"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test the average FPS from MediaFormatReader's debug info r=media-playback-reviewers,alwu\n\nVerify that MediaFormatReader debug information reports total video frames\ndivided by elapsed duration for a variable-frame-rate media file.\n\nThe test asset video_rate_vfr.mp4 is a small (~14 KB) all-keyframe H.264 clip\nwith deliberately uneven frame durations, generated with ffmpeg by selecting\nnon-contiguous frames from a constant-rate source and muxing them with\nvariable-frame-rate timing:\n\n  ffmpeg -f lavfi -i \"testsrc=size=160x120:rate=30:duration=2\" \\\n    -vf \"select='eq(n,0)+eq(n,15)+eq(n,30)+eq(n,45)+eq(n,46)+eq(n,47)'\" \\\n    -fps_mode vfr -an -c:v libx264 -profile:v baseline -pix_fmt yuv420p -g 1 \\\n    -movflags +faststart video_rate_vfr.mp4\n\nThe six frames have durations of 0.5s, 0.5s, 0.5s and three of 1/30s, so the\narithmetic mean of the instantaneous rates (~16 fps) differs sharply from the\ntrue average of total frames over total duration (~3.75 fps).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312783\n", "files": ["dom/media/test/mochitest_compat.toml", "dom/media/test/test_video_rate_vfr.html", "dom/media/test/video_rate_vfr.mp4"], "git_node": "b4b72b5b099cfe5e39bfa03ee621431e003df30e", "git_parents": ["ae13d246ad21f37547f911607f65f80940af7a0d"], "node": "82cb654dfc9a0d324216aadae7402e426c00a7b0", "parents": ["f833acdb1dff522eb5e420c1d0064e0f89554e1e"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test the initial MediaFormatReader frame-rate estimate. r=media-playback-reviewers,alwu\n\nIntroduce reusable video-rate demuxer, decoder, and reader test infrastructure. Verify that initial decoder creation and final debug information consume the estimator.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312784\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "0bb9bee382ca5b87fd73720067c8fde6f3defc21", "git_parents": ["b4b72b5b099cfe5e39bfa03ee621431e003df30e"], "node": "6d1b703c9ba32e9aed504adcee9f13a0dd4d7af0", "parents": ["82cb654dfc9a0d324216aadae7402e426c00a7b0"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test frame-rate reset across stream changes. r=media-playback-reviewers,padenot\n\nVerify that an explicit source-ID change starts a new estimate and that sparse track information remains associated with the current source.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312785\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "b8832dab39e87ed4d02512ab76c88ae7cd69d818", "git_parents": ["0bb9bee382ca5b87fd73720067c8fde6f3defc21"], "node": "c31f6a3fe010115ae766d4f7ca471df53c733476", "parents": ["6d1b703c9ba32e9aed504adcee9f13a0dd4d7af0"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test frame-rate estimation without track information. r=media-playback-reviewers,padenot\n\nVerify that samples without a stream-source marker remain in one anonymous estimator epoch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312786\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "b3d6219cbfdf8fb69942a395c4ca4748a9185159", "git_parents": ["b8832dab39e87ed4d02512ab76c88ae7cd69d818"], "node": "cf718df3f45a6fbf7250afb7aa7050b9c0c230b7", "parents": ["c31f6a3fe010115ae766d4f7ca471df53c733476"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test the transition to an explicit stream ID. r=media-playback-reviewers,padenot\n\nVerify that an anonymous epoch is reset when valid stream ID zero first appears, while later sparse samples remain in that explicit epoch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312787\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "5a595aff1bb8a2d60dac63ce043f9d2a1280c7a0", "git_parents": ["b3d6219cbfdf8fb69942a395c4ca4748a9185159"], "node": "3ed8e3442677bd1a0be2a200af7a7f40c87963a1", "parents": ["cf718df3f45a6fbf7250afb7aa7050b9c0c230b7"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test frame rate across same-stream decoder recreation. r=media-playback-reviewers,alwu\n\nVerify that recreating a decoder without a source change uses the current shared frame-rate estimate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312788\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "168cfa59d2b7a0d1fc01f88ab0ef901cb26bd9ba", "git_parents": ["5a595aff1bb8a2d60dac63ce043f9d2a1280c7a0"], "node": "53f61a983d82d82706467344f0280ab0d7a2fe29", "parents": ["3ed8e3442677bd1a0be2a200af7a7f40c87963a1"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test frame rate across decode-error recovery. r=media-playback-reviewers,padenot\n\nVerify that a decoder recreated after NS_ERROR_DOM_MEDIA_NEED_NEW_DECODER receives the current shared frame-rate estimate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312789\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "bdc1f22aedb6e7e6df6fd5203138f9152f663956", "git_parents": ["168cfa59d2b7a0d1fc01f88ab0ef901cb26bd9ba"], "node": "725edfbafd8bb846c7e8920301b9a6c230376b3e", "parents": ["53f61a983d82d82706467344f0280ab0d7a2fe29"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test a stream change on a non-keyframe. r=media-playback-reviewers,padenot\n\nVerify that the first demuxed sample in the new estimator epoch contributes to its rate even when decoder handling seeks to a keyframe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312790\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "3762f45687fb12d6f86361352d3df916d9bc88e5", "git_parents": ["bdc1f22aedb6e7e6df6fd5203138f9152f663956"], "node": "f0e9d76be31021a1726ca28af7f65d32079d1ccb", "parents": ["725edfbafd8bb846c7e8920301b9a6c230376b3e"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test zero-duration frame-rate samples. r=media-playback-reviewers,alwu\n\nVerify that a zero-duration sample does not contribute to the frame-rate estimate or produce a nonzero initial decoder hint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312791\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "d25a157a1da7c09104aabbe4e467dd6c1c0ee8d8", "git_parents": ["3762f45687fb12d6f86361352d3df916d9bc88e5"], "node": "0b6b2c6a33c2f14fda3a1c7c734915118d60ee77", "parents": ["f0e9d76be31021a1726ca28af7f65d32079d1ccb"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test frame-rate observations replayed by a seek. r=media-playback-reviewers,padenot\n\nVerify that a sample delivered again after seeking contributes one new demux observation to the shared estimate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312792\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "aba437609462cd3f1eb4752a03b86d1f688ac512", "git_parents": ["d25a157a1da7c09104aabbe4e467dd6c1c0ee8d8"], "node": "4fb887cb0f2d96b12b1d5773d169d74fdab5fd36", "parents": ["0b6b2c6a33c2f14fda3a1c7c734915118d60ee77"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test frame rate across a video config change. r=media-playback-reviewers,alwu\n\nVerify that a stream and video configuration change recreate the decoder with both the new configuration and the reset frame-rate estimate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313047\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "15ea737370d31196bb846ecfcd14d93fb853891b", "git_parents": ["aba437609462cd3f1eb4752a03b86d1f688ac512"], "node": "453d6db4cc4c2b53fff3490e1de7a270542a5039", "parents": ["4fb887cb0f2d96b12b1d5773d169d74fdab5fd36"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Test a stream change during null decoding. r=media-playback-reviewers,alwu\n\nVerify that a stream change resets the frame-rate estimate while null decoding is active and that the resumed platform decoder receives the new stream's current estimate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313048\n", "files": ["dom/media/gtest/TestMediaFormatReader.cpp"], "git_node": "c41d3112397ae59bd41d5941de64566e09b9d2bc", "git_parents": ["15ea737370d31196bb846ecfcd14d93fb853891b"], "node": "96f8ea622db889a533ef648365423ed67341c928", "parents": ["453d6db4cc4c2b53fff3490e1de7a270542a5039"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Compute the true average video frame rate. r=media-playback-reviewers,alwu\n\nAccumulate the mean of valid frame durations in double precision and report its reciprocal, so the estimate is total frames divided by total duration. Keep the existing observation point unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312793\n", "files": ["dom/media/MediaFormatReader.cpp", "dom/media/MediaFormatReader.h"], "git_node": "483f257f30070347ab69d1425dc733e8f09ee673", "git_parents": ["c41d3112397ae59bd41d5941de64566e09b9d2bc"], "node": "66dfba4410281425eb1068abd9179a09d116f64a", "parents": ["96f8ea622db889a533ef648365423ed67341c928"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2055649 - Count each demuxed video sample once. r=media-playback-reviewers,padenot\n\nObserve fresh video samples at demux completion so decoder creation, retries, and recreation cannot count a retained queue head again. This also starts an estimator epoch as soon as a new explicit source ID is demuxed and includes a non-keyframe change marker even if decoder handling later seeks past it.\n\nStream identity semantics otherwise stay unchanged: missing track info is a sparse marker, equal IDs continue the current epoch, and a different present ID resets it. Same-ID and all-anonymous source changes remain undetectable, and a sample delivered again after seeking remains a new observation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312794\n", "files": ["dom/media/MediaFormatReader.cpp", "dom/media/MediaFormatReader.h"], "git_node": "766e9822d6c53c2ad1820477e4aafd230cb17980", "git_parents": ["483f257f30070347ab69d1425dc733e8f09ee673"], "node": "f68d8a77773837279f20006661ab9217ca6dcb3f", "parents": ["66dfba4410281425eb1068abd9179a09d116f64a"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056779. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313599\n", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": "39349fae92922c42d3a07931b3ce22a17056a757", "git_parents": ["766e9822d6c53c2ad1820477e4aafd230cb17980"], "node": "26e9aec225a23f4640d99f924ea8200e44d1f353", "parents": ["f68d8a77773837279f20006661ab9217ca6dcb3f"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055661 - Use zero touch start/move tolerance on wpt. r=botond,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312601\n", "files": ["remote/shared/RecommendedPreferences.sys.mjs", "testing/marionette/client/marionette_driver/geckoinstance.py", "testing/profiles/web-platform/user.js"], "git_node": "4750cc1d2475f7ad6687b9a5fce3ec732b2396ca", "git_parents": ["39349fae92922c42d3a07931b3ce22a17056a757"], "node": "5f05fd245aecb004d8f6348298f6c1b25c2e82ca", "parents": ["26e9aec225a23f4640d99f924ea8200e44d1f353"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056650 - Mark moz-newtab-wallpaper as known-cacheable so newtab custom wallpapers stop flashing r=desktop-theme-reviewers,mconley,emilio\n\nNewtab has its own special wallpaper protocol for custom wallpapers, and it\nwas missing from the knownCacheable detection. Combined with newtab\npreloading, that made the image periodically fail ValidateEntry and get\nre-requested, causing the flash.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313305\n", "files": ["dom/base/nsContentUtils.cpp"], "git_node": "6b76f18795710a9e30bc399b7a6b47c9c23e97fe", "git_parents": ["4750cc1d2475f7ad6687b9a5fce3ec732b2396ca"], "node": "e43993ee433f621bdaecaded6e84ab4eeb84fedf", "parents": ["5f05fd245aecb004d8f6348298f6c1b25c2e82ca"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055072 - Handle width/height as scroll-linked effective properties. r=botond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312166\n", "files": ["gfx/layers/apz/test/mochitest/helper_scroll_linked_effect_width_and_height.html", "gfx/layers/apz/test/mochitest/test_group_scroll_linked_effect.html", "layout/style/nsDOMCSSAttrDeclaration.cpp"], "git_node": "b675a1d7aba6c1224320cc8f1b507ce66fdb24af", "git_parents": ["6b76f18795710a9e30bc399b7a6b47c9c23e97fe"], "node": "5b7d655328d8802b661c2d5addba1f5baf8433d2", "parents": ["e43993ee433f621bdaecaded6e84ab4eeb84fedf"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2055526 - [loong64] Part 1: Extract mask{ne,eq}z-based conditional selection patterns. r=spidermonkey-reviewers,anba\n\nThis benefits later parts that ports Bug 2051528 to Loong64 in a similar\npattern, which could hopefully reduce reviewing pressure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312497\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "716cf14976b6cf51e0462752da8a484e7dfb5fdb", "git_parents": ["b675a1d7aba6c1224320cc8f1b507ce66fdb24af"], "node": "c08bd15bc134b9319cbca78ca979037a3ca1c875", "parents": ["5b7d655328d8802b661c2d5addba1f5baf8433d2"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2055526 - [loong64] Part 2: Avoid defineReuseInput for LWasmCompareAndSelect. r=spidermonkey-reviewers,anba\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312498\n", "files": ["js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp"], "git_node": "bcc158685fce4905c3d272366d5cac1d808c6137", "git_parents": ["716cf14976b6cf51e0462752da8a484e7dfb5fdb"], "node": "1be83d488bcb6b918f9fc784a40b921f37b28856", "parents": ["c08bd15bc134b9319cbca78ca979037a3ca1c875"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2055526 - [loong64] Part 3: Avoid defineReuseInput for LWasmSelect/LWasmSelectI64. r=spidermonkey-reviewers,anba\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312499\n", "files": ["js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp"], "git_node": "b74326320e049fda77a28e29f0680a9e1bc5b0c9", "git_parents": ["bcc158685fce4905c3d272366d5cac1d808c6137"], "node": "92e2ce4175506a91c9fb35190abd4aeb31f5368a", "parents": ["1be83d488bcb6b918f9fc784a40b921f37b28856"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2055526 - [loong64] Part 4: Remove no longer used moveIfZero/moveIfNotZero. r=spidermonkey-reviewers,anba\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312500\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "d0fca2c6cc1d9244767fa35f05cdc10374765212", "git_parents": ["b74326320e049fda77a28e29f0680a9e1bc5b0c9"], "node": "18b82fff90f5762ef50d25386229864a1a1e50ae", "parents": ["92e2ce4175506a91c9fb35190abd4aeb31f5368a"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2055529 - [loong64] Part 1: Simulator-loong64: Implement MOVGR2CF. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312501\n", "files": ["js/src/jit/loong64/Simulator-loong64.cpp"], "git_node": "63942940c34da1f452a426822ca014ce8bbe0f2c", "git_parents": ["d0fca2c6cc1d9244767fa35f05cdc10374765212"], "node": "d301987ff83ff8a278fb45f6f9a021dfebc9f2fb", "parents": ["18b82fff90f5762ef50d25386229864a1a1e50ae"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2055529 - [loong64] Part 2: Expose direct FCCx setters of ma_cmp_set_{float32,double}. r=spidermonkey-reviewers,anba\n\nIn a later part, these can be used to save one round-trip between FCCx\nand GPRs. Based on ad-hoc microbenches, the round-trip latency of\n`movgr2cf; movcf2gr` is 4 cycles(!) on a 6-issue Loongson 3B6000/12\n(LA664 uarch), and individual `movgr2cf` and `movcf2gr` has only scalar\nthroughput.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312502\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64.cpp", "js/src/jit/loong64/MacroAssembler-loong64.h"], "git_node": "8c58fe302b416589151105672d066f7a698fe83d", "git_parents": ["63942940c34da1f452a426822ca014ce8bbe0f2c"], "node": "fc9970867aa692411080f983b5313227a7448b34", "parents": ["d301987ff83ff8a278fb45f6f9a021dfebc9f2fb"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2055529 - [loong64] Part 3: Handle more combinations of compare and selection types in visitWasmCompareAndSelect. r=spidermonkey-reviewers,anba\n\nThis now handles the self-cartesian product of the {{U,}Int32,\n{U,}Int64}, Float32, Double} set of types.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312503\n", "files": ["js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/loong64/Lowering-loong64.cpp"], "git_node": "191c044bd745d8e193b723ba8edd999cd07155ca", "git_parents": ["8c58fe302b416589151105672d066f7a698fe83d"], "node": "51d94b2ee593a7422d3a9e78ee1c21e9ca69c734", "parents": ["fc9970867aa692411080f983b5313227a7448b34"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2044385 - Display Exa web search activity in the Smart Window Action Log. r=fluent-reviewers,flod,Mardak\n\nWhen the search_the_web tool call runs, the Action Log labels (\"Searching the web with Exa\" while pending, \"Searched the web with Exa\" once complete) render \"Exa\" as a link to a SUMO support article.\n\nThe pending label's animated loading treatment is handled separately by bug 2046612.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311466\n", "files": ["browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.css", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ToolActionLog.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_result.js", "browser/components/aiwindow/ui/test/xpcshell/test_ToolActionLog.js", "browser/locales/en-US/browser/aiWindowContent.ftl"], "git_node": "55c7b84983e70b24f310c644c781dcd7cacb0071", "git_parents": ["191c044bd745d8e193b723ba8edd999cd07155ca"], "node": "5f1a229bb4f7cfd9484af0baf74ba392496202f0", "parents": ["51d94b2ee593a7422d3a9e78ee1c21e9ca69c734"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055661 - Use zero touch start/move tolerance on wpt. r=botond,whimboo\" for causing Btime failures.\n\nThis reverts commit 4750cc1d2475f7ad6687b9a5fce3ec732b2396ca.\n", "files": ["remote/shared/RecommendedPreferences.sys.mjs", "testing/marionette/client/marionette_driver/geckoinstance.py", "testing/profiles/web-platform/user.js"], "git_node": "5d6e4e27cb8b294af6334f94b9fd4d72614e18ee", "git_parents": ["55c7b84983e70b24f310c644c781dcd7cacb0071"], "node": "067253736b05f6d675d396d5273c6f09134edfaf", "parents": ["5f1a229bb4f7cfd9484af0baf74ba392496202f0"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055125: Only send accessibility info to the parent process if accessibility is in use there. r=eeejay\" for causing pupeteer tests failures at AriaQueryHandler\n\nThis reverts commit cbca422e3bc40de9116e8381441b05d7caf85a26.\n", "files": ["accessible/base/NotificationController.cpp", "accessible/base/nsAccessibilityService.h", "accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h", "accessible/generic/LocalAccessible.cpp", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h"], "git_node": "57cb57ed1fd1c7793e178cf089bc640ed9b58d6f", "git_parents": ["5d6e4e27cb8b294af6334f94b9fd4d72614e18ee"], "node": "806a71a623fbe1c1102f7afc3e655ccb67f9f1f2", "parents": ["067253736b05f6d675d396d5273c6f09134edfaf"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053961: Fix no-constant-condition eslint warnings in netwerk/test/unit r=necko-reviewers,kershaw\n\ntest_cache2-30c/30d had a no-op `if (true)` guard; test_safeoutputstream.js\nused a `do {} while (1)` retry loop.  Pre-existing, unrelated to any other\npatch here; a `no-constant-condition` eslint rollout newly flags them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311435\n", "files": ["netwerk/test/unit/test_cache2-30c-pinning-deferred-doom.js", "netwerk/test/unit/test_cache2-30d-pinning-WasEvicted-API.js", "netwerk/test/unit/test_safeoutputstream.js"], "git_node": "8bdd730ba72f7781de12aeee5e8fff326c744b1c", "git_parents": ["57cb57ed1fd1c7793e178cf089bc640ed9b58d6f"], "node": "589ffd23c7077ed894b0871fa5501dd8e1a71d7b", "parents": ["806a71a623fbe1c1102f7afc3e655ccb67f9f1f2"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2056856 - Round a text run's ancestor clips out on both axes r=gfx-reviewers,lsalzman\n\nDevice-space text runs keep their clips exact on the sub-pixel axis\n(bug 2050692), assuming glyphs are sub-pixel-positioned there. That is\ncorrect for a run's OWN clip (the leaf clip_rect - e.g. a partial-ligature\nor selection clip): rounding it out would over-reveal a sub-pixel column of\nan adjacent run at an inline boundary. But it is wrong for the run's\nANCESTOR clips (an overflow:hidden container, table-cell edge, scroll\nframe): an embedded bitmap strike (e.g. MS UI Gothic) is grid-placed with\nno sub-pixel positioning, so a zero-bearing first glyph at a fractional\ndevice origin gets its leftmost column shaved by the exact container edge.\n\nRound only the ancestor (clip-chain) clips of a text run out on both axes;\nkeep the run's own leaf clip exact on the sub-pixel axis as before. Round-out\nnever moves an edge inward, so bug 2050692 stays fixed, and keeping the leaf\nexact avoids over-revealing adjacent runs (no regression to shaping/boundary\ntext).\n\nThe wrench reftest uses Proggy's ppem-11 bitmap strike clipped by a\nclip-chain node (mirroring overflow:hidden); it can't be a Gecko reftest\nsince drawSnapshot bypasses WebRender.\n\nDrop now-passing WPT expectations that the ancestor-clip round-out fixes:\ntext-overflow-028 and text-wrap-balance-line-clamp-005 (Mac), and\ntext-overflow-string-005 and text-overflow-with-selection (Windows).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313624\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/wrench/reftests/text/2056856-bitmap-clip-ref.yaml", "gfx/wr/wrench/reftests/text/2056856-bitmap-clip.yaml", "gfx/wr/wrench/reftests/text/reftest.list", "testing/web-platform/meta/css/css-text/white-space/text-wrap-balance-line-clamp-005.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-028.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-string-005.html.ini", "testing/web-platform/meta/css/css-ui/text-overflow-with-selection.html.ini"], "git_node": "11ccd57373725e324355a7ee8a66b74ffe025a28", "git_parents": ["8bdd730ba72f7781de12aeee5e8fff326c744b1c"], "node": "8dc63ac7d11cfcca3ff77b06c83e7409315d7f91", "parents": ["589ffd23c7077ed894b0871fa5501dd8e1a71d7b"], "tags": []}, {"author": "alin lastun \u003calastun@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052174 - Support optional icon tint in MicrosurveyContent. r=android-reviewers,twhite\n\nAdd an optional iconTint parameter to the @Composable MicrosurveyContent component. This allows setting the icon color dynamically, so we don't need to create duplicate drawable files just for different colors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313399\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/microsurvey/ui/MicrosurveyContent.kt"], "git_node": "550aae60267e628420ac14746a15df151e0a6a28", "git_parents": ["11ccd57373725e324355a7ee8a66b74ffe025a28"], "node": "736e8004794a2526ea7a80a48e6ac49adfde2482", "parents": ["8dc63ac7d11cfcca3ff77b06c83e7409315d7f91"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2056805 - Drop dead compiler_info fallback from rust target-triple detection. r=firefox-build-system-reviewers,ahochheiden\n\nBug 1617793 removed support for Windows triplets with an unset ABI\n(bare -mingw32/-mingw64), requiring an explicit -windows-gnu or\n-windows-msvc suffix instead. Since then, any WINNT host/target that\nreaches find_candidate always has host_or_target.abi set, making the\ncompiler_info-based fallback for disambiguating Windows rust targets\ndead code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313372\n", "files": ["build/moz.configure/rust.configure"], "git_node": "0b32a91012145b651566eadca71cf331b8dbfb58", "git_parents": ["550aae60267e628420ac14746a15df151e0a6a28"], "node": "da700c04e83456ee76912377150dbfadea3ae9b0", "parents": ["736e8004794a2526ea7a80a48e6ac49adfde2482"], "tags": []}, {"author": "Haik Aftandilian \u003chafta@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2057036 - hdiutil deprecation warnings break macOS 27 artifact builds r=firefox-build-system-reviewers,nalexander\n\nOn macOS 27, \"hdiutil attach\" commands print deprecation warnings on\nstderr breaking artifact build scripting. Replace the use of the hdiutil attach\ncommand with the newer diskutil command.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313618\n", "files": ["testing/mozbase/mozinstall/mozinstall/mozinstall.py"], "git_node": "2fdbc8620d5a894518d143fb46af3a73379a5450", "git_parents": ["0b32a91012145b651566eadca71cf331b8dbfb58"], "node": "4db8360c97b4236fa48cdef1338ce22a26afb094", "parents": ["da700c04e83456ee76912377150dbfadea3ae9b0"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055661 - Use zero touch start/move tolerance on wpt. r=botond,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312601\n", "files": ["remote/shared/RecommendedPreferences.sys.mjs", "testing/marionette/client/marionette_driver/geckoinstance.py", "testing/profiles/web-platform/user.js"], "git_node": "9e89dbef68e052fba3ede46203329523185548ea", "git_parents": ["2fdbc8620d5a894518d143fb46af3a73379a5450"], "node": "a7f01d1aa314ef867bae3e7b3499f0d1eaca65a2", "parents": ["4db8360c97b4236fa48cdef1338ce22a26afb094"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2056901 - [geckoview] Register the GeckoViewPreferences listener only in the parent process. r=geckoview-reviewers,owlish\n\nThe global EventDispatcher instance is only available in the parent\nprocess. Move the eager GeckoViewPreferences listener registration inside\nthe existing parent-process guard in GeckoViewStartup, so it is no longer\nrun for content processes while still being ready before the first request\narrives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313471\n", "files": ["mobile/shared/components/geckoview/GeckoViewStartup.sys.mjs"], "git_node": "fd634da280adea36261e58385e99280c10ecb5be", "git_parents": ["9e89dbef68e052fba3ede46203329523185548ea"], "node": "c694af10d0867b4371d92e133830c36a0679af83", "parents": ["a7f01d1aa314ef867bae3e7b3499f0d1eaca65a2"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048796 - Fix off-by-one error in SandboxBrokerRealpath. r=sandbox-reviewers,Thinker\n\nAs far as I know this isn't exploitable, but it's simple enough to fix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311648\n", "files": ["security/sandbox/linux/broker/SandboxBrokerRealpath.cpp"], "git_node": "061441c95e15090840b6df51549f2056902cbc2b", "git_parents": ["fd634da280adea36261e58385e99280c10ecb5be"], "node": "9bc04fa4b845057d6c927e958c8dc29c4613341a", "parents": ["c694af10d0867b4371d92e133830c36a0679af83"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048474 - Stop overriding fcntl in the GMP sandbox policy on Linux. r=Thinker,sandbox-reviewers\n\nThe subset of operations allowed in the common policy should be safe for\nthe GMP process, and this avoids a footgun when adding operations that\nreally are needed by all sandbox types.\n\nAlso rewrite an outdated comment about the GMP policy while I'm in here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309497\n", "files": ["security/sandbox/linux/SandboxFilter.cpp"], "git_node": "90f00be8ca2cd9bb82c21f07e109ba6a874ca6fa", "git_parents": ["061441c95e15090840b6df51549f2056902cbc2b"], "node": "72ba2de02ed1fdcabcfb12ad0fab1e3dd2c7808f", "parents": ["9bc04fa4b845057d6c927e958c8dc29c4613341a"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048797. r=Thinker,sandbox-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310218\n", "files": ["security/sandbox/linux/broker/SandboxBrokerRealpath.cpp"], "git_node": "f2be9cfab86e0978e31ba5177a54676cfd1af9c9", "git_parents": ["90f00be8ca2cd9bb82c21f07e109ba6a874ca6fa"], "node": "5cc3a83cecdad7b803c6db93d966e248de6e89cb", "parents": ["72ba2de02ed1fdcabcfb12ad0fab1e3dd2c7808f"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\naf -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nan -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nar -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nast -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\naz -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nbe -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nbg -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nbn -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nbo -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nbqi -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nbr -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nbrx -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nbs -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nca -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nca-valencia -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\ncak -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\nckb -\u003e 79c1fa99150478b17d79d07406d315fa325fa2de\ncs -\u0