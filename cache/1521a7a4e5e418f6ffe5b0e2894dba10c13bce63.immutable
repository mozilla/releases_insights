.sub.window.js.ini", "testing/web-platform/meta/wasm/serialization/module/serialization-via-idb.any.js.ini", "testing/web-platform/meta/wasm/serialization/module/serialization-via-notifications-api.any.js.ini", "testing/web-platform/meta/web-extensions/browser.runtime.extension.js.ini", "testing/web-platform/meta/web-extensions/browser.storage.extension.js.ini", "testing/web-platform/meta/web-install/navigator-install-bad-inputs.tentative.https.html.ini", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/navigation_failed/__dir__.ini", "testing/web-platform/meta/webrtc/RTCRtpParameters-codec.html.ini", "testing/web-platform/meta/webrtc/RTCRtpReceiver-video-anyCodec.html.ini", "testing/web-platform/meta/webrtc/protocol/codecs-subsequent-offer.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/screenshare.https.html.ini"], "git_node": "2032ef1b04673bc112c5bbf4b5002779eabfec7d", "git_parents": ["cd75478bca38793226256680041f70203c4ca266"], "node": "4500bff364bb8df3683d2d293f73f3ac13f520b2", "parents": ["d2dcfa6fca07566a780e316a3dbdbb2faf3d3bc3"], "tags": []}, {"author": "Aditi \u003caditisingh1400@gmail.com\u003e", "branch": "default", "desc": "Bug 2056102 - Increase the maximum number of PDF.js preferences to 60. r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312917\n", "files": ["toolkit/components/pdfjs/content/PdfStreamConverter.sys.mjs"], "git_node": "95c37ccf3d2c7c1f4382304ebee35fe9e9a25da0", "git_parents": ["2032ef1b04673bc112c5bbf4b5002779eabfec7d"], "node": "b13c5fe826aece687f18058a837cfebd123d075c", "parents": ["4500bff364bb8df3683d2d293f73f3ac13f520b2"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2054635 - Remove content from parent node before appending r=dom-core-reviewers,vhilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312076\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "a447e88cc261ec80ba57a96f72e78815d8a58cec", "git_parents": ["95c37ccf3d2c7c1f4382304ebee35fe9e9a25da0"], "node": "127665a266b9b851b8c506396133f26d44a7b92e", "parents": ["b13c5fe826aece687f18058a837cfebd123d075c"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053337 - Part 1: Always add ephemeron edge for symbol keyed weak map entries r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311573\n", "files": ["js/src/gc/Marking.cpp", "js/src/gc/WeakMap.cpp"], "git_node": "014ec97fe248af23dea89bc15c03145b8c583948", "git_parents": ["a447e88cc261ec80ba57a96f72e78815d8a58cec"], "node": "ea1ec440812971f252f8b9a438b55a5cfd8b8881", "parents": ["127665a266b9b851b8c506396133f26d44a7b92e"], "tags": []}, {"author": "Alexandre Poirot \u003cpoirot.alex@gmail.com\u003e", "branch": "default", "desc": "Bug 2056174 - Bug 2044741 - [devtools] Avoid crashing when unregistering an actor in a destroying process. r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309939\n", "files": ["dom/ipc/jsactor/JSActorService.cpp"], "git_node": "7a8efbffdb7ec4dee859c0ff45f7425e3ff067e2", "git_parents": ["014ec97fe248af23dea89bc15c03145b8c583948"], "node": "e1297e6e2434e1afb82c81bc8be4ea2dd7382302", "parents": ["ea1ec440812971f252f8b9a438b55a5cfd8b8881"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054454 - Part 1: Simplify logic around yielding at the end of the mark phase r=sfink\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312236\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h"], "git_node": "2ce89cd4cd09c43cdc37265615cdd661b6a9a387", "git_parents": ["7a8efbffdb7ec4dee859c0ff45f7425e3ff067e2"], "node": "dc81c14ca1e6a2b309f0f05d666c3b4994c626c6", "parents": ["e1297e6e2434e1afb82c81bc8be4ea2dd7382302"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054454 - Part 2: Remove prepareForSweepSlice and do the work as needed r=sfink\n\nI don't think there's a good reason we need to do the minor GCs while we're\nstill marking. We can simplify things and only do them when required.\n\nFor the wrapper autorooter tracing we do need to do this while we're marking.\nWe can do that unconditionally though since it's likely to be a very small\namount of work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312237\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCInternals.h", "js/src/gc/GCRuntime.h", "js/src/gc/GenerateStatsPhases.py", "js/src/gc/Sweeping.cpp", "js/src/gc/Verifier.cpp"], "git_node": "7524b70948f2506c73fd7291e7b47147c5b5f5ed", "git_parents": ["2ce89cd4cd09c43cdc37265615cdd661b6a9a387"], "node": "a6c07c1adad53880ec5b926e68a5a4fe1c50b50d", "parents": ["dc81c14ca1e6a2b309f0f05d666c3b4994c626c6"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053827 - Service the RemoteWorkerDebugger IPC handshake from a worker's nested sync loop. r=asuth\n\nWorkerPrivate::Enable/DisableRemoteDebugger block the worker's parent thread\nuntil the registration/unregistration handshake reply (RecvRegisterDone /\nRecvUnregisterDone) runs on the worker thread. That reply is delivered on the\nworker's debugger queue, which a nested RunCurrentSyncLoop does not drain, so a\nworker parked in a sync loop that needs the parent thread (e.g. a SharedWorker\nrunning new EventSource()) deadlocks the content process when the owner page is\nfrozen/thawed via bfcache.\n\nKeep the synchronous registration contract but let RunCurrentSyncLoop service\nonly the debugger IPC handshake runnables (WrappedDebuggerRunnable) while\nmProcessDebuggerIPCHandshake is set, leaving debugger script/message runnables\ndeferred to DoRunLoop as before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312004\n", "files": ["dom/workers/Queue.h", "dom/workers/WorkerEventTarget.cpp", "dom/workers/WorkerPrivate.cpp", "dom/workers/WorkerPrivate.h", "dom/workers/WorkerRunnable.h", "dom/workers/test/mochitest.toml", "dom/workers/test/remoteDebugger_freeze_syncloop_frame.html", "dom/workers/test/remoteDebugger_freeze_syncloop_hang.sjs", "dom/workers/test/remoteDebugger_freeze_syncloop_nav.html", "dom/workers/test/remoteDebugger_freeze_syncloop_worker.js", "dom/workers/test/test_remoteDebugger_freeze_syncloop.html"], "git_node": "55ed8fbb01b8e28c99507a45829130af6c332a60", "git_parents": ["7524b70948f2506c73fd7291e7b47147c5b5f5ed"], "node": "ed74df8f8e4af2c28ac50892fdde3a928e534542", "parents": ["a6c07c1adad53880ec5b926e68a5a4fe1c50b50d"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054430 - Optimize EventChainVisitor mItemData usage r=dom-core-reviewers,jjaschke\" for causing fenix-debug failures\n\nThis reverts commit b46b43ee0cd669373b37cf953c19f9bbbcfe796f.\n", "files": ["dom/base/nsWindowRoot.cpp", "dom/events/EventDispatcher.cpp", "dom/events/EventDispatcher.h"], "git_node": "979c1fbe16a15559e1321dbb2f49c75d8d2b3e30", "git_parents": ["55ed8fbb01b8e28c99507a45829130af6c332a60"], "node": "cba28cf65981f4c5112b372d806ff18f973bcabc", "parents": ["ed74df8f8e4af2c28ac50892fdde3a928e534542"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "73e27e04ede491367244d53576f7cf6ab8b5ac0c", "git_parents": ["979c1fbe16a15559e1321dbb2f49c75d8d2b3e30", "7fa9b602777418732e08b26d1ef6c9945c4bbd72"], "node": "4552d2c80da52b694179657f0f019361486b92b0", "parents": ["cba28cf65981f4c5112b372d806ff18f973bcabc", "4c1ce8f04007e1ebcc15ee64c68b6461c41413f9"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2051646 - Restrict TestSummaryFormatter output to unexpected results r=jgraham\n\nTighten the passthrough filtering so the summary only carries actionable\nsignal:\n\n- Strip additional crash-related fields (stack, js_source, minidump_path,\n  crashing_thread_stack) from every emitted record.\n- Drop more non-essential action types via a single _DROPPED_ACTIONS\n  tuple: assertion_count, all log levels, lsan_leak, lsan_summary,\n  mozleak_total, process_start/exit, suite_start/end, and tsan_error.\n- Drop test_status records whose result matched the expectation, as the\n  docstring already described, so only unexpected results remain.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309622\n", "files": ["testing/mozbase/mozlog/mozlog/formatters/testsummary.py", "testing/mozbase/mozlog/tests/test_testsummary.py"], "git_node": "4ba6a5ecbf8f3588ae6b17db2bb2a1142c089a83", "git_parents": ["73e27e04ede491367244d53576f7cf6ab8b5ac0c"], "node": "df6765e874d2146b396833d27b8621f70b8ac22c", "parents": ["4552d2c80da52b694179657f0f019361486b92b0"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2051646 - Write the per-test summary to a fixed summary.jsonl filename r=ahal\n\nUse a stable summary.jsonl name for the per-test summary artifact instead\nof deriving it from the test suite and index, so consumers can locate it\nwithout knowing the suite naming scheme.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309623\n", "files": ["testing/mozharness/mozharness/mozilla/testing/per_test_base.py"], "git_node": "538afd8e6eb5a5528995678c1c0272ca3569be6a", "git_parents": ["4ba6a5ecbf8f3588ae6b17db2bb2a1142c089a83"], "node": "42b887dbf113586d43f92a59057120a91c89c77b", "parents": ["df6765e874d2146b396833d27b8621f70b8ac22c"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2056086 - Upgrade json5 and add test r=devtools-reviewers,nchevobbe\n\nUpgrade json5 v2.2.1 to v2.2.3, from UMD to ESM, mainly to get rid of\nunnecessary polyfills.\n\nAnd add a unit test that confirms that the library is indeed doing\nanything meaningful. `JSON5.parse` is called from utils.js, but\nreplacing it with `JSON.parse` did not cause test failures at first.\nThat is because no tests were added in bug 1260382, which introduced\nthe original version of the logic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312910\n", "files": ["devtools/client/storage/test/browser_storage_values.js", "devtools/client/storage/test/storage-complex-values.html", "devtools/shared/storage/utils.js", "devtools/shared/storage/vendor/JSON5_UPGRADING.md", "devtools/shared/storage/vendor/json5.js", "devtools/shared/storage/vendor/json5.mjs", "devtools/shared/storage/vendor/moz.build"], "git_node": "d348e369b7aa5c3f98d82244eaf05c5716e1a7e0", "git_parents": ["538afd8e6eb5a5528995678c1c0272ca3569be6a"], "node": "0342116fafeda23d48d433e2ecb198d7210948c4", "parents": ["42b887dbf113586d43f92a59057120a91c89c77b"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2056076 - Drop freezeBuiltins from devtools loader r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312911\n", "files": ["devtools/shared/loader/base-loader.sys.mjs"], "git_node": "eee439118f73def69ba96ae151200884ce37cf18", "git_parents": ["d348e369b7aa5c3f98d82244eaf05c5716e1a7e0"], "node": "ae5d0f6acbf668065a722b76e0da84687fbdfb6e", "parents": ["0342116fafeda23d48d433e2ecb198d7210948c4"], "tags": []}, {"author": "Nicolas Guichard \u003cnicolas.guichard@kdab.com\u003e", "branch": "default", "desc": "Bug 2055322 - Do not mark all XPIDL C++ overrides and infallible overloads as bindings. r=emilio\n\nIn bug 2053134, I applied the binding_to annotation to all declarations\nwhen generating the C++ headers, including the ones in macros used by\nimplementation classes to declare their overrides and the infallible\noverloads.\n\nInstead this only marks the pure virtual declaration and the non-\nvirtual declarations from the `NS_DECL_NON_VIRTUAL_*` macros.\n\nSearchfox knows how the other declarations relate via usage or\noverridding.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312372\n", "files": ["xpcom/idl-parser/xpidl/header.py"], "git_node": "94ec8fcdd3328030031733f5d77d834f083b48e5", "git_parents": ["eee439118f73def69ba96ae151200884ce37cf18"], "node": "11d07fb017b2a80a5ae538edefd922dc7ffa5441", "parents": ["ae5d0f6acbf668065a722b76e0da84687fbdfb6e"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2051391 - [geckodriver] Update changeset for the 0.37.1 release. r=geckodriver-reviewers,jgraham DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312514\n", "files": ["testing/geckodriver/CHANGES.md", "testing/geckodriver/doc/Support.md"], "git_node": "ae5c97eee98f80c3824c33932aef25841bc02362", "git_parents": ["94ec8fcdd3328030031733f5d77d834f083b48e5"], "node": "bbfedae2a874550406fe12f208eff9a02a0f3f99", "parents": ["11d07fb017b2a80a5ae538edefd922dc7ffa5441"], "tags": []}, {"author": "Ashley Hale \u003cahale@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055054 - query HDR display information and show it in about:support r=gfx-reviewers,geckoview-reviewers,win-reviewers,bradwerth,nalexander,yjuglaret\n\nThis also fixes a bug in initializing MaxContentLightLevel but we currently aren't using that value so it does not change observed behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312205\n", "files": ["dom/ipc/DOMTypes.ipdlh", "gfx/thebes/DeviceManagerDx.cpp", "gfx/thebes/gfxPlatform.cpp", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/GeckoAppShell.java", "widget/Screen.cpp", "widget/Screen.h", "widget/ScreenManager.cpp", "widget/android/ScreenHelperAndroid.cpp", "widget/cocoa/ScreenHelperCocoa.mm", "widget/gtk/ScreenHelperGTK.cpp", "widget/headless/HeadlessScreenHelper.cpp", "widget/uikit/ScreenHe