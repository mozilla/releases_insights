tatements/for-of/shell.js", "js/src/tests/test262/language/statements/using/initializer-disposed-at-end-of-imported-module.js", "js/src/tests/test262/language/statements/using/initializer-disposed-at-end-of-imported-module_FIXTURE.js", "js/src/tests/test262/language/statements/using/initializer-disposed-at-end-of-module.js", "js/src/tests/test262/language/statements/using/shell.js", "js/src/tests/test262/shell.js", "js/src/tests/test262/staging/explicit-resource-management/shell.js", "js/src/tests/test262/staging/sm/Error/constructor-proto.js", "js/src/tests/test262/staging/sm/Error/prototype-properties.js", "js/src/tests/test262/staging/sm/Error/prototype.js", "js/src/tests/test262/staging/sm/Error/shell.js", "js/src/tests/test262/staging/source-phase-imports/shell.js"], "git_node": "de716cc105eaa851974e61d25bccf84f5f6b9507", "git_parents": ["ae1e679a42aefad797a8206e31cbe00bb1ae5133"], "node": "fa53cd200818b693055e6d95ce08fb196ce39e1b", "parents": ["dbb1d4dc3559031b189d54b6b79f654e23bf7f29"], "tags": []}, {"author": "Cornelius Emase \u003ccorneliuslochipi@gmail.com\u003e", "branch": "default", "desc": "Bug 2057270 - Ship Promise.allKeyed and Promise.allSettledKeyed. r=arai,dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315996\n", "files": ["js/src/builtin/Promise.cpp", "js/src/vm/JSObject.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "21cbe7020e51b933740a15ef1d8ad11c057ac18f", "git_parents": ["de716cc105eaa851974e61d25bccf84f5f6b9507"], "node": "aefb725d0eb9882a89c20a100616d1f6103847a4", "parents": ["fa53cd200818b693055e6d95ce08fb196ce39e1b"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057270 - Update test_xrayToJS for Promise.allKeyed and allSettledKeyed; r=nika\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316629\n", "files": ["js/xpconnect/tests/chrome/test_xrayToJS.xhtml"], "git_node": "1f5eb454dfe402a75259ed3f862c2870439a98b8", "git_parents": ["21cbe7020e51b933740a15ef1d8ad11c057ac18f"], "node": "74561f34b2a3e2a4cca0bddd4f9ce9f447fb659d", "parents": ["aefb725d0eb9882a89c20a100616d1f6103847a4"], "tags": []}, {"author": "Daniel Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057270 - Update Promise.allKeyed non262 tests skip condition; r=arai\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317159\n", "files": ["js/src/tests/non262/Promise/allKeyed.js", "js/src/tests/non262/Promise/allKeyedModifiedPrototype.js", "js/src/tests/non262/Promise/allKeyedModifiedThenable.js", "js/src/tests/non262/Promise/allSettledKeyed.js", "js/src/tests/non262/Promise/allSettledKeyedModifiedPrototype.js"], "git_node": "008822765dd88ad036a43ebf448d977acda71874", "git_parents": ["1f5eb454dfe402a75259ed3f862c2870439a98b8"], "node": "24319b02ba78dd26fff7812b6b5f0ac218e102df", "parents": ["74561f34b2a3e2a4cca0bddd4f9ce9f447fb659d"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054210 - Remove Firefox logo from Sync QR-code dialog r=desktop-theme-reviewers,hjones\n\nThis removes the outdated Firefox logo from the Sync QR-code dialog, along with the phantom dark bar that showed at the bottom of the modal in dark themes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316931\n", "files": ["browser/base/content/logos/fxa-logo.svg", "browser/base/jar.mn", "browser/components/preferences/fxaPairDevice.js", "browser/components/preferences/fxaPairDevice.xhtml", "browser/themes/shared/preferences/fxaPairDevice.css", "browser/themes/shared/preferences/preferences.css"], "git_node": "60fb35604d12156502176964ea238130ec871afa", "git_parents": ["008822765dd88ad036a43ebf448d977acda71874"], "node": "63aeecc3800b7087bce148f3f343fc82c5e5330c", "parents": ["24319b02ba78dd26fff7812b6b5f0ac218e102df"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2058312 - Part 1: Add PromoCard highlighting the Collections to Tab Groups migration r=android-reviewers,android-l10n-reviewers,parker,npoon\n\n- Figma: https://www.figma.com/design/iBmi6I1Q2oSXqJMjguOfwb/Tab-Groups-Android?node-id=22338-14559&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314589\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/collections/CollectionsMigrationPromoCard.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "904c4b1ebd7066ac8dc76279c61142200113d9aa", "git_parents": ["60fb35604d12156502176964ea238130ec871afa"], "node": "85bdbfad031773478b6cc8904fc9a655c602a309", "parents": ["63aeecc3800b7087bce148f3f343fc82c5e5330c"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2062312 - Remove dev-tools test execution from tae-arm Flank configuration r=jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317558\n", "files": ["mobile/android/test_infra/flank-configs/fenix/arm-tae-tests.yml"], "git_node": "52a029267391ba990422854a178120fde26ba741", "git_parents": ["904c4b1ebd7066ac8dc76279c61142200113d9aa"], "node": "11fb4c259453f5fbdd3709b9dbf2cd816349e268", "parents": ["85bdbfad031773478b6cc8904fc9a655c602a309"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1179722 - Send SSPI channel bindings on the initial InitializeSecurityContext call. r=valentin\n\nThe SEC_CHANNEL_BINDINGS buffer was only ever built on continuation calls. That\nis sufficient for raw NTLM, whose channel binding travels in message 3, but\nSPNEGO carries the AP-REQ in the very first token, so Kerberos needs the\nbindings from the initial call on and never received them.\n\nMove the token construction into a helper and attach it whenever a certificate\nis available, building the input buffer descriptor up front so it can be passed\nwith no accompanying token. Keep the certificate for the lifetime of the\nsequence instead of freeing it after first use, so every leg of a multi-leg\nexchange carries the bindings.\n\nThe exemption for PACKAGE_TYPE_NTLM covers the sys-ntlm module only, which\nkeeps behaving exactly as it does today. NTLM negotiated inside SPNEGO runs\nunder PACKAGE_TYPE_NEGOTIATE and will now carry bindings from the first call:\nthat is the main behaviour change here and the one worth reviewing closely,\nsince raw NTLM is deliberately untouched.\n\nOn its own this commit changes nothing, because no caller supplies a\ncertificate on the Negotiate path until the next one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316807\n", "files": ["extensions/auth/nsAuthSSPI.cpp", "extensions/auth/nsAuthSSPI.h"], "git_node": "82c0d6adff99c053934606cb7338e2abf8f8293b", "git_parents": ["52a029267391ba990422854a178120fde26ba741"], "node": "0fecd717e23019edb3e1595ebef2f2d4128201b5", "parents": ["11fb4c259453f5fbdd3709b9dbf2cd816349e268"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 1179722 - Pass the server certificate to the Negotiate auth module. r=valentin\n\nnsHttpNegotiateAuth never retrieved the server certificate, so nsAuthSSPI had\nnothing to build a channel binding token from and Negotiate authentication\nnever sent one. Servers with Extended Protection set to Require reject that,\nwhich is why Kerberos SSO fails against ADFS and Exchange OWA where Chrome and\nEdge succeed. nsHttpNTLMAuth is the only caller that has ever supplied a\ncertificate.\n\nGenerateCredentials runs on a background thread, so the certificate is\ncollected on the main thread in GenerateCredentialsAsync, and only for a\nchallenge that carries no token of its own. That is the first call of a\nsequence, and the only call where nsAuthSSPI::GetNextToken expects a\ncertificate in place of the input token.\n\nProxy auth is excluded because the channel's security info describes the origin\nserver rather than the proxy. Extended Protection for proxies needs the proxy's\nown certificate and is left for a follow-up.\n\nnetwork.auth.negotiate_channel_binding backs the change out.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316808\n", "files": ["extensions/auth/nsHttpNegotiateAuth.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "16296c3bb3628cbfd7cbd8b99cbf54737f768dd7", "git_parents": ["82c0d6adff99c053934606cb7338e2abf8f8293b"], "node": "2039048f8f7d005d0710f60275884ebc5bcdb723", "parents": ["0fecd717e23019edb3e1595ebef2f2d4128201b5"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058595 - Fix perma failing browser/base/content/test/sync/browser_sync.js r=skhamis,desktop-theme-reviewers,Juliana\n\nThe failing test revealed an accessibility issue in focusing the undo button in the disabled button. This restructures the buttons to be siblings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316348\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/test/sync/browser_sync.js", "browser/components/customizableui/test/browser_synced_tabs_menu.js", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "b580d1214038f1f7060da66eaaa39544937f2106", "git_parents": ["16296c3bb3628cbfd7cbd8b99cbf54737f768dd7"], "node": "d4d3e17be803979a3c708b6c898eb10860a4fdbf", "parents": ["2039048f8f7d005d0710f60275884ebc5bcdb723"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056441 - Upgrade xsimd to 14.3.0 r=padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316889\n", "files": ["third_party/xsimd/Changelog.rst", "third_party/xsimd/include/xsimd/arch/common/xsimd_common_memory.hpp", "third_party/xsimd/include/xsimd/arch/common/xsimd_common_trigo.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_avx.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_avx2.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_avx2_128.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_avx512bw.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_avx512f.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_avx512vl_128.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_avx512vl_256.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_avx_128.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_common_fwd.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_fma3_avx2_128.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_isa.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_neon.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_rvv.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_sse2.hpp", "third_party/xsimd/include/xsimd/arch/xsimd_sve.hpp", "third_party/xsimd/include/xsimd/config/xsimd_arch.hpp", "third_party/xsimd/include/xsimd/config/xsimd_config.hpp", "third_party/xsimd/include/xsimd/types/xsimd_all_registers.hpp", "third_party/xsimd/include/xsimd/types/xsimd_api.hpp", "third_party/xsimd/include/xsimd/types/xsimd_avx512vl_register.hpp", "third_party/xsimd/include/xsimd/types/xsimd_avxvnni_register.hpp", "third_party/xsimd/include/xsimd/types/xsimd_batch.hpp", "third_party/xsimd/include/xsimd/types/xsimd_batch_constant.hpp", "third_party/xsimd/include/xsimd/types/xsimd_fma3_avx2_128_register.hpp", "third_party/xsimd/moz.yaml"], "git_node": "c419e57fd9b459c71299c64965801a9e2cb1ec95", "git_parents": ["b580d1214038f1f7060da66eaaa39544937f2106"], "node": "ad0f5e1758066d5ca639e3031cce0f2a067ddd11", "parents": ["d4d3e17be803979a3c708b6c898eb10860a4fdbf"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061667 - Display chooser actions when opening native share sheet through history, bookmarks, and recently closed r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317073\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarkFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/EditBookmarkFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/historymetadata/controller/HistoryMetadataGroupController.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/recentlyclosed/RecentlyClosedController.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/historymetadata/controller/HistoryMetadataGroupControllerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/recentlyclosed/DefaultRecentlyClosedControllerTest.kt"], "git_node": "b76728b55361ad4a91e4006c8eca299927da8313", "git_parents": ["c419e57fd9b459c71299c64965801a9e2cb1ec95"], "node": "d2dd12c9253586c0569eba96196d6bd31a0f51d5", "parents": ["ad0f5e1758066d5ca639e3031cce0f2a067ddd11"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052251 - Don't run AC lint when linting fenix/focus. r=geckoview-reviewers,nalexander,ahochheiden\n\nWhen running fenix lint, we already ignore the reports generated by AC lint tasks, but still run the AC lint gradle tasks. Skipping AC lint tasks in fenix linter brings the time down to 7 minutes locally. the same change saves about 3+ minutes on taskcluster. Taskcluster will still run all linters, including AC lints and locally we can still run mach lint -l android-ac linter as we normally would to catch lint issues in AC\n\nbefore: https://scans.gradle.com/s/pi7nzxvjlpyxc\nwith change: https://scans.gradle.com/s/7h5w4m3ug47gc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310121\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/SettingsPlugin.kt", "tools/lint/android/lints.py"], "git_node": "1634967ede3cc6dd33ea7f7a3548394b21bb1a79", "git_parents": ["b76728b55361ad4a91e4006c8eca299927da8313"], "node": "aa152450ec104cd8dddadca7049f865a3df545f7", "parents": ["d2dd12c9253586c0569eba96196d6bd31a0f51d5"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2020406 - Sanitize URLs before displaying them in the toolbar. r=android-reviewers,nalexander\n\nTrim surrounding whitespace and remove embedded non-space whitespace from displayed URLs,\nsimilar to what desktop is doing.\nRecalculate the registrable-domain range so highlighting the domain remains correct after\nthis new sanitization.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313725\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/Origin.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/utils/UrlTrimmer.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/utils/SanitizeUrlForDisplayTest.kt"], "git_node": "785920efc11667373d594f18ce684ac9467cd753", "git_parents": ["1634967ede3cc6dd33ea7f7a3548394b21bb1a79"], "node": "4789d5e8a7937ee8fc43333787b90aa495df8e55", "parents": ["aa152450ec104cd8dddadca7049f865a3df545f7"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038951 \u2014 hide splitview container elements containing hidden tabs r=tabbrowser-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312547\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/tabbrowser.js", "browser/components/tabbrowser/content/tabs.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "1af1e2fd57a2a6a596f7e99ddfc1950cfd54c3ec", "git_parents": ["785920efc11667373d594f18ce684ac9467cd753"], "node": "702bba8976eab1f8da9562df9a2b04f0b0281357", "parents": ["4789d5e8a7937ee8fc43333787b90aa495df8e55"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2062203 - Null-check accessible in ATK refSelectionCB (Coverity CID 1499900) r=accessibility-platform-reviewers,morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317477\n", "files": ["accessible/atk/nsMaiInterfaceSelection.cpp"], "git_node": "1426bdadc6cd0aa62f0985ecfad368f45a42e020", "git_parents": ["1af1e2fd57a2a6a596f7e99ddfc1950cfd54c3ec"], "node": "61d113891ebddcf622c8ec894df2c7f8a4ad7c05", "parents": ["702bba8976eab1f8da9562df9a2b04f0b0281357"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061015 - Sidebar: don't reserve space for the hidden secondary button in tab rows r=desktop-theme-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316766\n", "files": ["browser/components/sidebar/sidebar-tab-row.css"], "git_node": "9ca7b5a2f5f4965e3a82d988d81207c5b5cd5dd4", "git_parents": ["1426bdadc6cd0aa62f0985ecfad368f45a42e020"], "node": "20da1ac6b88bd012c550e40abd39e9c68784847c", "parents": ["61d113891ebddcf622c8ec894df2c7f8a4ad7c05"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2060972 - Show text/jsonl responses with the JSON Viewer r=nchevobbe,devtools-reviewers\n\ntext/jsonl is a common spelling for JSON Lines (e.g. ServiceStack serves\nit) that bug 2055774 did not cover, so such responses fell through to the\nplain text path instead of the JSON Viewer.\n\nAccept it in the sniffer alongside the application/ spellings, and in\nfixSave() so Save As restores the served type rather than falling back to\napplication/jsonl.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317542\n", "files": ["devtools/client/jsonview/Sniffer.sys.mjs", "devtools/client/jsonview/converter-child.js", "devtools/client/jsonview/test/browser_jsonview_jsonl.js", "devtools/docs/user/json_viewer/index.md"], "git_node": "a42cbce518dc29f4668da30d08a847b2f429f4af", "git_parents": ["9ca7b5a2f5f4965e3a82d988d81207c5b5cd5dd4"], "node": "5b2d85da895a6c6ba24a3f98d62c576ee68bf635", "parents": ["20da1ac6b88bd012c550e40abd39e9c68784847c"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2038951 \u2014 hide splitview container elements containing hidden tabs r=tabbrowser-reviewers,sclements\" for causing stylelint failure @ tabs.css\n\nThis reverts commit 1af1e2fd57a2a6a596f7e99ddfc1950cfd54c3ec.\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/content/tabbrowser.js", "browser/components/tabbrowser/content/tabs.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_splitview.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "14bfc0d5d2f8cc8a3382f4f4f398debc53ffab71", "git_parents": ["a42cbce518dc29f4668da30d08a847b2f429f4af"], "node": "a1967a1b87f09f4bae624f7db7a7f3d86c81d837", "parents": ["5b2d85da895a6c6ba24a3f98d62c576ee68bf635"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2061938 - Fix wasm AArch64 Spidermonkey assertion `baseOffset \u003c masm.readableSize()`.  r=bvisness.\n\nBug 2052811 introduced infrastructural changes relating to management of wasm\nTrapSites.  One of these is a new requirement, that registration of a TrapSite\n(via `masm.appendAndVerify(..)`) must happen after the related instruction has\nbeen emitted into masm; doing so before causes an assertion failure.\n\nOne AArch64-specific assembler routine, LoadExclusive(), did not get fixed up\ndue to inadequate testing on real hardware, resulting in an assertion failure\n`baseOffset \u003c masm.readableSize()`.  This patch fixes LoadExclusive().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317488\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64.cpp"], "git_node": "59ce6458025986e032821699abd0961bdd211e67", "git_parents": ["14bfc0d5d2f8cc8a3382f4f4f398debc53ffab71"], "node": "2d3e6d429cb570406ab4c39afa1c519e9b1a1116", "parents": ["a1967a1b87f09f4bae624f7db7a7f3d86c81d837"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1973126 - Add a nesting block limit to the CSS parser. r=firefox-style-system-reviewers,supply-chain-reviewers,dshin\n\nWe hit stack overflows from time to time due to broken websites. Seems\nbetter to fail to parse.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317537\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "servo/components/style/error_reporting.rs", "supply-chain/audits.toml", "supply-chain/config.toml", "third_party/rust/cssparser-macros/.cargo-checksum.json", "third_party/rust/cssparser-macros/.cargo_vcs_info.json", "third_party/rust/cssparser-macros/Cargo.lock", "third_party/rust/cssparser-macros/Cargo.toml", "third_party/rust/cssparser-macros/Cargo.toml.orig", "third_party/rust/cssparser-macros/lib.rs", "third_party/rust/cssparser/.cargo-checksum.json", "third_party/rust/cssparser/.cargo_vcs_info.json", "third_party/rust/cssparser/Cargo.lock", "third_party/rust/cssparser/Cargo.toml", "third_party/rust/cssparser/Cargo.toml.orig", "third_party/rust/cssparser/src/parser.rs", "third_party/rust/cssparser/src/size_of_tests.rs", "third_party/rust/cssparser/src/tests.rs"], "git_node": "ca8c1c378817ff36451e8b88c9cd394ade18d046", "git_parents": ["59ce6458025986e032821699abd0961bdd211e67"], "node": "3027511541dd713ce386c06bbf4fc0ee3ca4ea78", "parents": ["2d3e6d429cb570406ab4c39afa1c519e9b1a1116"], "tags": []}, {"author": "Leo Tenenbau