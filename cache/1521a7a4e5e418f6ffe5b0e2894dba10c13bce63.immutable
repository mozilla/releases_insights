ansport/nsIWebTransport.idl", "netwerk/socket/neqo_glue/NeqoHttp3Conn.h", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/gtest/TestHttp2WebTransport.cpp", "netwerk/test/gtest/TestHttp3ConnectUDPStream.cpp", "netwerk/test/unit/test_webtransport_simple.js"], "git_node": "50cb89dbd315e692da9f414f4ff7c93331fa47ee", "git_parents": ["3b5a94722152b1ba6fa1a46f8fd31618410b7495"], "node": "df11cb4f12c3130cdc245398018d08da7d65ada3", "parents": ["731b83856d16b76b0c467e466c051af0548e4145"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007165: Update WebTransportSendStreamOptions r=saschanaz,webidl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277253\n", "files": ["dom/webtransport/api/WebTransport.cpp"], "git_node": "a2430492c3ba60b7d5df1ff8f3ae4537629bd796", "git_parents": ["50cb89dbd315e692da9f414f4ff7c93331fa47ee"], "node": "ab8f1719e10d6e631adf78bb7aa725ac646e7681", "parents": ["df11cb4f12c3130cdc245398018d08da7d65ada3"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007174: Implement WebTransportDatagramsWritable interface r=saschanaz,webidl,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277251\n", "files": ["dom/webidl/WebTransportDatagramsWritable.webidl", "dom/webidl/moz.build", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransportDatagramsWritable.cpp", "dom/webtransport/api/WebTransportDatagramsWritable.h", "dom/webtransport/api/moz.build"], "git_node": "4dc01fb8be9809352190f0de7a2aa406cb52f479", "git_parents": ["a2430492c3ba60b7d5df1ff8f3ae4537629bd796"], "node": "c94c203cab370eaa989d9335e03d8a9587904f82", "parents": ["ab8f1719e10d6e631adf78bb7aa725ac646e7681"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007174: Add createWritable() to WebTransportDatagramDuplexStream r=saschanaz,webidl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277252\n", "files": ["dom/webidl/WebTransportDatagramDuplexStream.webidl", "dom/webtransport/api/WebTransport.h", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "dom/webtransport/api/WebTransportDatagramsWritable.cpp", "dom/webtransport/api/WebTransportDatagramsWritable.h", "dom/webtransport/api/WebTransportSendGroup.h"], "git_node": "3d334d3b17233db9fcf257a37ff07578d8aa742f", "git_parents": ["4dc01fb8be9809352190f0de7a2aa406cb52f479"], "node": "0f36ac7c6438df5c45acc792c056ae8976e63997", "parents": ["c94c203cab370eaa989d9335e03d8a9587904f82"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007174: Add WPTs for createWritable r=jib\n\nThe 'ready to use before session is established' subtest hits the\npre-existing single-slot mWaitConnect queue (Bug 1822138): createWritable()\n(landed just before this point) lets write_N_datagrams() issue several\nconcurrent early writes, and all but the last are silently dropped, hanging\nthe promise until the harness times out. That aborts the remaining\noutgoingMaxBufferedDatagrams/incomingMaxBufferedDatagrams/MaxBufferedDatagrams\nsubtests in the same global (NOTRUN) and can push the whole-file status to\nTIMEOUT.\n\nThis is fixed for real by the later 'Allow more than one datagram to be\nqueued waiting for connection to open' patch. Until the stack reaches that\npoint, mark TIMEOUT/NOTRUN as expected here so ./mach wpt reports no\nunexpected results.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280254\n", "files": ["testing/web-platform/meta/webtransport/datagram-bad-chunk.https.any.js.ini", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini", "testing/web-platform/meta/webtransport/idlharness.https.sub.any.js.ini", "testing/web-platform/meta/webtransport/sendgroup.https.any.js.ini", "testing/web-platform/tests/webtransport/datagrams-writable.https.any.js"], "git_node": "fc8d3638b8c023160df271d9f7a7ece29926f893", "git_parents": ["3d334d3b17233db9fcf257a37ff07578d8aa742f"], "node": "6d97ee85b2db556d11851fdf37fbe1961aa402a2", "parents": ["0f36ac7c6438df5c45acc792c056ae8976e63997"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2058308 - Add Nimbus flag and secret setting for hiding the collections UI r=android-reviewers,npoon\n\n- Add a Nimbus flag and secret settings that would be used for hiding the collections save entrypoints.\n- This is only about adding the Nimbus flags and Secret Settings and not the underlying functionality.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314586\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "1712fd09fee97b5b0b81fda6366d547a34a006c9", "git_parents": ["fc8d3638b8c023160df271d9f7a7ece29926f893"], "node": "189d1c10ed9010ccfa635ed9e8e1557346e7e2f0", "parents": ["6d97ee85b2db556d11851fdf37fbe1961aa402a2"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2058309 - Hide Collections save entrypoints in the menu and tabs tray r=android-reviewers,npoon\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314587\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MoreSettingsSubmenu.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/redux/state/TabsTrayState.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/TabManagementFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/banner/TabsTrayBanner.kt"], "git_node": "ec8ca3121f0c73481c9d759d6c9d03bec9138a07", "git_parents": ["1712fd09fee97b5b0b81fda6366d547a34a006c9"], "node": "ccc8694d16183b2377183d86c2ccba3c4bd2cc26", "parents": ["189d1c10ed9010ccfa635ed9e8e1557346e7e2f0"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057635 - Widen the js::NumberMod integer fast path from Int32 to Int64. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314689\n", "files": ["js/src/jit-test/tests/basic/bug2050945.js", "js/src/util/PortableMath.h"], "git_node": "5e068145631dcb605e3339b648c965dacd61da46", "git_parents": ["ec8ca3121f0c73481c9d759d6c9d03bec9138a07"], "node": "fc3f6c311cf72514ca790537b2469b7271c623ec", "parents": ["ccc8694d16183b2377183d86c2ccba3c4bd2cc26"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057635 - Reject the saturated result in the arm64 convertDoubleToPtr. r=iain\n\nconvertDoubleToPtr's contract is that either dest holds the exact integer\nvalue of src, or we branch to fail.\n\narm64 instead pairs the saturating Fcvtzs with a convert-back-and-compare\ncheck, and those two don't compose for the 64-bit case: INT64_MAX is not\nrepresentable as a double, so Scvtf rounds it back up to exactly 2^63 and the\ncomparison can't distinguish a saturated result from an exact one. An input of\n2^63 therefore passes the check and yields INT64_MAX.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314773\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "f361344238f848fae372a8f9d78e32d687262e3b", "git_parents": ["5e068145631dcb605e3339b648c965dacd61da46"], "node": "cccba4a368f012819c42e26cab205a8a6eeda0bc", "parents": ["fc3f6c311cf72514ca790537b2469b7271c623ec"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057635 - Inline an integer fast path for LModD. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314690\n", "files": ["js/src/jit-test/tests/basic/mod-double-integral.js", "js/src/jit/CodeGenerator.cpp", "js/src/jit/LIROps.yaml", "js/src/jit/Lowering.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h"], "git_node": "4c137f63cfd9b2fa3aa2bef9fb54aa034498e628", "git_parents": ["f361344238f848fae372a8f9d78e32d687262e3b"], "node": "596dd95e8e6477b1f62ea075927792027dd74cf3", "parents": ["cccba4a368f012819c42e26cab205a8a6eeda0bc"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2057635: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/jit/Lowering.cpp"], "git_node": "1196d9441f4c455f92a36bcdee7d909c4ea0a40f", "git_parents": ["4c137f63cfd9b2fa3aa2bef9fb54aa034498e628"], "node": "e7aa418da53b5e07c01daba5921ba1b94cf20f47", "parents": ["596dd95e8e6477b1f62ea075927792027dd74cf3"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2007174, Bug 2007165, Bug 2007150, Bug 2007160, Bug 2007206: Add WPTs for createWritable r=jib\" for causing build bustages\n\nThis reverts commit fc8d3638b8c023160df271d9f7a7ece29926f893.\n\nRevert \"Bug 2007174: Add createWritable() to WebTransportDatagramDuplexStream r=saschanaz,webidl\"\n\nThis reverts commit 3d334d3b17233db9fcf257a37ff07578d8aa742f.\n\nRevert \"Bug 2007174: Implement WebTransportDatagramsWritable interface r=saschanaz,webidl,smaug\"\n\nThis reverts commit 4dc01fb8be9809352190f0de7a2aa406cb52f479.\n\nRevert \"Bug 2007165: Update WebTransportSendStreamOptions r=saschanaz,webidl\"\n\nThis reverts commit a2430492c3ba60b7d5df1ff8f3ae4537629bd796.\n\nRevert \"Bug 2007165: Use per-writable algorithm and fully connect sendGroup/sendOrder r=saschanaz,necko-reviewers,valentin\"\n\nThis reverts commit 50cb89dbd315e692da9f414f4ff7c93331fa47ee.\n\nRevert \"Bug 2007150: Update wpts for WebTransport sub-protocol negotiation r=necko-reviewers,valentin\"\n\nThis reverts commit 3b5a94722152b1ba6fa1a46f8fd31618410b7495.\n\nRevert \"Bug 2007165: Hook up DOM WebTransport sendGroup support to necko & neqo implementation (early) r=necko-reviewers,webidl,kershaw,tschuster\"\n\nThis reverts commit ae9004a4a2b2828035c061ee9f97a747757cd6d9.\n\nRevert \"Bug 2007150: next step hooking up WebTransport sub-protocol support r=necko-reviewers,kershaw\"\n\nThis reverts commit 679e60c8d3174f55c095af69d8c83c143a0cd83d.\n\nRevert \"Bug 2007150: Hook up WebTransport sub-protocol negotiation r=necko-reviewers,dom-core-reviewers,smaug,valentin,ipc-reviewers\"\n\nThis reverts commit 9cc90dea3e019ab4c2162582c2df66d72a6a0a81.\n\nRevert \"Bug 2007150: Get the negotiated protocol from neqo for WebTransport r=necko-reviewers,kershaw\"\n\nThis reverts commit 20658c62af8ec7258645d692e22ecbeac4ec1fed.\n\nRevert \"Bug 2007165: Add WPTs for WebTransport SendGroup r=jib\"\n\nThis reverts commit 24d67cd36bae610c6cd470b1e82938af148c0617.\n\nRevert \"Bug 2007165: Wire up Create SendGroup WebTransport support r=necko-reviewers,kershaw\"\n\nThis reverts commit 81711771c06a3029ae49472e710265ec3d132eb9.\n\nRevert \"Bug 2007165: make WebTransport sendGroup id creation synchronous in the child r=saschanaz,necko-reviewers,valentin\"\n\nThis reverts commit ed9780c55df6a61009a49a6aec8137aa51bd3ee5.\n\nRevert \"Bug 2007165: Add API hookup for neqo to create WebTransport send groups r=necko-reviewers,kershaw\"\n\nThis reverts commit aba9ba21657e8c579b5419b257624ce141783eb2.\n\nRevert \"Bug 2007165: Implement WebTransportSendGroup interface r=saschanaz,necko-reviewers,webidl,smaug,valentin\"\n\nThis reverts commit 8e9c58616a60e8a05d34e85e567b59d19ee91cdc.\n\nRevert \"Bug 2007160: Add WPT test for WebTransport draining promise r=jib\"\n\nThis reverts commit bcd7d64215eb3fdd84dfd9d0fe8ef5d2ba06d358.\n\nRevert \"Bug 2007160: Finish hooking up Draining from neqo for WebTransport.  Add InvalidState error r=necko-reviewers,kershaw\"\n\nThis reverts commit 15ec5c3090eeb8089e6f4bf278002813e6f23059.\n\nRevert \"Bug 2007160: Add draining promise attribute to WebTranport r=necko-reviewers,webidl,saschanaz,kershaw\"\n\nThis reverts commit e336c3b62c71963cd16ae09b410111c3eefa4b9b.\n\nRevert \"Bug 2007150: Add protocols option to WebTransportOptions - partial DOM-only impl r=webidl,saschanaz,necko-reviewers,kershaw\"\n\nThis reverts commit 061cafdb376a26c8786d09399cb525ea9ed66815.\n\nRevert \"Bug 2007206: Make WebTransportHash members required r=saschanaz,webidl,necko-reviewers,kershaw\"\n\nThis reverts commit a1a9e3128b22ff428df62d82470657569ea2a84c.\n", "files": ["dom/webidl/WebTransport.webidl", "dom/webidl/WebTransportDatagramDuplexStream.webidl", "dom/webidl/WebTransportDatagramsWritable.webidl", "dom/webidl/WebTransportSendGroup.webidl", "dom/webidl/WebTransportSendReceiveStream.webidl", "dom/webidl/moz.build", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "dom/webtransport/api/WebTransportBidirectionalStream.cpp", "dom/webtransport/api/WebTransportBidirectionalStream.h", "dom/webtransport/api/WebTransportDatagramDuplexStream.cpp", "dom/webtransport/api/WebTransportDatagramDuplexStream.h", "dom/webtransport/api/WebTransportDatagramsWritable.cpp", "dom/webtransport/api/WebTransportDatagramsWritable.h", "dom/webtransport/api/WebTransportSendGroup.cpp", "dom/webtransport/api/WebTransportSendGroup.h", "dom/webtransport/api/WebTransportSendStream.cpp", "dom/webtransport/api/WebTransportSendStream.h", "dom/webtransport/api/WebTransportStreams.cpp", "dom/webtransport/api/moz.build", "dom/webtransport/child/WebTransportChild.cpp", "dom/webtransport/child/WebTransportChild.h", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "dom/webtransport/shared/PWebTransport.ipdl", "ipc/glue/BackgroundParentImpl.cpp", "ipc/glue/BackgroundParentImpl.h", "ipc/glue/PBackground.ipdl", "netwerk/protocol/http/Http2WebTransportSession.cpp", "netwerk/protocol/http/Http2WebTransportSession.h", "netwerk/protocol/http/Http2WebTransportStream.cpp", "netwerk/protocol/http/Http2WebTransportStream.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h", "netwerk/protocol/http/Http3WebTransportSession.cpp", "netwerk/protocol/http/Http3WebTransportSession.h", "netwerk/protocol/http/Http3WebTransportStream.cpp", "netwerk/protocol/http/Http3WebTransportStream.h", "netwerk/protocol/http/WebTransportSessionBase.h", "netwerk/protocol/http/WebTransportStreamBase.h", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/WebTransportSessionProxy.h", "netwerk/protocol/webtransport/WebTransportStreamProxy.cpp", "netwerk/protocol/webtransport/WebTransportStreamProxy.h", "netwerk/protocol/webtransport/nsIWebTransport.idl", "netwerk/protocol/webtransport/nsIWebTransportStream.idl", "netwerk/socket/neqo_glue/NeqoHttp3Conn.h", "netwerk/socket/neqo_glue/src/lib.rs", "netwerk/test/gtest/TestHttp2WebTransport.cpp", "netwerk/test/gtest/TestHttp3ConnectUDPStream.cpp", "netwerk/test/unit/test_webtransport_simple.js", "testing/web-platform/meta/webtransport/connect.https.any.js.ini", "testing/web-platform/meta/webtransport/constructor.https.sub.any.js.ini", "testing/web-platform/meta/webtransport/datagram-bad-chunk.https.any.js.ini", "testing/web-platform/meta/webtransport/datagrams.https.any.js.ini", "testing/web-platform/meta/webtransport/draining.https.any.js.ini", "testing/web-platform/meta/webtransport/idlharness.https.sub.any.js.ini", "testing/web-platform/meta/webtransport/sendorder.https.any.js.ini", "testing/web-platform/tests/tools/webtransport/h3/capsule.py", "testing/web-platform/tests/tools/webtransport/h3/handler.py", "testing/web-platform/tests/tools/webtransport/h3/webtransport_h3_server.py", "testing/web-platform/tests/webtransport/connect.https.any.js", "testing/web-platform/tests/webtransport/constructor.https.sub.any.js", "testing/web-platform/tests/webtransport/datagrams-writable.https.any.js", "testing/web-platform/tests/webtransport/draining.https.any.js", "testing/web-platform/tests/webtransport/handlers/server-drain.py", "testing/web-platform/tests/webtransport/sendgroup.https.any.js"], "git_node": "352e9cd54a0d150131d8f86e6be1287ee48e1822", "git_parents": ["1196d9441f4c455f92a36bcdee7d909c4ea0a40f"], "node": "cf21b58fd19dafc349a75c13ae275095d277ba62", "parents": ["e7aa418da53b5e07c01daba5921ba1b94cf20f47"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1605115 - Part 1. Add CMYK and inverted CMYK to SurfaceFormat. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314422\n", "files": ["gfx/2d/Types.cpp", "gfx/2d/Types.h", "gfx/layers/d3d11/TextureD3D11.cpp", "gfx/webrender_bindings/RenderD3D11TextureHost.cpp"], "git_node": "cb1452f15ce50af7e045360f7815fcfe7a3f29ac", "git_parents": ["352e9cd54a0d150131d8f86e6be1287ee48e1822"], "node": "a432386dd138a78b2da034946157ea624d9307d6", "parents": ["cf21b58fd19dafc349a75c13ae275095d277ba62"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1605115 - Part 2. Add fallback implementation for CMYK swizzling. r=gfx-reviewers,bradwerth\n\nThis fallback should already be much faster than the implementation\nin nsJPEGDecoder, which is removed in a later patch in this series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314423\n", "files": ["gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleHelpers.h"], "git_node": "866fd512bc5c3be0df423bff5835672f3ce88403", "git_parents": ["cb1452f15ce50af7e045360f7815fcfe7a3f29ac"], "node": "643061af2541da3563557920bb6ebd59940ff21e", "parents": ["a432386dd138a78b2da034946157ea624d9307d6"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1605115 - Part 3. Add SIMD variants of CMYK swizzling. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314425\n", "files": ["gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleAVX2.cpp", "gfx/2d/SwizzleGeneric.h", "gfx/2d/SwizzleNEON.cpp", "gfx/2d/SwizzleSSE2.cpp"], "git_node": "661088f6ae5dfcce9318a02a0aed9549eaf0d1ee", "git_parents": ["866fd512bc5c3be0df423bff5835672f3ce88403"], "node": "cab2c056c95e548152e06296e842739ceef638ee", "parents": ["643061af2541da3563557920bb6ebd59940ff21e"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1605115 - Part 4. Add correctness and performance tests for CMYK swizzling. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314426\n", "files": ["gfx/tests/gtest/SwizzleGeneric.cpp", "gfx/tests/gtest/TestSwizzle.cpp"], "git_node": "45bd33862252a289cab56aae1daaaad6b889b468", "git_parents": ["661088f6ae5dfcce9318a02a0aed9549eaf0d1ee"], "node": "9d7ef430310a50e649d9a44b3d59c763ee1a1bee", "parents": ["cab2c056c95e548152e06296e842739ceef638ee"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1605115 - Part 5. Switch nsJPEGDecoder to use the new CMYK swizzling. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314427\n", "files": ["image/SurfacePipeFactory.h", "image/decoders/nsJPEGDecoder.cpp"], "git_node": "aa75c5de03afe65b8d51d8b3be14ebdfc8e0fd90", "git_parents": ["45bd33862252a289cab56aae1daaaad6b889b468"], "node": "e97dfc3cb5ff09065be3e217d2d5853e954f92f3", "parents": ["9d7ef430310a50e649d9a44b3d59c763ee1a1bee"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057009 - The shield should not start off with the check mark as default regardless if trackers are found or not. r=urlbar-reviewers,desktop-theme-reviewers,dao,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313607\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/browser.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_pages.js", "browser/themes/shared/identity-block/identity-block.css"], "git_node": "65e76fd8c0e3d8473a860d98c338a281d91aa3cc", "git_parents": ["aa75c5de03afe65b8d51d8b3be14ebdfc8e0fd90"], "node": "739ffb366ba5f00897312b8865f995ea695739f6", "parents": ["e97dfc3cb5ff09065be3e217d2d5853e954f92f3"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040803 - Add a smart_window.client_error Glean event and its recorder r=gcardieri\n\nDefines the smart_window.client_error event and the parent-side\nSmartWindowTelemetry.recordClientError() that emits it.\n\nrecordClientError() is deliberately forgiving: callers hand it whatever\nwas thrown, including plain strings and cross-realm objects, and it pulls\nname/file/line off the value itself. Raw exception text is never sent -\nmessages are mapped onto a fixed set of keys derived from the reporting\nsurface or from common message text, and a caller that already knows what\na failure means passes the key itself rather than leaving the recorder to\nguess. The error type is not restated as a message key, it stays visible\nas the event's name extra. Identical (source, name, message) tuples are\ncapped per session so a hot render loop cannot flood Glean with copies of\none bug.\n\nThat vocabulary, plus the field extraction, lives in\nClientErrorTelemetry.mjs under content/ because the reporting hooks added\nin the rest of this stack run in both the chrome document and the chat\ncontent document, and both need to describe a failure the same way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D302883\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/ClientErrorTelemetry.mjs", "browser/components/aiwindow/ui/modules/SmartWindowTelemetry.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_SmartWindowTelemetry.js", "browser/components/aiwindow/ui/test/xpcshell/xpcshell.toml"], "git_node": "aee8b9bead83919ab5868e1e99e95a20f57e571a", "git_parents": ["65e76fd8c0e3d8473a860d98c338a281d91aa3cc"], "node": "6c11d6e9f2cba22207c476eef6a4a91fca23c235", "parents": ["739ffb366ba5f00897312b8865f995ea695739f6"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040803 - Record uncaught Smart Window chrome document errors r=gcardieri\n\nAdds window \"error\" and \"unhandledrejection\" listeners to ai-window and\nroutes what they catch into SmartWindowTelemetry.recordClientError().\n\nErrors thrown from inside Lit's update cycle are the ones we most want to\nsee, so they are bucketed separately from anything else that reaches the\nwindow: classifyClientErrorSource() checks whether the stack passes\nthrough lit.all.mjs. Both it and the listener wiring go in the shared\nClientErrorTelemetry module, since the chat content document installs the\nsame hooks later in this stack and only differs in how it reports what\nthey catch.\n\nEach event also carries the conversation the window was showing at the\ntime (mode, chat id, assistant message count, model), which is what makes\na report actionable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314407\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ClientErrorTelemetry.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_client_error_telemetry.js"], "git_node": "0957dfd2aa168af86bfa4e27d7a3210b3b8c3d15", "git_parents": ["aee8b9bead83919ab5868e1e99e95a20f57e571a"], "node": "8e6660c5966395ca0338d2838206b68694b1a63f", "parents": ["6c11d6e9f2cba22207c476eef6a4a91fca23c235"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040803 - Relay Smart Window chat content failures to the parent r=gcardieri\n\nThe chat content document runs in a privileged-about content process and\ncannot touch Glean, so failures there are dispatched as a composed\nAIChatContent:ClientError CustomEvent, relayed by AIChatContentChild, and\nrecorded by AIChatContentParent against the ai-window that owns the\nbrowser. That gives content-process errors the same correlation extras\nas chrome-side ones. The relayed detail already carries the event's own\nfield names, so nothing is renamed as it crosses.\n\nai-chat-content installs the same window \"error\"/\"unhandledrejection\"\nhooks as ai-window, plus a guard for message payloads that aren't\ndispatchable at all. The child actor also reports its own failures to\nhand a message to the content document, which were previously only\nvisible in the browser console. That one is only recognizable from where\nit is caught, so it travels as an explicit messageKey rather than leaving\nthe parent to work out what the failure was.\n\nBecause one throw can be both explicitly caught and rethrown into the\nwindow listeners, dispatchClientError() keeps a WeakSet of error objects\nit has already reported so it only sends one event per error.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314408\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/ui/actors/AIChatContentChild.sys.mjs", "browser/components/aiwindow/ui/actors/AIChatContentParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/modules/ClientErrorTelemetry.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_client_error_telemetry.js"], "git_node": "e2648d4d1a76bd0d7010019ac0c8ab9de5f98c46", "git_parents": ["0957dfd2aa168af86bfa4e27d7a3210b3b8c3d15"], "node": "64ba4729eebaef732d8cfe4e71a92dada9996dd7", "parents": ["8e6660c5966395ca0338d2838206b68694b1a63f"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2040803 - Record Smart Window markdown render failures r=gcardieri\n\nModel output is the least predictable input the chat UI has, so a\nmalformed response that trips the markdown parser or the sanitizer is\nworth its own bucket. Wrap the setHTML() call in ai-chat-message and\nreport the failure before rethrowing, leaving the existing failure\nbehaviour untouched.\n\nThe rethrown error also reaches the window \"error\" listener, but the\nWeakSet in dispatchClientError() means it is still only reported once,\nand as \"markdown\" rather than \"lit-render\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314409\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_client_error_telemetry.js"], "git_node": "d9e82ffb669750270382610041658f923b6913b7", "git_parents": ["e2648d4d1a76bd0d7010019ac0c8ab9de5f98c46"], "node": "91695ec0fd5d8f928ec0d13d7efab74cfb58bdfc", "parents": ["64ba4729eebaef732d8cfe4e71a92dada9996dd7"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057098. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314143\n", "files": ["gfx/2d/NativeFontResourceGDI.cpp", "gfx/2d/RecordedEventImpl.h", "gfx/2d/ScaledFontWin.cpp", "gfx/2d/UnscaledFontGDI.h"], "git_node": "13e1c72443c893ad3c3d8b1d793898af14b1fe2a", "git_parents": ["d9e82ffb669750270382610041658f923b6913b7"], "node": "e83463a0a0cc843681c3daf6dfdd9c55e42a14d8", "parents": ["91695ec0fd5d8f928ec0d13d7efab74cfb58bdfc"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053607. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311416\n", "files": ["gfx/wr/swgl/src/swgl_ext.h"], "git_node": "ce9b2134b9601962b642fa12cc34c3896cd80855", "git_parents": ["13e1c72443c893ad3c3d8b1d793898af14b1fe2a"], "node": "f92672c0d680612e06f6d647352f170eae82e6bb", "parents": ["e83463a0a0cc843681c3daf6dfdd9c55e42a14d8"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050584. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313883\n", "files": ["dom/canvas/WebGLFramebuffer.cpp"], "git_node": "e9eb24c961039abb436a85bc631c3a554c351cce", "git_parents": ["ce9b2134b9601962b642fa12cc34c3896cd80855"], "node": "9cf89cb797161fa69fc9c1ccbda3ce0af25a2d2a", "parents": ["f92672c0d680612e06f6d647352f170eae82e6bb"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055056. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312202\n", "files": ["dom/canvas/WebGLTransformFeedback.cpp"], "git_node": "fa9df688142f4cd6e8fa8f1623904d728caaa233", "git_parents": ["e9eb24c961039abb436a85bc631c3a554c351cce"], "node": "1531b25826d9e7a07ba77d2a55cfa611f72548cd", "parents": ["9cf89cb797161fa69fc9c1ccbda3ce0af25a2d2a"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057103. r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314204\n", "files": ["gfx/thebes/gfxDWriteFonts.cpp", "gfx/thebes/gfxDWriteFonts.h"], "git_node": "4a24932876e866c3b20a430777cabba7409420c6", "git_parents": ["fa9df688142f4cd6e8fa8f1623904d728caaa233"], "node": "1dac154e0f843c12594b4c3876e4ea31eb30939e", "parents": ["1531b25826d9e7a07ba77d2a55cfa611f72548cd"], "tags": []}, {"author": "iulian moraru \u003cimoraru@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057098. r=gfx-reviewers,bradwerth\" for causing windows build bustages on ScaledFontWin.cpp.\n\nThis reverts commit 13e1c72443c893ad3c3d8b1d793898af14b1fe2a.\n", "files": ["gfx/2d/NativeFontResourceGDI.cpp", "gfx/2d/RecordedEventImpl.h", "gfx/2d/ScaledFontWin.cpp", "gfx/2d/UnscaledFontGDI.h"], "git_node": "a57dcabf8c4c60afd804229693845d5d1cd3f6de", "git_parents": ["4a24932876e866c3b20a430777cabba7409420c6"], "node": "50f1e9747b20bd6631cffafe1a1ce86fda83f17f", "parents": ["1dac154e0f843c12594b4c3876e4ea31eb30939e"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057009 - The shield should not start off with the check mark as default regardless if trackers are found or not. r=urlbar-reviewers,desktop-theme-reviewers,dao,daleharvey\" for causing multiple failures\n\nThis reverts commit 65e76fd8c0e3d8473a860d98c338a281d91aa3cc.\n", "files": ["browser/base/content/browser-trustPanel.js", "browser/base/content/browser.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_icon.js", "browser/components/urlbar/tests/browser-trustPanel/browser_trust_panel_pages.js", "browser/themes/shared/identity-block/identity-block.css"], "git_node": "4957be692e9cfed153ac75697f31691ca2af6b03", "git_parents": ["a57dcabf8c4c60afd804229693845d5d1cd3f6de"], "node": "2c6c107bd3960b0593e39c16937b21116d871ede", "parents": ["50f1e9747b20bd6631cffafe1a1ce86fda83f17f"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057098. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314143\n", "files": ["gfx/2d/NativeFontResourceGDI.cpp", "gfx/2d/RecordedEventImpl.h", "gfx/2d/ScaledFontWin.cpp", "gfx/2d/UnscaledFontGDI.h"], "git_node": "930691d1625ab93b6c4dbcfc73d40a64f16cd2cc", "git_parents": ["4957be692e9cfed153ac75697f31691ca2af6b03"], "node": "413a3c1025f975e9e71b816d6464e08337eecd84", "parents": ["2c6c107bd3960b0593e39c16937b21116d871ede"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2057710. In moz icon protocal code, strip the placeholder file name's leading period before sending it to other code that does not expect it. r=gfx-reviewers,maxe,lsalzman\n\nnsIMozIconURI::fileExtension is a placeholder file name rather than a bare\nextension: it keeps the leading period so callers can use it directly as a\nstand-in for a file that may not exist. The Windows backend depends on this,\nhanding the value to SHGetFileInfo as a fake file name, and a lone \".\" is a\nlegitimate value meaning the name has no extension.\n\nTwo consumers passed that value straight to nsIMIMEService, which expects a bare\nextension. On Windows, getPrimaryExtension() with \".\" stripped the period and\nthen called nsMIMEInfoBase::AppendExtension() with an empty string, tripping its\nassertion. On Linux, getTypeFromExtension() could never match the dotless tables\nit consults first, so extension lookups only succeeded by way of\nnsGIOService::GetMimeTypeFromExtension() building \"file.\" + \".html\".\n\nConvert at both boundaries, and document the convention along with the\nconversion it requires on the attribute itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314600\n", "files": ["image/decoders/icon/gtk/nsIconChannel.cpp", "image/decoders/icon/win/nsIconChannel.cpp", "image/nsIIconURI.idl", "image/test/unit/test_moz_icon_uri.js"], "git_node": "a5b066c77d22eaacde6cf0408f867cb7c1fa3b63", "git_parents": ["930691d1625ab93b6c4dbcfc73d40a64f16cd2cc"], "node": "ea5acc63a0f94bd8523ea6f0b7f40ed55f24342a", "parents": ["413a3c1025f975e9e71b816d6464e08337eecd84"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058721 - Avoid reentrant calls of afterpaint function in helper_doubletap_zoom_smooth.html. r=tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314774\n", "files": ["gfx/layers/apz/test/mochitest/helper_doubletap_zoom_smooth.html"], "git_node": "f1c7b829af5bac5abd7641c3d581b84a74e9eb3c", "git_parents": ["a5b066c77d22eaacde6cf0408f867cb7c1fa3b63"], "node": "e9bfd48c5b8719663894c7b92a23bf6c1b1dc6d5", "parents": ["ea5acc63a0f94bd8523ea6f0b7f40ed55f24342a"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058721 - Double tap on a place close to the `target2`. r=tnikkel\n\nWith the original 65px offset, the place might be out of the viewport.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314775\n", "files": ["gfx/layers/apz/test/mochitest/helper_doubletap_zoom_smooth.html"], "git_node": "cf13a1c9d10831d12e2d88d8c56caf7983f2988e", "git_parents": ["f1c7b829af5bac5abd7641c3d581b84a74e9eb3c"], "node": "64f13d12597b69981a536ab94c91b54b99147426", "parents": ["e9bfd48c5b8719663894c7b92a23bf6c1b1dc6d5"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054543 - part 1: factor out common code on desktop which will also be used by Android; r=mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312642\n", "files": ["browser/components/reportbrokensite/ReportBrokenSite.sys.mjs", "browser/components/reportbrokensite/test/browser/browser_report_preview.js", "browser/components/reportbrokensite/test/browser/send_more_info.js", "toolkit/components/reportbrokensite/ReportBrokenSiteChild.sys.mjs", "toolkit/components/reportbrokensite/ReportBrokenSiteHelpers.mjs", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs", "toolkit/components/reportbrokensite/moz.build"], "git_node": "894d601303387f09602e166bebe80259a82b77b9", "git_parents": ["cf13a1c9d10831d12e2d88d8c56caf7983f2988e"], "node": "109e9205c7a72f652a55fb67aa72649b1551c6f7", "parents": ["64f13d12597b69981a536ab94c91b54b99147426"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054543 - part 2: have Fenix use the factored-out toolkit code to send broken site reports with Glean; r=tthibaud,ohall,geckoview-reviewers,android-reviewers,frontend-codestyle-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312643\n", "files": ["eslint-file-globals.config.mjs", "mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/engine-system/src/main/java/mozilla/components/browser/engine/system/SystemEngineSession.kt", "mobile/android/android-components/components/browser/state/src/test/java/mozilla/components/browser/state/engine/EngineObserverTest.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/EngineSession.kt", "mobile/android/android-components/components/concept/engine/src/test/java/mozilla/components/concept/engine/EngineSessionTest.kt", "mobile/android/android-components/components/feature/webcompat-reporter/build.gradle", "mobile/android/android-components/components/support/test-fakes/src/main/java/mozilla/components/support/test/fakes/engine/TestEngineSession.kt", "mobile/android/android-components/docs/changelog.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/GleanBrokenSiteReportSender.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/WebCompatReporterMoreInfoSender.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/di/WebCompatReporterMiddlewareProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatInfoDeserializer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatInfoDto.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterRetrievalService.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterSubmissionMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/fake/FakeEngineSession.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/middleware/DefaultWebCompatReporterRetrievalServiceTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/middleware/WebCompatReporterSubmissionMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/testdata/WebCompatTestData.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/modules/geckoview/GeckoViewContent.sys.mjs", "mobile/shared/modules/geckoview/test/mochitest/mochitest.toml", "mobile/shared/modules/geckoview/test/mochitest/test_geckoview_brokensitereporter.html"], "git_node": "39be27c0a25fa48581682a98649e4bece55e97ce", "git_parents": ["894d601303387f09602e166bebe80259a82b77b9"], "node": "e6fea2b6a5764212d5de88baa94975e22d037b2b", "parents": ["109e9205c7a72f652a55fb67aa72649b1551c6f7"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058773 - Make sure urlbar tests run with and without Nova now that Nova is enabled by default on Nightly. r=daisuke,urlbar-reviewers\n\nThis adds manifests that specifically disable Nova to ensure that both Nova and\nProton remain tested regardless of whether Nova is enabled by default.\n\nI renamed the `browserNova.toml` files `browser-nova.toml` because I think\nthat's a little nicer to read.\n\nOnce Nova is enabled by default on all channels and we don't need Proton\ncoverage anymore, we can:\n\n1. Remove all `browser-nova.toml` and `browser-proton.toml` files\n2. Update `BROWSER_CHROME_MANIFESTS` in `moz.build` so it includes the usual\n   `browser.toml` files\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314810\n", "files": ["browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-UrlbarInput/browser-nova.toml", "browser/components/urlbar/tests/browser-UrlbarInput/browser-proton.toml", "browser/components/urlbar/tests/browser-UrlbarInput/browserNova.toml", "browser/components/urlbar/tests/browser-UrlbarView/browser-nova.toml", "browser/components/urlbar/tests/browser-UrlbarView/browser-proton.toml", "browser/components/urlbar/tests/browser-UrlbarView/browserNova.toml", "browser/components/urlbar/tests/browser-autofill/browser-nova.toml", "browser/components/urlbar/tests/browser-autofill/browser-proton.toml", "browser/components/urlbar/tests/browser-autofill/browserNova.toml", "browser/components/urlbar/tests/browser-editing/browser-nova.toml", "browser/components/urlbar/tests/browser-editing/browser-proton.toml", "browser/components/urlbar/tests/browser-editing/browserNova.toml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser-nova.toml", "browser/components/urlbar/tests/browser-engagementTelemetry/browser-proton.toml", "browser/components/urlbar/tests/browser-engagementTelemetry/browserNova.toml", "browser/components/urlbar/tests/browser-quickactions/browser-nova.toml", "browser/components/urlbar/tests/browser-quickactions/browser-proton.toml", "browser/components/urlbar/tests/browser-quickactions/browserNova.toml", "browser/components/urlbar/tests/browser-results/browser-nova.toml", "browser/components/urlbar/tests/browser-results/browser-pr