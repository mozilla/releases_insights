parents": ["d6827db2aa8701f40434bc7f940b4942dff9ec98"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055127: Always verify that the cell still exists. r=eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312225\n", "files": ["accessible/base/CachedTableAccessible.cpp"], "git_node": "b334aa7a9c96a4763d834e5e781ee38c5cc9ea4e", "git_parents": ["28f8fb9edd7492f82da0a17c091d1353fcc1a2a6"], "node": "a3c11fd70a2dd95c495f4d9f559a9c95c7415c04", "parents": ["8b8cb78269526558848282f690e1b280e579507d"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055125: Only send accessibility info to the parent process if accessibility is in use there. r=eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312224\n", "files": ["accessible/base/NotificationController.cpp", "accessible/base/nsAccessibilityService.h", "accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "dom/ipc/BrowserParent.cpp"], "git_node": "7812a95acdb9ed484d7813719bf4ab35e20b568e", "git_parents": ["b334aa7a9c96a4763d834e5e781ee38c5cc9ea4e"], "node": "0a019529ae14bb4b80d05bdec873565289792c23", "parents": ["a3c11fd70a2dd95c495f4d9f559a9c95c7415c04"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050397 - Implement Passport management page r=mtigley,fluent-reviewers,desktop-theme-reviewers,credential-management-reviewers,mstriemer,flod\n\nAdd the \"Personal info\" preferences category and its manage subpage,\nbacked by passport autofill. How the preferences work:\n\n\"Personal info\" is a preferences-only grouping of autofill data types\n(passports today; more may join later). It is a pure UI concept, so the\ndata-type registry is intentionally unaware of it and the category's\nmembership is listed in passwords-autofill.mjs.\n\nThere is no dedicated category-level pref. Instead the single \"Save and\nautofill personal info\" checkbox stands in for the .enabled prefs of\nevery member type:\n\n  - Checked state: the box is checked when *any* member type's .enabled\n    pref is true (logical OR), and toggling it writes *every* member\n    type's .enabled pref. So enabling the box actually enables passport\n    autofill (extensions.formautofill.passports.enabled) rather than a\n    separate UI-only pref.\n\nVisibility follows the same rules the address and credit-card sections\nuse, keyed off each type's .supported pref via\nFormAutofill.isAutofillTypeAvailable():\n\n  - The Personal info section (checkbox and \"Manage\" entry point) is\n    shown whenever *any* member type is available.\n  - Inside the manage subpage, each type's controls (the add-passport\n    button and the passport list) are shown only when that type is\n    available, so an unsupported type surfaces no UI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308798\n", "files": ["browser/components/preferences/config/passwords-autofill.mjs", "browser/components/preferences/preferences.js", "browser/extensions/formautofill/content/autofillEditForms.mjs", "browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/content/editPassport.mjs", "browser/extensions/formautofill/content/editPassport.xhtml", "browser/extensions/formautofill/skin/shared/editPassport.css", "browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_editPassportDialog.js", "browser/extensions/formautofill/test/browser/browser_managePersonalInfoSubpage.js", "browser/extensions/formautofill/test/browser/head.js", "browser/locales/en-US/browser/preferences/formAutofill.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl", "browser/themes/shared/icons/personal-info-16.svg", "browser/themes/shared/jar.inc.mn", "browser/themes/shared/preferences/preferences.css", "toolkit/components/formautofill/FormAutofillPreferences.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs"], "git_node": "4e683092a9461dee6b550bacad6005df2d21e796", "git_parents": ["7812a95acdb9ed484d7813719bf4ab35e20b568e"], "node": "dad87f991e4b00b9b840c0f5ce029af6fbb45af0", "parents": ["0a019529ae14bb4b80d05bdec873565289792c23"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055125: Only send accessibility info to the parent process if accessibility is in use there. r=eeejay\" for causing unit and wpt failures at LocalAccessible::HandleAccEvent\n\nThis reverts commit 7812a95acdb9ed484d7813719bf4ab35e20b568e.\n", "files": ["accessible/base/NotificationController.cpp", "accessible/base/nsAccessibilityService.h", "accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h", "accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "dom/ipc/BrowserParent.cpp"], "git_node": "54e504827b1989d0f8e056138ae14bda3a71628a", "git_parents": ["4e683092a9461dee6b550bacad6005df2d21e796"], "node": "6c2c4f00f03245fd300ecea1b1aa10124b04c5cc", "parents": ["dad87f991e4b00b9b840c0f5ce029af6fbb45af0"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050397 - Implement Passport management page r=mtigley,fluent-reviewers,desktop-theme-reviewers,credential-management-reviewers,mstriemer,flod\" for causing bc test failures at LateWriteChecks.cpp\n\nThis reverts commit 4e683092a9461dee6b550bacad6005df2d21e796.\n", "files": ["browser/components/preferences/config/passwords-autofill.mjs", "browser/components/preferences/preferences.js", "browser/extensions/formautofill/content/autofillEditForms.mjs", "browser/extensions/formautofill/content/editDialog.mjs", "browser/extensions/formautofill/content/editPassport.mjs", "browser/extensions/formautofill/content/editPasspor