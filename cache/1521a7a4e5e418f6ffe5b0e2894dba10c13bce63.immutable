6341dfbd84d7eb8a214d576c05d4e8ef071ecb0"], "node": "90fbc41335dd3402e34a905e5e8239935b5dcabb", "parents": ["74e49b69cdcad9f90f48428172041a2b80e42cc0"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from ce262a9607\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ce262a96070921045f970afeae268e8295fa70d4\n    Update WebRTC code version (2026-06-20T04:09:30).\n\n    Bug: None\n    Change-Id: I22189b8f057884da71f0a57ff2a0ba310f7b1383\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484160\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48049}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "37f58f74815f98402cfff9479b0ace7cdbc1047a", "git_parents": ["e0a30e10eee9c5500748ac11b9999dd5018d92a5"], "node": "d7d5c4d224eadafe38a3cc02f52aa5c954e96658", "parents": ["90fbc41335dd3402e34a905e5e8239935b5dcabb"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from a5ddff6086\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a5ddff6086d96fd2356ad6c521525ea2803f7988\n    Update WebRTC code version (2026-06-21T04:07:30).\n\n    Bug: None\n    Change-Id: I37deeeb96cf3b49aa1ba5c836266c917eeb90c53\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484360\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48050}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "846b3b32117bfdc5dde694c5f048b99082b4fe92", "git_parents": ["37f58f74815f98402cfff9479b0ace7cdbc1047a"], "node": "ab27999f6059cf64c5c871e3f366b6f4a1aafea2", "parents": ["d7d5c4d224eadafe38a3cc02f52aa5c954e96658"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from e175c7fe64\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e175c7fe64480b58f0a9ceb661aa27fdfc732279\n    Negotiate receiver reference time (RFC 3611 rtcp-xr:rcvr-rtt) in SDP\n\n    Add SDP support for negotiating non-sender RTT (RRTR/DLRR). A single\n    MediaContentDescription::receive_non_sender_rtt flag is the source of\n    truth; webrtc_sdp.cc is the only place that translates between the wire\n    forms and the flag:\n\n    - Parse: set the flag from either the standard a=rtcp-xr:rcvr-rtt or the\n      legacy non-standard a=rtcp-fb:\u003cpt\u003e rrtr.\n    - Generate: when the flag is set, emit BOTH forms (rtcp-xr plus, for\n      interim backward-compat, the legacy rtcp-fb rrtr per codec).\n\n    Advertised in offers/answers gated by the\n    WebRTC-RtcpXrReceiverReferenceTime field trial (default on, IsDisabled\n    to roll back). This CL only adds negotiation; enabling RRTR from the\n    flag is the stacked follow-up. When the legacy rtcp-fb form is dropped\n    later, only the parser/generator need change.\n\n    Bug: webrtc:516205747\n    Change-Id: Id7ad1e9b550bdfa372ddcf3dfdb0298310d407eb\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/479240\n    Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48051}\n", "files": ["third_party/libwebrtc/AUTHORS", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/webrtc_sdp.cc", "third_party/libwebrtc/api/webrtc_sdp_unittest.cc", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/pc/media_session.cc", "third_party/libwebrtc/pc/media_session_unittest.cc", "third_party/libwebrtc/pc/session_description.h"], "git_node": "b88e2a845bebb59db46e75e7b39db024269bdc9c", "git_parents": ["846b3b32117bfdc5dde694c5f048b99082b4fe92"], "node": "af923d94427ac67459262a98e0229990234c25fb", "parents": ["ab27999f6059cf64c5c871e3f366b6f4a1aafea2"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from b943e775d7\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b943e775d7aff3780135e361fe47ff2ff0138105\n    Update WebRTC code version (2026-06-22T04:08:52).\n\n    Bug: None\n    Change-Id: I2d2db78270923455e6c5f2e449b56556bda5da25\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484540\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48052}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "3b56aca758ef62aa964566264aaf48a18ade90e1", "git_parents": ["b88e2a845bebb59db46e75e7b39db024269bdc9c"], "node": "f0f9a624d70e5476bcab47efab95161c588be1cb", "parents": ["af923d94427ac67459262a98e0229990234c25fb"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 99e9d87fea\n\nUpstream commit: https://webrtc.googlesource.com/src/+/99e9d87feaa1dbfc16f22aad89d78415983450c1\n    Fix video recovery freeze on RTP seq number wrap\n\n    After a prolonged decode stall on an SFU (where the sender does not\n    back off under loss), the 16-bit RTP sequence number can advance by\n    more than half its range. This breaks two independent state machines\n    in the video receive pipeline, each freezing video for 60-150s:\n\n    1. RtpFrameReferenceFinder wrapper: AheadOf\u003cuint16_t\u003e(cleared_to, seq)\n       misjudges a fresh frame as \"already cleared\" and drops it before it\n       reaches a per-codec finder. Fixed by requiring the 32-bit RTP\n       timestamp (unambiguous over ~6.6 hours at 90 kHz) to also confirm\n       the frame is older before dropping. This is wrap-safe for all frame\n       types and backwards-compatible (callers that pass no timestamp keep\n       the original sequence-number-only behavior).\n\n    2. RtpSeqNumOnlyRefFinder: stale GoP entries from before the wrap sit\n       \"ahead\" of the new keyframe in 16-bit space, shadowing upper_bound()\n       lookups so delta frames are dropped (\"has no GoP\"). Fixed by\n       removing GoPs that appear ahead of a newly-arrived keyframe -- a\n       keyframe is the newest frame received, so an \"ahead\" GoP can only be\n       a stale leftover.\n\n    Both fixes address the same root cause (16-bit wrap ambiguity) at\n    different pipeline stages and are strictly less aggressive at dropping.\n\n    Tested: 3 new unit tests in rtp_frame_reference_finder_unittest.cc\n    (FrameNotDroppedWhenSeqWrapsButTimestampNewer,\n    ClearToSeqNumOnlyWithoutTimestamp,\n    DeltasNotDroppedByStaleGopAfterSeqNumJump); negative control confirms\n    the GoP test fails without the fix. Validated end-to-end on iOS against\n    a production SFU: 60-150s freeze plus 80s 1fps tail reduced to\n    immediate full-frame-rate recovery.\n\n    Bug: webrtc:516639936\n    Change-Id: I9790e3cf5cd6590b899de3e32d39f6d573ff205d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/477641\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48053}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/rtp_frame_reference_finder.cc", "third_party/libwebrtc/modules/video_coding/rtp_frame_reference_finder.h", "third_party/libwebrtc/modules/video_coding/rtp_frame_reference_finder_unittest.cc", "third_party/libwebrtc/modules/video_coding/rtp_seq_num_only_ref_finder.cc", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0060.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h", "third_party/libwebrtc/video/rtp_video_stream_receiver2_unittest.cc"], "git_node": "a6d97141130b4651dff1278443028db8af2b421c", "git_parents": ["3b56aca758ef62aa964566264aaf48a18ade90e1"], "node": "159102cc5f46312092ace137a6c99b9803206ac6", "parents": ["f0f9a624d70e5476bcab47efab95161c588be1cb"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 2bbdad27c9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/2bbdad27c967a62e8a23194047bc5fee8ca1c9be\n    Android: Expose VideoCapturer.isCapturing() and add tests\n\n    Add a boolean isCapturing() method to the VideoCapturer interface and\n    implement it in FileVideoCapturer, ScreenCapturerAndroid, and\n    CameraCapturer. Allows callers to query capture state without tracking\n    it externally.\n\n    Tests:\n    - FileVideoCapturerTest: lifecycle assertion (start -\u003e stop).\n    - CameraVideoCapturerTestFixtures: shared start/stop/restart helper,\n    wired into Camera1 (byte buffer + texture) and Camera2 tests.\n\n    Bug: webrtc:512514764\n    Change-Id: I576fec9721b69e328fdd8d2cd91c819cf67c19f4\n    Co-authored-by: Danilo Bargen \u003cdanilo.bargen@threema.ch\u003e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/472200\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Magnus Jedvert \u003cmagjed@webrtc.org\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48054}\n", "files": ["third_party/libwebrtc/AUTHORS", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/sdk/android/api/org/webrtc/FileVideoCapturer.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/ScreenCapturerAndroid.java", "third_party/libwebrtc/sdk/android/api/org/webrtc/VideoCapturer.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/CameraCapturer.java"], "git_node": "551b949dcab2a395a700f071770b1e40ccbcb307", "git_parents": ["a6d97141130b4651dff1278443028db8af2b421c"], "node": "5b3dce04019503a88a09eec72ea1d61df4c1f92b", "parents": ["159102cc5f46312092ace137a6c99b9803206ac6"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 067fe2a2a5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/067fe2a2a569d35a21e0d064aca845b438723963\n    Create api/video/timing directory.\n\n    Add `VideoJitterTimingInterface` and `VideoJitterTimingFactory` for creating instances of it.\n\n    Bug: b/493549134\n    Change-Id: Ib62cbe421adc967e68983ded85776f2bb31af305\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/482400\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Commit-Queue: \u00c5sa Persson \u003casapersson@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48055}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video/timing/BUILD.gn", "third_party/libwebrtc/api/video/timing/OWNERS", "third_party/libwebrtc/api/video/timing/video_jitter_timing_factory.h", "third_party/libwebrtc/api/video/timing/video_jitter_timing_interface.h"], "git_node": "002228d67ef1c4f03dd5cea07e551f851bbe80e6", "git_parents": ["551b949dcab2a395a700f071770b1e40ccbcb307"], "node": "10b8ed880f828415c3f66d8c61ff11300fefa469", "parents": ["5b3dce04019503a88a09eec72ea1d61df4c1f92b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 1cb8b39465\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1cb8b39465f466c2285f091ebc1859ab21689fd8\n    [infra] Add WebRTC CI builders to Gardener rotation\n\n    If this is configured correctly, This should make WebRTC CI builders appear on LUCI Monitoring.\n\n    https://ci.chromium.org/ui/labs/monitoring/webrtc\n\n    Change-Id: I894785fdff6dabf62ec563cb659eb730ce6f3708\n    Bug: None\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/483980\n    Reviewed-by: Christoffer Dewerin \u003cjansson@google.com\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48056}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/infra/config/builders.star", "third_party/libwebrtc/infra/config/generated/luci/cr-buildbucket.cfg"], "git_node": "d658ecc28c80ff065ab5cfb8f35324c524f2edf1", "git_parents": ["002228d67ef1c4f03dd5cea07e551f851bbe80e6"], "node": "7efce275c78303eeff954a51f5cd33edad6bc3ef", "parents": ["10b8ed880f828415c3f66d8c61ff11300fefa469"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 5707070dca\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5707070dca842a692cbd1fe03e8a6525ff2b30f1\n    Gracefully handle exceptions during Android AudioTrack and AudioRecord initialization\n\n    Bug: webrtc:524395191\n    Change-Id: I922b8ce77861361b939c5ebd751b54bcb1bb8334\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/483080\n    Reviewed-by: Henrik Andreassson \u003chenrika@webrtc.org\u003e\n    Reviewed-by: Henrik Lundin \u003chenrik.lundin@webrtc.org\u003e\n    Commit-Queue: Tim Na \u003cnatim@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48057}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0144.patch", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/audio/WebRtcAudioRecord.java", "third_party/libwebrtc/sdk/android/src/java/org/webrtc/audio/WebRtcAudioTrack.java"], "git_node": "4336015a8f447e086de0370c8b9684dc38295a62", "git_parents": ["d658ecc28c80ff065ab5cfb8f35324c524f2edf1"], "node": "982e855556bfcc0caa95a0cfbef1f9615950aac2", "parents": ["7efce275c78303eeff954a51f5cd33edad6bc3ef"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 732e34399f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/732e34399f55939c1ef7ac0e04f7cd98ea0e7521\n    NetEq Smart Flushing\n\n    Previously reverted but this feature is found to be useful in a\n    conditions where NeqEq buffer bloats and stays for prolonged duration\n    (10~15s). Original CL (https://webrtc-review.git.corp.google.com/c/src/+/193941).\n\n    This CL includes a fix on Units Mismatch (Samples vs. Milliseconds) in PartialFlush. In the original patch, the safety floor for flushing (target_level_threshold_ms, in milliseconds) was compared directly to the target buffer limit (target_level_samples, in samples). This rendered the safety floor useless, causing NetEq to perform aggressive flushes down to extremely low delays (e.g. 10ms), ignoring the configured protection floor of 500ms.\n\n    Bug: webrtc:12201\n    Change-Id: Ie51290d8332569f2c2f506eaaf3e8d8dc2904909\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/480020\n    Reviewed-by: Henrik Lundin \u003chenrik.lundin@webrtc.org\u003e\n    Commit-Queue: Tim Na \u003cnatim@google.com\u003e\n    Reviewed-by: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48058}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/modules/audio_coding/neteq/mock/mock_packet_buffer.h", "third_party/libwebrtc/modules/audio_coding/neteq/neteq_impl.cc", "third_party/libwebrtc/modules/audio_coding/neteq/neteq_impl_unittest.cc", "third_party/libwebrtc/modules/audio_coding/neteq/packet_buffer.cc", "third_party/libwebrtc/modules/audio_coding/neteq/packet_buffer.h", "third_party/libwebrtc/modules/audio_coding/neteq/packet_buffer_unittest.cc"], "git_node": "87b9d3a96388c64a65d5b3da8f61d9a9485daf7f", "git_parents": ["4336015a8f447e086de0370c8b9684dc38295a62"], "node": "1ec742b195317de900d311b14363a77efeedbb13", "parents": ["982e855556bfcc0caa95a0cfbef1f9615950aac2"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 7bc5bfcb2e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7bc5bfcb2e74c39e2bb74842320ff5dbdbb353e4\n    Roll chromium_revision 931ff8b850..40917eb28d (1649613:1650722)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/931ff8b850..40917eb28d\n    Full diff: https://chromium.googlesource.com/chromium/src/+/931ff8b850..40917eb28d\n\n    Changed dependencies\n    * siso_version: git_revision:0b5eb879ba9260eb6fd7dfe8f9437ef3396185c4..git_revision:7ea15ed68d4aa12fc4aaa50f5446e8549e8f1ce0\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/aa51416c54..ab8881f1c8\n    * src/buildtools/linux64: git_revision:c3f29c909a6255857093a797b9360b36f931b1cb..git_revision:d31e02004d860452bc7273f002f6890d0adc94fa\n    * src/buildtools/mac: git_revision:c3f29c909a6255857093a797b9360b36f931b1cb..git_revision:d31e02004d860452bc7273f002f6890d0adc94fa\n    * src/buildtools/win: git_revision:c3f29c909a6255857093a797b9360b36f931b1cb..git_revision:d31e02004d860452bc7273f002f6890d0adc94fa\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/a105df0f4a..9c2420753f\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/e48d98b687..ffd5efb795\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/badac9a00f..19e7537f62\n    * src/third_party/boringssl/src: https://boringssl.googlesource.com/boringssl.git/+log/606d3a344d..2bbaed043e\n    * src/third_party/breakpad/breakpad: https://chromium.googlesource.com/breakpad/breakpad.git/+log/432f6631bd..9aebd3d8ef\n    * src/third_party/catapult: https://chromium.googlesource.com/catapult.git/+log/42132fc77e..b7773c7098\n    * src/third_party/compiler-rt/src: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/compiler-rt.git/+log/242e3a3fe7..f079fcc71d\n    * src/third_party/depot_tools: https://chromium.googlesource.com/chromium/tools/depot_tools.git/+log/f710e50c6e..94e89b10b9\n    * src/third_party/eigen3/src: https://chromium.googlesource.com/external/gitlab.com/libeigen/eigen.git/+log/7bd98698c5..bf7d62172f\n    * src/third_party/fp16/src: https://chromium.googlesource.com/external/github.com/Maratyszcza/FP16.git/+log/3d2de18163..782eea126d\n    * src/third_party/fuzztest/src: https://chromium.googlesource.com/external/github.com/google/fuzztest.git/+log/e25dc3d4ba..6d428b093e\n    * src/third_party/grpc/src: https://chromium.googlesource.com/external/github.com/grpc/grpc.git/+log/3e1d845d43..c90dc002fe\n    * src/third_party/libFuzzer/src: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/compiler-rt/lib/fuzzer.git/+log/bea408a6e0..4b46c0ed58\n    * src/third_party/libaom/source/libaom: https://aomedia.googlesource.com/aom.git/+log/91f0010688..48d85cee07\n    * src/third_party/libunwind/src: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/libunwind.git/+log/d6c7a21e97..869520e696\n    * src/third_party/llvm-libc/src: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/libc.git/+log/b57686f741..37de7002cb\n    * src/third_party/perfetto: https://chromium.googlesource.com/external/github.com/google/perfetto.git/+log/c0ded1eb05..7f813cb4e9\n    * src/third_party/siso/cipd: git_revision:0b5eb879ba9260eb6fd7dfe8f9437ef3396185c4..git_revision:7ea15ed68d4aa12fc4aaa50f5446e8549e8f1ce0\n    * src/tools: https://chromium.googlesource.com/chromium/src/tools/+log/744b9dcad6..df320bd2db\n    DEPS diff: https://chromium.googlesource.com/chromium/src/+/931ff8b850..40917eb28d/DEPS\n\n    BUG=None\n\n    Change-Id: Iaa3e9fddc8517018b11aba0f0ef9195dc87151b3\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484760\n    Bot-Commit: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48059}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "3cc7d53e113be9ff1bd329cc21a646e0386ebbf0", "git_parents": ["87b9d3a96388c64a65d5b3da8f61d9a9485daf7f"], "node": "21b047e83bcdf99d1adb92e96c8f13d43356fa4b", "parents": ["1ec742b195317de900d311b14363a77efeedbb13"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from a1f7940b97\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a1f7940b9718d56086c93552deca81282ec53430\n    Update WebRTC code version (2026-06-23T04:09:21).\n\n    Bug: None\n    Change-Id: I26d053e63f09c6eed0faaeb25c283dedfa9cf35b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484800\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48060}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "402823d4fd4e2146f86424ed12b37931022258e9", "git_parents": ["3cc7d53e113be9ff1bd329cc21a646e0386ebbf0"], "node": "90e8a0d6eba8772d0297562dcfef04c3ee0aad36", "parents": ["21b047e83bcdf99d1adb92e96c8f13d43356fa4b"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 7decb1a7c2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7decb1a7c232cbc626b7e959e347f14ab3ecf37e\n    snap: fix race condition\n\n    With the SNAP out-of-band SCTP connect (WebRTC-Sctp-Snap), the dcSCTP\n    socket is created in DcSctpTransport::Start() but only connected later\n    in MaybeConnectSocket(), once the DTLS transport becomes writable. The\n    DTLS transport can decrypt and deliver an inbound packet as soon as its\n    handshake completes, which precedes writability (set_writable() is\n    deferred until ICE is writable). A packet arriving in that window is\n    delivered to the still-kClosed socket, which rejects it as having an\n    invalid verification tag.\n\n    End-to-end this is masked by SCTP retransmission, so it only surfaces as\n    an 'invalid verification tag' log line and a one-RTO delay opening the\n    data channel. The dcsctp_transport unit test observes the drop directly\n    via the mock socket.\n\n    Bug: webrtc:526609852\n    Change-Id: Iff17f2deb766ae465d68728d613e8c17d046263e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484720\n    Reviewed-by: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Reviewed-by: Denise Tell \u003cdct@google.com\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48061}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/BUILD.gn", "third_party/libwebrtc/media/sctp/dcsctp_transport.cc", "third_party/libwebrtc/media/sctp/dcsctp_transport_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0084.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0096.patch", "third_party/libwebrtc/moz-patch-stack/s0101.patch", "third_party/libwebrtc/moz-patch-stack/s0103.patch"], "git_node": "bec37d178b07e64078fd5b3f23fc2858a787a90a", "git_parents": ["402823d4fd4e2146f86424ed12b37931022258e9"], "node": "3440a1e0b37d4f9674e5d1863aff8c4dffb63605", "parents": ["90e8a0d6eba8772d0297562dcfef04c3ee0aad36"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 5fb7c52cb1\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5fb7c52cb190f8289b8d21798be5da7cffd41ab0\n    Roll chromium_revision 40917eb28d..1f12820c93 (1650722:1650828)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/40917eb28d..1f12820c93\n    Full diff: https://chromium.googlesource.com/chromium/src/+/40917eb28d..1f12820c93\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/ab8881f1c8..06e395135f\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/9c2420753f..7782a734d3\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/19e7537f62..dd440454f8\n    * src/tools: https://chromium.googlesource.com/chromium/src/tools/+log/df320bd2db..d5602d1db8\n    DEPS diff: https://chromium.googlesource.com/chromium/src/+/40917eb28d..1f12820c93/DEPS\n\n    BUG=None\n\n    Change-Id: I0800035b53eeff5ca6ed8f3d04a8e127f0554911\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484820\n    Commit-Queue: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48062}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "aeb58d2e598ac936248128be49d078d040295c35", "git_parents": ["bec37d178b07e64078fd5b3f23fc2858a787a90a"], "node": "aa7f1b71757985ffd12fd63ccd242649b5f02506", "parents": ["3440a1e0b37d4f9674e5d1863aff8c4dffb63605"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 28f9f6d4b9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/28f9f6d4b9eb6dfbfa36104389b09abe9e0154d6\n    Fix test window leaks in FullScreenWinApplicationHandlerTest\n\n    Track all created test windows in FullScreenWinApplicationHandlerTest\n    and destroy them in TearDown.\n\n    Bug: chromium:409473386\n    Change-Id: I6161f09203a039829c24f20b0e8a4dac8d6287fb\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484660\n    Commit-Queue: Palak Agarwal \u003cagpalak@google.com\u003e\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48063}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/desktop_capture/win/full_screen_win_application_handler_unittest.cc"], "git_node": "04d80f6f