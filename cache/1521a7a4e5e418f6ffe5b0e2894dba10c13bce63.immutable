bile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "79454b766cbebf83ea0a8b31ea3a01862d8be61f", "git_parents": ["a502487ad3c4524224256b7c0059fd6e12f89951"], "node": "ad7aebb2afccc91c059d41fc28936f16f5c005c6", "parents": ["9717b538797243510bfb43829132f265e64eccb3"], "tags": []}, {"author": "Elissa Cha \u003cecha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055657 - Add favicon preview variant to Smart Window conversation starter pills r=pdahiya\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313044\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.mjs", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.stories.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js", "browser/components/aiwindow/ui/test/browser/test_smartwindow_prompts.mjs", "browser/components/aiwindow/ui/test/browser/test_smartwindow_prompts_page.html"], "git_node": "ead9ad092e3bc8345915edd130b1ff7d5246132f", "git_parents": ["79454b766cbebf83ea0a8b31ea3a01862d8be61f"], "node": "5ef67cc66e3ea9520fd346d62061be007c1197bf", "parents": ["ad7aebb2afccc91c059d41fc28936f16f5c005c6"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2054085 - Hide the fullscreen sidebar launcher without restyling every tab r=emilio,desktop-theme-reviewers\n\nBug 1927457 hid the launcher along with the nav toolbox in F11, with\n`visibility: collapse`. That property is inherited, so every toolbar autoshow\nrestyled the whole launcher subtree, which holds a row per tab with vertical\ntabs: 162k elements and several seconds with a few thousand tabs.\n\n`content-visibility` is not inherited and skips the subtree, so hiding restyles\none element, and skipped content keeps what collapse gave us: no space, no\nfocus, no a11y. Zeroing the flex base size also reclaims the inline width of a\nuser-resized launcher. DOM fullscreen keeps collapsing, since it toggles once\nper transition and hides the panel and splitters too. Behavior is unchanged.\n\nMeasured headless with 600 lazy tabs, on the flush that shows the toolbox:\n312ms -\u003e 195ms, 90850 -\u003e 47315 frames reflowed. Hiding is flat in the tab count.\nShowing is not, and cannot be while the launcher leaves the layout: this removes\nthe restyle, not the reflow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314305\n", "files": ["browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/themes/shared/tabbrowser/fullscreen-and-pointerlock.css"], "git_node": "a5437b2743f6f42c90e6c8573e30f70772112458", "git_parents": ["ead9ad092e3bc8345915edd130b1ff7d5246132f"], "node": "19f8b3684004aaf33b7d2303dbdccefbdea4c509", "parents": ["5ef67cc66e3ea9520fd346d62061be007c1197bf"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 1830603 - Don't re-normalise a lone oversized corner radius on a clip r=gfx-reviewers,nical\n\nbackground-clip: padding-box|content-box clips to the inner border edge, which\ncss-backgrounds-3 4.4 defines as concentric with the outer edge with radii of\nouter-minus-border-width. Those can exceed the padding box and still describe a\nvalid shape: the arc centre falls outside the rect and the arc is cut by the far\nedges. clamped_radius() scaled them down, making the clip larger than the\nborder's inner curve, so the background spilled under the border and showed\nthrough wherever it was translucent.\n\nOnly constrain an edge when both of its corners are curved, which is the only\nway two arcs can overlap each other.\n\nThis can't be a blanket rule. A box-shadow's spread-adjusted radii are a plain\nrounded rect and do take the css-backgrounds-3 5.5 reduction; Chrome agrees on\nboth counts, and the two cases can't be told apart from the radii alone. So\nzero-blur box-shadows, which desugar into rounded-rect clips, are normalised at\nthe producer instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314543\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender_api/src/display_list.rs", "gfx/wr/wrench/reftests/boxshadow/box-shadow-zero-blur-overlapping-radii-ref.yaml", "gfx/wr/wrench/reftests/boxshadow/box-shadow-zero-blur-overlapping-radii.yaml", "gfx/wr/wrench/reftests/boxshadow/reftest.list", "gfx/wr/wrench/reftests/clip/clip-radius-exceeds-rect.png", "gfx/wr/wrench/reftests/clip/clip-radius-exceeds-rect.yaml", "gfx/wr/wrench/reftests/clip/reftest.list", "testing/web-platform/meta/css/css-backgrounds/background-clip-content-box-with-border-radius-003.html.ini", "testing/web-platform/meta/css/css-backgrounds/background-clip-padding-box-with-border-radius-003.html.ini"], "git_node": "25e660c8c3491b9a46f25914eebf2cccc6fb3996", "git_parents": ["a5437b2743f6f42c90e6c8573e30f70772112458"], "node": "9bf7613c28dd834df198d3a995a9260a7833c754", "parents": ["19f8b3684004aaf33b7d2303dbdccefbdea4c509"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029421 - Validate column indices in mozIntGemm select_columns_of_b builtin. r=bvisness\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313789\n", "files": ["js/src/intgemm/IntegerGemmIntrinsic.cpp", "js/src/jit-test/tests/wasm/builtin-modules/integer-gemm/I8SelectColumnsOfB.js"], "git_node": "7e565874c7d43a0f27a647db2caf875f806eda9b", "git_parents": ["25e660c8c3491b9a46f25914eebf2cccc6fb3996"], "node": "26ba7c9799892a9b243e2d935e2d8e833518ce46", "parents": ["9bf7613c28dd834df198d3a995a9260a7833c754"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058314 - Pt 1 - WebRender: delete the orphaned gradient LUT shader includes r=gfx-reviewers,nical\n\ngradient.glsl and gradient_shared.glsl implement the pre-quad colour-LUT\npath. Nothing includes them any more, but build.rs embeds every\nres/*.glsl in the binary regardless.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314503\n", "files": ["gfx/wr/webrender/res/gradient.glsl", "gfx/wr/webrender/res/gradient_shared.glsl"], "git_node": "99f0969bff54d9e3f392344855f6b862ec8a586e", "git_parents": ["7e565874c7d43a0f27a647db2caf875f806eda9b"], "node": "78d1bcaf9838ebf23771efe5e30f9c525af0e9b4", "parents": ["26ba7c9799892a9b243e2d935e2d8e833518ce46"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058314 - Pt 2 - WebRender: remove the legacy SWGL gradient-table path r=gfx-reviewers,nical\n\nps_quad_gradient only calls the ...FromStops... intrinsics, leaving the\nolder table-based cluster and its glsl-to-cxx declarations unreachable.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314504\n", "files": ["gfx/wr/glsl-to-cxx/src/hir.rs", "gfx/wr/swgl/src/swgl_ext.h"], "git_node": "6ce321489d5775723150fd4ab7afe0bdfd4b1c32", "git_parents": ["99f0969bff54d9e3f392344855f6b862ec8a586e"], "node": "a7504543c249caf420760c88da6e0d068592ba39", "parents": ["78d1bcaf9838ebf23771efe5e30f9c525af0e9b4"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058314 - Pt 3 - WebRender: make DISABLE_GRADIENT_PRIMS work again r=gfx-reviewers,nical\n\nshould_skip_batch lost its gradient arm when gradients moved to quads, so\nthe flag has been silently doing nothing. Matching on the pattern kind\nalso covers nine-patch borders and decomposed segment quads, and for\ncached gradients it suppresses the batch that fills the cache entry\nrather than the composite that samples it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314505\n", "files": ["gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "5cc96baf2d111725d7fc80de0749dc965dc2a869", "git_parents": ["6ce321489d5775723150fd4ab7afe0bdfd4b1c32"], "node": "aca3a7107def31fb71fd0b082fc63e0bc95d08cf", "parents": ["a7504543c249caf420760c88da6e0d068592ba39"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058314 - Pt 4 - WebRender: drop the unused is_software gradient pattern argument r=gfx-reviewers,nical\n\nRemoving it leaves PatternBuilderContext::fb_config with no readers, so\nthat goes too. Also refreshes the three gradient module docs, which still\ndescribed the cached-render-task path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314506\n", "files": ["gfx/wr/webrender/src/border_image.rs", "gfx/wr/webrender/src/pattern/gradient.rs", "gfx/wr/webrender/src/pattern/mod.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/prim_store/gradient/conic.rs", "gfx/wr/webrender/src/prim_store/gradient/linear.rs", "gfx/wr/webrender/src/prim_store/gradient/radial.rs", "gfx/wr/webrender/src/quad.rs"], "git_node": "b8fe6dff856c96b43eed11748dc5a283d3daa514", "git_parents": ["5cc96baf2d111725d7fc80de0749dc965dc2a869"], "node": "efb626352031d0e9e1e8e29c780670816e03c37c", "parents": ["aca3a7107def31fb71fd0b082fc63e0bc95d08cf"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058314 - Pt 5 - WebRender: drop the always-identity gradient pattern scale r=gfx-reviewers,nical\n\nIt compensated for cached gradients rendering into a reduced-size render\ntask; both call sites now pass one(). data0.zw becomes padding rather\nthan being reclaimed, as radial and conic need five floats either way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314507\n", "files": ["gfx/wr/webrender/res/ps_quad_gradient.glsl", "gfx/wr/webrender/src/pattern/gradient.rs", "gfx/wr/webrender/src/prim_store/gradient/conic.rs", "gfx/wr/webrender/src/prim_store/gradient/radial.rs"], "git_node": "56050f5c3438a07157d75ab5f1889b4ad3e90ecc", "git_parents": ["b8fe6dff856c96b43eed11748dc5a283d3daa514"], "node": "edf5b12b170be7619a714e064e5d44fa12e9d35e", "parents": ["efb626352031d0e9e1e8e29c780670816e03c37c"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2058419 - Part 1: Update to tzdata 2026c. r=spidermonkey-reviewers,dminor\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314595\n", "files": ["config/external/icu/data/icudt78l.dat", "intl/tzdata/GIT-INFO", "intl/tzdata/VERSION", "intl/tzdata/source/be/metaZones.res", "intl/tzdata/source/be/zoneinfo64.res", "intl/tzdata/source/ee/metaZones.res", "intl/tzdata/source/ee/zoneinfo64.res", "intl/tzdata/source/le/metaZones.res", "intl/tzdata/source/le/zoneinfo64.res", "intl/tzdata/source/metaZones.txt", "intl/tzdata/source/zoneinfo64.txt", "js/src/builtin/intl/TimeZoneDataGenerated.h", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_links.js", "js/src/tests/non262/Intl/DateTimeFormat/timeZone_version.js", "js/src/tests/non262/Intl/supportedValuesOf-timeZones-canonical.js", "js/src/tests/non262/Temporal/ZonedDateTime/zones-and-links.js"], "git_node": "1203898655291882a77170e5f0cc5f4f0a1e0cc4", "git_parents": ["56050f5c3438a07157d75ab5f1889b4ad3e90ecc"], "node": "b66ce88bda86167b1dff9f410b3e5908154afc27", "parents": ["edf5b12b170be7619a714e064e5d44fa12e9d35e"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2058419 - Part 2: Clobber for tzdata update. r=spidermonkey-reviewers,dminor\n\nWhen locally building in a fresh build, the updated icudata file wasn't correctly\nincluded for some reason. Only after deleting the sccache directory (~/.cache/sccache)\nthe new icudata file was correctly linked to the new build. A similar issue appears\nto be present for try-runs, because \"jsreftest\" builds fail the \"timeZone_version.js\"\ntest. (Browser only issue across different platforms, shell builds aren't affected.)\n\nLet's see if a clobber avoids this. (It didn't help for try-runs, though!)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314596\n", "files": ["CLOBBER"], "git_node": "427c2da10235796050828eef3324f776b9570f19", "git_parents": ["1203898655291882a77170e5f0cc5f4f0a1e0cc4"], "node": "2a3044d68490da91de5a7636140c1e77b4d9054d", "parents": ["b66ce88bda86167b1dff9f410b3e5908154afc27"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings mobile-experiments mobile-merino-manifest ct-logs - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314752\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "toolkit/components/certviewer/content/components/logNameTable.mjs"], "git_node": "79db9d1e6df3cdfed19da7c3df5cd736ac3c83b0", "git_parents": ["427c2da10235796050828eef3324f776b9570f19"], "node": "92c10bb0277ee05bde0ea22aa23f758065f4393a", "parents": ["2a3044d68490da91de5a7636140c1e77b4d9054d"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2042688 - Update perfdocs generator to read and emit Markdown r=perftest-reviewers,mozperftest-reviewers,dom-storage-reviewers,hsingh,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304248\n", "files": ["python/mozperftest/mozperftest/perfdocs/doc_helpers.py", "python/mozperftest/mozperftest/perfdocs/framework_gatherers.py", "python/mozperftest/mozperftest/perfdocs/gatherer.py", "python/mozperftest/mozperftest/perfdocs/generator.py", "python/mozperftest/mozperftest/perfdocs/templates/index.md", "python/mozperftest/mozperftest/perfdocs/templates/index.rst", "python/mozperftest/mozperftest/perfdocs/utils.py", "python/mozperftest/mozperftest/tests/conftest.py", "python/mozperftest/mozperftest/tests/test_perfdocs.py", "python/mozperftest/mozperftest/tests/test_perfdocs_framework_gatherers.py", "python/mozperftest/mozperftest/tests/test_perfdocs_generation.py", "python/mozperftest/mozperftest/tests/test_perfdocs_helpers.py"], "git_node": "aaf87b4c02ba9fab54ff0d59369e2fbea765b09f", "git_parents": ["79db9d1e6df3cdfed19da7c3df5cd736ac3c83b0"], "node": "b75537cdbb507ecd932e375ad8a535d07222f908", "parents": ["92c10bb0277ee05bde0ea22aa23f758065f4393a"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2042688 - Convert perfdocs content from RST to Markdown r=perftest-reviewers,mozperftest-reviewers,devtools-reviewers,dom-storage-reviewers,nchevobbe,jari,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309229\n", "files": ["devtools/perfdocs/index.md", "devtools/perfdocs/index.rst", "docs/performance/index.md", "dom/indexedDB/test/perfdocs/index.md", "dom/indexedDB/test/perfdocs/index.rst", "python/mozperftest/perfdocs/developing.md", "python/mozperftest/perfdocs/developing.rst", "python/mozperftest/perfdocs/index.md", "python/mozperftest/perfdocs/index.rst", "python/mozperftest/perfdocs/running.md", "python/mozperftest/perfdocs/running.rst", "python/mozperftest/perfdocs/tools.md", "python/mozperftest/perfdocs/tools.rst", "python/mozperftest/perfdocs/vision.md", "python/mozperftest/perfdocs/vision.rst", "python/mozperftest/perfdocs/writing.md", "python/mozperftest/perfdocs/writing.rst", "testing/awsy/perfdocs/index.md", "testing/awsy/perfdocs/index.rst", "testing/perfdocs/generated/DAMP.md", "testing/perfdocs/generated/DAMP.rst", "testing/perfdocs/generated/IndexedDB.md", "testing/perfdocs/generated/IndexedDB.rst", "testing/perfdocs/generated/adding-tests.md", "testing/perfdocs/generated/adding-tests.rst", "testing/perfdocs/generated/awsy.md", "testing/perfdocs/generated/awsy.rst", "testing/perfdocs/generated/browsertime.md", "testing/perfdocs/generated/browsertime.rst", "testing/perfdocs/generated/contributing.md", "testing/perfdocs/generated/contributing.rst", "testing/perfdocs/generated/debugging.md", "testing/perfdocs/generated/debugging.rst", "testing/perfdocs/generated/developing.md", "testing/perfdocs/generated/developing.rst", "testing/perfdocs/generated/index.md", "testing/perfdocs/generated/index.rst", "testing/perfdocs/generated/mach-try-perf.md", "testing/perfdocs/generated/mach-try-perf.rst", "testing/perfdocs/generated/mozperftest.md", "testing/perfdocs/generated/mozperftest.rst", "testing/perfdocs/generated/perf-sheriffing.md", "testing/perfdocs/generated/perf-sheriffing.rst", "testing/perfdocs/generated/perfcompare.md", "testing/perfdocs/generated/perfcompare.rst", "testing/perfdocs/generated/performance-infrastructure.md", "testing/perfdocs/generated/performance-infrastructure.rst", "testing/perfdocs/generated/perftest-in-a-nutshell.md", "testing/perfdocs/generated/perftest-in-a-nutshell.rst", "testing/perfdocs/generated/raptor-metrics.md", "testing/perfdocs/generated/raptor-metrics.rst", "testing/perfdocs/generated/raptor.md", "testing/perfdocs/generated/raptor.rst", "testing/perfdocs/generated/running.md", "testing/perfdocs/generated/running.rst", "testing/perfdocs/generated/standard-workflow.md", "testing/perfdocs/generated/standard-workflow.rst", "testing/perfdocs/generated/talos.md", "testing/perfdocs/generated/talos.rst", "testing/perfdocs/generated/telemetry-alerting.md", "testing/perfdocs/generated/telemetry-alerting.rst", "testing/perfdocs/generated/test-list.md", "testing/perfdocs/generated/test-list.rst", "testing/perfdocs/generated/tools.md", "testing/perfdocs/generated/tools.rst", "testing/perfdocs/gene