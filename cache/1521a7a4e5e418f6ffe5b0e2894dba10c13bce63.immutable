", "browser/components/urlbar/tests/browser-tabs/browser_action_tabgroups.js"], "git_node": "82257232606020078252e58f984c996c628d19f9", "git_parents": ["ea4f39b14323eb3a6852a1d27cde15af83e3a788"], "node": "bbb559c2333fdbaa320a68ae78ee38960bbf7447", "parents": ["e5736fe7b59b185f9c902718d3d8d4cde07f0dfc"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043189 - Part 3: Use different name for private engine field to prevent doc failure. r?#urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313723\n", "files": ["browser/components/urlbar/content/SearchEngineStore.mjs"], "git_node": "bdbbc116bd52682e6a25e9eaf677dcf415c258fa", "git_parents": ["82257232606020078252e58f984c996c628d19f9"], "node": "836612f290fa929587a4a10d8b79fa163407d4ea", "parents": ["bbb559c2333fdbaa320a68ae78ee38960bbf7447"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056246 - Hook up cbindgen to generate C headers for fontations_glue. r=AlaskanEmily,layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312106\n", "files": ["gfx/fontations_glue/moz.build", "gfx/moz.build"], "git_node": "9d48226560212def0160bdd2e2ea6163be2da4cc", "git_parents": ["bdbbc116bd52682e6a25e9eaf677dcf415c258fa"], "node": "d38dcdf8fda7e04509ce2244ddbd953f5c5ddb2b", "parents": ["836612f290fa929587a4a10d8b79fa163407d4ea"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056246 - Provide functions to create and delete skrifa font refs from C++ code. r=AlaskanEmily,layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312107\n", "files": ["gfx/fontations_glue/lib.rs", "gfx/fontations_glue/moz.build"], "git_node": "45fdde0446196a05bc3d2c6afc312ec22a6c9fec", "git_parents": ["9d48226560212def0160bdd2e2ea6163be2da4cc"], "node": "d2d478ed55cf991db723e2d335e018a4ec546637", "parents": ["d38dcdf8fda7e04509ce2244ddbd953f5c5ddb2b"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056248 - Provide a function to map unicode codepoint to glyph id. r=AlaskanEmily,layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312108\n", "files": ["gfx/fontations_glue/lib.rs"], "git_node": "5de2da5d817d65dd3eefe1e296724f4f683fc99c", "git_parents": ["45fdde0446196a05bc3d2c6afc312ec22a6c9fec"], "node": "c3965aeb53f6d65bfcb4d30a1c85cd5e90ece8d2", "parents": ["d2d478ed55cf991db723e2d335e018a4ec546637"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056251 - Add a type & function to retrieve font table data by tag. r=AlaskanEmily,layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312109\n", "files": ["gfx/fontations_glue/lib.rs"], "git_node": "650234db3d88ee4cfeb6ce2c2239876f02a7347b", "git_parents": ["5de2da5d817d65dd3eefe1e296724f4f683fc99c"], "node": "3644ad5d90dd3df73baebd88503e469d43f21391", "parents": ["c3965aeb53f6d65bfcb4d30a1c85cd5e90ece8d2"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056254 - Provide a function to retrieve names from Skrifa font refs. r=AlaskanEmily,layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312110\n", "files": ["Cargo.lock", "gfx/fontations_glue/Cargo.toml", "gfx/fontations_glue/lib.rs"], "git_node": "404ff3399dec0ed5d99d418bf18b29b95d8032c6", "git_parents": ["650234db3d88ee4cfeb6ce2c2239876f02a7347b"], "node": "bdd4ba02b52bec28e6e2033dd49a3fa379451c8a", "parents": ["3644ad5d90dd3df73baebd88503e469d43f21391"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055944 - Remove version 151 panel-list.js train-hop compatibility shim. r=reemhamz\n\npanel-list.js existed only to keep `panel-list` importable for train-hopping\nnewtab until panel-list.mjs reached the Release channel. Firefox 151 has long\nsince hit Release, so we can remove the shim and repoint all consumers at\npanel-list.mjs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312811\n", "files": ["browser/extensions/newtab/bin/render-activity-stream-html.js", "browser/extensions/newtab/data/content/abouthomecache/page.html.template", "browser/extensions/newtab/prerendered/activity-stream-debug.html", "browser/extensions/newtab/prerendered/activity-stream-noscripts.html", "browser/extensions/newtab/prerendered/activity-stream.html", "toolkit/content/jar.mn", "toolkit/content/widgets/panel-list/panel-list.js"], "git_node": "7b4fd7c3372b6d37a19419b0362744ee0b2529d5", "git_parents": ["404ff3399dec0ed5d99d418bf18b29b95d8032c6"], "node": "5d39918ecec8c0a7465d5fc96ec5917819f1a527", "parents": ["bdd4ba02b52bec28e6e2033dd49a3fa379451c8a"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055794 - Remove 'taskcluster-taskgraph' version check from pysites linter, r=taskgraph-reviewers,jcristau\n\nEnforcing we keep the versions synced adds unnecessary busy work and\nmeans we need to deal with bustage in other places (like the build\nsystem) more often than would otherwise be necessary.\n\nThe Decision task and build system are two separate unrelated code bases\nthat depend on `taskcluster-taskgraph` for different reasons. This\nscenario is no different than any other two dependencies listed under\n`python/sites`. We don't enforce compatibility between sites for\nanything else, so why should `taskcluster-taskgraph` be special?\n\nTo clarify, I do think it's good to keep dependencies up to date in\ngeneral. But if you're bumping Taskgraph to pick up a change in the\nDecision task, you should not be forced to also update the build systems\ndependencies. That is a separate task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312813\n", "files": ["tools/lint/python-sites.yml", "tools/lint/python-sites/__init__.py"], "git_node": "295be2ef45c4a3188b0c0c359aaf9874f4655419", "git_parents": ["7b4fd7c3372b6d37a19419b0362744ee0b2529d5"], "node": "230651b66c284017bce5dc81add6b1b8b1d1858d", "parents": ["5d39918ecec8c0a7465d5fc96ec5917819f1a527"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050592: Replace right titlebar-spacer with a flexible space r=Gijs\n\nFigma: https://www.figma.com/design/XT0eDYh4RtbMNWaYQi0efM/Chrome-Sidebar-UX-Specifications--Sprint-1-?node-id=3796-142219&p=f&m=dev\n\nTransform the right (pos-tabs) titlebar-spacer element into a flexible space element that can be removed/moved around by the user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310715\n", "files": ["browser/base/content/navigator-toolbox.inc.xhtml", "browser/components/customizableui/CustomizableUI.sys.mjs", "browser/components/customizableui/test/browser_1003588_no_specials_in_panel.js", "browser/components/customizableui/test/unit/test_titlebar_spacer_migration.js", "browser/components/customizableui/test/unit/test_unified_extensions_migration.js", "browser/components/customizableui/test/unit/xpcshell.toml", "browser/components/sidebar/tests/marionette/test_initialize_vertical_tabs.py"], "git_node": "ea0997116f1889b74a17dd3fb613482d65a4146c", "git_parents": ["295be2ef45c4a3188b0c0c359aaf9874f4655419"], "node": "74428e31e4b7e5ad77c1245195331dde00fec789", "parents": ["230651b66c284017bce5dc81add6b1b8b1d1858d"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056501: Allow detecting newer riscv64 extensions on older kernels. r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313476\n", "files": ["js/src/jit/riscv64/Architecture-riscv64.cpp"], "git_node": "7b67f3b9056632311ad8958d0b939796090987bf", "git_parents": ["ea0997116f1889b74a17dd3fb613482d65a4146c"], "node": "9cfe27ed79b53058421fd043e25049a24de498af", "parents": ["74428e31e4b7e5ad77c1245195331dde00fec789"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051401 - Change name of Le Chat Mistral to Mistral Vibe r=Mardak,fluent-reviewers,mkennedy,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312936\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/preferences/config/aiFeatures.mjs", "browser/locales/en-US/browser/genai.ftl", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "037176c9bde699c0dc42a5972a21b037a19e1c25", "git_parents": ["7b67f3b9056632311ad8958d0b939796090987bf"], "node": "c4ee2651afe69fce312ab884cb82d21d432d968f", "parents": ["9cfe27ed79b53058421fd043e25049a24de498af"], "tags": []}, {"author": "DrSeed Lu \u003cdr.seed.lu@gmail.com\u003e", "branch": "default", "desc": "Bug 2040752 - Add a context menu to the sidebar open tabs panel r=nsharpley,kcochrane,fluent-reviewers,bolsson\n\nAdds a context menu to the Open Tabs sidebar panel with Open in New\nWindow, Open in New Private Window, Copy Link, and Close Tab. The first\nthree reuse the shared sidebar context-menu handling in sidebar-page.mjs;\nClose Tab is handled in the panel and removes the tab via gBrowser.\n\nThe menu is wired to the panel through the existing contextMenuId\nmechanism, matching the history, synced tabs, and bookmarks panels.\nIt is shown for tab rows only. Only the Close Tab label is a new string.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313293\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/sidebar-page.mjs", "browser/components/sidebar/tests/browser/browser_opentabs_sidebar.js", "b