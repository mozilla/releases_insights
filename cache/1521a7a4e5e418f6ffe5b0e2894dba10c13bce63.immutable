28ba7ae2c88.\n\nRevert \"Bug 2054390 - Report shown/closed web notifications to chrome observers r=saschanaz\"\n\nThis reverts commit d134422f8930178825b22ef5872042361748f377.\n\nRevert \"Bug 2046947 - Vendor the double-checkmark icon from acorn-icons r=desktop-theme-reviewers,dao\"\n\nThis reverts commit c12f47b3dd4d4e2382705c5439a3046377a60989.\n", "files": ["browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/content-src/components/Base/Base.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/ContentSection/ContentSection.jsx", "browser/extensions/newtab/content-src/components/CustomizeMenu/CustomizeMenu.jsx", "browser/extensions/newtab/content-src/components/TopSiteWebNotification/TopSiteWebNotification.jsx", "browser/extensions/newtab/content-src/components/TopSiteWebNotification/_TopSiteWebNotification.scss", "browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardAd/CardAd.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/_CardWebNotifications.scss", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/TopSitesHoverCard.jsx", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/_TopSitesHoverCard.scss", "browser/extensions/newtab/content-src/components/TopSitesHoverCard/hover-card-content.jsx", "browser/extensions/newtab/content-src/lib/web-notification-icon.mjs", "browser/extensions/newtab/content-src/lib/web-notification-match.mjs", "browser/extensions/newtab/content-src/styles/activity-stream.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/WebNotificationsFeed.sys.mjs", "browser/extensions/newtab/test/unit/common/Reducers.test.js", "browser/extensions/newtab/test/unit/content-src/components/CustomizeMenu/ContentSection.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSiteWebNotification/TopSiteWebNotification.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSites.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSitesHoverCard/CardWebNotifications/CardWebNotifications.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/TopSitesHoverCard/TopSitesHoverCard.test.jsx", "browser/extensions/newtab/test/unit/content-src/lib/web-notification-icon.test.js", "browser/extensions/newtab/test/unit/content-src/lib/web-notification-match.test.js", "browser/extensions/newtab/test/unit/lib/WebNotificationsFeed.test.js", "browser/locales/en-US/browser/newtab/newtab.ftl", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/alerts/nsAlertsService.cpp", "toolkit/components/alerts/test/browser/browser.toml", "toolkit/components/alerts/test/browser/browser_alert_capture.js", "toolkit/components/alerts/test/browser/file_empty.html", "toolkit/themes/shared/desktop-jar.inc.mn", "toolkit/themes/shared/icons/double-checkmark.svg"], "git_node": "4d0c07332a5cb72e1cb70156991c7d14b2b9742e", "git_parents": ["f6011f9884d6173e6bfdac8ab84f093ff6ed0fbc"], "node": "de2456d71ca72fba21e59829be8dda4c36615306", "parents": ["1daf10c48fd2e3cc1ec315e32de9b5353bb06304"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060225 - Don't grow the crop rect beyond the rendered framebuffer in wrench png. r=gfx-reviewers,wsmind\n\nThe try_crop path in save() took its dimensions from the PNG already present\nat the output path. image::imageops::crop clamps its rect to the source\nbuffer, so when that existing image was larger than the framebuffer we just\nrendered, the cropped buffer kept the framebuffer size while width/height\ndescribed the larger one, and encode() rejected the mismatch.\n\nClamp the crop to the buffer so it can only ever shrink.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316009\n", "files": ["gfx/wr/wrench/src/png.rs"], "git_node": "23662f1492ea6e40a3db5576eb8d0e63ff077d32", "git_parents": ["4d0c07332a5cb72e1cb70156991c7d14b2b9742e"], "node": "59cd3fc7aaf5656155611b425d43653393223636", "parents": ["de2456d71ca72fba21e59829be8dda4c36615306"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060225 - Fix a shutdown race in wrench png. r=gfx-reviewers,wsmind\n\nThe png subcommand moved the NotifierEvent receiver into png(), so it was\ndropped as soon as png() returned, and then finished with renderer.deinit().\ndeinit() never talks to the render backend: that thread exits later, when the\nlast api_tx clone drops and api_rx.recv() fails, at which point it drains its\nwindows and calls notifier.shut_down() on a channel whose receiver is already\ngone, causing a panic.\n\nUse the same Wrench::shut_down(rx) handshake as reftest and rawtest, which\nkeeps the receiver alive until the backend has acknowledged shutdown. The\nsend then has a live receiver by construction rather than by timing.\n\nAlso stop unwrapping the notifier's sends. perf and test_invalidation hand\nthe receiver to a harness that owns it and likewise end with deinit(), so\nthey carry the same latent race, and a consumer that has gone away during\nteardown is not an error worth panicking over.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316010\n", "files": ["gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/png.rs"], "git_node": "492b636fc0e82d1a6217bfc08665e52cbdac4204", "git_parents": ["23662f1492ea6e40a3db5576eb8d0e63ff077d32"], "node": "1358702966bdce46c77bbf4d09b593613383512e", "parents": ["59cd3fc7aaf5656155611b425d43653393223636"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060225 - Shut the render backend down properly in the wrench perf and test_invalidation. r=gfx-reviewers,wsmind\n\nSame change as the previous commit for perf and test_invalidation tests instead of the png sub-command.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316011\n", "files": ["gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/perf.rs", "gfx/wr/wrench/src/test_invalidation.rs"], "git_node": "84d6fff3e2d5d093dfef1c8b17014052ff700666", "git_parents": ["492b636fc0e82d1a6217bfc08665e52cbdac4204"], "node": "d5eff2b030b2f9debe9893d038810501b44f420a", "parents": ["1358702966bdce46c77bbf4d09b593613383512e"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060397 - Use separate distance threshold for SmartWindow r=tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316128\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/SearchBrowsingHistory.sys.mjs", "browser/components/aiwindow/models/tests/xpcshell/test_SearchBrowsingHistory.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "42653666faab783a594762bee2d668a304156914", "git_parents": ["84d6fff3e2d5d093dfef1c8b17014052ff700666"], "node": "7e244e28de45c2ec915998bd81809d0b54602193", "parents": ["d5eff2b030b2f9debe9893d038810501b44f420a"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2057255 - [Monitor Agent][FE] Add Monitor agent telemetry r=yjamora,tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315716\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_monitor_agent.js", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/modules/AgentUI.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_tasks_actors.js"], "git_node": "46aef0e1aaf1d7cb8520dd6a0713fcbcebfbb46b", "git_parents": ["42653666faab783a594762bee2d668a304156914"], "node": "c78f8abb50b0b8a5c7cb118cbee449520bdf87e7", "parents": ["7e244e28de45c2ec915998bd81809d0b54602193"], "tags": []}, {"author": "Caleb Chan \u003ccachan@mozilla.com\u003e", "branch": "default", "desc": "Bug 1939851 - added a test to check 'Open all in tabs' from a bookmarks folder works correctly. r=places-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315318\n", "files": ["browser/components/places/tests/browser/browser.toml", "browser/components/places/tests/browser/browser_bookmark_open_all_in_tabs.js"], "git_node": "6d102b41c2a892b6baa124abccd4eafcc1c12430", "git_parents": ["46aef0e1aaf1d7cb8520dd6a0713fcbcebfbb46b"], "node": "00523a2b8c6f7fb11fef85518c77b27d1ff2efa5", "parents": ["c78f8abb50b0b8a5c7cb118cbee449520bdf87e7"], "tags": []}, {"author": "Kyle Jones \u003ckjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059095 - Use MAC in DiscoveryStreamFeed for fetching tiles from MARS r=mconley\n\nWhen AdsClient is enabled and set in DiscoveryStreamFeed,\nuse MAC to make calls to MARS instead of manual fetch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315126\n", "files": ["browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/test/unit/lib/DiscoveryStreamFeed.test.js"], "git_node": "626719301b5ab50a83424f9fa318b9d5cf2b9e0c", "git_parents": ["6d102b41c2a892b6baa124abccd4eafcc1c12430"], "node": "a3582732e1548e6d92f03203dccf9117ef73dfb8", "parents": ["00523a2b8c6f7fb11fef85518c77b27d1ff2efa5"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054126 - [remote] Allow to start remote agent and marionette dynamically r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314049\n", "files": ["remote/components/Marionette.sys.mjs", "remote/components/RemoteAgent.sys.mjs"], "git_node": "719ee39bcf7b7b687bf1a8e7359ac3faa225241b", "git_parents": ["626719301b5ab50a83424f9fa318b9d5cf2b9e0c"], "node": "c77d52ed0596ef0ddceaeee39a311712f577ed07", "parents": ["a3582732e1548e6d92f03203dccf9117ef73dfb8"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054126 - [remote] Add a preference to disable RemoteAgent/Marionette startAtRuntime r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314051\n", "files": ["modules/libpref/init/all.js", "remote/components/Marionette.sys.mjs", "remote/components/RemoteAgent.sys.mjs"], "git_node": "13564671daa71fcace43c47fecf2d372dbdce546", "git_parents": ["719ee39bcf7b7b687bf1a8e7359ac3faa225241b"], "node": "7e45e8c6a5463799c6ac2502690876e6e82550d8", "parents": ["c77d52ed0596ef0ddceaeee39a311712f577ed07"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059794 - Use native scrolling in vertical arrowscrollboxes. r=tabbrowser-reviewers,hiro,kcochrane\n\nThe widget already delegates the actual scrolling to the platform (scrollBy,\nscrollIntoView, scroll-behavior), but it intercepts every wheel and touchmove\nevent and drives the offset from script, so the tab strip and menus get neither\nAPZ momentum nor the OS wheel settings.\n\nVertical mode is the part we can hand over today: give the scrollbox a real\noverflow so it becomes a scroll container, and stop listening for input there.\nHorizontal mode still needs platform work -- the mousewheel autodir opt-in only\ntakes effect on the APZ path, and APZ doesn't autodir pan gestures at all -- so\nit keeps scrolling from script.\n\nWorth checking:\n\n- Vertical mode registers no wheel or touch listeners at all, rather than\n  ignoring the events, because an APZ-aware listener would make APZ wait for the\n  main thread before it can scroll. That is also why the tabs' own wheel-type\n  listeners are registered only while toolkit.tabbox.switchByScrolling is\n  enabled, and why a popup's hit test stops reporting APZ_AWARE_LISTENERS.\n\n- The scrollbox only becomes a scroll container while [overflowing]. That keeps\n  the widget's \"don't consume the event if we can't scroll\" semantics, and keeps\n  every menu that fits on screen from getting an APZ scroll frame.\n\n- The scrollbar and the overscroll effect are both off by default, so menus keep\n  their current look and feel. The vertical tab strip opts into both: there the\n  overscroll is the feedback for reaching the end of a wheel or touch scroll, and\n  it uses contain so it doesn't chain to an ancestor.\n\n- A wheel notch now scrolls the OS line count times the font line height, not a\n  whole tab row, and the platform caps one event at one page. That is the point\n  of the bug, but it does make wheel scrolling finer; the two tests that asserted\n  the old script-computed distances are updated accordingly. Item-boundary\n  alignment survives on the paths that are still script-driven: the scroll arrows\n  and keyboard paging.\n\n- Switching tabs by scrolling relied on the widget consuming the wheel event.\n  Preventing the legacy scroll event's default action propagates back to the\n  wheel event it came from, which is what keeps the tabs from scrolling as well\n  as switching.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315665\n", "files": ["browser/components/tabbrowser/content/tabs.js", "browser/components/tabbrowser/test/browser/tabs/browser_scroll_size_determination.js", "browser/themes/shared/tabbrowser/tabs.css", "gfx/layers/apz/test/mochitest/browser_test_popup_menu_in_position_fixed.js", "toolkit/content/tests/chrome/test_mousescroll.xhtml", "toolkit/content/widgets/arrowscrollbox.js", "toolkit/content/widgets/tabbox.js", "toolkit/themes/shared/arrowscrollbox.css"], "git_node": "ed3204e22fce1841d46c56c4e392f7ceedd18536", "git_parents": ["13564671daa71fcace43c47fecf2d372dbdce546"], "node": "ddc26dcdaa5cd9d326b20c404959143e5a44b7f4", "parents": ["7e45e8c6a5463799c6ac2502690876e6e82550d8"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2042994 - Parse and serialize -webkit-line-clamp as a legacy shorthand for line-clamp. r=AlaskanEmily,dshin,firefox-style-system-reviewers,emilio\" for causing wr tests failures at line-clamp-019.html\n\nThis reverts commit 755cab013ee26b12b0e760127be8443ef6422cda.\n", "files": ["devtools/server/actors/animation-type-longhand.js", "layout/style/nsStyleStruct.cpp", "layout/style/test/property_database.js", "layout/style/test/test_all_shorthand.html", "layout/style/test/test_ch_ex_no_infloops.html", "layout/style/test/test_inherit_computation.html", "layout/style/test/test_inherit_storage.html", "layout/style/test/test_initial_computation.html", "layout/style/test/test_initial_storage.html", "layout/style/test/test_property_database.html", "layout/style/test/test_transitions_per_property.html", "layout/style/test/test_value_computation.html", "layout/style/test/test_value_storage.html", "servo/components/style/properties/data.py", "servo/components/style/properties/declaration_block.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/properties/mod.rs", "servo/components/style/properties/properties.mako.rs", "servo/components/style/properties/shorthands.rs", "servo/components/style/properties/shorthands.toml", "servo/components/style/style_adjuster.rs", "servo/components/style/values/generics/box.rs", "servo/components/style/values/specified/box.rs", "servo/ports/geckolib/glue.rs"], "git_node": "969fe1a3754339445bd6f78ed3c61c64890c89c5", "git_parents": ["ed3204e22fce1841d46c56c4e392f7ceedd18536"], "node": "0cac14d4d539f32a53bcf910c7347df70f7a5497", "parents": ["ddc26dc