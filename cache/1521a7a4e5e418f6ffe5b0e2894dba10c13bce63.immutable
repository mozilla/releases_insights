webrtc/video/timing/simulator/BUILD.gn", "third_party/libwebrtc/video/timing/simulator/rendering_simulator.cc", "third_party/libwebrtc/video/timing/simulator/rendering_simulator.h"], "git_node": "2f3aa59343b0cdcf806048410c71c0842fc4b1bd", "git_parents": ["05fc90c2c3aa3a110653060f30ef0e70fdd28681"], "node": "1e0cd5a09d72cfcd9db94655e94c3c11fa32b8bb", "parents": ["8277f8549232db6d67d4815f5dd72a89fdb5c7e4"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 1a781c66b5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1a781c66b59abf9d34d242700ff25c057c4dda5d\n    Add todo guide for outlawing SDP munging\n\n    Create g3doc/todo/sdp-munging.md containing the roadmap, rollout\n    strategy, and task list for deprecating and removing local SDP\n    munging support in WebRTC.\n\n    Bug: webrtc:414284082\n    Change-Id: Ib995b03493af6bd85111f6ffb91cc3176c355547\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/483660\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48087}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/g3doc/todo/sdp-munging.md"], "git_node": "eb9490b67010753aca3840bf7590305e23f325d5", "git_parents": ["2f3aa59343b0cdcf806048410c71c0842fc4b1bd"], "node": "6be4c50a7f1285e3dc3a075c60a84d3a5a27ccb7", "parents": ["1e0cd5a09d72cfcd9db94655e94c3c11fa32b8bb"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from 5e2e39c5c4\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5e2e39c5c4f079fe43c39d91afd0e0856c8dce6e\n    Remove deprecated methods from StunMessage\n\n    Removes deprecated methods and constants from StunMessage,\n    StunByteStringAttribute, and global scope in stun.h/cc.\n    These have been replaced by std::span and absl::string_view\n    overloads and are no longer used in WebRTC.\n\n    Bug: webrtc:42224821\n    Change-Id: I7fa7dd7f5106f8e14af18cc80a69d78c03d4e5ce\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/484920\n    Auto-Submit: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48088}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/transport/stun.cc", "third_party/libwebrtc/api/transport/stun.h"], "git_node": "28f2737cc503eba6473f4fa5e316f78d5e678465", "git_parents": ["eb9490b67010753aca3840bf7590305e23f325d5"], "node": "e2460f4ac2368c3466d1437d95be9fb922269d80", "parents": ["6be4c50a7f1285e3dc3a075c60a84d3a5a27ccb7"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from d3f8fc54e1\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d3f8fc54e1dcb2cc69b433b437711c7788484eb6\n    Update WebRTC code version (2026-06-26T04:04:46).\n\n    Bug: None\n    Change-Id: I2bcae64cad3cbf48888b3b8bed6be05b24f330f1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485660\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48089}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "690e54d50b909c8646a33a14e2ad90306d318706", "git_parents": ["28f2737cc503eba6473f4fa5e316f78d5e678465"], "node": "1fa7e4f0a2ae7273c1a5353f1547b85023292ea0", "parents": ["e2460f4ac2368c3466d1437d95be9fb922269d80"], "tags": []}, {"author": "Michael Froman \u003cmfroman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049872 - Vendor libwebrtc from bf3d5a88cf\n\nUpstream commit: https://webrtc.googlesource.com/src/+/bf3d5a88cf35c87c7e33e3845312ab51d254ea45\n    Update network route on SRTP activation\n\n    When an ICE transport connects initially, OnNetworkRouteChanged is\n    called before SRTP is active. Previously, when SRTP activated later,\n    the network route overhead was never updated. However, if ICE\n    candidates switched mid-call after SRTP activation, SRTP overhead was\n    included, causing inconsistent packet overhead reporting.\n\n    Behind the field trial WebRTC-UpdateNetworkRouteOnSrtpActivation\n    (disabled by default):\n    - SrtpTransport caches the current SRTP overhead and updates the\n      network route whenever the overhead changes.\n    - RtpTransport routes packet transport changes through virtual\n      OnNetworkRouteChanged so subclasses can append SRTP overhead before\n      notifying subscribers.\n    - RtpTransportControllerSend updates per-packet transport overhead\n      whenever the network route overhead changes.\n\n    Bug: webrtc:461532446\n    Change-Id: I44d3c6a99fc45fd192e45ce3e1fa64f32832cbb7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/485240\n    Reviewed-by: Harald Alvestrand \u003chta@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48090}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_transport_controller_send.cc", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/moz-patch-stack/s0123.patch", "third_party/libwebrtc/pc/rtp_transport.cc", "third_party/libwebrtc/pc/rtp_transport.h", "third_party/libwebrtc/pc/srtp_transport.cc", "third_party/libwebrtc/pc/srtp_transpo