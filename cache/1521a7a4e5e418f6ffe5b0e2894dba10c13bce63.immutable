6fb72dd6a7f9\nxh -\u003e 15168854110d36b2249f60a954876fb72dd6a7f9\nzam -\u003e 15168854110d36b2249f60a954876fb72dd6a7f9\nzh-CN -\u003e 15168854110d36b2249f60a954876fb72dd6a7f9\nzh-TW -\u003e 15168854110d36b2249f60a954876fb72dd6a7f9\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "1eee07cab47ed7e052aadb64b37196d948959647", "git_parents": ["12ca0d3e1cfabe1d754a49794fc153861f5bbc57"], "node": "5fc699113a162e49ac1799bfdd33644a4e89c9c9", "parents": ["11be772a6ba62ee576d36049baa8694d01b27cc5"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2033123, Bug 2035575 - Make `./mach uniffi generate` generate Android Kotlin sources r=nalexander\" at dev request.\n\nThis reverts commit d6f35f2932b0d4b1976a86cb8945ea971a6c672c.\n\nRevert \"Bug 2033123 - Gate megazord behind `uniffi-target` on non-Android r=nalexander\"\n\nThis reverts commit cfd563e17a59b299ed5d5a836f0eae401101e599.\n\nRevert \"Bug 2033123 - Make `./mach uniffi generate` use `uniffi-target` to build binaries and libraries r=nalexander,firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit 6ede1c85793f678b41a393aefe6a5cda6bd33ac7.\n\nRevert \"Bug 2033123 - Make `uniffi-target` build `embedded-uniffi-bindgen` and the megazord r=nalexander,firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit 6cf3aebd6e7a87f38ae6ab3dcfb64b5bb677d11a.\n\nRevert \"Bug 2033123 - Add `uniffi-target` encapsulating build steps for `./mach uniffi generate` r=nalexander,firefox-build-system-reviewers\"\n\nThis reverts commit 67c91dd6639b0384cafd8a7683b1c488b2e77513.\n\nRevert \"Bug 2033123 - Wire `mozbuild-rustlib` through application-services NSS link chain r=nalexander,firefox-build-system-reviewers,sergesanspaille\"\n\nThis reverts commit d1f9d2e19f5e549c678c513e1990dd90dc56b862.\n\nRevert \"Bug 2035575 - Point the Android `glean-build` at the `glean_parser` venv r=nalexander,firefox-build-system-reviewers,geckoview-reviewers\"\n\nThis reverts commit 87a9fad7336c88f0f18d78547c55bf22713633fb.\n", "files": ["Cargo.lock", "build/pure_virtual/moz.build", "build/rust/mozbuild/generate_buildconfig.py", "build/rust/mozbuild/lib.rs", "build/workspace-hack/Cargo.toml", "config/makefiles/rust.mk", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/controller/clobber.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/frontend/gyp_reader.py", "python/mozbuild/mozbuild/generated_sources.py", "python/mozbuild/mozbuild/nss_libs.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/shared-library-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/shared-library-output-category/with-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/shared-library-output-category/without-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "python/mozbuild/mozbuild/util.py", "security/moz.build", "services/app-services-tools/embedded-uniffi-bindgen/moz.build", "services/moz.build", "third_party/application-services/megazords/fenix-dylib/moz.build", "third_party/application-services/megazords/full/moz.build", "toolkit/components/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py", "toolkit/components/uniffi-bindgen-gecko-js/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/test-fixtures/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/test-fixtures/moz.build", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "eaea33577f29d4537ee2f20810aaa9bd1c4f025f", "git_parents": ["1eee07cab47ed7e052aadb64b37196d948959647"], "node": "0fa4c4931a2d86051738510b669d7136b15f7e89", "parents": ["5fc699113a162e49ac1799bfdd33644a4e89c9c9"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2023722 - skill: document mozcheck Rust linter in mozlint SKILL.md r=ai4dev-reviewers,suhaib DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298043\n", "files": [".agents/skills/mozlint/SKILL.md", ".claude/skills/mozlint/SKILL.md"], "git_node": "f7652a666b99664ea28bcd3ec8bd180f661bbe00", "git_parents": ["eaea33577f29d4537ee2f20810aaa9bd1c4f025f"], "node": "7a28cd5b4162c56968fc75b664aad660b5cb3592", "parents": ["0fa4c4931a2d86051738510b669d7136b15f7e89"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054673. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312206\n", "files": ["gfx/layers/wr/WebRenderBridgeParent.cpp", "gfx/layers/wr/WebRenderBridgeParent.h"], "git_node": "953e4e483f8a3abcb4eb1788b7b773a4a0570616", "git_parents": ["f7652a666b99664ea28bcd3ec8bd180f661bbe00"], "node": "ab000498b026d2591c94180494e2c8056a381fe9", "parents": ["7a28cd5b4162c56968fc75b664aad660b5cb3592"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058934 - Run wrench on the Pixel 6 in the webrender presets. r=wsmind\n\nThe wrench tasks on Android hardware are hidden from the default try task\nset (android-hw is in UNCOMMON_TRY_TASK_LABELS), so both presets disable the\ntarget task filter. For the webrender preset the extra labels this exposes\n(ccov, mingwclang, wpt backlog and android-hw reftests) are filtered out so\nthat the only addition is webrender-android-hw-p6-opt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314962\n", "files": ["tools/tryselect/try_presets.yml"], "git_node": "3fee579bb9a8e09d27705056523832934b1c65b2", "git_parents": ["953e4e483f8a3abcb4eb1788b7b773a4a0570616"], "node": "02a12c42108e5e6e68313bf518d7dda870863b0a", "parents": ["ab000498b026d2591c94180494e2c8056a381fe9"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054842. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312213\n", "files": ["gfx/thebes/CoreTextFontList.cpp", "gfx/thebes/gfxDWriteFontList.cpp", "gfx/thebes/gfxFT2FontList.cpp"], "git_node": "abd107bf6390f3fc60b4de34cf84639cae3836ce", "git_parents": ["3fee579bb9a8e09d27705056523832934b1c65b2"], "node": "e5cfdf7ad0174181ad734899167fdc42f8dc60f9", "parents": ["02a12c42108e5e6e68313bf518d7dda870863b0a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057470 - Add a debug option for initializing renderable textures with opaque pink. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313977\n", "files": ["gfx/thebes/gfxPlatform.cpp", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/wrshell/src/gui/debug_flags.rs", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "b5e1fc1726f971ced2aca92ff7793ecc5fb2f58c", "git_parents": ["abd107bf6390f3fc60b4de34cf84639cae3836ce"], "node": "8da689318c1816a52a8e61b87f0dd08a04f59404", "parents": ["e5cfdf7ad0174181ad734899167fdc42f8dc60f9"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057470 - Enable the render target init debugging flag for wrench reftest. r=gfx-reviewers,gw\n\nAlso add an option to enable it for other sub-commands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313978\n", "files": ["gfx/wr/wrench/reftests/transforms/reftest.list", "gfx/wr/wrench/src/args.yaml", "gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "1d3d675760966628ffbfe0f7fa12aa3a041aabf3", "git_parents": ["b5e1fc1726f971ced2aca92ff7793ecc5fb2f58c"], "node": "cf50b2cddad16bcf86235a91777ecf7d69e48f52", "parents": ["8da689318c1816a52a8e61b87f0dd08a04f59404"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Point the Android `glean-build` at the `glean_parser` venv r=nalexander,firefox-build-system-reviewers,geckoview-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313320\n", "files": ["config/makefiles/rust.mk"], "git_node": "b4005d0833ddf6b0045102e92bc500fc0c6f3438", "git_parents": ["1d3d675760966628ffbfe0f7fa12aa3a041aabf3"], "node": "326d8f50bf7240b0e008015de951232a072a5c04", "parents": ["cf50b2cddad16bcf86235a91777ecf7d69e48f52"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Wire `mozbuild-rustlib` through application-services NSS link chain r=nalexander,firefox-build-system-reviewers,sergesanspaille\n\nThe `mozbuild` crate now exposes `link_nss` and `link_nss_rustlib` so that\n`application-services` build scripts can link NSS from the objdir. `link_nss`\nemits cargo directives for the NSS shared libraries in `dist/bin`, and\n`link_nss_rustlib` adds static `mozpkix` and `pure_virtual` on top.\n\nFor those directives to resolve, the libraries they name have to be in\n`dist/lib`, and some of them were not installed there before. `mozpkix` is a\ngyp `static_library`, so a new `install_static_libs` option on `GYP_DIRS`\nmarks it for installation to `dist/lib` without forcing `DIST_INSTALL` on\nevery target in the gyp directory. `pure_virtual` gets `DIST_INSTALL`\ndirectly. On Windows the shared library import libs are installed to\n`dist/lib` too, so the dylib directives can find them at link time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306609\n", "files": ["build/pure_virtual/moz.build", "build/rust/mozbuild/generate_buildconfig.py", "build/rust/mozbuild/lib.rs", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/gyp_reader.py", "python/mozbuild/mozbuild/nss_libs.py", "security/moz.build"], "git_node": "d9483ce76e40d1803dc8b8fe9e03ab1a11222358", "git_parents": ["b4005d0833ddf6b0045102e92bc500fc0c6f3438"], "node": "2ea70df63e7840d846f7112dae2082305bd087ff", "parents": ["326d8f50bf7240b0e008015de951232a072a5c04"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Add `uniffi-target` encapsulating build steps for `./mach uniffi generate` r=nalexander,firefox-build-system-reviewers\n\n`./mach uniffi generate` needs three artifacts that don't belong in the\ndefault build: the host bindgen tool, gkrust-uniffi-components, and the\nbindings test fixtures. This groups them under a new `uniffi-target`\noutput category so they only build when uniffi generation runs. Libxul\nstill pulls gkrust-uniffi-components via its Cargo path dep, activating\njust the `mozbuild` feature so the in-tree NSS link works.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292598\n", "files": ["Cargo.lock", "build/workspace-hack/Cargo.toml", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/frontend/test_emitter.py", "toolkit/components/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/test-fixtures/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/test-fixtures/moz.build", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "8c6251d73ac8f94283bc202a3f813491191ef148", "git_parents": ["d9483ce76e40d1803dc8b8fe9e03ab1a11222358"], "node": "e43f0bb6c70843d1c0adc9bfd6cb004a4c03359a", "parents": ["2ea70df63e7840d846f7112dae2082305bd087ff"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Make `uniffi-target` build `embedded-uniffi-bindgen` and the megazord r=nalexander,firefox-build-system-reviewers,sergesanspaille\n\nThe `embedded-uniffi-bindgen` dependency is obvious.  What's less\nobvious is that the `USE_LIBS` stanza arranges the full `megazord-so`\ndylib to be built by `uniffi-target`.\n\nTwo small supporting build-system changes make that work: the emitter\naccepts Rust libraries with shared `USE_LIBS` (cargo handles actual\nlinking), and category tiers now depend on their members' shared\n`USE_LIBS` so recursing the tier triggers those shared libs' builds.\n\nThis is all in support of `./mach uniffi generate`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292616\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/shared-library-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/shared-library-output-category/with-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/data/shared-library-output-category/without-output-category/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "services/app-services-tools/embedded-uniffi-bindgen/moz.build", "services/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/components/moz.build"], "git_node": "84e78c862c8be1a5dee8d3cc851bc933f8044c24", "git_parents": ["8c6251d73ac8f94283bc202a3f813491191ef148"], "node": "12500a8a53e1baa4f8dd08b22962abf967ef4004", "parents": ["e43f0bb6c70843d1c0adc9bfd6cb004a4c03359a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Make `./mach uniffi generate` use `uniffi-target` to build binaries and libraries r=nalexander,firefox-build-system-reviewers,sergesanspaille\n\n`./mach uniffi generate` now drives a dedicated `obj-uniffi-generate`\nbuild through `recurse_uniffi-target` instead of invoking Cargo directly.\nThis routes through mozbuild for proper dependency ordering (NSS, mozglue,\netc.) and keeps the user's main objdir untouched.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292617\n", "files": ["python/mozbuild/mozbuild/controller/clobber.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/generated_sources.py", "python/mozbuild/mozbuild/util.py", "toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py"], "git_node": "ae71e00778172793cd24b2578ddb080f3293a86f", "git_parents": ["84e78c862c8be1a5dee8d3cc851bc933f8044c24"], "node": "8cec3099c7476f5cd95cf5fd20bcbb138a0e4b2c", "parents": ["12500a8a53e1baa4f8dd08b22962abf967ef4004"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Gate megazord behind `uniffi-target` on non-Android r=nalexander\n\nOn Android, the megazord cdylib ships in the AAR and must always be\nbuilt. On non-Android, it's only needed by `./mach uniffi generate`\n(and indirectly by desktop libsForTests), so move both\n`RustLibrary(\"megazord\")` and `SharedLibrary(\"megazord-so\")` under the\n`uniffi-target` output category there.\n\niOS needs CoreFoundation linked just like macOS does, so the megazord\ndylib keys the framework on `OS_TARGET == \"Darwin\"` to cover both.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298757\n", "files": ["third_party/application-services/megazords/fenix-dylib/moz.build", "third_party/application-services/megazords/full/moz.build"], "git_node": "3264de04e2d5c1262438e9571e842a2e483b711e", "git_parents": ["ae71e00778172793cd24b2578ddb080f3293a86f"], "node": "684ff79f3f7e5e8254df8664235c2acf626a6634", "parents": ["8cec3099c7476f5cd95cf5fd20bcbb138a0e4b2c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033123 - Make `./mach uniffi generate` generate Android Kotlin sources r=nalexander\n\n`./mach uniffi generate` now also produces the Kotlin bindings for\nAndroid, which get committed to the source tree for gradle to consume.\nOn Windows, the cdylib doesn't preserve Rust `pub static` items through\nthe MSVC link, so `embedded-uniffi-bindgen` reads the megazord staticlib\ndirectly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292618\n", "files": ["toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py"], "git_node": "72bf5b9c6280c83ec9fadd21167faf6bdb11a3de", "git_parents": ["3264de04e2d5c1262438e9571e842a2e483b711e"], "node": "cb72e5b8dcc34bb319b2482282eb0956eff8127e", "parents": ["684ff79f3f7e5e8254df8664235c2acf626a6634"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059078 - Make ./mach ide vscodium not open VS Code r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315054\n", "files": ["python/mozbuild/mozbuild/backend/clangd.py", "python/mozbuild/mozbuild/test/backend/test_ide.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "450c5efc4e8379d52dfc0cfbaed594ecb64d2652", "git_parents": ["72bf5b9c6280c83ec9fadd21167faf6bdb11a3de"], "node": "5d1f8281f31c23c3ae8743901d31d51a7bc4e23b", "parents": ["cb72e5b8dcc34bb319b2482282eb0956eff8127e"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055754 - Container: better centered icons, r=sfoster,desktop-theme-reviewers,fxview-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312648\n", "files": ["browser/components/contextualidentity/content/usercontext.css", "browser/components/firefoxview/opentabs-tab-row.css", "browser/components/sidebar/sidebar-tab-row.css", "browser/themes/shared/preferences/preferences.css"], "git_node": "242231e9cf83065a3e91391a7c51a31031ac54c9", "git_parents": ["450c5efc4e8379d52dfc0cfbaed594ecb64d2652"], "node": "93c67091a23102e08e6af420e3627007356736a2", "parents": ["5d1f8281f31c23c3ae8743901d31d51a7bc4e23b"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 1: Fix handling of budget expiry during main thread only marking r=sfink\n\nCurrently we don't take account of the fact that we may run out of budget doing\nmain-thread-only marking at the start of a marking slice and return Finished\nwhen we're not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310035\n", "files": ["js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp"], "git_node": "c2ea88d68c1012b04fad3f596e0131ebd54e28e1", "git_parents": ["242231e9cf83065a3e91391a7c51a31031ac54c9"], "node": "786055f703512cb6c61bbae901686ebcb1bc9eac", "parents": ["93c67091a23102e08e6af420e3627007356736a2"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 2: Don't mark concurrently if no work for it to do r=sfink\n\nTighten up checks when budgeting concurrent marking and add a couple of asserts\nabout marker state to make it clearer what's happening.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310036\n", "files": ["js/src/gc/GC.cpp"], "git_node": "bb9dc19ebdfbb73a8324712b0022c9944050d5af", "git_parents": ["c2ea88d68c1012b04fad3f596e0131ebd54e28e1"], "node": "791a7f6ce13049c310487eacf3d23a18380e1989", "parents": ["786055f703512cb6c61bbae901686ebcb1bc9eac"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 3: Set idle flag in budget on creation r=sfink\n\nThis sets the idle flag in the slice budget depending on whether we are in idle\ntime. This can be used by the GC for scheduling purposes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310039\n", "files": ["dom/base/nsJSEnvironment.cpp"], "git_node": "f9e1e71bc86276d311f5e3af8e548f72d8fa9e88", "git_parents": ["bb9dc19ebdfbb73a8324712b0022c9944050d5af"], "node": "e9311c9fad62d7e9c6072f8112c3669fd7ab6214", "parents": ["791a7f6ce13049c310487eacf3d23a18380e1989"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 4: Remove SliceBudget APIs that deal in an integer number of milliseconds r=sfink\n\nIt's clearer to just use TimeDuration to set the time budget and we already\nhave APIs for this.\n\nI had to increase a test tolerance in TestScheduler.NonIdle because the more\naccurate value now return wasn't close enough to the expected value.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313435\n", "files": ["dom/base/CCGCScheduler.cpp", "dom/base/test/gtest/TestScheduler.cpp", "js/public/SliceBudget.h", "js/src/gc/GC.cpp", "js/src/gc/Statistics.cpp", "js/src/jsapi-tests/testGCFinalizeCallback.cpp", "js/src/jsapi-tests/testGCGrayMarking.cpp", "js/src/jsapi-tests/testGCHeapBarriers.cpp", "js/src/jsapi-tests/testMemoryAssociation.cpp", "js/src/jsapi-tests/testSliceBudget.cpp", "js/xpconnect/src/XPCJSRuntime.cpp"], "git_node": "93cd685586523c889f12bda6a64d86e029026bd5", "git_parents": ["f9e1e71bc86276d311f5e3af8e548f72d8fa9e88"], "node": "9ab59e378799df00a2e4e41df13bfba26f54cb06", "parents": ["e9311c9fad62d7e9c6072f8112c3669fd7ab6214"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 5: Update slice budget at end of slice to record whether it was interrupted r=sfink\n\nCurrently we record the budget at the beginning of the slice, but this doesn't\nshow whether the slice was interrupted later. This means that this information\nis not displayed in the profiler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313436\n", "files": ["js/public/SliceBudget.h", "js/src/gc/Statistics.cpp", "js/src/gc/Statistics.h"], "git_node": "e5de6df4ddc74027353e11c72585fa50449dd401", "git_parents": ["93cd685586523c889f12bda6a64d86e029026bd5"], "node": "b69d8e802901f3db0e011cdffda4dd35cd77212b", "parents": ["9ab59e378799df00a2e4e41df13bfba26f54cb06"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 6: Tweak heuristic to do more marking on the main thread if we've ever finished concurrent marking on the background thread r=sfink\n\nThe aim here is to reducing bouncing between the main thread and the background\nthread by performing a small amount of marking work on the main thread if we\nthink we're nearly finished. If we do this too much we reduce the benefit of\nconcurrent marking but if we do this to little we can make GCs take much longer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313437\n", "files": ["js/src/gc/GC.cpp"], "git_node": "4f3ba93fec1f2532b0906ea1e2a6e3adccec7640", "git_parents": ["e5de6df4ddc74027353e11c72585fa50449dd401"], "node": "b6016c235c5552b2404ee059a7d33052af146bb3", "parents": ["b69d8e802901f3db0e011cdffda4dd35cd77212b"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 7: Try to do less work from unscheduled slices r=sfink\n\nThis uses the budget's idle flag to yield eagerly rather that starting sweeping\nafter marking has finished for internally triggered slices not running in idle\ntime. This avoids transitioning from marking to sweeping (which in not\ninterruptible) in an unscheduled slice.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313438\n", "files": ["js/public/SliceBudget.h", "js/src/gc/GC.cpp", "js/src/gc/GCRuntime.h", "js/src/gc/Sweeping.cpp"], "git_node": "f8dcf41239042da74a9759c7b8ce1a32af03f03f", "git_parents": ["4f3ba93fec1f2532b0906ea1e2a6e3adccec7640"], "node": "ca14a85a06594d55c0747cf5c59b7641757f8d9e", "parents": ["b6016c235c5552b2404ee059a7d33052af146bb3"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051882 - Part 8: Don't yield after marking if we're marking concurrently r=sfink\n\nThis removes the yield at the end of marking if we're using concurrent marking\nas we will already yield before sweeping due to the previous patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313439\n", "files": ["js/src/gc/GC.cpp", "js/src/jit-test/tests/gc/incremental-state.js"], "git_node": "20f854cc264c7324c76bc2edec7f6de5dfc913ec", "git_parents": ["f8dcf41239042da74a9759c7b8ce1a32af03f03f"], "node": "130f0e56ea9bb8964b270ad3fe7458b952bf6915", "parents": ["ca14a85a06594d55c0747cf5c59b7641757f8d9e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035579 - Resolve NSS dependencies for app-services cargo test r=nalexander,firefox-build-system-reviewers\n\napp-services rust tests (logins, megazord, rc_crypto) need NSS at link\ntime and at run time. Turn on the `mozbuild-rustlib` feature for the\nmegazord and the tests so Cargo links NSS from the objdir, and have the\nrecursivemake backend turn a Rust library's `USE_LIBS` into build ordering\ndependencies via a shared `_add_rust_build_order_deps` (Cargo still does\nthe linking).\n\nThe `USE_LIBS` in `megazords/full/moz.build` then order NSS (including the\ndynamically loaded `freebl3` and `softokn3`) and the static `mozpkix` and\n`pure_virtual` ahead of the tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D292615\n", "files": ["python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/emitter.py", "third_party/application-services/megazords/full/moz.build"], "git_node": "83fa14a8ccfe32f636199ea2248ce2baf224e13f", "git_parents": ["20f854cc264c7324c76bc2edec7f6de5dfc913ec"], "node": "93cf11af44520d77d815bd9aafeefbdab683a8c8", "parents": ["130f0e56ea9bb8964b270ad3fe7458b952bf6915"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1955142 - Make `nsFrameSelection::MoveCaret` should do nothing if the anchor-focus range is outside the limiters r=jjaschke\n\nCurrently, browsers allow the selection range to be outside the focused\nediting host. Then, only Chrome allow to modify the `Selection`.\nHowever, I think we should not follow Chrome because it may cause more\ncomplicated things in edge cases. Therefore, the new tentative WPT\ncheck whether the selection won't be modified.\n\nNote that the reported assertion failure occurs only when the selection\nmove crosses a frame. Therefore, the new WPT puts caret at edge of the\n`Text` to cross the frame boundary with the `Selection.modify` call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315133\n", "files": ["layout/generic/nsFrameSelection.cpp", "testing/web-platform/tests/selection/contenteditable/selection-outside-focused-editing-host.tentative.html"], "git_node": "bef00736ac79d7447f9626f58837a4b4e6e53489", "git_parents": ["83fa14a8ccfe32f636199ea2248ce2baf224e13f"], "node": "1950e898e73565faf1bc0e61ecca520197623298", "parents": ["93cf11af44520d77d815bd9aafeefbdab683a8c8"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 1922615 - Make the lambda to recreate `IMEContentObserver` check whether the state is still expected one r=jjaschke\n\nThe lambda is a script runner so that the state may have already been\nchanged when it runs. Therefore, it should check whether the state is\nstill expected one, i.e., whether the lambda still needs to create\n`IMEContentObserver` for the situation that the focused element was\nremoved from the DOM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315134\n", "files": ["dom/events/IMEStateManager.cpp", "testing/web-platform/tests/editing/crashtests/set-documentElement-innerHTML-when-embed-in-designMode-has-focus.html"], "git_node": "5476115193aaddde9701b9dd06af051bbec130b9", "git_parents": ["bef00736ac79d7447f9626f58837a4b4e6e53489"], "node": "c441578c031dac9989002b34622345b1a3c183d1", "parents": ["1950e898e73565faf1bc0e61ecca520197623298"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058111 - [devtools] Don't skip browser_toolbox_hosts_size.js on Nova. r=devtools-reviewers,bomsy.\n\nThe test was fixed in Bug 2038693.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314873\n", "files": ["devtools/client/framework/test/browser.toml"], "git_node": "73eb1071289f31ab4872f603de9f0df05e7bcb80", "git_parents": ["5476115193aaddde9701b9dd06af051bbec130b9"], "node": "ecf5893347137998eb6816db5bef1c77d0aa31cc", "parents": ["c441578c031dac9989002b34622345b1a3c183d1"], "tags": []}, {"author": "Vlad Krot \u003cvkrot@google.com\u003e", "branch": "default", "desc": "Bug 2057584 [wpt PR 61515] - [sub apps] enable wpt tests, a=testonly\n\nAutomatic update from web-platform-tests\n[sub apps] enable wpt tests\n\nRe-enable the tests in third_party/blink/web_tests/external/wpt/subapps.\n\n- Use virtual test suits to emulate isolated context with header overrides.\n- Modernized tests to fit new sub apps API shape.\n- Remove insecure context test because by definition isolated context cannot be insecure.\n- Add a test that checks permission policy behavior.\n\nFixed: 40928236\nChange-Id: Idc3d52c01a5a4cb4f4f588ea8c6011e1e13b4901\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8122238\nReviewed-by: Andrew Rayskiy \u003cgreengrape@google.com\u003e\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nReviewed-by: Rick Byers \u003crbyers@chromium.org\u003e\nCommit-Queue: Vlad Krot \u003cvkrot@google.com\u003e\nCr-Commit-Position: refs/heads/main@{#1668571}\n\n--\n\nwpt-commits: 771d7fe17474632b1dd5c39e46c20d47e5cab21a\nwpt-pr: 61515\n", "files": ["testing/web-platform/tests/interfaces/sub-apps.tentative.idl", "testing/web-platform/tests/resources/chromium/mock-subapps.js", "testing/web-platform/tests/subapps/__dir__.headers", "testing/web-platform/tests/subapps/add-error.tentative.https.html", "testing/web-platform/tests/subapps/add-success.tentative.https.html", "testing/web-platform/tests/subapps/disabled-by-permissions-policy.tentative.https.html", "testing/web-platform/tests/subapps/disabled-by-permissions-policy.tentative.https.html.headers", "testing/web-platform/tests/subapps/insecure-context-error.tentative.html", "testing/web-platform/tests/subapps/list-error.tentative.https.html", "testing/web-platform/tests/subapps/list-success.tentative.https.html", "testing/web-platform/tests/subapps/remove-error.tentative.https.html", "testing/web-platform/tests/subapps/remove-success.tentative.https.html", "testing/web-platform/tests/subapps/resources/subapps-helpers.js"], "git_node": "55ecb5735d23c15edde6a8580f536f42e715aabe", "git_parents": ["73eb1071289f31ab4872f603de9f0df05e7bcb80"], "node": "5580ff8583fe6bcf1cf0bd1393cea578cc21a86b", "parents": ["ecf5893347137998eb6816db5bef1c77d0aa31cc"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057584 [wpt PR 61515] - Update wpt metadata, a=testonly\n\nwpt-pr: 61515\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/subapps/insecure-context-error.tentative.html.ini"], "git_node": "a3541d456330791d94cd9b7d8f1322c3de4956a4", "git_parents": ["55ecb5735d23c15edde6a8580f536f42e715aabe"], "node": "ddfbab92485f420d48e892550d6c54765cb7800c", "parents": ["5580ff8583fe6bcf1cf0bd1393cea578cc21a86b"], "tags": []}, {"author": "jugglinmike \u003cmike@mikepennisi.com\u003e", "branch": "default", "desc": "Bug 2054079 [wpt PR 61203] - Implement RFC 237, a=testonly\n\nAutomatic update from web-platform-tests\nImplement RFC 237 (#61203)\n\n* Implement RFC 237: Infrastructure\n\nhttps://github.com/web-platform-tests/rfcs/blob/main/rfcs/web_features_exclusions.md\n\n* Implement RFC 237: Documentation\n\nhttps://github.com/web-platform-tests/rfcs/blob/main/rfcs/web_features_exclusions.md\n\n* Implement RFC 237: WEB_FEATURES.yml files\n\nThese changes were procedurally generated.\n\nhttps://github.com/web-platform-tests/rfcs/blob/main/rfcs/web_features_exclusions.md\n\n* Translate comments in WEB_FEATURES.yml files\n\n* Fix linting errors\n\n* Update tools/web_features/tests/test_web_feature_map.py\n\nCo-authored-by: James C Scott III \u003cjcscottiii@users.noreply.github.com\u003e\n\n* Simplify further\n\n* Remove unsupported typing feature\n\n* Remove assertions\n\n---------\n\nCo-authored-by: James C Scott III \u003cjcscottiii@users.noreply.github.com\u003e\n--\n\nwpt-commits: 4832db47614f5f48cc57374cbf5c1f70937fad48\nwpt-pr: 61203\n", "files": ["testing/web-platform/tests/FileAPI/BlobURL/WEB_FEATURES.yml", "testing/web-platform/tests/FileAPI/FileReader/WEB_FEATURES.yml", "testing/web-platform/tests/FileAPI/WEB_FEATURES.yml", "testing/web-platform/tests/FileAPI/blob/WEB_FEATURES.yml", "testing/web-platform/tests/FileAPI/file/WEB_FEATURES.yml", "testing/web-platform/tests/FileAPI/filelist-section/WEB_FEATURES.yml", "testing/web-platform/tests/FileAPI/reading-data-section/WEB_FEATURES.yml", "testing/web-platform/tests/FileAPI/url/WEB_FEATURES.yml", "testing/web-platform/tests/IndexedDB/WEB_FEATURES.yml", "testing/web-platform/tests/IndexedDB/crashtests/WEB_FEATURES.yml", "testing/web-platform/tests/WebCryptoAPI/WEB_FEATURES.yml", "testing/web-platform/tests/accelerometer/WEB_FEATURES.yml", "testing/web-platform/tests/accname/name/WEB_FEATURES.yml", "testing/web-platform/tests/ai/summarizer/WEB_FEATURES.yml", "testing/web-platform/tests/ambient-light/WEB_FEATURES.yml", "testing/web-platform/tests/appmanifest/WEB_FEATURES.yml", "testi