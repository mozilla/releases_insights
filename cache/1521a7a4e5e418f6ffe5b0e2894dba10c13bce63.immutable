o bug - Tagging a804b557b2ee2dc8b658c3f491d0bd9a03fe4250 with FIREFOX_154_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "4fc9c21281f4db9483f7db4641d310b907857597", "git_parents": ["3ca59af7964d900292e0b5f1277e55bf5c1abe8f"], "node": "0506e5b604cea068f23577b4c503059e4630648c", "parents": ["923d9083865a5b628ee84255ca219f7a5cc55230"], "tags": []}], "date": 1785503226, "git_changesets": ["4fc9c21281f4db9483f7db4641d310b907857597"], "user": "ffxbld@lando.moz.tools"}, "45001": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a804b557b2ee2dc8b658c3f491d0bd9a03fe4250 with DEVEDITION_154_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "a0263697785665952f80d1d89f01df05dbb8936f", "git_parents": ["4fc9c21281f4db9483f7db4641d310b907857597"], "node": "c90fbfe237d498548186732d72e0c1d7567f0c73", "parents": ["0506e5b604cea068f23577b4c503059e4630648c"], "tags": []}], "date": 1785503309, "git_changesets": ["a0263697785665952f80d1d89f01df05dbb8936f"], "user": "ffxbld@lando.moz.tools"}, "45002": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a804b557b2ee2dc8b658c3f491d0bd9a03fe4250 with FIREFOX-ANDROID_154_0b5_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d1618dd1fa7e6e35718ddf1d6f4636dd6d219dd0", "git_parents": ["a0263697785665952f80d1d89f01df05dbb8936f"], "node": "16abd49c7cdc2cedc66297bd39f5200ce45c19d4", "parents": ["c90fbfe237d498548186732d72e0c1d7567f0c73"], "tags": []}], "date": 1785504659, "git_changesets": ["d1618dd1fa7e6e35718ddf1d6f4636dd6d219dd0"], "user": "ffxbld@lando.moz.tools"}, "45003": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a804b557b2ee2dc8b658c3f491d0bd9a03fe4250 with FIREFOX_154_0b5_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "50c1520c9cac96c8e8437ef13ed41ba8e85d375f", "git_parents": ["d1618dd1fa7e6e35718ddf1d6f4636dd6d219dd0"], "node": "247b08756656a941d579f5a60bc978ea738bc73c", "parents": ["16abd49c7cdc2cedc66297bd39f5200ce45c19d4"], "tags": []}], "date": 1785511621, "git_changesets": ["50c1520c9cac96c8e8437ef13ed41ba8e85d375f"], "user": "ffxbld@lando.moz.tools"}, "45004": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging a804b557b2ee2dc8b658c3f491d0bd9a03fe4250 with DEVEDITION_154_0b5_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "db564c9f7ac673cfd5d3fe9c868045cd2fb01586", "git_parents": ["50c1520c9cac96c8e8437ef13ed41ba8e85d375f"], "node": "28c99ba88a6392e11e503a6fe10174076a05f7ec", "parents": ["247b08756656a941d579f5a60bc978ea738bc73c"], "tags": []}], "date": 1785515146, "git_changesets": ["db564c9f7ac673cfd5d3fe9c868045cd2fb01586"], "user": "ffxbld@lando.moz.tools"}, "45005": {"changesets": [{"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2040973 - Wait for the address doorhanger to be localized before clicking its edit link, r=dimi.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315462\n", "files": ["browser/extensions/formautofill/test/browser/head.js"], "git_node": "6fcc9c4d4f810c74cc0ddb1cd86be4503926b25b", "git_parents": ["4b6ed767f4f3b4b0e11689201452295aa3d22e56"], "node": "303f6a04f954aa37749c7bb6453d367f1eac3ae7", "parents": ["d6fc36d0fdba75e5a6152a4d67867c0e5366614e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2040973 - Load the address doorhanger's strings before showing it, r=dimi.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315463\n", "files": ["toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs"], "git_node": "ac184e9d8a4851d71fc9118e8ab9993f560a11d2", "git_parents": ["6fcc9c4d4f810c74cc0ddb1cd86be4503926b25b"], "node": "8dd8730104b6fb812bec8e888bdc7cce3a5b5ef7", "parents": ["303f6a04f954aa37749c7bb6453d367f1eac3ae7"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059358 - Expose separate core eglCreateSync and eglCreateSyncKHR functions. r=gfx-reviewers,nical\n\nIn the subsequent patch we will want to make use of EGL 1.5's core\neglCreateSync() function, which has an incompatible signature with the\nEGL_KHR_fence_sync extension's eglCreateSyncKHR. Currently\nGLLibraryEGL exposes the public function fCreateSync, which calls the\nextension version.\n\nThis patch instead exposes separate functions for both the core 1.5\nand the extension versions: fCreateSyncEGL15 and fCreateSyncKHR. The\ncore version is deliberately *not* just named fCreateSync to prevent\nnew code accidentally using the core version without properly checking\nits availability.\n\nExisting callsites are updated to use the extension version, presuming\nthey already correctly check for the extension's availability. The one\nexception to this is the sync created in\nSharedSurface_IOSurface::ProducerReleaseImpl(). This uses the\nEGL_ANGLE_metal_shared_event_sync extension, which is written against\nEGL 1.5, so we know the core version is available.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315269\n", "files": ["gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h", "gfx/gl/SharedSurfaceAndroidHardwareBuffer.cpp", "gfx/gl/SharedSurfaceEGL.cpp", "gfx/gl/SharedSurfaceIO.cpp", "gfx/layers/opengl/CompositorOGL.cpp", "gfx/layers/opengl/TextureHostOGL.cpp", "gfx/webrender_bindings/RenderAndroidHardwareBufferTextureHost.cpp", "gfx/webrender_bindings/RenderCompositorEGL.cpp", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.cpp", "gfx/webrender_bindings/RenderCompositorOGLSWGL.cpp", "gfx/webrender_bindings/RendererOGL.cpp", "widget/gtk/DMABufSurface.cpp"], "git_node": "6efa9c8980d2fae21faf3d3163f7dd6a002fdca1", "git_parents": ["ac184e9d8a4851d71fc9118e8ab9993f560a11d2"], "node": "d83910d7319f79e28891de88b019e58a1a390944", "parents": ["8dd8730104b6fb812bec8e888bdc7cce3a5b5ef7"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059358 - Perform server-side wait on GpuFenceMTLSharedEvent when running webrender on Metal ANGLE. r=gfx-reviewers,nical\n\nRenderMacIOSurfaceTextureHost::Lock() currently performs a client-side\nwait on its GPU fence: a MTLSharedEvent provided by either WebGPU or\nWebGL when those APIs are running on Metal.\n\nWhen webrender itself is running on Metal (via ANGLE), we can make\nthis a server-side wait instead. To do so, we import the fence's\nMTLSharedEvent as an EGLSync using the\nEGL_ANGLE_metal_shared_event_sync extension, then call eglWaitSync().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315270\n", "files": ["gfx/layers/GpuFence.h", "gfx/layers/GpuFenceMTLSharedEvent.h", "gfx/layers/GpuFenceMTLSharedEvent.mm", "gfx/webrender_bindings/RenderMacIOSurfaceTextureHost.cpp"], "git_node": "c6182c4189b31919fcc6b784db6d8bcd4c9fd183", "git_parents": ["6efa9c8980d2fae21faf3d3163f7dd6a002fdca1"], "node": "cf44ba3e0637e80cefc119173b1d21bdf69c2860", "parents": ["d83910d7319f79e28891de88b019e58a1a390944"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059358 - Use eglWaitUntilWorkScheduledANGLE to synchronise webrender on Metal ANGLE with core animation transaction. r=gfx-reviewers,nical\n\nInstead of creating an EGL_SYNC_METAL_COMMANDS_SCHEDULED sync and\nimmediately calling eglClientWaitSync() on it. This achieves the same\nresult -- blocking until the Metal command buffer is scheduled -- but\navoids ANGLE-internal lock contention with the canvas render thread\ncreating its frame-done MTLSharedEvent sync.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315271\n", "files": ["gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h", "gfx/webrender_bindings/RenderCompositorLayerNative.cpp", "gfx/webrender_bindings/RenderCompositorNative.cpp"], "git_node": "e0593ce383e4180a57f2a097603df4c4bb070b58", "git_parents": ["c6182c4189b31919fcc6b784db6d8bcd4c9fd183"], "node": "2f6255d7241732d24cb975203e2522fcfb252e9c", "parents": ["cf44ba3e0637e80cefc119173b1d21bdf69c2860"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058901 - update to ruff 0.16.0 r=linter-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314270\n", "files": ["python/sites/lint.txt", "python/sites/python-test.txt"], "git_node": "226230a8d344db60db644d76e50974bd06df0902", "git_parents": ["e0593ce383e4180a57f2a097603df4c4bb070b58"], "node": "8524d4d4fee3f3ba207c4d7340920f2561cbc862", "parents": ["2f6255d7241732d24cb975203e2522fcfb252e9c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058901 - ruff-format: format python code blocks in markdown files r=perftest-reviewers,Sasha,chutten,aglavic\n\nruff 0.16 discovers .md files during `ruff format` in order to format the\npython code blocks they contain. Declare `md` in the ruff-format config so\nmozlint routes markdown to it as well, and reformat the affected docs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314932\n", "files": [".agents/skills/js-perf-investigation/SKILL.md", ".claude/skills/js-perf-investigation/SKILL.md", "build/docs/defining-binaries.md", "build/docs/defining-xpcom-components.md", "build/docs/locales.md", "build/docs/rust.md", "docs/code-quality/coding-style/coding_style_python.md", "docs/code-quality/lint/create.md", "docs/contributing/debugging/local_symbols.md", "docs/gtest/index.md", "docs/setup/editing_moz_configure.md", "docs/writing-rust-code/cpp-interop.md", "intl/l10n/docs/migrations/fluent.md", "intl/l10n/docs/migrations/legacy.md", "intl/l10n/docs/migrations/overview.md", "intl/l10n/docs/migrations/testing.md", "python/mach/docs/driver.md", "python/mach/docs/logging.md", "python/mach/docs/settings.md", "remote/doc/marionette/PythonTests.md", "testing/docs/mochitest-plain/index.md", "testing/marionette/client/docs/basics.md", "testing/mozbase/docs/manifestparser.md", "testing/mozbase/docs/mozpower.md", "testing/mozbase/docs/mozprocess.md", "testing/mozbase/docs/mozrunner.md", "testing/perfdocs/generated/adding-tests.md", "testing/perfdocs/generated/talos.md", "testing/performance/adding-tests/perfdocs/index.md", "testing/talos/perfdocs/index.md", "toolkit/components/telemetry/docs/internals/integration_tests/index.md", "toolkit/modules/docs/Region.md", "tools/code-coverage/docs/index.md", "tools/lint/ruff-format.yml", "widget/cocoa/docs/macos-apis.md", "xpcom/docs/writing-xpcom-interface.md"], "git_node": "f90e41304eeb673b40646d35be52b9fb8059730a", "git_parents": ["226230a8d344db60db644d76e50974bd06df0902"], "node": "34485bf2a249027c9545f5e83a052fde69245c47", "parents": ["8524d4d4fee3f3ba207c4d7340920f2561cbc862"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 1: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314577\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "remote/shared/NetworkResponse.sys.mjs"], "git_node": "75948f8125f838f05f4333e119f9ab8b382b81e4", "git_parents": ["f90e41304eeb673b40646d35be52b9fb8059730a"], "node": "3d67c8cea90d2685dca630393e5fc036a6a75b47", "parents": ["34485bf2a249027c9545f5e83a052fde69245c47"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 2: Pre-calculate the fallback encoding for the classic script source. r=bthrall,dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314578\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/workers/ScriptLoader.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/script-charset-03.html.ini"], "git_node": "ad62acfd4b757f46945dfb1d9dd5ca346bb9a368", "git_parents": ["75948f8125f838f05f4333e119f9ab8b382b81e4"], "node": "731eeedbd7c35dad0dbbecaa7a55d7cf9469f13f", "parents": ["3d67c8cea90d2685dca630393e5fc036a6a75b47"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 3: Use pre-calculated fallback encoding for the in-memory cache key. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314579\n", "files": ["dom/script/ScriptLoader.cpp", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "js/loader/LoadedScript.h"], "git_node": "e7f54c323f020bc597dc30239ea184b8e61fc8e3", "git_parents": ["ad62acfd4b757f46945dfb1d9dd5ca346bb9a368"], "node": "0d71509765fa9a048834f2d86142713ba5a4c91c", "parents": ["731eeedbd7c35dad0dbbecaa7a55d7cf9469f13f"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 4: Use pre-calculated fallback encoding for the classic script disk cache MIME-Type. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314580\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "8f1cbb9d65483b2d92920a2208c004f1116f0da5", "git_parents": ["e7f54c323f020bc597dc30239ea184b8e61fc8e3"], "node": "ff6c1a750168a0eebd42dabc9fed937d27213c54", "parents": ["0d71509765fa9a048834f2d86142713ba5a4c91c"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 5: Add tests. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314581\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset.sjs", "dom/base/test/head.js"], "git_node": "56048444867a93fe8274c2fbe88076c1a55809e9", "git_parents": ["8f1cbb9d65483b2d92920a2208c004f1116f0da5"], "node": "768cea98e840a643fbf19d030467d111bd3e21ad", "parents": ["ff6c1a750168a0eebd42dabc9fed937d27213c54"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2056134: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/script/SharedScriptCache.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.h"], "git_node": "1505b4958d559e8f0b5a961bd98392e7e24527a9", "git_parents": ["56048444867a93fe8274c2fbe88076c1a55809e9"], "node": "a95cf9941e9de33025fd3f0ed8a25d3610060f6e", "parents": ["768cea98e840a643fbf19d030467d111bd3e21ad"], "tags": []}, {"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 1804663 - Fix ordering of datetime edit fields in RTL builds, part 2. r=mstriemer\n\nThe first patch fixed this for EN builds set to RTL, but not for AR builds. We only need to set `unicode-bidi: embed` to maintain the field ordering; the directionality does not need to be changed and is what was causing this issue. See the bug comments for verification.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305915\n", "files": ["toolkit/content/widgets/datetimebox.js"], "git_node": "2fa772016a4ab1b3581813eb9170eb66d601c6c8", "git_parents": ["1505b4958d559e8f0b5a961bd98392e7e24527a9"], "node": "6d46c1e987dce4afeff612b21796fe01812df26c", "parents": ["a95cf9941e9de33025fd3f0ed8a25d3610060f6e"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\naf -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nan -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nar -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nast -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\naz -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nbe -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nbg -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nbn -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nbo -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nbqi -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nbr -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nbrx -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nbs -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nca -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nca-valencia -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\ncak -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nckb -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\ncs -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\ncy -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nda -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nde -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\ndsb -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nel -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nen-CA -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nen-GB -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\neo -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nes-AR -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nes-CL -\u003e fad900ad713ad6f41f377fb1da7d1d79b094fd6a\nes-ES -\u003e fad900ad713a