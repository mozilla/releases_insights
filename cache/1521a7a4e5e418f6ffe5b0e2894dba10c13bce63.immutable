ate-browsing-indicator.inc.xhtml", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_indicator.js", "browser/locales/en-US/browser/browser.ftl", "browser/themes/shared/browser-shared.css", "browser/themes/shared/privatebrowsing/pbm-logo.svg"], "git_node": "5f9a039fb6b561ffeff0962d2ac83ed13afaf95b", "git_parents": ["7cdcc8dffeb5c7047235807f316fff4c3b15e17d"], "node": "6d9a884fade9d91569cd5c75599c2dec0db89728", "parents": ["0d8877028c55021c4cf5e82a1d72287c6cacfc83"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057362 - Constify nsLayoutUtils::FindNearestBlockAncestor() and its callers. r=layout-reviewers,dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313898\n", "files": ["layout/base/nsLayoutUtils.cpp", "layout/base/nsLayoutUtils.h", "layout/generic/AbsoluteContainingBlock.cpp"], "git_node": "92eda4947b32cf044eee509b5fec376137cb4a27", "git_parents": ["5f9a039fb6b561ffeff0962d2ac83ed13afaf95b"], "node": "c5935211e35dde265361c3aad3fdd52a1b21c226", "parents": ["6d9a884fade9d91569cd5c75599c2dec0db89728"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054473 - Fix browser_aiwindow_agent_monitor_item.js failure where the test node was not accessible r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314043\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/test_agent_monitor_item_page.html"], "git_node": "0f16fef034090c1c63f6e80e048eea32faad2ea3", "git_parents": ["92eda4947b32cf044eee509b5fec376137cb4a27"], "node": "db59e73163ec54922cf9f65d125f9c06a477e50e", "parents": ["c5935211e35dde265361c3aad3fdd52a1b21c226"], "tags": []}], "date": 1784930035, "git_changesets": ["7bd32bb6c4a2cd66a9ddecc3c4041bf619625d32", "8cf065ba3dfb53cad5be57f0f51816e1912dfb75", "a5cddd5f8e3454adddc72220c989b6b12