ebbc035feada1c2c809"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2056415 - make fast_forward_libwebrtc.py callable by other scripts. r=dbaker DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313103\n", "files": ["dom/media/webrtc/third_party_build/fast_forward_libwebrtc.py"], "git_node": "e053159c5ccb7c989b1054647f776d828a7f5c3e", "git_parents": ["bfe68b214b9214935c08f7b8ba59463d0ed1722d"], "node": "b84d0bba854dac4a1ba4019d5c82a0fb17d0d95c", "parents": ["43de165df8fb76472abd8279333f8f31dcb44580"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2056415 - hold onto the original loop-ff.sh as old-loop-ff.sh for comparison runs. r=dbaker DONTBUILD\n\nSee Bug 2056988 for the eventual removal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313104\n", "files": ["dom/media/webrtc/third_party_build/old-loop-ff.sh"], "git_node": "a604dde489d708ffd829f87bf4207168fa1cffff", "git_parents": ["e053159c5ccb7c989b1054647f776d828a7f5c3e"], "node": "3230200009025efe07eac8a44b7860f4d1d21335", "parents": ["b84d0bba854dac4a1ba4019d5c82a0fb17d0d95c"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2056415 - new python based loop-ff. r=dbaker DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313105\n", "files": ["dom/media/webrtc/third_party_build/loop-ff.py", "dom/media/webrtc/third_party_build/loop-ff.sh"], "git_node": "9d7e41e0229a93ee9b6bf6c51c2a187ab20f7f62", "git_parents": ["a604dde489d708ffd829f87bf4207168fa1cffff"], "node": "2f81451c5b51fd64308dbab23df1c038f7d01497", "parents": ["3230200009025efe07eac8a44b7860f4d1d21335"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2056415 - faster local vendoring. r=dbaker DONTBUILD\n\nEliminates the tar/untar steps.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313249\n", "files": ["dom/media/webrtc/third_party_build/vendor-libwebrtc.py"], "git_node": "a319bb608c75c60cec3731bdc6d07f374436e890", "git_parents": ["9d7e41e0229a93ee9b6bf6c51c2a187ab20f7f62"], "node": "176a61b852236d93f542c8445683e09935d00a1a", "parents": ["2f81451c5b51fd64308dbab23df1c038f7d01497"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2056415 - rename LIBWEBRTC_DIR to destination_dir and make it a non-global. r=dbaker DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313250\n", "files": ["dom/media/webrtc/third_party_build/vendor-libwebrtc.py"], "git_node": "e75daed9f9092f06957628587b544454ad55ae91", "git_parents": ["a319bb608c75c60cec3731bdc6d07f374436e890"], "node": "a81cda54fb6efe5c62d61ff94ec30b0600c2103a", "parents": ["176a61b852236d93f542c8445683e09935d00a1a"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2056415 - make vendor-libwebrtc.py callable from other python scripts. r=dbaker DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313251\n", "files": ["dom/media/webrtc/third_party_build/vendor-libwebrtc.py"], "git_node": "1feff9626e46ae8ce680a4daca93bebdb0b8338d", "git_parents": ["e75daed9f9092f06957628587b544454ad55ae91"], "node": "6cf3084e4ec54aa66a719f00148489ecae211c56", "parents": ["a81cda54fb6efe5c62d61ff94ec30b0600c2103a"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2056415 - use externally callable vendor-libwebrtc.py in vendor_and_commit.py r=dbaker DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313252\n", "files": ["dom/media/webrtc/third_party_build/vendor_and_commit.py"], "git_node": "d76b12ff2f55d16855fe0cdf307b8cd04b71f086", "git_parents": ["1feff9626e46ae8ce680a4daca93bebdb0b8338d"], "node": "8eba6556ea7646c1d450ec9dc9a3d145aa77758b", "parents": ["6cf3084e4ec54aa66a719f00148489ecae211c56"], "tags": []}, {"author": "Michael Froman \u003cmjfroman@mac.com\u003e", "branch": "default", "desc": "Bug 2056415 - tweak save_patch_stack for better timing on git commands. r=dbaker DONTBUILD\n\nWhen the repo is setup to use fsmonitor, the git lock file can hang around a bit.\nThis turns off the fsmonitor and garbage collection for the git commands to stage\nfiles that are added/deleted/modified.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313793\n", "files": ["dom/media/webrtc/third_party_build/save_patch_stack.py"], "git_node": "86b3546bd511591b962388ace35e3deb77fe7a50", "git_parents": ["d76b12ff2f55d16855fe0cdf307b8cd04b71f086"], "node": "4f6d6659003b83f4acde0ce4ae504d0d6cefd046", "parents": ["8eba6556ea7646c1d450ec9dc9a3d145aa77758b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057251 - Use MacAutoreleasePool rather than hand-rolling it in MacApplicationDelegate. r=mac-reviewers,bradwerth\n\nMinor clean-up while I was looking at this part of the code.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313733\n", "files": ["toolkit/xre/MacApplicationDelegate.mm"], "git_node": "8f91807ee37638700d6ff4b9faf80c42d700a3d4", "git_parents": ["86b3546bd511591b962388ace35e3deb77fe7a50"], "node": "67f48a7bb0f270b7d00ef8d11439b1701073551a", "parents": ["4f6d6659003b83f4acde0ce4ae504d0d6cefd046"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2055545 - Part 1: Return BufferOffset from branch method. r=jandem\n\nReturn the buffer offset from all branch methods for part 2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313235\n", "files": ["js/src/jit/riscv64/base/base-assembler-riscv.cc", "js/src/jit/riscv64/base/base-assembler-riscv.h", "js/src/jit/riscv64/base/base-riscv-i.cc", "js/src/jit/riscv64/base/base-riscv-i.h"], "git_node": "b2e35154871f19c17a568e6cfb8f856dad24ee8a", "git_parents": ["8f91807ee37638700d6ff4b9faf80c42d700a3d4"], "node": "142187a9fa48c350f5584a49d7e4143016750908", "parents": ["67f48a7bb0f270b7d00ef8d11439b1701073551a"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2055545 - Part 2: Register deadline after emitting the instruction. r=jandem\n\nIf a newly registered deadline is the new earliest deadline, then the veneer\npool can be considered as full even though we've used `nextInstrOffset`\ndirectly before registering the deadline.\n\nTo avoid this situation, first emit the branch instruction and then register the\nbranch deadline.\n\nAlso add more assertions to check that the expected branch buffer offset matches\nthe actual branch buffer offset.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313236\n", "files": ["js/src/jit/riscv64/Assembler-riscv64.cpp", "js/src/jit/riscv64/Assembler-riscv64.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jsapi-tests/testAssemblerBuffer.cpp"], "git_node": "6744a0134c42f27e04ab3f4351035c2ca89b70f2", "git_parents": ["b2e35154871f19c17a568e6cfb8f856dad24ee8a"], "node": "4a3edf823e169ca1471f860f93b802c15a719910", "parents": ["142187a9fa48c350f5584a49d7e4143016750908"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 1: Remove unnecessary Register constructor calls. r=spidermonkey-reviewers,jandem\n\nThese were probably needed at some point to explicitly cast from\n`ScratchRegisterScope` to `Register`, but are now no longer necessary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313401\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "ad2b01208c4955e7c9d1bd739b533345f29a6018", "git_parents": ["6744a0134c42f27e04ab3f4351035c2ca89b70f2"], "node": "76721b4f58d522b4fb7f6a57024b2e51beae0075", "parents": ["4a3edf823e169ca1471f860f93b802c15a719910"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 2: Add zext_b pseudo-instruction and ZeroExtendByte. r=spidermonkey-reviewers,jandem\n\nAdd `zext_b` and its companion method `ZeroExtendByte`. Then replace existing\ncallers to use either `zext_b` or `ZeroExtendByte`, depending on the surrounding\ncode.\n\nDrive-by change:\n- Remove `xlen` uses in `SignExtendByte`, because we only support RV64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313402\n", "files": ["js/src/jit/riscv64/Assembler-riscv64.h", "js/src/jit/riscv64/CodeGenerator-riscv64.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h", "js/src/jit/riscv64/base/base-riscv-i.h"], "git_node": "f29f9eb1ec379170cdc1e48f61724b78a642c276", "git_parents": ["ad2b01208c4955e7c9d1bd739b533345f29a6018"], "node": "40309fa2a1580da0917582b5f6ada7bc7f5a4625", "parents": ["76721b4f58d522b4fb7f6a57024b2e51beae0075"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 3: Add ZeroExtendShort. r=spidermonkey-reviewers,jandem\n\nAdd `ZeroExtendShort` which emits `zext.h` if the Zbb extension is available.\n\nDrive-by change:\n- Remove `xlen` uses in `SignExtendByte`, because we only support RV64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313403\n", "files": ["js/src/jit/riscv64/Assembler-riscv64.h", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "7e44e9d45e62ac067fa23955528cbf993482b182", "git_parents": ["f29f9eb1ec379170cdc1e48f61724b78a642c276"], "node": "2fcb0b9124ad39cfc2dc2a5b3e67ab111ddcd5f8", "parents": ["40309fa2a1580da0917582b5f6ada7bc7f5a4625"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 4: Fix simulation of AMO instructions. r=spidermonkey-reviewers,jandem\n\nRemove the old `Simulator::amo()` method because it didn't perform any\nsynchronization. Add `AtomicMemoryHelper` similar to upstream V8, but\nonly support SeqCst (Release+Acquire) ordering, so we can reuse the\natomic primitives from `AtomicOperations`.\n\nRemove support for AMO min/max instructions, because there are no matching\nprimitives from `AtomicOperations`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313404\n", "files": ["js/src/jit/riscv64/Simulator-riscv64.cpp", "js/src/jit/riscv64/Simulator-riscv64.h"], "git_node": "1382197918d8727f71363ccf5a33c86001172e82", "git_parents": ["7e44e9d45e62ac067fa23955528cbf993482b182"], "node": "e951a4bf175c1068f3fc6f611686fe5e5ddb2134", "parents": ["2fcb0b9124ad39cfc2dc2a5b3e67ab111ddcd5f8"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 5: Use AMO instructions for AtomicExchange(64). r=spidermonkey-reviewers,jandem\n\nUse AMO instructions `amoswap.w/d` if possible, otherwise fallback to the\nexisting LR/SC loop. Within the LR/SC loop ensure all requirements for\n\"constrained LR/SC loop\" are fulfilled.\n\nThe \"A\" extension consists of the Zalrsc and Zaamo extensions, and the RV64G\nbase ISA requires support for the \"A\" extension, so it's always okay to emit\nAMO instructions. This also matches Clang/GCC when using SeqCst `std::atomic`\noperations and what V8 is using.\n\nAdds new helpers `Atomic{Offset,Mask,ShiftToOffset,ExtendResult}` which are\nreused in the next parts to avoid duplicating the same code multiple times.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313405\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/wasm/WasmSummarizeInsn.cpp"], "git_node": "9867511481441f3cd112d250e26dbf2dd4e7feeb", "git_parents": ["1382197918d8727f71363ccf5a33c86001172e82"], "node": "fbc37029f083dfba72689c1e99ec55fe01117cb6", "parents": ["e951a4bf175c1068f3fc6f611686fe5e5ddb2134"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 6: Use AMO instructions for AtomicFetchOp64. r=spidermonkey-reviewers,jandem\n\n64-bit Atomic fetch operations can be implemented using a single AMO\ninstructions. The additional temp register is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313406\n", "files": ["js/src/jit/LIROps.yaml", "js/src/jit/riscv64/CodeGenerator-riscv64.cpp", "js/src/jit/riscv64/Lowering-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/wasm/WasmBCMemory.cpp"], "git_node": "bfcf961c558840181ea72d540e8448a2a88ce65d", "git_parents": ["9867511481441f3cd112d250e26dbf2dd4e7feeb"], "node": "20702b466582c2bf0d98f83d67dd7b226f51ef25", "parents": ["fbc37029f083dfba72689c1e99ec55fe01117cb6"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 7: Use AMO instructions for AtomicFetch/EffectOp. r=spidermonkey-reviewers,jandem\n\nUse different implementation strategies based on the bit-width and operation:\n1. 32-bit operations can always use AMO instructions.\n2. 8/16-bit bitwise operations can be be implemented using 32-bit AMO instructions.\n3. For Add/Sub we need to keep using a LR/SC loop.\n\nMerges `AtomicFetchOp` and `AtomicEffectOp` into a single `AtomicFetchOrEffectOp`\nfunction to reduce code duplication. \"Effect\" operations pass `zero_reg` as the\noutput register.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313407\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "a025edc0d0b865ac990c6992d44c6c1829f1a98e", "git_parents": ["bfcf961c558840181ea72d540e8448a2a88ce65d"], "node": "35bdde524cc17d957614657484f49f8e24e0c976", "parents": ["20702b466582c2bf0d98f83d67dd7b226f51ef25"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 8: Change CompareExchange(64) to follow \"constrained LR/SC loop\" constraints. r=spidermonkey-reviewers,jandem\n\nChange the implementation to follow \"constrained LR/SC loop\" constraints and\nimprove it to generate fewer instructions (based on what Clang is using for\nC++ `std::atomic` operations).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313408\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp"], "git_node": "7a3e245be16ad2bcd76e3373c09c2139503e4170", "git_parents": ["a025edc0d0b865ac990c6992d44c6c1829f1a98e"], "node": "d6447c3bd5bc31c7c3eb6d5734235523c04262f9", "parents": ["35bdde524cc17d957614657484f49f8e24e0c976"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 9: Use at-start allocations when 64-bit AMO instructions are used. r=spidermonkey-reviewers,jandem\n\nWhen AMO instructions are used, no input register is read after writing to the\noutput register, so we can use at-start allocations here.\n\nDrive-by changes:\n- Remove `const` for values to match other code. `const` also doesn't give any\n  benefits, because the methods are short enough so it's easy to see that no\n  modifications take place.\n- Use more `auto*`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313409\n", "files": ["js/src/jit/riscv64/Lowering-riscv64.cpp", "js/src/jit/shared/Lowering-shared.cpp", "js/src/jit/shared/Lowering-shared.h"], "git_node": "6ad8346292053554575087c3dbd7412a8ef3c353", "git_parents": ["7a3e245be16ad2bcd76e3373c09c2139503e4170"], "node": "5f23707971ed1f45cb2c9bf069ee9176bbc2b3a8", "parents": ["d6447c3bd5bc31c7c3eb6d5734235523c04262f9"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 10: Move xlen to Simulator. r=spidermonkey-reviewers,jandem\n\nAfter parts 2-3, `xlen` is now only used by the simulator.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313410\n", "files": ["js/src/jit/riscv64/Simulator-riscv64.h", "js/src/jit/riscv64/base/base-assembler-riscv.h"], "git_node": "914d5092836e0c77ed14bd3fb8241b8f1698ffab", "git_parents": ["6ad8346292053554575087c3dbd7412a8ef3c353"], "node": "1e106724a415e30cd6cd03ebdf5f807c9ff97bac", "parents": ["5f23707971ed1f45cb2c9bf069ee9176bbc2b3a8"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 11: Generate better code for wasm load/stores for riscv64. r=spidermonkey-reviewers,jandem\n\nThe Zba extension instructions `add.uw` and `sh{1,2,3}add.uw` are exactly what's\nneeded for Wasm load/store instructions with an Int32 index.\n\nThis patch adds `enum ZeroExtendIndex` to control when the index member of\n`BaseIndex` needs to be zero-extended. \"CodeGenerator-riscv64.cpp\" and\n\"WasmBCMemory.cpp\" now pass `ZeroExtendIndex` to the wasm load/store methods\ninstead of manually zero-extending the index.\n\nThis approach ensures better code generation and is also needed for part 13 to\nadd missing index zero-extension for Atomics operations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313411\n", "files": ["js/src/jit-test/tests/wasm/store-zero-riscv64-ion-codegen.js", "js/src/jit/MacroAssembler.h", "js/src/jit/riscv64/CodeGenerator-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h", "js/src/jit/shared/Assembler-shared.h", "js/src/wasm/WasmBCClass.h", "js/src/wasm/WasmBCMemory.cpp"], "git_node": "0d769b288910f1266f5288209f0eabac04aaecd9", "git_parents": ["914d5092836e0c77ed14bd3fb8241b8f1698ffab"], "node": "26b9c0e388008e7e8f2bad312f2de5934be59b14", "parents": ["1e106724a415e30cd6cd03ebdf5f807c9ff97bac"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 12: Add missing move64To32 for compare-exchange. r=spidermonkey-reviewers,jandem\n\nCompare-Exchange is implemented using a LR/SC loop, so the expected value needs\nto be sign-extended to a word to ensure other bits in the high word are ignored.\n\nThe test case in part 13 fails without this change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313412\n", "files": ["js/src/wasm/WasmBCMemory.cpp"], "git_node": "d3c11e45e508ed9accc85fee36361f0dfdc2d544", "git_parents": ["0d769b288910f1266f5288209f0eabac04aaecd9"], "node": "7963a854d65c2ea93ac6fdf14ae2546e59f458d3", "parents": ["26b9c0e388008e7e8f2bad312f2de5934be59b14"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2056833 - Part 13: Pass ZeroExtend32To64 to Wasm Atomic operations. r=spidermonkey-reviewers,jandem\n\nPass `ZeroExtend32To64` to properly zero-extend the index for Atomics\noperations. Otherwise we end up adding the sign-extended index, for example\n`0xFFFFFFFF80000000` instead of `0x80000000`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313413\n", "files": ["js/src/jit-test/tests/wasm/large-memory-atomics-index-zero-extended.js", "js/src/jit/MacroAssembler.h", "js/src/jit/riscv64/CodeGenerator-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/jit/riscv64/MacroAssembler-riscv64.h"], "git_node": "f8a24e6488fc59b76ddf0445b7000146d1d0be78", "git_parents": ["d3c11e45e508ed9accc85fee36361f0dfdc2d544"], "node": "b1f18bf9123310eb6b5c1eae8e4f9244702e0fed", "parents": ["7963a854d65c2ea93ac6fdf14ae2546e59f458d3"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2055545, 2056833: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/jit/riscv64/base/base-assembler-riscv.cc", "js/src/jit/riscv64/base/base-riscv-i.cc"], "git_node": "6f73e4a62ad8ec9a1d165f4a582f4ba153d118ac", "git_parents": ["f8a24e6488fc59b76ddf0445b7000146d1d0be78"], "node": "17a36d9ce7cbd0e6c59cfdd15eb614b36303beb9", "parents": ["b1f18bf9123310eb6b5c1eae8e4f9244702e0fed"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055939 - Remove version 153 train-hop compatibility shims for the World Cup newtab logo variations. r=thecount\n\nFirefox 153 has reached Release and the world sporting event is over, so the newtab logo-variations\ncan be removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312814\n", "files": ["browser/extensions/newtab/content-src/components/Logo/Logo.jsx", "browser/extensions/newtab/content-src/components/Logo/_Logo.scss", "browser/extensions/newtab/content-src/components/Logo/variants/FootballBounce.jsx", "browser/extensions/newtab/content-src/components/Logo/variants/RotatingBall.jsx", "browser/extensions/newtab/content-src/components/Logo/variants/SpinBallSmall.jsx", "browser/extensions/newtab/content-src/components/Logo/variants/SpinSmooth.jsx", "browser/extensions/newtab/content-src/components/Logo/variants/_FootballBounce.scss", "browser/extensions/newtab/content-src/components/Logo/variants/_SpinBallSmall.scss", "browser/extensions/newtab/content-src/components/Logo/variants/_SpinSmooth.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/data/content/assets/football-bounce.webp", "browser/extensions/newtab/data/content/assets/rotating-ball.webp", "browser/extensions/newtab/data/content/assets/spin-smooth.webp", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Logo.test.jsx"], "git_node": "f9fb38c1e80efd6e229c8bc77fb38757f518168e", "git_parents": ["6f73e4a62ad8ec9a1d165f4a582f4ba153d118ac"], "node": "8afa15b4c78b4ddab9bc06bd47b3cbf2ca42fe82", "parents": ["17a36d9ce7cbd0e6c59cfdd15eb614b36303beb9"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057298 - Update mots.yaml with new component name \"Developer Infrastructure::Source Code Analysis\". r=zeid\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313801\n", "files": ["mots.yaml"], "git_node": "b952aa652f9e14d145a26f00d80f5b915adc9350", "git_parents": ["f9fb38c1e80efd6e229c8bc77fb38757f518168e"], "node": "6215284094a71f2b8c761d3fb955d1ddbdf29814", "parents": ["8afa15b4c78b4ddab9bc06bd47b3cbf2ca42fe82"], "tags": []}, {"author": "Stephen Thompson \u003csthompson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054781 - fix Nova failure for browser_884402_customize_from_overflow.js r=sfoster\n\nMake the test click the center of the element instead of at (2,2).\n\nProton `--panel-menuitem-border-radius` is 4px but Nova is 16px. The position (2,2) does not overlap the toolbarbutton background when the border-radius is high. Instead of hardcoding a more comfortable position, I figured it's fine to click the element's center.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313654\n", "files": ["browser/components/customizableui/test/browser_884402_customize_from_overflow.js"], "git_node": "e8dafa065d673c89a30e45621c5a6b445b665e50", "git_parents": ["b952aa652f9e14d145a26f00d80f5b915adc9350"], "node": "6f8814bd2b59792ee2faf13850f6af5ba63f1fac", "parents": ["6215284094a71f2b8c761d3fb955d1ddbdf29814"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053448 - Refactor the duplicate code between baseline profile generators and macrobenchmark tests into helper functions r=android-reviewers,tthibaud\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313058\n", "files": ["mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfileBrowserPageScrollBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesHomepageScrollBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesLaunchIntentBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesNormalBrowsingBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesOnboardingBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesPrivateBrowsingBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesStartupBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/BaselineProfilesSwitchTabsBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/TabsTrayBenchmark.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/BrowserPageScrollBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/HomepageScrollBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/LaunchIntentBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/NormalBrowsingBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/OnboardingBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/PrivateBrowsingBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/StartupOnlyBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/baselineprofile/SwitchTabsBaselineProfileGenerator.kt", "mobile/android/fenix/benchmark/src/main/java/org/mozilla/fenix/benchmark/utils/MacrobenchmarkScope.kt"], "git_node": "94a2a80e7976956a134779adf0f461cff686f06e", "git_parents": ["e8dafa065d673c89a30e45621c5a6b445b665e50"], "node": "29dc18974e728e2564f9e3b1d6152e4728c3db12", "parents": ["6f8814bd2b59792ee2faf13850f6af5ba63f1fac"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056944 - Skip the login advisory in tests r=omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313820\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "53b9c3e71633fb44d21f7692c634f2c8af16adb9", "git_parents": ["94a2a80e7976956a134779adf0f461cff686f06e"], "node": "5a26489d9c82f287c97d3ee3ad3a1ecdfe084efa", "parents": ["29dc18974e728e2564f9e3b1d6152e4728c3db12"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2055222. Add qcms_profile_create_cicp_with_intent. r=jrmuizel\n\njxl encodes the transfer function, the primaries and the rendering intent, so it'd be good to receive them all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312281\n", "files": ["gfx/qcms/qcms.h", "gfx/qcms/src/c_bindings.rs", "gfx/qcms/src/iccread.rs"], "git_node": "103fc2513dcfb080f00fe2aee7e1115329edfa3e", "git_parents": ["53b9c3e71633fb44d21f7692c634f2c8af16adb9"], "node": "4c0229731a0a444ab2f9ed768077366bfe04d417", "parents": ["5a26489d9c82f287c97d3ee3ad3a1ecdfe084efa"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2055224. Recognize common JXL color spaces via CICP enums instead of synthesizing an ICC. r=saschanaz\n\nHaving jxl-rs synthesize an ICC profile just so we can build a qcms input\nprofile from it is inefficient. Instead recognize the common color spaces\nfrom their CICP enum values and build the qcms profile directly, keeping the\nICC path only for what CICP can't represent (grayscale, CMYK, embedded ICC,\ncustom color points).\n\nPQ and HLG transfer functions are excluded (we want the icc for those): for\nPQ and HLG jxl-rs bakes HDR tone mapping into the ICC's A2B0 LUT, which qcms\nuses. We currently don't do any tonemapping for these transfer functions and\nthe result is not good.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312282\n", "files": ["image/decoders/nsJXLDecoder.cpp", "image/decoders/nsJXLDecoder.h", "image/rust/jxl/src/decoder.rs", "image/rust/jxl/src/ffi.rs", "image/test/reftest/jxl/reftest.list", "testing/web-platform/meta/jpegxl/wide-gamut-adobe-rgb.html.ini", "testing/web-platform/tests/jpegxl/hdr-alpha-reftest.html", "testing/web-platform/tests/jpegxl/progressive-1.html", "testing/web-platform/tests/jpegxl/sdr-alpha-reftest.html"], "git_node": "8c8c29a5f6684cd556a55830fa5d98ea842921c1", "git_parents": ["103fc2513dcfb080f00fe2aee7e1115329edfa3e"], "node": "085124bd34be398e19705fc299c2192c70e210e0", "parents": ["4c0229731a0a444ab2f9ed768077366bfe04d417"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007200: Implement exportKeyingMaterial() method r=saschanaz,webidl,tschuster,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D277254\n", "files": ["dom/webidl/WebTransport.webidl", "dom/webtransport/api/WebTransport.cpp", "dom/webtransport/api/WebTransport.h", "dom/webtransport/parent/WebTransportParent.cpp", "dom/webtransport/parent/WebTransportParent.h", "dom/webtransport/shared/PWebTransport.ipdl", "testing/web-platform/meta/webtransport/idlharness.https.sub.any.js.ini"], "git_node": "d0fc4b94fb7e649e05f51d40d441052e23835a45", "git_parents": ["8c8c29a5f6684cd556a55830fa5d98ea842921c1"], "node": "5e79b4fb08ddb9a02949a10fe2e4a2dd17a4f188", "parents": ["085124bd34be398e19705fc299c2192c70e210e0"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007200: Add WebTransport ExportKeyingMaterial backend r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283490\n", "files": ["netwerk/socket/neqo_glue/src/lib.rs"], "git_node": "65e72a996304e8cc553ee07532973034c3e2ba0a", "git_parents": ["d0fc4b94fb7e649e05f51d40d441052e23835a45"], "node": "58159f5f6108d3e98d0887508ebaac18eef3eed6", "parents": ["5e79b4fb08ddb9a02949a10fe2e4a2dd17a4f188"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007200: Hook up WebTransport exportKeyingMaterial to necko/neqo r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283498\n", "files": ["dom/webtransport/parent/WebTransportParent.cpp", "netwerk/protocol/http/Http2WebTransportSession.cpp", "netwerk/protocol/http/Http2WebTransportSession.h", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h", "netwerk/protocol/http/Http3WebTransportSession.cpp", "netwerk/protocol/http/Http3WebTransportSession.h", "netwerk/protocol/http/WebTransportSessionBase.h", "netwerk/protocol/webtransport/WebTransportSessionProxy.cpp", "netwerk/protocol/webtransport/nsIWebTransport.idl", "netwerk/socket/neqo_glue/NeqoHttp3Conn.h", "netwerk/test/gtest/TestHttp3ConnectUDPStream.cpp"], "git_node": "451c5f579528c78d83f119173837c561b97846e8", "git_parents": ["65e72a996304e8cc553ee07532973034c3e2ba0a"], "node": "9f67d252dfdeea0a56495f11d28c86e3932ae172", "parents": ["58159f5f6108d3e98d0887508ebaac18eef3eed6"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2007200: Add wpt tests for WebTransport exportKeyingMaterial r=jib\n\nDifferential Revision: https://phabricator.services.mozilla.com/D280261\n", "files": ["testing/web-platform/tests/webtransport/export-keying-material.https.any.js"], "git_node"