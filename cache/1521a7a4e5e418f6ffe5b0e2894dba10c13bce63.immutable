64f46e726f280c14667eac9141d7fc94", "bfa462403422b573d020c6687fa7ff4a40589fdc", "cb46d43c454dcd4ec02dc866fa2ba727e8a24a96", "580b63d20423b75a0b4c1ec1b52f8dfa3cd8d1c3", "a21abb649db0e1e851565470a86a8d5db4b129d1", "42f0c32b261578727774f35d0ffec51d012b7055", "f66e509a3edb278938cf02ad580e3e320fa261cb", "1b546bb3fbcc4bae8e1d557fabd99014c69c5208", "c9f1b83187fdb20406e30f8f6025c74099dda9c6", "079065d33b0b788f93395938d10660927761dceb"], "user": "rperta@mozilla.com"}, "44996": {"changesets": [{"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044416 - Create backgroundtasks using backgroundtaskbuilder on windows msix packages. r=nrishel,browser-installer-reviewers,iholmes,cdupuis\" for causing rust vendor failures.\n\nThis reverts commit 4d414e10a2a03d5a82f045f19dcd3649aae4ae73.\n", "files": ["Cargo.lock", "Cargo.toml", "browser/installer/windows/msix/AppxManifest.xml.in", "build/workspace-hack/Cargo.toml", "python/mozbuild/mozbuild/repackaging/msix.py", "toolkit/components/taskscheduler/TaskScheduler.sys.mjs", "toolkit/components/taskscheduler/TaskSchedulerWinMSIXImpl.sys.mjs", "toolkit/components/taskscheduler/components.conf", "toolkit/components/taskscheduler/moz.build", "toolkit/components/taskscheduler/nsIWinBackgroundTaskRegistrar.idl", "toolkit/components/taskscheduler/rust/Cargo.toml", "toolkit/components/taskscheduler/rust/src/WinBackgroundTaskRegistrar.h", "toolkit/components/taskscheduler/rust/src/lib.rs", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs", "toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build", "toolkit/moz.build", "toolkit/moz.configure", "toolkit/mozapps/msixcomserver-rust/Cargo.toml", "toolkit/mozapps/msixcomserver-rust/moz.build", "toolkit/mozapps/msixcomserver-rust/src/lib.rs", "toolkit/mozapps/msixcomserver/moz.build", "toolkit/mozapps/msixcomserver/msixcomserver.cpp", "toolkit/mozapps/msixcomserver/msixcomserver.def"], "git_node": "1efbe2f75d8b32277a66c29b85b2c5061429cc08", "git_parents": ["079065d33b0b788f93395938d10660927761dceb"], "node": "59454fc602234d684e7ffe1fe482f0faa843caa2", "parents": ["1f4879f26c6cf87a18e67caee8addf782b776552"], "tags": []}], "date": 1785487874, "git_changesets": ["1efbe2f75d8b32277a66c29b85b2c5061429cc08"], "user": "smolnar@mozilla.com"}, "44997": {"changesets": [{"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2051354 - part 1: Update `IsIBusInSyncMode()` for the newer ibus r=m_kato\n\nibus added a new value, `2`, to `IBUS_ENABLE_SYNC_MODE` and only `1`\nis the synchronous mode. So, we need to update the logic here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314535\n", "files": ["widget/gtk/IMContextWrapper.cpp"], "git_node": "a5f2612c5cd24d547110d4347a4ea5109222eada", "git_parents": ["079065d33b0b788f93395938d10660927761dceb"], "node": "185cd893bb2790b30c37e9897c6f29abdf6ce6e5", "parents": ["1f4879f26c6cf87a18e67caee8addf782b776552"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2051354 - part 2: Improve Logging of `IMContextWrapper` r=m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314536\n", "files": ["widget/IMEData.cpp", "widget/IMEData.h", "widget/gtk/IMContextWrapper.cpp", "widget/gtk/IMContextWrapper.h", "widget/gtk/nsGtkKeyUtils.cpp"], "git_node": "b82d237369097f352d3b7548bab8fdcd484b8db7", "git_parents": ["a5f2612c5cd24d547110d4347a4ea5109222eada"], "node": "f966e53c65d650da089fe5833d20474033a525a1", "parents": ["185cd893bb2790b30c37e9897c6f29abdf6ce6e5"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2051354 - part 3: Make `KeymapWrapper::ComputeDOMKeyNameIndex` return `KEY_NAME_INDEX_USE_STRING` r=m_kato\n\nWe don't map any `keyval` values to `KEY_NAME_INDEX_USE_STRING` because\nthere are too big number of values which introduce text input.\nTherefore, we need to make it return `KEY_NAME_INDEX_USE_STRING` since\nit's unclear whether it won't return `KEY_NAME_INDEX_USE_STRING` and\nactually there are some wrong users. [1][2][3].\n\n1. https://searchfox.org/firefox-main/rev/3b3f727963c10fe58e6e72c15989ad0e35dbf832/widget/gtk/IMContextWrapper.cpp#1644-1645\n2. https://searchfox.org/firefox-main/rev/3b3f727963c10fe58e6e72c15989ad0e35dbf832/widget/gtk/IMContextWrapper.cpp#1756-1757\n3. https://searchfox.org/firefox-main/rev/3b3f727963c10fe58e6e72c15989ad0e35dbf832/widget/gtk/IMContextWrapper.cpp#1908-1909\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314537\n", "files": ["widget/gtk/nsGtkKeyUtils.cpp", "widget/gtk/nsGtkKeyUtils.h"], "git_node": "843ce87c23ebb72ed5d437bf23d03a30d57e5c5b", "git_parents": ["b82d237369097f352d3b7548bab8fdcd484b8db7"], "node": "db3137d210ef6840c0eabfa109f1ccfd1d22f2f8", "parents": ["f966e53c65d650da089fe5833d20474033a525a1"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2051354 - part 4: Relax to dispatch `eKeyPress` events for typing a grapheme cluster r=m_kato\n\nCurrently, we use `eKeyPress` event for a commit composition without\ncomposing state if:\n* the commit string is a non-BMP character\n* the commit string matches with the source key press event's `keyval`\n\nThe former was for a safe. We synthesized a set of composition events\nas its fallback. However, we stopped doing that in bug 1712269 for the\ncompatibility with Chromium and consistency with Firefox for macOS.\nHowever, on Linux, this case is used more frequently and the fallback\npath causes only `beforeinput` and `input` so that web apps may fail\nto handle that like Microsoft Word. Additionally, we already dispatch\nmultiple `eKeyPress` events after a `eKeyDown`. Therefore, we should\nuse the path for a grapheme cluster for the safe in these days.\n\nThe latter was for the safe. However, IIRC, some keyboard layouts\nimplemented with IME does not modify the keyboard layout but overrides\nwith the commit event without composing state. So, I think we don't need\nthis restriction now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314538\n", "files": ["widget/gtk/IMContextWrapper.cpp", "widget/gtk/IMContextWrapper.h", "widget/gtk/nsGtkKeyUtils.cpp", "widget/gtk/nsGtkKeyUtils.h"], "git_node": "1f58747dff10c8f95f38ec5e39d4ad65448a1370", "git_parents": ["843ce87c23ebb72ed5d437bf23d03a30d57e5c5b"], "node": "fb93d30348840fad6150fa7a0ba72cba2d6bc1e5", "parents": ["db3137d210ef6840c0eabfa109f1ccfd1d22f2f8"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2051354 - part 5: Support asynchronous IME handling of ibus better r=m_kato\n\nWe changed not to dispatch a set of composition events to commit a\ncharacter in bug 1712269 for the consistency with macOS and Chrome.\nHowever, the new behavior causes only `beforeinput` and `input`\nevents without any user input event except `Process` key value\nkeyboard events. That makes Microsoft Word fail to manage a text\ninput transaction for their undo manager.\n\nAdditionally, on Linux, this behavior is typically used by normal\ntyping of non-ASCII characters by ibus. Therefore, we should use\n`eKeyPress` more on Linux. Now, we do that if we receive a commit signal\nwithout composing state if and only if we're calling\n`gtk_im_context_filter_keypress()`. This is enough for Ubuntu and\nDebian users.\n\nHowever, surprisingly, ibus behaves differently in some environments\nwhen typing a character without composing state.\n\nBasically, it works as on Ubuntu and Debian:\n1. Filter the first `GDK_KEY_PRESS`\n2. Synthesize the same event as the filtered one\n3. While a call of `gtk_im_context_filter_keypress()`, send composition signals\n\nHowever, on Linux Mint:\n1. Filter the first `GDK_KEY_PRESS`\n2. Send composition signals\n\nSo, the copy of the first event is not sent as expected. Therefore, we\nneed to pick the `GDK_KEY_PRESS` event up from the copies of the first\nevents which were filtered by IME.\n\n(Even on Linux Mint, `GDK_KEY_RELEASE` events are handled with\nsynthesizing a copy of the first `GDK_KEY_RELEASE`.)\n\nHowever, in this case, we don't dispatch `eKeyPress` events because\nwe are not calling `gtk_im_context_filter_keypress()`. So, no fallback\n`eKeyPress` event dispatcher is not there.\n\nTo solve this issue, this patch makes `GDKEventKeyQueue` manages the\nfiltered event state with 3 states.\n1. Whether the synthesized event is received\n2. Whether a composition signal is received\n3. Whether the synthesized event is processed completely\n\nThen, `OnKeyEvent` considers whether the received event is unexpected\nsynthesized event which does not have `IBUS_IGNORED_MASK` flag with\nchecking whether it's not handled nor processed.\n\nEach composition signal mark the handling event or the oldest\nnon-processed `GDK_KEY_PRESS` event in the queue as handled.\n\n`OnKeyEvent` removes handled events from the queue if its synthesized\nevent hasn't been received but it's already been handled by a signal\nhandler.\n\nFinally, we should dispatch `eKeyPress` event if we receive a commit\nsignal without composing state even when it's not called during a call\nof `gtk_im_context_filter_keypress()`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314539\n", "files": ["widget/gtk/IMContextWrapper.cpp", "widget/gtk/IMContextWrapper.h", "widget/gtk/nsGtkKeyUtils.cpp", "widget/gtk/nsGtkKeyUtils.h"], "git_node": "c28639085ffd8b820d677b330c53654a5a0a2f72", "git_parents": ["1f58747dff10c8f95f38ec5e39d4ad65448a1370"], "node": "24c53f10b693d79c23f9a6696d2980a988a82ae8", "parents": ["fb93d30348840fad6150fa7a0ba72cba2d6bc1e5"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057130 - Validate principal and filter type properly; r=tschuster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315220\n", "files": ["dom/base/nsContentUtils.cpp", "dom/ipc/ContentParent.cpp", "widget/ClipboardWriteRequestParent.cpp"], "git_node": "0ef4372cc766ed0042139fc330f152ddfdb63ca2", "git_parents": ["c28639085ffd8b820d677b330c53654a5a0a2f72"], "node": "8dd505dc4d5ec60bcad03d345bdad724c5ae9805", "parents": ["24c53f10b693d79c23f9a6696d2980a988a82ae8"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 1: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314577\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "remote/shared/NetworkResponse.sys.mjs"], "git_node": "faca6ff8806493322fd7475aa2883708980aad30", "git_parents": ["0ef4372cc766ed0042139fc330f152ddfdb63ca2"], "node": "9849833191a600adcb7352720b47be3f09b4cb07", "parents": ["8dd505dc4d5ec60bcad03d345bdad724c5ae9805"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 2: Pre-calculate the fallback encoding for the classic script source. r=bthrall,dom-worker-reviewers,edenchuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314578\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/workers/ScriptLoader.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/script-charset-03.html.ini"], "git_node": "8d79d70e8ee7e53d225617ffdf95c0c4e6423aea", "git_parents": ["faca6ff8806493322fd7475aa2883708980aad30"], "node": "00fa9e48011859bae208bb1e31e7bd8c710ceae4", "parents": ["9849833191a600adcb7352720b47be3f09b4cb07"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 3: Use pre-calculated fallback encoding for the in-memory cache key. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314579\n", "files": ["dom/script/ScriptLoader.cpp", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "js/loader/LoadedScript.h"], "git_node": "3bc114b80d4575607576539533abb1a04f98770a", "git_parents": ["8d79d70e8ee7e53d225617ffdf95c0c4e6423aea"], "node": "3649973532222a34c700b0846c9af33c3e6000b6", "parents": ["00fa9e48011859bae208bb1e31e7bd8c710ceae4"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 4: Use pre-calculated fallback encoding for the classic script disk cache MIME-Type. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314580\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "35708466e6914e54d53fdb16942bc909ef5105ce", "git_parents": ["3bc114b80d4575607576539533abb1a04f98770a"], "node": "379ff19e04f9705f6c35f7f8171764babe25b0f7", "parents": ["3649973532222a34c700b0846c9af33c3e6000b6"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 5: Add tests. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314581\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset.js", "dom/base/test/head.js"], "git_node": "4db39a2b64d448be244a4ccb48c57d447660833a", "git_parents": ["35708466e6914e54d53fdb16942bc909ef5105ce"], "node": "162f0893cd051e7fb4e43e198a19cd6ccd6c966d", "parents": ["379ff19e04f9705f6c35f7f8171764babe25b0f7"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2056134: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/script/SharedScriptCache.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.h"], "git_node": "d30421a675d12cea73b89d0a1f02592303a505c0", "git_parents": ["4db39a2b64d448be244a4ccb48c57d447660833a"], "node": "fc4ebe759e6d6334371b7006e252831f82d786aa", "parents": ["162f0893cd051e7fb4e43e198a19cd6ccd6c966d"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056134: apply code formatting via Lando\" for causing bc failures at bc failures\n\nThis reverts commit d30421a675d12cea73b89d0a1f02592303a505c0.\n\nRevert \"Bug 2056134 - Part 5: Add tests. r=bthrall\"\n\nThis reverts commit 4db39a2b64d448be244a4ccb48c57d447660833a.\n\nRevert \"Bug 2056134 - Part 4: Use pre-calculated fallback encoding for the classic script disk cache MIME-Type. r=bthrall\"\n\nThis reverts commit 35708466e6914e54d53fdb16942bc909ef5105ce.\n\nRevert \"Bug 2056134 - Part 3: Use pre-calculated fallback encoding for the in-memory cache key. r=bthrall\"\n\nThis reverts commit 3bc114b80d4575607576539533abb1a04f98770a.\n\nRevert \"Bug 2056134 - Part 2: Pre-calculate the fallback encoding for the classic script source. r=bthrall,dom-worker-reviewers,edenchuang\"\n\nThis reverts commit 8d79d70e8ee7e53d225617ffdf95c0c4e6423aea.\n\nRevert \"Bug 2056134 - Part 1: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\"\n\nThis reverts commit faca6ff8806493322fd7475aa2883708980aad30.\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset.js", "dom/base/test/head.js", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "dom/workers/ScriptLoader.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "remote/shared/NetworkResponse.sys.mjs", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/script-charset-03.html.ini"], "git_node": "605c66370103e3088e7229b2e938c1e23319104c", "git_parents": ["d30421a675d12cea73b89d0a1f02592303a505c0"], "node": "512c288eb5204b33a69014908a38fc57b28656a9", "parents": ["fc4ebe759e6d6334371b7006e252831f82d786aa"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2057899. Fix test skip cond for browser_test_swipe_gesture.js. r=hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315265\n", "files": ["widget/tests/browser/browser.toml"], "git_node": "4b6ed767f4f3b4b0e11689201452295aa3d22e56", "git_parents": ["605c66370103e3088e7229b2e938c1e23319104c"], "node": "d6fc36d0fdba75e5a6152a4d67867c0e5366614e", "parents": ["512c288eb5204b33a69014908a38fc57b28656a9"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": [], "git_node": "fdd583cd5a10d051053acda8b760c3bd5d800034", "git_parents": ["1efbe2f75d8b32277a66c29b85b2c5061429cc08", "4b6ed767f4f3b4b0e11689201452295aa3d22e56"], "node": "47f3b1d601409c7cd2c5dee876eaef22b18ae9d5", "parents": ["59454fc602234d684e7ffe1fe482f0faa843caa2", "d6fc36d0fdba75e5a6152a4d67867c0e5366614e"], "tags": []}], "date": 1785488258, "git_changesets": ["a5f2612c5cd24d547110d4347a4ea5109222eada", "b82d237369097f35