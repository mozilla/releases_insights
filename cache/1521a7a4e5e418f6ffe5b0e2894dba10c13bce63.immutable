/renderer/mod.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/wrshell/src/gui/debug_flags.rs", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "73ed86f0893859e2205d98722107dcc8feccf158", "git_parents": ["f492222556f2a7514a26bb92d44c998a4f8b0612"], "node": "3bfa135aa146f7b1f28579f8cde7df54d30c1653", "parents": ["f841a8d35c29cd671cc0026bf62dfe938f910540"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057470 - Enable the render target init debugging flag for wrench reftest. r=gfx-reviewers,gw\n\nAlso add an option to enable it for other sub-commands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313978\n", "files": ["gfx/wr/wrench/src/args.yaml", "gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "67494d614fe37d9e5f8ba0e7a02a79b39fb21743", "git_parents": ["73ed86f0893859e2205d98722107dcc8feccf158"], "node": "171c5569b2e15bbd91bd92e3c2f768eb3e9549cf", "parents": ["3bfa135aa146f7b1f28579f8cde7df54d30c1653"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058204 - Import the Regression Engineering Owner (REO) documentation from wiki.mozilla.org r=overholt DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314405\n", "files": ["docs/bug-mgmt/processes/regression-engineering-owner.md"], "git_node": "50ec2b80d36de9d366c0364bf27a41499630d4ce", "git_parents": ["67494d614fe37d9e5f8ba0e7a02a79b39fb21743"], "node": "54e016096ff717ca8cf95f01da69bf48703faa37", "parents": ["171c5569b2e15bbd91bd92e3c2f768eb3e9549cf"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2058138 - enable bugprone-use-after-move and performance-unnecessary-copy-initialization in clang-tidy r=firefox-build-system-reviewers,ahochheiden\n\nbugprone-use-after-move catches reading an object after it has been moved from,\nwhich Coverity is currently the only thing reporting (it found several instances\nin bug 2058054). performance-unnecessary-copy-initialization catches locals that\nare copy-constructed from a const reference and never mutated.\n\nThe review bot only analyzes the submitted patch, so this reports on newly\nintroduced occurrences and does not flag existing code retroactively.\n\nTest cases were already present in tools/clang-tidy/test/ for both checkers;\n./mach static-analysis autotest passes for them unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314361\n", "files": ["tools/clang-tidy/config.yaml"], "git_node": "405e88bf82fa1ccd12fcabea7c7126f03d1aff79", "git_parents": ["50ec2b80d36de9d366c0364bf27a41499630d4ce"], "node": "ea2a3e6448e9cd4b3b2dd941d798928df6210729", "parents": ["54e016096ff717ca8cf95f01da69bf48703faa37"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058110 - Don't queue picture task if pictureness hasn't changed. r=edgar,dom-core-reviewers\n\nMatches the UnbindFromTree handling. I have another fix on top which is\na bit more annoying to test, but the test here should cover the broken\nwebsite.\n\nWithout this relevant-mutations.html fails the picture tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314436\n", "files": ["dom/html/HTMLImageElement.cpp", "dom/html/HTMLImageElement.h", "testing/web-platform/tests/html/semantics/embedded-content/the-img-element/support/relevant-mutations.js"], "git_node": "599e5b497192b84c3dd2a25cf5251b083d6c7875", "git_parents": ["405e88bf82fa1ccd12fcabea7c7126f03d1aff79"], "node": "849647ec8e104490821eb051d9f25fb82c6504d5", "parents": ["ea2a3e6448e9cd4b3b2dd941d798928df6210729"], "tags": []}, {"author": "Benjamin Beurdouche \u003cbbeurdouche@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055631 - Restore the wrapped_dek on-disk JSON key in the Lockstore keystore r=gerard-majax\n\nThe clippy pass in this bug renamed WrappedDek::wrapped_dek to\nWrappedDek::dek to satisfy struct_field_names. WrappedDek is persisted\nwith serde_json, so the rename also changed the on-disk JSON key: DEK\nmetadata written by any earlier build stores \"wrapped_dek\", the field\nhas no serde default, and load_metadata therefore fails with a\nmissing-field error. Every pre-existing keystore becomes unreadable.\n\nThat patch's own commit message stated the field would keep its name\nbecause it is the documented on-disk key, guarded by a scoped allow.\nOnly the rename landed.\n\nPin the serialized name back with #[serde(rename = \"wrapped_dek\")],\nkeeping the Rust field called dek so the clippy lint stays satisfied.\nRecords written from now on stay readable by builds from before the\nrename, and by the offline tooling that parses this format.\n\nRestore the two on-disk-layout doc references to the wire name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314318\n", "files": ["security/lockstore/lockstore_rs/src/keystore.rs"], "git_node": "0ff21613db3d5ac7bc310bb5785e09d3291a50a2", "git_parents": ["599e5b497192b84c3dd2a25cf5251b083d6c7875"], "node": "bccc2159e3d58c4ac94a03579b406fa9f2ffbbd1", "parents": ["849647ec8e104490821eb051d9f25fb82c6504d5"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047390 - Add quick fix suggestion to NoSystemCurrentTimeMillisDetector to offer default behaviour. r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314352\n", "files": ["mobile/android/android-components/components/tooling/lint/src/main/java/mozilla/components/tooling/lint/NoSystemCurrentTimeMillisDetector.kt", "mobile/android/android-components/components/tooling/lint/src/test/java/mozilla/components/tooling/lint/NoSystemCurrentTimeMillisDetectorTest.kt"], "git_node": "22bf22061015b621b02dd4df948c9c143c7ad4df", "git_parents": ["0ff21613db3d5ac7bc310bb5785e09d3291a50a2"], "node": "ec5c6133f3c1d26a4c3cc1fb5a90e4a38c3a292d", "parents": ["bccc2159e3d58c4ac94a03579b406fa9f2ffbbd1"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058127 - [devtools] Enable browser_browser_toolbox_fission_inspector.js for nova r=devtools-reviewers,nchevobbe\n\nDue to the rounded corner in nova we ended up clicking in the container instead of the button itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314509\n", "files": ["devtools/client/framework/browser-toolbox/test/browser.toml", "devtools/client/framework/browser-toolbox/test/browser_browser_toolbox_fission_inspector.js"], "git_node": "da3389ff4ee96368407fe4c8461a1158fe0c3a9b", "git_parents": ["22bf22061015b621b02dd4df948c9c143c7ad4df"], "node": "dd3973bfe902b7256d8fadb0689462b268db8361", "parents": ["ec5c6133f3c1d26a4c3cc1fb5a90e4a38c3a292d"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2057470 - Enable the render target init debugging flag for wrench reftest. r=gfx-reviewers,gw\" for casuing wrench failures @near-plane-clip.png.\n\nThis reverts commit 67494d614fe37d9e5f8ba0e7a02a79b39fb21743.\n\nRevert \"Bug 2057470 - Add a debug option for initializing renderable textures with opaque pink. r=gfx-reviewers,gw\"\n\nThis reverts commit 73ed86f0893859e2205d98722107dcc8feccf158.\n", "files": ["gfx/thebes/gfxPlatform.cpp", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/wrench/src/args.yaml", "gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/wrench.rs", "gfx/wr/wrshell/src/gui/debug_flags.rs", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "cd95c1d3c30385168a6ea76d494ec1e2fdcca6c6", "git_parents": ["da3389ff4ee96368407fe4c8461a1158fe0c3a9b"], "node": "bce12a4808e9d0b10e4821aeb84414d45515df58", "parents": ["dd3973bfe902b7256d8fadb0689462b268db8361"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058110 - Don't consider an image incomplete due to a non-alwaysLoad task. r=edgar,dom-core-reviewers\n\nThis would've also fixed the issue, and I think it's the right thing to\ndo. It's more annoying to test tho.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314435\n", "files": ["dom/base/nsImageLoadingContent.cpp", "dom/base/nsImageLoadingContent.h", "dom/html/HTMLImageElement.cpp", "dom/html/HTMLImageElement.h", "testing/web-platform/tests/html/semantics/embedded-content/the-img-element/environment-changes/picture-resize-complete.html"], "git_node": "26ee5665f273e5f362a5f77ffaaf72534792ddd6", "git_parents": ["cd95c1d3c30385168a6ea76d494ec1e2fdcca6c6"], "node": "4a669da0a1f9d7891ed912919d20834521630fda", "parents": ["bce12a4808e9d0b10e4821aeb84414d45515df58"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049244 - Turn .browserContainer into a CSS grid. r=desktop-theme-reviewers,tabbrowser-reviewers,devtools-reviewers,sfoster,ochameau,dao,jdescottes.\n\nThis makes the element layout more explicit and easier to work with.\nAs the DevTools splitter is turned into a grid area resizer, we need to handle\nthe DevTools frame max size so it doesn't grow bigger than its grid \"cell\".\n\nWhen the toolbox is docked to the side, it doesn't change much to what we\nhad before: the max width is contrained by the browser container width, so\nwe keep the resize observer on it, and update the max width (alongside the\nsplitter attributes aria-value(min|max)).\n\nWhen the toolbox is docked to the bottom, now we need to account for the possible\nitems that will be displayed and taking some vertical space:\n- the notifications (in split view)\n- the RDM toolbar\n- the \"Find in page\" toolbar\n\nSo here, we need to know when the browser container size is updated (e.g. when\nthe browser, or the split view, or one of the sidebar are resized), but also\nwhen we get additional items in the browser container.\nSadly we can't just use a MutationObserver on top of the ResizeObserver: for some\nof those items they don't actually have their final height when they're added\ninto the DOM, which makes it tricky to reason about the available space.\nSo we're taking another approach and detect when the browser container grid lines\nsized are updated. We're using a reflow observer and a debounced method to react\nwhen reflow occurs, and then compute some string representation of the grid lines\nheight using `getGridFragments`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311100\n", "files": ["browser/base/content/test/static/browser_parsable_css.js", "browser/components/tabbrowser/content/tabbrowser.js", "browser/themes/shared/browser-shared.css", "browser/themes/shared/tabbrowser/content-area.css", "devtools/client/framework/test/browser_toolbox_hosts_size.js", "devtools/client/framework/test/browser_toolbox_splitter_keyboard.js", "devtools/client/framework/toolbox-hosts.js", "devtools/client/responsive/responsive-browser.css", "devtools/client/themes/devtools-browser.css", "devtools/client/themes/splitters.css", "toolkit/content/widgets/tabbox.js", "toolkit/themes/shared/findbar.css"], "git_node": "b58cc53229fa19f1b01f4c00de32de32d8bc05a6", "git_parents": ["26ee5665f273e5f362a5f77ffaaf72534792ddd6"], "node": "c3c8adca189380c494d5f7a71153d5fee4b8361f", "parents": ["4a669da0a1f9d7891ed912919d20834521630fda"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038693 - [devtools] Use thick Nova borders for DevTools toolbox. r=devtools-reviewers,ochameau.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312253\n", "files": ["devtools/client/framework/test/browser_toolbox_hosts_size.js", "devtools/client/framework/test/browser_toolbox_splitter_keyboard.js", "devtools/client/inspector/markup/test/events/helper_events_test_runner.js", "devtools/client/shared/test/browser_html_tooltip-05.js", "devtools/client/shared/test/browser_html_tooltip_offset.js", "devtools/client/shared/test/browser_html_tooltip_rtl.js", "devtools/client/shared/test/browser_html_tooltip_variable-height.js", "devtools/client/themes/devtools-browser.css", "devtools/client/themes/splitters.css"], "git_node": "7f460a868215418798528b6e1da8e65b6745c6a4", "git_parents": ["b58cc53229fa19f1b01f4c00de32de32d8bc05a6"], "node": "97e167a2a1d5dbc5ece634cb665bfc3ff7d0ba79", "parents": ["c3c8adca189380c494d5f7a71153d5fee4b8361f"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055206 - Part 1: Do not attempt to refresh while in background r=ip-protection-reviewers,apopov\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313027\n", "files": ["toolkit/components/ipprotection/IPPLifecycleHelper.sys.mjs", "toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPPLifecycleHelper.js"], "git_node": "af04d2394c7f3eb1931b6d6a62d79fde2c1bbe3e", "git_parents": ["7f460a868215418798528b6e1da8e65b6745c6a4"], "node": "fad2923f8e4a882db213c9d0939223a6474bd1c8", "parents": ["97e167a2a1d5dbc5ece634cb665bfc3ff7d0ba79"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055206 - Part 2: Add individual timouts per fetch r=ip-protection-reviewers,apopov\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313028\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPProxyManager.js"], "git_node": "0f03c6dadeeb46d8e7b10b4cd76ab61c92cceb59", "git_parents": ["af04d2394c7f3eb1931b6d6a62d79fde2c1bbe3e"], "node": "9490d172aadc540919125099686a4d87ab22c50a", "parents": ["fad2923f8e4a882db213c9d0939223a6474bd1c8"], "tags": []}, {"author": "Sebastian Streich \u003csstreich@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055206 - Part 3: A forced rotation should reset the Proxy-Manager timer r=ip-protection-reviewers,apopov\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313029\n", "files": ["toolkit/components/ipprotection/IPPProxyManager.sys.mjs", "toolkit/components/ipprotection/tests/xpcshell/test_IPPLifecycleHelper.js"], "git_node": "4c14872ebedc309fbc653fdf5ee1b3e4097ae8d9", "git_parents": ["0f03c6dadeeb46d8e7b10b4cd76ab61c92cceb59"], "node": "c4f81502f0a92a021dcbfbeca804149a62894f92", "parents": ["9490d172aadc540919125099686a4d87ab22c50a"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2014365: Add test case. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283658\n", "files": ["js/src/jit-test/tests/typedarray/subarray-scalar-replace-minorgc.js"], "git_node": "61ff36f7fca4ee13be0ed989854c365a33743955", "git_parents": ["4c14872ebedc309fbc653fdf5ee1b3e4097ae8d9"], "node": "1c3d3a62f38acd5a5511b8bbf2a050ea4a124e38", "parents": ["c4f81502f0a92a021dcbfbeca804149a62894f92"], "tags": []}, {"author": "Andr\u00e9 Bargull \u003candre.bargull@gmail.com\u003e", "branch": "default", "desc": "Bug 2018592: Add test case. r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D284449\n", "files": ["js/src/jit-test/tests/typedarray/resizable-typedarray-transfer-zeroed.js"], "git_node": "737ab172e978859f7d168634abd12cdc97f127a9", "git_parents": ["61ff36f7fca4ee13be0ed989854c365a33743955"], "node": "6941efaa00cc9056c9c354974e391e8e3e1f663f", "parents": ["1c3d3a62f38acd5a5511b8bbf2a050ea4a124e38"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052246 - Part 1. Implement swizzling operations using xsimd generics. r=gfx-reviewers,lsalzman\n\nThis provides the base implementation for all of our swizzling\noperations. Later patches in this series will provide\nspecializations where xsimd falls short for particular targets.\n\nThis should however be a good baseline for any future additions.\n\nNote that this also provides some notable improvements:\n\n- Unrolling pure swizzles to match clang behaviour/performance from\n  the fallback methods. This can modestly or dramatically speed up\n  swizzling even with the same intrinsic sets.\n\n- Teach unpacking how to load/store remainders instead of calling\n  the fallback method to handle them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314160\n", "files": ["gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleGeneric.h", "gfx/2d/SwizzleGenericDecls.h", "gfx/2d/SwizzleHelpers.h", "gfx/2d/moz.build", "gfx/tests/gtest/SwizzleGeneric.cpp", "gfx/tests/gtest/TestSwizzle.cpp", "gfx/tests/gtest/moz.build"], "git_node": "f51aafa39462af4b938f5985cb6c10d99b2044fd", "git_parents": ["737ab172e978859f7d168634abd12cdc97f127a9"], "node": "39e9039a6309ca2e70969659c54844781b7329a0", "parents": ["6941efaa00cc9056c9c354974e391e8e3e1f663f"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052246 - Part 2. Specialize xsimd templates for optimal NEON performance. r=gfx-reviewers,lsalzman\n\nThis mostly pulls from our existing hand written NEON instrinsics.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314161\n", "files": ["gfx/2d/SwizzleNEON.h"], "git_node": "3f06dd5f252eb21c1946edd44e8f203f125164e2", "git_parents": ["f51aafa39462af4b938f5985cb6c10d99b2044fd"], "node": "10ed2c44ab7605415212c98078c1aadd65fcd29d", "parents": ["39e9039a6309ca2e70969659c54844781b7329a0"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052246 - Part 3. Specialize xsimd templates for optimal SSE2/SSSE3/AVX2 performance. r=gfx-reviewers,lsalzman\n\nThis mostly pulls from our existing hand written NEON instrinsics.\nIt does add new ones where necessary for SSSE3 and AVX2.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314162\n", "files": ["gfx/2d/SwizzleSSE2.h"], "git_node": "12088cd2d7cf18df13bf3dcc2b6b057558e51bb6", "git_parents": ["3f06dd5f252eb21c1946edd44e8f203f125164e2"], "node": "9667534f88b631dff7350950487cff7634f9321c", "parents": ["10ed2c44ab7605415212c98078c1aadd65fcd29d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052246 - Part 4. Switch existing NEON/SSE2/SSSE3/AVX2 implementations to the generics. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314163\n", "files": ["gfx/2d/SwizzleAVX2.cpp", "gfx/2d/SwizzleNEON.cpp", "gfx/2d/SwizzleSSE2.cpp", "gfx/2d/SwizzleSSSE3.cpp"], "git_node": "26956c1802bf28ba43b571f6f4fbc22f7e9029a8", "git_parents": ["12088cd2d7cf18df13bf3dcc2b6b057558e51bb6"], "node": "b4f6b239b2805151c75de836ab87999f52bfab2c", "parents": ["9667534f88b631dff7350950487cff7634f9321c"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052246 - Part 5. Expose missing SSSE3/AVX2 implementations for swizzling operations. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314164\n", "files": ["gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleAVX2.cpp", "gfx/2d/SwizzleSSSE3.cpp"], "git_node": "a8a506caed7dae51dffae3e6bfefcb72b2872e7d", "git_parents": ["26956c1802bf28ba43b571f6f4fbc22f7e9029a8"], "node": "2f4351c3db4abecb8f3e5dc6d122d8b1ba67dbb9", "parents": ["b4f6b239b2805151c75de836ab87999f52bfab2c"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2052246: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/tests/gtest/SwizzleGeneric.cpp"], "git_node": "97322d6b8afaa243f2f7d40b28b4dc796e111065", "git_parents": ["a8a506caed7dae51dffae3e6bfefcb72b2872e7d"], "node": "5786720b59a7aec97054c460b4005ade7bfadf30", "parents": ["2f4351c3db4abecb8f3e5dc6d122d8b1ba67dbb9"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056444 - Fetch same-process blob URL data directly instead of over IPC. r=asuth\n\nA Blob backed by in-process memory (e.g. built from an ArrayBuffer) exposes a\nseekable input stream locally. Routing its data through the parent turned it\ninto a forward-only pipe, so a media element seeking near the end of the blob\nhad to read and discard everything before the target offset, hanging.\n\nFetch the blob data from this process's own BlobURLProtocolHandler store when\nthe entry is present (which it is for blobs owned by this process), keeping the\nstream seekable. Blobs owned by another process are still fetched over IPC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314001\n", "files": ["dom/file/uri/BlobURLInputStream.cpp"], "git_node": "792d277144a582cfb7ebf9da79f3e003611f34e1", "git_parents": ["97322d6b8afaa243f2f7d40b28b4dc796e111065"], "node": "034d7feeaf9fce6a165aea81a87da10d48d6e26b", "parents": ["5786720b59a7aec97054c460b4005ade7bfadf30"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2056444 - Add a regression test for playing a video from a Blob rebuilt from an ArrayBuffer. r=media-playback-reviewers,alwu\n\nBased on https://github.com/Vincent0700/firefox-arraybuffer-blob-video-repro :\na Blob constructed from an ArrayBuffer (rather than obtained directly via\nResponse.blob()) went through the same RemoteLazyInputStream-backed,\nasync-over-IPC path as any other Blob, so it hit the same playback bug as\nthe Blob URL case already covered by test_temporary_file_blob_video_plays.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313277\n", "files": ["dom/media/test/mochitest.toml", "dom/media/test/test_blob_from_arraybuffer_video_plays.html"], "git_node": "4160579351d772f3a8a9f793e131d417e676a94e", "git_parents": ["792d277144a582cfb7ebf9da79f3e003611f34e1"], "node": "93f086e6a61655b5f59a7c76e5b3833076685298", "parents": ["034d7feeaf9fce6a165aea81a87da10d48d6e26b"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2056444 - Add a regression test for decoding and seeking a Blob read from CacheStorage. r=media-playback-reviewers,alwu\n\nBased on a testcase in the bug: a Blob handed out by CacheStorage is not\nbacked by memory this process owns, so it is read asynchronously over\nIPC. Reading it back as an ArrayBuffer and decoding it with\ndecodeAudioData used to hang, and so did seeking close to the end of the\nre-encoded WAV shortly after canplaythrough, with two elements sharing\nthe data.\n\nThe WAV is padded with a 1kHz tone, like in the reporter's application, so that it\nexceeds the 1MB IPC inline serialization limit and the far seek is meaningful.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314416\n", "files": ["dom/media/test/mochitest.toml", "dom/media/test/test_blob_from_cachestorage_audio_seeks.html"], "git_node": "a4f4bd65656d014492500bb1b87c95d9a8195c44", "git_parents": ["4160579351d772f3a8a9f793e131d417e676a94e"], "node": "989f62bd9f88002775ae7cb49704b6a76a366b91", "parents": ["93f086e6a61655b5f59a7c76e5b3833076685298"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2058134 - Use HasAuthorSpecifiedBorderBackground() rather than background alpha. r=jjaschke\n\nThis matches what we do for ::target-text. This shouldn't regress\nbug 2043232 (which uses background-color: revert) because that doesn't\ncount as author-specified.\n\nWe couldn't do this when I wrote the regressing bug because of the\nborder-radius support that nova had, but that has been reverted since.\nArguably, we should split the border-background bit, maybe...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314607\n", "files": ["layout/generic/nsTextPaintStyle.cpp", "testing/web-platform/tests/css/css-pseudo/selection-background-color-revert-ref.html", "testing/web-platform/tests/css/css-pseudo/selection-background-color-revert.html", "testing/web-platform/tests/css/css-pseudo/selection-background-color-transparent-notref.html", "testing/web-platform/tests/css/css-pseudo/selection-background-color-transparent.html"], "git_node": "fe629a3d61c58f36cdc028d9ca695105c5b75b32", "git_parents": ["a4f4bd65656d014492500bb1b87c95d9a8195c44"], "node": "19242f0d1d5792c30b74e3601bf64503b478cd57", "parents": ["989f62bd9f88002775ae7cb49704b6a76a366b91"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045883 - Migrate gtest from macosx1470-64 to macosx1500-aarch64 r=aryx\n\nCo-Authored-By: Claude Opus 4.8 (1M context) \u003cnoreply@anthropic.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314612\n", "files": ["taskcluster/test_configs/test-sets.yml"], "git_node": "7cb6338e6847f8940c4857c37cbe93a9a3e466ed", "git_parents": ["fe629a3d61c58f36cdc028d9ca695105c5b75b32"], "node": "057743c34aee1cf534ea06bbd192ab4b625faf66", "parents": ["19242f0d1d5792c30b74e3601bf64503b478cd57"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058394 - Update android nightly application-services version bump to fb7a075c21d80776445a52720472546a9e5e223a r=release-managers,dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314576\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "d66b10dda526a3e1f826fcab3546f2e238f593b8", "git_parents": ["7cb6338e6847f8940c4857c37cbe93a9a3e466ed"], "node": "e7f032ec4de7d5313778a237b2cca16a308ed7b8", "parents": ["057743c34aee1cf534ea06bbd192ab4b625faf66"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2058369 - Fix registerImportMap crash. r=arai\n\nIn a document, if the first module has been cached, the DisallowImportMaps\nwon't be called (normally this is done in `StartFetch`[1]).\n\nThis fixes the problem by calling DisallowImportMaps if the module request is\nserved from the cache.\n\n[1]: https://searchfox.org/firefox-main/rev/4b4e59946a3db5ddf42ea730fc44c22a99877303/dom/script/ModuleLoader.cpp#137\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314558\n", "files": ["dom/base/test/jsmodules/importmaps/memory_cached_module.mjs", "dom/base/test/jsmodules/importmaps/memory_cached_module.mjs^headers^", "dom/base/test/jsmodules/importmaps/memory_cached_module_mapped.mjs", "dom/base/test/jsmodules/importmaps/mochitest.toml", "dom/base/test/jsmodules/importmaps/test_importMap_after_memory_cached_module.html", "dom/script/ModuleLoader.cpp", "dom/script/ModuleLoader.h"], "git_node": "23007707228b9a6cf215015ae372c7a5df8582a4", "git_parents": ["d66b10dda526a3e1f826fcab3546f2e238f593b8"], "node": "3d1984ea702a9e7c176e2da14d3a97f4fea10cf0", "parents": ["e7f032ec4de7d5313778a237b2cca16a308ed7b8"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 1974213 - Only allow untrusted schemes in Services.scriptloader.loadSubScript(WithOptions) with an explicit opt-in. r=arai,necko-reviewers,webcompat-reviewers,devtools-reviewers,sync-reviewers,twisniewski,ochameau,jesup,robwu,profiler-reviewers,canova,Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313017\n", "files": ["browser/components/places/tests/unit/head_bookmarks.js", "browser/extensions/webcompat/tests/browser/browser_interventions.js", "devtools/client/debugger/test/mochitest/integration/head.js", "devtools/client/shared/test/shared-head.js", "devtools/server/tests/xpcshell/head_dbg.js", "devtools/server/tests/xpcshell/test_setBreakpoint-at-the-beginning-of-a-minified-fn.js", "devtools/server/tests/xpcshell/test_setBreakpoint-at-the-end-of-a-minified-fn.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-column-in-gcd-script.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-column.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-in-gcd-script.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-multiple-offsets.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-multiple-statements.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line-with-no-offsets.js", "devtools/server/tests/xpcshell/test_setBreakpoint-on-line.js", "devtools/server/tests/xpcshell/test_source-03.js", "devtools/server/tests/xpcshell/test_source-04.js", "dom/indexedDB/test/unit/test_globalObjects_other.js", "dom/localstorage/test/unit/head.js", "dom/quota/test/modules/system/ModuleLoader.sys.mjs", "dom/quota/test/xpcshell/caching/head.js", "dom/quota/test/xpcshell/head.js", "dom/quota/test/xpcshell/telemetry/head.js", "dom/quota/test/xpcshell/upgrades/head.js", "js/xpconnect/idl/mozIJSSubScriptLoader.idl", "js/xpconnect/loader/mozJSSubScriptLoader.cpp", "js/xpconnect/tests/chrome/subscript.js", "js/xpconnect/tests/chrome/test_chrometoSource.xhtml", "js/xpconnect/tests/unit/test_bug451678.js", "js/xpconnect/tests/unit/test_subScriptLoader.js", "modules/libpref/init/StaticPrefList.yaml", "netwerk/test/httpserver/httpd.sys.mjs", "netwerk/test/unit/test_psl.js", "services/sync/tests/unit/head_helpers.js", "services/sync/tps/extensions/tps/resource/tps.sys.mjs", "testing/talos/talos/tests/tart/addon/api.js", "testing/talos/talos/tests/tresize/addon/api.js", "toolkit/actors/PictureInPictureChild.sys.mjs", "toolkit/components/downloads/test/unit/test_DownloadCore.js", "toolkit/components/downloads/test/unit/test_DownloadLegacy.js", "toolkit/components/extensions/ExtensionCommon.sys.mjs", "toolkit/components/extensions/test/xpcshell/t