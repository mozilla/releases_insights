f734f26e1bae25b", "git_parents": ["74d2fbfaa62e91e9268bc99b6fc485d338b0ef6d"], "node": "dcd6c503efa096317ad0375b4a91a83055c2267e", "parents": ["9c9063cadff8c7fca1b7a66589e9e1d639409f79"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061762 - Move getTokenMatches from UrlbarUtils to UrlbarShared. r=daleharvey\n\nA behavior-neutral relocation with no forwarder left behind: the matching is\npure string work over UrlbarShared's own HIGHLIGHT and MAX_TEXT_LENGTH\nconstants, so it belongs in the module content code can import, letting\nUrlbarResult stop reaching into UrlbarUtils for it.\n\nWorth verifying that the body is unchanged and that every caller moved.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317204\n", "files": ["browser/components/urlbar/QuickSuggest.sys.mjs", "browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/L10nCache.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/unit/test_UrlbarShared_getTokenMatches.js", "browser/components/urlbar/tests/unit/test_UrlbarUtils_getTokenMatches.js", "browser/components/urlbar/tests/unit/xpcshell.toml"], "git_node": "21988340b498e815afc8de1103e5cada7fa5f4b4", "git_parents": ["26826ccc22b490e67653a532bf734f26e1bae25b"], "node": "b440f092a832eee25546d678438d3a434534149f", "parents": ["dcd6c503efa096317ad0375b4a91a83055c2267e"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2061521 - Fix net::HasRootDomain r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317054\n", "files": ["netwerk/base/nsNetUtil.cpp", "netwerk/dns/nsIEffectiveTLDService.idl"], "git_node": "846b6f3c207468908999be094a320198ae83b1b5", "git_parents": ["21988340b498e815afc8de1103e5cada7fa5f4b4"], "node": "c6345ab5ea33de5e99b42eff04c874cf69975794", "parents": ["b440f092a832eee25546d678438d3a434534149f"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2061749 - Fix RiscV64 Spidermonkey breakage caused by bug 2052811.  r=csmantle.\n\nBug 2052811 introduced infrastructural changes relating to management of wasm\nTrapSites.  One of these is a new requirement, that registration of a TrapSite\n(via `masm.appendAndVerify(..)`) must happen after the related instruction has\nbeen emitted into `masm`.  This is so that `appendAndVerify` can inspect the\nemitted bytes.\n\nIn various cases, on various targets, that wasn't the case.  Bug 2052811 fixed\nthis for the 4 primary targets (x86_{32,64}, arm_{32,64}).  This bug adds the\nfixes for RiscV64.  Changes:\n\n* for various RiscV64 macroassembler methods, move the registration of a\n  stackmap (`masm.appendAndVerify(..)`) to after emission of the relevant\n  instruction.  Note that the instruction's offset is captured using `auto\n  before = masm.currentOffset();`, and that this *must* appear in the area\n  protected by a preceding `AutoForbidPoolsAndNops`.\n\n* a couple of (incorrect) wasm::TrapMachineInsn::Atomic annotations were\n  changed to ::Load{32,64}.\n\n* ridealong: TrapSitesForKind::checkInvariants: enable checking on RiscV64.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317106\n", "files": ["js/src/jit/riscv64/MacroAssembler-riscv64.cpp", "js/src/wasm/WasmCodegenTypes.cpp"], "git_node": "9ec5746ad8599c4f5f664f1848522d6fa662e214", "git_parents": ["846b6f3c207468908999be094a320198ae83b1b5"], "node": "bb53c31731af130afa64a4a4ce0ebe43d3a56bb5", "parents": ["c6345ab5ea33de5e99b42eff04c874cf69975794"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056175 - [devtools] Get the source content for a resource directly from the target r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312973\n", "files": ["devtools/client/debugger/src/actions/sources/loadSourceText.js", "devtools/client/debugger/src/actions/tests/helpers/mockCommandClient.js", "devtools/client/debugger/src/client/firefox/commands.js", "devtools/client/fronts/targets/target-mixin.js"], "git_node": "14be4b35b1e3d37a52e83ee1ec617148f951ab3a", "git_parents": ["9ec5746ad8599c4f5f664f1848522d6fa662e214"], "node": "2c1a3bd30dc7d31425df00164cf8c38ad3484b70", "parents": ["bb53c31731af130afa64a4a4ce0ebe43d3a56bb5"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061104 - Use default moz-button styling for the New Nova Themes picker Install/Enable/Disable button. r=willdurand\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316773\n", "files": ["toolkit/mozapps/extensions/content/components/aboutaddons-themes-picker.mjs"], "git_node": "3b67cdc7edab202c9e56e155d711b5f3f739d987", "git_parents": ["14be4b35b1e3d37a52e83ee1ec617148f951ab3a"], "node": "b7742373874cfb6d34f09fc776a04123727eb0a4", "parents": ["2c1a3bd30dc7d31425df00164cf8c38ad3484b70"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 1304594 - Build the normalized IPv4 string without nsPrintfCString. r=necko-reviewers,jesup\n\nThe format is fixed, so the printf machinery is all overhead: it reparses\nthe format string and builds a NumArgState vector on every call. In a\nparent-process profile of bug 1965181 the nsPrintfCString is 153 of\nNormalizeIPv4's 227 samples, against 48 for the parsing and validation it\nexists to serialize.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317297\n", "files": ["netwerk/base/IPv4Parser.cpp"], "git_node": "a450b55175c3340072cf108cb2ace43846147325", "git_parents": ["3b67cdc7edab202c9e56e155d711b5f3f739d987"], "node": "f0b5632ba1890e20a452fe0e3d9a057a197988a0", "parents": ["b7742373874cfb6d34f09fc776a04123727eb0a4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2062023 - Disable the launch on login infobar in browser_suppressTips.js so it doesn't suppress the search tip, r=urlbar-reviewers,daleharvey.\n\nThe updateApplied task's about:newtab load triggers the ASRouter\nINFOBAR_LAUNCH_ON_LOGIN infobar, which is global and so survives the tab\nclosing. UrlbarProviderSearchTips then refuses to open the view while\ngNotificationBox has a notification, so profileAge waits for a tip that never\nappears and the file times out after 15 minutes.\n\nbrowser.urlbar.searchTips.test.ignoreShowLimits would also make the test pass,\nbut it bypasses the hoursSinceUpdate check this test exists to verify.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317314\n", "files": ["browser/components/urlbar/tests/browser-tips/suppress-tips/browser.toml"], "git_node": "f699c2417526d706af175d95c83f681688576671", "git_parents": ["a450b55175c3340072cf108cb2ace43846147325"], "node": "14e421c164b6e04f29bd142af3a8e039f56a0d6d", "parents": ["f0b5632ba1890e20a452fe0e3d9a057a197988a0"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060538 - Stop using iframes in chrome documents for a11y tests. r=accessibility-platform-reviewers,eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316512\n", "files": ["accessible/tests/browser/e10s/browser_caching_states.js", "accessible/tests/browser/fission/browser_take_focus.js", "accessible/tests/browser/name_and_description/browser_name_general.js", "accessible/tests/browser/pivot/browser.toml", "accessible/tests/browser/pivot/browser_pivot.js", "accessible/tests/browser/pivot/doc_pivot.html", "accessible/tests/browser/pivot/doc_pivot_embedded.html"], "git_node": "0be354a847e697a4d53c94553a14660e9820fdfe", "git_parents": ["f699c2417526d706af175d95c83f681688576671"], "node": "f24d87602244b8fa510442f22216a843d4d0df34", "parents": ["14e421c164b6e04f29bd142af3a8e039f56a0d6d"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060538 - Add frame-src and object-src to the browser.xhtml's CSP. r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316275\n", "files": ["browser/base/content/browser.xhtml", "browser/base/content/hiddenWindowMac.xhtml", "browser/components/customizableui/test/browser.toml", "browser/components/customizableui/test/browser_PanelMultiView_keyboard.js", "browser/components/customizableui/test/file_embedded_document.html", "testing/mochitest/browser-test.js"], "git_node": "aa280f7ca67e78337e00bb0565829b3bdd687cb4", "git_parents": ["0be354a847e697a4d53c94553a14660e9820fdfe"], "node": "89e9a54e04a3eb836719dcacf116a98fe41ce7c9", "parents": ["f24d87602244b8fa510442f22216a843d4d0df34"], "tags": []}, {"author": "Nina Pypchenko \u003cnpypchenko@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061072 - Focus Timer widget: make the small size available in the context menu r=joel\n\nSmall was already a valid widget size but unavailable in the \"Change size\" submenu;\nthis adds it alongside medium and large. Selecting it now records a change_size\ntelemetry event carrying the \"small\" size, which the menu could not produce before.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316709\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/FocusTimer/FocusTimer.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/FocusTimer.test.jsx", "browser/extensions/newtab/test/unit/content-src/components/Widgets/FocusTimer.test.jsx"], "git_node": "f9f23f5886f79aff9c2d92dab51243e52584a5aa", "git_parents": ["aa280f7ca67e78337e00bb0565829b3bdd687cb4"], "node": "70f578d97cd66d11f947d78537f79fd4372f7616", "parents": ["89e9a54e04a3eb836719dcacf116a98fe41ce7c9"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1898891 - Use 204 returning captive portal endpoint r=necko-reviewers,kershaw,extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D209782\n", "files": ["modules/libpref/init/all.js", "netwerk/docs/captive_portals.md", "netwerk/test/unit/test_captive_portal_service.js", "netwerk/test/unit/test_lna_captive_portal.js", "toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/extensions/test/xpcshell/test_ext_captivePortal.js"], "git_node": "9686c7a6c9150249b5080d1631d509fffac23bc1", "git_parents": ["f9f23f5886f79aff9c2d92dab51243e52584a5aa"], "node": "fe2c6ddcc4bc28d5495a0d79ea07009d7e5d4427", "parents": ["70f578d97cd66d11f947d78537f79fd4372f7616"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2049252 - Move captive portal detection to new domain (firefox-portal-detection.com) r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316806\n", "files": ["modules/libpref/init/all.js"], "git_node": "0c0064798418e9b4c6b3363cae0ca75737655c64", "git_parents": ["9686c7a6c9150249b5080d1631d509fffac23bc1"], "node": "b99f279dd43905e4375cd05f33f798d0eadc0c07", "parents": ["fe2c6ddcc4bc28d5495a0d79ea07009d7e5d4427"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053743 - Add use counters for FileSystemHandle::move. r=smaug,webidl,edgar,saschanaz\n\nExtends the WebIDL bindings codegen to support [UseCounter=PerOverload],\nwhich generates per-signature use counter names by appending argument\ntype names. This is used to add separate counters for the three\nFileSystemHandle.move() overloads (rename, move-to-parent,\nmove-and-rename), a counter for file handle moves specifically, and a\nheuristic counter for the stringified-object footgun.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313681\n", "files": ["dom/base/UseCounters.conf", "dom/base/UseCountersWorker.conf", "dom/base/use_counter_metrics.yaml", "dom/base/usecounters.py", "dom/bindings/Codegen.py", "dom/bindings/parser/WebIDL.py", "dom/docs/use-counters.md", "dom/fs/api/FileSystemHandle.cpp", "dom/fs/api/FileSystemHandle.h", "dom/webidl/FileSystemHandle.webidl"], "git_node": "546b6eb4118af08a2ede983f9403606f8a183100", "git_parents": ["0c0064798418e9b4c6b3363cae0ca75737655c64"], "node": "18b862e23f0a8b1cc14c70a33db73540bb8038a7", "parents": ["b99f279dd43905e4375cd05f33f798d0eadc0c07"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059235 -  Skip Happy Eyeballs for Alt-Svc validation behind a proxy, r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315321\n", "files": ["netwerk/protocol/http/AlternateServices.cpp", "netwerk/test/httpserver/NodeServer.sys.mjs", "netwerk/test/unit/test_altsvc_proxy_dns_leak.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "6d1b432826fec23c46a4818a12e0a46416d84114", "git_parents": ["546b6eb4118af08a2ede983f9403606f8a183100"], "node": "1f901c5472327062c306dd0604678203fdf41475", "parents": ["18b862e23f0a8b1cc14c70a33db73540bb8038a7"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060905 - Migrate installPWAFromTheMainMenuTest UI test to the efficiency framework r=jajohnson\n\nConverted the installPWAFromTheMainMenuTest UI test to the efficiency framework.\n\n Moved the \"Add to Home screen\" prompt handling from a per-test flag into the harness:\n  - OverlayRegistry.kt \u2014 added ADD_TO_HOME_SCREEN_PROMPT (presence + dismiss both cancel_button, side-effect-free.\n\nRetested LoginsTest#verifyMultipleLoginsSelectionsTest and LoginsTest#verifyUpdatedLoginIsSavedTest.\n\nAll 3 UI tests successfully passed 50x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=76274  | try ]]\n\nAll efficiency UI test successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=76273  | try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316743\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/PwaTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/OverlayRegistry.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/LaunchConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/MainMenuSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/PWASelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/PWATest.kt"], "git_node": "6d8cc5305899a37c7cd8455c807366f6e6915083", "git_parents": ["6d1b432826fec23c46a4818a12e0a46416d84114"], "node": "6078989fe6333ab6912bb60fd9b49a784b37ba83", "parents": ["1f901c5472327062c306dd0604678203fdf41475"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061918 - CookieStore API breaks when used in a service worker running in its own content process, r=valentin,cookie-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317238\n", "files": ["dom/cookiestore/CookieStoreParent.cpp", "netwerk/cookie/test/browser/browser.toml", "netwerk/cookie/test/browser/browser_cookieStore_serviceWorker.js", "netwerk/cookie/test/browser/serviceWorker.js"], "git_node": "d0394ac3eafd8df0e5ff80b4b13a4d931587550a", "git_parents": ["6d8cc5305899a37c7cd8455c807366f6e6915083"], "node": "f935aea0e287ee3ae1ec0278ecdfa9ef1bab0c12", "parents": ["6078989fe6333ab6912bb60fd9b49a784b37ba83"], "tags": []}, {"author": "Andrea Marchesini \u00