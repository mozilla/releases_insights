ers,tabbrowser-reviewers,jules,fchasen,nsharpley,dao,urlbar-reviewers\n\nAdds popup tokens, fixes for tokens that are now in Figma.\n\nWe're adding some dialog-specific tokens here so we had to change some tokens around in Figma. Running the import script to make sure everything is up to date to ensure the changes will be clearer later in the stack.\n\nThis integrates hjones' changes from https://phabricator.services.mozilla.com/D310150\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312193\n", "files": ["browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/extensions/newtab/css/activity-stream.css", "browser/extensions/newtab/css/nova/activity-stream.css", "browser/themes/addons/moz.build", "browser/themes/shared/tabbrowser/tab.nova.tokens.json", "browser/themes/shared/tabbrowser/tab.tokens.css", "browser/themes/shared/urlbar/urlbar.nova.tokens.json", "browser/themes/shared/urlbar/urlbar.tokens.css", "toolkit/content/widgets/moz-input-color/moz-input-color.nova.tokens.json", "toolkit/content/widgets/moz-input-color/moz-input-color.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.nova.tokens.json", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.css", "toolkit/content/widgets/moz-message-bar/moz-message-bar.tokens.json", "toolkit/content/widgets/moz-select/moz-select.nova.tokens.json", "toolkit/content/widgets/moz-select/moz-select.tokens.css", "toolkit/content/widgets/moz-select/moz-select.tokens.json", "toolkit/content/widgets/moz-toggle/moz-toggle.nova.tokens.json", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.css", "toolkit/themes/shared/design-system/config/tokens-config.js", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/src/figma-import.mjs", "toolkit/themes/shared/design-system/src/nova-export-clean-variables.json", "toolkit/themes/shared/design-system/src/tokens/base/border.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/button.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/panel-menuitem.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/panel.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/popup.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/popup.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.nova.tokens.json"], "git_node": "38b21aa77081c850d1abe3df1169b5ae181fa323", "git_parents": ["d28e717583055bfcb1ac5df8eabf3a95eaf39af1"], "node": "a7d2d7ebeb5533cbc5b521760918a5397d855938", "parents": ["88eda7e61d3c1c404df13f34154f97da1122d53d"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054953 - Part 2: Fix privatewindow tab border color selected r=sfoster,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312194\n", "files": ["browser/themes/addons/privatewindow/manifest.in.json"], "git_node": "2fb1ebec26be9bf4899884b6c346a62e7771bcf7", "git_parents": ["38b21aa77081c850d1abe3df1169b5ae181fa323"], "node": "a1db92c52fd22c06c75214bda53028c59dcf10d5", "parents": ["a7d2d7ebeb5533cbc5b521760918a5397d855938"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 1959210 - Reduce the amount of cookie data sent via IPC r=manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313056\n", "files": ["dom/cookiestore/CookieStore.cpp", "dom/cookiestore/CookieStoreParent.cpp", "dom/cookiestore/CookieStoreParent.h", "dom/cookiestore/PCookieStore.ipdl"], "git_node": "bb3a219d9418bce97cd8e6151e68c85d0e04c7b9", "git_parents": ["2fb1ebec26be9bf4899884b6c346a62e7771bcf7"], "node": "c68d75d797c5305bdca64fb72d8ddf1ced6c3fff", "parents": ["a1db92c52fd22c06c75214bda53028c59dcf10d5"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054407 - Restyle the container stroke indicator on tabs, r=emilio,desktop-theme-reviewers,tabbrowser-reviewers,sclements\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311766\n", "files": ["browser/components/contextualidentity/content/usercontext.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "98d899cdec1d44b7f6128b0f18e310b7d613f42f", "git_parents": ["bb3a219d9418bce97cd8e6151e68c85d0e04c7b9"], "node": "fd9bf6d5a5a05b7ea908933fdbb38e4fd5efe4d2", "parents": ["c68d75d797c5305bdca64fb72d8ddf1ced6c3fff"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2055544 - Add a doc that explains Phabricator vs GitHub development flows r=thasan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312496\n", "files": ["docs/contributing/index.md", "docs/contributing/phabricator_vs_github.md", "docs/contributing/stack_quickref.md"], "git_node": "981be688fe87852c306f332ac58d40cc38820675", "git_parents": ["98d899cdec1d44b7f6128b0f18e310b7d613f42f"], "node": "20b2100a1075117745964095c37024d41fe66627", "parents": ["fd9bf6d5a5a05b7ea908933fdbb38e4fd5efe4d2"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2056038 - Update SET_PREF allowed prefs list with pref for 'also open a new tab' on restore r=omc-reviewers,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313015\n", "files": ["toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs"], "git_node": "81967326c9e1c5181da488eb16892980de999610", "git_parents": ["981be688fe87852c306f332ac58d40cc38820675"], "node": "4c07b64a3891810c49e0516643ca5cbc0509ffd2", "parents": ["20b2100a1075117745964095c37024d41fe66627"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048149 - Containers style update - part 3 - common icon pattern r=desktop-theme-reviewers,fxview-reviewers,mconley,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311441\n", "files": ["browser/components/contextualidentity/content/usercontext.css", "browser/components/firefoxview/opentabs-tab-row.css", "browser/components/sidebar/sidebar-tab-row.css", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/urlbar/view-nova.css"], "git_node": "d0a8a15bbfeb446c687ceb82facd8bcef2ea0684", "git_parents": ["81967326c9e1c5181da488eb16892980de999610"], "node": "9edb37ac6eeff0c3887f368835286672e7409d92", "parents": ["4c07b64a3891810c49e0516643ca5cbc0509ffd2"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055894 - Create render thread's GLContext using EGL (Metal ANGLE) if enabled. r=gfx-reviewers,bradwerth\n\nOn macOS, if gfxVars::UseWebRenderANGLE() is enabled create the\nwebrender render thread's GL context using EGL (i.e. Metal ANGLE). Note\nthat this is currently blocklisted, but will be unblocked for common\nconfigurations in the subsequent patch. It will still remain off by\ndefault behind the pref \"gfx.webrender.enable-angle\".\n\nExpose a new function GLLibraryEGL::CreateDisplayForMetalDevice() that\ncreates an EGLDisplay for a given Metal device ID. Since Metal ANGLE\nwill, for the time being, remain blocked on systems with multiple GPUs,\nthe device ID we provide does not really matter. The key detail here is\nthat by providing an explicit device ID, ANGLE's display cache will\nreturn to us a different display than would have been obtained through\ncalling CreateDisplay(), even if the underlying device would have been\nthe same.\n\nThis ensures that when ANGLE is enabled for both WebGL and webrender\nthey each use different EGLDisplays, which avoids rendering glitches\npresumably due to lack of thread safety.\n\nA simple helper class is added in order to obtain the Metal device\nID. Currently this simply calls MTLCreateSystemDefaultDevice(). Note\nthat on systems with multiple GPUs this will return the device for the\ndiscrete GPU. This is moot since we only currently support systems with\na single GPU, but when we do eventually support systems with multiple\nGPUs we will probably want to do something cleverer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313220\n", "files": ["gfx/gl/GLDefs.h", "gfx/gl/GLLibraryEGL.cpp", "gfx/gl/GLLibraryEGL.h", "gfx/webrender_bindings/MetalDeviceManager.h", "gfx/webrender_bindings/MetalDeviceManager.mm", "gfx/webrender_bindings/RenderThread.cpp", "gfx/webrender_bindings/moz.build"], "git_node": "b355d7223a3c5c5828696b47524a52df9fd27b51", "git_parents": ["d0a8a15bbfeb446c687ceb82facd8bcef2ea0684"], "node": "baa59c16ec8097aaf77c5b4e2599dfed034d61ff", "parents": ["9edb37ac6eeff0c3887f368835286672e7409d92"], "tags": []}, {"author": "Jamie Nicol \u003cjnicol@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055894 - Unblock webrender on Metal ANGLE for macOS 12 onwards. r=gfx-reviewers,bradwerth\n\nFor devices with a single GPU. This remains off by default behind the\npref \"gfx.webrender.enable-angle\".\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313221\n", "files": ["widget/cocoa/GfxInfo.mm"], "git_node": "ff96938d6427e43fc116039b141594ffb562ebaa", "git_parents": ["b355d7223a3c5c5828696b47524a52df9fd27b51"], "node": "a44e7fe7bc16d034ba2e8738707f9e9d1d341193", "parents": ["baa59c16ec8097aaf77c5b4e2599dfed034d61ff"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2055219 - set RTCRtpSender-replaceTrack.https.html as timing out on release or beta. r=ng DONTBUILD\n\nMaybe a change from bug 2000975.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313055\n", "files": ["testing/web-platform/meta/webrtc/RTCRtpSender-replaceTrack.https.html.ini"], "git_node": "54ebb665113694e213e1cd4859cb1883cbd26676", "git_parents": ["ff96938d6427e43fc116039b141594ffb562ebaa"], "node": "5ce455d8bd75cae6917b29a1577026da03551134", "parents": ["a44e7fe7bc16d034ba2e8738707f9e9d1d341193"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051707 - Add a redirector component and a test message for about:referrals r=omc-reviewers,jhirsch,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311654\n", "files": ["browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_get_referral_code.js"], "git_node": "4871078ca108fde83934d2be051c7f44330a9d5e", "git_parents": ["54ebb665113694e213e1cd4859cb1883cbd26676"], "node": "c89b4ea7ef298b0a9ac58b0395b05c4a4d0c9744", "parents": ["5ce455d8bd75cae6917b29a1577026da03551134"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2054598 - [Monitor Agent][FE] Add new monitor agent form in modal on about:XXX page r=tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312371\n", "files": ["browser/components/DesktopActorRegistry.sys.mjs", "browser/components/aiwindow/models/agents/Schedule.sys.mjs", "browser/components/aiwindow/ui/actors/SmartWindowTasksChild.sys.mjs", "browser/components/aiwindow/ui/actors/SmartWindowTasksParent.sys.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/content/tasks.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_tasks_actors.js"], "git_node": "273ce40bd7cb9fed56db5d10c579cb49f3eb7eda", "git_parents": ["4871078ca108fde83934d2be051c7f44330a9d5e"], "node": "8f90c8df2ed2f97eb00d2703d679cbce9d4cc778", "parents": ["c89b4ea7ef298b0a9ac58b0395b05c4a4d0c9744"], "tags": []}, {"author": "Swarup Ukil \u003csukil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1986640 - Optimize content property to avoid reframing on text content changes. r=emilio,dshin,firefox-style-system-reviewers,layout-reviewers\n\nOur new advanced attr() deprecates nsAttributeTextNode, but also loses some\nof the optimization it had dealing with `content` property changes. Specifically,\nif an attr-value change updates the text content in `content`, then we currently\nreframe from the originating element, which can be quite expensive.\n\nTo improve this, we more generically attempt to do in place text changes on\nthe relevant text content nodes, which should include improvements for cases\nlike `content: attr(name)`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312955\n", "files": ["layout/generic/nsIFrame.cpp", "layout/style/nsStyleStruct.cpp", "layout/style/nsStyleStruct.h", "layout/style/test/mochitest.toml", "layout/style/test/test_dynamic_change_causing_reflow_content.html"], "git_node": "5f23caa19d0bde024f5ef1b07cfd316bea18fe16", "git_parents": ["273ce40bd7cb9fed56db5d10c579cb49f3eb7eda"], "node": "f840e09e83acbdf58e3fff6f6e49a200c2a83927", "parents": ["8f90c8df2ed2f97eb00d2703d679cbce9d4cc778"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2041548 - Update the syntax of view timeline inset to only absolute units and percentage. r=firefox-style-system-reviewers,emilio\n\nPer the proposal of the spec issue,\nhttps://github.com/w3c/csswg-drafts/issues/13852, we should accept only\nabsolute units and percentage for ViewTimelineOptions inset.\n\nThe test change proposal is:\nhttps://github.com/web-platform-tests/interop/issues/1304\n\nThe new failure is due to the usage of relative units, em and vw, so we\nhave to wait until the WPT PR gets merged.\n\nAlso, we still have to flush the style before sampling the ViewTimeline\nin the constructor. Otherwise, we may get unexpected fails in:\n1. view-timelines/view-timeline-source-single-axis-inner.html\n2. view-timelines/view-timeline-source.tentative.html\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312382\n", "files": ["dom/animation/ViewTimeline.cpp", "layout/style/ServoCSSParser.cpp", "layout/style/ServoCSSParser.h", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/scroll-animations/view-timelines/view-timeline-inset.html.ini"], "git_node": "ffce434faf1180d7d069192adbbe19474195d8e6", "git_parents": ["5f23caa19d0bde024f5ef1b07cfd316bea18fe16"], "node": "0db4d31cefcc1baa6156b91dfce6e9d5f94d653e", "parents": ["f840e09e83acbdf58e3fff6f6e49a200c2a83927"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2041548 - Convert sequence\u003c(CSSKeywordish or CSSNumericValue)\u003e into StyleViewTimelineInset. r=firefox-style-system-reviewers,layout-scroll-driven-animation-reviewers,dshin\n\nSame as the string value, we accept absolute units and percentage only.\nThe test will be changed as well:\nhttps://github.com/web-platform-tests/interop/issues/1304\nOnce the proposal gets accepted and the PR gets merged, all tests should\nbe passed.\n\nAlso, use a marco to simplify some duplicated parse code in glue.rs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303243\n", "files": ["dom/animation/ViewTimeline.cpp", "layout/style/ServoCSSParser.cpp", "layout/style/ServoCSSParser.h", "servo/ports/geckolib/glue.rs", "testing/web-platform/meta/scroll-animations/view-timelines/view-timeline-inset.html.ini"], "git_node": "873254dfed0fd48605d1120f9313d9f3a7b6864b", "git_parents": ["ffce434faf1180d7d069192adbbe19474195d8e6"], "node": "e1c3fa2240d36e82db0ad3cf0022cb2f9523bd04", "parents": ["0db4d31cefcc1baa6156b91dfce6e9d5f94d653e"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2056306 - Invalidate picture cache tiles when text stops animating r=gfx-reviewers,nical\n\nText under an animated transform is rasterized in local space (bug 2053638).\nA reference frame was treated as animating whenever its transform was bound to\na property, even if the value never moved, so bound-but-static text (a held or\nsettled animation) was rasterized locally and looked blurry at a fractional\ndevice offset (bug 2051166). And when the animation ended the raster space\nreturned to the device path, but nothing invalidated the tile, so it kept the\nstale local-raster text.\n\nRedefine \"animating\" as \"the bound transform has been observed to move\", using\na monotonic per-binding latch in SceneProperties: bound-but-static text stays on\nthe crisp device path, while a genuinely moving transform still rasterizes in\nlocal space to avoid per-frame snap jitter.\n\nAdd an AnimatedRasterSpace picture-cache dependency for text runs, present only\nwhile animating, so the tile invalidates when the animation ends (the binding is\nremoved) and the raster-space flip alone would otherwise change neither prim_uid\nnor the vertex corners.\n\nAlso extend the wrench yaml reader with property-bound reference-frame\ntransforms (transform-binding) and dynamic transform-property values, and add an\ninvalidation test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313123\n", "files": ["gfx/wr/webrender/src/invalidation/cached_surface.rs", "gfx/wr/webrender/src/invalidation/compare.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/wrench/invalidation/anim_text_a.yaml", "gfx/wr/wrench/invalidation/anim_text_b.yaml", "gfx/wr/wrench/invalidation/anim_text_c.yaml", "gfx/wr/wrench/invalidation/invalidation.list", "gfx/wr/wrench/src/wrench.rs", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "2456dccff1ca9783e014c834406f5f01ac5b14b8", "git_parents": ["873254dfed0fd48605d1120f9313d9f3a7b6864b"], "node": "95c617a70b81a2d45c6f96e629f1b3a296fd7da1", "parents": ["e1c3fa2240d36e82db0ad3cf0022cb2f9523bd04"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054589 - Make zap_border compatible with inline background prop, enable cta_link styles on additional_button, and make tile border configurable r=omc-reviewers,yazan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312141\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/ContentTiles.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/components/SingleSelect.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "c9c81fe942e80b7ea91ef7b6a335fc7e4fde5c67", "git_parents": ["2456dccff1ca9783e014c834406f5f01ac5b14b8"], "node": "d95bfee9b14d0892ea60afac78aa7193569cb83f", "parents": ["95c617a70b81a2d45c6f96e629f1b3a296fd7da1"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2046612 - Add animated loading treatment to Smart Window Action Log processing states. r=echa\n\nWhile an Action Log is processing, ai-action-result renders a non-interactive role=\"status\" row instead of the expandable header: a shimmering gradient label (with trailing ellipsis) beside the full-color logo that spins and breathes. The chat-assistant-loader spinner is suppressed while an action log is in progress. Animations respect prefers-reduced-motion and forced-colors.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311938\n", "files": ["browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.css", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_loader_suppression.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_result.js"], "git_node": "3893b0cdb2e754432eecf12b5fdf94f54773f089", "git_parents": ["c9c81fe942e80b7ea91ef7b6a335fc7e4fde5c67"], "node": "1150f4122a546d200aac1ae6cd7450ebf86c80e1", "parents": ["d95bfee9b14d0892ea60afac78aa7193569cb83f"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2053296: Set RTCTransportStats.dtlsRole to \"unknown\" pre-negotiation. r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312834\n", "files": ["dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "testing/web-platform/meta/webrtc/RTCPeerConnection-transport-stats.https.html.ini", "testing/web-platform/meta/webrtc/protocol/dtls-setup.https.html.ini"], "git_node": "5028bc5eabf70fec8c1fbe7389893cd1cab0e46f", "git_parents": ["3893b0cdb2e754432eecf12b5fdf94f54773f089"], "node": "d8a0e888671730bcc414bee180c8699b00e9dd6e", "parents": ["1150f4122a546d200aac1ae6cd7450ebf86c80e1"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045445 - Check for allocation failure in ModuleGenerator r=jpages\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313237\n", "files": ["js/src/wasm/WasmGenerator.cpp"], "git_node": "6ce4e58dff3d1b55ce661761b8b8db26e88370c9", "git_parents": ["5028bc5eabf70fec8c1fbe7389893cd1cab0e46f"], "node": "f16a4bf6854fbf4e742ef5dd82bd48454f522ccc", "parents": ["d8a0e888671730bcc414bee180c8699b00e9dd6e"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056676 - fix broken webcompat intervention automated tests after bz2050357; r=ksenia\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313297\n", "files": ["testing/webcompat/fixtures.py"], "git_node": "4d253a2d88ba7d15362c6c7cd0981bb995386434", "git_parents": ["6ce4e58dff3d1b55ce661761b8b8db26e88370c9"], "node": "49a69eb712c539498c84608c9b01589b35d7ea47", "parents": ["f16a4bf6854fbf4e742ef5dd82bd48454f522ccc"], "tags": []}, {"author": "Thomas Wisniewski \u003ctwisniewski@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056678 - fix breakage in webcompat automated tests (and potentially some updates) after bz1610046; r=ksenia,webcompat-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313298\n", "files": ["browser/extensions/webcompat/lib/intervention_helpers.js", "browser/extensions/webcompat/lib/interventions.js", "browser/extensions/webcompat/manifest.json"], "git_node": "69c03f23f6f04f573fdf93f7ccbbe324f0587124", "git_parents": ["4d253a2d88ba7d15362c6c7cd0981bb995386434"], "node": "907debe0647a55e0273ace41695bacb4b3fddab8", "parents": ["49a69eb712c539498c84608c9b01589b35d7ea47"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053666 - Remove deprecated and buggy JS_GetArrayBufferViewFixedData r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313122\n", "files": ["js/public/experimental/TypedData.h", "js/src/vm/ArrayBufferViewObject.cpp", "js/src/vm/TypedArrayObject.cpp"], "git_node": "2eda2f3c1f9f9389f5fb9af046305ed056b8db0c", "git_parents": ["69c03f23f6f04f573fdf93f7ccbbe324f0587124"], "node": "4fa194299caaec883a247da7b151b148a66d60b8", "parents": ["907debe0647a55e0273ace41695bacb4b3fddab8"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2051707 - Add a redirector component and a test message for about:referrals r=omc-reviewers,jhirsch,sachung\" for causing bc failures @ browser_referralsAppMenu.js\n\nThis reverts commit 4871078ca108fde83934d2be051c7f44330a9d5e.\n", "files": ["browser/components/about/AboutRedirector.cpp", "browser/components/about/components.conf", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/SpecialMessageActionSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/index.md", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser.toml", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_get_referral_code.js"], "git_node": "494c2994c95ed80335e29e158e8a2b8a38cf9164", "git_parents": ["2eda2f3c1f9f9389f5fb9af046305ed056b8db0c"], "node": "6e1eff6818e04312ce96d45cebdf120047669e8a", "parents": ["4fa194299caaec883a247da7b151b148a66d60b8"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2056176 - Cache GMP event target in GMPParent to fix deadlock during startup. r=media-playback-reviewers,alwu\n\nGMPParent::GMPEventTarget() called do_GetService() to look up\n@mozilla.org/gecko-media-plugin-service;1 on every call. When invoked\nfrom the GMPParent constructor during GeckoMediaPluginServiceParent::\nLoadFromEnvironment(), this created a circular dependency: the GMP\nservice was already being initialized, so GetServiceLocked() blocked\non a condition variable waiting for it to finish, while the main thread\nwas itself blocked waiting for the same service inside an\nipc:first-content-process-created observer. Neither thread could\nproceed, hanging Firefox at startup indefinitely.\n\nFix by passing the GMP thread's serial event target into the GMPParent\nconstructor from CreateGMPParent(), storing it as mGMPEventTarget, and\nhaving GMPEventTarget() return that cached value directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313185\n", "files": ["dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPServiceParent.cpp"], "git_node": "4365acaaa15bdbdddd9ccba240fae1df68ef7490", "git_parents": ["494c2994c95ed80335e29e158e8a2b8a38cf9164"], "node": "241d00f0a2ae8cd53cb2412ab025492a64a3b247", "parents": ["6e1eff6818e04312ce96d45cebdf120047669e8a"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055990 - Wait for a frame before each subtest in test_animation_performance_warning.html. r=boris\n\nHonestly I don't know what happened on the failing runs, and I haven't\ninvestigated it either. Given that the failures happen on shippable/opt\nbuilds, I suspect that with some optimizations, even after a paint has\nhappened, newly created compositor-runnable animations are sometimes not\nsent to the compositor. I guess it involves the catch-up tick [1]. So\nthis change is definitely a workaround, but it doesn't harm this test at\nall.\n\n[1] https://searchfox.org/firefox-main/rev/7fa9b602777418732e08b26d1ef6c9945c4bbd72/layout/base/nsRefreshDriver.cpp#1818-1836\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313140\n", "files": ["dom/animation/test/chrome/test_animation_performance_warning.html"], "git_node": "f3a29230fc302297e50a4055000e98c3966d85d8", "git_parents": ["4365acaaa15bdbdddd9ccba240fae1df68ef7490"], "node": "41d15eecc20714da37e6ea84e02b294d2128645d", "parents": ["241d00f0a2ae8cd53cb2412ab025492a64a3b247"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055487 - Fix mainContentHeader inside browser_aboutwelcome_configurable_ui for Nova r=omc-reviewers,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313094\n", "files": ["browser/components/aboutwelcome/tests/browser/browser_aboutwelcome_configurable_ui.js"], "git_node": "f5e27c370e3d77a249de18977d3b5487a268ad12", "git_parents": ["f3a29230fc302297e50a4055000e98c3966d85d8"], "node": "41f84d5183a668bc33f494ae30dbc94cd91324ab", "parents": ["41d15eecc20714da37e6ea84e02b294d2128645d"], "tags": []}, {"author": "Punam Dahiya \u003cpdahiya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048336 - Make hide of Smart Window first run onboarding screen nimbus configurable r=echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312839\n", "files": ["browser/components/aiwindow/ui/content/firstrun.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_firstrun.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "ca4cf86aabc80393d622ab112f74f97c783567e6", "git_parents": ["f5e27c370e3d77a249de18977d3b5487a268ad12"], "node": "f90cbaddd43596e8ec4bce597b4e158f734489c6", "parents": ["41f84d5183a668bc33f494ae30dbc94cd91324ab"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes mobile-experiments mobile-merino-manifest ct-logs - r=release-managers,diannaS DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313309\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/main/newtab-wallpapers-v2.json"], "git_node": "354296ab0258ecfcfb75e0e5c8fb63ce8e0cd010", "git_parents": ["ca4cf86aabc80393d622ab112f74f97c783567e6"], "node": "8b2b4406701d5c9fb2e9a284a50b80b4e6b3b218", "parents": ["f90cbaddd43596e8ec4bce597b4e158f734489c6"], "tags": []}, {"author": "Juliana Gaibler \u003cgit@juliana.me\u003e", "branch": "default", "desc": "Bug 2053333 - Adjust chrome block border radius for macOS Tahoe window corners. r=desktop-theme-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313278\n", "files": ["browser/themes/shared/browser-shared.css"], "git_node": "1dac50cdc6022782fcf9bd30f60dc0d71c0e9c47", "git_parents": ["354296ab0258ecfcfb75e0e5c8fb63ce8e0cd010"], "node": "21bebd5e1ef4248b0011e9746e53485f3989092f", "parents": ["8b2b4406701d5c9fb2e9a284a50b80b4e6b3b218"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2056494 - Fuzz mask-absolutely-positioned-child-gap reftest on Windows r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313312\n", "files": ["layout/reftests/svg/reftest.list"], "git_node": "9a9537af0c71ae828c8c9f69ddbcbd44e9105de1", "git_parents": ["1dac50cdc6022782fcf9bd30f60dc0d71c0e9c47"], "node": "bff3d78d1b023a1f43db2dd11ffc8b0e55b962e8", "parents": ["21bebd5e1ef4248b0011e9746e53485f3989092f"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055856 - Update gfx SanityTest to load with a resource:// URL in a content process. r=Gijs,gfx-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312717\n", "files": ["dom/security/nsContentSecurityUtils.cpp", "toolkit/components/gfx/SanityTest.sys.mjs", "toolkit/components/gfx/content/gfxFrameScript.js", "toolkit/components/gfx/content/sanitytest.html", "toolkit/components/gfx/jar.mn"], "git_node": "d8fbe610c945b1edac529e6d283707206e14b1f5", "git_parents": ["9a9537af0c71ae828c8c9f69ddbcbd44e9105de1"], "node": "2a83a0983f82e29a09b4813db9dde8e94fbdc55e", "parents": ["bff3d78d1b023a1f43db2dd11ffc8b0e55b962e8"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2046199 - Update Smart Window Nova Theme for new tokens and properties r=desktop-theme-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312172\n", "files": ["browser/themes/addons/aiwindow-nova/aiwindow-theme-nova.css", "browser/themes/addons/aiwindow-nova/manifest.in.json", "browser/themes/addons/moz.build"], "git_node": "b546b0ead2ad23640a1e62ccfb82641a02963657", "git_parents": ["d8fbe610c945b1edac529e6d283707206e14b1f5"], "node": "63297d3039ea112368a85268e4391cff5d0d4792", "parents": ["2a83a0983f82e29a09b4813db9dde8e94fbdc55e"], "tags": []}, {"author": "hannajones \u003chjones@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050531 - add JSWindowActor pair for theme-picker r=mstriemer,maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312555\n", "files": ["browser/actors/ThemePickerChild.sys.mjs", "browser/actors/ThemePickerParent.sys.mjs", "browser/actors/moz.build", "browser/components/DesktopActorRegistry.sys.mjs", "toolkit/content/jar.mn", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs"], "git_node": "c6c6e69e04fb1d779f041949807a70fb970704ae", "git_parents": ["b546b0ead2ad23640a1e62ccfb82641a02963657"], "node": "b31c068e0d9c88a3914a3698b04b5564df466257", "parents": ["63297d3039ea112368a85268e4391cff5d0d4792"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2046612 - Add animated loading treatment to Smart Window Action Log processing states. r=echa\" for causing bc failures @ browser/skin/smart-window-filled.svg\n\nThis reverts commit 3893b0cdb2e754432eecf12b5fdf94f54773f089.\n", "files": ["browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.css", "browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_loader_suppression.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_result.js"], "git_node": "03d2d3c707ad1ca3e72e0186387767f9cdfe56fd", "git_parents": ["c6c6e69e04fb1d779f041949807a70fb970704ae"], "node": "ee70892697d57907bc28fe9bcf220429e1827558", "parents": ["b31c068e0d9c88a3914a3698b04b5564df466257"], "tags": []}, {"author": "David Rubino \u003cdrubino@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056462 - Add launchOnLoginAllowedByPolicy targeting getter for launch-options eligibility. r=omc-reviewers,aminomancer\n\nThe launch-options-for-existing-users experiment needs to gate enrollment on\nwhether launch on login could be enabled for a user, which was not previously\nexpressible in Nimbus or messaging targeting.\n\nlaunchOnLoginAllowedByPolicy exposes the isAllowedByPolicy value from\nWindowsLaunchOnLogin.getLaunchOnLoginEnablementDetails() so enrollment can\nexclude users for whom launch on login cannot be turned on (locked by Windows\nSettings or enterprise policy). Windows-only; false elsewhere.\n\nThe targeting-attributes.md doc entry is required by the TargetingDocs unit\ntest.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313154\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs"], "git_node": "6515560f799b640870c00af808273ce8e4d674b1", "git_parents": ["03d2d3c707ad1ca3e72e0186387767f9cdfe56fd"], "node": "9bb446573d9d1211e774a5fd85818b9a5015dfc2", "parents": ["ee70892697d57907bc28fe9bcf220429e1827558"], "tags": []}, {"author": "hanna.alemu \u003chalemu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056707 - Add preferenceIsLocked JEXL filter expression r=omc-reviewers,aminomancer\n\nAdd a preferenceIsLocked filter to FilterExpressions, wrapping\nServices.prefs.prefIsLocked. This lets messaging targeting avoid offering an\naction whose preference is locked (e.g. by enterprise policy), since setting a\nlocked pref would silently no-op.\n\nThe filter is available anywhere FilterExpressions is used, including ASRouter\nmessage targeting. A nonexistent pref evaluates to false rather than throwing,\nso arbitrary keys are safe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313322\n", "files": ["browser/components/asrouter/docs/targeting-guide.md", "toolkit/components/utils/FilterExpressions.sys.mjs", "toolkit/components/utils/test/unit/test_FilterExpressions.js"], "git_node": "6b8fdf9dacca3892ea6e1e2b49c71afb1fc0ab54", "git_parents": ["6515560f799b640870c00af808273ce8e4d674b1"], "node": "8962d1e0945f4f7b8d84782f299d68444c5c94c4", "parents": ["9bb446573d9d1211e774a5fd85818b9a5015dfc2"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2055101 - Add screenshot taking functionality to GVE for testing purposes r=geckoview-reviewers,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312198\n", "files": ["mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/GeckoViewActivity.java", "mobile/android/geckoview_example/src/main/res/menu/actions.xml", "mobile/android/geckoview_example/src/main/res/values/strings.xml"], "git_node": "3de33d0c3ab12001d65420b15307cec455585214", "git_parents": ["6b8fdf9dacca3892ea6e1e2b49c71afb1fc0ab54"], "node": "7b391622e236d4245dd86b5605e26e79416af320", "parents": ["8962d1e0945f4f7b8d84782f299d68444c5c94c4"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050054 - Ensure the login autocomplete dropdown stacks above the password doorhanger. r=dimi,layout-reviewers,emilio\n\nThe saved-logins dropdown (PopupAutoComplete) and the doorhanger panel\n(notification-popup) both fell back to the same platform-default popup level, so\nthey became co-equal sibling popups parented to the main window with no defined\nz-order, letting the dropdown render behind the doorhanger intermittently.\n\nPin PopupAutoComplete to level=\"top\" in markup so it no longer depends on the\nlazy initialize() that set the level too late to affect widget creation. Add a\nlowerPanelLevel PopupNotifications option that lowers the panel to level=\"parent\"\nfor notifications that host their own popup (the password doorhanger), so the\ndropdown stacks above it. Since the popup level is only read when the widget is\ncreated, recreate the widget in nsMenuPopupFrame when the level attribute\nchanges while the popup is closed.\n\nThe popup level governs stacking on Windows and macOS. This change won't work on Linux..\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313057\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/base/content/test/popupNotifications/browser.toml", "browser/base/content/test/popupNotifications/browser_popupNotification_panel_level.js", "browser/base/content/webext-panels.xhtml", "layout/xul/nsMenuPopupFrame.cpp", "toolkit/components/passwordmgr/LoginManagerPrompter.sys.mjs", "toolkit/modules/PopupNotifications.sys.mjs"], "git_node": "4fb560fe33ae09a355b8e22727cba4d72bd91448", "git_parents": ["3de33d0c3ab12001d65420b15307cec455585214"], "node": "79977687b8e6251bbd7cb7c51f47c5fbd4a0d293", "parents": ["7b391622e236d4245dd86b5605e26e79416af320"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055723 Part 1 - Skip computing shrink-to-fit ratio during a measuring reflow. r=layout-reviewers,emilio\n\nSee the code comment added in this patch for rationale.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313118\n", "files": ["layout/generic/nsPageContentFrame.cpp"], "git_node": "5967c9e79bcc657cda1fceb0a40c4aa7617ba750", "git_parents": ["4fb560fe33ae09a355b8e22727cba4d72bd91448"], "node": "a4817617de518c9d4ba2402dc1f3a0a1ba74424b", "parents": ["79977687b8e6251bbd7cb7c51f47c5fbd4a0d293"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055723 Part 2 - Add a print-preview test for multi-page PDF shrink-to-fit. r=layout-reviewers,dshin\n\nThis patch is written with the help of Claude code. `2in_blue_3pages.pdf` is\ngenerated entirely by Claude code.\n\nThe test prints a multi-page PDF and checks it isn't wrongly shrunk. To exercise\nthe measuring reflow, the PDF's pages carry an ExtGState transfer function (/TR)\n[1], which makes pdf.js create a hidden absolutely-positioned \u003csvg\u003e\u003cdefs\u003e [2]\nelement via its DOMFilterFactory. That abspos descendant is what triggers the\nmeasuring reflow. The function is f(x)=x^2, so the pure-blue-on- white pages\nrender pixel-identically to the reference while still forcing the filter to be\ncreated.\n\n[1] https://searchfox.org/firefox-main/rev/d951c4a19a6958816b35a228ff38fc6ae2c34f13/toolkit/components/pdfjs/content/build/pdf.mjs#10431-10433\n[2] https://searchfox.org/firefox-main/source/toolkit/components/pdfjs/content/build/pdf.mjs#12490-12509\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313119\n", "files": ["layout/base/tests/chrome/2in_blue_3pages.pdf", "layout/base/tests/chrome/chrome.toml", "layout/base/tests/chrome/printpreview_helper.xhtml"], "git_node": "2afb5a9201bd85d369b4ce808f54042df16d1997", "git_parents": ["5967c9e79bcc657cda1fceb0a40c4aa7617ba750"], "node": "7ed42801942a8ce7d3d16e98752baef7b8ce1ab4", "parents": ["a4817617de518c9d4ba2402dc1f3a0a1ba74424b"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2055856 - Update gfx SanityTest to load with a resource:// URL in a content process. r=Gijs,gfx-reviewers,aosmond\" for causing bc failures @ gfxFrameScript\n\nThis reverts commit d8fbe610c945b1edac529e6d283707206e14b1f5.\n", "files": ["dom/security/nsContentSecurityUtils.cpp", "toolkit/components/gfx/SanityTest.sys.mjs", "toolkit/components/gfx/content/gfxFrameScript.js", "toolkit/components/gfx/content/sanitytest.html", "toolkit/components/gfx/jar.mn"], "git_node": "9e7065c16d307e51b96240d5751bdddf91d79a98", "git_parents": ["2afb5a9201bd85d369b4ce808f54042df16d1997"], "node": "72521f140e5dd4e4ed4009a668f49f4aec33e7c1", "parents": ["7ed42801942a8ce7d3d16e98752baef7b8ce1ab4"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053492 - Add telemetry for potentially failing local storage flush operation. r=dom-storage-reviewers,janv\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313244\n", "files": ["dom/localstorage/ActorsParent.cpp"], "git_node": "870cbe31a0aef9c6012a84a87db616ab5428d3af", "git_parents": ["9e7065c16d307e51b96240d5751bdddf91d79a98"], "node": "501e240603bfe816dd7049a082d0d6aeabcf5780", "parents": ["72521f140e5dd4e4ed4009a668f49f4aec33e7c1"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055696 - Make ScrollTimeline's cached state snapshot own its source element. r=boris\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313120\n", "files": ["dom/animation/ScrollTimeline.cpp", "dom/animation/ScrollTimeline.h"], "git_node": "b87614ea02f30e77b7b77beb40426f1946c7dad3", "git_parents": ["870cbe31a0aef9c6012a84a87db616ab5428d3af"], "node": "1f4d141c22c5359236bffe284bce815ee5d593a8", "parents": ["501e240603bfe816dd7049a082d0d6aeabcf5780"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2056152 - Revert the fix for bug 2033848. r=stransky\n\nRevert \"Bug 2033848 - Use non-default response ID for GTK file picker accept button. r=stransky\"\n\nThis reverts commit d07538533f1ab3d14e6ee7a58b928c26d952d754.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313053\n", "files": ["widget/gtk/nsFilePicker.cpp"], "git_node": "8ebfb144ace5db6c3609d5494476d5b30c2ccec7", "git_parents": ["b87614ea02f30e77b7b77beb40426f1946c7dad3"], "node": "a40a7c1960727cb3d11e1f9ef4a4797752a2cacb", "parents": ["1f4d141c22c5359236bffe284bce815ee5d593a8"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2056371. Remove no longer needed upstreamed libyuv patch. r=chunmin,ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313176\n", "files": ["media/libyuv/05_fix_gcc_neon_rgbtouvmatrixrow.patch", "media/libyuv/moz.yaml"], "git_node": "9f13c50d7bec52c538e0a5cd206f32bd085e8d11", "git_parents": ["8ebfb144ace5db6c3609d5494476d5b30c2ccec7"], "node": "107fbbc038006815f26dfa7e78f9b5dcae9d3beb", "parents": ["a40a7c1960727cb3d11e1f9ef4a4797752a2cacb"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2056371. Update libyuv to new version 45258a40a0c1d72bba911f61d81fd5a44d92f50d. r=chunmin,ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313179\n", "files": ["media/libyuv/libyuv/BUILD.gn", "media/libyuv/libyuv/README.chromium", "media/libyuv/libyuv/include/libyuv/version.h", "media/libyuv/libyuv/source/convert.cc", "media/libyuv/libyuv/source/convert_to_argb.cc", "media/libyuv/libyuv/source/mjpeg_decoder.cc", "media/libyuv/libyuv/source/rotate_argb.cc", "media/libyuv/libyuv/source/row_lasx.cc", "media/libyuv/libyuv/source/row_lsx.cc", "media/libyuv/libyuv/source/scale_argb.cc", "media/libyuv/libyuv/source/scale_rgb.cc", "media/libyuv/libyuv/util/cpuid.c", "media/libyuv/moz.yaml"], "git_node": "e165f8e6829258c96180c382c842a180417e70bb", "git_parents": ["9f13c50d7bec52c538e0a5cd206f32bd085e8d11"], "node": "5a7456bdc46794d695eeba670a73663b7e821c1c", "parents": ["107fbbc038006815f26dfa7e78f9b5dcae9d3beb"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2055813. Add a web-platform reftest verifying that an AVIF with an lsel of layer_id 0xffff renders. r=gfx-reviewers,aosmond\n\nAn lsel (LayerSelectorProperty) with layer_id 0xffff does not select a\nspecific spatial layer; it enables, but does not require, progressive\nrendering. Such an image should render like any other AVIF.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312701\n", "files": ["testing/web-platform/tests/avif/lsel-layer-id-ffff-ref.html", "testing/web-platform/tests/avif/lsel-layer-id-ffff.html", "testing/web-platform/tests/avif/resources/lsel-layer-id-ffff.avif"], "git_node": "bba71535fedb188237a3fc3432e2d3387497c9fd", "git_parents": ["e165f8e6829258c96180c382c842a180417e70bb"], "node": "a7301913fb2180aadf1c8a1af6d792b2935e4946", "parents": ["5a7456bdc46794d695eeba670a73663b7e821c1c"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2049904 - Add File.createFromNsIInputStream to avoid I/O on main thread. r=dom-core-reviewers,geckoview-reviewers,webidl,smaug,dom-storage-reviewers,owlish,jari,saschanaz\n\nCurrently, we read Android content uri files (content://) on the main\nthread before creating a File object when uploading a folder. I would\nlike to avoid reading data before creating a File object.\n\nAdding a new method that lazy-reads content data on passing to the child\nprocess, and it reads on a non-main thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309286\n", "files": ["dom/bindings/Bindings.conf", "dom/file/File.cpp", "dom/file/File.h", "dom/file/tests/test_file_createFromNsIInputStream.js", "dom/file/tests/xpcshell.toml", "dom/webidl/File.webidl", "mobile/android/components/geckoview/GeckoViewInputStream.cpp", "mobile/android/components/geckoview/GeckoViewInputStream.h", "mobile/android/geckoview/src/main/java/org/mozilla/gecko/util/IntentUtils.java", "mobile/shared/components/geckoview/FilePickerDelegate.sys.mjs"], "git_node": "59edc736544498cc2a433413de3e6aee070e5ef7", "git_parents": ["bba71535fedb188237a3fc3432e2d3387497c9fd"], "node": "8c65f4ba7fdf992f289bb65542d2a21a340940be", "parents": ["a7301913fb2180aadf1c8a1af6d792b2935e4946"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2053053. Add fuzz to dom/canvas/test/reftest/filters/liveness-document-removeChild.html. r=dholbert\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313196\n", "files": ["dom/canvas/test/reftest/filters/reftest.list"], "git_node": "deacea3ad6ffed0aeb4600ce65b38205da718441", "git_parents": ["59edc736544498cc2a433413de3e6aee070e5ef7"], "node": "22e112ba7bd07199d68768123a6e17c770b70ee9", "parents": ["8c65f4ba7fdf992f289bb65542d2a21a340940be"], "tags": []}, {"author": "Steve Fink \u003csfink@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052472 - Remove some detailed error diagnosis since it isn't finding much anymore. r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313124\n", "files": ["dom/bindings/TypedArray.h"], "git_node": "f80daedb17c17f0de5f71914b15e0a655d81fe28", "git_parents": ["deacea3ad6ffed0aeb4600ce65b38205da718441"], "node": "1034a5c91da09625da9945cdcf770b47ac7827dc", "parents": ["22e112ba7bd07199d68768123a6e17c770b70ee9"], "tags": []}, {"author": "Aaditya Dhingra \u003cadhingra@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056684 - Override secret settings from local.properties in debug builds without needing to interact with UI. r=geckoview-reviewers,android-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313300\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/docs/Secret-settings-debug-menu-instructions.md", "mobile/android/gradle/mozconfig.gradle"], "git_node": "7b38b6c3bfa9bee657ff49d999a01d2e8c33b971", "git_parents": ["f80daedb17c17f0de5f71914b15e0a655d81fe28"], "node": "c0193bff9bdcdf3a685e7a411db4ba651a68142d", "parents": ["1034a5c91da09625da9945cdcf770b47ac7827dc"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-sat/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-hu/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-ko/strings.xml"], "git_node": "49bbae2046b2d4407195dc8b50501a12dae5e35c", "git_parents": ["7b38b6c3bfa9bee657ff49d999a01d2e8c33b971"], "node": "d886fb775b5aca67a3c902487a24d74bb357213c", "parents": ["c0193bff9bdcdf3a685e7a411db4ba651a68142d"], "tags": []}, {"author": "Omar Gonzalez \u003cs9tpepper@apache.org\u003e", "branch": "default", "desc": "Bug 2047556 - Fix HCM styles for history thumbnail list scrollbar r=pdahiya\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309746\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-grid/ai-chat-grid.css", "browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.css"], "git_node": "e36706aabccdac8e1fdefcaf1a4c1bd371aefd42", "git_parents": ["49bbae2046b2d4407195dc8b50501a12dae5e35c"], "node": "c60a9feb5ed87b69f5d4917e1e7da51c48f3b973", "parents": ["d886fb775b5aca67a3c902487a24d74bb357213c"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2053864 - Make `nsContentUtils::CompareChildNoes()` and `nsContentUtils::CompareChildOffsetAndChildNode()` handle unassigned node of a shadow host r=jjaschke\n\nWe compare the default fallback content of a `\u003cslot\u003e` which has some\nassigned nodes, but we don't do that for the unassigned nodes of a\nshadow host. This patch adds the unassigned case to the special\nhandling paths and fixes the assertion of checking the`CompareChildNodes`\nresult.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311773\n", "files": ["dom/base/nsContentUtils.cpp", "testing/web-platform/tests/selection/crashtests/selection-add-range-collapsed-in-unassigned-node-and-shadow-has-no-content.html"], "git_node": "58ba733441581b3e3c6036ea409f3f3e5ecc0bdd", "git_parents": ["e36706aabccdac8e1fdefcaf1a4c1bd371aefd42"], "node": "d1e7641335f220e4bf368cf0c38119818d0c7b96", "parents": ["c60a9feb5ed87b69f5d4917e1e7da51c48f3b973"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2055977 - Add the reported testcase r=jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313155\n", "files": ["testing/web-platform/tests/selection/crashtests/selection-setBaseAndExtent-unassigned-nodes-backward.html"], "git_node": "8fc57c2796c637c885c9b4acf0faaa9ef26a94c9", "git_parents": ["58ba733441581b3e3c6036ea409f3f3e5ecc0bdd"], "node": "b1aa9c9ef43282e9c95e2a6ef922c288784c02ef", "parents": ["d1e7641335f220e4bf368cf0c38119818d0c7b96"], "tags": []}, {"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050531 - add JSWindowActor pair for theme-picker r=mstriemer,maxx\" for causing bc failures in browser_all_files_referenced.js\n\nThis reverts commit c6c6e69e04fb1d779f041949807a70fb970704ae.\n", "files": ["browser/actors/ThemePickerChild.sys.mjs", "browser/actors/ThemePickerParent.sys.mjs", "browser/actors/moz.build", "browser/components/DesktopActorRegistry.sys.mjs", "toolkit/content/jar.mn", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs"], "git_node": "f189951e3efb03f5846869170f8cfe79fa6e34d8", "git_parents": ["8fc57c2796c637c885c9b4acf0faaa9ef26a94c9"], "node": "81e16b8b160978895af87d9470e428747b0f3331", "parents": ["b1aa9c9ef43282e9c95e2a6ef922c288784c02ef"], "tags": []}], "date": 1784694453, "git_changesets": ["19821d1b10d2b71e614b9157da1a09be3ad7f3a3", "073d5b310a5fe77ebc69715888f721ea5f4b6c07", "28c225ed1898982a757575599f4cc037284635a2", "12e253825393b23a9c17f8ceb2136dfdadc98aeb", "01339ac9c32f73cfd6a5d9e1686b50a8ff65883f", "73e34a3371f221d839262613ff2a7ec9f028194d", "ab3d94761bab36103a2707915dbcc1b5b79b482e", "5d20d2ac7c964b889f5a77b86044e69b2708272e", "3bd9941eb3f52fd64b1486a391c0bce2358f69b1", "19e86ad5e6b76b26b856e8ea043d380b51d7480f", "edfc3055ca4641d7e4edf8ef76872195b82f7c85", "a613fa40d1163705f794c023ab