.services.mozilla.com/D298112\n", "files": ["dom/serviceworkers/ServiceWorkerContainer.cpp", "dom/serviceworkers/ServiceWorkerManager.cpp", "dom/serviceworkers/ServiceWorkerOp.cpp", "dom/serviceworkers/ServiceWorkerRegistrar.cpp", "dom/serviceworkers/ServiceWorkerScriptCache.cpp", "dom/serviceworkers/ServiceWorkerUtils.cpp"], "git_node": "991aca4adda5705d7348e8dc813dc1224a8afa0f", "git_parents": ["b65f513f584ee2928d70ee5b5501d40ed464c9f9"], "node": "63533f38ca6e5767ee311c68c281e1593b61f0a5", "parents": ["5c69448c85ac10072d66d9891893ef59eab28fd4"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2036402 - Apply std::move in dom/canvas where values can be moved instead of copied r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298098\n", "files": ["dom/canvas/CanvasRenderingContext2D.cpp", "dom/canvas/CanvasUtils.cpp", "dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLShaderValidator.cpp", "dom/html/HTMLSelectElement.cpp"], "git_node": "fabfea0b8670a7a669652d90f8f61aade8c3df63", "git_parents": ["991aca4adda5705d7348e8dc813dc1224a8afa0f"], "node": "62ac024013599588ba00c5e6225e8894fec57548", "parents": ["63533f38ca6e5767ee311c68c281e1593b61f0a5"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056555 - Update PDF.js to 028c02f539a99542a2ef74aa463c7d81ecf9f6d1 r=calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313202\n", "files": ["toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "e9456e99eedbc5c066c26c70500800d4a30bce7f", "git_parents": ["fabfea0b8670a7a669652d90f8f61aade8c3df63"], "node": "636dd60c8d7835db0fb9b2d164445cb9f72339eb", "parents": ["62ac024013599588ba00c5e6225e8894fec57548"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056240 - Update onboarding to use the updated colour tokens used in the Figma. r=android-reviewers,rebecatudor273\n\nThis patch updates:\n1. the card background colour\n2. The pagination dots\n\n| Dark mode | Light mode |\n| {F75722313} | {F75722321} |\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312994\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/MarketingDataOnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/TermsOfServiceOnboardingPage.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/ToolbarOnboardingPage.kt"], "git_node": "75b12ced93a954b4c937980e3756d9a23e344926", "git_parents": ["e9456e99eedbc5c066c26c70500800d4a30bce7f"], "node": "75df2de482e1cb1cd745fcef0c1fee02f4a8c11e", "parents": ["636dd60c8d7835db0fb9b2d164445cb9f72339eb"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056247 - Update onboarding pager spacing and card peek r=android-reviewers,rebecatudor273\n\nUpdate the onboarding pager to use the padding and peek values defined in the latest Figma designs.\n\n- The space between the visible card and the edge of the screen should be `24.dp`.\n- When a previous or next card is available, this space should be split into:\n  - `12.dp` spacing between adjacent cards.\n  - `12.dp` of the previous/next card visible as a peek.\n\nScreenshot device was 360dp width.\n\n{F75724780}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313019\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/view/OnboardingScreen.kt"], "git_node": "2c51918989c737e484bd9e5df2691b3211dcd53e", "git_parents": ["75b12ced93a954b4c937980e3756d9a23e344926"], "node": "f42864fcf1b4475fbcae4d098fb2fc2bede9deb4", "parents": ["75df2de482e1cb1cd745fcef0c1fee02f4a8c11e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2044483 - Remove ClocksRowWidget registry wrapper so handleUserInteraction is wired up r=thecount\" for causing failures at Clocks.test.jsx\n\nThis reverts commit 972d30e09e46e5269e83fa22349c1a581f8398ea.\n\nRevert \"Bug 2044483 - Add widgets.clocks.interaction pref and wire up handleUserInteraction in Clocks widget. r=maxx\"\n\nThis reverts commit 997f3ff865140c4d07eea5081e0226123cce67ca.\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/Clocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetsComponentRegistry.jsx", "browser/extensions/newtab/data/content/activity-stream.bundle.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Clocks.test.jsx"], "git_node": "e715aa69e0d68bf497f169e5e8066609786b3367", "git_parents": ["2c51918989c737e484bd9e5df2691b3211dcd53e"], "node": "85848fb2b3343d3c89cf41f636bce00901345f3b", "parents": ["f42864fcf1b4475fbcae4d098fb2fc2bede9deb4"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027278 - Compute data offset in uintptr_t. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313193\n", "files": ["gfx/gl/GLUploadHelpers.cpp"], "git_node": "9ee7c4c8a02db47939f59fda4c67b660e60c8acb", "git_parents": ["e715aa69e0d68bf497f169e5e8066609786b3367"], "node": "f782442f505bfe42c0d40c41f0cc5827ba5e2089", "parents": ["85848fb2b3343d3c89cf41f636bce00901345f3b"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021386 - Vendor in latest skv changes. r=mak\n\nThe latest skv changes add the possibility to close a database\nconnection in the same thread where it was opened. This is useful for\nVFS and UDF implementations which perform actions at these life cycle\ndifferentiation points.\n\nThis feature is not needed to replace rkv with skv. By default, both\nimplementations automatically close connections, and the additional\npower of nsSQLiteKeyValueStore to close the connection explicitly\ncauses no backward compatibility issue for the existing rkv users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296420\n", "files": ["third_party/skv/moz.yaml", "third_party/skv/src/abort.rs", "third_party/skv/src/coordinator.rs", "third_party/skv/src/store.rs"], "git_node": "f4c617d544ad1809803fffd8c49f274a2c0fa4e0", "git_parents": ["9ee7c4c8a02db47939f59fda4c67b660e60c8acb"], "node": "30399a2e199ca7c73ebe4f46f99e518bd39c3c9d", "parents": ["f782442f505bfe42c0d40c41f0cc5827ba5e2089"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021386 - Convert importer tests to use pre-built rkv safe mode fixtures. r=mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D296412\n", "files": ["toolkit/components/kvstore/test/xpcshell/data/rkv-baz-bool-double-int.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-baz-bool-double.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-baz-bool.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-baz-double-int-string.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-baz-double-string.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-blarg-int.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-bork-string.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-foo-bar.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-foo-bool-int.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-foo-int.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-qux-double-blarg-int.bin", "toolkit/components/kvstore/test/xpcshell/data/rkv-qux-double.bin", "toolkit/components/kvstore/test/xpcshell/test_sqlite_kvstore.js"], "git_node": "e3d85f93f8c4fa0cabc4449f8452cddbb5c8bc3e", "git_parents": ["f4c617d544ad1809803fffd8c49f274a2c0fa4e0"], "node": "4ff4422041a3e6aa95a780dbd09c1c9e6b97649f", "parents": ["30399a2e199ca7c73ebe4f46f99e518bd39c3c9d"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054642: Fix favicons for ai-grouped-chip-container added via mentions panel r=flozia\n\n**Issue:** When we added context chips via the mentions menu (typing @ in the smartbar instead of adding via the + button), the favicons were lost and it displayed the default one.\n\n**Root cause:** The icon was never passed as an attribute when we got mentions.\n\n**Solution: ** Add the icon as an attribute. We wrap it around `getIconForUrl` replicating what happens in the smartbar input.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312599\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs"], "git_node": "341c6c1eb523df72f9a9045a17742c15558a6b69", "git_parents": ["e3d85f93f8c4fa0cabc4449f8452cddbb5c8bc3e"], "node": "9178c72e2b7b0db5c6036f573d1e555191c688ee", "parents": ["4ff4422041a3e6aa95a780dbd09c1c9e6b97649f"], "tags": []}, {"author": "Nathan Leuz \u003cnmleuz@gmail.com\u003e", "branch": "default", "desc": "Bug 2053550 - Remove unused legacy preference browser.translation.neverForLanguages. r=florian\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312569\n", "files": ["browser/app/profile/firefox.js"], "git_node": "397310cde46684cf22289080a0b8aef0415b3210", "git_parents": ["341c6c1eb523df72f9a9045a17742c15558a6b69"], "node": "e912410f6aa20508144b5cae73c99f611bdbd524", "parents": ["9178c72e2b7b0db5c6036f573d1e555191c688ee"], "ta