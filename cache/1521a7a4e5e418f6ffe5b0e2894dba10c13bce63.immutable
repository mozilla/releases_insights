, "testing/web-platform/meta/webrtc/RTCRtpTransceiver-setCodecPreferences.html.ini", "testing/web-platform/meta/webrtc/RTCRtpTransceiver-stopping.https.html.ini", "testing/web-platform/meta/webrtc/RTCRtpTransceiver.https.html.ini", "testing/web-platform/meta/webrtc/RTCSctpTransport-maxMessageSize.html.ini", "testing/web-platform/meta/webrtc/RTCTrackEvent-fire.html.ini", "testing/web-platform/meta/webrtc/RollbackEvents.https.html.ini", "testing/web-platform/meta/webrtc/__dir__.ini", "testing/web-platform/meta/webrtc/getstats.html.ini", "testing/web-platform/meta/webrtc/legacy/RTCRtpTransceiver-with-OfferToReceive-options.optional.https.html.ini", "testing/web-platform/meta/webrtc/legacy/munge-dont.html.ini", "testing/web-platform/meta/webrtc/legacy/simplecall_callbacks.optional.https.html.ini", "testing/web-platform/meta/webrtc/no-media-call.html.ini", "testing/web-platform/meta/webrtc/protocol/bundle.https.html.ini", "testing/web-platform/meta/webrtc/protocol/codecs-filtered-by-direction.https.html.ini", "testing/web-platform/meta/webrtc/protocol/codecs-subsequent-offer.https.html.ini", "testing/web-platform/meta/webrtc/protocol/dtls-certificates.html.ini", "testing/web-platform/meta/webrtc/protocol/msid-generate.html.ini", "testing/web-platform/meta/webrtc/protocol/msid-parse.html.ini", "testing/web-platform/meta/webrtc/protocol/rtp-clockrate.html.ini", "testing/web-platform/meta/webrtc/protocol/rtp-demuxing.html.ini", "testing/web-platform/meta/webrtc/protocol/simulcast-offer.html.ini", "testing/web-platform/meta/webrtc/protocol/split.https.html.ini", "testing/web-platform/meta/webrtc/protocol/video-codecs.https.html.ini", "testing/web-platform/meta/webrtc/protocol/vp8-fmtp.html.ini", "testing/web-platform/meta/webrtc/recvonly-transceiver-can-become-sendrecv.https.html.ini", "testing/web-platform/meta/webrtc/rtp-stats-lifetime.https.html.ini", "testing/web-platform/meta/webrtc/simplecall-no-ssrcs.https.html.ini", "testing/web-platform/meta/webrtc/simplecall.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/av1.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/basic.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/h264.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/screenshare.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/setParameters-active.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/setParameters-encodings.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/setParameters-maxFramerate.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/vp8.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/vp9-scalability-mode.https.html.ini", "testing/web-platform/meta/webrtc/simulcast/vp9.https.html.ini", "testing/web-platform/meta/webrtc/toJSON.html.ini", "testing/web-platform/mozilla/meta/webrtc/RTCPeerConnection-active-inactive-transceivers-bundle-no-mid-no-ssrcs.https.html.ini", "testing/web-platform/mozilla/meta/webrtc/RTCPeerConnection-stale-offer-with-active-msection.https.html.ini", "testing/web-platform/mozilla/meta/webrtc/__dir__.ini"], "git_node": "fe0bcbdfa0ca46cd380e8fe8efdd7a372c6d2f7c", "git_parents": ["5242e6d6546adeebcd9b3ae46498ba0c94656bb0"], "node": "a2dd69ce88cddbc93701f3dbb799272de56b784b", "parents": ["9c5df4cb2fbd60ac9e66ca19c2a42a7957284408"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2054135: Teach taskcluster to match subsuite paths based on prefix. r=taskgraph-reviewers,linter-reviewers,sylvestre,jcristau\n\nAlso, fix bug where only the first wpt path supplied by the user would\ndetermine whether a job was selected.\n\nAlso, fix bug where subsuite matching was not being properly applied for\nwpt in testing/web-platform/mozilla/tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312519\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/test/test_util_chunking.py", "taskcluster/gecko_taskgraph/transforms/test/chunk.py", "taskcluster/gecko_taskgraph/util/chunking.py", "tools/lint/wpt-subsuite-tagging/__init__.py"], "git_node": "41c8d699672814b0291bc3d7bd8f6f8e643d5a88", "git_parents": ["fe0bcbdfa0ca46cd380e8fe8efdd7a372c6d2f7c"], "node": "80b4edb90be49c8692e0f674c017083aa297a67a", "parents": ["a2dd69ce88cddbc93701f3dbb799272de56b784b"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2054135: Add a webrtc wpt subsuite. r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312520\n", "files": ["taskcluster/gecko_taskgraph/util/chunking.py", "taskcluster/kinds/web-platform-tests/kind.yml", "taskcluster/test_configs/test-sets.yml", "tools/lint/wpt-subsuite-tagging/__init__.py"], "git_node": "5b903246ee99ffe9012e68238e83a21194437cee", "git_parents": ["41c8d699672814b0291bc3d7bd8f6f8e643d5a88"], "node": "bba6cf9662c3d1d94cdfdb07d7431c54d90df989", "parents": ["80b4edb90be49c8692e0f674c017083aa297a67a"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2054135: Update wpt-subsuite-tagging linter tests to cover prefix matching instead of substring matching. r=linter-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312574\n", "files": ["tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/meta/webgpu-with-dir-tag/__dir__.ini", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/meta/webgpu-with-file-tag/test.html.ini", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/meta/webgpu-with-variant-tag/__dir__.ini", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/meta/with-dir-tag/webgpu/__dir__.ini", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/meta/with-file-tag/webgpu/test.html.ini", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/meta/with-variant-tag/webgpu/__dir__.ini", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/not-subsuite-webgpu/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/not-subsuite/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/untagged/webgpu/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/webgpu-untagged/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/webgpu-with-dir-tag/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/webgpu-with-file-tag/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/webgpu-with-variant-tag/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/with-dir-tag/webgpu/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/with-file-tag/webgpu/test.html", "tools/lint/test/files/wpt-subsuite-tagging/testing/web-platform/tests/with-variant-tag/webgpu/test.html", "tools/lint/test/test_wpt-subsuite-tagging.py"], "git_node": "4e35061be009b4993c7d6cf8fca2d36ba827899b", "git_parents": ["5b903246ee99ffe9012e68238e83a21194437cee"], "node": "936cca8911bad057ebf194bbc9bd658fb6eafe09", "parents": ["bba6cf9662c3d1d94cdfdb07d7431c54d90df989"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2001734 - Add a policy for launch on login. r=tgiles,iholmes,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313712\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_launch_on_login.js", "browser/locales/en-US/browser/policies/policies-descriptions.ftl", "toolkit/modules/WindowsLaunchOnLogin.sys.mjs"], "git_node": "36f07fb64a30e9951d44306a08c7180d81545c2f", "git_parents": ["4e35061be009b4993c7d6cf8fca2d36ba827899b"], "node": "4f8d2e44c95a4d1251d643021073a781326a6618", "parents": ["936cca8911bad057ebf194bbc9bd658fb6eafe09"], "tags": []}, {"author": "Maile Lucks \u003cmaile.lucks@gmail.com\u003e", "branch": "default", "desc": "Bug 2059112 - Flip mistral pref to true - r=pdahiya,cdipersio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315091\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_firstrun.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartbar_model_select.js", "browser/components/aiwindow/ui/test/xpcshell/test_ChatModelChoice.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_selection.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_selection_custom.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_model_settings_custom.js", "browser/components/preferences/tests/aiFeatures/browser_aiFeatures_smart_window_telemetry.js"], "git_node": "9d6ec86301d248a6ad6178eb834ec0ef8813adbe", "git_parents": ["36f07fb64a30e9951d44306a08c7180d81545c2f"], "node": "9ec8b277b763d5f66ac3f82cbf413e2beda61e80", "parents": ["4f8d2e44c95a4d1251d643021073a781326a6618"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049647: Fix memories panel width when inside of the sidebar r=mlucks\n\nUpdates based on the ticket + UX/Yulia requests:\n\nBoth:\n- Using button tokens on the host of the footer instead of re-defining tokens on both files.\n\nFooter:\n- All icons have the same text and background colors.\n\nApplied-memories-button:\n  - Only shows the text when the sidebar width is over 250px, otherwise behaves just like the other footer buttons\n  - Show button that was hidden in Nova\n  - Max-width is the minimum between the parent container and 400px\n  - Make its height the same as the other buttons\n  - Left align all popover/panel buttons\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314469\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-footer/applied-memories-button.css", "browser/components/aiwindow/ui/components/ai-chat-content/chat-assistant-footer/assistant-message-footer.css", "browser/components/aiwindow/ui/content/ai-window-shared.css"], "git_node": "f71cf1e25effcc9a0e8bae6cab083a82940356bb", "git_parents": ["9d6ec86301d248a6ad6178eb834ec0ef8813adbe"], "node": "df2f4a2b68ca14cd2430802102c6d58820bb0f8b", "parents": ["9ec8b277b763d5f66ac3f82cbf413e2beda61e80"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046964 Part 1 - Always cache first-continuation/first-in-flow itself. r=layout-reviewers,emilio\n\nBug 2053578 implicitly introduced caching mFirstInFlow on first-in-flow itself\nwhen the frame is changing from fluid to non-fluid. This patch generalizes the\nidea such that a first-continuation/first-in-flow caches itself all the time.\n\nThis is also a prerequisite for Part 2 to propagate the cache value directly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315651\n", "files": ["layout/generic/nsSplittableFrame.cpp", "layout/generic/nsSplittableFrame.h"], "git_node": "7137ae1f4afa241e287c979e38a75c74cef78796", "git_parents": ["f71cf1e25effcc9a0e8bae6cab083a82940356bb"], "node": "fb579058ecd1eb9191aa4b7c3e29aa6f047c5580", "parents": ["df2f4a2b68ca14cd2430802102c6d58820bb0f8b"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046964 Part 2 - Propagate cache value from prev-continuation/prev-in-flow. r=layout-reviewers,emilio\n\nAssume we have a continuation chain C0, C1, C2, C3, C4. The mFirstContinuation\ncache invariant can be violated via the following steps:\n\n1. Remove C0, then C1 self-caches. C2, C3, C4's cache purged.\n\n2. Remove C3, then C2-\u003eFirstContinuation() slow-walks to C1, C4 caches C1 while\n   C2's cache stays null.\n\n3. Remove C1, then C2 becomes new first-continuation. It skips purging C4's\n   cache because its old cache is already null, leaving C4's cache pointing\n   to the removed C1.\n\nThis patch fixes this by propagating the prev-continuation's cache value\ndirectly, whether the cache is valid or purged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315652\n", "files": ["layout/generic/nsSplittableFrame.cpp", "layout/generic/nsSplittableFrame.h", "testing/web-platform/tests/css/css-multicol/crashtests/nested-multicol-spanner-reframe.html"], "git_node": "074ecbb7d397b5235ea8cd7d68309ff452a7d281", "git_parents": ["7137ae1f4afa241e287c979e38a75c74cef78796"], "node": "ac9f46278b685cdf2aa430e1e521ef26a626cc7e", "parents": ["fb579058ecd1eb9191aa4b7c3e29aa6f047c5580"], "tags": []}, {"author": "Dan Masquelier \u003cdancrew32@gmail.com\u003e", "branch": "default", "desc": "Bug 1735300 - Do not present MP4 edit-list preroll before media start. r=alwu\n\nMP4 edit lists can require decoding samples before the presentation timeline starts. Those samples are decoder dependencies, not visible presentation frames.\n\nWhen positive edit-list media time produces negative demux timestamps, keep the metadata and published buffered timeline anchored at zero. MediaFormatReader discards fully pre-timeline decoded video frames while keeping the original request pending, avoiding a promise chain for long pre-roll. ReaderProxy clips frames that span the media start without changing their end.\n\nThis keeps audio audible and the correct video frame available at currentTime 0, and aligns Firefox with Chrome and edit-list-aware media tooling. Regression coverage includes metadata, audio, frame-boundary, long pre-roll, mixed-track start-time, video-only buffered-range, and VP9/FLAC Web Audio cases.\n\nThe committed integration fixture was generated with ffmpeg 8.0.1 from a 160x96, 24 fps VP9 testsrc2 stream encoded as one long GOP, then stream-copied from the non-keyframe position at 1.55 seconds and muxed with a one-second, 48 kHz, 1 kHz FLAC tone. ffprobe reports the first video packet at -1.583333 seconds, the first audio packet at 0, and video edit-list media time 19046 at timescale 12288.\n\nSee https://bugzilla.mozilla.org/show_bug.cgi?id=1735300.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308433\n", "files": ["dom/media/MediaFormatReader.cpp", "dom/media/ReaderProxy.cpp", "dom/media/gtest/TestMediaFormatReader.cpp", "dom/media/test/bug1735300-vp9-flac-edit-list.mp4", "dom/media/test/mochitest.toml", "dom/media/test/mochitest_bugs.toml", "dom/media/test/rms-utils.js", "dom/media/test/test_bug1735300.html", "dom/media/test/test_captureStream_audioLoopBack.html"], "git_node": "ef74c0e5d876facec80c7e428ba41f303aa47d2f", "git_parents": ["074ecbb7d397b5235ea8cd7d68309ff452a7d281"], "node": "bdeb69dd473dcd8d0abb942c5b8bf30dac26aef5", "parents": ["ac9f46278b685cdf2aa430e1e521ef26a626cc7e"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 1993704 - click cert error page buttons directly in browser_webauthn_cert_override.js. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315108\n", "files": ["dom/webauthn/tests/browser/browser_webauthn_cert_override.js"], "git_node": "cf04f0bd67a0079b9745e4dd184a9000b833881b", "git_parents": ["ef74c0e5d876facec80c7e428ba41f303aa47d2f"], "node": "5b28e08fffa0512d93bc12e34265773058eb3a8b", "parents": ["bdeb69dd473dcd8d0abb942c5b8bf30dac26aef5"], "tags": []}, {"author": "Akhil Pindiprolu \u003capindiprolu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047027 - [Ungrouping] Add new menu item to 3 dot menu r=android-reviewers,android-l10n-reviewers,calu,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314410\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupCardTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/tabgroups/TabGroupListTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/ExpandedTabGroup.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabgroups/TabGroupCard.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabManagementFeatureHelper.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/TabsTrayTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabitems/SharedTabItemUi.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabGroupList.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/tabstray/ui/tabpage/TabLayout.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/tabgroups/ExpandedTabGroupTest.kt"], "git_node": "39b1f2027aaa70fe8294eb99300fd5450d24fa9c", "git_parents": ["cf04f0bd67a0079b9745e4dd184a9000b833881b"], "node": "363cf0c321bfbeee4cbf8bc1076ec0aeda4e4b0d", "parents": ["5b28e08fffa0512d93bc12e34265773058eb3a8b"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055710 - Enable the Audio Session API on Nightly. r=webidl,media-playback-reviewers,smaug,chunmin\n\nTurn on the navigator.audioSession surface, its state changes, and the block on\na page starting its own audio while the platform has that audio interrupted, so\nthe feature gets real-world exposure on Nightly while staying off on Beta and\nRelease.\n\nAlso let GeckoView shape its platform audio-focus request after the session\ntype. Without it the type a page picks would reach no platform at all, because\nGeckoView is its only consumer and desktop has none, leaving the type observable\nonly through telemetry.\n\nExposing the API also puts an AudioSession global on Nightly, which the\ninterface exposure test tracks.\n\nhttps://w3c.github.io/audio-session/\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315078\n", "files": ["dom/tests/mochitest/general/test_interfaces.js", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "ab8b89a805340219374d48546f6cbba6bd11e6c8", "git_parents": ["39b1f2027aaa70fe8294eb99300fd5450d24fa9c"], "node": "c876d3ab418987bc97f9e0bd9217091bc3bf3fb7", "parents": ["363cf0c321bfbeee4cbf8bc1076ec0aeda4e4b0d"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055710 - Rename the Windows platform audio session class and its files. r=win-reviewers,handyman,gstoll\n\nRename the Windows volume-mixer session class and its source files so they no\nlonger share a name with the Audio Session API's DOM class. The class is\nprivate to its source file and the header's only includer is updated, so no\nother callers change.\n\nThe refcount leak-logging table is keyed on the bare class name, so the two\nshared one entry. Their instance sizes differ, which trips an assertion once\nboth are alive in the parent process. Enabling the API on Nightly did that,\ncrashing mochitest-chrome-1proc c2 and mochitest-devtools-chrome dt3 on\nwindows11-64-25h2 debug [1].\n\n[1] https://treeherder.mozilla.org/jobs?repo=autoland&revision=e73ca8fedd6dbf9c5439c7c229ed7110ef146041\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315645\n", "files": ["layout/build/nsLayoutStatics.cpp", "widget/windows/AudioSession.cpp", "widget/windows/AudioSession.h", "widget/windows/WinAudioSession.cpp", "widget/windows/WinAudioSession.h", "widget/windows/moz.build"], "git_node": "03533c9a2c2adc2923434e0b732380c26756fc5c", "git_parents": ["ab8b89a805340219374d48546f6cbba6bd11e6c8"], "node": "c6eb1bce16d61d7d44e3225ea158d8905c207b69", "parents": ["c876d3ab418987bc97f9e0bd9217091bc3bf3fb7"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2058339 - Don't let address form telemetry recorded by earlier tests leak into browser_ml_heuristics.js, r=credential-management-reviewers,NeilDeakin.\n\nassertTelemetry only reset FOG at the end of each task, so the first task read\nwhichever detected_address_form event was already in the store. In the\nformautofill browser chunk, browser_label_matching.js detects an address form\n21s earlier and nothing resets FOG in between, so events[0] was that test's\nevent and each extra key comparison failed.\n\nAlso fix the pref name in add_setup, which was spelled \"useml.succeeded\" and\nmade the pushPrefEnv call a no-op, and set the pref through pushPrefEnv in\nonTestComplete so that it no longer leaks to the rest of the chunk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315643\n", "files": ["browser/extensions/formautofill/test/browser/browser_ml_heuristics.js"], "git_node": "758c2881c1b3abf7fbb9eccaec0caad940da3746", "git_parents": ["03533c9a2c2adc2923434e0b732380c26756fc5c"], "node": "133a9001b7e6ec6eee4877e7df680ae149d8180b", "parents": ["c6eb1bce16d61d7d44e3225ea158d8905c207b69"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2043000 - Support block-ellipsis values for line-clamp markers. r=dshin,layout-reviewers\" for causing wr tests failures at block-ellipsis-034.html\n\nThis reverts commit 5242e6d6546adeebcd9b3ae46498ba0c94656bb0.\n", "files": ["layout/generic/TextOverflow.cpp", "layout/generic/TextOverflow.h", "layout/generic/nsBlockFrame.cpp", "layout/generic/nsBlockFrame.h", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-023.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/block-ellipsis-024.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-034.html.ini", "testing/web-platform/tests/css/css-overflow/line-clamp/block-ellipsis-038.html", "testing/web-platform/tests/css/css-overflow/line-clamp/reference/block-ellipsis-038-ref.html"], "git_node": "b2a8ab19005eb8340e906bfa7c22d6cd7626fcd6", "git_parents": ["758c2881c1b3abf7fbb9eccaec0caad940da3746"], "node": "0453fc3a7211f5ab54392c6076ed3f3839f97ccd", "parents": ["133a9001b7e6ec6eee4877e7df680ae149d8180b"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 1: Add tests for push subscribes r=asuth\n\nThis mostly copies the same tests from notifications.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315057\n", "files": ["testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini", "testing/web-platform/meta/push-api/worker-subscribe.https.window.js.ini", "testing/web-platform/tests/push-api/cross-origin-nested.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-same-site-request.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/cross-origin-serviceworker.tentative.https.sub.window.js", "testing/web-platform/tests/push-api/resources/cross-origin-nested-child.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-nested-parent.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-serviceworker-iframe.sub.html", "testing/web-platform/tests/push-api/resources/permission-helper.js", "testing/web-platform/tests/push-api/resources/permission-sw.js", "testing/web-platform/tests/push-api/resources/permission-worker.js", "testing/web-platform/tests/push-api/worker-subscribe.https.window.js"], "git_node": "64433826c29450f6c8756856cc21e306686c9bcf", "git_parents": ["b2a8ab19005eb8340e906bfa7c22d6cd7626fcd6"], "node": "7ac276e01c3ea022e01561a002f0f8eb4b94d39d", "parents": ["0453fc3a7211f5ab54392c6076ed3f3839f97ccd"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2059053 - Part 2: Disallow retrieving push subscription in partitioned worker r=asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315058\n", "files": ["dom/push/PushManager.cpp", "dom/push/test/mochitest.toml", "testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini"], "git_node": "fb6dbd6ed51d56ad24ca7d007f621d25c85f8457", "git_parents": ["64433826c29450f6c8756856cc21e306686c9bcf"], "node": "0e73a99c15fdf0de3757072d78bcd3b406fafaa2", "parents": ["7ac276e01c3ea022e01561a002f0f8eb4b94d39d"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058665 - Remove document element from parent node before appending. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315092\n", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h"], "git_node": "b947fd81928d82608ec7d761ecd748856dd8b813", "git_parents": ["fb6dbd6ed51d56ad24ca7d007f621d25c85f8457"], "node": "e67b721b90434a05107de59e75a731ded3d96ea2", "parents": ["0e73a99c15fdf0de3757072d78bcd3b406fafaa2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2050028 - Enable the Gecko profiler by default with low-overhead features when running mochitests, r=ahal,profiler-reviewers,canova.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308515\n", "files": ["testing/mochitest/runtests.py"], "git_node": "57360448c3c8b7016a829f26ed90d99385b0fb72", "git_parents": ["b947fd81928d82608ec7d761ecd748856dd8b813"], "node": "d708637eab2385ac489ab73c1a04dabcdbacc098", "parents": ["e67b721b90434a05107de59e75a731ded3d96ea2"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2050028 - Upload a profile when a plain mochitest test fails, r=ahal.\n\nPlain mochitest had no per-failure profile dump: the existing one lived\nonly in browser-test.js (browser-chrome), so the mochitest flavors that\nrun on Android never saved a profile on failure. Extract the profile\nwriting from uploadProfileArtifact into saveProfileToUploadDir() and the\nshared gating into shouldSaveFailureProfile(), then have the content-side\nplain mochitest runner gather and write the profile in the parent process\nvia SpecialPowers.spawnChrome before reporting test_end, mirroring\nbrowser-test.js. Use the shared gate in the xpcshell harness too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310991\n", "files": ["testing/mochitest/browser-test.js", "testing/mochitest/tests/SimpleTest/TestRunner.js", "testing/modules/TestProfilerArtifact.sys.mjs", "testing/xpcshell/head.js"], "git_node": "1859efb00a2c3d1cbdb4ddf8dd06b00ad49268b3", "git_parents": ["57360448c3c8b7016a829f26ed90d99385b0fb72"], "node": "79b6b14dea44eec696b52fde49f65652d46f2eda", "parents": ["d708637eab2385ac489ab73c1a04dabcdbacc098"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2058292 - Don't allocate when requesting a profiler buffer chunk, r=profiler-reviewers,canova.\n\nThe sampler thread collects each sample into a local ProfileChunkedBuffer backed by\na single pre-allocated chunk, so that it never allocates while the sampled thread is\nsuspended. When a sample overflowed that chunk, the buffer called RequestChunk to ask\nfor one \"for later\", and the std::function receiver captures a RefPtr, so it was\nheap-allocated. If the suspended thread happened to hold the allocator lock, the\nsampler blocked on it and the process deadlocked permanently.\n\nUse MoveOnlyFunction, which keeps a receiver this small in its inline storage, and\nstatic_assert that the receiver stays small enough for that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314486\n", "files": ["mozglue/baseprofiler/public/ProfileBufferChunkManager.h", "mozglue/baseprofiler/public/ProfileBufferChunkManagerSingle.h", "mozglue/baseprofiler/public/ProfileBufferChunkManagerWithLocalLimit.h", "mozglue/baseprofiler/public/ProfileChunkedBuffer.h"], "git_node": "98aa932f2c54a9409c8185826b9c7e20001348f0", "git_parents": ["1859efb00a2c3d1cbdb4ddf8dd06b00ad49268b3"], "node": "33502ec57aed3f2300d292357e1ca44d3c28ecdc", "parents": ["79b6b14dea44eec696b52fde49f65652d46f2eda"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2058208 r=win-reviewers,handyman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315348\n", "files": ["mozglue/misc/NativeNt.h", "mozglue/tests/TestNativeNt.cpp"], "git_node": "4d23f98bbb31d8a33d759d0f2f03c3aff283d561", "git_parents": ["98aa932f2c54a9409c8185826b9c7e20001348f0"], "node": "5f207dbb7d5f1fab4f9b79d0eedf578536f1d336", "parents": ["33502ec57aed3f2300d292357e1ca44d3c28ecdc"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2059819 - Reject more invalid characters in publicSuffix.isKnownSuffix r=willdurand\n\nThis includes two unit tests that failed before the patch:\n- `^.ck` depends on the `convertUTF8toACE` to `domainToASCII` change,\n  which is called from `ensureValidHostname`.\n- `*.ck` depends on the `*` validation that `ensureValidHostname` adds\n  on top of the `domainToASCII` call (the latter does not reject `*`).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315690\n", "files": ["toolkit/components/extensions/child/ext-publicSuffix.js", "toolkit/components/extensions/test/xpcshell/test_ext_publicSuffix.js"], "git_node": "5fe7d0d3aec7ce2c62862450cf6b9913f0959d84", "git_parents": ["4d23f98bbb31d8a33d759d0f2f03c3aff283d561"], "node": "7073ed9652cd944c2f7713c52bcbac5220c6f4b6", "parents": ["5f207dbb7d5f1fab4f9b79d0eedf578536f1d336"], "tags": []}, {"author": "Nikki Sharpley \u003cnsharpley@mozilla.c