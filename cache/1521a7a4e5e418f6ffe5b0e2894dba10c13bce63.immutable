ebrender/src/lib.rs", "gfx/wr/webrender/src/picture.rs", "gfx/wr/webrender/src/prepare.rs", "gfx/wr/webrender/src/profiler.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/render_target.rs", "gfx/wr/webrender/src/render_task_cache.rs", "gfx/wr/webrender/src/renderer/composite.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/resource_cache.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/spatial_tree.rs", "gfx/wr/webrender/src/texture_cache.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/wrench/Cargo.toml"], "git_node": "cd55416847d2c27e66333bf9ca898b4a98c903c6", "git_parents": ["5724df452dc119abee39b59e451a47ada58110fd"], "node": "87a550c639ba3b3210d5bc8b0c45ad8cdacf2a49", "parents": ["08da82e0aedfc2a8337fb974d5fb67939b98b7e5"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057778 - Verify target document after ancestor revealing algorithm in GoToAnchor. r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314590\n", "files": ["layout/base/PresShell.cpp"], "git_node": "17062a84ca5d4fe5ba36e8587ce7364c0161bd84", "git_parents": ["cd55416847d2c27e66333bf9ca898b4a98c903c6"], "node": "3007fb18650f43042085957771735bb1fd875c83", "parents": ["87a550c639ba3b3210d5bc8b0c45ad8cdacf2a49"], "tags": []}, {"author": "Luk\u00e1\u0161 Lipinsk\u00fd \u003c6032558+Mr-Tao@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 1716579 - Trim transient WebRender resources when windows are paused. r=nical,gfx-reviewers\n\nRelease inactive pooled render targets when RendererOGL enters its paused\nstate, and optionally trim transient upload buffers behind a default-disabled\npreference. Discard the published document before texture frees and invalidate\nthe backend frame so Resume publishes a replacement.\n\nAdd a Wrench rawtest covering a queued pre-trim document followed by forced\nframe generation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313291\n", "files": ["gfx/webrender_bindings/RendererOGL.cpp", "gfx/webrender_bindings/RendererOGL.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/internal_types.rs", "gfx/wr/webrender/src/render_api.rs", "gfx/wr/webrender/src/render_backend.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/wrench/src/rawtest.rs", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "69966471062e50c5df881f3c0010485a64245569", "git_parents": ["17062a84ca5d4fe5ba36e8587ce7364c0161bd84"], "node": "c7bdabdad2fc6899c271260317c8036b70a4578a", "parents": ["3007fb18650f43042085957771735bb1fd875c83"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 1716579 - Set gfx.webrender.trim-paused-renderers.mode to 2. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314027\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "f6b33741639339d9c87eb603c7ca1077e49eaaae", "git_parents": ["69966471062e50c5df881f3c0010485a64245569"], "node": "7c5418cb5bab424f1f8cb6c3cd3a0a7db9dcd947", "parents": ["c7bdabdad2fc6899c271260317c8036b70a4578a"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2058416. Don't call num_completed_passes because jxl-rs no longer exposes it. r=saschanaz\n\njxl-rs 0.5 no longer exposes this and we were only using it for logging so just remove the use of it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314553\n", "files": ["image/rust/jxl/src/decoder.rs", "image/rust/jxl/src/ffi.rs"], "git_node": "7ed0910ddbb04f2b75200cfbb9ce3e9705b698ec", "git_parents": ["f6b33741639339d9c87eb603c7ca1077e49eaaae"], "node": "83d13ff6e80d1aeffda8d57692e10a1f37