54cf22"], "node": "aee51b0ff455167d6c4599982528fd919da1049a", "parents": ["d74e288e47e9f02a8cc51ec46cfa4aee908a8d71"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2055774 - Document JSON Viewer JSONL support r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312674\n", "files": ["devtools/docs/user/json_viewer/index.md"], "git_node": "db1301d2bc20956013dda60c46781f5fe0e07225", "git_parents": ["73a45282103f9a9edd3c40ff57f03edd2ca18061"], "node": "75b28caf059f3405f2c52227e6f2bedabaa14fe9", "parents": ["aee51b0ff455167d6c4599982528fd919da1049a"], "tags": []}, {"author": "Benoit Goupilleau \u003cbenoit.goupilleau@gmail.com\u003e", "branch": "default", "desc": "Bug 2055774 - Hide the Pretty Print button for JSONL documents in the JSON Viewer r=devtools-reviewers,nchevobbe\n\nPretty-printing a JSON Lines document is ill-defined: expanding each\nrecord over several lines breaks the one-record-per-line invariant of\nthe format. Hide the button instead, the same way it is already hidden\nfor invalid JSON.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314645\n", "files": ["devtools/client/jsonview/components/TextToolbar.mjs", "devtools/client/jsonview/test/browser_jsonview_jsonl.js"], "git_node": "85799112a910495fdda2b423f2289f2310873fcf", "git_parents": ["db1301d2bc20956013dda60c46781f5fe0e07225"], "node": "cba8d07f81c46f064436118c7766107e3c84912e", "parents": ["75b28caf059f3405f2c52227e6f2bedabaa14fe9"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049300 - [devtools] Only create tooltip helper instances when needed in TooltipsOverlay. r=devtools-reviewers,ochameau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311530\n", "files": ["devtools/client/inspector/rules/test/head.js", "devtools/client/inspector/shared/tooltips-overlay.js"], "git_node": "233219ee99139f3f8d479e0d0bcbd5c6bf58ed4a", "git_parents": ["85799112a910495fdda2b423f2289f2310873fcf"], "node": "ed6753e5c2d36e75bc9449075761ec038839658a", "parents": ["cba8d07f81c46f064436118c7766107e3c84912e"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060143 - Fix TypeScript issue in UrlbarTelemetryUtils.mjs. r=mbeier,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315955\n", "files": ["browser/components/urlbar/content/UrlbarTelemetryUtils.mjs"], "git_node": "edff1b29b4d2ba4d800fb2a4bdb299de32149730", "git_parents": ["233219ee99139f3f8d479e0d0bcbd5c6bf58ed4a"], "node": "39e8fc2419f5d96eb317fd9f36e62dd8438ca214", "parents": ["ed6753e5c2d36e75bc9449075761ec038839658a"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057504 - [WebCompat Reporter v3] 'Send' button should not be displayed in 'Report Preview' bottom sheet r=android-reviewers,calu,android-l10n-reviewers,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314005\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporterPreviewSheet.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "efcfb9e5dce3ce0285dc9396d545dd8c5e8efc98", "git_parents": ["edff1b29b4d2ba4d800fb2a4bdb299de32149730"], "node": "7db35eadaddf09b93fbf5f0b8293d898a7720498", "parents": ["39e8fc2419f5d96eb317fd9f36e62dd8438ca214"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057471 - Improve the container color icon, r=emilio,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315902\n", "files": ["browser/themes/shared/usercontext/container-editor.css", "tools/lint/stylelint/stylelint-plugin-mozilla/config.mjs"], "git_node": "b300d6500eb5e8344e88ec2ac3abace64c1016e4", "git_parents": ["efcfb9e5dce3ce0285dc9396d545dd8c5e8efc98"], "node": "5370e860a02c878c7c9e256c9ae646a515e20997", "parents": ["7db35eadaddf09b93fbf5f0b8293d898a7720498"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060012 - [wdspec] Add / fix meta timeout long for WebDriver privileged script execution tests r=Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315975\n", "files": ["testing/web-platform/mozilla/tests/webdriver/bidi/script/call_function/privileged.py", "testing/web-platform/mozilla/tests/webdriver/bidi/script/evaluate/privileged.py", "testing/web-platform/mozilla/tests/webdriver/classic/execute_script/privileged.py"], "git_node": "eb1170e2dac77e52fcac6a369d9ceec399b09055", "git_parents": ["b300d6500eb5e8344e88ec2ac3abace64c1016e4"], "node": "95f16432ad989e67b7b221468f740fed5e53d4b5", "parents": ["5370e860a02c878c7c9e256c9ae646a515e20997"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057886 - Stop reopening a tab per combination in browser_PBMCookieBehavior.js. r=timhuang\n\nThe test walks 36 cookieBehavior combinations and opened, then closed, a tab in\nboth a regular and a private window for each one. That made it slow enough to\nrun out of its timeout on code coverage builds. It is not really a Nova bug: the\ntest has a long intermittent timeout history (bug 1784658) and was already\nfailing on windows11-x86_64/ccov before browser.nova.enabled was turned on by\ndefault, so Nova only pushed an already marginal test over the limit.\n\nSplitting the loop into several add_task()s would not have helped, because the\ntimeout is armed once per file rather than per task.\n\nInstead reuse each window's existing tab and renavigate it, which is what a new\ndocument needs to pick up the prefs, and check both windows concurrently. Same\n144 assertions, roughly half the runtime locally. Also raise the timeout factor\nso coverage builds keep some headroom, and name the window in the assertion\nmessages, which were previously identical for both windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314911\n", "files": ["toolkit/components/antitracking/test/browser/browser.toml", "toolkit/components/antitracking/test/browser/browser_PBMCookieBehavior.js"], "git_node": "a0ff20312c61d250eb8706682c33f24efaf51ead", "git_parents": ["eb1170e2dac77e52fcac6a369d9ceec399b09055"], "node": "9ea9ba135ed4373b24a15ee3e16e69f32a591ac5", "parents": ["95f16432ad989e67b7b221468f740fed5e53d4b5"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060048 - Force revalidation of Vary: cookie subresources. r=arai\n\nI think this would fix the image, css, and script caches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315988\n", "files": ["dom/base/nsContentUtils.cpp"], "git_node": "4b53c716cbe588733960e7def74248dffd9af9d7", "git_parents": ["a0ff20312c61d250eb8706682c33f24efaf51ead"], "node": "43e06739d6f64a8b1e78a137197a828a80cd3cdc", "parents": ["9ea9ba135ed4373b24a15ee3e16e69f32a591ac5"], "tags": []}, {"author": "Sylvestre Ledru \u003csledru@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052666 - doc: md is now replacing rst r=firefox-source-docs-reviewers,ahal DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314840\n", "files": ["tools/moztreedocs/docs/adding-documentation.md"], "git_node": "4932a546c2abf49af9b870d44698a1224f9ada88", "git_parents": ["4b53c716cbe588733960e7def74248dffd9af9d7"], "node": "1f08a7baa1c52a9a719b4889e807548e936c88f0", "parents": ["43e06739d6f64a8b1e78a137197a828a80cd3cdc"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2060163 - Disable failing defaultSearchCodeDuckDuckGoUS UI test r=dpop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315993\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SearchTest.kt"], "git_node": "425d2e8eb747ae1740c792ffe5872397780fab9c", "git_parents": ["4932a546c2abf49af9b870d44698a1224f9ada88"], "node": "78fc7275c04280c00406decd316b8c566d60e5c9", "parents": ["1f08a7baa1c52a9a719b4889e807548e936c88f0"], "tags": []}, {"author": "Michel Le Bihan \u003cmichel@lebihan.pl\u003e", "branch": "default", "desc": "Bug 2057717 - Use distinct address bar icons for insecure connections and disabled tracking protection in Fenix r=petru,android-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315089\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/docs/gotchas.md", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/UnifiedTrustPanelPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/ToolbarSelectors.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/TabPreview.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/CustomTabBrowserToolbarMiddlewareTest.kt"], "git_node": "c7868140f08a08d48ae611e592a1b87948629eca", "git_parents": ["425d2e8eb747ae1740c792ffe5872397780fab9c"], "node": "505786ad995efe603303d4f3d9f86afb772d146b", "parents": ["78fc7275c04280c00406decd316b8c566d60e5c9"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058980 - Part 1: Add the ability to retrieve a time-bound visited window from a host. r=geckoview-reviewers,android-reviewers,tcampbell\n\nThis adds an API to the HistoryDelegate that lets us query whether a host was visited within a certain time range. That way we can accurately determine whether a host was visited before on the same day.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315015\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/history/HistoryTrackingDelegate.kt", "mobile/android/android-components/components/feature/session/src/main/java/mozilla/components/feature/session/HistoryDelegate.kt", "mobile/android/android-components/components/feature/session/src/test/java/mozilla/components/feature/session/HistoryDelegateTest.kt", "mobile/android/geckoview/api.txt", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/GeckoSession.java", "mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md", "mobile/shared/components/geckoview/GeckoViewHistory.cpp", "mobile/shared/components/geckoview/GeckoViewHistory.h"], "git_node": "333a849a4a5bae92ceeafaf6003b77c4a328e8be", "git_parents": ["c7868140f08a08d48ae611e592a1b87948629eca"], "node": "3b9d03d3bd17005b5bab6363aa64edb4ab972f2e", "parents": ["505786ad995efe603303d4f3d9f86afb772d146b"], "tags": []}, {"author": "Bas Schouten \u003cbschouten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058980 - Part 2: Add a codepath that works on GeckoView to determine first visit status. r=denispal\n\nThis allows us to get the first visit status and record the event asynchronously on mobile which is necessary for accessing the GeckoView API. Since this is executing in the parent process the risk of actually losing events here is small.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315016\n", "files": ["dom/ipc/ContentParent.cpp"], "git_node": "8ed794028e9aa7b10b3de68cc2c94e65249e37af", "git_parents": ["333a849a4a5bae92ceeafaf6003b77c4a328e8be"], "node": "8a112549567867aa3689a9866d9e9dec11984048", "parents": ["3b9d03d3bd17005b5bab6363aa64edb4ab972f2e"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2057579 - Complete the CSSTranslate implementation; r=emilio,firefox-style-system-reviewers\n\nComplete the remaining `CSSTranslate` functionality by implementing the missing\nattribute setters and `ToMatrix()`, adding constructor and setter argument\nvalidation, and enabling the corresponding WPT coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314859\n", "files": ["layout/style/typedom/CSSTransformComponent.cpp", "layout/style/typedom/CSSTranslate.cpp", "layout/style/typedom/CSSTranslate.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-2d-flattening.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-toMatrix-relative-units.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformComponent-toMatrix.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTranslate.tentative.html.ini"], "git_node": "5c6f4ca6a4b3394ed01f820c96ef017e01b20cd7", "git_parents": ["8ed794028e9aa7b10b3de68cc2c94e65249e37af"], "node": "b486951c29d5bcbc14e410afd73f80547f9b0d4a", "parents": ["8a112549567867aa3689a9866d9e9dec11984048"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2052401 - Guard AudioCallbackDriver::mAudioStream with a DataMutex. r=karlt\n\nAudioOutputLatency() reads mAudioStream from the main thread\n(AudioContext.getOutputTimestamp()), while Init() writes it on the\nCubebOperation thread with no synchronization.\n\nEvery other access to mAudioStream is already CubebOperation-thread-only,\nso wrap it in a DataMutex, matching the existing mFallback pattern in this\nfile, rather than e.g. caching a latency value (which can change over the\nstream's life). The real-time audio callback thread never touches\nmAudioStream, so this lock is never contended on that path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310300\n", "files": ["dom/media/GraphDriver.cpp", "dom/media/GraphDriver.h"], "git_node": "cf88c7c36b4a8edb64b197382279a0d1ff8dd161", "git_parents": ["5c6f4ca6a4b3394ed01f820c96ef017e01b20cd7"], "node": "8bae7e4737f53b49b123d3c67d76494bbfab57cd", "parents": ["b486951c29d5bcbc14e410afd73f80547f9b0d4a"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2052466 [wpt PR 61061] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=318066, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=318066 (#61061)\n--\n\nwpt-commits: c7fdee80f3f17b4e9813964916afdfd57ace863f\nwpt-pr: 61061\n", "files": ["testing/web-platform/tests/svg/animations/svgintegeroptionalinteger-animation-invalid-value-2.html", "testing/web-platform/tests/svg/animations/svgnumber-animation-invalid-value-2.html", "testing/web-platform/tests/svg/animations/svgnumber-to-animation-valid-value-1.html", "testing/web-platform/tests/svg/animations/svgnumberoptionalnumber-animation-invalid-value-2.html", "testing/web-platform/tests/svg/animations/svgpath-animation-invalid-value-2.html"], "git_node": "4d05dbd53fd21a223a50783ed1272f721cda89c8", "git_parents": ["cf88c7c36b4a8edb64b197382279a0d1ff8dd161"], "node": "27856421d595c9609f6ee964e6904cd24111312b", "parents": ["8bae7e4737f53b49b123d3c67d76494bbfab57cd"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060085 - [wpt-sync] Update web-platform-tests to c7fdee80f3f17b4e9813964916afdfd57ace863f, a=testonly\n\nMANUAL PU