frames in a second. Also the precision of setTimeout is not\nguaranteed, so measure the period during which we counted frames, for improved\naccuracy.\n\nThis also fixes a destructuring/nesting issue that resulted in us skipping the framerate\nchecks in one test case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316484\n", "files": ["testing/web-platform/mozilla/tests/mediacapture-streams/video-test-helper.js", "testing/web-platform/mozilla/tests/screen-capture/MediaStreamTrack-independent-clones.https.html"], "git_node": "7745f481d164e240f21684693873be7fc58dba07", "git_parents": ["1831b8eb2dcc1317a04a3ded7a2551681e0d60b6"], "node": "411ae043f4f4c1c7f893122a63e8d30eb41fe180", "parents": ["ead79ca900ae3b7fd28d7912ba240f5b4018c84e"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053925 - Part 1: Add the AI action confirmation component r=desktop-theme-reviewers,ngrato,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313473\n", "files": ["browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.css", "browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.mjs", "browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.stories.mjs", "browser/components/aiwindow/ui/content/aiChatContent.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_confirmation.js", "browser/components/aiwindow/ui/test/browser/test_ai_action_confirmation.mjs", "browser/components/aiwindow/ui/test/browser/test_ai_action_confirmation_page.html", "browser/themes/shared/icons/closed-tabs.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "ee47cd8a7889f2ddd50a8e10d206d9f60c4bbb5c", "git_parents": ["7745f481d164e240f21684693873be7fc58dba07"], "node": "9afea66d6a332aa488d5681706d0ee35c1c56736", "parents": ["411ae043f4f4c1c7f893122a63e8d30eb41fe180"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053925 - Part 2: Render NL browser actions with the action confirmation r=ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313474\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_chat_tool_ui.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_tab_close_integration.js"], "git_node": "5b7cc1a12a3fb035d9ecab4d4b36ec5386789a7d", "git_parents": ["ee47cd8a7889f2ddd50a8e10d206d9f60c4bbb5c"], "node": "937bc1d5ed49f882c8e4c522a4d21f73fa623cb1", "parents": ["9afea66d6a332aa488d5681706d0ee35c1c56736"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 1804108 - Remove obsolete mozJSComponentLoader Valgrind suppression. r=xpcom-reviewers,jstutte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316710\n", "files": ["build/valgrind/cross-architecture.sup"], "git_node": "560d5e8276cb19eef52e8d205894b34414fdd35c", "git_parents": ["5b7cc1a12a3fb035d9ecab4d4b36ec5386789a7d"], "node": "47276a55373b1fef603f855e18a97429fa646c5f", "parents": ["937bc1d5ed49f882c8e4c522a4d21f73fa623cb1"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060844 - Migrate verifyPDFFileIsOpenedInTheSameTabTest UI test to the efficiency framework r=jajohnson\n\nConverted the verifyPDFFileIsOpenedInTheSameTabTest UI test to the efficiency framework.\n\nThe new UI test successfully passed 50x on Firebase.  [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=75452  | Try ]]\nAll efficiency UI test successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=75451 | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316555\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/PDFViewerTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/PDFViewerTest.kt"], "git_node": "0b03fcd4596ab4065c495997a13f80805d941bb7", "git_parents": ["560d5e8276cb19eef52e8d205894b34414fdd35c"], "node": "c545fca58fc5729db5a5e6e95e99dcd289feb45f", "parents": ["47276a55373b1fef603f855e18a97429fa646c5f"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2030909 - [webdriver-bidi] Use \"browsingContext.reload\" when reloading iframes. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316576\n", "files": ["remote/webdriver-bidi/modules/root/browsingContext.sys.mjs", "testing/web-platform/meta/webdriver/tests/bidi/browsing_context/reload/frame.py.ini"], "git_node": "52bf4d39f392ed22efc397dfe0fe393ab5cdf0a9", "git_parents": ["0b03fcd4596ab4065c495997a13f80805d941bb7"], "node": "dc4f03374362d57c30fbd5a5ca192964179098f6", "parents": ["c545fca58fc5729db5a5e6e95e99dcd289feb45f"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059998 - [webdriver-bidi] Wait for the file to be released when sending \"browsingContext.downloadEnd\" event. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316210\n", "files": ["remote/shared/listeners/DownloadListener.sys.mjs"], "git_node": "c316b738774aafacd52b7a095801f0ad18bd397e", "git_parents": ["52bf4d39f392ed22efc397dfe0fe393ab5cdf0a9"], "node": "176d342b3d0b7ebb80e35cee7202520ab03dd317", "parents": ["dc4f03374362d57c30fbd5a5ca192964179098f6"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059998 - [wdspec] Generate a random filename for downloads so that downloads triggered by different tests don't conflict with each other. r=jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316212\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/browser/set_download_behavior/conftest.py"], "git_node": "116c749b63ad1c413822851c8af5851d4f96b8e7", "git_parents": ["c316b738774aafacd52b7a095801f0ad18bd397e"], "node": "8eaf99de57a2080a76d788512f0d8d5418c27c8a", "parents": ["176d342b3d0b7ebb80e35cee7202520ab03dd317"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2061070 - Key the configure compiler cache on the compiler rather than its wrapper. r=firefox-build-system-reviewers,sergesanspaille\n\nSome code paths led to try_invoke_compiler with the compiler wrapper\nadded to the compiler command rather than separately in the wrapper\nargument. When that happens, try_invoke_compiler is keying the cache on\nthe wrapper version rather than the compiler version, which leads to\nstale cache cases, especially when the compiler version changes compared\nto the previous build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316733\n", "files": ["build/moz.configure/toolchain.configure"], "git_node": "680234c423edab002bc836cd0b61c3909fd82c0d", "git_parents": ["116c749b63ad1c413822851c8af5851d4f96b8e7"], "node": "3fee671b9e7926f3c66d2433e22100784d2d657f", "parents": ["8eaf99de57a2080a76d788512f0d8d5418c27c8a"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2060817 - Expose lint hints in their output. r=linter-reviewers,sylvestre\n\nSeveral linters (gecko-trace, python-sites, clippy, ruff, eslint,\nlibpref) populate Issue.hint with a suggested remedy, but of the\nmozlint's formatters actually render it. The hint is only ever visible\nin the raw JSON output.\n\nRender it in the default \"stylish\" formatter, while deduplicating\nidentical hint text across a whole run (not just within one file), since\na lint that shares one generic hint across many findings would otherwise\nrepeat it verbatim after every single issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316509\n", "files": ["python/mozlint/mozlint/formatters/stylish.py", "python/mozlint/test/test_formatters.py"], "git_node": "2dbda43bf72504365d011bc8c506df1bb00b2b05", "git_parents": ["680234c423edab002bc836cd0b61c3909fd82c0d"], "node": "bc51efdcd1b4e9e4766a47ef639a0c2087e342e3", "parents": ["3fee671b9e7926f3c66d2433e22100784d2d657f"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2061096 - Report clang-tidy autotest failures instead of crashing. r=sylvestre\n\nWhen clang-tidy exits with an error, _run_analysis returns a bare None, but both\nits callers unpack the result into two names, so the unpacking itself raises\n\"TypeError: cannot unpack non-iterable NoneType object\" before the \"if issues is\nNone\" check that was meant to handle this.\n\nSince _verify_checker runs in a thread pool and autotest re-raises worker\nexceptions through future.result(), this doesn't just misreport a single\nchecker: it aborts the whole run at the first failing one, so any other checker\nfailing in the same run is never reported either.\n\nReturn a two-element tuple from that error path, decoding the output so it is\nreported as text rather than as a bytes repr. TOOLS_CHECKER_FAILED_FILE was also\nthe only checker error not recorded in checkers_results, and the only one\nwithout a branch in the reporting loop, which would have turned the crash into a\nfailure that doesn't say which checker failed, so record and report it too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316726\n", "files": ["python/mozbuild/mozbuild/code_analysis/mach_commands.py"], "git_node": "e8a3950e51c5019440acc1bef322400c24d2a960", "git_parents": ["2dbda43bf72504365d011bc8c506df1bb00b2b05"], "node": "8fc7ed0323a0465a9e6a6a939ea454b5af3b3f05", "parents": ["bc51efdcd1b4e9e4766a47ef639a0c2087e342e3"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "no bug - doc: fennec =\u003e fenix r=shtrom DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316557\n", "files": ["build/docs/mozinfo.md", "mots.yaml"], "git_node": "ea6dbeb61fa17716b2eb2829b0d39d847b5fc317", "git_parents": ["e8a3950e51c5019440acc1bef322400c24d2a960"], "node": "efc989c63c2423aa9f22c8c9f4b283a9873b0bb2", "parents": ["8fc7ed0323a0465a9e6a6a939ea454b5af3b3f05"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2061033 - Avoid std::all_of in nsAtom::ComputeIsAsciiLowercase. r=xpcom-reviewers,emilio\n\ngGkAtoms evaluates ComputeIsAsciiLowercase and HashString for all 2715 static\natoms within a single constant expression, which leaves it close to the default\n-fconstexpr-steps budget of 1048576 on every platform.\n\nlibc++ 22 made std::all_of noticeably more expensive to evaluate: for this\nworkload it went from ~227600 to ~343300 steps, about 1.5x. That was enough to\npush the total over the limit on the mingw builds, which are the only ones using\nthe libc++ that comes with the clang toolchain. Other platforms don't use it:\nlinux uses libstdc++, mac uses the libc++ from the SDK, and windows uses the\nMSVC STL.\n\nSteps required to evaluate the gGkAtoms initializer, before and after\nthis change:\n\n                                before      after\n    mingw clang 21 (libc++)     957616     729979\n    mingw clang 22 (libc++)    1073241     729979   \u003c- over the 1048576 limit\n    linux clang 21 (libstdc++)  939550     729979\n    linux clang 22 (libstdc++)  939550     729979\n\nSpelling out the loop takes the standard library out of the picture entirely:\nall four combinations now need the same 729979 steps, a little under 70% of the\nbudget, so this no longer depends on which standard library the target happens\nto use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316723\n", "files": ["xpcom/ds/nsAtom.h"], "git_node": "f1c33d7a09a8dbd25797c4c4436234e164165fd1", "git_parents": ["ea6dbeb61fa17716b2eb2829b0d39d847b5fc317"], "node": "c54aa6e7daf34a748411b4fa04041986b4ca3838", "parents": ["efc989c63c2423aa9f22c8c9f4b283a9873b0bb2"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2061102 - Add missing bug numbers and fix the incorrect test class names from the @Converted annotations r=isabel_rios\n\n1. Added missing bug numbers to @Converted annotations that were lacking them\n2. Fixed incorrect replacedBy class names pointing at the wrong efficiency test class/method\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316725\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/AddressAutofillTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/BookmarksTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CustomTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/LoginsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/NavigationToolbarExpandedTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/RecentlyClosedTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsHomepageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/UnifiedTrustPanelTest.kt"], "git_node": "e2ba20a5ce13b404c79aefcd4d1ada6237d1770e", "git_parents": ["f1c33d7a09a8dbd25797c4c4436234e164165fd1"], "node": "85033fe2d62afc67fd909768d8fa2db4c8e61f14", "parents": ["c54aa6e7daf34a748411b4fa04041986b4ca3838"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["tools/clang-tidy/test/modernize-use-transparent-functors.cpp", "tools/clang-tidy/test/modernize-use-transparent-functors.json"], "git_node": "ffee3e4adf1ecbf503e4c4ee45f261bb79b803f6", "git_parents": ["e2ba20a5ce13b404c79aefcd4d1ada6237d1770e", "ac91bfcce1bf3240e2dce40f47c372e76bc4f26c"], "node": "b52d329d05b8315a0473d7727793c5f5ce1bcaae", "parents": ["85033fe2d62afc67fd909768d8fa2db4c8e61f14", "716101f45c1c054546b3885536236ac356eb8ab1"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2053925 - Part 2: Render NL browser actions with the action confirmation r=ngrato\" for causing bc failures @ MouseEvent.cpp\n\nThis reverts commit 5b7cc1a12a3fb035d9ecab4d4b36ec5386789a7d.\n\nRevert \"Bug 2053925 - Part 1: Add the AI action confirmation component r=desktop-theme-reviewers,ngrato,dao\"\n\nThis reverts commit ee47cd8a7889f2ddd50a8e10d206d9f60c4bbb5c.\n", "files": ["browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.css", "browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.mjs", "browser/components/aiwindow/ui/components/ai-action-confirmation/ai-action-confirmation.stories.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/content/aiChatContent.html", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_confirmation.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_chat_tool_ui.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_tab_close_integration.js", "browser/components/aiwindow/ui/test/browser/test_ai_action_confirmation.mjs", "browser/components/aiwindow/ui/test/browser/test_ai_action_confirmation_page.html", "browser/themes/shared/icons/closed-tabs.svg", "browser/themes/shared/jar.inc.mn"], "git_node": "e7db5a9545978c7e19711fc07d2cedbf51a7faf5", "git_parents": ["ffee3e4adf1ecbf503e4c4ee45f261bb79b803f6"], "node": "aae83da8b38fccbc9284bd2f10fe3f67bfcc8a48", "parents": ["b52d329d05b8315a0473d7727793c5f5ce1bcaae"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060843 - Separate the test coverage of regular and compositor clips. r=gw\n\nWe started with only regular clips and the bulk of wrench tests that exercise\nclipping meant to test that code path and how it interracts with the rest of\nthe rendering pipeline. Later, composiotr clips were introduced and a lot of\nwrench tests silently switched to using that code path.\n\nCompositor clips re fairly simple and self-contained so covering them does not\nrequire a large amount of tests. This patch adds a debug flag to disable\ncompositor clips and enable it by default for wrench reftests. Moving the bulk\nof wrench reftests back to covering the original code path.\nA separate set of tests in wrench/reftests/compositor is added to test the\ncompositor clips explicitly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316525\n", "files": ["gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/tile_cache/slice_builder.rs", "gfx/wr/webrender_api/src/lib.rs", "gfx/wr/wrench/reftests/boxshadow/boxshadow-spread-only-ref.png", "gfx/wr/wrench/reftests/clip/sc-mask-with-blur.png", "gfx/wr/wrench/reftests/compositor-surface/underlay-mask-on-translucent-slice.png", "gfx/wr/wrench/reftests/compositor/clipped-out-ref.yaml", "gfx/wr/wrench/reftests/compositor/clipped-out.yaml", "gfx/wr/wrench/reftests/compositor/corner-shape-ref.yaml", "gfx/wr/wrench/reftests/compositor/corner-shape.yaml", "gfx/wr/wrench/reftests/compositor/elliptical-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/elliptical-radius.yaml", "gfx/wr/wrench/reftests/compositor/fractional-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/fractional-radius.yaml", "gfx/wr/wrench/reftests/compositor/larger-than-tile-ref.yaml", "gfx/wr/wrench/reftests/compositor/larger-than-tile.yaml", "gfx/wr/wrench/reftests/compositor/nested-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/nested-clip.yaml", "gfx/wr/wrench/reftests/compositor/per-corner-radius-ref.yaml", "gfx/wr/wrench/reftests/compositor/per-corner-radius.yaml", "gfx/wr/wrench/reftests/compositor/radius-clamped-ref.yaml", "gfx/wr/wrench/reftests/compositor/radius-clamped.yaml", "gfx/wr/wrench/reftests/compositor/rect-and-rounded-ref.yaml", "gfx/wr/wrench/reftests/compositor/rect-and-rounded.yaml", "gfx/wr/wrench/reftests/compositor/reftest.list", "gfx/wr/wrench/reftests/compositor/rotated-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/rotated-clip.yaml", "gfx/wr/wrench/reftests/compositor/rounded-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/rounded-clip.yaml", "gfx/wr/wrench/reftests/compositor/scrolled-clip-ref.yaml", "gfx/wr/wrench/reftests/compositor/scrolled-clip.yaml", "gfx/wr/wrench/reftests/compositor/tile-boundary-ref.yaml", "gfx/wr/wrench/reftests/compositor/tile-boundary.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-combined-ref.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-combined.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-offset-ref.yaml", "gfx/wr/wrench/reftests/compositor/two-clips-offset.yaml", "gfx/wr/wrench/reftests/text/border-radius-alpha.png", "gfx/wr/wrench/reftests/text/border-radius-subpx.png", "gfx/wr/wrench/reftests/text/reftest.list", "gfx/wr/wrench/reftests/transforms/reftest.list", "gfx/wr/wrench/src/args.yaml", "gfx/wr/wrench/src/main.rs", "gfx/wr/wrench/src/reftest.rs", "gfx/wr/wrench/src/test_invalidation.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "4ed58cde498186fbfbd0b4310597a9050f369daf", "git_parents": ["e7db5a9545978c7e19711fc07d2cedbf51a7faf5"], "node": "221bc1de5c0ceafc057eca0e83e9c81c12e05203", "parents": ["aae83da8b38fccbc9284bd2f10fe3f67bfcc8a48"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060827 - The set to default prompt should be displayed during onboarding when the set to default card is displayed r=android-reviewers,alastun\n\nThe onboarding \"Set as default browser\" prompt was gated by `Settings.shouldShowSetAsDefaultPrompt()`, which enforces the standard default browser prompt eligibility rules. One of those rules requires a minimum of four cold starts (configurable via Nimbus). Since a new user has only one cold start during onboarding, the eligibility check fails and the system prompt is suppressed until the fourth app launch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316514\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/OnboardingTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingFragment.kt"], "git_node": "e4836a7040c5ca35a09be51dd9c86f065d8e803c", "git_parents": ["4ed58cde498186fbfbd0b4310597a9050f369daf"], "node": "cf33c2bf173a3fc4b38d99e523f5dbfbb54867c3", "parents": ["221bc1de5c0ceafc057eca0e83e9c81c12e05203"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060237 - Ensure set_profiler_hooks is called before we create the render backend threads. r=gfx-reviewers,jnicol\n\nOtherwise they aren't profiled anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316020\n", "files": ["gfx/webrender_bindings/src/bindings.rs"], "git_node": "d06432ffe8251294427f03322caa150e44cc46b1", "git_parents": ["e4836a7040c5ca35a09be51dd9c86f065d8e803c"], "node": "96a937f2169b12eb675c65e78f07b94c24655e48", "parents": ["cf33c2bf173a3fc4b38d99e523f5dbfbb54867c3"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2058045 - remove obsolete normandy testing prefs, r=beth,TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314786\n", "files": ["browser/app/profile/firefox.js", "toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/docs/data/environment.md", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": "8e944d6234c25893243a042d923bf3cdf4841805", "git_parents": ["d06432ffe8251294427f03322caa150e44cc46b1"], "node": "3f91e4d84f48b04f466cda7461f51bbfb809c323", "parents": ["96a937f2169b12eb675c65e78f07b94c24655e48"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2058388. Allow passing the DrawView flag to drawSnapshot so root scrollbars are painted, and so reftest's snapshot path matches its default one. r=dom-core-reviewers,webrtc-reviewers,devtools-reviewers,webcompat-reviewers,layout-reviewers,jdescottes,twisniewski,emilio,smaug,pehrsons\n\ndrawSnapshot only asked CrossProcessPaint for DrawView when no rect was passed.\nWithout DrawView the paint also gets IgnoreViewportScrolling | DocumentRelative,\nwhich makes nsLayoutUtils::PaintFrame set the root scroll container as the display\nlist builder's ignored scroll frame. ScrollContainerFrame::BuildDisplayList then\nonly appends the scroll parts on that path when painting to a window, which a\nsnapshot never is. The reftest harness needs an explicit rect, so it lost the root\nscrollbars, and drew position:fixed content at the scroll offset while the rest of\nthe page was document relative. The default harness path doesn't have either\nproblem because it calls drawWindow with DRAWWINDOW_DRAW_VIEW.\n\nReplace the trailing resetScrollPosition boolean on drawSnapshot with a\nDrawSnapshotOptions dictionary and add drawView to it, which sets the DrawView\nflag even when a rect is given. Both reftest harnesses opt in. Every other caller\nkeeps the document relative behaviour it has today, which is what thumbnails,\nScreenshots, DevTools and tabs.captureTab want; those call sites are mechanically\nconverted from the positional boolean to the dictionary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314618\n", "files": ["devtools/server/actors/utils/capture-screenshot.js", "dom/chrome-webidl/WindowGlobalActors.webidl", "dom/ipc/WindowGlobalParent.cpp", "dom/ipc/WindowGlobalParent.h", "dom/media/systemservices/video_engine/tab_capturer.cc", "layout/reftests/backgrounds/reftest.list", "layout/reftests/bugs/reftest.list", "layout/reftests/css-gradients/reftest.list", "layout/reftests/css-scroll-snap/reftest.list", "layout/reftests/forms/fieldset/reftest.list", "layout/reftests/scrolling/reftest.list", "layout/reftests/transform/reftest.list", "layout/tools/reftest/reftest.sys.mjs", "layout/xul/reftest/reftest.list", "remote/marionette/reftest.sys.mjs", "remote/shared/Capture.sys.mjs", "testing/specialpowers/content/SpecialPowersParent.sys.mjs", "toolkit/components/extensions/parent/ext-tabs-base.js", "toolkit/components/reportbrokensite/ReportBrokenSiteParent.sys.mjs"], "git_node": "78f289876b9c2022059c951097c71713142c67a0", "git_parents": ["8e944d6234c25893243a042d923bf3cdf4841805"], "node": "adbacdf954cbd6a403cfb695263dcc33acc49306", "parents": ["3f91e4d84f48b04f466cda7461f51bbfb809c323"], "tags": []}, {"author": "tannal \u003cmtan@igalia.com\u003e", "branch": "default", "desc": "Bug 2059312 - Part 1: Push down GetURIAttr logic to mozilla/dom/Element.h r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316754\n", "files": ["dom/base/Element.cpp", "dom/base/Element.h", "dom/html/nsGenericHTMLElement.cpp", "dom/html/nsGenericHTMLElement.h"], "git_node": "b66939a7ec70dbd029d6edbd102a3a759d11cdd7", "git_parents": ["78f289876b9c2022059c951097c71713142c67a0"], "node": "55fc3bb7d56081f5fee01870aaecce70b35d6044", "parents": ["adbacdf954cbd6a403cfb695263dcc33acc49306"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2060505 - Reconfigure stdout/stderr as utf-8 r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316245\n", "files": ["python/mach/mach/main.py", "python/mozlint/mozlint/cli.py"], "git_node": "6cb325290e0ad4a7f36888bc50160abcd71e292e", "git_parents": ["b66939a7ec70dbd029d6edbd102a3a759d11cdd7"], "node": "6c4efd3d89d86457c806fb96faf8300fbd32b7c7", "parents": ["55fc3bb7d56081f5fee01870aaecce70b35d6044"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061135 - Update GeckoView changelog to fix perma lint failure r=geckoview-reviewers,tthibaud\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316758\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/geckoview/doc-files/CHANGELOG.md"], "git_node": "cb97e2315339faded9879897188fb83f82baae8e", "git_parents": ["6cb325290e0ad4a7f36888bc50160abcd71e292e"], "node": "2eb31e38d4336628b14c2696e215d711dee432fe", "parents": ["6c4efd3d89d86457c806fb96faf8300fbd32b7c7"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1931204 - Update BrowserCaptureMediaStreamTrack-restrictTo.https.html annotations for macOS (15.30). r=webrtc-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316528\n", "files": ["testing/web-platform/meta/mediacapture-streams/BrowserCaptureMediaStreamTrack-restrictTo.https.html.ini"], "git_node": "ee240adffc0605a622601c270966bb88986aeecc", "git_parents": ["cb97e2315339faded9879897188fb83f82baae8e"], "node": "da3086e4ef9a10702686ac1f1405513f7f82a768", "parents": ["2eb31e38d4336628b14c2696e215d711dee432fe"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1931205 - Remove MediaStreamTrack-iframe-audio-transfer.https.html macOS 14.70 annotations as it now only runs on 15.30. r=webrtc-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316529\n", "files": ["testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini"], "git_node": "d4e351a7a27e6c355044baeeab6a3dad3dfa2bda", "git_parents": ["ee240adffc0605a622601c270966bb88986aeecc"], "node": "3fdbbce84785afd2e792a8718026c3faab3d9b53", "parents": ["da3086e4ef9a10702686ac1f1405513f7f82a768"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2034727 - Update MediaStreamTrack-iframe-audio-transfer.https.html annotations for macOS (15.30). r=webrtc-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316530\n", "files": ["testing/web-platform/meta/mediacapture-streams/MediaStreamTrack-iframe-audio-transfer.https.html.ini"], "git_node": "ea41f5c48e23db57dcd740d91dd6edb3282e2275", "git_parents": ["d4e351a7a27e6c355044baeeab6a3dad3dfa2bda"], "node": "ad7d4a5318d90fa4c9a509718c2bf5553da119f0", "parents": ["3fdbbce84785afd2e792a8718026c3faab3d9b53"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 1931206 - Update parallel-capture-requests.https.html annotations for macOS (15.30). r=webrtc-reviewers,mjf\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316531\n", "files": ["testing/web-platform/meta/mediacapture-streams/parallel-capture-requests.https.html.ini"], "git_node": "ce073ed390fa06337b5d9b4959251dbbd0eb409a", "git_parents": ["ea41f5c48e23db57dcd740d91dd6edb3282e2275"], "node": "d01ad42d27e0252e5cf11268ed5044aa71087fb7", "parents": ["ad7d4a5318d90fa4c9a509718c2bf5553da119f0"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2058347 - DOM Media - Fail Vulkan decoder init early on device-fn load failure; key instance-fn cache by generation. r=alwu,stransky\n\nInitCtx() currently runs only from CreateImageVulkan(), after the\ndecoder has already reported successful HW init. A device-function\nload failure then becomes a fatal mid-playback error and skips the\nnormal software-fallback path (observed on RADV Polaris: \"Failed to\nload required Vulkan device functions\"). Call InitCtx() at\ndecoder-creation time so that failure can fall back cleanly.\n\nAlso key sInstanceFnCache by (VkInstance, generation). After\nVulkanDeviceHolder drops the last reference the shared instance is\ndestroyed; a later instance could reuse the same address (unconfirmed\nin practice). The generation counter is a defensive guard against\nserving stale cached instance-level function pointers in that case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315055\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegVulkanVideoDecoder.h", "dom/media/platforms/ffmpeg/VulkanDeviceHolder.cpp", "dom/media/platforms/ffmpeg/VulkanDeviceHolder.h"], "git_node": "7b06c66047194ca8ea224f351c04184b5f8ca01a", "git_parents": ["ce073ed390fa06337b5d9b4959251dbbd0eb409a"], "node": "a232c7f5e821ae8dcf4f1a6e9bbb2b90cfaf86d2", "parents": ["d01ad42d27e0252e5cf11268ed5044aa71087fb7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2060862 - Add a stylelint rule for :has(). r=dao,desktop-theme-reviewers,devtools-reviewers,fxview-reviewers,tabbrowser-reviewers,webcompat-reviewers,urlbar-reviewers,omarg,twisniewski,nchevobbe,jsudiaman,Gijs\n\nSee bug 2054065 for an example of what we're trying to prevent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316551\n", "files": [".stylelintrc.js", "browser/components/aiwindow/ui/components/smartwindow-history-menu/smartwindow-history-menu.css", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-prompts/smartwindow-prompts.css", "browser/components/aiwindow/ui/content/firstrun.css", "browser/components/firefoxview/chats-tab-list.css", "browser/components/genai/chat.css", "browser/components/genai/content/link-preview-card.css", "browser/components/preferences/widgets/placeholder-message/placeholder-message.css", "browser/components/preferences/widgets/setting-control/setting-control.css", "browser/components/reportbrokensite/content/components/url-input.css", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/identity-credential-notification.css", "browser/themes/shared/preferences/preferences.css", "browser/themes/shared/sidebar.css", "browser/themes/shared/tabbrowser/content-area.css", "browser/themes/shared/tabbrowser/tabs.css", "browser/themes/shared/toolbarbuttons.css", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css", "devtools/client/aboutdebugging/src/components/debugtarget/FieldPair.css", "devtools/client/application/src/components/session-history/SessionHistory.css", "devtools/client/debugger/src/components/PrimaryPanes/Tracer.css", "devtools/client/debugger/src/components/SecondaryPanes/EventListeners.css", "devtools/client/debugger/src/components/SecondaryPanes/Expressions.css", "devtools/client/framework/options-panel.css", "devtools/client/inspector/rules/test/doc_class_panel_autocomplete_stylesheet.css", "devtools/client/jsonview/css/json-panel.css", "devtools/client/netmonitor/src/assets/styles/StatisticsPanel.css", "devtools/client/shared/components/FileSearchBar.css", "devtools/client/shared/components/tabs/Tabs.css", "devtools/client/themes/common.css", "devtools/client/themes/dark-theme.css", "devtools/client/themes/light-theme.css", "devtools/client/themes/markup.css", "devtools/client/themes/rules.css", "devtools/client/themes/styleeditor.css", "devtools/client/themes/tooltips.css", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/no-has-selector.md", "toolkit/components/translations/content/about-translations.css", "toolkit/content/widgets/moz-box-item/moz-box-item.css", "toolkit/content/widgets/moz-button/moz-button.css", "toolkit/content/widgets/moz-card/moz-card.css", "toolkit/content/widgets/moz-fieldset/moz-fieldset.css", "toolkit/content/widgets/moz-five-star/moz-five-star.css", "toolkit/content/widgets/moz-input-common.css", "toolkit/content/widgets/moz-page-header/moz-page-header.css", "toolkit/content/widgets/moz-page-nav/moz-page-nav.css", "toolkit/content/widgets/moz-promo/moz-promo.css", "toolkit/content/widgets/moz-select/moz-select.css", "toolkit/content/widgets/moz-visual-picker/moz-visual-picker-item.css", "toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/themes/shared/pictureinpicture/player.css", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/index.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/no-has-selector.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/no-has-selector.tests.mjs"], "git_node": "50a7e859636ac07b45b8f4153b782f5d5101702d", "git_parents": ["7b06c66047194ca8ea224f351c04184b5f8ca01a"], "node": "6a147be2c1d7ab2a6a4d6cc68e2bdb4c6ea21791", "parents": ["a232c7f5e821ae8dcf4f1a6e9bbb2b90cfaf86d2"], "tags": []}, {"author": "Max Inden \u003cmail@max-inden.de\u003e", "branch": "default", "desc": "Bug 2060591 - Update happy-eyeballs crate to v0.11.0 r=necko-reviewers,valentin\n\nAdapt the happy_eyeballs_glue FFI layer to the v0.11.0 API. DnsResult\ninputs now carry a `stale` flag, set to false here since Optimistic DNS\nis not wired up on the C++ side, and SendDnsQuery outputs carry an\n`allow_stale` flag, which is ignored for the same reason. Wiring up\nOptimistic DNS is left to a follow-up.\