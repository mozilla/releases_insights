rs", "third_party/rust/proc-macro-error2/tests/ui/abort.stderr", "third_party/rust/proc-macro-error2/tests/ui/append_dummy.rs", "third_party/rust/proc-macro-error2/tests/ui/append_dummy.stderr", "third_party/rust/proc-macro-error2/tests/ui/children_messages.rs", "third_party/rust/proc-macro-error2/tests/ui/children_messages.stderr", "third_party/rust/proc-macro-error2/tests/ui/dummy.rs", "third_party/rust/proc-macro-error2/tests/ui/dummy.stderr", "third_party/rust/proc-macro-error2/tests/ui/emit.rs", "third_party/rust/proc-macro-error2/tests/ui/emit.stderr", "third_party/rust/proc-macro-error2/tests/ui/explicit_span_range.rs", "third_party/rust/proc-macro-error2/tests/ui/explicit_span_range.stderr", "third_party/rust/proc-macro-error2/tests/ui/misuse.rs", "third_party/rust/proc-macro-error2/tests/ui/misuse.stderr", "third_party/rust/proc-macro-error2/tests/ui/multiple_tokens.rs", "third_party/rust/proc-macro-error2/tests/ui/multiple_tokens.stderr", "third_party/rust/proc-macro-error2/tests/ui/not_proc_macro.rs", "third_party/rust/proc-macro-error2/tests/ui/not_proc_macro.stderr", "third_party/rust/proc-macro-error2/tests/ui/option_ext.rs", "third_party/rust/proc-macro-error2/tests/ui/option_ext.stderr", "third_party/rust/proc-macro-error2/tests/ui/result_ext.rs", "third_party/rust/proc-macro-error2/tests/ui/result_ext.stderr", "third_party/rust/proc-macro-error2/tests/ui/to_tokens_span.rs", "third_party/rust/proc-macro-error2/tests/ui/to_tokens_span.stderr", "third_party/rust/proc-macro-error2/tests/ui/unknown_setting.rs", "third_party/rust/proc-macro-error2/tests/ui/unknown_setting.stderr", "third_party/rust/proc-macro-error2/tests/ui/unrelated_panic.rs", "third_party/rust/proc-macro-error2/tests/ui/unrelated_panic.stderr"], "git_node": "946e93bd092e4c4c48107e7d80becb2b705862b6", "git_parents": ["1ce67dcb6ce019322dd68470c0ee960bbc21c766"], "node": "1cbef0bd69a3d573d59d30584ad408a8498aef3f", "parents": ["0faca76bc591445f1de70a0081901faea33c8242"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2058355. Remove proc-macro-error from license.html. r=sylvestre\n\njxl-rs 0.5 removes this package and thus it is removed from our tree. We need to remove it from license.html otherwise tests will go orange.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314552\n", "files": ["toolkit/content/license.html"], "git_node": "5317376b755b935ab3fe853e131e24befebb2a88", "git_parents": ["946e93bd092e4c4c48107e7d80becb2b705862b6"], "node": "f5c7b0147e38737b0a53472b5a12e9d2f2ca1947", "parents": ["1cbef0bd69a3d573d59d30584ad408a8498aef3f"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2054317. Add gtest for jxl crash. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311994\n", "files": ["image/test/gtest/Common.cpp", "image/test/gtest/Common.h", "image/test/gtest/TestDecoders.cpp", "image/test/gtest/moz.build", "image/test/gtest/progressive_alpha_multigroup.jxl"], "git_node": "a4a84a8497f6e0bb85643fd3e86bc57a11ae6a6f", "git_parents": ["5317376b755b935ab3fe853e131e24befebb2a88"], "node": "36e4611c9c136b5624faf7a68be3cc8864d6d213", "parents": ["f5c7b0147e38737b0a53472b5a12e9d2f2ca1947"], "tags": []}, {"author": "Abhishek Nimalan \u003cabhisheknimalan@gmail.com\u003e", "branch": "default", "desc": "Bug 2047451 - Add perf profiling support for Linux Raptor tests. r=perftest-reviewers,kshampur\n\nLinux only. Support native (OS-wide) profiling for Raptor tests in CI\nand locally using the perf profiler.\n\nperf profiles the entire Browsertime instance that the test is run in.\nThe resulting profile is symbolicated with build symbols using Samply\nand converted into a JSON profile in the Firefox Profiler format.\n\n--perf-profile is introduced as a Raptor option and a Mozharness extra\noption. A CI job with perf profiling can be created by adding\n--perf-profile to the job's configuration.\n\nTo run a Raptor test locally with perf profiling, use the --perf-profile\nflag with ./mach raptor\n\nCo-authored-by: KS \u003ckshampur@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306851\n", "files": ["testing/mozharness/mozharness/mozilla/testing/raptor.py", "testing/raptor/raptor/browsertime/base.py", "testing/raptor/raptor/cmdline.py", "testing/raptor/raptor/perf_profile.py", "testing/raptor/raptor/perftest.py", "testing/raptor/raptor/raptor.py", "testing/raptor/raptor/results.py"], "git_node": "2a213addff3a22aa88ef8d112002d11266f77f7d", "git_parents": ["a4a84a8497f6e0bb85643fd3e86bc57a11ae6a6f"], "node": "84d2db0ea73f0540ac2b26695c3aa7b0e8e69784", "parents": ["36e4611c9c136b5624faf7a68be3cc8864d6d213"], "tags": []}, {"author": "Abhishek Nimalan \u003cabhisheknimalan@gmail.com\u003e", "branch": "default", "desc": "Bug 2047451 - Add transform and Autoland tasks for Speedometer 3 native profiling on Linux. r=perftest-reviewers,kshampur\n\nThese transforms configure perf profiling and symbolication dependencies\nfor Speedometer 3 Linux CI tasks when --native-profiling is used or\nwhen running on Autoland.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306852\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/raptor.py", "testing/perfdocs/generated/raptor.md", "testing/raptor/browsertime/support-scripts/speedometer3.py"], "git_node": "c4b827b889257ef79cf5f1cedbe9093a449e5c7c", "git_parents": ["2a213addff3a22aa88ef8d112002d11266f77f7d"], "node": "d1c58076635a80ff27edc12bcfd510306ad2d4cb", "parents": ["84d2db0ea73f0540ac2b26695c3aa7b0e8e69784"], "tags": []}, {"author": "Abhishek Nimalan \u003cabhisheknimalan@gmail.com\u003e", "branch": "default", "desc": "Bug 2047451 - Update perfdocs to include info on native profiling on Linux. r=perftest-reviewers,afinder,aglavic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306853\n", "files": ["testing/perfdocs/generated/browsertime.md", "testing/raptor/raptor/perfdocs/browsertime.md"], "git_node": "847e26de117ca0ba68b3770846bd2c6729980a1a", "git_parents": ["c4b827b889257ef79cf5f1cedbe9093a449e5c7c"], "node": "9163d729cc695670917e0bb0cd6ad2d3dfcbcb15", "parents": ["d1c58076635a80ff27edc12bcfd510306ad2d4cb"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2014357 - fully support extmap-allow-mixed;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D283440\n", "files": ["dom/media/webrtc/common/RtpHeaderExtensions.cpp", "dom/media/webrtc/common/RtpHeaderExtensions.h", "dom/media/webrtc/common/moz.build", "dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepTrack.cpp", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "media/webrtc/signaling/gtest/jsep_track_unittest.cpp", "testing/web-platform/meta/webrtc/protocol/rtp-headerextensions.html.ini", "testing/web-platform/mozilla/tests/webrtc/RTCPeerConnection-mid-length-validation.html"], "git_node": "f6b26e2a2f8ae57a0faffb2b1b75bed3d07f4022", "git_parents": ["847e26de117ca0ba68b3770846bd2c6729980a1a"], "node": "d4238e4d5be7650d454ea9568214488c4369fa61", "parents": ["9163d729cc695670917e0bb0cd6ad2d3dfcbcb15"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2019469 - handle sendonly and recvonly extensions in protocol/rtp-headerextensions.html;r=bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312005\n", "files": ["testing/web-platform/meta/webrtc/protocol/rtp-headerextensions.html.ini", "testing/web-platform/tests/webrtc/protocol/rtp-headerextensions.html"], "git_node": "cf50addab76ac3b90aebb1d6330d52a77924b1c5", "git_parents": ["f6b26e2a2f8ae57a0faffb2b1b75bed3d07f4022"], "node": "c76de83ceb8a4fb6deb3e5e3262b30d5f9bf88f5", "parents": ["d4238e4d5be7650d454ea9568214488c4369fa61"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043863 - Part 1 - Add infrastructure for assembling macOS `.app` bundles from `moz.build` r=firefox-build-system-reviewers,sergesanspaille\n\nThis adds a `MacOSBundle` primitive and an `assemble_macos_bundle.py`\naction, so that a bundle can be declared in a `moz.build` instead of\nthe `Makefile.in` recipes that currently do it.\n\nThis commit is inert and just adds the necessary infrastructure\nfor handling this without make. The full migration is done in\nPart 3.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303694\n", "files": ["build/templates.mozbuild", "python/mozbuild/mozbuild/action/assemble_macos_bundle.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/test/action/test_assemble_macos_bundle.py", "python/mozbuild/mozbuild/test/backend/data/macos-bundle/gen/moz.build", "python/mozbuild/mozbuild/test/backend/data/macos-bundle/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "f19b0f245b7bd8eedb4cc0b997b5cb14f5b1eda7", "git_parents": ["cf50addab76ac3b90aebb1d6330d52a77924b1c5"], "node": "2dab90cf0a6b30a1c098caf81b818b245aca4df2", "parents": ["c76de83ceb8a4fb6deb3e5e3262b30d5f9bf88f5"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043863 - Part 2 - Migrate macOS `Info.plist`/`InfoPlist.strings` recipes to `GeneratedFile` r=firefox-build-system-reviewers,sergesanspaille,sylvestre\n\nThese files are currently produced by preprocessor calls\nwired into the assembly recipes. Turning them into\n`GeneratedFile` outputs lets Part 3 consume them as inputs,\ninstead of every bundle running a preprocessor itself as a\nside effect of being assembled.\n\nThe existing preprocessor helpers don't cover two cases.\n`InfoPlist.strings` has to be UTF-16, so\n`Preprocessor.handleCommandLine` now honors `--output-encoding`\nwithout `--output`, encoding into the caller's byte stream so the\nexisting `generate` entry point can produce it. `browser/app`'s\n`Info.plist` needs a `CFBundleVersion` computed from the build id\nwhen it is built, not a value known up front, so it gets a small\nwrapper.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303695\n", "files": ["browser/app/Makefile.in", "browser/app/generate_info_plist.py", "browser/app/macversion.py", "browser/app/moz.build", "ipc/app/Makefile.in", "ipc/app/moz.build", "python/mozbuild/mozbuild/preprocessor.py", "python/mozbuild/mozbuild/test/test_preprocessor.py", "toolkit/crashreporter/client/app/Makefile.in", "toolkit/crashreporter/client/app/moz.build", "toolkit/mozapps/update/updater/Makefile.in", "toolkit/mozapps/update/updater/moz.build", "toolkit/mozapps/update/updater/updater-xpcshell/Makefile.in", "toolkit/mozapps/update/updater/updater-xpcshell/moz.build"], "git_node": "b06adefb83c66583e1f633ba11eec205cb151d41", "git_parents": ["f19b0f245b7bd8eedb4cc0b997b5cb14f5b1eda7"], "node": "fa1a2137d68d70acc0c32e39f08f0a6ea0954773", "parents": ["2dab90cf0a6b30a1c098caf81b818b245aca4df2"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2043863 - Part 3 - Assemble macOS `.app` bundles with `MacOSBundle` r=firefox-build-system-reviewers,sergesanspaille,sylvestre\n\nParts 1 and 2 were the setup, and this is the migration itself.\nEach bundle is now described by a `MacOSBundle` declaration in\nits `moz.build`, and the recipe that used to assemble it is\nremoved from the corresponding `Makefile.in`.\n\nThis covers every macOS `.app` we build:\n- The four `ipc/app` process bundles\n- The crash reporter\n- The updater\n- The browser\n- The `callback_app.app` and `updater-xpcshell`'s `updater.app`,\n  two bundles in the update tests\n\nOnly the browser bundle stages all of `dist/bin`. The rest just\nplace a skeleton, their plists, and a binary. `updater-xpcshell`\nalso keeps a small non-cocoa recipe that copies its binary to\n`updater`, a rename that must preserve the executable bit and is\nleft for a follow-up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D303696\n", "files": ["browser/app/Makefile.in", "browser/app/moz.build", "build/templates.mozbuild", "ipc/app/Makefile.in", "ipc/app/moz.build", "python/mozbuild/mozbuild/action/assemble_macos_bundle.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/action/test_assemble_macos_bundle.py", "python/mozbuild/mozbuild/test/backend/data/macos-bundle/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py", "toolkit/crashreporter/client/app/Makefile.in", "toolkit/crashreporter/client/app/moz.build", "toolkit/mozapps/update/tests/Makefile.in", "toolkit/mozapps/update/tests/moz.build", "toolkit/mozapps/update/updater/Makefile.in", "toolkit/mozapps/update/updater/moz.build", "toolkit/mozapps/update/updater/updater-xpcshell/Makefile.in", "toolkit/mozapps/update/updater/updater-xpcshell/moz.build"], "git_node": "70ca2805f532b299860d54d2df72bd31ae8a5aa9", "git_parents": ["b06adefb83c66583e1f633ba11eec205cb151d41"], "node": "9989c79e8ad856e4b0f00401dd530f32979af08f", "parents": ["fa1a2137d68d70acc0c32e39f08f0a6ea0954773"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057869 - [Nova] Re-enable test browser_searchModeSwitcher_basic.js. r=daisuke,urlbar-reviewers\n\nThis test didn't fail after several retriggers on try, and I can't reproduce it\nlocally, so I think we can try re-enabling it:\n\nhttps://treeherder.mozilla.org/jobs?repo=try&revision=ebf6aab632114121ae176818936bbb4b05079c04\n\nIt may just be intermittent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315122\n", "files": ["browser/components/urlbar/tests/browser-searchMode/browser.toml"], "git_node": "a9cb518e723e094e5ae41e294a6cb5b714f2b81e", "git_parents": ["70ca2805f532b299860d54d2df72bd31ae8a5aa9"], "node": "8133b75ecae823bce2acfaf1204cb2bc78e650e9", "parents": ["9989c79e8ad856e4b0f00401dd530f32979af08f"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2054529 - [Monitor Agent][FE] Move hardcded string to locals preview file r=yjamora,fluent-reviewers,bolsson import uuid\" for causing bc failures @browser_aiwindow_agent_monitor_chat.js.\n\nThis reverts commit 1ce67dcb6ce019322dd68470c0ee960bbc21c766.\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.css", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/content/aiChatContent.html", "browser/components/aiwindow/ui/content/tasks.html", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_agent_monitor_item.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/components/aiwindow/ui/test/browser/test_agent_monitor_item_page.html", "browser/locales-preview/aiWindow.ftl"], "git_node": "99ad4b6b65ee01fcd2a9038f13a040d800924743", "git_parents": ["a9cb518e723e094e5ae41e294a6cb5b714f2b81e"], "node": "21865e529f76846ddc6b2ce0c56b8be3e73cbf67", "parents": ["8133b75ecae823bce2acfaf1204cb2bc78e650e9"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057878 - Adjust browser_test_autoscrolling_in_extension_popup_window.js  annotation. r=botond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315129\n", "files": ["gfx/layers/apz/test/mochitest/browser.toml"], "git_node": "cfaa1bf99e53a4a11ab1dc1d39c2d102487f7afc", "git_parents": ["99ad4b6b65ee01fcd2a9038f13a040d800924743"], "node": "c0b0f439a402ee7fe37c1151979e40dbfa82603f", "parents": ["21865e529f76846ddc6b2ce0c56b8be3e73cbf67"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059273 - Skip browser_test_autoscrolling_in_oop_frame.js on Wayland. r=botond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315130\n", "files": ["gfx/layers/apz/test/mochitest/browser.toml"], "git_node": "968cc858c7edd8b5a11434b9420cd447f6f92839", "git_parents": ["cfaa1bf99e53a4a11ab1dc1d39c2d102487f7afc"], "node": "03fec4bd784c0a657eab17c1f904e26a677af46f", "parents": ["c0b0f439a402ee7fe37c1151979e40dbfa82603f"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056456: Use RefPtr for the RemoteAccessible tree. r=eeejay\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314528\n", "files": ["accessible/ipc/DocAccessibleParent.cpp", "accessible/ipc/DocAccessibleParent.h", "accessible/ipc/RemoteAccessible.cpp", "accessible/ipc/RemoteAccessible.h"], "git_node": "fed3468708c4cae84d63a60612b1b9384bba68ab", "git_parents": ["968cc858c7edd8b5a11434b9420cd447f6f92839"], "node": "3a9b17dbd2a9967fe3e8caf2d7bf7ceb0c0fbb10", "parents": ["03fec4bd784c0a657eab17c1f904e26a677af46f"], "tags": []}], "date": 1785403190, "git_changesets": ["6cbee7632531f8bd30e3349340f8092f0790076c", "2354187b12120a0ae0d6efb16a2a7f45b9aac918", "117172f0e6d07fdac97eea3c645966b13fd93c45", "01d3542d6a5726b97f156307c2a43375d90a0e5b", "a3d30c5a18a6540e10aeb1e4f6dc7ddda50dad0a", "f2143fad40a9d300db71bcfd95fa95fbb45a0cbc", "b1e86bda2add900c66a34adaa5ec4add69753199", "68f8ea7ed86f8cb4a753c55a3a8114649e83e28b", "abbb2b71144fd2d13aa1d35a6d83e534d8254364", "040376355b57586451f0ff28b30bd2d2dc028d7b", "85136da0fa6856e37dbea65b0040ec1b7a6278fd", "07b7b8da78970c76