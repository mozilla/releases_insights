res @browser_container_definitions_in_sync.js.\n\nThis reverts commit 5ac96b3428b107f508eedb49919752681b477d10.\n", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/schemas/policies-schema.json"], "git_node": "9050872b073bade6b4e6a97017d8243f1663a859", "git_parents": ["1598b684626f03cb11d4f4b170d19857e82ed55a"], "node": "ef9b827ab7cc6fa78aaa492b2e67872c47229afe", "parents": ["ace6765f75ebefa6712f997ff9904bb1d5b5fe17"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2048793 - Check more URLs in nsDocShellLoadState. r=nika,Gijs\" for causing build bustages @nsDocShellLoadState.cpp.\n\nThis reverts commit 4379c4ce4a684073aa5f99c9d24ecbca0c8fc15a.\n\nRevert \"Bug 2048793 - Use CheckLoadURIWithPrincipal for client.navigate(). r=smaug\"\n\nThis reverts commit 25745ea27bea8ebcc31c70104dcaf142df4d9888.\n\nRevert \"Bug 2048793 - Use CheckLoadURIWithPrincipal before loading object/embed content. r=smaug\"\n\nThis reverts commit d47eb4ffbd9bb4adfb0854c5255592c99a74b75c.\n", "files": ["browser/components/tabbrowser/test/browser/tabs/browser_new_tab_in_privilegedabout_process_pref.js", "docshell/base/nsDocShellLoadState.cpp", "docshell/test/browser/browser_browsing_context_discarded.js", "dom/base/nsObjectLoadingContent.cpp", "dom/clients/manager/ClientNavigateOpChild.cpp", "testing/web-platform/meta/service-workers/service-worker/windowclient-navigate.https.html.ini"], "git_node": "487affa319b97a8e214ec473e4a4947ae8ab1d28", "git_parents": ["9050872b073bade6b4e6a97017d8243f1663a859"], "node": "189cf39b4a95d64f3834a746ea12d605062f7d85", "parents": ["ef9b827ab7cc6fa78aaa492b2e67872c47229afe"], "tags": []}, {"author": "Julian Seward \u003cjseward@acm.org\u003e", "branch": "default", "desc": "Bug 2013616 - Improve test cases for Instance::fromCharCodeArray.  r=rhunt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D282336\n", "files": ["js/src/jit-test/tests/wasm/builtin-modules/js-string/basic.js", "js/src/jit-test/tests/wasm/regress/bug2013616.js"], "git_node": "606cab8de3fd8d978cb6f344ea57613e72f25341", "git_parents": ["487affa319b97a8e214ec473e4a4947ae8ab1d28"], "node": "f73d00467900733ccf14077f5b14148182747af9", "parents": ["189cf39b4a95d64f3834a746ea12d605062f7d85"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062279 - Migrate 3 SettingsDeleteBrowsingDataTest UI tests to the efficiency framework r=jajohnson\n\nFaithful port of the 3 @SmokeTest methods of org.mozilla.fenix.ui.SettingsDeleteBrowsingDataTest onto the ui/efficiency framework, as org.mozilla.fenix.ui.efficiency.tests.SettingsDeleteBrowsingDataTest:\n\n    deleteOpenTabsBrowsingDataTest (TestRail 353531)\n    deleteBrowsingHistoryTest (TestRail 378864)\n    deleteCookiesAndSiteDataTest (TestRail 416041)\n\nThe @Ignore'd deleteCachedFilesTest (bug 1987355) and the two non-smoke tests in the class were not converted. Added SettingsDeleteBrowsingDataPage verbs + selectors, a SettingsPage-\u003eDeleteBrowsingData navigation edge, TabDrawerPage.verifyNoOpenTabsInNormalBrowsing, and a BrowserPage retry-with-reload web-content click helper. All three pass on-device on the first attempt (no retries); fenix:ktlint is clean. Full assertion parity with the legacy tests.\n\nWhy: Move smoke coverage onto the shared ui/efficiency page-object/selector/navigation layer to reduce per-test UI-test maintenance cost.\n\nContext: part of the ui/efficiency UI-test modernization. This is a faithful port of an existing legacy ui/ smoke test onto the ui/efficiency framework \u2014 same coverage and assertions, but far less per-test code via a shared page-object / selector / navigation layer, which bends the UI-test maintenance cost curve. Smoke-conversion campaign.\n\nTestRail: 353531, 378864, 416041\n\nAll 3 UI tests successfully passed 50x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=77535  | Try ]]\nAll efficiency UI test successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=77533  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317753\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsDeleteBrowsingDataTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsDeleteBrowsingDataPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/TabDrawerPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsDeleteBrowsingDataSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsDeleteBrowsingDataTest.kt"], "git_node": "9a2be8fd08903624388cd1cdfddd3d49dd238841", "git_parents": ["606cab8de3fd8d978cb6f344ea57613e72f25341"], "node": "7a8d8dec61605514adc739a0b7ac6b50254c2600", "parents": ["f73d00467900733ccf14077f5b14148182747af9"], "tags": []}, {"author": "Simon Chopin \u003cschopin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057896 - Skip browser_sandbox_crash.js on ccov builds rather than on Nova. r=afranchuk\n\nAll ccov builds are configured with --disable-sandbox, we should just\nskip them in that case as it will necessarily cause issues. In this\ncase, we're timing out in a test called test_sandbox_violation_is_sigsys\nwhich presumably expects the sandbox to catch a violation. No sandbox,\nno violation!\n\nNova was irrelevant here, that project just happened to use code\ncoverage during its development.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317785\n", "files": ["toolkit/crashreporter/test/browser/browser.toml"], "git_node": "9ef9196cec8a8c05bd1538d15e2c8fd2e1096b84", "git_parents": ["9a2be8fd08903624388cd1cdfddd3d49dd238841"], "node": "1a5aae67df9e812812609c1f72c79378c69af5b5", "parents": ["7a8d8dec61605514adc739a0b7ac6b50254c2600"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057169 - Prevent menu items from being cut off by menupopup border radius r=desktop-theme-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316651\n", "files": ["toolkit/themes/shared/popup.css"], "git_node": "fc9537321c2ebaab855582bd3c84e6a657905f6d", "git_parents": ["9ef9196cec8a8c05bd1538d15e2c8fd2e1096b84"], "node": "ccd290239c10844a9e1f535a243085ee8aa20d57", "parents": ["1a5aae67df9e812812609c1f72c79378c69af5b5"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2062225 - Fix verifyDownloadInACustomTabTest UI test r=jajohnson\n\nThe UI test was flaky because it failed to sometimes verify the Download dialog title (mozVerifyElementsByGroup(\u201cdownloadDialog\u201d))\n\nTo fix this I've added .mozVerify(DownloadsSelectors.DOWNLOAD_DIALOG_TITLE) which polls, so it absorbs the ~1.4 s the dialog took to render.\n\nThe UI test successfully passed 100x on Firbease \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317763\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CustomTabsTest.kt"], "git_node": "4b351a3978914d07cc9fde66c2d8c3401aab6ee4", "git_parents": ["fc9537321c2ebaab855582bd3c84e6a657905f6d"], "node": "521e371e3285fa73cf69cbd3bdc0e90533807f4d", "parents": ["ccd290239c10844a9e1f535a243085ee8aa20d57"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2058895 - Introduce small spacing between login action buttons in about:logins. r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317510\n", "files": ["browser/components/aboutlogins/content/components/login-item.css"], "git_node": "fac0452e4c85ad95d3e6161f49cd1f41d96389f0", "git_parents": ["4b351a3978914d07cc9fde66c2d8c3401aab6ee4"], "node": "67c9e08d1e610a4efdd29f944daacfdbabe36cd8", "parents": ["521e371e3285fa73cf69cbd3bdc0e90533807f4d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062602 - Add EncoderTemplate::mPendingFlushPromises to cycle collection. r=media-playback-reviewers,padenot\n\nPromises for flush could indefinitely keep an AudioEncoder or\nVideoEncoder alive if it kept a reference to the encoder inside\nthe promise callbacks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317804\n", "files": ["dom/media/platforms/SimpleMap.h", "dom/media/webcodecs/AudioEncoder.cpp", "dom/media/webcodecs/EncoderTemplate.h", "dom/media/webcodecs/VideoEncoder.cpp"], "git_node": "598947d62f7d973768ac600b303112c96c9fdd2c", "git_parents": ["fac0452e4c85ad95d3e6161f49cd1f41d96389f0"], "node": "80ed0206abb5b1b045428a5c96e8dc7a97330f66", "parents": ["67c9e08d1e610a4efdd29f944daacfdbabe36cd8"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062606 - Convert missed Printf to Fmt in FFmpegVideoEncoder. r=media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317805\n", "files": ["dom/media/platforms/ffmpeg/FFmpegVideoEncoder.cpp"], "git_node": "c7495b170f18c1bbcc9d0b3729d824ab144da41d", "git_parents": ["598947d62f7d973768ac600b303112c96c9fdd2c"], "node": "f57af6c7a3931d352780e9d1e4bdb9f6e7db47e8", "parents": ["80ed0206abb5b1b045428a5c96e8dc7a97330f66"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2062349 - Update autofill suggestion icon size to use larger 24px token. r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317590\n", "files": ["toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.css"], "git_node": "485852515165e540b8827a1c636add7493895f33", "git_parents": ["c7495b170f18c1bbcc9d0b3729d824ab144da41d"], "node": "47d5fb7ca8e18511dd1c8ca0a12df85a3f37ae13", "parents": ["f57af6c7a3931d352780e9d1e4bdb9f6e7db47e8"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2061774 - [Monitor Agent][FE] Monitor feature STRINGS - round 2 r=fluent-reviewers,bolsson,echa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317132\n", "files": ["browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.mjs", "browser/components/aiwindow/ui/components/ai-tasks/ai-tasks.mjs", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.css", "browser/components/aiwindow/ui/components/monitors-display/monitors-display.mjs", "browser/components/aiwindow/ui/modules/MonitorUIUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_monitor_create.js", "browser/locales-preview/aiWindow.ftl"], "git_node": "834612d8697593f679b4ed8ba864a33e91336891", "git_parents": ["485852515165e540b8827a1c636add7493895f33"], "node": "af2148aa061260a1af51d42e6145e35b1bcb9e02", "parents": ["47d5fb7ca8e18511dd1c8ca0a12df85a3f37ae13"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062445 - Run the native ML tests on win32. r=ai-platform-reviewers,valentinp\n\nThe four tests that exercise the native ONNX and llama.cpp backends have skipped x86 since they were\nadded, with no recorded reason. The 32-bit onnxruntime toolchain was building an x64 DLL that could\nnever load, so the tests would have failed there; with that fixed they pass, apart from the pinned\ngreedy-decoding golden.\n\nThat golden diverges by architecture because llama.cpp selects different SIMD kernels, which shifts\nlogits enough to flip argmax on a few tokens. The constants were a two-way ternary on\nAppConstants.platform == \"macosx\", used as a stand-in for aarch64. That was already inaccurate on\nIntel macOS, which only avoided asserting the wrong text because a separate runtime check skips it,\nand it has no room for a third bucket. Key them on the architecture Services.sysinfo reports instead\nand add the x86 output, pinned from two runs on the same push to confirm it is stable. An\narchitecture with no pinned output now skips with a message rather than silently asserting the\nx86-64 text.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317683\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_native.js"], "git_node": "ed892d0b5aa12553516ffb7bad106487a2e60dad", "git_parents": ["834612d8697593f679b4ed8ba864a33e91336891"], "node": "2bfd575fecb5dd01134d48e04ede5437d04e4ae5", "parents": ["af2148aa061260a1af51d42e6145e35b1bcb9e02"], "tags": []}, {"author": "Krist Baliev \u003ckbaliev@mozilla.com\u003e", "branch": "default", "desc": "Bug 2049979 - Use not now button text for update passwords doorhanger. r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317814\n", "files": ["toolkit/components/passwordmgr/LoginManagerPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/passwordmgr/passwordmgr.ftl"], "git_node": "f11e4b9775b2d823603bd48d510aeefe0631a5c2", "git_parents": ["ed892d0b5aa12553516ffb7bad106487a2e60dad"], "node": "26705f97cf4550fa3ded569b0d2a71b9da7252f0", "parents": ["2bfd575fecb5dd01134d48e04ede5437d04e4ae5"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2061892 - Make the user idle service CID consistent across platforms. r=Gijs\n\nIt looks like the initial addition of NS_IDLE_SERVICE_CID in bug 343416 had 0089\nin the comment instead of 0098, so it didn't match the actual value.\n\nThen it looks like the initial migration to static component registration in bug\n1773770 part 8 switched from using the macro via NS_DEFINE_NAMED_CID to a hard\ncoded value, and it copied over the value from the comment. Presumably the uikit\nversion later copied over the cid from cocoa.\n\nFortunately, nobody uses NS_IDLE_SERVICE_CID anywhere.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317202\n", "files": ["widget/cocoa/components.conf", "widget/nsWidgetsCID.h", "widget/uikit/components.conf"], "git_node": "470cbd2f15141751671756268066ffc3c791d27b", "git_parents": ["f11e4b9775b2d823603bd48d510aeefe0631a5c2"], "node": "813ecd54787e8d108101bb15941a0cccfbbf1b7a", "parents": ["26705f97cf4550fa3ded569b0d2a71b9da7252f0"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048699 - Ensure the browsing context can do history traversal. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308961\n", "files": ["docshell/base/CanonicalBrowsingContext.cpp", "docshell/base/CanonicalBrowsingContext.h", "dom/ipc/ContentParent.cpp"], "git_node": "cd138927aae91bf4e89e3ee676b496c4c1da2aaf", "git_parents": ["470cbd2f15141751671756268066ffc3c791d27b"], "node": "67d10c3a9b5979e72544b61df9a240a95ab19f26", "parents": ["813ecd54787e8d108101bb15941a0cccfbbf1b7a"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["gfx/cairo/patches/0047-Bug-2054626-type2-decode-integer.patch", "gfx/cairo/patches/0048-Bug-2054627-skip-token-check.patch", "testing/web-platform/meta/mathml/relations/html5-tree/a-hreflang-getter.html.ini", "testing/web-platform/meta/mathml/relations/html5-tree/a-hreflang-setter.html.ini", "testing/web-platform/meta/mathml/relations/html5-tree/a-type-getter-001.html.ini", "testing/web-platform/meta/mathml/relations/html5-tree/a-type-getter-002.html.ini", "testing/web-platform/meta/mathml/relations/html5-tree/a-type-setter.html.ini", "testing/web-platform/meta/mathml/relations/html5-tree/anchor-hyperlinkutils-getter-setter.html.ini", "testing/web-platform/meta/mathml/relations/html5-tree/anchor-hyperlinkutils-getter.html.ini", "testing/web-platform/meta/mathml/relations/html5-tree/href-navigation.html.ini", "testing/web-platform/meta/scroll-animations/css/scroll-timeline-paused-animations.html.ini", "testing/web-platform/meta/scroll-animations/css/view-timeline-paused-animations.html.ini", "testing/web-platform/meta/shadow-dom/declarative/tentative/shadowrootadoptedstylesheets/shadowrootadoptedstylesheets-async-fetch-failure-shared.html.ini", "testing/web-platform/meta/shadow-dom/declarative/tentative/shadowrootadoptedstylesheets/shadowrootadoptedstylesheets-async-fetch-mutation-removed-still-updates.html.ini", "testing/web-platform/tests/shadow-dom/declarative/tentative/shadowrootadoptedstylesheets/shadowrootadoptedstylesheets-async-fetch-failure-shared.html", "testing/web-platform/tests/shadow-dom/declarative/tentative/shadowrootadoptedstylesheets/shadowrootadoptedstylesheets-async-fetch-mutation-removed-still-updates.html"], "git_node": "85130ba192d9f4bdf63e57502cb23fb31f95f7ca", "git_parents": ["3c092448c2da3b60a39ad2a7239d3a0de1b7e56d", "cd138927aae91bf4e89e3ee676b496c4c1da2aaf"], "node": "be1ad74e08cab1c71617c3f54a0b95bc01641eab", "parents": ["4a186e67ea2f5255055aef05ab5efd72465b4826", "67d10c3a9b5979e72544b61df9a240a95ab19f26"], "tags": []}], "date": 1786484580, "git_changesets": ["27d48758a9f48113cdaefb21eda2b369f99093e3", "6236fead51ceb922efafb04da016989e602a3b7d", "18ed116d7398f213d5e5f6c6621f2b06784e0621", "aca52e2393874d70adf8a205e3094c011be3dc4a", "adb9aefc8bde93ed4c47240bb855d7af2dda98de", "8d16851aa17a9d312aa55d39621e9d1a0abbed77", "223a58758f254da0afc57e03c82985013628f56e", "21b867f5f9