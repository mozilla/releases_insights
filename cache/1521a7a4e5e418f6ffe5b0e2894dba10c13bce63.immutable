], "git_node": "2d4fd9992e9809da9ba542b2045480b5cb5c2c80", "git_parents": ["9ac7459c7b05b682db5ee9f19d9c31213dda2598"], "node": "5891c4237108cda9de2d7cee8e8ddd8599b7ceb7", "parents": ["c6c6d3aef575bfc9cc18ee711f31e78c52593715"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060439 [wpt PR 61709] - Update wpt metadata, a=testonly\n\nwpt-pr: 61709\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/fetch/api/abort/general.any.js.ini"], "git_node": "ad1040c81fb0246407c2cefec9c2ec3e7eddc6be", "git_parents": ["2d4fd9992e9809da9ba542b2045480b5cb5c2c80"], "node": "55f9ba4a2ac1b24c2cbe37200cf15de45dcfd9b6", "parents": ["5891c4237108cda9de2d7cee8e8ddd8599b7ceb7"], "tags": []}, {"author": "Josh Matthews \u003cjosh@joshmatthews.net\u003e", "branch": "default", "desc": "Bug 2059331 [wpt PR 61627] - script: Claim blob URLs before fetching script sources., a=testonly\n\nAutomatic update from web-platform-tests\nscript: Claim blob URLs before fetching script sources.\n\nSigned-off-by: Josh Matthews \u003cjosh@joshmatthews.net\u003e\n\n--\n\nwpt-commits: 00ec6993ce23f6985f5849c0fe45da76b0c0c585\nwpt-pr: 61627\n", "files": ["testing/web-platform/tests/FileAPI/url/url-in-tags-revoke.window.js", "testing/web-platform/tests/FileAPI/url/url-in-tags.window.js"], "git_node": "ff223aec0259b342145be75e350cc226e92f0010", "git_parents": ["ad1040c81fb0246407c2cefec9c2ec3e7eddc6be"], "node": "1c99ccef82cda0b7b06f916951294055597fb4a2", "parents": ["55f9ba4a2ac1b24c2cbe37200cf15de45dcfd9b6"], "tags": []}, {"author": "Narfinger \u003cNarfinger@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2052184 [wpt PR 61041] - net: Do not return svg rasterization if requested size is zero width/height, a=testonly\n\nAutomatic update from web-platform-tests\nadded wpt crash test\n\nSigned-off-by: Narfinger \u003cNarfinger@users.noreply.github.com\u003e\n\n--\ncrash test formatting\n\nSigned-off-by: Narfinger \u003cNarfi