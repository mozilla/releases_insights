ab369042288", "c3a4b8000f68f22775ee9862c3af795cfeddf448", "d603406b5a7a76ed49c06fcaff73ee29f39af9e4", "9dc000a2b0addd3a91a1e5069a00570654899e9a", "53a9f32bb61282f87d0ad37486701e1dc7ea191e", "1d94e4ad2199e10b332e4c6114cfd32b2e513f7d", "69e22c569900bbd6e03636037a8b95c102ceaa1f", "4a10a041a6a4f9b36292082e5d0cf172c10389ed", "827e603217b8ac56f3d590a73d81395a9e745bc6", "62bb95d3fc5263b4e8f9b7605c44a678238bd4be", "7cdcc8dffeb5c7047235807f316fff4c3b15e17d", "5f9a039fb6b561ffeff0962d2ac83ed13afaf95b", "92eda4947b32cf044eee509b5fec376137cb4a27", "0f16fef034090c1c63f6e80e048eea32faad2ea3"], "user": "rperta@mozilla.com"}, "44959": {"changesets": [{"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051698 - Referrals Account page entry point r=fluent-reviewers,desktop-theme-reviewers,nbarrett,bolsson,dao\n\nCreates an entry point to the about:referrals page\nfrom the account page, gated behind the browser.referrals.enabled flag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313074\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/logos/share-firefox.svg", "browser/base/jar.mn", "browser/components/referrals/tests/browser/browser.toml", "browser/components/referrals/tests/browser/browser_referralsAccountMenu.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "3f157943d910e5a02f4641e903aa92b8a9a21aff", "git_parents": ["0f16fef034090c1c63f6e80e048eea32faad2ea3"], "node": "6a9117b98b3ab38081e71d21f64664e729b9729f", "parents": ["db59e73163ec54922cf9f65d125f9c06a477e50e"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2057194 - Make mach try watchman cache-warming work and discoverable r=taskgraph-reviewers,ahal\n\nThe watchman trigger that rebuilds the taskgraph cache in the background\n(tools/tryselect/watchman.json) ran `./mach python` in the default virtualenv,\nwhere `taskgraph` is not installed, so the background rebuild failed with\n`ModuleNotFoundError: No module named 'taskgraph'` and the cache was never\nwarmed. Run it in the `try` virtualenv where taskgraph lives.\n\nIt is also opt-in and most developers never discover it. Surface it at the\nmoment of pain: when an interactive `mach try` run hits a cache miss and\nwatchman is installed and already watching the checkout but the trigger is not\nregistered, print a short tip with the exact command to enable it. The hint is\ngated on `sys.stdout.isatty()`, so the background watchman trigger and CI runs\nstay silent, and it is never shown once the trigger is set up.\n\nPerformance win: with the trigger working again, the ~20s taskgraph cache\nrebuild that fires whenever a file under taskcluster/ changes (e.g. after\npulling mozilla-central) runs in the background instead of on the interactive\npath. Developers who enable it no longer pay that ~20s stall on the next\n`mach try`; the cache is already warm, so the generation step is a cache hit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313765\n", "files": ["tools/tryselect/tasks.py", "tools/tryselect/test/test_tasks.py", "tools/tryselect/watchman.json"], "git_node": "9bd7465a7faca1cbb339fc6cea03c9856063502f", "git_parents": ["3f157943d910e5a02f4641e903aa92b8a9a21aff"], "node": "d94d75b68b17aa48f9459cef196dfb3c99a4b33d", "parents": ["6a9117b98b3ab38081e71d21f64664e729b9729f"], "tags": []}, {"author": "Nicolas Grunbaum \u003cngrunbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 1806181 - Add distinct errors for SDP parsing failures. r=webrtc-reviewers,bwc,diegociudadreale,!bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D295656\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.h", "dom/media/webrtc/sdp/SdpHelper.cpp", "dom/media/webrtc/sdp/SdpHelper.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "testing/web-platform/meta/webrtc/protocol/ice-ufragpwd.html.ini"], "git_node": "c8a22176911b3280a0e0a9e997c6995c1bc14682", "git_parents": ["9bd7465a7faca1cbb339fc6cea03c9856063502f"], "node": "7417c0cdee6912c714293caf8f93b124adfe1148", "parents": ["d94d75b68b17aa48f9459cef196dfb3c99a4b33d"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045119 - Check sizes of received shared memory objects on `mmap`-using platforms. r=afranchuk,sandbox-reviewers\n\nSee the added comments on the various `Platform::IsSafeToMap` methods\nfor more details.\n\nAlso modifies the Linux sandbox policies: all processes can read file\nseals and set shrink/grow seals.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306581\n", "files": ["ipc/glue/SharedMemoryHandle.cpp", "ipc/glue/SharedMemoryPlatform.h", "ipc/glue/SharedMemoryPlatform_android.cpp", "ipc/glue/SharedMemoryPlatform_mach.cpp", "ipc/glue/SharedMemoryPlatform_posix.cpp", "ipc/glue/SharedMemoryPlatform_windows.cpp", "security/sandbox/linux/SandboxFilter.cpp"], "git_node": "61bc1b7a8ee048bcf91886193eb12df3b0f552e5", "git_parents": ["c8a22176911b3280a0e0a9e997c6995c1bc14682"], "node": "a920d4196288d1f560425ad81757677d03cb4104", "parents": ["7417c0cdee6912c714293caf8f93b124adfe1148"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045119 - Add test cases for tampering with a shared memory handle's size. r=afranchuk\n\nThis adds some affordances for testing which might have other uses:\n\n* A test fixture class which allows access to otherwise private operations,\n  to test what happens in situations normally disallowed by C++ types\n\n* A mock IPC actor that turns deserialization FatalError calls into\n  non-fatal logging, to test that invalid input is correctly rejected\n  without the overhead of gtest death tests\n\n* SerializeAndDeserialize is now factored out and type-generic\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306582\n", "files": ["ipc/glue/SharedMemoryHandle.h", "ipc/gtest/IPCTestUtils.h", "ipc/gtest/TestBigBuffer.cpp", "ipc/gtest/TestSharedMemory.cpp"], "git_node": "647bee22dab0f9c7ee42da56ea138fae27f60eef", "git_parents": ["61bc1b7a8ee048bcf91886193eb12df3b0f552e5"], "node": "653b81fb5838e2fbff3d8f0a94b37fed0b76718d", "parents": ["a920d4196288d1f560425ad81757677d03cb4104"], "tags": []}, {"author": "Jed Davis \u003cjld@mozilla.com\u003e", "branch": "default", "desc": "Bug 2047332 - Fix the FreezeAndMapRW shared memory gtest. r=afranchuk\n\nThe original intent of that test, expressed in terms of the current API,\nis: what if you could transmute a ReadOnlyHandle into a MutableHandle?\nSo now there's a test-only method for that.\n\nBonus fix: reword the comment for Reprotect; I found the old one to be\nconfusing.  (It is also the case that you can't set bits in `max_prot`\nthat the object being mapped doesn't like, but it's FreezeAndMapRW that\ntests that part, not Reprotect.)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306583\n", "files": ["ipc/gtest/TestSharedMemory.cpp"], "git_node": "5062913db7e751ea9968498b47d2a108b12fc691", "git_parents": ["647bee22dab0f9c7ee42da56ea138fae27f60eef"], "node": "ea6188aa9fb246d79ff54872fb58d6665c54f5ff", "parents": ["653b81fb5838e2fbff3d8f0a94b37fed0b76718d"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057327 - metadata update for css/printing/table-container-query-crash-print.html\n", "files": ["testing/web-platform/meta/css/printing/table-container-query-crash-print.html.ini"], "git_node": "a91aa2eb26120b02163a9756d7e05b00c5781d32", "git_parents": ["5062913db7e751ea9968498b47d2a108b12fc691"], "node": "a538ff2882e11c58043cdc1b22cdcd13bd0184f1", "parents": ["ea6188aa9fb246d79ff54872fb58d6665c54f5ff"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057327 - metadata update for audio-output/enumerateDevices-with-selectAudioOutput.https.html DONTBUILD\n", "files": ["testing/web-platform/meta/audio-output/enumerateDevices-with-selectAudioOutput.https.html.ini"], "git_node": "096eba608d472aeea452bf3a7a96a091ba3214bc", "git_parents": ["a91aa2eb26120b02163a9756d7e05b00c5781d32"], "node": "2e6dc988863549aa4acf23e9c1447b9d50e2c9bb", "parents": ["a538ff2882e11c58043cdc1b22cdcd13bd0184f1"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057327 - metadata update for css/printing/table-container-query-crash-print.html DONTBUILD\n", "files": ["testing/web-platform/meta/css/printing/table-container-query-crash-print.html.ini"], "git_node": "d106e333f95b4f098bff045855ccbfaa4906604e", "git_parents": ["096eba608d472aeea452bf3a7a96a091ba3214bc"], "node": "356189c0098d77abc7d775d9dc96cd7294f8f6a9", "parents": ["2e6dc988863549aa4acf23e9c1447b9d50e2c9bb"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057327 - removed ini file as it's no longer needed DONTBUILD\n", "files": ["testing/web-platform/meta/css/printing/table-container-query-crash-print.html.ini"], "git_node": "7fbf5839f8c36bf1dace7471722d6407b6d4e27c", "git_parents": ["d106e333f95b4f098bff045855ccbfaa4906604e"], "node": "bae7c55998d9d5cbcbf5a99565fb281ce3f45952", "parents": ["356189c0098d77abc7d775d9dc96cd7294f8f6a9"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2051698 - Referrals Account page entry point r=fluent-reviewers,desktop-theme-reviewers,nbarrett,bolsson,dao\" for causing failures on browser_referralsAccountMenu.\n\nThis reverts commit 3f157943d910e5a02f4641e903aa92b8a9a21aff.\n", "files": ["browser/base/content/appmenu-viewcache.inc.xhtml", "browser/base/content/browser-sync.js", "browser/base/content/logos/share-firefox.svg", "browser/base/jar.mn", "browser/components/referrals/tests/browser/browser.toml", "browser/components/referrals/tests/browser/browser_referralsAccountMenu.js", "browser/locales/en-US/browser/appmenu.ftl", "browser/themes/shared/customizableui/panelUI-shared.css"], "git_node": "dbc0b9b2476f9bd9b828f5314f4ee68c6180f32a", "git_parents": ["7fbf5839f8c36bf1dace7471722d6407b6d4e27c"], "node": "a31952fe04d5a96b650c4ae1471fd7010dc170e8", "parents": ["bae7c55998d9d5cbcbf5a99565fb281ce3f45952"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2040379 part 1 - add WebSerial module to errors and a new NS_ERROR_DOM_SERIAL_PARITY_ERROR r=cmartin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306785\n", "files": ["dom/base/DOMException.cpp", "dom/base/domerr.msg", "dom/bindings/Exceptions.cpp", "xpcom/base/ErrorList.py"], "git_node": "1b417fd15b4ffaa821535179dcf6c098dcdcfdf7", "git_parents": ["dbc0b9b2476f9bd9b828f5314f4ee68c6180f32a"], "node": "3581d1b5998ab5021f8a8b92a3ff7692b15cc89d", "parents": ["a31952fe04d5a96b650c4ae1471fd7010dc170e8"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2040379 part 2 - add ability to override what error is returned from a stream - r=saschanaz\n\nAlso do this for the new NS_ERROR_DOM_SERIAL_PARITY_ERROR nserror. This error\nwill get returned from parity decoders in parts 4 and 5.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306786\n", "files": ["dom/streams/UnderlyingSinkCallbackHelpers.cpp", "dom/streams/UnderlyingSinkCallbackHelpers.h", "dom/streams/UnderlyingSourceCallbackHelpers.cpp", "dom/streams/UnderlyingSourceCallbackHelpers.h", "dom/streams/gtest/TestUnderlyingSinkCallbackHelpers.cpp", "dom/streams/gtest/moz.build", "dom/streams/moz.build", "dom/webserial/SerialPortStreamAlgorithms.cpp", "dom/webserial/SerialPortStreamAlgorithms.h"], "git_node": "3f9d7ab24736eb6dbbc99c24320d0e1002742da0", "git_parents": ["1b417fd15b4ffaa821535179dcf6c098dcdcfdf7"], "node": "736e727307f2c788e51daa240426495b156c0573", "parents": ["3581d1b5998ab5021f8a8b92a3ff7692b15cc89d"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2040379 part 3 - set up parity checking in WebSerial - r=cmartin\n\nThis just passes the flag along - the actual parity checking will\nbe done in platform-specific code in parts 4 and 5.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306787\n", "files": ["dom/webserial/SerialPlatformService.cpp", "dom/webserial/SerialPlatformService.h", "dom/webserial/SerialPortParent.cpp", "dom/webserial/SerialPortParent.h", "dom/webserial/TestSerialPlatformService.cpp", "dom/webserial/TestSerialPlatformService.h"], "git_node": "d62a24677a8ca1d65bf56bb2072134bad0ff523e", "git_parents": ["3f9d7ab24736eb6dbbc99c24320d0e1002742da0"], "node": "a06c586f003f7d88c988c9cb9c32dab9fcd90774", "parents": ["736e727307f2c788e51daa240426495b156c0573"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2040379 part 4 - WebSerial parity checking on Windows - r=cmartin\n\nOn Windows, parity errors are reported through ClearCommError(), so add\na Win32SerialParityCheckStream stream wrapper that just calls that\nand reports it when appropriate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306788\n", "files": ["dom/webserial/Win32SerialParityCheckStream.cpp", "dom/webserial/Win32SerialParityCheckStream.h", "dom/webserial/Win32SerialPlatformService.cpp", "dom/webserial/Win32SerialPlatformService.h", "dom/webserial/moz.build"], "git_node": "5dabee2c0a50670051af37a2fad855b3fe4d4f14", "git_parents": ["d62a24677a8ca1d65bf56bb2072134bad0ff523e"], "node": "c9cdda3b196af2f40cdc1c306df2ad2d1e4e3b55", "parents": ["a06c586f003f7d88c988c9cb9c32dab9fcd90774"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2040379 part 5 - WebSerial parity checking on Mac/Linux with tests - r=Thinker\n\nOn Mac/Linux, setting the PARMRK flag on a serial port will cause it\nto parity check by returning 0xff 0x00 (plus one additional byte) in\ncase of an error. \"regular\" 0xff bytes then have to be escaped by\nreturning 0xff 0xff. The PosixSerialParityDecodeStream handles both\nof these cases.\n\nAlso add some gtests for PosixSerialParityDecodeStream (that run on all\nplatforms)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306789\n", "files": ["dom/webserial/PosixSerialParityDecodeStream.cpp", "dom/webserial/PosixSerialParityDecodeStream.h", "dom/webserial/PosixSerialPlatformService.cpp", "dom/webserial/PosixSerialPlatformService.h", "dom/webserial/moz.build", "dom/webserial/tests/gtest/TestSerialParityDecodeStream.cpp", "dom/webserial/tests/gtest/moz.build"], "git_node": "99632501440d51c156cc020be1b2995824599509", "git_parents": ["5dabee2c0a50670051af37a2fad855b3fe4d4f14"], "node": "84ea9e6cf6537952804ab4aac9bb23e816037d3a", "parents": ["c9cdda3b196af2f40cdc1c306df2ad2d1e4e3b55"], "tags": []}, {"author": "nirmaladvani \u003cnirmaladvani@live.com\u003e", "branch": "default", "desc": "Bug 2033570 - Use byte length instead of domain length when hashing non-ASCII domains r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313987\n", "files": ["browser/components/search/SERPCategorization.sys.mjs"], "git_node": "e1940c0a6cdbcefae17afefcd624aa9f5fab8eec", "git_parents": ["99632501440d51c156cc020be1b2995824599509"], "node": "a117da5b05d482a390404bf2d25d1b9e81e972d4", "parents": ["84ea9e6cf6537952804ab4aac9bb23e816037d3a"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048118: Part 1 - Back off the NetworkGeolocationProvider retry timer while requests are failing r=saschanaz\n\nApply bounded exponential backoff to the repeating request timer after network\nfailures (increasing up to geo.provider.network.backoffMaxMs, default 20s) so a\nfailing or unreachable endpoint is not retried every 5s indefinitely, which\ndrains battery on always-on machines. The backoff is reset to the normal\ncadence on a new watch request and on a successful response, so genuine\nrequests are never delayed by a prior failure's backoff.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309730\n", "files": ["dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "8dc47543f04a527ffc69997c76b76d9cb1e0f5ba", "git_parents": ["e1940c0a6cdbcefae17afefcd624aa9f5fab8eec"], "node": "96b176e7f711f3b7ba08fcde99a845fa13dbd6bf", "parents": ["a117da5b05d482a390404bf2d25d1b9e81e972d4"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048118: Part 2 - Stop active NetworkGeolocationProvider when GeoClue recovers r=saschanaz\n\nUpdateLastPosition only stopped the fallback _wait timer_, so an MLS fallback\nthat had already started (e.g. after a GeoClue error) kept running its\nNetworkGeolocation provider -- issuing network requests for the rest of the\nsession -- despite GeoClue producing positions again. Shut down an active\nfallback on recovery with \"ProviderResponded\", matching how CoreLocation and\nPortal work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309731\n", "files": ["dom/system/linux/GeoclueLocationProvider.cpp"], "git_node": "a790333c3776722828a6d968a42d1d05f4a37d32", "git_parents": ["8dc47543f04a527ffc69997c76b76d9cb1e0f5ba"], "node": "68c8dbccfb165eefd97d3458b508f7ccb17d7119", "parents": ["96b176e7f711f3b7ba08fcde99a845fa13dbd6bf"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048118: Part 3 - Reset NetworkGeolocationProvider request backoff on a new request r=saschanaz\n\nReset the NetworkGeolocationProvider failure backoff whenever a different\nprovider falls back, which can happen multiple times.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309732\n", "files": ["dom/geolocation/MLSFallback.cpp", "dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "67d3887e9bf2fb19e45fb58b0c6a0af8b4310ca0", "git_parents": ["a790333c3776722828a6d968a42d1d05f4a37d32"], "node": "c6adf7f5991782d10716ed467db7fbfcfa79e099", "parents": ["68c8dbccfb165eefd97d3458b508f7ccb17d7119"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048118: Part 4 - Persist the NetworkGeolocationProvider request cache across shutdown r=saschanaz\n\nStop clearing gCachedRequest in shutdown() so a recent position can be reused\nacross the provider's stop/restart cycles within a browser run, instead of\ncold-starting a network request for each intermittent geolocation use.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313338\n", "files": ["dom/geolocation/test/unit/test_geolocation_network_cache.js", "dom/geolocation/test/unit/xpcshell.toml", "dom/system/NetworkGeolocationProvider.sys.mjs"], "git_node": "0d26e830b1136a9485b57acc783d9b14521c2659", "git_parents": ["67d3887e9bf2fb19e45fb58b0c6a0af8b4310ca0"], "node": "1d4b090b0792e3479fb97119f75c44302ff704f4", "parents": ["c6adf7f5991782d10716ed467db7fbfcfa79e099"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2049782 - Add nsIAlertCallbacks to replace nsIObserver for Alerts Service r=nrishel,win-reviewers\n\nHaving this new interface should allow us to introduce more observer topics without fears on internal backwards compatibility.\n\nExisting callers can still use nsIObservers with the same behavior, while ideally we should slowly move them to this new approach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308321\n", "files": ["dom/notification/NotificationParent.cpp", "dom/notification/NotificationUtils.cpp", "dom/notification/NotificationUtils.h", "toolkit/components/alerts/alert.js", "toolkit/components/alerts/nsAlertsService.cpp", "toolkit/components/alerts/nsIAlertsService.idl", "toolkit/components/alerts/nsXULAlerts.cpp", "toolkit/components/alerts/nsXULAlerts.h", "toolkit/components/alerts/test/chrome/chrome.toml", "toolkit/components/alerts/test/chrome/test_alerts_callbacks.html", "toolkit/system/gnome/nsAlertsIconListener.cpp", "toolkit/system/gnome/nsAlertsIconListener.h", "toolkit/system/gnome/nsSystemAlertsService.cpp", "widget/cocoa/MacOSNotificationCenter.mm", "widget/windows/ToastNotification.cpp", "widget/windows/ToastNotificationHandler.cpp", "widget/windows/ToastNotificationHandler.h"], "git_node": "8666df3829b220f7ed6f599f3036432f9bbf77c4", "git_parents": ["0d26e830b1136a9485b57acc783d9b14521c2659"], "node": "28e8946d978521e551e1bb703f60ad52bc7b6b28", "parents": ["1d4b090b0792e3479fb97119f75c44302ff704f4"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2049782 - Fall back to ShowAlert in AndroidAlerts r=nrishel\n\nUpdating AndroidAlerts is possible, but properly doing so requires GeckoView API change. For now we fall back to ShowAlert with nsIObserver.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312485\n", "files": ["widget/android/AndroidAlerts.cpp"], "git_node": "0dd447c333a61423652765cab631f2f36b2ca348", "git_parents": ["8666df3829b220f7ed6f599f3036432f9bbf77c4"], "node": "77ec5c7bf60f820eb2f3ebbd56f7ded9cc7a0944", "parents": ["28e8946d978521e551e1bb703f60ad52bc7b6b28"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2049782 - Update Alerts Service mocks to use showAlertWithCallbacks r=extension-reviewers,nrishel,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312486\n", "files": ["dom/notification/test/browser/browser_openwindow_without_window.js", "dom/notification/test/browser/browser_userContextId_openWindow.js", "dom/notification/test/browser/browser_userContextId_tag.js", "dom/notification/test/chrome/test_notification_system_principal.xhtml", "dom/notification/test/mochitest/MockAlertsService.js", "dom/notification/test/mochitest/test_notification_tag.html"], "git_node": "02f32c0fd9dcb695491e462098902a26d7d77688", "git_parents": ["0dd447c333a61423652765cab631f2f36b2ca348"], "node": "a443f1f9a6ebeb4f972849f1e1a3b0bc613e09dc", "parents": ["77ec5c7bf60f820eb2f3ebbd56f7ded9cc7a0944"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2052574 - Track ignored notifications on Windows r=nrishel,win-reviewers\n\nWith the following code I can confirm that the new dismissed-from-forgeground event works.\n\n```js\nalerts = Cc[\"@mozilla.org/alerts-service;1\"].getService().QueryInterface(Ci.nsIAlertsService)\nalert = Cc[\"@mozilla.org/alert-notification;1\"].createInstance().QueryInterface(Ci.nsIAlertNotification)\nalert.initWithObject({ title: \"foo\", textClickable: true })\nalerts.showAlertWithCallbacks(alert, { onAlertDismissedFromForeground: () =\u003e console.log(\"dismissed-from-foreground\"), onAlertClick: () =\u003e console.log(\"click\"), onAlertFinished: () =\u003e console.log(\"closed\") })\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310399\n", "files": ["dom/notification/NotificationParent.cpp", "toolkit/components/alerts/nsAlertsService.cpp", "toolkit/components/alerts/nsIAlertsService.idl", "toolkit/components/alerts/nsXULAlerts.cpp", "widget/windows/ToastNotificationHandler.cpp"], "git_node": "f3645dccf171aa2bb9df25f84f628a9c2b0b69fa", "git_parents": ["02f32c0fd9dcb695491e462098902a26d7d77688"], "node": "da0d064d987b0c08be7be8848228b6ae234fbe69", "parents": ["a443f1f9a6ebeb4f972849f1e1a3b0bc613e09dc"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2046925 - Refactor NotificationObserver::Observe for clearer behavior for each topic r=asuth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D306258\n", "files": ["dom/notification/NotificationParent.cpp", "dom/notification/NotificationParent.h"], "git_node": "ec79cf13a973d18f3a3a49e8d0bd2f2756d52b4a", "git_parents": ["f3645dccf171aa2bb9df25f84f628a9c2b0b69fa"], "node": "a75b4cca763c4404a37e76aab31917001c8e3fc1", "parents": ["da0d064d987b0c08be7be8848228b6ae234fbe69"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2046221 - Part 2: Add telemetry to NotificationParent r=nrishel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D305800\n", "files": ["dom/notification/NotificationParent.cpp", "dom/notification/metrics.yaml", "testing/web-platform/mozilla/tests/notifications/resources/MockAlertsService.js", "testing/web-platform/mozilla/tests/notifications/resources/SiteCategory.js", "testing/web-platform/mozilla/tests/notifications/telemetry.sub.https.window.js"], "git_node": "30535b73ee9bb0dbdf4f69ec1bd6115b468a7a80", "git_parents": ["ec79cf13a973d18f3a3a49e8d0bd2f2756d52b4a"], "node": "67ef552f1d254f94c676c749833850a8ebdb8f26", "parents": ["a75b4cca763c4404a37e76aab31917001c8e3fc1"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1806181 - Add distinct errors for SDP parsing failures. r=webrtc-reviewers,bwc,diegociudadreale,!bwc\" for causing wpt failures at RTCPeerConnection-setLocalDescription-offer.html\n\nThis reverts commit c8a22176911b3280a0e0a9e997c6995c1bc14682.\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "dom/media/webrtc/jsep/JsepSessionImpl.h", "dom/media/webrtc/sdp/SdpHelper.cpp", "dom/media/webrtc/sdp/SdpHelper.h", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp", "testing/web-platform/meta/webrtc/protocol/ice-ufragpwd.html.ini"], "git_node": "05c73022493b190da81dca6cb311a1ea6bfade92", "git_parents": ["30535b73ee9bb0dbdf4f69ec1bd6115b468a7a80"], "node": "2d5b83ba6be959a0c92562452206c2f1c9990c35", "parents": ["67ef552f1d254f94c676c749833850a8ebdb8f26"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057373 - Update webserial moz.build BUG_COMPONENT r=gstoll\n\nWe added a new component (DOM: Web Serial) for Web Serial bugs in bugzilla. Update the moz.build accordingly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313907\n", "files": ["dom/webserial/moz.build"], "git_node": "e1277129c14ebe35d99042847f0ae288236dbf00", "git_parents": ["05c73022493b190da81dca6cb311a1ea6bfade92"], "node": "23c5f08f26ccceba5a9fbb782d1c0d22df003c17", "parents": ["2d5b83ba6be959a0c92562452206c2f1c9990c35"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2052432 - Upload a minidump for force-killed hung xpcshell processes on timeout, r=ahal.\n\nWhen the harness force-kills a hung test on timeout, testTimeout returned before\nrun_test's normal checkForCrashes, so the minidump was never saved to the upload\ndirectory. On Linux/macOS kill_and_get_minidump only sends SIGABRT (the process\nwrites the dump itself via Breakpad), and postCheck's SIGKILL raced the\nin-progress dump.\n\nWait, bounded by TIMEOUT_MINIDUMP_WAIT, for the process to finish writing its\nminidump, then run checkForCrashes so the dump is uploaded as a test artifact and\nits thread stacks are symbolicated into the log. The test is still reported as\nTIMEOUT; the \"not a real crash\" note is buffered as a test message so a retried\nrun keeps it out of the failure summary.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310267\n", "files": ["testing/xpcshell/runxpcshelltests.py"], "git_node": "9c91ab8a575ecc5d7a515fab94e7bd804a3d9786", "git_parents": ["e1277129c14ebe35d99042847f0ae288236dbf00"], "node": "c36edac9aec77111b8c9aeeed8647263237d5d36", "parents": ["23c5f08f26ccceba5a9fbb782d1c0d22df003c17"], "tags": []}, {"author": "Tim Giles \u003ctgiles@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055941 - Only show the theme-picker native-theme checkbox on Linux r=mstriemer,niklas\n\nThe native-theme option only applies on Linux. A showNativeThemeOption\nproperty controls its visibility, set from AppConstants.platform.\nabout:editprofile is unprivileged content, so the ThemePickerParent\nactor computes the visibility and sends it in the initial-state payload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313594\n", "files": ["browser/actors/ThemePickerParent.sys.mjs", "browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_nova_test.js", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/theme-picker/theme-picker-direct-controller.mjs", "toolkit/content/widgets/theme-picker/theme-picker-remote-controller.mjs", "toolkit/content/widgets/theme-picker/theme-picker.mjs", "toolkit/content/widgets/theme-picker/theme-picker.stories.mjs"], "git_node": "31081f9b6e44ef0daa5591584cc6148ac155ae31", "git_parents": ["9c91ab8a575ecc5d7a515fab94e7bd804a3d9786"], "node": "293745b329d52c4b035be9f0f3cd58ffd41383e0", "parents": ["c36edac9aec77111b8c9aeeed8647263237d5d36"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052960: Add Smart window new tab as an overwrittable page on restore previous session r=sthompson\n\n**Issue**: When Smart Window is the user's default and you restore the previous session manually (History -\u003e Restore Previous Session), the restored tabs open alongside the empty Smart Window new tab instead of replacing it. In a Classic window the restore correctly overwrites the initial new tab.\n\n**Cause**: Smart Window's new tab is `chrome://browser/content/aiwindow/aiWindow.html` (or first run), which weren''t in the list of homepages in SessionStore, so they're not treated as removable. As a result, SessionStore appended the previous session's tabs instead of overwriting the new tab.\n\n**Solution**: Add the Smart Window new tab (or first run) as homepages to be overwritten in SessionStore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D312827\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/marionette/test_restore_aiwindow.py"], "git_node": "1189cacea8d47583612b50a55b350634f1e18fa9", "git_parents": ["31081f9b6e44ef0daa5591584cc6148ac155ae31"], "node": "e48087da534d42515709f487a5b0ef89b945e1b1", "parents": ["293745b329d52c4b035be9f0f3cd58ffd41383e0"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056829 - Adapt hidden findbar margin-bottom to Nova. r=sclements.\n\nThis adds CSS variables for the findbar top border, block padding and the container\nheight, so we can compute the full findbar height, than we can use in the margin-bottom\ndeclaration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313400\n", "files": ["toolkit/themes/shared/findbar.css"], "git_node": "94f50f3545edac0162f73bfb8ef5235f5d00a0ef", "git_parents": ["1189cacea8d47583612b50a55b350634f1e18fa9"], "node": "62616c0298769ee47b7d66b06f0b7634e9c10786", "parents": ["e48087da534d42515709f487a5b0ef89b945e1b1"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP - r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314107\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "020a55e0e10abe7cbc2531d79ef38263547e0d2c", "git_parents": ["94f50f3545edac0162f73bfb8ef5235f5d00a0ef"], "node": "7d62046a2a57d9956974425eb26ff69acebc88be", "parents": ["62616c0298769ee47b7d66b06f0b7634e9c10786"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2052706 - Keep sidebar interactive in F11 fullscreen autohide r=emilio,sfoster\n\nThe autohide hides the toolbox when the pointer enters FullScreen's mouse-target\nrect. That rect was cached from tabpanels before the sidebar settled, so it\ncovered the sidebar; hovering it hid the toolbox (and the sidebar), making\nvertical tabs uninteractive.\n\nCompute the rect live in getMouseTargetRect so it follows the sidebar reveal.\nOnce settled, tabpanels excludes the sidebar on whichever side it sits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310514\n", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js"], "git_node": "d13d84f85973a1ba200bf6d4834d8a1888ec04fb", "git_parents": ["020a55e0e10abe7cbc2531d79ef38263547e0d2c"], "node": "2b60547b83934f04d315277d95f6289f4252232f", "parents": ["7d62046a2a57d9956974425eb26ff69acebc88be"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2052711 - Keep panel sidebars visible in F11 fullscreen r=emilio,desktop-theme-reviewers,dao,sfoster\n\nBug 1927457 collapsed all sidebar elements on fullscreenNavToolboxHidden, so in\nF11 the panel sidebars (bookmarks, history) hid too and Ctrl+B couldn't bring\nthem back. The intent was to hide only the tools/vertical-tabs launcher, like\nthe horizontal tab strip.\n\nSplit the CSS: the launcher (#sidebar-container, #sidebar-launcher-splitter)\nstill hides with the toolbox, while the panel (#sidebar-box, #sidebar-splitter)\nonly hides in DOM fullscreen and stays toggleable in F11.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310515\n", "files": ["browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/themes/shared/tabbrowser/fullscreen-and-pointerlock.css"], "git_node": "f0efa59a7415ffe5d76a418ef782a05dbe68e77c", "git_parents": ["d13d84f85973a1ba200bf6d4834d8a1888ec04fb"], "node": "2f36029f863e8d37d1fe5707eb335571f61f48ed", "parents": ["2b60547b83934f04d315277d95f6289f4252232f"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2056362 - Attach dismiss delegate to autofill select prompts r=android-reviewers,fmasalha,sfamisa\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309948\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/prompt/GeckoPromptDelegate.kt", "mobile/android/android-components/components/browser/engine-gecko/src/test/java/mozilla/components/browser/engine/gecko/prompt/GeckoPromptDelegateTest.kt", "mobile/android/android-components/docs/changelog.md"], "git_node": "7dde775d7b94b1e154fd21d52c8bb6c35f59fe07", "git_parents": ["f0efa59a7415ffe5d76a418ef782a05dbe68e77c"], "node": "94790c9496507bb03e3cc40d403777b26f39ab7b", "parents": ["2f36029f863e8d37d1fe5707eb335571f61f48ed"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2056362 - Keep the GeckoView autofill selection prompt open across same-type field focus changes r=geckoview-reviewers,owlish,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D309949\n", "files": ["mobile/android/app/geckoview-prefs.js", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AutocompleteTest.kt", "mobile/shared/modules/geckoview/GeckoViewAutocomplete.sys.mjs", "toolkit/actors/AutoCompleteChild.sys.mjs", "toolkit/actors/AutoCompleteParent.sys.mjs", "toolkit/modules/ActorManagerParent.sys.mjs"], "git_node": "b43b2c3e1b4031b078f81962ec483c83d6b51fe4", "git_parents": ["7dde775d7b94b1e154fd21d52c8bb6c35f59fe07"], "node": "42000efc37d990834e0f192aaee8134b6cffc849", "parents": ["94790c9496507bb03e3cc40d403777b26f39ab7b"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2047332, Bug 2045119 - Fix the FreezeAndMapRW shared memory gtest. r=afranchuk\" for causing gtest failures\n\nThis reverts commit 5062913db7e751ea9968498b47d2a108b12fc691.\n\nRevert \"Bug 2045119 - Add test cases for tampering with a shared memory handle's size. r=afranchuk\"\n\nThis reverts commit 647bee22dab0f9c7ee42da56ea138fae27f60eef.\n\nRevert \"Bug 2045119 - Check sizes of received shared memory objects on `mmap`-using platforms. r=afranchuk,sandbox-reviewers\"\n\nThis reverts commit 61bc1b7a8ee048bcf91886193eb12df3b0f552e5.\n", "files": ["ipc/glue/SharedMemoryHandle.cpp", "ipc/glue/SharedMemoryHandle.h", "ipc/glue/SharedMemoryPlatform.h", "ipc/glue/SharedMemoryPlatform_android.cpp", "ipc/glue/SharedMemoryPlatform_mach.cpp", "ipc/glue/SharedMemoryPlatform_posix.cpp", "ipc/glue/SharedMemoryPlatform_windows.cpp", "ipc/gtest/IPCTestUtils.h", "ipc/gtest/TestBigBuffer.cpp", "ipc/gtest/TestSharedMemory.cpp", "security/sandbox/linux/SandboxFilter.cpp"], "git_node": "2fb813acd5b150f50fca537ca5334d6669e16a84", "git_parents": ["b43b2c3e1b4031b078f81962ec483c83d6b51fe4"], "node": "3a5af41d28e104cdba8ca4bae652556b45f7d54f", "parents": ["42000efc37d990834e0f192aaee8134b6cffc849"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2057474 - Add a bloom filter to AttrAtomArray. r=firefox-style-system-reviewers,dshin\n\nAvoids scanning through multiple classes in the common case.\n\nSee results in comment 0.\n\nBased on D314045, but significantly tweaked so that the bloom filter\ncan't get out of sync, and so that the check is performed only at the\nright place (and also for part / snapshots, which is probably minor\nbut...).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314057\n", "files": ["dom/base/Element.cpp", "dom/base/nsAttrValue.cpp", "dom/base/nsAttrValue.h", "dom/base/nsContentUtils.cpp", "servo/components/style/gecko/snapshot_helpers.rs"], "git_node": "41db326304dc10408f6ca2d3a57fd616b7ce643f", "git_parents": ["2fb813acd5b150f50fca537ca5334d6669e16a84"], "node": "8e134c3dbc47c6bfe83c413dea0f98991b0ae283", "parents": ["3a5af41d28e104cdba8ca4bae652556b45f7d54f"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052711 - Keep panel sidebars visible in F11 fullscreen r=emilio,desktop-theme-reviewers,dao,sfoster\" for causgin bc failures at browser_panelUINotifications_fullscreen.js\n\nThis reverts commit f0efa59a7415ffe5d76a418ef782a05dbe68e77c.\n\nRevert \"Bug 2052706 - Keep sidebar interactive in F11 fullscreen autohide r=emilio,sfoster\"\n\nThis reverts commit d13d84f85973a1ba200bf6d4834d8a1888ec04fb.\n", "files": ["browser/base/content/browser-fullScreenAndPointerLock.js", "browser/components/sidebar/tests/browser/browser_f11_fullscreen_sidebar.js", "browser/themes/shared/tabbrowser/fullscreen-and-pointerlock.css"], "git_node": "958f658f72121c02dc7358f97ce3b7aa357233c9", "git_parents": ["41db326304dc10408f6ca2d3a57fd616b7ce643f"], "node": "9bbbd60f9aeb28d15f4068134edba72eeb9c605c", "parents": ["8e134c3dbc47c6bfe83c413dea0f98991b0ae283"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057652 - Fix onboarding theme picker string typo r=fluent-reviewers,omc-reviewers,bolsson,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314121\n", "files": ["browser/locales/en-US/browser/newtab/onboarding.ftl"], "git_node": "5df0609d9a90b960735105f46be59fe3ac21f450", "git_parents": ["958f658f72121c02dc7358f97ce3b7aa357233c9"], "node": "2bca7e10b22b61785619d6fd13ab166d0d51c83b", "parents": ["9bbbd60f9aeb28d15f4068134edba72eeb9c605c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/a