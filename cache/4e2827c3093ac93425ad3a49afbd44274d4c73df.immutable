, null, null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "20": {"changesets": [{"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 1773298 - Convert prefix to lowercase before lookup in stripURLPrefix - r=adw, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149589", "files": ["browser/components/urlbar/UrlbarUtils.jsm", "browser/components/urlbar/tests/unit/test_autofill_urls.js"], "git_node": null, "git_parents": [null], "node": "e0d6eee37ac36edc144049caff3f0e1b306df221", "parents": ["fd70456addc7987fd0c9270d84a59327b154e57d"], "tags": []}, {"author": "Doug Thayer \u003cdothayer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774750 - Fix wasSilentlyStarted typo in UpdateService.jsm. r=nalexander, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149688", "files": ["toolkit/mozapps/update/UpdateService.jsm"], "git_node": null, "git_parents": [null], "node": "e762190a44bc5717a6908e54a5a0ccfa3db32ddd", "parents": ["e0d6eee37ac36edc144049caff3f0e1b306df221"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774683, use ValidateFilenameForSaving to validate dropped links on Windows, r=mhowell a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149746", "files": ["widget/windows/nsDataObj.cpp"], "git_node": null, "git_parents": [null], "node": "ddfb2c8160d48f6961fd55b07b86f28a2a4ddf89", "parents": ["e762190a44bc5717a6908e54a5a0ccfa3db32ddd"], "tags": []}, {"author": "Gabriele Svelto \u003cgsvelto@mozilla.com\u003e", "branch": "default", "desc": "Bug 1713160 - Avoid crashes when setting the description of the minidump generation thread. r=rkraesig, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149869", "files": ["toolkit/crashreporter/breakpad-client/windows/handler/exception_handler.cc"], "git_node": null, "git_parents": [null], "node": "ab7b0f24d2d22ce8e636993b6809c8bfe1fbf4da", "parents": ["ddfb2c8160d48f6961fd55b07b86f28a2a4ddf89"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1769739. r=jgilbert, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D146842", "files": ["dom/canvas/WebGLContext.cpp", "dom/canvas/WebGLContext.h"], "git_node": null, "git_parents": [null], "node": "82410fac4ef60a7d265a046ab1c9eab9857c9c81", "parents": ["ab7b0f24d2d22ce8e636993b6809c8bfe1fbf4da"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 1772824 - Don't use the megamorphic cache for GetBoundName. r=iain, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150097", "files": ["js/src/jit-test/tests/cacheir/bug1772824.js", "js/src/jit/CacheIR.cpp", "js/src/jit/VMFunctions.cpp"], "git_node": null, "git_parents": [null], "node": "da73c70e614d1b80b85167a708c899032063f56b", "parents": ["82410fac4ef60a7d265a046ab1c9eab9857c9c81"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774631 - Fix typo in cairo-pdf-surface.c that causes us to get spuriously-rasterized PDF output. r=jrmuizel, a=RyanVM\n\nThere's a typo in the condition here, which results in returning CAIRO_INT_STATUS_UNSUPPORTED\nin cases where that shouldn't be necessary. Fixing this gets me nice vector PDF output.\n\nThe bug is still present in upstream cairo trunk, so I'll report it there as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150381", "files": ["gfx/cairo/cairo/src/cairo-pdf-surface.c"], "git_node": null, "git_parents": [null], "node": "98fde68247174541ec01c5a712af3b5d085937ee", "parents": ["da73c70e614d1b80b85167a708c899032063f56b"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774916 - Avoid opening temporary X display in error handler. r=aosmond,gfx-reviewers,nical a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150401", "files": ["toolkit/xre/nsAppRunner.cpp", "toolkit/xre/nsEmbedFunctions.cpp", "toolkit/xre/nsX11ErrorHandler.cpp", "toolkit/xre/nsX11ErrorHandler.h", "xpcom/build/nsXULAppAPI.h"], "git_node": null, "git_parents": [null], "node": "d994823d5221c02f11f306ceef5206830874e431", "parents": ["98fde68247174541ec01c5a712af3b5d085937ee"], "tags": []}], "date": 1656555311, "git_changesets": [null, null, null, null, null, null, null, null], "user": "ryanvm@gmail.com"}, "21": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1775312 - When reporting an empty submission url to Glean, use a dummy value as it requires a non-empty string. r=mak, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149929", "files": ["toolkit/components/search/SearchService.jsm", "toolkit/components/search/tests/xpcshell/test_defaultEngine.js", "toolkit/components/search/tests/xpcshell/test_defaultPrivateEngine.js", "toolkit/components/search/tests/xpcshell/test_opensearch.js"], "git_node": null, "git_parents": [null], "node": "7087b7dbee4c8878b03e9b09f9d1ec3e616eff3f", "parents": ["d994823d5221c02f11f306ceef5206830874e431"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1775312 - Add simple tests for user and policy engines. a=test-only\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149930\n\nDepends on D149929", "files": ["toolkit/components/search/tests/xpcshell/test_policyEngine.js", "toolkit/components/search/tests/xpcshell/test_userEngine.js", "toolkit/components/search/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "263f78bccafc81f22e48e51648e1df5b0eafda3b", "parents": ["7087b7dbee4c8878b03e9b09f9d1ec3e616eff3f"], "tags": []}], "date": 1656579487, "git_changesets": [null, null], "user": "imoraru@mozilla.com"}, "22": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1772840 - Fix zoom handling in nsXULTooltipListener. r=mstange, a=dmeehan\n\nIf the tooltip node and the target node are in different documents, we'd\nuse the tooltip's CSS-to-dev-pixel scale to convert.\n\nThis is basically bug 1756323 but for XUL, I thought we wouldn't have\ncross-document zoom like that but apparently I was wrong...\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148402", "files": ["layout/xul/nsXULPopupManager.cpp", "layout/xul/nsXULPopupManager.h", "layout/xul/nsXULTooltipListener.cpp", "layout/xul/nsXULTooltipListener.h"], "git_node": null, "git_parents": [null], "node": "cd6364dc0f866100353458fca4b5e3ebaf31164a", "parents": ["263f78bccafc81f22e48e51648e1df5b0eafda3b"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1676020 - Fix client offset computation on X11. r=stransky,jhorak, a=dmeehan\n\nThe root cause of the issue is that screen coordinates in the child\nprocess are not quite right.\n\nE.g, with a window on the top left, with window manager borders of 5px\neach, the screenX on a simple test-case like:\n\n    \u003c!doctype html\u003e\n    \u003cpre id=\"log\"\u003e\u003c/pre\u003e\n    \u003cscript\u003e\n      const log = document.getElementById(\"log\");\n      document.addEventListener(\"mousemove\", function(e) {\n        log.innerText = `${e.screenX}, ${e.screenY}\\n`;\n      });\n    \u003c/script\u003e\n\nShows screenX of 0 instead of the expected frame border width which is\ncorrect for e.g., document.documentElement.screenX in the browser\ntoolbox (parent process).\n\nIt seems this is because we don't have a correctly-computed client\noffset (the client offset is zero, when instead it should be\n(border-width, titlebar-height).\n\nThe coordinate space of mBounds is weird AF, but it seems it is expected\nthat mBounds.TopLeft() are the top left of the outer window, while\nmBounds.Size() is the inner size, and mClientOffset is what compensates\nbetween the two.\n\nI've tested this on GNOME and KDE (though nowadays those use borderless\nwindows, so client offset should ~always be zero), on ctwm (which is\nwhere I could reproduce the issue), and on Sway (which has borders but\nit's Wayland. As expected we end up with a client offset of zero there).\n\nThe implementation of RecomputeClientOffset() should ensure that we work\nwith an internally-consistent coordinate space.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D148583", "files": ["widget/gtk/nsWindow.cpp", "widget/gtk/nsWindow.h"], "git_node": null, "git_parents": [null], "node": "4696c73ef2fb8b97073b2ad3bbba42eef83200b4", "parents": ["cd6364dc0f866100353458fca4b5e3ebaf31164a"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 1777521 - set firefox-esr-next-msix-latest-ssl bouncer alias on esr102. r=gbrown, a=dmeehan DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150761", "files": ["taskcluster/ci/release-bouncer-aliases/kind.yml"], "git_node": null, "git_parents": [null], "node": "41826d59fb064b2237ad0c0e0d7ea01815273338", "parents": ["4696c73ef2fb8b97073b2ad3bbba42eef83200b4"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1776164 - Fix focus outline of the selected tab with multiselected tabs. r=Gijs, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150264", "files": ["browser/themes/shared/tabs.css"], "git_node": null, "git_parents": [null], "node": "ab5c94134b4679e6f0cd76d3616b674bd101b124", "parents": ["41826d59fb064b2237ad0c0e0d7ea01815273338"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings tld-suffixes - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151239", "files": ["netwerk/dns/effective_tld_names.dat", "security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin", "services/settings/dumps/blocklists/addons-bloomfilters/addons-mlbf.bin.meta.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "20cb12f5be5aea3fb2b5fddeba431cc37d1b37d1", "parents": ["ab5c94134b4679e6f0cd76d3616b674bd101b124"], "tags": []}], "date": 1657211682, "git_changesets": [null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "23": {"changesets": [{"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 1778009 - [devtools] Stop expecting IE warnings in compatibility panel tests r=daisuke, a=test-only\n\nThe compatibility panel tests should now work both with the current browser data and with the update from D150961\nWe will still need to find a reliable way to avoid breakage when a data dump occurs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150981", "files": ["devtools/client/inspector/compatibility/test/browser/browser_compatibility_css-property_issue.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_event_document-reload.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_event_rule-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_event_selected-node-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_event_top-level-target-change.js", "devtools/client/inspector/compatibility/test/browser/browser_compatibility_settings.js"], "git_node": null, "git_parents": [null], "node": "3226ab8b82eec459f9ef11f5422e85658e1f75b8", "parents": ["20cb12f5be5aea3fb2b5fddeba431cc37d1b37d1"], "tags": []}], "date": 1657217297, "git_changesets": [null], "user": "dmeehan@mozilla.com"}, "24": {"changesets": [{"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1772018 - Tweak tooltip colors on Windows. r=dao, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149455", "files": ["toolkit/themes/windows/global/tooltip.css"], "git_node": null, "git_parents": [null], "node": "5686e25969b912059f22ea8a756c94da02ed0c3f", "parents": ["3226ab8b82eec459f9ef11f5422e85658e1f75b8"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1770636 - Fix StartupWMClass of flatpak package to match actually-used WMClass. r=jhorak, a=dmeehan\n\nPending further changes iff we want to do them (like comment 5), this is the\nright thing to do.\n\nI'm not a fan of comment 5 since in the past I've been bitten by Wayland\ncompositors not comparing stuff case-insensitively, so making everything\nlowercase is probably simpler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149911", "files": ["taskcluster/docker/firefox-flatpak/org.mozilla.firefox.desktop"], "git_node": null, "git_parents": [null], "node": "eaa10c8a04893a9472f46e4fe4eb8bd280b51b0c", "parents": ["5686e25969b912059f22ea8a756c94da02ed0c3f"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1773802 - Ignore empty strings when spellchecking; r=smaug, a=dmeehan\n\nThis adds a check to see if the encoded word is not empty and does not start\nwith the null character. Hunspell accepts C-style strings and marks the empty\nstring as correctly spelled. This prevents other dictionaries from detecting\nmisspelled strings in languages that use a different charset, which has lead\nto problems when using the en-US dictionary packaged with Firefox and Greek,\nHebrew and Russian dictionaries, where misspellings are not detected in the\nnon-English language.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149899", "files": ["editor/spellchecker/tests/mochitest.ini", "editor/spellchecker/tests/ru-RU/ru_RU.aff", "editor/spellchecker/tests/ru-RU/ru_RU.dic", "editor/spellchecker/tests/test_bug1773802.html", "extensions/spellcheck/hunspell/glue/mozHunspell.cpp"], "git_node": null, "git_parents": [null], "node": "a1cfd94c9e4d633e68377e331bed1424e68186dd", "parents": ["eaa10c8a04893a9472f46e4fe4eb8bd280b51b0c"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "default", "desc": "Bug 1773802 - Specify charset in new test; r=smaug, a=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150156", "files": ["editor/spellchecker/tests/test_bug1773802.html"], "git_node": null, "git_parents": [null], "node": "b891d76c265bcd2de63106f020e31d1854c314c3", "parents": ["a1cfd94c9e4d633e68377e331bed1424e68186dd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1777553 - Use a weak pres context reference in nsMenuItemIconX. r=mac-reviewers,spohl, a=dmeehan\n\nThis is the only thing from the regressing patch that could potentially\ncause this macOS leak, realistically. I don't think the leak is\nsuper-worrisome, likely we just shut down the browser before the image\nload finishes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151368", "files": ["widget/cocoa/nsMenuItemIconX.h", "widget/cocoa/nsMenuItemIconX.mm"], "git_node": null, "git_parents": [null], "node": "d82ae9cc9e41dd798c3276d365f3d13ee914b1ed", "parents": ["b891d76c265bcd2de63106f020e31d1854c314c3"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update, r=dmeehan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D151487", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/main/search-telemetry-v2.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "49ebbb5f70cdc5950f1edc6c42d64e9fbcfabdba", "parents": ["d82ae9cc9e41dd798c3276d365f3d13ee914b1ed"], "tags": []}], "date": 1657547727, "git_changesets": [null, null, null, null, null, null], "user": "dmeehan@mozilla.com"}, "25": {"changesets": [{"author": "Pascal Chevrel \u003cpchevrel@mozilla.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "No bug - Bump version to 102.0.1", "files": ["browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "a6cced6183d1e9e0656bc19b3b3e5bda5d5cf4ef", "parents": ["4180ec744bb748a5fd39e25d122c4b500c3a2a00"], "tags": []}, {"author": "Neil Deakin \u003cneil@mozilla.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1774683, use ValidateFilenameForSaving to validate dropped links on Windows, r=mhowell a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149746", "files": ["widget/windows/nsDataObj.cpp"], "git_node": null, "git_parents": [null], "node": "e3ecaabccc15b700df25afe65cf4bdee763f4312", "parents": ["a6cced6183d1e9e0656bc19b3b3e5bda5d5cf4ef"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1775064 - [marionette] Return chrome element references for elements within any privileged document. r=webdriver-reviewers,jdescottes a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149852", "files": ["browser/base/content/test/static/browser_all_files_referenced.js", "remote/marionette/chrome/test.xhtml", "remote/marionette/chrome/test_no_xul.xhtml", "remote/marionette/element.js", "remote/marionette/jar.mn", "remote/marionette/test/xpcshell/test_element.js", "testing/marionette/harness/marionette_harness/tests/unit/test_element_rect_chrome.py", "testing/marionette/harness/marionette_harness/tests/unit/test_findelement_chrome.py", "testing/marionette/harness/marionette_harness/tests/unit/test_title_chrome.py"], "git_node": null, "git_parents": [null], "node": "f849ad881ab028f5908ae4c0999872cd1b6fc35c", "parents": ["e3ecaabccc15b700df25afe65cf4bdee763f4312"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1776157 - Don't force chrome frames to be opaque. r=dholbert a=pascalc\n\nIt causes unnecessary flashes in some cases, like the sidebar which\nintentionally loads about:blank.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150096", "files": ["layout/base/PresShell.cpp"], "git_node": null, "git_parents": [null], "node": "f2b60ae623342aa38cdbcae686d1bdb9b4ecc459", "parents": ["f849ad881ab028f5908ae4c0999872cd1b6fc35c"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1773802 - Ignore empty strings when spellchecking; r=smaug a=pascalc\n\nThis adds a check to see if the encoded word is not empty and does not start\nwith the null character. Hunspell accepts C-style strings and marks the empty\nstring as correctly spelled. This prevents other dictionaries from detecting\nmisspelled strings in languages that use a different charset, which has lead\nto problems when using the en-US dictionary packaged with Firefox and Greek,\nHebrew and Russian dictionaries, where misspellings are not detected in the\nnon-English language.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149899", "files": ["editor/spellchecker/tests/mochitest.ini", "editor/spellchecker/tests/ru-RU/ru_RU.aff", "editor/spellchecker/tests/ru-RU/ru_RU.dic", "editor/spellchecker/tests/test_bug1773802.html", "extensions/spellcheck/hunspell/glue/mozHunspell.cpp"], "git_node": null, "git_parents": [null], "node": "a5142f82decbccb5a34bd02b355fb4c00c7d77cf", "parents": ["f2b60ae623342aa38cdbcae686d1bdb9b4ecc459"], "tags": []}, {"author": "Dan Minor \u003cdminor@mozilla.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1773802 - Specify charset in new test; r=smaug  a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150156", "files": ["editor/spellchecker/tests/test_bug1773802.html"], "git_node": null, "git_parents": [null], "node": "2973eeb3494275d85ecb081c5e74e0e6b490f98f", "parents": ["a5142f82decbccb5a34bd02b355fb4c00c7d77cf"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1776262 - [devtools] Fix stuck to bottom console output. r=jdescottes. a=pascalc\n\nWhen the last visible message was an evaluation result\nbut the last message in the store was something else,\nthe console would trigger the pin-to-bottom behavior.\nThis is fixed by checking if the last message in the\nstore (and not the last visible message) is a result.\nA test case is added to make sure we don't regress.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150225", "files": ["devtools/client/webconsole/components/Output/ConsoleOutput.js", "devtools/client/webconsole/selectors/messages.js", "devtools/client/webconsole/test/browser/browser_webconsole_scroll.js"], "git_node": null, "git_parents": [null], "node": "f9e8276b397e3e0632133c94a83bd51603044fc4", "parents": ["2973eeb3494275d85ecb081c5e74e0e6b490f98f"], "tags": []}, {"author": "Pascal Chevrel \u003cpchevrel@mozilla.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Backed out 2 changesets (bug 1681498, bug 1770881) on beta for causing bug 1777419 a=pascalc\n\nBacked out changeset b7d2e0ecff91 (bug 1770881)\nBacked out changeset 79747e10904e (bug 1681498)", "files": ["netwerk/cookie/CookieService.cpp", "netwerk/cookie/test/unit/test_migrateCookieLifetimePref.js", "netwerk/cookie/test/unit/xpcshell.ini", "toolkit/components/cleardata/tests/marionette/test_service_worker_at_shutdown.py"], "git_node": null, "git_parents": [null], "node": "afdb62b15054b1e05e1300c396a94b7547be62cb", "parents": ["f9e8276b397e3e0632133c94a83bd51603044fc4"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1777181 - Use cancelable runnables for DataPipe notifications, r=asuth a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150611", "files": ["ipc/glue/DataPipe.cpp"], "git_node": null, "git_parents": [null], "node": "8a8eb684a4a4f847e90ba0edef3b4206ed02d943", "parents": ["afdb62b15054b1e05e1300c396a94b7547be62cb"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1770636 - Fix StartupWMClass of flatpak package to match actually-used WMClass. r=jhorak a=pascalc\n\nPending further changes iff we want to do them (like comment 5), this is the\nright thing to do.\n\nI'm not a fan of comment 5 since in the past I've been bitten by Wayland\ncompositors not comparing stuff case-insensitively, so making everything\nlowercase is probably simpler.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149911", "files": ["taskcluster/docker/firefox-flatpak/org.mozilla.firefox.desktop"], "git_node": null, "git_parents": [null], "node": "ae8433beaa5d230836bc08249cd5a1b900fd806f", "parents": ["8a8eb684a4a4f847e90ba0edef3b4206ed02d943"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1772018 - Tweak tooltip colors on Windows. r=dao a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149455", "files": ["toolkit/themes/windows/global/tooltip.css"], "git_node": null, "git_parents": [null], "node": "1ab3ecdf6853fb04a4cd5b8cf65ff07d69fdaab3", "parents": ["ae8433beaa5d230836bc08249cd5a1b900fd806f"], "tags": []}, {"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "FIREFOX_ESR_102_0_X_RELBRANCH", "desc": "Bug 1774249 - Fallibly generate unique ID for new prototypes in JSObject::setProtoUnchecked r=jandem a=pascalc\n\nGenerate unique IDs for objects that are used as prototypes ahead of time, so\nwe can do it fallibly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149356", "files": ["js/src/vm/Shape.cpp"], "git_node": null, "git_parents": [null], "node": "776aca9b706c13a2597f22b739ecd0c3ab6f1d2e", "parents": ["1ab3ecdf6853fb04a4cd5b8cf65ff07d69fdaab3"], "tags": ["FIREFOX_102_0_1esr_BUILD1", "FIREFOX_102_0_1esr_RELEASE"]}], "date": 1657561468, "git_changesets": [null, null, null, null, null, null, null, null, null, null, null, null], "user": "pchevrel@mozilla.com"}, "26": {"changesets": [{"author": "Jon Coppeard \u003cjcoppeard@mozilla.com\u003e", "branch": "default", "desc": "Bug 1774249 - Fallibly generate unique ID for new prototypes in JSObject::setProtoUnchecked r=jandem a=pascalc\n\nGenerate unique IDs for objects that are used as prototypes ahead of time, so\nwe can do it fallibly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149356", "files": ["js/src/vm/Shape.cpp"], "git_node": null, "git_parents": [null], "node": "e8f7de54ead0505458c719b880448934680ac72f", "parents": ["49ebbb5f70cdc5950f1edc6c42d64e9fbcfabdba"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 1775064 - [marionette] Return chrome element references for elements within any privileged document. r=webdriver-reviewers,jdescottes a=pascalc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149852", "files": ["browser/base/content/test/static/browser_all_fi