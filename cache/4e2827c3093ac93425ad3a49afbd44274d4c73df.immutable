s:129353:"{
"lastpushid": 316,
"pushes": {"14": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 4180ec744bb748a5fd39e25d122c4b500c3a2a00 with FIREFOX_102_0esr_BUILD2 a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "32c424d281f9d4ba834d8e4669a396aee974366e", "parents": ["4180ec744bb748a5fd39e25d122c4b500c3a2a00"], "tags": []}], "date": 1655968849, "git_changesets": [null], "user": "ffxbld"}, "15": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "Update configs. IGNORE BROKEN CHANGESETS CLOSED TREE NO BUG a=release ba=release", "files": ["CLOBBER", "browser/config/version.txt", "browser/config/version_display.txt", "config/milestone.txt"], "git_node": null, "git_parents": [null], "node": "db7c3e5fdc98eb854becdcb2b2fd0adbc749f9ff", "parents": ["32c424d281f9d4ba834d8e4669a396aee974366e"], "tags": []}], "date": 1656350334, "git_changesets": [null], "user": "ffxbld-merge"}, "16": {"changesets": [{"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-esr102 repo-update HSTS HPKP remote-settings - a=repo-update r=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150367", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/security-state/intermediates.json"], "git_node": null, "git_parents": [null], "node": "a2b74d5327579461016ea81d54719a1c53e30c7a", "parents": ["db7c3e5fdc98eb854becdcb2b2fd0adbc749f9ff"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 1770075 - Unlink preserved wrapper in RTCRtpTransceiver. r=bwc, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149673", "files": ["dom/media/moz.build", "dom/media/webrtc/jsapi/RTCRtpTransceiver.cpp", "dom/media/webrtc/tests/crashtests/1770075.html", "dom/media/webrtc/tests/crashtests/crashtests.list", "testing/crashtest/crashtests.list"], "git_node": null, "git_parents": [null], "node": "1bf49a54476d4f3e3aa82537d1a852cc4e019ba5", "parents": ["a2b74d5327579461016ea81d54719a1c53e30c7a"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1775312 - When reporting an empty submission url to Glean, use a dummy value as it requires a non-empty string. r=mak, a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149929", "files": ["toolkit/components/search/SearchService.jsm", "toolkit/components/search/tests/xpcshell/test_defaultEngine.js", "toolkit/components/search/tests/xpcshell/test_defaultPrivateEngine.js", "toolkit/components/search/tests/xpcshell/test_opensearch.js"], "git_node": null, "git_parents": [null], "node": "2fdbc9b0564f3e161117a4484346bf07b047d763", "parents": ["1bf49a54476d4f3e3aa82537d1a852cc4e019ba5"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 1775312 - Add simple tests for user and policy engines. r=mak, a=RyanVM\n\nDepends on D149929\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149930", "files": ["toolkit/components/search/tests/xpcshell/test_policyEngine.js", "toolkit/components/search/tests/xpcshell/test_userEngine.js", "toolkit/components/search/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "893b8217d06047263ece9c4ee02a453b1a10c5a0", "parents": ["2fdbc9b0564f3e161117a4484346bf07b047d763"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 1776262 - [devtools] Fix stuck to bottom console output. r=jdescottes, a=RyanVM\n\nWhen the last visible message was an evaluation result\nbut the last message in the store was something else,\nthe console would trigger the pin-to-bottom behavior.\nThis is fixed by checking if the last message in the\nstore (and not the last visible message) is a result.\nA test case is added to make sure we don't regress.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D150225", "files": ["devtools/client/webconsole/components/Output/ConsoleOutput.js", "devtools/client/webconsole/selectors/messages.js", "devtools/client/webconsole/test/browser/browser_webconsole_scroll.js"], "git_node": null, "git_parents": [null], "node": "70254fba3bdcbe9a0e2a15bc6c67587d2f4d8384", "parents": ["893b8217d06047263ece9c4ee02a453b1a10c5a0"], "tags": []}], "date": 1656354642, "git_changesets": [null, null, null, null, null], "user": "ryanvm@gmail.com"}, "17": {"changesets": [{"author": "Csoregi Natalia \u003cncsoregi@mozilla.com\u003e", "branch": "default", "desc": "Backed out 2 changesets (bug 1775312) for failures on test_policyEngine.js. a=backout\n\nBacked out changeset 893b8217d060 (bug 1775312)\nBacked out changeset 2fdbc9b0564f (bug 1775312)", "files": ["toolkit/components/search/SearchService.jsm", "toolkit/components/search/tests/xpcshell/test_defaultEngine.js", "toolkit/components/search/tests/xpcshell/test_defaultPrivateEngine.js", "toolkit/components/search/tests/xpcshell/test_opensearch.js", "toolkit/components/search/tests/xpcshell/test_policyEngine.js", "toolkit/components/search/tests/xpcshell/test_userEngine.js", "toolkit/components/search/tests/xpcshell/xpcshell.ini"], "git_node": null, "git_parents": [null], "node": "0b2e663d2f2498c679dff628ede5e0b451e9ccdc", "parents": ["70254fba3bdcbe9a0e2a15bc6c67587d2f4d8384"], "tags": []}], "date": 1656359454, "git_changesets": [null], "user": "ncsoregi@mozilla.com"}, "18": {"changesets": [{"author": "Mozilla Releng Treescript \u003crelease+treescript@mozilla.org\u003e", "branch": "default", "desc": "No bug - Tagging 4180ec744bb748a5fd39e25d122c4b500c3a2a00 with FIREFOX_102_0esr_RELEASE a=release CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": null, "git_parents": [null], "node": "7804369939f6f1b560728298583c3644a44c0a25", "parents": ["0b2e663d2f2498c679dff628ede5e0b451e9ccdc"], "tags": []}], "date": 1656420965, "git_changesets": [null], "user": "ffxbld"}, "19": {"changesets": [{"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Remove instructions about libwebrtc and depot_tools. r=mjf, a=RyanVM\n\nThey don't appear necessary when generating the gn-derived moz.build\nfiles.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149203", "files": ["dom/media/webrtc/third_party_build/gn-configs/README.md", "dom/media/webrtc/third_party_build/gn-configs/generate-gn-build-files.sh"], "git_node": null, "git_parents": [null], "node": "b9c7acca406b52fceb0e8d737a0bbed265163755", "parents": ["7804369939f6f1b560728298583c3644a44c0a25"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Turn gn into local toolchains. r=firefox-build-system-reviewers,ahochheiden a=RyanVM\n\n- Because we don't have a native arm64 mac one, alias the x86_64 one.\n- Because we always compress with zstd, don't pretend the main script\n  has any power on the compression (which was wrong for Windows).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149204", "files": ["taskcluster/ci/toolchain/gn.yml", "taskcluster/scripts/misc/build-gn-common.sh", "taskcluster/scripts/misc/build-gn-linux.sh", "taskcluster/scripts/misc/build-gn-macosx.sh", "taskcluster/scripts/misc/build-gn-win64.sh"], "git_node": null, "git_parents": [null], "node": "9b949354279f5dea1474e66b414a0692a5ab2545", "parents": ["b9c7acca406b52fceb0e8d737a0bbed265163755"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Generate webrtc moz.builds for all platforms at once. r=mjf,firefox-build-system-reviewers,ahochheiden a=RyanVM\n\nThe current script requires to be run on 4 different host platforms each\nof which would handle a subset of a total of 32 mozconfigs. That is not\nsustainable, and there are already missing configs that break tier-3\nplatforms.\n\nThis replaces the current setup with one that handles all platforms in\none go, although we still keep the internal sequence of GcConfigGen -\u003e\nfixup_json -\u003e GnMozbuildWriter.\n\nThe downside is that because this relies on the upstream webrtc build\nsystem supporting cross-compilation, and that it actively rejects some\nconfigurations, we need some local hacks to make it work on Linux and\nMac, but for now, we have to leave out Windows, which requires more\nwork.\n\nFor some reason, that removes some duplicated include directories in the\njson files, which moves things a little in one moz.build file.\n\nWe also remove the mozconfigs we don't use anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149205", "files": ["dom/media/webrtc/third_party_build/gn-configs/README-openbsd.md", "dom/media/webrtc/third_party_build/gn-configs/README.md", "dom/media/webrtc/third_party_build/gn-configs/fixup_json.py", "dom/media/webrtc/third_party_build/gn-configs/generate-gn-build-files.sh", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_android.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_linux_False.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_linux_True.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_mac.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_mac.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_win.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm_android.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_android.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_linux_False.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_linux_True.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_mac.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_mac.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_openbsd.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_win.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_android.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_linux_False.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_linux_True.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_win.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_android.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_linux_False.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_linux_True.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_mac.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_mac.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_win.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm_android.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_android.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_linux_False.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_linux_True.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_mac.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_mac.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_openbsd.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_win.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_android.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_linux_False.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_linux_True.mozconfig", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_win.mozconfig", "python/mozbuild/mozbuild/gn_processor.py", "third_party/libwebrtc/build/config/BUILDCONFIG.gn", "third_party/libwebrtc/build/config/mac/mac_sdk.gni", "third_party/libwebrtc/build/config/win/visual_studio_version.gni", "third_party/libwebrtc/build/toolchain/mac/BUILD.gn", "third_party/libwebrtc/build/win/BUILD.gn", "third_party/libwebrtc/build_overrides/build.gni", "third_party/libwebrtc/modules/desktop_capture/desktop_capture_generic_gn/moz.build"], "git_node": null, "git_parents": [null], "node": "c488b0a0f467184bf67ded8b5aae23eb365ac947", "parents": ["9b949354279f5dea1474e66b414a0692a5ab2545"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Remove variable expansion in the GN processor. r=firefox-build-system-reviewers,andi a=RyanVM\n\nThis was cargo culted from the gyp processor, but is not used.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149206", "files": ["python/mozbuild/mozbuild/gn_processor.py"], "git_node": null, "git_parents": [null], "node": "d39ffca4512b02c38e732e5e3c1a807db1b0ac95", "parents": ["c488b0a0f467184bf67ded8b5aae23eb365ac947"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Use the GN binary path passed into generate_gn_config. r=firefox-build-system-reviewers,andi a=RyanVM\n\nThe path is given to the function, there is no need to get it from\nconfig.substs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149207", "files": ["python/mozbuild/mozbuild/gn_processor.py"], "git_node": null, "git_parents": [null], "node": "90e23ee132cb08194cace680be3ca413486510f5", "parents": ["d39ffca4512b02c38e732e5e3c1a807db1b0ac95"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Remove unused parameters. r=firefox-build-system-reviewers,andi a=RyanVM\n\nAlso replace uses of config objects, which are only used for topsrcdir.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149208", "files": ["python/mozbuild/mozbuild/gn_processor.py"], "git_node": null, "git_parents": [null], "node": "881f5b0016376a38f48e3eaed54a1770c5a9e037", "parents": ["90e23ee132cb08194cace680be3ca413486510f5"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Move some json fixups into the GN processor. r=firefox-build-system-reviewers,andi a=RyanVM\n\nAs we're shortly going to stop producing the intermediate json files,\nwe want the fixups to happen in the GN processor.\n\nIdeally, we'd move them all, but cleaning up -isysroot is more involved,\nwhile we won't need it once we don't use intermediate json files, so we\nleave the -isysroot cleanup in fixup_json.py for now.\n\nWhile here, `gn_out[\"targets\"][target_fullname]` doesn't need to be set\non every iteration of the loop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149209", "files": ["dom/media/webrtc/third_party_build/gn-configs/fixup_json.py", "python/mozbuild/mozbuild/gn_processor.py"], "git_node": null, "git_parents": [null], "node": "b36429704d1d85b4fba8b314b517953d009e22e5", "parents": ["881f5b0016376a38f48e3eaed54a1770c5a9e037"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Make the GN processor an independent script. r=firefox-build-system-reviewers,mjf,ahochheiden a=RyanVM\n\nThe way the processor works currently is that it relies on two different\nbuild backends, one of which produces json files for specific\nconfigurations, and the other which produces moz.build files from the\naggregate of all those configs.\n\nEach of these json files is huge, and we actually don't have enough to\nsupport all the platforms we're supposed to be supporting. Adding more\nfiles is not enticing.\n\nNow that we've made the first step described above work in a single pass\non a single machine (as opposed to multiple passes on multiple machines\npreviously), we can actually merge both steps and avoid producing the\nintermediate json files altogether. This will allow to add more\nconfigurations without having to worry about the weight of those files.\n\nAnd because this all doesn't need to depend on having the first step\nhooked up in the build system, we make the whole an independent script\nrather than a build backend.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149210", "files": ["build/docs/gn.rst", "build/gn.mozbuild", "dom/media/webrtc/moz.build", "dom/media/webrtc/third_party_build/gn-configs/README.md", "dom/media/webrtc/third_party_build/gn-configs/fixup_json.py", "dom/media/webrtc/third_party_build/gn-configs/generate-gn-build-files.sh", "dom/media/webrtc/third_party_build/gn-configs/webrtc.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_android.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_mac.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm64_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_arm_android.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_android.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_mac.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_openbsd.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x64_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_android.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_False_x86_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_android.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_mac.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm64_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_arm_android.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_android.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_mac.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_openbsd.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x64_win.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_android.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_linux_False.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_linux_True.json", "dom/media/webrtc/third_party_build/gn-configs/x64_True_x86_win.json", "dom/media/webrtc/third_party_build/moz.build", "python/mozbuild/mozbuild/backend/__init__.py", "python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/frontend/context.py", "python/mozbuild/mozbuild/frontend/data.py", "python/mozbuild/mozbuild/frontend/emitter.py", "python/mozbuild/mozbuild/gn_processor.py"], "git_node": null, "git_parents": [null], "node": "165116521e5e9a4aa054791cbce0dac91ecc0bed", "parents": ["b36429704d1d85b4fba8b314b517953d009e22e5"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Make the definition of MOZ_X11 independent of the OS. r=firefox-build-system-reviewers,ahochheiden a=RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149474", "files": ["python/mozbuild/mozbuild/gn_processor.py"], "git_node": null, "git_parents": [null], "node": "f55a1ba87145b94872da02b845e95e81412e2000", "parents": ["165116521e5e9a4aa054791cbce0dac91ecc0bed"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 1773223 - Filter-out _FORTIF