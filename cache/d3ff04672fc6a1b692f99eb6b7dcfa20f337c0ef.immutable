", "xpcom/base/RLBoxUtils.h", "xpcom/base/StaticLocalPtr.h", "xpcom/base/nsCOMPtr.h", "xpcom/base/nsCycleCollectionNoteChild.h", "xpcom/base/nsISupportsImpl.h", "xpcom/base/nsISupportsUtils.h", "xpcom/base/nsIWeakReferenceUtils.h", "xpcom/build/LateWriteChecks.cpp", "xpcom/build/LateWriteChecks.h", "xpcom/components/nsCategoryManagerUtils.h", "xpcom/components/nsComponentManagerUtils.h", "xpcom/ds/ArrayIterator.h", "xpcom/ds/CycleCollectedUniquePtr.h", "xpcom/ds/PerfectHash.h", "xpcom/ds/nsAtomTable.cpp", "xpcom/ds/nsTHashtable.h", "xpcom/io/nsLocalFileUnix.h", "xpcom/io/nsPipe.h", "xpcom/ioutils/PathUtils.cpp", "xpcom/string/RustRegex.h", "xpcom/string/nsCharTraits.h", "xpcom/string/nsString.h", "xpcom/string/nsTDependentSubstring.h", "xpcom/string/nsTStringHasher.h", "xpcom/string/nsTSubstring.cpp", "xpcom/string/nsTSubstring.h", "xpcom/tests/gtest/TestAvailableMemoryWatcherMac.cpp", "xpcom/tests/gtest/TestAvailableMemoryWatcherWin.cpp", "xpcom/threads/CondVar.h", "xpcom/threads/DataMutex.h", "xpcom/threads/DeadlockDetector.h", "xpcom/threads/Monitor.h", "xpcom/threads/Mutex.h", "xpcom/threads/Queue.h", "xpcom/threads/RWLock.h", "xpcom/threads/RecursiveMutex.h", "xpcom/threads/ReentrantMonitor.h", "xpcom/threads/SpinEventLoopUntil.h", "xpcom/threads/StateMirroring.h", "xpcom/threads/StateWatching.h", "xpcom/threads/ThreadBound.h"], "git_node": "2dc62c3e3dd710e9e02bd5bd57b0ac3144202b61", "git_parents": ["ad4acdb26ec360f408bb76501fbba28399e59cae"], "node": "fa96d36503735416a5ec3c93ecad9f69c55ce8dd", "parents": ["15ba3897757e0227c44c49394110f9d993e20ab3"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 1902507 - Disable riverside interventions by default, r=twisniewski,webcompat-reviewers\n\nIf you try to participate in a recording in Firefox all your data is lost,\nbut you don't realise until the recording ends. As a result we shouldn't\nenable the intervention by default until the data loss is fixed.\n\n