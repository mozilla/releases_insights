mozilla.com\u003e", "branch": "default", "desc": "Bug 2075317 - Stop exposing expired cookies via nsICookieManager - part 3 - fix intermittent failures, r=valentin,necko-reviewers,manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328919\n", "files": ["netwerk/test/unit/test_schema_14_migration.js", "netwerk/test/unit/test_schema_15_migration.js", "netwerk/test/unit/test_schema_2_migration.js"], "git_node": "9b9a95e0b0aa6770e2819afa34222bc6c7eedb26", "git_parents": ["b332dfdc1fea87624863f299acf678ab58640206"], "node": "982717005d2628c953875f78abb5af43bb3b92f7", "parents": ["caf232e7185f048402483a35862fcb04bf707a50"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076343 - Update the vendored `fast-uri` to 3.1.8 r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329727\n", "files": ["third_party/node/node_modules/fast-uri/index.js", "third_party/node/node_modules/fast-uri/lib/utils.js", "third_party/node/node_modules/fast-uri/package.json", "third_party/node/pnpm-lock.yaml", "third_party/node/pnpm-workspace.yaml", "third_party/node/vendor-inputs.hash"], "git_node": "2093d77122dee55af6dce60c537d829a1ea54da8", "git_parents": ["9b9a95e0b0aa6770e2819afa34222bc6c7eedb26"], "node": "79df0c4efbc80f45c8904635995fd646cf95ca67", "parents": ["982717005d2628c953875f78abb5af43bb3b92f7"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2076276: Make bootstrap check dpkg-query output (not just exit code) when probing for missing packages. r=ahochheiden\n\nWithout this fix, bootstrap won't recognize that it needs to install\n'make' on Ubuntu 26.04 systems -- that's because 'make' is a virtual\npackage, and our `dpkg-query -W` command returns a successful-looking\n'0' exit code for virtual packages, regardless of whether they're\nactually installed.\n\nThis patch adds an \"-f\" command-line param to provide a format-string,\njust displaying the package status, and we now ensure that this string\nmatches \"installed\" (along with checking the exit value) before we\nconsider the package to be already installed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329658\n", "files": ["python/mozboot/mozboot/debian.py"], "git_node": "5866118ab2d85015038b521cd2c54547f4a5243c", "git_parents": ["2093d77122dee55af6dce60c537d829a1ea54da8"], "node": "7d8c5325c6750ff7235bb8e5b0e3aed200b165ea", "parents": ["79df0c4efbc80f45c8904635995fd646cf95ca67"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075317 - Stop exposing expired cookies via nsICookieManager - part 3 - fix intermittent failures, r=valentin,necko-reviewers,manuel\" for causing Linting failures.\n\nThis reverts commit 9b9a95e0b0aa6770e2819afa34222bc6c7eedb26.\n\nRevert \"Bug 2075317 - Stop exposing expired cookies via nsICookieManager - part 2 - removing countCookiesFromHost, r=settings-reviewers,cookie-reviewers,Gijs,manuel\"\n\nThis reverts commit b332dfdc1fea87624863f299acf678ab58640206.\n\nRevert \"Bug 2075317 - Stop exposing expired cookies via nsICookieManager - part 1 - the core, r=cookie-reviewers,manuel\"\n\nThis reverts commit f74d48ff7396cca20f2a3cc9926af096449f5386.\n", "files": ["browser/base/content/test/browser-pageinfo/browser_pageinfo_security.js", "browser/base/content/test/browser-siteIdentity/browser_identityPopup_clearSiteData.js", "browser/components/enterprisepolicies/tests/browser/browser_policy_cookie_settings.js", "browser/components/preferences/tests/siteData/browser_siteData.js", "browser/modules/test/unit/test_SiteDataManager.js", "netwerk/cookie/CookieService.cpp", "netwerk/cookie/CookieStorage.cpp", "netwerk/cookie/CookieStorage.h", "netwerk/cookie/nsICookieManager.idl", "netwerk/cookie/test/unit/test_eviction.js", "netwerk/cookie/test/unit/test_purge_expired_on_idle_daily.js", "netwerk/test/gtest/TestCookie.cpp", "netwerk/test/mochitests/file_testloadflags_chromescript.js", "netwerk/test/unit/head_cookies.js", "netwerk/test/unit/test_bug526789.js", "netwerk/test/unit/test_bug650522.js", "netwerk/test/unit/test_bug667087.js", "netwerk/test/unit/test_cookie_partitioned_attribute.js", "netwerk/test/unit/test_cookies_async_failure.js", "netwerk/test/unit/test_cookies_partition_counting.js", "netwerk/test/unit/test_cookies_privatebrowsing.js", "netwerk/test/unit/test_cookies_profile_close.js", "netwerk/test/unit/test_cookies_purge_counting.js", "netwerk/test/unit/test_cookies_purge_counting_per_host.js", "netwerk/test/unit/test_cookies_read.js", "netwerk/test/unit/test_domain_eviction.js", "netwerk/test/unit/test_invalid_cookie_fix.js", "netwerk/test/unit/test_schema_10_migration.js", "netwerk/test/unit/test_schema_12_migration.js", "netwerk/test/unit/test_schema_13_db.js", "netwerk/test/unit/test_schema_14_migration.js", "netwerk/test/unit/test_schema_15_migration.js", "netwerk/test/unit/test_schema_17_migration.js", "netwerk/test/unit/test_schema_2_migration.js", "netwerk/test/unit/test_schema_3_migration.js", "netwerk/test/unit/test_suspend_channel_on_examine.js", "netwerk/test/unit/trr_common.js", "netwerk/test/unit_ipc/test_cookie_header_stripped.js", "toolkit/components/cleardata/tests/unit/test_cookies.js", "tools/@types/generated/lib.gecko.xpcom.d.ts"], "git_node": "0fa263a6223c438150defa8cd7ab914b68182ad1", "git_parents": ["5866118ab2d85015038b521cd2c54547f4a5243c"], "node": "5c66ade106ef84ce1566a4cd95ec8080ef05fe6a", "parents": ["7d8c5325c6750ff7235bb8e5b0e3aed200b165ea"], "tags": []}, {"author": "Foofrix \u003cfoofrix@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076189: Update speedometer-experimental so it uses the new sp4 tag. r=kshampur,perftest-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329639\n", "files": ["taskcluster/kinds/fetch/benchmarks.yml", "testing/perfdocs/generated/raptor.md", "testing/raptor/raptor/tests/benchmarks/speedometer-desktop.toml"], "git_node": "c0088bf8867569950a92c8f050e5691bfdc8c6f0", "git_parents": ["0fa263a6223c438150defa8cd7ab914b68182ad1"], "node": "cc2035f265e6b2f30083e4f009ad8ab1a91ed94f", "parents": ["5c66ade106ef84ce1566a4cd95ec8080ef05fe6a"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2075769 - Use ranges more in SMIL and SVG code r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329755\n", "files": ["dom/smil/SMILAnimationFunction.cpp", "dom/smil/SMILInterval.cpp", "dom/smil/SMILTimedElement.cpp", "dom/svg/SVGLengthList.cpp", "dom/svg/SVGLengthList.h", "dom/svg/SVGMotionSMILAnimationFunction.cpp", "dom/svg/SVGMotionSMILType.cpp", "testing/web-platform/tests/svg/animations/animateMotion-calcMode-discrete-path-curves.html"], "git_node": "2f9433c921ff2e0dafa0b49b350f6b5cede10bcd", "git_parents": ["c0088bf8867569950a92c8f050e5691bfdc8c6f0"], "node": "f99c762817d948e9175cbc44a9a6b9f53d3356dd", "parents": ["cc2035f265e6b2f30083e4f009ad8ab1a91ed94f"], "tags": []}, {"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075341 - Update sync settings CTA when all engines are disabled r=fluent-reviewers,settings-reviewers,hjones,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329072\n", "files": ["browser/components/preferences/tests/sync/browser_sync_settings_ui.js", "browser/components/preferences/tests/sync/head.js", "browser/components/preferences/widgets/sync-engine-list/sync-engines-list.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "33a7181adf63d1757c09d6bbfb9fd6d9a074160d", "git_parents": ["2f9433c921ff2e0dafa0b49b350f6b5cede10bcd"], "node": "18e3979919b4ab66dfa72018dcf41cb47e4827d8", "parents": ["f99c762817d948e9175cbc44a9a6b9f53d3356dd"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2075623 - Back out SessionHistoryInfo ID checks, r=dom-core-reviewers,farre\n\nThese checks were added in bug 2056965, and this particular ID in\nSessionHistoryInfo is causing a notable number of new crashes, likely\ndue to the parent process object going away unexpectedly. Back out this\nspecific ID check to reduce the crash rate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329779\n", "files": ["docshell/shistory/SessionHistoryEntry.cpp"], "git_node": "e82ba2163b2627b4f341681173b1a00bac8b58c2", "git_parents": ["33a7181adf63d1757c09d6bbfb9fd6d9a074160d"], "node": "a5e63ec001b6cbc9400c476df1ea3a52c3c6a6e6", "parents": ["18e3979919b4ab66dfa72018dcf41cb47e4827d8"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2061871 - Add scrollbar inset for browser content area. r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,akulyk\" for causing failures at browser_parsable_css.js.\n\nThis reverts commit 312e7bd59712a5b1fdd8ad59cc1fa07d40e7cd2c.\n", "files": ["browser/base/content/test/browser-static/browser_parsable_css.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "ed52b592c2150de417b033f582ed941bb5dbcd92", "git_parents": ["e82ba2163b2627b4f341681173b1a00bac8b58c2"], "node": "8141088eb661ccb95e7f4aec0438121f1a710b2c", "parents": ["a5e63ec001b6cbc9400c476df1ea3a52c3c6a6e6"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076146 - Avoid ref'ing canvas when calling OnWindowDestroy. r=gfx-reviewers,gw,ahale\n\nWhen calling CanvasShutdownManager::RefActiveCanvas to find appropriate canvases for\nOnWindowDestroy, this has the unintentional side-effect of increasing work for the cycle\ncollector in Speedometer. Instead, call OnWindowDestroy from an alternate site suggested\nby foofrix that works with the existing document's canvas reference when the document\nis being destroyed (instead of the inner window that contains it).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329703\n", "files": ["dom/base/nsGlobalWindowInner.cpp", "dom/html/HTMLCanvasElement.cpp", "dom/html/HTMLCanvasElement.h", "gfx/ipc/CanvasShutdownManager.cpp", "gfx/ipc/CanvasShutdownManager.h"], "git_node": "4aa629882d32094f8e13a109ebebf0b3ee5c1de5", "git_parents": ["ed52b592c2150de417b033f582ed941bb5dbcd92"], "node": "7ae3e4f2ed417f0f6b6fd218d54b5a81fe037e40", "parents": ["8141088eb661ccb95e7f4aec0438121f1a710b2c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\naf -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nan -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nar -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nast -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\naz -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nbe -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nbg -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nbn -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nbo -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nbqi -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nbr -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nbrx -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nbs -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nca -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nca-valencia -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\ncak -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nckb -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\ncs -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\ncy -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nda -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nde -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\ndsb -\u003e 509d8