arParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tsconfig.json", "browser/components/urlbar/types/urlbar.ts", "browser/modules/URILoadingHelper.sys.mjs"], "git_node": "980d9b989413331673c8a92baccac0bb62eba7fc", "git_parents": ["73c000ae05492448fed968d1d0e02fc459530e33"], "node": "7b45aba97c88940e2c325d01c115e3fd5a714825", "parents": ["736c940d740a63be32b82782aaf23aef604debe6"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074657 - [devtools] Update browser_dbg-features-edit-stylesheets.js to wait for the editor content r=devtools-reviewers,nchevobbe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330754\n", "files": ["devtools/client/debugger/test/mochitest/integration/browser_dbg-features-edit-stylesheets.js"], "git_node": "7b264a60c44bf73c33489283219fddbb0b666071", "git_parents": ["980d9b989413331673c8a92baccac0bb62eba7fc"], "node": "c8f91a4e806421dea9552854dbff94b0ed675f40", "parents": ["7b45aba97c88940e2c325d01c115e3fd5a714825"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2077866 - Disable upstream's new ENABLE_APPS option when generating libaom sources. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330723\n", "files": ["media/libaom/generate_sources_mozbuild.py"], "git_node": "b151b337db6ff0ec633b5b4281f684a18a852dec", "git_parents": ["7b264a60c44bf73c33489283219fddbb0b666071"], "node": "69e7b6320d6