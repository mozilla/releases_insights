11", "parents": ["5b83387730b7b4e098546d60917bab6548289af7"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075835 - Part 2. Add a new WPT EME variant eme-signed. r=taskgraph-reviewers,media-playback-reviewers,alwu,bhearsum\n\nThis will allow us to disable PlayReady, use the Widevine plugin,\nand theoretically pass on mozilla-cental with officially signed\nbuilds. We cannot verify this until it lands in mozilla-central, so\nwe do not run the jobs by default at this time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329430\n", "files": ["taskcluster/kinds/web-platform-tests/kind.yml", "taskcluster/test_configs/variants.yml", "testing/mozbase/manifestparser/manifestparser/token.py"], "git_node": "36e1999d15fa3978e97812eabc7bc9c3582f7cc0", "git_parents": ["ffee53b33ba164ec7a31f52c791e89c8128c0546"], "node": "78d25323adfb058c7da6a7748163adeaacfb96f3", "parents": ["19f87e3231cd4a9f50142060f9742ee77adddf11"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075835 - Part 3. Add metadata annotation variables for PlayReady and signed builds. r=alwu\n\nThis will allow us to properly distinguish variants in CI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329431\n", "files": ["testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox.py"], "git_node": "23c643033ab74479100fd14e32be3af9787e3ce2", "git_parents": ["36e1999d15fa3978e97812eabc7bc9c3582f7cc0"], "node": "a53ad9f5ae699a4ea850364e6f0dff5d9fc3a864", "parents": ["78d25323adfb058c7da6a7748163adeaacfb96f3"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075835 - Part 4. Update our WPT EME annotations based on the new variants. r=media-playback-reviewers,alwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329432\n", "files": ["testing/web-platform/meta/encrypted-media/drm-check-encryption-scheme.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-check-status-for-hdcp.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-events-session-closed-event.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-events.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-expiration.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-invalid-license.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-keystatuses-multiple-sessions.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-keystatuses.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-clear-encrypted.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-encrypted-clear-sources.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-encrypted-clear.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-events.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-expired.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-multikey.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-multisession.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-playduration-keystatus.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-playduration.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-after-src.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-after-update.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-immediately.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-setMediaKeys-onencrypted.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-two-videos.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary-waitingforkey.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-playback-temporary.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-again-after-playback.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-setmediakeys-again-after-resetting-src.https.html.ini", "testing/web-platform/meta/encrypted-media/drm-mp4-waiting-for-a-key.https.html.ini", "testing/web-platform/mozilla/meta/encrypted-media/__dir__.ini"], "git_node": "57c7b66e32e7fd040d41f4c4636e5cad0b016448", "git_parents": ["23c643033ab74479100fd14e32be3af9787e3ce2"], "node": "6740472f3cb521a09c277b5729c686b31340c99f", "parents": ["a53ad9f5ae699a4ea850364e6f0dff5d9fc3a864"], "tags": []}, {"author": "hsingh-moz \u003c105445818+hsingh-moz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2073660 - Report ServiceWorker console errors from the main thread. r=edenchuang,dom-worker-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330814\n", "files": ["dom/console/ConsoleUtils.cpp", "dom/serviceworkers/ServiceWorkerManager.cpp"], "git_node": "dcb704630a1df9a272290e0152b16e27f00cd007", "git_parents": ["57c7b66e32e7fd040d41f4c4636e5cad0b016448"], "node": "c3a68ec3d3fbd7a54f4646f0654a5f51ddc05754", "parents": ["6740472f3cb521a09c277b5729c686b31340c99f"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042672 - Wait for the HTML media tab to become audible before competing for audio focus in browser_uncontrollable_audio_focus.js. r=media-playback-reviewers,padenot\n\nA tab only claims audio focus once it becomes audible, but the HTML media\nsource only waited for the element to start playing. If the other tab became\naudible first, it never took focus from the HTML media tab, which then took\nfocus itself and was never paused.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331205\n", "files": ["dom/media/mediacontrol/tests/browser/browser_uncontrollable_audio_focus.js"], "git_node": "59d9ce6956b80196a05de6af4b9f03fe12a4d090", "git_parents": ["dcb704630a1df9a272290e0152b16e27f00cd007"], "node": "d07c369856fcffc059e1402022c933d70af38249", "parents": ["c3a68ec3d3fbd7a54f4646f0654a5f51ddc05754"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078895 - Type-check newtab/lib excluding the files that still have tsc errors r=reemhamz\n\nWe have recently brought the number of errors down to a reasonable amount and can start running type checking on the passing files while fixing the remaining ones.\n\nThe tsconfig.json is also added to the task's files-changed, because .json is not matched by *.*js or *.ts and a push that only edits the tsconfig would not schedule the task.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331380\n", "files": ["browser/extensions/newtab/tsconfig.json", "taskcluster/kinds/source-test/mozlint.yml"], "git_node": "ed0fc67caa90b0acaefb8b1dd47ecf8525e3e16c", "git_parents": ["59d9ce6956b80196a05de6af4b9f03fe12a4d090"], "node": "fd28c8395230790673dae53c47990b350725f8c4", "parents": ["d07c369856fcffc059e1402022c933d70af38249"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Use isDefaultBrowserAsync() in ClientEnvironmentBase; r=mossop,chutten\n\nUse the asynchronous default-browser check when retrieving the default-browser\nstate in ClientEnvironmentBase.\n\nPropagate the asynchronous operation to UsageReporting and its test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328447\n", "files": ["toolkit/components/telemetry/app/UsageReporting.sys.mjs", "toolkit/components/telemetry/tests/unit/test_UsageReporting.js", "toolkit/components/utils/ClientEnvironment.sys.mjs"], "git_