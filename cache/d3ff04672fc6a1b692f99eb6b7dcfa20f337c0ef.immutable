author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 1995348 - remove some annotations for expected crashes and increase maximum allowed assertion count\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329234\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/items/column-minimum-contribution-baseline-shim-vertical-rl.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/items/row-minimum-contribution-baseline-shim.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/vertical_lr.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/vertical_rl.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/vertical_ruby-position.html.ini"], "git_node": "af1f1dad97654af03673011843862e8d40f6dc78", "git_parents": ["5b71425a7bc4530f6b18b394d3f9410b0be12e62"], "node": "23c57e1ef31fedd2e6f9eafacbb26a24d75ebe06", "parents": ["6e11b1d904e5f95cfe67d7bf05f2508d1fb2e57e"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073978 - Update permission tables before notifying observers of removals. r=permissions-reviewers,timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328879\n", "files": ["extensions/permissions/PermissionManager.cpp"], "git_node": "528f85b9122b8e8e2bc16d3ccabec9146df8c9bd", "git_parents": ["af1f1dad97654af03673011843862e8d40f6dc78"], "node": "c56cbfffd956e3f1acbeb2147c1ecd57ea48cd61", "parents": ["23c57e1ef31fedd2e6f9eafacbb26a24d75ebe06"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073978 - Add tests for permission removal notifications. r=permissions-reviewers,timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328880\n", "files": ["extensions/permissions/test/unit/test_permmanager_reentrant_removal.js", "extensions/permissions/test/unit/xpcshell.toml"], "git_node": "831f65e707738f88a9c7709565b5125a730b0025", "git_parents": ["528f85b9122b8e8e2bc16d3ccabec9146df8c9bd"], "node": "9b1dc8992fc8dc28edf42b78ac8a4538198e6044", "parents": ["c56cbfffd956e3f1acbeb2147c1ecd57ea48cd61"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075602: Only require graphviz when actually needed. r=spidermonkey-reviewers,mgaudet DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329200\n", "files": ["js/src/devtools/iongraph/iongraph"], "git_node": "3932e6db78ec8ee7a36e0afe25fb47c7279e3719", "git_parents": ["831f65e707738f88a9c7709565b5125a730b0025"], "node": "3fbd0db0543d41237d1d07697ffba83cf7236d02", "parents": ["9b1dc8992fc8dc28edf42b78ac8a4538198e6044"], "tags": []}, {"author": "Harveer Singh \u003chsingh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072411 - Guard DecryptingInputStream state with a mutex. r=dom-storage-reviewers,jari\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328575\n", "files": ["dom/quota/DecryptingInputStream.cpp", "dom/quota/DecryptingInputStream.h", "dom/quota/DecryptingInputStream_impl.h", "dom/quota/test/gtest/TestEncryptedStream.cpp"], "git_node": "2d33105047eb7507655ce98e73736d0de6cc589a", "git_parents": ["3932e6db78ec8ee7a36e0afe25fb47c7279e3719"], "node": "4dadc47e5654c12d6880d5a44e40bec5f4892300", "parents": ["3fbd0db0543d41237d1d07697ffba83cf7236d02"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068246: Turn off PUWYLO suggestions remotely r=echa,pdahiya\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327004\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_nimbus.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_prompts.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "bb7ed2513cb42ef4eb9327d33da4b42366aa6ec3", "git_parents": ["2d33105047eb7507655ce98e73736d0de6cc589a"], "node": "b7a3b7e54047fcbf772a458cd17c75f61e8d8fbc", "parents": ["4dadc47e5654c12d6880d5a44e40bec5f4892300"], "tags": []}, {"author": "Taimur Hasan \u003cthasan@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058754 - Report a headless load redirected off-site as a distinguishable block, not a generic timeout r=nordzilla,ai-platform-reviewers,ai-security-reviewers,Mardak,tetchart\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321988\n", "files": ["browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_get_page_content_timeout.js", "toolkit/components/pageextractor/PageExtractorParent.sys.mjs", "toolkit/components/pageextractor/tests/browser/browser_headless_extractor.js"], "git_node": "e1c98ea4906240d21b8f4ee5b9c0420cc5c7898a", "git_parents": ["bb7ed2513cb42ef4eb9327d33da4b42366aa6ec3"], "node": "e369c4a64e72b7aebbf9ae26f7d852b17f310f0b", "parents": ["b7a3b7e54047fcbf772a458cd17c75f61e8d8fbc"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075368 - Dispatch a mouseup after the synthetic mousedown when activating a PanelMultiView button with the keyboard, r=firefox-desktop-core-reviewers ,Gijs.\n\nKeyboard activation sent a trusted mousedown and click but no mouseup, leaving nsGlobalWindowInner::sMouseDown set until the next real mouseup. A window move or resize in that state suppresses drag and drop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329161\n", "files": ["browser/components/customizableui/PanelMultiView.sys.mjs", "browser/components/customizableui/test/browser_PanelMultiView_keyboard.js"], "git_node": "d54bfcf006f9dbae8ca4111b4ba475a662f8b5a6", "git_parents": ["e1c98ea4906240d21b8f4ee5b9c0420cc5c7898a"], "node": "b8a9b2342c727c0d1928263efb457dc2b046cab6", "parents": ["e369c4a64e72b7aebbf9ae26f7d852b17f310f0b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Select requests with real clicks in netmonitor tests, r=devtools-reviewers,bomsy.\n\nNetmonitor tests selected requests with EventUtils.sendMouseEvent({ type: \"mousedown\" }), which dispatches a trusted mousedown from chrome without a mouseup. That left nsGlobalWindowInner::sMouseDown set after the test, which suppresses drag and drop in later tests once a window moves or resizes.\n\nReplace these calls with real clicks (mousedown, mouseup, click). The new clickOnRequestRow helper clicks the file cell of the row, which has no mouse handler of its own. It clicks the cell rather than the file name: a long file name overflows the cell, and at some window sizes its center is over another column or a column resizer. The new clickInView helper scrolls the target to the center of the list first: rows can be scrolled out of view, and the sticky column headers cover a row scrolled only to the top edge. Clicks aimed at specific targets (the waterfall, initiator, security tab, WebSocket messages and search results) still click those targets. The initiator is clicked near its start, as it overflows into the next column once the side panel is open.\n\nIn browser_net_security-tab-deselect.js, the mousedown on the security tab did nothing, because tabs are selected on click. The click now selects the tab as the test intended.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329162\n", "files": ["devtools/client/netmonitor/src/har/test/browser_net_har_import_no-mime.js", "devtools/client/netmonitor/src/har/test/head.js", "devtools/client/netmonitor/test/browser_net_accessibility-02.js", "devtools/client/netmonitor/test/browser_net_block-before-network.js", "devtools/client/netmonitor/test/browser_net_block-draganddrop.js", "devtools/client/netmonitor/test/browser_net_block-pattern.js", "devtools/client/netmonitor/test/browser_net_block.js", "devtools/client/netmonitor/test/browser_net_cause_redirect.js", "devtools/client/netmonitor/test/browser_net_cause_source_map.js", "devtools/client/netmonitor/test/browser_net_complex-params.js", "devtools/client/netmonitor/test/browser_net_cookies_sorted.js", "devtools/client/netmonitor/test/browser_net_copy_as_curl.js", "devtools/client/netmonitor/test/browser_net_copy_as_fetch.js", "devtools/client/netmonitor/test/browser_net_copy_as_powershell.js", "devtools/client/netmonitor/test/browser_net_copy_headers.js", "devtools/client/netmonitor/test/browser_net_copy_image_as_data_uri.js", "devtools/client/netmonitor/test/browser_net_copy_params.js", "devtools/client/netmonitor/test/browser_net_copy_response.js", "devtools/client/netmonitor/test/browser_net_copy_svg_image_as_data_uri.js", "devtools/client/netmonitor/test/browser_net_copy_url.js", "devtools/client/netmonitor/test/browser_net_cyrillic-01.js", "devtools/client/netmonitor/test/browser_net_cyrillic-02.js", "devtools/client/netmonitor/test/browser_net_decode-params.js", "devtools/client/netmonitor/test/browser_net_decode-url.js", "devtools/client/netmonitor/test/browser_net_delayed-response.js", "devtools/client/netmonitor/test/browser_net_details_copy.js", "devtools/client/netmonitor/test/browser_net_earlyhints.js", "devtools/client/netmonitor/test/browser_net_header-dns.js", "devtools/client/netmonitor/test/browser_net_header-docs.js", "devtools/client/netmonitor/test/browser_net_header-longstring.js", "devtools/client/netmonitor/test/browser_net_header-ref-policy.js", "devtools/client/netmonitor/test/browser_net_header-request-priority.js", "devtools/client/netmonitor/test/browser_net_headers-link_clickable.js", "devtools/client/netmonitor/test/browser_net_headers-proxy.js", "devtools/client/netmonitor/test/browser_net_headers_filter.js", "devtools/client/netmonitor/test/browser_net_headers_sorted.js", "devtools/client/netmonitor/test/browser_net_initiator.js", "devtools/client/netmonitor/test/browser_net_jsonp.js", "devtools/client/netmonitor/test/browser_net_layout_after_toggle.js", "devtools/client/netmonitor/test/browser_net_non_ascii_headers.js", "devtools/client/netmonitor/test/browser_net_open_in_debugger.js", "devtools/client/netmonitor/test/browser_net_open_in_style_editor.js", "devtools/client/netmonitor/test/browser_net_open_request_in_tab.js", "devtools/client/netmonitor/test/browser_net_overrides.js", "devtools/client/netmonitor/test/browser_net_params_sorted.js", "devtools/client/netmonitor/test/browser_net_post-data-no-response.js", "devtools/client/netmonitor/test/browser_net_post-data-raw-payloads-with-upload-stream-headers.js", "devtools/client/netmonitor/test/browser_net_post-data-raw-payloads.js", "devtools/client/netmonitor/test/browser_net_post-data.js", "devtools/client/netmonitor/test/browser_net_raw_headers.js", "devtools/client/netmonitor/test/browser_net_raw_response.js", "devtools/client/netmonitor/test/browser_net_requests-keep-alive.js", "devtools/client/netmonitor/test/browser_net_response_CORS_blocked.js", "devtools/client/netmonitor/test/browser_net_response_node-expanded.js", "devtools/client/netmonitor/test/browser_net_script_cache.js", "devtools/client/netmonitor/test/browser_net_search-results.js", "devtools/client/netmonitor/test/browser_net_security-tab-deselect.js", "devtools/client/netmonitor/test/browser_net_security-tab-visibility.js", "devtools/client/netmonitor/test/browser_net_security-warnings.js", "devtools/client/netmonitor/test/browser_net_set-cookie-same-site.js", "devtools/client/netmonitor/test/browser_net_sse-basic.js", "devtools/client/netmonitor/test/browser_net_stacktraces-cached.js", "devtools/client/netmonitor/test/browser_net_stacktraces-no-chrome-frames.js", "devtools/client/netmonitor/test/browser_net_stacktraces-visibility.js", "devtools/client/netmonitor/test/browser_net_status-codes.js", "devtools/client/netmonitor/test/browser_net_stylesheet_cache.js", "devtools/client/netmonitor/test/browser_net_telemetry_edit_resend.js", "devtools/client/netmonitor/test/browser_net_telemetry_select_ws_frame.js", "devtools/client/netmonitor/test/browser_net_telemetry_sidepanel_changed.js", "devtools/client/netmonitor/test/browser_net_url-preview.js", "devtools/client/netmonitor/test/browser_net_use_as_fetch.js", "devtools/client/netmonitor/test/browser_net_view-source-debugger.js", "devtools/client/netmonitor/test/browser_net_waterfall-click.js", "devtools/client/netmonitor/test/filters/browser_net_filter-01.js", "devtools/client/netmonitor/test/filters/browser_net_filter-02.js", "devtools/client/netmonitor/test/filters/browser_net_filter-03.js", "devtools/client/netmonitor/test/head.js", "devtools/client/netmonitor/test/network-overrides-test-helpers.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_edit_resend_cancel.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_edit_resend_caret.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_edit_resend_with_filtering.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_edit_resend_xhr.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_clear_button.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_content-length.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_context_menu.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_send_request.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_new_request_panel_sync_url_params.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend_csp.js", "devtools/client/netmonitor/test/new-resend-request/browser_net_resend_xhr.js", "devtools/client/netmonitor/test/websockets/browser_net-ws-filter-freetext.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-basic.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-clear.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-connection-closed.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-copy-binary-message.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-early-connection.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-filter-dropdown.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-filter-regex.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-json-action-cable-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-json-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-json-stomp-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-jsonl-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-keep-future-frames.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-limit-frames.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-limit-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-messages-navigation.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-sockjs-stomp-payload.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-sse-persist-columns.js", "devtools/client/netmonitor/test/websockets/browser_net_ws-stomp-payload.js"], "git_node": "338a918c342e0b841e38339bd9166f0c774048b6", "git_parents": ["d54bfcf006f9dbae8ca4111b4ba475a662f8b5a6"], "node": "0e3243588141c5624d8d3a87f6ed375ca977543e", "parents": ["b8a9b2342c727c0d1928263efb457dc2b046cab6"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Release the right mouse button when opening context menus in the extensions test helpers, r=extension-reviewers,robwu.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329163\n", "files": ["browser/components/extensions/test/browser/head.js"], "git_node": "fb4ccecd5b309940fb42623996ba6de5b04c1c60", "git_parents": ["338a918c342e0b841e38339bd9166f0c774048b6"], "node": "f939f14f83bd3139ab7155dc920ed967fc2b66e1", "parents": ["0e3243588141c5624d8d3a87f6ed375ca977543e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Release the right mouse button when opening the context menu in browser_pdfjs_fill_login.js, r=pdfjs-reviewers,robwu.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329168\n", "files": ["toolkit/components/pdfjs/test/browser_pdfjs_fill_login.js"], "git_node": "428327005a82d12d1f592df50de2b9e61e1382f9", "git_parents": ["fb4ccecd5b309940fb42623996ba6de5b04c1c60"], "node": "dc6ab6c678faf907f5b14f70318e464bd98017db", "parents": ["f939f14f83bd3139ab7155dc920ed967fc2b66e1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Click instead of only pressing the mouse button in browser_toTopLevelWidgetRect.js, r=firefox-desktop-core-reviewers ,Gijs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329170\n", "files": ["toolkit/modules/tests/browser/browser_toTopLevelWidgetRect.js"], "git_node": "85b23baf793e8b4264cd1a39503c89c47fe1c32c", "git_parents": ["428327005a82d12d1f592df50de2b9e61e1382f9"], "node": "b7ff460f14912a31b429d86388380306124d9eb4", "parents": ["dc6ab6c678faf907f5b14f70318e464bd98017db"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Select stack frames with real clicks in browser_dbg-search-file-paused.js, r=devtools-reviewers,nchevobbe.\n\nThe test dispatched a lone mousedown on stack frames, which left the mouse button pressed after the test. Frames have been selected on click since bug 1843324, so the mousedown no longer switched files at all.\n\nClick the frames instead and wait for the selected source to change. Clicking a frame focuses it, so focus the search field again before pressing Enter to move between matches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329172\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-search-file-paused.js"], "git_node": "dca0437a1bca808188e712e1923b6f8d216338b9", "git_parents": ["85b23baf793e8b4264cd1a39503c89c47fe1c32c"], "node": "f79303184e3065d3bba97f08dbb2e0911c03c67c", "parents": ["b7ff460f14912a31b429d86388380306124d9eb4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Shift-click the swatches with full clicks in browser_rules_cycle-angle.js and browser_rules_cycle-color.js, r=devtools-reviewers,nchevobbe.\n\nThe tests synthesized only a shift+mousedown on the angle and color swatches, which left the mouse button pressed after the test. Units cycle on mousedown and the swatch click handler ignores shift-clicks, so synthesize a full click instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329173\n", "files": ["devtools/client/inspector/rules/test/browser_rules_cycle-angle.js", "devtools/client/inspector/rules/test/browser_rules_cycle-color.js"], "git_node": "6eda62dc8cce785dac74fb88b9c363f9c4ff5ea9", "git_parents": ["dca0437a1bca808188e712e1923b6f8d216338b9"], "node": "b22ee9f150bea3ab3146da96b815eca7da6022a5", "parents": ["f79303184e3065d3bba97f08dbb2e0911c03c67c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Release the mouse button outside the color picker in browser_rules_colorpicker-release-outside-frame.js, r=devtools-reviewers,nchevobbe.\n\nThe test pressed the mouse button in the color picker and never released it, which left the button pressed after the test. Release it over the rule view, outside the color picker frame, which is the scenario the test is about: the picker does not receive that mouseup, and must stop following the pointer on the next mousemove without a button pressed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329174\n", "files": ["devtools/client/inspector/rules/test/browser_rules_colorpicker-release-outside-frame.js"], "git_node": "75cdd06f37ff219332992826abe6691662a6e176", "git_parents": ["6eda62dc8cce785dac74fb88b9c363f9c4ff5ea9"], "node": "6e4c871d7c7f44f1db0a3e4c9dc72863c3570b7a", "parents": ["b22ee9f150bea3ab3146da96b815eca7da6022a5"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Click the downloads button instead of only pressing it in browser_overflow_anchor.js, r=firefox-desktop-core-reviewers ,Gijs.\n\nThe overflowed button is now clicked in the opened overflow panel, as a user would, since a closed panel can't receive a real click.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329179\n", "files": ["browser/components/downloads/test/browser/browser_overflow_anchor.js"], "git_node": "1df3405f30b806309e49a96a6fb6d4dd03e5fb00", "git_parents": ["75cdd06f37ff219332992826abe6691662a6e176"], "node": "561d767b5308c6699cfe53a99ca33ff7a32b1b8c", "parents": ["6e4c871d7c7f44f1db0a3e4c9dc72863c3570b7a"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Complete the middle click on the tab in browser_bug462289.js, r=firefox-desktop-core-reviewers ,Gijs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329181\n", "files": ["browser/base/content/test/browser-general/browser_bug462289.js"], "git_node": "fb22d65f8ba4707787a6c018c58718acb9bb5a5a", "git_parents": ["1df3405f30b806309e49a96a6fb6d4dd03e5fb00"], "node": "d8213d1580dcbe4fd52db92c2332295b11e03997", "parents": ["561d767b5308c6699cfe53a99ca33ff7a32b1b8c"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Wait for the paste popup dismissal clicks before ending each subtest of browser_document_command_paste_contextmenu_suppression_key.js, r=dom-core-reviewers,edgar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329182\n", "files": ["dom/events/test/clipboard/browser_document_command_paste_contextmenu_suppression_key.js"], "git_node": "14c617668e8d90a82c64768bd737190369a6d173", "git_parents": ["fb22d65f8ba4707787a6c018c58718acb9bb5a5a"], "node": "11c6d0330e165c0137fe849796d73fdf6b58d4bc", "parents": ["d8213d1580dcbe4fd52db92c2332295b11e03997"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073095 - remove mockk from ui tests to unlock running on nightly r=mcarare\n\nMockk only runs on debuggable builds. And we have an aspiration to run the ui tests on the nightly build. So a bit of refactoring is needed. (This is just a couple of the changes that will be required! more to follow)\n\n- `OnboardingMapperTest`: luckily, in this case, a fake is easily substituted\n- `CrashPullDelegateTest`: lazy init means we don't need mocks or fakes \ud83c\udf89\n\n[try is running here](https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=97406)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/368\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/gecko/CrashPullDelegateTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/onboarding/view/OnboardingMapperTest.kt"], "git_node": "a82944e1685ec428c7dff40432a4d42683f672b3", "git_parents": ["14c617668e8d90a82c64768bd737190369a6d173"], "node": "461c8c1e88edfece44c9cdf1ebce0fdbb6fc0089", "parents": ["11c6d0330e165c0137fe849796d73fdf6b58d4bc"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070199 - Part 1: Manage PHWInference under PUtilityProcess r=gregtatum,ipc-reviewers,ai-platform-reviewers,jld\n\nCo-authored-by: Nika Layzell \u003cnlayzell@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326758\n", "files": ["ipc/glue/PUtilityProcess.ipdl", "ipc/glue/UtilityProcessChild.cpp", "ipc/glue/UtilityProcessChild.h", "ipc/glue/test/gtest/TestUtilityProcess.cpp", "toolkit/components/ml/ipc/HWInferenceChild.cpp", "toolkit/components/ml/ipc/HWInferenceChild.h", "toolkit/components/ml/ipc/HWInferenceParent.cpp", "toolkit/components/ml/ipc/HWInferenceParent.h", "toolkit/components/ml/ipc/PHWInference.ipdl"], "git_node": "6c9623e436a0859dd55ef8bf59b66444ee0c6cac", "git_parents": ["a82944e1685ec428c7dff40432a4d42683f672b3"], "node": "41d5f0801edb1e737bae2b295acf68edf822b173", "parents": ["461c8c1e88edfece44c9cdf1ebce0fdbb6fc0089"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070199 - Part 2: Let a SandboxingKind have several processes r=gregtatum,ipc-reviewers,sandbox-reviewers,chutten,jld\n\nCo-authored-by: Nika Layzell \u003cnlayzell@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326759\n", "files": ["dom/media/ipc/MFCDMParent.cpp", "ipc/glue/UtilityMediaServiceChild.cpp", "ipc/glue/UtilityProcessManager.cpp", "ipc/glue/UtilityProcessManager.h", "ipc/glue/test/gtest/TestUtilityProcess.cpp", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "security/sandbox/common/test/SandboxTest.cpp", "toolkit/components/glean/ipc/FOGIPC.cpp"], "git_node": "63e51d87b90a8049e6c2078fc4e942d1f9204509", "git_parents": ["6c9623e436a0859dd55ef8bf59b66444ee0c6cac"], "node": "5c70e66c7d2769464d0dbb4e204413f375fbcc64", "parents": ["41d5f0801edb1e737bae2b295acf68edf822b173"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070199 - Part 3: Add HWInferenceProcess and the browser HWInference process r=nika,gregtatum,ai