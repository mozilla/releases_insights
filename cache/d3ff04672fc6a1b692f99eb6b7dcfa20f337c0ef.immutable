ffff288f7a7e001d0ee40db6", "git_parents": ["553f432dd90003e382446e7bc35e814be3ac8655"], "node": "9989ca46b3155c88ae271d012eaa74afb0820585", "parents": ["18e4185f88800a6868ecaf004c998cdd4a468456"], "tags": []}, {"author": "Jonathan Watt \u003cjwatt@jwatt.org\u003e", "branch": "default", "desc": "Bug 2066027. Take animation-range into account for scroll-driven animations on the compositor. r=layout-scroll-driven-animation-reviewers,firefox-style-system-reviewers,boris\n\nWPT used where possible, but some testing needed Mochitests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323309\n", "files": ["dom/animation/ScrollTimeline.h", "gfx/layers/AnimationHelper.cpp", "gfx/layers/AnimationInfo.cpp", "gfx/layers/ipc/LayersMessages.ipdlh", "layout/style/test/file_animations_omta_scroll.html", "layout/style/test/file_animations_omta_scroll_rtl.html", "testing/web-platform/tests/scroll-animations/css/animation-range-smooth-scroll-ref.html", "testing/web-platform/tests/scroll-animations/css/animation-range-smooth-scroll.html"], "git_node": "d47cb1f0a81efa643a5aba53ff1aa62bd1da1478", "git_parents": ["3e96f22137a8489dffff288f7a7e001d0ee40db6"], "node": "c17030f37b70b9a9b7c75c37a09fb78d09b52384", "parents": ["9989ca46b3155c88ae271d012eaa74afb0820585"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074475 - [devtools] Remove and update compatibility code r=devtools-reviewers,nchevobbe\n\n- Removed `hasReducedMotionEmulationSupport` for reduced motion emulation.\n- Updated the details relating to the `enableWindowGlobalThreadActors`\n  flag, ESR 115 EOL has been moved to March 2027, so this flag can no\n  loger be removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328571\n", "files": ["devtools/client/inspector/rules/rules.js", "devtools/server/actors/root.js"], "git_node": "3a800d3638957575c9e768acf62ffe458b50f91c", "git_parents": ["d47cb1f0a81efa643a5aba53ff1aa62bd1da1478"], "node": "26e228ad7329bd9674e42cbad727f2e4528673ef", "parents": ["c17030f37b70b9a9b7c75c37a09fb78d09b52384"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074830 - Stop reporting partitioned tracker cookie reads as allowed tracker cookies. r=emz,cookie-reviewers,valentin\n\nThis patch changes the cookie service to pass the partition reason to the\naccepted-cookie notification, and changes NotifyBlockingDecision to treat\nan allow decision carrying STATE_COOKIES_PARTITIONED_TRACKER as partitioned\naccess, so it no longer emits STATE_COOKIES_LOADED_TRACKER. The tracker\ncookie loaded event now keys on any basic tracking flag rather than the\ngeneric one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328548\n", "files": ["netwerk/cookie/CookieService.cpp", "netwerk/cookie/CookieService.h", "toolkit/components/antitracking/ContentBlockingNotifier.cpp", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_partitioned_cookies.js"], "git_node": "b641180e6138fe53c54654e600348cb5b5d52a1f", "git_parents": ["3a800d3638957575c9e768acf62ffe458b50f91c"], "node": "e838f550771d53eb0e60603e89d63fb3a903c9c9", "parents": ["26e228ad7329bd9674e42cbad727f2e4528673ef"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2064337 - Support HDR media capabilities in Android Photo Picker. r=android-reviewers,nalexander\n\nThis adds support for specifying media capabilities for transcoding when using the Android Photo Picker on Android 13 (Tiramisu) and above.\n\nSpecific changes:\n- Added a `mediaCapabilities` property to `AndroidPhotoPicker` and a helper method to configure common HDR types (HLG10, HDR10, HDR10+, and Dolby Vision).\n- Updated `FilePicker` to use `PickVisualMediaRequest.Builder` to include transcoding capabilities in the picker request.\n- Updated Fenix and Focus browser fragments to initialize `AndroidPhotoPicker` with HDR capabilities enabled on supported API levels.\n- Refactored `AndroidPhotoPicker` registration to use `ActivityResultCaller` and updated associated tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322263\n", "files": ["mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/AndroidPhotoPicker.kt", "mobile/android/android-components/components/feature/prompts/src/main/java/mozilla/components/feature/prompts/file/FilePicker.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/file/AndroidPhotoPickerTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/file/FilePickerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BaseBrowserFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt"], "git_node": "fc9140235eb67419e10c199f0c22026aedc99a1f", "git_parents": ["b641180e6138fe53c54654e600348cb5b5d52a1f"], "node": "649c17e301dcf7d59df88f0c8a4aaa0b44faf52f", "parents": ["e838f550771d53eb0e60603e89d63fb3a903c9c9"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2000841 - Clean up redundant coroutine wrappers and double-await in Android-Components. r=android-reviewers,nalexander\n\nRemove redundant async/await usage and nested coroutine wrappers in browser icons, domain autocomplete, and recent visits loading to improve code clarity and idiomatic coroutine usage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322650\n", "files": ["mobile/android/android-components/components/browser/domains/src/main/java/mozilla/components/browser/domains/autocomplete/Providers.kt", "mobile/android/android-components/components/browser/icons/src/main/java/mozilla/components/browser/icons/BrowserIcons.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/recentvisits/RecentVisitsFeature.kt"], "git_node": "b9b41ff68cf54dc3ebfd5089614e15405fb2484b", "git_parents": ["fc9140235eb67419e10c199f0c22026aedc99a1f"], "node": "13f83dc4e4133de4c33c5a05c1f8fab89a6c9b59", "parents": ["649c17e301dcf7d59df88f0c8a4aaa0b44faf52f"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2000841 - Refactor SearchMiddleware and SearchEngineSelectorRepository. r=android-reviewers,nalexander\n\nImprove SearchMiddleware initialization by:\n- Decomposing the monolithic loadSearchEngines method into smaller, testable functions.\n- Restoring full parallelism for search engine and metadata loading.\n- Fixing a migration ordering bug to ensure user choices are fetched after migration.\n- Ensuring SearchEngineSelectorRepository.load is dispatcher-safe and properly tested.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322651\n", "files": ["mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/middleware/SearchMiddleware.kt", "mobile/android/android-components/components/feature/search/src/main/java/mozilla/components/feature/search/storage/SearchEngineSelectorRepository.kt", "mobile/android/android-components/components/feature/search/src/test/java/mozilla/components/feature/search/storage/SearchEngineSelectorRepositoryTest.kt"], "git_node": "25f8a18d4c5af6f83d4bf63de1affeb9c332d9e6", "git_parents": ["b9b41ff68cf54dc3ebfd5089614e15405fb2484b"], "node": "4f3702c604b4fc222c0e41fb38dd0e6f903e5d93", "parents": ["13f83dc4e4133de4c33c5a05c1f8fab89a6c9b59"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074930 - Enable \"dom.speculation_rules.enabled\" for connection-allowlist/tentative/speculation_rules_prefetch.https.sub.window.js.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328801\n", "files": ["testing/web-platform/meta/connection-allowlist/tentative/speculation_rules_prefetch.https.sub.window.js.ini"], "git_node": "a021732de1c19845772448d8445b4dc43f1d3568", "git_parents": ["25f8a18d4c5af6f83d4bf63de1affeb9c332d9e6"], "node": "45f706f3852a60909dd483ee6e6fcddd48f76ea1", "parents": ["4f3702c604b4fc222c0e41fb38dd0e6f903e5d93"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073227 - don't emit unsupported test tasks on artifact try pushes. r=taskgraph-reviewers,bhearsum\n\nCompiled tests can't run on top of artifact builds, so filter them out\nin the test transforms instead of waiting until target task selection.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327265\n", "files": ["taskcluster/gecko_taskgraph/filter_tasks.py", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/test/test_target_tasks.py", "taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/util/verify.py"], "git_node": "3520c748e216f7def7dd038e3390347aa0dfa33f", "git_parents": ["a021732de1c19845772448d8445b4dc43f1d3568"], "node": "4fd0726b13e13cf4fbadd7f4e6090fded3277a5d", "parents": ["45f706f3852a60909dd483ee6e6fcddd48f76ea1"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073559 - Don't create browser-scoped permissions for cross-origin subframe grants. r=permissions-reviewers,timhuang\n\nFor delegated types that use the iframe's origin (in practice midi and\nmidi-sysex), PermissionUI stores the browser-scoped grant under the requesting\nsubframe's principal. Before bug 2023237 such an entry was unreachable, because\nTemporaryPermissions always looked up browser.contentPrincipal. Reads now honour\nthe caller's principal, so the entry is live: it outlives the frame, is readable\nby the same origin under a different first party in the same tab, and\ngetAllForBrowser never lists it, so no UI can revoke it.\n\nSkip the write rather than redirect it to the top-level principal, which would\ngrant the embedder a permission it never requested. The request in flight is\nstill allowed, matching the behaviour before bug 2023237.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328596\n", "files": ["browser/modules/PermissionUI.sys.mjs", "browser/modules/test/browser/browser_PermissionUI.js", "extensions/permissions/docs/browser-scoped.md"], "git_node": "9ac2b4a13117871e7f6bcf21e96f68323d02e998", "git_parents": ["3520c748e216f7def7dd038e3390347aa0dfa33f"], "node": "d26c9c58e36381a134e2adb38d5dffb883da26c2", "parents": ["4fd0726b13e13cf4fbadd7f4e6090fded3277a5d"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075120 - Fix the Markdown warnings reported by rumdl 0.1.96 r=devtools-reviewers,nchevobbe DONTBUILD\n\nThe nested blockquote in fixing-security-bugs.md is turned into a nested\nordered list, as rumdl's autofix for MD005 mangles it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328751\n", "files": ["devtools/docs/contributor/tests/backward-compat-tests.md", "docs/bug-mgmt/processes/fixing-security-bugs.md", "docs/contributing/contribution_quickref.md", "docs/contributing/reviewable-patch-series.md", "mobile/android/docs/shared/android/writing_lint_rules.md"], "git_node": "4012b92e536a35d78e963bc50cc6b19c067ef692", "git_parents": ["9ac2b4a13117871e7f6bcf21e96f68323d02e998"], "node": "3545a21d57d2dfb0fb062a93cf62abd08c899dd6", "parents": ["d26c9c58e36381a134e2adb38d5dffb883da26c2"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2070824 - Narrow the Chromium license attribution in security/sandbox and zucchini r=yjuglaret,sandbox-reviewers DONTBUILD\n\nRestrict the Chromium license to the files that carry its notice, leaving the\nMozilla-written code in both directories unattributed, and give CityHash and\nSandboxBrokerRealpath.cpp notices of their own.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327796\n", "files": ["security/sandbox/LICENSE-NOTICE-cityhash.txt", "security/sandbox/linux/broker/LICENSE-NOTICE.txt", "security/sandbox/linux/broker/moz.build", "security/sandbox/moz.build", "third_party/zucchini/moz.build"], "git_node": "e12e4a3f2682e0de7d3244f516a9b4b453677900", "git_parents": ["4012b92e536a35d78e963bc50cc6b19c067ef692"], "node": "d3d80d1d3214ccc1ab67818164c077ff45cfbd59", "parents": ["3545a21d57d2dfb0fb062a93cf62abd08c899dd6"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074845 - Fix Member variable 'CurlWrapper::mCanParseUrl' is not initialized in the constructor r=janerik\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328507\n", "files": ["toolkit/components/telemetry/pingsender/pingsender_unix_common.cpp"], "git_node": "48af034539580a2a43d7f5785778458f80b11393", "git_parents": ["e12e4a3f2682e0de7d3244f516a9b4b453677900"], "node": "0c78d06452fa50fe915b34ae7073845eb96fc048", "parents": ["d3d80d1d3214ccc1ab67818164c077ff45cfbd59"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2074608 - Intermittent MainMenuTest extension tests | AMO listing name doesn't match installed extension names r=jajohnson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328239\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/MainMenuPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "d5c9f9cf249cbee3a623be53957f9311c332f2cf", "git_parents": ["48af034539580a2a43d7f5785778458f80b11393"], "node": "4672034db73cf107f4791d069587fbccf4aec285", "parents": ["0c78d06452fa50fe915b34ae7073845eb96fc048"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069112 - Add the AITab table component r=mlucks,fluent-reviewers,bolsson,vazish\n\nAdds \u003caitab-table\u003e, the RankedTable block of an AITab page: a heading, an optional description, a header row of column labels and one row per item. The first column shows the item's name, any subtitle-role columns beneath it, and a source chip (reusing ai-website-chip) for the page the item came from. Rows are separated by dividers and long text wraps inside its column.\n\nShips with a Storybook story and browser-chrome tests for the component.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325474\n", "files": ["browser/components/aiwindow/models/aitab/component_schema.json", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.css", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.mjs", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_table.js", "browser/components/aiwindow/ui/test/browser/test_aitab_table.mjs", "browser/components/aiwindow/ui/test/browser/test_aitab_table_page.html", "browser/locales-preview/aiWindow.ftl"], "git_node": "da8ef54acf1f987ad87be74a7a2c0042594b5fc7", "git_parents": ["d5c9f9cf249cbee3a623be53957f9311c332f2cf"], "node": "8214275dc9507cb3d6bee72ab4674708e6613e93", "parents": ["4672034db73cf107f4791d069587fbccf4aec285"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061052 - Add the AITab highlights component r=mlucks\n\nAdds \u003caitab-highlights\u003e; aitab-page imports the component so the element is registered in about:smartpage; mounting it from a page config is bug 2070256.\n\nShips with a Storybook story and browser-chrome tests alongside the other block components.\n\nhttps://www.figma.com/design/sIgXsbSFZjKIcfErMoBgLr/Smart-Window-Q3?node-id=16343-22767&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326308\n", "files": ["browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.css", "browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.mjs", "browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js"], "git_node": "99a6239c05fcde3151399232afee9b4b0c929e7f", "git_parents": ["da8ef54acf1f987ad87be74a7a2c0042594b5fc7"], "node": "d13ae65e4addfc43277ab4ada9458841681e3d43", "parents": ["8214275dc9507cb3d6bee72ab4674708e6613e93"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2075135 - Complete the CSSTransformValue implementation; r=emilio,firefox-style-system-reviewers\n\nImplement the CSSTransformValue indexed setter, is2D attribute, and toMatrix()\nmethod.\n\nThis uses the existing CSSTransformComponent infrastructure to determine\nwhether individual components are 2D and to combine their matrices as defined\nby CSS Typed OM.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328787\n", "files": ["dom/base/DOMMatrix.cpp", "dom/base/DOMMatrix.h", "layout/style/typedom/CSSTransformValue.cpp", "layout/style/typedom/CSSTransformValue.h", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformValue-toMatrix.html.ini", "testing/web-platform/meta/css/css-typed-om/stylevalue-subclasses/cssTransformValue.tentative.html.ini"], "git_node": "68fd3a4c02b8a84874ab13779018c6acb4dc2772", "git_parents": ["99a6239c05fcde3151399232afee9b4b0c929e7f"], "node": "b2e9d79b276f0a9837be347afc914616a84d99d2", "parents": ["d13ae65e4addfc43277ab4ada9458841681e3d43"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074670 - Checkbox for CVV - part 1 - about:preferences, r=mtigley,fluent-reviewers,settings-reviewers,credential-management-reviewers,mconley,flod,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328335\n", "files": ["browser/components/preferences/config/passwords-autofill.mjs", "browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_cvvPreference.js", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "19fa6ac6dc676208f5ef47e30f78fb134d53b80f", "git_parents": ["68fd3a4c02b8a84874ab13779018c6acb4dc2772"], "node": "140c5470819b52bf3e8bc0ab95f9660ffceb6dc8", "parents": ["b2e9d79b276f0a9837be347afc914616a84d99d2"], "tags": []}, {"author": "Andrea Marchesini \u003camarchesini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074670 - Checkbox for CVV - part 2 - door hanger, r=fluent-reviewers,credential-management-reviewers,flod,dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328336\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser.toml", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_doorhanger_cvv.js", "toolkit/components/formautofill/default/FormAutofillPrompter.sys.mjs", "toolkit/locales/en-US/toolkit/formautofill/formAutofill.ftl"], "g