", "devtools/server/tests/chrome/test_Debugger.Source.prototype.introductionType.html", "devtools/server/tests/chrome/test_executeInGlobal-outerized_this.html", "devtools/server/tests/chrome/test_makeGlobalObjectReference.html", "devtools/server/tests/chrome/test_unsafeDereference.html", "devtools/server/tests/xpcshell/head_dbg.js", "devtools/server/tests/xpcshell/test_getyoungestframe.js", "devtools/server/tests/xpcshell/test_nativewrappers.js", "devtools/server/tests/xpcshell/test_safe-getter.js", "devtools/server/tracer/tracer.sys.mjs", "devtools/shared/heapsnapshot/tests/xpcshell/head_heapsnapshot.js", "devtools/shared/heapsnapshot/tests/xpcshell/test_ReadHeapSnapshot.js", "devtools/shared/heapsnapshot/tests/xpcshell/test_ReadHeapSnapshot_with_allocations.js", "devtools/shared/heapsnapshot/tests/xpcshell/test_SaveHeapSnapshot.js", "devtools/shared/loader/builtin-modules.js", "devtools/shared/loader/worker-loader.sys.mjs", "devtools/shared/test-helpers/allocation-tracker.js", "devtools/shared/test-helpers/dump-scope.sys.mjs", "devtools/shared/webconsole/test/xpcshell/test_js_property_provider.js", "dom/base/test/chrome/test_bug1346936.html", "dom/base/test/chrome/test_bug765993.html", "dom/base/test/jsmodules/iframe_extractIntroType.html", "dom/streams/test/xpcshell/head.js", "js/src/doc/Debugger/Tutorial-Alloc-Log-Tree.md", "js/src/doc/Debugger/Tutorial-Breakpoint.md", "js/src/doc/Debugger/Tutorial-Debugger-Statement.md", "js/xpconnect/tests/chrome/test_evalInSandbox.xhtml", "js/xpconnect/tests/chrome/test_onGarbageCollection.html", "js/xpconnect/tests/unit/head_ongc.js", "js/xpconnect/tests/unit/test_import_devtools_loader.js", "js/xpconnect/tests/unit/test_json_parse_with_source.js", "js/xpconnect/tests/unit/test_xray_SavedFrame-02.js", "js/xpconnect/tests/unit/test_xray_SavedFrame.js", "remote/shared/Realm.sys.mjs", "remote/webdriver-bidi/modules/windowglobal/moz/debugging.sys.mjs", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "07392719db3f42d4d96844137cd75444393aec38", "git_parents": ["04b76de64f54356fde5b327f6a3e84f52c3ac24f"], "node": "cd3d3d404a6fa2b18692c19b92897c1767e76258", "parents": ["6eddd8a0535d3da7cc22d9369c806cfd39870d09"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078561 - Make ml.llama.hwInference pref ride the train r=ai-platform-reviewers,nordzilla\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331124\n", "files": ["modules/libpref/init/all.js", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/perftest.toml"], "git_node": "2be77664290b8a09b4a109811fd6c21aefb06917", "git_parents": ["07392719db3f42d4d96844137cd75444393aec38"], "node": "865e7853cbd5f3b7493b52107a44865574bb7945", "parents": ["cd3d3d404a6fa2b18692c19b92897c1767e76258"], "tags": []}, {"author": "Olivia Hall \u003cohall@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064727 - Updating Sharing a PDF to use PDF Viewer response r=android-reviewers,tthibaud\n\n* The current architecture does a network request to get the PDF bytes on a displayed PDF on a remote resource or a media request to get the PDF bytes on a local resource.\n* The new PDF viewer toolbar update makes adding annotations to the PDF a possibility.\n* The old methods do not grab the new bytes, so we should ask the PDF directly for the information.\n\nThis patch:\n* Adds `requestPdfToShare` to get the bytes as a resource from the PDF.\n* Adds a new `DirectResource` as a `ShareResourceState` to accomodate situations where we already have the bytes.\n* Adjusts `PdfShareActionExt` to create a `DirectResource` and use the prior method as a fallback, in case it were ever to fail.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327905\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/src/main/java/mozilla/components/browser/engine/gecko/GeckoEngineSession.kt", "mobile/android/android-components/components/browser/state/src/main/java/mozilla/components/browser/state/state/content/ShareResourceState.kt", "mobile/android/android-components/components/concept/engine/src/main/java/mozilla/components/concept/engine/EngineSession.kt", "mobile/android/android-components/components/feature/downloads/src/main/java/mozilla/components/feature/downloads/temporary/ShareResourceFeature.kt", "mobile/android/android-components/components/feature/downloads/src/main/java/mozilla/components/feature/downloads/temporary/TemporaryDownloadFeature.kt", "mobile/android/android-components/components/feature/downloads/src/test/java/mozilla/components/feature/downloads/temporary/ShareResourceFeatureTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/PdfShareActionExt.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/usecases/ShareUseCases.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/PdfToolsIntegration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/share/PdfShareActionExtTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/BrowserToolbarMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/PdfToolsIntegrationTest.kt"], "git_node": "2c386bafed22da25523d5346121f38d47b2af515", "git_parents": ["2be77664290b8a09b4a109811fd6c21aefb06917"], "node": "64ddd2684afc2fcad7ee30193082470ac2e42319", "parents": ["865e7853cbd5f3b7493b52107a44865574bb7945"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072512 - [devtools] Fix InspectorUtils.valueMatchesSyntax() when value is using random(). r=layout-reviewers,devtools-reviewers,firefox-style-system-reviewers,dshin,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328749\n", "files": ["devtools/client/inspector/rules/test/browser_rules_attr.js", "devtools/client/inspector/rules/test/browser_rules_registered-custom-properties.js", "devtools/client/shared/output-parser.js", "devtools/client/shared/test/browser_outputparser.js", "devtools/server/actors/page-style.js", "devtools/server/actors/style-rule.js", "dom/chrome-webidl/InspectorUtils.webidl", "layout/inspector/InspectorUtils.cpp", "layout/inspector/InspectorUtils.h", "layout/inspector/tests/mochitest.toml", "layout/inspector/tests/test_valueMatchesSyntax.html", "servo/ports/geckolib/glue.rs"], "git_node": "e83eb2f74fe0a7d591f98b69403d27294de45b1c", "git_parents": ["2c386bafed22da25523d5346121f38d47b2af515"], "node": "b9e8347394c0c59812ec8e749647d3b7ac23bc26", "parents": ["64ddd2684afc2fcad7ee30193082470ac2e42319"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1972935: Replace page content with page URL for summarize r=Mardak,fluent-reviewers,bolsson\" for causing bc failures @ browser_sma_summarize_page\n\nThis reverts commit b1e73253ccb0263172facc5b788fa9e5378aedb1.\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/chat.css", "browser/components/genai/chat.html", "browser/components/genai/chat.js", "browser/components/genai/metrics.yaml", "browser/components/genai/tests/browser/browser_chat_page.js", "browser/components/genai/tests/browser/browser_chat_prompt.js", "browser/components/genai/tests/browser/browser_chat_telemetry.js", "browser/components/genai/tests/browser/browser_genai_actors.js", "browser/locales/en-US/browser/genai.ftl"], "git_node": "d78f0a8fcabfe2f3bf6f515f882e0d808e6edad8", "git_parents": ["e83eb2f74fe0a7d591f98b69403d27294de45b1c"], "node": "e1ac46499acbe3de6ad65051062d6d990172e745", "parents": ["b9e8347394c0c59812ec8e749647d3b7ac23bc26"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075282 - [devtools] remove unused TextProperty computedProperties getter. r=devtools-reviewers,bomsy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328876\n", "files": ["devtools/client/inspector/rules/models/text-property.js"], "git_node": "55f6dec779ff550389e26d698080724ed2e35aa7", "git_parents": ["d78f0a8fcabfe2f3bf6f515f882e0d808e6edad8"], "node": "14e248f0ca51f993640af1bae8d105a1cebcd528", "parents": ["e1ac46499acbe3de6ad65051062d6d990172e745"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078300 - Build each menu item provider only once r=android-reviewers,giorga\n\nBrowserMenuBuilder used its resolver to build an item's provider both when\ncombining the items into the menu and, for items expanding to others, again on\nevery menu update. With the resolver building a new provider on each call, every\nupdate created another \"More\" provider, starting another collector that ran for\nas long as the menu was shown, and used it in place of the one the menu was\nbuilt from.\n\nThe providers of a menu are now built once by MenuItemsRegistry, together with\nthe configuration they are for, so that BrowserMenuBuilder and anything else\nneeding them work with the same instances. This also prepares for letting the\nproviders handle what happens when their items are clicked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330800\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemsRegistry.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/BrowserMenuBuilderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuItemsRegistryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt"], "git_node": "e2900f23ee8c3102a00d7ea59177458c26a64c2d", "git_parents": ["55f6dec779ff550389e26d698080724ed2e35aa7"], "node": "0dc62f7b8063ade9cc39b856855eaffc126af8af", "parents": ["14e248f0ca51f993640af1bae8d105a1cebcd528"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078300 - Let each menu item provider also handle the interactions with its items r=android-reviewers,giorga\n\nMoved all the menu items interactions handling from MenuMiddleware to\neach of the menu item providers configuring the details of what menu\nitems to show and what event to be dispatched for the user interaction.\nNow they will also handle said event dispatched for user interaction.\n\nMenuMiddleware is left only keeping the menu up to date and passing\nevents to the menu item providers also knowing how to handle the events.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330801\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/ExtensionsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/addons/WebExtensionMenuAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarkMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarksScreenMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/BackMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/DesktopSiteMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/ForwardMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/RefreshMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/ShareMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/applinks/OpenInAppMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/menu/MoreMenuItemsProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/menu/MoveToNormalTabsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/browser/readermode/ReaderViewMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/collections/SaveToCollectionMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/FindInPageMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/accounts/MozillaAccountMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuHost.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemEventRouter.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/DownloadsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ShortcutMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/VpnMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/pdf/SaveAsPdfMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/print/PrintMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SettingsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/deletebrowsingdata/QuitMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/logins/PasswordsMenuItemProvider.kt", "m