fi_testing/Cargo.toml", "third_party/rust/uniffi_testing/Cargo.toml.orig", "third_party/rust/uniffi_udl/.cargo-checksum.json", "third_party/rust/uniffi_udl/.cargo_vcs_info.json", "third_party/rust/uniffi_udl/Cargo.lock", "third_party/rust/uniffi_udl/Cargo.toml", "third_party/rust/uniffi_udl/Cargo.toml.orig"], "git_node": "89c187cbb5ff464c532d5f3d26e69302e5b996a1", "git_parents": ["ad695a6ea4bdda1affbcdc02aa404108b2546e68"], "node": "85fae0dd3bd175ee8bbc591986ab91def313dfbf", "parents": ["997cfc12f1a9b3da1f7a723b62c77a91dc63ac92"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Add a temporary duplicate set of CI tasks that build app-services in tree r=nalexander,ahal,taskgraph-reviewers,releng-reviewers\n\nThis will be deleted once app-services in tree is enabled by default. The\nduplicate tasks are set to tier 3 so that a regression in app-services does\nnot cause a backout, and a daily cron job schedules them to minimize the cost\nof the duplicate set of tasks. We will monitor it for a while before committing\nto app-services in tree being the CI default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320192\n", "files": [".cron.yml", "build/sparse-profiles/taskgraph", "python/mozbuild/mozbuild/artifact_builds.py", "python/mozbuild/mozbuild/artifacts.py", "taskcluster/docs/kinds.md", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/kinds/build-apk-appservices/kind.yml", "taskcluster/kinds/build-bundle-appservices/kind.yml", "taskcluster/kinds/build-components-appservices/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/signing-apk-appservices/kind.yml", "taskcluster/kinds/source-test-appservices/kind.yml", "taskcluster/kinds/test-apk-appservices/kind.yml", "taskcluster/kinds/test-components-appservices/kind.yml", "taskcluster/kinds/toolchain/android.yml", "taskcluster/kinds/ui-test-apk-appservices/kind.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "toolkit/moz.configure"], "git_node": "8bdd84d0c4eb2e4857811b9b8007e8916b0fe1aa", "git_parents": ["89c187cbb5ff464c532d5f3d26e69302e5b996a1"], "node": "67636e16456bbd4ba3b824004047def40883759e", "parents": ["85fae0dd3bd175ee8bbc591986ab91def313dfbf"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Link the Android megazord against `mozglue` again r=firefox-build-system-reviewers,sergesanspaille\n\nThe megazord stopped linking `mozglue` in D320332 so that a Rust `free` would\nnot reach bionic allocations. The vendored `application-services` no longer\ncalls `std::fs::canonicalize` on Android, so the megazord can use `mozjemalloc`\nlike every other Gecko library and the `check_binary` guard can assert the\ndependency is present rather than absent.\n\nA second guard rejects imports of bionic functions that hand the caller memory\nfrom libc's allocator, such as `getline` and `scandir`. It cannot cover\n`realpath` or `getcwd`, which allocate only when passed a null buffer and\nwhich `application-services` and Rust std import with a caller owned buffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322556\n", "files": ["python/mozbuild/mozbuild/action/check_binary.py", "third_party/application-services/megazords/full/moz.build"], "git_node": "6046e452c7a8036521930767d7a067637e0befb2", "git_parents": ["8bdd84d0c4eb2e4857811b9b8007e8916b0fe1aa"], "node": "733c7cac0bb73c28fac57e87c423a6139dae949e", "parents": ["67636e16456bbd4ba3b824004047def40883759e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075667 - Vendor application-services `a191beab` to limit `glean-sym` metrics to Android r=nalexander\n\nThe megazord enabled the `active` feature of `glean-sym` on every target.\nThat feature loads Glean from libxul at run time and does not compile for\nWindows, so the host megazord used for unit tests failed to build.\nhttps://github.com/mozilla/application-services/pull/7622 enables it only\nfor Android.\n\nThis also includes the file changes from `./mach uniffi generate`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329346\n", "files": ["Cargo.lock", "third_party/application-services/automation/tests.py", "third_party/application-services/components/ads-client/src/mars.rs", "third_party/application-services/components/ads-client/src/mars/ad_response.rs", "third_party/application-services/components/ads-client/src/test_utils.rs", "third_party/application-services/megazords/full/Cargo.toml", "third_party/application-services/megazords/full/src/lib.rs", "third_party/application-services/moz.yaml", "toolkit/components/uniffi-bindgen-gecko-js/android/components/ads-client/android/src/main/java/mozilla/appservices/adsclient/ads_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/crashtest/android/src/main/java/mozilla/appservices/crashtest/crashtest.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/db-crypto/android/src/main/java/mozilla/appservices/db_crypto/db_crypto.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/errorsupport/android/src/main/java/mozilla/appservices/errorsupport/errorsupport.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/fxaclient/android/src/main/java/mozilla/appservices/fxaclient/fxa_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/init_rust_components/android/src/main/java/mozilla/appservices/init_rust_components/init_rust_comp