/cues-with-video/processing-model/selectors/cue_function/background_box.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/bold_object/bold_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/cue_func_selector_single_colon.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/italic_object/italic_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/not_allowed_properties.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/type_selector_root.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/underline_object/underline_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/default_styles/bold_object_default_font-style.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/default_styles/underline_object_default_font-style.html.ini"], "git_node": "b2d4415770b38c1d6103413a596de79ea9931cce", "git_parents": ["b60cd63b7f03ffd215eb2c130e9035307614b7df"], "node": "f3831f8f5f18da7f43ab91cf3b06fa127bed481b", "parents": ["342039a3712b86a7779187a7563ed0642c2f7ae6"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074847 - Fix Condition '!screenshot' is always true in testing/tools/screenshot/gdk-screenshot.cpp r=stransky\n\nAs found by cpp-check.\n\nJust simplify the logic so that it's straight forward to the reader, and\nanecdotally for static analyzers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328508\n", "files": ["testing/tools/screenshot/gdk-screenshot.cpp"], "git_node": "f83ace632f15d1744296af6974252e0616b47432", "git_parents": ["b2d4415770b38c1d6103413a596de79ea9931cce"], "node": "af5bb72200cb6faed6e57e7dc11426488eaab3cb", "parents": ["f3831f8f5f18da7f43ab91cf3b06fa127bed481b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075556 - Paint the bookmark panel's unfocused selection on macOS with the list item hover tokens. r=desktop-theme-reviewers,hjones\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329286\n", "files": ["browser/themes/osx/browser.css"], "git_node": "9686c5b1198b20eec54cd54754eed8dd76addb9a", "git_parents": ["f83ace632f15d1744296af6974252e0616b47432"], "node": "ce51b0e39d720f2cea8c5b0b180823d6c66722d0", "parents": ["af5bb72200cb6faed6e57e7dc11426488eaab3cb"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074127 - Wait for pending translations before checking a popup's accesskeys. r=tgiles,Gijs,reusable-components-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329100\n", "files": ["toolkit/content/tests/chrome/test_menu_accesskey_conflicts.xhtml", "toolkit/content/tests/widgets/test_panel_list_accesskey_conflicts.html", "toolkit/content/widgets/panel-list/accesskey-check.mjs"], "git_node": "d9d1533aded5a71648700edc42c0adfebadd6a9e", "git_parents": ["9686c5b1198b20eec54cd54754eed8dd76addb9a"], "node": "1a35996e267dd8fba2d5af50c0e5f96b21c52685", "parents": ["ce51b0e39d720f2cea8c5b0b180823d6c66722d0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076263 - Support infallible typedefs in xpidl. r=xpcom-reviewers,dom-worker-reviewers,nika,asuth\n\nAnd use it for nsLoadFlags. No behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329653\n", "files": ["docshell/base/nsIDocShell.idl", "dom/workers/ScriptLoader.cpp", "layout/style/FontFaceSetDocumentImpl.cpp", "layout/style/FontFaceSetWorkerImpl.cpp", "netwerk/base/nsILoadGroup.idl", "xpcom/idl-parser/xpidl/header.py", "xpcom/idl-parser/xpidl/xpidl.py"], "git_node": "a6fb149f9a0d74dbae14cd991e2f3090193b00d7", "git_parents": ["d9d1533aded5a71648700edc42c0adfebadd6a9e"], "node": "c732e85c74a00fca61e6b40b90e9f8f832efa2cc", "parents": ["1a35996e267dd8fba2d5af50c0e5f96b21c52685"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076263 - Remove nsILoadGroupChild. r=necko-reviewers,kershaw\n\nIt's only implemented once, by nsLoadGroup, can just be merged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329654\n", "files": ["image/imgLoader.cpp", "netwerk/base/moz.build", "netwerk/base/nsILoadGroup.idl", "netwerk/base/nsILoadGroupChild.idl", "netwerk/base/nsLoadGroup.cpp", "netwerk/base/nsLoadGroup.h", "netwerk/protocol/http/HttpBaseChannel.cpp"], "git_node": "7940b82459b369516a99fde2733eff8cca22f80f", "git_parents": ["a6fb149f9a0d74dbae14cd991e2f3090193b00d7"], "node": "6693944fd7a98db3a2410c3c327f076b7a44fe74", "parents": ["c732e85c74a00fca61e6b40b90e9f8f832efa2cc"], "tags": []}, {"author": "Luk\u00e1\u0161 Lipinsk\u00fd \u003c6032558+Mr-Tao@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 500911 - Preserve focus during bulk session restore. r=sfoster,tabbrowser-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D315350\n", "files": ["browser/components/customizableui/test/browser_history_recently_closed.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/SessionStoreTestUtils.sys.mjs", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_906076_lazy_tabs.js", "browser/components/sessionstore/test/browser_closed_tabs_windows.js", "browser/components/sessionstore/test/browser_restore_preserves_focus.js", "browser/components/sessionstore/test/browser_restore_window_closed_before_show.js", "browser/components/tabbrowser/test/browser/tabs/browser_lastSeenActive.js", "browser/modules/BrowserWindowTracker.sys.mjs"], "git_node": "e454445c4fa0555ae00d35e23eccd8bbd07e11aa", "git_parents": ["7940b82459b369516a99fde2733eff8cca22f80f"], "node": "4231f70cd1a22804a06a7b0c0d0e34aebf4b60b4", "parents": ["6693944fd7a98db3a2410c3c327f076b7a44fe74"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075787 - Read moz-option's label from its attribute when Fluent sets it before the property. r=reusable-components-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329683\n", "files": ["toolkit/content/tests/widgets/test_moz_select.html", "toolkit/content/widgets/moz-select/moz-select.mjs"], "git_node": "d3a841066a4d1d115098d57b218ce2061d43e707", "git_parents": ["e454445c4fa0555ae00d35e23eccd8bbd07e11aa"], "node": "67f3e16c01ac15670a26f7dbfea90c77e97fa565", "parents": ["4231f70cd1a22804a06a7b0c0d0e34aebf4b60b4"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Read only the directories an install manifest writes into r=firefox-build-system-reviewers,sergesanspaille\n\nA manifest whose destination is the object directory had the copier walk\neverything under it to find the mtimes of the files it installs, and a first\nrun with no track walked it again to remove nothing. The directories the\nmanifest writes into hold every file it can skip, and an empty registry\nremoves nothing without the walk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327991\n", "files": ["python/mozbuild/mozbuild/action/process_install_manifest.py", "python/mozbuild/mozbuild/test/action/test_process_install_manifest.py", "python/mozbuild/mozpack/copier.py", "python/mozbuild/mozpack/test/test_copier.py"], "git_node": "15c5ae8da53eb87f69dd5a4cceb2b4e9bed0a0b7", "git_parents": ["d3a841066a4d1d115098d57b218ce2061d43e707"], "node": "ef15469e929edde2638c6473df868927f34f0a45", "parents": ["67f3e16c01ac15670a26f7dbfea90c77e97fa565"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Install built files through one install manifest per directory r=firefox-build-system-reviewers,sergesanspaille\n\nEach built file installed into `dist/bin` or `_tests` had its own rule\nand Python process, and a file removed from `moz.build` stayed installed.\nOne manifest per directory and tier now installs them in a single pass,\nskips files that are up to date, and removes files no longer listed.\nEach file is installed as a link, so it is a symlink on Linux and macOS\nwhere it used to be a copy.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327992\n", "files": ["python/mozbuild/mozbuild/action/install_objdir_file.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "522bb798ed12e52688780b8218f14e57ffcb49f7", "git_parents": ["15c5ae8da53eb87f69dd5a4cceb2b4e9bed0a0b7"], "node": "1c45ce831586e36c86af22dde4bbde630507404f", "parents": ["ef15469e929edde2638c6473df868927f34f0a45"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove `NSDISTMODE` from the build r=firefox-build-system-reviewers,nalexander\n\nNothing outside NSPR and NSS sets it, so every install already uses its default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328279\n", "files": ["config/config.mk", "config/faster/rules.mk", "js/src/build/Makefile.in", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "e12acfa2ffebf357384811aea99f4345b31b23a9", "git_parents": ["522bb798ed12e52688780b8218f14e57ffcb49f7"], "node": "f16df7b7250b81da8479fd37cbb9de342bbe1967", "parents": ["1c45ce831586e36c86af22dde4bbde630507404f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the unset `CC_WRAPPER` and `CXX_WRAPPER` from `config.mk` r=firefox-build-system-reviewers,sergesanspaille\n\nConfigure already prepends the compiler wrapper to the `CC` and `CXX` values it\nwrites, and that is where ccache and sccache arrive. Nothing in the tree assigns\neither variable. Setting one in the Make environment used to prepend a second\nwrapper and no longer does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328994\n", "files": ["config/config.mk"], "git_node": "e53098deaf4eade459445c48edfa4a84059b3209", "git_parents": ["e12acfa2ffebf357384811aea99f4345b31b23a9"], "node": "4b02460b8b8750469f3ec74a361b580bc119b394", "parents": ["f16df7b7250b81da8479fd37cbb9de342bbe1967"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the unused variables from `browser/app/Makefile.in` and the unused `ipc/app/Makefile.in` r=firefox-build-system-reviewers,sergesanspaille\n\nNothing in `browser/app` reads `dist_dest`, `AB_CD`, `PROGRAMS_DEST` or\n`objdir`, and the `ipc/app` file only held a conditional with an empty body.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329467\n", "files": ["browser/app/Makefile.in", "ipc/app/Makefile.in"], "git_node": "6a6d86582625509d389d2034b96d4838ccfc047c", "git_parents": ["e53098deaf4eade459445c48edfa4a84059b3209"], "node": "e91cdba5f803f03a08f473253c471708c284948a", "parents": ["4b02460b8b8750469f3ec74a361b580bc119b394"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the unused `RS_STATICLIB_CRATE_SRC` rules from `rules.mk` and `recursivemake.py` r=firefox-build-system-reviewers,sergesanspaille\n\n`_handle_linked_rust_crates` was the only writer of `RS_STATICLIB_CRATE_SRC` and\nnothing calls it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329468\n", "files": ["config/rules.mk", "python/mozbuild/mozbuild/backend/recursivemake.py"], "git_node": "ef2fce2cf8ebc5d7a5eaa8eea9e2ff4c1a9ff9f5", "git_parents": ["6a6d86582625509d389d2034b96d4838ccfc047c"], "node": "3d86b8d86547adf8e7aea953091258df6dda03b9", "parents": ["e91cdba5f803f03a08f473253c471708c284948a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038789 - Remove the ineffective GNU `OS_CPPFLAGS` from `rules.mk` r=firefox-build-system-reviewers,sergesanspaille\n\nBug 555901 added the `PATH_MAX` and `MAXPATHLEN` defines for GNU/Hurd,\nwhich is not a tier 1 or tier 2 platform. The defines never took effect,\nbecause compile commands get `OS_CPPFLAGS` from configure, not from the\nMake variable that `rules.mk` appends to.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329469\n", "files": ["config/rules.mk"], "git_node": "3b2c8b3e95dafd2b254dcf2acaf0ca0220129805", "git_parents": ["ef2fce2cf8ebc5d7a5eaa8eea9e2ff4c1a9ff9f5"], "node": "d05a176bcba91fa65f738b9f3d44ed786aa03e8b", "parents": ["3d86b8d86547adf8e7aea953091258df6dda03b9"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 500911 - Preserve focus during bulk session restore. r=sfoster,tabbrowser-reviewers,sthompson\" for causing lint failures\n\nThis reverts commit e454445c4fa0555ae00d35e23eccd8bbd07e11aa.\n", "files": ["browser/components/customizableui/test/browser_history_recently_closed.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/SessionStoreTestUtils.sys.mjs", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_906076_lazy_tabs.js", "browser/components/sessionstore/test/browser_closed_tabs_windows.js", "browser/components/sessionstore/test/browser_restore_preserves_focus.js", "browser/components/sessionstore/test/browser_restore_window_closed_before_show.js", "browser/components/tabbrowser/test/browser/tabs/browser_lastSeenActive.js", "browser/modules/BrowserWindowTracker.sys.mjs"], "git_node": "87dc2f195316edead1ba20f7cbe149f9053fa7c0", "git_parents": ["3b2c8b3e95dafd2b254dcf2acaf0ca0220129805"], "node": "7c77762705f695de98e9f94ab383f271bbeb1e2e", "parents": ["d05a176bcba91fa65f738b9f3d44ed786aa03e8b"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2075088 - Disable video overlay whlie video position is moving on Windows r=gfx-reviewers,lsalzman\n\nWhen video overlay was scrolled DCSurfaceVideo::CallVideoProcessorBlt() was called very often. It made Render thread very busy.\nThen it seems better to disable video overlay when video position is moving.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329580\n", "files": ["dom/media/webvtt/test/reftest/reftest.list", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/frame_builder.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/scene.rs", "gfx/wr/webrender/src/shutdown_test.rs", "gfx/wr/webrender/src/tile_cache/mod.rs", "testing/web-platform/meta/html/semantics/embedded-content/media-elements/track/track-element/track-webvtt-two-cue-layout-after-first-end.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/bidi_ruby.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/u0041_first.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/u06E9_no_strong_dir.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/cue_selector_single_colon.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/text-decoration_overline.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/text-decoration_overline_underline_line-through.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/text-decoration_underline.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/white-space_normal_wrapped.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/white-space_nowrap_wrapped.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/background_box.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/bold_object/bold_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/cue_func_selector_single_colon.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/italic_object/italic_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/not_allowed_properties.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/type_selector_root.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue_function/underline_object/underline_namespace.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/default_styles/bold_object_default_font-style.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/default_styles/underline_object_default_font-style.html.ini"], "git_node": "bcba5dc8a8ebd08071608bc6c69d0f9e5174b585", "git_parents": ["87dc2f195316edead1ba20f7cbe149f9053fa7c0"], "node": "30dd9f581690f484783ef399892f5503e7642189", "parents": ["7c77762705f695de98e9f94ab383f271bbeb1e2e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076023 - Update vendored Hunspell to v1.7.4. r=masayuki\n\nDrop bug1739761.patch (load-time arena allocator), bug2037089-hentry-pack.patch and\nbug2037089-build-fixes.patch: all three were merged upstream and ship in v1.7.4. Regenerate bug1653659.patch\nfor the new csutil.cxx offsets.\n\nv1.7.4 adds a word-decision trace facility that hunspell.cxx always references, so hunspelltrace.cxx joins the\nbuild. hunversion.h.in is a configure template and is deleted like hunvisapi.h.in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329514\n", "files": ["extensions/spellcheck/hunspell/moz.yaml", "extensions/spellcheck/hunspell/patches/bug1653659.patch", "extensions/spellcheck/hunspell/patches/bug1739761.patch", "extensions/spellcheck/hunspell/patches/bug2037089-build-fixes.patch", "extensions/spellcheck/hunspell/patches/bug2037089-hentry-pack.patch", "extensions/spellcheck/hunspell/src/affentry.cxx", "extensions/spellcheck/hunspell/src/affentry.hxx", "extensions/spellcheck/hunspell/src/affixmgr.cxx", "extensions/spellcheck/hunspell/src/affixmgr.hxx", "extensions/spellcheck/hunspell/src/atypes.hxx", "extensions/spellcheck/hunspell/src/baseaffix.hxx", "extensions/spellcheck/hunspell/src/csutil.cxx", "extensions/spellcheck/hunspell/src/csutil.hxx", "extensions/spellcheck/hunspell/src/hashmgr.cxx", "extensions/spellcheck/hunspell/src/hashmgr.hxx", "extensions/spellcheck/hunspell/src/htypes.hxx", "extensions/spellcheck/hunspell/src/hunspell.cxx", "extensions/spellcheck/hunspell/src/hunspell.h", "extensions/spellcheck/hunspell/src/hunspell.hxx", "extensions/spellcheck/hunspell/src/hunspelltrace.cxx", "extensions/spellcheck/hunspell/src/hunspelltrace.hxx", "extensions/spellcheck/hunspell/src/hunversion.h", "extensions/spellcheck/hunspell/src/replist.cxx", "extensions/spellcheck/hunspell/src/replist.hxx", "extensions/spellcheck/hunspell/src/sources.mozbuild", "extensions/spellcheck/hunspell/src/suggestmgr.cxx", "extensions/spellcheck/hunspell/src/suggestmgr.hxx"], "git_node": "73b2297d2b9d82fec722b92290a805e16c6b51e9", "git_parents": ["bcba5dc8a8ebd08071608bc6c69d0f9e5174b585"], "node": "2ab64dfbbced6420d60224511158719b5474bd5b", "parents": ["30dd9f581690f484783ef399892f5503e7642189"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2039395 - Update tests that deal with old bookmarks panel to pass with updated bookmarks panel r=sidebar-reviewers,extension-reviewers,sclements,robwu\n\nAlso hoisted some helper functions from `browser_bookmarks_sidebar.js` to a utility that is accessible from other components. This was done to make the `browser_ext_contextMenus.js` easier to rewrite. It should also help with upcoming rewrites of legacy Places tests (Bug 2073573).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327930\n", "files": ["browser/base/content/test/browser-general/browser_documentnavigation.js", "browser/components/customkeys/tests/browser/browser_CustomKeys.js", "browser/components/extensions/test/browser/browser_ext_contextMenus.js", "browser/components/sidebar/moz.build", "browser/components/sidebar/tests/BookmarksSidebarTestUtils.sys.mjs", "browser/components/sidebar/tests/SidebarTestUtils.sys.mjs", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js", "browser/components/sidebar/tests/browser/browser_history_sidebar.js", "toolkit/content/tests/browser/browser_bug1693577.js"], "git_node": "8c938d56856ad3cc9965dff55c0fc47c0d493a57", "git_parents": ["73b2297d2b9d82fec722b92290a805e16c6b51e9"], "node": "b77125872a47bd2f9af11690efa0551809a0e498", "parents": ["2ab64dfbbced6420d60224511158719b5474bd5b"], "tags": []}], "date": 1790700068, "git_changesets": ["2ca0ee69e928a4c19dd64e3f1588cd9396d64db9", "89a0ab788083d1841c80107f032e51c91dae2e07", "a1215c44a943945382f643866d2b7853d6167a04", "71a981e26219762ef69bb76f1887bc6c491cb75d", "65441403731c66090838c1415744fc60ebdeca7d", "6c48a00bf9cda4e845fb7db394f44aa07eeb6003", "9ec5bb31ea473e1e98ae516ded127b264ee3dcba", "63566204a1aa021bf9b1e7fa938b55b69f1bf114", "4ea8dc66d17c2b9c4c9c1155d9bdb51135a22922", "ed5e6f2ec99828d7d367cf5dcfd6432b5bc62808", "f7ac3210791ba25ed87a5cc2a89dc192260ce4cd", "3afa9f54e1458e1ad923c030982310a86ab67311", "b7a54ee2036634ba92ab42f7bf8d2236fc7ade29", "f0d874330af32bdd7690bc1c8320080dcbc604c4", "b60cd63b7f03ffd215eb2c130e9035307614b7df", "b2d4415770b38c1d6103413a596de79ea9931cce", "f83ace632f15d1744296af6974252e0616b47432", "9686c5b1198b20eec54cd54754eed8dd76addb9a", "d9d1533aded5a71648700edc42c0adfebadd6a9e", "a6fb149f9a0d74dbae14cd991e2f3090193b00d7", "7940b82459b369516a99fde2733eff8cca22f80f", "e454445c4fa0555ae00d35e23eccd8bbd07e11aa", "d3a841066a4d1d115098d57b218ce2061d43e707", "15c5ae8da53eb87f69dd5a4cceb2b4e9bed0a0b7", "522bb798ed12e52688780b8218f14e57ffcb49f7", "e12acfa2ffebf357384811aea99f4345b31b23a9", "e53098deaf4eade459445c48edfa4a84059b3209", "6a6d86582625509d389d2034b96d4838ccfc047c", "ef2fce2cf8ebc5d7a5eaa8eea9e2ff4c1a9ff9f5", "3b2c8b3e95dafd2b254dcf2acaf0ca0220129805", "87dc2f195316edead1ba20f7cbe149f9053fa7c0", "bcba5dc8a8ebd08071608bc6c69d0f9e5174b585", "73b2297d2b9d82fec722b92290a805e16c6b51e9", "8c938d56856ad3cc9965dff55c0fc47c0d493a57"], "user": "smolnar@mozilla.com"}, "45445": {"changesets": [{"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074160: Insert ref.cast for br_on_cast(_fail). r=rhunt,iain\n\nInserting an MWasmRefCast along the relevant branch of a\nbr_on_cast(_fail) mirrors what you generally have to do if using\nref.test and ref.cast manually, and the presence of an explicit\nref.cast ensures that nothing gets LICM'd above the test. The cast\nitself ends up being a no-op because of our tests-dominating-casts\noptimizations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329255\n", "files": ["js/src/jit-test/tests/wasm/gc/ref-gvn.js", "js/src/wasm/WasmIonCompile.cpp"], "git_node": "500407a1be99fab5b5d53080db37de09c3dcd63e", "git_parents": ["8c938d56856ad3cc9965dff55c0fc47c0d493a57"], "node": "d75e813c36c10479f966ed0a7f5f54b19fac9e69", "parents": ["b77125872a47bd2f9af11690efa0551809a0e498"], "tags": []}, {"author": "RebecaTudor \u003crebecatudor273@gmail.com\u003e", "branch": "default", "desc": "Bug 2070591 - [experiment] Avoid recomputing the privacy report notification schedule on every app resume r=android-reviewers,twhite\n\nTracks whether the worker has already been scheduled.\nThis is only an in-memory optimization to avoid repeatedly performing the scheduling\ncalculations when the host resumes. WorkManager remains the source of truth for the\nactual scheduled work.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325268\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationScheduler.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorker.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationSchedulerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorkerTest.kt"], "git_node": "ec5f022f401a14a5ef5b67a7fe7e39488315d518", "git_parents": ["500407a1be99fab5b5d53080db37de09c3dcd63e"], "node": "47262521ae9f1823a024f05375c19aa93d28e7cf", "parents": ["d75e813c36c10479f966ed0a7f5f54b19fac9e69"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075609 - Update stories button to use onWallpaper color r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329645\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/ui/HomepageHeader.kt"], "git_node": "7d0c94b68d1d9c4d59f22d54563b152c3aaf1ee3", "git_parents": ["ec5f022f401a14a5ef5b67a7fe7e39488315d518"], "node": "3582153cbfd64eef82f101f451cf4a6057898f08", "parents": ["47262521ae9f1823a024f05375c19aa93d28e7cf"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2076017 - Re-enable tests disabled on macOS 15 AArch64 that pass there on try. r=aryx,necko-reviewers,webcompat-reviewers,extension-reviewers,settings-reviewers,media-playback-reviewers,credential-management-reviewers,devtools-reviewers,places-reviewers,dom-storage-reviewers,firefox-style-system-reviewers,layout-reviewers,crashreporting-reviewers,mkennedy,emz,Mardak,aosmond,twisniewski,tnikkel,jdescottes,gsvelto,dimi,valentin,jari,dshin,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329503\n", "files": ["accessible/tests/browser/mac/browser.toml", "browser/base/content/test/browser-forms/browser.toml", "browser/base/content/test/browser-fullscreen/browser.toml", "browser/base/content/test/browser-general/browser.toml", "browser/base/content/test/browser-gesture/browser.toml", "browser/base/content/test/browser-keyboard/browser.toml", "browser/base/content/test/browser-keyboard/browserSidebarRevamp.toml", "browser/base/content/test/browser-outOfProcess/browser.toml", "browser/base/content/test/browser-performance/browser.toml", "browser/base/content/test/browser-permissions/browser.toml", "browser/base/content/test/browser-scroll-to-text-fragment/browser.toml", "browser/base/content/test/browser-webrtc/browser.toml", "browser/base/content/test/browser-webrtc/gracePeriod/browser.toml", "browser/base/content/test/browser-zoom/browser.toml", "browser/components/aboutlogins/tests/browser/browser.toml", "browser/components/asrouter/tests/browser/browser.toml", "browser/components/contextualidentity/test/browser/browser.toml", "browser/components/customizableui/test/browser.toml", "browser/components/firefoxview/tests/browser/browser.toml", "browser/components/genai/tests/browser/browser.toml", "browser/components/places/tests/browser/browser.toml", "browser/components/preferences/tests/experimental_features/browser.toml", "browser/components/profiles/tests/browser/browser-legacy.toml", "browser/components/profiles/tests/browser/browser.toml", "browser/components/profiles/tests/unit/xpcshell.toml", "browser/components/resistfingerprinting/test/browser/browser.toml", "browser/components/screenshots/tests/browser/browser.toml", "browser/components/sessionstore/test/browser.toml", "browser/components/sessionstore/test/browser_oldformat.toml", "browser/components/sidebar/tests/browser/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/unit/xpcshell.toml", "browser/extensions/formautofill/test/unit/xpcshell_rust.toml", "browser/extensions/webcompat/tests/browser/browser.toml", "browser/modules/test/browser/browser.toml", "devtools/client/framework/browser-toolbox/test/browser.toml", "devtools/client/inspector/computed/test/browser.toml", "devtools/client/inspector/rules/test/browser_part1.toml", "devtools/client/shared/components/test/chrome/chrome.toml", "devtools/client/storage/test/browser.toml", "devtools/client/styleeditor/test/browser.toml", "devtools/client/webconsole/test/browser/_browser_console.toml", "devtools/startup/tests/browser/browser.toml", "docshell/test/browser/browser.toml", "docshell/test/navigation/mochitest.toml", "dom/animation/test/mochitest.toml", "dom/base/test/browser.toml", "dom/canvas/test/mochitest.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-uniforms.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-uniforms.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-glsl3.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/credentialmanagement/identity/tests/mochitest/mochitest.toml", "dom/events/test/mochitest.toml", "dom/media/autoplay/test/browser/browser.toml", "dom/media/mediacontrol/tests/browser/browser.toml", "dom/media/test/browser/browser.toml", "dom/media/test/mochitest.toml", "dom/media/test/mochitest_background_video.toml", "dom/media/test/mochitest_bugs.toml", "dom/media/test/mochitest_compat.toml", "dom/security/test/general/browser.toml", "dom/security/test/https-first/browser.toml", "dom/webauthn/tests/browser/browser.toml", "layout/forms/test/mochitest.toml", "layout/style/test/chrome/chrome.toml", "netwerk/test/unit/xpcshell.toml", "security/manager/ssl/tests/unit/xpcshell.toml", "toolkit/components/aboutmemory/tests/chrome.toml", "toolkit/components/antitracking/test/browser/browser.toml", "toolkit/components/contentanalysis/tests/browser/browser.toml", "toolkit/components/extensions/test/xpcshell/xpcshell-common.toml", "toolkit/components/extensions/test/xpcshell/xpcshell-e10s.toml", "toolkit/components/nimbus/test/unit/xpcshell.toml", "toolkit/components/pageextractor/tests/browser/browser.toml", "toolkit/components/passwordmgr/test/browser/browser.toml", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/printing/tests/browser.toml", "toolkit/components/satchel/megalist/content/tests/browser/browser.toml", "toolkit/components/viewsource/test/browser/browser.toml", "toolkit/components/windowwatcher/test/browser.toml", "toolkit/crashreporter/test/unit/xpcshell.toml", "toolkit/modules/subprocess/test/xpcshell/xpcshell.toml", "toolkit/modules/tests/xpcshell/xpcshell.toml", "tools/profiler/tests/xpcshell/xpcshell.toml", "widget/tests/mochitest.toml"], "git_node": "fe46b2cfe466889a6a5ff33f0692f32d5e7e0eab", "git_parents": ["7d0c94b68d1d9c4d59f22d54563b152c3aaf1ee3"], "node": "c7f00cba90a1abc671fc4ab4e27e0b3f72ca1334", "parents": ["3582153cbfd64eef82f101f451cf4a6057898f08"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 1961559 - Don't recreate a still-loading Firefox View tab when the button is clicked, and make tests click it instead of only pressing the mouse, r=fxview-reviewers,sessionstore-reviewers,sfoster.\n\nThe button opens Firefox View on mousedown, and the click that follows runs FirefoxViewHandler.openTab again while the new tab is still on about:blank, which closed and recreated it. Tests worked around this by synthesizing a lone mousedown, which left nsGlobalWindowInner::sMouseDown set for the rest of the browser session: a later window resize then suppressed the drag service, breaking synthesized drags and leaking a drag session into later customizableui tests (878452, 884402, 901207).\n\nThis also removes the macOS 15.30 skip-if on browser_878452_drag_to_panel.js, whose failures there had the same cause.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329160\n", "files": ["browser/base/content/browser.js", "browser/components/customizableui/test/browser.toml", "browser/components/firefoxview/tests/browser/FirefoxViewTestUtils.sys.mjs", "browser/components/firefoxview/tests/browser/browser_firefoxview_tab.js", "browser/components/firefoxview/tests/browser/head.js", "browser/components/sessionstore/test/browser_firefoxView_restore.js"], "git_node": "14e2ed0ddd3a9934a9b5c3f5c5b76072b9526beb", "git_parents": ["fe46b2cfe466889a6a5ff33f0692f32d5e7e0eab"], "node": "aef0980d71ba97481e5ad0ec177ff9368a3c50ae", "parents": ["c7f00cba90a1abc671fc4ab4e27e0b3f72ca1334"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066339 - Leave fields carrying an unrecognized autocomplete attribute value out of autofill. r=dimi\n\nThis patch addresses the following issue:\n\nShopify based websites like to dynamically update their autocomplete field values. Their intention is usually to disable browser autocomplete dropdowns from appearing. This does not work on Firefox and the dropdown still appears and may clash with the website's own dropdown UI for thtat field.\n\n**Solution**:\n\nPer review, a field whose autocomplete value is present but cannot be parsed into a known field name (e.g. `none`, `shopify checkout`) is left unclassified at detection. `inferFieldInfo` returns an empty field name and `FieldDetail` records `reason = \"autocomplete\"`, so the site having had something to say about the field is still visible to telemetry and about:autofill. `classifySections` leaves unnamed fields out of every section, so the field gets no dropdown of its own and is not filled alongside its siblings either - the previous revision only withheld the dropdown, so a fill triggered from another field still reached it.\n\nThe platform parser is reused via `getAutocompleteInfo()` (an empty fieldName means unrecognized); off/on stay ignored (Bug 1754879).\n\nThe tests table-drive every autofill field name the HTML spec defines, plus the section, address-hint and contact-hint combinations it allows, straight through `hasUnrecognizedAutocomplete()`. Gecko's parser implements the whole spec vocabulary, so none of these -- including ones autofill never fills, like `username`, `one-time-code`, `webauthn` and `bday` -- resolves to an empty field name, and none is read as an opt-out. A matching negative table pins the values that are genuinely invalid: an unknown token, the right tokens in the wrong order, a misplaced `section-*`, a contact hint on a non-contact field name, and `webauthn` that is not last.\n\nTwo of those field names reach the new branch rather than `inferFieldInfo`'s autocomplete early return: `address-level4`, the only entry in `_unsupportedFieldNameInfo`, and `on`. Both are covered end to end by a form whose field is named from its `city` attribute instead, which the heuristics still classify and fill.\n\nThis is gated behind extensions.formautofill.suppressUnrecognizedAutocomplete.enabled, which is off by default and settable from the autofill-suppress-unrecognized-autocomplete Nimbus feature.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321142\n", "files": ["browser/extensions/formautofill/test/browser/browser.toml", "browser/extensions/formautofill/test/browser/browser_autocomplete_unrecognized_attribute.js", "modules/libpref/init/all.js", "toolkit/components/formautofill/FormAutofill.sys.mjs", "toolkit/components/formautofill/shared/FieldScanner.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillHeuristics.sys.mjs", "toolkit/components/formautofill/shared/FormAutofillUtils.sys.mjs", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "af161a75368257664f74db6a6b25355fb43a7f08", "git_parents": ["14e2ed0ddd3a9934a9b5c3f5c5b76072b9526beb"], "node": "8e4aca0bf6ed649aee87621a0fc6a8b0d4ff9eb5", "parents": ["aef0980d71ba97481e5ad0ec177ff9368a3c50ae"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075123 - Require an options object in SessionStore's getClosedTabCount, getClosedTabData and getClosedTabGroups. r=fxview-reviewers,sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328762\n", "files": ["browser/base/content/test/browser-menubar/browser_history_recently_closed_tabs.js", "browser/components/firefoxview/recentlyclosed.mjs", "browser/components/firefoxview/tests/browser/browser_recentlyclosed_firefoxview.js", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/test/browser_1933485_tab_groups_history.js", "browser/components/sessionstore/test/browser_forget_closed_tab_window_byId.js", "browser/components/sessionstore/test/browser_splitview_restore_in_closed_window.js", "browser/components/sessionstore/test/browser_tab_groups_closed_groups_in_closed_windows.js", "browser/components/sessionstore/test/browser_tab_groups_restore_closed_in_closed_window.js", "browser/components/sessionstore/test/browser_tab_groups_restore_closed_many_tabs.js", "browser/components/sessionstore/test/browser_tab_groups_save_on_removeAllTabsBut.js", "browser/components/sessionstore/test/browser_undoCloseById.js", "browser/components/sessionstore/test/browser_undoCloseById_targetWindow.js", "browser/components/sessionstore/test/head.js", "browser/components/tabbrowser/test/browser/tabMediaIndicator/browser_mute_restore_closed_audible_tab.js", "testing/mochitest/browser-test.js"], "git_node": "0d4e237add0ea1c45f0ea6eddd207731e015e4f4", "git_parents": ["af161a75368257664f74db6a6b25355fb43a7f08"], "node": "71f64354ad68b21bfc6944d07e8d42b55251fcd3", "parents": ["8e4aca0bf6ed649aee87621a0fc6a8b0d4ff9eb5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075163 - Update Session Restore comments that still describe frame scripts and ContentRestore. r=sessionstore-reviewers,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328804\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/TabState.sys.mjs", "browser/components/sessionstore/TabStateFlusher.sys.mjs"], "git_node": "e3e510f283960ead3f29ab6d9bbf89a5ffb69922", "git_parents": ["0d4e237add0ea1c45f0ea6eddd207731e015e4f4"], "node": "fa5749f026b8a68b5dbd9a88416d04fd2829464d", "parents": ["71f64354ad68b21bfc6944d07e8d42b55251fcd3"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038964 - Adding testcase. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D300452\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2038964.js"], "git_node": "a6b28fa7acfa57fe51ee3bf99db26ea8ffacf275", "git_parents": ["e3e510f283960ead3f29ab6d9bbf89a5ffb69922"], "node": "93fbcbeca99cca87011180b15d9f93abc3605a6b", "parents": ["fa5749f026b8a68b5dbd9a88416d04fd2829464d"], "tags": []}, {"author": "Sho Sakuma \u003cme@m1sk9.dev\u003e", "branch": "default", "desc": "Bug 2072518 - Remove the dead NotInShutdown branch from nsTerminator's RunWatchdog. r=jstutte\n\nThe watchdog thread is only started from nsTerminator::AdvancePhase, which\nrecords the phase through UpdateHeartbeat in the same call, so RunWatchdog\nalways finds a last known phase. Keep a debug assertion in its place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326426\n", "files": ["toolkit/components/terminator/nsTerminator.cpp"], "git_node": "d354d61afa36cf17ec3deb1c20718a7d8785890b", "git_parents": ["a6b28fa7acfa57fe51ee3bf99db26ea8ffacf275"], "node": "4dddb0ec958fb0db26b31b278b90ded013395193", "parents": ["93fbcbeca99cca87011180b15d9f93abc3605a6b"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068420 - Skip the head sentinel, r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328764\n", "files": ["gfx/cairo/cairo/src/cairo-boxes-intersect.c", "gfx/cairo/moz.yaml", "gfx/cairo/patches/0051-Bug-2068420-skip-head-sentinel.patch"], "git_node": "91ffee74062d8d8bd386c9a4047033ae73737ee6", "git_parents": ["d354d61afa36cf17ec3deb1c20718a7d8785890b"], "node": "1f32c89272e9614b085223daf768089bba23edbd", "parents": ["4dddb0ec958fb0db26b31b278b90ded013395193"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2054896 - [remote] Remove the \"--remote-allow-system-access\" command line argument. r=webdriver-reviewers,jdescottes,gerard-majax,geckodriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328412\n", "files": ["mozglue/misc/PreXULSkeletonUI.cpp", "remote/components/RemoteAgent.sys.mjs", "remote/doc/Prefs.md", "remote/doc/Security.md", "remote/shared/webdriver/Assert.sys.mjs", "testing/mochitest/runtests.py", "testing/mozbase/rust/mozrunner/src/firefox_args.rs", "toolkit/xre/test/marionette/xdg_config/xdg_config_home_test_case.py"], "git_node": "e567adf15bcbb1d5dee951d35549f95e98dd4bb8", "git_parents": ["91ffee74062d8d8bd386c9a4047033ae73737ee6"], "node": "acc3c4f6421cd52275a33622814c479ced9b501b", "parents": ["1f32c89272e9614b085223daf768089bba23edbd"], "tags": []}, {"author": "Gijs Kruitbosch \u003cgijskruitbosch@gmail.com\u003e", "branch": "default", "desc": "Bug 2071625 - Import Chrome bookmarks from the AccountBookmarks file (signed-in profiles). r=migration-reviewers,mconley\n\nWhen a user is signed in to a Google account, recent Chrome versions store the\naccount's bookmarks in an \"AccountBookmarks\" file instead of / in addition to\nthe legacy \"Bookmarks\" file, and may not write a \"Bookmarks\" file at all. The\nJSON format is the same. Firefox's Chrome migrator only ever read \"Bookmarks\",\nso bookmarks from signed-in Chrome profiles were not imported, and such\nprofiles could fail to be detected as having importable data.\n\nGetBookmarksResource now reads whichever of \"Bookmarks\" and\n\"AccountBookmarks\" exist and imports their union if both exists.\ngetLastUsedDate also considers \"AccountBookmarks\" when estimating\nprofile recency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326140\n", "files": ["browser/components/migration/ChromeProfileMigrator.sys.mjs", "browser/components/migration/tests/unit/test_Chrome_bookmarks.js"], "git_node": "a0045653be01856bc59274b132c1fce534cdb46e", "git_parents": ["e567adf15bcbb1d5dee951d35549f95e98dd4bb8"], "node": "1952de4db534b9289f5e900715c3d9758f703757", "parents": ["acc3c4f6421cd52275a33622814c479ced9b501b"], "tags": []}], "date": 1790718150, "git_changesets": ["500407a1be99fab5b5d53080db37de09c3dcd63e", "ec5f022f401a14a5ef5b67a7fe7e39488315d518", "7d0c94b68d1d9c4d59f22d54563b152c3aaf1ee3", "fe46b2cfe466889a6a5ff33f0692f32d5e7e0eab", "14e2ed0ddd3a9934a9b5c3f5c5b76072b9526beb", "af161a75368257664f74db6a6b25355fb43a7f08", "0d4e237add0ea1c45f0ea6eddd207731e015e4f4", "e3e510f283960ead3f29ab6d9bbf89a5ffb69922", "a6b28fa7acfa57fe51ee3bf99db26ea8ffacf275", "d354d61afa36cf17ec3deb1c20718a7d8785890b", "91ffee74062d8d8bd386c9a4047033ae73737ee6", "e567adf15bcbb1d5dee951d35549f95e98dd4bb8", "a0045653be01856bc59274b132c1fce534cdb46e"], "user": "rperta@mozilla.com"}, "45446": {"changesets": [{"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2075623 - Back out SessionHistoryInfo ID checks, r=dom-core-reviewers,farre\n\nThese checks were added in bug 2056965, and this particular ID in\nSessionHistoryInfo is causing a notable number of new crashes, likely\ndue to the parent process object going away unexpectedly. Back out this\nspecific ID check to reduce the crash rate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329779\n", "files": ["docshell/shistory/SessionHistoryEntry.cpp"], "git_node": "a698c4af15b1569ff389cfb38ff6bf61a1e03616", "git_parents": ["a0045653be01856bc59274b132c1fce534cdb46e"], "node": "16e83f7ca65e7845e872634665894af4c843073e", "parents": ["1952de4db534b9289f5e900715c3d9758f703757"], "tags": []}], "date": 1790718526, "git_changesets": ["a698c4af15b1569ff389cfb38ff6bf61a1e03616"], "user": "rperta@mozilla.com"}, "45447": {"changesets": [{"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061871 - Add scrollbar inset for browser content area. r=desktop-theme-reviewers,tabbrowser-reviewers,jswinarton,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317586\n", "files": ["browser/base/content/test/browser-static/browser_parsable_css.js", "browser/themes/shared/tabbrowser/content-area.css"], "git_node": "312e7bd59712a5b1fdd8ad59cc1fa07d40e7cd2c", "git_parents": ["a0045653be01856bc59274b132c1fce534cdb46e"], "node": "15b8bca238010eee62bbb1061a7ea221483c7187", "parents": ["1952de4db534b9289f5e900715c3d9758f703757"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066236 - Gate widget availability by market r=reemhamz,settings-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325667\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "0caffc1fc0f0175930bffff64ec86df8cf54666d", "git_parents": ["312e7bd59712a5b1fdd8ad59cc1fa07d40e7cd2c"], "node": "43363fb0b7a306dbc7a984240b1eeece0a0c3717", "parents": ["15b8bca238010eee62bbb1061a7ea221483c7187"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066240 - Turn the Lists widget off by default in the US, DE and FR, and block it in PL r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325669\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser_discovery_card.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "72298fd857ddab5d41fe5b3e300e688d20b17dab", "git_parents": ["0caffc1fc0f0175930bffff64ec86df8cf54666d"], "node": "c1c1099088b95ee0fe45bbcaa3c00e58e19220b3", "parents": ["43363fb0b7a306dbc7a984240b1eeece0a0c3717"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066242 - Turn FocusTimer off by default in US, DE, FR, PL regions. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327240\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser_newtab_side_by_side_layout.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "418706de54db57573100149edbc9adac7990925b", "git_parents": ["72298fd857ddab5d41fe5b3e300e688d20b17dab"], "node": "8e4ce28334dcd0f7caf5ad9bc1af3a8fdff5ce3d", "parents": ["c1c1099088b95ee0fe45bbcaa3c00e58e19220b3"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066244 - Turn Clocks widget off by default for US, DE, FR, PL regions. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327243\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser_newtab_side_by_side_layout.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "26dad5a58083dfb93ef4a5b4521317560c94aa7f", "git_parents": ["418706de54db57573100149edbc9adac7990925b"], "node": "7f3e41833151d05470f48a0eb0440cca7f09fd4a", "parents": ["8e4ce28334dcd0f7caf5ad9bc1af3a8fdff5ce3d"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066246 - Turn POTD widget off by default for US, DE, FR, PL regions. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327245\n", "files": ["browser/app/profile/firefox.js", "browser/components/backup/tests/marionette/test_backup.py", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "testing/profiles/common/user.js", "testing/profiles/xpcshell/user.js"], "git_node": "8b7bb33aab8dcd3edf37218060bf85a36070caf2", "git_parents": ["26dad5a58083dfb93ef4a5b4521317560c94aa7f"], "node": "8ba4dca60438bc1c82a1a6ae8f0faea39954b42b", "parents": ["7f3e41833151d05470f48a0eb0440cca7f09fd4a"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066248 - Turn Privacy widget off by default for all regions. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328046\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "82a91c9267ad793c5a07141a86f568a814951b2b", "git_parents": ["8b7bb33aab8dcd3edf37218060bf85a36070caf2"], "node": "6d2b8b2122b1224d04ae53504f15b7576c518643", "parents": ["8ba4dca60438bc1c82a1a6ae8f0faea39954b42b"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066247 - Turn Stocks widget off by default for all regions r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328656\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "a868f2ee91c11f48560599f94f74b1d9c971a8bb", "git_parents": ["82a91c9267ad793c5a07141a86f568a814951b2b"], "node": "807165719542b8ed5dc8638fff0283a9219ec64c", "parents": ["6d2b8b2122b1224d04ae53504f15b7576c518643"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074974 - Turn Recent Searches widget off by default for all regions r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328657\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "48280c84fdfeac8821b974f94d45bdf751324076", "git_parents": ["a86