 multiple tags.r=whimboo,webdriver-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326753\n", "files": ["testing/marionette/harness/marionette_harness/tests/harness_unit/test_marionette_arguments.py", "testing/marionette/harness/marionette_harness/tests/harness_unit/test_marionette_runner.py", "testing/mozharness/scripts/marionette.py"], "git_node": "23f6601b774c46b44a3565958b7cc7a7b22e3ded", "git_parents": ["6665a0d4abd30a100bf52fe1e3610d2cc20bc15a"], "node": "59e7896da3a8de33573a4dfea90393e923487e36", "parents": ["9f12f7ed57127fd68fb71a21060521762cab2b7c"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059029 - Search mode switcher's globe icon needlessly waits on the engine store. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329760\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser-results/browser_testUrlbarIcons.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js"], "git_node": "b6990f74a52aeb83da32fe4b3b5a0a331253211d", "git_parents": ["23f6601b774c46b44a3565958b7cc7a7b22e3ded"], "node": "94b28d1e607857d9039cd40c6ce3c5765622549a", "parents": ["59e7896da3a8de33573a4dfea90393e923487e36"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2042058 - Test for is. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D304071\n", "files": ["parser/xml/test/unit/results.js"], "git_node": "996b2e2f7f29a04fc8a04307df6652e9e8a9ef82", "git_parents": ["b6990f74a52aeb83da32fe4b3b5a0a331253211d"], "node": "8df4d200c1a2a24d5e15dd2f73df5c7df55cbb09", "parents": ["94b28d1e607857d9039cd40c6ce3c5765622549a"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074042 - Add a few SCHEDULES.exclusive rules for improved deterministic platform selection. r=firefox-build-system-reviewers,necko-reviewers,media-playback-reviewers,sandbox-reviewers,gtk-reviewers,sergesanspaille,emilio,aosmond,jesup,bobowen DONTBUILD\n\nLooking at the past three weeks, this reduces Mac and Windows test tasks by 0.25%.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327783\n", "files": ["accessible/atk/moz.build", "accessible/mac/moz.build", "accessible/moz.build", "accessible/windows/moz.build", "dom/media/platforms/wmf/moz.build", "dom/system/linux/moz.build", "hal/moz.build", "image/decoders/icon/moz.build", "netwerk/system/linux/moz.build", "netwerk/system/netlink/moz.build", "security/sandbox/linux/moz.build", "toolkit/system/androidproxy/moz.build", "toolkit/system/gnome/moz.build", "toolkit/system/osxproxy/moz.build", "toolkit/system/unixproxy/moz.build", "toolkit/system/windowsDHCPClient/moz.build", "toolkit/system/windowsproxy/moz.build", "uriloader/exthandler/moz.build", "widget/gtk/moz.build", "widget/x11/moz.build"], "git_node": "7ebc589b066b701d28a5551e4fd9302a4c0e8ebf", "git_parents": ["996b2e2f7f29a04fc8a04307df6652e9e8a9ef82"], "node": "78601b9de08cfcf355015f8305e7289741a56654", "parents": ["8df4d200c1a2a24d5e15dd2f73df5c7df55cbb09"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076694 - Use the confidence thresholds returned by bugbug for the preset levels. r=bhearsum,taskgraph-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329905\n", "files": ["taskcluster/gecko_taskgraph/optimize/bugbug.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py", "taskcluster/gecko_taskgraph/util/bugbug.py"], "git_node": "2cc2fd24f171434ab45986f349fb66cb36229b22", "git_parents": ["7ebc589b066b701d28a5551e4fd9302a4c0e8ebf"], "node": "f8a7d838f625878860f5be81025d73d5878f4443", "parents": ["78601b9de08cfcf355015f8305e7289741a56654"], "tags": []}, {"author": "mayankleoboy1 \u003cmayankleoboy1@gmail.com\u003e", "branch": "default", "desc": "Bug 2078151 - Bug 2041877 - Look the mutated subtree root up in DOMLocalization::mRoots. r=dom-core-reviewers,smaug\n\nL10nMutations::IsInRoots runs on every content append, insert and removal in a\nshadow tree, and SubtreeRootInRoots answered it by walking every connected\nroot. MozLitElement connects each element's own shadow root, so mRoots grows\nwith the content: on about:logins with a large password store the walk is 21.6%\nof the content process' non-idle samples in the profile on bug 2041877.\n\nA ShadowRoot is always its own subtree root, so a hash lookup answers the case\nthat scales. Roots that are not their own subtree root - the document element,\nor an element connected from inside a shadow tree - still need the walk.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323511\n", "files": ["dom/l10n/DOMLocalization.h"], "git_node": "1f304e8d3ede17306827c72f2ae24db582d269bd", "git_parents": ["2cc2fd24f171434ab45986f349fb66cb36229b22"], "node": "f2401dec11bf19b31399a53e4eb5c0119a8c9b01", "parents": ["f8a7d838f625878860f5be81025d73d5878f4443"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070935 - Update metadata for network-error-logging/sends-report-on-cache-validation.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330693\n", "files": ["testing/web-platform/meta/network-error-logging/sends-report-on-cache-validation.https.html.ini"], "git_node": "a64bfa3fe29cf31c41740026b14e09c00ea58d4a", "git_parents": ["1f304e8d3ede17306827c72f2ae24db582d269bd"], "node": "c9888811e9657029fe40a3911a9e1de3aac3576d", "parents": ["f2401dec11bf19b31399a53e4eb5c0119a8c9b01"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077155 - Change the updatebot vendoring task frequency for NSS from 1 week to 1 day U