tests/css/css-view-transitions/nested/nested-root-capture-with-clip.html", "testing/web-platform/tests/css/css-view-transitions/nested/normal-goes-up.tentative.html", "testing/web-platform/tests/css/css-view-transitions/nested/render-element.tentative.html", "testing/web-platform/tests/css/css-view-transitions/shared-transition-author-style.manual.html", "testing/web-platform/tests/css/css-view-transitions/shared-transition-half.manual.html", "testing/web-platform/tests/css/css-view-transitions/shared-transition-shapes.manual.html"], "git_node": "0becb6df66237a9e665257e7db15bce915008682", "git_parents": ["fb24b5fb9f72c1e8d2f68a31018ddb41f2c8ac11"], "node": "279bd1544401d62e85cbbeee66f1891db3088de3", "parents": ["a17890db62873cff2e5b599524db94cc826f22fc"], "tags": []}, {"author": "Jacques Newman \u003cjanewman@microsoft.com\u003e", "branch": "default", "desc": "Bug 2075472 [wpt PR 62952] - [focusgroupV2] Restore feed WPT state after mutation, a=testonly\n\nAutomatic update from web-platform-tests\n[focusgroupV2] Restore feed WPT state after mutation\n\nRestore feed-navigation test state after its dynamic mutation case so a\nfailure cannot leak inserted or removed elements into later tests. Both\nFocusgroup V2 review stacks depend on this shared WPT prerequisite.\n\nBug: 445992558\nChange-Id: Iad1e30771cf5436353944c79d27a57ca14d49974\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8408771\nReviewed-by: Jeff Weiner \u003cJeff.Weiner@microsoft.com\u003e\nCommit-Queue: Jacques Newman \u003cjanewman@microsoft.com\u003e\nAuto-Submit: Jacques Newman \u003cjanewman@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1704965}\n\n--\n\nwpt-commits: 19eb5e044815d17c63533a3717f68d661c4e61c1\nwpt-pr: 62952\n", "files": ["testing/web-platform/tests/html/interaction/focus/focusgroup/tentative/feed-navigation.html"], "git_node": "0d5cc770e940125b6979b1a9454bf211745404fe", "git_parents": ["0becb6df66237a9e665257e7db15bce915008682"], "node": "2450952652a32b8147361137c71b65be5d7a7d8a", "parents": ["279bd1544401d62e85cbbeee66f1891db3088de3"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2075760 [wpt PR 62971] - Fix mismatched end tags in css-text-decor WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nFix mismatched end tags in css-text-decor WPTs\n\nIn these tests the closing tag names a different element than the one\nactually open. Correct each end tag, and close elements the source\nclearly meant to close.\n\nBug: 542686202\nChange-Id: I47c3582af00fc233ef325c6237a162d033227adf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8227204\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Andres Regalado Rosas \u003candresrega@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1704979}\n\n--\n\nwpt-commits: e2c6b9c04b336c4158e2babdd6874df6b12be8c5\nwpt-pr: 62971\n", "files": ["testing/web-platform/tests/css/css-text-decor/reference/text-emphasis-style-002-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-emphasis-style-010-ref.html", "testing/web-platform/tests/css/css-text-decor/reference/text-emphasis-style-012-ref.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-040-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-090a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-091a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-092a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-095a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-096a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-097a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-line-040-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-line-090a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-line-091a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-line-092a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-line-095a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-line-096a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-line-097a-manual.html", "testing/web-platform/tests/css/css-text-decor/text-decoration-propagation-04.html"], "git_node": "27c317f53d99b9e29a5d26cb816d23d40f444cc6", "git_parents": ["0d5cc770e940125b6979b1a9454bf211745404fe"], "node": "9c9244d175bbe4e2982b6e92041f55937fa5c148", "parents": ["2450952652a32b8147361137c71b65be5d7a7d8a"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2075767 [wpt PR 62975] - Fix mismatched end tags in HTML WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nFix mismatched end tags in HTML WPTs\n\nIn these tests in third_party/blink/web_tests/external/wpt/html/ the\nclosing tag names a different element than the one actually open.\nCorrect each end tag, and close elements the source clearly meant to\nclose rather than relying on an ancestor's end tag to do it.\n\nBug: 542686202\nChange-Id: Ifb22d0448f785b432104d4612e130fac06868f28\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8222504\nReviewed-by: Jacques Newman \u003cjanewman@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1705005}\n\n--\n\nwpt-commits: 46a30f4889a0a1ba3916fcb0b14d282b9e0c9da5\nwpt-pr: 62975\n", "files": ["testing/web-platform/tests/html/canvas/element/manual/filters/svg-specular-filter-visited-color-taints.html", "testing/web-platform/tests/html/editing/dnd/events/relatedTarget-attribute-manual.html", "testing/web-platform/tests/html/editing/dnd/