, "26c8e0658280051ff9782f6166f9597e69a069be", "04c91827ac919da802e599fe402b08c4ba0c4d0b", "e57a248a86122f4bfa29d79af71d9aa5d8192c25", "bc52891e3f13665f028ef92dc06fc9214b59de68", "025c42fd3ac53ec231b5fb76c36a6fed74d01e6a", "ee626a816fed8b2832ebc7ea8e2bc3e8f75eaded", "2eab300a041be281d48e906e81c37237d4163611", "9d30eac90664006fb14c19e8adec87038aaa6643", "2ce2a824cc02dc98a4d9aff33e9d09e5449e2db9", "bc93ce196f177bb85612978c80fd4f9ee4081188", "6ec77b637f07f3e21016a654a64fddc8c62cae08", "f65c9c9afe278940ced4463015f2b6d3bf95ca97", "dd195b778c374ada1470160b2c63001c1b08e1b2", "020b0af5c7435caea7d1d1898a76e5a9a7379819", "f57ca83eabd19aeb06d3810b9142d2eb3d42e552", "9b3db0dbac9fac8cc77dfae47cd114c42915bba3", "3bfd8f7875b0d5185ae92c280062ef3fed1b1951", "9d616b4f64a63e8c1e235494a6aed2b64c93cb8e", "35944e2aecc5b8d99ef780ee17557b5db6506fb7", "0fc55a83b414da9fcb3f7296b2700b0e6efc5c24", "d910cbb14699540d6adbe2ba36ba087d4aeef65f", "5e261539d78bdd63e548e2b8b99bb00d99c08d84", "9d28e6d5ed22cdf3abb689517356f3be8297a745", "658dad456166a7c1a44e45dd7932d68a5f378827", "854d3e5e021db9f6d1a62c71f94585724de0af70", "2335ef39b6a42febce70ac44e61453a75844c73b", "3ba81bc5230b7e300d7aa1786af15c0b94348cb3", "f44cc3ee3faeb70d2be26bc06ac1691b89d84ccb"], "user": "smolnar@mozilla.com"}, "45463": {"changesets": [{"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076571 - Fix even more tests from Amazon removal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330275\n", "files": ["browser/components/sidebar/tests/browser/browser_vertical_tabs_stacking_context.js", "browser/components/urlbar/tests/browser-newtab/browser_undo_history.js"], "git_node": "084057e952e7dbf376f6c3765ad242aec3785dc6", "git_parents": ["f44cc3ee3faeb70d2be26bc06ac1691b89d84ccb"], "node": "5691ae4323cb28877da41e8331af5aa7f869d6b0", "parents": ["c02df66a91eadd1bb4348abe216e99d81e93229a"], "tags": []}], "date": 1790890872, "git_changesets": ["084057e952e7dbf376f6c3765ad242aec3785dc6"], "user": "smolnar@mozilla.com"}, "45464": {"changesets": [{"author": "Finn Terdal \u003cfterdal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069996 - Create transition animations for the HNT card stack r=omc-reviewers,emcminn,jprickett\n\nAdds animations to the card-stack element. There are some edge cases to\nbe mindful of here, including that the card stack plays an animation on\nteardown, so we wouldn't want wait for two animations to finish, or that\nif a user clicks to dismiss / accept a card before the earlier animation\nfinished, we should be sure not to enqueue two animations. We're also\nusing --translate here so that prefers-reduced-motion simply changes\nopacity rather than element position.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328583\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/asrouter-newtab-multistage.jsx", "browser/components/asrouter/content-src/components/MultiStageAboutWelcome.jsx", "browser/components/asrouter/content-src/components/MultistageWithDismiss.jsx", "browser/components/asrouter/content-src/components/asrouter-newtab-multistage/asrouter-newtab-multistage.scss", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAboutWelcome.test.jsx", "browser/components/asrouter/tests/unit/content-src/components/MultistageWithDismiss.test.jsx"], "git_node": "7bbe749b66cd336a198f542588ce45e69060ee37", "git_parents": ["f44cc3ee3faeb70d2be26bc06ac1691b89d84ccb"], "node": "6e8411b1f2b62a01fbc238f594ae476f067ad377", "parents": ["c02df66a91eadd1bb4348abe216e99d81e93229a"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076571 - Fix even more tests from Amazon removal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330275\n", "files": ["browser/components/sidebar/tests/browser/browser_vertical_tabs_stacking_context.js", "browser/components/urlbar/tests/browser-newtab/browser_undo_history.js"], "git_node": "bddf2d6671ceaa7ffd0b3dbdca3094345b0b42d4", "git_parents": ["7bbe749b66cd336a198f542588ce45e69060ee37"], "node": "6372ba8c4506159aaaeefc372668d81f2e5f34b2", "parents": ["6e8411b1f2b62a01fbc238f594ae476f067ad377"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076648 - Clear previously-focused content after blurring due to caret move. r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329959\n", "files": ["dom/base/nsFocusManager.cpp", "testing/web-platform/mozilla/tests/focus/focus-navigation-starting-point-caret-browsing.html"], "git_node": "254bfc5af5a7bb7b45187eb87161d5e6f3b0c68c", "git_parents": ["bddf2d6671ceaa7ffd0b3dbdca3094345b0b42d4"], "node": "f7cb6b0c9eeab946cf87c20fee3dc403769f8a8c", "parents": ["6372ba8c4506159aaaeefc372668d81f2e5f34b2"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075870 - Fix Opus/Vorbis/FLAC decoding with Widevine on Android. r=media-playback-reviewers,alwu\n\nWe cannot use our traditional Opus/Vorbis/FLAC decoders with\nWidevine on Android because we only support decrypt and decode, not\ndecrypt on Android. As such we need to, and attempt to use today,\nthe decoders provided by the platform. This doesn't work though\nbecause we are not supplying the necessary codec specific data\nrequired to correctly configure the decoders. This patch adds that,\nsimilar to our efforts in bug 2075696 for the MediaCodec NDK path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329428\n", "files": ["dom/media/platforms/android/RemoteDataDecoder.cpp", "dom/media/platforms/android/RemoteDataDecoder.h", "dom/media/platforms/android/gtest/TestRemoteDataDecoder.cpp", "dom/media/platforms/android/gtest/moz.build", "dom/media/platforms/moz.build"], "git_node": "37f02578955b02b4b5d5fa9d903bae6087dd6bb7", "git_parents": ["254bfc5af5a7bb7b45187eb87161d5e6f3b0c68c"], "node": "547dcf495f641608e853748b72bf412c945b623d", "parents": ["f7cb6b0c9eeab946cf87c20fee3dc403769f8a8c"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077282 - Re-generate tools/@types/generated/. r=daleharvey.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330248\n", "files": ["tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "ee18c6f661f439f616cb41aaf64ece292c93d9a3", "git_parents": ["37f02578955b02b4b5d5fa9d903bae6087dd6bb7"], "node": "8b5a4001cd10c1340617b30b115acdd63de43793", "parents": ["547dcf495f641608e853748b72bf412c945b623d"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "eb393194ae2f61b3aaeb8b4a407c2af544282972", "git_parents": ["ee18c6f661f439f616cb41aaf64ece292c93d9a3", "084057e952e7dbf376f6c3765ad242aec3785dc6"], "node": "88dbbe976f72254c7b1e6ee155ce670834345260", "parents": ["8b5a4001cd10c1340617b30b115acdd63de43793", "5691ae4323cb28877da41e8331af5aa7f869d6b0"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Report a multiselect close in the TabClose event detail rather than on the tab. r=tabbrowser-reviewers,sessionstore-reviewers,nsharpley\n\nThe flag used to stay on a tab that a multi-tab close left open (a beforeunload check that errored, or a prompt closeTabsByURI never shows), so a later close of that tab alone was recorded as part of the batch. It now applies only to the close it came with.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329886\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/docs/tab-events.md"], "git_node": "f686ce87ae2ecb3bbb35572b0ac33870e4848e8d", "git_parents": ["eb393194ae2f61b3aaeb8b4a407c2af544282972"], "node": "550226a540d2def16a1c268d2e5d7cae8f8e5185", "parents": ["88dbbe976f72254c7b1e6ee155ce670834345260"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075734 - Add Widevine EME WPTs for Opus/Vorbis/FLAC. r=media-playback-reviewers,alwu\n\nThis is a configuration that we support, but have no test coverage\nfor. On most platforms this will cause us to hit the decrypt only\npath and use the normal decoders, but with Android, it should do a\ndecrypt and decode. This is particularly useful for MediaCodec NDK\nefforts because we had to add new integration code for ffmpeg to\nexpose these codecs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329331\n", "files": ["testing/web-platform/mozilla/meta/encrypted-media/__dir__.ini", "testing/web-platform/mozilla/tests/encrypted-media/content/audio_flac_enc.mp4", "testing/web-platform/mozilla/tests/encrypted-media/content/audio_opus_enc.mp4", "testing/web-platform/mozilla/tests/encrypted-media/content/audio_vorbis_enc.webm", "testing/web-platform/mozilla/tests/encrypted-media/drm-mp4-playback-temporary-flac.https.html", "testing/web-platform/mozilla/tests/encrypted-media/drm-mp4-playback-temporary-opus.https.html", "testing/web-platform/mozilla/tests/encrypted-media/drm-webm-playback-temporary-vorbis.https.html", "testing/web-platform/mozilla/tests/encrypted-media/resources/audio-playback-temporary.js", "testing/web-platform/mozilla/tests/encrypted-media/resources/content-metadata.js"], "git_node": "5ef526a69aad45300536aeaf9640fb3baee482a2", "git_parents": ["f686ce87ae2ecb3bbb35572b0ac33870e4848e8d"], "node": "730d15cd252ac74391d0a9929fe652cd3072a99f", "parents": ["550226a540d2def16a1c268d2e5d7cae8f8e5185"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055176 - Bucket the WebGL vendor to a GPU family instead of a constant r=timhuang\n\nLibraries pick driver workarounds off the vendor string, so collapsing it to\n\"Mozilla\" left them on a fallback path that's wrong for the actual hardware.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329679\n", "files": ["dom/canvas/SanitizeRenderer.cpp", "dom/canvas/test/webgl-mochitest/mochitest.toml", "dom/canvas/test/webgl-mochitest/test_webgl_vendor_family_fpp.html", "dom/canvas/test/webgl-mochitest/test_webgl_vendor_sanitize_fpp.html", "dom/canvas/test/webgl-mochitest/test_webgl_vendor_sanitize_fpp_explicit.html", "toolkit/components/resistfingerprinting/RFPTargetsDefault.inc"], "git_node": "e29e0a1bf9f4721e61670313eaa17deb4cc3e3c0", "git_parents": ["5ef526a69aad45300536aeaf9640fb3baee482a2"], "node": "cf069dc589db3bbdac19ff18a145dc0f4ff5bf0d", "parents": ["730d15cd252ac74391d0a9929fe652cd3072a99f"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2076623 - part 1: Rewrite `test_keycodes.xhtml` with `async function` and `await` r=jjaschke\n\nIt's hard to read and maintain generator functions and `yield`. They\nare used before `async`/`await` become available. So, let's rewrite\nthe test with them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330077\n", "files": ["widget/tests/test_keycodes.xhtml"], "git_node": "087ccd329525cee9b335d846bf2639226a5dbf96", "git_parents": ["e29e0a1bf9f4721e61670313eaa17deb4cc3e3c0"], "node": "7a1f8b9e30e71b9eb56fc26f2c91c5da4cb93998", "parents": ["cf069dc589db3bbdac19ff18a145dc0f4ff5bf0d"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2076623 - part 2: Make `test_keycodes.xhtml` use template literals r=jjaschke\n\nIt's shorter than joining string and variables.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330078\n", "files": ["widget/tests/test_keycodes.xhtml"], "git_node": "adfe3b837ba3f75fc88580467f4db729d102422b", "git_parents": ["087ccd329525cee9b335d846bf2639226a5dbf96"], "node": "e2bffd756d0b6e0b50b3995d9c4c4c66c793d987", "parents": ["7a1f8b9e30e71b9eb56fc26f2c91c5da4cb93998"], "tags": []}, {"author": "Mark Kennedy \u003cmkennedy@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064546 - Make listbox role usage on moz-fieldset pickers spec-compliant r=desktop-theme-reviewers,tgiles,fluent-reviewers,mossop,bolsson\n\nSetting role=listbox on pickers worked before this. But this improves\ntheir accessibility by ensuring that a role=listbox placed on them\ndoesn't get passed down onto fieldset or a slot, which the spec doesn't\nallow.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325996\n", "files": ["browser/components/asrouter/tests/browser/browser_spotlight_carousel_nav.js", "browser/components/profiles/content/profile-avatar-selector.mjs", "browser/components/profiles/tests/browser/browser_icon_avatar_test.js", "browser/locales/en-US/browser/profiles.ftl", "toolkit/content/tests/widgets/test_moz_visual_picker.html", "toolkit/content/tests/widgets/test_theme_picker.html", "toolkit/content/widgets/lit-select-control.mjs", "toolkit/content/widgets/moz-fieldset/moz-fieldset.css", "toolkit/content/widgets/moz-fieldset/moz-fieldset.mjs", "toolkit/content/widgets/theme-picker/theme-picker.mjs", "toolkit/locales/en-US/toolkit/global/theme-picker.ftl", "toolkit/mozapps/extensions/test/browser/browser_html_themes_mode.js"], "git_node": "073470574580ca3c5d05feddc3fd7b98408e80fc", "git_parents": ["adfe3b837ba3f75fc88580467f4db729d102422b"], "node": "5df67d0109c7bc5c72b5f354b3ece15504af8957", "parents": ["e2bffd756d0b6e0b50b3995d9c4c4c66c793d987"], "tags": []}], "date": 1790914179, "git_changesets": ["7bbe749b66cd336a198f542588ce45e69060ee37", "bddf2d6671ceaa7ffd0b3dbdca3094345b0b42d4", "254bfc5af5a7bb7b45187eb87161d5e6f3b0c68c", "37f02578955b02b4b5d5fa9d903bae6087dd6bb7", "ee18c6f661f439f616cb41aaf64ece292c93d9a3", "eb393194ae2f61b3aaeb8b4a407c2af544282972", "f686ce87ae2ecb3bbb35572b0ac33870e4848e8d", "5ef526a69aad45300536aeaf9640fb3baee482a2", "e29e0a1bf9f4721e61670313eaa17deb4cc3e3c0", "087ccd329525cee9b335d846bf2639226a5dbf96", "adfe3b837ba3f75fc88580467f4db729d102422b", "073470574580ca3c5d05feddc3fd7b98408e80fc"], "user": "smolnar@mozilla.com"}, "45465": {"changesets": [{"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-gn/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-tt/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-eo/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-cs/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-gn/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-el/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/fenix/app/src/main/res/values-gn/strings.xml", "mobile/android/fenix/app/src/main/res/values-lv/strings.xml", "mobile/android/fenix/app/src/main/res/values-nl/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-tt/strings.xml"], "git_node": "c184904ad87b0498042b252281ae25bcc04929e2", "git_parents": ["073470574580ca3c5d05feddc3fd7b98408e80fc"], "node": "c96dceba599a94a1a62b47750390c7e83145b52d", "parents": ["5df67d0109c7bc5c72b5f354b3ece15504af8957"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2076978 - [loong64] Implement MWasmBinarySimd128::canTestBits() by returning false. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330074\n", "files": ["js/src/jit/loong64/Lowering-loong64.cpp"], "git_node": "46aa89fa43bf048e1cdcc3b711a9933b87e05727", "git_parents": ["c184904ad87b0498042b252281ae25bcc04929e2"], "node": "0c868ae7b2d7c88749c4c142878558b9f78e9f17", "parents": ["c96dceba599a94a1a62b47750390c7e83145b52d"], "tags": []}, {"author": "Roger Yang \u003croyang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077163 - Turn IP protection location feature on by default. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330150\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/IPProtectionFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt"], "git_node": "9c2c3cf641aca0dd8e914123ee65306233fbbbe4", "git_parents": ["46aa89fa43bf048e1cdcc3b711a9933b87e05727"], "node": "d9b157c9b969e36de65ed0f71f8e0910d8791542", "parents": ["0c868ae7b2d7c88749c4c142878558b9f78e9f17"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077071 - Open the bug-filing skill's prefilled form without confirming the draft first. r=ai4dev-reviewers,marco DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330104\n", "files": [".agents/skills/bug-filing/SKILL.md", ".claude/skills/bug-filing/SKILL.md"], "git_node": "3707b8b27ec95e67597ebf4f4aa5e7cf0608b649", "git_parents": ["9c2c3cf641aca0dd8e914123ee65306233fbbbe4"], "node": "15157aaf702fa0ab8b12fe700b57ebeb50905d29", "parents": ["d9b157c9b969e36de65ed0f71f8e0910d8791542"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2077107 - Use memalign for allocations with alignment \u003e 8 when mozjemalloc is not enabled. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330264\n", "files": ["mozglue/static/rust/lib.rs"], "git_node": "f6a4240079f33f8291c748952443636d42c8960d", "git_parents": ["3707b8b27ec95e67597ebf4f4aa5e7cf0608b649"], "node": "ea63c2aedc9ab6f1db9b7cfacfe0050e52298dd5", "parents": ["15157aaf702fa0ab8b12fe700b57ebeb50905d29"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1959232 - Enable WebRender layer compositor even when hardware stretching is not supported r=gfx-reviewers,bradwerth\n\nThe artifact happened between DC tiles when hardware stretching is not supported. Layer compositor does not use the DC tiles. Then layer compositor could be enabled without hardware stretching support.\n\nThis change enabled the WebRender layer compositor usage in a lot of CI tests on Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330139\n", "files": ["gfx/config/gfxConfigManager.cpp", "gfx/config/gfxConfigManager.h", "gfx/tests/gtest/TestConfigManager.cpp", "gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/RenderCompositor.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "d68e4734f1ed18428ea0f057a1394bededc0c9ac", "git_parents": ["f6a4240079f33f8291c748952443636d42c8960d"], "node": "498fc9ab45299e612ff375fd0a9bb054691b4be5", "parents": ["ea63c2aedc9ab6f1db9b7cfacfe0050e52298dd5"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075807 - Fall back to HTTP/2 on NS_ERROR_NET_HTTP3_PROTOCOL_ERROR r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329777\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/test/http3server/src/main.rs", "netwerk/test/unit/test_http3_protocol_error_fallback.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "c3e44a294a1aeafa599740aa9a2280ea6aaef6f4", "git_parents": ["d68e4734f1ed18428ea0f057a1394bededc0c9ac"], "node": "680a4b60586c963fc52fbba0761a9c7715a6dea7", "parents": ["498fc9ab45299e612ff375fd0a9bb054691b4be5"], "tags": []}, {"author": "Charlie Humphreys \u003cchumphreys@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072733: Vendor in v70.2.1 of Glean r=chutten,supply-chain-reviewers,mach-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330014\n", "files": ["Cargo.lock", "Cargo.toml", "gfx/wr/Cargo.lock", "gfx/wr/Cargo.toml", "gradle/libs.versions.toml", "python/sites/mach.txt", "supply-chain/imports.lock", "third_party/rust/glean-core/.cargo-checksum.json", "third_party/rust/glean-core/.cargo_vcs_info.json", "third_party/rust/glean-core/Cargo.lock", "third_party/rust/glean-core/Cargo.toml", "third_party/rust/glean-core/Cargo.toml.orig", "third_party/rust/glean-core/src/database/mod.rs", "third_party/rust/glean-core/src/database/rkv.rs", "third_party/rust/glean-core/src/database/sqlite.rs", "third_party/rust/glean-core/src/lib.rs", "third_party/rust/glean-core/src/lib_unit_tests.rs", "third_party/rust/glean-core/src/metrics/ping.rs", "third_party/rust/glean-core/src/upload/mod.rs", "third_party/rust/glean-core/tests/sqlite.rs", "third_party/rust/glean-core/tests/storage.rs", "third_party/rust/glean/.cargo-checksum.json", "third_party/rust/glean/.cargo_vcs_info.json", "third_party/rust/glean/Cargo.lock", "third_party/rust/glean/Cargo.toml", "third_party/rust/glean/Cargo.toml.orig"], "git_node": "fb06248cfdb25022850502312f05723d3022e4a9", "git_parents": ["c3e44a294a1aeafa599740aa9a2280ea6aaef6f4"], "node": "595e3b6b0e0b5c75aa0a9ec631968baf18b27804", "parents": ["680a4b60586c963fc52fbba0761a9c7715a6dea7"], "tags": []}, {"author": "Charlie Humphreys \u003cchumphreys@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072733: add methods to Glean to enable/get/clear stored submitted pings r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326723\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "toolkit/components/glean/src/init/mod.rs", "toolkit/components/glean/src/lib.rs", "toolkit/components/glean/tests/test_pings.yaml", "toolkit/components/glean/tests/xpcshell/test_FOGStoredSubmittedPings.js", "toolkit/components/glean/tests/xpcshell/xpcshell.toml", "toolkit/components/glean/xpcom/FOG.cpp", "toolkit/components/glean/xpcom/nsIFOG.idl"], "git_node": "1065372722bffedca8b9647eeee65b60e6fe3aa8", "git_parents": ["fb06248cfdb25022850502312f05723d3022e4a9"], "node": "d0972486ef3717fc3ffdffbbf86199cfb4307588", "parents": ["595e3b6b0e0b5c75aa0a9ec631968baf18b27804"], "tags": []}, {"author": "Charlie Humphreys \u003cchumphreys@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072734: Display stored submitted pings in about:glean r=TravisLong,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326961\n", "files": ["toolkit/content/aboutGlean.css", "toolkit/content/aboutGlean.html", "toolkit/content/aboutGlean.js", "toolkit/locales/en-US/toolkit/about/aboutGlean.ftl"], "git_node": "38a467de332dadc834836ce779207ca536e3980d", "git_parents": ["1065372722bffedca8b9647eeee65b60e6fe3aa8"], "node": "d1b75b6b88d828f80cc9d7b88e1cf93f4d61e5bd", "parents": ["d0972486ef3717fc3ffdffbbf86199cfb4307588"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075751 - Describe the bundled npm code in the SBOM r=firefox-build-system-reviewers,ahochheiden\n\nwebpack folds React, Redux and Fluent into the newtab, aboutwelcome and\nasrouter bundles, so those packages had no component and no pkg:npm purl.\n\nsbom_npm.py reads the lockfiles listed in its SHIPPED_MANIFESTS allowlist\n(third_party/node, browser/components/aboutwelcome and\nbrowser/components/asrouter), in package-lock.json v2/v3 or pnpm-lock.yaml v9\nformat, and reports the runtime closure only: each package becomes a component\nwith a pkg:npm purl, the lockfile's SHA-512 and the license from the\nchecked-in package.json. Its bom-ref is npm:\u003cname\u003e@\u003cversion\u003e.\n\nVendored libraries that are also published on npm can declare it in moz.yaml\nwith `origin: npm-name`, which gives them a pkg:npm purl. Both are documented\nin the \"What Becomes a Component\" and identity sections of\npython/mozbuild/mozbuild/vendor/docs/licensing.md.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329132\n", "files": ["python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_generate_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_npm.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "python/mozbuild/mozbuild/vendor/docs/template.yaml", "python/mozbuild/mozbuild/vendor/moz_yaml.py", "python/mozbuild/mozbuild/vendor/sbom.py", "python/mozbuild/mozbuild/vendor/sbom_npm.py", "third_party/js/PKI.js/moz.yaml", "third_party/js/prosemirror/prosemirror-commands/moz.yaml", "third_party/js/prosemirror/prosemirror-history/moz.yaml", "third_party/js/prosemirror/prosemirror-keymap/moz.yaml", "third_party/js/prosemirror/prosemirror-markdown/moz.yaml", "third_party/js/prosemirror/prosemirror-model/moz.yaml", "third_party/js/prosemirror/prosemirror-schema-basic/moz.yaml", "third_party/js/prosemirror/prosemirror-state/moz.yaml", "third_party/js/prosemirror/prosemirror-suggestions/moz.yaml", "third_party/js/prosemirror/prosemirror-transform/moz.yaml", "third_party/js/prosemirror/prosemirror-view/moz.yaml"], "git_node": "787eed23012b8593614894cc5073939d8ccd53cc", "git_parents": ["38a467de332dadc834836ce779207ca536e3980d"], "node": "a1caff08effce739a073e06fcb18ecc480d00845", "parents": ["d1b75b6b88d828f80cc9d7b88e1cf93f4d61e5bd"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075752 - Write GeckoView's resolved Gradle runtime dependencies for the SBOM r=mach-reviewers,ahochheiden\n\nThe AndroidX, Play services and other libraries Gradle fetches are packaged\ninto every application embedding GeckoView, and only Gradle knows which ones\nthe published variant resolves.\n\nThe writeRuntimeDependencies task, of the WriteRuntimeDependencies type the\nconventions plugin defines so that Fenix can register it too, runs during\n`mach android export` when MOZ_GENERATE_SBOM is set and writes the resolved\nruntime closure of the published variant to\ngradle/build/mobile/android/geckoview/sbom/runtime-dependencies.json in the\nobjdir: a JSON object with a `components` list of\n{group, name, version, files, dependencies}. Nothing reads it yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329425\n", "files": ["mobile/android/geckoview/build.gradle", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/WriteRuntimeDependencies.kt", "mobile/android/mach_commands.py"], "git_node": "79ef546954779c5a747ad9c4c562315838620c75", "git_parents": ["787eed23012b8593614894cc5073939d8ccd53cc"], "node": "070dce7bffcb8359d33c4087c6d6b67908d4f8d2", "parents": ["a1caff08effce739a073e06fcb18ecc480d00845"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075752 - Map GeckoView's Gradle runtime dependencies onto SBOM records r=mach-reviewers,ahochheiden\n\nsbom_gradle.py reads the runtime-dependencies.json the writeRuntimeDependencies\ntask writes and turns each entry into a pkg:maven record with the artifact's\nSHA-256, the POM's licenses, following the parent chain where the POM declares\nnone, and the edges; its bom-ref is maven:\u003cgroup\u003e:\u003cname\u003e@\u003cversion\u003e. What it\ncannot read -- a missing POM or artifact, an artifact with a classifier only --\nis reported in a property rather than skipped. The SBOM does not use it yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329426\n", "files": ["python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_vendor_sbom_gradle.py", "python/mozbuild/mozbuild/vendor/sbom_gradle.py"], "git_node": "3a50540788fd256e372700c605814f34dc5e0ebe", "git_parents": ["79ef546954779c5a747ad9c4c562315838620c75"], "node": "b7af3587fd0997693ebe95055f03fa809844f93f", "parents": ["070dce7bffcb8359d33c4087c6d6b67908d4f8d2"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075752 - Describe GeckoView's Maven dependencies in the SBOM r=ahochheiden\n\nThe AndroidX, Play services and other libraries Gradle fetches are packaged\ninto every application embedding GeckoView, yet the Android SBOM described\nnone of them.\n\nOn an Android build, generate_sbom.py now adds the records sbom_gradle.py\nbuilds from the runtime-dependencies.json the Gradle export wrote earlier in\nthe same build, and sbom.json depends on that export. A missing or unreadable\nfile fails the build under --strict, since the document would otherwise\ndescribe less than the AAR brings in.\n\nThis is documented in the \"What Becomes a Component\" section of\npython/mozbuild/mozbuild/vendor/docs/licensing.md.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329133\n", "files": ["mobile/android/mach_commands.py", "moz.build", "python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/test/test_generate_sbom.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md"], "git_node": "8a73dea47a0f0573209d67d1adf875d97bafd90c", "git_parents": ["3a50540788fd256e372700c605814f34dc5e0ebe"], "node": "133ff73958c534c4641e1622a5bc4f497d6f3af6", "parents": ["b7af3587fd0997693ebe95055f03fa809844f93f"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075752 - Publish an SBOM for the shipping Fenix builds r=mach-reviewers,taskgraph-reviewers,ahochheiden,ahal\n\nFenix is built by Gradle alone in the build-apk tasks, which never run the\nbuild that generates sbom.json, so nothing described what its APKs package.\n\nFenix registers the runtime closure task per variant, and `mach sbom\n--gradle-runtime-dependencies` turns that closure into a document of its own,\nin which GeckoView is one component that its own SBOM describes. The nightly,\nbeta and release APK builds publish it as public/build/sbom.json: the bundle\ntasks package the same variants, and the Firebase test builds ship nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329134\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/WriteRuntimeDependencies.kt", "python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_gradle.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "python/mozbuild/mozbuild/vendor/sbom_gradle.py", "taskcluster/android_taskgraph/transforms/build_android_app.py"], "git_node": "7307f5e2345134ac9378a24d1643f0e1628bbe3b", "git_parents": ["8a73dea47a0f0573209d67d1adf875d97bafd90c"], "node": "831e7babd0024cd215f0ddb2993318379d271a05", "parents": ["133ff73958c534c4641e1622a5bc4f497d6f3af6"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075753 - Add a build tooling SBOM for what builds and tests the tree r=mach-reviewers,ahochheiden\n\nThe product SBOM describes what ships, so the third-party code the tree only\nruns to build and test the product -- webpack, babel, the harnesses -- is left\nout on purpose, although it is as much a supply-chain input.\n\n`mach sbom --build-tooling` describes it in a document of its own, with the\nsame root and identifiers, the pre-build, build and post-build lifecycles in\nits metadata -- the harnesses run once the product is built -- every component\nscoped `excluded` and a serial number distinct from the product document's. It\nstarts with the npm packages of the lockfiles the product document already\nreads that are not in the runtime closure. The build does not generate it and\nautomation does not publish it yet.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329135\n", "files": ["python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/licensing_commands.py", "python/mozbuild/mozbuild/test/test_generate_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_cyclonedx.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_npm.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "python/mozbuild/mozbuild/vendor/sbom_cyclonedx.py", "python/mozbuild/mozbuild/vendor/sbom_npm.py"], "git_node": "5fc1d5d43c4f441f1e06feb0ce97bd3ee6936c12", "git_parents": ["7307f5e2345134ac9378a24d1643f0e1628bbe3b"], "node": "cfc6b3b40ca90062a3549e120fe80031997d98ea", "parents": ["831e7babd0024cd215f0ddb2993318379d271a05"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075753 - Describe the vendored Python packages in the build tooling SBOM r=mach-reviewers,ahochheiden\n\nThe 96 packages under third_party/python are what mach, the build system and\nthe test harnesses run on. None ships in the product, so they go to the build\ntooling document rather than the product one.\n\nsbom_python.py reads third_party/python/uv.lock for the versions, the pkg:pypi\npurls, the edges and the SHA-256 of the archive `mach vendor python` unpacked,\nwhich is the pure wheel where one exists and the sdist otherwise. The licenses\ncome from the vendored copy's metadata. A package that declares none, or whose\nmetadata cannot be read, says so in a property.\n\nThe packages `mach vendor python` leaves alone and uv.lock does not name --\ndlmanager, filelock, gyp and vsdownload -- are described from their moz.yaml or\ntheir own metadata, and vsdownload's moz.yaml no longer puts it in the product\ndocument.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329136\n", "files": ["python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_generate_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_python.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "python/mozbuild/mozbuild/vendor/sbom_python.py"], "git_node": "11d57b3d3a7b8d75cd84114c882ad49097e5f8d4", "git_parents": ["5fc1d5d43c4f441f1e06feb0ce97bd3ee6936c12"], "node": "831f67cd52c117c7d00b497a8dfdc6204ba95c00", "parents": ["cfc6b3b40ca90062a3549e120fe80031997d98ea"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075753 - Move the test and tooling crates to the build tooling SBOM r=mach-reviewers,ahochheiden\n\nThe product SBOM listed as shipped every crate the workspace reaches other\nthan as a dev dependency, which includes what only its test servers, test\nmodules and code generators build: hyper, tokio and warp for the http3server\nand geckodriver, and the test-only crates such as mockall.\n\nThe walk now starts from the shipped roots, with the members that only build\nor test the product listed in TOOLING_MEMBERS. The 56 crates reached only as\ndev or tooling dependencies go to the build tooling document instead. Without\ncargo metadata, in an unconfigured tree, nothing can be told apart, so every\ncrate stays in the product document.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329137\n", "files": ["python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/test/test_generate_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_cargo.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_python.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "python/mozbuild/mozbuild/vendor/sbom_cargo.py", "python/mozbuild/mozbuild/vendor/sbom_cyclonedx.py"], "git_node": "90d000f96b5c84796a301fd03529d97eb63a1e93", "git_parents": ["11d57b3d3a7b8d75cd84114c882ad49097e5f8d4"], "node": "55d1ec4ed61820fbce25a1686526d24c528569c8", "parents": ["831f67cd52c117c7d00b497a8dfdc6204ba95c00"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2075753 - Publish the build tooling SBOM from the shippable builds r=firefox-build-system-reviewers,ahochheiden\n\n`mach sbom --build-tooling` was only run by hand. The builds that set\nMOZ_GENERATE_SBOM now also generate `sbom-build-tooling.json` next to\n`sbom.json`, and upload it as `public/build/sbom-build-tooling.json`.\n\nThe build generates it strictly: without `cargo metadata`, the test and tooling\ncrates cannot be told apart from the shipped ones and would silently be left\nout, so the build fails instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329403\n", "files": ["moz.build", "python/mozbuild/mozbuild/action/generate_sbom.py", "python/mozbuild/mozbuild/test/test_generate_sbom.py", "python/mozbuild/mozbuild/test/test_vendor_sbom_cargo.py", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "python/mozbuild/mozbuild/vendor/sbom_cargo.py", "toolkit/mozapps/installer/upload-files.mk"], "git_node": "b2c73f214ea5b30094ae57470f0d8a4fe1e15c25", "git_parents": ["90d000f96b5c84796a301fd03529d97eb63a1e93"], "node": "7e6a37f6364370b93148756b1e37424238f1e587", "parents": ["55d1ec4ed61820fbce25a1686526d24c528569c8"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2077173 - Implement htmlaccel on LoongArch64 platforms with LSX intrinsics. r=dom-core-reviewers,hsivonen\n\nThe semantics are mostly kept in line with the SSE implementation,\nfollowing the migration guide by Jiajie Chen.\n\nLink:\n https://jia.je/unofficial-loongarch-intrinsics-guide/migrating_sse/\n (\"Migrating from SSE to LSX\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330149\n", "files": ["build/moz.configure/toolchain.configure", "parser/html/moz.build", "parser/html/nsHtml5TokenizerLoopPoliciesSIMD.h", "parser/htmlaccel/gtest/moz.build", "parser/htmlaccel/htmlaccel.h", "parser/htmlaccel/htmlaccelEnabled.h", "parser/htmlaccel/moz.build"], "git_node": "9c72e81acde2cf521b82082b59456c61014fdcb7", "git_parents": ["b2c73f214ea5b30094ae57470f0d8a4fe1e15c25"], "node": "46358c5377535f659dfa80ae7fbf0970739bec84", "parents": ["7e6a37f6364370b93148756b1e37424238f1e587"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2077374 - Add missing MOZ_RUNINIT attributes to global vars in mozglue/build/{mips,ppc}.cpp. r=glandium\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330303\n", "files": ["mozglue/build/mips.cpp", "mozglue/build/ppc.cpp"], "git_node": "43e119e37823f61b2d1f678b5be0f10c073a7fb8", "git_parents": ["9c72e81acde2cf521b82082b59456c61014fdcb7"], "node": "d4d6e350bc08ca11b7768c2ea94738c1ad9f6139", "parents": ["46358c5377535f659dfa80ae7fbf0970739bec84"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2077031. Don't copy the whole spec of every image URI when collecting image memory reports. r=gfx-reviewers,lsalzman\n\nhttps://searchfox.org/firefox-main/rev/66b70484481af2e01d4da8bb33f4a756aba77d74/image/Image.cpp#77\n\nWe copy the full spec into every ImageMemoryCounter and only truncate it to 256\ncharacters, or throw it away when anonymizing, after all the counters have been\ncreated. We don't need to keep them all around.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330262\n", "files": ["image/Image.cpp", "image/Image.h", "image/imgLoader.cpp"], "git_node": "b104f902c0fe268a8b0e1ca055716c52fcf9a8d1", "git_parents": ["43e119e37823f61b2d1f678b5be0f10c073a7fb8"], "node": "30a64e42c8e2b2454be39b116ce3e60f1396920a", "parents": ["d4d6e350bc08ca11b7768c2ea94738c1ad9f6139"], "tags": []}], "date": 1790933918, "git_changesets": ["c184904ad87b0498042b252281ae25bcc04929e2", "46aa89fa43bf048e1cdcc3b711a9933b87e05727", "9c2c3cf641aca0dd8e914123ee65306233fbbbe4", "3707b8b27ec95e67597ebf4f4aa5e7cf0608b649", "f6a4240079f33f8291c748952443636d42c8960d", "d68e4734f1ed18428ea0f057a1394bededc0c9ac", "c3e44a294a1aeafa599740aa9a2280ea6aaef6f4", "fb06248cfdb25022850502312f05723d3022e4a9", "1065372722bffedca8b9647eeee65b60e6fe3aa8", "38a467de332dadc834836ce779207ca536e3980d", "787eed23012b8593614894cc5073939d8ccd53cc", "79ef546954779c5a747ad9c4c562315838620c75", "3a50540788fd256e372700c605814f34dc5e0ebe", "8a73dea47a0f0573209d67d1adf875d97bafd90c", "7307f5e2345134ac9378a24d1643f0e1628bbe3b", "5fc1d5d43c4f441f1e06feb0ce97bd3ee6936c12", "11d57b3d3a7b8d75cd84114c882ad49097e5f8d4", "90d000f96b5c84796a301fd03529d97eb63a1e93", "b2c73f214ea5b30094ae57470f0d8a4fe1e15c25", "9c72e81acde2cf521b82082b59456c61014fdcb7", "43e119e37823f61b2d1f678b5be0f10c073a7fb8", "b104f902c0fe268a8b0e1ca055716c52fcf9a8d1"], "user": "abutkovits@mozilla.com"}, "45466": {"changesets": [{"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1959232 - Enable WebRender layer compositor even when hardware stretching is not supported r=gfx-reviewers,bradwerth\" for causing assertion failure at StaticPrefList_gfx.h.\n\nThis reverts commit d68e4734f1ed18428ea0f057a1394bededc0c9ac.\n", "files": ["gfx/config/gfxConfigManager.cpp", "gfx/config/gfxConfigManager.h", "gfx/tests/gtest/TestConfigManager.cpp", "gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/RenderCompositor.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "26a129b91bc2428191eb5b9dbaaab803601fa414", "git_parents": ["b104f902c0fe268a8b0e1ca055716c52fcf9a8d1"], "node": "6ce79a0416258aa1bc3a29e9ccebccdacebf916a", "parents": ["30a64e42c8e2b2454be39b116ce3e60f1396920a"], "tags": []}], "date": 1790934617, "git_changesets": ["26a129b91bc2428191eb5b9dbaaab803601fa414"], "user": "abutkovits@mozilla.com"}, "45467": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 74c50ea0264277e8256ca228c4c809467f89a2e6 with FIREFOX_158_0b3_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "5defefed6cdb1a720b20b0f9fa630e272c16ef05", "git_parents": ["63a4619f4d4ac6dd13827bb15d4e5ce10018c2a8"], "node": "40a3aec284da1857797dd973cfe4894aac20546a", "parents": ["70066e9142f26d889ca61c2ee2278eb6ce84f391"], "tags": []}], "date": 1790946372, "git_changesets": ["5defefed6cdb1a720b20b0f9fa630e272c16ef05"], "user": "ffxbld@lando.moz.tools"}, "45468": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 74c50ea0264277e8256ca228c4c809467f89a2e6 with FIREFOX-ANDROID_158_0b3_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "7c714bfb0081d394131a195bb24f1b9a2d0f3caf", "git_parents": ["5defefed6cdb1a720b20b0f9fa630e272c16ef05"], "node": "f88a826721e4a5da1f74a7898d7c107f14c7f46e", "parents": ["40a3aec284da1857797dd973cfe4894aac20546a"], "tags": []}], "date": 1790946469, "git_changesets": ["7c714bfb0081d394131a195bb24f1b9a2d0f3caf"], "user": "ffxbld@lando.moz.tools"}, "45469": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 74c50ea0264277e8256ca228c4c809467f89a2e6 with DEVEDITION_158_0b3_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "f845d8ede6ce3d18686d23f7ac4617191f5696b3", "git_parents": ["7c714bfb0081d394131a195bb24f1b9a2d0f3caf"], "node": "5fb8cd399b4905a2ca469138113f2a076715c30a", "parents": ["f88a826721e4a5da1f74a7898d7c107f14c7f46e"], "tags": []}], "date": 1790946550, "git_changesets": ["f845d8ede6ce3d18686d23f7ac4617191f5696b3"], "user": "ffxbld@lando.moz.tools"}, "45470": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 74c50ea0264277e8256ca228c4c809467f89a2e6 with FIREFOX-ANDROID_158_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "d7b8b0533df45217a56db5c5429901b6aaceabd2", "git_parents": ["f845d8ede6ce3d18686d23f7ac4617191f5696b3"], "node": "a4897f5c47dd7fba7d13471cc81178e74e8d1780", "parents": ["5fb8cd399b4905a2ca469138113f2a076715c30a"], "tags": []}], "date": 1790947951, "git_changesets": ["d7b8b0533df45217a56db5c5429901b6aaceabd2"], "user": "ffxbld@lando.moz.tools"}, "45471": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 74c50ea0264277e8256ca228c4c809467f89a2e6 with FIREFOX_158_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "19ea0bf6c98e863e9df2daf5bf13a502597a809f", "git_parents": ["d7b8b0533df45217a56db5c5429901b6aaceabd2"], "node": "4fce51bd0899a4b8005aeacb24cd37a9102dad41", "parents": ["a4897f5c47dd7fba7d13471cc81178e74e8d1780"], "tags": []}], "date": 1790957359, "git_changesets": ["19ea0bf6c98e863e9df2daf5bf13a502597a809f"], "user": "ffxbld@lando.moz.tools"}, "45472": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 74c50ea0264277e8256ca228c4c809467f89a2e6 with DEVEDITION_158_0b3_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "86b0d1d285678a58dc4eb1985d1fc4c413faa532", "git_parents": ["19ea0bf6c98e863e9df2daf5bf13a502597a809f"], "node": "dec48190f2dec95365653d755ba04ab23037eab4", "parents": ["4fce51bd0899a4b8005aeacb24cd37a9102dad41"], "tags": []}], "date": 1790957916, "git_changesets": ["86b0d1d285678a58dc4eb1985d1fc4c413faa532"], "user": "ffxbld@lando.moz.tools"}, "45473": {"changesets": [{"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2067742 - Update ffvpx Vulkan Video sources with FFmpeg ebb6f28da5. r=stransky,media-playback-reviewers\n\nTake Vulkan video sources from FFmpeg ebb6f28da5 (libavcodec 63.14.100,\nlibavutil 61.7.100; Ampere COINCIDE-only init fix). The rest of ffvpx,\nincluding version.h, stays 9.0.1 (libavcodec 63.1.101, libavutil\n61.1.101). Drop av1_tilesize.patch (that change is already upstream).\nUse rand() for vulkan.c exec-pool queue-phase seeding instead of\nav_get_random_seed() (same as parseutils-no-random-seed.patch; do not\ncompile random_seed.c/sha.c). Add uuid.c for hwcontext_vulkan.c's\nav_uuid_parse. Comment out h264dec.h in vulkan_decode.c (ffvpx does not\nship the H.264 decoder). Replace ff_vk_exec_add_dep_buf in\navutil.symbols with the AVRefStruct exec-dep helpers.\n\nSystem FFmpeg is built with --enable-libdrm, so vulkan_map_from() for\nDRM_PRIME is compiled in. ffvpx left CONFIG_LIBDRM unset. Enable it only\nfor hwcontext_vulkan.c. Reuse widget/gtk va_drmcommon.h through a mozva\nstub, and drmGetDevice from mozdrm.cpp (USE_LIBS nspr so mozavutil waits\nfor in-tree NSPR; OS_LIBS NSPR_LIBS races libmozavutil.so against\nlibplc4.so on linux64-base-toolchains-clang). The mozbuild sysroot does\nnot provide -ldrm.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329759\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/av1_tilesize.patch", "media/ffvpx/config_override.h", "media/ffvpx/libavcodec/vulkan_av1.c", "media/ffvpx/libavcodec/vulkan_decode.c", "media/ffvpx/libavcodec/vulkan_decode.h", "media/ffvpx/libavcodec/vulkan_video.c", "media/ffvpx/libavcodec/vulkan_video.h", "media/ffvpx/libavcodec/vulkan_vp9.c", "media/ffvpx/libavutil/avutil.symbols", "media/ffvpx/libavutil/hwcontext_vulkan.c", "media/ffvpx/libavutil/moz.build", "media/ffvpx/libavutil/uuid.c", "media/ffvpx/libavutil/uuid.h", "media/ffvpx/libavutil/vulkan.c", "media/ffvpx/libavutil/vulkan.h", "media/ffvpx/libavutil/vulkan_functions.h", "media/ffvpx/libavutil/vulkan_loader.h", "media/ffvpx/vulkan-decode-no-h264dec.patch", "media/ffvpx/vulkan-exec-pool-rand.patch", "media/mozva/va/va_drmcommon.h", "third_party/drm/libdrm/mozdrm.cpp"], "git_node": "761d0888115ab8ffb191cfc1be5be35923a1e31e", "git_parents": ["b104f902c0fe268a8b0e1ca055716c52fcf9a8d1"], "node": "608babd060b6a9d86ff6a228856f91d74e0e92bc", "parents": ["30a64e42c8e2b2454be39b116ce3e60f1396920a"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1959232 - Enable WebRender layer compositor even when hardware stretching is not supported r=gfx-reviewers,bradwerth\" for causing assertion failure at StaticPrefList_gfx.h.\n\nThis reverts commit d68e4734f1ed18428ea0f057a1394bededc0c9ac.\n", "files": ["gfx/config/gfxConfigManager.cpp", "gfx/config/gfxConfigManager.h", "gfx/tests/gtest/TestConfigManager.cpp", "gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/RenderCompositor.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "b69193462d11e1f7ce216098478564356fe549c4", "git_parents": ["761d0888115ab8ffb191cfc1be5be35923a1e31e"], "node": "59d1f0eaef0052f7765dc59fc5d1c414cd3e2c72", "parents": ["608babd060b6a9d86ff6a228856f91d74e0e92bc"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2077401 - Remove DCLayerTree::WebRenderOsCompositorKind r=gfx-reviewers,lsalzman\n\nDCLayerTree supports only layer compositor. Then WebRenderOsCompositorKind has only ::WebRenderOsCompositorKind::LayerCompositor now. And WebRenderOsCompositorKind is redundant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330308\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/DCLayerTree.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderCompositorANGLE.h"], "git_node": "38ec93c1dadf76d83e457de0005bfc010de4497d", "git_parents": ["b69193462d11e1f7ce216098478564356fe549c4"], "node": "ff7aad1a17fc59a70efcc83980b1808f9133291f", "parents": ["59d1f0eaef0052f7765dc59fc5d1c414cd3e2c72"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\naf -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nan -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nar -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nast -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\naz -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nbe -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nbg -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nbn -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nbo -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nbqi -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nbr -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nbrx -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nbs -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nca -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nca-valencia -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\ncak -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\nckb -\u003e 533600beb921c78b58b34f78b5bc4c111ca12dfc\ncs -\u003e 533600beb921c78b58b34f78