here are profiles, reuse the symbols mozharness already unpacked into --symbols-path instead of unpacking them again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329236\n", "files": ["testing/mochitest/runtests.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "1fe2f8001f26e5432ab8f6d351373623534ed3ea", "git_parents": ["afcc3817b958b6dc0544d12cf8a0d4e089348327"], "node": "cadfd6c88f7a8a76fda8259cc8bcc56c964f02ab", "parents": ["98cd018e505d2952f0ee85798a029cbba82529e8"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062591 - Remove legacy securityuiprotectionspopup_click probes r=emz,TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318387\n", "files": ["browser/base/content/metrics.yaml", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI.js", "browser/base/content/test/browser-protectionsUI/browser_protectionsUI_milestones.js", "browser/base/content/test/browser-protectionsUI/head.js", "toolkit/components/telemetry/Events.yaml", "toolkit/components/telemetry/tests/python/test_mirrors.py"], "git_node": "6bb3c1768bb258b9f702818462ca2c62766906ea", "git_parents": ["1fe2f8001f26e5432ab8f6d351373623534ed3ea"], "node": "1a9d3f33bbd204a20ff044066d7f829252c0fd9c", "parents": ["cadfd6c88f7a8a76fda8259cc8bcc56c964f02ab"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079072. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331502\n", "files": ["dom/canvas/ClientWebGLContext.cpp"], "git_node": "6a19c1ce009f7f01a384be2668ae27f036274e83", "git_parents": ["6bb3c1768bb258b9f702818462ca2c62766906ea"], "node": "5f3027f4fd391411b55299ee80706e67af45d2d8", "parents": ["1a9d3f33bbd204a20ff044066d7f829252c0fd9c"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079056 - Update freetype2 to d5d4bef0c6d5363931d346a6b2380317a32b8601 r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331470\n", "files": ["modules/freetype2/moz.yaml", "modules/freetype2/src/truetype/ttinterp.c"], "git_node": "d85873b06d12c682f8a95f42280bc0fb4df9fe07", "git_parents": ["6a19c1ce009f7f01a384be2668ae27f036274e83"], "node": "531914ef46835556ac6d6a8b4f229425a2f5cf7f", "parents": ["5f3027f4fd391411b55299ee80706e67af45d2d8"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1668766 - Let bugbug select 'when: files-changed' tasks in mach try auto. r=taskgraph-reviewers,bhearsum\n\nThese tasks (e.g. linux64-shell-haz/debug) only ran when their file patterns\nmatched. Bugbug can now select them on top of that.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331104\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py"], "git_node": "a46f56e1a9f6438f05e23e153537ea9c91e5d4a6", "git_parents": ["d85873b06d12c682f8a95f42280bc0fb4df9fe07"], "node": "29acdd3a09608ce0f50db24c985b5ed037fca56c", "parents": ["531914ef46835556ac6d6a8b4f229425a2f5cf7f"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1668766 - Let bugbug select skip-unless-backstop tasks in mach try auto. r=taskgraph-reviewers,bhearsum\n\nThese tasks (e.g. linux64-haz/debug) were never scheduled by mach try auto.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331105\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py"], "git_node": "eb47c3c6f594dd7bf9031bc8c2b7e0dfd07433d9", "git_parents": ["a46f56e1a9f6438f05e23e153537ea9c91e5d4a6"], "node": "f65f6afb909c18dce5f37b1b14dfcfea059775af", "parents": ["29acdd3a09608ce0f50db24c985b5ed037fca56c"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077418 - [devtools] Escape selector in messageGetMatchingElements. r=devtools-reviewers,jdescottes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331508\n", "files": ["devtools/client/webconsole/actions/messages.js"], "git_node": "b67d49d4c6ab7b6086dd8f60a1002da981890501", "git_parents": ["eb47c3c6f594dd7bf9031bc8c2b7e0dfd07433d9"], "node": "a7f6c481b02a0bfb92196e928d9d5071561e0e57", "parents": ["f65f6afb909c18dce5f37b1b14dfcfea059775af"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079072. r=gfx-reviewers,nical\" for causing build bustages at ClientWebGLContext.cpp\n\nThis reverts commit 6a19c1ce009f7f01a384be2668ae27f036274e83.\n", "files": ["dom/canvas/ClientWebGLContext.cpp"], "git_node": "65175e0465fbd55f3900dc06a091d73343b32383", "git_parents": ["b67d49d4c6ab7b6086dd8f60a1002da981890501"], "node": "465c115996e7a845a9e600244fde72adc3dec731", "parents": ["a7f6c481b02a0bfb92196e928d9d5071561e0e57"], "tags": []}, {"author": "Arnaud Bienner \u003cabienner@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078614 - Move the nsIContent code out of FragmentOrElement.cpp, to a new dedicated nsIContent.cpp file. r=smaug,dom-core-reviewers\n\nThis was moved to nsIContent in bug 1449404, but kept in FragmentOrElement.cpp file.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331211\n", "files": ["dom/base/Attr.cpp", "dom/base/DOMArena.h", "dom/base/DocumentFragment.cpp", "dom/base/FragmentOrElement.cpp", "dom/base/FragmentOrElement.h", "dom/base/moz.build", "dom/base/nsIContent.cpp", "dom/base/nsNodeSupportsWeakRefTearoff.cpp", "dom/base/nsNodeSupportsWeakRefTearoff.h"], "git_node": "7c484a19971429195e2730103a79b83ba99e4119", "git_parents": ["65175e0465fbd55f3900dc06a091d73343b32383"], "node": "22d018901148694d5eae92079ec8951b0b0a689d", "parents": ["465c115996e7a845a9e600244fde72adc3dec731"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079154 - Update metadata for css/css-page/page-name-002-print.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331527\n", "files": ["testing/web-platform/meta/css/css-page/page-name-002-print.html.ini"], "git_node": "39b9106e919558afb75ce0d287f5aa6432ead74f", "git_parents": ["7c484a19971429195e2730103a79b83ba99e4119"], "node": "e392b230ec9a9fd05a7e78a7c21b9348fc1d4ba7", "parents": ["22d018901148694d5eae92079ec8951b0b0a689d"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2068764 - [Linux][Vulkan Video] Cap NVIDIA ffvpx compute queues like graphics. r=media-playback-reviewers,stransky\n\nPICK_QF already limits graphics to 1 when limit_queues is unset. Compute\nstill used the full family count (often 8), which dominates vkCreateDevice.\n\nDecode does not need the extra compute queues. Compute is only a layout and\nDMA-BUF export barrier (barrier + SYNC_FD). lavu's compute_exec pool is\n2-deep of microsecond submits. One queue is enough, including multi-stream.\nTwo only avoids sharing the QueueSubmit mutex between those two pool slots;\nit does not increase decode throughput.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324924\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/libavutil/hwcontext_vulkan.c", "media/ffvpx/nvidia-compute-queue-cap.patch"], "git_node": "ab5298178f346c05a8b28ec648bdbffe9fd727b2", "git_parents": ["39b9106e919558afb75ce0d287f5aa6432ead74f"], "node": "fb24152b2dca3603bed3e7a036964f9c7f4b3c87", "parents": ["e392b230ec9a9fd05a7e78a7c21b9348fc1d4ba7"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2071998 - Fix stale-while-revalidate refreshes for HTTP redirects r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328941\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/unit/test_stale-while-revalidate_redirect.js", "netwerk/test/unit/xpcshell.toml", "netwerk/test/unit_ipc/child_stale-while-revalidate_redirect.js", "netwerk/test/unit_ipc/test_stale-while-revalidate_redirect.js", "netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "b302823797363dbc08fa556f48a142e3378aa8fc", "git_parents": ["ab5298178f346c05a8b28ec648bdbffe9fd727b2"], "node": "964495d447a7478b740da9132d5b499ef52a3f47", "parents": ["fb24152b2dca3603bed3e7a036964f9c7f4b3c87"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048634 - Update metadata for screen-capture/getdisplaymedia-framerate.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331526\n", "files": ["testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini"], "git_node": "e81eb9dd55fd724946db65503569cb3778fb3bc4", "git_parents": ["b302823797363dbc08fa556f48a142e3378aa8fc"], "node": "ba28b925cdec5cfb32206ecd531f6f8d14f5da06", "parents": ["964495d447a7478b740da9132d5b499ef52a3f47"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077432 - Keep the urlbar-ipc test variant running indefinitely. r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330321\n", "files": ["taskcluster/test_configs/variants.yml"], "git_node": "bb0c30efca2317c27e3edddf14cb751f54baec1d", "git_parents": ["e81eb9dd55fd724946db65503569cb3778fb3bc4"], "node": "2bb9ff133bf77671e8c28002cb1fd621d639e73b", "parents": ["ba28b925cdec5cfb32206ecd531f6f8d14f5da06"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079072. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331502\n", "files": ["dom/canvas/ClientWebGLContext.cpp"], "git_node": "607059d3818770b996709b8ca7f6fcff2045b517", "git_parents": ["bb0c30efca2317c27e3edddf14cb751f54baec1d"], "node": "c986ca397bbb8f5dc2cf59a4cf05bf7a388b929d", "parents": ["2bb9ff133bf77671e8c28002cb1fd621d639e73b"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079179 - Update metadata for content-security-policy/inside-worker/dedicatedworker-connect-src.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331542\n", "files": ["testing/web-platform/meta/content-security-policy/inside-worker/dedicatedworker-connect-src.html.ini"], "git_node": "2fde41a3fbd8d91d36dd00a185e78c5e5ab45525", "git_parents": ["607059d3818770b996709b8ca7f6fcff2045b517"], "node": "89f53dbab4d6375784646e92376355c22eb0b542", "parents": ["c986ca397bbb8f5dc2cf59a4cf05bf7a388b929d"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074885 - Index included manifest runtimes once in resolve_manifest_runtimes. r=taskgraph-reviewers,bhearsum\n\nScanning every runtime key for each manifest made the function quadratic, and it is called twice per test task.\n\nLocally (`./mach taskgraph full -j 8` with the parameters of a try\ndecision task), the mochitest kind finishes about 3.4s sooner (23.3s\ninstead of 26.7s). The full task set isn't faster yet, as\nweb-platform-tests is still the slowest kind.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328551\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/test/test_util_chunking.py", "taskcluster/gecko_taskgraph/transforms/test/chunk.py", "taskcluster/gecko_taskgraph/util/chunking.py"], "git_node": "25fb67aed6de616cf401701124d5695b8d82960b", "git_parents": ["2fde41a3fbd8d91d36dd00a185e78c5e5ab45525"], "node": "adf60aa0201577c17b3e9494b30f7742815edf18", "parents": ["89f53dbab4d6375784646e92376355c22eb0b542"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074885 - Avoid redundant work when computing the test manifests of a task. r=taskgraph-reviewers,bhearsum\n\nThe web-platform-tests manifests only depend on the suite, subsuite and tags, so compute them once per combination rather than for every mozinfo.\n\nLocally (`./mach taskgraph full -j 8` with the parameters of a try\ndecision task), the web-platform-tests kind finishes about 5.5s sooner\n(22.4s instead of 27.9s), so the full task set takes 26.1s instead of\n29.6s.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328552\n", "files": ["taskcluster/gecko_taskgraph/util/chunking.py"], "git_node": "8ef370ea02dc5aa47311c62fd29b28cf9a2a39d8", "git_parents": ["25fb67aed6de616cf401701124d5695b8d82960b"], "node": "5e06580acfe73328d8ebbff40d5241ff4c965b1f", "parents": ["adf60aa0201577c17b3e9494b30f7742815edf18"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074555 - Switch dead code for an assert r=dom-core-reviewers,smaug\n\nzcorpan pointed out that this code can never run [1], so I switched for an\nassert instead, and all of our sanitizer tests pass, so I think this is correct.\n\n[1]: https://github.com/whatwg/html/pull/12756#discussion_r4026743249\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328199\n", "files": ["parser/html/nsHtml5TreeBuilderCppSupplement.h"], "git_node": "962f46c0c42c4ea244a3396988f960e056047b4a", "git_parents": ["8ef370ea02dc5aa47311c62fd29b28cf9a2a39d8"], "node": "cf4ffac1b5cf790402d1178345b00c2bc6a036a9", "parents": ["5e06580acfe73328d8ebbff40d5241ff4c965b1f"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2079166 - Shell-split WASM_CFLAGS and WASM_CXXFLAGS in configure. r=firefox-build-system-reviewers,sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331525\n", "files": ["python/mozbuild/mozbuild/test/configure/test_toolkit_moz_configure.py", "toolkit/moz.configure"], "git_node": "0661f02859e8c9018897dbe60911bced51fe1e57", "git_parents": ["962f46c0c42c4ea244a3396988f960e056047b4a"], "node": "2b962ac58bb905693428776447db9fb4f939c401", "parents": ["cf4ffac1b5cf790402d1178345b00c2bc6a036a9"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076694 - Use the confidence thresholds returned by bugbug in the bugbug manifest loader. r=bhearsum,taskgraph-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330951\n", "files": ["taskcluster/gecko_taskgraph/test/test_util_chunking.py", "taskcluster/gecko_taskgraph/util/chunking.py"], "git_node": "15a7df04cf38327d74fba0eeebf0d7d3df56c519", "git_parents": ["0661f02859e8c9018897dbe60911bced51fe1e57"], "node": "67240e824cf149643de3b987888ebf35ba1a9e46", "parents": ["2b962ac58bb905693428776447db9fb4f939c401"], "tags": []}, {"author": "Tymur Boiko \u003ctboiko@nvidia.com\u003e", "branch": "default", "desc": "Bug 2034236 [Linux][Vulkan Video] Default to bundled ffvpx; prefer system FFmpeg only via pref. r=stransky,media-playback-reviewers\n\nffvpx now has Vulkan Video (bug 2067742). Drop the\navcodec_version() \u003e= LIBAVCODEC_VERSION_INT auto-prefer so rolling\ndistros cannot silently win. Edge distros can set\nmedia.hardware-video-decoding-vulkan.prefer-system-ffmpeg.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331214\n", "files": ["dom/media/platforms/PDMFactory.cpp", "dom/media/platforms/PDMFactorySupport.cpp", "dom/media/platforms/ffmpeg/FFmpegRuntimeLinker.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "6073db908ce83077dd605a6164b0e9e4dc7b368d", "git_parents": ["15a7df04cf38327d74fba0eeebf0d7d3df56c519"], "node": "cbbdbfd42ea611f4bd6a3c3bd93df1be45c03b23", "parents": ["67240e824cf149643de3b987888ebf35ba1a9e46"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 1846946 - Update last sync time only when a full sync is successful r=android-reviewers,twhite\n\nSince we are still using one \"last sync time\" to represent the state of sync, we should make sure that this is only applied when a \"full sync\" is performed.\n\nThis timestamp is only shown on the accounts screen, so we want to make sure that it matches the user expectations of the last time \"all\" their data was synced, and not when a specific subset was synced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329607\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt", "mobile/android/android-components/components/service/firefox-accounts/src/test/java/mozilla/components/service/fxa/sync/WorkManagerSyncWorkerTest.kt"], "git_node": "3c71a541b0e7ac6e086907b38670dabca9174c45", "git_parents": ["6073db908ce83077dd605a6164b0e9e4dc7b368d"], "node": "3e41f4d5acb82fde3deb609f1b56189ae671388b", "parents": ["cbbdbfd42ea611f4bd6a3c3bd93df1be45c03b23"], "tags": []}], "date": 1791390342, "git_changesets": ["3facaa8b15bedb6854b6a7333bd2293665c03a6c", "7ee172d42cc21f9f8e20a08bfb8709381574e64c", "e695af1c3af55d4aa2cd12daba8418484b58154c", "64f94487e90a867086670ade7a3ed3573721e337", "67906ef32ac01529c37fcfca9e764c07896e24e3", "6a71d29058dc79b4c83e040e91ba42819a20b12c", "92ff2e2a56ffbcac9f9e85db3c9e35e3cd01200c", "00ee53ad40637476039c3ec8e1c1f13c0cb872f0", "f547b41383342eb7d9f67899772c3d4c155fa7ca", "edac618300dacf88ebc769810dc9b22d0940a49e", "66d701e10d87aed66c717a28b153ac137489408e", "ec3c790c450d0e467b35c3fee73a20d860ac7ad5", "8d117d48960a46c1bf2eddecf45ea900612fd878", "c56d6aa21d083241c93304d7a903fcc34590cd04", "5d6730069fc887b85f76e38e33f09d8ccfd48979", "a9b6bb23e58fb88af23eba40e7ae812529e0f32c", "fd570437f0982ea739b71