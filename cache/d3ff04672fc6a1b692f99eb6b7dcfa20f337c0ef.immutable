ohi/secvfy.c", "security/nss/lib/libpkix/pkix_pl_nss/pki/pkix_pl_nameconstraints.c", "security/nss/lib/nss/nss.def", "security/nss/lib/nss/nss.h", "security/nss/lib/pk11wrap/pk11akey.c", "security/nss/lib/pk11wrap/pk11auth.c", "security/nss/lib/pk11wrap/pk11cxt.c", "security/nss/lib/pk11wrap/pk11mech.c", "security/nss/lib/pk11wrap/pk11obj.c", "security/nss/lib/pk11wrap/pk11pk12.c", "security/nss/lib/pk11wrap/pk11priv.h", "security/nss/lib/pk11wrap/pk11slot.c", "security/nss/lib/pk11wrap/secmodti.h", "security/nss/lib/pki/certificate.c", "security/nss/lib/pki/pki.h", "security/nss/lib/pki/pki3hack.c", "security/nss/lib/pki/trustdomain.c", "security/nss/lib/smime/cmsdigest.c", "security/nss/lib/softoken/lowkey.c", "security/nss/lib/softoken/lowkeyti.h", "security/nss/lib/softoken/pkcs11.c", "security/nss/lib/softoken/pkcs11c.c", "security/nss/lib/softoken/pkcs11u.c", "security/nss/lib/softoken/sftkpwd.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/derdec.c", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/secasn1d.c", "security/nss/lib/util/secoid.c", "security/nss/lib/util/secoidt.h", "security/nss/mach", "security/nss/moz.yaml", "security/nss/nss.gyp", "security/nss/nss/automation/abi-check/new-report-libssl3.so.txt", "security/nss/tests/cert/cert.sh", "security/nss/tests/common/tsan_suppressions.txt", "security/nss/tests/fips/fips.sh", "security/nss/tests/gtests/gtests.sh", "security/nss/tests/tools/openssl-ed25519.p12", "security/nss/tests/tools/tools.sh"], "git_node": "0f05975dac0cd8b66b590eef4b6ac05180243cb7", "git_parents": ["9ffd044c69183014682ec077436029da5b2e9e30"], "node": "4e4844d8890783052a0e95e72d6d6d01ff7f8624", "parents": ["5508de544cdbd1e2e3116a4bca6264b802e1fb8a"], "tags": []}, {"author": "Travis Long \u003ctlong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054532 - Improve nimbus-fml build times. r=nalexander,beth,geckoview-reviewers\n\n`nimbus-fml generate` already validates the manifest, so having every\n`nimbusFeatures*` task depend on `nimbusValidate` parsed it twice per project\nand serialized generation behind it. Drop the dependency, and the task with it\nsince nothing in-tree invoked it.\n\n`assembleNimbusTools` now reuses its version-keyed cache instead of fetching a\nhash file per source to re-verify an archive it already verified, and prunes\nthe caches for other versions, which nothing else collected.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320080\n", "files": ["mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusAssembleToolsTask.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusGradlePlugin.kt", "mobile/android/gradle/plugins/nimbus-gradle-plugin/src/main/kotlin/org/mozilla/appservices/tooling/nimbus/NimbusValidateTask.kt"], "git_node": "6115688103686683cd047586c0ed4d26b5314120", "git_parents": ["0f05975dac0cd8b66b590eef4b6ac05180243cb7"], "node": "871874b34b9732080d018caacc042891ab306401", "parents": ["4e4844d8890783052a0e95e72d6d6d01ff7f8624"], "tags": []}, {"author": "Travis Long \u003ctlong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054532 - Remove redundant nimbus channel mappings. r=nalexander,android-reviewers\n\nThe identity `channels` maps are what the plugin already falls back to for an\nunmapped variant, so drop them. `feature/media` instead maps both variants onto\n`default`, the only channel its manifest declares. That has no effect today,\nsince nimbus-fml only rejects an unknown channel for manifests with\nchannel-scoped defaults and media has none, but it will once one is added.\n\nNo build-time impact; this is a clarity cleanup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320081\n", "files": ["mobile/android/android-components/components/browser/engine-gecko/build.gradle", "mobile/android/android-components/components/feature/fxsuggest/build.gradle", "mobile/android/android-components/components/service/nimbus/build.gradle"], "git_node": "5fcb2c80732b2751e91710d9585e7fbd98cc4384", "git_parents": ["6115688103686683cd047586c0ed4d26b5314120"], "node": "7431c551d88974807f7c5231b2767d2f0ab5d64b", "parents": ["871874b34b9732080d018caacc042891ab306401"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076867 - Remove old newtab pref for discoverystream.optIn-region-weather-config r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330026\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs"], "git_node": "f2d5a823b95b6bdcefdf234c871083e98a64b62f", "git_parents": ["5fcb2c80732b2751e91710d9585e7fbd98cc4384"], "node": "d86c1e003b50cc7f3ed2bbeb26f2f3945cfcfada", "parents": ["7431c551d88974807f7c5231b2767d2f0ab5d64b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076596 - Document that moveTabBefore and moveTabAfter accept a tab group label. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329860\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs"], "git_node": "cf589b9f502d40fd41429c75b40387b8d0dd6164", "git_parents": ["f2d5a823b95b6bdcefdf234c871083e98a64b62f"], "node": "4208b2540406ea58df066f529297cf28b138085f", "parents": ["d86c1e003b50cc7f3ed2bbeb26f2f3945cfcfada"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076596 - Stop passing arguments that OpenTabsController ignores from the split view's open tabs page. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329845\n", "files": ["browser/components/tabbrowser/content/opentabs-splitview.mjs"], "git_node": "5609ce2596345099798ab920fc026ff4d49636b0", "git_parents": ["cf589b9f502d40fd41429c75b40387b8d0dd6164"], "node": "e4ca3df9987a5912130f4a06d13333a2c62720c6", "parents": ["4208b2540406ea58df066f529297cf28b138085f"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2076887 - Fix documentation for NimbusTestUtils.factories.branch r=nimbus-reviewers,ralkhulaidi,emcminn DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330048\n", "files": ["toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs"], "git_node": "8ed383e7d947dc741235c5e2be91235e46b11804", "git_parents": ["5609ce2596345099798ab920fc026ff4d49636b0"], "node": "ee271a3299d55506d3527d3022c238af56b20281", "parents": ["e4ca3df9987a5912130f4a06d13333a2c62720c6"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076590 - Update NSS to 824793aca473a0bb4a9dc3d4a88a6d0f2786bd7b UPGRADE_NSS_RELEASE r=ai4dev-reviewers,padenot,nkulatova\" for causing build bustages at SEC_ASN1DecodeInteger_Util\n\nThis reverts commit 0f05975dac0cd8b66b590eef4b6ac05180243cb7.\n", "files": ["security/nss/CLAUDE.md", "security/nss/automation/abi-check/expected-report-libnss3.so.txt", "security/nss/automation/abi-check/expected-report-libnssutil3.so.txt", "security/nss/automation/abi-check/expected-report-libsmime3.so.txt", "security/nss/automation/abi-check/expected-report-libssl3.so.txt", "security/nss/automation/abi-check/previous-nss-release", "security/nss/cmd/certutil/certutil.c", "security/nss/cmd/certutil/keystuff.c", "security/nss/cmd/httpserv/httpserv.c", "security/nss/cmd/lib/secutil.c", "security/nss/cmd/p7content/p7content.c", "security/nss/cmd/pk11importtest/pk11importtest.c", "security/nss/cmd/shlibsign/shlibsign.c", "security/nss/cpputil/nss_scoped_ptrs.h", "security/nss/gtests/certdb_gtest/cert_unittest.cc", "security/nss/gtests/der_gtest/secasn1decode_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_eddsa_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_eddsa_vectors.h", "security/nss/gtests/pk11_gtest/pk11_modu