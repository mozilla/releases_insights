c60146d0a", "parents": ["3207834445d743b19728e409b2c5e97266b9f2e7"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2060322 - Record topsite and pocket clicks for links Firefox opens from newtab r=jbrown\" for causing mochitests failures in browser_context_menu_link_open.js.\n\nThis reverts commit d36bc9239569dd2135b5a8df810a92defcc47c8e.\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/DSCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/SafeAnchor/SafeAnchor.jsx", "browser/extensions/newtab/content-src/lib/link-menu-options.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_context_menu_link_open.js", "browser/extensions/newtab/test/browser/link_open_stories.json", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/DSCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/SafeAnchor.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/LinkMenu.test.jsx", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "b3ecc38ee23aaf66cbaec4280751c74e4734ba53", "git_parents": ["18fa3ebd72d9f2e3c2ec035524b93a64161b08c2"], "node": "11fa63d2b4994fa899d9e672df656e0f546e48bb", "parents": ["b94c933edb2d782bec238e63c5cfbfec60146d0a"], "tags": []}, {"author": "Botond Ballo \u003cbotond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072785 - Do not drop zero-delta wheel events on Mac. r=hiro\n\nAt the time of this check, the event has already been sent to APZ,\nso on a page with an active wheel event listener, it's sitting in\nthe input queue waiting for a content response. If we drop it at\nthis point, the content response will never arrive, and the event\nwill stall the input queue until the apz.content_response_timeout\nis reached.\n\nThe alternative of dropping zero-delta events *before* they reach\nAPZ would have a different problem: touchpads can legitimately\ngenerate zero-delta events for things like hold gestures, and APZ\nwants to know about these.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331031\n", "files": ["gfx/layers/apz/test/mochitest/helper_zero_delta_pan_with_wheel_listener.html", "gfx/layers/apz/test/mochitest/test_group_wheelevents.html", "widget/cocoa/nsCocoaWindow.mm"], "git_node": "38497e6e944d73b358148d95e485566b66691a7b", "git_parents": ["b3ecc38ee23aaf66cbaec4280751c74e4734ba53"], "node": "b4d8d5d2e7d7e402006fdd83a12cba5dbb46e953", "parents": ["11fa63d2b4994fa899d9e672df656e0f546e48bb"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078501 - Fix mac arm64 custom-car build after upstream V8 changes r=perftest-reviewers,aglavic\n\n- Drop use_v8_context_snapshot=false. With it set, chrome_framework_resources\n  lists snapshot_blob.bin without a dependency path to\n  //v8:run_mksnapshot_default, so gn gen fails.\n- Set v8_use_metagen=false. V8's run_metagen copies args.gn into a temporary\n  out dir and runs gn desc there, where mac_sdk_path=\"//out/Default/MacOSX.sdk\"\n  falls outside root_build_dir.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331662\n", "files": ["taskcluster/kinds/toolchain/custom-car.yml"], "git_node": "329f73353401782259ba0670e5484992b6e8cf72", "git_parents": ["38497e6e944d73b358148d95e485566b66691a7b"], "node": "357eb005410c35c983587386fb6cf15de93e983b", "parents": ["b4d8d5d2e7d7e402006fdd83a12cba5dbb46e953"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Use isDefaultBrowserAsync() in BrowserGlue; r=firefox-desktop-core-reviewers ,dao\n\nUse the asynchronous default-browser check when recording the result of the\nset-to-default Spotlight.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330096\n", "files": ["browser/components/BrowserGlue.sys.mjs"], "git_node": "09aba2d94c5d65b5808ac52b3d076a5dc8263e8b", "git_parents": ["329f73353401782259ba0670e5484992b6e8cf72"], "node": "06e550fd75111c0e2758373db2b1d05346b72e13", "parents": ["357eb005410c35c983587386fb6cf15de93e983b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2073381 - Use run-if for the manifest-wide security/sandbox conditions. r=sandbox-reviewers,jld\n\nsecurity/sandbox is not built on Linux asan or tsan (toolkit/moz.configure's\nsandbox_default) nor in ccov builds (--disable-sandbox in the ccov mozconfigs),\nso there is no sandbox for these tests to exercise in those configurations.\n\nSeven of these manifests hold a single Linux-only test, so the manifest-wide\ncondition says so directly and the per-test run-if it duplicated is dropped.\nbrowser.toml needs a second entry because it also holds a mac test and two tests\nwith no platform condition of their own.\n\nThe asan and tsan conditions lose their os_version, arch and display qualifiers.\nsandbox_default returns false for any Linux asan or tsan build, not only for the\npool spelling that happens to be in CI today.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327250\n", "files": ["security/sandbox/test/browser.toml", "security/sandbox/test/browser_bug1717599_XDG-CONFIG-DIRS.toml", "security/sandbox/test/browser_bug1717599_XDG-CONFIG-HOME.toml", "security/sandbox/test/browser_profiler.toml", "security/sandbox/test/browser_snap.toml", "security/sandbox/test/browser_xdg_default.toml", "security/sandbox/test/browser_xdg_mozLegacyHome.toml", "security/sandbox/test/browser_xdg_xdgConfigHome.toml"], "git_node": "f08f0891a90323b325e2942711f3df52baa42152", "git_parents": ["09aba2d94c5d65b5808ac52b3d076a5dc8263e8b"], "node": "857dc359a78ecc32832d9f337efdb75d38bfb23e", "parents": ["06e550fd75111c0e2758373db2b1d05346b72e13"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2072793 - Make `IMContextWrapper` modify expected `Selection` at dispatching `eCompositionChange` and relax for selection changes in composition string r=m_kato\n\nWeb apps may update selection during composition.\n\nCurrently, `IMContextWrapper` does not update `mContentSelection` at\ndispatching `eCompositionChange`. Therefore, if the web app may\ncollapse `Selection` to the caret position, that is treated as a\nselection change because `IMContextWrapper` stores the last selection\nrange at dispatching `eCompositionStart` or the previous\n`OnSelectionChange` call. So, `IMContextWrapper` should modify\n`mContentSelection` at dispatching `eCompositionChange`.\n\nAdditionally, we should relax in `OnSelectionChange` if the range is\nin the composition string to avoid the similar web-compat issues.\nThe composition will be replaced by the new composition string or\ncommit string anyway. And not moving `Selection` outside the composition\nstring means that the web app does not intent to make the user to insert\ntext to different place. Therefore, we can treat the selection moved in\nthe composition string as no selection change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327563\n", "files": ["widget/gtk/IMContextWrapper.cpp"], "git_node": "2120d4edd0c4df5ecab4260c81b81b95859fe003", "git_parents": ["f08f0891a90323b325e2942711f3df52baa42152"], "node": "4a15fba710698b8eb97e3e6556712deaf4d3e15d", "parents": ["857dc359a78ecc32832d9f337efdb75d38bfb23e"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078954: Only end stale drag sessions on macOS that we started. r=mac-reviewers,bradwerth\n\nBug 2060156 ended any drag session that was still around when a mouse event reached one of our views. macOS can send us mouse moves without a pressed button while a drag that another application started is still over our window, so we ended that drag before the drop and the page never got a drop event.\n\nAlso reset gUserCancelledDrag once a session has read it, so that the cancellation reported for a stale session does not carry over to the next drag.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331869\n", "files": ["widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsDragService.h", "widget/cocoa/nsDragService.mm", "widget/tests/gtest/TestCocoaStaleDragSession.mm"], "git_node": "0cda78bd8b3365863add630ce06073683b44a816", "git_parents": ["2120d4edd0c4df5ecab4260c81b81b95859fe003"], "node": "b319fa2284819756f67962559ca7696a41bf19b8", "parents": ["4a15fba710698b8eb97e3e6556712deaf4d3e15d"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2026691 - Enable library prefetch on Android for cold applink r=tcampbell\n\nRemoves the !defined(__ANDROID__) guard so ReadAheadLib is called on\nAndroid. Switches ReadAhead on Linux from readahead() to\nposix_fadvise(POSIX_FADV_WILLNEED), which is available on both Linux\nand Android and queues an equivalent asynchronous kernel readahead over\nthe file range before dlopen is called.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290177\n", "files": ["xpcom/glue/FileUtils.cpp", "xpcom/glue/standalone/nsXPCOMGlue.cpp"], "git_node": "cc664415113a9d5613d0303e5dfe7e2d5aa8f444", "git_parents": ["0cda78bd8b3365863add630ce06073683b44a816"], "node": "a8351df046b9d7b5b7f611a4eea8fcb8cb91a7a8", "parents": ["b319fa2284819756f67962559ca7696a41bf19b8"], "tags": []}, {"author": "Jason Salerno \u003csalernojca@gmail.com\u003e", "branch": "default", "desc": "Bug 2076831 - Remove the unused tooltip attribute from the urlbar view markup. r=dao,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330283\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "f0d16866f403d1c28f432410c784b60b30247a06", "git_parents": ["cc664415113a9d5613d0303e5dfe7e2d5aa8f444"], "node": "e37d915286aa3a5b34d157aea3279804f9132c1d", "parents": ["a8351df046b9d7b5b7f611a4eea8fcb8cb91a7a8"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078555: Part 3 - Fix conditional in LoaderObserver::OnForward r=yjuglaret\n\nTypo in copying from part 2 review.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331904\n", "files": ["toolkit/xre/dllservices/mozglue/LoaderObserver.cpp"], "git_node": "56df2ea9644d8d410c114f103494da03538e0753", "git_parents": ["f0d16866f403d1c28f432410c784b60b30247a06"], "node": "4cf603c97a2f339fc19966b4990b8c7e8113d159", "parents": ["e37d915286aa3a5b34d157aea3279804f9132c1d"], "tags": []}, {"author": "Calixte Denizet \u003ccalixte.denizet@gmail.com\u003e", "branch": "default", "desc": "Bug 2079434 - Make DWrite font file loader initialization thread-safe. r=gfx-reviewers,lsalzman\n\nConcurrent buffer-backed FontFace creation could use a loader before\nregistration completed. Initialize and register both DWrite loaders in\nfunction-local statics so callers wait for registration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331785\n", "files": ["gfx/2d/NativeFontResourceDWrite.cpp", "gfx/tests/browser/browser.toml", "gfx/tests/browser/browser_fontface_buffer_concurrent.js", "gfx/tests/browser/file_fontface_buffer_concurrent.html", "gfx/tests/browser/file_fontface_buffer_concurrent_worker.js", "gfx/thebes/gfxDWriteCommon.cpp", "gfx/thebes/gfxDWriteCommon.h"], "git_node": "79a90a9e0a86df09e5780b3a15723de2454a2846", "git_parents": ["56df2ea9644d8d410c114f103494da03538e0753"], "node": "9080a547a12c2a0f67be47bf51e8d2bcf4a375c2", "parents": ["4cf603c97a2f339fc19966b4990b8c7e8113d159"], "tags": ["FIREFOX_BETA_159_BASE", "FIREFOX_NIGHTLY_159_END"]}], "date": 1791452616, "git_changesets": ["2025ff2e950c176e049cd593c94690c71920d7bf", "408aa33592d1b138e5a8a79f9adee1964ddd6a38", "5f36d16681fd22531068b4f83f1e2edb6bd7b14c", "0c560faeeecc47b9d6512100395736f8260dbfa6", "a5eb4429093b10ccdb78fc5c94439a61b881e6e1", "cc61e19186c1f44ecd47918c96514b1f13152b5e", "3d880c8a4e202f69812ba501fba8eeda03a45abe", "cc42fa9be3dd232d263c1ffe8397c4257269091c", "a5b77cc43f98b086b5868d975e35332bc7bd4d57", "61f2aa3fcf36b87417ec685246fec101dfa768e2", "7f28d390e32563b740593cc172b02cb416853e95", "5c08f42e825fcb21075a968d42db72489ff14a51", "d23a59b5ad62ba7d201494d275a51bc775701e8b", "2d12f13413a9c5de1cb345d0fcebb9a9a064d91f", "790436d2a1e975518ff078a2b04bcd7fdfe63e3e", "a1594a9249ae33126475f26770fe098a2fabb7b7", "9e9e3b72431a8e48bf430c219bcd06d7a8344ecc", "e88de0411c7c099ba62f69b1b726bc13ae7e34d8", "0bad3e628ce6130afec845d319fd0bba91df6a8a", "318b5e8cda595f9517fe4328eb3a7d7c4edf7f7a", "0af35ef6d6365ba33f5ce28166840f80cd563af1", "cd0abc34d0fc79939c3c6240c767815195f55f0b", "c59af0269e92f30009817600d0efa139acbf7278", "d36bc9239569dd2135b5a8df810a92defcc47c8e", "1fcb10338036f7b934880d2e971715fffb7b4476", "a48cad2424a558d84b0a8a7570563dd0e09e9ca8", "f2c2ad43eaccc0a0450481c50308e2243f7d56a3", "65a877d4b832cfd4ee250d4ac968db0cafe0437c", "9e0db3e2a9af753641a8f6aaff29c7d1fe751be5", "25b7ff9e491be0becc764ec76cdbe5423d43a440", "0a67b0fc3aad411b8a929ca4402c35a74aa338ff", "de8522162153f621c02b5f0d9d0391bba65a3fff", "468e5abfd486b0629f7503f0908a2f8a523e4682", "8e4d96b50cecadc0abe0ccb7867c0efe94bb5a87", "74b7fd62f5cc02080dd90350466b866d17f5a1de", "2d4b6d569d08ba2ed4e76dec6597b30925faf786", "adfca1cb6c78bb6e77d93cdfc0b5be45675eb803", "403991fb9068045cde653605e1a0b5b1c46ed385", "18fa3ebd72d9f2e3c2ec035524b93a64161b08c2", "b3ecc38ee23aaf66cbaec4280751c74e4734ba53", "38497e6e944d73b358148d95e485566b66691a7b", "329f73353401782259ba0670e5484992b6e8cf72", "09aba2d94c5d65b5808ac52b3d076a5dc8263e8b", "f08f0891a90323b325e2