zilla.com/D329987\n", "files": ["servo/components/style/properties/longhands.toml", "servo/components/style/values/specified/ui.rs"], "git_node": "30053e18d1fda65a9ffc9783aa5d48416ba1c75f", "git_parents": ["c66952b822edf5ae39333d3efa27e6e4788f82ad"], "node": "85f754865d8fd394a3c4c3198c5bd019f22c3e46", "parents": ["74f4469f48c4603bc5d0a7cdc0160061dca405ac"], "tags": []}, {"author": "TIN TUN AUNG \u003c62133983+rayguo17@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2076755 - Enable ::-moz-progress-bar pseudo-element for Servo. r=firefox-style-system-reviewers,emilio\n\nImports https://github.com/servo/stylo/pull/434\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329988\n", "files": ["servo/components/style/servo/selector_parser.rs"], "git_node": "9ec0af8b9a87674970b242524c5c99566eef1728", "git_parents": ["30053e18d1fda65a9ffc9783aa5d48416ba1c75f"], "node": "6dc5908610518c828c1038bd1229393106952c34", "parents": ["85f754865d8fd394a3c4c3198c5bd019f22c3e46"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2076755 - Fix compile problems for Servo. r=firefox-style-system-reviewers,emilio\n\nFixups so that the Servo flavor of Stylo still compiles after these changes:\n- https://github.com/mozilla-firefox/firefox/pull/357\n- https://phabricator.services.mozilla.com/D324114\n- https://phabricator.services.mozilla.com/D325602\n- https://phabricator.services.mozilla.com/D326808\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329989\n", "files": ["servo/components/style/properties/helpers.mako.rs", "servo/components/style/servo/selector_parser.rs", "servo/components/style/values/specified/random.rs"], "git_node": "69ca6592c433a44c1dd01beae698563a185996b8", "git_parents": ["9ec0af8b9a87674970b242524c5c99566eef1728"], "node": "37b19aaff3f0990e3c593ae57a6b1cb9b71b9055", "parents": ["6dc5908610518c828c1038bd1229393106952c34"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076755 - Fix compile problems for Servo. r=firefox-style-system-reviewers,emilio\" for causing rusttest debug BR bustages\n\nThis reverts commit 69ca6592c433a44c1dd01beae698563a185996b8.\n\nRevert \"Bug 2076755 - Enable ::-moz-progress-bar pseudo-element for Servo. r=firefox-style-system-reviewers,emilio\"\n\nThis reverts commit 9ec0af8b9a87674970b242524c5c99566eef1728.\n\nRevert \"Bug 2076755 - Enable `user-select` for Servo + `contain` value. r=firefox-style-system-reviewers,emilio\"\n\nThis reverts commit 30053e18d1fda65a9ffc9783aa5d48416ba1c75f.\n\nRevert \"Bug 2076755 - Upgrade Servo to rust-phf 0.14 and intermediate dependencies. r=firefox-style-system-reviewers,emilio\"\n\nThis reverts commit c66952b822edf5ae39333d3efa27e6e4788f82ad.\n", "files": ["servo/components/style/bloom.rs", "servo/components/style/custom_properties.rs", "servo/components/style/dom_apis.rs", "servo/components/style/properties/helpers.mako.rs", "servo/components/style/properties/longhands.toml", "servo/components/style/selector_map.rs", "servo/components/style/servo/selector_parser.rs", "servo/components/style/values/specified/random.rs", "servo/components/style/values/specified/ui.rs"], "git_node": "1bac62e71c6f8267e3348d2245f64857d2d8a7c8", "git_parents": ["69ca6592c433a44c1dd01beae698563a185996b8"], "node": "d5111ecd7bb37edb1a1247a3e514dab1763c8ee3", "parents": ["37b19aaff3f0990e3c593ae57a6b1cb9b71b9055"], "tags": []}, {"author": "Mark Banner \u003cstandard8@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076571 - Fix tests following the removal of Amazon. r=daleharvey,extension-reviewers,urlbar-reviewers,reemhamz,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330001\n", "files": ["browser/components/extensions/test/browser/browser_ext_topSites.js", "browser/components/urlbar/tests/browser-UrlbarInput/browser_popover_state.js", "browser/components/urlbar/tests/browser-editing/browser_clipboard.js", "browser/components/urlbar/tests/browser-editing/browser_deleteAllText.js", "browser/components/urlbar/tests/browser-quickactions/browser_general.js", "browser/components/urlbar/tests/browser-quickactions/browser_screenshot.js", "browser/components/urlbar/tests/browser-searchMode/browser_omnibox.js", "browser/components/urlbar/tests/browser-searchMode/browser_oneOffButton.js", "browser/components/urlbar/tests/browser-searchMode/browser_preview.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser-searchMode/browser_setURI.js", "browser/components/urlbar/tests/browser-telemetry/browser_searchmode.js", "browser/components/urlbar/tests/browser/browser_autoOpen.js", "browser/components/urlbar/tests/browser/browser_tabKeyBehavior.js", "browser/components/urlbar/tests/browser/browser_top_sites.js", "browser/components/urlbar/tests/browser/head.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_contextual_optin.js", "browser/extensions/newtab/test/browser/browser_topsites_contextMenu_options.js", "browser/extensions/newtab/test/browser/browser_topsites_section.js", "browser/extensions/newtab/test/browser/head.js", "toolkit/components/extensions/test/browser/browser_ext_themes_ntp_colors.js", "toolkit/components/extensions/test/browser/browser_ext_themes_ntp_colors_perwindow.js"], "git_node": "e9e19c178408f6f531d2d5ae2750235c4f08a426", "git_parents": ["1bac62e71c6f8267e3348d2245f64857d2d8a7c8"], "node": "ed52eb799828e2a9747c18532e2695c7fddd315c", "parents": ["d5111ecd7bb37edb1a1247a3e514dab1763c8ee3"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2071839 - Handle streaming upload bodies in service worker fetch events r=necko-reviewers,edenchuang,jesup\n\nTransfer streaming request bodies to service workers over eager IPC streams\nwithout retaining a clone for replay. When an event falls back to the\nnetwork, cancel its JS body after detaching the unread native stream and\nreturn that stream to the intercepted channel. Explicit Request.clone()\nremains supported, and worker cancellation reaches the page's producer.\n\nAdd coverage for backpressure and the closed, disturbed, unlocked body\nstate after fallback. Remove the passing SW upload failure expectations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325151\n", "files": ["dom/fetch/InternalRequest.cpp", "dom/fetch/Request.cpp", "dom/fetch/Request.h", "dom/serviceworkers/FetchEventOpChild.cpp", "dom/serviceworkers/FetchEventOpProxyParent.cpp", "dom/serviceworkers/ServiceWorkerOp.cpp", "dom/serviceworkers/ServiceWorkerOpArgs.ipdlh", "dom/serviceworkers/ServiceWorkerPrivate.cpp", "dom/workers/remoteworkers/RemoteWorkerController.cpp", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "testing/web-platform/meta/service-workers/service-worker/fetch-event.https.h2.html.ini", "testing/web-platform/meta/service-workers/service-worker/fetch-event.https.html.ini", "testing/web-platform/meta/service-workers/service-worker/fetch-request-body-cancel.https.html.ini", "testing/web-platform/mozilla/tests/fetch/api/request/request-stream-service-worker.h2.html", "testing/web-platform/mozilla/tests/fetch/api/request/request-stream-service-worker.js"], "git_node": "330bb90e2b02e71f36100c4d99d2c246f64ba477", "git_parents": ["e9e19c178408f6f531d2d5ae2750235c4f08a426"], "node": "28d9e6e178083784e3dc26ef2d9d9d7b07390e9e", "parents": ["ed52eb799828e2a9747c18532e2695c7fddd315c"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2075738 - Make nsXMLContentSink notify on each insertion, like the HTML parser. r=hsivonen,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329333\n", "files": ["dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLContentSink.h", "testing/web-platform/tests/dom/nodes/MutationObserver-xml-parser.xhtml"], "git_node": "a16b937f463499e6b0a7c7be72de4bce18fb5da4", "git_parents": ["330bb90e2b02e71f36100c4d99d2c246f64ba477"], "node": "b0b46da9358f8b0d9b6e4d91edc1f9e2bdec27ba", "parents": ["28d9e6e178083784e3dc26ef2d9d9d7b07390e9e"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2075738 - Remove FlushType::Content and FlushType::ContentAndNotify. r=hsivonen,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329335\n", "files": ["dom/base/ContentList.cpp", "dom/base/ContentList.h", "dom/base/Document.cpp", "dom/base/FlushType.h", "dom/base/nsGlobalWindowOuter.cpp", "dom/html/HTMLFormElement.cpp", "dom/html/HTMLOptionsCollection.cpp", "dom/html/HTMLOptionsCollection.h", "dom/html/HTMLSelectElement.cpp", "dom/html/nsHTMLDocument.cpp", "dom/xslt/xpath/XPathResult.cpp", "layout/base/PresShell.cpp", "layout/base/nsDocumentViewer.cpp", "layout/docs/DynamicChangeHandling.md"], "git_node": "af6c53b867d9084f34624911018812c289d6feb4", "git_parents": ["a16b937f463499e6b0a7c7be72de4bce18fb5da4"], "node": "5f4894b4bf4ad6bfd1697302c6bb91dc78813ae9", "parents": ["b0b46da9358f8b0d9b6e4d91edc1f9e2bdec27ba"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2075738 - Remove the unused aDoFlush argument from ContentList. r=hsivonen,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329336\n", "files": ["accessible/html/HTMLFormControlAccessible.cpp", "dom/base/ContentList.cpp", "dom/base/ContentList.h", "dom/base/Document.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsImageLoadingContent.cpp", "dom/html/HTMLAllCollection.cpp", "dom/html/HTMLFieldSetElement.cpp", "dom/html/HTMLInputElement.cpp", "dom/html/HTMLOptionsCollection.cpp", "dom/html/HTMLSelectElement.h", "editor/libeditor/HTMLEditor.cpp", "toolkit/components/sessionstore/SessionStoreUtils.cpp"], "git_node": "5b8