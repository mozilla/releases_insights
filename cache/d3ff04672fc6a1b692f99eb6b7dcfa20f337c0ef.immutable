mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/DefaultMenuHostTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuItemEventRouterTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/MenuItemsRegistryTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/fake/FakeMenuHost.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/fake/MenuItemEvents.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/fake/MenuItemEventsTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/downloads/DownloadsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/ShortcutMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/VpnMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/history/HistoryMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/pdf/SaveAsPdfMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/print/PrintMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/SettingsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/deletebrowsingdata/QuitMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/logins/PasswordsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/shortcut/AddToHomeScreenMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/summarization/SummarizePageMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/translations/TranslationsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/webcompat/ReportBrokenSiteMenuItemProviderTest.kt"], "git_node": "3937854368856c6fdbc7c70acfd29133b7473739", "git_parents": ["e2900f23ee8c3102a00d7ea59177458c26a64c2d"], "node": "067cb14deb3a550f63a5dace182803e0d0610cd2", "parents": ["0dc62f7b8063ade9cc39b856855eaffc126af8af"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073095 - fix extension private browsing test.\n\nPreviously this relied on assets only visible to debug builds, so i've moved these to a place where other testable builds can also use them.\n\n[Try is running here](https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=98025)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/370\n", "files": ["mobile/android/fenix/app/build.gradle", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/file_picker_test/manifest.json", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/file_picker_test/options.html", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/private_browsing_not_allowed_test/background.js", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/private_browsing_not_allowed_test/manifest.json", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/private_browsing_test/background.js", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/private_browsing_test/manifest.json", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/private_browsing_test/page.html", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/private_browsing_test/page.js", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/private_browsing_test/popup.html", "mobile/android/fenix/app/src/androidTest/appAssets/extensions/private_browsing_test/popup.js", "mobile/android/fenix/app/src/debug/assets/extensions/file_picker_test/manifest.json", "mobile/android/fenix/app/src/debug/assets/extensions/file_picker_test/options.html", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_not_allowed_test/background.js", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_not_allowed_test/manifest.json", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/background.js", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/manifest.json", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/page.html", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/page.js", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/popup.html", "mobile/android/fenix/app/src/debug/assets/extensions/private_browsing_test/popup.js"], "git_node": "62d00278a0bfa27a6137210b5de0998034dbf76c", "git_parents": ["3937854368856c6fdbc7c70acfd29133b7473739"], "node": "79b3d4e660c4186bab2e7002fb1967c0d997eca5", "parents": ["067cb14deb3a550f63a5dace182803e0d0610cd2"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Make test 1780191-1.svg not rely on WebRender's incorrect snapping of SVG rectangles. r-#gfx-reviewers r=layout-reviewers,tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326213\n", "files": ["layout/reftests/bugs/1780191-1-ref.svg", "layout/reftests/bugs/1780191-1.svg", "layout/reftests/bugs/reftest.list"], "git_node": "ddc7fadb58b5d840d5cdbf4b6ae9050a4ce8b302", "git_parents": ["62d00278a0bfa27a6137210b5de0998034dbf76c"], "node": "c2540d7538a93ed004fa12bc16cb46c19ae50c5b", "parents": ["79b3d4e660c4186bab2e7002fb1967c0d997eca5"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Wire up AA for primitives that have the ANTIALIASING flag. r=gfx-reviewers,lsalzman\n\nThis used to work and got lost at some point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310361\n", "files": ["gfx/wr/webrender/src/scene_building.rs"], "git_node": "247c94d8deaadbe605f0fbdb32369339c7c5b5e8", "git_parents": ["ddc7fadb58b5d840d5cdbf4b6ae9050a4ce8b302"], "node": "85b71e193fba9acd1a80dea15981d0764da0232a", "parents": ["c2540d7538a93ed004fa12bc16cb46c19ae50c5b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Snap the origin of outer SVG content to the device pixel grid with WebRender. r=layout-reviewers,firefox-svg-reviewers,longsonr,emilio\n\nBefore this patch series, WebRender (incorrectly) snaps SVG primitives, which has a tendency to paper over a lot of things once you have accepted/ignored the missing anti-aliasing.\nThe rationale behind this patch is that SVG primitves should render correctly at sub-pixel offsets but that a potential sub-pixel offset of the SVG document should not compound with the primitives' own (relative) sub-pixel offsets.\nThat's a debatable claim, but it helps a lot with reducing the amount of failures and fuzzing when going from not anti-aliasing SVG primitives in WebRender to starting to do it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328846\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "layout/painting/nsDisplayList.cpp"], "git_node": "aa44a767f602e9f03788b443a683a7516ff0ddf1", "git_parents": ["247c94d8deaadbe605f0fbdb32369339c7c5b5e8"], "node": "2cf9d2970c76289f0c215f81751edd7649e36bce", "parents": ["85b71e193fba9acd1a80dea15981d0764da0232a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Dont't snap anti-aliased primitives. r=gw\n\nAn anti-aliased SVG shape keeps its exact sub-pixel edges instead of\nlanding on the device pixel grid, so an edge that used to be crisp is\nresolved by the shader. Where the reference draws the same geometry at\na snapped position, what is left is a seam one pixel wide along that\nedge. Fuzz the web-platform tests where that shows up. The ranges start\nat 0, so they also hold where the edge still falls on a whole pixel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310363\n", "files": ["gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/space.rs", "testing/web-platform/meta/css/css-images/object-position-svg-001e.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-001o.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-002e.html.ini", "testing/web-platform/meta/css/css-images/object-position-svg-002o.html.ini", "testing/web-platform/meta/svg/painting/inline-svg-resize-viewport-dependent-mask.html.ini"], "git_node": "eab906187d44b86b4d54f946729693eabcde1d7c", "git_parents": ["aa44a767f602e9f03788b443a683a7516ff0ddf1"], "node": "001e225aad87ceb64c38da3fcace3b449d51507a", "parents": ["2cf9d2970c76289f0c215f81751edd7649e36bce"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Snap the clips of anti-aliased primitives unless they are marked as anti-aliased. r=gfx-reviewers,lsalzman\n\nThe clips of the boxes around anti-aliased SVG content (the outer \u003csvg\u003e, an\niframe, an overflow clip) stayed exact, so where they sit at a fractional\ndevice position, they cut a partially covered row off the content, whose\norigin is snapped.\n\nAnti-aliased primitives now snap the clips of their clip chain like other\nprimitives do, in device space. Like primitives, clips can be marked as\nanti-aliased when they are defined, which keeps them exact. This is meant for\nclips in the same space as anti-aliased content, such as SVG user space. The\nprimitive's own local clip rect is part of its geometry and stays exact.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329225\n", "files": ["gfx/webrender_bindings/WebRenderAPI.cpp", "gfx/webrender_bindings/WebRenderAPI.h", "gfx/webrender_bindings/src/bindings.rs", "gfx/wr/webrender/src/clip.rs", "gfx/wr/webrender/src/prim_store/mod.rs", "gfx/wr/webrender/src/scene_building.rs", "gfx/wr/webrender/src/visibility.rs", "gfx/wr/webrender_api/src/display_item.rs", "gfx/wr/webrender_api/src/display_list.rs"], "git_node": "45b2f1b72ab70f148cbca59070c59a3ebd9cdb89", "git_parents": ["eab906187d44b86b4d54f946729693eabcde1d7c"], "node": "991083fdefb832859bfeaf3511f23640ecec3fb6", "parents": ["001e225aad87ceb64c38da3fcace3b449d51507a"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Add a wrench test. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310362\n", "files": ["gfx/wr/wrench/reftests/snap/antialiased-ref.png", "gfx/wr/wrench/reftests/snap/antialiased.yaml", "gfx/wr/wrench/reftests/snap/reftest.list", "gfx/wr/wrench/src/yaml_frame_reader.rs"], "git_node": "4a4ddb053ecfa3741f2204b140c8ea0351a185ff", "git_parents": ["45b2f1b72ab70f148cbca59070c59a3ebd9cdb89"], "node": "364f7a28a77e36d399c0d4f452895552e52b379b", "parents": ["991083fdefb832859bfeaf3511f23640ecec3fb6"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Quantize reference frame origins in device space, not local space. r=gw\n\nThe 1/128 px quantization of reference frame origins (added to keep float\nnoise from the external scroll offset round-trip off the device-pixel snap\ntie) was applied to origin_in_parent_reference_frame at scene build time, in\nthe parent frame's local units. Under a scaled ancestor those units are not\ndevice pixels: SVG content sits under the outer \u003csvg\u003e's viewBox transform,\nso a rect with a CSS transform gets a nested reference frame whose origin\nis quantized to 1/128 of a user unit, i.e. scale/128 device pixels. With\nanti-aliased primitives no longer snapped, that error becomes visible.\n\nMove the quantization to the places where a device-space offset is about to\nbe rounded to a device pixel: snap_offset(), and the should_snap round of\nthe accumulated ScaleOffset in update_transform(). That keeps the snap-tie\nprotection while leaving unsnapped content at its exact position.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326214\n", "files": ["gfx/wr/webrender/src/spatial_node.rs", "gfx/wr/wrench/reftests/border/border-content-snap-scale-ref.yaml", "gfx/wr/wrench/reftests/snap/reference-frame-origin-scaled-ref.yaml", "gfx/wr/wrench/reftests/snap/reference-frame-origin-scaled.yaml", "gfx/wr/wrench/reftests/snap/reftest.list"], "git_node": "1f28d9d9081675b6211453dd858323735bcd7059", "git_parents": ["4a4ddb053ecfa3741f2204b140c8ea0351a185ff"], "node": "b34ed5ca2f237b9616f2c0cfa53fe81559771e31", "parents": ["364f7a28a77e36d399c0d4f452895552e52b379b"], "tags": []}, {"author": "Nicolas Silva \u003cnsilva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050211 - Honour shape-rendering: crispEdges for WebRender SVG rects. r=firefox-svg-reviewers,longsonr\n\nwhen crispEdges is used the primitive should not be anti-aliased.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326215\n", "files": ["layout/svg/SVGGeometryFrame.cpp"], "git_node": "90e1b3b6378a0fdcf040d4d210a52a95290f0aa1", "git_parents": ["1f28d9d9081675b6211453dd858323735bcd7059"], "node": "bb5448ae4cbb8e0f0629ae326d0a4d464f7d4f83", "parents": ["b34ed5ca2f237b9616f2c0cfa53fe81559771e31"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2050211: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["layout/svg/SVGGeometryFrame.cpp"], "git_node": "440f4df8240aa4b92d7f68996eb19217d1b4b02b", "git_parents": ["90e1b3b6378a0fdcf040d4d210a52a95290f0aa1"], "node": "94d5720d12407ac02816a46075a7b5ad77e03c4d", "parents": ["bb5448ae4cbb8e0f0629ae326d0a4d464f7d4f83"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075996 - Check the root element before pretty printing. r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331121\n", "files": ["dom/xml/crashtests/2075996-1.html", "dom/xml/crashtests/2075996-2.html", "dom/xml/crashtests/2075996.sjs", "dom/xml/crashtests/crashtests.list", "dom/xml/nsXMLContentSink.cpp", "dom/xml/nsXMLPrettyPrinter.cpp"], "git_node": "01c4f7862c6ba1fd4f2629a7c633c6bd6fb456d9", "git_parents": ["440f4df8240aa4b92d7f68996eb19217d1b4b02b"], "node": "83090dc4b83ebc30301799d60fbb4b67d972454c", "parents": ["94d5720d12407ac02816a46075a7b5ad77e03c4d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078157 - Re-enable browser_private_idb.js and dom/fs test_basics.html on all platforms. r=jari,dom-storage-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330701\n", "files": ["dom/fs/test/mochitest/mochitest.toml", "dom/indexedDB/test/browser.toml"], "git_node": "ba525bd92bea7a560fc4caed296e67a5c3267f84", "git_parents": ["01c4f7862c6ba1fd4f2629a7c633c6bd6fb456d9"], "node": "d865697e1465dcf60ecf28d0044207e8bf64aede", "parents": ["83090dc4b83ebc30301799d60fbb4b67d972454c"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078528 [Linux] Make SHMBufsurface build on X11 r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331086\n", "files": ["widget/gtk/SHMBufSurface.cpp", "widget/gtk/SHMBufSurface.h", "widget/gtk/moz.build"], "git_node": "300966be7a97419855fe33e23c297cb250f9a668", "git_parents": ["ba525bd92bea7a560fc4caed296e67a5c3267f84"], "node": "c73263ea48a3da2e1b2206875f9ec5bf673b6500", "parents": ["d865697e1465dcf60ecf28d0044207e8bf64aede"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072553 - Fix cache busting parameters causing shim to not be used r=webcompat-reviewers,manuel,twisniewski\n\nScripts may use cache busting parameters to the script\nto check that it is loadable.\nAdjust the match parameter such that the shim is loaded\nin this case as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326505\n", "files": ["browser/extensions/webcompat/data/shims.js"], "git_node": "228a921b2dd8d4bb185b8b8690699cff0ec62352", "git_parents": ["300966be7a97419855fe33e23c297cb250f9a668"], "node": "a7acea4def08c53d64ebde377d90114aed167555", "parents": ["c73263ea48a3da2e1b2206875f9ec5bf673b6500"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071825 - Work around anti-adblocking by shimming Google DCM Ads r=webcompat-reviewers,manuel,twisniewski\n\nThe site checks dcmads.js if it is loadable. It\nalso checks gpt.js which is already shimmed.\nSo also shimming dcmads.js avoids the anti-adblocking.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326569\n", "files": ["browser/extensions/webcompat/data/shims.js"], "git_node": "0751c3f1e1f19741a58a18d927d183083f369e8e", "git_parents": ["228a921b2dd8d4bb185b8b8690699cff0ec62352"], "node": "263efb9829f85857e79d90cb45dc89911eb75dd1", "parents": ["a7acea4def08c53d64ebde377d90114aed167555"], "tags": []}, {"author": "Martin Raiber \u003cmraiber@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069922 - Add xmlhttprequest to types to work around anti-adblocking r=webcompat-reviewers,manuel,twisniewski\n\nThe site tests gpt.js via JavaScript and xmlhttprequest HEAD request.\nAdd xmlhttprequest to types to handle this request and work around\nthe anti-adblocking.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326842\n", "files": ["browser/extensions/webcompat/data/shims.js", "browser/extensions/webcompat/manifest.json"], "git_node": "a7cd72a50c0eb6f973dea40f234af7cb4dd58725", "git_parents": ["0751c3f1e1f19741a58a18d927d183083f369e8e"], "node": "f4ad98380a70676718a53d4530c4b2e2d8e7cdab", "parents": ["263efb9829f85857e79d90cb45dc89911eb75dd1"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078312 - Update FreeType to 25167984d243. r=jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330827\n", "files": ["modules/freetype2/moz.yaml", "modules/freetype2/patches/0001-Bug-2032039-colr-blend-layer-mono-source.patch", "modules/freetype2/src/sfnt/ttcmap.c", "modules/freetype2/src/sfnt/ttcolr.c", "modules/freetype2/src/truetype/ttvarc.c", "modules/freetype2/src/type1/t1parse.c"], "git_node": "a9b5041e2193ed020fb1c2540c81c66e78d4f65a", "git_parents": ["a7cd72a50c0eb6f973dea40f234af7cb4dd58725"], "node": "9e761ac56a33d92e18187e56e5d1809813eeabcf", "parents": ["f4ad98380a70676718a53d4530c4b2e2d8e7cdab"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078312 - Have updatebot vendor FreeType weekly from upstream master. r=jfkthame\n\nThe new freetype try preset uses the full task graph because the on-device reftests and crashtests are not in\nthe default target set, and updatebot's fuzzy-query path cannot pass --full.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330828\n", "files": ["modules/freetype2/moz.yaml", "tools/tryselect/try_presets.yml"], "git_node": "f2f363fb272a3c99e0c67931b60b70b928815911", "git_parents": ["a9b5041e2193ed020fb1c2540c81c66e78d4f65a"], "node": "c4208ea7cccb98ae81255db7804520bf89468ed5", "parents": ["9e761ac56a33d92e18187e56e5d1809813eeabcf"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078486 - Fetch compiler-rt for the macOS x86_64 clang trunk profile build. r=firefox-build-system-reviewers,ahochheiden\n\nSince LLVM 84301dd17f42, clang's lexer checks for SSE4.2 at runtime with __builtin_cpu_supports when it is not\nbuilt with SSE4.2, which needs __cpu_model from compiler-rt's builtins. The profile build links with the\nstage2 package, which carries no compiler-rt, so libclang-cpp.dylib fails to link.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330990\n", "files": ["taskcluster/kinds/toolchain/clang.yml"], "git_node": "22a01282b1ff7e8c656adcd448a9878eea456b09", "git_parents": ["f2f363fb272a3c99e0c67931b60b70b928815911"], "node": "7868163d1209d5d9b04cb8037ae22d343e6472fe", "parents": ["c4208ea7cccb98ae81255db7804520bf89468ed5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078485 - Stop passing cpython's configure flags to make a second time on macOS. r=firefox-build-system-reviewers,sylvestre\n\ncpython's Makefile appends CFLAGS, CPPFLAGS and LDFLAGS from the environment to the values configure recorded,\nso leaving them exported doubled every flag on the compile and link lines, and lld warned about each duplicate\n-rpath. Linux keeps them exported: make mangles the $ORIGIN in the configure-recorded rpath, and the extension\nmodules only get a working one from setup.py appending the environment's LDFLAGS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330991\n", "files": ["taskcluster/scripts/misc/build-cpython.sh"], "git_node": "b1f601b55212349147fab20af8de0a58285bca0c", "git_parents": ["22a01282b1ff7e8c656adcd448a9878eea456b09"], "node": "bf885bffeca1a045f2c411b05e022da713a756d9", "parents": ["7868163d1209d5d9b04cb8037ae22d343e6472fe"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2076891 - Cover more form elements in nsTreeSanitizer r=hsivonen\n\n- Move input from MustFlatten to MustPrune (cannot have children).\n- Add label/output to MustFlatten (can be form elements with children).\n- Add textarea to MustPrune (can be a form element)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330054\n", "files": ["dom/base/nsTreeSanitizer.cpp", "dom/base/test/test_bug650776.html"], "git_node": "420676c60c1e2471a0d1dea106f4d9fce8806c97", "git_parents": ["b1f601b55212349147fab20af8de0a58285bca0c"], "node": "f2dcc1172316c72f223294d829e62d267972166a", "parents": ["bf885bffeca1a045f2c411b05e022da713a756d9"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078221 - Add telemetry for user activation for each geolocation requests r=dom-core-reviewers,jjaschke\" for causing build bustages @ Geolocation.cpp\n\nThis reverts commit 597a9b6036628896b8c6986b9b974f7eabf1fcc4.\n", "files": ["dom/geolocation/Geolocation.cpp", "dom/geolocation/metrics.yaml", "testing/web-platform/mozilla/tests/geolocation-API/user-activation-glean.https.window.js"], "git_node": "4a3e5d2e9cc04740577311b6b7d89b368d373e32", "git_parents": ["420676c60c1e2471a0d1dea106f4d9fce8806c97"], "node": "993c83918b3af72b7710705b3566df7bc66568c5", "parents": ["f2dcc1172316c72f223294d829e62d267972166a"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2078514 - Keep HTTP activity enabled while observers remain registered. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331025\n", "files": ["netwerk/protocol/http/nsHttpActivityDistributor.cpp", "netwerk/test/unit/test_activity_observer_remove.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "a39a67c025c762d9d2a1a4ea4b80a98fc603929f", "git_parents": ["4a3e5d2e9cc04740577311b6b7d89b368d373e32"], "node": "e81f21359ba695ef551e5b75a8ab020835232351", "parents": ["993c83918b3af72b7710705b3566df7bc66568c5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078286 - Store SessionStore's window IDs in a WeakMap instead of window expandos. r=sfoster,sessionstore-reviewers,sidebar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330825\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/SessionWindowUI.sys.mjs", "browser/components/sessionstore/TabGroupState.sys.mjs", "browser/components/sessionstore/test/browser_dying_cache.js", "browser/components/sessionstore/test/marionette/test_restore_last_session_window_mismatch.py", "browser/components/sidebar/SidebarCollapsedWindows.sys.mjs", "browser/components/sidebar/sidebar-opentabs.mjs", "browser/components/sidebar/tests/browser/browser_opentabs_sidebar.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups_telemetry.js", "browser/modules/test/browser/browser_aswebauth_session.js", "testing/mochitest/browser-test.js"], "git_node": "82a3b6cf3f498eb19d6f6b05e3d230e04963b0c6", "git_parents": ["a39a67c025c762d9d2a1a4ea4b80a98fc603929f"], "node": "157a7c5c3a0eba1c9527377235e2f858c494bcfa", "parents": ["e81f21359ba695ef551e5b75a8ab020835232351"], "tags": []}, {"author": "Yulia Startsev \u003cyulia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077638 - ensure JS native objects use fast path; r=jandem,spidermonkey-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330729\n", "files": ["dom/base/test/mochitest.toml", "dom/base/test/test_htmlcollection_spread_duplicate_keys.html", "js/src/builtin/Object.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/basic/object-spread-duplicate-keys.js"], "git_node": "c881f68449daf393c2b61c58bd81c388de9c5241", "git_parents": ["82a3b6cf3f498eb19d6f6b05e3d230e04963b0c6"], "node": "b84fc1b6d5d2a4cee055e35c8393c6a3e3ef72c8", "parents": ["157a7c5c3a0eba1c9527377235e2f858c494bcfa"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073199 - Part 1: Remove tile_id from the newtab ping metrics. r=thecount\n\nNow that Data Engineering has stopped processing tile_id and the Nimbus rollout from bug 2060987 and bug 2072362\nhas disabled sending tile_id to all eligible clients, we can remove tile_id from the newtab ping altogether.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328616\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "39d1546a92f72d8482b6612c7eb9a2bff883069c", "git_parents": ["c881f68449daf393c2b61c58bd81c388de9c5241"], "node": "4d40e7f907e545a9b1d1ac9c8a3176b88e4cadc3", "parents": ["b84fc1b6d5d2a4cee055e35c8393c6a3e3ef72c8"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073199 - Part 2: Remove tile_id from newtab-content ping events. r=thecount\n\nWe've been stripping tile_id from the newtab-content ping automatically in sanitizeEventData, so let's\nenforce this at the metric level by removing the tile_id extra_keys for the newtab-content ping.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330943\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/lib/NewTabContentPing.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "ad42364e57df1fb4a598200ddc43ca175a63e5f5", "git_parents": ["39d1546a92f72d8482b6612c7eb9a2bff883069c"], "node": "c03ed050b7ad02ccf720fc6f0f9a95f5d57e9bbc", "parents": ["4d40e7f907e545a9b1d1ac9c8a3176b88e4cadc3"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077543 - Add a typedef for search mode objects in UrlbarInputBase. r=urlbar-reviewers,dao\n\nAlso stops throwing when calling setSearchMode with an invalid search mode object with a restrictType.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330383\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "73d373e5836913c7cd101308de1f32bb3fd3514c", "git_parents": ["ad42364e57df1fb4a598200ddc43ca175a63e5f5"], "node": "89a7661f1cddf4318136e614d88b2bab581b8b26", "parents": ["c03ed050b7ad02ccf720fc6f0f9a95f5d57e9bbc"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077543 - Fix type errors in UrlbarBaseInput and enable type checking in it. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330384\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tsconfig.json", "browser/modules/URILoadingHelper.sys.mjs"], "git_node": "57fda33e14899cd8163b5f38e9bf17e0380d41e6", "git_parents": ["73d373e5836913c7cd101308de1f32bb3fd3514c"], "node": "b8b58d2468da91bf4c712d124c7d7bd630206f98", "parents": ["89a7661f1cddf4318136e614d88b2bab581b8b26"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078351 - Type-check aboutSessionRestore.js. r=sfoster,sessionstore-reviewers\n\nThe project's include now matches any .mjs at the top level and any .js or .mjs under content/; today that adds only aboutSessionRestore.js.\n\nThe runtime changes are meant to be behavior-neutral: getCellValue returns the string XPConnect already converted the checked state to, openDialog gets the URL the Location stringified to, and the tree view's new drop, setCellValue and setCellText stubs are never called because the tree is neither editable nor a drop target.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330896\n", "files": ["browser/components/sessionstore/content/aboutSessionRestore.js", "browser/components/sessionstore/tsconfig.json"], "git_node": "7774e8d18ed7e01b1927f9c065107ed86870f6be", "git_parents": ["57fda33e14899cd8163b5f38e9bf17e0380d41e6"], "node": "bfb47f140a43aa191869e61fd4be82214673a4c9", "parents": ["b8b58d2468da91bf4c712d124c7d7bd630206f98"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074871 - Let the address bar's actions row wrap when it doesn't fit. r=daleharvey,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330367\n", "files": ["browser/themes/shared/urlbar/dynamic-results.css"], "git_node": "e8e8b02cc10ba936775057c46a9e87b9706c0969", "git_parents": ["7774e8d18ed7e01b1927f9c065107ed86870f6be"], "node": "69fc6eded3b40a23ac1bdfc9c0bd0ea23d6be5d2", "parents": ["bfb47f140a43aa191869e61fd4be82214673a4c9"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 1972602 - Remove legacy enrollment store and disable persistence in tests r=ralkhulaidi,nimbus-reviewers,emcminn\n\nThe shared SQL database in the ProfilesDatastoreServices has been the\nsource of truth for Nimbus since bug 1972426. However, we've still had\nthe legacy ExperimentDataStore.json to support xpcshell tests that do\nnot enable the ProfilesDatastoreService (see bug 1967779).\n\nBy default we no longer persist experiments to disk when running in a\ntest environment (when `Cu.isInAutomation` is true at startup). This\nremoves the need for keeping the legacy experiment store. Persistence\nis, however, enabled in all toolkit/components/nimbus xpcshell tests to\nensure correctness.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322754\n", "files": ["browser/app/profile/firefox.js", "testing/profiles/xpcshell/user.js", "toolkit/components/nimbus/lib/Enrollments.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/ExperimentStore.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/browser/browser_SharedDataMap.js", "toolkit/components/nimbus/test/browser/browser_about_config_pref_change.js", "toolkit/components/nimbus/test/browser/browser_experimentapi_child.js", "toolkit/components/nimbus/test/browser/browser_remotesettings_experiment_enroll.js", "toolkit/components/nimbus/test/browser/head.js", "toolkit/components/nimbus/test/unit/head.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_load_unenrolled_slugs.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_lifecycle.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_prefs.js", "toolkit/components/nimbus/test/unit/test_ExperimentStore.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_Migrations.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js", "toolkit/components/nimbus/test/unit/test_bug2054546.js", "toolkit/components/nimbus/test/unit/test_policy.js", "toolkit/components/nimbus/test/unit/test_prefFlips.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "80f352bacb9e76a12294a31d378b40acbb92c5f0", "git_parents": ["e8e8b02cc10ba936775057c46a9e87b9706c0969"], "node": "920bf77fc2966fe39e50225cbe06374af7b9eb5f", "parents": ["69fc6eded3b40a23ac1bdfc9c0bd0ea23d6be5d2"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071998 - Fix stale-while-revalidate refreshes for HTTP redirects r=necko-reviewers,kershaw\" for causing fetch related wpt failures\n\nThis reverts commit 425077b3ee5bf610a1216853370ed147733dc60d.\n", "files": ["netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/test/unit/test_stale-while-revalidate_redirect.js", "netwerk/test/unit/xpcshell.toml", "netwerk/test/unit_ipc/child_stale-while-revalidate_redirect.js", "netwerk/test/unit_ipc/test_stale-while-revalidate_redirect.js", "netwerk/test/unit_ipc/xpcshell.toml"], "git_node": "d0694f76de59b7a042540ec6f136a507027e22e5", "git_parents": ["80f352bacb9e76a12294a31d378b40acbb92c5f0"], "node": "23ec4e1675c648004322ebf779eee3582b685cca", "parents": ["920bf77fc2966fe39e50225cbe06374af7b9eb5f"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076891 - Cover more form elements in nsTreeSanitizer r=hsivonen\" for causing bc failures @ browser_aboutDialog_AppUpdater_stop_download_failed.js\n\nThis reverts commit 420676c60c1e2471a0d1dea106f4d9fce8806c97.\n", "files": ["dom/base/nsTreeSanitizer.cpp", "dom/base/test/test_bug650776.html"], "git_node": "f911a891f00ecbe636f159dec0444e0647af63c6", "git_parents": ["d0694f76de59b7a042540ec6f136a507027e22e5"], "node": "ded72ddedbe37300f9fc90c70ce3976446ccf71c", "parents": ["23ec4e1675c648004322ebf779eee3582b685cca"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1972602 - Remove legacy enrollment store and disable persistence in tests r=ralkhulaidi,nimbus-reviewers,emcminn\" for causing failure @ browser_experimental_features.js\n\nThis reverts commit 80f352bacb9e76a12294a31d378b40acbb92c5f0.\n", "files": ["browser/app/profile/firefox.js", "testing/profiles/xpcshell/user.js", "toolkit/components/nimbus/lib/Enrollments.sys.mjs", "toolkit/components/nimbus/lib/ExperimentManager.sys.mjs", "toolkit/components/nimbus/lib/ExperimentStore.sys.mjs", "toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/lib/PrefFlipsFeature.sys.mjs", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs", "toolkit/components/nimbus/lib/SharedDataMap.sys.mjs", "toolkit/components/nimbus/metrics.yaml", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/browser/browser_SharedDataMap.js", "toolkit/components/nimbus/test/browser/browser_about_config_pref_change.js", "toolkit/components/nimbus/test/browser/browser_experimentapi_child.js", "toolkit/components/nimbus/test/browser/browser_remotesettings_experiment_enroll.js", "toolkit/components/nimbus/test/browser/head.js", "toolkit/components/nimbus/test/unit/head.js", "toolkit/components/nimbus/test/unit/shutdown/test_RSEL_updateRecipes_load_unenrolled_slugs.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_lifecycle.js", "toolkit/components/nimbus/test/unit/test_ExperimentManager_prefs.js", "toolkit/components/nimbus/test/unit/test_ExperimentStore.js", "toolkit/components/nimbus/test/unit/test_FirefoxLabs.js", "toolkit/components/nimbus/test/unit/test_Migrations.js", "toolkit/components/nimbus/test/unit/test_RemoteSettingsExperimentLoader_updateRecipes.js", "toolkit/components/nimbus/test/unit/test_bug2054546.js", "toolkit/components/nimbus/test/unit/test_policy.js", "toolkit/components/nimbus/test/unit/test_prefFlips.js", "toolkit/components/nimbus/test/unit/xpcshell.toml"], "git_node": "6388e81fba2173863c0948b5affbce38179cd33e", "git_parents": ["f911a891f00ecbe636f159dec0444e0647af63c6"], "node": "63965b9bd00f768a3a965d5f46ca12235726fe88", "parents": ["ded72ddedbe37300f9fc90c70ce3976446ccf71c"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078398 - Release the Glean store in the crash reporter client once its crash ping is sent. r=afranchuk,crashreporting-reviewers\n\nThe client held the Glean store lock until it exited, so a crash ping sent by\nthe restarted Firefox waited for the crash reporter UI to close and the report\nto be submitted, and could hang shutdown in the meantime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331126\n", "files": ["toolkit/crashreporter/client/app/src/logic.rs", "toolkit/crashreporter/client/app/src/main.rs"], "git_node": "b1816408379331e1313a82b0aa855b24fcd14453", "git_parents": ["6388e81fba2173863c0948b5affbce38179cd33e"], "node": "5d4f8fdc1d9770e589c9779a0da3df12fcf54886", "parents": ["63965b9bd00f768a3a965d5f46ca12235726fe88"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2058679 - Add a fenix nightly as release build and run SP3 on it r=perftest-reviewers,releng-reviewers,aglavic,ahal,taskgraph-reviewers\n\nThis patch adds an android version of the desktop nightly-as-release\nperf config. This gives android the same coverage that we have on macOS,\nwindows, and linux. This analog ensures we excercise code paths that are\notherwise gated behind nightly only flags.\n\nFor now it is restricted to running the Speedometer 3 benchmark.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324802\n", "files": ["mobile/android/config/mozconfigs/android-aarch64/nightly-as-release", "mobile/android/config/mozconfigs/android-aarch64/profile-generate-as-release", "mobile/android/config/mozconfigs/android-arm/nightly-as-release", "mobile/android/config/mozconfigs/android-arm/nightly-fat-aar-as-release", "mobile/android/config/mozconfigs/android-x86_64/nightly-as-release", "taskcluster/config.yml", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/mobile.yml", "taskcluster/kinds/build-apk/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build-signing/kind.yml", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/generate-profile/kind.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "testing/perfdocs/generated/performance-infrastructure.md", "testing/perfdocs/generated/raptor.md"], "git_node": "4b5920571e7f3ab26909d1ff14fa140e2f166e53", "git_parents": ["b1816408379331e1313a82b0aa855b24fcd14453"], "node": "7f52d3e37d8b9bf56098445b1d1d4025f0fa0c3f", "parents": ["5d4f8fdc1d9770e589c9779a0da3df12fcf54886"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078540 - Remove leftover ubuntu1804 test configuration. r=taskgraph-reviewers,bhearsum DONTBUILD\n\nThere are no ubuntu1804 test platforms nor a ubuntu1804-test image anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331106\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/transforms/job/mozharness_test.py", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/scripts/tester/test-linux.sh", "taskcluster/test_configs/variants.yml"], "git_node": "68fa75d9f52ccbafb8c6e8dcde3d9401924e57c7", "git_parents": ["4b5920571e7f3ab26909d1ff14fa140e2f166e53"], "node": "fa7ca829e1332a660679c9e8dd55dfcd9fc70ba1", "parents": ["7f52d3e37d8b9bf56098445b1d1d4025f0fa0c3f"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 1767455 - new test cases r=asuth,mixedpuppy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D149797\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_web_accessible_workers.js", "toolkit/components/extensions/test/xpcshell/xpcshell-content.toml", "toolkit/components/extensions/test/xpcshell/xpcshell-serviceworker.toml", "toolkit/modules/AppConstants.sys.mjs", "toolkit/modules/moz.build"], "git_node": "9f6963ba0d911e171154804d4723526d586112fb", "git_parents": ["68fa75d9f52ccbafb8c6e8dcde3d9401924e57c7"], "node": "098456b0a57372f660eaf72674083f11b4762b63", "parents": ["fa7ca829e1332a660679c9e8dd55dfcd9fc70ba1"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076966 - Bump extensions.timing.* and extensions.counters.* Glean metrics expiring version to Firefox 181. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330804\n", "files": ["toolkit/components/extensions/metrics.yaml"], "git_node": "d21c2e202f56e8a59f076699c03801052b207c8c", "git_parents": ["9f6963ba0d911e171154804d4723526d586112fb"], "node": "3d52865f6d80d5f5190073f68417d0918270d2df", "parents": ["098456b0a57372f660eaf72674083f11b4762b63"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076968 - Bump extensions.data.* Glean metrics expire version to Firefox 181. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330805\n", "files": ["toolkit/components/extensions/metrics.yaml"], "git_node": "1339913b0875ff2c49ac4894b7cebc58e6638a23", "git_parents": ["d21c2e202f56e8a59f076699c03801052b207c8c"], "node": "013722d0154db804866cfef9c29a76629469cf53", "parents": ["3d52865f6d80d5f5190073f68417d0918270d2df"], "tags": []}, {"author": "Dustin Whisman \u003cdwhisman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045965 - Rename input tokens to differentiate between shared and specialized tokens r=desktop-theme-reviewers,tabbrowser-reviewers,reusable-components-reviewers,omc-reviewers,urlbar-reviewers,akulyk,ini,mlucks,mossop,dao,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327420\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/aiwindow/ui/components/agent-monitor-item/agent-monitor-item.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/backup/content/password-validation-inputs.css", "browser/components/profiles/content/edit-profile-card.css", "browser/extensions/newtab/content-src/styles/nova/_tokens.scss", "browser/themes/osx/places/organizer.css", "browser/themes/shared/tabbrowser/tabs.css", "browser/themes/shared/urlbar.css", "browser/themes/windows/places/organizer.css", "toolkit/content/jar.mn", "toolkit/content/widgets/moz-input-folder/moz-input-folder.css", "toolkit/content/widgets/moz-input-folder/moz-input-folder.tokens.css", "toolkit/content/widgets/moz-input-folder/moz-input-folder.tokens.json", "toolkit/content/widgets/moz-input-search/moz-input-search.css", "toolkit/content/widgets/moz-input-search/moz-input-search.mjs", "toolkit/content/widgets/moz-input-text/moz-input-text.css", "toolkit/content/widgets/moz-textarea/moz-textarea.css", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-platform.css", "toolkit/themes/shared/design-system/dist/tokens-shared.css", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/docs/README.design-tokens.stories.md", "toolkit/themes/shared/design-system/src/tokens/components/input.nova.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/input.tokens.json", "toolkit/themes/shared/design-system/src/tokens/components/toolbar.tokens.json", "toolkit/themes/shared/design-system/storybook/tokens-table.css", "toolkit/themes/shared/global-shared.css", "toolkit/themes/shared/in-content/common-shared.css"], "git_node": "715cafb0cecda19dd0e21fff14e343e479f4e6f4", "git_parents": ["1339913b0875ff2c49ac4894b7cebc58e6638a23"], "node": "7519057c9463ab59db98dd59b94cac29cac168a0", "parents": ["013722d0154db804866cfef9c29a76629469cf53"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2078424 - Remove gfxPlatform::GetSourceSurfaceForSurface. r=gfx-reviewers,aosmond\n\nIts only remaining caller was TestTextures.\n\nDeleting gfxPlatform::GetSourceSurfaceForSurface lets us get rid of\nsome \"user data\" infrastructure, too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330924\n", "files": ["gfx/tests/gtest/TestTextures.cpp", "gfx/thebes/gfxASurface.cpp", "gfx/thebes/gfxPlatform.cpp", "gfx/thebes/gfxPlatform.h"], "git_node": "809ee197ed233da24df9ba3240365b32856f623b", "git_parents": ["715cafb0cecda19dd0e21fff14e343e479f4e6f4"], "node": "cde2db0366471e107edc63e945e66bb8b7eff0af", "parents": ["7519057c9463ab59db98dd59b94cac29cac168a0"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2078427 - Remove unused gfxAlphaRecovery. r=gfx-reviewers,aosmond\n\nRecoverAlpha has no callers. gfxImageSurface only used it for its allocation\nalignment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330925\n", "files": ["gfx/thebes/gfxAlphaRecovery.cpp", "gfx/thebes/gfxAlphaRecovery.h", "gfx/thebes/gfxAlphaRecoveryGeneric.h", "gfx/thebes/gfxAlphaRecoveryNeon.cpp", "gfx/thebes/gfxAlphaRecoverySSE2.cpp", "gfx/thebes/gfxImageSurface.cpp", "gfx/thebes/moz.build"], "git_node": "e962995f020b3b1a1eb21847bfd8ed6f2f26ec66", "git_parents": ["809ee197ed233da24df9ba3240365b32856f623b"], "node": "0f80353c000d5ce7962ec99b7bb7754ff847be17", "parents": ["cde2db0366471e107edc63e945e66bb8b7eff0af"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078113 - Show the Search Tabs shortcut in the search mode switcher. r=search-reviewers,urlbar-reviewers,daleharvey\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330672\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js"], "git_node": "43cbc4a304df05c726d8caf84eabca165058b4e1", "git_parents": ["e962995f020b3b1a1eb21847bfd8ed6f2f26ec66"], "node": "d71b5d5603a7cc444466e23a4d0824e02957429c", "parents": ["0f80353c000d5ce7962ec99b7bb7754ff847be17"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074484 part 1 - Don't preserve JIT code for dying realms. r=iain,jonco,smaug\n\nGecko now tells the JS engine when a window's realm is dying. We then use this to\nstop preserving JIT code for this realm on GC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330241\n", "files": ["dom/base/nsGlobalWindowInner.cpp", "js/public/friend/PerformanceHint.h", "js/src/builtin/TestingFunctions.cpp", "js/src/gc/GC.cpp", "js/src/gc/GCAPI.cpp", "js/src/jit-test/tests/gc/discard-jit-code-dying-realm.js", "js/src/vm/Realm.h"], "git_node": "226d17299d21302da1c467e1c1420838c818ec8c", "git_parents": ["43cbc4a304df05c726d8caf84eabca165058b4e1"], "node": "f04e98335713338b6d830a2af372afbfba47ee94", "parents": ["d71b5d5603a7cc444466e23a4d0824e02957429c"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074484 part 2 - Preserve JIT code for all non-dying realms in a zone if any realm needs it. r=iain,jonco\n\nThis restores the zone-wide preservation mechanism we had before bug 1865078,\nwhile still discarding JIT code for dying realms (the Speedometer 3 case).\nThis should address some of the reported regressions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330242\n", "files": ["js/src/gc/GC.cpp"], "git_node": "aa0280e0690c521e6c0089e8fd60846e9a1b2356", "git_parents": ["226d17299d21302da1c467e1c1420838c818ec8c"], "node": "71f8d3d8f184579adb99f51d09ed94efe217df37", "parents": ["f04e98335713338b6d830a2af372afbfba47ee94"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2078542 - Store runs of equal template slots from one register. r=iain\n\ncopySlotsFromTemplate stored each template slot with its own\nstoreValue, so a run of equal slots such as Int32Value(0), +0.0 or\nundefined rematerialized the boxed constant before every store. Store a\nrun of equal non-GC-thing values through fillSlotsWithConstantValue,\nwhich loads the constant into the temp register once.\n\nOn one JetStream 3 run on arm64 this removes about 4,500 instructions\n(18 KB), almost all in Ion inline allocation: 2,239 for +0.0 slots,\n1,690 for Int32Value(0) and 554 for undefined.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331088\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h"], "git_node": "4cdbed66c57e0f855703e99842b86dac223fed4b", "git_parents": ["aa0280e0690c521e6c0089e8fd60846e9a1b2356"], "node": "0fe0502d7ae3ab7f0d28e63fbb17dd40fec1afdf", "parents": ["71f8d3d8f184579adb99f51d09ed94efe217df37"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2078541 - Extract the Value tag once for chained type tests. r=iain\n\nBaseline's Coalesce and CheckObjCoercible, and CacheIR's\nGuardIsNullOrUndefined and GuardWasmArg, test one Value against several\ntypes by calling branchTestX on the ValueOperand each time. On arm64\nand x64 each call extracts the tag again (asr x16, v, #47 on arm64,\nmovq v, %r11; shrq $47, %r11 on x64). Extract it once with\nScratchTagScope, as the Ion null-or-undefined compares already do.\n\nOn one JetStream 3 run on arm64 this removes about 1,600 instructions\n(6.4 KB): CheckObjCoercible 901, Coalesce 496, GuardIsNullOrUndefined\n133 and GuardWasmArg 86. Repeated tag extractions in Baseline code drop\nfrom 1,661 to 116.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331087\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CacheIRCompiler.cpp"], "git_node": "b7d3ee9424d9bc2e1b4f224ccb4937ccb768e4ae", "git_parents": ["4cdbed66c57e0f855703e99842b86dac223fed4b"], "node": "c01a582112d9f0a8ccac828eb6c7f390a26db5e3", "parents": ["0fe0502d7ae3ab7f0d28e63fbb17dd40fec1afdf"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078355: Reorder tests in regexp quickcheck r=spidermonkey-reviewers,jandem\n\nThis approach generates one loadStringLength and loadStringChars instead of two. I originally put the tests in the other order because doing the length check for the bitset first (which requires 1 char remaining) meant that we could sometimes entirely skip the length check for the mask (which requires 4 chars remaining), but I didn't consider splitting the `index \u003e= length` check from the reject bitset. This is about 15% faster on a targeted microbenchmark where both tests pass and we enter the regexp.\n\nI don't think RegExpShared::quickCheckRejects cares about this change, because register pressure isn't the same issue in C++ code, but I updated it so that the two versions stay in sync.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330839\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/vm/RegExpObject.cpp"], "git_node": "3fb7931fd69d1958550d30a3a9dd8ae1865003a3", "git_parents": ["b7d3ee9424d9bc2e1b4f224ccb4937ccb768e4ae"], "node": "e6b13f49b74333636c54a178b07f86ceabbe3ea9", "parents": ["c01a582112d9f0a8ccac828eb6c7f390a26db5e3"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2056476: Don't attach DateObjectToNumber for self-modifying objects r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330853\n", "files": ["js/src/jit-test/tests/cacheir/bug2056476.js", "js/src/jit/CacheIR.cpp"], "git_node": "3e41784ece508d6b6ae3be7a202ec7dda24778da", "git_parents": ["3fb7931fd69d1958550d30a3a9dd8ae1865003a3"], "node": "c6db41ffe44d236cf35bf9baafea864df4462d22", "parents": ["e6b13f49b74333636c54a178b07f86ceabbe3ea9"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021192: Handle Int32/Double aliases in emitIdGuard r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330926\n", "files": ["js/src/jit-test/tests/cacheir/bug2021192.js", "js/src/jit/CacheIR.cpp"], "git_node": "d8e6f10a294c9c865156843c111e8ee735834420", "git_parents": ["3e41784ece508d6b6ae3be7a202ec7dda24778da"], "node": "75f47a1dea0b43f714bdf020f4f13b9778068b33", "parents": ["c6db41ffe44d236cf35bf9baafea864df4462d22"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075982: Handle Doubles in RRotate::recover r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330949\n", "files": ["js/src/jit-test/tests/ion/recover-rotate.js", "js/src/jit/Recover.cpp"], "git_node": "1250f59d853de524dfb603e7e4e2ec3cb4bbc4d8", "git_parents": ["d8e6f10a294c9c865156843c111e8ee735834420"], "node": "962a693696dd2ca7ba6b2018b180c1387bd22dbb", "parents": ["75f47a1dea0b43f714bdf020f4f13b9778068b33"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074885 - Index included manifest runtimes once in resolve_manifest_runtimes. r=taskgraph-reviewers,bhearsum\n\nScanning every runtime key for each manifest made the function quadratic, and it is called twice per test task.\n\nLocally (`./mach taskgraph full -j 8` with the parameters of a try\ndecision task), the mochitest kind finishes about 3.4s sooner (23.3s\ninstead of 26.7s). The full task set isn't faster yet, as\nweb-platform-tests is still the slowest kind.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328551\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/test/test_util_chunking.py", "taskcluster/gecko_taskgraph/transforms/test/chunk.py", "taskcluster/gecko_taskgraph/util/chunking.py"], "git_node": "855b3147909cfbf19810b3e3e4b9f3018b478ebd", "git_parents": ["1250f59d853de524dfb603e7e4e2ec3cb4bbc4d8"], "node": "3e3faaae594fbc7cd1dc508404b2e7d382c74cb9", "parents": ["962a693696dd2ca7ba6b2018b180c1387bd22dbb"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074885 - Avoid redundant work when computing the test manifests of a task. r=taskgraph-reviewers,bhearsum\n\nThe web-platform-tests manifests only depend on the suite, subsuite and tags, so compute them once per combination rather than for every mozinfo.\n\nLocally (`./mach taskgraph full -j 8` with the parameters of a try\ndecision task), the web-platform-tests kind finishes about 5.5s sooner\n(22.4s instead of 27.9s), so the full task set takes 26.1s instead of\n29.6s.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328552\n", "files": ["taskcluster/gecko_taskgraph/util/chunking.py"], "git_node": "ffaad538141387785625ef3e4ab90be04a61e39b", "git_parents": ["855b3147909cfbf19810b3e3e4b9f3018b478ebd"], "node": "a9089a75433bf575dc702e1d1d6c7aa0f51ab153", "parents": ["3e3faaae594fbc7cd1dc508404b2e7d382c74cb9"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076694 - Use the confidence thresholds returned by bugbug in the bugbug manifest loader. r=bhearsum,taskgraph-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330951\n", "files": ["taskcluster/gecko_taskgraph/test/test_util_chunking.py", "taskcluster/gecko_taskgraph/util/chunking.py"], "git_node": "fc30cca8f6512042a286519096d56ed1c8e48834", "git_parents": ["ffaad538141387785625ef3e4ab90be04a61e39b"], "node": "d8258bd71438fb279d21f59d8280a837a9244b72", "parents": ["a9089a75433bf575dc702e1d1d6c7aa0f51ab153"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078113 - Show the Search Tabs shortcut in the search mode switcher. r=search-reviewers,urlbar-reviewers,daleharvey\" for causing bc failures @ browser_restrict_keywords.js\n\nThis reverts commit 43cbc4a304df05c726d8caf84eabca165058b4e1.\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js"], "git_node": "76f4087a874d00e304db7efedffb88d7a5ab6dc7", "git_parents": ["fc30cca8f6512042a286519096d56ed1c8e48834"], "node": "30d0cd173e48c25436004958f576cdc1cc0e8123", "parents": ["d8258bd71438fb279d21f59d8280a837a9244b72"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1710592 - Generate bugbug-push-schedules.json artifact on backstop pushes too. r=taskgraph-reviewers,bhearsum DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328437\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/optimize/bugbug.py", "taskcluster/gecko_taskgraph/test/test_util_bugbug.py", "taskcluster/gecko_taskgraph/util/bugbug.py", "taskcluster/gecko_taskgraph/util/chunking.py", "taskcluster/test/test_mach_try_auto.py"], "git_node": "fa47aa596b11a8e0c29c1044afa5f998d224875b", "git_parents": ["76f4087a874d00e304db7efedffb88d7a5ab6dc7"], "node": "159eabba5a8a2f13e1d2763259dbccddb518de61", "parents": ["30d0cd173e48c25436004958f576cdc1cc0e8123"], "tags": []}, {"author": "Kaitlyn \u003ckandres@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074586 - Add telemetry to the redesigned private browsing window. r=daisuke\n\nEvents added, in the aboutprivatebrowsing category, which bug 2076954\nemptied when the expiring click telemetry was removed:\n\n- intro_animation_played: the intro animation ran. It plays once per profile,\n  so this counts profiles that saw it rather than plays.\n- click_private_window_basics_link: the \"Private Window basics\" link was\n  clicked. aboutPrivateBrowsing.js has recorded to this name since bug 2063407\n  without the metric existing, so that call did nothing until now.\n- basics_modal_shown: the spotlight that link opens was shown. Recorded before\n  the dialog call, which resolves on close rather than on open.\n\nprivateWindowRedesign is also marked as having exposure, and an exposure event\nis recorded when the redesigned page renders. The feature declared\nhasExposure: false, so recordExposureEvent was a no-op and nothing\ndistinguished users who saw the treatment from those merely enrolled.\n\nSearches from the private browsing search box are not recorded here: the\nexisting urlbar.engagement event already covers them, with sap=handoff and\nwindow_mode=private.\n\nTests cover: the intro event records on the first run and not on later runs or\nunder reduced motion; the basics link click records; the spotlight impression\nrecords, with the dialog stubbed since it otherwise stays open; and an exposure\nevent is recorded once enrolled in privateWindowRedesign.\n\nSpotlight button clicks and promo impressions, clicks and dismissals are left\nto the messaging system, which already records them with the message id.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328539\n", "files": ["browser/actors/AboutPrivateBrowsingChild.sys.mjs", "browser/actors/AboutPrivateBrowsingParent.sys.mjs", "browser/components/privatebrowsing/content/aboutPrivateBrowsing.js", "browser/components/privatebrowsing/metrics.yaml", "browser/components/privatebrowsing/test/browser/browser.toml", "browser/components/privatebrowsing/test/browser/browser_privatebrowsing_redesign_telemetry.js", "toolkit/components/nimbus/FeatureManifest.yaml"], "git_node": "9666e42288be41a2aead4608d294496ddb989223", "git_parents": ["fa47aa596b11a8e0c29c1044afa5f998d224875b"], "node": "e88ebd1acff8ecd2c338dcd67d7ee05ef0aee373", "parents": ["159eabba5a8a2f13e1d2763259dbccddb518de61"], "tags": []}, {"author": "Sam Johnson \u003csam@scj.me\u003e", "branch": "default", "desc": "Bug 2057771 - Fix Nova compact mode panel border radius concentricity. r=desktop-theme-reviewers,reusable-components-reviewers,akulyk\n\nUpdates the menu item radius to reflect reality (the items were displaying with 14px as they are too short to display 16px) and updates the panel radius to be concentric (by adding the now-consistent item radius and the margin together).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327726\n", "files": ["toolkit/themes/shared/design-system/src/panel.css"], "git_node": "5c46385e59ac1ba2b65deb99784e25195d3fce5f", "git_parents": ["9666e42288be41a2aead4608d294496ddb989223"], "node": "176b59c713265269ebc17761793b98cb7d004cde", "parents": ["e88ebd1acff8ecd2c338dcd67d7ee05ef0aee373"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077997 - Use the WebIDL spelling of maxPacketLifeTime in the dcsctp interop test. r=webrtc-reviewers,bwc\n\nThe test passed the dictionary member as maxPacketLifetime, which is ignored,\nso its limited-lifetime channels were reliable ones.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330656\n", "files": ["dom/media/webrtc/tests/mochitests/test_dataChannel_dcsctp_interop.html"], "git_node": "26560438237fdd9cb99ce6498b283b3e62c775bb", "git_parents": ["5c46385e59ac1ba2b65deb99784e25195d3fce5f"], "node": "ad67a716e919b66540379bdab942e84d10940ebd", "parents": ["176b59c713265269ebc17761793b98cb7d004cde"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077997 - Give dcsctp a real clock by implementing DcSctpSocketCallbacks::Now(). r=webrtc-reviewers,bwc\n\nWithout it dcsctp ran on the default clock of the callbacks interface, which\nalways returns zero, so message lifetimes never expired and the retransmission\ntimeout never adapted to the measured round trip time.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330657\n", "files": ["dom/media/webrtc/tests/mochitests/test_dataChannel_dcsctp_interop.html", "netwerk/sctp/datachannel/DataChannelDcSctp.cpp", "netwerk/sctp/datachannel/DataChannelDcSctp.h"], "git_node": "775ebad2ccf39ecddc948b6b53ff8f3dd485321a", "git_parents": ["26560438237fdd9cb99ce6498b283b3e62c775bb"], "node": "3ef2cc6c1707a06838964002f30f9be2dd00989b", "parents": ["ad67a716e919b66540379bdab942e84d10940ebd"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076217 - Fix resolve_metadata tag fallback passing a bare string to resolve_tests. r=taskgraph-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329634\n", "files": ["testing/mozbase/moztest/moztest/resolve.py", "testing/mozbase/moztest/tests/data/srcdir/kiwi/browser.toml", "testing/mozbase/moztest/tests/test_resolve.py"], "git_node": "516aada8351ff1c0d1f60b2140e848b925d172d6", "git_parents": ["775ebad2ccf39ecddc948b6b53ff8f3dd485321a"], "node": "cd539dd3fca858bfbafabbd14a61460a975353fd", "parents": ["3ef2cc6c1707a06838964002f30f9be2dd00989b"], "tags": []}, {"author": "Jan-Erik Rediger \u003cjrediger@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078697 - Set the event deceleration bool pref as a bool r=chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331268\n", "files": ["testing/gtest/mozilla/GTestRunner.cpp"], "git_node": "c7efc202c96f52e41ec7a4b217516a5fd65614e9", "git_parents": ["516aada8351ff1c0d1f60b2140e848b925d172d6"], "node": "f2297acc0bb936e63fa35903140e7492db4c0bf9", "parents": ["cd539dd3fca858bfbafabbd14a61460a975353fd"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1668766 - Let bugbug select 'when: files-changed' tasks in mach try auto. r=taskgraph-reviewers,bhearsum DONTBUILD\n\nThes