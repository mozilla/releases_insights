4cb7665b6beaa1503bc762ac2ec97e0a8dd", "git_parents": ["e5933e731bbfb66cf77160fc5ecbda107a3cd300"], "node": "794f36afe58ed8a6720b864dd84d792a4bf6c08b", "parents": ["83710f45de03b094d7afe06257b425c3a52f9bb6"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066247 - Turn Stocks widget off by default for all regions r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328656\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "d18eb1f48ba0bed5ccbc931c34e82ec3dda30ac2", "git_parents": ["995714cb7665b6beaa1503bc762ac2ec97e0a8dd"], "node": "939d7208f7d651a93e78571c58ef5946ace33a51", "parents": ["794f36afe58ed8a6720b864dd84d792a4bf6c08b"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074974 - Turn Recent Searches widget off by default for all regions r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328657\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "77d2f6dcec850434bad9adf31c223a6b957a1287", "git_parents": ["d18eb1f48ba0bed5ccbc931c34e82ec3dda30ac2"], "node": "f5b3197d6f2c27793c4966bca6faf7e519d9dd47", "parents": ["939d7208f7d651a93e78571c58ef5946ace33a51"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066245 - Make Crossword available to English locales outside PL, off by default r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328658\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "999e655d218e37e7a4c118d72bdace33b2f18794", "git_parents": ["77d2f6dcec850434bad9adf31c223a6b957a1287"], "node": "ad4573d7453dad3dfee532e9870b93e542484348", "parents": ["f5b3197d6f2c27793c4966bca6faf7e519d9dd47"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075001 - Add a pref to enforce widget market gating on Nightly r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328659\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "ab89d3208b304c9b19e1a57b8dda74fd8a675770", "git_parents": ["999e655d218e37e7a4c118d72bdace33b2f18794"], "node": "e5a50004dc58192b5f0749c48a0889b500477d19", "parents": ["ad4573d7453dad3dfee532e9870b93e542484348"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075271 - Stub the widget market prefs in newtab for older hosts r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328867\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "b470f2bc1f556740c5c5233dd63dd6413e259881", "git_parents": ["ab89d3208b304c9b19e1a57b8dda74fd8a675770"], "node": "78f4705d9e125ee5e16f7f8a3964b9752a121ad4", "parents": ["e5a50004dc58192b5f0749c48a0889b500477d19"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074619 - Use inspectRegexpInParent to gate sponsored subframe matching in the network observer - r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328566\n", "files": ["browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/test/browser/telemetry/browser_search_telemetry_subframe_click.js"], "git_node": "ec17ce9512d69adb756b7008785c7200c0ed43da", "git_parents": ["b470f2bc1f556740c5c5233dd63dd6413e259881"], "node": "dc9094484f2434349aa081dfec27d3663ca2d3ce", "parents": ["78f4705d9e125ee5e16f7f8a3964b9752a121ad4"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074830 - Stop reporting partitioned tracker cookie reads as allowed tracker cookies. r=emz,cookie-reviewers,valentin\n\nThis patch changes the cookie service to pass the partition reason to the\naccepted-cookie notification, and changes NotifyBlockingDecision to treat\nan allow decision carrying STATE_COOKIES_PARTITIONED_TRACKER as partitioned\naccess, so it no longer emits STATE_COOKIES_LOADED_TRACKER. The tracker\ncookie loaded event now keys on any basic tracking flag rather than the\ngeneric one.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328548\n", "files": ["netwerk/cookie/CookieService.cpp", "netwerk/cookie/CookieService.h", "toolkit/components/antitracking/ContentBlockingNotifier.cpp", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_partitioned_cookies.js"], "git_node": "e14aade4c7339bf9902db5aa43fe13f2701e5b45", "git_parents": ["ec17ce9512d69adb756b7008785c7200c0ed43da"], "node": "cce1dd8f1d7a044c586588d9ab2a6521065525ad", "parents": ["dc9094484f2434349aa081dfec27d3663ca2d3ce"], "tags": []}, {"author": "Jonathan Moss \u003cjmoss@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075352 - Extract coverage notes into the test task directory r=releng-reviewers,bhearsum\n\nUse the task-local grcov directory instead of the builder's object directory. This avoids Access denied when the build path is under another Windows user's profile. Keep coverage source mapping unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329038\n", "files": ["testing/mozharness/mozharness/mozilla/testing/codecoverage.py"], "git_node": "38c7b77eb5a7c4d544b6ab2e8f07f654a9bcceaf", "git_parents": ["e14aade4c7339bf9902db5aa43fe13f2701e5b45"], "node": "ebb75ba72e3e77bffe2dec9cd037ab821b6da56f", "parents": ["cce1dd8f1d7a044c586588d9ab2a6521065525ad"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075565 - Unpack the fetched crashreporter symbols zip instead of downloading it again. r=releng-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329151\n", "files": ["testing/mozharness/mozharness/mozilla/testing/testbase.py"], "git_node": "8052ce181b49166fd7e62a21e34fb2b2e95335e6", "git_parents": ["38c7b77eb5a7c4d544b6ab2e8f07f654a9bcceaf"], "node": "b80f733d77f4db8da03dd74eb4bc7d7aae41788f", "parents": ["ebb75ba72e3e77bffe2dec9cd037ab821b6da56f"], "tags": []}, {"author": "Leo McArdle \u003cleo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072146 - [devtools] add pref and toggle settings panel redesign r=devtools-reviewers,nchevobbe,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326127\n", "files": ["browser/app/profile/firefox.js", "devtools/client/definitions.js", "devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_settings_redesign_enabled.js", "devtools/client/jar.mn", "devtools/client/locales-preview/settings.ftl", "devtools/client/locales/jar.mn", "devtools/client/moz.build", "devtools/client/settings/index.html", "devtools/client/settings/moz.build", "devtools/client/settings/panel.js"], "git_node": "0a1424c35d597f51846d34a0b9b6565523cf910a", "git_parents": ["8052ce181b49166fd7e62a21e34fb2b2e95335e6"], "node