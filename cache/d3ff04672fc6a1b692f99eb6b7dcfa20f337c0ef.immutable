stentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ListenSheetIntegration.kt"], "git_node": "b2c5d3bd9ffd6d45c600477317fb959bc1a1a3f5", "git_parents": ["c76bd347f8dbd42bb8ce02c531ea5e724e91e626"], "node": "ae75a95f52881a7ffe3f43b9794abfac9004da4e", "parents": ["d31e076629b6c66eedc6aa5679c3f1a5e285821a"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067127 - Add a playback speed menu to the Listen player r=android-reviewers,calu,android-l10n-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329277\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/ListenSheet.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlaybackControls.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlaybackSpeedMenu.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/SpeedState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenReducerTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionServiceTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/ListenSheetTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ui/SpeedStateTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ListenSheetIntegration.kt"], "git_node": "1fe584174bfb03d9635f0cd2ab309ae68545b09e", "git_parents": ["b2c5d3bd9ffd6d45c600477317fb959bc1a1a3f5"], "node": "3677d249380fb7c496f4efb3f2d12649185c37b2", "parents": ["ae75a95f52881a7ffe3f43b9794abfac9004da4e"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077158 - Hide the Listen sheet on stop rather than removing it r=android-reviewers,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331649\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ListenSheetIntegration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/listentopage/ListenSheetIntegrationTest.kt"], "git_node": "c52468bafd58f87dc2a36b225fda3378463bd436", "git_parents": ["1fe584174bfb03d9635f0cd2ab309ae68545b09e"], "node": "1bd6c52479cf4057aebf6af0376c0e87f5106d90", "parents": ["3677d249380fb7c496f4efb3f2d12649185c37b2"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055065 - part 1: simplify PiP settings panels styles, use moz-toggle and moz-radio-group, and migrate subtitles panels strings r=fluent-reviewers,niklas,desktop-theme-reviewers,bolsson,dao\n\nThis patch modifies the subtitles and playback speed panels:\n- css: remove duplicate css and minimize use of class names (e.g. merged .box and .panel-fieldset into one, to represent a single panel)\n- css: simplified spacing rules for panels (e.g. use display: flex for content, no more overlapping padding rules in different parts of the panel)\n- css: use font menu type instead of sans-serif font family for better alignment and to be in line with Nova spec\n- css: section some player.css rules (panels, subtitles, playback rate, layout) to ease readability\n- css: add forced-colors rules for panels to improve contrast in Windows HCM\n- use moz-toggle to replace the bespoke .slider component, allowing to inherit any styles when Nova is enabled\n- use moz-radio-group instead of multiple divs for the subtitle font size options\n- fluent: due to use of reusable components, migrate existing strings to avoid retranslation\n\nVisually, only the subtitles panel carries Nova colours due to the new components. The playback speed panel will be updated in a follow-up revision.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328299\n", "files": ["python/l10n/fluent_migrations/bug_2055065_pip_moz_toggle_and_radio_group.py", "toolkit/components/pictureinpicture/content/player.js", "toolkit/components/pictureinpicture/content/player.xhtml", "toolkit/components/pictureinpicture/tests/browser_controlButtonClickFocus.js", "toolkit/components/pictureinpicture/tests/browser_controlsTabOrder.js", "toolkit/locales/en-US/toolkit/pictureinpicture/pictureinpicture.ftl", "toolkit/themes/shared/pictureinpicture/player.css"], "git_node": "920e4ceb63398d29865d77946535a386e7197b53", "git_parents": ["c52468bafd58f87dc2a36b225fda3378463bd436"], "node": "c084fcbe6c83aba32a7824ce990a6554a30f8d44", "parents": ["1bd6c52479cf4057aebf6af0376c0e87f5106d90"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055065 - part 2: update playback speed control panel for Nova r=desktop-theme-reviewers,niklas,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328710\n", "files": ["toolkit/themes/shared/pictureinpicture/player.css"], "git_node": "4ef7aee1417fd5accde394555a7f80d8464f462f", "git_parents": ["920e4ceb63398d29865d77946535a386e7197b53"], "node": "6cbd5bb489162f34cd5f62053189769b029feda3", "parents": ["c084fcbe6c83aba32a7824ce990a6554a30f8d44"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055065 - part 3: update misc. control styles and focus outline for Nova r=niklas,desktop-theme-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329059\n", "files": ["toolkit/themes/shared/pictureinpicture/player.css"], "git_node": "d1ffb1f6367e6ea6bad835b2d8b0655a6e0702f4", "git_parents": ["4ef7aee1417fd5accde394555a7f80d8464f462f"], "node": "5249814477365c698490e4802dafbe320b3279fe", "parents": ["6cbd5bb489162f34cd5f62053189769b029feda3"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2055065 - part 4: update playback speed and fullscreen icons for PiP Nova r=desktop-theme-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330865\n", "files": ["toolkit/themes/shared/media/picture-in-picture-enter-fullscreen-button.svg", "toolkit/themes/shared/media/picture-in-picture-exit-fullscreen-button.svg", "toolkit/themes/shared/media/playback-speed-button.svg", "toolkit/themes/shared/pictureinpicture/player.css"], "git_node": "d59d7218873180a49119a1304e95c5963ac38697", "git_parents": ["d1ffb1f6367e6ea6bad835b2d8b0655a6e0702f4"], "node": "ac8d33f3cd248a2b68f1227df6ecad5a7ad5a5a8", "parents": ["5249814477365c698490e4802dafbe320b3279fe"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 1740752 - Part 1: Refactor nursery active chunk range r=jonco\n\nWe can't just start allocating in any chunk; we can either start from\nthe beginning, after evicting a space or when switching spaces, or we\ncan continue with the next chunk.\n\n- Refactor to better name the range of chunks used for allocation since\n  the last collection.  Allow a space to have *no* active chunks; this is\n  the case in the promote-only nursery configuration.\n\n- Add a Space::chunk accessor that ensures the chunk is in the active\n  range.\n\n- Don't bother ensuring that fromspace has an current chunk.\n\n- Don't eagerly flip the gckind of a space's allocated but inactive\n  pages; lazily flip them just before allocation.\n\n- Simplify poisoning under generational GC zeal.\n\n- Simplify nursery growth/shrinkage under generational GC zeal.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325424\n", "files": ["js/src/gc/Nursery.cpp", "js/src/gc/Nursery.h"], "git_node": "b42a75ff2ed9c41e00f17953b04c1e1501992ea1", "git_parents": ["d59d7218873180a49119a1304e95c5963ac38697"], "node": "833934ec9904c2101783bd4396693d092b4ba35e", "parents": ["ac8d33f3cd248a2b68f1227df6ecad5a7ad5a5a8"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 1740752 - Part 2: Implement contiguous nursery mode r=jonco\n\nShould speed up chunk acquisition / release and isInside checks.\nEnabled if -DJS_CONTIGUOUS_NURSERY.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325425\n", "files": ["js/src/gc/Nursery-inl.h", "js/src/gc/Nursery.cpp", "js/src/gc/Nursery.h", "js/src/gc/Scheduling.cpp"], "git_node": "d86105079ebfcbd567338d2f624b23d773a5f6bb", "git_parents": ["b42a75ff2ed9c41e00f17953b04c1e1501992ea1"], "node": "7d30c3ef5abb847356a6b3c5e258b006e978f2b6", "parents": ["833934ec9904c2101783bd4396693d092b4ba35e"], "tags": []}, {"author": "Andy Wingo \u003cwingo@igalia.com\u003e", "branch": "default", "desc": "Bug 1740752 - Part 3: Use contiguous nursery on 64-bit platforms r=jonco\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325427\n", "files": ["js/src/gc/Nursery.h"], "git_node": "91069a2b12069717786e1de01a54b96ae3283383", "git_parents": ["d86105079ebfcbd567338d2f624b23d773a5f6bb"], "node": "e89fabfcc44148da6f9e3601e84199574e5d06c8", "parents": ["7d30c3ef5abb847356a6b3c5e258b006e978f2b6"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074898 - Ensure bottom chrome dividers are shown on top of the top most bar r=android-reviewers,calu\" for causing fenix failures.\n\nThis reverts commit ce2c92f6677561a0f3eefb0301d3ec8ef6cb2242.\n", "files": ["mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserDisplayToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserEditToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/BrowserToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/NavigationBar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/concept/BrowserToolbarTestTags.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/main/java/mozilla/components/compose/browser/toolbar/ui/FullDisplayToolbar.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserDisplayToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserEditToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/BrowserToolbarTest.kt", "mobile/android/android-components/components/compose/browser-toolbar/src/test/java/mozilla/components/compose/browser/toolbar/NavigationBarTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/BrowserToolbarComposable.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/toolbar/TopDividerColumn.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeNavigationBar.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/toolbar/HomeToolbarComposable.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/toolbar/TopDividerColumnTest.kt"], "git_node": "25f17001b54be9db03ea1789a0206e6a4e02a6ff", "git_parents": ["91069a2b12069717786e1de01a54b96ae3283383"], "node": "383353e5535d32e1168ecf34dcc55e20f3fb4a6d", "parents": ["e89fabfcc44148da6f9e3601e84199574e5d06c8"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079372 - Set messaging-system-action.hasOpenedExtensions when about:welcome opens AMO r=aminomancer,omc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331695\n", "files": ["browser/components/aboutwelcome/modules/AboutWelcomeDefaults.sys.mjs"], "git_node": "fdae0a49f18f2224ea4590e1398fd869f4c51929", "git_parents": ["25f17001b54be9db03ea1789a0206e6a4e02a6ff"], "node": "8c81e20c73b605e05229a0daa9e226823ae6cbac", "parents": ["383353e5535d32e1168ecf34dcc55e20f3fb4a6d"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add a characterization for OPFS behavior for model downloading; r=nordzilla,ai-platform-reviewers\n\nThis is a test to show the current behavior of OPFS with a private browsing\nwindow, when you get a somewhat spurious error when a Private Browsing\nwindow just happens to be on top. This sets the stage for the following\nfix.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328143\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js"], "git_node": "1b6e86ce5efb8f4f0d37f6023e217526a17d8bd3", "git_parents": ["fdae0a49f18f2224ea4590e1398fd869f4c51929"], "node": "2286effd58c6f71576aee46dca2078ba8dccc0ec", "parents": ["8c81e20c73b605e05229a0daa9e226823ae6cbac"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove incorrect isPrivateBrowsing call and test; r=nordzilla,ai-platform-reviewers\n\nThis code uses the most recent browsing window, and doesn't work correctly.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328144\n", "files": ["toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_privatebrowsing.js"], "git_node": "638248dc0471cb526a3244bd9b2ffaf704bab0f4", "git_parents": ["1b6e86ce5efb8f4f0d37f6023e217526a17d8bd3"], "node": "e8dbd7dc7acc9f754cebe4a46002f4dacca498f9", "parents": ["2286effd58c6f71576aee46dca2078ba8dccc0ec"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Re-work OPFS.sys.mjs to pass TypeScript and remove dead code; r=nordzilla,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328145\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_cache.js"], "git_node": "28bcf006fe2f610a01261a91c8576d58002422ba", "git_parents": ["638248dc0471cb526a3244bd9b2ffaf704bab0f4"], "node": "0c666187d9bfcf895b87d54a44bea8228315c096", "parents": ["e8dbd7dc7acc9f754cebe4a46002f4dacca498f9"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Remove OPFS usage in workers; r=nordzilla,ai-platform-reviewers\n\nThe inference process workers reached OPFS through their own global, which\nmeant two code paths for the same storage and a copy of the file lookup in\neach pipeline. The parent already reads the file when it resolves a model, so\nhave it send the blob rather than a path, and let the worker build the\nResponse it needs from that.\n\nImporting OPFS into a worker also failed outright, since its XPCOMUtils\nimport needs a privileged global: browser_ml_native_backend_error.js and\nbrowser_ml_smollm2_chat.js both died with \"Cu is not defined\" before this.\n\nWith nothing loading OPFS outside the parent, the worker plumbing goes too.\nOPFS.toResponse had no other caller, and the module no longer needs the\nIN_WORKER branch or the globalThis.navigator fallback.\n\nThe OPFS tests still cover toResponse and are fixed up later in the series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328146\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/content/backends/StaticEmbeddingsPipeline.mjs", "toolkit/components/ml/tests/browser/browser_ml_opfs.js"], "git_node": "62fd45d6c0c450b256da218f648bbcef96f83e27", "git_parents": ["28bcf006fe2f610a01261a91c8576d58002422ba"], "node": "9677c6032df4ff409b886d6c33d72d94598352e1", "parents": ["0c666187d9bfcf895b87d54a44bea8228315c096"], "tags": []}, {"author": "Greg Tatum \u003ctatum.creative@gmail.com\u003e", "branch": "default", "desc": "Bug 2012843 - Add an owned HiddenFrame for OPFS; r=nordzilla,ai-platform-reviewers\n\nThe previous implemntation had correctness issues because file handles were\ntied to the lifetime of the window being used. This commit explicitly has\nwindow lifetime management in OPFS to fix this correctness issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328147\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_engine_lifetime.js", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js"], "git_node": "7863891af1e45e2299fa6fc3acb84a2914204e37", "git_parents": ["62fd45d6c0c450b256da218f648bbcef96f83e27"], "node": "4e986f7b41b703aa910e564d2fc02fc075df840e", "parents": ["9677c6032df4ff409b886d6c33d72d94598352e1"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2077257 - Improve ThreadSafeWeakPtrHashKey behaviour during an object's destructor, r=xpcom-reviewers,dom-storage-reviewers,emilio,janv\n\nCurrently ThreadSafeWeakPtrHashKey is defined fully in terms of the\nconcrete referenced type, meaning that it cannot work late during an\nobject's lifecycle, after the object's refcount has reached 0 and during\nthe destructor. I expect that removing entries from a table during the\ndestructor is a clear use-case for this type, meaning that it would be\nbetter if we supported this.\n\nThis patch does this by simplifying the handling of `ThreadSafeWeakPtr`\nsuch that it's used directly, and slightly improving the ergonomics of\nthe underlying type so that it can be used directly in this way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331272\n", "files": ["dom/indexedDB/IDBDatabase.cpp", "dom/indexedDB/IDBDatabase.h", "gfx/2d/2D.h", "gfx/layers/AndroidImageReader.cpp", "gfx/layers/wr/WebRenderBridgeChild.cpp", "gfx/layers/wr/WebRenderBridgeChild.h", "mfbt/ThreadSafeWeakPtr.h", "xpcom/ds/nsHashKeys.h", "xpcom/ds/nsTHashMap.h", "xpcom/tests/gtest/TestHashtables.cpp"], "git_node": "41c39394fafbc559ceecac7c803efb6a21ab8c16", "git_parents": ["7863891af1e45e2299fa6fc3acb84a2914204e37"], "node": "da9927b0fec63a1a6644c60eff08516ba06bd715", "parents": ["4e986f7b41b703aa910e564d2fc02fc075df840e"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067647 - Show correct origin for pointerlock warning r=smaug\n\nLike previous changes for Fullscreen warning, the pointer lock warning must also use the top-most origin.\n\nThis patch also removes the use of the deprecated .fullscreen attribute in one place.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329581\n", "files": ["browser/actors/PointerLockParent.sys.mjs", "dom/tests/browser/browser_pointerlock_warning.js"], "git_node": "198804f5a8db1f5f29874bd07f5ffb605fc526fb", "git_parents": ["41c39394fafbc559ceecac7c803efb6a21ab8c16"], "node": "d3486cf9329b82f72646ba5f573c7a31195a878c", "parents": ["da9927b0fec63a1a6644c60eff08516ba06bd715"], "tags": []}, {"author": "MoHan Zhang \u003cmzhang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075320 - Rename the AITab chat tool to generate_page and gate the pages prompt module on the AITab pref r=rrando,omarg\n\nThe chat tool that creates an AITab is renamed generate_page: models read\n\"page\" as the artifact the user asked for (\"make this a page\", \"save this as a\npage\"), while \"aitab\" is a product name they never see in user requests. Only\nthe tool name and the focus parameter's description change; the GENERATE_AITAB\nconstant and the AITab module keep their names.\n\nThe chat prompt's guidance for that tool lives in a `pages` module in Remote\nSettings. buildChatSystemPrompt now skips chat modules listed in\nGATED_CHAT_MODULES while their pref is off, so the model is never taught about\na tool that filterFeatureGatedTools does not give it: with\nbrowser.smartwindow.aitab.enabled off the served prompt is identical to\ntoday's, with it on the pages module is appended after response-rules. An\ninstruction-only gate (\"only when generate_page is in your tool list\") did not\nhold in evaluation: with the tool absent, Gemini still closed 35% of its\nreplies with a page offer.\n\nShipped builds have neither this gate nor the rename, so Remote Settings\npublishes the module under chat params major 12 and this patch moves\nFEATURE_MAJOR_VERSIONS.chat from 11 to 12 (still 10 with the mistralRelease\npref off). Release 157 and beta 158 keep reading major 11, which is unchanged;\nonly builds that carry this patch select v12, so the tool name, the gate and\nthe guidance always travel together. The packaged dump already carries the\nv12 and pages records.\n\nReland: the gating test now drives the real pages module from the v12\nmanifest instead of injecting one (an injected copy at the same major lost\nto the packaged record in findModule), and the UI test helper's mock chat\nrecords move to major 12 to match FEATURE_MAJOR_VERSIONS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328921\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "6c0268614bc085572044b6fca7e993a86a34e306", "git_parents": ["198804f5a8db1f5f29874bd07f5ffb605fc526fb"], "node": "e1bb3520a082121269f140f2e3b1addda81cb2d7", "parents": ["d3486cf9329b82f72646ba5f573c7a31195a878c"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079271 - Fix betasim failure hit by test_ext_web_accessible_workers.js. r=robwu\n\nThe SharedWorker constructor is not raising an AbortError anymore since Bug 2039873 changes have been landed,\nunlike it was happening when the test was originally written and that part of the test should have been updated\naccordingly when the test was refreshed to preparing it to its landing.\n\nThe failure was only hit on beta simulation because on nightly builds MOZ_DIAGNOSTIC_ASSERT_ENABLED\nis set to true and that part of the test was only going to run on builds where MOZ_DIAGNOSTIC_ASSERT_ENABLED\nis false.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331714\n", "files": ["toolkit/components/extensions/test/xpcshell/test_ext_web_accessible_workers.js"], "git_node": "85771d5ce293ad709b0302f2bf3d7ecf2f534b8f", "git_parents": ["6c0268614bc085572044b6fca7e993a86a34e306"], "node": "a5ed3c05b9507a98e6e939e1e6bd3d663a076806", "parents": ["e1bb3520a082121269f140f2e3b1addda81cb2d7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079407 - Update cssparser to current main tip. r=firefox-style-system-reviewers,supply-chain-reviewers,dshin\n\nThis needs a tweak in servo/ for a behavior change on how arbitrary\nsubstitution functions are dealt with, see the discussion in\nhttps://github.com/servo/rust-cssparser/pull/456.\n\nI wanted to do this once\nhttps://github.com/servo/rust-cssparser/pull/457 was reviewed but that's\ntaking a while and I need to work on other bugfixes too, so landing the\nupdate to main first.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331712\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "servo/components/style/properties/mod.rs", "supply-chain/audits.toml", "third_party/rust/cssparser-macros/.cargo-checksum.json", "third_party/rust/cssparser-macros/Cargo.toml", "third_party/rust/cssparser/.cargo-checksum.json", "third_party/rust/cssparser/src/parser.rs", "third_party/rust/cssparser/src/rules_and_declarations.rs", "third_party/rust/cssparser/src/size_of_tests.rs", "third_party/rust/cssparser/src/tokenizer.rs"], "git_node": "a528158ea97d1a7af55cd9b6df6aaf53121f3eaa", "git_parents": ["85771d5ce293ad709b0302f2bf3d7ecf2f534b8f"], "node": "71ce76530c5223b6e2a9db6499b8ebea19d29f06", "parents": ["a5ed3c05b9507a98e6e939e1e6bd3d663a076806"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079188 - Expose the CSS namespace in workers and worklets behind a preference; r=emilio,webidl,firefox-style-system-reviewers\" for causing hazard failures on CSS.cpp.\n\nThis reverts commit a6bc7652b48848692f405ce8b7a6965fde5105ba.\n", "files": ["dom/webidl/CSS.webidl", "dom/worklet/WorkletCommon.h", "dom/worklet/WorkletGlobalScope.cpp", "dom/worklet/moz.build", "layout/style/CSS.cpp", "layout/style/CSS.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "e89ab4a0af790e77d4eb5625bfb4bcaab18c65b3", "git_parents": ["a528158ea97d1a7af55cd9b6df6aaf53121f3eaa"], "node": "26eddf95c7e134fc38497e6c99ab8c0d39da1296", "parents": ["71ce76530c5223b6e2a9db6499b8ebea19d29f06"], "tags": []}, {"author": "Cosmin Sabou \u003ccsabou@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2030810 - add previousSessionEnd and impressions to ASRouter targeting environment and expose previousSessionEnd and profileLastUse to nimbus r=omc-reviewers,nimbus-reviewers,aminomancer,beth\" for causing xpcshell failures on test_TargetingContextRecorder.S\n\nThis reverts commit 733812907194480f3cbd7c247ac2f656a71c6bae.\n", "files": ["browser/components/asrouter/docs/targeting-attributes.md", "browser/components/asrouter/modules/ASRouter.sys.mjs", "browser/components/asrouter/modules/ASRouterTargeting.sys.mjs", "browser/components/asrouter/tests/unit/ASRouter.test.js", "browser/components/asrouter/tests/unit/ASRouterTargeting.test.js", "browser/components/asrouter/tests/unit/TargetingDocs.test.js", "toolkit/components/nimbus/lib/TargetingContextRecorder.sys.mjs", "toolkit/components/nimbus/metrics.yaml"], "git_node": "2e2ee2c450950ad3617af9af9398db0bdbefc1b9", "git_parents": ["e89ab4a0af790e77d4eb5625bfb4bcaab18c65b3"], "node": "0d06ea198325e738866467a099fdd7ec85a8396b", "parents": ["26eddf95c7e134fc38497e6c99ab8c0d39da1296"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076862 - Lock the SRD pref to prepare for cleanup r=settings-reviewers,hjones\n\nThe old settings page will start being non-functional as we remove more\nof the previous settings. Lock the pref so users get the new settings\ninstead of a reducing set of settings.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330017\n", "files": ["browser/app/profile/firefox.js"], "git_node": "a70a6f5f6d710ab92461320a6e4fdd7ba0a45074", "git_parents": ["2e2ee2c450950ad3617af9af9398db0bdbefc1b9"], "node": "49cdb74534f188ef974d4d7c0980616e8bea3e62", "parents": ["0d06ea198325e738866467a099fdd7ec85a8396b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078226 - Don't animate tab width changes when reduced motion is preferred. r=tabbrowser-reviewers,niklas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330993\n", "files": ["browser/base/content/test/browser-performance/browser_tabclose.js", "browser/base/content/test/browser-performance/browser_tabclose_grow.js", "browser/base/content/test/browser-performance/browser_tabopen.js", "browser/base/content/test/browser-performance/browser_tabopen_squeeze.js", "browser/base/content/test/browser-performance/browser_tabstrip_overflow_underflow.js", "browser/components/tabbrowser/test/browser/tabs/browser_tabCloseProbes.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "30b9d51ecdc4566c3e3067182809a165dfb3c4a8", "git_parents": ["a70a6f5f6d710ab92461320a6e4fdd7ba0a45074"], "node": "136a5e3fe1fe8959a339f75c1ba5da8ab54c83e9", "parents": ["49cdb74534f188ef974d4d7c0980616e8bea3e62"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2079026: When applying size-containment from content-visibility, more-robustly check whether we already have size-containment. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nNote that StyleContain::SIZE is a *bitfield with multiple bits* (including a\nbit for inline-axis containment and a different bit for block-axis\ncontainment).\n\nThe old code that existed before this patch was (mistakenly) using\n`mEffectiveContainment & StyleContain::SIZE` as a test for whether we're\nsize-contained in both axes; and it was using the result of that expression as\nan optimization to skip some code that might apply size-containment in both\naxes (which we can trivially skip if we're already size-contained in both\naxes).\n\nThis logic wasn't valid -- since `StyleContain::SIZE` is a multi-bit bitfield,\nthe old code was actually just checking whether we had size-containment\n**in any axis**, which is clearly insufficient as a justification to skip code\nthat would apply size containment in **both** axes.\n\nThis patch fixes this issue by actually robustly checking for size-containment\nin both axes, and only skipping the `HidesContent()` call if we're\nsize-contained in both axes (in which case we're going to return\nContainSizeAxes(true, true) in the function's final return statement).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331495\n", "files": ["layout/style/nsStyleStruct.cpp", "testing/web-platform/tests/css/css-contain/content-visibility/content-visibility-auto-with-inline-size-containment.html"], "git_node": "8e18f67fb66f6b0e86811716d2e1e7145ff7caa8", "git_parents": ["30b9d51ecdc4566c3e3067182809a165dfb3c4a8"], "node": "4ef46045616f25c792623a837e74f7f1bbcba3bd", "parents": ["136a5e3fe1fe8959a339f75c1ba5da8ab54c83e9"], "tags": []}, {"author": "python273 \u003ciam@python273.pw\u003e", "branch": "default", "desc": "Bug 1613369 - Use paired nearest alpha rounding and correct conversion expectations. r=gfx-reviewers,lsalzman,places-reviewers,mak\n\nPair nearest premultiplication with nearest unpremultiplication to preserve\nvalid stored pixels through both direct ImageData and native PNG round trips.\nRetain the PNG encoder's existing nearest division and cover the policy with\nexhaustive scalar/SIMD checks and canvas import/round-trip regression tests.\n\nCorrect the legacy gradient expectations to pixel-center sampling without\nincreasing tolerance. Update the four JPEG/WebP references and both PNG\ncompression variants of the 48x48 favicon whose pixels encode the old\npremultiplication policy. Independent pixel and raw-input encoder checks\nverify these changes; exact encoded-byte comparisons remain intact.\n\nRemove obsolete FAIL metadata for 18 element/offscreen/worker compositing\nreftests. Their actual canvas screenshots are unchanged, while nearest PNG\ndecoding improves their existing references enough to meet the unchanged\nfuzzy bounds. Filtered variants retain their existing expectations.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331332\n", "files": ["dom/canvas/test/mochitest.toml", "dom/canvas/test/test_canvas.html", "dom/canvas/test/test_canvas_png_roundtrip.html", "gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleGeneric.h", "gfx/2d/SwizzleNEON.h", "gfx/tests/gtest/TestSwizzle.cpp", "image/test/unit/image1.webp", "image/test/unit/image1png16x16.jpg", "image/test/unit/image1png64x64.jpg", "image/test/unit/image1quality50.webp", "image/test/unit/test_imgtools.js", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.pattern.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.drawImage.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.fillRect.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.pattern.w.html.ini", "toolkit/components/places/tests/favicons/expected-favicon-big48.ico.libz-rs.png", "toolkit/components/places/tests/favicons/expected-favicon-big48.ico.png"], "git_node": "f84faf54643eab533206cc2fe7c627e343e9b00a", "git_parents": ["8e18f67fb66f6b0e86811716d2e1e7145ff7caa8"], "node": "123afceb75bda2b6afb972aa23431a8a32d7cd5d", "parents": ["4ef46045616f25c792623a837e74f7f1bbcba3bd"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079242 - Add a sanity-check to DrawTargetSkia that SkImages don't outlive their snapshot if borrowed. r=lsalzman\n\nI was looking into adding a SkPdf-like back-end to Skia for GDI, and\nthis would've caught a few issues with it a lot more easily.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331586\n", "files": ["gfx/2d/DrawTargetSkia.cpp"], "git_node": "ab1f15f9c5c0b9ee9b0e9afe3d1c22738995930d", "git_parents": ["f84faf54643eab533206cc2fe7c627e343e9b00a"], "node": "1f58e16bb93a3f1c210af0846fb8e61ce91b3968", "parents": ["123afceb75bda2b6afb972aa23431a8a32d7cd5d"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2077967 - Don't cancel the loaded requests when the module graph is rejected in SyncModuleLoader. r=jonco\n\nSyncModuleLoader cancelled the loading of the entire module graph if it found\nthe module script is null. But the successfully fetched module still has its\nentry kept in mFetchingModules, which causes this crash.\n\nThe patch fixes the crash by iterating the loaded requests, which updates the\nentries in the module maps.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331640\n", "files": ["js/xpconnect/loader/SyncModuleLoader.cpp", "js/xpconnect/tests/unit/es6module_valid_import_target.js", "js/xpconnect/tests/unit/es6module_valid_then_missing_import.js", "js/xpconnect/tests/unit/test_import_es6_modules.js", "js/xpconnect/tests/unit/xpcshell.toml"], "git_node": "7c0e8afe5df6e1911bca1bb4e929f810972daaef", "git_parents": ["ab1f15f9c5c0b9ee9b0e9afe3d1c22738995930d"], "node": "5eee18ccd006aec00abf38d97e668ea2aed5e375", "parents": ["1f58e16bb93a3f1c210af0846fb8e61ce91b3968"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072379 - Add test; r=smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324886\n", "files": ["dom/base/test/fullscreen/mochitest.toml", "dom/base/test/fullscreen/test_fullscreen_iframe_multiple.html"], "git_node": "ded96f333df1ea23a5ca7ca6ca08a9640e6824ee", "git_parents": ["7c0e8afe5df6e1911bca1bb4e929f810972daaef"], "node": "11d803d9a2012a5e57be54c258c2013d617fa61e", "parents": ["5eee18ccd006aec00abf38d97e668ea2aed5e375"], "tags": []}, {"author": "Irene Ni \u003cini@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078816 - Enable a widget in the first content position of New Tab sections. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331422\n", "files": ["browser/extensions/newtab/common/PageLayoutVariants.mjs", "browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamAdmin/DiscoveryStreamAdmin.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/CardSections/CardSections.jsx", "browser/extensions/newtab/content-src/components/Widgets/Widgets.jsx", "browser/extensions/newtab/content-src/lib/selectLayoutRender.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/common/PageLayoutVariants.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamAdmin.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/CardSections.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Widgets.test.jsx", "browser/extensions/newtab/test/jest/content-src/lib/selectLayoutRender.test.js"], "git_node": "4e734b565a2e6ecae5465b075feaf388b1994587", "git_parents": ["ded96f333df1ea23a5ca7ca6ca08a9640e6824ee"], "node": "b43a4c60d389069ad955d71703904fa742f09f14", "parents": ["11d803d9a2012a5e57be54c258c2013d617fa61e"], "tags": []}, {"author": "Gela \u003cgmalekpour@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065488 - Part 3: Record telemetry for the lifecycle of the privacy notification worker r=android-reviewers,nalexander\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323768\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/pings.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorker.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationSchedulerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/privacyreport/PrivacyReportNotificationWorkerTest.kt"], "git_node": "355d8178d8927d4c8d0dddbdf49c96fa169d6a9c", "git_parents": ["4e734b565a2e6ecae5465b075feaf388b1994587"], "node": "8f1848bd8fd6db3cbe7b446f1962b1964c322305", "parents": ["b43a4c60d389069ad955d71703904fa742f09f14"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2076007 - Part 1: Give JSVAL_TYPE_UNDEFINED a tag that ARM64 materializes in one instruction. r=iain,devtools-reviewers,nchevobbe\n\nThe undefined type code 0x03 is odd, so its shifted tag\n0xfff9800000000000 spans two halfwords and every undefined Value that\nARM64 JIT code stores, pushes or compares against takes two instructions\nto build:\n\n  mov  x21, #0x800000000000\n  movk x21, #0xfff9, lsl #48\n  str  x21, [x23], #8\n\nMoving it to the unused code 0x06 gives 0xfffb000000000000, a single\nmovz:\n\n  mov  x21, #-0x5000000000000\n  str  x21, [x23], #8\n\nUndefined is not a number, a GC thing, or part of the null/object pair,\nso none of the tag ordering micro-optimizations constrain it; the new code\nstays below the private GC thing tag. x86-64 code is unaffected, since\nit materializes both tags with movabs.\n\nThe type code is visible in the execution tracer's value summary\nformat, so its VERSION goes to 4 and the two in-tree readers learn the\nnew code.\n\nOn a JetStream 3 run with an instrumented shell, 184,815 two-instruction\nundefined materializations (Baseline 122,976, Ion 61,629, other stubs\n210) become 185,754 single movz (Baseline 123,073, Ion 62,441, other\n240), with no two-instruction ones left. That is about 185,000\ninstructions, 740 KB of JIT code, per run. The JetStream 3 score is\nunchanged within noise (242.3 before, 241.1 after, three alternating\nruns each).\n\nFound with armlint.\n\nClaude-Session: https://claude.ai/code/session_01WsnsqJvQCmPUe3GWmsM77Q\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329492\n", "files": ["devtools/client/shared/components/reps/reps/value-summary-reader.mjs", "js/public/Debug.h", "js/public/Value.h", "js/src/jit-test/tests/debug/ExecutionTracer-traced-values.js"], "git_node": "8e3e01e7bc20c40184cf0747794b5762fcef1eb8", "git_parents": ["355d8178d8927d4c8d0dddbdf49c96fa169d6a9c"], "node": "812ec7da8457563cb1f07d7abede270171bfa8d3", "parents": ["8f1848bd8fd6db3cbe7b446f1962b1964c322305"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2076007 - Part 2: Give JSVAL_TYPE_INT32 a tag that ARM64 materializes in one instruction. r=iain,devtools-reviewers,nchevobbe\n\nThe int32 type code 0x01 is odd, so its shifted tag 0xfff8800000000000\nspans two halfwords, and an int32 Value constant takes three\ninstructions to build on ARM64, as when Baseline pushes an int constant:\n\n  mov  x16, #0x36\n  movk x16, #0x8000, lsl #32\n  movk x16, #0xfff8, lsl #48\n  sub  sp, x20, #8\n  str  x16, [x20, #-8]!\n\nMoving INT32 to 0x02 gives 0xfff9000000000000, which needs only one\nhalfword, so the middle movk goes away:\n\n  mov  x16, #0x36\n  movk x16, #0xfff9, lsl #48\n  sub  sp, x20, #8\n  str  x16, [x20, #-8]!\n\nA store of the bare tag likewise becomes a single movz. Double stays the\nonly tag below Int32, so isNumber's tag \u003c= Int32 test is unchanged and\n0x01 is left unused.\n\nBOOLEAN moves to 0x03 because ValueUpperExclShiftedNumberTag relies on\nit being the tag right after Int32 (now enforced by a static_assert).\nThat makes the boolean tag the one that spans two halfwords, but int32\nconstants are far more common. Boxing a register costs two instructions\nfor either tag before and after, since the backend already folds an\nodd tag into orr with a shifted operand.\n\nThe type codes are visible in the execution tracer's value summary\nformat. Part 1 already bumps its VERSION to 4, so the two in-tree readers\nlearn the new codes under the same version.\n\nOn a JetStream 3 run with an instrumented shell, not counting boxes,\nint32 tag and constant materializations drop from 1,030,866 to 687,678\ninstructions (Baseline 975,670 to 651,291, Ion 55,196 to 36,387) and\nboolean ones grow from 89,828 to 147,865, a net saving of about 285,000\ninstructions, 1.1 MB of JIT code, per run. The JetStream 3 score is\nunchanged within noise (242.1 before, 240.0 after, three alternating\nruns each).\n\nFound with armlint.\n\nClaude-Session: https://claude.ai/code/session_01WsnsqJvQCmPUe3GWmsM77Q\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329872\n", "files": ["devtools/client/shared/components/reps/reps/value-summary-reader.mjs", "js/public/Value.h", "js/src/jit-test/tests/debug/ExecutionTracer-traced-values.js"], "git_node": "08253de9fda7233fc4d2cf161e0f8b4d114a5cc8", "git_parents": ["8e3e01e7bc20c40184cf0747794b5762fcef1eb8"], "node": "b97ae330de16b04bf4f84023663458744dc94a2e", "parents": ["812ec7da8457563cb1f07d7abede270171bfa8d3"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075320 - Rename the AITab chat tool to generate_page and gate the pages prompt module on the AITab pref r=rrando,omarg\" for causing bc failures @browser_aitab_tool_ui.js.\n\nThis reverts commit 6c0268614bc085572044b6fca7e993a86a34e306.\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "6daceed19b567a8569120b82c3b54573fce9cdee", "git_parents": ["08253de9fda7233fc4d2cf161e0f8b4d114a5cc8"], "node": "e51eaff12321f94792b1522266094afe51dee531", "parents": ["b97ae330de16b04bf4f84023663458744dc94a2e"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076862 - Lock the SRD pref to prepare for cleanup r=settings-reviewers,hjones\" for causing xpc failures @test_UrlbarSearchUtils.js.s\n\nThis reverts commit a70a6f5f6d710ab92461320a6e4fdd7ba0a45074.\n", "files": ["browser/app/profile/firefox.js"], "git_node": "6df539005c41060e78a8460c85349b1826360f8c", "git_parents": ["6daceed19b567a8569120b82c3b54573fce9cdee"], "node": "b07158f571c8274358e72ec7fd7c0e34506513ee", "parents": ["e51eaff12321f94792b1522266094afe51dee531"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2012843 - Add an owned HiddenFrame for OPFS; r=nordzilla,ai-platform-reviewers\" for causing bc failures @browser_page_accessibility.js.\n\nThis reverts commit 7863891af1e45e2299fa6fc3acb84a2914204e37.\n\nRevert \"Bug 2012843 - Remove OPFS usage in workers; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 62fd45d6c0c450b256da218f648bbcef96f83e27.\n\nRevert \"Bug 2012843 - Re-work OPFS.sys.mjs to pass TypeScript and remove dead code; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 28bcf006fe2f610a01261a91c8576d58002422ba.\n\nRevert \"Bug 2012843 - Remove incorrect isPrivateBrowsing call and test; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 638248dc0471cb526a3244bd9b2ffaf704bab0f4.\n\nRevert \"Bug 2012843 - Add a characterization for OPFS behavior for model downloading; r=nordzilla,ai-platform-reviewers\"\n\nThis reverts commit 1b6e86ce5efb8f4f0d37f6023e217526a17d8bd3.\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/content/ModelHub.sys.mjs", "toolkit/components/ml/content/OPFS.sys.mjs", "toolkit/components/ml/content/Utils.sys.mjs", "toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/content/backends/StaticEmbeddingsPipeline.mjs", "toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_cache.js", "toolkit/components/ml/tests/browser/browser_ml_engine_lifetime.js", "toolkit/components/ml/tests/browser/browser_ml_opfs.js", "toolkit/components/ml/tests/browser/browser_ml_opfs_private_window.js", "toolkit/components/ml/tests/browser/browser_ml_privatebrowsing.js"], "git_node": "06609de4460400d70fb91bccf1da0772080f55fa", "git_parents": ["6df539005c41060e78a8460c85349b1826360f8c"], "node": "6ceb569c1c153123ce180d9402024591483915d3", "parents": ["b07158f571c8274358e72ec7fd7c0e34506513ee"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1740752 - Part 3: Use contiguous nursery on 64-bit platforms r=jonco\" for causing plain mochitest failures.\n\nThis reverts commit 91069a2b12069717786e1de01a54b96ae3283383.\n\nRevert \"Bug 1740752 - Part 2: Implement contiguous nursery mode r=jonco\"\n\nThis reverts commit d86105079ebfcbd567338d2f624b23d773a5f6bb.\n\nRevert \"Bug 1740752 - Part 1: Refactor nursery active chunk range r=jonco\"\n\nThis reverts commit b42a75ff2ed9c41e00f17953b04c1e1501992ea1.\n", "files": ["js/src/gc/Nursery-inl.h", "js/src/gc/Nursery.cpp", "js/src/gc/Nursery.h", "js/src/gc/Scheduling.cpp"], "git_node": "075edbfc73a9f56449c9b3b09b9b5f104ce4110f", "git_parents": ["06609de4460400d70fb91bccf1da0772080f55fa"], "node": "be346c29499e1396053b07a4e7f2f4a7fe84f475", "parents": ["6ceb569c1c153123ce180d9402024591483915d3"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074916 - Add prescan and scan to the SERP impression event, and report ad_uncategorized in ad_impression - r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331235\n", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/metrics.yaml", "browser/components/search/test/browser/telemetry/browser.toml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_abandonment.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_adImpression_component_skipCount_children.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_adImpression_component_skipCount_parent.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_engagement_fast_ad_click.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impressionAttributes.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impression_interrupted_load.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impression_scan.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_post_engine.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_sources_ads.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_visualSearch.js", "browser/components/search/test/browser/telemetry/head.js", "browser/components/search/test/unit/test_urlTelemetry_generic.js"], "git_node": "07b3e17165115edeccaf7ccc8c4a92c2996ccdcc", "git_parents": ["075edbfc73a9f56449c9b3b09b9b5f104ce4110f"], "node": "0ad28d053fb046a7507f3d2fed1979c63c57e3f1", "parents": ["be346c29499e1396053b07a4e7f2f4a7fe84f475"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057345: No longer ignore block-ellipsis in line-clamp containers. r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330276\n", "files": ["layout/generic/TextOverflow.cpp", "layout/generic/TextOverflow.h", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-auto-010.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-text-overflow-string-003.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-text-overflow-string-004.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-text-overflow-string-005.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/line-clamp-with-text-overflow-string-008.html.ini", "testing/web-platform/meta/css/css-overflow/line-clamp/webkit-line-clamp-037.html.ini"], "git_node": "067e028626bffa1ccb3245a95a1ecfc9274c5002", "git_parents": ["07b3e17165115edeccaf7ccc8c4a92c2996ccdcc"], "node": "8126a49bb6f3d16b3de3f51353a2c6bc0252fefb", "parents": ["0ad28d053fb046a7507f3d2fed1979c63c57e3f1"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076003: Force resume index to 0 for empty switches r=spidermonkey-reviewers,mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331505\n", "files": ["js/src/frontend/BytecodeEmitter.cpp", "js/src/jit-test/tests/parser/bug2076003.js"], "git_node": "97aeb2a19423bc7d843f3cfeb1b5bf15672090b3", "git_parents": ["067e028626bffa1ccb3245a95a1ecfc9274c5002"], "node": "4ce4044b5dd08e5f7e43eaad62ea28f13ef80abf", "parents": ["8126a49bb6f3d16b3de3f51353a2c6bc0252fefb"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068362 - Eagerly compile event handlers only when IsSafeToRunScript for r=smaug\n\nCurrently aDeferCompilation is only ever set for \u003cbody\u003e and \u003cframeset\u003e\nelements and the content attribute is one which is supposed to be\nforwarded to the window. nsXULElement also forwards to the window (so\nalso sets defer=false). This should only change behavior for those\nscenarios.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331252\n", "files": ["dom/events/EventListenerManager.cpp"], "git_node": "244b5a637f793b26b4ac50cb769e1e05c1fef6e4", "git_parents": ["97aeb2a19423bc7d843f3cfeb1b5bf15672090b3"], "node": "d756e8f2bbdd6ac1bf944dd540b325f81eccd164", "parents": ["4ce4044b5dd08e5f7e43eaad62ea28f13ef80abf"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2065482 - Don't ignore a closing curly bracket from within the declaration parser. r=firefox-style-system-reviewers,dshin,supply-chain-reviewers\n\nThis gets the behavior that matches other browsers and is a one-liner.\n\nIf you're in a block, `}` is the delimiter anyway (so the iterator can't\nsee it). Otherwise if you're not parsing qualified rules you go to the\nskip-until-semicolon path.\n\nThe spec is a bit broken here, see\nhttps://github.com/w3c/csswg-drafts/issues/14565, thus the tentative\ntest for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331713\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "supply-chain/audits.toml", "testing/web-platform/tests/css/cssom/style-attr-stray-braces.tentative.html", "third_party/rust/cssparser/.cargo-checksum.json", "third_party/rust/cssparser/src/rules_and_declarations.rs"], "git_node": "23f75c3ebb25e7353464682e40a61ffff4dce792", "git_parents": ["244b5a637f793b26b4ac50cb769e1e05c1fef6e4"], "node": "1ce28331ff835a3471744c9b68498fdda3524b54", "parents": ["d756e8f2bbdd6ac1bf944dd540b325f81eccd164"], "tags": []}, {"author": "Vanessa Prema \u003cvprema@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077566 - fix(pbw): Relay promo incorrectly showing for relay users r=omc-reviewers,aminomancer,groovecoder\n\nUPDATED ACCEPTANCE CRITERIA:\nInstead of not showing the promo to relay users logged into firefox. Now users who have not answered to the relay preference in their configuration will see the promo.\n\npromo should **not show **with the prefs in about:config:\n- browser.privateWindowRedesign.enabled = true\n- signon.firefoxRelay.feature = 'enabled' OR signon.firefoxRelay.feature = 'disabled'\n\npromo should **show** with the prefs in about:config:\n - browser.privateWindowRedesign.enabled = true\n - signon.firefoxRelay.feature = 'available' OR signon.firefoxRelay.feature = 'offered'\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330420\n", "files": ["browser/components/asrouter/modules/OnboardingMessageProvider.sys.mjs"], "git_node": "6660c8202b59bc896687ed3c3bf1cdf9648e2835", "git_parents": ["23f75c3ebb25e7353464682e40a61ffff4dce792"], "node": "712b36ffdf9dda342e8b9f02471dc13625932f27", "parents": ["1ce28331ff835a3471744c9b68498fdda3524b54"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2078419 - Remove native-share-sheet nimbus flag r=android-reviewers,npoon,lmccracken\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330928\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt"], "git_node": "fd00df6faf7e23874f905fd376b07cac93829c29", "git_parents": ["6660c8202b59bc896687ed3c3bf1cdf9648e2835"], "node": "ef42a7f940c103ded82855f8ea01aebc65f6ccff", "parents": ["712b36ffdf9dda342e8b9f02471dc13625932f27"], "tags": []}, {"author": "Travis Long \u003ctlong@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076957 - Renew expiring metrics counting non-synthesized active ticks. r=csadilek\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331697\n", "files": ["browser/modules/metrics.yaml"], "git_node": "8cf22fd0bd21b24d06d65f34a81aff8a40afc600", "git_parents": ["fd00df6faf7e23874f905fd376b07cac93829c29"], "node": "ff5e151dff6f4346aba9e5724d4e9ea24d5cdcc9", "parents": ["ef42a7f940c103ded82855f8ea01aebc65f6ccff"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079131 - Sort the render task graph into passes without the topological-sort crate. r=gfx-reviewers,nical\n\nCount each task's parents and assign passes level by level, instead of using the\ncrate's hash maps and its scan of all remaining tasks per pass. Task order within\na pass is now deterministic, and a task used as an input through a sub-rect is no\nlonger sorted separately from its own inputs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331499\n", "files": ["Cargo.lock", "gfx/wr/Cargo.lock", "gfx/wr/webrender/Cargo.toml", "gfx/wr/webrender/src/render_task_graph.rs", "third_party/rust/topological-sort/.cargo-checksum.json", "third_party/rust/topological-sort/.travis.yml", "third_party/rust/topological-sort/Cargo.toml", "third_party/rust/topological-sort/Cargo.toml.orig", "third_party/rust/topological-sort/LICENSE-APACHE", "third_party/rust/topological-sort/LICENSE-MIT", "third_party/rust/topological-sort/README.md", "third_party/rust/topological-sort/rustfmt.toml", "third_party/rust/topological-sort/src/lib.rs"], "git_node": "ceee5985ed800c9452e405550f335722b422cde6", "git_parents": ["8cf22fd0bd21b24d06d65f34a81aff8a40afc600"], "node": "876f4700b0a1ae90f2e71b3d9da0acf736fa6b49", "parents": ["ff5e151dff6f4346aba9e5724d4e9ea24d5cdcc9"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066119 - [ci] Run Gecko specific setup as part of run-task hook, r=taskgraph-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331255\n", "files": ["taskcluster/gecko_taskgraph/__init__.py", "taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/transforms/job/run_task.py", "taskcluster/scripts/run-task-setup.py"], "git_node": "0d0713b8eb1e6c2c2f641a28e451a5960a6d1481", "git_parents": ["ceee5985ed800c9452e405550f335722b422cde6"], "node": "52b41dcb9a29e57240e7560d22f920525eacf869", "parents": ["876f4700b0a1ae90f2e71b3d9da0acf736fa6b49"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077651 - Fix C++23 RefPtr conversion in __wrap_dlopen. r=glandium\n\nIn C++23, return handle treats the local RefPtr as an xvalue and selects\nits deleted operator T*() const&& conversion:\n\nerror: conversion function from 'const RefPtr\u003cT\u003e' to 'T *' invokes a deleted function\n|   operator T*() const&& = delete;\n\nUse handle.get() to return the raw pointer explicitly. AddDirectRef()\nkeeps the handle alive after the local RefPtr is destroyed.\n\nAlso, disable clang-formatting of the trampoline bytes to preserve their\nmanual layout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330547\n", "files": ["mozglue/linker/ElfLoader.cpp"], "git_node": "096e124bb5bea50f8a95144d454d3a1379253ac6", "git_parents": ["0d0713b8eb1e6c2c2f641a28e451a5960a6d1481"], "node": "bf26951e305428376e834acc5da92a0d13ee428f", "parents": ["52b41dcb9a29e57240e7560d22f920525eacf869"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076816 - Make BrowsingContext::HistoryID synced field CanSet::ParentOnly r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330605\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h"], "git_node": "65224b7a276562bca40b35db0eb27843ceb2a3ea", "git_parents": ["096e124bb5bea50f8a95144d454d3a1379253ac6"], "node": "bf40b0d3a89a57f65bc3907133afc7043b12eb38", "parents": ["bf26951e305428376e834acc5da92a0d13ee428f"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074916 - Add prescan and scan to the SERP impression event, and report ad_uncategorized in ad_impression - r=search-reviewers,scunnane\" for causing linting failures @SearchSERPTelemetry.sys.mjs.\n\nThis reverts commit 07b3e17165115edeccaf7ccc8c4a92c2996ccdcc.\n", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/metrics.yaml", "browser/components/search/test/browser/telemetry/browser.toml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_abandonment.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_adImpression_component_skipCount_children.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_adImpression_component_skipCount_parent.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_engagement_fast_ad_click.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impressionAttributes.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impression_interrupted_load.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impression_scan.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_post_engine.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_sources_ads.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_visualSearch.js", "browser/components/search/test/browser/telemetry/head.js", "browser/components/search/test/unit/test_urlTelemetry_generic.js"], "git_node": "2bf4ac8fe9d12e3ca45f0dc63d1b3cdd4f64dc9d", "git_parents": ["65224b7a276562bca40b35db0eb27843ceb2a3ea"], "node": "6e007830b79d424180cfd121d8a8e1f195826bda", "parents": ["bf40b0d3a89a57f65bc3907133afc7043b12eb38"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079080 - Pt 1 - Don't name WebRender shader parameters `sampler` r=gfx-reviewers,nical\n\n`sampler` is a reserved word in Vulkan GLSL, so cs_svg_filter_node could not be compiled to SPIR-V with glslang.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331473\n", "files": ["gfx/wr/webrender/res/cs_svg_filter_node.glsl"], "git_node": "62699341967c9b7c58c6f3ce2523048528577cb9", "git_parents": ["2bf4ac8fe9d12e3ca45f0dc63d1b3cdd4f64dc9d"], "node": "9ecc5bd51b05c292ab340de18a779fa7343ec660", "parents": ["6e007830b79d424180cfd121d8a8e1f195826bda"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2079080 - Pt 2 - Let WebRender's build take optimized shaders from a directory r=gfx-reviewers,nical\n\nWR_SHADER_OVERRIDE_DIR makes the build embed shaders from a directory in place of glslopt's output, so that other shader toolchains can be compared against glslopt with wrench and Gecko. Unset, the build is unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331474\n", "files": ["gfx/wr/webrender/build.rs"], "git_node": "4baad8a267158ada2c5880407618aa1ff282195b", "git_parents": ["62699341967c9b7c58c6f3ce2523048528577cb9"], "node": "e9a2b6e53d12f1686b0d3ee227d3335c99b18f8b", "parents": ["9ecc5bd51b05c292ab340de18a779fa7343ec660"], "tags": []}, {"author": "Hiroyuki Ikezoe \u003chikezoe.birchill@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076005 - Make the APZ event buffer max age prefs unsigned. r=canalun\n\nAlso assert that RecentEventsBuffer's max age is non-negative.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330655\n", "files": ["gfx/layers/apz/src/RecentEventsBuffer.h", "gfx/layers/apz/test/gtest/TestPinching.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "4186fa8e9a6d8b5e86cfe9bfde978885f22093da", "git_parents": ["4baad8a267158ada2c5880407618aa1ff282195b"], "node": "15eaf67ed602b115b15914f60cd303c8c1d34fc5", "parents": ["e9a2b6e53d12f1686b0d3ee227d3335c99b18f8b"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2062393 - Add newtab.opened_page_dwell_time to the metrics ping. - r=thecount,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323770\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/.eslintrc.mjs", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/DSCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/SafeAnchor/SafeAnchor.jsx", "browser/extensions/newtab/content-src/components/TopSites/TopSite.jsx", "browser/extensions/newtab/lib/NewTabGleanUtils.sys.mjs", "browser/extensions/newtab/lib/PlacesFeed.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser_newtab_ping.js", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/DSCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/SafeAnchor.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/TopSites/TopSite.test.jsx", "browser/extensions/newtab/test/xpcshell/test_NewTabGleanUtils.js", "browser/extensions/newtab/test/xpcshell/test_PlacesFeed.js", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "600f7e3b6fcec0f6bcec4671f4426962c6cdb9c0", "git_parents": ["4186fa8e9a6d8b5e86cfe9bfde978885f22093da"], "node": "83e65ab9be7846bce5e31ad37ebcaafff1ba4315", "parents": ["15eaf67ed602b115b15914f60cd303c8c1d34fc5"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078974 - Turn on widget market gating with every widget off by default r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331453\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "testing/profiles/common/user.js", "testing/profiles/xpcshell/user.js"], "git_node": "a3e238c1283fb34afc2b1f5d5baaaf352dbdc9df", "git_parents": ["600f7e3b6fcec0f6bcec4671f4426962c6cdb9c0"], "node": "11b639b866ae1d4269eef5fac3013583d4998543", "parents": ["83e65ab9be7846bce5e31ad37ebcaafff1ba4315"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064048 - Have Tab Groups read as menu items in VO r=tabbrowser-reviewers,niklas,mlucks\n\nIn the Smart Window's Organize Tabs menu, the View Tab Groups submenu's items (ie individual tab groups in SW \u003e Organize Tabs \u003e View Tab Groups) should be read as interactive menu items in VO.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329202\n", "files": ["browser/components/aiwindow/ui/components/smartwindow-group-tabs/smartwindow-group-tabs.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_interaction.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_tab_management.js", "browser/components/tabbrowser/content/tab-groups-list.mjs"], "git_node": "fb683ab494067d6d7d0a7ada9062d43ef63ddff1", "git_parents": ["a3e238c1283fb34afc2b1f5d5baaaf352dbdc9df"], "node": "3cbca7b9cf9552a0419ec159cbc854750154ce0a", "parents": ["11b639b866ae1d4269eef5fac3013583d4998543"], "tags": []}, {"author": "Feng Yu \u003cf3n67u@outlook.com\u003e", "branch": "default", "desc": "Bug 2073811 - Only use legacy Error fileName/lineNumber arguments if converting them has no side effects. r=spidermonkey-reviewers,mgaudet\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330299\n", "files": ["js/src/tests/non262/Error/legacy-fileName-lineNumber-args.js", "js/src/vm/ErrorObject.cpp"], "git_node": "eca675d2bdf82aa7cccde960624e258630212b72", "git_parents": ["fb683ab494067d6d7d0a7ada9062d43ef63ddff1"], "node": "e30c33036ad56d607b096cda9a1806b7e6bd7dc5", "parents": ["3cbca7b9cf9552a0419ec159cbc854750154ce0a"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076972 - Remove protocolhandler.mailto telemetry. r=Gijs,TravisLong\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330831\n", "files": ["browser/components/protocolhandler/WebProtocolHandlerRegistrar.sys.mjs", "browser/components/protocolhandler/metrics.yaml", "browser/components/tests/browser/browser_default_webprotocol_handler_mailto.js", "toolkit/components/glean/metrics_index.py", "toolkit/mozapps/handling/ContentDispatchChooser.sys.mjs", "toolkit/mozapps/handling/metrics.yaml"], "git_node": "a1319e483c54ebb109a1f9687f850d7a14f646a5", "git_parents": ["eca675d2bdf82aa7cccde960624e258630212b72"], "node": "51513e152c68ffa16b1386e4c62514a1dc1636e9", "parents": ["e30c33036ad56d607b096cda9a1806b7e6bd7dc5"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078840 - Move moz-box-item arrow key focus handling out of focus() r=reusable-components-reviewers,hjones\n\nThis keeps focus() compatible with HTMLElement.focus(options), which the\nHTMLElementTagNameMap types require.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331339\n", "files": ["toolkit/content/widgets/moz-box-group/moz-box-group.mjs", "toolkit/content/widgets/moz-box-item/moz-box-item.mjs"], "git_node": "874be38ec8f4952559577cf8c7e1079489ecb9b9", "git_parents": ["a1319e483c54ebb109a1f9687f850d7a14f646a5"], "node": "c29fc00464537044db7890cc88427afd69758dcf", "parents": ["51513e152c68ffa16b1386e4c62514a1dc1636e9"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 1997653 - Use named exports for UI Widgets component classes. r=settings-reviewers,reusable-components-reviewers,urlbar-reviewers,hjones,jteow,ngrato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331340\n", "files": ["browser/components/aiwindow/ui/components/ai-sff-form-review/ai-sff-form-review.mjs", "browser/components/contextualidentity/content/container-select.mjs", "browser/components/genai/content/page-assist.mjs", "browser/components/passwordmgr/content/login-doorhanger-username-field.mjs", "browser/components/preferences/findInPage.js", "browser/components/preferences/main.js", "browser/components/preferences/preferences.js", "browser/components/preferences/privacy.js", "browser/components/preferences/tests/applications/browser_applications_filter.js", "browser/components/preferences/tests/applications/browser_applications_selection.js", "browser/components/preferences/widgets/dialog-button/dialog-button.mjs", "browser/components/preferences/widgets/setting-control/setting-control.mjs", "browser/components/storybook/stories/icon-directory.stories.mjs", "browser/components/urlbar/content/SearchModeSwitcher.mjs", "toolkit/content/widgets/mach_commands.py", "toolkit/content/widgets/moz-badge/moz-badge.mjs", "toolkit/content/widgets/moz-box-button/moz-box-button.mjs", "toolkit/content/widgets/moz-box-group/moz-box-group.mjs", "toolkit/content/widgets/moz-box-item/moz-box-item.mjs", "toolkit/content/widgets/moz-box-link/moz-box-link.mjs", "toolkit/content/widgets/moz-button-group/moz-button-group.mjs", "toolkit/content/widgets/moz-button/moz-button.mjs", "toolkit/content/widgets/moz-card/moz-card.mjs", "toolkit/content/widgets/moz-checkbox/moz-checkbox.mjs", "toolkit/content/widgets/moz-fieldset/moz-fieldset.mjs", "toolkit/content/widgets/moz-five-star/moz-five-star.mjs", "toolkit/content/widgets/moz-input-color/moz-input-color.mjs", "too