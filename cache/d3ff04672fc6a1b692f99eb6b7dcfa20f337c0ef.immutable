9c\npl -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\npt-BR -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\npt-PT -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nrm -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nro -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nru -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nsk -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nsl -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nson -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nsq -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nsr -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nsv-SE -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nta -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nte -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nth -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\ntl -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\ntr -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\ntrs -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nuk -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nur -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nuz -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nvi -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nwo -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nxh -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nzam -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nzh-CN -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\nzh-TW -\u003e 418b1f9999f805953a13cc4f83583fdbacfc289c\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "bf0dd2eb06540125b9ba0d975d4c45095913f189", "git_parents": ["bb44c0986df5a41e75af8fcd9a0d7cd0f6ea34b3"], "node": "05420a6819b53aed3dd978967c6373b08d1157cf", "parents": ["00aee9f73dceb43700ca8194f7da3a420d2a0531"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075556 - Move the urlbar view's hover and selected states off the dimmed and toolbar button tokens. r=hjones,adw,desktop-theme-reviewers,reusable-components-reviewers,urlbar-reviewers\n\nUnder Nova's in-app themes, the row hover, the selected row and the urlbar box are a color-mix of currentColor approximating the toolbar button hover and active colors, and the selected row's text is currentColor. Webextension themes set --toolbarbutton-background-color-hover and -active through button_background_hover and button_background_active, and those colors may not contrast with the urlbar field, so the native theme and webextension themes take the ghost button hover color and SelectedItem instead.\n\nUnder prefers-contrast a selected row paints the list item hover pair, SelectedItem on SelectedItemText, and a hovered row stays a color-mix of currentColor so the two remain distinct.\n\nThe urlbar box doesn't reference the row hover token because the row's native theme value, ghost hover, resolves to SelectedItemText under forced colors.\n\nThe action button background derived from the row hover token and now spells out the values it resolved to, so it doesn't change; its missing high contrast values are bug 2075626.\n\nThe design system's test now requires every token family with a text color to declare one for each of its background variants, so the stylelint rule's message for a missing counterpart became obsolete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329285\n", "files": ["browser/themes/addons/aiwindow-nova/manifest.in.json", "browser/themes/addons/moz.build", "browser/themes/shared/search/searchbar.css", "browser/themes/shared/urlbar.css", "browser/themes/shared/urlbar/urlbar.tokens.css", "browser/themes/shared/urlbar/urlbar.tokens.json", "browser/themes/shared/urlbar/urlbarview.nova.tokens.json", "browser/themes/shared/urlbar/urlbarview.tokens.css", "browser/themes/shared/urlbar/urlbarview.tokens.json", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-paired-color-tokens.md", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs", "toolkit/themes/shared/design-system/tests/try-runner.js", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/use-paired-color-tokens.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.not-paired.tests.mjs"], "git_node": "4f64a8898108e6814e6140650468694af1b7b6a5", "git_parents": ["bf0dd2eb06540125b9ba0d975d4c45095913f189"], "node": "7cb6a56d514a5a06061b7479b7912e3c76584563", "parents": ["05420a6819b53aed3dd978967c6373b08d1157cf"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075556 - Move the web notification card's hover states off the dimmed background tokens. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329287\n", "files": ["browser/extensions/newtab/content-src/components/TopSitesHoverCard/CardWebNotifications/_CardWebNotifications.scss"], "git_node": "660cc474e58da70216cdadde4612eb34c5ab41e1", "git_parents": ["4f64a8898108e6814e6140650468694af1b7b6a5"], "node": "c4329643820f35831b185a73a2890b5929f20d48", "parents": ["7cb6a56d514a5a06061b7479b7912e3c76584563"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Report tab group adoption in the TabGroupRemoved event detail rather than on the group. r=kcochrane,tabbrowser-reviewers,extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329462\n", "files": ["browser/components/extensions/parent/ext-tabGroups.js", "browser/components/tabbrowser/content/tabgroup.mjs", "browser/components/tabbrowser/docs/tab-events.md"], "git_node": "3f478a6656b23d3255406f882763f2bbc55dce3d", "git_parents": ["660cc474e58da70216cdadde4612eb34c5ab41e1"], "node": "1acdb53bd9e8010ee20d4042e44d179986212a8f", "parents": ["c4329643820f35831b185a73a2890b5929f20d48"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Remove unused _pinnedUnscrollable. r=kcochrane,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329590\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab.mjs"], "git_node": "9fb298cd5568e85e7221d2a48302e36a8129b7bd", "git_parents": ["3f478a6656b23d3255406f882763f2bbc55dce3d"], "node": "020cc57eb2b2810a650da4c7a6830a064f957b92", "parents": ["1acdb53bd9e8010ee20d4042e44d179986212a8f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Replace the tab's _fullyOpen expando and Tabbrowser's tabAnimationsInProgress counter with a set of opening tabs in the tab strip. r=kcochrane,tabbrowser-reviewers,sidebar-reviewers\n\ntabAnimationsInProgress becomes the number of opening tabs plus gBrowser._removingTabs, so it can't drift out of step with the tabs; the old counter didn't return to zero on Windows try runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329593\n", "files": ["browser/base/content/test/browser-performance/browser_tabclose.js", "browser/base/content/test/browser-performance/head.js", "browser/components/sidebar/tests/browser/browser_vertical_tabs_fitts.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab.mjs", "browser/components/tabbrowser/content/tabs.mjs", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_horizontal_overflow.js", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_tab_group_expand_on_drop.js", "browser/components/tabbrowser/test/browser/tabs/browser_overflowScroll.js", "browser/components/tabbrowser/test/browser/tabs/browser_scroll_size_determination.js", "browser/components/tabbrowser/test/browser/tabs/browser_tabCloseProbes.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js", "testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "d969610cf36715dddff64cebb05d5ca48fbf0740", "git_parents": ["9fb298cd5568e85e7221d2a48302e36a8129b7bd"], "node": "7c1ec7b8c521ee706b7cda4e4fb638fe73717601", "parents": ["020cc57eb2b2810a650da4c7a6830a064f957b92"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Derive the tab's permanentKey from its browser. r=kcochrane,tabbrowser-reviewers\n\nA closed tab now returns undefined, since _endRemoveTab clears linkedBrowser; every reader works on live tabs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329768\n", "files": ["browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab.mjs"], "git_node": "3c5b87784f8127e1f4f33385b56a677ed2a8b02c", "git_parents": ["d969610cf36715dddff64cebb05d5ca48fbf0740"], "node": "3ce24771277510937203b4636b1fc93c535f25b1", "parents": ["7c1ec7b8c521ee706b7cda4e4fb638fe73717601"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Make the tab's canonicalUrl a public field. r=kcochrane,tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329770\n", "files": ["browser/components/tabbrowser/content/tab.mjs", "browser/components/tabnotes/TabNotesController.sys.mjs"], "git_node": "058a566a27230df0684fb661fe0e4b8eaa830093", "git_parents": ["3c5b87784f8127e1f4f33385b56a677ed2a8b02c"], "node": "4911e021c3f3e9f0579aeab2525e491adcf892e1", "parents": ["3ce24771277510937203b4636b1fc93c535f25b1"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "fd8b5f0d805ce26e053ccdf5e9e2e9521dd2c235", "git_parents": ["058a566a27230df0684fb661fe0e4b8eaa830093", "0813a05915398fda05345d5efded3504d96df558"], "node": "614ed728c5995a64e8f93cf6780ef0a3355b6f16", "parents": ["4911e021c3f3e9f0579aeab2525e491adcf892e1", "e914a00e171025a96f568c4ef6d67d1ae04c31ba"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076181 - Use the search-tabs icon for the list all tabs button in horizontal tab mode on macOS. r=desktop-theme-reviewers,akulyk\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329612\n", "files": ["browser/components/extensions/test/browser/browser_ext_tabs_hide.js", "browser/themes/shared/addons/extension-controlled.css", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "ddf89dbf4d3b665f5dc3719e482f22be321fd0ee", "git_parents": ["fd8b5f0d805ce26e053ccdf5e9e2e9521dd2c235"], "node": "03f788193636899e8fde2966ee40e9c07c43bc86", "parents": ["614ed728c5995a64e8f93cf6780ef0a3355b6f16"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075016 - Make the tab's canonicalUrl a public field. r=kcochrane,tabbrowser-reviewers,jsudiaman\" for causing marionette failures @ est_persist_closed_tabs_restore_manually.py\n\nThis reverts commit 058a566a27230df0684fb661fe0e4b8eaa830093.\n\nRevert \"Bug 2075016 - Derive the tab's permanentKey from its browser. r=kcochrane,tabbrowser-reviewers\"\n\nThis reverts commit 3c5b87784f8127e1f4f33385b56a677ed2a8b02c.\n\nRevert \"Bug 2075016 - Replace the tab's _fullyOpen expando and Tabbrowser's tabAnimationsInProgress counter with a set of opening tabs in the tab strip. r=kcochrane,tabbrowser-reviewers,sidebar-reviewers\"\n\nThis reverts commit d969610cf36715dddff64cebb05d5ca48fbf0740.\n\nRevert \"Bug 2075016 - Remove unused _pinnedUnscrollable. r=kcochrane,tabbrowser-reviewers\"\n\nThis reverts commit 9fb298cd5568e85e7221d2a48302e36a8129b7bd.\n\nRevert \"Bug 2075016 - Report tab group adoption in the TabGroupRemoved event detail rather than on the group. r=kcochrane,tabbrowser-reviewers,extension-reviewers,robwu\"\n\nThis reverts commit 3f478a6656b23d3255406f882763f2bbc55dce3d.\n", "files": ["browser/base/content/test/browser-performance/browser_tabclose.js", "browser/base/content/test/browser-performance/head.js", "browser/components/extensions/parent/ext-tabGroups.js", "browser/components/sidebar/tests/browser/browser_vertical_tabs_fitts.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab.mjs", "browser/components/tabbrowser/content/tabgroup.mjs", "browser/components/tabbrowser/content/tabs.mjs", "browser/components/tabbrowser/docs/tab-events.md", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_horizontal_overflow.js", "browser/components/tabbrowser/test/browser/dragdrop/browser_drag_tab_group_expand_on_drop.js", "browser/components/tabbrowser/test/browser/tabs/browser_overflowScroll.js", "browser/components/tabbrowser/test/browser/tabs/browser_scroll_size_determination.js", "browser/components/tabbrowser/test/browser/tabs/browser_tabCloseProbes.js", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js", "browser/components/tabnotes/TabNotesController.sys.mjs", "testing/mochitest/BrowserTestUtils/BrowserTestUtils.sys.mjs"], "git_node": "3bb0188f98c21d404ec984b6d75d85b43f16a921", "git_parents": ["ddf89dbf4d3b665f5dc3719e482f22be321fd0ee"], "node": "c7960e0d1a97289512c9f3cc4eedbf08ca76ea25", "parents": ["03f788193636899e8fde2966ee40e9c07c43bc86"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072828 - Extend expiry for local_network_access metric to Firefox 166. r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329712\n", "files": ["netwerk/metrics.yaml"], "git_node": "f75cf62900ed33f6d440fdbd5e1ca947