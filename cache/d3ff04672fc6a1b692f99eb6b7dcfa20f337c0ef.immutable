ting/web-platform/tests/css/css-grid/grid-lanes/grid-placement/grid-lanes-grid-placement-named-lines-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/column-negative-margin-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/column-negative-margin-003.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/row-negative-margin-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/row-negative-margin-003.html"], "git_node": "5a991196e742281017de6c06f5dffd73468b18f0", "git_parents": ["95ab85c042dc9b56e14c4dad49de7a748180fe3e"], "node": "1333eacacf6ce7e33bba144400da96ed449d3643", "parents": ["b9a52fd6cf85ae92ff499a2a7e4b357ceb6eef67"], "tags": []}, {"author": "Maurice Dauer \u003cmdauer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063318 - Compile cairo with assertions enabled, r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326999\n", "files": ["gfx/cairo/cairo/src/cairo-array.c", "gfx/cairo/cairo/src/moz.build", "gfx/cairo/moz.yaml", "gfx/cairo/patches/0050-Bug-2065397-array-bounds-check.patch", "gfx/cairo/patches/0050-Bug-2068367-bitmap-surface-tmp-buffer.patch", "gfx/cairo/patches/0051-Bug-2068367-bitmap-surface-tmp-buffer.patch"], "git_node": "852ee18b599fe3e6fc2be551f46f53a060d9ab1f", "git_parents": ["5a991196e742281017de6c06f5dffd73468b18f0"], "node": "5e30255231f009684d5f7b753bbffa0ad19d255f", "parents": ["1333eacacf6ce7e33bba144400da96ed449d3643"], "tags": []}, {"author": "delan azabani \u003cdazabani@igalia.com\u003e", "branch": "default", "desc": "Bug 2070868 - Invalidate `\u003cinput\u003e.labels` when `\u003clabel for\u003e` changes. r=edgar\n\n`\u003cinput\u003e` and other elements with `.labels` use LabelsNodeList to dynamically\nreflect the `\u003clabel\u003e` elements that reference it. while LabelsNodeList detects\nsome changes, like changes to ancestry (for implicit label association) and\nchanges to `\u003cinput type\u003e` (for `\u003cinput type=hidden\u003e`), it does not yet detect\nchanges to `\u003clabel for\u003e`.\n\nthis patch adds a call to SetDirty() in LabelsNodeList when AttributeChanged()\nis called for any `\u003clabel for\u003e` in the subtrees under observation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324913\n", "files": ["dom/base/ContentList.cpp", "testing/web-platform/meta/shadow-dom/reference-target/tentative/dom-mutation.html.ini", "testing/web-platform/tests/shadow-dom/reference-target/tentative/dom-mutation.html"], "git_node": "083ea1b66b13f522c3992737054c756c9fb68a77", "git_parents": ["852ee18b599fe3e6fc2be551f46f53a060d9ab1f"], "node": "4cb45a3df84613ebf9a79c8a59e0c5984df884eb", "parents": ["5e30255231f009684d5f7b753bbffa0ad19d255f"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075192 - Convert verifyGeneralSettingsItemsTest regression UI test to the efficiency framework r=aaronmt\n\nThe UI test successfully passed 25 on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328824\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsGeneralTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsGeneralTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsTest.kt"], "git_node": "48aa2468ee50163ad52fa88c8c643ed80677d8f7", "git_parents": ["083ea1b66b13f522c3992737054c756c9fb68a77"], "node": "e47dfd4cb7e3e078b6a4cbea97125f57972ecb96", "parents": ["4cb45a3df84613ebf9a79c8a59e0c5984df884eb"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Rename nsToolkitShellService to nsShellService and streamline the shared base class; r=gtk-reviewers,emilio\n\nRename nsToolkitShellService to nsShellService to better reflect its role as\nthe common base for platform-specific shell service implementations.\n\nMove the shared nsISupports implementation into the base class and update the\nplatform shell services to inherit it. Document the IsDefaultBrowser() virtual\nhook in preparation for adding a shared isDefaultBrowserAsync() implementation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328850\n", "files": ["browser/components/shell/moz.build", "browser/components/shell/nsGNOMEShellService.cpp", "browser/components/shell/nsGNOMEShellService.h", "browser/components/shell/nsMacShellService.h", "browser/components/shell/nsMacShellService.mm", "browser/components/shell/nsShellService.cpp", "browser/components/shell/nsShellService.h", "browser/components/shell/nsToolkitShellService.h", "browser/components/shell/nsWindowsShellService.cpp", "browser/components/shell/nsWindowsShellService.h"], "git_node": "d62eed02d8e0d85ba36f229d0569115dcc1ea10b", "git_parents": ["48aa2468ee50163ad52fa88c8c643ed80677d8f7"], "node": "736b684d3fd959be7cce280af6fb896e9ec35985", "parents": ["e47dfd4cb7e3e078b6a4cbea97125f57972ecb96"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Add isDefaultBrowserAsync() to nsIShellService; r=gtk-reviewers,emilio\n\nAdd an asynchronous variant of isDefaultBrowser() to nsIShellService and\nexpose it through ShellService.\n\nProvide a shared implementation in nsShellService that calls the existing\nsynchronous platform-specific IsDefaultBrowser() implementation and immediately\nresolves the result. Platform shell services use this implementation for now,\nallowing callers to migrate to the async API before the Linux implementation is\nmade truly asynchronous.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328127\n", "files": ["browser/components/shell/ShellService.sys.mjs", "browser/components/shell/nsGNOMEShellService.cpp", "browser/components/shell/nsIShellService.idl", "browser/components/shell/nsMacShellService.mm", "browser/components/shell/nsShellService.cpp", "browser/components/shell/nsShellService.h", "browser/components/shell/nsWindowsShellService.cpp", "browser/components/tests/browser/head.js"], "git_node": "caf56d40d2a427d215fdfc0fb9a857e3c67fb56f", "git_parents": ["d62eed02d8e0d85ba36f229d0569115dcc1ea10b"], "node": "d0df11fe3948c430881718710f007907a11c989b", "parents": ["736b684d3fd959be7cce280af6fb896e9ec35985"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074812 - Create new report broken site related regression UI tests r=jajohnson,android-reviewers,rebecatudor273\n\nCreated 4 new \"regression\" UI tests:\n  - verifyTheReportBrokenSiteFormWithNoReasonSelectedTest\n  - verifyTheReportBrokenSiteURLIsNotSavedOnDismissTest\n  - verifyTheReportBrokenSiteFormAfterSelectingReasonInLandscapeTest\n  - verifyTheReportBrokenSiteFormAfterChangingTheReasonTest\n\nAll 4 UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\n\u2757 Added a new test tag and needs to be reviewed by someone from the development team\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328458\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/VerbContractTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Verbs.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/WebCompatReporterSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/ReportBrokenSiteTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/BrokenSiteReporterTestTags.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/ReadOnlyUrlField.kt"], "git_node": "d87ca61f3214aef7a193765866cccfb6d66e6645", "git_parents": ["caf56d40d2a427d215fdfc0fb9a857e3c67fb56f"], "node": "1d79899da0aa85eac073e3297f15f41f45295f4b", "parents": ["d0df11fe3948c430881718710f007907a11c989b"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070825 - Fix installPWAFromTheMainMenuTest efficiency UI test r=jajohnson\n\nThe UI test was flaky when trying to click the home screen shortcut.\n\nClicking a UiObject on a still-animating screen (the launcher settling a freshly-added home-screen shortcut) failed intermittently, because the code called exists(). (a single instantaneous check that throws if the node flickers out in the gap between resolving and acting on it)\n\nTo fix this, I've replaced exists() with waitForExists(waitingTimeShort) in both the click and long click UiObject, so the click smoothly handles a brief miss so it won't crash or throw.\n\nThe UI test successfully passed 50x on Firebase \u2705\nAll UI test successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328834\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/UiActions.kt"], "git_node": "f1a27fd7bc48374b29d84fdfb21c0844d37df197", "git_parents": ["d87ca61f3214aef7a193765866cccfb6d66e6645"], "node": "f1fdcdb17e01f60341569b17c1021e572a412518", "parents": ["1d79899da0aa85eac073e3297f15f41f45295f4b"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066127 - Fix audioVideoPermissionWithoutRememberingTheDecisionTest efficiency UI test r=aaronmt\n\nThe UI test was flaky when tapping the \u201cDon\u2019t allow\u201d button.\n\nTapping the permission dialog\u2019s \u201cDon\u2019t allow\u201d button actually worked (the dialog closed and the page showed \u201cCamera and Microphone not allowed\u201d), but the old click method waited for a confirmation signal that a self-closing dialog never sends, so it wrongly reported the click as failed.\n\nTo fix this I've switched the allow/deny dialog buttons to the UiObject2 click, which just performs the tap without waiting for that confirmation, so the click no longer reports a false failure.\n\nThe UI test successfully passed 50x on Firebase \u2705\nAll UI test successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328835\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SitePermissionsSelectors.kt"], "git_node": "7660f2a4b10de2f92e577934122471e60e927c39", "git_parents": ["f1a27fd7bc48374b29d84fdfb21c0844d37df197"], "node": "d638c3b02c58e20c5db89bddba26d18ca1cddb78", "parents": ["f1fdcdb17e01f60341569b17c1021e572a412518"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074413 - Stylelint: check a nested state variant's inherited text color against the background it paints. r=hjones,desktop-theme-reviewers,fchasen\" for causing node failures\n\nThis reverts commit 95ab85c042dc9b56e14c4dad49de7a748180fe3e.\n", "files": ["browser/components/asrouter/content-src/styles/_multistage.scss", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/_PictureOfTheDay.scss", "browser/extensions/newtab/content-src/styles/nova/_TopSites.scss", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/translations/panel.css", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-paired-color-tokens.md", "toolkit/themes/shared/global-shared.css", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/use-paired-color-tokens.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.no-text-color.tests.mjs"], "git_node": "60c7058dc4a6bff889dea783a7880fd7aebaa093", "git_parents": ["7660f2a4b10de2f92e577934122471e60e927c39"], "node": "cdef9c1d658fb940ca35b721a7b53c255985282a", "parents": ["d638c3b02c58e20c5db89bddba26d18ca1cddb78"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2075211 - Add some parenthesis to appease GCC.\n", "files": ["layout/base/nsLayoutUtils.cpp"], "git_node": "8df859efb93c61b282ae25b61a6bbd5067ab2de7", "git_parents": ["60c7058dc4a6bff889dea783a7880fd7aebaa093"], "node": "3ba0aaa60c3ad08bbb15c1ca69556ea0c304bb1f", "parents": ["cdef9c1d658fb940ca35b721a7b53c255985282a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2075211 - Bump some assert counts.\n", "files": ["layout/generic/crashtests/crashtests.list", "layout/svg/crashtests/crashtests.list"], "git_node": "662216ee5e95fef277b19ca7e450a8522793ab65", "git_parents": ["8df859efb93c61b282ae25b61a6bbd5067ab2de7"], "node": "d833c2abb61927b111c79acc9f8b2ea6c9ee7232", "parents": ["3ba0aaa60c3ad08bbb15c1ca69556ea0c304bb1f"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 1995348 - Annotate some WPT expectation changes.\n", "files": ["testing/web-platform/meta/css/css-break/grid/grid-lanes/row-single-lane-fragmentation-002.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/column-negative-margin-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/item-placement/dense-packing/column-dense-packing-flow-tolerance-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/track-sizing/column-subgrid-with-row-standalone-axis-size-002.html.ini"], "git_node": "475a1a01553ed6e35f21f97a5fe45e396738b454", "git_parents": ["662216ee5e95fef277b19ca7e450a8522793ab65"], "node": "6ff73b17547d24c88b152f947129d5c79d4fc1cd", "parents": ["d833c2abb61927b111c79acc9f8b2ea6c9ee7232"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072294 - Bump shadow overflow fuzz factor to fix browser_urlbar_keyed_search.js on Linux\n", "files": ["browser/base/content/test/browser-performance/head.js"], "git_node": "fb3070a2fed442f6627d15cb76396bbbb6b5bd26", "git_parents": ["475a1a01553ed6e35f21f97a5fe45e396738b454"], "node": "51a881595bf929593d82fe07b3bf7ef1f9fbb3fc", "parents": ["6ff73b17547d24c88b152f947129d5c79d4fc1cd"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070868 - Invalidate `\u003cinput\u003e.labels` when `\u003clabel for\u003e` changes. r=edgar\" for causing wpt tests failures at the-label-element\n\nThis reverts commit 083ea1b66b13f522c3992737054c756c9fb68a77.\n", "files": ["dom/base/ContentList.cpp", "testing/web-platform/meta/shadow-dom/reference-target/tentative/dom-mutation.html.ini", "testing/web-platform/tests/shadow-dom/reference-target/tentative/dom-mutation.html"], "git_node": "53518caf326370905819d7adb89bdb2174240748", "git_parents": ["fb3070a2fed442f6627d15cb76396bbbb6b5bd26"], "node": "5a226afedfe1506b31d73aff60d524f1b8780546", "parents": ["51a881595bf929593d82fe07b3bf7ef1f9fbb3fc"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["testing/web-platform/meta/shadow-dom/reference-target/tentative/dom-mutation.html.ini", "third_party/libwebrtc/call/receive_time_calculator.cc", "third_party/libwebrtc/call/receive_time_calculator.h", "third_party/libwebrtc/call/receive_time_calculator_unittest.cc", "third_party/libwebrtc/video/corruption_detection/evaluation/qp_parser.cc"], "git_node": "8d0e7f9cb19cd161117224929cb52ae4d5fdff2e", "git_parents": ["53518caf326370905819d7adb89bdb2174240748", "18d9efd53b34d51f3be66cb66de39ad3cbaa6fb9"], "node": "6f46700238b8d31c94aaaa22a4f00632c71a035a", "parents": ["5a226afedfe1506b31d73aff60d524f1b8780546", "a72269cf0415a8d963d21e68ea3f5539464d80ca"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2071398 - Redirect replaced elements into the adoption agency's next kept clone r=hsivonen\n\nWhen AAA runs with a sanitizer config with replaceWithChildrenElements, the\nelement being replaced doesn't go in the tree so the algorithm has to update\nwhere that element's content goes whenever it moves the element. It did this for\nthe furthest block to the common acnestor, but a replaced clone or furthest\nblock below a kept clone would be appended to the clone, so its content\nbelongs there instead.\n\nThis change queues replaced elements while the inner loop runs and re-points the\nfirst clone the sanitizer keeps or removes, falling back to the common ancestor\nor foster parent when the loop reaches the formatting element first. This means\nreplaced elements above the furthest block in the stack get re-pointed to the\nformatting clone.\n\nSee https://github.com/whatwg/html/pull/12756#issuecomment-5635152715 for more.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328164\n", "files": ["parser/html/javasrc/TreeBuilder.java", "parser/html/nsHtml5TreeBuilder.cpp", "parser/html/nsHtml5TreeBuilder.h", "parser/html/nsHtml5TreeBuilderCppSupplement.h", "parser/html/nsHtml5TreeBuilderHSupplement.h", "testing/web-platform/tests/sanitizer-api/sanitizer-in-adoption-agency.sub.dat"], "git_node": "92fcd9a8d19f87c65a8ca20918b5747f796d474a", "git_parents": ["8d0e7f9cb19cd161117224929cb52ae4d5fdff2e"], "node": "e9edc712dbcbc6b787a6ff254e190d281532bd34", "parents": ["6f46700238b8d31c94aaaa22a4f00632c71a035a"], "tags": []}, {"author": "Jan-Niklas Jaeschke \u003cjjaschke@mozilla.com\u003e", "branch": "default", "desc": "Bug 1998353 - Store SIMD strides directly into strBuf in the HTML tokenizer. r=hsivonen\n\nCopy comment and quoted attribute data from the SIMD registers into\nstrBuf, avoiding a separate memcpy. The final stride may write past\nstrBufLen; the existing capacity bound keeps those writes within the\nallocation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326845\n", "files": ["parser/html/nsHtml5TokenizerLoopPoliciesSIMD.h", "parser/htmlaccel/gtest/TestHtmlSimd.cpp", "parser/htmlaccel/htmlaccel.h", "parser/htmlaccel/htmlaccelNotInline.cpp", "parser/htmlaccel/htmlaccelNotInline.h"], "git_node": "4c2be1029aab262bc1fbe626a4f77cbe54fd4bdc", "git_parents": ["92fcd9a8d19f87c65a8ca20918b5747f796d474a"], "node": "387083f11eef89e98d79269e14408a532ccd6e91", "parents": ["e9edc712dbcbc6b787a6ff254e190d281532bd34"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2074193 - HTMLOptionsCollection could use similar setup to SetAttr when it comes to script blockers, r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328024\n", "files": ["dom/html/HTMLOptionElement.cpp", "dom/html/HTMLOptionsCollection.cpp", "dom/html/HTMLSelectElement.cpp", "dom/prototype/PrototypeDocumentContentSink.cpp", "dom/xml/nsXMLContentSink.cpp", "dom/xslt/xslt/txMozillaXMLOutput.cpp"], "git_node": "3928a900e31aa4ddaa52fecbb2fa471c68ba5a33", "git_parents": ["4c2be1029aab262bc1fbe626a4f77cbe54fd4bdc"], "node": "44cfd73837e71386ec1fa88cd39da7292c801e88", "parents": ["387083f11eef89e98d79269e14408a532ccd6e91"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075404 - Make nsRect, IntMarginTyped, IntRectTyped and RectTyped default constructor trivial r=layout-reviewers,emilio\n\nAs a side effect, this helps the compiler flag some variables are\nunused, yay.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329057\n", "files": ["dom/base/DOMIntersectionObserver.cpp", "gfx/2d/BaseRect.h", "gfx/2d/Rect.h", "layout/generic/AbsoluteContainingBlock.cpp", "layout/generic/nsIFrame.cpp"], "git_node": "aec2c9f315e36c0e7ac16faa6d1a67ec3eac507f", "git_parents": ["3928a900e31aa4ddaa52fecbb2fa471c68ba5a33"], "node": "8a266504589d69d5a5f20288955f78b24ac5e933", "parents": ["44cfd73837e71386ec1fa88cd39da7292c801e88"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2075534 - Add missing --taskid \u003cupstream\u003e to partner repack script r=taskgraph-reviewers,releng-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329131\n", "files": ["python/mozrelease/mozrelease/partner_repack.py", "taskcluster/scripts/release/partner-repack.sh"], "git_node": "0ba436e4ebed0d8d1901398ab9753ce8f7574cc1", "git_parents": ["aec2c9f315e36c0e7ac16faa6d1a67ec3eac507f"], "node": "f03283e646102807410ca71009efb42c1a25affa", "parents": ["8a266504589d69d5a5f20288955f78b24ac5e933"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070498 - Enable sanitize while parsing by default r=dom-core-reviewers,jjaschke\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328887\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "ce26bf318c112833bccd6dd533b55e6a6eb31f31", "git_parents": ["0ba436e4ebed0d8d1901398ab9753ce8f7574cc1"], "node": "3ca464a9ff09fd6dabfa61c3b8b930a0bbfd6d22", "parents": ["f03283e646102807410ca71009efb42c1a25affa"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2070506 - Enable scoped custom element registries by default r=dom-core-reviewers,edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328885\n", "files": ["modules/libpref/init/StaticPrefList.yaml"], "git_node": "bf68677ac8a7a11d286914b793fe5553fd0cb1f6", "git_parents": ["ce26bf318c112833bccd6dd533b55e6a6eb31f31"], "node": "6a0cbb172a44ba18b1976558a3e938a7394379be", "parents": ["3ca464a9ff09fd6dabfa61c3b8b930a0bbfd6d22"], "tags": []}, {"author": "Holger Benl \u003chbenl@evandor.de\u003e", "branch": "default", "desc": "Bug 2057588 - [webdriver-bidi] Provide CDDL for Firefox WebDriver BiDi vendor extensions r=webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327393\n", "files": ["remote/doc/webdriver-bidi/Extensions.md", "remote/webdriver-bidi/cddl/Commands.cddl", "remote/webdriver-bidi/cddl/Debugging.cddl", "remote/webdriver-bidi/cddl/Fields.cddl", "remote/webdriver-bidi/cddl/Profiler.cddl"], "git_node": "511b0de4764c52d9acb0d813c7ef712cabd6b975", "git_parents": ["bf68677ac8a7a11d286914b793fe5553fd0cb1f6"], "node": "bcba727588cc39aaea9224dbbe77af7ccf66b4c5", "parents": ["6a0cbb172a44ba18b1976558a3e938a7394379be"], "tags": []}, {"author": "Anna Weine \u003canna.weine@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072206 - Reject local descriptions whose DTLS fingerprint was modified r=webrtc-reviewers,bwc\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326144\n", "files": ["dom/media/webrtc/jsep/JsepSessionImpl.cpp", "media/webrtc/signaling/gtest/jsep_session_unittest.cpp"], "git_node": "2146b63ac3a0d12712faf50f8de4fbfb62591307", "git_parents": ["511b0de4764c52d9acb0d813c7ef712cabd6b975"], "node": "ead25d40ec0b367d0eeac879e72fd1fb810c058f", "parents": ["bcba727588cc39aaea9224dbbe77af7ccf66b4c5"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068932 - Show a new Sign out confirmation dialog on the new Account settings UI r=android-reviewers,android-l10n-reviewers,flod,tthibaud\n\nRight now, the logout confirmation is a bottom sheet. With the new Account Sync decoupling UI, the bottom sheet is replaced by a dialog.\n\nThis patch introduces `SignOutDialog` which is shown from `SignOutFragment` when `accountSettingsNewUi` is enabled. If `accountSettingsNewUi` is disabled, the existing bottom sheet is displayed.\n\nPutting the branching logic inside the existing `SignOutFragment` instead of creating a new dialog destination keeps all its consumers (`AccountSettingsFragment`, `AccountProblemFragment` and `SendToDevicesDialogFragment` ) consistent and reduces the scope of changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325017\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/syncintegration/SyncIntegrationTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/AccountSettingsRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountSettingsTestTag.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/SignOutDialog.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/SignOutFragment.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/account/SignOutDialogTest.kt"], "git_node": "ee0888577c4d8922019e5acc036809f00b692c43", "git_parents": ["2146b63ac3a0d12712faf50f8de4fbfb62591307"], "node": "c0466a4ad40027b121ba1c055755f7a917a30742", "parents": ["ead25d40ec0b367d0eeac879e72fd1fb810c058f"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071355 - Ignore the tab element module conversion in blame and annotate. r=firefox-desktop-core-reviewers ,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329079\n", "files": [".git-blame-ignore-revs", ".hg-annotate-ignore-revs"], "git_node": "29c070a82dafa7b424541cd3feccb1359786cdb3", "git_parents": ["ee0888577c4d8922019e5acc036809f00b692c43"], "node": "c2f1aa753e8ed4df62366f5bd9c7699034f5ea79", "parents": ["c0466a4ad40027b121ba1c055755f7a917a30742"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2075211 - Missed one crashtest.\n", "files": ["layout/tables/crashtests/crashtests.list"], "git_node": "a23da586d23206fbefc3bccd87852261efc8b69f", "git_parents": ["29c070a82dafa7b424541cd3feccb1359786cdb3"], "node": "025e16aca05fc477e450e54c9547bfee923fe421", "parents": ["c2f1aa753e8ed4df62366f5bd9c7699034f5ea79"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2075211 - More crashtest assert count bumps, WPT edition.\n", "files": ["testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/vertical_lr.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/bidi/vertical_rl.html.ini", "testing/web-platform/meta/webvtt/rendering/cues-with-video/processing-model/selectors/cue/vertical_ruby-position.html.ini"], "git_node": "2f3d9c18756e129d6307dc6b42cbfb64a4231469", "git_parents": ["a23da586d23206fbefc3bccd87852261efc8b69f"], "node": "2919fb04df20a5e6b8971f2ec70842f711a3d61d", "parents": ["025e16aca05fc477e450e54c9547bfee923fe421"], "tags": []}, {"author": "Marco Bonardo \u003cmbonardo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075533. r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329139\n", "files": ["xpcom/io/nsLocalFileUnix.cpp", "xpcom/io/nsLocalFileWin.cpp"], "git_node": "4588275971d27c7db1970ed7ceecf937d90af05b", "git_parents": ["2f3d9c18756e129d6307dc6b42cbfb64a4231469"], "node": "3a44f3469c16d918f66362548c01aebd92e1b569", "parents": ["2919fb04df20a5e6b8971f2ec70842f711a3d61d"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2075466 - Export symbols used by exif.c unconditionally from ffvpx/libavutil. r=stransky,media-playback-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329104\n", "files": ["media/ffvpx/libavutil/avutil.symbols"], "git_node": "69d29ae8a212bed961510bc88cbb562e4e506d4c", "git_parents": ["4588275971d27c7db1970ed7ceecf937d90af05b"], "node": "5e3f09c5d334a0916891509438d81caaf9865445", "parents": ["3a44f3469c16d918f66362548c01aebd92e1b569"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074413 - Stylelint: check a nested state variant's inherited text color against the background it paints. r=hjones,desktop-theme-reviewers,fchasen\n\nThe twelve `color` insertions are what `--fix` produced. Each hover or active text token resolves to the base one in the default theme, so the change shows only under forced colors, where the base is ButtonText and the states are SelectedItem.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328099\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/_PictureOfTheDay.scss", "browser/extensions/newtab/content-src/styles/nova/_TopSites.scss", "browser/themes/shared/customizableui/panelUI-shared.css", "browser/themes/shared/translations/panel.css", "docs/code-quality/lint/linters/stylelint-plugin-mozilla/rules/use-paired-color-tokens.md", "toolkit/themes/shared/global-shared.css", "tools/lint/stylelint/stylelint-plugin-mozilla/rules/use-paired-color-tokens.mjs", "tools/lint/stylelint/stylelint-plugin-mozilla/tests/use-paired-color-tokens.no-text-color.tests.mjs"], "git_node": "cd3e8888f31bf5889e370727063e1481372e1c5f", "git_parents": ["69d29ae8a212bed961510bc88cbb562e4e506d4c"], "node": "a8f6fa4f9d8d807c958d71848607e2a049869c60", "parents": ["5e3f09c5d334a0916891509438d81caaf9865445"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2043557 - Avoid crash in gluesmith. r=jpages\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328594\n", "files": ["js/src/fuzz-tests/gluesmith/src/lib.rs", "js/src/fuzz-tests/testWasm.cpp"], "git_node": "31f11911ca057ddb04be1deca7d81c7172e711bd", "git_parents": ["cd3e8888f31bf5889e370727063e1481372e1c5f"], "node": "ecc27aefcb8d7819b7fb9be73036c787bad22ff7", "parents": ["a8f6fa4f9d8d807c958d71848607e2a049869c60"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074025 - Map wasm continuation stacks with MAP_STACK. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328545\n", "files": ["js/src/gc/Memory.cpp", "js/src/gc/Memory.h", "js/src/wasm/WasmStacks.cpp"], "git_node": "c9a4c634907d263cd2231f7332ff8d2983d039cb", "git_parents": ["31f11911ca057ddb04be1deca7d81c7172e711bd"], "node": "b3a14f8efa230158a553f181551b74dcde740473", "parents": ["ecc27aefcb8d7819b7fb9be73036c787bad22ff7"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074822 - Connection Allowlists: Implement InitFromOther (document inheritance). r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328465\n", "files": ["dom/security/ConnectionAllowlists.cpp", "dom/security/ConnectionAllowlists.h", "dom/security/PolicyContainer.cpp", "testing/web-platform/tests/connection-allowlist/tentative/iframe-contentwindow-injection.sub.window.js"], "git_node": "67ac47d4c4b2bdbd656b06091f35fefecdf7688d", "git_parents": ["c9a4c634907d263cd2231f7332ff8d2983d039cb"], "node": "2f621714be3c59ca5c5c881ee98d6dc825ec3fbd", "parents": ["b3a14f8efa230158a553f181551b74dcde740473"], "tags": []}, {"author": "Vijay Budhram \u003cvbudhram@gmail.com\u003e", "branch": "default", "desc": "Bug 2053099 - Fall back to an entrypoint-carrying sync sign-in when Fenix QR pairing fails r=jonalmeida,sfamisa\n\nWhen a user scans a QR code that is not a valid pairing code, begin_pairing_flow fails with a\nparse error or an origin mismatch. beginPairingAuthentication then returned a bare\nhttps://accounts.firefox.com/signin URL with no entrypoint and no webchannel context, which\nlands the user on \"Continue to account settings\" instead of the sync sign-in page.\n\nAdd a fallback that starts a normal email sync sign-in before the last resort. That flow\nappends the entrypoint, and it appends context=oauth_webchannel_v1 for the webchannel redirect\nURI. Also derive the last-resort URL from the configured server instead of the hardcoded\nrelease host, so stage, China and custom servers get their own sign-in page.\n\nA Back press in the QR camera is a separate path. PairFragment.onBackPressed removes the QR\nfragment and pops to turnOnSyncFragment, so it never calls beginPairingAuthentication. This\npatch does not change that path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310816\n", "files": ["mobile/android/android-components/components/feature/accounts/src/main/java/mozilla/components/feature/accounts/FirefoxAccountsAuthFeature.kt", "mobile/android/android-components/components/feature/accounts/src/test/java/mozilla/components/feature/accounts/FirefoxAccountsAuthFeatureTest.kt"], "git_node": "323e889d5032d54415f9d2f9409f65be7ac7581a", "git_parents": ["67ac47d4c4b2bdbd656b06091f35fefecdf7688d"], "node": "224f56a6d07df2b18b76ebaa49ef7b10e211c006", "parents": ["2f621714be3c59ca5c5c881ee98d6dc825ec3fbd"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2070598 - Shorten autocomplete row action button tooltips and rename button to 'More options'. r=mtigley,fluent-reviewers,credential-management-reviewers,reusable-components-reviewers,hjones,bolsson\n\nMore options button is hidden behind `browser.autocomplete.removeRecords.enabled` pref.\n\nSeparate button tooltip from accessible name. Hover tooltip is shortened while the\naccessible name still names the row the button acts on.\n\nRename the button to \"More options\", matching `moz-button-more-options`, and other\nsurfaces.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327433\n", "files": ["toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs", "toolkit/components/passwordmgr/LoginAutoComplete.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js", "toolkit/components/satchel/FormHistoryAutoComplete.sys.mjs", "toolkit/components/satchel/autocomplete-row-item/autocomplete-row-item.mjs", "toolkit/content/widgets/autocomplete-popup.js", "toolkit/locales/en-US/toolkit/main-window/autocomplete.ftl"], "git_node": "b0eef764234cccfd16f428f59f285e95ca8f5d4b", "git_parents": ["323e889d5032d54415f9d2f9409f65be7ac7581a"], "node": "8fb76538f591a1939fca420fe6c05aea2cbcff6d", "parents": ["224f56a6d07df2b18b76ebaa49ef7b10e211c006"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075396 - Document the steps for adding a new vendored library. r=sylvestre DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329046\n", "files": ["python/mozbuild/mozbuild/vendor/docs/index.md", "python/mozbuild/mozbuild/vendor/docs/licensing.md", "taskcluster/kinds/source-test/vendor-verify.yml"], "git_node": "48585fb2b4fe2df6f78cec5974170c787662df2d", "git_parents": ["b0eef764234cccfd16f428f59f285e95ca8f5d4b"], "node": "ecf2cf93b4f7b2289da45d7ffbc06092d84deec0", "parents": ["8fb76538f591a1939fca420fe6c05aea2cbcff6d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072602 - Centralize macOS toolchain cross-compile setup in macos-setup.sh. r=firefox-build-system-reviewers,taskgraph-reviewers,sylvestre,jcristau\n\nThe toolchain scripts that build for macOS each located the SDK, picked the per-architecture deployment\ntarget, put the fetched clang on PATH and assembled the same clang target flags and tool paths by hand, and\nmost of them hardcoded the SDK version, so every SDK bump touched all of them. The helper mirrors vs-setup.sh:\nsource it with MACOS_TARGET set (or on a Darwin host) and use MACOS_SDK, MACOSX_DEPLOYMENT_TARGET,\nMACOS_CFLAGS, MACOS_RUSTFLAGS and the MACOS_CC/CXX/AR/RANLIB/LD/LIPO tool paths. It also exports SDKROOT,\nwhich rustc 1.95 otherwise tries to obtain from xcrun; rustc and clang both take the SDK from it, so the Rust\nbuilds no longer pass -isysroot to the linker. geckodriver sources it once per architecture, uses llvm-lipo\nlike the LLVM builds and drops its cctools fetch.\n\nMACOS_CFLAGS silences unused-argument warnings with -Qunused-arguments, as the wrench build already did,\nrather than -Wno-unused-command-line-argument: meson adds -Werror=unused-command-line-argument to its compiler\nchecks, which re-enables the warning and fails every check in the wrench mesa build on the link-only flags.\n\nTwo builds stay off the helper on purpose and only glob the SDK directory. OpenH264 keeps its own 10.12\nminimum. custom-car builds upstream Chromium that we cannot patch, so it keeps fetching the SDK through a\nversioned alias that can stay pinned if a major SDK breaks it.\n\nThe toolchain transform adds the helper to the cache digest of tasks that fetch the macOS SDK and whose script\nor listed shell resources mention it, so a change to the helper alone rebuilds its consumers instead of\nreusing stale artifacts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326466\n", "files": ["taskcluster/gecko_taskgraph/transforms/job/toolchain.py", "taskcluster/kinds/toolchain/geckodriver.yml", "taskcluster/kinds/webrender/kind.yml", "taskcluster/scripts/misc/build-cpython.sh", "taskcluster/scripts/misc/build-custom-car.sh", "taskcluster/scripts/misc/build-geckodriver.sh", "taskcluster/scripts/misc/build-gn-macosx.sh", "taskcluster/scripts/misc/build-llvm-common.sh", "taskcluster/scripts/misc/build-nasm.sh", "taskcluster/scripts/misc/build-onnxruntime.sh", "taskcluster/scripts/misc/build-openssl.sh", "taskcluster/scripts/misc/build-pkgconf.sh", "taskcluster/scripts/misc/build-rust-based-toolchain.sh", "taskcluster/scripts/misc/build-xz.sh", "taskcluster/scripts/misc/macos-setup.sh", "taskcluster/scripts/misc/wr-macos-cross-build-setup.sh", "taskcluster/scripts/openh264/build.sh"], "git_node": "5a3c64bde47a9202fa5911cdeea2a3579bf3c620", "git_parents": ["48585fb2b4fe2df6f78cec5974170c787662df2d"], "node": "b16486a795413cc31a525e823c08ec7023e95590", "parents": ["ecf2cf93b4f7b2289da45d7ffbc06092d84deec0"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073738 - Don't let '**/*.json' schedule source-test tasks for try_task_config.json. r=taskgraph-reviewers,ahal DONTBUILD\n\n`mach try` commits try_task_config.json on top of every try push, so\nthe eslint, file-whitespace and file-perm tasks ran on every push. The\nfiles-changed globs don't support negation, so a source-test transform\nrewrites '**/*.json' to JSON files in subdirectories plus the ones\ntracked at the root of the tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327545\n", "files": ["taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_transforms_source_test.py", "taskcluster/gecko_taskgraph/transforms/source_test.py"], "git_node": "c1a5229da404463e56acae9004376018c729ddb1", "git_parents": ["5a3c64bde47a9202fa5911cdeea2a3579bf3c620"], "node": "9f2efc84e4c2f5facecdcfeb9a687d338156070e", "parents": ["b16486a795413cc31a525e823c08ec7023e95590"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075493 - Update android nightly application-services version bump to e3d63fcb445b47af0aeacd433a8e970a8cf09171 r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329113\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "89eb92d19d86dbf135071ba37980fc39154c5e2b", "git_parents": ["c1a5229da404463e56acae9004376018c729ddb1"], "node": "2040fe746e55e78bb568045e283b297e707471fb", "parents": ["9f2efc84e4c2f5facecdcfeb9a687d338156070e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075392 - Add moz.yaml files and about:license entries for lz4 and xxHash. r=sergesanspaille,sylvestre\n\nxxHash moves out of mozglue/static/lz4 into its own directory because mach vendor clears the vendor directory\nbefore unpacking, so two libraries cannot share one. Both manifests reproduce the in-tree files unchanged at\nthe currently pinned versions (lz4 1.10.0, xxHash 0.8.3) and replace README.mozilla.\n\nNeither library was listed in about:license before. The LICENSES entries name each LICENSE file explicitly\nbecause mozglue/static/moz.build sits above both manifests, where a notice without `text` would find no\nmoz.yaml to read it from.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329042\n", "files": ["mozglue/static/lz4/README.mozilla", "mozglue/static/lz4/moz.yaml", "mozglue/static/lz4/xxhash.c", "mozglue/static/lz4/xxhash.h", "mozglue/static/moz.build", "mozglue/static/xxhash/LICENSE", "mozglue/static/xxhash/moz.yaml", "mozglue/static/xxhash/xxhash.c", "mozglue/static/xxhash/xxhash.h", "taskcluster/kinds/source-test/vendor-verify.yml", "tools/rewriting/ThirdPartyPaths.txt"], "git_node": "407df176a4aa899a76dcb953e61923cc0f9624be", "git_parents": ["89eb92d19d86dbf135071ba37980fc39154c5e2b"], "node": "5eb0af8217fbb3703d47fd103f166c747dc81ec3", "parents": ["2040fe746e55e78bb568045e283b297e707471fb"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075392 - Update xxHash to version 0.8.4. r=sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329043\n", "files": ["mozglue/static/xxhash/moz.yaml", "mozglue/static/xxhash/xxhash.h"], "git_node": "2ff6bf9f9f56ae2e191d6442bf2163b2c2adc7d0", "git_parents": ["407df176a4aa899a76dcb953e61923cc0f9624be"], "node": "5469bdcd04b0d321214353fa59f5f0a68f963a3c", "parents": ["5eb0af8217fbb3703d47fd103f166c747dc81ec3"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074812 - Create new report broken site related regression UI tests r=jajohnson,android-reviewers,rebecatudor273\" for causing fenix debug failures at fenix.ui.efficiency.core\n\nThis reverts commit d87ca61f3214aef7a193765866cccfb6d66e6645.\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/VerbContractTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/core/Verbs.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BasePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/WebCompatReporterSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/ReportBrokenSiteTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/BrokenSiteReporterTestTags.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/ReadOnlyUrlField.kt"], "git_node": "8900a623eb2366ad3d1d2083ff4283ccebdf9a46", "git_parents": ["2ff6bf9f9f56ae2e191d6442bf2163b2c2adc7d0"], "node": "c9ae87f532a7a44bc62ff682df64c8f721516716", "parents": ["5469bdcd04b0d321214353fa59f5f0a68f963a3c"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2074565, part 1: Convert BrowserParent's focus and last-mouse-target statics to WeakPtr. r=dom-core-reviewers,smaug\n\nMake sFocus, sTopLevelWebFocus and sLastMouseRemoteTarget into WeakPtrs for\nextra safety.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328580\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "90e50036d1ed1c9dd5d90d81106bb47485e82f59", "git_parents": ["8900a623eb2366ad3d1d2083ff4283ccebdf9a46"], "node": "27036bf5a40457daa495cf6d6ef02b630dd5f177", "parents": ["c9ae87f532a7a44bc62ff682df64c8f721516716"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2074565, part 2: Make sLayerToBrowserParentTable use StaticAutoPtr. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328581\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h"], "git_node": "e5e7acf917f77373ba180571f3ae000e9af1fe56", "git_parents": ["90e50036d1ed1c9dd5d90d81106bb47485e82f59"], "node": "44bf90db9a3eedb1788a5dcc3b351d09780eafd6", "parents": ["27036bf5a40457daa495cf6d6ef02b630dd5f177"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2074955 - Part 1: Move file picker Content Analysis checks into nsBaseFilePicker. r=win-reviewers,dlp-reviewers,handyman\n\nMostly just refactoring that will let the macOS and GTK file pickers\nshare the logic (in part 2 and 3). Also fixes the Windows picker calling\nits callback twice when every selected file is blocked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328896\n", "files": ["widget/nsBaseFilePicker.cpp", "widget/nsBaseFilePicker.h", "widget/windows/nsFilePicker.cpp", "widget/windows/nsFilePicker.h"], "git_node": "957cf1be7e9ffdfe4bd8b0e8ff32ec5c740b5b02", "git_parents": ["e5e7acf917f77373ba180571f3ae000e9af1fe56"], "node": "4499ece23b3c40a907287624851ed8c2d04c70b8", "parents": ["44bf90db9a3eedb1788a5dcc3b351d09780eafd6"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2074955 - Part 2: Check macOS file picker uploads with Content Analysis. r=mac-reviewers,bradwerth\n\nThe check starts on a fresh main-thread turn for the same reason the callback\nis already deferred (bug 2053177): Content Analysis may show its own dialog.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328897\n", "files": ["widget/cocoa/nsFilePicker.h", "widget/cocoa/nsFilePicker.mm"], "git_node": "c7bf3bc54599bd915ffcf15b4bef428ea535665f", "git_parents": ["957cf1be7e9ffdfe4bd8b0e8ff32ec5c740b5b02"], "node": "810f8952fb1af1bb28689816e16b0f02a76c82d3", "parents": ["4499ece23b3c40a907287624851ed8c2d04c70b8"], "tags": []}, {"author": "Greg Stoll \u003cgreg@gregstoll.com\u003e", "branch": "default", "desc": "Bug 2074955 - Part 3: Check GTK file picker uploads with Content Analysis. r=gtk-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328898\n", "files": ["widget/gtk/nsFilePicker.cpp", "widget/gtk/nsFilePicker.h"], "git_node": "5570f80c8e2507981a67810a67278cfeda36d62a", "git_parents": ["c7bf3bc54599bd915ffcf15b4bef428ea535665f"], "node": "04b7c212ce296f87cae8f7cae847d6a81cb3d824", "parents": ["810f8952fb1af1bb28689816e16b0f02a76c82d3"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2073843 - Restrict the ElevationType test mock globals to Windows r=application-update-reviewers,yjuglaret\n\nmockUserHasAdminPrivileges, mockUserIsLocalSystem and mockError are only\nread by the Windows-only mocks, so on other platforms they are set in\nSetUp() and never used, which clang trunk rejects with\n-Werror,-Wunused-but-set-global.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327699\n", "files": ["toolkit/mozapps/update/tests/gtest/ElevationTypeTests.cpp"], "git_node": "31b81d5edccbb2d1f950ffc328119523eff6c726", "git_parents": ["5570f80c8e2507981a67810a67278cfeda36d62a"], "node": "0cbae37f2db17ccfeefb5e46c70cc2ee2553406f", "parents": ["04b7c212ce296f87cae8f7cae847d6a81cb3d824"], "tags": []}, {"author": "Aaron Train \u003caaron.train@gmail.com\u003e", "branch": "default", "desc": "Bug 2075587 - Update Flank config to skip efficiency core package in arm64-v8a r=ajoltan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329193\n", "files": ["mobile/android/test_infra/flank-configs/fenix/arm64-v8a.yml"], "git_node": "db30208dc196921fd58bce4aafd660f49975a76b", "git_parents": ["31b81d5edccbb2d1f950ffc328119523eff6c726"], "node": "4a06f63494916dd0861dd1e2e843aadae7fe2aa4", "parents": ["0cbae37f2db17ccfeefb5e46c70cc2ee2553406f"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2073458 - [arm64] Avoid LDP/STP and use single-register loads and stores in {push,pop}Regs(...) on Darwin. r=spidermonkey-reviewers,jandem\n\nForwarding to/from LDP/STP instructions doesn't seem to work on some\nApple Silicons.\n\nSome metaprogramming techniques are used to fuse the SP adjustment into\nthe first stack accessing instruction. Per experimentation with GCC\n16.2.1 and Clang 22.1.8, both the \"generic lambda\" and the\nstd::forward_as_tuple() are elided and inlined linearly into\n{push,pop}Regs().\n\nLink:\n https://lemire.me/blog/2024/04/29/careful-with-pair-of-registers-instructions-on-apple-silicon/\n (\"Careful with Pair-of-Registers instructions on Apple Silicon\")\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328538\n", "files": ["js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "fceec8db2cbf2081f3fe7372577d322d9b6ef142", "git_parents": ["db30208dc196921fd58bce4aafd660f49975a76b"], "node": "3a6acc562e53801d21c208a714cdfc45bb82c336", "parents": ["4a06f63494916dd0861dd1e2e843aadae7fe2aa4"], "tags": []}, {"author": "Kershaw Chang \u003ckershaw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2054644 - Reject cross-origin child-written alt-data in the HTTP cache r=necko-reviewers,jesup,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323591\n", "files": ["netwerk/protocol/http/CacheEntryWriteHandleParent.h", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpBaseChannel.h", "netwerk/protocol/http/HttpChannelParent.cpp", "netwerk/protocol/http/HttpChannelParent.h", "netwerk/protocol/http/nsHttpChannel.cpp"], "git_node": "b61c80e501f1d8fab7643c928709baa502f7cd66", "git_parents": ["fceec8db2cbf2081f3fe7372577d322d9b6ef142"], "node": "19a35a1c65500d42e8e1eb9d12db5b6500a1d12c", "parents": ["3a6acc562e53801d21c208a714cdfc45bb82c336"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 1564120 - Make nsHttpConnectionInfo immutable r=necko-reviewers,kershaw\n\n- Made nsHttpConnectionInfo immutable: all 18 Set* methods moved to private, with friend class nsHttpConnectionInfoMutator for internal access. Clone() also moved to private.\n  - Added nsHttpConnectionInfoMutator (MOZ_STACK_CLASS): chainable builder accessed via ci-\u003eMutate().SetFoo(...).SetBar(...).Finalize(). Private constructor \u2014 only reachable through Mutate(), which clones internally.\n  - Converted all 18 external mutation sites across 9 files to use the mutator pattern, producing new immutable CIs instead of mutating in place.\n  - Eliminated all external Clone() calls (17 sites across 11 files): since CIs are now immutable, sharing via RefPtr copy is sufficient. Clone variants (CloneAndAdoptHTTPSSVCRecord, CloneAsDirectRoute, etc.) remain \u2014 they change constructor-level parameters.\n  - Fixed cross-thread data race on nsHttpTransaction::mConnInfo: all socket-thread writes now hold mLock, synchronized with the main-thread reader GetConnInfo(). This fixes both the original bug (SetNoSpdy race) and pre-existing races from DisableHttp3/Restart/PrepareConnInfoForRetry pointer swaps.\n\nNote: we might want to move this patch to a different bug eventually\n\nDifferential Revision: https://phabricator.services.mozilla.com/D290151\n", "files": ["netwerk/protocol/http/AltServiceChild.cpp", "netwerk/protocol/http/AlternateServices.cpp", "netwerk/protocol/http/ConnectionEntry.cpp", "netwerk/protocol/http/ConnectionEntry.h", "netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/Http3Session.cpp", "netwerk/protocol/http/Http3Session.h", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/HttpTransactionParent.cpp", "netwerk/protocol/http/TRRServiceChannel.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpConnection.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.cpp", "netwerk/protocol/http/nsHttpConnectionInfo.h", "netwerk/protocol/http/nsHttpConnectionMgr.cpp", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/protocol/http/nsHttpHandler.h", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/test/unit/test_http3_fast_fallback.js"], "git_node": "8c3a5a868cb567cdb4672c2d5607eda703f32ccc", "git_parents": ["b61c80e501f1d8fab7643c928709baa502f7cd66"], "node": "3681e294fb4b44fa80ce80baa2584ff5e6f8f605", "parents": ["19a35a1c65500d42e8e1eb9d12db5b6500a1d12c"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066236 - Gate widget availability by market r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325667\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "63204db9934c29ebe668a5e3415807c0e96639fd", "git_parents": ["8c3a5a868cb567cdb4672c2d5607eda703f32ccc"], "node": "0eed2689646a841223df305f5d024f70f9e61699", "parents": ["3681e294fb4b44fa80ce80baa2584ff5e6f8f605"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066240 - Turn the Lists widget off by default in the US, DE and FR, and block it in PL r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325669\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser_discovery_card.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "b0ff4b05828d68b7e00bef2ac8d72a732f950838", "git_parents": ["63204db9934c29ebe668a5e3415807c0e96639fd"], "node": "7be7b48e8e0f333cb961193102cd405079f198fe", "parents": ["0eed2689646a841223df305f5d024f70f9e61699"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066242 - Turn FocusTimer off by default in US, DE, FR, PL regions. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327240\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser_newtab_side_by_side_layout.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "8ffe7df92e8a29f679f6919a7f80cb7b925deabf", "git_parents": ["b0ff4b05828d68b7e00bef2ac8d72a732f950838"], "node": "4a29d170585e1779f915d89d36f353ac6ec6cf0b", "parents": ["7be7b48e8e0f333cb961193102cd405079f198fe"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066244 - Turn