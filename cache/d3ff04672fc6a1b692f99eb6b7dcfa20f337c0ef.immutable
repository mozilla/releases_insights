48"], "tags": []}, {"author": "Andreas Farre \u003cfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075579 - #process-scroll-behavior should not restore scroll for \"reload\". r=sfarre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329159\n", "files": ["dom/events/NavigateEvent.cpp", "testing/web-platform/meta/navigation-api/scroll-behavior/after-transition-reload-no-scroll-anchoring.html.ini", "testing/web-platform/meta/navigation-api/scroll-behavior/after-transition-reload.html.ini", "testing/web-platform/meta/navigation-api/scroll-behavior/manual-scroll-reload-no-scroll-anchoring.html.ini", "testing/web-platform/meta/navigation-api/scroll-behavior/manual-scroll-reload.html.ini", "testing/web-platform/tests/navigation-api/scroll-behavior/after-transition-reload-after-traverse.html", "testing/web-platform/tests/navigation-api/scroll-behavior/after-transition-reload-no-fragment.html", "testing/web-platform/tests/navigation-api/scroll-behavior/after-transition-reload-no-scroll-anchoring.html", "testing/web-platform/tests/navigation-api/scroll-behavior/after-transition-reload.html", "testing/web-platform/tests/navigation-api/scroll-behavior/after-transition-traverse-no-fragment.html", "testing/web-platform/tests/navigation-api/scroll-behavior/after-transition-traverse-to-fragment.html", "testing/web-platform/tests/navigation-api/scroll-behavior/manual-scroll-reload-no-scroll-anchoring.html", "testing/web-platform/tests/navigation-api/scroll-behavior/manual-scroll-reload.html"], "git_node": "6dcb6d9d85fa007401a8cb0176b2cbaee9a39688", "git_parents": ["56eaa55f8b2e117f5382b1d1daaee4e92b884d93"], "node": "3f8a7b1be6636117dcccdc2130f7f82961257b1c", "parents": ["665c61660218e5476f607d4f35bc372ecf830e98"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070841 - Discard a speculation-rules prefetch record whose final response is not an ok status. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329898\n", "files": ["dom/ipc/PrefetchRecordParent.cpp"], "git_node": "9f025da9d59ef3d5c6de50fefa51827a93568ae5", "git_parents": ["6dcb6d9d85fa007401a8cb0176b2cbaee9a39688"], "node": "bd29012eac838cd21d6e3b4bcfeec200ff557863", "parents": ["3f8a7b1be6636117dcccdc2130f7f82961257b1c"], "tags": []}, {"author": "smayya \u003csmayya@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070841 - Skip cache validation when serving a navigation activated from a speculation-rules prefetch record. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329899\n", "files": ["dom/base/test/browser_prefetch_delivery_type.js", "dom/base/test/file_pageload_prefetch_target.sjs", "netwerk/protocol/http/nsHttpChannel.cpp", "testing/web-platform/meta/speculation-rules/prefetch/clear-prefetch-cache-after-clear-site-data-cache.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/initiators-a-element.sub.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/mutate-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-delivery-type.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-requestStart-responseStart.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-single.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-status.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-traverse-reload.sub.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-from-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-not-accepted.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/same-origin-cookies.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/tentative/service-worker/basic.sub.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/tentative/service-worker/redirect.sub.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/user-pass.https.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini"], "git_node": "3ea5a61f6b67b64bdd2e4c48ab6a1d80831b88a6", "git_parents": ["9f025da9d59ef3d5c6de50fefa51827a93568ae5"], "node": "30dd742c488abd36ac96b7adec77ee822d78de9c", "parents": ["bd29012eac838cd21d6e3b4bcfeec200ff557863"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 1649416 - Let bugbug select skip-unless-expanded tasks in mach try auto. r=taskgraph-reviewers,bhearsum DONTBUILD\n\nThese tasks (e.g. base toolchains, fuzzing, ASan debug builds) ignored\nbugbug's selection on try, and only ran when the push ID was a multiple of 10.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330713\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py"], "git_node": "7c6e7f7c3d75a615a5e5d2f88d7200dd8ce7b46c", "git_parents": ["3ea5a61f6b67b64bdd2e4c48ab6a1d80831b88a6"], "node": "a64c50cf1fd9ff25721fb14c6ddcf820e99359d2", "parents": ["30dd742c488abd36ac96b7adec77ee822d78de9c"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078163 - Stop needlessly reparsing the full taskgraph after generation r=taskgraph-reviewers,bhearsum DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330714\n", "files": ["taskcluster/gecko_taskgraph/decision.py"], "git_node": "e7ff24a650a457761b953e9d20a807092863ee1f", "git_parents": ["7c6e7f7c3d75a615a5e5d2f88d7200dd8ce7b46c"], "node": "b2ffe2e33ecaaa15144eb9a8c1b282be33d8a9b2", "parents": ["a64c50cf1fd9ff25721fb14c6ddcf820e99359d2"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076235 - Only handle a pending seek in MediaFormatReader::UpdateReceivedNewData for the tracks being seeked. r=media-playback-reviewers,azebrowski\n\nUpdateReceivedNewData skipped the audio track while a video-only seek was\npending, but not the video track while an audio-only seek was pending, such as\nwhen seamless looping rewinds the audio. If video received new data during\nthat seek while it had a decode request outstanding, it hit\nMOZ_ASSERT(!decoder.HasPromise()), and in release builds it would schedule a\nseek it was not part of.\n\nHandle audio-only seeks the same way as video-only seeks, matching what Seek()\nalready asserts for each kind of seek, so that a track that is not being\nseeked falls through to the normal waiting and internal seek handling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329637\n", "files": ["dom/media/MediaFormatReader.cpp"], "git_node": "2862cd690f320b1335103b50c0609cbac5af3408", "git_parents": ["e7ff24a650a457761b953e9d20a807092863ee1f"], "node": "98d10fe4cd0adb9d42677608ff5cb546d4ed566c", "parents": ["b2ffe2e33ecaaa15144eb9a8c1b282be33d8a9b2"], "tags": []}, {"author": "def00111 \u003ckernp@gmx.de\u003e", "branch": "default", "desc": "Bug 2077979 - Remove IsValidImageUrl function. r=emilio,media-playback-reviewers,padenot\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330618\n", "files": ["dom/media/mediacontrol/MediaControlUtils.h"], "git_node": "0cfee6532613ffae4fe2f22ebe72404833fcc1a6", "git_parents": ["2862cd690f320b1335103b50c0609cbac5af3408"], "node": "99cc2ac39495ab1324ab7705de4c64208987b2cc", "parents": ["98d10fe4cd0adb9d42677608ff5cb546d4ed566c"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2042021 - Part 1: Adjust tests r=asuth\n\nAdds test_driver.bless to provide the required user interaction. Doing this also reveals existing misbehavior where the permission was only rejected because of no user interaction.\n\nAnd made the helper to wait for subscription, otherwise the next permission request auto-cancels the previous request.\n\nset_permission does no real work for gecko as it does not support setting permission for partitioned storage, but such thing would only ever happen in testing environment for notifications (as we always block them), so we can keep it as-is.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321941\n", "files": ["testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini", "testing/web-platform/meta/push-api/cross-origin-same-site-request.tentative.https.sub.window.js.ini", "testing/web-platform/tests/push-api/resources/cross-origin-nested-child.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-nested-parent.sub.html", "testing/web-platform/tests/push-api/resources/cross-origin-serviceworker-iframe.sub.html", "testing/web-platform/tests/push-api/resources/permission-helper.js"], "git_node": "f370a45646ee0b3ba0312d640f8b88f47686a352", "git_parents": ["0cfee6532613ffae4fe2f22ebe72404833fcc1a6"], "node": "3e80d6addda4b4c94bcff8ec496b824e278ad1b8", "parents": ["99cc2ac39495ab1324ab7705de4c64208987b2cc"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2042021 - Part 2: Use IsNotificationForbiddenFor for Push r=asuth\n\nThe principal check is not part of IsNotificationForbiddenFor and thus is repeated here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322392\n", "files": ["dom/notification/NotificationUtils.cpp", "dom/notification/NotificationUtils.h", "dom/notification/metrics.yaml", "dom/push/Push.sys.mjs", "dom/push/PushManager.cpp", "dom/push/test/mochitest.toml", "testing/web-platform/meta/push-api/cross-origin-nested.tentative.https.sub.window.js.ini", "testing/web-platform/meta/push-api/cross-origin-same-site-request.tentative.https.sub.window.js.ini"], "git_node": "d0e06abc473d8ade3ceb8dda05278a3b0d205b5d", "git_parents": ["f370a45646ee0b3ba0312d640f8b88f47686a352"], "node": "8fe05c5f34c99596e7e55b82a3a0ae3656fe7613", "parents": ["3e80d6addda4b4c94bcff8ec496b824e278ad1b8"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2074033: Override shared application data directories in xpcshell tests. r=ahal,win-reviewers,migration-reviewers,jhirsch,mconley,handyman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327775\n", "files": ["browser/components/backup/tests/xpcshell/head.js", "browser/components/backup/tests/xpcshell/test_BackupService_enable_disable_encryption.js", "browser/components/migration/tests/unit/head_migration.js", "browser/components/profiles/tests/unit/test_relative_profile_path.js", "browser/components/shell/test/unit/test_customIconManager.js", "testing/xpcshell/runxpcshelltests.py", "toolkit/components/backgroundtasks/BackgroundTasksTestUtils.sys.mjs", "toolkit/profile/test/xpcshell/head.js", "toolkit/profile/test/xpcshell/test_invalid_descriptor.js", "toolkit/xre/nsXREDirProvider.cpp", "widget/windows/tests/unit/test_windows_alert_service.js"], "git_node": "495416815bc3e6505dccc3274eef95274c3b52ce", "git_parents": ["d0e06abc473d8ade3ceb8dda05278a3b0d205b5d"], "node": "20ab0161336bac1b02c82307c7361ed40375b72f", "parents": ["8fe05c5f34c99596e7e55b82a3a0ae3656fe7613"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1963451 - Fix SmartBlock X embed shim for amp-twitter, an embed whose tracking script loads from a nested frame. r=emz,webcompat-reviewers,twisniewski\n\nAMP's \u003camp-twitter\u003e element loads platform.twitter.com/widgets.js from\nwithin a cross-origin sandbox iframe rather than from the document\ncontaining the embed markup.\n\nGeneralize the existing sub_frame parent-frame remapping (bug 1958060)\nto also apply whenever a smartblock embed shim's tracked request\noriginates outside the top frame, and add amp-twitter to the embed\nselector now that the script runs in the right document.\n\nAlso skip the \"Content from blocked embed\" preview section when\nsanitizing the embed's markup yields no text or links, as is the case\nfor amp-twitter before AMP's runtime populates it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319062\n", "files": ["browser/extensions/webcompat/lib/shims.js", "browser/extensions/webcompat/lib/smartblock_embeds_helper.js", "browser/extensions/webcompat/manifest.json", "browser/extensions/webcompat/shims/twitter-embed.js"], "git_node": "3c8d801e07f289f15b2b293a180bb8ad68317d28", "git_parents": ["495416815bc3e6505dccc3274eef95274c3b52ce"], "node": "5dc872d19b448d975b7b539bb647e0c33369bc3d", "parents": ["20ab0161336bac1b02c82307c7361ed40375b72f"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070841 - Skip cache validation when serving a navigation activated from a speculation-rules prefetch record. r=necko-reviewers,valentin\" for causing unexpected passes @redirect-url.https.html.\n\nThis reverts commit 3ea5a61f6b67b64bdd2e4c48ab6a1d80831b88a6.\n\nRevert \"Bug 2070841 - Discard a speculation-rules prefetch record whose final response is not an ok status. r=necko-reviewers,valentin\"\n\nThis reverts commit 9f025da9d59ef3d5c6de50fefa51827a93568ae5.\n", "files": ["dom/base/test/browser_prefetch_delivery_type.js", "dom/base/test/file_pageload_prefetch_target.sjs", "dom/ipc/PrefetchRecordParent.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "testing/web-platform/meta/speculation-rules/prefetch/clear-prefetch-cache-after-clear-site-data-cache.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/initiators-a-element.sub.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/mutate-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-delivery-type.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/navigation-timing-requestStart-responseStart.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/no-vary-search/prefetch-single.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-single.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-status.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/prefetch-traverse-reload.sub.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-from-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-not-accepted.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/same-origin-cookies.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/tentative/service-worker/basic.sub.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/tentative/service-worker/redirect.sub.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/user-pass.https.html.ini", "testing/web-platform/meta/storage-access-api/storage-access-headers.tentative.https.sub.window.js.ini"], "git_node": "0b3661d556f0fd926ae1829f7e7091542c65e189", "git_parents": ["3c8d801e07f289f15b2b293a180bb8ad68317d28"], "node": "93227ea5681bf013f7a973c14b8cfc9bffb33bec", "parents": ["5dc872d19b448d975b7b539bb647e0c33369bc3d"], "tags": []}], "date": 1791215770, "git_changesets": ["411db8361ab260b0556604f9fd2d873c1d815e8c", "93a4761cc864dbbd34c356dbce9363d5851a07b8", "9a8f4584ad74908a6e3c1b59bf9de1c9b9101b25", "3b2f615e6a3075a18eefae3b0e1e31cab6605974", "355addff1aeb57cf26961123ce7c36deb35d9947", "5a84a6db12629