.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "3224ac5efa4be0f5118412a7fba2a141c3d31e08", "git_parents": ["382bdd1c3d5f0b8a086cbc5db4d47c5779715792"], "node": "98a6a6aea984e92fd3d7bc8b875c7a698f095317", "parents": ["dd392faad84907b09ce1cb543b2bd84043ff6ddb"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074974 - Turn Recent Searches widget off by default for all regions r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328657\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "b3a1d91f1969244424d5886a1f9a3ea015d85973", "git_parents": ["3224ac5efa4be0f5118412a7fba2a141c3d31e08"], "node": "141a2e2caf4aed36d1b606110b7f10b0dc11075a", "parents": ["98a6a6aea984e92fd3d7bc8b875c7a698f095317"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066245 - Make Crossword available to English locales outside PL, off by default r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328658\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "161382e64b4e62b60b9029606092b1ea84d3de49", "git_parents": ["b3a1d91f1969244424d5886a1f9a3ea015d85973"], "node": "5174026f42904f405318bfa49d00b3bb5f4bdf0d", "parents": ["141a2e2caf4aed36d1b606110b7f10b0dc11075a"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075001 - Add a pref to enforce widget market gating on Nightly r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328659\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "ed47c732e25818e384a3df114216a3ab4e00b334", "git_parents": ["161382e64b4e62b60b9029606092b1ea84d3de49"], "node": "3022f953d2eeff21a4a98a6a75ab58681bf3a9d9", "parents": ["5174026f42904f405318bfa49d00b3bb5f4bdf0d"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071217 - Paint before flushing APZ repaints after scrollIntoView in scrollIntoViewToPositionFixed. r=geckoview-reviewers,hiro\n\nscrollIntoView requests a visual scroll that reaches APZ only with the next paint, and flushApzRepaints drains\nonly the repaint requests APZ already holds. Flushing first therefore returned before the scroll came back to\nthe main thread, so the test sometimes sampled pageTop before the first scrollIntoView had moved the visual\nviewport and attributed that move to the second call. Paint first, then flush, as promiseApzFlushedRepaints\ndoes for the APZ mochitests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328324\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/InteractiveWidgetTest.kt"], "git_node": "5c34849d071b57290343eb381f333109b895eeaa", "git_parents": ["ed47c732e25818e384a3df114216a3ab4e00b334"], "node": "cdea3f129fce679a876a0bf463b0c1430bf3d4af", "parents": ["3022f953d2eeff21a4a98a6a75ab58681bf3a9d9"], "tags": []}, {"author": "lola_t \u003cltokhtamuradova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067126  Create PlayerExpanded.kt and PlayerCompact.kt r=android-reviewers,android-l10n-reviewers,parker,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327128\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenAction.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenReducer.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/AudioProgressBar.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/ListenSheet.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayPauseButton.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerCompact.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/PlayerExpanded.kt", "mobile/android/android-components/components/feature/listentopage/src/main/res/values/strings.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_pause_outline_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_forward_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_rewind_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_speed_0_2x_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_speed_0_5x_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_speed_0_7x_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_speed_1_2x_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_speed_1_5x_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_speed_1_7x_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_speed_1x_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_playback_speed_2x_24.xml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/listentopage/ListenSheetIntegration.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "e164fee605e1e7c848cf5e20998f7d013d53d50c", "git_parents": ["5c34849d071b57290343eb381f333109b895eeaa"], "node": "e03f8c6024d8e6b71d2f178af19a5a6bc51284c8", "parents": ["cdea3f129fce679a876a0bf463b0c1430bf3d4af"], "tags": []}, {"author": "Moyin \u003cmadeyemi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074851 - Add Playback speed to the playback notification r=android-reviewers,android-l10n-reviewers,parker,matt-tighe\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328114\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenState.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionService.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/PlaybackController.kt", "mobile/android/android-components/components/feature/listentopage/src/main/res/values/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/PlaybackSpeedTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ListenMediaSessionServiceTest.kt"], "git_node": "be7c2d0f8c68cc6fd2c4c77fdd7376b09e83df98", "git_parents": ["e164fee605e1e7c848cf5e20998f7d013d53d50c"], "node": "f3b82d40e0ce81da8b1256e35d0f6ea6e81490c1", "parents": ["e03f8c6024d8e6b71d2f178af19a5a6bc51284c8"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074783 - Ensure PathRecording::MoveToBuilder calls ResetCachedState on the path. r=gfx-reviewers,tnikkel\n\nPathRecording::MoveToBuilder did not always call ResetCachedState, so it allowed the old mapping of the\npath to stay alive in an event recorder, even as the path was being reused inside the new PathBuilderRecording.\nResetCachedState just needs to be called in the other branch that does not call the actual PathBuilderRecording\nconstructor, so the path's identity is now effectively reset.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328715\n", "files": ["gfx/2d/PathRecording.cpp"], "git_node": "12e64d245ee8ba8667161be0e10ddf152c512fd4", "git_parents": ["be7c2d0f8c68cc6fd2c4c77fdd7376b09e83df98"], "node": "603397240e95b8dfe2ee7a9bbd888e88a2c2741b", "parents": ["f3b82d40e0ce81da8b1256e35d0f6ea6e81490c1"], "tags": []}, {"author": "rperta \u003crperta@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075001, Bug 2066245, Bug 2074974, Bug 2066247, Bug 2066248, Bug 2066246, Bug 2066244, Bug 2066242, Bug 2066240, Bug 2066236 - Add a pref to enforce widget market gating on Nightly r=reemhamz\"\n\nThis reverts commit ed47c732e25818e384a3df114216a3ab4e00b334.\n\nRevert \"Bug 2066245 - Make Crossword available to English locales outside PL, off by default r=reemhamz\"\n\nThis reverts commit 161382e64b4e62b60b9029606092b1ea84d3de49.\n\nRevert \"Bug 2074974 - Turn Recent Searches widget off by default for all regions r=reemhamz\"\n\nThis reverts commit b3a1d91f1969244424d5886a1f9a3ea015d85973.\n\nRevert \"Bug 2066247 - Turn Stocks widget off by default for all regions r=reemhamz\"\n\nThis reverts commit 3224ac5efa4be0f5118412a7fba2a141c3d31e08.\n\nRevert \"Bug 2066248 - Turn Privacy widget off by default for all regions. r=maxx\"\n\nThis reverts commit 382bdd1c3d5f0b8a086cbc5db4d47c5779715792.\n\nRevert \"Bug 2066246 - Turn POTD widget off by default for US, DE, FR, PL regions. r=maxx\"\n\nThis reverts commit 55a689218f99401467d90015a575d4523cf92402.\n\nRevert \"Bug 2066244 - Turn Clocks widget off by default for US, DE, FR, PL regions. r=maxx\"\n\nThis reverts commit 5caaa25b6f2947a0b8d89ed45fcc270455a876ea.\n\nRevert \"Bug 2066242 - Turn FocusTimer off by default in US, DE, FR, PL regions. r=maxx\"\n\nThis reverts commit 07530410c191dcf72d0a072201285c4e18408299.\n\nRevert \"Bug 2066240 - Turn the Lists widget off by default in the US, DE and FR, and block it in PL r=reemhamz\"\n\nThis reverts commit 39cce53885e69c3bd43886185020e46028fead1a.\n\nRevert \"Bug 2066236 - Gate widget availability by market r=reemhamz\"\n\nThis reverts commit 29c4e8a16e9a8538614d4b2b5083e26fc1540f0f.\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "d3de56a2f809fce046e22016b45722def52bcb76", "git_parents": ["12e64d245ee8ba8667161be0e10ddf152c512fd4"], "node": "f247d515ac74188e603598dc146e25e386cbd98a", "parents": ["603397240e95b8dfe2ee7a9bbd888e88a2c2741b"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069112 - Add the AITab table component r=mlucks,fluent-reviewers,bolsson,vazish\n\nAdds \u003caitab-table\u003e, the RankedTable block of an AITab page: a heading, an optional description, a header row of column labels and one row per item. The first column shows the item's name, any subtitle-role columns beneath it, and a source chip (reusing ai-website-chip) for the page the item came from. Rows are separated by dividers and long text wraps inside its column.\n\nShips with a Storybook story and browser-chrome tests for the component.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325474\n", "files": ["browser/components/aiwindow/models/aitab/component_schema.json", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.css", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.mjs", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_table.js", "browser/components/aiwindow/ui/test/browser/test_aitab_table.mjs", "browser/components/aiwindow/ui/test/browser/test_aitab_table_page.html", "browser/locales-preview/aiWindow.ftl"], "git_node": "6613410a584f21d0f2dc65ffcd64f5de02a659e9", "git_parents": ["d3de56a2f809fce046e22016b45722def52bcb76"], "node": "510a403963c659638bb9b6b3df617268b17cd422", "parents": ["f247d515ac74188e603598dc146e25e386cbd98a"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061052 - Add the AITab highlights component r=mlucks\n\nAdds \u003caitab-highlights\u003e; aitab-page imports the component so the element is registered in about:smartpage; mounting it from a page config is bug 2070256.\n\nShips with a Storybook story and browser-chrome tests alongside the other block components.\n\nhttps://www.figma.com/design/sIgXsbSFZjKIcfErMoBgLr/Smart-Window-Q3?node-id=16343-22767&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326308\n", "files": ["browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.css", "browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.mjs", "browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js"], "git_node": "c84c85315cd78bf736026867419c5e7a2b9e4323", "git_parents": ["6613410a584f21d0f2dc65ffcd64f5de02a659e9"], "node": "ae74ddf86313301989b5559f1f9499691f3b3287", "parents": ["510a403963c659638bb9b6b3df617268b17cd422"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074872 - Key WebRender render target FBOs by a unique id, not the GL texture name r=gfx-reviewers,lsalzman\n\nOn a lost context glGenTextures returns 0 for every new texture, so render\ntargets created before the device reset is handled collided in\nGlDevice::render_targets and tripped its duplicate-insert assert. Give each\nTexture a never-reused target id and use that as the key, as the FBOs were per\ntexture before they moved into the GL backend.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328641\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/types.rs"], "git_node": "9d02a6bc25622a9dec5ec430fcd41bb763b30b28", "git_parents": ["c84c85315cd78bf736026867419c5e7a2b9e4323"], "node": "27ce56a53e7430a2e3dff695c30cac6560a17ba4", "parents": ["ae74ddf86313301989b5559f1f9499691f3b3287"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073828 - Run the bouncer check from a mozrelease script and delete the mozharness one. r=ahal,taskgraph-reviewers,releng-reviewers,jcristau\n\n`bouncer_check.py` used mozharness only for option parsing, logging and\nthe layered config. The argparse script in `python/mozrelease` does the\nsame check. It HEADs each URL with three retries, requires an https\nresult on an allowed CDN host and exits 1 when any URL fails. The five\nproduct dictionaries from `configs/releases` become YAML data next to\nit, and the bouncer prefix, locales and CDN hosts that came through\n`EXTRA_MOZHARNESS_CONFIG` are command line arguments the transform\nbuilds from run fields the kinds now carry. Both kinds check out with\nthe `mach` sparse profile since nothing under `testing/mozharness` is\nneeded anymore.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327649\n", "files": ["python/mozrelease/mozrelease/bouncer/firefox_beta.yml", "python/mozrelease/mozrelease/bouncer/firefox_devedition.yml", "python/mozrelease/mozrelease/bouncer/firefox_esr.yml", "python/mozrelease/mozrelease/bouncer/firefox_nightly.yml", "python/mozrelease/mozrelease/bouncer/firefox_release.yml", "python/mozrelease/mozrelease/bouncer_check.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_bouncer_check.py", "taskcluster/gecko_taskgraph/transforms/bouncer_check.py", "taskcluster/kinds/cron-bouncer-check/kind.yml", "taskcluster/kinds/release-bouncer-check/kind.yml", "testing/mozharness/configs/releases/bouncer_firefox_beta.py", "testing/mozharness/configs/releases/bouncer_firefox_devedition.py", "testing/mozharness/configs/releases/bouncer_firefox_esr.py", "testing/mozharness/configs/releases/bouncer_firefox_nightly.py", "testing/mozharness/configs/releases/bouncer_firefox_release.py", "testing/mozharness/scripts/release/bouncer_check.py"], "git_node": "7efe8660b9ec72936fa472a68fd33da4fb25658c", "git_parents": ["9d02a6bc25622a9dec5ec430fcd41bb763b30b28"], "node": "b75279e5a4da935f6b3b5770516f0042fc02ba62", "parents": ["27ce56a53e7430a2e3dff695c30cac6560a17ba4"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073828 - Move the update verify config creator to mozrelease and drop `BaseScript`. r=taskgraph-reviewers,releng-reviewers,jcristau\n\nThe script already ran under `mach python` and imported mozrelease for\nevery release path helper, so it becomes a plain argparse script next to\nthem. Option parsing, logging and the retrying download are the only\nmozharness pieces it used. The retry keeps the same exception list and\nattempt counts, hg fallback to GitHub included, and the config it writes\nis unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327651\n", "files": ["python/mozrelease/mozrelease/update_verify_config_creator.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_update_verify_config_creator.py", "taskcluster/gecko_taskgraph/transforms/update_verify_config.py", "taskcluster/kinds/release-update-verify-config-next/kind.yml", "taskcluster/kinds/release-update-verify-config/kind.yml", "testing/mozharness/scripts/release/update-verify-config-creator.py"], "git_node": "805369e69e319f6c2abd21d9b2be4464cabf9a77", "git_parents": ["7efe8660b9ec72936fa472a68fd33da4fb25658c"], "node": "23aa8f3d1cdc5335db736aeabf50dce50f355c00", "parents": ["b75279e5a4da935f6b3b5770516f0042fc02ba62"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073828 - Move the Merkle tree and checksums file helpers to mozrelease. r=ahal\n\n`merkle.py` and `checksums.py` are release tooling with no mozharness\ndependency. They move unchanged together with the Merkle unit test,\nwhose vectors `BTVerificationTest.cpp` cites. The checksum generator\nimports them from the new place so the task keeps working at this\ncommit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327652\n", "files": ["python/mozrelease/mozrelease/checksums.py", "python/mozrelease/mozrelease/merkle.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_merkle.py", "security/ct/tests/gtest/BTVerificationTest.cpp", "testing/mozharness/mozharness/mozilla/checksums.py", "testing/mozharness/mozharness/mozilla/merkle.py", "testing/mozharness/scripts/release/generate-checksums.py", "testing/mozharness/test/python.toml", "testing/mozharness/test/test_mozilla_merkle.py"], "git_node": "e94148981c89fc3778ba7a1542e55d0ff46e8d3d", "git_parents": ["805369e69e319f6c2abd21d9b2be4464cabf9a77"], "node": "33b23aa9388367d0074c8229909f318a5e8d5659", "parents": ["23aa8f3d1cdc5335db736aeabf50dce50f355c00"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073828 - Generate the release checksums from mozrelease without mozharness or boto3. r=taskgraph-reviewers,releng-reviewers,jcristau\n\n`generate-checksums.py` used mozharness for option parsing, logging and\na virtualenv whose only purpose was boto3. The bucket is read unsigned\nthrough the S3 compatible XML listing and plain object fetches, so\n`requests` from the common site covers it and no virtualenv step\nremains. The kind runs the script under mach with the build image and\nwrites the SUMS and SUMMARY files to the artifact directory. The output\nfor 155.0.1 build1 is byte identical to the published files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327653\n", "files": ["python/mozrelease/mozrelease/generate_checksums.py", "python/mozrelease/test/python.toml", "python/mozrelease/test/test_generate_checksums.py", "taskcluster/gecko_taskgraph/transforms/release_generate_checksums.py", "taskcluster/kinds/release-generate-checksums/kind.yml", "testing/mozharness/scripts/release/generate-checksums.py"], "git_node": "72d39204930a3fbd66072d150f76713ec01dd15d", "git_parents": ["e94148981c89fc3778ba7a1542e55d0ff46e8d3d"], "node": "2576f8f8b6ced6bab6466d92cbf917a0c2030803", "parents": ["33b23aa9388367d0074c8229909f318a5e8d5659"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073829 - Run the desktop partner repacks from a run-task script. r=ahal,taskgraph-reviewers,releng-reviewers\n\n`desktop_partner_repacks.py` only fetched the GitHub ssh key, downloaded\nthe `repo` tool, ran `repo init` and `repo sync` with retries, and then\ninvoked `mach python partner_repack.py`. `partner-repack.sh` does the\nsame four steps with the task environment the transform already\nprovided, plus `REPACK_*` variables for the version, build number,\nplatform, partners and locale limit that used to travel as\n`MOZHARNESS_OPTIONS`. The ssh key comes from the same secret through the\ntaskcluster proxy, which `run-task` tasks with an hg checkout already\nenable. The `public/logs` artifact goes with the mozharness log. The\ntask graph for `mr-promote-firefox` is otherwise unchanged in scopes,\ndependencies and features.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327654\n", "files": ["taskcluster/docs/partner-repacks.md", "taskcluster/gecko_taskgraph/transforms/partner_repack.py", "taskcluster/kinds/release-eme-free-repack/kind.yml", "taskcluster/kinds/release-partner-repack/kind.yml", "taskcluster/scripts/release/partner-repack.sh", "testing/mozharness/configs/partner_repacks/release_mozilla-release_desktop.py", "testing/mozharness/configs/partner_repacks/release_mozilla-release_desktop_EME-free.py", "testing/mozharness/configs/partner_repacks/staging_release_mozilla-release_desktop.py", "testing/mozharness/scripts/desktop_partner_repacks.py"], "git_node": "886f8c8678124ad6ebb3d34009ddcd8e8be18bac", "git_parents": ["72d39204930a3fbd66072d150f76713ec01dd15d"], "node": "0d65675a261c1da04f04ac124d6f18b6d2fee1ad", "parents": ["2576f8f8b6ced6bab6466d92cbf917a0c2030803"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073826 - Move `does_it_crash.py` to `taskcluster/scripts/tests` and drop `BaseScript`. r=taskgraph-reviewers,jcristau\n\nThe startup test is pure CI glue with no local use. It already ran under\n`mach python`, imported `mozinstall` and `mozprocess` directly and used\nmozharness only for option parsing and logging, so it becomes an\nargparse script that exits 1 when the binary does not survive the run\nand still prints the `TEST-UNEXPECTED-FAIL` line Treeherder keys on. The\n`startup-test` sparse profile no longer needs `testing/mozharness`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327655\n", "files": ["build/sparse-profiles/startup-test", "taskcluster/gecko_taskgraph/transforms/startup_test.py", "taskcluster/scripts/tests/does_it_crash.py", "testing/mozharness/scripts/does_it_crash.py"], "git_node": "ec56a6e97ff49511bdd904c0155675cfad0e0831", "git_parents": ["886f8c8678124ad6ebb3d34009ddcd8e8be18bac"], "node": "cdc74fa4766c90307290af230882d937fe800659", "parents": ["0d65675a261c1da04f04ac124d6f18b6d2fee1ad"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Set `MOZCONFIG` in the environment of mozharness build tasks from taskgraph. r=ahal,taskgraph-reviewers,releng-reviewers\n\nThe mozconfig a build uses is task configuration, and taskgraph already\nresolves the variant, so it computes the path and passes it to the task\nas `MOZCONFIG`. The platform defaults to the longest mozconfig directory\nname that prefixes the task name, the application to `browser` or to\n`mobile/android` for Android platforms. A task with `config-paths` has\nto name its application, so comm-central fails at graph generation\ninstead of building from Firefox mozconfigs. Kinds that took a variant,\nplatform or application from a mozharness config now say so in their\nkind definitions. `artifact-build` and `valgrind` do not run the build\ntransforms and set the variable directly. The macOS unify tasks never\nrun mozharness and get nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327665\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_build.py", "taskcluster/gecko_taskgraph/transforms/build.py", "taskcluster/kinds/artifact-build/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build/android-asan.yml", "taskcluster/kinds/build/android-stuff.yml", "taskcluster/kinds/build/fenix.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx-native.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/release-source/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "taskcluster/kinds/valgrind/kind.yml"], "git_node": "27f59a6e61677a99f3965b2d1a56007f1ef9dd9f", "git_parents": ["ec56a6e97ff49511bdd904c0155675cfad0e0831"], "node": "2a1657fea83076866e2ef9915b9a7773468e33f1", "parents": ["cdc74fa4766c90307290af230882d937fe800659"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Take the mozconfig path from `MOZCONFIG` in mozharness builds. r=ahal\n\nThe task environment's `MOZCONFIG` is the source path relative to the\ncheckout, which mozharness copies to `.mozconfig` with\n`extra_mozconfig_content` appended. mozharness then points the build\nenvironment's `MOZCONFIG` at that `.mozconfig`, since mach reads\n`MOZCONFIG` before `.mozconfig` and the extra content would otherwise be\ndropped. `get_mozconfig_path` stays for `desktop_l10n.py`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327666\n", "files": ["testing/mozharness/mozharness/mozilla/building/buildbase.py"], "git_node": "d947ae6ed1aaba8e212951e16ec01958242bfb4c", "git_parents": ["27f59a6e61677a99f3965b2d1a56007f1ef9dd9f"], "node": "c8bdd8da420552f01003bb301d1a5b0b118150c8", "parents": ["2a1657fea83076866e2ef9915b9a7773468e33f1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Drop the mozconfig keys from the mozharness build configs. r=ahal\n\nNothing reads `app_name`, `mozconfig_platform`, `mozconfig_variant` or\n`src_mozconfig` from these files any more. The variant configs stay\nbecause most of them still carry `debug_build`, `env`,\n`disable_package_metrics` or `postflight_build_mach_commands`, and the\nAndroid ones that end up empty keep `--custom-build-variant-cfg` set,\nwhich `_is_configuration_shipped` checks through `build_variant`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327667\n", "files": ["testing/mozharness/configs/builds/releng_base_android_64_builds.py", "testing/mozharness/configs/builds/releng_base_firefox.py", "testing/mozharness/configs/builds/releng_base_linux_64_builds.py", "testing/mozharness/configs/builds/releng_base_mac_64_cross_builds.py", "testing/mozharness/configs/builds/releng_base_windows_32_mingw_builds.py", "testing/mozharness/configs/builds/releng_base_windows_64_mingw_builds.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_fenix_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_fuzzing_asan_tc.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_fuzzing_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_geckoview_docs.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_ccov.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_debug_isolated_process.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_opt.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_source.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_stat_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_valgrind.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_opt_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/rusttests.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_mingwclang.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_mingwclang.py", "testing/mozharness/configs/builds/taskcluster_base_win32.py", "testing/mozharness/configs/builds/taskcluster_base_win64.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/plain_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/rusttests_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/searchfox_debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/searchfox_opt.py"], "git_node": "e719470568dc70ac4acc15ee78874f7202ff96f1", "git_parents": ["d947ae6ed1aaba8e212951e16ec01958242bfb4c"], "node": "bacf6204bdfb886f7302d0fce06147cc2f4fc856", "parents": ["c8bdd8da420552f01003bb301d1a5b0b118150c8"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx+mozillians@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2074789 - Scope stub installer resources to stub installer enabled builds r=ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328450\n", "files": ["browser/installer/windows/moz.build", "browser/installer/windows/nsis/moz.build", "browser/moz.configure", "python/mozbuild/mozbuild/nsis.py"], "git_node": "bec308580fb0ea94f51071e3d4723a8aa82a8b1c", "git_parents": ["e719470568dc70ac4acc15ee78874f7202ff96f1"], "node": "6a5d17715f9c7909912193e78f34d1111f4d182d", "parents": ["bacf6204bdfb886f7302d0fce06147cc2f4fc856"], "tags": []}, {"author": "Makoto Kato \u003cm_kato@ga2.so-net.ne.jp\u003e", "branch": "default", "desc": "Bug 2075075 - Change GeckoClipboardContentProvider's attribute. r=geckoview-reviewers,jonalmeida\n\nGeckoClipboardContentProvider was introduced for custom clipboard type of\nclipboard API. But this is marked as exported. This should not be\nexported.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328724\n", "files": ["mobile/android/geckoview/src/main/AndroidManifest_overlay.jinja"], "git_node": "e96e98dc1bf7ddb55bc0fb9e16c96e9cbcecdae8", "git_parents": ["bec308580fb0ea94f51071e3d4723a8aa82a8b1c"], "node": "bd23d80e8c98667a636939638450c13ac15e3bfd", "parents": ["6a5d17715f9c7909912193e78f34d1111f4d182d"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069666: Let a tab detached from a fullscreen window choose its own position. r=tabbrowser-reviewers,sthompson\n\nSince bug 2051071 the new window no longer enters fullscreen on its initial show, which made the position we pass along for it visible: `left` and `top` are clamped to leave room for a window as large as the one the tab is dragged from, and a fullscreen window covers the screen, so they collapse onto the corner of the available screen rect and the new window opens in that corner, on top of the fullscreen window.\n\nThe new window doesn't take our size either, since bug 1946016 stopped passing outerWidth and outerHeight along on macOS, so there is no drop position left to compute for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327658\n", "files": ["browser/components/tabbrowser/content/drag-and-drop.js", "browser/components/tabbrowser/test/browser/tabs/browser.toml", "browser/components/tabbrowser/test/browser/tabs/browser_tab_detach_fullscreen.js"], "git_node": "f77ef65a103b759018a25d9b529337a032b59b2b", "git_parents": ["e96e98dc1bf7ddb55bc0fb9e16c96e9cbcecdae8"], "node": "ff1ba21fc05eb5e7dd8efcbfcac0bd0221156b12", "parents": ["bd23d80e8c98667a636939638450c13ac15e3bfd"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074835 - Re-enable verifyTheMoreMainMenuSummarizePageButtonTest UI test and convert it to the efficiency framework r=aaronmt\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328505\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/MainMenuTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "eb9994c99d35e6b653e95579e0d43f8de63fed1f", "git_parents": ["f77ef65a103b759018a25d9b529337a032b59b2b"], "node": "fee7bba9c5ff959016b304415818592d2288366d", "parents": ["ff1ba21fc05eb5e7dd8efcbfcac0bd0221156b12"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071187 - Only set `checkout.workers` for the initial checkout in `bin\\bootstrap.py` r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325583\n", "files": ["python/mozboot/bin/bootstrap.py"], "git_node": "5d2eccb08fd2df4f7c5a11234b51de76d028b6e9", "git_parents": ["eb9994c99d35e6b653e95579e0d43f8de63fed1f"], "node": "9dad93198d85bf5f9ca7cf57a23aa4eed0e13563", "parents": ["fee7bba9c5ff959016b304415818592d2288366d"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073144 - Lint all dom/localstorage headers through clang-tidy r=dom-storage-reviewers,jari\n\nChanges includes:\n- making deleted methods public\n- rework some include dependencies to make header self contained\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327965\n", "files": ["dom/localstorage/LSValue.h", "dom/localstorage/SerializationHelpers.h"], "git_node": "9017704293aa97a369786274ab2b8b851ea10897", "git_parents": ["5d2eccb08fd2df4f7c5a11234b51de76d028b6e9"], "node": "795fd518ce8dca8e4de1095bc0b73fe1694e37e0", "parents": ["9dad93198d85bf5f9ca7cf57a23aa4eed0e13563"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073144 - Lint all dom/ipc  headers through clang-tidy r=dom-core-reviewers,smaug\n\nChanges includes:\n- using range-based loop where appropriate\n- making deleted methods public\n- rework some include dependencies to make header self contained\n- move some definition to source file to break circular dependencies\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327966\n", "files": ["dom/ipc/PageLoadEventUtils.h", "dom/ipc/PrefetchMatchWaiter.cpp", "dom/ipc/PrefetchMatchWaiter.h", "dom/ipc/TabContext.h", "dom/ipc/URLClassifierChild.h", "dom/ipc/jsactor/JSWindowActorParent.cpp", "dom/ipc/jsactor/JSWindowActorParent.h"], "git_node": "d280a68ca683dacf8c7ce9bb6eeba80f483ef9ad", "git_parents": ["9017704293aa97a369786274ab2b8b851ea10897"], "node": "6bf76b2404a0a42327d0a7205eb72173390db9ce", "parents": ["795fd518ce8dca8e4de1095bc0b73fe1694e37e0"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073144 - Lint all dom/indexedDB through clang-tidy r=dom-storage-reviewers,jari\n\nChanges includes:\n- using C++20 inline variable\n- rework some include dependencies to make header self contained\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327967\n", "files": ["dom/indexedDB/IDBRequest.h", "dom/indexedDB/SafeRefPtr.h"], "git_node": "e41f0222a2583f594189477e3c80dbfa53f662ab", "git_parents": ["d280a68ca683dacf8c7ce9bb6eeba80f483ef9ad"], "node": "41dccef1e01e13cd1bb3718f533404c7be7fa126", "parents": ["6bf76b2404a0a42327d0a7205eb72173390db9ce"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073013 - Make DebugOnly and ReentrancyGuard compatible with modernize-use-equal-default r=nika\n\nIt would be better to mark those as [[maybe_unused]], but sixgill does\nnot support this as of this patch, and marking every instantiation of\nthose classes as [[maybe_unused]] does not scale.\n\nSo don't go to extremities just for the sake of a clang-tidy warning.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326927\n", "files": ["js/src/vm/Interpreter.cpp", "mfbt/DebugOnly.h", "mfbt/ReentrancyGuard.h"], "git_node": "eeda0b26d2206f2dd3b4e266482806b1546f78ad", "git_parents": ["e41f0222a2583f594189477e3c80dbfa53f662ab"], "node": "cb6699aa7e56f07dd77c444897f0ce4a70e4ea41", "parents": ["41dccef1e01e13cd1bb3718f533404c7be7fa126"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073023 - Lint all mfbt headers through clang-tidy r=nika\n\nChanges includes:\n- using C++20 type traits\n- making deleted methods public\n- use std::forward instead of std::move to prevent lifetime issues\n- avoid confusing constructor through universal references\n- rework some include dependencies\n- add extra require(...) clauses when only r-value are expected\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326930\n", "files": ["mfbt/ArrayUtils.h", "mfbt/Atomics.h", "mfbt/CheckedInt.h", "mfbt/DbgMacro.h", "mfbt/DoublyLinkedList.h", "mfbt/EndianUtils.h", "mfbt/EnumTypeTraits.h", "mfbt/HashFunctions.h", "mfbt/HashTable.h", "mfbt/LinkedList.h", "mfbt/MaybeOneOf.h", "mfbt/NotNull.h", "mfbt/RangedPtr.h", "mfbt/ReentrancyGuard.h", "mfbt/RefCounted.h", "mfbt/SPSCQueue.h", "mfbt/Saturate.h", "mfbt/ScopeExit.h", "mfbt/SplayTree.h", "mfbt/Tainting.h", "mfbt/TiedFields.h", "mfbt/Variant.h", "mfbt/Vector.h"], "git_node": "12682b928e5ac388af95e7f29c582c1e96c91351", "git_parents": ["eeda0b26d2206f2dd3b4e266482806b1546f78ad"], "node": "8615a589a2226bce3d464d96a9eb60f0c5de925f", "parents": ["cb6699aa7e56f07dd77c444897f0ce4a70e4ea41"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064400 - [devtools] Add CSS explainer attribute on \u003clength\u003e and \u003cpercentage\u003e tokens in OutputParser. r=devtools-reviewers,ochameau.\n\nThis adds an attribute on the generated DOM for simple value (i.e. not used in function calls)\nwhose dimension is not `px` (e.g. `10vw`, `2em`, `3cqmin`, `4lh`, \u2026)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327270\n", "files": ["devtools/client/shared/output-parser.js", "devtools/client/shared/test/browser_outputparser.js"], "git_node": "4e5791f75f4bc9b9ef936af825a07d49f9db9ce1", "git_parents": ["12682b928e5ac388af95e7f29c582c1e96c91351"], "node": "26091bca0b917b773db7028a22fa747925d77a53", "parents": ["8615a589a2226bce3d464d96a9eb60f0c5de925f"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064400 - [devtools] Show CSS explainers tooltip for \u003clength\u003e tokens. r=devtools-reviewers,ochameau.\n\nThis adds the tooltip for simple value (i.e. not used in function calls) whose\ndimension is not `px` (e.g. `10vw`, `2em`, `3cqmin`, `4lh`, \u2026)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327271\n", "files": ["devtools/client/inspector/rules/test/browser_rules_css_explainers.js", "devtools/client/inspector/rules/utils/utils.js", "devtools/client/inspector/shared/tooltips-overlay.js", "devtools/client/themes/rules.css"], "git_node": "92982ceabe60f502e48d0c24318c3f48d6c5ab1e", "git_parents": ["4e5791f75f4bc9b9ef936af825a07d49f9db9ce1"], "node": "3714749f468518c70e72a1f1e7ce