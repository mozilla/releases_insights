65cbfda355e4a15cb609832aea354e1b9f6cfff", "7fc7dad0274a14d751b7345116ea9e1677c76a20", "eaf094351bc2ab623fe80cae2e4b3b3bdabcd7a6", "7dce472c850866f0da050c9fe22fa3fc01f3753f", "576a235398f4d4f7eade286e5f565cf58fcdfbd8", "97b8042d11fa7b783991bb8ed4184f1c06b777cd", "181ada5d6de3bd8e4ee57a2f4be49c9e583f63a0", "790dbd203bb7f8b51ea80f3a7f51650282a7d217", "2d50970993bc9a604f5ab096481d3f0dd5bc5cbc", "65b84b957a31de4c85c650b0813f16f94bba1398", "62fb6728c9b97ee6ef0493bd6aec8edb6ab3df10", "fb06e2694bf6aca68942ca72bb2c8521b3938c31", "182b90eb34251582b909e7dfd1d2b7defc1bd8c2", "ce200e865b2867077cd78708d658caeff5c7c81b", "b9057dff00529cfcb0a5e576614908423a1a1ce1"], "user": "ctuns@mozilla.com"}, "45418": {"changesets": [{"author": "Cristian Tuns \u003cctuns@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2050488 - Run WPT testharness with --processes=3 on bare-metal macOS aarch64 r=jgraham\" for causing wpt failures in mousemove-across.html\n\nThis reverts commit 19dddd19a195fa68b01a1e203ea7228b2cfa9b61.\n", "files": ["testing/mozharness/scripts/web_platform_tests.py"], "git_node": "0a5c5bffebd796cedba281419efd2f8f3cc7c85d", "git_parents": ["b9057dff00529cfcb0a5e576614908423a1a1ce1"], "node": "2540d2ffbff0a35d8aa712e9b434c5413dbb8023", "parents": ["9ce77ca5b39c9544b4b1de2dff7ad09f7f0fbb95"], "tags": []}], "date": 1790311004, "git_changesets": ["0a5c5bffebd796cedba281419efd2f8f3cc7c85d"], "user": "ctuns@mozilla.com"}, "45419": {"changesets": [{"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - updated default_config_env for v155\n", "files": ["dom/media/webrtc/third_party_build/default_config_env"], "git_node": "6de37f960413fd8ea1f060b3648384f35f56e09c", "git_parents": ["0a5c5bffebd796cedba281419efd2f8f3cc7c85d"], "node": "f4f2d4b69a45048d3cd0c372020a2951da3d9959", "parents": ["2540d2ffbff0a35d8aa712e9b434c5413dbb8023"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - updated libwebrtc patch stack\n", "files": ["third_party/libwebrtc/moz-patch-stack/573c5c6224.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch", "third_party/libwebrtc/moz-patch-stack/s0149.patch", "third_party/libwebrtc/moz-patch-stack/s0150.patch"], "git_node": "278294c4a36e50fdf1c54e44ceba5ac76fab5e3b", "git_parents": ["6de37f960413fd8ea1f060b3648384f35f56e09c"], "node": "320ab62fa3a329554c5f8b23c39e941c6e12408a", "parents": ["f4f2d4b69a45048d3cd0c372020a2951da3d9959"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from a3d248f953\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a3d248f9530d9bad2e99444867bcb1cc414aa731\n    pc: trace the standardized ICE connection state\n\n    PeerConnectionTracerInterface::OnIceConnectionStateChanged() was fired\n    from SetIceConnectionState(), which maintains the legacy state reported\n    by PeerConnectionObserver::OnIceConnectionChange() - the one that also\n    reports kIceConnectionCompleted. Embedders receive the standardized\n    state via OnStandardizedIceConnectionChange() instead, so the tracer\n    reported a different value than the observer it is meant to mirror.\n    Chromium, for example, implements the legacy callback as an empty body.\n\n    Move the hook to SetStandardizedIceConnectionState(), next to the\n    callback it mirrors, matching how SetConnectionState() is instrumented,\n    and say which state it is in the interface documentation.\n\n    Bug: webrtc:532923549\n    Change-Id: Ida925c4032f5e053e82eebc4c45953b9dc471af9\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497860\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48448}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/peer_connection_tracer_interface.h", "third_party/libwebrtc/pc/peer_connection.cc"], "git_node": "b53ff906ada770011535be68f7b8f2ea16f3c4aa", "git_parents": ["278294c4a36e50fdf1c54e44ceba5ac76fab5e3b"], "node": "b0b1480e970bba0470d18e7030ab0c3b9719c5fc", "parents": ["320ab62fa3a329554c5f8b23c39e941c6e12408a"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from aff496d7c8\n\nUpstream commit: https://webrtc.googlesource.com/src/+/aff496d7c8afb99cc36e39b55f671ad4f7ff789c\n    Implement Video Callback and Deprecate Video GetSources\n\n    This is step #3 of 5 of incrementally landing the changes from:\n    https://webrtc-review.git.corp.google.com/c/src/+/494041/ (a CL that's\n    pretty big as is).\n\n    The overall goal of these CLs is to move the SourceTracker from\n    ChannelReceive (audio) and VideoReceiveStream2 (video) into\n    RtpReceiverBase and be accessible on the signaling thread rather than\n    interfere with the worker (usually joined with network) thread. This\n    offloads the worker/network thread for managing the SourceTracker and\n    also moves the tracker closer to the API layer which it implements\n    (getContributingSources).\n\n    In this CL: Update VideoReceiveStream2 to capture time and invoke the\n    callback. Keep GetSources() functional.\n\n    Bug: chromium:463591201, webrtc:42222117\n    Change-Id: I4eb4ef0cc10c9a5e00c148c3cb4b9e06345a1660\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497780\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48449}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/video/BUILD.gn", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h", "third_party/libwebrtc/video/video_receive_stream2_unittest.cc"], "git_node": "2d5ff85b7f7605339a11c48670981d03b06a941f", "git_parents": ["b53ff906ada770011535be68f7b8f2ea16f3c4aa"], "node": "9f576b4e1591969e86670b69c5b17710b08bd223", "parents": ["b0b1480e970bba0470d18e7030ab0c3b9719c5fc"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from aff496d7c8 - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/moz.build"], "git_node": "6a8d03d969fdd98a4dee8c91c1dcd677d3c9e352", "git_parents": ["2d5ff85b7f7605339a11c48670981d03b06a941f"], "node": "aaab88a8ad08c35917905bdec6f24e6b7cb037c4", "parents": ["9f576b4e1591969e86670b69c5b17710b08bd223"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from f42551fe4c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f42551fe4c84391810cb98e836dddcfa1d1d7da0\n    Wayland capturer: Unbind EGL context after processing DMA-BUF frames\n\n    When capturing DMA-BUF textures in the Wayland desktop capturer,\n    EglDrmDevice::ImageFromDmaBuf() calls EglMakeCurrent() to bind\n    egl_.context to PipeWire's worker thread. However, the context was never\n    unbound when the frame finished.\n\n    When a screencast stream is stopped and restarted (e.g. when a client\n    disconnects and reconnects), a new PipeWire worker thread is spawned.\n    When the new thread attempts to call EglMakeCurrent(), EGL fails with\n    EGL_BAD_ACCESS because the context is still marked as bound to the\n    previous thread. This causes GlCheckFramebufferStatus() to fail and\n    permanently marks the DMA-BUF modifier as failed, forcing PipeWire to\n    fall back to slower MemFd (shared memory) textures.\n\n    This change:\n    1. Calls EglMakeCurrent(..., EGL_NO_CONTEXT) at the end of\n       ImageFromDmaBuf() (and on error return paths) to unbind the\n       context after reading pixels.\n    2. Checks the return value of EglMakeCurrent() when binding the\n       context.\n    3. Cleans up ~EglDrmDevice() by removing redundant GlDelete* and\n       unbind calls, as EglDestroyContext() automatically frees all\n       GL resources created within the context once it is no longer\n       current on any thread.\n\n    TAG=agy\n    CONV=b52ed9e9-5f30-4609-93f0-e6626988e820\n\n    Bug: webrtc:553567123\n    Change-Id: Ib3cb09ab356bb77b1524a1ad35d9a72b26422ede\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497680\n    Reviewed-by: Mark Foltz \u003cmfoltz@chromium.org\u003e\n    Commit-Queue: Lambros Lambrou \u003clambroslambrou@google.com\u003e\n    Reviewed-by: Jan Grulich \u003cgrulja@gmail.com\u003e\n    Auto-Submit: Lambros Lambrou \u003clambroslambrou@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48450}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/desktop_capture/linux/wayland/egl_dmabuf.cc", "third_party/libwebrtc/moz-patch-stack/s0063.patch"], "git_node": "85556049619ac3aee1c982a4111c62adf25081ff", "git_parents": ["6a8d03d969fdd98a4dee8c91c1dcd677d3c9e352"], "node": "e4aed0dd5bb103de01b2afaeb90a8223ea73c76f", "parents": ["aaab88a8ad08c35917905bdec6f24e6b7cb037c4"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 35cfc6541c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/35cfc6541cbce81b6ce097c5e78ff17fd3f8f65f\n    Update WebRTC code version (2026-09-01T04:06:37).\n\n    Bug: None\n    Change-Id: I1ff8ae4cbe039ff998b09b094cdf5b6382815ce2\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498120\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48451}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "a6601ada0c6e85863805ee2f59474ca32b8435c5", "git_parents": ["85556049619ac3aee1c982a4111c62adf25081ff"], "node": "99df31cef7b31e6589d1eb9db1f2f534f1dc74c2", "parents": ["e4aed0dd5bb103de01b2afaeb90a8223ea73c76f"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 4d9beec2a9\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4d9beec2a9d5ade9e6be81f522d194c240d9f559\n    Avoid vector copies when passing containers to helper functions\n\n    Use std::span when passing containers to helper\n    functions across congestion control, pacing, and PC media session setup.\n\n    Bug: webrtc:374845009\n    Change-Id: Iccde64c8e928fbd97575321226c426ec3aaf8e41\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/495641\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48452}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/base/codec_list.cc", "third_party/libwebrtc/media/base/codec_list.h", "third_party/libwebrtc/modules/congestion_controller/goog_cc/probe_controller.cc", "third_party/libwebrtc/modules/congestion_controller/goog_cc/probe_controller.h", "third_party/libwebrtc/modules/pacing/pacing_controller_unittest.cc", "third_party/libwebrtc/modules/pacing/rtp_packet_pacer.h", "third_party/libwebrtc/modules/pacing/task_queue_paced_sender.cc", "third_party/libwebrtc/modules/pacing/task_queue_paced_sender.h", "third_party/libwebrtc/modules/pacing/task_queue_paced_sender_unittest.cc", "third_party/libwebrtc/pc/codec_vendor.cc", "third_party/libwebrtc/pc/codec_vendor.h", "third_party/libwebrtc/pc/media_session.cc", "third_party/libwebrtc/pc/rtp_receiver.cc", "third_party/libwebrtc/pc/rtp_receiver.h", "third_party/libwebrtc/rtc_tools/rtc_event_log_visualizer/analyze_bwe.cc"], "git_node": "7a9177a411e7bc0bf4cd178bc7409ec2d89b3355", "git_parents": ["a6601ada0c6e85863805ee2f59474ca32b8435c5"], "node": "309f2c6399f93ce88dff6d6fa24ac1793cd91fce", "parents": ["99df31cef7b31e6589d1eb9db1f2f534f1dc74c2"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from c75b66ca37\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c75b66ca37178b1d62591fc1a835120943afae28\n    Switch PeerConnection layer to Callback & Signaling Thread\n\n    This is step #4 of 5 of incrementally landing the changes from:\n    https://webrtc-review.git.corp.google.com/c/src/+/494041/ (a CL that's\n    pretty big as is).\n\n    The overall goal of these CLs is to move the SourceTracker from\n    ChannelReceive (audio) and VideoReceiveStream2 (video) into\n    RtpReceiverBase and be accessible on the signaling thread rather than\n    interfere with the worker (usually joined with network) thread. This\n    offloads the worker/network thread for managing the SourceTracker and\n    also moves the tracker closer to the API layer which it implements\n    (getContributingSources).\n\n    In this CL: Move SourceTracker into RtpReceiverBase on the signaling\n    thread. Update RtpTransceiver to pipe callback notifications from media\n    layers to receivers. Remove RtpReceiver dependency on media layer\n    GetSources().\n\n    Bug: chromium:463591201, webrtc:42222117\n    Change-Id: Ib3692fbb6c8307cf9f00f29bb995b8e8f084fae1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497800\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48453}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/media/BUILD.gn", "third_party/libwebrtc/media/base/fake_media_engine.cc", "third_party/libwebrtc/media/base/fake_media_engine.h", "third_party/libwebrtc/media/base/media_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_video_engine_unittest.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine_unittest.cc", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0100.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/audio_rtp_receiver.cc", "third_party/libwebrtc/pc/audio_rtp_receiver.h", "third_party/libwebrtc/pc/peer_connection_integrationtest.cc", "third_party/libwebrtc/pc/rtp_receiver.cc", "third_party/libwebrtc/pc/rtp_receiver.h", "third_party/libwebrtc/pc/rtp_receiver_proxy.h", "third_party/libwebrtc/pc/rtp_sender_receiver_unittest.cc", "third_party/libwebrtc/pc/rtp_transceiver.cc", "third_party/libwebrtc/pc/rtp_transceiver.h", "third_party/libwebrtc/pc/rtp_transmission_manager.cc", "third_party/libwebrtc/pc/test/mock_rtp_receiver_internal.h", "third_party/libwebrtc/pc/video_rtp_receiver.cc", "third_party/libwebrtc/pc/video_rtp_receiver.h"], "git_node": "878e02ff4f4d06b73546f87088b1a1792508cdbe", "git_parents": ["7a9177a411e7bc0bf4cd178bc7409ec2d89b3355"], "node": "7656baa7df4f0076c13fba415229ce7ff1852c28", "parents": ["309f2c6399f93ce88dff6d6fa24ac1793cd91fce"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 434c31723f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/434c31723fa1868771e0a9d26c8c966dddbbb284\n    SCReAM: Clamp pacing rate to minimum allocated bitrate\n\n    This CL clamps the pacing rate in ScreamNetworkController to at least\n    min_total_allocated_bitrate * pacing_factor from StreamsConfig.\n\n    Clamping pacing rate ensures that packets produced at the minimum\n    encoding rate do not accumulate artificial pacer queue delay when target\n    bitrate drops to low values or zero.\n\n    Bug: webrtc:447037083\n    Change-Id: Ib72c9d7eb96a4da5f1fbef3c223d4f8079771325\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498160\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48454}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller.h", "third_party/libwebrtc/modules/congestion_controller/scream/scream_network_controller_unittest.cc"], "git_node": "5c63b9893707acb60f72d304cc73ac5b4b100a00", "git_parents": ["878e02ff4f4d06b73546f87088b1a1792508cdbe"], "node": "c2e15e67e6728dcf18636fc5ab62d12f1998b4a0", "parents": ["7656baa7df4f0076c13fba415229ce7ff1852c28"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from e2b181874e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e2b181874ec8e17d4789690e250efd267a5b1258\n    Add reference buffer track utility class.\n\n    This adds a class used to track the timestamp of the frame for each\n    reference buffer in an encoder. This is used to set up the primary\n    reference frames in v2 AV1 encoder, though it's designed to be generic\n    so that it can be used by other codecs too.\n\n    Bug: webrtc:496266459\n    Change-Id: I38b7b6ace65274b547afb476e69b62fc21927513\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498180\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48455}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/libaom_av1_encoder_factory_test.cc", "third_party/libwebrtc/modules/video_coding/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/av1/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.h", "third_party/libwebrtc/modules/video_coding/utility/reference_buffer_tracker.cc", "third_party/libwebrtc/modules/video_coding/utility/reference_buffer_tracker.h", "third_party/libwebrtc/modules/video_coding/utility/reference_buffer_tracker_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch"], "git_node": "c06404708ae16b200f4c3788728fff8080136dd0", "git_parents": ["5c63b9893707acb60f72d304cc73ac5b4b100a00"], "node": "47c70bceeffa04850367a29e9b8e4b94a300023c", "parents": ["c2e15e67e6728dcf18636fc5ab62d12f1998b4a0"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from e2b181874e - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/modules/video_coding/video_coding_utility_gn/moz.build"], "git_node": "c1c9299301f195fdef99427b8bd8f8cf15f8b0cb", "git_parents": ["c06404708ae16b200f4c3788728fff8080136dd0"], "node": "a83d7847cf65979fc791e879bc78440150ea70a1", "parents": ["47c70bceeffa04850367a29e9b8e4b94a300023c"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 17c6ed323a\n\nUpstream commit: https://webrtc.googlesource.com/src/+/17c6ed323acc09bd305318b557f9c50aa438a624\n    In Vp8RefFinder move caches cleanups\n\n    Do such cleanup for incoming packets, but skip them when unstashing\n    packets as that should be noop.\n\n    Bug: webrtc:552295095\n    Change-Id: I349206578b016f0155f188e37dc918af3597ed6c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498161\n    Reviewed-by: Rasmus Brandt \u003cbrandtr@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48456}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/video_coding/rtp_vp8_ref_finder.cc", "third_party/libwebrtc/modules/video_coding/rtp_vp8_ref_finder.h"], "git_node": "2019978ddf6cfa93eceaeb65205f76baa2ca46f2", "git_parents": ["c1c9299301f195fdef99427b8bd8f8cf15f8b0cb"], "node": "7453cb828adb377989c1636d102e55c5112cc8ab", "parents": ["a83d7847cf65979fc791e879bc78440150ea70a1"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 7a21897a7e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7a21897a7ea1801c954d3f23d5f913adf195e164\n    Plumb Environment into SendStatisticsProxy\n\n    Pass Environment instead of separate Clock and FieldTrialsView dependencies.\n\n    Bug: None\n    Change-Id: I22ab2337a726bc0fd00b516502b8507b88dfb52d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497840\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Joachim Reiersen \u003cjoachimr@meta.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48457}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/video/BUILD.gn", "third_party/libwebrtc/video/send_statistics_proxy.cc", "third_party/libwebrtc/video/send_statistics_proxy.h", "third_party/libwebrtc/video/send_statistics_proxy_unittest.cc", "third_party/libwebrtc/video/video_send_stream_impl.cc", "third_party/libwebrtc/video/video_send_stream_impl_unittest.cc", "third_party/libwebrtc/video/video_stream_encoder_unittest.cc"], "git_node": "dee155a8d067244396fb1027a9c10bbc78c9b01e", "git_parents": ["2019978ddf6cfa93eceaeb65205f76baa2ca46f2"], "node": "842031cc2d4dde66e50b6c9e9e0f78a173bfa5b0", "parents": ["7453cb828adb377989c1636d102e55c5112cc8ab"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from a0e17a2bcb\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a0e17a2bcbfd12436daeb155302cee484726ebaf\n    Cleanup collecting AddIceCandidate histogram as obsolete\n\n    Bug: chromium:539525974\n    Change-Id: Ief358489f8395c6b873bc9554e9e1a27299cfa6c\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498260\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Auto-Submit: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48458}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/pc/peer_connection_ice_unittest.cc", "third_party/libwebrtc/pc/sdp_offer_answer.cc"], "git_node": "7f9922f957ae6ef76bc555d6863f6cab241b03e2", "git_parents": ["dee155a8d067244396fb1027a9c10bbc78c9b01e"], "node": "cdf37259af68e7ee3349fbcb9473f46a98bfe382", "parents": ["842031cc2d4dde66e50b6c9e9e0f78a173bfa5b0"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from a485f8930c\n\nEssentially a no-op since we're going to see this change\nreverted when we vendor in c437def08e.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a485f8930cb9829fcb98ee5d4155dfa96c0f6c8f\n    Add generalized functional unit tests for VideoEncoderInterface.\n\n    This CL adds unit tests for the \"v2\" video encoder API. The tests are\n    generalized and verifies that the capabilities reported by the encoder\n    factory match what the encoder can do. These supercede the existing\n    implementation-specific tests.\n\n    Note that rate control, spatial quality and performance are not part of\n    this test. Those will come in follow-up CLs.\n\n    Bug: webrtc:496266459\n    Change-Id: Iebcee8ce04135006a31013ff8bae6e648117f4d6\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498080\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48459}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/c437def08e.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch"], "git_node": "a44b73b9bd75ee1292cd0dea5133be174f564baf", "git_parents": ["7f9922f957ae6ef76bc555d6863f6cab241b03e2"], "node": "230f0c7103d4abde6fc3475e265f5d8a4f45dbd5", "parents": ["cdf37259af68e7ee3349fbcb9473f46a98bfe382"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from ff3bf0dc7b\n\nUpstream commit: https://webrtc.googlesource.com/src/+/ff3bf0dc7be13fa74d67ab2df0a4efdefbb5bc51\n    Remove deprecated GetSources() implementations\n\n    This is step #5 of 5 of incrementally landing the changes from:\n    https://webrtc-review.git.corp.google.com/c/src/+/494041/ (a CL that's\n    pretty big as is).\n\n    The overall goal of these CLs is to move the SourceTracker from\n    ChannelReceive (audio) and VideoReceiveStream2 (video) into\n    RtpReceiverBase and be accessible on the signaling thread rather than\n    interfere with the worker (usually joined with network) thread. This\n    offloads the worker/network thread for managing the SourceTracker and\n    also moves the tracker closer to the API layer which it implements\n    (getContributingSources).\n\n    In this CL: Remove deprecated GetSources() implementations from media\n    and call interfaces now that PC layer no longer calls them.\n\n    Bug: chromium:463591201, webrtc:42222117\n    Change-Id: Iee48c4ad97edf19a49ea7def40c2142c2590c218\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497820\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48460}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/audio_receive_stream.cc", "third_party/libwebrtc/audio/audio_receive_stream.h", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/audio/channel_receive.h", "third_party/libwebrtc/audio/mock_voe_channel_proxy.h", "third_party/libwebrtc/call/receive_stream.h", "third_party/libwebrtc/call/test/mock_audio_receive_stream.h", "third_party/libwebrtc/media/base/fake_media_engine.cc", "third_party/libwebrtc/media/base/fake_media_engine.h", "third_party/libwebrtc/media/base/media_channel.h", "third_party/libwebrtc/media/engine/fake_webrtc_call.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/media/engine/webrtc_voice_engine.cc", "third_party/libwebrtc/media/engine/webrtc_voice_engine.h", "third_party/libwebrtc/moz-patch-stack/p0002.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0039.patch", "third_party/libwebrtc/moz-patch-stack/s0040.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0042.patch", "third_party/libwebrtc/moz-patch-stack/s0043.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0045.patch", "third_party/libwebrtc/moz-patch-stack/s0046.patch", "third_party/libwebrtc/moz-patch-stack/s0047.patch", "third_party/libwebrtc/moz-patch-stack/s0048.patch", "third_party/libwebrtc/moz-patch-stack/s0049.patch", "third_party/libwebrtc/moz-patch-stack/s0050.patch", "third_party/libwebrtc/moz-patch-stack/s0051.patch", "third_party/libwebrtc/moz-patch-stack/s0052.patch", "third_party/libwebrtc/moz-patch-stack/s0053.patch", "third_party/libwebrtc/moz-patch-stack/s0054.patch", "third_party/libwebrtc/moz-patch-stack/s0055.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0060.patch", "third_party/libwebrtc/moz-patch-stack/s0061.patch", "third_party/libwebrtc/moz-patch-stack/s0062.patch", "third_party/libwebrtc/moz-patch-stack/s0063.patch", "third_party/libwebrtc/moz-patch-stack/s0064.patch", "third_party/libwebrtc/moz-patch-stack/s0065.patch", "third_party/libwebrtc/moz-patch-stack/s0066.patch", "third_party/libwebrtc/moz-patch-stack/s0067.patch", "third_party/libwebrtc/moz-patch-stack/s0068.patch", "third_party/libwebrtc/moz-patch-stack/s0069.patch", "third_party/libwebrtc/moz-patch-stack/s0070.patch", "third_party/libwebrtc/moz-patch-stack/s0071.patch", "third_party/libwebrtc/moz-patch-stack/s0072.patch", "third_party/libwebrtc/moz-patch-stack/s0073.patch", "third_party/libwebrtc/moz-patch-stack/s0074.patch", "third_party/libwebrtc/moz-patch-stack/s0075.patch", "third_party/libwebrtc/moz-patch-stack/s0076.patch", "third_party/libwebrtc/moz-patch-stack/s0077.patch", "third_party/libwebrtc/moz-patch-stack/s0078.patch", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/moz-patch-stack/s0080.patch", "third_party/libwebrtc/moz-patch-stack/s0081.patch", "third_party/libwebrtc/moz-patch-stack/s0082.patch", "third_party/libwebrtc/moz-patch-stack/s0083.patch", "third_party/libwebrtc/moz-patch-stack/s0084.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0086.patch", "third_party/libwebrtc/moz-patch-stack/s0087.patch", "third_party/libwebrtc/moz-patch-stack/s0088.patch", "third_party/libwebrtc/moz-patch-stack/s0089.patch", "third_party/libwebrtc/moz-patch-stack/s0090.patch", "third_party/libwebrtc/moz-patch-stack/s0091.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0096.patch", "third_party/libwebrtc/moz-patch-stack/s0097.patch", "third_party/libwebrtc/moz-patch-stack/s0098.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/moz-patch-stack/s0100.patch", "third_party/libwebrtc/moz-patch-stack/s0101.patch", "third_party/libwebrtc/moz-patch-stack/s0102.patch", "third_party/libwebrtc/moz-patch-stack/s0103.patch", "third_party/libwebrtc/moz-patch-stack/s0104.patch", "third_party/libwebrtc/moz-patch-stack/s0105.patch", "third_party/libwebrtc/moz-patch-stack/s0106.patch", "third_party/libwebrtc/moz-patch-stack/s0107.patch", "third_party/libwebrtc/moz-patch-stack/s0108.patch", "third_party/libwebrtc/moz-patch-stack/s0109.patch", "third_party/libwebrtc/moz-patch-stack/s0110.patch", "third_party/libwebrtc/moz-patch-stack/s0111.patch", "third_party/libwebrtc/moz-patch-stack/s0112.patch", "third_party/libwebrtc/moz-patch-stack/s0113.patch", "third_party/libwebrtc/moz-patch-stack/s0114.patch", "third_party/libwebrtc/moz-patch-stack/s0115.patch", "third_party/libwebrtc/moz-patch-stack/s0116.patch", "third_party/libwebrtc/moz-patch-stack/s0117.patch", "third_party/libwebrtc/moz-patch-stack/s0118.patch", "third_party/libwebrtc/moz-patch-stack/s0119.patch", "third_party/libwebrtc/moz-patch-stack/s0120.patch", "third_party/libwebrtc/moz-patch-stack/s0121.patch", "third_party/libwebrtc/moz-patch-stack/s0122.patch", "third_party/libwebrtc/moz-patch-stack/s0123.patch", "third_party/libwebrtc/moz-patch-stack/s0124.patch", "third_party/libwebrtc/moz-patch-stack/s0125.patch", "third_party/libwebrtc/moz-patch-stack/s0126.patch", "third_party/libwebrtc/moz-patch-stack/s0127.patch", "third_party/libwebrtc/moz-patch-stack/s0128.patch", "third_party/libwebrtc/moz-patch-stack/s0129.patch", "third_party/libwebrtc/moz-patch-stack/s0130.patch", "third_party/libwebrtc/moz-patch-stack/s0131.patch", "third_party/libwebrtc/moz-patch-stack/s0132.patch", "third_party/libwebrtc/moz-patch-stack/s0133.patch", "third_party/libwebrtc/moz-patch-stack/s0134.patch", "third_party/libwebrtc/moz-patch-stack/s0135.patch", "third_party/libwebrtc/moz-patch-stack/s0136.patch", "third_party/libwebrtc/moz-patch-stack/s0137.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch", "third_party/libwebrtc/moz-patch-stack/s0139.patch", "third_party/libwebrtc/moz-patch-stack/s0140.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/moz-patch-stack/s0142.patch", "third_party/libwebrtc/moz-patch-stack/s0143.patch", "third_party/libwebrtc/moz-patch-stack/s0144.patch", "third_party/libwebrtc/moz-patch-stack/s0145.patch", "third_party/libwebrtc/moz-patch-stack/s0146.patch", "third_party/libwebrtc/moz-patch-stack/s0147.patch", "third_party/libwebrtc/moz-patch-stack/s0148.patch", "third_party/libwebrtc/moz-patch-stack/s0149.patch", "third_party/libwebrtc/moz-patch-stack/s0150.patch", "third_party/libwebrtc/pc/test/mock_voice_media_receive_channel_interface.h", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h"], "git_node": "f90b7c7fb3e4582980e91362f75a0605984af5ac", "git_parents": ["a44b73b9bd75ee1292cd0dea5133be174f564baf"], "node": "fa5a4f68bdeee915f66822b12607fa57f12247ae", "parents": ["230f0c7103d4abde6fc3475e265f5d8a4f45dbd5"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 (MOZ) - Track RTP sources locally in AudioConduit/VideoConduit after libwebrtc removed call-layer GetSources();r=webrtc-reviewers,pehrsons\n\nThe ff3bf0dc7b libwebrtc vendor bump deleted MediaReceiveStreamInterface::\nGetSources() from call/receive_stream.h and the SourceTracker members from\nAudioReceiveStreamImpl/VideoReceiveStream2. Upstream moved RTP source\ntracking into pc::RtpReceiver, which Mozilla does not build, breaking\nAudioConduit.cpp/VideoConduit.cpp's calls to mRecvStream-\u003eGetSources().\n\nGive WebrtcAudioConduit/WebrtcVideoConduit their own webrtc::SourceTracker,\nfed via the on_frame_delivered_callback hook already present on both\nreceive stream Configs, mirroring how pc/rtp_receiver.cc does it upstream.\n\nTwo things to be careful of, both learned by running\nRTCRtpReceiver-getSynchronizationSources.https.html against the change:\n- Config::Copy() drops move-only fields, so on_frame_delivered_callback\n  must be installed on the copy actually handed to CreateAudioReceiveStream/\n  CreateVideoReceiveStream inside CreateRecvStream(), not on\n  mRecvStreamConfig in the constructor.\n- The callback fires synchronously from whatever thread is pulling decoded\n  media (audio: MediaTrackGraph's GraphRunner; video: a decode thread), not\n  mCallThread, so it hops to mCallThread before touching mSourceTracker,\n  which is documented thread-unsafe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326817\n", "files": ["dom/media/webrtc/libwebrtcglue/AudioConduit.cpp", "dom/media/webrtc/libwebrtcglue/AudioConduit.h", "dom/media/webrtc/libwebrtcglue/VideoConduit.cpp", "dom/media/webrtc/libwebrtcglue/VideoConduit.h"], "git_node": "46654f4e465a174f193cdfa1d0a568f87fa8fbcb", "git_parents": ["f90b7c7fb3e4582980e91362f75a0605984af5ac"], "node": "26427ca6d0383dd5df320ffc5047581be6c20ec9", "parents": ["fa5a4f68bdeee915f66822b12607fa57f12247ae"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 (MOZ) - fix build bustage in MockCall.h after libwebrtc removed call-layer GetSources()\n", "files": ["media/webrtc/signaling/gtest/MockCall.h"], "git_node": "f90abc6fcb922480d02c0f09562072b26a6b8821", "git_parents": ["46654f4e465a174f193cdfa1d0a568f87fa8fbcb"], "node": "6fcac0907c21e1087d78b52180b4eb4e42ee7eb0", "parents": ["26427ca6d0383dd5df320ffc5047581be6c20ec9"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from d3feee9315\n\nUpstream commit: https://webrtc.googlesource.com/src/+/d3feee93158e5e8ad8358fbd8b10a103f0f53478\n    Fix android_sdk build-tools deps.\n\n    Trying to fix the deps autoroller.\n    https://ci.chromium.org/ui/p/webrtc/builders/cron/Auto-roll%20-%20WebRTC%20DEPS\n\n    Change-Id: I33bd527999919a63e6abc88f3256cd545d3f1c54\n    Bug: None\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498200\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Reviewed-by: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48461}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "6ad046357eb617550b192927ab536f275940b415", "git_parents": ["f90abc6fcb922480d02c0f09562072b26a6b8821"], "node": "0e8b0bafb4b955b4ab6e6cb8f82422d21030ee65", "parents": ["6fcac0907c21e1087d78b52180b4eb4e42ee7eb0"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 0296daf1ad\n\nUpstream commit: https://webrtc.googlesource.com/src/+/0296daf1ad8109764b31e0a3f54dd7a811848c66\n    In RtpDemuxer fail rather than DCHECK when criteria is invalid.\n\n    Condition for invalid criteria are non trivial. This patch collects\n    those conditions into single RtpDemuxerCriteria::IsValid() helper and\n    use it when caller attempts to register a sink. This way caller can\n    rely on RtpDemuxer to verify the criteria rather than duplicate such\n    logic.\n\n    While changing this class also migrate to some modern patterns:\n    - annotate 'sink' nullability\n    - cleanup operator==\n    - add AbslStringify for simpler logging.\n\n    Bug: b/550382551\n    Change-Id: Iaa218992d2786fcbd2d77f9ca2a46e5e43ac67b6\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498220\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48462}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_demuxer.cc", "third_party/libwebrtc/call/rtp_demuxer.h", "third_party/libwebrtc/call/rtp_demuxer_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0002.patch"], "git_node": "41bb465bec47c6cbb182420aced921482e51f3dc", "git_parents": ["6ad046357eb617550b192927ab536f275940b415"], "node": "84009e2617597b6c898ca814b0f650c00712fabc", "parents": ["0e8b0bafb4b955b4ab6e6cb8f82422d21030ee65"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 584eaf9236\n\nUpstream commit: https://webrtc.googlesource.com/src/+/584eaf9236b74b5b6409878772c8794550ffd05a\n    Remove UpdatePlayoutTimestamp from audio packet and RTCP ingress path\n\n    Removes UpdatePlayoutTimestamp calls from ChannelReceive::OnRtpPacket\n    and ChannelReceive::ReceivedRTCPPacket.\n\n    Instead of querying and caching the playout timestamp and ADM playout\n    delay on every incoming RTP and RTCP packet, compute the playout\n    timestamp and query the ADM playout delay on demand in\n    GetPlayoutRtpTimestamp, GetDelayEstimate, GetSyncInfo, and the periodic\n    histogram reporting task.\n\n    This eliminates redundant NetEq lock acquisitions and ADM queries on\n    every packet, and avoids cross-thread state for playout delay/timestamps\n    when packet handling moves to the network thread.\n\n    Bug: webrtc:11993\n    Change-Id: I4e8c8267a2904956af8a8112615f1555d375ab38\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/494980\n    Reviewed-by: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48463}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch"], "git_node": "cad5a429caec6f75fae3781e4ff0ee2b489343da", "git_parents": ["41bb465bec47c6cbb182420aced921482e51f3dc"], "node": "836df82f52c7d3470028de7d2118f64b497f9716", "parents": ["84009e2617597b6c898ca814b0f650c00712fabc"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 799e09ba01\n\nUpstream commit: https://webrtc.googlesource.com/src/+/799e09ba01c78d7e8b631528f106740c8d8d841f\n    Update WebRTC code version (2026-09-02T04:06:29).\n\n    Bug: None\n    Change-Id: Ie32b20d695df3d5b0942f20747f61c0e42b1b127\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498340\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48464}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "519edc2f4b982619691598b0bd31ccde86ffa35d", "git_parents": ["cad5a429caec6f75fae3781e4ff0ee2b489343da"], "node": "d8933ea23c3c6a0f5544a4ad6cd58a224aa079b6", "parents": ["836df82f52c7d3470028de7d2118f64b497f9716"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from c437def08e\n\nWe already cherry-picked this when we vendored a485f8930c.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/c437def08ebec37d0cf8502e2a30b5d6de3e3b0a\n    Revert \"Add generalized functional unit tests for VideoEncoderInterface.\"\n\n    This reverts commit a485f8930cb9829fcb98ee5d4155dfa96c0f6c8f.\n\n    Reason for revert: Breaks downstream\n\n    Original change's description:\n    \u003e Add generalized functional unit tests for VideoEncoderInterface.\n    \u003e\n    \u003e This CL adds unit tests for the \"v2\" video encoder API. The tests are\n    \u003e generalized and verifies that the capabilities reported by the encoder\n    \u003e factory match what the encoder can do. These supercede the existing\n    \u003e implementation-specific tests.\n    \u003e\n    \u003e Note that rate control, spatial quality and performance are not part of\n    \u003e this test. Those will come in follow-up CLs.\n    \u003e\n    \u003e Bug: webrtc:496266459\n    \u003e Change-Id: Iebcee8ce04135006a31013ff8bae6e648117f4d6\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498080\n    \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48459}\n\n    Bug: webrtc:496266459\n    No-Presubmit: true\n    No-Tree-Checks: true\n    No-Try: true\n    Change-Id: I514750ef0275d38d0f53f55b2b7341b4a6905de1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498420\n    Auto-Submit: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Bot-Commit: rubber-stamper@appspot.gserviceaccount.com \u003crubber-stamper@appspot.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48465}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/c437def08e.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch", "third_party/libwebrtc/moz-patch-stack/p0002.patch"], "git_node": "142e993daaad216a00086ef75564cbdaf532d292", "git_parents": ["519edc2f4b982619691598b0bd31ccde86ffa35d"], "node": "5f9e5e3f0eee2fc03d3a244597941078ac300fd2", "parents": ["d8933ea23c3c6a0f5544a4ad6cd58a224aa079b6"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 7d21c75f8a\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7d21c75f8a1bc9f60544615df9da791df94b141c\n    pc: disallow changes to always_negotiate_datachannels\n\n    spec change:\n      https://github.com/w3c/webrtc-extensions/pull/254\n\n    Bug: webrtc:433898678\n    Change-Id: I9b80e5bf31716f27614778021a5de0199cfeb6c7\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498240\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48466}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/sdp_offer_answer_unittest.cc"], "git_node": "587f386dcd6cc73146ea289f236c6ff44084f5c1", "git_parents": ["142e993daaad216a00086ef75564cbdaf532d292"], "node": "3cb8385eb7301679cd6066af30faeadd4a020ddb", "parents": ["5f9e5e3f0eee2fc03d3a244597941078ac300fd2"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 18827afc09\n\nUpstream commit: https://webrtc.googlesource.com/src/+/18827afc097cd1d8d63f37564a43887891482923\n    Add retry mechanism to the url ReadUrlContent\n\n    Sometimes Chromium commits are too recent, Gitiles read replicas/caches are not yet propagated and the url  returns HTTP 404: Not Found.\n\n    https://ci.chromium.org/ui/p/webrtc/builders/cron/Auto-roll%20-%20WebRTC%20DEPS/37972/overview\n\n    Change-Id: Ib8c00f6dfb54fbd5cfaf5eec2bdffe2c738afebe\n    Bug: None\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498480\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48467}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/autoroller/roll_deps.py", "third_party/libwebrtc/tools_webrtc/autoroller/unittests/roll_deps_test.py"], "git_node": "449c2dc0f4948b4e3b1499915b1126455e45135d", "git_parents": ["587f386dcd6cc73146ea289f236c6ff44084f5c1"], "node": "6cdd50a9471e192f0435166647bbe2e96a03d26f", "parents": ["3cb8385eb7301679cd6066af30faeadd4a020ddb"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from f1fefdd0e5\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f1fefdd0e5bffc7398d00de7cd953587a1a0830e\n    Reaplce CaseInsensitiveFind helper with absl::StrContainsIgnoreCase\n\n    Bug: webrtc:374845009\n    Change-Id: I777bca7209dbd121219ce4a3fd6046cc53be99af\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498201\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Auto-Submit: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48468}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/webrtc_sdp.cc"], "git_node": "b43b283a562822598403e0219cbb141b0f84ef7b", "git_parents": ["449c2dc0f4948b4e3b1499915b1126455e45135d"], "node": "7528182b185e8dad3fd9925e3724597dd0f57204", "parents": ["6cdd50a9471e192f0435166647bbe2e96a03d26f"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 5c93d6400e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/5c93d6400e2c156b45712be5195621081385cc9d\n    pc: pass the data channel id to the tracer callbacks\n\n    PeerConnectionTracerInterface::OnCreateDataChannel() and OnDataChannel()\n    handed out only the channel, so an implementation that wants to log the\n    SCTP stream id - as chrome://webrtc-internals does for negotiated\n    channels - has to call DataChannelInterface::id(). That accessor is\n    PROXY_SECONDARY and reads id_n_, which is guarded by the network thread,\n    so it blocks whichever thread asks; the interface documentation tells\n    tracers not to block. Deferring the read to another thread is no better:\n    it forces the tracer to keep the channel alive past the call, which the\n    same documentation rules out.\n\n    Both call sites already have the id at hand - CreateDataChannelOrError()\n    from the InternalDataChannelInit it just applied, HandleOpenMessage_n()\n    from the sid the OPEN message arrived on - so pass it along and let\n    tracers serialize everything they need without touching the channel\n    again. It is std::nullopt for a locally created channel whose id has not\n    been assigned yet.\n\n    Bug: webrtc:532923549\n    Change-Id: I9b90eed0c782c3975719b7a1a4351f0b3aa3512e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498100\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48469}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/peer_connection_tracer_interface.h", "third_party/libwebrtc/pc/data_channel_controller.cc", "third_party/libwebrtc/pc/data_channel_controller.h", "third_party/libwebrtc/pc/peer_connection.cc", "third_party/libwebrtc/pc/peer_connection_tracer_unittest.cc"], "git_node": "86a6c55245318def12768305b5cef2c43ec0726a", "git_parents": ["b43b283a562822598403e0219cbb141b0f84ef7b"], "node": "b3509423d32347ad29370487cf92d294765b62f6", "parents": ["7528182b185e8dad3fd9925e3724597dd0f57204"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 1e2e26f717\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1e2e26f7178d32de9ba1c286e756e9f7c7b3b2d5\n    Avoid value copies in range-based for loops\n\n    Use const references in range-based for loops across audio, p2p, and pc\n    to avoid unnecessary copies.\n\n    Bug: webrtc:374845009\n    Change-Id: If9911b40ec149bddbc4ea60475b886357e74224d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498280\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48470}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/voip/voip_core.cc", "third_party/libwebrtc/p2p/base/basic_ice_controller.cc", "third_party/libwebrtc/pc/media_session.cc", "third_party/libwebrtc/pc/rtp_transmission_manager.cc", "third_party/libwebrtc/pc/sdp_offer_answer.cc", "third_party/libwebrtc/pc/transceiver_list.cc"], "git_node": "bc999fb86ef8931a6dbc62f53fef7b1dccdd92aa", "git_parents": ["86a6c55245318def12768305b5cef2c43ec0726a"], "node": "62605aa53a1187af1799cb8352e30b41969a2330", "parents": ["b3509423d32347ad29370487cf92d294765b62f6"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from b300c91481\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b300c91481baf5a15a0cc7aa6807ee67d3a97b45\n    Recover after large RTP sequence number discontinuity\n\n    After a gap larger than half the 16-bit sequence number range,\n    SeqNumUnwrapper can interpret resumed media as reordered packets.\n    If FrameDecoded has advanced PacketBuffer's clear boundary, the\n    recovery keyframe is then discarded as already cleared.\n\n    Detect an apparent large backward jump with a newer RTP timestamp\n    before committing the unwrapper state. Enter keyframe recovery,\n    request a keyframe when needed, and re-anchor at the first packet of\n    a new keyframe. Do not let padding or FEC commit an ambiguous unwrap.\n\n    H.264 and H.265 are excluded. H26xPacketBuffer has no reset API, and\n    H.264 keyframe classification can change in H264SpsPpsTracker.\n\n    Bug: webrtc:551306026\n    Change-Id: I56f44d45bd35340405dee9d7b6debcb47f57ba1b\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497280\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48471}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/s0030.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0037.patch", "third_party/libwebrtc/moz-patch-stack/s0041.patch", "third_party/libwebrtc/moz-patch-stack/s0056.patch", "third_party/libwebrtc/moz-patch-stack/s0057.patch", "third_party/libwebrtc/moz-patch-stack/s0058.patch", "third_party/libwebrtc/moz-patch-stack/s0059.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch", "third_party/libwebrtc/video/rtp_video_stream_receiver2.cc", "third_party/libwebrtc/video/rtp_video_stream_receiver2.h", "third_party/libwebrtc/video/rtp_video_stream_receiver2_unittest.cc", "third_party/libwebrtc/video/timing/simulator/assembler.cc", "third_party/libwebrtc/video/video_receive_stream2.cc", "third_party/libwebrtc/video/video_receive_stream2.h"], "git_node": "253f9aff8893136f6fb18254cfbdba4137f21f2c", "git_parents": ["bc999fb86ef8931a6dbc62f53fef7b1dccdd92aa"], "node": "46ba895c6269856e9cf109a90151cd9b0362c918", "parents": ["62605aa53a1187af1799cb8352e30b41969a2330"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from b6c9f4c95c\n\nUpstream commit: https://webrtc.googlesource.com/src/+/b6c9f4c95c4d5365ef80f3c79c6d4e624cf63032\n    Reland \"Add generalized functional unit tests for VideoEncoderInterface.\"\n\n    This is a reland of commit a485f8930cb9829fcb98ee5d4155dfa96c0f6c8f\n\n    Patchset 2 contains a fix switching from\n    `CreateBuiltinVideoDecoderFactory()` to using\n    `VideoDecoderFactoryTemplate`s, as well as skipping tests instead of\n    failing if no decoder is found.\n\n    Original change's description:\n    \u003e Add generalized functional unit tests for VideoEncoderInterface.\n    \u003e\n    \u003e This CL adds unit tests for the \"v2\" video encoder API. The tests are\n    \u003e generalized and verifies that the capabilities reported by the encoder\n    \u003e factory match what the encoder can do. These supercede the existing\n    \u003e implementation-specific tests.\n    \u003e\n    \u003e Note that rate control, spatial quality and performance are not part of\n    \u003e this test. Those will come in follow-up CLs.\n    \u003e\n    \u003e Bug: webrtc:496266459\n    \u003e Change-Id: Iebcee8ce04135006a31013ff8bae6e648117f4d6\n    \u003e Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498080\n    \u003e Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    \u003e Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    \u003e Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    \u003e Cr-Commit-Position: refs/heads/main@{#48459}\n\n    Bug: webrtc:496266459\n    Change-Id: I03b500d68e56fc7912ea5fa4039a9528620bfb70\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498460\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48472}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/BUILD.gn", "third_party/libwebrtc/api/video_codecs/libaom_av1_encoder_factory.cc", "third_party/libwebrtc/api/video_codecs/libaom_av1_encoder_factory.h", "third_party/libwebrtc/api/video_codecs/libaom_av1_encoder_factory_test.cc", "third_party/libwebrtc/api/video_codecs/test/BUILD.gn", "third_party/libwebrtc/api/video_codecs/test/DEPS", "third_party/libwebrtc/api/video_codecs/test/video_codec_test_utils.h", "third_party/libwebrtc/api/video_codecs/test/video_encoder_functional_unittest.cc", "third_party/libwebrtc/api/video_codecs/video_encoder_builders_for_test.cc", "third_party/libwebrtc/api/video_codecs/video_encoder_builders_for_test.h", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/moz-patch-stack/s0094.patch"], "git_node": "64ac7d11606d2f151e136b805a8c239a8bbf91a3", "git_parents": ["253f9aff8893136f6fb18254cfbdba4137f21f2c"], "node": "54f4fabe6a8fc21d4d5c272adfa5b62a92914654", "parents": ["46ba895c6269856e9cf109a90151cd9b0362c918"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from f421cf0271\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f421cf02718a7f2f3540b80110c2e73f74cbc3f1\n    \u0455nap: add unit test for parsing a token with padding\n\n    Bug: webrtc:426480601\n    Change-Id: Ib9cad26d7fb36513b4d8a9a128697e25e6ba6111\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/486680\n    Reviewed-by: Victor Boivie \u003cboivie@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48473}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/net/dcsctp/socket/dcsctp_socket_test.cc"], "git_node": "10df5ef7808c44592155d6ec88f4d1525c305609", "git_parents": ["64ac7d11606d2f151e136b805a8c239a8bbf91a3"], "node": "2ff2acff6ca04a19c0bf91679b51070b5706e229", "parents": ["54f4fabe6a8fc21d4d5c272adfa5b62a92914654"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from f83bd3f817\n\nUpstream commit: https://webrtc.googlesource.com/src/+/f83bd3f817255a69d5b4309ddb09e4139475734a\n    Support synchronous SDP state validation\n\n    Validate answer signaling states when their operations-chain entries\n    begin. Allow browser callers to opt into WebRTC-PC's createOffer state\n    restriction while native JSEP callers can generate offers in every\n    non-closed state.\n\n    Report failures directly through the observer so an immediately run\n    operation can reach Blink synchronously without changing the ordering of\n    queued operations. Handle closed peer connections consistently for both\n    operations.\n\n    Bug: chromium:488071544\n    Change-Id: I63ae8c9b3548207222e3bbf1adc0638b34d307e1\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497720\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Commit-Queue: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48474}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/peer_connection_interface.h", "third_party/libwebrtc/pc/peer_connection_signaling_unittest.cc", "third_party/libwebrtc/pc/sdp_offer_answer.cc"], "git_node": "58ce4ebd29540869240b6dbf29b5eb9c77711d93", "git_parents": ["10df5ef7808c44592155d6ec88f4d1525c305609"], "node": "e5850285fe6a0366a709acf27bd632933194ae5e", "parents": ["2ff2acff6ca04a19c0bf91679b51070b5706e229"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 1dcc94223f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1dcc94223f34c5ec7f6522ba8612bb9198f1b1a7\n    VideoEncoderInterface v2: Replace VideoContentType with ContentHint.\n\n    Bug: webrtc:496266459\n    Change-Id: I74e282cbc21bfd462021b353b317d6018b81eb84\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498602\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48475}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/BUILD.gn", "third_party/libwebrtc/api/video_codecs/g3doc/video_encoder_api_v2.md", "third_party/libwebrtc/api/video_codecs/test/BUILD.gn", "third_party/libwebrtc/api/video_codecs/test/video_encoder_functional_unittest.cc", "third_party/libwebrtc/api/video_codecs/video_encoder_interface.h", "third_party/libwebrtc/modules/video_coding/codecs/av1/BUILD.gn", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.h", "third_party/libwebrtc/moz-patch-stack/s0094.patch"], "git_node": "76d33e16c201db47fc377a9aea913a1e01c3b9c7", "git_parents": ["58ce4ebd29540869240b6dbf29b5eb9c77711d93"], "node": "e999f37af9fbfa6e1945c618ebb6df9844451a87", "parents": ["e5850285fe6a0366a709acf27bd632933194ae5e"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 4046761010\n\nUpstream commit: https://webrtc.googlesource.com/src/+/404676101034905b771d9cec040976199629289a\n    Fix RTCConfiguration equality for SCTP SNAP\n\n    Equality comparison for this member was missing, fix it here.\n\n    Now SetConfiguration will reject changes to enable_sctp_snap instead of\n    silently ignoring them. This is aligned with the original author's\n    intent of not wanting this parameter to be mutable.\n\n    Bug: webrtc:426480601\n    Change-Id: I14e6d39c317e17e99f9ce8deaec9e56755ba5f93\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498380\n    Reviewed-by: Philipp Hancke \u003cphilipp.hancke@googlemail.com\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Commit-Queue: Joachim Reiersen \u003cjoachimr@meta.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48476}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/peer_connection_interface.cc"], "git_node": "87ca0b30d4064019b3b497af3a71d3ad0673b421", "git_parents": ["76d33e16c201db47fc377a9aea913a1e01c3b9c7"], "node": "d571a76b8f66a09b6ee755f9bd08b656b58766bd", "parents": ["e999f37af9fbfa6e1945c618ebb6df9844451a87"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 573c5c6224\n\nWe already cherry-picked this when we vendored c2b761bb73.\n\nUpstream commit: https://webrtc.googlesource.com/src/+/573c5c6224a4299603d510c0dd8e572cf0a635aa\n    Fix issue where codec fallback skips first codec in list.\n\n    Before this CL, `ApplyEncoderSwitch` implicitly assumed that\n    `send_codec()` is the first codec in `negotiated_codecs_`, but this is a\n    very outdated assumption that assumes that the only way to pick a codec\n    is with the SDP preference order (e.g. `SetCodecPreferences()` or SDP\n    munging).\n\n    But it has long been the case that `SetParameters()` can pick another\n    codec. This CL updates the logic to remove the `send_codec()` where\n    ever it is located, resulting in the next codec to test being the first\n    one in the list should the current one not be the first one already.\n\n    Bug: chromium:556170878\n    Change-Id: I7c8f50537ef52cae3af2c0d460096a4b97045703\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498561\n    Reviewed-by: Ilya Nikolaevskiy \u003cilnik@webrtc.org\u003e\n    Commit-Queue: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48477}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/moz-patch-stack/573c5c6224.no-op-cherry-pick-msg", "third_party/libwebrtc/moz-patch-stack/p0001.patch"], "git_node": "99da19cae6d56c753409cecc348ba1e2b462ae40", "git_parents": ["87ca0b30d4064019b3b497af3a71d3ad0673b421"], "node": "2dbc7840e21603a46b936fd683003ec3e31a8c5c", "parents": ["d571a76b8f66a09b6ee755f9bd08b656b58766bd"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 4e2f2ca44f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4e2f2ca44f00822a35ad62aafb78d564bb171dc4\n    Update WebRTC code version (2026-09-03T04:09:34).\n\n    Bug: None\n    Change-Id: I7b8a85d80c7e7d820a065f685689c3f9eb88ed5f\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498881\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48478}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "1ecea71213f5de72315c738c7f68a2df33ba6465", "git_parents": ["99da19cae6d56c753409cecc348ba1e2b462ae40"], "node": "675a491d271c7486cb7910fac12ff4b5d58c7c6d", "parents": ["2dbc7840e21603a46b936fd683003ec3e31a8c5c"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 2499eefe89\n\nUpstream commit: https://webrtc.googlesource.com/src/+/2499eefe893cf41e3c51f160017c74b8b3dec5df\n    Prefer std::make_tuple over testing::make_tuple\n\n    since the latter is a legacy alias\n\n    Bug: None\n    Change-Id: I0f75ae8636f13307edeb53233721762e2cfe1809\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498540\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48479}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/common_audio/resampler/push_sinc_resampler_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/flexfec_03_header_reader_writer_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/app_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/extended_reports_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/fir_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/loss_notification_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/nack_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/pli_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/rapid_resync_request_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/receiver_report_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/remb_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/sender_report_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/tmmbn_unittest.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtcp_packet/tmmbr_unittest.cc", "third_party/libwebrtc/video/video_send_stream_tests.cc"], "git_node": "7324086cae39b8c95c085ea5bd8e3aeb83c45dda", "git_parents": ["1ecea71213f5de72315c738c7f68a2df33ba6465"], "node": "ee8deefb639990f714157d2a7c8243e9d26a0966", "parents": ["675a491d271c7486cb7910fac12ff4b5d58c7c6d"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 4287e09212\n\nUpstream commit: https://webrtc.googlesource.com/src/+/4287e09212ee4e548608033c11a38f27c0660302\n    Clamp arrival_time_offset in TransportFeedbackAdapter\n\n    In RFC 8888, report blocks cover a contiguous sequence number range and\n    all received packets must be reported. Since the sender erases packets\n    from history once acknowledged as received, any packet newly acknowledged\n    in a report must have arrived after the previous received report was\n    generated.\n\n    Therefore, the arrival time offset (ATO) is expected to be bounded by:\n    1. The interval between this feedback and the last received feedback\n       (time_between_two_last_feedback), based on the receiver's NTP report\n       timestamps, since the packet arrived after the previous received report.\n    2. The round-trip elapsed time between packet send and feedback receive\n       (feedback_send_time_delta), since a packet cannot arrive before it was\n       sent, nor can feedback be received before it was sent.\n\n    If a receiver reports an invalid or inflated ATO (e.g. due to clock drift\n    or packet arrival time latching in the past), ATO could exceed these bounds\n    and cause RTT calculations to collapse to 0 ms.\n\n    This change clamps ATO to min(time_between_two_last_feedback,\n    feedback_send_time_delta) and logs a warning when clamping occurs.\n\n    Bug: webrtc:555794212\n    Change-Id: I7de3925e55f9483dd7ed0458528cce713bb1f6aa\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498560\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48480}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/congestion_controller/rtp/transport_feedback_adapter.cc", "third_party/libwebrtc/modules/congestion_controller/rtp/transport_feedback_adapter_unittest.cc"], "git_node": "ff938a80dc23e8db9f6230c0f27df035a7ee5802", "git_parents": ["7324086cae39b8c95c085ea5bd8e3aeb83c45dda"], "node": "9deb3e65bbacd25c8b7c5b715ef80269ae3393a4", "parents": ["ee8deefb639990f714157d2a7c8243e9d26a0966"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 95773cc3c8\n\nUpstream commit: https://webrtc.googlesource.com/src/+/95773cc3c8f1768200bf48ee08f00331664fb576\n    Migrate audio_processing_unittests to be a rtc_test_suite\n\n    Change-Id: I85282de9691325fc99d7d927afce2cd9c8a95e36\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/497562\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48481}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/infra/specs/client.webrtc.json", "third_party/libwebrtc/infra/specs/gn_isolate_map.pyl", "third_party/libwebrtc/infra/specs/test_suites.pyl", "third_party/libwebrtc/infra/specs/tryserver.webrtc.json", "third_party/libwebrtc/modules/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/aec3/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/aec3/neural_residual_echo_estimator/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/aec_dump/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/agc/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/agc2/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/agc2/rnn_vad/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/capture_levels_adjuster/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/capture_mixer/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/ns/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/test/conversational_speech/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/utility/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/vad/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0054.patch", "third_party/libwebrtc/moz-patch-stack/s0068.patch", "third_party/libwebrtc/moz-patch-stack/s0081.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0093.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0095.patch", "third_party/libwebrtc/moz-patch-stack/s0097.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/moz-patch-stack/s0105.patch", "third_party/libwebrtc/moz-patch-stack/s0141.patch", "third_party/libwebrtc/resources/BUILD.gn", "third_party/libwebrtc/tools_webrtc/get_landmines.py", "third_party/libwebrtc/webrtc.gni"], "git_node": "e386d2194b22d8f4024283ee1c35eaa8f98918e0", "git_parents": ["ff938a80dc23e8db9f6230c0f27df035a7ee5802"], "node": "58ea2e63cb8a7b15cd85700e44a1d0230a1cb4dc", "parents": ["9deb3e65bbacd25c8b7c5b715ef80269ae3393a4"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 1f2dc301fd\n\nUpstream commit: https://webrtc.googlesource.com/src/+/1f2dc301fd1e8d72a1a71f6d7b49cfc354c1ca6b\n    Avoid some unnecessary copying in video and frame pipeline\n\n    Bug: webrtc:374845009\n    Change-Id: I2d057a947766bb9e8bda1c06f45b820432045668\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498620\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48482}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/rtp_video_sender.cc", "third_party/libwebrtc/modules/desktop_capture/shared_desktop_frame.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/frame_object.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/rtp_sender_video.cc", "third_party/libwebrtc/moz-patch-stack/s0079.patch", "third_party/libwebrtc/video/corruption_detection/video_frame_sampler.cc", "third_party/libwebrtc/video/frame_cadence_adapter.cc"], "git_node": "13907a9d6a235cb7485cab3c1b47516128586c18", "git_parents": ["e386d2194b22d8f4024283ee1c35eaa8f98918e0"], "node": "52bb0b7d9fc7a25a32974e9b8d6f335113998364", "parents": ["58ea2e63cb8a7b15cd85700e44a1d0230a1cb4dc"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 42cb1d23ef\n\nUpstream commit: https://webrtc.googlesource.com/src/+/42cb1d23ef56e3cb7a63713a6bd15536b389bb28\n    Track audio playout time in ChannelReceive\n\n    Record the system time when an audio frame is pulled from NetEq in\n    ChannelReceive::GetAudioFrameWithInfo under neteq_mutex_.\n\n    In ChannelReceive::GetPlayoutRtpTimestamp, use the recorded playout\n    time in PlayoutInfo and return std::nullopt if playout is not active.\n\n    Bug: webrtc:11993\n    Change-Id: I5fbe7e917c603edde3b852810edfade53cd0a7ae\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498300\n    Reviewed-by: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48483}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/audio/BUILD.gn", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch"], "git_node": "e6935af7a9bd74612015167c6a212ea529d65e64", "git_parents": ["13907a9d6a235cb7485cab3c1b47516128586c18"], "node": "defc54c2bf9aeda8c2b79a14a0ef1790c365bf7d", "parents": ["52bb0b7d9fc7a25a32974e9b8d6f335113998364"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 8668c117ee\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8668c117ee7eeca4200ac8773c05e71948940dde\n    Add width and height to CreateOutgoingVideoFrame.\n    Default values will be removed once the callsite in chromium adapts.\n\n    Bug: chromium:524901718\n    Change-Id: Ib66dc9c8a4a0f0e472ee25bc668fd6a3c8affd5a\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498600\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Commit-Queue: Leonardo Evi \u003cevil@chromium.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48484}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/frame_transformer_factory.cc", "third_party/libwebrtc/api/frame_transformer_factory.h", "third_party/libwebrtc/api/test/frame_transformer_factory_unittest.cc"], "git_node": "44ea469245c701a06ed2c93c5d021a13a9fec857", "git_parents": ["e6935af7a9bd74612015167c6a212ea529d65e64"], "node": "c9ebbbbd5acea622daf84f2d902bb1fb41e6d098", "parents": ["defc54c2bf9aeda8c2b79a14a0ef1790c365bf7d"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from e0b365878f\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e0b365878f0ceb19dab50f412a3a6e50f5a598f4\n    Cleanup field trial WebRTC-Bwe-ReceiveTimeFix\n\n    Delete the field trial WebRTC-Bwe-ReceiveTimeFix and the code it enables\n    (ReceiveTimeCalculator). The field trial is default false.\n\n    Bug: webrtc:42234228\n    Bug: webrtc:555794212\n    Change-Id: I64c71a499412a0e8ad94a44ac4c12bdd264c0eaa\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498603\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48485}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/BUILD.gn", "third_party/libwebrtc/call/call.cc", "third_party/libwebrtc/call/receive_time_calculator.cc", "third_party/libwebrtc/call/receive_time_calculator.h", "third_party/libwebrtc/call/receive_time_calculator_unittest.cc", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/g3doc/rtp_receive_flow.md", "third_party/libwebrtc/moz-patch-stack/s0001.patch", "third_party/libwebrtc/moz-patch-stack/s0027.patch"], "git_node": "5992a274ad2f95d13e73978438410eae77c9a5ef", "git_parents": ["44ea469245c701a06ed2c93c5d021a13a9fec857"], "node": "9c720ed3b544d4e9f6bd9a2fdfec8e6e6aae860d", "parents": ["c9ebbbbd5acea622daf84f2d902bb1fb41e6d098"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from e0b365878f - moz.build file updates\n", "files": ["CLOBBER", "third_party/libwebrtc/call/call_gn/moz.build"], "git_node": "9fdc00f0cb2495915b25876963c4ced1527633e9", "git_parents": ["5992a274ad2f95d13e73978438410eae77c9a5ef"], "node": "8263b72c7556856f0ba813ac14f45745efe9cb8b", "parents": ["9c720ed3b544d4e9f6bd9a2fdfec8e6e6aae860d"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 90e0687fd0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/90e0687fd072c497d2fa77f7fd86fe560aecf96c\n    Register sframe license file\n\n    Bug: None\n    Change-Id: I8fbe61aff000546f22ca86c4c084469d21eb69cf\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/499140\n    Commit-Queue: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Auto-Submit: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48486}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/tools_webrtc/libs/generate_licenses.py"], "git_node": "a053d1488c97f26cc5febea8a18a96ad169f8ae7", "git_parents": ["9fdc00f0cb2495915b25876963c4ced1527633e9"], "node": "af0bb16f4247681d1581615852502a778d08a01d", "parents": ["8263b72c7556856f0ba813ac14f45745efe9cb8b"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 79edcdcb2a\n\nUpstream commit: https://webrtc.googlesource.com/src/+/79edcdcb2a6d760486584c569603ff2c2039e6a6\n    Fix some audio_processing dependencies\n\n    Change-Id: I904dbca87821f3727395eaefaaada9d4b3b8b427\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/499160\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48487}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/audio_processing/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/aec3/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/aec_dump/BUILD.gn", "third_party/libwebrtc/modules/audio_processing/agc2/rnn_vad/BUILD.gn", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch"], "git_node": "dabe273b0930bce2538eeaefd10fd12ff7aef39d", "git_parents": ["a053d1488c97f26cc5febea8a18a96ad169f8ae7"], "node": "241ae7219de4750df0ac9e40d174326447891042", "parents": ["af0bb16f4247681d1581615852502a778d08a01d"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 9ab2b29b07\n\nUpstream commit: https://webrtc.googlesource.com/src/+/9ab2b29b070fa749b74ac90225869de7ec24cb1e\n    Add DTLS wire format framing stub to RtcTransport\n\n    Introduce PacketProcessor, a protocol-agnostic hook that a\n    DatagramConnection calls on every outgoing and incoming packet, and\n    DtlsPacketProcessor, its DTLS-only implementation for the new\n    WireProtocol::kDtlsWithFeedback mode.\n\n    DtlsPacketProcessor frames app payloads with a 1-byte type header and a\n    16-bit transport sequence number, supporting the three wire formats:\n    data (0x01), reserved values (0x00, 0x02-0xFF) are dropped with a warning; 0x02 and 0x03 are set aside for the congestion-control feedback wire format, which is not yet defined (its format is still under discussion) and will be added in a follow-up along with the congestion controller hookup.\n\n    The connection stays protocol-agnostic: it frames via\n    ProcessOutgoingPacket() and de-frames via ProcessIncomingPacket(),\n    delivering the stripped payload through the common receive path.\n\n    Bug: chromium:443019066\n    Change-Id: Icc0f74e5bb31ef1fac1419ec2859e3c26af06555\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/489220\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48488}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/datagram_connection.h", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/datagram_connection_internal.cc", "third_party/libwebrtc/pc/datagram_connection_internal.h", "third_party/libwebrtc/pc/datagram_connection_unittest.cc", "third_party/libwebrtc/pc/dtls_packet_processor.cc", "third_party/libwebrtc/pc/dtls_packet_processor.h", "third_party/libwebrtc/pc/dtls_packet_processor_unittest.cc", "third_party/libwebrtc/pc/packet_processor.h"], "git_node": "f8742812455adfd037ed221972125da2cfef50cc", "git_parents": ["dabe273b0930bce2538eeaefd10fd12ff7aef39d"], "node": "ef9bbef0f39b633f76c15bac9426f09203235479", "parents": ["241ae7219de4750df0ac9e40d174326447891042"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from a192095ae4\n\nUpstream commit: https://webrtc.googlesource.com/src/+/a192095ae4050fe5d4c67fe7d81599f7ecc80b23\n    Clean up LibaomAv1EncoderV2 implementation.\n\n    This CL has no functional change, it just cleans up LibaomAv1EncoderV2\n    and the corresponding factory class:\n\n    * Improve comments\n    * Fix typos\n    * Have a single source of truth for the capabilities\n    * Improved unit test coverage\n    * Reduce log spam\n    * General best practices\n\n    Bug: webrtc:496266459\n    Change-Id: Ibac1af20f07195cae16e2edc76d1a78a485f51fe\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498680\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48489}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/BUILD.gn", "third_party/libwebrtc/api/video_codecs/libaom_av1_encoder_factory.cc", "third_party/libwebrtc/api/video_codecs/libaom_av1_encoder_factory_test.cc", "third_party/libwebrtc/api/video_codecs/test/video_encoder_functional_unittest.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.cc", "third_party/libwebrtc/modules/video_coding/codecs/av1/libaom_av1_encoder_v2.h", "third_party/libwebrtc/moz-patch-stack/s0094.patch"], "git_node": "67a9a9996fa364fc075c6bb50d0cf4976ccf20a2", "git_parents": ["f8742812455adfd037ed221972125da2cfef50cc"], "node": "9afb05af749cff5a77805cb2f91cf4fc7e8a0371", "parents": ["ef9bbef0f39b633f76c15bac9426f09203235479"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 8a63c9ad74\n\nUpstream commit: https://webrtc.googlesource.com/src/+/8a63c9ad746b0f747bae66b9440bf04a612f444c\n    Update WebRTC code version (2026-09-04T04:09:59).\n\n    Bug: None\n    Change-Id: I20e81dd0a5cce29d74a32dc3f1e585cbfd0c7581\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/499440\n    Bot-Commit: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: webrtc-version-updater@webrtc-ci.iam.gserviceaccount.com \u003cwebrtc-version-updater@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48490}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/call/version.cc"], "git_node": "15c370317ec458857a855e3c1801cf236b2fd6c0", "git_parents": ["67a9a9996fa364fc075c6bb50d0cf4976ccf20a2"], "node": "fd09c2b5a6410bcab0eb98774aa209fd19745009", "parents": ["9afb05af749cff5a77805cb2f91cf4fc7e8a0371"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 6ba4f10981\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6ba4f10981065043d8af027e6a9a5ae3363acda5\n    Introduce EncodedVideoFrameInjectorInterface.\n\n    Intended to support a new Web API to inject encoded media in a\n    peerconnection. It uses a placeholder VideoEncoder and VideoTrack to\n    simulate normal video processing.\n\n    Bug: chromium:532190488\n    Change-Id: I0b1f539727eacefaac26d5e4275cf79b1d3331dd\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/489340\n    Reviewed-by: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Commit-Queue: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48491}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/BUILD.gn", "third_party/libwebrtc/api/encoded_video_frame_injector_interface.h", "third_party/libwebrtc/api/rtp_sender_interface.h", "third_party/libwebrtc/media/BUILD.gn", "third_party/libwebrtc/media/base/media_channel.h", "third_party/libwebrtc/media/engine/webrtc_video_engine.cc", "third_party/libwebrtc/media/engine/webrtc_video_engine.h", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0092.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/encoded_video_frame_injector.cc", "third_party/libwebrtc/pc/encoded_video_frame_injector.h", "third_party/libwebrtc/pc/rtp_sender.cc", "third_party/libwebrtc/pc/rtp_sender.h", "third_party/libwebrtc/pc/rtp_sender_proxy.h", "third_party/libwebrtc/pc/rtp_sender_receiver_unittest.cc"], "git_node": "ed3e7ade19e328c5512c9b4b43b274134355a9fa", "git_parents": ["15c370317ec458857a855e3c1801cf236b2fd6c0"], "node": "57b30ae2cef6dc46a61023a2c4c501b9eae65476", "parents": ["fd09c2b5a6410bcab0eb98774aa209fd19745009"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 42c9bcacd2\n\nUpstream commit: https://webrtc.googlesource.com/src/+/42c9bcacd275fae1235663b19adf18b9f146123a\n    Avoid some unnecessary copying in video_frame_buffer\n\n    The no_longer_used callback in many cases captures scoped_refptr. Moving\n    them avoids atomic operations.\n\n    Bug: webrtc:374845009\n    Change-Id: Iffd6ec510e74983a3843e4fda19d13a0f97f666d\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/499020\n    Reviewed-by: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Commit-Queue: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48492}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/common_video/video_frame_buffer.cc"], "git_node": "8bebf5a8a4c6545befe872bc97c12cd6806dcacc", "git_parents": ["ed3e7ade19e328c5512c9b4b43b274134355a9fa"], "node": "3cbe7c502dba3e60cf7583008f0ff722a013b7b0", "parents": ["57b30ae2cef6dc46a61023a2c4c501b9eae65476"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 6bc6a2f437\n\nUpstream commit: https://webrtc.googlesource.com/src/+/6bc6a2f437ef5922bb2831341084995703fc9de9\n    Remove data_deps from audioproc_test_utils.\n\n    This is breaking WebRTC roll in Chromium.\n\n    Change-Id: Ibd91ab5da20707c2f225d46d0a5a778f7ccd1101\n    Bug: webrtc:498394143\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/499600\n    Reviewed-by: Guido Urdaneta \u003cguidou@webrtc.org\u003e\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48493}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/modules/audio_processing/BUILD.gn"], "git_node": "d1642e6e38cb617d6eb0b2babf3e9554c8dade6d", "git_parents": ["8bebf5a8a4c6545befe872bc97c12cd6806dcacc"], "node": "e6eca40dd2ace7461fc5357f5373052c9a690789", "parents": ["3cbe7c502dba3e60cf7583008f0ff722a013b7b0"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 623cf7be86\n\nUpstream commit: https://webrtc.googlesource.com/src/+/623cf7be86c70c66232dc2185546be378eee99e7\n    Add VideoEncoderRateControlTest for v2 VideoEncoderInterface.\n\n    Initial test stub just verifies CQP. Follow-ups will add CBR tests.\n\n    Bug: webrtc:496266459\n    Change-Id: Ied4a68c3d8c377a2b08555f4b818e2ed5b6182b9\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/498601\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Sergey Silkin \u00