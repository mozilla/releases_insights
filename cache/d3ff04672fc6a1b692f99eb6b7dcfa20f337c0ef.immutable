s reverts commit 957828b43b6f349aa13307e1fd23e7f29c0689cf.\n\nRevert \"Bug 1668766 - Let bugbug select 'when: files-changed' tasks in mach try auto. r=taskgraph-reviewers,bhearsum DONTBUILD\"\n\nThis reverts commit 4c856acd8a68611e7e1b69b2595d1d57682ee200.\n", "files": ["taskcluster/gecko_taskgraph/optimize/__init__.py", "taskcluster/gecko_taskgraph/test/test_optimize_strategies.py"], "git_node": "59ef4d246ebcca8edf4ac21d4aca7bdaa14c4958", "git_parents": ["d136f271c6d45251bd3eab2c8baf85f24148c70b"], "node": "0d97e29580ec9c73e7d08983eca1f462b16d81a1", "parents": ["3f1f2902caa3bd66cbf1ead79899a0af5ac9dcfc"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Revert \"Bug 1710592 - Generate bugbug-push-schedules.json artifact on backstop pushes too. r=taskgraph-reviewers,bhearsum DONTBUILD\" to prevent slow decision tasks on autoland\n\nThis reverts commit fa47aa596b11a8e0c29c1044afa5f998d224875b.\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/optimize/bugbug.py", "taskcluster/gecko_taskgraph/test/test_util_bugbug.py", "taskcluster/gecko_taskgraph/util/bugbug.py", "taskcluster/gecko_taskgraph/util/chunking.py", "taskcluster/test/test_mach_try_auto.py"], "git_node": "4c0ee7ea449b42516acc266c57e3ccc72b7ca1b3", "git_parents": ["59ef4d246ebcca8edf4ac21d4aca7bdaa14c4958"], "node": "5f2e8c90aaf764cada7f935e734c965aa3d0c942", "parents": ["0d97e29580ec9c73e7d08983eca1f462b16d81a1"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Revert \"Bug 2076694 - Use the confidence thresholds returned by bugbug in the bugbug manifest loader. r=bhearsum,taskgraph-reviewers DONTBUILD\" to prevent slow decision tasks on autoland\n\nThis reverts commit fc30cca8f6512042a286519096d56ed1c8e48834.\n", "files": ["taskcluster/gecko_taskgraph/test/test_util_chunking.py", "taskcluster/gecko_taskgraph/util/chunking.py"], "git_node": "8994336529fbcbc6d51b105b63cfb710b6f3d9a7", "git_parents": ["4c0ee7ea449b42516acc266c57e3ccc72b7ca1b3"], "node": "4023984d9cb1c60a65ff6d27d70146bc5b1f1178", "parents": ["5f2e8c90aaf764cada7f935e734c965aa3d0c942"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Revert \"Bug 2074885 - Avoid redundant work when computing the test manifests of a task. r=taskgraph-reviewers,bhearsum\" to prevent slow decision tasks on autoland\n\nThis reverts commit ffaad538141387785625ef3e4ab90be04a61e39b.\n\nRevert \"Bug 2074885 - Index included manifest runtimes once in resolve_manifest_runtimes. r=taskgraph-reviewers,bhearsum\"\n\nThis reverts commit 855b3147909cfbf19810b3e3e4b9f3018b478ebd.\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/test/test_util_chunking.py", "taskcluster/gecko_taskgraph/transforms/test/chunk.py", "taskcluster/gecko_taskgraph/util/chunking.py"], "git_node": "ce03be7be9ac10e3bb8411a15c39c0966d3c1550", "git_parents": ["8994336529fbcbc6d51b105b63cfb710b6f3d9a7"], "node": "626efafe4d0f60a1d7f5fd1b571e388d489ca942", "parents": ["4023984d9cb1c60a65ff6d27d70146bc5b1f1178"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 1957425 - Show the Passwords tool in the sidebar launcher by default. r=sclements,kcochrane\n\nNew sidebar users pick the tool up from DEFAULT_LAUNCHER_TOOLS in\nSidebarManager. Existing users, who have a user value for sidebar.main.tools,\nget it from the sidebar.newTool.migration.passwords branch instead, gated on\nbrowser.contextual-password-manager.enabled - which is already true in-tree, so\nthe tool appears as soon as the migration runs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D243682\n", "files": ["browser/app/profile/firefox.js", "browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/sidebar/tests/browser/browser_extensions_sidebar.js", "browser/components/sidebar/tests/browser/browser_glean_sidebar.js", "browser/components/sidebar/tests/browser/browser_tools_migration.js"], "git_node": "af6a89efb00380c5eab665ef0b1a2b9f43d93235", "git_parents": ["ce03be7be9ac10e3bb8411a15c39c0966d3c1550"], "node": "8a685a7e4099c0f79dcaae6fd815d69eb5df90a0", "parents": ["626efafe4d0f60a1d7f5fd1b571e388d489ca942"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078559 - only run remote pkcs#11 tests in nightly for now r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331330\n", "files": ["security/manager/ssl/tests/moz.build"], "git_node": "e14dfafb073996b6912e7c47e89b41e75edcfafe", "git_parents": ["af6a89efb00380c5eab665ef0b1a2b9f43d93235"], "node": "fff67aec1dc5c80fb350796abc05e0b207bb7e39", "parents": ["8a685a7e4099c0f79dcaae6fd815d69eb5df90a0"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078884 - Allow the b-linux-large worker type in Gecko task definitions. r=releng-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331370\n", "files": ["taskcluster/config.yml"], "git_node": "70e30ab839850f8dd3c748b5f63743719bcab706", "git_parents": ["e14dfafb073996b6912e7c47e89b41e75edcfafe"], "node": "e16ecf93fca3060b8e5408b7260361248db617cd", "parents": ["fff67aec1dc5c80fb350796abc05e0b207bb7e39"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076853 - Remove newtab old recs impressions pref that was replaced with persistant cache r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330018\n", "files": ["browser/extensions/newtab/docs/v2-system-addon/preferences.md", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs"], "git_node": "9b0b89059ec3a4a65b460111d4034b716cca1f6e", "git_parents": ["70e30ab839850f8dd3c748b5f63743719bcab706"], "node": "a5b4307cf71e89eba00e4e330462268866a813b0", "parents": ["e16ecf93fca3060b8e5408b7260361248db617cd"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2078897 - Use a post-indexed load for the RegExp backtrack pop on arm64. r=iain\n\nSMRegExpMacroAssembler::Pop loaded from the backtrack stack pointer and\nthen incremented it, which on arm64 emits ldrsw + add. On arm64, emit a\nsingle post-indexed ldrsw instead, matching the pre-indexed str that\nPush uses since bug 2078057.\n\nOn one JetStream 3 run on arm64 this removes 15,451 instructions\n(about 60 KB) from RegExp code.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331379\n", "files": ["js/src/irregexp/RegExpNativeMacroAssembler.cpp"], "git_node": "1cc24be0ba0ea7cb88baf2a664962857edb9a158", "git_parents": ["9b0b89059ec3a4a65b460111d4034b716cca1f6e"], "node": "f84a1e8e9f9d5c1fe14209b1f7ee3e0786abfa3e", "parents": ["a5b4307cf71e89eba00e4e330462268866a813b0"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2075496 - Exclude vpython files from libyuv vendoring r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331374\n", "files": ["media/libyuv/moz.yaml"], "git_node": "8fec9f862e9d74fdbd0e2e55c4db6142d725c10d", "git_parents": ["1cc24be0ba0ea7cb88baf2a664962857edb9a158"], "node": "658cd85d52cdc1878d5fd3793b319d9fc7072c7b", "parents": ["f84a1e8e9f9d5c1fe14209b1f7ee3e0786abfa3e"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2075496 - Update libyuv to eb8eda9c7973 r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331359\n", "files": ["media/libyuv/libyuv/BUILD.bazel", "media/libyuv/libyuv/BUILD.gn", "media/libyuv/libyuv/CMakeLists.txt", "media/libyuv/libyuv/DEPS", "media/libyuv/libyuv/README.chromium", "media/libyuv/libyuv/build_overrides/build.gni", "media/libyuv/libyuv/docs/formats.md", "media/libyuv/libyuv/include/libyuv/compare_row.h", "media/libyuv/libyuv/include/libyuv/convert.h", "media/libyuv/libyuv/include/libyuv/convert_argb.h", "media/libyuv/libyuv/include/libyuv/convert_from.h", "media/libyuv/libyuv/include/libyuv/convert_from_argb.h", "media/libyuv/libyuv/include/libyuv/cpu_id.h", "media/libyuv/libyuv/include/libyuv/cpu_support.h", "media/libyuv/libyuv/include/libyuv/planar_functions.h", "media/libyuv/libyuv/include/libyuv/rotate_row.h", "media/libyuv/libyuv/include/libyuv/row.h", "media/libyuv/libyuv/include/libyuv/row_sve.h", "media/libyuv/libyuv/include/libyuv/scale.h", "media/libyuv/libyuv/include/libyuv/scale_row.h", "media/libyuv/libyuv/include/libyuv/version.h", "media/libyuv/libyuv/include/libyuv/video_common.h", "media/libyuv/libyuv/libyuv.gni", "media/libyuv/libyuv/libyuv.gyp", "media/libyuv/libyuv/libyuv.gypi", "media/libyuv/libyuv/riscv_script/riscv-clang.cmake", "media/libyuv/libyuv/source/compare.cc", "media/libyuv/libyuv/source/compare_gcc.cc", "media/libyuv/libyuv/source/compare_win.cc", "media/libyuv/libyuv/source/convert.cc", "media/libyuv/libyuv/source/convert_argb.cc", "media/libyuv/libyuv/source/convert_from.cc", "media/libyuv/libyuv/source/convert_from_argb.cc", "media/libyuv/libyuv/source/convert_to_argb.cc", "media/libyuv/libyuv/source/convert_to_i420.cc", "media/libyuv/libyuv/source/cpu_id.cc", "media/libyuv/libyuv/source/mjpeg_decoder.cc", "media/libyuv/libyuv/source/planar_functions.cc", "media/libyuv/libyuv/source/rotate.cc", "media/libyuv/libyuv/source/rotate_any.cc", "media/libyuv/libyuv/source/rotate_common.cc", "media/libyuv/libyuv/source/rotate_gcc.cc", "media/libyuv/libyuv/source/rotate_lsx.cc", "media/libyuv/libyuv/source/rotate_win.cc", "media/libyuv/libyuv/source/row_any.cc", "media/libyuv/libyuv/source/row_common.cc", "media/libyuv/libyuv/source/row_gcc.cc", "media/libyuv/libyuv/source/row_lasx.cc", "media/libyuv/libyuv/source/row_lsx.cc", "media/libyuv/libyuv/source/row_neon.cc", "media/libyuv/libyuv/source/row_neon64.cc", "media/libyuv/libyuv/source/row_rvv.cc", "media/libyuv/libyuv/source/row_sve.cc", "media/libyuv/libyuv/source/row_wasm.cc", "media/libyuv/libyuv/source/row_win.cc", "media/libyuv/libyuv/source/scale.cc", "media/libyuv/libyuv/source/scale_any.cc", "media/libyuv/libyuv/source/scale_argb.cc", "media/libyuv/libyuv/source/scale_common.cc", "media/libyuv/libyuv/source/scale_gcc.cc", "media/libyuv/libyuv/source/scale_rvv.cc", "media/libyuv/libyuv/source/scale_uv.cc", "media/libyuv/libyuv/unit_test/color_test.cc", "media/libyuv/libyuv/unit_test/compare_test.cc", "media/libyuv/libyuv/unit_test/convert_argb_test.cc", "media/libyuv/libyuv/unit_test/convert_test.cc", "media/libyuv/libyuv/unit_test/cpu_test.cc", "media/libyuv/libyuv/unit_test/planar_test.cc", "media/libyuv/libyuv/unit_test/scale_argb_test.cc", "media/libyuv/libyuv/unit_test/scale_test.cc", "media/libyuv/libyuv/unit_test/scale_uv_test.cc", "media/libyuv/libyuv/unit_test/unit_test.cc", "media/libyuv/libyuv/unit_test/unit_test.h", "media/libyuv/libyuv/unit_test/video_common_test.cc", "media/libyuv/libyuv/util/cpuid.c", "media/libyuv/libyuv/util/yuvconvert.cc", "media/libyuv/moz.yaml"], "git_node": "c0e00093f777be7bee7951320c036e2bf461c2a0", "git_parents": ["8fec9f862e9d74fdbd0e2e55c4db6142d725c10d"], "node": "1a22a588ee3fdf0720b3feac723d5b95627e8faa", "parents": ["658cd85d52cdc1878d5fd3793b319d9fc7072c7b"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2075496 - Update 01_make_mjpeg_printfs_optional.patch for libyuv eb8eda9c7973 r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331360\n", "files": ["media/libyuv/01_make_mjpeg_printfs_optional.patch"], "git_node": "0df16805d47435dd758dc2891bcc74e2c9acbde5", "git_parents": ["c0e00093f777be7bee7951320c036e2bf461c2a0"], "node": "8a80c83c7683fb914b0351307f1f9d876eb4964c", "parents": ["1a22a588ee3fdf0720b3feac723d5b95627e8faa"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2075496 - Apply local patches r=ng\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331361\n", "files": ["media/libyuv/libyuv/include/libyuv/row.h", "media/libyuv/libyuv/libyuv.gyp", "media/libyuv/libyuv/libyuv.gypi", "media/libyuv/libyuv/source/mjpeg_decoder.cc"], "git_node": "8b6b018ed901448ee07616232c05309a7a2c945f", "git_parents": ["0df16805d47435dd758dc2891bcc74e2c9acbde5"], "node": "de1b66bee8c3e70370e57333d7e6be964cf5e02c", "parents": ["8a80c83c7683fb914b0351307f1f9d876eb4964c"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078423: prioritize autoland tests over mozilla-central tests r=release-managers,taskgraph-reviewers,ahal,RyanVM\n\nBy the time code reaches mozilla-central, it's rare for us to find new failures. It's more important to prioritize getting integration testing done on autoland (and thus keeping it open more) than sanity checking already tested code that is merged to mozilla-central.\n\nThis is not necessarily the most _ideal_ implementation: any newly added kinds will not get these priorities by default, but it's the simple and straightforward way to do it for now. An alternative I considered was adding support for `by-shipping-phase` in the priority definitions in `config.yml`, and have mozilla-central treat anything with a `shipping-phase` set as higher priority than autoland, and anything without a `shipping-phase` as lower priority. This turned into a bit of a can of worms with mobile tasks, because a number of things in the non-shippable build chain turn out to be part of shipping Nightlies. It may be worth revisiting this at some point later, but for now I think this is a reasonable and expedient approach.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331291\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/kinds/browsertime/kind.yml", "taskcluster/kinds/mochitest/kind.yml", "taskcluster/kinds/reftest/kind.yml", "taskcluster/kinds/test/kind.yml", "taskcluster/kinds/web-platform-tests/kind.yml", "taskcluster/kinds/webrender/kind.yml"], "git_node": "9c0de1c8809b49fce5e8c55f6feac082276d4f74", "git_parents": ["8b6b018ed901448ee07616232c05309a7a2c945f"], "node": "ee28ac90557b574a01c1499951c55d331e7bdcd7", "parents": ["de1b66bee8c3e70370e57333d7e6be964cf5e02c"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2078597 - Replace nsDeque with std::deque to fix the intentional memory leak in ASAN+DEBUG build. r=necko-reviewers,valentin\n\nnsDeque's dstor will call NS_LogDtor, which takes a mutex inside nsTraceRefcnt.\nReplace it with std::deque.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331161\n", "files": ["netwerk/base/FuzzyLayer.cpp"], "git_node": "b7d7a21beade3efb906d8aac9bd627e81c0708bb", "git_parents": ["9c0de1c8809b49fce5e8c55f6feac082276d4f74"], "node": "f1bce18b17f0b14c565eba510734548d8173b700", "parents": ["ee28ac90557b574a01c1499951c55d331e7bdcd7"], "tags": []}, {"author": "acreskeyMoz \u003cacreskey@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078625 - Document alertNotifyEmails in the perftest docs r=aglavic,perftest-reviewers\n\nPerfherder can email owners about alerts, but nothing in the docs said so or how to set it up.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331227\n", "files": ["testing/perfdocs/generated/adding-tests.md", "testing/performance/adding-tests/perfdocs/index.md"], "git_node": "bbeed50ed2ea11d8b2232471237058d89d141433", "git_parents": ["b7d7a21beade3efb906d8aac9bd627e81c0708bb"], "node": "0c77ce045783afb211fb5e9bee34da7012f660b8", "parents": ["f1bce18b17f0b14c565eba510734548d8173b700"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings tld-suffixes mobile-experiments mobile-merino-manifest ct-logs - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331390\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "mobile/android/fenix/app/src/main/res/raw/initial_experiments.json", "netwerk/dns/effective_tld_names.dat", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/ai-window-prompts.json", "services/settings/dumps/main/devtools-compatibility-browsers.json", "services/settings/dumps/security-state/onecrl.json"], "git_node": "bc5763cee0b7217a4b904af07d8681d8f55339c4", "git_parents": ["bbeed50ed2ea11d8b2232471237058d89d141433"], "node": "13026588a121a4852a10275e3b8941c3d68700a3", "parents": ["0c77ce045783afb211fb5e9bee34da7012f660b8"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2073873 - Distinguish expected test failures from real ones in resource usage profile markers, r=ahal.\n\nA todo() and a real failure both produced a marker named FAIL, and\ntesting/timings/profile-worker.js picks the first marker named FAIL after a test\nstarts as that test's failure message. Renaming the expected case is what keeps\nit out of that lookup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327686\n", "files": ["testing/mozbase/mozsystemmonitor/mozsystemmonitor/resourcemonitor.py", "testing/mozbase/mozsystemmonitor/tests/test_resource_monitor.py"], "git_node": "bbc4d4f5c7a9446e6bd26d8473f6e9233724c1ee", "git_parents": ["bc5763cee0b7217a4b904af07d8681d8f55339c4"], "node": "db0c95bb1a45463d45a1fe51af34088e222ec422", "parents": ["13026588a121a4852a10275e3b8941c3d68700a3"], "tags": []}, {"author": "MoHan Zhang \u003cmzhang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075320 - Rename the AITab chat tool to generate_page and gate the pages prompt module on the AITab pref r=rrando\n\nThe chat tool that creates an AITab is renamed generate_page: models read\n\"page\" as the artifact the user asked for (\"make this a page\", \"save this as a\npage\"), while \"aitab\" is a product name they never see in user requests. Only\nthe tool name and the focus parameter's description change; the GENERATE_AITAB\nconstant and the AITab module keep their names.\n\nThe chat prompt's guidance for that tool lives in a `pages` module in Remote\nSettings. buildChatSystemPrompt now skips chat modules listed in\nGATED_CHAT_MODULES while their pref is off, so the model is never taught about\na tool that filterFeatureGatedTools does not give it: with\nbrowser.smartwindow.aitab.enabled off the served prompt is identical to\ntoday's, with it on the pages module is appended after response-rules. An\ninstruction-only gate (\"only when generate_page is in your tool list\") did not\nhold in evaluation: with the tool absent, Gemini still closed 35% of its\nreplies with a page offer.\n\nShipped builds have neither this gate nor the rename, so Remote Settings\npublishes the module under a new chat params major (12) and this patch moves\nFEATURE_MAJOR_VERSIONS.chat from 11 to 12 (still 10 with the mistralRelease\npref off). Release 157 and beta 158 keep reading major 11, which is unchanged;\nonly builds that carry this patch select v12, so the tool name, the gate and\nthe guidance always travel together. The packaged dump is left to its\nautomated sync: this lands after the v12 records are published and synced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328921\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js"], "git_node": "f44861b2a74072fe8171cd39108570dcf2ca45f1", "git_parents": ["bbc4d4f5c7a9446e6bd26d8473f6e9233724c1ee"], "node": "c7c0a8edd171f3b9f7a37963908fa8e2cecd54e7", "parents": ["db0c95bb1a45463d45a1fe51af34088e222ec422"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078644 - Include X11UndefineNone.h in OverlayInfo.h and gfxPlatform.h r=gfx-reviewers,lsalzman\n\nOverlayInfo.h (OverlaySupportType::None) and gfxPlatform.h (GlobalReflowFlags::None) declare enumerators named `None`, which breaks when they are included after X11 headers, as X11/X.h defines `None` as a macro. widget/gtk/nsShmImage.cpp includes \u003cX11/Xlib-xcb.h\u003e (via nsShmImage.h) before gfxPlatform.h. It only compiled because some other header reached through the include chain happened to undefine `None` first (BaseProfilerMarkersPrerequisites.h, reached via gfxPlatform.h's earlier includes; mozilla/widget/InitData.h, reached via nsIWidget.h). Once that indirect include path changed, the Linux build broke.\n\nMake both headers self-contained by including X11UndefineNone.h, as other headers that declare a `None` enumerator already do (InitData.h, nsStyleConsts.h, gfxTextRun.h).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331393\n", "files": ["gfx/ipc/OverlayInfo.h", "gfx/thebes/gfxPlatform.h"], "git_node": "a0d48e14f4ce8274384f1f83324e959bfc74c51c", "git_parents": ["f44861b2a74072fe8171cd39108570dcf2ca45f1"], "node": "157d3cbf21131d9de19643e8b9238857084935f1", "parents": ["c7c0a8edd171f3b9f7a37963908fa8e2cecd54e7"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073442 - [devtools] Fix watchedByDevTools propagation when using bfcache back/forward r=devtools-reviewers,dom-core-reviewers,nchevobbe,farre\n\nThe state should only be set when devtools are actually open.\nAlso make sure to set the state back to false to cleanup stale values\nstored for contexts saved in bfcache.\n\nA test covering the crash is added as a devtools browser mochitest\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331030\n", "files": ["devtools/client/framework/test/browser.toml", "devtools/client/framework/test/browser_toolbox_watchedByDevTools_bfcache.js", "docshell/base/CanonicalBrowsingContext.cpp"], "git_node": "2fc5945897b542c661458e3ed033926793714cc6", "git_parents": ["a0d48e14f4ce8274384f1f83324e959bfc74c51c"], "node": "5e3b94412645cae51a0dc36fcb5539f924f8ff9a", "parents": ["157d3cbf21131d9de19643e8b9238857084935f1"], "tags": []}, {"author": "Dennis Jackson \u003cgit@dennis-jackson.uk\u003e", "branch": "default", "desc": "Bug 2074831 - upgrade NSS to NSS_3_131_RTM. r=nss-reviewers,nkulatova UPGRADE_NSS_RELEASE\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331373\n", "files": ["security/nss/TAG-INFO", "security/nss/build.sh", "security/nss/cpputil/nss_scoped_ptrs.h", "security/nss/doc/src/releases/index.md", "security/nss/doc/src/releases/nss_3_131.md", "security/nss/gtests/cryptohi_gtest/cryptohi_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_kem_unittest.cc", "security/nss/gtests/pk11_gtest/pk11_module_unittest.cc", "security/nss/gtests/pkcs11testmodule/pkcs11testmodule.cpp", "security/nss/gtests/ssl_gtest/ssl_dhe_unittest.cc", "security/nss/lib/certdb/certdb.c", "security/nss/lib/cryptohi/seckey.c", "security/nss/lib/nss/nss.h", "security/nss/lib/pk11wrap/pk11skey.c", "security/nss/lib/pkcs12/p12.h", "security/nss/lib/pkcs12/p12e.c", "security/nss/lib/pkcs7/p7common.c", "security/nss/lib/pkcs7/p7create.c", "security/nss/lib/pkcs7/secmime.c", "security/nss/lib/pkcs7/secmime.h", "security/nss/lib/pkcs7/secpkcs7.h", "security/nss/lib/smime/cms.h", "security/nss/lib/smime/cmsarray.c", "security/nss/lib/smime/cmsattr.c", "security/nss/lib/smime/cmsauthenvdata.c", "security/nss/lib/smime/cmslocal.h", "security/nss/lib/smime/cmsmessage.c", "security/nss/lib/smime/cmsrecinfo.c", "security/nss/lib/smime/cmssigdata.c", "security/nss/lib/smime/cmssiginfo.c", "security/nss/lib/smime/manifest.mn", "security/nss/lib/smime/smime.gyp", "security/nss/lib/smime/smime.h", "security/nss/lib/smime/smimemessage.c", "security/nss/lib/smime/smimeutil.c", "security/nss/lib/softoken/softkver.h", "security/nss/lib/ssl/ssl3con.c", "security/nss/lib/ssl/ssl3ecc.c", "security/nss/lib/ssl/ssl3exthandle.c", "security/nss/lib/ssl/sslauth.c", "security/nss/lib/ssl/sslcert.c", "security/nss/lib/ssl/sslimpl.h", "security/nss/lib/ssl/sslnonce.c", "security/nss/lib/ssl/sslreveal.c", "security/nss/lib/ssl/sslsecur.c", "security/nss/lib/ssl/sslsnce.c", "security/nss/lib/ssl/sslsock.c", "security/nss/lib/ssl/tls13con.c", "security/nss/lib/ssl/tls13subcerts.c", "security/nss/lib/util/nssutil.h", "security/nss/moz.yaml"], "git_node": "aed9cfd1d12f1b66376cb1aa02818de35320b0db", "git_parents": ["2fc5945897b542c661458e3ed033926793714cc6"], "node": "2e4ac3ca1848d01b963b65f89c2165c745eb6fa1", "parents": ["5e3b94412645cae51a0dc36fcb5539f924f8ff9a"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2072843 - Extend expiration of extensions_button metrics r=rpl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330440\n", "files": ["browser/components/extensions/metrics.yaml"], "git_node": "a0470ffe1cdfbf314fbb4a2f9bf191e8b0aa96c8", "git_parents": ["aed9cfd1d12f1b66376cb1aa02818de35320b0db"], "node": "1bde4f68768f520156d2b764fbf572450c4a9be3", "parents": ["2e4ac3ca1848d01b963b65f89c2165c745eb6fa1"], "tags": []}, {"author": "Chris H-C \u003cchutten@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078773 - Skip usage-reporting test on artifact as it relies on ride-along pings r=TravisLong DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331287\n", "files": ["toolkit/components/telemetry/tests/marionette/tests/client/manifest.toml"], "git_node": "a030001978c232a499ad5023e89dbc6dabd002c0", "git_parents": ["a0470ffe1cdfbf314fbb4a2f9bf191e8b0aa96c8"], "node": "61391c17d9a21f558691ab0bd763c868c33ebec4", "parents": ["1bde4f68768f520156d2b764fbf572450c4a9be3"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045134 - Part 1: Remove unnecessary virtual keyword from nsHTMLContentSerializer::SerializeHTMLAttributes; r=masayuki\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310402\n", "files": ["dom/serializers/nsHTMLContentSerializer.h"], "git_node": "d5a00f84d792df22f8f95e2b86e4a46f06f9c8d5", "git_parents": ["a030001978c232a499ad5023e89dbc6dabd002c0"], "node": "59eb6b53b83fa8fafe02b4f21d5e4221c0325a6f", "parents": ["61391c17d9a21f558691ab0bd763c868c33ebec4"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045134 - Part 2: Remove unused arguments from nsHTMLContentSerializer::SerializeHTMLAttributes; r=masayuki\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310403\n", "files": ["dom/serializers/nsHTMLContentSerializer.cpp", "dom/serializers/nsHTMLContentSerializer.h"], "git_node": "6172fe698cded98222c6ad0baae99e5eee54a7cf", "git_parents": ["d5a00f84d792df22f8f95e2b86e4a46f06f9c8d5"], "node": "94fd4bdbea2d8838cc17dadb61dca14e1548be03", "parents": ["59eb6b53b83fa8fafe02b4f21d5e4221c0325a6f"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045134 - Part 3: Use uint32_t for attribute count and index in nsHTMLContentSerializer::SerializeHTMLAttributes; r=masayuki\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310404\n", "files": ["dom/serializers/nsHTMLContentSerializer.cpp"], "git_node": "456e9cfb1a6a2a8fb85734b378e9dc46fcf71022", "git_parents": ["6172fe698cded98222c6ad0baae99e5eee54a7cf"], "node": "1dbbb8ad847da6733f88c68f7e8ebd2331d9ce34", "parents": ["94fd4bdbea2d8838cc17dadb61dca14e1548be03"], "tags": []}, {"author": "Edgar Chen \u003cechen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2045134 - Part 4: Remove unnecessary local variable from nsHTMLContentSerializer::SerializeHTMLAttributes. r=masayuki\n\nThis patch doesn't change behavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310405\n", "files": ["dom/serializers/nsHTMLContentSerializer.cpp"], "git_node": "b44892dabc35cde8c23d9b793af7ac4e48e215b5", "git_parents": ["456e9cfb1a6a2a8fb85734b378e9dc46fcf71022"], "node": "061c02e2ea06908a0bc8caec7c72e9dbfc7c68c8", "parents": ["1dbbb8ad847da6733f88c68f7e8ebd2331d9ce34"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075320 - Rename the AITab chat tool to generate_page and gate the pages prompt module on the AITab pref r=rrando\" for causing bc failures @ browser_prompt_loader_chat_system_prompt.js\n\nThis reverts commit f44861b2a74072fe8171cd39108570dcf2ca45f1.\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js"], "git_node": "2a69ca0225f0a240c61f23f055e4b9b82cc018c4", "git_parents": ["b44892dabc35cde8c23d9b793af7ac4e48e215b5"], "node": "68e7663ee9b8f2fd0aafadce1c717999c735d349", "parents": ["061c02e2ea06908a0bc8caec7c72e9dbfc7c68c8"], "tags": []}], "date": 1791349400, "git_changesets": ["dfef775ac7be499a4b66bd17e5b9ec891cd6d34b", "ebc56efb727cc3ce355228c17a72757fc2df2b48", "6dd898dd861674906554c332566391a8ce60a6fc", "0b19adf7c5a6256958e2e42e9cd503ac09dea776", "b3090fe739168b19bc6392bdcb0e1a47a29f16ce", "4d764e5689cad9372892ce3002d18995461a7668", "797520c8e5b0b61fa2418cfe3760670f3d4a3ae3", "dbe4adc8663cda1c75ca0cf066a2466e3bbb12bc", "88c5d5b6e6793b6b7eb3f852c545fcc54650c742", "1c1acdff2f28b7b1065f94ca2f3a3be587a1a03c", "6c90f0f6e830645aca2448ba11b9f0877c277fb8", "793f209a357918316a6a650e1ba798f02cfefbd4", "e701152ee4bb7158cf5022eac7a0a30b0ab3c709", "829c26b8d0914ad58870bbe4f44617157d973942", "e030580df12aa5dfdad60ab21d4e542fcab72324", "2c6cb5fabcd147d3518fb2791b3aa9be08383f39", "4fc78243ad8a342bea180051b5a3e3e533a28200", "79a57e65101e84804ee6a2920a91a2032f2432d1", "032147228a59146854f849ae1a2c94d100ce92c8", "1cc1555d62cda96ee5503945cce66888cb979ccb", "3f1bba5b59033bb974b40b8b5a9132d3b5855caf", "de3520f4a09040e762358f00048e53f65bc41ba3", "8862df4eaae55e554d8b9d87c288e917ed7c4779", "22ff99cc8a24bcd4d042d48fc3824cdea7f190c8", "371568b66a8e218ce13f13209c63acb58c6afa12", "1840c01aa474ad45bab1f3a45738835ebad046a8", "f96310b45da26e1fbcad1e48af6bd34cb3b01554", "d97613cacb6a4c9748452cd7277361856022777b", "339a97ba41f81af71588d6ca5b2d5af9fbcbbb9e", "2ccac481d842d4295570aeb5b89d81b2309ed28d", "ca88c3b783052d1f3651688a81bec1ec1507225c", "5e75f24589fd80a19e6a846c9b41f92eddac4baa", "0130edf0882ec9d78317bab7434774b8842df63a", "7745fbe8a53a76cd97a496fbe70a55e56671752b", "b699e4efbbcc26a706d7d23e6c994cc3e2195790", "234b96c3dcc5a4598b7d95f1516a7ed1c8e08975", "91317e638606a439cab7feea4d0b95741a56f309", "6a3cbd8f9d4004ca801e17cecf2a0d89aa601259", "e72d6e8edb8c67aaee5a41d396cf61e9f1127624", "b7b9f961af7b661ef5e0e6a4685b9ebe61c5e453", "6bcf09ac29b0e02984605d24af4397f254f63b4c", "f3872690fbc03dac68ec23166223627cbbb6be0d", "28ecce56c75bd7f303f51ad0d18b49e5e74c80b2", "0a253a03a81ed1c089358e7522c115b05eb591f2", "c69052798b391ce7dddd408bedd3eeea869ecf36", "292baf4289814ab549c3a92492048115e10f72c6", "5b815abb5e103cd7a984cd2f37f3087815329032", "6759a33d25a1c31242bae18f4663688dc7f55ec0", "8a2a73960a6ea05594b4bdc6fa6495fe6b12ecf0", "e83800b04d31d58a1c399af9b3aae69a3433a5ec", "c83b8e28e31a287d72c713676754bd313f52925c", "8f232a5747ad577159347b84d80742c4c9deef16", "189faeafbd17bbd522040b577be30a34ed077847", "65c0e9abf2578094c20a23e5594a19500cd75108", "3624ba83be226778ffd72d423fde437eb0ad25f2", "b9a9c7d11a3a7eae58dc9bb6176f64ae4229d389", "1a8e1ad42ba89100392b68ccabdb4ccf0792d1d2", "b5ae95b7e1315f85a11a4a63a9699b6141413193", "02bde4f3c9b055c2b6dcb66c67345b35fe8ad116", "d136f271c6d45251bd3eab2c8baf85f24148c70b", "59ef4d246ebcca8edf4ac21d4aca7bdaa14c4958", "4c0ee7ea449b42516acc266c57e3ccc72b7ca1b3", "8994336529fbcbc6d51b105b63cfb710b6f3d9a7", "ce03be7be9ac10e3bb8411a15c39c0966d3c1550", "af6a89efb00380c5eab665ef0b1a2b9f43d93235", "e14dfafb073996b6912e7c47e89b41e75edcfafe", "70e30ab839850f8dd3c748b5f63743719bcab706", "9b0b89059ec3a4a65b460111d4034b716cca1f6e", "1cc24be0ba0ea7cb88baf2a664962857edb9a158", "8fec9f862e9d74fdbd0e2e55c4db6142d725c10d", "c0e00093f777be7bee7951320c036e2bf461c2a0", "0df16805d47435dd758dc2891bcc74e2c9acbde5", "8b6b018ed901448ee07616232c05309a7a2c945f", "9c0de1c8809b49fce5e8c55f6feac082276d4f74", "b7d7a21beade3efb906d8aac9bd627e81c0708bb", "bbeed50ed2ea11d8b2232471237058d89d141433", "bc5763cee0b7217a4b904af07d8681d8f55339c4", "bbc4d4f5c7a9446e6bd26d8473f6e9233724c1ee", "f44861b2a74072fe8171cd39108570dcf2ca45f1", "a0d48e14f4ce8274384f1f83324e959bfc74c51c", "2fc5945897b542c661458e3ed033926793714cc6", "aed9cfd1d12f1b66376cb1aa02818de35320b0db", "a0470ffe1cdfbf314fbb4a2f9bf191e8b0aa96c8", "a030001978c232a499ad5023e89dbc6dabd002c0", "d5a00f84d792df22f8f95e2b86e4a46f06f9c8d5", "6172fe698cded98222c6ad0baae99e5eee54a7cf", "456e9cfb1a6a2a8fb85734b378e9dc46fcf71022", "b44892dabc35cde8c23d9b793af7ac4e48e215b5", "2a69ca0225f0a240c61f23f055e4b9b82cc018c4"], "user": "asilaghi@mozilla.com"}, "45501": {"changesets": [{"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052389 - Hide tab close button for pinned tabs when expand on hover is enabled and the sidebar is expanded r=desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330912\n", "files": ["browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "abed73362df09749d3de975466435ccb23997472", "git_parents": ["2a69ca0225f0a240c61f23f055e4b9b82cc018c4"], "node": "0dca9758820caa24bbe0dc0cafce01cf288bb389", "parents": ["68e7663ee9b8f2fd0aafadce1c717999c735d349"], "tags": []}, {"author": "Emma Zuehlcke \u003cemz@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061167 - Credit BTP's gesture-free bounce candidate to the site being left, not the initiator. r=manuel\n\nA script in another tab, or a frame allowed to navigate the top level without a\ngesture, was credited with a bounce it never performed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328932\n", "files": ["toolkit/components/antitracking/bouncetrackingprotection/BounceTrackingState.cpp", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser.toml", "toolkit/components/antitracking/bouncetrackingprotection/test/browser/browser_bouncetracking_initiator_credit.js", "toolkit/components/antitracking/docs/bounce-tracking-protection/index.md"], "git_node": "59692968d832961713edca64611d521f3038f355", "git_parents": ["abed73362df09749d3de975466435ccb23997472"], "node": "8efb772982fd68fde272441ed485ab95d0c971dc", "parents": ["0dca9758820caa24bbe0dc0cafce01cf288bb389"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075710 - Fix dangling symlink detection in `mozfile.copy_contents` r=mozbase-reviewers,ahal\n\n`shutil.copytree` checks whether a relative symlink is dangling by resolving\nits target against the current directory instead of the link's directory\n(https://github.com/python/cpython/issues/156210). A dangling link whose\ntarget name happened to exist in the current directory was copied and failed.\n\n`test_copycontents.py` was missing from its manifest and never ran.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331290\n", "files": ["testing/mozbase/mozfile/mozfile/mozfile.py", "testing/mozbase/mozfile/tests/manifest.toml", "testing/mozbase/mozfile/tests/test_copycontents.py"], "git_node": "49b2b9cc581c47647bd8c514be2de72fca7adb7d", "git_parents": ["59692968d832961713edca64611d521f3038f355"], "node": "4f5f3f7a84311ecc7a58c402f6507f0f171dffce", "parents": ["8efb772982fd68fde272441ed485ab95d0c971dc"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078358 - Ensure SharedSurface is valid before use. r=gfx-reviewers,aosmond\n\nThe owning GL context of a SharedSurface is held in a WeakPtr, so it may\ngo away while the SharedSurface is still referenced. Make the IsValid()\ncheck detect this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331421\n", "files": ["gfx/gl/SharedSurface.h", "gfx/gl/SharedSurfaceEGL.cpp", "gfx/layers/ipc/CanvasTranslator.cpp"], "git_node": "39f7c0fe84016394da1db69af4d2852be740b783", "git_parents": ["49b2b9cc581c47647bd8c514be2de72fca7adb7d"], "node": "c6fddcdb23f6401c3a821b752ac708d4913f3b53", "parents": ["4f5f3f7a84311ecc7a58c402f6507f0f171dffce"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073845 - Tag the mozharness action timings with the test suite and variant so Perfherder keeps one series per suite. r=ahal,taskgraph-reviewers\n\n`BaseScript.run` writes the time each action took to\n`perfherder-data-mozharness-actions.json`, which Perfherder ingests as\nthe `mozharness` framework. On test tasks every suite of a platform\nlands in the same series, because nothing distinguishes a mochitest\nrun from an xpcshell run in the payload. Taskgraph now puts the suite\nand variant into `PERFHERDER_EXTRA_OPTIONS` and mozharness copies them\ninto each suite entry, so the download, virtualenv and install steps\ncan be compared per suite between revisions.\n\nBuild tasks already set `PERFHERDER_EXTRA_OPTIONS`, so their action\ntimings also gain those options and move to new series.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327668\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/transforms/test/other.py", "testing/mozharness/mozharness/base/script.py", "testing/mozharness/test/test_base_script.py"], "git_node": "4153cec71cbb1f87230c0b3b6ed311319e182413", "git_parents": ["39f7c0fe84016394da1db69af4d2852be740b783"], "node": "b57a22dd72796a306fc802e717cf909b3d7e8f3e", "parents": ["c6fddcdb23f6401c3a821b752ac708d4913f3b53"], "tags": []}, {"author": "Julie De Lorenzo \u003cjdelorenzo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075398 - Tapping voices list will refresh available voices r=android-reviewers,matt-tighe\n\n- Tapping the voices list will now refresh available voices, reflecting added or removed downloaded voices.\n- If no voices are available, playback will be paused.  The dropdown already shows an error text for that case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330947\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ui/VoiceSelection.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt"], "git_node": "713cfc089c90e66636224f79e38120093bcc70f0", "git_parents": ["4153cec71cbb1f87230c0b3b6ed311319e182413"], "node": "e143e54f6390a3afa4066451c36b7219bfa83805", "parents": ["b57a22dd72796a306fc802e717cf909b3d7e8f3e"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078904. r=gfx-reviewers,tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331423\n", "files": ["gfx/2d/SourceSurfaceSkia.cpp"], "git_node": "0f295923dfb7630ef837453fe97260371e54afc4", "git_parents": ["713cfc089c90e66636224f79e38120093bcc70f0"], "node": "7e4ac5f3c79801786b267f4ff1ddf5bd92ed7d55", "parents": ["e143e54f6390a3afa4066451c36b7219bfa83805"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069144 - Add a Glean category and core events for the text selection menu r=flozia\n\nFor background on the new Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nThe menu's existing probes are all genaiChatbot.*, which no longer fits now that the\nmenu is not chatbot-scoped. Add a selection_menu category with a displayed event,\nrecorded whether or not the chatbot action is offered, and an action_click event that\nnames the action clicked, so later actions add values rather than new probes. The panel\nis shared with the classic chat shortcuts and Smart Window flows, so both events carry\nsmart_window to keep Smart Window out of the menu's analysis.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328221\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/metrics.yaml", "browser/components/genai/tests/browser/browser_chat_shortcuts.js"], "git_node": "8fcb2a558a0c97c83d141c6b604340aa45011f73", "git_parents": ["0f295923dfb7630ef837453fe97260371e54afc4"], "node": "cd8f61f71808f587534da97796462d16fc72a864", "parents": ["7e4ac5f3c79801786b267f4ff1ddf5bd92ed7d55"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078676 - Show the frame for the current playback position when VideoSink pauses. r=media-playback-reviewers,pehrsons,alwu\n\nOn pause, VideoSink rendered the front of the video queue. That frame can have\nexpired before UpdateRenderedVideoFrames() next ran, while the compositor was\nalready showing a later one, so pausing could step the video back a frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331257\n", "files": ["dom/media/gtest/TestVideoSink.cpp", "dom/media/mediasink/VideoSink.cpp"], "git_node": "ed57676de9c24bd420279d32f20f8dd3de97775a", "git_parents": ["8fcb2a558a0c97c83d141c6b604340aa45011f73"], "node": "19c13c17c4014f01d0ca98a3376106a46611b050", "parents": ["cd8f61f71808f587534da97796462d16fc72a864"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2030272 - Skip vertex data texture uploads when the frame data is unchanged r=gfx-reviewers,lsalzman\n\nDuring Wayland direct scanout a frame is presented every vsync for the changed\nvideo surface while WebRender draws nothing, yet bind_frame_data still created\na TextureUploader. Device::upload_texture probes the PBO pool fences with\nclient_wait_sync, which flushes the GPU command stream on AMD/Mesa.\n\nRetain a copy of the last upload and skip when the data matches. Buffers over\none texture row are always treated as dirty, bounding the copy to 64 kB. The\ntexture set ring now only rotates on upload, since the rotation exists to avoid\nwriting a texture the GPU may still be sampling.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323057\n", "files": ["gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/vertex.rs", "gfx/wr/wrench/reftests/performance/reftest.list", "gfx/wr/wrench/reftests/performance/static-scene-no-vertex-upload.yaml", "gfx/wr/wrench/src/reftest.rs"], "git_node": "71da6876115e9865822d71d5db7803ee10a4560f", "git_parents": ["ed57676de9c24bd420279d32f20f8dd3de97775a"], "node": "8c91608087ce5a7666ef0d14e153facc01055fcd", "parents": ["19c13c17c4014f01d0ca98a3376106a46611b050"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2078979. Add tests for bug 2050626. r=gfx-reviewers,bradwerth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310629\n", "files": ["testing/web-platform/tests/html/canvas/resources/canvas-tests.js", "testing/web-platform/tests/webcodecs/videoFrame-construction.crossOriginSource.sub.html"], "git_node": "693ca666f298e92ea7fc6fd1dc50e20419226b42", "git_parents": ["71da6876115e9865822d71d5db7803ee10a4560f"], "node": "a48ae475f4935333f1307cee4cae1556e1423662", "parents": ["8c91608087ce5a7666ef0d14e153facc01055fcd"], "tags": []}, {"author": "Timothy Nikkel \u003ctnikkel@gmail.com\u003e", "branch": "default", "desc": "Bug 2078979. Add tests for bug 2061794. r=necko-reviewers,jesup\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317310\n", "files": ["testing/web-platform/tests/fetch/security/canvas-tainted-serviceworker-passthrough-redirect.https.html", "testing/web-platform/tests/fetch/security/passthrough-serviceworker.js", "testing/web-platform/tests/fetch/security/stylesheet-cssrules-serviceworker-passthrough-redirect.https.html", "testing/web-platform/tests/fetch/security/support/passthrough-tainted.css"], "git_node": "5ab82e13e943c00911a625842def1cb00113f43b", "git_parents": ["693ca666f298e92ea7fc6fd1dc50e20419226b42"], "node": "079e2acd020a8ab64c094a4ba0ab19c04e285941", "parents": ["a48ae475f4935333f1307cee4cae1556e1423662"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069667 - part 1: `TextEventDispatcher` store composition strings, one is requested by native IME handler and the other is in the content r=m_kato,ltenenbaum\n\nTo batch event dispatching in `TextEventDispatcher`,\n`TextEventDispatcher` should store the composition string which is in\nthe content because widget cannot know the latest string in the content\nwhen the widget is notified something from content.\n\nIn follow up bugs, we should make the native IME handlers stop storing\nthe composition string by themselves.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327561\n", "files": ["widget/TextEventDispatcher.cpp", "widget/TextEventDispatcher.h"], "git_node": "ab18a3a905ec5d28a52aa00484ef16c5cb32fa32", "git_parents": ["5ab82e13e943c00911a625842def1cb00113f43b"], "node": "18c7e64abbc672159d59df8909fc3b69feda1351", "parents": ["079e2acd020a8ab64c094a4ba0ab19c04e285941"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069667 - part 2: Improve `WidgetContentCommandEvent::mIsEnabled` handling r=ltenenbaum\n\nNeither `EventStateManager::DoContentCommandInsertTextEvent` nor\n`EventStateManager::DoContentCommandReplaceTextEvent` sets `mIsEnabled`\ncorrectly for the requests in the same process when `mOnlyEnabledCheck`\nis `Yes`.\n\nAdditionally, there is no way to test the `mIsEnabled` value in JS.\nThis is required by the new test in the following patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327562\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/events/EventStateManager.cpp", "dom/interfaces/base/nsIDOMWindowUtils.idl"], "git_node": "1008e8071c1faf0809df35fdcce40fb6562e285f", "git_parents": ["ab18a3a905ec5d28a52aa00484ef16c5cb32fa32"], "node": "364d5aab293b227f6ca82f1c09228105b3b3200b", "parents": ["18c7e64abbc672159d59df8909fc3b69feda1351"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069667 - part 3: Add batch event dispatching to `TextEventDispatcher` r=m_kato,ltenenbaum\n\nAdd batch event dispatching feature to `TextEventDispatcher`.\n\nThe batch should merge:\n* consecutive `eCompositionChange` events during a batch\n* a short life committed composition and its preceding canceled composition\n\nHowever, the batch should not merge if:\n* a keyboard event happens\n* a content command event happens (except `eContentCommandInsertText with the pref)\n* a selection set event happens\n\nThe latter is useful to handle dead key sequence with compose key on\nLinux. So, the batch will be used while `IMContextWrapper::OnKeyEvent`\ncalls `gtk_im_context_filter_keypress` API which may send multiple\ncomposition events synchronously.\n\nThis adds test APIs to `nsITextInputProcessor` to test the batch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326041\n", "files": ["dom/base/TextInputProcessor.cpp", "dom/base/test/chrome/chrome.toml", "dom/base/test/chrome/test_TextEventDispatcherBatch.xhtml", "dom/base/test/chrome/window_TextEventDispatcherBatch.xhtml", "dom/interfaces/base/nsITextInputProcessor.idl", "modules/libpref/init/StaticPrefList.yaml", "widget/MiscEvents.h", "widget/TextEventDispatcher.cpp", "widget/TextEventDispatcher.h"], "git_node": "5140cf9e212f335dec56c790291c0495d3993996", "git_parents": ["1008e8071c1faf0809df35fdcce40fb6562e285f"], "node": "a2b53df13b7c8878be61b56089f43a5904a607a3", "parents": ["364d5aab293b227f6ca82f1c09228105b3b3200b"], "tags": []}, {"author": "Masayuki Nakano \u003cmasayuki@d-toybox.com\u003e", "branch": "default", "desc": "Bug 2069667 - part 4: Make `IMContextWrapper::OnKeyEvent` use the batch of `TextEventDispatcher` r=m_kato\n\nThe dead key with compose key starts composition and when it's\ncommitted, the composition may be canceled and commits the composed\ncharacter without composing state. Then, the content will receive:\n* `compositionupdate` with empty data\n* `compositionend` with empty data\n* only `beforeinput`/`input` of `insertText` with the composed data\n\nor:\n* `compositionupdate` with empty data\n* `compositionend` with empty data\n* a set of `compositionstart`, `compositionupdate` and `compositionend`\n\nSo, web apps can intercept the input. And if the selection change\nnotification reaches native IME handler during the lag, the following\ncomposition may be canceled by a `gtk_im_context_reset` call.\n\nTherefore, we should use the `TextEventDispatcher` batch for merging\nthe commit string without composing state as the commit string of the\ncanceled composition.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326042\n", "files": ["widget/TextEventDispatcher.h", "widget/gtk/IMContextWrapper.cpp", "widget/gtk/IMContextWrapper.h"], "git_node": "e6b6fc19671bba8769a7f87785d5626c848d9130", "git_parents": ["5140cf9e212f335dec56c790291c0495d3993996"], "node": "1e9279076c22ab98d84acb1cb8fc7225071360c6", "parents": ["a2b53df13b7c8878be61b56089f43a5904a607a3"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078926: use pull request target tasks by default for staging-firefox r=taskgraph-reviewers,ahal\n\nWe do this for the main firefox repo, but not staging-firefox, which means we have no way to fire things in a way that can be used to test reviewbot outside of production.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331392\n", "files": ["taskcluster/gecko_taskgraph/decision.py"], "git_node": "0bb66865d132e25fef2329962323996be048e176", "git_parents": ["e6b6fc19671bba8769a7f87785d5626c848d9130"], "node": "28ff3abf0bfe7a328b8b7a72427ed34bdc217e1b", "parents": ["1e9279076c22ab98d84acb1cb8fc7225071360c6"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077593 - [devtools] Use AppErrorBoundary in the Animations panel. r=devtools-reviewers,jdescottes.\n\nTweak the style of the AppErrorBoundary so it doesn't overflow horizontally.\nAlso prevent a double vertical scroll bar in the Animations panel when the\nAppErrorBoundary is displayed.\nFinally, make the stack trace monospace and smaller so it's easier to read,\nespecially when the AppErrorBoundary is narrow (like it can be in the Animations panel)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331084\n", "files": ["devtools/client/inspector/animation/components/App.js", "devtools/client/shared/components/AppErrorBoundary.css", "devtools/client/shared/components/AppErrorBoundary.js"], "git_node": "b5fc89546c18b478faea7c77e17a2382ef0ca472", "git_parents": ["0bb66865d132e25fef2329962323996be048e176"], "node": "3fb8472d26c8bbd7fdf65cdac9121ff8ec3a7f98", "parents": ["28ff3abf0bfe7a328b8b7a72427ed34bdc217e1b"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078537 - [devtools] Limit stacks length in AppErrorBoundary's bug link. r=devtools-reviewers,jdescottes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331085\n", "files": ["devtools/client/shared/components/AppErrorBoundary.js"], "git_node": "3d26693c827a2667ae5b6ae08ebad7a08b27faa8", "git_parents": ["b5fc89546c18b478faea7c77e17a2382ef0ca472"], "node": "51e08ca8df087024354e189af5571872e7c038cb", "parents": ["3fb8472d26c8bbd7fdf65cdac9121ff8ec3a7f98"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2066289 - Test planar image picture-geometry admission r=gfx-reviewers,bradwerth\n\nCover valid boundary and malformed picture rectangles through adoption, recycling copy, shared copy, and NV data installation. Verify malformed updates are rejected before image state changes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321670\n", "files": ["gfx/tests/gtest/TestPlanarYCbCrImage.cpp", "gfx/tests/gtest/moz.build"], "git_node": "d625e7dc1f926b7ed57bf4927c53e5f9cc5cdf29", "git_parents": ["3d26693c827a2667ae5b6ae08ebad7a08b27faa8"], "node": "3116f9cbd6990dec3d956b7541a90d7bf3e13e44", "parents": ["51e08ca8df087024354e189af5571872e7c038cb"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2066289 - Reject malformed planar image picture geometry r=media-playback-reviewers,webrtc-reviewers,gfx-reviewers,pehrsons,alwu,bradwerth\n\nValidate planar picture rectangles before deriving plane sizes, accessing a backend, or mutating image state. Reuse the checked endpoint size across recycling, shared, adopted, and NV images, propagate copy failures from unchecked callers, and make chroma rounding safe at the largest valid endpoint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321671\n", "files": ["dom/media/mediasink/VideoSink.cpp", "dom/media/webrtc/libwebrtcglue/WebrtcMediaDataEncoderCodec.cpp", "gfx/2d/Types.h", "gfx/layers/ImageContainer.cpp", "gfx/layers/ImageContainer.h", "gfx/layers/ipc/SharedPlanarYCbCrImage.cpp"], "git_node": "48d9b1dd2acc230759e081588dce031e8d6cfb7c", "git_parents": ["d625e7dc1f926b7ed57bf4927c53e5f9cc5cdf29"], "node": "cdfb5fc2e449aca7054e7024c79e7899fec9ce25", "parents": ["3116f9cbd6990dec3d956b7541a90d7bf3e13e44"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070879 - Wait for frame construction before considering document speculation rules. r=smaug,dom-core-reviewers\n\nDocument rules can only match against links which are being rendered,\nand we cannot determine this until after their frames have been constructed.\nSo if frames still need to be contructed, delay consider loads until\nafter the next refresh.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330247\n", "files": ["dom/base/SpeculationRuleSet.cpp", "dom/base/SpeculationRuleSet.h", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "dom/base/speculationrules/lib.rs", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/implicit-source.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/inline-speculation-rules-after-stylesheet.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-from-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy.https.html.ini"], "git_node": "653f8ae55ffae6f700661273bb9f6d09acdb9461", "git_parents": ["48d9b1dd2acc230759e081588dce031e8d6cfb7c"], "node": "f7ea66f32d0a3244fb2970137427a9c470a9c438", "parents": ["cdfb5fc2e449aca7054e7024c79e7899fec9ce25"], "tags": []}, {"author": "Meg Viar \u003clmegviar@gmail.com\u003e", "branch": "default", "desc": "Bug 2074888 - Add Support for Personalization for Taskbar Tabs in Spotlight Modals r=omc-reviewers,tschuster,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329823\n", "files": ["browser/base/content/spotlight.html", "browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/asrouter/content-src/components/ContentTiles.jsx", "browser/components/asrouter/content-src/components/MultiStageAboutWelcome.jsx", "browser/components/asrouter/content-src/components/PinnableSitesList.jsx", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/modules/ASRouterScreenUtils.sys.mjs", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/modules/PinnableSitesProvider.sys.mjs", "browser/components/asrouter/modules/Spotlight.sys.mjs", "browser/components/asrouter/moz.build", "browser/components/asrouter/tests/browser/browser.toml", "browser/components/asrouter/tests/browser/browser_pinnable_sites_personalized.js", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAboutWelcome.test.jsx", "browser/components/asrouter/tests/unit/content-src/components/PinnableSitesList.test.jsx", "browser/components/asrouter/tests/xpcshell/test_PinnableSitesProvider.js", "browser/components/asrouter/tests/xpcshell/xpcshell.toml", "browser/components/taskbartabs/TaskbarTabsRegistry.sys.mjs", "toolkit/components/messaging-system/lib/SpecialMessageActions.sys.mjs", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_pin_taskbar_tab.js"], "git_node": "98e3a2f9859a5d776f0ab046980154a68da776d4", "git_parents": ["653f8ae55ffae6f700661273bb9f6d09acdb9461"], "node": "ff1915dd9eda1a30e21cb62b8c68bc82fd57e3c7", "parents": ["f7ea66f32d0a3244fb2970137427a9c470a9c438"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-da/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-eo/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-th/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-uk/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-vi/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-th/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-uk/strings.xml", "mobile/android/android-components/components/compose/base/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/addons/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/app-links/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/ipprotection/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-co/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-da/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-eo/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fy-rNL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-hi-rIN/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-pl/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-uk/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-vi/strings.xml", "mobile/android/android-components/components/feature/media/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/prompts/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/protection-dashboard/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/feature/summarize/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/longfox/src/main/res/values-fa/strings.xml", "mobile/android/fenix/app/src/main/res/values-co/strings.xml", "mobile/android/fenix/app/src/main/res/values-da/strings.xml", "mobile/android/fenix/app/src/main/res/values-eo/strings.xml", "mobile/android/fenix/app/src/main/res/values-fa/strings.xml", "mobile/android/fenix/app/src/main/res/values-fy-rNL/strings.xml", "mobile/android/fenix/app/src/main/res/values-hi-rIN/strings.xml", "mobile/android/fenix/app/src/main/res/values-hy-rAM/strings.xml", "mobile/android/fenix/app/src/main/res/values-ja/strings.xml", "mobile/android/fenix/app/src/main/res/values-pl/strings.xml", "mobile/android/fenix/app/src/main/res/values-th/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/fenix/app/src/main/res/values-uk/strings.xml", "mobile/android/fenix/app/src/main/res/values-vi/strings.xml", "mobile/android/focus-android/app/src/main/res/values-fa/strings.xml", "mobile/android/focus-android/app/src/main/res/values-uk/strings.xml"], "git_node": "7728f51948c51476eeaa419ef18c07e6dbdbf5c3", "git_parents": ["98e3a2f9859a5d776f0ab046980154a68da776d4"], "node": "4d579512ad419b38de327a28ae0163263d6191f3", "parents": ["ff1915dd9eda1a30e21cb62b8c68bc82fd57e3c7"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2030272 - Skip vertex data texture uploads when the frame data is unchanged r=gfx-reviewers,lsalzman\" reftest failures DONTBUILD\n\nThis reverts commit 71da6876115e9865822d71d5db7803ee10a4560f.\n", "files": ["gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/vertex.rs", "gfx/wr/wrench/reftests/performance/reftest.list", "gfx/wr/wrench/reftests/performance/static-scene-no-vertex-upload.yaml", "gfx/wr/wrench/src/reftest.rs"], "git_node": "975cb187eec5a6b894fd44764971a03ac89acdca", "git_parents": ["7728f51948c51476eeaa419ef18c07e6dbdbf5c3"], "node": "17f172e16c702c279bbb8e43a8e5624433e0a4e9", "parents": ["4d579512ad419b38de327a28ae0163263d6191f3"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076632 - Update android nightly application-services version bump to 9c693c5fde7a2a1777fe0f38ec06b29e2eff2ff5 r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329880\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "b1e3f19f9378cf1e6d27537ef8f7560d00e150f0", "git_parents": ["975cb187eec5a6b894fd44764971a03ac89acdca"], "node": "a16b979d559a5fc5801bf86485b032f6aade89d8", "parents": ["17f172e16c702c279bbb8e43a8e5624433e0a4e9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073213 - Don't assert on uninitialized TlsContext in AutoUnsafeCallWithABI for frontend-only users r=arai\n\nThe ORB JS validator (utility process) compiles scripts through the frontend-only API. JS_FrontendOnlyInit never initializes TlsContext. Constant folding of `/` and `%` calls NumberDiv/NumberMod (util/PortableMath.h). Those functions contain an AutoUnsafeCallWithABI, whose constructor called TlsContext.get() unconditionally. On platforms that use pthread-key TLS storage (Android, because of MOZ_LINKER), that triggers `Assertion failure: Storage\u003cT\u003e::initialized()`. Platforms with native TLS just get nullptr.\n\nFix: in AutoUnsafeCallWithABI, treat an uninitialized TlsContext like the existing \"no JSContext\" case, which is the helper-thread path. This matches what JS::AutoAssertNoGC already does. The change is at the guard level rather than in the frontend, so any other ABI helper reused from frontend-only code is covered too. The code is only compiled under JS_CHECK_UNSAFE_CALL_WITH_ABI (debug builds), so release builds pay no performance cost.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330042\n", "files": ["js/src/jsapi-tests/testFrontendCompileStencil.cpp", "js/src/vm/JSContext.cpp"], "git_node": "fbb7d393944143ee893d771a24a763ca9276b969", "git_parents": ["b1e3f19f9378cf1e6d27537ef8f7560d00e150f0"], "node": "8968bab7be2b49f8297211981403887c397168a5", "parents": ["a16b979d559a5fc5801bf86485b032f6aade89d8"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070879 - Wait for frame construction before considering document speculation rules. r=smaug,dom-core-reviewers\" for causing wpt failure DONTBUILD\n\nThis reverts commit 653f8ae55ffae6f700661273bb9f6d09acdb9461.\n", "files": ["dom/base/SpeculationRuleSet.cpp", "dom/base/SpeculationRuleSet.h", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "dom/base/speculationrules/lib.rs", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/implicit-source.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/inline-speculation-rules-after-stylesheet.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-from-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy.https.html.ini"], "git_node": "0e3ad9bc8492a3973b2719ba24bedbb6032d5d38", "git_parents": ["fbb7d393944143ee893d771a24a763ca9276b969"], "node": "9396f61348f72bb2ded3c304a2573838bad3b5ba", "parents": ["8968bab7be2b49f8297211981403887c397168a5"], "tags": []}, {"author": "Henri Sivonen \u003chsivonen@hsivonen.fi\u003e", "branch": "default", "desc": "Bug 2078133 - Fix UB in prefetch address computation in simdutf8 r=supply-chain-reviewers,glandium\n\nFix https://github.com/rusticstuff/simdutf8/issues/129\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330686\n", "files": [".cargo/config.toml.in", "Cargo.lock", "Cargo.toml", "supply-chain/audits.toml", "supply-chain/config.toml", "third_party/rust/simdutf8/.cargo-checksum.json", "third_party/rust/simdutf8/.cargo_vcs_info.json", "third_party/rust/simdutf8/Cargo.lock", "third_party/rust/simdutf8/Cargo.toml", "third_party/rust/simdutf8/Cargo.toml.orig", "third_party/rust/simdutf8/src/implementation/algorithm.rs"], "git_node": "d4529e4a3b8dd7d77b3c420bf743546d160a7657", "git_parents": ["0e3ad9bc8492a3973b2719ba24bedbb6032d5d38"], "node": "c8c5f40d1009ebb92d0c45cc55201a25c55bb7cf", "parents": ["9396f61348f72bb2ded3c304a2573838bad3b5ba"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078545 - Convert copyCustomTabToolbarUrlTest regression UI test to the efficiency framework r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331096\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/CustomTabsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/CustomTabsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/CustomTabsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/CustomTabsTest.kt"], "git_node": "7683b14fae6bce65a00a5ac182e82daffac15c79", "git_parents": ["d4529e4a3b8dd7d77b3c420bf743546d160a7657"], "node": "44a8a0d63d7bb02922095d0932913e69eefd0216", "parents": ["c8c5f40d1009ebb92d0c45cc55201a25c55bb7cf"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078554 - Create new verifyNavigationToOtherWebsitesWithinSameTabTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=100674\nAll efficiency UI tests successfully passed 1x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=100673\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331149\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/NavigationToolbarTest.kt"], "git_node": "cfd140a311d8523d3d35e00ee1a9f2403c033dfd", "git_parents": ["7683b14fae6bce65a00a5ac182e82daffac15c79"], "node": "2212393f637e0e578526bec3b9c4d33c6af84ff1", "parents": ["44a8a0d63d7bb02922095d0932913e69eefd0216"], "tags": []}], "date": 1791366883, "git_changesets": ["abed73362df09749d3de975466435ccb23997472", "59692968d832961713edca64611d521f3038f355", "49b2b9cc581c47647bd8c514be2de72fca7adb7d", "39f7c0fe84016394da1db69af4d2852be740b783", "4153cec71cbb1f87230c0b3b6ed311319e182413", "713cfc089c90e66636224f79e38120093bcc70f0", "0f295923dfb7630ef837453fe97260371e54afc4", "8fcb2a558a0c97c83d141c6b604340aa45011f73", "ed57676de9c24bd420279d32f20f8dd3de97775a", "71da6876115e9865822d71d5db7803ee10a4560f", "693ca666f298e92ea7fc6fd1dc50e20419226b42", "5ab82e13e943c00911a625842def1cb00113f43b", "ab18a3a905ec5d28a52aa00484ef16c5cb32fa32", "1008e8071c1faf0809df35fdcce40fb6562e285f", "5140cf9e212f335dec56c790291c0495d3993996", "e6b6fc19671bba8769a7f87785d5626c848d9130", "0bb66865d132e25fef2329962323996be048e176", "b5fc89546c18b478faea7c77e17a2382ef0ca472", "3d26693c827a2667ae5b6ae08ebad7a08b27faa8", "d625e7dc1f926b7ed57bf4927c53e5f9cc5cdf29", "48d9b1dd2acc230759e081588dce031e8d6cfb7c", "653f8ae55ffae6f700661273bb9f6d09acdb9461", "98e3a2f9859a5d776f0ab046980154a68da776d4", "7728f51948c51476eeaa419ef18c07e6dbdbf5c3", "975cb187eec5a6b894fd44764971a03ac89acdca", "b1e3f19f9378cf1e6d27537ef8f7560d00e150f0", "fbb7d393944143ee893d771a24a763ca9276b969", "0e3ad9bc8492a3973b2719ba24bedbb6032d5d38", "d4529e4a3b8dd7d77b3c420bf743546d160a7657", "7683b14fae6bce65a00a5ac182e82daffac15c79", "cfd140a311d8523d3d35e00ee1a9f2403c033dfd"], "user": "abutkovits@mozilla.com"}, "45502": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 45f9989bafaf251bb466620e814360f5c6a8318c with DEVEDITION_158_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "b8736b846c953c0aeaa97c9ef6aa0c385b233519", "git_parents": ["cd09d2d99de78ff442309dbdc2f8b2d6a6ac2d75"], "node": "977a65c81b5acd26d2e8efe8865fc28de74d6ab1", "parents": ["a05738a29ac69ffd5ce04b77577d9c8c65d7e395"], "tags": []}], "date": 1791378361, "git_changesets": ["b8736b846c953c0aeaa97c9ef6aa0c385b233519"], "user": "ffxbld@lando.moz.tools"}, "45503": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 45f9989bafaf251bb466620e814360f5c6a8318c with FIREFOX-ANDROID_158_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "48171890c657b12978fac40d90346a7c31792fdf", "git_parents": ["b8736b846c953c0aeaa97c9ef6aa0c385b233519"], "node": "7c9b8733a308aa251eafd803c1d3d9a54ffe63e1", "parents": ["977a65c81b5acd26d2e8efe8865fc28de74d6ab1"], "tags": []}], "date": 1791378502, "git_changesets": ["48171890c657b12978fac40d90346a7c31792fdf"], "user": "ffxbld@lando.moz.tools"}, "45504": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 45f9989bafaf251bb466620e814360f5c6a8318c with FIREFOX_158_0b5_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "f54be2126a86b6999d0f69c4a1b947f74c519fab", "git_parents": ["48171890c657b12978fac40d90346a7c31792fdf"], "node": "0a975eecd2088717972573774fe3671775d3666d", "parents": ["7c9b8733a308aa251eafd803c1d3d9a54ffe63e1"], "tags": []}], "date": 1791378566, "git_changesets": ["f54be2126a86b6999d0f69c4a1b947f74c519fab"], "user": "ffxbld@lando.moz.tools"}, "45505": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 45f9989bafaf251bb466620e814360f5c6a8318c with FIREFOX-ANDROID_158_0b5_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "af6d7c361534ad930b97c34746224ca80acc3fa6", "git_parents": ["f54be2126a86b6999d0f69c4a1b947f74c519fab"], "node": "925ffda9d175e1c2f883f8570b1a6a1909dfd990", "parents": ["0a975eecd2088717972573774fe3671775d3666d"], "tags": []}], "date": 1791381508, "git_changesets": ["af6d7c361534ad930b97c34746224ca80acc3fa6"], "user": "ffxbld@lando.moz.tools"}, "45506": {"changesets": [{"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2077571 - jit/arm64: fold shifts and rotates into the second operand of add, orr and eor in MacroAssembler emitters. r=iain\n\nAArch64 add, orr and eor can shift or rotate their second register operand\nby a constant for free. Add MacroAssembler helpers that compute\nsrcDest = (srcDest shifted or rotated) op src, which are one instruction on\narm64 and the existing shift and op elsewhere, and use them in the SipHash\nrounds for Map and Set object keys, both megamorphic cache shape hashes,\nlookupStaticString and EmitInitDependentStringBase.\n\nIn the arm64 code generated while running JetStream 3, this removes about\n8,300 instructions:\n\n                                   Ion   Baseline\n  SipHash ror + eor              3,183        192\n  megamorphic shape hash         2,652         49\n  lookupStaticString lsl + add   1,136          -\n  dependent string flags         1,120          -\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330421\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h"], "git_node": "3facaa8b15bedb6854b6a7333bd2293665c03a6c", "git_parents": ["cfd140a311d8523d3d35e00ee1a9f2403c033dfd"], "node": "2bcc7b3571cb2883f4c852cbe419df5fc7e0409c", "parents": ["2212393f637e0e578526bec3b9c4d33c6af84ff1"], "tags": []}, {"author": "Eugeniusz Lewandowski \u003ceugenelewandowski@proton.me\u003e", "branch": "default", "desc": "Bug 2074312 - Added gtest for 2056581 (Making autoscroll consider DPI). r=botond\n\nAdded a test that tests that DPI affects an AutoScroll animation\nby comparing them empirically.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329934\n", "files": ["gfx/layers/apz/test/gtest/APZCTreeManagerTester.h", "gfx/layers/apz/test/gtest/APZTestCommon.h", "gfx/layers/apz/test/gtest/TestPanning.cpp"], "git_node": "7ee172d42cc21f9f8e20a08bfb8709381574e64c", "git_parents": ["3facaa8b15bedb6854b6a7333bd2293665c03a6c"], "node": "16b2aa4c6988b56badf2ba3b762fcb45c15254e4", "parents": ["2bcc7b3571cb2883f4c852cbe419df5fc7e0409c"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2074009 - Await the default-browser check in TelemetryEnvironment tests; r=chutten\n\nThe delayed default-browser test waits for search service initialization but\nnot for the default-browser check. It currently passes with the trivial async\nimplementation, but could become flaky when the check runs on a background\nthread and takes longer.\n\nRetain the default-browser check's Promise and expose it through a test-only\nhelper so the test can await it before checking the telemetry environment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329976\n", "files": ["toolkit/components/telemetry/app/TelemetryEnvironment.sys.mjs", "toolkit/components/telemetry/tests/unit/test_TelemetryEnvironment.js"], "git_node": "e695af1c3af55d4aa2cd12daba8418484b58154c", "git_parents": ["7ee172d42cc21f9f8e20a08bfb8709381574e64c"], "node": "36d3b98339eb72b5008d540fafc91aa11ca10edb", "parents": ["16b2aa4c6988b56badf2ba3b762fcb45c15254e4"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077571 - jit/arm64: fold shifts and rotates into the second operand of add, orr and eor in MacroAssembler emitters. r=iain\" for causing spidermonkey failure at MacroAssembler.h\n\nThis reverts commit 3facaa8b15bedb6854b6a7333bd2293665c03a6c.\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler-inl.h", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h"], "git_node": "64f94487e90a867086670ade7a3ed3573721e337", "git_parents": ["e695af1c3af55d4aa2cd12daba8418484b58154c"], "node": "8e399bc61820c988e344399849b90f22104b8fd7", "parents": ["36d3b98339eb72b5008d540fafc91aa11ca10edb"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2078909 - Skip the jump to the next instruction after the last Ion bailout path and the last Baseline return. r=iain\n\nEvery Ion out-of-line bailout path pushes its snapshot offset and jumps to\ndeoptLabel_, which each platform binds right after the last out-of-line\npath. When that last path is a bailout, its jump targets the next\ninstruction. Defer the jump until another out-of-line path is generated, so\nthe last one falls through to deoptLabel_.\n\nBaseline already omits the jump to the return label for a return that is\nthe script's last op, but the last op is usually an unreachable RetRval\nafter an explicit Return, which Baseline does not emit. Check for the last\nreachable op instead.\n\nOn one JetStream 3 run on arm64 this removes about 33,900 instructions\n(132 KB): 16,600 in Ion and 17,300 in Baseline.\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331385\n", "files": ["js/src/jit/BaselineCodeGen.cpp", "js/src/jit/BaselineCodeGen.h", "js/src/jit/BytecodeAnalysis.cpp", "js/src/jit/BytecodeAnalysis.h", "js/src/jit/arm/CodeGenerator-arm.cpp", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/loong64/CodeGenerator-loong64.cpp", "js/src/jit/mips-shared/CodeGenerator-mips-shared.cpp", "js/src/jit/riscv64/CodeGenerator-riscv64.cpp", "js/src/jit/shared/CodeGenerator-shared.cpp", "js/src/jit/shared/CodeGenerator-shared.h", "js/src/jit/x86-shared/CodeGenerator-x86-shared.cpp"], "git_node": "67906ef32ac01529c37fcfca9e764c07896e24e3", "git_parents": ["64f94487e90a867086670ade7a3ed3573721e337"], "node": "0b3fc1f38c1a350e4bf7b82370edbfe4d53c13b2", "parents": ["8e399bc61820c988e344399849b90f22104b8fd7"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\naf -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nan -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nar -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nast -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\naz -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nbe -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nbg -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nbn -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nbo -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nbqi -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nbr -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nbrx -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nbs -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nca -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nca-valencia -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\ncak -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nckb -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\ncs -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\ncy -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nda -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nde -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\ndsb -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nel -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nen-CA -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nen-GB -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\neo -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nes-AR -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nes-CL -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nes-ES -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nes-MX -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\net -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\neu -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nfa -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nff -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nfi -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nfr -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nfur -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nfy-NL -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nga-IE -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\ngd -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\ngl -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\ngn -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\ngu-IN -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nhe -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nhi-IN -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nhr -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nhsb -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nhu -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nhy-AM -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nhye -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nia -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nid -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nis -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nit -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nja -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nja-JP-mac -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nka -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nkab -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nkk -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nkm -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nkn -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nko -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nlij -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nlo -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nlt -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nltg -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nlv -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nmeh -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nmk -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nml -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nmr -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nms -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nmy -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nnb-NO -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nne-NP -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nnl -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nnn-NO -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\noc -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\npa-IN -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\npl -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\npt-BR -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\npt-PT -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nrm -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nro -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nru -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsat -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsc -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nscn -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsco -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsi -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsk -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nskr -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsl -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nson -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsq -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsr -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nsv-SE -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nszl -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nta -\u003e dac927d2d5052c799ed83316a187ba195f3fe3f1\nte -\u003e dac927d2d