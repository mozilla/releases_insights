e 376d690aa99de464d1ff8ac2ad04c66d59826720\nsr -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nsv-SE -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nszl -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nta -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nte -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\ntg -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nth -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\ntl -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\ntr -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\ntrs -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nuk -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nur -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nuz -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nvi -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nwo -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nxh -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nzh-CN -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nzh-TW -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\n", "files": ["browser/locales/l10n-changesets.json"], "git_node": "35fc6452abc74b4ac08cbe10bc2f124cd2a923f2", "git_parents": ["242db1d3ffd664b6f5560602cc67c2295bbf512a"], "node": "81cd0121662b4799550d7c9506a2717d712e4485", "parents": ["eafd2f1d82226ba5abd7acea5d4afbc0eb0bbd43"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Mobile l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nan -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nar -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nast -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\naz -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nbe -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nbg -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nbn -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nbr -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nbs -\u003e 3