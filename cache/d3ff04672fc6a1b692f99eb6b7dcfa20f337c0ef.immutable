3dd6187c1fee4d.\n\nRevert \"Bug 2014499 - Add a Groups section to the Smart Window mentions panel r=fluent-reviewers,urlbar-reviewers,mlucks,bolsson\"\n\nThis reverts commit 9b35e49fce1a426afc4f79e017b7548d2015235b.\n\nRevert \"Bug 2059729 - Add getTabGroups/getTabGroupById to TabManagementService r=ai-security-reviewers,bjohns,gregtatum,flozia\"\n\nThis reverts commit b663a41a18d198863dbebdab01048a5ce799c8b3.\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/SecurityProperties.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_browser_context.js", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.css", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.stories.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.css", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.stories.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.mjs", "browser/components/aiwindow/ui/components/tab-group-icon/tab-group-icon.css", "browser/components/aiwindow/ui/components/tab-group-icon/tab-group-icon.mjs", "browser/components/aiwin