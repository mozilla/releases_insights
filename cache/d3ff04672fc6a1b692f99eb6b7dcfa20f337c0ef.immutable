e6498b283b3e62c775bb", "775ebad2ccf39ecddc948b6b53ff8f3dd485321a", "516aada8351ff1c0d1f60b2140e848b925d172d6", "c7efc202c96f52e41ec7a4b217516a5fd65614e9", "4c856acd8a68611e7e1b69b2595d1d57682ee200", "957828b43b6f349aa13307e1fd23e7f29c0689cf", "e13e658ea5b2f9839e967216dad0add40611914a", "9bc92e05904c2380826852e5fefeb6aa37309eba", "22bcea5961da47481004c6be0bcca9844adef8f3", "00aad09a820405643aebd693e60a3333ccf04544"], "user": "smolnar@mozilla.com"}, "45499": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 3806652efdaccfd958d04803eddd3fdf131cd0cd with FIREFOX_153_5_0esr_BUILD1 a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "cd09d2d99de78ff442309dbdc2f8b2d6a6ac2d75", "git_parents": ["bf61305e82a9e2d64e0ea7be5bbc152cb379a371"], "node": "a05738a29ac69ffd5ce04b77577d9c8c65d7e395", "parents": ["bc5f8f06cccc6921ec9806b089783c455a914597"], "tags": []}], "date": 1791316868, "git_changesets": ["cd09d2d99de78ff442309dbdc2f8b2d6a6ac2d75"], "user": "ffxbld@lando.moz.tools"}, "45500": {"changesets": [{"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2052389 - Hide tab close button for pinned tabs when expand on hover is enabled and the sidebar is expanded r=desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330912\n", "files": ["browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "dfef775ac7be499a4b66bd17e5b9ec891cd6d34b", "git_parents": ["00aad09a820405643aebd693e60a3333ccf04544"], "node": "8363f4ada69ce0db79cbe82664b4bd1a3fa6a581", "parents": ["6b0abdbdf8f6fb6ded3caf428969dc70b63c1506"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996132 - Add ResultRow typedef to UrlbarView. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330385\n", "files": ["browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "ebc56efb727cc3ce355228c17a72757fc2df2b48", "git_parents": ["dfef775ac7be499a4b66bd17e5b9ec891cd6d34b"], "node": "d8e1ab8c8063c957e437a01b47681eebd9812262", "parents": ["8363f4ada69ce0db79cbe82664b4bd1a3fa6a581"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077545 - Fix type errors in UrlbarView and enable type checking in it. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330386\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tsconfig.json", "browser/components/urlbar/types/urlbar.ts"], "git_node": "6dd898dd861674906554c332566391a8ce60a6fc", "git_parents": ["ebc56efb727cc3ce355228c17a72757fc2df2b48"], "node": "4a9a9c3ae1b6191c8cb83f075b87f50bb925c6cc", "parents": ["d8e1ab8c8063c957e437a01b47681eebd9812262"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2078587 - Fix verifyAddressAutofillToggleTest UI test r=aaronmt\n\nThe UI test failed because the keyboard remained displayed after filling the email credentials blocking the view, making it impossible to save the address.\n\nTo fix this, I've added waitForKeyboardDismiss() after filling the email credentials which will close the keyboard before attempting to save the address.\n\nThe UI test successfully passed 100x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331221\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuAutofillRobot.kt"], "git_node": "0b19adf7c5a6256958e2e42e9cd503ac09dea776", "git_parents": ["6dd898dd861674906554c332566391a8ce60a6fc"], "node": "e2867c6fc1190f6db490e642c7ebe0a8babfe5ce", "parents": ["4a9a9c3ae1b6191c8cb83f075b87f50bb925c6cc"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075985 - Take strong reference to doc when script can run in SubmitSubmission r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329598\n", "files": ["dom/html/HTMLFormElement.cpp"], "git_node": "b3090fe739168b19bc6392bdcb0e1a47a29f16ce", "git_parents": ["0b19adf7c5a6256958e2e42e9cd503ac09dea776"], "node": "e19f3b125394800c468ac142862e93d875ee812a", "parents": ["e2867c6fc1190f6db490e642c7ebe0a8babfe5ce"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2078551 - [remote] Support printing to PDF using a system printer. r=webdriver-reviewers,jdescottes\n\nThis is intended to allow us to test the Windows printing code path\n(which doesn't go through regular PDF printing and uses GDI instead).\n\nThe \"poll the file\" stuff is a bit hacky but I think it's necessary in\npractice, and this is not intended to be used outside of tests, so\nprobably fine...\n\nRefactor a bit the code to work on a Uint8Array throughout (otherwise I\nneed to turn the IOUtils output to a string which feels just silly).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331107\n", "files": ["remote/doc/Prefs.md", "remote/marionette/driver.sys.mjs", "remote/marionette/reftest.sys.mjs", "remote/shared/PDF.sys.mjs", "remote/webdriver-bidi/modules/root/browsingContext.sys.mjs"], "git_node": "4d764e5689cad9372892ce3002d18995461a7668", "git_parents": ["b3090fe739168b19bc6392bdcb0e1a47a29f16ce"], "node": "cf3cac30424eccdbbd36c7df9cb4c5bd40c4f4d3", "parents": ["e19f3b125394800c468ac142862e93d875ee812a"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076558 - Don't constrain position if we didn't get any. r=smaug\n\nOtherwise on some environments we do a move before mapping the window\nwhich prevents the DE's placement.\n\nNote that this is necessary but not sufficient to actually fix the issue\nas reported, because browser.xhtml does specify screen{X,Y}. I'll look\ninto that as well, specially into how this works on Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330757\n", "files": ["xpfe/appshell/AppWindow.cpp"], "git_node": "797520c8e5b0b61fa2418cfe3760670f3d4a3ae3", "git_parents": ["4d764e5689cad9372892ce3002d18995461a7668"], "node": "d69b3c2d69872ff34e41aa0d3f250b3a12d77421", "parents": ["cf3cac30424eccdbbd36c7df9cb4c5bd40c4f4d3"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074040 - Remove the Nightly Gate from the onboarding state reconciliation. r=android-reviewers,marcin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331064\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt"], "git_node": "dbe4adc8663cda1c75ca0cf066a2466e3bbb12bc", "git_parents": ["797520c8e5b0b61fa2418cfe3760670f3d4a3ae3"], "node": "78df7b2e4e1cdc9f2969440e93a79f4d7a19910c", "parents": ["d69b3c2d69872ff34e41aa0d3f250b3a12d77421"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070272 - Standardize the widget menu button. r=fluent-reviewers,bolsson,nina-py\n\nWidget menu buttons came in two sizes and sat at different distances from the card corner. Several had no tooltip. This adds a shared WidgetMenuButton for the small \"\u2026\" button and uses it in every widget except Sports and Weather forecast, with Privacy, Focus timer, Stocks and Clocks moved to the shared corner spacing. Each button now uses its \"Open [widget name] menu\" string from D329642, so the old strings are removed. Stocks gets a new one that says \"Open finance menu\" since the widget is now called Finance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329787\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/Clocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/_Clocks.scss", "browser/extensions/newtab/content-src/components/Widgets/Crossword/Crossword.jsx", "browser/extensions/newtab/content-src/components/Widgets/FocusTimer/FocusTimer.jsx", "browser/extensions/newtab/content-src/components/Widgets/FocusTimer/_FocusTimer.scss", "browser/extensions/newtab/content-src/components/Widgets/Lists/Lists.jsx", "browser/extensions/newtab/content-src/components/Widgets/PictureOfTheDay/PictureOfTheDay.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/Privacy.jsx", "browser/extensions/newtab/content-src/components/Widgets/Privacy/_Privacy.scss", "browser/extensions/newtab/content-src/components/Widgets/RecentSearches/RecentSearches.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/Stocks.jsx", "browser/extensions/newtab/content-src/components/Widgets/Stocks/_Stocks.scss", "browser/extensions/newtab/content-src/components/Widgets/Weather/Weather.jsx", "browser/extensions/newtab/content-src/components/Widgets/WidgetMenuButton.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Clocks.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Crossword.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Lists.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/RecentSearches.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Weather.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetMenuButton.test.jsx", "browser/locales/en-US/browser/newtab/newtab.ftl"], "git_node": "88c5d5b6e6793b6b7eb3f852c545fcc54650c742", "git_parents": ["dbe4adc8663cda1c75ca0cf066a2466e3bbb12bc"], "node": "946bf28b7beb61ac7bf673768db9af3803104d24", "parents": ["78df7b2e4e1cdc9f2969440e93a79f4d7a19910c"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077225 - Fix a flash of the old wallpaper when picking a saved image with Wallpapers turned off. r=nina-py\n\nPicking an image from \u201cYour images\u201d while Wallpapers is off briefly showed the old wallpaper. The page was re-enabled before it received the new image URL. This sends the URL as soon as the applied filename is saved, before updating the prefs, so the page shows the right image and receives the URL only once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330193\n", "files": ["browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "1c1acdff2f28b7b1065f94ca2f3a3be587a1a03c", "git_parents": ["88c5d5b6e6793b6b7eb3f852c545fcc54650c742"], "node": "de6ce529d3c8fb607ea907790d217d956bd6f2be", "parents": ["946bf28b7beb61ac7bf673768db9af3803104d24"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051892 - Disable the navigation rate limit for the WebGL conformance mochitests. r=firefox-style-system-reviewers,farre,emilio\n\nThe test runner navigates the test frame twice per test. When a browser\nsession runs a hundred of these short tests within ten seconds, the rate\nlimit silently drops the navigation to the next test and the run hangs.\n\nPoint every test manifest that disables the rate limit at bug 2077709, so\nthe overrides can all be removed once the harness no longer hits it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330567\n", "files": ["dom/base/test/mochitest-bug1.toml", "dom/base/test/mochitest-bug2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-attribs.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-buffers.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-canvas.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-context.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-extensions.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-limits.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-more.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-offscreencanvas.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-programs.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-renderbuffers.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-rendering.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-state.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-textures.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-typedarrays.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance-uniforms.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core-conformance.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-core.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-bugs.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-constructors.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-functions.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-implicit.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-reserved.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl-variables.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-glsl.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-ogles.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-conformance-textures.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl1-ext-deqp.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-attribs.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-buffers.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-canvas.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-context.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-extensions.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-limits.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-more.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-offscreencanvas.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-programs.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-renderbuffers.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-rendering.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-state.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-textures.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-typedarrays.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance-uniforms.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-data.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-draw.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-fbocolorbuffer.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-fboinvalidate.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-fborender.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-fragmentoutput.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-framebufferblit.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-primitiverestart.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-shaderindexing.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-shadermatrix.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-shaderoperator.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-shadertexturefunction.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-texturefiltering.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-textureformat.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-textureshadow.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-texturespecification.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-texturewrap.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-transformfeedback.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-uniformbuffers.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3-vertexarrays.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp-functional-gles3.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-deqp-deqp.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-bugs.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-constructors.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-functions.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-implicit.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-misc.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-reserved.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl-variables.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-glsl.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-ogles.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance-textures.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-glsl3.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-canvas.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-canvas_sub_rectangle.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-image.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-image_bitmap_from_blob.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-image_bitmap_from_canvas.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-image_bitmap_from_image.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-image_bitmap_from_image_bitmap.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-image_bitmap_from_image_data.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-image_bitmap_from_video.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-image_data.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-svg_image.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-video.toml", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-ext-conformance2-textures-webgl_canvas.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml", "dom/html/crashtests/crashtests.list", "dom/html/test/mochitest-bug1.toml", "dom/html/test/mochitest-bug2.toml", "dom/security/test/csp/mochitest.toml", "dom/tests/mochitest/dom-level1-core/mochitest-node.toml", "dom/tests/mochitest/dom-level1-core/mochitest.toml", "dom/tests/mochitest/dom-level2-core/mochitest.toml", "dom/tests/mochitest/dom-level2-html/mochitest-element.toml", "dom/tests/mochitest/dom-level2-html/mochitest-form.toml", "dom/tests/mochitest/dom-level2-html/mochitest-table.toml", "dom/tests/mochitest/dom-level2-html/mochitest.toml", "editor/libeditor/tests/mochitest.toml", "layout/style/test/mochitest.toml", "parser/htmlparser/tests/mochitest/mochitest.toml"], "git_node": "6c90f0f6e830645aca2448ba11b9f0877c277fb8", "git_parents": ["1c1acdff2f28b7b1065f94ca2f3a3be587a1a03c"], "node": "4e7e8acf161e646a2d9d827cd1c9d85bd1070f33", "parents": ["de6ce529d3c8fb607ea907790d217d956bd6f2be"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051892 - Add TimerThreadMonitor and use it for the timer thread. r=xpcom-reviewers,nika,jlink\n\nThe timer thread needs a precise wakeup when the timers it waits for have a\nsmall tolerance. Only Windows got one, from HiResWindowsMonitor in\nTimerThread.h. Elsewhere it waits on a condvar, which on macOS is subject to\nwakeup coalescing, most aggressively when the machine is idle.\n\nMove that monitor into TimerThreadMonitor, one file per platform, and give\nmacOS a kqueue backend: an EVFILT_TIMER carrying the tolerance as NOTE_LEEWAY,\nplus NOTE_CRITICAL when it is small, and an EVFILT_USER for Notify(). Other\nplatforms, and iOS where the content sandbox blocks kevent64, use a condvar\nthat waits for the end of the budget.\n\nThe tolerance now stays a TimeDuration down to each backend, which moves the\nprecise/tolerant boundary on Windows from \"below 17ms\" to \"at most 16ms\".\n\nThe monitor supports a single waiter, as HiResWindowsMonitor already did\nimplicitly; this is now documented and debug-asserted. Notify() requires the\nmonitor to be held, which every caller already did.\n\nThis hands the backends the whole residual tolerance of a bundle, up to an\neighth of a timer's delay. D326430 takes it away from timers that did not ask\nfor slack.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320396\n", "files": ["xpcom/tests/gtest/TestTimerThreadMonitor.cpp", "xpcom/tests/gtest/moz.build", "xpcom/threads/TimerThread.cpp", "xpcom/threads/TimerThread.h", "xpcom/threads/TimerThreadMonitor.h", "xpcom/threads/TimerThreadMonitor_darwin.cpp", "xpcom/threads/TimerThreadMonitor_posix.cpp", "xpcom/threads/TimerThreadMonitor_windows.cpp", "xpcom/threads/moz.build"], "git_node": "793f209a357918316a6a650e1ba798f02cfefbd4", "git_parents": ["6c90f0f6e830645aca2448ba11b9f0877c277fb8"], "node": "5e02a5f313ec63f35eb4dc0b63f6b17cd8545de7", "parents": ["4e7e8acf161e646a2d9d827cd1c9d85bd1070f33"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051892 - Let a timer compute how late it may fire. r=jlink,xpcom-reviewers,nika\n\nThe timer thread derived the acceptable firing delay from the entry's copy of\nthe delay, on every wakeup and every insertion. Let the timer compute it under\nits own mutex and copy the result into the entry, like the delay. No behaviour\nchange.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326429\n", "files": ["xpcom/threads/TimerThread.cpp", "xpcom/threads/TimerThread.h", "xpcom/threads/nsTimerImpl.cpp", "xpcom/threads/nsTimerImpl.h"], "git_node": "e701152ee4bb7158cf5022eac7a0a30b0ab3c709", "git_parents": ["793f209a357918316a6a650e1ba798f02cfefbd4"], "node": "f2ad175fc17f3072c472955afc99533228cd4fd2", "parents": ["5e02a5f313ec63f35eb4dc0b63f6b17cd8545de7"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051892 - Fire one-shot and precise timers on their deadline. r=jlink,xpcom-reviewers,nika\n\nEvery timer accepted an eighth of its delay, and at least a millisecond, of\nlateness. The timer thread wakes up for the last timer of a bundle, so the\nearlier ones fire late, and hands what is left of the tolerance to the monitor,\nwhich may wait for it. Keep that tolerance for slack and low priority timers,\nwhich asked for it, and give every other timer none: it fires on its deadline,\nsharing a wakeup only with timers due at the same instant or slack timers\ndelayed to join it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326430\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "xpcom/threads/nsTimerImpl.cpp"], "git_node": "829c26b8d0914ad58870bbe4f44617157d973942", "git_parents": ["e701152ee4bb7158cf5022eac7a0a30b0ab3c709"], "node": "7d8d5895579d776e4824a813358cbe87a4821e7c", "parents": ["f2ad175fc17f3072c472955afc99533228cd4fd2"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051892 - Update macOS WPT expectations for precise timer wakeups. r=webrtc-reviewers,ng\n\nPrecise timer wakeups on macOS make the camera framerate decimation test\nreach its target, and let the helper test's video track reach its frame\nrate. In opt builds that subtest still mostly fails on its resolution\ncheck, see bug 2077679.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330555\n", "files": ["testing/web-platform/meta/webrtc/RTCPeerConnection-helper-test.html.ini", "testing/web-platform/mozilla/meta/mediacapture-streams/getUserMedia-framerate-decimation.https.html.ini"], "git_node": "e030580df12aa5dfdad60ab21d4e542fcab72324", "git_parents": ["829c26b8d0914ad58870bbe4f44617157d973942"], "node": "51b95346d6251170d293444b937632c986e740e5", "parents": ["7d8d5895579d776e4824a813358cbe87a4821e7c"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2078395 - Fix the off-by-one bounds check in RangeSerializer::GetStartAndEndContentForRecursionLevel r=edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330908\n", "files": ["dom/serializers/nsDocumentEncoder.cpp"], "git_node": "2c6cb5fabcd147d3518fb2791b3aa9be08383f39", "git_parents": ["e030580df12aa5dfdad60ab21d4e542fcab72324"], "node": "54fac4ea17aa197f5fe09f193fd76d2b264049d4", "parents": ["51b95346d6251170d293444b937632c986e740e5"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078421 - Make BindPFooEndpoint nodiscard. r=ipc-reviewers,extension-reviewers,dom-core-reviewers,smaug,rpl,nika\n\nThe check in RecvNewWindowGlobal will keep the child from crashing the parent.\n\nExtensionsChild::Init() can't really recover from failure.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330919\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/WindowGlobalChild.cpp", "ipc/ipdl/ipdl/lower.py", "toolkit/components/extensions/ExtensionsChild.cpp", "toolkit/components/sessionstore/SessionStoreChild.cpp"], "git_node": "4fc78243ad8a342bea180051b5a3e3e533a28200", "git_parents": ["2c6cb5fabcd147d3518fb2791b3aa9be08383f39"], "node": "5b3dcf9fad49a14a45bf17c88909d84f5ee87beb", "parents": ["54fac4ea17aa197f5fe09f193fd76d2b264049d4"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076558 - Disable LoadPositionFromXUL on GTK at runtime. r=stransky\n\nSee the comments for reasoning. This effectively restores the previous\nbehavior, but leaves a runtime switch to take the Windows/macOS path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330938\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "xpfe/appshell/AppWindow.cpp", "xpfe/appshell/test/chrome.toml"], "git_node": "79a57e65101e84804ee6a2920a91a2032f2432d1", "git_parents": ["4fc78243ad8a342bea180051b5a3e3e533a28200"], "node": "f666620ab79a0d279e7e24e66a868983959f83dc", "parents": ["5b3dcf9fad49a14a45bf17c88909d84f5ee87beb"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069147 - Add a Settings checkbox for the text selection actions menu. r=fluent-reviewers,settings-reviewers,hjones,bolsson\n\nFor background on the new Highlight to Search project, here is [[ https://docs.google.com/document/d/1lpprhnIKYbXSNnVE-OSmVcE1Vpm9_vBBIKIOjW8_0lE/edit?tab=t.os3nbc21wjhe | the current spec ]].\n\nTo see this new checkbox, set `browser.highlightToSearch.featureGate` to true. Then look in the Tabs and browsing pane of about:preferences, under Page navigation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330154\n", "files": ["browser/components/preferences/config/aiFeatures.mjs", "browser/components/preferences/config/tabs-browsing.mjs", "browser/components/preferences/main.js", "browser/components/preferences/tests/browser-srd.toml", "browser/components/preferences/tests/browser.toml", "browser/components/preferences/tests/browser_tabs_browsing_highlightToSearch.js", "browser/locales/en-US/browser/genai.ftl"], "git_node": "032147228a59146854f849ae1a2c94d100ce92c8", "git_parents": ["79a57e65101e84804ee6a2920a91a2032f2432d1"], "node": "c8a3159f870107a22647da7d790159f428dbe4ba", "parents": ["f666620ab79a0d279e7e24e66a868983959f83dc"], "tags": []}, {"author": "Keith Cirkel \u003ckeithamus@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075981 - Avoid CE upgrades for static clones r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330178\n", "files": ["dom/base/nsINode.cpp"], "git_node": "1cc1555d62cda96ee5503945cce66888cb979ccb", "git_parents": ["032147228a59146854f849ae1a2c94d100ce92c8"], "node": "5184d9b4a3f46d3f97f33858f6d0f4b2370e81d8", "parents": ["c8a3159f870107a22647da7d790159f428dbe4ba"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070879 - Wait for frame construction before considering document speculation rules. r=smaug,dom-core-reviewers\n\nDocument rules can only match against links which are being rendered,\nand we cannot determine this until after their frames have been constructed.\nSo if frames still need to be contructed, delay consider loads until\nafter the next refresh.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330247\n", "files": ["dom/base/SpeculationRuleSet.cpp", "dom/base/SpeculationRuleSet.h", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "dom/base/speculationrules/lib.rs", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/implicit-source.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/inline-speculation-rules-after-stylesheet.https.html.ini"], "git_node": "3f1bba5b59033bb974b40b8b5a9132d3b5855caf", "git_parents": ["1cc1555d62cda96ee5503945cce66888cb979ccb"], "node": "b8256622d5dd1578ee7e0a7ca8156f233b4c76f3", "parents": ["5184d9b4a3f46d3f97f33858f6d0f4b2370e81d8"], "tags": []}, {"author": "Heitor Neiva \u003chneiva@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073508 - Push Fenix APK to the vivo App Store r=releng-reviewers,ahal\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330944\n", "files": ["taskcluster/docs/attributes.md", "taskcluster/docs/kinds.md", "taskcluster/kinds/push-android/kind.yml"], "git_node": "de3520f4a09040e762358f00048e53f65bc41ba3", "git_parents": ["3f1bba5b59033bb974b40b8b5a9132d3b5855caf"], "node": "0d04d91466239284b689a38fa5c80191d09a05d1", "parents": ["b8256622d5dd1578ee7e0a7ca8156f233b4c76f3"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072824 - extend probe 'media.muted_by_content_attribute_runtime'. r=media-playback-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330956\n", "files": ["dom/media/metrics.yaml"], "git_node": "8862df4eaae55e554d8b9d87c288e917ed7c4779", "git_parents": ["de3520f4a09040e762358f00048e53f65bc41ba3"], "node": "a7af87bc8a6b3c672273d3e430c8e913ce63d982", "parents": ["0d04d91466239284b689a38fa5c80191d09a05d1"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 1972935: Replace page content with page URL for summarize r=Mardak,fluent-reviewers,bolsson,omc-reviewers,sachung\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329327\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/genai/GenAIChild.sys.mjs", "browser/components/genai/chat.css", "browser/components/genai/chat.html", "browser/components/genai/chat.js", "browser/components/genai/metrics.yaml", "browser/components/genai/tests/browser/browser_chat_page.js", "browser/components/genai/tests/browser/browser_chat_prompt.js", "browser/components/genai/tests/browser/browser_chat_telemetry.js", "browser/components/genai/tests/browser/browser_genai_actors.js", "browser/locales/en-US/browser/genai.ftl", "toolkit/components/messaging-system/schemas/SpecialMessageActionSchemas/test/browser/browser_sma_summarize_page.js"], "git_node": "22ff99cc8a24bcd4d042d48fc3824cdea7f190c8", "git_parents": ["8862df4eaae55e554d8b9d87c288e917ed7c4779"], "node": "a614fdfecab333d92473894d7c1e231e0adccbc7", "parents": ["a7af87bc8a6b3c672273d3e430c8e913ce63d982"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2078641: Remove update_telemetry.json from the application bundle on update on macOS. r=spohl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331229\n", "files": ["browser/installer/removed-files.in"], "git_node": "371568b66a8e218ce13f13209c63acb58c6afa12", "git_parents": ["22ff99cc8a24bcd4d042d48fc3824cdea7f190c8"], "node": "7ca948cd55be7a238e0cab2dc60c19b0bc6cf882", "parents": ["a614fdfecab333d92473894d7c1e231e0adccbc7"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2052389 - Hide tab close button for pinned tabs when expand on hover is enabled and the sidebar is expanded r=desktop-theme-reviewers,tabbrowser-reviewers,dao\" for causing bc failures @ browser_sidebar_expand_on_hover.js\n\nThis reverts commit dfef775ac7be499a4b66bd17e5b9ec891cd6d34b.\n", "files": ["browser/components/sidebar/tests/browser/browser_sidebar_expand_on_hover.js", "browser/themes/shared/tabbrowser/tabs.css"], "git_node": "1840c01aa474ad45bab1f3a45738835ebad046a8", "git_parents": ["371568b66a8e218ce13f13209c63acb58c6afa12"], "node": "b00d435583cb943be0bbef34f7f3414474d7b499", "parents": ["7ca948cd55be7a238e0cab2dc60c19b0bc6cf882"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078605 - Don't create candidate pairs from binding responses on an obsolete ICE stream. r=webrtc-reviewers,bwc\n\nAfter an ICE restart, a binding response for a pair on the replaced\nstream could learn a peer reflexive candidate and insert a new\npair. It would later fail an assertion as the stream is marked\nobsolete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331206\n", "files": ["dom/media/webrtc/transport/third_party/nICEr/src/ice/ice_candidate_pair.cpp"], "git_node": "f96310b45da26e1fbcad1e48af6bd34cb3b01554", "git_parents": ["1840c01aa474ad45bab1f3a45738835ebad046a8"], "node": "a5c1d6f70ae8c3c7f08d85947188dc3e198b8b8f", "parents": ["b00d435583cb943be0bbef34f7f3414474d7b499"], "tags": []}, {"author": "Hubert B Manilla \u003chmanilla@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077519 - [devtools] Show \"prefetch\" in the initiator column for prefetch requests r=devtools-reviewers,nchevobbe\n\nThis covers both link prefetch and speculative rules prefetch requests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330451\n", "files": ["devtools/client/netmonitor/test/browser_net_initiator.js", "devtools/client/netmonitor/test/browser_net_speculation-rules-prefetch-requests.js", "devtools/client/netmonitor/test/html_cause-test-page.html", "devtools/shared/network-observer/NetworkUtils.sys.mjs"], "git_node": "d97613cacb6a4c9748452cd7277361856022777b", "git_parents": ["f96310b45da26e1fbcad1e48af6bd34cb3b01554"], "node": "1436d72620a29f616f777ca962c0a170cad30fc7", "parents": ["a5c1d6f70ae8c3c7f08d85947188dc3e198b8b8f"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065233 - Part 1: Fix SumoTopic URLs percent-encoding fragment delimiter r=android-reviewers,marcin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328637\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SupportUtils.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/SupportUtilsTest.kt"], "git_node": "339a97ba41f81af71588d6ca5b2d5af9fbcbbb9e", "git_parents": ["d97613cacb6a4c9748452cd7277361856022777b"], "node": "8668795f5c0e6fb32511a987a3db20d94875ada1", "parents": ["1436d72620a29f616f777ca962c0a170cad30fc7"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065233 - Part 2: Add Learn more link to No Devices Available error state r=android-reviewers,android-l10n-reviewers,marcin,parker\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328638\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesDialogFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SupportUtils.kt", "mobile/android/fenix/app/src/main/res/values/strings.xml"], "git_node": "2ccac481d842d4295570aeb5b89d81b2309ed28d", "git_parents": ["339a97ba41f81af71588d6ca5b2d5af9fbcbbb9e"], "node": "e787c2b8ed2f0e6b9a086909ac3b9e8d96756c84", "parents": ["8668795f5c0e6fb32511a987a3db20d94875ada1"], "tags": []}, {"author": "Andrej Glavic \u003caglavic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072297 - Feedback fixes for the perf-regression-triage skill r=kshampur,ai4dev-reviewers,suhaib\n\nA first round of real use turned up three places where the skill's guidance did\nnot match what the tooling does, plus one gap.\n\nThe skill presented treeherder-cli and profiler-cli as the way in with no\nfallback. Neither was installed for the reporter, who completed the triage\nagainst the Treeherder REST API instead.\n\nThe confirmation and verification commands now pass --no-artifact\n\nclose-out.md now ends by telling the user where feedback on the skill goes once\nthey have reached an outcome.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326523\n", "files": [".agents/skills/perf-regression-triage/SKILL.md", ".agents/skills/perf-regression-triage/references/close-out.md", ".agents/skills/perf-regression-triage/references/confirm.md", ".agents/skills/perf-regression-triage/references/iterate.md", ".agents/skills/perf-regression-triage/references/rest-api.md", ".claude/skills/perf-regression-triage/SKILL.md", ".claude/skills/perf-regression-triage/references/close-out.md", ".claude/skills/perf-regression-triage/references/confirm.md", ".claude/skills/perf-regression-triage/references/iterate.md", ".claude/skills/perf-regression-triage/references/rest-api.md"], "git_node": "ca88c3b783052d1f3651688a81bec1ec1507225c", "git_parents": ["2ccac481d842d4295570aeb5b89d81b2309ed28d"], "node": "46c6b2a2bd086b6c1651af39fba8c52a7b42b3f7", "parents": ["e787c2b8ed2f0e6b9a086909ac3b9e8d96756c84"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068690 - Store about:smartpage pages in history r=places-reviewers,mlucks,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320292\n", "files": ["browser/app/profile/firefox.js", "browser/components/about/AboutRedirector.cpp", "browser/components/aiwindow/ui/test/browser/browser_aitab_page.js", "docshell/base/BaseHistory.cpp", "modules/libpref/init/StaticPrefList.yaml", "toolkit/components/places/tests/unit/test_canAddURI.js", "toolkit/components/places/tests/unit/xpcshell.toml"], "git_node": "5e75f24589fd80a19e6a846c9b41f92eddac4baa", "git_parents": ["ca88c3b783052d1f3651688a81bec1ec1507225c"], "node": "afa1cf3b31487b884a24f3b9399124b0fd01104c", "parents": ["46c6b2a2bd086b6c1651af39fba8c52a7b42b3f7"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078388 - Part 1: Put an opaque black backing under protected video layers on macOS. r=bradwerth\n\nA DRM video layer now sits on an opaque black layer of the same size. Window\nsnapshots, such as the one macOS animates for the fullscreen transition or the\nones shown in Mission Control, leave out the capture-protected video layer, so\nthe window background showed through the hole it left. With the backing they\nshow black there instead, which carries no video pixels.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330937\n", "files": ["gfx/layers/NativeLayerCA.h", "gfx/layers/NativeLayerCA.mm"], "git_node": "0130edf0882ec9d78317bab7434774b8842df63a", "git_parents": ["5e75f24589fd80a19e6a846c9b41f92eddac4baa"], "node": "5569231ce958295d116237db4a09e9cc5b781e0e", "parents": ["afa1cf3b31487b884a24f3b9399124b0fd01104c"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078388 - Part 2: Add gtests for the black backing under protected video layers on macOS. r=bradwerth\n\nAdd gtest cases checking that a DRM video layer has an opaque black layer\nunder it covering the same area, and that a non-DRM video layer has none, in\nboth the onscreen and the snapshot layer trees.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330935\n", "files": ["gfx/tests/gtest/TestNativeLayerCA.mm"], "git_node": "7745fbe8a53a76cd97a496fbe70a55e56671752b", "git_parents": ["0130edf0882ec9d78317bab7434774b8842df63a"], "node": "558ddd951413df1ece76ec3be5ea7985760d0e5b", "parents": ["5569231ce958295d116237db4a09e9cc5b781e0e"], "tags": []}, {"author": "Tom Schuster \u003cevilpies@gmail.com\u003e", "branch": "default", "desc": "Bug 1885031 - Implement EXT_clip_control. r=gfx-reviewers,webidl,smaug,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328651\n", "files": ["dom/bindings/Bindings.conf", "dom/canvas/ClientWebGLContext.cpp", "dom/canvas/ClientWebGLContext.h", "dom/canvas/ClientWebGLExtensions.cpp", "dom/canvas/ClientWebGLExtensions.h", "dom/canvas/HostWebGLContext.h", "dom/canvas/WebGLContext.h", "dom/canvas/WebGLContextExtensions.cpp", "dom/canvas/WebGLContextGL.cpp", "dom/canvas/WebGLContextState.cpp", "dom/canvas/WebGLExtensions.cpp", "dom/canvas/WebGLExtensions.h", "dom/canvas/WebGLMethodDispatcher.h", "dom/canvas/WebGLTypes.h", "dom/canvas/test/webgl-mochitest/ensure-exts/test_common.html", "dom/webidl/WebGLRenderingContext.webidl", "gfx/gl/GLBlitHelper.cpp", "gfx/gl/GLContext.cpp", "gfx/gl/GLContext.h", "gfx/gl/GLContextFeatures.cpp", "gfx/gl/GLContextSymbols.h"], "git_node": "b699e4efbbcc26a706d7d23e6c994cc3e2195790", "git_parents": ["7745fbe8a53a76cd97a496fbe70a55e56671752b"], "node": "357880d2a5c44501ce276252c08e53696bf4a401", "parents": ["558ddd951413df1ece76ec3be5ea7985760d0e5b"], "tags": []}, {"author": "python273 \u003cbugzilla@python273.pw\u003e", "branch": "default", "desc": "Bug 1613369 - Use paired nearest rounding for 8-bit alpha conversions. r=gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331332\n", "files": ["dom/canvas/test/mochitest.toml", "dom/canvas/test/test_canvas_png_roundtrip.html", "gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleGeneric.h", "gfx/2d/SwizzleNEON.h", "gfx/tests/gtest/TestSwizzle.cpp"], "git_node": "234b96c3dcc5a4598b7d95f1516a7ed1c8e08975", "git_parents": ["b699e4efbbcc26a706d7d23e6c994cc3e2195790"], "node": "e4ef043f66bc1f48e89d2d2c22e4ed3a92a086bc", "parents": ["357880d2a5c44501ce276252c08e53696bf4a401"], "tags": []}, {"author": "Jeremy Swinarton \u003cjswinarton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067355 - Scroll the active tab into view when its tab group is selected r=daniellegraham,tabbrowser-reviewers,sthompson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326543\n", "files": ["browser/components/tabbrowser/content/tabgroup.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js"], "git_node": "91317e638606a439cab7feea4d0b95741a56f309", "git_parents": ["234b96c3dcc5a4598b7d95f1516a7ed1c8e08975"], "node": "5e5bcf81d2e7c9d66f7736f535fbafff6971d13e", "parents": ["e4ef043f66bc1f48e89d2d2c22e4ed3a92a086bc"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 1950310 - Wrong path to media-plugin-helper.app in macOS artifact build, due to branding. r=ipc-reviewers,mac-reviewers,nika,spohl\n\nFor artifact builds, launch child processes by resolving their executable names using bundle plist files instead of compile-time macros.\n\nFor standard (non-artifact) child process launches, assemble the full relative path from the GRE directory to the child process executable from the existing bundle name and branded name macros.\n\nFor both compile-time macro and plist launches, cache the executable path instead of deriving it each time a child process is launched.\n\nCo-authored-by: Helena \u003chballent@mozilla.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313629\n", "files": ["ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/test/browser/browser_mac_plist_process_launch.js", "ipc/glue/test/browser/browser_mac_plist_process_launch.toml", "ipc/glue/test/browser/moz.build", "ipc/glue/test/gtest/TestMacChildProcessPaths.cpp", "ipc/glue/test/gtest/moz.build", "modules/libpref/init/StaticPrefList.yaml", "modules/libpref/init/all.js", "xpcom/base/nsMacUtilsImpl.cpp", "xpcom/base/nsMacUtilsImpl.h"], "git_node": "6a3cbd8f9d4004ca801e17cecf2a0d89aa601259", "git_parents": ["91317e638606a439cab7feea4d0b95741a56f309"], "node": "34fdec63b04a59645e12e0d0769a410729f3c22b", "parents": ["5e5bcf81d2e7c9d66f7736f535fbafff6971d13e"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078846 - Use MOZ_CRASH instead of MOZ_ASSERT_UNREACHABLE at the end of ToColorSpace2/ToYUVColorSpace to fix GCC -Werror=return-type bustage r=gfx-reviewers,aosmond\n\nBug 2078134 started calling gfx::ToColorSpace2() from widget/gtk/SHMBufSurface.cpp. In non-debug builds MOZ_ASSERT_UNREACHABLE() does nothing, so GCC sees control falling off the end of a non-void function and fails with -Werror=return-type. GCC only reports this in translation units that use the inline function, which is why the problem stayed hidden until now.\n\nBoth ToColorSpace2() and ToYUVColorSpace() now end with MOZ_CRASH(), which is noreturn. The other enum-conversion helpers in gfx/2d/Types.h already do this (FromYUVRangedColorSpace, ToTransferFunction, etc.). ToYUVColorSpace had the same latent problem, so it is fixed here as well.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331331\n", "files": ["gfx/2d/Types.h"], "git_node": "e72d6e8edb8c67aaee5a41d396cf61e9f1127624", "git_parents": ["6a3cbd8f9d4004ca801e17cecf2a0d89aa601259"], "node": "2b430b65ff6bf5e39bd065a6620d2ff421e157c1", "parents": ["34fdec63b04a59645e12e0d0769a410729f3c22b"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2077257 - Improve ThreadSafeWeakPtrHashKey behaviour during an object's destructor, r=xpcom-reviewers,dom-storage-reviewers,emilio,janv\n\nCurrently ThreadSafeWeakPtrHashKey is defined fully in terms of the\nconcrete referenced type, meaning that it cannot work late during an\nobject's lifecycle, after the object's refcount has reached 0 and during\nthe destructor. I expect that removing entries from a table during the\ndestructor is a clear use-case for this type, meaning that it would be\nbetter if we supported this.\n\nThis patch does this by simplifying the handling of `ThreadSafeWeakPtr`\nsuch that it's used directly, and slightly improving the ergonomics of\nthe underlying type so that it can be used directly in this way.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331272\n", "files": ["dom/indexedDB/IDBDatabase.cpp", "dom/indexedDB/IDBDatabase.h", "gfx/2d/2D.h", "gfx/layers/wr/WebRenderBridgeChild.cpp", "gfx/layers/wr/WebRenderBridgeChild.h", "mfbt/ThreadSafeWeakPtr.h", "xpcom/ds/nsHashKeys.h", "xpcom/ds/nsTHashMap.h", "xpcom/tests/gtest/TestHashtables.cpp"], "git_node": "b7b9f961af7b661ef5e0e6a4685b9ebe61c5e453", "git_parents": ["e72d6e8edb8c67aaee5a41d396cf61e9f1127624"], "node": "e8a242ab68d5816a93be30955fe1c48cf7f39ba6", "parents": ["2b430b65ff6bf5e39bd065a6620d2ff421e157c1"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077796 - [devtools] Show quoted @keyframes in Rules view. r=devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331228\n", "files": ["devtools/client/inspector/rules/test/browser_rules_keyframes-rule_01.js", "devtools/client/inspector/rules/test/doc_keyframeanimation.css", "devtools/client/inspector/rules/test/doc_keyframeanimation.html", "devtools/server/actors/page-style.js"], "git_node": "6bcf09ac29b0e02984605d24af4397f254f63b4c", "git_parents": ["b7b9f961af7b661ef5e0e6a4685b9ebe61c5e453"], "node": "218b6071d9b789d71d2406c657b131342f9beea8", "parents": ["e8a242ab68d5816a93be30955fe1c48cf7f39ba6"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 1768489 - Release the screen orientation lock on page hide instead of only from the destructor. r=geckoview-reviewers,edgar,ohall\n\n~ScreenOrientation unlocked whenever the object had ever tried to lock, even though its lock was usually\nreleased long before by unlock(), by leaving fullscreen or by the top browsing context navigating. The cycle\ncollector frees the object at an arbitrary later time, so in a content process shared between pages it\nreleased whichever lock the current page held.\n\nThe case it did cover, late, is a document hidden while it holds a lock. A hidden document never gets the\nfullscreenchange event that releases a fullscreen lock, so a fullscreen iframe that navigates or is removed,\nor a tab closed while fullscreen, keeps the top browsing context locked, and a lock taken without fullscreen\n(chrome, or dom.screenorientation.testing.non_fullscreen_lock_allow) has no other release at all. Release the\nlock from Document::OnPageHide instead, only while the top browsing context still holds a lock, and unlock the\ndevice only when that context is active so a background document cannot release the foreground tab's lock.\n\nLeaving fullscreen and the destructor go through the same release. The object now records whether it holds a\nlock, cleared by every release and by unlock(), so a document that already released its lock cannot release\nanother document's lock when it is hidden or destroyed. A fullscreen exit in an inactive tab no longer unlocks\nthe device either.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328487\n", "files": ["dom/base/Document.cpp", "dom/base/ScreenOrientation.cpp", "dom/base/ScreenOrientation.h", "dom/base/test/fullscreen/browser.toml", "dom/base/test/fullscreen/browser_fullscreen-orientation-lock.js", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/OrientationDelegateTest.kt"], "git_node": "f3872690fbc03dac68ec23166223627cbbb6be0d", "git_parents": ["6bcf09ac29b0e02984605d24af4397f254f63b4c"], "node": "371f360172ce31ba7da9018fc1ac20a49a6d46e5", "parents": ["218b6071d9b789d71d2406c657b131342f9beea8"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2024073 - Stop running karma in newtab CI and report Jest coverage instead. r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330021\n", "files": ["browser/extensions/newtab/bin/try-runner.js", "browser/extensions/newtab/jest.config.mjs", "taskcluster/kinds/source-test/node.yml"], "git_node": "28ecce56c75bd7f303f51ad0d18b49e5e74c80b2", "git_parents": ["f3872690fbc03dac68ec23166223627cbbb6be0d"], "node": "f65874e2cced6a38a980fd20b1321262d146df58", "parents": ["371f360172ce31ba7da9018fc1ac20a49a6d46e5"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2024073 - Remove Karma tests infrastructure. r=thecount,frontend-codestyle-reviewers,ai4dev-reviewers,suhaib,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330240\n", "files": [".prettierignore", "browser/extensions/newtab/.eslintrc.mjs", "browser/extensions/newtab/AGENTS.md", "browser/extensions/newtab/content-src/activity-stream.jsx", "browser/extensions/newtab/docs/index.md", "browser/extensions/newtab/docs/v2-system-addon/unit_testing_guide.md", "browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/package-lock.json", "browser/extensions/newtab/package.json", "browser/extensions/newtab/test/schemas/base_ping.schema.json", "browser/extensions/newtab/test/schemas/pings.js", "browser/extensions/newtab/test/schemas/session_ping.schema.json", "browser/extensions/newtab/test/schemas/user_event_ping.schema.json", "browser/extensions/newtab/test/unit/unit-entry.js", "browser/extensions/newtab/test/unit/utils.js", "browser/extensions/newtab/test/vendor/react-dom-test-utils.js", "browser/extensions/newtab/yamscripts.yml", "tools/lint/hooks_newtab.py", "tools/rewriting/Generated.txt"], "git_node": "0a253a03a81ed1c089358e7522c115b05eb591f2", "git_parents": ["28ecce56c75bd7f303f51ad0d18b49e5e74c80b2"], "node": "51e8ca9cd38a30c4f7b315d24dff74a55326a690", "parents": ["f65874e2cced6a38a980fd20b1321262d146df58"], "tags": []}, {"author": "Alan Liu \u003chaoping.liu@amd.com\u003e", "branch": "default", "desc": "Bug 2030272 - Skip redundant GPU buffer texture uploads when the data is unchanged r=gfx-reviewers,gw\n\nDuring Wayland direct scanout a frame is published every vsync because\nthe video surface changed, while WebRender itself draws nothing and\nthese buffers are rebuilt identically from the frame arenas.\nupdate_gpu_buffer_texture uploads frame.gpu_buffer_f and\nframe.gpu_buffer_i unconditionally, creating the TextureUploader probes\nthe PBO pool fences with client_wait_sync, which flushes the GPU command\nstream on AMD/Mesa, so this costs up to two GPU flushes per frame even\nwhen nothing changed.\n\nThe solution is to retain a copy of the last uploaded data and skip the\nupload, and so the uploader, when it matches. Buffers larger than one\ntexture row are treated as always dirty, which bounds both the retained\ncopy and the comparison at 16kB per buffer. The copy is cleared\neverywhere the backing texture is dropped - the grow path in\nupdate_gpu_buffer_texture, the too-large eviction heuristic and\ntrim_upload_buffers - so a freshly created texture is always uploaded to\nrather than being left undefined. Comparing the blocks rather than\nhashing them keeps this exact, and means a buffer containing NaN simply\ncounts as changed, which errs towards uploading. The comparison also\nstays correct across apply_deferred_uv_copies, which rewrites\ngpu_buffer_f in place before the frame is drawn.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324579\n", "files": ["gfx/wr/webrender/src/renderer/gpu_buffer.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "c69052798b391ce7dddd408bedd3eeea869ecf36", "git_parents": ["0a253a03a81ed1c089358e7522c115b05eb591f2"], "node": "a0f825c50cf929a96a64ed09fd37a97aee8a13c8", "parents": ["51e8ca9cd38a30c4f7b315d24dff74a55326a690"], "tags": []}, {"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2077320 - Update CWTS dialog title for per-device syncing r=settings-reviewers,fluent-reviewers,akulyk,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330289\n", "files": ["browser/components/preferences/dialogs/syncChooseWhatToSync.js", "browser/components/preferences/tests/sync/browser_sync_chooseWhatToSync.js", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "292baf4289814ab549c3a92492048115e10f72c6", "git_parents": ["c69052798b391ce7dddd408bedd3eeea869ecf36"], "node": "bcab6c2b9d4609f475d2691a51d26e32cf3567bd", "parents": ["a0f825c50cf929a96a64ed09fd37a97aee8a13c8"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074673 - Tokenize AITab URLs r=omarg,cmurray\n\nAITab tool call should use URL tokens for images and links and prevent hallucinations\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328294\n", "files": ["browser/components/aiwindow/models/ChatUtils.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab_generation.js", "browser/components/aiwindow/models/tests/xpcshell/test_aitab_parse.js", "browser/components/aiwindow/ui/modules/UrlTokenizer.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_UrlTokenizer.js"], "git_node": "5b815abb5e103cd7a984cd2f37f3087815329032", "git_parents": ["292baf4289814ab549c3a92492048115e10f72c6"], "node": "d08a066c23d297e3c5b944a89935e1d4cbfdc13e", "parents": ["bcab6c2b9d4609f475d2691a51d26e32cf3567bd"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077260 - Declare the store property on newtab feeds so that tsc knows about the Store assigned by Store.initFeed r=reemhamz\n\nStore.initFeed sets feed.store after constructing each feed, which accounted for 355 of the 626 tsc errors when type-checking newtab/lib. Store now assigns dispatch, getState and subscribe explicitly instead of in a loop, so the Store type the feeds declare includes them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330272\n", "files": ["browser/extensions/newtab/lib/AboutPreferences.sys.mjs", "browser/extensions/newtab/lib/AdsFeed.sys.mjs", "browser/extensions/newtab/lib/DiscoveryStreamFeed.sys.mjs", "browser/extensions/newtab/lib/ExternalComponentsFeed.sys.mjs", "browser/extensions/newtab/lib/HighlightsFeed.sys.mjs", "browser/extensions/newtab/lib/InferredPersonalizationFeed.sys.mjs", "browser/extensions/newtab/lib/NewTabAttributionFeed.sys.mjs", "browser/extensions/newtab/lib/NewTabInit.sys.mjs", "browser/extensions/newtab/lib/NewTabMessaging.sys.mjs", "browser/extensions/newtab/lib/PlacesFeed.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/lib/SectionsLayoutFeed.sys.mjs", "browser/extensions/newtab/lib/SectionsManager.sys.mjs", "browser/extensions/newtab/lib/SmartShortcutsFeed.sys.mjs", "browser/extensions/newtab/lib/StartupCacheInit.sys.mjs", "browser/extensions/newtab/lib/Store.sys.mjs", "browser/extensions/newtab/lib/SystemTickFeed.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/lib/TopStoriesFeed.sys.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/lib/WeatherFeed.sys.mjs", "browser/extensions/newtab/lib/WebNotificationsFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/ListsFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PictureOfTheDayFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/PrivacyFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/RecentSearchesFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/StocksFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/TimerFeed.sys.mjs"], "git_node": "6759a33d25a1c31242bae18f4663688dc7f55ec0", "git_parents": ["5b815abb5e103cd7a984cd2f37f3087815329032"], "node": "7ac38732f87bd6d556d83bc7d76e3f27cfa754e6", "parents": ["d08a066c23d297e3c5b944a89935e1d4cbfdc13e"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077260 - Fix TypeScript errors for lazy.logConsole (TS2339) in newtab/lib by moving it into XPCOMUtils.declareLazy r=reemhamz\n\nThe three files that create lazy with XPCOMUtils.declareLazy added logConsole afterwards with ChromeUtils.defineLazyGetter, so the inferred type of lazy did not include it and all 22 uses failed to type-check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330265\n", "files": ["browser/extensions/newtab/lib/ExternalComponentsFeed.sys.mjs", "browser/extensions/newtab/lib/RemoteRenderer.sys.mjs", "browser/extensions/newtab/lib/actors/MozNewTabRemoteRendererProtocolParent.sys.mjs"], "git_node": "8a2a73960a6ea05594b4bdc6fa6495fe6b12ecf0", "git_parents": ["6759a33d25a1c31242bae18f4663688dc7f55ec0"], "node": "6a68a80fe2c11746727c34f62113280b4e25660a", "parents": ["7ac38732f87bd6d556d83bc7d76e3f27cfa754e6"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077260 - Fix TypeScript errors for Prefs and DefaultPrefs methods inherited from Preferences (TS2339, TS2417) in newtab/lib r=reemhamz\n\nPreferences.sys.mjs sets Preferences.prototype to Preferences itself, so tsc saw get, set, reset and the rest only as static methods and none of the 58 instance calls on Prefs and DefaultPrefs type-checked. Both classes now extend a constructor-typed cast of Preferences that also makes _branchStr public, since PrefsFeed reads it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330266\n", "files": ["browser/extensions/newtab/lib/ActivityStreamPrefs.sys.mjs"], "git_node": "e83800b04d31d58a1c399af9b3aae69a3433a5ec", "git_parents": ["8a2a73960a6ea05594b4bdc6fa6495fe6b12ecf0"], "node": "287d16821d619ab8dc1ee2c8cf48918b1186af35", "parents": ["6a68a80fe2c11746727c34f62113280b4e25660a"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077260 - Fix TypeScript errors for JSDoc @param tags on nested properties whose parent is not documented (TS8032) in newtab/lib r=reemhamz\n\ntsc requires a @param for event.data, action.data or options before it accepts tags for their properties. The new options tags are optional because callers omit the argument, and fetchHighlights now also documents the options.isStartup it reads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330267\n", "files": ["browser/extensions/newtab/lib/HighlightsFeed.sys.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/ListsFeed.sys.mjs", "browser/extensions/newtab/lib/Widgets/TimerFeed.sys.mjs", "browser/extensions/newtab/lib/actors/NewTabAttributionParent.sys.mjs"], "git_node": "c83b8e28e31a287d72c713676754bd313f52925c", "git_parents": ["e83800b04d31d58a1c399af9b3aae69a3433a5ec"], "node": "0fdb171074003fbdaac44be68a3b7678ea547fc9", "parents": ["287d16821d619ab8dc1ee2c8cf48918b1186af35"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077260 - Fix TypeScript errors for duplicate JSDoc @returns tags (TS1223) in newtab/lib FeatureModel r=reemhamz\n\ncomputeCTRInterestVectors and computeInterestVectors documented each property of their result object with its own @returns tag, which tsc rejects, so each now has one @returns with an object type. This also corrects inferredInterest to inferredInterests, the key computeCTRInterestVectors actually returns.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330268\n", "files": ["browser/extensions/newtab/lib/InferredModel/FeatureModel.sys.mjs"], "git_node": "8f232a5747ad577159347b84d80742c4c9deef16", "git_parents": ["c83b8e28e31a287d72c713676754bd313f52925c"], "node": "c37d0c6830fd462ddb8aede691dac51ec455838a", "parents": ["0fdb171074003fbdaac44be68a3b7678ea547fc9"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077260 - Fix TypeScript error for a JSDoc line starting with \"@ @param\" instead of \"* @param\" (TS1003) in newtab/lib Screenshots r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330269\n", "files": ["browser/extensions/newtab/lib/Screenshots.sys.mjs"], "git_node": "189faeafbd17bbd522040b577be30a34ed077847", "git_parents": ["8f232a5747ad577159347b84d80742c4c9deef16"], "node": "62441700d6d0f12aa3878a9c4f5c41cebec16cfe", "parents": ["c37d0c6830fd462ddb8aede691dac51ec455838a"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077260 - Remove the JSDoc @return tag from the ActivityStreamMessageChannel constructor since tsc does not allow a type annotation on a constructor (TS1093) r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330270\n", "files": ["browser/extensions/newtab/lib/ActivityStreamMessageChannel.sys.mjs"], "git_node": "65c0e9abf2578094c20a23e5594a19500cd75108", "git_parents": ["189faeafbd17bbd522040b577be30a34ed077847"], "node": "db34f2403d1d290c55a8a197debaaf36181d1d50", "parents": ["62441700d6d0f12aa3878a9c4f5c41cebec16cfe"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077260 - Fix TypeScript \"cannot find name\" errors (TS2304, TS2552) for JSDoc types defined in other modules in newtab/lib r=reemhamz\n\nThe MozAds* types, AboutNewTabComponentRegistry, ObjectStore, DeferredTask and RemoteSettingsClient are now brought in with @import, and Store's undefined Action type becomes object as in the earlier TS2304 fixes. Resolving AboutNewTabComponentRegistry and ObjectStore exposes six TS2339 errors those types were hiding: the configuration typedef lacks actors, and wrapMethods adds ObjectStore.get at runtime.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330271\n", "files": ["browser/extensions/newtab/lib/AdsClient.sys.mjs", "browser/extensions/newtab/lib/ExternalComponentsFeed.sys.mjs", "browser/extensions/newtab/lib/NewTabAttributionService.sys.mjs", "browser/extensions/newtab/lib/RemoteRenderer.sys.mjs", "browser/extensions/newtab/lib/Store.sys.mjs"], "git_node": "3624ba83be226778ffd72d423fde437eb0ad25f2", "git_parents": ["65c0e9abf2578094c20a23e5594a19500cd75108"], "node": "b303210646277ca7cc2235d4e7d64a000b9e3bb2", "parents": ["db34f2403d1d290c55a8a197debaaf36181d1d50"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\naf -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nan -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nar -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nast -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\naz -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nbe -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nbg -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nbn -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nbo -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nbqi -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nbr -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nbrx -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nbs -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nca -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nca-valencia -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\ncak -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nckb -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\ncs -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\ncy -\u003e dfe03f05844c840a6d5b1ba7dbd87e592324392a\nda -\u003e dfe03f05844c840a6d5b1b