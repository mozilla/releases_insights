32e91\nsl -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nson -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nsq -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nsr -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nsv-SE -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nta -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nte -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nth -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\ntl -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\ntr -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\ntrs -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nuk -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nur -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nuz -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nvi -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nwo -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nxh -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nzam -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nzh-CN -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\nzh-TW -\u003e 91b3a97782d94927461e76d74ea7eed107032e91\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "536f1aca25735b9fd57115ffa5fc756438f839d1", "git_parents": ["561cf197bf7e13d28a250820c79b1b5127c9aed7"], "node": "1de57ce0aec76180d594ce5480f7180904475d5d", "parents": ["82bc0567b0455f9f4996343b394aacba17c4d6b0"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066086 - Fix hide tabs and sidebar logic and refactor sidebar state logic r=sfoster,jsudiaman,sidebar-reviewers,nsharpley,sessionstore-reviewers,kcochrane\" for causing failures at browser_ext_sidebarAction.js.\n\nThis reverts commit 101266817b777588b5aaf85159e852da38975093.\n", "files": ["browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/sessionstore/session.schema.json", "browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/docs/index.md", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/browser/browser_adopt_sidebar_from_opener.js", "browser/components/sidebar/tests/browser/browser_customize_sidebar.js", "browser/components/sidebar/tests/browser/browser_launcher_hidden_restore.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_states.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/components/sidebar/tests/unit/test_sidebar_state.js"], "git_node": "e53e56b9677a49dcfaef1d2681dc92893e30523e", "git_parents": ["536f1aca25735b9fd57115ffa5fc756438f839d1"], "node": "e2e23db0785afbf6a73a39cc2ec72a65f0283155", "parents": ["1de57ce0aec76180d594ce5480f7180904475d5d"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053151 - Match the Edit Clocks panel layout to the intended design. r=reemhamz\n\nThe Edit Clocks panel floated over the widget as a fixed 332 by 276 pixel card with its own border and drop shadow. The clock rows stayed visible behind it. Rows without a nickname sat top aligned, so the city name did not line up with the edit and remove icons that appear on hover.\n\nThe panel now fills the widget card edge to edge. The rows underneath are hidden while it is open, which is how the Weather widget already swaps in its own subviews. Every row gets a fixed height so nicknamed and plain rows stay uniform and vertically centered. The city text is indented to leave room for the drag handle that comes later. The back control is a left arrow that mirrors in right to left locales. A clock with no nickname no longer renders the subtitle element at all, instead of rendering it empty with its Fluent identifier stripped off, which is what left the stray blank line.\n\nThe panel class is shared, so the Add Clock form fills the card the same way. That is the same behavior Maxx asked for in the earlier comment on this revision.\n\nNo new strings. No telemetry, preference or feed changes. The generated bundle and stylesheet files that were part of the first diff are gone, since bug 2025793 moved them to the object directory.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313066\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/EditClocksPanel.jsx", "browser/extensions/newtab/content-src/components/Widgets/Clocks/_Clocks.scss", "browser/extensions/newtab/test/jest/content-src/components/Widgets/EditClocksPanel.test.jsx"], "git_node": "e36fde7713a75f81c95138c911c19287344968df", "git_parents": ["e53e56b9677a49dcfaef1d2681dc92893e30523e"], "node": "5506a8af6b0d3a639913b19e57a5b46e9035b045", "parents": ["e2e23db0785afbf6a73a39cc2ec72a65f0283155"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2073596 - Lock remote.policy.disabled with DisableDeveloperTools. r=jmendez,webdriver-reviewers,Sasha\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328163\n", "files": ["browser/components/enterprisepolicies/Policies.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser.toml", "browser/components/enterprisepolicies/tests/browser/browser_policy_disable_developer_tools.js", "browser/components/enterprisepolicies/tests/browser/disable_developer_tools/browser.toml", "browser/components/enterprisepolicies/tests/browser/disable_developer_tools/browser_policy_disable_developer_tools.js", "browser/components/enterprisepolicies/tests/browser/disable_developer_tools/config_disable_developer_tools.json", "browser/components/enterprisepolicies/tests/moz.build", "remote/components/Marionette.sys.mjs", "remote/components/RemoteAgent.sys.mjs", "remote/components/moz.build", "remote/components/test/xpcshell/test_policy_disabled.js", "remote/components/test/xpcshell/xpcshell.toml"], "git_node": "c3f5e559c277bb3291ddee7ac938d2dfee3a7e34", "git_parents": ["e36fde7713a75f81c95138c911c19287344968df"], "node": "ac94bdd342df3fcc4bac8e8b8fed11757c073340", "parents": ["5506a8af6b0d3a639913b19e57a5b46e9035b045"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2067286 - Wire removal from autocomplete dropdown for saved addresses. r=mtigley,dimi\n\n`#confirmAddressRemoval(guid)` consumes the boolean `AutocompleteRemoveRecord.confirmRemoval`\nalready returned and removes the address, so confirming the prompt deletes the record\ninstead of only dismissing the dialog. `chromeWindow` is read before the prompt, which\ncan destroy the actor.\n\nThe guid goes straight to `gFormAutofillStorage.addresses.remove` with no lookup first.\nIt arrives in `fillMessageData`, which `ProfileAutoCompleteResult` authors in the content\nprocess, so it is untrusted, but an address carries no origin scope the way a login does,\nso there is no narrower set to resolve it against. Both the JSON and Rust stores warn and\nreturn for a guid they do not hold, which covers a forged guid and a record removed while\nthe prompt was up alike.\n\n`moreActionsSecondaryAction` takes a `guid` and puts `fillMessageData: { guid }` on the\ndelete item, replacing a delete action that named a message but carried no data. Both the\naddress and payment-method rows pass `profile.guid`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326300\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_secondary_action.js", "toolkit/components/formautofill/FormAutofillParent.sys.mjs", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs"], "git_node": "126f1102337c929aa775eaf9ea81376ed42f6cf8", "git_parents": ["c3f5e559c277bb3291ddee7ac938d2dfee3a7e34"], "node": "feb5f811e3e7b53fff4759e4886b84bd691689a0", "parents": ["ac94bdd342df3fcc4bac8e8b8fed11757c073340"], "tags": []}, {"author": "Titouan Thibaud \u003ctthibaud@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068915 - Create feature flag for Account Sync decoupling Milestone 1. r=android-reviewers,avirvara,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324019\n", "files": ["mobile/android/fenix/app/nimbus.fml.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/SecretSettingsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/main/res/values/preference_keys.xml", "mobile/android/fenix/app/src/main/res/values/static_strings.xml", "mobile/android/fenix/app/src/main/res/xml/secret_settings_preferences.xml"], "git_node": "3475d9ed106f43a29cb0319b306e0149338bf247", "git_parents": ["126f1102337c929aa775eaf9ea81376ed42f6cf8"], "node": "0102d038331841f23babf3ac9c0c1a33cbaa3545", "parents": ["feb5f811e3e7b53fff4759e4886b84bd691689a0"], "tags": []}, {"author": "Titouan Thibaud \u003ctthibaud@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068915 - Create a new layout for the new Account Settings UI. r=android-reviewers,cbect\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324267\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/account/AccountSettingsFragment.kt", "mobile/android/fenix/app/src/main/res/xml/account_settings_preferences.xml", "mobile/android/fenix/app/src/main/res/xml/account_settings_preferences_old_ui.xml"], "git_node": "6c7e78670bc2ae5c8732320e7514569f3e372324", "git_parents": ["3475d9ed106f43a29cb0319b306e0149338bf247"], "node": "70e121e600775b30de6d625b0686f38931a6949b", "parents": ["0102d038331841f23babf3ac9c0c1a33cbaa3545"], "tags": []}, {"author": "Titouan Thibaud \u003ctthibaud@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068923 - Move \"Device name\" to the bottom of Account Settings screen. r=android-reviewers,android-l10n-reviewers,parker,cbect\n\nDifferential Revision: htt