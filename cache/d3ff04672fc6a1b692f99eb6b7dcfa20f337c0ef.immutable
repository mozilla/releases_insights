554f515a07b1b4f59b8f86", "4e76a818b8a6d7a14d7712040e05dd26c6f6f4e2", "d253d35dffa61acbd7a6e38e5551be027ed5cbd9", "e3bfd0ed8f27c348c7d7b0ab2bca3c2bf5270426", "e907acb8490ed485439e414dc84948a9e326e6ff", "8646b8c704ff7dc37d7d94941e9eab026c8556f2", "273097f027b7d502639fb2e9d52e63626e305cb2", "8ab68013c2e286cb6f61cd46e8ab46e56f9a1dec", "068cf1d361bd926df458dd3cc5975305f3934d61", "c545d49beacfa113722c357dc7549c69f5064b5e", "f28a07968355963a7edbedf2d0d6dfea5a081bce", "560a08cbc86b45da1c455247f99d05e94319c6d6", "f8fac4b17db73c7d2655efdf20a706607ef21115", "8398cba0e7dfa2edf846143f5d70d66e96edd3b7", "d0e62d55e8d3119e3a193b70fde006c581a6fd3e", "8c3c8aa3d5df809de6ebeda10abf3d70fc565b5e", "f1d5bcb34d3f2405107080a1189400ebb3d3502b", "4bb61966096e5a6bb44f57bb2b4d3e69d1ebc235", "c769e5f04e1858f539585f5d55cd84c76572b30f", "0bf2928d79362c8c1560a9b9a66e441d763908a1", "e180ca92dfcb0de0a7e1a6bf557e46b8df027ba6", "9f5b576c1884379ac7ae78921f49c480732dc91f", "48c8300fc15635ca080f7feceea2509da41b5c87", "fd869173791db81ab038a0427890141a4990eb73", "2569aa46fa5d604651d358ea650867b0f7eb01a7", "e7bd7614de77a7ddf27aca2f4f04c5b9ad3102b4", "cf90232f2f7c227ef543c1a6e019a1ab8a47fcad", "60f3a1fea12c548ce3d8b2033cce093959d96704", "87f2ebe864e87c13a33066a0a1c7a6e247c3bc00", "84e401eabf5c5755bf4274ab7eb05416795e558d", "4c7e12f307de8b5ac4009161d826d9524562699a", "f0ce2dc6c1dbf8259f09627d8ea4a308e07a461c"], "user": "pstanciu@mozilla.com"}, "45460": {"changesets": [{"author": "Charles Zhang \u003ccsalinezh@gmail.com\u003e", "branch": "default", "desc": "Bug 1970969 - Use root scrollable dimensions for find scrollbar marks. r=emilio\n\nFind scrollbar marks were introduced in bug 259640. Both bug 1694027 and\nbug 1695183 attempted to correct their positioning by changing the order\nof elements used to query scroll dimensions. However, the body can have\na non-zero size while excluding content that expands the root scrollable\narea.\n\nUse the root scroll-frame dimensions obtained from the helper method\n_getWindowDimensions instead. Its formula would be\nscrollHeight = document.scrollingElement.clientHeight + (window.scrollMaxY - window.scrollMinY)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329078\n", "files": ["toolkit/content/tests/browser/browser_findbar_marks.js", "toolkit/modules/FinderHighlighter.sys.mjs"], "git_node": "4934f369d0f93d0904cf5488bac07b25e1febf8d", "git_parents": ["f0ce2dc6c1dbf8259f09627d8ea4a308e07a461c"], "node": "ac4ef73431f839f2a5a610717a25665361c17c9a", "parents": ["6085882736fd8db1ec2d6d826a8b14613917045e"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1842111 - Rename CPOW timeout code in ContentParent.cpp and ProcessHangMonitor.{cpp/h} r=ipc-reviewers,mccr8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323852\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ProcessHangMonitor.cpp", "dom/ipc/ProcessHangMonitor.h"], "git_node": "a9474f0dc7b250b4ddc4333b280bbe8c5fee6e5f", "git_parents": ["4934f369d0f93d0904cf5488bac07b25e1febf8d"], "node": "bb1377b53385595eef43b30171e4f08d4be7aa01", "parents": ["ac4ef73431f839f2a5a610717a25665361c17c9a"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-sl/strings.xml", "mobile/android/android-components/components/feature/downloads/src/main/res/values-lv/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-es-rCL/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-fr/strings.xml", "mobile/android/android-components/co