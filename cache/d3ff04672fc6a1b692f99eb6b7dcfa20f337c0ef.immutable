e/format_benchmark.cc", "third_party/abseil-cpp/absl/time/format_test.cc", "third_party/abseil-cpp/absl/time/internal/cctz/include/cctz/time_zone.h", "third_party/abseil-cpp/absl/time/internal/cctz/src/time_zone_format.cc", "third_party/abseil-cpp/absl/time/internal/cctz/src/time_zone_format_test.cc", "third_party/abseil-cpp/absl/time/internal/test_util.cc", "third_party/abseil-cpp/absl/time/internal/test_util.h", "third_party/abseil-cpp/absl/time/simulated_clock_test.cc", "third_party/abseil-cpp/absl/time/time.cc", "third_party/abseil-cpp/absl/time/time.h", "third_party/abseil-cpp/absl/time/time_benchmark.cc", "third_party/abseil-cpp/absl/time/time_test.cc", "third_party/abseil-cpp/absl/types/BUILD.bazel", "third_party/abseil-cpp/absl/types/BUILD.gn", "third_party/abseil-cpp/absl/types/CMakeLists.txt", "third_party/abseil-cpp/absl/types/any_span_test.cc", "third_party/abseil-cpp/absl/types/compare_test.cc", "third_party/abseil-cpp/absl/types/source_location.h", "third_party/abseil-cpp/absl/types/span_test.cc", "third_party/abseil-cpp/convert_bazel_to_gn.py", "third_party/abseil-cpp/patches/0001-Undeprecate-deprecated.patch", "third_party/abseil-cpp/patches/0003-delete-static-initializer-in-stacktrace.patch", "third_party/abseil-cpp/patches/0004-string-view-transitive-includes", "third_party/abseil-cpp/symbols_arm64_dbg.def", "third_party/abseil-cpp/symbols_arm64_dbg_cxx23.def", "third_party/abseil-cpp/symbols_arm64_rel.def", "third_party/abseil-cpp/symbols_arm64_rel_cxx23.def", "third_party/abseil-cpp/symbols_x64_dbg.def", "third_party/abseil-cpp/symbols_x64_dbg_cxx23.def", "third_party/abseil-cpp/symbols_x64_rel.def", "third_party/abseil-cpp/symbols_x64_rel_asan.def", "third_party/abseil-cpp/symbols_x64_rel_asan_cxx23.def", "third_party/abseil-cpp/symbols_x64_rel_cxx23.def", "third_party/abseil-cpp/symbols_x86_dbg.def", "third_party/abseil-cpp/symbols_x86_dbg_cxx23.def", "third_party/abseil-cpp/symbols_x86_rel.def", "third_party/abseil-cpp/symbols_x86_rel_cxx23.def"], "git_node": "66cc22c1e0d08d641de8b6feb7da001d00f79a8f", "git_parents": ["b141f01c580a8f060d1c42d12142909d3012f043"], "node": "8d461d7ef416081a60ab0773cafed432ab29bdb9", "parents": ["2a7e9ac797d5e48b24858d9484e5b511ba083262"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075302 - regenerate abseil-cpp moz.build files. r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328904\n", "files": ["third_party/abseil-cpp/absl/debugging/bounded_utf8_length_sequence_gn/moz.build", "third_party/abseil-cpp/absl/debugging/decode_rust_punycode_gn/moz.build", "third_party/abseil-cpp/absl/debugging/demangle_rust_gn/moz.build", "third_party/abseil-cpp/absl/debugging/utf8_for_code_point_gn/moz.build", "third_party/abseil-cpp/moz.build"], "git_node": "333e34ad44b90448ff0dbde56c9dff384e7dc550", "git_parents": ["66cc22c1e0d08d641de8b6feb7da001d00f79a8f"], "node": "a074e2f370d10622743772e08392e3700b884b5c", "parents": ["8d461d7ef416081a60ab0773cafed432ab29bdb9"], "tags": []}, {"author": "Matthew Gaudet \u003cmgaudet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072735 - Enable the SafeResolve jit-tests on all channels r=nliu\n\nNow that SafeResolve is riding the trains (bug 2071285), expose the testing function on all channels and drop the skip guards from all four SafeResolve tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326724\n", "files": ["js/src/builtin/TestingFunctions.cpp", "js/src/jit-test/tests/promise/safe-resolve-latching.js", "js/src/jit-test/tests/promise/safe-resolve-non-thenable.js", "js/src/jit-test/tests/promise/safe-resolve-thenables.js", "js/src/jit-test/tests/promise/safe-resolve-ticks.js"], "git_node": "0fb37c84efb5d1300be896615d658f2607b0bec3", "git_parents": ["333e34ad44b90448ff0dbde56c9dff384e7dc550"], "node": "51495683b1d503dc17a645da4eb39b2cbdc97f6f", "parents": ["a074e2f370d10622743772e08392e3700b884b5c"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2074193 - HTMLOptionsCollection could use similar setup to SetAttr when it comes to script blockers, r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328024\n", "files": ["dom/html/HTMLOptionElement.cpp", "dom/html/HTMLOptionsCollection.cpp", "dom/html/HTMLSelectElement.cpp", "dom/prototype/PrototypeDocumentContentSink.cpp", "dom/xml/nsXMLContentSink.cpp"], "git_node": "e2a53ef342d1fb1a22ae7efd214b186811950b98", "git_parents": ["0fb37c84efb5d1300be896615d658f2607b0bec3"], "node": "69d771aa39e2c0239253dc0e6295469e134a8360", "parents": ["51495683b1d503dc17a645da4eb39b2cbdc97f6f"], "tags": []}, {"author": "Micah Killoran \u003cmtigley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067287 - Wire removal from autocomplete dropdown for saved payment methods. r=dimi,credential-management-reviewers,kalenlu\n\n`#confirmCreditCardRemoval(guid)` consumes the boolean\n`AutocompleteRemoveRecord.confirmRemoval` already returned and removes the card,\nso confirming the prompt deletes the record instead of only dismissing the\ndialog. `topChromeWindow` is read before the prompts, which can destroy the\nactor.\n\nRemoval never reads the card number, so `verifyUserOSAuth` is asked not to\ngenerate an OS key store secret. Where `nsIOSKeyStore` falls back to NSS that\nprobe goes through the internal PKCS#11 slot, which authenticates, and so can\nraise a primary password prompt -- and fail -- over a key this flow never uses.\n`CreditCardsBase` does not override `AutofillRecords.remove`, and the Rust\nadapter's `_delete` is `deleteCreditCard`, so neither store decrypts here and a\ncard whose ciphertext no longer opens stays removable. A test pins that by\nfailing every `OSKeyStore.decrypt` for the duration of a removal; rotating the\nreal store label instead would outlive the file and break the next one to save\na card.\n\nThe guid goes straight to `gFormAutofillStorage.creditCards.remove` with no\nlookup first. It arrives in `fillMessageData`, which `ProfileAutoCompleteResult`\nauthors in the content process, so it is untrusted, but a card carries no origin\nscope the way a login does, so there is no narrower set to resolve it against,\nand OS auth gates the flow ahead of it. Both stores warn and return for a guid\nthey do not hold, which covers a forged guid and a card removed while the\nprompts were up alike.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327194\n", "files": ["browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/components/formautofill/FormAutofillParent.sys.mjs"], "git_node": "53aa083e2fa22313537aeba55f8e9f595e243508", "git_parents": ["e2a53ef342d1fb1a22ae7efd214b186811950b98"], "node": "81227568583def018fbfd791eecfa7229e93576f", "parents": ["69d771aa39e2c0239253dc0e6295469e134a8360"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074406 - Preserve case when unwrapping about:reader URLs in WebsiteFilter. r=jmendez\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328893\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js"], "git_node": "79fa5a4a95b23043772f60615d77b6d1e7b4d5cb", "git_parents": ["53aa083e2fa22313537aeba55f8e9f595e243508"], "node": "a09a00a6216690438345871345095eb1acf89222", "parents": ["81227568583def018fbfd791eecfa7229e93576f"], "tags": []}, {"author": "Nick Grato \u003cngrato@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073511 - Clear the stored smartbar draft on every commit path so a committed slash command doesn't reappear after same-tab navigation r=flozia\n\nWhen a slash command such as `/watch` is committed in the Smart Window smartbar, `AIWindow.#handleSmartbarCommit` calls `clearSmartbarInput()` (which empties the editor silently, firing no `input` event) and then returns early as soon as `AgentUI.tryHandleCommand` handles the command. That early return happens before `submitChatMessage` dispatches the `ai-window:smartbar-input` reset with `EMPTY_SMARTBAR_INPUT_STATE`, so the per-tab draft recorded by `AIWindowTabStatesManager.#onSmartbarInput` still holds the command text. On the next same-tab navigation, `AIWindowTabStatesManager` re-applies that draft via `updateSidebarInput` -\u003e `updateInput`, and the command reappears in the smart bar (and can be re-submitted accidentally).\n\nFix: move the `ai-window:smartbar-input` / `EMPTY_SMARTBAR_INPUT_STATE` reset out of `submitChatMessage` and dispatch it right after `clearSmartbarInput()` in `#handleSmartbarCommit`. That is the single choke point where the editor is cleared for every commit action, so the stored draft is now reset for the agent-command, chat, search, and navigate paths alike, rather than only for the plain-chat branch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327536\n", "files": ["browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_smartbar_tab_state.js"], "git_node": "120d52747df02e64345a54532c78b09eb58ea93d", "git_parents": ["79fa5a4a95b23043772f60615d77b6d1e7b4d5cb"], "node": "6acbcb5d671f5093d1d93d8ed247f695390432cd", "parents": ["a09a00a6216690438345871345095eb1acf89222"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2075399: Remove one remaining usage of now-removed pref 'dom.viewTransitions.enabled'. r=layout-reviewers,firefox-style-system-reviewers,emilio\n\nThe pref was removed in bug 2065065.  This one mention in a test manifest\nis the only remaining mention of it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329051\n", "files": ["layout/style/crashtests/crashtests.list"], "git_node": "116e11256aae600e9393b8f919c716d9ab66730c", "git_parents": ["120d52747df02e64345a54532c78b09eb58ea93d"], "node": "597dd4bd4ce06a6e5896456c7c4974bf9bfb27f3", "parents": ["6acbcb5d671f5093d1d93d8ed247f695390432cd"], "tags": []}, {"author": "Julian Descottes \u003cjdescottes@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071800 - [bidi] Update browsingContext.captureScreenshot to support chrome contexts r=webdriver-reviewers,whimboo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326108\n", "files": ["remote/webdriver-bidi/modules/root/browsingContext.sys.mjs", "testing/web-platform/mozilla/tests/webdriver/bidi/browsing_context/capture_screenshot/__init__.py", "testing/web-platform/mozilla/tests/webdriver/bidi/browsing_context/capture_screenshot/privileged.py"], "git_node": "1e68428ac62166439a2034bde6db6ff5f4dd7cb4", "git_parents": ["116e11256aae600e9393b8f919c716d9ab66730c"], "node": "581c75376b586b04d08e31e007898b1d99709f17", "parents": ["597dd4bd4ce06a6e5896456c7c4974bf9bfb27f3"], "tags": []}, {"author": "Byron Campen \u003cdocfaraday@gmail.com\u003e", "branch": "default", "desc": "Bug 2072321: Fix races when waiting for mute events. r=mjf\n\nAlso, fix a helper function that was masking timeouts, and loosen a\ntimeout in that function.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328971\n", "files": ["testing/web-platform/tests/webrtc/RTCRtpTransceiver.https.html"], "git_node": "f43d7411fb29a5d3c7216b5b688903e16cf959a8", "git_parents": ["1e68428ac62166439a2034bde6db6ff5f4dd7cb4"], "node": "b297ee7858d3d194a7240c3d756312644a5746e2", "parents": ["581c75376b586b04d08e31e007898b1d99709f17"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072941 - Stop New Tab painting the previous custom wallpaper while a new upload is written. r=thecount\n\nUploading a custom wallpaper shows the picture being replaced for about 200 milliseconds.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327440\n", "files": ["browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Base.test.jsx", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "980941138f4f10af85e89ac1ac9b8c7cc95161d4", "git_parents": ["f43d7411fb29a5d3c7216b5b688903e16cf959a8"], "node": "85216fcfa6b3d4dedf45fdf7be3694a9e806e17c", "parents": ["b297ee7858d3d194a7240c3d756312644a5746e2"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066608 - Add telemetry for mini window. r=mconley,chumphreys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328305\n", "files": ["browser/base/content/main-popupset.js", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/metrics.yaml", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_telemetry.js", "browser/components/screenshots/ScreenshotsUtils.sys.mjs", "toolkit/components/glean/metrics_index.py"], "git_node": "a96684eb889cd3de50f9938142ae6bb489b4c214", "git_parents": ["980941138f4f10af85e89ac1ac9b8c7cc95161d4"], "node": "74998d7ffa2d665dc6f6a2d92bb7fa395dea3932", "parents": ["85216fcfa6b3d4dedf45fdf7be3694a9e806e17c"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2068877 - Part 3: Add a provider for the default top sites r=android-reviewers,npoon\n\n- Adds the DefaultTopSitesProvider interface and a Fenix implementation over a new default_shortcuts.json, which filters by region and drops entries that the user has dismissed from the homescreen blocklist.\n- Nothing consumes the provider yet, so there is no behaviour change.\n- The default_shortcuts.json entries are still listed in default_pinned_shortcuts.json as well. Since removing them there would stop new installs from seeding them until the provider is wired into the top sites assembly.\n- The intention here is to make Google the only default pinned shortcuts whereas all the remaining default top sites would be migrated over and be used as backfill top sites to populate the top sites UI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323486\n", "files": ["mobile/android/android-components/components/feature/top-sites/src/main/java/mozilla/components/feature/top/sites/DefaultTopSitesProvider.kt", "mobile/android/android-components/components/feature/top-sites/src/main/java/mozilla/components/feature/top/sites/TopSite.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/FenixDefaultTopSitesProvider.kt", "mobile/android/fenix/app/src/main/res/raw/default_shortcuts.json", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/FenixDefaultTopSitesProviderTest.kt"], "git_node": "55c28f1a58fae6620fe6061655c2ece0c6a95af7", "git_parents": ["a96684eb889cd3de50f9938142ae6bb489b4c214"], "node": "78c8fa68220b22921fc644a434d72eba7e8613b5", "parents": ["74998d7ffa2d665dc6f6a2d92bb7fa395dea3932"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 1954025 - Make named generic accessibles that are focusable navigable on Android. r=Jamie,geckoview-reviewers,m_kato\n\nIf a node has no role of interest, but it is focusable and named, it is\nindended to be interactive and the default traversal rule should match\nit.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324386\n", "files": ["accessible/android/TraversalRule.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "9493c38af96c379457de3dfeb50fafe79018c285", "git_parents": ["55c28f1a58fae6620fe6061655c2ece0c6a95af7"], "node": "2784a01ab2595a7a90d92a8755e6417b3e350b9d", "parents": ["78c8fa68220b22921fc644a434d72eba7e8613b5"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2070639 - Strip whitespaces from role names when retreiving localized versions. r=Jamie,geckoview-reviewers,m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324730\n", "files": ["accessible/android/AccessibleWrap.cpp", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/AccessibilityTest.kt"], "git_node": "41e8f038697549f3f085f4b9a144c10fa3ece684", "git_parents": ["9493c38af96c379457de3dfeb50fafe79018c285"], "node": "54f6fb291aa22ad75938f63a3429bea870e1e372", "parents": ["2784a01ab2595a7a90d92a8755e6417b3e350b9d"], "tags": []}, {"author": "Eitan Isaacson \u003ceitan@monotonous.org\u003e", "branch": "default", "desc": "Bug 2070637 - Android roles cleanup round. r=Jamie\n\nThis is not comprehensive but instead of doing this as a drive-by or\ncreating a bug for each issue I am doing it here. I compared most\nof these cases with Chrome.\n\n* Remove table/grid role descriptions. The CollectionInfo API is used to\n  surmise the nature of these nodes. I'm preserver row/column header\n  because that is actually useful. Chrome does not expose description\n  for row/column header.\n* Remove list/listitem. Same as above, the CollectionInfo details are\n  used.\n* Remove switch, button, checkbox, radio, progress bar and image. There\n  are equivalent android class names for each (except for switch but it\n  is basically a checkbox.)\n* Remove entry and password text. They also have distinguishing class\n  names plus `isPassword()`.\n* Removed form since it didn't serve any use.\n* Fixed mapping of combobox. It was mistakenly mapped to a spinner.\n* Remove section and paragraph because they are too verbose.\n\nMore to come in the future!\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324731\n", "files": ["accessible/base/RoleMap.inc", "dom/locales/en-US/chrome/accessibility/AccessFu.properties"], "git_node": "b0bd30adc4e1b10354c4cd4785bbdc7c642ce6b2", "git_parents": ["41e8f038697549f3f085f4b9a144c10fa3ece684"], "node": "9ccb074914366fc3bc761d3a8f08c2a3b6670c03", "parents": ["54f6fb291aa22ad75938f63a3429bea870e1e372"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1954025, 2070637, 2070639: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["accessible/android/TraversalRule.cpp"], "git_node": "ce7362bea5782b8f242058106960b6a7b8abd38d", "git_parents": ["b0bd30adc4e1b10354c4cd4785bbdc7c642ce6b2"], "node": "528e1b1d00a5d980b7367f152586feaa71237ab8", "parents": ["9ccb074914366fc3bc761d3a8f08c2a3b6670c03"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067860 - Select the picture-of-the-day wallpaper in one pref transaction. r=Dre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322516\n", "files": ["browser/extensions/newtab/lib/Widgets/PictureOfTheDayFeed.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_PictureOfTheDayFeed.js"], "git_node": "00851ac7a0bbf787665514278967dcfcc8ed01fb", "git_parents": ["ce7362bea5782b8f242058106960b6a7b8abd38d"], "node": "2950b4fc13e82cebb88e02de7ce88328480f4bc1", "parents": ["528e1b1d00a5d980b7367f152586feaa71237ab8"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074507 - Collect urlbar experiment name and branch as part of quick-suggest ping. r=csadilek,daisuke,urlbar-reviewers\n\nThis copies the `experiment_name` and `experiment_branch` metrics used by HNT,\nas Christian mentioned in the bug. I added Nan as the notification email for\nconsistency with the existing metrics in this ping, but at some point we should\nprobably change it to an appropriate group mailing list.\n\nFor now this duplicates most of the content of the Nimbus test tasks between the\noffline and online test files. I think it's important to test both. I'd like to\ndo a follow-up that consolidates this code so it can be reused for both offline\nand online.\n\nDepends on D327231\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328410\n", "files": ["browser/components/urlbar/metrics.yaml", "browser/components/urlbar/private/AmpSuggestions.sys.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_ping_nullValues.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_ping_offline.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_ping_online.js", "browser/components/urlbar/tests/quicksuggest/browser/head.js", "browser/components/urlbar/tests/quicksuggest/unit/test_quicksuggest_mdn.js", "browser/components/urlbar/tests/unit/test_frecency_alternative_nimbus.js"], "git_node": "61fc667f14e32580c29ce06abc8705c748131e65", "git_parents": ["00851ac7a0bbf787665514278967dcfcc8ed01fb"], "node": "0aa34e109af04295b6ff49697a4513b7059da3b2", "parents": ["2950b4fc13e82cebb88e02de7ce88328480f4bc1"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067215 - Don't use proton accent color for LWT links, focus r=desktop-theme-reviewers,tabbrowser-reviewers,nsharpley,emilio\n\nPreviously we were forcing our brand blue/cyan color for some properties\nwhen a LWT was installed. This resulted in some elements getting the\nblue/cyan focus color and others getting the system AccentColor.\n\nThe system AccentColor is already used for primary buttons and\ncheckbox/radio fills, and it's technically configurable by the user. Use\nthe LinkText/AccentColor in LWTs to improve consistency.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324404\n", "files": ["browser/themes/shared/browser-colors.css", "toolkit/components/extensions/test/browser/browser_ext_themes_autocomplete_popup.js", "toolkit/themes/shared/design-system/src/toolbar.css"], "git_node": "a9ec66c05b11ba737dc42d23850686986293ddad", "git_parents": ["61fc667f14e32580c29ce06abc8705c748131e65"], "node": "b0136a82a9d51155efdba56c22db9f7f570f9717", "parents": ["0aa34e109af04295b6ff49697a4513b7059da3b2"], "tags": []}, {"author": "Stephanie Cunnane \u003cscunnane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070217 - Populate moz-select options from moz-option properties rather than attributes. r=mstriemer\n\nsetting-control passes option data to moz-option through Lit property\nbindings, and moz-option reflects those properties to attributes\nasynchronously. populateOptions read them back with getAttribute, so a\nslotchange that ran before the reflection built an option list whose entries\nhad neither a value nor an iconSrc.\n\nThat left usePanelList false and no option matching the value the control had\nalready been given, so update() adopted the inner select's empty value and the\nnext populateOptions took the \"default to first option\" branch, committing the\nfirst option in the list.\n\nOn about:preferences#search this showed up as the default search engine\ndropdown displaying Google after a restart until the page was reloaded.\nReaching the bad state takes an option created for a moz-select that has\nalready rendered its slot, and that is the usual path here: getControlConfig\nawaits every engine's icon before it returns any options, so setting-control\nrenders once with the empty list from defaultGetControlConfig and the options\nare appended after that. Bug 2070217 comment 0 reports the problem with add-on\nand OpenSearch engines only, not with app-provided ones.\n\nupdate() still adopts the inner select's value when the option list changes.\nThat is deliberate: for a native select, a value that matches no option means\nthe browser has reset the selection, and following it is correct, as\ntestMozSelectModifyOptions asserts. Guarding it cannot distinguish that from a\ntransiently incomplete list, so the fix instead removes the only way the list\nreaches that state.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324728\n", "files": ["toolkit/content/tests/widgets/test_moz_select.html", "toolkit/content/widgets/moz-select/moz-select.mjs"], "git_node": "457385c9503160a2cc85459f1d524b4aa4d5934b", "git_parents": ["a9ec66c05b11ba737dc42d23850686986293ddad"], "node": "e99f540b16cd2f7a721ec4710baae55d34f12497", "parents": ["b0136a82a9d51155efdba56c22db9f7f570f9717"], "tags": []}, {"author": "Haik Aftandilian \u003chaftandilian@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064937 - Create a module for the Geolocation Provider platform implementation r=Thinker,handyman,saschanaz,jjaschke,shtrom,\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319959\n", "files": ["mots.yaml"], "git_node": "7a43d8fa7ae34999dc24abc70bf9e92d71d88112", "git_parents": ["457385c9503160a2cc85459f1d524b4aa4d5934b"], "node": "a5e6f3b04d3b50082d6a007562cca7e1e31675f4", "parents": ["e99f540b16cd2f7a721ec4710baae55d34f12497"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072134: Answer OS-initiated ASWebAuthenticationSession cancellations on the request object from the begin call. r=mac-reviewers,bradwerth\n\nAuthenticationServices passes a different ASWebAuthenticationSessionRequest instance to cancelWebAuthenticationSessionRequest: than the one it passed to the begin call, and only a reply on the begin instance reaches the broker.\n\nThe broker serializes requests per browser and does not deliver the next one until the current one is answered, so an unanswered cancellation stalls every later request from every app until Firefox restarts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328716\n", "files": ["browser/modules/ASWebAuthSessionService.sys.mjs", "browser/modules/test/browser/browser_aswebauth_session.js", "toolkit/xre/ASWebAuthSessionHandler.mm"], "git_node": "234ae107cbe4c553a65701c7f18a087c2301e33c", "git_parents": ["7a43d8fa7ae34999dc24abc70bf9e92d71d88112"], "node": "ca686f01e70b40098e7deb7df5bf0bc0d05a3cc3", "parents": ["a5e6f3b04d3b50082d6a007562cca7e1e31675f4"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072134: Stop assuming the main thread in the ASWebAuthenticationSession handler. r=mac-reviewers,bradwerth\n\nAuthenticationServices delivers both callbacks on one of its own threads\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328717\n", "files": ["toolkit/xre/ASWebAuthSessionHandler.mm"], "git_node": "143177b67db91ec3939efed3a0611acdf5dffe4c", "git_parents": ["234ae107cbe4c553a65701c7f18a087c2301e33c"], "node": "e18a4b1c6306b1f7b524b17d145e577d3d5a1548", "parents": ["ca686f01e70b40098e7deb7df5bf0bc0d05a3cc3"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074060: Restart SafariLaunchAgent once so it notices ASWebAuthenticationSession support after an update. r=mac-reviewers,bradwerth\n\nWe have not found a way to make the agent read the Info.plist again short of terminating it. launchctl kickstart and launchctl kill are refused. The one-time flag lives in NSUserDefaults because the agent's state is per user, not per profile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328721\n", "files": ["toolkit/xre/ASWebAuthSessionHandler.mm"], "git_node": "07bfdadd6ebc4e167c1778608ebcb7817a7c66d2", "git_parents": ["143177b67db91ec3939efed3a0611acdf5dffe4c"], "node": "fed121d9551a37b746382e2a09e7926912efd7c6", "parents": ["e18a4b1c6306b1f7b524b17d145e577d3d5a1548"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066236 - Gate widget availability by market r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325667\n", "files": ["browser/app/profile/firefox.js", "browser/components/preferences/tests/home/browser_homepage_firefox_home.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "d3ae9c59045f125917f35515b7e8771560af3158", "git_parents": ["07bfdadd6ebc4e167c1778608ebcb7817a7c66d2"], "node": "4d88a2f0603ccb4035a35493302fc34316cd48df", "parents": ["fed121d9551a37b746382e2a09e7926912efd7c6"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066240 - Turn the Lists widget off by default in the US, DE and FR, and block it in PL r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325669\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser_discovery_card.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "541999fd5257fcfc7f82bef7d8479f0a46eabda1", "git_parents": ["d3ae9c59045f125917f35515b7e8771560af3158"], "node": "83d7c6d20ac1c4403c37ebfe5de159e4385249c8", "parents": ["4d88a2f0603ccb4035a35493302fc34316cd48df"], "tags": []}, {"author": "Reem H \u003c42309026+reemhamz@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2066242 - Turn FocusTimer off by default in US, DE, FR, PL regions. r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327240\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser_newtab_side_by_side_layout.js", "browser/extensions/