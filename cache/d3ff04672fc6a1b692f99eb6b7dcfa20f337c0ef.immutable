dgets/theme-picker/theme-picker.mjs", "toolkit/content/widgets/theme-picker/theme-picker.tagmap.d.ts"], "git_node": "3dfdbfffcb500d53cdb4553117a0210e1990c113", "git_parents": ["46575f7796facab4fdce1302a4f0563775117933"], "node": "b7c7e2bd856d863b1517843b16b3f69e85a87b5f", "parents": ["f66bcdcdf9b5786766ec3bee465fa44893127606"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078326 - Move AutoTabGrouping ftl file for Localization. r=jlewis,fluent-reviewers,bolsson\n\nAutoTabGrouping will be enabled for FR locales. This patch moves the autoTabGrouping.ftl\nfile from locales preview to the locales/en-US/browser folder.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331648\n", "files": ["browser/base/content/browser.xhtml", "browser/locales-preview/autoTabGrouping.ftl", "browser/locales/en-US/browser/autoTabGrouping.ftl", "browser/locales/jar.mn"], "git_node": "9b9ce115d76a89c8d7e6a7c4d3e706eb0d10f1e8", "git_parents": ["3dfdbfffcb500d53cdb4553117a0210e1990c113"], "node": "494d61e22522ab3ea376289f83ecaf535c7c4c52", "parents": ["b7c7e2bd856d863b1517843b16b3f69e85a87b5f"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2006720 - refactor(webgpu): destructure limits exhaustively in `restrict_limits` r=webgpu-reviewers,nical\n\nThis is a sensitive enough thing that that forcing patch authors to make decisions about new limit definitions is important. This also would have saved me some headache developing this patch stack; see also the next patch. \ud83d\ude05\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329214\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "b5d49bd45a5ac37afd9d711ce4a152494bcd4b59", "git_parents": ["9b9ce115d76a89c8d7e6a7c4d3e706eb0d10f1e8"], "node": "3017ff6cded68e6a5a6306e17ec533001fcee7e1", "parents": ["494d61e22522ab3ea376289f83ecaf535c7c4c52"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2006720 - fix(webgpu): restrict `maxStorage{Buffers,Textures}In{Vertex,Fragment}Stage` to `MAX_BINDINGS_PER_RESOURCE_TYPE` r=webgpu-reviewers,nical\n\nThis has no effect yet, but it //will// (and we'll need it) once we actually use wgpu as our source of truth for these limits in a subsequent patch.\n\nIf we didn't do this, we'd be regressing the issue that motivated the clamping of the per-shader-stage limits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329215\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "c8b0a546dfd6d09e5a6701315b0ff3b661dfcbff", "git_parents": ["b5d49bd45a5ac37afd9d711ce4a152494bcd4b59"], "node": "b183584f35b9cf1aeb0be09df0e5b414c6cb7ec8", "parents": ["3017ff6cded68e6a5a6306e17ec533001fcee7e1"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2006720 - fix(webgpu): report the limits a device was actually created with r=webgpu-reviewers,nical\n\n`Adapter::RequestDevice` keeps a copy of the limits we requested of wgpu for the eventual `Device` we intend to construct. This was correct, until the WebGPU spec. starting specifying limit normalization on the device's reported `maxStorage{Buffers,Textures}In{Vertex,Fragment}Stage`. Now, we need to plumb the normalized limits back, so content and wgpu are back on the same page.\n\nAdd the created device's reported limits to `RequestDeviceResponse`, and build `SupportedLimits` from those instead (if the device is valid). If the device is invalid, then we have no new limits to report anyway; keep using the user-requested copy of limits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329216\n", "files": ["dom/webgpu/Adapter.cpp", "dom/webgpu/ipc/WebGPUChild.cpp", "gfx/wgpu_bindings/src/client.rs", "gfx/wgpu_bindings/src/lib.rs", "gfx/wgpu_bindings/src/server.rs"], "git_node": "ecd308eb88c296153b00343f15a5758c92921c9d", "git_parents": ["c8b0a546dfd6d09e5a6701315b0ff3b661dfcbff"], "node": "3ad7727a8511bf14a3121307734473b60274a6bb", "parents": ["b183584f35b9cf1aeb0be09df0e5b414c6cb7ec8"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2006720 - fix(webgpu): report `maxStorage{Buffers,Textures}In{Vertex,Fragment}Stage` from the device itself r=webgpu-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D276887\n", "files": ["dom/webgpu/SupportedLimits.cpp", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/capability_checks/limits/maxStorageBuffersInFragmentStage/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/capability_checks/limits/maxStorageBuffersInVertexStage/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/capability_checks/limits/maxStorageTexturesInFragmentStage/cts.https.html.ini", "testing/web-platform/mozilla/meta/webgpu/cts/webgpu/api/validation/capability_checks/limits/maxStorageTexturesInVertexStage/cts.https.html.ini"], "git_node": "542ab19ed2b10b3bdbcde03f05467e85df2dba62", "git_parents": ["ecd308eb88c296153b00343f15a5758c92921c9d"], "node": "5b337084b5262538d597c1a7c60e09c710b5e74a", "parents": ["3ad7727a8511bf14a3121307734473b60274a6bb"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076007 - Part 2: Give JSVAL_TYPE_INT32 a tag that ARM64 materializes in one instruction. r=iain,devtools-reviewers,nchevobbe\" for causing bc failures @browser_test_feature_jstracing_values.js.\n\nThis reverts commit 08253de9fda7233fc4d2cf161e0f8b4d114a5cc8.\n\nRevert \"Bug 2076007 - Part 1: Give JSVAL_TYPE_UNDEFINED a tag that ARM64 materializes in one instruction. r=iain,devtools-reviewers,nchevobbe\"\n\nThis reverts commit 8e3e01e7bc20c40184cf0747794b5762fcef1eb8.\n", "files": ["devtools/client/shared/components/reps/reps/value-summary-reader.mjs", "js/public/Debug.h", "js/public/Value.h", "js/src/jit-test/tests/debug/ExecutionTracer-traced-values.js"], "git_node": "ec09514f42424ae106af7834162ec14ae79ef713", "git_parents": ["542ab19ed2b10b3bdbcde03f05467e85df2dba62"], "node": "59fd4b07b33e4297f48f17c44bab732214e836ca", "parents": ["5b337084b5262538d597c1a7c60e09c710b5e74a"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1613369 - Use paired nearest alpha rounding and correct conversion expectations. r=gfx-reviewers,lsalzman,places-reviewers,mak\" for causing reftest failures.\n\nThis reverts commit f84faf54643eab533206cc2fe7c627e343e9b00a.\n", "files": ["dom/canvas/test/mochitest.toml", "dom/canvas/test/test_canvas.html", "dom/canvas/test/test_canvas_png_roundtrip.html", "gfx/2d/Swizzle.cpp", "gfx/2d/SwizzleGeneric.h", "gfx/2d/SwizzleNEON.h", "gfx/tests/gtest/TestSwizzle.cpp", "image/test/unit/image1.webp", "image/test/unit/image1png16x16.jpg", "image/test/unit/image1png64x64.jpg", "image/test/unit/image1quality50.webp", "image/test/unit/test_imgtools.js", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.no_shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/element/compositing/2d.composite.grid.no_filter.shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.drawImage.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.fillRect.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.no_shadow.pattern.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.drawImage.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.drawImage.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.fillRect.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.fillRect.w.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.pattern.html.ini", "testing/web-platform/meta/html/canvas/offscreen/compositing/2d.composite.grid.no_filter.shadow.pattern.w.html.ini", "toolkit/components/places/tests/favicons/expected-favicon-big48.ico.libz-rs.png", "toolkit/components/places/tests/favicons/expected-favicon-big48.ico.png"], "git_node": "5d3b9c9c0e96b88c5803971661249f87dec5a8f1", "git_parents": ["ec09514f42424ae106af7834162ec14ae79ef713"], "node": "f2a7d839022bca24f7d8243cb849b6317e107952", "parents": ["59fd4b07b33e4297f48f17c44bab732214e836ca"], "tags": []}, {"author": "Simon Friedberger \u003csimon@mozilla.com\u003e", "branch": "default", "desc": "Bug 1981768 - Log HSTS and HTTPS RR connection upgrades to the web console. r=valentin,necko-reviewers\n\nHTTPS-Only, HTTPS-First, CSP upgrade-insecure-requests and Mixed Content\nauto-upgrade all log a console message when they upgrade an HTTP\nrequest. Add the same for HSTS and HTTPS RR.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330600\n", "files": ["dom/locales/en-US/chrome/security/security.properties", "dom/security/test/https-only/browser.toml", "dom/security/test/https-only/browser_hsts_host.js", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/test/browser/browser_mock_https_rr.js"], "git_node": "25429cef17b5be0f41404db8ff739011c85f5c30", "git_parents": ["5d3b9c9c0e96b88c5803971661249f87dec5a8f1"], "node": "2ad3211ea9d2d7406fc1b8a3eef75bd8ad9fd99e", "parents": ["f2a7d839022bca24f7d8243cb849b6317e107952"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2079461 - Ignore code example in rustdoc for ToCss. r=firefox-style-system-reviewers,emilio,dshin\n\nSo that it's possible to run `cargo test`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331764\n", "files": ["servo/components/style_traits/values.rs"], "git_node": "6a8b0ffaa852df413e0bf66a57c77c6cc4293f98", "git_parents": ["25429cef17b5be0f41404db8ff739011c85f5c30"], "node": "59e977531f6649bcabc3348c77464fd94b78b395", "parents": ["2ad3211ea9d2d7406fc1b8a3eef75bd8ad9fd99e"], "tags": []}, {"author": "Sarah Chung \u003csachung@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079393 - land welcome back onboarding strings in-tree r=omc-reviewers,fluent-reviewers,yazan,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331723\n", "files": ["browser/locales/en-US/browser/newtab/onboarding.ftl"], "git_node": "01e35a1f898c2de6f9e2f40c98c27396a6149f92", "git_parents": ["6a8b0ffaa852df413e0bf66a57c77c6cc4293f98"], "node": "574fdb96e8548d1652ca7b11ad144beb06e22d50", "parents": ["59e977531f6649bcabc3348c77464fd94b78b395"], "tags": []}, {"author": "Sneh Patel \u003csnehpatel136@gmail.com\u003e", "branch": "default", "desc": "Bug 2063082 - Removed unused file Components.kt. r=android-reviewers,gmalekpour\n\nCo-Authored-By: Claude Sonnet 5 \u003cnoreply@anthropic.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328051\n", "files": ["mobile/android/android-components/samples/browser/src/servo/java/org/mozilla/samples/browser/Components.kt"], "git_node": "fe087350945b7c2c2ddd8f2e2afaf5ae94053cca", "git_parents": ["01e35a1f898c2de6f9e2f40c98c27396a6149f92"], "node": "d9587d482514d1a7b9e94044e65ac0abcf466242", "parents": ["574fdb96e8548d1652ca7b11ad144beb06e22d50"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078326 - Move AutoTabGrouping ftl file for Localization. r=jlewis,fluent-reviewers,bolsson\" for causing bc failures @browser_aiwindow_group_tabs_button_tab_management.js.\n\nThis reverts commit 9b9ce115d76a89c8d7e6a7c4d3e706eb0d10f1e8.\n", "files": ["browser/base/content/browser.xhtml", "browser/locales-preview/autoTabGrouping.ftl", "browser/locales/en-US/browser/autoTabGrouping.ftl", "browser/locales/jar.mn"], "git_node": "ba048348ee88f1af800473476a35c0ec143cc5c9", "git_parents": ["fe087350945b7c2c2ddd8f2e2afaf5ae94053cca"], "node": "2b7d94b1d519ded4df219bc53f717c3f9a933840", "parents": ["d9587d482514d1a7b9e94044e65ac0abcf466242"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078974 - Turn on widget market gating with every widget off by default r=reemhamz\" for causing marionette failures.\n\nThis reverts commit a3e238c1283fb34afc2b1f5d5baaaf352dbdc9df.\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "testing/profiles/common/user.js", "testing/profiles/xpcshell/user.js"], "git_node": "db61722b9f7f08486778e4325b13acb49a8c9e2c", "git_parents": ["ba048348ee88f1af800473476a35c0ec143cc5c9"], "node": "e783a3d200873cedee35e83db59832ddd0799b22", "parents": ["2b7d94b1d519ded4df219bc53f717c3f9a933840"], "tags": []}, {"author": "MoHan Zhang \u003cmzhang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075320 - Rename the AITab chat tool to generate_page and gate the pages prompt module on the AITab pref r=rrando,omarg\n\nThe chat tool that creates an AITab is renamed generate_page: models read\n\"page\" as the artifact the user asked for (\"make this a page\", \"save this as a\npage\"), while \"aitab\" is a product name they never see in user requests. Only\nthe tool name and the focus parameter's description change; the GENERATE_AITAB\nconstant and the AITab module keep their names.\n\nThe chat prompt's guidance for that tool lives in a `pages` module in Remote\nSettings. buildChatSystemPrompt now skips chat modules listed in\nGATED_CHAT_MODULES while their pref is off, so the model is never taught about\na tool that filterFeatureGatedTools does not give it: with\nbrowser.smartwindow.aitab.enabled off the served prompt is identical to\ntoday's, with it on the pages module is appended after response-rules. An\ninstruction-only gate (\"only when generate_page is in your tool list\") did not\nhold in evaluation: with the tool absent, Gemini still closed 35% of its\nreplies with a page offer.\n\nShipped builds have neither this gate nor the rename, so Remote Settings\npublishes the module under chat params major 12 and this patch moves\nFEATURE_MAJOR_VERSIONS.chat from 11 to 12 (still 10 with the mistralRelease\npref off). Release 157 and beta 158 keep reading major 11, which is unchanged;\nonly builds that carry this patch select v12, so the tool name, the gate and\nthe guidance always travel together. The packaged dump already carries the\nv12 and pages records.\n\nReland: the gating test now drives the real pages module from the v12\nmanifest instead of injecting one (an injected copy at the same major lost\nto the packaged record in findModule), and the UI test helper's mock chat\nrecords move to major 12 to match FEATURE_MAJOR_VERSIONS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328921\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/Utils.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_chat_system_prompt.js", "browser/components/aiwindow/ui/test/browser/browser_aitab_tool_ui.js", "browser/components/aiwindow/ui/test/browser/head.js"], "git_node": "c6854664147232ffdbae40b839f70413e7bdb8a1", "git_parents": ["db61722b9f7f08486778e4325b13acb49a8c9e2c"], "node": "5991bc78d64fd92b1aab4f7221776f518481ff61", "parents": ["e783a3d200873cedee35e83db59832ddd0799b22"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 1713711 - Resolve nested Facebook SDK shim objects against the real SDK r=webcompat-reviewers,twisniewski\n\nensureProxiedToUnshimmed() resolved every level of the stub against the\nroot window.FB, so a reference the page kept to a nested object stopped\nworking once the real SDK loaded: the proxy for FB.Event looked up\nwindow.FB.subscribe rather than window.FB.Event.subscribe, and the\nwrapper for a nested function did the same.\n\nEach level now resolves along its own path and falls back to the stub\nwhere the real SDK defines no counterpart. A set trap forwards writes,\nwhich previously landed on the discarded stub and were never read back.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325639\n", "files": ["browser/extensions/webcompat/shims/facebook-sdk.js"], "git_node": "58557afc4fb45056836abd0bb99ceae51d284d56", "git_parents": ["c6854664147232ffdbae40b839f70413e7bdb8a1"], "node": "15eb41fb55da3c504ad8514b515626ce4e1dadfc", "parents": ["5991bc78d64fd92b1aab4f7221776f518481ff61"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057021 - Mark a New Tab message as active only once it has been in view. r=omc-reviewers,ini,emcminn\n\nFirefox has a rule that it won't show a new message (like a pop-up tip) in a tab that's already showing one. New Tab can show messages too, and it tells Firefox whenever a tab has one up.\n\nThe problem was that New Tab said a message was showing as soon as it was added to the page, even if it was further down and the user never scrolled to it. So a message nobody had seen could block other messages in that tab. And since we only count a message as seen once it's actually on screen, it also never got counted.\n\nWith this patch, New Tab waits until the message has actually been on screen before telling Firefox it's showing. That's the same moment we already count it as seen.\n\nThere was also a related problem. If the message came into view while the tab was in the background, we threw that away and never counted it, even after the user switched to the tab and was looking right at it. Now we hold on to it, and count it when the user comes back to the tab.\n\nThis is the first of two stacked patches. The second one (D329837) fixes the opposite problem, a tab that kept counting as showing a message after the user left New Tab, and it uses two small test helpers added here.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329836\n", "files": ["browser/components/asrouter/tests/browser/browser_asrouter_newtab_messages.js", "browser/extensions/newtab/content-src/components/MessageWrapper/MessageWrapper.jsx", "browser/extensions/newtab/test/jest/content-src/components/MessageWrapper.test.jsx"], "git_node": "80c4855b6e1d05920ee3caafb6afd3886897c835", "git_parents": ["58557afc4fb45056836abd0bb99ceae51d284d56"], "node": "de287992b36c4468c627ef36e2190a5b411fc60b", "parents": ["15eb41fb55da3c504ad8514b515626ce4e1dadfc"], "tags": []}, {"author": "Atharva Wadodkar \u003catharva.wadodkar2003@gmail.com\u003e", "branch": "default", "desc": "Bug 2070702 - Rename PAPZInputBridge to PAPZBridge. r=canalun,ipc-reviewers,geckoview-reviewers,gtk-reviewers,emilio,hiro\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331288\n", "files": ["browser/base/content/test/browser-performance/browser_startup_syncIPC.js", "gfx/ipc/GPUChild.cpp", "gfx/ipc/GPUParent.cpp", "gfx/ipc/GPUParent.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/PGPU.ipdl", "gfx/layers/apz/public/APZBridge.h", "gfx/layers/apz/public/APZInputBridge.h", "gfx/layers/apz/public/IAPZCTreeManager.h", "gfx/layers/apz/src/APZBridge.cpp", "gfx/layers/apz/src/APZCTreeManager.cpp", "gfx/layers/apz/src/APZCTreeManager.h", "gfx/layers/apz/src/APZInputBridge.cpp", "gfx/layers/apz/src/InputQueue.cpp", "gfx/layers/apz/test/gtest/TestOverscroll.cpp", "gfx/layers/apz/test/gtest/TestScrollHandoff.cpp", "gfx/layers/ipc/APZBridgeChild.cpp", "gfx/layers/ipc/APZBridgeChild.h", "gfx/layers/ipc/APZBridgeParent.cpp", "gfx/layers/ipc/APZBridgeParent.h", "gfx/layers/ipc/APZCTreeManagerChild.cpp", "gfx/layers/ipc/APZCTreeManagerChild.h", "gfx/layers/ipc/APZInputBridgeChild.cpp", "gfx/layers/ipc/APZInputBridgeChild.h", "gfx/layers/ipc/APZInputBridgeParent.cpp", "gfx/layers/ipc/APZInputBridgeParent.h", "gfx/layers/ipc/CompositorBridgeParent.cpp", "gfx/layers/ipc/CompositorBridgeParent.h", "gfx/layers/ipc/LayersMessageUtils.h", "gfx/layers/ipc/PAPZBridge.ipdl", "gfx/layers/ipc/PAPZCTreeManager.ipdl", "gfx/layers/ipc/PAPZInputBridge.ipdl", "gfx/layers/ipc/RemoteContentController.cpp", "gfx/layers/moz.build", "ipc/ipdl/sync-messages.ini", "widget/InputData.h", "widget/android/nsWindow.cpp", "widget/cocoa/nsCocoaWindow.mm", "widget/gtk/nsWindow.cpp", "widget/nsIWidget.cpp", "widget/windows/nsWindow.cpp"], "git_node": "8c79e74d89eb251c27267f59ec0964136e7fb172", "git_parents": ["80c4855b6e1d05920ee3caafb6afd3886897c835"], "node": "791bfecd01d547729e4e3db82a07a6ece36e2b07", "parents": ["de287992b36c4468c627ef36e2190a5b411fc60b"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078555: Part 1 - Version ModuleLoadInfo where it crosses binaries r=win-reviewers,yjuglaret\n\nAn interrupted update can leave firefox.exe, mozglue.dll and xul.dll at\ndifferent versions, and a ModuleLoadInfo passes between all three.  The struct\nnow starts with a magic number and a layout version.  Each binary that\nreceives one checks them before reading and drops the record otherwise, leaving\nthe object to the binary that built it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331475\n", "files": ["browser/app/winlauncher/freestanding/LoaderPrivateAPI.cpp", "toolkit/xre/dllservices/mozglue/LoaderObserver.cpp", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h", "toolkit/xre/dllservices/mozglue/WindowsDllServices.h", "toolkit/xre/dllservices/tests/gtest/TestDLLServices.cpp"], "git_node": "bbe3d15ad3798b203d6d7a2777b95102a83b41b2", "git_parents": ["8c79e74d89eb251c27267f59ec0964136e7fb172"], "node": "cc13345e528246adcf9bf3fd7ddec7d17a654dfe", "parents": ["791bfecd01d547729e4e3db82a07a6ece36e2b07"], "tags": []}, {"author": "David Parks \u003cdaparks@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078555: Part 2 - Don't send module load events if ModuleLoadInfo may have changed r=win-reviewers,yjuglaret\n\nPart 1 lets a binary refuse a ModuleLoadInfo of another layout, but a binary\nwithout that check still accepts one.  So firefox.exe, mozglue.dll and xul.dll\nnow each export their layout version in a function, and a sender asks the\nreceiver for it before handing module load events across.  mozglue.dll also\nstops using an executable with a different layout to construct its\nModuleLoadInfos, since that happens by value and cannot be checked afterwards.\nA binary without the export is treated as having a different layout.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331476\n", "files": ["browser/app/winlauncher/NtLoaderAPI.cpp", "toolkit/xre/dllservices/WinDllServices.cpp", "toolkit/xre/dllservices/mozglue/ModuleLoadFrame.cpp", "toolkit/xre/dllservices/mozglue/ModuleLoadInfo.h", "toolkit/xre/dllservices/mozglue/WindowsDllBlocklist.cpp", "toolkit/xre/dllservices/tests/gtest/TestDLLServices.cpp"], "git_node": "e032338eb9e63447216325040d5c7dfd060adc2a", "git_parents": ["bbe3d15ad3798b203d6d7a2777b95102a83b41b2"], "node": "65bc5f82cccb148fffe9a95170490a93b1adea5e", "parents": ["cc13345e528246adcf9bf3fd7ddec7d17a654dfe"], "tags": []}, {"author": "Gabriel Luong \u003cgabriel.luong@gmail.com\u003e", "branch": "default", "desc": "Bug 2074227 - Part 2: Record dismissed default top sites in the homescreen blocklist r=android-reviewers,npoon\n\n- Removing a top site that the default top sites provider would serve again leaves no record behind, so it is added to the homescreen blocklist instead.\n- The top sites held in the pinned sites storage, such as Google, are unaffected and continue to be removed from there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328602\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Core.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppAction.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/appstate/AppStoreReducer.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/blocklist/BlocklistHandler.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/blocklist/BlocklistMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/ShortcutsFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/topsites/controller/TopSiteController.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/blocklist/BlocklistHandlerTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/blocklist/BlocklistMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/home/topsites/controller/DefaultTopSiteControllerTest.kt"], "git_node": "bb2baeede9f03eee16904f3bfefdb9618118afa5", "git_parents": ["e032338eb9e63447216325040d5c7dfd060adc2a"], "node": "705f7978041b3419b016c108e298eff398641513", "parents": ["65bc5f82cccb148fffe9a95170490a93b1adea5e"], "tags": []}, {"author": "Rolf Rando \u003crrando@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073307 - AITAb: Added modification, raw content tool call update r=omarg,mzhang\n\nThis phab adds raw content feature to the AITab tool calling.\n\nIt also adds support for modifications, re-using the conversation used to create the previous version of the GenTab.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328312\n", "files": ["browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_aitab.js", "browser/components/aiwindow/models/tests/xpcshell/test_aitab_parse.js", "browser/components/aiwindow/ui/actors/AITabParent.sys.mjs", "browser/components/aiwindow/ui/modules/AITabConstants.sys.mjs", "browser/components/aiwindow/ui/modules/AITabMigrations.sys.mjs", "browser/components/aiwindow/ui/modules/AITabSql.sys.mjs", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aitab_actions.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabDelete.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js"], "git_node": "6da465c3c251902eb5a5ae149ea0242eb7c22a17", "git_parents": ["bb2baeede9f03eee16904f3bfefdb9618118afa5"], "node": "5de2e1acf60dbc8260dfc9e724105c5e7eead7c6", "parents": ["705f7978041b3419b016c108e298eff398641513"], "tags": []}, {"author": "John M. Schanck \u003cjschanck@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079517 - avoid constructing a CERTCertificate in mozilla::psm::AuthCertificateHook. r=keeler\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331823\n", "files": ["security/manager/ssl/SSLServerCertVerification.cpp"], "git_node": "1edaf24764e9f46f6e47da53183fa9b885301c49", "git_parents": ["6da465c3c251902eb5a5ae149ea0242eb7c22a17"], "node": "57f8254fe049a2c7a5b14125703dd72e4ca96f92", "parents": ["5de2e1acf60dbc8260dfc9e724105c5e7eead7c6"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074310: Create an Accessible if a node becomes contentEditable. r=accessibility-platform-reviewers,eeejay\n\nWe already created an Accessible if an element was contentEditable at the time it was shown or reached while building a subtree.\nHowever, if an element didn't get an Accessible but then later became contentEditable, we previously didn't create an Accessible for it.\nNow, we watch for a change to the contentEditable attribute on an element without an Accessible and schedule it for insertion.\nOf course, if it turns out that the element shouldn't get an Accessible after all, this will be a no-op, as it will be rejected by the insertion/creation machinery.\n\nThe change to use GetAccessibleOrDocument is a drive-by cosmetic fix and does not change any functionality.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330076\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/tests/browser/text/browser_editabletext.js"], "git_node": "0b4b789be14af7f0ffc90c4a70d6bb75ab085592", "git_parents": ["1edaf24764e9f46f6e47da53183fa9b885301c49"], "node": "0bc7256f416ba49e842cf668d34fe9a5cfc0fd5a", "parents": ["57f8254fe049a2c7a5b14125703dd72e4ca96f92"], "tags": []}, {"author": "owlishDeveloper \u003cbugzeeeeee@gmail.com\u003e", "branch": "default", "desc": "Bug 2079024 - Re-enable geckoview-junit tests that no longer need their fission skip r=geckoview-reviewers,ohall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331469\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoSessionTestRuleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/NavigationDelegateTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ScreenshotTest.kt"], "git_node": "473a2c3688cd4d3beaf739804ec1024a7e8fb570", "git_parents": ["0b4b789be14af7f0ffc90c4a70d6bb75ab085592"], "node": "6d797afa240120b296800f841b633265faa566e3", "parents": ["0bc7256f416ba49e842cf668d34fe9a5cfc0fd5a"], "tags": []}, {"author": "Michael Farrell \u003cmicolous+git@gmail.com\u003e", "branch": "default", "desc": "Bug 2057377 - Derive caBLE tunnel server hostname r=jschanck\n\nThis derives the hostname of the tunnel server, used for communicating with\na caBLE authenticator after the handshake.\n\nThis will be used in D313918.\n\nReference: CTAP 2.3 Hybrid WebSockets data transfer channel:\nhttps://fidoalliance.org/specs/fido-v2.3-ps-20260226/fido-client-to-authenticator-protocol-v2.3-ps-20260226.html#hybrid-websocket-channel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317418\n", "files": ["security/manager/ssl/noise/src/discovery/mod.rs", "security/manager/ssl/noise/src/lib.rs"], "git_node": "7c2d3e02907ac2cb403008f2521bcc5d54fa95a4", "git_parents": ["473a2c3688cd4d3beaf739804ec1024a7e8fb570"], "node": "57eaecfd678fefc915d6ebc09cafaf1da029f6b1", "parents": ["6d797afa240120b296800f841b633265faa566e3"], "tags": []}], "date": 1791432835, "git_changesets": ["dd77228df5e10b9ed750f69e60500e478637c3ba", "4bed6e6c7e28dba0db91970152f19d00a7b08496", "02a0ffa2653f0dfc4b7d18845a985377c0a190a7", "ad5b15f10088265c0f63d0f1266574bf8d2b1972", "db2a5a71ac9654a4baf2e77111b383643d6f0ca8", "172a3c6bab04a8efcd07bb39e6c3063159a5e769", "9080ed9ee221e0ca0fb4cbc75e2f87cbe48564a8", "20ac49efe922376286bb1f6f68b15f5d7b791fbf", "b38562b55c03769e35c007d90c6345bc675184ac", "63c204400558a3b42f9a146efc8f74dc3d2080a7", "2a370a7495897b04c8eef0f18e94a53dfc58d681