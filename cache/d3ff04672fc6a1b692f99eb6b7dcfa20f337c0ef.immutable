/generated/tspaths.json"], "git_node": "24780cc4865014c0f8d6a4ec99e810e42f1c2804", "git_parents": ["4158ca948de792c32723a711fe0046e2d28d0f29"], "node": "3f15056f6c17aa6287be9dc41ecbb877a451699d", "parents": ["8c8d5a6db02ec181f3022aa24cd117594b976d41"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069438 - Look up logins by guid directly in the Rust storage search. r=credential-management-reviewers,dimi\n\nA search for a guid read every login in the store through listCandidates() to\nkeep a single row. Fetch that row with getMany() instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328785\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs"], "git_node": "de639f400909fdcf7b82be43fdc4728baa01fafa", "git_parents": ["24780cc4865014c0f8d6a4ec99e810e42f1c2804"], "node": "e728e3ec40a815ba2888cb67fb9a757d4e1dde36", "parents": ["3f15056f6c17aa6287be9dc41ecbb877a451699d"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069438 - Vendor application-services 7585e03e for LoginStore::list_candidates_by_origin(). r=dimi\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328791\n", "files": ["third_party/application-services/components/ads-client/integration-tests/tests/ads_store.rs", "third_party/application-services/components/ads-client/integration-tests/tests/mars.rs", "third_party/application-services/components/ads-client/src/ads_store.rs", "third_party/application-services/components/ads-client/src/ads_store/builder.rs", "third_party/application-services/components/ads-client/src/ads_store/store.rs", "third_party/application-services/components/ads-client/src/client.rs", "third_party/application-services/components/ads-client/src/ffi.rs", "third_party/application-services/components/ads-client/src/lib.rs", "third_party/application-services/components/ads-client/src/mars/ad_request.rs", "third_party/application-services/components/ads-client/src/mars/ad_response.rs", "third_party/application-services/components/ads-client/src/request.rs", "third_party/application-services/components/ads-client/src/test_utils.rs", "third_party/application-services/components/logins/src/db.rs", "third_party/application-services/components/logins/src/logins.udl", "third_party/application-services/components/logins/src/store.rs", "third_party/application-services/moz.yaml", "toolkit/components/uniffi-bindgen-gecko-js/android/components/ads-client/android/src/main/java/mozilla/appservices/adsclient/ads_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "c1b673ddee619255f9a1169e34e8bbf98f416229", "git_parents": ["de639f400909fdcf7b82be43fdc4728baa01fafa"], "node": "7c70d12e622b2ccbfd7787df920a7c954dcaba07", "parents": ["e728e3ec40a815ba2888cb67fb9a757d4e1dde36"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069438 - Pre-filter Rust storage searches by origin. r=dimi\n\nA search for an origin read every login in the store through listCandidates().\nlistCandidatesByOrigin() now returns only the logins with that origin, its\nhttp:// variant under schemeUpgrades, or a host within its base domain or a\nrelated realm under acceptDifferentSubdomains. match() still decides, so the\nstore only has to return a superset.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328792\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs"], "git_node": "0bb20adddaaf6f612a80183a5ec9eda9f8e55c37", "git_parents": ["c1b673ddee619255f9a1169e34e8bbf98f416229"], "node": "c4fba18c30b2396236d1e26a66af7b8ebabe3709", "parents": ["7c70d12e622b2ccbfd7787df920a7c954dcaba07"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069438 - Count Rust storage logins without decrypting them. r=dimi\n\ncountLoginsAsync() went through #searchLogins, which decrypts every match, so a\ncount with a hit prompted for the primary password, and failed if the prompt\nwas cancelled. The candidates carry every field a count matches on, so count\nthose instead, as the JSON backend does.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328794\n", "files": ["toolkit/components/passwordmgr/storage-rust.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_rust_storage_primary_password.js"], "git_node": "0f51239e5f43d68cae2370ca4e403965d1cda63b", "git_parents": ["0bb20adddaaf6f612a80183a5ec9eda9f8e55c37"], "node": "ce03dcfa61b80dfb24e1a633f4d8a0badcb805db", "parents": ["c4fba18c30b2396236d1e26a66af7b8ebabe3709"], "tags": []}, {"author": "Rana Al-Khulaidi \u003cralkhulaidi@gmail.com\u003e", "branch": "default", "desc": "Bug 2059778 - Add a Nimbus migration to remove Normandy databases from profiles. r=nimbus-reviewers,beth\n\nNothing writes studies or rollouts to these databases anymore so this removes the wrappers along with their consumers and tests. It also adds a remove-normandy-databases Nimbus migration to delete the databases from existing profiles along with the leftover startupRolloutPrefs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325552\n", "files": ["toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/unit/test_Migrations.js", "toolkit/components/normandy/Normandy.sys.mjs", "toolkit/components/normandy/NormandyMigrations.sys.mjs", "toolkit/components/normandy/docs/data-collection.md", "toolkit/components/normandy/lib/AddonRollouts.sys.mjs", "toolkit/components/normandy/lib/AddonStudies.sys.mjs", "toolkit/components/normandy/lib/ClientEnvironment.sys.mjs", "toolkit/components/normandy/lib/PreferenceExperiments.sys.mjs", "toolkit/components/normandy/lib/PreferenceRollouts.sys.mjs", "toolkit/components/normandy/lib/RecipeRunner.sys.mjs", "toolkit/components/normandy/lib/Storage.sys.mjs", "toolkit/components/normandy/lib/TelemetryEvents.sys.mjs", "toolkit/components/normandy/test/NormandyTestUtils.sys.mjs", "toolkit/components/normandy/test/browser/addons/normandydriver-a-1.0/manifest.json", "toolkit/components/normandy/test/browser/addons/normandydriver-a-2.0/manifest.json", "toolkit/components/normandy/test/browser/addons/normandydriver-b-1.0/manifest.json", "toolkit/components/normandy/test/browser/browser.toml", "toolkit/components/normandy/test/browser/browser_AddonRollouts.js", "toolkit/components/normandy/test/browser/browser_AddonStudies.js", "toolkit/components/normandy/test/browser/browser_ClientEnvironment.js", "toolkit/components/normandy/test/browser/browser_Normandy.js", "toolkit/components/normandy/test/browser/browser_PreferenceExperiments.js", "toolkit/components/normandy/test/browser/browser_PreferenceRollouts.js", "toolkit/components/normandy/test/browser/browser_Storage.js", "toolkit/components/normandy/test/browser/browser_actions_ShowHeartbeatAction.js", "toolkit/components/normandy/test/browser/head.js", "toolkit/components/normandy/test/browser/moz.build", "toolkit/components/normandy/test/create_xpi.py", "toolkit/components/normandy/test/unit/test_Normandy.js", "toolkit/content/aboutSupport.js", "toolkit/modules/Troubleshoot.sys.mjs", "toolkit/modules/tests/browser/browser_Troubleshoot.js"], "git_node": "24e934fa53cbedcee32e3fe76f451208abd4cae8", "git_parents": ["0f51239e5f43d68cae2370ca4e403965d1cda63b"], "node": "bff361172a13dc999c227b7382006a3d7a4b2182", "parents": ["ce03dcfa61b80dfb24e1a633f4d8a0badcb805db"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2076510 - Skip test_protocolproxyservice.js and test_enterprise_roots.js on macOS VMs. r=aryx,necko-reviewers,kershaw\n\nBoth fail every run on the macOS 15 AArch64 VM pool, which the try push for bug 2076017 did not run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329832\n", "files": ["netwerk/test/unit/xpcshell.toml", "security/manager/ssl/tests/unit/xpcshell.toml"], "git_node": "88a18403528fa7d65d82417f1ab735d8a7a298a4", "git_parents": ["24e934fa53cbedcee32e3fe76f451208abd4cae8"], "node": "24527c4893afdd93155f49fc48897ecb81c46700", "parents": ["bff361172a13dc999c227b7382006a3d7a4b2182"], "tags": []}, {"author": "Dave Townsend \u003cdtownsend@oxymoronical.com\u003e", "branch": "default", "desc": "Bug 2074033: Override shared application data directories in xpcshell tests. r=ahal,win-reviewers,migration-reviewers,jhirsch,mconley,handyman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327775\n", "files": ["browser/components/backup/tests/xpcshell/head.js", "browser/components/backup/tests/xpcshell/test_BackupService_enable_disable_encryption.js", "browser/components/migration/tests/unit/head_migration.js", "browser/components/shell/test/unit/test_customIconManager.js", "testing/xpcshell/runxpcshelltests.py", "toolkit/components/backgroundtasks/BackgroundTasksTestUtils.sys.mjs", "toolkit/profile/test/xpcshell/head.js", "toolkit/profile/test/xpcshell/test_invalid_descriptor.js", "toolkit/xre/nsXREDirProvider.cpp", "widget/windows/tests/unit/test_windows_alert_service.js"], "git_node": "09dff3d7d01722585da721f72fafc06008db9a4b", "git_parents": ["88a18403528fa7d65d82417f1ab735d8a7a298a4"], "node": "612ef2035f5dcaef564b694f6526143aaefc0ea8", "parents": ["24527c4893afdd93155f49fc48897ecb81c46700"], "tags": []}], "date": 1790804587, "git_changesets": ["eadc6ab534cacf743a3becfd11667ae80fbfe01c", "084739c10aafd42fa321db332659f9f4db305a56", "54d9999691f71e95daaaddcd980edbffc3b905b9", "c0dddd155fdc05245da7d7ef10bd0c4d6cf873b4", "e99653056624be68e0e34705553ba7486e49a38b", "7b33b38397fa93f6902cdf00874e4002a34cef1b", "57c3f4e2ba4adf5f415991cd02887dbd3dbe8680", "55e81b9afbd1e6ca2b286ebb8d5798f90d2039db", "7241acfee727a8b0a993a32926834d522e55bc57", "eab9d325199c91cb607b87da5a76ea145ae388a1", "a81cf2e599bac99505648dffed64f51418f534d0", "7ec48cf17455383a58cac5333987aaa5041e2c24", "f501ef1617e86d6910da7e34a67d97c617364b22", "4a3e4ad498639bfe5d6fe016574c9ef4597b3096", "91de7c72bccac01be2a1901dffdd55eea3cd0199", "a7482b1babe9741e8e33beb370f6f038b6dbc2fa", "95fdf608df3a6b747bf7e8909651e81f1ab184b9", "ee43b686708555efe1ffc9d7c1cae8367da9d77c", "42231562f124d2bb7a0a327880b42f4b7c9d51a9", "39f55f02f718019e021f880f611ec62cad9f2982", "cf1e515a60be31cb1785e3f0efa1983a39fa50f9", "375a137c2ea63527a2d217d1465b6514085437e8", "88457f76e191b399958e028663c82995e1215327", "80a5dc5a0c25e13e75fff0929fdabed04e4d4d32", "8552664d9a3bc046a273d5ef4ee2780ee0e1550d", "122db3c5ba277a74ca1058809dc9090628467a0f", "1d88fcebfcccbba062031d4d26c7c74f96066d32", "9c12fd67a