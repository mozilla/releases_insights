res/values-sk/strings.xml", "mobile/android/fenix/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rCN/strings.xml", "mobile/android/fenix/app/src/main/res/values-zh-rTW/strings.xml", "mobile/android/focus-android/app/src/main/res/values-co/strings.xml", "mobile/android/focus-android/app/src/main/res/values-cs/strings.xml", "mobile/android/focus-android/app/src/main/res/values-cy/strings.xml", "mobile/android/focus-android/app/src/main/res/values-de/strings.xml", "mobile/android/focus-android/app/src/main/res/values-dsb/strings.xml", "mobile/android/focus-android/app/src/main/res/values-el/strings.xml", "mobile/android/focus-android/app/src/main/res/values-en-rGB/strings.xml", "mobile/android/focus-android/app/src/main/res/values-es-rAR/strings.xml", "mobile/android/focus-android/app/src/main/res/values-eu/strings.xml", "mobile/android/focus-android/app/src/main/res/values-fa/strings.xml", "mobile/android/focus-android/app/src/main/res/values-fr/strings.xml", "mobile/android/focus-android/app/src/main/res/values-hsb/strings.xml", "mobile/android/focus-android/app/src/main/res/values-it/strings.xml", "mobile/android/focus-android/app/src/main/res/values-kk/strings.xml", "mobile/android/focus-android/app/src/main/res/values-nb-rNO/strings.xml", "mobile/android/focus-android/app/src/main/res/values-nl/strings.xml", "mobile/android/focus-android/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/focus-android/app/src/main/res/values-ru/strings.xml", "mobile/android/focus-android/app/src/main/res/values-sk/strings.xml", "mobile/android/focus-android/app/src/main/res/values-sv-rSE/strings.xml", "mobile/android/focus-android/app/src/main/res/values-zh-rTW/strings.xml"], "git_node": "a5eb4429093b10ccdb78fc5c94439a61b881e6e1", "git_parents": ["0c560faeeecc47b9d6512100395736f8260dbfa6"], "node": "d954cc37ae348d7990c3a41eac2ba3d452ba995a", "parents": ["af47ca3386c7a8516571d58cc4e8746d90b435a5"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1981768 - Log HSTS and HTTPS RR connection upgrades to the web console. r=valentin,necko-reviewers\" for causing dt failures @browser_webconsole_filters.js.\n\nThis reverts commit 25429cef17b5be0f41404db8ff739011c85f5c30.\n", "files": ["dom/locales/en-US/chrome/security/security.properties", "dom/security/test/https-only/browser.toml", "dom/security/test/https-only/browser_hsts_host.js", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/test/browser/browser_mock_https_rr.js"], "git_node": "cc61e19186c1f44ecd47918c96514b1f13152b5e", "git_parents": ["a5eb4429093b10ccdb78fc5c94439a61b881e6e1"], "node": "7e23b9f19b9dc5b72ce5938d5a0a517f1b0dce57", "parents": ["d954cc37ae348d7990c3a41eac2ba3d452ba995a"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2079024 - Re-enable geckoview-junit tests that no longer need their fission skip r=geckoview-reviewers,ohall\" for causing gv-junit failures.\n\nThis reverts commit 473a2c3688cd4d3beaf739804ec1024a7e8fb570.\n", "files": ["mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/GeckoSessionTestRuleTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/NavigationDelegateTest.kt", "mobile/android/geckoview/src/androidTest/java/org/mozilla/geckoview/test/ScreenshotTest.kt"], "git_node": "3d880c8a4e202f69812ba501fba8eeda03a45abe", "git_parents": ["cc61e19186c1f44ecd47918c96514b1f13152b5e"], "node": "379c53c05f2d6b00fa5eacfb6e4caec955ecea88", "parents": ["7e23b9f19b9dc5b72ce5938d5a0a517f1b0dce57"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2070879 - Wait for frame construction before considering document speculation rules. r=smaug,dom-core-reviewers\" for causing wpt failures @document-rules.https.html.\n\nThis reverts commit 408aa33592d1b138e5a8a79f9adee1964ddd6a38.\n", "files": ["dom/base/SpeculationRuleSet.cpp", "dom/base/SpeculationRuleSet.h", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "dom/base/speculationrules/lib.rs", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/implicit-source.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/inline-speculation-rules-after-stylesheet.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-from-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy.https.html.ini"], "git_node": "cc42fa9be3dd232d263c1ffe8397c4257269091c", "git_parents": ["3d880c8a4e202f69812ba501fba8eeda03a45abe"], "node": "50228fb7b4d315a2d347bfd64c100913789e9a1a", "parents": ["379c53c05f2d6b00fa5eacfb6e4caec955ecea88"], "tags": []}, {"author": "Chun-Min Chang \u003cchun.m.chang@gmail.com\u003e", "branch": "default", "desc": "Bug 2073468 - Run Chrome's video capture service in the browser process for the WebCodecs tests on Windows r=perftest-reviewers,sparky\n\nOn Windows, the out-of-process video capture service crashes shortly\nafter it starts capturing from the fake device. A crash before the first\nframe hangs the page, while a crash after it leaves Chrome caching an\nempty camera list for the rest of the session, so later cycles report\n\"No video input device found\".\n\nRunning the fake camera in the browser process to work around the\ncrashes for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331329\n", "files": ["taskcluster/kinds/browsertime/desktop.yml"], "git_node": "a5b77cc43f98b086b5868d975e35332bc7bd4d57", "git_parents": ["cc42fa9be3dd232d263c1ffe8397c4257269091c"], "node": "f7e9812ae440a81add4143aed4ade5ffdbe34596", "parents": ["50228fb7b4d315a2d347bfd64c100913789e9a1a"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078497 - Clocks widget menu button overlaps the clocks on hover. r=nina-py\n\nThe menu button overlapped the top clock on hover. Small widgets now shrink the clock list to make room, medium widgets no longer shift, and large widgets with three or four clocks start the list 16px lower.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331672\n", "files": ["browser/extensions/newtab/content-src/components/Widgets/Clocks/_Clocks.scss"], "git_node": "61f2aa3fcf36b87417ec685246fec101dfa768e2", "git_parents": ["a5b77cc43f98b086b5868d975e35332bc7bd4d57"], "node": "0d287763b2b2e33fcaced34b400e23bafdd05b8f", "parents": ["f7e9812ae440a81add4143aed4ade5ffdbe34596"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2079244 - Don't assert in PdfStructTreeBuilder if we haven't built the tree. r=accessibility-platform-reviewers,Jamie\n\nIn bug 2036950, I'm considering adding an SkPdf-like back-end for\nwindows printing.\n\nFor that, we don't really need the pdf struct tree (it'd also be\nconfusing to build it just to throw it away), but since it's based\non skia, we still record and replay the accessible id calls.\n\nAvoid crashing in the case we haven't built the tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331588\n", "files": ["accessible/pdf/PdfStructTreeBuilder.cpp", "accessible/pdf/PdfStructTreeBuilder.h"], "git_node": "7f28d390e32563b740593cc172b02cb416853e95", "git_parents": ["61f2aa3fcf36b87417ec685246fec101dfa768e2"], "node": "a8b830ff0b72120d4cc32e3f0708ecdd2192eac8", "parents": ["0d287763b2b2e33fcaced34b400e23bafdd05b8f"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079515 - Update Gradle to version 9.8.1. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331830\n", "files": ["gradle/wrapper/gradle-wrapper.jar", "gradle/wrapper/gradle-wrapper.properties", "mobile/android/android-components/gradle/wrapper/gradle-wrapper.jar", "mobile/android/android-components/gradle/wrapper/gradle-wrapper.properties", "mobile/android/fenix/gradle/wrapper/gradle-wrapper.jar", "mobile/android/fenix/gradle/wrapper/gradle-wrapper.properties", "mobile/android/focus-android/gradle/wrapper/gradle-wrapper.jar", "mobile/android/focus-android/gradle/wrapper/gradle-wrapper.properties"], "git_node": "5c08f42e825fcb21075a968d42db72489ff14a51", "git_parents": ["7f28d390e32563b740593cc172b02cb416853e95"], "node": "2a37abf2c434c473b7cdcdebc31e849236629bf3", "parents": ["a8b830ff0b72120d4cc32e3f0708ecdd2192eac8"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2078673 - Implement LSX-based CharacterDataBuffer FirstNon8Bit() acceleration. r=dom-core-reviewers,smaug\n\nSince the vendored xsimd does not support LoongArch LSX yet, the pattern\nis learned from CharacterDataBufferVMX.cpp.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331254\n", "files": ["dom/base/CharacterDataBuffer.cpp", "dom/base/CharacterDataBufferLSX.cpp", "dom/base/moz.build"], "git_node": "d23a59b5ad62ba7d201494d275a51bc775701e8b", "git_parents": ["5c08f42e825fcb21075a968d42db72489ff14a51"], "node": "f345f60b2fc059ec0f1b62f43a0b0aeb1b794010", "parents": ["2a37abf2c434c473b7cdcdebc31e849236629bf3"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2078558 - [loong64] Part 1: Simplify integer materialization in MacroAssembler::allTrueInt8x16. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331115\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h"], "git_node": "2d12f13413a9c5de1cb345d0fcebb9a9a064d91f", "git_parents": ["d23a59b5ad62ba7d201494d275a51bc775701e8b"], "node": "e4d5762d3846a2c8f20c30d87a0ba4c7826be558", "parents": ["f345f60b2fc059ec0f1b62f43a0b0aeb1b794010"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2078558 - [loong64] Part 2: Simplify 0x4000 const value materialization via VLDI in MacroAssembler::q15MulrSatInt16x8. r=yury\n\nThis value is friendly to various modes like BroadcastU8Shl16To32.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331116\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h"], "git_node": "790436d2a1e975518ff078a2b04bcd7fdfe63e3e", "git_parents": ["2d12f13413a9c5de1cb345d0fcebb9a9a064d91f"], "node": "85b757312ac3d2719d9d774083cb77ecec21be53", "parents": ["e4d5762d3846a2c8f20c30d87a0ba4c7826be558"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2078558 - [loong64] Part 3: Add {,dis}assembly support for VREPLVEI.[BHWD]. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331117\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/disasm/Disasm-loong64.cpp"], "git_node": "a1594a9249ae33126475f26770fe098a2fabb7b7", "git_parents": ["790436d2a1e975518ff078a2b04bcd7fdfe63e3e"], "node": "51654cf020666d54f70ea07fcfb816e94fcdcb69", "parents": ["85b757312ac3d2719d9d774083cb77ecec21be53"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2078558 - [loong64] Part 4: Use VREPLVEI.[BHWD] for vector broadcasts. r=yury\n\nThis removes some false dependencies, and is generally more readable than\nmagic constants.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331118\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h"], "git_node": "9e9e3b72431a8e48bf430c219bcd06d7a8344ecc", "git_parents": ["a1594a9249ae33126475f26770fe098a2fabb7b7"], "node": "6b455717f771324640d49fd161207505665930e3", "parents": ["51654cf020666d54f70ea07fcfb816e94fcdcb69"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2078558 - [loong64] Part 5: Add {,dis}assembly support for VPCNT.[HWD]. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331119\n", "files": ["js/src/jit/loong64/Assembler-loong64.cpp", "js/src/jit/loong64/Assembler-loong64.h", "js/src/jit/loong64/disasm/Disasm-loong64.cpp"], "git_node": "e88de0411c7c099ba62f69b1b726bc13ae7e34d8", "git_parents": ["9e9e3b72431a8e48bf430c219bcd06d7a8344ecc"], "node": "090f0a7e7666b87927a99245757dd51f4799fd7f", "parents": ["6b455717f771324640d49fd161207505665930e3"], "tags": []}, {"author": "Rong Bao \u003cwebmaster@csmantle.top\u003e", "branch": "default", "desc": "Bug 2078558 - [loong64] Part 6: Use VPCNT.[WD] for scalar popcount. r=yury\n\nOn a Loongson 3B6000 (LA664, 12C24T), the vector popcount is more\nbeneficial than the current SWAR implementation:\n\n        Case            Scalar          VPCNT.[WD]\n        popcnt64        3.048, 0.136    0.914, 0.001\n        popcnt32        2.929, 0.128    0.914, 0.036\n\n... where cells are (geomean, std. dev.) in nanoseconds and N=6000.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331120\n", "files": ["js/src/jit/loong64/MacroAssembler-loong64-inl.h"], "git_node": "0bad3e628ce6130afec845d319fd0bba91df6a8a", "git_parents": ["e88de0411c7c099ba62f69b1b726bc13ae7e34d8"], "node": "d9e5ca389be5433cd357088d7c8e92aa6532c440", "parents": ["090f0a7e7666b87927a99245757dd51f4799fd7f"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2077571 - jit/arm64: fold shifts and rotates into the second operand of add, orr and eor in MacroAssembler emitters. r=iain\n\nAArch64 add, orr and eor can shift or rotate their second register operand\nby a constant for free. Add MacroAssembler helpers that compute\nsrcDest = (srcDest shifted or rotated) op src, which are one instruction on\narm64 and the existing shift and op elsewhere, and use them in the SipHash\nrounds for Map and Set object keys, both megamorphic cache shape hashes,\nlookupStaticString and EmitInitDependentStringBase.\n\nIn the arm64 code generated while running JetStream 3, this removes about\n8,300 instructions:\n\n                                   Ion   Baseline\n  SipHash ror + eor              3,183        192\n  megamorphic shape hash         2,652         49\n  lookupStaticString lsl + add   1,136          -\n  dependent string flags         1,120          -\n\nFound with armlint.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330421\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/MacroAssembler-arm-inl.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/wasm32/MacroAssembler-wasm32-inl.h", "js/src/jit/x86-shared/MacroAssembler-x86-shared-inl.h"], "git_node": "318b5e8cda595f9517fe4328eb3a7d7c4edf7f7a", "git_parents": ["0bad3e628ce6130afec845d319fd0bba91df6a8a"], "node": "a0d5c775aa1eab4cade07d25d0a41a0c5b2c6070", "parents": ["d9e5ca389be5433cd357088d7c8e92aa6532c440"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061899 - Part 1: Create a compose-base Dropdown2 with Material3 specs r=android-reviewers,007\n\nThis patch creates a new dropdown that is not consumed by anything yet. The migration of the current dropdown to the new dropdown will be handled in follow ups\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326605\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/Dropdown2.kt", "mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/menu/DropdownMenu.kt", "mobile/android/android-components/components/compose/base/src/test/java/mozilla/components/compose/base/Dropdown2Test.kt"], "git_node": "0af35ef6d6365ba33f5ce28166840f80cd563af1", "git_parents": ["318b5e8cda595f9517fe4328eb3a7d7c4edf7f7a"], "node": "b31802ebad1f9915b2b4a82b212853ffc2913fc8", "parents": ["a0d5c775aa1eab4cade07d25d0a41a0c5b2c6070"], "tags": []}, {"author": "Nicholas Poon \u003cnpoon@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061899 - Part 2: Deprecate compose-base Dropdown r=android-reviewers,007\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326606\n", "files": ["mobile/android/android-components/components/compose/base/src/main/java/mozilla/components/compose/base/Dropdown.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/debugsettings/gleandebugtools/ui/GleanDebugToolsScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/address/ui/edit/EditAddressScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/creditcards/ui/CreditCardEditorScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/doh/root/DohSettingsScreen.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/translations/TranslationsDialogBottomSheet.kt"], "git_node": "cd0abc34d0fc79939c3c6240c767815195f55f0b", "git_parents": ["0af35ef6d6365ba33f5ce28166840f80cd563af1"], "node": "40bf3223d8ed08e8cf0f41ebe9f3725564f107f8", "parents": ["b31802ebad1f9915b2b4a82b212853ffc2913fc8"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "c59af0269e92f30009817600d0efa139acbf7278", "git_parents": ["cd0abc34d0fc79939c3c6240c767815195f55f0b", "59c8a945f229e17d78d091d82f1624494e2c5006"], "node": "4dbc4a615b04f1b5378dcd1bc9a1eb9f15d8aa38", "parents": ["40bf3223d8ed08e8cf0f41ebe9f3725564f107f8", "1fe19376259ef81a318f5dd69e1b52b0d1430569"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060322 - Record topsite and pocket clicks for links Firefox opens from newtab r=jbrown\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317647\n", "files": ["browser/components/newtab/metrics.yaml", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/DSCard/DSCard.jsx", "browser/extensions/newtab/content-src/components/DiscoveryStreamComponents/SafeAnchor/SafeAnchor.jsx", "browser/extensions/newtab/content-src/lib/link-menu-options.mjs", "browser/extensions/newtab/lib/TelemetryFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser.toml", "browser/extensions/newtab/test/browser/browser_context_menu_link_open.js", "browser/extensions/newtab/test/browser/link_open_stories.json", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/DSCard.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/DiscoveryStreamComponents/SafeAnchor.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/LinkMenu.test.jsx", "browser/extensions/newtab/test/xpcshell/test_TelemetryFeed.js"], "git_node": "d36bc9239569dd2135b5a8df810a92defcc47c8e", "git_parents": ["c59af0269e92f30009817600d0efa139acbf7278"], "node": "bb9134fcdd5a9452840a72bcbda2f8f89d84f5ba", "parents": ["4dbc4a615b04f1b5378dcd1bc9a1eb9f15d8aa38"], "tags": []}, {"author": "Vasish Baungally \u003cvbaungally@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078326 - Move AutoTabGrouping ftl file for Localization. r=jlewis,fluent-reviewers,bolsson\n\nAutoTabGrouping will be enabled for FR locales. This patch moves the autoTabGrouping.ftl\nfile from locales preview to the locales/en-US/browser folder.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331648\n", "files": ["browser/base/content/browser.xhtml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_group_tabs_button_tab_management.js", "browser/locales-preview/autoTabGrouping.ftl", "browser/locales/en-US/browser/autoTabGrouping.ftl", "browser/locales/jar.mn"], "git_node": "1fcb10338036f7b934880d2e971715fffb7b4476", "git_parents": ["d36bc9239569dd2135b5a8df810a92defcc47c8e"], "node": "824a8d065751bb66f87291fc3ea6918074d9bafe", "parents": ["bb9134fcdd5a9452840a72bcbda2f8f89d84f5ba"], "tags": []}, {"author": "Jack Brown \u003cjbrown@mozilla.com\u003e", "branch": "default", "desc": "Bug 2057030 - Forget a tab's New Tab message when its page unloads. r=omc-reviewers,ini,emcminn\n\nWe don't show a new message, like a pop-up tip or a callout, in a tab that's already showing one. New Tab can show messages too, and it keeps a list of the tabs that have one up.\n\nThe issue is that a tab only came off that list when the user closed or dismissed the message. If they just went to another site, the tab stayed on the list. From then on, Firefox thought that tab was still showing a New Tab message, and blocked other messages there until the tab was closed. This started with bug 1974328.\n\nNew Tab already tells the rest of Firefox when its page goes away, but nothing connected that to the list. This patch passes along which tab it was, and takes that tab off the list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329837\n", "files": ["browser/components/asrouter/tests/browser/browser_asrouter_newtab_messages.js", "browser/extensions/newtab/lib/ActivityStreamMessageChannel.sys.mjs", "browser/extensions/newtab/lib/NewTabMessaging.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStreamMessageChannel.test.js", "browser/extensions/newtab/test/xpcshell/test_NewTabMessaging.js"], "git_node": "a48cad2424a558d84b0a8a7570563dd0e09e9ca8", "git_parents": ["1fcb10338036f7b934880d2e971715fffb7b4476"], "node": "16c828e527da0899c6fa7b3d2052c760d75617e0", "parents": ["824a8d065751bb66f87291fc3ea6918074d9bafe"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074916 - Add prescan and scan to the SERP impression event, and report ad_uncategorized in ad_impression - r=search-reviewers,scunnane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331235\n", "files": ["browser/actors/SearchSERPTelemetryChild.sys.mjs", "browser/components/search/SearchSERPTelemetry.sys.mjs", "browser/components/search/metrics.yaml", "browser/components/search/test/browser/telemetry/browser.toml", "browser/components/search/test/browser/telemetry/browser_search_telemetry_abandonment.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_adImpression_component_skipCount_children.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_adImpression_component_skipCount_parent.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_engagement_fast_ad_click.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impressionAttributes.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impression_interrupted_load.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_impression_scan.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_post_engine.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_sources_ads.js", "browser/components/search/test/browser/telemetry/browser_search_telemetry_visualSearch.js", "browser/components/search/test/browser/telemetry/head.js", "browser/components/search/test/unit/test_urlTelemetry_generic.js", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "f2c2ad43eaccc0a0450481c50308e2243f7d56a3", "git_parents": ["a48cad2424a558d84b0a8a7570563dd0e09e9ca8"], "node": "d1d652edcb0e0653ff033ab9fc1e57cadae75497", "parents": ["16c828e527da0899c6fa7b3d2052c760d75617e0"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027309: Add test. r=morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301260\n", "files": ["accessible/tests/browser/text/browser_text.js"], "git_node": "65a877d4b832cfd4ee250d4ac968db0cafe0437c", "git_parents": ["f2c2ad43eaccc0a0450481c50308e2243f7d56a3"], "node": "8e5ae2fe2c53821593503bdb4e734e88b6ae8f04", "parents": ["d1d652edcb0e0653ff033ab9fc1e57cadae75497"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053637: Add test. r=morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311777\n", "files": ["accessible/tests/browser/text/browser_text.js"], "git_node": "9e0db3e2a9af753641a8f6aaff29c7d1fe751be5", "git_parents": ["65a877d4b832cfd4ee250d4ac968db0cafe0437c"], "node": "061d537425689b77e33f5d6ded8f7286dd54d6df", "parents": ["8e5ae2fe2c53821593503bdb4e734e88b6ae8f04"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029511: Add test. r=morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D294326\n", "files": ["accessible/tests/browser/windows/ia2/browser_accSelection.js"], "git_node": "25b7ff9e491be0becc764ec76cdbe5423d43a440", "git_parents": ["9e0db3e2a9af753641a8f6aaff29c7d1fe751be5"], "node": "0616eac9157641a8e90b08122cb7ec21d2309572", "parents": ["061d537425689b77e33f5d6ded8f7286dd54d6df"], "tags": []}, {"author": "James Teh \u003cjteh@mozilla.com\u003e", "branch": "default", "desc": "Bug 2053587: Add test. r=morgan\n\nDifferential Revision: https://phabricator.services.mozilla.com/D311456\n", "files": ["accessible/tests/browser/e10s/browser_caching_table.js"], "git_node": "0a67b0fc3aad411b8a929ca4402c35a74aa338ff", "git_parents": ["25b7ff9e491be0becc764ec76cdbe5423d43a440"], "node": "6ee3d8f6e3285e706a55c74af1cf5f817b8e49f4", "parents": ["0616eac9157641a8e90b08122cb7ec21d2309572"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2079183 - Fix pending frame handling in AndroidImageReader::DoUpdateTexImage() r=gfx-reviewers,lsalzman\n\nTries to acquire pending frame even after timeout, since it should exist in AImageReqader.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331535\n", "files": ["gfx/layers/AndroidImageReader.cpp", "gfx/layers/AndroidImageReader.h"], "git_node": "de8522162153f621c02b5f0d9d0391bba65a3fff", "git_parents": ["0a67b0fc3aad411b8a929ca4402c35a74aa338ff"], "node": "a6b79be1a7e85cc9165700b5ee39bb99d2f79291", "parents": ["6ee3d8f6e3285e706a55c74af1cf5f817b8e49f4"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2078292 - Visit each reader once when ordering a backdrop's filter chain readers. r=gfx-reviewers,lsalzman\n\nA task reached at two depths of the chain was visited twice, and the second\nvisit walked into the new task and added it as a dependency of itself.\n\nThis code is removed by the backdrop-filter capture series (bug 2079475), so\nthis fix becomes obsolete once that lands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331818\n", "files": ["gfx/wr/webrender/src/surface.rs"], "git_node": "468e5abfd486b0629f7503f0908a2f8a523e4682", "git_parents": ["de8522162153f621c02b5f0d9d0391bba65a3fff"], "node": "0947dd190f626e4d8942af2eb79aa4dac546bf63", "parents": ["a6b79be1a7e85cc9165700b5ee39bb99d2f79291"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079501. r=gfx-reviewers,gw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331877\n", "files": ["gfx/layers/wr/WebRenderMessageUtils.h", "gfx/wr/webrender/src/resource_cache.rs"], "git_node": "8e4d96b50cecadc0abe0ccb7867c0efe94bb5a87", "git_parents": ["468e5abfd486b0629f7503f0908a2f8a523e4682"], "node": "faa622f07f16ba67722ca04c53e9da44227db94e", "parents": ["0947dd190f626e4d8942af2eb79aa4dac546bf63"], "t