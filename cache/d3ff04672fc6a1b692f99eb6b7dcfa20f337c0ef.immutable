-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-explicit-block.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-track-sizing-span-row.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/grid-lanes-within-flexbox-indefinite-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-002.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-003.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/track-sizing/row-track-sizing-004.html.ini", "testing/web-platform/tests/css/css-grid/grid-lanes/grid-placement/grid-lanes-grid-placement-named-lines-001-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/grid-placement/grid-lanes-grid-placement-named-lines-001.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/column-negative-margin-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/column-negative-margin-003.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/row-negative-margin-003-ref.html", "testing/web-platform/tests/css/css-grid/grid-lanes/item-placement/row-negative-margin-003.html"], "git_node": "4d27cc793aa9a0139029d52441eda79456c786df", "git_parents": ["ea4b2776002e1c021040b42f810a9a4195409b6a"], "node": "a0e0962524bb49ae5ee8c4c83cdb30b7eae4c4bf", "parents": ["a8a8a98cebde6671c5e6bdb45cfcbe40d8b25a41"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074532 - Classify removed-files entries in make_incremental_zucchini. r=releng-reviewers,jcristau\n\nappend_remove_instructions emitted remove \"\u003cline\u003e\" for every line of the\ntarget's removed-files, including directory entries, glob entries, comments\nand blank lines. common.sh classifies instead: a trailing slash becomes\nrmdir, a trailing /* becomes rmrfdir with the star stripped, and comments and\nblank lines are skipped.\n\nThe unclassified forms are not merely untidy. A directory entry reaches\nRemoveFile::Prepare, which finds the path is not a regular file and returns\nDELETE_ERROR_EXPECTED_FILE; a blank line makes RemoveFile::Parse return\nPARSE_ERROR. ActionList::Prepare stops at the first failing action, so either\none aborts the update before any modification and drops the user back to a\ncomplete update. A /* entry silently does nothing.\n\nThe function read the file through a NamedTemporaryFile that it opened twice,\nonce for xz to write into and once for itself to read from, which a test\ncannot replace and which does not work on Windows. It now reads through the\nexisting get_text_from_compressed helper, which is the seam the new test\nuses. That also puts the file's contents in the helper's functools.cache,\nunder the to-MAR path shared by every partial of a build: one entry,\nread-only, and the same text every caller would have decompressed for itself.\n\nA comment line is appended to the two removed-files fixtures, which had no\ncoverage of the skip case.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328483\n", "files": ["tools/update-packaging/make_incremental_zucchini.py", "tools/update-packaging/test/test_make_incremental_zucchini.py", "tools/update-packaging/test/to-mac/Contents/Resources/removed-files", "tools/update-packaging/test/to/removed-files"], "git_node": "052e25cfe44e0517f06b5311f23dea324b20a182", "git_parents": ["4d27cc793aa9a0139029d52441eda79456c786df"], "node": "66a904da386c5cc9d212274248b677906d236805", "parents": ["a0e0962524bb49ae5ee8c4c83cdb30b7eae4c4bf"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074532 - Fall back to the bundle-relative removed-files in make_incremental_zucchini. r=releng-reviewers,jcristau\n\nappend_remove_instructions only read \u003cto_mar_dir\u003e/removed-files, whereas\ncommon.sh's version falls back to \u003cto_mar_dir\u003e/Contents/Resources/removed-files.\nOn mac the bundle-relative path is the only place the file exists, so mac\nzucchini partials contained no removed-files instructions at all and nothing\nbrowser/installer/removed-files.in asks to be deleted was deleted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328484\n", "files": ["tools/update-packaging/make_incremental_zucchini.py", "tools/update-packaging/test/test_make_incremental_zucchini.py"], "git_node": "0cd793f14a1660aabe339600774b2f45ca963f90", "git_parents": ["052e25cfe44e0517f06b5311f23dea324b20a182"], "node": "3999c3024d009fd516ad79331a1604b17f4c99fb", "parents": ["66a904da386c5cc9d212274248b677906d236805"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073080 - Lint all dom/base headers through clang-tidy r=jjaschke\n\nChanges includes:\n- making deleted methods public\n- rework some include dependencies to make header self contained\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326947\n", "files": ["dom/base/AutocompleteFieldList.h", "dom/base/CharacterDataBufferImpl.h", "dom/base/DOMIntersectionObserver.h", "dom/base/Element.h", "dom/base/EventSource.h", "dom/base/IDTracker.h", "dom/base/IdentifierMapEntry.h", "dom/base/NodeInfo.h", "dom/base/NodeUbiReporting.cpp", "dom/base/RequestCallbackManager.h", "dom/base/ScreenLuminance.h", "dom/base/SelectionChangeEventDispatcher.h", "dom/base/StorageAccessPermissionRequest.h", "dom/base/StyledRange.h", "dom/base/TestUtils.h", "dom/base/nsContentPermissionHelper.h"], "git_node": "f75c0ff97fb8a5a47d6b027c2a569f5604b1cb5d", "git_parents": ["0cd793f14a1660aabe339600774b2f45ca963f90"], "node": "7407691495d3ac1baec9b1aa0307bb057f38c992", "parents": ["3999c3024d009fd516ad79331a1604b17f4c99fb"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2074275 - [remote] Apply recommended preferences on the default branch. r=webdriver-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328128\n", "files": ["remote/shared/RecommendedPreferences.sys.mjs", "remote/shared/test/xpcshell/test_RecommendedPreferences.js", "remote/webdriver-bidi/test/xpcshell/test_WebDriverBiDi_RecommendedPreferences.js", "testing/marionette/harness/marionette_harness/tests/unit/test_recommended_prefs.py", "testing/web-platform/mozilla/tests/webdriver/harness/preferences_remote_agent.py"], "git_node": "f381a40b0191b7de9753e2ba92e3cc79a72e23b6", "git_parents": ["f75c0ff97fb8a5a47d6b027c2a569f5604b1cb5d"], "node": "135a3f2888946ca18cd8a166903e1d84e8fda388", "parents": ["7407691495d3ac1baec9b1aa0307bb057f38c992"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074536 - Remove each partial's work directory once its mar is built in make_incremental_zucchini. r=releng-reviewers,jcristau\n\nmake_incremental_zucchini never deleted anything, so every partial's scratch\ntree - the downloaded from.mar, its extraction, the extracted patch-cache mar\nand the staging directory - survived until the task ended. Peak disk therefore\ngrew with the number of partials rather than staying constant, which makes\n\"no space left on device\" a plausible failure as partial counts grow.\n\nprocess_single now removes the per-partial work directory once the mar has been\nbuilt and its channel id validated. The shared to_mar extraction is kept, since\nevery partial reuses it, and the output mars and manifest.json are untouched.\n\nBoth failure paths leave the tree in place for debuggability, which is what\nmake_incremental_update.sh accidentally does by leaking its mktemp -d on each\nearly exit. A failure to reclaim the space is logged rather than raised: the\npartial is already built and valid at that point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328533\n", "files": ["tools/update-packaging/make_incremental_zucchini.py", "tools/update-packaging/test/test_make_incremental_zucchini.py"], "git_node": "4c2ac30f93d906d2d14e9aa5ae2efd48de67b905", "git_parents": ["f381a40b0191b7de9753e2ba92e3cc79a72e23b6"], "node": "db9d699ad5cf40ee833738973d90f7b39a8ef78c", "parents": ["135a3f2888946ca18cd8a166903e1d84e8fda388"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074537 - Mirror partials.py in the per-build fields of partials_zucchini. r=releng-reviewers,taskgraph-reviewers,jcristau\n\nThe partials-zucchini transform left update_number at 1 for every entry of\n--from-mars-json, so every entry of the emitted manifest.json claimed to be\nthe first partial. It also dropped the product and previousBuildNumber\npassthroughs that partials.py forwards to the partial generator. Mirror\npartials.py: increment update_number once per build, and forward both fields.\n\nmake_incremental_zucchini.py only read update_number, dest_mar, url and\npreviousVersion out of --from-mars-json, so previousBuildNumber would have\nreached the command line and been dropped before manifest.json. process_single\ntherefore also accepts it and puts it in the mar manifest, next to\npreviousVersion, which is what funsize does with the same field.\n\nproduct deliberately stops at the task definition. funsize accepts it in\npartial_def and never copies it into mar_data, so it does not reach\nmanifest.json on the bash side either, and manifest.json is what balrogscript\nconsumes. Forwarding it any further would make the zucchini path send balrog a\nfield the funsize path never sends, which would be a divergence to bash\nbehavior.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328564\n", "files": ["taskcluster/gecko_taskgraph/transforms/partials_zucchini.py", "tools/update-packaging/make_incremental_zucchini.py", "tools/update-packaging/test/test_make_incremental_zucchini.py"], "git_node": "e3f4838d83da7e172a071e6929ad771f5ff91190", "git_parents": ["4c2ac30f93d906d2d14e9aa5ae2efd48de67b905"], "node": "1bd98cc7aa05e1e69759a230a6779754e261dc76", "parents": ["db9d699ad5cf40ee833738973d90f7b39a8ef78c"], "tags": []}, {"author": "Rebecca King \u003crking@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074289 - Land strings for inclusions CFRs - r=fluent-reviewers,flod\n\nFigma: https://www.figma.com/design/1gH3lJ8YZ54mC8YBMOeEhu/Website-Rules?node-id=11077-34292&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328184\n", "files": ["browser/locales/en-US/browser/ipProtection.ftl", "python/l10n/fluent_migrations/bug_2074289_ipprotection_site_inclusions_callout_buttons.py"], "git_node": "ffb2e9b233d17c63077455757e99565600f8d2ae", "git_parents": ["e3f4838d83da7e172a071e6929ad771f5ff91190"], "node": "c08ba209b14ba096468bcbac836f01a9b66128b9", "parents": ["1bd98cc7aa05e1e69759a230a6779754e261dc76"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069112 - Add the AITab table component r=mlucks,fluent-reviewers,bolsson,vazish\n\nAdds \u003caitab-table\u003e, the RankedTable block of an AITab page: a heading, an optional description, a header row of column labels and one row per item. The first column shows the item's name, any subtitle-role columns beneath it, and a source chip (reusing ai-website-chip) for the page the item came from. Rows are separated by dividers and long text wraps inside its column.\n\nShips with a Storybook story and browser-chrome tests for the component.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325474\n", "files": ["browser/components/aiwindow/models/aitab/component_schema.json", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.css", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.mjs", "browser/components/aiwindow/ui/components/aitab-table/aitab-table.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_table.js", "browser/components/aiwindow/ui/test/browser/test_aitab_table.mjs", "browser/components/aiwindow/ui/test/browser/test_aitab_table_page.html", "browser/locales-preview/aiWindow.ftl"], "git_node": "6ff9948a38cafbc346ccd4d2df50a8f31670ff15", "git_parents": ["ffb2e9b233d17c63077455757e99565600f8d2ae"], "node": "cb8f1df8932bfaeb67a7943b5c134857266bea30", "parents": ["c08ba209b14ba096468bcbac836f01a9b66128b9"], "tags": []}, {"author": "unifolia \u003cjlewis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2061052 - Add the AITab highlights component r=mlucks\n\nAdds \u003caitab-highlights\u003e; aitab-page imports the component so the element is registered in about:smartpage; mounting it from a page config is bug 2070256.\n\nShips with a Storybook story and browser-chrome tests alongside the other block components.\n\nhttps://www.figma.com/design/sIgXsbSFZjKIcfErMoBgLr/Smart-Window-Q3?node-id=16343-22767&m=dev\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326308\n", "files": ["browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.css", "browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.mjs", "browser/components/aiwindow/ui/components/aitab-highlights/aitab-highlights.stories.mjs", "browser/components/aiwindow/ui/components/aitab-page/aitab-base.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-header/aitab-header.css", "browser/components/aiwindow/ui/components/aitab-page/aitab-page.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aitab_blocks.js"], "git_node": "94c524227145372fe71b9f477f76e0589a2e7b99", "git_parents": ["6ff9948a38cafbc346ccd4d2df50a8f31670ff15"], "node": "44e9bb38c9ec332cd239f9d4dd05cb1f717d96f8", "parents": ["cb8f1df8932bfaeb67a7943b5c134857266bea30"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074830 - Stop reporting partitioned tracker cookie reads as allowed tracker cookies. r=emz,cookie-reviewers,valentin\" for causing bc failures @ browser_protectionsUI_socialtracking.js\n\nThis reverts commit b641180e6138fe53c54654e600348cb5b5d52a1f.\n", "files": ["netwerk/cookie/CookieService.cpp", "netwerk/cookie/CookieService.h", "toolkit/components/antitracking/ContentBlockingNotifier.cpp", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_partitioned_cookies.js"], "git_node": "7b83edd9b350fc9b9b5b8e05bb4b687eb250614d", "git_parents": ["94c524227145372fe71b9f477f76e0589a2e7b99"], "node": "af56a4add9f5cad6051ac0d46d610d07ac35390f", "parents": ["44e9bb38c9ec332cd239f9d4dd05cb1f717d96f8"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 806757 - Move browser/components/safebrowsing/content/test/ to browser/base/content/test/browser-safebrowsing/. r=frontend-codestyle-reviewers,Standard8,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319116\n", "files": ["browser/base/content/test/browser-safebrowsing/browser.toml", "browser/base/content/test/browser-safebrowsing/browser_bug400731.js", "browser/base/content/test/browser-safebrowsing/browser_bug415846.js", "browser/base/content/test/browser-safebrowsing/browser_mixedcontent_aboutblocked.js", "browser/base/content/test/browser-safebrowsing/browser_whitelisted.js", "browser/base/content/test/browser-safebrowsing/empty_file.html", "browser/base/content/test/browser-safebrowsing/head.js", "browser/base/moz.build", "browser/components/moz.build", "browser/components/safebrowsing/content/test/browser.toml", "browser/components/safebrowsing/content/test/browser_bug400731.js", "browser/components/safebrowsing/content/test/browser_bug415846.js", "browser/components/safebrowsing/content/test/browser_mixedcontent_aboutblocked.js", "browser/components/safebrowsing/content/test/browser_whitelisted.js", "browser/components/safebrowsing/content/test/empty_file.html", "browser/components/safebrowsing/content/test/head.js", "eslint-rollouts.config.mjs", "eslint-test-paths.config.mjs", "tools/lint/rejected-words.yml"], "git_node": "964745cc99f6dec78c58bc2469fca6c0e9cf97da", "git_parents": ["7b83edd9b350fc9b9b5b8e05bb4b687eb250614d"], "node": "50175ccf14bc98e785666d7f6bae3f7ef3f1dd23", "parents": ["af56a4add9f5cad6051ac0d46d610d07ac35390f"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074026 - Always handle CSP before MixedContentBlocker. r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328118\n", "files": ["dom/base/nsContentPolicy.cpp", "dom/base/nsContentPolicy.h", "dom/security/test/mixedcontentblocker/browser.toml", "dom/security/test/mixedcontentblocker/browser_csp_before_mixed_content.js", "dom/security/test/mixedcontentblocker/file_csp_before_mixed_content.sjs", "layout/build/components.conf"], "git_node": "2a9780916b337e9e6e742e3c378fcf2542419b2a", "git_parents": ["964745cc99f6dec78c58bc2469fca6c0e9cf97da"], "node": "2927e30f008729231a503aa969a6cc39b817decd", "parents": ["50175ccf14bc98e785666d7f6bae3f7ef3f1dd23"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074026 - Remove legacy_constructor for nsContentPolicy. r=emilio,layout-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328119\n", "files": ["dom/base/nsContentPolicy.cpp", "dom/base/nsContentPolicy.h", "layout/build/components.conf", "layout/build/nsLayoutModule.cpp", "layout/build/nsLayoutModule.h"], "git_node": "63e2eab9e72e73d56a2f6e9c289a200f572830f4", "git_parents": ["2a9780916b337e9e6e742e3c378fcf2542419b2a"], "node": "9aa88a6d66f766c908d4443762c777adbceaf160", "parents": ["2927e30f008729231a503aa969a6cc39b817decd"], "tags": []}, {"author": "KS \u003ckshampur@mozilla.com\u003e", "branch": "default", "desc": "Bug 2033465 - remove broken tp6/tp6m sites r=perftest-reviewers,taskgraph-reviewers,sparky,bhearsum\n\nThis is phase 1, removing sites that are already disabled/broken and not\nproviding meaningful data in CI recordings.\n\n* facebook and facebook-cristiano (tp6m, have been disabled)\n* sina (tp6m, grey placeholders that never resolve)\n* facebook-nav (passes but replays a login wall)\n* twitch (video player and chat spinners never resolve)\n* nytimes (free article limit paywall consistently)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328663\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/browsertime/desktop.yml", "taskcluster/kinds/browsertime/mobile.yml", "testing/perfdocs/generated/raptor-metrics.md", "testing/perfdocs/generated/raptor.md", "testing/performance/pageload_sites.json", "testing/raptor/browsertime/pageload_sites.json", "testing/raptor/raptor/perfdocs/config.yml", "testing/raptor/raptor/tests/interactive/browsertime-responsiveness.toml", "testing/raptor/raptor/tests/tp6/desktop/browsertime-tp6.toml", "testing/raptor/raptor/tests/tp6/mobile/browsertime-tp6m.toml", "testing/raptor/raptor/tooltool-manifests/playback/mitm11-windows-firefox-facebook-nav.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-android-fenix-facebook-cristiano.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-g5-fenix-facebook.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm6-windows-firefox-facebook-nav.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm7-linux-firefox-nytimes.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm8-android-fenix-sina.manifest", "testing/raptor/raptor/tooltool-manifests/playback/mitm8-linux-firefox-twitch.manifest"], "git_node": "053c5beeab4ec42267c2394cc6b9b3cf060a9040", "git_parents": ["63e2eab9e72e73d56a2f6e9c289a200f572830f4"], "node": "1b875431181440646cd8bd461a8ba21bc805560b", "parents": ["9aa88a6d66f766c908d4443762c777adbceaf160"], "tags": []}, {"author": "Matthew Tighe \u003cmatthewdtighe@gmail.com\u003e", "branch": "default", "desc": "Bug 2064868 - force failures to recreate chunk files r=android-reviewers,moyin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328318\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/ListenMiddleware.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/fakes/Listen.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/AudioFileCache.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/ChunkAudio.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/playback/SynthesisJobPriorityLock.kt", "mobile/android/android-components/components/feature/listentopage/src/main/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueue.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/ListenMiddlewareTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/ChunkAudioTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/DirectoryAudioFileCacheTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/playback/SynthesisJobPriorityLockTest.kt", "mobile/android/android-components/components/feature/listentopage/src/test/java/mozilla/components/feature/listentopage/synthesis/SynthesisQueueTest.kt"], "git_node": "f577c6371184774184d77bc020eca636d6f7deba", "git_parents": ["053c5beeab4ec42267c2394cc6b9b3cf060a9040"], "node": "6507394acb43f4e434eeec8c1077142afbfbe84b", "parents": ["1b875431181440646cd8bd461a8ba21bc805560b"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2067819 - Validate policy URLs with the URL parser. r=bsmth\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328648\n", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_PolicySchemaValidator.js", "toolkit/components/enterprisepolicies/PolicySchemaValidator.sys.mjs", "toolkit/modules/JsonSchema.sys.mjs", "toolkit/modules/tests/xpcshell/test_JsonSchema.js"], "git_node": "732275e41c9b922299f319bc8121477643321ae4", "git_parents": ["f577c6371184774184d77bc020eca636d6f7deba"], "node": "f1e06f28ff29f2493a6b7afd4683a6cc05107b4e", "parents": ["6507394acb43f4e434eeec8c1077142afbfbe84b"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073802 - Remove vestigial sendAttributionRequest properties and dead partner_link telemetry from newtab and topsites code. r=thecount,jteow,chumphreys\n\nThis stuff is no longer used and just adds confusion. Bug 2070772 removed the PartnerLinkAttribution\nmodule and urlbar's last consumer, so the `sendAttributionRequest` top-site link property and the\n`partner_link` telemetry became fully dead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328512\n", "files": ["browser/components/topsites/TopSites.sys.mjs", "browser/extensions/newtab/lib/TopSitesFeed.sys.mjs", "browser/modules/metrics.yaml", "toolkit/components/telemetry/Events.yaml"], "git_node": "1a785ce0674ba8e41e87014558fb1aa91a595daa", "git_parents": ["732275e41c9b922299f319bc8121477643321ae4"], "node": "b9718eeb3f1635b4d8814d9252bec44244e86738", "parents": ["f1e06f28ff29f2493a6b7afd4683a6cc05107b4e"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2074877: Make BrowserParent use WeakPtr instead of nsIWeakReference. r=dom-core-reviewers,handyman,mfbt-reviewers,sergesanspaille,smaug\n\nWeakPtr::StableOrdering is needed because comparing 2 WeakPtr\u003cT\u003e will end up going\nthrough the implicit conversion to T*, which means that if the referents dies\nthen the order will get broken. nsWeakPtr, which is nsCOMPtr\u003cnsIWeakReference\u003e,\ndoes not have this issue. (For WeakPtr, WeakReference is not part of the API.)\n\nLessThan uses std::less because that defines a total ordering on pointers, while\noperator\u003c does not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328647\n", "files": ["dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "mfbt/WeakPtr.h", "mfbt/tests/TestWeakPtr.cpp", "widget/nsBaseDragService.cpp", "widget/nsBaseDragService.h"], "git_node": "9569a6bb2a67f9b92166c6d6ad36a3107b56fa13", "git_parents": ["1a785ce0674ba8e41e87014558fb1aa91a595daa"], "node": "62e2c0798df66b850fa42e254d668ed123882d4f", "parents": ["b9718eeb3f1635b4d8814d9252bec44244e86738"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2074392 - Avoid some work for no-op layout viewport size changes. r=layout-reviewers,dshin\n\nShort-circuit earlier rather than in FlushDelayedResize() if we can.\n\nThis saves some flushes on same-origin iframes that we can avoid. It\nshows up disproportionately in the profile from bug 2073737 because of\nthe profiler stack marker collection, but still worth it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328080\n", "files": ["layout/base/PresShell.cpp"], "git_node": "5428ec6891066bc40035599dee904404e803197c", "git_parents": ["9569a6bb2a67f9b92166c6d6ad36a3107b56fa13"], "node": "c3eff801b4fef020731e59159f751e030f1aaadf", "parents": ["62e2c0798df66b850fa42e254d668ed123882d4f"], "tags": []}, {"author": "Rob Wu \u003crob@robwu.nl\u003e", "branch": "default", "desc": "Bug 2052032 - Avoid redundant metadata update when locale is unchanged r=zombie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D310478\n", "files": ["toolkit/mozapps/extensions/AddonManager.sys.mjs", "toolkit/mozapps/extensions/internal/AddonRepository.sys.mjs", "toolkit/mozapps/extensions/test/xpcshell/test_AddonRepository_cache_locale.js"], "git_node": "192ae8c2d559d50c2c33d7e298a0f7c010f5784c", "git_parents": ["5428ec6891066bc40035599dee904404e803197c"], "node": "02c591d15d1ef0dacf359e5346b6a6327a4e5951", "parents": ["c3eff801b4fef020731e59159f751e030f1aaadf"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2074499 - Make sure update urlbar icon with non stale data. r=daisuke,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328452\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs", "browser/components/urlbar/tests/browser-results/browser_testUrlbarIcons.js"], "git_node": "adae6a8b5497e0fccf0c5862ff8fe943ac351888", "git_parents": ["192ae8c2d559d50c2c33d7e298a0f7c010f5784c"], "node": "e67e9711652f71341490f7c13eafec1a90009185", "parents": ["02c591d15d1ef0dacf359e5346b6a6327a4e5951"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068441: Make browsing context under printing browsing context not targetable. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327854\n", "files": ["docshell/base/BrowsingContext.cpp", "dom/base/crashtests/2068441.html", "dom/base/crashtests/crashtests.list"], "git_node": "a9b68b3667167737b520dd79dcd7ba178440dbdf", "git_parents": ["adae6a8b5497e0fccf0c5862ff8fe943ac351888"], "node": "0c581d21f726cffb17f39e4c188aa12d1a9dcd3b", "parents": ["e67e9711652f71341490f7c13eafec1a90009185"], "tags": []}, {"author": "Mike Conley \u003cmconley@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070336 - Remove the non-co-enrolling newtabTrainhopAddon Nimbus deployment mechanism. r=jbrown,beth,taskgraph-reviewers,nimbus-reviewers,bhearsum,ahal\n\nNow that newtab train-hop deployments have cut over to the co-enrolling\nnewtabTrainhopAddonDeployment feature (bug 1995391), we can safely\nretire the non-co-enrolling newtabTrainhopAddon mechanism.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324424\n", "files": ["browser/components/newtab/AboutNewTabResourceMapping.sys.mjs", "browser/components/newtab/test/xpcshell/head_nimbus_trainhop.js", "browser/components/newtab/test/xpcshell/test_AboutNewTabResourceMapping_entitledVersion.js", "browser/components/newtab/test/xpcshell/test_nimbus_newtabTrainhopAddon.js", "browser/components/newtab/test/xpcshell/test_nimbus_newtabTrainhopAddon_firstStartup.js", "browser/components/newtab/test/xpcshell/test_nimbus_newtabTrainhopAddon_onBrowserReady.js", "taskcluster/test_configs/variants.yml", "testing/mochitest/runtests.py", "toolkit/components/backgroundtasks/BackgroundTask_message.sys.mjs", "toolkit/components/nimbus/FeatureManifest.yaml", "toolkit/components/nimbus/lib/RemoteSettingsExperimentLoader.sys.mjs"], "git_node": "d550bb283f427062da08401fe985f1504420ed4f", "git_parents": ["a9b68b3667167737b520dd79dcd7ba178440dbdf"], "node": "e102f81576bb249823fb2c75f8d6adafbe250ade", "parents": ["0c581d21f726cffb17f39e4c188aa12d1a9dcd3b"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2074654 - Apply WebsiteFilter to object and embed loads. r=jmendez\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328514\n", "files": ["browser/components/enterprisepolicies/helpers/WebsiteFilter.sys.mjs", "browser/components/enterprisepolicies/tests/browser/browser_policy_websitefilter.js"], "git_node": "7ab41504b5fbba7266e4653666396eaae13294b4", "git_parents": ["d550bb283f427062da08401fe985f1504420ed4f"], "node": "2c577735c0b2f08589ea00172a2982abdfcf6587", "parents": ["e102f81576bb249823fb2c75f8d6adafbe250ade"], "tags": []}, {"author": "Maryam \u003cmomar@mozilla.com\u003e", "branch": "default", "desc": "Bug 1929973 - Fix assertion error in test_remove_invalid_first_party_partitioned_cookie.js  r=necko-reviewers,manuel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322259\n", "files": ["netwerk/test/unit/test_remove_invalid_first_party_partitioned_cookie.js"], "git_node": "059ded4b6025f682b3614eedf1b73edb90f217e5", "git_parents": ["7ab41504b5fbba7266e4653666396eaae13294b4"], "node": "66d370da916d027d6912dbb579450a295697275d", "parents": ["2c577735c0b2f08589ea00172a2982abdfcf6587"], "tags": []}, {"author": "Harshit Sohaney \u003chsohaney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066608 - Add telemetry for mini window. r=mconley,chumphreys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328305\n", "files": ["browser/base/content/main-popupset.js", "browser/components/miniwindow/MiniWindow.sys.mjs", "browser/components/miniwindow/MiniWindowManager.sys.mjs", "browser/components/miniwindow/metrics.yaml", "browser/components/miniwindow/test/browser/browser.toml", "browser/components/miniwindow/test/browser/browser_telemetry.js", "browser/components/screenshots/ScreenshotsUtils.sys.mjs", "toolkit/components/glean/metrics_index.py"], "git_node": "e0373953a03528cc77cf14194eedd2f628b624c2", "git_parents": ["059ded4b6025f682b3614eedf1b73edb90f217e5"], "node": "c14d73424537bf41a240f7b035af144c5cd2a807", "parents": ["66d370da916d027d6912dbb579450a295697275d"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2067819 - Validate policy URLs with the URL parser. r=bsmth\" for causing xpc failures @ test_extensionsettings_install_without_url.js\n\nThis reverts commit 732275e41c9b922299f319bc8121477643321ae4.\n", "files": ["browser/components/enterprisepolicies/content/aboutPolicies.js", "browser/components/enterprisepolicies/schemas/policies-schema.json", "browser/components/enterprisepolicies/tests/xpcshell/test_PolicySchemaValidator.js", "toolkit/components/enterprisepolicies/PolicySchemaValidator.sys.mjs", "toolkit/modules/JsonSchema.sys.mjs", "toolkit/modules/tests/xpcshell/test_JsonSchema.js"], "git_node": "23ae96913389a8908e9ba77f3e94bb4c3f0eb95c", "git_parents": ["e0373953a03528cc77cf14194eedd2f628b624c2"], "node": "f618097a7405e497b57ef171cdffce5b5a6e5976", "parents": ["c14d73424537bf41a240f7b035af144c5cd2a807"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074026 - Remove legacy_constructor for nsContentPolicy. r=emilio,layout-reviewers\" for causing bc failures @ browser_xpcom_graph_wait.js\n\nThis reverts commit 63e2eab9e72e73d56a2f6e9c289a200f572830f4.\n\nRevert \"Bug 2074026 - Always handle CSP before MixedContentBlocker. r=emilio,layout-reviewers\"\n\nThis reverts commit 2a9780916b337e9e6e742e3c378fcf2542419b2a.\n", "files": ["dom/base/nsContentPolicy.cpp", "dom/base/nsContentPolicy.h", "dom/security/test/mixedcontentblocker/browser.toml", "dom/security/test/mixedcontentblocker/browser_csp_before_mixed_content.js", "dom/security/test/mixedcontentblocker/file_csp_before_mixed_content.sjs", "layout/build/components.conf", "layout/build/nsLayoutModule.cpp", "layout/build/nsLayoutModule.h"], "git_node": "71357c09faf28b359269398c316311f2e16feead", "git_parents": ["23ae96913389a8908e9ba77f3e94bb4c3f0eb95c"], "node": "487b907cc2f6b182498a4c56de29c036ca57d0ad", "parents": ["f618097a7405e497b57ef171cdffce5b5a6e5976"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075231 - tell pip not to try and be smart when installing funsize deps r=releng-reviewers,bhearsum\n\nrequirements.txt already includes the necessary dependencies, no need to\nresolve them again and risk breakage at install time.\n\ngithub3-py depends on pyjwt[crypto], and the pip in debian 12 (23.0.1)\ndoesn't consider the pinned pyjwt==2.14.0 as satisfying that dependency,\nso it picked the latest pyjwt from PyPI instead, which broke when 2.15.0\nwas released as it's not pinned.\n\nRun pip check after the install as an extra safety.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328838\n", "files": ["taskcluster/docker/funsize-update-generator/Dockerfile"], "git_node": "198d18404f5eb8d6bc3dab35bd4f78f1882acc1f", "git_parents": ["71357c09faf28b359269398c316311f2e16feead"], "node": "fc0ba07eba0af4619598aab8e9111c811618e6a0", "parents": ["487b907cc2f6b182498a4c56de29c036ca57d0ad"], "tags": []}, {"author": "yazan \u003cyalmacki@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074861 - Change special custom icon label to bonus. r=fluent-reviewers,settings-reviewers,mconley,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328541\n", "files": ["browser/components/preferences/config/browser-icon.mjs", "browser/locales/en-US/browser/preferences/browserIcon.ftl"], "git_node": "9e3918225db9741b077d10caa91019fb8a64ad0a", "git_parents": ["198d18404f5eb8d6bc3dab35bd4f78f1882acc1f"], "node": "c5d3f1067cfb90ffd47318ed90b69f732af2eb4b", "parents": ["fc0ba07eba0af4619598aab8e9111c811618e6a0"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074284 - Lint all xpcom headers through clang-tidy r=xpcom-reviewers,mccr8,emilio\n\nChanges includes:\n- using C++20 type aliases and inline avriables\n- using nullptr where appropriate\n- using range-based loop where appropriate\n- making deleted methods public\n- making some methods default\n- use std::forward instead of std::move to prevent lifetime issues\n- avoid confusing constructor through universal references\n- rework some include dependencies to make header self contained\n\nTo break some circular dependencies, allow to break MOZ_COUNTED_DTOR_VIRTUAL(_type) into\nMOZ_COUNTED_DTOR_VIRTUAL_DECL(_type) and MOZ_COUNTED_DTOR_VIRTUAL_DEF(_type).\n\nAll changes were detected either by header compilation failure, or by\nclang-tidy.\n\nFixes are either generated by clang-tidy or hand-made\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327970\n", "files": ["toolkit/xre/nsSigHandlers.cpp", "xpcom/base/CodeAddressService.h", "xpcom/base/EnumeratedArrayCycleCollection.h", "xpcom/base/HoldDropJSObjects.h", "xpcom/base/Logging.h", "xpcom/base/OwningNonNull.h", "xpcom/base/RLBoxUtils.h", "xpcom/base/StaticLocalPtr.h", "xpcom/base/nsCOMPtr.h", "xpcom/base/nsCycleCollectionNoteChild.h", "xpcom/base/nsISupportsImpl.h", "xpcom/base/nsISupportsUtils.h", "xpcom/base/nsIWeakReferenceUtils.h", "xpcom/build/LateWriteChecks.cpp", "xpcom/build/LateWriteChecks.h", "xpcom/components/nsCategoryManagerUtils.h", "xpcom/components/nsComponentManagerUtils.h", "xpcom/ds/ArrayIterator.h", "xpcom/ds/CycleCollectedUniquePtr.h", "xpcom/ds/PerfectHash.h", "xpcom/ds/nsAtomTable.cpp", "xpcom/ds/nsTHashtable.h", "xpcom/io/nsLocalFileUnix.h", "xpcom/io/nsPipe.h", "xpcom/ioutils/PathUtils.cpp", "xpcom/string/RustRegex.h", "xpcom/string/nsCharTraits.h", "xpcom/string/nsString.h", "xpcom/string/nsTDependentSubstring.h", "xpcom/string/nsTStringHasher.h", "xpcom/string/nsTSubstring.cpp", "xpcom/string/nsTSubstring.h", "xpcom/tests/gtest/TestAvailableMemoryWatcherMac.cpp", "xpcom/tests/gtest/TestAvailableMemoryWatcherWin.cpp", "xpcom/threads/CondVar.h", "xpcom/threads/DataMutex.h", "xpcom/threads/DeadlockDetector.h", "xpcom/threads/Monitor.h", "xpcom/threads/Mutex.h", "xpcom/threads/Queue.h", "xpcom/threads/RWLock.h", "xpcom/threads/RecursiveMutex.h", "xpcom/threads/ReentrantMonitor.h", "xpcom/threads/SpinEventLoopUntil.h", "xpcom/threads/StateMirroring.h", "xpcom/threads/StateWatching.h", "xpcom/threads/ThreadBound.h"], "git_node": "deaadf3c89d9bbf2034bb312223db0f7c2952ce5", "git_parents": ["9e3918225db9741b077d10caa91019fb8a64ad0a"], "node": "93b7f374801aedff3198df68c734e52010a37067", "parents": ["c5d3f1067cfb90ffd47318ed90b69f732af2eb4b"], "tags": []}, {"author": "serge-sans-paille \u003csguelton@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073144 - Lint all dom/html headers through clang-tidy r=dom-core-reviewers,smaug\n\nActually make every header self-contained by moving some definition to\nsource file to break circular dependencies.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327968\n", "files": ["dom/html/EditContext.h", "dom/html/HTMLFormSubmission.cpp", "dom/html/HTMLFormSubmission.h", "dom/html/HTMLTableRowElement.h"], "git_node": "2e743fb437cd7ceb29675da90c2ceaddfb8827f1", "git_parents": ["deaadf3c89d9bbf2034bb312223db0f7c2952ce5"], "node": "189343a165096af3ea7e5288ffbf2417e4c035b2", "parents": ["93b7f374801aedff3198df68c734e52010a37067"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075240 - Update/disable UI tests broken by the homepage redesign r=aaronmt\n\nThe homepage redesign (D326014) removed the stories carousel from the homepage and hides the wordmark on the private homepage. Several legacy UI tests still asserted the old elements and started failing.\n\nAreas affected:\n  - HomeScreenRobot.verifyPrivateBrowsingHomeScreenItems()\n  - HomeScreenTest.homeScreenItemsTest\n  - TabbedBrowsingTest.privateModeStaysAsDefaultAfterRestartTest and privateTabsDoNotPersistAfterClosingAppTest\n  - PocketTest (all tests)\n\nTry in progress:  https://treeherder.mozilla.org/jobs?repo=try&revision=1ea06090740714dddf40e4ca66ab46c588859c61\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328895\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/HomeScreenTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/PocketTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/HomeScreenRobot.kt"], "git_node": "52343a55696d602f0bde7fa3d9358222607f28f2", "git_parents": ["2e743fb437cd7ceb29675da90c2ceaddfb8827f1"], "node": "a819cc99d9bfbe90fb1603635e7903246dc39470", "parents": ["189343a165096af3ea7e5288ffbf2417e4c035b2"], "tags": []}, {"author": "Bob Owen \u003cbobowencode@gmail.com\u003e", "branch": "default", "desc": "Bug 1836257 p2 - Detect and relocate EAT unpatchable DLLs. r=yjuglaret,sandbox-reviewers\n\nTo apply hooks on load the Chromium sandbox code needs to allocate memory within\n2GB of the module base. If the DLL is close to the maximum address this can\nsometimes fail.\n\nWe try to detect when the DLL will be unpatchable and allocate a byte at the\nmodule base in the child to force it to relocate.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327851\n", "files": ["security/sandbox/chromium-shim/patches/56_ensure_interception_thunks_can_be_allocated.patch", "security/sandbox/chromium/sandbox/win/src/interception.cc", "security/sandbox/chromium/sandbox/win/src/interception.h", "security/sandbox/chromium/sandbox/win/src/interception_agent.cc", "security/sandbox/chromium/sandbox/win/src/interception_internal.h", "security/sandbox/chromium/sandbox/win/src/sandbox_nt_util.cc", "security/sandbox/chromium/sandbox/win/src/sandbox_nt_util.h"], "git_node": "660f57c7f78b0233792483da0c89ea18d6188603", "git_parents": ["52343a55696d602f0bde7fa3d9358222607f28f2"], "node": "05843e59437253f7f003c0f62c3cb54c9f108e85", "parents": ["a819cc99d9bfbe90fb1603635e7903246dc39470"], "tags": []}, {"author": "Boris Chiou \u003cboris.chiou@gmail.com\u003e", "branch": "default", "desc": "Bug 2054343 - Avoid calculating inf + -inf when calculating the scheduled event time for animationstart. r=layout-reviewers,dshin\n\nThe assertion in this bug happens when we are calculating `inf + -inf`,\nwhich results in an unexpected value, so we just try to avoid it.\n\nNote that there is a known issue for `AnimationEvent.elapsedTime` if the\ndelay is negative infinite. We may get an incorrect negative elapsedTime\nbecause the calculation of `mActiveTime` is overflow. However, it seems\nother browsers have different behavior and it's an undefined behavior,\nso we just keep it as it is for now because it is outside the\nscope of this bug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328649\n", "files": ["dom/animation/Animation.cpp", "dom/animation/AnimationEffect.cpp", "dom/animation/CSSAnimation.cpp", "testing/web-platform/meta/css/css-animations/animation-delay-012.html.ini", "testing/web-platform/meta/css/css-animations/animation-duration-infinite.html.ini"], "git_node": "6ad34caa8a92c613a638363aea191323dab101a7", "git_parents": ["660f57c7f78b0233792483da0c89ea18d6188603"], "node": "fedafe3661431b039341ae429d031dde0ac08827", "parents": ["05843e59437253f7f003c0f62c3cb54c9f108e85"], "tags": []}, {"author": "Michael Kaply \u003cmozilla@kaply.com\u003e", "branch": "default", "desc": "Bug 2064802 - Observe the \u003ckey\u003e element from nsMenuItemX so shortcut changes update the native key equivalent. r=mac-reviewers,spohl\n\nnsMenuItemX registered for content changes on mContent, mCommandElement and\nmImageElement, but never on the \u003ckey\u003e element SetKeyEquiv() resolves. Edits\nmade from about:keyboard therefore never reached the NSMenuItem, so when Gecko\nleft a key unhandled and nsCocoaWindow::PostHandleKeyEvent offered it to the\nmenu bar, the stale key equivalent still matched and ran the old shortcut.\n\nTrack the resolved \u003ckey\u003e element as mKeyElement, keep its registration in sync\nas the menu item's key attribute changes, and recompute the key equivalent when\nits key/keycode/modifiers attributes change. Also clear the modifier mask on the\nno-key path so a cleared shortcut doesn't leave a stale mask behind.\n\nAdd nsIDOMWindowUtils.getNativeMenuItemKeyEquivalent so this is testable. An\nNSMenuItem's key equivalent is otherwise not observable from script. The getter\nwalks the window's own nsMenuBarX rather than [NSApp mainMenu], which may\nbelong to a different window such as the hidden window's menu bar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320573\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/interfaces/base/nsIDOMWindowUtils.idl", "widget/cocoa/nsCocoaWindow.h", "widget/cocoa/nsCocoaWindow.mm", "widget/cocoa/nsMenuItemX.h", "widget/cocoa/nsMenuItemX.mm", "widget/nsIWidget.h", "widget/tests/browser/browser.toml", "widget/tests/browser/browser_test_menu_key_equivalent_update.js"], "git_node": "bebb328c762a0159d1822af684aa32b97ba04821", "git_parents": ["6ad34caa8a92c613a638363aea191323dab101a7"], "node": "d4740f0b558216b0b680eb13958941b59975a034", "parents": ["fedafe3661431b039341ae429d031dde0ac08827"], "tags": []}, {"author": "Yannis Juglaret \u003cyjuglaret@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074534 - Emit patch-if for files under distribution/extensions in make_incremental_zucchini. r=releng-reviewers,jcristau\n\nmake_patch_instruction always wrote a plain patch instruction, while\nmake_add_instruction already emitted add-if for files under\ndistribution/extensions/\u003cid\u003e/. common.sh:make_patch_instruction has the\nis-extension branch on both sides.\n\ndistribution/ is the partner tree and may legitimately be absent.\npatch-if skips a missing test directory, whereas patch opens the source\nfile and returns READ_ERROR, failing the whole update. The patch-cache\nhit path calls the same emitter, so cached members are covered too.\n\nThe extension directory derivation is factored out as extension_root_dir\nand shared by both emitters, using a single regex instead of a search\nfollowed by a substitution.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328527\n", "files": ["tools/update-packaging/make_incremental_zucchini.py", "tools/update-packaging/test/test_make_incremental_zucchini.py"], "git_node": "1c4f621fcdbab00266dc15c47caafd43fe45652b", "git_parents": ["bebb328c762a0159d1822af684aa32b97ba04821"], "node": "ad48ecfcf4309f9d2501d5b59b3c1bfa21e740b1", "parents": ["d4740f0b558216b0b680eb13958941b59975a034"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074804 - Let the Nova New Tab search bar grow with the page width rather than in fixed steps. r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328453\n", "files": ["browser/extensions/newtab/content-src/components/Logo/_Logo.scss", "browser/extensions/newtab/content-src/components/Search/_Search.scss", "browser/extensions/newtab/content-src/styles/_variables.scss"], "git_node": "ecf9933f49a207f6ce585982e596f9395fa0bed3", "git_parents": ["1c4f621fcdbab00266dc15c47caafd43fe45652b"], "node": "d2101dae1fd7314adc64a1e8ff066b14e2190f21", "parents": ["ad48ecfcf4309f9d2501d5b59b3c1bfa21e740b1"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075171 - Use fallible allocation in nsContentUtils::GetSurfaceData. r=dom-core-reviewers,smaug\n\nAll callers already handle a Nothing() result, so running out of memory\nwhile copying an image to the clipboard, dragging or sending media\nsession artwork no longer crashes the content process.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328882\n", "files": ["dom/base/nsContentUtils.cpp"], "git_node": "e51c2dd834a1a7cad61d0506d14ce9e515a2a3d9", "git_parents": ["ecf9933f49a207f6ce585982e596f9395fa0bed3"], "node": "588ada8865f074bd971b10806f09001dd345747f", "parents": ["d2101dae1fd7314adc64a1e8ff066b14e2190f21"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075171 - Start the drag without an image if the drag image cannot be serialized. r=edgar\n\nRather than aborting the drag, fall back to the same path used when no\ndrag image could be drawn.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328881\n", "files": ["widget/nsDragServiceProxy.cpp"], "git_node": "dca81df7bb2defab0844741fb22b06f989afb294", "git_parents": ["e51c2dd834a1a7cad61d0506d14ce9e515a2a3d9"], "node": "44a48b45acd415dae758fcb37babaed8fc8d60d3", "parents": ["588ada8865f074bd971b10806f09001dd345747f"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 1938264 - Don't compute CB block-size again for an inline replaced element with a percentage block-size. r=layout-reviewers,dholbert\n\n`ComputeContainingBlockRectangle()` already considers `mTreatBSizeAsIndefinite`\nand computes an unconstrained block-size for the containing block when\n`mTreatBSizeAsIndefinite` is true. This happens for a flex item in a column flex\ncontainer with an indefinite block-size.\n\nHowever, in standards mode, the inline replaced element fell back to the\ncontaining block's computed block-size, which is a wrong value to use. This\npatch simply deletes the unwanted code.\n\nFor the quirks mode behavior, this patch simplifies it while preserving the\nbehavior. Also, move `isAutoBSize` closer to its usage that handles internal\ntable frames.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328695\n", "files": ["layout/generic/ReflowInput.cpp", "testing/web-platform/tests/css/css-flexbox/percentage-heights-024.html"], "git_node": "cc951cfc8d60e19047a031e983155b2c7cda7b35", "git_parents": ["dca81df7bb2defab0844741fb22b06f989afb294"], "node": "168b4c0d0ecc2fcc8bd122848ad8f87621b812fc", "parents": ["44a48b45acd415dae758fcb37babaed8fc8d60d3"], "tags": []}, {"author": "Noah Bond \u003cnbond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068594 - Update the tab counter icons to the latest design r=android-reviewers,jdelorenzo\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328907\n", "files": ["mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_infinite_tabs_24.xml", "mobile/android/android-components/components/ui/icons/src/main/res/drawable/mozac_ic_tab_24.xml"], "git_node": "b6513b364538957b6fd3072c98a190cd77c20948", "git_parents": ["cc951cfc8d60e19047a031e983155b2c7cda7b35"], "node": "b9ab0932ebe8e9b62c8ccfaa1d3c227f9784d555", "parents": ["168b4c0d0ecc2fcc8bd122848ad8f87621b812fc"], "tags": []}, {"author": "Jonathan Mendez \u003cjmendez@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075020 part 1 - Add DownloadSaver.getSha256HashHex(). r=dlp-reviewers,gstoll\n\ngetSha256Hash() returns the raw digest bytes, which is what the\napplication reputation service expects, but multiple consumers in\nFirefox Enterprise have needed the hex encoding instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328705\n", "files": ["toolkit/components/downloads/DownloadCore.sys.mjs", "toolkit/components/downloads/test/unit/common_test_Download.js"], "git_node": "583e0620a008764e865b4f4d5067309ebcd67b76", "git_parents": ["b6513b364538957b6fd3072c98a190cd77c20948"], "node": "da40d2a2eeb70d69c4d516d0e56c98cff163bf76", "parents": ["b9ab0932ebe8e9b62c8ccfaa1d3c227f9784d555"], "tags": []}, {"author": "Jonathan Mendez \u003cjmendez@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075020 part 2 - Send the download SHA-256 digest to content analysis as hex. r=dlp-reviewers,gstoll\n\nContent analysis expects sha256Digest to be a hex string, matching what\nContentAnalysisRequest::GetFileDigest produces. The raw bytes aren't\nvalid UTF-8, so the Firefox Enterprise built-in DLP engine fails to\ndecode the request and every download falls back to the default result.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328706\n", "files": ["toolkit/components/contentanalysis/tests/browser/browser_download_content_analysis.js", "toolkit/components/downloads/DownloadIntegration.sys.mjs"], "git_node": "f793f2d2c4f79bc8a0abade78950aaef7bdd5527", "git_parents": ["583e0620a008764e865b4f4d5067309ebcd67b76"], "node": "5ce60fdf16e6f0fe8900671b3032cef65765ce83", "parents": ["da40d2a2eeb70d69c4d516d0e56c98cff163bf76"], "tags": []}, {"author": "Andrew Halberstadt \u003cahal@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064412 - Clone build-components tasks with Git, r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324400\n", "files": ["taskcluster/kinds/build-components/kind.yml"], "git_node": "cbdf32c6abaab84c40623ab047718730f1dce685", "git_parents": ["f793f2d2c4f79bc8a0abade78950aaef7bdd5527"], "node": "b94dda890972743087ccafa0766143ccc8305401", "parents": ["5ce60fdf16e6f0fe8900671b3032cef65765ce83"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066288 - Add known-fail tests for runWithGenerator abandonment r=ai-platform-reviewers,valentinp\n\nBreaking out of a for-await over MLEngine.runWithGenerator does not end the\nunderlying run. The generator's return() skips everything after the yield\nloop, and the port protocol has no cancel message, so the child keeps the\ngeneration active. Two consequences are observable: a subsequent sequential\nrequest is rejected by the LlamaRunner concurrency guard, and\nrecordEngineRun never fires even though the child completes the run and\nrecords run_inference_success_flow.\n\nBug 2024015 already suppressed the uncaught rejection this used to produce,\nso those two are what remain.\n\nBoth tests assert the intended behavior and are marked todo, so a fix\nreports as an unexpected pass rather than silently passing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321730\n", "files": ["toolkit/components/ml/tests/browser/browser_ml_native.js"], "git_node": "93433bd208cc64f8ab07ca09993f190ce39d5894", "git_parents": ["cbdf32c6abaab84c40623ab047718730f1dce685"], "node": "91ab99744daaffbaa57403a9e76bc3a9a3bf2a45", "parents": ["b94dda890972743087ccafa0766143ccc8305401"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066288 - Report when a cancelled llama.cpp generation has released the backend r=ai-platform-reviewers,valentinp\n\nCancelling a generation stream sets a flag that the generation task only\nchecks between tokens, so the task stays inside LlamaBackend::Generate after\nCancelCallbackImpl has returned, holding the backend. The callback returned no\npromise, so a caller had no way to tell when the backend was free, and\nLlamaBackend is not thread-safe.\n\nThe generation thread runs the task it started to completion before anything\nelse, so a runnable queued behind it reports when the task is done with the\nbackend. Resolve the promise returned by the cancel callback from there.\n\nA cancellation also closes the stream while a pull is outstanding, and the\nmessage that pull was waiting on arrives afterwards. Ignore it rather than\nenqueueing onto a closed stream.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327982\n", "files": ["toolkit/components/ml/backends/llama/LlamaRunner.cpp"], "git_node": "f28dc10b657e0992f5eeffd50a050da1cb4ec23b", "git_parents": ["93433bd208cc64f8ab07ca09993f190ce39d5894"], "node": "f1c3b8693363c0525eaf79f24d3495b7fe813744", "parents": ["91ab99744daaffbaa57403a9e76bc3a9a3bf2a45"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066288 - Record engine_run for an abandoned runWithGenerator run r=ai-platform-reviewers,valentinp\n\nrecordEngineRun sat after the yield loop in runWithGenerator, so a consumer\nthat abandoned the generator skipped it along with the rest of the generator\nbody. The engine still settles the run and still records\nrun_inference_success_flow for it, leaving engine_run missing for runs that\nreport as successful.\n\nReport the run from whichever path reaches its end: the consumer draining the\ngenerator, or the engine settling an abandoned run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327983\n", "files": ["toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_native.js"], "git_node": "cb56a84e89577c20517c125c285a3c3f96387d92", "git_parents": ["f28dc10b657e0992f5eeffd50a050da1cb4ec23b"], "node": "957231bd266389468ea5192dafdffc0278dd60fa", "parents": ["f1c3b8693363c0525eaf79f24d3495b7fe813744"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066288 - End the run when a runWithGenerator consumer abandons the generator r=ai-platform-reviewers,valentinp\n\nBreaking out of a for-await over MLEngine.runWithGenerator calls the\ngenerator's return(), and the port protocol had no way to say the run is no\nlonger wanted. The llama.cpp generation kept going and the next request was\nrejected by the LlamaRunner concurrency guard, even though sequential runs are\nsupported. Link Preview hits this whenever a preview is dismissed\nmid-generation.\n\nAdd EnginePort:Cancel, carry it to the engine's pipeline, and post it when the\ngenerator is abandoned. LlamaCppPipeline ends the generation by closing the\nstream reader, then waits for the backend to be free before the next run.\nPipelines that cannot end a generation early do not implement cancel, and\ntheir runs finish as before.\n\nThe run cancels the same stream again on its way out, and that second cancel\nresolves immediately, so each run keeps the first drain rather than the\nsecond. The read loop uses an explicit reader: an async iterator's return()\nrejects while a read is outstanding, which is exactly when a cancellation arrives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327984\n", "files": ["toolkit/components/ml/actors/MLEngineChild.sys.mjs", "toolkit/components/ml/actors/MLEngineParent.sys.mjs", "toolkit/components/ml/content/MLEngine.worker.mjs", "toolkit/components/ml/content/backends/LlamaCppPipeline.mjs", "toolkit/components/ml/tests/browser/browser_ml_native.js"], "git_node": "902bc3e1d007a8474da189730660c3128126a4ab", "git_parents": ["cb56a84e89577c20517c125c285a3c3f96387d92"], "node": "76e9975e960ed9a9d68658b4bd39ea5bac81de76", "parents": ["957231bd266389468ea5192dafdffc0278dd60fa"], "tags": []}, {"author": "Joe Bowser \u003cjbowser@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066288 - Add a test that the next run waits for a cancelled generation r=ai-platform-reviewers,valentinp\n\nbrowser_ml_native.js covers abandonment by asserting the next request is not\nrejected by the LlamaRunner concurrency guard. It cannot see the next\ngeneration starting while the cancelled one still holds the backend, which is\nnot thread-safe: that is a data race rather than an error, and with\nTinyStories-656K the cancelled task leaves LlamaBackend::Generate before a\nsecond one gets far enough to overlap.\n\nDrive LlamaCppPipeline directly instead, with a generator whose cancel\nalgorithm settles only when the test releases it. Holding the backend becomes\na state the test controls rather than a window it has to hit, so the assertion\nis that no second generation starts until the drain resolves. Two cases: a\ncancellation that arrives with a read outstanding, and one that arrives before\nthe run has a reader.\n\nThe stub needs no model and no native runtime, so this runs on the platforms\nbrowser_ml_native.js skips.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328595\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_llama_cancel.js"], "git_node": "f342dc69d5bf4d61b415e701d289fdb35af6a40a", "git_parents": ["902bc3e1d007a8474da189730660c3128126a4ab"], "node": "a2f6122061bc1cbb67396ff6bc3a4741203a3453", "parents": ["76e9975e960ed9a9d68658b4bd39ea5bac81de76"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068913 - Report when a service worker finishes a push message r=dom-worker-reviewers,asuth,geckoview-reviewers,saschanaz,owlish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323644\n", "files": ["dom/push/PushComponents.sys.mjs", "dom/push/PushNotifier.cpp", "dom/push/PushNotifier.h", "dom/push/PushService.sys.mjs", "dom/push/moz.build", "dom/push/nsIPushNotifier.idl", "dom/push/nsIPushService.idl", "dom/push/test/browser.toml", "dom/push/test/browser_push_message_handled.js", "dom/push/test/push_message_handled_worker.js", "dom/serviceworkers/ServiceWorkerManager.cpp", "dom/serviceworkers/ServiceWorkerManager.h", "dom/serviceworkers/ServiceWorkerOpPromise.h", "dom/serviceworkers/ServiceWorkerPrivate.cpp", "dom/serviceworkers/ServiceWorkerPrivate.h", "mobile/shared/components/geckoview/GeckoViewPush.sys.mjs"], "git_node": "ad1b5ee385b3e38743ed2eab85fcc2ab468273cc", "git_parents": ["f342dc69d5bf4d61b415e701d289fdb35af6a40a"], "node": "4ca2a8b767f5e6dadaae08b5fe7152cac51a520f", "parents": ["a2f6122061bc1cbb67396ff6bc3a4741203a3453"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068913 - Let PushService ignore new push messages r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326875\n", "files": ["dom/push/PushComponents.sys.mjs", "dom/push/PushService.sys.mjs", "dom/push/PushServiceWebSocket.sys.mjs", "dom/push/test/xpcshell/test_notification_ignore.js", "dom/push/test/xpcshell/xpcshell.toml"], "git_node": "370bb870691026254e4568146f17db64c37ffcd1", "git_parents": ["ad1b5ee385b3e38743ed2eab85fcc2ab468273cc"], "node": "d650449f6d10fa7d13829cb2f6e968728cd1509c", "parents": ["4ca2a8b767f5e6dadaae08b5fe7152cac51a520f"], "tags": []}, {"author": "Antonio Borondo \u003caborondo@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068913 - Wait for the service worker to finish a push message before exiting r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323645\n", "files": ["toolkit/components/push/PushCommandLineHandler.sys.mjs", "toolkit/components/push/test/browser/browser_receive_push_messages.js"], "git_node": "d7549fb470d8cbc31a5d30e0f1c192a140fd8267", "git_parents": ["370bb870691026254e4568146f17db64c37ffcd1"], "node": "2e7f6f4c1b6e090bdb8d06e6a31da46b9033dc16", "parents": ["d650449f6d10fa7d13829cb2f6e968728cd1509c"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009747 - Patch 1 - Replace the deprecated NSSharingService enumeration with NSSharingServicePicker. r=mac-reviewers,fluent-reviewers,desktop-theme-reviewers,hjones,bradwerth,bolsson\n\n+[NSSharingService sharingServicesForItems:] is deprecated. We used it to list share providers so we could build them as XUL menuitems. We will replace it with NSSharingServicePicker, which is maintained by macOS and provides a sharing service interface consistent with apps across macOS. This patch also fixes Bug 1698581 for macOS to now support sharing for more than one tab.\n\nThe new native interface resulted in a few UI changes in Firefox menus:\n\n - The submenu no longer lists each installed macOS share provider. It now shows Copy Link, Create QR Code, and a single entry \"AirDrop, Messages, and More...\" that opens the native picker.\n - The \"More...\" entry that opened the Sharing pane of System Settings is gone. The native picker exposes the same providers directly.\n - Copy Link and Create QR Code lose their icons since we are working on removing all icons in context menus.\n - \"Generate QR Code...\" is relabelled \"Create QR Code\"\n - The BrowserUsageTelemetry id for a macOS share goes from \"share-macos-provider\" to \"macos-share-picker\", since Firefox no longer knows which provider the user picks.\n\nFurther details:\n\nWhen invoked, shareUrlWithPicker() anchors the native picker popover to a relevant DOM element.\n\nSharing more than one tab cannot be expressed as a URL, so multi-URL shares are handed to the picker as a MOZShareURLPasteboardItem, which advertise plain text and HTML representations covering every URL. This was the solution to enable as many sharing services as possible to share multiple URLs in a nice format. Single-URL shares still pass a plain NSURL so the share picker can display a webpage preview.\n\nThe xpcshell test covered getSharingProviders() and is removed with it. The new pasteboard writer is covered by TestMOZShareURLPasteboardItem.mm instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308393\n", "files": ["browser/base/content/test/browser-contextMenu/browser.toml", "browser/base/content/test/browser-contextMenu/browser_contextmenu_share_macosx.js", "browser/base/content/test/browser-menubar/browser_file_share_macosx.js", "browser/components/customizableui/test/browser_share_tab_button_macosx.js", "browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/sharing/SharingUtils.sys.mjs", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/browser/menubar.ftl", "browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/themes/shared/browser-shared.css", "widget/cocoa/MOZShareURLPasteboardItem.h", "widget/cocoa/MOZShareURLPasteboardItem.mm", "widget/cocoa/moz.build", "widget/cocoa/nsMacSharingService.mm", "widget/nsIMacSharingService.idl", "widget/tests/gtest/TestMOZShareURLPasteboardItem.mm", "widget/tests/gtest/moz.build", "widget/tests/unit/test_macsharingservice.js", "widget/tests/unit/xpcshell.toml"], "git_node": "5069169ffb93d45b5b9e88200abe5033f4520384", "git_parents": ["d7549fb470d8cbc31a5d30e0f1c192a140fd8267"], "node": "ada964f9faf56bf2dc6891dc933fb8add1a815d2", "parents": ["2e7f6f4c1b6e090bdb8d06e6a31da46b9033dc16"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009747 - Patch 2 - Update the picker's Copy Link to support sharing multiple links. r=mac-reviewers,bradwerth\n\nNSSharingServicePicker provides its own Copy Link entry via the private SHKCopyToPasteboardSharingService class. However, we want to have the copy feature for when multiple tabs are selected consistent with Firefox's \"Copy x Links\" functionality and label.\n\nThere is no API for replacing an entry provided by the system, and appending our own NSSharingService results in two Copy services. MacShareCopyOverride swizzles -title, -canPerformWithItems: and -performWithItems:, so the entry keeps its native appearance but takes its label and its action from Firefox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325555\n", "files": ["browser/components/sharing/SharingUtils.sys.mjs", "widget/cocoa/moz.build", "widget/cocoa/nsMacSharingCopyOverride.h", "widget/cocoa/nsMacSharingCopyOverride.mm", "widget/cocoa/nsMacSharingService.mm", "widget/nsIMacSharingService.idl"], "git_node": "6e439c81fff1820f8d46cbaaf8c1095eba07ece1", "git_parents": ["5069169ffb93d45b5b9e88200abe5033f4520384"], "node": "c6bdf32e278e57326dcd83d1d724ec595923f0cd", "parents": ["ada964f9faf56bf2dc6891dc933fb8add1a815d2"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009747 - Patch 3 - Replace the address bar context menu Share submenu with Share and Create QR Code items. r=Standard8,urlbar-reviewers,fluent-reviewers,bolsson\n\nOn macOS the strip-on-share item joins the share group rather than sitting under Copy, so the group is built as a single item set: Share..., Create QR Code and Copy Clean Link.\n\nAnchoring strip-on-share after the Create QR Code item would have required #initShareURL to run first. Building the group in one fragment avoids that ordering requirement. Both paths share the item creation and the enable/hide logic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325556\n", "files": ["browser/base/content/test/browser-contextMenu/browser_contextmenu_share_macosx.js", "browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/locales/en-US/browser/browser.ftl"], "git_node": "dad6213b1ec6ae4fdef6c939982d3999ce4a53a6", "git_parents": ["6e439c81fff1820f8d46cbaaf8c1095eba07ece1"], "node": "8f80ed85f07322582630e42f5e3edc3354bc656b", "parents": ["c6bdf32e278e57326dcd83d1d724ec595923f0cd"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009747 - Patch 4 - Open the macOS share picker directly from the share toolbar button. r=mac-reviewers,bradwerth\n\nOn macOS the share toolbar button is a custom toolbar item which directly opens the native picker.\n\nCreate QR Code gets injected as a custom service. It previously was listed in the button's submenu but since the native share picker gets directly invoked, in order to keep the function, it now is integrated in the native picker. shareUrlWithPicker() gains a customItems array for this, and BuildCustomServices() turns each one into an NSSharingService prepended to the picker's list.\n\nThe button keeps the submenu on other platforms.\n\nThis is a separate commit due to the work to create a link share button in the URL bar (Bug 2052253), so this toolbar button might become redundant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325557\n", "files": ["browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/test/browser_share_tab_button_macosx.js", "browser/components/sharing/SharingUtils.sys.mjs", "widget/cocoa/nsMacSharingService.mm", "widget/nsIMacSharingService.idl"], "git_node": "5402fbaa40877b7a7fd535ab8762b4a0d6a1fca6", "git_parents": ["dad6213b1ec6ae4fdef6c939982d3999ce4a53a6"], "node": "1fbab775eaa6d7c925fb08bce0aab78c290cf0bc", "parents": ["8f80ed85f07322582630e42f5e3edc3354bc656b"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2068913 - Wait for the service worker to finish a push message before exiting r=saschanaz\" for causing lint failures\n\nThis reverts commit d7549fb470d8cbc31a5d30e0f1c192a140fd8267.\n\nRevert \"Bug 2068913 - Let PushService ignore new push messages r=saschanaz\"\n\nThis reverts commit 370bb870691026254e4568146f17db64c37ffcd1.\n\nRevert \"Bug 2068913 - Report when a service worker finishes a push message r=dom-worker-reviewers,asuth,geckoview-reviewers,saschanaz,owlish\"\n\nThis reverts commit ad1b5ee385b3e38743ed2eab85fcc2ab468273cc.\n", "files": ["dom/push/PushComponents.sys.mjs", "dom/push/PushNotifier.cpp", "dom/push/PushNotifier.h", "dom/push/PushService.sys.mjs", "dom/push/PushServiceWebSocket.sys.mjs", "dom/push/moz.build", "dom/push/nsIPushNotifier.idl", "dom/push/nsIPushService.idl", "dom/push/test/browser.toml", "dom/push/test/browser_push_message_handled.js", "dom/push/test/push_message_handled_worker.js", "dom/push/test/xpcshell/test_notification_ignore.js", "dom/push/test/xpcshell/xpcshell.toml", "dom/serviceworkers/ServiceWorkerManager.cpp", "dom/serviceworkers/ServiceWorkerManager.h", "dom/serviceworkers/ServiceWorkerOpPromise.h", "dom/serviceworkers/ServiceWorkerPrivate.cpp", "dom/serviceworkers/ServiceWorkerPrivate.h", "mobile/shared/components/geckoview/GeckoViewPush.sys.mjs", "toolkit/components/push/PushCommandLineHandler.sys.mjs", "toolkit/components/push/test/browser/browser_receive_push_messages.js"], "git_node": "182eaffa4f8564db14d50686eb7e6df541da501a", "git_parents": ["5402fbaa40877b7a7fd535ab8762b4a0d6a1fca6"], "node": "b5c730b4750cf9768cee5419c59aafc5df412320", "parents": ["1fbab775eaa6d7c925fb08bce0aab78c290cf0bc"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "7661ff239514d00071f5792e3840db60945607a1", "git_parents": ["182eaffa4f8564db14d50686eb7e6df541da501a", "3682546ac2c02610537306ca16849de2c24aea45"], "node": "c09851aa75727d4942f74853f28a31173c416509", "parents": ["b5c730b4750cf9768cee5419c59aafc5df412320", "39878598097d7673770b0729163b275d4a1dd43a"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2009747 - Patch 4 - Open the macOS share picker directly from the share toolbar button. r=mac-reviewers,bradwerth\" for causing bustages in nsMacSharingService.mm.\n\nThis reverts commit 5402fbaa40877b7a7fd535ab8762b4a0d6a1fca6.\n\nRevert \"Bug 2009747 - Patch 3 - Replace the address bar context menu Share submenu with Share and Create QR Code items. r=Standard8,urlbar-reviewers,fluent-reviewers,bolsson\"\n\nThis reverts commit dad6213b1ec6ae4fdef6c939982d3999ce4a53a6.\n\nRevert \"Bug 2009747 - Patch 2 - Update the picker's Copy Link to support sharing multiple links. r=mac-reviewers,bradwerth\"\n\nThis reverts commit 6e439c81fff1820f8d46cbaaf8c1095eba07ece1.\n\nRevert \"Bug 2009747 - Patch 1 - Replace the deprecated NSSharingService enumeration with NSSharingServicePicker. r=mac-reviewers,fluent-reviewers,desktop-theme-reviewers,hjones,bradwerth,bolsson\"\n\nThis reverts commit 5069169ffb93d45b5b9e88200abe5033f4520384.\n", "files": ["browser/base/content/test/browser-contextMenu/browser.toml", "browser/base/content/test/browser-contextMenu/browser_contextmenu_share_macosx.js", "browser/base/content/test/browser-menubar/browser_file_share_macosx.js", "browser/component