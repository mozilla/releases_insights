browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "852fa99a580f8e5cffe4ce74f4c523c5cdbd85b5", "git_parents": ["e1e07f489b4a5964b1567fbebc0b086417c98c79"], "node": "715b9a08fa9a58660d9a599912b899ac1a6554c8", "parents": ["80134cb83fa7148fe00a8dc4472ed746cff5f4ca"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075001 - Add a pref to enforce widget market gating on Nightly r=reemhamz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328659\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "8d3f34f9b80b032fa17e10081cf9b79ca7dfe14d", "git_parents": ["852fa99a580f8e5cffe4ce74f4c523c5cdbd85b5"], "node": "d795321ad89e6ea2693a6ef9325b44d32c82b4c4", "parents": ["715b9a08fa9a58660d9a599912b899ac1a6554c8"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075271 - Stub the widget market prefs in newtab for older hosts r=thecount\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328867\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "d660c7e494e2ed6c91c28a9c0f144ae31f4ae9d1", "git_parents": ["8d3f34f9b80b032fa17e10081cf9b79ca7dfe14d"], "node": "62e9d7603f78a0bede37c98de1f3caed4a423fe7", "parents": ["d795321ad89e6ea2693a6ef9325b44d32c82b4c4"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075275 - New tab search bar variant A experiment: darken button in dark mode to improve contrast. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328872\n", "files": ["browser/themes/shared/urlbar.css"], "git_node": "25ed7daa496d25481b357fbd909d6eca5610fe6d", "git_parents": ["d660c7e494e2ed6c91c28a9c0f144ae31f4ae9d1"], "node": "079f0c5e60081a29d9e74925fa96710528827d03", "parents": ["62e9d7603f78a0bede37c98de1f3caed4a423fe7"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2072545 - Normalize schemeless origins before validating when adding new login through CPM. r=mtigley,credential-management-reviewers\n\n`#addHTTPSPrefix` becomes `#normalizeOrigin`, which writes the prefixed origin to\nboth `originField.value` and `originField.inputEl.value`, then re-evaluates\n`_originInvalid`. If the origin is valid, it drops the warning and returns the\nnormalized string.\n\nCall `#normalizeOrigin` in `onSubmit` in addition to `@change`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328707\n", "files": ["toolkit/components/satchel/megalist/content/components/login-form/login-form.mjs", "toolkit/components/satchel/megalist/content/tests/browser/browser_passwords_create_login.js"], "git_node": "183b5bcb16c8e4149dd68a0972de56a726380fdf", "git_parents": ["25ed7daa496d25481b357fbd909d6eca5610fe6d"], "node": "ae2c317cec9e3d45ae9ac6ff3ac015d18b9ba312", "parents": ["079f0c5e60081a29d9e74925fa96710528827d03"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 1905459 - Ensure Opus decoder config is consistent and not racing against pref flips. r=media-playback-reviewers,alwu\n\nIn dom/media/test/test_bug1431810_opus_downmix_to_mono.html, we flip the\npref accessibility.monoaudio.enable to true. We wait for it to apply to the\ncontent process, but we can race with it getting synced to the utility\nprocess, where we can check the same prefs again.\n\nThis patch makes it so that we check the prefs related to Opus output\nchannels when first creating the AudioInfo configuration. That way even if\na pref changes in the middle of creating a decoder, it will always have a\nconsistent configuration.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328646\n", "files": ["dom/media/MediaInfo.h", "dom/media/VideoUtils.cpp", "dom/media/VideoUtils.h", "dom/media/ipc/MediaIPCUtils.h", "dom/media/mediasink/AudioSink.cpp", "dom/media/mp4/DecoderData.cpp", "dom/media/ogg/OggCodecState.cpp", "dom/media/platforms/ffmpeg/FFmpegAudioDecoder.cpp", "dom/media/webcodecs/AudioDecoder.cpp", "dom/media/webm/WebMDemuxer.cpp"], "git_node": "0114b35895bab7069c0118f630268ded5dd517f3", "git_parents": ["183b5bcb16c8e4149dd68a0972de56a726380fdf"], "node": "2d7675d5fffb8b430eae419fd9b1275ebd3120dd", "parents": ["ae2c317cec9e3d45ae9ac6ff3ac015d18b9ba312"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074308: Use post-bailout range in analyzeLoopPhi r=jandem\n\nThis fixes the two cases where we're not currently following the rules.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328311\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/MIR.h", "js/src/jit/RangeAnalysis.cpp"], "git_node": "fd4dfdca19504c804f3c12b95d6de9de2d01f56f", "git_parents": ["0114b35895bab7069c0118f630268ded5dd517f3"], "node": "260810fa6af37777b1a59c9e3d0ffda75f8a4ee2", "parents": ["2d7675d5fffb8b430eae419fd9b1275ebd3120dd"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074892: Revert over-aggressive assertion r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328610\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2074892.js", "js/src/jit/MIR.cpp"], "git_node": "5f340f153830ce66dbd6e2202f9a2421d1b49d55", "git_parents": ["fd4dfdca19504c804f3c12b95d6de9de2d01f56f"], "node": "15df792d896355cbc595d023432bd901225ffd31", "parents": ["260810fa6af37777b1a59c9e3d0ffda75f8a4ee2"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073245 - Gradients background in Nova themes previews should not be mirrored in RTL locales. r=emilio,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328451\n", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/mozapps/extensions/content/components/theme-preview.mjs", "toolkit/mozapps/extensions/default-theme/preview-nova.svg", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js"], "git_node": "e50dbb003a6991c10305e98ddd6a71dcbe3b0bce", "git_parents": ["5f340f153830ce66dbd6e2202f9a2421d1b49d55"], "node": "f67694f17955e1b4f116b873fd2f114abb91d5e5", "parents": ["15df792d896355cbc595d023432bd901225ffd31"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Extract the crashreporter symbols once per process. r=perftest-reviewers,mozbase-reviewers,ahal,kshampur\n\nWe were doing it once per test run, so e.g. 10x instead of 1x.\n\nLook the symbol directory up once per process instead. The extracted copy now\nbelongs to this module, which removes it at exit, so callers no longer pass a\nwork directory in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327222\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py"], "git_node": "78518c53c519ec32815964a1fc41d38fcfa68bc8", "git_parents": ["e50dbb003a6991c10305e98ddd6a71dcbe3b0bce"], "node": "dc82dc9f68771da30c759d6cc0af68b66c48e33d", "parents": ["f67694f17955e1b4f116b873fd2f114abb91d5e5"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Use .json.gz for gzipped profiles consistently. r=florian\n\nsaveProfileToUploadDir() writes either gzipped bytes (from\ngetProfileDataAsGzippedArrayBuffer) or plain JSON (from dumpProfileToFile\nat shutdown), but named both profile_\u003ctest\u003e.json.\n\nNow we use the right extension based on what's in the file. This is needed\nfor samply load to work correctly; samply only looks at the extension and\ndoesn't sniff the content.\n\nThe comments about Treeherder requiring \".json\" are no longer true; I landed\nchanges a few months ago so that profile artifacts are now just detected by\nhaving the file name start with the \"profile_\" prefix, the file extension is\nignored.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327223\n", "files": ["testing/modules/TestProfilerArtifact.sys.mjs", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "0a8df01f8fde4b3d3765fbabd805ac2bfd4d45d4", "git_parents": ["78518c53c519ec32815964a1fc41d38fcfa68bc8"], "node": "5bfc36b5d536b3bf81d441ab822876dc89910d74", "parents": ["dc82dc9f68771da30c759d6cc0af68b66c48e33d"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Stop parsing profile JSON in Python. r=perftest-reviewers,kshampur,canova\n\nThe python code no longer needs to look at the contents. Only samply and\nprofiler-edit actually need to look at the contents.\n\nThis saves a whole lot of ceremony around decompressing and compressing\nfiles.\n\nReplace symbolicate_profile(dict) with symbolicate_profile_file(in, out).\nprofiler-edit picks its output compression from the extension, so it now\nwrites the final artifact directly, next to the destination, and the swap\nis a same-filesystem os.replace(). That retires the cross-device\nshutil.move() fallback, the copy in and out, the temporary directories,\nand the MemoryError handlers.\n\nRaptor's profile archive names its entries after the collected profile, so\nit has been calling plain JSON \".json.gz\" for as long as browsertime has\nwritten \"geckoProfile-N.json.gz\". Now that the archived bytes come from a\nfile rather than json.dumps(), take the extension from that file: \".json\"\nfor the symbolicated profile, and the collected profile's own extension\nwhen symbolication failed and we archive it unchanged. samply and\nprofiler.firefox.com go by the extension and don't sniff the content.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327224\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/__init__.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py", "testing/raptor/raptor/gecko_profile.py", "testing/raptor/test/test_gecko_profile.py", "testing/talos/talos/gecko_profile.py"], "git_node": "9412a2a09a59cd3d1d7a7d9601bc5e18fa8a682e", "git_parents": ["0a8df01f8fde4b3d3765fbabd805ac2bfd4d45d4"], "node": "86ebb9b0561153b2a9e1d9fdf01383a262eec3eb", "parents": ["5bfc36b5d536b3bf81d441ab822876dc89910d74"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Terminate samply when symbolication fails. r=perftest-reviewers,mozbase-reviewers,ahal,kshampur\n\nsymbolicate_profile_file() runs samply as a symbol server and shuts it down\nonce profiler-edit has finished. Any excptions occurring in between would\nleave samply running.\n\nShut it down in a finally block. Also raise when samply exits without\nreporting a URL, rather than running profiler-edit against an empty symbol\nserver address.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327225\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py"], "git_node": "386a4b7196616f60cf360fb8b3fb9be6b4938bfb", "git_parents": ["9412a2a09a59cd3d1d7a7d9601bc5e18fa8a682e"], "node": "2b5192851037a1b467a1b69917953ed7c34b5de9", "parents": ["86ebb9b0561153b2a9e1d9fdf01383a262eec3eb"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Always gzip symbolicated profiles. r=perftest-reviewers,aglavic\n\nThis should get us smaller artifacts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327226\n", "files": ["testing/mochitest/runtests.py", "testing/modules/TestProfilerArtifact.sys.mjs", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/talos/talos/gecko_profile.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "b9f9755aa0eb1ca884357bbfe234811796834a57", "git_parents": ["386a4b7196616f60cf360fb8b3fb9be6b4938bfb"], "node": "5434ae1cf63e3441fe5741d8ab4d7ba6c718ee4e", "parents": ["2b5192851037a1b467a1b69917953ed7c34b5de9"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074975 - Record per-host HSTS probe results and failure streaks as a task artifact. r=keeler,releng-reviewers,jcristau\n\ngetHSTSPreloadList.js now writes hsts-probe-results.json with the outcome, HTTP status, nsresult and latency\nof every probed host. The task gets an index route so each run can fetch the previous run's results and carry\nforward a per-host count of consecutive failed runs, from which the threshold for removing persistently\nunreachable hosts will be chosen. Only successfully completed tasks are indexed, so a failed or spot-killed\nrun never becomes the previous run. The count is recorded only; the generated list is unchanged. The promise\nchain in main() becomes sequential awaits, with the results written before keep-on-error rewrites the\nstatuses.\n\nA 2xx/3xx response without an adequate header does not extend the count, since the plan keeps removing those\nhosts immediately; a 4xx/5xx response without one (often a bot-blocking page) counts toward the threshold\ninstead.\n\nOnly hosts probed in a run appear in its artifact. A host that was not probed has left both Chromium's list\nand ours or become force-included, so its streak is dropped rather than carried forward.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328617\n", "files": ["taskcluster/docker/periodic-updates/scripts/getHSTSPreloadList.js", "taskcluster/docker/periodic-updates/scripts/periodic_file_updates.sh", "taskcluster/kinds/repo-update/kind.yml"], "git_node": "d9d6984e8fbe6f5163915b13cbbe7a14842fdabd", "git_parents": ["b9f9755aa0eb1ca884357bbfe234811796834a57"], "node": "1f0669e89ffe4a6253978924dd53ffaa5f65a9ad", "parents": ["5434ae1cf63e3441fe5741d8ab4d7ba6c718ee4e"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074467: Fold MBitOr(Lsh,Ursh) to MRotate r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328673\n", "files": ["js/src/jit-test/tests/ion/rotate.js", "js/src/jit/MIR.cpp", "js/src/jit/MIR.h"], "git_node": "191e6cdfb5cfce225e435f3ef7e427500b36df91", "git_parents": ["d9d6984e8fbe6f5163915b13cbbe7a14842fdabd"], "node": "4e9c07f4fddac68af9bb395e6fd418b099af3ec7", "parents": ["1f0669e89ffe4a6253978924dd53ffaa5f65a9ad"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074467: Don't mark MRotate as a guard r=spidermonkey-reviewers,jandem\n\nThis code was added in [this commit](https://hg-edge.mozilla.org/mozilla-central/rev/8e5b77f682285bcf52463c3484ac992dfd25a8fd) while backing out a patch. However, looking at D59340, the original comment + setGuard() were on MWasmResultBase, not MRotate. It seems like there was some sort of undetected merge failure. I don't see any reason that this node has to be a guard.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328674\n", "files": ["js/src/jit/MIR.h"], "git_node": "910f649112760cd0b9557ab580c283ed72c7bb75", "git_parents": ["191e6cdfb5cfce225e435f3ef7e427500b36df91"], "node": "7c0d1b3a0eaa0929ad86a9a41791c277246b8a1e", "parents": ["4e9c07f4fddac68af9bb395e6fd418b099af3ec7"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074467: Support recovering MRotate on bailout r=spidermonkey-reviewers,jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328675\n", "files": ["js/src/jit-test/tests/ion/dce-with-rinstructions.js", "js/src/jit-test/tests/ion/recover-rotate.js", "js/src/jit/MIR.h", "js/src/jit/Recover.cpp", "js/src/jit/Recover.h"], "git_node": "8d9e3313812a5c83170f0e1addbfaeeb7afc6fa8", "git_parents": ["910f649112760cd0b9557ab580c283ed72c7bb75"], "node": "cda1b525e3dd8a0865c77267ce93f74807da5fd0", "parents": ["7c0d1b3a0eaa0929ad86a9a41791c277246b8a1e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073838 - Keep the urlbar view closed when a search mode query has no results and no one-offs to show. r=daleharvey\n\npromiseSearchComplete no longer waits for the view to open, since a query without results now leaves it closed.\n\nUrlbarSearchOneOffs now invalidates its cache when the scotchBonnet one-off prefs change, since willHide() depends on them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327663\n", "files": ["browser/base/content/test/browser-menubar/browser_search_bookmarks.js", "browser/base/content/test/browser-menubar/browser_search_history.js", "browser/components/urlbar/UrlbarSearchOneOffs.sys.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/UrlbarTestUtils.sys.mjs", "browser/components/urlbar/tests/browser-UrlbarInput/browser_popover_state.js", "browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js", "browser/components/urlbar/tests/browser-search/browser_search_bookmarks_from_bookmarks_menu.js", "browser/components/urlbar/tests/browser-search/browser_search_history_from_history_panel.js", "browser/components/urlbar/tests/browser-searchMode/browser_newWindow.js", "browser/components/urlbar/tests/browser-searchMode/browser_searchModeSwitcher_basic.js", "browser/components/urlbar/tests/browser/browser_tabKeyBehavior.js", "browser/components/urlbar/tests/browser/searchbar/browser_searchmode.js"], "git_node": "d8bb93a1c9c257e90131500c93b903b989483ace", "git_parents": ["8d9e3313812a5c83170f0e1addbfaeeb7afc6fa8"], "node": "acea57c7a150e5887ce80fd97f5bbba0e52c35b5", "parents": ["cda1b525e3dd8a0865c77267ce93f74807da5fd0"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075339 - Freeze the browser while taking a mochitest failure screenshot on macOS. r=ahal\n\nScreenshots are only taken in the retry run, where the failing test is\nusually the last one before the browser quits. On macOS the capture is\nslower than that exit, so it records an empty desktop. SIGSTOP the browser\nwhile dump_screen runs so its windows stay on screen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328938\n", "files": ["testing/mochitest/runtests.py"], "git_node": "cb7cfcd6d579c55c77c608e976750d736b52b4bf", "git_parents": ["d8bb93a1c9c257e90131500c93b903b989483ace"], "node": "94fe2aa4172fbd6795ca0960e3ceacccb22dec67", "parents": ["acea57c7a150e5887ce80fd97f5bbba0e52c35b5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071355 - Rename the tab element script to .mjs. r=tabbrowser-reviewers,jsudiaman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328665\n", "files": ["browser/base/content/browser-main.js", "browser/components/tabbrowser/content/tab.js", "browser/components/tabbrowser/content/tab.mjs", "browser/components/tabbrowser/jar.mn", "browser/components/tabbrowser/types/elements.ts"], "git_node": "b8316c5e5ff008ab3b5354898a2a6224291cb663", "git_parents": ["cb7cfcd6d579c55c77c608e976750d736b52b4bf"], "node": "6180f148988154c627f3815ded1ee5fa0fe6ef94", "parents": ["94fe2aa4172fbd6795ca0960e3ceacccb22dec67"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071355 - Turn the tab element into a module. r=tabbrowser-reviewers,frontend-codestyle-reviewers,jsudiaman\n\nDropping the indentation-preserving block re-indents the whole file, so git diff -w is the actual change: the export, the import that replaces the subscript load, and four lines prettier re-joined.\n\nThe three cannot be separated. export is top-level only, so it needs the block gone; and once the block is gone the file's own top-level names collide with the browser-window globals harvested from browser-main.js's loadSubScript line, which only the import removes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328666\n", "files": ["browser/base/content/browser-main.js", "browser/components/tabbrowser/content/tab.mjs", "eslint-file-globals.config.mjs"], "git_node": "8bde5d3521483dae31b7c5b5fb1e32696c6c3690", "git_parents": ["b8316c5e5ff008ab3b5354898a2a6224291cb663"], "node": "03e1d1b25d1200586c3c52579fd6d3a3191e75d4", "parents": ["6180f148988154c627f3815ded1ee5fa0fe6ef94"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071355 - Declare MozElements.MozTab for TypeScript. r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328667\n", "files": ["tools/@types/lib.gecko.augmentations.d.ts"], "git_node": "81ae2e61ad0776dfcf16d8f9b399023a69f6c34e", "git_parents": ["8bde5d3521483dae31b7c5b5fb1e32696c6c3690"], "node": "b598c800bb2521621ad8521ccdcf12d824457b89", "parents": ["03e1d1b25d1200586c3c52579fd6d3a3191e75d4"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071355 - Set sessionstore's speculative-connection test markers without declaring them on the tab. r=Standard8,sessionstore-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328668\n", "files": ["browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/types/sessionstore.ts"], "git_node": "91c34e2ff2795f3330078a967f1aaec6f03de700", "git_parents": ["81ae2e61ad0776dfcf16d8f9b399023a69f6c34e"], "node": "e968b4005a7c06c0d136d48d9355d347f438341d", "parents": ["b598c800bb2521621ad8521ccdcf12d824457b89"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071355 - Type the tab from its class. r=Standard8,tabbrowser-reviewers,nsharpley\n\nThe members other modules set on a tab are declared in the constructor through JSDoc alone, with no assignment, so a tab gets no own property it doesn't have today.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328669\n", "files": ["browser/components/tabbrowser/content/tab.mjs", "browser/components/tabbrowser/types/elements.ts"], "git_node": "3611c4b934848d7be4dcb1af7f7686608c47d5a0", "git_parents": ["91c34e2ff2795f3330078a967f1aaec6f03de700"], "node": "3bb5efb2b2646f422f9de175630ce0ff57e659ae", "parents": ["e968b4005a7c06c0d136d48d9355d347f438341d"], "tags": []}, {"author": "Mark Striemer \u003cmstriemer@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074566 - Keep moz-input focus rings tight to the border r=desktop-theme-reviewers,reusable-components-reviewers,akulyk\n\nIn bug 2060287 the focus outline colour of the text inputs was corrected\nby using our default focus outline, but we actually don't want the\noffset for text inputs. This keeps the HCM fix but reverts pushing the\nfocus outline away from the input.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328933\n", "files": ["toolkit/content/tests/widgets/test_moz_input_text.html", "toolkit/content/widgets/moz-input-text/moz-input-text.css"], "git_node": "b9c9a29837c45017e766d256b698b109a06e78bc", "git_parents": ["3611c4b934848d7be4dcb1af7f7686608c47d5a0"], "node": "65a3436abd2ef40acb6cb6786ba62fcf86a20504", "parents": ["3bb5efb2b2646f422f9de175630ce0ff57e659ae"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2050488 - Run WPT testharness with --processes=3 on bare-metal macOS aarch64 r=jgraham\n\nFission-enabled WPT testharness was pinned to a single process on every\nplatform, a decision made for low-memory Intel workers. The macOS\naarch64 CI workers are 10-core / 16GB Mac minis and sit largely idle\nunder that.\n\nMeasured against a matched single-process control on the same base\ncommit, same selector, rebuild 3: median chunk wall-clock drops from\n22.4 min to 9.5 min, a 2.35x speedup, with the failure rate unchanged\nat 9/42 against the control's 8/42 (two-sided Fisher exact p = 1.000).\n\nSweeping further up finds the knee at 3. 5 processes gives 8.6 min and\n7 gives 8.7 min, so everything above 3 is worth about 10 percent more\nand nothing above 5 is worth anything, while the failure rate drifts to\n12/42 and 11/42. At 9 every job fails during browser startup with\nOSError [Errno 24] Too many open files: this is a file descriptor limit\nin the wptrunner parent process, not memory pressure, as peak system\nmemory never exceeds 10.3 GiB of 16 GiB even at 7 processes.\n\nScoped to the general testharness chunks. The tag-scoped media jobs\n(--tag=webrtc, -eme, -canvas, -webcodecs) have not been measured and\nstay single-process. The macOS aarch64 VM pools have far less memory\nper guest and also stay single-process, gated via mozinfo\ninfo[\"macos_vm\"].\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327010\n", "files": ["testing/mozharness/scripts/web_platform_tests.py"], "git_node": "19dddd19a195fa68b01a1e203ea7228b2cfa9b61", "git_parents": ["b9c9a29837c45017e766d256b698b109a06e78bc"], "node": "5d53031cd9d130d96e89f2125452c74ca52c40f8", "parents": ["65a3436abd2ef40acb6cb6786ba62fcf86a20504"], "tags": []}, {"author": "Morgan Rae Reschenberg \u003cmreschenberg@berkeley.edu\u003e", "branch": "default", "desc": "Bug 2074724: Remove MOZ_ASSERT, include mContent checks in return value of IsRootContent r=accessibility-platform-reviewers,Jamie\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328680\n", "files": ["accessible/generic/DocAccessible.cpp", "accessible/generic/DocAccessible.h"], "git_node": "3121515e678ae77b7e55bb3e4cf92ee93f47af05", "git_parents": ["19dddd19a195fa68b01a1e203ea7228b2cfa9b61"], "node": "aaf87335bc6e505e31f827e565b37d029067de83", "parents": ["5d53031cd9d130d96e89f2125452c74ca52c40f8"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2058972 - Don't panic when a mix-blend picture can't be mapped into its parent surface. r=gfx-reviewers,lsalzman\n\nprepare_composite_mode expected the mix-blend picture rect to always map into\nthe parent surface, but a degenerate transform can make that mapping fail.\nTreat that case like a backdrop that doesn't intersect the parent's clipping\nrect and fall back to the placeholder readback task.\n\nA mix-blend quad with a non-axis-aligned transform was also split into AA edge\ninstances that all shared one inline readback batch, tripping the renderer's\nsingle-instance debug assertion. Don't use AA segments for patterns that need\na backdrop readback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328263\n", "files": ["gfx/wr/webrender/src/picture_composite_mode.rs", "gfx/wr/webrender/src/quad.rs", "gfx/wr/wrench/reftests/crash/mix-blend-rotated.yaml", "gfx/wr/wrench/reftests/crash/mix-blend-unmappable-transform.yaml", "gfx/wr/wrench/reftests/crash/reftest.list"], "git_node": "07dd7211f33c1c48b16e428614e4d0e3f45aeb9a", "git_parents": ["3121515e678ae77b7e55bb3e4cf92ee93f47af05"], "node": "4fc955f49cc6f8009b6b752b85fc93e5ce722bac", "parents": ["aaf87335bc6e505e31f827e565b37d029067de83"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2074934 - Link about:buildconfig to the GitHub commit the build comes from r=taskgraph-reviewers,ahal\n\nBuilds are made from hg.mozilla.org, so the source link pointed there. The\ndecision task knows the matching git commit when the repository is mirrored to\nGitHub; pass it to the build so the page links to it, keeping the hg link as a\nfallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328747\n", "files": ["build/variables.py", "taskcluster/gecko_taskgraph/transforms/task.py", "toolkit/content/buildconfig.html", "toolkit/moz.configure"], "git_node": "87dc3103f97f6a48e1b946a4c798e86fdad9c7bb", "git_parents": ["07dd7211f33c1c48b16e428614e4d0e3f45aeb9a"], "node": "a01a40f439460efd26deafb5b09b2af10976ce30", "parents": ["4fc955f49cc6f8009b6b752b85fc93e5ce722bac"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2074934 - Link about:buildconfig to about:license r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328748\n", "files": ["toolkit/content/buildconfig.html"], "git_node": "a0fdf7b454affafc22aa59e22c9481ca59618683", "git_parents": ["87dc3103f97f6a48e1b946a4c798e86fdad9c7bb"], "node": "22bb14b94f149b6d6370b498df65d66bb95d2743", "parents": ["a01a40f439460efd26deafb5b09b2af10976ce30"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074107 - Properly support an identity color matrix with accelerated filters. r=gfx-reviewers,aosmond\n\nWhen an identity color matrix is supplied, this may generate a filter sequence of premul-crop-unpremul\ninstead of the expected premul-crop-colormatrix-unpremul. This caused a fallback to a software filter\nthat failed to read back from an A8 accelerated textures.\n\nThis fixes the A8 readback to work and plumbs the necessary pathway through FilterNodeWebgl::Draw to\navoid the fallback.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328744\n", "files": ["dom/canvas/DrawTargetWebgl.cpp", "dom/canvas/FilterNodeWebgl.cpp", "dom/canvas/FilterNodeWebgl.h", "dom/canvas/test/reftest/2074107-1-ref.html", "dom/canvas/test/reftest/2074107-1.html", "dom/canvas/test/reftest/reftest.list"], "git_node": "ef3da716dc4d51a6e119e2295e1f06805560a58d", "git_parents": ["a0fdf7b454affafc22aa59e22c9481ca59618683"], "node": "0879644e88e92d49ff609b50ee90dd5ebab5959e", "parents": ["22bb14b94f149b6d6370b498df65d66bb95d2743"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073298 - Always gzip symbolicated profiles. r=perftest-reviewers,aglavic\" for causing failures at Profile symbolication.\n\nThis reverts commit b9f9755aa0eb1ca884357bbfe234811796834a57.\n\nRevert \"Bug 2073298 - Terminate samply when symbolication fails. r=perftest-reviewers,mozbase-reviewers,ahal,kshampur\"\n\nThis reverts commit 386a4b7196616f60cf360fb8b3fb9be6b4938bfb.\n\nRevert \"Bug 2073298 - Stop parsing profile JSON in Python. r=perftest-reviewers,kshampur,canova\"\n\nThis reverts commit 9412a2a09a59cd3d1d7a7d9601bc5e18fa8a682e.\n\nRevert \"Bug 2073298 - Use .json.gz for gzipped profiles consistently. r=florian\"\n\nThis reverts commit 0a8df01f8fde4b3d3765fbabd805ac2bfd4d45d4.\n\nRevert \"Bug 2073298 - Extract the crashreporter symbols once per process. r=perftest-reviewers,mozbase-reviewers,ahal,kshampur\"\n\nThis reverts commit 78518c53c519ec32815964a1fc41d38fcfa68bc8.\n", "files": ["testing/mochitest/runtests.py", "testing/modules/TestProfilerArtifact.sys.mjs", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/__init__.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py", "testing/raptor/raptor/gecko_profile.py", "testing/raptor/test/test_gecko_profile.py", "testing/talos/talos/gecko_profile.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "d1a6a58841dbe8beb0091744ac538d4ec68c8842", "git_parents": ["ef3da716dc4d51a6e119e2295e1f06805560a58d"], "node": "553a25c278b06d8392cf289f302e4625ede6211a", "parents": ["0879644e88e92d49ff609b50ee90dd5ebab5959e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073245 - Gradients background in Nova themes previews should not be mirrored in RTL locales. r=emilio,desktop-theme-reviewers\" for causing failures at browser_parsable_css.js.\n\nThis reverts commit e50dbb003a6991c10305e98ddd6a71dcbe3b0bce.\n", "files": ["toolkit/mozapps/extensions/content/aboutaddons.css", "toolkit/mozapps/extensions/content/components/theme-preview.mjs", "toolkit/mozapps/extensions/default-theme/preview-nova.svg", "toolkit/mozapps/extensions/test/browser/browser_html_themes_picker.js"], "git_node": "8cd2de6b9cd09e0728e68d593e39ed9371e46902", "git_parents": ["d1a6a58841dbe8beb0091744ac538d4ec68c8842"], "node": "b3f0da84955d63cd937022dae6a7c9ed71044c35", "parents": ["553a25c278b06d8392cf289f302e4625ede6211a"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075271 - Stub the widget market prefs in newtab for older hosts r=thecount\"\n\nThis reverts commit d660c7e494e2ed6c91c28a9c0f144ae31f4ae9d1.\n", "files": ["browser/extensions/newtab/common/WidgetsRegistry.mjs", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "4fe4c4618cde7c2f080576e6b9d7542a4aa99ecb", "git_parents": ["8cd2de6b9cd09e0728e68d593e39ed9371e46902"], "node": "1b98ff2cc40fc4598ff6e9c4afc22dcdb953e3e1", "parents": ["b3f0da84955d63cd937022dae6a7c9ed71044c35"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075001 - Add a pref to enforce widget market gating on Nightly r=reemhamz\"\n\nThis reverts commit 8d3f34f9b80b032fa17e10081cf9b79ca7dfe14d.\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "189d4256302af08705327709e87a9022416f7e14", "git_parents": ["4fe4c4618cde7c2f080576e6b9d7542a4aa99ecb"], "node": "f6b949a1d20d602948747043b92a37bfc3c1df50", "parents": ["1b98ff2cc40fc4598ff6e9c4afc22dcdb953e3e1"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066245 - Make Crossword available to English locales outside PL, off by default r=reemhamz\"\n\nThis reverts commit 852fa99a580f8e5cffe4ce74f4c523c5cdbd85b5.\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "85e8d30b54b48590e79295cc5c8ae5369ee0f852", "git_parents": ["189d4256302af08705327709e87a9022416f7e14"], "node": "6dffccd281156c39ad69526bdf9335088f630f4e", "parents": ["f6b949a1d20d602948747043b92a37bfc3c1df50"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074974 - Turn Recent Searches widget off by default for all regions r=reemhamz\"\n\nThis reverts commit e1e07f489b4a5964b1567fbebc0b086417c98c79.\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "d2eda4eff62097eba74ece43139f9f3a86384e49", "git_parents": ["85e8d30b54b48590e79295cc5c8ae5369ee0f852"], "node": "3e54861b746cabc641404e5adaed87930e1ac0f9", "parents": ["6dffccd281156c39ad69526bdf9335088f630f4e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066247 - Turn Stocks widget off by default for all regions r=reemhamz\"\n\nThis reverts commit 9c5a2c462c5a09ec898ece7d94423f8599cf0a91.\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "a79b1ebe8d2a4ce111f25dd2a90e79f67b9f27ba", "git_parents": ["d2eda4eff62097eba74ece43139f9f3a86384e49"], "node": "6323f3324557ec549929ecbb4975a4159ce7e28e", "parents": ["3e54861b746cabc641404e5adaed87930e1ac0f9"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066248 - Turn Privacy widget off by default for all regions. r=maxx\"\n\nThis reverts commit fa9b2f1f89480ad996637b125ed449d7192357f8.\n", "files": ["browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/content-src/components/Widgets/WidgetsRegistry.test.jsx", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "826bbb1c05cda9a31f1dc2afc69668093277f8b4", "git_parents": ["a79b1ebe8d2a4ce111f25dd2a90e79f67b9f27ba"], "node": "b15e8a7ee286cdda02e4e8da5728fabe8fab2ae2", "parents": ["6323f3324557ec549929ecbb4975a4159ce7e28e"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066246 - Turn POTD widget off by default for US, DE, FR, PL regions. r=maxx\"\n\nThis reverts commit 0b941ee82c0fa4948e9d388e9d3c69c71cc9b754.\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "testing/profiles/common/user.js", "testing/profiles/xpcshell/user.js"], "git_node": "465cbfda355e4a15cb609832aea354e1b9f6cfff", "git_parents": ["826bbb1c05cda9a31f1dc2afc69668093277f8b4"], "node": "6b3152f5eb3a37fe99f21c2628de71f405ceac88", "parents": ["b15e8a7ee286cdda02e4e8da5728fabe8fab2ae2"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066244 - Turn Clocks widget off by default for US, DE, FR, PL regions. r=maxx\"\n\nThis reverts commit 815bdf8d0116fb499f4ce7d2c3d93bbc55e2b96b.\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser_newtab_side_by_side_layout.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "7fc7dad0274a14d751b7345116ea9e1677c76a20", "git_parents": ["465cbfda355e4a15cb609832aea354e1b9f6cfff"], "node": "3db24155cf53cacd2397402f38252e98a5bdd2ac", "parents": ["6b3152f5eb3a37fe99f21c2628de71f405ceac88"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066242 - Turn FocusTimer off by default in US, DE, FR, PL regions. r=maxx\"\n\nThis reverts commit ca691b6985487077c148283bfb6590ffbd533f83.\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/browser/browser_newtab_side_by_side_layout.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js"], "git_node": "eaf094351bc2ab623fe80cae2e4b3b3bdabcd7a6", "git_parents": ["7fc7dad0274a14d751b7345116ea9e1677c76a20"], "node": "86e0f57cdf92e31b3aaa1fcf1547d9f900d8147d", "parents": ["3db24155cf53cacd2397402f38252e98a5bdd2ac"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066240 - Turn the Lists widget off by default in the US, DE and FR, and block it in PL r=reemhamz\"\n\nThis reverts commit c9fdcaa2a9d87aa6e4f84c25ef68a69c53098304.\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/browser/browser_discovery_card.js", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "7dce472c850866f0da050c9fe22fa3fc01f3753f", "git_parents": ["eaf094351bc2ab623fe80cae2e4b3b3bdabcd7a6"], "node": "81ca9221b645520d832a44e8fec78cd9ea21517d", "parents": ["86e0f57cdf92e31b3aaa1fcf1547d9f900d8147d"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066236 - Gate widget availability by market r=reemhamz\" for causing failures at browser_homepage_firefox_home.js.\n\nThis reverts commit be5854b1914157bf0c52ba7d866b0ef365fba012.\n", "files": ["browser/app/profile/firefox.js", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/lib/PrefsFeed.sys.mjs", "browser/extensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js"], "git_node": "576a235398f4d4f7eade286e5f565cf58fcdfbd8", "git_parents": ["7dce472c850866f0da050c9fe22fa3fc01f3753f"], "node": "ee145093ed22b0b81db0862ba0e8f24bfa129140", "parents": ["81ca9221b645520d832a44e8fec78cd9ea21517d"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075122 - Ensure Skia uses an A8 blur algorithm for A8 surfaces. r=gfx-reviewers,nical\n\nWithout legacy coverage masks in Skia, there is no longer any way in the public API\nto directly blur an A8 image without it first being converted in an RGBA layer and\nincurring the cost of blurring all 4 channels.\n\nWork around this by using the underlying internal mask blur implementation that\nwould have been used with coverage masks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328757\n", "files": ["gfx/2d/Blur.cpp", "gfx/2d/Blur.h", "gfx/2d/DrawTargetSkia.cpp"], "git_node": "97b8042d11fa7b783991bb8ed4184f1c06b777cd", "git_parents": ["576a235398f4d4f7eade286e5f565cf58fcdfbd8"], "node": "4f5c9808623163e3ed845237e178a17814aff064", "parents": ["ee145093ed22b0b81db0862ba0e8f24bfa129140"], "tags": []}, {"author": "Neeco Fabian \u003cneecofabian@gmail.com\u003e", "branch": "default", "desc": "Bug 2056348 - Fix content overlap for high zoom levels in about:welcome r=omc-reviewers,emcminn\n\n- Tweak position and alignment of secondary button containers to avoid overlap\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328612\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css"], "git_node": "181ada5d6de3bd8e4ee57a2f4be49c9e583f63a0", "git_parents": ["97b8042d11fa7b783991bb8ed4184f1c06b777cd"], "node": "0069ff28d8ab9091e0abb80c7e032fa0cef76f85", "parents": ["4f5c9808623163e3ed845237e178a17814aff064"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2075073 - Flush offscreen scene interned items when the main scene isn't rebuilt r=gfx-reviewers,lsalzman\n\nA RenderOffscreen transaction doesn't rebuild the main scene when the root\npipeline has no display list yet, so the offscreen items were never flushed\nto the data store the offscreen frame build reads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328722\n", "files": ["gfx/wr/webrender/src/intern.rs", "gfx/wr/webrender/src/scene_builder_thread.rs", "testing/web-platform/meta/css/css-view-transitions/window-resize-aborts-transition.html.ini"], "git_node": "790dbd203bb7f8b51ea80f3a7f51650282a7d217", "git_parents": ["181ada5d6de3bd8e4ee57a2f4be49c9e583f63a0"], "node": "c6c6e279f19a423ff5bede4e8d0200fa4fe14b8c", "parents": ["0069ff28d8ab9091e0abb80c7e032fa0cef76f85"], "tags": []}, {"author": "virsworld \u003cvirpatel71@gmail.com\u003e", "branch": "default", "desc": "Bug 2073700 - Handle cleared permission notifications in permission exception dialogs. r=settings-reviewers,akulyk\n\nRefresh the permission lists when the permission table is cleared.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328252\n", "files": ["browser/components/preferences/dialogs/permissions.js", "browser/components/preferences/dialogs/sitePermissions.js"], "git_node": "2d50970993bc9a604f5ab096481d3f0dd5bc5cbc", "git_parents": ["790dbd203bb7f8b51ea80f3a7f51650282a7d217"], "node": "cd89b0e2a57984596e9f05e7802f664f113c2668", "parents": ["c6c6e279f19a423ff5bede4e8d0200fa4fe14b8c"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073215 - Part 1: Keep DRM video frames out of macOS video layer contents. r=bradwerth\n\nDRM video frames now reach the macOS video layer only through its protected\nenqueue path; the first frame of a newly built layer is no longer also set as\nplain layer contents for DRM video.\n\nThat first frame was set so a new layer could show something before any frame\nwas enqueued. On macOS 26, OS screenshots and screen recordings capture those\ncontents despite the capture protection, so they showed the protected video.\n\nAs a trade-off, a rebuilt DRM video layer shows nothing until its first\nenqueued frame is displayed, as every video layer did before bug 1879668.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328972\n", "files": ["gfx/layers/NativeLayerCA.mm"], "git_node": "65b84b957a31de4c85c650b0813f16f94bba1398", "git_parents": ["2d50970993bc9a604f5ab096481d3f0dd5bc5cbc"], "node": "08e6ca150e2ee8f429941c1a109cf29fc28ae60a", "parents": ["cd89b0e2a57984596e9f05e7802f664f113c2668"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073215 - Part 2: Rebuild macOS video layers when their DRM state changes. r=bradwerth\n\nA macOS video layer is now rebuilt whenever its DRM state changes, and capture\nprotection is set when the layer is created, so every layer that shows DRM\nframes is protected for its whole life.\n\nProtection used to be applied only when the DRM state changed. A layer rebuilt\nfor another reason, such as after a failed frame enqueue, came up without it,\nand a layer switching between clear and DRM content kept its clear frame or\ndropped protection while it could still be showing a DRM frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328973\n", "files": ["gfx/layers/NativeLayerCA.mm"], "git_node": "62fb6728c9b97ee6ef0493bd6aec8edb6ab3df10", "git_parents": ["65b84b957a31de4c85c650b0813f16f94bba1398"], "node": "94656adfd9393c0f71a9bc983dfeba6017ddf290", "parents": ["08e6ca150e2ee8f429941c1a109cf29fc28ae60a"], "tags": []}, {"author": "Alastor Wu \u003calwu@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073215 - Part 3: Add a gtest for capture protection of macOS DRM video layers. r=bradwerth\n\nCheck that DRM video layers block capture and hold no frame in their contents\nwhen first built, after a rebuild, and when switching to or from DRM, in both\nthe onscreen and the snapshot layer trees, and that non-DRM video still shows\nits first frame.\n\nThis covers the capture protection from Parts 1 and 2, which no browser test\ncan observe because it only affects captures made by the OS.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328974\n", "files": ["gfx/tests/gtest/TestNativeLayerCA.mm", "gfx/tests/gtest/moz.build"], "git_node": "fb06e2694bf6aca68942ca72bb2c8521b3938c31", "git_parents": ["62fb6728c9b97ee6ef0493bd6aec8edb6ab3df10"], "node": "10869b4bba608016b6f15607a259a920f8ed5c70", "parents": ["94656adfd9393c0f71a9bc983dfeba6017ddf290"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074535 - Stop zucchini partials from overwriting `distribution.ini` r=yjuglaret,releng-reviewers,bhearsum\n\nThe newly added files loop also skipped the `add-if-not` check that\n`make_incremental_update.sh` applies, so a file appearing for the first\ntime got a plain `add` regardless of its name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328220\n", "files": ["tools/update-packaging/make_incremental_zucchini.py", "tools/update-packaging/test/test_make_incremental_zucchini.py"], "git_node": "182b90eb34251582b909e7dfd1d2b7defc1bd8c2", "git_parents": ["fb06e2694bf6aca68942ca72bb2c8521b3938c31"], "node": "d9af67364f5c0625db58d8c35bb7863d99f00787", "parents": ["10869b4bba608016b6f15607a259a920f8ed5c70"], "tags": []}, {"author": "Henrik Skupin \u003cmail@hskupin.info\u003e", "branch": "default", "desc": "Bug 2046878 - Disable Nagle's algorithm for sockets accepted by nsServerSocket. r=necko-reviewers,leggert,kershaw\n\nOutgoing connections have had PR_SockOpt_NoDelay set since bug 542401, but\nnsSocketTransport::InitWithConnectedSocket, used for accepted connections,\nonly made the socket non-blocking. As a result the second of two small\nwrites in a row (e.g. a WebSocket event followed by a response) was held\nback until the peer's delayed ACK arrived, costing 40ms per pair on Linux\nfor the Remote Agent, Marionette, DevTools and httpd.js servers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328837\n", "files": ["netwerk/base/nsSocketTransport2.cpp"], "git_node": "ce200e865b2867077cd78708d658caeff5c7c81b", "git_parents": ["182b90eb34251582b909e7dfd1d2b7defc1bd8c2"], "node": "a131048002c4de9c648260a225580c97b7f99b98", "parents": ["d9af67364f5c0625db58d8c35bb7863d99f00787"], "tags": []}, {"author": "Luca Greco \u003clgreco@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070235 - Allow about:newtab pages to load privileged extension pages as subframes without requiring to list them as web_accessible_resources. r=robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324339\n", "files": ["toolkit/components/extensions/WebExtensionPolicy.cpp", "toolkit/components/extensions/WebExtensionPolicy.h", "toolkit/components/extensions/test/xpcshell/test_WebExtensionPolicy.js"], "git_node": "b9057dff00529cfcb0a5e576614908423a1a1ce1", "git_parents": ["ce200e865b2867077cd78708d658caeff5c7c81b"], "node": "9ce77ca5b39c9544b4b1de2dff7ad09f7f0fbb95", "parents": ["a131048002c4de9c648260a225580c97b7f99b98"], "tags": []}], "date": 1790310980, "git_changesets": ["0c426ca946b211b74b3d4f386294a2aa0517af3f", "50013e62049f80649ca23243ac11bb2ae6522527", "2ee9f60334a4646e3c7b12efffc213685cacb6a3", "0cee93c68c01ca99d244e328f2548e4241910f1d", "804f18f60ae620b67be3a54911940395161dcc4a", "553f432dd90003e382446e7bc35e814be3ac8655", "3e96f22137a8489dffff288f7a7e001d0ee40db6", "d47cb1f0a81efa643a5aba53ff1aa62bd1da1478", "3a800d3638957575c9e768acf62ffe458b50f91c", "b641180e6138fe53c54654e600348cb5b5d52a1f", "fc9140235eb67419e10c199f0c22026aedc99a1f", "b9b41ff68cf54dc3ebfd5089614e15405fb2484b", "25f8a18d4c5af6f83d4bf63de1affeb9c332d9e6", "a021732de1c19845772448d8445b4dc43f1d3568", "3520c748e216f7def7dd038e3390347aa0dfa33f", "9ac2b4a13117871e7f6bcf21e96f68323d02e998", "4012b92e536a35d78e963bc50cc6b19c067ef692", "e12e4a3f2682e0de7d3244f516a9b4b453677900", "48af034539580a2a43d7f5785778458f80b11393", "d5c9f9cf249cbee3a623be53957f9311c332f2cf", "da8ef54acf1f987ad87be74a7a2c0042594b5fc7", "99a6239c05fcde3151399232afee9b4b0c929e7f", "68fd3a4c02b8a84874ab13779018c6acb4dc2772", "19fa6ac6dc676208f5ef47e30f78fb134d53b80f", "a54ae7a9aa3feb288d67f2286ed86a9178e73bbc", "d9a863116ce345fed5d251ff7146f8de8043ee47", "9e60c65e734bde46b96bc3548d5c94dd7da98724", "3ab4e540b32a0b2fc9ad74ec33fc3574dc178f46", "9fbe7fd25738a762da1d6bf5e5e4b8be16971391", "d34fa0550462126dd896c35d6f5aa5dcbf3732c7", "5e53549d766d53a67fe39c45bfc5f040c45e69c3", "ea4b2776002e1c021040b42f810a9a4195409b6a", "4d27cc793aa9a0139029d52441eda79456c786df", "052e25cfe44e0517f06b5311f23dea324b20a182", "0cd793f14a1660aabe339600774b2f45ca963f90", "f75c0ff97fb8a5a47d6b027c2a569f5604b1cb5d", "f381a40b0191b7de9753e2ba92e3c