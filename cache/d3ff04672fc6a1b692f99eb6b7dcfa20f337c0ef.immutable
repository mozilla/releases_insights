": ["browser/extensions/newtab/.eslintrc.mjs", "browser/extensions/newtab/content-src/activity-stream.jsx"], "git_node": "1f7be53c519b848899d0f83116fa2b255928f6f2", "git_parents": ["e73a1c043c13a0f857a1921cf3c8e43b9352a311"], "node": "92dd31e013660958ceb39140937090d095a37472", "parents": ["f4106d2d25796dfaa166dd36ff410e28ab12baf5"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074696 - Remove unused @fluent/react, @fluent/bundle and lodash from newtab r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328320\n", "files": ["browser/extensions/newtab/karma.mc.config.js", "browser/extensions/newtab/package-lock.json", "browser/extensions/newtab/package.json", "browser/extensions/newtab/webpack.system-addon.config.js"], "git_node": "dd466f8af3659e3168805e1e41b5b2039f7a2641", "git_parents": ["1f7be53c519b848899d0f83116fa2b255928f6f2"], "node": "5e9992125483843c8165909ce5f9f387c84d9ae6", "parents": ["92dd31e013660958ceb39140937090d095a37472"], "tags": []}, {"author": "Jared Wein \u003cjwein@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074696 - Stop requiring the undeclared chalk in newtab bin scripts r=maxx\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328321\n", "files": ["browser/extensions/newtab/bin/render-activity-stream-html.js", "browser/extensions/newtab/bin/try-runner.js"], "git_node": "31b80043cfc7d189b3722d135047693bdc99d144", "git_parents": ["dd466f8af3659e3168805e1e41b5b2039f7a2641"], "node": "7976891daa837be4985501ef9d1053d5c2afa6b9", "parents": ["5e9992125483843c8165909ce5f9f387c84d9ae6"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2074547 - Delete addresses and payment methods from the autocomplete dropdown with trash icon instead of menu. r=mtigley,fluent-reviewers,credential-management-reviewers,flod\n\nHidden behind pref `browser.autocomplete.removeRecords.enabled`.\n\n`deleteSecondaryAction` replaces `moreActionsSecondaryAction` on the address and\npayment method rows, so each row carries `type: \"delete\"` and one action rather\nthan a `menupopup` holding two. The menu's other item was Edit, which named no\n`fillMessageName` and did nothing.\n\n`autocomplete-delete-address` and `autocomplete-delete-payment-method` become\nthe button tooltips, unchanged. The accessible names move to\n`autocomplete-delete-address-entry` and `autocomplete-delete-payment-method-entry`,\nwhich take the row's `$entry` so a list of identical Delete buttons still tells\na screen reader which record each one removes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328225\n", "files": ["browser/extensions/formautofill/test/browser/browser_autocomplete_secondary_action.js", "browser/extensions/formautofill/test/browser/creditCard/browser_creditCard_secondary_action.js", "toolkit/components/formautofill/ProfileAutoCompleteResult.sys.mjs", "toolkit/locales/en-US/toolkit/main-window/autocomplete.ftl"], "git_node": "41fe96276d4761121f2e2d1fd4ccc1def02e4991", "git_parents": ["31b80043cfc7d189b3722d135047693bdc99d144"], "node": "d32efc529d0bde6d6388390518742d05142c0c4b", "parents": ["7976891daa837be4985501ef9d1053d5c2afa6b9"], "tags": []}, {"author": "Kalen Lu \u003ckalenblu@icloud.com\u003e", "branch": "default", "desc": "Bug 2074546 - Enable login edit from flyout menu. r=mtigley,credential-management-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328238\n", "files": ["toolkit/components/passwordmgr/LoginAutoComplete.sys.mjs", "toolkit/components/passwordmgr/test/browser/browser_autocomplete_secondary_actions.js"], "git_node": "b90abcb3e10cc8d45f0e84c4dd16e5a4ac955651", "git_parents": ["41fe96276d4761121f2e2d1fd4ccc1def02e4991"], "node": "3cb35d9618da1ad2d49d020f15aefc259e255e08", "parents": ["d32efc529d0bde6d6388390518742d05142c0c4b"], "tags": []}, {"author": "Emily McMinn \u003cemcminn@mozilla.com\u003e", "branch": "defau