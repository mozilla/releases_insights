mponents/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_resume_card.js"], "git_node": "513bac8134ebf10e2006765b2f4a025d4081f521", "git_parents": ["bef87612cb0d7c34e8628a1ed6545948e04c1199"], "node": "af78b469de1619378869fbe8be7648e26fd34329", "parents": ["bdaec58559032324063e9a8f098f22bf2b32a539"], "tags": []}, {"author": "Seva Alipov \u003csalipov@mozilla.com\u003e", "branch": "default", "desc": "Bug 2029784: Ensure frame table is valid after adjusting selection r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327502\n", "files": ["layout/generic/nsFrameSelection.cpp", "testing/web-platform/tests/input-events/table-selection-crash.html"], "git_node": "315a7d55313c2f2c95f7f8a79a0e0a8a944cb98c", "git_parents": ["513bac8134ebf10e2006765b2f4a025d4081f521"], "node": "72c2d84dd872f642b72c20bec9f9ec85ed308277", "parents": ["af78b469de1619378869fbe8be7648e26fd34329"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 2072815: Bump expiration date for fingerprinting detection metrics r=timhuang\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328586\n", "files": ["toolkit/components/antitracking/metrics.yaml"], "git_node": "1acc253f169affaf6a8d27d449908af5d2d908f8", "git_parents": ["315a7d55313c2f2c95f7f8a79a0e0a8a944cb98c"], "node": "4a29171f6cd936155ab6299047f4f512c7ae6988", "parents": ["72c2d84dd872f642b72c20bec9f9ec85ed308277"], "tags": []}, {"author": "Julien Pages \u003cjpages@mozilla.com\u003e", "branch": "default", "desc": "Bug 2038964 - Add test. r=rhunt\n\nDifferential Revision: https://phabricator.services.mozilla.com/D301621\n", "files": ["js/src/jit-test/tests/wasm/regress/bug2038964-trap.js"], "git_node": "3280f159c1fd36c2e2801307dbd78204efff8316", "git_parents": ["1acc253f169affaf6a8d27d449908af5d2d908f8"], "node": "d87c82093c336619bdb9fc5a1e66ecd190357ca9", "parents": ["4a29171f6cd936155ab6299047f4f512c7ae6988"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056965 - Part 1: Add checks for validating process-specific ID origins, r=dom-core-reviewers,vhilla\n\nA number of components use IDs created using GenerateProcessSpecificID.\nThese IDs include the ChildID of the creating process in the ID to avoid\nconflicts.\n\nThis patch adds some extra validation to ensure that, in places where we\nknow the ID should have been generated by the sending process, the\nChildID component of the ID contains that process' ID.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D313550\n", "files": ["docshell/base/BrowsingContext.h", "docshell/base/nsDocShellLoadState.cpp", "docshell/shistory/SessionHistoryEntry.cpp", "dom/base/nsContentUtils.cpp", "dom/base/nsContentUtils.h", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentParent.cpp"], "git_node": "b07bdfc8364bb105ead4b243c2261f2fc408f0da", "git_parents": ["3280f159c1fd36c2e2801307dbd78204efff8316"], "node": "e3533193922fd6243bad3429afa14f5783bcca02", "parents": ["d87c82093c336619bdb9fc5a1e66ecd190357ca9"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2056965 - Part 2: Validate OuterWindowId in RecvNewWindowGlobal, r=dom-core-reviewers,smaug\n\nThis is done by tracking the root OuterWindowId on the BrowserParent,\nand checking the OuterWindowId against that for toplevel windows within\nthe BrowserParent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318523\n", "files": ["dom/ipc/BrowserBridgeParent.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/BrowserParent.h", "dom/ipc/ContentParent.cpp"], "git_node": "37028e838f26674f0dfac9f4fc80f8e41fd3eff7", "git_parents": ["b07bdfc8364bb105ead4b243c2261f2fc408f0da"], "node": "6a1c78e4ed8600780b9f97cac2529917945fdcb9", "parents": ["e3533193922fd6243bad3429afa14f5783bcca02"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com