vices/testing/sync-test/Cargo.toml", "third_party/application-services/testing/sync-test/src/auth.rs", "third_party/application-services/testing/sync-test/src/logins.rs", "third_party/application-services/tools/generate-rust-dashboards/src/component_config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/counter.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/distribution.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/event.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/labeled_counter.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/labeled_distribution.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/rust_component_errors.rs", "third_party/application-services/tools/generate-rust-dashboards/src/metrics/sync.rs", "third_party/application-services/tools/generate-rust-dashboards/src/schema.rs", "third_party/application-services/tools/generate-rust-dashboards/src/sql.rs", "third_party/application-services/tools/generate-rust-dashboards/src/team_config.rs", "third_party/application-services/tools/generate-rust-dashboards/src/util.rs", "toolkit/components/uniffi-bindgen-gecko-js/android/components/ads-client/android/src/main/java/mozilla/appservices/adsclient/ads_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/db-crypto/android/src/main/java/mozilla/appservices/db_crypto/db_crypto.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/fxaclient/android/src/main/java/mozilla/appservices/fxaclient/fxa_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/places/android/src/main/java/mozilla/appservices/places/uniffi/places.kt", "toolkit/components/uniffi-bindgen-gecko-js/components/Cargo.toml", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAdsClient.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustAutofill.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustBreachAlerts.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustContextId.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustDbCrypto.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFilterAdult.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustFxcontainers.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustInitRustComponents.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustLogins.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRelevancy.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustRemoteSettings.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSearch.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustSuggest.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTabs.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustTracing.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustViaduct.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/generated/RustWebextstorage.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/components/lib.rs", "toolkit/components/uniffi-bindgen-gecko-js/components/moz.build", "toolkit/components/uniffi-bindgen-gecko-js/config.toml", "toolkit/components/uniffi-bindgen-gecko-js/mach_commands.py", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTests.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsCollision.sys.mjs", "toolkit/components/uniffi-bindgen-gecko-js/tests/generated/RustUniffiBindingsTestsExternalTypes.sys.mjs", "toolkit/components/uniffi-js/GeneratedScaffolding.cpp"], "git_node": "4ea137384c1c709e6e4e676e6d0a4e5229a2488b", "git_parents": ["2ed080eb558ec064c50844b34dad2a70bd98ce60"], "node": "647dbf4d64ccb27dcc5a65202a097dff2f2aec7c", "parents": ["ed8cefc4a0a8b67fd046b277bbfbc84f247b1bcc"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070853 - P2. Give build scripts a glean_parser virtualenv on every build r=firefox-build-system-reviewers,sylvestre\n\nBuilding the application-services megazord fails with \"No module named\nglean_parser\" now that the places component runs its Glean codegen for the host\ntoo: application-services 5ff8ba498eb09c89f494706dd2106274c7e0a1ad (bug 2053207)\ndropped the CARGO_CFG_TARGET_OS android/ios guard around it. rust.mk takes\nGLEAN_PYTHON_VENV_DIR from GRADLE_GLEAN_PARSER_VENV, which\nmobile/android/gradle.configure only sets for Android, so every other build\nexports it empty, and glean-build reads an empty value as a virtualenv path\nrather than as unset.\n\nGLEAN_PARSER_VENV carries that value, the configure virtualenv that has\nglean_parser, for every build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328432\n", "files": ["build/moz.configure/rust.configure", "config/makefiles/rust.mk"], "git_node": "682d343a3828ca7a20dabde69c75e36051233383", "git_parents": ["4ea137384c1c709e6e4e676e6d0a4e5229a2488b"], "node": "9c038359244f7a6432ce84c0e781fdb67cd19132", "parents": ["647dbf4d64ccb27dcc5a65202a097dff2f2aec7c"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070853 - P3. Move logins encryption API to db_crypto r=joschmidt,credential-management-reviewers,android-reviewers,jonalmeida\n\nThe crypto primitives now live in the db_crypto namespace, so their callers move\nwith them.\n\nDesktop: storage-rust.sys.mjs takes PrimaryPasswordAuthenticator and\nAuthenticationCanceled from RustDbCrypto.sys.mjs. LoginsApiError has an\nAuthenticationCanceled of its own, but getPrimaryPassword has to throw the\nDbCryptoApiError one, because that is what the callback interface declares.\n\nAndroid: the primitives now throw DbCryptoApiException, a separate sealed class\nrather than a subclass of LoginsApiException, so catches that stop matching are\nnot flagged at compile time. LoginsCrypto catches it in isKeyRecoveryNeeded and\nwraps it in createKey and storeKeyAndCanary, keeping db_crypto errors inside the\nkey manager, since SyncableLoginsStorage and its Fenix callers catch only\nLoginsApiException. LoginsCryptoTest covers both paths.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324942\n", "files": ["mobile/android/android-components/components/service/sync-logins/build.gradle", "mobile/android/android-components/components/service/sync-logins/src/main/java/mozilla/components/service/sync/logins/LoginsCrypto.kt", "mobile/android/android-components/components/service/sync-logins/src/main/java/mozilla/components/service/sync/logins/SyncableLoginsStorage.kt", "mobile/android/android-components/components/service/sync-logins/src/test/java/mozilla/components/service/sync/logins/LoginsCryptoTest.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt", "toolkit/components/passwordmgr/storage-rust.sys.mjs"], "git_node": "efa469cb5a911b1d4e22d3773c8116b354d54ba8", "git_parents": ["682d343a3828ca7a20dabde69c75e36051233383"], "node": "519b3333febf0347900b98e19a7c1deb9d66e0a7", "parents": ["9c038359244f7a6432ce84c0e781fdb67cd19132"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074953 - Update android nightly application-services version bump to 734e6daa16503b4d2279e6ea5d7aef1fda881258 r=release-managers,diannaS\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328601\n", "files": ["mobile/android/android-components/plugins/dependencies/src/main/java/ApplicationServices.kt", "mobile/android/android-components/plugins/dependencies/src/main/java/moz.yaml"], "git_node": "5bbcbee150da4ee976384c12efb82b2f11f2c757", "git_parents": ["efa469cb5a911b1d4e22d3773c8116b354d54ba8"], "node": "99c83df7d6529e0ba03c95d52d8c97bc6722023f", "parents": ["519b3333febf0347900b98e19a7c1deb9d66e0a7"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2067007 - Partial backout to avoid crashes. r=layout-reviewers,jfkthame\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328786\n", "files": ["layout/generic/nsGridContainerFrame.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-grid/grid-items/percentage-block-size-transfer-through-item-001.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/subgrid/grid-subgridded-to-grid-lanes/track-sizing/column-subgrid-with-row-standalone-axis-size-002.html.ini", "testing/web-platform/meta/css/css-grid/subgrid/standalone-axis-size-011.html.ini"], "git_node": "7394f9b5204a265e03b01a2d93ad33b7f5d3aae9", "git_parents": ["5bbcbee150da4ee976384c12efb82b2f11f2c757"], "node": "4d398838e4fa6518973d534634bdd9374ce6a602", "parents": ["99c83df7d6529e0ba03c95d52d8c97bc6722023f"], "tags": []}, {"author": "Sebastian Hengst \u003caryx.github@gmx-topmail.de\u003e", "branch": "default", "desc": "Bug 2074759 - turn off crashtests for macOS hardware machine. r=taskgraph-reviewers,bhearsum\n\nThey already ran for opt on macOS 15 AArch64 VM machines.\nDebug has been enabled because the blocker bug 2039987 has been fixed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328438\n", "files": ["taskcluster/kinds/reftest/kind.yml", "taskcluster/test_configs/test-sets.yml"], "git_node": "80dc63d0674ee7f352285decfb3f2d1cfa6e649a", "gi