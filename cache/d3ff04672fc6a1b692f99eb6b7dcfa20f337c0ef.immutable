, "security/nss/lib/softoken/softkver.h", "security/nss/lib/util/derdec.c", "security/nss/lib/util/nssutil.h", "security/nss/lib/util/secasn1d.c", "security/nss/lib/util/secoid.c", "security/nss/lib/util/secoidt.h", "security/nss/mach", "security/nss/moz.yaml", "security/nss/nss.gyp", "security/nss/nss/automation/abi-check/new-report-libssl3.so.txt", "security/nss/tests/cert/cert.sh", "security/nss/tests/common/tsan_suppressions.txt", "security/nss/tests/fips/fips.sh", "security/nss/tests/gtests/gtests.sh", "security/nss/tests/tools/openssl-ed25519.p12", "security/nss/tests/tools/tools.sh"], "git_node": "5971d8f82f79861b12072972758404f3e174f537", "git_parents": ["8ed383e7d947dc741235c5e2be91235e46b11804"], "node": "b047337f446e24d5b595a0871340e99be94bd6b9", "parents": ["ee271a3299d55506d3527d3022c238af56b20281"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2075453 - Keep Close Window in the File menu with vertical tabs, and label the close item \"Close\" in single-tab windows. r=tabbrowser-reviewers,fluent-reviewers,nsharpley,bolsson\" for causing bc tests failures at bookmarks_change_title.js\n\nThis reverts commit 64e6c58a1f3ceb9a558895582465f67fcb29f650.\n", "files": ["browser/base/content/browser.js", "browser/base/content/test/browser-menubar/browser_file_close_tabs.js", "browser/components/tabbrowser/content/tab-bar-visibility.js", "browser/locales/en-US/browser/menubar.ftl", "browser/locales/en-US/browser/tabbrowser.ftl"], "git_node": "0d513e95a844da8a1475f0901963980744fe5731", "git_parents": ["5971d8f82f79861b12072972758404f3e174f537"], "node": "2671e438acc23d9895b355c8797905b0fd4abeef", "parents": ["b047337f446e24d5b595a0871340e99be94bd6b9"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075453 - Keep Close Window in the File menu with vertical tabs, and label the close item \"Close\" in single-tab windows. r=tabbrowser-reviewers,fluent-reviewers,nsharpley,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329101\n", "files": ["browser/base/content/browser.js", "browser/base/content/test/browser-menubar/browser_file_close_tabs.js", "browser/components/tabbrowser/content/tab-bar-visibility.js", "browser/locales/en-US/browser/menubar.ftl", "browser/locales/en-US/browser/tabbrowser.ftl"], "git_node": "61a43ce8f9fbdace7d5f13fb42ad4c760c616299", "git_parents": ["0d513e95a844da8a1475f0901963980744fe5731"], "node": "b80c7714941f55af011c17fca8bdc99ec600cbf1", "parents": ["2671e438acc23d9895b355c8797905b0fd4abeef"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "06f6a64c3330664027cc66feb324a95b0c853b89", "git_parents": ["61a43ce8f9fbdace7d5f13fb42ad4c760c616299", "66b70484481af2e01d4da8bb33f4a756aba77d74"], "node": "55347e32571e0c6b6d4b30290f6302f07bebec55", "parents": ["b80c7714941f55af011c17fca8bdc99ec600cbf1", "95ac3488e2e8f022279f90cf01e22920ac32d1ff"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076877 - Remove telemetry.structuredIngestion.endpoint pref from activityStream r=mconley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330039\n", "files": ["browser/components/newtab/test/browser/abouthomecache/browser.toml", "browser/extensions/newtab/lib/ActivityStream.sys.mjs", "browser/extensions/newtab/test/xpcshell/test_AboutHomeStartupCacheWorker.js"], "git_node": "9fceafa8a9bbc0e96bd854f43b7363f49bf6ea13", "git_parents": ["06f6a64c3330664027cc66feb324a95b0c853b89"], "node": "4acf7e69b4bd64a523f015db35ee2c3bc7b01066", "parents": ["55347e32571e0c6b6d4b30290f6302f07bebec55"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076269 part 1 - Ensure the default array shape exists for MIR ops depending on this. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330003\n", "files": ["js/src/jit/CacheIR.cpp", "js/src/jit/WarpOracle.cpp"], "git_node": "846ea08d7d54b5dbdc554f515a07b1b4f59b8f86", "git_parents": ["9fceafa8a9bbc0e96bd854f43b7363f49bf6ea13"], "node": "f75d562e48882d556d5bbc4acb767c19d7f6edaf", "parents": ["4acf7e69b4bd64a523f015db35ee2c3bc7b01066"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076269 part 2 - Remove JSOp::Rest code for missing array shape. r=iain\n\nWarpOracle now always adds a WarpRest snapshot, so MRest always has a shape.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330004\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/ScalarReplacement.cpp", "js/src/jit/WarpBuilder.cpp"], "git_node": "4e76a818b8a6d7a14d7712040e05dd26c6f6f4e2", "git_parents": ["846ea08d7d54b5dbdc554f515a07b1b4f59b8f86"], "node": "7ab99e8d00d3978e2cb0b5efaec04b02630e9878", "parents": ["f75d562e48882d556d5bbc4acb767c19d7f6edaf"], "tags": []}, {"author": "Jan de Mooij \u003cjdemooij@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076269 part 3 - Add test. r=iain\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330005\n", "files": ["js/src/jit-test/tests/ion/bug2076269.js"], "git_node": "d253d35dffa61acbd7a6e38e5551be027ed5cbd9", "git_parents": ["4e76a818b8a6d7a14d7712040e05dd26c6f6f4e2"], "node": "b5f9d0fc1c903c4aa5b8de03f21bea85d858176a", "parents": ["7ab99e8d00d3978e2cb0b5efaec04b02630e9878"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2021271 - Show sign out card in the app menu when status is NOT_VERIFIED. r=nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328549\n", "files": ["browser/base/content/browser-sync.js", "browser/base/content/test/browser-sync/browser_sync.js"], "git_node": "e3bfd0ed8f27c348c7d7b0ab2bca3c2bf5270426", "git_parents": ["d253d35dffa61acbd7a6e38e5551be027ed5cbd9"], "node": "b3045727c37e66f87fe7a5f4cb981c3d2ec76fc3", "parents": ["b5f9d0fc1c903c4aa5b8de03f21bea85d858176a"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076537 - Install pyyaml in the python toolchains. r=firefox-build-system-reviewers,ahochheiden\n\nWith MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=system, as used in\nautomation builds, mach doesn't install packages from PyPI, so pyyaml\nfalls back to the vendored copy, which doesn't have the libyaml bindings.\nLoading YAML with the pure Python loader is several times slower: e.g.\nparsing the Glean metrics.yaml files takes ~5s instead of \u003c1s. Install\npyyaml alongside psutil and zstandard in the python toolchains so builds\nget the native loader.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329814\n", "files": ["build/pyyaml_requirements.in", "build/pyyaml_requirements.txt", "taskcluster/kinds/toolchain/python.yml", "taskcluster/scripts/misc/build-cpython.sh", "taskcluster/scripts/misc/pack-cpython.sh"], "git_node": "e907acb8490ed485439e414dc84948a9e326e6ff", "git_parents": ["e3bfd0ed8f27c348c7d7b0ab2bca3c2bf5270426"], "node": "1f2c39c3ec91568e7c6e46c4b4aababef6e7c5c5", "parents": ["b3045727c37e66f87fe7a5f4cb981c3d2ec76fc3"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076539 - Part 1 - Don't use sccache for try artifact builds. r=taskgraph-reviewers,hneiva\n\nArtifact builds don't compile anything, so starting an sccache server,\nfetching the sccache toolchain and granting access to the sccache buckets\nis wasted effort.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329815\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_build.py", "taskcluster/gecko_taskgraph/transforms/build.py"], "git_node": "8646b8c704ff7dc37d7d94941e9eab026c8556f2", "git_parents": ["e907acb8490ed485439e414dc84948a9e326e6ff"], "node": "d3df94a2420849dd5d8d5f2a7001e67d4081b1c0", "parents": ["1f2c39c3ec91568e7c6e46c4b4aababef6e7c5c5"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076539 - Part 2 - Don't fetch compile toolchains for try artifact builds. r=taskgraph-reviewers,hneiva\n\nTry artifact builds kept all the toolchains of the build they replace,\nincluding compilers, sysroots and SDKs they don't use, and the ONNX\nruntime, which they get from the upstream build like the rest of the\nbinaries. Besides the download and unpacking time, depending on those\ntoolchains means waiting for them to be rebuilt when they change.\n\nWith this, the linux64, macosx64 and win64 artifact builds fetch the\nsame toolchains as the corresponding artifact-build tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329816\n", "files": ["taskcluster/gecko_taskgraph/test/test_transforms_build.py", "taskcluster/gecko_taskgraph/transforms/build.py"], "git_node": "273097f027b7d502639fb2e9d52e63626e305cb2", "git_parents": ["8646b8c704ff7dc37d7d94941e9eab026c8556f2"], "node": "8d57592fd843d6d0d5620ac3353263c9d167c82f", "parents": ["d3df94a2420849dd5d8d5f2a7001e67d4081b1c0"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076876 - Fix profiler-analysis skill yaml to parse properly. r=canova\n\nSome yaml parsers (like Zed's) choke on the colon, so use a proper\nmultiline string instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330029\n", "files": [".agents/skills/profiler-analysis/SKILL.md", ".claude/skills/profiler-analysis/SKILL.md"], "git_node": "8ab68013c2e286cb6f61cd46e8ab46e56f9a1dec", "git_parents": ["273097f027b7d502639fb2e9d52e63626e305cb2"], "node": "bdc5a6a4f38b6ef8288129ae2f6fb2f7aa0e703e", "parents": ["8d57592fd843d6d0d5620ac3353263c9d167c82f"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074632: Invalidate Ion when a pure DOM call reallocates the global's slots r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329341\n", "files": ["js/src/jit/CodeGenerator.cpp", "js/src/jit/CodeGenerator.h", "js/src/jit/Ion.cpp", "js/src/jit/JitRuntime.h", "js/src/vm/Interpreter.cpp", "js/src/vm/NativeObject.cpp"], "git_node": "068cf1d361bd926df458dd3cc5975305f3934d61", "git_parents": ["8ab68013c2e286cb6f61cd46e8ab46e56f9a1dec"], "node": "af1d8e45a295f2a94e6244004dae296071c4486a", "parents": ["bdc5a6a4f38b6ef8288129ae2f6fb2f7aa0e703e"], "tags": []}, {"author": "Iain Ireland \u003ciireland@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074632: Add test r=jandem\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329342\n", "files": ["js/src/jit-test/tests/ion/dom-pure-getter-grows-global-slots.js", "js/src/shell/js.cpp"], "git_node": "c545d49beacfa113722c357dc7549c69f5064b5e", "git_parents": ["068cf1d361bd926df458dd3cc5975305f3934d61"], "node": "2ed8bb32e91672a9bdff851252b9c937de228285", "parents": ["af1d8e45a295f2a94e6244004dae296071c4486a"], "tags": []}, {"author": "Daisuke Akatsuka \u003cdaisuke@birchill.co.jp\u003e", "branch": "default", "desc": "Bug 2068504 - Use the urlbar box colors for the search mode switcher r=dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323461\n", "files": ["browser/themes/shared/urlbar.css", "browser/themes/shared/urlbar/urlbar.tokens.css", "browser/themes/shared/urlbar/urlbar.tokens.json", "toolkit/themes/shared/design-system/dist/nova/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-primitives.json", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs"], "git_node": "f28a07968355963a7edbedf2d0d6dfea5a081bce", "git_parents": ["c545d49beacfa113722c357dc7549c69f5064b5e"], "node": "c3804c3cd37ef3f6b6467096f87386bed1acdbaa", "parents": ["2ed8bb32e91672a9bdff851252b9c937de228285"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071254 - Part 1: Document onboarding completion states following the continuous onboarding rollout. r=android-reviewers,gmalekpour,marcin\n\nAdd a README describing the completion state of each user cohort, the paths that can bypass the onboarding UI, and how these states affect feature gating.\n\nDocument the proposed reconciliation strategy for backfilling missing timestamps without overwriting genuine continuous onboarding progress.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326553\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/Onboarding-state-migration-and-reconciliation.md"], "git_node": "560a08cbc86b45da1c455247f99d05e94319c6d6", "git_parents": ["f28a07968355963a7edbedf2d0d6dfea5a081bce"], "node": "1e9c6e8c349c2f3e6038a96f9a5d2b34a8060a28", "parents": ["c3804c3cd37ef3f6b6467096f87386bed1acdbaa"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071254 - Part 2: Migrate pre-continuous-onboarding users' preferences to ensure a consistent state for all users after continuous onboarding was enabled. r=android-reviewers,gmalekpour,marcin\n\nThere are three user cohorts with respect to `Settings.onboardingCompletedTimestamp`, the timestamp introduced alongside continuous onboarding to record when initial onboarding completed:\n\n1. Cohort 1: Users who fully onboarded before continuous onboarding existed.\n2. Cohort 2: Users who onboarded through the modern onboarding flow while continuous onboarding existed in the code but was not yet enabled for them.\n3. Cohort 3: Users who onboarded with continuous onboarding already enabled, with none, some, or all of the day-N stages completed depending on their progress.\n\nWithout a real `onboardingCompletedTimestamp`, cohort 1 is treated inconsistently by features that key off elapsed time since onboarding. In particular, the review prompt's `continuousOnboardingInProgress` gate can never resolve for this cohort: the day-N stage timestamps can also never be set without a real `onboardingCompletedTimestamp` to progress from, so once `continuousOnboardingFeatureEnabled` was enabled, this cohort is permanently blocked from ever seeing the review prompt.\n\n`Settings.reconcileOnboardingCompletionState()` dispatches to one of two paths based on whether `onboardingCompletedTimestamp` is already set, but both converge on the exact same fully-backfilled state:\n\n- For cohort 1, it backfills `onboardingCompletedTimestamp` and all four day-N stage timestamps using a fixed date (version 150's release, when these preferences were introduced), so the user ends up in the same state as one who has already completed continuous onboarding.\n- For cohort 2, whose `onboardingCompletedTimestamp` is real but predates continuous onboarding's release, that timestamp is overwritten too, using the same fixed date, along with the day-N stage timestamps. Nothing within continuous onboarding depends on this timestamp being genuine for these users. The only other reader, `PrivacyReportNotificationWorker.schedule()`, skips unset timestamps and otherwise clamps its one-week delay to zero, so once the weekly privacy notification feature is enabled these users receive their first notification immediately; that feature is still off by default. Overwriting the timestamp means cohorts 1, 2, and 4 all end up in the exact same, recognizable state rather than cohort 2 being distinguishable by a lingering real timestamp.\n\nCohort 3 is left untouched by both paths, since its `onboardingCompletedTimestamp` already postdates the release cutoff.\n\nThere is also a fourth cohort: users marked onboarded through a live code path unrelated to when continuous onboarding was introduced, which never records `onboardingCompletedTimestamp`, so they can end up in the same state as cohort 1. This migration can't distinguish cohort 4 from cohort 1\u2014both present as `userHasBeenOnboarded()` true with an unset `onboardingCompletedTimestamp`\u2014so it backfills cohort 4 the same way. No dedicated tracking preference is needed to keep migrated installations identifiable: since every backfilled field is set to the same fixed timestamp, a future fix can recognize this cohort by comparing any of them against that known value.\n\n`FenixApplication` only invokes this migration for users who have actually been onboarded (`FenixOnboarding.userHasBeenOnboarded()`), gated behind `Config.channel.isNightlyOrDebug` to avoid exposing it to release users ahead of QA validation.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326554\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/perf/StartupExcessiveResourceUseTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/FenixApplication.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingCompletionStateMigration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/OnboardingCompletionStateMigrationTest.kt"], "git_node": "f8fac4b17db73c7d2655efdf20a706607ef21115", "git_parents": ["560a08cbc86b45da1c455247f99d05e94319c6d6"], "node": "c714ae0517183793c4679b33f09341449fda01c7", "parents": ["1e9c6e8c349c2f3e6038a96f9a5d2b34a8060a28"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074411 - Report IP Protection eligibility as Unknown while the region is unresolved. r=android-reviewers,jonalmeida,gmalekpour\n\nThe eligibility storage reported `UnsupportedRegion` until the browser store's region was set, which only happens in `HomeActivity.onResume`, after the day-7 continuous onboarding binding has already started. That transient value is indistinguishable from a genuinely unsupported region and permanently marked the day-7 stage complete for eligible users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328124\n", "files": ["mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/IPProtectionFeature.kt", "mobile/android/android-components/components/feature/ipprotection/src/main/java/mozilla/components/feature/ipprotection/store/state/EligibilityStatus.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/ipprotection/FenixIPProtectionEligibilityStorage.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/ipprotection/FenixIPProtectionEligibilityStorageTest.kt"], "git_node": "8398cba0e7dfa2edf846143f5d70d66e96edd3b7", "git_parents": ["f8fac4b17db73c7d2655efdf20a706607ef21115"], "node": "56c32d6a813a10f4f9ffd0bcf15b9470c73bec3b", "parents": ["c714ae0517183793c4679b33f09341449fda01c7"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071254 - Part 3: Mark day-7 continuous onboarding complete for users ineligible for IP Protection or who can no longer be shown its prompt. r=android-reviewers,gmalekpour\n\nThe day-7 stage only completed via `IPProtectionOnboardingPrompt.onShowOnboarding`, which fires once the user becomes IP-Protection-eligible and the prompt's other conditions are met. Users who are permanently ineligible (Nimbus config or unsupported region) never reach that callback, so `seventhDayOnboardingCompletedTimestamp` stays unset indefinitely, which keeps `ContinuousOnboardingFeature` re-entering the `DAY_7` stage and keeps `ReviewPromptMiddleware`'s `continuousOnboardingInProgress` gate blocked.\n\nAdd an `onIneligible` callback to `IPProtectionOnboardingPrompt`, invoked when eligibility resolves to `Ineligible` or `UnsupportedRegion`, and wire it in `ContinuousOnboardingFeature` to mark the day-7 stage complete.\n\nThe same gap applied to an eligible user for whom `IPProtectionPromptRepository.canShowIPProtectionPrompt()` returns false, for example because the prompt was already shown outside continuous onboarding or the VPN was already used: `onShowOnboarding` never fires, so day 7 never completes. Add an `onAlreadySatisfied` callback for that case and wire it the same way.\n\nAll three callbacks go through `ContinuousOnboardingFeature.completeDaySeven()`, which marks the stage complete only once and then stops the IP Protection binding, so later store emissions in the same session cannot complete the stage again.\n\nThe ineligible and already-satisfied paths record the stage through `OnboardingTelemetryRecorder.onOnboardingComplete` under a new `ip_protection` sequence id, as the day-5 stage already does when it is skipped, so day-7 completions without the prompt are visible in the existing onboarding telemetry.\n\nThis depends on bug 2074411, which stops `UnsupportedRegion` being reported transiently at startup while the region is still unresolved. Without it, this change would mark day 7 complete for an eligible user.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326555\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPrompt.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/Onboarding-state-migration-and-reconciliation.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/continuous/ContinuousOnboardingFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/FakeIPProtectionPromptRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPromptTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/continuous/ContinuousOnboardingFeatureTest.kt"], "git_node": "d0e62d55e8d3119e3a193b70fde006c581a6fd3e", "git_parents": ["8398cba0e7dfa2edf846143f5d70d66e96edd3b7"], "node": "a3b7641d3c42dfa6f9fba916b89194cc71986b2d", "parents": ["56c32d6a813a10f4f9ffd0bcf15b9470c73bec3b"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071254 - Part 4: Remove the now-redundant week-based gate from `IPProtectionPromptRepository`. r=android-reviewers,gmalekpour\n\nContinuousOnboardingFeature only invokes `IPProtectionOnboardingPrompt` once the day-7 stage is reached, which\nalready enforces that at least a week has elapsed since onboarding completed via `ContinuousOnboardingStageProvider`.\n`IPProtectionPromptRepository.completedOnboardingOverAWeekAgo()` duplicated that timing check independently against\n`Settings.onboardingCompletedTimestamp`, using a strict \"more than a week\" comparison. On day 7 itself, that stricter\ncheck failed even though the continuous onboarding stage considered the user due, so the IP Protection prompt would\nnot appear until a day after the day-7 stage was reached instead of on day 7 as intended.\n\nThis also removes the currentTimeMillis/timeProvider plumbing that existed solely to support that check, in\n`IPProtectionPromptRepository` and `IPProtectionOnboardingPrompt`, along with their tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327794\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPrompt.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/ipprotection/store/IPProtectionPromptRepository.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/continuous/ContinuousOnboardingFeature.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/FakeIPProtectionPromptRepository.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionOnboardingPromptTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/ipprotection/store/IPProtectionPromptRepositoryTest.kt"], "git_node": "8c3c8aa3d5df809de6ebeda10abf3d70fc565b5e", "git_parents": ["d0e62d55e8d3119e3a193b70fde006c581a6fd3e"], "node": "944167d756fe579279a41239817e1532362fe84c", "parents": ["a3b7641d3c42dfa6f9fba916b89194cc71986b2d"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072667 - Add telemetry for the onboarding completion state backfill. r=android-reviewers,marcin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328105\n", "files": ["mobile/android/fenix/app/metrics.yaml", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/Onboarding-state-migration-and-reconciliation.md", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingCompletionStateMigration.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/OnboardingCompletionStateMigrationTest.kt"], "git_node": "f1d5bcb34d3f2405107080a1189400ebb3d3502b", "git_parents": ["8c3c8aa3d5df809de6ebeda10abf3d70fc565b5e"], "node": "36355b72b7b7fc877216243f5ff78447abfdd770", "parents": ["944167d756fe579279a41239817e1532362fe84c"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076210 - Show the custom review prompt through the fragment manager so it is not dismissed by a navigation to the homepage. r=android-reviewers,Roger\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329649\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/HomeFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/OnboardingCompletionStateMigration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/reviewprompt/CustomReviewPromptBottomSheetFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/reviewprompt/ShowReviewPromptBinding.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/reviewprompt/ShowPlayStoreReviewPromptTest.kt"], "git_node": "4bb61966096e5a6bb44f57bb2b4d3e69d1ebc235", "git_parents": ["f1d5bcb34d3f2405107080a1189400ebb3d3502b"], "node": "7ffe03bcdd34f5fd75c808d746394e7ffa5d8b8a", "parents": ["36355b72b7b7fc877216243f5ff78447abfdd770"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2059729 - Add getTabGroups/getTabGroupById to TabManagementService r=ai-security-reviewers,bjohns,gregtatum,flozia\n\nGive tab group aware prompting a single read API so its consumers don't each reach into gBrowser.tabGroups and duplicate the filtering. Grouped tabs use the same isAllowedURL, isNewPageUrl, and sanitizeUntrustedContent rules as getTabList(); to share them, isAllowedURL moves into ChatUtils.sys.mjs. Includes xpcshell coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319374\n", "files": ["browser/components/aiwindow/models/SecurityProperties.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_TabManagementService.js"], "git_node": "c769e5f04e1858f539585f5d55cd84c76572b30f", "git_parents": ["4bb61966096e5a6bb44f57bb2b4d3e69d1ebc235"], "node": "51e2b17b43bd56c892ae57c965b47620a8249923", "parents": ["7ffe03bcdd34f5fd75c808d746394e7ffa5d8b8a"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2014499 - Add a Groups section to the Smart Window mentions panel r=fluent-reviewers,urlbar-reviewers,mlucks,bolsson\n\nRender open tab groups as a \"Groups\" section above the \"Tabs\" section in the mentions panel, sourced from TabManagementService.getTabGroups(). Each group shows a colored chicklet (the tab group color with the label's initial) and the group label, capped by a new browser.urlbar.mentions.maxGroupResults pref that is separate from the tab cap.\n\nThe tab group color tokens (--tab-group-*) live in the tabbrowser chrome sheet, which the AI window content document does not load, so they are imported into ai-window-shared.css and reused rather than duplicating the palette.\n\nGroup rows are non-interactive for now; selecting a group to mention is wired up separately (bug 2059787), and filtering groups while typing is deferred. Adds component and integration browser tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320275\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.mjs", "browser/components/aiwindow/ui/content/ai-window-shared.css", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_panel_list.js", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "browser/locales/en-US/browser/aiWindow.ftl"], "git_node": "0bf2928d79362c8c1560a9b9a66e441d763908a1", "git_parents": ["c769e5f04e1858f539585f5d55cd84c76572b30f"], "node": "7c3364c733423445771541aaafb09300f90aa5d9", "parents": ["51e2b17b43bd56c892ae57c965b47620a8249923"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059730 - Add a tabGroup mention type to the Smart Window mention data model r=czhou,urlbar-reviewers,ai-security-reviewers,tetchart,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326996\n", "files": ["browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.mjs", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_tab_group_mentions.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "browser/components/urlbar/content/SmartbarMentionUtils.mjs", "browser/components/urlbar/jar.mn", "tools/@types/generated/tspaths.json"], "git_node": "e180ca92dfcb0de0a7e1a6bf557e46b8df027ba6", "git_parents": ["0bf2928d79362c8c1560a9b9a66e441d763908a1"], "node": "e21ce12a2695178090772f833070fc6cffdad63c", "parents": ["7c3364c733423445771541aaafb09300f90aa5d9"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2059782 - Render a referenced tab group as a single chip r=urlbar-reviewers,ai-security-reviewers,flozia,Standard8\n\nA tab group has no page behind it, so a chip cannot take a favicon or a link from it. A referenced tab group now renders as a single chip showing its label in the group's color, in the smartbar header, the prompt input and the submitted message, and it collapses into the existing grouped chip summary alongside tab chips. The box holding the label's initial is a new tab-group-icon element that the chip and the collapsed summary share. Storybook covers both in every group color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326469\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.css", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.stories.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.css", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.stories.mjs", "browser/components/aiwindow/ui/components/tab-group-icon/tab-group-icon.css", "browser/components/aiwindow/ui/components/tab-group-icon/tab-group-icon.mjs", "browser/components/aiwindow/ui/components/tab-group-icon/tab-group-icon.stories.mjs", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aichat_message.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_grouped_chips.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_website_chip.js", "browser/components/aiwindow/ui/test/browser/test_website_chip_page.html", "browser/components/multilineeditor/plugins/MentionsPlugin.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "tools/@types/generated/tspaths.json"], "git_node": "9f5b576c1884379ac7ae78921f49c480732dc91f", "git_parents": ["e180ca92dfcb0de0a7e1a6bf557e46b8df027ba6"], "node": "f0d13d8cd29aec1f68325a7d83f5478fd9c5b3f3", "parents": ["e21ce12a2695178090772f833070fc6cffdad63c"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2059787 - Wire tab group selection through the mention entry points r=urlbar-reviewers,flozia,Standard8\n\nTab group rows in the mentions panel were render only. Group rows now wrap a panel-item the way description rows do, with the tab group icon beside it, so they are clickable and keyboard reachable and go through the panel's existing item-selected path. The row reports the group's color and type along with its ID and label.\n\nThe \"+\" menu now adds a group context chip and the inline \"@\" command inserts a group mention, both identified by the group's ID rather than a URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326470\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_context_chips.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_panel_list.js", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "48c8300fc15635ca080f7feceea2509da41b5c87", "git_parents": ["9f5b576c1884379ac7ae78921f49c480732dc91f"], "node": "1ae2a7098a518ae940fc7706c93a0c9af14dc1d4", "parents": ["f0d13d8cd29aec1f68325a7d83f5478fd9c5b3f3"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059755 - Expand tab group mentions at submit time r=czhou,urlbar-reviewers,ai-security-reviewers,Standard8\n\nA tab group mention is expanded when a prompt is sent. The expanded members do not get the persistent fetch permissions a single explicitly mentioned tab receives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328253\n", "files": ["browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_tab_group_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_security_tab_group_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarMentionUtils.mjs"], "git_node": "fd869173791db81ab038a0427890141a4990eb73", "git_parents": ["48c8300fc15635ca080f7feceea2509da41b5c87"], "node": "47fe89f17bbdb852e18db3041f84c7dcf536c6d5", "parents": ["1ae2a7098a518ae940fc7706c93a0c9af14dc1d4"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059783 - Include tab group info in the browser context prompt r=bjohns\n\nTabs expanded from a tab group were indistinguishable from individually mentioned tabs. Serialize them nested under their respective groups.\n\nThe Remote Settings fragment for the model is tracked in bug 2070322.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328573\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_browser_context.js"], "git_node": "2569aa46fa5d604651d358ea650867b0f7eb01a7", "git_parents": ["fd869173791db81ab038a0427890141a4990eb73"], "node": "c42423edb12b3f4614897ede7ff68f16141f2e40", "parents": ["47fe89f17bbdb852e18db3041f84c7dcf536c6d5"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076539, Bug 2076537 - Part 2 - Don't fetch compile toolchains for try artifact builds. r=taskgraph-reviewers,hneiva\" for causing python toolchain failures\n\nThis reverts commit 273097f027b7d502639fb2e9d52e63626e305cb2.\n\nRevert \"Bug 2076539 - Part 1 - Don't use sccache for try artifact builds. r=taskgraph-reviewers,hneiva\"\n\nThis reverts commit 8646b8c704ff7dc37d7d94941e9eab026c8556f2.\n\nRevert \"Bug 2076537 - Install pyyaml in the python toolchains. r=firefox-build-system-reviewers,ahochheiden\"\n\nThis reverts commit e907acb8490ed485439e414dc84948a9e326e6ff.\n", "files": ["build/pyyaml_requirements.in", "build/pyyaml_requirements.txt", "taskcluster/gecko_taskgraph/test/test_transforms_build.py", "taskcluster/gecko_taskgraph/transforms/build.py", "taskcluster/kinds/toolchain/python.yml", "taskcluster/scripts/misc/build-cpython.sh", "taskcluster/scripts/misc/pack-cpython.sh"], "git_node": "e7bd7614de77a7ddf27aca2f4f04c5b9ad3102b4", "git_parents": ["2569aa46fa5d604651d358ea650867b0f7eb01a7"], "node": "ae065d930d8202813e46a11f3699d2fe1770b37e", "parents": ["c42423edb12b3f4614897ede7ff68f16141f2e40"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2075197 - Allow a crashtest to assert more.\n\nIt's font-metrics dependent. I haven't yet found the cross-test state\nbut it fails locally on headful mode already.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330067\n", "files": ["layout/generic/crashtests/crashtests.list"], "git_node": "cf90232f2f7c227ef543c1a6e019a1ab8a47fcad", "git_parents": ["e7bd7614de77a7ddf27aca2f4f04c5b9ad3102b4"], "node": "fd6a11db097e3100c7c0d32a88eaae48b6ae7265", "parents": ["ae065d930d8202813e46a11f3699d2fe1770b37e"], "tags": []}, {"author": "Alex Jakobi \u003cajakobi@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075197 - Return SnapTarget*s instead of Maybe\u003cnscoord\u003e from GetCandidateFromLastTargets r=layout-reviewers,dshin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328831\n", "files": ["layout/generic/ScrollSnap.cpp"], "git_node": "60f3a1fea12c548ce3d8b2033cce093959d96704", "git_parents": ["cf90232f2f7c227ef543c1a6e019a1ab8a47fcad"], "node": "cd9f60271a04ed1ba593e140a9c6a13a271a91c1", "parents": ["fd6a11db097e3100c7c0d32a88eaae48b6ae7265"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2076600 - Reduce invalidation of non-promoted ExternalSurface in Renderer::composite_simple() r=gfx-reviewers,lsalzman\n\nRenderer::composite_simple() always invalidate non-promoted ExternalSurface in Renderer::composite_simple(). This invalidation could be reduced.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329866\n", "files": ["gfx/wr/webrender/src/composite.rs", "gfx/wr/webrender/src/renderer/composite.rs"], "git_node": "87f2ebe864e87c13a33066a0a1c7a6e247c3bc00", "git_parents": ["60f3a1fea12c548ce3d8b2033cce093959d96704"], "node": "c3a543e02cb33fcf6c5cb7a8337d6974c60f3e37", "parents": ["cd9f60271a04ed1ba593e140a9c6a13a271a91c1"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076596 - Type-check the tab strip's window modules, starting with tab-groups-list.mjs and opentabs-splitview.mjs, and GroupsList.sys.mjs. r=tabbrowser-reviewers,nsharpley\n\nGroupsList's row builder receives open groups as tab group elements, which have no `saved` property, and saved groups as state objects that always have `saved: true`, so checking `!isOpen` instead is behavior-neutral.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329844\n", "files": ["browser/components/tabbrowser/GroupsList.sys.mjs", "browser/components/tabbrowser/content/opentabs-splitview.mjs", "browser/components/tabbrowser/content/tab-groups-list.mjs", "browser/components/tabbrowser/tsconfig.json", "browser/components/tabbrowser/types/globals.ts"], "git_node": "84e401eabf5c5755bf4274ab7eb05416795e558d", "git_parents": ["87f2ebe864e87c13a33066a0a1c7a6e247c3bc00"], "node": "f4b17bd21a8502a9390b83a240d16065992a957e", "parents": ["c3a543e02cb33fcf6c5cb7a8337d6974c60f3e37"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076596 - Declare the lazy getters with XPCOMUtils.declareLazy in the type-checked tabbrowser modules. r=tabbrowser-reviewers,kcochrane\n\ndeclareLazy types a preference by its default, so the four AsyncTabSwitcher preferences that had none take the value browser/app/profile/firefox.js sets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329846\n", "files": ["browser/components/tabbrowser/AsyncTabSwitcher.sys.mjs", "browser/components/tabbrowser/GroupsList.sys.mjs", "browser/components/tabbrowser/NewTabPagePreloading.sys.mjs", "browser/components/tabbrowser/OpenInTabsUtils.sys.mjs", "browser/components/tabbrowser/TabUnloader.sys.mjs", "browser/components/tabbrowser/content/opentabs-splitview.mjs", "browser/components/tabbrowser/content/tab-groups-list.mjs"], "git_node": "4c7e12f307de8b5ac4009161d826d9524562699a", "git_parents": ["84e401eabf5c5755bf4274ab7eb05416795e558d"], "node": "c407d93102b5b309cc25a2970e0419da25d276fe", "parents": ["f4b17bd21a8502a9390b83a240d16065992a957e"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076596 - Declare the lazy getters with XPCOMUtils.declareLazy in the tabbrowser modules still excluded from type checking. r=tabbrowser-reviewers,kcochrane\n\ndeclareLazy types a preference by its default, so the three SmartTabGrouping preferences that had none take the value browser/app/profile/firefox.js sets.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329847\n", "files": ["browser/components/tabbrowser/SmartTabGrouping.sys.mjs", "browser/components/tabbrowser/TabsList.sys.mjs", "browser/components/tabbrowser/content/tab-hover-preview.mjs", "browser/components/tabbrowser/content/tab.mjs"], "git_node": "f0ce2dc6c1dbf8259f09627d8ea4a308e07a461c", "git_parents": ["4c7e12f307de8b5ac4009161d826d9524562699a"], "node": "6085882736fd8db1ec2d6d826a8b14613917045e", "parents": ["c407d931