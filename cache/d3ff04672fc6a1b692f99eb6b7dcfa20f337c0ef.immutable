543"], "node": "7dfe00057db0d4afcea6fb86081d5c70d51b8e0c", "parents": ["57142019b46be032d9ee243903640fc4fd256632"], "tags": []}], "date": 1791291495, "git_changesets": ["7eb5d82ef1673fc4bbe95c0274e2ccbb3f48550e"], "user": "ffxbld@lando.moz.tools"}, "45495": {"changesets": [{"author": "ffxbld \u003cffxbld@lando.moz.tools\u003e", "branch": "tags-unified", "desc": "No bug - Tagging 737ec77d798755890b062aab541a90d6c75afd19 with FIREFOX_157_0_1_RELEASE a=tagging CLOSED TREE DONTBUILD", "files": [".hgtags"], "git_node": "ad331bb78a0a06ed470863299034ac1424fa74bf", "git_parents": ["7eb5d82ef1673fc4bbe95c0274e2ccbb3f48550e"], "node": "344d56fe96b7ab9cd39126a29c676a9c87485dae", "parents": ["7dfe00057db0d4afcea6fb86081d5c70d51b8e0c"], "tags": []}], "date": 1791291558, "git_changesets": ["ad331bb78a0a06ed470863299034ac1424fa74bf"], "user": "ffxbld@lando.moz.tools"}, "45496": {"changesets": [{"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074584 - Wake the timer thread for a timer due before the end of its wakeup window. r=jlink,xpcom-reviewers,nika\n\nThe timer thread hands the monitor a wakeup time and a tolerance and, where\nthe monitor honours the tolerance, may sleep until the end of that window.\nAddTimer only compared a new timer against the start of the window, so a\ntimer due inside it did not wake the thread and fired late by the remaining\ntolerance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328224\n", "files": ["xpcom/threads/TimerThread.cpp", "xpcom/threads/TimerThread.h"], "git_node": "882c9d7b02871c386060a5e8bf1a90e5b0612d73", "git_parents": ["4b5e436b8bc908fe7feb7341209140771397dda1"], "node": "79b9a558d4f6974110da46d368f2e2bae508095b", "parents": ["953be279951f07690621f6086ec11458249763c6"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077739. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331018\n", "files": ["gfx/wr/swgl/src/swgl_ext.h"], "git_node": "267ed4181dc6abca8108532ccbea7cd89e120f2d", "git_parents": ["882c9d7b02871c386060a5e8bf1a90e5b0612d73"], "node": "dc58e586c62397a8b525138016bcb389f469d8ba", "parents": ["79b9a558d4f6974110da46d368f2e2bae508095b"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2036862 - Make sure to use a fresh connection for each captive portal check r=necko-reviewers,sunil\" per developer's request due to regressing Android LCP in bug 2076416\n\nThis reverts commit 9262f33b318dc1d92426e7c0186d1e53c7d657b5.\n", "files": ["toolkit/components/captivedetect/CaptiveDetect.sys.mjs", "toolkit/components/captivedetect/test/unit/test_fresh_connection.js", "toolkit/components/captivedetect/test/unit/xpcshell.toml"], "git_node": "3a8f2add38a9b210d63d5c65c34b81e36752a24e", "git_parents": ["267ed4181dc6abca8108532ccbea7cd89e120f2d"], "node": "3bc5be49fdd1774dd611aa57434bd881e9778e8d", "parents": ["dc58e586c62397a8b525138016bcb389f469d8ba"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 1: Unify the hint charset handling between the script preload and regular script load. r=bthrall,dom-worker-reviewers,edenchuang\n\nStore the hint charset attribute into the ScriptLoadRequest field, both for the\npreload and the regular load, so that the remaining part of the preload and\nthe cache handling doesn't have to distinguish between them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324186\n", "files": ["dom/script/ModuleLoader.cpp", "dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "dom/workers/ScriptLoader.cpp", "js/loader/ModuleLoadRequest.cpp", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/script-charset-03.html.ini"], "git_node": "1c86ec6b9d4c686537cfc56e317e9ca78a83e756", "git_parents": ["3a8f2add38a9b210d63d5c65c34b81e36752a24e"], "node": "2a8a11ea16f438c9eb3ff28083bc1d32c3290970", "parents": ["3bc5be49fdd1774dd611aa57434bd881e9778e8d"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 2: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314577\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "remote/shared/NetworkResponse.sys.mjs"], "git_node": "6dde04ce86c3f10f7e769b52e8a02d59bc3c8e71", "git_parents": ["1c86ec6b9d4c686537cfc56e317e9ca78a83e756"], "node": "e38747fa79fdcde847ccd90dc6f009e78a49f280", "parents": ["2a8a11ea16f438c9eb3ff28083bc1d32c3290970"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 3: Move the alignment handling out of LoadedScript methods and clarify the input/output. r=bthrall\n\nThe later patch will put an extra section between the SRI+padding and the\nserialized stencil.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324187\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "js/loader/LoadedScript.h"], "git_node": "ca36c89d89616316b920794437a37883427e1b8a", "git_parents": ["6dde04ce86c3f10f7e769b52e8a02d59bc3c8e71"], "node": "6f669f3fea4cc97709774d15df25812a7b17a1bb", "parents": ["e38747fa79fdcde847ccd90dc6f009e78a49f280"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 4: Add ScriptLoader::GetClassicScriptFallbackEncoding. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324188\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "6e7badec12588837fe00dfe22e7b2c0ad4784cd5", "git_parents": ["ca36c89d89616316b920794437a37883427e1b8a"], "node": "43328df5680248be850384c6ff51dfb6610e1337", "parents": ["6f669f3fea4cc97709774d15df25812a7b17a1bb"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 5: Put the encoding into the serialized stencil. r=bthrall\n\nThe encoding becomes a part of the cached value.\nWhen encoding doesn't match, the cache is treated in the same way as corrupted,\nand the load restarted, bypassing the cache.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324189\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h"], "git_node": "5db343c3ddb0ce24762ab3dc3b3011b49b8d4b15", "git_parents": ["6e7badec12588837fe00dfe22e7b2c0ad4784cd5"], "node": "cc514dc2e18484d176d50a77e47448ebfd180da6", "parents": ["43328df5680248be850384c6ff51dfb6610e1337"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 6: Validate the script preload with fallback encoding. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330332\n", "files": ["dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "8a7e9141d94ac86e810e411ef525720575df2615", "git_parents": ["5db343c3ddb0ce24762ab3dc3b3011b49b8d4b15"], "node": "77451dc4908fc326de1ef4f415ec1d3148502ff5", "parents": ["cc514dc2e18484d176d50a77e47448ebfd180da6"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 7: Use the encoding when looking up the in-memory script cache. r=bthrall\n\nCompare the hint encoding also for the in-memory cache, but only when the\nhint encoding was actually used.\n\nFor script preloads, the document's encoding may not have been settled yet,\nand in that case, the check is performed when the actual script load is\nlooking up the preload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324190\n", "files": ["dom/script/ScriptLoader.cpp"], "git_node": "05b6bc411d3050e91fb441ecc9e4e917210f2fc1", "git_parents": ["8a7e9141d94ac86e810e411ef525720575df2615"], "node": "93bc5f9576bc88999a29c0ca10481deeab885d05", "parents": ["77451dc4908fc326de1ef4f415ec1d3148502ff5"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 8: Add tests. r=bthrall,perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314581\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset_html.sjs", "dom/base/test/file_js_cache_charset_js.sjs", "dom/base/test/head.js"], "git_node": "5bd68c70eb7d7d737e96a742284a287baf59f686", "git_parents": ["05b6bc411d3050e91fb441ecc9e4e917210f2fc1"], "node": "c013a9bdd86fc24d29446b1dff88368ae5dcc676", "parents": ["93bc5f9576bc88999a29c0ca10481deeab885d05"], "tags": []}, {"author": "Jari Jalkanen \u003cjjalkanen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067502: Tolerate orphaned extension origins during temporary storage initialization. r=dom-storage-reviewers,asuth\n\nOrphaned moz-extension storage directories left behind after extension\nuninstall could fatally block QuotaManager temporary storage initialization.\n\nThis also addresses the remaining concerns of bug 1521541. Thanks to Tom Tung\nfor the original work there.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330095\n", "files": ["dom/indexedDB/ActorsParent.cpp", "dom/indexedDB/test/unit/test_obsoleteDatabaseRemovalFailure.js", "dom/indexedDB/test/unit/xpcshell-parent-process.toml", "dom/quota/ActorsParent.cpp", "dom/quota/OriginOperations.cpp", "dom/quota/QuotaCommon.h", "dom/quota/nsIQuotaArtificialFailure.idl"], "git_node": "b9ea714bf97c76ff42f932338a6df7c1c78b75ea", "git_parents": ["5bd68c70eb7d7d737e96a742284a287baf59f686"], "node": "e4973e1bed5236007e7afa65316f10b49c4cf14b", "parents": ["c013a9bdd86fc24d29446b1dff88368ae5dcc676"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074744 - [devtools] Don't set ruleview-overridden class on unknown properties. r=devtools-reviewers,bomsy.\n\nUpdate the few test cases that were actually highlighting the issue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328424\n", "files": ["devtools/client/inspector/rules/test/browser_rules_cssom_element.js", "devtools/client/inspector/rules/test/browser_rules_stylesheet_text.js", "devtools/client/inspector/rules/views/text-property-editor.js"], "git_node": "e053847844f253a1b0f29fb706b9dd3da9bee6f8", "git_parents": ["b9ea714bf97c76ff42f932338a6df7c1c78b75ea"], "node": "62eacdfc6eece49e282dc14777b5bcbd83dc0cd7", "parents": ["e4973e1bed5236007e7afa65316f10b49c4cf14b"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074570 - [devtools] Remove guard that was preventing to show warning message for custom property declarations. r=devtools-reviewers,bomsy.\n\nWe would not show warning message if the declaration was invalid, which it can be.\nTest case is added in browser_rules_authored.js and we take this as an opportunity\nto use the checkRuleViewContent share helper.\nThis revealed a small issue in the code: the ruleview-overridden class was added\nfor unknown properties, which isn't correct (and the property is already struck through\nthanks to the ruleview-invalid class).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328413\n", "files": ["devtools/client/inspector/rules/test/browser_rules_authored.js", "devtools/client/inspector/rules/views/text-property-editor.js"], "git_node": "50fed21c310eeb0adb093e9a79671c0d1d1c27e3", "git_parents": ["e053847844f253a1b0f29fb706b9dd3da9bee6f8"], "node": "607e6cd3ee1c1df88e86ed4aba1ff9fb8973fa65", "parents": ["62eacdfc6eece49e282dc14777b5bcbd83dc0cd7"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056134 - Part 8: Add tests. r=bthrall,perftest-reviewers,sparky\" for causing build bustages at ScriptLoadHandler.cpp\n\nThis reverts commit 5bd68c70eb7d7d737e96a742284a287baf59f686.\n\nRevert \"Bug 2056134 - Part 7: Use the encoding when looking up the in-memory script cache. r=bthrall\"\n\nThis reverts commit 05b6bc411d3050e91fb441ecc9e4e917210f2fc1.\n\nRevert \"Bug 2056134 - Part 6: Validate the script preload with fallback encoding. r=bthrall\"\n\nThis reverts commit 8a7e9141d94ac86e810e411ef525720575df2615.\n\nRevert \"Bug 2056134 - Part 5: Put the encoding into the serialized stencil. r=bthrall\"\n\nThis reverts commit 5db343c3ddb0ce24762ab3dc3b3011b49b8d4b15.\n\nRevert \"Bug 2056134 - Part 4: Add ScriptLoader::GetClassicScriptFallbackEncoding. r=bthrall\"\n\nThis reverts commit 6e7badec12588837fe00dfe22e7b2c0ad4784cd5.\n\nRevert \"Bug 2056134 - Part 3: Move the alignment handling out of LoadedScript methods and clarify the input/output. r=bthrall\"\n\nThis reverts commit ca36c89d89616316b920794437a37883427e1b8a.\n\nRevert \"Bug 2056134 - Part 2: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\"\n\nThis reverts commit 6dde04ce86c3f10f7e769b52e8a02d59bc3c8e71.\n\nRevert \"Bug 2056134 - Part 1: Unify the hint charset handling between the script preload and regular script load. r=bthrall,dom-worker-reviewers,edenchuang\"\n\nThis reverts commit 1c86ec6b9d4c686537cfc56e317e9ca78a83e756.\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset_html.sjs", "dom/base/test/file_js_cache_charset_js.sjs", "dom/base/test/head.js", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/ModuleLoader.cpp", "dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "dom/workers/ScriptLoader.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ModuleLoadRequest.cpp", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "remote/shared/NetworkResponse.sys.mjs", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/script-charset-03.html.ini"], "git_node": "55be8e34f08af4d1f23f0f486d8bda9e86659d40", "git_parents": ["50fed21c310eeb0adb093e9a79671c0d1d1c27e3"], "node": "af2d344db3d94b347733a9ef272f2db1887942cb", "parents": ["607e6cd3ee1c1df88e86ed4aba1ff9fb8973fa65"], "tags": []}, {"author": "Manuel Rego Casasnovas \u003crego@igalia.com\u003e", "branch": "default", "desc": "Bug 1375290 - Don't expose the ERRORMSG relation when aria-invalid is false r=Jamie\n\nThis implements the following must statement in ARIA spec\n(https://w3c.github.io/aria/#aria-errormessage):\n\u003e User agents MUST NOT expose aria-errormessage for an object\n\u003e with an aria-invalid value of false.\n\nThe issue was discovered while working on some new aamtests\nthat fail in Firefox:\nhttps://github.com/web-platform-tests/wpt/pull/63096\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329933\n", "files": ["accessible/generic/LocalAccessible.cpp", "accessible/ipc/RemoteAccessible.cpp", "accessible/tests/browser/relations/browser_relations_general.js", "accessible/tests/browser/relations/browser_shadow_dom_and_custom_elements.js", "accessible/tests/mochitest/relations/test_general.html"], "git_node": "fda8b912b55ed6e1e169c1f134c58afb6caf8984", "git_parents": ["55be8e34f08af4d1f23f0f486d8bda9e86659d40"], "node": "15c56ff385d44aa0013e5fcd3818ecdb2c6e1623", "parents": ["af2d344db3d94b347733a9ef272f2db1887942cb"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078120 - Remove PromiseFlatCString in nsProfiler::GatheredOOPProfile. r=profiler-reviewers,mstange\n\nSpliceableJSONWriter::Splice takes a Span\u003cconst char\u003e, which nsACString\nconverts to implicitly, so there is no need to make a flat copy of the\nchild profile.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330676\n", "files": ["tools/profiler/gecko/nsProfiler.cpp"], "git_node": "993e90c245978d95e59247347b3299f735999259", "git_parents": ["fda8b912b55ed6e1e169c1f134c58afb6caf8984"], "node": "92e3e233bcc47f16dcf1a6c6150a00334f94edb8", "parents": ["15c56ff385d44aa0013e5fcd3818ecdb2c6e1623"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077730. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331020\n", "files": ["gfx/2d/DrawTargetCairo.cpp", "gfx/thebes/gfxPattern.cpp"], "git_node": "c877c0614d639376a3180784e6f7855365903cd2", "git_parents": ["993e90c245978d95e59247347b3299f735999259"], "node": "2f44df9b0e05ebe6cb08e245053bb0baf87dd663", "parents": ["92e3e233bcc47f16dcf1a6c6150a00334f94edb8"], "tags": []}, {"author": "virsworld \u003cvirpatel71@gmail.com\u003e", "branch": "default", "desc": "Bug 2070872 - Document remote types affected by pref sanitization. r=firefox-source-docs-reviewers,dao,sylvestre DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327969\n", "files": ["modules/libpref/docs/index.md"], "git_node": "0834eb37d899fcfd862047acefd9b6d06dac3770", "git_parents": ["c877c0614d639376a3180784e6f7855365903cd2"], "node": "1c2396a75ea8a3c04dbd7a07b7bb49ec016337c2", "parents": ["2f44df9b0e05ebe6cb08e245053bb0baf87dd663"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2074250 - Add --disable-profile-pkcs11-modules r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330755\n", "files": ["toolkit/moz.configure"], "git_node": "6f1e51d07790b63f60ac3fb3389fccef0c48456f", "git_parents": ["0834eb37d899fcfd862047acefd9b6d06dac3770"], "node": "72b9e17a1e8ed4c413da6bbea7ef6c26012497a0", "parents": ["1c2396a75ea8a3c04dbd7a07b7bb49ec016337c2"], "tags": []}, {"author": "Alexandre Lissy \u003clissyx@lissyx.dyndns.org\u003e", "branch": "default", "desc": "Bug 2062894 - Add --enable-enterprise to toolkit/ r=firefox-build-system-reviewers,ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330756\n", "files": ["toolkit/moz.configure"], "git_node": "0345146f08ef05780aaab7c89fe0f458c2bdfebf", "git_parents": ["6f1e51d07790b63f60ac3fb3389fccef0c48456f"], "node": "627b4f920e2a63f248fbb5e8fac13399771bd5f4", "parents": ["72b9e17a1e8ed4c413da6bbea7ef6c26012497a0"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 1: Unify the hint charset handling between the script preload and regular script load. r=bthrall,dom-worker-reviewers,edenchuang\n\nStore the hint charset attribute into the ScriptLoadRequest field, both for the\npreload and the regular load, so that the remaining part of the preload and\nthe cache handling doesn't have to distinguish between them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324186\n", "files": ["dom/script/ModuleLoader.cpp", "dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "dom/workers/ScriptLoader.cpp", "js/loader/ModuleLoadRequest.cpp", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/script-charset-03.html.ini"], "git_node": "8b59038600515d93bb35f69346ea3419a7d057a2", "git_parents": ["0345146f08ef05780aaab7c89fe0f458c2bdfebf"], "node": "18997ab0dc9d82681f8b5c73cdfad949bc3cf61e", "parents": ["627b4f920e2a63f248fbb5e8fac13399771bd5f4"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 2: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314577\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "remote/shared/NetworkResponse.sys.mjs"], "git_node": "58a336e5abf20e234d31bd5b45d459712bf83bb1", "git_parents": ["8b59038600515d93bb35f69346ea3419a7d057a2"], "node": "27c739f1df9b33782bab3d21138d2bb93b9fdc96", "parents": ["18997ab0dc9d82681f8b5c73cdfad949bc3cf61e"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 3: Move the alignment handling out of LoadedScript methods and clarify the input/output. r=bthrall\n\nThe later patch will put an extra section between the SRI+padding and the\nserialized stencil.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324187\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "js/loader/LoadedScript.h"], "git_node": "a6475722294de4edf178de1e73cd579c304805be", "git_parents": ["58a336e5abf20e234d31bd5b45d459712bf83bb1"], "node": "baae3838a809ee80ea36532b7a18cfb006e81231", "parents": ["27c739f1df9b33782bab3d21138d2bb93b9fdc96"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 4: Add ScriptLoader::GetClassicScriptFallbackEncoding. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324188\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "e2bbad773848655c550171f4e3b9e8c9e073628a", "git_parents": ["a6475722294de4edf178de1e73cd579c304805be"], "node": "38fc70b0718439a754dd5406851895c457e84260", "parents": ["baae3838a809ee80ea36532b7a18cfb006e81231"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 5: Put the encoding into the serialized stencil. r=bthrall\n\nThe encoding becomes a part of the cached value.\nWhen encoding doesn't match, the cache is treated in the same way as corrupted,\nand the load restarted, bypassing the cache.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324189\n", "files": ["dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h"], "git_node": "60ad8b85f1a9df333ce708889688938dba88a800", "git_parents": ["e2bbad773848655c550171f4e3b9e8c9e073628a"], "node": "b60766d7c87027b712b0a3193374906c5550c4a9", "parents": ["38fc70b0718439a754dd5406851895c457e84260"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 6: Validate the script preload with fallback encoding. r=bthrall\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330332\n", "files": ["dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h"], "git_node": "0469712abe39510b837904c073579131d1ea845a", "git_parents": ["60ad8b85f1a9df333ce708889688938dba88a800"], "node": "68b8a6538b971e88c6a3b8c18440868dccb208ad", "parents": ["b60766d7c87027b712b0a3193374906c5550c4a9"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 7: Use the encoding when looking up the in-memory script cache. r=bthrall\n\nCompare the hint encoding also for the in-memory cache, but only when the\nhint encoding was actually used.\n\nFor script preloads, the document's encoding may not have been settled yet,\nand in that case, the check is performed when the actual script load is\nlooking up the preload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324190\n", "files": ["dom/script/ScriptLoader.cpp"], "git_node": "c9d6a3c76496376696ca579b9659a525a1a68796", "git_parents": ["0469712abe39510b837904c073579131d1ea845a"], "node": "fc0f7544c5a44d5083ed58df12dc883554220a3d", "parents": ["68b8a6538b971e88c6a3b8c18440868dccb208ad"], "tags": []}, {"author": "Tooru Fujisawa \u003carai_a@mac.com\u003e", "branch": "default", "desc": "Bug 2056134 - Part 8: Add tests. r=bthrall,perftest-reviewers,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D314581\n", "files": ["dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset_html.sjs", "dom/base/test/file_js_cache_charset_js.sjs", "dom/base/test/head.js"], "git_node": "c6de66d72327e0d4f7593a39199c95d283b65826", "git_parents": ["c9d6a3c76496376696ca579b9659a525a1a68796"], "node": "d2ae54ff8246216a6bb01ca865b695ba362ce23c", "parents": ["fc0f7544c5a44d5083ed58df12dc883554220a3d"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077823 - Notify people who used Ctrl+Shift+A for the Add-ons Manager that the shortcut moved. r=urlbar-reviewers,fluent-reviewers,daisuke,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330702\n", "files": ["browser/components/urlbar/UrlbarProviderAddonsShortcutMoved.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/metrics.yaml", "browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-searchMode/browser.toml", "browser/components/urlbar/tests/browser-searchMode/browser_addonsShortcutMoved.js", "browser/locales/en-US/browser/browser.ftl", "browser/themes/shared/urlbar/dynamic-results.css"], "git_node": "d13dbfc63ac13d02bf3beb3e989ffe5db1323275", "git_parents": ["c6de66d72327e0d4f7593a39199c95d283b65826"], "node": "1f859a64d3f7ae139c97213d24cc9edbb165c193", "parents": ["d2ae54ff8246216a6bb01ca865b695ba362ce23c"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 [Wayland] Log available formats for SHM direct composition r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330704\n", "files": ["widget/gtk/nsWaylandDisplay.cpp", "widget/gtk/nsWaylandDisplay.h"], "git_node": "135fbce54709f3da743d1f7861ac2ec6daf5a7f5", "git_parents": ["d13dbfc63ac13d02bf3beb3e989ffe5db1323275"], "node": "c6447ed3c0750f139eb7d9be60be50aa43a5cbb7", "parents": ["1f859a64d3f7ae139c97213d24cc9edbb165c193"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 [Wayland] Move more abstraction from DMABufSurface to BufferSurface r=emilio,gtk-reviewers\n\nAllows to replace direct DMABufSurface with BufferSurface abstraction with potential use of SHMBufSurface backend.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330705\n", "files": ["widget/gtk/BufferSurface.cpp", "widget/gtk/BufferSurface.h", "widget/gtk/DMABufSurface.cpp", "widget/gtk/DMABufSurface.h"], "git_node": "7ca9bd4bfe4f68dad341a9255c07a2db0d900296", "git_parents": ["135fbce54709f3da743d1f7861ac2ec6daf5a7f5"], "node": "41650877c8968d7aa4b43ac0ab7cab2b60c52d0b", "parents": ["c6447ed3c0750f139eb7d9be60be50aa43a5cbb7"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 Unify DMABuf logging r=emilio,gtk-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330706\n", "files": ["widget/gtk/DMABufDevice.cpp", "widget/gtk/DMABufFormats.cpp"], "git_node": "8aceecb9f4c1182bbe5829568fcb58b0713258c7", "git_parents": ["7ca9bd4bfe4f68dad341a9255c07a2db0d900296"], "node": "77ff638bf0e5980ed775ed02098e82ab4570dd0d", "parents": ["41650877c8968d7aa4b43ac0ab7cab2b60c52d0b"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 [Wayland] Implement RGBA/YUV SHMBuf surfaces and texture interfaces r=emilio,gtk-reviewers\n\nImplement RGBA/YUV SHMBufSurfaces as a SHM backend to BufferSurfaces. It's used for direct upload of (HDR) video frames to Wayland compositor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330707\n", "files": ["widget/gtk/SHMBufSurface.cpp", "widget/gtk/SHMBufSurface.h", "widget/gtk/WUniquePtr.h"], "git_node": "509e6ae49ee34ebd656e3fb7e0f933ef3b5e45bc", "git_parents": ["8aceecb9f4c1182bbe5829568fcb58b0713258c7"], "node": "d59441d6f1502f27c209f0c348adf59b1a519f5b", "parents": ["77ff638bf0e5980ed775ed02098e82ab4570dd0d"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 [Wayland] Update widget code to work with BufferSurface abstraction, remove WaylandBufferSHM/WaylandBufferDMABUF classes r=emilio,gtk-reviewers\n\nWith SHMBufSurface abstraction moved to BufferSurface we can remove WaylandBufferSHM/WaylandBufferDMABUF and use only BufferSurface for both backends.\nThis patch updates the widget code for it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330708\n", "files": ["widget/gtk/WaylandBuffer.cpp", "widget/gtk/WaylandBuffer.h", "widget/gtk/WindowSurfaceWaylandMultiBuffer.cpp", "widget/gtk/WindowSurfaceWaylandMultiBuffer.h", "widget/gtk/moz.build"], "git_node": "1d85ee4d836cc38e7b9fa552b9c878fecb3a051d", "git_parents": ["509e6ae49ee34ebd656e3fb7e0f933ef3b5e45bc"], "node": "4219624e7b89d9c240c17d16962e70bbfbd3ba63", "parents": ["d59441d6f1502f27c209f0c348adf59b1a519f5b"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 [Linux] Update GLBlitHelper to blit to DMABufSurface from textures instead of plain data r=lsalzman\n\nWidget code uses BufferSurface abstraction for both SHM and DMABuf surfaces with cached textures\nso use it instead of direct data upload.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330709\n", "files": ["gfx/gl/GLBlitHelper.cpp", "gfx/gl/GLBlitHelper.h"], "git_node": "38c4ed3d4a354dbb2c5aa6441964fc0e94661e35", "git_parents": ["1d85ee4d836cc38e7b9fa552b9c878fecb3a051d"], "node": "2cbc6fb0ddb410fde061d87195936ff992929ca5", "parents": ["4219624e7b89d9c240c17d16962e70bbfbd3ba63"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 [Linux] Update GL code to for new BufferSurface interface r=lsalzman\n\nReplace DMABUfSurface::CreateTexture() with CreateTextures which creates/uploads all textures at once.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330710\n", "files": ["gfx/gl/SharedSurfaceDMABUF.cpp", "gfx/webrender_bindings/RenderDMABUFTextureHost.cpp"], "git_node": "35d3148e5036d225bac8b7460499de490a6d459f", "git_parents": ["38c4ed3d4a354dbb2c5aa6441964fc0e94661e35"], "node": "331091ccedcfa6d55586f21c7d86e4cea2292b03", "parents": ["2cbc6fb0ddb410fde061d87195936ff992929ca5"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 [Linux] Update Wayland compositor code to work with BufferSurface abstraction r=gw\n\n- Replace WaylandBufferSHM/WaylandBufferDMABUF with WaylandBuffer abstraction for both DMABuf and SHM buffers\n- Replace RenderDMABUFTextureHost with RenderTextureHost - prepare for adding SHM based host\n- Allow to use externally composited SHM surfaces (from video decoder for instance)\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330711\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h", "gfx/layers/SurfacePoolWayland.cpp"], "git_node": "cc380def41670f898e13c74d3fa0d1f70cc66026", "git_parents": ["35d3148e5036d225bac8b7460499de490a6d459f"], "node": "6213d26de72e5c34b4799a6ded6c2e7ce9055bbc", "parents": ["331091ccedcfa6d55586f21c7d86e4cea2292b03"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2078134: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["gfx/layers/NativeLayerWayland.cpp", "gfx/layers/NativeLayerWayland.h", "widget/gtk/SHMBufSurface.cpp", "widget/gtk/WUniquePtr.h"], "git_node": "db63a918893210069c2b38f364bb64fa73638a88", "git_parents": ["cc380def41670f898e13c74d3fa0d1f70cc66026"], "node": "084d37b3c6dc4adfb6351d4c91820882f7b44e7b", "parents": ["6213d26de72e5c34b4799a6ded6c2e7ce9055bbc"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075930 - Remove style's is attribute. r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330703\n", "files": ["dom/base/nsTreeSanitizer.cpp", "parser/xml/test/unit/results.js"], "git_node": "2f954d793c28160068833da7273f4e970b038228", "git_parents": ["db63a918893210069c2b38f364bb64fa73638a88"], "node": "70e1cf93e49b1598d96ff987fca90e5eef0fd8a3", "parents": ["084d37b3c6dc4adfb6351d4c91820882f7b44e7b"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078145. r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331027\n", "files": ["gfx/layers/RemoteTextureMap.cpp", "gfx/layers/RemoteTextureMap.h"], "git_node": "f82c4df994e3eaced07d09a3b06c9dc190fcaa6b", "git_parents": ["2f954d793c28160068833da7273f4e970b038228"], "node": "e579277e9f0f7d2c3e73392fe0a6a6b77b7e1ea2", "parents": ["70e1cf93e49b1598d96ff987fca90e5eef0fd8a3"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2068559 - Stop presenting OffscreenCanvas frames while the window is not active r=emilio,gfx-reviewers,lsalzman\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326945\n", "files": ["dom/base/Document.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.cpp", "dom/canvas/OffscreenCanvasDisplayHelper.h", "dom/html/HTMLCanvasElement.cpp", "dom/html/HTMLCanvasElement.h"], "git_node": "60fb197bead156dc4aeeaa84211dfaeaab093421", "git_parents": ["f82c4df994e3eaced07d09a3b06c9dc190fcaa6b"], "node": "76a3e3670689b6bf47c8cc08ccdacc23a4652cd1", "parents": ["e579277e9f0f7d2c3e73392fe0a6a6b77b7e1ea2"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2056134 - Part 8: Add tests. r=bthrall,perftest-reviewers,sparky\" for causing build bustages at ScriptLoadHandler.cpp\n\nThis reverts commit c6de66d72327e0d4f7593a39199c95d283b65826.\n\nRevert \"Bug 2056134 - Part 7: Use the encoding when looking up the in-memory script cache. r=bthrall\"\n\nThis reverts commit c9d6a3c76496376696ca579b9659a525a1a68796.\n\nRevert \"Bug 2056134 - Part 6: Validate the script preload with fallback encoding. r=bthrall\"\n\nThis reverts commit 0469712abe39510b837904c073579131d1ea845a.\n\nRevert \"Bug 2056134 - Part 5: Put the encoding into the serialized stencil. r=bthrall\"\n\nThis reverts commit 60ad8b85f1a9df333ce708889688938dba88a800.\n\nRevert \"Bug 2056134 - Part 4: Add ScriptLoader::GetClassicScriptFallbackEncoding. r=bthrall\"\n\nThis reverts commit e2bbad773848655c550171f4e3b9e8c9e073628a.\n\nRevert \"Bug 2056134 - Part 3: Move the alignment handling out of LoadedScript methods and clarify the input/output. r=bthrall\"\n\nThis reverts commit a6475722294de4edf178de1e73cd579c304805be.\n\nRevert \"Bug 2056134 - Part 2: Include the hint charset into the cache key string for the ChromeUtils.getCachedJavaScriptSource. r=bthrall,devtools-reviewers,jdescottes\"\n\nThis reverts commit 58a336e5abf20e234d31bd5b45d459712bf83bb1.\n\nRevert \"Bug 2056134 - Part 1: Unify the hint charset handling between the script preload and regular script load. r=bthrall,dom-worker-reviewers,edenchuang\"\n\nThis reverts commit 8b59038600515d93bb35f69346ea3419a7d057a2.\n", "files": ["devtools/server/actors/network-monitor/network-event-actor.js", "devtools/server/actors/resources/network-events-content.js", "dom/base/ChromeUtils.cpp", "dom/base/ChromeUtils.h", "dom/base/test/browser.toml", "dom/base/test/browser_script_loader_js_cache_charset.js", "dom/base/test/file_js_cache_charset_html.sjs", "dom/base/test/file_js_cache_charset_js.sjs", "dom/base/test/head.js", "dom/chrome-webidl/ChromeUtils.webidl", "dom/script/ModuleLoader.cpp", "dom/script/ScriptLoadHandler.cpp", "dom/script/ScriptLoader.cpp", "dom/script/ScriptLoader.h", "dom/script/SharedScriptCache.cpp", "dom/script/SharedScriptCache.h", "dom/workers/ScriptLoader.cpp", "js/loader/LoadedScript.cpp", "js/loader/LoadedScript.h", "js/loader/ModuleLoadRequest.cpp", "js/loader/ScriptLoadRequest.cpp", "js/loader/ScriptLoadRequest.h", "remote/shared/NetworkResponse.sys.mjs", "testing/web-platform/meta/html/semantics/scripting-1/the-script-element/script-charset-03.html.ini"], "git_node": "5781969f241cef130b4ecb062dfbb26f80071b2d", "git_parents": ["60fb197bead156dc4aeeaa84211dfaeaab093421"], "node": "75669a89071b2878ad0540c75ba21f22c2e941de", "parents": ["76a3e3670689b6bf47c8cc08ccdacc23a4652cd1"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2078134 [Linux] Remove unused \u003cstdlib.h\u003e r=emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331056\n", "files": ["widget/gtk/DMABufSurface.cpp"], "git_node": "58a794db0ed7bd6018fc2eb8982019febe9645cc", "git_parents": ["5781969f241cef130b4ecb062dfbb26f80071b2d"], "node": "3fed955ea085af333acecbeef9c471658f5f2424", "parents": ["75669a89071b2878ad0540c75ba21f22c2e941de"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2078505 - Disable promotion of non-default rounded corner clip r=gfx-reviewers,lsalzman\n\noverlay of non-default rectangle corner clip is not supported by WebRender layer compositor.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330999\n", "files": ["gfx/wr/webrender/src/tile_cache/mod.rs"], "git_node": "92f0e97e2c40362a5baf282c589aaf3b7da1c9b3", "git_parents": ["58a794db0ed7bd6018fc2eb8982019febe9645cc"], "node": "af204ca12121966349ea806ca5fa53f4c551ca59", "parents": ["3fed955ea085af333acecbeef9c471658f5f2424"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074403 - Create new verifyPrivateBrowsingHomeScreenItemsAccessedFromTabsTrayTest regression UI test r=aaronmt\n\nThe UI test successfully passed 50x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=100044\nAll efficiency UI tests successfully passed 1x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=95419\n\nMatching the manual test in https://mozilla-hub.atlassian.net/browse/MTE-5850\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328108\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HomeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/PrivateBrowsingTest.kt"], "git_node": "4251b09be0cba2dd36b27100dec98de924cd267d", "git_parents": ["92f0e97e2c40362a5baf282c589aaf3b7da1c9b3"], "node": "29668c04cac48fb3394e6dfe74e07be35a1cb8f3", "parents": ["af204ca12121966349ea806ca5fa53f4c551ca59"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078145. r=gfx-reviewers,nical\" for causing build bustages @ RefCounted.h / ThreadSafeWeakPtr.h\n\nThis reverts commit f82c4df994e3eaced07d09a3b06c9dc190fcaa6b.\n", "files": ["gfx/layers/RemoteTextureMap.cpp", "gfx/layers/RemoteTextureMap.h"], "git_node": "6084e0f5ab321c59acea9b2b12473812807e7af9", "git_parents": ["4251b09be0cba2dd36b27100dec98de924cd267d"], "node": "f871e6844d469b19aaa8602d2c16e8ce6cd0669d", "parents": ["29668c04cac48fb3394e6dfe74e07be35a1cb8f3"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076748 - Don't create Windows installers in automation builds. r=firefox-build-system-reviewers,taskgraph-reviewers,ahochheiden,ahal\n\nCreating the installer at the end of the package tier takes ~80s in\nwin64 builds, most of it compressing the package with 7-Zip, but the\ninstallers that get tested and shipped are created by repackage tasks,\nfrom setup.exe and the package produced by the build. The only thing\nusing the one from the build was the upload of autoland builds to the\nintegration bucket.\n\nSo skip creating it in automation, while still building setup.exe, and\nstop uploading it from autoland builds. Local builds still create it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329947\n", "files": ["taskcluster/gecko_taskgraph/manifests/firefox_integration.yml", "toolkit/mozapps/installer/windows/nsis/makensis.mk"], "git_node": "36ad25a9524e000a6c5efb250e53b8712520f723", "git_parents": ["6084e0f5ab321c59acea9b2b12473812807e7af9"], "node": "15f66adee96ee831a06a8817cc4fec067878b231", "parents": ["f871e6844d469b19aaa8602d2c16e8ce6cd0669d"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078523 - Fix path cache iteration types. r=gfx-reviewers,nical\n\nLinkList\u003cRefPtr\u003cT\u003e\u003e iterators actually return a T* as the value type, so\nattempting to use a const RefPtr\u003cT\u003e& in the iterator constructs a RefPtr\non each value. Fix the loop to use the direct T* instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331057\n", "files": ["dom/canvas/DrawTargetWebgl.cpp"], "git_node": "0a1d1cf2cda2ec976335c21af0214c9463668a72", "git_parents": ["36ad25a9524e000a6c5efb250e53b8712520f723"], "node": "836bc8a2de08fe5010013a1e143eaef6c856f2b4", "parents": ["15f66adee96ee831a06a8817cc4fec067878b231"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2076705, ensure the right node document, r=dom-core-reviewers,masayuki\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330760\n", "files": ["dom/xml/nsXMLContentSink.cpp"], "git_node": "e07cffdbb7f5f66567de203d1defef74c2979313", "git_parents": ["0a1d1cf2cda2ec976335c21af0214c9463668a72"], "node": "6c2815aab741f8de5f1dd0c9a708b9e08f53ea32", "parents": ["836bc8a2de08fe5010013a1e143eaef6c856f2b4"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2077385, ensure right cell index is returned, r=dom-core-reviewers,edgar\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330564\n", "files": ["dom/html/HTMLTableCellElement.cpp"], "git_node": "f4ffe6b44b7323190a35e8da477588d412c4db31", "git_parents": ["e07cffdbb7f5f66567de203d1defef74c2979313"], "node": "bee7146f0bc7e78bec17f5ecfbfc4b67560391b4", "parents": ["6c2815aab741f8de5f1dd0c9a708b9e08f53ea32"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078372 - Update PDF.js to 17bb2442fe53f348ee8e2e0b3e7c1c7d09468cd7 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330857\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "67f91c48c843b56090c325f03f3534a4c889efdf", "git_parents": ["f4ffe6b44b7323190a35e8da477588d412c4db31"], "node": "3f1959c115859cb6bb500bb21c002110c158bab8", "parents": ["bee7146f0bc7e78bec17f5ecfbfc4b67560391b4"], "tags": []}, {"author": "Tim Huang \u003ctihuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074019 - Classify first-party requests in the ContentClassifier annotate pass to support anti-tracking heuristics. r=emz\n\nThe anti-tracking heuristics rely on the first-party classification\nflags. This patch implements classifying first-party reqeusts for the\nContent Classifier.\n\nClassifyWithEngines now takes the existing ClassifyMode instead of the\naIndependentEngines bool, and the per-feature request filter receives that\nmode. The ETP features use IsThirdPartyUnlessAnnotating, so they still\nblock third-party requests only but annotate first-party ones as well, as\nurl-classifier's annotation features do; the harmful-addon feature keeps\nfiltering on the requesting add-on regardless of party.\n\nIn annotate mode CheckNetworkRequest presents a top-level document to the\nengine as an untyped request, since untyped rules never match the document\ntype on their own. The apply side already picked first-party flags from the\nload info and emits no content blocking event for them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327814\n", "files": ["toolkit/components/antitracking/docs/content-classifier/index.md", "toolkit/components/content-classifier/ContentClassifierFeatureUtils.cpp", "toolkit/components/content-classifier/ContentClassifierFeatureUtils.h", "toolkit/components/content-classifier/ContentClassifierService.cpp", "toolkit/components/content-classifier/ContentClassifierService.h", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.cpp", "toolkit/components/content-classifier/content_classifier_engine/ContentClassifierEngine.h", "toolkit/components/content-classifier/test/browser/browser.toml", "toolkit/components/content-classifier/test/browser/browser_content_classifier_first_party.js"], "git_node": "600343fe6582aee37a6a9d2580dc1de5a54abbae", "git_parents": ["67f91c48c843b56090c325f03f3534a4c889efdf"], "node": "1ff5e17f7574b7eb89ad7e5c682619eee03c222c", "parents": ["3f1959c115859cb6bb500bb21c002110c158bab8"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078126 - Add Search Tabs to the History menu so it's listed in about:keyboard. r=mak,fluent-reviewers,places-reviewers,flod,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330678\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "browser/base/content/browser-places.js", "browser/base/content/browser-sets.js", "browser/base/content/test/browser-menubar/browser.toml", "browser/base/content/test/browser-menubar/browser_search_tabs.js", "browser/components/urlbar/tests/browser-searchMode/browser_addonsShortcutMoved.js", "browser/locales/en-US/browser/menubar.ftl"], "git_node": "7155832d0f101d0b5766e8fdc3a47dc5011a4fc1", "git_parents": ["600343fe6582aee37a6a9d2580dc1de5a54abbae"], "node": "c7b44cbef0e0343fda60bc0c12c89e567ccf4033", "parents": ["1ff5e17f7574b7eb89ad7e5c682619eee03c222c"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076714. r=gfx-reviewers,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331062\n", "files": ["gfx/webrender_bindings/RenderTextureHostSWGL.cpp"], "git_node": "f52ffc3cc6e8f58842762b9fd3fd87c2588d7c7b", "git_parents": ["7155832d0f101d0b5766e8fdc3a47dc5011a4fc1"], "node": "a3563fb05465edf7e2ce191bf9f388a5c65e1364", "parents": ["c7b44cbef0e0343fda60bc0c12c89e567ccf4033"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078126 - Add Search Tabs to the History menu so it's listed in about:keyboard. r=mak,fluent-reviewers,places-reviewers,flod,urlbar-reviewers\" for causing conflicts while backing out Bug 2077823\n\nThis reverts commit 7155832d0f101d0b5766e8fdc3a47dc5011a4fc1.\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "browser/base/content/browser-places.js", "browser/base/content/browser-sets.js", "browser/base/content/test/browser-menubar/browser.toml", "browser/base/content/test/browser-menubar/browser_search_tabs.js", "browser/components/urlbar/tests/browser-searchMode/browser_addonsShortcutMoved.js", "browser/locales/en-US/browser/menubar.ftl"], "git_node": "af5803fe00f2ce5e5d57f96dc0366060bb1d6af0", "git_parents": ["f52ffc3cc6e8f58842762b9fd3fd87c2588d7c7b"], "node": "ea15649d469024b5005cf68521983c85eb271ac6", "parents": ["a3563fb05465edf7e2ce191bf9f388a5c65e1364"], "tags": []}, {"author": "Alexandru Marc \u003camarc@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077823 - Notify people who used Ctrl+Shift+A for the Add-ons Manager that the shortcut moved. r=urlbar-reviewers,fluent-reviewers,daisuke,bolsson\" for causing bc failures @ browser_addonsShortcutMoved\n\nThis reverts commit d13dbfc63ac13d02bf3beb3e989ffe5db1323275.\n", "files": ["browser/components/urlbar/UrlbarProviderAddonsShortcutMoved.sys.mjs", "browser/components/urlbar/UrlbarProvidersManager.sys.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/metrics.yaml", "browser/components/urlbar/moz.build", "browser/components/urlbar/tests/browser-searchMode/browser.toml", "browser/components/urlbar/tests/browser-searchMode/browser_addonsShortcutMoved.js", "browser/locales/en-US/browser/browser.ftl", "browser/themes/shared/urlbar/dynamic-results.css"], "git_node": "f1cc7a5c2c2e047644ccb4d738ab329d39c12671", "git_parents": ["af5803fe00f2ce5e5d57f96dc0366060bb1d6af0"], "node": "1e0e2260d14937146c9868ac9f62ebf9405f24cc", "parents": ["ea15649d469024b5005cf68521983c85eb271ac6"], "tags": []}, {"author": "Dale Harvey \u003cdale@arandomurl.com\u003e", "branch": "default", "desc": "Bug 2076786 - Use moz-src for docshell/base r=Gijs\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329970\n", "files": ["docshell/base/moz.build", "docshell/build/components.conf", "tools/@types/generated/lib.gecko.modules.d.ts", "tools/@types/generated/tspaths.json"], "git_node": "0a9d860303dfa630a3fddadcd9bd58a3bc3b72ba", "git_parents": ["f1cc7a5c2c2e047644ccb4d738ab329d39c12671"], "node": "99ce270eadfd12dff48368f8f64380276561b086", "parents": ["1e0e2260d14937146c9868ac9f62ebf9405f24cc"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074157 - Create a typed mapping of fxa services to their required scopes r=android-reviewers,cbect\n\nAs part of supporting the `services` fxa web channel message, we need a mapping of service -\u003e scopes, so that we can correctly build the payload.\nThis patch introduces a typed structure for services, and their known required scopes\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327903\n", "files": ["mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FxaScope.kt", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/FxaService.kt"], "git_node": "e9159f28bcb8b3556e014076b166f958c904f35e", "git_parents": ["0a9d860303dfa630a3fddadcd9bd58a3bc3b72ba"], "node": "bdda6b036370749cab6f45c658cf7c53c3a9265d", "parents": ["99ce270eadfd12dff48368f8f64380276561b086"], "tags": []}, {"author": "Segun Famisa \u003csfamisa@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074157 - Support the ability to add `services` payload in fxa web channel message r=android-reviewers,lmccracken,cbect\n\nThis patch adds the ability by:\n1. Converting the FxaCapabilities from an enum to a sealed interface, so that we can add a list of supported services at the time we are creating the web channel feature\n2. Conditionally applying the services and scopes payload when the \"service\" capability is present.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327904\n", "files": ["mobile/android/android-components/components/feature/accounts/src/main/java/mozilla/components/feature/accounts/FxaWebChannelFeature.kt", "mobile/android/android-components/components/feature/accounts/src/test/java/mozilla/components/feature/accounts/FxaWebChannelFeatureTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/accounts/FxaWebChannelIntegration.kt"], "git_node": "6c765c623971ec740ac236fc94842715bf0ead5d", "git_parents": ["e9159f28bcb8b3556e014076b166f958c904f35e"], "node": "1b56f2e2751c32b8aa9129c8a15ec62593f64479", "parents": ["bdda6b036370749cab6f45c658cf7c53c3a9265d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Fail browser-chrome tests that leave the mouse button pressed, r=dom-core-reviewers,firefox-desktop-core-reviewers ,smaug.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329186\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/interfaces/base/nsIDOMWindowUtils.idl", "testing/mochitest/browser-test.js", "testing/mochitest/tests/browser/browser.toml", "testing/mochitest/tests/browser/browser_fail_mouse_left_down.js", "testing/mochitest/tests/browser/browser_fail_mouse_left_down_next.js"], "git_node": "ffa1cb3a84c53bfc5cd40c76ccf122d0804907bc", "git_parents": ["6c765c623971ec740ac236fc94842715bf0ead5d"], "node": "e71c87ac907c3e08f6a9ca9c3370143648f893ab", "parents": ["1b56f2e2751c32b8aa9129c8a15ec62593f64479"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076901 - Use UniqueString for preference marker fields. r=canova,profiler-reviewers\n\nPref names and values repeat across many markers and take up a lot of space in\nprofiles; storing them in the string table deduplicates them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330677\n", "files": ["modules/libpref/Preferences.cpp", "tools/profiler/tests/browser/browser_test_markers_preferencereads.js"], "git_node": "53647032ecdd2b74a4546b5d929d397ba124a3ed", "git_parents": ["ffa1cb3a84c53bfc5cd40c76ccf122d0804907bc"], "node": "9459ec5ddb33e67d3b12c9ca2884ddeb23f73c7d", "parents": ["e71c87ac907c3e08f6a9ca9c3370143648f893ab"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077400 - Check for arsenic rather than yaml to decide whether to install condprof requirements.\n\npyyaml is now shipped in the python toolchains, so on Windows, where condprof\nruns with the toolchain python directly rather than in a venv, the yaml check\npassed and arsenic never got installed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330310\n", "files": ["testing/condprofile/condprof/check_install.py"], "git_node": "ac0178f677f4cd55b3ea7bda14d4c61a758725f5", "git_parents": ["53647032ecdd2b74a4546b5d929d397ba124a3ed"], "node": "92bdc5219e4e2a44b302420c8fa076ca2c028d9f", "parents": ["9459ec5ddb33e67d3b12c9ca2884ddeb23f73c7d"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2078518 - Fix RenderAndroidImageReaderImageTextureHost::GetFormat() r=gfx-reviewers,lsalzman\n\nRenderAndroidImageReaderImageTextureHost::GetFormat() needs to be similar to RenderAndroidSurfaceTextureHost::GetFormat().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331029\n", "files": ["gfx/we