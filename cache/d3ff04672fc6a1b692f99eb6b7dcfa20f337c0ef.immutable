-platform/tests/tools/wpt/browser.py", "testing/web-platform/tests/tools/wpt/httputils.py", "testing/web-platform/tests/tools/wpt/utils.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/environment.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/metadata.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/testloader.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/conftest.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_testloader.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_update.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_wptrunner.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_wpttest.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/update/__init__.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/wptlogging.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/wptrunner.py"], "git_node": "5fc6e69545289677b86f9773d9306c9b62fd3949", "git_parents": ["d01f3ae785fa1c40907f06321f0aedef3d176151"], "node": "3172abba79f44dabf3147e76caa467f7645393fb", "parents": ["3415f268de26eadcfdfa3e13ed97d7f614db3bde"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": ["testing/web-platform/meta/html/embedded-content/the-img-element/attr-img-fetchpriority.html.ini", "testing/web-platform/meta/webcodecs/audio-decoder.https.any.js.ini", "testing/web-platform/tests/html/embedded-content/the-img-element/WEB_FEATURES.yml", "testing/web-platform/tests/html/embedded-content/the-img-element/attr-img-fetchpriority.html"], "git_node": "5f5e93b2f4493d6e0ef6092d16e47648cc18fe05", "git_parents": ["5fc6e69545289677b86f9773d9306c9b62fd3949", "a698c4af15b1569ff389cfb38ff6bf61a1e03616"], "node": "1547c23741ed42599c1bb9d48fcb51085a5705b6", "parents": ["3172abba79f44dabf3147e76caa467f7645393fb", "16e83f7ca65e7845e872634665894af4c843073e"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update remote-settings mobile-merino-manifest ct-logs - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329799\n", "files": ["mobile/android/android-components/components/service/merino-manifest/src/main/assets/manifest/manifest.json", "security/ct/CTKnownLogs.h", "security/manager/tools/log_list.json", "services/settings/dumps/blocklists/addons-bloomfilters.json", "services/settings/dumps/main/search-config-icons.json", "services/settings/dumps/main/search-config-overrides-v2.json", "services/settings/dumps/main/search-config-v2.json"], "git_node": "9430edadab8f0c44bd39176a08c9f6fb82ef35c0", "git_parents": ["5f5e93b2f4493d6e0ef6092d16e47648cc18fe05"], "node": "fed7f523a1b9ff78936aadb976efca7cb8c68c7f", "parents": ["1547c23741ed42599c1bb9d48fcb51085a5705b6"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 1: Make GeckoChildProcessHost refcounted, r=ipc-reviewers,necko-reviewers,media-playback-reviewers,mccr8,gfx-reviewers,kershaw,padenot,aosmond\n\nThe lifecycle of this type right now is very annoying and complex, and\nvarious child process implementations have had to do different things in\norder to deal with the unfortunate lifecycle properties.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318516\n", "files": ["dom/base/ChromeUtils.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPProcessParent.cpp", "dom/media/gmp/GMPProcessParent.h", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h", "gfx/ipc/GPUChild.cpp", "gfx/ipc/GPUChild.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/vr/ipc/VRChild.cpp", "gfx/vr/ipc/VRChild.h", "gfx/vr/ipc/VRProcessManager.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/glue/ForkServiceChild.cpp", "ipc/glue/ForkServiceChild.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/glue/UtilityProcessManager.h", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTestParent.h", "netwerk/base/nsIOService.h", "netwerk/ipc/SocketProcessHost.cpp", "netwerk/ipc/SocketProcessHost.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "xpcom/base/MemoryTelemetry.cpp"], "git_node": "5dbae29f1368a524276385ed172100b5192aaa60", "git_parents": ["9430edadab8f0c44bd39176a08c9f6fb82ef35c0"], "node": "e9169a22ec38d5c1f55f0b17187880618b1644c3", "parents": ["fed7f523a1b9ff78936aadb976efca7cb8c68c7f"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 2: Keep XRE_GetAsyncIOMessageLoop working later during shutdown, r=ipc-reviewers,mccr8\n\nThis keeps the object valid throughout IPC I/O thread shutdown tasks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322480\n", "files": ["ipc/glue/IOThread.cpp", "ipc/glue/IOThread.h"], "git_node": "3f3af1fae3bc692bf327299b79cd4e0c0c1b3364", "git_parents": ["5dbae29f1368a524276385ed172100b5192aaa60"], "node": "38e68bcba0fdf782be8e012bb0ff7230c076d371", "parents": ["e9169a22ec38d5c1f55f0b17187880618b1644c3"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 1564615 - Part 3: Keep IsOnCurrentThread working further into shutdown for MessageLoop::EventTarget, r=mccr8\n\nBefore this change, we would stop considering `IsOnCurrentThread` during\n`WillDestroyCurrentMessageLoop` callbacks, which could cause it to\nspuriously begin returning false while code is still running on the\nthread.\n\nI also refactored the code somewhat to make the timing of `BeginDestroy`\nmore consistently & explicitly before all other destruction observers\nhave been run.\n\nIn the future, I expect we'll want to make the IPC I/O thread behave\nmore like XPCOM threads, and have a clear atomic moment when runnables\nare no longer processed, and the queue is empty, but that was left as a\nfuture project.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328924\n", "files": ["ipc/chromium/src/base/message_loop.cc"], "git_node": "3f2a73ea8486cb691b0610bcad3396dce15d3bcb", "git_parents": ["3f3af1fae3bc692bf327299b79cd4e0c0c1b3364"], "node": "7d3750ea4c76b773a8e7bb1abd30dc51360c8c62", "parents": ["38e68bcba0fdf782be8e012bb0ff7230c076d371"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075686 - Ensure RemoteCDMProxy closes sessions appropriately. r=media-playback-reviewers,alwu\n\nIt should handle the default scenario correctly, and notify the\ndom::MediaKeys object that the session is now gone like the other\nCDMs. It should also handle its actor being abnormally terminated\nand close all of the remaining sessions with an error.\n\nThis should resolve timeouts in the WPT EME tests with the\nMediaCodec NDK.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329274\n", "files": ["dom/media/ipc/RemoteCDMChild.cpp", "dom/media/ipc/RemoteCDMProxy.cpp"], "git_node": "476a668978c266e21a1302839b155cc2ebe32460", "git_parents": ["3f2a73ea8486cb691b0610bcad3396dce15d3bcb"], "node": "09ed3cb31713b88c241087b6df69f9cae4359364", "parents": ["7d3750ea4c76b773a8e7bb1abd30dc51360c8c62"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2061857 - Part 1: Add customization options to SyncedContext, r=farre\n\nThis is a new declarative way to describe when fields are allowed to be\nset, which should simplify future changes to CanSet and encourage people\nto specify restrictions on newly added synced fields.\n\nThis is just an initial set of customization fields, which can be\nexpanded upon in the future.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317549\n", "files": ["docshell/base/BrowsingContext.h", "docshell/base/SyncedContext.h", "docshell/base/SyncedContextInlines.h", "docshell/base/WindowContext.h"], "git_node": "ed9c397033398defe0a08d956026fe47413cdd64", "git_parents": ["476a668978c266e21a1302839b155cc2ebe32460"], "node": "d16950109725cc9c8913a899b6c76658bff2a17a", "parents": ["09ed3cb31713b88c241087b6df69f9cae4359364"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2061857 - Part 2: Migrate existing synced fields to use customization options, r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317550\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/WindowContext.cpp", "docshell/base/WindowContext.h"], "git_node": "b7f5e2788e8df8b1f4ce3ccccb27a91c680a529e", "git_parents": ["ed9c397033398defe0a08d956026fe47413cdd64"], "node": "62bc0aa44fca684a337a6fb48ddbf3df426b0f51", "parents": ["d16950109725cc9c8913a899b6c76658bff2a17a"], "tags": []}, {"author": "Nika Layzell \u003cnika@thelayzells.com\u003e", "branch": "default", "desc": "Bug 2061857 - Part 3: Allow configuring synced field defaults, r=farre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317551\n", "files": ["docshell/base/BrowsingContext.cpp", "docshell/base/BrowsingContext.h", "docshell/base/SyncedContext.h", "docshell/base/WindowContext.h"], "git_node": "3c9bb3a975094c75bdc8ffba592a27a2856dd8e6", "git_parents": ["b7f5e2788e8df8b1f4ce3ccccb27a91c680a529e"], "node": "ff9b05b62febc2985efbcba8bb68c46f6d7f269e", "parents": ["62bc0aa44fca684a337a6fb48ddbf3df426b0f51"], "tags": []}, {"author": "Maxx Crawford \u003cmcrawford@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063320 - Set widgets.enabled in the per-widget Jest fixtures r=mconley\n\nStocks.test.jsx, Privacy.test.jsx and PictureOfTheDay.test.jsx each build a \"this widget is on\" pref state but omit widgets.enabled, the container toggle, unlike the Weather, Clocks and Crossword fixtures.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318188\n", "files": ["browser/extensions/newtab/test/jest/content-src/components/Widgets/PictureOfTheDay.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Privacy.test.jsx", "browser/extensions/newtab/test/jest/content-src/components/Widgets/Stocks.test.jsx"], "git_node": "d9461e6b68e12b23e41900a5923b278484e35710", "git_parents": ["3c9bb3a975094c75bdc8ffba592a27a2856dd8e6"], "node": "50a776f47bbaab12aae04f9230e3a05586ca0df2", "parents": ["ff9b05b62febc2985efbcba8bb68c46f6d7f269e"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076516 Part 1 - Apply clang-format to Point.h and Rect.h. r=layout-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329788\n", "files": ["gfx/2d/Point.h", "gfx/2d/Rect.h"], "git_node": "6e925207fe0c1d9e983a8cd24fec2deaf928aa3a", "git_parents": ["d9461e6b68e12b23e41900a5923b278484e35710"], "node": "03a8c1e0dd92c129f312b7d4af7a20da88912445", "parents": ["50a776f47bbaab12aae04f9230e3a05586ca0df2"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076516 Part 2 - Add fmt::formatter support for gfx and layout types. r=layout-reviewers,emilio,dshin\n\nThese types already define `operator\u003c\u003c()`. Add `fmt::formatter` specializations\nfor them so they can be printed without `ToString()`.\n\n```\nnsRect r;\nfmt::println(\"r = {}\", ToString(r)); // old\nfmt::println(\"r = {}\", r);           // new\n```\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329789\n", "files": ["gfx/2d/Point.h", "gfx/2d/Rect.h", "gfx/src/nsMargin.h", "gfx/src/nsPoint.h", "gfx/src/nsRect.h", "gfx/src/nsRegion.h", "gfx/src/nsSize.h", "layout/generic/WritingModes.h", "layout/generic/nsIFrame.h"], "git_node": "6c961b579f145af1f4a7f0507a29e183d0e2f00c", "git_parents": ["6e925207fe0c1d9e983a8cd24fec2deaf928aa3a"], "node": "19937f2910c1e63c72b1641a62ccd78245c765d2", "parents": ["03a8c1e0dd92c129f312b7d4af7a20da88912445"], "tags": []}, {"author": "Ting-Yu Lin \u003ctlin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076516 Part 3 - Remove unnecessary ToString() and ListTag().get() in fmt logging. r=layout-reviewers,dshin\n\n`ListTag()` returns `nsAutoCString`, which can be formatted by `fmt` already, so\nno need to call `.get()`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329791\n", "files": ["layout/generic/AbsoluteContainingBlock.cpp", "layout/generic/BlockReflowState.cpp", "layout/generic/nsBlockFrame.cpp"], "git_node": "bd994e45f593d9502d99da229c478835f89fabd3", "git_parents": ["6c961b579f145af1f4a7f0507a29e183d0e2f00c"], "node": "4e3de9483c08f34947b9f3bc8134183decc1fa58", "parents": ["19937f2910c1e63c72b1641a62ccd78245c765d2"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 5 - Read WebRender pixels back from an explicit source r=gfx-reviewers,lsalzman\n\nReading pixels back was a stateful sequence: attach a texture to the read\nframebuffer, read from whatever is bound, then reset the read target. In an\nexplicit graphics API a readback is a copy from a named texture or target, so\nthe trait now offers read_pixels_into from a ReadTarget, read_texture for the\nwhole of any device texture, and, for captures only, read_external_texture\nfor an application-owned one. The two attach methods, read_pixels and\nreset_read_target leave the trait; the GL backend still resets its read\nbinding at the end of a frame and after a blit inside a pass.\n\nThe renderer's reset after the resolve blits was also what made the tile\nblit of a slice with a backdrop-filter rebind its source on macOS: the\nnative compositor's partial-update copy binds both framebuffer targets\ninside Compositor::bind, which the GL backend's binding cache never saw.\nThe cache now records that the bindings are unknown when a render pass on\na native surface begins and ends, since the embedder binds and unbinds\nthose surfaces itself, so the next bind of either target is always issued.\nA pass on NativeSurfaceHandle::DEFAULT draws to whatever the embedder\nbound, as LayerCompositor::bind_layer does on macOS and Wayland, so the\nbackend queries that binding rather than binding framebuffer 0 over it.\n\nGecko and wrench read the presented frame through the default target, which\nis what the read binding held at that point, so the GL calls are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329518\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/renderer/mod.rs"], "git_node": "52e7f73275887b2153c2623fca478be1e2de27fb", "git_parents": ["bd994e45f593d9502d99da229c478835f89fabd3"], "node": "a0c6cb7af2acdbec11799341add4dee861a6d31e", "parents": ["4e3de9483c08f34947b9f3bc8134183decc1fa58"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 6 - Fix WebRender sampler bindings when a program is linked r=gfx-reviewers,lsalzman\n\nThe renderer bound each sampler to its texture slot with a separate\nbind_shader_samplers call after linking, which required binding the program\nfirst. Explicit graphics APIs fix sampler slots in the pipeline layout when\nthe pipeline is created, so link_program now takes the sampler bindings and\nbind_shader_samplers leaves the trait. The GL backend binds the freshly\nlinked program itself to set them, as the renderer used to.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329519\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/shade.rs"], "git_node": "7dfc6ac4ed970a2c0bcc0b7bf777e4e8620ca792", "git_parents": ["52e7f73275887b2153c2623fca478be1e2de27fb"], "node": "baf23524935a9badb0be32df4ec4cafa9dcac7d9", "parents": ["a0c6cb7af2acdbec11799341add4dee861a6d31e"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 7 - Make WebRender vertex and index buffers explicit resources r=gfx-reviewers,lsalzman\n\nThe VAO type owned three GL buffer names and decided which of them it\nshared with the VAO it was derived from, so vertex data was written through\nthe VAO and the renderer reached the shared instance buffer by a raw buffer\nid. Explicit graphics APIs have buffers as resources the application\ncreates, writes and deletes, and take the vertex layout with the pipeline,\nso the trait now has Buffer, created with a BufferKind and written whole,\nrepeated, reallocated or through an unsynchronized mapping, and\nVertexArray, which pairs a layout with the buffers it reads and is bound as\na unit. The renderer owns the quad index and vertex buffers, the instance\nbuffers and the shared instance buffer, and the VAO type, its update\nmethods and the VBO and IBO ids leave the trait.\n\nThe GL backend records the buffers of the bound vertex array. An index\nbuffer is written through the element array target only while the array\nreading it is bound, since that binding is vertex array state, and through\nthe array buffer target otherwise, which a buffer object is indifferent to.\nThe Adreno rebind after orphaning the bound array's instance buffer is\nunchanged. The debug renderer's line array no longer has an unused index\nbuffer, and its arrays no longer create buffers they never used; all other\nGL calls are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329520\n", "files": ["gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/device/types.rs", "gfx/wr/webrender/src/renderer/debug.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/vertex.rs"], "git_node": "254ede0df2e7962ff2622d0042ae33583e805eee", "git_parents": ["7dfc6ac4ed970a2c0bcc0b7bf777e4e8620ca792"], "node": "54cd1356e5417ced6af447f46f01cd997ce164d9", "parents": ["baf23524935a9badb0be32df4ec4cafa9dcac7d9"], "tags": []}, {"author": "Glenn Watson \u003cgit@chillybin.org\u003e", "branch": "default", "desc": "Bug 2074325 - Pt 8 - Keep GL-only WebRender device settings out of the neutral types r=gfx-reviewers,lsalzman\n\nDeviceOptions carried two settings only the GL backend can act on, and\nCapabilities mixed what the renderer consults with GL implementation\ndetails that only the backend reads. The GL context now travels in a\nGlBackendConfig together with allow_texture_storage and panic_on_error,\nwhich leave DeviceOptions and WebRenderOptions; Gecko passes its\npanic-on-error flag through the config, and wrench and the examples take\nthe defaults. The eight capabilities read only by the GL backend move to a\nprivate struct there, and three the renderer does read are named for what\nthey mean rather than the GL feature behind them.\n\nThe device's memory report no longer takes the SWGL context. That context\nbelongs to the embedder's software compositor, so the renderer reports its\nmemory itself before adding the device's.\n\nNo behaviour change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329521\n", "files": ["gfx/webrender_bindings/src/bindings.rs", "gfx/wr/examples/common/boilerplate.rs", "gfx/wr/examples/multiwindow.rs", "gfx/wr/webrender/src/device/gl.rs", "gfx/wr/webrender/src/device/mod.rs", "gfx/wr/webrender/src/device/types.rs", "gfx/wr/webrender/src/device/upload.rs", "gfx/wr/webrender/src/lib.rs", "gfx/wr/webrender/src/renderer/init.rs", "gfx/wr/webrender/src/renderer/mod.rs", "gfx/wr/webrender/src/renderer/shade.rs", "gfx/wr/wrench/src/wrench.rs"], "git_node": "d3d052b221279208cd37fee188c1644aee2e3de3", "git_parents": ["254ede0df2e7962ff2622d0042ae33583e805eee"], "node": "259693124a081c51b4350baacd55295616acfdc9", "parents": ["54cd1356e5417ced6af447f46f01cd997ce164d9"], "tags": []}, {"author": "Dan Mehic \u003cdmehic@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059415 - Remove the Legacy Telemetry mirrors of the popup notification probes r=TravisLong\n\nOnly the Legacy Telemetry mirrors are removed. The Glean metrics\npopup_notification.stats, popup_notification.main_action and\npopup_notification.dismissal are left in place, so what Firefox collects is\nunchanged.\n\nNo instrumentation changes are needed. Notification.prototype._recordTelemetry\nin PopupNotifications.sys.mjs already records exclusively through\nGlean.popupNotification, so POPUP_NOTIFICATION_STATS,\nPOPUP_NOTIFICATION_MAIN_ACTION_MS and POPUP_NOTIFICATION_DISMISSAL_MS were only\never fed by the mirror, never by a Services.telemetry call.\n\nBoth sides of each mirror have to go in the same commit: test_mirrors.py step 2\nasserts every telemetry_mirror resolves to an existing probe, and step 3 asserts\nevery histogram in Histograms.json has a mirroring metric, so removing either\nside alone fails.\n\nThe \"This metric was generated to correspond to the Legacy Telemetry ...\nhistogram\" sentences are dropped from the three descriptions along with the\nmirrors, since the histograms they name no longer exist. The two comments in\nPopupNotifications.sys.mjs that referred to POPUP_NOTIFICATION_STATS by name now\nrefer to popup_notification.stats.\n\nNo test changes are needed - nothing in the tree asserts on either the\nhistograms or the Glean metrics.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D317372\n", "files": ["toolkit/components/telemetry/Histograms.json", "toolkit/modules/PopupNotifications.sys.mjs", "toolkit/modules/metrics.yaml"], "git_node": "3391423e5128f4a87c8f0c18a2b3a3faab6b3f9c", "git_parents": ["d3d052b221279208cd37fee188c1644aee2e3de3"], "node": "3d41072adc4d4b96e755801ab1d5e63ed0cb6fd4", "parents": ["259693124a081c51b4350baacd55295616acfdc9"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2076487 - Test both double zeros with one mask in strict equality against 0. r=iain\n\nx === 0 and x !== 0 compile to StrictConstantEq/StrictConstantNe, which\nBaseline and Ion lower to three Value compares: Int32Value(0),\nDoubleValue(0.0) and DoubleValue(-0.0). The raw bits of -0.0,\n0x8000000000000000, are not an ARM64 add/sub immediate, so Baseline\nemits five instructions for the two double zeros:\n\n  cmp  x2, #0\n  b.eq pass\n  mov  x16, #0x8000000000000000\n  cmp  x2, x16\n  b.eq pass\n\n+0.0 and -0.0 are the only Values whose bits are zero outside the sign\nbit, and 0x7fffffffffffffff is an ARM64 logical immediate, so one test\ncovers both:\n\n  tst  x2, #0x7fffffffffffffff\n  b.eq pass\n\nIon's branch form already folds the +0.0 compare into cbz, so it goes\nfrom four instructions to two. On x64 the mask takes the movabs that\n-0.0 needed, and the two compares become one test. Ion's set form is\nunchanged.\n\nOn a JetStream 3 run this removes about 7,000 JIT instructions (2,099\nBaseline and 351 Ion sites).\n\nFound with armlint.\n\nClaude-Session: https://claude.ai/code/session_01WsnsqJvQCmPUe3GWmsM77Q\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329772\n", "files": ["js/src/jit-test/tests/ion/strict-eq-zero.js", "js/src/jit/BaselineCodeGen.cpp", "js/src/jit/CodeGenerator.cpp"], "git_node": "529bdd45676d3ed0665b9e4d0b92497b0f381f24", "git_parents": ["3391423e5128f4a87c8f0c18a2b3a3faab6b3f9c"], "node": "acdf220de51c529344061a742fd203c2ef93660b", "parents": ["3d41072adc4d4b96e755801ab1d5e63ed0cb6fd4"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075781 - Fixed TextGenerationTest.ProcessDeathDuringGenerateRejects perma failing on tsan r=gregtatum,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329407\n", "files": ["toolkit/components/ml/tests/gtest/TestHWInferenceProcess.cpp", "toolkit/components/ml/tests/gtest/TestTextGeneration.cpp"], "git_node": "141561ae85087f29f1767c0690868a781e39fe7d", "git_parents": ["529bdd45676d3ed0665b9e4d0b92497b0f381f24"], "node": "f2df9187a5f2b7d3c7883e707fb4199d9142e952", "parents": ["acdf220de51c529344061a742fd203c2ef93660b"], "tags": []}, {"author": "Sarah Clements \u003csclements@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066086 - Fix hide tabs and sidebar logic and refactor sidebar state logic r=sfoster,jsudiaman,sidebar-reviewers,nsharpley,sessionstore-reviewers,kcochrane,extension-reviewers,rpl\n\n* Refactor sidebar visibility and sidebar state logic, removing multiple properties in browser-sidebar and sidebarState that handle launcher visibility\n* Update test coverage, particularly for hide-sidebar setting\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327791\n", "files": ["browser/components/customizableui/test/browser_remove_sidebar_button_and_sidebar.js", "browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/extensions/test/browser/browser_ext_sidebarAction.js", "browser/components/sessionstore/session.schema.json", "browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/docs/index.md", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/browser/browser_adopt_sidebar_from_opener.js", "browser/components/sidebar/tests/browser/browser_customize_sidebar.js", "browser/components/sidebar/tests/browser/browser_launcher_hidden_restore.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_states.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/components/sidebar/tests/unit/test_sidebar_state.js"], "git_node": "6b4126508e0f4af2fe2291dd12b7a927f7e883ce", "git_parents": ["141561ae85087f29f1767c0690868a781e39fe7d"], "node": "140841e7b3660ee6fbeb32eea1cac822eb72eba2", "parents": ["f2df9187a5f2b7d3c7883e707fb4199d9142e952"], "tags": []}, {"author": "Lee Salzman \u003clsalzman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076549 - Batch PathOps appends. r=gfx-reviewers,aosmond\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329820\n", "files": ["gfx/2d/PathRecording.h"], "git_node": "1e269078a63255f607445666ff7685b8efc03529", "git_parents": ["6b4126508e0f4af2fe2291dd12b7a927f7e883ce"], "node": "27724c8f261ecce3c06df9a2b08fc733cf63bd3d", "parents": ["140841e7b3660ee6fbeb32eea1cac822eb72eba2"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1564615 - Part 3: Keep IsOnCurrentThread working further into shutdown for MessageLoop::EventTarget, r=mccr8\" for causing bustages in nsCOMPtr.\n\nThis reverts commit 3f2a73ea8486cb691b0610bcad3396dce15d3bcb.\n\nRevert \"Bug 1564615 - Part 2: Keep XRE_GetAsyncIOMessageLoop working later during shutdown, r=ipc-reviewers,mccr8\"\n\nThis reverts commit 3f3af1fae3bc692bf327299b79cd4e0c0c1b3364.\n\nRevert \"Bug 1564615 - Part 1: Make GeckoChildProcessHost refcounted, r=ipc-reviewers,necko-reviewers,media-playback-reviewers,mccr8,gfx-reviewers,kershaw,padenot,aosmond\"\n\nThis reverts commit 5dbae29f1368a524276385ed172100b5192aaa60.\n", "files": ["dom/base/ChromeUtils.cpp", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/media/gmp/GMPParent.cpp", "dom/media/gmp/GMPParent.h", "dom/media/gmp/GMPProcessParent.cpp", "dom/media/gmp/GMPProcessParent.h", "dom/media/ipc/RDDChild.cpp", "dom/media/ipc/RDDChild.h", "dom/media/ipc/RDDProcessHost.cpp", "dom/media/ipc/RDDProcessHost.h", "dom/media/ipc/RDDProcessManager.cpp", "dom/media/ipc/RDDProcessManager.h", "gfx/ipc/GPUChild.cpp", "gfx/ipc/GPUChild.h", "gfx/ipc/GPUProcessHost.cpp", "gfx/ipc/GPUProcessHost.h", "gfx/ipc/GPUProcessManager.cpp", "gfx/ipc/GPUProcessManager.h", "gfx/vr/ipc/VRChild.cpp", "gfx/vr/ipc/VRChild.h", "gfx/vr/ipc/VRProcessManager.h", "gfx/vr/ipc/VRProcessParent.cpp", "gfx/vr/ipc/VRProcessParent.h", "ipc/chromium/src/base/message_loop.cc", "ipc/glue/ForkServiceChild.cpp", "ipc/glue/ForkServiceChild.h", "ipc/glue/GeckoChildProcessHost.cpp", "ipc/glue/GeckoChildProcessHost.h", "ipc/glue/IOThread.cpp", "ipc/glue/IOThread.h", "ipc/glue/NodeChannel.cpp", "ipc/glue/NodeChannel.h", "ipc/glue/UtilityProcessHost.cpp", "ipc/glue/UtilityProcessHost.h", "ipc/glue/UtilityProcessManager.h", "ipc/glue/UtilityProcessParent.cpp", "ipc/glue/UtilityProcessParent.h", "ipc/glue/test/utility_process_xpcom/UtilityProcessTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTest.cpp", "ipc/ipdl/test/gtest/IPDLUnitTestParent.h", "netwerk/base/nsIOService.h", "netwerk/ipc/SocketProcessHost.cpp", "netwerk/ipc/SocketProcessHost.h", "netwerk/ipc/SocketProcessParent.cpp", "netwerk/ipc/SocketProcessParent.h", "xpcom/base/MemoryTelemetry.cpp"], "git_node": "fd0ef9e401d02482914d0b99cff64216a1128ed7", "git_parents": ["1e269078a63255f607445666ff7685b8efc03529"], "node": "5e9eb3e8550d0ac6eb46587fd8e87972ceee533b", "parents": ["27724c8f261ecce3c06df9a2b08fc733cf63bd3d"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"No Bug, mozilla-central repo-up