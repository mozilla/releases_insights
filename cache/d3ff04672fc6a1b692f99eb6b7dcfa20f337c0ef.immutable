paint-normal-to-between.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-all-002.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-around-003.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-003.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-004.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-empty-all.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-repaint-all-to-around.html.ini", "testing/web-platform/meta/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-repaint-normal-to-between.html.ini"], "git_node": "cc6da3ab8fd6f274e8dd7e87c9998dad088ece4e", "git_parents": ["a1c709ef716b5bfed3c0f8d86f0580daf821797e"], "node": "1a9ad3baac8a54143eea40920b10071f8b83b41f", "parents": ["00f6e0f1f04f4f26eb0fd3c91200d4c077ef42e6"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2074767 [wpt PR 62870] - Remove void element end tags from css-grid alignment WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nRemove void element end tags from css-grid alignment WPTs\n\nimg elements have no end tag. Writing \u003c/img\u003e anyway is a parse error,\nand the parser drops the tag, so the source suggests a structure the\ndocument never had. This CL removes \u003c/img\u003e tags.\n\n\u003c/br\u003e is an exception: the parser rewrites it into a \u003cbr\u003e start tag, so\nit is spelled \u003cbr\u003e instead of being deleted.\n\nBug: 542686202\nChange-Id: I4d7651d0a6d09d61938693aebbdba99be7cfca96\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8221907\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Stephanie 