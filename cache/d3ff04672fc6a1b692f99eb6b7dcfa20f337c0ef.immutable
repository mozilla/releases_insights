Bug 2078126 - Add Search Tabs to the History menu so it's listed in about:keyboard. r=mak,fluent-reviewers,places-reviewers,flod,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330678\n", "files": ["browser/base/content/browser-menubar.inc.xhtml", "browser/base/content/browser-places.js", "browser/base/content/browser-sets.js", "browser/base/content/test/browser-menubar/browser.toml", "browser/base/content/test/browser-menubar/browser_search_tabs.js", "browser/components/urlbar/tests/browser-searchMode/browser_addonsShortcutMoved.js", "browser/locales/en-US/browser/menubar.ftl"], "git_node": "7c4e903ca96386fc8bc6e29b8ccbfc579c2b439f", "git_parents": ["cbebd27b131e8b2eebfdb5edbcfa7a66d81a758b"], "node": "5b693769fa4b9ce5f71082564759509770a29628", "parents": ["f1a9faedf01aac5d4448b7b4ba3652b6b7496c63"], "tags": []}, {"author": "Nicolas Chevobbe \u003cnchevobbe@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076275 - [devtools] Filter out scroll animation in AnimationsActor. r=devtools-reviewers,bomsy.\n\nWe don't support scroll animation in the Animation panel yet,\nso don't notify the client about them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329843\n", "files": ["devtools/client/inspector/animation/test/browser.toml", "devtools/client/inspector/animation/test/browser_animation_scroll-animation.js", "devtools/client/inspector/animation/test/doc_scroll_animation.html", "devtools/server/actors/animation.js"], "git_node": "3c7c944e648d718a1954677abb25a6072faa0a9f", "git_parents": ["7c4e903ca96386fc8bc6e29b8ccbfc579c2b439f"], "node": "6bd89e8b485e6eae657b9012ccf5f18e16c31fed", "parents": ["5b693769fa4b9ce5f71082564759509770a29628"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077600 - Get the revision metadata decision tasks need from a single hg invocation. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330452\n", "files": ["taskcluster/gecko_taskgraph/decision.py", "taskcluster/gecko_taskgraph/test/test_decision.py", "taskcluster/gecko_taskgraph/util/hg.py"], "git_node": "614e761b1689542338d25a11d4aee44756b80079", "git_parents": ["3c7c944e648d718a1954677abb25a6072faa0a9f"], "node": "6d2eba3ade67070c01ade2ad42fc1a50717968b1", "parents": ["6bd89e8b485e6eae657b9012ccf5f18e16c31fed"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077600 - Don't check that automation checkouts are clean when reading test manifests from them. r=taskgraph-reviewers,bhearsum\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330453\n", "files": ["testing/mozbase/moztest/moztest/resolve.py"], "git_node": "8ffb9a45ba7c86b566c8351b8f6dc72ce906e737", "git_parents": ["614e761b1689542338d25a11d4aee44756b80079"], "node": "c5fd33b94810f95f61f7dadb3c31bd7bd28b198f", "parents": ["6d2eba3ade67070c01ade2ad42fc1a50717968b1"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077600 - Get the commits on the current branch from a single hg invocation. r=bhearsum\n\nAvoid calling the base_ref/head_ref properties that both invoke it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330456\n", "files": ["python/mozversioncontrol/mozversioncontrol/repo/mercurial.py"], "git_node": "869e893711afda6b03fb5546cabfd0443e355dca", "git_parents": ["8ffb9a45ba7c86b566c8351b8f6dc72ce906e737"], "node": "23296eec3a8c67966b20b37555f1a9a8daa2b12d", "parents": ["c5fd33b94810f95f61f7dadb3c31bd7bd28b198f"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2077974 - Drop the Python bytes repr from xz-embedded's moz.yaml r=firefox-build-system-reviewers,ahochheiden\n\nThe revision was written as b'...' by a mach vendor that has since been fixed, and the SBOM carried it into the component version and purl.\n\nIt now re-vendors cleanly, so it leaves the vendor-verify expected-fail list.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330614\n", "files": ["modules/xz-embedded/moz.yaml", "taskcluster/scripts/misc/vendor-verify-expected-fail.yml"], "git_node": "dd1ceaa2cca0e905fcfe83db5becfdef164e2c55", "git_parents": ["869e893711afda6b03fb5546cabfd0443e355dca"], "node": "6c2c7d909f8bcdeb457d838f0e4104a47d87c0ef", "parents": ["23296eec3a8c67966b20b37555f1a9a8daa2b12d"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2077975 - Turn Cargo's legacy MIT/Apache-2.0 license syntax into an SPDX expression in the SBOM r=ahochheiden,mach-reviewers\n\nSixty-seven vendored crates still use it, and the SBOM recorded each as a free-text license name nobody can match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330615\n", "files": ["python/mozbuild/mozbuild/test/test_vendor_sbom_cargo.py", "python/mozbuild/mozbuild/vendor/sbom_cargo.py"], "git_node": "b62676037dad05cbc78ef031d39b4b62988e41fb", "git_parents": ["dd1ceaa2cca0e905fcfe83db5becfdef164e2c55"], "node": "c20fb578613c7a3c4c5c1d2cbbbd59bec5bc2cb0", "parents": ["6c2c7d909f8bcdeb457d838f0e4104a47d87c0ef"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2077976 - License an SBOM notice component by its title when it has no SPDX id r=ahochheiden,mach-reviewers\n\nThe JPNIC notice has no SPDX id, so its component was emitted with no license at all.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330616\n", "files": ["python/mozbuild/mozbuild/test/test_vendor_sbom.py", "python/mozbuild/mozbuild/vendor/sbom.py"], "git_node": "8bc128cf8df0987072bda9dd723d9e73deba12ab", "git_parents": ["b62676037dad05cbc78ef031d39b4b62988e41fb"], "node": "e8a5240004841bdf24338d6f6d9cf4e3af22ce5b", "parents": ["c20fb578613c7a3c4c5c1d2cbbbd59bec5bc2cb0"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2077977 - Map unambiguous Python license names to SPDX ids in the build tooling SBOM r=ahochheiden,mach-reviewers\n\nValues such as \"APL 2\" and \"MPL2\" each name one license, but were recorded as free text nobody can match.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330617\n", "files": ["python/mozbuild/mozbuild/test/test_vendor_sbom_python.py", "python/mozbuild/mozbuild/vendor/sbom_python.py"], "git_node": "7d50442041358a4b5d52615447fb72534568d551", "git_parents": ["8bc128cf8df0987072bda9dd723d9e73deba12ab"], "node": "60b753e2e53f9a93b6997353e656228dd5607032", "parents": ["e8a5240004841bdf24338d6f6d9cf4e3af22ce5b"], "tags": []}, {"author": "Fabio Kaminski \u003cfabiokaminski@gmail.com\u003e", "branch": "default", "desc": "Bug 1735401 - EXT_texture_norm16 webgl feature - remove obsolete guards and don't accept unsized RGBA r=lsalzman,gfx-reviewers,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330803\n", "files": ["dom/canvas/WebGLExtensions.cpp", "dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-mochitest/ensure-exts/test_EXT_texture_norm16.html", "dom/canvas/test/webgl-mochitest/ensure-exts/test_common.html", "dom/canvas/test/webgl-mochitest/mochitest.toml", "gfx/gl/GLContextFeatures.cpp"], "git_node": "de4d989402aaab112c0bade11f72650608d2ee61", "git_parents": ["7d50442041358a4b5d52615447fb72534568d551"], "node": "cb07afd4ed72754570a74adc244294b62fb9b870", "parents": ["60b753e2e53f9a93b6997353e656228dd5607032"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065305 - Document how to add a new search bar. r=mak,urlbar-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330379\n", "files": ["browser/components/urlbar/docs/adding-a-search-bar.md", "browser/components/urlbar/docs/index.md", "browser/components/urlbar/docs/telemetry.md"], "git_node": "409961617a8b1d4dc00bf86dc6de9dc00b339452", "git_parents": ["de4d989402aaab112c0bade11f72650608d2ee61"], "node": "43daed94fbbd4ed8bb48629f32d0560a102943d6", "parents": ["cb07afd4ed72754570a74adc244294b62fb9b870"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077559 - Generate the query context, provider, muxer and providers manager docs from JSDoc. r=urlbar-reviewers,mbeier DONTBUILD\n\nThe provider notification methods stay undefined on the base class, since the providers manager calls them only on providers that define them, so their docblocks name themselves with `@function` for jsdoc.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330423\n", "files": ["browser/components/urlbar/UrlbarUtils.sys.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/docs/ProvidersManager.md", "browser/components/urlbar/docs/UrlbarMuxer.md", "browser/components/urlbar/docs/UrlbarProvider.md", "browser/components/urlbar/docs/UrlbarQueryContext.md", "browser/components/urlbar/docs/index.md", "browser/components/urlbar/docs/overview.md"], "git_node": "0d98117d4f71c94ae9d1c95157f303bb050e409e", "git_parents": ["409961617a8b1d4dc00bf86dc6de9dc00b339452"], "node": "3a422b67f98058ad6aa53bffa40f289e52006d66", "parents": ["43daed94fbbd4ed8bb48629f32d0560a102943d6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077559 - Generate the UrlbarResult docs from JSDoc. r=urlbar-reviewers,mbeier DONTBUILD\n\nThe accessors' new `@type` tags replace the `any` tsc inferred from the untyped private fields; the TypeScript lint stays green. `payload` stays untyped because its typedef breaks a caller in QuickSuggest.sys.mjs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330424\n", "files": ["browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/docs/UrlbarResult.md", "browser/components/urlbar/docs/index.md", "browser/components/urlbar/docs/overview.md"], "git_node": "b93f4d4edc3a2023d8a6c4702eb2a719f07d817b", "git_parents": ["0d98117d4f71c94ae9d1c95157f303bb050e409e"], "node": "c75666d3687586baf02818d102619c50c25d1982", "parents": ["3a422b67f98058ad6aa53bffa40f289e52006d66"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077559 - Link overview.md's UrlbarView section to the generated UrlbarView docs. r=urlbar-reviewers,mbeier DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330425\n", "files": ["browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/docs/UrlbarView.md", "browser/components/urlbar/docs/overview.md"], "git_node": "f3b7a8d3b012fd08145007b3f840b503b856d783", "git_parents": ["b93f4d4edc3a2023d8a6c4702eb2a719f07d817b"], "node": "a8d82a62cab994988b96f5b1b28e8253cffee6c7", "parents": ["c75666d3687586baf02818d102619c50c25d1982"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077558 - Document UrlbarInputBase in the address bar API reference. r=mak,firefox-source-docs-reviewers,urlbar-reviewers,sylvestre DONTBUILD\n\nThe page moves from UrlbarInput.html to UrlbarInputBase.html, with a redirect in docs/config.yml, since UrlbarInput is an empty subclass and sphinx-js doesn't pull inherited members onto a subclass page.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330426\n", "files": ["browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/docs/UrlbarInput.md", "browser/components/urlbar/docs/UrlbarInputBase.md", "browser/components/urlbar/docs/index.md", "browser/components/urlbar/docs/overview.md", "docs/config.yml"], "git_node": "1d334a0e543688fb3c38cb71c85cbba5b623a31f", "git_parents": ["f3b7a8d3b012fd08