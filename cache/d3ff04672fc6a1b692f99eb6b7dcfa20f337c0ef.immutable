81f24", "141561ae85087f29f1767c0690868a781e39fe7d", "6b4126508e0f4af2fe2291dd12b7a927f7e883ce", "1e269078a63255f607445666ff7685b8efc03529", "fd0ef9e401d02482914d0b99cff64216a1128ed7", "f3333be0503b9cb51dcd1b442c3175054fa592e2"], "user": "rperta@mozilla.com"}, "45448": {"changesets": [{"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066086 - Fix hide tabs and sidebar logic and refactor sidebar state logic r=sfoster,jsudiaman,sidebar-reviewers,nsharpley,sessionstore-reviewers,kcochrane,extension-reviewers,rpl\" for causing failures at browser_extensions_sidebar.js.\n\nThis reverts commit 6b4126508e0f4af2fe2291dd12b7a927f7e883ce.\n", "files": ["browser/components/customizableui/test/browser_remove_sidebar_button_and_sidebar.js", "browser/components/customizableui/test/browser_uidensity_auto_compact.js", "browser/components/extensions/test/browser/browser_ext_sidebarAction.js", "browser/components/sessionstore/session.schema.json", "browser/components/sidebar/SidebarManager.sys.mjs", "browser/components/sidebar/SidebarState.sys.mjs", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/docs/index.md", "browser/components/sidebar/sidebar-main.mjs", "browser/components/sidebar/tests/browser/browser_adopt_sidebar_from_opener.js", "browser/components/sidebar/tests/browser/browser_customize_sidebar.js", "browser/components/sidebar/tests/browser/browser_launcher_hidden_restore.js", "browser/components/sidebar/tests/browser/browser_sidebar_panel_states.js", "browser/components/sidebar/tests/browser/browser_sidebar_prefs.js", "browser/components/sidebar/tests/marionette/test_last_used_sidebar_panel.py", "browser/components/sidebar/tests/unit/test_sidebar_state.js"], "git_node": "f384c89fc98f8cf5e6ffa0caf568868b29fba90a", "git_parents": ["f3333be0503b9cb51dcd1b442c3175054fa592e2"], "node": "9f64bb532283aea6a40b4415131ac8e4a80e9a66", "parents": ["0424d2f0cfd294609ca2741c9046afa46e3fc349"], "tags": []}], "date": 1790743424, "git_changesets": ["f384c89fc98f8cf5e6ffa0caf568868b29fba90a"], "user": "rperta@mozilla.com"}, "45449": {"changesets": [{"author": "Bas Schouten \u003cbas@basschouten.com\u003e", "branch": "default", "desc": "Bug 2064052 - Report pageload events for background loads, flagged as such, instead of dropping them. r=denispal\n\nDetermining whether a pageload is happening in the foreground is difficult. Currently we do this when the navigation start, but the browsing context isn't always already marked as active when this happens. Finding the right place to do this is difficult, but a one off sample on load seems to be the most reasonable for now.\n\nIn addition this makes it so we still collect pageload events for background loads, just marked as such in the event.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320218\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/nsDOMNavigationTiming.cpp", "dom/base/nsDOMNavigationTiming.h", "dom/base/test/browser.toml", "dom/base/test/browser_page_load_event_telemetry.js", "dom/base/test/file_slow_document.sjs", "dom/metrics.yaml", "tools/performance/PageloadEvent.cpp", "tools/performance/PageloadEvent.h"], "git_node": "bb5dd6a42af836c0e8008d0095ae9e35eda6b94b", "git_parents": ["f3333be0503b9cb51dcd1b442c3175054fa592e2"], "node": "0d45c3af2beaafd7c659f33f090f6b609c413ede", "parents": ["0424d2f0cfd294609ca2741c9046afa46e3fc349"], "tags": []}, {"author": "Bas Schouten \u003cbas@basschouten.com\u003e", "branch": "default", "desc": "Bug 2064064 - Submit pageload telemetry when the document is hidden rather than when it is destroyed. r=denispal\n\nThis moves reporting of the pageload telemetry from document teardown to pagehide. Things like LCP stop updating at this point so collecting later values doesn't add a lot of value. More importantly this means that when a page enters the bfcache we don't potentially lose the pageload if the content process later gets killed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319280\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/test/browser_page_load_event_telemetry.js", "dom/metrics.yaml"], "git_node": "019c104d5230412d4ef4b1c106dbc12f4ed514c2", "git_parents": ["bb5dd6a42af836c0e8008d0095ae9e35eda6b94b"], "node": "93b5ff42edd4c4f2809d770839577753ebc04089", "parents": ["0d45c3af2beaafd7c659f33f090f6b609c413ede"], "tags": []}, {"author": "Bas Schouten \u003cbas@basschouten.com\u003e", "branch": "default", "desc": "Bug 2064072 - Report pageload metrics for documents replaced before their load event fires. r=denispal\n\nSome pages navigate away before there load event has ever fired (search interstitials, consent hops, etc.). Because that means we've never accumulated telemetry for them we would not report a pageload event. These pageload events are important however because they often include the first connection to a domain, or a first daily visit. This makes it so we still collect events for those page loads.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319281\n", "files": ["dom/base/Document.cpp", "dom/base/Document.h", "dom/base/test/browser.toml", "dom/base/test/browser_page_load_event_telemetry.js", "dom/base/test/file_redirect_before_load.html", "dom/metrics.yaml"], "git_node": "07b051c5a7fd065ceb82adb64275888bc20b94ec", "git_parents": ["019c104d5230412d4ef4b1c106dbc12f4ed514c2"], "node": "8695435abedbedc53f2883d9e79a08378f679366", "parents": ["93b5ff42edd4c4f2809d770839577753ebc04089"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/compose/awesomebar/src/main/res/values-be/strings.xml", "mobile/android/android-components/components/compose/awesomebar/src/main/res/values-uk/strings.x