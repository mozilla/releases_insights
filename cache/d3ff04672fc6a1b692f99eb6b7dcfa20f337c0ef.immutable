4"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046990 - Run the llama.cpp smoke and perf tests on both paths r=gregtatum,mozperftest-reviewers,ai-platform-reviewers,yjamora,sparky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316059\n", "files": ["browser/components/genai/tests/browser/perftest.toml", "taskcluster/kinds/perftest/linux.yml", "taskcluster/kinds/perftest/macosx-aarch64.yml", "taskcluster/kinds/perftest/windows11-24h2.yml", "toolkit/components/ml/tests/MLPerfTestUtils.sys.mjs", "toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_llama_smollm2_smoke.js", "toolkit/components/ml/tests/browser/browser_ml_llama_summarizer_perf.js", "toolkit/components/ml/tests/browser/browser_ml_perf_test_utils.js", "toolkit/components/ml/tests/browser/head.js", "toolkit/components/ml/tests/browser/perftest.toml"], "git_node": "521731de889bea439bbbebab1f301e8c5daef6aa", "git_parents": ["b52ae7ca257e578d1e0215879250497ad555a4ad"], "node": "df6708aa96983ec625da0d81e06f40c349ca3a3c", "parents": ["a5030284231458b33028d2e9320ce35a9c8dc523"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046986 - Part 1: Make LlamaRuntimeLinker::Init thread-safe r=gregtatum,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324723\n", "files": ["toolkit/components/ml/backends/llama/LlamaBackend.cpp", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.cpp", "toolkit/components/ml/backends/llama/LlamaRuntimeLinker.h"], "git_node": "a59a3866ac8409cb747646c2af942950f3bc1994", "git_parents": ["521731de889bea439bbbebab1f301e8c5daef6aa"], "node": "29fd3c9655b8777d117916905cdd5b6572ed2bc0", "parents": ["df6708aa96983ec625da0d81e06f40c349ca3a3c"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046986 - Part 2: Test the concurrency contracts of TextGenerator r=gregtatum,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324724\n", "files": ["toolkit/components/ml/tests/browser/browser.toml", "toolkit/components/ml/tests/browser/browser_ml_textgeneration_concurrency.js"], "git_node": "aef3b4bad5f197064754cd596595d0f3889efaf4", "git_parents": ["a59a3866ac8409cb747646c2af942950f3bc1994"], "node": "a859b1e9d379a2981446609609c4fe47f219dfc6", "parents": ["29fd3c9655b8777d117916905cdd5b6572ed2bc0"], "tags": []}, {"author": "Valentin Pollet \u003cvpollet@mozilla.com\u003e", "branch": "default", "desc": "Bug 2046985 - Run tests using llama.cpp on both processes r=gregtatum,ai-platform-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325005\n", "files": ["toolkit/components/ml/tests/MLTestUtils.sys.mjs", "toolkit/components/ml/tests/browser/browser_ml_engine_e2e.js", "toolkit/components/ml/tests/browser/browser_ml_native.js", "toolkit/components/ml/tests/browser/browser_ml_utf8_codepoint.js", "toolkit/components/ml/tests/browser/head.js", "toolkit/components/ml/tests/browser_models/browser_ml_smollm2_chat.js"], "git_node": "1c6bef68b189940ff9d7ab48adaede406cc080dd", "git_parents": ["aef3b4bad5f197064754cd596595d0f3889efaf4"], "node": "adf6ac94bc4b2d32b7921863302c98f47ff49437", "parents": ["a859b1e9d379a2981446609609c4fe47f219dfc6"], "tags": []}, {"author": "andyh \u003candhuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073546 - Added pill navigation for carousel tiles. r=omc-reviewers,fluent-reviewers,flod,sachung\n\nAdds a pill navigation row above single-select carousel cards. A tile item may now define a pill with a label and an icon; the row renders when at least two items define one, and is built from the same post-targeting tiles.data as the cards. Clicking a pill sets the tile's selection and scrolls the matching card to the centre, it never fires the card's action, since pills navigate and the card commits.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328337\n", "files": ["browser/base/content/spotlight.html", "browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/CarouselNav.jsx", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/components/SingleSelect.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/docs/about-welcome.md", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/browser/browser.toml", "browser/components/asrouter/tests/browser/browser_spotlight_carousel_nav.js", "browser/components/asrouter/tests/unit/content-src/components/CarouselNav.test.jsx", "browser/components/asrouter/tests/unit/content-src/components/ContentTiles.test.jsx", "browser/locales/en-US/browser/newtab/onboarding.ftl", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "12b286adb43c7c04fec6c77692757fe54f2e36c3", "git_parents": ["1c6bef68b189940ff9d7ab48adaede406cc080dd"], "node": "53fca3482cea7229d13931a82c095f204fcf4219", "parents": ["adf6ac94bc4b2d32b7921863302c98f47ff49437"], "tags": []}, {"author": "mcarare \u003c48995920+mcarare@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075490 - Reduce SDK configurations in file picker tests to fix OOM failures. r=android-reviewers,pollymce\n\nRemove unnecessary @Config(sdk = [33]) from tests that don't require SDK 33-specific behavior, default 35 satisfies the SDS requirements.\n\nConsolidates handleFilePickerRequest tests to use SDK 32 instead of SDK 28, as the SDK-specific behavior doesn't differ at those levels.\n\nThis reduces the unique SDK versions loaded during test execution, fixing OOM failures in CI.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329219\n", "files": ["mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/file/AndroidPhotoPickerTest.kt", "mobile/android/android-components/components/feature/prompts/src/test/java/mozilla/components/feature/prompts/file/FilePickerTest.kt"], "git_node": "f1cafb3222e25934ff1fdc6331d07b8b3deabcef", "git_parents": ["12b286adb43c7c04fec6c77692757fe54f2e36c3"], "node": "178a32e38ecbe2a0abff7a85a12844ae95700b1c", "parents": ["53fca3482cea7229d13931a82c095f204fcf4219"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2072411 - Guard DecryptingInputStream state with a mutex. r=dom-storage-reviewers,jari\" for causing build bustages at DecryptingInputStream\n\nThis reverts commit 2d33105047eb7507655ce98e73736d0de6cc589a.\n", "files": ["dom/quota/DecryptingInputStream.cpp", "dom/quota/DecryptingInputStream.h", "dom/quota/DecryptingInputStream_impl.h", "dom/quota/test/gtest/TestEncryptedStream.cpp"], "git_node": "678d5b5d65c50d5dac7acea854735deec5a81b63", "git_parents": ["f1cafb3222e25934ff1fdc6331d07b8b3deabcef"], "node": "d5a4329a2b15b8e0419db30f563cab79d0a0b3e8", "parents": ["178a32e38ecbe2a0abff7a85a12844ae95700b1c"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073738 - Don't let '**/*.json' schedule source-test tasks for try_task_config.json. r=taskgraph-reviewers,ahal DONTBUILD\" for causing doc generate failure at /gecko_taskgraph\n\nThis reverts commit c1a5229da404463e56acae9004376018c729ddb1.\n", "files": ["taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_transforms