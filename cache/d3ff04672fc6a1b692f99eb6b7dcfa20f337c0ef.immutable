41d3996a3\nth -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\ntl -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\ntr -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\ntrs -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nuk -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nur -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nuz -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nvi -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nwo -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nxh -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nzam -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nzh-CN -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\nzh-TW -\u003e 509d85dae3ae9ad53f510289f6bf8d641d3996a3\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "4aed13b3ff5cc7aa92dd3547d13eaa5a2ed55f38", "git_parents": ["ef73e06411fcd31d1c3d2adb87954c4c8f870f45"], "node": "8d177c4446425d61ff187a146ba140f4822ce61c", "parents": ["8d15cd02d9282b6b25ff9adb4b8bb00bb291839b"], "tags": []}, {"author": "James Graham \u003cjames@hoppipolla.co.uk\u003e", "branch": "default", "desc": "Bug 2071055 [wpt PR 62594] - Fixes required to make Firefox Android runs work again., a=testonly\n\nAutomatic update from web-platform-tests\nDon't run the userspace oom killer for firefox_android\n\nIn this case all the memory is likely to be in the emulator; we can't\njust kill the browser from the host using this approach. So instead\njust log memory usage and depend on the kernel OOM killer if we really\nget into a low memory situation.\n\n--\nShut down processes cleanly when running via run-tc\n\nThis allows them to clean up and makes it much easier to reuse the docker\ncontainer afterwards.\n\n--\nDon't try t raise the return value of pthread_kill\n\nThis doesn't actually return an exception, so there's nothing to raise\n\n--\nAdd retry for download_and_extract\n\n--\nLog a warning, but don't raise when cleaning up firefox_android\n\nIf cleanup fails we should try to continue and see if we can cleanly restart\nthe browser rather than assuming that we're now in a broken state.\n\n--\nDowngrade to emulator version 36.3.10\n\nThis appears to be the last version that supports the host GPU mode that\nwe're using. Without this we see crashes in some graphics tests when\nrunning firefox_android which take down the entire emulator\n\n--\nSplit test262 into 16 chunks on android\n\n--\nAdd logging of test group selection\n\n--\nEnable debug level logging\n\n--\nAllow downloads to retry for HTTPError as well as socket errors\n\n--\nSplit tests into groups of depth 3 in CI\n\n--\nPass logger explicitly in more of testloader\n\n--\nUnzip using helper rather than unzip tool\n\n--\nMake get_download_to_descriptior use requests\n\n--\nAdd types to more wpt.utils functions\n\n--\nMove http helpers to their own module\n\nThis can depend on requests\n\n--\nRun tc-run in a virtualenv\n\nThis is needed so that it can install dependencies.\n\n--\nHandle urllib3 exceptions during download\n\n--\n\nwpt-commits: 30ad79c882f5f59432d2431544ca8c369a25fd96, 474f0cb60137e8e16811a756ff3612326d8332b4, 12f9719b14edd3a3350262f0b8d7f33368388f44, 1c145d2323c7f5baf926221a138e8cad8989e637, 874d639ae13d2d85561574ca20d79eaf93b6d4da, 621bc0a0b751d7c5ac5824212bc41724b0d78d53, d6d6440feea6c25b3085f44c960d4de37a8a2e15, ccfc26e4c0cb8946f4f1f1d8eeee88f837e10427, d93951ac4a77064debb9a9d893dc3c6b807e1996, 32986223c0176cbc963345e0e4dad950b260a351, 9028d436a38f747afb6729cd3f6a3502b0e71148, cc415400808e95bc2496decc371543782d68625f, f33fba71144b2d6e41b6d07e205a212e64c45152, 3ac7fd7b23c259eed33853d886ac3a60f2652160, 1f1f3ba29ded3f0005e5ccf94fc695db6b9bfbf9, f9403ee73be8739384e05fdbde42a99fdf81260a, 8d4aab9f9f1833b136ce326b8e833f797c4b8b16, 733e005cad890bc96221a054c6d2229cf0aa0053\nwpt-pr: 62594\n", "files": ["testing/web-platform/tests/tools/ci/ci_resources_unittest.sh", "testing/web-platform/tests/tools/ci/ci_tools_integration_test.sh", "testing/web-platform/tests/tools/ci/ci_tools_unittest.sh", "testing/web-platform/tests/tools/ci/commands.json", "testing/web-platform/tests/tools/ci/run_tc.py", "testing/web-platform/tests/tools/ci/taskcluster-run.py", "testing/web-platform/tests/tools/ci/tc/tasks/test.yml", "testing/web-platform/tests/tools/ci/tc/tests/test_valid.py", "testing/web-platform/tests/tools/wpt/android.py", "testing/web-platform/tests/tools/wpt/browser.py", "testing/web-platform/tests/tools/wpt/httputils.py", "testing/web-platform/tests/tools/wpt/utils.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/browsers/firefox_android.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/environment.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/metadata.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/testloader.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/conftest.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_testloader.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_update.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_wptrunner.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/tests/test_wpttest.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/update/__init__.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/wptlogging.py", "testing/web-platform/tests/tools/wptrunner/wptrunner/wptrunner.py"], "git_node": "90ad7b6677535278c10ca042a636053a9180cfa1", "git_parents": ["4aed13b3ff5cc7aa92dd3547d13eaa5a2ed55f38"], "node": "a9d7ec5c2b487ca11dc7402d25710b00f82d13a1", "parents": ["8d177c4446425d61ff187a146ba140f4822ce61c"], "tags": []}, {"author": "Manuel Rego Casasnovas \u003crego@igalia.com\u003e", "branch": "default", "desc": "Bug 2073354 [wpt PR 62768] - aamtests: Add test to check events when `disabled` attribute changes, a=testonly\n\nAutomatic update from web-platform-tests\naamtests: Add test to check events when `disabled` attribute changes\n\nThis passes in Chromium but fails in Firefox\nbecause it doesn't fire `SENSITIVE` event as expected.\n\n--\n\nwpt-commits: ab4b0e8cd04dd07bf6864a34fbf6418046e815cc\nwpt-pr: 62768\n", "files": ["testing/web-platform/tests/html-aam/aamtests/conftest.py", "testing/web-platform/tests/html-aam/aamtests/event/disabled.py"], "git_node": "6621716ec564ae9f177bb8cb8cb37dbdb55ec207", "git_parents": ["90ad7b6677535278c10ca042a636053a9180cfa1"], "node": "53af319faa9adac5346610f4952e97ee81bafa25", "parents": ["a9d7ec5c2b487ca11dc7402d25710b00f82d13a1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073354 [wpt PR 62768] - Update wpt metadata, a=testonly\n\nwpt-pr: 62768\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html-aam/aamtests/event/disabled.py.ini"], "git_node": "45a5d0f25d2c04b94229f05cd1866d327cd557a1", "git_parents": ["6621716ec564ae9f177bb8cb8cb37dbdb55ec207"], "node": "8be79354519a3360197c152e7478a1a010bccf9e", "parents": ["53af319faa9adac5346610f4952e97ee81bafa25"], "tags": []}, {"author": "Seonggon Cho \u003cjmsmg1@me.com\u003e", "branch": "default", "desc": "Bug 2074911 [wpt PR 62900] - [payments] Fix the WPT for multiple payment-method-manifest Link headers, a=testonly\n\nAutomatic update from web-platform-tests\n[payments] Fix the WPT for multiple payment-method-manifest Link headers\n\nThe \"Multiple rel=payment-method-manifest link headers cause fetch to\nabort\" subtest of link-header-selection.https.window.js expected the\nuser agent to abort when a payment method identifier response carries\nmore than one payment-method-manifest link. The spec does not say\nthat: the fetch algorithm walks the Link headers and uses the first\none whose rel is payment-method-manifest\n(https://w3c.github.io/payment-method-manifest/#fetch-pmm), which is\nwhat Chromium already does.\n\nRewrite the subtest to check that the first manifest link is the one\nthat gets fetched, and drop the Chromium baseline that recorded the\nold subtest as a known failure.\n\nR=smcgruer@chromium.org\n\nBug: 545843242\nChange-Id: Ib8df47892752d3dc3551cf96c1052f47a49259a7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8449730\nReviewed-by: Stephen McGruer \u003csmcgruer@chromium.org\u003e\nReviewed-by: Jayden Nikifork \u003cnikifork@google.com\u003e\nCommit-Queue: Stephen McGruer \u003csmcgruer@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703401}\n\n--\n\nwpt-commits: d78575918e30a10b5a81f03931d5bf2d9afb2268\nwpt-pr: 62900\n", "files": ["testing/web-platform/tests/payment-method-manifest/link-header-selection.https.window.js"], "git_node": "bbe9518314ecf6e27f77bd212f23affa95b62abf", "git_parents": ["45a5d0f25d2c04b94229f05cd1866d327cd557a1"], "node": "0c577401f37f3cd2098c4765ce5bfc18f12aaacc", "parents": ["8be79354519a3360197c152e7478a1a010bccf9e"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074911 [wpt PR 62900] - Update wpt metadata, a=testonly\n\nwpt-pr: 62900\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/payment-method-manifest/link-header-selection.https.window.js.ini"], "git_node": "c140b4d0b57cf3c7c4fdb7bb3465aba68a62ef36", "git_parents": ["bbe9518314ecf6e27f77bd212f23affa95b62abf"], "node": "dfa9cce6a7b9ec066e126057183a88ffe40f64ac", "parents": ["0c577401f37f3cd2098c4765ce5bfc18f12aaacc"], "tags": []}, {"author": "Amos Lim \u003ceui-sang.lim@samsung.com\u003e", "branch": "default", "desc": "Bug 2074949 [wpt PR 62899] - [webauthn] Ignore duplicate credential hints, a=testonly\n\nAutomatic update from web-platform-tests\n[webauthn] Ignore duplicate credential hints\n\nThe WebAuthn specification requires second and later occurrences of a\nhint to be ignored. Blink currently forwards duplicates to the browser,\nincluding when requests are delegated to the Windows WebAuthn API.\n\nDeduplicate recognized hints while preserving their first-occurrence\norder in the shared creation and request options converter. Cover both\nconversion paths and update the Windows API expectations.\n\nExtend WPT coverage to accept repeated recognized hints in create/get\nrequests and preserve them during JSON parsing. Internal deduplication\nis checked by the converter tests.\n\nRemove resources/utils.js from the creation hints test because its\nbase64urlEncode shadows the Uint8Array encoder in helpers.js used by\ncredential validation.\n\nBug: 369331496\nChange-Id: I72856a814f7fcc99f8785375035e728db5fa0df7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8391839\nReviewed-by: Ken Buchanan \u003ckenrb@chromium.org\u003e\nReviewed-by: Nina Satragno \u003cnsatragno@chromium.org\u003e\nCommit-Queue: Amos Lim \u003camoseui@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703450}\n\n--\n\nwpt-commits: 8053be7a37a811ae38de8882588fdcecc6ebb081\nwpt-pr: 62899\n", "files": ["testing/web-platform/tests/webauthn/createcredential-hints.https.html", "testing/web-platform/tests/webauthn/getcredential-hints.https.html", "testing/web-platform/tests/webauthn/public-key-credential-creation-options-from-json.https.window.js"], "git_node": "93cfa500b5158a1ed6f369df15b63122e0812551", "git_parents": ["c140b4d0b57cf3c7c4fdb7bb3465aba68a62ef36"], "node": "3f14615c55f2c8a982b3520df268b866df9828c0", "parents": ["dfa9cce6a7b9ec066e126057183a88ffe40f64ac"], "tags": []}, {"author": "David Baron \u003cdbaron@chromium.org\u003e", "branch": "default", "desc": "Bug 2074969 [wpt PR 62902] - Keep menus open when using side arrows to move between toplevel submenus., a=testonly\n\nAutomatic update from web-platform-tests\nKeep menus open when using side arrows to move between toplevel submenus.\n\nThis makes a related set of changes to menu keyboard behavior:\n\n* When focus is on a menuitem in a menulist and that menulist is in a\n  menubar, the old side arrow behavior closed the current open menulist\n  and focused the adjacent menuitem.  For example, if focus was on File\n  -\u003e Open, the right arrow would close the File menu and focus Edit.\n  This makes the change that we now also *open* the Edit menu, although\n  we leave the focus on the Edit menuitem.  This introduces the new\n  possibility that a menuitem can have keyboard focus while its submenu\n  is open.\n\n* When focus is on a menuitem in a menubar and its submenu is open (a\n  new possibility introduced by the previous change), right or left\n  arrows now move to the adjacent menuitem while closing the open\n  submenu and opening a new one.  (Note that the new one doesn't\n  necessarily have a submenu, so we need to close the old one\n  explicitly.)\n\nBug: 406566432\nChange-Id: I69e53e1b28505ccb128bd89f132a31097e14a619\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8426748\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703458}\n\n--\n\nwpt-commits: 6eb7c10af0fbb971b746f0a50d1fcc921814a597\nwpt-pr: 62902\n", "files": ["testing/web-platform/tests/html/semantics/menu/tentative/focus-menu-elements-side-arrowoperations.html"], "git_node": "504aff7389538fc8668ee2faf0c5b8f5fe846d43", "git_parents": ["93cfa500b5158a1ed6f369df15b63122e0812551"], "node": "6768fc0e05cdfac1851108ba969b058ebab53a73", "parents": ["3f14615c55f2c8a982b3520df268b866df9828c0"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074969 [wpt PR 62902] - Update wpt metadata, a=testonly\n\nwpt-pr: 62902\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/menu/tentative/focus-menu-elements-side-arrowoperations.html.ini"], "git_node": "ee1b5a2c4e026ea1563d075ca2035b378b021d41", "git_parents": ["504aff7389538fc8668ee2faf0c5b8f5fe846d43"], "node": "9f70d1ff6dbcd2e57f198a2ba1c6556edc7391e7", "parents": ["6768fc0e05cdfac1851108ba969b058ebab53a73"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2074939 [wpt PR 62894] - Add a test for scroll-axis-lock: none on the viewport., a=testonly\n\nAutomatic update from web-platform-tests\nAdd a test for scroll-axis-lock: none on the viewport.\n\nBug: 479472367, 561877895\nChange-Id: Iac61c5377ff8b0830e50ae2e6d94d84b368d54ef\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8369240\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703471}\n\n--\n\nwpt-commits: c6b5895fa2c1cc649609473608350e99482c9f00\nwpt-pr: 62894\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-axis-lock-none-touch-viewport.html", "testing/web-platform/tests/css/css-overflow/scroll-axis-lock-none-wheel-viewport.html", "testing/web-platform/tests/css/css-overflow/support/scroll-axis-lock.js"], "git_node": "25f93cb2985af081305d2dac4d25871b324fda39", "git_parents": ["ee1b5a2c4e026ea1563d075ca2035b378b021d41"], "node": "e4f4dd6ee9146e32cc32d39cb1b27f580f3e05b5", "parents": ["9f70d1ff6dbcd2e57f198a2ba1c6556edc7391e7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074939 [wpt PR 62894] - Update wpt metadata, a=testonly\n\nwpt-pr: 62894\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/chrome-480554290-crash.html.ini", "testing/web-platform/meta/css/css-overflow/scroll-axis-lock-none-touch-viewport.html.ini", "testing/web-platform/meta/css/css-overflow/scroll-axis-lock-none-wheel-viewport.html.ini"], "git_node": "8cafa9ab39e57299e223613cbcd94eb55bf5dd69", "git_parents": ["25f93cb2985af081305d2dac4d25871b324fda39"], "node": "93def90cee7ceb730912616a99cbd8dcb38e0b23", "parents": ["e4f4dd6ee9146e32cc32d39cb1b27f580f3e05b5"], "tags": []}, {"author": "Andres Ricardo Perez \u003candresrperez@chromium.org\u003e", "branch": "default", "desc": "Bug 2074986 [wpt PR 62904] - [Canvas2D] Respect image orientation in createPattern(), a=testonly\n\nAutomatic update from web-platform-tests\n[Canvas2D] Respect image orientation in createPattern()\n\nEnsure `Canvas2DRecorderContext::createPattern` respects image\norientation when creating pattern fills. Previously, the resolved\norientation setting was not forwarded to `CanvasPattern` and\n`ImagePattern`, which caused pattern shaders to render raw, unoriented\ntiles and led to inconsistencies with `drawImage`.\n\nPass the resolved `RespectImageOrientationEnum` through `CanvasPattern`\nand `Pattern` into `ImagePattern`, reorienting the tile image when\norientation must be respected and the source image has non-default\norientation. Also preserve orientation metadata in multi-frame\n`BitmapImage::ImageForDefaultFrame()`.\n\nThe WPT test matches its equivalent for drawImage():\nhttps://crsrc.org/c/third_party/blink/web_tests/external/wpt/css/css-images/image-orientation/image-orientation-none-cross-origin-canvas.html\n\nBug: 514422784\nChange-Id: I4e4586efe50669331f2cf9308b79000dfb94376e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8399726\nReviewed-by: Jean-Philippe Gravel \u003cjpgravel@chromium.org\u003e\nCommit-Queue: Andres Ricardo Perez Rojas \u003candresrperez@chromium.org\u003e\nAuto-Submit: Andres Ricardo Perez Rojas \u003candresrperez@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703515}\n\n--\n\nwpt-commits: 8486f1dbfad2efc846f3475574deda4ea3e98afa\nwpt-pr: 62904\n", "files": ["testing/web-platform/tests/css/css-images/image-orientation/image-orientation-none-cross-origin-canvas-pattern.html"], "git_node": "c717d7ede4f01ffb6dba861158da120218bf50fc", "git_parents": ["8cafa9ab39e57299e223613cbcd94eb55bf5dd69"], "node": "7f173b28ec9d3664d3051c5b7282d443ec6a4345", "parents": ["93def90cee7ceb730912616a99cbd8dcb38e0b23"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074986 [wpt PR 62904] - Update wpt metadata, a=testonly\n\nwpt-pr: 62904\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-images/image-orientation/image-orientation-none-cross-origin-canvas-pattern.html.ini"], "git_node": "2dc9799ea599e5f84a9709ea6420855a7ddc1f06", "git_parents": ["c717d7ede4f01ffb6dba861158da120218bf50fc"], "node": "119962302c2d515dc7439179f4b3445b483d3fa1", "parents": ["7f173b28ec9d3664d3051c5b7282d443ec6a4345"], "tags": []}, {"author": "David Baron \u003cdbaron@chromium.org\u003e", "branch": "default", "desc": "Bug 2075019 [wpt PR 62909] - Fire \"checked\" event at checkable menuitems., a=testonly\n\nAutomatic update from web-platform-tests\nFire \"checked\" event at checkable menuitems.\n\nThis follows the current spec PR in terms of when it does or doesn't\nfire, although I'm not sure if those rules will stick.\n\nBug: 406566432\nChange-Id: Ic0ad19277768b6fc33138bc033c0cfe266b0c762\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8425645\nCommit-Queue: David Baron \u003cdbaron@chromium.org\u003e\nReviewed-by: Mason Freed \u003cmasonf@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703502}\n\n--\n\nwpt-commits: c39e25f16d8d768ac3f00d441d6a88bfaff81d0d\nwpt-pr: 62909\n", "files": ["testing/web-platform/tests/html/semantics/menu/tentative/checkable.html"], "git_node": "28e8c166227867d084a936aa64934543279c4319", "git_parents": ["2dc9799ea599e5f84a9709ea6420855a7ddc1f06"], "node": "9f953192358123f15087b131968cca89d7d0e742", "parents": ["119962302c2d515dc7439179f4b3445b483d3fa1"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075019 [wpt PR 62909] - Update wpt metadata, a=testonly\n\nwpt-pr: 62909\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/menu/tentative/checkable.html.ini"], "git_node": "caf549b4a89878e84ec14f30f1958845b34dd33c", "git_parents": ["28e8c166227867d084a936aa64934543279c4319"], "node": "7ee2c0ba3153b767daebb86214ec3e9b4b97034e", "parents": ["9f953192358123f15087b131968cca89d7d0e742"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075062 [wpt PR 62921] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=321821, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=321821 (#62921)\n--\n\nwpt-commits: b18c7cddecba4d21acb1a3398096a5c42346e2a1\nwpt-pr: 62921\n", "files": ["testing/web-platform/tests/navigation-api/per-entry-events/dispose-for-navigation-in-child-entries-updated.html", "testing/web-platform/tests/navigation-api/per-entry-events/dispose-for-navigation-in-sibling-detach-frame.html"], "git_node": "4ea72488cee7a333c62b7d79e8da5e3a275f7958", "git_parents": ["caf549b4a89878e84ec14f30f1958845b34dd33c"], "node": "b6db001b47983c9d9242c2142fc02f8e11e15829", "parents": ["7ee2c0ba3153b767daebb86214ec3e9b4b97034e"], "tags": []}, {"author": "Hyowon Kim \u003chyowon@igalia.com\u003e", "branch": "default", "desc": "Bug 2074419 [wpt PR 62851] - Fix background color mismatch in MathML ::first-letter test, a=testonly\n\nAutomatic update from web-platform-tests\nFix background color mismatch in MathML ::first-letter test\n\nThe test used `lightgreen` but its reference used `lime`, so it failed\nin all engines. Use `lime` like the other tests in the series.\n\nBug: 333971751\nChange-Id: I2d04fcffbc9173ea1f3b05541a0b33da2654a258\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8429005\nReviewed-by: Fredrik S\u00f6derquist \u003cfs@opera.com\u003e\nCommit-Queue: Hyowon Kim \u003chyowon@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1703074}\n\n--\n\nwpt-commits: 42477769a19c2fd7501508eeced7b8879656aaff\nwpt-pr: 62851\n", "files": ["testing/web-platform/tests/mathml/relations/css-styling/first-line-first-letter-pseudo-elements-004.html"], "git_node": "4b1c59eefa5ab89dda971ce7f46c1ddbfe4149ff", "git_parents": ["4ea72488cee7a333c62b7d79e8da5e3a275f7958"], "node": "ed3bba8c7077b1d03e229e358d8158c7cbbe6cca", "parents": ["b6db001b47983c9d9242c2142fc02f8e11e15829"], "tags": []}, {"author": "Mo Jamal \u003cjamalmo@microsoft.com\u003e", "branch": "default", "desc": "Bug 2074948 [wpt PR 62898] - [webauthn] Add remoteClientDataJSON renderer surface, a=testonly\n\nAutomatic update from web-platform-tests\n[webauthn] Add remoteClientDataJSON renderer surface\n\nAdd the complete renderer-side input and output surface for the `remoteClientDataJSON` WebAuthn extension. The preceding CLs provide the Mojo contract and browser-side input/output handling.\n\n- Add the experimental WebAuthenticationRemoteClientDataJson runtime feature and map device::kWebAuthnRemoteClientDataJson to it.\n- Add remoteClientDataJSON to the input, FromJSON, output, and output-JSON IDL dictionaries behind the runtime feature.\n- Convert renderer input values to Mojo and browser output values back to the IDL boolean result.\n- Surface the create-flow output through getClientExtensionResults().\n- Advertise extension:remoteClientDataJSON from getClientCapabilities().\n- Reject incompatible conditional and immediate mediation combinations at the renderer boundary.\n- Cover input conversion, JSON round trips, mediation rejection, and extension output conversion.\n\nAI-Assisted Development: developed with assistance from Anthropic's Claude (Claude Code CLI).\n\nBug: 506062130\nChange-Id: Ie2a65b4a5153894ab4e670d10507479dde6578c1\nSpec: https://w3c.github.io/webauthn/#sctn-remote-client-data-json-extension\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8177083\nReviewed-by: Ken Buchanan \u003ckenrb@chromium.org\u003e\nReviewed-by: Martin Kreichgauer \u003cmartinkr@google.com\u003e\nCommit-Queue: Ken Buchanan \u003ckenrb@chromium.org\u003e\nReviewed-by: Rick Byers \u003crbyers@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703589}\n\n--\n\nwpt-commits: 892e178e491bd541326b80ca086253fa03b84233\nwpt-pr: 62898\n", "files": ["testing/web-platform/tests/webauthn/getclientcapabilities.https.html"], "git_node": "0126809951b61b48b341fe4ad699b34d2c256c0d", "git_parents": ["4b1c59eefa5ab89dda971ce7f46c1ddbfe4149ff"], "node": "e2605ce75605c941671b1999ac22582c8d8639ba", "parents": ["ed3bba8c7077b1d03e229e358d8158c7cbbe6cca"], "tags": []}, {"author": "Luke Warlow \u003clwarlow@igalia.com\u003e", "branch": "default", "desc": "Bug 2075046 [wpt PR 62913] - Add initial base appearance UA-styles for temporal inputs, a=testonly\n\nAutomatic update from web-platform-tests\nAdd initial base appearance UA-styles for temporal inputs\n\nThese changes are gated behind the AppearanceBase flag.\n\nSee https://drafts.csswg.org/css-forms-1\n\nBug: 450139531\nChange-Id: Ibf85efa815c03464d06f90f0f62dc12a6e000e22\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8393297\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703678}\n\n--\n\nwpt-commits: b42a965afe0ca3507de839a92cc0c3efa69ccb90\nwpt-pr: 62913\n", "files": ["testing/web-platform/tests/css/css-forms/appearance-base-basic.html"], "git_node": "8a197976716cf162f4c12e7de3e8e4cc69f3b656", "git_parents": ["0126809951b61b48b341fe4ad699b34d2c256c0d"], "node": "b542625778b776985ea6a3b53828737c3ab0db30", "parents": ["e2605ce75605c941671b1999ac22582c8d8639ba"], "tags": []}, {"author": "Luke Warlow \u003clwarlow@igalia.com\u003e", "branch": "default", "desc": "Bug 2075045 [wpt PR 62912] - Add initial base appearance UA-styles for meter elements., a=testonly\n\nAutomatic update from web-platform-tests\nAdd initial base appearance UA-styles for meter elements.\n\nThese changes are gated behind the AppearanceBase flag.\n\nSee https://drafts.csswg.org/css-forms-1\n\nBug: 450139531\nChange-Id: Id7d8e49e179ef40235ab8f434da81a87d65b4c03\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8394017\nCommit-Queue: Joey Arhar \u003cjarhar@chromium.org\u003e\nReviewed-by: Joey Arhar \u003cjarhar@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703689}\n\n--\n\nwpt-commits: 0d8832b8b51b5c4d7acf534b3524bfc81c52feaf\nwpt-pr: 62912\n", "files": ["testing/web-platform/tests/css/css-forms/meter-base-appearance-rendering-ref.tentative.html", "testing/web-platform/tests/css/css-forms/meter-base-appearance-rendering.tentative.html"], "git_node": "82456d6cae3532bbc4b3c9ec1532342e081a1067", "git_parents": ["8a197976716cf162f4c12e7de3e8e4cc69f3b656"], "node": "2880246b4c04aea854304a3df7c238ef0c3d9f9a", "parents": ["b542625778b776985ea6a3b53828737c3ab0db30"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075045 [wpt PR 62912] - Update wpt metadata, a=testonly\n\nwpt-pr: 62912\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-forms/meter-base-appearance-rendering.tentative.html.ini"], "git_node": "5fa6a7c2e3167e17f17ef3547118acc3d3d1263a", "git_parents": ["82456d6cae3532bbc4b3c9ec1532342e081a1067"], "node": "3e20dffbc2c43612b657fcfb5351d53c1957d4c0", "parents": ["2880246b4c04aea854304a3df7c238ef0c3d9f9a"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075096 [wpt PR 62926] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=324519, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=324519 (#62926)\n--\n\nwpt-commits: cbcebc72d1476c2b62c0afce2920bf2c8b95b7fb\nwpt-pr: 62926\n", "files": ["testing/web-platform/tests/css/css-grid/alignment/grid-container-baseline-first-item-in-grid-order.html"], "git_node": "591fa37fd5a0475cf3b7e8ff75a6721053ee8c7c", "git_parents": ["5fa6a7c2e3167e17f17ef3547118acc3d3d1263a"], "node": "2ca8f6c690d324ae5a70a32d007c5c71fd46b608", "parents": ["3e20dffbc2c43612b657fcfb5351d53c1957d4c0"], "tags": []}, {"author": "Domenic Denicola \u003cd@domenic.me\u003e", "branch": "default", "desc": "Bug 2074076 [wpt PR 62827] - Wait for focus fixup in fieldset disabling tests, a=testonly\n\nAutomatic update from web-platform-tests\nWait for focus fixup in fieldset disabling tests\n\nHTML clarified focus fixup in https://github.com/whatwg/html/pull/8392, merged on January 27, 2023. It split the old rule into synchronous fixup when the focused node is removed, without blur events, and asynchronous fixup during \"update the rendering\" when the focused area becomes non-focusable. Disabling a fieldset falls into the latter case: the rendering update runs the focusing steps for the document's viewport.\n\ndisabled-003.html was added on April 7, 2023 in https://github.com/web-platform-tests/wpt/commit/5857a9b5776d85fe77883fadf62c398dc05cf608 as a regression test for Chromium's exponential-time fieldset traversal and a crash caused by reentrant blur handling. Although it postdates the HTML change, its assertions require Chromium's synchronous focus change after disabling a fieldset. They therefore fail implementations that defer the change until a rendering update.\n\nThe dedicated focus-fixup timing tests were updated in https://github.com/web-platform-tests/wpt/pull/38062, merged on June 4, 2025, to check that focus remains unchanged synchronously and is fixed up after rendering. More recently, https://github.com/web-platform-tests/wpt/pull/62292, merged on August 31, 2026, changed the moveBefore() focus-fixup tests to use waitForAtLeastOneFrame() before checking document.activeElement.\n\nUse the same rendering wait here by converting both nested-fieldset cases to promise tests. Assert that each input initially receives focus before disabling the fieldset, then check that focus has moved away after rendering. This preserves the original shallow and deeply nested crash/hang cases.\n\nDo not add exact-timing assertions here that would fail Chromium for changing focus synchronously. Timing after disabling a fieldset is already covered by the #button4 subtest in https://github.com/web-platform-tests/wpt/blob/532766fee262a2b41054665505b9dc37bd7c0a25/html/interaction/focus/processing-model/focus-fixup-rule-one-no-dialogs.html. That case focuses a button and disables its parent fieldset; the shared helper checks that focus remains unchanged synchronously, during the first animation-frame callback, and during ResizeObserver delivery, then checks that focus is fixed up after rendering.\n\nBoth subtests change from failing to passing in Firefox 151 and WebKit 26.5, and continue to pass in Chromium 149.\n\nCo-authored-by: codex \u003ccodex@openai.com\u003e\n\n--\n\nwpt-commits: 8e9f3e2199fca135a62526a75410ecf10d3f9e3d\nwpt-pr: 62827\n", "files": ["testing/web-platform/tests/html/semantics/forms/the-fieldset-element/disabled-003.html"], "git_node": "77b87a2cb4dbc121f50640755018f73cca7d864b", "git_parents": ["591fa37fd5a0475cf3b7e8ff75a6721053ee8c7c"], "node": "83f7afc3ec5bec789d2015bd9f20f268c5835101", "parents": ["2ca8f6c690d324ae5a70a32d007c5c71fd46b608"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074076 [wpt PR 62827] - Update wpt metadata, a=testonly\n\nwpt-pr: 62827\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/html/semantics/forms/the-fieldset-element/disabled-003.html.ini"], "git_node": "57a7d9ed90213c5661114002f13cf5ae705f6a0e", "git_parents": ["77b87a2cb4dbc121f50640755018f73cca7d864b"], "node": "58880fc7e67c8958e0f6e8c190994ec6664a4341", "parents": ["83f7afc3ec5bec789d2015bd9f20f268c5835101"], "tags": []}, {"author": "Ahmad Saleem \u003c52317531+Ahmad-S792@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075090 [wpt PR 62924] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=323524, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=323524 (#62924)\n--\n\nwpt-commits: b16aeea13b18b83b53081e5a7ecddcae66e2dc21\nwpt-pr: 62924\n", "files": ["testing/web-platform/tests/css/cssom/getComputedStyle-insets-grid.html"], "git_node": "a1ccb422decc42fb33343802732aba79a85a383f", "git_parents": ["57a7d9ed90213c5661114002f13cf5ae705f6a0e"], "node": "1cf2509218f383e84de7f1d894f648a0224ecc04", "parents": ["58880fc7e67c8958e0f6e8c190994ec6664a4341"], "tags": []}, {"author": "Shivani Sharma \u003cshivanisha@chromium.org\u003e", "branch": "default", "desc": "Bug 2075056 [wpt PR 62917] - [Fenced Frames] Remove fenced frames code keeping stubs intact, a=testonly\n\nAutomatic update from web-platform-tests\n[Fenced Frames] Remove fenced frames code keeping stubs intact\n\nThis CL removes internal fenced frames code while continuing to\nsupport the FF stub as per the I2S for fenced frames removal:\nhttps://chromestatus.com/feature/6366274495053824\n\nFollowing the parent CL that stubs out \u003cfencedframe\u003e and\nFencedFrameConfig: crrev.com/c/8144979,\nthis CL removes the underlying internal MPArch host\ninfrastructure, Mojo reporting beacon interfaces, and renderer-side\nframe tree logic.\n\nFor consistency with the FF element being stubbed, this CL also stubs\nwindow.fence methods.\n\nIt hardcodes IsInFencedFrameTree() and similar methods in blink and\nbrowser code to always return false. To keep this CL a reasonable\nsize, those methods and their hundreds of callers will be cleaned up in\na follow-up.\n\nMain Details:\n1. Mojo:\n   - Removed beacon reporting methods (SendFencedFrameReportingBeacon,\n     SendFencedFrameReportingBeaconToCustomURL,\n     SetFencedFrameAutomaticBeaconReportEventData) from LocalFrameHost.\n   - Removed AdScriptDidCreateFencedFrame from SubresourceFilterHost.\n2. Blink Renderer:\n   - Deleted window.fence JS API (Fence, fence.idl, fence_event.idl,\n     fence.h, fence.cc, fence_test.cc).\n   - Deleted DocumentFencedFrames and cleaned up all traversals.\n   - Deleted WebRemoteFrameImpl::CreateForFencedFrame.\n   - Hardcoded Frame::IsInFencedFrameTree() and IsFencedFrameRoot() to\n     unconditionally return false.\n3. Content Browser & Chrome:\n   - Deleted content::FencedFrame, FencedDocumentData,\nAutomaticBeaconInfo, and fenced_frame_unittest.cc.\n   - Removed fenced_frames_, GetFencedFrames(), and DestroyFencedFrame()\n     from RenderFrameHostImpl.\n   - Removed SiteInstanceImpl::CreateForFencedFrame.\n   - Deleted chrome/browser TaskManager's FencedFrameTask.\n   - Updated TestRenderFrameHost::AppendFencedFrame() and test utilities\n     to remove FencedFrame dependencies.\n\nFollow-up CLs:\n1. Call site cleanup: Remove remaining checks for IsInFencedFrameTree()\n   and IsNestedWithinFencedFrame() across content/, chrome/, and\n   components/ now that they unconditionally return false.\n2. Navigation plumbing: Clean up _unfencedTop navigation logic and\n   is_unfenced_top_navigation IPC parameter across Navigator and\n   NavigationControllerImpl.\n3. Test cleanup: Remove obsolete unit and browser tests specifically\n   asserting feature restrictions or behaviors inside fenced frame\n   trees.\n4. Data structure cleanup: Remove FencedFrameStatus and\n   FrameTree::Type::kFencedFrame enums once all remaining references are\n   eliminated.\n5. Cleanup URN:UUID to URL related functionality during navigation.\n\nLow-Coverage-Reason: Tests needed to be removed as FF code is only a\nstub. The remaining unreached code will be removed in the follow-up CLs\ntracked in bug 564522508.\n\nBug: 538634423, 540020364\nFixed: 40227465\nAX-Relnotes: n/a.\n\nChange-Id: I0bd9d4d3b9a75270d74f1a5137ae7efe381617f9\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8144621\nReviewed-by: Colin Blundell \u003cblundell@chromium.org\u003e\nReviewed-by: Josh Karlin \u003cjkarlin@chromium.org\u003e\nReviewed-by: Joe Mason \u003cjoenotcharles@google.com\u003e\nReviewed-by: Xiaochen Zhou \u003cxiaochenzh@chromium.org\u003e\nSLSA-Policy-Verified: SLSA Policy Verification Service \u003cdevtools-gerritcodereview-exitgate@google.com\u003e\nCommit-Queue: Shivani Sharma \u003cshivanisha@chromium.org\u003e\nReviewed-by: Lei Zhang \u003cthestig@chromium.org\u003e\nReviewed-by: Andrew Verge \u003caverge@chromium.org\u003e\nReviewed-by: Dave Tapuska \u003cdtapuska@chromium.org\u003e\nReviewed-by: Alex Moshchuk \u003calexmos@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703783}\n\n--\n\nwpt-commits: e00846900c4974eaa7d12f7110d66e254c0f99b8\nwpt-pr: 62917\n", "files": ["testing/web-platform/tests/fenced-frame/fenced-frame-stub.https.html"], "git_node": "f0afa9a0976eef8e90ae49b45de4070bfad96f1e", "git_parents": ["a1ccb422decc42fb33343802732aba79a85a383f"], "node": "8bea0c3e302460ef3fd980888f0ea55c0d1a8058", "parents": ["1cf2509218f383e84de7f1d894f648a0224ecc04"], "tags": []}, {"author": "Javier Contreras Tenorio \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2075080 [wpt PR 62923] - [gap-decorations] Remove stale TODOs from GapDecorations code, a=testonly\n\nAutomatic update from web-platform-tests\n[gap-decorations] Remove stale TODOs from GapDecorations code\n\nFor the inset TODO comments we already have test coverage here:\nthird_party/blink/web_tests/external/wpt/css/css-gaps/parsing/rule-inset-shorthand.html\n\nChange-Id: I2507fbfd4509776184e466b5099a700e8dbd6387\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8446502\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1703802}\n\n--\n\nwpt-commits: 8e8294c09bb2d8a3c21e9d8f891874b15ecded20\nwpt-pr: 62923\n", "files": ["testing/web-platform/tests/css/css-gaps/parsing/rule-inset-cap-start-end-computed.html", "testing/web-platform/tests/css/css-gaps/parsing/rule-inset-cap-start-end-invalid.html", "testing/web-platform/tests/css/css-gaps/parsing/rule-inset-junction-start-end-computed.html", "testing/web-platform/tests/css/css-gaps/parsing/rule-inset-junction-start-end-invalid.html"], "git_node": "ca8a3f03990f25701c39bf19a34ec18a3f90bfb3", "git_parents": ["f0afa9a0976eef8e90ae49b45de4070bfad96f1e"], "node": "3c207ddfe8e4dce78ccc913a080220fab9751b5a", "parents": ["8bea0c3e302460ef3fd980888f0ea55c0d1a8058"], "tags": []}, {"author": "Thomas Guilbert \u003ctguilbert@chromium.org\u003e", "branch": "default", "desc": "Bug 2075110 [wpt PR 62928] - [WebCodecs] Fix conflicting description tests in audio-decoder WPT, a=testonly\n\nAutomatic update from web-platform-tests\n[WebCodecs] Fix conflicting description tests in audio-decoder WPT\n\nPer https://github.com/w3c/webcodecs/issues/826,\n`AudioDecoder.isConfigSupported()` does not require\n`AudioDecoderConfig.description`, even when `description` is required by\n`AudioDecoder.configure()` (such as for `flac`, `vorbis`, or\nmulti-channel `opus`).\n\nThis CL fixes two issues in `audio-decoder.https.any.js`:\n1. Removes the conflicting multi-channel `opus` entry from\n  `invalidConfigs`.\n2. Awaits`AudioDecoder.isConfigSupported()` only for\n  `supportedButErrorOnConfiguration` entries in the `shouldError` loop.\n\nTAG=agy\nCONV=99ce3bb9-84d9-495a-b0e2-f29a2e07431a\n\nBug: 360083330\nChange-Id: Iedc22144f78291549cc47c8af18b7044589e3900\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8449240\nReviewed-by: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCommit-Queue: Dale Curtis \u003cdalecurtis@chromium.org\u003e\nCommit-Queue: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nAuto-Submit: Thomas Guilbert \u003ctguilbert@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1703867}\n\n--\n\nwpt-commits: be7a4efae6cadad861ed9e03270f41f0de262cd2\nwpt-pr: 62928\n", "files": ["testing/web-platform/tests/webcodecs/audio-decoder.https.any.js"], "git_node": "a7224fde127acb2c933a70b233e59f8c17e0aa9e", "git_parents": ["ca8a3f03990f25701c39bf19a34ec18a3f90bfb3"], "node": "d4f11093425bfd61284a46883a9fd7ec5c5df516", "parents": ["3c207ddfe8e4dce78ccc913a080220fab9751b5a"], "tags": []}, {"author": "Brent Fulgham \u003c44174109+brentfulgham@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075149 [wpt PR 62931] - WebKit export of https://bugs.webkit.org/show_bug.cgi?id=203509, a=testonly\n\nAutomatic update from web-platform-tests\nWebKit export of https://bugs.webkit.org/show_bug.cgi?id=203509 (#62931)\n--\n\nwpt-commits: e35344a20f922751f5ea8cc678cfd79d65056d5c\nwpt-pr: 62931\n", "files": ["testing/web-platform/tests/css/css-sizing/replaced-element-max-content-contribution-transferred-size.html", "testing/web-platform/tests/css/css-sizing/table-cell-definite-height-transferred-size.html"], "git_node": "f959dba5ddb38a3c8715779918a5730b85f1f1dc", "git_parents": ["a7224fde127acb2c933a70b233e59f8c17e0aa9e"], "node": "62f056cfb0e5c483bdc92d8c2b616ac72a3e1a49", "parents": ["d4f11093425bfd61284a46883a9fd7ec5c5df516"], "tags": []}, {"author": "Stalgia Grigg \u003cstalgiag@igalia.com\u003e", "branch": "default", "desc": "Bug 2075036 [wpt PR 62871] - [direct-sockets] Add vkrot-cell as suggested reviewer, a=testonly\n\nAutomatic update from web-platform-tests\n[direct-sockets] Add vkrot-cell as suggested reviewer\n\n--\n\nwpt-commits: 6052c521aff26ed90e620c1ec2c9a61d665b9b3c\nwpt-pr: 62871\n", "files": ["testing/web-platform/tests/direct-sockets/META.yml"], "git_node": "9ff27bc0d86bde85a0019563ec0bb5b167187116", "git_parents": ["f959dba5ddb38a3c8715779918a5730b85f1f1dc"], "node": "f444eb91fd7292d8bf87dadd969eb0d94eb02fd7", "parents": ["62f056cfb0e5c483bdc92d8c2b616ac72a3e1a49"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2075052 [wpt PR 62915] - [anchor] Scrolling doesn't affect fallbacks inside fragmentation., a=testonly\n\nAutomatic update from web-platform-tests\n[anchor] Scrolling doesn't affect fallbacks inside fragmentation.\n\nA scrollable container inside a fragmentation context is always\nmonolithic, so it's not possible to have fragmented anchor-positioned\nOOFs that are affected by scrolling. The scroll ranges collected would\nbe in the stitched coordinate system anyway, which is useless. So don't\ncollect them.\n\nDiscovered while trying to make this work with the FragmentedOofInCb\nfeature.\n\nWe still need to choose the right fallback during layout, though. There\nwas no test coverage for this, so add a couple of tests.\n\nNo behavior changes intended.\n\nBug: 40267498\nChange-Id: I2503a6a8d87d0e30c24df39d0e60eeb33058531d\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8442276\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1704130}\n\n--\n\nwpt-commits: f63601f60d1627c76390c095feaacf5d511edec3\nwpt-pr: 62915\n", "files": ["testing/web-platform/tests/css/css-anchor-position/position-try-fallbacks-multicol-001.html", "testing/web-platform/tests/css/css-anchor-position/position-try-fallbacks-multicol-002.html"], "git_node": "fefe3d3b0de89bf0c4dfc04e6aa659484bda0d51", "git_parents": ["9ff27bc0d86bde85a0019563ec0bb5b167187116"], "node": "12b579a5bb78ace9856850583211e23764b2b007", "parents": ["f444eb91fd7292d8bf87dadd969eb0d94eb02fd7"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075052 [wpt PR 62915] - Update wpt metadata, a=testonly\n\nwpt-pr: 62915\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-anchor-position/anchor-as-multicol-crash.html.ini"], "git_node": "88586646b9ac9a62ab2351299c40a2324d211e9b", "git_parents": ["fefe3d3b0de89bf0c4dfc04e6aa659484bda0d51"], "node": "ce6055db974ed5a224e32604b6820ae2e9ac10a6", "parents": ["12b579a5bb78ace9856850583211e23764b2b007"], "tags": []}, {"author": "Morten Stenshorne \u003cmstensho@chromium.org\u003e", "branch": "default", "desc": "Bug 2075055 [wpt PR 62916] - Deflake css-anchor-position/scroll-to-anchored-fixed-*, a=testonly\n\nAutomatic update from web-platform-tests\nDeflake css-anchor-position/scroll-to-anchored-fixed-*\n\nSome of the tests/refs were missing an await for document.fonts.ready.\nAdd it everywhere.\n\nLocally scroll-to-anchored-fixed-001.html and\nscroll-to-anchored-fixed-002.html had a pass rate of about 25% without\nthis fix.\n\nscroll-to-anchored-fixed-000.html is still failing (consistently), but\nfix that test too, so that it doesn't become flaky once we fix the bug,\nwhatever that is.\n\nBug: 469481151\nChange-Id: Ic9127455d6d778768839e2dc997a99250ca4ec2e\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8446078\nReviewed-by: Hyowon Kim \u003chyowon@igalia.com\u003e\nCommit-Queue: Morten Stenshorne \u003cmstensho@chromium.org\u003e\nReviewed-by: Ian Kilpatrick \u003cikilpatrick@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1704135}\n\n--\n\nwpt-commits: 3834b07555e8115b900633c9ad972ef8a8cbe433\nwpt-pr: 62916\n", "files": ["testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-000-ref.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-000.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-001-ref.html", "testing/web-platform/tests/css/css-anchor-position/scroll-to-anchored-fixed-002-ref.html"], "git_node": "127346ca5c3c45440e9a7e51aca64f72b51a1474", "git_parents": ["88586646b9ac9a62ab2351299c40a2324d211e9b"], "node": "3b9e9bfdbc3de0948edb22a19fa06752ef76e8f9", "parents": ["ce6055db974ed5a224e32604b6820ae2e9ac10a6"], "tags": []}, {"author": "Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e", "branch": "default", "desc": "Bug 2074683 [wpt PR 62867] - Add test to verify scroll-axis-lock does not propagate from the body to viewport in quirks mode., a=testonly\n\nAutomatic update from web-platform-tests\nAdd test to verify scroll-axis-lock does not propagate from the body to viewport in quirks mode.\n\nSee https://github.com/w3c/csswg-drafts/issues/13207#issuecomment-5549971412\n\nBug: 479472367, 561877895\nChange-Id: I08afa773230b04a4704a3ba829259d859f5c82d4\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8412467\nReviewed-by: Robert Flack \u003cflackr@chromium.org\u003e\nCommit-Queue: Fr\u00e9d\u00e9ric Wang N\u00e9lar \u003cfwang@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1704169}\n\n--\n\nwpt-commits: cda230b4e4678b4de993e8fa95752348af4b8c56\nwpt-pr: 62867\n", "files": ["testing/web-platform/tests/css/css-overflow/scroll-axis-lock-not-propagated-from-body-quirks.html"], "git_node": "612e2b2f45cae8449a88a74d594ee4b5670582e0", "git_parents": ["127346ca5c3c45440e9a7e51aca64f72b51a1474"], "node": "69a53bd59aade72668e5d21751db37eee11b1774", "parents": ["3b9e9bfdbc3de0948edb22a19fa06752ef76e8f9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074683 [wpt PR 62867] - Update wpt metadata, a=testonly\n\nwpt-pr: 62867\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-overflow/scroll-axis-lock-not-propagated-from-body-quirks.html.ini", "testing/web-platform/meta/css/css-overflow/text-overflow-string-in-textarea-focused.html.ini"], "git_node": "011ca02b3695069fd6b8a9185cae2708a7d169a0", "git_parents": ["612e2b2f45cae8449a88a74d594ee4b5670582e0"], "node": "5d2259558eb8891ce3099be6a18635b9bc08d5c7", "parents": ["69a53bd59aade72668e5d21751db37eee11b1774"], "tags": []}, {"author": "BruceDai \u003cfeng.dai@intel.com\u003e", "branch": "default", "desc": "Bug 2075169 [wpt PR 62933] - webnn: add a test of casting uint32 tensors to uint64 for cast op, a=testonly\n\nAutomatic update from web-platform-tests\nwebnn: add a test of casting uint32 tensors to uint64 for cast op\n\nChange-Id: I62947fdfbb4424d91a1b1a31f79f491ee3c6e5be\nBug: 564071954\nCq-Include-Trybots: luci.chromium.try\u200b:win11-blink-rel, mac14.arm64-blink-rel, mac15.arm64-blink-rel\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8427348\nCommit-Queue: Dai, Feng \u003cfeng.dai@intel.com\u003e\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nAuto-Submit: Dai, Feng \u003cfeng.dai@intel.com\u003e\nReviewed-by: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nCr-Commit-Position: refs/heads/main@{#1704192}\n\n--\n\nwpt-commits: c4824748946e110f005a9496151f1321878bbea5\nwpt-pr: 62933\n", "files": ["testing/web-platform/tests/webnn/conformance_tests/cast.https.any.js"], "git_node": "9135e1dded5a7c6d8a8789953b671d588cef14db", "git_parents": ["011ca02b3695069fd6b8a9185cae2708a7d169a0"], "node": "8f5fc16065442e548518f735c56fabcb1b6456b5", "parents": ["5d2259558eb8891ce3099be6a18635b9bc08d5c7"], "tags": []}, {"author": "BruceDai \u003cfeng.dai@intel.com\u003e", "branch": "default", "desc": "Bug 2075060 [wpt PR 62920] - webnn: add rank-range validation helpers and apply to simple operators, a=testonly\n\nAutomatic update from web-platform-tests\nwebnn: add rank-range validation helpers and apply to simple operators\n\nopSupportLimits() declares a rankRange (min/max) for every operand of\nevery operator, but nothing in the WPT validation suite checks that an\nimplementation actually honours the range it advertises. A rank the\nimplementation wrongly accepts is reported as supported and then reaches\nthe backend, where internal limits are tighter than the WebNN global max\nof 8 (e.g. XNNPACK's XNN_MAX_TENSOR_DIMS is 6).\n\nThis CL adds shared helpers to resources/utils_validation.js:\n\n - validateOperandRankTooSmall / validateOperandRankInRange /\n   validateOperandRankTooLarge assert that an operand's rank is rejected\n   below rankRange.min, accepted throughout [min, max], and rejected\n   above max. The out-of-range helpers iterate the whole out-of-range\n   region rather than just the boundary.\n - validateOperandRank / validateOperandRankOutOfRange bundle those so a\n   caller cannot forget one region.\n - pickSupportedDataTypeInfo / buildInputOperand pick a dtype the\n   operand declares that is also creatable as a graph input, falling\n   back to a widening-compatible dtype plus a cast() when the declared\n   dtype is not directly creatable.\n\nApply the helpers to operators whose rank check is a single call with no\ncompanion operands: activations, element-wise unary, pooling, reduction,\ncast, concat, cumulativeSum, expand, pad, reshape, reverse, slice,\nsplit, tile, transpose and triangular.\n\nThis is the first of a series; subsequent CLs cover operators with\ncompanion operands, Cartesian multi-operand rank coverage, and the\ngather/scatter/quantize families.\n\nChange-Id: If18b77397f46dfcbfe5ecdb2e7969b28c2d81d17\nBug: 501135993\nCq-Include-Trybots: luci.chromium.try\u200b:win11-blink-rel, mac14.arm64-blink-rel, mac14-blink-rel, mac15.arm64-blink-rel, mac15-blink-rel, linux-blink-rel\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8423780\nReviewed-by: Reilly Grant \u003creillyg@chromium.org\u003e\nAuto-Submit: Dai, Feng \u003cfeng.dai@intel.com\u003e\nReviewed-by: Hu, Ningxin \u003cningxin.hu@intel.com\u003e\nCommit-Queue: Dai, Feng \u003cfeng.dai@intel.com\u003e\nCr-Commit-Position: refs/heads/main@{#1704212}\n\n--\n\nwpt-commits: cfb07da1a3581fd1c1c46e236adf32b43ed95fbc\nwpt-pr: 62920\n", "files": ["testing/web-platform/tests/webnn/resources/utils_validation.js", "testing/web-platform/tests/webnn/validation_tests/cast.https.any.js", "testing/web-platform/tests/webnn/validation_tests/clamp.https.any.js", "testing/web-platform/tests/webnn/validation_tests/concat.https.any.js", "testing/web-platform/tests/webnn/validation_tests/cumulativeSum.https.any.js", "testing/web-platform/tests/webnn/validation_tests/elementwise-unary.https.any.js", "testing/web-platform/tests/webnn/validation_tests/elu.https.any.js", "testing/web-platform/tests/webnn/validation_tests/expand.https.any.js", "testing/web-platform/tests/webnn/validation_tests/gelu.https.any.js", "testing/web-platform/tests/webnn/validation_tests/hardSigmoid.https.any.js", "testing/web-platform/tests/webnn/validation_tests/hardSwish.https.any.js", "testing/web-platform/tests/webnn/validation_tests/instanceNormalization.https.any.js", "testing/web-platform/tests/webnn/validation_tests/leakyRelu.https.any.js", "testing/web-platform/tests/webnn/validation_tests/linear.https.any.js", "testing/web-platform/tests/webnn/validation_tests/pad.https.any.js", "testing/web-platform/tests/webnn/validation_tests/pooling.https.any.js", "testing/web-platform/tests/webnn/validation_tests/reduction.https.any.js", "testing/web-platform/tests/webnn/validation_tests/relu.https.any.js", "testing/web-platform/tests/webnn/validation_tests/reshape.https.any.js", "testing/web-platform/tests/webnn/validation_tests/reverse.https.any.js", "testing/web-platform/tests/webnn/validation_tests/sigmoid.https.any.js", "testing/web-platform/tests/webnn/validation_tests/slice.https.any.js", "testing/web-platform/tests/webnn/validation_tests/softmax.https.any.js", "testing/web-platform/tests/webnn/validation_tests/softplus.https.any.js", "testing/web-platform/tests/webnn/validation_tests/softsign.https.any.js", "testing/web-platform/tests/webnn/validation_tests/split.https.any.js", "testing/web-platform/tests/webnn/validation_tests/tanh.https.any.js", "testing/web-platform/tests/webnn/validation_tests/tile.https.any.js", "testing/web-platform/tests/webnn/validation_tests/transpose.https.any.js", "testing/web-platform/tests/webnn/validation_tests/triangular.https.any.js"], "git_node": "12974e13a7ac64e08e8cfaac60a91a43df9b198c", "git_parents": ["9135e1dded5a7c6d8a8789953b671d588cef14db"], "node": "bcd3cca39ab7209291bebcc2f623fb17f022f9ec", "parents": ["8f5fc16065442e548518f735c56fabcb1b6456b5"], "tags": []}, {"author": "Anne van Kesteren \u003cannevk@annevk.nl\u003e", "branch": "default", "desc": "Bug 2072373 [wpt PR 62719] - DOM: tests for event listeners on targets that are not fully active, a=testonly\n\nAutomatic update from web-platform-tests\nDOM: tests for event listeners on targets that are not fully active\n\nCovers skipping an event listener when the event target's or the listener\ncallback's global is a Window whose associated Document is not fully active,\nand how that interacts with adopted nodes, event handler attributes, and\ndocuments without a browsing context.\n\nPR: https://github.com/whatwg/dom/pull/1085 & https://github.com/whatwg/html/pull/12944\n--\n\nwpt-commits: 443da5ac58a504e644df1b83a817f83129f61648\nwpt-pr: 62719\n", "files": ["testing/web-platform/tests/dom/events/event-listener-not-fully-active-adopted-node.html", "testing/web-platform/tests/dom/events/event-listener-not-fully-active-callback.html", "testing/web-platform/tests/dom/events/event-listener-not-fully-active-navigated.html", "testing/web-platform/tests/dom/events/event-listener-not-fully-active-target.html", "testing/web-platform/tests/dom/events/resources/not-fully-active-frame.html", "testing/web-platform/tests/dom/events/resources/not-fully-active-helpers.js", "testing/web-platform/tests/html/webappapis/scripting/events/event-handler-no-browsing-context.html", "testing/web-platform/tests/html/webappapis/scripting/events/event-listener-sandboxed-scripts.html"], "git_node": "804b2f9fd1d54aa63889273b78a741538857e55e", "git_parents": ["12974e13a7ac64e08e8cfaac60a91a43df9b198c"], "node": "be20824fb7a23f5f9b73dea64587209382345ed6", "parents": ["bcd3cca39ab7209291bebcc2f623fb17f022f9ec"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072373 [wpt PR 62719] - Update wpt metadata, a=testonly\n\nwpt-pr: 62719\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/dom/events/event-listener-not-fully-active-adopted-node.html.ini", "testing/web-platform/meta/dom/events/event-listener-not-fully-active-navigated.html.ini", "testing/web-platform/meta/dom/events/event-listener-not-fully-active-target.html.ini"], "git_node": "61def77268164fc6bedf55fa3b59e23ad902761d", "git_parents": ["804b2f9fd1d54aa63889273b78a741538857e55e"], "node": "d910e96c986fbb7fd7b6d527f1aa64d8f9cbbb82", "parents": ["be20824fb7a23f5f9b73dea64587209382345ed6"], "tags": []}, {"author": "Simon Pieters \u003czcorpan@gmail.com\u003e", "branch": "default", "desc": "Bug 2071487 [wpt PR 62516] - HTML: test CORS and the \u003clink\u003e stylesheet MIME type quirk, a=testonly\n\nAutomatic update from web-platform-tests\nHTML: test CORS and the \u003clink\u003e stylesheet MIME type quirk\n\nNo test set the `crossorigin` attribute on a style sheet with a bad MIME\ntype, so nothing distinguished the quirk's same-origin condition from its\nCORS-same-origin condition. A CORS-enabled cross-origin style sheet is\nCORS-same-origin, but its response's URL is not same origin with the\ndocument, so the quirk must not apply to it, and a redirect that crosses\norigins in either direction decides whether it applies.\n\nAlso add a `cors` knob to `resources/css.py`, and trim the spec text quoted\nin two existing tests.\n\nFor https://github.com/whatwg/html/pull/12468.\n\n--\nCSS: test the @import MIME type quirk with cross-origin responses\n\nSafari applies the quirk to a cross-origin redirect to a same-origin\nresponse, which is not CORS-same-origin.\n\n--\n\nwpt-commits: a7a59f41e4aa84bed8a634c75e1d041bbb1dc4e6, 04180c9d23fbc63b5aa26ed1aa107493a10365f8\nwpt-pr: 62516\n", "files": ["testing/web-platform/tests/css/css-cascade/import-mime-type-quirks.html", "testing/web-platform/tests/css/css-cascade/resources/quirks-mime-type.css", "testing/web-platform/tests/css/cssom/stylesheet-cross-origin-redirect-quirks.sub.html", "testing/web-platform/tests/html/semantics/document-metadata/the-link-element/link-style-data-url-quirks.html", "testing/web-platform/tests/html/semantics/document-metadata/the-link-element/link-style-quirks-crossorigin.html", "testing/web-platform/tests/html/semantics/document-metadata/the-link-element/resources/css.py"], "git_node": "f11d1d0ac5a81a55fb796485b55cc8637691574e", "git_parents": ["61def77268164fc6bedf55fa3b59e23ad902761d"], "node": "c8ee066a4ad878cb9641ee6f13bfd23efff459d3", "parents": ["d910e96c986fbb7fd7b6d527f1aa64d8f9cbbb82"], "tags": []}, {"author": "Blink WPT Bot \u003cblink-w3c-test-autoroller@chromium.org\u003e", "branch": "default", "desc": "Bug 2075115 [wpt PR 62929] - Fix duplicated and malformed attributes in WPTs, a=testonly\n\nAutomatic update from web-platform-tests\nFix duplicated and malformed attributes in WPTs (#62929)\n\nRemove duplicate attributes ignored by the HTML parser, merging class\nand style values where both are intended.\n\nFix an unterminated metadata quote that consumes the viewport tag,\nremove stray attributes from the grid-gap test and its reference, and\ncorrect quoting in XHR test metadata.\n\nBug: 542686202\nChange-Id: I66d4610ca2b8b910be2c66a2b3899eb240da49ce\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8220791\nReviewed-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Jacques Newman \u003cjanewman@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1703956}\n\nCo-authored-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\n--\n\nwpt-commits: d0e58242b68ca8513bb2375e2d00c147cd7481b9\nwpt-pr: 62929\n", "files": ["testing/web-platform/tests/css/css-anchor-position/position-try-cascade.html", "testing/web-platform/tests/css/css-flexbox/flex-aspect-ratio-img-column-011.html", "testing/web-platform/tests/css/css-gaps/grid/grid-gap-decorations-067-ref.html", "testing/web-platform/tests/css/css-gaps/grid/grid-gap-decorations-067.html", "testing/web-platform/tests/css/css-grid/grid-items/grid-intrinsic-maximums-ref.html", "testing/web-platform/tests/css/css-multicol/getclientrects-005.html", "testing/web-platform/tests/css/css-multicol/getclientrects-006.html", "testing/web-platform/tests/css/css-multicol/getclientrects-007.html", "testing/web-platform/tests/css/css-overflow/scroll-markers/scroll-marker-005.html", "testing/web-platform/tests/css/css-overflow/scrollable-overflow-transform-005.tentative.html", "testing/web-platform/tests/css/css-overflow/scrollable-overflow-transform-007.html", "testing/web-platform/tests/css/css-overflow/scrollable-overflow-transform-010.tentative.html", "testing/web-platform/tests/css/selectors/invalidation/nth-child-when-sibling-changes.html", "testing/web-platform/tests/css/selectors/invalidation/nth-last-child-when-sibling-changes.html", "testing/web-platform/tests/mathml/presentation-markup/mrow/inferred-mrow-baseline.html", "testing/web-platform/tests/pointerevents/compat/pointerevent_touch-action-verification.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-order-with-slots.html", "testing/web-platform/tests/shadow-dom/focus-navigation/reading-flow/tentative/grid-order.html", "testing/web-platform/tests/svg/geometry/reftests/circle-calc-dynamic-viewport-ref.html", "testing/web-platform/tests/xhr/send-redirect-post-upload.htm"], "git_node": "d5c9d740601151719d54034ba4aaec1b0ff97d2a", "git_parents": ["f11d1d0ac5a81a55fb796485b55cc8637691574e"], "node": "ba171619f17391407a810c784cbe2e8a85fcd9c9", "parents": ["c8ee066a4ad878cb9641ee6f13bfd23efff459d3"], "tags": []}, {"author": "Seokho Song \u003cseokho@chromium.org\u003e", "branch": "default", "desc": "Bug 2071479 [wpt PR 62626] - Make ContainerQueryListController a Document supplement, a=testonly\n\nAutomatic update from web-platform-tests\nMake ContainerQueryListController a Document supplement\n\nFollow-up to [1]. Attach the controller to Document instead of\nLocalDOMWindow, so null check no longer need.\n\nAdded tests cover that matches and change events stay correct\nafter the target is adopted into another document.\n\n[1] https://chromium-review.googlesource.com/c/chromium/src/+/8255022/comment/616642a6_cd704fd3/\n\nBug: 40887402\nChange-Id: I33ea44db6d58776112dc37c0d8320af777940e66\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8374242\nCommit-Queue: Seokho Song \u003cseokho@chromium.org\u003e\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1701551}\n\n--\n\nwpt-commits: 761562aa00bda23a23e67198a7a2dce561297af1\nwpt-pr: 62626\n", "files": ["testing/web-platform/tests/css/css-conditional/match-container-change-event.tentative.html", "testing/web-platform/tests/css/css-conditional/match-container.tentative.html"], "git_node": "688b38644a4abf1bcd62d31aa2972aaae43a7d4b", "git_parents": ["d5c9d740601151719d54034ba4aaec1b0ff97d2a"], "node": "25f725e43ce22150f3b7a510f4e904ac499ed532", "parents": ["ba171619f17391407a810c784cbe2e8a85fcd9c9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071479 [wpt PR 62626] - Update wpt metadata, a=testonly\n\nwpt-pr: 62626\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/container-queries/whitespace-update-after-removal.html.ini", "testing/web-platform/meta/css/css-conditional/match-container-change-event.tentative.html.ini", "testing/web-platform/meta/css/css-conditional/match-container.tentative.html.ini"], "git_node": "bc0d198b5b906f6626db2911484f8c41635edb17", "git_parents": ["688b38644a4abf1bcd62d31aa2972aaae43a7d4b"], "node": "1b173429daa81af70d64b5cab613af54e7f14656", "parents": ["25f725e43ce22150f3b7a510f4e904ac499ed532"], "tags": []}, {"author": "Fernando Fiori \u003cffiori@microsoft.com\u003e", "branch": "default", "desc": "Bug 2075173 [wpt PR 62934] - Add missing closing angle brackets to CSS WPT tags, a=testonly\n\nAutomatic update from web-platform-tests\nAdd missing closing angle brackets to CSS WPT tags\n\nA number of exported tests have a start or end tag whose \"\u003e\" was left\nout. The tokenizer keeps consuming past the end of the line, so the\nfollowing element is absorbed into the unterminated tag as a bogus\nattribute and never appears in the DOM.\n\nTerminate the offending tags so the parsed DOM matches the source.\n\nBug: 542686202\nChange-Id: Ie2a51a1502b7443738129eb2e8862156fe058341\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8226467\nReviewed-by: Fernando Fiori \u003cffiori@microsoft.com\u003e\nAuto-Submit: Fernando Fiori \u003cffiori@microsoft.com\u003e\nCommit-Queue: Fernando Fiori \u003cffiori@microsoft.com\u003e\nReviewed-by: Javier Fernandez \u003cjfernandez@igalia.com\u003e\nCr-Commit-Position: refs/heads/main@{#1704425}\n\n--\n\nwpt-commits: 7efa3ab5de117cfd01ac23b65a7ab58d43397238\nwpt-pr: 62934\n", "files": ["testing/web-platform/tests/css/CSS2/text/bidi-span-003-ref.html", "testing/web-platform/tests/css/css-contain/contain-inline-size-grid-indefinite-height-min-height-flex-row.html", "testing/web-platform/tests/css/css-flexbox/alignment/flex-align-baseline-column-rtl-direction.html", "testing/web-platform/tests/css/css-flexbox/anonymous-flex-item-restyle.html", "testing/web-platform/tests/css/css-grid/abspos/grid-abspos-staticpos-align-self-end-large-border-padding.html", "testing/web-platform/tests/css/css-grid/abspos/grid-abspos-staticpos-align-self-end.html", "testing/web-platform/tests/css/css-scroll-snap/scroll-snap-stop-002-nested.html", "testing/web-platform/tests/css/css-scroll-snap/scroll-snap-stop-002.html", "testing/web-platform/tests/css/css-text/line-breaking/line-breaking-atomic-008.html", "testing/web-platform/tests/css/css-text/white-space/trailing-ideographic-space-005.html", "testing/web-platform/tests/css/css-text/white-space/trailing-ideographic-space-006.html", "testing/web-platform/tests/css/css-text/white-space/trailing-ideographic-space-007.html", "testing/web-platform/tests/css/css-text/white-space/trailing-ideographic-space-008.html", "testing/web-platform/tests/css/css-text/white-space/trailing-ideographic-space-009.html", "testing/web-platform/tests/css/css-text/white-space/trailing-ideographic-space-010.html", "testing/web-platform/tests/css/css-transforms/transform-containing-block-and-scrolling-area-for-fixed.html", "testing/web-platform/tests/css/css-transforms/transform-containing-block-dynamic-1a.html", "testing/web-platform/tests/css/css-transforms/transform-containing-block-dynamic-1b.html", "testing/web-platform/tests/css/css-values/reference/viewport-page-print-no-ref.html", "testing/web-platform/tests/css/css-values/reference/viewport-page-print-ref.html", "testing/web-platform/tests/css/css-values/viewport-page-print.html", "testing/web-platform/tests/css/css-writing-modes/svg-aliasing-002.html"], "git_node": "de3f03cdee4d1088205ea137b926e8ff4bbb6131", "git_parents": ["bc0d198b5b906f6626db2911484f8c41635edb17"], "node": "ffe3bf6009cdc84ceb1aa57c91b1f0df7b0210e6", "parents": ["1b173429daa81af70d64b5cab613af54e7f14656"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075173 [wpt PR 62934] - Update wpt metadata, a=testonly\n\nwpt-pr: 62934\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/CSS2/text/__dir__.ini", "testing/web-platform/meta/css/CSS2/text/crashtests/bidi-inline-fragment-oof-crash.html.ini", "testing/web-platform/meta/css/css-contain/contain-crash.html.ini", "testing/web-platform/meta/css/css-values/if-invalidation.html.ini"], "git_node": "56baa575dae316b79760df75981159dab74f1b09", "git_parents": ["de3f03cdee4d1088205ea137b926e8ff4bbb6131"], "node": "be690c033fb35a4142dea7dbd39798947a0fca3b", "parents": ["ffe3bf6009cdc84ceb1aa57c91b1f0df7b0210e6"], "tags": []}, {"author": "Seokho Song \u003cseokho@chromium.org\u003e", "branch": "default", "desc": "Bug 2075476 [wpt PR 62954] - Implement ContainerQueryList move to another document's controller, a=testonly\n\nAutomatic update from web-platform-tests\nImplement ContainerQueryList move to another document's controller\n\nA ContainerQueryList is associated only with its element, and the\nspec's change steps run per Document:\n\n\u003e As part of [=update the rendering=], for each [=fully active=]\n\u003e {{Document}},\n\u003e ...\n\u003e for each {{element}} \u003cvar\u003eele\u003c/var\u003e in the {{Document}}, in\n\u003e [=tree order=],\n\u003e that has one or more associated {{ContainerQueryList}} objects\n\u003e ...\n\nWhen an element is adopted into another document (e.g. via\nappendChild()), its ContainerQueryLists currently remain in the old\ndocument's controller and are never evaluated by the new document's\nlifecycle, which is where the element now lives. They should move with\nthe element.\n\nThis CL adds that transfer in Element::DidMoveToNewDocument(). Since a\nlist's element can now always reach its current document's controller,\nthe no-controller check is no longer needed.\n\nSpec PR: https://github.com/w3c/csswg-drafts/pull/13551\n\nBug: 40887402\nChange-Id: Id152e56c671c500e0b02981bfc29874c97fa3fdf\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8424265\nReviewed-by: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nCommit-Queue: Seokho Song \u003cseokho@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1702558}\n\n--\n\nwpt-commits: 681ceb45b1ca9591f81b4235c46631268ae08c12\nwpt-pr: 62954\n", "files": ["testing/web-platform/tests/css/css-conditional/match-container-change-event.tentative.html"], "git_node": "1227138184c596a0f9a81ca37789b163ad70b610", "git_parents": ["56baa575dae316b79760df75981159dab74f1b09"], "node": "3dd520ad44b58e94d6440d825427ba30def3d9b4", "parents": ["be690c033fb35a4142dea7dbd39798947a0fca3b"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075476 [wpt PR 62954] - Update wpt metadata, a=testonly\n\nwpt-pr: 62954\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/css/css-conditional/match-container-change-event.tentative.html.ini"], "git_node": "d4cd1e01175bf