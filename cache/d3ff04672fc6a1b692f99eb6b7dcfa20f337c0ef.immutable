xtensions/newtab/test/jest/lib/ActivityStream.test.js", "browser/extensions/newtab/test/jest/lib/PrefsFeed.test.js", "testing/profiles/common/user.js", "testing/profiles/xpcshell/user.js"], "git_node": "e63b0703de42c9af899eba4867119aeb510839c4", "git_parents": ["9e973247cb6666eb32517d492d624ee8592beb39"], "node": "6a4ccf40bb0ad934b44dffb906c39f973f143149", "parents": ["88bf717250459488eddf28ed1cf04f58d9f888e5"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Bug 1995348 - Add some annotations for expected crashes\n", "files": ["testing/web-platform/meta/css/css-grid/grid-lanes/items/column-minimum-contribution-baseline-shim-vertical-rl.html.ini", "testing/web-platform/meta/css/css-grid/grid-lanes/items/row-minimum-contribution-baseline-shim.html.ini"], "git_node": "27b3e584fc7600117ebbf7b469fc86a2eff2cea4", "git_parents": ["e63b0703de42c9af899eba4867119aeb510839c4"], "node": "6307d0b00e7428da338a474fbecad56540e3c2c6", "parents": ["6a4ccf40bb0ad934b44dffb906c39f973f143149"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "7f101c4ab796d6b7d22a258bdd95b23e86c5d95c", "git_parents": ["27b3e584fc7600117ebbf7b469fc86a2eff2cea4", "9c0ad0c9084ef0e36d29aae83892ea4edf3c9085"], "node": "d64c8ea00ff92b0f65b0540f956253fabb30a45e", "parents": ["6307d0b00e7428da338a474fbecad56540e3c2c6", "4395e1fc5b2afa43b3f092cef1ccbf1556504967"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Extract the crashreporter symbols once per process. r=perftest-reviewers,mozbase-reviewers,ahal,kshampur\n\nWe were doing it once per test run, so e.g. 10x instead of 1x.\n\nLook the symbol directory up once per process instead. The extracted copy now\nbelongs to this module, which removes it at exit, so callers no longer pass a\nwork directory in.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327222\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py"], "git_node": "88ead587dddee65525aff29fecdf00d923a00d8b", "git_parents": ["7f101c4ab796d6b7d22a258bdd95b23e86c5d95c"], "node": "a464864eca407208931a96f1ff1b1b0271acd108", "parents": ["d64c8ea00ff92b0f65b0540f956253fabb30a45e"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Use .json.gz for gzipped profiles consistently. r=florian\n\nsaveProfileToUploadDir() writes either gzipped bytes (from\ngetProfileDataAsGzippedArrayBuffer) or plain JSON (from dumpProfileToFile\nat shutdown), but named both profile_\u003ctest\u003e.json.\n\nNow we use the right extension based on what's in the file. This is needed\nfor samply load to work correctly; samply only looks at the extension and\ndoesn't sniff the content.\n\nThe comments about Treeherder requiring \".json\" are no longer true; I landed\nchanges a few months ago so that profile artifacts are now just detected by\nhaving the file name start with the \"profile_\" prefix, the file extension is\nignored.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327223\n", "files": ["testing/modules/TestProfilerArtifact.sys.mjs", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "370f2e6234f8ad35bb17ad2ac99502b44dbb1bad", "git_parents": ["88ead587dddee65525aff29fecdf00d923a00d8b"], "node": "6bba015e30f14ebd93eb61506182a6cb65dad73b", "parents": ["a464864eca407208931a96f1ff1b1b0271acd108"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Stop parsing profile JSON in Python. r=perftest-reviewers,kshampur,canova\n\nThe python code no longer needs to look at the contents. Only samply and\nprofiler-edit actually need to look at the contents.\n\nThis saves a whole lot of ceremony around decompressing and compressing\nfiles.\n\nReplace symbolicate_profile(dict) with symbolicate_profile_file(in, out).\nprofiler-edit picks its output compression from the extension, so it now\nwrites the final artifact directly, next to the destination, and the swap\nis a same-filesystem os.replace(). That retires the cross-device\nshutil.move() fallback, the copy in and out, the temporary directories,\nand the MemoryError handlers.\n\nRaptor's profile archive names its entries after the collected profile, so\nit has been calling plain JSON \".json.gz\" for as long as browsertime has\nwritten \"geckoProfile-N.json.gz\". Now that the archived bytes come from a\nfile rather than json.dumps(), take the extension from that file: \".json\"\nfor the symbolicated profile, and the collected profile's own extension\nwhen symbolication failed and we archive it unchanged. samply and\nprofiler.firefox.com go by the extension and don't sniff the content.\n\nA failing profiler-edit is now detected by its exit status rather than\npassing silently, so log symbolication failures as warnings. mozharness\nfails the job on any ERROR or CRITICAL line, and symbolication is best\neffort: a profile too large for profiler-edit to serialize should not turn\na job orange when its tests passed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327224\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/__init__.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py", "testing/raptor/raptor/gecko_profile.py", "testing/raptor/test/test_gecko_profile.py", "testing/talos/talos/gecko_profile.py"], "git_node": "6d00498a129e13722089fcb1c0f8dae4da0699ec", "git_parents": ["370f2e6234f8ad35bb17ad2ac99502b44dbb1bad"], "node": "fc6f712060906a59c42ae4f0c645a46b971ec719", "parents": ["6bba015e30f14ebd93eb61506182a6cb65dad73b"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Terminate samply when symbolication fails. r=perftest-reviewers,mozbase-reviewers,ahal,kshampur\n\nsymbolicate_profile_file() runs samply as a symbol server and shuts it down\nonce profiler-edit has finished. Any excptions occurring in between would\nleave samply running.\n\nShut it down in a finally block. Also raise when samply exits without\nreporting a URL, rather than running profiler-edit against an empty symbol\nserver address.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327225\n", "files": ["testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/symbolication.py"], "git_node": "c561ed122b9867d987917cce0dcb9886e775b23b", "git_parents": ["6d00498a129e13722089fcb1c0f8dae4da0699ec"], "node": "2328b0c927d3b16e19dfea033a795c3ef02297e5", "parents": ["fc6f712060906a59c42ae4f0c645a46b971ec719"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073298 - Always gzip symbolicated profiles. r=perftest-reviewers,aglavic\n\nThis should get us smaller artifacts.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327226\n", "files": ["testing/mochitest/runtests.py", "testing/modules/TestProfilerArtifact.sys.mjs", "testing/mozbase/mozgeckoprofiler/mozgeckoprofiler/profiling.py", "testing/talos/talos/gecko_profile.py", "testing/xpcshell/runxpcshelltests.py"], "git_node": "b94ffe97209122cfd9a038f6622bad56e2c2a620", "git_parents": ["c561ed122b9867d987917cce0dcb9886e775b23b"], "node": "b325e6b1ae147d598ce53f8fa8e594ec7efc809c", "parents": ["2328b0c927d3b16e19dfea033a795c3ef02297e5"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2074860 - Migrate release, beta, and dev edition users out of JPEG XL labs r=nimbus-reviewers,ralkhulaidi,emcminn\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328708\n", "files": ["toolkit/components/nimbus/lib/Migrations.sys.mjs", "toolkit/components/nimbus/test/NimbusTestUtils.sys.mjs", "toolkit/components/nimbus/test/unit/test_Migrations.js"], "git_node": "d62e4cf489e59a84f6e84671d9def677808a6d38", "git_parents": ["b94ffe97209122cfd9a038f6622bad56e2c2a620"], "node": "3697bb39bf48ace4981d05478604b69d0b513781", "parents": ["b325e6b1ae147d598ce53f8fa8e594ec7efc809c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 1 - Add the `--disable-legacy-cargo-invocation` configure flag r=firefox-build-system-reviewers,sergesanspaille\n\nThis stack assembles the Cargo command line and environment in one place so a\nfuture backend can build Rust without the recursive Make recipes. This flag\nselects the new path, and the `MOZ_USE_LEGACY_CARGO_INVOCATION` environment\nvariable takes precedence over `--disable-legacy-cargo-invocation` to simplify\ndiffoscope testing.\n\nThe flag is temporary and will be removed with the legacy recursive Make Cargo\ninvocation path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316172\n", "files": ["moz.configure"], "git_node": "116b470b17cdd14ede6f10b3ad0dda6c8d27755d", "git_parents": ["d62e4cf489e59a84f6e84671d9def677808a6d38"], "node": "c7bcdbd9360f63b38f9fb5f7c2c3796ef53a01fd", "parents": ["3697bb39bf48ace4981d05478604b69d0b513781"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 2 - Add the Cargo command model and its serialized spec r=firefox-build-system-reviewers,sylvestre\n\nThe action and `./mach cargo` need one description of a Rust build edge and of\nthe configuration it reads. A spec carries only the substitutions in\n`CARGO_CONFIG_KEYS`, so an unrelated configure change does not invalidate every\nRust edge, and `CargoConfig` raises on a read of anything else, so an undeclared\nread fails instead of returning nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323817\n", "files": ["python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_rust_commands.py"], "git_node": "daffb8fa3be509cff5ad9ebe0d2c812d7595e2ad", "git_parents": ["116b470b17cdd14ede6f10b3ad0dda6c8d27755d"], "node": "937144acd5fd709b3f56a84dbb8b94249ecca9da", "parents": ["c7bcdbd9360f63b38f9fb5f7c2c3796ef53a01fd"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 3 - Compose the environment a Cargo build edge runs in r=firefox-build-system-reviewers,sergesanspaille\n\nTwo behaviors differ from the make path. Each edge gets its own macOS\n`-object_path_lto` directory, where `$(@F)` expanded to nothing inside a target\nspecific `:=` and every edge shared one. A configured empty `PKG_CONFIG_PATH`\nclears an inherited value, which a sysroot build needs and which `autoconf.mk`\ndropped by omitting empty substitutions.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316173\n", "files": ["python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/test_rust_commands.py"], "git_node": "fca0c6af2f65e408fb983dd5aadb2ec7928d97bc", "git_parents": ["daffb8fa3be509cff5ad9ebe0d2c812d7595e2ad"], "node": "69bb137cdc9eb3465752985364cf0307e44abbef", "parents": ["937144acd5fd709b3f56a84dbb8b94249ecca9da"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 4 - Compose the Cargo command line for a build edge r=firefox-build-system-reviewers,sylvestre\n\n`CARGO_RUSTCFLAGS` from the environment is appended after the derived flags on\nthe library and program edges. `rust.mk` put it before them, so a repeated `-C`\noption now takes the value from the environment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323818\n", "files": ["python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/test_rust_commands.py"], "git_node": "0d47c016702edd12924e46d9a57d507247c14b50", "git_parents": ["fca0c6af2f65e408fb983dd5aadb2ec7928d97bc"], "node": "a63251ba0ca8045aa78885afd74232ac596f15ff", "parents": ["69bb137cdc9eb3465752985364cf0307e44abbef"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 5 - Compose the `./mach cargo` command line for a build edge r=firefox-build-system-reviewers,sylvestre\n\nA developer command shares the build flags and target selection of the edge it\nruns against. A plugin subcommand that supplies its own flags gets neither\nthose nor `-j`, because it may not accept them. `rust.mk` kept `--lib`, `--bin`\nand the features for host edges. No `./mach cargo` root has a host edge, so\ndropping them changes nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323819\n", "files": ["python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/test_rust_commands.py"], "git_node": "3891c6c9272fbcb24caf6a5c152f46c4011ecdff", "git_parents": ["0d47c016702edd12924e46d9a57d507247c14b50"], "node": "0c79fbcb2538f63138ddfaa5c3732d9395a34330", "parents": ["a63251ba0ca8045aa78885afd74232ac596f15ff"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 6 - Add the `run_cargo` action r=firefox-build-system-reviewers,sergesanspaille\n\nAdd the `run_cargo` action. It reads a serialized `CargoCommand` spec, composes\nthe arguments and environment through `rust_commands`, and runs Cargo. It keeps\nthe jobserver file descriptors open so Cargo can use Make's jobserver. Under\n`BUILD_VERBOSE_LOG` it prints the composed command line, so a build log shows\nthe Cargo invocation. Nothing invokes it yet.\n\nCargo names a program's PDB after its crate, with underscores, so the action\ncopies it to the program's name, which is what the PDB install looks for. The\ncopy is made only when the crate's PDB is newer, and whether or not\n`MOZ_COPY_PDBS` is set.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316174\n", "files": ["python/mozbuild/mozbuild/action/run_cargo.py", "python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/action/test_run_cargo.py", "python/mozbuild/mozbuild/test/python.toml"], "git_node": "bb306be73ab72b82b3e57ad39b4e1ec92ff9ab09", "git_parents": ["3891c6c9272fbcb24caf6a5c152f46c4011ecdff"], "node": "f76d50f686e40be0942e3d615b68ada12bb30fa5", "parents": ["0c79fbcb2538f63138ddfaa5c3732d9395a34330"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 7 - Emit Cargo command specs for Rust edges from the common backend r=firefox-build-system-reviewers,sergesanspaille\n\nThe per directory compile and link flags depend on each directory's `moz.build`,\nso the specs are written in `consume_finished`, once every `ComputedFlags`\nobject has been seen.\n\nThe `RUST_LIBRARY_LTO` decision the recipe reads comes from the same\n`applies_library_lto` the Cargo command uses, so the networking check and the\n`-Clto` flag cannot disagree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316175\n", "files": ["python/mozbuild/mozbuild/backend/common.py", "python/mozbuild/mozbuild/backend/recursivemake.py", "python/mozbuild/mozbuild/test/backend/common.py", "python/mozbuild/mozbuild/test/backend/data/rust-library-flags/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-library-flags/moz.build", "python/mozbuild/mozbuild/test/backend/data/rust-megazord-library/Cargo.toml", "python/mozbuild/mozbuild/test/backend/data/rust-megazord-library/moz.build", "python/mozbuild/mozbuild/test/backend/test_recursivemake.py"], "git_node": "e21e740c253552348ab8cd0a2c932ea9ba135106", "git_parents": ["bb306be73ab72b82b3e57ad39b4e1ec92ff9ab09"], "node": "30809569c8b049e86c59187afc829203f106529f", "parents": ["f76d50f686e40be0942e3d615b68ada12bb30fa5"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 8 - Run `./mach cargo` commands through `rust_commands.py` when `MOZ_USE_LEGACY_CARGO_INVOCATION` is false r=firefox-build-system-reviewers,sergesanspaille\n\nWith `rust_commands.py` and the specs in place, `./mach cargo` composes and\nruns its Cargo commands through them when `MOZ_USE_LEGACY_CARGO_INVOCATION` is\nfalse. It loads each crate's spec, adds the requested subcommand, features and\ntrailing arguments, and runs Cargo in the crate's directory.\n\nA build edge inherits the configured `PATH` from the build, which carries the\nRust search path and the xcrun shim. `./mach cargo` runs outside the build, so\nit sets that `PATH` itself from the configure substitutions. The `PATH` is not\npart of the spec, so it stays out of the inputs of every build edge.\n\nThe legacy recursive Make path stays the default for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316176\n", "files": ["python/mozbuild/mozbuild/mach_commands.py", "python/mozbuild/mozbuild/rust_commands.py", "python/mozbuild/mozbuild/test/python.toml", "python/mozbuild/mozbuild/test/test_mach_cargo.py", "python/mozbuild/mozbuild/test/test_rust_commands.py"], "git_node": "0f355084c46e2567b9ea4b1b3b8ea6a6042d7b0a", "git_parents": ["e21e740c253552348ab8cd0a2c932ea9ba135106"], "node": "e09425ae14146ad35e255edfe9674e2f0a1a0870", "parents": ["30809569c8b049e86c59187afc829203f106529f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 9 - Wire up the `run_cargo` action so it runs when `MOZ_USE_LEGACY_CARGO_INVOCATION` is false r=firefox-build-system-reviewers,sergesanspaille\n\nAdd an `ifdef MOZ_USE_LEGACY_CARGO_INVOCATION` branch to the Rust library,\nprogram, host, and test recipes. When the variable is unset, the recipes invoke\n`run_cargo` with the corresponding Cargo command spec.\n\nA make run with neither `-j` nor a jobserver passes `--single-job`, so a plain\nserial `make` in a Rust directory runs Cargo with one job. The legacy path\nlimited Cargo only for an explicit `-j1`.\n\nThe legacy recursive Make path stays the default for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D316177\n", "files": ["config/makefiles/rust.mk"], "git_node": "2cd096740308829a58a40fcc628126ce67299972", "git_parents": ["0f355084c46e2567b9ea4b1b3b8ea6a6042d7b0a"], "node": "4b04f6bdaed097ed8a15edcc2188d85583b05922", "parents": ["e09425ae14146ad35e255edfe9674e2f0a1a0870"], "tags": []}, {"author": "scottdowne \u003csdowne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075682 - Drop newtab_content variant_id and source_section_id below 158. r=ini\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329269\n", "files": ["browser/extensions/newtab/lib/NewTabContentPing.sys.mjs"], "git_node": "f18fb30f923fab7ab59e9b10a5040fffba58527a", "git_parents": ["2cd096740308829a58a40fcc628126ce67299972"], "node": "bcb13f0f153f0e9dff782eff515a5349fb83c3a0", "parents": ["4b04f6bdaed097ed8a15edcc2188d85583b05922"], "tags": []}, {"author": "Dre Grant \u003cdgrant@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074282 - Load saved wallpapers directly from the wallpaper library. r=mconley\n\nNew Tab used to copy the active wallpaper out of the library and send thumbnail data to each page because the wallpaper URL could not load library files. Firefox 158 can load them directly, so this patch uses the saved files for both the active wallpaper and picker previews while keeping older URLs working when the library is off.\n\nThe picker now uses lazy loaded images instead of full size CSS backgrounds. In a 100 image test, memory use fell from 222 MB to 56.8 MB. Opening the picker also refreshes the library so pages restored from the startup cache show current images.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328628\n", "files": ["browser/components/backup/tests/marionette/test_backup.py", "browser/extensions/newtab/common/Actions.mjs", "browser/extensions/newtab/common/Reducers.sys.mjs", "browser/extensions/newtab/content-src/components/WallpaperCategories/WallpaperCategories.jsx", "browser/extensions/newtab/content-src/components/WallpaperCategories/_WallpaperCategories.scss", "browser/extensions/newtab/lib/Wallpapers/WallpaperFeed.sys.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperFileNames.mjs", "browser/extensions/newtab/lib/Wallpapers/WallpaperThemeUtils.mjs", "browser/extensions/newtab/test/jest/content-src/components/WallpaperCategories/WallpaperCategories.test.jsx", "browser/extensions/newtab/test/jest/lib/Wallpapers/WallpaperThemeUtils.test.js", "browser/extensions/newtab/test/xpcshell/test_WallpaperFeed.js"], "git_node": "426fea0d8599c1867e30c1fc1da89b1a443f2f9a", "git_parents": ["f18fb30f923fab7ab59e9b10a5040fffba58527a"], "node": "a86091c030dd01fc6ebf926eb07cd32f8b4b964b", "parents": ["bcb13f0f153f0e9dff782eff515a5349fb83c3a0"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 1922759 - Make nr_crypto_nss_hmac() work with FIPS enabled r=rrelyea,webrtc-reviewers,keeler,bwc\n\nHMAC is used for hash calculation only at nr_crypto_nss_hmac() so use derive instead of import to be FIPS compliant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D224587\n", "files": ["dom/media/webrtc/transport/nricectx.cpp"], "git_node": "4b7468cc256adfca3acb28c9115f75dbca502e28", "git_parents": ["426fea0d8599c1867e30c1fc1da89b1a443f2f9a"], "node": "069d3072d3c74fd3563b1eb67fc24796e35e1a54", "parents": ["a86091c030dd01fc6ebf926eb07cd32f8b4b964b"], "tags": []}, {"author": "Martin Sirringhaus \u003cmartin.sirringhaus@suse.com\u003e", "branch": "default", "desc": "Bug 1797270 - Make WebRTC work with FIPS enabled r=keeler,webrtc-reviewers,kershaw,bwc,webidl,smaug,ipc-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D225034\n", "files": ["dom/crypto/WebCryptoTask.cpp", "dom/crypto/WebCryptoTask.h", "dom/media/gtest/TestRTCCertStore.cpp", "dom/media/gtest/moz.build", "dom/media/webrtc/MediaTransportParent.h", "dom/media/webrtc/PMediaTransport.ipdl", "dom/media/webrtc/PRTCCertService.ipdl", "dom/media/webrtc/RTCCertCleanupTimer.cpp", "dom/media/webrtc/RTCCertCleanupTimer.h", "dom/media/webrtc/RTCCertService.cpp", "dom/media/webrtc/RTCCertService.h", "dom/media/webrtc/RTCCertServiceChild.h", "dom/media/webrtc/RTCCertServiceData.cpp", "dom/media/webrtc/RTCCertServiceData.h", "dom/media/webrtc/RTCCertServiceParent.cpp", "dom/media/webrtc/RTCCertServiceParent.h", "dom/media/webrtc/RTCCertStore.cpp", "dom/media/webrtc/RTCCertStore.h", "dom/media/webrtc/RTCCertificate.cpp", "dom/media/webrtc/RTCCertificate.h", "dom/media/webrtc/WebrtcIPCTraits.h", "dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/jsapi/MediaTransportHandler.h", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.cpp", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.h", "dom/media/webrtc/jsapi/MediaTransportParent.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/moz.build", "dom/media/webrtc/tests/mochitests/identity/mochitest.toml", "dom/media/webrtc/tests/mochitests/identity/mochitest_no_socket_process.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_certificates.html", "dom/media/webrtc/transport/build/moz.build", "dom/media/webrtc/transport/common.build", "dom/media/webrtc/transport/dtlsdigest.cpp", "dom/media/webrtc/transport/dtlsdigest.h", "dom/media/webrtc/transport/dtlsidentity.cpp", "dom/media/webrtc/transport/dtlsidentity.h", "dom/media/webrtc/transport/test/transport_unittests.cpp", "dom/media/webrtc/transport/transportlayerdtls.cpp", "dom/media/webrtc/transport/transportlayerdtls.h", "dom/tests/mochitest/whatwg/test_structuredCloneAndExposed.html", "dom/webidl/RTCCertificate.webidl", "ipc/glue/BackgroundParentImpl.cpp", "media/webrtc/signaling/gtest/mediapipeline_unittest.cpp", "netwerk/ipc/PSocketProcessBridge.ipdl", "netwerk/ipc/SocketProcessBridgeChild.cpp", "netwerk/ipc/SocketProcessBridgeParent.cpp", "netwerk/ipc/SocketProcessBridgeParent.h"], "git_node": "b42e262b34314e4425b2f07088fa0f2a4326ad67", "git_parents": ["4b7468cc256adfca3acb28c9115f75dbca502e28"], "node": "a9f9adb465b33a41d9137b4e0d852d4db897afa5", "parents": ["069d3072d3c74fd3563b1eb67fc24796e35e1a54"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 1797270, 1922759: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["dom/media/webrtc/jsapi/MediaTransportHandler.cpp"], "git_node": "112345729be49a69f4965d4248ef9f6739f920b2", "git_parents": ["b42e262b34314e4425b2f07088fa0f2a4326ad67"], "node": "df700867c8f90bff6bb56a51e10781fb5b54c50d", "parents": ["a9f9adb465b33a41d9137b4e0d852d4db897afa5"], "tags": []}, {"author": "Drew Willcoxon \u003cadw@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074379 - Use --link-color for favicon badges in the urlbar view. r=dao,desktop-theme-reviewers,urlbar-reviewers\n\nWhen the row isn't selected, use `--link-color` as the fill. That's the same\ncolor that URLs and explanation text in the view use, which is the desired color\naccording to Paul.\n\nWhen the row is selected, the existing `fill: currentColor` rule on the row is\nactive, which ensures the badge will have the same color as the row's text when\nthe row is selected:\n\nhttps://searchfox.org/firefox-main/rev/9e9b5f17f56187c1f5c8b9cdf79a01ff51a7b643/browser/themes/shared/urlbar/view-nova.css#149\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328685\n", "files": ["browser/themes/shared/urlbar/view-nova.css"], "git_node": "3d978752ca8cb4a9d991eb3c91929f95e8a6e88a", "git_parents": ["112345729be49a69f4965d4248ef9f6739f920b2"], "node": "aad7fd4f1bc28159f547b3bcb59b514ba2150fbd", "parents": ["df700867c8f90bff6bb56a51e10781fb5b54c50d"], "tags": []}, {"author": "Michael Hynson \u003cmhynson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071294 - Fix misaligned tab group border for vertical split view tabs in compact mode r=desktop-theme-reviewers,tabbrowser-reviewers,kcochrane\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329108\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "a86f6db020b3b63d47e8e1a5deab300c6f1121cf", "git_parents": ["3d978752ca8cb4a9d991eb3c91929f95e8a6e88a"], "node": "2a14059f4a720191e22cfcc8e71eba639fcf2d18", "parents": ["aad7fd4f1bc28159f547b3bcb59b514ba2150fbd"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2073524 - Also fetch the crashreporter symbols for extra profiler runs. r=taskgraph-reviewers,perftest-reviewers,bhearsum,kshampur\n\nadd_gecko_profile_symbolication_deps keyed off --gecko-profile alone, which\nmisses Raptor's extra profiler run. That run profiles every perf task by\ndefault, and its --extra-profiler-run comes from the task's mozharness\nextra-options rather than from a try config or a profiling variant, so the\ntransform skipped those tasks.\n\nThey still fetched samply and profiler-node-tools, because the browsertime\nkinds list those toolchains unconditionally, so only the symbols were\nmissing. Symbolication then fell back to symbols.mozilla.org, which has\nnothing for a try build, and samply resolved names from the binaries on disk\ninstead. That yields function names but no file, line or inline frames, so\nthe profiles showed \"libxul.so\" where a source file belongs.\n\nMatch --extra-profiler-run as well. Tests driving another browser only ever\nprofile that browser, so skip the symbols zip for them rather than\ndownloading half a gigabyte for nothing.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327382\n", "files": ["taskcluster/gecko_taskgraph/transforms/test/other.py"], "git_node": "d240fd1390d9ef667dd5d76dac61895158d4a824", "git_parents": ["a86f6db020b3b63d47e8e1a5deab300c6f1121cf"], "node": "c8964db6f165411e50fd47f31a39a0eb1c185f66", "parents": ["2a14059f4a720191e22cfcc8e71eba639fcf2d18"], "tags": []}, {"author": "Yubin Jamora \u003cyjamora@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060584 - Add Telemetry for SW Agent /command r=ngrato,urlbar-reviewers,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328209\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/modules/AgentCommands.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "7b51efbba9068a53e1c50c55946a1ddc293ffe1f", "git_parents": ["d240fd1390d9ef667dd5d76dac61895158d4a824"], "node": "bd6884db4111a463ee9b946dd9b74bd7b98ea044", "parents": ["c8964db6f165411e50fd47f31a39a0eb1c185f66"], "tags": []}, {"author": "Ben Visness \u003cbvisness@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074451: Implement component name annotation validation. r=rhunt\n\nAdds validation for [constructor], [method], [static], [get], and [set]\nfunctions in the component model.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328650\n", "files": ["js/src/jit-test/tests/wasm/components/name-validation.js", "js/src/jit-test/tests/wasm/components/names.js", "js/src/jit-test/tests/wasm/components/strongly-unique.js", "js/src/wasm/WasmComponent.cpp", "js/src/wasm/WasmComponent.h", "js/src/wasm/WasmValidate.cpp"], "git_node": "b9e41fbd4d7ad6922465811ffd85eb6a6152ef02", "git_parents": ["7b51efbba9068a53e1c50c55946a1ddc293ffe1f"], "node": "96086de81753982e999b2c649cc0094a2daf0319", "parents": ["bd6884db4111a463ee9b946dd9b74bd7b98ea044"], "tags": []}, {"author": "Emily Wachowiak \u003cewachowiak@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075331 - Update Firefox View toolbar button tooltip text. r=fluent-reviewers,bolsson\n\nRenames toolbar-button-firefox-view-2 to toolbar-button-firefox-view-3 and\nupdates the tooltiptext to reflect the feature's content more accurately.\n\nbrowser/locales/en-US/browser/firefoxView.ftl\n  toolbar-button-firefox-view-3 (renamed from -2):\n    .tooltiptext: \"View recent browsing across windows and devices\"\n                \u2192 \"Tabs and browsing history across devices\"\n\nbrowser/components/customizableui/CustomizableWidgets.sys.mjs\n  l10nId: \"toolbar-button-firefox-view-2\" \u2192 \"toolbar-button-firefox-view-3\"\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328931\n", "files": ["browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/locales/en-US/browser/firefoxView.ftl"], "git_node": "c9d962335a9609d6fb5f503f79319d1912cd8198", "git_parents": ["b9e41fbd4d7ad6922465811ffd85eb6a6152ef02"], "node": "fc94618c81d69f54a99b67860bd42987fbfb2359", "parents": ["96086de81753982e999b2c649cc0094a2daf0319"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075709 - Make :ahochheiden module owner of `Core: Build Config - Fenix`; add :tcampbell as peer. r=ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329297\n", "files": ["mots.yaml"], "git_node": "6c35880999e9ecc6de5f22f2257172f7a692c6b8", "git_parents": ["c9d962335a9609d6fb5f503f79319d1912cd8198"], "node": "72f4ff9e386ba169764469614447d9fa54f508ad", "parents": ["fc94618c81d69f54a99b67860bd42987fbfb2359"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075709 - Post: Remove :nalexander as peer from some modules. r=ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329298\n", "files": ["mots.yaml"], "git_node": "c5073ec41830192843cf2a8af8cd4c5864bd3ae5", "git_parents": ["6c35880999e9ecc6de5f22f2257172f7a692c6b8"], "node": "4d9ec80a42eda1245112520b36d601090d52c276", "parents": ["72f4ff9e386ba169764469614447d9fa54f508ad"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075711 - Resolve fetched liblzma via DYLD_FALLBACK_LIBRARY_PATH in build-cpython.sh on x86_64 macOS. r=markco\n\nThe fetched xz bakes a /xz/lib install name. On the host-openssl branch the\nbuild-time _lzma import only worked on macOS 10.15 because dyld fell back to\nthe system /usr/lib/liblzma.5.dylib, which macOS 11+ no longer ships. Set the\nsame fallback path the fetched-openssl branch already uses.\n\nhttps://mozilla-hub.atlassian.net/browse/RELOPS-2594?focusedCommentId=1775183\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329299\n", "files": ["taskcluster/scripts/misc/build-cpython.sh"], "git_node": "1f6da2cdccccbfb61baeaf5e5d3b07cc64841e7d", "git_parents": ["c5073ec41830192843cf2a8af8cd4c5864bd3ae5"], "node": "c97bed17d840d642b166db17573779dc63f25fdc", "parents": ["4d9ec80a42eda1245112520b36d601090d52c276"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073363 - Add moz-toggle disabled tokens to make it visually apparent in High Contrast Mode r=reusable-components-reviewers,mkennedy,emilio,desktop-theme-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327499\n", "files": ["toolkit/content/widgets/moz-toggle/moz-toggle.css", "toolkit/content/widgets/moz-toggle/moz-toggle.nova.tokens.json", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.css", "toolkit/content/widgets/moz-toggle/moz-toggle.tokens.json", "toolkit/themes/shared/design-system/dist/semantic-categories.mjs", "toolkit/themes/shared/design-system/dist/tokens-figma-theme.json", "toolkit/themes/shared/design-system/dist/tokens-table.mjs"], "git_node": "3e34bf84f3a87f2f6c190797ec166af05e40a604", "git_parents": ["1f6da2cdccccbfb61baeaf5e5d3b07cc64841e7d"], "node": "a30282fb4de2717ce9a8a53aa3f1ebeffecd0eb3", "parents": ["c97bed17d840d642b166db17573779dc63f25fdc"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1797270, Bug 1922759: apply code formatting via Lando\" for causing build bustages @ RTCCertificate.h\n\nThis reverts commit 112345729be49a69f4965d4248ef9f6739f920b2.\n\nRevert \"Bug 1797270 - Make WebRTC work with FIPS enabled r=keeler,webrtc-reviewers,kershaw,bwc,webidl,smaug,ipc-reviewers\"\n\nThis reverts commit b42e262b34314e4425b2f07088fa0f2a4326ad67.\n\nRevert \"Bug 1922759 - Make nr_crypto_nss_hmac() work with FIPS enabled r=rrelyea,webrtc-reviewers,keeler,bwc\"\n\nThis reverts commit 4b7468cc256adfca3acb28c9115f75dbca502e28.\n", "files": ["dom/crypto/WebCryptoTask.cpp", "dom/crypto/WebCryptoTask.h", "dom/media/gtest/TestRTCCertStore.cpp", "dom/media/gtest/moz.build", "dom/media/webrtc/MediaTransportParent.h", "dom/media/webrtc/PMediaTransport.ipdl", "dom/media/webrtc/PRTCCertService.ipdl", "dom/media/webrtc/RTCCertCleanupTimer.cpp", "dom/media/webrtc/RTCCertCleanupTimer.h", "dom/media/webrtc/RTCCertService.cpp", "dom/media/webrtc/RTCCertService.h", "dom/media/webrtc/RTCCertServiceChild.h", "dom/media/webrtc/RTCCertServiceData.cpp", "dom/media/webrtc/RTCCertServiceData.h", "dom/media/webrtc/RTCCertServiceParent.cpp", "dom/media/webrtc/RTCCertServiceParent.h", "dom/media/webrtc/RTCCertStore.cpp", "dom/media/webrtc/RTCCertStore.h", "dom/media/webrtc/RTCCertificate.cpp", "dom/media/webrtc/RTCCertificate.h", "dom/media/webrtc/WebrtcIPCTraits.h", "dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/jsapi/MediaTransportHandler.h", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.cpp", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.h", "dom/media/webrtc/jsapi/MediaTransportParent.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/moz.build", "dom/media/webrtc/tests/mochitests/identity/mochitest.toml", "dom/media/webrtc/tests/mochitests/identity/mochitest_no_socket_process.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_certificates.html", "dom/media/webrtc/transport/build/moz.build", "dom/media/webrtc/transport/common.build", "dom/media/webrtc/transport/dtlsdigest.cpp", "dom/media/webrtc/transport/dtlsdigest.h", "dom/media/webrtc/transport/dtlsidentity.cpp", "dom/media/webrtc/transport/dtlsidentity.h", "dom/media/webrtc/transport/nricectx.cpp", "dom/media/webrtc/transport/test/transport_unittests.cpp", "dom/media/webrtc/transport/transportlayerdtls.cpp", "dom/media/webrtc/transport/transportlayerdtls.h", "dom/tests/mochitest/whatwg/test_structuredCloneAndExposed.html", "dom/webidl/RTCCertificate.webidl", "ipc/glue/BackgroundParentImpl.cpp", "media/webrtc/signaling/gtest/mediapipeline_unittest.cpp", "netwerk/ipc/PSocketProcessBridge.ipdl", "netwerk/ipc/SocketProcessBridgeChild.cpp", "netwerk/ipc/SocketProcessBridgeParent.cpp", "netwerk/ipc/SocketProcessBridgeParent.h"], "git_node": "fb37e70ccbfde0112af58b1905def54c7524d464", "git_parents": ["3e34bf84f3a87f2f6c190797ec166af05e40a604"], "node": "9ed400267ef02ee621277b8a8db81d10cde983f8", "parents": ["a30282fb4de2717ce9a8a53aa3f1ebeffecd0eb3"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2027882 - Remove `nimbus-fml` and `embedded-uniffi-bindgen` deps from `onnx` toolchains. r=ahochheiden\n\nThey're not used, and this makes `onnx` toolchains depend on\n`Cargo.lock`, ultimately making any Rust change fail to find upstream\ntoolchains.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329284\n", "files": ["taskcluster/kinds/toolchain/onnx.yml"], "git_node": "c3eb4ff1379e92826283daa8252b80330c6a60a4", "git_parents": ["fb37e70ccbfde0112af58b1905def54c7524d464"], "node": "cef375faaf45cfdb81ac5183950faf5e0fbb79df", "parents": ["9ed400267ef02ee621277b8a8db81d10cde983f8"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009747 - Patch 1 - Replace the deprecated NSSharingService enumeration with NSSharingServicePicker. r=mac-reviewers,fluent-reviewers,desktop-theme-reviewers,hjones,bradwerth,bolsson\n\n+[NSSharingService sharingServicesForItems:] is deprecated. We used it to list share providers so we could build them as XUL menuitems. We will replace it with NSSharingServicePicker, which is maintained by macOS and provides a sharing service interface consistent with apps across macOS. This patch also fixes Bug 1698581 for macOS to now support sharing for more than one tab.\n\nThe new native interface resulted in a few UI changes in Firefox menus:\n\n - The submenu no longer lists each installed macOS share provider. It now shows Copy Link, Create QR Code, and a single entry \"AirDrop, Messages, and More...\" that opens the native picker.\n - The \"More...\" entry that opened the Sharing pane of System Settings is gone. The native picker exposes the same providers directly.\n - Copy Link and Create QR Code lose their icons since we are working on removing all icons in context menus.\n - \"Generate QR Code...\" is relabelled \"Create QR Code\"\n - The BrowserUsageTelemetry id for a macOS share goes from \"share-macos-provider\" to \"macos-share-picker\", since Firefox no longer knows which provider the user picks.\n\nFurther details:\n\nWhen invoked, shareUrlWithPicker() anchors the native picker popover to a relevant DOM element.\n\nSharing more than one tab cannot be expressed as a URL, so multi-URL shares are handed to the picker as a MOZShareURLPasteboardItem, which advertise plain text and HTML representations covering every URL. This was the solution to enable as many sharing services as possible to share multiple URLs in a nice format. Single-URL shares still pass a plain NSURL so the share picker can display a webpage preview.\n\nThe xpcshell test covered getSharingProviders() and is removed with it. The new pasteboard writer is covered by TestMOZShareURLPasteboardItem.mm instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D308393\n", "files": ["browser/base/content/test/browser-contextMenu/browser.toml", "browser/base/content/test/browser-contextMenu/browser_contextmenu_share_macosx.js", "browser/base/content/test/browser-menubar/browser_file_share_macosx.js", "browser/components/customizableui/test/browser_share_tab_button_macosx.js", "browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/sharing/SharingUtils.sys.mjs", "browser/locales/en-US/browser/browser.ftl", "browser/locales/en-US/browser/menubar.ftl", "browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/themes/shared/browser-shared.css", "browser/themes/shared/icons/qrcode.svg", "browser/themes/shared/jar.inc.mn", "widget/cocoa/MOZShareURLPasteboardItem.h", "widget/cocoa/MOZShareURLPasteboardItem.mm", "widget/cocoa/moz.build", "widget/cocoa/nsMacSharingService.mm", "widget/nsIMacSharingService.idl", "widget/tests/gtest/TestMOZShareURLPasteboardItem.mm", "widget/tests/gtest/moz.build", "widget/tests/unit/test_macsharingservice.js", "widget/tests/unit/xpcshell.toml"], "git_node": "82a429ea8a1fa85baaa563df98ef7a7b9eb71afd", "git_parents": ["c3eb4ff1379e92826283daa8252b80330c6a60a4"], "node": "9672346b230388d478852c6729402579958bee5c", "parents": ["cef375faaf45cfdb81ac5183950faf5e0fbb79df"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009747 - Patch 2 - Update the picker's Copy Link to support sharing multiple links. r=mac-reviewers,bradwerth\n\nNSSharingServicePicker provides its own Copy Link entry via the private SHKCopyToPasteboardSharingService class. However, we want to have the copy feature for when multiple tabs are selected consistent with Firefox's \"Copy x Links\" functionality and label.\n\nThere is no API for replacing an entry provided by the system, and appending our own NSSharingService results in two Copy services. MacShareCopyOverride swizzles -title, -canPerformWithItems: and -performWithItems:, so the entry keeps its native appearance but takes its label and its action from Firefox.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325555\n", "files": ["browser/components/sharing/SharingUtils.sys.mjs", "widget/cocoa/moz.build", "widget/cocoa/nsMacSharingCopyOverride.h", "widget/cocoa/nsMacSharingCopyOverride.mm", "widget/cocoa/nsMacSharingService.mm", "widget/nsIMacSharingService.idl"], "git_node": "31721c41d2ecf69fe460c6232d4157605cf72fe0", "git_parents": ["82a429ea8a1fa85baaa563df98ef7a7b9eb71afd"], "node": "6d4d9040e1d02a63f1191ba52355b0c32a36c1ec", "parents": ["9672346b230388d478852c6729402579958bee5c"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009747 - Patch 3 - Replace the address bar context menu Share submenu with Share and Create QR Code items. r=Standard8,urlbar-reviewers,fluent-reviewers,bolsson\n\nOn macOS the strip-on-share item joins the share group rather than sitting under Copy, so the group is built as a single item set: Share..., Create QR Code and Copy Clean Link.\n\nAnchoring strip-on-share after the Create QR Code item would have required #initShareURL to run first. Building the group in one fragment avoids that ordering requirement. Both paths share the item creation and the enable/hide logic.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325556\n", "files": ["browser/base/content/test/browser-contextMenu/browser_contextmenu_share_macosx.js", "browser/components/qrcode/test/browser/browser_qrcode_share_menu.js", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/locales/en-US/browser/browser.ftl"], "git_node": "a5d01c7e582a37de160340f5b2dc19f0a7fe82c7", "git_parents": ["31721c41d2ecf69fe460c6232d4157605cf72fe0"], "node": "29f1c223d15a2cc3e806d074a63bd4f81a4d0c7b", "parents": ["6d4d9040e1d02a63f1191ba52355b0c32a36c1ec"], "tags": []}, {"author": "Helena \u003chballent@mozilla.com\u003e", "branch": "default", "desc": "Bug 2009747 - Patch 4 - Open the macOS share picker directly from the share toolbar button. r=mac-reviewers,bradwerth\n\nOn macOS the share toolbar button is a custom toolbar item which directly opens the native picker.\n\nCreate QR Code gets injected as a custom service. It previously was listed in the button's submenu but since the native share picker gets directly invoked, in order to keep the function, it now is integrated in the native picker. shareUrlWithPicker() gains a customItems array for this, and BuildCustomServices() turns each one into an NSSharingService prepended to the picker's list.\n\nThe button keeps the submenu on other platforms.\n\nThis is a separate commit due to the work to create a link share button in the URL bar (Bug 2052253), so this toolbar button might become redundant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325557\n", "files": ["browser/components/customizableui/CustomizableWidgets.sys.mjs", "browser/components/customizableui/test/browser_share_tab_button_macosx.js", "browser/components/sharing/SharingUtils.sys.mjs", "widget/cocoa/nsMacSharingService.mm", "widget/nsIMacSharingService.idl"], "git_node": "8a8f2db9fbccddd7792ad8508324bb4d8f3e4eca", "git_parents": ["a5d01c7e582a37de160340f5b2dc19f0a7fe82c7"], "node": "581ac44c32589e4a21367ff750da7400ad618df1", "parents": ["29f1c223d15a2cc3e806d074a63bd4f81a4d0c7b"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2074792 - fix(webgpu): fix no-readback rendering crashes r=webgpu-reviewers,teoxoy\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329228\n", "files": ["gfx/wgpu_bindings/src/server.rs"], "git_node": "a82d06cf0518d901531a654e75cefeabcdd9ffac", "git_parents": ["8a8f2db9fbccddd7792ad8508324bb4d8f3e4eca"], "node": "2892c72000e43fbe238c0390da2212d0fefadfe0", "parents": ["581ac44c32589e4a21367ff750da7400ad618df1"], "tags": []}, {"author": "Johannes Salas Schmidt \u003cjoschmidt@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069438 - Add a cargo-vet policy for the git-fetched nss-rs. r=supply-chain-reviewers,nalexander\n\nnss-rs now has a 0.0.0 placeholder on crates.io, so cargo vet wants to know\nwhether the copy fetched from mozilla/nss-rs should be audited as the\ncrates.io crate. It should not.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329204\n", "files": ["supply-chain/config.toml"], "git_node": "02e3938768cf9ffd0f7d13f570d976c0c733f28e", "git_parents": ["a82d06cf0518d901531a654e75cefeabcdd9ffac"], "node": "6738443c28261bc329aaeddd508cea339ccb42a1", "parents": ["2892c72000e43fbe238c0390da2212d0fefadfe0"], "tags": []}, {"author": "Anna Kulyk \u003cakulyk@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068041 - Add a label to the theme picker r=fluent-reviewers,desktop-theme-reviewers,mstriemer,mossop,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326558\n", "files": ["browser/components/profiles/content/edit-profile-card.css", "browser/components/profiles/content/edit-profile-card.mjs", "browser/components/profiles/tests/browser/browser_edit_profile_theme_picker_test.js"], "git_node": "80bbce8b5c8ef715ce7dd702f4908643fbcbd707", "git_parents": ["02e3938768cf9ffd0f7d13f570d976c0c733f28e"], "node": "a094137b791f8056fedd3dccc78cd6fcf8f7302e", "parents": ["6738443c28261bc329aaeddd508cea339ccb42a1"], "tags": []}, {"author": "SMRehan \u003crio.syed@gmail.com\u003e", "branch": "default", "desc": "Bug 2070688 - Suppress initial fullscreen for extension popup and chromeless windows. r=mac-reviewers,bradwerth,spohl,extension-reviewers,robwu\n\nA window opened while another one is fullscreen can come up fullscreen two ways: on macOS the platform adopts it into the active fullscreen space, and on every platform AppWindow restores a persisted sizemode=\"fullscreen\" from the XUL store. Either way an extension popup, or an ASWebAuthSession window opened from a fullscreen window, takes a Space of its own and is never seen. CHROME_SUPPRESS_INITIAL_FULLSCREEN now covers both: the widget already suppressed the first in nsCocoaWindow::Show, and nsAppShellService now also sets IgnoreXULSizeMode for it.\n\nThe parent-is-fullscreen check that set IgnoreXULSizeMode is no longer Windows-only, so Windows keeps what it had while macOS and Linux gain it, and the flag covers callers that pass no parent, which is what an extension popup does. browser_suppress_initial_fullscreen.js covers the XUL-store half. It runs on macOS only, since its control case needs a window manager that grants fullscreen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324758\n", "files": ["browser/components/extensions/parent/ext-windows.js", "browser/components/extensions/test/browser/browser_ext_windows_create.js", "browser/modules/URILoadingHelper.sys.mjs", "toolkit/components/browser/nsIWebBrowserChrome.idl", "toolkit/components/windowwatcher/test/browser.toml", "toolkit/components/windowwatcher/test/browser_suppress_initial_fullscreen.js", "xpfe/appshell/nsAppShellService.cpp"], "git_node": "4bbd3954d30d4a01aacbe6a04d7e0bc28842c262", "git_parents": ["80bbce8b5c8ef715ce7dd702f4908643fbcbd707"], "node": "d469db5543bdecb1f9d5bbd7eb6c469fd6621652", "parents": ["a094137b791f8056fedd3dccc78cd6fcf8f7302e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070304 - Document installing Python with uv in the macOS and Linux build docs r=firefox-build-system-reviewers,sylvestre\n\nXcode's bundled Python is 3.9 and mach requires 3.10, so the macOS\ninstructions need an explicit Python install step. Installing with\n`--default` makes `python3` resolve to the uv managed interpreter so\n`./mach` runs on it without re-executing itself.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326595\n", "files": ["docs/setup/linux_build.md", "docs/setup/macos_build.md", "mach"], "git_node": "dd145624a8dad59075ff5f9773ce822ceabf5539", "git_parents": ["4bbd3954d30d4a01aacbe6a04d7e0bc28842c262"], "node": "483b1248ecbb561826e5bd799d2413aaa469deb1", "parents": ["d469db5543bdecb1f9d5bbd7eb6c469fd6621652"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075385 - Update Gradle to version 9.8.0. r=android-reviewers,adhingra\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329257\n", "files": ["gradle/wrapper/gradle-wrapper.jar", "gradle/wrapper/gradle-wrapper.properties", "gradlew.bat", "mobile/android/android-components/gradle/wrapper/gradle-wrapper.jar", "mobile/android/android-components/gradle/wrapper/gradle-wrapper.properties", "mobile/android/android-components/gradlew.bat", "mobile/android/fenix/gradle/wrapper/gradle-wrapper.jar", "mobile/android/fenix/gradle/wrapper/gradle-wrapper.properties", "mobile/android/fenix/gradlew.bat", "mobile/android/focus-android/gradle/wrapper/gradle-wrapper.jar", "mobile/android/focus-android/gradle/wrapper/gradle-wrapper.properties", "mobile/android/focus-android/gradlew.bat"], "git_node": "a7f1a2050ba529b53fc2ce29f781c995262349f6", "git_parents": ["dd145624a8dad59075ff5f9773ce822ceabf5539"], "node": "ebdeeec4cd453453ce8a218d84fcbfe1e322453b", "parents": ["483b1248ecbb561826e5bd799d2413aaa469deb1"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-el/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-es-rMX/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-tr/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-es-rMX/strings.xml", "mobile/android/fenix/app/src/main/res/values-es-rMX/strings.xml", "mobile/android/fenix/app/src/main/res/values-ka/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml"], "git_node": "207d9dfce5d4087a2206af1025d54c8872e2edaf", "git_parents": ["a7f1a2050ba529b53fc2ce29f781c995262349f6"], "node": "4f77150a57fda316ec4dcf7563a9c437a41722c7", "parents": ["ebdeeec4cd453453ce8a218d84fcbfe1e322453b"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2001075 - [Wayland] Report a drag ended by WaylandDragWorkaround as cancelled r=stransky,gtk-reviewers,emilio\n\nWaylandDragWorkaround() ends the drag session with EndDragSession(true, 0)\non a session that never went through SourceEndDragSession(), so the dragend\nevent carries the session defaults: dropEffect \"none\", not user cancelled,\nend point (0,0). The tab strip's handle_dragend() takes \"no drop, not\ncancelled\" as a drop outside any target and checks the position; in a\nmaximized Wayland window event.screenX equals window.screenX, the strict\ncomparison fails, and the tab is detached into a new window.\n\nThe workaround fires on the release of a quick click on a tab, because the\nrelease is already queued for the toplevel when gtk_drag_begin() grabs the\npointer and reaches button_release_event_cb() before any drag-motion. It\nalso fires when the compositor never finishes the drag (mutter issue 740),\nthe case it was written for. Nothing was dropped in either case, so mark\nthe session as user cancelled before ending it; handle_dragend() then\nreturns early on mozUserCancelled.\n\nUnlike the earlier fix that was backed out in bug 2022238, this injects no\nsynthetic drop event and leaves the workaround's trigger unchanged; it only\nchanges what the dragend event reports.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327557\n", "files": ["widget/gtk/nsWindowWayland.cpp"], "git_node": "7dd748c3a7bf7d9c56ccf50e325bf49df7b7d8a5", "git_parents": ["207d9dfce5d4087a2206af1025d54c8872e2edaf"], "node": "93986659ad69263a82a6a2f61cc5bdbf902600a6", "parents": ["4f77150a57fda316ec4dcf7563a9c437a41722c7"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge autoland to mozilla-central\n", "files": ["browser/components/search/types/mozTabbrowserTab.d.ts", "browser/extensions/newtab/test/jest/lib/Wallpapers/WallpaperThemeUtils.test.js", "browser/themes/shared/icons/qrcode.svg", "dom/media/webrtc/transport/dtlsidentity.cpp", "dom/media/webrtc/transport/dtlsidentity.h", "widget/tests/unit/test_macsharingservice.js"], "git_node": "c32abda0190531351e22da36334f18f9e994d474", "git_parents": ["e3d49b76cc694aed8d7ed03153288efb38eefec0", "7dd748c3a7bf7d9c56ccf50e325bf49df7b7d8a5"], "node": "bdbddcbbe3a0a42ba6006bf0827f65faf75318a8", "parents": ["31c8fb2bab9aa087740fa3ab5a6ae451aea792ef", "93986659ad69263a82a6a2f61cc5bdbf902600a6"], "tags": []}], "date": 1790396627, "git_changesets": ["63aaea311e6c3ad73a39fe96d245ee0941f33680", "88e3ab1dae4f25f61cfc408efed43540be7f6652", "8af047a0eeec1c069af5c8890489132c15d6ea37", "73b45908f1eeafb685b1dcae6892d034e7eb6723", "4b5107059dadbd41df8e3057b33acaa32abead23", "aef755902914bec7edc33763a63886a50343f0c1", "76dfb59adbe4b992c12a7806b5cfa8828b9eddbd", "798b7901dceb524d3b9a21d8044bd637f2d1026d", "da9c2638c7136e2f5e10e8f7eb6e490ab913908f", "719a487c60552856dfa405c5248eace1f533c9e2", "2c8182cf816d52d6443035442c32b0cace049e11", "a7ebabf82d2b857cb335eec766cba8b8bd98d49d", "e5250a1dda5ed94db52ab3cde3ba9632d1937f73", "9e973247cb6666eb32517d492d624ee8592beb39", "e63b0703de42c9af899eba4867119aeb510839c4", "27b3e584fc7600117ebbf7b469fc86a2eff2cea4", "7f101c4ab796d6b7d22a258bdd95b23e86c5d95c", "88ead587dddee65525aff29fecdf00d923a00d8b", "370f2e6234f8ad35bb17ad2ac99502b44dbb1bad", "6d00498a129e13722089fcb1c0f8dae4da0699ec", "c561ed122b9867d987917cce0dcb9886e775b23b", "b94ffe97209122cfd9a038f6622bad56e2c2a620", "d62e4cf489e59a84f6e84671d9def677808a6d38", "116b470b17cdd14ede6f10b3ad0dda6c8d27755d", "daffb8fa3be509cff5ad9ebe0d2c812d7595e2ad", "fca0c6af2f65e408fb983dd5aadb2ec7928d97bc", "0d47c016702edd12924e46d9a57d507247c14b50", "3891c6c9272fbcb24caf6a5c152f46c4011ecdff", "bb306be73ab72b82b3e57ad39b4e1ec92ff9ab09", "e21e740c253552348ab8cd0a2c932ea9ba135106", "0f355084c46e2567b9ea4b1b3b8ea6a6042d7b0a", "2cd096740308829a58a40fcc628126ce67299972", "f18fb30f923fab7ab59e9b10a5040fffba58527a", "426fea0d8599c1867e30c1fc1da89b1a443f2f9a", "4b7468cc256adfca3acb28c9115f75dbca502e28", "b42e262b34314e4425b2f07088fa0f2a4326ad67", "112345729be49a69f4965d4248ef9f6739f920b2", "3d978752ca8cb4a9d991eb3c91929f95e8a6e88a", "a86f6db020b3b63d47e8e1a5deab300c6f1121cf", "d240fd1390d9ef667dd5d76dac61895158d4a824", "7b51efbba9068a53e1c50c55946a1ddc293ffe1f", "b9e41fbd4d7ad6922465811ffd85eb6a6152ef02", "c9d962335a9609d6fb5f503f79319d1912cd8198", "6c35880999e9ecc6de5f22f2257172f7a692c6b8", "c5073ec41830192843cf2a8af8cd4c5864bd3ae5", "1f6da2cdccccbfb61baeaf5e5d3b07cc64841e7d", "3e34bf84f3a87f2f6c190797ec166af05e40a604", "fb37e70ccbfde0112af58b1905def54c7524d464", "c3eb4ff1379e92826283daa8252b80330c6a60a4", "82a429ea8a1fa85baaa563df98ef7a7b9eb71afd", "31721c41d2ecf69fe460c6232d4157605cf72fe0", "a5d01c7e582a37de160340f5b2dc19f0a7fe82c7", "8a8f2db9fbccddd7792ad8508324bb4d8f3e4eca", "a82d06cf0518d901531a654e75cefeabcdd9ffac", "02e3938768cf9ffd0f7d13f570d976c0c733f28e", "80bbce8b5c8ef715ce7dd702f4908643fbcbd707", "4bbd3954d30d4a01aacbe6a04d7e0bc28842c262", "dd145624a8dad59075ff5f9773ce822ceabf5539", "a7f1a2050ba529b53fc2ce29f781c995262349f6", "207d9dfce5d4087a2206af1025d54c8872e2edaf", "7dd748c3a7bf7d9c56ccf50e325bf49df7b7d8a5", "c32abda0190531351e22da36334f18f9e994d474"], "user": "sstanca@mozilla.com"}, "45426": {"changesets": [{"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068131 - Hoist return_call trampoline to process-global builtin thunk set. r=rhunt\n\nThe trampoline a collapsed cross-instance return_call returns through is\ngeneric, but was generated inline at every return_call site. Generate it once\nwith the builtin thunks, as its own CodeRange::ReturnCallTrampoline, and make\nthe collapse load its address through SymbolicAddress::ReturnCallTrampoline.\n\nIts return address no longer resolves through LookupCode, so popFrame,\nProfilingFrameIterator::operator++, GetNearestEffectiveInstance and\nAssertMatchesCallSite recognize it and skip the hidden frame, and\nStartUnwinding unwinds a sample taken inside the trampoline. The hidden frame\nhas no stackmap of its own, but its size is fixed, so the stackmap coverage\ncursor steps across it.\n\nThe hidden frame used to be reported as a frame of the function that did the\nreturn_call, so that function appeared in Error().stack and profiler stacks.\nIt no longer does, same as for a same-instance return_call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322717\n", "files": ["js/src/jit/MacroAssembler.cpp", "js/src/jit/MacroAssembler.h", "js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmBuiltins.h", "js/src/wasm/WasmCodegenTypes.cpp", "js/src/wasm/WasmCodegenTypes.h", "js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmFrameIter.h", "js/src/wasm/WasmGenerator.cpp", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmStubs.cpp", "js/src/wasm/WasmStubs.h"], "git_node": "036ee078e00bb1536c1e3766afab0569d0fce5f8", "git_parents": ["7dd748c3a7bf7d9c56ccf50e325bf49df7b7d8a5"], "node": "fe7676e9c5f459333eaace4c9e64379d7b801a6c", "parents": ["93986659ad69263a82a6a2f61cc5bdbf902600a6"], "tags": []}, {"author": "Yury Delendik \u003cydelendik@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068131 - Remove the now-unused ReturnStub call site kind. r=rhunt\n\nHoisting the return_call trampoline into the builtin thunk set removed the\nonly producers of CallSiteKind::ReturnStub call sites, so nothing records one\nany more and every consumer is unreachable:\n\n  - WasmFrameIter::initFromTrap only ever takes the trapData.resumePC branch.\n  - WasmFrameIter::debugEnabled cannot be asked about the hidden frame, which\n    popFrame skips rather than reports.\n  - HandleExceptionWasm cannot find a try note covering the trampoline, which\n    now lives in the thunk set and is not inside any function's code range.\n  - CallSite::mightBeCrossInstance loses a term that never holds; the skip in\n    popFrame derives the instance from the collapsed frame instead.\n\nRemoving the enum member is checked by the compiler, and serialized code is\nkeyed to the build id, so the renumbering cannot be observed by a cached\nmodule from another build.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324752\n", "files": ["js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmCodegenTypes.h", "js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmGenerator.cpp"], "git_node": "c28101f7f5bd0f2778e720b0b7171bac1e3d2b32", "git_parents": ["036ee078e00bb1536c1e3766afab0569d0fce5f8"], "node": "4f540fe2beeb376c30b70acb11991e7bd351ab94", "parents": ["fe7676e9c5f459333eaace4c9e64379d7b801a6c"], "tags": []}, {"author": "Jason Prickett \u003cjprickett@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069997 - Add last-card layout for HNT card-stack template r=omc-reviewers,fterdal,emcminn\n\nThis patch adds a new layout and animations to match designs for the\nlast card in the HNT card-stack. It does not handle the auto-dismiss\nand fade out animation for the card. That will be committed in a follow\nup patch.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328726\n", "files": ["browser/components/aboutwelcome/content/aboutwelcome.bundle.js", "browser/components/aboutwelcome/content/aboutwelcome.css", "browser/components/asrouter/content-src/components/MultiStageProtonScreen.jsx", "browser/components/asrouter/content-src/styles/_multistage.scss", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.bundle.js", "browser/components/asrouter/content/components/asrouter-newtab-multistage/asrouter-newtab-multistage.css", "browser/components/asrouter/modules/PanelTestProvider.sys.mjs", "browser/components/asrouter/tests/unit/content-src/components/MultiStageAWProton.test.jsx", "toolkit/components/messaging-system/schemas/MultiStageProtonScreenSchemas/MultiStageProtonScreenSchemas.json"], "git_node": "887bfd309840fd983342808cd5e3c9f2a769bdd9", "git_parents": ["c28101f7f5bd0f2778e720b0b7171bac1e3d2b32"], "node": "8bda64ed3a1ba7e2e5af2ad3246d7ae80bd98200", "parents": ["4f540fe2beeb376c30b70acb11991e7bd351ab94"], "tags": []}, {"author": "Ben Hearsum \u003cben@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075450: add target tasks method that will power new code review bot pushes r=marco,taskgraph-reviewers,ahal\n\nFor starters, we're just running a few basic builds. It's likely that we're going to change the implementation of this at some point (eg: to more intelligently select only the necessary builds, add some tests, use bugbug, etc.) -- but this is a starting point.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329088\n", "files": ["taskcluster/docs/attributes.md", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/build/ios.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml"], "git_node": "ae90ad3e08ea5b6eb3b6a8002dad42e0368338d3", "git_parents": ["887bfd309840fd983342808cd5e3c9f2a769bdd9"], "node": "d8b0519c506322e72446a2d8ef25f4330c38dea9", "parents": ["8bda64ed3a1ba7e2e5af2ad3246d7ae80bd98200"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2075486 - skip-if the test in LCOV build. r=spidermonkey-reviewers,iain\n\nThe tests in bug-2073269 are tested when the function scripts are parsed\ndelazily, hence skip the tests when code coverage is enabled in LCOV build,\nwhich uses full parsing.\n\nhttps://searchfox.org/firefox-main/rev/3682546ac2c02610537306ca16849de2c24aea45/js/src/shell/js.cpp#13841-13844\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329205\n", "files": ["js/src/jit-test/tests/modules/bug-2073269.js", "js/src/jit-test/tests/parser/bug-2073269-script.js"], "git_node": "a9eef99de9b3d179ce121920997a99ee28d73576", "git_parents": ["ae90ad3e08ea5b6eb3b6a8002dad42e0368338d3"], "node": "97372afc59dd308abceaf1320836c7b96c41916b", "parents": ["d8b0519c506322e72446a2d8ef25f4330c38dea9"], "tags": []}, {"author": "canalun \u003ci.am.kanaru.sato@gmail.com\u003e", "branch": "default", "desc": "Bug 2075038 - Drop non-APZ codepath for swipe-to-nav. r=hiro\n\nThis patch also renames MayStartSwipeForAPZ to MayStartSwipe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329084\n", "files": ["widget/InputData.h", "widget/cocoa/nsCocoaWindow.mm", "widget/gtk/nsWindow.cpp", "widget/nsIWidget.cpp", "widget/nsIWidget.h", "widget/windows/nsWindow.cpp"], "git_node": "85d31f15e3bceb8e75e1f1bdd1dc1efffbc9f62f", "git_parents": ["a9eef99de9b3d179ce121920997a99ee28d73576"], "node": "ddcfbc085c7b0eeee5c08308b53fb88b569fe96e", "parents": ["97372afc59dd308abceaf1320836c7b96c41916b"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075025 - Update Sentry to version 8.58.0. r=android-reviewers,tcampbell\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328694\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/components/lib/crash-sentry/src/main/AndroidManifest.xml", "mobile/android/android-components/components/lib/crash-sentry/src/main/java/mozilla/components/lib/crash/sentry/SentryService.kt", "mobile/android/android-components/components/lib/crash-sentry/src/test/java/mozilla/components/lib/crash/sentry/SentryFeatureGatesTest.kt"], "git_node": "50dbe57638ad34628f529fcb7afa0b9149b45101", "git_parents": ["85d31f15e3bceb8e75e1f1bdd1dc1efffbc9f62f"], "node": "5ae561e2c57ff0b433e1d640d51ef4eebd7f804d", "parents": ["ddcfbc085c7b0eeee5c08308b53fb88b569fe96e"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2060428 - Part 10 - Use the new Python Cargo actions by default r=firefox-build-system-reviewers,sergesanspaille\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325635\n", "files": ["moz.configure"], "git_node": "872d7d03735334d8102ed47f85b44d3d4e10316c", "git_parents": ["50dbe57638ad34628f529fcb7afa0b9149b45101"], "node": "14945bdc917d1ca377ea4674de0ef1e04e0d13f3", "parents": ["5ae561e2c57ff0b433e1d640d51ef4eebd7f804d"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2071362 - Split the aiwindow browser-chrome manifest in two r=ngrato\n\nbrowser/components/aiwindow/ui/test/browser/browser.toml had grown to 162\ntest files. Browser-chrome runs one Firefox session per manifest, so all of\nthem shared a single parent process, and on 32-bit Windows that process ran\nout of address space near the end of the run. The crash landed on whichever\ntest happened to be running at the time, which is why it has been filed\nunder several different test names.\n\nTotal vsize is not really the problem: it plateaus around 3.4GB. What runs\nout is contiguous space. Over a full run the largest free block falls from\nabout 1.3GB to 135MB, and allocations start failing there.\n\nSplit the manifest so each half runs in its own session. At the halfway\npoint of the old run the largest free block was still around 400MB, so\nneither half should get near the failure point. browser.toml keeps the AI\nwindow shell, chat and tab tests (87 files); browser_smartwindow.toml takes\nthe Smart Window UI, smartbar, form fill and security tests (75 files).\nBoth carry the same DEFAULT block. No test files or test logic changed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328028\n", "files": ["browser/components/aiwindow/ui/moz.build", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml"], "git_node": "bbe172a94cc44e268ff547ab7e7db467a71d3c06", "git_parents": ["872d7d03735334d8102ed47f85b44d3d4e10316c"], "node": "3cb448c19a7d360aaa81faa676f601cdd3ea33f9", "parents": ["14945bdc917d1ca377ea4674de0ef1e04e0d13f3"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2075321, part 1 - Make ContentParent::sBrowserContentParents use a StaticAutoPtr. r=dom-core-reviewers,smaug\n\nThis should not change the behavior in any way, but it makes the memory safety\nmore obvious.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329048\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h"], "git_node": "849bb24e2a7a0a1fc3c32e1f08d7ea7cbd65bdbf", "git_parents": ["bbe172a94cc44e268ff547ab7e7db467a71d3c06"], "node": "9c21a4dea8ed0c48b41cb80adec81336f47b1068", "parents": ["3cb448c19a7d360aaa81faa676f601cdd3ea33f9"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2075321, part 2 - Limit the scope of GetOrCreatePool. r=dom-core-reviewers,smaug\n\nGetOrCreatePool returns a reference to an array that is a value of the hashtable\nsBrowserContentParents. The array is held in a unique pointer, so resizing the\nhashtable will not invalidate the array. The only thing that can happen to it is\nif the entry is removed or the entire hashtable is destroyed. Both can only\nhappen in RemoveFromList().\n\nIt doesn't seem like that is a risk right now, but to reduce the chance of future\nchanges causing problems this patch moves the call to GetOrCreatePool closer to\nwhere it is used. This will cause an additional hashtable lookup, but that should\nbe okay.\n\nFor GetUsedBrowserProcess, the calculation of contentParents and maxContentParents\ngets pushed inside the function, and the unused aPriority parameter is removed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329049\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h"], "git_node": "95935a87898bac4eb9bb8d365db3c7cc13479346", "git_parents": ["849bb24e2a7a0a1fc3c32e1f08d7ea7cbd65bdbf"], "node": "b9cce2a19223244ed8c305e9573082fc0e3c0a4b", "parents": ["9c21a4dea8ed0c48b41cb80adec81336f47b1068"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2075321, part 3 - Make AddToPool look up its own pool. r=dom-core-reviewers,smaug\n\nThe only calls to GetOrCreatePool are now as arguments to AddToPool.\nAt both call sites, mRemoteType has been set to aRemoteType, so we can\ncall GetCreatePool with mRemoteType inside AddToPool, meaning we don't\nneed to leave a reference to the array for more than a single statement.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329050\n", "files": ["dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h"], "git_node": "a871d839210f8e4eaca5e717d7c88c8a31b96ba7", "git_parents": ["95935a87898bac4eb9bb8d365db3c7cc13479346"], "node": "f504df8a82092695d0e5d3e88550dab88cd42770", "parents": ["b9cce2a19223244ed8c305e9573082fc0e3c0a4b"], "tags": []}, {"author": "Daniel Holbert \u003cdholbert@cs.stanford.edu\u003e", "branch": "default", "desc": "Bug 2075443: When parsing an SVG 'd' path string in CSS, preallocate space for a rough number of commands, based on a fraction of the string's length. r=firefox-style-system-reviewers,dshin\n\nThis lets us avoid the capacity-doubling and array-copying that we would\notherwise have to do with a default-initialized Vec, as we walk through a long\npath string to parse all of its path commands.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329275\n", "files": ["servo/components/style/values/specified/svg_path.rs"], "git_node": "5f84c6dced454baf3c3a3ed2c5bc7df97a7f5248", "git_parents": ["a871d839210f8e4eaca5e717d7c88c8a31b96ba7"], "node": "e80b3fe07af779b6bdc32adcc31332a4d12b2cb3", "parents": ["f504df8a82092695d0e5d3e88550dab88cd42770"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069528 - rework when internal modules search for certificates r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323773\n", "files": ["security/manager/ssl/ipcclientcerts/src/backend.rs", "security/manager/ssl/ipcclientcerts/src/lib.rs", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/osclientcerts/src/backend_android.rs", "security/manager/ssl/osclientcerts/src/backend_macos.rs", "security/manager/ssl/osclientcerts/src/backend_windows.rs", "security/manager/ssl/osclientcerts/src/lib.rs", "security/manager/ssl/rsclientcerts/src/manager.rs", "security/manager/ssl/tests/unit/pkcs11testmodule/src/backend.rs", "security/manager/ssl/tests/unit/pkcs11testmodule/src/lib.rs"], "git_node": "044b892c86dfc3ebe839d0b765b2e78e9b1bdd6e", "git_parents": ["5f84c6dced454baf3c3a3ed2c5bc7df97a7f5248"], "node": "f3f768145012dcd9fd3a1537456e943cd2bf7f10", "parents": ["e80b3fe07af779b6bdc32adcc31332a4d12b2cb3"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069528 - make certificates on remote PKCS#11 modules available to the parent process r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323774\n", "files": ["Cargo.lock", "security/certverifier/NSSCertDBTrustDomain.cpp", "security/certverifier/NSSCertDBTrustDomain.h", "security/manager/ssl/IPCClientCertsParent.cpp", "security/manager/ssl/PKCS11ModuleChild.cpp", "security/manager/ssl/PKCS11ModuleChild.h", "security/manager/ssl/PKCS11ModuleDB.cpp", "security/manager/ssl/PKCS11ModuleDB.h", "security/manager/ssl/PPKCS11Module.ipdl", "security/manager/ssl/PSMIPCTypes.ipdlh", "security/manager/ssl/TLSClientAuthCertSelection.cpp", "security/manager/ssl/ipcclientcerts/src/backend.rs", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/nsNSSComponent.h", "security/manager/ssl/nsNSSIOLayer.cpp", "security/manager/ssl/nsNSSIOLayer.h", "security/manager/ssl/osclientcerts/Cargo.toml", "security/manager/ssl/osclientcerts/src/backend_android.rs", "security/manager/ssl/remotecerts/Cargo.toml", "security/manager/ssl/remotecerts/src/backend.rs", "security/manager/ssl/remotecerts/src/lib.rs", "security/manager/ssl/rsclientcerts/src/manager.rs", "security/manager/ssl/tests/unit/test_pkcs11_remote_process.js", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "f147908ae3183f8220a9c8ca2988ab0561f04b94", "git_parents": ["044b892c86dfc3ebe839d0b765b2e78e9b1bdd6e"], "node": "7079c329c43926ab1b11b741717f15ebc6c6b3df", "parents": ["f3f768145012dcd9fd3a1537456e943cd2bf7f10"], "tags": []}, {"author": "Dana Keeler \u003cdkeeler@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069528 - rsclientcerts: note when certificates/keys/trust are no longer available r=jschanck\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327190\n", "files": ["security/manager/ssl/ipcclientcerts/src/backend.rs", "security/manager/ssl/osclientcerts/src/backend_android.rs", "security/manager/ssl/osclientcerts/src/backend_macos.rs", "security/manager/ssl/osclientcerts/src/backend_windows.rs", "security/manager/ssl/remotecerts/src/backend.rs", "security/manager/ssl/rsclientcerts/src/manager.rs", "security/manager/ssl/tests/unit/pkcs11testmodule/src/backend.rs", "security/manager/ssl/tests/unit/test_pkcs11_remote_process.js"], "git_node": "5bbe80bf4ef875be64007327aeb8668a9101ca5b", "git_parents": ["f147908ae3183f8220a9c8ca2988ab0561f04b94"], "node": "0df162dd68ad5a8b785b0b4c987eb6fe4a7ebf41", "parents": ["7079c329c43926ab1b11b741717f15ebc6c6b3df"], "tags": []}, {"author": "Serban Stanca \u003csstanca@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2069528 - rsclientcerts: note when certificates/keys/trust are no longer available r=jschanck\" for causing build bustages.\n\nThis reverts commit 5bbe80bf4ef875be64007327aeb8668a9101ca5b.\n\nThis reverts commit f147908ae3183f8220a9c8ca2988ab0561f04b94.\n\nThis reverts commit 044b892c86dfc3ebe839d0b765b2e78e9b1bdd6e.\n", "files": ["Cargo.lock", "security/certverifier/NSSCertDBTrustDomain.cpp", "security/certverifier/NSSCertDBTrustDomain.h", "security/manager/ssl/IPCClientCertsParent.cpp", "security/manager/ssl/PKCS11ModuleChild.cpp", "security/manager/ssl/PKCS11ModuleChild.h", "security/manager/ssl/PKCS11ModuleDB.cpp", "security/manager/ssl/PKCS11ModuleDB.h", "security/manager/ssl/PPKCS11Module.ipdl", "security/manager/ssl/PSMIPCTypes.ipdlh", "security/manager/ssl/TLSClientAuthCertSelection.cpp", "security/manager/ssl/ipcclientcerts/src/backend.rs", "security/manager/ssl/ipcclientcerts/src/lib.rs", "security/manager/ssl/nsNSSComponent.cpp", "security/manager/ssl/nsNSSComponent.h", "security/manager/ssl/nsNSSIOLayer.cpp", "security/manager/ssl/nsNSSIOLayer.h", "security/manager/ssl/osclientcerts/Cargo.toml", "security/manager/ssl/osclientcerts/src/backend_android.rs", "security/manager/ssl/osclientcerts/src/backend_macos.rs", "security/manager/ssl/osclientcerts/src/backend_windows.rs", "security/manager/ssl/osclientcerts/src/lib.rs", "security/manager/ssl/remotecerts/Cargo.toml", "security/manager/ssl/remotecerts/src/backend.rs", "security/manager/ssl/remotecerts/src/lib.rs", "security/manager/ssl/rsclientcerts/src/manager.rs", "security/manager/ssl/tests/unit/pkcs11testmodule/src/backend.rs", "security/manager/ssl/tests/unit/pkcs11testmodule/src/lib.rs", "security/manager/ssl/tests/unit/test_pkcs11_remote_process.js", "toolkit/library/rust/shared/Cargo.toml", "toolkit/library/rust/shared/lib.rs"], "git_node": "796f163dcd3aea0035ccd4c2b2810b2445ec5617", "git_parents": ["5bbe80bf4ef875be64007327aeb8668a9101ca5b"], "node": "d583e5a3357d374d5d6b93669a53d912c33de27c", "parents": ["0df162dd68ad5a8b785b0b4c987eb6fe4a7ebf41"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2071531 - Give JSVAL_TYPE_STRING and JSVAL_TYPE_SYMBOL tags that encode as ARM64 logical immediates. r=iain,devtools-reviewers,nchevobbe\n\nThe shifted string tag 0xfffb000000000000 is not a logical immediate, so\non ARM64 every string unbox, tag test and box first materializes it:\n\n  movz x16, #0xfffb, lsl #48\n  eor  x3, x1, x16\n\nMoving the type code from 0x06 to 0x0e gives 0xffff000000000000, which\nencodes, so these become one instruction, as they already are for\nobjects:\n\n  eor  x3, x1, #0xffff000000000000\n\nSymbol and PrivateGCThing also swap type codes, so symbols get 0x08 and\nits encodable 0xfffc000000000000 rather than the rarely used private GC\nthing tag.\n\nThe low two bits of the tag are still 10 = TraceKind::String, so\nValue::traceKind, the PrivateGCThing/Symbol adjacency, the nursery cell\nheader packing and the JIT's TraceKind assumptions are unchanged. What\ndoes change is that the object tag is no longer the highest one:\nisObject and isPrimitive become tag equality tests, and the backends'\ntestPrimitive compares against the object tag for equality instead of\nordering, at the same instruction count. The lowest GC thing tag is now\nthe private GC thing tag. x86-64 code is unaffected either way, since it\nmaterializes both tags with movabs.\n\nThe type code is also visible in the execution tracer's value summary\nformat, so its VERSION goes to 3 and the two in-tree readers, the\njit-test and DevTools' value-summary-reader.mjs, learn the new codes.\n\nOn a JetStream 3 run with an instrumented shell the two-instruction\nstring shape appears 50,593 times (Ion 45,086: 30,685 unboxes and tag\ntests, 14,315 boxes; Baseline 5,480; other stubs 27) and is gone\nafterwards, replaced by the same number of single-instruction eor and\norr forms, with no remaining materialization of a string or object tag\nin the dump. That is about 200 KB of JIT code per run, 0.5% of the Ion\noutput. JetStream 3 never materializes the symbol tag.\n\nFound with armlint.\n\nClaude-Session: https://claude.ai/code/session_01WsnsqJvQCmPUe3GWmsM77Q\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326384\n", "files": ["devtools/client/shared/components/reps/reps/value-summary-reader.mjs", "js/public/Debug.h", "js/public/Value.h", "js/src/jit-test/tests/debug/ExecutionTracer-traced-values.js", "js/src/jit/arm/MacroAssembler-arm.cpp", "js/src/jit/arm64/MacroAssembler-arm64.h", "js/src/jit/loong64/MacroAssembler-loong64-inl.h", "js/src/jit/mips-shared/MacroAssembler-mips-shared-inl.h", "js/src/jit/riscv64/MacroAssembler-riscv64-inl.h", "js/src/jit/x64/MacroAssembler-x64.h", "js/src/jit/x86/MacroAssembler-x86.h"], "git_node": "b19257565e8888d9f58be316c93af04a8590eb15", "git_parents": ["796f163dcd3aea0035ccd4c2b2810b2445ec5617"], "node": "8a3c16b89186f2950d4e9e4b56bc059bd1cb5957", "parents": ["d583e5a3357d374d5d6b93669a53d912c33de27c"], "tags": []}, {"author": "Kelly Cochrane \u003ckcochrane@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059480 - Show tab group line for both split view tabs when expand on hover is enabled r=desktop-theme-reviewers,tabbrowser-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328979\n", "files": ["browser/themes/shared/tabbrowser/tabs.css"], "git_node": "68bdedda82e606179e84ff92c24f51cf8e77e5ae", "git_parents": ["b19257565e8888d9f58be316c93af04a8590eb15"], "node": "da4ac11ebfc403178d4dc73a78bb6b4d45031b8b", "parents": ["8a3c16b89186f2950d4e9e4b56bc059bd1cb5957"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2073640 - Fix the Exa action log row not showing after the search finishes. r=gcardieri\n\nThe pending Exa label has a link, so Fluent replaces the label's children, including Lit's part markers. When the label switched to the completed text without a link, Lit threw while updating the removed markers, and every later render failed, so expanding the card showed nothing. Key the label spans on whether they have a link so Lit makes a new element instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329312\n", "files": ["browser/components/aiwindow/ui/components/ai-action-result/ai-action-result.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_ai_action_result.js"], "git_node": "61954177a60b2e92de7ad2a5ae8b70dcc47abac8", "git_parents": ["68bdedda82e606179e84ff92c24f51cf8e77e5ae"], "node": "2872175c9c9ea975186a4d457de1714b0043575e", "parents": ["da4ac11ebfc403178d4dc73a78bb6b4d45031b8b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075368 - Dispatch a mouseup after the synthetic mousedown when activating a PanelMultiView button with the keyboard, r=firefox-desktop-core-reviewers ,Gijs.\n\nKeyboard activation sent a trusted mousedown and click but no mouseup, leaving nsGlobalWindowInner::sMouseDown set until the next real mouseup. A window move or resize in that state suppresses drag and drop.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329161\n", "files": ["browser/components/customizableui/PanelMultiView.sys.mjs", "browser/components/customizableui/test/browser_PanelMultiView_keyboard.js"], "git_node": "191ef80e61fe5390b34c9a00c2432ad6fbd117f7", "git_parents": ["61954177a60b2e92de7ad2a5ae8b70dcc47abac8"], "node": "c4f2dbb260e62ddef135a532f479f0585c411221", "parents": ["2872175c9c9ea975186a4d457de1714b0043575e"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Select stack frames with real clicks in browser_dbg-search-file-paused.js, r=devtools-reviewers,nchevobbe.\n\nThe test dispatched a lone mousedown on stack frames, which left the mouse button pressed after the test. Frames have been selected on click since bug 1843324, so the mousedown no longer switched files at all.\n\nClick the frames instead and wait for the selected source to change. Clicking a frame focuses it, so focus the search field again before pressing Enter to move between matches.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329172\n", "files": ["devtools/client/debugger/test/mochitest/browser_dbg-search-file-paused.js"], "git_node": "e4e6bc3e84ab0ec8ace5026e63a74ba10c7f74ad", "git_parents": ["191ef80e61fe5390b34c9a00c2432ad6fbd117f7"], "node": "f2afe26b1b091a8681ff8e4a5f475bd725c42736", "parents": ["c4f2dbb260e62ddef135a532f479f0585c411221"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Shift-click the swatches with full clicks in browser_rules_cycle-angle.js and browser_rules_cycle-color.js, r=devtools-reviewers,nchevobbe.\n\nThe tests synthesized only a shift+mousedown on the angle and color swatches, which left the mouse button pressed after the test. Units cycle on mousedown and the swatch click handler ignores shift-clicks, so synthesize a full click instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329173\n", "files": ["devtools/client/inspector/rules/test/browser_rules_cycle-angle.js", "devtools/client/inspector/rules/test/browser_rules_cycle-color.js"], "git_node": "3f17f5739dd301dc9e186c9269c1c791e94143ce", "git_parents": ["e4e6bc3e84ab0ec8ace5026e63a74ba10c7f74ad"], "node": "a0c46eb36ac986273f507aaf812548f5086420d1", "parents": ["f2afe26b1b091a8681ff8e4a5f475bd725c42736"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Release the mouse button outside the color picker in browser_rules_colorpicker-release-outside-frame.js, r=devtools-reviewers,nchevobbe.\n\nThe test pressed the mouse button in the color picker and never released it, which left the button pressed after the test. Release it over the rule view, outside the color picker frame, which is the scenario the test is about: the picker does not receive that mouseup, and must stop following the pointer on the next mousemove without a button pressed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329174\n", "files": ["devtools/client/inspector/rules/test/browser_rules_colorpicker-release-outside-frame.js"], "git_node": "8c5c608dcf4c7211be9f9a0f269b96c164245ced", "git_parents": ["3f17f5739dd301dc9e186c9269c1c791e94143ce"], "node": "b5fb418979c01be108d9c335eb7ffc583d024e53", "parents": ["a0c46eb36ac986273f507aaf812548f5086420d1"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Click the downloads button instead of only pressing it in browser_overflow_anchor.js, r=firefox-desktop-core-reviewers ,Gijs.\n\nThe overflowed button is now clicked in the opened overflow panel, as a user would, since a closed panel can't receive a real click.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329179\n", "files": ["browser/components/downloads/test/browser/browser_overflow_anchor.js"], "git_node": "1ca260bf6ec5813d8c94a78b733376fa7f9eb97a", "git_parents": ["8c5c608dcf4c7211be9f9a0f269b96c164245ced"], "node": "fca37b8500fde040f9f03d82013468b35ff6c2ca", "parents": ["b5fb418979c01be108d9c335eb7ffc583d024e53"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Complete the middle click on the tab in browser_bug462289.js, r=firefox-desktop-core-reviewers ,Gijs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329181\n", "files": ["browser/base/content/test/browser-general/browser_bug462289.js"], "git_node": "e1f024fafd1129dc6c76fef8cea9d40f74cbe733", "git_parents": ["1ca260bf6ec5813d8c94a78b733376fa7f9eb97a"], "node": "7546cd4294619414097380b0cbb75b1054eb3159", "parents": ["fca37b8500fde040f9f03d82013468b35ff6c2ca"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2075369 - Wait for the paste popup dismissal clicks before ending each subtest of browser_document_command_paste_contextmenu_suppression_key.js, r=dom-core-reviewers,edgar.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329182\n", "files": ["dom/events/test/clipboard/browser_document_command_paste_contextmenu_suppression_key.js"], "git_node": "998fe2058fc7de58044d2c7b07c17595e8578dd2", "git_parents": ["e1f024fafd1129dc6c76fef8cea9d40f74cbe733"], "node": "9f5ab1d72012f3a6a5e7ee0bc352f80510e985ca", "parents": ["7546cd4294619414097380b0cbb75b1054eb3159"], "tags": []}, {"author": "Chris DuPuis \u003ccdupuis@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073353 - Remove unused metrics that cause shutdown hangs r=hsohaney\n\nCollecting these metrics is no longer needed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327901\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/metrics.yaml", "browser/modules/test/unit/test_InstallationTelemetry.js"], "git_node": "39c43e609692f93accc944d2653aea0bb297a34b", "git_parents": ["998fe2058fc7de58044d2c7b07c17595e8578dd2"], "node": "5745b072b7be7b6e6786ff2491c70be8c1994b89", "parents": ["9f5ab1d72012f3a6a5e7ee0bc352f80510e985ca"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074885 - Cache the worker payload validation schema instead of rebuilding it for every task. r=taskgraph-reviewers,bhearsum,jcristau,ahal DONTBUILD\n\nCreating a new msgspec Struct subclass per task forced msgspec to recompute its type info every time, which dominated the validate transform.\n\nLocally (`./mach taskgraph full -j 8` with the parameters of a try\ndecision task), the mochitest kind finishes about 1.8s sooner and the\nfull task set takes 30.3s instead of 32.2s.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328550\n", "files": ["taskcluster/gecko_taskgraph/transforms/task.py"], "git_node": "b0f13606ec532f866a9f5897f0810528923197ab", "git_parents": ["39c43e609692f93accc944d2653aea0bb297a34b"], "node": "7e2d2ff8146897cae6a410e3df46edc5c388de58", "parents": ["5745b072b7be7b6e6786ff2491c70be8c1994b89"], "tags": []}, {"author": "Ansh \u003cansinha@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075685 - Reduce the bottom padding of the device list card r=android-reviewers,gmalekpour\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329296\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/share/SendToDevicesScreen.kt"], "git_node": "549313eb537b1f634f8d426870ea35a60520df54", "git_parents": ["b0f13606ec532f866a9f5897f0810528923197ab"], "node": "2cc7d089636c68b67a67516926c95d7b3e16c415", "parents": ["7e2d2ff8146897cae6a410e3df46edc5c388de58"], "tags": []}, {"author": "Emily Wachowiak \u003cewachowiak@mozilla.com\u003e", "branch": "default", "desc": "Bug 2031012 - Title case: update 13 app menu items from sentence case. r=fluent-reviewers,bolsson DONTBUILD\n\nCapitalization-only updates across three files. No meaning changes;\nstrings do not require retranslation.\n\nbrowser/locales/en-US/browser/appmenu.ftl\n  appmenu-manage-history:              Manage history \u2192 Manage History\n  appmenu-clear-history:               Clear recent history\u2026 \u2192 Clear Recent History\u2026\n  appmenu-recently-closed-tabs:        Recently closed tabs \u2192 Recently Closed Tabs\n  appmenu-recently-closed-windows:     Recently closed windows \u2192 Recently Closed Windows\n  appmenu-search-history:              Search history \u2192 Search History\n  appmenu-get-help:                    Get help \u2192 Get Help\n  appmenu-help-more-troubleshooting-info: More troubleshooting information \u2192 More Troubleshooting Information\n  appmenu-help-share-ideas:            Share ideas and feedback\u2026 \u2192 Share Ideas and Feedback\u2026\n  appmenu-help-report-deceptive-site:  Report deceptive site\u2026 \u2192 Report Deceptive Site\u2026\n  appmenu-customizetoolbar:            Customize toolbar\u2026 \u2192 Customize Toolbar\u2026\n  appmenu-developer-tools-extensions:  Extensions for developers \u2192 Extensions for Developers\n\nbrowser/locales/en-US/browser/sync.ftl\n  fxa-menu-sign-out:                   Sign out\u2026 \u2192 Sign Out\u2026\n\nbrowser/locales/en-US/browser/allTabsMenu.ftl\n  all-tabs-menu-tab-groups-show-all:   Show all \u2192 Show All\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329229\n", "files": ["browser/locales/en-US/browser/allTabsMenu.ftl", "browser/locales/en-US/browser/appmenu.ftl", "browser/locales/en-US/browser/sync.ftl"], "git_node": "bce17b2d61bb2eff82957622b212fa70b652721d", "git_parents": ["549313eb537b1f634f8d426870ea35a60520df54"], "node": "680b54a8a0a5cf7910c3808fd815e18f621967e9", "parents": ["2cc7d089636c68b67a67516926c95d7b3e16c415"], "tags": []}, {"author": "mandysGit \u003cmcheang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073145 - Remove Amazon from Remote Settings (search-config-v2 and search-config-overrides-v2). r=Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326989\n", "files": ["toolkit/components/search/tests/xpcshell/searchconfigs/test_searchconfig.js"], "git_node": "76e1e05a5fcdf6894f07d42c56ca2a2a7c043445", "git_parents": ["bce17b2d61bb2eff82957622b212fa70b652721d"], "node": "607a2fc2e8a9c8804c7125033e248b7cac7d4d75", "parents": ["680b54a8a0a5cf7910c3808fd815e18f621967e9"], "tags": []}, {"author": "tyler-thorne \u003ctthorne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063635 - Make about:processes' View/Control instantiable classes. r=florian\n\nConverts the View/Control singletons in aboutProcesses.js from object\nliterals into classes (ProcessesView/ProcessesController), instantiated\nonce as the existing `View`/`Control` globals. No behavior change to the\ndefault process view: State, tabFinder, and window.onload are untouched,\nand every method body is unchanged aside from switching object-literal\nsyntax to class syntax.\n\nThis is prerequisite groundwork for adding a second, differently-shaped\nview (a per-tab/site grouping, gated behind a `groupby` URL\nparameter) without touching the default view's rendering path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318949\n", "files": ["toolkit/components/aboutprocesses/content/aboutProcesses.js"], "git_node": "0237d5d71906cf4e7c9890064898bbdf943950ed", "git_parents": ["76e1e05a5fcdf6894f07d42c56ca2a2a7c043445"], "node": "e86c8e981aa52303f8e436b2a6fed1ebc64d27ee", "parents": ["607a2fc2e8a9c8804c7125033e248b7cac7d4d75"], "tags": []}, {"author": "tyler-thorne \u003ctthorne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063635 - Extract a shared RowSet base class and hoist fillCell/formatMemory out of ProcessesView. r=florian\n\nSplits ProcessesView's row-reuse bookkeeping (_rowsById/_orderedRows/\n_getOrCreateRow/_removeRow/_commitOrder) into a new RowSet base class, and\nhoists _fillCell/_formatMemory into standalone functions, so an upcoming\nsecond view/controller pair can share both without duplicating them or\nreaching into ProcessesView's own instance. Also hoists the localization\nprefetch out of ProcessesController.init() into promiseLocalizations() for\nthe same reason. Pure refactor -- no behavior change to the existing view.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327051\n", "files": ["toolkit/components/aboutprocesses/content/aboutProcesses.js"], "git_node": "7f9cb4bcdedba0805a7791b4693ec61d4b4ef557", "git_parents": ["0237d5d71906cf4e7c9890064898bbdf943950ed"], "node": "6e83ceafe343a6a236afad49a2bf7f844993908a", "parents": ["e86c8e981aa52303f8e436b2a6fed1ebc64d27ee"], "tags": []}, {"author": "tyler-thorne \u003ctthorne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2063635 - Add about:processes?groupby=tab, closing tabs only. r=florian,desktop-theme-reviewers,dao,fluent-reviewers,bolsson\n\nAdds a second View/Controller pair (ProcessesTabView/ProcessesTabController)\nrendering a flat per-tab list, selected via a groupby URL parameter. Row\nhandling is shared with the default view via RowSet (see previous commit).\n\nPer-tab RAM/CPU comes from TabAttribution, which weights each tab's share of\na process by walking its BrowsingContext tree. Tabs from a different privacy\ncontext than the viewing window are excluded entirely, not just unmarked.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318950\n", "files": ["toolkit/components/aboutprocesses/content/aboutProcesses.css", "toolkit/components/aboutprocesses/content/aboutProcesses.js", "toolkit/components/aboutprocesses/tests/browser/browser.toml", "toolkit/components/aboutprocesses/tests/browser/browser_aboutprocesses_groupby_tab.js", "toolkit/locales/en-US/toolkit/about/aboutProcesses.ftl"], "git_node": "ecf4fca9fb6736ea8145b289f05f59b2df385659", "git_parents": ["7f9cb4bcdedba0805a7791b4693ec61d4b4ef557"], "node": "9a06a736f16f350945c82f49e53d9cd60cc6ce5a", "parents": ["6e83ceafe343a6a236afad49a2bf7f844993908a"], "tags": []}, {"author": "tyler-thorne \u003ctthorne@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066927 - Add graceful tab-unload to about:processes?groupby=tab. r=florian,fluent-reviewers,bolsson,desktop-theme-reviewers,dao\n\nSwaps the row action from closing the tab to tabbrowser.explicitUnloadTabs(),\nfreeing its content without closing it (reload-on-reselect). A discarded row\nnow stays in the list at a static \"killed\" look instead of disappearing,\nsince the tab is still open, just asleep; the button relabels to 'Go to tab'\nand switches to navigating instead of unloading.\n\nAlso swaps the row action's icon off the shared \"X\" close icon onto\nchrome://global/skin/icons/moon.svg, matching the softer semantics of\nunload vs. close. Matches the default view: no Delete/Backspace accelerator\nhere either, for the same reason (rows aren't a Tab stop; only the unload\nbutton is).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319686\n", "files": ["toolkit/components/aboutprocesses/content/aboutProcesses.css", "toolkit/components/aboutprocesses/content/aboutProcesses.js", "toolkit/components/aboutprocesses/tests/browser/browser_aboutprocesses_groupby_tab.js", "toolkit/locales/en-US/toolkit/about/aboutProcesses.ftl"], "git_node": "c9f49939c7076890062d44d139bdda5598693d5e", "git_parents": ["ecf4fca9fb6736ea8145b289f05f59b2df385659"], "node": "0a29296d860146a3d4ad44718e57131d616e72bd", "parents": ["9a06a736f16f350945c82f49e53d9cd60cc6ce5a"], "tags": []}, {"author": "Marco Castelluccio \u003cmcastelluccio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073738 - Don't let '**/*.json' schedule source-test tasks for try_task_config.json. r=taskgraph-reviewers,ahal DONTBUILD\n\n`mach try` commits try_task_config.json on top of every try push, so\nthe eslint, file-whitespace and file-perm tasks ran on every push. The\nfiles-changed globs don't support negation, so a source-test transform\nrewrites '**/*.json' to JSON files in subdirectories plus the ones\ntracked at the root of the tree.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327545\n", "files": ["taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_transforms_source_test.py", "taskcluster/gecko_taskgraph/transforms/source_test.py"], "git_node": "3e53f92539a9867ff582c4dffaf1927800a8f2da", "git_parents": ["c9f49939c7076890062d44d139bdda5598693d5e"], "node": "46ceb9fe6d867bf9b2decabb9654e0fb8e48ea05", "parents": ["0a29296d860146a3d4ad44718e57131d616e72bd"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2074896 - Prevent feTile rect calculations from overflowing r=ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328561\n", "files": ["gfx/2d/FilterNodeSoftware.cpp", "gfx/tests/gtest/TestFilterNodeSoftware.cpp", "gfx/tests/gtest/moz.build"], "git_node": "caff59c64b2e0b329e24d6f5f325178f23f65334", "git_parents": ["3e53f92539a9867ff582c4dffaf1927800a8f2da"], "node": "b66c8d79b20df544c0d31f9dd78d497c5d7d5a5a", "parents": ["46ceb9fe6d867bf9b2decabb9654e0fb8e48ea05"], "tags": []}, {"author": "longsonr \u003clongsonr@gmail.com\u003e", "branch": "default", "desc": "Bug 2074116 - optimise hue-rotate filter of 0 r=ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327849\n", "files": ["gfx/src/FilterSupport.cpp"], "git_node": "f632cd7cba4604cb480fcccc3105dd4eadcd27ea", "git_parents": ["caff59c64b2e0b329e24d6f5f325178f23f65334"], "node": "f598567841e69b1669a8a5f965a8b87400d088a6", "parents": ["b66c8d79b20df544c0d31f9dd78d497c5d7d5a5a"], "tags": []}, {"author": "Jared Hirsch \u003cohai@6a68.net\u003e", "branch": "default", "desc": "Bug 2070743 - Put distribution test files inside the temp xpcshell profile dir so they run in parallel r=nbarrett,places-reviewers\n\nPreviously we accidentally had the distribution files inserted at the\ntop level above the profile, not inside the profile, which caused\nconflicts among xpcshell tests running in parallel.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D324806\n", "files": ["browser/components/distribution.sys.mjs", "browser/components/places/tests/unit/test_browserGlue_distribution.js", "browser/components/tests/unit/head.js", "browser/components/tests/unit/test_distribution.js", "browser/components/tests/unit/test_distribution_bookmarks_first.js", "browser/components/tests/unit/test_distribution_cachedexistence.js", "browser/components/tests/unit/test_distribution_idonly.js", "browser/components/tests/unit/test_distribution_mozillaonline.js", "browser/components/tests/unit/test_distribution_observer.js"], "git_node": "6bdf808a4e43c2712903e1c911f966f3b2f0bbec", "git_parents": ["f632cd7cba4604cb480fcccc3105dd4eadcd27ea"], "node": "7a326dd943accd0c40d0ab1662e6c50f31d62012", "parents": ["f598567841e69b1669a8a5f965a8b87400d088a6"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073353 - Remove unused metrics that cause shutdown hangs r=hsohaney\" for causing tp failures @ test_mirrors.py\n\nThis reverts commit 39c43e609692f93accc944d2653aea0bb297a34b.\n", "files": ["browser/modules/BrowserUsageTelemetry.sys.mjs", "browser/modules/metrics.yaml", "browser/modules/test/unit/test_InstallationTelemetry.js"], "git_node": "cf51949351fa0f0333d1db4d77a3184ed59da99c", "git_parents": ["6bdf808a4e43c2712903e1c911f966f3b2f0bbec"], "node": "ae76a07f992f49ff0d2e8dd9840abcc39864064f", "parents": ["7a326dd943accd0c40d0ab1662e6c50f31d62012"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Merge mozilla-central to autoland\n", "files": [], "git_node": "097cd879e28bc259f0b354dc67fb52bce3452366", "git_parents": ["cf51949351fa0f0333d1db4d77a3184ed59da99c", "c32abda0190531351e22da36334f18f9e994d474"], "node": "aa28ddf5cc1c1a41fa502113bc7b86784744133f", "parents": ["ae76a07f992f49ff0d2e8dd9840abcc39864064f", "bdbddcbbe3a0a42ba6006bf0827f65faf75318a8"], "tags": []}, {"author": "pstanciu \u003cpstanciu@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2031012 - Title case: update 13 app menu items from sentence case. r=fluent-reviewers,bolsson DONTBUILD\" for causing bc failures @ browser_sentence_case_strings.js\n\nThis reverts commit bce17b2d61bb2eff82957622b212fa70b652721d.\n", "files": ["browser/locales/en-US/browser/allTabsMenu.ftl", "browser/locales/en-US/browser/appmenu.ftl", "browser/locales/en-US/browser/sync.ftl"], "git_node": "737b7da99a09050d143ae500ecc3f68b74bb4704", "git_parents": ["097cd879e28bc259f0b354dc67fb52bce3452366"], "node": "9b1e222f1f447cea61d01bc7767951efa1fcf5a3", "parents": ["aa28ddf5cc1c1a41fa502113bc7b86784744133f"], "tags": []}, {"author": "ffxbld \u003cffxbld@mozilla.com\u003e", "branch": "default", "desc": "No Bug, mozilla-central repo-update HSTS HPKP - r=release-managers,RyanVM\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329329\n", "files": ["security/manager/ssl/StaticHPKPins.h", "security/manager/ssl/nsSTSPreloadList.inc"], "git_node": "28a67a9f34e98e57c61ef9e802cf74916f501cd5", "git_parents": ["737b7da99a09050d143ae500ecc3f68b74bb4704"], "node": "d37794b556f9e22f9906862f7030805135b9345a", "parents": ["9b1e222f1f447cea61d01bc7767951efa1fcf5a3"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075667 - Vendor `uniffi` version `0.32.2` (or higher) to fix Kotlin unused symbols error with `--enable-appservices-in-tree`. r=ahochheiden,supply-chain-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329267\n", "files": ["Cargo.lock", "supply-chain/audits.toml", "supply-chain/imports.lock", "third_party/rust/uniffi/.cargo-checksum.json", "third_party/rust/uniffi/.cargo_vcs_info.json", "third_party/rust/uniffi/Cargo.lock", "third_party/rust/uniffi/Cargo.toml", "third_party/rust/uniffi/Cargo.toml.orig", "third_party/rust/uniffi_bindgen/.cargo-checksum.json", "third_party/rust/uniffi_bindgen/.cargo_vcs_info.json", "third_party/rust/uniffi_bindgen/Cargo.lock", "third_party/rust/uniffi_bindgen/Cargo.toml", "third_party/rust/uniffi_bindgen/Cargo.toml.orig", "third_party/rust/uniffi_bindgen/src/bindings/kotlin/templates/NamespaceLibraryTemplate.kt", "third_party/rust/uniffi_bindgen/src/bindings/kotlin/templates/macros.kt", "third_party/rust/uniffi_build/.cargo-checksum.json", "third_party/rust/uniffi_build/.cargo_vcs_info.json", "third_party/rust/uniffi_build/Cargo.lock", "third_party/rust/uniffi_build/Cargo.toml", "third_party/rust/uniffi_build/Cargo.toml.orig", "third_party/rust/uniffi_core/.cargo-checksum.json", "third_party/rust/uniffi_core/.cargo_vcs_info.json", "third_party/rust/uniffi_core/Cargo.lock", "third_party/rust/uniffi_core/Cargo.toml", "third_party/rust/uniffi_core/Cargo.toml.orig", "third_party/rust/uniffi_internal_macros/.cargo-checksum.json", "third_party/rust/uniffi_internal_macros/.cargo_vcs_info.json", "third_party/rust/uniffi_internal_macros/Cargo.lock", "third_party/rust/uniffi_internal_macros/Cargo.toml", "third_party/rust/uniffi_internal_macros/Cargo.toml.orig", "third_party/rust/uniffi_macros/.cargo-checksum.json", "third_party/rust/uniffi_macros/.cargo_vcs_info.json", "third_party/rust/uniffi_macros/Cargo.lock", "third_party/rust/uniffi_macros/Cargo.toml", "third_party/rust/uniffi_macros/Cargo.toml.orig", "third_party/rust/uniffi_meta/.cargo-checksum.json", "third_party/rust/uniffi_meta/.cargo_vcs_info.json", "third_party/rust/uniffi_meta/Cargo.lock", "third_party/rust/uniffi_meta/Cargo.toml", "third_party/rust/uniffi_meta/Cargo.toml.orig", "third_party/rust/uniffi_pipeline/.cargo-checksum.json", "third_party/rust/uniffi_pipeline/.cargo_vcs_info.json", "third_party/rust/uniffi_pipeline/Cargo.lock", "third_party/rust/uniffi_pipeline/Cargo.toml", "third_party/rust/uniffi_pipeline/Cargo.toml.orig", "third_party/rust/uniffi_testing/.cargo-checksum.json", "third_party/rust/uniffi_testing/.cargo_vcs_info.json", "third_party/rust/uniffi_testing/Cargo.lock", "third_party/rust/uniffi_testing/Cargo.toml", "third_party/rust/uniffi_testing/Cargo.toml.orig", "third_party/rust/uniffi_udl/.cargo-checksum.json", "third_party/rust/uniffi_udl/.cargo_vcs_info.json", "third_party/rust/uniffi_udl/Cargo.lock", "third_party/rust/uniffi_udl/Cargo.toml", "third_party/rust/uniffi_udl/Cargo.toml.orig"], "git_node": "024b3e53a118fd00462047ec9dd3082dbeb130d8", "git_parents": ["28a67a9f34e98e57c61ef9e802cf74916f501cd5"], "node": "0836c394986e8ade3eb9de7ae8e541fc62f77deb", "parents": ["d37794b556f9e22f9906862f7030805135b9345a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Add a temporary duplicate set of CI tasks that build app-services in tree r=nalexander,ahal,taskgraph-reviewers,releng-reviewers\n\nThis will be deleted once app-services in tree is enabled by default. The\nduplicate tasks are set to tier 3 so that a regression in app-services does\nnot cause a backout, and a daily cron job schedules them to minimize the cost\nof the duplicate set of tasks. We will monitor it for a while before committing\nto app-services in tree being the CI default.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320192\n", "files": [".cron.yml", "build/sparse-profiles/taskgraph", "python/mozbuild/mozbuild/artifact_builds.py", "python/mozbuild/mozbuild/artifacts.py", "taskcluster/docs/kinds.md", "taskcluster/gecko_taskgraph/target_tasks.py", "taskcluster/gecko_taskgraph/transforms/test/other.py", "taskcluster/kinds/build-apk-appservices/kind.yml", "taskcluster/kinds/build-bundle-appservices/kind.yml", "taskcluster/kinds/build-components-appservices/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/signing-apk-appservices/kind.yml", "taskcluster/kinds/source-test-appservices/kind.yml", "taskcluster/kinds/test-apk-appservices/kind.yml", "taskcluster/kinds/test-components-appservices/kind.yml", "taskcluster/kinds/toolchain/android.yml", "taskcluster/kinds/ui-test-apk-appservices/kind.yml", "taskcluster/test_configs/test-platforms.yml", "taskcluster/test_configs/test-sets.yml", "toolkit/moz.configure"], "git_node": "c097d043ccfd0b79762290b8a54228ab7a312119", "git_parents": ["024b3e53a118fd00462047ec9dd3082dbeb130d8"], "node": "265a9e1cf60d13ea142ebb822074a50a7dcce65a", "parents": ["0836c394986e8ade3eb9de7ae8e541fc62f77deb"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Link the Android megazord against `mozglue` again r=firefox-build-system-reviewers,sergesanspaille\n\nThe megazord stopped linking `mozglue` in D320332 so that a Rust `free` would\nnot reach bionic allocations. The vendored `application-services` no longer\ncalls `std::fs::canonicalize` on Android, so the megazord can use `mozjemalloc`\nlike every other Gecko library and the `check_binary` guard can assert the\ndependency is present rather than absent.\n\nA second guard rejects imports of bionic functions that hand the caller memory\nfrom libc's allocator, such as `getline` and `scandir`. It cannot cover\n`realpath` or `getcwd`, which allocate only when passed a null buffer and\nwhich `application-services` and Rust std import with a caller owned buffer.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322556\n", "files": ["python/mozbuild/mozbuild/action/check_binary.py", "third_party/application-services/megazords/full/moz.build"], "git_node": "cefb09247c104d99cd9526349b643c12f9cb8f04", "git_parents": ["c097d043ccfd0b79762290b8a54228ab7a312119"], "node": "c1b79f55f3cfae5788ac9f8bac153de0be76349f", "parents": ["265a9e1cf60d13ea142ebb822074a50a7dcce65a"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075667 - Vendor application-services `a191beab` to limit `glean-sym` metrics to Android r=nalexander\n\nThe megazord enabled the `active` feature of `glean-sym` on every target.\nThat feature loads Glean from libxul at run time and does not compile for\nWindows, so the host megazord used for unit tests failed to build.\nhttps://github.com/mozilla/application-services/pull/7622 enables it only\nfor Android.\n\nThis also includes the file changes from `./mach uniffi generate`\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329346\n", "files": ["Cargo.lock", "third_party/application-services/automation/tests.py", "third_party/application-services/components/ads-client/src/mars.rs", "third_party/application-services/components/ads-client/src/mars/ad_response.rs", "third_party/application-services/components/ads-client/src/test_utils.rs", "third_party/application-services/megazords/full/Cargo.toml", "third_party/application-services/megazords/full/src/lib.rs", "third_party/application-services/moz.yaml", "toolkit/components/uniffi-bindgen-gecko-js/android/components/ads-client/android/src/main/java/mozilla/appservices/adsclient/ads_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/autofill/android/src/main/java/mozilla/appservices/autofill/autofill.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/crashtest/android/src/main/java/mozilla/appservices/crashtest/crashtest.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/db-crypto/android/src/main/java/mozilla/appservices/db_crypto/db_crypto.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/errorsupport/android/src/main/java/mozilla/appservices/errorsupport/errorsupport.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/fxaclient/android/src/main/java/mozilla/appservices/fxaclient/fxa_client.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/init_rust_components/android/src/main/java/mozilla/appservices/init_rust_components/init_rust_components.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/logins/android/src/main/java/mozilla/appservices/logins/logins.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/merino/android/src/main/java/mozilla/appservices/merino/merino.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/nimbus/android/src/main/java/org/mozilla/experiments/nimbus/internal/nimbus.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/places/android/src/main/java/mozilla/appservices/places/uniffi/places.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/push/android/src/main/java/mozilla/appservices/push/push.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/relay/android/src/main/java/mozilla/appservices/relay/relay.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/remotesettings/android/src/main/java/mozilla/appservices/remotesettings/remote_settings.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/rust-log-forwarder/android/src/main/java/mozilla/appservices/rust_log_forwarder/rust_log_forwarder.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/search/android/src/main/java/mozilla/appservices/search/search.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/suggest/android/src/main/java/mozilla/appservices/suggest/suggest.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/sync15/android/src/main/java/mozilla/appservices/sync15/sync15.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/syncmanager/android/src/main/java/mozilla/appservices/syncmanager/syncmanager.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/tabs/android/src/main/java/mozilla/appservices/remotetabs/tabs.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/tracing/android/src/main/java/mozilla/appservices/tracing/tracing.kt", "toolkit/components/uniffi-bindgen-gecko-js/android/components/viaduct/android/src/main/java/mozilla/appservices/viaduct/viaduct.kt"], "git_node": "bf06403ee45758abb3298ae04c380a22149288f0", "git_parents": ["cefb09247c104d99cd9526349b643c12f9cb8f04"], "node": "e5551e694538c21372674e1d5e25ad52507e8089", "parents": ["c1b79f55f3cfae5788ac9f8bac153de0be76349f"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Replace `extra_mozconfig_content` with mozconfig files. r=ahal\n\nThe goal is for every build to use one mozconfig file from the tree, so\nthat `MOZCONFIG=\u003cthat file\u003e ./mach build` reproduces it locally. Some\nbuilds instead had mozharness append extra lines to a copy of their\nmozconfig at run time. Those lines now live in new mozconfig files that\nsource the original and add them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329063\n", "files": ["browser/config/mozconfigs/linux64-aarch64/beta", "browser/config/mozconfigs/linux64-aarch64/debug", "browser/config/mozconfigs/linux64-aarch64/devedition", "browser/config/mozconfigs/linux64-aarch64/nightly", "browser/config/mozconfigs/linux64-aarch64/profile-generate", "browser/config/mozconfigs/linux64-aarch64/release", "browser/config/mozconfigs/linux64/debug-base-toolchains", "browser/config/mozconfigs/linux64/nightly-base-toolchains", "browser/config/mozconfigs/linux64/non-unified", "browser/config/mozconfigs/linux64/non-unified-debug", "browser/config/mozconfigs/linux64/profile-generate-as-release", "browser/config/mozconfigs/macosx64-aarch64/debug", "browser/config/mozconfigs/macosx64-aarch64/debug-searchfox", "browser/config/mozconfigs/macosx64-aarch64/opt", "browser/config/mozconfigs/macosx64-aarch64/opt-searchfox", "browser/config/mozconfigs/macosx64-aarch64/profile-generate-as-release", "browser/config/mozconfigs/macosx64/non-unified", "browser/config/mozconfigs/win64/non-unified", "browser/config/mozconfigs/win64/profile-generate-as-release", "mobile/android/config/mozconfigs/android-aarch64-lite/beta", "mobile/android/config/mozconfigs/android-aarch64-lite/nightly", "mobile/android/config/mozconfigs/android-aarch64-lite/release", "mobile/android/config/mozconfigs/android-aarch64/non-unified", "mobile/android/config/mozconfigs/android-arm-lite/beta", "mobile/android/config/mozconfigs/android-arm-lite/beta-fat-aar", "mobile/android/config/mozconfigs/android-arm-lite/nightly", "mobile/android/config/mozconfigs/android-arm-lite/nightly-fat-aar", "mobile/android/config/mozconfigs/android-arm-lite/release", "mobile/android/config/mozconfigs/android-arm-lite/release-fat-aar", "mobile/android/config/mozconfigs/android-x86_64-lite/beta", "mobile/android/config/mozconfigs/android-x86_64-lite/nightly", "mobile/android/config/mozconfigs/android-x86_64-lite/release", "mobile/android/config/mozconfigs/android-x86_64/non-unified", "mobile/ios/config/mozconfigs/ios/non-unified", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/build/ios.yml", "taskcluster/kinds/build/linux-base-toolchains.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_lite.py"], "git_node": "df32739573cd21a2199e2e700238ee1f8434e511", "git_parents": ["bf06403ee45758abb3298ae04c380a22149288f0"], "node": "ca04652eafeda8d652b19066ce0339929338bc2b", "parents": ["e5551e694538c21372674e1d5e25ad52507e8089"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Set `MOZCONFIG` in the environment of build tasks from a `mozconfig` key. r=ahal,taskgraph-reviewers,releng-reviewers\n\nBuild tasks now name their mozconfig in the kind with a `mozconfig` key\ninstead of through mozharness configs, so the choice stays in taskgraph\nwhatever runs the build. A transform turns the key into `MOZCONFIG` in\nthe task environment. When the key leaves them out, the platform comes\nfrom the task name, and the application is `mobile/android` for Android\nor the graph's `product-dir` otherwise, which gives comm-central\n`comm/mail`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327665\n", "files": ["taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_transforms_mozconfig.py", "taskcluster/gecko_taskgraph/transforms/build.py", "taskcluster/gecko_taskgraph/transforms/mozconfig.py", "taskcluster/kinds/artifact-build/kind.yml", "taskcluster/kinds/build-fat-aar/kind.yml", "taskcluster/kinds/build/android-asan.yml", "taskcluster/kinds/build/android-stuff.yml", "taskcluster/kinds/build/android.yml", "taskcluster/kinds/build/fenix.yml", "taskcluster/kinds/build/ios.yml", "taskcluster/kinds/build/kind.yml", "taskcluster/kinds/build/linux-base-toolchains.yml", "taskcluster/kinds/build/linux.yml", "taskcluster/kinds/build/macosx-native.yml", "taskcluster/kinds/build/macosx.yml", "taskcluster/kinds/build/windows-mingw.yml", "taskcluster/kinds/build/windows.yml", "taskcluster/kinds/instrumented-build/kind.yml", "taskcluster/kinds/release-source/kind.yml", "taskcluster/kinds/searchfox/kind.yml", "taskcluster/kinds/valgrind/kind.yml"], "git_node": "10c0082c1f1df6ed3497bb2e885aefcbcd52bedb", "git_parents": ["df32739573cd21a2199e2e700238ee1f8434e511"], "node": "443ee82fb4756df4e51aad7d36b8461a44073308", "parents": ["ca04652eafeda8d652b19066ce0339929338bc2b"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Take the mozconfig path from `MOZCONFIG` in mozharness builds. r=ahal\n\nmozharness builds now require `MOZCONFIG` in the task environment. mach\nreads that file itself, resolving the path against the source directory,\nso mozharness only logs it and no longer composes a mozconfig or writes\n`.mozconfig`. `get_mozconfig_path` stays for `desktop_l10n.py`.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327666\n", "files": ["testing/mozharness/mozharness/mozilla/building/buildbase.py"], "git_node": "854731b8d58936088915eac02a8be7c94ff96b3c", "git_parents": ["10c0082c1f1df6ed3497bb2e885aefcbcd52bedb"], "node": "80e4589bddce1bc266b72c2733de3d94b84fdbcc", "parents": ["443ee82fb4756df4e51aad7d36b8461a44073308"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073844 - Drop the mozconfig keys from the mozharness build configs. r=ahal\n\nNothing reads `app_name`, `mozconfig_platform`, `mozconfig_variant` or\n`src_mozconfig` from these files any more. Variant configs left with\nother settings stay as they are. Android variant configs that end up\nempty stay too, because `_is_configuration_shipped` still checks the\n`--custom-build-variant-cfg` name.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327667\n", "files": ["testing/mozharness/configs/builds/releng_base_android_64_builds.py", "testing/mozharness/configs/builds/releng_base_firefox.py", "testing/mozharness/configs/builds/releng_base_linux_64_builds.py", "testing/mozharness/configs/builds/releng_base_mac_64_cross_builds.py", "testing/mozharness/configs/builds/releng_base_windows_32_mingw_builds.py", "testing/mozharness/configs/builds/releng_base_windows_64_mingw_builds.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_fenix_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_aarch64_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_arm_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_fuzzing_asan_tc.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_fuzzing_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_geckoview_docs.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_ccov.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_debug.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_debug_isolated_process.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_lite.py", "testing/mozharness/configs/builds/releng_sub_android_configs/64_x86_64_profile_generate.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/32_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_rusttests_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_searchfox_and_opt.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_source.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_stat_and_debug.py", "testing/mozharness/configs/builds/releng_sub_linux_configs/64_valgrind.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_debug_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_cross_opt_searchfox.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_mac_configs/rusttests.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/32_mingwclang.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_add-on-devel.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_debug.py", "testing/mozharness/configs/builds/releng_sub_windows_configs/64_mingwclang.py", "testing/mozharness/configs/builds/taskcluster_base_win32.py", "testing/mozharness/configs/builds/taskcluster_base_win64.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/plain_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/rusttests_opt.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/searchfox_debug.py", "testing/mozharness/configs/builds/taskcluster_sub_win64/searchfox_opt.py"], "git_node": "b79878fd2f0d5f0415018264feda770c4bd48989", "git_parents": ["854731b8d58936088915eac02a8be7c94ff96b3c"], "node": "a9002fe162b56f4719f90b6cec7b8c457109798b", "parents": ["80e4589bddce1bc266b72c2733de3d94b84fdbcc"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073993 - Take sCreationMutex when clearing PermissionManager's sInstanceHolder at shutdown. r=permissions-reviewers,timhuang\n\nclang's -Wthread-safety-pointer warning warns when passing or returning\npointers to guarded data. It was added in clang 21 and will be enabled\nby default under -Wthread-safety in a future clang release.\n\n-Wthread-safety-pointer reports:\n\nextensions/permissions/PermissionManager.cpp: warning: passing pointer to variable 'sInstanceHolder' requires holding mutex 'sCreationMutex' [-Wthread-safety-pointer]\n  |     ClearOnShutdown(&sInstanceHolder);\n  |                      ^\n\nsInstanceHolder is MOZ_GUARDED_BY(sCreationMutex). The existing\n-Wthread-safety checks enforce that guard on direct reads and writes,\nbut taking the variable's address defeats them: ClearOnShutdown stores\nthe raw pointer in a PointerClearer and KillClearOnShutdown writes\nthrough it much later, with sCreationMutex not held.\n\nReplace it with RunOnShutdown and clear sInstanceHolder under the\nmutex like FinishAsyncShutdown(), so the write is guarded like every\nother access.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327744\n", "files": ["extensions/permissions/PermissionManager.cpp"], "git_node": "d5ca7fe9bd94ffea1a51019b144c935fff471def", "git_parents": ["b79878fd2f0d5f0415018264feda770c4bd48989"], "node": "2607f5f5ff72ee5f4be71f0f7fde9066a88c3404", "parents": ["a9002fe162b56f4719f90b6cec7b8c457109798b"], "tags": []}, {"author": "Chris Peterson \u003ccpeterson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073994 - Take sCachedAppPathMutex when clearing sCachedAppPath at shutdown. r=xpcom-reviewers,jstutte\n\nclang's -Wthread-safety-pointer warning warns when passing or returning\npointers to guarded data. It was added in clang 21 and will be enabled\nby default under -Wthread-safety in a future clang release.\n\n-Wthread-safety-pointer reports:\n\nxpcom/base/nsMacUtilsImpl.cpp: warning: passing pointer to variable 'sCachedAppPath' requires holding mutex 'sCachedAppPathMutex' [-Wthread-safety-pointer]\n  |   ClearOnShutdown(&sCachedAppPath);\n  |                    ^\n\nsCachedAppPath is MOZ_GUARDED_BY(sCachedAppPathMutex). ClearOnShutdown\nstores the raw address and writes through it at shutdown without holding\nthe mutex, so clang warns where the address is taken.\n\nReplace the ClearOnShutdown registration with RunOnShutdown and a lambda\nthat takes sCachedAppPathMutex before clearing sCachedApp\naccess to the pointer is then under its mutex, so the annotation is\nhonored instead of bypassed.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327741\n", "files": ["xpcom/base/nsMacUtilsImpl.cpp"], "git_node": "1f975e2c1827007ba81513aad03a7641c2373a8a", "git_parents": ["d5ca7fe9bd94ffea1a51019b144c935fff471def"], "node": "e6aa849dba3b9bab556c26f2cc8755e4489bb63e", "parents": ["2607f5f5ff72ee5f4be71f0f7fde9066a88c3404"], "tags": []}, {"author": "stransky \u003cstransky@redhat.com\u003e", "branch": "default", "desc": "Bug 2073852 Use maximal align for ffmpeg custom get_buffer2() buffer allocator r=alwu,media-playback-reviewers\n\nffmpeg/libavcodec/internal.h defines STRIDE_ALIGN for\navcodec_default_get_buffer2() according to used instructions set.\nThe recent biggest value is 64 for AVX-512.\nWe need to keep our internal align in sync with the biggest value\nto make sure our custom get_buffer2() allocator works with any system\nprovided ffmpeg.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327769\n", "files": ["dom/media/platforms/ffmpeg/FFmpegUtils.h", "dom/media/platforms/ffmpeg/FFmpegVideoDecoder.cpp", "dom/media/test/mochitest.toml", "dom/media/test/test_vp9_buffer_overread.html", "dom/media/test/vp9_256x128.webm", "dom/media/test/vp9_256x128.webm^headers^"], "git_node": "6de9ea44eee824c26900ba188f46fc8c191da97b", "git_parents": ["1f975e2c1827007ba81513aad03a7641c2373a8a"], "node": "f89444c48a8bea195c5eb0c71b2c2a0b16907f85", "parents": ["e6aa849dba3b9bab556c26f2cc8755e4489bb63e"], "tags": []}, {"author": "Sugarycandybar \u003ccandybaralt@gmail.com\u003e", "branch": "default", "desc": "Bug 2067952 - Pick largest MediaMetadata artwork sizes first. r=media-playback-reviewers,stransky\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323921\n", "files": ["dom/media/mediasession/MediaMetadata.cpp", "dom/media/mediasession/MediaMetadata.h", "dom/media/mediasession/test/gtest/TestMediaMetadataArtwork.cpp", "dom/media/mediasession/test/gtest/moz.build"], "git_node": "21a0d76d611043be577c99432a747fa4b7f327ef", "git_parents": ["6de9ea44eee824c26900ba188f46fc8c191da97b"], "node": "3f6140d9ef795b6c81966392b44565d4d5c14076", "parents": ["f89444c48a8bea195c5eb0c71b2c2a0b16907f85"], "tags": []}, {"author": "Randell Jesup \u003crjesup@mozilla.com\u003e", "branch": "default", "desc": "Bug 2026894 - Let a WebSocket upgrade fall back to the other address family when its first endpoint dies mid-handshake. r=necko-reviewers,kershaw\n\nA wss:// connection to a dual-stack host failed with\nNS_ERROR_WEBSOCKET_CONNECTION_REFUSED when the preferred (IPv6) endpoint\naccepted the TCP connection but died before responding, while https:// to\nthe same host fell back to IPv4.  Two fixes:\n\nnsHttpTransaction::Close would not restart a transaction carrying\nNS_HTTP_STICKY_CONNECTION.  Upgrades set that flag to bind the upgraded\nconnection, not for connection-based auth, and nothing is bound before the\nresponse arrives, so allow the restart until then.\n\nHappyEyeballsConnectionAttempt aborted the race for any security-module\nerror, but NSPR errors such as PR_END_OF_FILE_ERROR are tagged with that\nmodule whenever NSS drives the socket.  Map them back to network-module\ncodes before classifying so the race continues; genuine NSS errors still\nabort.  This also fixes plain https:// on the Happy Eyeballs path.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323973\n", "files": ["netwerk/protocol/http/HappyEyeballsConnectionAttempt.cpp", "netwerk/protocol/http/nsHttpTransaction.cpp", "netwerk/protocol/http/nsHttpTransaction.h", "netwerk/test/unit/test_websocket_ipv6_fallback.js", "netwerk/test/unit/xpcshell.toml"], "git_node": "ebb5564ffb8725d6442e54844bf6124521c56bac", "git_parents": ["21a0d76d611043be577c99432a747fa4b7f327ef"], "node": "a0e5acb90382e1c0f05756a086b4efee2b820979", "parents": ["3f6140d9ef795b6c81966392b44565d4d5c14076"], "tags": []}, {"author": "Norisz Fay \u003cnfay@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2073844 - Drop the mozconfig keys from the mozharness build configs. r=ahal\" for causing gecko decision bustage\n\nThis reverts commit b79878fd2f0d5f0415018264feda770c4bd48989.\n\nRevert \"Bug 2073844 - Take the mozconfig path from `MOZCONFIG` in mozharness builds. r=ahal\"\n\nThis reverts commit 854731b8d58936088915eac02a8be7c94ff96b3c.\n\nRevert \"Bug 2073844 - Set `MOZCONFIG` in the environment of build tasks from a `mozconfig` key. r=ahal,taskgraph-reviewers,releng-reviewers\"\n\nThis reverts commit 10c0082c1f1df6ed3497bb2e885aefcbcd52bedb.\n\nRevert \"Bug 2073844 - Replace `extra_mozconfig_content` with mozconfig files. r=ahal\"\n\nThis reverts commit df32739573cd21a2199e2e700238ee1f8434e511.\n", "files": ["browser/config/mozconfigs/linux64-aarch64/beta", "browser/config/mozconfigs/linux64-aarch64/debug", "browser/config/mozconfigs/linux64-aarch64/devedition", "browser/config/mozconfigs/linux64-aarch64/nightly", "browser/config/mozconfigs/linux64-aarch64/profile-generate", "browser/config/mozconfigs/linux64-aarch64/release", "browser/config/mozconfigs/linux64/debug-base-toolchains", "browser/config/mozconfigs/linux64/nightly-base-toolchains", "browser/config/mozconfigs/linux64/non-unified", "browser/config/mozconfigs/linux64/non-unified-debug", "browser/config/mozconfigs/linux64/profile-generate-as-release", "browser/config/mozconfigs/macosx64-aarch64/debug", "browser/config/mozconfigs/macosx64-aarch64/debug-searchfox", "browser/config/mozconfigs/macosx64-aarch64/opt", "browser/config/mozconfigs/macosx64-aarch64/opt-searchfox", "browser/config/mozconfigs/macosx64-aarch64/profile-generate-as-release", "browser/config/mozconfigs/macosx64/non-unified", "browser/config/mozconfigs/win64/non-unified", "browser/config/mozconfigs/win64/profile-generate-as-release", "mobile/android/config/mozconfigs/android-aarch64-lite/beta", "mobile/android/config/mozconfigs/android-aarch64-lite/nightly", "mobile/android/config/mozconfigs/android-aarch64-lite/release", "mobile/android/config/mozconfigs/android-aarch64/non-unified", "mobile/android/config/mozconfigs/android-arm-lite/beta", "mobile/android