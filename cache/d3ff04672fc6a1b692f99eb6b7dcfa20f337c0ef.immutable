ncode_api_test.cc", "third_party/aom/test/end_to_end_psnr_test.cc", "third_party/aom/test/forced_max_frame_width_height_test.cc", "third_party/aom/test/frame_size_tests.cc", "third_party/aom/test/quantize_func_test.cc", "third_party/aom/test/ratectrl_rtc_test.cc", "third_party/aom/test/rt_end_to_end_test.cc", "third_party/aom/test/sse_sum_test.cc", "third_party/aom/test/sum_squares_test.cc", "third_party/aom/test/svc_datarate_test.cc", "third_party/aom/test/test.cmake", "third_party/aom/test/variance_test.cc", "third_party/aom/test/wiener_test.cc"], "git_node": "29a7cbc975892b25771f6bc6a66f411c7ec70b53", "git_parents": ["b151b337db6ff0ec633b5b4281f684a18a852dec"], "node": "36a8bc658519ddfd36cbeb9f333b6d7632bb9a7d", "parents": ["69e7b6320d6025a92ef1767df029b1b3242c8220"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2077866 - Apply local patches to libaom. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330725\n", "files": ["third_party/aom/aom_dsp/x86/synonyms.h", "third_party/aom/aom_dsp/x86/synonyms_avx2.h"], "git_node": "4e372fd0c859918177f3ea6d9035ca38bc8c7618", "git_parents": ["29a7cbc975892b25771f6bc6a66f411c7ec70b53"], "node": "5ad6cfecf2f999b824e49c9bdc0b338c66df6ee6", "parents": ["36a8bc658519ddfd36cbeb9f333b6d7632bb9a7d"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2077866 - Add a crashtest for AV1 encoding of frames whose size isn't a multiple of 8. r=media-playback-reviewers,azebrowski\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330726\n", "files": ["dom/media/webcodecs/crashtests/2077866.html", "dom/media/webcodecs/crashtests/crashtests.list"], "git_node": "266a155088bad916d0dfa2824c7cb067cba5d545", "git_parents": ["4e372fd0c859918177f3ea6d9035ca38bc8c7618"], "node": "c83ce5513fe2b070c2d974c06007bb761696cac4", "parents": ["5ad6cfecf2f999b824e49c9bdc0b338c66df6ee6"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1726898 - Share the atomic refcount decrement and annotate its acquire for TSan. r=xpcom-reviewers,mfbt-reviewers,firefox-style-system-reviewers,emilio\n\nUnder TSan the acquire fence after the final decrement was replaced by a load of\nthe refcount, which reads it after the reference was given up. That races with\nnsDynamicAtom objects being freed by the atom table GC on another thread.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330697\n", "files": ["layout/style/ServoStyleConstsInlines.h", "mfbt/Atomics.h", "mfbt/RefCounted.h", "mfbt/api.yml", "xpcom/base/nsISupportsImpl.h"], "git_node": "53db12495bc254d9d6e8cd8c69a0a96a29cfad6e", "git_parents": ["266a155088bad916d0dfa2824c7cb067cba5d545"], "node": "8e2d142bc7abba57fc4017126cb9c332ce7afdcc", "parents": ["c83ce5513fe2b070c2d974c06007bb761696cac4"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 1726898 - Test that another thread can free an object as soon as its ThreadSafeAutoRefCnt drops to zero. r=xpcom-reviewers,emilio\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330698\n", "files": ["xpcom/tests/gtest/TestAutoRefCnt.cpp"], "git_node": "31913395f26820a24803b33d4d10e2cffdfd4e11", "git_parents": ["53db12495bc254d9d6e8cd8c69a0a96a29cfad6e"], "node": "c49f4946b16e5e88fe3ed59e60212aea634af809", "parents": ["8e2d142bc7abba57fc4017126cb9c332ce7afdcc"], "tags": []}, {"author": "Alejandro Savransky \u003casavransky@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076563 - Land strings for second lapsed-user Windows toast notification r=aminomancer,fluent-reviewers,omc-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329838\n", "files": ["browser/locales/en-US/browser/newtab/asrouter.ftl"], "git_node": "e9f489a597ed52d2f22168061383f904555a5333", "git_parents": ["31913395f26820a24803b33d4d10e2cffdfd4e11"], "node": "f89d998b47b54add6bd33c1e7e01ed4dc819a722", "parents": ["c49f4946b16e5e88fe3ed59e60212aea634af809"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065275 - Create new smoke UI test for the redesigned homepage UI r=jajohnson,aaronmt\n\nAdds HomeScreenRedesignedUITest#verifyHomeScreenUITest, a presence test for the homepage after the entry-points redesign.\n- Introduces the isPrivateModeAndStoriesEntryPointEnabled launch flag, threaded through LaunchConfig (and its asMeta trace), BaseTest, and the activity rule. The test class enables it together with Pocket, since the experimental header only renders under both, which is why this lives in its own class rather than HomeTest, which runs with Pocket disabled.\n- New HomeSelectors for the redesigned surface: PRIVATE_MODE_BUTTON, STORIES_BUTTON, and TRACKERS_BLOCKED_CARD, a state-independent tag handle on the blocked-trackers pill, since its label textvaries with the tracker count.\n- Verifies the experimental header (private-mode button, Firefox wordmark, stories entry point), the navigation bar (search box, tab counter at zero, main menu), the default top-site shortcuts, and the blocked-trackers widget.\n\nThe UI test successfully passed 50x on Firebase.  [[ https://treeherder.mozilla.org/jobs?repo=try&revision=527f4553c9f6bc0aa1a9c8303da0a61a0fa6e4e4&selectedTaskRun=H_gCz04KQLmcKyT1iPoq-A.0 | try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=40aca90e5bf4503232b891c4343e350c4bac8482&selectedTaskRun=SdUdgmoyTFuf0C1a1mqvdA.0 | try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320415\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/BaseTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/navigation/LaunchConfig.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/HomeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HomeScreenRedesignedUITest.kt"], "git_node": "c34e3dfcbf2bc7e03ec5d986d8d4c4262704eba4", "git_parents": ["e9f489a597ed52d2f22168061383f904555a5333"], "node": "c21292a3437c0d72207ede13bae92995b387aafd", "parents": ["f89d998b47b54add6bd33c1e7e01ed4dc819a722"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2065283 - Create new smoke UI test for the Stories view UI r=jajohnson,aaronmt\n\nAdds HomeScreenRedesignedUITest#verifyStoriesViewUITest, which opens the Stories view via the homepage stories entry point and verifies its static chrome.\n- New StoriesPage page object and StoriesSelectors on the ui/efficiency selector API: StoriesSelectors is a SelectorContainer with a STORIES_VIEW group; NEWS_HEADER is the page identity anchor (readiness = IDENTITY_ANCHOR) and HOME_BUTTON belongs to the STORIES_VIEW group. StoriesPage declares its edges in registerNavigation() and exposes its catalog via selectorCatalog. Registered as on.stories in PageContext.\n- The HomePage -\u003e StoriesPage edge declares launch = LaunchConfig(isPocketEnabled = true, isPrivateModeAndStoriesEntryPointEnabled = true), so the auto-generated reachability case launches with the experimental header enabled and the stories entry point present.\n- Asserts only the static chrome (News header, Home button); the dynamic, network-backed story items expose no stable handles and are deliberately not asserted.\n- Reuses the stories entry point and flag introduced in the homepage commit.\n\nThe UI test successfully passed 50x on Firebase.  [[ https://treeherder.mozilla.org/jobs?repo=try&revision=527f4553c9f6bc0aa1a9c8303da0a61a0fa6e4e4&selectedTaskRun=H_gCz04KQLmcKyT1iPoq-A.0 | try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&revision=40aca90e5bf4503232b891c4343e350c4bac8482&selectedTaskRun=SdUdgmoyTFuf0C1a1mqvdA.0 | try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320416\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/helpers/PageContext.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/StoriesPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/StoriesSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/HomeScreenRedesignedUITest.kt"], "git_node": "82d77d5983dce83c090a170d2f01bfd4634d40c2", "git_parents": ["c34e3dfcbf2bc7e03ec5d986d8d4c4262704eba4"], "node": "55436a09c37babc014d45fe5b7342b1817416850", "parents": ["c21292a3437c0d72207ede13bae92995b387aafd"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077398: Mark nsIASWebAuthSessionRequest as macOS-only for the valid-ci-uses ESLint rule. r=frontend-codestyle-reviewers,mossop\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330442\n", "files": ["tools/lint/eslint/eslint-plugin-mozilla/lib/rules/valid-ci-uses.mjs"], "git_node": "85a88577309d8d28185d05f6729fea454af95955", "git_parents": ["82d77d5983dce83c090a170d2f01bfd4634d40c2"], "node": "ba7d914c461af297b27a37fa90737b26a4c2fbd1", "parents": ["55436a09c37babc014d45fe5b7342b1817416850"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075133 - Create new verifyTheCustomizeHomepageMenuItemTest regression UI test r=aaronmt\n\nThe UI test successfully passed 50x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&revision=c199f8bf4876780f47c75a9064c72c452fa3741a\nAll efficiency UI tests successfully passed 1x on Firebase. https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=96916\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328868\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/MainMenuPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsHomepagePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsHomepageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/MainMenuTest.kt"], "git_node": "be0c4d8feba478626f512a1789ebf59e767d511b", "git_parents": ["85a88577309d8d28185d05f6729fea454af95955"], "node": "365871ab641bef16ce912843846d2b0c6b82b0d6", "parents": ["ba7d914c461af297b27a37fa90737b26a4c2fbd1"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2063100 - Scope disabling denormals to wasm JIT code. r=jandem\n\n1. Add ldmxcsr to x86-shared assembler.\n2. Add ContextOptions::wasmDisablesDenormals.\n3. Add --disable-main-thread-wasm-denormals JS shell flag.\n4. Remove --disable-main-thread-denormals JS shell flag.\n5. Add DenormalsDisabled and assert in many places denormals are\n   enabled.\n6. Add wasm::Instance flags/cached mxcsr data.\n7. Add EnterWasmFPEnvironment and LeaveWasmFPEnvironment masm methods\n   which dynamically switch mxcsr.\n8. Update all wasm JIT entry/exits to enter/leave the wasm FP\n   environment.\n9. Remove tests that presume JS running with denormals disabled.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D318273\n", "files": ["js/public/ContextOptions.h", "js/src/builtin/Math.cpp", "js/src/builtin/TestingFunctions.cpp", "js/src/gc/GC.cpp", "js/src/jit-test/tests/auto-regress/bug1940716.js", "js/src/jit-test/tests/basic/math-denormals-canonical-nan.js", "js/src/jit-test/tests/ion/bug1982383.js", "js/src/jit-test/tests/ion/bug2014368.js", "js/src/jit-test/tests/ion/bug2053680.js", "js/src/jit-test/tests/self-test/denormals-1.js", "js/src/jit-test/tests/wasm/denormals.js", "js/src/jit/Ion.cpp", "js/src/jit/JitContext.cpp", "js/src/jit/x86-shared/Assembler-x86-shared.h", "js/src/jit/x86-shared/BaseAssembler-x86-shared.h", "js/src/jsapi.cpp", "js/src/shell/fuzz-flags.txt", "js/src/shell/js.cpp", "js/src/util/Denormals.h", "js/src/vm/HelperThreads.cpp", "js/src/vm/Interpreter.cpp", "js/src/wasm/WasmBuiltins.cpp", "js/src/wasm/WasmBuiltins.h", "js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmFrameIter.h", "js/src/wasm/WasmInstance.cpp", "js/src/wasm/WasmInstance.h", "js/src/wasm/WasmStubs.cpp"], "git_node": "3de0327af77ad8b10036e4147d91e3f2020b3731", "git_parents": ["be0c4d8feba478626f512a1789ebf59e767d511b"], "node": "acd568dccf1d821effcb3f1f13a9c842cca35eb9", "parents": ["365871ab641bef16ce912843846d2b0c6b82b0d6"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2063100 - Set wasmDisablesDenormals for audio worklets and scope to DSP. r=padenot,media-playback-reviewers,aosmond\n\n1. Add a DenormalsEnabler and organize the internals a bit for sharing\n   code.\n2. Move DenormalsDisabler from OneIterationImpl to Process to scope it\n   to just processing audio.\n3. Add DenoramslEnabler around AudioWorklet script execution\n4. Set wasmDisablesDenormals when creating a JSContext for an\n   AudioWorklet.\n\nThe net effect should be that native audio nodes continue to get DAZ/FTZ,\nJS gets normal IEEE behavior, and wasm gets DAZ/FTZ.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320601\n", "files": ["dom/media/MediaTrackGraph.cpp", "dom/media/webaudio/AudioWorkletNode.cpp", "dom/media/webaudio/blink/DenormalDisabler.h", "dom/worklet/WorkletFetchHandler.cpp", "testing/web-platform/meta/webaudio/the-audio-api/the-audioworklet-interface/audioworklet-denormals.https.window.js.ini"], "git_node": "b8886bc210dabfe199bb82f1bc975232def6cf75", "git_parents": ["3de0327af77ad8b10036e4147d91e3f2020b3731"], "node": "c21cff37a2939b9233057a019a4e231c30589183", "parents": ["acd568dccf1d821effcb3f1f13a9c842cca35eb9"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2063100: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["js/src/wasm/WasmFrameIter.cpp", "js/src/wasm/WasmFrameIter.h", "js/src/wasm/WasmStubs.cpp"], "git_node": "83e53ae0828c05a5a1950616d490795884e7a034", "git_parents": ["b8886bc210dabfe199bb82f1bc975232def6cf75"], "node": "06eeee14efaf5109d65204837bf116c249136244", "parents": ["c21cff37a2939b9233057a019a4e231c30589183"], "tags": []}, {"author": "Delia Pop \u003cdpop@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076482 - Create new regression UI tests related to ETP r=aaronmt\n\nThe new UI tests successfully passed 50x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=100035  | Try ]]\nAll efficiency UI tests successfully passed 1x on Firebase. [[ https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=100034  | Try ]]\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329906\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/LoginsTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsEnhancedTrackingProtectionExceptionsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsEnhancedTrackingProtectionPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/UnifiedTrustPanelPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsEnhancedTrackingProtectionBlockingSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsEnhancedTrackingProtectionExceptionsSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsEnhancedTrackingProtectionSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/UnifiedTrustPanelSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsEnhancedTrackingProtectionTest.kt"], "git_node": "eb51febce159665ef7f282c8912d1b4758aeb868", "git_parents": ["83e53ae0828c05a5a1950616d490795884e7a034"], "node": "13aeeb171d7aa32bd45868019d1f770a819639c3", "parents": ["06eeee14efaf5109d65204837bf116c249136244"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076729 - Part 1: Fix the `ContinuousOnboardingFeature` logger tag and class doc. r=android-reviewers,cbect\n\nThe logger tag still carried a stale `Default` suffix from an earlier class name, and the class doc listed the stages with a dangling \"or\" before the last item.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330331\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/continuous/ContinuousOnboardingFeature.kt"], "git_node": "bedd5a6f7a72d5a59e3f533d83a77d6cb39a64b2", "git_parents": ["eb51febce159665ef7f282c8912d1b4758aeb868"], "node": "32e28ed1227ba03be80ae79a8d30093a93b28f3e", "parents": ["13aeeb171d7aa32bd45868019d1f770a819639c3"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076729 - Part 2: Refactor to extract the continuous-onboarding-completed check into `Settings`. r=android-reviewers,gmalekpour\n\nThe same predicate was duplicated in `ContinuousOnboardingFeature` and the review prompt's `continuousOnboardingInProgress` gate, and Part 3 adds a third consumer. Also rename the feature's private session-scoped check so it is not confused with the persisted onboarding progress.\n\nNo behavior change.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329918\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/Components.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/onboarding/continuous/ContinuousOnboardingFeature.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/onboarding/continuous/ContinuousOnboardingFeatureTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "cdfba5564f88ef9e422d9c1bff722ac7cf99c813", "git_parents": ["bedd5a6f7a72d5a59e3f533d83a77d6cb39a64b2"], "node": "d93b6bde98ca6f87cfd969cb3538f2ff39fae7b9", "parents": ["32e28ed1227ba03be80ae79a8d30093a93b28f3e"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076729 - Part 3: Suppress the set-as-default prompt while continuous onboarding is in progress. r=android-reviewers,gmalekpour\n\nThe day-2 and day-3 continuous onboarding stages already request the default-browser role, so the standalone prompt in `HomeActivity` double-asked within the first week, typically on the fourth cold start alongside the day-5 Sync card.\n\nDepends on bug 2074040: until the onboarding state reconciliation runs on every channel, users who never received continuous onboarding have day 7 permanently unset and would otherwise lose this prompt.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329919\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/utils/Settings.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/utils/SettingsTest.kt"], "git_node": "f74cbcf4ef90ea2df0eb1512f06cf4a927fdca45", "git_parents": ["cdfba5564f88ef9e422d9c1bff722ac7cf99c813"], "node": "438ce736c02646d1ffd3832d5949387a22f3dc29", "parents": ["d93b6bde98ca6f87cfd969cb3538f2ff39fae7b9"], "tags": []}, {"author": "Beth Rennie \u003cbeth@brennie.ca\u003e", "branch": "default", "desc": "Bug 2058659 - Use WebIDL dictionary for Nimbus experiment metadata r=nimbus-reviewers,webidl,emilio,aminomancer\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323709\n", "files": ["dom/chrome-webidl/Nimbus.webidl", "dom/chrome-webidl/moz.build", "toolkit/components/nimbus/lib/NimbusFeatures.cpp"], "git_node": "5dfa60378e782ba9ce00f03d587f96416cd8fe19", "git_parents": ["f74cbcf4ef90ea2df0eb1512f06cf4a927fdca45"], "node": "081212bd6e5534ba0110894283159f8283eac0c5", "parents": ["438ce736c02646d1ffd3832d5949387a22f3dc29"], "tags": []}, {"author": "David Rubino \u003cdrubino@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076419 - Call secondsSinceLastAppRun by its IDL name in the default agent task. r=cdupuis\n\nThe capitalized name is undefined in JS, so the call always threw and the task\nbehaved as if the app had just run: days_since_last_app_launch was always 0 and\nthe 90-day expiry never applied.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329728\n", "files": ["toolkit/mozapps/defaultagent/BackgroundTask_defaultagent.sys.mjs", "toolkit/mozapps/defaultagent/tests/xpcshell/test_backgroundtask_defaultagent.js"], "git_node": "ee6a8a6a701bf661c3bcd068f1ee354e846e70cc", "git_parents": ["5dfa60378e782ba9ce00f03d587f96416cd8fe19"], "node": "a75de0ca70e2c77329413725cd442b0a8a2efb18", "parents": ["081212bd6e5534ba0110894283159f8283eac0c5"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076900 - Issue a warning in devtools when promise resolve is re-ordered r=dom-core-reviewers,devtools-reviewers,smaug,nchevobbe\" for causing mochitest failures @test_safe_resolve_warning.html.\n\nThis reverts commit 3408849672a3f285fde168966da8071a0e7aec05.\n\nRevert \"Bug 2076900 - Indicate to caller whether or not SafePromiseResolve did deferred resolution r=spidermonkey-reviewers,yulia\"\n\nThis reverts commit e07f3e5053f40823ce7c5360d930a931449bcc78.\n", "files": ["devtools/server/actors/errordocs.js", "dom/base/Document.cpp", "dom/base/nsDocumentWarningList.inc", "dom/docs/index.md", "dom/docs/promise/safe-promise-resolve.md", "dom/locales/en-US/chrome/dom/dom.properties", "dom/promise/Promise.cpp", "dom/promise/tests/mochitest.toml", "dom/promise/tests/test_safe_resolve_warning.html", "js/public/Promise.h", "js/src/builtin/Promise.cpp", "js/src/builtin/Promise.h", "js/src/jsapi.cpp"], "git_node": "bde1ce2a829d8b5a27fa8f1a37f2d2245954c06d", "git_parents": ["ee6a8a6a701bf661c3bcd068f1ee354e846e70cc"], "node": "6cb6977a58a6842465da00c464521ce5d0a59f82", "parents": ["a75de0ca70e2c77329413725cd442b0a8a2efb18"], "tags": []}, {"author": "David Rubino \u003cdrubino@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076962 - Remove the os.environment.desktop_entry_exists metric. r=mossop\n\nIt sized how many Linux users lack a Firefox desktop entry, for the GNOME issue in bug 2021458. Release data now answers that (about 1%). nsIGNOMEShellService.getDesktopEntryStatus stays for a future runtime check.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330396\n", "files": ["browser/components/StartupTelemetry.sys.mjs", "browser/components/metrics.yaml", "browser/components/tests/browser/browser_browserGlue_telemetry.js", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "f97431757daedf35a145f445669c5d5ed2e302e1", "git_parents": ["bde1ce2a829d8b5a27fa8f1a37f2d2245954c06d"], "node": "a7ff0fe7510bdb048ed18c9da9807d4cb1e73a63", "parents": ["6cb6977a58a6842465da00c464521ce5d0a59f82"], "tags": []}, {"author": "nickgrato \u003cngrato@gmail.com\u003e", "branch": "default", "desc": "Bug 2074597 - [MON][FE] Audit strings in aiWindow.ftl and rename monitor to tasks r=again,fluent-reviewers,bolsson\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329070\n", "files": ["browser/components/aiwindow/models/agents/MonitorAgent.sys.mjs", "browser/locales-preview/aiWindow.ftl"], "git_node": "f960913c1759d08087599f8de370919c542acc54", "git_parents": ["f97431757daedf35a145f445669c5d5ed2e302e1"], "node": "e6f73208e6b9f78704cbefd6ce4f1959de43aa51", "parents": ["a7ff0fe7510bdb048ed18c9da9807d4cb1e73a63"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074182 - Give menu items marked auto-accesskey their label's first letter or digit as the accesskey, and mark extension menu items. r=robwu,sidebar-reviewers,frontend-codestyle-reviewers,reusable-components-reviewers,tgiles,kcochrane\n\npanel-list gets the same support as menupopup, but nothing uses it there yet. It now imports both modules by chrome URL, which a content page can't load, so test_panel_list_shadow_node_anchor.html becomes a chrome test.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328788\n", "files": ["browser/components/extensions/parent/ext-menus.js", "browser/components/extensions/test/browser/browser_ext_menus_accesskey.js", "browser/components/sidebar/browser-sidebar.js", "browser/components/sidebar/tests/browser/browser_view_sidebar_menu.js", "toolkit/content/jar.mn", "toolkit/content/tests/chrome/test_menu_accesskey_conflicts.xhtml", "toolkit/content/tests/widgets/chrome-nova.toml", "toolkit/content/tests/widgets/chrome.toml", "toolkit/content/tests/widgets/mochitest.toml", "toolkit/content/tests/widgets/test_panel_list_accesskey_conflicts.html", "toolkit/content/tests/widgets/test_panel_list_shadow_node_anchor.html", "toolkit/content/widgets/accesskey-check.mjs", "toolkit/content/widgets/auto-accesskey.mjs", "toolkit/content/widgets/menupopup.js", "toolkit/content/widgets/panel-list/accesskey-check.mjs", "toolkit/content/widgets/panel-list/panel-list.mjs"], "git_node": "1644bbb88690af61795747e2692e97a6dca3185d", "git_parents": ["f960913c1759d08087599f8de370919c542acc54"], "node": "44e6c83e96c1717dd6117cb9386aa9911e8b6262", "parents": ["e6f73208e6b9f78704cbefd6ce4f1959de43aa51"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075142 - Give an auto-accesskey item with no typeable letter or digit in its label an unused digit as its accesskey. r=robwu,reusable-components-reviewers,tgiles\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328803\n", "files": ["browser/components/extensions/test/browser/browser_ext_menus_accesskey.js", "toolkit/content/tests/chrome/test_menu_accesskey_conflicts.xhtml", "toolkit/content/widgets/auto-accesskey.mjs"], "git_node": "8477ead2e27d93eb13cf6dbbacbddcdca71d2a65", "git_parents": ["1644bbb88690af61795747e2692e97a6dca3185d"], "node": "fded4a3d32718d3fbddea32938e5a124f2a6aaf9", "parents": ["44e6c83e96c1717dd6117cb9386aa9911e8b6262"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073901 - Give spelling suggestions and dictionary items auto accesskeys. r=firefox-desktop-core-reviewers ,mossop\n\n\"No Spelling Suggestions\" only displays information, so it gets role=\"note\", as the content process ID item does, rather than an accesskey. Thunderbird's spelling menus share InlineSpellChecker and get the same accesskeys.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329594\n", "files": ["browser/base/content/browser-context.inc.xhtml", "browser/base/content/test/browser-contextMenu/browser_contextmenu_spellcheck.js", "browser/base/content/test/browser-contextMenu/contextmenu_common.js", "toolkit/modules/InlineSpellChecker.sys.mjs"], "git_node": "2ad63d15c621038bde26689bbf355db122ec437e", "git_parents": ["8477ead2e27d93eb13cf6dbbacbddcdca71d2a65"], "node": "823488ebf7f877f9c16471c129cf98c6a5874aea", "parents": ["fded4a3d32718d3fbddea32938e5a124f2a6aaf9"], "tags": []}, {"author": "Sandor Molnar \u003csmolnar@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077540 - Fix test_themes_preview_rtl computed link-parameters assertions on beta. r=rpl\n\nDifferential Re