de6bbcc0f4e2e9a1562eb79d7", "parents": ["3e41f4d5acb82fde3deb609f1b56189ae671388b"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079208 - Revise the wording of the message about Ctrl+Shift+A moving to Search Tabs. r=fluent-reviewers,flod DONTBUILD\n\nThis keeps the string IDs because no locale has translated these strings yet (no matches on searchfox.org/l10n as of 2026-10-07).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331562\n", "files": ["browser/locales/en-US/browser/browser.ftl"], "git_node": "4bed6e6c7e28dba0db91970152f19d00a7b08496", "git_parents": ["dd77228df5e10b9ed750f69e60500e478637c3ba"], "node": "65ec7450d267ed0a76b20317b24c60d804622483", "parents": ["66c2f833e06c460de6bbcc0f4e2e9a1562eb79d7"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1877510 - Let Enter in the edit bookmark folder tree save the bookmark. r=mak,places-reviewers\n\nRight and Left arrows still expand and collapse folders. The Bookmark Properties dialog shares the tree, so Enter there now accepts the dialog too.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330007\n", "files": ["browser/components/places/content/editBookmark.js", "browser/components/places/content/places-tree.js", "browser/components/places/tests/browser/browser_addBookmarkForFrame.js", "browser/components/places/tests/browser/browser_bookmark_popup.js"], "git_node": "02a0ffa2653f0dfc4b7d18845a985377c0a190a7", "git_parents": ["4bed6e6c7e28dba0db91970152f19d00a7b08496"], "node": "1fd3b1a6fa33c317062703af876d2d08a6cb25ab", "parents": ["65ec7450d267ed0a76b20317b24c60d804622483"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 1877510 - Add an access key to the bookmark panel's Save button. r=mak,fluent-reviewers,places-reviewers,flod\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330008\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/components/places/tests/browser/browser_bookmark_popup.js", "browser/locales/en-US/browser/browser.ftl"], "git_node": "ad5b15f10088265c0f63d0f1266574bf8d2b1972", "git_parents": ["02a0ffa2653f0dfc4b7d18845a985377c0a190a7"], "node": "b04e8d448dccc60cea90d2f38a4f0b3f9636ada0", "parents": ["1fd3b1a6fa33c317062703af876d2d08a6cb25ab"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Use registerCleanupFunction in browser_permission_dismiss.js so its cleanup runs, r=saschanaz.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331130\n", "files": ["dom/notification/test/browser/browser_permission_dismiss.js"], "git_node": "db2a5a71ac9654a4baf2e77111b383643d6f0ca8", "git_parents": ["ad5b15f10088265c0f63d0f1266574bf8d2b1972"], "node": "24b912784b7def761d1ebea1a7fb9963c55d13c4", "parents": ["b04e8d448dccc60cea90d2f38a4f0b3f9636ada0"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in browser/components/enterprisepolicies, r=mkaply.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331132\n", "files": ["browser/components/enterprisepolicies/tests/browser/head.js"], "git_node": "172a3c6bab04a8efcd07bb39e6c3063159a5e769", "git_parents": ["db2a5a71ac9654a4baf2e77111b383643d6f0ca8"], "node": "60b36484dde49841f3f05e239ba6a341d86b3a43", "parents": ["24b912784b7def761d1ebea1a7fb9963c55d13c4"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in devtools/client/storage, r=devtools-reviewers,nchevobbe.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331135\n", "files": ["devtools/client/storage/test/head.js"], "git_node": "9080ed9ee221e0ca0fb4cbc75e2f87cbe48564a8", "git_parents": ["172a3c6bab04a8efcd07bb39e6c3063159a5e769"], "node": "fd16116488dbc65d7574046399a681891356880d", "parents": ["60b36484dde49841f3f05e239ba6a341d86b3a43"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in dom/indexedDB, r=dom-storage-reviewers,jesup.\n\nsetPermission now removes the permission it adds at the end of the test. browser_forgetThisSite.js now waits for ForgetAboutSite before setting the permission for the next task, otherwise the permission could be set after the cleanup functions had already run.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331136\n", "files": ["dom/indexedDB/test/browser_forgetThisSite.js", "dom/indexedDB/test/head.js"], "git_node": "20ac49efe922376286bb1f6f68b15f5d7b791fbf", "git_parents": ["9080ed9ee221e0ca0fb4cbc75e2f87cbe48564a8"], "node": "d83c7c2191543c198cfdf85fa3fa3eac2c6fa4c9", "parents": ["fd16116488dbc65d7574046399a681891356880d"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in extensions/permissions, r=permissions-reviewers,emz.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331137\n", "files": ["extensions/permissions/test/browser_permmgr_sync.js", "extensions/permissions/test/browser_permmgr_viewsrc.js"], "git_node": "b38562b55c03769e35c007d90c6345bc675184ac", "git_parents": ["20ac49efe922376286bb1f6f68b15f5d7b791fbf"], "node": "0c7cf2bf131229c202b0fb8b0d932f243f98a202", "parents": ["d83c7c2191543c198cfdf85fa3fa3eac2c6fa4c9"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Clean up permissions left by tests in browser/base/content/test/browser-webrtc, r=webrtc-reviewers,pehrsons.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331138\n", "files": ["browser/base/content/test/browser-webrtc/head.js"], "git_node": "63c204400558a3b42f9a146efc8f74dc3d2080a7", "git_parents": ["b38562b55c03769e35c007d90c6345bc675184ac"], "node": "695d852070a7d45ea3ce31bda1eefdbe462fce00", "parents": ["0c7cf2bf131229c202b0fb8b0d932f243f98a202"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078564 - Stop clearing the default permissions in the local network access tests, r=necko-reviewers,jesup.\n\nThese tests set permissions.manager.defaultsUrl to \"\" and reload the permissions from disk, to start without the values RemoteSettings may have added. Their cleanup function reloads the permissions and calls removeAll() to restore the initial state, but it runs before the pref is restored, so the built-in default permissions (uitour, install, remote-troubleshooting, autoplay-media) are never re-imported and stay missing for the following tests. Reloading from disk is enough to purge the RemoteSettings values, and none of these tests depend on the built-in defaults being absent, so stop clearing the defaults URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331141\n", "files": ["netwerk/test/browser/browser_test_lna_insecure_context.js", "netwerk/test/browser/browser_test_local_network_trackers.js", "netwerk/test/browser/head_local_network_access.js"], "git_node": "2a370a7495897b04c8eef0f18e94a53dfc58d681", "git_parents": ["63c204400558a3b42f9a146efc8f74dc3d2080a7"], "node": "ee7d7091a064b891149a88588063c7744cd89151", "parents": ["695d852070a7d45ea3ce31bda1eefdbe462fce00"], "tags": []}, {"author": "Fabio Kaminski \u003cfabio.kaminski@codethink.co.uk\u003e", "branch": "default", "desc": "Bug 2078878 Skip ext-texture-norm16 test on Android #bug 1658801, r=florian\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331551\n", "files": ["dom/canvas/test/webgl-conf/generated/generated-mochitest-webgl2-core-conformance2.toml", "dom/canvas/test/webgl-conf/mochitest-errata.toml"], "git_node": "03a0a037a11a208190d2f4c346a0fdf82d75db40", "git_parents": ["2a370a7495897b04c8eef0f18e94a53dfc58d681"], "node": "8af54e75e75e3f4cb55b06f9d74619da0c85d77b", "parents": ["ee7d7091a064b891149a88588063c7744cd89151"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2076438 - Convert httpsOnlyModeMenuItemsTest and httpsOnlyModeExceptionPersistsForCurrentSessionTest regression UI test to the efficiency framework r=aaronmt\n\nBoth UI tests successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329754\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsHTTPSOnlyModeTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/SettingsHTTPSOnlyModePage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsHTTPSOnlyModeSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/SettingsHTTPSOnlyModeTest.kt"], "git_node": "f5b25430dd8c364d1e9bf4805627c8906745df0d", "git_parents": ["03a0a037a11a208190d2f4c346a0fdf82d75db40"], "node": "d2307afb09f2dd3ba8cb9c491027e230a9d57e26", "parents": ["8af54e75e75e3f4cb55b06f9d74619da0c85d77b"], "tags": []}, {"author": "Florian Qu\u00e8ze \u003cflorian@queze.net\u003e", "branch": "default", "desc": "Bug 2078569 - Make SimpleTest.registerCleanupFunction work in browser-chrome tests, r=Gijs,firefox-desktop-core-reviewers .\n\nSimpleTest only runs these cleanup functions from SimpleTest.finish(), which browser-chrome tests never call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331212\n", "files": ["testing/mochitest/browser-test.js"], "git_node": "abe5b47ee151d67af6842204b23ea19291195cdd", "git_parents": ["f5b25430dd8c364d1e9bf4805627c8906745df0d"], "node": "16aeb562e32daf0cb8e50715f192f0f99a89b65c", "parents": ["d2307afb09f2dd3ba8cb9c491027e230a9d57e26"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076268 - Simplify nsGenConInitializer. r=layout-reviewers,dshin\n\nNo need to create the list upfront, do it only when we get to initialize\nthe text frame.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331348\n", "files": ["layout/base/nsCSSFrameConstructor.cpp", "testing/web-platform/tests/css/css-contain/crashtests/contain-style-discarded-item.html"], "git_node": "84edf83684a29ceb7fbcbb1f3061dae64f830b2c", "git_parents": ["abe5b47ee151d67af6842204b23ea19291195cdd"], "node": "aab647729dbbc9997b6633066aec47cd3e43ba05", "parents": ["16aeb562e32daf0cb8e50715f192f0f99a89b65c"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2076268 - Don't create an unnecessary style scope from AddCounterChanges. r=layout-reviewers,dshin\n\nThis is a bit sketchy over-all, but is enough to prevent the\nfirst-letter code from messing up the style scoping, and I think it's\nsound, because first-letter can never pull a whole inline or somesuch...\n\nThis is only an issue for that code because ::first-letter will create a\nframe for an arbitrarily deep text node (but just the text, which can't\nhave counters). So if it manages to create something for a text node\nthat's about  to go away we end up with a stale scope.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331349\n", "files": ["layout/base/ContainStyleScopeManager.cpp", "layout/base/nsCounterManager.cpp", "layout/base/nsCounterManager.h", "testing/web-platform/tests/css/css-contain/crashtests/contain-style-first-letter-colgroup.html", "testing/web-platform/tests/css/css-contain/crashtests/contain-style-first-letter.html"], "git_node": "b0af5bf7cd945a4cdced2d13f554b9026931ca1b", "git_parents": ["84edf83684a29ceb7fbcbb1f3061dae64f830b2c"], "node": "89140e53922b7b6eace5194e5389fe0ddc2859cc", "parents": ["aab647729dbbc9997b6633066aec47cd3e43ba05"], "tags": []}, {"author": "Emilio Cobos \u00c1lvarez \u003cemilio@crisal.io\u003e", "branch": "default", "desc": "Bug 2072310 - Only walk across fragments for some callers of GetNextRow(). r=layout-reviewers,dshin\n\nOnly the border-collapsing code and CalcUnpaginatedBSize care about\nnon-local row groups.\n\nGetPrevRow() has no callers that care about the cross-fragment case, so\njust don't add such an API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331372\n", "files": ["layout/tables/nsTableCellFrame.cpp", "layout/tables/nsTableFrame.cpp", "layout/tables/nsTableRowFrame.cpp", "layout/tables/nsTableRowFrame.h", "testing/web-platform/tests/css/printing/table-row-group-float-crash-print.html"], "git_node": "0c14f089ccb30ec6ae20b730d8e2745df9c0fc72", "git_parents": ["b0af5bf7cd945a4cdced2d13f554b9026931ca1b"], "node": "3d6c8bb3e9da7c81529e1d2d3dd9f17e0044e05a", "parents": ["89140e53922b7b6eace5194e5389fe0ddc2859cc"], "tags": []}, {"author": "Julien Cristau \u003cjcristau@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079215 - Don't generate the SBOM in artifact builds. r=firefox-build-system-reviewers,sylvestre DONTBUILD\n\nTry artifact builds of shippable tasks keep MOZ_GENERATE_SBOM, but they\nhave no Rust toolchain for `cargo metadata`, and the FasterMake backend\ncan't build the `.cargo/config.toml` dependency of the SBOM files.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331576\n", "files": ["moz.configure"], "git_node": "4ddd06bced5c46d161feaae577eccac427ae3df9", "git_parents": ["0c14f089ccb30ec6ae20b730d8e2745df9c0fc72"], "node": "730a270d741aa381b6eacc2d81c32c1da56137e9", "parents": ["3d6c8bb3e9da7c81529e1d2d3dd9f17e0044e05a"], "tags": []}, {"author": "Tom Schuster \u003cevilpies@gmail.com\u003e", "branch": "default", "desc": "Bug 1908749 - Implement EXT_texture_mirror_clamp_to_edge. r=gfx-reviewers,webidl,smaug,ahale\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329480\n", "files": ["dom/bindings/Bindings.conf", "dom/canvas/ClientWebGLExtensions.cpp", "dom/canvas/ClientWebGLExtensions.h", "dom/canvas/WebGLContextExtensions.cpp", "dom/canvas/WebGLExtensions.h", "dom/canvas/WebGLSampler.cpp", "dom/canvas/WebGLStrongTypes.h", "dom/canvas/WebGLTexture.cpp", "dom/canvas/WebGLTypes.h", "dom/canvas/test/webgl-mochitest/ensure-exts/test_common.html", "dom/webidl/WebGLRenderingContext.webidl", "gfx/gl/GLContext.cpp", "gfx/gl/GLContext.h", "gfx/gl/GLContextFeatures.cpp"], "git_node": "0f5e8d9ceae420026f8cd2779ca639681a47fb01", "git_parents": ["4ddd06bced5c46d161feaae577eccac427ae3df9"], "node": "27a53ca8e8721fed7d3fdd4d56ee82673cfe3617", "parents": ["730a270d741aa381b6eacc2d81c32c1da56137e9"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1877510 - Add an access key to the bookmark panel's Save button. r=mak,fluent-reviewers,places-reviewers,flod\" for causing failures at browser_bookmark_popup.js.\n\nThis reverts commit ad5b15f10088265c0f63d0f1266574bf8d2b1972.\n\nRevert \"Bug 1877510 - Let Enter in the edit bookmark folder tree save the bookmark. r=mak,places-reviewers\"\n\nThis reverts commit 02a0ffa2653f0dfc4b7d18845a985377c0a190a7.\n", "files": ["browser/base/content/main-popupset.inc.xhtml", "browser/components/places/content/editBookmark.js", "browser/components/places/content/places-tree.js", "browser/components/places/tests/browser/browser_addBookmarkForFrame.js", "browser/components/places/tests/browser/browser_bookmark_popup.js", "browser/locales/en-US/browser/browser.ftl"], "git_node": "6674cdd6715f4cfc0b507f82b2efcd0625f74b3f", "git_parents": ["0f5e8d9ceae420026f8cd2779ca639681a47fb01"], "node": "3348b35c89486d1ec44ef78f014f2eb53644b08a", "parents": ["27a53ca8e8721fed7d3fdd4d56ee82673cfe3617"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Rename significant reuse to page reuse. r=pbone\n\nThe timestamp records that a dirty page was taken for a new allocation. It says\nnothing about whether that reuse mattered, so calling it significant invites the\nreader to think a magnitude has already been accounted for. Renaming it makes\nroom for the following patch, which decides that separately.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321992\n", "files": ["memory/build/Arena.h", "memory/build/malloc_decls.h", "memory/build/mozjemalloc.cpp"], "git_node": "d3481dc8ea403dc0acc42c4a1df7f383eafba88c", "git_parents": ["6674cdd6715f4cfc0b507f82b2efcd0625f74b3f"], "node": "ca33beb172c363c7ce768ea81f208e18a8f96c2b", "parents": ["3348b35c89486d1ec44ef78f014f2eb53644b08a"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Take the deferred purge predicate as a C callback. r=pbone\n\nUse a C callback with a closure for the aKeepGoing argument of\nmoz_may_purge_now() instead of a std::function. The latter may allocate, which\ncan reuse dirty pages of the arena being purged and restart its grace period,\ndeferring the purge.\n\nThis also removes the C++ specific includes from malloc_decls.h. Fallback.cpp\ngot its posix_memalign declaration through them, so malloc_decls.h includes\nstdlib.h now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322612\n", "files": ["memory/build/Arena.h", "memory/build/malloc_decls.h", "memory/build/mozjemalloc.cpp", "memory/build/mozjemalloc.h", "memory/build/mozjemalloc_types.h", "xpcom/threads/TaskController.cpp"], "git_node": "39b061e029e1c8682e1ef4a021e9b049109bac6c", "git_parents": ["d3481dc8ea403dc0acc42c4a1df7f383eafba88c"], "node": "4c1fe6c1e1a430ce9ee36158f49538e5908c6c84", "parents": ["ca33beb172c363c7ce768ea81f208e18a8f96c2b"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Count a rescheduled task as pending again. r=smaug,bas\n\nA task that returns TaskResult::Incomplete is put back in the queue, but its\nmanager was told WillRunTask() again instead of DidQueueTask(), decrementing\nmTaskCount twice for one run. It is unsigned, so it wraps and the manager\nreports pending tasks forever, which for the idle task manager means its\ndeadline machinery never stops.\n\nThis was latent: the only tasks returning Incomplete live in TestTaskController\nand have no manager. The purge task later in this stack is the first managed\none, and it reschedules itself whenever it is interrupted.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322614\n", "files": ["xpcom/tests/gtest/TestTaskController.cpp", "xpcom/threads/TaskController.cpp"], "git_node": "ee1afacb0e597cdab876aced8ea15a82bd2b6f04", "git_parents": ["39b061e029e1c8682e1ef4a021e9b049109bac6c"], "node": "c1ce65308e7d615abddf13eae169f74e68299f11", "parents": ["4c1fe6c1e1a430ce9ee36158f49538e5908c6c84"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Count the suspended tasks of every task manager. r=smaug\n\nThe loop that decides whether only idle tasks are left stops at the first\nmanager that is not suspended. mTaskManagers is a std::set of raw pointers and\nso iterates in address order, which means whether a suspended manager's tasks\nare subtracted depends on where the allocator happened to put it, and can\ndiffer from run to run.\n\nWhen the loop stops early we count suspended tasks as runnable, conclude that\nthere is still real work, and skip requesting an idle deadline. In a content\nprocess that request is what fetches the idle token from the parent, so the\nidle tasks that were ready wait for an extra round trip.\n\nIterate all of them. There is only a handful of managers, so the early exit was\nnot buying much.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323186\n", "files": ["xpcom/threads/TaskController.cpp"], "git_node": "7056bf01b34b0cd12a75a6840c8d7773bce4b410", "git_parents": ["ee1afacb0e597cdab876aced8ea15a82bd2b6f04"], "node": "9aa3c73ae3e9caf6bcf0fcbd3b691d9f1b3b5483", "parents": ["c1ce65308e7d615abddf13eae169f74e68299f11"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Add a lowest priority class to TaskController. r=smaug\n\nSome work is not idle work in the sense of the HTML spec's idle period, it just\nwants the main thread's leftovers: run if nothing else runs, and get out of the\nway as soon as something does.\n\nGive it a priority below Idle, so that a real idle task wins against it and\ninterrupts it, and a task manager, so that whoever asks whether the main thread\nhas work to do can tell it apart from work.\n\nThe manager also suspends itself while an idle task is queued, which is what\nkeeps a lowest priority task from starving one.\n\nForgetting the manager would quietly turn such a task back into work, so\nAddTask asserts that the two go together.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323187\n", "files": ["layout/base/nsRefreshDriver.cpp", "xpcom/tests/gtest/TestTaskController.cpp", "xpcom/threads/EventQueue.h", "xpcom/threads/TaskController.cpp", "xpcom/threads/TaskController.h", "xpcom/threads/nsIRunnable.idl"], "git_node": "1a53414f0e968f3eabd2c55d114ea8b10eb4bbd5", "git_parents": ["7056bf01b34b0cd12a75a6840c8d7773bce4b410"], "node": "7f03e0e41f2ae7fc5b337fa6d997b4354b370148", "parents": ["9aa3c73ae3e9caf6bcf0fcbd3b691d9f1b3b5483"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Run the deferred purge as a lowest priority task. r=smaug\n\nIdleTaskRunner re-derived idle time for a purge that was scheduled because the\nmain thread was about to fall idle anyway: two timers, and a minimum useful\nbudget that most of its runs declined without purging anything. Queue one\nlowest priority task instead, which also retires the maximum delay and the\nminimum idle budget prefs.\n\nPurging is not idle work in the sense of the spec, it only wants the main\nthread's leftovers, and the lowest priority is also what fixes the deferral:\nrunning the task does not itself ask for an idle deadline, so nothing computes\nidle period state between the peek that decides to purge and the purge itself.\nInterruptiblePurgeTask's comment explains how that computation stalled the\npurge. A slice now ends when any other task becomes ready, including an idle GC\nor CC.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D322613\n", "files": ["memory/build/mozjemalloc.cpp", "modules/libpref/init/StaticPrefList.yaml", "xpcom/threads/TaskController.cpp"], "git_node": "42333b953db3d408b1eb1d8faa0da50b1c0de880", "git_parents": ["1a53414f0e968f3eabd2c55d114ea8b10eb4bbd5"], "node": "ed2f7230de6372f8d9e9010db04fd15550003e95", "parents": ["7f03e0e41f2ae7fc5b337fa6d997b4354b370148"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2066416 - Drop the idle from the memory cleanup names. r=smaug\n\nTaskController's callers ask for a memory cleanup and do not care how it finds\nthe time, which stopped being idle processing with the previous patch. The lazy\npurge name, which the prefs already use, stays for the markers of the task that\ndoes the purging.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323188\n", "files": ["dom/base/nsJSEnvironment.cpp", "memory/build/mozjemalloc.cpp", "xpcom/build/XPCOMInit.cpp", "xpcom/tests/unit/test_getTimers.js", "xpcom/threads/TaskController.cpp", "xpcom/threads/TaskController.h", "xpcom/threads/nsThread.cpp"], "git_node": "8e0c2780f2d36fe5efebe2deeb1e43f0c5f6dfa8", "git_parents": ["42333b953db3d408b1eb1d8faa0da50b1c0de880"], "node": "e78f2053ef01667c4404f2490333131782cd52ce", "parents": ["ed2f7230de6372f8d9e9010db04fd15550003e95"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078743 - Part 1: Mark the review prompt not eligible when continuous onboarding is in progress. r=android-reviewers,marcin\n\nThe eligibility check is dispatched from HomeFragment.onStart(), so it runs again whenever HomeActivity is stopped and restarted, such as when returning from the custom tab opened by the VPN onboarding sheet. ReviewPromptMiddleware returned early while continuous onboarding was in progress without updating the state, and ContinuousOnboardingFeature marks day 7 complete as soon as the VPN sheet is shown, so the next check in the same session passed the gate and showed the review prompt on top of the bottom sheet.\n\nDispatch DoNotShowReviewPrompt instead so the check is skipped for the rest of the process and re-evaluated on the next cold start.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331274\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/reviewprompt/ReviewPromptMiddleware.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/reviewprompt/ReviewPromptMiddlewareTest.kt"], "git_node": "ea3fc9a29245cb52492f50e988394065cf344db0", "git_parents": ["8e0c2780f2d36fe5efebe2deeb1e43f0c5f6dfa8"], "node": "100951b2b0f26226d23ae5f9cbc14bcad600add1", "parents": ["e78f2053ef01667c4404f2490333131782cd52ce"], "tags": []}, {"author": "t-p-white \u003ctowhite@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078743 - Part 2: Check the review prompt state before the continuous onboarding gate. r=android-reviewers,marcin\n\nOnce a decision has been made for this process there is nothing left to do, so return before reading settings or dispatching DoNotShowReviewPrompt again on every HomeFragment.onStart().\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331566\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/reviewprompt/ReviewPromptMiddleware.kt"], "git_node": "d08d5220c1fd9c0fc5c0ea9cd2d5039714d0269d", "git_parents": ["ea3fc9a29245cb52492f50e988394065cf344db0"], "node": "d0b6c800f02500a7d288e6f01878f0f7331d9297", "parents": ["100951b2b0f26226d23ae5f9cbc14bcad600add1"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079190 - Update menu colors while in dark theme r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331560\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserToolbarIntegration.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuButton.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuTheme.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/BrowserMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/CustomTabMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/WebCompatReporter.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/BrowserMenuTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/CustomTabMenuTest.kt"], "git_node": "00549f19e9416d889718e33cc9d94ad8ec4610f4", "git_parents": ["d08d5220c1fd9c0fc5c0ea9cd2d5039714d0269d"], "node": "7ccd81c9d38dc4f7f96b69c66780c18be0759557", "parents": ["d0b6c800f02500a7d288e6f01878f0f7331d9297"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078929 - Run the repo-update tasks on b-linux-medium workers with shorter max run times. r=releng-reviewers,jcristau DONTBUILD\n\npinning-update now finishes in under 30 minutes and periodic-file-update in under 6, and both took the same\ntime on b-linux-medium as on their current workers.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331399\n", "files": ["taskcluster/kinds/repo-update/kind.yml"], "git_node": "fb57f2a08b3901528918878d0d262e7f51a8d199", "git_parents": ["00549f19e9416d889718e33cc9d94ad8ec4610f4"], "node": "b5d955c9b4653b0afdd924e5a6f3e7b9421d3a7f", "parents": ["7ccd81c9d38dc4f7f96b69c66780c18be0759557"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078961 - Group the geckoview-junit chunks and variants under one Treeherder group. r=taskgraph-reviewers,jcristau\n\nVariants extend a grouped symbol's group name, which suites like M() and Mn() rely on, so the new\ntreeherder-group-variants test setting opts into putting the variant suffix on the symbol instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331441\n", "files": ["taskcluster/config.yml", "taskcluster/gecko_taskgraph/test/test_transforms_test.py", "taskcluster/gecko_taskgraph/transforms/test/__init__.py", "taskcluster/gecko_taskgraph/transforms/test/variant.py", "taskcluster/kinds/test/misc.yml"], "git_node": "4eb063b96778203217d4dba6954a3c40be1ce335", "git_parents": ["fb57f2a08b3901528918878d0d262e7f51a8d199"], "node": "4a3b70d23599e22cabf1ca8e9926e6e1be3f1a19", "parents": ["b5d955c9b4653b0afdd924e5a6f3e7b9421d3a7f"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078231 - Use the global document and window in UrlbarView. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330778\n", "files": ["browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_tab_switch.js", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "d6a32eb196fad7df4014c68e7893628f89cc941b", "git_parents": ["4eb063b96778203217d4dba6954a3c40be1ce335"], "node": "ecffa0a4e45ad9cd18332f0fe84822b42a5983f4", "parents": ["4a3b70d23599e22cabf1ca8e9926e6e1be3f1a19"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078658 - Use the global document and window in SearchModeSwitcher. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331243\n", "files": ["browser/components/urlbar/content/SearchModeSwitcher.mjs"], "git_node": "2f342aa396036055d13cf5b28fc01f821eb137bf", "git_parents": ["d6a32eb196fad7df4014c68e7893628f89cc941b"], "node": "635f3423cbb22fab025b0a662a42f34bc8e42a19", "parents": ["ecffa0a4e45ad9cd18332f0fe84822b42a5983f4"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079260 - Run the android-gradle-build jobs on t-linux-docker-amd workers. r=releng-reviewers,jcristau\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331593\n", "files": ["taskcluster/kinds/source-test/python-android.yml"], "git_node": "7a9e1afc60d2656c578e76322cb401dc1291b16c", "git_parents": ["2f342aa396036055d13cf5b28fc01f821eb137bf"], "node": "82b3d26974a2b0c579d85b7e43a10a4460997eae", "parents": ["635f3423cbb22fab025b0a662a42f34bc8e42a19"], "tags": []}, {"author": "Paul Adenot \u003cpaul@paul.cx\u003e", "branch": "default", "desc": "Bug 2071536 - Fix the build on musl. r=cubeb-reviewers,supply-chain-reviewers,pehrsons\n\naudio_thread_priority didn't compile on musl, this has been fixed\nupstream. audioipc is also updated, the tree now only uses 0.38.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327331\n", "files": [".cargo/config.toml.in", "Cargo.lock", "supply-chain/imports.lock", "third_party/rust/audio_thread_priority/.cargo-checksum.json", "third_party/rust/audio_thread_priority/.cargo_vcs_info.json", "third_party/rust/audio_thread_priority/.github/workflows/rust.yml", "third_party/rust/audio_thread_priority/Cargo.lock", "third_party/rust/audio_thread_priority/Cargo.toml", "third_party/rust/audio_thread_priority/Cargo.toml.orig", "third_party/rust/audio_thread_priority/src/rt_linux.rs", "third_party/rust/audio_thread_priority/src/rt_linux_native.rs", "third_party/rust/audioipc2-client/.cargo-checksum.json", "third_party/rust/audioipc2-client/Cargo.toml", "third_party/rust/audioipc2-server/.cargo-checksum.json", "third_party/rust/audioipc2-server/Cargo.toml", "third_party/rust/audioipc2/.cargo-checksum.json", "third_party/rust/audioipc2/Cargo.toml", "toolkit/library/rust/shared/Cargo.toml"], "git_node": "81443b2080eba962852906534a2b205ee11d5ad5", "git_parents": ["7a9e1afc60d2656c578e76322cb401dc1291b16c"], "node": "740c905c5e763d258a3bb577aaa7ba7d2fea56c5", "parents": ["82b3d26974a2b0c579d85b7e43a10a4460997eae"], "tags": []}, {"author": "Olli Pettay \u003cOlli.Pettay@helsinki.fi\u003e", "branch": "default", "desc": "Bug 2078420 - Consider to increase mainthread priority on Windows r=bas\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331151\n", "files": ["dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/ProcessPriorityManager.cpp", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "a9dc9b49f8139e5aa042474627344a4f86da23b1", "git_parents": ["81443b2080eba962852906534a2b205ee11d5ad5"], "node": "5fd58876c6709b0c9cfbe82c23b3841415cd2bdd", "parents": ["740c905c5e763d258a3bb577aaa7ba7d2fea56c5"], "tags": []}, {"author": "Erik Nordin \u003cenordin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2079003 - Use getTextInfo in getScriptDirection r=platform-i18n-reviewers,jfkthame\n\nThis commit replaces the hardcoded list of RTL languages in\ngetScriptDirection() with the shipped Intl.LocaleInfo API.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331464\n", "files": ["toolkit/components/mozintl/mozIMozIntl.idl", "toolkit/components/mozintl/mozIntl.sys.mjs", "toolkit/components/mozintl/test/test_mozintl.js"], "git_node": "c9a044f0e50bdd32d9c42f17bb5a0bc6bd96b55e", "git_parents": ["a9dc9b49f8139e5aa042474627344a4f86da23b1"], "node": "cad671d7a801084f2a96021ec528fb31d6926283", "parents": ["5fd58876c6709b0c9cfbe82c23b3841415cd2bdd"], "tags": []}, {"author": "Alexandra Borovova \u003caborovova@mozilla.com\u003e", "branch": "default", "desc": "Bug 2048634 - Update metadata for screen-capture/getdisplaymedia-framerate.https.html.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331558\n", "files": ["testing/web-platform/meta/screen-capture/getdisplaymedia-framerate.https.html.ini"], "git_node": "958e1aae12db2f68b31e38419e1cf296df0ef6d0", "git_parents": ["c9a044f0e50bdd32d9c42f17bb5a0bc6bd96b55e"], "node": "f6cf37b4103eb71395d7ec6457cbc93406122040", "parents": ["cad671d7a801084f2a96021ec528fb31d6926283"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078977, part 1 - Make PContentPermissionRequest actors refcounted. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331459\n", "files": ["dom/base/nsContentPermissionHelper.cpp", "dom/base/nsContentPermissionHelper.h", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentChild.cpp", "dom/ipc/ContentChild.h", "dom/ipc/ContentParent.cpp", "dom/ipc/ContentParent.h", "dom/ipc/PContentPermissionRequest.ipdl"], "git_node": "9bd6b9100c9cbbce95a844c92f5d5715051cf78d", "git_parents": ["958e1aae12db2f68b31e38419e1cf296df0ef6d0"], "node": "d437f1273da5ff73f97a4c00cc1821db8dac5c79", "parents": ["f6cf37b4103eb71395d7ec6457cbc93406122040"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078977, part 2 - Make PContentPermissionRequest parent impl concrete. r=dom-core-reviewers,smaug\n\nMostly this involves moving the implementation into the header.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331460\n", "files": ["dom/base/nsContentPermissionHelper.cpp", "dom/base/nsContentPermissionHelper.h", "dom/ipc/PContentPermissionRequest.ipdl"], "git_node": "77c0a4f55d04356503b7ed93e04bacc520b7cced", "git_parents": ["9bd6b9100c9cbbce95a844c92f5d5715051cf78d"], "node": "33e8a1bffe0fa9f5bddc22eb60783965b7a60918", "parents": ["d437f1273da5ff73f97a4c00cc1821db8dac5c79"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078977, part 3 - Use the concrete type for the PContentPermissionRequest actors. r=dom-core-reviewers,smaug\n\nIt is very unusual to use the abstract PFoo types to refer to actors. Now that the parent\nand child are both available in the header, we can use the actual type. We can also use an\nActorCast, which is safer, now that the type is concrete.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331461\n", "files": ["dom/base/nsContentPermissionHelper.cpp", "dom/base/nsContentPermissionHelper.h", "dom/ipc/BrowserChild.cpp", "dom/ipc/BrowserParent.cpp", "dom/ipc/ContentParent.cpp"], "git_node": "89e76af417dc6f963b501cf4b2489e5d60e8c937", "git_parents": ["77c0a4f55d04356503b7ed93e04bacc520b7cced"], "node": "08d0c32b0d8767fc51f6d2c7e8c5f5e8e14f0383", "parents": ["33e8a1bffe0fa9f5bddc22eb60783965b7a60918"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078977, part 4 - Use refptr and nsTHashMap for the permission request maps. r=dom-core-reviewers,smaug\n\nThese are safe, but make them even more safe by using a RefPtr. Using an nsTHashMap\ninstead of a std::map means we don't have to create a RefPtr to do a lookup.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331462\n", "files": ["dom/base/nsContentPermissionHelper.cpp"], "git_node": "59dfbd042567a376c2ee62a677a4c6284149282f", "git_parents": ["89e76af417dc6f963b501cf4b2489e5d60e8c937"], "node": "75e69c8cc7e56095181fb81f7b43e276d21e6175", "parents": ["08d0c32b0d8767fc51f6d2c7e8c5f5e8e14f0383"], "tags": []}, {"author": "Andrew McCreight \u003ccontinuation@gmail.com\u003e", "branch": "default", "desc": "Bug 2078977, part 5 - Use a WeakPtr for nsContentPermissionRequestProxy::mPermissionRequests. r=dom-core-reviewers,smaug\n\nThe raw pointer use looks fine, but let's be safer and use a WeakPtr. We still need\nto clear the pointer in the same places we used to.\n\nAs a bonus, also make topPrincipal a strong reference in AllocPContentPermissionRequestParent.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331463\n", "files": ["dom/base/nsContentPermissionHelper.h", "dom/ipc/ContentParent.cpp"], "git_node": "24154af83d9431dcab9397a477eed08e39da6695", "git_parents": ["59dfbd042567a376c2ee62a677a4c6284149282f"], "node": "add9d29e1ea7ab6e862cababf4f966ea11e95ed3", "parents": ["75e69c8cc7e56095181fb81f7b43e276d21e6175"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003ckrosylight@proton.me\u003e", "branch": "default", "desc": "Bug 2078221 - Add telemetry for user activation for each geolocation requests r=dom-core-reviewers,jjaschke\n\nThis should help us decide on https://bugzilla.mozilla.org/show_bug.cgi?id=2077926.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330787\n", "files": ["dom/geolocation/Geolocation.cpp", "dom/geolocation/metrics.yaml", "testing/web-platform/mozilla/tests/geolocation-API/user-activation-glean.https.window.js"], "git_node": "f97599598481fe0286558058eff6e4e52b35c0fb", "git_parents": ["24154af83d9431dcab9397a477eed08e39da6695"], "node": "d996dfbb07b49893587efc592f2bc6dc06932291", "parents": ["add9d29e1ea7ab6e862cababf4f966ea11e95ed3"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073095 - fix translations test. r=sfamisa\n\nUse a string based lookup to get hold of the radio button rather than a flaky position based lookup.\n\n[try is running here](https://treeherder.mozilla.org/jobs?repo=try&revision=ee17cb09cc3697608a5fc29467ec457e44377275)\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/381\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsTranslationsRobot.kt"], "git_node": "a05d94dea9f28d6df081fd399164e8ecf9094862", "git_parents": ["f97599598481fe0286558058eff6e4e52b35c0fb"], "node": "37fd3b99e98471aa556c0a674d45207b36852ec8", "parents": ["d996dfbb07b49893587efc592f2bc6dc06932291"], "tags": []}, {"author": "SMRehan \u003crio.syed@gmail.com\u003e", "branch": "default", "desc": "Bug 1912002 - Auto-open Picture-in-Picture when a still-selected tab's window becomes occluded r=hsohaney,mconley\n\nPictureInPicture:VideoTabHidden already fires when the window is occluded, but\nthe handler drops the event while the tab is still selected, so switching to a\nfullscreen app or covering the window never opens the player. Occlusion already\nreaches document visibility on macOS, so this splits that gate in two and puts\nthe new case behind enable-when-occluded, off by default like its sibling. The\nnew case checks that the window is minimized or covered, since a page is also\nhidden while its window closes, and showing the window again closes the player,\nas switching back to the tab does.\n\nA player closed on purpose while its window is out of sight stays closed until\nthe window is shown again. Bug 2057730's one-shot mark is not enough there:\nclosing the player stops it keeping the window active, and the page then\nreports itself hidden again.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326735\n", "files": ["browser/app/profile/firefox.js", "toolkit/components/pictureinpicture/PictureInPicture.sys.mjs", "toolkit/components/pictureinpicture/tests/browser.toml", "toolkit/components/pictureinpicture/tests/browser_occludedSelectedTab.js"], "git_node": "07860b19f2dbeb0ddcdf83f184f60d887a8b7253", "git_parents": ["a05d94dea9f28d6df081fd399164e8ecf9094862"], "node": "63af7310906690f31e2abf4407d4e741b5352fd2", "parents": ["37fd3b99e98471aa556c0a674d45207b36852ec8"], "tags": []}, {"author": "Yoshi Cheng-Hao Huang \u003callstars.chh@gmail.com\u003e", "branch": "default", "desc": "Bug 2078234 - Use ModuleRequest hasher in LoadedModuleMap. r=jonco\n\nIn dynamic import, a new ModuleRequestObject is always created [1].\nAnd LoadedModuleMap uses StableCellHasher to match the existing entry, which\ncauses the bug that a new entry is always inserted in [[LoadedModule]], even if\nfor the same import() calls.\n\nThis patch fixes the bug by adding a new ModuleRequestHasher to compare the\nModuleRequest objects in LoadedModuleMap.\n\n[1]: https://searchfox.org/firefox-main/rev/00aad09a820405643aebd693e60a3333ccf04544/js/src/vm/Modules.cpp#3092-3093\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331578\n", "files": ["js/src/builtin/ModuleObject.h", "js/src/jit-test/modules/dynamic-import-repeated-referrer.js", "js/src/jit-test/tests/modules/bug-2078234.js"], "git_node": "02dc3b3cbc86f582065d5c5ba6849bb2984dae10", "git_parents": ["07860b19f2dbeb0ddcdf83f184f60d887a8b7253"], "node": "62149073e170b7695e84468864086232e7107d31", "parents": ["63af7310906690f31e2abf4407d4e741b5352fd2"], "tags": []}, {"author": "Valentin Gosu \u003cvalentin.gosu@gmail.com\u003e", "branch": "default", "desc": "Bug 2073584 - Keep NTLM per-channel auth state in the continuation state. r=necko-reviewers,kershaw\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331521\n", "files": ["netwerk/protocol/http/nsHttpNTLMAuth.cpp", "netwerk/protocol/http/nsHttpNTLMAuth.h"], "git_node": "62eeacafabefbfd8aa39d62124f5066e2c610b69", "git_parents": ["02dc3b3cbc86f582065d5c5ba6849bb2984dae10"], "node": "dfd9aba95a4ef85fa6a9634e17548217c318b388", "parents": ["62149073e170b7695e84468864086232e7107d31"], "tags": []}, {"author": "Kagami Sascha Rosylight \u003csaschanaz@outlook.com\u003e", "branch": "default", "desc": "Bug 1991477 - Remove existing TOUCH_ENABLED_DEVICE telemetry r=win-reviewers,rkraesig\n\nThe new telemetry should be able to replace this.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D221233\n", "files": ["toolkit/components/telemetry/Histograms.json", "widget/windows/metrics.yaml", "widget/windows/nsLookAndFeel.cpp"], "git_node": "ac1ed8f0ef4c79fd85eaa0aa66bcd92ad606a2f5", "git_parents": ["62eeacafabefbfd8aa39d62124f5066e2c610b69"], "node": "98b161b9c018e125affedd548ed98606ee86fc59", "parents": ["dfd9aba95a4ef85fa6a9634e17548217c318b388"], "tags": []}, {"author": "David Shin \u003cdshin@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035307: Propagate relative selector search path when we find sibling standin. r=firefox-style-system-reviewers,emilio\n\nWe use the search path flags in elements to short-circuit :has invalidation.\nWhen we find the standin, the standin element should inherit that flag, so\nthat we don't mistakenly short circuit out of invalidation later.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D298320\n", "files": ["servo/ports/geckolib/glue.rs", "testing/web-platform/tests/css/selectors/invalidation/has-sibling-propagation.html"], "git_node": "c542731375d22d0a21b346e353a42ceb5037c45e", "git_parents": ["ac1ed8f0ef4c79fd85eaa0aa66bcd92ad606a2f5"], "node": "13221bb0f205da65261ab5b0d2cce044e9a51af3", "parents": ["98b161b9c018e125affedd548ed98606ee86fc59"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2076782 - Don't paint the content area background under its border. r=kcochrane,desktop-theme-reviewers,tabbrowser-reviewers\" for causing failures at browser_opaque_region.js.\n\nThis reverts commit dd77228df5e10b9ed750f69e60500e478637c3ba.\n", "files": ["browser/themes/shared/tabbrowser/content-area.css"], "git_node": "b8c1f9686ff8b5c92a39caae5536b0be9ed74f62", "git_parents": ["c542731375d22d0a21b346e353a42ceb5037c45e"], "node": "8ec7d565e513e17793cdc7ef685121d9e3d85809", "parents": ["13221bb0f205da65261ab5b0d2cce044e9a51af3"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2078221 - Add telemetry for user activation for each geolocation requests r=dom-core-reviewers,jjaschke\" for causing bustages in Geolocation.cpp.\n\nThis reverts commit f97599598481fe0286558058eff6e4e52b35c0fb.\n", "files": ["dom/geolocation/Geolocation.cpp", "dom/geolocation/metrics.yaml", "testing/web-platform/mozilla/tests/geolocation-API/user-activation-glean.https.window.js"], "git_node": "42e81e7326f5eb664bbc058b2d2b9d731d2290a9", "git_parents": ["b8c1f9686ff8b5c92a39caae5536b0be9ed74f62"], "node": "7551a65ff82f12a78dc324d5f709cb27b0d1d431", "parents": ["8ec7d565e513e17793cdc7ef685121d9e3d85809"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2066416 - Drop the idle from the memory cleanup names. r=smaug\" for causing failures at TaskController.cpp.\n\nThis reverts commit 8e0c2780f2d36fe5efebe2deeb1e43f0c5f6dfa8.\n\nRevert \"Bug 2066416 - Run the deferred purge as a lowest priority task. r=smaug\"\n\nThis reverts commit 42333b953db3d408b1eb1d8faa0da50b1c0de880.\n\nRevert \"Bug 2066416 - Add a lowest priority class to TaskController. r=smaug\"\n\nThis reverts commit 1a53414f0e968f3eabd2c55d114ea8b10eb4bbd5.\n\nRevert \"Bug 2066416 - Count the suspended tasks of every task manager. r=smaug\"\n\nThis reverts commit 7056bf01b34b0cd12a75a6840c8d7773bce4b410.\n\nRevert \"Bug 2066416 - Count a rescheduled task as pending again. r=smaug,bas\"\n\nThis reverts commit ee1afacb0e597cdab876aced8ea15a82bd2b6f04.\n\nRevert \"Bug 2066416 - Take the deferred purge predicate as a C callback. r=pbone\"\n\nThis reverts commit 39b061e029e1c8682e1ef4a021e9b049109bac6c.\n\nRevert \"Bug 2066416 - Rename significant reuse to page reuse. r=pbone\"\n\nThis reverts commit d3481dc8ea403dc0acc42c4a1df7f383eafba88c.\n", "files": ["dom/base/nsJSEnvironment.cpp", "layout/base/nsRefreshDriver.cpp", "memory/build/Arena.h", "memory/build/malloc_decls.h", "memory/build/mozjemalloc.cpp", "memory/build/mozjemalloc.h", "memory/build/mozjemalloc_types.h", "modules/libpref/init/StaticPrefList.yaml", "xpcom/build/XPCOMInit.cpp", "xpcom/tests/gtest/TestTaskController.cpp", "xpcom/tests/unit/test_getTimers.js", "xpcom/threads/EventQueue.h", "xpcom/threads/TaskController.cpp", "xpcom/threads/TaskController.h", "xpcom/threads/nsIRunnable.idl", "xpcom/threads/nsThread.cpp"], "git_node": "747928d9892875a68c52abfcb03bc438981cb6e1", "git_parents": ["42e81e7326f5eb664bbc058b2d2b9d731d2290a9"], "node": "150f8f50bd33ae5c96d2582e86de077c4cf64fcb", "parents": ["7551a65ff82f12a78dc324d5f709cb27b0d1d431"], "tags": []}, {"author": "Gregory Mierzwinski \u003cgmierz1@live.ca\u003e", "branch": "default", "desc": "Bug 2078612 - Disable win11 opt builds for video encoding perftests. r=kshampur,perftest-reviewers DONTBUILD\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331208\n", "files": ["taskcluster/kinds/browsertime/desktop.yml", "testing/perfdocs/generated/raptor.md"], "git_node": "e0152017ef1604d87c558bf322113ac8f43734ae", "git_parents": ["747928d9892875a68c52abfcb03bc438981cb6e1"], "node": "d2e03536356d8486e1910767a2b2d12fe59fc25e", "parents": ["150f8f50bd33ae5c96d2582e86de077c4cf64fcb"], "tags": []}, {"author": "Ryan Curran \u003crcurran@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077556 - Don't restore the pointer to a synthesized position after pointer lock r=edgar,smaug\n\nRequestLockPointer saved the last known event position to restore the\npointer on unlock. When that position came from events synthesized for\ntests, unlock warped the real cursor into the content area, where it\nstayed for later tests and windows.\n\nTrack the last position from an event that wasn't synthesized for\ntests and restore to that. If there hasn't been one, leave the pointer\nwhere it is. SendWheelEvent now marks its events as synthesized for\ntests like the mouse paths already do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330392\n", "files": ["dom/base/nsDOMWindowUtils.cpp", "dom/events/EventStateManager.cpp", "dom/events/EventStateManager.h"], "git_node": "87fecfcaa6989b1a880860b7774680be4bcd85d8", "git_parents": ["e0152017ef1604d87c558bf322113ac8f43734ae"], "node": "b5d0a1183ca1f6021c63eee4eacb4856cae3d993", "parents": ["d2e03536356d8486e1910767a2b2d12fe59fc25e"], "tags": []}, {"author": "Jonathan Sudiaman \u003cjsudiaman@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076834 - Use asynchronous module load for the revamped switcher in the legacy bookmarks panel. r=sidebar-reviewers,nsharpley\n\nAccessibility creates the wrong kind of accessible for the bookmarks tree before its custom-element initialization finishes. Adding `async` to the switcher module prevents that initialization race.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330158\n", "files": ["browser/components/places/content/bookmarksSidebar.xhtml"], "git_node": "8d08195715553a798b7135f79a856681ac591b8a", "git_parents": ["87fecfcaa6989b1a880860b7774680be4bcd85d8"], "node": "6a802725b92c235652a1e39431264dac2e7544ed", "parents": ["b5d0a1183ca1f6021c63eee4eacb4856cae3d993"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2076686 - Create new verifyThePreviewReportBottomSheetTest regression UI test r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329917\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/WebCompatReporterSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/tests/ReportBrokenSiteTest.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/webcompat/ui/WebCompatReporterPreviewSheet.kt"], "git_node": "0307a6cb6a52a9b631e14cae14aa47c3b2269810", "git_parents": ["8d08195715553a798b7135f79a856681ac591b8a"], "node": "627b365e084083ba4c276fe6732b66db6d849874", "parents": ["6a802725b92c235652a1e39431264dac2e7544ed"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067124 - Fix verifyFontSizingChangeTest UI test r=aaronmt\n\nThe UI test was flaky when trying to verify the INTERACTIVE readiness for SettingsAccessibilityPage.\n\nThe test wasn't actually failing on the Accessibility screen, the tap on \u201cAccessibility\u201d in Settings was landing on the \u201cAutofill\u201d row (because Espresso taps a coordinate while the just-opened Settings list is still shifting), so the test waited 10s for an Accessibility screen that never opened.\n\nTo fix this I've switched to UiAutomator, which finds the \u201cAccessibility\u201d row by its text and clicks it directly, so it can\u2019t hit the wrong row.\n\nThe UI test successfully passed 50x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331577\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSelectors.kt"], "git_node": "2b9a0f85838e687210a2269c2440f6e037cbd4ad", "git_parents": ["0307a6cb6a52a9b631e14cae14aa47c3b2269810"], "node": "d94b49bc0b76a8efb6df22d1546862b9016f4146", "parents": ["627b365e084083ba4c276fe6732b66db6d849874"], "tags": []}, {"author": "Dimi \u003cdlee@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072837 - Remove PWMGR_IMPORT_LOGINS_FROM_FILE_CATEGORICAL and extend pwmgr.import_logins_from_file_categorical to 170. r=mtigley,credential-management-reviewers,chutten\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330674\n", "files": ["toolkit/components/passwordmgr/metrics.yaml", "toolkit/components/passwordmgr/test/unit/test_module_LoginCSVImport.js", "toolkit/components/telemetry/Histograms.json"], "git_node": "3240254f3f84063635141cdd112c5e540753a204", "git_parents": ["2b9a0f85838e687210a2269c2440f6e037cbd4ad"], "node": "5a1bc19f3123cca938e4f4e1006d8f699fbaec31", "parents": ["d94b49bc0b76a8efb6df22d1546862b9016f4146"], "tags": []}, {"author": "Sylvestre Ledru \u003csylvestre@debian.org\u003e", "branch": "default", "desc": "Bug 2078393 - Stop copying the media configuration into the final continuation of MediaCapabilities::CreateWebRTCEncodingInfo (Coverity CID 1701833) r=media-playback-reviewers,padenot\n\nThe capture was unused and copied the whole configuration dictionary on every WebRTC encodingInfo() call.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330906\n", "files": ["dom/media/mediacapabilities/MediaCapabilities.cpp"], "git_node": "258480a2afdceef7aabedd01d0addac99b815099", "git_parents": ["3240254f3f84063635141cdd112c5e540753a204"], "node": "e5cc3be847cb5989e024bdc7c69694a37f828a80", "parents": ["5a1bc19f3123cca938e4f4e1006d8f699fbaec31"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078298 - Bump Updatebot and the Claude Code CLI pins in the updatebot image r=firefox-build-system-reviewers,ahochheiden\n\nUpdate UPDATEBOT_REVISION to 50ed31013082b87d072dadc619cb5693b4e9ced5 and the\npinned Claude Code CLI from 2.1.195 to 2.1.267 (validated end-to-end against the\nAI conflict-resolution path).\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330835\n", "files": ["taskcluster/docker/updatebot/privileged-setup.sh", "taskcluster/docker/updatebot/updatebot-version.sh"], "git_node": "499b830f8340c3e74f3db735f81a104df9f8e546", "git_parents": ["258480a2afdceef7aabedd01d0addac99b815099"], "node": "8f636a17ce5452197e6db6a98827d397627eed00", "parents": ["e5cc3be847cb5989e024bdc7c69694a37f828a80"], "tags": []}, {"author": "Tom Ritter \u003ctom@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078298 - Pin and verify the Claude Code CLI with a committed lockfile and npm ci r=firefox-build-system-reviewers,ahochheiden\n\n@anthropic-ai/claude-code is just a launcher; the code that actually runs is\nits platform optionalDependency (@anthropic-ai/claude-code-linux-x64, ~217MB).\nInstall from a committed package-lock.json with `npm ci`, which pins and\nintegrity-verifies both the launcher and the platform binary (and the rest of\nthe tree) and aborts the build on any mismatch -- instead of hand-hashing only\nthe launcher tarball.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330836\n", "files": ["taskcluster/docker/updatebot/Dockerfile", "taskcluster/docker/updatebot/claude-code/package-lock.json", "taskcluster/docker/updatebot/claude-code/package.json", "taskcluster/docker/updatebot/privileged-setup.sh"], "git_node": "90f126c6b3d10aeab7398be0e1e177ca1e9cee08", "git_parents": ["499b830f8340c3e74f3db735f81a104df9f8e546"], "node": "89ea9f14223661cd3b72d5faee0cbba4cad6ad0e", "parents": ["8f636a17ce5452197e6db6a98827d397627eed00"], "tags": []}, {"author": "Erich Gubler \u003cerichdongubler@gmail.com\u003e", "branch": "default", "desc": "Bug 2078246 - chore: strip carriage returns from `testing/web-platform/meta/**/__dir__.ini` r=jgraham\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330761\n", "files": ["testing/web-platform/meta/appmanifest/__dir__.ini", "testing/web-platform/meta/background-sync/__dir__.ini", "testing/web-platform/meta/content-security-policy/embedded-enforcement/__dir__.ini", "testing/web-platform/meta/content-security-policy/script-src-attr-elem/__dir__.ini", "testing/web-platform/meta/device-memory/__dir__.ini", "testing/web-platform/meta/document-picture-in-picture/__dir__.ini", "testing/web-platform/meta/html/user-activation/__dir__.ini", "testing/web-platform/meta/js-self-profiling/__dir__.ini", "testing/web-platform/meta/keyboard-lock/__dir__.ini", "testing/web-platform/meta/long-animation-frame/__dir__.ini", "testing/web-platform/meta/mixed-content/gen/sharedworker-module-data.http-rp/__dir__.ini", "testing/web-platform/meta/mixed-content/gen/sharedworker-module.http-rp/__dir__.ini", "testing/web-platform/meta/mixed-content/gen/worker-module-data.meta/__dir__.ini", "testing/web-platform/meta/navigation-api/__dir__.ini", "testing/web-platform/meta/periodic-background-sync/__dir__.ini", "testing/web-platform/meta/savedata/__dir__.ini", "testing/web-platform/meta/ua-client-hints/__dir__.ini", "testing/web-platform/meta/urlpattern/__dir__.ini", "testing/web-platform/meta/virtual-keyboard/__dir__.ini", "testing/web-platform/meta/webrtc-ice/__dir__.ini", "testing/web-platform/mozilla/meta/dom/fs/__dir__.ini"], "git_node": "e71046bdfeb2b4a176975101c62fda52085a0f05", "git_parents": ["90f126c6b3d10aeab7398be0e1e177ca1e9cee08"], "node": "546a72389c4e8dbabeb71c01f2143a91db55d825", "parents": ["89ea9f14223661cd3b72d5faee0cbba4cad6ad0e"], "tags": []}, {"author": "Giulia Cardieri \u003cgcardieri@mozilla.com\u003e", "branch": "default", "desc": "Bug 2067087: Fix multiple smart window Nova bugs related to the chat area r=mlucks,desktop-theme-reviewers,mstriemer\n\nFixing different issues with Nova:\n1. Re-adding the bottom blur - I merged the `fullpage-top-blur` and old `fullpage-top-scrim` with the pre-existing blurs in the after/before pseudo-elements in the chat. Now it works on both top/bottom, and also adds the background color gradient the scrim added.\n2. Wrapping the new box-shadow in a Nova media query - opted for a shared variable due to issue #3\n3. Fixing the missing box-shadow on the edges of the fullpage chat when the blur is visible - see image for existing issue. Following orientation from UX, we want the box-shadow to be above the pseudo elements with the blur (#1), so I'm renaming and using the div that used to be `fullpage-top-scrim` to `fullpage-top-box-shadow`\n4. Sometimes the overflowing attribute was not triggered when it should. Even when I asked for a long story I did not see the blur/overflow attribute until I typed a second message. Adding \"flex-shrink\" to the chat inner element makes it grow with the content and fixes this issue.\n5. Updated the chat header/history menu font color on dark mode to increase contrast for a11y.\n{F81522113}\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326512\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.css", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.css", "browser/components/aiwindow/ui/components/smartwindow-history-menu/smartwindow-history-menu.css", "browser/components/aiwindow/ui/content/ai-window-content.css", "browser/components/aiwindow/ui/content/ai-window-shared.css", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_background_token.js", "browser/components/aiwindow/ui/test/browser/browser_aichat_content_overflow.js", "browser/themes/addons/aiwindow-nova/aiwindow-theme-nova.css", "browser/themes/addons/aiwindow-nova/manifest.in.json"], "git_node": "c77e1f02f2b47357bfb6124400e6117c9a04c805", "git_parents": ["e71046bdfeb2b4a176975101c62fda52085a0f05"], "node": "c9c929e93abbc0c5deee942c0170825677aa0252", "parents": ["546a72389c4e8dbabeb71c01f2143a91db55d825"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2079237 - Convert verifyOpenLinkNewTabContextMenuOptionTest regression UI test to the efficiency framework r=aaronmt\n\nThe UI test successfully passed 25x on Firebase \u2705\nAll UI tests successfully passed 1x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331582\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/ContextMenusTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/pageObjects/BrowserPage.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/BrowserPageSelectors.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozill