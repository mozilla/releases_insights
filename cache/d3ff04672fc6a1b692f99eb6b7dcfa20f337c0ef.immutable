s/navigation-api/scroll-behavior/after-transition-traverse-to-fragment.html"], "git_node": "9ebefb91761c595a878edbcb4236b6e5b1b4de23", "git_parents": ["acb27df01daa1625d610335bfd652047eee83801"], "node": "bae8fcc75a0c718a6e614206a035feeeb33346e4", "parents": ["ce4c738c1d03c1071d4997718f3eb860a086215f"], "tags": []}, {"author": "James Teow \u003cjteow@mozilla.com\u003e", "branch": "default", "desc": "Bug 2064708 - Add skip menu using tab key option in the address bar result menu - r=urlbar-reviewers,fluent-reviewers,desktop-theme-reviewers,mstriemer,bolsson,mak\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327913\n", "files": ["browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/actors/UrlbarChild.sys.mjs", "browser/components/urlbar/content/UrlbarContentPrefs.mjs", "browser/components/urlbar/content/UrlbarView.mjs", "browser/components/urlbar/tests/browser-editing/browser_urlbar_contextmenu.js", "browser/components/urlbar/tests/browser-newtab/browser_resultMenuOpenIn.js", "browser/components/urlbar/tests/browser-results/browser_result_menu.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_realtime_flight_status.js", "browser/components/urlbar/tests/quicksuggest/browser/browser_quicksuggest_sports.js", "browser/locales/en-US/browser/browser.ftl", "browser/themes/shared/urlbar/view-nova.css", "browser/themes/shared/urlbar/view-proton.css"], "git_node": "3e185ef13da9a7d1dcc02b8832d6101739a5f7d8", "git_parents": ["9ebefb91761c595a878edbcb4236b6e5b1b4de23"], "node": "ca07e908f79788620b6bebd1f81c54ef267477ac", "parents": ["bae8fcc75a0c718a6e614206a035feeeb33346e4"], "tags": []}, {"author": "Stephen A Pohl \u003cspohl@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069267: Open the ASWebAuthenticationSession window only after session restore has finished. r=mac-reviewers,bradwerth\n\nOn a cold launch the request arrives before the service is ready, so the auth window opened in the same tick as the first browser window, and whichever window macOS raised last ended up in front.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329874\n", "files": ["browser/modules/ASWebAuthSessionService.sys.mjs", "browser/modules/test/browser/browser_aswebauth_session.js"], "git_node": "ac93de1e28168520e4435f89ac542b921ec6ff45", "git_parents": ["3e185ef13da9a7d1dcc02b8832d6101739a5f7d8"], "node": "2a69b2b75ac515315e34ee7e503c326d1f94017a", "parents": ["ca07e908f79788620b6bebd1f81c54ef267477ac"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075497 - Update dav1d to bf5a8792744ee78c977dfb16503f9156dde6401d r=chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329116\n", "files": ["media/libdav1d/moz.yaml", "media/libdav1d/vcs_version.h", "third_party/dav1d/src/arm/64/mc.S", "third_party/dav1d/src/arm/64/mc16.S", "third_party/dav1d/src/arm/64/mc16_sve.S", "third_party/dav1d/src/arm/64/mc_dotprod.S", "third_party/dav1d/src/arm/64/refmvs.S", "third_party/dav1d/src/arm/asm.S", "third_party/dav1d/src/decode.c", "third_party/dav1d/src/refmvs.c", "third_party/dav1d/src/riscv/64/filmgrain.S", "third_party/dav1d/src/riscv/64/filmgrain16.S", "third_party/dav1d/src/x86/ipred16_avx2.asm", "third_party/dav1d/src/x86/ipred_sse.asm", "third_party/dav1d/src/x86/looprestoration16_avx2.asm", "third_party/dav1d/src/x86/looprestoration16_sse.asm", "third_party/dav1d/src/x86/looprestoration_sse.asm", "third_party/dav1d/src/x86/mc_sse.asm"], "git_node": "dd0f1b1e7b3e0427951be58c1d693de553d5eb79", "git_parents": ["ac93de1e28168520e4435f89ac542b921ec6ff45"], "node": "cbf4059771422d1999145de309bc2ac93b7db5f3", "parents": ["2a69b2b75ac515315e34ee7e503c326d1f94017a"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075494 - Update libvpx to 5e680f30801d03c21078f8c4b772464752516211 r=chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329114\n", "files": ["media/libvpx/libvpx/test/decode_api_test.cc", "media/libvpx/libvpx/test/vpx_image_test.cc", "media/libvpx/libvpx/vp8/decoder/threading.c", "media/libvpx/libvpx/vp8/vp8_cx_iface.c", "media/libvpx/libvpx/vp8/vp8_dx_iface.c", "media/libvpx/libvpx/vp9/vp9_cx_iface.c", "media/libvpx/libvpx/vpx/src/vpx_image.c", "media/libvpx/libvpx/vpx/vpx_image.h", "media/libvpx/libvpx/vpx_ports/aarch64_cpudetect.c", "media/libvpx/libvpx/vpx_util/vpx_pthread.h", "media/libvpx/moz.yaml"], "git_node": "2a22615b9df2c66a31168c75b792fb3db6f5cd10", "git_parents": ["dd0f1b1e7b3e0427951be58c1d693de553d5eb79"], "node": "e32ed0d0e09377587a2559a8f0763d7e6fe364e5", "parents": ["cbf4059771422d1999145de309bc2ac93b7db5f3"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075494 - Apply mozilla patches for libvpx r=chunmin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329115\n", "files": ["media/libvpx/libvpx/vp8/vp8_cx_iface.c", "media/libvpx/libvpx/vp9/vp9_cx_iface.c", "media/libvpx/libvpx/vpx_ports/aarch64_cpudetect.c", "media/libvpx/libvpx/vpx_util/vpx_pthread.h"], "git_node": "9829976c0b24c000cc5dfa3c33c5c115510b8f19", "git_parents": ["2a22615b9df2c66a31168c75b792fb3db6f5cd10"], "node": "e28118bf16dc80805ec01423cd556018115d634b", "parents": ["e32ed0d0e09377587a2559a8f0763d7e6fe364e5"], "tags": []}, {"author": "Andreas Pehrson \u003capehrson@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074630 - Tolerate the remote service dying while RemoteManager.createCodec() ends a failed request. r=jolin,media-playback-reviewers,geckoview-reviewers,tcampbell\n\nRemoteConnection.unlink() nulls mRemote under a different monitor than\ncreateCodec() holds, so the endRequest() call added by bug 2064678 can hit a\nNullPointerException just like the ones in releaseCodec() and\nonRemoteMediaDrmBridgeReleased(), which already catch it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328281\n", "files": ["mobile/android/geckoview/src/main/java/org/mozilla/gecko/media/RemoteManager.java"], "git_node": "1b24bfa791fda563744d72094eef35bf82e2a8da", "git_parents": ["9829976c0b24c000cc5dfa3c33c5c115510b8f19"], "node": "f116acda2cd1bf95b411f2d3414407be1bc9d8da", "parents": ["e28118bf16dc80805ec01423cd556018115d634b"], "tags": []}, {"author": "Kui-Feng Lee \u003cthinker.li@gmail.com\u003e", "branch": "default", "desc": "Bug 2073336 - [Wayland] Detach a tab dragged out through the top edge r=stransky,gtk-reviewers\n\nWhen a drag ends on none of our windows, no drag-drop signal has set the end\npoint and nsDragSessionSource::SourceEndDragSession falls back to\ngdk_window_get_device_position(). On Wayland that call doesn't handle a pointer\noutside the window: it reports the position in whichever surface the pointer is\nover, so the answer is frozen where the pointer left, or measured in another\nwindow. Either one lands inside the source window, and the tab strip reads it\nas a drop next to the tab bar and returns early, so a tab dragged out through\nthe top edge is never torn off.\n\nReport a point outside the window instead. The end point is read as\nclient-relative, so it has to clear GetClientOffset() to land outside.\n\nDo that only when the drag is not over the window it was started from, which is\nthe one the query asks about. nsDragSession::Schedule() tracks that from the\ntask's window: a motion or a drop task carries the window the drag is over, a\nleave task carries none. It starts true because a drag starts over its source\nwindow, which keeps the old query for a compositor that reports no drag motion\nat all, where claiming the drag left would tear off a tab that was only\nclicked.\n\nSubtract that margin from the queried point on the path that keeps it too. It\nis relative to the toplevel GdkWindow and was stored unchanged.\n\nAlso compare the end point against the (-1, -1) it is initialized to instead of\ntesting \"x \u003c 0\", so a real drop with a negative x is no longer discarded.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327437\n", "files": ["widget/gtk/nsDragService.cpp", "widget/gtk/nsDragService.h", "widget/gtk/nsDragSessionSource.cpp"], "git_node": "df50180ae2db99a2fcfa8465e33b4c827c74281d", "git_parents": ["1b24bfa791fda563744d72094eef35bf82e2a8da"], "node": "2093a7cc09b7f9e87b214d0c164fa67b4f6754e6", "parents": ["f116acda2cd1bf95b411f2d3414407be1bc9d8da"], "tags": []}, {"author": "Eden Chuang \u003cechuang@mozilla.com\u003e", "branch": "default", "desc": "Bug 2068407 - Stop main-thread code from racing on ThreadSafeRequestHandle::mRequest r=hsingh\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326183\n", "files": ["dom/workers/ScriptLoader.cpp", "dom/workers/loader/CacheLoadHandler.cpp", "dom/workers/loader/NetworkLoadHandler.cpp", "dom/workers/loader/WorkerLoadContext.cpp", "dom/workers/loader/WorkerLoadContext.h"], "git_node": "4e1e928adb4b446e27f38ebcec6f30582b2ce41b", "git_parents": ["df50180ae2db99a2fcfa8465e33b4c827c74281d"], "node": "aabed7a50a88bbcc7ac109c93333dd585b085e77", "parents": ["2093a7cc09b7f9e87b214d0c164fa67b4f6754e6"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074722 - move duplicate sidebar browser test helper functions from browser_bookmarks_sidebar.js to head.js r=sidebar-reviewers,nsharpley\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328597\n", "files": ["browser/components/sidebar/tests/browser/browser_bookmarks_keyboard_navigation.js", "browser/components/sidebar/tests/browser/browser_bookmarks_multiselect.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar_auxclick.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar_glean.js", "browser/components/sidebar/tests/browser/browser_bookmarks_sidebar_root_folders.js", "browser/components/sidebar/tests/browser/head.js"], "git_node": "477bf58b5005ac4afafddc6e9f9f45b37ab27d60", "git_parents": ["4e1e928adb4b446e27f38ebcec6f30582b2ce41b"], "node": "50c5a257e989f28ffc2ea45e95352737a16126c5", "parents": ["aabed7a50a88bbcc7ac109c93333dd585b085e77"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Report split view adoption in the TabMove and TabSelect event details rather than on the tab. r=kcochrane,tabbrowser-reviewers,extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329461\n", "files": ["browser/components/extensions/parent/ext-tabs.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab.mjs", "browser/components/tabbrowser/content/tabsplitview.mjs", "browser/components/tabbrowser/docs/tab-events.md"], "git_node": "05fb4da9ce843db8d5a0dc58ac7df043ae97978a", "git_parents": ["477bf58b5005ac4afafddc6e9f9f45b37ab27d60"], "node": "539e56788a2e90efc166b4900b6fbfdcf74babf4", "parents": ["50c5a257e989f28ffc2ea45e95352737a16126c5"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Rename TabGroupCreate's isAdoptingGroup detail and addTabGroup option to adopting. r=kcochrane,tabbrowser-reviewers,extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329558\n", "files": ["browser/components/extensions/parent/ext-tabGroups.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tabgroup.mjs", "browser/components/tabbrowser/docs/tab-events.md", "browser/components/tabbrowser/test/browser/tabs/browser_tab_groups.js"], "git_node": "1cc7d1e37eb9160fbee0f4d99393ecf431c11022", "git_parents": ["05fb4da9ce843db8d5a0dc58ac7df043ae97978a"], "node": "703c98683dd7e5a5a1cbd95360e019938a453467", "parents": ["539e56788a2e90efc166b4900b6fbfdcf74babf4"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Move the tab's _fullLabel and _labelIsInitialTitle into Tabbrowser's private state, and make labelIsContentTitle a public tab field. r=kcochrane,tabbrowser-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329591\n", "files": ["browser/components/genai/GenAI.sys.mjs", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab.mjs"], "git_node": "b7a408676b2b9b274551cab96901ab025dc07798", "git_parents": ["1cc7d1e37eb9160fbee0f4d99393ecf431c11022"], "node": "053664070a4a45e3ff85eeba59d934543fadbbc2", "parents": ["703c98683dd7e5a5a1cbd95360e019938a453467"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Replace the tab's initializingTab expando with an initializing field on the tab class. r=kcochrane,tabbrowser-reviewers,extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329592\n", "files": ["browser/components/extensions/parent/ext-tabs.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab.mjs"], "git_node": "8293f749415d5295acc9530105ef1ed8f8643bed", "git_parents": ["b7a408676b2b9b274551cab96901ab025dc07798"], "node": "d6cecb5299e3bcb879ed697dbf5d87bdeff7b8c1", "parents": ["053664070a4a45e3ff85eeba59d934543fadbbc2"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075016 - Move the tab's successor and predecessors into Tabbrowser's private state. r=kcochrane,tabbrowser-reviewers,extension-reviewers,robwu\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329769\n", "files": ["browser/components/extensions/parent/ext-browser.js", "browser/components/extensions/parent/ext-tabs.js", "browser/components/tabbrowser/Tabbrowser.sys.mjs", "browser/components/tabbrowser/content/tab.mjs", "browser/components/tabbrowser/test/browser/tabs/browser_tabSuccessors.js"], "git_node": "02b9ac1cc6b780864aba05c98b24834e3f284a85", "git_parents": ["8293f749415d5295acc9530105ef1ed8f8643bed"], "node": "bba84bac8477011428a1f508734363dcfc899ed8", "parents": ["d6cecb5299e3bcb879ed697dbf5d87bdeff7b8c1"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2059729 - Add getTabGroups/getTabGroupById to TabManagementService r=ai-security-reviewers,bjohns,gregtatum,flozia\n\nGive tab group aware prompting a single read API so its consumers don't each reach into gBrowser.tabGroups and duplicate the filtering. Grouped tabs use the same isAllowedURL, isNewPageUrl, and sanitizeUntrustedContent rules as getTabList(); to share them, isAllowedURL moves into ChatUtils.sys.mjs. Includes xpcshell coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D319374\n", "files": ["browser/components/aiwindow/models/SecurityProperties.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/aiwindow/ui/test/xpcshell/test_TabManagementService.js"], "git_node": "b663a41a18d198863dbebdab01048a5ce799c8b3", "git_parents": ["02b9ac1cc6b780864aba05c98b24834e3f284a85"], "node": "3e39850716a64dd65639f50cfff48ea3006d963a", "parents": ["bba84bac8477011428a1f508734363dcfc899ed8"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2014499 - Add a Groups section to the Smart Window mentions panel r=fluent-reviewers,urlbar-reviewers,mlucks,bolsson\n\nRender open tab groups as a \"Groups\" section above the \"Tabs\" section in the mentions panel, sourced from TabManagementService.getTabGroups(). Each group shows a colored chicklet (the tab group color with the label's initial) and the group label, capped by a new browser.urlbar.mentions.maxGroupResults pref that is separate from the tab cap.\n\nThe tab group color tokens (--tab-group-*) live in the tabbrowser chrome sheet, which the AI window content document does not load, so they are imported into ai-window-shared.css and reused rather than duplicating the palette.\n\nGroup rows are non-interactive for now; selecting a group to mention is wired up separately (bug 2059787), and filtering groups while typing is deferred. Adds component and integration browser tests.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320275\n", "files": ["browser/app/profile/firefox.js", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.mjs", "browser/components/aiwindow/ui/content/ai-window-shared.css", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_panel_list.js", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/UrlbarPrefs.sys.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "browser/locales/en-US/browser/aiWindow.ftl"], "git_node": "9b35e49fce1a426afc4f79e017b7548d2015235b", "git_parents": ["b663a41a18d198863dbebdab01048a5ce799c8b3"], "node": "2a71453f5b72f01e051588d12fa403c23f7d43dc", "parents": ["3e39850716a64dd65639f50cfff48ea3006d963a"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059730 - Add a tabGroup mention type to the Smart Window mention data model r=czhou,urlbar-reviewers,ai-security-reviewers,tetchart,Standard8\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326996\n", "files": ["browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.mjs", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_tab_group_mentions.js", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/urlbar/SmartbarMentionsPanelSearch.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "browser/components/urlbar/content/SmartbarMentionUtils.mjs", "browser/components/urlbar/jar.mn", "tools/@types/generated/tspaths.json"], "git_node": "9adde31a91bb752f6f69e8642a3dd6187c1fee4d", "git_parents": ["9b35e49fce1a426afc4f79e017b7548d2015235b"], "node": "b8d7fe7ad673bb9a157474181205900ec4271662", "parents": ["2a71453f5b72f01e051588d12fa403c23f7d43dc"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2059782 - Render a referenced tab group as a single chip r=urlbar-reviewers,ai-security-reviewers,flozia,Standard8\n\nA tab group has no page behind it, so a chip cannot take a favicon or a link from it. A referenced tab group now renders as a single chip showing its label in the group's color, in the smartbar header, the prompt input and the submitted message, and it collapses into the existing grouped chip summary alongside tab chips. The box holding the label's initial is a new tab-group-icon element that the chip and the collapsed summary share. Storybook covers both in every group color.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326469\n", "files": ["browser/components/aiwindow/ui/components/ai-chat-message/ai-chat-message.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.css", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.mjs", "browser/components/aiwindow/ui/components/ai-grouped-chip-container/ai-grouped-chip-container.stories.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.css", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.mjs", "browser/components/aiwindow/ui/components/ai-website-chip/ai-website-chip.stories.mjs", "browser/components/aiwindow/ui/components/tab-group-icon/tab-group-icon.css", "browser/components/aiwindow/ui/components/tab-group-icon/tab-group-icon.mjs", "browser/components/aiwindow/ui/components/tab-group-icon/tab-group-icon.stories.mjs", "browser/components/aiwindow/ui/components/website-chip-container/website-chip-container.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/test/browser/browser_aichat_message.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_grouped_chips.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_website_chip.js", "browser/components/aiwindow/ui/test/browser/test_website_chip_page.html", "browser/components/multilineeditor/plugins/MentionsPlugin.mjs", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "tools/@types/generated/tspaths.json"], "git_node": "396f83ae315e8df31f5bb99b3748ba403bc90757", "git_parents": ["9adde31a91bb752f6f69e8642a3dd6187c1fee4d"], "node": "1afde41a9b11809b1067db10b854d5181403d6ab", "parents": ["b8d7fe7ad673bb9a157474181205900ec4271662"], "tags": []}, {"author": "chloezhouny \u003cchloezhouny@gmail.com\u003e", "branch": "default", "desc": "Bug 2059787 - Wire tab group selection through the mention entry points r=urlbar-reviewers,flozia,Standard8\n\nTab group rows in the mentions panel were render only. Group rows now wrap a panel-item the way description rows do, with the tab group icon beside it, so they are clickable and keyboard reachable and go through the panel's existing item-selected path. The row reports the group's color and type along with its ID and label.\n\nThe \"+\" menu now adds a group context chip and the inline \"@\" command inserts a group mention, both identified by the group's ID rather than a URL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326470\n", "files": ["browser/components/aiwindow/metrics.yaml", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.css", "browser/components/aiwindow/ui/components/smartwindow-panel-list/smartwindow-panel-list.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_context_chips.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_inline_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_panel_list.js", "browser/components/urlbar/content/SmartbarInputUtils.mjs", "tools/@types/generated/lib.gecko.glean.d.ts"], "git_node": "812d37ec01043e4cb0bbfbe640fb28f70142f7cc", "git_parents": ["396f83ae315e8df31f5bb99b3748ba403bc90757"], "node": "4cd4f8bb85a128af2a1a37fb6ff32ff8ad01b063", "parents": ["1afde41a9b11809b1067db10b854d5181403d6ab"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059755 - Expand tab group mentions at submit time r=czhou,urlbar-reviewers,ai-security-reviewers,Standard8\n\nA tab group mention is expanded when a prompt is sent. The expanded members do not get the persistent fetch permissions a single explicitly mentioned tab receives.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328253\n", "files": ["browser/components/aiwindow/models/Conversation.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/ui/components/ai-chat-content/ai-chat-content.mjs", "browser/components/aiwindow/ui/components/ai-window/ai-window.mjs", "browser/components/aiwindow/ui/modules/ChatConversation.sys.mjs", "browser/components/aiwindow/ui/modules/TabManagementService.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_tab_group_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_aiwindow_smartbar_telemetry.js", "browser/components/aiwindow/ui/test/browser/browser_security_tab_group_mentions.js", "browser/components/aiwindow/ui/test/browser/browser_smartwindow.toml", "browser/components/aiwindow/ui/test/browser/head.js", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/SmartbarMentionUtils.mjs"], "git_node": "0dfc4f2224af3a7fbd616484dd65f33df712d177", "git_parents": ["812d37ec01043e4cb0bbfbe640fb28f70142f7cc"], "node": "c7894e9f5fd5f5ca903a9e177ae54ab2e0314714", "parents": ["4cd4f8bb85a128af2a1a37fb6ff32ff8ad01b063"], "tags": []}, {"author": "Florian Zia \u003cfzia@mozilla.com\u003e", "branch": "default", "desc": "Bug 2059783 - Include tab group info in the browser context prompt r=bjohns\n\nTabs expanded from a tab group were indistinguishable from individually mentioned tabs. Serialize them nested under their respective groups.\n\nThe Remote Settings fragment for the model is tracked in bug 2070322.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328573\n", "files": ["browser/components/aiwindow/models/PromptLoader.sys.mjs", "browser/components/aiwindow/models/tests/browser/browser_prompt_loader_browser_context.js"], "git_node": "eb29b2f020df80d6fac5f7ab969ba56db8a57f49", "git_parents": ["0dfc4f2224af3a7fbd616484dd65f33df712d177"], "node": "bea3816fecf3c8e987ebac29e6ba946cc0c1c9c4", "parents": ["c7894e9f5fd5f5ca903a9e177ae54ab2e0314714"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2071417 - Use new declarative web push parser for telemetry if pref is enabled. r=saschanaz\" for causing wpt tests failures at mozilla/push-api/declarative\n\nThis reverts commit acb27df01daa1625d610335bfd652047eee83801.\n", "files": ["dom/push/Declarative.cpp", "dom/push/rust/src/declarative_push.rs", "dom/serviceworkers/ServiceWorkerEvents.cpp", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/mozilla/tests/push-api/declarative-glean.https.any.js"], "git_node": "ea3b1b5c80bd7314a4aa2e60077fe3d0efdf2b67", "git_parents": ["eb29b2f020df80d6fac5f7ab969ba56db8a57f49"], "node": "9a72c1b3df2ade2bda329c7f809c8110b9c29986", "parents": ["bea3816fecf3c8e987ebac29e6ba946cc0c1c9c4"], "tags": []}, {"author": "Silaghi \u003casilaghi@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1797270, 1922759: apply code formatting via Lando\" for causing webrtc failures\n\nThis reverts commit 95fdf608df3a6b747bf7e8909651e81f1ab184b9.\n\nRevert \"Bug 1797270 - Make WebRTC work with FIPS enabled r=keeler,webrtc-reviewers,kershaw,bwc,webidl,smaug,ipc-reviewers\"\n\nThis reverts commit a7482b1babe9741e8e33beb370f6f038b6dbc2fa.\n\nRevert \"Bug 1922759 - Make nr_crypto_nss_hmac() work with FIPS enabled r=rrelyea,webrtc-reviewers,keeler,bwc\"\n\nThis reverts commit 91de7c72bccac01be2a1901dffdd55eea3cd0199.\n", "files": ["dom/crypto/WebCryptoTask.cpp", "dom/crypto/WebCryptoTask.h", "dom/media/gtest/TestRTCCertStore.cpp", "dom/media/gtest/moz.build", "dom/media/webrtc/MediaTransportParent.h", "dom/media/webrtc/PMediaTransport.ipdl", "dom/media/webrtc/PRTCCertService.ipdl", "dom/media/webrtc/RTCCertCleanupTimer.cpp", "dom/media/webrtc/RTCCertCleanupTimer.h", "dom/media/webrtc/RTCCertService.cpp", "dom/media/webrtc/RTCCertService.h", "dom/media/webrtc/RTCCertServiceChild.h", "dom/media/webrtc/RTCCertServiceData.cpp", "dom/media/webrtc/RTCCertServiceData.h", "dom/media/webrtc/RTCCertServiceParent.cpp", "dom/media/webrtc/RTCCertServiceParent.h", "dom/media/webrtc/RTCCertStore.cpp", "dom/media/webrtc/RTCCertStore.h", "dom/media/webrtc/RTCCertificate.cpp", "dom/media/webrtc/RTCCertificate.h", "dom/media/webrtc/WebrtcIPCTraits.h", "dom/media/webrtc/jsapi/MediaTransportHandler.cpp", "dom/media/webrtc/jsapi/MediaTransportHandler.h", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.cpp", "dom/media/webrtc/jsapi/MediaTransportHandlerIPC.h", "dom/media/webrtc/jsapi/MediaTransportParent.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.cpp", "dom/media/webrtc/jsapi/PeerConnectionImpl.h", "dom/media/webrtc/moz.build", "dom/media/webrtc/tests/mochitests/identity/mochitest.toml", "dom/media/webrtc/tests/mochitests/identity/mochitest_no_socket_process.toml", "dom/media/webrtc/tests/mochitests/test_peerConnection_certificates.html", "dom/media/webrtc/transport/build/moz.build", "dom/media/webrtc/transport/common.build", "dom/media/webrtc/transport/dtlsdigest.cpp", "dom/media/webrtc/transport/dtlsdigest.h", "dom/media/webrtc/transport/dtlsidentity.cpp", "dom/media/webrtc/transport/dtlsidentity.h", "dom/media/webrtc/transport/nricectx.cpp", "dom/media/webrtc/transport/test/transport_unittests.cpp", "dom/media/webrtc/transport/transportlayerdtls.cpp", "dom/media/webrtc/transport/transportlayerdtls.h", "dom/tests/mochitest/whatwg/test_structuredCloneAndExposed.html", "dom/webidl/RTCCertificate.webidl", "ipc/glue/BackgroundParentImpl.cpp", "media/webrtc/signaling/gtest/mediapipeline_unittest.cpp", "netwerk/ipc/PSocketProcessBridge.ipdl", "netwerk/ipc/SocketProcessBridgeChild.cpp", "netwerk/ipc/SocketProcessBridgeParent.cpp", "netwerk/ipc/SocketProcessBridgeParent.h"], "git_node": "7c25785e0e5f84ffc7ecb71ad54135989a4db440", "git_parents": ["ea3b1b5c80bd7314a4aa2e60077fe3d0efdf2b67"], "node": "d87635523658bc78131ce55840acab4777d37cee", "parents": ["9a72c1b3df2ade2bda329c7f809c8110b9c29986"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648889 - patch 1 - Rename IdentifierType to IdentifierStatus for consistency with Unicode terminology. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321079\n", "files": ["intl/unicharutil/util/nsUnicodeProperties.h", "netwerk/dns/nsIDNService.cpp"], "git_node": "ac77cb65d3c724b6debb728c525c063fe4e83a16", "git_parents": ["7c25785e0e5f84ffc7ecb71ad54135989a4db440"], "node": "dc28e16b63579977025baac0593fc66380ba8dc8", "parents": ["d87635523658bc78131ce55840acab4777d37cee"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648889 - patch 2 - Create an IdentifierType enum corresponding to Unicode's Identifier_Type, and a simple accessor to check a single value. r=m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321080\n", "files": ["intl/components/src/UnicodeProperties.h"], "git_node": "c124b746516c4c256518ad0251f822b054e35d20", "git_parents": ["ac77cb65d3c724b6debb728c525c063fe4e83a16"], "node": "505cc8293e7d4dca4f31012077b95f2195abb03d", "parents": ["dc28e16b63579977025baac0593fc66380ba8dc8"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648889 - patch 3 - Create a UnicodeProperties method to map a script tag (as a string) to a Script code. r=m_kato\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321081\n", "files": ["intl/components/src/UnicodeProperties.h"], "git_node": "530c5c009de23a3208a489780de0889f25f4b465", "git_parents": ["c124b746516c4c256518ad0251f822b054e35d20"], "node": "3a1a894d5259c03874e0070c3d05e9d2d0a8035b", "parents": ["505cc8293e7d4dca4f31012077b95f2195abb03d"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648889 - patch 4 - Allow Javanese, Balinese, Canadian Syllabics and N'Ko in IDN labels. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D321082\n", "files": ["modules/libpref/init/StaticPrefList.yaml", "netwerk/dns/nsIDNService.cpp", "netwerk/dns/nsIDNService.h"], "git_node": "7e630b3f484c936557d341055c567342318a1c28", "git_parents": ["530c5c009de23a3208a489780de0889f25f4b465"], "node": "ac89c3a8734119b0675063fc6730c9502d0ef81d", "parents": ["3a1a894d5259c03874e0070c3d05e9d2d0a8035b"], "tags": []}, {"author": "Jonathan Kew \u003cjkew@mozilla.com\u003e", "branch": "default", "desc": "Bug 1648889 - patch 5 - Add examples of Allowed Limited Use scripts to test_idn_spoof.js. r=necko-reviewers,valentin\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323295\n", "files": ["netwerk/test/unit/test_idn_spoof.js"], "git_node": "a0a153c9cc142b6bb076c1430e6bdf7ed4a29634", "git_parents": ["7e630b3f484c936557d341055c567342318a1c28"], "node": "80344ca163ccb2bdc457d340c4bfde3ff0277552", "parents": ["ac89c3a8734119b0675063fc6730c9502d0ef81d"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075696 - Part 1. Only allow MediaCodec NDK audio decoders if using a CDM or for AAC. r=media-playback-reviewers,jolin\n\nOur only implementation for AAC is the MediaCodec NDK, and our pure\nsoftware encoders do not support decrypting as that also requires\nthe NDK.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329315\n", "files": ["dom/media/platforms/ffmpeg/FFmpegAudioDecoder.cpp", "dom/media/platforms/ffmpeg/FFmpegDataDecoder.cpp"], "git_node": "b2c191e67a00234b35d31d045409baf104ecdb43", "git_parents": ["a0a153c9cc142b6bb076c1430e6bdf7ed4a29634"], "node": "c20566c207d177073d8b1e43d44bdb2ac0a508e0", "parents": ["80344ca163ccb2bdc457d340c4bfde3ff0277552"], "tags": []}, {"author": "Andrew Osmond \u003caosmond@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075696 - Part 2. Add Opus/FLAC/Vorbis support to ffvpx for MediaCodec NDK. r=media-playback-reviewers,jolin\n\nThis will allow EME playback for content encrypting audio of these\ntypes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329316\n", "files": ["media/ffvpx/README_MOZILLA", "media/ffvpx/config_android32.h", "media/ffvpx/config_android64.h", "media/ffvpx/config_android_x86_64.h", "media/ffvpx/libavcodec/allcodecs.c", "media/ffvpx/libavcodec/codec_list.c", "media/ffvpx/libavcodec/mediacodecdec.c", "media/ffvpx/libavcodec/mediacodecdec_common.c", "media/ffvpx/libavcodec/mediacodecdec_common.h", "media/ffvpx/mediacodec_xiph_flac.patch"], "git_node": "4c76f7bf28b06271a12fb9e9388218865148ab02", "git_parents": ["b2c191e67a00234b35d31d045409baf104ecdb43"], "node": "4b843c27d0df09356191fb582e48a7de10c48cb0", "parents": ["c20566c207d177073d8b1e43d44bdb2ac0a508e0"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2075805 - jit/arm64: load 128-bit SIMD constants from the literal pool. r=yury\n\nloadConstantSimd128 builds every v128 constant with vixl's Movi(hi, lo),\nwhich only has single-instruction forms for simple splats. Everything\nelse goes through x16, up to ten instructions per constant:\n\n  mov  x16, #0x400\n  movk x16, #0xc08, lsl #16\n  movk x16, #0xfbff, lsl #32\n  movk x16, #0xf3f7, lsl #48\n  dup  v31.2d, x16\n  mov  x16, #0\n  mov  v31.d[1], x16\n\nx86 loads such constants from the constant pool with one instruction.\nDo the same on arm64 with a 128-bit literal load, and keep Movi only\nwhere it is a single movi or mvni:\n\n  ldr  q31, \u003cliteral\u003e\n\nOn a JetStream 3 run with an instrumented shell and only the optimizing\nwasm tier, 4,705 constants took 35,321 instructions to build and each is\nnow one load plus 16 bytes of pool. On an Apple M4 Max this shortens the\nJetStream 3 wasm SIMD tests (median of three runs, all ranges disjoint):\n\n  transformersjs-bert-wasm     average  32.6 ms -\u003e  28.7 ms  (-11.9%)\n  transformersjs-whisper-wasm  average  1032 ms -\u003e  972 ms   (-5.9%)\n  tfjs-wasm-simd               runtime  1159 ms -\u003e  1042 ms  (-10.2%)\n\nconst-arm64-vixl-codegen.js now expects the literal load for the\nconstants that used to take the multi-instruction sequences.\n\nFound with armlint.\n\nClaude-Session: https://claude.ai/code/session_01WsnsqJvQCmPUe3GWmsM77Q\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329370\n", "files": ["js/src/jit-test/tests/wasm/simd/const-arm64-vixl-codegen.js", "js/src/jit/arm64/Assembler-arm64.cpp", "js/src/jit/arm64/Assembler-arm64.h", "js/src/jit/arm64/MacroAssembler-arm64-inl.h"], "git_node": "ae3bc161ff5ed16506b3477a4849544c236af2b7", "git_parents": ["4c76f7bf28b06271a12fb9e9388218865148ab02"], "node": "939e6b4352076af3e86104920ae998344c297ca4", "parents": ["4b843c27d0df09356191fb582e48a7de10c48cb0"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2075863 - Part 1: jit/arm64: specialize wasm SIMD compares against constants. r=yury\n\nLane-wise compares against an all-zero vector compared against a\nregister holding zero, and not-equal was always cmeq followed by mvn.\nSpecialize compares with a constant operand into\nMWasmBinarySimd128WithConstant on ARM64, as x86 already does, and give\nthe ARM64 constant compare overloads the #0 forms of cmeq, cmgt, cmge,\ncmle, cmlt and the fcm equivalents, with cmtst for not-equal and\nunsigned greater-than. Other constants are loaded into the scratch\nregister.\n\nGVN merges equal constants, so a zero is usually shared by several\ncompares. On ARM64 a shared zero is still specialized at each use;\nx86 keeps specializing single-use constants only.\n\nOn the JetStream 3 wasm Ion code, compares against a zeroed register\ndrop from 3,255 cmeq to 87 and cmeq+mvn against zero from 1,313 to 4.\n\nFound with armlint.\n\nClaude-Session: https://claude.ai/code/session_01WsnsqJvQCmPUe3GWmsM77Q\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329427\n", "files": ["js/src/jit-test/tests/wasm/simd/compare-zero-arm64-ion-codegen.js", "js/src/jit-test/tests/wasm/simd/compare-zero.js", "js/src/jit/MIR-wasm.cpp", "js/src/jit/MacroAssembler.h", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/arm64/Lowering-arm64.cpp", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/arm64/MacroAssembler-arm64.cpp", "js/src/jit/arm64/MacroAssembler-arm64.h"], "git_node": "3beeaccf18ab585e7525ad976cd66b77646aca68", "git_parents": ["ae3bc161ff5ed16506b3477a4849544c236af2b7"], "node": "ad7852beaed18421be4218103843ddb53179a853", "parents": ["939e6b4352076af3e86104920ae998344c297ca4"], "tags": []}, {"author": "Andrew Gaul \u003candrew@gaul.org\u003e", "branch": "default", "desc": "Bug 2075863 - Part 2: jit/arm64: fold a wasm SIMD not-equal of an and against zero into cmtst. r=yury\n\nne(and(a, b), 0) takes an and plus a compare against zero, while ARM64's\ncmtst computes it in one instruction. Rewrite it in\nMWasmBinarySimd128::foldsTo into a MozI*TestBits operation when the and\nhas no other use, gated on canTestBits(), which only ARM64 returns true\nfor. The rewrite runs before the constant specialization, which would\notherwise take the zero.\n\nOn the JetStream 3 wasm Ion code, all 674 and+cmeq+mvn sequences become\none cmtst.\n\nFound with armlint.\n\nClaude-Session: https://claude.ai/code/session_01WsnsqJvQCmPUe3GWmsM77Q\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329782\n", "files": ["js/src/jit-test/tests/wasm/simd/test-bits-arm64-ion-codegen.js", "js/src/jit-test/tests/wasm/simd/test-bits.js", "js/src/jit/MIR-wasm.cpp", "js/src/jit/MIR-wasm.h", "js/src/jit/MacroAssembler.h", "js/src/jit/arm/Lowering-arm.cpp", "js/src/jit/arm64/CodeGenerator-arm64.cpp", "js/src/jit/arm64/Lowering-arm64.cpp", "js/src/jit/arm64/MacroAssembler-arm64-inl.h", "js/src/jit/mips-shared/Lowering-mips-shared.cpp", "js/src/jit/x86-shared/Lowering-x86-shared.cpp", "js/src/wasm/WasmConstants.h", "js/src/wasm/WasmOpIter.cpp"], "git_node": "43ebb19328d4621eaf3000050090a487852be78a", "git_parents": ["3beeaccf18ab585e7525ad976cd66b77646aca68"], "node": "ff718434c4c2babc10e0d63df1001ca95090e21c", "parents": ["ad7852beaed18421be4218103843ddb53179a853"], "tags": []}, {"author": "Devota Aabel \u003cdaabel@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076250 - Update top sites header to show when the number of top sites is greater than the dynamically calculated value of collapsedTopSitesCount r=android-reviewers,gl\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329651\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/home/store/HomepageState.kt"], "git_node": "c0ed42e7589532849a14bc6631b2f687183eae91", "git_parents": ["43ebb19328d4621eaf3000050090a487852be78a"], "node": "289dc748f576bc9387fe539c4f49e2d5a74ede47", "parents": ["ff718434c4c2babc10e0d63df1001ca95090e21c"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075359 - Don't send a urlbar load to the selected tab when its own tab closed before the parent handled it. r=mbeier,urlbar-reviewers\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329929\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/tests/browser-newtab/browser_pickResult.js", "browser/components/urlbar/tests/browser/browser_enter.js"], "git_node": "8d8808a9835d746ee9374ab6b31ab7805ef7291b", "git_parents": ["c0ed42e7589532849a14bc6631b2f687183eae91"], "node": "d78c02e4da7e372a0d613188948c6d5cb69c2f48", "parents": ["289dc748f576bc9387fe539c4f49e2d5a74ede47"], "tags": []}, {"author": "Mike Hommey \u003cmh+mozilla@glandium.org\u003e", "branch": "default", "desc": "Bug 2076772 - Adjust bootstrap tasks after bug 2012556. r=firefox-build-system-reviewers,ahochheiden\n\nThe bootstrap tasks currently install pip, which is not needed after bug 2012556.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329950\n", "files": ["taskcluster/kinds/bootstrap/kind.yml"], "git_node": "b5b780ec9c255f2bc5827bd0785f337617926e8e", "git_parents": ["8d8808a9835d746ee9374ab6b31ab7805ef7291b"], "node": "d0510b9ca249f90fee0138e4256cce4b9760c8fd", "parents": ["d78c02e4da7e372a0d613188948c6d5cb69c2f48"], "tags": []}, {"author": "