webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48572}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/experiments/field_trials.py", "third_party/libwebrtc/video/end_to_end_tests/extended_reports_tests.cc", "third_party/libwebrtc/video/video_send_stream_impl.cc"], "git_node": "151d8f0737883a19be3bb056773c4bfd6209981b", "git_parents": ["c45e793e13001bb931db4aa796abc1a27aaa6f3b"], "node": "d4af69891c3dab2d3a6858ca1382c0c4c1904d49", "parents": ["52faca890758f9bcdec0f825b7db7cf8c65d9076"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 9fc6fae20b\n\nUpstream commit: https://webrtc.googlesource.com/src/+/9fc6fae20b380da22568f10732029547d25ae383\n    Add screenshare CBR rate control tests for V2 Video Encoder API.\n\n    Implement screenshare test cases in video_encoder_rate_control_unittest:\n    - ScreenshareSlideChangesFullHd: Evaluates 1080p slide presentations with\n      mostly static content punctuated by intermittent slide changes every 2s,\n      verifying bounded scene change bursts and compact static encoding.\n    - ScreenshareScrollingHd: Evaluates 720p scrolling over high-resolution\n      content (1850x1110) with alternating scrolling and paused intervals,\n      verifying CBR sliding window and total bitrate deviation.\n    - ScreenshareZeroHzHd: Evaluates Zero-Hz mode where a static frame is\n      encoded at 1 Hz repeat rate while each frame's encoded CBR duration\n      remains 1/target_fps, and subsequent resumption of 30 fps motion,\n      verifying no oversized bursts on idle frames and quick convergence\n      upon resuming motion.\n\n    Bug: webrtc:496266459\n    Change-Id: I0137fd256ab3daae29771fc508b4bd70a311acd0\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/501920\n    Auto-Submit: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Reviewed-by: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Mirko Bonadei \u003cmbonadei@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48573}\n", "files": ["third_party/libwebrtc/BUILD.gn", "third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/video_codecs/test/BUILD.gn", "third_party/libwebrtc/api/video_codecs/test/video_codec_test_utils.h", "third_party/libwebrtc/api/video_codecs/test/video_encoder_rate_control_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0034.patch", "third_party/libwebrtc/moz-patch-stack/s0044.patch", "third_party/libwebrtc/moz-patch-stack/s0054.patch", "third_party/libwebrtc/moz-patch-stack/s0081.patch", "third_party/libwebrtc/moz-patch-stack/s0085.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0097.patch", "third_party/libwebrtc/moz-patch-stack/s0099.patch"], "git_node": "370ac952890473f52754d126af31352bb9f275d9", "git_parents": ["151d8f0737883a19be3bb056773c4bfd6209981b"], "node": "fbc12be8536c0a8fdd902d6404b5975505376661", "parents": ["d4af69891c3dab2d3a6858ca1382c0c4c1904d49"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 06acbbc0d0\n\nUpstream commit: https://webrtc.googlesource.com/src/+/06acbbc0d01ccad87bcbdfe388821f09b1c22215\n    Roll chromium_revision 85078ad0ec..464ebda2ac (1696126:1696311)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/85078ad0ec..464ebda2ac\n    Full diff: https://chromium.googlesource.com/chromium/src/+/85078ad0ec..464ebda2ac\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/2d01b03227..1574c5aef1\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/1eacc2cb78..0da9e79e7e\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/2a22