83-g640ab6c4-1.tar.xz,Mac_arm64/llvm-code-coverage-llvmorg-24-init-7283-g640ab6c4-1.tar.xz,Mac_arm64/llvmobjdump-llvmorg-24-init-7283-g640ab6c4-1.tar.xz,Win/clang-llvmorg-24-init-7283-g640ab6c4-1.tar.xz,Win/clang-tidy-llvmorg-24-init-7283-g640ab6c4-1.tar.xz,Win/clang-win-runtime-library-llvmorg-24-init-7283-g640ab6c4-1.tar.xz,Win/clangd-llvmorg-24-init-7283-g640ab6c4-1.tar.xz,Win/llvm-code-coverage-llvmorg-24-init-7283-g640ab6c4-1.tar.xz,Win/llvmobjdump-llvmorg-24-init-7283-g640ab6c4-1.tar.xz\n    * src/third_party/llvm-libc/src: https://chromium.googlesource.com/external/github.com/llvm/llvm-project/libc.git/+log/9ef880711f..d58e50d914\n    * src/third_party/perfetto: https://chromium.googlesource.com/external/github.com/google/perfetto.git/+log/5dbeaad4ce..03eb494aa4\n    * src/third_party/r8/cipd: -1V8pgjfgIrRz6RjDpaYF9kGKo0sji9NFvuGNy0RgbwC..Se2NNfs4yZgN4v03fPg3pXpD5AtqEt1MSmDs0a2vpKYC\n    * src/third_party/r8/d8/cipd: C8K1dojUIvIPnzBfVm0O9aWW6yMLCnUUXgaUR9jOB-wC..Se2NNfs4yZgN4v03fPg3pXpD5AtqEt1MSmDs0a2vpKYC\n    * src/third_party/rust-toolchain: Linux_x64/rust-toolchain-0913b18e489ac1011b580e31fa5559654be12bfc-2-llvmorg-24-init-3796-g20e97c4b.tar.xz,Mac/rust-toolchain-0913b18e489ac1011b580e31fa5559654be12bfc-2-llvmorg-24-init-3796-g20e97c4b.tar.xz,Mac_arm64/rust-toolchain-0913b18e489ac1011b580e31fa5559654be12bfc-2-llvmorg-24-init-3796-g20e97c4b.tar.xz,Win/rust-toolchain-0913b18e489ac1011b580e31fa5559654be12bfc-2-llvmorg-24-init-3796-g20e97c4b.tar.xz..Linux_x64/rust-toolchain-c33d8f3b5a50b56466998e8c5ed8a077d2caed84-1-llvmorg-24-init-7283-g640ab6c4.tar.xz,Mac/rust-toolchain-c33d8f3b5a50b56466998e8c5ed8a077d2caed84-1-llvmorg-24-init-7283-g640ab6c4.tar.xz,Mac_arm64/rust-toolchain-c33d8f3b5a50b56466998e8c5ed8a077d2caed84-1-llvmorg-24-init-7283-g640ab6c4.tar.xz,Win/rust-toolchain-c33d8f3b5a50b56466998e8c5ed8a077d2caed84-1-llvmorg-24-init-7283-g640ab6c4.tar.xz\n    * src/third_party/siso/cipd: git_revision:efbbe7f1892211b5e9512576843a3c247b6a6d7c..git_revision:2f0eb0113740f469481a64760ab8feabe529a5b1\n    * src/tools: https://chromium.googlesource.com/chromium/src/tools/+log/5aca3642a5..2376c79e4e\n    DEPS diff: https://chromium.googlesource.com/chromium/src/+/dca9c4468e..ff37f76274/DEPS\n\n    BUG=None\n\n    Change-Id: Ib2ac1d04e528818a599bae4b1db9f48a822d3eac\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/500780\n    Bot-Commit: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Commit-Queue: chromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com \u003cchromium-webrtc-autoroll@webrtc-ci.iam.gserviceaccount.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48513}\n", "files": ["third_party/libwebrtc/DEPS", "third_party/libwebrtc/README.mozilla.last-vendor"], "git_node": "fa67f444627bf30e0df5525dde6a2ca6e557b60e", "git_parents": ["0751f5adea7383d80d697fe40d415bdef4f5ec9b"], "node": "dcb9f0e1580f689be3adf4b6fd0eeb17bc7bf683", "parents": ["0980ec7be51929301e8ad3c0f6fc9fb4a531cce4"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 87e745fb8a\n\nUpstream commit: https://webrtc.googlesource.com/src/+/87e745fb8ae23396e8d405946bfa62241a9a70cf\n    Filter ambiguous receive times and make delay metrics optional in SCReAM\n\n    Retransmitted packets sent on the same SSRC without RTX have ambiguous\n    receive times because an acknowledgement cannot be uniquely matched to\n    either the original transmission or the retransmission.\n\n    This change:\n    1. Adds ambiguous_receive_time to PacketResult and PacketFeedback,\n       identifying non-RTX retransmissions in TransportFeedbackAdapter.\n    2. Encapsulates delay and RTT metrics in ScreamFeedback::DelayMetrics\n       as an std::optional\u003cDelayMetrics\u003e, populated only when at least one\n       received packet has an unambiguous receive time.\n    3. Excludes ambiguous packets from the tail burst window one-way delay\n       and RTT sample calculations in ParseScreamFeedback.\n    4. Updates DelayBasedCongestionControl and ScreamV2 to only process\n       delay metrics when present, while continuing to track received bytes.\n\n    Bug: webrtc:557097749\n    Change-Id: Ibef72e7303071caaf8852132b97c71409df35464\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/500740\n    Reviewed-by: Bj\u00f6rn Terelius \u003cterelius@webrtc.org\u003e\n    Reviewed-by: Danil Chapovalov \u003cdanilchap@webrtc.org\u003e\n    Commit-Queue: Per Kjellander \u003cperkj@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48514}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/transport/network_types.h", "third_party/libwebrtc/modules/congestion_controller/rtp/transport_feedback_adapter.cc", "third_party/libwebrtc/modules/congestion_controller/rtp/transport_feedback_adapter.h", "third_party/libwebrtc/modules/congestion_controller/rtp/transport_feedback_adapter_unittest.cc", "third_party/libwebrtc/modules/congestion_controller/scream/delay_based_congestion_control.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_feedback.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_feedback.h", "third_party/libwebrtc/modules/congestion_controller/scream/scream_feedback_unittest.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.cc", "third_party/libwebrtc/modules/congestion_controller/scream/scream_v2.h"], "git_node": "304865a80805d571aa8b3832e65c17e9ce8c9070", "git_parents": ["fa67f444627bf30e0df5525dde6a2ca6e557b60e"], "node": "5dcddd14dc16a6c10ab5226b68a87be9f6e6cf72", "parents": ["dcb9f0e1580f689be3adf4b6fd0eeb17bc7bf683"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from e709ce2bda\n\nUpstream commit: https://webrtc.googlesource.com/src/+/e709ce2bda513944340fae92284df63304248d49\n    Validate dimensions and crop offsets in H.264 SPS parser\n\n    Add bounds checking in SpsParser to prevent arithmetic overflow and\n    underflow when calculating picture dimensions and crop offsets:\n    - Validate chroma_format_idc (\u003c= 3) and pic_order_cnt_type (\u003c= 2).\n    - Compute uncropped dimensions using 64-bit arithmetic and verify\n      they do not exceed uint16_t limits.\n    - Ensure total crop offsets do not equal or exceed uncropped dimensions,\n      preventing underflow and zero or negative picture sizes.\n    - Return std::nullopt on malformed parameters.\n\n    Bug: chromium:516683896\n    Change-Id: Ib405c094f9d7b568f436033bd356039ace1104df\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/500603\n    Reviewed-by: Sergey Silkin \u003cssilkin@webrtc.org\u003e\n    Commit-Queue: Erik Spr\u00e5ng \u003csprang@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48515}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/common_video/BUILD.gn", "third_party/libwebrtc/common_video/h264/h264_common.h", "third_party/libwebrtc/common_video/h264/h264_common_unittest.cc", "third_party/libwebrtc/common_video/h264/sps_parser.cc", "third_party/libwebrtc/common_video/h264/sps_parser_unittest.cc", "third_party/libwebrtc/modules/video_coding/codecs/h264/h264_encoder_impl.cc"], "git_node": "134f8a40e8554f6b49f0f502241cc7253dc03826", "git_parents": ["304865a80805d571aa8b3832e65c17e9ce8c9070"], "node": "e40bac3df5a93784c8ed3d521894e28166e80fe4", "parents": ["5dcddd14dc16a6c10ab5226b68a87be9f6e6cf72"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 99e7859850\n\nUpstream commit: https://webrtc.googlesource.com/src/+/99e7859850dd3dff1929fd653f77eb94c422c879\n    Propagate RtpPacketInfos to audio OnData sink callbacks.\n\n    Allows downstream implementations of AudioTrackSinkInterface and\n    AudioSinkInterface to inspect contributing sources (CSRCs), audio\n    levels, and RTP timestamps without having to asynchronously query\n    GetSources() on the signaling thread.\n\n    - Adds packet_infos pointer to AudioSinkInterface::Data.\n    - Adds 7-parameter OnData overload to AudioTrackSinkInterface with a\n      default implementation for backwards compatibility.\n    - Updates ChannelReceive::GetAudioFrameWithInfo to optimize ts_stats_lock_\n      locking and pass packet_infos to audio_sink_-\u003eOnData.\n    - Updates RemoteAudioSource::OnData to forward packet_infos to attached\n      sinks.\n\n    Fixed: webrtc:557581300\n    Change-Id: I0f21099744f2fad6b4494564c5a4816ac72bfe19\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/500604\n    Reviewed-by: Jakob Ivarsson\u200e \u003cjakobi@webrtc.org\u003e\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48516}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/BUILD.gn", "third_party/libwebrtc/api/call/audio_sink.h", "third_party/libwebrtc/api/media_stream_interface.h", "third_party/libwebrtc/api/test/mock_audio_sink.h", "third_party/libwebrtc/audio/BUILD.gn", "third_party/libwebrtc/audio/channel_receive.cc", "third_party/libwebrtc/audio/channel_receive_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0027.patch", "third_party/libwebrtc/moz-patch-stack/s0035.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/moz-patch-stack/s0138.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/audio_rtp_receiver_unittest.cc", "third_party/libwebrtc/pc/remote_audio_source.cc"], "git_node": "2a1607a2842ec67c54677b322e3c3b9985b529e5", "git_parents": ["134f8a40e8554f6b49f0f502241cc7253dc03826"], "node": "c0546f101a901d25caa43a2d73454fe4aec951bd", "parents": ["e40bac3df5a93784c8ed3d521894e28166e80fe4"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 146ababc35\n\nUpstream commit: https://webrtc.googlesource.com/src/+/146ababc3594dd2cdcf5cbec373e08f1c0fb2220\n    Increase execution timeout for webrtc_builders to 3 hours\n\n    Alleviate more_config builders now starting to take longer than 2 hours\n    for windows.\n\n    Bug: None\n    Change-Id: I350dd6b30a4090a5834921d896817e6a5220255e\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/500820\n    Commit-Queue: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Auto-Submit: Christoffer Dewerin \u003cjansson@google.com\u003e\n    Reviewed-by: Jeremy Leconte \u003cjleconte@google.com\u003e\n    Cr-Commit-Position: refs/heads/main@{#48517}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/infra/config/builders.star", "third_party/libwebrtc/infra/config/generated/luci/cr-buildbucket.cfg"], "git_node": "1aa2f5b3a0225aeea4eb8832b183c05108e01ee9", "git_parents": ["2a1607a2842ec67c54677b322e3c3b9985b529e5"], "node": "56d924f5fc45c9d6e6db1e94da7c06a7a7e94780", "parents": ["c0546f101a901d25caa43a2d73454fe4aec951bd"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 175760c20e\n\nUpstream commit: https://webrtc.googlesource.com/src/+/175760c20e3170e12670f820eaa42e618442a2f1\n    Eliminate unnecessary copies in common_audio/\n\n    - In wav_header.cc, remove ReadFourCC and pass uint32_t sought_chunk_id\n      to FindWaveChunk instead of const std::string to eliminate heap\n      allocations during chunk lookup.\n\n    Bug: webrtc:374845009\n    Change-Id: I75d0eb5776867c86b0914548487b90a6218dd9ac\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/500621\n    Auto-Submit: Fredrik Solenberg \u003csolenberg@webrtc.org\u003e\n    Commit-Queue: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Reviewed-by: Per \u00c5hgren \u003cpeah@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48518}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/common_audio/wav_header.cc"], "git_node": "1e64fb3dc03d9b8084f23a75d157f10616a10384", "git_parents": ["1aa2f5b3a0225aeea4eb8832b183c05108e01ee9"], "node": "528300fbf917de7e9d780e1767ecfa0d3ac9a4a5", "parents": ["56d924f5fc45c9d6e6db1e94da7c06a7a7e94780"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 7d8c903464\n\nUpstream commit: https://webrtc.googlesource.com/src/+/7d8c9034643495be0560dca507f0a14a0d28ba9d\n    Add OnSourceChanged to RtpReceiverObserverInterface\n\n    Consolidate observer management in RtpReceiverBase and implement source\n    change notifications, fulfilling the W3C webrtc-extensions onssrcchange\n    / oncsrcchange specification.\n\n    Source change notifications follow the pattern established by\n    OnFirstPacketReceived: SourceTracker reports source changes via\n    OnFrameDelivered return values, while RtpReceiverBase manages observer\n    lifecycles and directly dispatches OnSourceChanged on the signaling\n    thread (both on frame delivery and upon late observer registration).\n\n    Bug: chromium:463591201\n    Change-Id: I64b36a5a0b2963d96179457ea11579cfd9660187\n    Reviewed-on: https://webrtc-review.googlesource.com/c/src/+/499840\n    Commit-Queue: Tomas Gunnarsson \u003ctommi@webrtc.org\u003e\n    Reviewed-by: Henrik Bostr\u00f6m \u003chbos@webrtc.org\u003e\n    Cr-Commit-Position: refs/heads/main@{#48519}\n", "files": ["third_party/libwebrtc/README.mozilla.last-vendor", "third_party/libwebrtc/api/rtp_receiver_interface.h", "third_party/libwebrtc/modules/rtp_rtcp/source/source_tracker.cc", "third_party/libwebrtc/modules/rtp_rtcp/source/source_tracker.h", "third_party/libwebrtc/modules/rtp_rtcp/source/source_tracker_unittest.cc", "third_party/libwebrtc/moz-patch-stack/s0038.patch", "third_party/libwebrtc/moz-patch-stack/s0094.patch", "third_party/libwebrtc/pc/BUILD.gn", "third_party/libwebrtc/pc/audio_rtp_receiver.cc", "third_party/libwebrtc/pc/audio_rtp_receiver.h", "third_party/libwebrtc/pc/audio_rtp_receiver_unittest.cc", "third_party/libwebrtc/pc/peer_connection_integrationtest.cc", "third_party/libwebrtc/pc/rtp_receiver.cc", "third_party/libwebrtc/pc/rtp_receiver.h", "third_party/libwebrtc/pc/test/integration_test_helpers.cc", "third_party/libwebrtc/pc/test/integration_test_helpers.h", "third_party/libwebrtc/pc/video_rtp_receiver.cc", "third_party/libwebrtc/pc/video_rtp_receiver.h", "third_party/libwebrtc/pc/video_rtp_receiver_unittest.cc"], "git_node": "ca4faa162afe750ac3505dd228ed9cd1e66b26b6", "git_parents": ["1e64fb3dc03d9b8084f23a75d157f10616a10384"], "node": "c18f1cb3a0088bea69d17810d30bf901759df031", "parents": ["528300fbf917de7e9d780e1767ecfa0d3ac9a4a5"], "tags": []}, {"author": "Dan Baker \u003cdbaker@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072400 - Vendor libwebrtc from 926a9e77c3\n\nUpstream commit: https://webrtc.googlesource.com/src/+/926a9e77c37e7d6caaa118d587cfb1a626fb2542\n    Roll chromium_revision ff37f76274..12cc78a34e (1693276:1693454)\n\n    Change log: https://chromium.googlesource.com/chromium/src/+log/ff37f76274..12cc78a34e\n    Full diff: https://chromium.googlesource.com/chromium/src/+/ff37f76274..12cc78a34e\n\n    Changed dependencies\n    * src/build: https://chromium.googlesource.com/chromium/src/build/+log/18e8a67142..32bce974d0\n    * src/ios: https://chromium.googlesource.com/chromium/src/ios/+log/1ebb0f90e0..5628f3219e\n    * src/testing: https://chromium.googlesource.com/chromium/src/testing/+log/c0d223c773..8336a4da33\n    * src/third_party: https://chromium.googlesource.com/chromium/src/third_party/+log/9c5dc538c7..5bfa6fb8db\n    * src/third_party/androidx/cipd: bjjwswDzZPOfBG9uUjjZogHyFC2dHGvwj_iq0n4NvW0C..SaKviZDdUK6w34Z7aU4SvE5FZBeke5TuFOXWm5JCWEkC\n    * src/third_party/breakpad/breakpad: https