, "parents": ["57eaecfd678fefc915d6ebc09cafaf1da029f6b1"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 1981768 - Log HSTS and HTTPS RR connection upgrades to the web console. r=valentin,necko-reviewers\" for causing dt failures @browser_webconsole_filters.js.\n\nThis reverts commit 25429cef17b5be0f41404db8ff739011c85f5c30.\n", "files": ["dom/locales/en-US/chrome/security/security.properties", "dom/security/test/https-only/browser.toml", "dom/security/test/https-only/browser_hsts_host.js", "netwerk/base/nsNetUtil.cpp", "netwerk/base/nsNetUtil.h", "netwerk/protocol/http/HttpBaseChannel.cpp", "netwerk/protocol/http/nsHttpChannel.cpp", "netwerk/protocol/http/nsHttpHandler.cpp", "netwerk/test/browser/browser_mock_https_rr.js"], "git_node": "59c8a945f229e17d78d091d82f1624494e2c5006", "git_parents": ["aa9fc669aa99b3fa423ee78051453d9a12882b4b"], "node": "1fe19376259ef81a318f5dd69e1b52b0d1430569", "parents": ["d5958157493a5d1ecd49948e4b82a6272bfdfb09"], "tags": []}], "date": 1791433040, "git_changesets": ["aa9fc669aa99b3fa423ee78051453d9a12882b4b", "59c8a945f229e17d78d091d82f1624494e2c5006"], "user": "csabou@mozilla.com"}, "45515": {"changesets": [{"author": "lougeniac64 \u003c5533446+lougeniaC64@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2075668 - Update sync selected data header for per-device syncing r=settings-reviewers,fluent-reviewers,flod,Gijs\n\nThe heading above the selected data-type list in Settings \u2192 Sync when the user is signed in, Sync is enabled, and at least one data type is selected on this installation.\n\nCurrent copy: \u201cData synced across devices\u201d\n\nCWTS-specific problem: In the per-device model this list is the data this installation syncs, not a shared list describing what every other device syncs.\n\nProposed replacement: \u201cData syncing on this device\u201d\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329305\n", "files": ["browser/components/preferences/tests/sync/browser_sync_settings_ui.js", "browser/components/preferences/widgets/sync-engine-list/sync-engines-list.mjs", "browser/locales/en-US/browser/preferences/preferences.ftl"], "git_node": "2025ff2e950c176e049cd593c94690c71920d7bf", "git_parents": ["7c2d3e02907ac2cb403008f2521bcc5d54fa95a4"], "node": "7d4a7b3184e0eb333257157c64a7514502cfe312", "parents": ["57eaecfd678fefc915d6ebc09cafaf1da029f6b1"], "tags": []}, {"author": "Adam Vandolder \u003cavandolder@mozilla.com\u003e", "branch": "default", "desc": "Bug 2070879 - Wait for frame construction before considering document speculation rules. r=smaug,dom-core-reviewers\n\nDocument rules can only match against links which are being rendered,\nand we cannot determine this until after their frames have been constructed.\nSo if frames still need to be contructed, delay consider loads until\nafter the next refresh.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330247\n", "files": ["dom/base/SpeculationRuleSet.cpp", "dom/base/SpeculationRuleSet.h", "dom/base/SpeculationRules.cpp", "dom/base/SpeculationRules.h", "dom/base/speculationrules/lib.rs", "testing/web-platform/meta/speculation-rules/prefetch/document-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/implicit-source.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/inline-speculation-rules-after-stylesheet.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy-from-rules.https.html.ini", "testing/web-platform/meta/speculation-rules/prefetch/referrer-policy.https.html.ini"], "git_node": "408aa33592d1b138e5a8a79f9adee1964ddd6a38", "git_parents": ["2025ff2e950c176e049cd593c94690c71920d7bf"], "node": "aae571d72ea1fa9882673cb05c3cfc679867f5d5", "parents": ["7d4a7b3184e0eb333257157c64a7514502cfe312"], "tags": []}, {"author": "kpatenio \u003ckpatenio@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071466 - update session restore metric descriptions to fix inaccuracies r=sessionstore-reviewers,sthompson,sfoster\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330952\n", "files": ["browser/components/sessionstore/metrics.yaml"], "git_node": "5f36d16681fd22531068b4f83f1e2edb6bd7b14c", "git_parents": ["408aa33592d1b138e5a8a79f9adee1964ddd6a38"], "node": "2d3ef7442ac1f3c3fa0d3069280aa2680baf9a72", "parents": ["aae571d72ea1fa9882673cb05c3cfc679867f5d5"], "tags": []}, {"author": "Jan Varga \u003cjvarga@igalia.com\u003e", "branch": "default", "desc": "Bug 2079188 - Expose the CSS namespace in workers and worklets behind a preference; r=emilio,webidl,firefox-style-system-reviewers\n\nExtend the CSS namespace exposure to Worker and PaintWorklet while keeping the\nexisting Window-only APIs restricted to Window.\n\nGate the additional exposure behind the\nlayout.css.namespace.exposed-in-workers-and-worklets preference, which is\ndisabled by default for now.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D331606\n", "files": ["dom/webidl/CSS.webidl", "dom/worklet/WorkletCommon.h", "dom/worklet/WorkletGlobalScope.cpp", "dom/worklet/moz.build", "layout/style/CSS.cpp", "layout/style/CSS.h", "modules/libpref/init/StaticPrefList.yaml"], "git_node": "0c560faeeecc47b9d6512100395736f8260dbfa6", "git_parents": ["5f36d16681fd22531068b4f83f1e2edb6bd7b14c"], "node": "af47ca3386c7a8516571d58cc4e8746d90b435a5", "parents": ["2d3ef7442ac1f3c3fa0d3069280aa2680baf9a72"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/browser/errorpages/src/main/res/values-fa/strings.xml", "mobile/android/android-components/components/browser/errorpages/src/main/res/values-zh-rCN/strings.xml", "mobile/android/android-components/components/compose/base/src/main/res