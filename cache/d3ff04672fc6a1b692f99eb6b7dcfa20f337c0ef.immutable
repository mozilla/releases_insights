 "files": ["browser/components/aiwindow/models/Chat.sys.mjs", "browser/components/aiwindow/models/Tools.sys.mjs", "browser/components/aiwindow/models/agents/Monitor.sys.mjs", "browser/components/aiwindow/models/aitab/AITab.sys.mjs", "browser/components/aiwindow/models/search/SearchWorkflow.sys.mjs", "browser/components/aiwindow/models/tests/browser/aitab_attacker_page.html", "browser/components/aiwindow/models/tests/browser/aitab_source_page.html", "browser/components/aiwindow/models/tests/browser/browser.toml", "browser/components/aiwindow/models/tests/browser/browser_aitab.js", "browser/components/aiwindow/models/tests/browser/browser_aitab_generation.js", "browser/components/aiwindow/models/tests/browser/browser_tools_get_page_content.js", "browser/components/aiwindow/models/tests/xpcshell/test_Chat.js", "browser/components/aiwindow/models/tests/xpcshell/test_Tools_GetPageContent.js", "browser/components/aiwindow/ui/modules/AITabMigrations.sys.mjs", "browser/components/aiwindow/ui/modules/AITabSql.sys.mjs", "browser/components/aiwindow/ui/modules/AITabStore.sys.mjs", "browser/components/aiwindow/ui/test/AIWindowTestUtils.sys.mjs", "browser/components/aiwindow/ui/test/browser/browser_smartwindow_telemetry.js", "browser/components/aiwindow/ui/test/xpcshell/test_AITabStore.js"], "git_node": "7b4d5bee25d0df83cd0019a1c629e86578bad089", "git_parents": ["3359814ca4ea70c66b2295cb23aea59aeaaabb90"], "node": "91448854f9045ef5ee76950036b46e652663b299", "parents": ["f16a5371df5fa9fc1d5bcabc0e75e35570e7d238"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2036347 - Navigate to a URL typed in an engine search mode where the unified search button is always available. r=daleharvey,urlbar-reviewers\n\nLocal search modes and the Smartbar's forked Enter path are unchanged.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329707\n", "files": ["browser/components/urlbar/UrlbarMuxerStandard.sys.mjs", "browser/components/urlbar/UrlbarProviderHeuristicFallback.sys.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarQueryContext.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tests/browser-newtab/browser_searchModeSwitcher.js", "browser/components/urlbar/tests/browser-searchMode/browser_heuristic.js", "browser/components/urlbar/tests/unit/test_providerHeuristicFallback.js"], "git_node": "ed2213b182bbe67432a0e78095d195c60ff210fe", "git_parents": ["7b4d5bee25d0df83cd0019a1c629e86578bad089"], "node": "68e33cbec6c3b15fe02e4526a9941170b1a0653a", "parents": ["91448854f9045ef5ee76950036b46e652663b299"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1735620 - Remove unused UpdateImageBuffer code in IpcResourceUpdateQueue r=gfx-reviewers,nical\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320758\n", "files": ["gfx/layers/wr/IpcResourceUpdateQueue.cpp", "gfx/layers/wr/IpcResourceUpdateQueue.h"], "git_node": "b95cbf2a4c45db63a389f273e5fd09ba4093c159", "git_parents": ["ed2213b182bbe67432a0e78095d195c60ff210fe"], "node": "bfb84f5961d9e6583333a5d6b0d554730a1f88b2", "parents": ["68e33cbec6c3b15fe02e4526a9941170b1a0653a"], "tags": []}, {"author": "Chaoya Li \u003charry75369@gmail.com\u003e", "branch": "default", "desc": "Bug 2069252 - Fix incorrect frame endTime calculation for HEVC in MKV with B-frames. r=alwu,media-playback-reviewers\n\nMatroska blocks carry presentation timestamps in decode order, so on\ntracks that reorder (e.g. HEVC with B-frames) the peeked packet is not a\npresentation neighbour and the calculated endTime is wrong. Detect\nreordering once at ReadMetadata and fall through to the container\nduration on reordered tracks instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D323514\n", "files": ["dom/media/gtest/TestWebMDemuxer.cpp", "dom/media/gtest/moz.build", "dom/media/platforms/agnostic/bytestreams/H265.cpp", "dom/media/platforms/agnostic/bytestreams/H265.h", "dom/media/platforms/agnostic/bytestreams/gtest/TestByteStreams.cpp", "dom/media/webm/MatroskaDemuxer.cpp", "dom/media/webm/WebMDemuxer.cpp", "dom/media/webm/WebMDemuxer.h"], "git_node": "9b5774816700e4c09b8bc399a5c067b701864e41", "git_parents": ["b95cbf2a4c45db63a389f273e5fd09ba4093c159"], "node": "e513c7f249c53865de38f8a62c17ce4c06be1e0b", "parents": ["bfb84f5961d9e6583333a5d6b0d554730a1f88b2"], "tags": []}, {"author": "Chaoya Li \u003charry75369@gmail.com\u003e", "branch": "default", "desc": "Bug 2071275 - Fix incorrect frame endTime calculation for AVC in MKV with B-frames. r=alwu,media-playback-reviewers\n\nMatroska blocks carry presentation timestamps in decode order, so on\ntracks that reorder (e.g. AVC with B-frames) the peeked packet is not a\npresentation neighbour and the calculated endTime is wrong. Detect\nreordering once at ReadMetadata and fall through to the container\nduration on reordered tracks instead.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D325778\n", "files": ["dom/media/gtest/TestWebMDemuxer.cpp", "dom/media/gtest/moz.build", "dom/media/platforms/agnostic/bytestreams/H264.cpp", "dom/media/platforms/agnostic/bytestreams/H264.h", "dom/media/platforms/agnostic/bytestreams/gtest/TestByteStreams.cpp", "dom/media/webm/MatroskaDemuxer.cpp"], "git_node": "b6cd0a968d01fa0d2722754058b3e3478f27f602", "git_parents": ["9b5774816700e4c09b8bc399a5c067b701864e41"], "node": "0c0056499534eba96bdb75f7aa5e59a78618f717", "parents": ["e513c7f249c53865de38f8a62c17ce4c06be1e0b"], "tags": []}, {"author": "Chaoya Li \u003charry75369@gmail.com\u003e", "branch": "default", "desc": "Bug 2069252 - Add audio+video demuxing test for reordered HEVC in MKV. r=alwu,media-playback-reviewers\n\nDemux audio and video in parallel off the shared demuxer: the video\nsamples must last the container default duration while the audio\nsamples stay contiguous, proving the reorder handling does not disturb\nthe in-order track.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D326901\n", "files": ["dom/media/gtest/TestWebMDemuxer.cpp", "dom/media/gtest/moz.build", "dom/media/test/output_hevc_aac.mkv"], "git_node": "4c877370d5cb831951ab634bacaa065598ec8d70", "git_parents": ["b6cd0a968d01fa0d2722754058b3e3478f27f602"], "node": "78762ff0a67192be2cd28b90301c160ce7b98106", "parents": ["0c0056499534eba96bdb75f7aa5e59a78618f717"], "tags": []}, {"author": "Exploding-Joysticks \u003cExplodingJoysticks@proton.me\u003e", "branch": "default", "desc": "Bug 1773060 - Remove unused \"Coverage ping\" telemetry pref, code and tests r=chumphreys\n\nDifferential Revision: https://phabricator.services.mozilla.com/D320753\n", "files": ["browser/app/profile/firefox.js", "toolkit/components/telemetry/app/TelemetryControllerParent.sys.mjs", "toolkit/components/telemetry/docs/data/coverage-ping.md", "toolkit/components/telemetry/moz.build", "toolkit/components/telemetry/pings/CoveragePing.sys.mjs", "toolkit/components/telemetry/tests/unit/test_CoveragePing.js", "toolkit/components/telemetry/tests/unit/xpcshell.toml"], "git_node": "85a3741581ac24ef40628db2bcf53e6201420be0", "git_parents": ["4c877370d5cb831951ab634bacaa065598ec8d70"], "node": "56c48b67d9204cb9a50a62176e4ea5a10dc83d8a", "parents": ["78762ff0a67192be2cd28b90301c160ce7b98106"], "tags": []}, {"author": "Tom Ritter \u003ctom@ritter.vg\u003e", "branch": "default", "desc": "Bug 1700396: Bump Updatebot for mach vendor date fix r=tnikkel\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329251\n", "files": ["taskcluster/docker/updatebot/updatebot-version.sh"], "git_node": "45a1a772e6d678b41dd1520f37ddd91d9954e8a1", "git_parents": ["85a3741581ac24ef40628db2bcf53e6201420be0"], "node": "7142adced1082942dd2ae0941f1de7ec97d679fa", "parents": ["56c48b67d9204cb9a50a62176e4ea5a10dc83d8a"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\