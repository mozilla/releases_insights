1\nwo -\u003e 1036402a2bae38273188c428685714b7365ea1c1\nxh -\u003e 1036402a2bae38273188c428685714b7365ea1c1\nzam -\u003e 1036402a2bae38273188c428685714b7365ea1c1\nzh-CN -\u003e 1036402a2bae38273188c428685714b7365ea1c1\nzh-TW -\u003e 1036402a2bae38273188c428685714b7365ea1c1\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "2b5ce61aaa074383da6e3e20d7144dbdef760791", "git_parents": ["546b3cf938aa3e2b66e72510f6b3cf8520f9511a"], "node": "2a254a4803c7f850847ee943ad21addffa167eef", "parents": ["c0efb8e8e5e3e34edda8ea9161a29e60eeb8b3c1"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Package tests in the `android-aarch64-appservices/opt` and `android-x86_64-appservices/debug` builds r=nalexander\n\nArtifact builds configured with `--enable-appservices-in-tree` download\nfrom these tasks and require a `target.common.tests` archive.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330482\n", "files": ["taskcluster/kinds/build/android.yml"], "git_node": "0ddcbc89c796da1c65944b8065bf48781865551d", "git_parents": ["2b5ce61aaa074383da6e3e20d7144dbdef760791"], "node": "5e6c34f89c37d095bab4b4c0b2bcf71c8e11560c", "parents": ["2a254a4803c7f850847ee943ad21addffa167eef"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075308 - Fix artifact download progress going past 100% for compressed files r=firefox-build-system-reviewers,sylvestre\n\nTaskcluster serves some artifacts like `licenses.json` gzip compressed.\nTheir `Content-Length` is the compressed size, but the progress counted\nuncompressed bytes, so it showed 543%. It now counts the compressed\nbytes received.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329332\n", "files": ["python/mozbuild/mozbuild/artifact_cache.py", "python/mozbuild/mozbuild/test/test_artifact_cache.py"], "git_node": "0847829a193a04e46595acb6abe20756d6943521", "git_parents": ["0ddcbc89c796da1c65944b8065bf48781865551d"], "node": "b8c9dd0befad7bfcee2ed5ad45fb3d62512b2118", "parents": ["5e6c34f89c37d095bab4b4c0b2bcf71c8e11560c"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2035575 - Target app-services tasks only when their counterpart runs r=nalexander\n\nThe app-services cron selected tasks by name, so it also ran copies\nwhose counterpart never runs, such as the `-ioi` tests, which fail on\nAndroid.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330483\n", "files": ["taskcluster/gecko_taskgraph/target_tasks.py"], "git_node": "d43a5397e51a5592ee26759b7a73534a4708f820", "git_parents": ["0847829a193a04e46595acb6abe20756d6943521"], "node": "1fa7d52025d8c5476b6ffebb22f9bbdb850b2f17", "parents": ["b8c9dd0befad7bfcee2ed5ad45fb3d62512b2118"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077784 - Update PDF.js to 2581d8f70add6f945cee6f61425c2ae40009bd8d r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330573\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.css", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.css", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "9882d787f7e6c634bf1588cc73622b827e7c51c9", "git_parents": ["d43a5397e51a5592ee26759b7a73534a4708f820"], "node": "01c3cd1fe6d64bba178461957d92ddedafcf326b", "parents": ["1fa7d52025d8c5476b6ffebb22f9bbdb850b2f17"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 2077401 - Remove DCLayerTree::WebRenderOsCompositorKind r=gfx-reviewers,lsalzman\n\nDCLayerTree supports only layer compositor. Then WebRenderOsCompositorKind has only ::WebRenderOsCompositorKind::LayerCompositor now. And WebRenderOsCompositorKind is redundant.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330308\n", "files": ["gfx/webrender_bindings/DCLayerTree.cpp", "gfx/webrender_bindings/DCLayerTree.h", "gfx/webrender_bindings/RenderCompositorANGLE.cpp", "gfx/webrender_bindings/RenderCompositorANGLE.h"], "git_node": "5b08651b7d3884dc8a7e492ed1bd12e783e8db2d", "git_parents": ["9882d787f7e6c634bf1588cc73622b827e7c51c9"], "node": "2912fb9b2d772523ba852ee9b3b02b548f8b6365", "parents": ["01c3cd1fe6d64bba178461957d92ddedafcf326b"], "tags": []}, {"author": "Jens Stutte \u003cjstutte@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074584 - Wake the timer thread for a timer due before the end of its wakeup window. r=jlink,xpcom-reviewers,nika\n\nThe timer thread hands the monitor a wakeup time and a tolerance and, where\nthe monitor honours the tolerance, may sleep until the end of that window.\nAddTimer only compared a new timer against the start of the window, so a\ntimer due inside it did not wake the thread and fired late by the remaining\ntolerance.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328224\n", "files": ["xpcom/threads/TimerThread.cpp", "xpcom/threads/TimerThread.h"], "git_node": "709a955e10d56568cc6f0a7ac9ddee56d89f0a4a", "git_parents": ["5b08651b7d3884dc8a7e492ed1bd12e783e8db2d"], "node": "ce1542f62690911b9aab39e94a9a24e7f1f80e31", "parents": ["2912fb9b2d772523ba852ee9b3b02b548f8b6365"], "tags": []}, {"author": "Atila Butkovits \u003cabutkovits@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2074584 - Wake the timer thread for a timer due before the end of its wakeup window. r=jlink,xpcom-reviewers,nika\" for causing failures at test_dataChannel_dcsctp_interop.html.\n\nThis reverts commit 709a955e10d56568cc6f0a7ac9ddee56d89f0a4a.\n", "files": ["xpcom/threads/TimerThread.cpp", "xpcom/threads/TimerThread.h"], "git_node": "c03bbe1c8332f186aabc9b89de72496c532d7798", "git_parents": ["709a955e10d56568cc6f0a7ac9ddee56d89f0a4a"], "node": "b568eb752d94cebe7e0ec4fc3483298c78360581", "parents": ["ce1542f62690911b9aab39e94a9a24e7f1f80e31"], "tags": []}, {"author": "Simon Farre \u003csfarre@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076816 - Make BrowsingContext::HistoryID synced field CanSet::ParentOnly r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330605\n", "files": ["docshell/base/BrowsingContext.h"], "git_node": "e1b83791c0155c2547b4ff2f09312b4927c88d11", "git_parents": ["c03bbe1c8332f186aabc9b89de72496c532d7798"], "node": "cda1f4e3bb2b391118b7601ae1214affa07bb1b3", "parents": ["b568eb752d94cebe7e0ec4fc3483298c78360581"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077476 - Link the NSPR docs pages by path instead of by title. r=sylvestre\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330365\n", "files": ["docs/nspr/index.md", "docs/nspr/layeredpoll.md", "docs/nspr/nonblockinglayeredio.md", "docs/nspr/nspr_contributor_guide.md", "docs/nspr/reference/anonymous_shared_memory.md", "docs/nspr/reference/atomic_operations.md", "docs/nspr/reference/cached_monitors.md", "docs/nspr/reference/condition_variables.md", "docs/nspr/reference/date_and_time.md", "docs/nspr/reference/dynamic_library_linking.md", "docs/nspr/reference/floating_point_number_to_string_conversion.md", "docs/nspr/reference/hash_tables.md", "docs/nspr/reference/i_o_functions.md", "docs/nspr/reference/i_o_types.md", "docs/nspr/reference/index.md", "docs/nspr/reference/interval_timing.md", "docs/nspr/reference/introduction_to_nspr.md", "docs/nspr/reference/ipc_semaphores.md", "docs/nspr/reference/linked_lists.md", "docs/nspr/reference/locks.md", "docs/nspr/referenc