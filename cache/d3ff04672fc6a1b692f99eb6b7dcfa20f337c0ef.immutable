d1ff8ac2ad04c66d59826720\nte -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nth -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\ntl -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\ntr -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\ntrs -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nuk -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nur -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nuz -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nvi -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nwo -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nxh -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nzam -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nzh-CN -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\nzh-TW -\u003e 376d690aa99de464d1ff8ac2ad04c66d59826720\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "5f6f29fe10c2db65539947368a15e29e8c5c3194", "git_parents": ["35fc6452abc74b4ac08cbe10bc2f124cd2a923f2"], "node": "df94a2c3b3c9ea69f986514a19219b8434ee18cd", "parents": ["81cd0121662b4799550d7c9506a2717d712e4485"], "tags": []}, {"author": "Damien Carver \u003cdcarver@mozilla.com\u003e", "branch": "default", "desc": "Bug 2071892 - Add a tableLabel to the FileIO marker schema. r=profiler-reviewers,canova\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329956\n", "files": ["tools/profiler/gecko/ProfilerIOInterposeObserver.cpp", "tools/profiler/tests/xpcshell/test_feature_mainthreadio.js"], "git_node": "7b3e2b7607cdb9787bf1c7585b3975886812c039", "git_parents": ["5f6f29fe10c2db65539947368a15e29e8c5c3194"], "node": "be31200c3efd77019138b62e0c7afb39615d9b1b", "parents": ["df94a2c3b3c9ea69f986514a19219b8434ee18cd"], "tags": []}, {"author": "Logan Rosen \u003cloganrosen@gmail.com\u003e", "branch": "default", "desc": "Bug 1666654 - Add keyboard shortcut for Search Tabs r=tabbrowser-reviewers,fluent-reviewers,dao,bolsson,sthompson\n\nAdds Ctrl+Shift+A (Cmd+Shift+A on macOS) to enter tabs search mode in a normal browser window, opening one if needed. Records the shortcut entry point without loading the all-tabs menu.\n\nMoves the Add-ons Manager shortcut to Ctrl+Shift+F on Windows/Linux and Cmd+Shift+E on macOS to avoid password-manager and IBus shortcut conflicts. Stops recording usage of the former shortcut; bug 2077823 tracks notifying users who relied on it.\n\nTests the shortcut with a matching background tab, from a popup, and without a tracked browser window. Retains private-browsing Add-ons shortcut coverage.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D272822\n", "files": ["browser/base/content/browser-places.js", "browser/base/content/browser-sets.inc.xhtml", "browser/base/content/browser-sets.js", "browser/base/content/test/browser-general/browser_bug963945.js", "browser/base/content/test/browser-keyboard/browser.toml", "browser/base/content/test/browser-keyboard/browser_search_tabs_shortcut.js", "browser/components/tabbrowser/content/browser-allTabsMenu.inc.xhtml", "browser/locales/en-US/browser/browserSets.ftl"], "git_node": "542a91ee32c0f9f10042881a91e5b09529b9e01d", "git_parents": ["7b3e2b7607cdb9787bf1c7585b3975886812c039"], "node": "1e964e9ed4c379964fafc5757a20f751d939f754", "parents": ["be31200c3efd77019138b62e0c7afb39615d9b1b"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074348 - part 1 - Show the Compose menu while browsing r=android-reviewers,mcarare\n\nReplaces the View based browser-menu with the compose-menu module, kept as a\npopup anchored to the menu button rather than the bottom sheet other\napplications use it for. \"Desktop site\" becomes a row with an On/Off badge and\nthe previous dividers become group boundaries.\n\nThe button is a ComposeView browser action of its own because DisplayToolbar\nonly shows its own button for a menuBuilder or a menuController. Its store is\nbuilt when the menu opens, so the browser state is observed for only as long as\nthe menu is shown.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328733\n", "files": ["mobile/android/focus-android/.buildconfig.yml", "mobile/android/focus-android/app/build.gradle", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/ThreeDotMainMenuTest.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/BrowserRobot.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/ThreeDotMainMenuRobot.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserMenuController.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserToolbarIntegration.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuButton.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuMiddleware.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuToolbarAction.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/ToolbarMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/BrowserMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/DefaultBrowserMenu.kt", "mobile/android/focus-android/app/src/main/res/values/dimens.xml", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/browser/integration/BrowserToolbarIntegrationTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/BrowserMenuControllerTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/MenuMiddlewareTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/BrowserMenuTest.kt"], "git_node": "7d1b5c89dd2c5eb8404193a8f4aa158c58850699", "git_parents": ["542a91ee32c0f9f10042881a91e5b09529b9e01d"], "node": "8b0e19ff55bf38a53b2dfef8eca9157da0d1f8de", "parents": ["1e964e9ed4c379964fafc5757a20f751d939f754"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074348 - part 2 - Show the Compose menu on the home screen r=android-reviewers,mcarare\n\nUnlike the browser toolbar, which builds its actions in code, the home screen\ndeclares its menu button in fragment_urlinput.xml, so the browser-menu\nMenuButton view is replaced there with a ComposeView.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328734\n", "files": ["mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/ThreeDotMainMenuTest.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/HomeScreenRobot.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/ThreeDotMainMenuRobot.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/UrlInputFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuButton.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/home/HomeMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/home/HomeMenuMiddleware.kt", "mobile/android/focus-android/app/src/main/res/layout/fragment_urlinput.xml", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/home/HomeMenuMiddlewareTest.kt"], "git_node": "83e750d8b95b986c0cca4ceedd18a73e3e15c241", "git_parents": ["7d1b5c89dd2c5eb8404193a8f4aa158c58850699"], "node": "b045e01a13caf0593a22b3bbf7f1e4cf24776e6c", "parents": ["8b0e19ff55bf38a53b2dfef8eca9157da0d1f8de"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074348 - part 3 - Show the Compose menu in custom tabs r=android-reviewers,mcarare\n\nCustomTabsToolbarFeature no longer gets a menuBuilder: both menus provide their\ngroups through MenuItems, leaving BrowserToolbarIntegration to pick which one to\nbuild a store for.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328735\n", "files": ["mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/CustomTabRobot.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/ThreeDotMainMenuRobot.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserMenuController.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserToolbarIntegration.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/CustomTabMenuItemsMiddleware.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuButton.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuItems.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuMiddleware.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuToolbarAction.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/ToolbarMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/BrowserMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/CustomTabMenu.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/CustomTabMenuItemsMiddlewareTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/CustomTabMenuTest.kt"], "git_node": "ce354937b6b4b37c36998dc9d06deb2191212df9", "git_parents": ["83e750d8b95b986c0cca4ceedd18a73e3e15c241"], "node": "4d2a2170df766555bb3044c9b1427f91da6e33ae", "parents": ["b045e01a13caf0593a22b3bbf7f1e4cf24776e6c"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074348 - part 4 - Clean up legacy menu support in Focus r=android-reviewers,android-l10n-reviewers,parker,mcarare\n\nRemove obsolete menu styles, width overrides, and fact-based telemetry.\nReplace legacy menu resource references with Focus-owned resources and\nremove Focus's direct browser-menu dependency.\n\nExpose browser-menu through feature-customtabs because its public API\nstill references BrowserMenuBuilder.\n\nShare WebCompat reporter icon loading between both Compose menus and\nadd coverage for delayed reporter startup in custom tabs.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329106\n", "files": ["mobile/android/android-components/components/feature/customtabs/build.gradle", "mobile/android/focus-android/app/build.gradle", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/BrowserRobot.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/CustomTabRobot.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/HomeScreenRobot.kt", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/ThreeDotMainMenuRobot.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuButton.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/BrowserMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/CustomTabMenu.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/WebCompatReporter.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/telemetry/FactsProcessor.kt", "mobile/android/focus-android/app/src/main/res/values/dimens.xml", "mobile/android/focus-android/app/src/main/res/values/strings.xml", "mobile/android/focus-android/app/src/main/res/values/styles.xml", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/CustomTabMenuTest.kt"], "git_node": "e3edf555f59a45c7459af22d6ba8f8c68c5d48f1", "git_parents": ["ce354937b6b4b37c36998dc9d06deb2191212df9"], "node": "350496f3332c07c597a10c3dee90c4ca618014e5", "parents": ["4d2a2170df766555bb3044c9b1427f91da6e33ae"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074348 - part 5 - Move BrowserMenuController into MenuMiddleware r=android-reviewers,mcarare\n\nBrowserMenuController existed to be shared by the XML menu and the Compose one.\nWith only the latter left, handling the menu items can live in the middleware and\nBrowserFragment no longer needs to build the controller, passing in to the\nmiddleware the same callbacks that need the fragment.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328736\n", "files": ["mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserMenuController.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserToolbarIntegration.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/fragment/BrowserFragment.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/BrowserMenuCallbacks.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/MenuMiddleware.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/browser/integration/BrowserToolbarIntegrationTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/BrowserMenuControllerTest.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/MenuMiddlewareTest.kt"], "git_node": "e169834f4b008709b60c60d5d2e357d7afac5086", "git_parents": ["e3edf555f59a45c7459af22d6ba8f8c68c5d48f1"], "node": "bb98004af8beb82a9429958fa34f3920e47ac5b4", "parents": ["350496f3332c07c597a10c3dee90c4ca618014e5"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074348 - part 6 - Let the sticky menu group fill the width of the menu r=android-reviewers,mcarare\n\nThe sticky group holding the navigation icons was laid out with the same\nhorizontal and top padding as the scrolling groups, so its own background stopped\nshort of the menu edges and the group could still be scrolled up by the height of\nthat padding. The padding now applies only to the groups that scroll.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328737\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/Menu.kt"], "git_node": "fc3bdc566b8f5ab969ed07c38e7abcf973f679c6", "git_parents": ["e169834f4b008709b60c60d5d2e357d7afac5086"], "node": "5a7b34bb963a3b55957f8609f44e43f37ff06459", "parents": ["bb98004af8beb82a9429958fa34f3920e47ac5b4"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074348 - part 7 - Simplify the Compose menu layout r=android-reviewers,mcarare\n\nThe footer was overlaid on the content, so its measured height had to be fed back\nas bottom padding for the list. Laying the two out in a Column with the list\ntaking the remaining height removes that round trip, along with the remembered\nderivations of the header, footer and scrolling groups.\n\nAlso adds the tests Menu() did not have.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328738\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/Menu.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/MenuTest.kt"], "git_node": "854693143e4e608c5b447c96292e5899dd038253", "git_parents": ["fc3bdc566b8f5ab969ed07c38e7abcf973f679c6"], "node": "2635052ab9352f8e7102c737d87d9f07e6abcbef", "parents": ["5a7b34bb963a3b55957f8609f44e43f37ff06459"], "tags": []}, {"author": "Mugurell \u003cMugurell@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2074348 - part 8 - Show an attribution in the menu r=android-reviewers,mcarare\n\nAdded support for menu integrators configuring the menu to show attribution text\nat the top or bottom of the menu, like \"Powered by ..\", text which is more\nhelpful for custom tabs menus.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328739\n", "files": ["mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/Menu.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/data/MenuAttribution.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/store/MenuState.kt", "mobile/android/android-components/components/compose/menu/src/main/java/mozilla/components/compose/menu/ui/MenuAttribution.kt", "mobile/android/android-components/components/compose/menu/src/test/java/mozilla/components/compose/menu/MenuTest.kt", "mobile/android/android-components/config/detekt-baseline.xml", "mobile/android/focus-android/app/src/androidTest/java/org/mozilla/focus/activity/robots/CustomTabRobot.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/browser/integration/BrowserToolbarIntegration.kt", "mobile/android/focus-android/app/src/main/java/org/mozilla/focus/menu/browser/CustomTabMenu.kt", "mobile/android/focus-android/app/src/test/java/org/mozilla/focus/menu/browser/CustomTabMenuTest.kt"], "git_node": "ba98888236be75c1fe95552ec8bfe1b6a17e0d43", "git_parents": ["854693143e4e608c5b447c96292e5899dd038253"], "node": "fd5a5f48c26a66d04b1e4a6aa330c41fda9e3358", "parents": ["2635052ab9352f8e7102c737d87d9f07e6abcbef"], "tags": []}, {"author": "giorga \u003cgiorga@mozilla.com\u003e", "branch": "default", "desc": "Bug 2069862 - [customizable-menu] Show the history, bookmarks, downloads and passwords menu items in browser screen's menu r=android-reviewers,petru\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327276\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/bookmarks/BookmarksScreenMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/BrowserMenuBuilder.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuFragment.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/MenuSectionConfiguration.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/middleware/MenuMiddleware.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/downloads/DownloadsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/library/history/HistoryMenuItemProvider.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/logins/PasswordsMenuItemProvider.kt", "mobile/android/fenix/app/src/main/res/navigation/nav_graph.xml", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/bookmarks/BookmarksScreenMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/middleware/MenuMiddlewareTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/downloads/DownloadsMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/library/history/HistoryMenuItemProviderTest.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/settings/logins/PasswordsMenuItemProviderTest.kt"], "git_node": "a63fd9b85fcd8801fbfe835f0e76f7ccb8be3614", "git_parents": ["ba98888236be75c1fe95552ec8bfe1b6a17e0d43"], "node": "61066fe1744e252887cfc332edade55793d0b03f", "parents": ["fd5a5f48c26a66d04b1e4a6aa330c41fda9e3358"], "tags": []}, {"author": "Corentin Bect \u003ccbect@mozilla.com\u003e", "branch": "default", "desc": "Bug 2072926 - Hide the VPN menu item badge for screen readers r=android-reviewers,twhite\n\n`IPProtectionMenuItem` exposed its status twice for screen readers:\n- The row sets a `stateDescription` based on the current status\n- The `Badge` displays the same status description\n\n`debouncedClickable` is based on `clickable`, which merges semantics of its children, so the text of the badge was merged into the row semantics and announced twice by screen readers (\"ON, VPN, ON, switch\").\n\nTo prevent this duplication, semantics of the badge are now cleared so that the state description of the row is the only source. Now the screen reader says \"ON, VPN, switch\"\n\nSome tests have been added to cover accessibility for all states. Also, tests have been renamed to use GIVEN ... WHEN ... THEN ... pattern.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D327798\n", "files": ["mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItem.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/components/menu/compose/MenuItem.kt", "mobile/android/fenix/app/src/test/java/org/mozilla/fenix/components/menu/compose/IPProtectionMenuItemTest.kt"], "git_node": "1c917f1478249c63640816346241568874c91a2e", "git_parents": ["a63fd9b85fcd8801fbfe835f0e76f7ccb8be3614"], "node": "e547343daaf089080fcb7d81d23c4e463242f5c8", "parents": ["61066fe1744e252887cfc332edade55793d0b03f"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2077650 - Remove remnants of the layout.css.attr.enabled pref. r=firefox-style-system-reviewers,devtools-reviewers,urlbar-reviewers,layout-reviewers,dao,emilio,nchevobbe\n\nUsage of this pref was already removed in bug 1986641, except for one\nremaining check in devtools.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330544\n", "files": ["browser/components/urlbar/tests/browser-results/browser.toml", "browser/components/urlbar/tests/browser-search/browser.toml", "browser/components/urlbar/tests/browser/browser.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser.toml", "devtools/client/inspector/rules/test/browser_rules_attr.js", "devtools/client/inspector/rules/test/browser_rules_container-queries.js", "devtools/client/shared/test/browser_outputparser.js", "devtools/server/actors/style-rule.js", "layout/inspector/tests/mochitest.toml", "layout/style/test/mochitest.toml", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/css/css-conditional/at-supports-namespace-001.html.ini", "testing/web-platform/meta/css/css-conditional/container-queries/__dir__.ini", "testing/web-platform/meta/css/css-content/attr-case-sensitivity-003.html.ini", "testing/web-platform/meta/css/css-content/attr-case-sensitivity-004.html.ini", "testing/web-platform/meta/css/css-values/__dir__.ini", "testing/web-platform/meta/css/cssom/serialize-values.html.ini"], "git_node": "cffb421296220b9346c2030f8899fb3a94b3ec8e", "git_parents": ["1c917f1478249c63640816346241568874c91a2e"], "node": "de5f015f571ae4dfbec09e61d0cd648a0041bdbb", "parents": ["e547343daaf089080fcb7d81d23c4e463242f5c8"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2077650 - Remove remnants of the layout.css.content.alt-text.enabled pref. r=firefox-style-system-reviewers,emilio\n\nUsage of this pref was already removed in bug 1986641.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330545\n", "files": ["accessible/tests/browser/tree/browser.toml", "modules/libpref/init/StaticPrefList.yaml", "testing/web-platform/meta/accname/name/comp_name_from_content.html.ini", "testing/web-platform/meta/css/css-content/__dir__.ini"], "git_node": "a16f85635acd50ed4d9d52a966998bb648d52076", "git_parents": ["cffb421296220b9346c2030f8899fb3a94b3ec8e"], "node": "fa6ace2a2e885378d0a5adb53dff85876bcac7da", "parents": ["de5f015f571ae4dfbec09e61d0cd648a0041bdbb"], "tags": []}, {"author": "Oriol Brufau \u003cobrufau@igalia.com\u003e", "branch": "default", "desc": "Bug 2077650 - Restore layout.css.content.alt-text.enabled for Servo only. r=firefox-style-system-reviewers,emilio\n\nServo doesn't implement the functionality.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330546\n", "files": ["servo/components/style/values/specified/counters.rs"], "git_node": "6a6ea85233220baab33c400d80e33f3218d94232", "git_parents": ["a16f85635acd50ed4d9d52a966998bb648d52076"], "node": "3bb413f96b3f88ae499de6889ed49764a2c1dd0d", "parents": ["fa6ace2a2e885378d0a5adb53dff85876bcac7da"], "tags": []}, {"author": "Lando \u003clando@lando.moz.tools\u003e", "branch": "default", "desc": "Bug 2077650: apply code formatting via Lando\n\n# ignore-this-changeset\n", "files": ["devtools/server/actors/style-rule.js"], "git_node": "ebd27e98c6aa4724158b58210eb86c8925f326b6", "git_parents": ["6a6ea85233220baab33c400d80e33f3218d94232"], "node": "97ffd53e63c2b2abad6e38373c22a93c54484d5a", "parents": ["3bb413f96b3f88ae499de6889ed49764a2c1dd0d"], "tags": []}, {"author": "Tom Schuster \u003ctschuster@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075172 - Connection Allowlists: Exempt javascript: document URLs. r=dom-core-reviewers,smaug\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328841\n", "files": ["dom/security/ConnectionAllowlists.cpp", "testing/web-platform/tests/connection-allowlist/tentative/iframe-contentwindow-injection.sub.window.js"], "git_node": "52cc21b7a23f9cbc75717a5de778b169af90f3ff", "git_parents": ["ebd27e98c6aa4724158b58210eb86c8925f326b6"], "node": "ab057f168c810c02181f1434e24cc13ebe1792da", "parents": ["97ffd53e63c2b2abad6e38373c22a93c54484d5a"], "tags": []}, {"author": "Updatebot \u003cupdatebot@mozilla.com\u003e", "branch": "default", "desc": "Bug 2078036 - Update PDF.js to 35f87e3430402419dce59cf32aeb3b90e8f85f47 r=pdfjs-reviewers,calixte\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330637\n", "files": ["toolkit/components/pdfjs/content/PdfJsVersion.sys.mjs", "toolkit/components/pdfjs/content/build/pdf.mjs", "toolkit/components/pdfjs/content/build/pdf.scripting.mjs", "toolkit/components/pdfjs/content/build/pdf.worker.mjs", "toolkit/components/pdfjs/content/web/viewer-geckoview.mjs", "toolkit/components/pdfjs/content/web/viewer.mjs", "toolkit/components/pdfjs/moz.yaml"], "git_node": "fb91c9c62c76df45889868a7dac3f484593e116a", "git_parents": ["52cc21b7a23f9cbc75717a5de778b169af90f3ff"], "node": "a7567bc2424760b6079783739042a98b3a5c0ef1", "parents": ["ab057f168c810c02181f1434e24cc13ebe1792da"], "tags": []}, {"author": "agoloman \u003cagoloman@mozilla.com\u003e", "branch": "default", "desc": "Revert \"Bug 2077650: apply code formatting via Lando\" for causing linting failures @style-rule.js.\n\nThis reverts commit ebd27e98c6aa4724158b58210eb86c8925f326b6.\n\nRevert \"Bug 2077650 - Restore layout.css.content.alt-text.enabled for Servo only. r=firefox-style-system-reviewers,emilio\"\n\nThis reverts commit 6a6ea85233220baab33c400d80e33f3218d94232.\n\nRevert \"Bug 2077650 - Remove remnants of the layout.css.content.alt-text.enabled pref. r=firefox-style-system-reviewers,emilio\"\n\nThis reverts commit a16f85635acd50ed4d9d52a966998bb648d52076.\n\nRevert \"Bug 2077650 - Remove remnants of the layout.css.attr.enabled pref. r=firefox-style-system-reviewers,devtools-reviewers,urlbar-reviewers,layout-reviewers,dao,emilio,nchevobbe\"\n\nThis reverts commit cffb421296220b9346c2030f8899fb3a94b3ec8e.\n", "files": ["accessible/tests/browser/tree/browser.toml", "browser/components/urlbar/tests/browser-results/browser.toml", "browser/components/urlbar/tests/browser-search/browser.toml", "browser/components/urlbar/tests/browser/browser.toml", "browser/components/urlbar/tests/quicksuggest/browser/browser.toml", "devtools/client/inspector/rules/test/browser_rules_attr.js", "devtools/client/inspector/rules/test/browser_rules_container-queries.js", "devtools/client/shared/test/browser_outputparser.js", "devtools/server/actors/style-rule.js", "layout/inspector/tests/mochitest.toml", "layout/style/test/mochitest.toml", "modules/libpref/init/StaticPrefList.yaml", "servo/com