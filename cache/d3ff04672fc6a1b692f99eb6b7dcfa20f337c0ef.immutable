aitab-table.stories.mjs", "browser/components/aiwindow/ui/jar.mn", "browser/components/aiwindow/ui/modules/AITabUtils.mjs", "browser/components/aiwindow/ui/test/browser/browser.toml", "browser/components/aiwindow/ui/test/browser/browser_aitab_table.js", "browser/components/aiwindow/ui/test/browser/test_aitab_table.mjs", "browser/components/aiwindow/ui/test/browser/test_aitab_table_page.html", "browser/locales-preview/aiWindow.ftl"], "git_node": "fa0016190513184b7a19fbdb9169c6d7937e0191", "git_parents": ["6015de6bfe38acd079c5f11e9555989372601607"], "node": "8b5fd29ce1ba47c8b807662f77dae2cd0e345a93", "parents": ["0262c1e3ea76d43e77f4811ea132c3246857f6fd"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074315 - Part 1 - Move `BuildMetricsService` into the conventions plugin r=nalexander,geckoview-reviewers,android-reviewers\n\nThis is long overdue.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328004\n", "files": ["mobile/android/android-components/plugins/dependencies/build.gradle.kts", "mobile/android/android-components/plugins/dependencies/src/main/java/DependenciesPlugin.kt", "mobile/android/android-components/plugins/dependencies/src/test/java/BuildMetricsServiceTest.kt", "mobile/android/gradle/plugins/conventions/build.gradle.kts", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/BuildMetricsService.kt", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/SettingsPlugin.kt", "mobile/android/gradle/plugins/conventions/src/test/java/org/mozilla/conventions/BuildMetricsServiceTest.kt", "taskcluster/kinds/source-test/android-gradle-plugins.yml"], "git_node": "49fe73a394d912ba612756fe66007d9a3cd5539a", "git_parents": ["fa0016190513184b7a19fbdb9169c6d7937e0191"], "node": "de19529134366c99e96e91e7f249f78dd7627a88", "parents": ["8b5fd29ce1ba47c8b807662f77dae2cd0e345a93"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074315 - Part 2 - Record Gradle build phases and task timings in CI r=nalexander,geckoview-reviewers,taskgraph-reviewers,jcristau\n\nBuild metrics now record the startup, configuration and execution phases plus\nper task timings, and every gradlew build uploads the report.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328005\n", "files": ["build/test/python/test_android_gradle_build.py", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/BuildMetricsService.kt", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/SettingsPlugin.kt", "mobile/android/gradle/plugins/conventions/src/test/java/org/mozilla/conventions/BuildMetricsServiceTest.kt", "taskcluster/android_taskgraph/job.py", "taskcluster/gecko_taskgraph/test/python.toml", "taskcluster/gecko_taskgraph/test/test_android_taskgraph.py", "taskcluster/scripts/builder/build-android.sh"], "git_node": "ebe564c259e061c305de4acef398de599c625426", "git_parents": ["49fe73a394d912ba612756fe66007d9a3cd5539a"], "node": "1eb584a67745a312e55928207f84f924803535b9", "parents": ["de19529134366c99e96e91e7f249f78dd7627a88"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074315 - Part 3 - Report Gradle build times to Perfherder r=nalexander,geckoview-reviewers,taskgraph-reviewers,jcristau\n\nThe metrics report becomes a `gradle build times` suite with the phases and\nper task buckets as subtests, so we can graph when a Gradle build gets slower.\n`shouldAlert` stays off until we know how noisy the numbers are.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328006\n", "files": ["mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/BuildTimes.kt", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/SettingsPlugin.kt", "mobile/android/gradle/plugins/conventions/src/test/java/org/mozilla/conventions/BuildTimesTest.kt", "taskcluster/android_taskgraph/transforms/build_android_app.py", "taskcluster/gecko_taskgraph/test/test_android_taskgraph.py", "taskcluster/kinds/build-apk/kind.yml", "taskcluster/kinds/build-bundle/kind.yml"], "git_node": "a8d46e4ae5a999f70abe620faa13605f3248f34a", "git_parents": ["ebe564c259e061c305de4acef398de599c625426"], "node": "2279540995da71fc1f6e4193e74445bf834db7f0", "parents": ["1eb584a67745a312e55928207f84f924803535b9"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074315 - Stop printing `PERFHERDER_DATA` from the apk size task r=nalexander,android-reviewers\n\nRide along cleanup for the Android Gradle Perfherder data. Treeherder ingests\nthe `perfherder-data` JSON artifact the task already writes, and the log line\nonly feeds the legacy Taskcluster ETL.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328007\n", "files": ["mobile/android/fenix/plugins/apksize/src/main/java/ApkSizePlugin.kt"], "git_node": "0e226d6e57dd314ca44d7cf8b5c449a8f2638042", "git_parents": ["a8d46e4ae5a999f70abe620faa13605f3248f34a"], "node": "77f9de87f2e46b8a17e92c598315ea7e3662027a", "parents": ["2279540995da71fc1f6e4193e74445bf834db7f0"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Bumping Firefox l10n changesets r=release a=l10n-bump DONTBUILD CLOSED TREE\n\nach -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\naf -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\nan -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\nar -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\nast -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\naz -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\nbe -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\nbg -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\nbn -\u003e c4404b7169208b4ee95377f02f893a6847a3c86c\nbo