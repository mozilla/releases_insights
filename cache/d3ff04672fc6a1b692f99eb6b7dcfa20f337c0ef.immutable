avascript-url-009.html", "testing/web-platform/tests/trusted-types/navigate-to-javascript-url-010.html"], "git_node": "59918954edf768a4965f1aacdd7db80cc4b6c363", "git_parents": ["a91747af59cae94ac0ca978ae4362541f7140ca3"], "node": "707e2f7068409bddd8556afa760f65aa163a146d", "parents": ["add2376a7bccd446b2247582aaf4e62316780bf4"], "tags": []}, {"author": "Tim van der Lippe \u003ctvanderlippe@gmail.com\u003e", "branch": "default", "desc": "Bug 2074415 [wpt PR 62850] - script,webvtt: Implement `GetCueAsHTML`, a=testonly\n\nAutomatic update from web-platform-tests\nwebvtt,script: Implement parsing and serialization of cue HTML\n\nSigned-off-by: Tim van der Lippe \u003ctvanderlippe@gmail.com\u003e\n\n--\n\nwpt-commits: 4b7d39e5b3ff4c443d99739e91a92becc90b7bef\nwpt-pr: 62850\n", "files": ["testing/web-platform/tests/webvtt/api/VTTCue/getCueAsHTML.html"], "git_node": "7758dab2c8014bfcddce820c52e0c4896d0300a0", "git_parents": ["59918954edf768a4965f1aacdd7db80cc4b6c363"], "node": "9841d053a07d1d31097dd703965a3d17de4cb3f9", "parents": ["707e2f7068409bddd8556afa760f65aa163a146d"], "tags": []}, {"author": "tannal \u003ctannal2409@gmail.com\u003e", "branch": "default", "desc": "Bug 2051852 [wpt PR 61018] - Add MathML-AAM tests infrastructure and comprehensive mapping tests for mathml elements, a=testonly\n\nAutomatic update from web-platform-tests\nAdd MathML-AAM tests infrastructure and comprehensive mapping tests for mathml elements (#61018)\n--\n\nwpt-commits: 533e7a58f5f702580b89f0ff5821472387194952\nwpt-pr: 61018\n", "files": ["testing/web-platform/tests/core-aam/aamtests/support/atspi_wrapper.py", "testing/web-platform/tests/mathml-aam/aamtests/attribute/mathml-attributes.py", "testing/web-platform/tests/mathml-aam/aamtests/attribute/mmultiscripts.py", "testing/web-platform/tests/mathml-aam/aamtests/conftest.py", "testing/web-platform/tests/mathml-aam/aamtests/role/link.py", "testing/web-platform/tests/mathml-aam/aamtests/role/mathml-role.py"], "git_node": "b03c5ea229a9f561c9f809c7afd628f0656160aa", "git_parents": ["7758dab2c8014bfcddce820c52e0c4896d0300a0"], "node": "a819fc3d9faa9578fbd4dc1533d9ba2735cb9597", "parents": ["9841d053a07d1d31097dd703965a3d17de4cb3f9"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2051852 [wpt PR 61018] - Update wpt metadata, a=testonly\n\nwpt-pr: 61018\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/mathml-aam/aamtests/attribute/__dir__.ini"], "git_node": "84c734049d9f314e388f06237d660ade1641ba51", "git_parents": ["b03c5ea229a9f561c9f809c7afd628f0656160aa"], "node": "a323da440e6bc883d9ea9a7fbc0506502fa237aa", "parents": ["a819fc3d9faa9578fbd4dc1533d9ba2735cb9597"], "tags": []}, {"author": "Manuel Rego Casasnovas \u003crego@igalia.com\u003e", "branch": "default", "desc": "Bug 2074021 [wpt PR 62824] - aamtests: Add test to check aria-invalid event, a=testonly\n\nAutomatic update from web-platform-tests\naamtests: Add test to check aria-invalid event\n\n--\n\nwpt-commits: 02c25cc3a34a70a6225147f76cec312483df4706\nwpt-pr: 62824\n", "files": ["testing/web-platform/tests/core-aam/aamtests/event/aria_invalid.py"], "git_node": "7694560e070d270e52a6e73136c6089cb533c84f", "git_parents": ["84c734049d9f314e388f06237d660ade1641ba51"], "node": "3108d6f0eb56970de7d2f5bd2ebd2db4d6c0f0bf", "parents": ["a323da440e6bc883d9ea9a7fbc0506502fa237aa"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074021 [wpt PR 62824] - Update wpt metadata, a=testonly\n\nwpt-pr: 62824\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/core-aam/aamtests/event/aria_invalid.py.ini"], "git_node": "2837f3ac882dd1e335a20df3be21bf6a0dd0f269", "git_parents": ["7694560e070d270e52a6e73136c6089cb533c84f"], "node": "eafdd751feaff34f5a00b8c4b60779ffda480f06", "parents": ["3108d6f0eb56970de7d2f5bd2ebd2db4d6c0f0bf"], "tags": []}, {"author": "Maksim Sadym \u003csadym@chromium.org\u003e", "branch": "default", "desc": "Bug 2074519 [wpt PR 62861] - [wdspec] Add tests for `emulation.setMediaFeaturesOverride`, a=testonly\n\nAutomatic update from web-platform-tests\n[wdspec] Add tests for `emulation.setMediaFeaturesOverride`\n\n* Add WPT wdspec test suite for `emulation.setMediaFeaturesOverride`\n  under `webdriver/tests/bidi/emulation/set_media_features_override/`.\n* Verify scoping and override precedence across browsing contexts,\n  same-origin and cross-origin iframes, user contexts, and global\n  scopes.\n* Test all spec-defined media features in `features.py`.\n* Validate invalid parameter types, unknown/non-existent contexts, and\n  invalid feature entries in `invalid.py`.\n\nTAG=agy\nCONV=c0ddc083-d64e-485f-9e92-b0e356c17e9b\n\nBug: 470317005\nCq-Include-Trybots: luci.chromium.try\u200b:linux-webdriver-bidi-rel,mac-webdriver-bidi-rel,win-webdriver-bidi-rel\nInclude-Ci-Only-Tests: chromium.linux:Linux Tests|webdriver_wpt_tests\nChange-Id: I870eec5d529a740a3172c2b3a2307366a2f35bfd\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8426446\nAuto-Submit: Maksim Sadym \u003csadym@chromium.org\u003e\nReviewed-by: Nikolay Vitkov \u003cnvitkov@chromium.org\u003e\nCommit-Queue: Maksim Sadym \u003csadym@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1702519}\n\n--\n\nwpt-commits: 2f43dbb9095f6d49790c6daccd8ff262e4b13aac\nwpt-pr: 62861\n", "files": ["testing/web-platform/tests/webdriver/tests/bidi/emulation/set_media_features_override/__init__.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_media_features_override/conftest.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_media_features_override/contexts.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_media_features_override/features.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_media_features_override/global.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_media_features_override/invalid.py", "testing/web-platform/tests/webdriver/tests/bidi/emulation/set_media_features_override/user_contexts.py"], "git_node": "e9a1ee05b0409297e921d5583bf736990fcea64e", "git_parents": ["2837f3ac882dd1e335a20df3be21bf6a0dd0f269"], "node": "15dbf68df95e93eef17e88c3a3ff842c3ff32012", "parents": ["eafdd751feaff34f5a00b8c4b60779ffda480f06"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074519 [wpt PR 62861] - Update wpt metadata, a=testonly\n\nwpt-pr: 62861\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/webdriver/tests/bidi/emulation/set_media_features_override/contexts.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_media_features_override/features.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_media_features_override/global.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_media_features_override/invalid.py.ini", "testing/web-platform/meta/webdriver/tests/bidi/emulation/set_media_features_override/user_contexts.py.ini"], "git_node": "4c3bcd888faa734b4dcf96761a7da71eff3a6112", "git_parents": ["e9a1ee05b0409297e921d5583bf736990fcea64e"], "node": "be35183604f94c2c0ec45b441177b03ee04f05a3", "parents": ["15dbf68df95e93eef17e88c3a3ff842c3ff32012"], "tags": []}, {"author": "Kevin Ellis \u003ckevers@google.com\u003e", "branch": "default", "desc": "Bug 2074572 [wpt PR 62863] - sda: Fix stale paint when resuming after being finished, a=testonly\n\nAutomatic update from web-platform-tests\nsda: Fix stale paint when resuming after being finished\n\nA reset intended to guard against staleness of a compositing decision\ncould force a mismatch in the compositing state between Paint and CC\ndue to forcing a new compositing decision while *not* compositor\npending.\n\nPreviously, this problem went undetected because we had a full check\nupstream that the animation could be composited. This was correctly\nremoved as it was wasteful, but it left us in a state where we could\ntry and force an upgrade to a composited state while having a pending\nor active composited animation.\n\nBug: 562847604\nChange-Id: I79ba406c736847bb23173166fcfad462a6fbaaf7\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8435380\nCommit-Queue: Kevin Ellis \u003ckevers@chromium.org\u003e\nReviewed-by: Vladimir Levin \u003cvmpstr@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1702524}\n\n--\n\nwpt-commits: 0ed53c22c6b0cc043b6224ea89cae7b1914f251a\nwpt-pr: 62863\n", "files": ["testing/web-platform/tests/scroll-animations/responsive/repaint-after-finished-ref.html", "testing/web-platform/tests/scroll-animations/responsive/repaint-after-finished.html"], "git_node": "1bcedeaeb2ebf9120eb8f0a7d49e7b3eccb2d6ff", "git_parents": ["4c3bcd888faa734b4dcf96761a7da71eff3a6112"], "node": "370274caa5099373bb2b0e871a44ab30652ad3ac", "parents": ["be35183604f94c2c0ec45b441177b03ee04f05a3"], "tags": []}, {"author": "moz-wptsync-bot \u003cwptsync@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074572 [wpt PR 62863] - Update wpt metadata, a=testonly\n\nwpt-pr: 62863\nwpt-type: metadata\n", "files": ["testing/web-platform/meta/scroll-animations/responsive/repaint-after-finished.html.ini"], "git_node": "485f96de3df08435b4ccbe29b2fa9550f662bfc7", "git_parents": ["1bcedeaeb2ebf9120eb8f0a7d49e7b3eccb2d6ff"], "node": "4d99ff46ce6a4c01cff28ce67ffc08f56915582d", "parents": ["370274caa5099373bb2b0e871a44ab30652ad3ac"], "tags": []}, {"author": "Rune Lillesveen \u003cfuthark@chromium.org\u003e", "branch": "default", "desc": "Bug 2074573 [wpt PR 62866] - Create an initial CSSValue which can be applied to view-timeline-inset, a=testonly\n\nAutomatic update from web-platform-tests\nCreate an initial CSSValue which can be applied to view-timeline-inset\n\nview-timeline-inset is expected to be CSSValueList of CSSValuePair\nvalues. ViewTimelineInset::InitialValue() incorrectly returned a\nCSSIdentifierValue for 'auto' instead of an 'auto' pair.\n\nThis caused a crash when re-applying the initial value for inheritance\nwhen effective zoom changes which round-trips a computed CSSValue\nthrough ApplyParentValue().\n\nCreate an 'auto' pair instead of a single identifier.\n\nBug: 562857743\nChange-Id: I3813e4d3f206905c140b0d01d8405e8871d05a58\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8425566\nCommit-Queue: Rune Lillesveen \u003cfuthark@chromium.org\u003e\nReviewed-by: David A \u003cawogbemila@chromium.org\u003e\nCr-Commit-Position: refs/heads/main@{#1702562}\n\n--\n\nwpt-commits: d5de5a134c0e06a448870cdb7bf77db5791105b4\nwpt-pr: 62866\n", "files": ["testing/web-platform/tests/css/css-viewport/zoom/view-timeline-inset-crash.html"], "git_node": "e3cc212319c056edbc6c762835b08da6a5ba2b17", "git_parents": ["485f96de3df08435b4ccbe29b2fa9550f662bfc7"], "node": "362be236cc0296bc9a9f576a548a247a178b9e51", "parents": ["4d99ff46ce6a4c01cff28ce67ffc08f56915582d"], "tags": []}, {"author": "Javier Contreras \u003cjaviercon@microsoft.com\u003e", "branch": "default", "desc": "Bug 2074579 [wpt PR 62869] - [masonry] Account for rule visibility in grid lanes, a=testonly\n\nAutomatic update from web-platform-tests\n[masonry] Account for rule visibility in grid lanes\n\nGrid-lanes gap geometry did not record empty adjacent lanes, causing\naround and between to paint rules that should be hidden.\n\nThe current proposal is to consider a gap segment as empty after if\nthere are no items in the next lane, empty before if there are no items\nin the previous lane, and empty both if there are no items in either\nlane. [1]\n\nWe use the already built logic that determines blocked states for\nsegments, using vectors of occupants in the track before the main gap\nbeing processed and after the main gap being processed\n\n[1] https://github.com/w3c/csswg-drafts/issues/14489.\n\nBug: 343257585\nChange-Id: I6d5e9aecf145972c66593f90bfa3ade4a7204eb5\nReviewed-on: https://chromium-review.googlesource.com/c/chromium/src/+/8428244\nReviewed-by: Alison Maher \u003calmaher@microsoft.com\u003e\nCommit-Queue: Javier Contreras \u003cjaviercon@microsoft.com\u003e\nCr-Commit-Position: refs/heads/main@{#1702588}\n\n--\n\nwpt-commits: e578f06428abd6ca56b06f14e749bed39cdafd92\nwpt-pr: 62869\n", "files": ["testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-003-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-around-003.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-empty-all-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-empty-all.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-empty-around-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-empty-around.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-empty-between.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-repaint-all-to-around.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/column-gap-decorations-rule-visibility-items-repaint-normal-to-between.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-all-002-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-all-002.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-around-003-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-around-003.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-rule-visibility-items-between-003-ref.html", "testing/web-platform/tests/css/css-gaps/grid-lanes/row-gap-decorations-r