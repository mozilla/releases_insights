fdee4d3cdfe"], "node": "b7d53af6be8cc34a16b9a878e582ce4ff6cdd8a5", "parents": ["50b527b0d0b0149d465b3a97aba9ef125cb7a017"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075005 - Update AndroidX WorkManager to version 2.12.0. r=android-reviewers,mcarare\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328704\n", "files": ["gradle/libs.versions.toml", "mobile/android/android-components/components/service/firefox-accounts/src/main/java/mozilla/components/service/fxa/sync/WorkManagerSyncManager.kt"], "git_node": "bcc7680a836933d8863f41cc49ef66b07892576d", "git_parents": ["e9332163448b06c5683899a43a2db8dae00625af"], "node": "b85fafecf58b2bfebcda4aabb61d41d6ffd48d60", "parents": ["b7d53af6be8cc34a16b9a878e582ce4ff6cdd8a5"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075430 - Use WindowCompat.enableEdgeToEdge instead of the ComponentActivity extension. r=android-reviewers,mcarare\n\nComponentActivity.enableEdgeToEdge is deprecated in AndroidX Activity 1.14 in favor of\nWindowCompat.enableEdgeToEdge.\n\nThe WindowCompat version does not set the system bar icon appearance, so Focus now sets it from the night mode\nitself because its theme does not. It also leaves navigation bar contrast enforcement off, which Focus already\nrequested before the call. The samples that used androidx.core without declaring it now do.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329075\n", "files": ["mobile/android/android-components/samples/acorn-components/src/main/java/org/mozilla/samples/acorn/components/AcornComponentsActivity.kt", "mobile/android/android-components/samples/browser/src/main/java/org/mozilla/samples/browser/BrowserActivity.kt", "mobile/android/android-components/samples/compose-browser/src/main/java/org/mozilla/samples/compose/browser/BrowserComposeActivity.kt", "mobile/android/android-co