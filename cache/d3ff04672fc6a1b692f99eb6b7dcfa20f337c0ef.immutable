rents": ["93227ea5681bf013f7a973c14b8cfc9bffb33bec"], "tags": []}, {"author": "Lars Eggert \u003clars@eggert.org\u003e", "branch": "default", "desc": "Bug 2078144 - Remove stale cargo-audit waivers for remove_dir_all and proc-macro-error2. r=supply-chain-reviewers,valentin\n\nBug 1975552 removed remove_dir_all and bug 2058355 removed proc-macro-error2, but neither removed the corresponding waiver.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330694\n", "files": [".cargo/audit.toml"], "git_node": "18608ad4bd920d1f1f8d52121f7c165dd4e537ae", "git_parents": ["016f887067b7b8d3dbae7195e18b692b6fe5b24b"], "node": "1a1de8ae8c204e13cfc159686ac2d13ebaf359fa", "parents": ["9376bddb5f9fc69320baddc84a0b1e26b152ac4e"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2035902 - Add MozOp::ExternToCont and use it for the JSPI reaction continuation. r=yury\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329292\n", "files": ["js/src/wasm/WasmConstants.h", "js/src/wasm/WasmIonCompile.cpp", "js/src/wasm/WasmOpIter.cpp", "js/src/wasm/WasmOpIter.h", "js/src/wasm/WasmPI.cpp"], "git_node": "44fbd8488c109ab5a22afdf7b7bb944871ef5428", "git_parents": ["18608ad4bd920d1f1f8d52121f7c165dd4e537ae"], "node": "5054300b3d68808200c6932dc4860f66fef9d2e6", "parents": ["1a1de8ae8c204e13cfc159686ac2d13ebaf359fa"], "tags": []}, {"author": "Ryan Hunt \u003crhunt@eqrion.net\u003e", "branch": "default", "desc": "Bug 2035902 - Fix 'isExposable' handling for continuations. r=yury\n\nisExposable only rejected contref and nullcontref, so (ref $T) with $T a cont\ntype could cross the JS boundary. Reject the whole cont hierarchy, and drop\nthe ContObject escape hatch in CheckTypeRefValue and the matching workaround\nin WasmGcObject::loadValue now that JSPI no longer needs them.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329293\n", "files": ["js/src/jit-test/tests/wasm/stack-switching/typed-cont-not-exposable.js", "js/src/wasm/WasmGcObject.cpp", "js/src/wasm/WasmValType.h", "js/src/wasm/WasmValue.cpp"], "git_node": "aa6aa62deb3f7909428efaf4f4851aab2c80991a", "git_parents": ["44fbd8488c109ab5a22afdf7b7bb944871ef5428"], "node": "1efc0f9cf4361d37589c7f326eb42c8c80a2500d", "parents": ["5054300b3d68808200c6932dc4860f66fef9d2e6"], "tags": []}, {"author": "D\u00e3o Gottwald \u003cdao@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074388 - Type the remaining one-offs in SessionStore.sys.mjs and remove it from the TypeScript exclude list. r=sfoster,sessionstore-reviewers\n\nGlobalState.sys.mjs becomes a class with a private field; its only consumer is SessionStore, which calls its methods through the instance, so nothing relied on the methods being bound or the object being frozen.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330753\n", "files": ["browser/components/sessionstore/GlobalState.sys.mjs", "browser/components/sessionstore/SessionStore.sys.mjs", "browser/components/sessionstore/tsconfig.json", "browser/components/sessionstore/types/sessionstore.ts"], "git_node": "27011b52cdf289607ed9eaf07abf4535af4855a6", "git_parents": ["aa6aa62deb3f7909428efaf4f4851aab2c80991a"], "node": "8c799f691bed05a63d31a88d21246d09d021c31b", "parents": ["1efc0f9cf4361d37589c7f326eb42c8c80a2500d"], "tags": []}, {"author": "pollymce \u003cpmceldowney@mozilla.com\u003e", "branch": "default", "desc": "Bug 2073095 - fix some more ui tests for nightly. r=sfamisa\n\n- `SettingsHomepageTest` needed to take into account the differences in top site configuration\n- `SettingsSearchTest` needed a reliable way of accessing checkboxes. There was a flaky positional based lookup. i have added a compose `testTag` to `SearchItem` facilitate this.\n\n[try is running here](https://treeherder.mozilla.org/jobs?repo=try&landoInstance=lando-prod-2025&landoCommitID=100176), 3rd attempt with lint fixes\n\nPull request: https://github.com/mozilla-firefox/firefox/pull/378\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsHomepageTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/SettingsSearchTest.kt", "mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/robots/SettingsSubMenuSearchRobot.kt", "mobile/android/fenix/app/src/main/java/org/mozilla/fenix/settings/search/SearchEngineShortcuts.kt"], "git_node": "c5c20103b9613d0d6784ab00f9c595e4af9f93a3", "git_parents": ["27011b52cdf289607ed9eaf07abf4535af4855a6"], "node": "2e5bd2d5dc9a54b1d8ebadcb817d5268dbd92981", "parents": ["8c799f691bed05a63d31a88d21246d09d021c31b"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2078056 - Use Skia instead of Cairo for pixel format conversion and drag/icon image DrawTargets. r=gfx-reviewers,gtk-reviewers,emilio,lsalzman\n\nThese DrawTargets wrap a B8G8R8A8 DataSourceSurface and are only used to copy,\nscale or convert another surface into it. Skia handles this just as well, and\nthis removes some more of our remaining dependencies on DrawTargetCairo.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330640\n", "files": ["gfx/thebes/gfxUtils.cpp", "widget/cocoa/nsDragService.mm", "widget/gtk/nsImageToPixbuf.cpp", "widget/windows/WinUtils.cpp", "widget/windows/nsDragService.cpp", "widget/windows/nsWindowGfx.cpp"], "git_node": "047640b42b7bda4c59854428a305e5a7dcca9914", "git_parents": ["c5c20103b9613d0d6784ab00f9c595e4af9f93a3"], "node": "4aee53469df8c9e03ac8ed79240a49eeac0e8f2e", "parents": ["2e5bd2d5dc9a54b1d8ebadcb817d5268dbd92981"], "tags": []}, {"author": "Markus Stange \u003cmstange.moz@gmail.com\u003e", "branch": "default", "desc": "Bug 2078055 - Remove unused gfxWindowsNativeDrawing and gfxSharedImageSurface. r=gfx-reviewers,lsalzman\n\nNeither class has any users.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330639\n", "files": ["gfx/thebes/gfxBaseSharedMemorySurface.cpp", "gfx/thebes/gfxBaseSharedMemorySurface.h", "gfx/thebes/gfxSharedImageSurface.h", "gfx/thebes/gfxWindowsNativeDrawing.cpp", "gfx/thebes/gfxWindowsNativeDrawing.h", "gfx/thebes/moz.build"], "git_node": "c8e82c9d637529590af8ec301c1260eef395a90f", "git_parents": ["047640b42b7bda4c59854428a305e5a7dcca9914"], "node": "956c3acce76b440f1d2849cd293e60df28ae5cb5", "parents": ["4aee53469df8c9e03ac8ed79240a49eeac0e8f2e"], "tags": []}, {"author": "Leo Tenenbaum \u003cltenenbaum@mozilla.com\u003e", "branch": "default", "desc": "Bug 2074266 - Resolve URLs for declarative web push in Rust parser. r=saschanaz\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330375\n", "files": ["Cargo.lock", "dom/push/Declarative.cpp", "dom/push/rust/Cargo.toml", "dom/push/rust/src/declarative_push.rs"], "git_node": "146f12110b19ace5324db71b4a1e0ffbb4cec1ee", "git_parents": ["c8e82c9d637529590af8ec301c1260eef395a90f"], "node": "01cc41113f27c5b0f3d9fead78015f1958e89b71", "parents": ["956c3acce76b440f1d2849cd293e60df28ae5cb5"], "tags": []}, {"author": "Kate Lower \u003cmozilla@Work-Mac.local\u003e", "branch": "default", "desc": "Bug 2075054 - Fix casing and punctuation in Smart Window switcher tooltip. r=fluent-reviewers,bolsson,czhou\n\nIn browser/locales/en-US/browser/aiWindow.ftl, the tooltiptext for\ntoolbar-switcher-customizable-label read:\n\n  \"Switch between Smart and Classic windows.\"\n\nTwo issues:\n\n1. \"windows\" \u2192 \"Windows\": \"Classic Window\" and \"Smart Window\" are\n   consistently title-cased throughout the file as product feature-mode\n   names (e.g. appmenuitem-new-classic-window, ai-window-toggleview-switch-classic).\n   The equivalent string in browser/locales/en-US/browser/newtab/onboarding.ftl\n   already uses \"Windows\". The lowercase was an unintentional inconsistency.\n\n2. Trailing period removed: this is the only tooltip among all 15 in the\n   file that ended with a period. Tooltips are short phrases, not sentences.\n\nCo-Authored-By: Claude \u003cnoreply@anthropic.com\u003e\n\nDifferential Revision: https://phabricator.services.mozilla.com/D328713\n", "files": ["browser/components/aiwindow/ui/modules/AIWindow.sys.mjs", "browser/locales/en-US/browser/aiWindow.ftl"], "git_node": "0779d4d61af25dd80eaaa1c4f2ce077087106a2c", "git_parents": ["146f12110b19ace5324db71b4a1e0ffbb4cec1ee"], "node": "0feb17dbf62c5178e826bc5949dcc5d04539e1e8", "parents": ["01cc41113f27c5b0f3d9fead78015f1958e89b71"], "tags": []}, {"author": "AndiAJ \u003candiaj@users.noreply.github.com\u003e", "branch": "default", "desc": "Bug 2067387 - Fix verifyAddressAutofillTest efficiency UI test r=aaronmt\n\nSome UI tests were flaky when trying to verify the **INTERACTIVE readiness for SettingsAutofillPage**.\n\nThe tests weren\u2019t actually failing on the Autofill screen, the tap on \u201cAutofill\u201d in Settings was landing on the \u201cPasswords\u201d row (because Espresso taps a coordinate while the just-opened Settings list is still shifting), so the test waited 10s for an Autofill screen that never opened.\n\nTo fix this I've switched to UiAutomator, which finds the \u201cAutofill\u201d row by its text and clicks it directly, so it can\u2019t hit the wrong row.\n\n**deleteSavedCreditCardUsingMenuButtonTest** and **verifyAddressAutofillTest** successfully passed 100x on Firebase \u2705\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330750\n", "files": ["mobile/android/fenix/app/src/androidTest/java/org/mozilla/fenix/ui/efficiency/selectors/SettingsSelectors.kt"], "git_node": "a9bec1703d5182bdd64ff7d3218c9a20463193d1", "git_parents": ["0779d4d61af25dd80eaaa1c4f2ce077087106a2c"], "node": "bf1734a928c2554cd9a01f03f3fa51ac0726ce19", "parents": ["0feb17dbf62c5178e826bc5949dcc5d04539e1e8"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077543 - Add a typedef for search mode objects in UrlbarInputBase. r=urlbar-reviewers,dao\n\nAlso stops throwing when calling setSearchMode with an invalid search mode object with a restrictType.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330383\n", "files": ["browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs"], "git_node": "3cde533d8570940d2394fa64b90367feeb78ae4b", "git_parents": ["a9bec1703d5182bdd64ff7d3218c9a20463193d1"], "node": "5d0378d6b01ffd7a0442eab9983c5414994cb668", "parents": ["bf1734a928c2554cd9a01f03f3fa51ac0726ce19"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077543 - Fix type errors in UrlbarBaseInput and enable type checking in it. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330384\n", "files": ["browser/components/urlbar/UrlbarParentController.sys.mjs", "browser/components/urlbar/content/SmartbarInput.mjs", "browser/components/urlbar/content/UrlbarChildController.mjs", "browser/components/urlbar/content/UrlbarContentUtils.mjs", "browser/components/urlbar/content/UrlbarInputBase.mjs", "browser/components/urlbar/content/UrlbarParentControllerProxy.mjs", "browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarShared.mjs", "browser/components/urlbar/tsconfig.json", "browser/modules/URILoadingHelper.sys.mjs"], "git_node": "46b7f2fed4d9e7ee5f76545e746052c9555827cc", "git_parents": ["3cde533d8570940d2394fa64b90367feeb78ae4b"], "node": "66045ff57894d5f8b364401a09cbfd1c20d80b53", "parents": ["5d0378d6b01ffd7a0442eab9983c5414994cb668"], "tags": []}, {"author": "Moritz Beier \u003cmbeier@mozilla.com\u003e", "branch": "default", "desc": "Bug 1996132 - Add ResultRow typedef to UrlbarView. r=urlbar-reviewers,dao\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330385\n", "files": ["browser/components/urlbar/content/UrlbarResult.mjs", "browser/components/urlbar/content/UrlbarView.mjs"], "git_node": "47076aaa574c64100246afccf7d3f86162d3f9fb