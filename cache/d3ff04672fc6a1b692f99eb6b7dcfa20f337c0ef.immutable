db12a7af4988875af71dd46f5df\ntrs -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nuk -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nur -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nuz -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nvi -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nwo -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nxh -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nzam -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nzh-CN -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\nzh-TW -\u003e 55a8b6e0e7e64db12a7af4988875af71dd46f5df\n", "files": ["mobile/locales/l10n-changesets.json"], "git_node": "5f09d646cd07b3c86ecc2923138e412598c0db6d", "git_parents": ["683a3cac3df743509b34f03f824f5edea06fe138"], "node": "c1622c86f23f76777d85b5cbfdc0a71a8240f506", "parents": ["b8dd70a52492bfc97c9ecc05b79a380b0c6ab682"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075741 - Verify the MD5 of each talos PDF downloaded for the talos-pdfs toolchain r=perftest-reviewers,kshampur\n\nA corrupt issue12294.pdf from web.archive.org was published in the\ntalos-pdfs toolchain, and pdfpaint timed out waiting for it to render.\nA download whose MD5 does not match the pdf.js test manifest now\nraises, so it is retried, and the toolchain task fails instead of\npublishing a bad file.\n\nweb.archive.org URLs get `if_` after the timestamp, as pdf.js does in\n`test/downloadutils.mjs`, so the archive serves the raw file instead of\nan HTML page that wraps it.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329368\n", "files": ["taskcluster/scripts/misc/fetch-talos-pdfs.py"], "git_node": "1970924fe83d3d7dabe17a5509e9bbec84b2d961", "git_parents": ["5f09d646cd07b3c86ecc2923138e412598c0db6d"], "node": "ec5344c59c7eaa5f3ae919806ca59432cef7815c", "parents": ["c1622c86f23f76777d85b5cbfdc0a71a8240f506"], "tags": []}, {"author": "Alex Hochheiden \u003cahochheiden@mozilla.com\u003e", "branch": "default", "desc": "Bug 2075741 - Stop the talos pageloader after a page timeout when profiling is off r=perftest-reviewers,kshampur\n\nAfter a page timed out three times, `loadFail` waited on\n`TalosParentProfiler.finishTest` before calling `plStop`. Without\nprofiling, `finishTest` rejects, so `plStop` never ran and the task sat\nidle until it hit its max run time. A timeout now ends the test within\nminutes.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329369\n", "files": ["testing/talos/talos/pageloader/chrome/pageloader.js"], "git_node": "b264d951b6a3ba7ec72e2be45879bf0adae46c12", "git_parents": ["1970924fe83d3d7dabe17a5509e9bbec84b2d961"], "node": "4bd1c034dcb43a6ff416031ff4c37e119348450a", "parents": ["ec5344c59c7eaa5f3ae919806ca59432cef7815c"], "tags": []}, {"author": "Release Engineering Landoscript \u003crelease+landoscript@mozilla.com\u003e", "branch": "default", "desc": "No Bug - Import translations from https://github.com/mozilla-l10n/android-l10n CLOSED TREE\n", "files": ["mobile/android/android-components/components/feature/listentopage/src/main/res/values-cs/strings.xml", "mobile/android/android-components/components/feature/listentopage/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-cs/strings.xml", "mobile/android/fenix/app/src/main/res/values-in/strings.xml", "mobile/android/fenix/app/src/main/res/values-nn-rNO/strings.xml", "mobile/android/fenix/app/src/main/res/values-sl/strings.xml", "mobile/android/fenix/app/src/main/res/values-tr/strings.xml", "mobile/android/focus-android/app/src/main/res/values-fa/strings.xml"], "git_node": "28dc8b5851fcdc6b0d4aa9e3f1d1273ecacfd9fb", "git_parents": ["b264d951b6a3ba7ec72e2be45879bf0adae46c12"], "node": "b916ff1ccdf67aa882c7bfd6cd52f1116ce1d323", "parents": ["4bd1c034dcb43a6ff416031ff4c37e119348450a"], "tags": []}, {"author": "Ryan VanderMeulen \u003crvandermeulen@mozilla.com\u003e", "branch": "default", "desc": "Bug 2077828 - Default ccov web-platform-tests-crashtest jobs to 2 chunks.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330590\n", "files": ["taskcluster/kinds/web-platform-tests/kind.yml"], "git_node": "03f594ceec6860bef695f64d272ae72a741775dc", "git_parents": ["28dc8b5851fcdc6b0d4aa9e3f1d1273ecacfd9fb"], "node": "31957d775db71156660d3079ff87a9cf6a884f9d", "parents": ["b916ff1ccdf67aa882c7bfd6cd52f1116ce1d323"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076826 - Part 1: Remove duplicated `glean-native` version verification. r=ahochheiden\n\nThis already exists in the Gradle `conventions` plugin; see\nhttps://searchfox.org/firefox-main/rev/ab8d6c5ccc0df56b48c3416e2e6f6e596fd2e6f2/mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt#378.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329994\n", "files": ["build.gradle"], "git_node": "c974b63845196b2e38d7cafd8e542eac4eec28e2", "git_parents": ["03f594ceec6860bef695f64d272ae72a741775dc"], "node": "deae3dc85c6d02c0194d2764671f4c7a765ad84e", "parents": ["31957d775db71156660d3079ff87a9cf6a884f9d"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076826 - Part 2: Move `glean-native` `project(:geckoview)` resolution into Gradle conventions plugin. r=ahochheiden,geckoview-reviewers,owlish\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329995\n", "files": ["build.gradle", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/ProjectPlugin.kt"], "git_node": "b4f08ab3eb968b9dd9a8cc425159a1c654ba02a0", "git_parents": ["c974b63845196b2e38d7cafd8e542eac4eec28e2"], "node": "ed1ca5119d7207053ba14ff43b59a36b44aa3247", "parents": ["deae3dc85c6d02c0194d2764671f4c7a765ad84e"], "tags": []}, {"author": "Nick Alexander \u003cnalexander@mozilla.com\u003e", "branch": "default", "desc": "Bug 2076826 - Part 3: Move `VerifyGleanVersion` to the Gradle `conventions` plugin. r=ahochheiden\n\nDifferential Revision: https://phabricator.services.mozilla.com/D329996\n", "files": ["build.gradle", "mobile/android/gradle/plugins/conventions/build.gradle.kts", "mobile/android/gradle/plugins/conventions/src/main/java/org/mozilla/conventions/VerifyGleanVersion.kt"], "git_node": "e59a3e6090405577df6735b7486e80fa15df6ba4", "git_parents": ["b4f08ab3eb968b9dd9a8cc425159a1c654ba02a0"], "node": "ec0a0ba71ab83a1831b90dc444c0c158d069ef60", "parents": ["ed1ca5119d7207053ba14ff43b59a36b44aa3247"], "tags": []}, {"author": "Sotaro Ikeda \u003csotaro.ikeda.g@gmail.com\u003e", "branch": "default", "desc": "Bug 1959232 - Enable WebRender layer compositor even when hardware stretching is not supported r=gfx-reviewers,bradwerth\n\nThe artifact happened between DC tiles when hardware stretching is not supported. Layer compositor does not use the DC tiles. Then layer compositor could be enabled without hardware stretching support.\n\nThis change enabled the WebRender layer compositor usage in a lot of CI tests on Windows.\n\nDifferential Revision: https://phabricator.services.mozilla.com/D330139\n", "files": ["gfx/config/gfxConfigManager.cpp", "gfx/config/gfxConfigManager.h", "gfx/tests/gtest/TestConfigManager.cpp"], "git_node": "3f73c528a1ae5784ea5e1ee2c5ad3762507395f2", "git_parents": ["e59a3e6090405577df6735b7486e80fa15df6ba4"], "node": "11022e1a677f0dd83f348d52bd2b17c8410e3fab", "parents": ["ec0a0ba71ab83a1831b90dc444c0c158d069ef60"], "tags": []}], "date": 1791101312, "git_changesets": ["f5fc27ce1f865968194fad55b733ac4e4b48ea87", "6285c9b306c56a96f125f287688c5d154027caf9", "683a3cac3df743509b34f03f824f5edea06fe138", "5f09d646cd07b3c86ecc2923138e412598c0db6d", "1970924fe83d3d7dabe17a5509e9bbec84b2d961", "b264d951b6a3ba7ec72e2be45879bf0adae46c12", "28dc8b5851fcdc6b0d4aa9e3f1d1273ecacfd9fb", "03f594ceec6860bef695f64d272ae72a741775dc", "c974b63845196b2e38d7cafd8e542eac4eec28e2", "b4f08ab3eb968b9dd9a8cc425159